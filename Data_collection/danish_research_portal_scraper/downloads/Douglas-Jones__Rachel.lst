last":"Kristensen","name":"Kristensen, D.B.","rank":11,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-981-16-7084-8_27","edition":"1","eisbn":["9789811670848"],"isbn":["9789811670831"],"pages":"529-546","place":"Singapore","publisher":"Palgrave Macmillan","status":"p","title":"The Palgrave Handbook of the Anthropology of Technology"},"review":"Peer Reviewed","scoID":["2-s2.0-85160466221"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Miscellaneous","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Governmental Institutions","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-944dee60-0158-4d9f-a4df-006f39f19d4a","vive-290bf3db-19dd-4676-80c5-1e5099252ddc"],"src":["KU University of Copenhagen","VIVE The Danish Center for Social Science Research"],"title":"Moral Ambiguities: Fleshy and Digital Substitutes in the Life Sciences","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-092.57-044497","year":"2022","yearsub":"2022"}
{"abstract":"Material culture studies have in recent decades taken a more central role in anthropological thinking, but not just in terms of an interest in exploring individual objects, material qualities, patterns, or symbols of things. The goal is also to understand how human lives fundamentally unfold through material culture. This chapter explores technology through the broad variety of approaches captured under the heading ‘material culture studies’, to see how things are entangled in the values, meanings, and practices of human lives. It briefly outlines discussions about objectification, agency, and materiality to highlight how even the most mundane aspects of human life, such as light, have central bearing on human worlds. Lighting and lighting are, on the one hand, intangible but, on the other, have a profound effect on how the world appears. As a technology, lighting has shaped human societies by extending the day and carrying strong symbolic values, but also through embracing other objects in its material qualities. Humans adjust and manipulate such qualities to present spaces in particular ways that make sense in local contexts. To understand technologies one also needs to understand how their material qualities constitute the self and society.","author_count":9,"contributors":["Bille, Mikkel"],"cuid":["S02-094.55-040801"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Agency","Lighting","Material Culture","Materiality","Objectification"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU","DI-U-RUC"]},"level3all":["DI-U-KU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"material culture studies objectification agency and intangibility materiality","src":["ku","ruc"],"src-code":["DI-U-KU","DI-U-RUC"],"type":"dba","type-grp":["all","pub"]},"id":"S02-094.55-040801","identifier":[{"id":"85160459879","type":"scopus"}],"ids":["ku-21c8e5ca-2a19-484f-b2bf-c1d2eb13245a","ruc-c57b06bb-7369-499e-9c06-10c067db19d4"],"keyword":["Agency","Lighting","Material culture","Materiality","Objectification"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-5-6C52CCFDAC1C93F2EA91C4EE165C850F"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Humanities, SAXO-Institute - Archaeology, Ethnology, Greek & Latin, History"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of People and Technology"],"nora_code":"DI-U-RUC","used":1}],"person":[{"affno":"1 2","country":"dk","first":"Mikkel","key":"billepau","last":"Bille","locid":"ba59254a-5bab-46e5-b326-4eb9eb90b68c","name":"Bille, Mikkel","orcid":"0000-0003-4558-2473","rank":1,"rolecode":"pau"},{"affno":"","first":"Maja H.","key":"bruunpedh","last":"Bruun","name":"Bruun, Maja H.","rank":2,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Ayo","key":"wahlbergpedh","last":"Wahlberg","name":"Wahlberg, Ayo","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Rachel","key":"douglasjonespedh","last":"Douglas-Jones","name":"Douglas-Jones, Rachel","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Cathrine","key":"hassepedh","last":"Hasse","name":"Hasse, Cathrine","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Klaus","key":"hoyerpedh","last":"Hoyer","name":"Hoyer, Klaus","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Klaus","key":"hoeyerpedh","last":"Hoeyer","name":"Hoeyer, Klaus","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"D.B.","key":"kristensenpedh","last":"Kristensen","name":"Kristensen, D.B.","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Britt","key":"winthereikpedh","last":"Winthereik","name":"Winthereik, Britt","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-981-16-7084-8_4","eisbn":["9789811670848"],"isbn":["9789811670831"],"pages":"85-103","publisher":"Palgrave Macmillan","status":"p","title":"The Palgrave Handbook of the Anthropology of Technology"},"review":"Peer Reviewed","scoID":["2-s2.0-85160459879"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Roskilde University","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-21c8e5ca-2a19-484f-b2bf-c1d2eb13245a","ruc-c57b06bb-7369-499e-9c06-10c067db19d4"],"src":["KU University of Copenhagen","RUC Roskilde University"],"title":"Material Culture Studies : Objectification, Agency, and Intangibility: Materiality","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-094.55-040801","year":"2022","yearsub":"2022"}
{"abstract":"This article focuses on data workers in Shenzhen, who, since 2013, have been recruited to fill positions in the city’s Weaving the Net program (zhiwang gongcheng, 織網工程). The program, furthering both the expansion of city gridding management techniques and local experiments with China’s Social Credit system, is designed to generate a daily set of data to inform the city’s “Smart Brain”, and is a core way of managing the city’s “floating population”. In this article, we approach the grid management of Shenzhen and its connection with histories of Chinese social control through data workers themselves. We argue that data workers expand our understanding both the integration of human-technological assemblages into smart city initiatives and the labor of data generation for programs of state social control. Extending STS approaches to smart city infrastructure, we use the figure of the data worker to the present both familiar and distinctive characteristics of Chinese Smart City initiatives.","author_count":2,"contributors":["Zhao, Hailing","Douglas-Jones, Rachel"],"cuid":["S01-000.00-692767"],"filters":{"added":"2023-11","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of East Anglia"],"keyword":["Grid management","Smart City","Social credit system"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-AAU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"weaving the net making a smart city through data workers in shenzhen","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND 4.0","type":"doi","url":"https://doi.org/10.1080/18752160.2022.2088919","version":"Published Version"},"id":"S01-000.00-692767","identifier":[{"id":"85146135127","type":"scopus"}],"ids":["aau-7c35ecff-de00-4bd4-b4bf-b36b228f842d"],"keyword":["Data workers","floating people","grid management","smart city","social credit system"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-4-CFB5DD1C3B19C7BEF6329915A2669BD9"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/627881642/Weaving_the_Net_Making_a_Smart_City_Through_Data_Workers_in_Shenzhen.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND 4.0","type":"doi","url":"https://doi.org/10.1080/18752160.2022.2088919","version":"Published Version"}],"oai":{"class":"Realised","mra":["Social Science (SOC)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Social Sciences and Humanities","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Politics and Society","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Politics and Society, Global Politics & Diversity","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Politics and Society, REGIS - Regional and International Studies research group"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"gb","key":"university of east anglia","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of East Anglia","used":1},{"affno":"3","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"Hailing","key":"zhaopau","last":"Zhao","locid":"c50555a1-169c-4dbc-b749-ae69fe9385f1","name":"Zhao, Hailing","rank":1,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Rachel","key":"douglasjonespau","last":"Douglas-Jones","name":"Douglas-Jones, Rachel","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1080/18752160.2022.2088919","issn":["18752152","18752160"],"issn_org":["18752160"],"issue":"4","journal":"East Asian Science, Technology and Society: an international journal","pages":"461-485","publisher":"Routledge","status":"p","title":"East Asian Science, Technology and Society: an international journal","title_org":"East Asian Science, Technology and Society","volume":"16"},"review":"Peer Reviewed","scoID":["2-s2.0-85146135127"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["aau-7c35ecff-de00-4bd4-b4bf-b36b228f842d"],"src":["AAU Aalborg University"],"title":"Weaving the Net : Making a Smart City Through Data Workers in Shenzhen","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-692767","year":"2022","yearsub":"2022"}
{"abstract":"This Handbook offers an overview of the thriving and diverse field of anthropological studies of technology. It features 39 original chapters, each reviewing the state of the art of current research and enlivening the field of study through ethnographic analysis of human-technology interfaces, forms of social organisation, technological practices and/or systems of belief and meaning in different parts of the world. The Handbook is organised around some of the most important characteristics of anthropological studies of technology today: the diverse knowledge practices that technologies involve and on which they depend; the communities, collectives, and categories that emerge around technologies; anthropology’s contribution to proliferating debates on ethics, values, and morality in relation to technology; and infrastructures that highlight how all technologies are embedded in broader political economies and socio-historical processes that shape and often reinforce inequality and discrimination while also generating diversity. All chapters share a commitment to human experiences, embodiments, practices, and materialities in the daily lives of those people and institutions involved in the development, manufacturing, deployment, and/or use of particular technologies. Chapters 11 and 31 are available open access under a Creative Commons Attribution 4.0 International License via link.springer.com.","author_count":7,"contributors":["Bruun, Maja Hojer","Wahlberg, Ayo","Douglas-Jones, Rachel","Hasse, Cathrine","Høyer, Klaus Lindgaard","Kristensen, Dorthe Brogård","Winthereik, Brit Ross"],"cuid":["S03-093.75-026346"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"keyword":["Environmental Studies","Ethnography","Interdisciplinary research","Medical anthropology","STS","anthropological studies of technology","human technology interfaces"],"level":"sci","mra":["hum","soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-ITU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-U-AU","DI-U-ITU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"the palgrave handbook of the anthropology of technology","src":["au","ku","sdu"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"db","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85160482444","version":"Other Version"},"id":"S03-093.75-026346","identifier":[{"id":"85160482444","type":"scopus"}],"ids":["au-bc2fc50c-5656-4d52-90b6-a9b4d927ec9f","ku-6dbcbf7e-668c-49e5-8070-ec5e0b02a369","sdu-4afca759-0aa8-48c4-854d-b1458315f2e8"],"keyword":["STS","anthropological studies of technology","environmental studies","ethnography","human-technology interfaces","interdisciplinary research","medical anthropology"],"lang":"English","level":"Scientific","mra":["Humanities","Social Science"],"noi":["Global-Local-2-5-4638EEF7346E5FE776E3A9454F9234B3"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, Danish School of Education, Danish School of Education - Educational Anthropology, Aarhus"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Social Sciences, Department of Anthropology"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1},{"affno":"4","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Business and Social Sciences, Department of Business & Management (DBM)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Maja Hojer","key":"bruunped","last":"Bruun","locid":"fd7fa4bb-1d54-43ae-b40c-f5c8acae5f6d","name":"Bruun, Maja Hojer","orcid":"0000-0002-9877-8800","rank":1,"role":"Editor","rolecode":"ped"},{"affno":"2","first":"Ayo","key":"wahlbergped","last":"Wahlberg","locid":"c1114f6e-8a86-4e8b-a7f7-db6ac7b914d5","name":"Wahlberg, Ayo","orcid":"0000-0001-6862-5208","rank":2,"role":"Editor","rolecode":"ped"},{"affno":"3","corresponding":null,"first":"Rachel","key":"douglasjonesped","last":"Douglas-Jones","name":"Douglas-Jones, Rachel","rank":3,"role":"Editor","rolecode":"ped"},{"affno":"1","corresponding":null,"country":"dk","first":"Cathrine","key":"hasseped","last":"Hasse","locid":"5ba5eb68-a94f-4626-b074-1958780ab33a","name":"Hasse, Cathrine","orcid":"0000-0002-2525-9540","rank":4,"role":"Editor","rolecode":"ped"},{"affno":"2","first":"Klaus","key":"hoeyerped","last":"Hoeyer","locid":"155a3763-e58a-4576-8cd9-5042f6a9947f","name":"Hoeyer, Klaus","orcid":"0000-0002-2780-4784","rank":5,"role":"Editor","rolecode":"ped"},{"affno":"4","corresponding":null,"country":"dk","first":"Dorthe Brogaard","key":"kristensenped","last":"Kristensen","locid":"a9b43877-9747-46c6-ae54-fa91cad9a1f6","name":"Kristensen, Dorthe Brogaard","orcid":"0000-0002-9008-9349","rank":6,"role":"Editor","rolecode":"ped"},{"affno":"3","corresponding":null,"first":"Brit Ross","key":"winthereikped","last":"Winthereik","name":"Winthereik, Brit Ross","rank":7,"role":"Editor","rolecode":"ped"}],"pub":{"doi":"10.1007/978-981-16-7084-8","eisbn":["9789811670848"],"isbn":["9789811670831","9789811670862"],"pages":"808","place":"Singapore","publisher":"Palgrave Macmillan","status":"p"},"review":"Peer Reviewed","scoID":["2-s2.0-85160482444"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-bc2fc50c-5656-4d52-90b6-a9b4d927ec9f","ku-6dbcbf7e-668c-49e5-8070-ec5e0b02a369","sdu-4afca759-0aa8-48c4-854d-b1458315f2e8"],"src":["AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"The Palgrave Handbook of the Anthropology of Technology","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-093.75-026346","year":"2022","yearsub":"2022"}
{"abstract":"Technologies generate questions. Questions about how to live with them, make them, understand their implications, share their benefits, and limit their harms. Sometimes the questions are specific: what does a new way of doing something mean for those who re-shape their lives around it? At other times, the questions are broader: should this technology exist at all? This section brings together the substantial contributions that anthropologists have made to discussing and analysing the disquiet and awe of technological advance, and the languages-ethics, values, and morality-through which it has been addressed. In this Introduction, we review the anthropology of technology as seen through the lenses of ethics, morality, and values, covering both historical attention to these areas of concern and contemporary work. We then introduce the chapters of this section, situating the seven ethnographies in these broader literatures and narrating their shared concerns. From the embodiment of values in material form to their contestation through conversation, policy, and practice, we make visible the registries of contemporary contestations over technology, and the means by which people struggle to settle normative questions about the form that human futures should take.","author_count":11,"contributors":["Douglas-Jones, Rachel","Bruun, Maja Hojer","Kristensen, Dorthe Brogård"],"cuid":["S03-093.79-029325"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"keyword":["Ethics","Morality","Technologies","Values"],"level":"sci","mra":["hum","sci","soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-ITU","DI-U-SDU"]},"level3all":["DI-U-AU","DI-U-ITU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"ethics values and morality introduction","src":["au","itu","sdu"],"src-code":["DI-U-AU","DI-U-ITU","DI-U-SDU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85160471477","version":"Other Version"},"id":"S03-093.79-029325","identifier":[{"id":"85160471477","type":"scopus"}],"ids":["au-e5e3aaf6-35f4-4bc9-bb13-9b4178d926ae","itu-761e3211-1789-4a5c-957d-c0c16017697f","sdu-bd714ef5-7df1-44e6-b2de-e353b93646e3"],"keyword":["Ethics","Morality","Technologies","Values"],"lang":"English","level":"Scientific","mra":["Humanities","Science/Technology","Social Science"],"noi":["Global-Local-2-6-74E758BEF817403562470A4F1CCA33C8"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Technologies in Practice, Technologies in Practice"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, Danish School of Education, Danish School of Education - Educational Anthropology, Aarhus"],"nora_code":"DI-U-AU","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Business and Social Sciences, Department of Business & Management (DBM)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Rachel","key":"douglasjonespau","last":"Douglas-Jones","locid":"f11b0cc1-ad9f-4b12-b805-65b70e5bcd65","name":"Douglas-Jones, Rachel","orcid":"0000-0001-9562-6572","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Maja Hojer","key":"bruunpau","last":"Bruun","locid":"fd7fa4bb-1d54-43ae-b40c-f5c8acae5f6d","name":"Bruun, Maja Hojer","orcid":"0000-0002-9877-8800","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Dorthe Brogaard","key":"kristensenpau","last":"Kristensen","locid":"a9b43877-9747-46c6-ae54-fa91cad9a1f6","name":"Kristensen, Dorthe Brogaard","orcid":"0000-0002-9008-9349","rank":3,"rolecode":"pau"},{"affno":"","first":"Maja","key":"bruunpedh","last":"Bruun","name":"Bruun, Maja","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Ayo","key":"wahlbergpedh","last":"Wahlberg","name":"Wahlberg, Ayo","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Rachel","key":"douglasjonespedh","last":"Douglas-Jones","name":"Douglas-Jones, Rachel","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Cathrine","key":"hassepedh","last":"Hasse","name":"Hasse, Cathrine","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Klaus","key":"høyerpedh","last":"Høyer","name":"Høyer, Klaus","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Dorthe","key":"brogårdkristensenpedh","last":"Brogård Kristensen","name":"Brogård Kristensen, Dorthe","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Dorthe Brogaard","key":"kristensenpedh","last":"Kristensen","name":"Kristensen, Dorthe Brogaard","rank":9,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Brit Ross","key":"winthereikpedh","last":"Winthereik","name":"Winthereik, Brit Ross","rank":10,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-981-16-7084-8_26","eisbn":["9789811670848"],"isbn":["9789811670831","9789811670862"],"pages":"509-527","place":"Singapore","publisher":"Palgrave Macmillan","status":"p","title":"The Palgrave Handbook of the Anthropology of Technology"},"review":"Peer Reviewed","scoID":["2-s2.0-85160471477"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-e5e3aaf6-35f4-4bc9-bb13-9b4178d926ae","itu-761e3211-1789-4a5c-957d-c0c16017697f","sdu-bd714ef5-7df1-44e6-b2de-e353b93646e3"],"src":["AU Aarhus University","ITU IT University of Copenhagen","SDU University of Southern Denmark"],"title":"Ethics, values and morality : Introduction","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-093.79-029325","year":"2022","yearsub":"2022"}
{"abstract":"Organisations are good places wherein to explore the social dependence and embeddedness of technologies, technological relations, and technological systems. Like organisations, technologies are tied to goal-oriented, purposive action, and thrive on hope and imaginaries, often in a future-oriented manner (e.g. the latest slogans of ‘digitalisation’ and ‘disruption’). The chapter reviews organisational anthropological studies of technology companies, from shop floor ethnographies and studies of organisational culture to the first anthropological studies of computerisation and digital infrastructures. Drawing on ethnographic cases from the robot industry in Germany (interconnected, sensor-equipped, collaborative robots) and the shipping industry in Denmark (digital navigation tools), the chapter demonstrates how powerful imaginaries of digital technological transformation and everyday work experiences with the development and use of digital technologies form the perceptions of decision makers and managers and transform the working lives of operators and navigators. Digitalisation opens up new ways of organising industries, companies, workplaces, and work tasks, but these new ways cannot be predicted or inferred from the technologies. To analyse how digitalisation influences organisational realities, upsets hierarchies, affects professional identities, and changes work practices in multiple, unanticipated ways, the authors resort to the classic organisational anthropological concepts of culture, power, knowledge, and practice.","author_count":9,"contributors":["Bruun, Maja Hojer","Krause-Jensen, Jakob"],"cuid":["S01-000.00-153444"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Digital technology","Navigation","Robotics","Technology companies"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"inside technology organisations imaginaries of digitalisation at work","src":["au"],"src-code":["DI-U-AU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85160490491","version":"Other Version"},"id":"S01-000.00-153444","identifier":[{"id":"85160490491","type":"scopus"}],"ids":["au-2a121f1c-5207-4e28-9b03-d69766adc9d7"],"keyword":["Digital technology","Navigation","Organisational anthropology","Robotics","Technology companies"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-4-57D3C3739680CA7585778D1FC25DE218"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, Danish School of Education, Danish School of Education - Educational Anthropology, Aarhus"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Maja Hojer","key":"bruunpau","last":"Bruun","locid":"fd7fa4bb-1d54-43ae-b40c-f5c8acae5f6d","name":"Bruun, Maja Hojer","orcid":"0000-0002-9877-8800","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jakob","key":"krausejensenpau","last":"Krause-Jensen","locid":"938a1e67-742a-4bb4-94b1-4d98fe8e19f9","name":"Krause-Jensen, Jakob","orcid":"0000-0002-5951-0086","rank":2,"rolecode":"pau"},{"affno":"","first":"Maja","key":"bruunpedh","last":"Bruun","name":"Bruun, Maja","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Ayo","key":"wahlbergpedh","last":"Wahlberg","name":"Wahlberg, Ayo","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Rachel","key":"douglasjonespedh","last":"Douglas-Jones","name":"Douglas-Jones, Rachel","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Cathrine","key":"hassepedh","last":"Hasse","name":"Hasse, Cathrine","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Klaus","key":"høyerpedh","last":"Høyer","name":"Høyer, Klaus","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Dorthe Brogaard","key":"kristensenpedh","last":"Kristensen","name":"Kristensen, Dorthe Brogaard","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Brit Ross","key":"winthereikpedh","last":"Winthereik","name":"Winthereik, Brit Ross","rank":9,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"eisbn":["9789811670848"],"isbn":["9789811670831"],"pages":"485-505","place":"Singapore","status":"p","title":"The Palgrave Handbook of the Anthropology of Technology"},"review":"Peer Reviewed","scoID":["2-s2.0-85160490491"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-2a121f1c-5207-4e28-9b03-d69766adc9d7"],"src":["AU Aarhus University"],"title":"Inside Technology Organisations : Imaginaries of Digitalisation at Work","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-153444","year":"2022","yearsub":"2022"}
{"author_count":6,"contributors":["Grietens, Koen Peeters","Friesen, Phoebe","Gerrets, Rene","Kuhn, Gustav","Kingori, Patricia","Douglas-Jones, Rachel"],"cuid":["S01-000.00-381610"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Asia, East","Europe, EU","Europe, Non-EU","OECD"],"country":["Belgium","Canada","Japan","Netherlands","United Kingdom"],"glorg":["All Global Affiliations","Department of Anthropology, University of Amsterdam","Goldsmiths, University of London","Institute of Tropical Medicine Antwerp","McGill University","Nagasaki University,","University of Oxford"],"keyword":["Ethnography","Global Health","misdirection"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"misdirection in global health creating the illusion of im possible alternatives in global health research and practice","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/doi:%2010.23987/sts.115410","version":"Published Version"},"id":"S01-000.00-381610","identifier":[{"id":"85133168575","type":"scopus"}],"ids":["itu-16a7de59-c1ff-4d0e-b0d1-e0dbc95e59bd"],"keyword":["ethnography","global health","misdirection"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-30BB5A230BBEFE75874D3E8A4BED0A10"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/doi:%2010.23987/sts.115410","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"be","key":"institute of tropical medicine antwerp","loc":["Belgium","Europe, EU","OECD"],"name":"Institute of Tropical Medicine Antwerp","used"