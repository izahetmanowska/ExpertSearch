t":"Shepperson","locid":"5a3e5474-32fe-49e3-8446-5f3d13610624","name":"Shepperson, Benjamin","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik","key":"stapelfeldthenrikpau","last":"Stapelfeldt","locid":"a9848e15-c57a-44e9-9df0-efab2ef571fd","name":"Stapelfeldt, Henrik","orcid":"0000-0002-0881-2519","rank":11,"rolecode":"pau"}],"pmid":["25170706"],"pub":{"doi":"10.1103/physrevlett.113.073005","issn":["00319007","10797114"],"issn_org":["00319007"],"journal":"Physical Review Letters","paperid":"073005","publisher":"American Physical Society","status":"p","title":"Physical Review Letters","volume":"113"},"review":"Peer Reviewed","scoID":["2-s2.0-84922486420"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-99ad053a-dc27-4988-9c15-a542acbf2562"],"src":["AU Aarhus University"],"title":"Dynamic Stark Control of Torsional Motion by a Pair of Laser Pulses","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-216888","year":"2014","yearsub":"2014"}
{"abstract":"We show that a 450 fs nonresonant, moderately intense, linearly polarized laser pulse can induce field-free molecular axis alignment of methyliodide (CH3I) molecules dissolved in a helium nanodroplet. Time-resolved measurements reveal rotational dynamics much slower than that of isolated molecules and, surprisingly, complete absence of the sharp transient alignment recurrences characteristic of gas phase molecules. Our results presage a range of new opportunities for exploring both molecular dynamics in a dissipative environment and the properties of He nanodroplets.","author_count":5,"contributors":["Pentlehner, Dominik Tobias Viktor","Nielsen, Jens Hedegaard","Slenczka, Alkwin","Mølmer, Klaus","Stapelfeldt, Henrik"],"cuid":["S01-000.00-145915"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["physics chem ph"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"impulsive laser induced alignment of molecules dissolved in helium nanodroplets","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1103/PhysRevLett.110.093002","version":"Other Version"},"id":"S01-000.00-145915","identifier":[{"id":"84874531798","type":"scopus"},{"id":"23496707","type":"pmid"}],"ids":["au-1cf27eb2-30f9-490b-ac80-ca17e2aea983"],"keyword":["physics.chem-ph"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-7697B83495A662DAEAFD5D626595F9C2"],"oa_link":[{"access":"oa","type":"rem","url":"http://prl.aps.org/abstract/PRL/v110/i9/e093002","version":"Other Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1103/PhysRevLett.110.093002","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Physics and Astronomy"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Dominik","key":"pentlehnerpau","last":"Pentlehner","locid":"6c4ba0ba-d4a6-43a9-ada4-99755e4d8430","name":"Pentlehner, Dominik Tobias Viktor","name_org":"Pentlehner, Dominik","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens","key":"hnielsenpau","last":"H. Nielsen","locid":"3ac8fbfb-b330-4710-89f0-e27741600cf3","name":"Nielsen, Jens Hedegaard","name_org":"H. Nielsen, Jens","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Alkwin","key":"slenczkapau","last":"Slenczka","name":"Slenczka, Alkwin","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Klaus","key":"mølmerpau","last":"Mølmer","locid":"860eabfe-1f03-496d-9a90-87b7f29c21bf","name":"Mølmer, Klaus","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik","key":"stapelfeldtpau","last":"Stapelfeldt","locid":"a9848e15-c57a-44e9-9df0-efab2ef571fd","name":"Stapelfeldt, Henrik","orcid":"0000-0002-0881-2519","rank":5,"rolecode":"pau"}],"pmid":["23496707"],"pub":{"doi":"10.1103/physrevlett.110.093002","issn":["00319007","10797114"],"issn_org":["00319007"],"issue":"9","journal":"Physical Review Letters","pages":"093002","publisher":"American Physical Society","status":"p","title":"Physical Review Letters","volume":"110"},"review":"Peer Reviewed","scoID":["2-s2.0-84874531798"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-1cf27eb2-30f9-490b-ac80-ca17e2aea983"],"src":["AU 