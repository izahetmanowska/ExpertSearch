.0-84955188275"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Hospitals","Other Research","Region Zealand","Universities","University of Copenhagen","University of Southern Denmark","private practice - denmark (medical)"],"PST":["Published"]},"sid":["au-bff0470e-cbcf-413f-a3b3-47f8dade71c2","ku-647bf9b3-a229-436a-82e8-8eb05c1418d5","sdu-0ce1780f-bc10-4f13-a8d4-70c6d41d53aa"],"src":["AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Treatment of adult patients with schizophrenia and complex mental health needs - A national clinical guideline","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-089.10-026609","year":"2016","yearsub":"2016"}
{"abstract":"Coulomb explosion of 1,4-diiodobenzene molecules, isolated or embedded in helium nanodroplets, is induced by irradiation with an intense femtosecond laser pulse. The recoiling ion fragments are probed by time-of-flight measurements and two-dimensional velocity map imaging. Correlation analysis of the emission directions of I+ ions recoiling from each end of the molecules reveals significant deviation from axial recoil, i.e., where the I+ ions leave strictly along the I-I symmetry axis. For isolated molecules, the relative angular distribution of the I+ ions is centered at 180 corresponding to perfect axial recoil, but with a full width at half maximum of 30. For molecules inside He droplets, the width of the distribution increases to 45. These results provide a direct measure of the accuracy of Coulomb explosion as a probe of the spatial orientation of molecules, which is particularly relevant in connection with laser-induced molecular alignment and orientation. In addition, our studies show how it is possible to identify fragmentation pathways of the Coulomb explosion for the isolated 1,4-diiodobenzene molecules. Finally, for the 1,4-diiodobenzene molecules in He droplets, it is shown that the angular correlation between fragments from the Coulomb explosion is preserved after they have interacted with the He environment.","author_count":6,"contributors":["Christiansen, Lars","Nielsen, Jens Hedegaard","Christensen, Lauge","Shepperson, Benjamin","Pentlehner, Dominik Tobias Viktor","Stapelfeldt, Henrik"],"cuid":["S01-000.00-167699"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Stapelfeldt, Henrik"],"keyword":["Alignment","COINCIDENCE","Dynamics","FIELDS","Photoelectron","X ray"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"laser induced coulomb explosion of 000000000001 000000000004 diiodobenzene molecules studies of isolated molecules and molecules in helium nanodroplets","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84958012859","version":"Other Version"},"id":"S01-000.00-167699","identifier":[{"id":"84958012859","type":"scopus"},{"id":"000369725400007","type":"wos"}],"ids":["au-435af38f-e53c-4d6c-b346-3ae5b0a1d12d"],"keyword":["ALIGNMENT","ANGULAR-DISTRIBUTIONS","COINCIDENCE","COVARIANCE DATA-ACQUISITION","DYNAMICS","ENHANCED IONIZATION","FIELDS","FRAGMENT IONS","PHOTOELECTRON","X-RAY"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-BB7629C257578803D82B4818E7637D3D"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Physics and Astronomy"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lars","key":"christiansenpau","last":"Christiansen","locid":"7301b7f3-8fb9-4590-bb0c-96848158e221","name":"Christiansen, Lars","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens H.","key":"nielsenpau","last":"Nielsen","locid":"3ac8fbfb-b330-4710-89f0-e27741600cf3","name":"Nielsen, Jens Hedegaard","name_org":"Nielsen, Jens H.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lauge","key":"christensenpau","last":"Christensen","locid":"4ae31c54-ec4e-4bef-9f13-040e7da1fe78","name":"Christensen, Lauge","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Benjamin","key":"sheppersonpau","last":"Shep