{"author_count":8,"contributors":["Fock, Jeppe","Leijnse, Martin","Jennum, Karsten Stein","Zyazin, A.S.","Paaske, Jens","Hedegård, Per","Nielsen, Mogens Brøndsted","van der Zant, H.S.J."],"cuid":["S01-000.00-449001"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Netherlands"],"glorg":["All Global Affiliations","Delft University of Technology"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"manipulation of organic polyradicals in a single molecule transistor","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1103/PhysRevB.86.235403","version":"Other Version"},"id":"S01-000.00-449001","identifier":[{"id":"84871076872","type":"scopus"}],"ids":["ku-5cc958c4-fbf1-414d-8973-cb38d31afcdc"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-6912A75ECA90DF4E4D31DE84C9F93592"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1103/PhysRevB.86.235403","version":"Other Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Chemistry"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"nl","key":"delft university of technology","loc":["Netherlands","Europe, EU","OECD"],"name":"Delft University of Technology","used":1}],"person":[{"affno":"1","first":"Jeppe","key":"fockpau","last":"Fock","locid":"580dc459-1065-4c1a-9b53-1a49b7ff1246","name":"Fock, Jeppe","rank":1,"rolecode":"pau"},{"affno":"1","first":"Martin Christian","key":"leijnsepau","last":"Leijnse","locid":"ec766f74-7b9d-462c-b384-633104ddcbf8","name":"Leijnse, Martin","name_org":"Leijnse, Martin Christian","rank":2,"rolecode":"pau"},{"affno":"1","first":"Karsten Stein","key":"jennumpau","last":"Jennum","locid":"e4840ff9-f82b-4822-acb5-25704bcfddc5","name":"Jennum, Karsten Stein","rank":3,"rolecode":"pau"},{"affno":"2","first":"A.S.","key":"zyazinpau","last":"Zyazin","name":"Zyazin, A.S.","rank":4,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Jens","key":"paaskepau","last":"Paaske","locid":"b7532651-38b8-416a-9916-84f760a7852f","name":"Paaske, Jens","orcid":"0000-0002-8087-591X","rank":5,"rolecode":"pau"},{"affno":"1","first":"Per","key":"hedegårdpau","last":"Hedegård","locid":"3125dd78-d89e-450d-88d3-08a8401f38b9","name":"Hedegård, Per","orcid":"0000-0002-6328-7462","rank":6,"rolecode":"pau"},{"affno":"1","first":"Mogens Brøndsted","key":"nielsenpau","last":"Nielsen","locid":"d5a042aa-d63e-45b0-a022-f3de910fde75","name":"Nielsen, Mogens Brøndsted","orcid":"0000-0001-8377-0788","rank":7,"rolecode":"pau"},{"affno":"2","first":"H.S.J.","key":"vanderzantpau","last":"van der Zant","name":"van der Zant, H.S.J.","rank":8,"rolecode":"pau"}],"pub":{"doi":"10.1103/physrevb.86.235403","issn":["1550235X","24699950"],"issn_org":["24699950"],"issue":"23","journal":"Physical Review B","status":"p","title":"Physical Review B","volume":"86"},"review":"Peer Reviewed","scoID":["2-s2.0-84871076872"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-5cc958c4-fbf1-414d-8973-cb38d31afcdc"],"src":["KU University of Copenhagen"],"title":"Manipulation of organic polyradicals in a single-molecule transistor","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-449001","year":"2012","yearsub":"2012"}
{"abstract":"We study how the combination of long and short laser pulses can be used to induce torsion in an axially chiral biphenyl derivative (3,5-difluoro-3′,5′-dibromo-4′-cyanobiphenyl). A long, with respect to the molecular rotational periods, elliptically polarized laser pulse produces 3D alignment of the molecules, and a linearly polarized short pulse initiates torsion about the stereogenic axis. The torsional motion is monitored in real-time by measuring the dihedral angle using femtosecond time-resolved Coulomb explosion imaging. Within the first 4 picoseconds (ps), torsion occurs with a period of 1.25 ps and an amplitude of 3° in excellent agreement with theoretical calculations. At larger times, the quantum states of the molecules describing the torsional motion dephase and an almost isotropic distribution of the dihedral angle is measured. We demonstrate an original application of covariance analysis of two-dimensional ion images to reveal strong correlations between specific ejected ionic fragments from Coulomb explosion. This technique strengthens our interpretation of the experimental data.","author_count":8,"contributors":["Hansen, Jonas Lerche","Nielsen, Jens Hedegaard","Madsen, Christian Bruun","Lindhardt, Anders Thyboe","Johansson, Michael P.","Skrydstrup, Troels","Madsen, Lars Bojer","Stapelfeldt, Henrik"],"cuid":["S01-000.00-169341"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Spain"],"glorg":["All Global Affiliations","University of Girona"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"control and femtosecond time resolved imaging of torsion in a chiral molecule","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1063/1.4719816","version":"Other Version"},"id":"S01-000.00-169341","identifier":[{"id":"84862521441","type":"scopus"},{"id":"22667563","type":"pmid"}],"ids":["au-46224fc9-763f-4a09-a3a7-8035b9a5d6d5"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-11ACA463D629238C34435841EB1417BF"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1063/1.4719816","version":"Other Version"},{"access":"oa","type":"rem","url":"http://jcp.aip.org/resource/1/jcpsa6/v136/i20/p204310_s1","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Interdisciplinary Nanoscience Center, Interdisciplinary Nanoscience Center - iNano-School"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"es","key":"university of girona","loc":["Spain","Europe, EU","OECD"],"name":"University of Girona","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jonas Lerche","key":"hansenjonaslerchepau","last":"Hansen","locid":"b610cf54-c7b2-45a6-8012-589523abc04c","name":"Hansen, Jonas Lerche","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens Hedegaard","key":"nielsenjenshedegaardpau","last":"Nielsen","locid":"3ac8fbfb-b330-4710-89f0-e27741600cf3","name":"Nielsen, Jens Hedegaard","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christian Bruun","key":"madsenchristianbruunpau","last":"Madsen","locid":"ef62fb27-2288-47c1-840f-385c073a8908","name":"Madsen, Christian Bruun","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders Thyboe","key":"lindhardtandersthyboepau","last":"Lindhardt","locid":"14a66f7a-665d-469e-81f7-df24b20795ea","name":"Lindhardt, Anders Thyboe","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Michael P.","key":"johanssonmichaelppau","last":"Johansson","name":"Johansson, Michael P.","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Troels","key":"skrydstruptroelspau","last":"Skrydstrup","locid":"67f8ccf9-98a3-4760-a864-1d012fffc489","name":"Skrydstrup, Troels","orcid":"0000-0001-8090-5050","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars Bojer","key":"madsenlarsbojerpau","last":"Madsen","locid":"795cdf07-569b-4410-a79f-46c79029912f","name":"Madsen, Lars Bojer","orcid":"0000-0001-7403-2070","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik","key":"stapelfeldthenrikpau","last":"Stapelfeldt","locid":"a9848e15-c57a-44e9-9df0-efab2ef571fd","name":"Stapelfeldt, Henrik","orcid":"0000-0002-0881-2519","rank":8,"rolecode":"pau"}],"pmid":["22667563"],"pub":{"doi":"10.1063/1.4719816","issn":["00219606","10897690"],"issn_org":["00219606"],"issue":"20","journal":"Journal of Chemical Physics","pages":"204310","publisher":"American Institute of Physics","status":"p","title":"Journal of Chemical Physics","volume":"136"},"review":"Peer Reviewed","scoID":["2-s2.0-84862521441"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-46224fc9-763f-4a09-a3a7-8035b9a5d6d5"],"src":["AU Aarhus University"],"title":"Control and femtosecond time-resolved imaging of torsion in a chiral molecule","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-169341","year":"2012","yearsub":"2012"}
{"abstract":"The aim was to establish a non-primate large animal PD model by lentiviral vector mediated mutant alpha-synuclein overexpression in the substantia nigra. Lentivirus encoding A53T alpha-synuclein (6 x 2.5 microliter) was stereotaxically injected into the substantia nigra of six adult female Gottingen minipigs. Contralateral control injections encoding enhanced green fluorescent protein (EGFP) were performed. Gait-analysis was performed pre- and postoperatively. PCR of the transgenes and immunohistochemical staining against alpha-synuclein, EGFP, GFAP and TH was performed after 20 weeks. Gait analysis revealed a significant increase in step length and height, and a decrease in the double stand phase. PCR verified the mesencephalic presence of transgenes. IHC analysis showed alpha-synuclein expression in nigral neurons, around the injection tract and in related nigrostriatal projections. The alpha-synuclein positive neurons appeared swollen and vacuolated, in contrast to the EGFP-injected control side. To transduct all nigrostriatal cells with few microinjections, wider dissemination of the transgene must be achieved.","author_count":9,"contributors":["Glud, Andreas Nørgaard","Hedegaard, Claus","Nielsen, Mette Slot","Sorensen, Jens Christian","Bendixen, Christian","Jensen, Poul Henning","Mogensen, Poul","Larsen, Knud Erik","Bjarkam, Carsten Reidies"],"cuid":["S01-000.00-268752"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"direct mri guided stereotaxic viral mediated gene transfer of alpha synuclein in the gottingen minipig cns","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84855786923","version":"Other Version"},"id":"S01-000.00-268752","identifier":[{"id":"84855786923","type":"scopus"},{"id":"22237496","type":"pmid"}],"ids":["au-f475d720-7615-4228-bc4b-a033348a6e57"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-6-BD419204331E0EC541939427206EB2A8"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Neurosurgery"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"AN","key":"gludpau","last":"GLUD","locid":"7c293aba-b85e-4919-ac45-c7fe82208804","name":"Glud, Andreas Nørgaard","name_org":"GLUD, AN","orcid":"0000-0003-3339-6120","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Claus","key":"hedegaardpau","last":"Hedegaard","locid":"a3984d54-1b5d-49f0-af2e-16563971975e","name":"Hedegaard, Claus","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mette Slot","key":"nielsenpau","last":"Nielsen","locid":"bb29c970-ea2d-4334-b42e-6d692dbd6ecf","name":"Nielsen, Mette Slot","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens Christian","key":"sorensenpau","last":"Sorensen","name":"Sorensen, Jens Christian","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christian","key":"bendixenpau","last":"Bendixen","locid":"527e8fa7-a9e1-4eac-a0bf-c84d3d2f9655","name":"Bendixen, Christian","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Poul Henning","key":"jensenpau","last":"Jensen","locid":"024d1156-8131-4380-9e88-3fe798d93808","name":"Jensen, Poul Henning","orcid":"0000-0002-4439-9020","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Poul Henning","key":"mogensenpau","last":"Mogensen","locid":"d8ee1369-4266-4cc4-aebb-8ddc1d950310","name":"Mogensen, Poul","name_org":"Mogensen, Poul Henning","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Knud","key":"larsenpau","last":"Larsen","locid":"46cd3e98-1529-45bf-9054-2978f328044c","name":"Larsen, Knud Erik","name_org":"Larsen, Knud","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Carsten Reidies","key":"bjarkampau","last":"Bjarkam","locid":"a1770adc-a79f-434a-98bc-02e64ffd13cd","name":"Bjarkam, Carsten Reidies","rank":9,"rolecode":"pau"}],"pmid":["22237496"],"pub":{"issn":["00651400","16890035"],"issn_org":["00651400"],"issue":"4","journal":"Acta Neurobiologiae Experimentalis","pages":"508-518","publisher":"Nencki Institute of Experimental Biology","status":"p","title":"Acta Neurobiologiae Experimentalis","volume":"71"},"review":"Peer Reviewed","scoID":["2-s2.0-84855786923"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-f475d720-7615-4228-bc4b-a033348a6e57"],"src":["AU Aarhus University"],"title":"Direct MRI-guided stereotaxic viral mediated gene transfer of alpha-synuclein in the Gottingen minipig CNS","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-268752","year":"2011","yearsub":"2011"}
{"abstract":"We present combined experimental and theoretical results on strong-field ionization of oriented carbonyl sulfide molecules by circularly polarized laser pulses. The obtained molecular frame photoelectron angular distributions show pronounced asymmetries perpendicular to the direction of the molecular electric dipole moment. These findings are explained by a tunneling model invoking the laser-induced Stark shifts associated with the dipoles and polarizabilities of the molecule and its unrelaxed cation. The focus of the present article is to understand the strong-field ionization of one-dimensionally-oriented polar molecules, in particular asymmetries in the emission direction of the photoelectrons. In the following article [Phys. Rev. A 83, 023406 (2011)] the focus is to understand strong-field ionization from three-dimensionally-oriented asymmetric top molecules, in particular the suppression of electron emission in nodal planes of molecular orbitals.","author_count":10,"contributors":["Dimitrovski, Darko","Abu-Samha, Mahmoud","Madsen, Lars Bojer","Filsinger, Frank","Meijer, Gerard","Küpper, Jochen","Holmegaard, Lotte","Kalhøj, Line","Nielsen, Jens Hedegaard","Stapelfeldt, Henrik"],"cuid":["S01-000.00-270703"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","Fritz Haber Institute of the Max Planck Society"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"ionization of oriented carbonyl sulfide molecules by intense circularly polarized laser pulses","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1103/PhysRevA.83.023405","version":"Other Version"},"id":"S01-000.00-270703","identifier":[{"id":"79951522777","type":"scopus"}],"ids":["au-f7d2dabc-0f98-428c-9198-441dd2fc9f83"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-D9848742E0347AD56C47730D59422307"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1103/PhysRevA.83.023405","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus University, Faculty of Science, Department of Physics and Astronomy","Aarhus University, Aarhus University, Teoretisk naturvidenskab"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"de","key":"fritz haber institute of the max planck society","loc":["Germany","Europe, EU","OECD"],"name":"Fritz Haber Institute of the Max Planck Society","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Darko","key":"dimitrovskipau","last":"Dimitrovski","locid":"eb9aab3f-49ae-40b2-9357-d530b626b2be","name":"Dimitrovski, Darko","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mahmoud","key":"abusamhapau","last":"Abu-Samha","locid":"1f1a7e74-2cb6-47dc-8477-dfdd0be6ae6b","name":"Abu-Samha, Mahmoud","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars Bojer","key":"madsenpau","last":"Madsen","locid":"795cdf07-569b-4410-a79f-46c79029912f","name":"Madsen, Lars Bojer","orcid":"0000-0001-7403-2070","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Frank","key":"filsingerpau","last":"Filsinger","name":"Filsinger, Frank","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Gerard","key":"meijerpau","last":"Meijer","name":"Meijer, Gerard","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jochen","key":"küpperpau","last":"Küpper","name":"Küpper,