{"author_count":1,"contributors":["Nielsen, Jens Hedegaard"],"cuid":["S01-000.00-253695"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"und","rtype":["clu"],"sorti":"laser induced alignment and orientation of quantum state selected molecules and molecules in liquid helium droplets","src":["au"],"src-code":["DI-U-AU"],"type":"dtd","type-grp":["all","pub"]},"id":"S01-000.00-253695","ids":["au-d9e1a1d7-9e1e-463b-963d-ecc30b82d44b"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-EDC7614B89B9E7DE417303E33CBB5A65"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Physics and Astronomy"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jens Hedegaard","key":"nielsenpau","last":"Nielsen","locid":"3ac8fbfb-b330-4710-89f0-e27741600cf3","name":"Nielsen, Jens Hedegaard","rank":1,"rolecode":"pau"}],"pub":{"place":"Aarhus","publisher":"Naturvidenskabeligt Fakultet","status":"p"},"review":"Undetermined","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-d9e1a1d7-9e1e-463b-963d-ecc30b82d44b"],"src":["AU Aarhus University"],"title":"Laser-Induced Alignment and Orientation of Quantum-State Selected Molecules and Molecules in Liquid Helium Droplets","type":"Thesis Doctoral","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-253695","year":"2012","yearsub":"2012"}
{"abstract":"The yield of strong-field ionization, by a linearly polarized probe pulse, is studied experimentally and theoretically as a function of the relative orientation between the laser field and the molecule. Experimentally, carbonyl sulphide (OCS), benzonitrile and naphthalene molecules are aligned in one or three dimensions before being singly ionized by a 30 fs laser pulse centred at 800 nm. Theoretically, we address the behaviour of these three molecules. We consider the degree of alignment and orientation and model the angular dependence of the total ionization yield by molecular tunnelling theory accounting for the Stark shift of the energy level of the ionizing orbital. For naphthalene and benzonitrile, the orientational dependence of the ionization yield agrees well with the calculated results, in particular, we observe that ionization is maximized when the probe laser is polarized along the most polarizable axis. For OCS the observation of the maximum ionization yield when the probe is perpendicular to the internuclear axis contrasts the theoretical results.","author_count":6,"contributors":["Hansen, Jonas Lerche","Holmegaard, Lotte","Nielsen, Jens Hedegaard","Stapelfeldt, Henrik","Dimitrovski, Darko","Madsen, Lars Bojer"],"cuid":["S01-000.00-150934"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"orientation dependent ionization yields from strong field ionization of fixed in space linear and asymmetric top molecules","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1088/0953-4075/45/1/015101","version":"Other Version"},"id":"S01-000.00-150934","identifier":[{"id":"83755169118","type":"scopus"}],"ids":["au-2598e282-2c02-404b-b63a-48da5841cb20"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-FEE9FCF6C5852EF36FB1C8154866389D"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1088/0953-4075/45/1/015101","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Chemistry","Aarhus University, Natural Sciences, Interdisciplinary Nanoscience Center, Interdisciplinary Nanoscience Center - iNano-School"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jonas Lerche","key":"hansenpau","last":"Hansen","locid":"b610cf54-c7b2-45a6-8012-589523abc04c","name":"Hansen, Jonas Lerche","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lotte","key":"holmegaardpau","last":"Holmegaard","locid":"46e33384-ee5b-4d5f-a455-2b83fa810704","name":"Holmegaard, Lotte","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens Hedegaard","key":"nielsenpau","last":"Nielsen","locid":"3ac8fbfb-b330-4710-89f0-e27741600cf3","name":"Nielsen, Jens Hedegaard","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik","key":"stapelfeldtpau","last":"Stapelfeldt","locid":"a9848e15-c57a-44e9-9df0-efab2ef571fd","name":"Stapelfeldt, Henrik","orcid":"0000-0002-0881-2519","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Darko","key":"dimitrovskipau","last":"Dimitrovski","locid":"eb9aab3f-49ae-40b2-9357-d530b626b2be","name":"Dimitrovski, Darko","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars Bojer","key":"madsenpau","last":"Madsen","locid":"795cdf07-569b-4410-a79f-46c79029912f","name":"Madsen, Lars Bojer","orcid":"0000-000