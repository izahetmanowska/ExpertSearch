:"Hubert Dariusz","key":"zającpau","last":"Zając","locid":"5b4b2c83-b0ba-4069-8c3a-1459682b8ab6","name":"Zajac, Hubert Dariusz","name_org":"Zając, Hubert Dariusz","rank":27,"rolecode":"pau"},{"affno":"21","first":"Maria A.","key":"zuluagapau","last":"Zuluaga","name":"Zuluaga, Maria A.","rank":28,"rolecode":"pau"},{"affno":"1","first":"Veronika","key":"cheplyginapau","last":"Cheplygina","name":"Cheplygina, Veronika","rank":29,"rolecode":"pau"}],"pub":{"doi":"10.48550/arxiv.2501.1072","pages":"33","publisher":"arxiv.org","publisher_org":"arXiv.org","status":"p"},"review":"Undetermined","search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","IT University of Copenhagen","Technical University of Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-34ae77df-0e2d-4fa6-8f92-0e59375ceb5e"],"src":["KU University of Copenhagen"],"title":"In the Picture : Medical Imaging Datasets, Artifacts, and their Living Review","type":"Working Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-799232","year":"2025","yearsub":"2025"}
{"abstract":"Medical Imaging (MI) datasets are fundamental to artificial intelligence in healthcare. The accuracy, robustness, and fairness of diagnostic algorithms depend on the data (and its quality) used to train and evaluate the models. MI datasets used to be proprietary, but have become increasingly available to the public, including on community-contributed platforms (CCPs) like Kaggle or HuggingFace. While open data is important to enhance the redistribution of data’s public value, we find that the current CCP governance model fails to uphold the quality needed and recommended practices for sharing, documenting, and evaluating datasets. In this paper, we conduct an analysis of publicly available machine learning datasets on CCPs, discussing datasets’ context, and identifying limitations and gaps in the current CCP landscape. We highlight differences between MI and computer vision datasets, particularly in the potentially harmful downstream effects from poor adoption of recommended dataset management practices. We compare the analyzed datasets across several dimensions, including data sharing, data documentation, and maintenance. We find vague licenses, lack of persistent identifiers and storage, duplicates, and missing metadata, with differences between the platforms. Our research contributes to efforts in responsible data curation and AI algorithms for healthcare.","author_count":8,"contributors":["Jiménez Sánchez, Amelia","Avlona, Natalia-Rozalia","Juodelyte, Dovile","Sourget, Théo","Vang-Larsen, Caroline","Rogers, Anna","Zajac, Hubert Dariusz","Cheplygina, Veronika"],"cuid":["S01-000.00-776372"],"event":{"acronym":"NeurIPS","title":"Conference on Neural Information Processing Systems"},"filters":{"added":"2025-01","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Data governance","Datasets","Healthcare","Medical imaging","Open data"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"copycats the many lives of a publicly available medical imaging dataset","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"rem","url":"https://openreview.net/forum?id=X4KImMSIRq#discussion","version":"Published Version"},"funding_acknowledgement":["Independent Research Council Denmark (DFF) Inge Lehmann 1134-00017B."],"id":"S01-000.00-776372","ids":["itu-1732a5a6-64e1-44e9-9d36-fe4367fcc30c"],"keyword":["data governance","dataset management","datasets","healthcare","medical imaging","open data"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-642DFED5726C58B113549A53E4408BAB"],"oa_link":[{"access":"oa","license":"CC BY","type":"rem","url":"https://openreview.net/forum?id=X4KImMSIRq#discussion","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data, Systems, and Robotics, Data-intensive Systems and Applications","IT University of Copenhagen, Data, Systems, and Robotics, Pattern Recognition Revisited lab"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Amelia","key":"jiménezsánchezpau","last":"Jiménez Sánchez","locid":"64730011-f493-4dbb-abf6-b48924ddc794","name":"Jiménez Sánchez, Amelia","orcid":"0000-0001-7870-0603","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Natalia-Rozalia","key":"avlonapau","last":"Avlona","name":"Avlona, Natalia-Rozalia","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Dovile","key":"juodelytepau","last":"Juodelyte","locid":"6800c64b-0e54-49cb-a703-384b4987b70c","name":"Juodelyte, Dovile","orcid":"0000-0002-6195-1120","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Théo","key":"sourgetpau","last":"Sourget","locid":"ea2d2480-46fb-493d-8dd4-6f054f58098a","name":"Sourget, Théo","orcid":"0009-0005-0220-9590","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Caroline","key":"vanglarsenpau","last":"Vang-Larsen","name":"Vang-Larsen, Caroline","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anna","key":"rogerspau","last":"Rogers","locid":"c40e1e8a-50ee-4a7c-b7f0-2fc0fdd62adc","name":"Rogers, Anna","orcid":"0000-0002-4845-4023","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Hubert Dariusz","key":"zajacpau","last":"Zajac","name":"Zajac, Hubert Dariusz","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Veronika","key":"cheplyginapau","last":"Cheplygina","locid":"1c4bfd79-4336-4b17-a672-9acb465f15c0","name":"Cheplygina, Veronika","orcid":"0000-0003-0176-9324","rank":8,"rolecode":"pau"}],"pub":{"edition":"2024","status":"p","subtitle":"Datasets and Benchmarks Track","title":"Advances in Neural Information Processing Systems 38 (NeurIPS 2024)","volume":"NeurIPS"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["itu-1732a5a6-64e1-44e9-9d36-fe4367fcc30c"],"src":["ITU IT University of Copenhagen"],"title":"Copycats: the many lives of a publicly available medical imaging dataset","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-776372","year":"2024","yearsub":"2024"}
{"abstract":"Medical imaging papers often focus on methodology, but the quality of the algorithms and the validity of the conclusions are highly dependent on the datasets used. As creating datasets requires a lot of effort, researchers often use publicly available datasets, there is however no adopted standard for citing the datasets used in scientific papers, leading to difficulty in tracking dataset usage. In this work, we present two open-source tools we created that could help with the detection of dataset usage, a pipeline1 using OpenAlex and full-text analysis, and a PDF annotation software2 used in our study to manually label the presence of datasets. We applied both tools on a study of the usage of 20 publicly available medical datasets in papers from MICCAI and MIDL. We compute the proportion and the evolution between 2013 and 2023 of 3 types of presence in a paper: cited, mentioned in the full text, cited and mentioned. Our findings demonstrate the concentration of the usage of a limited set of datasets. We also highlight different citing practices, making the automation of tracking difficult.","author_count":8,"contributors":["Sourget, Théo","Akkoç, Ahmet","Winther, Stinna","Lyngbye Galsgaard, Christine","Jiménez Sánchez, Amelia","Juodelyte, Dovile","Petitjean, Caroline","Cheplygina, Veronika"],"cuid":["S01-000.00-776403"],"filters":{"added":"2025-01","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["France"],"glorg":["All Global Affiliations","University of Rouen Normandy"],"keyword":["Annotation tools","Bibliometrics","Citations","Datasets","Medical imaging","Meta analysis"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-PR-OTH","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"citation needed data usage and citation practices in medical imaging conferences","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"rem","url":"https://openreview.net/forum?id=gFIepubv7E","version":"Published Version"},"id":"S01-000.00-776403","ids":["itu-647d7ef7-9ed5-414c-92fc-2b2e4968a7c9"],"keyword":["Annotation tools","Bibliometrics","Citations","Data re-use","Datasets","Medical imaging","Meta-analysis"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-2A1A0603E721554E11AC56F18DF91F1D"],"oa_link":[{"access":"oa","license":"CC BY","type":"rem","url":"https://openreview.net/forum?id=gFIepubv7E","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["ZiteLab ApS"],"nora_code":"DI-PR-OTH","used":1},{"affno":"3","country":"fr","key":"university of rouen normandy","loc":["France","Europe, EU","OECD"],"name":"University of Rouen Normandy","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Théo","key":"sourgetpau","last":"Sourget","locid":"ea2d2480-46fb-493d-8dd4-6f054f58098a","name":"Sourget, Théo","orcid":"0009-0005-0220-9590","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ahmet","key":"akkoçpau","last":"Akkoç","name":"Akkoç, Ahmet","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Stinna","key":"wintherpau","last":"Winther","name":"Winther, Stinna","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Christine","key":"lyngbyegalsgaardpau","last":"Lyngbye Galsgaard","name":"Lyngbye Galsgaard, Christine","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Amelia","key":"jiménezsánchezpau","last":"Jiménez Sánchez","locid":"64730011-f493-4dbb-abf6-b48924ddc794","name":"Jiménez Sánchez, Amelia","orcid":"0000-0001-7870-0603","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Dovile","key":"juodelytepau","last":"Juodelyte","locid":"6800c64b-0e54-49cb-a703-384b4987b70c","name":"Juodelyte, Dovile","orcid":"0000-0002-6195-1120","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Caroline","key":"petitjeanpau","last":"Petitjean","name":"Petitjean, Caroline","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Veronika","key":"cheplyginapau","last":"Cheplygina","locid":"1c4bfd79-4336-4b17-a672-9acb465f15c0","name":"Cheplygina, Veronika","orcid":"0000-0003-0176-9324","rank":8,"rolecode":"pau"}],"pub":{"pages":"1-22","status":"p","title":"Medical Imaging with Deep Learning (MIDL)"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Other Companies","Private Research","Universities","zitelab aps"],"PST":["Published"]},"sid":["itu-647d7ef7-9ed5-414c-92fc-2b2e4968a7c9"],"src":["ITU IT University of Copenhagen"],"title":"[Citation needed] Data usage and citation practices in medical imaging conferences","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-776403","year":"2024","yearsub":"2024"}
{"abstract":"Medical Imaging (MI) datasets are fundamental to artificial intelligence in healthcare. The accuracy, robustness, and fairness of diagnostic algorithms depend on the data (and its quality) used to train and evaluate the models. MI datasets used to be proprietary, but have become increasingly available to the public, including on community-contributed platforms (CCPs) like Kaggle or HuggingFace. While open data is important to enhance the redistribution of data's public value, we find that the current CCP governance model fails to uphold the quality needed and recommended practices for sharing, documenting, and evaluating datasets. In this paper, we conduct an analysis of publicly available machine learning datasets on CCPs, discussing datasets' context, and identifying limitations and gaps in the current CCP landscape. We highlight differences between MI and computer vision datasets, particularly in the potentially harmful downstream effects from poor adoption of recommended dataset management practices. We compare the analyzed datasets across several dimensions, including data sharing, data documentation, and maintenance. We find vague licenses, lack of persistent identifiers and storage, duplicates, and missing metadata, with differences between the platforms. Our research contributes to efforts in responsible data curation and AI algorithms for healthcare.","author_count":8,"contributors":["Jiménez-Sánchez, Amelia","Avlona, Natalia Rozalia","Juodelyte, Dovile","Sourget, Théo","Vang-Larsen, Caroline","Rogers, Anna","Zajac, Hubert Dariusz","Cheplygina, Veronika"],"cuid":["S01-000.00-809050"],"event":{"end":"2024-12-15","place":"Vancouver,; BC, ca","start":"2024-12-08","title":"38th Conference on Neural Information Processing Systems (NeurIPS 2024).","year":"2024"},"filters":{"added":"2025-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"copycats the many lives of a publicly available medical imaging dataset","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://proceedings.neurips.cc/paper_files/paper/2024/hash/cdbeaeb8a0313940a5752c4ec8838ca6-Abstract-Datasets_and_Benchmarks_Track.html","version":"Published Version"},"id":"S01-000.00-809050","ids":["ku-0ac5afda-3243-4df0-8e3c-952821c1b3d4"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-7924FFF3A0B836BA39E4922BD057734A"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/437981761/Copycats.pdf","version":"Authors Final Version"},{"access":"oa","type":"rem","url":"https://proceedings.neurips.cc/paper_files/paper/2024/hash/cdbeaeb8a0313940a5752c4ec8838ca6-Abstract-Datasets_and_Benchmarks_Track.html","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Department of Computer Science"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Amelia","key":"jiménezsánchezpau","last":"Jiménez-Sánchez","name":"Jiménez-Sánchez, Amelia","rank":1,"rolecode":"pau"},{"affn