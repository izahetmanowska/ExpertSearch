"],"pub":{"doi":"10.1038/s41525-017-0040-5","issn":["20567944"],"issue":"1","journal":"npj Genomic Medicine","pages":"1","paperid":"40","status":"p","title":"npj Genomic Medicine","volume":"3"},"review":"Peer Reviewed","scoID":["2-s2.0-85042219698"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-761fd979-7eec-40cb-8be9-e0a6d82132a3"],"src":["AU Aarhus University"],"title":"Pan-cancer screen for mutations in non-coding elements with conservation and cancer specificity reveals correlations with expression and survival","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-196807","year":"2018","yearsub":"2018"}
{"abstract":"The size premium has been accused of having a weak historical record, being meager relative to other factors, varying significantly over time, weakening after its discovery, being concentrated among microcap stocks, residing predominantly in January, relying on price-based measures, and being weak internationally. We find, however, that these challenges disappear when controlling for the quality, or its inverse, junk, of a firm. A significant size premium emerges, which is stable through time, robust to specification, not concentrated in microcaps, more consistent across seasons, and evident for non-price-based measures of size, and these results hold in 30 different industries and 24 international equity markets. The resurrected size effect is on par with anomalies such as value and momentum in terms of economic significance and gives rise to new tests of, and challenges for, existing asset pricing theories.","author_count":5,"contributors":["Asness, Clifford S.","Frazzini, Andrea","Israel, Ronen","Moskowitz, Tobias J.","Pedersen, Lasse Heje"],"cuid":["S01-000.00-285614"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","Europe, Non-EU","OECD"],"country":["United Kingdom","United States"],"glorg":["AQR Capital Management","All Global Affiliations","Centre for Economic Policy Research","NYU Stern School of Business","National Bureau of Economic Research","Yale University"],"keyword":["Factor models","Quality","Size premium"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"pr","rtype":["clu"],"sorti":"size matters if you control your junk","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.jfineco.2018.05.006","version":"Published Version"},"id":"S01-000.00-285614","identifier":[{"id":"85048563039","type":"scopus"}],"ids":["cbs-6a7686f7-4a41-49cf-bad6-204821d1083d"],"keyword":["Factor models","Quality","Size premium"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-4-2FE156A0017E75835D69A8DEBEF09032"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://research-api.cbs.dk/ws/files/57307999/lasse_heje_pedersen_et_al_size_matters_if_you_control_your_junk_publishersversion.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.jfineco.2018.05.006","version":"Published Version"}],"oai":{"class":"Realised","mra":["Social Science (SOC)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","country":"us","key":"aqr capital management","loc":["United States","America, North","OECD"],"name":"AQR Capital Management","used":1},{"affno":"2","country":"us","key":"yale university","loc":["United States","America, North","OECD"],"name":"Yale University","used":1},{"affno":"3","country":"us","key":"national bureau of economic research","loc":["United States","America, North","OECD"],"name":"National Bureau of Economic Research","used":1},{"affno":"4","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Finance"],"nora_code":"DI-U-CBS","used":1},{"affno":"5","country":"us","key":"nyu stern school of business","loc":["United States","America, North","OECD"],"name":"NYU Stern School of Business","used":1},{"affno":"6","country":"gb","key":"centre for economic policy research","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Centre for Economic Policy Research","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Cliffo