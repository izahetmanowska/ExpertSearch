ns","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["cbs-9cef71a9-adf5-4d83-925d-53c571dd0691"],"src":["CBS Copenhagen Business School"],"title":"Value and Momentum Everywhere","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-290354","year":"2013","yearsub":"2013"}
{"author_count":4,"contributors":["Frihed, Tobias","Bols, Mikael","Pedersen, Christian Marcus"],"cuid":["S01-000.00-417741"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"diethylsilane","src":["ku"],"src-code":["DI-U-KU"],"type":"dbp","type-grp":["all","pub"]},"id":"S01-000.00-417741","ids":["ku-28a9581b-2fba-41e0-b676-2fa29220ed5e"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-24B2AC5EC46A6F0766E4876B62B6E9BA"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Chemistry, Department of Chemistry"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Tobias","key":"frihedpau","last":"Frihed","locid":"0227f6b1-da49-463d-9c60-ae7a07fc1729","name":"Frihed, Tobias","orcid":"0000-0001-7647-1894","rank":1,"rolecode":"pau"},{"affno":"1","first":"Mikael","key":"bolspau","last":"Bols","locid":"23a8a20e-b9f1-4bf5-ae25-3377249ae440","name":"Bols, Mikael","orcid":"0000-0002-6561-6952","rank":2,"rolecode":"pau"},{"affno":"1","first":"Christian Marcus","key":"pedersenpau","last":"Pedersen","locid":"994945e4-c86b-4440-b9bd-8117822c77db","name":"Pedersen, Christian Marcus","orcid":"0000-0003-4661-4895","rank":3,"rolecode":"pau"},{"affno":"","first":"Philip L.","key":"fuchspedh","last":"Fuchs","name":"Fuchs, Philip L.","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1002/047084289x.rn01628","eisbn":["9780470842898"],"publisher":"Wiley","status":"p","title":"e-EROS Encyclopedia of Reagents for Organic Synthesis"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-28a9581b-2fba-41e0-b676-2fa29220ed5e"],"src":["KU University of Copenhagen"],"title":"Diethylsilane","type":"Book Preface, Encycl. Entry","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-417741","year":"2013","yearsub":"2013"}
{"abstract":"Running induces characteristic fluctuations in blood pressure (BP) of unknown consequence for organ blood flow. We hypothesized that running-induced BP oscillations are transferred to the cerebral vasculature. In 15 healthy volunteers, transcranial Doppler-determined middle cerebral artery (MCA) blood flow velocity, photoplethysmographic finger BP, and step frequency were measured continuously during three consecutive 5-min intervals of treadmill running at increasing running intensities. Data were analysed in the time and frequency domains. BP data for seven subjects and MCA velocity data for eight subjects, respectively, were excluded from analysis because of insufficient signal quality. Running increased mean arterial pressure and mean MCA velocity and induced rhythmic oscillations in BP and in MCA velocity corresponding to the difference between step rate and heart rate (HR) frequencies. During running, rhythmic oscillations in arterial BP induced by interference between HR and step frequency impact on cerebral blood velocity. For the exercise as a whole, average MCA velocity becomes elevated. These results suggest that running not only induces an increase in regional cerebral blood flow but also challenges cerebral autoregulation.","author_count":7,"contributors":["Lyngeraa, Tobias","Pedersen, Lars Møller","Mantoni, T","Belhage, Bo","Rasmussen, Lars S","van Lieshout, J J","Pott, Frank Christian"],"cuid":["S01-000.00-514865"],"filters":{"added":"2022-04","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"middle cerebral artery blood velocity during running","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1111/sms.12009","version":"Other Version"},"id":"S01-000.00-514865","identifier":[{"id":"84872348945","type":"scopus"}],"ids":["ku-cb596998-faf4-4512-97ad-b8d4d0749c36"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-A9569B53C1B7EA23242D0E3CDB17156A"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1111/sms.12009","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Tobias","key":"lyngeraapau","last":"Lyngeraa","name":"Lyngeraa, Tobias","rank":1,"rolecode":"pau"},{"affno":"","first":"Lars Møller","key":"pedersenpau","last":"Pedersen","locid":"e0b39d5a-e306-4f2d-af0c-0483ac71df9a","name":"Pedersen, Lars Møller","rank":2,"rolecode":"pau"},{"affno":"","first":"T","key":"mantonipau","last":"Mantoni","name":"Mantoni, T","rank":3,"rolecode":"pau"},{"affno":"","first":"B","key":"belhagepau","last":"Belhage","locid":"676d52c7-dae7-45a8-b3e1-38c94f066119","name":"Belhage, Bo","name_org":"Belhage, B","rank":4,"rolecode":"pau"},{"affno":"","first":"L S","key":"rasmussenpau","last":"Rasmussen","locid":"37e36b99-34dd-471f-b09b-d93e72940ec0","name":"Rasmussen, Lars S","name_org":"Rasmussen, L S","rank":5,"rolecode":"pau"},{"affno":"","first":"J J","key":"vanlieshoutpau","last":"van Lieshout","name":"van Lieshout, J J","rank":6,"rolecode":"pau"},{"affno":"1","first":"F C","key":"pottpau","last":"Pott","locid":"756169aa-ac71-4ec5-a7da-342aa8db9d48","name":"Pott, Frank Christian","name_org":"Pott, F C","rank":7,"rolecode":"pau"}],"pub":{"doi":"10.1111/sms.12009","issn":["09057188","16000838"],"issn_org":["09057188"],"issue":"1","journal":"Scandinavian Journal of Medicine & Science in Sports","status":"p","title":"Scandinavian Journal of Medicine & Science in Sports","volume":"23"},"review":"Peer Reviewed","scoID":["2-s2.0-84872348945"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-cb596998-faf4-4512-97ad-b8d4d0749c36"],"src":["KU University of Copenhagen"],"title":"Middle cerebral artery blood velocity during running","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-514865","year":"2013","yearsub":"2013"}
{"abstract":"We have recently reported broadband (450–850 nm) and efficient (96% on average) light absorption on gold surfaces with arrays of ultra-sharp convex grooves via excitation and subsequent adiabatic nanofocusing and absorption of gap surface plasmon modes (Søndergaard et al 2012 Nature Commun. 3 969). Here, we significantly extend our spectroscopy investigations of one- and two-dimensional (1D and 2D) groove arrays in gold covering the wavelength range of 500–1700 nm and report first results on broadband light absorption by 1D groove arrays in nickel. For 1D groove arrays (periods 250 and 350 nm, groove depth 450 nm) in gold, the experimental characterization as well as numerical simulations based on the surface integral equation method reveal gradually increasing reflectivity for wavelengths above ~650 nm reaching finally ~60% at 1700 nm, but with a remarkable dip around 1150–1250 nm featuring only ~10% reflectivity. Results indicate that the dip position can be adjusted with the precise groove geometry, a feature that could prove particularly useful for selective thermal emitters in thermophotovoltaics. Furthermore, investigations of field enhancement at the groove bottoms of 1D groove arrays in gold, mapped via diffraction-limited two-photon photoluminescence (TPL) scanning microscopy, reveal very selective polarization properties of excitation and TPL emission from the groove bottoms. 1D groove arrays in nickel were fabricated by making parallel 300 nm periodic adiabatic grooves of depths 100, 200, 300, 400 or 500 nm in a 600 nm thick nickel film. Their experimental characterization verifies that the structures are indeed very dark, exhibiting only 5–8% reflectivity over an entire wavelength range 400–1700 nm for the deepest grooves, which is in good correspondence with simulations.","author_count":5,"contributors":["Beermann, Jonas","Eriksen, René L.","Søndergaard, Thomas","Stær, Tobias Holmgaard","Pedersen, Kjeld","Bozhevolnyi, Sergey"],"cuid":["S02-095.92-006886"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-AAU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"plasmonic black metals by broadband light absorption in ultra sharp convex grooves","src":["aau","sdu"],"src-code":["DI-U-AAU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1088/1367-2630/15/7/073007","version":"Published Version"},"id":"S02-095.92-006886","identifier":[{"id":"WOS:000321292200007","type":"wos"},{"id":"84880442292","type":"scopus"}],"ids":["aau-8e0a6dfd-629a-40d8-96a1-f7229a0e1d7e","sdu-0c4e65b6-9586-4cc1-b9b3-820d1cdc0ea4"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-797E2293FD75D9A0BA0835A52C675837"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/144199100/Beermann_2013_New_J._Phys._15_073007.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1088/1367-2630/15/7/073007","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Engineering, Department of Technology and Innovation"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (ENG)","Aalborg University, The Faculty of Engineering and Science, Department of Physics and Nanotechnology"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jonas","key":"beermannpau","last":"Beermann","locid":"da4d107b-a5da-429d-ba3b-850b08b96322","name":"Beermann, Jonas","orcid":"0000-0001-9809-2430","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Thomas","key":"søndergaardpau","last":"Søndergaard","locid":"b4ea9ec0-4c28-4984-94e9-8d0848a0a7a1","name":"Søndergaard, Thomas","orcid":"0000-0002-5115-0450","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Tobias Holmgaard","key":"stærpau","last":"Stær","locid":"f9c73bfe-cf15-440a-9aca-290bb9e2f2a5","name":"Stær, Tobias Holmgaard","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Kjeld","key":"pedersenpau","last":"Pedersen","locid":"ff5fc0ab-1fa1-47a2-916c-8b7556f2f938","name":"Pedersen, Kjeld","orcid":"0000-0002-6835-1566","rank":5,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Sergey","key":"bozhevolnyipau","last":"Bozhevolnyi","locid":"73cbbeed-4f7a-4897-9cb6-cb89b69c9d18","name":"Bozhevolnyi, Sergey","orcid":"0000-0002-0393-4859","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1088/1367-2630/15/7/073007","issn":["13672630"],"issue":"1","journal":"New Journal of Physics","paperid":"073007","publisher":"Institute of Physics","status":"p","title":"New Journal of Physics","volume":"15"},"review":"Peer Reviewed","scoID":["2-s2.0-84880442292"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-8e0a6dfd-629a-40d8-96a1-f7229a0e1d7e","sdu-0c4e65b6-9586-4cc1-b9b3-820d1cdc0ea4"],"src":["AAU Aalborg University","SDU University of Southern Denmark"],"title":"Plasmonic black metals by broadband light absorption in ultra-sharp convex grooves","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-095.92-006886","year":"2013","yearsub":"2013"}
{"abstract":"A security's expected return can be decomposed into its \"carry\" and its expected price appreciation, where carry can be measured in advance without an asset pricing model. We find that carry predicts returns both in the cross section and time series for a variety of different asset classes that include global equities, global bonds, currencies, commodities, US Treasuries, credit, and equity index options. This predictability underlies the strong returns to \"carry trades\" that go long high-carry and short low-carry securities, applied almost exclusively to currencies, but shown here to be a robust feature of many assets. We decompose carry returns into static and dynamic components and analyze the economic exposures. Despite unconditionally low correlations across asset classes, we find times when carry strategies across all asset classes do poorly, and show that these episodes coincide with global recessions.","author_count":4,"contributors":["Koijen, Ralph S.J.","Moskowitz, Tobias J.","Pedersen, Lasse Heje","Vrugt, Evert B."],"cuid":["S01-000.00-295003"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","Europe, Non-EU","OECD"],"country":["United Kingdom","United States"],"glorg":["All Global Affiliations","London Business School","University of Chicago"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"nr","rtype":["clu"],"sorti":"carry","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dw","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"doi","url":"https://doi.org/10.3386/w19325","version":"Published Version"},"id":"S01-000.00-295003","ids":["cbs-ce17e19a-dcbe-430d-a3c2-22c45ba17033"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-2-4E2CF0537B6E473A3FE957283B8DAE8C"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"doi","url":"https://doi.org/10.3386/w19325","version":"Published Version"}],"org":[{"affno":"1","country":"gb","key":"london business school","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"London Business School","used":1},{"affno":"2","country":"us","key":"university of chicago","loc":["United States","America, North","OECD"],"name":"University of Chicago","used":1},{"affno":"3","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Finance"],"nora_code":"DI-U-CBS","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Ralph S.J.","key":"koijenpau","last":"Koijen","name":"Koijen, Ralph S.J.","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Tobias J.","key":"moskowitzpau","last":"Moskowitz","name":"Moskowitz, Tobias J.","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Lasse","key":"hejepedersenpau","last":"Heje Pedersen","locid":"cb7f3ab8-aada-4653-8366-cd5a05f54f56","name":"Pedersen, Lasse Heje","name_org":"Heje Pedersen, Lasse","orcid":"0000-0001-7126-5530","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Evert B.","key":"vrugtpau","last":"Vrugt","name":"Vrugt, Evert B.","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.3386/w19325","issn":["08982937"],"issue":"19325","pages":"63","place":"Cambridge, MA","publisher":"National Bureau of Economic Research (NBER)","series":"National Bureau of Economic Research. Working Paper Series","status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["cbs-ce17e19a-dcbe-430d-a3c2-22c45ba17033"],"src":["CBS Copenhagen Business School"],"title":"Carry","type":"Working Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-295003","year":"2013","yearsub":"2014"}
{"abstract":"Monopterus albus, a swamp eel inhabiting the freshwaters of South East Asia, relies on an extensive vascularisation of the buccal cavity, pharynx and anterior oesophagus for gas exchange, while the gills are much reduced. In the present study we describe the macro-circulation in the cephalic region and the vascularisation of the buccal cavity of M. albus using vascular fillings and micro-computed tomography (μCT). We also show that M. albus has the capacity to use the buccal cavity for aquatic gas exchange, being able to maintain normal arterial blood gas composition, blood pressure, heart rate and cardiac output throughout 10h of forced submergence. M. albus therefore can be characterised as a facultative air-breather. Because M. albus aestivates for many months in moist mud during the dry season we characterised in vivo cardiovascular function during exposure to anoxia as well as the effects of anoxia on in vitro contractility of strip preparations from atria and ventricle. Both studies revealed a low anoxia tolerance, rendering it unlikely that M. albus can survive prolonged exposure to anoxia.","author_count":9,"contributors":["Iversen, Nina Kerting","Lauridsen, Henrik","Huong, Do Thi Thanh","Cong, Nguyen van","Gesser, Hans","Buchanan, Rasmus","Bayley, Mark","Pedersen, Michael","Wang, Tobias"],"cuid":["S01-000.00-222970"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"cardiovascular anatomy and cardiac function in the air breathing swamp eel monopterus albus","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.cbpa.2012.08.007","version":"Other Version"},"id":"S01-000.00-222970","identifier":[{"id":"84870248339","type":"scopus"},{"id":"22944727","type":"pmid"}],"ids":["au-a45c30da-30d3-4032-bfba-22fab01edaca"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-11E8AD1BAC9132F515FBCB2AD2ABD42D"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.cbpa.2012.08.007","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Center of Functionally Integrative Neuroscience"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Nina K","key":"iversenpau","last":"Iversen","locid":"0acbfc14-21fe-4ffb-9a0c-071197e83085","name":"Iversen, Nina Kerting","name_org":"Iversen, Nina K","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik","key":"lauridsenpau","last":"Lauridsen","locid":"e9b42d0f-74e8-4835-92a3-18ce72bfafa6","name":"Lauridsen, Henrik","orcid":"0000-0002-8833-4456","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Do Thi Thanh","key":"huongpau","last":"Huong","name":"Huong, Do Thi Thanh","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Nguyen","key":"vancongpau","last":"Van Cong","locid":"47422d9f-0998-431f-b12c-922381c06292","name":"Cong, Nguyen van","name_org":"Van Cong, Nguyen","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hans","key":"gesserpau","last":"Gesser","locid":"34483d4c-002d-4e42-a763-834de8f47263","name":"Gesser, Hans","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rasmus","key":"buchananpau","last":"Buchanan","locid":"01867254-1a3