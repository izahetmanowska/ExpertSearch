{"abstract":"Gold surfaces with periodic arrays of ultra-sharp grooves fabricated by FIB-milling turn black due to coupling of incident light into gap-Surface-Plasmon-Polariton waves that experience adiabatic nanofocusing and efficient absorption in the grooves.","author_count":7,"contributors":["Søndergaard, Thomas","Novikov, Sergey M.","Stær, Tobias Holmgaard","Eriksen, René L.","Beermann, Jonas","Pedersen, Kjeld","Bozhevolnyi, Sergey I."],"cuid":["S01-000.00-063575"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Institute of Technology and Innovation (ITI)"],"U":["DI-U-AAU","DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-AAU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"plasmonic black gold and black metals","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://www.osapublishing.org/abstract.cfm?uri=PV-2012-JM5A.18","version":"Other Version"},"id":"S01-000.00-063575","ids":["aau-2e9c95b1-a0dd-4784-bcf1-be1bdd9a7646"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-6-7-3A45CB5D2D1E0142C9C77C22874BA205"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.osapublishing.org/abstract.cfm?uri=PV-2012-JM5A.18","version":"Other Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (ENG)","Aalborg University, The Faculty of Engineering and Science, Department of Physics and Nanotechnology"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscel