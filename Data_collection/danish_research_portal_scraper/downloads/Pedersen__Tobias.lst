391-40e6-a73a-84194aecbb6a","name":"Wimmer, Reinhard","orcid":"0000-0001-6942-5056","rank":10,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Donald Max","key":"gardinerdonaldmaxpau","last":"Gardiner","name":"Gardiner, Donald Max","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens Laurids","key":"sørensenjenslauridspau","last":"Sørensen","locid":"365188dd-0cdc-4c71-a590-2ccd261ae3df","name":"Sørensen, Jens Laurids","orcid":"0000-0002-2392-5343","rank":12,"rolecode":"pau"}],"pmid":["35012550"],"pub":{"doi":"10.1186/s12934-021-01734-9","issn":["14752859"],"issue":"1","journal":"Microbial Cell Factories","paperid":"9","publisher":"BioMed Central","status":"p","title":"Microbial Cell Factories","volume":"21"},"review":"Peer Reviewed","scoID":["2-s2.0-85122758762"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-25ab94d8-79d5-4ebf-8b2d-65ad9a9485ba"],"src":["AAU Aalborg University"],"title":"Speed dating for enzymes! Finding the perfect phosphopantetheinyl transferase partner for your polyketide synthase","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-060990","year":"2022","yearsub":"2022"}
{"abstract":"PURPOSE: Hyperpolarized 13C MRI is a powerful technique to study dynamic metabolic processes in vivo; but it has predominantly been used in mammals, mostly humans, pigs, and rodents. METHODS: In the present study, we use this technique to characterize the metabolic fate of hyperpolarized [1- 13C]pyruvate in Burmese pythons (Python bivittatus), a large species of constricting snake that exhibits a four- to tenfold rise in metabolism and large growth of the visceral organs within 24-48 h of ingestion of their large meals. RESULTS: We demonstrate a fivefold elevation of the whole-body lactate-to-pyruvate ratio in digesting snakes, pointing to a large rise in lactate production from pyruvate. Consistent with the well-known metabolic stimulation of digestion, measurements of mitochondrial respiration in hepatocytes in vitro indicate a marked postprandial upregulation of mitochondrial respiration. We observed that a low SNR of the hyperpolarized 13C produced metabolites in the python, and this lack of signal was possibly due to the low metabolism of reptiles compared with mammals, preventing quantification of alanine and bicarbonate production with the experimental setup used in this study. Spatial quantification of the [1- 13C]lactate was only possible in postprandial snakes (with high metabolism), where a statistically significant difference between the heart and liver was observed. CONCLUSION: We confirm the large postprandial rise in the wet mass of most visceral organs, except for the heart, and demonstrated that it is possible to image the [1- 13C]pyruvate uptake and intracellular conversion to [1- 13C]lactate in ectothermic animals.","author_count":7,"contributors":["Hansen, Kasper","Søvsø Szocska Hansen, Esben","Jespersen, Nichlas Riise","Bøtker, Hans Erik","Pedersen, Michael","Wang, Tobias","Laustsen, Christoffer"],"cuid":["S01-000.00-150288"],"filters":{"added":"2022-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Laustsen, Christoffer"],"keyword":["1 C pyruvate","MRI","Metabolism","Postprandial","Python","Reptile"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"hyperpolarized sup 000000000013 sup c mri reveals large changes in pyruvate metabolism during digestion in snakes","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1002/mrm.29239","version":"Published Version"},"id":"S01-000.00-150288","identifier":[{"id":"35426467","type":"pmid"},{"id":"PMC9321735","type":"pmcid"},{"id":"85129035570","type":"scopus"}],"ids":["au-24834398-9335-475c-91d8-c4fac9c22cce"],"keyword":["MRI","[1- C]pyruvate","metabolism","postprandial","python","reptile"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-380646009F21C2A68F10DAB61D3E3B8B"],"oa_link":[{"access":"oa","license":"CC BY","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC9321735/pdf/MRM-88-890.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1002/mrm.29239","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Comparative Medicine Lab","Aarhus University, Health, Department of Forensic Medicine, Department of Forensic Medicine - Department of Forensic Medicine - Forensic Pathology","Aarhus University, Natural Sciences, Department of Biology, Department of Biology - Zoophysiology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Kasper","key":"hansenkasperpau","last":"Hansen","locid":"38a9d794-f230-4f50-9327-a06057880fff","name":"Hansen, Kasper","orcid":"0000-0002-8669-8897","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Esben Søvsø S","key":"søvsøszocskahansenesbenpau","last":"Hansen","locid":"2ea5821e-bbda-4f7e-a18a-0b9eb3b993f0","name":"Søvsø Szocska Hansen, Esben","name_org":"Hansen, Esben Søvsø S","orcid":"0000-0001-5512-9870","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Nichlas Riise V","key":"jespersennichlasriisepau","last":"Jespersen","locid":"dc7856f9-39e7-497a-a291-eab166abe2ef","name":"Jespersen, Nichlas Riise","name_org":"Jespersen, Nichlas Riise V","orcid":"0000-0003-2502-2102","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Hans Erik","key":"bøtkerhanserikpau","last":"Bøtker","locid":"09b03c00-11a8-4f72-800f-181f26155750","name":"Bøtker, Hans Erik","orcid":"0000-0001-6358-8962","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Michael","key":"pedersenmichaelpau","last":"Pedersen","locid":"871199c4-33bb-4fac-95ef-9a2266f30695","name":"Pedersen, Michael","orcid":"0000-0002-1146-0382","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Tobias","key":"wangtobiaspau","last":"Wang","locid":"7a3d91ab-5dbf-46e4-bc6e-634e16bd8d80","name":"Wang, Tobias","orcid":"0000-0002-4350-3682","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Christoffer","key":"laustsenchristofferpau","last":"Laustsen","locid":"ba5f7084-cbbb-4c1a-9fb6-85cce410d52a","name":"Laustsen, Christoffer","orcid":"0000-0002-0317-2911","rank":7,"rolecode":"pau"}],"pmid":["35426467"],"pub":{"doi":"10.1002/mrm.29239","issn":["07403194","15222594"],"issn_org":["07403194"],"issue":"2","journal":"Magnetic Resonance in Medicine","pages":"890-900","publisher":"John Wiley & Sons Inc.","status":"p","title":"Magnetic Resonance in Medicine","volume":"88"},"review":"Peer Reviewed","scoID":["2-s2.0-85129035570"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-24834398-9335-475c-91d8-c4fac9c22cce"],"src":["AU Aarhus University"],"title":"Hyperpolarized <sup>13</sup>C MRI Reveals Large Changes in Pyruvate Metabolism During Digestion in Snakes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-150288","year":"2022","yearsub":"2022"}
{"abstract":"The SARS coronavirus 2 (SARS-CoV-2) spike protein is located at the outermost perimeter of the viral envelope and is the first component of the virus to make contact with surrounding interfaces. The stability of the spike protein when in contact with surfaces plays a deciding role for infection pathways and for the viability of the virus after surface contact. While cryo-EM structures of the spike protein have been solved with high resolution and structural studies in solution have provided information about the secondary and tertiary structures, only little is known about the folding when adsorbed to surfaces. We here report on the secondary structure and orientation of the S1 segment of the spike protein, which is often used as a model protein for in vitro studies of SARS-CoV-2, at the air-water interface using surface-sensitive vibrational sum-frequency generation (SFG) spectroscopy. The air-water interface plays an important role for SARS-CoV-2 when suspended in aerosol droplets, and it serves as a model system for hydrophobic surfaces in general. The SFG experiments show that the S1 segment of the spike protein remains folded at the air-water interface and predominantly binds in its monomeric state, while the combination of small-angle X-ray scattering and two-dimensional infrared spectroscopy measurements indicate that it forms hexamers with the same secondary structure in aqueous solution.","author_count":7,"contributors":["Bregnhøj, Mikkel","Roeters, Steven J.","Chatterley, Adam S.","Madzharova, Fani","Mertig, Rolf","Pedersen, Jan Skov","Weidner, Tobias"],"cuid":["S01-000.00-189697"],"filters":{"added":"2022-08","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Roeters, Steven J.","Weidner, Tobias"],"keyword":["Conformation","Covid 19","Humans","Packing","Peptides","SARS CoV 2","Spectroscopy","Sum frequency generation","Water chemistry"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"structure and orientation of the sars coronavirus 000000000002 spike protein at air water interfaces","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85130001048","version":"Other Version"},"id":"S01-000.00-189697","identifier":[{"id":"PMC9063992","type":"pmcid"},{"id":"000804913800005","type":"wos"},{"id":"85130001048","type":"scopus"},{"id":"35477296","type":"pmid"}],"ids":["au-69baa441-fceb-4910-846e-c6d98e17c83f"],"keyword":["CONFORMATION","COVID-19","Humans","PACKING","PEPTIDES","SARS-CoV-2","SPECTROSCOPY","SUM-FREQUENCY GENERATION","Spike Glycoprotein, Coronavirus/chemistry","Water/chemistry"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-7953F576C936BBE9DE47815E9FCA231C"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Chemistry"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Mikkel","key":"bregnhøjpau","last":"Bregnhøj","locid":"60be394a-4fb2-4545-b2cc-42bc556a2abf","name":"Bregnhøj, Mikkel","orcid":"0000-0001-5748-6783","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Steven J.","key":"roeterspau","last":"Roeters","locid":"c76b17db-0e9b-4988-b0e9-81012389655b","name":"Roeters, Steven J.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Adam S.","key":"chatterleypau","last":"Chatterley","locid":"12178be4-29c5-4083-b7c7-2fd44e967328","name":"Chatterley, Adam S.","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Fani","key":"madzharovapau","last":"Madzharova","locid":"6e91d4c5-6e1b-46af-ad7d-af2225aa2460","name":"Madzharova, Fani","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rolf","key":"mertigpau","last":"Mertig","locid":"b0704cf4-69ef-4644-b05d-0f8d9fc68cd3","name":"Mertig, Rolf","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jan Skov","key":"pedersenpau","last":"Pedersen","locid":"8cb5e42a-3881-479c-82a5-232355605d7e","name":"Pedersen, Jan Skov","orcid":"0000-0002-7768-0206","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Tobias","key":"weidnerpau","last":"Weidner","locid":"7a001432-fe35-4c21-b32c-40a65e060b03","name":"Weidner, Tobias","orcid":"0000-0002-7083-7004","rank":7,"rolecode":"pau"}],"pmid":["35477296"],"pub":{"doi":"10.1021/acs.jpcb.2c01272","issn":["15205207","15206106"],"issn_org":["15206106"],"issue":"18","journal":"Journal of Physical Chemistry Part B: Condensed Matter, Materials, Surfaces, Interfaces & Biophysical","pages":"3425-3430","publisher":"American Chemical Society","status":"p","title":"Journal of Physical Chemistry Part B: Condensed Matter, Materials, Surfaces, Interfaces & Biophysical","title_org":"Journal of Physical Chemistry B","volume":"126"},"review":"Peer Reviewed","scoID":["2-s2.0-85130001048"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-69baa441-fceb-4910-846e-c6d98e17c83f"],"src":["AU Aarhus University"],"title":"Structure and Orientation of the SARS-Coronavirus-2 Spike Protein at Air-Water Interfaces","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-189697","year":"2022","yearsub":"2022"}
{"abstract":"We show how and why to use a financially meaningful differential regularization method when pricing options by Monte Carlo simulation, be that in polynomial regression or neural network context.","author_count":3,"contributors":["Frandsen, Magnus Grønnegaard","Pedersen, Tobias Cramer","Poulsen, Rolf"],"cuid":["S01-000.00-504309"],"filters":{"added":"2022-08","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"delta force option pricing with differential machine learning","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-504309","identifier":[{"id":"85194433149","type":"scopus"}],"ids":["ku-b9c030e8-694a-4dd8-bafc-4cb412e09bd8"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-6753494AF485834C9432F2BB65142BF3"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Mathematical Sciences"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Magnus Grønnegaard","key":"frandsenpau","last":"Frandsen","locid":"72907340-8b68-41f0-8ee3-c70049df1ab4","name":"Frandsen, Magnus Grønnegaard","rank":1,"rolecode":"pau"},{"affno":"1","first":"Tobias Cramer","key":"pedersenpau","last":"Pedersen","locid":"188a1b8c-5c3c-4829-8a01-f8c86ad0f716","name":"Pedersen, Tobias Cramer","rank":2,"rolecode":"pau"},{"affno":"1","first":"Rolf","key":"poulsenpau","last":"Poulsen","locid":"2d0d95ad-955e-48e3-98a0-9e012548f952","name":"Poulsen, Rolf","orcid":"0000-0001-8242-0954","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1007/s42521-021-00041-7","issn":["25246186"],"journal":"Digital Finance","pages":"1-15","status":"p","title":"Digital Finance","volume":"4"},"review":"Peer Reviewed","scoID":["2-s2.0-85194433149"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-b9c030e8-694a-4dd8-bafc-4cb412e09bd8"],"src":["KU University of Copenhagen"],"title":"Delta Force : Option Pricing with Differential Machine Learning","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-504309","year":"2022","yearsub":"2022"}
{"abstract":"A quantum key distribution (QKD) system must fulfill the requirement of universal composability to ensure that any cryptographic application (using the QKD system) is also secure. Furthermore, the theoretical proof responsible for security analysis and key generation should cater to the number N of the distributed quantum states being finite in practice. Continuous-variable (CV) QKD based on coherent states, despite being a suitable candidate for integration in the telecom infrastructure, has so far been unable to demonstrate composability as existing proofs require a rather large N for successful key generation. Here we report a Gaussian-modulated coherent state CVQKD system that is able to overcome these challenges and can generate composable keys secure against collective attacks with N ≈ 2 × 108 coherent states. With this advance, possible due to improvements to the security proof and a fast, yet low-noise and highly stable system operation, CVQKD implementations take a significant step towards their discrete-variable counterparts in practicality, performance, and security.","author_count":13,"contributors":["Jain, Nitin","Chin, Hou Man","Mani, Hossein","Lupo, Cosmo","Nikolic, Dino Solar","Kordts, Arne","Pirandola, Stefano","Pedersen, Thomas Brochmann","Kolb, Matthias","Ömer, Bernhard","Pacher, Christoph","Gehring, Tobias","Andersen, Ulrik Lund"],"cuid":["S01-000.00-677242"],"filters":{"added":"2023-07","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","OECD"],"corresponding_author":["Andersen, Ulrik Lund","Gehring, Tobias","Jain, Nitin"],"country":["Austria","United Kingdom"],"glorg":["All Global Affiliations","Austrian Institute of Technology","University of Sheffield","University of York"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"practical continuous variable quantum key distribution with composable security","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1038/s41467-022-32161-y","version":"Published Version"},"funding_acknowledgement":["We thank Marco Tomamichel for discussions regarding the security analysis. The work presented in this paper has been supported by the European Union’s Horizon 2020 research and innovation programmes CiViQ (grant agreement no. 820466, concerned authors: N.J., H.M.C., H.M., D.S.N., A.K., S.P., B.O., C.P., T.G., and U.L.A.) and OPENQKD (grant agreement no. 857156, concerned authors: N.J., H.M.C., H.M., B.O., C.P., T.G., and U.L.A.). We also acknowledge support from the Innovation Fund Denmark (CryptQ, 0175-00018A, concerned authors: NJ, HMC, HM, TBP, TG, and ULA) and the Danish National Research Foundation (bigQ, DNRF142, concerned authors: N.J., H.M.C., H.M., D.S.N., T.G., and U.L.A.). C.L. and S.P. acknowledges funding from the EPSRC Quantum Communications Hub, Grant No. P/M013472/1 and EP/T001011/1."],"id":"S01-000.00-677242","identifier":[{"id":"PMC9374721","type":"pmcid"},{"id":"85135823340","type":"scopus"},{"id":"35961965","type":"pmid"}],"ids":["dtu-efeb6b88-4eaa-42a7-82eb-ab9c2295db8d"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-593682944DA39EE20A395C42CE63DF37"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/326014610/s41467_022_32161_y_2_.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1038/s41467-022-32161-y","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Physics","Technical University of Denmark, Department of Physics, Quantum Physics and Information Technology"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"gb","key":"university of sheffield","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Sheffield","used":1},{"affno":"3","country":"gb","key":"university of york","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of York","used":1},{"affno":"4","country":"at","key":"austrian institute of technology","loc":["Austria","Europe, EU","OECD"],"name":"Austrian Institute of Technology","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Nitin","key":"jainpau","last":"Jain","locid":"ecee62c2-2217-4deb-8d85-8b281db89a9c","name":"Jain, Nitin","orcid":"0000-0001-8555-1773","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Hou Man","key":"chinpau","last":"Chin","locid":"18cfc84b-be6a-4d21-adb3-b1667fd818f1","name":"Chin, Hou Man","orcid":"0000-0002-2488-9305","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Hossein","key":"manipau","last":"Mani","locid":"dc79503e-a2fc-4828-8ae6-9f23d6ca8d5b","name":"Mani, Hossein","orcid":"0000-0002-0408-9458","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Cosmo","key":"lupopau","last":"Lupo","name":"Lupo, Cosmo","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Dino Solar","key":"nikolicpau","last":"Nikolic","locid":"88c57926-8459-42b8-b3d9-2f6e189dac90","name":"Nikolic, Dino Solar","orcid":"0000-0003-1653-4018","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Arne","key":"kordtspau","last":"Kordts","locid":"550438fd-b272-4a79-8249-d4b0dcb4fba2","name":"Kordts, Arne","orcid":"0000-0001-5826-2319","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Stefano","key":"pirandolapau","last":"Pirandola","name":"Pirandola, Stefano","rank":7,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Thomas Brochmann","key":"pedersenpau","last":"Pedersen","name":"Pedersen, Thomas Brochmann","rank":8,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Matthias","key":"kolbpau","last":"Kolb","name":"Kolb, Matthias","rank":9,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Bernhard","key":"ömerpau","last":"Ömer","name":"Ömer, Bernhard","rank":10,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Christoph","key":"pacherpau","last":"Pacher","name":"Pacher, Christoph","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Tobias","key":"gehringpau","last":"Gehring","locid":"9d770890-d39e-4a90-b4bf-345098e747c9","name":"Gehring, Tobias","orcid":"0000-0002-4311-2593","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ulrik L.","key":"andersenpau","last":"Andersen","locid":"d1c6f584-4c31-410d-8879-7669229593fb","name":"Andersen, Ulrik Lund","name_org":"Andersen, Ulrik L.","orcid":"0000-0002-1990-7687","rank":13,"rolecode":"pau"}],"pmid":["35961965"],"pub":{"doi":"10.1038/s41467-022-32161-y","issn":["20411723"],"issue":"1","journal":"Nature Communications","paperid":"4740","publisher":"Nature Research","status":"p","title":"Nature Communications","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-85135823340"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-efeb6b88-4eaa-42a7-82eb-ab9c2295db8d"],"src":["DTU Technical University of Denmark"],"title":"Practical continuous-variable quantum key distribution with composable security","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-677242","year":"2022","yearsub":"2022"}
{"abstract":"INTRODUCTION. Thyroid nodules are very common and constitute an increasing clinical challenge since improved imaging capabilities and utilisation have led to a higher number of incidental findings. Ultrasound-guided fine-needle aspiration biopsy (FNAB) is the standard diagnostic tool in the work-up of thyroid nodules suspected of malignancy. Non-diagnostic results remain common and require repeated FNAB, leading to increased costs and delayed treatment of thyroid diseases, including treatment of thyroid cancer. If cytological diagnoses cannot be achieved, surgery may be warranted, which may potentially lead to overtreatment. Optimisation of the FNAB procedure is therefore essential. Spinal needles with a stylet have been found to lead to fewer non-diagnostic results, but studies on the subject are few. METHODS. This is a multicentre, two-arm, randomised clinical trial. Adults with thyroid nodules suspected of malignancy will be included consecutively. A total of 350 patients will be assigned randomly 1:1 to have a FNAB with either a spinal (25G) or a conventional (25G) needle. The primary outcome is the rate of diagnostic cytological samples according to the Bethesda system. Secondary outcomes are patient-experienced pain, complication rate and sensitivity and specificity. CONCLUSIONS. This trial will explore whether FNAB from thyroid nodules employing spinal needles compared with conventional fine needles improves diagnostic results, thereby providing evidence-based recommendations for a future choice of the FNAB needle. Secondary outcomes are patient-experienced pain, complication rate and sensitivity and specificity. FUNDING.This trial received funding from Erik & Susanna Olesens Fond. The funding source had no influence on trial design, data collection, analysis or publication. TRIAL REGISTRATION.ClinicalTrials.gov Identifier: NCT04879355. Registration date: 07032021; version: 29062022.","author_count":16,"contributors":["Andersen, Tobias Vennervald","Bennedbæk, Finn Noe","Pedersen, Jens","Rosenørn, Marie Rosland","Kiss, Katalin","Lelkaitis, Giedrius","Andersen, Luise","Hegedüs, Laszlo","Lomholt, Anne Fog","Hahn, Christoffer Holst","Hvilsom, Gitte Bjørn","Homøe, Preben","Todsen, Tobias"],"cuid":["S02-096.40-045872"],"filters":{"added":"2022-09","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Vennervald Andersen, Tobias"],"keyword":["Management"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-SDR","DI-HO-ZEA"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-SDR","DI-HO-ZEA","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"spinal versus conventional fine needle for ultrasound guided thyroid nodule biopsy a protocol for a randomised clinical trial","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/205423123/a03220165_web.pdf","version":"Published Version"},"id":"S02-096.40-045872","identifier":[{"id":"85136343241","type":"scopus"},{"id":"000838173600001","type":"wos"}],"ids":["ku-c00ef608-3ec8-4e84-ba67-b64caadb16f8","sdu-94576bbe-3a3f-4e9a-971b-7d5f64a209cc"],"keyword":["ASPIRATION-CYTOLOGY","MANAGEMENT"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-A06E83FC951DBE7442FF72CD46712717"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://curis.ku.dk/ws/files/325707574/a03220165_web.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/205423123/a03220165_web.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"rem","url":"https://ugeskriftet.dk/dmj/spinal-versus-conventional-fine-needle-ultrasound-guided-thyroid-nodule-biopsy-protocol-randomised","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Zealand University Hospital - Køge"],"nora_code":"DI-HO-ZEA","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal Medicine: Endocrinology"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Herlev Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"4","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Endocrinology (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"5","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Den