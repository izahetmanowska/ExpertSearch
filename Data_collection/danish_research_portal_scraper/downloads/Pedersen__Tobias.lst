Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal Medicine: Respiratory Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"8","country":"in","key":"all india institute of medical sciences","loc":["India","Asia, South"],"name":"All India Institute of Medical Sciences","used":1},{"affno":"9","country":"in","key":"hindusthan hospital","loc":["India","Asia, South"],"name":"Hindusthan Hospital","used":1},{"affno":"10","country":"za","key":"george regional hospital","loc":["South Africa","Africa"],"name":"George Regional Hospital","used":1},{"affno":"11","country":"de","key":"hannover medical school","loc":["Germany","Europe, EU","OECD"],"name":"Hannover Medical School","used":1},{"affno":"12","country":"ar","key":"sanatorio modelo de quilmes","loc":["Argentina","America, South"],"name":"Sanatorio Modelo de Quilmes","used":1},{"affno":"13","country":"ch","key":"novartis","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"Novartis","used":1},{"affno":"14","country":"br","key":"hospital do servidor público estadual francisco morato de oliveira","loc":["Brazil","America, South"],"name":"Hospital do Servidor Público Estadual Francisco Morato de Oliveira","used":1},{"affno":15,"key":"study group","name":"Study group","role":"oau"}],"person":[{"affno":"1","first":"Ildiko","key":"madurkapau","last":"Madurka","name":"Madurka, Ildiko","rank":1,"rolecode":"pau"},{"affno":"2","first":"Alexander","key":"vishnevskypau","last":"Vishnevsky","name":"Vishnevsky, Alexander","rank":2,"rolecode":"pau"},{"affno":"3","first":"Joan B.","key":"sorianopau","last":"Soriano","name":"Soriano, Joan B.","rank":3,"rolecode":"pau"},{"affno":"4","first":"Stephanus J.","key":"ganspau","last":"Gans","name":"Gans, Stephanus J.","rank":4,"rolecode":"pau"},{"affno":"5","first":"Danilo Joel Salazar","key":"orepau","last":"Ore","name":"Ore, Danilo Joel Sala