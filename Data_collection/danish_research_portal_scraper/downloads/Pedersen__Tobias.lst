a0-1d06b194f9d4"],"src":["SDU University of Southern Denmark"],"title":"Diabetes is an independent risk factor for peripheral vascular disease but does not influence risk when coronary artery disease is verified among patients undergoing CAG - a nationwide study","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-587327","year":"2013","yearsub":"2013"}
{"abstract":"It has recently been demonstrated that adiabatic nanofocusing of light by gap-plasmon modes in ultra-sharp convex metal grooves can turn metallic surfaces with high reflectivity in the visible and near-infrared into excellent absorbers of light polarized perpendicular to the groove direction. Here we demonstrate that this effect can be used to design broadband linear polarizers, operating in reflection and inducing negligible dispersive stretching of ultra-short (5-10 fs) laser pulses.","author_count":13,"contributors":["Skovsen, E.","Søndergaard, T.","Lemke, C.","Holmgaard, T.","Leißner, Till","Eriksen, René Lynge","Beermann, Jonas","Bauer, Michael","Pedersen, K.","Bozhevolnyi, Sergey I.","Søndergaard, Thomas"],"cuid":["S02-095.24-008202"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD"],"corresponding_author":["Skovsen, E."],"country":["Germany"],"glorg":["All Global Affiliations","Christian-Albrechts-University of Kiel","Kiel University"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-U-AAU","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"plasmonic black gold based broadband polarizers for ultra short laser pulses","src":["aau","sdu"],"src-code":["DI-U-AAU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1063/1.4830040","version":"Other Version"},"id":"S02-095.24-008202","identifier":[{"id":"000327590400002","type":"wos"},{"id":"84888418218","type":"scopus"}],"ids":["aau-aa169c41-f734-4015-ad9e-6c53e7c9090a","sdu-711ef5f1-5d44-48df-ad35-f5b1b3d8da30"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-2BBF85C8933E1CC68AEDB1CAAC138E57"],"oa_link":[{"access":"oa","type":"doi","url":"https: