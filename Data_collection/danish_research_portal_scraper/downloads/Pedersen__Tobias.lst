lecode":"pau"},{"affno":"12","corresponding":null,"first":"Holger","key":"rohdeped","last":"Rohde","name":"Rohde, Holger","rank":17,"role":"Editor","rolecode":"ped"}],"pmid":["35148318"],"pub":{"doi":"10.1371/journal.pone.0261999","issn":["19326203"],"issue":"2","journal":"PLOS ONE","paperid":"e0261999","publisher":"Public Library of Science","status":"p","title":"PLOS ONE","title_org":"PLoS ONE","volume":"17"},"review":"Peer Reviewed","scoID":["2-s2.0-85124500719"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","North Denmark Region","Other Research","Region Zealand","Region of Southern Denmark","Technical University of Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-c17d9107-e860-4b35-a9f4-c00912a96a6b","au-6a38c355-5315-4863-86cd-05341458aa0c","dtu-5c50987f-8acb-4073-b799-b00149736007","ku-885a76a3-1c32-490e-a949-a39710624ff4","sdu-eace14f7-c5f2-402f-be66-46346d47a636"],"src":["AAU Aalborg University","AU Aarhus University","DTU Technical University of Denmark","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"One Day in Denmark : Nationwide point-prevalence survey of human bacterial isolates and comparison of classical and whole-genome sequence-based species identification methods","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S05-096.02-009319","year":"2022","yearsub":"2022"}
{"abstract":"Background: The effects of climate change, soil depletion, a growing world population putting pressure on food safety and security are major challenges for agriculture in the 21st century. The breeding success of the green revolution has decelerated and current programs can only offset the yield affecting factors. Purpose and scope: New approaches are urgently needed and “Genome Editing-accelerated Re-Domestication” (GEaReD) is proposed as a major new direction in plant breeding. By combining the upcoming technologies for phenotyping, omics, and artificial intelligence with the promising new CRISPR-toolkits, this approach is closer than ever. Summary and conclusion: Wild relatives of current crops are often adapted to harsh environments and have a high genetic diversity. Redomestication of wild barley or teosinte could generate new cultivars adapted to environmental changes. De novo domestication of perennial relatives such as Hordeum bulbosum could counter soil depletion and increase soil carbon. Recent research already proved the principle of redomestication in tomato and rice and therefore laid the foundation for GEaReD.","author_count":3,"contributors":["Hanak, Tobias","Madsen, Claus Krogh","Brinch-Pedersen, Henrik"],"cuid":["S01-000.00-250827"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Brinch-Pedersen, Henrik"],"keyword":["Artificial intelligence","Domestication","Gene editing","Genome Plant genetics","Genome editing","Hordeum genetics","Plant Breeding","Soil","de novo domestication"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"genome editing accelerated re domestication geared a new major direction in plant breeding","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1002/biot.202100545","version":"Published Version"},"id":"S01-000.00-250827","identifier":[{"id":"85124757284","type":"scopus"},{"id":"35120401","type":"pmid"}],"ids":["au-d4cd4d07-395e-4f37-9550-0b98362a42fb"],"keyword":["Artificial Intelligence","Domestication","Gene Editing","Genome Editing","Genome, Plant/genetics","Hordeum/genetics","Plant Breeding","Soil","de novo domestication","resilient crops"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-2C4C3BA5C18F9E71EBBCA1F6F2601091"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1002/biot.202100545","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.au.dk/ws/files/300476548/Biotechnology_Journal_2022_Hanak_Genome_Editing_accelerated_Re_Domestication_GEaReD_A_new_major_direction_in.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Agroecology, Department of Agroecology - Crop Genetics and Biotechnology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Tobias","key":"hanakpau","last":"Hanak","locid":"d1eec89c-eeb2-4337-adcc-79cf10e2d519","name":"Hanak, Tobias","orcid":"0000-0003-2913-9893","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Claus Krogh","key":"madsenpau","last":"Madsen","locid":"483c5221-13c3-4c94-a6f5-164754c12557","name":"Madsen, Claus Krogh","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik","key":"brinchpedersenpau","last":"Brinch-Pedersen","locid":"b99acfd4-b212-450a-86a8-0d91eb9c1a15","name":"Brinch-Pedersen, Henrik","orcid":"0000-0002-9773-8903","rank":3,"rolecode":"pau"}],"pmid":["35120401"],"pub":{"doi":"10.1002/biot.202100545","issn":["18606768","18607314"],"issn_org":["18606768"],"issue":"7","journal":"Biotechnology Journal","paperid":"2100545","publisher":"Wiley-VCH Verlag","status":"p","title":"Biotechnology Journal","volume":"17"},"review":"Peer Reviewed","scoID":["2-s2.0-85124757284"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-d4cd4d07-395e-4f37-9550-0b98362a42fb"],"src":["AU Aarhus University"],"title":"Genome Editing-accelerated Re-Domestication (GEaReD) – A new major direction in plant breeding","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-250827","year":"2022","yearsub":"2022"}
{"abstract":"The CorA family of proteins regulates the homeostasis of divalent metal ions in many bacteria, archaea, and eukaryotic mitochondria, making it an important target in the investigation of the mechanisms of transport and its functional regulation. Although numerous structures of open and closed channels are now available for the CorA family, the mechanism of the transport regulation remains elusive. Here, we investigated the conformational distribution and associated dynamic behaviour of the pentameric Mg2+ channel CorA at room temperature using small-angle neutron scattering (SANS) in combination with molecular dynamics (MD) simulations and solid-state nuclear magnetic resonance spectroscopy (NMR). We find that neither the Mg2+-bound closed structure nor the Mg2+-free open forms are sufficient to explain the average conformation of CorA. Our data support the presence of conformational equilibria between multiple states, and we further find a variation in the behaviour of the backbone dynamics with and without Mg2+. We propose that CorA must be in a dynamic equilibrium between different non-conducting states, both symmetric and asymmetric, regardless of bound Mg2+ but that conducting states become more populated in Mg2+-free conditions. These properties are regulated by backbone dynamics and are key to understanding the functional regulation of CorA.","author_count":20,"contributors":["Johansen, Nicolai Tidemand","Bonaccorsi, Marta","Bengtsen, Tone","Larsen, Andreas Haahr","Tidemand, Frederik Grønbæk","Pedersen, Martin Cramer","Huda, Pie","Berndtsson, Jens","Darwish, Tamim","Yepuri, Nageshewar Rao","Martel, Anne","Günther-Pomorski, Thomas","Bertarello, Andrea","Sansom, Mark","Rapp, Mikaela","Crehuet, Ramon","Schubeis, Tobias","Lindorff-Larsen, Kresten","Pintacuda, Guido","Arleth, Lise"],"cuid":["S01-000.00-463882"],"filters":{"added":"2022-04","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD","Oceania"],"country":["Australia","France","Germany","Spain","Sweden","United Kingdom"],"glorg":["All Global Affiliations","Australian Nuclear Science and Technology Organisation","Institut Laue-Langevin","Ruhr University Bochum","Stockholm University","The Spanish National Research Council (CSIC)","University of Oxford","University of Queensland","École normale supérieure de Lyon"],"keyword":["E coli","Molecular biophysics","Small angle neutron scattering","Solid State Nuclear Magnetic Resonance","Structural biology"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"mg sup 000000000002 sup dependent conformational equilibria in cora and an integrated view on transport regulation","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.7554/eLife.71887","version":"Published Version"},"id":"S01-000.00-463882","identifier":[{"id":"85125020573","type":"scopus"},{"id":"PMC8865849","type":"pmcid"},{"id":"35129435","type":"pmid"},{"id":"000763419500001","type":"wos"}],"ids":["ku-75ca3cf4-25aa-4840-ba7c-12c17d405306"],"keyword":["E. coli","cora mg2+ channel","metadynamics simulation","molecular biophysics","small-angle neutron scattering","solid-state nuclear magnetic resonance","structural biology"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-A3761403F022DBC8CC983B977B06A289"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.7554/eLife.71887","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/300453696/elife_71887_v2.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Te