{"abstract":"Lasso peptides are ribosomally synthesized and post-translationally modified peptides (RiPPs) produced by microorganisms. Here we show that the two natural products triculamin and alboverticillin, originally isolated in 1967 and 1958, respectively, with potent and specific activity against mycobacteria are in fact the same lasso peptide. We solved the structure using 2D NMR spectroscopy and expanded on the previously reported bioactivity. Through genome sequencing, we identify the responsible biosynthetic gene clusters, which curiously revealed that, unlike any known lasso peptides, their precursor peptides appear to have a follower instead of a leader peptide.","author_count":11,"contributors":["Andersen, Frederikke Dybdahl","Pedersen, Katja D.","Juhl, Dennis Wilkens","Mygind, Tobias","Chopin, Paul","Svenningsen, Esben B","Poulsen, Thomas","Lund, Marie Braad","Schramm, Andreas","Gotfredsen, Charlotte H.","Tørring, Thomas"],"cuid":["S02-100.00-022033"],"filters":{"added":"2022-09","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Tørring, Thomas"],"keyword":["Antagonist","Biological Products","Maturation","Multigene Family","Peptides chemistry","Protein Processing Post Translational","Sequence","Tuberculosis"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-DTU"]},"level3all":["DI-U-AU","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"triculamin an unusual lasso peptide with potent antimycobacterial activity","src":["au","dtu"],"src-code":["DI-U-AU","DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85132940390","version":"Other Version"},"id":"S02-100.00-022033","identifier":[{"id":"35748039","type":"pmid"},{"id":"000818479600001","type":"wos"},{"id":"85132940390","type":"scopus"}],"ids":["au-80693691-9f61-47ac-aeec-68dfbd12321d","dtu-04dd612b-4693-4da8-b03b-63ce24ee99e4"],"keyword":["ANANTIN","ANTAGONIST","Biological Products","MATURATION","Multigene Family","NATRIURETIC-FACTOR ANF","Peptides/chemistry","Protein Processing, Post-Translational","SEQUENCE","TUBERCULOSIS"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-A17A23AF2850003FE3BC87DA6F142123"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Biological and Chemical Engineering, Department of Biological and Chemical Engineering - Industrial Biotechnology - Gustav Wieds Vej 10D"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Chemistry"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Frederikke D.","key":"andersenpau","last":"Andersen","locid":"5c98ea71-9638-46fe-9ee3-6e2525f6452b","name":"Andersen, Frederikke Dybdahl","name_org":"Andersen, Frederikke D.","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Katja D.","key":"pedersenpau","last":"Pedersen","locid":"50c7253a-7a37-4ab8-b88c-b04f6a99df15","name":"Pedersen, Katja Desiree","name_org":"Pedersen, Katja D.","orcid":"0000-0002-4193-2678","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Dennis","key":"wilkensjuhlpau","last":"Wilkens Juhl","locid":"94244257-665e-4121-992b-fc4b2a66d878","name":"Juhl, Dennis Wilkens","name_org":"Wilkens Juhl, Dennis","orcid":"0000-0002-3416-5597","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Tobias","key":"mygindpau","last":"Mygind","name":"Mygind, Tobias","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Paul","key":"chopinpau","last":"Chopin","locid":"449f6778-4697-4a12-a317-601e27095e90","name":"Chopin, Paul","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Esben","key":"bsvenningsenpau","last":"B. Svenningsen","locid":"7cfe9579-e4c5-4726-a00e-5a2f1211fc06","name":"Svenningsen, Esben B","name_org":"B. Svenningsen, Esben","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Thomas B.","key":"poulsenpau","last":"Poulsen","locid":"9a15ee93-bb6a-4e1f-bb03-aac8b87ecf90","name":"Poulsen, Thomas","name_org":"Poulsen, Thomas B.","orcid":"0000-0002-0763-9996","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Marie","key":"braadlundpau","last":"Braad Lund","locid":"ccca6a51-5b47-45b6-969c-b0c5ea95100c","name":"Lund, Marie Braad","name_org":"Braad Lund, Marie","orcid":"0000-0003-1543-1009","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Andreas","key":"schrammpau","last":"Schramm","locid":"25080de3-b60e-46b4-a606-d99f1ec089e5","name":"Schramm, Andreas","orcid":"0000-0002-7614-9616","rank":9,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Charlotte H.","key":"gotfredsenpau","last":"Gotfredsen","locid":"1cf4df84-2d0e-4693-bf47-e9932e3bf0e3","name":"Gotfredsen, Charlotte Held","name_org":"Gotfredsen, Charlotte H.","orcid":"0000-0002-7386-119X","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Thomas","key":"tørringpau","last":"Tørring","locid":"b03df36b-0252-4e5a-aeee-7113f77cad12","name":"Tørring, Thomas","orcid":"0000-0001-5257-2121","rank":11,"rolecode":"pau"}],"pmid":["35748039"],"pub":{"doi":"10.1021/acs.jnatprod.2c00065","issn":["01633864","15206025"],"issn_org":["01633864"],"issue":"6","journal":"Journal of Natural Products","pages":"1514-1521","publisher":"American Chemical Society","status":"p","title":"Journal of Natural Products","volume":"85"},"review":"Peer Reviewed","scoID":["2-s2.0-85132940390"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["au-80693691-9f61-47ac-aeec-68dfbd12321d","dtu-04dd612b-4693-4da8-b03b-63ce24ee99e4"],"src":["AU Aarhus University","DTU Technical University of Denmark"],"title":"Triculamin : An Unusual Lasso Peptide with Potent Antimycobacterial Activity","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-022033","year":"2022","yearsub":"2022"}
{"abstract":"This paper presents a summary of work undertaken by the authors and their teams on a series of Qe’an (plural of Qa’), in the Badia of eastern Jordan. These basins are a foci for settlement in the region, with the sites described here (Shubayqa, Wisad and the Qa’ Qattafi) edged by archaeological sites dating from the late Epipalaeolithic (ca. 14,500 - 11,600 cal BP) and the Neolithic (ca. 11,700 - 6,100 cal BP), and in areas still used by people today as seasonal wetlands for watering animals and growing cereal. We assess here the potential for the Qe’an sediments to provide what would be rare continuous palaeoenvironmental records for this part of SW Asia. The paper presents the first dates from the Qe’an of this region and the outline sedimentology. Much of the fill is of Holocene age, which leads to discussion of climate and landscape change over the last 15,000 years, particularly due to the close geographical relationship between these basins and archaeology. Our optically stimulated luminescence and radiocarbon dating of the basin fill suggests that there was significantly more space in the landscape for water storage in the early Holocene, which may have therefore provided this resource for people and their livestock or game for a longer duration each year than that seen today. Linked to this are hypotheses of a more vegetated landscape during this time period. Given the environmentally marginal nature of our study area subtle changes in landscape and/or climate, and human exploitation of these resources, could have led to significant, and likely detrimental for its inhabitants, environmental impacts for the region, such as desertification. Our data are suggestive of desertification occurring, and sets up a clear hypothesis for testing by future work in the region.","author_count":13,"contributors":["Jones, Matthew","Richter, Tobias","Rollefson, Gary","Rowan, Yorke","Roe, Joe","Toms, Phillip","Wood, James","Wasse, Alexander","Ikram, Haroon","Williams, Matthew","AlShdaifat, Ahmad","Pedersen, Patrick Nørskov","Esaid, Wesam"],"cuid":["S01-000.00-510922"],"filters":{"added":"2022-10","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of Nottingham"],"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the palaeoenvironmental potential of the eastern jordanian desert basins qe an","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/381506076/sfsef_10120_Toms_2021_The_palaeoenvironmental_potential_of_the_eastern_Jordanian_desert_basins.pdf","version":"Authors Final Version"},"id":"S01-000.00-510922","identifier":[{"id":"85111038809","type":"scopus"}],"ids":["ku-c4dee57f-9a96-4b4b-8d41-4952e6c1dc0c"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-4-5141610C8C0EE4C9ABE2A37252A61EBD"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/381506076/sfsef_10120_Toms_2021_The_palaeoenvironmental_potential_of_the_eastern_Jordanian_desert_basins.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Humanities (HUM)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"gb","key":"university of nottingham","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Nottingham","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Humanities, Department of Cross-Cultural and Regional Studies"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Matthew","key":"jonespau","last":"Jones","name":"Jones, Matthew","rank":1,"rolecode":"pau"},{"affno":"2","first":"Tobias","key":"richterpau","last":"Richter","locid":"eacd6ca8-b280-46dd-bd5c-7405e386b59b","name":"Richter, Tobias","orcid":"0000-0001-9902-8852","rank":2,"rolecode":"pau"},{"affno":"","first":"Gary","key":"rollefsonpau","last":"Rollefson","name":"Rollefson, Gary","rank":3,"rolecode":"pau"},{"affno":"","first":"Yorke","key":"rowanpau","last":"Rowan","name":"Rowan, Yorke","rank":4,"rolecode":"pau"},{"affno":"2","first":"Joe","key":"roepau","last":"Roe","locid":"ac17f6a4-a93a-46b3-871a-ab6072641e76","name":"Roe, Joe","orcid":"0000-0002-1011-1244","rank":5,"rolecode":"pau"},{"affno":"","first":"Phillip","key":"tomspau","last":"Toms","name":"Toms, Phillip","rank":6,"rolecode":"pau"},{"affno":"","first":"James","key":"woodpau","last":"Wood","name":"Wood, James","rank":7,"rolecode":"pau"},{"affno":"","first":"Alexander","key":"wassepau","last":"Wasse","name":"Wasse, Alexander","rank":8,"rolecode":"pau"},{"affno":"","first":"Haroon","key":"ikrampau","last":"Ikram","name":"Ikram, Haroon","rank":9,"rolecode":"pau"},{"affno":"","first":"Matthew","key":"williamspau","last":"Williams","name":"Williams, Matthew","rank":10,"rolecode":"pau"},{"affno":"","first":"Ahmad","key":"alshdaifatpau","last":"AlShdaifat","name":"AlShdaifat, Ahmad","rank":11,"rolecode":"pau"},{"affno":"2","first":"Patrick Nørskov","key":"pedersenpau","last":"Pedersen","locid":"3bc10786-6db0-43a3-a028-9de1697afb13","name":"Pedersen, Patrick Nørskov","orcid":"0000-0001-9843-0858","rank":12,"rolecode":"pau"},{"affno":"","first":"Wesam","key":"esaidpau","last":"Esaid","name":"Esaid, Wesam","rank":13,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.quaint.2021.06.023","issn":["10406182","18734553"],"issn_org":["10406182"],"journal":"Quaternary International","pages":"73-82","status":"p","t