iewed","scoID":["2-s2.0-85040018772"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-869e0a3d-02fa-45c3-8a87-4da81b695346","ku-d810a12c-e1f8-483b-b4ac-60bd6d271a62"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"Prevalence of skull pathologies in European harbor seals (<i>Phoca vitulina</i>) during 1981–2014","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-006514","year":"2018","yearsub":"2018"}
{"abstract":"Background Factor graphs provide a flexible and general framework for specifying probability distributions. They can capture a range of popular and recent models for analysis of both genomics data as well as data from other scientific fields. Owing to the ever larger data sets encountered in genomics and the multiple-testing issues accompanying them, accurate significance evaluation is of great importance. We here address the problem of evaluating statistical significance of observations from factor graph models. Results Two novel numerical approximations for evaluation of statistical significance are presented. First a method using importance sampling. Second a saddlepoint approximation based method. We develop algorithms to efficiently compute the approximations and compare them to naive sampling and the normal approximation. The individual merits of the methods are analysed both from a theoretical viewpoint and with simulations. A guideline for choosing between the normal approximation, saddle-point approximation and importance sampling is also provided. Finally, the applicability of the methods is demonstrated with examples from cancer genomics, motif-analysis and phylogenetics. Conclusions The applicability of saddlepoint approximation and importance sampling is demonstrated on known models in the factor graph framework. Using the two methods we can substantially improve computational cost without compromising accuracy. This contribution allows analyses of large datasets in the general factor graph framework.","author_count":4,"contributors":["Madsen, Tobias","Hobolth, Asger","Jensen, Jens Ledet","Pedersen, Jakob Skou"],"cuid":["S01-000.00-196747"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Importance sampling","Saddlepoint approximation"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"significance evaluation in factor graphs","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12859-017-1614-z","version":"Published Version"},"id":"S01-000.00-196747","identifier":[{"id":"28359297","type":"pmid"},{"id":"85016570691","type":"scopus"},{"id":"PMC5374669","type":"pmcid"}],"ids":["au-76095c47-3b60-4a4a-a8f9-8ca697b060f1"],"keyword":["Significance evaluation","factor graph","importance sampling","saddlepoint approximation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-0F2F07EDC4DE743DB759E0544C738A79"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12859-017-1614-z","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.au.dk/ws/files/118415424/s12859_017_1614_z.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Molecular Medicine (MOMA)","Aarhus University, Natural Sciences, Department of Molecular Biology and Genetics, Department of Molecular Biology and Genetics - Bioinformatics Research Centre (BiRC)"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Tobias","key":"madsenpau","last":"Madsen","locid":"357e5996-0e47-4e89-9ed6-42b1b76660ae","name":"Madsen, Tobias","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Asger","key":"hobolthpau","last":"Hobolth","locid":"8d387f4e-86e9-4405-a50d-1e5a6efd97d8","name":"Hobolth, Asger","orcid":"0000-0003-4056-1286","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens Ledet","key":"jensenpau","last":"Jensen","locid":"a58c9c5a-0879-4606-a387-ebc8b984b134","name":"Jensen, Jens Ledet","orcid":"0000-0002-8776-5764","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jakob Skou","key":"pedersenpau","last":"Pedersen","locid":"9c14e87f-2dc3-4c08-a074-146337aff8a0","name":"Pedersen, Jakob Skou","orcid":"0000-0002-7236-4001","rank":4,"rolecode":"pau"}],"pmid":["28359297"],"pub":{"doi":"10.1186/s12859-017-1614-z","issn":["14712105"],"issue":"1","journal":"BMC Bioinformatics","pages":"199","paperid":"199","publisher":"BioMed Central","status":"p","title":"BMC Bioinformatics","volume":"18"},"review":"Peer Reviewed","scoID":["2-s2.0-85016570691"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-76095c47-3b60-4a4a-a8f9-8ca697b060f1"],"src":["AU Aarhus University"],"title":"Significance evaluation in factor graphs","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-196747","year":"2017","yearsub":"2017"}
{"abstract":"The size premium has been challenged along many fronts: it has a weak historical record, varies significantly over time, in particular weakening after its discovery, is concentrated among microcap stocks, resides predominantly in January, is not present for non-price based measures of size, is weak internationally, and is argued to be subsumed by proxies for illiquidity. We find, however, that these challenges are systematically dismantled when controlling for the quality, or its inverse “junk”, of a firm. Across a wide variety of quality measures proposed in the literature a significant size premium emerges, which is: stable through time, robust to specification, more consistent across seasons and markets, not concentrated in microcaps, robust to non-price based measures of size, and not captured by an illiquidity premium. These results are replicated in 30 different industries and in 24 different equity markets. The resurrected size effect that controls for quality puts it on par with other anomalies such as value and momentum in terms of its economic significance.","author_count":5,"contributors":["Asness, Cliff","Frazzini, Andrea","Israel, Ronen","Moskowitz, Tobias","Pedersen, Lasse Heje"],"cuid":["S01-000.00-294739"],"event":{"end":"2017-01-08","place":"Chicago, us","start":"2017-01-06","title":"The 77th Annual Meeting of American Finance Association. AFA 2017","year":"2017"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["AQR Capital Management","All Global Affiliations","New York University","University of Chicago Booth School of Business"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"pr","rtype":["clu"],"sorti":"size matters if you control your junk","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://editorialexpress.com/cgi-bin/conference/download.cgi?db_name=AFA2017&paper_id=23","version":"Published Version"},"id":"S01-000.00-294739","ids":["cbs-cb774db5-9263-4c3b-95bb-c8400831459a"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-5F552A27FF5EC93622B8DBEBA7C03B23"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://editorialexpress.com/cgi-bin/conference/download.cgi?db_name=AFA2017&paper_id=23","version":"Published Version"}],"org":[{"affno":"1","country":"us","key":"aqr capital management","loc":["United States","America, North","OECD"],"name":"AQR Capital Management","used":1},{"affno":"2","country":"us","key":"university of chicago booth school of business","loc":["United States","America, North","OECD"],"name":"University of Chicago Booth School of Business","used":1},{"affno":"3","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Finance"],"nora_code":"DI-U-CBS","used":1},{"affno":"4","country":"us","key":"new york university","loc":["United States","America, North","OECD"],"name":"New York University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Cliff","key":"asnesspau","last":"Asness","name":"Asness, Cliff","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andrea","key":"frazzinipau","last":"Frazzini","name":"Frazzini, Andrea","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ronen","key":"israelpau","last":"Israel","name":"Israel, Ronen","rank":3,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Tobias","key":"moskowitzpau","last":"Moskowitz","name":"Moskowitz, Tobias","rank":4,"rolecode":"pau"},{"affno":"1 3 4","corresponding":null,"first":"Lasse Heje","key":"pedersenpau","last":"Pedersen","locid":"cb7f3ab8-aada-4653-8366-cd5a05f54f56","name":"Pedersen, Lasse Heje","orcid":"0000-0001-7126-5530","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["cbs-cb774db5-9263-4c3b-95bb-c8400831459a"],"src":["CBS Copenhagen Business School"],"title":"Size Matters, if you Control Your Junk","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-294739","year":"2017","yearsub":"2017"}
{"abstract":"To describe the prevalence of comorbidity and its impact on survival in newly diagnosed multiple myeloma patients compared with population controls. Cases of newly diagnosed symptomatic multiple myeloma during the 2005-2012 period were identified in the Danish National Multiple Myeloma Registry. For each myeloma patient, 10 members of the general population matched by age and sex were chosen from the national Civil Registration System. Data on comorbidity in the myeloma patients and the general population comparison cohort were collected by linkage to the Danish National Patient Registry (DNPR). Cox proportional hazards regression models were used to evaluate the prognostic significance of comorbidity. The study included 2190 cases of multiple myeloma and 21,900 population controls. The comorbidity was increased in multiple myeloma patients compared with population controls, odds ratio (OR) 1.4 (1.1-1.7). The registration of comorbidity was highly increased within the year preceding diagnosis of multiple myeloma (OR 3.0 [2.5-3.5]), which was attributable to an increased registration of various diseases, in particular, renal disease with OR 11.0 (8.1-14.9). The median follow-up time from diagnosis of multiple myeloma for patients alive was 4.3 years (interquartile range 2.4-6.3). Patients with registered comorbidity had increased mortality compared with patients without comorbidity, hazard ratio 1.6 (1.5-1.8). Multiple myeloma patients have increased comorbidity compared with the background population, in particular during the year preceding the diagnosis of myeloma.","author_count":12,"contributors":["Gregersen, Henrik","Vangsted, Annette Juul","Abildgaard, Niels","Andersen, Niels Frost","Pedersen, Robert Schou","Frølund, Ulf Christian","Helleberg, Carsten","Broch, Bettina","Pedersen, Per Trøllund","Gimsing, Peter","Klausen, Tobias Wirenfeldt"],"cuid":["S04-100.00-002128"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"corresponding_author":["Gregersen, Henrik"],"keyword":["Adult","Aged","Aged 80 and over","Case Control Studies","Comorbidity","Denmark epidemiology","Female","Hematopoietic Stem Cell Transplantation","Humans","International Classification of Diseases","Journal Article","Male","Middle Aged","Mortality","Multiple Myeloma diagnosis","Multiple myeloma","Odds Ratio","Population Surveillance","Prognosis","Proportional Hazards Models","Registries","Risk Factors","Survival","Transplantation Conditioning","Young Adult"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA"],"OT":["Department of Hematology, Regional Hospital West Jutland, DK-7500, Holstebro, Denmark."],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"the impact of comorbidity on mortality in multiple myeloma a danish nationwide population based study","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1002/cam4.1128","version":"Published Version"},"id":"S04-100.00-002128","identifier":[{"id":"000405287700030","type":"wos"},{"id":"28639741","type":"pmid"},{"id":"85021200446","type":"scopus"},{"id":"PMC5504337","type":"pmcid"}],"ids":["aau-2a564009-86a3-4b86-bd20-f6d0a566767e","au-a1936558-de48-4c1f-a33f-253baa135fed","ku-41030e55-751c-460a-9632-72faa1b9f368","sdu-7bc360a3-f568-4748-9df8-d1265d2de31d"],"keyword":["Adult","Aged","Aged, 80 and over","Case-Control Studies","Comorbidity","Denmark/epidemiology","Female","Hematopoietic Stem Cell Transplantation","Humans","Journal Article","Male","Melph