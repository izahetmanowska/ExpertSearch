,"l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Law, Area of Research, Faculty of Law Research Centres"],"nora_code":"DI-U-KU"}],"person":[{"affno":"1 2","corresponding":null,"first":"Tobias","key":"indénpau","last":"Indén","locid":"3b04c4bf-9d11-49f5-9d61-9d5e4dfb8bae","name":"Indén, Tobias","rank":1,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Karsten Naundrup","key":"olesenpau","last":"Olesen","name":"Olesen, Karsten Naundrup","rank":2,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Kent","key":"kristensenpau","last":"Kristensen","locid":"ed56def0-7c42-4648-931e-96789163331f","name":"Kristensen, Kent","orcid":"0000-0002-3556-985X","rank":3,"rolecode":"pau"},{"affno":"","first":"Hans Viggo Godsk","key":"pedersenpedh","last":"Pedersen","name":"Pedersen, Hans Viggo Godsk","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Hans Viggo","key":"godskpedersenpedh","last":"Godsk Pedersen","name":"Godsk Pedersen, Hans Viggo","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9788757431025"],"pages":"179-201","place":"København","publisher":"Djøf Forlag","status":"p","title":"Juridiske emner ved Syddansk Universitet 2013"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Undetermined","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-5f8d6e02-7592-432c-8fd0-45c932110ed3","sdu-7e42e47d-ed22-439f-9394-347a238e57c0"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Kontrakt med det offentlige : Udløbere af lægekonflikten 2013","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-094.55-042840","year":"2013","yearsub":"2013"}
{"abstract":"In the later years, there has been an increased focus on new valve types, which yield the possibility to do Separate Meter-In Separate Meter-Out (SMISMO) control. This includes both digital valves, but proportional valves with separate metering spools and build in pressure sensors are also emerging. The possibility to independently control the meter-in and meter-out side not only increase the functionality of the system, but also opens up for better performance and/or lowered energy consumption. The focus of the current paper is therefore on investigation and comparison of what may be obtained using multivariable control strategies for SMISMO control of a single axis hydraulic system with a differential cylinder, when not taking other measures to improve performance. The paper first presents an experimentally verified model of the system considered, from which a linear model is derived. Based on the model, the control strategies are discussed and severalH¥ controllers are designed, for which both simulation and experimental results are presented. The controllers are evaluated with regard to performance and robustness and compared to a simple SISO control. Based on the findings, the possibilities and limitations of the approach and the different controllers are outlined and discussed.","author_count":4,"contributors":["Pedersen, Henrik C.","Andersen, Torben Ole","Skoubo, Tobias","Jacobsen, Morten"],"cuid":["S01-000.00-079929"],"event":{"end":"2013-10-09","place":"Sarasota, Florida, us","start":"2013-10-06","title":"ASME/BATH 2013 Symposium on Fluid Power &amp; Motion Control, FPMC2013","year":"2013"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"investigation and comparison of separate meter in separate meter out control strategies","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-079929","identifier":[{"id":"84899892016","type":"scopus"},{"id":"WOS:000349877400047","type":"wos"}],"ids":["aau-66e883dd-00de-412b-b314-1148ad0b262c"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-98E5F903C71FC00E9DE282592FA7D76C"],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (ENG)","Aalborg University, The Faculty of Engineering and Science, AAU Energy","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Fluid Power and Mechatronic Systems"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Henrik C.","key":"pedersenpau","last":"Pedersen","locid":"c292ad59-0351-46b5-9f9a-0ac10ac93be8","name":"Pedersen, Henrik C.","orcid":"0000-0002-1034-3280","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Torben Ole","key":"andersenpau","last":"Andersen","locid":"941895bc-244b-42d4-ba18-b499a2860e69","name":"Andersen, Torben Ole","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Tobias","key":"skoubopau","last":"Skoubo","locid":"18a61f3b-a3ea-4f18-a9e2-385f602b01aa","name":"Skoubo, Tobias","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Morten","key":"jacobsenpau","last":"Jacobsen","locid":"dca231b4-36c1-41ca-9be0-1252d9f05416","name":"Jacobsen, Morten","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1115/fpmc2013-4480","isbn":["9780791856086"],"pages":"1-10","publisher":"The American Society of Mechanical Engineers (ASME)","status":"p","title":"Proceedings of the ASME/BATH 2013 Symposium on Fluid Power &amp; Motion Control, FPMC2013"},"review":"Peer Reviewed","scoID":["2-s2.0-84899892016"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-66e883dd-00de-412b-b314-1148ad0b262c"],"src":["AAU Aalborg University"],"title":"Investigation and Comparison of Separate Meter-In Separate Meter-Out Control Strategies","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-079929","year":"2013","yearsub":"2013"}
{"abstract":"We find consistent value and momentum return premia across eight diverse markets and asset classes, and a strong common factor structure among their returns. Value and momentum returns correlate more strongly across asset classes than passive exposures to the asset classes, but value and momentum are negatively correlated with each other, both within and across asset classes. Our results indicate the presence of common global risks that we characterize with a three-factor model. Global funding liquidity risk is a partial source of these patterns, which are identifiable only when examining value and momentum jointly across markets. Our findings present a challenge to existing behavioral, institutional, and rational asset pricing theories that largely focus on U.S. equities.","author_count":3,"contributors":["Asness, Clifford S.","Moskowitz, Tobias","Pedersen, Lasse Heje"],"cuid":["S01-000.00-290354"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["AQR Capital Management","All Global Affiliations","University of Chicago Booth School of Business"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"pr","rtype":["clu"],"sorti":"value and momentum everywhere","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"http://olabout.wiley.com/WileyCDA/Section/id-820227.html#terms","type":"loc","url":"https://research-api.cbs.dk/ws/files/44523827/lasse_heje_pedersen_value_and_momentum_postprint.pdf","version":"Authors Final Version"},"id":"S01-000.00-290354","identifier":[{"id":"84876361140","type":"scopus"}],"ids":["cbs-9cef71a9-adf5-4d83-925d-53c571dd0691"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-2-A