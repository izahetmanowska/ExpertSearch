ersity","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Biomedicine, Department of Biomedicine - Research and Education, Bartholin Building"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"us","key":"washington university st louis","loc":["United States","America, North","OECD"],"name":"Washington University St. Louis","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Sabina","key":"sánchezhernándezpau","last":"Sánchez Hernández","locid":"be00f544-1931-4104-a4d2-ce1e7b62977c","name":"Hernández, Sabina Sánchez","name_org":"Sánchez Hernández, Sabina","orcid":"0000-0002-5858-4139","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Tobias Wang","key":"bjergpau","last":"Bjerg","locid":"3130e094-9318-4186-9c20-f39bc297cf68","name":"Bjerg, Tobias Wang","orcid":"0009-0000-8337-4136","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ian","key":"helstrupnielsenpau","last":"Helstrup Nielsen","locid":"232f4479-547f-4b50-b50c-10286fc91e18","name":"Nielsen, Ian Helstrup","name_org":"Helstrup Nielsen, Ian","orcid":"0009-0003-8736-9838","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders","key":"laustsenpau","last":"Laustsen","locid":"95ec8805-9d18-4dde-9d9c-80551566ed92","name":"Laustsen, Anders","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Hai","key":"qtangpau","last":"Q Tang","locid":"5415cb64-d41e-4892-8559-d174c9423a63","name":"Q Tang, Hai","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars","key":"henningpedersenpau","last":"Henning Pedersen","locid":"2057ad48-88eb-439f-87ab-11512c937236","name":"Pedersen, Lars Henning","name_org":"Henning Pedersen, Lars","orcid":"0000-0001-6726-1991","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Eynav