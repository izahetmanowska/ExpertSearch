emistry","Aarhus University, Natural Sciences, Interdisciplinary Nanoscience Center, Interdisciplinary Nanoscience Center - INANO-Kemi, iNANO-huset"],"nora_code":"DI-U-AU","used":1},{"affno":"4","country":"de","key":"jülich research centre","loc":["Germany","Europe, EU","OECD"],"name":"Jülich Research Centre ( FZJ )","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Janine","key":"dubbertpau","last":"Dubbert","name":"Dubbert, Janine","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Tobias","key":"honoldpau","last":"Honold","name":"Honold, Tobias","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Jan Skov","key":"pedersenpau","last":"Pedersen","locid":"8cb5e42a-3881-479c-82a5-232355605d7e","name":"Pedersen, Jan Skov","orcid":"0000-0002-7768-0206","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Aurel","key":"radulescupau","last":"Radulescu","name":"Radulescu, Aurel","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Markus","key":"drechslerpau","last":"Drechsler","name":"Drechsler, Markus","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Matthias","key":"kargpau","last":"Karg","name":"Karg, Matthias","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Walter","key":"richteringpau","last":"Richtering","name":"Richtering, Walter","rank":7,"rolecode":"pau"}],"pub":{"doi":"10.1021/ma502056y","issn":["00249297","15205835"],"issn_org":["00249297"],"issue":"24","journal":"Macromolecules","pages":"8700-8708","publisher":"American Chemical Society","status":"p","title":"Macromolecules","volume":"47"},"review":"Peer Reviewed","scoID":["2-s2.0-84919797597"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-1699e634-820a-4f04-a256-71ba92704f7e"],"src":["AU Aarhus University"],"title":"How hollow are thermoresponsive hollow nanogels?","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-142417","year":"2014","yearsub":"2014"}
{"abstract":"Lymph flux rates in anuran amphibians are high relative to those of other vertebrates owing to 'leaky' capillaries and a high interstitial compliance. Lymph movement is accomplished primarily by specialised lymph muscles and lung ventilation that move lymph through highly compartmentalised lymph sacs to the dorsally located lymph hearts, which are responsible for pumping lymph into the circulatory system; however, it is unclear how lymph reaches the lymph hearts. We used computed tomography (CT) to visualise an iodinated contrast agent, injected into various lymph sacs, through the lymph system in cane toads (Rhinella marina). We observed vertical movement of contrast agent from lymph sacs as predicted, but the precise pathways were sometimes unexpected. These visual results confirm predictions regarding lymph movement, but also provide some novel findings regarding the pathways for lymph movement and establish CT as a useful technique for visualising lymph movement in amphibians.","author_count":6,"contributors":["Hedrick, Michael S.","Hansen, Kasper","Wang, Tobias","Lauridsen, Henrik","Thygesen, Jesper","Pedersen, Michael"],"cuid":["S01-000.00-254955"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","OECD"],"corresponding_author":["Hedrick, Michael S."],"country":["United States"],"glorg":["All Global Affiliations","University of Texas"],"keyword":["CT","Imaging","Rhinella marina","Skeletal muscles"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"visualising lymph movement in anuran amphibians with computed tomography","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1242/jeb.106906","version":"Other Version"},"id":