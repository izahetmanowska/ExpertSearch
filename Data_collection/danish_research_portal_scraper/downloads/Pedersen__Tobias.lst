ode":"pau"},{"affno":"1 3","first":"Christoffer Holst","key":"hahnchristofferholstpau","last":"Hahn","locid":"48ba72a8-a237-44e4-9b8b-9dcabc7be658","name":"Hahn, Christoffer Holst","rank":17,"rolecode":"pau"},{"affno":"3 1","first":"Tobias","key":"todsentobiaspau","last":"Todsen","locid":"16d5c332-f162-4f76-aa1c-b0306b8222e2","name":"Todsen, Tobias","orcid":"0000-0003-3267-3560","rank":18,"rolecode":"pau"}],"pmid":["40743258"],"pub":{"doi":"10.1371/journal.pone.0321043","issn":["19326203"],"issue":"7","journal":"PLOS ONE","paperid":"e0321043","publisher":"Public Library of Science","status":"p","title":"PLOS ONE","volume":"20"},"review":"Peer Reviewed","scoID":["2-s2.0-105012247682"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region Zealand","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-f67d455d-019e-4401-a226-7d64c2d08a68","sdu-73cb475e-3f88-4a1a-9c8b-776eeacd75a4"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Spinal needles versus conventional needles for fine-needle aspiration biopsy of thyroid nodules—A multicenter randomized controlled trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-087.94-823064","year":"2025","yearsub":"2025"}
{"abstract":"Background: Older people with multiple sclerosis (pwMS) make up over one-third of the MS population. Ageing increases the risk of sarcopenia, characterised by reduced muscle mass, strength, and function. MS symptoms likely exacerbate sarcopenia, but its impact on older pwMS remains largely unexplored Objectives: The primary aim of this study was to investigate how the diagnosis of sarcopenia using the European Working Group on Sarcopenia in Older People 2 (EWGSOP2) diagnostic tool in older pwMS is influenced by using upper extremity-based or lower extremity-based tests. Methods: The present cross-sectional study analysed baseline data from the PoTOMS trial. A total of n = 41 older pwMS and n = 27 healthy controls (HC) were included. Participants were assessed for sarcopenia using the EWGSOP2 diagnostic tools and a lower extremity muscle strength test. Results: Older pwMS had a preferentially lower muscle mass and strength in the lower extremities compared to HC. According to EWGSOP2 criteria, 5 % of older pwMS had reduced upper extremity strength, 7 % had reduced lower extremity strength, and 15 % had sarcopenic muscle mass. However, only 5 % were diagnosed with sarcopenia despite these reductions. Conclusion: The present study shows that the sarcopenia diagnosis in older pwMS is more sensitive when using a lower extremity test, underlined by the preferentially lower muscle mass and strength in older pwMS compared to HC. Hence, when evaluating sarcopenia in older pwMS the diagnostics test should rely on the lower extremity test.","author_count":4,"contributors":["Gaemelke, Tobias","Pedersen, Ida S.","Dalgas, Ulrik","Hvid, Lars G."],"cuid":["S02-100.00-785118"],"filters":{"added":"2025-02","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"corresponding_author":["Gaemelke, Tobias"],"keyword":["Ageing","EWGSOP2","Multiple sclerosis","Neuromuscular function","Physical function","Sarcopenia"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-OTH"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-OTH","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"sarcopenia in older people with multiple sclerosis a cross sectional study","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.msard.2024.106190","version":"Published Version"},"id":"S02-100.00-785118","identifier":[{"id":"85210686743","type":"scopus"},{"id":"39631136","type":"pmid"}],"ids":["au-7a5b0c54-1b22-4f91-bba1-418dc5114647","sdu-dc623743-1865-40ce-a073-ccc88d7e26ad"],"keyword":["Ageing","EWGSOP2","Multiple sclerosis","Neuromuscular function","Physical function","Sarcopenia"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-502D006EA3EF2E6D654285E44C6976F9"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.msard.2024.106190","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/280137774/1-s2.0-S2211034824007661-main.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Public Health"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","country":"dk","key":"other hospitals","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-OTH","l3nl":"Other Hospitals","l3nn":"Other Hospitals","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Hospitals","namevar":["The Danish MS Hospitals"],"nora_code":"DI-HO-OTH","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Tobias","key":"gaemelkepau","last":"Gaemelke","locid":"093fd74f-b7eb-4a85-95ba-afc4e2017468","name":"Gaemelke, Tobias","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ida S.","key":"pedersenpau","last":"Pedersen","locid":"0086da5f-9ffe-437f-beef-5e2ef2c6fc8b","name":"Pedersen, Ida S.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ulrik","key":"dalgaspau","last":"Dalgas","locid":"2102ffe9-e66f-4d73-b757-78b5630fb6d6","name":"Dalgas, Ulrik","orcid":"0000-0003-4132-2789","rank":3,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"country":"dk","first":"Lars G.","key":"hvidpau","last":"Hvid","locid":"165f797e-aeb6-4650-a7a1-e33b77aaea96","name":"Hvid, Lars G.","orcid":"0000-0003-3233-0429","rank":4,"rolecode":"pau"}],"pmid":["39631136"],"pub":{"doi":"10.1016/j.msard.2024.106190","issn":["22110348","22110356"],"issn_org":["22110348"],"journal":"Multiple Sclerosis and Related Disorders","paperid":"106190","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"p","title":"Multiple Sclerosis and Related Disorders","volume":"93"},"review":"Peer Reviewed","scoID":["2-s2.0-85210686743"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Other Hospitals","Universities","University of Southern Denmark","the danish ms hospitals"],"PST":["Published"]},"sid":["au-7a5b0c54-1b22-4f91-bba1-418dc5114647","sdu-dc623743-1865-40ce-a073-ccc88d7e26ad"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Sarcopenia in older people with multiple sclerosis : A cross-sectional study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-785118","year":"2025","yearsub":"2025"}
{"abstract":"OBJECTIVE The optimal glycemic target for individuals with severe chronic kidney disease (CKD) remains unclear. We investigated the association between HbA1c and complications in individuals with diabetes and severe CKD. RESEARCH DESIGN AND METHODS In a Danish nationwide registry-based cohort study, we included 27,113 individuals ≥18 years old with diabetes and severe CKD (estimated glomerular filtration rate [eGFR] <30 mL/min/1.73 m2 ) between 2010 and 2022. As reference groups, we included an age-and sex-matched cohort of 80,131 individuals with diabetes and mild-to-moderate CKD (eGFR 30–59 mL/min/1.73 m2 ) and 80,797 individuals with diabetes and no-to-mild CKD (eGFR ≥60 mL/min/1.73 m2 ). Multiple Cox re-gressions were used to estimate the standardized 1-year risk of major adverse cardiovascular events (MACE), microvascular complications, and hospitalizations due to hypoglycemia across strata of HbA1c levels. RESULTS For individuals with severe CKD, the risk of MACE significantly increased at HbA1c levels ≥7.2% (55 mmol/mol) (P < 0.01) and <5.8% (40 mmol/mol) (P < 0.001), compared with an HbA1c level of 6.3–6.6% (45–49 mmol/mol). The risk of microvas-cular complications significantly increased at HbA1c levels ≥7.2% (55 mmol/mol) (P < 0.001), and the risk of hospitalization due to hypoglycemia significantly increased at HbA1c levels ≥6.7% (50 mmol/mol) (P < 0.001). The association patterns between HbA1c and outcomes were similar in the severe CKD cohort compared with the matched cohorts with mild-to-moderate CKD and no-to-mild CKD. CONCLUSIONS Our data suggest an HbA1c range of 6.7–7.1% (50–54 mmol/mol) to be most fa-vorable for reducing long-term complications in this high-risk population.","author_count":9,"contributors":["Kofod, Dea H.","Carlson, Nicholas","Almdal, Thomas","Bomholt, Tobias","Torp-Pedersen, Christian","Nørgaard, Kirsten","Svendsen, Jesper Hastrup","Feldt-Rasmussen, Bo","Hornum, Mads"],"cuid":["S01-000.00-829811"],"filters":{"added":"2025-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"OT":["Steno Diabetes Centre, Gentofte, Denmark."],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the association between hemoglobin a sub 000000000001c sub and complications among individuals with diabetes and severe chronic kidney disease","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-829811","identifier":[{"id":"PMC12281975","type":"pmcid"},{"id":"105012136383","type":"scopus"},{"id":"40481664","type":"pmid"}],"ids":["ku-c26b0f25-6edc-4ab7-950d-bb03b3981729"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-3635DD686768ABC30DE3DA0F55B6EBED"],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, No speciality"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Steno Diabetes Centre, Gentofte, Denmark."],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","first":"Dea H.","key":"kofodpau","last":"Kofod","name":"Kofod, Dea H.","rank":1,"rolecode":"pau"},{"affno":"1","first":"Nicholas","key":"carlsonpau","last":"Carlson","name":"Carlson, Nicholas","rank":2,"rolecode":"pau"},{"affno":"1 2","first":"Thomas P.","key":"almdalpau","last":"Almdal","locid":"cae595b0-e059-48f9-b1e4-153595fd7455","name":"Almdal, Thomas","name_org":"Almdal, Thomas P.","rank":3,"rolecode":"pau"},{"affno":"1","first":"Tobias","key":"bomholtpau","last":"Bomholt","name":"Bomholt, Tobias","rank":4,"rolecode":"pau"},{"affno":"2 1","first":"Christian","key":"torppedersenpau","last":"Torp-Pedersen","locid":"f71bedc6-3736-4559-b937-6a18e770616e","name":"Torp-Pedersen, Christian","rank":5,"rolecode":"pau"},{"affno":"2 3","first":"Kirsten","key":"nørgaardpau","last":"Nørgaard","locid":"771b216e-eeb8-449e-8cde-2cdd59ae6dbc","name":"Nørgaard, Kirsten","rank":6,"rolecode":"pau"},{"affno":"1 2","first":"Jesper H.","key":"svendsenpau","last":"Svendsen","locid":"d80910cf-2f9c-457c-9e85-34b4b258bb81","name":"Svendsen, Jesper Hastrup","name_org":"Svendsen, Jesper H.","orcid":"0000-0001-8466-8515","rank":7,"rolecode":"pau"},{"affno":"1 2","first":"Bo","key":"feldtrasmussenpau","last":"Feldt-Rasmussen","locid":"cdd06e7b-83c5-4118-8808-eb4591586aac","name":"Feldt-Rasmussen, Bo","rank":8,"rolecode":"pau"},{"affno":"1 2","first":"Mads","key":"hornumpau","last":"Hornum","locid":"6e7135d6-13c5-4f40-a3da-e8adf896bc7d","name":"Hornum, Mads","rank":9,"rolecode":"pau"}],"pmid":["40481664"],"pub":{"doi":"10.2337/dc25-0339","issn":["01495992"],"issue":"8","journal":"Diabetes Care","pages":"1400-1409","status":"p","title":"Diabetes Care","volume":"48"},"review":"Peer Reviewed","scoID":["2-s2.0-105012136383"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-c26b0f25-6edc-4ab7-950d-bb03b3981729"],"src":["KU University of Copenhagen"],"title":"The Association Between Hemoglobin A<sub>1c</sub> and Complications Among Individuals With Diabetes and Severe Chronic Kidney Disease","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-829811","year":"2025","yearsub":"2025"}
{"abstract":"Plasmacytoid dendritic cells (pDCs) are multifunctional immune cells with roles in both the innate and adaptive immune system. Their hallmark function is production of large amounts of type I interferons in response to viral infections, but they are also capable of producing a range of other cytokines, antigen presentation, and cytotoxicity. Their potential as an immunotherapy for cancer and infectious disease is being explored, but broad application of these cells is challenged by low frequency in the blood and low viability during ex vivo culturing. We have previously developed an effective in vitro differentiation protocol for producing pDCs from CD34+ hematopoietic stem and progenitor cells (HSPC-pDCs), which provides an attainable and large source of pDCs. HSPC-pDCs present pDC characteristics and functions, and like naturally occurring pDCs they exhibit large phenotypic and functional heterogeneity. Here, we characterize different cell subsets from in vitro pDC differentiation and identify a distinct population, which is the major producer of IFNα in response to TLR9 stimulation and display a transcriptomic profile similar to what is seen for pDCs circulating in the blood. We also investigate the possibility of rerouting subset specification during HSPCs-to-pDC differentiation by controlling gene expression of key master transcription factors (TFs). We identify TFs associated with the pDC differentiation trajectory that are essential for the development of TLR9-responsive HSPC-pDCs, and we also identify TFs that increase their frequency. In conclusion, we phenotypically and functionally characterize different cell subsets and modulate their relative frequencies by manipulating TF expression during pDC differentiation. These findings provide a deeper understanding of in vitro-differentiated pDC cultures that may spur further developments in their use as an immunomodulatory cell therapy.","author_count":9,"contributors":["Hernández, Sabina Sánchez","Bjerg, Tobias Wang","Nielsen, Ian Helstrup","Laustsen, Anders","Q Tang, Hai","Pedersen, Lars Henning","Klechevsky, Eynav","Jakobsen, Martin Roelsgaard","Bak, Rasmus O"],"cuid":["S01-000.00-805782"],"filters":{"added":"2025-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","OECD"],"corresponding_author":["Bak, Rasmus O"],"country":["United States"],"glorg":["All Global Affiliations","Washington University St. Louis"],"keyword":["CD34 hematopoietic stem cells","Plasmacytoid dendritic cells","in vitro differentiation","subsets","type I IFN"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"characterization of tlr000000000009 responsiveness in cell subsets derived from i in vitro i pdc differentiation of hematopoietic stem and progenitor cells","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fimmu.2025.1550397","version":"Published Version"},"id":"S01-000.00-805782","identifier":[{"id":"PMC11983628","type":"pmcid"},{"id":"40213544","type":"pmid"},{"id":"105002214471","type":"scopus"}],"ids":["au-06d96fb7-452e-462e-a537-cef1497655e6"],"keyword":["CD34 hematopoietic stem cells","in vitro differentiation","plasmacytoid dendritic cells","subsets","type I IFN"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-6A0117C2738B4BA6A302F24D09DA1D28"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fimmu.2025.1550397","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus Universit