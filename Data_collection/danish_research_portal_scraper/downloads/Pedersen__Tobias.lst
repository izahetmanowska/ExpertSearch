pe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Central Denmark Region"],"nora_code":"DI-HO-CDR","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Tobias","key":"pedersenpau","last":"Pedersen","name":"Pedersen, Tobias","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Victor Vadmand","key":"jensenpau","last":"Jensen","locid":"91e3c3ff-8e70-478c-8210-762b5095c803","name":"Jensen, Victor Vadmand","orcid":"0000-0003-4270-7891","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Signe Strandsbjerg","key":"kloppenborgpau","last":"Kloppenborg","name":"Kloppenborg, Signe Strandsbjerg","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Rasmus Mølgaard","key":"hansenpau","last":"Hansen","name":"Hansen, Rasmus Mølgaard","rank":4,"rolecode":"pau"},{"affno":"","first":"Vasillis","key":"galispedh","last":"Galis","name":"Galis, Vasillis","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Vasileios-Spyridon","key":"vlassispedh","last":"Vlassis","name":"Vlassis, Vasileios-Spyridon","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"eisbn":["978 1 03533 814 6"],"publisher":"Edward Elgar Publishing","status":"p","subtitle":"Sociotechnical Approaches to Service Delivery","title":"Digitalization, Data and Welfare"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["au-cfc6188b-9d3f-42c3-8a0d-17050a3a95ae"],"src":["AU Aarhus University"],"title":"The role of relatives in e-governance access among elderly citizens: vignettes from the Danish Covid-19 vaccination","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-826435","year":"2025","yearsub":"2025"}
{"abstract":"Entrepreneurship is surrounded by ideology, but how is this ideology transmitted within the context of university incubators? Prior research suggests both a model of direct and unreflexive ideological transmission and one emphasizing reflexivity and reinterpretation. Based primarily on 25 interviews with student entrepreneurs and employees in DreamLab, a student incubator in a Scandinavian university, we find that unreflexive transmission dominates student entrepreneurs’ initial experiences with the incubator, as employees promote the incubator and entrepreneurial ideology to students. Student entrepreneurs entering the incubator do not question the ideology, but often use it to promote the incubator to other students. However, three distinct types of “incompetence experience” can prompt students to reflect on both the incubator and the entrepreneurial ideology. Following an incompetence experience, student entrepreneurs distance themselves from the incubator and engage either in ideology problematization or in ideology affirmation. These findings extend current conceptions of how entrepreneurial ideology diffuses within higher education and raise questions about the role of incubators within universities and the entrepreneurial process.","author_count":4,"contributors":["Holck Pedersen, Mikkel","Rahbek, Tobias Christian","Yar, Adam Buttenschøn","Hartmann, Rasmus Koss"],"cuid":["S01-000.00-797710"],"filters":{"added":"2025-04","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Hartmann, Rasmus Koss"],"keyword":["Entrepreneurship","Ideology","Incompetence","Reflexivity","Students","University incubator"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"pr","rtype":["clu"],"sorti":"ideology incompetence and reflexivity in a university incubator","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.scaman.2025.101399","version":"Published Version"},"id":"S01-000.00-797710","identifier":[{"id":"85215614805","type":"scopus"}],"ids":["cbs-f6b63261-1e31-488f-83ff-c1f49bb033a7"],"keyword":["Entrepreneurship","Ideology","Incompetence","Reflexivity","Students","University incubator"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-3-ADB714D40F3E88029EF6FE1E4196C7D5"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.scaman.2025.101399","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://research-api.cbs.dk/ws/files/116794910/1-s2.0-S0956522125000041-main.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Management, Society and Communication"],"nora_code":"DI-U-CBS","used":1}],"person":[{"affno":"","corresponding":null,"first":"Mikkel","key":"holckpedersenpau","last":"Holck Pedersen","name":"Holck Pedersen, Mikkel","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Tobias Christian","key":"rahbekpau","last":"Rahbek","name":"Rahbek, Tobias Christian","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Adam Buttenschøn","key":"yarpau","last":"Yar","name":"Yar, Adam Buttenschøn","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rasmus Koss","key":"hartmannpau","last":"Hartmann","locid":"f6b2df19-dfb2-4be4-a091-3531e59ba7cc","name":"Hartmann, Rasmus Koss","orcid":"0000-0002-5414-9105","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.scaman.2025.101399","issn":["09565221","18733387"],"issn_org":["09565221"],"issue":"2","journal":"Scandinavian Journal of Management","paperid":"101399","publisher":"Elsevier","status":"p","title":"Scandinavian Journal of Management","volume":"41"},"review":"Peer Reviewed","scoID":["2-s2.0-85215614805"],"search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["cbs-f6b63261-1e31-488f-83ff-c1f49bb033a7"],"src":["CBS Copenhagen Business School"],"title":"Ideology, Incompetence and Reflexivity in a University Incubator","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-797710","year":"2025","yearsub":"2025"}
{"author_count":4,"contributors":["Houborg, Esben","Brummer, Julie Elizabeth","Kammersgaard, Tobias","Pedersen, Michael Mulbjerg"],"cuid":["S01-000.00-805737"],"filters":{"added":"2025-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"between decriminalization policy and police practice implementation of warnings as an alternative to criminalization for marginalized people addicted to drugs in denmark","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-805737","ids":["au-01bdddf6-8597-4b65-90b1-8f9eb92f3d67"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-B2436246738CFA30ED68DFA25CA4A6CB"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus BSS, Department of Psychology and Behavioural Sciences, Department of Psychology and Behavioural Sciences - Centre for Alcohol and Drug Research, Copenhagen"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Esben","key":"houborgpau","last":"Houborg","locid":"d5b83853-a418-451c-ab37-7883f87ca66b","name":"Houborg, Esben","orcid":"0000-0002-3212-6412","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Julie Elizabeth","key":"brummerpau","last":"Brummer","locid":"b4b727bd-e2d2-4b54-8777-6d485662b26a","name":"Brummer, Julie Elizabeth","orcid":"0000-0002-4811-7430","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Tobias","key":"kammersgaardpau","last":"Kammersgaard","locid":"1e01206b-4f87-4fe4-8783-2690a6cfb472","name":"Kammersgaard, Tobias","orcid":"0000-0003-4551-5131","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Michael Mulbjerg","key":"pedersenpau","last":"Pedersen","locid":"a4917cdf-2ecb-4002-9f58-5d3665aafabe","name":"Pedersen, Michael Mulbjerg","orcid":"0000-0001-8802-1081","rank":4,"rolecode":"pau"}],"pub":{"issn":["09553959"],"journal":"International Journal of Drug Policy","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"s","title":"International Journal of Drug Policy"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Submitted"]},"sid":["au-01bdddf6-8597-4b65-90b1-8f9eb92f3d67"],"src":["AU Aarhus University"],"title":"Between decriminalization policy and police practice: Implementation of warnings as an alternative to criminalization for marginalized people ’addicted’ to drugs in Denmark","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-805737","year":"2025","yearsub":"2025"}
{"abstract":"BACKGROUND: Sudden cardiac death (SCD) is a significant public health problem. Knowledge on SCD victims without a history of cardiovascular disease (CVD) is limited, presenting challenges for future prevention efforts. OBJECTIVES: This study aims to examine the differences between SCD cases with and without a known history of CVD. METHODS: All Danish citizens were followed from January 1, 2010, until death or the end of the year. All deaths in Denmark during this period were reviewed by ≥1 medical doctor to identify cases of SCD. Data were analyzed from March 2023 until March 2024. RESULTS: A total of 6,851 SCD cases were identified, of which 3,046 (44.5%) had no history of CVD. Incidence rates of SCD increased with age and were higher in cases with a history of CVD across all age groups. The difference in SCD incidence between individuals with and without a history of CVD decreased with age, with incidence rate ratios ranging from 21.6 (95% CI: 5.2-66.7) in those aged 0 to 19 years to 1.8 (95% CI: 1.7-1.9) in those aged >90 years. Female sex and living alone were associated with a lower odds of having a CVD before SCD with ORs of 0.66 and 0.75, respectively. CONCLUSIONS: The distribution of SCD cases is nearly equal between individuals with and without a history of CVD, although the risk remains higher in those with prior CVD. Future research should aim to uncover the distinct causes and mechanisms driving SCD in populations with a known CVD, as well as the general population.","author_count":8,"contributors":["Skjelbred, Tobias","Warming, Peder Emil","Krøll, Johanna","Andersen, Mikkel Porsborg","Torp-Pedersen, Christian","Winkel, Bo Gregers","Tfelt-Hansen, Jacob","Lynge, Thomas Hadberg"],"cuid":["S01-000.00-820360"],"filters":{"added":"2025-08","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"sudden cardiac death as first manifestation of cardiovascular disease a nationwide study of 000000000054 000000000028 deaths","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.jacep.2024.12.012","version":"Published Version"},"id":"S01-000.00-820360","identifier":[{"id":"85218862367","type":"scopus"},{"id":"39918459","type":"pmid"}],"ids":["ku-e918a4ae-50bb-4ea2-99e3-8b555b37689f"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-A9F2EF0144527E53087D9479EF5C409E"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/451377490/1-s2.0-S2405500X2401034X-main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.jacep.2024.12.012","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Section of Biostatistics"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Tobias","key":"skjelbredpau","last":"Skjelbred","name":"Skjelbred, Tobias","rank":1,"rolecode":"pau"},{"affno":"1","first":"Peder Emil","key":"warmingpau","last":"Warming","name":"Warming, Peder Emil","rank":2,"rolecode":"pau"},{"affno":"1","first":"Johanna","key":"krøllpau","last":"Krøll","name":"Krøll, Johanna","rank":3,"rolecode":"pau"},{"affno":"1","first":"Mikkel Porsborg","key":"andersenpau","last":"Andersen","name":"Andersen, Mikkel Porsborg","rank":4,"rolecode":"pau"},{"affno":"1 2","first":"Christian","key":"torppedersenpau","last":"Torp-Pedersen","locid":"f71bedc6-3736-4559-b937-6a18e770616e","name":"Torp-Pedersen, Christian","rank":5,"rolecode":"pau"},{"affno":"1","first":"Bo Gregers","key":"winkelpau","last":"Winkel","name":"Winkel, Bo Gregers","rank":6,"rolecode":"pau"},{"affno":"1 2","first":"Jacob","key":"tfelthansenpau","last":"Tfelt-Hansen","locid":"bdd29054-7062-428a-a97d-e32cb8d80d38","name":"Tfelt-Hansen, Jacob","orcid":"0000-0003-3895-9316","rank":7,"rolecode":"pau"},{"affno":"1","first":"Thomas Hadberg","key":"lyngepau","last":"Lynge","name":"Lynge, Thomas Hadberg","rank":8,"rolecode":"pau"}],"pmid":["39918459"],"pub":{"doi":"10.1016/j.jacep.2024.12.012","issn":["2405500X"],"issn_org":["24055018"],"issue":"5","journal":"JACC: Clinical Electrophysiology","pages":"881-890","status":"p","title":"JACC: Clinical Electrophysiology","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-85218862367"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-e918a4ae-50bb-4ea2-99e3-8b555b37689f"],"src":["KU University of Copenhagen"],"title":"Sudden Cardiac Death as First Manifestation of Cardiovascular Disease : A Nationwide Study of 54,028 Deaths","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-820360","year":"2025","yearsub":"2025"}
{"abstract":"The energetics and dynamics of ion assembly in solution has broad influence in nanomaterials and inorganic synthesis. To investigate the fundamental processes involved, we present a time-resolved x-ray solution scattering (TR-XSS) study of the trinuclear silver and thallium complexes of the diplatinum ion PtPOP [Pt2(H2P2O5) 4 4 − ] in aqueous solution. These complexes, their structural properties, and their electronic structure are not well understood and afford a unique opportunity to study the metal-metal bond formation that influences molecular and material assembly in solution. We present model-independent analysis of the observed dynamics as well as an analysis incorporating time-resolved structural refinements of key bond lengths with <100 fs time resolution. We find that upon photoexcitation, the Pt atoms contract ∼ 0.25 Å toward the center of both the Ag- and the Tl-PtPOP complexes, as previously observed for the PtPOP anion. For the AgPtPOP system, an ultrafast Ag-Pt bond expansion of ∼ 0.2 Å is observed, whereas in contrast, the TlPtPOP system exhibits a Tl-Pt bond contraction of ∼ 0.3 Å upon photoexcitation. For both complexes, the change in electronic state leads to coherent (“wave-packet”) oscillations along the metal-Pt coordinates. Based on these structural dynamics, we propose an electronic structure model that describes the metal-metal bonding behavior in both the ground and excited state for both complexes.","author_count":22,"contributors":["Lenzen, Philipp","Haldrup, Kristoffer","Dohn, Asmus Ougaard","Hansen, Frederik B.","Biasin, Elisa","Christensen, Morten","Hansen, Bianca L.","Harlang, Tobias C. B.","Kjær, Kasper Skov","Laursen, Mads G.","Vester, Peter","van Driel, Tim B.","Chollet, Matthieu","Glownia, James M.","Hartsock, Robert J.","Lemke, Henrik T.","Nelson, Silke","Song, Sanghoon","Pedersen, Kasper Steen","Gaffney, Kelly J.","Møller, Klaus Braagaard","Nielsen, Martin Meedom"],"cuid":["S01-000.00-827522"],"filters":{"added":"2025-10","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Europe, Non-EU","OECD"],"corresponding_author":["Haldrup, Kristoffer"],"country":["Switzerland","United States"],"glorg":["All Global Affiliations","Paul Scherrer Institute","SLAC National Accelerator Laboratory"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"structure and ultrafast dynamics of tri nuclear ag tl pt sub 000000000002 sub pop sub 000000000004 sub complexes in solution","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1063/4.0000293","version":"Published Version"},"id":"S01-000.00-827522","identifier":[{"id":"105010656864","type":"scopus"},{"id":"PMC12263179","type":"pmcid"},{"id":"40666623","type":"pmid"}],"ids":["dtu-411d7c07-6fb9-4635-bda4-c831840c8211"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-F3F4AEEA1B840B2D8CA85175D9B11105"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1063/4.0000293","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/411900373/lenzen.2025.sd.12.044902.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Physics"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"us","key":"slac national accelerator laboratory","loc":["United States","America, North","OECD"],"name":"SLAC National Accelerator Laboratory","us