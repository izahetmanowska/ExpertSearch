ental Institutions","Miscellaneous","Other Research","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-8dcfbba3-02ab-4280-9725-ec8a39e09d2b"],"src":["DTU Technical University of Denmark"],"title":"Mapping of seabed habitats and impacts of beam trawling and other demersal fisheries for spatial ecosystem-based management of the Jammer Bay (JAMBAY Executive Report)","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-775697","year":"2024","yearsub":"2024"}
{"abstract":"Negativity bias is a cognitive bias that results in negative events being perceptually more salient than positive ones. For hearing care, this means that hearing aid benefits can potentially be overshadowed by adverse experiences. Research has shown that sustaining focus on positive experiences has the potential to mitigate negativity bias. The purpose of the current study was to investigate whether a positive focus (PF) intervention can improve speech-in-noise abilities for experienced hearing aid users. Thirty participants were randomly allocated to a control or PF group (N = 2 × 15). Prior to hearing aid fitting, all participants filled out the short form of the Speech, Spatial and Qualities of Hearing scale (SSQ12) based on their own hearing aids. At the first visit, they were fitted with study hearing aids, and speech-in-noise testing was performed. Both groups then wore the study hearing aids for two weeks and sent daily text messages reporting hours of hearing aid use to an experimenter. In addition, the PF group was instructed to focus on positive listening experiences and to also report them in the daily text messages. After the 2-week trial, all participants filled out the SSQ12 questionnaire based on the study hearing aids and completed the speech-in-noise testing again. Speech-in-noise performance and SSQ12 Qualities score were improved for the PF group but not for the control group. This finding indicates that the PF intervention can improve subjective and objective hearing aid benefits.","author_count":4,"contributors":["Lelic, Dina","Nielsen, Line Louise Aaberg","Pedersen, Anja Kofoed","Neher, Tobias"],"cuid":["S01-000.00-740524"],"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Lelic, Dina"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-PR-OTH","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"focusing on positive listening experiences improves speech intelligibility in experienced hearing aid users","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1177/23312165241246616","version":"Published Version"},"id":"S01-000.00-740524","identifier":[{"id":"85191365328","type":"scopus"},{"id":"38656770","type":"pmid"},{"id":"PMC11044800","type":"pmcid"}],"ids":["sdu-3a70890a-9b4b-45c5-8b9d-904ecd9554c3"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-C0450424720B5C00D206D4671252E7B7"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/259628510/Lelic_et_al_TiH2024.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1177/23312165241246616","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["WS Audiology A/S"],"nora_code":"DI-PR-OTH","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Dina","key":"lelicpau","last":"Lelic","name":"Lelic, Dina","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Line Louise Aaberg","key":"nielsenoth","last":"Nielsen","locid":"5a8208bc-1931-418d-81ca-c8764bb5c8c4","name":"Nielsen, Line Louise Aaberg","rank":2,"role":"Other","rolecode":"oth"},{"affno":"1","corresponding":null,"first":"Anja Kofoed","key":"pedersenoth","last":"Pedersen","name":"Pedersen, Anja Kofoed","rank":3,"role":"Other","rolecode":"oth"},{"affno":"2","corresponding":null,"first":"Tobias","key":"neheroth","last":"Neher","locid":"64d1ab37-25d0-4a4b-94d9-59d868d830db","name":"Neher, Tobias","orcid":"0000-0002-1107-9274","rank":4,"role":"Other","rolecode":"oth"}],"pmid":["38656770"],"pub":{"doi":"10.1177/23312165241246616","issn":["23312165"],"journal":"Trends in Hearing","pages":"1-12","publisher":"SAGE Publications","status":"p","title":"Trends in Hearing","volume":"28"},"review":"Peer Reviewed","scoID":["2-s2.0-85191365328"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Other Companies","Private Research","Universities","University of Southern Denmark","ws audiology a/s"],"PST":["Published"]},"sid":["sdu-3a70890a-9b4b-45c5-8b9d-904ecd9554c3"],"src":["SDU University of Southern Denmark"],"title":"Focusing on Positive Listening Experiences Improves Speech Intelligibility in Experienced Hearing Aid Users","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-740524","year":"2024","yearsub":"2024"}
{"abstract":"Fungal polyketides are a large group of secondary metabolites, valuable due to their diverse spectrum of pharmacological activities. Polyketide biosynthesis in filamentous fungi presents some challenges: small yield and low-purity titers. To tackle these issues, we switched to the yeast Yarrowia lipolytica, an easily cultivable heterologous host. As an oleaginous yeast, Y. lipolytica displays a high flux of acetyl- and malonyl-CoA precursors used in lipid synthesis. Likewise, acetyl- and malonyl-CoA are the building blocks of many natural polyketides, and we explored the possibility of redirecting this flux toward polyketide production. Despite its promising prospect, Y. lipolytica has so far only been used for heterologous expression of simple type III polyketide synthases (PKSs) from plants. Therefore, we decided to evaluate the potential of Y. lipolytica by targeting the more complex fungal polyketides synthesized by type I PKSs. We employed a CRISPR-Cas9-mediated genome editing method to achieve markerless gene integration of the genes responsible for bostrycoidin biosynthesis in Fusarium solani (fsr1, fsr2, and fsr3) and 6-methylsalicylic acid (6-MSA) biosynthesis in Aspergillus hancockii (6MSAS). Moreover, we attempted titer optimization through metabolic engineering by overexpressing two enzymes, TGL4 and AOX2, involved in lipid β-oxidation, but we did not observe an effect on polyketide production. With maximum titers of 403 mg/L 6-MSA and 35 mg/L bostrycoidin, the latter being substantially higher than our previous results in Saccharomyces cerevisiae (2.2 mg/L), this work demonstrates the potential of Y. lipolytica as a platform for heterologous production of complex fungal polyketides.","author_count":11,"contributors":["Bejenari, Mihaela","Spedtsberg, Eva Mie Lang","Mathiesen, Julie","Jeppesen, Alexandra Claire","Cernat, Lucia","Toussaint, Aouregane","Apostol, Cristina","Stoianov, Victor","Pedersen, Tobias Bruun","Nielsen, Mikkel Rank","Sørensen, Jens Laurids"],"cuid":["S01-000.00-743223"],"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"corresponding_author":["Bejenari, Mihaela","Sørensen, Jens Laurids"],"country":["France"],"glorg":["All Global Affiliations","Université Grenoble Alpes"],"keyword":["6 MSA","Fusarium","Fusarubin","Heterologous production","Pigment","Yarrowia lipolytica","Yeast","polyketide synthase PKS"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"first class biosynthesis of 000000000006 msa and bostrycoidin type i polyketides in yarrowia lipolytica","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.3389/ffunb.2024.1327777","version":"Published Version"},"id":"S01-000.00-743223","identifier":[{"id":"85189607126","type":"scopus"}],"ids":["aau-c16f8184-dc35-4794-bb9f-03554f5618da"],"keyword":["6-MSA","Fusarium","Yarrowia lipolytica","fusarubin","heterologous production","pigment","polyketide synthase (PKS)","yeast"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-7511B6202B9FC5D706C0EF825FD128FD"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.3389/ffunb.2024.1327777","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/767311938/ffunb-05-1327777.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience, Section of Chemical and Bioengineering"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"fr","key":"université grenoble alpes","loc":["France","Europe, EU","OECD"],"name":"Université Grenoble Alpes","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Mihaela","key":"bejenaripau","last":"Bejenari","locid":"3d63793c-c26d-4fe2-b045-bb831383086e","name":"Bejenari, Mihaela","orcid":"0000-0001-9894-8817","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Eva Mie Lang","key":"spedtsbergpau","last":"Spedtsberg","locid":"83156594-c537-465d-a8bc-473cc1c66d18","name":"Spedtsberg, Eva Mie Lang","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Julie","key":"mathiesenpau","last":"Mathiesen","locid":"d09f0ff0-6f44-489c-81fe-19dcb2f88f8f","name":"Mathiesen, Julie","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Alexandra Claire","key":"jeppesenpau","last":"Jeppesen","name":"Jeppesen, Alexandra Claire","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lucia","key":"cernatpau","last":"Cernat","name":"Cernat, Lucia","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Aouregane","key":"toussaintpau","last":"Toussaint","name":"Toussaint, Aouregane","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Cristina","key":"apostolpau","last":"Apostol","locid":"d48fcbd1-3c97-400a-b050-bd6bb164655c","name":"Apostol, Cristina","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Victor","key":"stoianovpau","last":"Stoianov","locid":"22879582-7089-4c88-b189-734cafead041","name":"Stoianov, Victor","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Tobias Bruun","key":"pedersenpau","last":"Pedersen","locid":"bc73daa2-870d-4de9-bf18-bd8a23efc501","name":"Pedersen, Tobias Bruun","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mikkel Rank","key":"nielsenpau","last":"Nielsen","locid":"1f966c21-5cb9-4909-9f4c-d694ffd9becc","name":"Nielsen, Mikkel Rank","orcid":"0000-0003-2408-9444","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens Laurids","key":"sørensenpau","last":"Sørensen","locid":"365188dd-0cdc-4c71-a590-2ccd261ae3df","name":"Sørensen, Jens Laurids","orcid":"0000-0002-2392-5343","rank":11,"rolecode":"pau"}],"pub":{"doi":"10.3389/ffunb.2024.1327777","issn":["26736128"],"journal":"Frontiers in Fungal Biology","paperid":"1327777","publisher":"Frontiers","status":"p","title":"Frontiers in Fungal Biology","volume":"5"},"review":"Peer Reviewed","scoID":["2-s2.0-85189607126"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-c16f8184-dc35-4794-bb9f-03554f5618da"],"src":["AAU Aalborg University"],"title":"First-class – biosynthesis of 6-MSA and bostrycoidin type I polyketides in Yarrowia lipolytica","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-743223","year":"2024","yearsub":"2024"}
{"abstract":"The rhythmic pumping motion of the heart stands as a cornerstone in life, as it circulates blood to the entire human body through a series of carefully timed contractions of the individual chambers. Changes in the size, shape and movement of the chambers can be important markers for cardiac disease and modeling this in relation to clinical demography or disease is therefore of interest. Existing methods for spatio-temporal modeling of the human heart require shape correspondence over time or suffer from large memory requirements, making it difficult to use for complex anatomies. We introduce a novel conditional generative model, where the shape and movement is modeled implicitly in the form of a spatio-temporal neural distance field and conditioned on clinical demography. The model is based on an auto-decoder architecture and aims to disentangle the individual variations from that related to the clinical demography. It is tested on the left atrium (including the left atrial appendage), where it outperforms current state-of-the-art methods for anatomical sequence completion and generates synthetic sequences that realistically mimics the shape and motion of the real left atrium. In practice, this means we can infer functional measurements from a static image, generate synthetic populations with specified demography or disease and investigate how non-imaging clinical data effect the shape and motion of cardiac anatomies.","author_count":11,"contributors":["Juhl, Kristine Aavild","Lopez Diez, Paula","Margeta, Jan","El Youssef, Yasmin","Pham, Michael","Pedersen, Jonas Jalili","Kuhl, Tobias","de Backer, Ole","Kofoed, Klaus","Camara, Oscar","Paulsen, Rasmus Reinhold"],"cuid":["S01-000.00-775855"],"event":{"end":"2024-10-10","place":"Marrakesh, ma","start":"2024-10-06","title":"27th International Conference on Medical Image Computing and Computer-Assisted Intervention, MICCAI 2024","year":"2024"},"filters":{"added":"2025-01","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"corresponding_author":["Juhl, Kristine Aavild"],"country":["Slovakia","Spain"],"glorg":["All Global Affiliations","KardioMe","Pompeu Fabra University"],"keyword":["Cardiac anatomy"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-ZEA"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-HO-CAP","DI-HO-ZEA","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"spatio temporal neural distance fields for conditional generative modeling of the heart","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/105004637344","version":"Other Version"},"id":"S01-000.00-775855","identifier":[{"id":"001342227700040","type":"wos"},{"id":"105004637344","type":"scopus"}],"ids":["dtu-a9319aca-1eff-44ca-af9b-8b7d7abba883"],"keyword":["Cardiac Anatomy","Multi-Modal Inputs","Neural Implicit Functions","Spatio-Temporal Representations"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-D14FB7C1DC88B6902AF592E504D3FD7D"],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Applied Mathematics and Computer Science","Technical University of Denmark, Department of Applied Mathematics and Computer Science, Visual Computing"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"sk","key":"kardiome","loc":["Slovakia","Europe, EU","OECD"],"name":"KardioMe","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"4","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Zealand University Hospital Roskilde"],"nora_code":"DI-HO-ZEA","used":1},{"affno":"5","country":"es","key":"pompeu fabra university","loc":["Spain","Europe, EU","OECD"],"name":"Pompeu Fabra University","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Kristine","key":"sørensenpau","last":"Sørensen","locid":"e4ab47aa-265e-4f63-aad8-957595b57ebe","name":"Juhl, Kristine Aavild","name_org":"Sørensen, Kristine","orcid":"0000-0003-1434-697X","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Paula","key":"diezpau","last":"Diez","locid":"d78ebe66-68ad-4155-b186-9b196fdb6b8f","name":"Lopez Diez, Paula","name_org":"Diez, Paula","orcid":"0000-0002-9346-743X","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jan","key":"margetapau","last":"Margeta","name":"Margeta, Jan","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Yasmin","key":"elyoussefpau","last":"El Youssef","name":"El Youssef, Yasmin","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Michael","key":"phampau","last":"Pham","name":"Pham, Michael","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jonas Jalili","key":"pedersenpau","last":"Pedersen","name":"Pedersen, Jonas Jalili","rank":6,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Tobias","key":"kuhlpau","last":"Kuhl","name":"Kuhl, Tobias","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Ole","key":"debackerpau","last":"de Backer","name":"de Backer, Ole","rank":8,"ro