:20,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Klaus B.","key":"møllerpau","last":"Møller","locid":"d9bee016-ac55-4515-bf7c-1a19f46f37d3","name":"Møller, Klaus Braagaard","name_org":"Møller, Klaus B.","orcid":"0000-0002-9797-7437","rank":21,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Martin M.","key":"nielsenpau","last":"Nielsen","locid":"0ed9b9ec-6759-42b2-82fb-0b5286c2069c","name":"Nielsen, Martin Meedom","name_org":"Nielsen, Martin M.","orcid":"0000-0002-8135-434X","rank":22,"rolecode":"pau"}],"pmid":["40666623"],"pub":{"doi":"10.1063/4.0000293","issn":["23297778"],"issue":"4","journal":"Structural Dynamics","paperid":"044902","publisher":"AAPM - American Association of Physicists in Medicine","status":"p","title":"Structural Dynamics","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-105010656864"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-411d7c07-6fb9-4635-bda4-c831840c8211"],"src":["DTU Technical University of Denmark"],"title":"Structure and ultrafast dynamics of tri-nuclear Ag-/Tl-Pt<sub>2</sub>POP<sub>4</sub> complexes in solution","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-827522","year":"2025","yearsub":"2025"}
{"abstract":"Human activities are affecting marine biodiversity globally by accelerating extinction rates, altering ecosystem conditions and changing community structures. These changes can only be understood through establishing the ecosystem state prior to significant anthropogenic impact and by disentangling the anthropogenic effect from natural climatic changes. Here, we reconstruct marine biodiversity in Iceland across three millennia (1315 BCE–1785 CE), encompassing periods of climatic fluctuation and human settlement, to explore the comparative effect of natural and anthropogenic forces on marine biodiversity. We performed 18S metabarcoding of ancient environmental DNA from two sediment cores collected from northern Icelandic shelf seas, integrating local climatic records, population estimates and zooarchaeological remains from published sources to estimate the influence of climatic and anthropogenic impacts. Against the backdrop of increasing human populations and marine exploitation, we observe no large-scale taxonomic shifts or anthropogenic biodiversity changes across the period. In contrast, we found a positive correlation between herring (Clupea harengus) detection rates and proxy-reconstructed sea surface temperature, suggesting a role for climate in shaping marine biodiversity. Overall, our data suggest that despite impacts on terrestrial ecosystems and the development of a substantial export fishery across the study period, Icelandic society may have had a limited effect on marine biodiversity. This article is part of the theme issue ‘Shifting seas: understanding deep-time human impacts on marine ecosystems’.","author_count":17,"contributors":["Holman, Luke E.","Arfaoui, Emilia M. R.","Pedersen, Lene Bruhn","Farnsworth, Wesley R.","Ascough, Philippa","Butler, Paul","Guðmundsdóttir, Esther R.","Reynolds, Dave J.","Trofimova, Tamara","Wilkin, Jack T. R.","Carøe, Christian","Frøslev, Tobias Guldberg","Harrison, Ramona","Gopalakrishnan, Shyam","Pedersen, Mikkel Winther","Scourse, James","Bohmann, Kristine"],"cuid":["S01-000.00-829170"],"filters":{"added":"2025-10","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, Non-EU","Nordic","OECD"],"country":["Iceland","Norway","United Kingdom"],"glorg":["All Global Affiliations","British Antarctic Survey","University of Bergen","University of Exeter","University of Glasgow","University of Iceland"],"keyword":["Marine biodiversity","Metabarcoding","ancient environmental DNA","sedaDNA"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Global Biodiversity Information Facility"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"ancient environmental dna indicates limited human impact on marine biodiversity in pre industrial iceland","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1098/rstb.2024.0031","version":"Published Version"},"id":"S01-000.00-829170","identifier":[{"id":"40635440","type":"pmid"},{"id":"PMC12242299","type":"pmcid"},{"id":"105010706152","type":"scopus"}],"ids":["ku-767d6e69-43e0-4b3b-8a51-cbbae6a19488"],"keyword":["ancient environmental DNA","anthropgenic impact","marine biodiversity","metabarcoding","prehistoric marine biodiversity","preindustrial Iceland","sedaDNA"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-5989AA2C3693FA6B45130AD233B50A9F"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/459707821/holman-et-al-ancient-environmental-dna-indicates-limited-human-impact-on-marine-biodiversity-in-pre-industrial-iceland.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1098/rstb.2024.0031","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Globe Institute, Section for Molecular Ecology and Evolution"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"is","key":"university of iceland","loc":["Iceland","Europe, Non-EU","Nordic","OECD"],"name":"University of Iceland","used":1},{"affno":"3","country":"gb","key":"university of glasgow","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Glasgow","used":1},{"affno":"4","country":"gb","key":"university of exeter","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Exeter","used":1},{"affno":"5","country":"gb","key":"british antarctic survey","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"British Antarctic Survey","used":1},{"affno":"6","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Global Biodiversity Information Facility"],"nora_code":"DI-OT","used":1},{"affno":"7","country":"no","key":"university of bergen","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"University of Bergen","used":1}],"person":[{"affno":"1","first":"Luke E.","key":"holmanlukeepau","last":"Holman","locid":"3db32346-c1f0-42d1-8096-429497de5235","name":"Holman, Luke E.","orcid":"0000-0002-8139-3760","rank":1,"rolecode":"pau"},{"affno":"1","first":"Emilia M. R.","key":"arfaouiemiliamrpau","last":"Arfaoui","locid":"d386a1f8-acc2-4895-9968-90875688f7e4","name":"Arfaoui, Emilia M. R.","rank":2,"rolecode":"pau"},{"affno":"1","first":"Lene Bruhn","key":"pedersenlenebruhnpau","last":"Pedersen","locid":"2aaa32e9-09e5-49b8-9c59-67cdaef43a21","name":"Pedersen, Lene Bruhn","rank":3,"rolecode":"pau"},{"affno":"1 2","first":"Wesley R.","key":"farnsworthwesleyrpau","last":"Farnsworth","locid":"08c6a4b7-8322-4399-959c-fdc158709126","name":"Farnsworth, Wesley R.","orcid":"0000-0001-7375-2228","rank":4,"rolecode":"pau"},{"affno":"3","first":"Philippa","key":"ascoughphilippapau","last":"Ascough","name":"Ascough, Philippa","rank":5,"rolecode":"pau"},{"affno":"4","first":"Paul","key":"butlerpaulpau","last":"Butler","name":"Butler, Paul","rank":6,"rolecode":"pau"},{"affno":"2","first":"Esther R.","key":"guðmundsdóttirestherrpau","last":"Guðmundsdóttir","name":"Guðmundsdóttir, Esther R.","rank":7,"rolecode":"pau"},{"affno":"4","first":"Dave J.","key":"reynoldsdavejpau","last":"Reynolds","name":"Reynolds, Dave J.","rank":8,"rolecode":"pau"},{"affno":"4","first":"Tamara","key":"trofimovatamarapau","last":"Trofimova","name":"Trofimova, Tamara","rank":9,"rolecode":"pau"},{"affno":"4 5","first":"Jack T. R.","key":"wilkinjacktrpau","last":"Wilkin","name":"Wilkin, Jack T. R.","rank":10,"rolecode":"pau"},{"affno":"1","first":"Christian","key":"carøechristianpau","last":"Carøe","locid":"ac9e0369-c0ab-4484-a7d3-08d2600928e0","name":"Carøe, Christian","rank":11,"rolecode":"pau"},{"affno":"1 6","first":"Tobias Guldberg","key":"frøslevtobiasguldbergpau","last":"Frøslev","locid":"68c04506-5e2f-4f9a-890d-26d7353651b5","name":"Frøslev, Tobias Guldberg","orcid":"0000-0002-3530-013X","rank":12,"rolecode":"pau"},{"affno":"7","first":"Ramona","key":"harrisonramonapau","last":"Harrison","name":"Harrison, Ramona","rank":13,"rolecode":"pau"},{"affno":"1","first":"Shyam","key":"gopalakrishnanshyampau","last":"Gopalakrishnan","locid":"f7b02a06-8ef7-4e56-b209-7fccee0a41b9","name":"Gopalakrishnan, Shyam","orcid":"0000-0002-2004-6810","rank":14,"rolecode":"pau"},{"affno":"1","first":"Mikkel Winther","key":"pedersenmikkelwintherpau","last":"Pedersen","locid":"00dc1d3b-57e9-4290-a60f-4ad7f2ad9620","name":"Pedersen, Mikkel Winther","orcid":"0000-0002-7291-8887","rank":15,"rolecode":"pau"},{"affno":"4","first":"James","key":"scoursejamespau","last":"Scourse","name":"Scourse, James","rank":16,"rolecode":"pau"},{"affno":"1","first":"Kristine","key":"bohmannkristinepau","last":"Bohmann","locid":"ecc7d9ed-83f8-43de-958d-cdf4c8384918","name":"Bohmann, Kristine","orcid":"0000-0001-7907-064X","rank":17,"rolecode":"pau"}],"pmid":["40635440"],"pub":{"doi":"10.1098/rstb.2024.0031","issn":["09628436","14712970"],"issn_org":["09628436"],"issue":"1930","journal":"Philosophical Transactions of the Royal Society B: Biological Sciences","paperid":"20240031","status":"p","title":"Philosophical Transactions of the Royal Society B: Biological Sciences","volume":"380"},"review":"Peer Reviewed","scoID":["2-s2.0-105010706152"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-767d6e69-43e0-4b3b-8a51-cbbae6a19488"],"src":["KU University of Copenhagen"],"title":"Ancient environmental DNA indicates limited human impact on marine biodiversity in pre-industrial Iceland","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-829170","year":"2025","yearsub":"2025"}
{"abstract":"Objective Ultrasound-guided fine-needle aspiration biopsy (FNAB) is essential for evaluating thyroid nodules but often yields inadequate samples, leading to repeated procedures, increased discomfort, and higher costs. Previous non-randomized studies found promising results of spinal needles to improve diagnostic adequacy. Therefore, we conducted a multicenter randomized controlled trial to validate these findings. Methods Between July 1st, 2021, and April 13th, 2023, patients with suspicious thyroid nodules were randomized to receive FNAB with either a 25G spinal needle or conventional needle. The primary outcome was the rate of adequate diagnostic cytology. Secondary outcomes included procedure-related pain, sensitivity and specificity of FNAB, and adverse events. Results A total of 359 patients (75.6% female), with a mean age of 59.7 years (range 23−94) were randomized. The rate of adequate diagnostic FNAB was 86.2% (156/181) for the spinal group compared to 84.8% (151/178) for the control group (OR 1.01; 95% CI: 0.95–1.08). The mean pain scale score was 4.0 (SD=1.8) in the spinal group and 3.9 (SD=2.0) in the control group (p=0.40). No complications were observed in either group. We found a significantly better cytological adequacy rate of FNABs performed by physicians with more than four years of experience in the procedure (OR=1.07; 95% CI, 1.01–1.14). Conclusions No significant improvement was found using spinal needles with a stylet compared to conventional needles. Given the significantly higher cost of spinal needles and comparable diagnostic outcomes, their routine use for thyroid FNAB is not recommended.","author_count":18,"contributors":["Larsen, Kasper Daugaard","Hvilsom, Gitte Bjørn","Andersen, Tobias Vennervald","Homøe, Preben","Bennedbæk, Finn Noe","Pedersen, Jens","Sigurd, Lena Bjergved","Warm, Jens Jessen","Kiss, Katalin","Lelkaitis, Giedrius","Andersen, Luise","Rosenørn, Marie Røsland","Hegedüs, Laszlo","Ersbøll, Annette Kjær","Lomholt, Anne Fog","Kaltoft, Mikkel","Hahn, Christoffer Holst","Todsen, Tobias"],"cuid":["S02-087.94-823064"],"filters":{"added":"2025-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Larsen, Kasper Daugaard"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-ZEA"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-ZEA","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"spinal needles versus conventional needles for fine needle aspiration biopsy of thyroid nodules a multicenter randomized controlled trial","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pone.0321043","version":"Published Version"},"id":"S02-087.94-823064","identifier":[{"id":"PMC12312885","type":"pmcid"},{"id":"40743258","type":"pmid"},{"id":"105012247682","type":"scopus"}],"ids":["ku-f67d455d-019e-4401-a226-7d64c2d08a68","sdu-73cb475e-3f88-4a1a-9c8b-776eeacd75a4"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-E53D6240EC136B54F15321F5051736C8"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pone.0321043","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/462185909/journal.pone.0321043.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/294591937/journal.pone.0321043.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Zealand University Hospital - Køge"],"nora_code":"DI-HO-ZEA","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Otorhinolaryngology"],"nora_code":"DI-U-KU","used":1},{"affno":"4","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Endocrinology (Odense)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1 2","first":"Kasper Daugaard","key":"larsenkasperdaugaardpau","last":"Larsen","name":"Larsen, Kasper Daugaard","rank":1,"rolecode":"pau"},{"affno":"2 3","first":"Gitte Bjørn","key":"hvilsomgittebjørnpau","last":"Hvilsom","locid":"b2c8c01d-97bd-4655-8917-3c023f8016ca","name":"Hvilsom, Gitte Bjørn","rank":2,"rolecode":"pau"},{"affno":"2","first":"Tobias Vennervald","key":"andersentobiasvennervaldpau","last":"Andersen","name":"Andersen, Tobias Vennervald","rank":3,"rolecode":"p