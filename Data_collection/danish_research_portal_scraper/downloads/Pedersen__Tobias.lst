{"abstract":"Manikæernes forestilling om, at den højeste gud er skjult bag et slør indtil den yderste dag, hvor han fjerner det og åbenbarer sit åsyn, har formodentlig sin baggrund i jødedommen","author_count":5,"contributors":["Pedersen, Nils Arne"],"cuid":["S01-000.00-211216"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Judaism","Manichaeism","Revelation"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"the veil and revelation of the father of greatness","src":["au"],"src-code":["DI-U-AU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84947782726","version":"Other Version"},"id":"S01-000.00-211216","identifier":[{"id":"84947782726","type":"scopus"}],"ids":["au-8f8c25ec-c851-4d56-b6c7-1a5155798cfd"],"keyword":["Father of Greatness","Judaism","Manichaeism","revelation","veil"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-2-CA5C8A698D04A812281470618B6BF95E"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus University, Faculty of Theology, Section for Church History and Practical Theology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Nils Arne","key":"pedersenpau","last":"Pedersen","locid":"b23ff2aa-fc4a-48fe-9410-549158155a25","name":"Pedersen, Nils Arne","orcid":"0000-0001-9795-2072","rank":1,"rolecode":"pau"},{"affno":"","first":"Jacob Albert","key":"vandenbergpedh","last":"van den Berg","name":"van den Berg, Jacob Albert","rank":2,"role":"Editor 