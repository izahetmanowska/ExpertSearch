Tobias","key":"piechowiakpau","last":"Piechowiak","name":"Piechowiak, Tobias","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Ole","key":"haupau","last":"Hau","name":"Hau, Ole","rank":5,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Michael Syskind","key":"pedersenpau","last":"Pedersen","name":"Pedersen, Michael Syskind","rank":6,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Michael","key":"syskindpedersenpau","last":"Syskind Pedersen","name":"Syskind Pedersen, Michael","rank":6,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Thomas","key":"behrenspau","last":"Behrens","name":"Behrens, Thomas","rank":7,"rolecode":"pau"},{"affno":"5","corresponding":null,"country":"dk","first":"Tobias","key":"neherpau","last":"Neher","locid":"64d1ab37-25d0-4a4b-94d9-59d868d830db","name":"Neher, Tobias","orcid":"0000-0002-1107-9274","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Torsten","key":"daupau","last":"Dau","locid":"0940a14b-381a-4059-9ce2-7c0888e9c1a8","name":"Dau, Torsten","orcid":"0000-0001-8110-4343","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sébastien","key":"santurettepau","last":"Santurette","locid":"8089b63b-7bba-49fc-ae22-1dfc3fd17e87","name":"Santurette, Sébastien","orcid":"0000-0002-6868-5734","rank":10,"rolecode":"pau"}],"pub":{"issn":["22265147"],"pages":"381-388","publisher":"European Acoustics Association","series":"Euronoise","status":"p","title":"Proceedings of Euronoise 2018"},"review":"Peer Reviewed","sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Private Research","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Hospitals","Other Companies","Oticon A/S","Private Research","Technical University of Denmark","Universities","University of Southern Denmark","gn hearing a/s","gn hearing danmark a/s"],"PST":["Published"]},"sid":["dtu-bd792353-2350-4dfe-b702-e10cd45b0eee","sdu-792dfc34-036b-4344-9319-41ab74febac0"],"src":["DTU Technical University of Denmark","SDU University of Southern Denmark"],"title":"Technical evaluation of hearing-aid fitting parameters for different auditory profiles","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-085.00-036887","year":"2018","yearsub":"2018"}
{"abstract":"While psychotic experiences (PEs) are assumed to represent psychosis liability, general population studies have not been able to establish significant associations between polygenic risk scores (PRS) and PEs. Previous work suggests that PEs may only represent significant risk when accompanied by social impairment. Leveraging data from the large longitudinal IMAGEN cohort, including 2096 14-year old adolescents that were followed-up to age 18, we tested whether the association between polygenic risk and PEs is mediated by (increasing) impairments in social functioning and social cognitive processes. Using structural equation modeling (SEM) for the subset of participants (n = 643) with complete baseline and follow-up data, we examined pathways to PEs. We found that high polygenic risk for schizophrenia (p = 0.014), reduced brain activity to emotional stimuli (p = 0.009) and social impairments in late adolescence (p < 0.001; controlling for functioning in early adolescence) each independently contributed to the severity of PEs at age 18. The pathway between polygenic risk for autism spectrum disorder and PEs was mediated by social impairments in late adolescence (indirect pathway; p = 0.025). These findings point to multiple direct and indirect pathways to PEs, suggesting that different processes are in play, depending on genetic loading, and environment. Our results suggest that treatments targeting prevention of social impairment may be particularly promising for individuals at genetic risk for autism in order to minimize risk for psychosis.","author_count":46,"contributors":["Velthorst, Eva","Froudist-Walsh, Sean","Stahl, Eli","Ruderfer, Douglas","Ivanov, Ilyan","Buxbaum, Joseph","Banaschewski, Tobias","Bokde, Arun L.W.","Bromberg, Uli","Büchel, Christian","Burke Quinlan, Erin","Desrivières, Sylvane","Flor, Herta","Frouin, Vincent","Garavan, Hugh","Gowland, Penny","Heinz, Andreas","Ittermann, Bernd","Paillère Martinot, Marie Laure","Artiges, Eric","Nees, Frauke","Papadopoulos Orfanos, Dimitri","Paus, Tomáš","Poustka, Luise","Hohmann, Sarah","Fröhner, Juliane H.","Smolka, Michael N.","Walter, Henrik","Whelan, Robert","Schumann, Gunter","Reichenberg, Abraham","Børglum, Anders D.","Grove, Jakob","Mattheisen, Manuel","Werge, Thomas","Mortensen, Preben Bo","Pedersen, Marianne Giørtz","Pedersen, Carsten Bøcker","Mors, Ole","Nordentoft, Merete","Hougaard, David M.","Bybjerg-Grauholm, Jonas","Bækvad-Hansen, Marie","Hansen, Christine Søholm","Daly, Mark J.","Neale, Benjamin M.","Robinson, Elise B.","Cerrato, Felecia","Dumont, Ashley","Goldstein, Jacqueline"],"cuid":["S02-087.60-024580"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","Europe, EU","Europe, Non-EU","OECD"],"corpau":["iPSYCH-Broad ASD Group, the IMAGEN consortium","iPSYCH-Broad ASD Group, the IMAGEN consortium, Preben Bo Mortensen, Jakob Grove (members of -)"],"country":["Austria","Canada","France","Germany","Ireland","United Kingdom","United States"],"glorg":["All Global Affiliations","Charité – Universitätsmedizin Berlin","Dresden University of Technology","Harvard University","Heidelberg University ","Icahn School of Medicine at Mount Sinai","Medical Research Council","Medical University of Vienna","New York University","Orsay Hospital","Paris-Cité University","Paris-Saclay University","Physikalisch-Technische Bundesanstalt","Trinity College Dublin","University of Göttingen","University of Hamburg","University of Mannheim","University of Nottingham","University of Toronto","University of Vermont","Vanderbilt University"],"keyword":["Adolescent","Autism Spectrum Disorder complications","Brain physiopathology","Female","Genetic Predisposition to Disease","Humans","Male","Multifactorial Inheritance","Psychotic Disorders complications","Risk Factors","Schizophrenia complications","Schizophrenic Psychology","Social Behavior"],"level":"sci","mra":["med","soc