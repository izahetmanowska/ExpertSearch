id":"994945e4-c86b-4440-b9bd-8117822c77db","name":"Pedersen, Christian Marcus","orcid":"0000-0003-4661-4895","rank":3,"rolecode":"pau"},{"affno":"1","first":"Mikael","key":"bolspau","last":"Bols","locid":"23a8a20e-b9f1-4bf5-ae25-3377249ae440","name":"Bols, Mikael","orcid":"0000-0002-6561-6952","rank":4,"rolecode":"pau"}],"pmid":["23109259"],"pub":{"doi":"10.1002/anie.201206880","issn":["14337851","15213773"],"issn_org":["14337851"],"issue":"49","journal":"Angewandte Chemie International Edition","pages":"12285-12288","status":"p","title":"Angewandte Chemie International Edition","volume":"51"},"review":"Peer Reviewed","scoID":["2-s2.0-84870525100"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-f2a53603-fcd9-41aa-92a6-35d825482cb9"],"src":["KU University of Copenhagen"],"title":"Easy access to L-Mannosides and L-Galactosides by using C-H activation of the corresponding 6-Deoxysugars","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-538260","year":"2012","yearsub":"2012"}
{"abstract":"Using two-photon luminescence (TPL) microscopy and local reflection spectroscopy we investigate electromagnetic field enhancement effects from a mu m-sized composition of 450-nm-deep V-grooves milled by focused ion beam in a thick gold film and assembled to feature, within the same structure, individual V-grooves as well as one- and two-dimensional 300-nm-period arrays of, respectively, parallel and crossed V-grooves. We analyze TPL signal levels obtained at different spatial locations and with different combinations of excitation and detection polarizations, discovering that the TPL emitted from the V-grooves is polarized in the direction perpendicular to that of the V-grooves. This feature implies that the TPL occurs solely in the form of (p-polarized) surface plasmon modes and originates therefore from the very bottom of V-grooves, where no photonic modes exist. Implications of the results obtained to evaluation of local field enhancements using TPL microscopy, especially when investigating extended structures exhibiting different radiation channels, are discussed.","author_count":8,"contributors":["Beermann, Jonas","Novikov, Sergey M.","Stær, Tobias Holmgaard","Eriksen, René L.","Albrektsen, Ole","Pedersen, Kjeld","Bozhevolnyi, Sergey I."],"cuid":["S02-097.86-004568"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-AAU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"polarization resolved two photon luminescence microscopy of v groove arrays","src":["aau","sdu"],"src-code":["DI-U-AAU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1364/OE.20.000654","version":"Published Version"},"id":"S02-097.86-004568","identifier":[{"id":"84855444570","type":"scopus"},{"id":"WOS:000300082100083","type":"wos"}],"ids":["aau-5e362c2c-2913-422f-8f17-2edb0042a9c4","sdu-a2d18eb2-9907-4ad0-8d0a-7f485ae1b147"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-4770DD8DA250B48F5FE5E84449368DF2"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1364/OE.20.000654","version":"Published Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Engineering, Department of Technology and Innovation"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (ENG)","Aalborg University, The Faculty of Engineering and Science, Department of Physics and Nanotechnology"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"J.","key":"beermannpau","last":"Beermann","locid":"da4d107b-a5da-429d-ba3b-850b08b96322","name":"Beermann, Jonas","name_org":"Beermann, J.","orcid":"0000-0001-9809-2430","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"S. M.","key":"novikovpau","last":"Novikov","locid":"9fd19426-bd72-4038-8a2e-32aa0157215f","name":"Novikov, Sergey M.","name_org":"Novikov, S. M.","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Tobias Holmgaard","key":"stærpau","last":"Stær","locid":"f9c73bfe-cf15-440a-9aca-290bb9e2f2a5","name":"Stær, Tobias Holmgaard","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"T.","key":"holmgaardpau","last":"Holmgaard","name":"Holmgaard, T.","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"R. L.","key":"eriksenpau","last":"Eriksen","locid":"b3e301d7-bbe7-448f-bb53-09968ed57b02","name":"Eriksen, René Lynge","name_org":"Eriksen, R. L.","orcid":"0000-0003-4405-5831","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"O.","key":"albrektsenpau","last":"Albrektsen","locid":"e5131670-9f40-49d6-97a0-a8da6817bd3c","name":"Albrektsen, Ole","name_org":"Albrektsen, O.","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Kjeld","key":"pedersenpau","last":"Pedersen","locid":"ff5fc0ab-1fa1-47a2-916c-8b7556f2f938","name":"Pedersen, Kjeld","orcid":"0000-0002-6835-1566","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"S. I.","key":"bozhevolnyipau","last":"Bozhevolnyi","locid":"9df17db0-2e69-41ff-8a38-8738093f0385","name":"Bozhevolnyi, Sergey I.","name_org":"Bozhevolnyi, S. I.","orcid":"0000-0002-0393-4859","rank":7,"rolecode":"pau"}],"pub":{"doi":"10.1364/oe.20.000654","issn":["10944087"],"issue":"1","journal":"Optics Express","pages":"654-662","publisher":"Optica Publishing Group","status":"p","title":"Optics Express","volume":"20"},"review":"Peer Reviewed","scoID":["2-s2.0-84855444570"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-5e362c2c-2913-422f-8f17-2edb0042a9c4","sdu-a2d18eb2-9907-4ad0-8d0a-7f485ae1b147"],"src":["AAU Aalborg University","SDU University of Southern Denmark"],"title":"Polarization-resolved two-photon luminescence microscopy of V-groove arrays","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-097.86-004568","year":"2012","yearsub":"2012"}
{"abstract":"OBJECTIVES: The aim of the present study was to determine whether carvedilol-treated chronic heart failure patients have a different prognosis when stratified for a specific combination of a gain-of-function genotype of the adrenergic β-1 receptor gene (ADRB1) (Arg389-homozygous), two gain-of-function genotypes of the angiotensinogen gene (AGT) (Thr174-homozygous and Thr235-homozygous), and a downregulated genotype of the adrenergic β-2 receptor gene (ADRB2) (Gln27-carrier). METHODS: Genotyping of 618 patients was carried out using the Sequenoms MassARRAY genotyping system. Outcome was all-cause mortality and statistics were calculated using a multivariable Cox proportional hazards model. Internal validation was performed using the bootstrap procedure. RESULTS: Eighty-seven of the 618 patients included in the study were treated with carvedilol. There was a significant interaction between the outcome of carvedilol treatment and the combination of the gain-of-function ADRB1 genotype (Arg389-homozygous) and the gain-of-function AGT genotype (Thr174-homozygous) (Pinteraction=0.003; hazard ratio 2.19, 95% confidence interval 1.26-3.78, P=0.005). There was also a significant interaction when the downregulated ADRB2 genotype (Gln27-carrier) was added to the ADRB1/AGT combination (Pinteraction=0.0005; hazard ratio 2.67, 95% confidence interval 1.51-4.72, P=0.0007). Two hundred and four patients were treated with metoprolol. There was no interaction between metoprolol treatment and the specific genotype combinations as there was no difference in the overall survival. The validity of the results was supported by the bootstrap procedure. CONCLUSION: We found a doubling of the hazard of mortality in carvedilol-treated patients with the combination of the gain-of-function ADRB1 genotype (Arg389-homozygous), the gain-of-function AGT genotype (Thr174-homozygous), and the downregulated ADRB2 genotype (Gln27-carrier). This might be valuable when stratifying chronic heart failure patients to the right β-blocker therapy.","author_count":11,"contributors":["Petersen, Morten","Andersen, Jon","Jimenez-Solem, Espen","Broedbaek, Kasper","Afzal, Shoaib","Nyegaard, Mette","Børglum, Anders D","Stender, Steen","Torp-Pedersen, Christian Tobias","Køber, Lars Valeur","Poulsen, Henrik"],"cuid":["S02-100.00-019992"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"effect of specific i adrb000000000001 adrb000000000002 agt i genotype combinations on the association between survival and carvedilol treatment in chronic heart failure a substudy of the echos trial","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1097/FPC.0b013e3283540286","version":"Other Version"},"id":"S02-100.00-019992","identifier":[{"id":"22760495","type":"pmid"},{"id":"84866316033","type":"scopus"},{"id":"000309115000001","type":"wos"}],"ids":["au-649d5df3-8ec7-4754-97c7-50f48ee84a2d","ku-8c6d31c0-8ac0-479b-9594-2efe7a240e16"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-015966DD7F9223C38A6EDC17BEE17603"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1097/FPC.0b013e3283540286","version":"Other Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Section of Diagnostic Sciences"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Bispebjerg and Frederiksberg"],"nora_code":"DI-HO-CAP","used":1},{"affno":"4","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus University, Faculty of Health Sciences, Hæmatologisk Afdeling, Aalborg Sygehus","Aarhus University, Health, Department of Biomedicine, Department of Biomedicine - Department of Human Genetics"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Morten","key":"petersenpau","last":"Petersen","locid":"38c3e96b-873b-4908-8a90-25fc84e6e678","name":"Petersen, Morten","rank":1,"rolecode":"pau"},{"affno":"1 2","first":"Jon T.","key":"andersenpau","last":"Andersen","locid":"2fe4a9af-2462-4bba-8df4-2a518ea59342","name":"Andersen, Jon Trærup","name_org":"Andersen, Jon T.","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Espen","key":"jimenezsolempau","last":"Jimenez-Solem","name":"Jimenez-Solem, Espen","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Kasper","key":"broedbaekpau","last":"Broedbaek","name":"Broedbaek, Kasper","rank":4,"rolecode":"pau"},{"affno":"3","first":"Shoaib","key":"afzalpau","last":"Afzal",