filiations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-1ba64499-71e2-4649-ad8a-bec4bf95b785","dtu-598e19df-e977-43d1-80ad-7e824fbaae44","ku-1508b970-e543-4d95-bffa-77de1ce6a1de"],"src":["AU Aarhus University","DTU Technical University of Denmark","KU University of Copenhagen"],"title":"The PLATO mission","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-083.36-822554","year":"2025","yearsub":"2025"}
{"abstract":"BACKGROUND: The burden of Clostridioides difficile as a nosocomial- and community-acquired pathogen has been increasing over the recent decades, including reports of severe outbreaks. Molecular and virulence genotyping are central for the epidemiological surveillance of this pathogen, but need to balance accuracy and rapid turnaround time of the results. While Illumina short-read sequencing has been adopted as the gold standard to investigate C. difficile virulence and transmission routes, little is known about the potential of Nanopore long-read sequencing in this field. The goal of our study was to compare sequencing and assembly quality of 37 C. difficile isolates using Illumina (SPAdes assembled) and Nanopore (Flye and Unicycler assembled) data alone, along with hybrid assemblies obtained with short-read polishing of long reads. RESULTS: Illumina sequencing produced reads with an average quality of 99.68% (Q25), while Nanopore sequencing produced reads reaching an average quality of 96.84% (Q15), showing a tenfold difference in quality. Sequence type (ST) designation from Nanopore assemblies failed to detect ST5, ST7, ST8, ST13 and ST49, while ST designation based on unpolished Nanopore reads using Krocus was successful for all STs. Nanopore sequences exhibited an average of 640 base errors per genome (~ 0.015% substitution rate), which was reflected by the incorrect assignment of over 180 alleles in core genome multilocus sequence typing (cgMLST) analysis. As a result, Nanopore-derived phylogenies were not as accurate as the Illumina reference, and therefore inadequate for precise investigation of transmission events. Both sequencing platforms provided comparable, satisfactory results for the detection of virulence genes tcdA, tcdB, cdtAB and in-frame deletions in tcdC. CONCLUSION: Compared to Illumina, Nanopore has higher error rate, which limits its application for high-resolution epidemiological surveillance. However, the short analysis time, lower cost and more simple procedure combined with correctly identified STs and virulence genes, makes it an alternative when fast and less detailed analyses are preferred.","author_count":10,"contributors":["Bejaoui, Semeh","Nielsen, Sofie Holtsmark","Rasmussen, Astrid","Coia, John","Andersen, Dorte Terp","Pedersen, Tobias Bruun","Møller, Martin Vad","Trunjer Kusk Nielsen, Marc","Frees, Dorte","Persson, Søren"],"cuid":["S01-000.00-802568"],"filters":{"added":"2025-04","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"corresponding_author":["Persson, Søren"],"country":["Switzerland"],"glorg":["All Global Affiliations","ESCMID Study Group for C. difficile (ESGCD)"],"keyword":["Clostridioides difficile","Clostridioides difficile genetics","Data Accuracy","Epidemiological Monitoring","Epidemiological surveillance","Genome Bacterial","Genotyping","High Throughput Nucleotide Sequencing methods","Humans","Illumina","Nanopore Sequencing methods","Nanopores","Oxford Nanopore","Whole genome sequencing WGS"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-GV-SSI","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"comparison of illumina and oxford nanopore sequencing data quality for clostridioides difficile genome analysis and their application for epidemiological surveillance","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1186/s12864-025-11267-9","version":"Published Version"},"id":"S01-000.00-802568","identifier":[{"id":"39885402","type":"pmid"},{"id":"PMC11783910","type":"pmcid"},{"id":"85217357852","type":"scopus"}],"ids":["sdu-97eba8c2-13af-4ac9-a46b-43631caee693"],"keyword":["Clostridioides difficile","Clostridioides difficile/genetics","Clostridium Infections/microbiology","Data Accuracy","Epidemiological Monitoring","Epidemiological surveillance","Genome, Bacterial","Genotyping","High-Throughput Nucleotide Sequencing/methods","Humans","Illumina","Nanopore Sequencing/methods","Nanopores","Oxford Nanopore","Whole genome sequencing (WGS)"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-29E6ED8C05A7E8809BA2E2D43E542775"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/283937362/s12864-025-11267-9.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1186/s12864-025-11267-9","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"ssi statens serum institut","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-SSI","l3nn":"SSI Statens Serum Institut","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SSI Statens Serum Institut","namevar":["Statens Serum Institut"],"nora_code":"DI-GV-SSI","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Regional Health Research","SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Esbjerg and Grindsted Hospital, Research Unit of Clinical Microbiology (Esbjerg)"],"nora_code":"DI-U-SDU","used":1},{"affno"