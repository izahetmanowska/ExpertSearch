:"","corresponding":null,"first":"Michael","key":"pedersenmichaelpau","last":"Pedersen","name":"Pedersen, Michael","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Francesco Annibale","key":"damorefrancescoannibalepau","last":"D'Amore","locid":"6058829c-2b14-40ba-8a01-44b2a132fceb","name":"D'Amore, Francesco Annibale","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lars Møller","key":"pedersenlarsmøllerpau","last":"Pedersen","name":"Pedersen, Lars Møller","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Bo Amdi","key":"jensenboamdipau","last":"Jensen","name":"Jensen, Bo Amdi","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Paw","key":"jensenpawpau","last":"Jensen","locid":"0bac7ab8-e72f-467e-8bf8-faab756dbf21","name":"Jensen, Paw","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Bjarne Bach","key":"pedersenbjarnebachpau","last":"Pedersen","name":"Pedersen, Bjarne Bach","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Michael B.","key":"møllermichaelbpau","last":"Møller","name":"Møller, Michael B.","rank":7,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Ole","key":"gadebergolepau","last":"Gadeberg","name":"Gadeberg, Ole","rank":8,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Steen","key":"ingebergsteenpau","last":"Ingeberg","name":"Ingeberg, Steen","rank":9,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Torben","key":"mouritsandersentorbenpau","last":"Mourits-Andersen","name":"Mourits-Andersen, Torben","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Stanislaw","key":"pulczynskistanislawpau","last":"Pulczynski","locid":"380526f4-e3df-4fea-ae5a-7fde5ab8b8e5","name":"Pulczynski, Stanislaw","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Tobias Wirenfeldt","key":"klausentobiaswirenfeldtpau","last":"Klausen","name":"Klausen, Tobias Wirenfeldt","rank":12,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Peter De Nully","key":"brownpeterdenullypau","last":"Brown","name":"Brown, Peter De Nully","rank":13,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-55b274f0-0481-494b-997f-2ae4eb0b7025"],"src":["AU Aarhus University"],"title":"A new simplified prognostic index with age cut-off of 70 years for patients with diffuse large B-cell lymphoma. A population-based analysis from the Danish Lymphoma Registry, LYFO","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-178203","year":"2012","yearsub":"2012"}
{"abstract":"Introduction: Regenerative potential in humans is very limited. Like other mammals we rely heavily on fibrosis and scar formation in response to injury. On the contrary, urodele amphibians (salamanders and newts) such as the axolotl (Ambystoma mexicanum) are champions of tissue regeneration among vertebrates mastering the ability to replace most tissues in addition to whole limbs, tail, jaw, etc. following damage or amputation. Regeneration in this species is taking place by dedifferentiation of cells to form a collection of stem cells, the regenerative blastema, that proliferate and regenerate lost tissue without scar formation. Modern regenerative medicine seeks way to adopt these capacities to regenerative therapies in humans. Though much effort is put into the development of stem cell therapies, there exists currently no satisfying technique for non-invasive follow up examinations of such therapies. The objective of this study was to non-invasively evaluate regeneration over time in a truly regenerative process, the regeneration of an axolotl limb, employing superparamagnetic iron oxide particles (SPIO) contrast agents for stem cell tracking in MRI. Materials and Methods: Amputation of one hind limb of anaesthetised axolotls was performed to induce a regenerative response. The potential effect on cell viability of two commercially available SPIOs, Resovist (Bayer Schering Pharma, Hydrodynamic diameter 62 nm) and VSOP-C200 (Ferropharm, Hydrodynamic diameter 7 nm) and Resovist in conjugation with the transfection agent poly-L-lysin (PLL) was tested on cultures of axolotl blastema cells from 7 animals in vitro. PicoGreen-DNA quantification following 3 weeks of culturing was performed to quantify cell viability. MRI-tracking of SPIO labelled blastema cells in the regenerating limb of 5 labelled axolotls was tested in vivo against 6 sham-operated animals for 84 days, using a clinically available 1.5 T system (Siemens), with a small radiofrequency loop-coil. Image data was processed by ImageJ and comparison of tissue signal intensity and rate of regeneration was performed using SAS JMP8. Results: SPIO labelling with neither VSOP-C200, Resovist nor Resovist/PLL had any significant effect on blastema cell viability in vitro. Labelled tissue was clearly detectable in vivo 49 days after amputation using MRI (Fig. 1) and a significant decline in signal intensity of labelled limbs versus sham-operated limbs was evident 49 days after amputation, whereafter proliferative activity of labelled stem cells resulted in a dilution of SPIO concentration causing a signal loss (Fig. 2A). SPIO labelling displayed no significant effect on the rate of regeneration (Fig. 2B). Discussion: SPIO labelling for MRI cell tracking has shown promising results for regenerative therapies using stem cells. This study contributes to broaden the potential of SPIOs to track regenerating tissue in an inherently regenerative model, facilitating the use of SPIOs in future pharmaceutically or genetically induced regenerative therapies. Additionally, this study concludes that SPIO labelling and MRI tracking of axolotl stem cells allow for non-invasive longitudinal studies in this model, increasing the potential to draw knowledge from the regenerative capacities of this species.","author_count":5,"contributors":["Lauridsen, Henrik","Foldager, Casper Bindzus","Hagensen, Mette K","Wang, Tobias","Pedersen, Michael"],"cuid":["S01-000.00-275281"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"tracking stem cells in an inherently regenrative environment","src":["au"],"src-code":["DI-U-AU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://www.ismrm.org/12/","version":"Other Version"},"id":"S01-000.00-275281","ids":["au-ffc319f6-e13e-4f14-abbb-24aa3fba260a"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-C5511A39A761F0A7858BBB70FAEB8081"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.ismrm.org/12/","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The MR Research Centre"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Henrik","key":"lauridsenpau","last":"Lauridsen","locid":"e9b42d0f-74e8-4835-92a3-18ce72bfafa6","name":"Lauridsen, Henrik","orcid":"0000-0002-8833-4456","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Casper Bindzus","key":"foldagerpau","last":"Foldager","locid":"ea76f13d-8b4f-4d4e-8e5e-0290b6038a03","name":"Foldager, Casper Bindzus","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mette","key":"hagensenpau","last":"Hagensen","locid":"2dad0671-9960-48b6-b2d3-c9c4c5b94f74","name":"Hagensen, Mette K","name_org":"Hagensen, Mette","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Tobias Wang","key":"nielsenpau","last":"Nielsen","locid":"7a3d91ab-5dbf-46e4-bc6e-634e16bd8d80","name":"Wang, Tobias","name_org":"Nielsen, Tobias Wang","orcid":"0000-0002-4350-3682","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Michael","key":"pedersenpau","last":"Pedersen","locid":"871199c4-33bb-4fac-95ef-9a2266f30695","name":"Pedersen, Michael","orcid":"0000-0002-1146-0382","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-ffc319f6-e13e-4f14-abbb-24aa3fba260a"],"src":["AU Aarhus University"],"title":"TRACKING STEM CELLS IN AN INHERENTLY REGENRATIVE ENVIRONMENT","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-275281","year":"2012","yearsub":"2012"}
{"abstract":"Numerous recent studies convincingly correlate the upper thermal tolerance limit of aquatic ectothermic animals to reduced aerobic scope, and ascribe the decline in aerobic scope to failure of the cardiovascular system at high temperatures. In the present study we investigate whether this \"aerobic scope model\" applies to an air-breathing and semi-terrestrial vertebrate Rhinella marina (formerly Bufo marinus). To quantify aerobic scope, we measured resting and maximal rate of oxygen consumption at temperatures ranging from 10 to 40°C. To include potential effects of acclimation, three groups of toads were acclimated chronically at 20, 25 and 30°C, respectively. The absolute difference between resting and maximal rate of oxygen consumption increased progressively with temperature and there was no significant decrease in aerobic scope, even at temperature immediately below the lethal limit (41-42°C). Hematological and cardio-respiratory variables were measured at rest and immediately after maximal activity at benign (30°C) and critically high (40°C) temperatures. Within this temperature interval, both resting and active heart rate increased, and there was no indication of respiratory failure, judged from high arterial oxygen saturation, PO(2) and [HbO(2)]. With the exception of elevated resting metabolic rate for cold acclimated toads, we found few differences in the thermal responses between acclimation groups with regard to the cardio-metabolic parameters. In conclusion, we found no evidence for temperature induced cardio-respiratory failure in Rhinella marina indicating that maintenance of aerobic scope and oxygen transport is unrelated to the upper thermal limit of this air-breathing semi-terrestrial vertebrate.","author_count":7,"contributors":["Overgaard, Johannes","Andersen, Jonas Lembcke","Findsen, Anders","Pedersen, Pil Birkefeldt Møller","Hansen, Kasper","Ozolina, Karlina","Wang, Tobias"],"cuid":["S01-000.00-137382"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"aerobic scope and cardiovascular oxygen transport is not compromised at high temperatures in the toad rhinella marina","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1242/jeb.070110","version":"Other Version"},"id":"S01-000.00-137382","identifier":[{"id":"22771750","type":"pmid"},{"id":"84866843768","type":"scopus"}],"ids":["au-0e087c95-2416-40e9-98d1-8cc38c033e96"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-51F4A0BC9A751809D46E9A77B7729CF4"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1242/jeb.070110","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Biology, Department of Biology - Zoophysiology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Johannes","key":"overgaardpau","last":"Overgaard","locid":"71773655-48f6-45f8-9dec-fd660c342174","name":"Overgaard, Johannes","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jonas Lembcke","key":"andersenpau","last":"Andersen","locid":"8690d766-d820-4275-b927-57aec6851dc4","name":"Andersen, Jonas Lembcke","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anders","key":"findsenpau","last":"Findsen","locid":"79f1a03e-e0f0-4e4f-b28e-4f2e8c9f679e","name":"Findsen, Anders","rank":3,"rolecode":"pau"},{"affno":"1"