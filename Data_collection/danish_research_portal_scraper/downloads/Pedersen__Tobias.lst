 Electron, Transmission","Mouse","Muscle Contraction","Myography","Nanoparticle distribution","Time Factors","Tissue Distribution"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-14BE7EE3C7AE5A6C4BB82434E33A8B2C"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.taap.2012.10.014","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus University, Faculty of Science, Department of Biological Sciences, Zoophysiology","Aarhus University, Natural Sciences, Interdisciplinary Nanoscience Center"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University"],"nora_code":"DI-U-AAU","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Molecular Medicine, Cardiovascular and Renal Research Unit"],"nora_code":"DI-U-SDU","used":1},{"affno":"4","country":"fr","key":"sorbonne université","loc":["France","Europe, EU","OECD"],"name":"Sorbonne Université","used":1},{"affno":"5","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous",