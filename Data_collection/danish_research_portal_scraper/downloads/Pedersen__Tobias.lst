{"abstract":"The aim of this study is to screen and thereby reveal potential quinones produced by biological sources as the best candidates to use in redox flow battery technology.","author_count":5,"contributors":["Kristensen, Sebastian Birkedal","van Mourik, Tanja","Pedersen, Tobias Bruun","Sørensen, Jens Laurids","Muff, Jens"],"cuid":["S01-000.00-090868"],"event":{"end":"2019-07-11","place":"Lyon, fr","start":"2019-07-09","title":"The International Flow Battery Forum","year":"2019"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of St Andrews"],"keyword":["Redox flow battery"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"nr","rtype":["clu"],"sorti":"computational screening of electrochemical properties of biological quinones for use in rfb technology","src":["aau"],"src-code":["DI-U-AAU"],"type":"dco","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/307707320/Poster_IFBF.pdf","version":"Other Version"},"id":"S01-000.00-090868","ids":["aau-8c7ec35d-421f-4389-9e33-0e11a93ce8a9"],"keyword":["Biological quinones","RFB technology","Redox flow battery","quinoner"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-C129DB4AD69C337C09276B93B753D2EA"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/307707320/Poster_IFBF.pdf","version":"Other Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Scienc