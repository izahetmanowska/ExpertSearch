openhagen"],"title":"A phase 1/2 trial of an immune-modulatory vaccine against IDO/PD-L1 in combination with nivolumab in metastatic melanoma","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-538188","year":"2021","yearsub":"2021"}
{"abstract":"Monitoring insects across space and time is challenging, due to their vast taxonomic and functional diversity. This study demonstrates how nets mounted on rooftops of cars (car nets) and DNA metabarcoding can be applied to sample flying insect richness and diversity across large spatial scales within a limited time period. During June 2018, 365 car net samples were collected by 151 volunteers during two daily time intervals on 218 routes in Denmark. Insect bulk samples were processed with a DNA metabarcoding protocol to estimate taxonomic composition, and the results were compared to known flying insect richness and occurrence data. Insect and hoverfly richness and diversity were assessed across biogeographic regions and dominant land cover types.We detected 15 out of 19 flying insect orders present in Denmark, with high proportions of especially Diptera compared to Danish estimates, and lower insect richness and diversity in urbanized areas. We detected 319 species not known for Denmark and 174 species assessed in the Danish Red List. Our results indicate that the methodology can assess the flying insect fauna at large spatial scales to a wide extent, but may be, like other methods, biased towards certain insect rders.","author_count":13,"contributors":["Svenningsen, Cecilie S.","Frøslev, Tobias Guldberg","Bladt, Jesper","Pedersen, Lene Bruhn","Larsen, Jonas Colling","Ejrnæs, Rasmus","Fløjgaard, Camilla","Hansen, Anders Johannes","Heilmann-Clausen, Jacob","Dunn, Robert R.","Tøttrup, Anders P."],"cuid":["S02-093.17-020851"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","OECD"],"corresponding_author":["Tøttrup, Anders P."],"country":["United States"],"glorg":["All Global Affiliations","University of North Carolina"],"keyword":["COI","Car nets","Citizen science","DNA metabarcoding","Insect diversity","Mass collected insects"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"detecting flying insects using car nets and dna metabarcoding","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1098/rsbl.2020.0833","version":"Published Version"},"id":"S02-093.17-020851","identifier":[{"id":"000636273500001","type":"wos"},{"id":"PMC8086955","type":"pmcid"},{"id":"33784872","type":"pmid"},{"id":"85103683350","type":"scopus"}],"ids":["au-6fd8e9fd-7fa6-464e-baf6-34e82480cfa1","ku-ca55340a-38a8-4b46-9f10-63a792f2b85f"],"keyword":["COI","Car nets","Citizen science","DNA metabarcoding","Insect diversity","Mass collected insects"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-6F2B39C910178C8B9C3E89F9260F7C81"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1098/rsbl.2020.0833","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/272320807/rsbl.2020.0833.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.au.dk/ws/files/279342679/rsbl.2020.0833.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, The Natural History Museum, Research"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Ecoscience, Department of Ecoscience - Biodiversity and Conservation"],"nora_code":"DI-U-AU","used":1},{"affno":"3","country":"us","key":"university of north carolina","loc":["United States","America, North","OECD"],"name":"University of North Carolina","used":1}],"person":[{"affno":"1","first":"Cecilie S.","key":"svenningsenpau","last":"Svenningsen","locid":"8d94c1bc-2411-454e-917f-434cf3db66c1","name":"Svenningsen, Cecilie S.","orcid":"0000-0002-9216-2917","rank":1,"rolecode":"pau"},{"affno":"1","first":"Tobias Guldberg","key":"froslevpau","last":"Froslev","locid":"68c04506-5e2f-4f9a-890d-26d7353651b5","name":"Frøslev, Tobias Guldberg","name_org":"Froslev, Tobias Guldberg","orcid":"0000-0002-3530-013X","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jesper","key":"bladtpau","last":"Bladt","locid":"321c5b54-0e53-40d2-b196-b8df7ddcf68f","name":"Bladt, Jesper","rank":3,"rolecode":"pau"},{"affno":"1","first":"Lene Bruhn","key":"pedersenpau","last":"Pedersen","locid":"2aaa32e9-09e5-49b8-9c59-67cdaef43a21","name":"Pedersen, Lene Bruhn","rank":4,"rolecode":"pau"},{"affno":"1","first":"Jonas Colling","key":"larsenpau","last":"Larsen","locid":"d7c756b7-d76a-4d4e-9354-31c4d21549d1","name":"Larsen, Jonas Colling","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Rasmus","key":"ejrnæspau","last":"Ejrnæs","locid":"de0d0e9b-b9f3-46a7-9a70-ed6e45dba8d8","name":"Ejrnæs, Rasmus","rank":6,"rolecode":"pau"},{"affno":"","first":"Rasmus","key":"ejrnaespau","last":"Ejrnaes","name":"Ejrnaes, Rasmus","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Camilla","key":"fløjgaardpau","last":"Fløjgaard","locid":"734c7835-fada-4583-95a3-e7ac25f34175","name":"Fløjgaard, Camilla","orcid":"0000-0002-5829-8503","rank":7,"rolecode":"pau"},{"affno":"","first":"Camilla","key":"flojgaardpau","last":"Flojgaard","name":"Flojgaard, Camilla","rank":7,"rolecode":"pau"},{"affno":"1","first":"Anders Johannes","key":"hansenpau","last":"Hansen","locid":"846e4329-bfc5-4ddb-968c-445cdb16825a","name":"Hansen, Anders Johannes","orcid":"0000-0002-1890-2702","rank":8,"rolecode":"pau"},{"affno":"1","first":"Jacob","key":"heilmannclausenpau","last":"Heilmann-Clausen","locid":"a68c065f-a0dd-4168-9254-8bd4409000e9","name":"Heilmann-Clausen, Jacob","orcid":"0000-0003-4713-6004","rank":9,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Robert R.","key":"dunnpau","last":"Dunn","name":"Dunn, Robert R.","rank":10,"rolecode":"pau"},{"affno":"1","first":"Anders P.","key":"tottruppau","last":"Tottrup","locid":"807731aa-098a-455e-bc69-e6413dc92e52","name":"Tøttrup, Anders P.","name_org":"Tottrup, Anders P.","orcid":"0000-0001-8776-9629","rank":11,"rolecode":"pau"}],"pmid":["33784872"],"pub":{"doi":"10.1098/rsbl.2020.0833","issn":["17449561","1744957X"],"issn_org":["17449561"],"issue":"3","journal":"Biology Letters","paperid":"20200833","publisher":"The Royal Society","status":"p","title":"Biology Letters","volume":"17"},"review":"Peer Reviewed","scoID":["2-s2.0-85103683350"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-6fd8e9fd-7fa6-464e-baf6-34e82480cfa1","ku-ca55340a-38a8-4b46-9f10-63a792f2b85f"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Detecting flying insects using car nets and DNA metabarcoding","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-093.17-020851","year":"2021","yearsub":"2021"}
{"abstract":"In this study, we use surface-sensitive vibrational sum-frequency generation (VSFG) spectroscopy to investigate the interaction between model lipid monolayers and Aβ(1-42) in its monomeric and aggregated states. Combining VSFG with atomic force microscopy (AFM) and thioflavin T (ThT) fluorescence measurements, we found that only small aggregates with probably a β-hairpin-like structure adsorbed to the zwitterionic lipid monolayer (DOPC). In contrast, larger aggregates with an extended β-sheet structure adsorbed to a negatively charged lipid monolayer (DOPG). The adsorption of small, initially formed aggregates strongly destabilized both monolayers, but only the DOPC monolayer was completely disrupted. We showed that the intensity of the amide-II′ band in achiral (SSP) and chiral (SPP) polarization combinations increased in time when Aβ(1-42) aggregates accumulated at the DOPG monolayer. Nevertheless, almost no adsorption of preformed mature fibrils to DOPG monolayers was detected. By performing spectral VSFG calculations, we revealed a clear correlation between the amide-II′ signal and the degree of amyloid aggregates (e.g., oligomers or (proto)fibrils) of various Aβ(1-42) structures. The calculations showed that only structures with a significant amyloid β-sheet content have a strong amide-II′ intensity, in line with previous Raman studies. The combination of the presented results substantiates the amide-II(′) band as a legitimate amyloid marker.","author_count":11,"contributors":["Strazdaite, S.","Roeters, Steven J.","Sakalauskas, A.","Sneideris, T.","Kirschner, J.","Pedersen, Kasper B","Schiøtt, Birgit","Jensen, Frank","Weidner, Tobias","Smirnovas, V.","Niaura, G."],"cuid":["S01-000.00-272424"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"corresponding_author":["Roeters, Steven J.","Strazdaite, S."],"country":["Austria","Lithuania"],"glorg":["All Global Affiliations","Vienna University of Technology","Vilnius University"],"keyword":["ATOMIC RESOLUTION STRUCTURE","Alzheimers Disease","BETA PEPTIDE","Conformation","Dynamics","Fibrils","Islet Amyloid Polypeptide","Mechanism","Membrane","Protein aggregation"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"interaction of amyloid β 000000000001 000000000042 peptide and its aggregates with lipid water interfaces probed by vibrational sum frequency generation spectroscopy","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85117145351","version":"Other Version"},"id":"S01-000.00-272424","identifier":[{"id":"34597059","type":"pmid"},{"id":"85117145351","type":"scopus"},{"id":"000709643500011","type":"wos"}],"ids":["au-fadb71ad-39cf-4b2d-a52d-fd610abf92da"],"keyword":["ALZHEIMERS-DISEASE","ATOMIC-RESOLUTION STRUCTURE","BETA-PEPTIDE","CONFORMATION","DYNAMICS","FIBRILS","ISLET AMYLOID POLYPEPTIDE","MECHANISM","MEMBRANE","PROTEIN AGGREGATION"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-3D0A2A78592CAFDFFFDBEC727ECC0B0B"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"lt","key":"vilnius university","loc":["Lithuania","Europe, EU","OECD"],"name":"Vilnius University","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Chemistry"],"nora_code":"DI-U-AU","used":1},{"affno":"3","country":"at","key":"vienna university of technology","loc":["Austria","Europe, EU","OECD"],"name":"Vienna University of Technology","used":1}],"person":[{"affno":"1","corresponding":null,"first":"S.","key":"strazdaitepau","last":"Strazdaite","name":"Strazdaite, S.","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"S. J.","key":"roeterspau","last":"Roeters","locid":"c76b17db-0e9b-4988-b0e9-81012389655b","name":"Roeters, Steven J.","name_org":"Roeters, S. J.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"A.","key":"sakalauskaspau","last":"Sakalauskas","name":"Sakalauskas, A.","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"T.","key":"sneiderispau","last":"Sneideris","name":"Sneideris, T.","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"J.","key":"kirschnerpau","last":"Kirschner","name":"Kirschner, J.","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"K. B.","key":"pedersenpau","last":"Pedersen","locid":"8a1d4f37-0eee-4288-aa56-9382c368dc30","name":"Pedersen, Kasper B","name_org":"Pedersen, K. B.","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"B.","key":"schiøttpau","last":"Schiøtt","locid":"27c1af35-c8f3-471f-a448-02fd2fbd18bf","name":"Schiøtt, Birgit","name_org":"Schiøtt, B.","orcid":"0000-0001-9937-1562","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"F.","key":"jensenpau","last":"Jensen","locid":"7f24d274-8bec-4667-bde5-f8f9dedc4889","name":"Jensen, Frank","name_org":"Jensen, F.","orcid":"0000-0002-4576-5838","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"T.","key":"weidnerpau","last":"Weidner","locid":"7a001432-fe35-4c21-b32c-40a65e060b03","name":"Weidner, Tobias","name_org":"Weidner, T.","orcid":"0000-0002-7083-7004","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"V.","key":"smirnovaspau","last":"Smirnovas","name":"Smirnovas, V.","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"G.","key":"niaurapau","last":"Niaura","name":"Niaura, G.","rank":11,"rolecode":"pau"}],"pmid":["34597059"],"pub":{"doi":"10.1021/acs.jpcb.1c04882","issn":["15205207","15206106"],"issn_org":["15206106"],"issue":"40","journal":"Journal of Physical Chemistry Part B: Condensed Matter, Materials, Surfaces, Interfaces & Biophysical","pages":"11208-11218","publisher":"American Chemical Society","status":"p","title":"Journal of Physical Chemistry Part B: Condensed Matter, Materials, Surfaces, Interfaces & Biophysical","title_org":"Journal of Physical Chemistry B","volume":"125"},"review":"Peer Reviewed","scoID":["2-s2.0-85117145351"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-fadb71ad-39cf-4b2d-a52d-fd610abf92da"],"src":["AU Aarhus University"],"title":"Interaction of Amyloid-β-(1-42) Peptide and Its Aggregates with Lipid/Water Interfaces Probed by Vibrational Sum-Frequency Generation Spectroscopy","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-272424","year":"2021","yearsub":"2021"}
{"abstract":"Quantum random number generators promise perfectly unpredictable random numbers. A popular approach to quantum random number generation is homodyne measurements of the vacuum state, the ground state of the electro-magnetic field. Here we experimentally implement such a quantum random number generator, and derive a security proof that considers quantum side-information instead of classical side-information only. Based on the assumptions of Gaussianity and stationarity of noise processes, our security analysis furthermore includes correlations between consecutive measurement outcomes due to finite detection bandwidth, as well as analog-to-digital converter imperfections. We characterize our experimental realization by bounding measured parameters of the stochastic model determining the min-entropy of the system’s measurement outcomes, and we demonstrate a real-time generation rate of 2.9 Gbit/s. Our generator follows a trusted, device-dependent, approach. By treating side-information quantum mechanically an important restriction on adversaries is removed, which usually was reserved to semi-device-independent and device-independent schemes.","author_count":9,"contributors":["Gehring, Tobias","Lupo, Cosmo","Kordts, Arne","Nikolic, Dino Solar","Jain, Nitin","Rydberg, Tobias","Pedersen, Thomas B.","Pirandola, Stefano","Andersen, Ulrik Lund"],"cuid":["S01-000.00-305545"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"corresponding_author":["Gehring, Tobias"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of Sheffield","University of York"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-PR-OTH","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"homodyne based quantum random number generator at 000000000002 000000000009 gbps secure against quantum side information","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1038/s41467-020-20813-w","version":"Published Version"},"funding_acknowledgement":["The authors acknowledge support from the Innovation Fund Denmark through the Quantum Innovation Center, Qubiz. T.G., A.K., D.S.N., N.J., and U.L.A. acknowledge support from the Danish National Research Foundation, Center for Macroscopic Quantum States (bigQ, DNRF142). T.G., N.J., S.P., and U.L.A. acknowledge the EU project CiViQ (grant agreement no. 820466). C.L. was also supported by the EPSRC Quantum Communications Hub, grant no. EP/M013472/1. The authors thank Alberto Nannarelli for valuable discussions."],"id":"S01-000.00-305545","identifier":[{"id":"33504789","type":"pmid"},{"id":"PMC7840728","type":"pmcid"},{"id":"85099877648","type":"scopus"}],"ids":["dtu-0339a71f-fa1b-4f8e-8946-530a46aaf97b"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-6873A5BAB342B017D82CFA6427A7FE50"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1038/s41467-020-20813-w","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/255909572/s41467_020_20813_w.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Physics","Technical University of Denmark, Department of Physics, Center for Macroscopic Quantum States","Technical University of Denmark, Depart