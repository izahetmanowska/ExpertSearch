irst":"Lene B.","key":"pedersenpau","last":"Pedersen","locid":"2aaa32e9-09e5-49b8-9c59-67cdaef43a21","name":"Pedersen, Lene Bruhn","name_org":"Pedersen, Lene B.","rank":19,"rolecode":"pau"},{"affno":"2 4 7 5 8","corresponding":null,"first":"Anett","key":"richterpau","last":"Richter","name":"Richter, Anett","rank":20,"rolecode":"pau"},{"affno":"1 10","first":"Robert R.","key":"dunnpau","last":"Dunn","locid":"365f6724-ea4d-422e-afd0-a125b6d4c036","name":"Dunn, Robert R.","rank":21,"rolecode":"pau"},{"affno":"1","first":"Anders P.","key":"tøttruppau","last":"Tøttrup","locid":"807731aa-098a-455e-bc69-e6413dc92e52","name":"Tøttrup, Anders P.","orcid":"0000-0001-8776-9629","rank":22,"rolecode":"pau"},{"affno":"2 3 4 5","corresponding":null,"first":"Aletta","key":"bonnpau","last":"Bonn","name":"Bonn, Aletta","rank":23,"rolecode":"pau"}],"pub":{"doi":"10.1111/ddi.13532","issn":["13669516","14724642"],"issn_org":["13669516"],"issue":"6","journal":"Diversity and Distributions","pages":"1242-1254","publisher":"Wiley-Blackwell Publishing Ltd","status":"p","title":"Diversity and Distributions","volume":"28"},"review":"Peer Reviewed","scoID":["2-s2.0-85128916802"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-c14a0723-deef-4b74-b052-bfb25ecf9fef","ku-a1b8800f-3c2e-488c-b2b3-6ea39d598cd0"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Flying insect biomass is negatively associated with urban cover in surrounding landscapes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-026709","year":"2022","yearsub":"2022"}
{"abstract":"Understanding the molecular pathways driving the acute antiviral and inflammatory response to SARS-CoV-2 infection is critical for developing treatments for severe COVID-19. Here, we find decreasing number of circulating plasmacytoid dendritic cells (pDCs) in COVID-19 patients early after symptom onset, correlating with disease severity. pDC depletion is transient and coincides with decreased expression of antiviral type I IFNα and of systemic inflammatory cytokines CXCL10 and IL-6. Using an in vitro stem cell-based human pDC model, we further demonstrate that pDCs, while not supporting SARS-CoV-2 replication, directly sense the virus and in response produce multiple antiviral (interferons: IFNα and IFNλ1) and inflammatory (IL-6, IL-8, CXCL10) cytokines that protect epithelial cells from de novo SARS-CoV-2 infection. Via targeted deletion of virus-recognition innate immune pathways, we identify TLR7-MyD88 signaling as crucial for production of antiviral interferons (IFNs), whereas Toll-like receptor (TLR)2 is responsible for the inflammatory IL-6 response. We further show that SARS-CoV-2 engages the receptor neuropilin-1 on pDCs to selectively mitigate the antiviral interferon response, but not the IL-6 response, suggesting neuropilin-1 as potential therapeutic target for stimulation of TLR7-mediated antiviral protection.","author_count":26,"contributors":["van der Sluis, Renée Marije","Cham, Lamin B.","Gris-Oliver, Albert","Jakobsen, Kristine Raaby","Pedersen, Jesper Geert","Idorn, Manja","Ahmadov, Ulvi","Hernández, Sabina Sánchez","Cemalovic, Ena","Godsk, Stine Høvring","Thyrsted, Jacob","Gunst, Jesper D.","Nielsen, Silke D.","Jørgensen, Janni J.","Bjerg, Tobias Wang","Laustsen, Anders","Reinert, Line S.","Olagnier, David","Bak, Rasmus O","Kjolby, Mads","Holm, Christian K","Tolstrup, Martin","Paludan, Søren R","Kristensen, Lasse Sommer","Søgaard, Ole Schmeltz","Jakobsen, Martin Roelsgaard"],"cuid":["S01-000.00-255335"],"filters":{"added":"2022-04","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Jakobsen, Martin Roelsgaard"],"country":["Norway"],"glorg":["All Global Affiliations","Norwegian University of Science and Technology","St. Olavs University Hospital (Trondheim)"],"keyword":["COVID 19 immunology","Cytokines metabolism","Dendritic Cells immunology","Expression","Humans","Interferon Type I immunology","Interferon alpha immunology","Interleukin 6 immunology","Neuropilin 1","Receptor","SARS CoV 2","TLR7","TMPRSS2","Toll Like Receptor 2 immunology","pDC"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"tlr000000000002 and tlr000000000007 mediate distinct immunopathological and antiviral plasmacytoid dendritic cell responses to sars cov 000000000002 infection","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.15252/embj.2021109622","version":"Published Version"},"id":"S01-000.00-255335","identifier":[{"id":"000762371200001","type":"wos"},{"id":"PMC9108609","type":"pmcid"},{"id":"35178710","type":"pmid"},{"id":"85125415941","type":"scopus"}],"ids":["au-dcc6b2ba-9dad-478a-a63e-7bde8ca0308d"],"keyword":["COVID-19/immunology","Cytokines/metabolism","Dendritic Cells/immunology","EXPRESSION","Humans","Interferon Type I/immunology","Interferon-alpha/immunology","Interleukin-6/immunology","Neuropilin-1/immunology","RECEPTOR","SARS-CoV-2","TLR7","TMPRSS2","Toll-Like Receptor 2/immunology","Toll-Like Receptor 7/immunology","innate immune sensing","neuropilin-1","pDC"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-96D427EFEE0D338F41A2BAEB0566E922"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi