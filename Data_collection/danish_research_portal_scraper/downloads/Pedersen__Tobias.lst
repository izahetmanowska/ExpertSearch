rg University, The Faculty of Medicine, Aalborg University Hospital, Department of Neurosurgery"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Mie Reith","key":"mahlerpau","last":"Mahler","name":"Mahler, Mie Reith","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Melinda","key":"magyaripau","last":"Magyari","name":"Magyari, Melinda","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Luigi","key":"pontieripau","last":"Pontieri","name":"Pontieri, Luigi","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Frederik","key":"elberlingpau","last":"Elberling","name":"Elberling, Frederik","rank":4,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Arkadiusz","key":"weglewskipau","last":"Weglewski","name":"Weglewski, Arkadiusz","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mai Bang","key":"poulsenpau","last":"Poulsen","name":"Poulsen, Mai Bang","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Lars Kristian","key":"storrpau","last":"Storr","name":"Storr, Lars Kristian","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Plamen Anzhelov","key":"bekyarovpau","last":"Bekyarov","name":"Bekyarov, Plamen Anzhelov","rank":8,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Zsolt Laszlo","key":"illespau","last":"Illes","name":"Illes, Zsolt Laszlo","rank":9,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"first":"Matthias","key":"kantpau","last":"Kant","name":"Kant, Matthias","rank":10,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"first":"Tobias","key":"sejbækpau","last":"Sejbæk","name":"Sejbæk, Tobias","rank":11,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Morten","key":"stilundpau","last":"Stilund","name":"Stilund, Morten","rank":12,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Peter","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Peter","rank"