rk Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","North Denmark Region","Other Research","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-2a564009-86a3-4b86-bd20-f6d0a566767e","au-a1936558-de48-4c1f-a33f-253baa135fed","ku-41030e55-751c-460a-9632-72faa1b9f368","sdu-7bc360a3-f568-4748-9df8-d1265d2de31d"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"The impact of comorbidity on mortality in multiple myeloma : a Danish nationwide population-based study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-100.00-002128","year":"2017","yearsub":"2017"}
{"abstract":"The introduction of macrocyclic constraints in peptides (peptide stapling) is an important tool within peptide medicinal chemistry for stabilising and pre-organising peptides in a desired conformation. In recent years, the copper-catalysed azide-alkyne cycloaddition (CuAAC) has emerged as a powerful method for peptide stapling. However, to date CuAAC stapling has not provided a simple method for obtaining peptides that are easily diversified further. In the present study, we report a new diversity-oriented peptide stapling (DOPS) methodology based on CuAAC chemistry. Stapling of peptides incorporating two azide-modified amino acids with 1,3,5-triethynylbenzene efficiently provides (i, i+7)- and (i, i+9)-stapled peptides with a single free alkyne positioned on the staple, that can be further conjugated or dimerised. A unique feature of the present method is that it provides easy access to radiolabelled stapled peptides by catalytic tritiation of the alkyne positioned on the staple.","author_count":11,"contributors":["Tran, Phuong Thu","Larsen, Christian Ørnbøl","Røndbjerg, Tobias","de Foresta, Martina","Kunze, Micha Ben Achim","Marek, Ales","Hartvig Løper, Jacob","Boyhus, Lotte Emilie","Knuhtsen, Astrid","Lindorff-Larsen, Kresten","Pedersen, Daniel Sejer"],"cuid":["S01-000.00-425995"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"diversity oriented peptide stapling a third generation copper catalysed azide alkyne cycloaddition stapling and functionalisation strategy","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-425995","identifier":[{"id":"85013249260","type":"scopus"},{"id":"28106305","type":"pmid"}],"ids":["ku-36ccf9aa-4a2c-44bc-9eb4-386feba4f833"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-8A59064568F36091693942D99523B496"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Drug Design and Pharmacology, Medicinal Chemistry Research"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Thu Phuong","key":"tranpau","last":"Tran","locid":"4df14aad-8413-4648-86bf-008599e98e54","name":"Tran, Phuong Thu","name_org":"Tran, Thu Phuong","rank":1,"rolecode":"pau"},{"affno":"","first":"Christian Ørnbøl","key":"larsenpau","last":"Larsen","name":"Larsen, Christian Ørnbøl","rank":2,"rolecode":"pau"},{"affno":"","first":"Tobias","key":"røndbjergpau","last":"Røndbjerg","name":"Røndbjerg, Tobias","rank":3,"rolecode":"pau"},{"affno":"","first":"Martina","key":"deforestapau","last":"de Foresta","name":"de Foresta, Martina","rank":4,"rolecode":"pau"},{"affno":"1","first":"Micha Ben Achim","key":"kunzepau","last":"Kunze","locid":"5b3f23af-a162-4383-bc5d-c8c9264363c5","name":"Kunze, Micha Ben Achim","orcid":"0000-0001-8922-5510","rank":5,"rolecode":"pau"},{"affno":"","first":"Ales","key":"marekpau","last":"Marek","name":"Marek, Ales","rank":6,"rolecode":"pau"},{"affno":"","first":"Jacob","key":"hartvigløperpau","last":"Hartvig Løper","name":"Hartvig Løper, Jacob","rank":7,"rolecode":"pau"},{"affno":"1","first":"Lotte-Emilie","key":"boyhuspau","last":"Boyhus","locid":"786bbead-8072-4884-ac9a-acab8f366054","name":"Boyhus, Lotte Emilie","name_org":"Boyhus, Lotte-Emilie","rank":8,"rolecode":"pau"},{"affno":"1","first":"Astrid","key":"knuhtsenpau","last":"Knuhtsen","locid":"a1db73a4-3bdf-4dff-8abc-eeb8811b37f2","name":"Knuhtsen, Astrid","rank":9,"rolecode":"pau"},{"affno":"1","first":"Kresten","key":"lindorfflarsenpau","last":"Lindorff-Larsen","locid":"be20a4d8-92c4-44b9-9dfb-b6ad6471a58c","name":"Lindorff-Larsen, Kresten","orcid":"0000-0002-4750-6039","rank":10,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Daniel Sejer","key":"pedersenpau","last":"Pedersen","locid":"5dc5469d-7fb0-40c3-81bc-d7666a18e27d","name":"Pedersen, Daniel Sejer","rank":11,"rolecode":"pau"}],"pmid":["28106305"],"pub":{"doi":"10.1002/chem.201700128","issn":["09476539","15213765"],"issn_org":["09476539"],"issue":"14","journal":"Chemistry - A European Journal","pages":"3490-3495","status":"p","title":"Chemistry - A European Journal","title_org":"Chemistry: A European Journal","volume":"23"},"review":"Peer Reviewed","scoID":["2-s2.0-85013249260"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-36ccf9aa-4a2c-44bc-9eb4-386feba4f833"],"src":["KU University of Copenhagen"],"title":"Diversity-oriented peptide stapling : a third generation copper-catalysed azide–alkyne cycloaddition stapling and functionalisation strategy","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-425995","year":"2017","yearsub":"2017"}
{"abstract":"Importance: To our knowledge, there have been few population-based studies of strabismus incidence conducted. Our population-based study provides valuable data for health services planning and identifying research needs. Objective: To determine the incidence and age distribution of strabismus, overall and by subtype, among children 7 years or younger. Design, Setting, and Participants: This population-based cohort study was conducted with data from 96 842 children enrolled in the Danish National Birth Cohort. Main Outcomes and Measures: Age-specific incidence and cumulative incidence and median age at the detection of strabismus, overall and by subtype. Results: The study cohort included 96 842 children born between 1996 and 2008 who are predominantly Caucasian and is composed of approximately 30% of births in Denmark, with a boy-girl ratio of 51:49. Overall, 1309 cases of strabismus were identified in the cohort. We found an overall cumulative strabismus incidence of 2.56% (95% CI, 2.42-2.69) at 7 years. The overall incidence was similar among boys and girls. Two hundred sixteen participants (16.5%) (95% CI, 14.5-18.6) had congenital esotropia, 177 (13.5%) (95% CI, 11.7-15.5) had fully accommodative esotropia, 252 (19.3%) (95% CI, 17.1-21.5) had partially accommodative esotropia, and 181 (13.8%) (95% CI, 12.0-15.8) had exotropia. The esotropia:exotropia ratio was 5.4:1 (95% CI, 3.4:1 to 7.5:1). Age-specific incidence curves for congenital esotropia, fully accommodative esotropia, partially accommodative esotropia, and all exotropia revealed interactions between strabismus subtype and age, suggesting that the different subtypes had different age-specific patterns of incidence (P < .001 for all comparisons between pairs of curves). The median age at detection for the 4 subtypes was 0, 32.0, 26.1, and 16.6 months, respectively. Conclusions and Relevance: In a national, population-based cohort study, we found a cumulative incidence of strabismus consistent with those reported in smaller European and American cohorts, but a somewhat higher esotropia:exotropia ratio than those that, to our knowledge, are typically reported by English and American studies. Patterns of incidence by age differed for different strabismus subtypes, indicating differences in age at onset and thereby implying differences in the underlying etiology.","author_count":7,"contributors":["Torp-Pedersen, Tobias","Boyd, Heather A","Skotte, Line","Haargaard, Birgitte","Wohlfahrt, Jan","Holmes, Jonathan M","Melbye, Mads"],"cuid":["S01-000.00-438605"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Age Distribution","Child","Child Preschool","Cohort Studies","Denmark epidemiology","Ethnic Groups","European Continental Ancestry Group","Female","Humans","Incidence","Infant","Infant Newborn","Male","Registries","Sex Distribution"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"strabismus incidence in a danish population based cohort of children","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-438605","identifier":[{"id":"85031316553","type":"scopus"},{"id":"PMC5710488","type":"pmcid"},{"id":"28859196","type":"pmid"}],"ids":["ku-4bbf5711-74ac-43bc-8acc-d76445683aac"],"keyword":["Age Distribution","Child","Child, Preschool","Cohort Studies","Denmark/epidemiology","Ethnic Groups","European Continental Ancestry Group","Female","Humans","Incidence","Infant","Infant, Newborn","Male","Registries","Sex Distribution","Strabismus/diagnosis"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-89AE63D68C09634C4CB22D8CA50886D6"],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Tobias","key":"torppedersenpau","last":"Torp-Pedersen","name":"Torp-Pedersen, Tobias","rank":1,"rolecode":"pau"},{"affno":"","first":"Heather A","key":"boydpau","last":"Boyd","name":"Boyd, Heather A","rank":2,"rolecode":"pau"},{"affno":"","first":"Line","key":"skottepau","last":"Skotte","name":"Skotte, Line","rank":3,"rolecode":"pau"},{"affno":"1","first":"Birgitte","key":"haargaardpau","last":"Haargaard","locid":"eb322dde-1c13-46a5-b7f2-3c0459304935","name":"Haargaard, Birgitte","rank":4,"rolecode":"pau"},{"affno":"","first":"Jan","key":"wohlfahrtpau","last":"Wohlfahrt","name":"Wohlfahrt, Jan","rank":5,"rolecode":"pau"},{"affno":"","first":"Jonathan M","key":"holmespau","last":"Holmes","name":"Holmes, Jonathan M","rank":6,"rolecode":"pau"},{"affno":"1","first":"Mads","key":"melbyepau","last":"Melbye","locid":"5223d59a-d9b3-41ee-9664-4f1313d4b8c6","name":"Melbye, Mads","orcid":"0000-0001-8264-6785","rank":7,"rolecode":"pau"}],"pmid":["28859196"],"pub":{"doi":"10.1001/jamaophthalmol.2017.3158","issn":["10000348","21686165"],"issn_org":["21686165"],"issue":"10","journal":"JAMA Ophthalmology","pages":"1047-1053","status":"p","title":"JAMA Ophthalmology","volume":"135"},"review":"Peer Reviewed","scoID":["2-s2.0-85031316553"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-4bbf5711-74ac-43bc-8acc-d76445683aac"],"src":["KU University of Copenhagen"],"title":"Strabismus Incidence in a Danish Population-Based Cohort of Children","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-438605","year":"2017","yearsub":"2017"}
{"abstract":"BACKGROUND: Double expression of MYC and BCL2 proteins (DE) and double-hit MYC+BCL2/BCL6 translocations (DH) were established as important biomarkers in patients with diffuse large B-cell lymphoma (DLBCL) by the 2016 revision of the World Health Organization classification of lymphoid neoplasms. Whether this applies to the subgroup of young patients with high risk DLBCL is not known. We previously found that in a uniform retrospective population-based cohort of patients aged 18-60 years with high-risk DLBCL, the addition of etoposide to R-CHOP chemotherapy (R-CHOEP) resulted in improved survival mainly in patients with germinal center B-cell like (GCB) immunophenotype. The aim of this study was to investigate the prognostic and predictive value of DE and DH in this patient cohort. METHODS: Data on all young Danish patients diagnosed with de novo high-risk DLBCL 2004-2008 and treated with R-CHOP or R-CHOEP were obtained from the Danish Lymphoma database (n = 159). Tumor samples were available from 103 patients. MYC and BCL2 proteins were analyzed with quantitative immunohistochemistry (IHC) using different cut off values. MYC-, BCL2- and BCL6-translocations were examined with fluorescent in situ hybridization (FISH). RESULTS: DE with MYC>75% and BCL2>85% was an independent negative prognostic marker of progression free survival (PFS) in patients treated with R-CHOP but not R-CHOEP (p<0.001), also after exclusion of patients with DH. A predictive effect of DE for response (PFS) to R-CHOEP vs. R-CHOP was almost significant (p = 0.07). DH was not prognostic in this patient cohort. CONCLUSION: In young patients with high-risk DLBCL, treatment with R-CHOEP may overcome the negative prognostic impact of DE observed in patients treated with R-CHOP.","author_count":10,"contributors":["Pedersen, Mette Ølgod","Gang, Anne Ortved","Brown, Peter","Pedersen, Michael","Knudsen, Helle","Nielsen, Signe Ledou","Poulsen, Tim","Wirenfeldt Klausen, Tobias","Høgdall, Estrid","Nørgaard, Peter"],"cuid":["S01-000.00-495746"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Adolescent","Adult","Antibodies Monoclonal Murine Derived administration dosage","Antineoplastic Combined Chemotherapy Protocols therapeutic use","Biomarkers Tumor genetics","Cyclophosphamide administration dosage","Doxorubicin administration dosage","Etoposide administration dosage","Female","Humans","Immunohistochemistry","In Situ Hybridization Fluorescence","Kaplan Meier Estimate","Lymphoma Large B Cell Diffuse diagnosis","Male","Middle Aged","Prednisone administration dosage","Prognosis","Proto Oncogene Proteins c bcl 2 genetics","Proto Oncogene Proteins c bcl 6 genetics","Proto Oncogene Proteins c myc genetics","Retrospective Studies","Risk Factors","Vincristine administration dosage","Young Adult"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"real world data on young patients with high risk diffuse large b cell lymphoma treated with r chop or r choep myc bcl000000000002 and bcl000000000006 as prognostic biomarkers","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pone.0186983","version":"Published Version"},"id":"S01-000.00-495746","identifier":[{"id":"29088292","type":"pmid"},{"id":"PMC5663399","type":"pmcid"},{"id":"85032965454","type":"scopus"}],"ids":["ku-ab451a6c-6b20-4127-b77a-889b0e3b41c4"],"keyword":["Adolescent","Adult","Antibodies, Monoclonal, Murine-Derived/administration & dosage","Antineoplastic Combined Chemotherapy Protocols/therapeutic use","Biomarkers, Tumor/genetics","Cyclophosphamide/administration & dosage","Doxorubicin/administration & dosage","