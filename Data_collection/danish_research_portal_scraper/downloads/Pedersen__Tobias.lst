fno":"15 16","corresponding":null,"first":"Weiwei","key":"zhangweiweipau","last":"Zhang","name":"Zhang, Weiwei","rank":17,"rolecode":"pau"},{"affno":"1 4","corresponding":null,"country":"dk","first":"Hans Beier","key":"ommenhansbeierpau","last":"Ommen","locid":"fb2798a4-102f-4576-b17c-987e7106ec71","name":"Ommen, Hans Beier","rank":18,"rolecode":"pau"},{"affno":"1 4","corresponding":null,"country":"dk","first":"Jesper","key":"stentoftjesperpau","last":"Stentoft","locid":"f4c6679c-d7fa-434d-9a23-cb5d6561f719","name":"Stentoft, Jesper","rank":19,"rolecode":"pau"},{"affno":"1 4","corresponding":null,"country":"dk","first":"Maja","key":"ludvigsenmajapau","last":"Ludvigsen","locid":"7819594e-a380-4bec-a5d1-1724d5b18f1c","name":"Ludvigsen, Maja","orcid":"0000-0001-5089-3271","rank":20,"rolecode":"pau"},{"affno":"10 11 12","corresponding":null,"first":"Wayne","key":"tamwaynepau","last":"Tam","name":"Tam, Wayne","rank":21,"rolecode":"pau"},{"affno":"13 14","corresponding":null,"first":"Wing C","key":"chanwingcpau","last":"Chan","name":"Chan, Wing C","rank":22,"rolecode":"pau"},{"affno":"10 11 12","corresponding":null,"first":"Giorgio","key":"inghiramigiorgiopau","last":"Inghirami","name":"Inghirami, Giorgio","rank":23,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Francesco","key":"damorefrancescoannibalepau","last":"d'Amore","locid":"6058829c-2b14-40ba-8a01-44b2a132fceb","name":"D'Amore, Francesco Annibale","name_org":"d'Amore, Francesco","rank":24,"rolecode":"pau"}],"pmid":["31780632","33054083"],"pub":{"doi":"10.3324/haematol.2019.225839","issn":["03906078","15928721"],"issn_org":["03906078"],"issue":"10","journal":"Haematologica","pages":"2432-2439","publisher":"Ferrata Storti Foundation","status":"p","title":"Haematologica","volume":"105"},"review":"Peer Reviewed","scoID":["2-s2.0-85092239455"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-a39be06f-6f21-487d-b430-7c8e96e3610f","au-cd69025d-828c-4cec-909f-7c607b64dd46","ku-1f2f9c67-0d08-426e-90e0-e8cef635cf67","sdu-3acf9eb3-bc80-43e6-92af-efcc2b135a96"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Myeloproliferative and lymphoproliferative malignancies occurring in the same patient : A nationwide discovery cohort","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-099.82-007904","year":"2020","yearsub":"2020"}
{"abstract":"Background The proportion of births via cesarean section (CS) varies worldwide and in many countries exceeds WHO-recommended rates. Long-term health outcomes for children born by CS are poorly understood, but limited data suggest that CS is associated with increased infection-related hospitalisation. We investigated the relationship between mode of birth and childhood infection-related hospitalisation in high-income countries with varying CS rates. Methods and findings We conducted a multicountry population-based cohort study of all recorded singleton live births from January 1, 1996 to December 31, 2015 using record-linked birth and hospitalisation data from Denmark, Scotland, England, and Australia (New South Wales and Western Australia). Birth years within the date range varied by site, but data were available from at least 2001 to 2010 for each site. Mode of birth was categorised as vaginal or CS (emergency/elective). Infection-related hospitalisations (overall and by clinical type) occurring after the birth-related discharge date were identified in children until 5 years of age by primary/secondary International Classification of Diseases, 10th Revision (ICD-10) diagnosis codes. Analysis used Cox regression models, adjusting for maternal factors, birth parameters, and socioeconomic status, with results pooled using meta-analysis. In total, 7,174,787 live recorded births were included. Of these, 1,681,966 (23%, range by jurisdiction 17%–29%) were by CS, of which 727,755 (43%, range 38%–57%) were elective. A total of 1,502,537 offspring (21%) had at least 1 infection-related hospitalisation. Compared to vaginally born children, risk of infection was greater among CS-born children (hazard ratio (HR) from random effects model, HR 1.10, 95% confidence interval (CI) 1.09–1.12, p < 0.001). The risk was higher following both elective (HR 1.13, 95% CI 1.12–1.13, p < 0.001) and emergency CS (HR 1.09, 95% CI 1.06–1.12, p < 0.001). Increased risks persisted to 5 years and were highest for respiratory, gastrointestinal, and viral infections. Findings were comparable in prespecified subanalyses of children born to mothers at low obstetric risk and unchanged in sensitivity analyses. Limitations include site-specific and longitudinal variations in clinical practice and in the definition and availability of some data. Data on postnatal factors were not available.","author_count":16,"contributors":["Miller, Jessica E.","Goldacre, Raphael","Moore, Hannah C.","Zeltzer, Justin","Knight, Marian","Morris, Carole","Nowell, Sian","Wood, Rachael","Carter, Kim W.","Fathima, Parveen","de Klerk, Nicholas","Strunk, Tobias","Li, Jiong","Nassar, Natasha","Pedersen, Lars Henning","Burgner, David P."],"cuid":["S01-000.00-239395"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD","Oceania"],"country":["Australia","United Kingdom"],"glorg":["All Global Affiliations","Monash University","NHS National Services Scotland","University of Melbourne","University of Oxford","University of Sydney","University of Western Australia"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"mode of birth and risk of infection related hospitalisation in childhood a population cohort study of 000000000007 000000000017 million births from 000000000004 high income countries","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pmed.1003429","version":"Published Version"},"id":"S01-000.00-239395","identifier":[{"id":"33211696","type":"pmid"},{"id":"85096459164","type":"scopus"},{"id":"PMC7676705","type":"pmcid"}],"ids":["au-c0e0ed73-3853-4b3c-9481-fb02f38c7980"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-2960E0CCD61560568BB62ECE3DEA61D2"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pmed.1003429","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"au","key":"university of melbourne","loc":["Australia","Oceania","OECD"],"name":"University of Melbourne","used":1},{"affno":"2","country":"gb","key":"university of oxford","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Oxford","used":1},{"affno":"3","country":"au","key":"university of western australia","loc":["Australia","Oceania","OECD"],"name":"University of Western Australia","used":1},{"affno":"4","country":"au","key":"university of sydney","loc":["Australia","Oceania","OECD"],"name":"University of Sydney","used":1},{"affno":"5","country":"gb","key":"nhs national services scotland","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"NHS National Services Scotland","used":1},{"affno":"6","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Clinical Epidemiology"],"nora_code":"DI-U-AU","used":1},{"affno":"7","country":"au","key":"monash university","loc":["Australia","Oceania","OECD"],"name":"Monash University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jessica E.","key":"millerpau","last":"Miller","name":"Miller, Jessica E.","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Raphael","key":"goldacrepau","last":"Goldacre","name":"Goldacre, Raphael","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Hannah C.","key":"moorepau","last":"Moore","name":"Moore, Hannah C.","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Justin","key":"zeltzerpau","last":"Zeltzer","name":"Zeltzer, Justin","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Marian","key":"knightpau","last":"Knight","name":"Knight, Marian","rank":5,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Carole","key":"morrispau","last":"Morris","name":"Morris, Carole","rank":6,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Sian","key":"nowellpau","last":"Nowell","name":"Nowell, Sian","rank":7,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Rachael","key":"woodpau","last":"Wood","name":"Wood, Rachael","rank":8,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Kim W.","key":"carterpau","last":"Carter","name":"Carter, Kim W.","rank":9,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Parveen","key":"fathimapau","last":"Fathima","name":"Fathima, Parveen","rank":10,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Nicholas","key":"deklerkpau","last":"de Klerk","name":"de Klerk, Nicholas","rank":11,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Tobias","key":"strunkpau","last":"Strunk","name":"Strunk, Tobias","rank":12,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Jiong","key":"lipau","last":"Li","locid":"304b9c99-9102-4963-8342-05aae67a5685","name":"Li, Jiong","orcid":"0000-0003-1125-026X","rank":13,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Natasha","key":"nassarpau","last":"Nassar","name":"Nassar, Natasha","rank":14,"rolecode":"pau"},{"affno":"6","corresponding":null,"country":"dk","first":"Lars H.","key":"pedersenpau","last":"Pedersen","locid":"2057ad48-88eb-439f-87ab-11512c937236","name":"Pedersen, Lars Henning","name_org":"Pedersen, Lars H.","orcid":"0000-0001-6726-1991","rank":15,"rolecode":"pau"},{"affno":"1 7","corresponding":null,"first":"David P.","key":"burgnerpau","last":"Burgner","name":"Burgner, David P.","rank":1