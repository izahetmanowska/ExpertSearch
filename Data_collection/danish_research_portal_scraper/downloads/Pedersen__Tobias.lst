ed","locid":"8322b7fa-3e1f-414d-bdd2-a69dbc69ca53","name":"Kousted, Tina Mostrup","rank":13,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lene Niemann","key":"nejsumpau","last":"Nejsum","locid":"1dd4a525-1bc6-4922-b52d-eeb6ef9ffb44","name":"Nejsum, Lene Niemann","orcid":"0000-0003-4368-8821","rank":14,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hans Peter","key":"sørensenpau","last":"Sørensen","locid":"bcab9ca7-425e-47e6-a4b9-154e6a126cde","name":"Sørensen, Hans Peter","rank":15,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thomas","key":"schmittjohnpau","last":"Schmitt-John","locid":"943fae55-808c-45d1-8104-864d9c74a245","name":"Schmitt-John, Thomas","rank":16,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peter","key":"andreasenpau","last":"Andreasen","locid":"fa59daee-38c4-418f-a93f-b48229438570","name":"Andreasen, Peter A","name_org":"Andreasen, Peter","rank":17,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Pia Møller","key":"martensenpau","last":"Martensen","locid":"bac51f15-5b82-4832-831c-bb7b12cac21b","name":"Martensen, Pia Møller","orcid":"0000-0002-1259-0226","rank":18,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Undetermined","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-ba9efff4-7978-4222-9855-8aff529c850e"],"src":["AU Aarhus University"],"title":"Practical Course in Molecular Cell Biology","type":"Lecture Notes","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-235888","year":"2011","yearsub":"2011"}
{"abstract":"The transcriptional coactivator peroxisome proliferator activated receptor (PPAR)-¿ coactivator (PGC)-1a plays a role in regulation of several metabolic pathways. By use of whole body PGC-1a knockout (KO) mice we investigated the role of PGC-1a in fasting, acute exercise and exercise training induced regulation of key proteins in gluconeogenesis and metabolism in the liver. In both wild type (WT) and PGC-1a KO mice liver, the mRNA content of the gluconeogenic proteins glucose-6-phosphatase (G6Pase) and phosphoenolpyruvate carboxykinase (PEPCK) was upregulated during fasting. Pyruvate carboxylase (PC) remained unchanged after fasting in WT mice, but was upregulated in PGC-1a KO mice. In response to a single exercise bout G6Pase mRNA was upregulated in both genotypes, whereas no significant changes were detected in PEPCK or PC mRNA. While G6Pase and PC protein remained unchanged, liver PEPCK protein content was higher in trained than untrained mice of both genotypes. The mRNA content of the mitochondrial proteins Cytochrome c (Cyt c) and cytochrome oxidase (COX) I was unchanged in response to fasting. The mRNA and protein content of Cyt c and COXI increased in the liver in response to a single exercise bout and prolonged exercise training, respectively, in WT mice, but not in PGC-1a KO mice. Neither fasting nor exercise affected the mRNA expression of antioxidant enzymes in the liver and knockout of PGC-1a had no effect. In conclusion, these results suggest that PGC-1a plays a pivotal role in regulation of Cyt c and COXI expression in the liver in response to a single exercise bout and prolonged exercise training, which implies that exercise training induced improvements in oxidative capacity of the liver is regulated by PGC-1a.","author_count":11,"contributors":["Haase, Tobias N.","Jørgensen, Stine","Leick, Lotte","Biensø, Rasmus Sjørup","Kiilerich, Kristian","Johansen, Sune","Nielsen, Maja Munk","Wojtaszewski, Jørgen","Hidalgo, Juan","Pedersen, Per Amstrup","Pilegaard, Henriette"],"cuid":["S01-000.00-446475"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"role of pgc 000000000001 alpha in exercise and fasting induced adaptations in mouse liver","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1152/ajpregu.00775.2010","version":"Other Version"},"id":"S01-000.00-446475","identifier":[{"id":"21832205","type":"pmid"},{"id":"80155143253","type":"scopus"}],"ids":["ku-58a8e775-8fa4-46b0-8ef6-6cd716a4efb9"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-8B71A51DDF904969E66828E7939F3B21"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1152/ajpregu.00775.2010","version":"Other Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Graduate School of Health and Medical Sciences"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Tobias Nørresø","key":"haasepau","last":"Haase","locid":"379f7dd2-f677-45dd-87f5-88a680ceb435","name":"Haase, Tobias N.","name_org":"Haase, Tobias Nørresø","rank":1,"rolecode":"pau"},{"affno":"1","first":"Stine Ringholm","key":"jørgensenpau","last":"Jørgensen","locid":"b6245956-c692-43b1-b90e-7204c13eb024","name":"Jørgensen, Stine","name_org":"Jørgensen, Stine Ringholm","rank":2,"rolecode":"pau"},{"affno":"","first":"Lotte","key":"leickpau","last":"Leick","locid":"b4eb3bdd-8970-426d-a7b9-b76a180d5312","name":"Leick, Lotte","rank":3,"rolecode":"pau"},{"affno":"1","first":"Rasmus S","key":"biensøpau","last":"Biensø","locid":"c6f3c9d2-fa70-4da8-bafc-c37d0334c653","name":"Biensø, Rasmus Sjørup","name_org":"Biensø, Rasmus S","rank":4,"rolecode":"pau"},{"affno":"","first":"Kristian","key":"kiilerichpau","last":"Kiilerich","locid":"188c8da4-a200-414a-9b54-033ba0700d5f","name":"Kiilerich, Kristian","rank":5,"rolecode":"pau"},{"affno":"","first":"Sune","key":"johansenpau","last":"Johansen","name":"Johansen, Sune","rank":6,"rolecode":"pau"},{"affno":"","first":"Maja Munk","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Maja Munk","rank":7,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Jorgen F P","key":"wojtaszewskipau","last":"Wojtaszewski","locid":"06441180-44ed-4f23-b077-4d90876cc68b","name":"Wojtaszewski, Jørgen","name_org":"Wojtaszewski, Jorgen F P","orcid":"0000-0001-8185-3408","rank":8,"rolecode":"pau"},{"affno":"","first":"Juan","key":"hidalgopau","last":"Hidalgo","name":"Hidalgo, Juan","rank":9,"rolecode":"pau"},{"affno":"1","first":"Per Amstrup","key":"pedersenpau","last":"Pedersen","locid":"3386bb28-68a6-4a71-a7ac-926bacfa2850","name":"Pedersen, Per Amstrup","orcid":"0000-0001-8648-9748","rank":10,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Henriette","key":"pilegaardpau","last":"Pilegaard","locid":"bca00b25-e11a-407d-936f-6982a39ef1d8","name":"Pilegaard, Henriette","orcid":"0000-0002-1071-0327","rank":11,"rolecode":"pau"}],"pmid":["21832205"],"pub":{"doi":"10.1152/ajpregu.00775.2010","issn":["03636119","15221490"],"issn_org":["03636119"],"issue":"5","journal":"American Journal of Physiology: Regulatory, Integrative and Comparative Physiology","status":"p","title":"American Journal of Physiology: Regulatory, Integrative and Comparative Physiology","volume":"301"},"review":"Peer Reviewed","scoID":["2-s2.0-80155143253"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-58a8e775-8fa4-46b0-8ef6-6cd716a4efb9"],"src":["KU University of Copenhagen"],"title":"Role of PGC-1{alpha} in exercise and fasting induced adaptations in mouse liver","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-446475","year":"2011","yearsub":"2011"}
{"abstract":"We demonstrate a configuration for efficient channel-plasmon mode excitation using tapered terminations of V-shaped groove waveguides. The plasmon excitation is achieved by directly illuminating tapers of gold V-grooves with a focused laser beam, incident normally onto the sample surface. For near-infrared wavelengths, we find experimentally as well as numerically, by conducting three-dimensional finite-difference time-domain calculations, that the efficiency of channel-plasmon mode excitation exceeds 10% in the optimum configuration, which is the highest experimentally observed efficiency of coupling from free-propagation light into a nanoscale-size waveguide.","author_count":6,"contributors":["Radko, Ilya P.","Stær, Tobias Holmgaard","Han, Zhanghua","Pedersen, Kjeld","Bozhevolnyi, Sergey I."],"cuid":["S02-097.50-009419"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-AAU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"efficient channel plasmon excitation by nano mirrors","src":["aau","sdu"],"src-code":["DI-U-AAU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1063/1.3664109","version":"Other Version"},"id":"S02-097.50-009419","identifier":[{"id":"WOS:000297471000042","type":"wos"},{"id":"81855213223","type":"scopus"}],"ids":["aau-c3e1b24f-e0c6-46c8-9037-bb61bf9a2e4d","sdu-e6e854bc-dda5-49b9-ab72-2338281dfc1d"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-CF54BD3829010DB4AF0FF6D832265AE2"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1063/1.3664109","version":"Other Version"},{"access":"oa","type":"rem","url":"http://apl.aip.org/resource/1/applab/v99/i21/p213109_s1","version":"Other Version"},{"access":"oa","type":"rem","url":"http://scitation.aip.org/getpdf/servlet/GetPDFServlet?filetype=pdf&id=APPLAB000099000021213109000001&idtype=cvips&doi=10.1063/1.3664109&prog=normal","version":"Other Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Engineering, Department of Technology and Innovation"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (ENG)","Aalborg University, The Faculty of Engineering and Science, Department of Physics and Nanotechnology"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Ilya","key":"radkopau","last":"Radko","locid":"8f378633-d22e-4aa2-a4d4-27554674a22f","name":"Radko, Ilya","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Tobias Holmgaard","key":"stærpau","last":"Stær","locid":"f9c73bfe-cf15-440a-9aca-290bb9e2f2a5","name":"Stær, Tobias Holmgaard","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Tobias","key":"holmgaardstærpau","last":"Holmgaard Stær","name":"Holmgaard Stær, Tobias","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Zhanghua","key":"hanpau","last":"Han","locid":"323424cf-3068-4c29-a7ff-117d8e7eae99","name":"Han, Zhanghua","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Kjeld","key":"pedersenpau","last":"Pedersen","locid":"ff5fc0ab-1fa1-47a2-916c-8b7556f2f938","name":"Pedersen, Kjeld","orcid":"0000-0002-6835-1566","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sergey I.","key":"bozhevolnyipau","last":"Bozhevolnyi","locid":"9df17db0-2e69-41ff-8a38-8738093f0385","name":"Bozhevolnyi, Sergey I.","orcid":"0000-0002-0393-4859","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1063/1.3664109","issn":["00036951","10773118"],"issn_org":["00036951"],"issue":"21","journal":"Applied Physics Letters","pages":"213109","publisher":"AIP Publishing (American Institute of Physics)","status":"p","title":"Applied Physics Letters","volume":"99"},"review":"Peer Reviewed","scoID":["2-s2.0-81855213223"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-c3e1b24f-e0c6-46c8-9037-bb61bf9a2e4d","sdu-e6e854bc-dda5-49b9-ab72-2338281dfc1d"],"src":["AAU Aalborg University","SDU University of Southern Denmark"],"title":"Efficient channel-plasmon excitation by nano-mirrors","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-097.50-009419","year":"2011","yearsub":"2011"}
{"abstract":"WHAT IS ALREADY KNOWN ABOUT THIS SUBJECT • Chronic heart failure (HF) is a syndrome with increasing prevalence. Though mortality is still high, the introduction of β-adrenoceptor blockers for its treatment has improved survival considerably. • As is the case for all medical treatment, not all patients benefit from β-adrenoceptor blocker treatment, and stratifying patients to different β-adrenoceptor blockers by the use of pharmacogenomics might be of great value in improving HF therapy. • Previous studies have shown that the two single nucleotide polymorphisms (SNPs) ADRB1 Arg389Gly and ADRB2 Gln27Glu interact with the β-adrenoceptor blockers metoprolol and carvedilol, respectively. These interactions have led to stratified responses with regard to surrogate parameters, e.g. left ventricular ejection fraction (LVEF), pulse and blood pressure. • Several studies have failed to show a stratified survival response when stratifying for ADRB1 Arg389Gly and ADRB2 Gln27Glu. WHAT THIS STUDY ADDS • With the present study we tested a specific combination of ADRB1 Arg389Gly and ADRB2 Gln27Glu and showed that, when stratifying HF patients according to this genotype combination, a stratified carvedilol response was seen with respect to survival over a median follow-up period of 6.7 years. • This genotype combination did not show a stratified metoprolol response. AIM Pharmacogenetics can be used as a tool for stratified pharmacological therapy in cardiovascular medicine. We investigated whether a predefined combination of the Arg389Gly polymorphism in the adrenergic β(1) -receptor gene (ADRB1) and the Gln27Glu polymorphism in the adrenergic β(2) -receptor gene (ADRB2) could predict survival in carvedilol- and metoprolol-treated chronic heart failure (HF) patients. METHODS Five hundred and eighty-six HF patients (carvedilol n= 82, metoprolol n= 195) were genotyped for ADRB1 Arg389Gly (rs1801253) and ADRB2 Gln27Glu (rs1042714). The end-point was all-cause mortality, and median follow-up time was 6.7 years. Patients were classified into two functional genotype groups: group 1 combination of Arg389-homozygous and Gln27-carrier (46%) and group 2 any other genotype combination (54%). Results were fitted in two multivariate Cox models. RESULTS There was a significant interaction between functional genotype group and carvedilol treatment (adjusted(1) P= 0.033, adjusted(2) P= 0.040). Patients treated with carvedilol had shorter survival in functional genotype group 1 (P= 0.004; adjusted(1) hazard ratio (HR) 2.67, 95% CI 1.27, 5.59, P= 0.010; adjusted(2) HR 2.05, 95% CI 1.06, 3.95, P= 0.033). There was no interaction between genotype group and metoprolol treatment (P= 0.61), and there was no difference in overall survival between genotype groups (P= 0.69). CONCLUSIONS A combination of ADRB1 Arg389-homozygous and ADRB2 Gln27-carrier in HF patients treated with carvedilol was associated with a two-fold increase in mortality relative to all other genotype combinations. There was no difference in survival in metoprolol-treated HF patients between genotype groups. Patients in genotype group 1 may benefit more from metoprolol than carvedilol treatment.","author_count":11,"contributors":["Petersen, Morten","Andersen, Jon T","Hjelvang, Brian R","Broedbaek, Kasper","Afzal, Shoaib","Nyegaard, Mette","Børglum, Anders D","Stender, Steen","Køber, Lars Valeur","Torp-Pedersen, Christian Tobias","Poulsen, Henrik Enghusen"],"cuid":["S02-099.89-025425"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"association of beta adrenergic receptor polymorphisms and mortality in carvedilol treated chronic heart failure patients","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1111/j.1365-2125.2010.03868.x","version":"Other Version"},"id":"S02-099.89-025425","identifier":[{"id":"000288249500012","type":"wos"},{"id":"PMC3080644","type":"pmcid"},{"id":"79952582396","type":"scopus"},{"id":"21395649","type":"pmid"}],"ids":["au-af2c970b-2fce-40c9-8ef8-d1ad39b3525d","ku-f5d3a7d3-d91a-4e4b-9807-777d79302ab9"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-A34810F4B168BA32669D6091A1CFA75D"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1111/j.1365-2125.2010.03868.x","version":"Other Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus University, Faculty of Health Sciences, Hæmatologisk Afdeling, Aalborg Sygehus"],"nora_code":"DI-U-AU","used":1},{"affno":3,"key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Section of Surgery and Internal Medicine"],"nora_code":"DI-U-KU"}],"person":[{"affno":"","corresponding":null,"first":"Morten","key":"petersenpau","last