esponding":null,"first":"J. Lautrup","key":"battistinipau","last":"Battistini","name":"Battistini, J. Lautrup","rank":11,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"J.","key":"lyckepau","last":"Lycke","name":"Lycke, J.","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Zsolt","key":"illéspau","last":"Illés","locid":"3e0aeebb-ee40-4c3d-9cee-47e786e6f12e","name":"Illes, Zsolt","name_org":"Illés, Zsolt","orcid":"0000-0001-9655-0450","rank":13,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Åsa","key":"fexsvenningsenpau","last":"Fex Svenningsen","locid":"67a6e189-dd21-47da-b9e5-137fa7ae11e2","name":"Fex Svenningsen, Åsa","orcid":"0000-0002-5651-265X","rank":14,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-4e5cfe95-36ee-4889-8468-6a29c19b19aa"],"src":["SDU University of Southern Denmark"],"title":"The serine protease HTRA1 increases in the brain and CSF in Multiple Sclerosis","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-595669","year":"2020","yearsub":"2020"}
{"abstract":"Quinones are produced in organisms and are utilized as electron transfer agents, pigments and in defence mechanisms. Furthermore, naturally occurring quinones can also be cytotoxins with antibacterial properties. These properties can be linked to their redox properties. Recent studies have also shown that quinones can be utilized in flow battery technology, though naturally occurring quinones have not yet been investigated. Here, we have analyzed the properties of 990 different quinones of various biological sources through a computation approach to determine their standard reduction potentials and aqueous solubility. The screening was performed using the PBE functional and the 6-31G** basis set, providing a distribution of reduction potentials of the naturally occurring quinones varying from − 1.4 V to 1.5 V vs. the standard hydrogen electrode. The solvation energy for each quinone, which indicates the solubility in aqueous solution, was calculated at the same level. A large distribution of solubilities was obtained, containing both molecules that show tendencies of good solubilities and molecules that do not. The solubilities are dependent on the nature of the side groups and the size of the molecules. Our study shows that the group containing the quinones of fungal origin, which is also the largest of the groups considered, has the largest antimicrobial and electrochemical potential, when considering the distribution of reduction potentials for the compounds.","author_count":5,"contributors":["Kristensen, Sebastian Birkedal","van Mourik, Tanja","Pedersen, Tobias Bruun","Sørensen, Jens Laurids","Muff, Jens"],"cuid":["S01-000.00-087966"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"corresponding_author":["Sørensen, Jens Laurids"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of St Andrews"],"keyword":["Biochemistry","Computational Biology"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"simulation of electrochemical properties of naturally occurring quinones","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1038/s41598-020-70522-z","version":"Published Version"},"id":"S01-000.00-087966","identifier":[{"id":"85089360060","type":"scopus"},{"id":"32782387","type":"pmid"}],"ids":["aau-82637a3d-0250-47ac-a40a-3045921b3729"],"keyword":["Computational Biology","biochemistry"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-20783B630A7420243E8FB56E3F78AA65"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1038/s41598-020-70522-z","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/399330076/s41598_020_70522_z.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience, Environmental Chemical Engineering","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience, Section of Chemical Engineering"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"gb","key":"university of st andrews","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of St Andrews","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Sebastian Birkedal","key":"kristensenpau","last":"Kristensen","locid":"628b798c-4348-46ef-99d7-a7ca00e710a7","name":"Kristensen, Sebastian Birkedal","orcid":"0000-0001-6399-9577","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Tanja","key":"vanmourikpau","last":"van Mourik","name":"van Mourik, Tanja","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Tobias Bruun","key":"pedersenpau","last":"Pedersen","locid":"bc73daa2-870d-4de9-bf18-bd8a23efc501","name":"Pedersen, Tobias Bruun","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens Laurids","key":"sørensenpau","last":"Sørensen","locid":"365188dd-0cdc-4c71-a590-2ccd261ae3df","name":"Sørensen, Jens Laurids","orcid":"0000-0002-2392-5343","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens","key":"muffpau","last":"Muff","locid":"31d59491-a0f2-44b7-aba4-6d1def771538","name":"Muff, Jens","orcid":"0000-0003-1082-3409","rank":5,"rolecode":"pau"}],"pmid":["32782387"],"pub":{"doi":"10.1038/s41598-020-70522-z","issn":["20452322"],"issue":"1","journal":"Scientific Reports","paperid":"13571","publisher":"Nature Publishing Group","status":"p","title":"Scientific Reports","volume":"10"},"review":"Peer Reviewed","scoID":["2-s2.0-85089360060"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-82637a3d-0250-47ac-a40a-3045921b3729"],"src":["AAU Aalborg University"],"title":"Simulation of electrochemical properties of naturally occurring quinones","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-087966","year":"2020","yearsub":"2020"}
{"author_count":5,"contributors":["Breslin, Samantha Dawn","Enggaard, Thyge Ryom","Blok, Anders","Gårdhus, Tobias","Pedersen, Morten Axel"],"cuid":["S01-000.00-448092"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"nr","rtype":["clu"],"sorti":"how we tweet about coronavirus and why a computational anthropological mapping of political attention on danish twitter during the covid 000000000019 pandemic","src":["ku"],"src-code":["DI-U-KU"],"type":"doi","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://somatosphere.net/forumpost/covid19-danish-twitter-computational-map/","version":"Published Version"},"id":"S01-000.00-448092","ids":["ku-5b5389ab-134a-4cc4-be76-d61322b22fa7"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-83083762CF5DD061B446D18A33592C83"],"oa_link":[{"access":"oa","type":"rem","url":"http://somatosphere.net/forumpost/covid19-danish-twitter-computational-map/","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Social Sciences, Department of Anthropology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Samantha Dawn","key":"breslinpau","last":"Breslin","locid":"caa665bf-bd08-4b39-a062-e2c8cb1a8f20","name":"Breslin, Samantha Dawn","orcid":"0000-0002-4728-4085","rank":1,"rolecode":"pau"},{"affno":"1","first":"Thyge Ryom","key":"enggaardpau","last":"Enggaard","locid":"5132a83c-8049-4586-ad52-750be95e5101","name":"Enggaard, Thyge Ryom","rank":2,"rolecode":"pau"},{"affno":"1","first":"Anders","key":"blokpau","last":"Blok","locid":"303f5c18-72f5-4b2a-8a4c-dfbe18008345","name":"Blok, Anders","orcid":"0000-0002-3403-698X","rank":3,"rolecode":"pau"},{"affno":"1","first":"Tobias","key":"gårdhuspau","last":"Gårdhus","name":"Gårdhus, Tobias","rank":4,"rolecode":"pau"},{"affno":"1","first":"Morten Axel","key":"pedersenpau","last":"Pedersen","locid":"36e8fb75-1af4-4030-b2c3-77255dc97fe7","name":"Pedersen, Morten Axel","rank":5,"rolecode":"pau"}],"pub":{"status":"X"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Undefined"]},"sid":["ku-5b5389ab-134a-4cc4-be76-d61322b22fa7"],"src":["KU University of Copenhagen"],"title":"How We Tweet About Coronavirus, and Why : A Computational Anthropological Mapping of Political Attention on Danish Twitter during the COVID-19 Pandemic","type":"Other-Internet Publication","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-448092","year":"2020","yearsub":"2020"}
{"abstract":"The aim of this study was to compare the sensitivity of self-collected versus healthcare worker (HCW)-collected swabs for Severe Acute Respiratory Syndrome Coronavirus 2 (SARS-CoV-2) testing. Symptomatic individuals referred for SARS-CoV-2 testing were invited to provide mobile-phone video-instructed self-collected oropharyngeal and nasal samples followed by a HCW-collected oropharyngeal sample. All samples were sent for analysis to the same microbiology laboratory, and the number of SARS-CoV-2-positive participants in the two tests was compared. A total of 109 participants were included, and 19 participants had SARS-CoV-2-positive results. The diagnostic sensitivity of the self-collected and HCW-collected swabs was 84.2% and 89.5%, respectively, with an acceptable agreement, Cohens kappa 0.82, p < 0.001. Further, results from a questionnaire answered by the participants found that loss of smell as a self-reported symptom was a strong predictor for a SARS-CoV-2-positive test. In conclusion, we found that self-collected oropharyngeal and nasal swabs for SARS-CoV-2 testing can be reliable compared to HCW-collected oropharyngeal samples.","author_count":12,"contributors":["Therchilsen, Johan H.","von Buchwald, Christian","Koch, Anders","Nielsen, Susanne Dam","Rasmussen, Daniel B.","Thudium, Rebekka Faber","Kirkby, Nikolai S.","Raaschou-Pedersen, Daniel E.T.","Bundgaard, Johan S.","Iversen, Kasper","Bundgaard, Henning","Todsen, Tobias"],"cuid":["S01-000.00-489314"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Covid 19","Severe acute respiratory syndrome coronavirus 2"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"self collected versus healthcare worker collected swabs in the diagnosis of severe acute respiratory syndrome coronavirus 000000000002","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/diagnostics10090678","version":"Published Version"},"id":"S01-000.00-489314","identifier":[{"id":"85090858275","type":"scopus"},{"id":"PMC7554687","type":"pmcid"},{"id":"32916801","type":"pmid"}],"ids":["ku-a05a8c05-dc29-4e05-b247-fc2fd59f73b0"],"keyword":["COVID-19","COVID-19 diagnostic testing","Severe acute respiratory syndrome coronavirus 2"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-868E2340AC75E15C36180307AFB0120A"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/diagnostics10090678","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/250068696/Self_Collected_versus_Healthcare_Worker_Collected_Swabs_in_the_Diagnosis_of_Severe_Acute_Respiratory_Syndrome_Coronavirus_2.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Otorhinolaryngology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Johan H.","key":"therchilsenjohanhpau","last":"Therchilsen","name":"Therchilsen, Johan H.","rank":1,"rolecode":"pau"},{"affno":"1","first":"Christian","key":"vonbuchwaldchristianpau","last":"von Buchwald","locid":"fc76b0d1-1263-48f7-a4d0-685e60bbc1b6","name":"von Buchwald, C