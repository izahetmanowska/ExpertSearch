s","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Ukendt"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Mouritz Nolsøe","key":"svensonpau","last":"Svenson","locid":"6bc9f8a8-1d92-44db-b188-7f89c7721019","name":"Svenson, Mouritz Nolsøe","orcid":"0000-0003-4459-0471","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Tobias Kjær","key":"bechgaardpau","last":"Bechgaard","locid":"6ee02c64-edcf-4bfe-8e0c-4e99153649a7","name":"Bechgaard, Tobias Kjær","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Søren D.","key":"fuglsangpau","last":"Fuglsang","name":"Fuglsang, Søren D.","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rune Hansen","key":"pedersenpau","last":"Pedersen","locid":"751fd62a-e092-493d-8913-d651122cb1c6","name":"Pedersen, Rune Hansen","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Anders Ø.","key":"tjellpau","last":"Tjell","name":"Tjell, Anders Ø.","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Martin Bonderup","key":"østergaardpau","last":"Østergaard","name":"Østergaard, Martin Bonderup","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Randall E.","key":"youngmanpau","last":"Youngman","name":"Youngman, Randall E.","rank":7,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"John C.","key":"mauropau","last":"Mauro","name":"Mauro, John C.","rank":8,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Sylwester J.","key":"rzoskapau","last":"Rzoska","name":"Rzoska, Sylwester J.","rank":9,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Michal","key":"bockowskipau","last":"Bockowski","name":"Bockowski, Michal","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Morten Mattrup","key":"smedskjærpau","last":"Smedskjær","loc