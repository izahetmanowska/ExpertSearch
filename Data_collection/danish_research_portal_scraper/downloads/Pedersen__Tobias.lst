lstpau","last":"Hahn","locid":"48ba72a8-a237-44e4-9b8b-9dcabc7be658","name":"Hahn, Christoffer Holst","rank":10,"rolecode":"pau"},{"affno":"1","first":"Gitte Bjørn","key":"hvilsomgittebjørnpau","last":"Hvilsom","name":"Hvilsom, Gitte Bjørn","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Gitte","key":"bjørnhvilsomgittepau","last":"Bjørn Hvilsom","name":"Bjørn Hvilsom, Gitte","rank":11,"rolecode":"pau"},{"affno":"1","first":"Preben","key":"homøeprebenpau","last":"Homøe","name":"Homøe, Preben","rank":12,"rolecode":"pau"},{"affno":"2","first":"Tobias","key":"todsentobiaspau","last":"Todsen","locid":"16d5c332-f162-4f76-aa1c-b0306b8222e2","name":"Todsen, Tobias","orcid":"0000-0003-3267-3560","rank":13,"rolecode":"pau"}],"pub":{"issn":["09078916","22451919"],"issn_org":["22451919"],"issue":"8","journal":"Danish Medical Journal","paperid":"A03220165","publisher":"Lægeforeningen","status":"p","title":"Danish Medical Journal","volume":"69"},"review":"Peer Reviewed","scoID":["2-s2.0-85136343241"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-c00ef608-3ec8-4e84-ba67-b64caadb16f8","sdu-94576bbe-3a3f-4e9a-971b-7d5f64a209cc"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Spinal versus conventional fine needle for ultrasound-guided thyroid nodule biopsy : a protocol for a randomised clinical trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-096.40-045872","year":"2022","yearsub":"2022"}
{"abstract":"In Denmark, as with elsewhere in the world, Twitter has emerged as an important arena of public discussion on issues relating to COVID-19 pandemic, including the handling of the crisis by state authorities and health institutions. Based on approximately 140,000 tweets harvested from Danish Twitter in the period between 24 February and 28 April 2020, this report explores how tweeting about mis/trust on this digital platform can be understood as a kind of biopolitical nationalism. Combining computational and qualitative methods, we identify shifting performances of mis/trust and other affects on Danish Twitter, and suggest that this “affective public” plays a key role in the public response to the coronavirus crisis.","author_count":5,"contributors":["Breslin, Samantha Dawn","Blok, Anders","Enggaard, Thyge Ryom","Gårdhus, Tobias","Pedersen, Morten Axel"],"cuid":["S01-000.00-438089"],"filters":{"added":"2022-07","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"affective publics performing trust on danish twitter during the covid 000000000019 lockdown","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"doi","url":"https://doi.org/10.1086/719645","version":"Published Version"},"id":"S01-000.00-438089","identifier":[{"id":"85127980450","type":"scopus"}],"ids":["ku-4acf6228-6979-4dda-b978-07f608ab2e3b"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-3-34258B107699283DE425D830B083D2F7"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"doi","url":"https://doi.org/10.1086/719645","version":"Published Version"},{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://curis.ku.dk/ws/files/306762421/Breslin_et_al_2022_Affective_Publics_.pdf","version":"Other Version"}],"oai":{"class":"Realised","mra":["Social Science (SOC)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Social Sciences, Department of Anthropology","Københavns Universitet, Faculty of Social Sciences, Faculty of Social Sciences, shared expenditure, Copenhagen Center for Social Data Science (SODAS)"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Samantha Dawn","key":"breslinpau","last":"Breslin","locid":"caa665bf-bd08-4b39-a062-e2c8cb1a8f20","name":"Breslin, Samantha Dawn","orcid":"0000-0002-4728-4085","rank":1,"rolecode":"pau"},{"affno":"1","first":"Anders","key":"blokpau","last":"Blok","locid":"303f5c18-72f5-4b2a-8a4c-dfbe18008345","name":"Blok, Anders","orcid":"0000-0002-3403-698X","rank":2,"rolecode":"pau"},{"affno":"1","first":"Thyge Ryom","key":"enggaardpau","last":"Enggaard","locid":"5132a83c-8049-4586-ad52-750be95e5101","name":"Enggaard, Thyge Ryom","rank":3,"rolecode":"pau"},{"affno":"1","first":"Tobias","key":"gårdhuspau","last":"Gårdhus","name":"Gårdhus, Tobias","rank":4,"rolecode":"pau"},{"affno":"1","first":"Morten Axel","key":"pedersenpau","last":"Pedersen","locid":"36e8fb75-1af4-4030-b2c3-77255dc97fe7","name":"Pedersen, Morten Axel","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1086/719645","issn":["00113204","15375382"],"issn_org":["00113204"],"issue":"2","journal":"Current Anthropology","pages":"211-218","status":"p","title":"Current Anthropology","volume":"63"},"review":"Peer Reviewed","scoID":["2-s2.0-85127980450"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-4acf6228-6979-4dda-b978-07f608ab2e3b"],"src":["KU University of Copenhagen"],"title":"\"Affective Publics\" : Performing Trust on Danish Twitter during the COVID-19 Lockdown","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-438089","year":"2022","yearsub":"2022"}
{"abstract":"BACKGROUND Whether infliximab therapy can be successfully discontinued after patients with Crohn’s disease have attained sustained, clinical, biochemical, and endoscopic remission is unknown. METHODS We conducted a multicenter, randomized, double-blind, placebo-controlled withdrawal study of infliximab in patients with Crohn’s disease who were in clinical, biochemical, and endoscopic remission after standard infliximab maintenance therapy for at least 1 year. Patients were randomly assigned 1:1 to continue infliximab therapy or to receive matching placebo for 48 weeks. The primary end point was time to relapse. RESULTS This study randomly assigned 115 patients to either the infliximab-continuation group or to the infliximab-discontinuation group. No relapses were observed among the 59 patients continuing infliximab, whereas 23 of 56 patients discontinuing infliximab experienced relapse. Time to relapse was significantly shorter among patients who discontinued infliximab than among those who continued infliximab (hazard ratio, 0.080; 95% confidence interval [CI], 0.035 to 0.186; P<0.001). At the end of the trial at week 48, relapse-free survival was 100% in the infliximab-continuation group and 51% in the infliximab-discontinuation group. The key secondary end point, time to loss of remission, was significantly shorter among patients discontinuing infliximab therapy than those continuing infliximab (hazard ratio, 0.025; 95% CI, 0.003 to 0.187; P<0.001). No unexpected adverse events were reported. CONCLUSIONS Discontinuation of infliximab for patients with Crohn’s disease receiving long-term infliximab therapy and in clinical, biochemical, and endoscopic remission leads to a considerable risk of relapse. (Funded by the Nordic Trial Alliance [NordForsk], the Medical Fund of the Danish Regions [Regionernes Medicin og Behandlingspulje], the Danish Colitis-Crohn Association, and the A.P. Moller Foundation; ClinicalTrials.gov number, NCT01817426; EudraCT number, 2012-002702-51.)","author_count":54,"contributors":["Sine, Buhl","Casper, Steenholdt","Jørn, Brynskov","Risager, Christensen Katrine","Maria, Dorn-Rasmussen","Østergaard, Thomsen Ole","Klaus, Bendtzen","Wirenfeldt, Klausen Tobias","Frederik, Dahlerup Jens","Niels, Thorsgaard","Jørgen, Jahnsen","Akbar, Molazahi","Natalia, Pedersen","Kjeldsen, Jens","Sven, Almer","Efsen, Dahl Eva","Ida, Vind","Gerhardt, Cannon Annett","Jan, Marsal","Taina, Sipponen","Steen, Agnholt Jørgen","Linda, Kievit Hendrika Adriana","Louise, Aure Synnøve","Lars, Martinsen","Svetlana, Meisner","Hansen, Jane Møller","Ainsworth, Mark Andrew"],"cuid":["S02-084.08-666868"],"filters":{"added":"2022-09","altsrc":["No Matches Found"],"author_count":"51-200 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD"],"corpau":["Stop Infliximab Treatment (STOP-IT) study group"],"corresponding_author":["Ainsworth, Mark Andrew"],"country":["Finland","Norway","Sweden"],"glorg":["Akershus University Hospital","All Global Affiliations","Helsinki University Hospital","Karolinska Institute","Karolinska Institutet","Karolinska University Hospital","Oslo University Hospital","Skåne University Hospital","University of Helsinki","University of Oslo"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-SDR","DI-HO-ZEA"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-SDR","DI-HO-ZEA","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"discontinuation of infliximab therapy in patients with crohn s disease","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"id":"S02-084.08-666868","identifier":[{"id":"38319804","type":"pmid"}],"ids":["ku-6cbbdf9e-3267-4902-a4df-aea3b4e631cc","sdu-66a4548f-fa3c-4148-9c88-0f6807c09507"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-8EF02D5870AF8FD88AC238674CB16DE9"],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1},{"affno":"4","country":"no","key":"oslo university hospital","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"Oslo University Hospital","used":1},{"affno":"5","country":"no","key":"university of oslo","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"University of Oslo","used":1},{"affno":"6","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Nykøbing Falster Sygehus"],"nora_code":"DI-HO-ZEA","used":1},{"affno":"7","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denma