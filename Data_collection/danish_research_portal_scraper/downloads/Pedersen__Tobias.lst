1-0205","rank":17,"rolecode":"pau"},{"affno":"","first":"Kelly Anne","key":"hyndmanpedh","last":"Hyndman","name":"Hyndman, Kelly Anne","rank":18,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Thomas L","key":"pannabeckerpedh","last":"Pannabecker","name":"Pannabecker, Thomas L","rank":19,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-1-4939-3213-9_12","eisbn":["9781493932139"],"isbn":["9781493932122"],"pages":"233-253","place":"New York","publisher":"Springer","series":"Physiology in Health and Disease","status":"p","subtitle":"Comparative, Evolutionary and Genetic Models","title":"Sodium and Water Homeostasis"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","North Denmark Region","Other Research","Undetermined","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-67ecb3b5-3b9a-490e-9145-570931e5f3bf","sdu-88d910a3-122a-4084-b86b-a8256e00d7d9"],"src":["AAU Aalborg University","SDU University of Southern Denmark"],"title":"Non-traditional Models : The Giraffe Kidney from a Comparative and Evolutionary Biology Perspective","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-093.06-005039","year":"2015","yearsub":"2015"}
{"abstract":"Addition of etoposide to the R-CHOP chemotherapy regimen with cyclophosphamide, doxorubicin, vincristine, prednisone and rituximab (R-CHOEP) has resulted in improved survival in young patients with high-risk diffuse large B-cell lymphoma (DLBCL). It is not known whether biological factors can predict this effect. In this study, 245 patients representing all young patients with high-risk DLBCL treated with R-CHOP or R-CHOEP in 2004-2012 in Denmark were extracted from the Danish lymphoma database. Patients were stratified according to cell of origin (COO) into germinal-center B-cell-like (GCB) or non-GCB by Hans' algorithm. Only in patients with the GCB phenotype was treatment with R-CHOEP associated with improved progression-free survival (PFS) and overall survival (OS) compared with R-CHOP. Patients with GCB phenotype treated with R-CHOEP also had superior OS compared with patients with non-GCB phenotype treated with R-CHOEP. This was not seen in R-CHOP treated patients. This could suggest that R-CHOEP should be restricted to patients with GCB phenotype.","author_count":10,"contributors":["Gang, Anne O","Pedersen, Mette Ø","Knudsen, Helle","Lauritzen, Anne F","Pedersen, Michael","Nielsen, Signe Ledou","Brown, Peter","Høgdall, Estrid","Klausen, Tobias W","Nørgaard, Peter"],"cuid":["S01-000.00-429693"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"cell of origin predicts outcome to treatment with etoposide containing chemotherapy in young patients with high risk diffuse large b cell lymphoma","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-429693","identifier":[{"id":"25379621","type":"pmid"},{"id":"84938060107","type":"scopus"}],"ids":["ku-3caa23d4-8570-44cb-865a-7e2a6292758b"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-18FA0127B303F456218E8549997CC3E5"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Anne O","key":"ganganneopau","last":"Gang","name":"Gang, Anne O","rank":1,"rolecode":"pau"},{"affno":"","first":"Mette Ø","key":"pedersenmetteøpau","last":"Pedersen","name":"Pedersen, Mette Ø","rank":2,"rolecode":"pau"},{"affno":"","first":"Helle","key":"knudsenhellepau","last":"Knudsen","name":"Knudsen, Helle","rank":3,"rolecode":"pau"},{"affno":"","first":"Anne F","key":"lauritzenannefpau","last":"Lauritzen","name":"Lauritzen, Anne F","rank":4,"rolecode":"pau"},{"affno":"","first":"Michael","key":"pedersenmichaelpau","last":"Pedersen","name":"Pedersen, Michael","rank":5,"rolecode":"pau"},{"affno":"1","first":"Signe L","key":"nielsensigneledoupau","last":"Nielsen","locid":"48a7d837-0860-4ccc-9fc3-0bd30339bfe6","name":"Nielsen, Signe Ledou","name_org":"Nielsen, Signe L","rank":6,"rolecode":"pau"},{"affno":"","first":"Peter","key":"brownpeterpau","last":"Brown","name":"Brown, Peter","rank":7,"rolecode":"pau"},{"affno":"","first":"Estrid","key":"høgdallestridpau","last":"Høgdall","name":"Høgdall, Estrid","rank":8,"rolecode":"pau"},{"affno":"","first":"Tobias W","key":"klausentobiaswpau","last":"Klausen","name":"Klausen, Tobias W","rank":9,"rolecode":"pau"},{"affno":"","first":"Peter","key":"nørgaardpeterpau","last":"Nørgaard","name":"Nørgaard, Peter","rank":10,"rolecode":"pau"}],"pmid":["25379621"],"pub":{"doi":"10.3109/10428194.2014.982645","issn":["10268022","10428194"],"issn_org":["10428194"],"issue":"7","journal":"Leukemia and Lymphoma","pages":"2039-46","status":"p","title":"Leukemia and Lymphoma","volume":"56"},"review":"Peer Reviewed","scoID":["2-s2.0-84938060107"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-3caa23d4-8570-44cb-865a-7e2a6292758b"],"src":["KU University of Copenhagen"],"title":"Cell of origin predicts outcome to treatment with etoposide-containing chemotherapy in young patients with high-risk diffuse large B-cell lymphoma","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-429693","year":"2015","yearsub":"2015"}
{"abstract":"The introduction of rituximab and generally improved health among elderly patients have increased the survival of patients with diffuse large B-cell lymphoma (DLBCL). The International Prognostic Index (IPI) from 1992 is based on pre-rituximab data from clinical trials including several lymphoma subtypes. We applied IPI factors to a population-based rituximab-treated cohort of 1990 patients diagnosed 2000-2010 and explored new factors and the optimal prognostic age cut-off for DLBCL. Multivariate-analyses (MVA) confirmed the prognostic value of all IPI factors except the presence of > 1 extranodal lesion. The optimal age cut-off was 70 years. In a MVA of albumin, lymphocyte count, sex, immunoglobulin G, bulky disease, hemoglobin and B-symptoms, only albumin was prognostic. We propose: (1) a modified DLBCL prognostic index (DLBCL-PI) including: age (70 years), performance status (PS), lactate dehydrogenase (LDH), stage and albumin level, and (2) a separate age-adjusted DLBCL-PI for patients ≤ 70 years including PS, LDH, albumin level and > 1 extranodal lesion, however excluding stage.","author_count":21,"contributors":["Gang, Anne O","Pedersen, Michael","D'Amore, Francesco Annibale","Pedersen, Lars","Jensen, Bo A","Jensen, Paw","Møller, Michael B","Mourits-Andersen, Hans T","Pedersen, Robert Schou","Klausen, Tobias W","de N Brown, Peter"],"cuid":["S03-096.50-792850"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"corresponding_author":["Gang, Anne O."],"keyword":["Adolescent","Adult","Age Factors","Aged","Aged 80 and over","Antineoplastic Combined Chemotherapy Protocols therapeutic use","Cohort Studies","Combined Modality Therapy","Denmark","Diffuse large B cell lymphoma","Female","Humans","Kaplan Meier Estimate","Lymphoma Large B Cell Diffuse diagnosis","Male","Middle Aged","Multivariate Analysis","Outcome Assessment Health Care methods","Prognosis","Prognostic index","Proportional Hazards Models","Registries statistics numerical data","Rituximab","Stem Cell Transplantation methods","Treatment","Young Adult"],"level":"sci","mra":["med","soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"a clinically based prognostic index for diffuse large b cell lymphoma with a cut off at 000000000070 years of age significantly improves prognostic stratification population based analysis from the danish lymphoma registry","src":["aau","au","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3109/10428194.2015.1010078","version":"Published Version"},"id":"S03-096.50-792850","identifier":[{"id":"84946029960","type":"scopus"},{"id":"25629994","type":"pmid"}],"ids":["aau-46d9dba2-828a-428b-a003-b42d2b7a4d78","au-81189750-9f11-47ed-b80d-ff3d5d508d6d","sdu-ad5ac118-7170-460b-abdc-27bdf84710e2"],"keyword":["*age aged albumin blood level article autologous stem cell transplantation cancer combination chemotherapy cancer mortality *cancer registry cancer survival controlled study female follow up hemoglobin blood level human *International Prognostic Index lactate dehydrogenase blood level *large cell lymphoma/dt [Drug Therapy] lymphocyte count major clinical study male priority journal albumin/ec [Endogenous Compound] cyclophosphamide/cb [Drug Combination] cyclophosphamide/dt [Drug Therapy] doxorubicin/cb [Drug Combination] doxorubicin/dt [Drug Therapy] hemoglobin/ec [Endogenous Compound] immunoglobulin G/ec [Endogenous Compound] lactate dehydrogenase/ec [Endogenous Compound] prednisone/cb [Drug Combination] prednisone/dt [Drug Therapy] rituximab/cb [Drug Combination] rituximab/dt [Drug Therapy] vincristine/cb [Drug Combination] vincristine/dt [Drug Therapy]","Adolescent","Adult","Age Factors","Aged","Aged, 80 and over","Antineoplastic Combined Chemotherapy Protocols/therapeutic use","Cohort Studies","Combined Modality Therapy","Denmark","Diffuse large B-cell lymphoma","Female","Humans","Kaplan-Meier Estimate","Lymphoma, Large B-Cell, Diffuse/diagnosis","Male","Middle Aged","Multivariate Analysis","Outcome Assessment, Health Care/methods","Prognosis","Proportional Hazards Models","Registries/statistics & numerical data","Stem Cell Transplantation/methods","Young Adult","prognostic index","rituximab","treatment"],"lang":"English","level":"Scientific","mra":["Medical Science","Social Science"],"noi":["Global-Local-2-6-B8BD2E8A2575C3C845C3E3239AFA35B6"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.3109/10428194.2015.1010078","version":"Published Version"}],"oai":{"class":"Unused","mra":["Social Science (SOC)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Herlev Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, D