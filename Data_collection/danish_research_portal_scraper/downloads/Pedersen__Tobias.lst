ssue":"9","journal":"Cells","paperid":"998","status":"p","title":"Cells","volume":"8"},"review":"Peer Reviewed","scoID":["2-s2.0-85083694995"],"search":{"DAF":["All Danish Affiliations","All Non-Profit Organisations","All Universities","DI-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Non-Profit Organisations","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-efa0d0ff-f274-4873-a191-6b94e481bd19"],"src":["KU University of Copenhagen"],"title":"Capture and Detection of Circulating Glioma Cells Using the Recombinant VAR2CSA Malaria Protein","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-536429","year":"2019","yearsub":"2019"}
{"abstract":"The appearance of rich and diverse funerary practices is one of the hallmarks of the Late Epipalaeolithic Natufian in the Levant. Numerous burials at a number of sites excavated mostly in the Mediterranean zone of the southern Levant have fed into the interpretation of the Natufian as a sedentary society of complex hunter-gatherers. Here, we report on the human remains recovered from Shubayqa 1, a well-dated early to late Natufian site in northeast Jordan. The majority of the minimum of 23 individuals that are represented are perinates and infants, which represents an atypical population profile. Ground stone artifacts and traces of colorants are associated with some of these individuals, providing a rare insight into funerary treatment of subadults in Natufian contexts. We interpret the Shubayqa 1 evidence in the light of current and ongoing debates concerning Natufian burial practices and the issue of social complexity.","author_count":7,"contributors":["Richter, Tobias","Bocaege, Emmy","Ilsøe, Peter Carsten","Ruter, Anthony Henry","Pantos, George Alexis","Pedersen, Patrick Nørskov","Yeomans, Lisa Marie"],"cuid":["S01-000.00-394060"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"ochre ground stone and wrapping the dead in the late epipalaeolithic natufian levant revealing the funerary practices at shubayqa 000000000001 jordan","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/226494746/Shubayqa_1_burials_and_ochre_final.docx","version":"Pre-print"},"id":"S01-000.00-394060","identifier":[{"id":"85071286163","type":"scopus"}],"ids":["ku-00fd71e1-ecb2-4632-b16d-20e57736a2a1"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-4-2F7490586471094836E060F915B6EE97"],"oa_link":[{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/226494746/Shubayqa_1_burials_and_ochre_final.docx","version":"Pre-print"}],"oai":{"class":"Realised","mra":["Humanities (HUM)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Humanities, Department of Cross-Cultural and Regional Studies"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Tobias","key":"richterpau","last":"Richter","locid":"eacd6ca8-b280-46dd-bd5c-7405e386b59b","name":"Richter, Tobias","orcid":"0000-0001-9902-8852","rank":1,"rolecode":"pau"},{"affno":"","first":"Emmy","key":"bocaegepau","last":"Bocaege","name":"Bocaege, Emmy","rank":2,"rolecode":"pau"},{"affno":"1","first":"Peter Carsten","key":"ilsøepau","last":"Ilsøe","locid":"b00d03eb-f9c8-43f3-bca4-9512ca2cd078","name":"Ilsøe, Peter Carsten","rank":3,"rolecode":"pau"},{"affno":"1","first":"Anthony Henry","key":"ruterpau","last":"Ruter","locid":"22f7e05e-c38b-4183-a17f-4e45399d3831","name":"Ruter, Anthony Henry","rank":4,"rolecode":"pau"},{"affno":"","first":"George Alexis","key":"pantospau","last":"Pantos","name":"Pantos, George Alexis","rank":5,"rolecode":"pau"},{"affno":"1","first":"Patrick Nørskov","key":"pedersenpau","last":"Pedersen","locid":"3bc10786-6db0-43a3-a028-9de1697afb13","name":"Pedersen, Patrick Nørskov","orcid":"0000-0001-9843-0858","rank":6,"rolecode":"pau"},{"affno":"1","first":"Lisa","key":"yeomanspau","last":"Yeomans","locid":"4cebfae3-972c-4422-8bf7-18436ba02870","name":"Yeomans, Lisa Marie","name_org":"Yeomans, Lisa","rank":7,"rolecode":"pau"}],"pub":{"doi":"10.1080/00934690.2019.1645546","issn":