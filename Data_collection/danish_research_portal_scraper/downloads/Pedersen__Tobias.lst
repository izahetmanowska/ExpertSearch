":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anders Branth","key":"pedersenpau","last":"Pedersen","locid":"fa7986ee-07bb-4100-a9e9-813f30075460","name":"Pedersen, Anders Branth","orcid":"0000-0002-4163-5649","rank":11,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Kaja","key":"petersenpau","last":"Petersen","name":"Petersen, Kaja","rank":12,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Katarzyna","key":"zagórskapau","last":"Zagórska","name":"Zagórska, Katarzyna","rank":13,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-ed8a634b-efdb-47f5-a97f-cfe430481c0a"],"src":["AU Aarhus University"],"title":"Exploring farmers' preferences for implementing agri-environmental schemes - a cross country study","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-264894","year":"2018","yearsub":"2018"}
{"abstract":"We apply the concept of carry, which has been studied almost exclusively in currency markets, to any asset. A security’s expected return is decomposed into its “carry,” an ex-ante and model-free characteristic, and its expected price appreciation. Carry predicts returns cross-sectionally and in time series for a host of different asset classes, including global equities, global bonds, commodities, US Treasuries, credit, and options. Carry is not explained by known predictors of returns from these asset classes, and it captures many of these predictors, providing a unifying framework for return predictability. We reject a generalized version of Uncovered Interest Parity and the Expectations Hypothesis in favor of models with varying risk premia, in which carry strategies are commonly exposed to global recession, liquidity, and volatility risks, though none fully explains carry’s premium.","author_count":4,"contributors":["Koijen, Ralph S.J.","Moskowitz, Tobias","Pedersen, Lasse Heje","Vrugt, Evert B."],"cuid":["S01-000.00-297102"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","Europe, EU","OECD"],"country":["Netherlands","United States"],"glorg":["All Global Affiliations","New York University","Vrije Universiteit Amsterdam","Yale University"],"keyword":["Bonds","Carry trade","Commodities","Corporate bonds","Currencies","Liquidity risk","Options","Predictability","STOCKS","Volatility risk"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"pr","rtype":["clu"],"sorti":"carry","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://research-api.cbs.dk/ws/files/57294842/lasse_heje_pedersen_et_al_carry_acceptedmanuscript.pdf","version":"Authors Final Version"},"id":"S01-000.00-297102","identifier":[{"id":"85032953445","type":"scopus"}],"ids":["cbs-e45c0c6b-7b17-4558-b39c-5cd567e3a3b6"],"keyword":["Bonds","Carry trade","Commodities","Corporate bonds","Currencies","Liquidity risk","Options","Predictability","Stocks","Volatility risk"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-4-9B92ACBAB698EC93852E9B1976B74237"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://research-api.cbs.dk/ws/files/57294842/lasse_heje_pedersen_et_al_carry_acceptedmanuscript.pdf","version":"Authors Final Version"}],"oai":{"class":"Blocked","mra":["Social Science (SOC)"],"yearPub":"2018","yearSub":"2017"},"org":[{"affno":"1","country":"us","key":"new york university","loc":["United States","America, North","OECD"],"name":"New York University","used":1},{"affno":"2","country":"us","key":"yale university","loc":["United States","America, North","OECD"],"name":"Yale University","used":1},{"affno":"3","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Finance"],"nora_code":"DI-U-CBS","used":1},{"affno":"4","country":"nl","key":"vrije universiteit amsterdam","loc":["Netherlands","Europe, EU","OECD"],"name":"Vrije Universiteit Amsterdam","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Ralph S.J.","key":"koijenpau","last":"Koijen","name":"Koijen, Ralph S.J.","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Tobias","key":"moskowitzpau","last":"Moskowitz","name":"Moskowitz, Tobias","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Lasse Heje","key":"pedersenpau","last":"Pedersen","locid":"cb7f3ab8-aada-4653-8366-cd5a05f54f56","name":"Pedersen, Lasse Heje","orcid":"0000-0001-7126-5530","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Evert B.","key":"vrugtpau","last":"Vrugt","name":"Vrugt, Evert B.","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.jfineco.2017.11.002","issn":["0304405X"],"issue":"2","journal":"Journal of Financial Economics","pages":"197-225","publisher":"Elsevier","status":"p","title":"Journal of Financial Economics","volume":"127"},"review":"Peer Reviewed","scoID":["2-s2.0-85032953445"],"search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["cbs-e45c0c6b-7b17-4558-b39c-5cd567e3a3b6"],"src":["CBS Copenhagen Business School"],"title":"Carry","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-297102","year":"2018","yearsub":"2017"}
{"abstract":"Hearing-aid users have reported an increased satisfaction since digital technology and advanced signal processing became available in hearing aids. However, many users still experience difficulties in noisy environments and in complex listening scenarios. Although numerous parameters can be adjusted to provide an individualized hearing solution, hearing-aid fitting currently consists of: 1) the gain prescription and adjustment based on the pure-tone audiogram, 2) the activation of advanced features on-demand, such as beamforming and noise reduction. In a previous study [1], a novel approach for auditory profiling was suggested, where the hearing deficits were characterized according to two types of distortion. This allowed the classification of listeners into four auditory profiles according to a high/low degree of hearing distortions along the two dimensions. The aim of the present study was to evaluate different hearing-aid compensation strategies that may fit the needs of different auditory profiles via technical measures. A hearing-aid simulator, consisting of beamforming, noise reduction, and dynamic range compression, was used to test which parameter spaces and outcome measures may be of interest for a “profile-based hearing-aid fitting”. The simulator consists of two dummy behind-the-ear hearing aids and off-line sound processing performed on a personal computer. Technical measures, such as signal-to-noise ratio (SNR) improvement, envelope degradation, and a metric of spectral distortions, were used to evaluate the effects of different signal processing strategies on the signal at the output of the simulator. Several parameter settings were evaluated using speech in the presence of various interferers at different SNRs. Here, the results of this technical evaluation are presented and discussed, with a view towards identifying the effective compensation strategies for different auditory profiles.","author_count":11,"contributors":["Sanchez Lopez, Raul","Fereczkowski, Michal","Bianchi, Federica","Piechowiak, Tobias","Hau, Ole","Pedersen, Michael Syskind","Behrens, Thomas","Neher, Tobias","Dau, Torsten","Santurette, Sébastien"],"cuid":["S02-085.00-036887"],"event":{"end":"2018-05-31","place":"Hersonissos, Crete, gr","start":"2018-05-27","title":"Euronoise 2018","year":"2018"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH","DI-PR-OTI","DI-PR-WID"],"U":["DI-U-ALL","DI-U-DTU","DI-U-SDU"]},"level3all":["DI-PR-OTH","DI-PR-OTI","DI-PR-WID","DI-U-DTU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"technical evaluation of hearing aid fitting parameters for different auditory profiles","src":["dtu","sdu"],"src-code":["DI-U-DTU","DI-U-SDU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/148465806/66_Euronoise2018.pdf","version":"Published Version"},"id":"S02-085.00-036887","ids":["dtu-bd792353-2350-4dfe-b702-e10cd45b0eee","sdu-792dfc34-036b-4344-9319-41ab74febac0"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Local-1-2-331EF56F6F7F484843AFFEF008699621"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/148465806/66_Euronoise2018.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Electrical Engineering","Technical University of Denmark, Department of Electrical Engineering, Hearing Systems"],"