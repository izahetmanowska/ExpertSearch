"2020"}
{"abstract":"Measuring vital signs is central to medical practice, but they are difficult to monitor in awake laboratory animals. We examined the feasibility of a noninvasive device for telemetric assessment of respiration rate, heart rate, temperature and movement in pigs. Awake piglets were monitored continuously for 31 h (interquartile range, 7) before (n = 4) and after (n = 3) surgery. Data quality was sufficient for determination of all parameters. We conclude that continuous, noninvasive monitoring of pigs is possible by using the evaluated device.","author_count":7,"contributors":["Bøgh, Nikolaj","Agger, Peter","Omann, Camilla","Skov, Martin Nors","Laustsen, Christoffer","Wang, Tobias","Pedersen, Michael"],"cuid":["S01-000.00-195317"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Blood flow","ECG","Heart Rate","Pressure"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"new device for noninvasive telemetric monitoring of vital signs in healthy and newly operated piglets","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC6978578/pdf/jaalas202000090.pdf","version":"Published Version"},"id":"S01-000.00-195317","identifier":[{"id":"000510023700012","type":"wos"},{"id":"31806077","type":"pmid"},{"id":"85078683541","type":"scopus"},{"id":"PMC6978578","type":"pmcid"}],"ids":["au-739f60f2-2f7c-4246-a8d6-1729a4de4e59"],"keyword":["BLOOD-FLOW","ECG","HEART-RATE","JOINT WORKING GROUP","PRESSURE"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-3-6B158F756BC2AE44938D40D68500CA09"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC6978578/pdf/jaalas202000090.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Social Science (SOC)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The MR Research Centre"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Nikolaj","key":"bøghpau","last":"Bøgh","locid":"87f6e435-1669-4562-b77e-91f068a788f8","name":"Bøgh, Nikolaj","orcid":"0000-0002-0321-3269","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter","key":"aggerpau","last":"Agger","locid":"d2d20d5f-a4c1-484c-980c-0fc1b52bad0c","name":"Agger, Peter","orcid":"0000-0002-7338-6624","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Camilla Omann","key":"christensenpau","last":"Christensen","locid":"e9412b83-a501-4552-9b83-a4c82148cef3","name":"Omann, Camilla","name_org":"Christensen, Camilla Omann","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Martin N","key":"skovpau","last":"Skov","locid":"0a69254e-d5e4-44c6-a283-27be59fb7de4","name":"Skov, Martin Nors","name_org":"Skov, Martin N","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Christoffer","key":"laustsenpau","last":"Laustsen","locid":"ba5f7084-cbbb-4c1a-9fb6-85cce410d52a","name":"Laustsen, Christoffer","orcid":"0000-0002-0317-2911","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Tobias","key":"wangpau","last":"Wang","locid":"7a3d91ab-5dbf-46e4-bc6e-634e16bd8d80","name":"Wang, Tobias","orcid":"0000-0002-4350-3682","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Michael","key":"pedersenpau","last":"Pedersen","locid":"871199c4-33bb-4fac-95ef-9a2266f30695","name":"Pedersen, Michael","orcid":"0000-0002-1146-0382","rank":7,"rolecode":"pau"}],"pmid":["31806077"],"pub":{"doi":"10.30802/aalas-jaalas-19-000052","issn":["15596109"],"issue":"1","journal":"Journal of the American Association for Laboratory Animal Science","pages":"90-93","publisher":"American Association for Laboratory Animal Science","status":"p","title":"Journal of the American Association for Laboratory Animal Science","volume":"59"},"review":"Peer Reviewed","scoID":["2-s2.0-85078683541"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-739f60f2-2f7c-4246-a8d6-1729a4de4e59"],"src":["AU Aarhus University"],"title":"New Device for Noninvasive Telemetric Monitoring of Vital Signs in Healthy and Newly Operated Piglets","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-195317","year":"2020","yearsub":"2020"}
{"abstract":"Myeloid and lymphoid malignancies are postulated to have distinct pathogenic mechanisms. The recent observation that patients with a myeloproliferative neoplasm have an increased risk of developing lymphoproliferative malignancies has challenged this assumption. We collected a nationwide cohort of patients with both malignancies. Patients diagnosed between 1990 and 2015 were identified through the national Danish Pathology Registry. We identified 599 patients with a myeloproliferative neoplasm and a concomitant or subsequent diagnosis of lymphoma. Histopathological review of the diagnostic samples from each patient led to a final cohort of 97 individuals with confirmed dual diagnoses of myeloproliferative neoplasm and lymphoma. The age range at diagnosis of these individuals was 19-94 years (median: 71 years). To avoid the inclusion of cases of therapy-induced myeloproliferative neoplasm occurring in patients previously treated for lymphoma, only patients with myeloproliferative neoplasm diagnosed unequivocally before the development of lymphoma were included. The average time interval between the diagnoses of the two malignancies was 1.5 years. In the majority of patients (90%) both diagnoses were established within 5 years of each other. Among the lymphoma entities, the frequency of peripheral T-cell lymphomas was markedly increased. Interestingly, all but one of the T-cell lymphomas were of angioimmunoblastic type. These findings suggest that a myeloproliferative neoplasm and lymphoproliferative malignancy developing in the same patient may have common pathogenic events, possibly already at the progenitor level. We believe that the molecular characterization of the newly developed biorepository will help to highlight the mechanisms driving the genesis and clonal evolution of these hematopoietic malignancies.","author_count":30,"contributors":["Holst, Johanne M","Plesner, Trine L","Pedersen, Martin B","Frederiksen, Henrik","Møller, Michael B","Clausen, Michael R","Hansen, Marcus C","Hamilton-Dutoit, Stephen Jacques","Nørgaard, Peter","Johansen, Preben","Eberlein, Tobias Ramm","Mortensen, Bo K","Mathiasen, Gustav","Øvlisen, Andreas Kiesbye","Wang, Rui","Wang, Chao","Zhang, Weiwei","Ommen, Hans Beier","Stentoft, Jesper","Ludvigsen, Maja","Tam, Wayne","Chan, Wing C","Inghirami, Giorgio","d'Amore, Francesco"],"cuid":["S04-099.82-007904"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"continent":["America, North","OECD"],"corresponding_author":["d'Amore, Francesco"],"country":["United States"],"glorg":["All Global Affiliations","City of Hope National Med Center","City of Hope National Medical Center","Cornell University","University of Nebraska","University of Nebraska Medical Center","Weill Cornell Medical College","Weill Cornell Medicine"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"myeloproliferative and lymphoproliferative malignancies occurring in the same patient a nationwide discovery cohort","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.3324/haematol.2019.225839","version":"Published Version"},"id":"S04-099.82-007904","identifier":[{"id":"31780632","type":"pmid"},{"id":"85092239455","type":"scopus"},{"id":"33054083","type":"pmid"},{"id":"PMC7556673","type":"pmcid"}],"ids":["aau-a39be06f-6f21-487d-b430-7c8e96e3610f","au-cd69025d-828c-4cec-909f-7c607b64dd46","ku-1f2f9c67-0d08-426e-90e0-e8cef635cf67","sdu