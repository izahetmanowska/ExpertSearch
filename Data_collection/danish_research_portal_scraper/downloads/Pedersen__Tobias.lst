nk":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Signe Vesterskov","key":"pedersenpau","last":"Pedersen","name":"Pedersen, Signe Vesterskov","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Tobias Wang","key":"nielsenpau","last":"Nielsen","locid":"7a3d91ab-5dbf-46e4-bc6e-634e16bd8d80","name":"Wang, Tobias","name_org":"Nielsen, Tobias Wang","orcid":"0000-0002-4350-3682","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Nini Skovgaard","key":"jensenpau","last":"Jensen","locid":"cb960fae-3427-4fcb-8af8-741a3a233fc1","name":"Jensen, Nini Skovgaard","rank":5,"rolecode":"pau"}],"pmid":["22422667"],"pub":{"doi":"10.1152/ajpregu.00661.2011","issn":["03636119","15221490"],"issn_org":["03636119"],"issue":"10","journal":"American Journal of Physiology: Regulatory, Integrative and Comparative Physiology","publisher":"American Physiological Society","status":"p","title":"American Journal of Physiology: Regulatory, Integrative and Comparative Physiology","volume":"302"},"review":"Peer Reviewed","scoID":["2-s2.0-84861114044"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-62e096db-c046-443b-9e72-c7db3f8727fc"],"src":["AU Aarhus University"],"title":"Humoral regulation of heart rate during digestion in pythons (Python molurus and Python regius)","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-185787","year":"2012","yearsub":"2012"}
{"abstract":"We document significant “time series momentum” in equity index, currency, commodity, and bond futures for each of the 58 liquid instruments we consider. We find persistence in returns for one to 12 months that partially reverses over longer horizons, consistent with sentiment theories of initial under-reaction and delayed over-reaction. A diversified portfolio of time series momentum strategies across all asset classes delivers substantial abnormal returns with little exposure to standard asset pricing factors and performs best during extreme markets. Examining the trading activities of speculators and hedgers, we find that speculators profit from time series momentum at the expense of hedgers.","author_count":3,"contributors":["Moskowitz, Tobias J.","Ooi, Yao Hua","Pedersen, Lasse Heje"],"cuid":["S01-000.00-278986"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["AQR Capital Management","All Global Affiliations","University of Chicago"],"keyword":["Asset pricing","Futures pricing","International financial markets","Market efficiency","Trading volume"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"pr","rtype":["clu"],"sorti":"time series momentum","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://research-api.cbs.dk/ws/files/58851003/time_series_momentum_lasse_heje.pdf","version":"Published Version"},"id":"S01-000.00-278986","identifier":[{"id":"84858159624","type":"scopus"}],"ids":["cbs-25e54f58-8ece-4423-9d6d-cdc5a1952f99"],"keyword":["Asset pricing","Futures pricing","International financial markets","Market efficiency","Trading volume"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-2-CF53791F007CCBB226204CC55100476D"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://research-api.cbs.dk/ws/files/58851003/time_series_momentum_lasse_heje.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"us","key":"university of chicago","loc":["United States","America, North","OECD"],"name":"University of Chicago","used":1},{"affno":"2","country":"us","key":"aqr capital management","loc":["United States","America, North","OECD"],"name":"AQR Capital Management","used":1},{"affno":"3","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Finance"],"nora_code":"DI-U-CBS","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Tobias J.","key":"moskowitzpau","last":"Moskowitz","name":"Moskowitz, Tobias J.","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Yao Hua","key":"ooipau","last":"Ooi","name":"Ooi, Yao Hua","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Lasse","key":"hejepedersenpau","last":"Heje Pedersen","locid":"cb7f3ab8-aada-4653-8366-cd5a05f54f56","name":"Pedersen, Lasse Heje","name_org":"Heje Pedersen, Lasse","orcid":"0000-0001-7126-5530","rank":3,"rolecode":"pau"}],"pub":{"issn":["0304405X"],"issue":"2","journal":"Journal of Financial Economics","pages":"228-250","publisher":"Elsevier","status":"p","title":"Journal of Financial Economics","volume":"104"},"review":"Peer Reviewed","scoID":["2-s2.0-84858159624"],"search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["cbs-25e54f58-8ece-4423-9d6d-cdc5a1952f99"],"src":["CBS Copenhagen Business School"],"title":"Time Series Momentum","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-278986","year":"2012","yearsub":"2012"}
{"abstract":"BackgroundIn a large collaborative study (n > 50,000), common variants in the natriuretic peptide (NP) genes were found to be associated with circulating NP levels and also with blood pressure (BP) levels based on office BP measurements (OBPMs). It is unknown if determining an individual's BP by 24-h ambulatory BP measurements (ABPMs) will influence the effect of NP gene variations on BP levels.MethodsWe used rs632793 at the NPPB (NP precursor B) locus to investigate the relationship between genetically determined serum N-terminal pro-brain NP (NT-proBNP) concentrations and BP levels determined by both 24-h ABPMs and OBPMs in a population consisting of 1,397 generally healthy individuals taking no BP-lowering drugs.Resultsrs632793 was significantly correlated with serum Nt-proBNP levels (r = 0.10, P = 0.0003), and participants with the A:A genotype had lower serum Nt-proBNP levels than participants with the G:G genotype (geometric mean (95% confidence interval (CI)): 34.8 (31.5-38.4) pg/ml vs. 48.1 (41.9-55.3) pg/ml, P = 0.0002), but higher 24-h ambulatory BP levels (mean difference (95% CI): 2.0 (0.1-4.1) mm Hg, P = 0.043, for systolic BP and 1.7 (0.4-3.1) mm Hg, P = 0.011, for diastolic BP). Office BP decreased across the genotypes from A:A to G:G, but the differences did not reach statistical significance (P = 0.12).ConclusionsThis study suggests that 24-h ABPMs is a better method than OBPMs to detect significant differences in BP levels related to genetic variance and provides further evidence that the NP system plays an important role in BP regulation.American Journal of Hypertension 2012; doi:10.1038/ajh.2012.96.","author_count":14,"contributors":["Jeppesen, Jørgen","Nielsen, Søren J","Torp-Pedersen, Christian","Hansen, Tine W","Olsen, Michael H","Berg, Nikolaj D","Linneberg, Allan","Madsbad, Sten","Fenger, Mogens","Berg, Nikolaj D"],"cuid":["S02-081.21-043948"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS","DI-U-KU","DI-U-SDU"]},"level3all":["DI-U-CBS","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"genetic variation in the natriuretic peptide system circulating natriuretic peptide levels and blood pressure an ambulatory blood pressure study","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1038/ajh.2012.96","version":"Other Version"},"id":"S02-081.21-043948","identifier":[{"id":"84866390391","type":"scopus"},{"id":"22785411","type":"pmid"}],"ids":["ku-8236c45c-0c2e-4df3-8ac9-da0525836953","sdu-cd54bc9c-b3f4-449b-9d22-2e9f0a00b44f"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-4EA4C397F631CDA2150E346B187C6763"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1038/ajh.2012.96","version":"Other Version"}],"org":[{"affno":"1","country":"dk","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School"],"nora_code":"DI-U-CBS","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Endocrinology (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":3,"key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Section of Surgery and Internal Medicine"],"nora_code":"DI-U-KU"}],"person":[{"affno":"","first":"Jørgen L","key":"jeppesenjørgenpau","last":"Jeppesen","locid":"9568fb5e-c3f7-4045-ac14-13b8493fcd46","name":"Jeppesen, Jørgen","name_org":"Jeppesen, Jørgen L","rank":1,"rolecode":"pau"},{"affno":"","first":"Søren J","key":"nielsensørenjpau","last":"Nielsen","name":"Nielsen, Søren J","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Søren","key":"nielsensørenpau","last":"Nielsen","name":"Nielsen, Søren","rank":2,"rolecode":"pau"},{"affno":"","first":"Christian","key":"torppedersenchristianpau","last":"Torp-Pedersen","locid":"f71bedc6-3736-4559-b937-6a18e770616e","name":"Torp-Pedersen, Christian","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Christian Tobias","key":"torppedersenchristiantobiaspau","last":"Torp-Pedersen","name":"Torp-Pedersen, Christian Tobias","rank":3,"rolecode":"pau"},{"affno":"","first":"Tine W","key":"hansentinewpau","last":"Hansen","name":"Hansen, Tine W","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Tine","key":"hansentinepau","last":"Hansen","name":"Hansen, Tine","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Michael H","key":"olsenmichaelhechtpau","last":"Olsen","locid":"8ff309b5-8760-45c3-9bc6-41599369c816","name":"Olsen, Michael Hecht","name_org":"Olsen, Michael H","orcid":"0000-0003-2230-5780","rank":5,"rolecode":"pau"},{"affno":"","first":"Michael H","key":"olsenmichaelhpau","last":"Olsen","locid":"a6cc8358-e91d-487c-a11a-ff5eb0e0259c","name":"Olsen, Michael H","rank":5,"rolecode":"pau"},{"affno":"","first":"Nikolaj D","key":"bergnikolajdpau","last":"Berg","name":"Berg, Nikolaj D","rank":6,"rolecode":"pau"},{"affno":"","first":"Allan","key":"linnebergallanpau","last":"Linneberg","locid":"09da8aa6-fd95-4ace-a2f1-19f38d7d3f9e","name":"Linneberg, Allan","orcid":"0000-0002-0994-0184","rank":7,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Allan René","key":"linnebergallanrenépau","last":"Linneberg","name":"Linneberg, Allan René","rank":7,"rolecode":"pau"},{"affno":"","first":"Sten","key":"madsbadstenpau","last":"Madsbad","locid":"1018c708-245a-4057-9263-074578042385","name":"Madsbad, Sten","rank":8,"rolecode":"pau"},{"affno":"","first":"Mogens","key":"fengermogenspau","last":"Fenger","locid":"1b89734d-36e4-44c6-a0e1-256ebe8ebae2","name":"Fenger, Mogens","rank":9,"rolecode":"pau"}],"pmid":["22785411"],"pub":{"doi":"10.1038/ajh.2012.96","issn":["08957061","11395990"],"issn_org":["08957061"],"issue":"10","journal":"American Journal of Hypertension","pages":"1095-100","publisher":"Oxford University Press","status":"p","title":"American Journal of Hypertension","volume":"25"},"review":"Peer Reviewed","scoID":["2-s2.0-84866390391"],"search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-8236c45c-0c2e-4df3-8ac9-da0525836953","sdu-cd54bc9c-b3f4-449b-9d22-2e9f0a00b44f"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Genetic Variation in the Natriuretic Peptide System, Circulating Natriuretic Peptide Levels, and Blood Pressure : An Ambulatory Blood Pressure Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-081.21-043948","year":"2012","yearsub":"2012"}
{"abstract":"Excitation of localized and delocalized surface plasmon resonances can be used for turning excellent reflectors of visible light, such as gold and silver, into efficient absorbers, whose wavelength, polarization or angular bandwidths are however necessarily limited owing to the resonant nature of surface plasmon excitations involved. Nonresonant absorption has so far been achieved by using combined nano- and micro-structural surface modifications and with composite materials involving metal nanoparticles embedded in dielectric layers. Here we realize nonresonant light absorption in a well-defined geometry by using ultra-sharp convex metal grooves via adiabatic nanofocusing of gap surface plasmon modes excited by scattering off subwavelength-sized wedges. We demonstrate experimentally that two-dimensional arrays of sharp convex grooves in gold ensure efficient (>87%) broadband (450-850 nm) absorption of unpolarized light, reaching an average level of 96%. Efficient absorption of visible light by nanostructured metal surfaces open new exciting perspectives within plasmonics, especially for thermophotovoltaics.","author_count":10,"contributors":["Søndergaard, Thomas","Novikov, Sergey M.","Stær, Tobias Holmgaard","Eriksen, René L.","Beermann, Jonas","Han, Zhanghua","Pedersen, Kjeld","Bozhevolnyi, Sergey I."],"cuid":["S02-093.75-001525"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-AAU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"plasmonic black gold by adiabatic nanofocusing and absorption of light in ultra sharp convex grooves","src":["aau","sdu"],"src-code":["DI-U-AAU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-SA","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/144230132/ncomms1976.pdf","version":"Published Version"},"id":"S02-093.75-001525","identifier":[{"id":"22828629","type":"pmid"},{"id":"000306995000041","type":"wos"},{"id":"84864863660","type":"scopus"}],"ids":["aau-1e45aeec-7b7c-4959-8123-10a3e58d34c9","sdu-6af453ab-dda5-4527-b3d9-84767d0dc0d2"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-3E52834F4BB66E5C4BC430F9A570D454"],"oa_link":[{"access":"oa","license":"CC BY-NC-SA","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/144230132/ncomms1976.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-SA","type":"doi","url":"https://doi.org/10.1038/ncomms1976","version":"Other Version"},{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/66515542/S_ndergaard12NCOM_Plasmonic_black_gold_by_adiabatic_nanofocusing_and_absorption_of_light_in_ultra_sharp_convex_grooves.pdf","version":"Pre-print"},{"access":"oa","type":"rem","url":"http://www.nature.com/ncomms/journal/v3/n7/full/ncomms1976.html","version":"Other Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (ENG)","Aalborg University, The Faculty of Engineering and Science, Department of Physics and Nanotechnology"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Engineering, Institute of Sensors, Signals and Electrotechnics"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Thomas","key":"søndergaardpau","last":"Søndergaard","locid":"b4ea9ec0-4c28-4984-94e9-8d0848a0a7a1","name":"Søndergaard, Thomas","orcid":"0000-0002-5115-0450","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"T.","key":"sondergaardpau","last":"Sondergaard","name":"Sondergaard, T.","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"S. M.","key":"novikovpau","last":"Novikov","locid":"9fd19426-bd72-4038-8a2e-32aa0157215f","name":"Novikov, Sergey M.","name_org":"Novikov, S. M.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Tobias Holmgaard","key":"stærpau","last":"Stær","locid":"f9c73bfe-cf15-440a-9aca-290bb9e2f2a5","name":"Stær, Tobias Holmgaard","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"T.","key":"holmgaardpau","last":"Holmgaard","name":"Holmgaard, T.","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"R. L.","key":"eriksenpau","last":"Eriksen","locid":"b3e301d7-bbe7-448f-bb53-09968ed57b02","name":"Eriksen, René Lynge","name_org":"Eriksen, R. L.","orcid":"0000-0003-4405-5831","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"J.","key":"beermannpau","last":"Beermann","locid":"da4d107b-a5da-429d-ba3b-850b08b96322","name":"Beermann, Jonas","name_org":"Beermann, J.","orcid":"0000-0001-9809-2430","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Z. H.","key":"hanpau","last":"Han","locid":"323424cf-3068-4c29-a7ff-117d8e7eae99","name":"Han, Zhanghua","name_org":"Han, Z. H.","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kjeld","key":"pedersenpau","last":"Pedersen","locid":"ff5fc0ab-1fa1-47a2-916c-8b7556f2f938","name":"Pedersen, Kjeld","orcid":"0000-0002-6835-1566","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"S. I.","key":"bozhevolnyipau","last":"Bozhevolnyi","locid":"9df17db0-2e69-41ff-8a38-8738093f0385","name":"Bozhe