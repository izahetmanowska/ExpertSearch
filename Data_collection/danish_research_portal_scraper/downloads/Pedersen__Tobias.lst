ame":"Thøgersen, Ditte","orcid":"0000-0003-2929-8384","rank":3,"rolecode":"pau"},{"affno":"","first":"Ditte","key":"thøgersenpedh","last":"Thøgersen","name":"Thøgersen, Ditte","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Anne Reff","key":"pedersenpedh","last":"Pedersen","name":"Pedersen, Anne Reff","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"eisbn":["9788759341827"],"isbn":["9788759340400"],"pages":"179-197","place":"Frederiksberg","publisher":"Samfundslitteratur","status":"p","subtitle":"Organisering, praksis og værdiskabelse","title":"Ledelse af offentlig innovation"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","Copenhagen Business School","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["cbs-cf109d8b-7a2c-4798-9182-3790da0d786d"],"src":["CBS Copenhagen Business School"],"title":"Metoder til ledelse af hverdagsinnovation : Eksempler fra folkeskolen","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-295095","year":"2022","yearsub":"2022"}
{"abstract":"High entropy alloys (HEA) comprise a huge search space for new electrocatalysts. Next to element combinations, the optimization of the chemical composition is essential for tuning HEA to specific catalytic processes. Simulations of electrocatalytic activity can guide experimental efforts. Yet, the currently available underlying model assumptions do not necessarily align with experimental evidence. To study deviations of theoretical models and experimental data requires statistically relevant datasets. Here, a combinatorial strategy for acquiring large experimental datasets of multi-dimensional composition spaces is presented. Ru–Rh–Pd–Ir–Pt is studied as an exemplary, highly relevant HEA system. Systematic comparison with computed electrochemical activity enables the study of deviations from theoretical model assumptions for compositionally complex solid solutions in the experiment. The results suggest that the experimentally obtained distribution of surface atoms deviates from the ideal distribution of atoms in the model. Leveraging both advanced simulation and large experimental data enables the estimation of electrocatalytic activity and solid-solution stability trends in the 5D composition space of the HEA system. A perspective on future directions for the development of active and stable HEA catalysts is outlined.","author_count":10,"contributors":["Banko, Lars","Krysiak, Olga A.","Pedersen, Jack K.","Xiao, Bin","Savan, Alan","Löffler, Tobias","Baha, Sabrina","Rossmeisl, Jan","Schuhmann, Wolfgang","Ludwig, Alfred"],"cuid":["S01-000.00-518097"],"filters":{"added":"2022-04","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Materials Discovery and Interfaces, Institute for Materials, Ruhr University Bochum"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"unravelling composition activity stability trends in high entropy alloy electrocatalysts by using a data guided combinatorial synthesis strategy and computational modeling","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1002/aenm.202103312","version":"Published Version"},"id":"S01-000.00-518097","identifier":[{"id":"85122305178","type":"scopus"}],"ids":["ku-d0a5b245-4c10-486c-90d8-a9e31696dee6"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-2F8C989AB5F79DF54CB247554AFE7F3E"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1002/aenm.202103312","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/299690572/Advanced_Energy_Materials_2022_Banko_Unravelling_Composition_Activity_Stability_Trends_in_High_Entropy_Alloy.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Materials Discovery and Interfaces, Institute for Materials, Ruhr University Bochum"],"nora_code":"DI-OT","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Chemistry, Department of Chemistry"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Lars","key":"bankopau","last":"Banko","name":"Banko, Lars","rank":1,"rolecode":"pau"},{"affno":"1","first":"Olga A.","key":"krysiakpau","last":"Krysiak","name":"Krysiak, Olga A.","rank":2,"rolecode":"pau"},{"affno":"2","first":"Jack K.","key":"pedersenpau","last":"Pedersen","locid":"35e9bf13-527e-4534-a69c-d714f3d7f302","name":"Pedersen, Jack K.","rank":3,"rolecode":"pau"},{"affno":"1","first":"Bin","key":"xiaopau","last":"Xiao","name":"Xiao, Bin","rank":4,"rolecode":"pau"},{"affno":"1","first":"Alan","key":"savanpau","last":"Savan","name":"Savan, Alan","rank":5,"rolecode":"pau"},{"affno":"1","first":"Tobias","key":"löfflerpau","last":"Löffler","name":"Löffler, Tobias","rank":6,"rolecode":"pau"},{"affno":"1","first":"Sabrina","key":"bahapau","last":"Baha","name":"Baha, Sabrina","rank":7,"rolecode":"pau"},{"affno":"2","first":"Jan","key":"rossmeislpau","last":"Rossmeisl","locid":"67d41da5-3458-43c8-8ea7-d2b1a80f1f8d","name":"Rossmeisl, Jan","orcid":"0000-0001-7749-6567","rank":8,"rolecode":"pau"},{"affno":"1","first":"Wolfgang","key":"schuhmannpau","last":"Schuhmann","name":"Schuhmann, Wolfgang","rank":9,"rolecode":"pau"},{"affno":"1","first":"Alfred","key":"ludwigpau","last":"Ludwig","name":"Ludwig, Alfred","rank":10,"rolecode":"pau"}],"pub":{"doi":"10.1002/aenm.202103312","issn":["16146832","16146840"],"issn_org":["16146832"],"issue":"8","journal":"Advanced Energy Materials","paperid":"2103312","status":"p","title":"Advanced Energy Materials","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-85122305178"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-d0a5b245-4c10-486c-90d8-a9e31696dee6"],"src":["KU University of Copenhagen"],"title":"Unravelling Composition–Activity–Stability Trends in High Entropy Alloy Electrocatalysts by Using a Data‐Guided Combinatorial Synthesis Strategy and Computational Modeling","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-518097","year":"2022","yearsub":"2022"}
{"abstract":"Genomic alterations and altered cell wall structure in daptomycin-resistant Enterococcus faecium revealed by comparison of isolates before and after exposure to daptomycin. Daptomycin is a cyclic lipopeptide used in the treatment of vancomycin-resistant Enterococcus faecium (VREfm). However, the development of daptomycin-resistant VREfm challenges the treatment of nosocomial VREfm infections. Resistance mechanisms of daptomycin are not fully understood. Here, we analyzed the genomic changes leading to a daptomycin-susceptible VREfm isolate becoming resistant after 50 days of daptomycin and linezolid combination therapy. A total of seven isogenic VREfm isolates from the same patient (daptomycin-susceptible and daptomycin-resistant) were analyzed using Illumina whole genome sequencing, and two isolates were further characterized with Nanopore sequencing. One nonsynonymous SNP in the rpoC gene previously shown to harbor mutations in daptomycin-resistant VREfm was identified in the daptomycin-resistant isolates. Whole genome comparative analysis identified the loss of a 46.5 kb fragment, duplication of a 29.7 kb fragment, and integration of two plasmids upon acquisition of daptomycin resistance. Transmission electron microscopy showed similar alterations in cell morphology and cell wall structure as have previously been described in daptomycin-resistant E. faecalis.","author_count":8,"contributors":["Mollerup, Sarah","Elmeskov, Christine","Pinholt, Mette","Steen Sejersen, Tobias","Pedersen, Martin S.","Worning, Peder","Frees, Dorte","Westh, Henrik"],"cuid":["S01-000.00-518905"],"filters":{"added":"2022-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Cell envelope","Enterococcus faecium","Mechanisms","Read alignment","Susceptibility","VRE","Vancomycin resistance"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"rapid i in vivo i development of resistance to daptomycin in vancomycin resistant i enterococcus faecium i due to genomic alterations","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-518905","identifier":[{"id":"85144813029","type":"scopus"},{"id":"35922088","type":"pmid"},{"id":"000840134200001","type":"wos"}],"ids":["ku-d1f9b607-2082-433d-9e4e-de4dd1590c30"],"keyword":["Enterococcus faecium","MECHANISMS","READ ALIGNMENT","SUSCEPTIBILITY","VRE","cell envelope","daptomycin resistance","mannose pathway","rpoC","vancomycin resistance"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-625DB0E63E9CB98EB881E5BE3CD72A1A"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Amager and Hvidovre"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Biomedical Sciences","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Biomedical Sciences, Core Facility for Integrated Microscopy"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Sarah","key":"molleruppau","last":"Mollerup","name":"Mollerup, Sarah","rank":1,"rolecode":"pau"},{"affno":"1","first":"Christine","key":"elmeskovpau","last":"Elmeskov","name":"Elmeskov, Christine","rank":2,"rolecode":"pau"},{"affno":"1","first":"Mette","key":"pinholtpau","last":"Pinholt","name":"Pinholt, Mette","rank":3,"rolecode":"pau"},{"affno":"2","country":"dk","first":"Tobias S.","key":"sejersenpau","last":"Sejersen","locid":"db06435a-8113-4a60-8657-606e762f059d","name":"Steen Sejersen, Tobias","name_org":"Sejersen, Tobias S.","rank":4,"rolecode":"pau"},{"affno":"1","first":"Martin S.","key":"pedersenpau","last":"Pedersen","name":"Pedersen, Martin S.","rank":5,"rolecode":"pau"},{"affno":"1","first":"Peder","key":"worningpau","last":"Worning","name":"Worning, Peder","rank":6,"rolecode":"pau"},{"affno":"2","first":"Dorte","key":"freespau","last":"Frees","locid":"3c8c5596-8ecf-42c8-9a46-f67c6d95fed3","name":"Frees, Dorte","rank":7,"rolecode":"pau"},{"affno":"2","first":"Henrik","key":"westhpau","last":"Westh","locid":"5ed71556-672c-4f57-95de-3abba6b821ea","name":"Westh, Henrik","rank":8,"rolecode":"pau"}],"pmid":["35922088"],"pub":{"doi":"10.1093/femsle/fnac063","issn":["03781097","15746968"],"issn_org":["03781097"],"issue":"1","journal":"FEMS Microbiology Letters","paperid":"063","status":"p","title":"FEMS Microbiology Letters","volume":"369"},"review":"Peer Reviewed","scoID":["2-s2.0-85144813029"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-d1f9b607-2082-433d-9e4e-de4dd1590c30"],"src":["KU University of Copenhagen"],"title":"Rapid <i>in vivo</i> development of resistance to daptomycin in vancomycin-resistant <i>Enterococcus faecium</i> due to genomic alterations","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-518905","year":"2022","yearsub":"2022"}
{"abstract":"Refractory tungsten (W) plays an important role in high temperature photonic/plasmonic applications. Previously room temperature bulk single/poly-crystalline optical constants were extensively used to calculate the optical properties of W nanostructures at high temperatures. This might lead to a significant deviation between the predicted and measured optical properties due to the exclusion of electron–phonon interaction, as well as grain-boundary and surface-scattering. Herein, we show experimentally, how film thickness and temperature affects the optical losses in W. A drastic increase in the effective electron collision frequency is observed with decreasing the film thickness down to 5 nm, due to the grain-boundary and surface-scattering mechanisms. At sufficiently high temperatures (greater than 200 °C for W), the electron–phonon interaction eventually becomes the dominant mechanism, linearly increasing collision frequency with temperature, and it is independent of the geometry of the thin film structure. The impact of thickness and temperature-dependent optical properties of W is showcased with a hyperbolic 1D metamaterial structure acting as a thermophotovoltaic emitter. This work opens new directions in accurate prediction of the optical properties of nanostructures and design of efficient devices in various applications, such as aerospace, energy-efficient lighting, radiative cooling and energy harvesting, by incorporating thickness and temperature-dependent optical constants.","author_count":12,"contributors":["Arya, Mahima","Ganguly, Ankita","Krishnamurthy, Gnanavel V.","Rout, Surya S.","Gurevich, Leonid","Krekeler, Tobias","Ritter, Martin","Pedersen, Kjeld","Störmer, Michael","Yu Petrov, Alexander","Eich, Manfred","Chirumamilla, Manohar"],"cuid":["S01-000.00-667625"],"filters":{"added":"2023-06","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","OECD"],"corresponding_author":["Chirumamilla, Manohar"],"country":["Germany","Russia"],"glorg":["All Global Affiliations","Hamburg University of Technology","Helmholtz-Zentrum Hereon","St. Petersburg National Research University of Information Technologies, Mechanics and Optics (ITMO)"],"keyword":["Electron phonon interaction","High temperature stability","Surface scattering","Thermophotovoltaics","Thin films","Tungsten"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"which factor determines the optical losses in refractory tungsten thin films at high temperatures","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1016/j.apsusc.2022.152927","version":"Published Version"},"funding_acknowledgement":["The authors gratefully acknowledge financial support from the German Research Foundation (DFG) via SFB 986 ‘Tailor-Made Multi-Scale Materials Systems: M3’, Project-ID 192346071, and projects C1, C7 and Z3. K. Pedersen acknowledges the financial support from the Novo Nordisk, grant number NNF20OC0064735."],"id":"S01-000.00-667625","identifier":[{"id":"85125905664","type":"scopus"}],"ids":["aau-d8c550eb-8018-462b-8c4a-2545d51a26c3"],"keyword":["Electron–phonon interaction","Grain boundary scattering","High temperature stability","Surface scattering","Thermophotovoltaics","Thin films","Tungsten"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-6D7815ACA7E7C2CDAA2B924226AAE09A"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/529841702/1_s2.0_S0169433222005013_main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1016/j.apsusc.2022.152927","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"de","key":"hamburg university of technology","loc":["Germany","Europe, EU","OECD"],"name":"Hamburg University of Technology","used":1},{"affno":"2","country":"de","key":"helmholtz zentrum hereon","loc":["Germany","Europe, EU","OECD"],"name":"Helmholtz-Zentrum Hereon","used":1},{"affno":"3","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, Department of Materials and Production","Aalborg University, The Faculty of Engineering and Science, Department of Materials and Production, Materials Science and Engineering","Aalborg University, The Faculty of Engineering and Science, Department of Materials and Production, Physics and Mechanics"],"nora_code":"DI-U-AAU","used":1},{"affno":"4","country":"ru","key":"st petersburg national research university of information technologies mechanics and optics","loc":["Russia","Europe, Non-EU"],"name":"St. Petersburg National Research University of Information Technologies, Mechanics and Optics (ITMO)","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Mahima","key":"aryapau","last":"Arya","name":"Arya, Mahima","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ankita","key":"gangulypau","last":"Ganguly","name":"Ganguly, Ankita","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Gnanavel V.","key":"krishnamurthypau","last":"Krishnamurthy","name":"Krishnamurthy, Gnanavel V.","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Surya S.","key":"routpau","last":"Rout","name":"Rout, Surya S.","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"c