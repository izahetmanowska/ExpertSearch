fno":"21 23","first":"Jonas","key":"bybjerggrauholmjonaspau","last":"Bybjerg-Grauholm","name":"Bybjerg-Grauholm, Jonas","rank":42,"rolecode":"pau"},{"affno":"","first":"Marie","key":"bækvadhansenmariepau","last":"Bækvad-Hansen","name":"Bækvad-Hansen, Marie","rank":43,"rolecode":"pau"},{"affno":"","first":"Christine Søholm","key":"hansenchristinesøholmpau","last":"Hansen","name":"Hansen, Christine Søholm","rank":44,"rolecode":"pau"},{"affno":"24","first":"Mark J.","key":"dalymarkjpau","last":"Daly","name":"Daly, Mark J.","rank":45,"rolecode":"pau"},{"affno":"24","first":"Benjamin M.","key":"nealebenjaminmpau","last":"Neale","name":"Neale, Benjamin M.","rank":46,"rolecode":"pau"},{"affno":"24","first":"Elise B.","key":"robinsonelisebpau","last":"Robinson","name":"Robinson, Elise B.","rank":47,"rolecode":"pau"},{"affno":"24","first":"Felecia","key":"cerratofeleciapau","last":"Cerrato","name":"Cerrato, Felecia","rank":48,"rolecode":"pau"},{"affno":"24","first":"Ashley","key":"dumontashleypau","last":"Dumont","name":"Dumont, Ashley","rank":49,"rolecode":"pau"},{"affno":"24","first":"Jacqueline","key":"goldsteinjacquelinepau","last":"Goldstein","name":"Goldstein, Jacqueline","rank":50,"rolecode":"pau"}],"pmid":["30258131"],"pub":{"doi":"10.1038/s41398-018-0229-0","issn":["21583188"],"issue":"1","journal":"Translational Psychiatry","pages":"204","paperid":"204","publisher":"Springer Nature","status":"p","title":"Translational Psychiatry","volume":"8"},"review":"Peer Reviewed","scoID":["2-s2.0-85054049851"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Non-Profit Organisations","All Universities","Central Denmark Region","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Non-Profit Organisations","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-a2b000ac-8836-4c89-aa14-85cf2b69a5aa","ku-74dfc2fc-cec0-4a83