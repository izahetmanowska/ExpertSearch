All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["cbs-6828c7f3-1c0b-48dc-b2ac-72de405e995b"],"src":["CBS Copenhagen Business School"],"title":"Selvledelse : Frihed og ansvar i offentlig service","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-285392","year":"2022","yearsub":"2022"}
{"abstract":"Silicon has been used in carbohydrate chemistry for half a century, but mostly as a protective group for sugar alcohols. Recently, the use of silicon has expanded to functionalization via C–H activation, conformational arming of glycosyl donors, and conformational alteration of carbohydrates. Silicon has proven useful as more than a protective group and during the last one and a half decades we have demonstrated how it influences both the reactivity of glycosyl donors and stereochemical outcome of glycosylations. Silicon can also be attached directly to the sugar C-backbone, which has even more pronounced effects on the chemistry and properties of the molecules. In this Account, we will give a tour through our work involving silicon and carbohydrates.","author_count":4,"contributors":["Bols, Mikael","Frihed, Tobias Gylling","Pedersen, Martin Jæger","Pedersen, Christian Marcus"],"cuid":["S01-000.00-530846"],"filters":{"added":"2022-04","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-LUND"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-PR-LUND","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"silylated sugars synthesis and properties","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-530846","identifier":[{"id":"85120166635","type":"scopus"}],"ids":["ku-e61adafe-74ee-43a9-a355-3c817163f34e"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-CEF1A9C787D03C2E760C47710329C625"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Chemistry, Department of Chemistry"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"lundbeck","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-LUND","l3nl":"Lundbeck Pharma","l3nn":"Lundbeck","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Lundbeck","namevar":["Lundbeck"],"nora_code":"DI-PR-LUND","used":1}],"person":[{"affno":"1","first":"Mikael","key":"bolsmikaelpau","last":"Bols","locid":"23a8a20e-b9f1-4bf5-ae25-3377249ae440","name":"Bols, Mikael","orcid":"0000-0002-6561-6952","rank":1,"rolecode":"pau"},{"affno":"2","first":"Tobias Gylling","key":"frihedtobiasgyllingpau","last":"Frihed","name":"Frihed, Tobias Gylling","rank":2,"rolecode":"pau"},{"affno":"1","first":"Martin Jæger","key":"pedersenmartinjægerpau","last":"Pedersen","locid":"3ef82cb4-633e-4006-8045-db697c3ce27e","name":"Pedersen, Martin Jæger","rank":3,"rolecode":"pau"},{"affno":"1","first":"Christian Marcus","key":"pedersenchristianmarcuspau","last":"Pedersen","locid":"994945e4-c86b-4440-b9bd-8117822c77db","name":"Pedersen, Christian Marcus","orcid":"0000-0003-4661-4895","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1055/s-0040-1719854","issn":["09365214","14372096"],"issn_org":["09365214"],"issue":"5","journal":"SYNLETT: Accounts and Rapid Communications in Chemical Synthesis","pages":"415-428","status":"p","title":"SYNLETT: Accounts and Rapid Communications in Chemical Synthesis","title_org":"Synlett","volume":"33"},"review":"Peer Reviewed","scoID":["2-s2.0-85120166635"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Lundbeck Pharma","Private Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-e61adafe-74ee-43a9-a355-3c817163f34e"],"src":["KU University of Copenhagen"],"title":"Silylated Sugars – Synthesis and Properties","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-530846","year":"2022","yearsub":"2022"}
{"abstract":"Background Combining the antibiotic azithromycin and hydroxychloroquine induces airway immunomodulatory effects, with the latter also having in vitro antiviral properties. This may improve outcomes in patients hospitalised for coronavirus disease 2019 (COVID-19). Methods Placebo-controlled double-blind randomised multicentre trial. Patients aged ≽18 years, admitted to hospital for ≼48 h (not intensive care) with a positive severe acute respiratory syndrome coronavirus 2 (SARS-CoV-2) reverse transcription PCR test were recruited. The intervention was 500 mg daily azithromycin for 3 days followed by 250 mg daily azithromycin for 12 days combined with 200 mg twice-daily hydroxychloroquine for all 15 days. The control group received placebo/placebo. The primary outcome was days alive and discharged from hospital within 14 days (DAOH14). Results After randomisation of 117 patients, at the first planned interim analysis, the data and safety monitoring board recommended stopping enrolment due to futility, based on pre-specified criteria. Consequently, the trial was terminated on 1 February 2021. 61 patients received the combined intervention and 56 patients received placebo. In the intervention group, patients had a median (interquartile range) 9.0 (3–11) DAOH14 versus 9.0 (7–10) DAOH14 in the placebo group (p=0.90). The primary safety outcome, death from all causes on day 30, occurred for one patient in the intervention group versus two patients receiving placebo (p=0.52), and readmittance or death within 30 days occurred for nine patients in the intervention group versus six patients receiving placebo (p=0.57). Conclusions The combination of azithromycin and hydroxychloroquine did not improve survival or length of hospitalisation in patients with COVID-19.","author_count":32,"contributors":["Sivapalan, Pradeesh","Suppli Ulrik, Charlotte","Sophie Lapperre, Therese","Dahlin Bojesen, Rasmus","Eklöf, Josefin","Browatzki, Andrea","Torgny Wilcke, Jon","Gottlieb, Vibeke","Julius Håkansson, Kjell Erik","Tidemandsen, Casper","Tupper, Oliver","Meteran, Howraman","Bergsøe, Christina","Brøndum, Eva","Bodtger, Uffe","Rasmussen, Daniel Bech","Graff Jensen, Sidse","Pedersen, Lars","Jordan, Alexander","Priemé, Helene","Søborg, Christian","Steffensen, Ida E","Høgsberg, Dorthe","Wirenfeldt Klausen, Tobias","Steen Frydland, Martin","Lange, Peter","Sverrild, Asger","Ghanizada, Muhzda","Krag Knop, Filip","Biering-Sørensen, Tor","Lundgren, Jens D","Stæhr Jensen, Jens-Ulrik"],"cuid":["S01-000.00-610182"],"filters":{"added":"2022-05","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"corpau":["ProPAC-COVID study group"],"corresponding_author":["Stæhr Jensen, Jens-Ulrik"],"keyword":["Adolescent","Adult","Azithromycin","COVID 19 drug therapy","Double Blind Method","Humans","Hydroxychloroquine","SARS CoV 2","Treatment Outcome"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-ZEA"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-ZEA","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"azithromycin and hydroxychloroquine in hospitalised patients with confirmed covid 000000000019 a randomised double blinded placebo controlled trial","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1183/13993003.00752-2021","version":"Published Version"},"id":"S01-000.00-610182","identifier":[{"id":"34083403","type":"pmid"},{"id":"PMC8186006","type":"pmcid"},{"id":"85123390021","type":"scopus"}],"ids":["sdu-81450dc2-d8e9-4b3e-997f-296a746df676"],"keyword":["Adolescent","Adult","Azithromycin","COVID-19/drug therapy","Double-Blind Method","Humans","Hydroxychloroquine","SARS-CoV-2","Treatment Outcome"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Loca