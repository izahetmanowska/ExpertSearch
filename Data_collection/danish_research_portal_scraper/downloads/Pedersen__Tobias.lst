9-4889-998c-3da360fd16d6","name":"Danneskiold-Samsøe, Bente","orcid":"0000-0003-3710-5212","rank":14,"rolecode":"pau"},{"affno":"1","first":"Henning","key":"bliddalpau","last":"Bliddal","locid":"b9301e7d-d932-44d7-8fdc-b467e8ff1aa8","name":"Bliddal, Henning","rank":15,"rolecode":"pau"}],"pmid":["22410241"],"pub":{"doi":"10.1186/1471-2474-13-35","issn":["00034967","14682060"],"issn_org":["00034967"],"issue":"Suppl. 3","journal":"Annals of the Rheumatic Diseases","pages":"544","status":"p","title":"Annals of the Rheumatic Diseases","volume":"70"},"review":"Peer Reviewed","scoID":["2-s2.0-84857976575"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-eb260d6e-5ec9-4fdc-acb9-f99ca39d353a"],"src":["KU University of Copenhagen"],"title":"Feasibility of a standardized ultrasound examination in patients with rheumatoid arthritis: Quality improvement among rheumatologists","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-533850","year":"2011","yearsub":"2011"}
{"abstract":"It was the aim of this study to determine the efficacy and safety of vitamin K antagonists (VKAs) and acetylsalicylic acid (ASA) in patients with non-valvular atrial fibrillation (AF), with separate analyses according to predicted thromboembolic and bleeding risk. By individual level-linkage of nationwide registries, we identified all patients discharged with non-valvular AF in Denmark (n=132,372). For every patient, the risk of stroke and bleeding was calculated by CHADS2, CHA2DS2-VASc, and HAS-BLED. During follow-up, treatment with VKA and ASA was determined time-dependently. VKA consistently lowered the risk of thromboembolism compared to ASA and no treatment; the combination of VKA+ASA did not yield any additional benefit. In patients at high thromboembolic risk, hazard ratios (95% confidence interval) for thromboembolism were: 1.81 (1.73-1.90), 1.14 (1.06-1.23), and 1.86 (1.78-1.95) for ASA, VKA+ASA, and no treatment, respectively, compared to VKA. The risk of bleeding was increased with VKA, ASA, and VKA+ASA compared to no treatment, the hazard ratios were: 1.0 (VKA; reference), 0.93 (ASA; 0.89-0.97), 1.64 (VKA+ASA; 1.55-1.74), and 0.84 (no treatment; 0.81-0.88), respectively. There was a neutral or positive net clinical benefit (ischaemic stroke vs. intracranial haemorrhage) with VKA alone in patients with a CHADS2 score of = 0, and CHA2DS2-VASc score of = 1. This large cohort study confirms the efficacy of VKA and no effect of ASA treatment on the risk of stroke/thromboembolism. Also, the risk of bleeding was increased with both VKA and ASA treatment, but the net clinical benefit was clearly positive, in favour of VKA in patients with increased risk of stroke/thromboembolism.","author_count":13,"contributors":["Olesen, Jonas Bjerring","Lip, Gregory Y H","Lindhardsen, Jesper","Lane, Deirdre A","Ahlehoff, Ole","Hansen, Morten Lock","Raunsø, Jakob","Tolstrup, Janne Schurmann","Hansen, Peter Riis","Gislason, Gunnar","Torp-Pedersen, Christian"],"cuid":["S02-099.69-039999"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"keyword":["Aged","Aged 80 and over","Aspirin","Atrial fibrillation","Cohort Studies","Denmark","Drug Evaluation","Female","Fibrinolytic Agents","Follow Up Studies","Hemorrhage","Humans","Male","Middle Aged","Registries","Risk Assessment","Thromboembolism","Vitamin K"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"risks of thromboembolism and bleeding with thromboprophylaxis in patients with atrial fibrillation a net clinical benefit analysis using a real world nationwide cohort study","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1160/TH11-05-0364","version":"Other Version"},"id":"S02-099.69-039999","identifier":[{"id":"21789337","type":"pmid"},{"id":"80052426052","type":"scopus"}],"ids":["ku-0a33303b-8e9a-4686-bb6e-1bbd6a299cd9","sdu-03dc98fc-e5f5-4317-ae7b-e2713d12ab00"],"keyword":["Aged","Aged, 80 and over","Aspirin","Atrial Fibrillation","Cohort Studies","Denmark","Drug Evaluation","Female","Fibrinolytic Agents","Follow-Up Studies","Hemorrhage","Humans","Male","Middle Aged","Registries","Risk Assessment","Thromboembolism","Vitamin K"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-FC316B934E771BA20BA3A92B8C37A203"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1160/TH11-05-0364","version":"Other Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, National Institute of Public Health, Department of Population Health and Morbidity"],"nora_code":"DI-U-SDU","used":1},{"affno":3,"key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Section of Surgery and Internal Medicine"],"nora_code":"DI-U-KU"}],"person":[{"affno":"","first":"Jonas Bjerring","key":"olesenjonasbjerringpau","last":"Olesen","name":"Olesen, Jonas Bjerring","rank":1,"rolecode":"pau"},{"affno":"","first":"Gregory Y H","key":"lipgregoryyhpau","last":"Lip","name":"Lip, Gregory Y H","rank":2,"rolecode":"pau"},{"affno":"","first":"Jesper","key":"lindhardsenjesperpau","last":"Lindhardsen","name":"Lindhardsen, Jesper","rank":3,"rolecode":"pau"},{"affno":"","first":"Deirdre A","key":"lanedeirdreapau","last":"Lane","name":"Lane, Deirdre A","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ole","key":"ahlehoffolepau","last":"Ahlehoff","name":"Ahlehoff, Ole","rank":5,"rolecode":"pau"},{"affno":"","first":"Morten Lock","key":"hansenmortenlockpau","last":"Hansen","name":"Hansen, Morten Lock","rank":6,"rolecode":"pau"},{"affno":"","first":"Jakob","key":"raunsøjakobpau","last":"Raunsø","name":"Raunsø, Jakob","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Janne Schurmann","key":"tolstrupjanneschurmannpau","last":"Tolstrup","locid":"c03b1732-7c6e-404e-a542-e7d02e2b2575","name":"Tolstrup, Janne Schurmann","orcid":"0000-0002-9796-3967","rank":8,"rolecode":"pau"},{"affno":"","first":"Peter Riis","key":"hansenpeterriispau","last":"Hansen","locid":"9ab3e639-a02a-4ab7-9bde-d1d64cc7ecae","name":"Hansen, Peter Riis","orcid":"0000-0002-9056-535X","rank":9,"rolecode":"pau"},{"affno":"","first":"Gunnar Hilmar","key":"gislasongunnarpau","last":"Gislason","locid":"c0f678a6-eb13-49a3-9485-8fae1e72e2a1","name":"Gislason, Gunnar","name_org":"Gislason, Gunnar Hilmar","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Gunnar Hilmar","key":"gislasongunnarhilmarpau","last":"Gislason","name":"Gislason, Gunnar Hilmar","rank":10,"rolecode":"pau"},{"affno":"","first":"Christian","key":"torppedersenchristianpau","last":"Torp-Pedersen","locid":"f71bedc6-3736-4559-b937-6a18e770616e","name":"Torp-Pedersen, Christian","rank":11,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Christian Tobias","key":"torppedersenchristiantobiaspau","last":"Torp-Pedersen","name":"Torp-Pedersen, Christian Tobias","rank":11,"rolecode":"pau"}],"pmid":["21789337"],"pub":{"doi":"10.1160/th11-05-0364","issn":["03406245","03447618"],"issn_org":["03406245"],"issue":"4","journal":"Thrombosis and Haemostasis","pages":"739-49","publisher":"Georg Thieme Verlag","status":"p","title":"Thrombosis and Haemostasis","volume":"106"},"review":"Peer Reviewed","scoID":["2-s2.0-80052426052"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-0a33303b-8e9a-4686-bb6e-1bbd6a299cd9","sdu-03dc98fc-e5f5-4317-ae7b-e2713d12ab00"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Risks of thromboembolism and bleeding with thromboprophylaxis in patients with atrial fibrillation: A net clinical benefit analysis using a 'real world' nationwide cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.69-039999","year":"2011","yearsub":"2011"}
{"abstract":"Introduction: Regeneration is a widespread phenomenon functioning to maintain and restore normal form and function of cells, tissues, and in some cases organs or appendages. While mammals like mice and rats are typically employed as experimental models in regenerative research, these animals are generally restricted by their limited regenerative potential. Conversely, excellent animal models for regenerative studies exist in lower vertebrates such as the urodele amphibians (salamanders and newts), exemplified in the iconic Mexican axolotl (Ambystoma mexicanum) capable of regenerating whole limbs, tail, jaw, etc. Regeneration in this species is taking place by dedifferentiation of cells to form a collection of stem cells, the blastema, that proliferate and regenerate lost tissue without scar formation. The objective of this study was to non-invasively evaluate regeneration over time in a regenerating axolotl limb model. Superparamagnetic iron oxide particles (SPIOs) sensitive to MRI were used to track cells, and cell viability and regenerative capacity was investigated. Materials and Methods: Limb regeneration was induced by amputation of one hind limb of anaesthetised axolotls. The potential effect on cell viability of two commercially available SPIOs, Resovist (Bayer Schering Pharma, Hydrodynamic diameter 62 nm) and VSOP-C200 (Ferropharm, Hydrodynamic diameter 7 nm) and Resovist in conjugation with the transfection agent poly-L-lysin (PLL) was tested on cultures of axolotl blastema cells from 7 animals in vitro. Cell viability was quantified by PicoGreen-DNA quantification following 3 weeks of culturing. In vivo T1-weighted MRI-tracking of SPIO labelled blastema cells in the regenerating limb of 5 labelled axolotls was tested against 6 sham-operated animals for 84 days, using a clinically available 1.5 T system (Siemens), with a small radiofrequency loop-coil. Image data was processed by ImageJ and comparison of tissue signal intensity and rate of regeneration was conducted using SAS JMP8. Results: SPIO labelling with neither VSOP-C200, Resovist nor Resovist/PLL had any significant effect on blastema cell viability in vitro. MRI revealed that labelled tissue was clearly visibly in vivo 49 days after amputation and a significant decline in signal intensity of labelled limbs versus sham-operated limbs was evident throughout the complete regeneration period of 84 days. SPIO labelling displayed no significant effect on the rate of regeneration. Discussion: SPIO labelling for MRI cell tracking has shown promising results for regenerative therapies using stem cells. This study contributes to broaden the potential of SPIOs to track regenerating tissue in an inherently regenerative model, facilitating the use of SPIOs in future chemically or genetically induced regenerative therapies. In addition, this study concludes that SPIO labelling and MRI tracking of axolotl stem cells allow for non-invasive longitudinal studies in this model, increasing the potential to draw knowledge from the regenerative capacities of this species.","author_count":5,"contributors":["Lauridsen, Henrik","Foldager, Casper Bindzus","Hagensen, Mette K","Wang, Tobias","Pedersen, Michael"],"cuid":["S01-000.00-145434"],"event":{"end":"2011-09-10","place":"San Diego, us","start":"2011-09-07","title":"2011 World Molecular Imaging Congress","year":"2011"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"mri tracking of spio labelled stem cells in a true regenerative environment the regenerating limb of the axolotl","src":["au"],"src-code":["DI-U-AU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://www.wmicmeeting.org/2011/2011abstracts/start.htm",