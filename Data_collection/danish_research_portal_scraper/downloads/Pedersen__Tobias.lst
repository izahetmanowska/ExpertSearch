","last":"Bocaege","name":"Bocaege, Emmy","rank":4,"rolecode":"pau"},{"affno":"","first":"Erin","key":"estruppau","last":"Estrup","name":"Estrup, Erin","rank":5,"rolecode":"pau"},{"affno":"","first":"Cesar","key":"martinezgallardopau","last":"Martinez-Gallardo","name":"Martinez-Gallardo, Cesar","rank":6,"rolecode":"pau"},{"affno":"","first":"George Alexis","key":"pantospau","last":"Pantos","name":"Pantos, George Alexis","rank":7,"rolecode":"pau"},{"affno":"1","first":"Patrick Nørskov","key":"pedersenpau","last":"Pedersen","locid":"3bc10786-6db0-43a3-a028-9de1697afb13","name":"Pedersen, Patrick Nørskov","orcid":"0000-0001-9843-0858","rank":8,"rolecode":"pau"},{"affno":"","first":"Ingeborg","key":"saehlepau","last":"Saehle","name":"Saehle, Ingeborg","rank":9,"rolecode":"pau"},{"affno":"1","first":"Lisa Marie","key":"yeomanspau","last":"Yeomans","locid":"4cebfae3-972c-4422-8bf7-18436ba02870","name":"Yeomans, Lisa Marie","rank":10,"rolecode":"pau"}],"pub":{"issn":["14346990"],"issue":"1","journal":"Neo-Lithics. A newsletter of southwest Asian lithics research","pages":"13-21","status":"p","title":"Neo-Lithics. A newsletter of southwest Asian lithics research","volume":"2016"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-caa51ab8-4ad6-414c-9603-f9e84aa9fe99"],"src":["KU University of Copenhagen"],"title":"A Late Natufian and PPNA Settlement in North-East Jordan : Interim Report on the 2014-2016 Excavations at Shubayqa 6","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-514472","year":"2016","yearsub":"2016"}
{"abstract":"Shubayqa 1 is a newly identified early and late Natufian site in the harra desert of northeastern Jordan. In addition to buildings, and rich chipped stone, faunal, and botanical assemblages, the site has produced a large collection of ground stone tools. This paper presents the result of a preliminary study of the ground stone artefacts associated with the late Natufian phase. Results indicate that while the assemblage is overall very similar to other Natufian sites in the Mediterranean zone, there are also some notable differences. Although grinding rather than pounding tools appear to be more important at the site, many tools were seemingly involved in both grinding and pounding activities. We hypothesize that this dual function could be explained by the processing of rhizome tubers, which were found in abundance at the site, and which may have represented an important food source for the inhabitants. In addition, we argue that the relationship between ground stone tools and cereal processing has been overemphasized and the processing of other plant food resources, in this case tubers could have been equally significant. While the processing of plant foods was one function, many tools are also associated with pigment stains, suggesting that they were involved in the processing of non-vegetal matter.","author_count":3,"contributors":["Pedersen, Patrick Nørskov","Richter, Tobias","Otaegui, Amaia Arranz"],"cuid":["S01-000.00-765623"],"filters":{"added":"2022-09","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"preliminary analysis of the late natufian ground stone from shubayqa 000000000001 jordan","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.2218/jls.v3i3.1647","version":"Published Version"},"id":"S01-000.00-765623","ids":["ku-e7f2539d-5b70-4ac1-b7f3-118195b0f820"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-3-5CE67136384500943A2004BD77F27E69"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.2218/jls.v3i3.1647","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Humanities, Department of Cross-Cultural and Regional Studies"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Patrick","key":"pedersenpau","last":"Pedersen","locid":"3bc10786-6db0-43a3-a028-9de1697afb13","name":"Pedersen, Patrick Nørskov","name_org":"Pedersen, Patrick","orcid":"0000-0001-9843-0858","rank":1,"rolecode":"pau"},{"affno":"1","first":"Tobias","key":"richterpau","last":"Richter","locid":"eacd6ca8-b280-46dd-bd5c-7405e386b59b","name":"Richter, Tobias","orcid":"0000-0001-9902-8852","rank":2,"rolecode":"pau"},{"affno":"1","first":"Amaia","key":"arranzotaeguipau","last":"Arranz-Otaegui","locid":"870d6407-ea3c-4815-b28b-27d4d0449297","name":"Otaegui, Amaia Arranz","name_org":"Arranz-Otaegui, Amaia","orcid":"0000-0002-5091-6426","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.2218/jls.v3i3.1647","issn":["20550472"],"issue":"3","journal":"Journal of Lithic Studies","pages":"379-402","status":"p","title":"Journal of Lithic Studies","volume":"3"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-e7f2539d-5b70-4ac1-b7f3-118195b0f820"],"src":["KU University of Copenhagen"],"title":"Preliminary analysis of the Late Natufian ground stone from Shubayqa 1, Jordan","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-765623","year":"2016","yearsub":"2016"}
