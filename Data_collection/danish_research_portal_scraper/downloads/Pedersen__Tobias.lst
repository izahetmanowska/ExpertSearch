me":"Thomsen, Jacob Bay","rank":44,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Nicolaj","key":"valstednicolajpau","last":"Valsted","name":"Valsted, Nicolaj","rank":45,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Anna","key":"vestergaardannapau","last":"Vestergaard","name":"Vestergaard, Anna","rank":46,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Christoffer","key":"karoffchristofferpau","last":"Karoff","locid":"b71daf07-cedf-42bb-bd7c-b0af441e57cd","name":"Karoff, Christoffer","orcid":"0000-0003-2009-7965","rank":47,"rolecode":"pau"}],"pub":{"doi":"10.3389/frsen.2024.1474560","issn":["26736187"],"journal":"Frontiers in Remote Sensing","paperid":"1474560","publisher":"Frontiers Media SA","status":"p","title":"Frontiers in Remote Sensing","volume":"5"},"review":"Peer Reviewed","scoID":["2-s2.0-85208798743"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-ca4b833d-fa44-4572-9b87-8dda8c791fee","sdu-c53e86ae-0f83-4d4c-b84c-dc476842298f"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"DISCO-2 – an ambitious earth observing student CubeSat for arctic climate research","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-767862","year":"2024","yearsub":"2024"}
{"abstract":"OBJECTIVES: To identify molecular pathways and prognostic- and diagnostic plasma-protein biomarkers for diabetic retinopathy at various stages. METHODS: This exploratory, cross-sectional proteomics study involved plasma from 68 adults, including 15 healthy controls and 53 diabetes patients for various stages of diabetic retinopathy: non-diabetic retinopathy, non-proliferative diabetic retinopathy, proliferative diabetic retinopathy and diabetic macular edema. Plasma was incubated with peptide library beads and eluted proteins were tryptic digested, analyzed by liquid chromatography-tandem mass-spectrometry followed by bioinformatics. RESULTS: In the 68 samples, 248 of the 731 identified plasma-proteins were present in all samples. Analysis of variance showed differential expression of 58 proteins across the five disease subgroups. Protein-Protein Interaction network (STRING) showed enrichment of various pathways during the diabetic stages. In addition, stage-specific driver proteins were detected for early and advanced diabetic retinopathy. Hierarchical clustering showed distinct protein profiles according to disease severity and disease type. CONCLUSIONS: Molecular pathways in the cholesterol metabolism, complement system, and coagulation cascade were enriched in patients at various stages of diabetic retinopathy. The peroxisome proliferator-activated receptor signaling pathway and systemic lupus erythematosus pathways were enriched in early diabetic retinopathy. Stage-specific proteins for early - and advanced diabetic retinopathy as determined herein could be 'key' players in driving disease development and potential 'target' proteins for future therapies. For type 1 and 2 diabetes mellitus, the proteomic profiles were especially distinct during the early disease stage. Validation studies should aim to clarify the role of the detected molecular pathways, potential biomarkers, and potential 'target' proteins for future therapies in diabetic retinopathy.","author_count":11,"contributors":["Honoré, Bent","Hajari, Javad Nouri","Pedersen, Tobias Torp","Ilginis, Tomas","Al-Abaiji, Hajer Ahmad","Lønkvist, Claes Sepstrup","Saunte, Jon Peiter","Olsen, Dorte Aalund","Brandslund, Ivan","Vorum, Henrik","Slidsborg, Carina"],"cuid":["S03-099.46-735014"],"filters":{"added":"2024-03","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"corresponding_author":["Honoré, Bent","Slidsborg, Carina"],"keyword":["Adult","Aged","Biomarkers blood","Blood Proteins analysis","Cross Sectional Studies","Diabetic Retinopathy diagnosis","Diabetic retinopathy","Disease mechanisms","Female","Humans","Liquid chromatography tandem mass spectrometry","Male","Middle Aged","Prognosis","Protein Interaction Maps","Proteomics","Proteomics methods","Tandem Mass Spectrometry","plasma protein biomarkers"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-AAU","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"proteomic analysis of diabetic retinopathy identifies potential plasma protein biomarkers for diagnosis and prognosis","src":["aau","au","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/258244950/10.1515_cclm-2023-1128.pdf","version":"Published Version"},"funding_acknowledgement":["Research funding: This work was supported by grants from Aase and Ejnar Danielsens Fond, Fight for Sight Denmark, Dagmar Marshalls Fond, Einar Willumsens Fond, August Frederik Wedell Erichsens Fond, Kong Christian den Tiendes Fond, The Synoptikfonden and Vissing Fonden. The mass spectrometry instrumentation was kindly donated by A. P. Møller og Hustru Chastine Mc-Kinney Møllers Fond til almene Formaal. The sponsors or funding organizations had no role in the design or conduct of this research."],"id":"S03-099.46-735014","identifier":[{"id":"85184796948","type":"scopus"},{"id":"38332693","type":"pmid"}],"ids":["aau-c715a59f-bedf-4032-a4f9-1ecf90a8c98d","au-e51d0510-efe5-48ab-8d56-8760595756fa","sdu-d532ae43-d513-4445-a584-d74eb0d67e22"],"keyword":["Adult","Aged","Biomarkers/blood","Blood Proteins/analysis","Cross-Sectional Studies","Diabetic Retinopathy/diagnosis","Female","Humans","Male","Middle Aged","Prognosis","Protein Interaction Maps","Proteomics/methods","Tandem Mass Spectrometry","diabetic retinopathy","disease mechanisms","liquid chromatography-tandem mass spectrometry","plasma-protein biomarkers","proteomics"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-585D77F23051B186261029DFB59816F0"],"oa_link":[{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/258244950/10.1515_cclm-2023-1128.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Biomedicine, Department of Biomedicine - Forskning og uddannelse, Vest"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University (AAU)"],"nora_code":"DI-U-AAU","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["National Hospital of Denmark"],"nora_code":"DI-HO-CAP","used":1},{"affno":"4","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Regional Health Research","SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Lillebælt Hospital, Research Unit of Biochemistry and Immunology (Vejle)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"Bent","key":"honorépau","last":"Honoré","locid":"75b9e761-1039-463f-92dc-c6ed4f760738","name":"Honoré, Bent","orcid":"0000-0002-3459-7429","rank":1,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Javad Nouri","key":"hajaripau","last":"Hajari","name":"Hajari, Javad Nouri","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Tobias Torp","key":"pedersenpau","last":"Pedersen","name":"Pedersen, Tobias Torp","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Hajer Ahmad","key":"alabaijipau","last":"Al-Abaiji","name":"Al-Abaiji, Hajer Ahmad","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Tomas","key":"ilginispau","last":"Ilginis","name":"Ilginis, Tomas","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Claes Sepstrup","key":"lønkvistpau","last":"Lønkvist","name":"Lønkvist, Claes Sepstrup","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jon Peiter","key":"sauntepau","last":"Saunte","name":"Saunte, Jon Peiter","rank":6,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Dorte Aalund","key":"olsenpau","last":"Olsen","locid":"8a3114d0-466f-4593-aa7a-270ce4e6c796","name":"Olsen, Dorte Aalund","rank":8,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Ivan","key":"brandslundpau","last":"Brandslund","locid":"a81731b6-2c07-4eb3-8f89-3da6650c226b","name":"Brandslund, Ivan","orcid":"0000-0002-4203-5442","rank":9,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Henrik","key":"vorumpau","last":"Vorum","locid":"60554352-1557-4c7b-905d-e4b7c7f8c94a","name":"Vorum, Henrik","orcid":"0000-0002-7600-0731","rank":10,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Carina","key":"slidsborgpau","last":"Slidsborg","name":"Slidsborg, Carina","rank":10,"rolecode":"pau"}],"pmid":["38332693"],"pub":{"doi":"10.1515/cclm-2023-1128","issn":["14346621","14374331"],"issn_org":["14346621"],"issue":"6","journal":"Clinical Chemistry and Laboratory Medicine","pages":"1177-1197","publisher":"Walter de Gruyter GmbH","status":"p","title":"Clinical Chemistry and Laboratory Medicine","volume":"62"},"review":"Peer Reviewed","scoID":["2-s2.0-85184796948"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-c715a59f-bedf-4032-a4f9-1ecf90a8c98d","au-e51d0510-efe5-48ab-8d56-8760595756fa","sdu-d532ae43-d513-4445-a584-d74eb0d67e22"],"src":["AAU Aalborg University","AU Aarhus University","SDU University of Southern Denmark"],"title":"Proteomic analysis of diabetic retinopathy identifies potential plasma-protein biomarkers for diagnosis and prognosis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-099.46-735014","year":"2024","yearsub":"2024"}
{"abstract":"Marine ecosystems and their living resources are of vital economical and societal importance to Greenland. Offshore waters along the continental slopes support important fisheries, due to their oceanographic conditions sustaining high biological production. While animals such as shrimps, fishes, and mammals are well studied and surveyed in this offshore region, due to their commercial importance, relatively few studies exist on the seasonal and spatial dynamics of phyto-, zoo- and ichthyoplankton, despite their crucial role in sustaining the marine food web. Phytoplankton biomass and production are often underestimated, due to a lack of in situ data, necessitating a reliance on remote sensing estimates with limited depth resolution. This knowledge gap is limiting our understanding of the production capacity of these important offshore ecosystems. We present a large plankton dataset from offshore waters between Greenland and Canada along with commercial fishing activity. We found remarkably high phytoplankton biomass throughout the productive season from spring to autumn, solidifying the growing consensus that continental slopes are important biological hotspots.","author_count":5,"contributors":["Juul-Pedersen, Thomas","Vonnahme, Tobias R.","Koski, Marja","Bouchard, Caroline","Ostermann, Else"],"cuid":["S01-000.00-729608"],"event":{"end":"2024-01-25","place":"Lyngby, dk","start":"2024-01-23","title":"22. Danske Havforskermøde","year":"2024"},"filters":{"added":"2024-05","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Nordic"],"country":["Greenland"],"glorg":["All Global Affiliations","Greenland Institute of Natural Resources"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"marine biological hotspots along the continental slopes between greenland and canada","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://havforsker2024.dtu.dk/abstract-book","version":"Published Version"},"id":"S01-000.00-729608","ids":["dtu-5d74dbe3-9c0c-4513-bbc3-ee3fdbdc1dfd"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-91782B577B46F31379E11444623158F8"],"oa_link":[{"access":"oa","type":"rem","url":"https://havforsker2024.dtu.dk/abstract-book","version":"Published Version"}],"org":[{"affno":"1","country":"gl","key":"greenland institute of natural resources","loc":["Greenland","Nordic"],"name":"Greenland Institute of Natural Resources","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Institute of Aquatic Resources","Technical University of Denmark, National Institute of Aquatic Resources, Section for Oceans and Arctic"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Thomas","key":"juulpedersenpau","last":"Juul-Pedersen","name":"Juul-Pedersen, Thomas","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Tobias R.","key":"vonnahmepau","last":"Vonnahme","name":"Vonnahme, Tobias R.","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Marja","key":"koskipau","last":"Koski","locid":"2bd40950-7bbf-4d39-aa05-5629879aa4ae","name":"Koski, Marja","orcid":"0000-0002-1860-9768","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Caroline","key":"bouchardpau","last":"Bouchard","name":"Bouchard, Caroline","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Else","key":"ostermannpau","last":"Ostermann","name":"Osterm