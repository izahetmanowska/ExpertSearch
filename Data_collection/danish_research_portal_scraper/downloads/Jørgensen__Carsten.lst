versity (AU)"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Kim Arild","key":"steenpau","last":"Steen","name":"Steen, Kim Arild","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Stephanie","key":"delebassepau","last":"Delebasse","name":"Delebasse, Stephanie","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kevin","key":"grooterspau","last":"Grooters","name":"Grooters, Kevin","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Carsten","key":"høilundpau","last":"Høilund","name":"Høilund, Carsten","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mads","key":"dyrmannpau","last":"Dyrmann","locid":"5aca1ec0-9265-49e6-8bdf-4ca4b7f1e975","name":"Dyrmann, Mads","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Søren","key":"skovsenpau","last":"Skovsen","locid":"573add46-7620-4cfe-8beb-8eb24bb921b3","name":"Skovsen, Søren","orcid":"0000-0001-6222-3005","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Rasmus","key":"nyholmjørgensenpau","last":"Nyholm Jørgensen","locid":"8d6c3178-b2a4-4c33-b5f9-b0ee8f679986","name":"Nyholm Jørgensen, Rasmus","orcid":"0000-0002-1329-1674","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ole","key":"greenpau","last":"Green","name":"Green, Ole","rank":8,"rolecode":"pau"},{"affno":"","first":"P.W.G.","key":"grootkoerkamppedh","last":"Groot Koerkamp","name":"Groot Koerkamp, P.W.G.","rank":9,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"C.","key":"lokhorstpedh","last":"Lokhorst","name":"Lokhorst, C.","rank":10,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"A.H.","key":"ipemapedh","last":"Ipema","name":"Ipema, A.H.","rank":11,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"C.","key":"kempenaarpedh","last":"Kempenaar","name":"Kempenaar, C.","rank":12,"role