de":"pedh"},{"affno":"","first":"Arne","key":"borkwardtpedh","last":"Borkwardt","name":"Borkwardt, Arne","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Michael","key":"borrepedh","last":"Borre","name":"Borre, Michael","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Henrik","key":"daugaardpedh","last":"Daugaard","name":"Daugaard, Henrik","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Vibeke E","key":"hjortdalpedh","last":"Hjortdal","name":"Hjortdal, Vibeke E","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Kim C","key":"houlindpedh","last":"Houlind","name":"Houlind, Kim C","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Lisbet R","key":"hölmichpedh","last":"Hölmich","name":"Hölmich, Lisbet R","rank":9,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Keld","key":"lauritsenpedh","last":"Lauritsen","name":"Lauritsen, Keld","rank":10,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Jacob","key":"steinmetzpedh","last":"Steinmetz","name":"Steinmetz, Jacob","rank":11,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"edition":"3.","isbn":["9788793810037"],"pages":"847-849","place":"Roskilde","publisher":"FADL's Forlag","status":"p","title":"Kirurgi"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-ddeafc97-c37b-4b44-886e-2625720bd9c2"],"src":["SDU University of Southern Denmark"],"title":"Proteseinfektioner i karkirurgi","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-636757","year":"2020","yearsub":"2020"}
{"abstract":"Background: There is a need for new approaches to increase the knowledge of the membrane excitability of small nerve fibers both in healthy subjects, as well as during pathological conditions. Our research group has previously developed the perception threshold tracking technique to indirectly assess the membrane properties of peripheral small nerve fibers. In the current study, a new approach for studying membrane excitability by cooling small fibers, simultaneously with applying a slowly increasing electrical stimulation current, is evaluated. The first objective was to examine whether altered excitability during cooling could be detected by the perception threshold tracking technique. The second objective was to computationally model the underlying ionic current that could be responsible for cold induced alteration of small fiber excitability. The third objective was to evaluate whether computational modelling of cooling and electrical simulation can be used to generate hypotheses of ionic current changes in small fiber neuropathy. Results: The excitability of the small fibers was assessed by the perception threshold tracking technique for the two temperature conditions, 20 °C and 32 °C. A detailed multi-compartment model was developed, including the ionic currents: Na TTXs, Na TTXr, Na P, K Dr, K M, K Leak, K A, and Na/K-ATPase. The perception thresholds for the two long duration pulses (50 and 100 ms) were reduced when the skin temperature was lowered from 32 to 20 °C (p < 0.001). However, no significant effects were observed for the shorter durations (1 ms, p = 0.116; 5 ms p = 0.079, rmANOVA, Sidak). The computational model predicted that the reduction in the perception thresholds related to long duration pulses may originate from a reduction of the K Leak channel and the Na/K-ATPase. For short durations, the effect cancels out due to a reduction of the transient TTX resistant sodium current (Na v1.8). Additionally, the result from the computational model indicated that cooling simultaneously with electrical stimulation, may increase the knowledge regarding pathological alterations of ionic currents. Conclusion: Cooling may alter the ionic current during electrical stimulation and thereby provide additional information regarding membrane excitability of small fibers in healthy subjects and potentially also during pathological conditions.","author_count":7,"contributors":["Hugosdottir, Rosa","Mørch, Carsten Dahl","Jørgensen, Cecilia Klitgaard","Nielsen, Camilla Winther","Olsen, Mathias Vassard","Pedersen, Mads Jozwiak","Tigerholm, Jenny"],"cuid":["S01-000.00-117562"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Electrical stimulation","Na K ATPase","Perception threshold tracking","Temperature","Voltage gated ion channels"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"altered excitability of small cutaneous nerve fibers during cooling assessed with the perception threshold tracking technique","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1186/s12868-019-0527-3","version":"Published Version"},"id":"S01-000.00-117562","identifier":[{"id":"31481024","type":"pmid"},{"id":"85071741464","type":"scopus"}],"ids":["aau-e8392743-7d99-4e35-9604-539f9960001b"],"keyword":["Electrical stimulation","Multicompartment model","Na/K-ATPase","Perception threshold tracking","Temperature","Voltage-gated ion channels"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-6B68BCFFE6BBA7F4F3378B3BB3569681"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1186/s12868-019-0527-3","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/310361801/document_1_.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Center for Neuroplasticity and Pain","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Center for Sensory-Motor Interaction","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Integrative Neuroscience"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Rosa","key":"hugosdottirpau","last":"Hugosdottir","locid":"7bb03cea-1753-4488-8e96-934939da2174","name":"Hugosdottir, Rosa","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Carsten Dahl","key":"mørchpau","last":"Mørch","locid":"1fbd65c2-e799-4d5a-b4f9-dafc89154565","name":"Mørch, Carsten Dahl","orcid":"0000-0001-6693-2028","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Cecilia Klitgaard","key":"jørgensenpau","last":"Jørgensen","locid":"e8e674eb-9e4d-46f0-aeb8-455b8a747ab8","name":"Jørgensen, Cecilia Klitgaard","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Camilla Winther","key":"nielsenpau","last":"Nielsen","locid":"aee5e01a-d712-489c-8b4a-dac8cba9098e","name":"Nielsen, Camilla Winther","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mathias Vassard","key":"olsenpau","last":"Olsen","locid":"2cce83c1-cf8d-47cd-8af6-6cf182fdec93","name":"Olsen, Mathias Vassard","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mads Jozwiak","key":"pedersenpau","last":"Pedersen","locid":"1e31f3fb-39bc-4f89-ab18-6884a5dca5c7","name":"Pedersen, Mads Jozwiak","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jenny","key":"tigerholmpau","last":"Tigerholm","locid":"a61d43e3-792d-4da4-a9de-53dfb33fef9d","name":"Tigerholm, Jenny","orcid":"0000-0002-0411-6276","rank":7,"rolecode":"pau"}],"pmid":["31481024"],"pub":{"doi":"10.1186/s12868-019-0527-3","issn":["14712202"],"issue":"1","journal":"BMC Neuroscience","paperid":"47","publisher":"BioMed Central","status":"p","title":"BMC Neuroscience","volume":"20"},"review":"Peer Reviewed","scoID":["2-s2.0-85071741464"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-e8392743-7d99-4e35-9604-539f9960001b"],"src":["AAU Aalborg University"],"title":"Altered excitability of small cutaneous nerve fibers during cooling assessed with the perception threshold tracking technique","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-117562","year":"2019","yearsub":"2019"}
{"abstract":"Patients with borderline personality disorder (BPD) display disturbances in understanding self and others. We examined whether these disturbances extended to how patients described their personal and parents’ life stories and to measures of identity, alexithymia, empathy, and emotional intelligence. Thirty BPD patients and 30 matched control participants described personal and parents’ life stories and completed measures of identity disturbance, alexithymia, empathy, and emotional intelligence. Compared to the controls, patients with BPD described their personal and their parents’ life stories more negatively and with fewer themes of agency and communion fulfillment. Patients and controls showed equally complex reasoning about their personal life stories, but patients displayed less complexity and more self‐other confusion, when reasoning about their parents’ stories. Patients also differed from controls on identity disturbance, alexithymia, and empathy. The results suggest that patients’ storied understanding of themselves and others are disturbed and should be taken into account to better understand BPD.","author_count":6,"contributors":["Lind, Majse","Thomsen, Dorthe Kirkegaard","Bøye, Rikke","Heinskou, Torben","Simonsen, Sebastian","Jørgensen, Carsten René"],"cuid":["S01-000.00-223632"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Autobiographical memories","Borderline personality disorder","Emotional intelligence","Empathy","Identity","Incremental validity","Life stories","Meaning making","Narrative identity","PSYCHIATRIC CLASSIFICATION","Posttraumatic stress disorder","SELF","Self and other understanding","Social cognition","Vicarious life stories"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"personal and parents life stories in patients with borderline personality disorder","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.au.dk/ws/files/146113525/Personal_and_Parents_Life_Stories_in_Patients_with_Borderline_Personality_Disorder_Accepted_manuscript_2019.pdf","version":"Authors Final Version"},"id":"S01-000.00-223632","identifier":[{"id":"000467276800006","type":"wos"},{"id":"30809831","type":"pmid"},{"id":"85062321656","type":"scopus"}],"ids":["au-a57856dc-e981-4437-8420-07cf200ad2f2"],"keyword":["AUTOBIOGRAPHICAL MEMORIES","Borderline personality disorder","EMOTIONAL INTELLIGENCE","EMPATHY","INCREMENTAL VALIDITY","MEANING-MAKING","NARRATIVE IDENTITY","POSTTRAUMATIC-STRESS-DISORDER","PSYCHIATRIC CLASSIFICATION","SELF","SOCIAL COGNITION","identity","life stories","self and other understanding","vicarious life stories"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-4-7BEC7F47069670DEFDE8CE6E30612B19"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.au.dk/ws/files/146113525/Personal_and_Parents_Life_Stories_in_Patients_with_Borderline_Personality_Disorder_Accepted_manuscript_2019.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Social Science (SOC)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus BSS, Department of Psychology and Behavioural Sciences","Aarhus University, Aarhus BSS, Department of Psychology and Behavioural Sciences, Department of Psychology and Behavioural Sciences - CON AMORE"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Majse","key":"lindpau","last":"Lind","locid":"8d869f6e-e52a-4f15-85fd-e20627d55e29","name":"Lind, Majse","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Dorthe Kirkegaard","key":"thomsenpau","last":"Thomsen","locid":"535c247b-d576-4abf-adb0-3dba6fd5f6eb","name":"Thomsen, Dorthe Kirkegaard","orcid":"0000-0001-5161-6911","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rikke","key":"bøyepau","last":"Bøye","locid":"c816211a-6dc5-4594-ba92-a5d3aa050cde","name":"Bøye, Rikke","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Torben","key":"heinskoupau","last":"Heinskou","name":"Heinskou, Torben","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Sebastian","key":"simonsenpau","last":"Simonsen","name":"Simonsen, Sebastian","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Carsten René","key":"jørgensenpau","last":"Jørgensen","locid":"3763a4db-6ce1-4e54-ac67-524a9604e1ce","name":"Jørgensen, Carsten René","orcid":"0000-0002-7324-1628","rank":6,"rolecode":"pau"}],"pmid":["30809831"],"pub":{"doi":"10.1111/sjop.12529","issn":["00365564","14679450"],"issn_org":["00365564"],"issue":"3","journal":"Scandinavian Journal of Psychology","pages":"231-242","publisher":"Wiley-Blackwell Publishing Ltd","status":"p","title":"Scandinavian Journal of Psychology","volume":"60"},"review":"Peer Reviewed","scoID":["2-s2.0-85062321656"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-a57856dc-e981-4437-8420-07cf200ad2f2"],"src":["AU Aarhus University"],"title":"Personal and parents’ life stories in patients with borderline personality disorder","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-223632","year":"2019","yearsub":"2019"}
{"abstract":"The primary objective of the present study was to estimate the effect of Streptococcus agalactiae intramammary infection on milk production and somatic cell count (SCC) in Norwegian dairy cows. A secondary objective was to assess differences in the effect of common Strep. agalactiae sequence types (ST) found in Norwegian dairy herds. We performed a cohort study combining registry data with sequence-type data from Strep. agalactiae isolates. Herds in which Strep. agalactiae had been detected in individual animals (bacteriological culture or quantitative PCR) between 2012 and 2015 were included. We accessed monthly test-day milk yield records for the entire period to compare milk yield and SCC between cows that were Strep. agalactiae positive and all other cows, within each herd. The study sample consisted of 150 herds, 15,757 cows, 30,850 lactations, and 204,126 test days. We evaluated the effects of Strep. agalactiae on test-day milk yield and SCC using mixed linear regression models, controlling for clustering by herd, cow, and lactation. Multilocus sequence typing of Strep. agalactiae was available for isolates from 86 herds. Additional models were fit to a subset of herds (n = 59) in which ST1, ST23, ST103, and ST196 had been found, to compare the effects of ST on milk production and SCC. In the period 3 to 2 mo before diagnosis, Strep. agalactiae-positive cows produced an average of 1.3 kg more DIM-adjusted milk/d than their negative herd mates. At the time of diagnosis, production was on average 0.13 kg less DIM-adjusted milk/d in Strep. agalactiae-positive cows than in negative cows; 2 to 3 mo after diagnosis, they produced 1.24 kg less DIM-adjusted milk/d than negative cows. Losses persisted for the rest of the investigated period. Cows with ST23, ST103, and ST196 followed a similar pattern as the overall analysis with respect to milk production, whereas ST1-affected cows produced similar amounts of milk before diagnosis as the negative cows. Cows with ST1 experienced the largest milk loss 1 to 2 mo after diagnosis but then recovered to some extent; for cows with ST103, the severe milk loss persisted for the rest of the investigation period. The cow-associated ST103 elicited a lower response in peak SCC compared with ST23, ST103, and ST196. The results indicate an effect of Strep. agalactiae on milk production and SCC. Production was lowest 2 to 3 mo after a positive sample. Peak SCC was reached the month before diagnosis, with notable differences between sequence types.","author_count":6,"contributors":["Holmøy, Ingrid H","Toftaker, Ingrid","Kirkeby, Carsten","Østerås, Olav","Jørgensen, Hannah J","Nødtvedt, Ane"],"cuid":["S01-000.00-504032"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","Nordic","OECD"],"country":["Norway"],"glorg":["All Global Affiliations","Norwegian University of Life Sciences","Norwegian Veterinary Institute","TINE SA"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"a cohort study of the effect of streptococcus agalactiae on milk yield and somatic cell count in norwegian dairy cows","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-504032","identifier":[{"id":"31301833","type":"pmid"},{"id":"85068501938","type":"scopus"}],"ids":["ku-b9487c18-e7da-4018-a2bf-c5c25009bfab"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-59E59206009556C519F1A2DC8E7B51C6"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","country":"no","key":"norwegian university of life sciences","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"Norwegian University of Life Sciences","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary and Animal Sciences, Animal Welfare and Disease Control"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"no","key":"tine sa","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"TINE SA","used":1},{"affno":"4","country":"no","key":"norwegian veterinary institute","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"Norwegian Veterinary Institute","used":1}],"person":[{"affno":"1","first":"Ingrid H","key":"holmøypau","last":"Holmøy","name":"Holmøy, Ingrid H","rank":1,"rolecode":"pau"},{"affno":"1","first":"Ingrid","key":"toftakerpau","last":"Toftaker","name":"Toftaker, Ingrid","rank":2,"rolecode":"pau"},{"affno":"2","first":"Carsten","key":"kirkebypau","last":"Kirkeby","locid":"ea24c9a4-7aa6-40f3-9afb-0af19f1e962d","name":"Kirkeby, Carsten","orcid":"0000-0001-9292-5526","rank":3,"rolecode":"pau"},{"affno":"3","first":"Olav","key":"østeråspau","last":"Østerås","name":"Østerås, Olav","rank":4,"rolecode":"pau"},{"affno":"4","first":"Hannah J","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, Hannah J","rank":5,"rolecode":"pau"},{"affno":"1","first":"Ane","key":"nødtvedtpau","last":"Nødtvedt","name":"Nødtvedt, Ane","rank":6,"rolecode":"pau"}],"pmid":["31301833"],"pub":{"doi":"10.3168/jds.2018-16155","issn":["00220302","15253198"],"issn_org":["00220302"],"issue":"9","journal":"Journal of Dairy Science","pages":"8385-8399","status":"p","title":"Journal of Dairy Science","volume":"102"},"review":"Peer Reviewed","scoID":["2-s2.0-85068501938"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-b9487c18-e7da-4018-a2bf-c5c25009bfab"],"src":["KU University of Copenhagen"],"title":"A cohort study of the effect of Streptococcus agalactiae on milk yield and somatic cell count in Norwegian dairy cows","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-504032","year":"2019","yearsub":"2019"}
{"abstract":"The number of spots on the surface of the Sun is one of the best tracers of solar variability we have. The sunspot number is not only known to change in phase with the 11-year solar cycles, but also to show variability on longer time scales. It is, however, not only the sunspot number that changes in connection with solar variability. The location of the spots on the solar surface is also known to change in phase with the 11-year solar cycle. This has traditionally been visualised in the so-called butterfly diagram, but this is only well constrained from the beginning of the 19th century. This is unfortunate, as knowledge about the butterfly diagram could aid our understanding of the variability and the Sun–Earth connection. As part of a larger review of the work done on sunspots by the Danish astronomer Christian Horrebow, we here present a reanalysis of Christian Horrebow’s notebooks covering the years 1761 and 1764 – 1777. These notebooks have been analysed in at least three earlier studies by Thiele (Astron. Nachr.50, 257, 1859), d’Arrest (published in Wolf, Astron. Mitt. Eidgenöss. Sternwarte Zür. 4, 77, 1873) and Hoyt and Schatten (Solar Phys.160, 387, 1995). In this article, we construct a complete record of sunspot positions covering the years 1761 and 1764 – 1777. The resulting butterfly diagram shows the characteristic structure known from observations in the 19th and 20th century. We do see some indications of equatorial sunspots in the observations we have from Cycle 1. However, in Cycle 2, which has much better coverage, we do not see such indications.","author_count":4,"contributors":["Karoff, Christoffer","Jørgensen, Carsten Sønderskov","Senthamizh Pavai, V.","Arlt, Rainer"],"cuid":["S01-000.00-217851"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"corresponding_author":["Karoff, Christoffer"],"country":["Germany"],"glorg":["All Global Affiliations","Leibniz Institute for Astrophysics Potsdam"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"christian horrebow s sunspot observations ii construction of a record of sunspot positions","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://arxiv.org/pdf/1906.10895.pdf","version":"Pre-print"},"id":"S01-000.00-217851","identifier":[{"id":"85067231654","type":"scopus"}],"ids":["au-9b5aa017-9ed5-4a37-af72-e9c4961e43d4"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-4E6F0369EDD27DBC28C47954530AE83C"],"oa_link":[{"access":"oa","type":"rem","url":"https://arxiv.org/pdf/1906.10895.pdf","version":"Pre-print"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Geoscience","Aarhus University, Natural Sciences, Department of Physics and Astronomy, Department of Physics and Astronomy - Stellar Astrophysics Centre"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"de","key":"leibniz institute for astrophysics potsdam","loc":["Germany","Europe, EU","OECD"],"name":"Leibniz Institute for Astrophysics Potsdam","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Christoffer","key":"karoffpau","last":"Karoff","locid":"b71daf07-cedf-42bb-bd7c-b0af441e57cd","name":"Karoff, Christoffer","orcid":"0000-0003-2009-7965","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Carsten Sønderskov","key":"jørgensenpau","last":"Jørgensen","locid":"9bcfa0f7-ade7-4627-adf6-56adab418d7c","name":"Jørgensen, Carsten Sønderskov","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"V.","key":"senthamizhpavaipau","last":"Senthamizh Pavai","name":"Senthamizh Pavai, V.","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Rainer","key":"arltpau","last":"Arlt","name":"Arlt, Rainer","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1007/s11207-019-1466-y","issn":["00380938","1573093X"],"issn_org":["00380938"],"issue":"6","journal":"Solar Physics","paperid":"78","publisher":"Springer","status":"p","title":"Solar Physics","volume":"294"},"review":"Peer Reviewed","scoID":["2-s2.0-85067231654"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-9b5aa017-9ed5-4a37-af72-e9c4961e43d4"],"src":["AU Aarhus University"],"title":"Christian Horrebow’s sunspot observations – II : construction of a record of sunspot positions","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-217851","year":"2019","yearsub":"2019"}
{"abstract":"Background: Models of collaborative care and consultation liaison propose organizational changes to improve the quality of care for people with common mental disorders, such as anxiety and depression. Some literature suggests only short-term positive effects of consultation liaison on patient-related outcomes, whereas collaborative care demonstrates both short-term and long-term positive effects. To our knowledge, only one randomized trial has compared the effects of these models. Collaborative care was superior to consultation liaison in reducing symptoms of depression for up to 3 months, but the authors found no difference at 9-months' follow-up. The Collabri Flex Trial for Depression and the Collabri Flex Trial for Anxiety aim to compare the effects of collaborative care with those of a form of consultation liaison that contains potential contaminating elements from collaborative care. The trials build on knowledge from the previous cluster-randomized Collabri trials. Methods: Two randomized, investigator-initiated, parallel-group, superiority trials have been established: one investigating the effects of collaborative care vs consultation liaison for depression and one investigating the effects of collaborative care vs consultation liaison for generalized anxiety, panic disorder and social anxiety disorder at 6-months' follow-up. Participants are recruited from general practices in the Capital Region of Denmark: 240 in the depression trial and 284 in the anxiety trial. The primary outcome is self-reported depression symptoms (Beck Depression Inventory (BDI-II)) in the depression trial and self-reported anxiety symptoms (Beck Anxiety Inventory (BAI)) in the anxiety trial. In both trials, the self-reported secondary outcomes are general psychological problems and symptoms (Symptom Checklist 90-Revised), functional impairment (Sheehan Disability Scale) and general well-being (World Health Organization-Five Well-Being Index). In the depression trial, BAI is an additional secondary outcome, and BDI-II is an additional secondary outcome in the anxiety trial. Explorative outcomes will also be collected. Discussion: The results will supplement those of the cluster-randomized Collabri trials and provide pivotal information about the effects of collaborative care in Denmark. Trial registration: ClinicalTrials.gov, NCT03113175 and NCT03113201. Registered on 13 April 2017.","author_count":7,"contributors":["Curth, Nadja Kehler","Brinck-Claussen, Ursula","Jørgensen, Kirstine Bro","Rosendal, Susanne","Hjorthøj, Carsten","Nordentoft, Merete","Eplov, Lene Falgaard"],"cuid":["S01-000.00-495969"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Anxiety","Cognitive behavioral therapy","Collaborative care","Depression","General practice","Randomized Controlled Trial"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"collaborative care vs consultation liaison for depression and anxiety disorders in general practice study protocol for two randomized controlled trials the danish collabri flex trials","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s13063-019-3657-0","version":"Published Version"},"id":"S01-000.00-495969","identifier":[{"id":"31653228","type":"pmid"},{"id":"PMC6814969","type":"pmcid"},{"id":"85074139560","type":"scopus"}],"ids":["ku-abac5d5c-bcf4-4a55-869f-73a2e51db42b"],"keyword":["Anxiety","Cognitive behavioral therapy","Collaborative care","Depression","General practice","Randomized controlled trial"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-15BF17CBC9433774B206A7018DFA434A"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s13063-019-3657-0","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/241368601/Collaborative_care_vs_consultation_liaison_for_depression_and_anxiety_disorders_in_general_practice.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Mental Health Services Glostrup"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Psychiatry"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Nadja Kehler","key":"curthpau","last":"Curth","name":"Curth, Nadja Kehler","rank":1,"rolecode":"pau"},{"affno":"1","first":"Ursula","key":"brinckclaussenpau","last":"Brinck-Claussen","name":"Brinck-Claussen, Ursula","rank":2,"rolecode":"pau"},{"affno":"1","first":"Kirstine Bro","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, Kirstine Bro","rank":3,"rolecode":"pau"},{"affno":"1","first":"Susanne","key":"rosendalpau","last":"Rosendal","name":"Rosendal, Susanne","rank":4,"rolecode":"pau"},{"affno":"1","first":"Carsten","key":"hjorthøjpau","last":"Hjorthøj","name":"Hjorthøj, Carsten","rank":5,"rolecode":"pau"},{"affno":"2","first":"Merete","key":"nordentoftpau","last":"Nordentoft","locid":"6d0fe19c-7c81-463b-8bc8-822d71584b69","name":"Nordentoft, Merete","rank":6,"rolecode":"pau"},{"affno":"1","first":"Lene Falgaard","key":"eplovpau","last":"Eplov","name":"Eplov, Lene Falgaard","rank":7,"rolecode":"pau"}],"pmid":["31653228"],"pub":{"doi":"10.1186/s13063-019-3657-0","issn":["14686708","17456215"],"issn_org":["17456215"],"journal":"Trials","paperid":"607","status":"p","title":"Trials","volume":"20"},"review":"Peer Reviewed","scoID":["2-s2.0-85074139560"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-abac5d5c-bcf4-4a55-869f-73a2e51db42b"],"src":["KU University of Copenhagen"],"title":"Collaborative care vs consultation liaison for depression and anxiety disorders in general practice : study protocol for two randomized controlled trials (the Danish Collabri Flex trials)","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-495969","year":"2019","yearsub":"2019"}
{"abstract":"To describe glucose metabolism in the late, weight stable phase after Roux-en-Y Gastric Bypass (RYGB) in patients with and without preoperative type 2 diabetes we invited 55 RYGB-operated persons from two existing cohorts to participate in a late follow-up study. 44 (24 with normal glucose tolerance (NGT)/20 with type 2 diabetes (T2D) before surgery) accepted the invitation (median follow-up 2.7 [Range 2.2-5.0 years]). Subjects were examined during an oral glucose stimulus and results compared to preoperative and 1-year (1 y) post RYGB results. Glucose tolerance, insulin resistance, beta-cell function and incretin hormone secretion were evaluated. 1 y weight loss was maintained late after surgery. Glycemic control, insulin resistance, beta-cell function and GLP-1 remained improved late after surgery in both groups. In NGT subjects, nadir glucose decreased 1 y after RYGB, but did not change further. In T2D patients, relative change in weight from 1 y to late after RYGB correlated with relative change in fasting glucose and HbA1c, whereas relative changes in glucose-stimulated insulin release correlated inversely with relative changes in postprandial glucose excursions. In NGT subjects, relative changes in postprandial nadir glucose correlated with changes in beta-cell glucose sensitivity. Thus, effects of RYGB on weight and glucose metabolism are maintained late after surgery in patients with and without preoperative T2D. Weight loss and improved beta-cell function both contribute to maintenance of long-term glycemic control in patients with type 2 diabetes, and increased glucose stimulated insulin secretion may contribute to postprandial hypoglycemia in NGT subjects.","author_count":8,"contributors":["Jørgensen, Nils B","Bojsen-Møller, Kirstine N","Dirksen, Carsten","Martinussen, Christoffer","Svane, Maria S","Kristiansen, Viggo B","Holst, Jens Juul","Madsbad, Sten"],"cuid":["S01-000.00-507503"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"sustained improvements in glucose metabolism late after roux en y gastric bypass surgery in patients with and without preoperative diabetes","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41598-019-51516-y","version":"Published Version"},"id":"S01-000.00-507503","identifier":[{"id":"31641146","type":"pmid"},{"id":"PMC6805911","type":"pmcid"},{"id":"85073735113","type":"scopus"}],"ids":["ku-bf1d68e1-8d8c-48e4-833c-b91c9463cc3c"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-103813CB5C22729C1960C72E636D195C"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/232973110/s41598_019_51516_y.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41598-019-51516-y","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Basic Metabolic Research, Integrative Metabolism and Environmental Influences","Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Basic Metabolic Research, Juul Holst Group"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Nils B","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, Nils B","rank":1,"rolecode":"pau"},{"affno":"","first":"Kirstine N","key":"bojsenmøllerpau","last":"Bojsen-Møller","name":"Bojsen-Møller, Kirstine N","rank":2,"rolecode":"pau"},{"affno":"","first":"Carsten","key":"dirksenpau","last":"Dirksen","name":"Dirksen, Carsten","rank":3,"rolecode":"pau"},{"affno":"","first":"Christoffer","key":"martinussenpau","last":"Martinussen","name":"Martinussen, Christoffer","rank":4,"rolecode":"pau"},{"affno":"","first":"Maria S","key":"svanepau","last":"Svane","name":"Svane, Maria S","rank":5,"rolecode":"pau"},{"affno":"","first":"Viggo B","key":"kristiansenpau","last":"Kristiansen","name":"Kristiansen, Viggo B","rank":6,"rolecode":"pau"},{"affno":"1","first":"Jens J","key":"holstpau","last":"Holst","locid":"864b6401-9024-4773-9bdb-f4d4ca57dcad","name":"Holst, Jens Juul","name_org":"Holst, Jens J","orcid":"0000-0001-6853-3805","rank":7,"rolecode":"pau"},{"affno":"1","first":"Sten","key":"madsbadpau","last":"Madsbad","locid":"1018c708-245a-4057-9263-074578042385","name":"Madsbad, Sten","rank":8,"rolecode":"pau"}],"pmid":["31641146"],"pub":{"doi":"10.1038/s41598-019-51516-y","issn":["20452322"],"issue":"1","journal":"Scientific Reports","paperid":"15154","status":"p","title":"Scientific Reports","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-85073735113"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-bf1d68e1-8d8c-48e4-833c-b91c9463cc3c"],"src":["KU University of Copenhagen"],"title":"Sustained Improvements in Glucose Metabolism Late After Roux-En-Y Gastric Bypass Surgery in Patients with and Without Preoperative Diabetes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-507503","year":"2019","yearsub":"2019"}
{"abstract":"The herbicide bentazone is used extensively worldwide, and it is frequently detected in groundwater sources used for drinking water production. Previously, bentazone has been shown to be biodegraded in filter sand from biological rapid sand filters at various waterworks. This untapped potential could be an inexpensive and sustainable alternative for the removal of trace organic contaminants. To study the fate of bentazone in sand filters and to identify associated risks, degradation pathways in filter sand were identified and the toxicity of identified transformation products was evaluated using quantitative structure–activity relationship (QSAR) modelling. Bentazone degradation was investigated in microcosm experiments with filter sand, effluent water and bentazone at elevated (5 mg L−1) and environmentally relevant concentrations (<10 μg L−1). The investigations at elevated concentrations revealed up to 10 transformation products, suggesting three main biotransformation pathways: 1) oxidation of the isopropyl-moiety to the corresponding carboxylic acid, 2) oxidation of the aromatic ring leading to ring cleavage and subsequent decarboxylation reactions, and 3) N-methylation followed by oxidation to a carboxylic acid. At environmentally relevant concentrations, 92% of the initial bentazone was removed within 13 days, and at this point only one transformation product, carboxy-bentazone, could be detected in the water. QSAR-models considering both human and environmentally relevant endpoints showed that degradation in filter sand led to a detoxification of bentazone. Initial oxidation processes followed by further degradation, and partial mineralization highlights the relevance of both methanotrophs and heterotrophs for the bentazone degradation in rapid sand filters.","author_count":3,"contributors":["Hedegaard, Mathilde Jørgensen","Prasse, Carsten","Albrechtsen, Hans-Jørgen"],"cuid":["S01-000.00-340880"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","OECD"],"corresponding_author":["Hedegaard, Mathilde Jørgensen"],"country":["United States"],"glorg":["All Global Affiliations","Johns Hopkins University"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"microbial degradation pathways of the herbicide bentazone in filter sand used for drinking water treatment","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/170842373/Hedegaard_et_al.pdf","version":"Authors Final Version"},"id":"S01-000.00-340880","identifier":[{"id":"85062337332","type":"scopus"}],"ids":["dtu-79ad5647-24ed-4f4e-bd17-3dac21c6076a"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-39EA2B72ACB664E1F7666004AB2F05BF"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/170842373/Hedegaard_et_al.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Environmental Engineering"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"us","key":"johns hopkins university","loc":["United States","America, North","OECD"],"name":"Johns Hopkins University","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Mathilde Jørgensen","key":"hedegaardpau","last":"Hedegaard","locid":"319db4ab-79ff-4d4f-ba37-70229ac0f17e","name":"Hedegaard, Mathilde Jørgensen","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Carsten","key":"prassepau","last":"Prasse","name":"Prasse, Carsten","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hans-Jørgen","key":"albrechtsenpau","last":"Albrechtsen","locid":"92db8edb-41cf-4015-941a-9a772340913b","name":"Albrechtsen, Hans-Jørgen","orcid":"0000-0003-3483-7709","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1039/c8ew00790j","issn":["20531400","20531419"],"issn_org":["20531400"],"issue":"3","journal":"Environmental Science: Water Research & Technology","pages":"521-532","publisher":"Royal Society of Chemistry","status":"p","title":"Environmental Science: Water Research & Technology","volume":"5"},"review":"Peer Reviewed","scoID":["2-s2.0-85062337332"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-79ad5647-24ed-4f4e-bd17-3dac21c6076a"],"src":["DTU Technical University of Denmark"],"title":"Microbial degradation pathways of the herbicide bentazone in filter sand used for drinking water treatment","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-340880","year":"2019","yearsub":"2019"}
