rgensen, Trine","rank":2,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Trine M M","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, Trine M M","rank":2,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Annette","key":"høghpau","last":"Høgh","locid":"78c4f7b4-e4f6-454b-8984-f1cdc83e4a82","name":"Høgh, Annette","orcid":"0000-0001-7525-9007","rank":3,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Carsten","key":"behrrasmussenpau","last":"Behr-Rasmussen","locid":"a7e50d5c-fefe-45d9-ac73-7b46c0a3e724","name":"Behr-Rasmussen, Carsten","rank":4,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Søren P","key":"johnsenpau","last":"Johnsen","locid":"4664f7a0-39e7-4f46-9121-1c3999eb3d09","name":"Johnsen, Søren Paaske","name_org":"Johnsen, Søren P","rank":5,"rolecode":"pau"},{"affno":"1 4 2 3","corresponding":null,"first":"Jes S","key":"lindholtpau","last":"Lindholt","locid":"8c04d12e-9a82-4ded-8763-b9e82e31afd8","name":"Lindholt, Jes S.","name_org":"Lindholt, Jes S","orcid":"0000-0001-9536-4488","rank":6,"rolecode":"pau"}],"pmid":["27460909"],"pub":{"doi":"10.1016/j.jvs.2016.04.061","issn":["07415214","10976809"],"issn_org":["07415214"],"issue":"3","journal":"Journal of Vascular Surgery","publisher":"Elsevier Inc.","status":"p","title":"Journal of Vascular Surgery","volume":"65"},"review":"Peer Reviewed","scoID":["2-s2.0-85008315556"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-2712c68d-e2ca-4e3d-b52a-ea2c38645ad6","sdu-0ba0963c-a89b-46a9-a680-af5de704a867"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Low-dose aspirin and rupture of abdominal aortic aneurysm","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-098.37-015442","year":"2017","yearsub":2018}
{"abstract":"BACKGROUND: Postnatal exposure to perfluorinated alkylate substances (PFASs) is associated with lower serum concentrations of specific antibodies against certain childhood vaccines at 7 y. OBJECTIVES: We prospectively followed a Faroese birth cohort to determine these associations at 13 y. METHODS: In 516 subjects (79% of eligible cohort members) who were 13 years old, serum concentrations of PFASs and of antibodies against diphtheria and tetanus were measured and were compared with data from the previous examination at 7 y. Multiple regression analyses and structural equation models were applied to determine the association between postnatal PFAS exposures and antibody concentrations. RESULTS: Serum concentrations of PFASs and antibodies generally declined from 7 y to 13 y. However, 68 subjects had visited the emergency room and had likely received a vaccination booster, and a total of 202 children showed higher vaccine antibody concentrations at 13 y than at 7 y. Therefore, separate analyses were conducted after exclusion of these two subgroups. Diphtheria antibody concentrations decreased at elevated PFAS concentrations at 13 y and 7 y; the associations were statistically significant for perfluorodecanoate (PFDA) at 7 y and for perfluorooctanoate (PFOA) at 13 y, both suggesting a decrease by ∼25% for each doubling of exposure. Structural equation models showed that a doubling in PFAS exposure at 7 y was associated with losses in diphtheria antibody concentrations at 13 y of 10–30% for the five PFASs. Few associations were observed for anti-tetanus concentrations. CONCLUSIONS: These results are in accord with previous findings of PFAS immunotoxicity at current exposure levels. https://doi.org/10.1289/EHP275.","author_count":6,"contributors":["Grandjean, Philippe","Heilmann, Carsten","Weihe, Pal","Nielsen, Flemming","Mogensen, Ulla Brasch","Budtz-Jørgensen, Esben"],"cuid":["S02-099.90-041212"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["America, North","Europe, Non-EU","Nordic","OECD"],"country":["Faroe Islands","United States"],"glorg":["All Global Affiliations","Faroese Hospital System","Harvard T.H. Chan School of Public Health"],"keyword":["Adolescent","Antibodies Bacterial","Antibodies Bacterial blood","Child","Denmark","Diphtheria Toxoid","Environmental Exposure","Environmental Monitoring","Environmental Pollutants","Environmental Pollutants blood","Female","Fluorocarbons","Fluorocarbons blood","Humans","Journal Article","Male","Prospective Studies","Sulfonic Acids","Tetanus Toxoid"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"serum vaccine antibody concentrations in adolescents exposed to perfluorinated compounds","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1289/EHP275","version":"Published Version"},"id":"S02-099.90-041212","identifier":[{"id":"85032802027","type":"scopus"},{"id":"28749778","type":"pmid"},{"id":"PMC5744724","type":"pmcid"}],"ids":["ku-2e4bbef5-d3bf-4c4c-9d84-3a0cd94e3b32","sdu-640402db-831c-4bc4-a249-fa8a29a6bc9d"],"keyword":["Adolescent","Antibodies, Bacterial","Antibodies, Bacterial/blood","Child","Denmark","Diphtheria Toxoid","Diphtheria Toxoid/administration & dosage","Environmental Exposure","Environmental Monitoring","Environmental Pollutants","Environmental Pollutants/blood","Female","Fluorocarbons","Fluorocarbons/blood","Humans","Journal Article","Male","Prospective Studies","Sulfonic Acids","Sulfonic Acids/blood","Tetanus Toxoid","Tetanus Toxoid/administration & dosage"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["G