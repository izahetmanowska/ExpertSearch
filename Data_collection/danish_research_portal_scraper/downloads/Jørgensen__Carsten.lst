{"author_count":5,"contributors":["Andersen, Pernille Tanggaard","Bak, Carsten Kronborg"],"cuid":["S01-000.00-653180"],"filters":{"added":"2023-01","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"edu","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U","DI-UC"],"level3":{"U":["DI-U-ALL","DI-U-SDU"],"UC":["DI-UC-ALL","DI-UC-UCS"]},"level3all":["DI-U-SDU","DI-UC-UCS"]},"review":"und","rtype":["clu"],"sorti":"sundhed og sygdom","src":["ucsyd"],"src-code":["DI-UC-UCS"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-653180","ids":["ucsyd-2f2cd65c-a401-4fb0-aeb0-fdbb8882a462"],"lang":"Danish","level":"Educational","mra":["Social Science"],"noi":["Local-1-1-2E753A87EE04A66EFCEC8518A95BB647"],"org":[{"affno":"1","country":"dk","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["University of Southern Denmark"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","key":"uc syd university college south denmark","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-UCS","l3nl":"UC SYD, University College South Denmark","l3nn":"UC SYD University College South Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"UC SYD University College South Denmark","namevar":["UC SYD, Pædagogik og skole, Forskning, Forskning","UC SYD, Pædagogik og skole, Forskning, Forskningsprogrammet for socialt arbejde, forvaltning og kommunikation"],"nora_code":"DI-UC-UCS","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Pernille Tanggaard","key":"andersenpau","last":"Andersen","name":"Andersen, Pernille Tanggaard","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Carsten Kronborg","key":"bakpau","last":"Bak","locid":"e08c0097-b692-4bab-8bc4-f6f0ce769a10","name":"Bak, Carsten Kronborg","orcid":"0000-0003-3174-7919","rank":2,"rolecode":"pau"},{"affno":"","first":"Bent","key":"grevepedh","last":"Greve","name":"Greve, Bent","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Anja","key":"jørgensenpedh","last":"Jørgensen","name":"Jørgensen, Anja","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Jørgen Elm","key":"larsenpedh","last":"Larsen","name":"Larsen, Jørgen Elm","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"edition":"2","isbn":["9788702322507"],"pages":"321-344","place":"Kbh.","publisher":"Hans Reitzels Forlag","status":"p","subtitle":"centrale ideer og principper","title":"Det danske samfund"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","All University Colleges","DI-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","UC SYD, University College South Denmark","Universities","University Colleges","University of Southern Denmark"],"PST":["Published"]},"sid":["ucsyd-2f2cd65c-a401-4fb0-aeb0-fdbb8882a462"],"src":["UC SYD University College South Denmark"],"title":"Sundhed og sygdom","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-653180","year":"2022","yearsub":"2022"}
{"abstract":"We used the Danish National Health Registers to conduct a study on the prevalence of obesity-related comorbidities in Danish citizens who have been diagnosed with obesity at a Danish hospital. This was a retrospective observational study with a population comprising all Danish citizens (≥18 years) who have been registered with a specific obesity class diagnosis in the Danish National Patient Register between 2002 and 2018. A total of 86 980 persons with hospital-diagnosed obesity were included in the study population. To investigate how the risk of having comorbidities varies with the degree of obesity, we applied adjusted logistic regression to estimate the odds ratio of having one of the following predefined comorbidities for people with a BMI in obesity classes II and III compared with people with a BMI in obesity class I: type 2 diabetes, ischaemic heart disease, non-alcoholic steatohepatitis and non-alcoholic fatty liver disease, hip and knee osteoarthritis, obstructive sleep apnoea and asthma. Comorbidities were defined from ICD-10 diagnosis codes and prescription medication utilization. The odds ratio for obstructive sleep apnoea (OR 1.86 and OR 3.0), type 2 diabetes (OR 1.68 and OR 2.26), hip and knee osteoarthritis (OR 1.29 and OR 1.54) and asthma (OR1.13 and OR 1.25) increased significantly with obesity class (obesity class II relative to I and III relative to I, respectively). The odds ratio of having had at least one comorbidity was estimated to be 1.52 for people with a BMI in obesity class II and 2.10 for people with a BMI in obesity class III compared with people in obesity class I. The risk of obstructive sleep apnoea, type 2 diabetes, hip and knee osteoarthritis, and asthma increased significantly with increasing BMI, highlighting the importance of preventing further weight gain even in individuals who are already living with obesity.","author_count":7,"contributors":["Pedersen, Mikkel H.","Bøgelund, Mette","Dirksen, Carsten","Johansen, Pierre","Jørgensen, Nils Bruun","Madsbad, Sten","Pantin, Ulrik H."],"cuid":["S01-000.00-670200"],"filters":{"added":"2023-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Burden of illness","Comorbidities","Obesity"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-NOVO","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-PR-NOVO","DI-PR-OTH","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the prevalence of comorbidities in danish patients with obesity a danish register based study based on data from 000000002002 to 000000002018","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1111/cob.12542","version":"Published Version"},"id":"S01-000.00-670200","identifier":[{"id":"35768944","type":"pmid"},{"id":"85146781079","type":"scopus"},{"id":"PMC9539517","type":"pmcid"}],"ids":["ku-53b32f3b-8d34-40e1-94bd-0de5e409585e"],"keyword":["burden of illness","comorbidities","obesity"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-B6621E83E2AA1F45ACB6F4C9CA64D8C3"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/344854459/The_prevalence_of_comorbidities_in_Danish.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1111/cob.12542","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["Incentive"],"nora_code":"DI-PR-OTH","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal Medicine: Endocrinology"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"dk","key":"novo nordisk","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-NOVO","l3nl":"Novo Nordisk","l3nn":"Novo Nordisk","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Novo Nordisk","namevar":["Novo Nordisk"],"nora_code":"DI-PR-NOVO","used":1}],"person":[{"affno":"1","first":"Mikkel H.","key":"pedersenpau","last":"Pedersen","name":"Pedersen, Mikkel H.","rank":1,"rolecode":"pau"},{"affno":"1","first":"Mette","key":"bøgelundpau","last":"Bøgelund","name":"Bøgelund, Mette","rank":2,"rolecode":"pau"},{"affno":"2","first":"Carsten","key":"dirksenpau","last":"Dirksen","locid":"2504d7c9-ee3f-4990-9c1b-10be728b298c","name":"Dirksen, Carsten","rank":3,"rolecode":"pau"},{"affno":"3","first":"Pierre","key":"johansenpau","last":"Johansen","name":"Johansen, Pierre","rank":4,"rolecode":"pau"},{"affno":"2","first":"Nils B.","key":"jørgensenpau","last":"Jørgensen","locid":"a7e601a6-3ad6-46d0-9a6a-b8956c0af321","name":"Jørgensen, Nils Bruun","name_org":"Jørgensen, Nils B.","rank":5,"rolecode":"pau"},{"affno":"2","first":"Sten","key":"madsbadpau","last":"Madsbad","locid":"1018c708-245a-4057-9263-074578042385","name":"Madsbad, Sten","rank":6,"rolecode":"pau"},{"affno":"3","first":"Ulrik H.","key":"pantinpau","last":"Pantin","name":"Pantin, Ulrik H.","rank":7,"rolecode":"pau"}],"pmid":["35768944"],"pub":{"doi":"10.1111/cob.12542","issn":["17588103","17588111"],"issn_org":["17588103"],"issue":"5","journal":"Clinical Obesity","paperid":"e12542","status":"p","title":"Clinical Obesity","title_org":"Clinical obesity","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-85146781079"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Novo Nordisk","Other Companies","Private Research","Universities","University of Copenhagen","incentive"],"PST":["Published"]},"sid":["ku-53b32f3b-8d34-40e1-94bd-0de5e409585e"],"src":["KU University of Copenhagen"],"title":"The prevalence of comorbidities in Danish patients with obesity – A Danish register-based study based on data from 2002 to 2018","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-670200","year":"2022","yearsub":"2022"}
{"abstract":"Background: Effects of exercise in patients with breast cancer have been thoroughly investigated. The aim was to explore differences in effects regarding type, delivery mode and extensiveness (e.g. intensity; volume) of the interventions. Methods: We searched for randomised controlled trials including patients with breast cancer receiving systemic treatment, exercise-based interventions, and measures on patient reported- and objectively measured outcomes. Results: Exercise showed significant and moderate effects on the primary outcomes quality of life and physical function, Standardised Mean Difference: 0.52 (95 % CI 0.38–0.65) and 0.52 (95 % CI 0.38–0.66), respectively. Type of exercise had little influence on the effects, however combined aerobic- and resistance exercise seemed superior for increasing physical function, compared to aerobic or resistance exercise. Supervised interventions were superior to partly and unsupervised. Extensiveness of the intervention only influenced physical function. Conclusions: Supervised interventions, more than type or extensiveness of interventions, seem to increase effects.","author_count":7,"contributors":["Andersen, Høgni Hammershaimb","Vinther, Anders","Lund, Cecilia Margareta","Paludan, Camilla","Jørgensen, Claus Thomas","Nielsen, Dorte Lisbet","Juhl, Carsten Bogh"],"cuid":["S02-095.65-039693"],"filters":{"added":"2022-11","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Andersen, Høgni Hammershaimb"],"keyword":["Breast cancer","Exercise","Meta analysis","Quality of Life","Systemic treatment"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"effectiveness of different types delivery modes and extensiveness of exercise in patients with breast cancer receiving systemic treatment a systematic review and meta analysis","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85137067248","version":"Other Version"},"id":"S02-095.65-039693","identifier":[{"id":"36031174","type":"pmid"},{"id":"85137067248","type":"scopus"}],"ids":["ku-009010f2-83d2-4b77-af2f-eac59d620aff","sdu-70e134a8-f039-4608-8336-de1bae985920"],"keyword":["Breast Cancer","Exercise","Meta-analysis","Quality of life","Systemic treatment"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-7DD08CCF5C9B2B2C1D8FA62D12F982C2"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital","Herlev og Gentofte Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1 2","first":"Høgni Hammershaimb","key":"andersenpau","last":"Andersen","locid":"de315001-a54c-4084-bb4f-6d8599ab915d","name":"Andersen, Høgni Hammershaimb","rank":1,"rolecode":"pau"},{"affno":"2","first":"Anders","key":"vintherpau","last":"Vinther","name":"Vinther, Anders","rank":2,"rolecode":"pau"},{"affno":"1 2","first":"Cecilia Margareta","key":"lundpau","last":"Lund","locid":"1fb18e5b-7c88-43c0-9fa7-6c8a8668e75c","name":"Lund, Cecilia Margareta","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Camilla","key":"paludanpau","last":"Paludan","locid":"ec7b1b6c-65c1-4c5d-937e-47251fbae5f7","name":"Paludan, Camilla","rank":4,"rolecode":"pau"},{"affno":"2","first":"Claus Thomas","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, Claus Thomas","rank":5,"rolecode":"pau"},{"affno":"1","first":"Dorte","key":"nielsenpau","last":"Nielsen","locid":"8bd14092-b1da-4f24-b4db-d31d38f5f1b7","name":"Nielsen, Dorte Lisbet","name_org":"Nielsen, Dorte","rank":6,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Carsten Bogh","key":"juhlpau","last":"Juhl","locid":"9381fad1-5721-4b98-ac99-7df1c6e4d837","name":"Juhl, Carsten Bogh","orcid":"0000-0001-8456-5364","rank":7,"rolecode":"pau"}],"pmid":["36031174"],"pub":{"doi":"10.1016/j.critrevonc.2022.103802","issn":["10408428","18790461"],"issn_org":["10408428"],"journal":"Critical Reviews in Oncology/Hematology","paperid":"103802","publisher":"Elsevier","status":"p","title":"Critical Reviews in Oncology/Hematology","volume":"178"},"review":"Peer Reviewed","scoID":["2-s2.0-85137067248"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-009010f2-83d2-4b77-af2f-eac59d620aff","sdu-70e134a8-f039-4608-8336-de1bae985920"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Effectiveness of different types, delivery modes and extensiveness of exercise in patients with breast cancer receiving systemic treatment – A systematic review and meta-analysis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-095.65-039693","year":"2022","yearsub":"2022"}
{"abstract":"Type I interferons (IFN-I) play a critical role in human antiviral immunity, as demonstrated by the exceptionally rare deleterious variants of IFNAR1 or IFNAR2. We investigated five children from Greenland, Canada, and Alaska presenting with viral diseases, including life-threatening COVID-19 or influenza, in addition to meningoencephalitis and/or hemophagocytic lymphohistiocytosis following live-attenuated viral vaccination. The affected individuals bore the same homozygous IFNAR2 c.157T>C, p.Ser53Pro missense variant. Although absent from reference databases, p.Ser53Pro occurred with a minor allele frequency of 0.034 in their Inuit ancestry. The serine to proline substitution prevented cell surface expression of IFNAR2 protein, small amounts of which persisted intracellularly in an aberrantly glycosylated state. Cells exclusively expressing the p.Ser53Pro variant lacked responses to recombinant IFN-I and displayed heightened vulnerability to multiple viruses in vitro-a phenotype rescued by wild-type IFNAR2 complementation. This novel form of autosomal recessive IFNAR2 deficiency reinforces the essential role of IFN-I in viral immunity. Further studies are warranted to assess the need for population screening.","author_count":39,"contributors":["Duncan, Christopher J A","Skouboe, Morten Kelder","Howarth, Sophie","Hollensen, Anne Kruse","Chen, Rui","Børresen, Malene L","Thompson, Benjamin J","Stremenova Spegarova, Jarmila","Hatton, Catherine F","Stæger, Frederik F","Andersen, Mette K","Whittaker, John","Paludan, Søren R","Jørgensen, Sofie Eg","Thomsen, Martin K.","Mikkelsen, Jacob Giehm","Heilmann, Carsten","Buhas, Daniela","Øbro, Nina F","Bay, Jakob T","Marquart, Hanne V","de la Morena, M Teresa","Klejka, Joseph A","Hirschfeld, Matthew","Borgwardt, Line","Forss, Isabel","Masmas, Tania","Poulsen, Anja","Noya, Francisco","Rouleau, Guy","Hansen, Torben","Zhou, Sirui","Albrechtsen, Anders","Alizadehfar, Reza","Allenspach, Eric J","Hambleton, Sophie","Mogensen, Trine H"],"cuid":["S02-098.82-026015"],"filters":{"added":"2022-06","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","Europe, Non-EU","OECD"],"corresponding_author":["Duncan, Christopher J A","Mogensen, Trine H"],"country":["Canada","United Kingdom","United States"],"glorg":["Alaska Native Medical Center","All Global Affiliations","McGill University","Newcastle University","Seattle Children's Hospital","Yukon Kuskokwim Health Corporation"],"keyword":["Covid 19","Humans","Inheritance Patterns","Interferon Type I genetics","Receptor Interferon alpha beta"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"life threatening viral disease in a novel form of autosomal recessive i ifnar000000000002 i deficiency in the arctic","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1084/jem.20212427","version":"Published Version"},"id":"S02-098.82-026015","identifier":[{"id":"000868086400001","type":"wos"},{"id":"35442417","type":"pmid"},{"id":"85132164145","type":"scopus"},{"id":"PMC9026249","type":"pmcid"}],"ids":["au-b757e732-7387-4f85-a735-033eeb60180f","ku-38e5d906-7ed0-4521-981d-02d7dbdab48d"],"keyword":["Antiviral Agents/metabolism","COVID-19","Humans","Inheritance Patterns","Interferon Type I/genetics","Receptor, Interferon alpha-beta"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-4296AC4599DBA9DF64164699813E7E8A"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1084/jem.20212427","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/308898178/jem_20212427.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.au.dk/ws/files/331570925/jem_20212427.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"gb","key":"newcastle university","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Newcastle University","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Biomedicine, Department of Biomedicine - Forskning og uddannelse, Skou-bygningen","Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Infectious Diseases"],"nora_code":"DI-U-AU","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Biology, Computational and RNA Biology"],"nora_code":"DI-U-KU","used":1},{"affno":"4","country":"ca","key":"mcgill university","loc":["Canada","America, North","OECD"],"name":"McGill University","used":1},{"affno":"5","country":"us","key":"seattle children s hospital","loc":["United States","America, North","OECD"],"name":"Seattle Children's Hospital","used":1},{"affno":"6","country":"us","key":"yukon kuskokwim health corporation","loc":["United States","America, North","OECD"],"name":"Yukon Kuskokwim Health Corporation","used":1},{"affno":"7","country":"us","key":"alaska native medical center","loc":["United States","America, North","OECD"],"name":"Alaska Native Medical Center","used":1}],"pers