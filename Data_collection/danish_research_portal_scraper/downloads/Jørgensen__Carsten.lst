{"author_count":6,"contributors":["Jørgensen, Carsten René","Berntsen, Dorthe","Sørensen, Morten Bech","Kjølbye, Morten","Bennedsen, Birgit","Ramsgaard, Stine"],"cuid":["S01-000.00-181717"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"identity related autobiographical memories and cultural life scripts in patients with borderline personality disorder","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://pure.au.dk/ws/files/71801581/J_rgensen_Berntsen_Bech_Kj_lbye_Bennedsen_og_Ramsgaard_2012_.pdf","version":"Authors Final Version"},"id":"S01-000.00-181717","identifier":[{"id":"84860501368","type":"scopus"},{"id":"22356875","type":"pmid"}],"ids":["au-5bd5b4b9-30e3-4c96-921c-b899f10639d5"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-4-EC2A77CB39AE84B42CB2614B88C78C78"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://pure.au.dk/ws/files/71801581/J_rgensen_Berntsen_Bech_Kj_lbye_Bennedsen_og_Ramsgaard_2012_.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus BSS, Department of Psychology and Behavioural Sciences"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Carsten René","key":"jørgensenpau","last":"Jørgensen","locid":"3763a4db-6ce1-4e54-ac67-524a9604e1ce","name":"Jørgensen, Carsten René","orcid":"0000-0002-7324-1628","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Dorthe","key":"berntsenpau","last":"Berntsen","locid":"2a5c3e80-973a-4b35-883d-a7de4143885c","name":"Berntsen, Dorthe","orcid":"0000-0001-5941-314X","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Morten Bech","key":"sørensenpau","last":"Sørensen","name":"Sørensen, Morten Bech","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Morten","key":"kjølbyepau","last":"Kjølbye","locid":"ee83f57f-449f-409a-a16a-47ea46248ec6","name":"Kjølbye, Morten","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Birgit","key":"bennedsenpau","last":"Bennedsen","locid":"89892e48-fc01-4f99-9c84-754de8c3c9dc","name":"Bennedsen, Birgit","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Stine","key":"ramsgaardpau","last":"Ramsgaard","locid":"1434d984-b0f7-48bc-8269-b6f9c159a2f8","name":"Ramsgaard, Stine","rank":6,"rolecode":"pau"}],"pmid":["22356875"],"pub":{"doi":"10.1016/j.concog.2012.01.010","issn":["10538100","10902376"],"issn_org":["10538100"],"journal":"Consciousness and Cognition","pages":"788-98","publisher":"Academic Press Inc.","status":"p","title":"Consciousness and Cognition","volume":"21"},"review":"Peer Reviewed","scoID":["2-s2.0-84860501368"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-5bd5b4b9-30e3-4c96-921c-b899f10639d5"],"src":["AU Aarhus University"],"title":"Identity-related autobiographical memories and cultural life scripts in patients with borderline personality disorder","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-181717","year":"2012","yearsub":"2012"}
{"abstract":"Conventional recovery techniques enable recovery of 10-50% of the oil in an oil field. Advances in smart well technology and enhanced oil recovery techniques enable significant larger recovery. To realize this potential, feedback model-based optimal control technologies are needed to manipulate the injections and oil production such that flow is uniform in a given geological structure. Even in the case of conventional water flooding, feedback based optimal control technologies may enable higher oil recovery than with conventional operational strategies. The optimal control problems that must be solved are large-scale problems and require specialized numerical algorithms. In this paper, we combine a single shooting optimization algorithm based on sequential quadratic programming (SQP) with explicit singly diagonally implicit Runge-Kutta (ESDIRK) integration methods and the a continuous adjoint method for sensitivity computation. We demonstrate the procedure on a water ooding example with conventional injectors and producers.","author_count":4,"contributors":["Capolei, Andrea","Völcker, Carsten","Frydendall, Jan","Jørgensen, John Bagterp"],"cuid":["S01-000.00-349854"],"event":{"end":"2012-06-01","place":"Trondheim, no","start":"2012-05-31","title":"1st IFAC Workshop","year":"2012"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Numerical methods","Oil reservoir","Optimal control","Optimization"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"oil reservoir production optimization using single shooting and esdirk methods","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/12090863/Capolei_etal_IFACOIL2012_publishedPaper_0030.pdf","version":"Published Version"},"id":"S01-000.00-349854","identifier":[{"id":"84866124761","type":"scopus"}],"ids":["dtu-97c8beae-5bcf-4c29-b6df-b81afe16a5ff"],"keyword":["Numerical Methods","Oil Reservoir","Optimal Control","Optimization"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-B6D51B2CFA125E9F0DF7994DE5779F33"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.3182/20120531-2-NO-4020.00030","version":"Other Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/12090863/Capolei_etal_IFACOIL2012_publishedPaper_0030.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Centers, Center for Energy Resources Engineering","Technical University of Denmark, Department of Informatics and Mathematical Modeling","Technical University of Denmark, Department of Informatics and Mathematical Modeling, Scientific Computing"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Andrea","key":"capoleipau","last":"Capolei","locid":"72ebcb80-bfc7-40e9-a955-504e449d6782","name":"Capolei, Andrea","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Carsten","key":"völckerpau","last":"Völcker","locid":"c3f83288-e76c-48d8-bb93-cedc1ae0d972","name":"Völcker, Carsten","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jan","key":"frydendallpau","last":"Frydendall","locid":"6505891b-b6b9-4c6e-b89c-b7c2015577e6","name":"Frydendall, Jan","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"John Bagterp","key":"jørgensenpau","last":"Jørgensen","locid":"d2bc6de4-a5c6-43f7-8712-606bd02a88e9","name":"Jørgensen, John Bagterp","orcid":"0000-0001-9799-2808","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.3182/20120531-2-no-4020.00030","isbn":["9783902661999"],"pages":"286-291","publisher":"International Federation of Automatic Control","series":"IFAC Proceedings Volumes","status":"p","title":"Automatic Control in Offshore Oil and Gas Production","volume":"1"},"review":"Peer Reviewed","scoID":["2-s2.0-84866124761"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-97c8beae-5bcf-4c29-b6df-b81afe16a5ff"],"src":["DTU Technical University of Denmark"],"title":"Oil Reservoir Production Optimization using Single Shooting and ESDIRK Methods","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-349854","year":"2012","yearsub":"2012"}
{"abstract":"Conventional recovery techniques enable recovery of 10-50% of the oil in an oil eld. Advances in smart well technology and enhanced oil recovery techniques enable signicant larger recovery. To realize this potential, feedback model-based optimal control technologies are needed to manipulate the injections and oil production such that ow is uniform in a given geological structure. Even in the case of conventional water ooding, feedback based optimal control technologies may enable higher oil recovery than with conventional operational strategies. The optimal control problems that must be solved are large-scale problems and require specialized numerical algorithms. In this paper, we combine a single shooting optimization algorithm based on sequential quadratic programming (SQP) with explicit singly diagonally implicit Runge-Kutta (ESDIRK) integration methods and a continuous adjoint method for sensitivity computation. We demonstrate the procedure on a water ooding example with conventional injectors and producers.","author_count":7,"contributors":["Capolei, Andrea","Völcker, Carsten","Frydendall, Jan","Jørgensen, John Bagterp"],"cuid":["S01-000.00-352334"],"event":{"end":"2012-01-27","place":"Kongens Lyngby, dk","start":"2012-01-25","title":"17th Nordic Process Control Workshop","year":"2012"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Numerical methods","Oil reservoir","Optimal control","Optimization"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"single shooting and esdirk methods for adjoint based optimization of an oil reservoir","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/6596025/IMM01.pdf","version":"Published Version"},"id":"S01-000.00-352334","ids":["dtu-a0133555-8b02-4bd6-bd5e-ffa38897e036"],"keyword":["Numerical Methods","Oil Reservoir","Optimal Control","Optimization"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-56EC99D9D36D596EB54CB55053E69DE4"],"oa_link":[{"access":"oa","type":"rem","url":"http://npcw17.imm.dtu.dk/default.html","version":"Other Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/6596025/IMM01.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Informatics and Mathematical Modeling","Technical University of Denmark, Department of Informatics and Mathematical Modeling, Scientific Computing"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Andrea","key":"capoleipau","last":"Capolei","locid":"72ebcb80-bfc7-40e9-a955-504e449d6782","name":"Capolei, Andrea","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Carsten","key":"völckerpau","last":"Völcker","locid":"c3f83288-e76c-48d8-bb93-cedc1ae0d972","name":"Völcker, Carsten","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jan","key":"frydendallpau","last":"Frydendall","locid":"6505891b-b6b9-4c6e-b89c-b7c2015577e6","name":"Frydendall, Jan","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"John Bagterp","key":"jørgensenpau","last":"Jørgensen","locid":"d2bc6de4-a5c6-43f7-8712-606bd02a88e9","name":"Jørgensen, John Bagterp","orcid":"0000-0001-9799-2808","rank":4,"rolecode":"pau"},{"affno":"","first":"John Bagterp","key":"jørgensenpedh","last":"Jørgensen","name":"Jørgensen, John Bagte