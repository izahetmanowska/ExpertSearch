au","last":"Andersen","locid":"a08245c4-86df-48d4-b485-d0fee481d01e","name":"Andersen, Stine Linding","orcid":"0000-0001-6336-1936","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Nicole C","key":"dezielpau","last":"Deziel","name":"Deziel, Nicole C","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Wan-Ling","key":"tsengpau","last":"Tseng","name":"Tseng, Wan-Ling","rank":10,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Kosuke","key":"inouepau","last":"Inoue","name":"Inoue, Kosuke","rank":11,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Eva Cecilie","key":"bonefeldjørgensenpau","last":"Bonefeld-Jørgensen","locid":"2e9445d9-efa7-4668-b6cd-41982d42e0b0","name":"Bonefeld-Jørgensen, Eva Cecilie","rank":12,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"country":"dk","first":"Jørn","key":"olsenpau","last":"Olsen","locid":"48e09bb0-9b9d-40c8-ab2c-ff256ae11f0f","name":"Olsen, Jørn","orcid":"0000-0001-7462-5140","rank":13,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Zeyan","key":"liewpau","last":"Liew","name":"Liew, Zeyan","rank":14,"rolecode":"pau"}],"pmid":["32846178"],"pub":{"doi":"10.1016/j.envres.2020.110111","issn":["00139351","10960953"],"issn_org":["00139351"],"journal":"Environmental Research","paperid":"110111","publisher":"Academic Press Inc.","status":"p","title":"Environmental Research","volume":"191"},"review":"Peer Reviewed","scoID":["2-s2.0-85089939808"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities"],"PST":["Published"]},"sid":["aau-31f8bf09-75fa-4efd-ac13-271b9627ed83","au-f0524421-4e96-40fb-a524-c3848035c352"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Prenatal exposure to perfluoroalkyl substances and behavioral difficulties in childhood at 7 and 11 years","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-002482","year":"2020","yearsub":"2020"}
{"abstract":"The Victorian Institute of Sport Assessment (VISA) questionnaire model is based on item response theory using a graded response (responses reflect increasing difficulty). The purpose of the VISA-G is to monitor patient outcomes and evaluate treatment strategies for people with greater trochanteric pain syndrome (GTPS). The primary aim of the current study was to translate and culturally adapt the VISA-G into a Danish context (DK) through forward and back translation and cognitive interviews. The second aim was to establish test-retest reliability and face validity of the VISA-G into a Danish context (DK). No major disagreements were observed between the original and translated versions of the questionnaire. A total of 58 heterogenous asymptomatic, and 49 symptomatic respondents (response rate: 92% and 78% respectively) completed the VISA-G.DK twice, 1 week apart. The VISA-G.DK had excellent internal consistency (Cronbach's alpha: asymptomatic = 0.86; symptomatic = 0.98). The test-retest reliability was excellent for the total score: ICC: 0.961 (95% CI [0.933-0.978]). Standard Error Measurement was calculated to be 0.6. Bland-Altman plots showed no significant or relevant differences from test to retest in the total score with mean differences below 1 (0.61). The minimal detectable change was 3.17 for both groups. The VISA-G.DK was found to be valid, reliable and acceptable for use in the Danish population.","author_count":5,"contributors":["Jorgensen, Jens Erik","Fearon, Angela M","Mølgaard, Carsten","Kristinsson, Jens","Andreasen, Jane"],"cuid":["S01-000.00-124104"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["OECD","Oceania"],"country":["Australia"],"glorg":["All Global Affiliations","Canberra Hospital"],"keyword":["Hip pain","Lateral","Pain"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Sofiendal Aalborg Sundhedsteam"],"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"translation validation and test retest reliability of the visa g patient reported outcome tool into danish visa g dk","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.7717/peerj.8724","version":"Published Version"},"id":"S01-000.00-124104","identifier":[{"id":"32181058","type":"pmid"},{"id":"85083487733","type":"scopus"}],"ids":["aau-ff18c6fc-7143-494c-afe6-9ad333909517"],"keyword":["Hip function","Hip pain","Lateral","Musculskeletal","Pain","VISA-G.DK"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-73A7E89D330E450976ABE89BB9E60291"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.7717/peerj.8724","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/330641853/Jorgensen_et_al_2020_Translation_validation_and_test_retest_reliability_of_the_VISA_G_patient_reported_outcome_tool_into_Danish_VISA_G.DK_.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Sofiendal Aalborg Sundhedsteam"],"nora_code":"DI-OT","used":1},{"affno":"2","country":"au","key":"canberra hospital","loc":["Australia","Oceania","OECD"],"name":"Canberra Hospital","used":1},{"affno":"3","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Orthopaedic Surgery","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Physiotherapy and Occupational Therapy","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Hoved-Orto"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jens Erik","key":"jorgensenpau","last":"Jorgensen","name":"Jorgensen, Jens Erik","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Angela M","key":"fearonpau","last":"Fearon","name":"Fearon, Angela M","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Carsten M","key":"molgaardpau","last":"Molgaard","locid":"e49f2521-d695-41bf-b1c2-595166292dfd","name":"Mølgaard, Carsten","name_org":"Molgaard, Carsten M","orcid":"0000-0002-7427-8078","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jens","key":"kristinssonpau","last":"Kristinsson","locid":"d279d9c4-5f5e-4d78-a617-a3bde3352dbf","name":"Kristinsson, Jens","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Jane","key":"andreasenpau","last":"Andreasen","locid":"afdfbe5c-39d0-4504-a751-4e3e2b5b0b6c","name":"Andreasen, Jane","orcid":"0000-0001-8000-1553","rank":5,"rolecode":"pau"}],"pmid":["32181058"],"pub":{"doi":"10.7717/peerj.8724","issn":["21678359"],"issue":"3","journal":"PeerJ","paperid":"e8724","publisher":"PeerJ Inc.","status":"p","title":"PeerJ","volume":"8"},"review":"Peer Reviewed","scoID":["2-s2.0-85083487733"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["aau-ff18c6fc-7143-494c-afe6-9ad333909517"],"src":["AAU Aalborg Universi