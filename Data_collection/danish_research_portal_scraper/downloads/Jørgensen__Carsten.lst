d":"a4849303-7384-4c5e-b820-cb5800787bba","name":"Chen, Ming","orcid":"0000-0002-5393-1103","rank":13,"rolecode":"pau"},{"affno":"1 9","first":"Carsten Utoft","key":"niemannpau","last":"Niemann","locid":"c34cbf81-3f48-4443-8481-b428de733daa","name":"Niemann, Carsten Utoft","rank":14,"rolecode":"pau"},{"affno":"1 9","first":"Anne Mette","key":"lebechpau","last":"Lebech","locid":"f9b459b7-e203-4824-9d80-e7c0e5b56232","name":"Lebech, Anne Mette","orcid":"0000-0002-0943-3289","rank":15,"rolecode":"pau"},{"affno":"1 9","first":"Niels","key":"obelpau","last":"Obel","locid":"47b44abc-6c99-4a76-b8b0-ca53b033951b","name":"Obel, Niels","rank":16,"rolecode":"pau"}],"pmid":["37871679"],"pub":{"doi":"10.1016/j.cmi.2023.10.017","issn":["1198743X","14690691"],"issn_org":["1198743X"],"issue":"2","journal":"Clinical Microbiology and Infection","pages":"231-239","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"p","title":"Clinical Microbiology and Infection","volume":"30"},"review":"Peer Reviewed","scoID":["2-s2.0-85176099586"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","North Denmark Region","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-6b63c055-68bf-411e-ba37-d7617eb6e95a","au-c624a1be-f6e3-4fc6-91c6-75c128fa78be","ku-abe11d44-218a-445b-9306-94b466956ed3","sdu-b59a4d62-81c7-4791-b962-de2243254fc5"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Risk of haematologic cancers among individuals tested for Borrelia burgdorferi antibodies, and Borrelia burgdorferi seropositive individuals: a nationwide population-based matched cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-100.00-724187","year":"2024","yearsub":"2024"}
{"abstract":"Introduction: The treatment of tibial nonunion is challenging and treatment may be conservative or surgical. Conservative strategies include functional braces and weight bearing, or focused extracorporeal shockwave therapy (fESWT). Case description: A 45-year-old male patient sustained spiral tibial shaft fractures and was treated surgically within 24 hours after the initial accident with intramedullary nails. The tibial fracture was later classified as nonunion after 11 months. Radiologic evaluation 17 months after the initial trauma demonstrated clinical nonunion, and subsequently the patient was offered a conservative approach with fESWT to facilitate an increase in callus formation. The handpiece was fitted with a stand-off II (long), penetration depth of 15 mm. Three cycles were administered in month 17, 19 and 20 after baseline. Each cycle consisted of three treatments sessions spaced with 6-8 days apart, and consisted of 3000 to 4000 impulses each given at 0.25-0.84 mJ/mm2. The number of impulses and the power at the focus point varied according to the pain response. Outcomes: The patient achieved union 23 months after fracture. A clinical important improvement was observed with both Lower Extremity Functional Scale (LEFS) (18-point difference) and Patient Specific Functional Scale (PSFS) (average: 4.7 points,) The \"worst pain last 24 hours\" was reduced by 5 points. These values express minimal clinically important difference (MCID) values in these functional patient-reported outcome measures. Conclusion: This treatment strategy may be viable in a broader setting, including private practice physiotherapy thereby treating the patient in close proximity to the patient's everyday life.","author_count":4,"contributors":["Jorgensen, Jens Erik","Larsen, Peter","Elsøe, Rasmus","Mølgaard, Carsten"],"cuid":["S01-000.00-097501"],"filters":{"added":"2022-09","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Jorgensen, Jens Erik"],"keyword":["Extracorporeal shock wave therapy","Nonunion","Physiotherapy","Primary sector"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Sofiendal Aalborg Sundhedsteam"],"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"callus formation and bone remodeling in a tibial nonunion after minimal invasive percutaneous screw fixation followed by extracorporeal shockwave therapy 000000000017 months after initial trauma a case report","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85135888415&partnerID=8YFLogxK","version":"Other Version"},"funding_acknowledgement":["The author(s) reported there is no funding associated with the work featured in this article."],"id":"S01-000.00-097501","identifier":[{"id":"85135888415","type":"scopus"}],"ids":["aau-a3b58880-07c0-4c97-8325-79a48af698cf"],"keyword":["Extracorporeal shock wave therapy","nonunion","physiotherapy","primary sector"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-4FA76ED6F4C36C194A03302306850D76"],"org":[{"affno":"1","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Sofiendal Aalborg Sundhedsteam"],"nora_code":"DI-OT","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Orthopaedic Surgery","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Physiotherapy and Occupational Therapy","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jens Erik","key":"jorgensenpau","last":"Jorgensen","name":"Jorgensen, Jens Erik","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Peter","key":"larsenpau","last":"Larsen","locid":"21210203-656b-4b12-81cf-5f838dd57e33","name":"Larsen, Peter","orcid":"0000-0001-8094-4463","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Rasmus","key":"elsoepau","last":"Elsoe","locid":"d76bd066-40d4-4fcb-b264-ce8421d08fdf","name":"Elsøe, Rasmus","name_org":"Elsoe, Rasmus","orcid":"0000-0001-5781-5604","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Carsten M.","key":"mølgaardpau","last":"Mølgaard","locid":"e49f2521-d695-41bf-b1c2-595166292dfd","name":"Mølgaard, Carsten","name_org":"Mølgaard, Carsten M.","orcid":"0000-0002-7427-8078","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1080/09593985.2022.2112117","issn":["09593985","15325040"],"issn_org":["09593985"],"issue":"2","journal":"Physiotherapy Theory and Practice","pages":"395-407","publisher":"Informa Healthcare","status":"p","title":"Physiotherapy Theory and Practice","volume":"40"},"review":"Peer Reviewed","scoID":["2-s2.0-85135888415"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["aau-a3b58880-07c0-4c97-8325-79a48af698cf"],"src":["AAU Aalborg University"],"title":"Callus formation and bone remodeling in a tibial nonunion after minimal invasive percutaneous screw fixation followed by extracorporeal shockwave therapy 17-months after initial trauma – A case report","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-097501","year":"2024","yearsub":"2024"}
{"abstract":"Articles 110 to 113 TFEU are some of the few provisions in the TFEU that deal explicitly with fiscal regulation. However, this does not mean that no other parts of the TFEU influence the tax measures of the MS. Since tax measures cannot be viewed in isolation in a legal system, as they both heavily influence and are influenced by other areas of law, it is appropriate to consider several other provisions of the TFEU when dealing with the EU tax law.","author_count":2,"contributors":["Jørgensen, Carsten Willemoes","Terkilsen, Lars Kjærgård"],"cuid":["S01-000.00-183926"],"filters":{"added":"2023-02","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["EU ret","Harmonisering","Interne afgifter"],"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"article 000000000113 harmonisation of indirect taxes","src":["au"],"src-code":["DI-U-AU"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-183926","ids":["au-5fa8b38c-6345-447f-b25d-1ee58b70a6d6"],"keyword":["EU-ret","Harmonisering","Interne afgifter","TEUF 113"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-3-0A1208C90866909F538E9F01EFFC5EF9"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus BSS, Department of Law"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Carsten Willemoes","key":"jørgensenpau","last":"Jørgensen","locid":"69969451-0c6e-42f9-bbbc-ee6c03b2464f","name":"Jørgensen, Carsten Willemoes","orcid":"0000-0001-5880-7294","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first