ied Mathematics and Computer Science, Scientific Computing"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"zealand pharma","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-ZEA","l3nl":"Zealand Pharma A/S","l3nn":"Zealand Pharma","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Zealand Pharma","namevar":["Zealand Pharma A/S"],"nora_code":"DI-PR-ZEA","used":1},{"affno":"3","country":"ca","key":"mcgill university","loc":["Canada","America, North","OECD"],"name":"McGill University","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"Sabrina Lyngbye","key":"wendtpau","last":"Wendt","locid":"053fcca6-8b59-439b-ad9a-4abe1507ae4f","name":"Wendt, Sabrina Lyngbye","orcid":"0000-0002-1520-0254","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Carsten","key":"boyeknudsenpau","last":"Boye Knudsen","name":"Boye Knudsen, Carsten","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"John Bagterp","key":"jørgensenpau","last":"Jørgensen","locid":"d2bc6de4-a5c6-43f7-8712-606bd02a88e9","name":"Jørgensen, John Bagterp","orcid":"0000-0001-9799-2808","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik","key":"madsenpau","last":"Madsen","locid":"458e950b-adfd-4f2d-8d0d-ef39dee24bea","name":"Madsen, Henrik","orcid":"0000-0003-0690-3713","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Ahmad","key":"haidarpau","last":"Haidar","name":"Haidar, Ahmad","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Private Research","Technical University of Denmark","Universities","Zealand Pharma A/S"],"PST":["Published"]},"sid":["dtu-b8d96a96-2c09-4cf2-8a5a-0d0cb2305585"],"src":["DTU Technical University of Denmark"],"title":"Modelling the glucose-insulin-glucagon dynamics after subcutaneous administration of native glucagon and a novel glucagon analogue in dogs","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-359843","year":"2016","yearsub":"2016"}
{"abstract":"In recent years, ecological research has suggested several mechanisms by which biodiversity might affect the risk of acquiring infectious diseases (i.e., the decoy, dilution or amplification effects), but the topic remains controversial. While many experimental studies suggest a negative relationship between biodiversity and disease, this relationship is inherently complex, and might be negative, positive or neutral depending on the geographical scale and ecological context. Here, applying a macroecological approach, we look for associations between diversity and disease by comparing the distribution of human schistosomiasis and biogeographical patterns of freshwater snail and mammal species richness in Uganda. We found that the association between estimated snail richness and human infection was best described by a negative correlation in non-spatial bi- and multivariate logistic mixed effect models. However, this association lost significance after the inclusion of a spatial component in a full geostatistical model, highlighting the importance of accounting for spatial correlation to obtain more precise parameter estimates. Furthermore, we found no significant relationships between mammal richness and schistosomiasis risk. We discuss the limitations of the data and methods used to test the decoy hypothesis for schistosomiasis, and highlight key future research directions that can facilitate more powerful tests of the decoy effect in snail-borne infections, at geographical scales that are relevant for public health and conservation.","author_count":5,"contributors":["Stensgaard, Anna-Sofie","Kristensen, Thomas K.","Jørgensen, Aslak","B. Kabatereine, Narcis","Rahbek, Carsten"],"cuid":["S01-000.00-448415"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Africa"],"country":["Uganda"],"glorg":["All Global Affiliations","Uganda Ministry of Health"],"keyword":["Biodiversity","Decoy effect","Dilution effect","Disease ecology","Health","Macroecology","Parasites"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"associations between patterns of human intestinal schistosomiasis and snail and mammal species richness in uganda can we detect a decoy effect","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.21425/F58321748","version":"Published Version"},"id":"S01-000.00-448415","identifier":[{"id":"85006109945","type":"scopus"}],"ids":["ku-5bd6bbb5-9e5b-4671-b08c-27e56d72c804"],"keyword":["Biodiversity","Decoy effect","Dilution effect","Disease ecology","Health","Macroecology","Parasites","Schistosomiasis, Snails"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-1FC2278E67035048895247A9454C4998"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.21425/F58321748","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/173504383/Stensgaard_2016_associations_between_patterns.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, The Natural History Museum, Natural History Museum of Denmark"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"ug","key":"uganda ministry of health","loc":["Uganda","Africa"],"name":"Uganda Ministry of Health","used":1}],"person":[{"affno":"1","first":"Anna-Sofie","key":"stensgaardpau","last":"Stensgaard","locid":"f5eee669-3e7d-42ec-b4f5-ea03a5608091","name":"Stensgaard, Anna-Sofie","orcid":"0000-0002-7858-7177","rank":1,"rolecode":"pau"},{"affno":"1","first":"Thomas K.","key":"kristensenpau","last":"Kristensen","locid":"de0d7b98-4332-424a-b92b-d35ff36a59ae","name":"Kristensen, Thomas K.","rank":2,"rolecode":"pau"},{"affno":"1","first":"Aslak","key":"jørgensenpau","last":"Jørgensen","locid":"8b7d2fdf-43d3-4424-89dd-b89667bc460c","name":"Jørgensen, Aslak","rank":3,"rolecode":"pau"},{"affno":"2","first":"Narcis","key":"bkabatereinepau","last":"B. Kabatereine","name":"B. Kabatereine, Narcis","rank":4,"rolecode":"pau"},{"affno":"1","first":"Carsten","key":"rahbekpau","last":"Rahbek","locid":"7aab0090-fb0d-4af4-8c65-8e6edbef6684","name":"Rahbek, Carsten","orcid":"0000-0003-4585-0300","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.21425/f58321748","issn":["19486596"],"issue":"3","journal":"Frontiers of Biogeography","paperid":"e21748","status":"p","title":"Frontiers of Biogeography","volume":"8"},"review":"Peer Reviewed","scoID":["2-s2.0-85006109945"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-5bd6bbb5-9e5b-4671-b08c-27e56d72c804"],"src":["KU University of Copenhagen"],"title":"Associations between patterns of human intestinal schistosomiasis and snail and mammal species richness in Uganda : can we detect a decoy effect?","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-448415","year":"2016","yearsub":"2016"}
{"abstract":"Indhold: • Velkommen til magasinet • Hvorfor fokus på koblingen mellem ikt og transfer? • Et socio-kulturelt perspektiv på lære- og transferprocesser • Inspiration fra forskning og forsøgs- og udviklingsprojekter • Værktøjskassen","author_count":5,"contributors":["Riis, Marianne","Bergstedt, Palle","Jørgensen, Claus Bo","Koch, Hans Henrik","Rasmussen, Carsten Lund"],"cuid":["S02-085.62-039232"],"filters":{"added":"2023-02","altsrc":["No Matches Found"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Didaktik","Erhvervsuddannelser","Grænsekrydsning","IKT","Informations og kommunikationsteknologi og e læring","It","Læring","Læring pædagogik og undervisning","Transfer"],"level":"pop","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-UC"],"level3":{"UC":["DI-UC-AB","DI-UC-ALL","DI-UC-KP"]},"level3all":["DI-UC-AB","DI-UC-KP"]},"review":"und","rtype":["clu"],"sorti":"magasinet ikt og transfer i eud nr 000000000001 januar 000000002016","src":["kp","pha"],"src-code":["DI-UC-AB","DI-UC-KP"],"type":"doo","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://iktogtransferieud.files.wordpress.com/2016/01/iot_magasinet_nr1_jan16.pdf","version":"Published Version"},"id":"S02-085.62-039232","ids":["kp-a3cafb1e-7828-4b63-95e3-b37645820ce2","pha-5fcfc7d0-3559-49c1-aa6c-95a101c0a8c2"],"keyword":["IKT","Informations- og kommunikationsteknologi, og e-læring","Læring, pædagogik og undervisning","didaktik","erhvervsuddannelser","grænsekrydsning","it","læring","transfer"],"lang":"Danish","level":"Popular","mra":["Humanities"],"noi":["Local-1-2-4A675A3B5C0C60854A8B110B5935F682"],"oa_link":[{"access":"oa","license":"CC BY-NC-SA","type":"rem","url":"https://iktogtransferieud.files.wordpress.com/2016/01/iot_magasinet_nr1_jan16.pdf","version":"Other Version"}],"org":[{"affno":"1","key":"kp university college copenhagen","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-KP","l3nl":"K