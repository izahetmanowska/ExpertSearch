rnille","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Ellen","key":"tranenørbypau","last":"Trane Nørby","name":"Trane Nørby, Ellen","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Trine","key":"jørgensenpau","last":"Jørgensen","locid":"4b417f79-c334-4856-8b9f-711c8d0a15cb","name":"Jørgensen, Trine","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Carsten","key":"wulffpau","last":"Wulff","locid":"cd62074e-697c-4c07-b82c-af85d394b325","name":"Wulff, Carsten","rank":6,"rolecode":"pau"}],"pub":{"publisher":"SFI - Det Nationale Forskningscenter for Velfærd","status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Governmental Institutions","DI-ALL","DI-GV","DI-GV-ALL","Governmental Institutions"],"PST":["Published"]},"sid":["vive-31bfa77f-8ed5-468d-9358-aabde0d2c6a2"],"src":["VIVE The Danish Center for Social Science Research"],"title":"Social Forskning, 2011:2","type":"Other-Internet Publication","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-662828","year":"2011"}
{"abstract":"Aim: The quality of cardiopulmonary resuscitation (CPR) is a crucial determinant of outcome following cardiac arrest. Interruptions in chest compressions are detrimental. We aimed to compare the effect of mouth-to-mouth ventilation (MMV), mouth-to-pocket mask ventilation (MPV) and bag-valve-mask ventilation (BMV) on the quality of CPR. Materials and methods: Surf lifeguards in active service were included in the study. Each surf lifeguard was randomized to perform three sessions of single-rescuer CPR using each of the three ventilation techniques (MMV, MPV and BMV) separated by 5. min of rest. Data were obtained from a resuscitation manikin and video recordings. Results: A total of 60 surf lifeguards were included (67% male, 33% female, mean age 25 years). Interruptions in chest compressions were significantly reduced by MMV (8.9 ± 1.6. s) when compared to MPV (10.7 ± 3.0. s, P","author_count":6,"contributors":["Adelborg, Kasper","Dalgas, Christian","Grove, Erik Lerkevang","Jørgensen, Carsten","Al-Mashhadi, Rozh Husain","Løfgren, Bo"],"cuid":["S02-093.84-010143"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Løfgren, Bo"],"keyword":["Adult","Allied Health Personnel","Cardiopulmonary resuscitation","Cardiopulmonary resuscitation CPR","Female","Heart Arrest","Humans","Male","Manikins","Masks","Respiration Artificial"],"level":"sci","mra":["hum","med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-HO-CDR","DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"mouth to mouth ventilation is superior to mouth to pocket mask and bag valve mask ventilation during lifeguard cpr a randomized study","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.resuscitation.2011.01.009","version":"Other Version"},"id":"S02-093.84-010143","identifier":[{"id":"79955093083","type":"scopus"},{"id":"21330044","type":"pmid"}],"ids":["aau-d41f6558-7220-490f-ba61-6ede1c99aefa","au-01130278-c4a4-474c-98cf-594106cb253d"],"keyword":["Adult","Allied Health Personnel","Bag-valve-mask ventilation","Cardiopulmonary Resuscitation","Cardiopulmonary resuscitation (CPR)","Female","Heart Arrest","Humans","Male","Manikins","Masks","Mouth-to-mask ventilation","Mouth-to-mouth ventilation","Respiration, Artificial"],"lang":"English","level":"Scientific","mra":["Humanities","Medical Science"],"noi":["Global-Local-2-5-AB34C16EA431B7C1DB2ECBBB777C6DBA"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.resuscitation.2011.01.009","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Health Administrative Centre, Health Administrative Centre - PhD Administration"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1},{"affno":"3","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Humanities","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology"],"nora_code":"DI-U-AAU","used":1}],"perso