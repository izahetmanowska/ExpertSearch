ity of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Life Sciences, Department of Basic Sciences and Environment, Environmental Chemistry and Physics"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Jacqueline","key":"falkenbergjacquelinepau","last":"Falkenberg","name":"Falkenberg, Jacqueline","rank":1,"rolecode":"pau"},{"affno":"1","first":"Heidi","key":"bayheidipau","last":"Bay","name":"Bay, Heidi","rank":2,"rolecode":"pau"},{"affno":"1","first":"Loren","key":"ramsaylorenpau","last":"Ramsay","name":"Ramsay, Loren","rank":3,"rolecode":"pau"},{"affno":"1","first":"Jesper Holm","key":"jørgensenjesperholmpau","last":"Jørgensen","name":"Jørgensen, Jesper Holm","rank":4,"rolecode":"pau"},{"affno":"1","first":"Peter","key":"jørgensenpeterpau","last":"Jørgensen","name":"Jørgensen, Peter","rank":5,"rolecode":"pau"},{"affno":"2","first":"Niels Henrik","key":"spliidnielshenrikpau","last":"Spliid","name":"Spliid, Niels Henrik","rank":6,"rolecode":"pau"},{"affno":"3","first":"Carsten Tilbæk","key":"petersencarstentilbækpau","last":"Petersen","locid":"1a96f560-f27c-4ca0-b48a-6130456a37b8","name":"Petersen, Carsten Tilbæk","orcid":"0000-0001-7574-0351","rank":7,"rolecode":"pau"}],"pub":{"issue":"2 2011","pages":"155","repno":"Redegørelse fra Miljøstyrelsen, 2 2011","series":"Redegørelse fra Miljøstyrelsen","status":"p","volume":"2011"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Other Companies","Private Research","Undetermined","Universities","University of Copenhagen","niras","pj-bluetech aps"],"PST":["Published"]},"sid":["ku-e1208e65-8ef8-4d58-bfa4-bfaa864fb7c2"],"src":["KU University of Copenhagen"],"title":"Redegørelse om glyphosat og AMPA fund i GRUMO","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-527953","year":"2011","yearsub":"2011"}
{"abstract":"This chapter describes three generic categories of assets for technological innovation: 1) process innovative assets, 2) product innovative application assets, and 3) aesthetic design assets (Christensen, 1995). These different types of innovation are used as a framework for discussing effects-driven innovation at the IT vendor CSC Scandihealth A/S. CSC Scandihealth’s business strategy regarding effects-driven innovation is described and related to a partner sourcing model with a client, a hospital in the North Region of Denmark. The chapter analyses how innovation can be organized and the different stakeholders, contexts, and perspectives undertaken by the vendor and the client while engaging in partnership sourcing supported by effects-driven innovation. The experiences and challenges are discussed on the basis of a number of projects with the vendor’s clients.","author_count":4,"contributors":["Barlach, Anders","Simonsen, Jesper"],"cuid":["S01-000.00-558536"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Effects driven IT development","Effects specification","Healthcare","Innovation","Partnership sourcing","System development"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-RUC"]},"level3all":["DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"innovation in partnership sourcing from a vendor s pespective","src":["ruc"],"src-code":["DI-U-RUC"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/33141146/Ch9_Barlach_Simonsen.pdf","version":"Pre-print"},"id":"S01-000.00-558536","ids":["ruc-267fa46c-5f15-496e-bf1b-40647a7a8d39"],"keyword":["Effects specification","Effects-driven IT development","Healthcare","Innovation","Partnership sourcing","System development"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-95A0FBB6BB894AC84AAAD697D7C7E016"],"oa_link":[{"access":"oa","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/33141146/Ch9_Barlach_Simonsen.pdf","version":"Pre-print"}],"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of People and Technology, User-Driven IT Innovation","Roskilde University, The Department of Communication, Business and Information Technologies"],"nora_code":"DI-U-RUC","used":1}],"person":[{"affno":"1","country":"dk","first":"Anders","key":"barlachpau","last":"Barlach","locid":"d5dd19f9-5af3-442f-9a40-922df47c2b32","name":"Barlach, Anders","rank":1,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Jesper","key":"simonsenpau","last":"Simonsen","locid":"580c081f-6732-4194-8a2e-b2b519e1c41d","name":"Simonsen, Jesper","orcid":"0000-0002-1864-7158","rank":2,"rolecode":"pau"},{"affno":"","first":"Morten","key":"hertzumpedh","last":"Hertzum","name":"Hertzum, Morten","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Carsten","key":"jørgensenpedh","last":"Jørgensen","name":"Jørgensen, Carsten","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9788251927581"],"pages":"192-212","publisher":"TAPIR Akademisk Forlag","status":"p","title":"Balancing Sourcing and Innovation in Information Systems Development"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Roskilde University","Universities"],"PST":["Published"]},"sid":["ruc-267fa46c-5f15-496e-bf1b-40647a7a8d39"],"src":["RUC Roskilde University"],"title":"Innovation in partnership sourcing from a vendor's pespective","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-558536","year":"2011","yearsub":"2011"}
{"abstract":"Due to their many advantages, flash-based SSDs (Solid-State Drives) have become a mainstream alternative to magnetic disks for database servers. Nevertheless, database systems, designed and optimized for magnetic disks, still do not fully exploit all the benefits of the new technology. We propose the FB-tree: a combination of an adapted B+-tree, a storage manager, and a buffer manager, all optimized for modern SSDs. Together the techniques enable writing to SSDs in relatively large blocks, thus achieving greater overall throughput. This is achieved by the out-of-place writing, whereby every time a modified index node is written, it is written to a new address, clustered with some other nodes that are written together. While this constantly frees index nodes, the FB-tree does not introduce any garbage-collection overhead, instead relying on naturally occurring free-space segments of sufficient size. As a consequence, the FB-tree outperforms a regular B+-tree in all scenarios tested. For instance, the throughput of a random workload of 75% updates increases by a factor of three using only two times the space of the B+-tree.","author_count":4,"contributors":["Jørgensen, Martin V.","Rasmussen, René B.","Saltenis, Simonas","Schjønning, Carsten"],"cuid":["S01-000.00-059748"],"event":{"end":"2011-09-23","place":"Lisbon, pt","start":"2011-09-21","title":"International Database Engineering &amp; Applications Symposium","year":"2011"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"fb tree a b tree for flash based ssds","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1145/2076623.2076629","version":"Other Version"},"id":"S01-000.00-059748","identifier":[{"id":"84855328296","type":"scopus"}],"ids":["aau-2153151a-c1fc-48c6-9279-f5c1e0255d12"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-23CB94B3B3D5DCFCA54C4B1A6354212E"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1145/2076623.2076629","version":"Other Version"},{"access":"oa","type":"rem","url":"http://dl.acm.org/citation.cfm?doid=2076623.2076629","version":"Other Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (TECH)","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Martin V.","key":"jørgensenpau","last":"Jørgensen","locid":"db60e025-622a-4a6d-a13f-344b553086c4","name":"Jørgensen, Martin V.","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"René B.","key":"rasmussenpau","last":"Rasmussen","locid":"d2c9317b-b9e4-4c86-8cc2-c5255619aec5","name":"Rasmussen, René B.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Simonas","key":"saltenispau","last":"Saltenis","locid":"801274c6-ad7e-4513-97e3-bb8c2a689c3a","name":"Saltenis, Simonas","orcid":"0000-0002-2046-6110","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Carsten","key":"schjønningpau","last":"Schjønning","locid":"41cd36a8-0b14-4452-9e4c-185233c7e80c","name":"Schjønning, Carsten","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1145/2076623.2076629","isbn":["9781450306270"],"pages":"34-42","publisher":"Association for Computing Machinery (ACM)","status":"p","title":"Proceedings of the 15th Symposium on International Database Engineering &amp; Applications"},"review":"Peer Reviewed","scoID":["2-s2.0-84855328296"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-2153151a-c1fc-48c6-9279-f5c1e0255d12"],"src":["AAU Aalborg University"],"title":"FB-Tree: A B+-Tree for Flash-Based SSDs","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-059748","year":"2011","yearsub":"2011"}
