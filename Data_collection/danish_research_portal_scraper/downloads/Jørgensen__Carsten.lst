enpau","last":"Kristiansen","name":"Kristiansen, Viggo B.","rank":8,"rolecode":"pau"},{"affno":"1","first":"Bolette","key":"hartmannpau","last":"Hartmann","locid":"eb04fc6b-068a-4d5b-a106-1b7be3f7e12b","name":"Hartmann, Bolette","orcid":"0000-0001-8509-2036","rank":9,"rolecode":"pau"},{"affno":"1","first":"Jens J","key":"holstpau","last":"Holst","locid":"864b6401-9024-4773-9bdb-f4d4ca57dcad","name":"Holst, Jens Juul","name_org":"Holst, Jens J","orcid":"0000-0001-6853-3805","rank":10,"rolecode":"pau"},{"affno":"1","first":"Maria S","key":"svanepau","last":"Svane","locid":"4cc109fb-b416-4327-a1bd-c980486fa717","name":"Svane, Maria S.","name_org":"Svane, Maria S","rank":11,"rolecode":"pau"},{"affno":"1","first":"Sten","key":"madsbadpau","last":"Madsbad","locid":"1018c708-245a-4057-9263-074578042385","name":"Madsbad, Sten","rank":12,"rolecode":"pau"}],"pmid":["35571890"],"pub":{"doi":"10.3389/fnut.2022.889710","issn":["2296861X"],"journal":"Frontiers in Nutrition","paperid":"889710","status":"p","title":"Frontiers in Nutrition","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-85132615471"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-728f0836-9d03-4bc9-89b4-d687c64d840b"],"src":["KU University of Copenhagen"],"title":"Effect of Meal Texture on Postprandial Glucose Excursions and Gut Hormones After Roux-en-Y Gastric Bypass and Sleeve Gastrectomy","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-461886","year":"2022","yearsub":"2022"}
{"abstract":"This review summarises the present knowledge on weight loss treatment. Weight loss leads to improvement or even remission of obesity-related co-morbidities. The greater the weight loss, the greater the effect. Significant weight loss may be obtained through dietary interventions alone or in combination with pharmacotherapy. Bariatric surgery continues to be the most effective intervention for obesity but is available only to those with the highest BMIs and the highest risk of complications. Access to weight loss treatments is currently limited.","author_count":2,"contributors":["Jørgensen, Niels Bruun","Dirksen, Carsten"],"cuid":["S01-000.00-501207"],"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Bariatric surgery","Body Mass Index","Comorbidity","Humans","Obesity Morbid complications","Obesity surgery","Weight loss"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"systematisk vægttabsbehandling","src":["ku"],"src-code":["DI-U-KU"],"type":"djr","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/358718256/v04220243_web.pdf","version":"Published Version"},"id":"S01-000.00-501207","identifier":[{"id":"36305252","type":"pmid"},{"id":"85140859797","type":"scopus"}],"ids":["ku-b4747245-ee2e-4e42-882c-6fe9cdfb7cfc"],"keyword":["Bariatric Surgery","Body Mass Index","Comorbidity","Humans","Obesity, Morbid/complications","Obesity/surgery","Weight Loss"],"lang":"Danish","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-2-44C08DAA7E9BA3114AFB2DA80DD53032"],"oa_link":[{"access":"oa","type":"rem","url":"https://ugeskriftet.dk/files/scientific_article_files/2022-10/v04220243_web.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/358718256/v04220243_web.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal Medicine: Endocrinology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Niels Bruun","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, Niels Bruun","rank":1,"rolecode":"pau"},{"affno":"1","first":"Carsten","key":"dirksenpau","last":"Dirksen","locid":"2504d7c9-ee3f-4990-9c1b-10be728b298c","name":"Dirksen, Carsten","rank":2,"rolecode":"pau"}],"pmid":["36305252"],"pub":{"issn":["00415782","13994174"],"issn_org":["00415782"],"issue":"42","journal":"Ugeskrift for Læger","paperid":"V04220243","status":"p","title":"Ugeskrift for Læger","title_org":"Ugeskrift for Laeger","volume":"184"},"review":"Peer Reviewed","scoID":["2-s2.0-85140595135"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-b4747245-ee2e-4e42-882c-6fe9cdfb7cfc"],"src":["KU University of Copenhagen"],"title":"Systematisk vægttabsbehandling","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-501207","year":"2022","yearsub":"2022"}
