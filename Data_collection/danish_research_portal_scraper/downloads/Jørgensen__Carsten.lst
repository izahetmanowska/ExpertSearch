":2,"rolecode":"pau"}],"pub":{"issn":["01064223","22449078"],"issn_org":["01064223"],"newspaper":"Berlingske Tidende","pages":"25","publisher":"Berlingske Tidende AS","publisher_org":"Berlingske Tidende A/S","status":"p","title":"Berlingske Tidende","volume":"2011"},"review":"Undetermined","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-c14d9621-0d65-496e-b3da-e06f65c50354"],"src":["AU Aarhus University"],"title":"Grænsekontrollen strider mod EU-retten","type":"Newspaper Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-239641","year":"2011","yearsub":"2011"}
{"abstract":"Artiklen analyserer EU-toldreglerne vedrørende debitorer. Debitor er den person, der er forpligtet til at betale told ved indførsel af varer til EU. De danske regler på området sammenholdes med de gældende EU-regler, og det konkluderes at danske regler er upræcise, mangelfulde og i nogle tilfælde direkte i strid med EU-reglerne. Dette bevirker at også dansk praksis i nogle tilfælde pålægger forkerte debitorer at betale told.","author_count":1,"contributors":["Jørgensen, Carsten Willemoes"],"cuid":["S01-000.00-270041"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"keyword":["Hæftelse"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"debitor i toldretten","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://www.statsbiblioteket.dk/au/showrecord.jsp?record_id=sb_4053254","version":"Other Version"},"id":"S01-000.00-270041","ids":["au-f6ab5ce8-a984-4e46-8ff5-9eb87d022b6f"],"keyword":["Debitor","EU-toldret","Hæftelse"],"lang":"Danish","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-F27D7C0EBD81B4FBF9EC5ED31808BDAE"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.statsbiblioteket.dk/au/showrecord.jsp?record_id=sb_4053254","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus BSS, Aarhus School of Business, Department of Business Law"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Carsten","key":"willemoesjørgensenpau","last":"Willemoes Jørgensen","locid":"69969451-0c6e-42f9-bbbc-ee6c03b2464f","name":"Jørgensen, Carsten Willemoes","name_org":"Willemoes Jørgensen, Carsten","orcid":"0000-0001-5880-7294","rank":1,"rolecode":"pau"}],"pub":{"issn":["0905443X"],"issue":"1","journal":"Skat Udland","pages":"3-20","publisher":"Magnus Informatik AS","publisher_org":"Magnus Informatik A/S","status":"p","title":"Skat Udland","volume":"2011"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-f6ab5ce8-a984-4e46-8ff5-9eb87d022b6f"],"src":["AU Aarhus University"],"title":"Debitor i toldretten","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-270041","year":"2011","yearsub":"2011"}
{"abstract":"To test the hypothesis that physical inactivity impairs the exercise-induced modulation of pyruvate dehydrogenase (PDH), 6 healthy normally physically active male subjects completed 7 days of bed rest. Before and immediately after the bed rest, the subjects completed an OGTT and a one-legged knee extensor exercise bout (45min at 60% Wmax) with muscle biopsies obtained from vastus lateralis before, immediately after exercise, and at 3h of recovery. Blood samples were taken from the femoral vein and artery before and after 40min of exercise. Glucose intake elicited a larger (P=0.05) insulin response after bed rest than before, indicating glucose intolerance. There were no differences in lactate release/uptake across the exercising muscle before and after bed rest, but glucose uptake after 40min of exercise was larger (P=0.05) before bed rest than after. Muscle glycogen content tended to be higher (0.05","author_count":11,"contributors":["Kiilerich, Kristian","Jørgensen, Stine Ringholm","Biensø, Rasmus Sjørup","Fisher, James P","Iversen, Ninna","van Hall, Gerrit","Wojtaszewski, Jørgen","Saltin, Bengt","Lundby, Carsten","Calbet, Jose A L","Pilegaard, Henriette"],"cuid":["S01-000.00-472694"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","OECD"],"country":["Spain","United Kingdom"],"glorg":["All Global Affiliations","Department of Physical Education, University of Las Palmas de Gran Canaria, Canary Islands","University of Birmingham"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"exercise induced pyruvate dehydrogenase activation is not affected by 000000000007 days of bed rest","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1152/japplphysiol.00063.2011","version":"Other Version"},"id":"S01-000.00-472694","identifier":[{"id":"21680880","type":"pmid"},{"id":"80053028213","type":"scopus"}],"ids":["ku-846d5ded-903e-422e-8b5e-58681de45486"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-6C583103474DF83E1A10E4920A1DD6D2"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1152/japplphysiol.00063.2011","version":"Other Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Biology, Molecular Integrative Physiology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"gb","key":"university of birmingham","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Birmingham","used":1},{"affno":"3","country":"es","key":"department of physical education university of las palmas de gran canaria canary islands","loc":["Spain","Europe, EU","OECD"],"name":"Department of Physical Education, University of Las Palmas de Gran Canaria, Canary Islands","used":1}],"person":[{"affno":"1","first":"Kristian","key":"kiilerichpau","last":"Kiilerich","locid":"188c8da4-a200-414a-9b54-033ba0700d5f","name":"Kiilerich, Kristian","rank":1,"rolecode":"pau"},{"affno":"1","first":"Stine Ringholm","key":"jørgensenpau","last":"Jørgensen","locid":"e3e24567-4419-4742-9b22-1f3f20a6b1c1","name":"Jørgensen, Stine Ringholm","rank":2,"rolecode":"pau"},{"affno":"1","first":"Rasmus Sjørup","key":"biensøpau","last":"Biensø","locid":"c6f3c9d2-fa70-4da8-bafc-c37d0334c653","name":"Biensø, Rasmus Sjørup","rank":3,"rolecode":"pau"},{"affno":"2","first":"James P","key":"fisherpau","last":"Fisher","name":"Fisher, James P","rank":4,"rolecode":"pau"},{"affno":"1","first":"Ninna","key":"iversenpau","last":"Iversen","locid":"a3bf007b-12fd-4aa8-ba97-8cf03b1e0944","name":"Iversen, Ninna","rank":5,"rolecode":"pau"},{"affno":"1","first":"Gerrit","key":"vanhallpau","last":"van Hall","locid":"55a9b111-6dbb-4a42-a9ab-d5f3785fbdae","name":"van Hall, Gerrit","orcid":"0000-0002-2519-8127","rank":6,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Jørgen","key":"wojtaszewskipau","last":"Wojtaszewski","locid":"06441180-44ed-4f23-b077-4d90876cc68b","name":"Wojtaszewski, Jørgen","orcid":"0000-0001-8185-3408","rank":7,"rolecode":"pau"},{"affno":"","first":"Bengt","key":"saltinpau","last":"Saltin","locid":"6d7890eb-cafc-46b4-b5fd-6f08cb10986d","name":"Saltin, Bengt","rank":8,"rolecode":"pau"},{"affno":"","first":"Carsten","key":"lundbypau","last":"Lundby","locid":"9287e522-5bf3-4996-8de4-26a32a37cf7c","name":"Lundby, Carsten","rank":9,"rolecode":"pau"},{"affno":"3","first":"Jose A L","key":"calbetpau","last":"Calbet","name":"Calbet, Jose A L","rank":10,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Henriette","key":"pilegaardpau","last":"Pilegaard","locid":"bca00b25-e11a-407d-936f-6982a39ef1d8","name":"Pilegaard, Henriette","orcid":"0000-0002-1071-0327","rank":11,"rolecode":"pau"}],"pmid":["21680880"],"pub":{"doi":"10.1152/japplphysiol.00063.2011","issn":["15221601","87507587"],"issn_org":["87507587"],"issue":"3","journal":"Journal of Applied Physiology","pages":"751-757","status":"p","title":"Journal of Applied Physiology","volume":"111"},"review":"Peer Reviewed","scoID":["2-s2.0-80053028213"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-846d5ded-903e-422e-8b5e-58681de45486"],"src":["KU University of Copenhagen"],"title":"Exercise-induced pyruvate dehydrogenase activation is not affected by 7 days of bed rest","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-472694","year":"2011","yearsub":"2011"}
{"abstract":"We describe the effects-specification process from a project that was conducted during the fall 2010 and spring of 2011 in this chapter. The project configured and implemented an electronic patient record system at a maternity ward at a hospital located in a European region. The process comprised workshops with effects specification with management and end-users and an agile development process including prototypes configured from the effects specifications. We describe the project and the effects-specification process through which effects were related to the system design and instruments for measuring effects were designed. The project is analyzed and lessons learned are discussed.","author_count":5,"contributors":["Simonsen, Jesper","Hertzum, Morten","Barlach, Anders"],"cuid":["S01-000.00-559823"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Effect means end hierarchy","Effects driven IT development","Effects specification","Electronic health record","End user effect workshop","Management effect workshop","Partnership sourcing"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-RUC"]},"level3all":["DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"experiences with effects specifications","src":["ruc"],"src-code":["DI-U-RUC"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/64454246/Simonsen_et_al_2011_preprint.pdf","version":"Pre-print"},"id":"S01-000.00-559823","ids":["ruc-393ca476-a26a-458c-8068-68a10454e812"],"keyword":["Effect means–end hierarchy","Effects specification","Effects-Driven IT Development","Electronic health record","End-user effect workshop","Management effect workshop","Partnership sourcing"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-97B2E42594FF740CD581DA84FECBA6C4"],"oa_link":[{"access":"oa","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/64454246/Simonsen_et_al_2011_preprint.pdf","version":"Pre-print"}],"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of People and Technology, User-Driven IT Innovation","Roskilde University, The Department of Communication, Business and Information Technologies"],"nora_code":"DI-U-RUC","used":1}],"person":[{"affno":"1","country":"dk","first":"Jesper","key":"simonsenpau","last":"Simonsen","locid":"580c081f-6732-4194-8a2e-b2b519e1c41d","name":"Simonsen, Jesper","orcid":"0000-0002-1864-7158","rank":1,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Morten","key":"hertzumpau","last":"Hertzum","locid":"cd5a2f82-1658-4e03-8e6b-63bc1215e394","name":"Hertzum, Morten","orcid":"0000-0003-0019-8531","rank":2,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Anders","key":"barlachpau","last":"Barlach","locid":"d5dd19f9-5af3-442f-9a40-922df47c2b32","name":"Barlach, Anders","rank":3,"rolecode":"pau"},{"affno":"","first":"Morten","key":"hertzumpedh","last":"Hertzum","name":"Hertzum, Morten","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Carsten","key":"jørgensenpedh","last":"Jørgensen","name":"Jørgensen, Carsten","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9788251927581"],"pages":"145-163","place":"Trondheim, NO","publisher":"TAPIR Akademisk Forlag","status":"p","title":"Balancing Sourcing and Innovation in Information Systems Development"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Roskilde University","Universities"],"PST":["Published"]},"sid":["ruc-393ca476-a26a-458c-8068-68a10454e812"],"src":["RUC Ro