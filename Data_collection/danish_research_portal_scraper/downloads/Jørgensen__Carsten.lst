u","last":"Alizadehfar","name":"Alizadehfar, Reza","rank":34,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Eric J","key":"allenspachpau","last":"Allenspach","name":"Allenspach, Eric J","rank":35,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sophie","key":"hambletonpau","last":"Hambleton","name":"Hambleton, Sophie","rank":36,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Trine H","key":"mogensenpau","last":"Mogensen","locid":"c80e96f8-2eac-497f-aee4-5ed4af6dbc94","name":"Mogensen, Trine H","orcid":"0000-0002-1853-9704","rank":37,"rolecode":"pau"}],"pmid":["35442417"],"pub":{"doi":"10.1084/jem.20212427","issn":["00221007","15409538"],"issn_org":["00221007"],"issue":"6","journal":"Journal of Experimental Medicine","paperid":"e20212427","publisher":"Rockefeller University Press","status":"p","title":"Journal of Experimental Medicine","title_org":"The Journal of Experimental Medicine","volume":"219"},"review":"Peer Reviewed","scoID":["2-s2.0-85132164145"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-b757e732-7387-4f85-a735-033eeb60180f","ku-38e5d906-7ed0-4521-981d-02d7dbdab48d"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Life-threatening viral disease in a novel form of autosomal recessive IFNAR2 deficiency in the Arctic","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-098.82-026015","year":"2022","yearsub":"2022"}
{"abstract":"BACKGROUND: Impaired fetal growth may increase vulnerability towards metabolic disturbances associated with some medications. We examined whether birth weight and ponderal index modify the association between psychotropic medication and type 2 diabetes among young adults with severe psychiatric diagnosis. METHODS: A total of 36,957 individuals born in Denmark between 1973 and 1983 with a diagnosis of schizophrenia, bipolar disorder, or depression were followed from first diagnosis until 2018. Cox proportional hazard models were applied to analyse risk of type 2 diabetes with use of psychotropic medications and interactions between psychotropic medication and birth weight and ponderal index, respectively. RESULTS: During follow-up, 1575 (4.2%) individuals received a diagnosis of type 2 diabetes. Use of antipsychotic, mood stabilizing and antidepressant medications were associated with higher hazard ratios (HRs) of type 2 diabetes (HRantipsychotics 1.68 [95%CI 1.49-1.90]; HRmood stabilizing medication 1.41 [95%CI 1.25-1.59]; HRantidepressants 2.00 [95%CI 1.68-2.37]), as were a birth weight below 2500 g (HR 1.13 [95%CI 1.01-1.28]), and high ponderal index (HR 1.26 [95%CI 1.11-1.43]). The highest rates of type 2 diabetes for each psychotropic medication category were found in medication users with low birth weight or high ponderal index. However, neither birth weight nor ponderal index significantly modified the association between psychotropic medication and diabetes risk. CONCLUSION: Psychotropic medication use, birth weight, and ponderal index were risk factors for type 2 diabetes in patients with severe mental illness, but neither birth weight nor ponderal index modified the association between psychotropic medication and type 2 diabetes.","author_count":7,"contributors":["Wium-Andersen, Marie Kim","Jørgensen, Terese Sara Høj","Jørgensen, Martin Balslev","Rungby, Jørgen","Hjorthøj, Carsten","Sørensen, Holger J","Osler, Merete"],"cuid":["S01-000.00-535127"],"filters":{"added":"2022-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the association between birth weight ponderal index psychotropic medication and type 000000000002 diabetes in individuals with severe mental illness","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.jdiacomp.2022.108181","version":"Published Version"},"id":"S01-000.00-535127","identifier":[{"id":"85127311255","type":"scopus"},{"id":"35346563","type":"pmid"}],"ids":["ku-ed5af952-6b47-45b8-a6c3-55e48386136e"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-73AC5603FFBE78A552595F6B4FD183D7"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/303676817/The.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.jdiacomp.2022.108181","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"dk","key":"ssi statens serum institut","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-SSI","l3nn":"SSI Statens Serum Institut","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SSI Statens Serum Institut","namevar":["Statens Serum Institut"],"nora_code":"DI-GV-SSI","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of C