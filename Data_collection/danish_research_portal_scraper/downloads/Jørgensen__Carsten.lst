u"},{"affno":"2","first":"Evelina","key":"martinenaiteevelinapau","last":"Martinenaite","name":"Martinenaite, Evelina","rank":7,"rolecode":"pau"},{"affno":"2","first":"Lone Bredo","key":"pedersenlonebredopau","last":"Pedersen","name":"Pedersen, Lone Bredo","rank":8,"rolecode":"pau"},{"affno":"2","first":"Thomas Landkildehus","key":"lislethomaslandkildehuspau","last":"Lisle","name":"Lisle, Thomas Landkildehus","rank":9,"rolecode":"pau"},{"affno":"1","first":"Anne Ortved","key":"ganganneortvedpau","last":"Gang","locid":"d6439cff-57cd-406d-b6be-940a96f64f8f","name":"Gang, Anne Ortved","rank":10,"rolecode":"pau"},{"affno":"2","first":"Lisbeth","key":"enggaardlisbethpau","last":"Enggaard","name":"Enggaard, Lisbeth","rank":11,"rolecode":"pau"},{"affno":"2","first":"Morten","key":"hansenmortenpau","last":"Hansen","name":"Hansen, Morten","rank":12,"rolecode":"pau"},{"affno":"1","first":"Morten Orebo","key":"holmströmmortenorebopau","last":"Holmström","locid":"7c20c1c4-0b06-45d3-8f97-a37a55cfb726","name":"Holmström, Morten Orebo","rank":13,"rolecode":"pau"},{"affno":"2","first":"Özcan","key":"metözcanpau","last":"Met","name":"Met, Özcan","rank":14,"rolecode":"pau"},{"affno":"1","first":"Inge Marie","key":"svaneingemariepau","last":"Svane","locid":"12c124a9-b64d-4b36-9bbd-c1665658101d","name":"Svane, Inge Marie","orcid":"0000-0002-9451-6037","rank":15,"rolecode":"pau"},{"affno":"1","first":"Carsten Utoft","key":"niemanncarstenutoftpau","last":"Niemann","locid":"c34cbf81-3f48-4443-8481-b428de733daa","name":"Niemann, Carsten Utoft","rank":16,"rolecode":"pau"},{"affno":"1","first":"Lars Møller","key":"pedersenlarsmøllerpau","last":"Pedersen","locid":"e0b39d5a-e306-4f2d-af0c-0483ac71df9a","name":"Pedersen, Lars Møller","rank":17,"rolecode":"pau"},{"affno":"1","first":"Mads Hald","key":"andersenmadshaldpau","last":"Andersen","locid":"f6dda437-480e-4d5e-b0a3-3287c9d2372a","name":"Andersen, Mads Hald","orcid":"0000-0002-2914-9605","rank":18,"rolecode":"pau"}],"pmid":["36483037"],"pub":{"doi":"10.3389/fonc.2022.1023015","issn":["2234943X"],"journal":"Frontiers in Oncology","paperid":"1023015","status":"p","title":"Frontiers in Oncology","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-85143346823"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region Zealand","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-4c25c248-0a16-45e0-8dd5-b18b589b9258"],"src":["KU University of Copenhagen"],"title":"Anti-PD-L1/PD-L2 therapeutic vaccination in untreated chronic lymphocytic leukemia patients with unmutated IgHV","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-438864","year":"2022","yearsub":"2022"}
{"abstract":"Pancreatic ductal adenocarcinoma (PDAC) is a hard-to-treat cancer due to the collagen-rich (fibrotic) and immune-suppressed microenvironment. A major driver of this phenomenon is transforming growth factor beta (TGF-beta). TGF-beta is produced in an inactive complex with a latency-associated protein (LAP) that can be cleaved by plasma kallikrein (PLK), hereby releasing active TGF-beta. The aim of this study was to evaluate LAP cleaved by PLK as a non-invasive biomarker for PDAC and tumor fibrosis. An ELISA was developed for the quantification of PLK-cleaved LAP-TGF-beta in the serum of 34 patients with PDAC (stage 1-4) and 20 healthy individuals. Biomarker levels were correlated with overall survival (OS) and compared to serum type III collagen (PRO-C3) and type VI collagen (PRO-C6) pro-peptides. PLK-cleaved LAP-TGF-beta was higher in patients with PDAC compared to healthy individuals (p < 0.0001). High levels (> median) of PLK-cleaved LAP-TGF-beta were associated with poor OS in patients with PDAC independent of age and stage (HR 2.57, 95% CI: 1.22-5.44, p = 0.0135). High levels of PLK-cleaved LAP-TGF-beta were associated with high PRO-C3 and PRO-C6, indicating a relationship between the PLK-cleaved LAP-TGF-beta fragment, TGF-beta activity, and tumor fibrosis. If these preliminary results are validated, circulating PLK-cleaved LAP-TGF-beta may be a biomarker for future clinical trials.","author_count":14,"contributors":["Pedersen, Rasmus S.","Nissen, Neel","Jensen, Christina","Thorlacius-Ussing, Jeppe","Manon-Jensen, Tina","Olesen, Majken L.","Langholm, Lasse L.","Diab, Hadi M. H.","Jørgensen, Lars Nannestad","Hansen, Carsten P.","Chen, Inna M.","Johansen, Julia S.","Karsdal, Morten A.","Willumsen, Nicholas"],"cuid":["S01-000.00-467276"],"filters":{"added":"2022-11","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Cancer","Collagen","ECM remodeling","Fibrosis","GROWTH FACTOR BETA","Liver","Mechanism","PDAC","Pathway","Plasma Kallikrein","Platelets","Serum biomarker","TGF beta","Tumor fibrosis","Tumor microenvironment"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-PR","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"PR":["DI-PR-ALL","DI-PR-NBIO"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-PR-NBIO","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"plasma kallikrein activated tgf beta is prognostic for poor overall survival in patients with pancreatic ductal adenocarcinoma and associates with increased fibrogenesis","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/biom12091315","version":"Published Version"},"id":"S01-000.00-467276","identifier":[{"id":"85138387279","type":"scopus"},{"id":"PMC9496221","type":"pmcid"},{"id":"000857708900001","type":"wos"},{"id":"36139154","type":"pmid"}],"ids":["ku-7b4d9b77-cb89-4d48-beaa-8156d47b0455"],"keyword":["CANCER","COLLAGEN","ECM remodeling","FIBROSIS","GROWTH-FACTOR-BETA","LAP-TGF-beta","LIVER","MECHANISM","PATHWAY","PDAC","PLATELETS","TGF-BETA-1","TGF-beta","TGF-beta activation","plasma kallikrein","serum biomarker","tumor fibrosis","tumor microenvironment"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-D29DEAB0578D60A7C91FEC37B624EF1D"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/321173514/Plasma_Kallikrein_Activated.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/biom12091315","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","E