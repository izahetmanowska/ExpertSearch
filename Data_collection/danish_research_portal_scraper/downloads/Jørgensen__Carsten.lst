 Lars Bang","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9783943365153"],"pages":"105-133","place":"Berlin","publisher":"Sternberg Press","status":"p","title":"The phantom of liberty. Contemporary art and the pedagogical paradox"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-315323ce-20c0-4fe1-840f-6bbccfd8b9ae"],"src":["AU Aarhus University"],"title":"ADHD: The Pathologization and Medicalization of Active/Restless Boys in Highly Individualized Late-Modern Societies?","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-157534","year":"2014","yearsub":"2014"}
{"abstract":"AIM: To construct new Danish growth charts for 0- to 20-year-olds and to compare them with Danish references from 1982 and with World Health Organization (WHO) standards for children aged 0-5 years from 2006, by applying similar inclusion and exclusion criteria. METHODS: Anthropometric data from three contemporary Danish population-based studies were combined. References for height were based on healthy Caucasian children born at term. A total of 12,671 height measurements (8055 in boys and 4616 in girls) were included. Reference charts were developed using the generalised additive models for location, scale and shape. RESULTS: From prepubertal ages, a secular increase in height was observed for both genders. The differences were most pronounced in puberty, and final heights were increased by 1.4 cm in boys and 2.9 cm in girls compared to 1982 references. In boys, but not girls an upward shift in body mass index (BMI) above median levels was found. Reference curves for height were superimposable with standard curves based on the selective WHO criteria. Danish children were longer/taller and heavier and they had larger head circumferences than those reported in the recent multiethnic WHO standards. CONCLUSION: We recommend national implementation of these contemporary 2014 Danish references for anthropometric measurements.","author_count":13,"contributors":["Tinggaard, Jeanette","Aksglaede, Lise","Sørensen, Kaspar","Mouritsen, Annette","Wohlfahrt-Veje, Christine","Hagen, Casper P","Mieritz, Mikkel G","Jørgensen, Niels","Wolthers, Ole D","Heuck, Carsten","Petersen, Jørgen Holm","Main, Katharina M.","Juul, Anders"],"cuid":["S01-000.00-425458"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Adolescent","Anthropometry","Body Height","Body Mass Index","Body Weight","Child","Child Preschool","Denmark","Female","Growth Charts","Humans","Infant","Male","Reference Values","Young Adult"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the 000000002014 danish references from birth to 000000000020 years for height weight and body mass index","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1111/apa.12468","version":"Other Version"},"id":"S01-000.00-425458","identifier":[{"id":"24127859","type":"pmid"},{"id":"84892599537","type":"scopus"}],"ids":["ku-35dd8a7a-840f-4e99-b83d-ea157ccbf7a9"],"keyword":["Adolescent","Anthropometry","Body Height","Body Mass Index","Body Weight","Child","Child, Preschool","Denmark","Female","Growth Charts","Humans","Infant","Male","Reference Values","Young Adult"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-DFD98225EECA4E52260F3FB07D283C1F"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1111/apa.12468","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Section of Biostatistics"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Jeanette","key":"tinggaardpau","last":"Tinggaard","name":"Tinggaard, Jeanette","rank":1,"rolecode":"pau"},{"affno":"","first":"Lise","key":"aksglaedepau","last":"Aksglaede","name":"Aksglaede, Lise","rank":2,"rolecode":"pau"},{"affno":"","first":"Kaspar","key":"sørensenpau","last":"Sørensen","name":"Sørensen, Kaspar","rank":3,"rolecode":"pau"},{"affno":"","first":"Annette","key":"mouritsenpau","last":"Mouritsen","name":"Mouritsen, Annette","rank":4,"rolecode":"pau"},{"affno":"","first":"Christine","key":"wohlfahrtvejepau","last":"Wohlfahrt-Veje","name":"Wohlfahrt-Veje, Christine","rank":5,"rolecode":"pau"},{"affno":"","first":"Casper P","key":"hagenpau","last":"Hagen","name":"Hagen, Casper P","rank":6,"rolecode":"pau"},{"affno":"","first":"Mikkel G","key":"mieritzpau","last":"Mieritz","name":"Mieritz, Mikkel G","rank":7,"rolecode":"pau"},{"affno":"","first":"Niels","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, Niels","rank":8,"rolecode":"pau"},{"affno":"","first":"Ole D","key":"woltherspau","last":"Wolthers","name":"Wolthers, Ole D","rank":9,"rolecode":"pau"},{"affno":"","first":"Carsten","key":"heuckpau","last":"Heuck","name":"Heuck, Carsten","rank":10,"rolecode":"pau"},{"affno":"1","first":"Jørgen Holm","key":"petersenpau","last":"Petersen","locid":"33c1c5b2-2e1e-4259-b4d7-04657a2bdb9b","name":"Petersen, Jørgen Holm","orcid":"0000-0003-3979-7443","rank":11,"rolecode":"pau"},{"affno":"1","first":"Katharina M","key":"mainpau","last":"Main","locid":"1770eebd-1659-4088-b44c-c9de22a4bb0b","name":"Main, Katharina M.","name_org":"Main, Katharina M","rank":12,"rolecode":"pau"},{"affno":"1","first":"Anders","key":"juulpau","last":"Juul","locid":"f9b11983-c7c8-4111-b119-4de471572898","name":"Juul, Anders","orcid":"0000-0002-0534-4350","rank":13,"rolecode":"pau"}],"pmid":["24127859"],"pub":{"doi":"10.1111/apa.12468","issn":["08035253","08035326"],"issn_org":["08035253"],"issue":"2","journal":"Acta Paediatrica","pages":"214-224","status":"p","title":"Acta Paediatrica","title_org":"Acta paediatrica (Oslo, Norway : 1992)","volume":"103"},"review":"Peer Reviewed","scoID":["2-s2.0-84892599537"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-35dd8a7a-840f-4e99-b83d-ea157ccbf7a9"],"src":["KU University of Copenhagen"],"title":"The 2014 Danish references from birth to 20 years for height, weight and body mass index","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-425458","year":"2014","yearsub":"2014"}
{"abstract":"BACKGROUND: Population-based studies investigating the sex-specific association between thyrotropin (TSH) levels and serum lipid concentrations are scarce. We examined the association between TSH and total cholesterol, low-density lipoprotein (LDL) cholesterol, high-density lipoprotein (HDL) cholesterol, and triglycerides in men and women from the general population. Furthermore, the association with TSH outside and within the reference range and lipid levels was studied. METHODS: Individual data of 13,571 men and women without lipid medication of four population-based studies conducted in Western European adults were pooled for cross-sectional analyses. The association between TSH levels and lipid concentrations were analyzed by calculating sex-specific multivariable median regression models. RESULTS: In the pooled population, serum TSH levels were significantly positively associated with triglyceride values in men and with total cholesterol, LDL cholesterol, and triglyceride values in women. In the pooled male population, low serum TSH levels (<3.0 mIU/L) were significantly associated with lower total cholesterol, while high serum TSH levels (≥ 3.0 mIU/L) were associated with higher triglyceride values. In the pooled female population, low serum TSH levels were significantly associated with lower total cholesterol, LDL cholesterol, and HDL cholesterol. High TSH levels were associated with higher total cholesterol and LDL cholesterol in the pooled female population. In both sexes, serum TSH levels within the reference range (0.3-3.0 mIU/L) were significantly positively associated with triglyceride concentrations. CONCLUSIONS: Increasing levels of TSH were associated with a less favorable lipid profile in both men and women from the general population. In both sexes, TSH levels within the reference range were significantly positively associated with triglyceride concentrations.","author_count":15,"contributors":["Meisinger, Christa","Ittermann, Till","Tiller, Daniel","Agger, Carsten","Nauck, Matthias","Schipf, Sabine","Wallaschofski, Henri","Jørgensen, Torben","Linneberg, Allan","Thiery, Joachim","Kluttig, Alexander","Greiser, Karin H","Werdan, Karl","Burkhardt, Katrin","Völzke, Henry"],"cuid":["S01-000.00-461851"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Adult","Aged","Aged 80 and over","Cross Sectional Studies","European Continental Ancestry Group","Female","Humans","Lipids","Male","Middle Aged","Reference Values","Thyrotropin","Young Adult"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"sex specific associations between thyrotropin and serum lipid profiles","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1089/thy.2013.0259","version":"Other Version"},"id":"S01-000.00-461851","identifier":[{"id":"24102572","type":"pmid"},{"id":"84896757461","type":"scopus"}],"ids":["ku-7280a8bd-88b2-4ce1-a07b-b49bd0d4305f"],"keyword":["Adult","Aged","Aged, 80 and over","Cross-Sectional Studies","European Continental Ancestry Group","Female","Humans","Lipids","Male","Middle Aged","Reference Values","Thyrotropin","Young Adult"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-6A0D9441CE3158FE839057D4D3289DD3"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1089/thy.2013.0259","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Medicinsk Sociologi"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Christa","key":"meisingerpau","last":"Meisinger","name":"Meisinger, Christa","rank":1,"rolecode":"pau"},{"affno":"","first":"Till","key":"ittermannpau","last":"Ittermann","name":"Ittermann, Till","rank":2,"rolecode":"pau"},{"affno":"","first":"Daniel","key":"tillerpau","last":"Tiller","name":"Tiller, Daniel","rank":3,"rolecode":"pau"},{"affno":"","first":"Carsten","key":"aggerpau","last":"Agger","name":"Agger, Carsten","rank":4,"rolecode":"pau"},{"affno":"","first":"Matthias","key":"nauckpau","last":"Nauck","name":"Nauck, Matthias","rank":5,"rolecode":"pau"},{"affno":"","first":"Sabine","key":"schipfpau","last":"Schipf","name":"Schipf, Sabine","rank":6,"rolecode":"pau"},{"affno":"","first":"Henri","key":"wallaschofskipau","last":"Wallaschofski","name":"Wallaschofski, Henri","rank":7,"rolecode":"pau"},{"affno":"","first":"Torben","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, Torben","rank":8,"rolecode":"pau"},{"affno":"1","first":"Allan","key":"linnebergpau","last":"Linneberg","locid":"09da8aa6-fd95-4ace-a2f1-19f38d7d3f9e","name":"Linneberg, Allan","orcid":"0000-0002-0994-0184","rank":9,"rolecode":"pau"},{"affno":"","first":"Joachim","key":"thierypau","last":"Thiery","name":"Thiery, Joachim","rank":10,"rolecode":"pau"},{"affno":"","first":"Alexander","key":"kluttigpau","last":"Kluttig","name":"Kluttig, Alexander","rank":11,"rolecode":"pau"},{"affno":"","first":"Karin H","key":"greiserpau","last":"Greiser","name":"Greiser, Karin H","rank":12,"rolecode":"pau"},{"affno":"","first":"Karl","key":"werdanpau","last":"Werdan","name":"Werdan, Karl","rank":13,"rolecode":"pau"},{"affno":"","first":"Katrin","key":"burkhardtpau","last":"Burkhardt","name":"Burkhardt, Katrin","rank":14,"rolecode":"pau"},{"affno":"","first":"Henry","key":"völzkepau","last":"Völzke","name":"Völzke, Henry","rank":15,"rolecode":"pau"}],"pmid":["24102572"],"pub":{"doi":"10.1089/thy.2013.0259","issn":["10507256","15579077"],"issn_org":["10507256"],"issue":"3","journal":"Thyroid","pages":"424-432","status":"p","title":"Thyroid","volume":"24"},"review":"Peer Reviewed","scoID":["2-s2.0-84896757461"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-7280a8bd-88b2-4ce1-a07b-b49bd0d4305f"],"src":["KU University of Copenhagen"],"title":"Sex-Specific Associations Between Thyrotropin and Serum Lipid Profiles","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-461851","year":"2014","yearsub":"2014"}
{"abstract":"Enhancers control the correct temporal and cell-type-specific activation of gene expression in multicellular eukaryotes. Knowing their properties, regulatory activity and targets is crucial to understand the regulation of differentiation and homeostasis. Here we use the FANTOM5 panel of samples, covering the majority of human tissues and cell types, to produce an atlas of active, in vivo-transcribed enhancers. We show that enhancers share properties with CpG-poor messenger RNA promoters but produce bidirectional, exosome-sensitive, relatively short unspliced RNAs, the generation of which is strongly related to enhancer activity. The atlas is used to compare regulatory programs between different cells at unprecedented depth, to identify disease-associated regulatory single nucleotide polymorphisms, and to classify cell-type-specific and ubiquitous enhancers. We further explore the utility of enhancer redundancy, which explains gene expression strength rather than expression patterns. The online FANTOM5 enhancer atlas represents a unique resource for studies on cell-type-specific enhancers and gene regulation.","author_count":51,"contributors":["Andersson, Robin","Gebhard, Claudia","Miguel-Escalada, Irene","Hoof, Ilka","Bornholdt, Jette","Boyd, Mette","Chen, Yun","Zhao, Xiaobei","Schmidl, Christian","Suzuki, Takahiro","Ntini, Evgenia","Arner, Erik","Valen, Eivind","Li, Kang","Schwarzfischer, Lucia","Glatz, Dagmar","Raithel, Johanna","Lilje, Berit","Rapin, Nicolas","Bagger, Frederik Otzen","Jørgensen, Mette","Andersen, Peter Refsing","Bertin, Nicolas","Rackham, Owen","Burroughs, A Maxwell","Baillie, J Kenneth","Ishizu, Yuri","Shimizu, Yuri","Furuhata, Erina","Maeda, Shiori","Negishi, Yutaka","Mungall, Christopher J","Meehan, Terrence F","Lassmann, Timo","Itoh, Masayoshi","Kawaji, Hideya","Kondo, Naoto","Kawai, Jun","Lennartsson, Andreas","Daub, Carsten O","Heutink, Peter","Hume, David A","Jensen, Torben Heick","Suzuki, Harukazu","Hayashizaki, Yoshihide","Müller, Ferenc","Forrest, Alistair R R","Carninci, Piero","Rehli, Michael","Sandelin, Albin"],"cuid":["S02-098.84-021768"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"51-200 contributors","class":"merged","cluster_size":2,"continent":["America, North","Asia, East","Europe, EU","Europe, Non-EU","Nordic","OECD"],"corpau":["FANTOM Consortium"],"country":["Germany","Japan","Netherlands","Sweden","United Kingdom","United States"],"glorg":["All Global Affiliations","Amsterdam UMC","European Bioinformatics Institute, Wellcome Trust Genome Campus","Karolinska Institutet","Lawrence Berkeley National Laboratory","RIKEN","University Hospital Regensburg","University of Birmingham","University of Edinburgh","Yokohama City University"],"keyword":["Atlases as Topic","Cell Line","Cells Cultured","Cluster Analysis","Enhancer Elements Genetic","Gene Expression Regulation","Genetic Predisposition to Disease","HeLa Cells","Humans","Molecular Sequence Annotation","Organ Specificity","Polymorphism Single Nucleotide","Promoter Regions Genetic","RNA Messenger","Transcription Initiation Genetic","Transcription Initiation Site"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Institut for Molekylærbiologi og Genetik - Genomekspression, stabilitet og teknologi"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"an atlas of active enhancers across human cell types and tissues","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1038/nature12787","version":"Other Version"},"id":"S02-098.84-021768","identifier":[{"id":"24670763","type":"pmid"},{"id":"000333402000032","type":"wos"},{"id":"84897459814","type":"scopus"},{"id":"PMC5215096","type":"pmcid"}],"ids":["au-7ce7d82a-9fed-41ee-b6d6-74d7d472716b","ku-7f95e75a-c548-46bf-8e