{"author_count":4,"contributors":["Kitzing, Lena"],"cuid":["S01-000.00-747173"],"filters":{"added":"2024-08","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"com","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"nr","rtype":["clu"],"sorti":"auctions for the future","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dra","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.11581/DTU.00000340","version":"Published Version"},"id":"S01-000.00-747173","ids":["dtu-f4695728-db5a-46c7-9189-6d97ab72f9eb"],"lang":"English","level":"Commissioned","mra":["Science/Technology"],"noi":["Global-Local-2-2-F0022154718C9FD72018A0C00A1C0D14"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.11581/DTU.00000340","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/364127289/dtu-international--energy-report-2024_chapter5_.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Wind and Energy Systems","Technical University of Denmark, Department of Wind and Energy Systems, Wind Energy Systems Division"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Lena","key":"kitzingpau","last":"Kitzing","locid":"6fbc822e-28a0-4b7b-a032-e83f89494093","name":"Kitzing, Lena","orcid":"0000-0002-8627-7558","rank":1,"rolecode":"pau"},{"affno":"","first":"Birte Holst","key":"jørgensenpedh","last":"Jørgensen","name":"Jørgensen, Birte Holst","rank":2,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Morten W.","key":"jeppesenpedh","last":"Jeppesen","name":"Jeppesen, Morten W.","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Carsten Orth","key":"gaarnlarsenpedh","last":"Gaarn-Larsen","name":"Gaarn-Larsen, Carsten Orth","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.11581/dtu.00000340","eisbn":["9788787335737"],"pages":"38-43","place":"Risø, Roskilde, Denmark","publisher":"DTU Wind and Energy Systems","status":"p","title":"DTU International Energy Report 2024: Providing Advice for the Energy Transition"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-f4695728-db5a-46c7-9189-6d97ab72f9eb"],"src":["DTU Technical University of Denmark"],"title":"Auctions for the future","type":"Report Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-747173","year":"2024","yearsub":"2024"}
{"abstract":"INTRODUCTION: Post-bariatric hypoglycaemia (PBH) is a rare yet disabling clinical condition, mostly reported after Roux-en-Y gastric bypass (RYGB) surgery. RYGB is one of the most widely used and effective bariatric procedures. The pathophysiology of PBH remains unclear, and treatment options are limited in effectiveness and/or carry significant side effects. Acarbose slows carbohydrates digestion and absorption and is generally considered first-line pharmacological treatment for PBH but its gastrointestinal side effects limit patient compliance. Canagliflozin inhibits intestinal and renal sodium-dependent glucose absorption and reduces postprandial excursions of glucose, insulin and incretins after RYGB - effects that could be beneficial in ameliorating PBH. AIMS: The trial aims to investigate how blood glucose levels are affected during daily living in subjects with PBH during treatment with canagliflozin or acarbose compared with placebo, and to study the meal-induced entero-endocrine mechanisms implied in the treatment responses. METHODS: In a double-blinded, randomized, crossover clinical trial, HypoBar I will investigate the effectiveness in reducing the risk of PBH, safety, ambulatory glucose profile and entero-endocrine responses when PBH is treated with canagliflozin 300 mg twice daily during a 4-week intervention period, compared with acarbose 50 mg thrice daily or placebo. ETHICS AND DISSEMINATION: HypoBar I is approved by the Local regulatory entities. Results will be published in peer-reviewed journals. CONCLUSION: If effective, well-tolerated and safe, canagliflozin could be a novel treatment for people with PBH. HypoBar I might also unravel new mechanisms underlying PBH, potentially identifying new treatment targets. TRIAL REGISTRATION: EudraCT number 2022-000157-87.","author_count":9,"contributors":["Lobato, Carolina B","Winding, Clara Tornoe","Bojsen-Møller, Kirstine Nyvold","Martinussen, Christoffer","Veedfald, Simon","Holst, Jens Juul","Madsbad, Sten","Jørgensen, Nils Bruun","Dirksen, Carsten"],"cuid":["S01-000.00-749196"],"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"canagliflozin or acarbose versus placebo to ameliorate post bariatric hypoglycaemia the hypobar i randomized clinical trial protocol","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1111/dme.15320","version":"Published Version"},"id":"S01-000.00-749196","identifier":[{"id":"85189615463","type":"scopus"},{"id":"38551152","type":"pmid"}],"ids":["ku-d17368bb-6673-4f52-8f44-b4c8106721b2"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-A0F3DAA6EDB58A554D007FDF3C6AFDA9"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1111/dme.15320","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://curis.ku.dk/ws/files/392452792/Diabetic_Medicine_2024_Lobato_Canagliflozin_or_acarbose_versus_placebo_to_ameliorate_post_bariatric_hypoglycaemia_.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Amager and Hvidovre"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1 2","first":"Carolina B","key":"lobatopau","last":"Lobato","name":"Lobato, Carolina B","rank":1,"rolecode":"pau"},{"affno":"1 2","first":"Clara Tornoe","key":"windingpau","last":"Winding","name":"Winding, Clara Tornoe","rank":2,"rolecode":"pau"},{"affno":"1 2","first":"Kirstine N","key":"bojsenmøllerpau","last":"Bojsen-Møller","locid":"a1de842f-aeb0-4687-bcc1-a5478f6f6bf0","name":"Bojsen-Møller, Kirstine Nyvold","name_org":"Bojsen-Møller, Kirstine N","rank":3,"rolecode":"pau"},{"affno":"1","first":"Christoffer","key":"martinussenpau","last":"Martinussen","name":"Martinussen, Christoffer","rank":4,"rolecode":"pau"},{"affno":"2","first":"Simon","key":"veedfaldpau","last":"Veedfald","locid":"b6633087-c392-4c8b-814e-abeeb5865b71","name":"Veedfald, Simon","rank":5,"rolecode":"pau"},{"affno":"2","first":"Jens J","key":"holstpau","last":"Holst","locid":"864b6401-9024-4773-9bdb-f4d4ca57dcad","name":"Holst, Jens Juul","name_org":"Holst, Jens J","orcid":"0000-0001-6853-3805","rank":6,"rolecode":"pau"},{"affno":"1","first":"Sten","key":"madsbadpau","last":"Madsbad","name":"Madsbad, Sten","rank":7,"rolecode":"pau"},{"affno":"1","first":"Nils Bruun","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, Nils Bruun","rank":8,"rolecode":"pau"},{"affno":"1 2","first":"Carsten","key":"dirksenpau","last":"Dirksen","locid":"2504d7c9-ee3f-4990-9c1b-10be728b298c","name":"Dirksen, Carsten","rank":9,"rolecode":"pau"}],"pmid":["38551152"],"pub":{"doi":"10.1111/dme.15320","issn":["07423071","14645491"],"issn_org":["07423071"],"issue":"6","journal":"Diabetic Medicine","paperid":"e15320","status":"p","title":"Diabetic Medicine","volume":"41"},"review":"Peer Reviewed","scoID":["2-s2.0-85189615463"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark