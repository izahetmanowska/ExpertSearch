le":"Other","rolecode":"oth"},{"affno":"5","corresponding":null,"first":"Mette","key":"mølvadgaardmetteoth","last":"Mølvadgaard","locid":"b745e58c-194a-40dd-98cf-f5c689fb900f","name":"Mølvadgaard, Mette","rank":55,"role":"Other","rolecode":"oth"}],"pmid":["34903718"],"pub":{"doi":"10.1038/s41467-021-27202-x","issn":["20411723"],"issue":"1","journal":"Nature Communications","paperid":"7251","publisher":"Nature Research","status":"p","title":"Nature Communications","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-85122774462"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Governmental Institutions","All Miscellaneous","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Governmental Institutions","Miscellaneous","Other Research","Technical University of Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-b7136dad-880b-4abe-a5bf-0b43cb824e11","dtu-b5be2aa7-5d47-4bb0-a882-b767365c8b1b","ku-a7e11899-065a-4578-8b1d-d3e4c487a37b","sdu-479104bc-ec55-4c2b-9976-8b9a0573c227"],"src":["AAU Aalborg University","DTU Technical University of Denmark","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Increased transmissibility of SARS-CoV-2 lineage B.1.1.7 by age and viral load","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-089.27-008834","year":"2021","yearsub":"2021"}
{"abstract":"Background: There are emerging data of long-term effects of coronavirus disease 2019 (COVID-19) comprising a diversity of symptoms. The aim of this study was to systematically describe and measure pulmonary and extra-pulmonary post-COVID-19 complications in relation to acute COVID-19 severity. Methods: Patients attending a standard of care 3 months post-hospitalisation follow-up visit and those referred by their general practitioner because of persistent post-COVID-19 symptoms were included. Patients underwent symptomatic, quality of life, pulmonary (lung function and high-resolution computed tomography (HRCT)), cardiac (high-resolution ECG), physical (1-min sit and stand test (1-MSTST), handgrip strength, cardiopulmonary exercise testing (CPET)) and cognitive evaluations. Results: All 34 hospitalised and 22 out of 23 non-hospitalised patients had ≥1 complaint or abnormal finding at follow-up. Overall, 67% of patients were symptomatic (Medical Research Council (MRC) ≥2 or COPD assessment test (CAT) ≥10), with no difference between hospitalised versus non-hospitalised patients. Pulmonary function (forced expiratory volume in 1 s (FEV1) or diffusing capacity of the lung for carbon monoxide (D LCO)) <80% of predicted) was impaired in 68% of patients. D LCO was significantly lower in those hospitalised compared to non-hospitalised (70.1±18.0 versus 80.2±11.2% predicted, p=0.02). Overall, 53% had an abnormal HRCT (predominantly ground-glass opacities) with higher composite computed tomography (CT) scores in hospitalised versus non-hospitalised patients (2.3 (0.1-4.8) and 0.0 (0.0-0.3), p<0.001). 1-MSTST was below the 25th percentile in almost half of patients, but no signs of cardiac dysfunction were found. Cognitive impairments were present in 59-66% of hospitalised and 31-44% of non-hospitalised patients (p=0.08). Conclusion: Three months after COVID-19 infection, patients were still symptomatic and demonstrated objective respiratory, functional, radiological and cognitive abnormalities, which were more prominent in hospitalised patients. Our study underlines the importance of multidimensional management strategies in these patients.","author_count":16,"contributors":["Johnsen, Stine","Sattler, Stefan Michael","Miskowiak, Kamilla Woznica","Kunalan, Keerthana","Victor, Alan","Pedersen, Lars","Andreassen, Helle Frost","Jørgensen, Barbara Jolanta","Heebøll, Hanne","Andersen, Michael Brun","Marner, Lisbeth","Hædersdal, Carsten","Hansen, Henrik","Ditlev, Sisse Bolm","Porsbjerg, Celeste","Lapperre, Therese Sophie"],"cuid":["S01-000.00-466532"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"descriptive analysis of long covid sequelae identified in a multidisciplinary clinic serving hospitalised and non hospitalised patients","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1183/23120541.00205-2021","version":"Published Version"},"id":"S01-000.00-466532","identifier":[{"id":"34345629","type":"pmid"},{"id":"PMC8091683","type":"pmcid"},{"id":"85109429394","type":"scopus"}],"ids":["ku-7a1a5141-d2f3-4cad-a78e-874e7167b015"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-1AB78A89EB72AAACE2CEA2676E25D5A5"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://curis.ku.dk/ws/files/281110765/23120541.00205_2021.full.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1183/23120541.00205-2021","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal medicine: infection medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Bispebjerg and Frederiksberg"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","first":"Stine","key":"johnsenpau","last":"Johnsen","locid":"c80da540-a828-41d9-b991-d5c260128c1e","name":"Johnsen, Stine","rank":1,"rolecode":"pau"},{"affno":"1","first":"Stefan M","key":"sattlerpau","last":"Sattler","locid":"691059ef-eb44-4e11-a78c-6d2a29c9919e","name":"Sattler, Stefan Michael","name_org":"Sattler, Stefan M","orcid":"0000-0003-3558-8329","rank":2,"rolecode":"pau"},{"affno":"1","first":"Kamilla Woznica","key":"miskowiakpau","last":"Miskowiak","locid":"dda4b898-6856-41f8-8add-6c5b26319e3f","name":"Miskowiak, Kamilla Woznica","orcid":"0000-0003-2572-1384","rank":3,"rolecode":"pau"},{"affno":"2","first":"Keerthana","key":"kunalanpau","last":"Kunalan","name":"Kunalan, Keerthana","rank":4,"rolecode":"pau"},{"affno":"2","first":"Alan","key":"victorpau","last":"Victor","name":"Victor, Alan","rank":5,"rolecode":"pau"},{"affno":"1","first":"Lars","key":"pedersenpau","last":"Pedersen","locid":"740787e7-2a6d-4941-b26a-c138805b8923","name":"Pedersen, Lars","rank":6,"rolecode":"pau"},{"affno"