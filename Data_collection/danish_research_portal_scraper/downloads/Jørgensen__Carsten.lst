{"author_count":7,"contributors":["Andersen, Diane","Jørgensen, Carsten René","Jordet, Henning","Bøye, Rikke","Døssing Blaabjerg, Helene","Freund, Charlotte","Kjølbye, Morten"],"cuid":["S01-000.00-267874"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"pop","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"und","rtype":["clu"],"sorti":"viden om og behandling af borderline","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://www.dp.dk/Psykolognyt/Artikelarkiv.aspx","version":"Other Version"},"id":"S01-000.00-267874","ids":["au-f2db0811-2100-4f14-9079-f10c05a74f19"],"lang":"Danish","level":"Popular","mra":["Medical Science"],"noi":["Local-1-1-9B74CCC608E43ABBD879D14B6CE3D2F6"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.dp.dk/Psykolognyt/Artikelarkiv.aspx","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus University, Faculty of Health Sciences, The Department of General Psychiatry"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Diane","key":"andersenpau","last":"Andersen","locid":"e4683136-5943-4baa-9526-090509206c37","name":"Andersen, Diane","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Carsten René","key":"jørgensenpau","last":"Jørgensen","locid":"3763a4db-6ce1-4e54-ac67-524a9604e1ce","name":"Jørgensen, Carsten René","orcid":"0000-0002-7324-1628","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Henning","key":"jordetpau","last":"Jordet","locid":"4c5b8fcf-f449-4259-b436-1ad295559195","name":"Jordet, Henning","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rikke","key":"bøyepau","last":"Bøye","locid":"c816211a-6dc5-4594-ba92-a5d3aa050cde","name":"Bøye, Rikke","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Helene","key":"døssingblaabjergpau","last":"Døssing Blaabjerg","name":"Døssing Blaabjerg, Helene","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Charlotte","key":"freundpau","last":"Freund","locid":"a37705f0-054b-4170-b240-eeaa5ae55034","name":"Freund, Charlotte","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Morten","key":"kjølbyepau","last":"Kjølbye","locid":"ee83f57f-449f-409a-a16a-47ea46248ec6","name":"Kjølbye, Morten","rank":7,"rolecode":"pau"}],"pub":{"issn":["09017089"],"issue":"12","journal":"Psykolog Nyt","pages":"8-12","status":"p","title":"Psykolog Nyt","volume":"65"},"review":"Undetermined","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-f2db0811-2100-4f14-9079-f10c05a74f19"],"src":["AU Aarhus University"],"title":"Viden om og behandling af borderline","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-267874","year":"2011","yearsub":"2011"}
{"abstract":"In this paper, we use nonlinear model predictive control (NMPC) to maximize secondary oil recovery from an oil reservoir by controlling two-phase subsurface porous flow using adjustable down-hole control valves. The resulting optimal control problem is nonlinear and large-scale. We solve this problem numerically using a single shooting sequential quadratic programming (SQP) based optimization method. Explicit singly diagonally implicit Runge-Kutta (ESDIRK) methods are used for integration of the stiff system of differential equations describing the two-phase flow, and the adjoint method is used for sensitivity computations. We report computational experiences and oil recovery improvements for a standard test case.","author_count":4,"contributors":["Völcker, Carsten","Jørgensen, John Bagterp","Thomsen, Per Grove","Stenby, Erling Halfdan"],"cuid":["S01-000.00-311122"],"event":{"end":"2011-06-01","place":"Chalkidiki, gr","start":"2011-05-29","title":"21st European Symposium on Computer Aided Process Engineering","year":"2011"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"nmpc for oil reservoir production optimization","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/79958792573","version":"Other Version"},"id":"S01-000.00-311122","identifier":[{"id":"79958792573","type":"scopus"}],"ids":["dtu-15b884b1-0c4a-4c2e-8b94-d69810563cd0"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-5A8A3FACD20AA92FCFC950A749059941"],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Informatics and Mathematical Modeling","Technical University of Denmark, Department of Informatics and Mathematical Modeling, Scientific Computing"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Carsten","key":"völckerpau","last":"Völcker","locid":"c3f83288-e76c-48d8-bb93-cedc1ae0d972","name":"Völcker, Carsten","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"John Bagterp","key":"jørgensenpau","last":"Jørgensen","locid":"d2bc6de4-a5c6-43f7-8712-606bd02a88e9","name":"Jørgensen, John Bagterp","orcid":"0000-0001-9799-2808","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Per Grove","key":"thomsenpau","last":"Thomsen","locid":"86ccc604-cc59-4554-9525-868f11c75311","name":"Thomsen, Per Grove","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Erling Halfdan","key":"stenbypau","last":"Stenby","locid":"08d1917e-6211-4ea5-8ac3-7959d122b86a","name":"Stenby, Erling Halfdan","orcid":"0000-0002-2296-069X","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1016/b978-0-444-54298-4.50148-3|","isbn":["9780444538956"],"issn":["15707946"],"issue":"29","pages":"1849-1853","publisher":"Elsevier","series":"Computer Aided Chemical Engineering","status":"p","title":"21st European Symposium on Computer Aided Process Engineering"},"review":"Peer Reviewed","scoID":["2-s2.0-79958792573"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-15b884b1-0c4a-4c2e-8b94-d69810563cd0"],"src":["DTU Technical University of Denmark"],"title":"NMPC for Oil Reservoir Production Optimization","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-311122","year":"2011","yearsub":"2011"}
{"abstract":"Information technology (IT) is a means to an end, yet many IT projects assign primacy to technical development and attend comparatively less to the organizational change effort that is required to attain a good fit between organization and IT system. This entails a risk of not capturing the benefits of the deployed system. Effects-driven IT development aims to counter this risk by providing an instrument for managing IT projects through a sustained focus on the effects desired from the use of the IT system. A sustained focus on effects entails that the specification, realization, and assessment of effects become central systems-development activities. In this chapter, we describe the six empirical projects we have conducted in our work on effects-driven IT development during the period 2004–2011 and we discuss the experiences gained so far. The empirical projects indicate that the desired effects can be specified and measured, though we have mixed experiences with ensuring that effects are measured. An effects hierarchy has been devised and appears suitable for working with effects at different levels of abstraction. A key challenge with which we still have insufficient experience concerns how a partnership with close relations between a customer and a vendor can be established. Finally, we have yet to address whether and how to incorporate an effects-driven approach in the contractual regulation of IT projects.","author_count":4,"contributors":["Hertzum, Morten","Simonsen, Jesper"],"cuid":["S01-000.00-564158"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Effects driven IT development","Evaluation","Partnership sourcing","Pilot implementation"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-RUC"]},"level3all":["DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"effects driven it development status 000000002004 000000002011","src":["ruc"],"src-code":["DI-U-RUC"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/64143055/Hertzum_Simonsen_2011.pdf","version":"Authors Final Version"},"id":"S01-000.00-564158","ids":["ruc-7a15dbd8-e4ca-429f-8f9d-f66fa564eacb"],"keyword":["Effects-driven IT development","Evaluation","Partnership sourcing","Pilot implementation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-C61BA80010097C5109BEBB701A845C36"],"oa_link":[{"access":"oa","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/64143055/Hertzum_Simonsen_2011.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of People and Technology, User-Driven IT Innovation","Roskilde University, The Department of Communication, Business and Information Technologies"],"nora_code":"DI-U-RUC","used":1}],"person":[{"affno":"1","country":"dk","first":"Morten","key":"hertzumpau","last":"Hertzum","locid":"cd5a2f82-1658-4e03-8e6b-63bc1215e394","name":"Hertzum, Morten","orcid":"0000-0003-0019-8531","rank":1,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Jesper","key":"simonsenpau","last":"Simonsen","locid":"580c081f-6732-4194-8a2e-b2b519e1c41d","name":"Simonsen, Jesper","orcid":"0000-0002-1864-7158","rank":2,"rolecode":"pau"},{"affno":"","first":"Morten","key":"hertzumpedh","last":"Hertzum","name":"Hertzum, Morten","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Carsten","key":"jørgensenpedh","last":"Jørgensen","name":"Jørgensen, Carsten","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9788251927581"],"pages":"165-192","place":"Trond