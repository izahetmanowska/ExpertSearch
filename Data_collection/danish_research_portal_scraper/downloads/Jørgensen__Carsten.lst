adsbad, Sten","rank":8,"rolecode":"pau"},{"affno":"2","first":"Jens Juul","key":"holstpau","last":"Holst","locid":"864b6401-9024-4773-9bdb-f4d4ca57dcad","name":"Holst, Jens Juul","orcid":"0000-0001-6853-3805","rank":9,"rolecode":"pau"},{"affno":"2","first":"Dorte L","key":"hansenpau","last":"Hansen","locid":"f3e33a09-3b30-42fe-95a9-6b6c309d3b79","name":"Hansen, Dorte Lindqvist","name_org":"Hansen, Dorte L","rank":10,"rolecode":"pau"}],"pmid":["24306154"],"pub":{"doi":"10.1016/j.orcp.2012.01.002","issn":["1871403X","18780318"],"issn_org":["1871403X"],"issue":"4","journal":"Obesity Research & Clinical Practice","status":"p","title":"Obesity Research & Clinical Practice","volume":"7"},"review":"Peer Reviewed","scoID":["2-s2.0-84880285289"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Novo Nordisk","Private Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-135919bb-1bb5-48e5-8418-24f6c1cea541"],"src":["KU University of Copenhagen"],"title":"Reduction in cardiovascular risk factors and insulin dose, but no beta-cell regeneration 1 year after Roux-en-Y gastric bypass in an obese patient with type 1 diabetes : a case report","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-404964","year":"2013","yearsub":"2013"}
