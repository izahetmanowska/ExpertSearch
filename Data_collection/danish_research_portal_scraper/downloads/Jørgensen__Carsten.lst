id":"5085f29a-f6d4-4c5a-995b-cdc9f953d608","name":"Jørgensen, Anders Stuhr","rank":3,"rolecode":"pau"}],"pub":{"issn":["19037384"],"issue":"8","journal":"Trafik & Veje","pages":"18-21","publisher":"Dansk Vejtidsskrift ApS","status":"p","title":"Trafik & Veje","title_org":"Trafik og Veje"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-4cc0da2e-9dce-44aa-be7f-a53978d422b8"],"src":["DTU Technical University of Denmark"],"title":"Truende mangel på trafikplanlæggere og vejingeniører","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-327417","year":"2011","yearsub":"2011"}
{"abstract":"Kunstnernes arbejdsmarked er generelt præget af usikre ansættelser målt i forhold til den sikkerhed, en fast fuldtidsstilling giver. De har mange kontrakter hen over året, og det gør dem mere udsat på arbejdsmarkedet, fordi den danske model i bund og grund kun yder sikkerhed for ansatte i faste stillinger. Er kunstnerne på den anden side så etablerede, at de kan være ligeglade og bare leve fra hånden i munden og samtidig lægge lidt til side til pensionen? Svaret er, at det er der kun meget få som kan. Mange kunstnere, skabende som udøvende, har job ved siden af eller perioder med supplerende understøttelse. Det gør dem udsat på det danske arbejdsmarked, fordi de ikke bliver omfattet af de regler, som overenskomstdækningen giver. Heller ikke i forhold til lovgivningen nyder de speciel dækning, hvilket skyldes, at de kan opfattes som både selvstændige og lønmodtagere. Freelancere er ikke en type beskæftigede i lovens forstand. Kun på nogle få parametre er kunstnerne insidere. De er højtuddannede, og de har selv valgt deres i vores terminologi ’usikre ansættelse’ ud fra et ønske om anderledes karriereveje og ønsket om at slå igennem. Kapitlet er inddelt i tre dele: I første del diskuteres nogle bidrag fra litteraturen, som fokuserer på kunstnernes særlige status på arbejdsmarkedet. Derudover diskuteres relevansen af at undersøge kunstnernes status på baggrund af insider/outsider-debatten. I anden del gennemgås empiriske data vedrørende kunstnernes beskæftigelse med særligt fokus på to punkter: For det første en sammenligning mellem beskæftigelsen i den kulturelle sektor i henholdsvis Danmark og EU ud fra statistiske data i forhold til ansættelsesformer og uddannelse. Resultaterne diskuteres på baggrund af insider/outsider-debatten. For det andet kortlægges den interne differentiering på kunstnernes arbejdsmarked i Danmark set i forhold til ansættelsesformer. I tredje del foretages en nærmere kvalitativ analyse af kunstnernes situation i Danmark ud fra de fire kriterier for, hvornår en lønmodtager kan betragtes som henholdsvis en insider eller en outsider i henhold til den danske model.","author_count":3,"contributors":["Jørgensen, Carsten","Ventura Campos Lima, Maria da Paz"],"cuid":["S01-000.00-439775"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"at være eller ikke være kunstnernes placering på det danske arbejdsmarked","src":["ku"],"src-code":["DI-U-KU"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-439775","ids":["ku-4db760bc-63da-4650-9bb2-95663a08ce18"],"lang":"Danish","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-1B9523FEB9FAEA68D104D8E6986EE17F"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Social Sciences, Department of Sociology, Employment Relations Research Centre"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Carsten","key":"jørgensenpau","last":"Jørgensen","locid":"5fce652c-37b0-47e7-a6a7-cbfda8fb6a7a","name":"Jørgensen, Carsten","rank":1,"rolecode":"pau"},{"affno":"1","first":"Maria da Paz","key":"venturacamposlimapau","last":"Ventura Campos Lima","locid":"5c624411-dd7a-47d7-90fe-840ee3e85ce0","name":"Ventura Campos Lima, Maria da Paz","rank":2,"rolecode":"pau"},{"affno":"","first":"Trine P.","key":"larsenpedh","last":"Larsen","name":"Larsen, Trine P.","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"edition":"1.","isbn":["9788757421293"],"pages":"199-219","place":"Kbh.","publisher":"Djøf Forlag","status":"p","subtitle":"Den danske models rækkevidde","title":"Insidere og outsidere - den danske models rækkevidde"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-4db760bc-63da-4650-9bb2-95663a08ce18"],"src":["KU University of Copenhagen"],"title":"At være eller ikke være : Kunstnernes placering på det danske arbejdsmarked","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-439775","year":"2011","yearsub":"2011"}
