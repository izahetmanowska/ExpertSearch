d":["39093386"],"pub":{"doi":"10.1007/s40123-024-01008-8","issn":["21936528","21938245"],"issn_org":["21938245"],"issue":"9","journal":"Ophthalmology and Therapy","pages":"2467-2480","publisher":"Springer","status":"p","title":"Ophthalmology and Therapy","title_org":"Ophthalmology and therapy","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-85200380648"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Private Research","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","North Denmark Region","Other Companies","Other Hospitals","Other Research","Private Research","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark","mitøje aps/danske speciallaeger aps","mitøje v/ danske speciallæger"],"PST":["Published"]},"sid":["aau-c6ee8b4b-599f-47e4-a13e-ee22c7c9d9ea","ku-219bee5a-f9f3-4954-93df-21d279051855","sdu-da966b73-d11b-4d26-bd7e-28c42b4a85bd"],"src":["AAU Aalborg University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"The Impact of the COVID-19 Pandemic on Tele-ophthalmology-Based Retinal Screening","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-100.00-761637","year":"2024","yearsub":"2024"}
{"abstract":"OBJECTIVES: In a nationwide, matched cohort study, we aimed to investigate risks of haematologic cancers among individuals tested for Borrelia burgdorferi (Bb) antibodies, and among serum Bb seropositive individuals. METHODS: We identified all Bb seropositive individuals in Denmark (1993-2020) (n = 52 200) and constructed two age- and sex-matched comparison cohorts: (a) Bb seronegative controls (n = 104 400) and (b) background population controls (n = 261 000). We calculated short-term OR (aOR) (<1 month of study inclusion), and long-term hazard ratios (aHR) (>1 month after study inclusion) adjusted for age and sex. We stratified seropositive individuals on only Bb-IgM seropositive (n = 26 103), only Bb-IgG seropositive (n = 18 698), and Bb-IgM-and-IgG seropositive (n = 7399). RESULTS: Compared with the background population, individuals tested for Bb antibodies had increased short-term (aOR: 12.6, 95% CI: 10.1-15.6) and long-term (aHR: 1.3, 95% CI: 1.2-1.4) risk of haematologic cancers. The Bb seropositive individuals had no increased risk of haematologic cancers compared with those who tested negative for Bb, except that Bb-IgM-and-IgG seropositive individuals had increased long-term risk of chronic lymphatic leukaemia (aHR: 2.0, 95% CI: 1.2-3.4). DISCUSSION: Our results suggest that Bb antibody testing is included in the work-up of unspecific symptoms preceding diagnosis of haematologic cancers. Bb-IgM-and-IgG seropositivity was associated with a two-fold increased long-term risk of chronic lymphatic leukaemia, which warrants further investigation.","author_count":16,"contributors":["Tetens, Malte M.","Omland, Lars Haukali","Dessau, Ram","Ellermann-Eriksen, Svend","Andersen, Nanna S.","Jørgensen, Charlotte Sværke","Østergaard, Christian","Bodilsen, Jacob","Søgaard, Kirstine K.","Bangsborg, Jette","Nielsen, Alex Christian","Møller, Jens Kjølseth","Chen, Ming","Niemann, Carsten Utoft","Lebech, Anne-Mette","Obel, Niels"],"cuid":["S04-100.00-724187"],"filters":{"added":"2023-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"corresponding_author":["Tetens, Malte M."],"keyword":["Antibodies Bacterial","Borrelia burgdorferi","Borrelia burgdorferi Group","Borrelia burgdorferi sensu lato","Borreliosis","Cohort Studies","Cohort study","Haematologic cancer","Hematologic Neoplasms epidemiology","Humans","Immunoglobulin G","Immunoglobulin M","Leukaemia","Leukemia Lymphocytic Chronic B Cell","Lyme Disease diagnosis","Lyme disease","Serology"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"risk of haematologic cancers among individuals tested for i borrelia burgdorferi i antibodies and i borrelia burgdorferi i seropositive individuals a nationwide population based matched cohort study","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.cmi.2023.10.017","version":"Published Version"},"funding_acknowledgement":["The study was funded by the Independent Research Fund Denmark. MMT was supported by a research grant from the Research Fund of Copenhagen University Hospital – Rigshospitalet . CUN was funded by a research grant from the Alfred Benzon Foundation . AML was supported by a research grant from the Lundbeck Foundation . The Independent Research Fund Denmark, the Research Fund of Copenhagen University Hospital – Rigshospitalet , the Alfred Benzon Foundation , and the Lundbeck Foundation had no role in the design and conduct of the study; collection, management, analyses, and interpretation of the data; preparation, review, or approval of the manuscript; and decision to submit the manuscript for publication."],"id":"S04-100.00-724187","identifier":[{"id":"85176099586","type":"scopus"},{"id":"37871679","type":"pmid"}],"ids":["aau-6b63c055-68bf-411e-ba37-d7617eb6e95a","au-c624a1be-f6e3-4fc6-91c6-75c128fa78be","ku-abe11d44-218a-445b-9306-94b466956ed3","sdu-b59a4d62-81c7-4791-b962-de2243254fc5"],"keyword":["Antibodies, Bacterial","Borrelia burgdorferi","Borrelia burgdorferi Group","Borrelia burgdorferi sensu lato","Borreliosis","Cohort Studies","Cohort study","Haematologic cancer","Hematologic Neoplasms/epidemiology","Humans","Immunoglobulin G","Immunoglobulin M","Leukaemia","Leukemia, Lymphocytic, Chronic, B-Cell","Lyme Disease/diagnosis","Lyme disease","Serology"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-7-EF56DE289908C8169331C16034464335"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.cmi.2023.10.017","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/257034235/Open_Access_Version.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/381722948/1_s2.0_S1198743X2300527X_main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/649389834/Tetens_et_al._2024_._Risk_of_haematologic_cancers_among_individuals_tested_for_Borrelia_burgdorferi_antibodies_and_Borrelia_burgdorferi_seropositive_individuals_-_a_nationwide_population-based_matched_cohort_study.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nord