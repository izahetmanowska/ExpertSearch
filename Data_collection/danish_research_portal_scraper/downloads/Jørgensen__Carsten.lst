{"abstract":"Post-tonsillectomy pain can be severe. We investigated the analgesic effect from combinations of paracetamol, pregabalin and dexamethasone in adults undergoing tonsillectomy.","author_count":8,"contributors":["Mathiesen, O","Jørgensen, D G","Hilsted, K L","Trolle, Waldemar","Stjernholm, P","Christiansen, H","Hjortsø, Carsten Nico Portefée","Dahl, Jørgen Berg"],"cuid":["S01-000.00-517811"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"pregabalin and dexamethasone improves post operative pain treatment after tonsillectomy","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1111/j.1399-6576.2010.02389.x","version":"Other Version"},"id":"S01-000.00-517811","identifier":[{"id":"79751513870","type":"scopus"}],"ids":["ku-d02d5e11-aee8-4754-9dc1-d349b98b3805"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-5A4097A4F9A74AB6D117A67CF8CFE158"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1111/j.1399-6576.2010.02389.x","version":"Other Version"}],"org":[{"affno":1,"key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Section of Neurology, Psychiatry and Sensory Sciences"],"nora_code":"DI-U-KU"}],"person":[{"affno":"","first":"O","key":"mathiesenpau","last":"Mathiesen","name":"Mathiesen, O","rank":1,"rolecode":"pau"},{"affno":"","first":"D G","key":"jørgensenpau","l