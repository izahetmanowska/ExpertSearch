Jakobsen, Malene","orcid":"0000-0003-2344-2808","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"John Erik","key":"hermansenpau","last":"Hermansen","locid":"2bf577ac-b06f-42f8-8937-b365c171c066","name":"Hermansen, John Erik","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Heidi Mai-Lis","key":"andersenpau","last":"Andersen","locid":"f85c5e76-d4ea-4295-ae73-e62b79ac32c8","name":"Andersen, Heidi Mai-Lis","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Carsten","key":"markussenpau","last":"Markussen","name":"Markussen, Carsten","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Sybille","key":"kyedpau","last":"Kyed","name":"Kyed, Sybille","rank":7,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Simme","key":"eriksenpau","last":"Eriksen","name":"Eriksen, Simme","rank":8,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Tove","key":"seruppau","last":"Serup","name":"Serup, Tove","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Uffe","key":"jørgensenpau","last":"Jørgensen","locid":"efa7e924-c197-4060-8904-110cf0a30837","name":"Jørgensen, Uffe","rank":10,"rolecode":"pau"}],"pub":{"isbn":["9788793643901"],"issn":["22451684"],"issue":"132","pages":"36","repno":"DCA rapport, No. 132","series":"DCA rapport","status":"p","volume":"132"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Private Research","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Private Research","Universities"],"PST":["Published"]},"sid":["au-cd50e4b6-c50b-4a12-9df8-b6bb6b3b14d8"],"src":["AU Aarhus University"],"title":"Træer i svinefolde","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-246686","year":"2018","yearsub":"2018"}
{"abstract":"AIM: To test the psychometric validity of the Good Perioperative Nursing Care Scale (GPNCS), a self-administered questionnaire, following translation and adaptation. INTRODUCTION: Patients' satisfaction with and experience of nursing care in orthopaedic or perioperative settings are currently not routinely measured and few standardized patient-reported experience measurement tools exist for these settings. MATERIALS AND METHODS: Cross-sectional survey. The 34-question, seven-factor questionnaire was translated, adapted, and face-validated; the translated version was then validated with a group of surgical patients in perioperative settings. The internal consistency of the translated version was validated and tested using confirmatory factor analysis combined with Cronbach's alpha. RESULTS: In the orthopaedic department of a regional public hospital, 361 acute, traumatic and elective surgical patients were screened for eligibility; 215 were included. The full-scale model fit estimates were moderate. Factor loadings typically ranged from 0.65 to 0.97, except for the questions concerning Technical Skills (0.38-0.63) and Nursing Process (0.28). The Cronbach's alpha value for the total scale score was 0.92, with subfactors ranging from 0.72 to 0.87. CONCLUSION: Providing evidence for quality, or lack thereof, the Danish version of the GPNCS is a valid tool for measuring surgical patients' experiences with perioperative nursing care. The electronic version proved practical. RELEVANCE TO CLINICAL PRACTICE: The validated Danish version of the tool will help healthcare professionals to identify areas of nursing care that need improvement, facilitate international benchmarking of units and enable comparison of care quality, nationally and internationally.","author_count":3,"contributors":["Hertel-Joergensen, Michala","Abrahamsen, Charlotte","Jensen, Carsten"],"cuid":["S01-000.00-637881"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-SDR","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"translation adaptation and psychometric validation of the good perioperative nursing care scale gpncs with surgical patients in perioperative care","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.ijotn.2018.03.001","version":"Published Version"},"id":"S01-000.00-637881","identifier":[{"id":"85044607904","type":"scopus"},{"id":"29588223","type":"pmid"}],"ids":["sdu-e1c1f419-3d9b-4b7e-8201-4a687f4a25af"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-3D66523803CD6A744EDD3E0261CE6925"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.ijotn.2018.03.001","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/141912523/Translation_adaptation_and_psychometric_validation_of_the_Good_Perioperative_Nursing_Care_Scale.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Kolding Sygehus"],"nora_code":"DI-HO-SDR","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Public Health","SDU, The Faculty of Health Sciences, Department of Public Health, User Perspectives and Community-based Interventions","SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Lillebælt Hospital","SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Lillebælt Hospital, Research Unit of Orthopaedics (Kolding)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Michala","key":"herteljoergensenpau","last":"Hertel-Joergensen","name":"Hertel-Joergensen, Michala","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Charlotte","key":"abrahamsenpau","last":"Abrahamsen","locid":"22215dd3-464e-4e62-b19f-71a71e0e1e65","name":"Abrahamsen, Charlotte","orcid":"0000-0002-3700-289X","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Carsten","key":"jensenpau","last":"Jensen","locid":"8561dcdc-4528-4cdd-9c95-b54116e10520","name":"Jensen, Carsten","orcid":"0000-0002-8074-1583","rank":3,"rolecode":"pau"}],"pmid":["29588223"],"pub":{"doi":"10.1016/j.ijotn.2018.03.001","issn":["18781241","18781292"],"issn_org":["18781241"],"journal":"International Journal of Orthopaedic and Trauma Nursing","pages":"41-48","publisher":"Elsevier","status":"p","title":"International Journal of Orthopaedic and Trauma Nursing","volume":"29"},"review":"Peer Reviewed","scoID":["2-s2.0-85044607904"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-e1c1f419-3d9b-4b7e-8201-4a687f4a25af"],"src":["SDU University of Southern Denmark"],"title":"Translation, adaptation and psychometric validation of the Good Perioperative Nursing Care Scale (GPNCS) with surgical patients in perioperative care","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-637881","year":"2018","yearsub":"2018"}
{"abstract":"Ephemeral Diffie-Hellman over COSE (EDHOC) [1] is an authentication protocol that aims to replace TLS for resource constrained Internet of Things (IoT) devices using a selection of lightweight ciphers and formats. It is inspired by the newest Internet Draft of TLS 1.3 [2] and includes reduced round-trip modes. Unlike TLS 1.3, EDHOC is designed from scratch, and does not have to support legacy versions of the protocol. As the protocol is neither well-known nor has been used in practice it has not been scrutinized to the extent it should be. The objective of this paper is to verify security properties of the protocol, including integrity, secrecy, and perfect forward secrecy properties. We use ProVerif [3] to analyze these properties formally. We describe violations of specific security properties for the reduced round-trip modes. The flaws were reported to the authors of the EDHOC protocol.","author_count":6,"contributors":["Bruni, Alessandro","Jørgensen, Thorvald Sahl","Petersen, Theis Grønbech","Schürmann, Carsten"],"cuid":["S01-000.00-695294"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Authentication Protocol","Lightweight Ciphers","Reduced Round Trip Modes","Resource Constrained IoT","Security Verification"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"formal verification of ephemeral diffie hellman over cose edhoc","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85057821719","version":"Other Version"},"id":"S01-000.00-695294","identifier":[{"id":"85057821719","type":"scopus"}],"ids":["itu-c7b33167-e79f-409e-9e41-6b1a4fc88231"],"keyword":["Authentication Protocol","Lightweight Ciphers","Reduced Round-Trip Modes","Resource Constrained IoT","Security Verification"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-ECAE8613A6616ACBDC99D6F54E5B82C6"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Theoretical Computer Science, Programming Logic and Semantics"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Alessandro","key":"brunipau","last":"Bruni","locid":"5c50bbc9-ed3d-417f-ba4d-e484eaf536b3","name":"Bruni, Alessandro","orcid":"0000-0003-2946-9462","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Thorvald Sahl","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, Thorvald Sahl","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Theis Grønbech","key":"petersenpau","last":"Petersen","name":"Petersen, Theis Grønbech","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Carsten","key":"schürmannpau","last":"Schürmann","locid":"1313519f-2074-41d6-8b79-589648e37211","name":"Schürmann, Carsten","orcid":"0000-0003-4793-0099","rank":4,"rolecode":"pau"},{"affno":"","first":"Cas","key":"cremerspedh","last":"Cremers","name":"Cremers, Cas","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Anja","key":"lehmannpedh","last":"Lehmann","name":"Lehmann, Anja","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-030-04762-7_2","eisbn":["9783030047627"],"isbn":["9783030047610"],"pages":"21-36","place":"Darmstadt, Germany","publisher":"Springer","status":"p","subtitle":"4th International Conference","title":"Security Standardisation Research"},"review":"Peer