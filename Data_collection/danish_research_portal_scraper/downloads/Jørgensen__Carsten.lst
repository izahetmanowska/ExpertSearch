apital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-91257bb2-48c9-48a0-b723-126d20503775"],"src":["KU University of Copenhagen"],"title":"The importance of endogenously secreted GLP-1 and GIP for postprandial glucose tolerance and β-cell function after Roux-en-Y gastric bypass and sleeve gastrectomy surgery","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-480169","year":"2023","yearsub":"2023"}
