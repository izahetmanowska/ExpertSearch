d Biomechanics"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Martin Grønbech","key":"jørgensenpau","last":"Jørgensen","locid":"7e5b396f-5ccc-4ca3-bccc-3157ae9f92b5","name":"Jørgensen, Martin Grønbech","orcid":"0000-0002-3189-644X","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Uffe","key":"læssøepau","last":"Læssøe","name":"Læssøe, Uffe","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Carsten","key":"hendriksenpau","last":"Hendriksen","name":"Hendriksen, Carsten","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Ole BF","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Ole BF","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Per","key":"aagaardpau","last":"Aagaard","locid":"8452f86e-3c45-4ecb-9e11-54c72d45d669","name":"Aagaard, Per","orcid":"0000-0002-9773-7361","rank":5,"rolecode":"pau"}],"pub":{"publisher":"EUGMS","status":"p","title":"Proceedings 9th Congress European Union Geriatric Medicine Society (EUGMS)"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-605e772a-f459-42f7-afef-15989f77521e"],"src":["SDU University of Southern Denmark"],"title":"Intra-rater reproducibility and concurrent validity of Nintendo Wii fit balance testing in older adults","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-600774","year":"2013","yearsub":"2013"}
{"abstract":"I artiklen påpeges det, at de danske bestemmelser om hæftelse for told er i strid med EU-retten. Det har den konsekvens, at virksomheder og borgere risikerer at blive stillet i en dårligere situation, end de efter EU-reglerne har krav på. I praksis vil de EU-retsstridige hæftelsesbestemmelser i den danske toldlovgivning eksempelvis indebære, at en køber, der får transporteret sine varer til Danmark fra et sted uden for EU, vil hæfte for told og import-moms, mens det i nogle situationer efter EU-reglerne vil være den virksomhed, der havde varerne til midlertidig opbevaring, der hæfter. Yderligere risikerer den danske stat, at EU-Kommissionen rejser sag om traktatbrud, hvilket i sig selv er alvorligt.","author_count":1,"contributors":["Jørgensen, Carsten Willemoes"],"cuid":["S01-000.00-166299"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"keyword":["EU ret","Hæftelse","Told"],"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"danske hæftelsesbestemmelser i strid med eu retten","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-166299","ids":["au-40ef8ebf-3c53-4b27-84a9-bc4faa7ac4f0"],"keyword":["EU ret","Hæftelse","Told"],"lang":"Danish","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-5AE424A1A117B2F266DF5C3B0BBE1976"],"oai":{"class":"Blocked","mra":["Social Science (SOC)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus BSS, Department of Law"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Carsten Willemoes","key":"jørgensenpau","last":"Jørgensen","locid":"69969451-0c6e-42f9-bbbc-ee6c03b2464f","name":"Jørgensen, Carsten Willemoes","orcid":"0000-0001-5880-7294","rank":1,"rolecode":"pau"}],"pub":{"issn":["09045139"],"issue":"6","journal":"SR-Skat","pages":"315","publisher":"Karnov Group Denmark AS","publisher_org":"Karnov Group Denmark A/S","status":"p","title":"SR-Skat","volume":"25"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-40ef8ebf-3c53-4b27-84a9-bc4faa7ac4f0"],"src":["AU Aarhus University"],"title":"Danske hæftelsesbestemmelser i strid med EU-retten","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-166299","year":"2013","yearsub":"2013"}
{"abstract":"Background: Recent data from a population-based study in children and adolescents suggests that serum thyroid-stimulating hormone levels (TSH) are associated with arterial blood pressure and hypertension. These results are in agreement with some, but not all population-based studies in adults. Discrepancies in results might be explained by drug intake, different iodine supplies and sizes of populations investigated. In addition, it is not clear, whether an association between TSH and hypertension exists longitudinally rather than only cross-sectionally. Thus, our aim was to investigate cross-sectional and longitudinal associations between thyroid function and arterial blood pressure in a large consortium of cohort studies in adults. Methods: Data from five population-based studies were pooled resulting in 17,023 individuals being available for cross-sectional and 10,048 individuals for longitudinal analyses. Associations of baseline TSH with baseline blood pressure or hypertension were analyzed by multivariable median or logistic regression models. Multivariable median or Poisson regression models were used to investigate associations of baseline TSH with 5-year-change in arterial blood pressure or incident hypertension. Results: There was a cross-sectional positive association of TSH with arterial blood pressure (p","author_count":17,"contributors":["Ittermann, Till","Tiller, Daniel","Meisinger, Christa","Agger, Carsten","Nauck, Matthias","Rettig, Rainer","Hofman, Albert","Franco, Oscar","Jørgensen, Torben","Linneberg, Allan","Witteman, Jacqueline","Greiser, Halina","Werdan, Karl","Döring, Angela","Kluttig, Alexander","Stricker, Bruno","Völzke, Henry"],"cuid":["S01-000.00-482236"],"filters":{"added":"2022-04","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"high serum thyrotropin levels are associated with current but not with incident hypertension","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1089/thy.2012.0626","version":"Other Version"},"id":"S01-000.00-482236","identifier":[{"id":"PMC3752519","type":"pmcid"},{"id":"84883080033","type":"scopus"},{"id":"23427935","type":"pmid"}],"ids":["ku-94a91892-fe5c-46ce-ba05-f1600a44e88d"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-2BEFAFFA4A7DE6F14C54B044FE135DA8"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1089/thy.2012.0626","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Till","key":"ittermannpau","last":"Ittermann","name":"Ittermann, Till","rank":1,"rolecode":"pau"},{"affno":"","first":"Daniel","key":"tillerpau","last":"Tiller","name":"Tiller, Daniel","rank":2,"rolecode":"pau"},{"affno":"","first":"Christa","key":"meisingerpau","last":"Meisinger","name":"Meisinger, Christa","rank":3,"rolecode":"pau"},{"affno":"","first":"Carsten","key":"aggerpau","last":"Agger","name":"Agger, Carsten","rank":4,"rolecode":"pau"},{"affno":"","first":"Matthias","key":"nauckpau","last":"Nauck","name":"Nauck, Matthias","rank":5,"rolecode":"pau"},{"affno":"","first":"Rainer","key":"rettigpau","last":"Rettig","name":"Rettig, Rainer","rank":6,"rolecode":"pau"},{"affno":"","first":"Albert","key":"hofmanpau","last":"