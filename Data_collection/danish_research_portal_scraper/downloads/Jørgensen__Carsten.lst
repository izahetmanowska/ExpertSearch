sper","orcid":"0000-0002-8641-3062","rank":13,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik","key":"ditzelpau","last":"Ditzel","locid":"f10637d7-ca3b-4956-a007-100f66737838","name":"Ditzel, Henrik","orcid":"0000-0003-3927-5135","rank":14,"rolecode":"pau"}],"pmid":["34596511"],"pub":{"issn":["00415782","13994174"],"issn_org":["00415782"],"issue":"6","journal":"Ugeskrift for Læger","paperid":"V04210325","publisher":"Lægeforeningen","status":"p","title":"Ugeskrift for Læger","volume":"184"},"review":"Peer Reviewed","scoID":["2-s2.0-85129890719"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-4f313b27-5841-4631-b9d8-83475f005e2b"],"src":["SDU University of Southern Denmark"],"title":"Udfordringer ved kræftbehandling til ældre","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-595904","year":"2022","yearsub":"2022"}
{"abstract":"Patients with Parkinson's disease (PD) often suffer from non-motor symptoms, which may be caused by serotonergic dysfunction. Apart from alleviating the motor symptoms, Deep Brain Stimulation (DBS) in the subthalamic nucleus (STN) may also influence non-motor symptoms. The aim of this study is to investigate how turning DBS off affects the serotonergic system. We here exploit a novel functional PET neuroimaging methodology to evaluate the preservation of serotonergic neurons and capacity to release serotonin. We measured cerebral 5-HT1BR binding in 13 DBS-STN treated PD patients, at baseline and after turning DBS off. Ten age-matched volunteers served as controls. Clinical measures of motor symptoms were assessed under the two conditions and correlated to the PET measures of the static and dynamic integrity of the serotonergic system. PD patients exhibited a significant loss of frontal and parietal 5-HT1BR, and the loss was significantly correlated to motor symptom severity. We saw a corresponding release of serotonin, but only in brain regions with preserved 5-HT1BR, suggesting the presence of a presynaptic serotonergic deficit. Our study demonstrates that DBS-STN dynamically regulates the serotonin system in PD, and that preservation of serotonergic functions may be predictive of DBS-STN effects.","author_count":11,"contributors":["Jørgensen, Louise Møller","Henriksen, Tove","Mardosiene, Skirmante","Keller, Sune H.","Stenbæk, Dea S","Hansen, Hanne D.","Jespersen, Bo","Thomsen, Carsten","Weikop, Pia","Svarer, Claus","Knudsen, Gitte Moos"],"cuid":["S01-000.00-420839"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"parkinson patients have a presynaptic serotonergic deficit a dynamic deep brain stimulation pet study","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"https://www.ncbi.nlm.nih.gov/pmc/about/copyright/","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC8327106/pdf/10.1177_0271678X20982389.pdf","version":"Published Version"},"id":"S01-000.00-420839","identifier":[{"id":"85099695333","type":"scopus"},{"id":"33461410","type":"pmid"},{"id":"PMC8327106","type":"pmcid"}],"ids":["ku-2df71733-243e-4e00-a9db-b3b92a91c2af"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-5BAB3674C46FC720F98E098C6AD7DCB6"],"oa_link":[{"access":"oa","license":"https://www.ncbi.nlm.nih.gov/pmc/about/copyright/","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC8327106/pdf/10.1177_0271678X20982389.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, No speciality"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Bispebjerg and Frederiksberg"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","first":"Louise M","key":"jørgensenpau","last":"Jørgensen","locid":"8ce07f7e-b4be-4885-a96b-702a7a0d9f6e","name":"Jørgensen, Louise Møller","name_org":"Jørgensen, Louise M","rank":1,"rolecode":"pau"},{"affno":"","first":"Tove","key":"henriksenpau","last":"Henriksen","name":"Henriksen, Tove","rank":2,"rolecode":"pau"},{"affno":"2","first":"Skirmante","key":"mardosienepau","last":"Mardosiene","name":"Mardosiene, Skirmante","rank":3,"rolecode":"pau"},{"affno":"","first":"Sune H.","key":"kellerpau","last":"Keller","name":"Keller, Sune H.","rank":4,"rolecode":"pau"},{"affno":"2","first":"Dea S","key":"stenbækpau","last":"Stenbæk","name":"Stenbæk, Dea S","rank":5,"rolecode":"pau"},{"affno":"","first":"Hanne D.","key":"hansenpau","last":"Hansen","name":"Hansen, Hanne D.","rank":6,"rolecode":"pau"},{"affno":"","first":"Bo","key":"jespersenpau","last":"Jespersen","name":"Jespersen, Bo","rank":7,"rolecode":"pau"},{"affno":"","first":"Carsten","key":"thomsenpau","last":"Thomsen","name":"Thomsen, Carsten","rank":8,"rolecode":"pau"},{"affno":"1","first":"Pia","key":"weikoppau","last":"Weikop","locid":"03dfc781-ac58-469d-a16a-12067a22f8fc","name":"Weikop, Pia","rank":9,"rolecode":"pau"},{"affno":"2","first":"Claus","key":"svarerpau","last":"Svarer","name":"Svarer, Claus","rank":10,"rolecode":"pau"},{"affno":"1","first":"Gitte M","key":"knudsenpau","last":"Knudsen","locid":"f02aee9e-69cf-491a-9765-ff062f734db8","name":"Knudsen, Gitte Moos","name_org":"Knudsen, Gitte M","orcid":"0000-0003-1508-6866","rank":11,"rolecode":"pau"}],"pmid":["33461410"],"pub":{"doi":"10.1177/0271678x20982389","issn":["0271678X","15597016"],"issn_org":["0271678X"],"issue":"8","journal":"Journal of Cerebral Blood Flow and Metabolism","pages":"1954-1963","status":"p","title":"Journal of Cerebral Blood Flow and Metabolism","volume":"41"},"review":"Peer Reviewed","scoID":["2-s2.0-85099695333"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-2df71733-243e-4e00-a9db-b3b92a91c2af"],"src":["KU University of Copenhagen"],"title":"Parkinson patients have a presynaptic serotonergic deficit : A dynamic deep brain stimulation PET study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-420839","year":"2021","yearsub":"2021"}
{"abstract":"Denne rapport er skrevet på baggrund af en undersøgelse om onlineundervisning under forårets nedlukning af de videregående uddannelsesinstitutioner som følge af COVID-19 pandemien. Aalborg Universitet (AAU), Aarhus Universitet (AU), professionshøjskolen Absalon (PHA), Danmarks Medie- og Journalisthøjskole (DMJX), Roskilde Universitet (RUC), Syddansk Universitet (SDU), UCL Erhvervsakademi og Professionshøjskole (UCL), UC SYD, Professionshøjskolen UCN (UCN) og Via University Collage (VIA) var alle involveret i undersøgelsen. Undersøgelsen fik derfor bredt indblik i onlineundervisning på tværs af institutionerne. Undersøgelsen har til formål at opfange erfaringer og beskrive de praksisser der etableres med digitalt understøttet undervisning og læring. Da første nedlukning var uventet kan det ikke forventes at praksisserne der etableres i denne periode afspejler online undervisning i andre situationer end i nødundervisning men undersøgelsen vil pege på muligheder i onlineundervisning på baggrund af erfaringerne fra forårets nedlukning. Rapporten dækker systemlandskaberne i det forskellige institutioner før og under nedlukningen, den teoretiske begrebsramme for undersøgelsen,undersøgelsesdesign og analyse for at besvare 4 centrale undersøgelsesspørgsmål. : 1) Hvilken variation af digitalt understøttede didaktiske praksisser har etableret sig på tværs af institutionstyper og fagområder? 2) Hvordan oplever studerende forskellige praksisser, og hvilken betydning har de for forskellige studerende, bl.a. i forhold til oplevet læringsudbytte, læringsstrategier og mestringsoplevelser? 3) Hvordan oplever undervisere forskellige praksisser, og hvilken betydning har de for forskellige undervisere, for deres forhold til de studerende, samt deres oplevelse af faglig og professionel tilfredshed? 4) Hvordan påvirker de digitalt understøttede praksisser hhv. A. Samarbejdet mellem studerende og B. Samarbejdet mellem undervisere og studerende? Undersøgelsen består af 4 dele: • En spørgeskemaundersøgelse blandt 85.000 studerende fordelt på 9 institutioner • En spørgeskemaundersøgelse blandt 6.000 undervisere fordelt på de samme 9 institutioner • En interviewundersøgelse med strategisk udvalgte respondenter fra de to spørgeskemaundersøgelser • En kortlægning af institutionernes systemlandskaber og organisatoriske ressourcer ift. omlægning til onlineundervisning","author_count":37,"contributors":["Larsen, Søren","Georgsen, Marianne","Qvortrup, Ane","Andersen, Ina Solveig Kjær","Asmussen, Ida Skytte","Bak, Carsten Kronborg","Buus, Lillian","Dalsgaard, Christian","Geisnæs, Dorthe","Graf, Stefan Ting","Gundersen, Peter","Gynther, Karsten","Horn, Line Helverskov","Jensen, Søren Tapdrup","Jørgensen, Asbjørn","Jørnø, Rasmus","Kjærgaard, Thomas","Konnerup, Ulla","Larsen, Inger Knude","Lorentzen, Rasmus Fink","Lyngsø, Anita","Marinos, Nicolas","Nielsen, Steen","Nortvig, Anne-Mette","O’Neill, Lotte Dyhrberg","Pallesen, Thomas Aagaard","Pettersson, Morten","Puck, Morten Rasmus","Rasmussen, Fie","Riis, Marianne","Ruge, Dorte","Sejersen, Thomas Spejlborg","Skovbjerg, Annegrete","Sverregaard, Jonas Svenstrup","Troelsen, Rie"],"cuid":["S01-000.00-561041"],"filters":{"added":"2022-08","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"level":"pop","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U","DI-UC"],"level3":{"U":["DI-U-ALL","DI-U-RUC","DI-U-SDU"],"UC":["DI-UC-ALL","DI-UC-UCN"]},"level3all":["DI-U-RUC","DI-U-SDU","DI-UC-UCN"]},"review":"und","rtype":["clu"],"sorti":"erfaringer og oplevelser med online undervisning på 000000000009 videregående uddannelsesinstitutioner i foråret 000000002020","src":["ruc"],"src-code":["DI-U-RUC"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://www.ucn.dk/Files/Billeder/ucn/Forskning/COVID%2019%20undervisning%20samlet%20rapport.pdf","version":"Published Version"},"id":"S01-000.00-561041","ids":["ruc