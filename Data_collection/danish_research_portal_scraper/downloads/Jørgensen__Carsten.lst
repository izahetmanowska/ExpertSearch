"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","country":"es","key":"hospital universitari germans trias i pujol","loc":["Spain","Europe, EU","OECD"],"name":"Hospital Universitari Germans Trias i Pujol","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal Medicine: Haematology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Tereza","key":"faitovápau","last":"Faitová","name":"Faitová, Tereza","rank":1,"rolecode":"pau"},{"affno":"1","first":"Rebecka","key":"svanbergpau","last":"Svanberg","name":"Svanberg, Rebecka","rank":2,"rolecode":"pau"},{"affno":"1","first":"Caspar","key":"dacunhabangpau","last":"Da Cunha-Bang","name":"Da Cunha-Bang, Caspar","rank":3,"rolecode":"pau"},{"affno":"1","first":"Emma E.","key":"ilettpau","last":"Ilett","name":"Ilett, Emma E.","rank":4,"rolecode":"pau"},{"affno":"1","first":"Mette","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, Mette","rank":5,"rolecode":"pau"},{"affno":"2","first":"Marc","key":"noguerajulianpau","last":"Noguera-Julian","name":"Noguera-Julian, Marc","rank":6,"rolecode":"pau"},{"affno":"2","first":"Roger","key":"paredespau","last":"Paredes","name":"Paredes, Roger","rank":7,"rolecode":"pau"},{"affno":"1","first":"Cameron R.","key":"macphersonpau","last":"MacPherson","name":"MacPherson, Cameron R.","rank":8,"rolecode":"pau"},{"affno":"3","first":"Carsten U.","key":"niemannpau","last":"Niemann","locid":"c34cbf81-3f48-4443-8481-b428de733daa","name":"Niemann,