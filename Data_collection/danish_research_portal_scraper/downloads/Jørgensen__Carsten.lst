Denmark, National Institute of Aquatic Resources, Danish Shellfish Centre"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Per","key":"andersenpau","last":"Andersen","name":"Andersen, Per","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Torben Bramming","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, Torben Bramming","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Carsten Fomsgaard","key":"nielsenpau","last":"Nielsen","locid":"1cac8042-ddce-464b-b67e-6c45c9639856","name":"Nielsen, Carsten Fomsgaard","rank":3,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Private Research","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Miscellaneous","NIRAS A/S","Other Research","Private Research","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-55333303-3c4b-4c5a-a5c1-42132a422ed9"],"src":["DTU Technical University of Denmark"],"title":"Hav-/fjordhaver i Danmark – Rekreative, ikke-kommercielle foreningsbaserede akvakulturaktiviteter til produktion af skaldyr og tang","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-329894","year":"2017","yearsub":"2017"}
{"abstract":"Enteroaggregative Escherichia coli (EAEC) is an emerging cause of acute and persistent diarrhea worldwide. The pathogenesis of different EAEC stains is complicated, however, the early essential step begins with attachment of EAEC to intestinal mucosa via aggregative adherence fimbriae (AAFs). Currently, five different variants have been identified, which all share a degree of similarity in the gene organization of their operons and sequences. Here, we report the solution structure of Agg5A from the AAF/V variant. While preserving the major structural features shared by all AAF members, only Agg5A possesses an inserted helix at the beginning of the donor strand, which together with altered surface electrostatics, renders the protein unable to interact with fibronectin. Hence, here we characterize the first AAF variant with a binding mode that varies from previously described AAFs","author_count":9,"contributors":["Jønsson, Rie","Liu, Bing","Struve, Carsten","Yang, Yi","Jørgensen, René","Xu, Yingqi","Jenssen, Håvard","Krogfelt, Karen Angeliki","Matthews, Steve"],"cuid":["S01-000.00-558420"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","Imperial College London"],"keyword":["Agg5A","Aggregative adherence fimbriae","Chaperone usher","Donor strand complementation","E coli","Fibronectin","Pilin"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU","DI-U-RUC"]},"level3all":["DI-GV-SSI","DI-U-DTU","DI-U-KU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"structural and functional studies of i escherichia coli i aggregative adherence fimbriae aaf v reveal a deficiency in extracellular matrix binding","src":["ruc"],"src-code":["DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.bbapap.2016.11.017","version":"Published Version"},"id":"S01-000.00-558420","identifier":[{"id":"85007109753","type":"scopus"}],"ids":["ruc-248827d4-416d-4698-afe3-8fec7bc31f47"],"keyword":["Agg5A","Aggregative adherence fimbriae","Chaperone-usher","Donor strand complementation","E. coli","Fibronectin","Pilin"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-BD7B30F3B2A2EADB1C0ACC23C009AA51"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/63614486/1_s2.0_S1570963916302540_main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.bbapap.2016.11.017","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of Science and Environment"],"nora_code":"DI-U-RUC","used":1},{"affno":"2","country":"dk","key":"ssi statens serum institut","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-SSI","l3nn":"SSI Statens Serum Institut","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SSI Statens Serum Institut","namevar":["Statens Serum Institut"],"nora_code":"DI-GV-SSI","used":1},{"affno":"3","country":"gb","key":"imperial college london","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Imperial College London","used":1},{"affno":"4","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"5","country":"dk","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1 2","country":"dk","first":"Rie","key":"jønssonpau","last":"Jønsson","locid":"cd1cc5e5-d680-4d05-8b0d-a0147338d56f","name":"Jønsson, Rie","rank":1,"rolecode":"pau"},{"affno":"3","first":"Bing","key":"liupau","last":"Liu","name":"Liu, Bing","rank":2,"rolecode":"pau"},{"affno":"2 4 5","first":"Carsten","key":"struvepau","last":"Struve","name":"Struve, Carsten","rank":3,"rolecode":"pau"},{"affno":"3","first":"Yi","key":"yangpau","last":"Yang","name":"Yang, Yi","rank":4,"rolecode":"pau"},{"affno":"2","first":"René","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, René","rank":5,"rolecode":"pau"},{"affno":"3","first":"Yingqi","key":"xupau","last":"Xu","name":"Xu, Yingqi","rank":6,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Håvard","key":"jenssenpau","last":"Jenssen","locid":"4e5fb70f-7fa7-4a47-a55f-66a0c67d966a","name":"Jenssen, Håvard","orcid":"0000-0003-0007-0335","rank":7,"rolecode":"pau"},{"affno":"2","first":"Karen Angeliki","key":"krogfeltpau","last":"Krogfelt","name":"Krogfelt, Karen Angeliki","rank":8,"rolecode":"pau"},{"affno":"3","first":"Steve","key":"matthewspau","last":"Matthews","name":"Matthews, Steve","rank":9,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.bbapap.2016.11.017","issn":["15709639"],"issue":"3","journal":"BBA - Proteins and Proteomics","pages":"304-311","status":"p","title":"BBA - Proteins and Proteomics","title_org":"B B A - Proteins and Proteomics","volume":"1865"},"review":"Peer Reviewed","scoID":["2-s2.0-85007109753"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Roskilde University","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ruc-248827d4-416d-4698-afe3-8fec7bc31f47"],"src":["RUC Roskilde University"],"title":"Structural and functional studies of <i>Escherichia coli</i> aggregative adherence fimbriae (AAF/V) reveal a deficiency in extracellular matrix binding","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-558420","year":"2017","yearsub":"2017"}
{"abstract":"OBJECTIVE: The use of low-dose aspirin (acetylsalicylic acid [ASA]) has been suggested to attenuate growth of abdominal aortic aneurysms (AAAs), yet solid clinical evidence of this hypothesis is still missing. This study aimed to investigate whether preadmission ASA use influenced the risk of presenting with rupture of AAA (rAAA) on hospital admission and subsequent 30-day case fatality. METHODS: There were 4010 patients with an incident diagnosis of rAAA and 4010 age- and sex-matched AAA patients identified in the Danish National Registry of Patients. Data on comorbidity, concomitant drug use, primary health care utilization, socioeconomic status, and vital status were obtained from nationwide health care and administrative registries. RESULTS: Preadmission ASA use was identified for 1815 (45.3%) rAAA patients and 2111 (52.6%) AAA patients, corresponding to a crude odds ratio for rAAA in ASA users of 0.72 (95% confidence interval [CI], 0.66-0.79) compared with nonusers. However, after adjustment for possible confounders, no association between ASA use and the risk of rAAA was found (adjusted odds ratio, 0.97; 95% CI, 0.86-1.08). The aggregated 30-day rAAA case-fatality rate for users of ASA was 66.0% compared with 56.9% for nonusers, corresponding to an adjusted mortality rate ratio of 1.16 (95% CI, 1.06-1.27). CONCLUSIONS: Preadmission ASA use is not associated with an altered risk of AAA rupture but seems to be associated with a worse prognosis after rupture of AAA.","author_count":7,"contributors":["Wemmelund, Holger","Jørgensen, Trine M M","Høgh, Annette","Behr-Rasmussen, Carsten","Johnsen, Søren Paaske","Lindholt, Jes S."],"cuid":["S02-098.37-015442"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Aged","Aged 80 and over","Aortic Aneurysm Abdominal diagnostic imaging","Aortic Rupture diagnostic imaging","Aspirin administration dosage","Case Control Studies","Denmark epidemiology","Disease Progression","Female","GROWTH","Humans","Logistic Models","Male","Management","Middle Aged","Mortality","Mural thrombus","Odds Ratio","Practice guidelines","Prognosis","Proportional Hazards Models","Register","Registries","Risk Assessment","Risk Factors","Society","TRENDS","Time Factors","Vascular surgery","thrombus volume"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-CDR","DI-HO-SDR","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"low dose aspirin and rupture of abdominal aortic aneurysm","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85008315556","version":"Other Version"},"id":"S02-098.37-015442","identifier":[{"id":"27460909","type":"pmid"},{"id":"85008315556","type":"scopus"}],"ids":["au-2712c68d-e2ca-4e3d-b52a-ea2c38645ad6","sdu-0ba0963c-a89b-46a9-a680-af5de704a867"],"keyword":["Aged","Aged, 80 and over","Aortic Aneurysm, Abdominal/diagnostic imaging","Aortic Rupture/diagnostic imaging","Aspirin/administration & dosage","Case-Control Studies","Denmark/epidemiology","Disease Progression","Female","GROWTH","Humans","Logistic Models","MANAGEMENT","MORTALITY","MURAL THROMBUS","Male","Middle Aged","Odds Ratio","PRACTICE GUIDELINES","Prognosis","Proportional Hazards Models","REGISTER","Registries","Risk Assessment","Risk Factors","SOCIETY","THROMBUS VOLUME","TRENDS","Time Factors","VASCULAR-SURGERY"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-92E4CB333E53DEF6176DCC93DD465ACE"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarh