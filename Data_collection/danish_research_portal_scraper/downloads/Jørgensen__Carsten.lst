/local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-158991","year":"2013","yearsub":"2013"}
{"abstract":"β-cell function is improved in patients with type 2 diabetes in response to an oral glucose stimulus after Roux-en-Y gastric bypass (RYGB) surgery. This has been linked to an exaggerated glucagon-like peptide 1 (GLP-1) secretion, but causality has not been established. The aim of this study was to investigate the role of GLP-1 in improving β-cell function and glucose tolerance and in regulating glucagon release after RYGB, using the GLP-1 receptor (GLP-1R)-specific antagonist, Exendin(9-39) (Ex-9). Nine patients with type 2 diabetes, were examined before, 1 week and 3 months after surgery. Each visit consisted of two experimental days, allowing a meal test with infusion of saline or Ex-9 in random order. After RYGB, glucose tolerance improved, β-cell glucose sensitivity (β-GS) doubled, the GLP-1 response greatly increased and glucagon secretion was augmented. GLP-1R blockade did not affect β-cell function and meal-induced glucagon release before the operation, but did impair glucose tolerance. After RYGB, β-GS decreased to preoperative levels, glucagon secretion increased and glucose tolerance was impaired by Ex-9 infusion. Thus, the exaggerated effect of GLP-1 after RYGB is of major importance for the improvement in β-cell function, and the controlof glucagon release and glucose tolerance in patients with type 2 diabetes. ClinicalTrials.gov (NCT01579981).","author_count":10,"contributors":["Jørgensen, Nils B","Dirksen, Carsten","Bojsen-Møller, Kirstine N","Jacobsen, Siv H","Worm, Dorte","Hansen, Dorte Lindqvist","Kristiansen, Viggo B","Naver, Lars","Madsbad, Sten","Holst, Jens Juul"],"cuid":["S01-000.00-432454"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the exaggerated glucagon like peptide 000000000001 response is important for the improved β cell function and glucose tolerance after roux en y gastric bypass in patients with type 000000000002 diabetes","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.2337/db13-0022","version":"Other Version"},"id":"S01-000.00-432454","identifier":[{"id":"PMC3749359","type":"pmcid"},{"id":"84885473538","type":"scopus"},{"id":"23649520","type":"pmid"}],"ids":["ku-41460ed3-204d-4af4-ab1e-04ff9682e3da"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-E828ABA6643E9482CE7E526FE3012A15"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.2337/db13-0022","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Biomedical Sciences, Teaching"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Nils B","key":"jørgensenpau","last":"Jørgensen","locid":"694893d0-af33-4f21-ad66-945a1522de37","name":"Jørgensen, Nils B","rank":1,"rolecode":"pau"},{"affno":"","first":"Carsten","key":"dirksenpau","last":"Dirksen","name":"Dirksen, Carsten","rank":2,"rolecode":"pau"},{"affno":"","first":"Kirstine N","key":"bojsenmøllerpau","last":"Bojsen-Møller","name":"Bojsen-Møller, Kirstine N","rank":3,"rolecode":"pau"},{"affno":"1","first":"Siv H","key":"jacobsenpau","last":"Jacobsen","locid":"9258b6d4-2bc2-4170-93e9-56b995a9601d","name":"Jacobsen, Siv H","rank":4,"rolecode":"pau"},{"affno":"1","first":"Dorte","key":"wormpau","last":"Worm","locid":"e9a01598-3ada-4289-9c00-a8ddb8fe62f0","nam