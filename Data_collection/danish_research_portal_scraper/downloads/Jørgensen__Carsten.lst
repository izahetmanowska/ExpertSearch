9595","rank":4,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Carsten R.","key":"bjarkamcarstenrpau","last":"Bjarkam","name":"Bjarkam, Carsten R.","rank":4,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Carsten","key":"bruuncarstenpau","last":"Bruun","name":"Bruun, Carsten","rank":5,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Jon","key":"kaspersenjonpau","last":"Caspersen","locid":"890adfbf-a92f-40e9-8e94-c131fb5a0954","name":"Kaspersen, Jon","name_org":"Caspersen, Jon","rank":6,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Jon","key":"caspersenjonpau","last":"Caspersen","name":"Caspersen, Jon","rank":6,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Kjeld","key":"donskjeldpau","last":"Dons","name":"Dons, Kjeld","rank":7,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Louise Møller","key":"jørgensenlouisemøllerpau","last":"Jørgensen","name":"Jørgensen, Louise Møller","rank":8,"rolecode":"pau"},{"affno":"8","corresponding":null,"country":"dk","first":"Mikkel","key":"rasmussenmikkelmyliuspau","last":"Rasmussen","locid":"0a611a7f-8a19-41f3-9221-58fe673b3ef1","name":"Rasmussen, Mikkel Mylius","name_org":"Rasmussen, Mikkel","orcid":"0000-0002-4768-7255","rank":9,"rolecode":"pau"},{"affno":"9","corresponding":null,"first":"Mikkel","key":"rasmussenmikkelpau","last":"Rasmussen","name":"Rasmussen, Mikkel","rank":9,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Michael","key":"nielsenmichaelpau","last":"Nielsen","name":"Nielsen, Michael","rank":10,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Troels Hafeldt","key":"nielsentroelshafeldtpau","last":"Nielsen","name":"Nielsen, Troels Hafeldt","rank":11,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Casper","key":"pedersencasperpau","last":"Pedersen","name":"Pedersen, Casper","rank":12,"rolecode":"pau"},{"affno":"8 9","corresponding":null,"country":"dk","first":"Kresten","key":"rickerskrestenpau","last":"Rickers","locid":"4a7d1b5a-2191-48f3-aff2-7c661f1495b4","name":"Rickers, Kresten","rank":13,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rikke","key":"rousingrikkepau","last":"Rousing","name":"Rousing, Rikke","rank":14,"rolecode":"pau"},{"affno":"9","corresponding":null,"first":"Simon Toftgaard","key":"skovsimontoftgaardpau","last":"Skov","name":"Skov, Simon Toftgaard","rank":15,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Mikkel Østerheden","key":"andersenmikkeløsterhedenpau","last":"Andersen","name":"Andersen, Mikkel Østerheden","rank":16,"rolecode":"pau"}],"pmid":["40247626"],"pub":{"doi":"10.1097/brs.0000000000005241","issn":["03622436","15281159"],"issn_org":["03622436"],"issue":"18","journal":"Spine","publisher":"Wolters Kluwer Health","status":"p","title":"Spine","volume":"50"},"review":"Peer Reviewed","scoID":["2-s2.0-105004888299"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","North Denmark Region","Other Research","Region Zealand","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-88c4ad56-bccb-4f94-a8c9-61be0071121a","au-bdc2d5e5-a96d-4cb2-9431-51e28634a68a"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Perioperative Opioid Consumption in Patients who Undergo Surgery due to Spine Related Pain. A Danish Nationwide Cohort Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-822378","year":"2025","yearsub":"2025"}
{"abstract":"Background: Triacylglycerol (TAG) plasma excursions after a high-fat meal are blunted after Roux-en-Y gastric bypass (RYGB), but underlying mechanisms are poorly understood. We studied TAG absorption and metabolism in 12 RYGB-operated individuals and 12 unoperated controls (CON) matched on sex, age, and BMI. Methods: Participants followed a 7-day controlled diet and on day 4 underwent 1H-MR Spectroscopy of liver TAG and a high-fat liquid meal with oral and intravenous labeled stable isotope metabolites, subcutaneous abdominal fat biopsies, and indirect calorimetry. Subsequently, participants collected stool for 96 h. Results: Overall fat absorption from the controlled diet was moderately lower in RYGB than CON (88 % versus 93 %, P < 0.01), without indication of greater specific malabsorption of fat from the high-fat test meal (recovery of TAG and labeled TAG in 96-h stool samples). After an overnight fast, plasma TAG concentrations and incorporation of plasma fatty acids (IV tracer) into TAG did not differ between groups. The postprandial 6-h iAUC of plasma TAG plasma concentrations was markedly lower in RYGB than CON (15 versus 70 mmol/L × min, P = 0.03). The postprandial chylomicron (CM) particle response (plasma ApoB48) was initially higher in RYGB, but with lower CM-TAG plasma concentrations and appearance of labeled palmitate from the oral tripalmitin tracer over the 6 h. Conclusion: Fat absorption is only moderately lower after RYGB compared with unoperated matched controls. Nevertheless, postprandial TAG and CM plasma kinetics after a high-fat meal are markedly altered after RYGB with substantially lower TAG and CM-TAG concentrations despite a faster CM particle release.","author_count":18,"contributors":["Hindsø, Morten","Lundsgaard, Annemarie","Marinkovic, Bojan","Jensen, Mikkel Helmuth","Hedbäck, Nora","Svane, Maria Saur","Dirksen, Carsten","Jørgensen, Nils Bruun","London, Amalie","Jeppesen, Palle Bekker","Hvistendahl, Mark Krogh","Christoffersen, Christina","Siebner, Hartwig Roman","Kiens, Bente","Holst, Jens Juul","Madsbad, Sten","van Hall, Gerrit","Bojsen-Møller, Kirstine Nyvold"],"cuid":["S01-000.00-809231"],"filters":{"added":"2025-06","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Absorption","Bariatric surgery","Chylomicron","FAT","Lipids","Lipoprotein","Obesity","Triacylglycerol","Very low density lipoprotein"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"fat absorption and metabolism after roux en y gastric bypass surgery","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.metabol.2025.156189","version":"Published Version"},"id":"S01-000.00-809231","identifier":[{"id":"86000748433","type":"scopus"},{"id":"40074057","type":"pmid"}],"ids":["ku-1e18bf6d-0c49-45b4-8823-e12f903211e5"],"keyword":["Absorption","Bariatric surgery","Chylomicron","Fat","Lipids","Lipoprotein","Obesity","Triacylglycerol","Very-low-density lipoprotein"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-D15C8970C85D30C999A0C0243FE708D5"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/444652903/Fat_absorption.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.metabol.2025.156189","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Amager and Hvidovre"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Nutrition, Exercise and Sports, The August Krogh Section for Molecular Physiology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Morten","key":"hindsøpau","last":"Hindsø","name":"Hindsø, Morten","rank":1,"rolecode":"pau"},{"affno":"2","first":"Annemarie","key":"lundsgaardpau","last":"Lundsgaard","locid":"247ea046-776b-4b22-816a-6368bcdf38e4","name":"Lundsgaard, Annemarie","orcid":"0000-0002-5584-2366","rank":2,"rolecode":"pau"},{"affno":"2","first":"Bojan","key":"marinkovicpau","last":"Marinkovic","name":"Marinkovic, Bojan","rank":3,"rolecode":"pau"},{"affno":"1","first":"Mikkel Helmuth","key":"jensenpau","last":"Jensen","name":"Jensen, Mikkel Helmuth","rank":4,"rolecode":"pau"},{"affno":"1","first":"Nora","key":"hedbäckpau","last":"Hedbäck","name":"Hedbäck, Nora","rank":5,"rolecode":"pau"},{"affno":"1","first":"Maria Saur","key":"svanepau","last":"Svane","name":"Svane, Maria Saur","rank":6,"rolecode":"pau"},{"affno":"1 2","first":"Carsten","key":"dirksenpau","last":"Dirksen","locid":"2504d7c9-ee3f-4990-9c1b-10be728b298c","name":"Dirksen, Carsten","rank":7,"rolecode":"pau"},{"affno":"1","first":"Nils Bruun","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, Nils Bruun","rank":8,"rolecode":"pau"},{"affno":"1 2","first":"Amalie","key":"londonpau","last":"London","locid":"9d01f7ac-7d31-40e2-af72-c18b92be6689","name":"London, Amalie","orcid":"0000-0003-1708-9809","rank":9,"rolecode":"pau"},{"affno":"2 1","first":"Palle Bekker","key":"jeppesenpau","last":"Jeppesen","locid":"0a11b87b-7d2b-4fa0-843f-e5a307bafaad","name":"Jeppesen, Palle Bekker","orcid":"0000-0001-9680-6938","rank":10,"rolecode":"pau"},{"affno":"1","first":"Mark Krogh","key":"hvistendahlpau","last":"Hvistendahl","name":"Hvistendahl, Mark Krogh","rank":11,"rolecode":"pau"},{"affno":"1 2","first":"Christina","key":"christoffersenpau","last":"Christoffersen","locid":"7f6ac9b3-a8ee-401d-8c45-dc0bf731314a","name":"Christoffersen, Christina","rank":12,"rolecode":"pau"},{"affno":"2 1","first":"Hartwig Roman","key":"siebnerpau","last":"Siebner","locid":"d9ed8669-a16b-429a-86ed-353ef481bb72","name":"Siebner, Hartwig Roman","rank":13,"rolecode":"pau"},{"affno":"2","first":"Bente","key":"kienspau","last":"Kiens","locid":"d0bf12e6-2968-49da-b7ce-9e6ab6434ba1","name":"Kiens, Bente","orcid":"0000-0001-5705-5625","rank":14,"rolecode":"pau"},{"affno":"2","first":"Jens Juul","key":"holstpau","last":"Holst","locid":"864b6401-9024-4773-9bdb-f4d4ca57dcad","name":"Holst, Jens Juul","orcid":"0000-0001-6853-3805","rank":15,"rolecode":"pau"},{"affno":"1 2","first":"Sten","key":"madsbadpau","last":"Madsbad","locid":"1018c708-245a-4057-9263-074578042385","name":"Madsbad, Sten","rank":16,"rolecode":"pau"},{"affno":"1 2","first":"Gerrit","key":"vanhallpau","last":"van Hall","locid":"55a9b111-6dbb-4a42-a9ab-d5f3785fbdae","name":"van Hall, Gerrit","orcid":"0000-0002-2519-8127","rank":17,"rolecode":"pau"},{"affno":"1 2","first":"Kirstine Nyvold","key":"bojsenmøllerpau","last":"Bojsen-Møller","locid":"a1de842f-aeb0-4687-bcc1-a5478f6f6bf0","name":"Bojsen-Møller, Kirstine Nyvold","rank":18,"rolecode":"pau"}],"pmid":["40074057"],"pub":{"doi":"10.1016/j.metabol.2025.156189","issn":["00260495","15328600"],"issn_org":["00260495"],"journal":"Metabolism","paperid":"156189","status":"p","title":"Metabolism","title_org":"Metabolism: Clinical and Experimental","volume":"167"},"review":"Peer Reviewed","scoID":["2-s2.0-86000748433"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-1e18bf6d-0c49-45b4-8823-e12f903211e5"],"src":["KU University of Copenhagen"],"title":"Fat absorption and metabolism after Roux-en-Y gastric bypass surgery","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-809231","year":"2025","yearsub":"2025"}
{"abstract":"The extracellular matrix (ECM) protein Beta-Ig H3 (βigH3, also known as transforming growth factor β induced protein (TGFBI)) is related to poor prognosis in patients with pancreatic ductal adenocarcinoma (PDAC). Proteolytic cleavage of βigH3 has been shown to result in release of the N-terminal fragment covering amino acid 1 to 137, but whether the degradation of βigH3 is associated to prognosis has yet to be determined. In this study we developed an ELISA targeting a collagenase generated fragment of βigH3 (cβigH3) in human serum to use the fragment as a biomarker reflecting degradation of βigH3. We demonstrated that the assay was specific to the cleaved fragment (cβigH3) and confirmed the generation of cβigH3 from degradation of fibroblast generated matrices. Moreover, higher levels of cβigH3 were released upon degradation of matrices produced by TGF-β stimulated pancreatic fibroblast compared to matrices produced by pancreatic fibroblast without TGF-β stimulation, indicating an association of the biomarker with degradation of fibrotic matrix. To evaluate the clinical relevance, we first measured cβigH3 in a cohort of 220 patients with different types of cancer with detectable levels for all 11 cancer types. We then measured the cβigH3 biomarker in pre-treatment serum from a cohort of 469 patients with locally advanced or metastatic PDAC and found that high levels of cβigH3 were associated with longer overall survival independently of age, disease stage, performance status, carbohydrate antigen 19–9 (CA19-9), and the tumor fibrosis biomarker PRO-C3 as compared to patients with high levels of cβigH3 (HR 0.78, 95% CI: 0.0.61–0.98, p = 0.04). In conclusion, cβigH3 reflects proteolytic degradation of βigH3 and shows potential as an independent prognostic biomarker for patients with advanced PDAC.","author_count":12,"contributors":["Pedersen, Rasmus S.","Hettich, Annika","Thorlacius-Ussing, Jeppe","Langholm, Lasse L.","Crespo-Bravo, Marina","Chen, Inna M.","Hansen, Carsten P.","Johansen, Julia S.","Diab, Hadi M.H.","Jorgensen, Lars N.","Karsdal, Morten","Willumsen, Nicholas"],"cuid":["S01-000.00-818930"],"filters":{"added":"2025-08","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-PR","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"PR":["DI-PR-ALL","DI-PR-NBIO"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-PR-NBIO","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"proteolytic degradation of beta ig h000000000003 βigh000000000003 tgfbi can be quantified non invasively in serum and predicts prognosis in patients with advanced pancreatic ductal adenocarcinoma","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12885-025-14283-w","version":"Published Version"},"id":"S01-000.00-818930","identifier":[{"id":"PMC12093888","type":"pmcid"},{"id":"40394523","type":"pmid"},{"id":"105005548334","type":"scopus"}],"ids":["ku-3f1d4bc1-614d-4462-b81f-26cec646a756"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-D6E492D0092634B5DCA6D8E2EC3A8E83"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12885-025-14283-w","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/451409336/s12885-025-14283-w.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Biomedical Sciences, Graduate School"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"nordic bioscience","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-NBIO","l3nl":"Nordic Bioscience","l3nn":"Nordic Bioscience","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Nordic Bioscience","namevar":["Nordic Bioscience"],"nora_code":"DI-PR-NBIO","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Herlev and Gentofte"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1 2","first":"Rasmus S.","key":"pedersenpau","last":"Pedersen","locid":"adce4ab6-2951-4ae6-96c1-aad6ea40ec89","name":"Pedersen, Rasmus S.","rank":1,"rolecode":"pau"},{"affno":"1 2","first":"Annika","key":"hettichpau","last":"Hettich","locid":"079e072b-46d1-4c28-bc90-86bfaf2e22de","name":"Hettich, Annika","rank":2,"rolecode":"pau"},{"affno":"2","first":"Jeppe","key":"thorlaciusussingpau","last":"Thorlacius-Ussing","name":"Thorlacius-Ussing, Jeppe","rank":3,"rolecode":"pau"},{"affno":"2","first":"Lasse L.","key":"langholmpau","last":"Langholm","name":"Langholm, Lasse L.","rank":4,"rolecode":"pau"},{"affno":"1 2","first":"Marina","key":"crespobravopau","last":"Crespo-Bravo","locid":"dfef571f-413f-4473-ba49-bc65bb8cde60","name":"Crespo-Bravo, Marina","rank":5,"rolecode":"pau"},{"affno":"3","first":"Inna M.","key":"chenpau","last":"Chen","name":"Chen, Inna M.","rank":6,"rolecode":"pau"},{"affno":"3","first":"Carsten P.","key":"hansenpau","last":"Hansen","name":"Hansen, Carsten P.","rank":7,"rolecode":"pau"},{"affno":"3 1","first":"Julia S.","key":"johansenpau","last":"Johansen","locid":"b2f1fd05-1a2e-4879-b015-af4dfa479876","name":"Johansen, Julia S.","rank":8,"rolecode":"pau"},{"affno":"3","first":"Hadi M.H.","key":"diabpau","last":"Diab","name":"Diab, Hadi M.H.","rank":9,"rolecode":"pau"},{"affno":"3","first":"Lars N.","key":"jorgensenpau","last":"Jorgensen","name":"Jorgensen, Lars N.","rank":10,"rolecode":"pau"},{"affno":"2","first":"Morten","key":"karsdalpau","last":"Karsdal","name":"Karsdal, Morten","rank":11,"rolecode":"pau"},{"affno":"2","first":"Nicholas","key":"willumsenpau","last":"Willumsen","name":"Willumsen, Nicholas","rank":12,"rolecode":"pau"}],"pmid":["40394523"],"pub":{"doi":"10.1186/s12885-025-14283-w","issn":["14712407"],"issue":"1","journal":"BMC Cancer","paperid":"905","status":"p","title":"BMC Cancer","volume":"25"},"review":"Peer Reviewed","scoID":["2-s2.0-105005548334"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Private Research","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Hospitals","Nordic Bioscience","Private Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-3f1d4bc1-614d-4462-b81f-26cec646a756"],"src":["KU University of Copenhagen"],"title":"Proteolytic degradation of Beta-Ig H3 (βigH3/TGFBI) can be quantified non-invasively in serum and predicts prognosis in patients with advanced pancreatic ductal adenocarcinoma","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-818930","year":"2025","yearsub":"2025"}
{"abstract":"Introduction: To our knowledge, no research has reported long-term follow-up results from studies comparing collaborative care to consultation liaison in general practice. We have earlier reported 6-month follow-up. In this article, we report the 18-month follow-up results from the two Danish Collabri Flex studies.Methods: We compared collaborative care to consultation liaison in two randomized controlled trials for persons with anxiety disorders and depression, respectively. Both interventions sought to improve the quality of depression and anxiety care, but they differed in the extent mental health specialists were involved. As part of the consultation liaison intervention, psychiatrists and care managers could provide advice and suggestions to the general practitioner (GP). In the collaborative care intervention, psychiatrists and care managers could provide advice and suggestions, and care managers could help the GP manage patient care. 18 months after randomization, we collected follow-up data. Outcomes included anxiety symptoms (BAI), depression symptoms (BDI-II), well-being (WHO-5), functional disability (Sheehan Disability Scale), general psychological symptoms (SCL-90-R), and others.Results: In the depression trial, we found a statistically significant difference in depression symptoms between intervention groups at 18-month follow-up, in favor of collaborative care (4.4, 95%CI 2.8-7.0, p <= 0.001). Many other outcomes showed significant differences between groups, such as anxiety symptoms, functional level, well-being, general psychological symptoms, and self-efficacy. In the anxiety trial, we found no statistically significant difference between groups in anxiety symptoms (1.2, 95%CI -0.3-2.7, p <= 0.126). In this trial, significant differences between groups were found in outcomes measuring depression symptoms and general psychological symptoms but not in outcomes measuring functional level, well-being or self-efficacy. In both trials, no differences were found between groups on employment/education or sick leave measures. However, the collaborative care group in both trials had fewer contacts with private practicing psychologists during the 18 months follow-up.Conclusion: At 18-month follow-up, we found a statistically significant difference between allocation groups, when measuring depression symptoms in the depression trial but not when measuring anxiety symptoms in the anxiety trial. Further, the collaborative care intervention may have the potential to reduce referrals to private practicing psychologists, a service that is in high demand in Denmark.Trial Registration: ClinicalTrials.gov identifier: NCT03113175 and NCT03113201","author_count":9,"contributors":["Curth, Nadja Kehler","Bjorkedal, Siv Therese Bogevik","Hjorthøj, Carsten","Brinck-Claussen, Ursula","Jorgensen, Kirstine Bro","Rosendal, Susanne","Bojesen, Anders Bo","Nordentoft, Merete","Eplov, Lene Falgaard"],"cuid":["S01-000.00-819154"],"filters":{"added":"2025-08","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Anxiety","Care manager","Cognitive behavioral therapy","Collaborative care","Depression","General practice"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"collaborative care versus consultation liaison for patients with depression or anxiety disorders in general practice in denmark 000000000018 month follow up from the collabri flex trials","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1155/da/2909617","version":"Published Version"},"id":"S01-000.00-819154","identifier":[{"id":"40510804","type":"pmid"},{"id":"001502102400001","type":"wos"},{"id":"105008304578","type":"scopus"},{"id":"PMC12162161","type":"pmcid"}],"ids":["ku-583bef88-e5ae-498e-b320-9dfe33092e5f"],"keyword":["Anxiety","Care manager","Cognitive behavioral therapy","Collaborative care","Depression","General practice"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-EF679170AB44593AB2E4F33F168EE0DB"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1155/da/2909617","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/453510185/Depression_and_Anxiety_-_2025_-_Curth_-_Collaborative_Care_Versus_Consultation_Liaison_for_Patients_With_Depression_or.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Mental Health Services Glostrup"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Section of Epidemiology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Nadja Kehler","key":"curthpau","last":"Curth","name":"Curth, Nadja Kehler","rank":1,"rolecode":"pau"},{"affno":"1","first":"Siv Therese Bogevik","key":"bjorkedalpau","last":"Bjorkedal","name":"Bjorkedal, Siv Therese Bogevik","rank":2,"rolecode":"pau"},{"affno":"1 2","first":"Carsten","key":"hjorthojpau","last":"Hjorthoj","locid":"d4b636e3-7c21-48a0-b812-de219ca78a9e","name":"Hjorthøj, Carsten","name_org":"Hjorthoj, Carsten","rank":3,"rolecode":"pau"},{"affno":"1","first":"Ursula","key":"brinckclaussenpau","last":"Brinck-Claussen","name":"Brinck-Claussen, Ursula","rank":4,"rolecode":"pau"},{"affno":"1","first":"Kirstine Bro","key":"jorgensenpau","last":"Jorgensen","name":"Jorgensen, Kirstine Bro","rank":5,"rolecode":"pau"},{"affno":"1","first":"Susanne","key":"rosendalpau","last":"Rosendal","name":"Rosendal, Susanne","rank":6,"rolecode":"pau"},{"affno":"1","first":"Anders Bo","key":"bojesenpau","last":"Bojesen","name":"Bojesen, Anders Bo","rank":7,"rolecode":"pau"},{"affno":"1 2","first":"Merete","key":"nordentoftpau","last":"Nordentoft","locid":"6d0fe19c-7c81-463b-8bc8-822d71584b69","name":"Nordentoft, Merete","rank":8,"rolecode":"pau"},{"affno":"1","first":"Lene Falgaard","key":"eplovpau","last":"Eplov","name":"Eplov, Lene Falgaard","rank":9,"rolecode":"pau"}],"pmid":["40510804"],"pub":{"doi":"10.1155/da/2909617","issn":["10914269","15206394"],"issn_org":["10914269"],"issue":"1","journal":"Depression and Anxiety","paperid":"2909617","status":"p","title":"Depression and Anxiety","volume":"2025"},"review":"Peer Reviewed","scoID":["2-s2.0-105008304578"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-583bef88-e5ae-498e-b320-9dfe33092e5f"],"src":["KU University of Copenhagen"],"title":"Collaborative Care Versus Consultation Liaison for Patients With Depression or Anxiety Disorders in General Practice in Denmark : 18-Month Follow-Up From the Collabri Flex Trials","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-819154","year":"2025","yearsub":"2025"}
{"abstract":"Nutrient deprivation is a major trigger of autophagy, a conserved quality control and recycling process essential for cellular and tissue homeostasis. In a high-content image-based screen of the human ubiquitome, we here identify the E3 ligase Pellino 3 (PELI3) as a crucial regulator of starvation-induced autophagy. Mechanistically, PELI3 localizes to autophagic membranes, where it interacts with the ATG8 proteins through an LC3-interacting region (LIR). This facilitates PELI3-mediated ubiquitination of ULK1, driving ULK1's subsequent proteasomal degradation. PELI3 depletion leads to an aberrant accumulation and mislocalization of ULK1 and disrupts the early steps of autophagosome formation. Genetic deletion of Peli3 in mice impairs fasting-induced autophagy in the liver and enhances starvation-induced hepatic steatosis by reducing autophagy-mediated clearance of lipid droplets. Notably, PELI3 expression is decreased in the livers of patients with metabolic dysfunction-associated steatotic liver disease (MASLD), suggesting its role in hepatic steatosis development in humans. The findings suggest that PELI3-mediated control of autophagy plays a protective role in liver health.","author_count":17,"contributors":["Kolapalli, Srinivasa P","Beese, Carsten J.","Reid, Steven E","Brynjólfsdóttir, Sólveig H","Jørgensen, Maria H","Jain, Ashish","Cuenco, Joyceline","Lewinska, Monika","Abdul-Al, Ahmad","López, Aida R","Jäättelä, Marja","Sakamoto, Kei","Andersen, Jesper B","Maeda, Kenji","Rusten, Tor E","Lund, Anders H","Frankel, Lisa B."],"cuid":["S01-000.00-799432"],"filters":{"added":"2025-04","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, Non-EU","Nordic","OECD"],"country":["Norway"],"glorg":["All Global Affiliations","Oslo University Hospital","University of Oslo"],"keyword":["Animals","Autophagosomes metabolism","Autophagy","Fatty Liver metabolism","Humans","Intracellular Signaling Peptides and Proteins","Liver metabolism","Mice","Mice Knockout","Ubiquitin Protein Ligases metabolism","Ubiquitination"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-NP","DI-PR","DI-U"],"level3":{"NP":["DI-NP-ALL","DI-NP-CAN"],"PR":["DI-PR-ALL","DI-PR-GUB"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-NP-CAN","DI-PR-GUB","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"pellino 000000000003 e000000000003 ligase promotes starvation induced autophagy to prevent hepatic steatosis","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1126/sciadv.adr2450","version":"Published Version"},"id":"S01-000.00-799432","identifier":[{"id":"PMC11740972","type":"pmcid"},{"id":"39823344","type":"pmid"},{"id":"85216616082","type":"scopus"}],"ids":["ku-4b1e86dc-8ca0-4b96-a3e1-f61ecf99c13b"],"keyword":["Animals","Autophagosomes/metabolism","Autophagy","Autophagy-Related Protein-1 Homolog/metabolism","Fatty Liver/metabolism","Humans","Intracellular Signaling Peptides and Proteins","Liver/metabolism","Mice","Mice, Knockout","Starvation/metabolism","Ubiquitin-Protein Ligases/metabolism","Ubiquitination"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-B1F9012430F95A192F18833DB8637800"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://curis.ku.dk/ws/files/430095736/sciadv.adr2450.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1126/sciadv.adr2450","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"dcrc danish cancer society research center","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-CAN","l3nn":"DCRC Danish Cancer Society Research Center","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DCRC Danish Cancer Society Research Center","namevar":["Danish Cancer Society"],"nora_code"