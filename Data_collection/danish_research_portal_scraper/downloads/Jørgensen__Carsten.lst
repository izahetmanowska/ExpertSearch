e":"Rosenkilde, Mette M.","orcid":"0000-0001-9600-3254","rank":24,"rolecode":"pau"},{"affno":"1","first":"Bolette","key":"hartmannbolettepau","last":"Hartmann","locid":"eb04fc6b-068a-4d5b-a106-1b7be3f7e12b","name":"Hartmann, Bolette","orcid":"0000-0001-8509-2036","rank":25,"rolecode":"pau"},{"affno":"1","first":"Bo","key":"feldtrasmussenbopau","last":"Feldt-Rasmussen","locid":"cdd06e7b-83c5-4118-8808-eb4591586aac","name":"Feldt-Rasmussen, Bo","rank":26,"rolecode":"pau"},{"affno":"1","first":"Matthias","key":"mannmatthiaspau","last":"Mann","locid":"f463f571-68c5-44fb-bff1-bb9d748fcda8","name":"Mann, Matthias","orcid":"0000-0003-1292-4799","rank":27,"rolecode":"pau"},{"affno":"1","first":"Sten","key":"madsbadstenpau","last":"Madsbad","locid":"1018c708-245a-4057-9263-074578042385","name":"Madsbad, Sten","rank":28,"rolecode":"pau"},{"affno":"1","first":"Jens J.","key":"holstjensjuulpau","last":"Holst","locid":"864b6401-9024-4773-9bdb-f4d4ca57dcad","name":"Holst, Jens Juul","name_org":"Holst, Jens J.","orcid":"0000-0001-6853-3805","rank":29,"rolecode":"pau"}],"pmid":["29117552"],"pub":{"doi":"10.1016/j.celrep.2017.10.034","issn":["22111247"],"issue":"6","journal":"Cell Reports","pages":"1452-1460","publisher":"Cell Press","status":"p","title":"Cell Reports","volume":"21"},"review":"Peer Reviewed","scoID":["2-s2.0-85034087701"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-7b511021-3b07-43b6-9570-15b792cf700d","ku-5de0f9aa-7d95-4884-a486-1ef985f758da"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Circulating Glucagon 1-61 Regulates Blood Glucose by Increasing Insulin Secretion and Hepatic Glucose Production","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-096.32-035421","year":"2017","yearsub":"2017"}
{"abstract":"Perfluorinated alkylate substances (PFASs) are highly persistent and may cause immunotoxic effects. PFAS-associated attenuated antibody responses to childhood vaccines may be affected by PFAS exposures during infancy, where breastfeeding adds to PFAS exposures. Of 490 members of a Faroese birth cohort, 275 and 349 participated in clinical examinations and provided blood samples at ages 18 months and 5 years. PFAS concentrations were measured at birth and at the clinical examinations. Using information on duration of breastfeeding, serum-PFAS concentration profiles during infancy were estimated. As outcomes, serum concentrations of antibodies against tetanus and diphtheria vaccines were determined at age 5. Data from a previous cohort born eight years earlier were available for pooled analyses. Pre-natal exposure showed inverse associations with the antibody concentrations five years later, with decreases by up to about 20% for each two-fold higher exposure, while associations for serum concentrations at ages 18 months and 5 years were weaker. Modeling of serum-PFAS concentration showed levels for age 18 months that were similar to those measured. Concentrations estimated for ages 3 and 6 months showed the strongest inverse associations with antibody concentrations at age 5 years, particularly for tetanus. Joint analyses showed statistically significant decreases in tetanus antibody concentrations by 19–29% at age 5 for each doubling of the PFAS exposure in early infancy. These findings support the notion that the developing adaptive immune system is particularly vulnerable to immunotoxicity during infancy. This vulnerability appears to be the greatest during the first 6 months after birth, where PFAS exposures are affected by breast-feeding.","author_count":7,"contributors":["Grandjean, Philippe","Heilmann, Carsten","Weihe, Pal","Nielsen, Flemming","Mogensen, Ulla Brasch","Timmermann, Amalie","Budtz-Jørgensen, Esben"],"cuid":["S02-100.00-043017"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["America, North","Europe, Non-EU","Nordic","OECD"],"country":["Faroe Islands","United States"],"glorg":["All Global Affiliations","Faroese Hospital System","Harvard T.H. Chan School of Public Health"],"keyword":["Journal Article"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"estimated exposures to perfluorinated compounds in infancy predict attenuated vaccine antibody concentrations at age 000000000005 years","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1080/1547691X.2017.1360968","version":"Published Version"},"id":"S02-100.00-043017","identifier":[{"id":"85046047968","type":"scopus"},{"id":"28805477","type":"pmid"},{"id":"PMC6190594","type":"pmcid"}],"ids":["ku-6539b42b-51fe-446b-99fe-1a35bcf49d97","sdu-3842c516-e9d9-4f20-a1c1-8e4f51da3d75"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-7520E3F3D22F4E9CD23A288A8DCDC544"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/140263493/Estimated_exposures_to_perfluorinated_compounds_in_infancy_predict_attenuated_vaccine_antibody_concentrations_at_age_5_years.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1080/1547691X.2017.1360968","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/195961508/Estimated_exposures_to_perfluorinated_compounds_in_infancy_predict_attenuated_vaccine_antibody_co