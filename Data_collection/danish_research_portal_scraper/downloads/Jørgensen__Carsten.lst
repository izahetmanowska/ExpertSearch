ergpau","last":"Underbjerg","locid":"e69c5d62-028e-4c93-8551-0e7d856ca8a3","name":"Underbjerg, Anne Marie","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Mads Andersen","key":"høgpau","last":"Høg","locid":"d4447e99-9e72-4c23-acab-8da444b90914","name":"Høg, Mads Andersen","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Carsten","key":"wulffpau","last":"Wulff","locid":"cd62074e-697c-4c07-b82c-af85d394b325","name":"Wulff, Carsten","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Ulla","key":"haahrpau","last":"Haahr","locid":"a993b36f-8f5b-4e05-a59c-a2bd3308b013","name":"Haahr, Ulla","rank":6,"rolecode":"pau"}],"pub":{"publisher":"SFI - Det Nationale Forskningscenter for Velfærd","status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Governmental Institutions","DI-ALL","DI-GV","DI-GV-ALL","Governmental Institutions"],"PST":["Published"]},"sid":["vive-cae06fc4-dfa6-4905-98f0-1ee76d7bfdf4"],"src":["VIVE The Danish Center for Social Science Research"],"title":"Social Forskning, 2016:1","type":"Other-Internet Publication","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-664946","year":"2016"}
{"abstract":"As part of an on-going research project (2015-2017) at The National Centre for Vocational Pedagogy, Metropolitan University College, we are studying why and how vocational teachers understand and design for boundary crossing through the use of ICT-based artefacts. The research project is based on a sociocultural framework with cultural-historical activity theory (CHAT) guiding the initial phases. In this short paper, we present preliminary findings based on six ethnographic interviews with vocational teachers, and we zoom in on the teachers' experiences with central elements of their bounded systems. We found that these teachers use ICT as mediating tool within a single system, but rarely as boundary object in and between systems.","author_count":5,"contributors":["Riis, Marianne","Bergstedt, Palle","Jørgensen, Claus Bo","Koch, Hans Henrik","Rasmussen, Carsten Lund"],"cuid":["S02-087.84-038743"],"event":{"end":"2016-05-20","place":"Copenhagen, dk","start":"2016-05-18","title":"5th International Conference on Designs for Learning 2016","year":"2016"},"filters":{"added":"2023-02","altsrc":["No Matches Found"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Grænsekrydsning","It","Learning","Transfer","Vocational training","information and communication technologies and e learning","learning educational science and teaching"],"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-UC"],"level3":{"UC":["DI-UC-AB","DI-UC-ALL","DI-UC-KP"]},"level3all":["DI-UC-AB","DI-UC-KP"]},"review":"pr","rtype":["clu"],"sorti":"challenges in designing for horizontal learning in the danish vet system in the danish vet system","src":["kp","pha"],"src-code":["DI-UC-AB","DI-UC-KP"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-SA","type":"rem","url":"https://www.designsforlearning2016.aau.dk/digitalAssets/198/198492_dfl_short-papers-final-2.pdf","version":"Published Version"},"id":"S02-087.84-038743","ids":["kp-3cc6eeb9-c30f-4b84-993b-ee39e5485472","pha-6d66fe28-7ede-409c-b679-39d384139aae"],"keyword":["grænsekrydsning","information and communication technologies and e-learning","it","learning","learning, educational science and teaching","transfer","vocational training"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-2-9DCDE7A459FF8F75B37012345EEDC3E1"],"oa_link":[{"access":"oa","license":"CC BY-NC-SA","type":"rem","url":"https://www.designsforlearning2016.aau.dk/digitalAssets/198/198492_dfl_short-papers-final-2.pdf","version":"Published Version"},{"access":"oa","type":"rem","url":"http://www.designsforlearning2016.aau.dk/digitalAssets/198/198492_dfl_short-papers-final-2.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"kp university college copenhagen","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-KP","l3nl":"KP","l3nn":"KP University College Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KP University College Copenhagen","namevar":["Københavns Professionshøjskole, Nationalt center for Erhvervspædagogik, Nationalt center for Erhvervspædagogik"],"nora_code":"DI-UC-KP","used":1},{"affno":"2","key":"university college absalon","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-AB","l3nl":"University College Absalon","l3nn":"University College Absalon","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"University College Absalon","namevar":["Professionshøjskolen Absalon, Direktionen - Slagelse, Professionshøjskoledirektør, Digital - Slagelse"],"nora_code":"DI-UC-AB","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Marianne","key":"riispau","last":"Riis","locid":"bf6f17db-5187-481d-af30-839922786263","name":"Riis, Marianne","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Palle","key":"bergstedtpau","last":"Bergstedt","locid":"39917d20-a3b9-4b83-8e82-df4f165e2a1d","name":"Bergstedt, Palle","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Claus Bo","key":"jørgensenpau","last":"Jørgensen","locid":"7f3e7e6c-a79a-4412-8f3c-72804b4d1017","name":"Jørgensen, Claus Bo","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hans Henrik","key":"kochpau","last":"Koch","locid":"8c4294fe-9e1c-4868-bc6d-d466413b5617","name":"Koch, Hans Henrik","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Carsten Lund","key":"rasmussenpau","last":"Rasmussen","locid":"d0364b63-ec70-4a5b-882f-80ae68506ea0","name":"Rasmussen, Carsten Lund","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All University Colleges","DI-ALL","DI-UC","DI-UC-ALL","KP","University College Absalon","University Colleges"],"PST":["Published"]},"sid":["kp-3cc6eeb9-c30f-4b84-993b-ee39e5485472","pha-6d66fe28-7ede-409c-b679-39d384139aae"],"src":["AB University College Absalon","KP University College Copenhagen"],"title":"Challenges in designing for horizontal learning in the Danish VET system : in the Danish VET system","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-087.84-038743","year":"2016","yearsub":"2016"}
{"abstract":"BACKGROUND: The early phases of psychosis have been hypothesized to constitute a critical period, a window of opportunity. At the same time, the early phases of psychosis are associated with increased risk of unwanted outcome, such as suicidal behaviour and social isolation. This was the background for the emergence of early intervention services, and in Denmark, the OPUS trial was initiated as part of that process. METHODS: Modified assertive community treatment, together with family involvement and social skills training, constituted the core elements in the original programme. A total of 547 patients with first-episode psychosis were included in the trial. RESULTS: To summarize briefly the results of the OPUS trial: the OPUS treatment was superior to standard treatment in reducing psychotic and negative symptoms and substance abuse, in increasing user satisfaction and adherence to treatment, and in reducing use of bed days and days in supported housing. Moreover, relatives included in the OPUS treatment were less strained and had a higher level of knowledge about schizophrenia and higher user satisfaction. DISCUSSION: The OPUS treatment was implemented throughout Denmark. Training courses were developed and manuals and books were published. Regional health authorities had access to national grants for implementing early intervention services; as a result, OPUS teams were disseminated throughout the country. The content of the treatment is now further developed, and new elements are being tried out - such as individual placement and support, lifestyle changes, cognitive remediation, specialized treatment for substance abuse and different kinds of user involvement.","author_count":10,"contributors":["Nordentoft, Merete","Melau, Marianne","Iversen, Tina","Petersen, Lone","Jeppesen, Pia","Thorup, Anne Amalie Elgaard","Bertelsen, Mette","Hjorthøj, Carsten","Hastrup, Lene Halling","Jørgensen, Per"],"cuid":["S01-000.00-443722"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Adolescent","Adult","Combined Modality Therapy","Community Mental Health Services","Denmark","Early Medical Intervention","Family Therapy","Female","Humans","Male","Middle Aged","Patient Satisfaction","Program Development","Psychotic Disorders","Young Adult"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"from research to practice how opus treatment was accepted and implemented throughout denmark","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-443722","identifier":[{"id":"84924595218","type":"scopus"},{"id":"24304658","type":"pmid"}],"ids":["ku-543992f4-8807-4a1b-9c84-02df5adf9782"],"keyword":["Adolescent","Adult","Combined Modality Therapy","Community Mental Health Services","Denmark","Early Medical Intervention","Family Therapy","Female","Humans","Male","Middle Aged","Patient Satisfaction","Program Development","Psychotic Disorders","Young Adult"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-38C92DD84951D7A8AEB6D5E9D63A62CD"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Merete","key":"nordentoftpau","last":"Nordentoft","locid":"6d0fe19c-7c81-463b-8bc8-822d71584b69","name":"Nordentoft, Merete","rank":1,"rolecode":"pau"},{"affno":"1","first":"Marianne","key":"melaupau","last":"Melau","locid":"5511f69d-ba61-4d08-abb4-7be184a910a3","name":"Melau, Marianne","rank":2,"rolecode":"pau"},{"affno":"","first":"Tina","key":"iversenpau","last":"Iversen","name":"Iversen, Tina","rank":3,"rolecode":"pau"},{"affno":"","first":"Lone","key":"petersenpau","last":"Petersen","name":"Petersen, Lone","rank":4,"rolecode":"pau"},{"affno":"1","first":"Pia","key":"jeppesenpau","last":"Jeppesen","locid":"2a1a09ff-cac8-4162-ab6f-ff07e9d1656f","name":"Jeppesen, Pia","rank":5,"rolecode":"pau"},{"affno":"1","first":"Anne","key":"thoruppau","last":"Thorup","locid":"c70ccbcc-b880-4352-919d-08595d91ed2b","name":"Thorup, Anne Amalie Elgaard","name_org":"Thorup, Anne","rank":6,"rolecode":"pau"},{"affno":"","first":"Mette","key":"bertelsenpau","last":"Bertelsen","name":"Bertelsen, Mette","rank":7,"rolecode":"pau"},{"affno":"1","first":"Carsten Rygaard","key":"hjorthøjpau","last":"Hjorthøj","locid":"d4b636e3-7c21-48a0-b812-de219ca78a9e","name":"Hjorthøj, Carsten","name_org":"Hjorthøj, Carsten Rygaard","rank":8,"rolecode":"pau"},{"affno":"","first":"Lene Halling","key":"hastruppau","last":"Hastrup","name":"Hastrup, Lene Halling","rank":9,"rolecode":"pau"},{"affno":"","first":"Per","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, Per","rank":10,"rolecode":"pau"}],"pmid":["24304658"],"pub":{"doi":"10.1111/eip.12108","issn":["17517885","17517893"],"issn_org":["17517885"],"issue":"2","journal":"Early Intervention in Psychiatry","pages":"156-162","status":"p","title":"Early Intervention in Psychiatry","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-84924595218"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-543992f4-8807-4a1b-9c84-02df5adf9782"],"src":["KU University of Copenhagen"],"title":"From research to practice : how OPUS treatment was accepted and implemented throughout Denmark","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-443722","year":"2015","yearsub":"2015"}
{"abstract":"Background: Lumbar disc herniation (LDH) is associated with great morbidity and significant socio-economic impact in many parts of the world. Studies have shown that most LDH can be treated effectively with conservative management and the passage of time. However for the group of patients where pain and disability is unacceptable, surgical intervention provides effective clinical relief in many cases. Currently there is little consensus in the medical community on the timing of surgery for patients suffering from radicular pain due to LDH. Reports based on the SPORT database indicate that prolonged symptom-duration correlates with inferior outcome. Purpose / Aim of Study: The aim of this study is to evaluate if prolonged symptom-duration is correlated with less favorable outcome following surgery for LDH in a Single- Center Study. Materials and Methods: 832 patients with first-time LDH were included in a Single-Center Study. Data were prospectively collected in DaneSpine, the Danish National Spine Register. The patient reported outcome measures (PROM) EQ5D, SF36, ODI, VAS-leg and -back were correlated with duration of symptoms. Findings / Results: 832 patients were included in the study, with complete one-year follow-up on 664 patients (80%) and a reoperation rate of 6%. The duration of symptoms have a negative correlation on all patient related outcome measures. Conclusions: Delayed surgical intervention results in inferior patient related outcome. Our results indicate that patients operated within the first 3 months of leg-pain achieve best outcome.","author_count":6,"contributors":["Stoettrup, Christian Christensen","Ernst, Carsten","Clemmensen, Dorte","Isenbjerg-Jørgensen, Alexander","Holm, Randi","Andersen, Mikkel Østerheden"],"cuid":["S01-000.00-597065"],"event":{"end":"2014-10-24","place":"København, dk","start":"2014-10-22","title":"Dansk Ortopædisk Selskab Årskongres","year":"2014"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-SDR","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"is the surgical outcome for lumbar disc herniation related to the duration of symptoms","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://www.ortopaedi.dk/k14/session11.html","version":"Other Version"},"id":"S01-000.00-597065","ids":["sdu-532ab6d1-1242-45ed-8dbc-45d8b50843f8"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-A8E2446458A7DEDF9993011A06E4BFA4"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.ortopaedi.dk/k14/session11.html","version":"Other Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Regional Health Research","SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Lillebælt Hospital","SDU, The Faculty of Health Sciences, Department of Regional Health Research, Spine Center of Southern Denmark"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Sygehus Lillebælt"],"nora_code":"DI-HO-SDR","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Christian","key":"støttruppau","last":"Støttrup","locid":"c795977b-f92b-4ded-9daf-