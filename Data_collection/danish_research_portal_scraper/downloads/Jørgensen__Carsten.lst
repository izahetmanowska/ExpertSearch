d":1}],"person":[{"affno":"1","first":"Zizhang","key":"lizizhangpau","last":"Li","locid":"a470deab-a3da-4c0f-a882-83026248cbad","name":"Li, Zizhang","rank":1,"rolecode":"pau"},{"affno":"2","first":"Valeria","key":"velásquezzapatavaleriapau","last":"Velásquez-Zapata","name":"Velásquez-Zapata, Valeria","rank":2,"rolecode":"pau"},{"affno":"2","first":"J. Mitch","key":"elmorejmitchpau","last":"Elmore","name":"Elmore, J. Mitch","rank":3,"rolecode":"pau"},{"affno":"1","first":"Xuan","key":"lixuanpau","last":"Li","locid":"2b8054a3-f72e-4c23-9da5-c547c75ebb07","name":"Li, Xuan","rank":4,"rolecode":"pau"},{"affno":"1","first":"Wenjun","key":"xiewenjunpau","last":"Xie","locid":"2575d7cd-b9f4-4383-a34f-d1d98c7284a8","name":"Xie, Wenjun","orcid":"0000-0001-8101-5519","rank":5,"rolecode":"pau"},{"affno":"2","first":"Sagnik","key":"banerjeesagnikpau","last":"Banerjee","name":"Banerjee, Sagnik","rank":6,"rolecode":"pau"},{"affno":"1","first":"Hans J. L.","key":"jørgensenhansjørgenlyngspau","last":"Jørgensen","locid":"1b3f39b0-a166-4a0c-96ea-e6c3dd0de338","name":"Jørgensen, Hans Jørgen Lyngs","name_org":"Jørgensen, Hans J. L.","orcid":"0000-0002-5902-6550","rank":7,"rolecode":"pau"},{"affno":"1","first":"Carsten","key":"pedersencarstenpau","last":"Pedersen","locid":"7750ab11-4cc4-4421-8073-4a339254a400","name":"Pedersen, Carsten","orcid":"0000-0002-9520-2232","rank":8,"rolecode":"pau"},{"affno":"2","first":"Roger P.","key":"wiserogerppau","last":"Wise","name":"Wise, Roger P.","rank":9,"rolecode":"pau"},{"affno":"1","first":"Hans","key":"thordalchristensenhanspau","last":"Thordal-Christensen","locid":"3e904207-07a2-412e-969f-3272f1fe12c5","name":"Thordal-Christensen, Hans","orcid":"0000-0001-8813-0157","rank":10,"rolecode":"pau"}],"pub":{"doi":"10.1101/2022.04.27.489729","pages":"35","publisher":"Cold Spring Harbor Laboratory","series":"bioRxiv","status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-74093fde-9ad5-4498-8a07-c57ada2c54f0"],"src":["KU University of Copenhagen"],"title":"Powdery mildew effectors AVR<sub>A1</sub> and BEC1016 target the ER J-domain protein <i>Hv</i>ERdj3B required for immunity in barley","type":"Working Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-462830","year":"2022","yearsub":"2022"}
{"abstract":"Objective To determine levels of objectively measured physical activity (PA) and the proportion of adults with multimorbidity that adheres to PA guidelines. Methods All studies, where PA was measured at baseline using an activity monitor in an adult (≥18 years) multimorbid (≥80% of the population had ≥2 chronic conditions) population. A systematic literature search was performed in Medline, EMBASE, CINAHL, CENTRAL, ClinicalTrials.gov, opengrey.eu and google.com from inception up until 18th of January 2022. Risk of bias was assessed with a modified version of the Quality Assessment Tool for Quantitative Studies. A random-effects meta-analyses was performed to estimate daily minutes of sedentary behavior (SB), light PA (LPA), moderate PA (MPA), moderate to vigorous PA (MVPA) and steps. Proportions adhering to PA guidelines was narratively synthesized. Certainty of evidence was determined using The Grading of Recommendations Assessment, Development and Evaluation (GRADE) approach. Results Fifteen studies (2,172 participants) were included. The most frequent combination of conditions were type 2 diabetes and hypertension (six studies). Participants spent a daily average of 500.5 (95% CI: 407.1 to 593.9) minutes in SB, 325.6 (95% CI: 246.4 to 404.7 minutes in LPA and 32.7 (95% CI: 20.2 to 45.3) minutes in MVPA. The mean daily number of steps was 5,145 (95% CI: 4264 to 6026) for people in free-living conditions. The proportion adhering to PA guidelines ranged widely (7.4% to 43%). All studies were rated as at high risk of bias and the certainty of evidence was very low. Conclusions PA levels and adherence varied from low to above guideline recommended levels for adults with chronic conditions, depending on PA intensity. The very low certainty of evidence calls for high quality studies focusing on detailed descriptions of PA behavior in people with multimorbidity. PROSPERO registration number CRD42020172456.","author_count":9,"contributors":["Jørgensen, Lars Bo","Bricca, Alessio","Bernhardt, Anna","Juhl, Carsten Bogh","Tang, Lars Hermann","Mortensen, Sofie Rath","Eriksen, Jonas Ahler","Walløe, Sisse","Skou, Søren Thorgaard"],"cuid":["S01-000.00-636504"],"filters":{"added":"2022-11","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Jørgensen, Lars Bo"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-ZEA"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-ZEA","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"objectively measured physical activity levels and adherence to physical activity guidelines in people with multimorbidity a systematic review and meta analysis","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pone.0274846","version":"Published Version"},"id":"S01-000.00-636504","identifier":[{"id":"85139804069","type":"scopus"},{"id":"36223336","type":"pmid"},{"id":"PMC9555650","type":"pmcid"}],"ids":["sdu-dd109ce2-2dfd-48b6-b29f-9a7421e5ccb3"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-63809B8EF84F725E3586996E08154325"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/210881416/journal.pone.0274846.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pone.0274846","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics, Center for Muscle and Joint Health","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics, Research Unit of Musculoskeletal Function and Physiotherapy"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Næstved-Slagelse-Ringsted Hospitals"],"nora_code":"DI-HO-ZEA","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Lars Bo","key":"jørgensenpau","last":"Jørgensen","locid":"efda4647-bcf0-407c-95b8-1280ab6b219d","name":"Jørgensen, Lars Bo","orcid":"0000-0002-8573-9407","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Alessio","key":"briccapau","last":"Bricca","locid":"e7736cc1-110b-48ad-bd5f-eefa5e5fcaf6","name":"Bricca, Alessio","orcid":"0000-0001-9717-918X","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Anna","key":"bernhardtpau","last":"Bernhardt","name":"Bernhardt, Anna","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Carsten B.","key":"juhlpau","last":"Juhl","locid":"9381fad1-5721-4b98-ac99-7df1c6e4d837","name":"Juhl, Carsten Bogh","name_org":"Juhl, Carsten B.","orcid":"0000-0001-8456-5364","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars Hermann","key":"tangpau","last":"Tang","locid":"c847c05b-1b9e-489f-a928-7f24d665966d","name":"Tang, Lars Hermann","orcid":"0000-0001-6055-8696","rank":5,"rolecode":"pau"},{"affno":"2 1","corresponding":null,"first":"Sofie Rath","key":"mortensenpau","last":"Mortensen","locid":"ce405612-8eed-42e1-9ba3-63ca26241605","name":"Mortensen, Sofie Rath","orcid":"0000-0002-9550-1507","rank":6,"rolecode":"pa