":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-00370ce0-e816-47f4-acce-94dd67f51ca9"],"src":["AU Aarhus University"],"title":"Hvilken effekt er der af specifik udspænding ved behandling af fasciitis plantaris?","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-129426","year":"2011","yearsub":"2011"}
{"abstract":"OBJECTIVE: To investigate the biomechanical, histological and biochemical properties of rabbit urethra at long-term follow up after hypospadias simulation and acute repair. MATERIALS AND METHODS: Thirty-eight white New Zealand male rabbits underwent experimental creation of a hypospadias-like defect and acute repair (mobilization and advancement, tubularized incised posterior urethral plate (TIP), modified TIP) and sham operation. After 23 weeks all groups + controls underwent biomechanical, histological and biochemical assessments. RESULTS: The mobilization and advancement group showed a higher stiffness compared to the TIP groups (P < 0.05) in the posterior urethra, whereas the TIP group was stiffer compared to the other two operative groups (P < 0.001) in the ventral urethra. In the dorsal urethra, the mobilization and advancement group and the modified TIP group had a higher collagen content compared to shams (P < 0.05). No differences in collagen content were found between groups in the ventral urethra. A correlation between acoustic and histological layers was found, partially related to collagen content. CONCLUSION: The urethras had different microelastic properties in different layers of the dorsal and ventral urethra, with higher stiffness in the connective tissue layers surrounding and within the urethra. The repaired urethras had partially recovered their elasticity at micrometer resolution at long-term follow up. Scanning acoustic microscopy elucidated structure-function relationships at microscopic level in normal and operated urethra.","author_count":5,"contributors":["Lalla, Marianna","Riis, Carsten","Jørgensen, Claus Schiøtt","Danielsen, Carl Christian","Jørgensen, Troels Munch"],"cuid":["S01-000.00-173500"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"a biomechanical histological and biochemical study in an experimental rabbit hypospadias repair model using scanning acoustic microscopy","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.jpurol.2010.07.011","version":"Other Version"},"id":"S01-000.00-173500","identifier":[{"id":"20724215","type":"pmid"},{"id":"79958789842","type":"scopus"}],"ids":["au-4d9356f0-ed81-11df-a891-000ea68e967b"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-2-F779052534A123BB1ECCF3D95C4A834B"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.jpurol.2010.07.011","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus University, Faculty of Health Sciences, The Department of Urology K"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Marianna","key":"lallamariannapau","last":"Lalla","locid":"edebaf95-6cb7-401b-96ed-f2f3eec0d477","name":"Lalla, Marianna","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Carsten","key":"riiscarstenpau","last":"Riis","locid":"3bb38217-99a5-49dc-bdf5-f341a6f62759","name":"Riis, Carsten","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Claus Schiøtt","key":"jørgensenclausschiøttpau","last":"Jørgensen","name":"Jørgensen, Claus Schiøtt","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Carl Christian","key":"danielsencarlchristianpau","last":"Danielsen","locid":"63841894-894a-4c92-bf3f-f63446e791db","name":"Danielsen, Carl Christian","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Troels Munch","key":"jørgensentroelsmunchpau","last":"Jørgensen","locid":"6157bbf4-e07a-4ce2-b636-f7decd71b3ee","name":"Jørgensen, Troels Munch","rank":5,"rolecode":"pau"}],"pmid":["20724215"],"pub":{"doi":"10.1016/j.jpurol.2010.07.011","issn":["14775131","18734898"],"issn_org":["14775131"],"issue":"4","journal":"Journal of Pediatric Urology","pages":"404-411","publisher":"Elsevier Ltd","status":"p","title":"Journal of Pediatric Urology","volume":"7"},"review":"Peer Reviewed","scoID":["2-s2.0-79958789842"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-4d9356f0-ed81-11df-a891-000ea68e967b"],"src":["AU Aarhus University"],"title":"A biomechanical, histological and biochemical study in an experimental rabbit hypospadias repair model using scanning acoustic microscopy","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-173500","year":"2011","yearsub":"2011"}
{"abstract":"Erythropoietin (Epo) is produced primarily in the kidneys upon low blood oxygen availability and stimulates erythropoiesis in the bone marrow. Recombinant human Epo (rHuEpo), a drug developed to increase arterial oxygen content in patients, is also illicitly used by athletes to improve their endurance performance. Therefore, a robust and sensitive test to detect its abuse is needed. The aim of the present study was to investigate potential human serum biomarkers of Epo abuse employing a proteomic approach. Eight healthy male subjects were injected subcutaneously with rHuEpo (5,000 IU) every second day for a 16-day period. Serum was collected before starting the treatment regime and again at days 8 and 16 during the treatment period. Samples were homogenized and proteins separated by two-dimensional gel electrophoresis (2DE). Spots that changed significantly in response to rHuEpo treatment were identified by mass spectrometry. Both the number of reticulocytes and erythrocytes increased throughout the study, leading to a significant increase in hematocrit and hemoglobin content. In addition, transferrin levels increased but the percentage of iron bound to transferrin and ferritin levels decreased. Out of 97 serum proteins, seven were found to decrease significantly at day 16 compared with pre-Epo administration, and were identified as four isoforms of haptoglobin, two isoforms of transferrin, and a mixture of hemopexin and albumin. In support, total serum haptoglobin levels were found to be significantly decreased at both days 8 and 16. Thus a 2DE proteomic approach for discovery of novel markers of Epo action appears feasible.","author_count":7,"contributors":["Christensen, Britt","Sackmann-Sala, Lucila","Cruz-Topete, Diana","Jørgensen, Jens Otto Lunde","Jessen, Niels","Lundby, Carsten","Kopchick, John J"],"cuid":["S01-000.00-239034"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Adult","Blood Proteins","Doping in Sports","Erythropoietin","Humans","Male","Proteome","Reproducibility of Results","Sensitivity and Specificity","Substance Abuse Detection"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"novel serum biomarkers for erythropoietin use in humans a proteomic approach","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1152/japplphysiol.00665.2010","version":"Other Version"},"id":"S01-000.00-239034","identifier":[{"id":"20966191","type":"pmid"},{"id":"PMC3785117","type":"pmcid"},{"id":"79251472781","type":"scopus"}],"ids":["au-c03d9442-277b-4716-9225-9cd3d29b3d44"],"keyword":["Adult","Blood Proteins","Doping in Sports","Erythropoietin","Humans","Male","Performance-Enhancing Substances","Proteome","Reproducibility of Results","Sensitivity and Specificity","Substance Abuse Detection"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-2-E28A614236A37C5FD5496FA02B651D40"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1152/japplphysiol.00665.2010","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Endocrinology and Internal Medicine"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Britt","key":"christensenpau","last":"Christensen","locid":"818501d4-b691-497c-b25b-b792b1040bc0","name":"Christensen, Britt","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Lucila","key":"sackmannsalapau","last":"Sackmann-Sala","name":"Sackmann-Sala, Lucila","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Diana","key":"cruztopetepau","last":"Cruz-Topete","name":"Cruz-Topete, Diana","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens Otto L","key":"jørgensenpau","last":"Jørgensen","locid":"303ebe86-6861-4b19-b4d7-6bda0526b27e","name":"Jørgensen, Jens Otto Lunde","name_org":"Jørgensen, Jens Otto L","orcid":"0000-0001-7408-1526","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Niels","key":"jessenpau","last":"Jessen","locid":"f0d20e5e-d5b5-44da-980e-3e052af18b46","name":"Jessen, Niels","orcid":"0000-0001-5613-7274","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Carsten","key":"lundbypau","last":"Lundby","locid":"ba98d25b-d9f0-40e3-8bdd-d62dfdc92e29","name":"Lundby, Carsten","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"John J","key":"kopchickpau","last":"Kopchick","name":"Kopchick, John J","rank":7,"rolecode":"pau"}],"pmid":["20966191"],"pub":{"doi":"10.1152/japplphysiol.00665.2010","issn":["15221601","87507587"],"issn_org":["87507587"],"issue":"1","journal":"Journal of Applied Physiology","pages":"149-56","publisher":"American Physiological Society","status":"p","title":"Journal of Applied Physiology","volume":"110"},"review":"Peer Reviewed","scoID":["2-s2.0-79251472781"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-c03d9442-277b-4716-9225-9cd3d29b3d44"],"src":["AU Aarhus University"],"title":"Novel serum biomarkers for erythropoietin use in humans : a proteomic approach","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-239034","year":"2011","yearsub":"2011"}
