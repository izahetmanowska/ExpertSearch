":8,"rolecode":"pau"},{"affno":"9 10 11","corresponding":null,"first":"Elon H.C.","key":"vandijkpau","last":"van Dijk","name":"van Dijk, Elon H.C.","rank":9,"rolecode":"pau"},{"affno":"1 12","corresponding":null,"first":"Carsten","key":"faberpau","last":"Faber","name":"Faber, Carsten","rank":10,"rolecode":"pau"},{"affno":"2 13 14","corresponding":null,"first":"Jakob","key":"grauslundpau","last":"Grauslund","name":"Grauslund, Jakob","rank":11,"rolecode":"pau"},{"affno":"1 12","corresponding":null,"first":"Javad N.","key":"hajaripau","last":"Hajari","name":"Hajari, Javad N.","rank":12,"rolecode":"pau"},{"affno":"4 15","corresponding":null,"first":"Josef","key":"huemerpau","last":"Huemer","name":"Huemer, Josef","rank":13,"rolecode":"pau"},{"affno":"1 12","corresponding":null,"first":"Oliver N.","key":"klefterpau","last":"Klefter","name":"Klefter, Oliver N.","rank":14,"rolecode":"pau"},{"affno":"1 12 16","corresponding":null,"first":"Marie","key":"kroghnielsenpau","last":"Krogh Nielsen","name":"Krogh Nielsen, Marie","rank":15,"rolecode":"pau"},{"affno":"17 18","corresponding":null,"first":"M. Cem","key":"sabanerpau","last":"Sabaner","name":"Sabaner, M. Cem","rank":16,"rolecode":"pau"},{"affno":"1 19","corresponding":null,"first":"Miklos","key":"schneiderpau","last":"Schneider","name":"Schneider, Miklos","rank":17,"rolecode":"pau"},{"affno":"1 12 13","corresponding":null,"first":"Yousif","key":"subhipau","last":"Subhi","name":"Subhi, Yousif","rank":18,"rolecode":"pau"}],"pub":{"doi":"10.1111/aos.17506","issn":["1755375X","17553768"],"issn_org":["1755375X"],"journal":"Acta Ophthalmologica","publisher":"Wiley","status":"e","title":"Acta Ophthalmologica"},"review":"Peer Reviewed","scoID":["2-s2.0-105002634435"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["E-Published (ahead of print)"]},"sid":["aau-9647b950-f9a9-40e2-92d0-12bc60d2a4b2"],"src":["AAU Aalborg University"],"title":"Comparative efficacy of intravitreal anti-VEGF therapy for neovascular age-related macular degeneration : A systematic review with network meta-analysis","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-823788","year":"2025","yearsub":"2025"}
{"abstract":"Contemporary models conceptualize personality disorder (PD) as a combination of personality dysfunction and pathological personality traits. However, some perspectives suggest that pathological traits, along with functional impairment, may be sufficient indicators of PD. This study builds on previous research by investigating whether identity disturbance, defined as impaired coherence, inconsistency, and discontinuity in the sense of self, contributes to pathological personality trait scores beyond basic five-factor personality traits. Additionally, it examines whether the associations between pathological personality trait domains, PD diagnosis, and functional impairment remain when controlling for identity disturbance and basic personality traits. The study included two samples: 776 community individuals (344 with a psychiatric history) and 77 psychiatric patients diagnosed with PD. Structural equation models with latent factors indicated that pathological personality trait domains can be described as a combination of variance from basic personality traits and to a lesser extent identity disturbance. When identity disturbance was controlled for, however, pathological trait domains no longer differentiated individuals with PD from community participants with psychiatric histories. Furthermore, individual pathological trait domains did not demonstrate incremental validity in predicting functional impairment beyond the contributions of basic personality traits and identity disturbance.","author_count":8,"contributors":["Kiel, Lennart","Lind, Majse","Bo, Sune","Jørgensen, Carsten René","Boye, Rikke","Frederiksen, Christina","Spindler, Helle"],"cuid":["S02-095.83-803866"],"filters":{"added":"2025-06","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Kiel, Lennart"],"keyword":["Functional impairment","Identity","Pathological Traits","Personality disorder","Personality traits"],"level":"sci","mra":["hum","soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR","DI-HO-NDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-HO-CDR","DI-HO-NDR","DI-U-AAU","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"associations between pathological personality traits functional impairment and personality disorder controlling for basic personality traits and identity disturbance","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/771625439/Kiel_et_al._2025_.pdf","version":"Authors Final Version"},"id":"S02-095.83-803866","identifier":[{"id":"105001824274","type":"scopus"},{"id":"40111793","type":"pmid"}],"ids":["aau-ecc6ad23-7b7a-401f-9b26-c6743c307fda","au-026e13c7-a0a2-4814-ad8f-26bbb51f5bf8"],"keyword":["functional impairment","identity","pathological traits","personality disorder","personality traits"],"lang":"English","level":"Scientific","mra":["Humanities","Social Science"],"noi":["Global-Local-2-4-BD39A3435DD57AFD98D913301CDEA07B"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/771625439/Kiel_et_al._2025_.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus BSS, Department of Psychology and Behavioural Sciences"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Social Sciences and Humanities","Aalborg Univer