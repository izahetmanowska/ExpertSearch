{"author_count":3,"contributors":["Daugaard, Carsten","Jørgensen, Chris Vigandt","Pedersen, Ellen Raben"],"cuid":["S01-000.00-588910"],"event":{"end":"2012-03-31","place":"Boston, us","start":"2012-03-28","title":"AudiologyNOW! 2012","year":"2012"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["DELTA Technical-Audiological Laboratory"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"nr","rtype":["clu"],"sorti":"speech tests as an outcome measure","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dco","type-grp":["all","pub"]},"id":"S01-000.00-588910","ids":["sdu-36ff0328-3033-4483-8a05-538cb3be72bb"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-1A57DD49EA38E56A74EF85F9D3F49942"],"org":[{"affno":"1","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["DELTA Technical-Audiological Laboratory"],"nora_code":"DI-OT","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Engineering, The Maersk Mc-Kinney Moller Institute"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Carsten","key":"daugaardpau","last":"Daugaard","name":"Daugaard, Carsten","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Chris Vigandt","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, Chris Vigandt","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ellen Raben","key":"pedersenpau","last":"Pedersen","locid":"b7a104b3-f660-4af6-a5eb-aa39f455e89f","name":"Pedersen, Ellen Raben","orcid":"0000-0001-9917-9837","rank":3,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-36ff0328-3033-4483-8a05-538cb3be72bb"],"src":["SDU University of Southern Denmark"],"title":"Speech Tests as an Outcome Measure","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-588910","year":"2012","yearsub":"2012"}
{"abstract":"Background: Erythropoietin receptors have been identified in human skeletal muscle tissue, but downstream signal transduction has not been investigated. We therefore studied in vivo effects of systemic erythropoietin exposure in human skeletal muscle. Methodology/Principal Findings: The protocols involved 1) acute effects of a single bolus injection of erythropoietin followed by consecutive muscle biopsies for 1-10 hours, and 2) a separate study with prolonged administration for 16 days with biopsies obtained before and after. The presence of erythropoietin receptors in muscle tissue as well as activation of Epo signalling pathways (STAT5, MAPK, Akt, IKK) were analysed by western blotting. Changes in muscle protein profiles after prolonged erythropoietin treatment were evaluated by 2D gel-electrophoresis and mass spectrometry. The presence of the erythropoietin receptor in skeletal muscle was confirmed, by the M20 but not the C20 antibody. However, no significant changes in phosphorylation of the Epo-R, STAT5, MAPK, Akt, Lyn, IKK, and p70S6K after erythropoietin administration were detected. The level of 8 protein spots were significantly altered after 16 days of rHuEpo treatment; one isoform of myosin light chain 3 and one of desmin/actin were decreased, while three isoforms of creatine kinase and two of glyceraldehyd-3-phosphate dehydrogenase were increased. Conclusions/Significance: Acute exposure to recombinant human erythropoietin is not associated by detectable activation of the Epo-R or downstream signalling targets in human skeletal muscle in the resting situation, whereas more prolonged exposure induces significant changes in the skeletal muscle proteome. The absence of functional Epo receptor activity in human skeletal muscle indicates that the long-term effects are indirect and probably related to an increased oxidative capacity in this tissue.","author_count":13,"contributors":["Christensen, Britt","Lundby, Carsten","Jessen, Niels","Nielsen, Thomas Svava","Nielsen, Poul Vestergaard","Møller, Niels","Pilegaard, Henriette","Pedersen, Steen Bønløkke","Kopchick, John J","Jørgensen, Jens Otto Lunde"],"cuid":["S02-080.91-023022"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","Europe, Non-EU","OECD"],"country":["Switzerland","United States"],"glorg":["All Global Affiliations","Ohio University","University of Zurich"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-HO-CDR","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"evaluation of functional erythropoietin receptor status in skeletal muscle in vivo acute and prolonged studies in healthy human subjects","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1371/journal.pone.0031857","version":"Published Version"},"id":"S02-080.91-023022","identifier":[{"id":"PMC3285196","type":"pmcid"},{"id":"84857469947","type":"scopus"},{"id":"22384088","type":"pmid"}],"ids":["au-8e21126d-9cb1-4307-aebe-f0a4f00c9de5","ku-9b7b8794-9b5b-4120-9116-5c5de99f1ac2"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-64C215E2BB9CDBE5E6F8DE270818810A"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.au.dk/ws/files/51307380/journal.pone.0031857_1_.pdf","version":"Pre-print"},{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/41991699/journal.pone.0031857.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1371/journal.pone.0031857","version":"Published Version"},{"access":"oa","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/P