67-82c2-0ce170b114e2","name":"Bekker-Jensen, Simon","orcid":"0000-0002-7308-4597","rank":12,"rolecode":"pau"},{"affno":"3","first":"Marta","key":"montespau","last":"Montes","locid":"cc01dcf3-677a-423b-b173-a45d22b429a9","name":"Montes, Marta","orcid":"0000-0003-1223-8385","rank":13,"rolecode":"pau"},{"affno":"1","first":"Panagiotis","key":"galanospau","last":"Galanos","name":"Galanos, Panagiotis","rank":14,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Nils","key":"faergemanpau","last":"Faergeman","locid":"448a164d-523a-4d91-923c-fc5536371b95","name":"Færgeman, Nils J.","name_org":"Faergeman, Nils","orcid":"0000-0002-9281-5287","rank":15,"rolecode":"pau"},{"affno":"6","first":"Lotta","key":"happonenpau","last":"Happonen","name":"Happonen, Lotta","rank":16,"rolecode":"pau"},{"affno":"1 3","first":"Lisa B.","key":"frankelpau","last":"Frankel","locid":"cd17c4a8-f607-4c71-9c77-b5c5365ee10f","name":"Frankel, Lisa B.","rank":17,"rolecode":"pau"}],"pmid":["37930887"],"pub":{"doi":"10.1016/j.celrep.2023.113381","issn":["22111247"],"issue":"11","journal":"Cell Reports","paperid":"113381","publisher":"Cell Press","status":"p","title":"Cell Reports","volume":"42"},"review":"Peer Reviewed","scoID":["2-s2.0-85175818246"],"search":{"DAF":["All Danish Affiliations","All Non-Profit Organisations","All Universities","DI-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Non-Profit Organisations","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-414b15d9-d030-4f82-8196-dcf51d3de62a","sdu-087981f0-a301-4693-9c33-636d02270ee5"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Autophagy-mediated control of ribosome homeostasis in oncogene-induced senescence","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-704561","year":"2023","yearsub":"2023"}
{"abstract":"Enhanced secretion of glucagon-like peptide-1 (GLP-1) seems to be essential for improved postprandial β-cell function after Roux-en-Y gastric bypass (RYGB) but is less studied after sleeve gastrectomy (SG). Moreover, the role of the other major incretin hormone, glucose-dependent insulinotropic polypeptide (GIP), is relatively unexplored after bariatric surgery. We studied the effects of separate and combined GLP-1 receptor (GLP-1R) and GIP receptor (GIPR) blockade during mixed meal tests in unoperated (CON), SG-operated, and RYGB-operated people with no history of diabetes. Postprandial GLP-1 concentrations were highest after RYGB but also higher after SG compared with CON. In contrast, postprandial GIP concentrations were lowest after RYGB. The effect of GLP-1R versus GIPR blockade differed between groups. GLP-1R blockade reduced β-cell glucose sensitivity and increased or tended to increase postprandial glucose responses in the surgical groups but had no effect in CON. GIPR blockade reduced β-cell glucose sensitivity and increased or tended to increase postprandial glucose responses in the CON and SG groups but had no effect in the RYGB group. Our results support that GIP is the most important incretin hormone in unoperated people, whereas GLP-1 and GIP are equally important after SG, and GLP-1 is the most important incretin hormone after RYGB.","author_count":14,"contributors":["Hindsø, Morten","Hedbäck, Nora","Svane, Maria S.","Møller, Andreas","Martinussen, Christoffer","Jørgensen, Nils B","Dirksen, Carsten","Gasbjerg, Lærke S.","Kristiansen, Viggo B.","Hartmann, Bolette","Rosenkilde, Mette M.","Holst, Jens Juul","Madsbad, Sten","Bojsen-Møller, Kirstine N."],"cuid":["S01-000.00-480169"],"filters":{"added":"2023-05","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the importance of endogenously secreted glp 000000000001 and gip for postprandial glucose tolerance and β cell function after roux en y gastric bypass and sleeve gastrectomy surgery","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-480169","identifier":[{"id":"000993106500005","type":"wos"},{"id":"85148678826","type":"scopus"},{"id":"36478039","type":"pmid"}],"ids":["ku-91257bb2-48c9-48a0-b723-126d20503775"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-0AD24D69B2247D6933227FBDB50A4B7E"],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Amager and Hvidovre"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Biomedical Sciences, Molecular and Translational Pharmacology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Morten","key":"hindsøpau","last":"Hindsø","name":"Hindsø, Morten","rank":1,"rolecode":"pau"},{"affno":"1","first":"Nora","key":"hedbäckpau","last":"Hedbäck","name":"Hedbäck, Nora","rank":2,"rolecode":"pau"},{"affno":"1","first":"Maria S.","key":"svanepau","last":"Svane","name":"Svane, Maria S.","rank":3,"rolecode":"pau"},{"affno":"1","first":"Andreas","key":"møllerpau","last":"Møller","name":"Møller, Andreas","rank":4,"rolecode":"pau"},{"affno":"1","first":"Christoff