"name":"Georg-August-Universität Göttingen","used":1}],"person":[{"affno":"1","corresponding":null,"first":"René","key":"jørgensenpau","last":"Jørgensen","locid":"c6486942-4a92-4101-acc5-f0cdd4ae0119","name":"Jørgensen, René","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Inge","key":"rispau","last":"Ris","locid":"71a00cb8-d588-4138-b422-084209551136","name":"Ris, Inge","orcid":"0000-0001-6623-4799","rank":2,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Carsten","key":"juhlpau","last":"Juhl","locid":"9381fad1-5721-4b98-ac99-7df1c6e4d837","name":"Juhl, Carsten Bogh","name_org":"Juhl, Carsten","orcid":"0000-0001-8456-5364","rank":3,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"first":"Deborah","key":"fallapau","last":"Falla","name":"Falla, Deborah","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Birgit","key":"juulkristensenpau","last":"Juul-Kristensen","locid":"887ddfe7-cfa6-4b72-a17d-ecf86987c5c0","name":"Juul-Kristensen, Birgit","orcid":"0000-0002-4973-8415","rank":5,"rolecode":"pau"}],"pmid":["29282073"],"pub":{"doi":"10.1186/s12891-017-1918-1","issn":["14712474"],"issue":"1","journal":"BMC Musculoskeletal Disorders","paperid":"548","publisher":"BioMed Central","status":"p","title":"BMC Musculoskeletal Disorders","volume":"18"},"review":"Peer Reviewed","scoID":["2-s2.0-85040187407"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","All University Colleges","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","Hospitals","UC SYD, University College South Denmark","Universities","University Colleges","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-104551c2-7e13-48cb-82d8-c3877e0a63ca","ucsyd-313dbbb0-1883-44de-8077-8927990d5007"],"src":["SDU University of Southern Denmark","UC SYD University College South Denmark"],"title":"Responsiveness of clinical tests for people with neck pain","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-097.96-048555","year":"2017","yearsub":"2017"}
{"abstract":"Genome-wide association studies have identified .50 common variants associated with kidney function, but these variants do not fully explain the variation in EGFR. We performed a two-stage meta-Analysis of associations between genotypes from the Illumina exome array and EGFR on the basis of serum creatinine (EGFRcrea) among participants of European ancestry fromthe CKDGen Consortium(nStage1: 111,666; nStage2: 48,343). In single-variant analyses, we identified single nucleotide polymorphisms at seven new loci associated with EGFRcrea (PPM1J, EDEM3, ACP1, SPEG, EYA4, CYP1A1, andATXN2L; PStage1,3.731027), of which most were common and annotated as nonsynonymous variants. Gene-based analysis identified associations of functional rare variants in three genes with EGFRcrea, including a novel association with the SOS Ras/Rho guanine nucleotide exchange factor 2 gene, SOS2 (P=5.431028 by sequence kernel association test). Experimental follow-up in zebrafish embryos revealed changes in glomerular gene expression and renal tubule morphology in the embryonic kidney of acp1-And sos2-knockdowns. These developmental abnormalities associated with altered blood clearance rate and heightened prevalence of edema. This study expands the number of loci associated with kidney function and identifies novel genes with potential roles in kidney formation.","author_count":55,"contributors":["Li, Man","Li, Yong","Weeks, Olivia","Mijatovic, Vladan","Teumer, Alexander","Huffman, Jennifer E","Tromp, Gerard","Fuchsberger, Christian","Gorski, Mathias","Lyytikäinen, Leo-Pekka","Nutile, Teresa","Sedaghat, Sanaz","Sorice, Rossella","Tin, Adrienne","Yang, Qiong","Ahluwalia, Tarunveer S","Arking, Dan E","Bihlmeyer, Nathan A","Böger, Carsten A","Carroll, Robert J","Chasman, Daniel I","Cornelis, Marilyn C","Dehghan, Abbas","Faul, Jessica D","Feitosa, Mary F","Gambaro, Giovanni","Gasparini, Paolo","Giulianini, Franco","Heid, Iris","Huang, Jinyan","Imboden, Medea","Jackson, Anne U","Jeff, Janina","Jhun, Min A","Katz, Ronit","Kifley, Annette","Kilpeläinen, Tuomas O","Kumar, Ashish","Laakso, Markku","Li-Gao, Ruifang","Lohman, Kurt","Grarup, Niels","Hansen, Torben","Jørgensen, Torben","Jørgensen, Marit E","Lauritzen, Torsten","Pedersen, Oluf","Schmidt, Frank","Wang, Jie Jin","Witte, Daniel R"],"cuid":["S03-098.45-022067"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"51-200 contributors","class":"merged","cluster_size":3,"continent":["Africa","America, North","Europe, EU","Europe, Non-EU","Nordic","OECD","Oceania"],"corpau":["CHARGE Blood Pressure Working Group","CHARGE Glycemic-T2D Working Group,"],"country":["Australia","Finland","Germany","Italy","South Africa","Switzerland","United States"],"glorg":["All Global Affiliations","Broad Institute","Fondazione Policlinico Universitario Agostino Gemelli IRCCS","Harvard University","Johns Hopkins University","Ludwig Maximilian University","Northwestern University","Robert Koch-Institut","Tampere University","University of Basel","University of Eastern Finland","University of Freiburg","University of Greifswald","University of Michigan","University of Regensburg","University of Stellenbosch","University of Sydney","University of Utah","Vanderbilt University","Washington University St. Louis","Westmead Hospital"],"keyword":["Animals","Exome","Genetic Loci","Genome Wide Association Study","Glomerular Filtration Rate","Human Genetics","Humans","Journal Article","Kidney","Kidney development","Meta analysis","Protein Tyrosine Phosphatases","Proto Oncogene Proteins","Renal function","Zebrafish"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-STENO"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-STENO","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"sos000000000002 and acp000000000001 loci identified through large scale exome chip analysis 