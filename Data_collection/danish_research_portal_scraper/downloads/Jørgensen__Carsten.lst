University, Arts, School of Communication and Culture, School of Communication and Culture - Scandinavian Studies"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"Louise Brix","key":"jacobsenpau","last":"Jacobsen","locid":"5a7f1ad3-4843-4147-a0f1-1cc3c1ae4552","name":"Jacobsen, Louise Brix","orcid":"0000-0003-2189-5619","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Rikke Andersen","key":"kraglundpau","last":"Kraglund","locid":"86aff6ed-5cb3-42c8-9c01-814893bae56a","name":"Kraglund, Rikke Andersen","orcid":"0009-0005-5710-1966","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Carsten","key":"stagepau","last":"Stage","locid":"143c9f12-b105-49f0-99e5-3d3a3dae7006","name":"Stage, Carsten","orcid":"0000-0002-7789-4925","rank":3,"rolecode":"pau"},{"affno":"","first":"Lasse","key":"gammelgaardpedh","last":"Gammelgaard","name":"Gammelgaard, Lasse","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Birgitte","key":"rasmussenhornbekpedh","last":"Rasmussen Hornbek","name":"Rasmussen Hornbek, Birgitte","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Henrik","key":"jørgensenpedh","last":"Jørgensen","name":"Jørgensen, Henrik","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Lis","key":"noruppedh","last":"Norup","name":"Norup, Lis","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9788793358225"],"pages":"317-330","publisher":"Forlaget Spring","status":"p","subtitle":"æstetisk, sprogligt, kulturelt","title":"Gaden"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-3ca62b17-adde-4d1f-a4a3-b3d00881dd2c","au-829f5bdf-924e-4f5f-99e2-cc83ea1637b3"],"src":["AAU Aalborg U