first":"Jonas Svenstrup","key":"sverregaardjonassvenstruppau","last":"Sverregaard","name":"Sverregaard, Jonas Svenstrup","rank":34,"rolecode":"pau"},{"affno":"","first":"Rie","key":"troelsenriepau","last":"Troelsen","name":"Troelsen, Rie","rank":35,"rolecode":"pau"},{"affno":"","first":"M.","key":"georgsenmpedh","last":"Georgsen","name":"Georgsen, M.","rank":36,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"A.","key":"qvortrupapedh","last":"Qvortrup","name":"Qvortrup, A.","rank":37,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"publisher":"University College Nordjylland (UCN)","status":"p","title":"Erfaringer og oplevelser med online undervisning på 9 videregående ud- dannelsesinstitutioner i foråret 2020"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","All University Colleges","DI-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","Roskilde University","Universities","University College of Northern Denmark","University Colleges","University of Southern Denmark"],"PST":["Published"]},"sid":["ruc-4bd05a2e-385d-4c62-a35b-7d46a8f76009"],"src":["RUC Roskilde University"],"title":"Erfaringer og oplevelser med online undervisning på 9 videregående uddannelsesinstitutioner i foråret 2020","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-561041","year":"2021","yearsub":"2021"}
{"abstract":"Background and Objectives: Emotional dysfunction is considered a key component in personality disorders; however, only few studies have examined the relationship between the two. In this study, emotional dysfunction was operationalized through the Affect Integration Inventory, and the aim was to examine the relationships between the level of affect integration and the levels of symptom distress, interpersonal problems, and personality functioning in patients diagnosed with personality disorder according to the Diagnostic and Statistical Manual of Mental Disorders, fifth edition. Materials and Methods: Within a hospital-based psychiatric outpatient setting, 87 patients with personality disorder referred for treatment were identified for assessment with the Affect Integration Inventory and other measures (e.g., the Symptom Checklist-90, Revised, the Inventory of Interpersonal Problems 64 circumplex version, and the Severity Indices of Personality Problems). Results: The analyses revealed that problems with affect integration were strongly and statistically significantly correlated with high levels of symptom distress, interpersonal problems, and maladaptive personality functioning. Additionally, low scores on the Affect Integration Inventory regarding discrete affects were associated with distinct and differentiated patterns of interpersonal problems. Conclusion: Taken together, emotional dysfunction, as measured by the Affect Integration Inventory, appeared to be a central component of the pathological self-organization associated with personality disorder. These findings have several implications for the understanding and psychotherapeutic treatment of personality pathology. Furthermore, they highlight the importance of considering the integration of discrete affects and their specific contributions in the conceptualization and treatment of emotional dysfunction in patients with personality disorders.","author_count":6,"contributors":["Frederiksen, Christina","Solbakken, Ole André","Licht, Rasmus W","Jørgensen, Carsten René","Rodrigo-Domingo, Maria","Telléus, Gry Kjærsdam"],"cuid":["S02-097.76-009185"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Frederiksen, Christina"],"country":["Norway"],"glorg":["All Global Affiliations","University of Oslo"],"keyword":["Affect Integration Inventory","Affect integration","Emotional dysfunction","Personality disorders","Psychopathology"],"level":"sci","mra":["med","soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"the relationship between affect integration and psychopathology in patients with personality disorder a cross sectional study","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/medicina57060627","version":"Published Version"},"id":"S02-097.76-009185","identifier":[{"id":"34208658","type":"pmid"},{"id":"PMC8234290","type":"pmcid"},{"id":"85108877285","type":"scopus"}],"ids":["aau-be5a7607-b39d-48dd-8087-4d9a13734685","au-21dd9b11-3893-42fe-9052-6c14d1570b86"],"keyword":["Affect Integration Inventory","affect integration","emotional dysfunction","personality disorders","psychopathology"],"lang":"English","level":"Scientific","mra":["Medical Science","Social Science"],"noi":["Global-Local-2-5-8C0620DDE7D715FCD6292541ADF8E428"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/medicina57060627","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/423687506/Frederiksen_et_al_2021_The_Relationship_between_Affect_Integration_and_Psychopathology_in_Patients_with_Personality_Disorder.pdf","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"rem","url":"https://www.mdpi.com/1648-9144/57/6/627","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Psychiatry","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"no","key":"university of oslo","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"University of Oslo","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus BSS, Department of Psychology and Behavioural Sciences"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Christina","key":"frederiksenpau","last":"Frederiksen","locid":"9f676fc7-28d7-462f-b271-84ed8e836389","name":"Frederiksen, Christina","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ole André","key":"solbakkenpau","last":"Solbakken","name":"Solbakken, Ole André","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rasmus Wentzer","key":"lichtpau","last":"Licht","locid":"bf0037e5-e6f9-48b0-91bf-bfd4ec420fb8","name":"Licht, Rasmus W","name_org":"Licht, Rasmus Wentzer","orcid":"0000-0001-8095-3490","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Carsten René","key":"jørgensenpau","last":"Jørgensen","locid":"3763a4db-6ce1-4e54-ac67-524a9604e1ce","name":"Jørgensen, Carsten René","orcid":"0000-0002-7324-1628","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Maria","key":"rodrigodomingopau","last":"Rodrigo-Domingo","locid":"fff908cd-728d-480b-9534-0cd7176b7dfc","name":"Rodrigo-Domingo, Maria","orcid":"0000-0001-7661-7195","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Gry","key":"kjaersdamtelléuspau","last":"Kjaersdam Telléus","locid":"156daec5-475f-48d0-aee8-4bfcf2cb7941","name":"Telléus, Gry Kjærsdam","name_org":"Kjaersdam Telléus, Gry","orcid":"0000-0003-2329-3988","rank":6,"rolecode":"pau"}],"pmid":["34208658"],"pub":{"doi":"10.3390/medicina57060627","issn":["1010660X","16489144"],"issn_org":["1010660X"],"issue":"6","journal":"Medicina","paperid":"627","publisher":"Multidisciplinary Digital Publishing Institute (MDPI)","status":"p","title":"Medicina","volume":"57"},"review":"Peer Reviewed","scoID":["2-s2.0-85108877285"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Universities"],"PST":["Published"]},"sid":["aau-be5a7607-b39d-48dd-8087-4d9a13734685","au-21dd9b11-3893-42fe-9052-6c14d1570b86"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"The Relationship between Affect Integration and Psychopathology in Patients with Personality Disorder: A Cross-Sectional Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-097.76-009185","year":"2021","yearsub":"2021"}
{"abstract":"Testing the antibody response to vaccination (diagnostic vaccination) is crucial in the clinical evaluation of primary immunodeficiency diseases. Guidelines from the American Academy of Allergy, Asthma & Immunology (AAAAI) provide detailed recommendations for diagnostic vaccination with pure pneumococcal polysaccharide vaccines (PPV). However, the degree of compliance with these guidelines and the utility of the guidelines in actual practice are undescribed. To address this, we systematically evaluated diagnostic vaccination in adult patients with suspected primary immunodeficiency diseases in a single tertiary center from 2011 to 2016 (n = 229). We found that full compliance with the AAAAI guidelines was achieved for only 39 patients (17%), suggesting that the guidelines are not easy to follow. Worse, interpretation according to the guidelines was heavily influenced by which serotype-specific antibodies that were used for the evaluation. We found that the arbitrary choices of serotype-specific antibodies could change the fraction of patients deemed to have ‘adequate immunity’ by a factor of four, exposing an inherent flaw in the guidelines. The flaw relates to dichotomous principles for data interpretation under the AAAAI guidelines. We therefore propose a revised protocol for diagnostic vaccination limited to PPV vaccination, subsequent antibody measurements, and data interpretation using Z-scores. The Z-score compiles multiple individual antibody levels, adjusted for different weighting, into one single continuous variable for each patient. In contrast to interpretation according to the AAAAI guidelines, the Z-scores were robust to variations in the choice of serotype-specific antibodies used for interpretation. Moreover, Z-scores revealed reduced immunity after vaccination in the patients with recurrent pneumonia (a typical symptom of antibody deficiency) compared with control patients. Assessment according to the AAAAI guidelines failed to detect this difference. We conclude that our simplified protocol and interpretation with Z-scores provides more robust clinical results and may enhance the value of diagnostic vaccination.","author_count":6,"contributors":["Hansen, Anette Tarp","Söderström, Anna","Jørgensen, Charlotte Sværke","Larsen, Carsten Schade","Petersen, Mikkel Steen","Jensen, Jens Magnus Bernth"],"cuid":["S01-000.00-180451"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"corresponding_author":["Jensen, Jens Magnus Bernth"],"country":["Sweden"],"glorg":["All Global Affiliations","Karolinska Institutet"],"keyword":["Antibody deficiency","Clinical guidelines","Diagnostic vaccination","Pneumococcal Vaccines","Primary immunodeficiency","Vaccination","Z score"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-GV-SSI","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"diagnostic vaccination in clinical practice","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3389/fimmu.2021.717873","version":"Published Version"},"id":"S01-000.00-180451","identifier":[{"id":"85117132154","type":"scopus"},{"id":"34659207","type":"pmid"},{"id":"PMC8514775","type":"pmcid"}],"ids":["au-59ae2b3f-8c86-4dbe-8e58-7357f01ada30"],"keyword":["antibody deficiency","clinical guidelines","diagnostic vaccination","pneumococcal vaccines","primary immunodeficiency","vaccination","z-score"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-928CFB74D62B15891E5BAAF633E94F3D"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.3389/fimmu.2021.717873","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Clinical Epidemiology"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"se","key":"karolinska institutet","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Karolinska Institutet","used":1},{"affno":"3","country":"dk","key":"ssi statens serum institut","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-SSI","l3nn":"SSI Statens Serum Institut","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SSI Statens Serum Institut","namevar":["Statens Serum Institut"],"nora_code":"DI-GV-SSI","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anette Tarp","key":"hansenpau","last":"Hansen","locid":"3eb73e87-6896-4583-9059-70692403d5cd","name":"Hansen, Anette Tarp","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Anna","key":"söderströmpau","last":"Söderström","locid":"57354c14-6f75-4d01-ad21-cc24b97b913c","name":"Söderström, Anna","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Charlotte Sværke","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, Charlotte Sværke","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Carsten Schade","key":"larsenpau","last":"Larsen","locid":"2435cb82-03bd-498b-909d-1ef0e99443fe","name":"Larsen, Carsten Schade","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mikkel Steen","key":"petersenpau","last":"Petersen","locid":"188d68ce-6256-4b77-b3a7-2d24490ed74a","name":"Petersen, Mikkel Steen","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens Magnus","key":"bernthjensenpau","last":"Bernth Jensen","locid":"a67e0021-e11c-47a3-93dd-8f3783ad755a","name":"Jensen, Jens Magnus Bernth","name_org":"Bernth Jensen, Jens Magnus","orcid":"0000-0002-5004-7822","rank":6,"rolecode":"pau"}],"pmid":["34659207"],"pub":{"doi":"10.3389/fimmu.2021.717873","issn":["16643224"],"journal":"Frontiers in Immunology","paperid":"717873","publisher":"Frontiers Media SA","status":"p","title":"Frontiers in Immunology","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-85117132154"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Universities"],"PST":["Published"]},"sid":["au-59ae2b3f-8c86-4dbe-8e58-7357f01ada30"],"src":["AU Aarhus University"],"title":"Diagnostic Vaccination in Clinical Practice","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-180451","year":"2021","yearsub":"2021"}
{"abstract":"The CITIES project is a large (budget 75 mill. DKK) strategic research project funded by Innovation Fund Denmark with a project runtime from 2014 to 2020. The research in CITIES focuses on digital methodologies and solutions for smart energy systems to facilitate the green transition to a fossil-free energy system. 39 Danish partners from academia and industry as well as 9 international partner institutions from the EU, Asia, Australia and the USA have investigated all aspects of the energy system and their interactions, including gas, power, district heating/cooling and biomass. The partners developed methods to forecast, control and optimize the integration through the use of advanced IT solutions and suggested new framework conditions and policy measures. Based on the extensive research conducted, the CITIES partners have the following recommendations in order to achieve the green transition of the energy system.","author_count":10,"contributors":["Madsen, Henrik","Guericke, Daniela","Nielsen, Per Sieverts","Nielsen, Toke Rammer","Liu, Xiufeng","Rode, Carsten","Jørgensen, John Bagterp","Dominkovic, Dominik Franjo","Pinson, Pierre","Sperling, Karl"],"cuid":["S01-000.00-359458"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"pop","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-AAU","DI-U-DTU"]},"review":"und","rtype":["clu"],"sorti":"recommendations from the cities project centre for it intelligent energy systems","src":["dtu"],"src-code":["DI-U-DTU"],"type":"doi","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/244409692/CITIES_Recommendations.pdf","version":"Published Version"},"id":"S01-000.00-359458","ids":["dtu-b7a497f4-2c96-4d0b-876b-44efbd5b3abf"],"lang":"English","level":"Popular","mra":["Science/Technology"],"noi":["Local-1-1-6BA8197515AE5B94C856A41A302D846F"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/244409692/CITIES_Recommendations.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Applied Mathematics and Computer Science","Technical University of Denmark, Department of Applied Mathematics and Computer Science, Dynamical Systems"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Henrik","key":"madsenhenrikpau","last":"Madsen","locid":"458e950b-adfd-4f2d-8d0d-ef39dee24bea","name":"Madsen, Henrik","orcid":"0000-0003-0690-3713","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Daniela","key":"guerickedanielapau","last":"Guericke","locid":"9ecd9cb1-ec1b-4a25-b22a-a8ad4767c05e","name":"Guericke, Daniela","orcid":"0000-0002-0668-9094","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Per Sieverts","key":"nielsenpersievertspau","last":"Nielsen","locid":"643033f5-bee2-4bd1-b476-e948fdc8461a","name":"Nielsen, Per Sieverts","orcid":"0000-0003-4090-7400","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Toke Rammer","key":"nielsentokerammerpau","last":"Nielsen","locid":"dfa8fdea-835d-4be8-9346-9fe7a4404cae","name":"Nielsen, Toke Rammer","orcid":"0000-0