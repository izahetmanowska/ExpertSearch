{"author_count":3,"contributors":["Simony, Ane","Ernst, Carsten","Isenbjerg-Jørgensen, Alexander"],"cuid":["S01-000.00-603391"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-SDR","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"neartros","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-603391","ids":["sdu-6999ba61-6498-4367-beb9-2c487337c71f"],"keyword":["Neartros"],"lang":"Danish","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-B240A10C0ED36167D016885AFBD8AAF7"],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Lillebælt Hospital","SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Lillebælt Hospital, Research Unit of Orthopaedics (Vejle)","SDU, The Faculty of Health Sciences, Department of Regional Health Research, Spine Center of Southern Denmark"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Sygehus Lillebælt"],"nora_code":"DI-HO-SDR","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Ane","key":"simonypau","last":"Simony","locid":"489efac7-1bcf-4816-83d2-66a2fbf0c263","name":"Simony, Ane","orcid":"0000-0002-1788-1161","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Carsten","key":"ernstpau","last":"Ernst","name":"Ernst, Carsten","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Alexander","key":"isenbjergjørgensenpau","last":"Isenbjerg-Jørgensen","name":"Isenbjerg-Jørgensen, Alexander","rank":3,"rolecode":"pau"}],"pub":{"issn":["00415782","13994174"],"issn_org":["00415782"],"issue":"20","journal":"Ugeskrift for Læger","paperid":"V65590","publisher":"Lægeforeningen","status":"p","title":"Ugeskrift for Læger","volume":"2014"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-6999ba61-6498-4367-beb9-2c487337c71f"],"src":["SDU University of Southern Denmark"],"title":"Neartros","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-603391","year":"2014","yearsub":"2014"}
{"abstract":"PURPOSE: This study tested whether 3-4 weeks of classical \"Live High-Train High\" (LHTH) altitude training increases swim-specific VO2max through increased hemoglobin mass (Hbmass). METHODS: Ten swimmers lived and trained for more than 3 weeks between 2,130 and 3,094 m of altitude, and a control group of ten swimmers followed the same training at sea-level (SL). Body composition was examined using dual X-ray absorptiometry. Hbmass was determined by carbon monoxide rebreathing. Swimming VO2peak was determined and swimming trials of 4 × 50, 200 and 3,000 m were performed before and after the intervention. RESULTS: Hbmass (n = 10) was increased (P < 0.05)after altitude training by 6.2 ± 3.9 % in the LHTH group, whereas no changes were apparent in the SL group (n = 10). Swimming VO2peak was similar before and after training camps in both groups (LHTH: n = 7, SL: n = 6). Performance of 4 × 50 m at race pace was improved to a similar degree in both groups (LHTH: n = 10, SL: n = 10). Maximal speed reached in an incremental swimming step test (P = 0.051), and time to complete 3,000 m tended (P = 0.09) to be more improved after LHTH (n = 10) than SL training (n = 10). CONCLUSION: In conclusion, 3-4 weeks of classical LHTH is sufficient to increase Hbmass but exerts no effect on swimming-specific VO2peak. LHTH may improve performance more than SL training.","author_count":9,"contributors":["Bonne, Thomas Christian","Lundby, Carsten","Jørgensen, Susanne","Johansen, Lars","Mrgan, Monija","Bech, Signe Refsgaard","Sander, Mikael","Papoti, Marcelo","Nordsborg, Nikolai Baastrup"],"cuid":["S02-092.21-044556"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["America, South","Europe, Non-EU","OECD"],"country":["Brazil","Switzerland"],"glorg":["All Global Affiliations","São Paulo State University","University of Zurich"],"keyword":["Hypoxia","Performance"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Esbjerg og Grindsted Sygehus"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"live high train high increases hemoglobin mass in olympic swimmers","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s00421-014-2863-4","version":"Other Version"},"id":"S02-092.21-044556","identifier":[{"id":"24668421","type":"pmid"},{"id":"84902536870","type":"scopus"}],"ids":["ku-9651d81a-549d-4b71-9959-92d4bfc0d88d","sdu-69788374-0688-4487-987b-05361f49c3d0"],"keyword":["Hypoxia","Live High-Train High","Performance"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-DE80E12581ED49030D01FB57AC9D7508"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s00421-014-2863-4","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Nutrition, Exercise and Sports, PhD"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"ch","key":"university of zurich","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"University of Zurich","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics, Team Denmark Testcenter"],"nora_code":"DI-U-SDU","used":1},{"affno":"4","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Esbjerg og Grindsted Sygehus"],"nora_code":"DI-OT","used":1},{"affno":"5","country":"br","key":"são paulo state university","loc":["Brazil","America, South"],"name":"São Paulo State University","used":1}],"person":[{"affno":"1","first":"Thomas Christian","key":"bonnepau","last":"Bonne","locid":"9b9994b8-7b29-4838-bb88-65657d9ac403","name":"Bonne, Thomas Christian","orcid":"0000-0002-4714-1981","rank":1,"rolecode":"pau"},{"affno":"2","first":"Carsten","key":"lundbypau","last":"Lundby","name":"Lundby, Carsten","orcid":"0000-0002-1684-0026","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Susanne","key":"jørgensenpau","last":"Jørgensen","locid":"076939a8-be95-4c68-b6fd-962f7cbe9067","name":"Jørgensen, Susanne","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Lars","key":"johansenpau","last":"Johansen","locid":"a127de66-d6e1-4872-9fd1-abd57d6e9e43","name":"Johansen, Lars","rank":4,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Monija","key":"mrganpau","last":"Mrgan","locid":"23bf7fda-c6b2-45a0-b7c6-9687b99756b2","name":"Mrgan, Monija","orcid":"0000-0001-9169-5263","rank":5,"rolecode":"pau"},{"affno":"1","first":"Signe Refsgaard","key":"bechpau","last":"Bech","locid":"7293330b-418d-4758-a45e-a7ab7a49184a","name":"Bech, Signe Refsgaard","orcid":"0000-0002-1182-0210","rank":6,"rolecode":"pau"},{"affno":"1","first":"Mikael","key":"sanderpau","last":"Sander","locid":"bce86650-f794-46f6-b4d0-c40465ef5c0f","name":"Sander, Mikael","rank":7,"rolecode":"pau"},{"affno":"5","f