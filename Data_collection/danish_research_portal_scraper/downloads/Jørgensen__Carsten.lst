sity, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of General Psychiatry"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"Morten","key":"kjølbyepau","last":"Kjølbye","locid":"f5885f6c-903f-4821-bdcb-4378384a7102","name":"Kjølbye, Morten","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Carsten René","key":"jørgensenpau","last":"Jørgensen","locid":"3763a4db-6ce1-4e54-ac67-524a9604e1ce","name":"Jørgensen, Carsten René","orcid":"0000-0002-7324-1628","rank":2,"rolecode":"pau"},{"affno":"","first":"Bo","key":"møhlpedh","last":"Møhl","name":"Møhl, Bo","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Morten","key":"kjølbyepedh","last":"Kjølbye","name":"Kjølbye, Morten","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"edition":"1.","isbn":["9788790420819"],"pages":"111-122","place":"København","publisher":"Psykiatrifondens Forlag","status":"p","title":"Psykoterapiens ABC"},"review":"Undetermined","search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-93e9180d-f96f-4db4-8eaa-2c68e0491f24","au-a062729c-9b0f-48b6-be99-5c4ee0bf7fc4"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Mentaliseringsbaseret terapi","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-094.64-007158","year":"2013","yearsub":"2013"}
{"abstract":"BACKGROUND: Older adults show increased risk of falling and major risk factors include impaired lower extremity muscle strength and postural balance. However, the potential positive effect of biofeedback-based Nintendo Wii training on muscle strength and postural balance in older adults is unknown. METHODS: This randomized controlled trial examined postural balance and muscle strength in community-dwelling older adults (75±6 years) pre- and post-10 weeks of biofeedback-based Nintendo Wii training (WII, n = 28) or daily use of ethylene vinyl acetate copolymer insoles (controls [CON], n = 30). Primary end points were maximal muscle strength (maximal voluntary contraction) and center of pressure velocity moment during bilateral static stance. RESULTS: Intention-to-treat analysis with adjustment for age, sex, and baseline level showed that the WII group had higher maximal voluntary contraction strength (18%) than the control group at follow up (between-group difference = 269 N, 95% CI = 122; 416, and p = .001). In contrast, the center of pressure velocity moment did not differ (1%) between WII and CON at follow-up (between-group difference = 0.23mm(2)/s, 95% CI = -4.1; 4.6, and p = .92). For secondary end points, pre-to-post changes favoring the WII group were evident in the rate of force development (p = .03), Timed Up and Go test (p = .01), short Falls Efficacy Scale-International (p = .03), and 30-second repeated Chair Stand Test (p = .01). Finally, participants rated the Wii training highly motivating at 5 and 10 weeks into the intervention. CONCLUSIONS: Biofeedback-based Wii training led to marked improvements in maximal leg muscle strength (maximal voluntary contraction; rate of force development) and overall functional performance in community-dwelling older adults. Unexpectedly, static bilateral postural balance remained unaltered with Wii training. The high level of participant motivation suggests that biofeedback-based Wii exercise may ensure a high degree of compliance to home- and/or community-based training in community-dwelling older adults.","author_count":9,"contributors":["Jørgensen, Martin Grønbech","Læssøe, Uffe","Hendriksen, Carsten","Faurholt Nielsen, Ole Bruno","Aagaard, Per"],"cuid":["S04-087.99-011288"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","class":"merged","cluster_size":4,"keyword":["Elderly"],"level":"sci","mra":["med","soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U","DI-UC"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-NDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"],"UC":["DI-UC-ALL","DI-UC-UCN"]},"level3all":["DI-HO-CAP","DI-HO-NDR","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU","DI-UC-UCN"]},"review":"pr","rtype":["clu"],"sorti":"efficacy of nintendo wii training on mechanical leg muscle function and postural balance in community dwelling older adults a randomized controlled trial","src":["aau","au","sdu","ucn"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-SDU","DI-UC-UCN"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1093/gerona/gls222","version":"Published Version"},"id":"S04-087.99-011288","identifier":[{"id":"23114461","type":"pmid"},{"id":"84882955225","type":"scopus"},{"id":"WOS:000322446000011","type":"wos"}],"ids":["aau-ec77b50d-5144-4353-8f7b-068634887925","au-7768ca2f-e3e7-48f1-9cfd-2e9ff57bb687","sdu-331dbf88-df04-43fa-bbe0-3eeffc85f691","ucn-de8ec921-8966-49bd-983b-cb245d7c5797"],"keyword":["elderly"],"lang":"English","level":"Scientific","mra":["Medical Science","Social Science"],"noi":["Local-1-4-4B9649DD093E9843EF8C2DED4C93596B"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1093/gerona/gls222","version":"Published Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities"