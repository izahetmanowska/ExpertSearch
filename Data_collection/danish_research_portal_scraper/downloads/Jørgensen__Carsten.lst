me":"Mortensen, Louise","rank":7,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Mette","key":"garvalmettepau","last":"Garval","locid":"9be88f0a-dbf0-4803-83e2-b635aaea6e38","name":"Garval, Mette","orcid":"0000-0002-0684-0997","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lisa Urup","key":"reimerlisacecilieuruppau","last":"Tønning","locid":"6cd07691-f3fc-443a-a6fe-b31580cd90dc","name":"Reimer, Lisa Cecilie Urup","name_org":"Tønning, Lisa Urup","orcid":"0000-0003-4666-4622","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Inger","key":"mechlenburgingerpau","last":"Mechlenburg","locid":"b46c351d-ea23-4836-8426-a5402fd1a2bd","name":"Mechlenburg, Inger","orcid":"0000-0001-5432-8691","rank":10,"rolecode":"pau"}],"pmid":["39461901"],"pub":{"doi":"10.1111/sms.14750","issn":["09057188","16000838"],"issn_org":["09057188"],"issue":"11","journal":"Scandinavian Journal of Medicine & Science in Sports","paperid":"e14750","publisher":"Blackwell Munksgaard","status":"p","title":"Scandinavian Journal of Medicine & Science in Sports","volume":"34"},"review":"Peer Reviewed","scoID":["2-s2.0-85207572917"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-f36cc4bf-6b9a-451f-a5c1-83b1c56ffddd","sdu-318b95fd-b21b-438c-8639-e77ba7c9b416"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"The Effect of Blood Flow Restriction Exercise Prior to Total Knee Arthroplasty on Postoperative Physical Function, Lower Limb Strength and Patient-Reported Outcomes : A Randomized Controlled Trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-768007","year":"2024","yearsub":"2024"}
{"abstract":"In the Greenlandic Inuit population, 4% are homozygous carriers of a genetic nonsense TBC1D4 p.Arg684Ter variant leading to loss of the muscle-specific isoform of TBC1D4 and an approximately tenfold increased risk of type 2 diabetes1. Here we show the metabolic consequences of this variant in four female and four male homozygous carriers and matched controls. An extended glucose tolerance test reveals prolonged hyperglycaemia followed by reactive hypoglycaemia in the carriers. Whole-body glucose disposal is impaired during euglycaemic-hyperinsulinaemic clamp conditions and associates with severe insulin resistance in skeletal muscle only. Notably, a marked reduction in muscle glucose transporter GLUT4 and associated proteins is observed. While metabolic regulation during exercise remains normal, the insulin-sensitizing effect of a single exercise bout is compromised. Thus, loss of the muscle-specific isoform of TBC1D4 causes severe skeletal muscle insulin resistance without baseline hyperinsulinaemia. However, physical activity can ameliorate this condition. These observations offer avenues for personalized interventions and targeted preventive strategies.","author_count":31,"contributors":["Kristensen, Jonas Møller","Kjøbsted, Rasmus","Larsen, Trine J.","Carl, Christian Strini","Hingst, Janne Rasmuss","Onslev, Johan","Birk, Jesper Bratz","Thorup, Anette","Steenberg, Dorte Enggaard","Knudsen, Jonas Roland","Henriksen, Nicolai S.","Needham, Elise J.","Halling, Jens Frey","Gudiksen, Anders","Rundsten, Carsten Friis","Hanghøj, Kristian","Stinson, Sara Elizabeth","Hoier, Birgitte","Hansen, Camilla Collin","Jensen, Thomas Elbenhardt","Hellsten, Ylva","Pilegaard, Henriette","Grarup, Niels","Olesen, Jesper","Humphrey, Sean J.","James, David E.","Pedersen, Michael L.","Richter, Erik A.","Hansen, Torben","Jørgensen, Marit E.","Wojtaszewski, Jørgen"],"cuid":["S02-100.00-785467"],"filters":{"added":"2025-02","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Nordic","OECD","Oceania"],"corresponding_author":["Wojtaszewski, Jørgen F.P."],"country":["Australia","Greenland"],"glorg":["All Global Affiliations","Grønlands Universitet","Queen Ingrid Primary Health Care Center","Queen Ingrid’s Hospital","Steno Diabetes Center Greenland","The University of Sydney","University of Greenland","University of Sydney"],"keyword":["Adult","Exercise","Female","GTPase Activating Proteins metabolism","Glucose Tolerance Test","Glucose Transporter Type 4 metabolism","Heterozygote","Humans","Insulin Resistance","Insulin metabolism","Male","Muscle Skeletal metabolism"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-STENO"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-STENO","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"skeletal muscle from i tbc000000000001d000000000004 i p arg000000000684ter variant carriers is severely insulin resistant but exhibits normal metabolic responses during exercise","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1038/s42255-024-01153-1","version":"Published Version"},"id":"S02-100.00-785467","identifier":[{"id":"PMC11659169","type":"pmcid"},{"id":"39482542","type":"pmid"},{"id":"85208070144","type":"scopus"}],"ids":["ku-74a4ed68-d55c-477c-bf51-7f762f13c009","sdu-a088feae-29b6-4861-b313-9322dc5d9555"],"keyword":["Adult","Exercise","Female","GTPase-Activating Proteins/metabolism","Glucose Tolerance Test","Glucose Transporter Type 4/metabolism","Heterozygote","Humans","Insulin Resistance","Insulin/metabolism","Male","Muscle, Skeletal/metabolism"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-441890BB2E98302BEBF0B51CE5BE34EF"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/280751334/s42255-024-01153-1_1_.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1038/s42255-024-01153-1","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/416528833/s42255_024_01153_1.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Nutrition, Exercise and Sports, The August Krogh Section for Molecular Physiology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"gl","key":"university of greenland","loc":["Greenland","Nordic"],"name":"University of Greenland","used":1},{"affno":"3","country":"gl","key":"grønlands universitet","loc":["Greenland","Nordic"],"name":"Grønlands Universitet","used":1},{"affno":"4","country":"au","key":"university of sydney","loc":["Australia","Oceania","OECD"],"name":"University of Sydney","used":1},{"affno":"5","country":"au","key":"the university of sydney","loc":["Australia","Oceania","OECD"],"name":"The University of Sydney","used":1},{"affno":"6","country":"gl","key":"queen ingrid s hospital","loc":["Greenland","Nordic"],"name":"Queen Ingrid’s Hospital","used":1},{"affno":"7","country":"gl","key":"queen ingrid primary health care center","loc":["Greenland","Nordic"],"name":"Queen Ingrid Primary Health Care Center","used":1},{"affno":"8","country":"gl","key":"steno diabetes center greenland","loc":["Greenland","Nordic"],"name":"Steno Diabetes Center Greenland","used":1},{"affno":"9","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"Unive