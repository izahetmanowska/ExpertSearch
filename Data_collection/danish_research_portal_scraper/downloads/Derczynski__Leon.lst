,"orcid":"0000-0003-1842-9131","rank":3,"rolecode":"pau"},{"affno":"","first":"Valérie","key":"monfortpedh","last":"Monfort","name":"Monfort, Valérie","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Karl-Heinz","key":"krempelspedh","last":"Krempels","name":"Krempels, Karl-Heinz","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Tim A.","key":"majchrzakpedh","last":"Majchrzak","name":"Majchrzak, Tim A.","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Ziga","key":"turkpedh","last":"Turk","name":"Turk, Ziga","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.5220/0005403101830193","isbn":["9789897581069"],"pages":"183-193","publisher":"SciTePress","status":"p","title":"Proceedings of the 11th International Conference on Web Information Systems and Technologies (WEBIST-2015)"},"review":"Peer Reviewed","scoID":["2-s2.0-84945397451"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-0297afed-57de-4266-ba5c-e2fb7f9a4ffc"],"src":["AAU Aalborg University"],"title":"Enhanced Information Access to Social Streams Through Word Clouds with Entity Grouping","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-050781","year":"2015","yearsub":"2015"}
{"abstract":"Brown clustering, an unsupervised hierarchical clustering technique based on ngram mutual information, has proven useful in many NLP applications. However, most uses of Brown clustering employ the same default configuration; the appropriateness of this configuration has gone predominantly unexplored. Accordingly, we present information for practitioners on the behaviour of Brown clustering in order to assist hyper-parametre tuning, in the form of a theoretical model of Brown clustering utility. This model is then evaluated empirically in two sequence labelling tasks over two text types. We explore the dynamic between the input corpus size, chosen number of classes, and quality of the resulting clusters, which has an impact for any approach using Brown clustering. In every scenario that we examine, our results reveal that the values most commonly used for the clustering are sub-optimal.","author_count":6,"contributors":["Derczynski, Leon","Chester, Sean","Bøgh, Kenneth Sejdenfaden"],"cuid":["S01-000.00-154185"],"event":{"end":"2015-09-09","place":"Hissar, bg","start":"2015-09-07","title":"International Conference on recent advances in Natural Processing","year":"2015"},"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of Sheffield"],"keyword":["Brown clustering","Clustering","Configuration","Machine learning","Unsupervised learning","Word representations"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"tune your brown clustering please","src":["au"],"src-code":["DI-U-AU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.derczynski.com/sheffield/brown-tuning/","version":"Other Version"},"id":"S01-000.00-154185","identifier":[{"id":"84949759811","type":"scopus"}],"ids":["au-2b758b2c-f1ab-4b2f-a055-a332227d990f"],"keyword":["Brown clustering","clustering","configuration","machine learning","unsupervised learning","word representations"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-BD9963D0223D26743024D5AE4C447EA5"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","country":"gb","key":"university of sheffield","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Sheffield","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Computer Science"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Leon","key":"derczynskipau","last":"Derczynski","name":"Derczynski, Leon","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Sean","key":"chesterpau","last":"Chester","locid":"1b7327ba-134e-4ed9-9947-590b6eb9934e","name":"Chester, Sean","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kenneth Sejdenfaden","key":"bøghpau","last":"Bøgh","locid":"d4a2e28a-5ee4-46d3-b360-baadd587a5bc","name":"Bøgh, Kenneth Sejdenfaden","rank":3,"rolecode":"pau"},{"affno":"","first":"Galia A","key":"angelovapedh","last":"Angelova","name":"Angelova, Galia A","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Kalina","key":"bontchevapedh","last":"Bontcheva","name":"Bontcheva, Kalina","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Ruslan","key":"mitkovpedh","last":"Mitkov","name":"Mitkov, Ruslan","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"issn":["13138502"],"pages":"110-117","place":"Hissar, Bulgaria","publisher":"INCOMA Ltd","series":"Recent Advances in Natural Language Processing","status":"p","title":"International Conference Recent Advances in Natural Language Processing ’2015 Proceedings"},"review":"Peer Reviewed","scoID":["2-s2.0-84949759811"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-2b758b2c-f1ab-4b2f-a055-a332227d990f"],"src":["AU Aarhus University"],"title":"Tune Your Brown Clustering, Please","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-154185","year":"2015","yearsub":"2015"}
{"abstract":"Danish is a major Scandinavian language spoken daily by around six million people. However, it lacks a unified, open set of NLP tools. This demonstration will introduce DKIE, an extensible open-source toolkit for processing Danish text. We implement an information extraction architecture for Danish within GATE, including integrated third-party tools. This implementation includes the creation of a substantial set of corpus annotations for dataintensive named entity recognition. The final application and dataset is made are openly available, and the part-of-speech tagger and NER model also operate independently or with the Stanford NLP toolkit.","author_count":6,"contributors":["Derczynski, Leon","Field, Camilla Vilhelmsen","Bøgh, Kenneth Sejdenfaden"],"cuid":["S01-000.00-148236"],"event":{"acronym":"EACL","end":"2014-04-30","place":"Gothenburg, se","start":"2014-04-26","title":"Conference of the European Chapter of the Association for Computational Linguistics","year":"2014"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of Sheffield"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"dkie open source information extraction for danish","src":["au"],"src-code":["DI-U-AU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://anthology.aclweb.org/E/E14/E14-2.pdf#page=75","version":"Other Version"},"id":"S01-000.00-148236","identifier":[{"id":"85096607229","type":"scopus"}],"ids":["au-21005348-ad57-458b-b71c-01d8a1a048fc"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-1F923CA28977A8CC026FB70F2BB2C0AB"],"oa_link":[{"access":"oa","type":"rem","url":"http://anthology.aclweb.org/E/E14/E14-2.pdf#page=75","version":"Other Version"},{"access":"oa","type":"rem","url":"http://www.aclweb.org/anthology/E14-2","version":"Other Version"}],"org":[{"affno":"1","country":"gb","key":"university of sheffield","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Sheffield","used":1},{"affno":"2","country":"dk","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["University of Southern Denmark (SDU)"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Computer Science"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Leon","key":"derczynskipau","last":"Derczynski","name":"Derczynski, Leon","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Camilla Vilhelmsen","key":"fieldpau","last":"Field","name":"Field, Camilla Vilhelmsen","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Kenneth Sejdenfaden","key":"bøghpau","last":"Bøgh","locid":"d4a2e28a-5ee4-46d3-b360-baadd587a5bc","name":"Bøgh, Kenneth Sejdenfaden","rank":3,"rolecode":"pau"},{"affno":"","first":"Shuly","key":"wintnerpedh","last":"Wintner","name":"Wintner, Shuly","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Marko","key":"tadiapedh","last":"Tadia","name":"Tadia, Marko","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Bogdan","key":"babychpedh","last":"Babych","name":"Babych, Bogdan","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"pages":"61-64","publisher":"Association for Computational Linguistics","status":"p","title":"Proceedings of the Demonstrations at the 14th Conference of the European Chapter of the Association for Computational Linguistics"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-21005348-ad57-458b-b71c-01d8a1a048fc"],"src":["AU Aarhus University"],"title":"DKIE: Open Source Information Extraction for Danish","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-148236","year":"2014","yearsub":"2014"}
{"abstract":"Social media has changed the way we communicate. Social media data capture our social interactions and utterances in machine readable format. Searching and analysing massive and frequently updated social media data brings significant and diverse rewards across many different application domains, from politics and business to social science and epidemiology. A notable proportion of social media data comes with explicit or implicit spatial annotations, and almost all social media data has temporal metadata. We view social media data as a constant stream of data points, each containing text with spatial and temporal contexts. We identify challenges relevant to each context, which we intend to subject to context aware querying and analysis, specifically including longitudinal analyses on social media archives, spatial keyword search, local intent search, and spatio-temporal intent search. Finally, for each context, emerging applications and further avenues for investigation are discussed.","author_count":3,"contributors":["Derczynski, Leon R.A.","Yang, Bin","Jensen, Christian S."],"cuid":["S01-000.00-122161"],"event":{"acronym":"EDBT","end":"2013-03-22","place":"Genoa, it","start":"2013-03-18","title":"16th International Conference on Extending Database Technology, EDBT 2013","year":"2013"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of Sheffield"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"towards context aware search and analysis on social media data","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=84876803344&partnerID=8YFLogxK","version":"Other Version"},"id":"S01-000.00-122161","identifier":[{"id":"84876803344","type":"scopus"}],"ids":["aau-f8435271-3604-4bdf-bce9-e792ef982755"],"keyword":["H.3 [Information Systems]: Information Storage and Retrieval"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-5-C3D5EC1CDCC9F25D0EA4E77456536399"],"org":[{"affno":"1","country":"gb","key":"university of sheffield","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Sheffield","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Technical Faculty of IT and Design","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science, Database, Programming and Web Technologies"],"nora_code":"DI-U-AAU","used":1},{"affno":"3","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Leon R.A.","key":"derczynskipau","last":"Derczynski","name":"Derczynski, Leon R.A.","rank":1,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"country":"dk","first":"Bin","key":"yangpau","last":"Yang","locid":"b7f7782f-010a-4656-b02d-55ef4a3d2072","name":"Yang, Bin","orcid":"0000-0002-1658-1079","rank":2,"rolecode":"pau"},{"affno":"3 2","corresponding":null,"country":"dk","first":"Christian S.","key":"jensenpau","last":"Jensen","locid":"56b675d6-bbf5-4dec-a799-50327f3fc66a","name":"Jensen, Christian S.","orcid":"0000-0002-9697-7670","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1145/2452376.2452393","isbn":["9781450315975"],"pages":"137-142","status":"p","subtitle":"16th International Conference on Extending Database Technology, Proceedings","title":"Advances in Database Technology - EDBT 2013"},"review":"Peer Reviewed","scoID":["2-s2.0-84876803344"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-f8435271-3604-4bdf-bce9-e792ef982755"],"src":["AAU Aalborg University"],"title":"Towards context-aware search and analysis on social media data","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-122161","year":"2013","yearsub":"2013"}
{"abstract":"Social media has changed the way we communicate. Social media data capture our social interactions and utterances in machine readable format. Searching and analysing massive and frequently updated social media data brings significant and diverse rewards across many different application domains, from politics and business to social science and epidemiology. A notable proportion of social media data comes with explicit or implicit spatial annotations, and almost all social media data has temporal metadata. We view social media data as a constant stream of data points, each containing text with spatial and temporal contexts. We identify challenges relevant to each context, which we intend to subject to context aware querying and analysis, specifically including longitudinal analyses on social media archives, spatial keyword search, local intent search, and spatio-temporal intent search. Finally, for each context, emerging applications and further avenues for investigation are discussed.","author_count":5,"contributors":["Derczynski, Leon","Yang, Bin","Jensen, Christian S."],"cuid":["S01-000.00-162721"],"event":{"acronym":"EDBT","end":"2013-03-21","place":"Genoa, it","start":"2013-03-18","title":"International Conference on Extending Database Technology","year":"2013"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"towards context aware search and analysis on social media data","src":["au"],"src-code":["DI-U-AU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1145/2452376.2452393","version":"Other Version"},"id":"S01-000.00-162721","identifier":[{"id":"84876803344","type":"scopus"}],"ids":["au-3a8f4b8a-cdc4-4a2d-8f05-0920620b5b08"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-5-C3D5EC1CDCC9F25D0EA4E77456536399"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1145/2452376.2452393","version":"Other Version"},{"access":"oa","type":"rem","url":"http://dl.acm.org.ez.statsbiblioteket.dk:2048/citation.cfm?id=2452376.2452393&coll=DL&dl=ACM&CFID=229948864&CFTOKEN=73427624","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Computer Science"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Leon","key":"derczynskipau","last":"Derczynski","locid":"2cf0ad42-36e6-4629-91c6-b3a865689232","name":"Derczynski, Leon","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Bin","key":"yangpau","last":"Yang","locid":"63ce0ab9-2f0e-46b7-a08c-dbb072b48bb0","name":"Yang, Bin","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christian S.","key":"jensenpau","last":"Jensen","locid":"42debc0e-cea5-4a35-8f9e-784d41c8eb6f","name":"Jensen, Christian S.","rank":3,"rolecode":"pau"},{"affno":"","first":"Giovanna","key":"guerrinipedh","last":"Guerrini","name":"Guerrini, Giovanna","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Norman W.","key":"patonpedh","last":"Paton","name":"Paton, Norman W.","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1145/2452376.2452393","isbn":["9781450315975"],"pages":"137-142","publisher":"Association for Computing Machinery","status":"p","subtitle":"EDBT 2013","title":"Proceedings of The 16th International Conference on Extending Database Technology"},"review":"Peer Reviewed","scoID":["2-s2.0-84876803344"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-3a8f4b8a-cdc4-4a2d-8f05-0920620b5b08"],"src":["AU Aarhus University"],"title":"Towards Context-Aware Search and Analysis on Social Media Data","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-162721","year":"2013","yearsub":"2013"}
{"abstract":"This paper introduces a new class of temporal expression – named temporal expressions – and methods for recognising and interpreting its members. The commonest temporal expressions typically contain date and time words, like April or hours. Research into recognising and interpreting these typical expressions is mature in many languages. However, there is a class of expressions that are less typical, very varied, and difficult to automatically interpret. These indicate dates and times, but are harder to detect because they often do not contain time words and are not used frequently enough to appear in conventional temporally-annotated corpora – for example Michaelmas or Vasant Panchami. UsingWikipedia and linked data, we automatically construct a resource of English named temporal expressions, and use it to extract training examples from a large corpus. These examples are then used to train and evaluate a named temporal expression recogniser. We also introduce and evaluate rules for automatically interpreting these expressions, and we observe that use of the rules improves temporal annotation performance over existing corpora.","author_count":8,"contributors":["Brucato, Matteo","Derczynski, Leon","Llorens, Hectjor","Bontcheva, Kallina","Jensen, Christian S."],"cuid":["S01-000.00-206760"],"event":{"end":"2013-09-13","place":"Hissar, bg","start":"2013-09-07","title":"Recent Advances in Natural Language Processing","year":"2013"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of Sheffield"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"recognising and interpreting named temporal expressions","src":["au"],"src-code":["DI-U-AU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.au.dk/ws/files/56782628/implicit_timex.pdf","version":"Pre-print"},"id":"S01-000.00-206760","identifier":[{"id":"84890471917","type":"scopus"}],"ids":["au-87aa5336-74f3-4cfb-bd7c-91e55f44085c"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-89DACDFDF17ABE59FF8AD62D7929C028"],"oa_link":[{"access":"oa","type":"rem","url":"http://lml.bas.bg/ranlp2013/history.php","version":"Other Version"},{"access":"oa","type":"rem","url":"http://lml.bas.bg/ranlp2013/docs/RANLP_main.pdf","version":"Other Version"},{"access":"oa","type":"loc","url":"https://pure.au.dk/ws/files/56782628/implicit_timex.pdf","version":"Pre-print"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Computer Science"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"gb","key":"university of sheffield","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Sheffield","used":1},{"affno":"3","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Matteo","key":"brucatopau","last":"Brucato","locid":"6c6fc58e-6da7-45b0-8f8c-b5ea6074f7e9","name":"Brucato, Matteo","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Leon","key":"derczynskipau","last":"Derczynski","name":"Derczynski, Leon","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Hectjor","key":"llorenspau","last":