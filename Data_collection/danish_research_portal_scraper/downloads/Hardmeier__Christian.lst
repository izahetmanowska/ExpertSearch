hagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NLPnorth"],"nora_code":"DI-U-ITU","used":1},{"affno":"4","country":"us","key":"university of texas","loc":["United States","America, North","OECD"],"name":"University of Texas","used":1},{"affno":"5","country":"se","key":"university of gothenburg","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"University of Gothenburg","used":1},{"affno":"6","country":"us","key":"georgetown university","loc":["United States","America, North","OECD"],"name":"Georgetown University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Michael","key":"strubeped","last":"Strube","name":"Strube, Michael","rank":1,"role":"Editor","rolecode":"ped"},{"affno":"2","corresponding":null,"first":"Chloé","key":"braudped","last":"Braud","name":"Braud, Chloé","rank":2,"role":"Editor","rolecode":"ped"},{"affno":"3","corresponding":null,"first":"Christian","key":"hardmeierped","last":"Hardmeier","locid":"9504265d-0046-4e58-b529-256a656c012d","name":"Hardmeier, Christian","orcid":"0000-0002-6103-7275","rank":3,"role":"Editor","rolecode":"ped"},{"affno":"4","corresponding":null,"first":"Junyi Jessy","key":"liped","last":"Li","name":"Li, Junyi Jessy","rank":4,"role":"Editor","rolecode":"ped"},{"affno":"5","corresponding":null,"first":"Sharid","key":"loáicigaped","last":"Loáiciga","name":"Loáiciga, Sharid","rank":5,"role":"Editor","rolecode":"ped"},{"affno":"6","corresponding":null,"first":"Amir","key":"zeldesped","last":"Zeldes","name":"Zeldes, Amir","rank":6,"role":"Editor","rolecode":"ped"}],"pub":{"eisbn":["9781959429890"],"publisher":"Association for Computational Linguistics","status":"p","title":"Proceedings of the 4th Workshop on Computational Approaches to Discourse (CODI 2023)"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-