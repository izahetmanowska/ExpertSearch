{"abstract":"Discussing the work of multi media artists Michelle and Uri Kranot - in the contexts of democracy and change making - both virtual and in reality","author_count":2,"contributors":["Kranot, Michelle","Kranot, Uriel"],"cuid":["S01-000.00-715293"],"filters":{"added":"2024-02","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Medier kommunikation og sprog","Æstetik design og medier"],"level":"pop","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-UC"],"level3":{"UC":["DI-UC-ALL","DI-UC-VIA"]},"level3all":["DI-UC-VIA"]},"review":"und","rtype":["clu"],"sorti":"broen mellem den virtuelle og den virkelige verden kirsten marie juel jensen multimediekunstnerne michelle og uri kranot","src":["via"],"src-code":["DI-UC-VIA"],"type":"do","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.e-pages.dk/sn/3123/","version":"Other Version"},"id":"S01-000.00-715293","ids":["via-48be0a65-c09d-4a6b-961e-0278f79d270c"],"keyword":["Medier, kommunikation og sprog","Æstetik, design og medier"],"lang":"Danish","level":"Popular","mra":["Humanities"],"noi":["Local-1-1-FA83B0695F85431B1393FCA65C186156"],"org":[{"affno":"1","key":"via university college","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-VIA","l3nl":"VIA University College","l3nn":"VIA University College","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"VIA University College","namevar":["VIA, Forskning og udvikling, Forsk.center Kreative erhverv og professioner","VIA, Uddannelser, Storytelling-, design- og businessuddannelserne, Center for animation, visualisering og digital fortælling","VIA, Uddannelser, Storytelling-, design- og businessuddannelserne, The Animation Workshop"],"nora_code":"DI-UC-VIA","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Michelle","key":"kranotmichelleoth","last":"Kranot","locid":"387ef20d-3bd4-4a0c-968b-c0abe0f9b7ad","name":"Kranot, Michelle","orcid":