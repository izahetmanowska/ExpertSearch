":"dk","first":"Jette","key":"kofoedpau","last":"Kofoed","locid":"641b3779-e4ce-4fb4-86c9-a92ce25dab77","name":"Kofoed, Jette","orcid":"0000-0002-5736-1267","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jonas","key":"fritschpau","last":"Fritsch","name":"Fritsch, Jonas","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.22387/cap2022.74","issue":"1","journal":"Capacious: Journal for Emerging Affect Inquiry","pages":"225-240","publisher":"Capacious Radical Open Access Collective","status":"p","title":"Capacious: Journal for Emerging Affect Inquiry","volume":"3"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["au-0952f1c8-014b-4f9d-a543-0f7c427dd77f"],"src":["AU Aarhus University"],"title":"Affective Event Writing: : An Entry Point for Collective Attunement","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-134615","year":"2023","yearsub":"2023"}
{"abstract":"Emerging studies are reporting on the implications of self-tracked data in patients’ everyday life and how it influences self-care activities in chronic care. The increased uptake of consumer wearable activity trackers in healthcare contexts and the wider application of advanced analytics is changing the temporal scope from ‘past-centric’ to ‘future-centric’ personal informatics. At the same time, a stream of research is making clear that experiences of emotion are constitutive of patient data work suggesting that the micro practices of engaging with personal data has an important affective dimension. We conducted an exploratory interview study with five chronic heart patients with an implanted cardiac device to conceptualize the data work, which is involved in making sense of self-tracked data from a consumer wearable activity tracker (Fitbit Alta HR). In this paper, we contribute to understanding patient data work as seven forms of micro practices: Verifying, Questioning, Motivating, Reacting, Accepting, Distancing, and Sharing. We discuss how these practices relate to temporal and affective dimensions of engaging with self-tracked data in chronic care and point to future research.","author_count":5,"contributors":["Andersen, Tariq Osman","Fritsch, Jonas","Matthiesen, Stina"],"cuid":["S01-000.00-683697"],"event":{"end":"2022-12-14","place":"Thessaloniki, gr","start":"2022-12-12","title":"16th EAI International Conference on Pervasive Computing Technologies for Healthcare, PH 2022","year":"2022"},"filters":{"added":"2023-09","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Affective Computing","Personal informatics","Self Care","Self tracking","Wearable activity trackers"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"patient data work with consumer self tracking exploring affective and temporal dimensions in chronic self care","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://curis.ku.dk/ws/files/411755974/Patient_Data_Work_with_Consumer_Self_Trackin.pdf","version":"Pre-print"},"id":"S01-000.00-683697","identifier":[{"id":"85164156652","type":"scopus"}],"ids":["ku-0f66f64c-9a91-48b9-8d70-1dac454ea97d"],"keyword":["Affective computing","Personal informatics","Self-care","Self-tracking","Wearable activity trackers"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-5-170602EAC670AB2EF269A75BE416EBEC"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://curis.ku.dk/ws/files/411755974/Patient_Data_Work_with_Consumer_Self_Trackin.pdf","version":"Pre-print"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Software, Data, People & Society"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","first":"Tariq Osman","key":"andersenpau","last":"Andersen","locid":"dfc4b3ec-64f4-4e84-92fe-67e3b681c85b","name":"Andersen, Tariq Osman","orcid":"0000-0002-9342-5520","rank":1,"rolecode":"pau"},{"affno":"2","first":"Jonas","key":"fritschpau","last":"Fritsch","name":"Fritsch, Jonas","rank":2,"rolecode":"pau"},{"affno":"1","first":"Stina","key":"matthiesenpau","last":"Matthiesen","locid":"df70a27c-5cbd-4357-818e-80b896d8819e","name":"Matthiesen, Stina","orcid":"0000-0002-7143-7467","rank":3,"rolecode":"pau"},{"affno":"","first":"Athanasios","key":"tsanaspedh","last":"Tsanas","name":"Tsanas, Athanasios","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Andreas","key":"triantafyllidispedh","last":"Triantafyllidis","name":"Triantafyllidis, Andreas","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-031-34586-9_44","isbn":["9783031345852"],"issn":["18678211"],"pages":"666-680","publisher":"Springer","series":"Lecture Notes of the Institute for Computer Sciences, Social-Informatics and Telecommunications Engineering, LNICST","status":"p","title":"Pervasive Computing Technologies for Healthcare - 16th EAI International Conference, PervasiveHealth 2022, Proceedings"},"review":"Peer Reviewed","scoID":["2-s2.0-85164156652"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-0f66f64c-9a91-48b9-8d70-1dac454ea97d"],"src":["KU University of Copenhagen"],"title":"Patient Data Work with Consumer Self-tracking : Exploring Affective and Temporal Dimensions in Chronic Self-care","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-683697","year":"2023","yearsub":"2023"}
