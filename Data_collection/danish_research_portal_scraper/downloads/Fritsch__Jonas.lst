ar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Human-Computer Interaction and Design, Affective Interactions & Relations Lab"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Bodil Marie Stavning","key":"thomsenped","last":"Thomsen","locid":"055e1b94-febb-4a3e-acd7-a200699c386c","name":"Thomsen, Bodil Marie Stavning","orcid":"0000-0003-0568-0386","rank":1,"role":"Editor","rolecode":"ped"},{"affno":"","corresponding":null,"first":"Bodil Marie Stavning","key":"thomsenpau","last":"Thomsen","name":"Thomsen, Bodil Marie Stavning","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jette","key":"kofoedped","last":"Kofoed","locid":"641b3779-e4ce-4fb4-86c9-a92ce25dab77","name":"Kofoed, Jette","orcid":"0000-0002-5736-1267","rank":2,"role":"Editor","rolecode":"ped"},{"affno":"2","corresponding":null,"first":"Jonas","key":"fritschpau","last":"Fritsch","locid":"d37cba38-dff2-4c27-a515-226cfadfd849","name":"Fritsch, Jonas","orcid":"0000-0001-9065-2843","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.22387/imbaie","eisbn":["9798729524525"],"isbn":["13 9798729524525"],"pages":"332","place":"Lancaster & Vancouver","publisher":"Imbricate! Press","status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["au-b81f2dc9-f0e7-4aab-9e24-d59980b61f00","itu-6c057bfa-97b6-493a-929d-99976808b02b"],"src":["AU Aarhus University","ITU IT University of Copenhagen"],"title":"Affects, Interfaces, Events","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-089.29-026071","year":"2021","yearsub":"2021"}
{"abstract":"This paper attempts to make a contribution to the growing awareness put forward in this special issue that we need to cultivate new ways of bringing the lived, felt qualities and atmosphere of urban spaces into city planning. The paper proposes thinking with the entanglements, atmospheric politics and qualities of this critical zone and its throwntogetherness of space through an exploration of how affective data might become instrumental in revaluing urban space attuned to an ecologic of change. In the paper, we will present a conceptual foundation for the work in relation to an ongoing collaboration with Byhaven på Sundholm (the City Garden in Sundholm). We will focus on the production of different forms of affective data and how it might influence urban planning and technology design, and reflect on the methodological implications this has for our respective fields of inquiry; evental urbanism and affective interaction design.","author_count":2,"contributors":["Fritsch, Jonas","Samson, Kristine"],"cuid":["S01-000.00-560244"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Atmospheres","Attunement","Co design","Ecological change","Ecologies","Interaction design","Multispecies","Resilient cities","Sustainability","Urban design","Urban space","affective data","evental urbanism"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-RUC"]},"level3all":["DI-U-ITU","DI-U-RUC"]},"review":"nr","rtype":["clu"],"sorti":"an eco logic of change the need for an affective re valuation of urban space","src":["ruc"],"src-code":["DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"rem","url":"https://journals.aau.dk/index.php/gfp/article/view/6424/5605","version":"Published Version"},"id":"S01-000.00-560244","ids":["ruc-3f660854-8aae-4202-a4fc-7ef88041193c"],"keyword":["affective data","atmospheres","attunement","co-design","ecological change","ecologies","evental urbanism","interaction design","multispecies","resilient cities","sustainability","urban design","urban space"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-082AF5B48D1C64ED0E4F7B77F15120DD"],"oa_link":[{"access":"oa","license":"CC BY","type":"rem","url":"https://journals.aau.dk/index.php/gfp/article/view/6424/5605","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of Communication and Arts"],"nora_code":"DI-U-RUC","used":1}],"person":[{"affno":"1","first":"Jonas","key":"fritschpau","last":"Fritsch","name":"Fritsch, Jonas","rank":1,"rolecode":"pau"},{"affno":"2","country":"dk","first":"Kristine","key":"samsonpau","last":"Samson","locid":"d6468fcf-bd8d-4732-9bd3-80eea159b756","name":"Samson, Kristine","orcid":"0000-0002-6685-4194","rank":2,"rolecode":"pau"}],"pub":{"issn":["16018796"],"issue":"35","journal":"Geoforum Perspektiv","pages":"15-25","paperid":"2","status":"p","title":"Geoforum Perspektiv","volume":"19"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Roskilde University","Universities"],"PST":["Published"]},"sid":["ruc-3f660854-8aae-4202-a4fc-7ef88041193c"],"src":["RUC Roskilde University"],"title":"An Eco-Logic of Change : the need for an Affective Re-valuation of Urban Space","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-560244","year":"2020","yearsub":"2020"}
{"abstract":"This paper presents an exploration of play design as a relational strategy to intensify affective encounters during an art museum visit. Theoretically, the paper presents a foundation emphasising the relational aspects of designing playful museum experiences. Based on a detailed and contextual analysis of a mobile web app entitled 'Never let me go', designed to be used in art museums, we show how the app and infrastructure catalysed affective encounters and put the relations between the players, the architecture and the exhibited artworks into motion. In our analysis, we highlight four ways through which the players' experiences were intensified. Finally, we discuss the potential and concerns arising from working with relational play strategies in the design of affectively engaging museum experiences, emphasising emergence, intimacy, ambiguity and trust as key elements.","author_count":2,"contributors":["Ryding, Karin","Fritsch, Jonas"],"cuid":["S01-000.00-384475"],"event":{"acronym":"DIS","title":"ACM Conference on Designing Interactive Systems"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Affective Encounters","Ambiguity in User Experience","Art Interaction","Emergent Play","Intimacy in Design","Mobile Web App","Museum Experience","Play Design","Relational strategies","Trust in Playful Interactions"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"play design as a relational strategy to intensify affective encounters in the art museum","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85567608/Play_Design_as_a_Relational_Strategy_DIS2020_camera_ready.pdf","version":"Authors Final Version"},"id":"S01-000.00-384475","identifier":[{"id":"85090498529","type":"scopus"}],"ids":["itu-d9ac3e3f-3f95-4e4a-b0df-730ab88c4140"],"keyword":["Affective Encounters","Ambiguity in User Experience","Art Interaction","Emergent Play","Intimacy in Design","Mobile Web App","Museum Experience","Play Design","Relational Strategies","Trust in Playful Interactions"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-454671491B5FD7C3FE22689AD332941D"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85567608/Play_Design_as_a_Relational_Strategy_DIS2020_camera_ready.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Karin","key":"rydingpau","last":"Ryding","name":"Ryding, Karin","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jonas","key":"fritschpau","last":"Fritsch","locid":"d37cba38-dff2-4c27-a515-226cfadfd849","name":"Fritsch, Jonas","orcid":"0000-0001-9065-2843","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1145/3357236.3395431","eisbn":["9781450369749"],"pages":"681-693","publisher":"Association for Computing Machinery","status":"p","subtitle":"More than Human centred Design","title":"Proceedings of the 2020 ACM Designing Interactive Systems Conference (DIS '20)"},"review":"Peer Reviewed","scoID":["2-s2.0-85090498529"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-d9ac3e3f-3f95-4e4a-b0df-730ab88c4140"],"src":["ITU IT University of Copenhagen"],"title":"Play Design as a Relational Strategy to Intensify Affective Encounters in the Art Museum","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384475","year":"2020","yearsub":"2020"}
{"abstract":"President of the United States Donald Trump engages in ongoing Twitter-attacks on (perceived) political opponents such as named politicians, celebrities, news channels and named journalists. In June 2015 the New York Times began to compile a list of Trump’s insults on Twitter. By January 2020 the list compiles the “598 People, Places and Things Donald Trump has insulted on Twitter”. In this article, we make use of this list as an archive of condensed affective expressions that allow us to analyse the ways in which Trump uses Twitter to mobilise politically in manners which we will term ‘strategic cyberbullying’. Cyberbullying is often discussed as a phenomenon that arises among children and young people, yet we suggest that borrowing an analytic lens from cyberbullying research allows us to better understand the dynamics of Trump’s use of Twitter for political mobilisation. Through a categorical mapping of the New York Times Archive, we show how political opponents are discredited strategically and a new kind of political territory is established through an intentional circulation of particular interfacial refrains through Twitter. These refrains travel between on- and offline contexts to extend the reach of the campaign through establishing a new form of we-ness that includes and excludes communities. We show how this we-ness in Trump’s affective politics is shaped (also) by the Twitter interface and holds the potential to alter the democratic public and the thresholds for democratic participation.","author_count":3,"contributors":["Fritsch, Jonas","Kofoed, Jette","Reestorff, Camilla Møhring"],"cuid":["S02-090.14-026945"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"corresponding_author":["Reestorff, Camilla Møhring"],"keyword":["Affect","Affective politics","Cyberbullying","Event","INSULTS","Interface","Mobning","Samfund samtid","Teknologiforståelse","Trump"],"level":"sci","mra":["hum","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-ITU"]},"level3all":["DI-U-AU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"strategic cyberbullying and the reorganisation of political culture interfacial refrains interfacial refrains intensities and realdonaldtrump","src":["au","itu"],"src-code":["DI-U-AU","DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.7146/tjcp.v7i1.119856","version":"Published Version"},"id":"S02-090.14-026945","ids":["au-c4e8e85f-a7c7-4d3b-949d-c263ca00337d","itu-522d602b-69e1-47a5-9518-af64cc8d121d"],"keyword":["AFFECT","AFFECTIVE POLITICS","CYBERBULLYING","EVENT","INSULTS","INTERFACE","Mobning","Samfund/samtid","TRUMP","Teknologiforståelse"],"lang":"English","level":"Scientific","mra":["Humanities","Science/Technology"],"noi":["Global-Local-2-3-A314C557124E827192861F761792A71C"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://pure.au.dk/ws/files/219399554/Strategic_Cyberbullying_and_the_Reorganisation_of_Political_Culture_Interfacial_Refrains_Interfacial_Refrains_Intensities_and_RealDonaldTrump.pdf","version":"Published Version"},{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85570860/document_1.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.7146/tjcp.v7i1.119856","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Human-Computer Interaction and Design, Affective Interactions & Relations Lab","IT University of Copenhagen, Play, Culture, and AI, Media, Art & Design"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, Danish School of Education, Danish School of Education - Education Studies, Emdrup"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Jonas","key":"fritschpau","last":"Fritsch","locid":"d37cba38-dff2-4c27-a515-226cfadfd849","name":"Fritsch, Jonas","orcid":"0000-0001-9065-2843","rank":1,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Jette","key":"kofoedpau","last":"Kofoed","locid":"641b3779-e4ce-4fb4-86c9-a92ce25dab77","name":"Kofoed, Jette","orcid":"0000-0002-5736-1267","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Camilla Møhring","key":"reestorffpau","last":"Reestorff","locid":"5ac57b11-8747-4a54-a876-f0537909e5df","name":"Reestorff, Camilla Møhring","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.7146/tjcp.v7i1.119856","issn":["22463755"],"issue":"1","journal":"Conjunctions : transdisciplinary journal of cultural participation","pages":"1-21","publisher":"Aarhus Universitet","status":"p","title":"Conjunctions : transdisciplinary journal of cultural participation","volume":"7"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-c4e8e85f-a7c7-4d3b-949d-c263ca00337d","itu-522d602b-69e1-47a5-9518-af64cc8d121d"],"src":["AU Aarhus University","ITU IT University of Copenhagen"],"title":"Strategic Cyberbullying and the Reorganisation of Political Culture Interfacial Refrains : Interfacial Refrains, Intensities and @RealDonaldTrump","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-090.14-026945","year":"2020","yearsub":"2020"}
{"abstract":"This paper explores the concept of fields of experience as a way to engage with the conditions of emergence of what we might call sentience. As a process of fielding, sensation and processes of sense-making are of an emergent and entangled quality in the overall ecology of experience. We specifically wish to emphasize the dynamics of the closely interrelated conditions for sensing and sense-making – what we conceptualize as ‘shifting immedations’ - and its affective politics. Rather than transgression, ‘shifting’ foregrounds the sometimes almost imperceptible reorientations of fields of experience that are lived immediately as tendencies and vectors for change (feeling the non-sensuous). In particular, we wish to zoom in on specific practices and technologies that might modulate and reorient such experiential fields. We do so by analyzing two cases that emphasize the emergent relations between digital and interactive technologies and their fielding potential; BERMUDA is an interactive installation that attempts to relay affective intensity into tendencies for collective action, whereas the interventions of etcetera emphasize time-sensitive modulations of experience. Exploring these cases, we ask how experiential fields and shifting immediations might allow us to think and act towards new forms of engaging in a politics of sentience beyond the human subject.","author_count":2,"contributors":["Brunner, Christoph","Fritsch, Jonas"],"cuid":["S01-000.00-381562"],"event":{"acronym":"ISEA","title":"International Symposium of Electronic Arts"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Affective politics","Digital technologies","Emergent sentience","Fields of experience","Sense making"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"shifting immediations fields of experience across media art and design","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85551028/PROCEEDING_041120_LR.pdf","version":"Published Version"},"id":"S01-000.00-381562","ids":["itu-137f4f2b-0087-40e5-88ed-14531dc11bed"],"keyword":["Affective politics","Digital technologies","Emergent sentience","Fields of experience","Sense-making"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-06897025CF78E4B848889748CFD4F5C8"],"oa_link":[{"access":"oa","type":"rem","url":"https://isea2020.isea-international.org/PROCEEDING_041120_LR.pdf","version":"Published Version"},{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85551028/PROCEEDING_041120_LR.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Human-Computer Interaction and Design, Affective Interactions & Relations Lab","IT University of Copenhagen, Play, Culture, and AI, Media, Art & Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Christoph","key":"brunnerpau","last":"Brunner","name":"Brunner, Christoph","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jonas","key":"fritschpau","last":"Fritsch","locid":"d37cba38-dff2-4c27-a515-226cfadfd849","name":"Fritsch, Jonas","orcid":"0000-0001-9065-2843","rank":2,"rolecode":"pau"}],"pub":{"eisbn":["9782981641328"],"pages":"91-98","publisher":"ISEA International","status":"p","subtitle":"Proceedings of 26th International Symposium on Electronic Arts","title":"Why Sentience?"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-137f4f2b-0087-40e5-88ed-14531dc11bed"],"src":["ITU IT University of Copenhagen"],"title":"Shifting Immediations: Fields of Experience across Media Art and Design","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381562","year":"2020","yearsub":"2020"}
