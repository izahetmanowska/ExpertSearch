],"person":[{"affno":"1","corresponding":null,"first":"Tariq Osman","key":"andersenpau","last":"Andersen","name":"Andersen, Tariq Osman","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jonas","key":"fritschpau","last":"Fritsch","locid":"d37cba38-dff2-4c27-a515-226cfadfd849","name":"Fritsch, Jonas","orcid":"0000-0001-9065-2843","rank":2,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["itu-1bc57c7c-b9f1-4137-836f-a92815a795da"],"src":["ITU IT University of Copenhagen"],"title":"Affect and Emotions in Patient Data Work","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381683","year":"2018","yearsub":"2018"}
{"abstract":"We are living in a time of ecological and humanitarian crisis that requires imminent action from the joint fields of HCI and interaction design today. This paper presents Affective Interaction Design as an emerging research agenda directly targeting endof-world challenges. To arrive at this, the paper proposes a re-thinking of affect in HCI and interaction design based on recent theoretical advances in cultural and critical theory, in particular emphasizing how a broadened understanding of affect is necessary to better address affectively charged and uncertain situations such as those connected to the end of the world. The paper sketches out how Affective Interaction Design combines conceptual guidelines, design methods, a situational ethics and new ways of assessing the value of affective interactions over time. Finally, the paper outlines three end-of-world frames for engaging with concrete affective design experiments – the end of nature, the end of culture and the end of the human – where digital and interactive technologies can being used on a micro-level to catalyze changes in affective attachments on a macro-level.","author_count":1,"contributors":["Fritsch, Jonas"],"cuid":["S01-000.00-383212"],"event":{"acronym":"DRS","title":"Design Research Society"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"keyword":["Affect theory","Affective Interaction Design","Design theory","Transition design"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"affective interaction design at the end of the world","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-SA","type":"doi","url":"https://doi.org/10.21606/dma.2017.580","version":"Published Version"},"id":"S01-000.00-383212","ids":["itu-83f53b56-8062-459e-92e6-31a18fdd3f12"],"keyword":["Affective Interaction Design","affect theory","design theory","transition design"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-57CAA408FA131B3890D8DDDBFC926DF2"],"oa_link":[{"access":"oa","license":" http://creativecommons.org/licenses/by-nc/4.0/","type":"rem","url":"http://www.drs2018limerick.org/participation/proceedings","version":"Published Version"},{"access":"oa","license":"CC BY-NC-SA","type":"doi","url":"https://doi.org/10.21606/dma.2017.580","version":"Published Version"},{"access":"oa","license":"CC BY-NC-SA","type":"loc","url":"https://pure.itu.dk/ws/files/83711731/DRS_2018_New_Paper_Template_Submission_Camera_Ready_acknowledgments_for_PURE.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Human-Computer Interaction and Design, Affective Interactions & Relations Lab","IT University of Copenhagen, Play, Culture, and AI, Media, Art & Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jonas","key":"fritschpau","last":"Fritsch","locid":"d37cba38-dff2-4c27-a515-226cfadfd849","name":"Fritsch, Jonas","orcid":"0000-0001-9065-2843","rank":1,"rolecode":"pau"}],"pub":{"doi":"10.21606/dma.2017.580","eisbn":["9781912294183"],"pages":"896-908","publisher":"Design Research Society","status":"p","subtitle":"Catalyst","title":"Proceedings of DRS 2018","volume":"3"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-83f53b56-8062-459e-92e6-31a18fdd3f12"],"src":["ITU IT University of Copenhagen"],"title":"Affective Interaction Design at the End of the World","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383212","year":"2018","yearsub":"2018"}
{"abstract":"This paper presents the demo of the interactive listening installation The Living Tree, where surface transducers were deployed in a real-life setting to design immersive and affectively engaging sonic interactions exploring the life of trees. The surface transducer technology emits vibrations through whatever material you press it against, turning the material into a speaker. We present the design of the project which we will demo at DIS and elaborate on how surface transducers can be used as a design material for creating rich interactive experiences.","author_count":4,"contributors":["Blichfeldt, Malthe Emil","Komang-Sønderbek, Jonathan","Højlund Westergård, Frederik","Fritsch, Jonas"],"cuid":["S01-000.00-384842"],"event":{"acronym":"DIS","title":"ACM Conference on Designing Interactive Systems"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Affective engagement","Immersive design","Interactive listening installation","Sonic interactions","Surface transducers"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"the living tree using surface transducers to explore the secret life of trees through sonic interactions","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83701021/DIS_Demo_LifeTrees_CameraReadyDraftPURE.pdf","version":"Authors Final Version"},"id":"S01-000.00-384842","identifier":[{"id":"85054194697","type":"scopus"}],"ids":["itu-f31e0633-9f0b-4da6-a747-12464b404384"],"keyword":["Affective engagement","Immersive design","Interactive listening installation","Sonic interactions","Surface transducers"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-A352563C46D5EEA66D298AEA69ACED96"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83701021/DIS_Demo_LifeTrees_CameraReadyDraftPURE.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Human-Computer Interaction and Design, Affective Interactions & Relations Lab","IT University of Copenhagen, Play, Culture, and AI, Media, Art & Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Malthe Emil","key":"blichfeldtpau","last":"Blichfeldt","name":"Blichfeldt, Malthe Emil","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jonathan","key":"komangsønderbekpau","last":"Komang-Sønderbek","name":"Komang-Sønderbek, Jonathan","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Frederik","key":"højlundwestergårdpau","last":"Højlund Westergård","name":"Højlund Westergård, Frederik","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jonas","key":"fritschpau","last":"Fritsch","locid":"d37cba38-dff2-4c27-a515-226cfadfd849","name":"Fritsch, Jonas","orcid":"0000-0001-9065-2843","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1145/3197391.3205398","eisbn":["9781450356312"],"pages":"327-330","publisher":"Association for Computing Machinery","status":"p","title":"DIS '18 Companion Proceedings of the 2018 ACM Conference Companion Publication on Designing Interactive Systems"},"review":"Peer Reviewed","scoID":["2-s2.0-85054194697"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-f31e0633-9f0b-4da6-a747-12464b404384"],"src":["ITU IT University of Copenhagen"],"title":"The Living Tree: Using Surface Transducers to Explore the Secret Life of Trees through Sonic Interactions","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384842","year":"2018","yearsub":"2018"}
{"abstract":"This presentation takes its point of departure in a transdisciplinary exploration of urban affective encounters and moves towards a revaluation of contemporary urban space from the joint perspectives of evental urbanism and affective interaction design within the frame of the ongoing research project Affects, Interfaces, Events. The city, its planning and design, is primarily driven by economics and architectural regeneration for making profits. By bringing forth urban ecologies and their affective potentials (as value, capacity to affect and to be affected) we argue that it is possible to change the refrains (social, mental, environmental) of the current urban condition. In Three Ecologies, Félix Guattari argues that an eco-logic approach is necessary to initiate real change, forge new value systems and new productions of subjectivity (1989/2000. In our current practice, we have conducted two urban workshops within the frame of ‘Urban Fabric(s)’ where we have explored the relational ecologies of various urban bodies and textures. Within a transdisciplinary group of researchers consisting of interaction designers, artists, engineers and performance interventionists, we have explored the relations and affective capacities inherent in a variety of urban fabrics and layers. Using the body, the senses and an interactive design that enables people to feel WiFi and CO2 as Electric Muscle Stimulation (EMS). At the presentation we will draw on the workshops to propose eco-logical designs for re-articulating and revaluing urban environments. Literature Guattari, F. (2000).The Three Ecologies. The Athlone Press, London and New Brunswick. Massumi, Brian (2018): 99 Theses on the Revalutation of Value. Minnesota Press, McGormack, Derek 2016: Refrains for Moving Bodies. Experience and Experiment in Affective Spaces. Duke University Press.","author_count":2,"contributors":["Fritsch, Jonas","Samson, Kristine"],"cuid":["S01-000.00-559784"],"event":{"end":"2018-08-11","place":"Lancaster;pensylvania, us","start":"2018-08-08","title":"Capacious","year":"2018"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Affect","Affective methodologies","Ecologies","Staying with the trouble","Urban design","Urban space","refrains"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-RUC"]},"level3all":["DI-U-ITU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"change the refrains eco logic design for the revaluation of urban environments","src":["ruc"],"src-code":["DI-U-RUC"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-559784","ids":["ruc-38a0257b-dd76-4c38-91a0-9d8351cbfc2b"],"keyword":["Urban fabrics","affect","affective methodologies","ecologies","refrains","revaluation","staying with the trouble","urban design","urban space"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-80BD7CC41C86555F4E106FE720F05E78"],"org":[{"affno":"1","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of Communication and Arts"],"nora_code":"DI-U-RUC","used":1}],"person":[{"affno":"1","first":"Jonas","key":"fritschpau","last":"Fritsch","name":"Fritsch, Jonas","rank":1,"rolecode":"pau"},{"affno":"2","country":"dk","first":"Kristine","key":"samsonpau","last":"Samson","locid":"d6468fcf-bd8d-4732-9bd3-80eea159b756","name":"Samson, Kristine","orcid":"0000-0002-6685-4194","rank":2,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Roskilde University","Universities"],"PST":["Published"]},"sid":["ruc-38a0257b-dd76-4c38-91a0-9d8351cbfc2b"],"src":["RUC Roskilde University"],"title":"Change the Refrains : Eco-Logic Design for the Revaluation of Urban Environments","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-559784","year":"2018","yearsub":"2018"}
