hagen"],"nora_code":"DI-U-ITU","used":1},{"affno":"3","country":"dk","key":"uc syd university college south denmark","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-UCS","l3nl":"UC SYD, University College South Denmark","l3nn":"UC SYD University College South Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"UC SYD University College South Denmark","namevar":["University College South Denmark"],"nora_code":"DI-UC-UCS","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Morten","key":"breinbjergpau","last":"Breinbjerg","locid":"b02f3aab-f1ab-4748-bb16-255759b46b0d","name":"Breinbjerg, Morten","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Marie Koldkjær","key":"højlundpau","last":"Højlund","locid":"7b303401-4f7c-4178-91b2-73ce1aea503e","name":"Højlund, Marie","name_org":"Højlund, Marie Koldkjær","orcid":"0000-0003-1779-3783","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Morten S.","key":"riispau","last":"Riis","locid":"082a7585-5f84-45a9-ad25-4abd4ca237f1","name":"Riis, Morten S.","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jonas","key":"fritschpau","last":"Fritsch","name":"Fritsch, Jonas","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jonas R.","key":"kirkegaardpau","last":"Kirkegaard","name":"Kirkegaard, Jonas R.","rank":5,"rolecode":"pau"},{"affno":"","first":"Antonella de","key":"angelipedh","last":"Angeli","name":"Angeli, Antonella de","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Liam","key":"bannonpedh","last":"Bannon","name":"Bannon, Liam","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Patrizia","key":"martipedh","last":"Marti","name":"Marti, Patrizia","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Silvia","key":"bordinpedh","last":"Bordin","name":"Bordin, Silvia","rank":9,"rol