{"author_count":2,"contributors":["Foo, Louise Lind","Fritsch, Jonas"],"cuid":["S01-000.00-718909"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"eleven movements of the cryoscape ecological explorations in sonification for affectively engaging with climate change","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://pure.itu.dk/ws/files/102489065/ISEA2023_paper_1189.pdf","version":"Authors Final Version"},"id":"S01-000.00-718909","ids":["itu-bc65ac1b-7bee-4bd4-9535-e7b8f6cc6cd5"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-C4CD6EE781E475D7739D6325F7E02F53"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://pure.itu.dk/ws/files/102489065/ISEA2023_paper_1189.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Human-Computer Interaction and Design, Affective Interactions & Relations Lab","IT University of Copenhagen, Human-Computer Interaction and Design, Interaction Design Research Group"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Louise Lind","key":"foopau","last":"Foo","name":"Foo, Louise Lind","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jonas","key":"fritschpau","last":"Fritsch","locid":"d37cba38-dff2-