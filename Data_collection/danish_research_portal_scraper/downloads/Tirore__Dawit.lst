{"abstract":"A runtime monitor observes a running system and checks whether the sequence of events the system generates satisfies a given specification. We describe the evolution of VeriMon: an expressive and efficient monitor that has been formally verified using the Isabelle proof assistant.","author_count":16,"contributors":["Basin, David","Dardinier, Thibault","Hauser, Nico","Heimes, Lukas","Huerta y Munive, Jonathan Julián","Kaletsch, Nicolas","Krstić, Srđan","Marsicano, Emanuele","Raszyk, Martin","Schneider, Joshua","Tirore, Dawit Legesse","Traytel, Dmitriy","Zingg, Sheila"],"cuid":["S01-000.00-513967"],"event":{"end":"2022-09-29","place":"Tbilisi, ge","start":"2022-09-27","title":"19th International Colloquium on Theoretical Aspects of Computing, ICTAC 2022","year":"2022"},"filters":{"added":"2022-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["Switzerland"],"glorg":["All Global Affiliations","DFINITY","ETH Zürich"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"verimon a formally verified monitoring tool","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"https://rightsstatements.org/page/InC-NC/1.0/","type":"loc","url":"https://curis.ku.dk/ws/files/380421159/VeriMon_A_Formally_Verified_Monitoring_Tool_2_6.pdf","version":"Authors Final Version"},"id":"S01-000.00-513967","identifier":[{"id":"85140762044","type":"scopus"}],"ids":["ku-c9d1d1a8-e016-4a72-9a07-4914bcc9c003"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-930C163D937C0BF9624BEAFA262D144D"],"oa_link":[{"access":"oa","license":"https://rightsstatements.org/page/InC-NC/1.0/","type":"loc","url":"https://curis.ku.dk/ws/files/380421159