 of Public Health, Section of Biostatistics"],"nora_code":"DI-U-KU","used":1},{"affno":"5","country":"us","key":"university of rhode island","loc":["United States","America, North","OECD"],"name":"University of Rhode Island","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Amalie","key":"timmermannclaraamaliegadepau","last":"Timmermann","locid":"ef4cdb08-0ef3-4bcc-9af2-af41b0cb1945","name":"Timmermann, Clara Amalie Gade","name_org":"Timmermann, Amalie","orcid":"0000-0001-9847-2038","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Isik S","key":"johansenisiksomuncupau","last":"Johansen","locid":"d7a439ff-f0ad-43c9-80d8-a269647e1886","name":"Johansen, Isik Somuncu","name_org":"Johansen, Isik S","orcid":"0000-0002-2189-9823","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Martin","key":"tolstrupmartinpau","last":"Tolstrup","locid":"36e9f1d5-608c-46b7-8d41-2505c02086fc","name":"Tolstrup, Martin","orcid":"0000-0001-7020-5173","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Carsten","key":"heilmanncarstenpau","last":"Heilmann","name":"Heilmann, Carsten","rank":4,"rolecode":"pau"},{"affno":"4","first":"Esben","key":"budtzjørgensenesbenpau","last":"Budtz-Jørgensen","locid":"c4ebc45c-df67-437e-a5e9-bdaa629d7caa","name":"Budtz-Jørgensen, Esben","orcid":"0000-0002-5551-0724","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Janne S","key":"tolstrupjanneschurmannpau","last":"Tolstrup","locid":"c03b1732-7c6e-404e-a542-e7d02e2b2575","name":"Tolstrup, Janne Schurmann","name_org":"Tolstrup, Janne S","orcid":"0000-0002-9796-3967","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Flemming","key":"nielsenflemmingpau","last":"Nielsen","locid":"a3417ee2-84f4-4f19-ab48-919e04e98666","name":"Nielsen, Flemming","orcid":"0000-0002-5657-405X","rank":7,"rolecode":"pau"},{"affno":"1 5","corresponding":null,"first":"Philippe","key":"grandjeanphilippepau","last":