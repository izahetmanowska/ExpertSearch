de":"pau"},{"affno":"","corresponding":null,"first":"Iliano","key":"cervesatopau","last":"Cervesato","name":"Cervesato, Iliano","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Frank","key":"pfenningpau","last":"Pfenning","name":"Pfenning, Frank","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Robert J","key":"simmonspau","last":"Simmons","name":"Simmons, Robert J","rank":4,"rolecode":"pau"}],"pub":{"pages":"14-19","status":"p","title":"Proceedings of the 26th International Workshop on Unification (UNIF 26)"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-2403e43f-4266-412d-9a8d-0b094e9b5129"],"src":["ITU IT University of Copenhagen"],"title":"On Matching Concurrent Traces","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381809","year":"2012","yearsub":"2014"}
{"abstract":"In intuitionistic sequent calculi, detecting that a sequent is unprovable is often used to direct proof search. This is for instance seen in backward chaining, where an unprovable subgoal means that the proof search must backtrack. In undecidable logics, however, proof search may continue indefinitely, finding neither a proof nor a disproof of a given subgoal. In this paper we characterize a family of truth-preserving abstractions from intuitionistic first-order logic to the monadic fragment of classical first-order logic. Because they are truthful, these abstractions can be used to disprove sequents in intuitionistic first-order logic.","author_count":2,"contributors":["Brock-Nannestad, Taus","Schürmann, Carsten"],"cuid":["S01-000.00-384818"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Backward chaining","Intuitionistic sequent calculi","Monadic fragment","Proof search","Unprovable sequents"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"truthful monadic abstractions","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-3-642-31365-3_10","version":"Other Version"},"id":"S01-000.00-384818","identifier":[{"id":"84863633089","type":"scopus"}],"ids":["itu-f15b8fdf-0ec4-4040-b0b0-7cde237b799c"],"keyword":["Backward chaining","Intuitionistic sequent calculi","Monadic fragment","Proof search","Unprovable sequents"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-0A089F0278AC00F3E52CD7860B432384"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-3-642-31365-3_10","version":"Other Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Theoretical Computer Science, Programming Logic and Semantics","The Department, Theoretical Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Taus","key":"brocknannestadpau","last":"Brock-Nannestad","name":"Brock-Nannestad, Taus","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Carsten","key":"schürmannpau","last":"Schürmann","locid":"1313519f-2074-41d6-8b79-589648e37211","name":"Schürmann, Carsten","orcid":"0000-0003-4793-0099","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-642-31365-3_10","isbn":["9783642313646"],"issn":["03029743"],"pages":"97-110","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","title":"IJCAR'12 Proceedings of the 6th international joint conference on Automated Reasoning","volume":"7364"},"review":"Peer Reviewed","scoID":["2-s2.0-84863633089"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-f15b8fdf-0ec4-4040-b0b0-7cde237b799c"],"src":["ITU IT University of Copenhagen"],"title":"Truthful Monadic Abstractions","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384818","year":"2012","yearsub":"2012"}
{"abstract":"Current approaches to electronic implementations of voting protocols involve translating legal text to source code of an imperative programming language. Because the gap between legal text and source code is very large, it is difficult to trust that the program meets its legal specification. In response, we promote linear logic as a high-level language for both specifying and implementing voting protocols. Our linear logical specifications of the single-winner first-past-the-post (SW- FPTP) and single transferable vote (STV) protocols demonstrate that this approach leads to concise implementations that closely correspond to their legal specification, thereby increasing trust.","author_count":2,"contributors":["DeYoung, Henry","Schürmann, Carsten"],"cuid":["S01-000.00-384306"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Carnegie Mellon University"],"keyword":["Electronic Voting","Legal Specification","Linear Logic","Trust in Software","Voting Protocols"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"linear logical voting protocols","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84867447717","version":"Other Version"},"id":"S01-000.00-384306","identifier":[{"id":"84867447717","type":"scopus"}],"ids":["itu-cf5f931b-9480-46f9-81ab-80333cfefadc"],"keyword":["Electronic Voting","Legal Specification","Linear Logic","Trust in Software","Voting Protocols"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-5-26DEC6A21DB42229022D888D6DF16B17"],"org":[{"affno":"1","country":"us","key":"carnegie mellon university","loc":["United States","America, North","OECD"],"name":"Carnegie Mellon University","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Theoretical Computer Science, Programming Logic and Semantics","The Department, Theoretical Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Henry","key":"deyoungpau","last":"DeYoung","name":"DeYoung, Henry","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Carsten","key":"schürmannpau","last":"Schürmann","locid":"1313519f-2074-41d6-8b79-589648e37211","name":"Schürmann, Carsten","orcid":"0000-0003-4793-0099","rank":2,"rolecode":"pau"}],"pub":{"issn":["03029743","16113349"],"issn_org":["03029743"],"journal":"Lecture Notes in Computer Science","pages":"53-70","publisher":"Springer","status":"p","title":"Lecture Notes in Computer Science","volume":"7187"},"review":"Peer Reviewed","scoID":["2-s2.0-84867447717"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-cf5f931b-9480-46f9-81ab-80333cfefadc"],"src":["ITU IT University of Copenhagen"],"title":"Linear Logical Voting Protocols","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384306","year":"2012","yearsub":"2012"}
{"abstract":"Explicit substitution calculi can be classified into several dis- tinct categories depending on whether they are confluent, meta-confluent, strong normalization preserving, strongly normalizing, simulating, fully compositional, and/or local. In this paper we present a variant of the λσ-calculus, which satisfies all seven conditions. In particular, we show how to circumvent Mellies counter-example to strong normalization by a slight restriction of the congruence rules. The calculus is implemented as the core data structure of the Celf logical framework. All meta-theoretic aspects of this work have been mechanized in the Abella proof assistant.","author_count":2,"contributors":["Schack-Nielsen, Anders","Schürmann, Carsten"],"cuid":["S01-000.00-383817"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Calculus","Confluence","Explicit Substitution Calculi","Proof Assistant Abella","Strong Normalization"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"nr","rtype":["clu"],"sorti":"the lambda sigma calculus and strong normalization","src":["itu"],"src-code":["DI-U-ITU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/108313418/ITU2011150pdf.pdf","version":"Published Version"},"id":"S01-000.00-383817","ids":["itu-af2fa44b-a67a-462c-ba8a-af1ba37fe9e2"],"keyword":["Confluence","Explicit Substitution Calculi","Proof Assistant (Abella)","Strong Normalization","λσ-calculus"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-9524A6BA128B2375AD82CAAF973727E0"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/108313418/ITU2011150pdf.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Anders","key":"schacknielsenpau","last":"Schack-Nielsen","name":"Schack-Nielsen, Anders","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Carsten","key":"schürmannpau","last":"Schürmann","locid":"1313519f-2074-41d6-8b79-589648e37211","name":"Schürmann, Carsten","orcid":"0000-0003-4793-0099","rank":2,"rolecode":"pau"}],"pub":{"isbn":["9788779492493"],"issn":["16006100"],"issue":"TR-2011-150","pages":"13","place":"Copenhagen","publisher":"IT-Universitetet i København","repno":"IT University Technical Report Series, TR-2011-150","series":"IT University Technical Report Series","status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-af2fa44b-a67a-462c-ba8a-af1ba37fe9e2"],"src":["ITU IT University of Copenhagen"],"title":"The lambda sigma calculus and strong normalization","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383817","year":"2011","yearsub":"2011"}
{"abstract":"Abstract. When one implements a logical framework based on linear type theory, for example the Celf system [?], one is immediately con- fronted with questions about their equational theory and how to deal with logic variables. In this paper, we propose linear contextual modal type theory that gives a mathematical account of the nature of logic variables. Our type theory is conservative over intuitionistic contextual modal type theory proposed by Nanevski, Pfenning, and Pientka. Our main contributions include a mechanically checked proof of soundness and a working implementation.","author_count":2,"contributors":["Schack-Nielsen, Anders","Schürmann, Carsten"],"cuid":["S01-000.00-384693"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Contextual Modal Type Theory","Equational Theory","Linear Type Theory","Logical Framework","Soundness Proof"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"nr","rtype":["clu"],"sorti":"linear contextual modal type theory","src":["itu"],"src-code":["DI-U-ITU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/108202391/ITUTR151pdf.pdf","version":"Published Version"},"id":"S01-000.00-384693","ids":["itu-e87d09dd-2a80-4937-8ff0-d295fcdfab4e"],"keyword":["Contextual Modal Type Theory","Equational Theory","Linear Type Theory","Logical Framework","Soundness Proof"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-4125313A61CE1088EEEF8825D61E23B6"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/108202391/ITUTR151pdf.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Anders","key":"schacknielsenpau","last":"Schack-Nielsen","name":"Schack-Nielsen, Anders","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Carsten","key":"schürmannpau","last":"Schürmann","locid":"1313519f-2074-41d6-8b79-589648e37211","name":"Schürmann, Carsten","orcid":"0000-0003-4793-0099","rank":2,"rolecode":"pau"}],"pub":{"isbn":["9788779492509"],"issn":["16006100"],"issue":"TR-2011-151","pages":"6","place":"Copenhagen","publisher":"IT-Universitetet i København","repno":"IT University Technical Report Series, TR-2011-151","series":"IT University Technical Report Series","status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-e87d09dd-2a80-4937-8ff0-d295fcdfab4e"],"src":["ITU IT University of Copenhagen"],"title":"Linear contextual modal type theory","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384693","year":"2011","yearsub":"2011"}
{"abstract":"In this paper, we present a model based on relations for bigraphical reactive system [Milner09]. Its defining characteristics are that validity and reaction relations are captured as traces in a multi-set rewriting system. The relational model is derived from Milner's graphical definition and directly amenable to implementation.","author_count":2,"contributors":["Beauquier, Maxime","Schürmann, Carsten"],"cuid":["S01-000.00-383441"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Bigraphical Reactive Systems","Graphical Definition","Multi set Rewriting","Relational model","Trace based Validity"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"a bigraph relational model","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.4204/EPTCS.71.2","version":"Other Version"},"id":"S01-000.00-383441","identifier":[{"id":"84952670091","type":"scopus"}],"ids":["itu-93d14909-8ac1-4e9e-91d1-fefe80f9a0d8"],"keyword":["Bigraphical Reactive Systems","Graphical Definition","Multi-set Rewriting","Relational Model","Trace-based Validity"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-BF9D2A82AEDDEDDA3A247E20F7FC6A3F"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.4204/EPTCS.71.2","version":"Other Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"","corr