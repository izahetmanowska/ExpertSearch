":"27-29","publisher":"Association for Computing Machinery","status":"p","title":"Communications of the ACM","title_org":"Association for Computing Machinery. Communications","volume":"2011"},"review":"Undetermined","scoID":["2-s2.0-80053465559"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-3024c838-4cb0-4a14-b533-e1796ad57c2f"],"src":["ITU IT University of Copenhagen"],"title":"Modernizing the Danish democratic process","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381977","year":"2011","yearsub":"2011"}
