/s00446-017-0295-1","issn":["01782770","14320452"],"issn_org":["01782770"],"issue":"1","journal":"Distributed Computing","pages":"51-67","publisher":"Springer","status":"p","title":"Distributed Computing","volume":"31"},"review":"Peer Reviewed","scoID":["2-s2.0-85014780411"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["itu-f7135657-c5c5-4002-9c1e-09b2a3cfb963","sdu-ccd494a0-74af-4b09-989b-9de5e268c89e"],"src":["ITU IT University of Copenhagen","SDU University of Southern Denmark"],"title":"Choreographies, logically","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-038412","year":"2018","yearsub":"2018"}
{"abstract":"Ephemeral Diffie-Hellman over COSE (EDHOC) [1] is an authentication protocol that aims to replace TLS for resource constrained Internet of Things (IoT) devices using a selection of lightweight ciphers and formats. It is inspired by the newest Internet Draft of TLS 1.3 [2] and includes reduced round-trip modes. Unlike TLS 1.3, EDHOC is designed from scratch, and does not have to support legacy versions of the protocol. As the protocol is neither well-known nor has been used in practice it has not been scrutinized to the extent it should be. The objective of this paper is to verify security properties of the protocol, including integrity, secrecy, and perfect forward secrecy properties. We use ProVerif [3] to analyze these properties formally. We describe violations of specific security properties for the reduced round-trip modes. The flaws were reported to the authors of the EDHOC protocol.","author_count":6,"contributors":["Bruni, Alessandro","Jørgensen, Thorvald Sahl","Petersen, Theis Grønbech","Schürmann, Carsten"],"cuid":["S01-000.00-695294"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Authentication Protocol","Lightweight Ciphers","Reduced Round Trip Modes","Resource Constrained IoT","Security Verification"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"formal verification of ephemeral diffie hellman over cose edhoc","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85057821719","version":"Other Version"},"id":"S01-000.00-695294","identifier":[{"id":"85057821719","type":"scopus"}],"ids":["itu-c7b33167-e79f-409e-9e41-6b1a4fc88231"],"keyword":["Authentication Protocol","Lightweight Ciphers","Reduced Round-Trip Modes","Resource Constrained IoT","Security Verification"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-ECAE8613A6616ACBDC99D6F54E5B82C6"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Theoretical Computer Science, Programming Logic and Semantics"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Alessandro","key":"brunipau","last":"Bruni","locid":"5c50bbc9-ed3d-417f-ba4d-e484eaf536b3","name":"Bruni, Alessandro","orcid":"0000-0003-2946-9462","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Thorvald Sahl","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, Thorvald Sahl","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Theis Grønbech","key":"petersenpau","last":"Petersen","name":"Petersen, Theis Grønbech","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Carsten","key":"schürmannpau","last":"Schürmann","locid":"1313519f-2074-41d6-8b79-589648e37211","name":"Schürmann, Carsten","orcid":"0000-0003-4793-0099","rank":4,"rolecode":"pau"},{"affno":"","first":"Cas","key":"cremerspedh","last":"Cremers","name":"Cremers, Cas","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Anja","key":"lehmannpedh","last":"Lehmann","name":"Lehmann, Anja","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-030-04762-7_2","eisbn":["9783030047627"],"isbn":["9783030047610"],"pages":"21-36","place":"Darmstadt, Germany","publisher":"Springer","status":"p","subtitle":"4th International Conference","title":"Security Standardisation Research"},"review":"Peer Reviewed","scoID":["2-s2.0-85057821719"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-c7b33167-e79f-409e-9e41-6b1a4fc88231"],"src":["ITU IT University of Copenhagen"],"title":"Formal Verification of Ephemeral Diffie-Hellman Over COSE (EDHOC)","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-695294","year":"2018","yearsub":"2018"}
{"abstract":"We present the voting protocol Eos that is based on a conditional linkable ring signatures scheme. Voters are organized in rings allowing them to sign votes anonymously. Voters may assume multiple pseudo identities, one of which is legitimate. We use the others to signal coercion to the Election Authority. Eos uses two mixing phases with the goal to break the connection between the voter and vote, not to preserve vote privacy (which is given already) but to guarantee coercion resistance by making it (nearly) impossible for a coercer to follow their vote through the bulletin board. Eos is universally verifiable.","author_count":2,"contributors":["Patachi, Stefan","Schürmann, Carsten"],"cuid":["S01-000.00-382522"],"event":{"acronym":"E-VOTE-ID","title":"International Joint Conference on Electronic Voting"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Anonymous Voting","Coercion resistance","Conditional Linkable Ring Signatures","Mixing Phases","Universal Verifiability"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"eos a universal verifiable and coercion resistant voting protocol","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83008115/main.pdf","version":"Pre-print"},"id":"S01-000.00-382522","identifier":[{"id":"85032510628","type":"scopus"}],"ids":["itu-53dfbf13-03c7-41fa-8a71-e4f8cb385268"],"keyword":["Anonymous Voting","Coercion Resistance","Conditional Linkable Ring Signatures","Mixing Phases","Universal Verifiability"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-0B4DCF60FC4B7F3A5BB7515C3C3F04C7"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83008115/main.pdf","version":"Pre-print"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Stefan","key":"patachipau","last":"Patachi","name":"Patachi, Stefan","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Carsten","key":"schürmannpau","last":"Schürmann","locid":"1313519f-2074-41d6-8b79-589648e37211","name":"Schürmann, Carsten","orcid":"0000-0003-4793-0099","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-319-68687-5_13","eisbn":["9783319686875"],"isbn":["9783319686868"],"issn":["03029743"],"pages":"210-227","place":"Bregenz/Lochau","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","subtitle":"Second International Joint Conference, E-Vote-ID 2017, Bregenz, Austria, October 24-27, 2017, Proceedings","title":"Electronic Voting"},"review":"Peer Reviewed","scoID":["2-s2.0-85032510628"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-53dfbf13-03c7-41fa-8a71-e4f8cb385268"],"src":["ITU IT University of Copenhagen"],"title":"Eos a Universal Verifiable and Coercion Resistant Voting Protocol","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382522","year":"2017","yearsub":"2017"}
{"abstract":"Selene is a novel voting protocol that supports individual verifiability, Vote-Privacy and Receipt-Freeness. The scheme provides tracker numbers that allow voters to retrieve their votes from a public bulletin board and a commitment scheme that allows them to hide their vote from a potential coercer. So far, however, Selene was never stud- ied formally. The Selene protocol was neither completely formalized, nor were the correctness proofs for Vote-Privacy and Receipt-Freeness. In this paper, we give a formal model for a simplified version of Selene in the symbolic model, along with a machine-checked proof of Vote-Privacy and Receipt-Freeness. All proofs are checked with the Tamarin theorem prover.","author_count":3,"contributors":["Bruni, Alessandro","Drewsen, Eva","Schürmann, Carsten"],"cuid":["S01-000.00-382630"],"event":{"acronym":"E-VOTE-ID","title":"International Joint Conference on Electronic Voting"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Formal verification","Receipt Freeness","Selene voting protocol","Vote Privacy","individual verifiability"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"towards a mechanized proof of selene receipt freeness and vote privacy","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83008086/selene.pdf","version":"Authors Final Version"},"id":"S01-000.00-382630","identifier":[{"id":"85032468251","type":"scopus"}],"ids":["itu-5b7ee4de-0c82-4005-9522-049ba1a27075"],"keyword":["Receipt-Freeness","Selene voting protocol","Vote-Privacy","formal verification","individual verifiability"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-F549A330BD92FB15ED08504DA35B0856"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83008086/selene.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Theoretical Computer Science, Programming Logic and Semantics"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Alessandro","key":"brunipau","last":"Bruni","locid":"5c50bbc9-ed3d-417f-ba4d-e484eaf536b3","name":"Bruni, Alessandro","orcid":"0000-0003-2946-9462","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Eva","key":"drewsenpau","last":"Drewsen","name":"Drewsen, Eva","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Carsten","key":"schürmannpau","last":"Schürmann","locid":"1313519f-2074-41d6-8b79-589648e37211","name":"Schürmann, Carsten","orcid":"0000-0003-4793-0099","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-319-68687-5_7","isbn":["9783319686868"],"issn":["03029743"],"pages":"110-126","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","title":"Electronic Voting - Second International Joint Conference, E-Vote-ID 2017, Bregenz, Austria, October 24-27, 2017, Proceedings"},"review":"Peer Reviewed","scoID":["2-s2.0-85032468251"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-5b7ee4de-0c82-4005-9522-049ba1a27075"],"src":["ITU IT University of Copenhagen"],"title":"Towards a Mechanized Proof of Selene Receipt-Freeness and Vote-Privacy","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382630","year":"2017","yearsub":"2017"}
{"author_count":2,"contributors":["Schürmann, Carsten","Stauning, Søren"],"cuid":["S01-000.00-383445"],"event":{"acronym":"E-VOTE-ID","title":"International Joint Conference on Electronic Voting"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Økonomi- og Indenrigsministeriet"],"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"party endorsement systems and internet voting","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://www.e-vote-id.org/wp-content/uploads/2017/10/TUTPress-2017.pdf","version":"Published Version"},"id":"S01-000.00-383445","ids":["itu-941ea277-9653-4d57-866b-38f1244438d4"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-945B281691206D4936B38AD51200E39C"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.e-vote-id.org/wp-content/uploads/2017/10/TUTPress-2017.pdf","version":"Published Version"},{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83008205/paper_25.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Økonomi- og Indenrigsministeriet"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Carsten","key":"schürmannpau","last":"Schürmann","locid":"1313519f-2074-41d6-8b79-589648e37211","name":"Schürmann, Carsten","orcid":"0000-0003-4793-0099","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Søren","key":"stauningpau","last":"Stauning","name":"Stauning, Søren","rank":2,"rolecode":"pau"}],"pub":{"isbn":["9789949831388"],"pages":"207-208","place":"Tallinn","publisher":"TUT Press","status":"p","subtitle":"Second International Joint Conference, E-Vote-ID 2017, Bregenz, Austria, October 24-27, 2017, Proceedings","title":"E-Vote-ID 2017"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["itu-941ea277-9653-4d57-866b-38f1244438d4"],"src":["ITU IT University of Copenhagen"],"title":"Party Endorsement Systems and Internet Voting.","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383445","year":"2017","yearsub":"2017"}
{"abstract":"We propose a Curry–Howard correspondence between a language for programming multiparty sessions and a generalisation of Classical Linear Logic (CLL). In this framework, propositions correspond to the local behaviour of a participant in a multiparty session type, proofs to processes, and proof normalisation to executing communications. Our key contribution is generalising duality, from CLL, to a new notion of n-ary compatibility, called coherence. Building on coherence as a principle of compositionality, we generalise the cut rule of CLL to a new rule for composing many processes communicating in a multiparty session. We prove the soundness of our model by showing the admissibility of our new rule, which entails deadlock-freedom via our correspondence.","author_count":4,"contributors":["Carbone, Marco","Montesi, Fabrizio","Montesi, Fabrizio","Schürmann, Carsten","Yoshida, Nobuko"],"cuid":["S02-097.45-038362"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"continent":["Europe, Non-EU","OECD"],"corresponding_author":["Montesi, Fabrizio"],"country":["United Kingdom"],"glorg":["All Global Affiliations","Imperial College London"],"keyword":["Linear Logic","Local Type","Parallel Composition","Proof System","Proof theory"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-SDU"]},"level3all":["DI-U-ITU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"multiparty session types as coherence proofs","src":["itu","sdu"],"src-code":["DI-U-ITU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/83025669/Multiparty_session_types_as_coherence_proofs.pdf","version":"Authors Final Version"},"funding_acknowledgement":["We thank Kim Skak Larsen and the anonymous reviewers for their useful comments. Montesi was supported by CRC (Choreographies for Reliable and efficient Communication software), grant no. DFF?4005-00304 from the Danish Council for Independent Research. Sch?rmann was partly supported by DemTech, grant no. 10-092309 from the Danish Council for Strategic Research. Yoshida was partially sponsored by the EPSRC EP/K011715/1, EP/K034413/1, EP/L00058X/1, and EU project FP7-612985 UpScale. This work is also supported by the COST Action IC1201 BETTY."],"id":"S02-097.45-038362","identifier":[{"id":"84995495349","type":"scopus"}],"ids":["itu-aac6755a-e508-4671-ba1e-88386a79257f","sdu-bf18d070-2ef5-4420-841b-91846e2af61c"],"keyword":["Linear Logic","Local Type","Parallel Composition","Proof System","Proof Theory"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-3D19E5F63DE3E53231AC750CA4F4C496"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/83025669/Multiparty_session_types_as_coherence_proofs.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Theoretical Computer Science, Programming Logic and Semantics"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Science, Department of Mathematics and Computer Science","SDU, Faculty of Science, Department of Mathematics and Computer Science, Computer Science"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","country":"gb","key":"imperial college london","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Imperial College London","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Marco","key":"carbonemarcopau","last":"Carbone","locid":"9027b41a-4159-4db7-9ddd-8fc8f41f1fb3","name":"Carbone, Marco","orcid":"0000-0001-9479-2632","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Fabrizio","key":"montesifabriziopau","last":"Montesi","locid":"81d9220c-ba43-48b1-aa21-129c942a9c92","name":"Montesi, Fabrizio","orcid":"0000-0003-4666-901X","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Carsten","key":"schürmanncarstenpau","last":"Schürmann","locid":"1313519f-2074-41d6-8b79-589648e37211","name":"Schürmann, Carsten","orcid":"0000-0003-4793-0099","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Nobuko","key":"yoshidanobukopau","last":"Yoshida","name":"Yoshida, Nobuko","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1007/s00236-016-0285-y","issn":["00015903","14320525"],"issn_org":["00015903"],"issue":"3","journal":"Acta Informatica","pages":"243-269","publisher":"Springer","status":"p","title":"Acta Informatica","volume":"54"},"review":"Peer Reviewed","scoID":["2-s2.0-84995495349"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["itu-aac6755a-e508-4671-ba1e-88386a79257f","sdu-bf18d070-2ef5-4420-841b-91846e2af61c"],"src":["ITU IT University of Copenhagen","SDU University of Southern Denmark"],"title":"Multiparty session types as coherence proofs","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-097.45-038362","year":"2017","yearsub":"2017"}
{"abstract":"The theory of risk-limiting audits is well-understood, at least mathematically. Such audits serve to create confidence in the reported election outcome by checking the evidence created during the election. When election officials introduce election technologies into the voting process, it is best to do this after the appropriate auditing framework has been implemented. In this paper, we describe our experiences with piloting a risk-limiting audit of a referendum that was held in Denmark on December 3, 2015. At the time of the publication of this paper, Denmark’s election law did not permit electronic voting technologies to be used during voting allowing us to study auditing in isolation. Our findings are that (1) risk-limiting audits also apply to paper and pencil elections; (2) election officials usually support risk-limiting audits even if no voting technologies are used because these audits can improve the efficiency of the manual count; (3) that practical and organizational challenges must be overcome to keep audits repeatable, in particular it must be possible to identify individual ballots repeatedly and reliably; (4) it is possible to arrange an audit for the result of an earlier stage in a count during a later stage, for example, an audit of the rough count results fine count; and (5) that whenever the electronic voting technologies are considered, auditing should be considered as part of feasibility study.","author_count":1,"contributors":["Schürmann, Carsten"],"cuid":["S01-000.00-381649"],"event":{"acronym":"E-VOTE-ID","title":"International Joint Conference on Electronic Voting"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"1 contributor","cluster_size":1,"keyword":["Auditing framework","Election outcome verification","Manual vote count efficiency","Organizational audit challenges","Risk limiting audits"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"a risk limiting audit in denmark a pilot","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83008080/rla.pdf","version":"Authors Final Version"},"id":"S01-000.00-381649","identifier":[{"id":"85011545884","type":"scopus"}],"ids":["itu-19705f62-b4be-47bd-934d-adb84ce20354"],"keyword":["Auditing framework","Election outcome verification","Manual vote count efficiency","Organizational audit challenges","Risk-limiting audits"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-8EFDB563BC10072BC69A5E051C8D6DD8"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83008080/rla.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Carsten","key":"schürmannpau","last":"Schürmann","locid":"1313519f-2074-41d6-8b79-589648e37211","name":"Schürmann, Carsten","orcid":"0000-0003-4793-0099","rank":1,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-319-52240-1_12","eisbn":["9783319522401"],"isbn":["9783319522395"],"issn":["03029743"],"pages":"192-202","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","title":"First International Joint Conference, E-Vote-ID 2016, Bregenz, Austria, October 18-21, 2016, Proceedings"},"review":"Peer Reviewed","scoID":["2-s2.0-85011545884"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-19705f62-b4be-47bd-934d-adb84ce20354"],"src":["ITU IT University of Copenhagen"],"title":"A Risk-Limiting Audit In Denmark: A Pilot","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381649","year":"2017","yearsub":"2017"}
{"abstract":"A risk-limiting audit is a statistical method to create confidence in the correctness of an election result by checking samples of paper ballots. In order to perform an audit, one usually needs to know what the election margin is, i.e., the number of votes that would need to be changed in order to change the election outcome. In this paper, we present a fully automatic method for computing election margins. It is based on the program analysis technique of bounded model checking to analyse the implementation of the election function. The method can be applied to arbitrary election functions without understanding the actual computation of the election result or without even intuitively knowing how the election function works. We have implemented our method based on the model checker CBMC; and we present a case study demonstrating that it can be applied to real-world elections.","author_count":4,"contributors":["Beckert, Bernhard","Kirsten, Michael","Klebanov, Vladimir","Schürmann, Carsten"],"cuid":["S01-000.00-383197"],"event":{"acronym":"E-VOTE-ID","title":"International Joint Conference on Electronic Voting"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","Karlsruhe Institute of Technology"],"keyword":["Bounded model checking","CBMC implementation","Election function verification","Election margin computation","Risk limiting audit"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"automatic margin computation for risk limiting audits","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/81851111/evoteid2016.pdf","version":"Authors Final Version"},"id":"S01-000.00-383197","identifier":[{"id":"85011621069","type":"scopus"}],"ids":["itu-832a35a8-8e90-480d-9e66-2018927d97d6"],"keyword":["Bounded model checking","CBMC implementation","Election function verification","Election margin computation","Risk-limiting audit"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-91B98EFD7CC131362041C84664E269BD"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/81851111/evoteid2016.pdf","version":"Authors Final Version"},{"access":"oa","type":"rem","url":"http://formal.iti.kit.edu/~beckert/pub/evoteid2016.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","country":"de","key":"karlsruhe institute of technology","loc":["Germany","Europe, EU","OECD"],"name":"Karlsruhe Institute of Technology","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Bernhard","key":"beckertpau","last":"Beckert","name":"Beckert, Bernhard","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Michael","key":"kirstenpau","last":"Kirsten","name":"Kirsten, Michael","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Vladimir","key":"klebanovpau","last":"Klebanov","name":"Klebanov, Vladimir","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Carsten","key":"schürmannpau","last":"Schürmann","locid":"1313519f-2074-41d6-8b79-589648e37211","name":"Schürmann, Carsten","orcid":"0000-0003-4793-0099","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-319-52240-1_2","eisbn":["9783319522401"],"isbn":["9783319522395"],"issn":["03029743"],"pages":"18-35","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","title":"First International Joint Conference, E-Vote-ID 2016, Bregenz, Austria, October 18-21, 2016, Proceedings"},"review":"Peer Reviewed","scoID":["2-s2.0-85011621069"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-832a35a8-8e90-480d-9e66-2018927d97d6"],"src":["ITU IT University of Copenhagen"],"title":"Automatic Margin Computation for Risk-Limiting Audits","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383197","year":"2017","yearsub":"2017"}
{"abstract":"We discuss a new type of attack on voting systems that in contrast to attacks described in the literature does not disrupt the expected behavior of the voting system itself. Instead the attack abuses the normal functionality to link the tallying of the election to disclosing sensitive information assumed to be held by the adversary. Thus the attack forces election officials to choose between two undesirable options: Not to publish the election result or to play into the adversary’s hand and to publicize sensitive information We stress that the attack is different from extortion and not restricted to electronic voting systems.","author_count":7,"contributors":["Wikström, Douglas","Barrat, Jordi","Heiberg, Sven","Krimmer, Robert","Schürmann, Carsten","Lipmaa, Helger","Teague, Vanessa"],"cuid":["S01-000.00-384292"],"event":{"acronym":"E-VOTE-ID","title":"International Joint Conference on Electronic Voting"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD","Oceania"],"country":["Australia","Estonia","Spain","Sweden"],"glorg":["All Global Affiliations","KTH Royal Institute of Technology","Smartmatic Estonia","Tallinn University","University of Catalonia/URV","University of Melbourne","University of Tartu"],"keyword":["Election Security","adversarial influence","covert attack","sensitive information disclosure","voting systems"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"how could snowden attack an election","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83008060/snow.pdf","version":"Authors Final Version"},"id":"S01-000.00-384292","identifier":[{"id":"85032467272","type":"scopus"}],"ids":["itu-ce82b52e-484e-4c02-a62e-3fc0dc99312c"],"keyword":["adversarial influence","covert attack","election security","sensitive information disclosure","voting systems"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-9FD68CB09D8CC0B74B6D8723810BA630"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83008060/snow.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","country":"se","key":"kth royal institute of technology","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"KTH Royal Institute of Technology","used":1},{"affno":"2","country":"es","key":"university of catalonia urv","loc":["Spain","Europe, EU","OECD"],"name":"University of Catalonia/URV","used":1},{"affno":"3","country":"ee","key":"smartmatic estonia","loc":["Estonia","Europe, EU","OECD"],"name":"Smartmatic Estonia","used":1},{"affno":"4","country":"ee","key":"tallinn university","loc":["Estonia","Europe, EU","OECD"],"name":"Tallinn University","used":1},{"affno":"5","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1},{"affno":"6","country":"ee","key":"university of tartu","loc":["Estonia","Europe, EU","OECD"],"name":"University of Tartu","used":1},{"affno":"7","country":"au","key":"university of melbourne","loc":["Australia","Oceania","OECD"],"name":"University of Melbourne","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Douglas","key":"wikströmpau","last":"Wikström","name":"Wikström, Douglas","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jordi","key":"barratpau","last":"Barrat","name":"Barrat, Jordi","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Sven","key":"heibergpau","last":"Heiberg","name":"Heiberg, Sven","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Robert","key":"krimmerpau","last":"Krimmer","name":"Krimmer, Robert","rank":4,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Carsten","key":"schürmannpau","last":"Schürmann","locid":"1313519f-2074-41d6-8b79-589648e37211","name":"Schürmann, Carsten","orcid":"0000-0003-4793-0099","rank":5,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Helger","key":"lipmaapau","last":"Lipmaa","name":"Lipmaa, Helger","rank":6,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Vanessa","key":"teaguepau","last":"Teague","name":"Teague, Vanessa","rank":7,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-319-68687-5_17","eisbn":["9783319686875"],"isbn":["9783319686868"],"issn":["03029743"],"pages":"280-291","place":"Bregenz/Lochau","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","subtitle":"Second International Joint Conference, E-Vote-ID 2017, Bregenz, Austria, October 24-27, 2017, Proceedings","title":"Electronic Voting"},"review":"Peer Reviewed","scoID":["2-s2.0-85032467272"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-ce82b52e-484e-4c02-a62e-3fc0dc99312c"],"src":["ITU IT University of Copenhagen"],"title":"How Could Snowden Attack an Election?","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384292","year":"2017","yearsub":"2017"}
{"abstract":"A recent trend in the construction of security protocols such as voting and certificate management systems is to make principals accountable for their actions. Whenever some principals deviate from the protocol’s prescription and cause the failure of a goal of the system, accountability ensures that the system can detect the misbehaving parties who caused that failure. Accountability is an intuitively stronger property than verifiability as the latter only rests on the possibility of detecting the failure of a goal. A plethora of accountability and verifiability definitions have been proposed in the literature. Those definitions are either very specific to the protocols in question, hence not applicable in other scenarios, or too general and widely applicable but requiring complicated and hard to follow manual proofs. In this paper, we advance formal definitions of verifiability and accountability that are amenable to automated verification. Our definitions are general enough to be applied to different classes of protocols and different automated security verification tools. Furthermore, we point out formally the relation between verifiability and accountability. We validate our definitions with the automatic verification of three protocols: a secure exam protocol, Google’s Certificate Transparency, and an improved version of Bingo Voting. We find through automated verification that all three protocols satisfy verifiability while only the first two protocols meet accountability.","author_count":3,"contributors":["Bruni, Alessandro","Giustolisi, Rosario","Schürmann, Carsten"],"cuid":["S01-000.00-384358"],"event":{"acronym":"ISC","title":"Information Security Conference"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Accountability","Automated verification","Security protocols","Verifiability","formal definitions"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"automated analysis of accountability","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82496614/accountability.pdf","version":"Authors Final Version"},"id":"S01-000.00-384358","identifier":[{"id":"85035149203","type":"scopus"}],"ids":["itu-d23d44bf-7740-4c1c-a790-ad0d4230aa9a"],"keyword":["accountability","automated verification","formal definitions","security protocols","verifiability"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-1AEA50D1EA387434004FA8715C772E56"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82496614/accountability.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Theoretical Computer Science, Programming Logic and Semantics"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Alessandro","key":"brunipau","last":"Bruni","locid":"5c50bbc9-ed3d-417f-ba4d-e484eaf536b3","name":"Bruni, Alessandro","orcid":"0000-0003-2946-9462","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rosario","key":"giustolisipau","last":"Giustolisi","locid":"62db65c9-470c-472f-b039-6c4a704ef170","name":"Giustolisi, Rosario","orcid":"0000-0002-2917-9601","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Carsten","key":"schürmannpau","last":"Schürmann","locid":"1313519f-2074-41d6-8b79-589648e37211","name":"Schürmann, Carsten","orcid":"0000-0003-4793-0099","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-319-69659-1_23","eisbn":["9783319696591"],"isbn":["9783319696584"],"issn":["03029743"],"pages":"417-434","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","title":"Information Security - 20th International Conference, {ISC} 2017, Ho Chi Minh City, Vietnam, November 22-24, 2017, Proceedings"},"review":"Peer Reviewed","scoID":["2-s2.0-85035149203"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-d23d44bf-7740-4c1c-a790-ad0d4230aa9a"],"src":["ITU IT University of Copenhagen"],"title":"Automated Analysis of Accountability","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384358","year":"2017","yearsub":"2017"}
{"abstract":"The Act-Belong-Commit campaign is the world's first comprehensive, population-wide, community-based program to promote mental health. However, its potential for preventing substance use disorders is unknown. Further, a literature gap is evident concerning behavioral modification strategies to prevent such disorders. The aim of this study was to prospectively assess the association between indicators of the Act-Belong-Commit behavioral domains and the development of problem drinking. Data from two waves of the Irish Longitudinal Study on Ageing (TILDA) were analyzed. The sample consisted of 3950 adults aged ≥50 years. A validated scale for problem drinking was used. The number of social/recreational activities engaged in was used as an indicator of Act, social network integration as an indicator of Belong, and frequency of participation in these social/recreational activities as an indicator of Commit. Multivariable logistic regression analyses were conducted to assess associations between baseline indicators of Act-Belong-Commit and the development of problem drinking at two-year follow-up. Each increase in the number of social/recreational activities (Act) inversely predicted the onset of problem drinking. Similarly, being well integrated into social networks (Belong) was negatively associated with the development of problem drinking. Finally, frequency of participation in social/recreational activities (Commit) also inversely predicted the onset of problem drinking. These associations were apparent regardless of the presence of baseline common mental disorders. Act-Belong-Commit indicators are shown to be associated with a reduced risk for problem drinking. This lends further support to the Act-Belong-Commit domains and has wide-ranging implications for preventing substance use disorders in the aging community.","author_count":9,"contributors":["Santini, Ziggi Ivan","Nielsen, Line","Hinrichsen, Carsten","Tolstrup, Janne","Vinther, Johan Lerbech","Koyanagi, Ai","J Donovan, Robert","Koushede, Vibeke Jenny"],"cuid":["S02-097.39-042010"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD","Oceania"],"country":["Australia","Spain"],"glorg":["All Global Affiliations","The University of Western Australia","University of Barcelona"],"keyword":["Adult","Aged","Aging","Aging psychology","Alcohol Drinking","Alcoholism","Humans","Leisure","Longitudinal Studies","Mental health","Prospective Studies","Social Support"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"the association between act belong commit indicators and problem drinking among older irish adults findings from a prospective analysis of the irish longitudinal study of ageing tilda","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.drugalcdep.2017.08.033","version":"Published Version"},"funding_acknowledgement":["The TILDA data have been co-funded by the Government of Ireland through the Office of the Minister for Health and Children, by Atlantic Philanthropies , and by Irish Life ; have been collected under the Statistics Act, 1993, of the Central Statistics Office. The project has been designed and implemented by the TILDA Study Team © Department of Health and Children. Copyright and all other intellectual property rights relating to the data are vested in TILDA. Ai Koyanagi’s work was supported by the + D + I and funded by the Miguel Servet contract financed by the CP13/00150 project, integrated into the National R ISCIII – General Branch Evaluation and Promotion of Health Research – and the European Regional Development Fund (ERDF) ."],"id":"S02-097.39-042010","identifier":[{"id":"28950238","type":"pmid"},{"id":"85032954958","type":"scopus"}],"ids":["ku-462d594c-e1f6-4002-ac78-9ed73a29b88b","sdu-46a87d62-2fe5-4570-b6e0-8961f1f97302"],"keyword":["Adult","Aged","Aging","Aging/psychology","Alcohol drinking","Alcoholism","Humans","Leisure","Longitudinal Studies","Mental health","Prospective Studies","Social support"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-0279A5222CE94DD13D4C1022165CCA72"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/135905090/The_association_between_Act_Belong_Commit_indicators_and_problem_drinking_among_older_Irish_adults.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/209318695/Santini_et_al_2017.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.drugalcdep.2017.08.033","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, National Institute of Public Health, Department of Health and Social Context"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Section of Epidemiology"],"nora_code":"DI-U-KU","used":1