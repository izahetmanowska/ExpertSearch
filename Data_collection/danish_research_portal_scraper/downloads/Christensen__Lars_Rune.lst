key":"ellervikchristinapau","last":"Ellervik","locid":"f08e5172-d3cf-4e0a-a733-6a450b16075a","name":"Ellervik, Christina","rank":13,"rolecode":"pau"},{"affno":"5","corresponding":null,"country":"dk","first":"Lars Rønn","key":"olsenlarsrønnpau","last":"Olsen","locid":"90ca0980-3661-4875-a116-e47082f82351","name":"Olsen, Lars Rønn","orcid":"0000-0002-6725-7850","rank":14,"rolecode":"pau"},{"affno":"2 3","first":"Jens Jørgen Elmer","key":"christensenjensjørgenpau","last":"Christensen","locid":"09791188-d3fa-4cd0-9541-2dc6251d2bdb","name":"Christensen, Jens Jørgen","name_org":"Christensen, Jens Jørgen Elmer","rank":15,"rolecode":"pau"},{"affno":"2","first":"Xiaohui Chen","key":"nielsenxiaohuichenpau","last":"Nielsen","name":"Nielsen, Xiaohui Chen","rank":16,"rolecode":"pau"},{"affno":"2 3","first":"Hans Carl","key":"hasselbalchhanscarlpau","last":"Hasselbalch","locid":"e5627e9a-fe7a-415b-b281-3aa0a3c4cf5d","name":"Hasselbalch, Hans Carl","rank":17,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anna Cäcilia","key":"inghamannacäciliapau","last":"Ingham","name":"Ingham, Anna Cäcilia","rank":18,"rolecode":"pau"}],"pmid":["38226781"],"pub":{"doi":"10.1111/ejh.14169","issn":["09024441","09024506"],"issn_org":["09024441"],"issue":"5","journal":"European Journal of Haematology","pages":"776-787","publisher":"Wiley-Blackwell","status":"p","title":"European Journal of Haematology","volume":"112"},"review":"Peer Reviewed","scoID":["2-s2.0-85182500596"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Hospitals","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Region Zealand","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-a5ba03be-0cc6-46cd-b096-63ddfb9e6a09","ku-09461f13-a8e0-4933-bf66-de767b1ae1a3"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"<i>JAK2V617F </i>drives gut microbiota differences in patients with myeloproliferative neoplasms","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-088.16-725067","year":"2024","yearsub":"2024"}
{"abstract":"Drawing on ethnographic fieldwork in a refugee camp in Jordan, this article investigates how datafication through digital screening technologies helps shape mental health issues in the face of widespread uneasiness about the subject, especially among the intended beneficiaries. We argue that the refugees and their health care providers face a dilemma: on the one hand, the desire to make mental health issues visible and clinically actionable through datafication and, on the other hand, the wish to keep mental health issues out of public view to avoid potential stigma.","author_count":2,"contributors":["Christensen, Lars Rune","Ahsan, Hasib"],"cuid":["S01-000.00-712531"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Data","Datafication","Global Health","Mental health","Refugees","Stigma"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"the trouble of stigma in the age of datafication screening for mental health issues in a refugee camp in jordan","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85169923049","version":"Other Version"},"funding_acknowledgement":["This research was funded by the Novo Nordisk Foundation [grant no. NNF21SH0069701]"],"id":"S01-000.00-712531","identifier":[{"id":"85169923049","type":"scopus"}],"ids":["itu-7ca80feb-c418-4539-af15-2546d769cb30"],"keyword":["Data","Datafication","Global Health","Mental Health","Refugees","Stigma"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-0E38576BBF35EC6E076DFEAFA949B14D"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Digitalization, Democracy, and Governance, REFLACT","IT University of Copenhagen, Technologies in Practice, Technologies in Practice"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lars Rune","key":"christensenpau","last":"Christensen","locid":"92f6c3f3-0ad2-40fc-b278-69170f87567d","name":"Christensen, Lars Rune","orcid":"0000-0001-7204-465X","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hasib","key":"ahsanpau","last":"Ahsan","locid":"0bdda5a8-b38a-4532-b9a2-e5d9a98c05a7","name":"Ahsan, Hasib","orcid":"0000-0002-7812-2652","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1080/01459740.2023.2250060","issn":["01459740","15455882"],"issue":"7","journal":"Medical Anthropology: Cross Cultural Studies in Health and Illness","pages":"623-636","publisher":"Taylor & Francis","status":"p","title":"Medical Anthropology: Cross Cultural Studies in Health and Illness","title_org":"Medical Anthropology: Cross-Cultural Studies in Health and Illness","volume":"42"},"review":"Peer Reviewed","scoID":["2-s2.0-85169923049"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-7ca80feb-c418-4539-af15-2546d769cb30"],"src":["ITU IT University of Copenhagen"],"title":"The Trouble of Stigma in the Age of Datafication: Screening for Mental Health Issues in a Refugee Camp in Jordan","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-712531","year":"2023","yearsub":"2023"}
{"abstract":"Chronic inflammation is believed to play an important role in the development and disease progression of polycythemia vera (PV). Because an association between gut microbiota, hematopoiesis, and inflammation is well established, we hypothesized that patients with PV have a gut microbiota distinct from healthy control participants (HCs). Recombinant interferon alfa 2 (IFN-α2)-treatment of patients with PV is reportedly disease modifying in terms of normalization of elevated blood cell counts in concert with a reduction in the JAK2V617F allelic burden. Therefore, we hypothesized that patients treated with IFN-α2 might have a composition of the gut microbiota toward normalization. Herein, via amplicon-based next-generation sequencing of the V3 to V4 regions of the 16S ribosomal RNA gene, we report on an abnormal gut microbiota in 102 patients with PV compared with 42 HCs. Patients with PV had a lower alpha diversity and a lower relative abundance of several taxa belonging to Firmicutes (45%) compared with HCs (59%, P <.001). Furthermore, we report the composition of the gut microbiota to differ between the treatment groups (IFN-α2, hydroxyurea, no treatment, and combination therapy with IFN-α2 and ruxolitinib) and the HCs. These observations are highly interesting considering the potential pathogenetic importance of an altered gut microbiota for development of other diseases, including chronic inflammatory diseases. Our observations call for further gut microbiota studies to decipher potential causal associations between treatment and the gut microbiota in PV and related neoplasms.","author_count":16,"contributors":["Eickhardt-Dalbøge, Christina Schjellerup","Ingham, Anna Cäcilia","Andersen, Lee O'Brien","Nielsen, Henrik V.","Fuursted, Kurt","Stensvold, Christen Rune","Larsen, Morten Kranker","Kjær, Lasse","Christensen, Sarah Friis","Knudsen, Trine Alma","Skov, Vibe","Ellervik, Christina","Olsen, Lars Rønn","Hasselbalch, Hans Carl","Nielsen, Xiaohui Chen","Christensen, Jens Jørgen Elmer"],"cuid":["S02-098.97-716196"],"filters":{"added":"2023-11","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Eickhardt-Dalbøge, Christina Schjellerup"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-ZEA"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-GV-SSI","DI-HO-ZEA","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the gut microbiota in patients with polycythemia vera is distinct from that of healthy controls and varies by treatment","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1182/bloodadvances.2022008555","version":"Published Version"},"id":"S02-098.97-716196","identifier":[{"id":"36260736","type":"pmid"},{"id":"85175567424","type":"scopus"},{"id":"PMC10362542","type":"pmcid"}],"ids":["dtu-0534abcb-c0a0-42f3-b9e8-483c0d57c544","ku-6ada3ba5-4512-4012-9306-de21920125d9"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-44051B69B5EF7A28246D43ABC0275773"],"oa_link":[{"access":"oa","license":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/337905290/blooda_adv-2022-008555-main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/374122617/blood_bld_2023_020974_c_main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1182/bloodadvances.2022008555","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Sjællands Universitetshospital"],"nora_code":"DI-HO-ZEA","used":1},{"affno":"2","country":"dk","key":"ssi statens serum institut","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-SSI","l3nn":"SSI Statens Serum Institut","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SSI Statens Serum Institut","namevar":["Statens Serum Institut"],"nora_code":"DI-GV-SSI","used":1},{"affno":"3","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Health Technology","Technical University of Denmark, Department of Health Technology, Bioinformatics","Technical University of Denmark, Department of Health Technology, Bioinformatics, Single Cell Omics"],"nora_code":"DI-U-DTU","used":1},{"affno":"4","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal Medicine: Haematology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Christina Schjellerup","key":"eickhardtdalbøgechristinaschjelleruppau","last":"Eickhardt-Dalbøge","name":"Eickhardt-Dalbøge, Christina Schjellerup","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Anna Cäcilia","key":"inghamannacäciliapau","last":"Ingham","name":"Ingham, Anna Cäcilia","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lee O'Brien","key":"andersenleeobrienpau","last":"Andersen","name":"Andersen, Lee O'Brien","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Henrik V.","key":"nielsenhenrikvpau","last":"Nielsen","name":"Nielsen, Henrik V.","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kurt","key":"fuurstedkurtpau","last":"Fuursted","name":"Fuursted, Kurt","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Christen Rune","key":"stensvoldchristenrunepau","last":"Stensvold","name":"Stensvold, Christen Rune","rank":6,"rolecode":"pau"},{"affno":"","first":"Morten Kranker","key":"larsenmortenkrankerpau","last":"Larsen","name":"Larsen, Morten Kranker","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lasse","key":"kjærlassepau","last":"Kjær","name":"Kjær, Lasse","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sarah Friis","key":"christensensarahfriispau","last":"Christensen","name":"Christensen, Sarah Friis","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Trine Alma","key":"knudsentrinealmapau","last":"Knudsen","name":"Knudsen, Trine Alma","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Vibe","key":"skovvibepau","last":"Skov","name":"Skov, Vibe","rank":11,"rolecode":"pau"},{"affno":"","first":"Christina","key":"ellervikchristinapau","last":"Ellervik","name":"Ellervik, Christina","rank":12,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Lars Rønn","key":"olsenlarsrønnpau","last":"Olsen","locid":"90ca0980-3661-4875-a116-e47082f82351","name":"Olsen, Lars Rønn","orcid":"0000-0002-6725-7850","rank":13,"rolecode":"pau"},{"affno":"4","first":"Hans Carl","key":"hasselbalchhanscarlpau","last":"Hasselbalch","locid":"e5627e9a-fe7a-415b-b281-3aa0a3c4cf5d","name":"Hasselbalch, Hans Carl","rank":14,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Xiaohui Chen","key":"nielsenxiaohuichenpau","last":"Nielsen","name":"Nielsen, Xiaohui Chen","rank":15,"rolecode":"pau"},{"affno":"","first":"Jens Jørgen Elmer","key":"christensenjensjørgenelmerpau","last":"Christensen","name":"Christensen, Jens Jørgen Elmer","rank":16,"rolecode":"pau"}],"pmid":["36260736"],"pub":{"doi":"10.1182/bloodadvances.2022008555","issn":["24739529","24739537"],"issn_org":["24739529"],"issue":"13","journal":"Blood Advances","pages":"3326-3337","publisher":"American Society of Hematology","status":"p","title":"Blood Advances","title_org":"Blood advances","volume":"7"},"review":"Peer Reviewed","scoID":["2-s2.0-85175567424"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Hospitals","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Region Zealand","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-0534abcb-c0a0-42f3-b9e8-483c0d57c544","ku-6ada3ba5-4512-4012-9306-de21920125d9"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"The Gut Microbiota in Patients with Polycythemia Vera is Distinct from that of Healthy Controls and Varies by Treatment","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-098.97-716196","year":"2023","yearsub":"2023"}
{"abstract":"Essential thrombocythemia (ET) is part of the Philadelphia chromosome-negative myeloproliferative neoplasms. It is characterized by an increased risk of thromboembolic events and also to a certain degree hypermetabolic symptoms. The gut microbiota is an important initiator of hematopoiesis and regulation of the immune system, but in patients with ET, where inflammation is a hallmark of the disease, it is vastly unexplored. In this study, we compared the gut microbiota via amplicon-based 16S rRNA gene sequencing of the V3-V4 region in 54 patients with ET according to mutation status Janus-kinase 2 (JAK2V617F)-positive vs JAK2V617F-negative patients with ET, and in 42 healthy controls (HCs). Gut microbiota richness was higher in patients with ET (median-observed richness, 283.5; range, 75-535) compared with HCs (median-observed richness, 191.5; range, 111-300; P < 0.001). Patients with ET had a different overall bacterial composition (beta diversity) than HCs (analysis of similarities [ANOSIM]; R = 0.063, P = 0.004). Patients with ET had a significantly lower relative abundance of taxa within the Firmicutes phylum compared with HCs (51% vs 59%, P = 0.03), and within that phylum, patients with ET also had a lower relative abundance of the genus Faecalibacterium (8% vs 15%, P < 0.001), an important immunoregulative bacterium. The microbiota signatures were more pronounced in patients harboring the JAK2V617F mutation, and highly similar to patients with polycythemia vera as previously described. These findings suggest that patients with ET may have an altered immune regulation; however, whether this dysregulation is induced in part by, or is itself inducing, an altered gut microbiota remains to be investigated. IMPORTANCE Essential thrombocythemia (ET) is a cancer characterized by thrombocyte overproduction. Inflammation has been shown to be vital in both the initiation and progression of other myeloproliferative neoplasms, and it is well known that the gut microbiota is important in the regulation of our immune system. However, the gut microbiota of patients with ET remains uninvestigated. In this study, we characterized the gut microbiota of patients with ET compared with healthy controls and thereby provide new insights into the field. We show that the gut microbiota of patients with ET differs significantly from that of healthy controls and the patients with ET have a lower relative abundance of important immunoregulative bacteria. Furthermore, we demonstrate that patients with JAK2V617F-positive ET have pronounced gut microbiota signatures compared with JAK2V617F-negative patients. Thereby confirming the importance of the underlying mutation, the immune response as well as the composition of the microbiota.","author_count":16,"contributors":["Eickhardt-Dalbøge, Christina Schjellerup","Ingham, Anna Cäcilia","Nielsen, Henrik V","Fuursted, Kurt","Stensvold, Christen Rune","Andersen, Lee O'Brien","Larsen, Morten Kranker","Kjær, Lasse","Christensen, Sarah Friis","Knudsen, Trine Alma","Skov, Vibe","Ellervik, Christina","Olsen, Lars Rønn","Hasselbalch, Hans Carl","Christensen, Jens Jørgen","Nielsen, Xiaohui Chen"],"cuid":["S02-099.21-704502"],"filters":{"added":"2023-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","OECD"],"corresponding_author":["Eickhardt-Dalbøge, Christina Schjellerup"],"country":["United States"],"glorg":["All Global Affiliations","Harvard University"],"keyword":["ET","Essential thrombocythemia","Gut microbiome","Gut microbiota","Inflammation","JAK2V617F","Myelofibrosis","Myeloproliferative neoplasms","Polycythemia Vera"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-ZEA"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-GV-SSI","DI-HO-ZEA","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"pronounced gut microbiota signatures in patients with i jak000000000002v000000000617f i positive essential thrombocythemia","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1128/spectrum.00662-23","version":"Published Version"},"id":"S02-099.21-704502","identifier":[{"id":"PMC10581245","type":"pmcid"},{"id":"37695126","type":"pmid"},{"id":"85175577971","type":"scopus"}],"ids":["dtu-d6516511-5016-46d6-a8ec-bda517453702","ku-fe1cb7ae-176a-4ea1-88a2-80c4e50587a0"],"keyword":["ET","Essential thrombocythemia","Gut microbiome","Gut microbiota","Inflammation","JAK2V617F","Myelofibrosis","Myeloproliferative neoplasms","Polycythemia vera"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-483C3891D74422370F3F8CC3429786D0"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/348931969/653088fc49aab82002ba9e88.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1128/spectrum.00662-23","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/370582128/eickhardt_dalb_ge_et_al_2023_pronounced_gut_microbiota_signatures_in_patients_with_jak2v617f_positive_essential.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Regi