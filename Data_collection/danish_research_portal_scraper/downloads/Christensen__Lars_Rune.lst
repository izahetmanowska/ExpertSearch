e38c"],"keyword":["04500, Mathematical biology and statistical methods","07004, Behavioral biology - Human behavior","10515, Biophysics - Biocybernetics","12504, Pathology - Diagnostic","20506, Nervous system - Pathology","21002, Psychiatry - Psychopathology, psychodynamics and therapy","24500, Gerontology","Aged","Algorithms","Artificial Intelligence","Automatic classification","BEHAVIOR DISORDER","BIOCHEMICAL","Computational Biology","DELAYED EMERGENCE","Electroencephalography","Electrooculography","Female","Human Medicine, Medical Sciences","Humans","Lasso-regularized regression model mathematical and computer techniques","Male","Methods and Techniques","Middle Aged","Models and Simulations","Models, Neurological","NEUROSCIENCES","Neurology","Nocturnal Myoclonus Syndrome","Parkinson Disease","Parkinson's disease","Parkinson's disease nervous system disease diagnosis","Polysomnography","Primates Mammalia Vertebrata Chordata Animalia (Animals, Chordates, Humans, Mammals, Primates, Vertebrates) - Hominidae [86215] human common middle age, aged female, male","REM sleep behavior disorder nervous system disease, behavioral and mental disorders","REM-SLEEP","Regression Analysis","SWITCH","Sensitivity and Specificity","Signal Processing, Computer-Assisted","Sleep Stages","Topic modeling","WAKEFULNESS","data-driven modeling mathematical and computer techniques","electroencephalography EEG clinical techniques, diagnostic techniques","electrooculography EOG clinical techniques, diagnostic techniques","neurodegeneration","periodic leg movement"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-63E42F01EE79852C5779B9312674D179"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.jneumeth.2014.07.014","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Electrical Engineering","Technical University of Denmark, Department of Electrical Engineering, Biomedical Engineering"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"lundbeck","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-LUND","l3nl":"Lundbeck Pharma","l3nn":"Lundbeck","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Lundbeck","namevar":["H. Lundbeck A/S"],"nora_code":"DI-PR-LUND","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Center for Healthy Ageing","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Julie Anja Engelhard","key":"christensenjulieanjaengelhardpau","last":"Christensen","locid":"5201365e-8d40-4d6b-af99-026b1108b5e9","name":"Christensen, Julie Anja Engelhard","orcid":"0000-0003-4225-3359","rank":1,"rolecode":"pau"},{"affno":"","first":"Julie A E","key":"christensenjulieaepau","last":"Christensen","name":"Christensen, Julie A E","rank":1,"rolecode":"pau"},{"affno":"","first":"Marielle","key":"zoetmuldermariellepau","last":"Zoetmulder","name":"Zoetmulder, Marielle","rank":2,"rolecode":"pau"},{"affno":"","first":"Henriette","key":"kochhenriettepau","last":"Koch","name":"Koch, Henriette","rank":3,"rolecode":"pau"},{"affno":"","first":"Rune","key":"frandsenrunepau","last":"Frandsen","name":"Frandsen, Rune","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars Johan","key":"arvastsonlarsjohanpau","last":"Arvastson","locid":"d5cbd65e-7e62-4684-9fd4-8401893e739a","name":"Arvastson, Lars Johan","rank":5,"rolecode":"pau"},{"affno":"","first":"Lars","key":"arvastsonlarspau","last":"Arvastson","name":"Arvastson, Lars","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Søren Ro","key":"christensensørenropau","last":"Christensen","name":"Christensen, Søren Ro","rank":6,"rolecode":"pau"},{"affno":"","first":"Søren R","key":"christensensørenrpau","last":"Christensen","name":"Christensen, Søren R","rank":6,"rolecode":"pau"},{"affno":"3","first":"Poul","key":"jennumpoulpau","last":"Jennum","locid":"09499315-7437-47b1-a859-6783b0dd67c1","name":"Jennum, Poul","orcid":"0000-0001-6986-5254","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Helge Bjarup Dissing","key":"sørensenhelgebjarupdissingpau","last":"Sørensen","locid":"be0efdb7-17ce-4703-b513-90dfa28f45af","name":"Sørensen, Helge Bjarup Dissing","orcid":"0000-0001-5716-7600","rank":8,"rolecode":"pau"},{"affno":"","first":"Helge B D","key":"sorensenhelgebdpau","last":"Sorensen","name":"Sorensen, Helge B D","rank":8,"rolecode":"pau"}],"pmid":["25088694"],"pub":{"doi":"10.1016/j.jneumeth.2014.07.014","issn":["01650270","1872678X"],"issn_org":["01650270"],"journal":"Journal of Neuroscience Methods","pages":"262-276","publisher":"Elsevier","status":"p","title":"Journal of Neuroscience Methods","volume":"235"},"review":"Peer Reviewed","scoID":["2-s2.0-84904893171"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Lundbeck Pharma","Private Research","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-5263eb49-227d-42e2-a6fa-46fbfb0c6910","ku-a48a271c-95a6-4afc-95d5-c78a252ce38c"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Data-driven modeling of sleep EEG and EOG reveals characteristics indicative of pre-Parkinson's and Parkinson's disease","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-096.53-034446","year":"2014","yearsub":"2014"}
{"abstract":"This chapter presents the principles of anthropology-driven design, explaining and examining the ideas and motivations behind basing technology design on ethnography and user participation. That is, anthropology-driven design is presented as a design process where analytical findings derived from ethnographic field studies are used in combination with participatory design techniques in order to promote democratic participation as well as mobilize the users knowledge as a resource in the design process. This ‘new move’ may be said to create new types of significant proximity between Anthropology, Science and Technology Studies (STS), Moral Philosophy, Computer Supported Cooperative Work (CSCW), Participatory Design (PD) and a range of technical disciplines.","author_count":3,"contributors":["Christensen, Lars Rune"],"cuid":["S01-000.00-061489"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"techno anthropology for design","src":["aau"],"src-code":["DI-U-AAU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://forlag.aau.dk/Shop/medier-og-informatik/what-is-techno-anthropology.aspx","version":"Other Version"},"id":"S01-000.00-061489","ids":["aau-2767acab-4a59-4169-a15a-8bd7d89ee203"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-7F6CDE25286ADD481B114680B955F53F"],"oa_link":[{"access":"oa","type":"rem","url":"http://forlag.aau.dk/Shop/medier-og-informatik/what-is-techno-anthropology.aspx","version":"Other Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (ENG)","Aalborg University, The Faculty of Humanities, Department of Learning and Philosophy","Aalborg University, The Faculty of Humanities, Department of Learning and Philosophy, The Techno-Anthropology Research Group (Learning)","Aalborg University, The Technical Faculty of IT and Design, Department of Sustainability and Planning, Center for Design, Innovation and Sustainable Transitions"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lars Rune","key":"christensenpau","last":"Christensen","locid":"709af1f3-ab3a-49b7-8b1e-5e9365ee7962","name":"Christensen, Lars Rune","rank":1,"rolecode":"pau"},{"affno":"","first":"Tom","key":"børsenpedh","last":"Børsen","name":"Børsen, Tom","rank":2,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Lars","key":"botinpedh","last":"Botin","name":"Botin, Lars","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9788771121230"],"issn":["22457569"],"issue":"1","place":"Aalborg","publisher":"Aalborg Universitetsforlag","series":"Serie om Lærings-, forandrings- og organisationsudviklingsprocesser/Series in Transformational Studies","status":"p","title":"What is Techno-Anthropology?"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-2767acab-4a59-4169-a15a-8bd7d89ee203"],"src":["AAU Aalborg University"],"title":"Techno-Anthropology for Design","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-061489","year":"2013","yearsub":"2013"}
{"abstract":"Objectives The present study aims to augment the network of home care around elderly. We investigate the nature of cooperative work between relatives and home care workers around elderly persons; present the CareCoor system developed to support that work; and report experiences from two pilot tests of CareCoor. Methods We employed ethnographic fieldwork methods and conducted participatory design workshops to throw light on the nature of cooperative home care work, and to elicit implications for the design of an IT system that would support the work of relatives and home care workers around elderly persons. The design implications led to the development of a prototype, called CareCoor, which is accessible via a tablet PC and on the Internet. CareCoor was subsequently evaluated in two pilot tests. The first lasted a week and included three elderly, their next of kin and the affiliated home care workers, while the second test lasted for six weeks and involved five elderly people, their next of kin and relevant home care workers. Results In the paper we make three major points, namely, (1) home care work is highly cooperative in nature and involves substantial coordinative efforts on the part of the actors involved, (2) the network of care around elderly can be augmented with new technology that allows all members of the network to follow, influence and be a part of the cooperative care of the elderly, and (3) CareCoor, the prototype introduced in this study, shows promise as it was well received during test and evaluation. Conclusion Home care work is increasingly important due to the ageing populations of Europe, the USA and large parts of Asia. Home care work between relatives and home care workers is inherently a cooperative effort, and can be facilitated and augmented by new information technology such as CareCoor. The pilot tests of CareCoor revealed promising results and will be further developed and evaluated in a larger test.","author_count":5,"contributors":["Bossen, Claus","Christensen, Lars Rune","Grönvall, Erik","Vestergaard, Lasse"],"cuid":["S03-095.38-002318"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":3,"keyword":["Computer Supported Cooperative Work","Coordination","Health care","Home care work","IT design","Peace of mind","Pårørende","Reciprocity","Sundheds IT","Tablet PC","Workplace study","ældre"],"level":"sci","mra":["hum","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GTS","DI-U"],"level3":{"GTS":["DI-GTS-ALL","DI-GTS-ALX"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-ITU","DI-U-UND"]},"level3all":["DI-GTS-ALX","DI-U-AAU","DI-U-AU","DI-U-ITU","DI-U-UND"]},"review":"pr","rtype":["clu"],"sorti":"carecoor augmenting the coordination of cooperative home care work","src":["aau","au","itu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.ijmedinf.2012.10.005","version":"Other Version"},"id":"S03-095.38-002318","identifier":[{"id":"WOS:000318998000012","type":"wos"},{"id":"23127539","type":"pmid"},{"id":"84876987749","type":"scopus"}],"ids":["aau-2e2e741d-ea7d-4327-a958-3e68bdbd3f45","au-e1a1b4cb-0d3a-415b-b844-0216ef7e68b3","itu-97bf6a62-e5ff-471c-9c7f-62b76c15465b"],"keyword":["Coordination","Hjemmeservice","IT design","Koordinations-arbejde","Peace of mind","Reciprocity","Sundheds It","Tablet PC","Workplace study","computer supported cooperative work","health care","home care work","pårørende","ældre"],"lang":"English","level":"Scientific","mra":["Humanities","Science/Technology"],"noi":["Global-Local-2-6-82090EF5BA5C72A13848A2ED21E91B8C"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.sciencedirect.com.ez.statsbiblioteket.dk:2048/science/article/pii/S1386505612001979","version":"Other Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.ijmedinf.2012.10.005