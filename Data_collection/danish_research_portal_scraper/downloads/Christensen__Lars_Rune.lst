"SDU, Faculty of Humanities, Department for the Study of Culture","SDU, Faculty of Humanities, Department for the Study of Culture, Education"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, Danish School of Education, Danish School of Education - Educational Sociology, Emdrup"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Ane","key":"qvortrupanepau","last":"Qvortrup","locid":"e888627a-aeb0-437b-991d-57505f52659f","name":"Qvortrup, Ane","orcid":"0000-0002-2110-0575","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thomas Enemark","key":"lundtoftethomasenemarkpau","last":"Lundtofte","locid":"6b275bb0-af7b-405e-ae2d-5fd7d58f793c","name":"Lundtofte, Thomas Enemark","orcid":"0000-0003-0344-4232","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Vibeke","key":"christensenvibekepau","last":"Christensen","locid":"faa4826f-e95d-470f-8f1d-2f9474bc14a4","name":"Christensen, Vibeke","orcid":"0000-0003-4844-448X","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rune","key":"lomholtrunepau","last":"Lomholt","locid":"8be4805b-868a-4864-a268-918f851202a9","name":"Lomholt, Rune","orcid":"0000-0002-5333-3234","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anni","key":"nielsenannipau","last":"Nielsen","locid":"81b13249-81cf-4988-98c4-f2044581f066","name":"Nielsen, Anni","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Lars","key":"qvortruplarspau","last":"Qvortrup","locid":"4098e515-bc89-4a5d-b743-535b090f76c7","name":"Qvortrup, Lars","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Karen","key":"wistoftkarenpau","last":"Wistoft","locid":"cbdab0a9-8516-45e9-84a3-ee963b7d3b1d","name":"Wistoft, Karen","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Aske","key":"clarkaskepau","last":"Clark","locid":"c571d18e-3bfa-45cb-918e-9f567fc5a47a","name":"Clark, Aske","rank":8,"rolecode":"pau"}],"pub":{"pages":"48","place":"Odense","publisher":"Syddansk Universitet","status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-98591b4c-2738-4374-af1c-54b3d55614eb","sdu-d324f0cc-95e9-4f74-9e20-e6fe1dd39e65"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Genåbningen af børnehaver efter Covid-19-nedlukninger : Et personaleperspektiv","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-091.03-023767","year":"2021","yearsub":"2021"}
{"abstract":"Da coronapandemien brød ud i Danmark i marts 2020, blev alle elever med meget kort varsel sendt hjem som følge af skolelukninger, og undervisningen skulle gennemføres som hjemmeundervisning. To af de spørgsmål, der meldte sig, var: Hvad betød dette for elevernes læring, trivsel og sociale relationer? Og hvad betød det for forældrene, der skulle balancere mellem arbejde, hjemmeundervisning og familieliv? Mens alle skoler var lukkede, sendte en forskergruppe fra Aarhus og Syddansk Universitet et spørgeskema til elever og forældre i seks danske kommuner. På baggrund af 5.953 svar fra elever og 5.054 svar fra forældre er der udarbejdet en omfattende rapport med de umiddelbare svar. Af rapporten fremgår det blandt andet, at eleverne var pressede, hvad angår deres sociale trivsel. Knap halvdelen tilkendegav i deres svar, at de ikke følte sig glade. De savnede hverdagen med venner, fritidsaktiviteter og skolegang. Knap 80 % havde kontakt med klassekammerater en eller flere gange om ugen. Kun ca. en tredjedel sagde, at de havde daglig kontakt til lærerne, mens næsten halvdelen sagde, at det havde de ikke. Også mange forældre var udfordrede: Godt halvdelen syntes, at det var svært at balancere arbejde, barn/børn og familieliv. Forskerne undersøgte også organiseringen af den digitale undervisning og elevernes og forældrenes oplevelse af lærernes indsats. Resultaterne viser, at der generelt set var stor tilfredshed med lærernes undervisning, men at et mindretal af elever ikke oplevede, at deres lærere lavede planer eller var opmærksomme på, om de lavede deres skolearbejde. Ligeledes var der en gruppe elever, som ikke syntes, at de kunne få hjælp derhjemme.","author_count":5,"contributors":["Qvortrup, Lars","Qvortrup, Ane","Wistoft, Karen","Christensen, Jacob Højgaard","Lomholt, Rune"],"cuid":["S02-097.06-013330"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Corona krise","Elever","Forældre","Grundskole","Hjemmeskole","Hverdagsliv","Nødundervisning","Undervisning"],"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"nødundervisning under corona krisen et elev og forældreperspektiv","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://unipress.dk/media/17311/9788772192871_ncs_e-journal_nr07_4k.pdf","version":"Published Version"},"id":"S02-097.06-013330","ids":["au-0a1a62e2-746a-4aa9-bd80-347ca09ab76c","sdu-38fb073d-2a3b-4b9e-92c2-6829f0587180"],"keyword":["Corona-krise","Elever","Forældre","Grundskole","Hjemmeskole","Hverdagsliv","Nødundervisning","Undervisning"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-2-E73370EE9F3CA3FC8E3FE19D80515328"],"oa_link":[{"access":"oa","type":"rem","url":"https://unipress.dk/udgivelser/n/n%C3%B8dundervisning-under-coronakrisen/","version":"Published Version"},{"access":"oa","type":"rem","url":"https://unipress.dk/media/17311/9788772192871_ncs_e-journal_nr07_4k.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, Danish School of Education, Danish School of Education - Educational Sociology, Emdrup"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Humanities, Department for the Study of Culture","SDU, Faculty of Humanities, Department for the Study of Culture, Education"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Lars","key":"qvortruplarspau","last":"Qvortrup","locid":"4098e515-bc89-4a5d-b743-535b090f76c7","name":"Qvortrup, Lars","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Ane","key":"qvortrupanepau","last":"Qvortrup","locid":"e888627a-aeb0-437b-991d-57505f52659f","name":"Qvortrup, Ane","orcid":"0000-0002-2110-0575","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Karen","key":"wistoftkarenpau","last":"Wistoft","locid":"cbdab0a9-8516-45e9-84a3-ee963b7d3b1d","name":"Wistoft, Karen","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jacob Højgaard","key":"christensenjacobhøjgaardpau","last":"Christensen","locid":"ccaa5c92-7e05-4fcc-a0cd-d968e54ac51b","name":"Christensen, Jacob Højgaard","orcid":"0000-0002-9835-4522","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Rune","key":"lomholtrunepau","last":"Lomholt","locid":"8be4805b-868a-4864-a268-918f851202a9","name":"Lomholt, Rune","orcid":"0000-0002-5333-3234","rank":5,"rolecode":"pau"}],"pub":{"issue":"2020","pages":"104","place":"Aarhus","publisher":"Aarhus Universitetsforlag","repno":"Empirisk skole- og dagtilbudsforskning NCS, No. 2020","series":"Empirisk skole- og dagtilbudsforskning NCS","status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-0a1a62e2-746a-4aa9-bd80-347ca09ab76c","sdu-38fb073d-2a3b-4b9e-92c2-6829f0587180"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Nødundervisning under corona-krisen : et elev- og forældreperspektiv","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-097.06-013330","year":"2020","yearsub":"2020"}
{"abstract":"We report on a new approach to co-creating adaptive case management systems jointly with end-users, developed in the context of the Effective co-created and compliant adaptive case Management Systems for Knowledge Workers (EcoKnow.org) research project. The approach is based on knowledge from prior ethnographic field studies and research in the declarative Dynamic Condition Response (DCR) technology for model-driven design of case management systems. The approach was tested in an operational environment jointly with the danish municipality of Syddjurs by conducting a service-design project and implementing an open source case manager tool and a new highlighter tool for mapping between textual specifications and the DCR notation. The design method and technologies were evaluated by understandability studies with endusers. The study showed that the development could be done in just 6 months, and that the new highlighter tool in combination with the traditional design and simulation tools, supports domain experts formalise and provide traceability between their interpretations of textual specifications and the formal models.","author_count":12,"contributors":["Hildebrandt, Thomas","Abbad Andaloussi, Amine","Christensen, Lars Rune","Debois, Søren","Healy, Nicklas Pape","López, Hugo A.","Marquard, Morten","Møller, Naja L. Holten","Petersen, Anette Chelina Møller","Slaats, Tijs","Weber, Barbara"],"cuid":["S02-082.74-037184"],"event":{"acronym":"ICSP","end":"2020-06-28","place":"Virtual","start":"2020-06-26","title":"ICSSP '20: Proceedings of the International Conference on Software and System Processes","year":"2020"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Europe, Non-EU","OECD"],"country":["Switzerland"],"glorg":["All Global Affiliations","University of St. Gallen"],"keyword":["Adaptive Case Management","Agile","Case study","Co creation","Declarative models","Local government","Prototyping","Regulatory compliance","Service Design","Traceability","Understandability"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-PR","DI-U"],"level3":{"OT":["Syddjurs municipality"],"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-DTU","DI-U-ITU","DI-U-KU"]},"level3all":["DI-PR-OTH","DI-U-DTU","DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"ecoknow engineering effective co created and compliant adaptive case management systems for knowledge workers","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1145/3379177.3388908","version":"Published Version"},"id":"S02-082.74-037184","identifier":[{"id":"85092529434","type":"scopus"}],"ids":["dtu-cbaff1f9-829a-401c-88d1-79d34ba67628","ku-a11fcd9c-9dcc-4916-a4a7-2e012140fa90"],"keyword":["Adaptive case management","Agile","Case study","Co-creation","Declarative models","Local government","Prototyping","Regulatory compliance","Service design","Traceability","Understandability"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-28FDD0983074960111B27426550C6C12"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1145/3379177.3388908","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/215121089/ICSSP20_Ecoknow_overview.pdf","version":"Authors Final Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/287763074/3379177.3388908.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, 