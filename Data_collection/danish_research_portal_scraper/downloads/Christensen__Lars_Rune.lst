"08922543","10402446"],"issn_org":["10402446"],"issue":"11S","journal":"Academic Medicine","publisher":"Lippincott Williams and Wilkins Ltd.","status":"p","title":"Academic Medicine","volume":"95"},"review":"Peer Reviewed","scoID":["2-s2.0-85094932610"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-67453240-6672-47e3-8fd6-3906dca10879","ku-53dc5ac5-bb4c-4cce-b680-99c9e26117c3"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"The Benefits of Tying Yourself in Knots : Unraveling the Learning Mechanisms of Guided-Discovery Learning in an Open-Surgical Skills Course","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.55-020186","year":"2020","yearsub":"2020"}
{"abstract":"The mental health needs of people affected by humanitarian crisis are significant but may be overlooked by healthcare providers. This paper reports on a 3-month, mixed method, field trial of a digital screening tool to identify people suffering mental health issues in Kutupalong refugee camp in Bangladesh. First, findings show that of 958 persons screened 20.46% exhibited indications of significant mental health issues. Second, ethnographic enquiries provide insights into the stressors of camp life, including, socio-spatial confinement, idleness, break-up of families, domestic disputes and uncertain prospects for the future, which in combination may explain the outcome of the screenings. The paper adds to the body of research on mental health in humanitarian crisis, and seeks to demonstrate the value of combining quantitative and qualitative data and analysis.","author_count":3,"contributors":["Christensen, Lars Rune","Ahsan, Hasib","Mandal, Subrata Kumar"],"cuid":["S01-000.00-383432"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Asia, South"],"country":["Bangladesh"],"glorg":["All Global Affiliations","Friendship"],"keyword":["Digital health care","Digital transformation","Global South","ICT for Development","Refugee","Rohingya","mHealth"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"rohingya mhealth investigating mental health in kutupalong refugee camp","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-SA","type":"doi","url":"https://doi.org/10.4103/INTV.INTV_10_20","version":"Published Version"},"id":"S01-000.00-383432","identifier":[{"id":"85097404038","type":"scopus"}],"ids":["itu-9349af27-a2cc-48d6-9da0-f57ac3da938a"],"keyword":["Digital health care","Global South","ICT for Development","Refugee","Rohingya","digital transformation","mHealth"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-BFB2F2AAE05559BBA27FBF8A009AF16C"],"oa_link":[{"access":"oa","license":"CC BY-SA","type":"rem","url":"https://www.interventionjournal.org/article.asp?issn=1571-8883;year=2020;volume=18;issue=2;spage=99;epage=107;aulast=Christensen","version":"Published Version"},{"access":"oa","type":"rem","url":"https://www.interventionjournal.org/temp/Intervention18299-4918874_133948.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-SA","type":"doi","url":"https://doi.org/10.4103/INTV.INTV_10_20","version":"Published Version"},{"access":"oa","license":"CC BY-SA","type":"loc","url":"https://pure.itu.dk/ws/files/85682941/Intervention.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Technologies in Practice, Technologies in Practice"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"bd","key":"friendship","loc":["Bangladesh","Asia, South"],"name":"Friendship","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lars Rune","key":"christensenpau","last":"Christensen","locid":"92f6c3f3-0ad2-40fc-b278-69170f87567d","name":"Christensen, Lars Rune","orcid":"0000-0001-7204-465X","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hasib","key":"ahsanpau","last":"Ahsan","locid":"0bdda5a8-b38a-4532-b9a2-e5d9a98c05a7","name":"Ahsan, Hasib","orcid":"0000-0002-7812-2652","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Subrata Kumar","key":"mandalpau","last":"Mandal","name":"Mandal, Subrata Kumar","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.4103/intv.intv_10_20","issn":["18721001"],"issue":"2","journal":"Intervention Journal of Mental Health and Psychosocial Support in Conflict Affected Areas","pages":"99","publisher":"Wolters Kluwer","status":"p","title":"Intervention Journal of Mental Health and Psychosocial Support in Conflict Affected Areas","volume":"18"},"review":"Peer Reviewed","scoID":["2-s2.0-85097404038"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-9349af27-a2cc-48d6-9da0-f57ac3da938a"],"src":["ITU IT University of Copenhagen"],"title":"Rohingya mHealth: Investigating Mental Health in Kutupalong Refugee Camp","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383432","year":"2020","yearsub":"2021"}
{"abstract":"Based on fieldwork, we investigate the integration of an agricultural information service into a rural community in Bangladesh. We find that it takes work beyond the initial design and cursory introduction of the service to make the service work in a low-income rural community: it takes the strength of the farmers self-help groups to circulate the messages by word-of-mouth, it takes posters placed at key junctions according to a socio-geographic understanding of the village manifest in a map, and it (ideally) involves the support of the elite of the community via the broadcast of messages at places of high symbolic value. It takes all this in addition to a well-made information service delivering relevant and timely messages on for example agricultural matters. Hence, reducing the issue to one of technical delivery mechanism does not tell the full story.","author_count":4,"contributors":["Christensen, Lars Rune","Ahsan, Hasib","Rashid, Mamunur","Das, Badal Kumar"],"cuid":["S01-000.00-383310"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Asia, South","Europe, EU","OECD"],"country":["Bangladesh","Germany"],"glorg":["All Global Affiliations","Chattogram Medical University","Welthungerhilf","mPower Social Enterprises Ltd"],"keyword":["Agricultural Information Service","Information Dissemination","Rural Community Integration","Self Help Groups","Socio Geographic Mapping"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"are you magicians the collaborative work of an agricultural information service","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1145/3287098.3287109","version":"Published Version"},"id":"S01-000.00-383310","identifier":[{"id":"85060946437","type":"scopus"}],"ids":["itu-8b74c168-c939-4144-880b-073113476d4d"],"keyword":["Agricultural Information Service","Information Dissemination","Rural Community Integration","Self-Help Groups","Socio-Geographic Mapping"],"lang":"Danish","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-1C8244EF66812030E99F5C0065F8046B"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1145/3287098.3287109","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Technologies in Practice, Technologies in Practice"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"bd","key":"mpower social enterprises ltd","loc":["Bangladesh","Asia, South"],"name":"mPower Social Enterprises Ltd","used":1},{"affno":"3","country":"bd","key":"chattogram medical university","loc":["Bangladesh","Asia, South"],"name":"Chattogram Medical University","used":1},{"affno":"4","country":"de","key":"welthungerhilf","loc":["Germany","Europe, EU","OECD"],"name":"Welthungerhilf","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lars Rune","key":"christensenpau","last":"Christensen","locid":"92f6c3f3-0ad2-40fc-b278-69170f87567d","name":"Christensen, Lars Rune","orcid":"0000-0001-7204-465X","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Hasib","key":"ahsanpau","last":"Ahsan","name":"Ahsan, Hasib","rank":2,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Mamunur","key":"rashidpau","last":"Rashid","name":"Rashid, Mamunur","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Badal Kumar","key":"daspau","last":"Das","name":"Das, Badal Kumar","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1145/3287098.3287109","pages":"1-10","publisher":"Association for Computing Machinery","status":"p","title":"ICTD '19: Proceedings of the Tenth International Conference on Information and Communication Technologies and Development"},"review":"Peer Reviewed","scoID":["2-s2.0-85060946437"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-8b74c168-c939-4144-880b-073113476d4d"],"src":["ITU IT University of Copenhagen"],"title":"Are You Magicians? The Collaborative Work of an Agricultural Information Service","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383310","year":"2019","yearsub":"2019"}
{"author_count":3,"contributors":["Benjaminsen, Lars","Vistisen, Line","Christensen, Rune"],"cuid":["S01-000.00-663446"],"filters":{"added":"2022-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"com","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV"],"level3":{"GV":["DI-GV-ALL","DI-GV-VIVE"]},"level3all":["DI-GV-VIVE"]},"review":"pr","rtype":["clu"],"sorti":"afprøvning af midlertidige overgangsboliger med icm bostøtte til unge i hjemløshed afsluttende evaluering","src":["vive"],"src-code":["DI-GV-VIVE"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.vive.dk/ws/files/2395980/100564_afproevning_af_midlertidige_overgangsboliger_med_ICM_bostoette_til_unge_i_hjemloeshed_pdfa.pdf","version":"Published Version"},"id":"S01-000.00-663446","ids":["vive-5cca28fb-4294-478d-99a7-f52bcfa88680"],"lang":"Danish","level":"Commissioned","mra":["Social Science"],"noi":["Local-1-1-A67DF091F54B8FCEFFE6CF9EE1BC58AF"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.vive.dk/ws/files/2395980/100564_afproevning_af_midlertidige_overgangsboliger_med_ICM_bostoette_til_unge_i_hjemloeshed_pdfa.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"vive the danish center for social science research","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-VIVE","l3nn":"VIVE The Danish Center for Social Science Research","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"VIVE The Danish Center for Social Science Research","namevar":["VIVE - The Danish Center for Social Science Research, VIVE Social Policy"],"nora_code":"DI-GV-VIVE","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Lars","key":"benjaminsenpau","last":"Benjaminsen","locid":"53af5bf0-d0c4-4b9e-8f3b-7a8767266c04","name":"Benjaminsen, Lars","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Line","key":"vistisenpau","last":"Visti