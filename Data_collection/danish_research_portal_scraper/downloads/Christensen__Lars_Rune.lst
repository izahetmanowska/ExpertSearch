rsity of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-3279222e-27ec-436d-ab2c-78c5959c20ee"],"src":["ITU IT University of Copenhagen"],"title":"Techno-anthropology for Design","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382004","year":"2014","yearsub":"2014"}
{"abstract":"On the basis of an ethnographic field study, this article introduces the concept of documentscape to the analysis of document-centric work practices. The concept of documentscape refers to the entire ensemble of documents in their mutual intertextual interlocking. Providing empirical data from a global software development case, we show how hierarchical structures and sequentiality across the interlocked documents are critical to how actors make sense of the work of others and what to do next in a geographically distributed setting. Furthermore, we found that while each document is created as part of a quasi-sequential order, this characteristic does not make the document, as a single entity, into a stable object. Instead, we found that the documents were malleable and dynamic while suspended in intertextual structures. Our concept of documentscape points to how the hierarchical structure, sequentiality, and authorless nature of documents serve as a constitutive platform for the development of iterative and emergent work practices, making it possible for highly distributed actors to collaborate with limited communication, as the documentscape serves as a vehicle of coordination.","author_count":2,"contributors":["Christensen, Lars Rune","Bjørn, Pernille"],"cuid":["S02-085.95-691847"],"event":{"acronym":"CHI","end":"2014-05-01","place":"Toronto, ca","start":"2014-04-26","title":"ACM CHI Conference on Human Factors in Computing Systems","year":"2014"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Document centric work practices","Documentscape","Geographically distributed collaboration","Hierarchical structures","Intertextuality"],"level":"sci","mra":["hum","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-AAU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"documentscape intertextuality sequentiality amp autonomy at work","src":["aau","itu"],"src-code":["DI-U-AAU","DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1145/2556288.2557305","version":"Other Version"},"id":"S02-085.95-691847","identifier":[{"id":"84900384593","type":"scopus"}],"ids":["aau-d24bca4e-1731-4f81-88cd-dc1331169b4c","itu-5512dfea-0940-426c-ad3b-107a204a94b0"],"keyword":["Document-centric work practices","Documentscape","Geographically distributed collaboration","Hierarchical structures","Intertextuality"],"lang":"English","level":"Scientific","mra":["Humanities","Science/Technology"],"noi":["Global-Local-2-5-A92837969A4D448E04F39CDB2865C1AA"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1145/2556288.2557305","version":"Other Version"},{"access":"oa","type":"rem","url":"http://delivery.acm.org/10.1145/2560000/2557305/p2451-christensen.pdf?ip=130.225.198.194&id=2557305&acc=ACTIVE%20SERVICE&key=36332CD97FA87885%2E1DDFD8390336D738%2E4D4702B0C3E38B35%2E4D4702B0C3E38B35&CFID=619549554&CFTOKEN=92505981&__acm__=1421666361_660a881fbef484d56722b57f1f6c1a3b","version":"Other Version"},{"access":"oa","type":"rem","url":"http://chi2014.acm.org","version":"Other Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (ENG)","Aalborg University, The Faculty of Humanities, Department of Learning and Philosophy","Aalborg University, The Faculty of Humanities, Department of Learning and Philosophy, The Techno-Anthropology Research Group (Learning)","Aalborg University, The Technical Faculty of IT and Design, Department of Sustainability and Planning, Center for Design, Innovation and Sustainable Transitions"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Technologies in Practice, Technologies in Practice","The Department, IT management and leadership"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Lars Rune","key":"christensenpau","last":"Christensen","locid":"709af1f3-ab3a-49b7-8b1e-5e9365ee7962","name":"Christensen, Lars Rune","orcid":"0000-0001-7204-465X","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Pernille","key":"bjørnpau","last":"Bjørn","name":"Bjørn, Pernille","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1145/2556288.2557305","isbn":["9781450324731"],"pages":"2451-2460","publisher":"Association for Computing Machinery (ACM)","status":"p","title":"CHI '14- Proceedings of the SIGCHI Conference on Human Factors in Computing Systems"},"review":"Peer Reviewed","scoID":["2-s2.0-84900384593"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["aau-d24bca4e-1731-4f81-88cd-dc1331169b4c","itu-5512dfea-0940-426c-ad3b-107a204a94b0"],"src":["AAU Aalborg University","ITU IT University of Copenhagen"],"title":"Documentscape  : Intertextuality, Sequentiality &amp; Autonomy at Work","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-085.95-691847","year":"2014","yearsub":"2014"}
{"abstract":"Creating social ties are important for collaborative work; however, in geographically distributed organizations e.g. global software development, making social ties requires extra work: Relation work. We find that characteristics of relation work as based upon shared history and experiences, emergent in personal and often humorous situations. Relation work is intertwined with other activities such as articulation work and it is rhythmic by following the work patterns of the participants. By comparing how relation work is conducted in collocated and geographically distributed settings we in this paper identify basic differences in relation work. Whereas collocated relation work is spontaneous, place-centric, and yet mobile, relation work in a distributed setting is semi-spontaneous, technology-mediated, and requires extra efforts.","author_count":4,"contributors":["Christensen, Lars Rune","Jensen, Rasmus Eskild","Bjørn, Pernille"],"cuid":["S01-000.00-381645"],"event":{"acronym":"COOP","end":"2014-05-30","place":"Nice, fr","start":"2014-05-27","title":"11th International Conference on the Design of Cooperative Systems","year":"2014"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Collaborative work","Geographically distributed organizations","Global Software Development","Relation Work","Social ties"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"relation work in collocated and distributed collaboration","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-3-319-06498-7_6","version":"Other Version"},"id":"S01-000.00-381645","ids":["itu-19371626-7b5f-4c49-a4fe-9f9121976447"],"keyword":["Collaborative work","Geographically distributed organizations","Global software development","Relation work","Social ties"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-F41313EFE4D5126E8BAB98383679D3D3"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-3-319-06498-7_6","version":"Other Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Technologies in Practice, Technologies in Practice","The Department, Interdisciplinary Section"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lars Rune","key":"christensenpau","last":"Christensen","locid":"92f6c3f3-0ad2-40fc-b278-69170f87567d","name":"Christensen, Lars Rune","orcid":"0000-0001-7204-465X","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rasmus Eskild","key":"jensenpau","last":"Jensen","name":"Jensen, Rasmus Eskild","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Pernille","key":"bjørnpau","last":"Bjørn","name":"Bjørn, Pernille","rank":3,"rolecode":"pau"},{"affno":"","first":"Chiara","key":"rossittopedh","last":"Rossitto","name":"Rossitto, Chiara","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-319-06498-7_6","eisbn":["9783319064987"],"isbn":["9783319064970"],"pages":"87-101","publisher":"Springer","status":"p","title":"COOP 2014 - Proceedings of the 11th International Conference on the Design of Cooperative Systems"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-19371626-7b5f-4c49-a4fe-9f9121976447"],