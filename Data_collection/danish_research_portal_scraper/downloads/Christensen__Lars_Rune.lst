r Computing Machinery","status":"p","title":"Proceedings of International Conference on Software and Systems Process"},"review":"Peer Reviewed","scoID":["2-s2.0-85092529434"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Private Research","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Miscellaneous","Other Companies","Other Research","Private Research","Technical University of Denmark","Universities","University of Copenhagen","dcr solutions a/s"],"PST":["Published"]},"sid":["dtu-cbaff1f9-829a-401c-88d1-79d34ba67628","ku-a11fcd9c-9dcc-4916-a4a7-2e012140fa90"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"EcoKnow: Engineering Effective, Co-created and Compliant Adaptive Case Management Systems for Knowledge Workers","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-082.74-037184","year":"2020","yearsub":"2020"}
{"abstract":"This paper examines the nature of discretion in social work in order to debunk myths dominating prevalent debates on digitisation and automation in the public sector. Social workers have traditionally used their discretion widely and with great autonomy, but discretion has increasingly come under pressure for its apparent subjectivity and randomness. In Denmark, our case in point, the government recently planned to standardise laws to limit or remove discretion where possible in order for automation of case management to gain a foothold. Recent studies have focused on discretion in the public sector, but few have examined it explicitly and as part of real cases. As a consequence, they often leave the myths about discretion unchallenged. Inspired by the literature on discretion and CSCW research on rules in action, this study reports on an empirical investigation of discretion in child protection services in Denmark. The results of our analysis provide a new understanding of discretion as a cooperative endeavour, based on consultation and skill, rather than an arbitrary or idiosyncratic choice. In this manner, our study contradicts the myth of discretion inherent in the automation agenda. Correspondingly, we ask for attention to be given to systems that integrate discretion with technology rather than seek to undermine it directly or get around it surreptitiously. In this age of automation, this is not only an important but also an urgent task for CSCW researchers to fulfil.","author_count":3,"contributors":["Petersen, Anette C.M.","Christensen, Lars Rune","Hildebrandt, Thomas T."],"cuid":["S02-094.12-038368"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Administrative work","Automation","Casework","Decision making","Digital ready legislation","Digitisation","Discretion","Rules in action","Social work"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the role of discretion in the age of automation","src":["itu","ku"],"src-code":["DI-U-ITU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85697258/AnetteC.M.Petersenetal.TheRoleofDiscretionintheAgeofAutomaion.pdf","version":"Pre-print"},"id":"S02-094.12-038368","identifier":[{"id":"85078606508","type":"scopus"}],"ids":["itu-b7d5fa33-3fe8-44ba-ba7d-abbba6f1493e","ku-2322e320-f1f1-4fd9-8ad3-b1e370f7cfab"],"keyword":["Administrative work","Automation","Casework","Decision-making","Digital-ready legislation","Digitisation","Discretion","Rules in action","Social work"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-AF2AF603BD6EAE2B77EAFF4DE9288442"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85697258/AnetteC.M.Petersenetal.TheRoleofDiscretionintheAgeofAutomaion.pdf","version":"Pre-print"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Technologies in Practice, Technologies in Practice"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Software, Data, People & Society"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anette","key":"petersenpau","last":"Petersen","name":"Petersen, Anette","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars Rune","key":"christensenpau","last":"Christensen","locid":"92f6c3f3-0ad2-40fc-b278-69170f87567d","name":"Christensen, Lars Rune","orcid":"0000-0001-7204-465X","rank":2,"rolecode":"pau"},{"affno":"2","first":"Thomas T.","key":"hildebrandtpau","last":"Hildebrandt","locid":"c1d69914-5f7a-4f0b-8ffb-766693004328","name":"Hildebrandt, Thomas T.","orcid":"0000-0002-7435-5563","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1007/s10606-020-09371-3","issn":["09259724","15737551"],"issn_org":["09259724"],"issue":"3","journal":"Computer Supported Cooperative Work","pages":"303-333","status":"p","title":"Computer Supported Cooperative Work","title_org":"Computer Supported Cooperative Work: CSCW: An International Journal","volume":"29"},"review":"Peer Reviewed","scoID":["2-s2.0-85078606508"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["itu-b7d5fa33-3fe8-44ba-ba7d-abbba6f1493e","ku-2322e320-f1f1-4fd9-8ad3-b1e370f7cfab"],"src":["ITU IT University of Copenhagen","KU University of Copenhagen"],"title":"The Role of Discretion in the Age of Automation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-094.12-038368","year":"2020","yearsub":"2020"}
{"abstract":"Der er stor forskel på, hvor gode kommunerne er til at få borgere ud af hjemløshed. Indsatsen har de bedste forudsætninger for at lykkes, hvis der både er systematiske procedurer for at skaffe boliger og give intensiv individuel social støtte til borgere i hjemløshed. Det viser denne evaluering af implementeringen af Housing First-tilgangen, som VIVE og Rambøll har gennemført for Social- og Indenrigsministeriet.","author_count":3,"contributors":["Benjaminsen, Lars","Agerskov Christensen, Rune","Hundahl, Mikkel Stamp"],"cuid":["S01-000.00-665662"],"filters":{"added":"2022-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"com","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV"],"level3":{"GV":["DI-GV-ALL","DI-GV-VIVE"]},"level3all":["DI-GV-VIVE"]},"review":"pr","rtype":["clu"],"sorti":"udbredelsen af housing first muligheder og barrierer i implementeringen af housing first på hjemløshedsområdet i danmark","src":["vive"],"src-code":["DI-GV-VIVE"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.vive.dk/ws/files/4265738/100694_Udbredelsen_Housing_First_PDF_UA.pdf","version":"Other Version"},"id":"S01-000.00-665662","ids":["vive-fefd01f5-7454-442f-b411-c6d5c498cbf8"],"lang":"Danish","level":"Commissioned","mra":["Social Science"],"noi":["Local-1-1-CA85216CF4C33F043571D7E0D718FDE7"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.vive.dk/ws/files/4265738/100694_Udbredelsen_Housing_First_PDF_UA.pdf","version":"Other Version"}],"org":[{"affno":"1","key":"vive the danish center for social science research","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-VIVE","l3nn":"VIVE The Danish Center for Social Science Research","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"VIVE The Danish Center for Social Science Research","namevar":["VIVE - The Danish Center for Social Science Research, VIVE Social Policy"],"nora_code":"DI-GV-VIVE","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Lars","key":"benjaminsenpau","last":"Benjaminsen","locid":"53af5bf0-d0c4-4b9e-8f3b-7a8767266c04","name":"Benjaminsen, Lars","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Rune","key":"agerskovchristensenpau","last":"Agerskov Christensen","name":"Agerskov Christensen, Rune","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Mikkel Stamp","key":"hundahlpau","last":"Hundahl","name":"Hundahl, Mikkel Stamp","rank":3,"rolecode":"pau"}],"pub":{"pages":"68","place":"København","publisher":"VIVE - Det Nationale Forsknings- og Analysecenter for Velfærd","status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Governmental Institutions","DI-ALL","DI-GV","DI-GV-ALL","Governmental Institutions"],"PST":["Published"]},"sid":["vive-fefd01f5-7454-442f-b411-c6d5c498cbf8"],"src":["VIVE The Danish Center for Social Science Research"],"title":"Udbredelsen af Housing First : Muligheder og barrierer i implementeringen af Housing First på hjemløshedsområdet i Danmark","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-665662","year":"2020","yearsub":"2020"}
{"abstract":"Purpose Teaching technical skills through the use of guided discovery learning (GDL) is an ongoing topic of research. In this approach, learners practice and struggle before receiving formal instruction. This has shown promise in other domains of learning, yet in the realm of procedural skills, clarity is still needed. This study seeks to address these gaps by investigating efficacy and mechanisms relating to application for a GDL approach in teaching basic surgical skills. Method In 2018, young surgical trainees (N = 16) undertook a 6-week open surgical course applying the principles of GDL, each lesson beginning with a discovery phase before subsequent instruction and practice. A concurrent triangulation mixed-methods approach was used with direct observation and collection of semistructured interviews using a framework designed from productive failure literature. At the end of the course, all participants took a conceptual knowledge test and a performance-based skills test. Performance on the skills test was rated using global ratings and checklists. Results The GDL cohort outperformed the historical cohort on the written exam (F [1,65] = 4.96, P =.029, d =.62), as well as on the summative suturing test (F [1,65] = 6.23, P =.015, d =.68). Furthermore, 3 main themes that highlight the mechanisms and mediators of efficient GDL were: (1) building conceptual knowledge, (2) motivating self-regulated learning, and (3) the type of skill and psychological safety. Conclusions GDL can be an efficient approach to teaching procedural skills. Implications for future research and curricular design are discussed.","author_count":8,"contributors":["Aagesen, Andreas H","Jensen, Rune Dall","Cheung, Jeffrey J H","Christensen, John B","Konge, Lars","Brydges, Ryan","Thinggaard, Ebbe","Kulasegaram, Kulamakan Mahan"],"cuid":["S02-099.55-020186"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["America, North","OECD"],"corresponding_author":["Aagesen, Andreas H"],"country":["Canada","United States"],"glorg":["All Global Affiliations","Samuel Lunenfeld Research Institute, Mount Sinai Hospital, Toronto","University of Illinois at Urbana-Champaign"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the benefits of tying yourself in knots unraveling the learning mechanisms of guided discovery learning in an open surgical skills course","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85094932610","version":"Other Version"},"id":"S02-099.55-020186","identifier":[{"id":"32769466","type":"pmid"},{"id":"85094932610","type":"scopus"}],"ids":["au-67453240-6672-47e3-8fd6-3906dca10879","ku-53dc5ac5-bb4c-4cce-b680-99c9e26117c3"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-F47351D47B7F0E902662331233E60F6D"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Clinical Skills Laboratory"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"us","key":"university of illinois at urbana champaign","loc":["United States","America, North","OECD"],"name":"University of Illinois at Urbana-Champaign","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU Universit