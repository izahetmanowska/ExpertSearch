-1161-3622","rank":21,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Erwin","key":"schoofpau","last":"Schoof","locid":"0fb8f624-dabf-435e-89e3-9afe6cf0c231","name":"Schoof, Erwin M.","name_org":"Schoof, Erwin","orcid":"0000-0002-3117-7832","rank":22,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Gerd M.","key":"seiboldpau","last":"Seibold","locid":"1d0fc03b-f90b-4c6e-9ed0-1620485af1c3","name":"Seibold, Gerd M.","orcid":"0000-0002-9823-8134","rank":23,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Claus","key":"sternbergpau","last":"Sternberg","locid":"1a361d9b-bd73-4de8-80d9-df1a209d5898","name":"Sternberg, Claus","orcid":"0000-0002-2572-0288","rank":24,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Bjarke Bak","key":"christensenpau","last":"Christensen","locid":"9a54ec6c-fdc2-4ff0-92fa-0ab3f7f7786a","name":"Christensen, Bjarke Bak","orcid":"0000-0001-9618-6134","rank":25,"rolecode":"pau"}],"pub":{"issn":["16022572"],"newspaper":"Information","publisher":"Dagbladet Information","status":"p","title":"Information"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-12fc6f37-ad7e-4623-bcba-4142d5c745fa"],"src":["DTU Technical University of Denmark"],"title":"Vigtig grundforskning sker ikke af sig selv. Det skal prioriteres af politikere – og vælgere","type":"Newspaper Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-310309","year":"2022","yearsub":"2022"}
{"abstract":"This paper offers an exploration of everyday life during the Covid-19 pandemic in Bangladesh with a focus on how it has been reordered through commonplace digital technologies and services. We present findings from a qualitative field study. Themes emerging from the findings suggest that digital technologies have been important to the reordering of everyday life during the pandemic: videoconferencing have been instrumental in allowing urban residents to work from home, digital money has enabled workers in rural areas to continue financial transactions, and social media has been a source of news and rumours during the pandemic. However, the benefits of the digital reordering of everyday life are unevenly distributed. The themes emerging are used to frame a discussion of the notion of reordering compared to the concept of resilience within ICTD.","author_count":2,"contributors":["Ahsan, Hasib","Christensen, Lars Rune"],"cuid":["S01-000.00-695239"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["COVID 19 pandemic","Digital technologies","Everyday life","Qualitative field study","Reordering and resilience in ICTD"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"the reordering of everyday life through digital technologies during the covid 000000000019 pandemic","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1145/3572334.3572375","version":"Published Version"},"id":"S01-000.00-695239","identifier":[{"id":"85159702798","type":"scopus"}],"ids":["itu-43c93d75-4474-4d4f-a9eb-296e477ef4b4"],"keyword":["Covid-19 pandemic","Digital technologies","Everyday life","Qualitative field study","Reordering and resilience in ICTD"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-66FFD637F2EA28B265397486A09ABCE2"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1145/3572334.3572375","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Digital Business Innovation, Information Systems and Digital Innovation","IT University of Copenhagen, Technologies in Practice, Technologies in Practice"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Hasib","key":"ahsanpau","last":"Ahsan","locid":"0bdda5a8-b38a-4532-b9a2-e5d9a98c05a7","name":"Ahsan, Hasib","orcid":"0000-0002-7812-2652","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars Rune","key":"christensenpau","last":"Christensen","locid":"92f6c3f3-0ad2-40fc-b278-69170f87567d","name":"Christensen, Lars Rune","orcid":"0000-0001-7204-465X","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1145/3572334.3572375","pages":"1-7","publisher":"Association for Computing Machinery","status":"p","title":"ICTD 2022: ACM Conference on The International Conference on Information &amp; Communication Technologies and Development (ICTD)"},"review":"Peer Reviewed","scoID":["2-s2.0-85159702798"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-43c93d75-4474-4d4f-a9eb-296e477ef4b4"],"src":["ITU IT University of Copenhagen"],"title":"The Reordering of Everyday Life through Digital technologies During the Covid-19 Pandemic","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-695239","year":"2022","yearsub":"2022"}
{"abstract":"Screening refugees for mental health issues, medical assistants use a digital tool that produces a numerical score but also, importantly, attunes to the moods of their clients and the atmospheres of their homes. In this article, we propose the concept of numeration-attunement as helpful for medical anthropology. Drawing on ethnographic fieldwork conducted among med-ical assistants working in the Kutapalong refugee camp in Bangladesh, we explore their assessment of the mental health of the refugees: its numeration- attunement. To develop the notion of numeration-attunement, we draw on numeration research as well as phenomenology. Comprehending how med-ical assistants assess the mental health of refugees requires attention both to numeration and datafication by way of a screening tool as well as the revelatory character of attunement to moods.","author_count":2,"contributors":["Christensen, Lars Rune","Ahsan, Hasib"],"cuid":["S01-000.00-384901"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Bangladesh","Datafication","Mental health","Moods","Numerations","Refugee","Rohingya"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"of numbers and moods screening for mental health issues in a rohingya refugee camp in bangladesh","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1080/01459740.2022.2113396","version":"Published Version"},"id":"S01-000.00-384901","identifier":[{"id":"85137819849","type":"scopus"}],"ids":["itu-f678ca8c-f19a-4c37-a635-81adb8cd098d"],"keyword":["Bangladesh","Datafication","Mental health","Moods","Numerations","Refugee","Rohingya"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-291F023CAB25CD80CB8AAC38A1B934C4"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.tandfonline.com/doi/epdf/10.1080/01459740.2022.2113396?needAccess=true&role=button","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1080/01459740.2022.2113396","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Digitalization, Democracy, and Governance, REFLACT","IT University of Copenhagen, Technologies in Practice, Technologies in Practice"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lars Rune","key":"christensenpau","last":"Christensen","locid":"92f6c3f3-0ad2-40fc-b278-69170f87567d","name":"Christensen, Lars Rune","orcid":"0000-0001-7204-465X","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hasib","key":"ahsanpau","last":"Ahsan","locid":"0bdda5a8-b38a-4532-b9a2-e5d9a98c05a7","name":"Ahsan, Hasib","orcid":"0000-0002-7812-2652","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1080/01459740.2022.2113396","issn":["01459740","15455882"],"issue":"8","journal":"Medical Anthropology: Cross Cultural Studies in Health and Illness","publisher":"Taylor & Francis","status":"p","title":"Medical Anthropology: Cross Cultural Studies in Health and Illness","title_org":"Medical Anthropology: Cross-Cultural Studies in Health and Illness","volume":"41"},"review":"Peer Reviewed","scoID":["2-s2.0-85137819849"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-f678ca8c-f19a-4c37-a635-81adb8cd098d"],"src":["ITU IT University of Copenhagen"],"title":"Of Numbers and Moods: Screening for Mental Health Issues in a Rohingya Refugee Camp in Bangladesh","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384901","year":"2022","yearsub":"2022"}
{"abstract":"Background:  Essential thrombocythemia (ET), along with polycythemia vera (PV) and primary myelofibrosis (PMF), belongs to the Philadelphia chromosome negative myeloproliferative neoplasms (MPNs). Chronic inflammation is considered a hallmark in the pathogenesis and progression of the MPNs. The human gut microbiota helps regulate and mature the immune system, digest food, protect against pathogens and induce hematopoiesis. As our immune system constantly interacts with our gut microbiota any change to the microbiota could have significant impact on the overall health of the patient. This influence of the gut microbiota on the patient has been described as being involved in the pathogenesis of several diseases, such as obesity and diabetes mellitus. We recently added to this list by showing that the gut microbiota in patients with PV differs significantly from that of healthy controls (HCs), however the composition of the gut microbiota in patients with ET remains unknown. Thus, we hypothesized that patients with ET have a distinct gut microbiota signature compared with that of HCs. This study is the first to explore the gut microbiota in patients with ET specifically and compared with that of HCs. Methods: We included patients with ET, diagnosed according to the 2016 WHO classification. Included patients had not received antibiotics within the last 2 months and no change in cytoreductive treatment had occurred within the last 3 months. Comorbidities were assessed using the Charlson Comorbidity Index score (CCI). The gut microbiota was characterized using amplicon-based next generation sequencing of the V3-V4 region of the 16S ribosomal unit while dada2 was used for taxonomic classification. Alpha diversity, beta diversity and linear discriminant analysis effect size (LEfSe), were used to assess the microbiota between and within the patient groups. Alpha diversity describes the richness and evenness within a sample and beta diversity the difference in composition between the samples, while LEfSe is used for differential abundance analysis. Results: In total, 54 patients with ET (median age 68, range 38-83) and 42 HCs (median age 71, range 66-74), fulfilled the inclusion criteria. Patients with ET had a higher CCI score (p=0.038) compared with the HCs. Thirty-six patients had the JAK2V617F mutation. Seven were positive for calreticulin (CALR), three for myeloproliferative leukemia virus gene (MPL), two for CALR+JAK2V617F mutations, and 6 were triple negative. The treatments were: no cytoreductive treatment (n=15), PEG-interferon-α2 (n=11), anagrelide (ANG)(n=3), hydroxyurea (HU)(n=23) and HU+ANG(n=2). Patients with ET had a significantly higher observed richness (number of different bacteria present) compared with HCs (median, 283.5 vs 191.5; p<0.001), however, no significant difference was found in alpha diversity. The bacterial composition differed significantly between ET and HCs (p=0.004 and R=0.063). Eight taxa, with a relative abundance >1%, differed between ET and HCs. Patients with ET had a lower relative abundance of the phylum Firmicutes (p=0.03), class Clostridia (p=0.001), order Oscillospirales (p<0.01), and family Ruminococcaceae (p<0.001) compared with HCs. On genus level, patients with ET had a lower relative abundance of Faecalibacterium (p <0.001). While all mutations were associated with a significantly different microbiota in ET compared with HCs, ET patients who only had the JAK2V617F differed to a larger degree. Conclusion: The gut microbiota in patients with ET differed significantly from that of HCs, both in regard to richness and bacterial composition. The relative abundance of several taxa within the phylum Firmicutes differed significantly, with ET patients having a lower relative abundance in general. These differences appear to be more pronounced in patients who have the JAK2V617F mutation. Thus, it needs to be elucidated if the change of the microbiota is the cause or the consequence of the disease. Is it the increased inflammatory response which changes the microbiota or is it the change in microbiota which aggravates the inflammatory effects of the JAK2V617F mutation?","author_count":16,"contributors":["Eickhardt-Dalboge, Christina Schjellerup Schjellerup","Ingham, Anna Cacilia","Andersen, Lee O'Brien","Nielsen, Henrik V.","Fuursted, Kurt","Stensvold, Christen Rune","Larsen, Morten Kranker","Kjaer, Lasse","Christensen, Sarah F.","Knudsen, Trine A.","Skov, Vibe","Ellervik, Christina","Olsen, Lars Rønn","Hasselbalch, Hans Carl","Nielsen, Xiaohui Chen","Elmer Christensen, Jens Jorgen"],"cuid":["S01-000.00-676481"],"filters":{"added":"2023-08","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-ZEA"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-GV-SSI","DI-HO-ZEA","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"patients with essential thrombocythemia have a gut microbiota that differs from healthy controls","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-676481","identifier":[{"id":"000893230305099","type":"wos"}],"ids":["dtu-1545b4bc-30bd-4512-b95c-28c9dbb65ca9"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-6B8F4A8FD437A885F4517BD2CBC54E07"],"org":[{"affno":"1","country":"dk","key":"ssi statens serum institut","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-SSI","l3nn":"SSI Statens Serum Institut","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SSI Statens Serum Institut","namevar":["Statens Serum Institut"],"nora_code":"DI-GV-SSI","used":1},{"affno":"2","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"