6","corresponding":null,"first":"Ryo","key":"kawasakipau","last":"Kawasaki","name":"Kawasaki, Ryo","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sören","key":"möllerpau","last":"Möller","locid":"905018dc-c6c4-4a79-b50d-d0c08618e77a","name":"Möller, Sören","orcid":"0000-0003-0858-4269","rank":13,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Katja Christina","key":"schielkepau","last":"Schielke","name":"Schielke, Katja Christina","rank":14,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lonny","key":"stokholmpau","last":"Stokholm","locid":"ab6bde17-94c0-482d-bb34-495daa518640","name":"Stokholm, Lonny","orcid":"0000-0002-9727-6649","rank":15,"rolecode":"pau"}],"pub":{"issn":["01460404","02730189"],"issn_org":["15525783"],"issue":"7","journal":"Investigative Ophthalmology & Visual Science","paperid":"812","status":"p","title":"Investigative Ophthalmology & Visual Science","volume":"67"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Other Hospitals","Region Zealand","Universities","University of Southern Denmark","lægeforeningen"],"PST":["Published"]},"sid":["sdu-0c59cb1b-f75c-4516-8442-fd05944b3481"],"src":["SDU University of Southern Denmark"],"title":"Presence and development of diabetic retinopathy in the Danish Registry of Diabetic Retinopathy","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-801626","year":"2022","yearsub":"2022"}
{"abstract":"The Göttingen minipig is a large animal with a gyrencephalic brain that expresses –complex behavior, making it an attractive model for Parkinson's disease research. Here, we investigate the temporal evolution of presynaptic dopaminergic function for 14 months after injections of 1-Methyl-4-phenyl-1,2,3,6-tetrahydropyridine (MPTP) into the minipig using a multi-tracer longitudinal positron emission tomography (PET) design. We injected seven sedated minipigs with 1–2 mg/kg of MPTP, and two with saline, three times a week over four weeks. We monitored behavioral deficits using a validated motor scale and walking mat. Brains were imaged with (+)-⍺-[11C]-dihydrotetrabenazine ([11C]-DTBZ) and [18F]-dihydroxyphenylalanine ([18F]-FDOPA) PET at baseline and 1, 3, 10 and 14 months after MPTP injection, and immunohistochemistry was used to assess nigral cell loss. The minipigs showed mild bradykinesia and impaired coordination at early timepoints after MPTP. PET revealed decreases of striatal [11C]-DTBZ and [18F]-FDOPA uptake post-MPTP with partial spontaneous recovery of [18F]-FDOPA after 10 months. Postmortem analysis estimated an MPTP-induced nigral loss of 57% tyrosine hydroxylase+ and 43% Nissl-stained cells. Normal motor function despite substantial damage to the dopaminergic system is consistent with prodromal Parkinson's disease, and offers an opportunity for testing disease-modifying therapies. However, partial spontaneous recovery of dopamine terminal function must be taken into account in future studies.","author_count":16,"contributors":["Lillethorup, Thea Pinholt","Noer, Ove","Alstrup, Aage Kristian Olsen","Real, Caroline Cristiano","Stokholm, Kathrine","Thomsen, Majken","Zaer, Hamed","Orlowski, Dariusz","Mikkelsen, Trine Werenberg","Glud, Andreas Nørgaard","Nielsen, Erik Holm Toustrup","Schacht, Anna Christina","Winterdahl, Michael","Brooks, David J","Sørensen, Jens Christian Hedemann","Landau, Anne M."],"cuid":["S01-000.00-191512"],"filters":{"added":"2022-06","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"corresponding_author":["Landau, Anne M."],"country":["United Kingdom"],"glorg":["All Global Affiliations","Newcastle University"],"keyword":["Binding","Dopamine","Expression","Gottingen minipig","MPTP","Minipig","PET","Positron Emission Tomography","Substantia nigra","Tyrosine hydroxylase","Vesicular monoamine transporter 2","parkinsons disease"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"spontaneous partial recovery of striatal dopaminergic uptake despite nigral cell loss in asymptomatic mptp lesioned female minipigs","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.neuro.2022.05.006","version":"Published Version"},"id":"S01-000.00-191512","identifier":[{"id":"85133918522","type":"scopus"},{"id":"35569565","type":"pmid"},{"id":"000808094400005","type":"wos"}],"ids":["au-6d064fba-ba52-406c-b8c0-b13140b3b752"],"keyword":["BINDING","Dopamine","EXPRESSION","GOTTINGEN MINIPIG","MPTP","Minipig","PARKINSONS-DISEASE","PARS COMPACTA","PET","PRIMATE MODEL","Positron emission tomography","SUBSTANTIA-NIGRA","TREATED MONKEYS","TYROSINE-HYDROXYLASE","Vesicular monoamine transporter 2"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-4607C0C16297BD58A9B55CC88E1B6C68"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.au.dk/ws/files/336844277/Spontaneous_partial_recovery_of_striatal_dopaminergic_uptake_despite_nigral_cell_loss_in_asymptomatic_MPTP-lesioned_female_minipigs.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.neuro.2022.05.006","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Nuclear Medicine","Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Translational Neuropsychiatry Unit"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"gb","key":"newcastle university","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Newcastle University","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Thea Pinholt","key":"lillethoruppau","last":"Lillethorup","locid":"26e45921-395a-4aa2-b7d2-41ac3052f3cf","name":"Lillethorup, Thea Pinholt","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ove","key":"noerpau","last":"Noer","locid":"a4d6f29c-6078-43da-996f-dccff14a124e","name":"Noer, Ove","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Aage Kristian Olsen","key":"alstruppau","last":"Alstrup","locid":"fa66f5b8-0468-4e85-b570-969776c5ebde","name":"Alstrup, Aage Kristian Olsen","orcid":"0000-0002-0084-9122","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Caroline","key":"cristianorealgregóriopau","last":"Cristiano Real Gregório","locid":"3f28f510-96fe-4a1b-8fd9-49372f8f5c46","name":"Real, Caroline Cristiano","name_org":"Cristiano Real Gregório, Caroline","orcid":"0000-0001-6096-3341","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kathrine","key":"stokholmpau","last":"Stokholm","locid":"43ec388f-6ebf-4309-bfa3-c886e94a922c","name":"Stokholm, Kathrine","rank":5,"rolecode":"pau"},{"affno":"1","corr