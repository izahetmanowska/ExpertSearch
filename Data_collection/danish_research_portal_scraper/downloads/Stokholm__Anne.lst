046719ff-6f15-4415-a419-0d9311899a88","sdu-cec68e3e-88de-4c9d-9128-ce50e6de2749"],"src":["AAU Aalborg University","AU Aarhus University","SDU University of Southern Denmark"],"title":"Presence and development of diabetic retinopathy in 16 999 patients with type 1 diabetes in the Danish Registry of Diabetic Retinopathy","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-100.00-761559","year":"2024","yearsub":"2024"}
{"abstract":"BACKGROUND: Atopic diseases, obesity and neuropsychiatric disorders are lifestyle-related and environmental-related chronic inflammatory disorders, and the incidences have increased in the last years. OBJECTIVE: To outline the design of the 18-year follow-up of the Copenhagen Prospective Study on Asthma in Childhood (COPSAC2000) birth cohort, where risk factors of atopic diseases, obesity and neuropsychiatric disorders are identified through extensive characterisation of the environment, along with deep clinical phenotyping and biosampling for omics profiling. METHODS: COPSAC2000 is a Danish prospective clinical birth cohort study of 411 children born to mothers with asthma who were enrolled at 1 month of age and closely followed at the COPSAC clinical research unit through childhood for the development of atopic diseases. At the 18-year follow-up visit, biomaterial (hair, blood, urine, faeces, throat, and skin swabs, nasal lining fluid and scraping, and hypopharyngeal aspirates) and extensive information on environmental exposures and risk behaviours were collected along with deep metabolic characterisation and multiorgan investigations including anthropometrics, heart, lungs, kidneys, intestines, bones, muscles and skin. Neuropsychiatric diagnoses were captured from medical records and registers accompanied by electronic questionnaires on behavioural traits and psychopathology. RESULTS: A total of 370 (90%) of the 411 cohort participants completed the 18-year visit. Of these, 25.1% had asthma, 23.4% had a body mass index >25 kg/m2 and 16.8% had a psychiatric diagnosis in childhood. Of the 62 probands with a neuropsychiatric diagnosis in childhood, a total of 68.7% drank alcohol monthly, and when drinking, 22.2% drank >10 units. Of the participants, 31.4% were currently smoking, and of these, 24.1% smoked daily. A total of 23.8% had tried taking drugs, and 19.7% reported having done self-destructive behaviour. The mean screen time per day was 6.0 hours. CONCLUSION: This huge dataset on health and habits, exposures, metabolism, multiorgan assessments and biosamples from COPSAC2000 by age 18 provides a unique opportunity to explore risk factors and underlying mechanisms of atopic disease and other lifestyle-related, non-communicable diseases such as obesity and neuropsychiatric disorders, which are highly prevalent in the community and our cohort.","author_count":16,"contributors":["Mølbæk-Engbjerg, Trine","Vahman, Nilo","Mikkelsen, Marianne","Fink, Nadia Rahman","Christensen, Emil Dalgaard","Brustad, Nicklas","Sass, Lærke","Løvenhøj, Hedda","Strandberg-Larsen, Katrine","Groot, Jonathan","Andersen, Anne-Marie Nybo","Vinding, Rebecca","Schoos, Ann-Marie Malby","Stokholm, Jakob","Bønnelykke, Klaus","Chawes, Bo"],"cuid":["S01-000.00-765333"],"filters":{"added":"2024-11","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Adolescent","Asthma epidemiology","Birth cohort","Child","Child Preschool","Denmark epidemiology","Environmental Exposure adverse effects","Female","Follow Up Studies","Humans","Infant","Male","Mental Disorders epidemiology","Prospective Studies","Research Design","Risk Factors"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-ZEA"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-HO-ZEA","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"design of the 000000000018 year follow up of the danish copsac000000002000 birth cohort","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1136/bmjpo-2024-002634","version":"Published Version"},"id":"S01-000.00-765333","identifier":[{"id":"85206081277","type":"scopus"},{"id":"PMC11367328","type":"pmcid"},{"id":"39214547","type":"pmid"}],"ids":["ku-adac23fe-69f3-463e-b94b-31ba9898a4a7"],"keyword":["Adolescent","Asthma/epidemiology","Birth Cohort","Child","Child, Preschool","Denmark/epidemiology","Environmental Exposure/adverse effects","Female","Follow-Up Studies","Humans","Infant","Male","Mental Disorders/epidemiology","Prospective Studies","Research Design","Risk Factors"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-0261F303927CECD6801A322BA3877DA0"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/405849292/e002634.full.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1136/bmjpo-2024-002634","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Copenhagen University Hospital - Næstved, Slagelse and Ringsted"],"nora_code":"DI-HO-ZEA","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Herlev and Gentofte"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Section of Epidemiology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1 2","first":"Trine","key":"mølbækengbjergpau","last":"Mølbæk-Engbjerg","name":"Mølbæk-Engbjerg, Trine","rank":1,"rolecode":"pau"},{"affno":"1 2","first":"Nilo","key":"vahmanpau","last":"Vahman","name":"Vahman, Nilo","rank":2,"rolecode":"pau"},{"affno":"2","first":"Marianne","key":"mikkelsenpau","last":"Mikkelsen","name":"Mikkelsen, Marianne","rank":3,"rolecode":"pau"},{"affno":"2","first":"Nadia Rahman","key":"finkpau","last":"Fink","name":"Fink, Nadia Rahman","rank":4,"rolecode":"pau"},{"affno":"2","first":"Emil Dalgaard","key":"christensenpau","last":"Christensen","name":"Christensen, Emil Dalgaard","rank":5,"rolecode":"pau"},{"affno":"2","first":"Nicklas","key":"brustadpau","last":"Brustad","name":"Brustad, Nicklas","rank":6,"rolecode":"pau"},{"affno":"1 2","first":"Lærke","key":"sasspau","last":"Sass","name":"Sass, Lærke","rank":7,"rolecode":"pau"},{"affno":"2","first":"Hedda","key":"løvenhøjpau","last":"Løvenhøj","name":"Løvenhøj, Hedda","rank":8,"rolecode":"pau"},{"affno":"3","first":"Katrine","key":"strandberglarsenpau","last":"Strandberg-Larsen","locid":"5a443538-3866-40a3-b93e-b4d4be24a83a","name":"Strandberg-Larsen, Katrine","orcid":"0000-0001-7061-3767","rank":9,"rolecode":"pau"},{"affno":"3","first":"Jonathan","key":"grootpau","last":"Groot","locid":"c60b013d-97f5-454d-a298-089789bb49d0","name":"Groot, Jonathan","orcid":"0000-0002-8610-0963","rank":10,"rolecode":"pau"},{"affno":"3","first":"Anne-Marie Nybo","key":"andersenpau","last":"Andersen","locid":"249beb4b-1fec-4854-b57d-d2bf355767db","name":"Andersen, Anne-Marie Nybo","orcid":"0000-0002-4296-8488","rank":11,"rolecode":"pau"},{"affno":"1 2","first":"Rebecca","key":"vindingpau","last":"Vinding","name":"Vinding, Rebecca","rank":12,"rolecode":"pau"},{"affno":"1 2","first":"Ann-Marie Malby","key":"schoospau","last":"Schoos","name":"Schoos, Ann-Marie Malby","rank":13,"rolecode":"pau"},{"affno":"1 2","first":"Jakob","key":"stokholmpau","last":"Stokholm","name":"Stokholm, Jakob","rank":14,"rolecode":"pau"},{"affno":"2 3","first":"Klaus","key":"bønnelykkepau","last":"Bønnelykke","locid":"c36b6936-2cc4-41b1-b7c5-a97978afe417","name":"Bønnelykke, Klaus","rank":15,"rolecode":"pau"},{"affno":"2 3","first":"Bo","key":"chawespau","last":"Chawes","locid":"a43d3bab-d625-4981-a8aa-d58d4b4a8b75","name":"Chawes, Bo","orcid":"0000-0001-6846-6243","rank":16,"rolecode":"pau"}],"pmid":["39214547"],"pub":{"doi":"10.1136/bmjpo-2024-002634","issn":["23999772"],"issue":"1","journal":"BMJ Paediatrics Open","status":"p","title":"BMJ Paediatrics Open","volume":"8"},"review":"Peer Reviewed","scoID":["2-s2.0-85206081277"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region Zealand","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-adac23fe-69f3-463e-b94b-31ba9898a4a7"],"src":["KU University of Copenhagen"],"title":"Design of the 18-year follow-up of the Danish COPSAC2000 birth cohort","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-765333","year":"2024","yearsub":"2024"}
{"abstract":"PURPOSE: To investigate diabetic retinopathy (DR) as a potential marker of cardiovascular disease (CVD) in adults with type 1 diabetes attending the Danish DR-screening programme and non-diabetes adults. METHODS: In this registry-based matched case-cohort study, we identified 16 547 adults with type 1 diabetes, who were registered in the Danish Registry of Diabetic Retinopathy (DiaBase). Each case was age- and sex-matched by five non-diabetes individuals (n = 82 399), and odds ratios (ORs) and hazard ratios (HRs) were estimated for incident and upcoming CVD in multivariable models. RESULTS: Adults with type 1 diabetes (median age 44.5 years, 57.6% male) were more likely to have prevalent CVD (OR 1.29; 95% CI, 1.20-1.38) and to develop CVD within 5 years (HR 1.19; 95% CI, 1.08-1.30) as compared to non-diabetes control. However, adults without DR were less likely to develop CVD (HR 0.84; 95% CI, 0.72-0.97) compared to the reference population. For adults with type 1 diabetes, there was an increasing risk for incident CVD for increasing levels of DR (HR 1.33, 1.95, 1.71 and 2.39 for DR-levels 1-4, respectively). Patients with CVD at the time of the first screening had a higher risk to develop DR during follow-up (HR 1.23; 95% CI, 1.02-1.49). CONCLUSION: In a nationwide matched case-cohort study adjusted for potential confounders, DR was identified as an independent marker of prevalent and incident CVD in type 1 diabetes with increasing risk demonstrated for higher levels of DR. Likewise, CVD also independently predicted the risk of incident DR.","author_count":15,"contributors":["Mabala, Ditte Simmelkær","Stokholm, Lonny","Andersen, Nis","Andresen, Jens","Bek, Toke","Heegaard, Steffen","Hajari, Javad","Højlund, Kurt","Kawasaki, Ryo","Laugesen, Caroline Schmidt","Möller, Sören","Pedersen, Frederik Nørregaard","Schielke, Katja Christina","Thykjaer, Anne Suhr","Grauslund, Jakob"],"cuid":["S03-092.09-755837"],"filters":{"added":"2024-05","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"continent":["Asia, East","OECD"],"corresponding_author":["Grauslund, Jakob"],"country":["Japan"],"glorg":["All Global Affiliations","Osaka University","The University of Osaka"],"keyword":["Adult","Biomarkers blood","Cardiovascular Diseases epidemiology","Cardiovascular disease","Case Control Studies","Denmark epidemiology","Diabetes Mellitus Type 1 complications","Diabetic Retinopathy epidemiology","Diabetic retinopathy","Female","Follow Up Studies","Humans","Incidence","Male","Middle Aged","Prevalence","Registries","Registry based","Risk Factors","Screening","Type 1 diabetes"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-OTH","DI-HO-SDR","DI-HO-ZEA"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-OTH","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"diabetic retinopathy as an independent marker of cardiovascular disease in type 000000000001 diabetes results from a nationwide longitudinal matched case cohort study","src":["aau","au","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1111/aos.16653","version":"Published Version"},"funding_acknowledgement":["Funding for the study was obtained from VELUX FONDEN. The study funders were not involved in the design of the study, data collection, analysis, interpretation of data, writing the manuscript or regarding the publication."],"id":"S03-092.09-755837","identifier":[{"id":"38345204","type":"pmid"},{"id":"85185126717","type":"scopus"}],"ids":["aau-737ec6a7-8486-4f25-9680-d17c1b05775d","au-a310922f-d9cc-4252-9de3-3333e6c17382","sdu-ff79f097-bf87-43e4-83d5-e993963a56a0"],"keyword"