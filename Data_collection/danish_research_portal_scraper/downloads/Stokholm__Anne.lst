ri","name":"Hajari, Javad","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kurt","key":"højlundpau","last":"Højlund","locid":"de11c7e6-25a6-4e23-95bb-fe86d3d775ab","name":"Højlund, Kurt","orcid":"0000-0002-0891-4224","rank":8,"rolecode":"pau"},{"affno":"2 7","corresponding":null,"first":"Ryo","key":"kawasakipau","last":"Kawasaki","locid":"9b782ced-ac4a-44d9-848c-d60a6e110229","name":"Kawasaki, Ryo","orcid":"0000-0002-7492-6303","rank":9,"rolecode":"pau"},{"affno":"8","corresponding":null,"first":"Caroline Schmidt","key":"laugesenpau","last":"Laugesen","name":"Laugesen, Caroline Schmidt","rank":10,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Sören","key":"möllerpau","last":"Möller","locid":"905018dc-c6c4-4a79-b50d-d0c08618e77a","name":"Möller, Sören","orcid":"0000-0003-0858-4269","rank":11,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Frederik Nørregaard","key":"pedersenpau","last":"Pedersen","locid":"cbcfb7cd-f4d9-4eb8-8b88-4fb064672abe","name":"Pedersen, Frederik Nørregaard","orcid":"0000-0003-3713-9949","rank":12,"rolecode":"pau"},{"affno":"9 10","corresponding":null,"first":"Katja Christina","key":"schielkepau","last":"Schielke","locid":"060067d2-7693-4ac9-9977-d4a06bfe24a9","name":"Schielke, Katja Christina","rank":13,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Anne Suhr","key":"thykjærpau","last":"Thykjær","locid":"17d61e69-1c51-423b-8e4d-078a72f302fc","name":"Suhr Thykjær, Anne","name_org":"Thykjær, Anne Suhr","orcid":"0000-0002-2621-4360","rank":14,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jakob","key":"grauslundpau","last":"Grauslund","locid":"72447336-2d4c-44a2-b4a5-f99df775a980","name":"Grauslund, Jakob","orcid":"0000-0001-5019-0736","rank":15,"rolecode":"pau"}],"pmid":["38345204"],"pub":{"doi":"10.1111/aos.16653","issn":["1755375X","17553768"],"issn_org":["1755375X"],"issue":"6","journal":"Acta Ophthalmologica","pages":"635-642","publisher":"Wiley","status":"p","title":"Acta Ophthalmologica","title_org":"Acta Ophthamologica","volume":"102"},"review":"Peer Reviewed","scoID":["2-s2.0-85185126717"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Other Hospitals","Region Zealand","Region of Southern Denmark","Universities","University of Southern Denmark","organization of danish ophthalmologists"],"PST":["Published"]},"sid":["aau-737ec6a7-8486-4f25-9680-d17c1b05775d","au-a310922f-d9cc-4252-9de3-3333e6c17382","sdu-ff79f097-bf87-43e4-83d5-e993963a56a0"],"src":["AAU Aalborg University","AU Aarhus University","SDU University of Southern Denmark"],"title":"Diabetic retinopathy as an independent marker of cardiovascular disease in type 1 diabetes: Results from a nationwide longitudinal matched case-cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-092.09-755837","year":"2024","yearsub":"2024"}
{"abstract":"Background: The mechanisms underlying the protective effect of older siblings on allergic disease remain unclear but may relate to the infant gut microbiota. Objective: We sought to investigate whether having older siblings decreases the risk of IgE-mediated food allergy by accelerating the maturation of the infant gut microbiota. Methods: In a birth cohort assembled using an unselected antenatal sampling frame (n = 1074), fecal samples were collected at 1 month, 6 months, and 1 year, and food allergy status at 1 year was determined by skin prick test and in-hospital food challenge. We used 16S rRNA gene amplicon sequencing to derive amplicon sequence variants. Among a random subcohort (n = 323), microbiota-by-age z scores at each time point were calculated using fecal amplicon sequence variants to represent the gut microbiota maturation over the first year of life. Results: A greater number of siblings was associated with a higher microbiota-by-age z score at age 1 year (β = 0.15 per an additional sibling; 95% CI, 0.05-0.24; P = .003), which was in turn associated with decreased odds of food allergy (odds ratio, 0.45; 95% CI, 0.33-0.61; P < .001). Microbiota-by-age z scores mediated 63% of the protective effect of siblings. Analogous associations were not observed at younger ages. Conclusions: The protective effect of older siblings on the risk of developing IgE-mediated food allergy during infancy is substantially mediated by advanced maturation of the gut microbiota at age 1 year.","author_count":16,"contributors":["Gao, Yuan","Stokholm, Jakob","O’Hely, Martin","Ponsonby, Anne-Louise","Tang, Mimi LK.","Ranganathan, Sarath","Saffery, Richard","Harrison, Leonard C.","Collier, Fiona","Gray, Lawrence","Burgner, David","Molloy, John","Sly, Peter D.","Brix, Susanne","Frøkiær, Hanne","Vuillermin, Peter"],"cuid":["S02-097.26-692154"],"filters":{"added":"2023-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["OECD","Oceania"],"corpau":["BIS Investigator Group"],"corresponding_author":["Vuillermin, Peter"],"country":["Australia"],"glorg":["All Global Affiliations","Barwon Health","Deakin University","Florey Institute of Neuroscience and Mental Health","Royal Children's Hospital","Royal Children's Hospital Melbourne","University of Melbourne","University of Queensland","Walter and Eliza Hall Institute of Medical Research"],"keyword":["Birth cohort","Food allergy","Microbiota maturation","Siblings"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"gut microbiota maturity mediates the protective effect of siblings on food allergy","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/321152672/1_s2.0_S0091674923005626_main.pdf","version":"Authors Final Version"},"id":"S02-097.26-692154","identifier":[{"id":"85163821830","type":"scopus"},{"id":"37150361","type":"pmid"}],"ids":["dtu-2230cd43-f6bc-4ef0-a1d0-780028ae4fe7","ku-029c5d20-0d06-48fa-b7ef-59dedd50fe0f"],"keyword":["Birth cohort","Food allergy","Microbiota maturation","Siblings"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-054D56EE674C4D877E088BA0068F2450"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/410669157/1_s2.0_S0091674923005626_am.pdf","version":"Authors Final Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/321152672/1_s2.0_S0091674923005626_main.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3n