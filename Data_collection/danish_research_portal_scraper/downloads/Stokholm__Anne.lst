a","name_org":"Schielke, Katja","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lonny M.","key":"stokholmpau","last":"Stokholm","locid":"ab6bde17-94c0-482d-bb34-495daa518640","name":"Stokholm, Lonny","name_org":"Stokholm, Lonny M.","orcid":"0000-0002-9727-6649","rank":13,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jakob","key":"grauslundpau","last":"Grauslund","locid":"72447336-2d4c-44a2-b4a5-f99df775a980","name":"Grauslund, Jakob","orcid":"0000-0001-5019-0736","rank":14,"rolecode":"pau"}],"pmid":["39096767"],"pub":{"doi":"10.1016/j.jdiacomp.2024.108830","issn":["10568727","1873460X"],"issn_org":["10568727"],"issue":"9","journal":"Journal of Diabetes and its Complications","paperid":"108830","publisher":"Elsevier","status":"p","title":"Journal of Diabetes and its Complications","volume":"38"},"review":"Peer Reviewed","scoID":["2-s2.0-85200159803"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Other Hospitals","Region Zealand","Region of Southern Denmark","Universities","University of Southern Denmark","organization of danish ophthalmologists"],"PST":["Published"]},"sid":["aau-58af7676-fd89-41f8-9e37-0529b8201f69","sdu-3987266b-89c3-48ca-914f-9834f0e4ef8c"],"src":["AAU Aalborg University","SDU University of Southern Denmark"],"title":"Association of continuous subcutaneous insulin therapy and diabetic retinopathy in type 1 diabetes : A national cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-755813","year":"2024","yearsub":"2024"}
{"abstract":"Background: Retinal neurodegeneration is evident in early diabetic retinopathy (DR) which may be associated with other neurodegenerative diseases like Alzheimer's disease (AD). Objective: To investigate diabetes and DR as a risk marker of present and incident AD. Methods: A register-based cohort study was performed. We included 134,327 persons with diabetes above 60 years of age, who had attended DR screening, and 651,936 age- and sex-matched persons without diabetes. Results: At baseline, the prevalence of AD was 0.7% and 1.3% among persons with and without diabetes, respectively. In a multivariable regression model, persons with diabetes were less likely to have AD at baseline (adjusted OR 0.63, 95% CI 0.590.68). During follow-up, incident AD was registered for 1473 (0.35%) and 6,899 (0.34%) persons with and without diabetes, respectively. Compared to persons without diabetes, persons with diabetes and no DR had a lower risk to develop AD (adjusted HR 0.87, 95% CI 0.810.93), while persons with diabetes and DR had higher risk of AD (adjusted HR 1.24, 95% CI 1.081.43). When persons with diabetes and no DR were used as references, a higher risk of incident AD was observed in persons with DR (adjusted HR 1.34, 95% CI 1.181.53). Conclusion: Individuals with diabetes without DR were less likely to develop AD compared to persons without diabetes. However, individuals with DR had a 34% higher risk of incident AD, which raise the question whether screening for cognitive impairment should be done among individuals with DR.","author_count":25,"contributors":["Pedersen, Frederik Nørregaard","Stokholm, Lonny","Pouwer, Frans","Rubin, Katrine Hass","Peto, Tunde","Frydkjær-Olsen, Ulrik","Suhr Thykjær, Anne","Andersen, Nis","Andresen, Jens","Bek, Toke","La Cour, Morten","Heegaard, Steffen","Højlund, Kurt","Kawasaki, Ryo","Hajari, Javad Nouri","Kyvik, Kirsten Ohm","Laugesen, Caroline Schmidt","Schielke, Katja Christina","Simó, Rafael","Grauslund, Jakob"],"cuid":["S03-095.27-803819"],"filters":{"added":"2024-05","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"continent":["Asia, East","Europe, EU","Europe, Non-EU","OECD"],"corresponding_author":["Pedersen, Frederik Nørregaard"],"country":["Japan","Spain","United Kingdom"],"glorg":["All Global Affiliations","Osaka University","Queen's University Belfast","The University of Osaka","University of Osaka","Vall d'Hebron Institut de Recerca","Vall d'Hebron University Hospital"],"keyword":["Alzheimer s disease","Cognitive impairment","Diabetes mellitus","Diabetic retinopathy"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-OTH","DI-HO-SDR","DI-HO-ZEA"],"OT":["Organization of Danish Ophthalmologists in Private Practice"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-OTH","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"diabetic retinopathy predicts risk of alzheimer s disease a danish registry based nationwide cohort study","src":["aau","ku","sdu"],"src-code":["DI-U-AAU","DI-U-KU","DI-U-SDU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.3233/AIAD230037","version":"Published Version"},"funding_acknowledgement":["This work was supported by VELUX FONDEN (grant number 00028744) and Odense University Hospital PhD Foundation (grant number 4339)."],"id":"S03-095.27-803819","identifier":[{"id":"85185293447","type":"scopus"},{"id":"85189583498","type":"scopus"}],"ids":["aau-c59c8842-ea75-4698-93d0-cd1bd9e7b6c8","ku-60f7e971-7714-4117-80d4-c5b872b92f3a","sdu-06ccc7fe-91d0-49d5-9f68-0ab70503a526"],"keyword":["Alzheimer's disease","cognitive impairment","diabetes mellitus","diabetic retinopathy"],"lang":"English","level":"Sci