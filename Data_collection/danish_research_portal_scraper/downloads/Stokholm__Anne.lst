pau"},{"affno":"6","corresponding":null,"first":"Ryo","key":"kawasakipau","last":"Kawasaki","name":"Kawasaki, Ryo","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sören","key":"möllerpau","last":"Möller","locid":"905018dc-c6c4-4a79-b50d-d0c08618e77a","name":"Möller, Sören","orcid":"0000-0003-0858-4269","rank":12,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Katja Christina","key":"schielkepau","last":"Schielke","name":"Schielke, Katja Christina","rank":13,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anne","key":"thykjærpau","last":"Thykjær","locid":"17d61e69-1c51-423b-8e4d-078a72f302fc","name":"Suhr Thykjær, Anne","name_org":"Thykjær, Anne","orcid":"0000-0002-2621-4360","rank":14,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lonny","key":"stokholmpau","last":"Stokholm","locid":"ab6bde17-94c0-482d-bb34-495daa518640","name":"Stokholm, Lonny","orcid":"0000-0002-9727-6649","rank":15,"rolecode":"pau"}],"pub":{"issn":["01460404","02730189"],"issn_org":["15525783"],"issue":"8","journal":"Investigative Ophthalmology & Visual Science","paperid":"539","status":"p","title":"Investigative Ophthalmology & Visual Science","volume":"64"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Other Hospitals","Region Zealand","Universities","University of Southern Denmark","dansk oftalmologisk selskab"],"PST":["Published"]},"sid":["sdu-f4fb455e-12e7-4aea-a407-9ff9b35a0d26"],"src":["SDU University of Southern Denmark"],"title":"Onset and progression of diabetic retinopathy within eight years in type 2 diabetes in the Danish Registry of Diabetic Retinopathy","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-680847","year":"2023","yearsub":"2023"}
{"abstract":"PURPOSE: Diabetic retinopathy (DR) is a hypoxic retinal disease, but so far, the association with systemic hypoxia is poorly understood. Hence, the aim of this study was to evaluate cross-sectional and longitudinal associations between DR and chronic respiratory failure (CRF) in a national cohort. DESIGN: Cross-sectional and 5-year longitudinal register-based cohort study. METHODS: Between 2013 and 2018, we included patients with diabetes from the Danish Registry of Diabetic Retinopathy, who were each age and sex matched with five controls without diabetes. At index date, the prevalence of CRF was compared between cases and controls, and the longitudinal relationship between DR and CRF was assessed in a five-year follow-up. RESULTS: At baseline, we identified 1,980 and 9,990 patients with CRF among 205,970 cases and 1,003,170 controls. The prevalence of CRF was higher among cases than controls (OR 1.75, 95% CI 1.65-1.86), but no difference between cases with and without DR was found.During follow-up, we identified 1,726 and 5,177 events of CRF among cases and controls, respectively. The incidence of CRF was higher among both cases with and without DR compared to controls (DR level 0: HR 1.24, 95% CI 1.16-1.33, DR level 1-4: HR 1.86, 95% CI 1.63-2.12), and higher among cases with DR compared to cases without DR (HR 1.54, 95% CI 1.38-1.72). CONCLUSION: In this study based on nationwide data, we found an increased risk of present and incident CRF in patients with diabetes with or without DR, and we identified DR as a predictor of future CRF.","author_count":14,"contributors":["Sommer Thinggaard, Benjamin","Stokholm, Lonny","Davidsen, Jesper Rømhild","Larsen, Maria Carius","Möller, Sören","Suhr Thykjær, Anne","Andresen, Jens Lundgaard","Andersen, Nis","Heegaard, Steffen","Højlund, Kurt","Kawasaki, Ryo","Laugesen, Caroline","Bek, Toke","Grauslund, Jakob"],"cuid":["S03-099.97-685850"],"filters":{"added":"2023-08","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"continent":["Asia, East","OECD"],"corresponding_author":["Sommer Thinggaard, Benjamin","Thinggaard, Benjamin Sommer"],"country":["Japan"],"glorg":["All Global Affiliations","Osaka University"],"keyword":["Chronic respiratory failure","Diabetes mellitus","Diabetic retinopathy","Epidemiology","Screening for diabetic retinopathy","Systemic hypoxia"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR","DI-HO-OTH","DI-HO-SDR","DI-HO-ZEA"],"OT":["Organization of Danish Ophthalmologists in Private Practice"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CDR","DI-HO-OTH","DI-HO-SDR","DI-HO-ZEA","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"diabetic retinopathy is a predictor of chronic respiratory failure a nationwide register based cohort study","src":["au","ku","sdu"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.heliyon.2023.e17342","version":"Published Version"},"funding_acknowledgement":["VELUX FONDEN (grant number 00028744 ) supported this work."],"id":"S03-099.97-685850","identifier":[{"id":"85163890471","type":"scopus"},{"id":"PMC10329134","type":"pmcid"},{"id":"37426795","type":"pmid"}],"ids":["au-1490ec2b-8168-4471-81ad-2995f4be1e37","ku-c858c97d-c0e1-4962-a54b-cee512f1e6c5","sdu-ea983e8a-f549-4ad5-a743-92e409e0b87d"],"keyword":["Chronic respiratory failure","Diabetes mellitus","Diabetic retinopathy","Epidemiology","Screening for diabetic retinopathy","Systemic hypoxia"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-17BEEE5365ED1E724D4CECB79A6E383A"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/366390120/Diabetic_retinopathy.pdf","v