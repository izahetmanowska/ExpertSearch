osures and Health","volume":"63"},"review":"Peer Reviewed","scoID":["2-s2.0-85072056466"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Miscellaneous","All Private Research","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Miscellaneous","Other Companies","Other Research","Private Research","Undetermined","Universities","University of Copenhagen","velux"],"PST":["Published"]},"sid":["aau-9689971a-59eb-4333-b053-4a0a61634520","au-29b93e16-913f-4e0c-8f14-63da3eac2772","ku-fc8dbe79-2ab7-4503-bf0b-baf9fa2f86ce","nfa-0cce40c1-14f5-4c8e-8c7d-417d09078d0d"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","NFA National Research Centre for the Working Environment"],"title":"A Quantitative General Population Job Exposure Matrix for Occupational Daytime Light Exposure","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-099.40-766891","year":"2019","yearsub":"2019"}
{"abstract":"Histopathological studies and animal models have suggested an inflammatory component in the pathomechanism of the CHMP2B associated frontotemporal dementia (FTD-3). In this cross-sectional study, serum and cerebrospinal fluid were analyzed for inflammatory markers in CHMP2B mutation carriers. Serum levels of CCL4 were increased throughout life. Serum levels of IL-15, CXCL10, CCL22 and TNF-α were significantly associated with cognitive decline, suggesting a peripheral inflammatory response to neurodegeneration. CSF levels of sTREM2 appeared to increase more rapidly with age in CHMP2B mutation carriers. The identification of a peripheral inflammatory response to disease progression supports the involvement of an inflammatory component in FTD-3.","author_count":12,"contributors":["Roos, Peter","von Essen, Marina Rode","Nielsen, Troels Tolstrup","Johannsen, Peter","Stokholm, Jette","Bie, Anne Sigaard","Waldemar, Gunhild","Simonsen, Anja Hviid","Heslegrave, Amanda","Zetterberg, Henrik","Sellebjerg, Finn","Nielsen, Jørgen Erik"],"cuid":["S01-000.00-405073"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"corpau":["FReJA Consortium"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"inflammatory markers of i chmp000000000002b i mediated frontotemporal dementia","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-405073","identifier":[{"id":"85052786135","type":"scopus"},{"id":"30193769","type":"pmid"}],"ids":["ku-13876de4-ceae-424e-a2ed-04e27860907f"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-3C276A6D566BA48A4CE0425DD132ED63"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Immunology and Microbiology, Department of Immunology and Microbiology","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Immunology and Microbiology, Immunology"],"nora_code":"DI-U-KU","used":1},{"affno":2,"key":"freja consortium","name":"FReJA Consortium","role":"oau"}],"person":[{"affno":"","first":"Peter","key":"roospeterpau","last":"Roos","name":"Roos, Peter","rank":1,"rolecode":"pau"},{"affno":"1","first":"Marina Rode","key":"vonessenmarinarodepau","last":"von Essen","locid":"18728ce8-e9a4-47b6-9774-ce27886441c4","name":"von Essen, Marina Rode","rank":2,"rolecode":"pau"},{"affno":"","first":"Troels Tolstrup","key":"nielsentroelstolstruppau","last":"Nielsen","name":"Nielsen, Troels Tolstrup","rank":3,"rolecode":"pau"},{"affno":"","first":"Peter","key":"johannsenpeterpau","last":"Johannsen","name":"Johannsen, Peter","rank":4,"rolecode":"pau"},{"affno":"","first":"Jette","key":"stokholmjettepau","last":"Stokholm","name":"Stokholm, Jette","rank":5,"rolecode":"pau"},{"affno":"","first":"Anne Sigaard","key":"bieannesigaardpau","last":"Bie","name":"Bie, Anne Sigaard","rank":6,"rolecode":"pau"},{"affno":"1","first":"Gunhild","key":"waldemargunhildpau","last":"Waldemar","locid":"becd5a62-33b3-405e-8c6e-36a9578512d6","name":"Waldemar, Gunhild","rank":7,"rolecode":"pau"},{"affno":"","first":"Anja Hviid","key":"simonsenanjahviidpau","last":"Simonsen","name":"Simonsen, Anja Hviid","rank":8,"rolecode":"pau"},{"affno":"","first":"Amanda","key":"heslegraveamandapau","last":"Heslegrave","name":"Heslegrave, Amanda","rank":9,"rolecode":"pau"},{"affno":"","first":"Henrik","key":"zetterberghenrikpau","last":"Zetterberg","name":"Zetterberg, Henrik","rank":10,"rolecode":"pau"},{"affno":"1","first":"Finn","key":"sellebjergfinnpau","last":"Sellebjerg","locid":"4cbcdba1-9f69-4103-b595-68788ee7aacc","name":"Sellebjerg, Finn","rank":11,"rolecode":"pau"},{"affno":"1","first":"Jørgen Erik","key":"nielsenjørgenerikpau","last":"Nielsen","locid":"eefef282-eb8c-4a7f-a85e-4b77dd779a3c","name":"Nielsen, Jørgen Erik","rank":12,"rolecode":"pau"}],"pmid":["30193769"],"pub":{"doi":"10.1016/j.jneuroim.2018.08.009","issn":["01655728","01695088"],"issn_org":["01655728"],"journal":"Journal of Neuroimmunology","pages":"136-142","status":"p","title":"Journal of Neuroimmunology","volume":"324"},"review":"Peer Reviewed","scoID":["2-s2.0-85052786135"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-13876de4-ceae-424e-a2ed-04e27860907f"],"src":["KU University of Copenhagen"],"title":"Inflammatory markers of <i>CHMP2B</i>-mediated frontotemporal dementia","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-405073","year":"2018","yearsub":"2018"}
{"abstract":"Evidence suggests that synapses are affected first in Parkinson's disease (PD). Here, we tested the claim that pathological accumulation of α-synuclein, and subsequent synaptic disruption, occur in absence of dopaminergic neuron loss in PD. We determined early synaptic changes in rats that overexpress human α-synuclein by local injection of viral-vectors in midbrain. We aimed to achieve α-synuclein levels sufficient to induce terminal pathology without significant loss of nigral neurons. We tested synaptic disruption in vivo by analyzing motor defects and binding of a positron emission tomography (PET) radioligand to the vesicular monoamine transporter 2, (VMAT2), [(11)C]dihydrotetrabenazine (DTBZ). Animals overexpressing α-synuclein had progressive motor impairment and, 12 weeks post-surgery, showed asymmetric in vivo striatal DTBZ binding. The PET images matched ligand binding in post-mortem tissue, and histological markers of dopaminergic integrity. Histology confirmed the absence of nigral cell death with concomitant significant loss of striatal terminals. Progressive aggregation of proteinase-K resistant and Ser129-phosphorylated α-synuclein was observed in dopaminergic terminals, in dystrophic swellings that resembled axonal spheroids and contained mitochondria and vesicular proteins. In conclusion, pathological α-synuclein in nigro-striatal axonal terminals leads to early axonal pathology, synaptic disruption, dysfunction of dopaminergic neurotransmission, motor impairment, and measurable change of VMAT2 in the absence of cell loss.","author_count":8,"contributors":["Phan, Jenny-Ann","Stokholm, Kathrine","Zareba-Paslawska, Justyna","Jakobsen, Steen","Hansen, Kim Vang","Gjedde, Albert","Landau, Anne M.","Romero-Ramos, Marina"],"cuid":["S03-098.91-027939"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"continent":["America, North","Asia, Middle East","OECD"],"country":["Canada","Iran","United States"],"glorg":["All Global Affiliations","Johns Hopkins University","McGill University","Tabriz University of Medical Sciences"],"keyword":["Journal Article"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"early synaptic dysfunction induced by α synuclein in a rat model of parkinson s disease","src":["au","ku","sdu"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41598-017-06724-9","version":"Published Version"},"id":"S03-098.91-027939","identifier":[{"id":"28743955","type":"pmid"},{"id":"85026235781","type":"scopus"},{"id":"PMC5526979","type":"pmcid"},{"id":"000406277700005","type":"wos"}],"ids":["au-d28f22d6-3f7b-483e-938d-cf30e6eac01b","ku-b56728d1-97cc-40c9-bf2f-f79a3849d98b","sdu-5e5f35fa-c890-4a33-b9d8-93e0bbd113e0"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-8CE575ADABCC41BE0AF23FE1061854D2"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41598-017-06724-9","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/125561856/Early_synaptic_dysfunction_induced_by_synuclein_in_a_rat_model_of_Parkinson_s_disease.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/182485397/s41598_017_06724_9.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus Unive