f Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["University of Southern Denmark"],"nora_code":"DI-U-SDU","used":1},{"affno":"9","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Ophthalmology","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Hoved-Orto"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Jakob","key":"grauslundpau","last":"Grauslund","name":"Grauslund, Jakob","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Frederik","key":"pedersenpau","last":"Pedersen","name":"Pedersen, Frederik","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Nis","key":"andersenpau","last":"Andersen","name":"Andersen, Nis","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jens","key":"andresenpau","last":"Andresen","name":"Andresen, Jens","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Toke","key":"bekpau","last":"Bek","name":"Bek, Toke","rank":5,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Morten","key":"lacourpau","last":"La Cour","name":"La Cour, Morten","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sebastian","key":"dinesenpau","last":"Dinesen","name":"Dinesen, Sebastian","rank":7,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Javad","key":"hajaripau","last":"Hajari","name":"Hajari, Javad","rank":8,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Kurt","key":"højlundpau","last":"Højlund","name":"Højlund, Kurt","rank":9,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Caroline","key":"laugesenpau","last":"Laugesen","name":"Laugesen, Caroline","rank":10,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Ryo","key":"kawasakipau","last":"Kawasaki","name":"Kawasaki, Ryo","rank":11,"rolecode":"pau"},{"affno":"8","corresponding":null,"first":"Sören","key":"möllerpau","last":"Möller","name":"Möller, Sören","rank":12,"rolecode":"pau"},{"affno":"9","corresponding":null,"first":"Katja","key":"schielkepau","last":"Schielke","locid":"060067d2-7693-4ac9-9977-d4a06bfe24a9","name":"Schielke, Katja Christina","name_org":"Schielke, Katja","rank":13,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anne","key":"thykjærpau","last":"Thykjær","name":"Thykjær, Anne","rank":14,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lonny","key":"stokholmpau","last":"Stokholm","name":"Stokholm, Lonny","rank":15,"rolecode":"pau"}],"pub":{"issn":["01460404","02730189"],"issn_org":["01460404"],"issue":"7","journal":"Investigative Ophthalmology & Visual Science","paperid":"812","publisher":"Association for Research in Vision and Ophthalmology Inc.","status":"p","title":"Investigative Ophthalmology & Visual Science","volume":"63"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Other Hospitals","Region Zealand","Region of Southern Denmark","Universities","University of Southern Denmark","danish medical association"],"PST":["Published"]},"sid":["aau-6db0838c-54d5-41c3-bece-c840b6491f2f"],"src":["AAU Aalborg University"],"title":"Presence and development of diabetic retinopathy in the Danish Registry of Diabetic Retinopathy","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-794627","year":"2022","yearsub":"2022"}
{"abstract":"BACKGROUND: Retinal neurodegeneration is evident in early diabetic retinopathy (DR) which may be associated with other neurodegenerative diseases like Alzheimer's disease (AD). OBJECTIVE: To investigate diabetes and DR as a risk marker of present and incident AD. METHODS: A register-based cohort study was performed. We included 134,327 persons with diabetes above 60 years of age, who had attended DR screening, and 651,936 age- and gender-matched persons without diabetes. RESULTS: At baseline, the prevalence of AD was 0.7% and 1.3% among patients with and without diabetes, respectively. In a multivariable regression model, patients with diabetes were less likely to have AD at baseline (adjusted OR 0.63, 95% CI 0.59-0.68). During follow-up, incident AD was registered for 1473 (0.35%) and 6,899 (0.34%) persons with and without diabetes, respectively. Compared to persons without diabetes, persons with diabetes and no DR had a lower risk to develop AD (adjusted HR 0.87, 95% CI 0.81-0.93), while persons with diabetes and DR had higher risk of AD (adjusted HR 1.24, 95% CI 1.08-1.43). When persons with diabetes and no DR were used as references, a higher risk of incident AD was observed in persons with DR (adjusted HR 1.34, 95% CI 1.18-1.53). CONCLUSION: Individuals with diabetes without DR were less likely to develop AD compared to persons without diabetes. However, individuals with DR had a 34% higher risk of incident AD, which raise the question whether screening for cognitive impairment should be done among individuals with DR.","author_count":23,"contributors":["Pedersen, Frederik Nørregaard","Stokholm, Lonny","Pouwer, Frans","Hass Rubin, Katrine","Peto, Tunde","Frydkjær-Olsen, Ulrik","Thykjær, Anne Suhr","Andersen, Nis","Andresen, Jens","Bek, Toke","La Cour, Morten","Heegaard, Steffen","Højlund, Kurt","Kawasaki, Ryo","Hajari, Javad Nouri","Ohm Kyvik, Kirsten","Laugesen, Caroline Schmidt","Schielke, Katja Christina","Simó, Rafael","Grauslund, Jakob"],"cuid":["S04-098.51-007541"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"continent":["America, North","Asia, East","Europe, EU","Europe, Non-EU","OECD"],"corresponding_author":["Pedersen, Frederik Nørregaard"],"country":["Canada","Japan","Spain","United Kingdom","United States"],"glorg":["All Global Affiliations","Autonomous University of Barcelona","CIBER - Centro de Investigacion Biomedica en Red","Centro de Investigación Biomédica en Red (CIBER)","Hospital Universitari Vall d'Hebron, Barcelona, Spain.","Osaka City University, Department of Asian Urban Cultures / Osaka University of Foreign Studies","Queen's University Belfast","Queen's University Kingston","The University of Osaka","University of California at Berkeley","University of Osaka","Vall d'Hebron Research Institute","Vall d'Hebron University Hospital"],"keyword":["Alzheimer Disease epidemiology","Alzheimer s disease","Cognitive impairment","Cohort Studies","Dementia","Denmark epidemiology","Diabetes mellitus","Diabetic Retinopathy epidemiology","Diabetic retinopathy","Humans","Registries","Risk Factors"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-OTH","DI-HO-SDR","DI-HO-ZEA"],"OT":["Org Danish Practicing Ophthalmologists"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-OTH","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"diabetic retinopathy predicts risk of alzheimer s disease a danish registry based nationwide cohort study","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.3233/JAD-215313","vers