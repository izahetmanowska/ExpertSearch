 13","corresponding":null,"first":"Simon","key":"phippspau","last":"Phipps","name":"Phipps, Simon","rank":14,"rolecode":"pau"},{"affno":"13","corresponding":null,"first":"Peter D.","key":"slypau","last":"Sly","name":"Sly, Peter D.","rank":15,"rolecode":"pau"},{"affno":"5 7 14","corresponding":null,"first":"Sarath","key":"ranganathanpau","last":"Ranganathan","name":"Ranganathan, Sarath","rank":16,"rolecode":"pau"},{"affno":"1 15 16","first":"Jakob","key":"stokholmpau","last":"Stokholm","locid":"a8a4f99a-ff12-4e00-9a1f-dde487d477b4","name":"Stokholm, Jakob","orcid":"0000-0003-4989-9769","rank":17,"rolecode":"pau"},{"affno":"1 17 18","first":"Karsten","key":"kristiansenpau","last":"Kristiansen","locid":"941041b1-1b8f-4be5-9a65-5e98f662c07e","name":"Kristiansen, Karsten","orcid":"0000-0002-6024-0917","rank":18,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Lawrence","key":"graypau","last":"Gray","name":"Gray, Lawrence","rank":19,"rolecode":"pau"},{"affno":"2 3 5","corresponding":null,"first":"Peter","key":"vuillerminpau","last":"Vuillermin","name":"Vuillermin, Peter","rank":20,"rolecode":"pau"}],"pmid":["34310928"],"pub":{"doi":"10.1016/j.jaci.2021.07.011","issn":["00916749","10858725"],"issn_org":["00916749"],"issue":"3","journal":"Journal of Allergy and Clinical Immunology","publisher":"Elsevier","status":"p","title":"Journal of Allergy and Clinical Immunology","volume":"148"},"review":"Peer Reviewed","scoID":["2-s2.0-85113312173"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region Zealand","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-d214cf4b-9d36-467c-af5c-7d8ac31f9b81","ku-d05a372c-0c7c-493f-9c3e-9d59810570a5"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"The maternal gut microbiome during pregnancy and offspring allergy and asthma","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.84-037341","year":"2021","yearsub":"2021"}
{"abstract":"Neurodegeneration is an early event in the pathogenesis of diabetic retinopathy, and an association between diabetic retinopathy and Parkinson's disease has been proposed. In this nationwide register-based cohort study, we investigated the prevalence and incidence of Parkinson's disease among patients screened for diabetic retinopathy in a Danish population-based cohort. Cases (n = 173 568) above 50 years of age with diabetes included in the Danish Registry of Diabetic Retinopathy between 2013 and 2018 were matched 1:5 by gender and birth year with a control population without diabetes (n = 843 781). At index date, the prevalence of Parkinson's disease was compared between cases and controls. To assess the longitudinal relationship between diabetic retinopathy and Parkinson's disease, a multivariable Cox proportional hazard model was estimated. The prevalence of Parkinson's disease was 0.28% and 0.44% among cases and controls, respectively. While diabetic retinopathy was not associated with present (adjusted odds ratio 0.93, 95% confidence interval 0.72-1.21) or incident Parkinson's disease (adjusted hazard ratio 0.77, 95% confidence interval 0.56-1.05), cases with diabetes were in general less likely to have or to develop Parkinson's disease compared to controls without diabetes (adjusted odds ratio 0.79, 95% confidence interval 0.71-0.87 and adjusted hazard ratio 0.88, 95% confidence interval 0.78-1.00). In a national cohort of more than 1 million persons, patients with diabetes were 21% and 12% were less likely to have prevalent and develop incident Parkinson's disease, respectively, compared to an age- and gender-matched control population without diabetes. We found no indication for diabetic retinopathy as an independent risk factor for incident Parkinson's disease.","author_count":16,"contributors":["Larsen, Maria E. C.","Thykjaer, Anne S.","Pedersen, Frederik N.","Möller, Sören","Laugesen, Caroline S.","Andersen, Nis","Andresen, Jens","Hajari, Javad","Heegaard, Steffen","Højlund, Kurt","Kawasaki, Ryo","Schielke, Katja Christina","Rubin, Katrine H.","Blaabjerg, Morten","Stokholm, Lonny","Grauslund, Jakob"],"cuid":["S03-100.00-009180"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"continent":["Asia, East","OECD"],"corresponding_author":["Larsen, Maria E. C.","Larsen, Maria Emma Carius"],"country":["Japan"],"glorg":["All Global Affiliations","Osaka University","The University of Osaka"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-NDR","DI-HO-OTH","DI-HO-SDR","DI-HO-ZEA"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-NDR","DI-HO-OTH","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"diabetic retinopathy as a potential marker of parkinson s disease a register based cohort study","src":["aau","ku","sdu"],"src-code":["DI-U-AAU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1093/braincomms/fcab262","version":"Published Version"},"id":"S03-100.00-009180","identifier":[{"id":"PMC8599077","type":"pmcid"},{"id":"34806000","type":"pmid"},{"id":"85123950084","type":"scopus"}],"ids":["aau-be4118da-c589-4f91-bda3-5b69e8dfc6f0","ku-9407d029-52f6-4d0c-beb6-4737449f0054","sdu-81388395-8d8b-4a6f-826a-5f831f654011"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-710C280817D4ABA7E25B2DAC9DDEBA2A"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/304483442/fcab262.pdf","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/454623213/Larsen_et_al._2021_._Diabetic_retinopathy_as_a_potential_marker_of_Parkinson_s_dis