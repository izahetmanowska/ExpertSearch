versity","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Occupational and Environmental Medicine"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Marina Ruxandra","key":"oțeleapau","last":"Oțelea","name":"Oțelea, Marina Ruxandra","rank":1,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Anne Kristin M.","key":"fellpau","last":"Fell","name":"Fell, Anne Kristin M.","rank":2,"rolecode":"pau"},{"affno":"1 4","corresponding":null,"first":"Claudia Mariana","key":"handrapau","last":"Handra","name":"Handra, Claudia Mariana","rank":3,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Mathias","key":"holmpau","last":"Holm","name":"Holm, Mathias","rank":4,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Francesca Larese","key":"filonpau","last":"Filon","name":"Filon, Francesca Larese","rank":5,"rolecode":"pau"},{"affno":"7 8","corresponding":null,"first":"Dragan","key":"mijakovskipau","last":"Mijakovski","name":"Mijakovski, Dragan","rank":6,"rolecode":"pau"},{"affno":"7 8","corresponding":null,"first":"Jordan","key":"minovpau","last":"Minov","name":"Minov, Jordan","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andreea","key":"mutupau","last":"Mutu","name":"Mutu, Andreea","rank":8,"rolecode":"pau"},{"affno":"9","corresponding":null,"first":"Euripides","key":"stephanoupau","last":"Stephanou","name":"Stephanou, Euripides","rank":9,"rolecode":"pau"},{"affno":"10","corresponding":null,"country":"dk","first":"Zara Ann","key":"stokholmpau","last":"Stokholm","locid":"dbbbc530-7e63-4065-976f-8f10599f1417","name":"Stokholm, Zara Ann","orcid":"0000-0001-6045-7190","rank":10,"rolecode":"pau"},{"affno":"7 8","corresponding":null,"first":"Sasho","key":"stoleskipau","last":"Stoleski","name":"Stoleski, Sasho","rank":11,"rolecode":"pau"},{"affno":"10","corresponding":null,"country":"dk","first":"Vivi","key":"schlünssenpau","last":"Schlünssen","locid":"422d1a4f-145b-4418-b776-7450d942d03e","name":"Schlünssen, Vivi","orcid":"0000-0003-4915-1734","rank":12,"rolecode":"pau"}],"pmid":["35879723"],"pub":{"doi":"10.1186/s12995-022-00355-1","issn":["17456673"],"issue":"1","journal":"Journal of Occupational Medicine and Toxicology","paperid":"14","publisher":"BioMed Central Ltd.","publisher_org":"BioMed Central Ltd","status":"p","title":"Journal of Occupational Medicine and Toxicology","volume":"17"},"review":"Peer Reviewed","scoID":["2-s2.0-85134783791"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-16a5bca3-53cf-4523-9860-e0f33756e721"],"src":["AU Aarhus University"],"title":"The value of fractional exhaled nitric oxide in occupational diseases – a systematic review","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-142438","year":"2022","yearsub":"2022"}
{"abstract":"Migraine is a disease characterized by cerebral vasodilation. While diabetes has previously been associated with a lower risk of migraine, it is not known if diabetic retinopathy (DR), a retinal peripheral vascular occlusive disease, is a potential biomarker of protection against migraine. Therefore, we aimed to examine diabetic retinopathy as a marker of prevalent and 5-year incident migraine. In a national cohort, we compared patients with diabetes attending DR screening from The Danish National Registry of Diabetic Retinopathy (cases, n = 205,970) to an age- and gender-matched group of patients without diabetes (controls, n = 1,003,170). In the cross-sectional study, a multivariable model demonstrated a lower prevalence of migraine among cases compared with controls (OR 0.83, 95% CI 0.81-0.85), with a lower risk in cases with DR than in those without (OR 0.69, 95% CI 0.65-0.72). In the prospective study, a lower risk of incident migraine was found in a multivariable model in cases (HR 0.76, 95% CI 0.70-0.82), but this did not depend upon the presence of DR. To conclude, in a national study of more than 1.2 million people, patients screened for DR had a lower risk of present migraine, but DR was not a protective marker of incident migraine.","author_count":11,"contributors":["Vergmann, Anna Stage","Stokholm, Lonny","Rubin, Katrine Hass","Thykjær, Anne","Möller, Sören","Laugesen, Caroline Schmidt","Heegaard, Steffen","Højlund, Kurt","Kawasaki, Ryo","Schielke, Katja Christina","Grauslund, Jakob"],"cuid":["S03-100.00-004653"],"filters":{"added":"2022-09","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"continent":["Asia, East","OECD"],"corresponding_author":["Vergmann, Anna Stage"],"country":["Japan"],"glorg":["All Global Affiliations","Osaka University","The University of Osaka","University of Osaka"],"keyword":["Cohort Studies","Cross Sectional Studies","Diabetes Mellitus Type 2 complications","Diabetic Retinopathy diagnosis","Humans","Migraine Disorders complications","Prevalence","Prospective Studies","Risk Factors"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"investigation of the correlation between diabetic retinopathy and prevalent and incident migraine in a national cohort study","src":["aau","ku","sdu"],"src-code":["DI-U-AAU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41598-022-16793-0","version":"Published Version"},"id":"S03-100.00-004653","identifier":[{"id":"85134521395","type":"scopus"},{"id":"35859157","type":"pmid"},{"id":"PMC9300720","type":"pmcid"}],"ids":["aau-5fc7f9f6-6add-48a7-8b66-a22a768526dc","ku-5f37e64d-9570-4089-b0b8-278cb3c88f3a","sdu-aafba5e7-1c53-48b1-bdd3-3f828c718006"],"keyword":["Cohort Studies","Cross-Sectional Studies","Diabetes Mellitus, Type 2/complications","Diabetic Retinopathy/diagnosis","Humans","Migraine Disorders/complications","Prevalence","Prospective Studies","Risk Factors"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-00D08CC16396000B6061F714666CEA2B"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/319805764/s41598_022_16793_0.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/207190275/s41598_022_16793_0.pdf","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/481613729/Vergmann_et_al._2022_._Investigation_of_the_correlation_between_diabetic_retinopathy_and_prevalent_and_incident_migrain