f Copenhagen"],"PST":["Published"]},"sid":["aau-521a1049-19fa-4ebf-ae2a-f12a934b3b9e","itu-2cfd5bcb-21f1-4a4f-bc91-212d2ee5288b","ku-b704ec16-2f20-4a32-a945-545270b1d766"],"src":["AAU Aalborg University","ITU IT University of Copenhagen","KU University of Copenhagen"],"title":"The Migration Mobile : Border Dissidence, Sociotechnical Resistance, and the Construction of Irregularized Migrants","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-092.22-685643","year":"2022","yearsub":"2022"}
{"abstract":"Migrants’ engagement with Information and Communications Technologies (ICTs) reveals a wide spectrum of resistance practices that enact “heterotopias” (Foucault, 1967) that extend from the human body to transnational landscapes (Gillespie et al., 2016). This paper enhances the theoretical debate on migration with new ways of understanding borders and space as fluid, autonomous, and provisional linkages between humans and nonhumans. Based on findings from field research conducted in Greece, it aims to discuss how migrants’ digital practices generate new spaces and materialities. Attending to the making of migrants’-ICTs intertwining it examines the emergence of unbordering practices, the creation of crucial solidarity networks and the risks and limitations that emerge when using ICTs. Finally, the paper highlights the recent migratory influx not simply as a result of neoliberal doctrines, but (also) as an act of disobedience to fortress Europe through the creation of digital-urban heterotopias through the lenses of Migration Studies, Science and Technology Studies and Critical spatial theory.","author_count":2,"contributors":["Galis, Vasilis","Makrygianni, Vasiliki"],"cuid":["S01-000.00-384544"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["ICTs","Migration","Multiple","Space","heterotopias"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"analog flows in digital worlds migration multiples and digital heterotopias in greek territory","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.polgeo.2022.102599","version":"Published Version"},"id":"S01-000.00-384544","identifier":[{"id":"85122968511","type":"scopus"}],"ids":["itu-dedcea77-67fd-472b-a077-418adb65f769"],"keyword":["ICTs","Migration","Multiple","Space","heterotopias"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-B9DD245259F841047C1AF0B5D8A12961"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/102752981/1-s2.0-S0962629822000130-main.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.polgeo.2022.102599","version":"Published Version"},{"access":"oa","type":"rem","url":"https://www.sciencedirect.com/science/article/pii/S0962629822000130/pdfft?md5=a35035a66c4dfc4d5ee6958866027ea3&pid=1-s2.0-S0962629822000130-main.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Center for Digital Welfare","IT University of Copenhagen, Technologies in Practice, Technologies in Practice"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Vasilis","key":"galispau","last":"Galis","locid":"443362d7-b255-460d-a559-0fa80a8d9fbc","name":"Galis, Vasilis","orcid":"0000-0002-4621-3699","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Vasiliki","key":"makrygiannipau","last":"Makrygianni","name":"Makrygianni, Vasiliki","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.polgeo.2022.102599","issn":["09626298","18735096"],"issn_org":["09626298"],"journal":"Political Geography","publisher":"Elsevier","status":"p","title":"Political Geography"},"review":"Peer Reviewed","scoID":["2-s2.0-85122968511"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-dedcea77-67fd-472b-a077-418adb65f769"],"src":["ITU IT University of Copenhagen"],"title":"Analog flows in digital worlds : ‘Migration multiples’ and digital heterotopias in Greek territory","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384544","year":"2022","yearsub":"2022"}
{"abstract":"Social researchers often walk a tightrope. On the one hand, they try to adhere to ethical principles when working with vulnerable groups. On the other, they aim to not cast these groups as inherently lacking agency. Digital practices have only made this dilemma more acute by strengthening the agency of vulnerable groups—in this case, those within the European border regime threatened by deportation—while also putting migrants at increased danger from bordering and surveillance practices. Drawing from a militant research approach, as well as from the Autonomy of Migration (AoM) perspective, this contribution illuminates this dilemma, while also arguing for reflexive and contextualised ethics aimed towards solidarity and social change.","author_count":6,"contributors":["Fischer, Leandros","Jørgensen, Martin Bak"],"cuid":["S01-000.00-057268"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"impossible research ethical challenges in the digital study of deportable populations within the european border regime","src":["aau"],"src-code":["DI-U-AAU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1007/978-3-030-81226-3_6","version":"Published Version"},"id":"S01-000.00-057268","ids":["aau-18a89522-de04-4380-8432-44652ecfe81f"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-3-CB4C1F2C8BBBD55E55BF780F66AD6A05"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1007/978-3-030-81226-3_6","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Humanities","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Culture and Learning","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Culture and Learning, Democracy, Migration and Society (DEMOS)"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Leandros","key":"fischerpau","last":"Fischer","locid":"1b27631f-9077-49e5-9049-6ad03ea7acfa","name":"Fischer, Leandros","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Martin Bak","key":"jørgensenpau","last":"Jørgensen","locid":"5e41f079-bbd2-4a57-a1d3-8fad8c9233de","name":"Jørgensen, Martin Bak","orcid":"0000-0003-0104-8543","rank":2,"rolecode":"pau"},{"affno":"","first":"Marie","key":"sandbergpedh","last":"Sandberg","name":"Sandberg, Marie","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Luca","key":"rossipedh","last":"Rossi","name":"Rossi, Luca","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Vasilis","key":"galispedh","last":"Galis","name":"Galis, Vasilis","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Martin","key":"bakjørgensenpedh","last":"Bak Jørgensen","name":"Bak Jørgensen, Martin","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-030-81226-3_6","eisbn":["N 9783030812263"],"isbn":["9783030812256"],"pages":"141-166","place":"Cham, Switzerland","publisher":"Palgrave Macmillan","series":"Approaches to Social Inequality and Difference","status":"p","subtitle":"Caring For (Big) Data?","title":"Research Methodologies and Ethical Challenges in Digital Migration Studies"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-18a89522-de04-4380-8432-44652ecfe81f"],"src":["AAU Aalborg University"],"title":"Impossible Research? Ethical Challenges in the (Digital) Study of Deportable Populations Within the European Border Regime","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-057268","year":"2021","yearsub":"2021"}
{"abstract":"This chapter presents a rethinking of the relationship between ethnography and so-called big social data as being comparable to those between a sum and its parts (Strathern 1991/2004). Taking cue from Tim Ingold’s one world anthropology (2018) the chapter argues that relations between ethnography and social media data can be established as contrapuntal. That is, the types of material are understood as different, yet fundamentally interconnected. The chapter explores and qualifies this affinity with the aim of identifying potentials and further questions for digital migration research. The chapter is based on ethnographic fieldwork carried out with Syrian refugees and solidarians in the Danish–Swedish borderlands in 2018–2019 as well as data collected for 2011–2018 from 200 public Facebook pages run by solidarity organisations, NGOs, and informal refugee welcome and solidarity groups.","author_count":7,"contributors":["Sandberg, Marie","Mollerup, Nina Grønlykke","Rossi, Luca"],"cuid":["S01-000.00-439690"],"filters":{"added":"2022-04","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"contrapuntal connectedness analysing relations between social media data and ethnography in digital migration studies","src":["ku"],"src-code":["DI-U-KU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-3-030-81226-3_3","version":"Published Version"},"id":"S01-000.00-439690","ids":["ku-4d942a96-25af-4c87-af8b-564bed6453e5"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-3-ED666198728334962EDD08A2CFE7F7EF"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-3-030-81226-3_3","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Humanities, SAXO-Institute - Archaeology, Ethnology, Greek & Latin, History"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","first":"Marie","key":"sandbergpau","last":"Sandberg","locid":"556598fb-c2f2-4f52-875f-47c31eaea1b0","name":"Sandberg, Marie","orcid":"0000-0001-7831-3419","rank":1,"rolecode":"pau"},{"affno":"1","first":"Nina Grønlykke","key":"molleruppau","last":"Mollerup","locid":"e2842eb7-d21c-4422-9efb-2d3fd56f21a5","name":"Mollerup, Nina Grønlykke","orcid":"0000-0002-5368-5686","rank":2,"rolecode":"pau"},{"affno":"2","first":"Luca","key":"rossipau","last":"Rossi","name":"Rossi, Luca","rank":3,"rolecode":"pau"},{"affno":"","first":"Marie","key":"sandbergpedh","last":"Sandberg","name":"Sandberg, Marie","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Luca","key":"rossipedh","last":"Rossi","name":"Rossi, Luca","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Vasilis","key":"galispedh","last":"Galis","name":"Galis, Vasilis","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Martin Bak","key":"jørgensenpedh","last":"Jørgensen","name":"Jørgensen, Martin Bak","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-030-81226-3_3","eisbn":["9783030812263"],"isbn":["9783030812256"],"pages":"53-86","place":"Switzerland","publisher":"Palgrave Macmillan","status":"p","title":"Research methodologies and ethical challenges in digital migration studies: Caring for (big) data"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-4d942a96-25af-4c87-af8b-564bed6453e5"],"src":["KU University of Copenhagen"],"title":"Contrapuntal connectedness : Analysing relations between social media data and ethnography in digital migration studies","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-439690","year":"2021","yearsub":"2021"}
{"abstract":"Digital technologies present new methodological and ethical challenges for migration studies: from ensuring data access in ethically viable ways to privacy protection, ensuring autonomy, and security of research participants. This Introductory chapter argues that the growing field of digital migration research requires new modes of caring for (big) data. Besides from methodological and ethical reflexivity such care work implies the establishing of analytically sustainable and viable environments for the respective data sets—from large-scale data sets (“big data”) to ethnographic materials. Further, it is argued that approaching migrants’ digital data “with care” means pursuing a critical approach to the use of big data in migration research where the data is not an unquestionable proxy for social activity but rather a complex construct of which the underlying social practices (and vulnerabilities) need to be fully understood. Finally, it is presented how the contributions of this book offer an in-depth analysis of the most crucial methodological and ethical challenges in digital migration studies and reflect on ways to move this field forward.","author_count":6,"contributors":["Sandberg, Marie","Rossi, Luca"],"cuid":["S01-000.00-526454"],"filters":{"added":"2022-04","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"caring for big data an introduction to research methodologies and ethical challenges in digital migration studies","src":["ku"],"src-code":["DI-U-KU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/978-3-030-81226-3_1","version":"Published Version"},"id":"S01-000.00-526454","ids":["ku-deab9419-b963-47d0-8917-7cc892b26db3"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-3-961FC66CB582BD8AE0F57073E2899CAD"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/978-3-030-81226-3_1","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Humanities, SAXO-Institute - Archaeology, Ethnology, Greek & Latin, History"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","first":"Marie","key":"sandbergpau","last":"Sandberg","locid":"556598fb-c2f2-4f52-875f-47c31eaea1b0","name":"Sandberg, Marie","orcid":"0000-0001-7831-3419","rank":1,"rolecode":"pau"},{"affno":"2","first":"Luca","key":"rossipau","last":"Rossi","name":"Rossi, Luca","rank":2,"rolecode":"pau"},{"affno":"","first":"Marie","key":"sandbergpedh","last":"Sandberg","name":"Sandberg, Marie","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Luca","key":"rossipedh","last":"Rossi","name":"Rossi, Luca","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Vasilis","key":"galispedh","last":"Galis","name":"Galis, Vasilis","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Martin Bak","key":"jørgensenpedh","last":"Jørgensen","name":"Jørgensen, Martin Bak","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi