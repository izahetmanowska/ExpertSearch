DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-1b440737-115b-4e1a-80bb-ffc572e5e5b4"],"src":["ITU IT University of Copenhagen"],"title":"Når Demokrati, Korruption og Ånder Går Hånd i Hånd","type":"Journal Book Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381671","year":"2018","yearsub":"2018"}
{"abstract":"This paper discusses how an ‘eco-system’ of taxi apps has taken part in changing what it means to be a taxi-driver in the Indonesian city of Yogyakarta. The relation between drivers and the companies behind the apps is described as a form of mutually ‘symbiotic’ interdependence. However, it is hardly a symmetrical relationship, nor one that is easily captured with the idealist notion of ‘peer-to-peer’ often used in IT-parlance. Among the concerns to the drivers is how they have begun to think differently about the way they are handling not only money but also mobility across the city-scape, when almost all interaction with passengers is facilitated digitally, and when their earnings are controlled and ‘cut’ by company-bank partnerships. The apps present various affordances from gamification to vouchers that incentivize both passengers and drivers, but some drivers try to operate in the gaps left open by the technology in order to access cash. The case demonstrates not only how the appropriation of such apps is understood within a context of multiple existing infrastructures, but also how value circulates in new forms and through new channels when mobility is reconfigured in the connection of the transport sector with app-based micro-finance.","author_count":2,"contributors":["Sandbukt, Sunniva","Dalsgaard, Steffen"],"cuid":["S01-000.00-384763"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["App based micro finance","Digital mobility","Peer to peer dynamics","Symbiotic interdependence","Taxi apps"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"the cut the circulation of money and taxis in yogyakarta indonesia","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-384763","ids":["itu-ed21fc30-4a06-4b4f-9301-0a422ec05c06"],"keyword":["App-based micro-finance","Digital mobility","Peer-to-peer dynamics","Symbiotic interdependence","Taxi apps"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-7E45F1F2A2CA74B1A3BA211F45691B4E"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Business IT, European Blockchain Center (EBC)"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Sunniva","key":"sandbuktpau","last":"Sandbukt","locid":"06d038a4-f659-4c53-8a6d-58e295ab603f","name":"Sandbukt, Sunniva","orcid":"0009-0002-4274-4991","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Steffen","key":"dalsgaardpau","last":"Dalsgaard","locid":"bc7a60f7-45a0-401f-813f-6b4aa700c849","name":"Dalsgaard, Steffen","orcid":"0000-0003-3712-6988","rank":2,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-ed21fc30-4a06-4b4f-9301-0a422ec05c06"],"src":["ITU IT University of Copenhagen"],"title":"The Cut: The Circulation of Money and Taxis in Yogyakarta, Indonesia","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384763","year":"2018","yearsub":"2018"}
