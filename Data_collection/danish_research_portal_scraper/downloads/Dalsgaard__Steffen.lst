45a0-401f-813f-6b4aa700c849","name":"Dalsgaard, Steffen","orcid":"0000-0003-3712-6988","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Julia","key":"kirchkirkegaardpau","last":"Kirch Kirkegaard","name":"Kirch Kirkegaard, Julia","rank":2,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["itu-a6e7a473-3394-4298-9e4b-410f20fc30bc"],"src":["ITU IT University of Copenhagen"],"title":"The Value of X: Analysing power-to-x as potential","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-818249","year":"2025","yearsub":"2025"}
{"abstract":"This introduction and the volume as a whole discuss the transformational role that carbon has come to play in social and cultural life. As a proxy for greenhouse gas emissions, carbon has become a phenomenon that can no longer be accounted for solely within the technoscientific vocabulary of climate scientists or as an economic externality to human modes of production. As a new value form, carbon has entered individual and collective imaginaries across the globe. We contend that this entrance is by no means uniform. The introduction thus attends to carbon as a range of diverse phenomena in human lives and, second, to the way that it can be approached as culture. It continues with a discussion of carbon's potential for generating or promoting change, before turning to the different contributions to this volume, and how they provide unique perspectives on the topic of carbon as a cultural phenomenon. The chapters are thus framed through a focus on the diverse meanings ascribed to carbon in different cultural contexts. In sum, in the introduction, together with the volume as a whole, we demonstrate how paying attention to carbon as a cultural phenomenon allows for a more profound appreciation of when, how and why carbon enables (or sometimes disables) change in the form of green transitions or transformations.","author_count":1,"contributors":["Dalsgaard, Steffen"],"cuid":["S01-000.00-818252"],"filters":{"added":"2025-08","altsrc":["Global Data"],"author_count":"1 contributor","cluster_size":1,"keyword":["Built environment","Environment and Sustainability","Social sciences"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"introduction carbon and culture change","src":["itu"],"src-code":["DI-U-ITU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.4324/9781003478669","version":"Published Version"},"id":"S01-000.00-818252","identifier":[{"id":"105003355877","type":"scopus"}],"ids":["itu-d211f659-a20d-464c-9ab4-24bd5d12bc2f"],"keyword":["Built Environment","Environment and Sustainability","Social Sciences"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-3-4-2BDF33A350C2F69A980BFAA4BD296B43"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.4324/9781003478669","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Climate IT","IT University of Copenhagen, Technologies in Practice","IT University of Copenhagen, Technologies in Practice, Technologies in Practice"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Steffen","key":"dalsgaardpau","last":"Dalsgaard","locid":"bc7a60f7-45a0-401f-813f-6b4aa700c849","name":"Dalsgaard, Steffen","orcid":"0000-0003-3712-6988","rank":1,"rolecode":"pau"}],"pub":{"doi":"10.4324/9781003478669","edition":"1st","eisbn":["9781003478669"],"pages":"1-24","place":"London","publisher":"Routledge","status":"p","title":"The Cultural Complexity of Carbon"},"review":"Peer Reviewed","scoID":["2-s2.0-105003355877"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-d211f659-a20d-464c-9ab4-24bd5d12bc2f"],"src":["ITU IT University of Copenhagen"],"title":"Introduction: Carbon and Culture Change","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-818252","year":"2025","yearsub":"2025"}
{"abstract":"\"Carbon\" in the form of emission permits or credits displays several functions that allow us to compare it to actual currencies. It represents and compares a vast multiplicity of actions, and it both temporalises and territorialises value. Yet what is traded is often criticised for not existing.","author_count":1,"contributors":["Dalsgaard, Steffen"],"cuid":["S01-000.00-754087"],"filters":{"added":"2024-09","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"keyword":["Carbon credits","Carbon markets","Emissions trading"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"carbon the currency which values everything and prices nothing","src":["itu"],"src-code":["DI-U-ITU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://easaonline.org/conferences/easa2024/programme#14777","version":"Authors Final Version"},"id":"S01-000.00-754087","ids":["itu-e2973349-34e3-4399-a8c5-8bbff81eca78"],"keyword":["Carbon credits","Carbon markets","Emissions trading","Ontology in information science","Temporalisation of value"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-F5DCFE18595B5BAE5586624567E7F959"],"oa_link":[{"access":"oa","type":"rem","url":"https://easaonline.org/conferences/easa2024/programme#14777","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Center for Climate IT","IT University of Copenhagen, Technologies in Practice, Technologies in Practice"],"nora_cod