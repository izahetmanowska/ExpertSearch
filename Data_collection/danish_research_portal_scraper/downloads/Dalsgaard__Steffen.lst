{"author_count":1,"contributors":["Dalsgaard, Steffen"],"cuid":["S01-000.00-384155"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"carbon","src":["itu"],"src-code":["DI-U-ITU"],"type":"doi","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://blogit.itu.dk/technologiesinpractice/2019/11/05/carbon/","version":"Published Version"},"id":"S01-000.00-384155","ids":["itu-c4da5821-ba5e-40cf-99cf-f57c846cbc31"],"lang":"Danish","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-07B8DAF167E033590795BF8C09AD29AD"],"oa_link":[{"access":"oa","type":"rem","url":"https://blogit.itu.dk/technologiesinpractice/2019/11/05/carbon/","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Steffen","key":"dalsgaardpau","last":"Dalsgaard","locid":"bc7a60f7-45a0-401f-813f-6b4aa700c849","name":"Dalsgaard, Steffen","orcid":"0000-0003-3712-6988","rank":1,"rolecode":"pau"}],"pub":{"status":"X"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Undefined"]},"sid":["itu-c4da5821-ba5e-40cf-99cf-f57c846cbc31"],"src":["ITU IT University of Copenhagen"],"title":"Carbon","type":"Other-Internet Publication","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384155","year":"2020","yearsub":"2020"}
{"abstract":"Increasing focus on patient safety makes it important to ensure surgical competency among surgeons before operating on patients. The objective was to gather validity evidence for a virtual-reality simulator test for robotic surgical skills and evaluate its potential as a training tool. Surgeons with varying experience in robotic surgery were recruited: novices (zero procedures), intermediates (1-50), experienced (> 50). Five experienced surgeons rated five exercises on the da Vinci Skills Simulator. Participants were tested using the five exercises. Participants were invited back 3 times and completed a total of 10 attempts per exercise. The outcome was the average simulator performance score for the 5 exercises. 32 participants from 5 surgical specialties were included. 38 participants completed all 4 sessions. A moderate correlation between the average total score and robotic experience was identified for the first attempt (Spearman r = 0.58; p = 0.0004). A difference in average total score was observed between novices and intermediates [median score 61% (IQR 52-66) vs. 83% (IQR 75-91), adjusted p < 0.0001], as well as novices and experienced [median score 61% (IQR 52-66) vs. 80 (IQR 69-85), adjusted p = 0.002]. All three groups improved their performance between the 1st and 10th attempts (p < 0.00). This study describes validity evidence for a virtual-reality simulator for basic robotic surgical skills, which can be used for assessment of basic competency and as a training tool. However, more validity evidence is needed before it can be used for certification or high-stakes assessment.","author_count":8,"contributors":["Havemann, Maria Cecilie","Dalsgaard, Torur","Sørensen, Jette Led","Røssaak, Kristin","Brisling, Steffen","Mosgaard, Berit Jul","Høgdall, Claus","Bjerrum, Flemming"],"cuid":["S01-000.00-464180"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Assessment","Robotic surgery","Simulation","Validity","Virtual reality"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"examining validity evidence for a simulation based assessment tool for basic robotic surgical skills","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-464180","identifier":[{"id":"29761352","type":"pmid"},{"id":"85055517302","type":"scopus"}],"ids":["ku-764127af-369c-47d7-bc8f-95e86aef9905"],"keyword":["Assessment","Robotic surgery","Simulation","Validity","Virtual reality"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-18FAA7BD23D85ED8D29A37EFC492A793"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Obstetrics and Gynaecology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Maria Cecilie","key":"havemannpau","last":"Havemann","name":"Havemann, Maria Cecilie","rank":1,"rolecode":"pau"},{"affno":"","first":"Torur","key":"dalsgaardpau","last":"Dalsgaard","name":"Dalsgaard, Torur","rank":2,"rolecode":"pau"},{"affno":"1","first":"Jette Led","key":"sørensenpau","last":"Sørensen","locid":"84ce4092-8277-45c1-89d5-afedea9c65f0","name":"Sørensen, Jette Led","orcid":"0000-0002-7320-2784","rank":3,"rolecode":"pau"},{"affno":"","first":"Kristin","key":"røssaakpau","last":"Røssaak","name":"R