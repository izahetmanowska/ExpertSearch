, IT management and leadership"],"nora_code":"DI-U-ITU","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"4","country":"dk","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anders","key":"søgaardpau","last":"Søgaard","name":"Søgaard, Anders","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rebecca","key":"adlernissenpau","last":"Adler-Nissen","name":"Adler-Nissen, Rebecca","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Steffen","key":"dalsgaardpau","last":"Dalsgaard","locid":"bc7a60f7-45a0-401f-813f-6b4aa700c849","name":"Dalsgaard, Steffen","orcid":"0000-0003-3712-6988","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Vibe","key":"gedsøfrøkjærpau","last":"Gedsø Frøkjær","name":"Gedsø Frøkjær, Vibe","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kristin","key":"veelpau","last":"Veel","name":"Veel, Kristin","rank":5,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Sune","key":"lehmannpau","last":"Lehmann","name":"Lehmann, Sune","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kresten","key":"lindorfflarsenpau","last":"Lindorff-Larsen","name":"Lindorff-Larsen, Kresten","rank":7,"rolecode":"pau"}],"pub":{"issn":["09071814"],"newspaper":"Politiken","publisher":"JP/Politikens Hus AS","publisher_org":"JP/Politikens H