o":"1","corresponding":null,"first":"Vera","key":"vanderburgpau","last":"van der Burg","name":"van der Burg, Vera","rank":13,"rolecode":"pau"}],"pub":{"doi":"10.1145/3656156.3658398","eisbn":["9798400706325"],"pages":"396-400","place":"Copenhagen, Denmark","publisher":"Association for Computing Machinery (ACM)","status":"p","title":"DIS 2024 - Proceedings of the 2024 ACM Designing Interactive Systems Conference"},"review":"Peer Reviewed","scoID":["2-s2.0-85198903016"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["aau-2401a2f0-09d2-4f14-ab3f-9d8f4710e95c","itu-9e885c49-7cff-4d78-b330-271757e69dc6"],"src":["AAU Aalborg University","ITU IT University of Copenhagen"],"title":"Death of the Design Researcher? Creating Knowledge Resources for Designers Using Generative AI","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-088.22-803632","year":"2024","yearsub":"2024"}
{"abstract":"Ongoing efforts to turn Machine Learning (ML) into a design material have encountered limited success. This paper examines the burgeoning area of AI art to understand how artists incorporate ML in their creative work. Drawing upon related HCI theories, we investigate how artists create ambiguity by analyzing nine AI artworks that use computer vision and image synthesis. Our analysis shows that, in addition to the established types of ambiguity, artists worked closely with the ML process (dataset curation, model training, and application) and developed various techniques to evoke the ambiguity of processes. Our finding indicates that the current conceptualization of ML as a design material needs to reframe the ML process as design elements, instead of technical details. Finally, this paper offers reflections on commonly held assumptions in HCI about ML uncertainty, dependability, and explainability, and advocates to supplement the artifact-centered design perspective of ML with a process-centered one.","author_count":5,"contributors":["Sivertsen, Christian","Salimbeni, Guido","Løvlie, Anders Sundnes","Benford, Steve","Zhu, Jichen"],"cuid":["S01-000.00-747257"],"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of Nottingham"],"keyword":["Ambiguity","Art","Artificial intelligence","Computer vision","Generative art","Machine learning"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"machine learning processes as sources of ambiguity insights from ai art","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Andet","type":"doi","url":"https://doi.org/10.1145/3613904.3642855","version":"Published Version"},"id":"S01-000.00-747257","identifier":[{"id":"85194816490","type":"scopus"}],"ids":["itu-b1c4ca86-1082-449f-aeec-78a7a3b05bba"],"keyword":["ambiguity","art","artificial intelligence","computer vision","generative art","machine learning"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-CEBB89AAD8A5D37E98E491E87878EE76"],"oa_link":[{"access":"oa","license":"Andet","type":"doi","url":"https://doi.org/10.1145/3613904.3642855","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Play, Culture, and AI, Media, Art & Design"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"gb","key":"university of nottingham","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Nottingham","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Christian","key":"sivertsenpau","last":"Sivertsen","locid":"610312cd-b173-4efa-bbb5-0a22e9b9ce02","name":"Sivertsen, Christian","orcid":"0000-0001-6843-5009","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Guido","key":"salimbenipau","last":"Salimbeni","name":"Salimbeni, Guido","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders Sundnes","key":"løvliepau","last":"Løvlie","locid":"22ec9269-2fff-4dbf-a9c7-5037559a15ee","name":"Løvlie, Anders Sundnes","orcid":"0000-0003-0484-4668","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Steve","key":"benfordpau","last":"Benford","name":"Benford, Steve","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jichen","key":"zhupau","last":"Zhu","locid":"e383647f-00d3-41b1-ad95-ff69bdfffb42","name":"Zhu, Jichen","orcid":"0000-0001-6740-4550","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1145/3613904.3642855","eisbn":["9798400703300"],"pages":"1-14","place":"New York, NY, USA","publisher":"Association for Computing Machinery","status":"p","title":"Proceedings of the 2024 CHI Conference on Human Factors in Computing Systems"},"review":"Peer Reviewed","scoID":["2-s2.0-85194816490"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-b1c4ca86-1082-449f-aeec-78a7a3b05bba"],"src":["ITU IT University of Copenhagen"],"title":"Machine Learning Processes as Sources of Ambiguity : Insights from AI Art","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-747257","year":"2024","yearsub":"2024"}
{"abstract":"Relatively little is known about whether and how people from different co jichen.zhu@gmail.com untries play differently. Existing literature is still debating whether countries can serve as proxies for cultures. This paper is among the first to present a large-scale exploratory study (n = 14,361 from 107 countries) trying to validate empirically whether it is acceptable to utilize countries to group players of Ubisoft's Rainbow Six Siege, a popular online multiplayer game. We developed a survey collecting various player information, including demographics, habits, appreciation, and several psychological measures. Through a data-driven approach, this paper examines whether the variance in responses within users from the same country is less than the variance identified between users from different countries. If the answer is positive, then the approach of utilizing country as a proxy for culture could be justified empirically. The results show that players from the same countries respond to the survey in a marginally more homogeneous way than players from different countries.","author_count":8,"contributors":["Canossa, Alessandro","Azadvar, Ahmad","Zhu, Jichen","Harteveld, Casper","Pirker, Johanna"],"cuid":["S01-000.00-795444"],"filters":{"added":"2025-04","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Europe, EU","Nordic","OECD"],"country":["Austria","Sweden","United States"],"glorg":["All Global Affiliations","Massive Entertainment - a Ubisoft Studio","Northeastern University","Technical University of Graz"],"keyword":["Country","Culture","Geography","Online games","Player Experience"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-ART","DI-U"],"level3":{"ART":["DI-ART-ALL","DI-ART-RDKA"],"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-ART-RDKA","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"country as a proxy for culture an exploratory study of players in an online multiplayer game","src":["arkc"],"src-code":["DI-ART-RDKA"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85194181098","version":"Other Version"},"id":"S01-000.00-795444","identifier":[{"id":"85194181098","type":"scopus"}],"ids":["arkc-478eb59a-aac3-4052-b5c7-918fb169b0a0"],"keyword":["No","country","culture","geography","online games","player experience","psychological measurements"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-4-B0AAFBCD9D67C271CBCE09C6F706EA03"],"org":[{"affno":"1","key":"royal danish academy architecture design conservation","l2":"DI-ART","l2n":"Artistic Higher Education Institutions","l3":"DI-ART-RDKA","l3nn":"Royal Danish Academy - Architecture, Design, Conservation","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Royal Danish Academy - Architecture, Design, Conservation","namevar":["Royal Danish Academy - Architecture, Design, Conservation","Royal Danish Academy - Architecture, Design, Conservation, Royal Danish Academy - Design, Institute of Design and Visual Interaction"],"nora_code":"DI-ART-RDKA","used":1},{"affno":"2","country":"se","key":"massive entertainment a ubisoft studio","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Massive Entertainment - a Ubisoft Studio","used":1},{"affno":"3","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1},{"affno":"4","country":"us","key":"northeastern university","loc":["United States","America, North","OECD"],"name":"Northeastern University","used":1},{"affno":"5","country":"at","key":"technical university of graz","loc":["Austria","Europe, EU","OECD"]