{"abstract":"Capturing physical activity–based social comparison preferences is feasible in an adaptive digital environment, and day-to-day differences in preferences for social comparison targets are associated with day-to-day changes in physical activity motivation and behavior. Findings show that participants only sometimes focus on the comparison opportunities that support their physical activity motivation or behavior, which helps explain previous, equivocal findings regarding the benefits of physical activity–based comparisons. Additional investigation of day-level determinants of comparison selections and responses is needed to fully understand how best to harness comparison processes in digital tools to promote physical activity.","author_count":5,"contributors":["Arigo, Danielle","Gray, Robert C","Dallal, Diane H","Villareale, Jennifer","Zhu, Jichen"],"cuid":["S01-000.00-718824"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Drexel University","Rowan University"],"keyword":["Exercise","Fitness","Mobile phone","Motivation","Physical activity","Selection","Social comparison","Web platform"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"selection of and response to physical activity based social comparisons in a digital environment series of daily assessment studies","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.2196/41239","version":"Published Version"},"id":"S01-000.00-718824","identifier":[{"id":"85149832945","type":"scopus"}],"ids":["itu-08829e8c-56e9-4a6f-910f-9e6ac6a59773"],"keyword":["exercise","fitness","mobile phone","motivation","physical activity","selection","social comparison","web platform"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-E3F70DC4433A11AD095BAAE3B3F0A3D9"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.2196/41239","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/102876434/PDF.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"us","key":"rowan university","loc":["United States","America, North","OECD"],"name":"Rowan University","used":1},{"affno":"2","country":"us","key":"drexel university","loc":["United States","America, North","OECD"],"name":"Drexel University","used":1},{"affno":"3","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Danielle","key":"arigopau","last":"Arigo","name":"Arigo, Danielle","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Robert C","key":"graypau","last":"Gray","name":"Gray, Robert C","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Diane H","key":"dallalpau","last":"Dallal","name":"Dallal, Diane H","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jennifer","key":"villarealepau","last":"Villareale","name":"Villareale, Jennifer","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jichen","key":"zhupau","last":"Zhu","locid":"e383647f-00d3-41b1-ad95-ff69bdfffb42","name":"Zhu, Jichen","orcid":"0000-0001-6740-4550","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.2196/41239","issn":["22929495"],"journal":"JMIR Human Factors","publisher":"JMIR Publications","stat