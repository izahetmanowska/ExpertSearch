of Copenhagen, Digital Design","IT University of Copenhagen, Digital Design, Design Research Section","IT University of Copenhagen, Human-Computer Interaction and Design, Procedural eXpression Lab"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jennifer","key":"villarealepau","last":"Villareale","name":"Villareale, Jennifer","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Sai Siddartha","key":"marampau","last":"Maram","name":"Maram, Sai Siddartha","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jichen","key":"zhupau","last":"Zhu","locid":"e383647f-00d3-41b1-ad95-ff69bdfffb42","name":"Zhu, Jichen","orcid":"0000-0001-6740-4550","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Magy Seif","key":"elnasrpau","last":"El-Nasr","name":"El-Nasr, Magy Seif","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1145/3582437.3582451","pages":"1-9","status":"p","title":"Proceedings of the 18th International Conference on the Foundations of Digital Games"},"review":"Peer Reviewed","scoID":["2-s2.0-85153566467"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-5ab09d97-7fcb-4bd5-bae7-16cac574019d"],"src":["ITU IT University of Copenhagen"],"title":"Integrating Players’ Perspectives in AI-Based Games: Case Studies of Player-AI Interaction Design","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-718857","year":"2023","yearsub":"2023"}
{"abstract":"Originating from the premise that Generative Adversarial Networks (GANs) enrich creative processes rather than diluting them, we describe an ongoing PhD project that proposes to study GANs in a co-creative context. By asking How can GANs be applied in co-creation, and in doing so, how can they contribute to fashion design processes? the project sets out to investigate co-creative GAN applications and further develop them for the specific application area of fashion design. We do so by drawing on the field of mixed-initiative co-creation. Combined with the technical insight into GANs' functioning, we aim to understand how their algorithmic properties translate into interactive interfaces for co-creation and propose new interactions.","author_count":2,"contributors":["Grabe, Imke","Zhu, Jichen"],"cuid":["S01-000.00-718920"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Co creative processes","Fashion design","Generative Adversarial Networks","Interactive interfaces","Mixed initiative co creation"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"nr","rtype":["clu"],"sorti":"towards co creative generative adversarial networks for fashion designers","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.48550/arXiv.2304.09477","version":"Published Version"},"id":"S01-000.00-718920","ids":["itu-d06c585e-ba3f-4f60-98fe-914022575cb6"],"keyword":["Co-creative processes","Fashion design","Generative Adversarial Networks","Interactive interfaces","Mixed-initiative co-creation"],"lang":"Undetermined","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-C9C01A573245E698905076D03FCA3EF5"],"oa_link":[{"access":"oa","type":"rem","url":"https://arxiv.org/abs/2304.09477","version":"Other Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.48550/arXiv.2304.09477","version":"Published Version"},{"access":"oa","type":"rem","url":"https://arxiv.org/pdf/2304.09477.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Human-Computer Interaction and Design, Procedural eXpression Lab"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Imke","key":"grabepau","last":"Grabe","locid":"7c852728-c562-4df0-84c1-4488dde7c360","name":"Grabe, Imke","orcid":"0000-0002-5122-6769","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jichen","key":"zhupau","last":"Zhu","locid":"e383647f-00d3-41b1-ad95-ff69bdfffb42","name":"Zhu, Jichen","orcid":"0000-0001-6740-4550","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.48550/arxiv.2304.09477","issn":["19765541"],"issn_org":["23318422"],"journal":"arXiv","publisher":"arXiv","status":"p","title":"arXiv"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-d06c585e-ba3f-4f60-98fe-914022575cb6"],"src":["ITU IT University of Copenhagen"],"title":"Towards Co-Creative Generative Adversarial Networks for Fashion Designers","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-718920","year":"2023","yearsub":"2023"}
{"abstract":"This paper presents a speculation on a fictive co-creation scenario that extends classical interaction patterns with generative models. While existing interfaces are restricted to the input and output layers, we suggest hidden layer interaction to extend the horizonal relation at play when co-creating with a generative model’s design space. We speculate on applying feature visualization to ma- nipulate neurons corresponding to features ranging from edges over textures to objects. By integrating visual representations of a neural network’s hidden layers into co-creation, we aim to provide humans with a new means of interaction, contributing to a phenomenological account of the model’s inner workings during generation.","author_count":2,"contributors":["Grabe, Imke","Zhu, Jichen"],"cuid":["S01-000.00-718923"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Co creation","Feature visualization","Generative models","Hidden layer interaction","Neural network representation"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"hidden layer interaction a co creative design fiction for generative models","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.48550/arXiv.2304.00266","version":"Published Version"},"id":"S01-000.00-718923","ids":["itu-d7fc0a48-cc54-4ed6-acee-ae5ce9109db3"],"keyword":["Co-creation","Feature visualization","Generative models","Hidden layer interaction","Neural network representation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-C895595D348C4C99EB3B481E8CA3C866"],"oa_link":[{"access":"oa","type":"rem","url":"https://arxiv.org/pdf/2304.00266.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.48550/arXiv.2304.00266","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Human-Computer Interaction and Design, Procedural eXpression Lab"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Imke","key":"grabepau","last":"Grabe","locid":"7c852728-c562-4df0-84c1-4488dde7c360","name":"Grabe, Imke","orcid":"0000-0002-5122-6769","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jichen","key":"zhupau","last":"Zhu","locid":"e383647f-00d3-41b1-ad95-ff69bdfffb42","name":"Zhu, Jichen","orcid":"0000-0001-6740-4550","rank":2,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-d7fc0a48-cc54-4ed6-acee-ae5ce9109db3"],"src":["ITU IT University of Copenhagen"],"title":"Hidden Layer Interaction: A Co-Creative Design Fiction for Generative Models","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-718923","year":"2023","yearsub":"2023"}
{"abstract":"Abstract Human-Center eXplainable AI (HCXAI) literature identifies the need to address user needs. This paper examines how existing XAI research involves human users in designing and developing XAI systems and identifies limitations in current practices, especially regarding how researchers identify user requirements. Finally, we propose several suggestions on how to derive better user requirements.","author_count":2,"contributors":["Nguyen, Iris","Zhu, Jichen"],"cuid":["S01-000.00-718820"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Explainable AI XAI","Human Centered AI","Human Computer Interaction HCI","User Centered Design","User requirements"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"towards better user requirements how to involve human participants in xai research","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/92624560/2212.03186.pdf","version":"Other Version"},"id":"S01-000.00-718820","ids":["itu-015d3cb2-7af0-471e-b174-c482c0207347"],"keyword":["Explainable AI (XAI)","Human-Centered AI","Human-Computer Interaction (HCI)","User Requirements","User-Centered Design"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-7646C94899DF1D410E05FEE84539EB1B"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/92624560/2212.03186.pdf","version":"Other Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Human-Computer Interaction and Design, Procedural eXpression Lab"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Iris","key":"nguyenpau","last":"Nguyen","name":"Nguyen, Iris","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jichen","key":"zhupau","last":"Zhu","locid":"e383647f-00d3-41b1-ad95-ff69bdfffb42","name":"Zhu, Jichen","orcid":"0000-0001-6740-4550","rank":2,"rolecode":"pau"}],"pub":{"status":"p","title":"Proceeding of the Human Centered AI workshop at NeurIPS 2022"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-015d3cb2-7af0-471e-b174-c482c0207347"],"src":["ITU IT University of Copenhagen"],"title":"Towards Better User Requirements: How to Involve Human Participants in XAI Research","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-718820","year":"2022","yearsub":"2022"}
{"abstract":"Abstract. Player-facing, retrospective gameplay visualizations help players track progress and learn from others. Visualizations of a user’s step by step process, may be able to advance retrospective visualization. However, we currently do not know how players make meaning from process visualizations of game data. In this work, we take a first step towards addressing this gap by examining how players make meaning from process visualizations of other players’ gameplay. We identify two interpretation methods comprised of six techniques and discuss what these results mean for future use of player-facing process visualizations.","author_count":7,"contributors":["Kleinman, Erica","Villareale, Jennifer","Shergadwala, M","Teng, z","Bryant, A","Zhu, Jichen","Seif El-Nasr, M"],"cuid":["S01-000.00-383515"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Drexel University","University of California"],"keyword":["Gameplay interpretation methods","Player facing visualizations","Process visualizations","Progress tracking","Retrospective gameplay"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"towards an understanding of how players make meaning from post play process visualizations","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/92565388/Towards_an_Understanding_of_How_Players_Make_Meaning_from_Post_Play_Process_Visualizations.pdf","version":"Other Version"},"id":"S01-000.00-383515","identifier":[{"id":"85142747902","type":"scopus"}],"ids":["itu-9979c49b-1a86-48e5-a2dd-fa06227b9b6e"],"keyword":["Gameplay interpretation methods","Player-facing visualizations","Process visualizations","Progress tracking","Retrospective gameplay"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-B64AA44C6F616A55AAB54CB9710AE56F"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/92565388/Towards_an_Understanding_of_How_Players_Make_Meaning_from_Post_Play_Process_Visualizations.pdf","version":"Other Version"}],"org":[{"affno":"1","country":"us","key":"university of california","loc":["United States","America, North","OECD"],"name":"University of California","used":1},{"affno":"2","country":"us","key":"drexel university","loc":["United States","America, North","OECD"],"name":"Drexel University","used":1},{"affno":"3","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Digital Design, Design Research Section","IT University of Copenhagen, Human-Computer Interaction and Design, Procedural eXpression Lab"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Erica","key":"kleinmanpau","last":"Kleinman","name":"Kleinman, Erica","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jennifer","key":"villarealepau","last":"Villareale","name":"Villareale, Jennifer","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"M","key":"shergadwalapau","last":"Shergadwala","name":"Shergadwala, M","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"z","key":"tengpau","last":"Teng","name":"Teng, z","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"A","key":"bryantpau","last":"Bryant","name":"Bryant, A","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jichen","key":"zhupau","last":"Zhu","locid":"e383647f-00d3-41b1-ad95-ff69bdfffb42","name":"Zhu, Jichen","orcid":"0000-0001-6740-4550","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"M","key":"seifelnasrpau","last":"Seif El-Nasr","name":"Seif El-Nasr, M","rank":7,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-031-20212-4_4","pages":"47-58","publisher":"Springer","status":"p","title":"Proceedings of the International Conference on Entertainment Computing"},"review":"Peer Reviewed","scoID":["2-s2.0-85142747902"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-9979c49b-1a86-48e5-a2dd-fa06227b9b6e"],"src":["ITU IT University of Copenhagen"],"title":"Towards an Understanding of How Players Make Meaning from Post-Play Process Visualizations","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383515","year":"2022","yearsub":"2022"}
{"author_count":4,"contributors":["Grabe, Imke","Duque, Miguel Gonzalez","Risi, Sebastian","Zhu, Jichen"],"cuid":["S01-000.00-383855"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"towards a framework for human ai interaction patterns in co creative gan applications","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://ceur-ws.org/Vol-3124/paper9.pdf","version":"Published Version"},"id":"S01-000.00-383855","ids":["itu-b14bfa2e-0264-4e42-b1de-f003f53a913b"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-9839D2B3468525DEC23E3D639F7B7B61"],"oa_link":[{"access":"oa","type":"rem","url":"http://ceur-ws.org/Vol-3124/paper9.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Human-Computer Interaction and Design, Procedural eXpression Lab"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Imke","key":"grabepau","last":"Grabe","locid":"7c852728-c562-4df0-84c1-4488dde7c360","name":"Grabe, Imke","orcid":"0000-0002-5122-6769","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Miguel Gonzalez","key":"duquepau","last":"Duque","name":"Duque, Miguel Gonzalez","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sebastian","key":"risipau","last":"Risi","locid":"a420ffb3-2ca6-4925-a25f-baaa5228fc15","name":"Risi, Sebastian","orcid":"0000-0003-3607-8400","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jichen","key":"zhupau","last":"Zhu","locid":"e383647f-00d3-41b1-ad95-ff69bdfffb42","name":"Zhu, Jichen","orcid":"0000-0001-6740-4550","rank":4,"rolecode":"pau"}],"pub":{"status":"p","title":"Joint Proceedings of the ACM IUI Workshops 2022, March 2022, Helsinki, Finland"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-b14bfa2e-0264-4e42-b1de-f003f53a913b"],"src":["ITU IT University of Copenhagen"],"title":"Towards a Framework for Human-AI Interaction Patterns in Co-Creative GAN Applications","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383855","year":"2022","yearsub":"2022"}
{"abstract":"Abstract Understanding players' mental models are crucial for game designers who wish to successfully integrate player-AI interactions into their game. However, game designers face the difficult challenge of anticipating how players model these AI agents during gameplay and how they may change their mental models with experience. In this work, we conduct a qualitative study to examine how a pair of players develop mental models of an adversarial AI player during gameplay in the multiplayer drawing game iNNk. We conducted ten gameplay sessions in which two players (n = 20, 10 pairs) worked together to defeat an AI player. As a result of our analysis, we uncovered two dominant dimensions that describe players' mental model development (i.e., focus and style). The first dimension describes the focus of development which refers to what players pay attention to for the development of their mental model (i.e., top-down vs. bottom-up focus). The second dimension describes the differences in the style of development, which refers to how players integrate new information into their mental model (i.e., systematic vs. reactive style). In our preliminary framework, we further note how players process a change when a discrepancy occurs, which we observed occur through comparisons (i.e., compare to other systems, compare to gameplay, compare to self). We offer these results as a preliminary framework for player mental model development to help game designers anticipate how different players may model adversarial AI players during gameplay.","author_count":3,"contributors":["Villareale, Jennifer","Harteveld, Casper","Zhu, Jichen"],"cuid":["S01-000.00-384690"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Drexel University","Northeastern University"],"keyword":["Adversarial AI","Game design","Multiplayer games","Player mental models","Qualitative study"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"i want to see how smart this ai really is player mental model development of an adversarial ai player","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/92621777/iNNk_mentalModels_CHIPlay22_2_.pdf","version":"Pre-print"},"id":"S01-000.00-384690","identifier":[{"id":"85144754476","type":"scopus"}],"ids":["itu-e819e102-2f1e-4cfa-9009-49e690a43e4c"],"keyword":["Adversarial AI","Game design","Multiplayer games","Player mental models","Qualitative study"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-AECC49457391D3F388D1D31F6923A6F0"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/92621777/iNNk_mentalModels_CHIPlay22_2_.pdf","version":"Pre-print"}],"org":[{"affno":"1","country":"us","key":"drexel university","loc":["United States","America, North","OECD"],"name":"Drexel University","used":1},{"affno":"2","country":"us","key":"northeastern university","loc":["United States","America, North","OECD"],"name":"Northeastern University","used":1},{"affno":"3","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Digital Design, Design Research Section","IT University of Copenhagen, Human-Computer Interaction and Design, Procedural eXpression Lab"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jennifer","key":"villarealepau","last":"Villareale","name":"Villareale, Jennifer","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Casper","key":"harteveldpau","last":"Harteveld","name":"Harteveld, Casper","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jichen","key":"zhupau","last":"Zhu","locid":"e383647f-00d3-41b1-ad95-ff69bdfffb42","name":"Zhu, Jichen","orcid":"0000-0001-6740-4550","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1145/3549482","issn":["25730142"],"issue":"CHI PLAY","journal":"Proceedings of the ACM on Human-Computer Interaction","pages":"1-26","paperid":"219","status":"p","title":"Proceedings of the ACM on Human-Computer Interaction","volume":"6"},"review":"Peer Reviewed","scoID":["2-s2.0-85144754476"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-e819e102-2f1e-4cfa-9009-49e690a43e4c"],"src":["ITU IT University of Copenhagen"],"title":"\" I Want To See How Smart This AI Really Is\": Player Mental Model Development of an Adversarial AI Player","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384690","year":"2022","yearsub":"2022"}
{"abstract":"This paper presents a novel approach for guiding a Generative Adversarial Network trained on the FashionGen dataset to generate designs corresponding to target fashion styles. Finding the latent vectors in the generator’s latent space that correspond to a style is approached as an evolutionary search problem. A Gaussian mixture model is applied to identify fashion styles based on the higher-layer representations of outfits in a clothing-specific attribute prediction model. Over generations, a genetic algorithm optimizes a population of designs to increase their probability of belonging to one of the Gaussian mixture components or styles. Showing that the developed system can generate images of maximum fitness visually resembling certain styles, our approach provides a promising direction to guide the search for style-coherent designs.","author_count":3,"contributors":["Grabe, Imke","Zhu, Jichen","Aguirrezabal Zabaleta, Manex"],"cuid":["S01-000.00-457320"],"filters":{"added":"2022-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"fashion style generation evolutionary search with gaussian mixture models in the latent space","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://link.springer.com/chapter/10.1007/978-3-031-03789-4_6","version":"Other Version"},"id":"S01-000.00-457320","identifier":[{"id":"85128884529","type":"scopus"}],"ids":["ku-6af97336-7440-4685-b2c5-7cdfaf9b7597"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-159B32D879DB05543E90915898839646"],"org":[{"affno":"1","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Humanities, Department of Nordic Studies and Linguistics"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Imke","key":"grabepau","last":"Grabe","name":"Grabe, Imke","rank":1,"rolecode":"pau"},{"affno":"1","first":"Jichen","key":"zhupau","last":"Zhu","name":"Zhu, Jichen","rank":2,"rolecode":"pau"},{"affno":"2","first":"Manex","key":"aguirrezabalzabaletapau","last":"Aguirrezabal Zabaleta","locid":"5506d065-a31f-447b-b859-cc101b4c91e0","name":"Aguirrezabal Zabaleta, Manex","orcid":"0000-0001-5909-2745","rank":3,"rolecode":"pau"}],"pub":{"pages":"84-100","place":"Springer, Cham","status":"p","title":"International Conference on Computational Intelligence in Music, Sound, Art and Design (Part of EvoStar)"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-6af97336-7440-4685-b2c5-7cdfaf9b7597"],"src":["KU University of Copenhagen"],"title":"Fashion Style Generation: Evolutionary Search with Gaussian Mixture Models in the Latent Space","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-457320","year":"2022","yearsub":"2022"}
{"abstract":"Abstract With the rise of Generative Adversarial Networks (GANs), AI has increasingly become a partner to human designers in co-creating cultural artifacts. While generative models have been applied in various creative tasks across disciplines, a theoretical foundation for understanding human-GAN collaboration is yet to be developed. Drawing from the mixed-initiative co-creation community, we propose a preliminary framework to analyze co-creative GAN applications. We identify four primary interaction patterns: Curating, Exploring, Evolving, and Conditioning. The suggested framework enables us to discuss the affordances and limitations of the different kind of interactions underlying co-creative GAN applications","author_count":3,"contributors":["Grabe, Imke","Duque, Miguel Gonzalez","Zhu, Jichen"],"cuid":["S01-000.00-381802"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Co creation","Generative Adversarial Networks","Human AI collaboration","Interaction Patterns","Mixed Initiative Interaction"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"towards a framework for human ai interaction patterns in co creative gan applications","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/92624955/paper9.pdf","version":"Published Version"},"id":"S01-000.00-381802","ids":["itu-23afff6a-a7a7-4ad4-b52a-f2fb9b042d52"],"keyword":["Co-creation","Generative Adversarial Networks","Human-AI Collaboration","Interaction Patterns","Mixed-Initiative Interaction"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-92BC2BC94FC5B61B061CCF790BF7AFCF"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/92624955/paper9.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Human-Computer Interaction and Design, Procedural eXpression Lab"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Imke","key":"grabepau","last":"Grabe","locid":"7c852728-c562-4df0-84c1-4488dde7c360","name":"Grabe, Imke","orcid":"0000-0002-5122-6769","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Miguel Gonzalez","key":"duquepau","last":"Duque","name":"Duque, Miguel Gonzalez","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jichen","key":"zhupau","last":"Zhu","locid":"e383647f-00d3-41b1-ad95-ff69bdfffb42","name":"Zhu, Jichen","orcid":"0000-0001-6740-4550","rank":3,"rolecode":"pau"}],"pub":{"status":"p","title":"Proceeding of the 3rd Workshop on Human-AI Co-Creation with Generative Models (HAI-GEN ‘22)at ACM IUI Workshops"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-23afff6a-a7a7-4ad4-b52a-f2fb9b042d52"],"src":["ITU IT University of Copenhagen"],"title":"Towards a Framework for Human-AI Interaction Patterns in Co-Creative GAN Applications","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381802","year":"2022","yearsub":"2022"}
{"abstract":"Abstract This paper presents a novel approach for guiding a Generative Adversarial Network trained on the FashionGen dataset to generate designs corresponding to target fashion styles. Finding the latent vectors in the generator’s latent space that correspond to a style is approached as an evolutionary search problem. A Gaussian mixture model is applied to identify fashion styles based on the higher-layer representations of outfits in a clothing-specific attribute prediction model. Over generations, a genetic algorithm optimizes a population of designs to increase their probability of belonging to one of the Gaussian mixture components or styles. Showing that the developed system can generate images of maximum fitness visually resembling certain styles, our approach provides a promising direction to guide the search for style-coherent designs.","author_count":3,"contributors":["Grabe, Imke","Zhu, Jichen","Agirrezabal, Manex"],"cuid":["S01-000.00-384379"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Evolutionary algorithms","FashionGen Dataset","Gaussian mixture model","Generative Adversarial Networks","Style coherent Design"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"fashion style generation evolutionary search with gaussian mixture models in the latent space","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/92740364/2204.00592.pdf","version":"Pre-print"},"id":"S01-000.00-384379","identifier":[{"id":"85128884529","type":"scopus"}],"ids":["itu-d3b16731-9963-4ef3-a4a7-7ae43bbb8183"],"keyword":["Evolutionary Algorithms","FashionGen Dataset","Gaussian Mixture Model","Generative Adversarial Networks","Style-coherent Design"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-6210A3D42E82DE45D6C967B7D765CB1E"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/92740364/2204.00592.pdf","version":"Pre-print"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Human-Computer Interaction and Design, Procedural eXpression Lab"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Imke","key":"grabepau","last":"Grabe","locid":"7c852728-c562-4df0-84c1-4488dde7c360","name":"Grabe, Imke","orcid":"0000-0002-5122-6769","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jichen","key":"zhupau","last":"Zhu","locid":"e383647f-00d3-41b1-ad95-ff69bdfffb42","name":"Zhu, Jichen","orcid":"0000-0001-6740-4550","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Manex","key":"agirrezabalpau","last":"Agirrezabal","name":"Agirrezabal, Manex","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-031-03789-4_6","status":"p","title":"Artificial Intelligence in Music, Sound, Art and Design. EvoMUSART 2022. Lecture Notes in Computer Science, vol 13221. Springer, Cham. https://doi.org/10.1007/978-3-031-03789-4_6"},"review":"Peer Reviewed","scoID":["2-s2.0-85128884529"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["itu-d3b16731-9963-4ef3-a4a7-7ae43bbb8183"],"src":["ITU IT University of Copenhagen"],"title":"Fashion Style Generation: Evolutionary Search with Gaussian Mixture Models in the Latent Space","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384379","year":"2022","yearsub":"2022"}
{"abstract":"Abstract Educational technology is shifting toward facilitating personalized learning. Such personalization, however, requires a detailed understanding of students’ problem-solving processes. Sequence analysis (SA) is a promising approach to gaining granular insights into student problem solving; however, existing techniques are difficult to interpret because they offer little room for human input in the analysis process. Ultimately, in a learning context, a human stakeholder makes the decisions, so they should be able to drive the analysis process. In this paper, we present a human-in-the-loop approach to SA that uses visualization to allow a stakeholder to better understand both the data and the algorithm. We illustrate the method with a case study in the context of a learning game called Parallel. Results reveal six groups of students organized based on their problem-solving patterns and highlight individual differences within each group. We compare the results to a state-of-the-art method run with the same data and discuss the benefits of our method and the implications of this work.","author_count":6,"contributors":["Kleinman, Erica","Shergadwala, M","Villareale, J","Bryant, A","Zhu, Jichen","Seif El-Nasr, M"],"cuid":["S01-000.00-384711"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Drexel University","University of California"],"keyword":["Game based learning","Learning analytics","Mixed methods","Sequence analysis","Visualization","human in the loop methods"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"analyzing students problem solving sequences a human in the loop approach","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.18608/jla.2022.7465","version":"Published Version"},"id":"S01-000.00-384711","identifier":[{"id":"85137454664","type":"scopus"}],"ids":["itu-e9a28161-7ee8-4000-91ff-821497a6063b"],"keyword":["Learning analytics","game-based learning","human-in-the-loop methods","mixed methods","sequence analysis","visualization"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-432E600F5B06BDC865BBCA6C2FC3C2DF"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.18608/jla.2022.7465","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://pure.itu.dk/ws/files/92517023/7465_Article_Text_37375_1_10_20220831.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"us","key":"university of california","loc":["United States","America, North","OECD"],"name":"University of California","used":1},{"affno":"2","country":"us","key":"drexel university","loc":["United States","America, North","OECD"],"name":"Drexel University","used":1},{"affno":"3","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Digital Design, Design Research Section","IT University of Copenhagen, Human-Computer Interaction and Design, Procedural eXpression Lab"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Erica","key":"kleinmanpau","last":"Kleinman","name":"Kleinman, Erica","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"M","key":"shergadwalapau","last":"Shergadwala","name":"Shergadwala, M","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"J","key":"villarealepau","last":"Villareale","name":"Villareale, J","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"A","key":"bryantpau","last":"Bryant","name":"Bryant, A","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jichen","key":"zhupau","last":"Zhu","locid":"e383647f-00d3-41b1-ad95-ff69bdfffb42","name":"Zhu, Jichen","orcid":"0000-0001-6740-4550","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"M","key":"seifelnasrpau","last":"Seif El-Nasr","name":"Seif El-Nasr, M","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.18608/jla.2022.7465","issn":["19297750"],"journal":"Journal of Learning Analytics","pages":"138-160","status":"p","title":"Journal of Learning Analytics","title_org":"Journal of learning analytics"},"review":"Peer Reviewed","scoID":["2-s2.0-85137454664"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-e9a28161-7ee8-4000-91ff-821497a6063b"],"src":["ITU IT University of Copenhagen"],"title":"Analyzing Students’ Problem-Solving Sequences: A Human-in-the-Loop Approach","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384711","year":"2022","yearsub":"2022"}
{"abstract":"A long lineage of computer-assisted design tools has established interaction paradigms that give full control to the designer over the software. Introduction of Artificial Intelligence (AI) to this creative process leads to a more co-creative paradigm, with AI taking a more proactive role. Recent generative approaches based on deep learning have strong potential as an asset creator and co-creator, however current algorithms are opaque and burden the designer with making sense of the output. In order for deep learning to become a colleague that designers can trust and work with, better explainability, controllability, and interactivity is necessary. We highlight current and potential ways in which explainability can inform human users in creative tasks and call for involving end-users in the development of both interfaces and underlying algorithms.","author_count":2,"contributors":["Liapis, Antonios","Zhu, Jichen"],"cuid":["S01-000.00-718903"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU"],"country":["Malta"],"glorg":["All Global Affiliations","University of Malta"],"keyword":["Artificial intelligence","Co Creativity","Computer Assisted Design","Deep learning","Explainability"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"the need for explainability in ai based creativity support tools","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/92624740/NeurIPS_HCI_proposal_explainability.pdf","version":"Other Version"},"id":"S01-000.00-718903","ids":["itu-ab57a4ac-ce75-408a-8f49-b51792311589"],"keyword":["- Artificial Intelligence","- Co-Creativity","- Computer-Assisted Design","- Deep Learning","- Explainability"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-6E7EF446671CE8450B7EB953E265525B"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/92624740/NeurIPS_HCI_proposal_explainability.pdf","version":"Other Version"}],"org":[{"affno":"1","country":"mt","key":"university of malta","loc":["Malta","Europe, EU"],"name":"University of Malta","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Digital Design, Design Research Section","IT University of Copenhagen, Human-Computer Interaction and Design, Procedural eXpression Lab"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Antonios","key":"liapispau","last":"Liapis","name":"Liapis, Antonios","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jichen","key":"zhupau","last":"Zhu","locid":"e383647f-00d3-41b1-ad95-ff69bdfffb42","name":"Zhu, Jichen","orcid":"0000-0001-6740-4550","rank":2,"rolecode":"pau"}],"pub":{"status":"p","title":"Proceedings of the Human Centered AI workshop at NeurIPS 2022"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-ab57a4ac-ce75-408a-8f49-b51792311589"],"src":["ITU IT University of Copenhagen"],"title":"The Need for Explainability in AI-Based Creativity Support Tools","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-718903","year":"2022","yearsub":"2022"}
{"abstract":"Data is becoming an important central point for making de- sign decisions for most software. Game development is not an exception. As data-driven methods and systems start to pop- ulate these environments, a good question is: can we make models developed from this data transparent to users? In this paper, we synthesize existing work from the Intelligent User Interface and Learning Science research communities, where they started to investigate the potential of making such data and models available to users. We then present a new area ex- ploring this question, which we call Open Player Modeling, as an emerging research area. We deﬁne the design space of Open Player Models and present exciting open problems that the games research community can explore. We conclude the paper with a case study and discuss the potential value of this approach.","author_count":2,"contributors":["Zhu, Jichen","El-Nasr, Magy Seif"],"cuid":["S01-000.00-383037"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","University of California"],"keyword":["Data driven design","Game Development","Intelligent User Interfaces","Learning Sciences","Open Player Modeling"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"open player modeling empowering players through data transparency","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86441613/2110.05810.pdf","version":"Other Version"},"id":"S01-000.00-383037","ids":["itu-77c84ddf-b977-46ff-8d18-feed25611f19"],"keyword":["Data-Driven Design","Game Development","Intelligent User Interfaces","Learning Sciences","Open Player Modeling"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-1A737A8F1E33B9B0C66E9AE4D13D1ECB"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86441613/2110.05810.pdf","version":"Other Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Human-Computer Interaction and Design, Procedural eXpression Lab"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"us","key":"university of california","loc":["United States","America, North","OECD"],"name":"University of California","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jichen","key":"zhupau","last":"Zhu","locid":"e383647f-00d3-41b1-ad95-ff69bdfffb42","name":"Zhu, Jichen","orcid":"0000-0001-6740-4550","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Magy Seif","key":"elnasrpau","last":"El-Nasr","name":"El-Nasr, Magy Seif","rank":2,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-77c84ddf-b977-46ff-8d18-feed25611f19"],"src":["ITU IT University of Copenhagen"],"title":"Open Player Modeling: Empowering Players through Data Transparency","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383037","year":"2021","yearsub":"2021"}
{"abstract":"Designing human-centered AI-driven applications require deep understandings of how people develop mental models of AI. Currently, we have little knowledge of this process and limited tools to study it. This paper presents the position that AI-based games, particularly the player-AI interaction component, offer an ideal domain to study the process in which mental models evolve. We present a case study to illustrate the beneﬁts of our approach for explainable AI.","author_count":2,"contributors":["Zhu, Jichen","Villareale, Jennifer"],"cuid":["S01-000.00-384559"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Drexel University"],"keyword":["AI driven applications","Explainable AI","Human Centered AI","Mental models","Player AI interaction"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"understanding mental models of ai through player ai interaction","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.48550/arXiv.2103.16168","version":"Published Version"},"id":"S01-000.00-384559","ids":["itu-dfc8cbf4-0005-4e3f-a3e6-3f84f072fda7"],"keyword":["AI-driven applications","Explainable AI","Human-centered AI","Mental models","Player-AI interaction"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-B2A35024AA70A0C58551B824C011C3F5"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.48550/arXiv.2103.16168","version":"Published Version"},{"access":"oa","type":"rem","url":"https://www.researchgate.net/publication/350512179_Understanding_Mental_Models_of_AI_through_Player-AI_Interaction/fulltext/6063ea95a6fdccbfea1a5c4f/Understanding-Mental-Models-of-AI-through-Player-AI-Interaction.pdf?_tp=eyJjb250ZXh0Ijp7ImZpcnN0UGFnZSI6InB1YmxpY2F0aW9uIiwicGFnZSI6InB1YmxpY2F0aW9uIn19","version":"Published Version"},{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86441488/2103.16168_3_.pdf","version":"Other Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Human-Computer Interaction and Design, Procedural eXpression Lab"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"us","key":"drexel university","loc":["United States","America, North","OECD"],"name":"Drexel University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jichen","key":"zhupau","last":"Zhu","locid":"e383647f-00d3-41b1-ad95-ff69bdfffb42","name":"Zhu, Jichen","orcid":"0000-0001-6740-4550","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jennifer","key":"villarealepau","last":"Villareale","name":"Villareale, Jennifer","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.48550/arxiv.2103.16168","status":"p","title":"Extended Abstracts of the 2021 CHI Conference on Human Factors in Computing Systems (CHI EA '21)"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-dfc8cbf4-0005-4e3f-a3e6-3f84f072fda7"],"src":["ITU IT University of Copenhagen"],"title":"Understanding Mental Models of AI through Player-AI Interaction","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384559","year":"2021","yearsub":"2021"}
{"abstract":"One reason for limited efficacy of treatments for binge eating disorder (BED) and bulimia nervosa (BN) is a failure to directly target deficits in inhibitory control (i.e., the ability to withhold a pre-potent response). Inhibitory control trainings (ICTs; computerized tasks meant to improve inhibitory control) have shown promise but appear not to be powerful enough to generalize to real-word eating behavior or engaging enough for to sustain long-term compliance. Delivering an ICT through virtual reality (VR) technology should increase intervention power because 3D imagery and actual real hand/arm movements are lifelike and may improve compliance because the VR environment is highly engaging. Thus, we created the first-ever VR-based ICT to test its initial feasibility, acceptability, and impact on binge eating. We recruited participants (N = 14) with once-weekly loss-of-control (LOC) eating to use the VR ICT daily, at home, for two weeks, and measured feasibility, acceptability and change in LOC eating at postintervention and 2-week follow-up. The VR ICT was feasible to construct and deploy, and demonstrated high acceptability and compliance (i. e., 86.8% of daily trainings completed). Users of the VR ICT experienced large decreases in LOC eating at postintervention and 2-week follow-up. Results from this initial pilot indicate that delivering ICT through VR is feasible, acceptable, and is associated with reductions in binge eating. Future study is warranted and should examine whether a VR ICT can serve as a useful adjunct to standard treatment for BN and BED.","author_count":5,"contributors":["Manasse, S.M.","Lampe, E.W.","Juarascio, A.S.","Zhu, Jichen","Forman, E.M."],"cuid":["S01-000.00-384570"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Drexel University"],"keyword":["Binge eating","Brain training","Go no go","Inhibitory control","Virtual reality"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"using virtual reality to train inhibitory control and reduce binge eating a proof of concept study","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.appet.2020.104988","version":"Published Version"},"id":"S01-000.00-384570","identifier":[{"id":"85092517372","type":"scopus"}],"ids":["itu-e0a579ea-81c7-4f27-8784-2a862056a094"],"keyword":["Binge eating","Brain training","Go/no-go","Inhibitory control","Virtual reality"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-A0887FCDFC908CB9927F3A1A8BC56566"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.appet.2020.104988","version":"Published Version"},{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86438662/1_s2.0_S019566632031610X_main.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"us","key":"drexel university","loc":["United States","America, North","OECD"],"name":"Drexel University","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Human-Computer Interaction and Design, Procedural eXpression Lab"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"S.M.","key":"manassepau","last":"Manasse","name":"Manasse, S.M.","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"E.W.","key":"lampepau","last":"Lampe","name":"Lampe, E.W.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"A.S.","key":"juarasciopau","last":"Juarascio","name":"Juarascio, A.S.","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jichen","key":"zhupau","last":"Zhu","locid":"e383647f-00d3-41b1-ad95-ff69bdfffb42","name":"Zhu, Jichen","orcid":"0000-0001-6740-4550","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"E.M.","key":"formanpau","last":"Forman","name":"Forman, E.M.","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.appet.2020.104988","issn":["01956663","10958304"],"issn_org":["01956663"],"journal":"Appetite","publisher":"Elsevier","status":"p","title":"Appetite"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-e0a579ea-81c7-4f27-8784-2a862056a094"],"src":["ITU IT University of Copenhagen"],"title":"Using virtual reality to train inhibitory control and reduce binge eating : A proof-of-concept study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384570","year":"2021","yearsub":"2021"}
{"abstract":"Personalized adaptation technology has been adopted in a wide range of digital applications such as health, training and education, e-commerce and entertainment. Personalization systems typically build a user model, aiming to characterize the user at hand, and then use this model to personalize the interaction. Personalization and user modeling, however, are often intrinsically at odds with each other (a fact some times referred to as the personalization paradox). In this paper, we take a closer look at this personalization paradox, and identify two ways in which it might manifest: feedback loops and moving targets. To illustrate these issues, we report results in the domain of personalized exergames (videogames for physical exercise), and describe our early steps to address some of the issues arisen by the personalization paradox.","author_count":2,"contributors":["Ontañón, Santiago","Zhu, Jichen"],"cuid":["S01-000.00-384837"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Drexel University"],"keyword":["Feedback loops","Moving Targets","Personalization Paradox","Personalization Technology","User modeling"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"the personalization paradox the conflict between accurate user models and personalized adaptive systems","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86438731/2103.01771.pdf","version":"Other Version"},"id":"S01-000.00-384837","identifier":[{"id":"85104428564","type":"scopus"}],"ids":["itu-f2b1f072-d197-4c88-9948-d2c649be65b7"],"keyword":["Feedback Loops","Moving Targets","Personalization Paradox","Personalization Technology","User Modeling"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-FED7E9EB4C4F15CA4DF6B2E4CBB4C2B2"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86438731/2103.01771.pdf","version":"Other Version"}],"org":[{"affno":"1","country":"us","key":"drexel university","loc":["United States","America, North","OECD"],"name":"Drexel University","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Human-Computer Interaction and Design, Procedural eXpression Lab"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Santiago","key":"ontañónpau","last":"Ontañón","name":"Ontañón, Santiago","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jichen","key":"zhupau","last":"Zhu","locid":"e383647f-00d3-41b1-ad95-ff69bdfffb42","name":"Zhu, Jichen","orcid":"0000-0001-6740-4550","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1145/3397482.3450734","pages":"64-66","publisher":"Association for Computing Machinery","status":"p","title":"IUI '21 Companion: 26th International Conference on Intelligent User Interfaces"},"review":"Peer Reviewed","scoID":["2-s2.0-85104428564"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-f2b1f072-d197-4c88-9948-d2c649be65b7"],"src":["ITU IT University of Copenhagen"],"title":"The Personalization Paradox: the Conflict between Accurate User Models and Personalized Adaptive Systems","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384837","year":"2021","yearsub":"2021"}
{"abstract":"Social comparison-based features are widely used in social computing apps. However, most existing apps are not grounded in social comparison theories and do not consider individual differences in social comparison preferences and reactions. This paper is among the first to automatically personalize social comparison targets. In the context of an m-health app for physical activity, we use artificial intelligence (AI) techniques of multi-armed bandits. Results from our user study (n=53) indicate that there is some evidence that motivation can be increased using the AI-based personalization of social comparison. The detected effects achieved small-to-moderate effect sizes, illustrating the real-world implications of the intervention for enhancing motivation and physical activity. In addition to design implications for social comparison features in social apps, this paper identified the personalization paradox, the conflict between user modeling and adaptation, as a key design challenge of personalized applications for behavior change. Additionally, we propose research directions to mitigate this Personalization Paradox.","author_count":7,"contributors":["Zhu, Jichen","Dallal, D.H.","Gray, R.C.","Villareale, J.","Ontañón, S.","Forman, E.M.","Arigo, D."],"cuid":["S01-000.00-383487"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Drexel University","Rowan University"],"keyword":["Artificial intelligence","Behavior change","M health","Personalization","Social comparison"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"personalization paradox in behavior change apps lessons from a social comparison based personalized app for physical activity","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86438694/2101.10020v1.pdf","version":"Other Version"},"id":"S01-000.00-383487","identifier":[{"id":"85129740861","type":"scopus"}],"ids":["itu-976d285d-9749-49c7-84cf-ac2ec0a4fb72"],"keyword":["Artificial intelligence","Behavior change","Personalization","Social comparison","m-health"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-BA6AB498F24A6CE5CDA4F9442FAEAC5F"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86438694/2101.10020v1.pdf","version":"Other Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Human-Computer Interaction and Design, Procedural eXpression Lab"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"us","key":"drexel university","loc":["United States","America, North","OECD"],"name":"Drexel University","used":1},{"affno":"3","country":"us","key":"rowan university","loc":["United States","America, North","OECD"],"name":"Rowan University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jichen","key":"zhupau","last":"Zhu","locid":"e383647f-00d3-41b1-ad95-ff69bdfffb42","name":"Zhu, Jichen","orcid":"0000-0001-6740-4550","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"D.H.","key":"dallalpau","last":"Dallal","name":"Dallal, D.H.","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"R.C.","key":"graypau","last":"Gray","name":"Gray, R.C.","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"J.","key":"villarealepau","last":"Villareale","name":"Villareale, J.","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"S.","key":"ontañónpau","last":"Ontañón","name":"Ontañón, S.","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"E.M.","key":"formanpau","last":"Forman","name":"Forman, E.M.","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"D.","key":"arigopau","last":"Arigo","name":"Arigo, D.","rank":7,"rolecode":"pau"}],"pub":{"doi":"10.1145/3449190","issn":["25730142"],"pages":"1-21","series":"Proceedings of the ACM on Human-Computer Interaction - CSCW","status":"p","title":"Proceedings of the ACM on Human-Computer Interaction - CSCW"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-976d285d-9749-49c7-84cf-ac2ec0a4fb72"],"src":["ITU IT University of Copenhagen"],"title":"Personalization Paradox in Behavior Change Apps : Lessons from a Social Comparison-Based Personalized App for Physical Activity","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383487","year":"2021","yearsub":"2021"}
{"abstract":"Voice User Interfaces (VUIs) pose challenges for users to learn the system’s supported features and commands. Users often rely on trial-and-error to navigate VUI dialogues and complete desired tasks. The order in which users try different commands contains vital information about how they learn. In this paper, we explore using sequence analysis techniques to reveal the patterns of tactics our participants (n = 50) used when interacting with an unfamiliar multi-modal VUI. We present the results of our sequence analysis, the top sequences used, and a cluster analysis of our participants on their usage of the top sequences. Our results indicate participants initially struggled with understanding the acceptable utterance structure and entities more so than utterance keywords. Additionally, we discuss our participants’ behavior differences and discuss the usefulness of this methodology of sequence analysis for HCI VUI research.","author_count":5,"contributors":["Myers, Chelsea M","Laris Pardo, Luis Fernando","Acosta-Ruiz, Ana","Canossa, Alessandro","Zhu, Jichen"],"cuid":["S02-096.67-012495"],"filters":{"added":"2023-01","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Drexel University"],"keyword":["Human Computer Interaction HCI","Multi Modal Interaction","Sequence analysis","User Learning Behavior","Voice User Interfaces VUIs"],"level":"sci","mra":["hum","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-ART","DI-U"],"level3":{"ART":["DI-ART-ALL","DI-ART-RDKA"],"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-ART-RDKA","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"try try try again sequence analysis of user interaction data with a voice user interface","src":["arkc","itu"],"src-code":["DI-ART-RDKA","DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86441513/3469595.3469613.pdf","version":"Other Version"},"id":"S02-096.67-012495","identifier":[{"id":"85112292082","type":"scopus"}],"ids":["arkc-f9af8f19-385d-4d14-aa62-cd14b1159a55","itu-dd3ac9fb-a984-42af-ae8d-ed0e047dd290"],"keyword":["Human-Computer Interaction (HCI)","Multi-Modal Interaction","No","Sequence Analysis","User Learning Behavior","Voice User Interfaces (VUIs)"],"lang":"English","level":"Scientific","mra":["Humanities","Science/Technology"],"noi":["Global-Local-2-5-8CF36073663D4A4DAF7D23834086D3B2"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86441513/3469595.3469613.pdf","version":"Other Version"}],"org":[{"affno":"1","country":"us","key":"drexel university","loc":["United States","America, North","OECD"],"name":"Drexel University","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1},{"affno":"3","key":"royal danish academy architecture design conservation","l2":"DI-ART","l2n":"Artistic Higher Education Institutions","l3":"DI-ART-RDKA","l3nn":"Royal Danish Academy - Architecture, Design, Conservation","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Royal Danish Academy - Architecture, Design, Conservation","namevar":["Royal Danish Academy - Architecture, Design, Conservation, Royal Danish Academy - Design, Institute of Design and Visual Interaction"],"nora_code":"DI-ART-RDKA","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Chelsea M","key":"myerspau","last":"Myers","name":"Myers, Chelsea M","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Luis Fernando","key":"larispardopau","last":"Laris Pardo","name":"Laris Pardo, Luis Fernando","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ana","key":"acostaruizpau","last":"Acosta-Ruiz","name":"Acosta-Ruiz, Ana","rank":3,"rolecode":"pau"},{"affno":"3 2","corresponding":null,"country":"dk","first":"Alessandro","key":"canossapau","last":"Canossa","locid":"c6a7fc8c-23f7-4849-9761-548366ef1782","name":"Canossa, Alessandro","orcid":"0000-0002-5852-9287","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jichen","key":"zhupau","last":"Zhu","locid":"e383647f-00d3-41b1-ad95-ff69bdfffb42","name":"Zhu, Jichen","orcid":"0000-0001-6740-4550","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1145/3469595.3469613","pages":"1-8","status":"p","subtitle":"3rd Conference on Conversational User Interfaces","title":"CUI 2021"},"review":"Peer Reviewed","scoID":["2-s2.0-85112292082"],"search":{"DAF":["All Artistic Higher Education Institutions","All Danish Affiliations","All Universities","Artistic Higher Education Institutions","DI-ALL","DI-ART","DI-ART-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["arkc-f9af8f19-385d-4d14-aa62-cd14b1159a55","itu-dd3ac9fb-a984-42af-ae8d-ed0e047dd290"],"src":["ITU IT University of Copenhagen","Royal Danish Academy - Architecture, Design, Conservation"],"title":"“Try, Try, Try Again:” Sequence Analysis of User Interaction Data with a Voice User Interface","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-096.67-012495","year":"2021","yearsub":"2021"}
{"abstract":"Applying neural network (NN) methods in games can lead to various new and exciting game dynamics not previously possible. However, they also lead to new challenges such as the lack of large, clean datasets, varying player skill levels, and changing gameplay strategies. In this paper, we focus on the adversarial player strategy aspect in the game iNNk, in which players try to communicate secret code words through drawings with the goal of not being deciphered by a NN. Some strategies exploit weaknesses in the NN that consistently trick it into making incorrect classifications, leading to unbalanced gameplay. We present a method that combines transfer learning and ensemble methods to obtain a data-efficient adaptation to these strategies. This combination significantly outperforms the baseline NN across all adversarial player strategies despite only being trained on a limited set of adversarial examples. We expect the methods developed in this paper to be useful for the rapidly growing field of NN-based games, which will require new approaches to deal with unforeseen player creativity.","author_count":6,"contributors":["Löwe, Mathias","Villareale, Jennifer","Freed, Evan","Sladek, Aleksanteri","Zhu, Jichen","Risi, Sebastian"],"cuid":["S01-000.00-384782"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Drexel University"],"keyword":["Adversarial Strategies","Ensemble Methods","Game Dynamics","Neural networks","Transfer learning"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"dealing with adversarial player strategies in the neural network game innk through ensemble learning","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-384782","ids":["itu-ee94392f-3fbf-417c-a7fc-21d45b1fd65f"],"keyword":["Adversarial Strategies","Ensemble Methods","Game Dynamics","Neural Networks","Transfer Learning"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-012B5D8A74E481D1DD7A22D9E421D2C6"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Data, Systems, and Robotics, Robotics, Evolution, and Art Lab","IT University of Copenhagen, Digital Design","IT University of Copenhagen, Play, Culture, and AI, Creative AI Lab"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"us","key":"drexel university","loc":["United States","America, North","OECD"],"name":"Drexel University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Mathias","key":"löwepau","last":"Löwe","name":"Löwe, Mathias","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jennifer","key":"villarealepau","last":"Villareale","name":"Villareale, Jennifer","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Evan","key":"freedpau","last":"Freed","name":"Freed, Evan","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Aleksanteri","key":"sladekpau","last":"Sladek","name":"Sladek, Aleksanteri","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jichen","key":"zhupau","last":"Zhu","locid":"e383647f-00d3-41b1-ad95-ff69bdfffb42","name":"Zhu, Jichen","orcid":"0000-0001-6740-4550","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sebastian","key":"risipau","last":"Risi","locid":"a420ffb3-2ca6-4925-a25f-baaa5228fc15","name":"Risi, Sebastian","orcid":"0000-0003-3607-8400","rank":6,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-ee94392f-3fbf-417c-a7fc-21d45b1fd65f"],"src":["ITU IT University of Copenhagen"],"title":"Dealing with Adversarial Player Strategies in the Neural Network Game iNNk through Ensemble Learning","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384782","year":"2021","yearsub":"2021"}
{"abstract":"This paper focuses on player modeling in multiplayer adaptive games. While player modeling has received a significant amount of attention, less is known about how to use player modeling in multiplayer games, especially when an experience management AI must make decisions on how to adapt the experience for the group as a whole. Specifically, we present a multi-armed bandit (MAB) approach for modeling groups of multiple players. Our main contributions are a new MAB framework for multiplayer modeling and techniques for addressing the new challenges introduced by the multiplayer context, extending previous work on MAB-based player modeling to account for new group-generated phenomena not present in single-user models. We evaluate our approach via simulation of virtual players in the context of multiplayer adaptive exergames.","author_count":3,"contributors":["Gray, Robert C","Zhu, Jichen","Ontañón, Santiago"],"cuid":["S01-000.00-382170"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Drexel University"],"keyword":["Adaptive Games","Experience Management AI","Multi Armed Bandit","Multiplayer games","Player Modeling"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"multiplayer modeling via multi armed bandits","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86441572/COG_2021.pdf","version":"Other Version"},"id":"S01-000.00-382170","identifier":[{"id":"85122935746","type":"scopus"}],"ids":["itu-3d0b8172-b483-4d63-b436-2a512822d4cd"],"keyword":["Adaptive Games","Experience Management AI","Multi-Armed Bandit","Multiplayer Games","Player Modeling"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-AAE9F93B9CFEBE046BF4E52256410274"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86441572/COG_2021.pdf","version":"Other Version"}],"org":[{"affno":"1","country":"us","key":"drexel university","loc":["United States","America, North","OECD"],"name":"Drexel University","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Human-Computer Interaction and Design, Procedural eXpression Lab"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Robert C","key":"graypau","last":"Gray","name":"Gray, Robert C","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jichen","key":"zhupau","last":"Zhu","locid":"e383647f-00d3-41b1-ad95-ff69bdfffb42","name":"Zhu, Jichen","orcid":"0000-0001-6740-4550","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Santiago","key":"ontañónpau","last":"Ontañón","name":"Ontañón, Santiago","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1109/cog52621.2021.9618892","pages":"01-08","status":"p","title":"2021 IEEE Conference on Games (CoG)"},"review":"Peer Reviewed","scoID":["2-s2.0-85122935746"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-3d0b8172-b483-4d63-b436-2a512822d4cd"],"src":["ITU IT University of Copenhagen"],"title":"Multiplayer Modeling via Multi-Armed Bandits","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382170","year":"2021","yearsub":"2021"}
{"abstract":"The advent of artificial intelligence (AI) and machine learning (ML) bring human-AI interaction to the forefront of HCI research. This paper argues that games are an ideal domain for studying and experimenting with how humans interact with AI. Through a systematic survey of neural network games (n = 38), we identified the dominant interaction metaphors and AI interaction patterns in these games. In addition, we applied existing human-AI interaction guidelines to further shed light on player-AI interaction in the context of AI-infused systems. Our core finding is that AI as play can expand current notions of human-AI interaction, which are predominantly productivity-based. In particular, our work suggests that game and UX designers should consider flow to structure the learning curve of human-AI interaction, incorporate discovery-based learning to play around with the AI and observe the consequences, and offer users an invitation to play to explore new forms of human-AI interaction.","author_count":7,"contributors":["Zhu, Jichen","Villareale, Jennifer","Javvaji, Nithesh","Risi, Sebastian","Löwe, Mathias","Weigelt, Rush","Harteveld, Casper"],"cuid":["S01-000.00-382816"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Drexel University","Northeastern University"],"keyword":["AI infused Systems","Discovery based Learning","Human AI interaction","Neural Network Games","Player AI interaction"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"player ai interaction what neural network games reveal about ai as play","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1145/3411764.3445307","version":"Published Version"},"id":"S01-000.00-382816","identifier":[{"id":"85104170761","type":"scopus"}],"ids":["itu-66eb1199-34f5-4f8b-8c30-153651c65ce9"],"keyword":["AI-infused Systems","Discovery-based Learning","Human-AI Interaction","Neural Network Games","Player-AI Interaction"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-33BD6D65CE757F25AD2EC979B950CEAA"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1145/3411764.3445307","version":"Published Version"},{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86438685/2101.06220v1.pdf","version":"Other Version"},{"access":"oa","type":"rem","url":"https://dl.acm.org/doi/pdf/10.1145/3411764.3445307","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Human-Computer Interaction and Design, Procedural eXpression Lab"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"us","key":"drexel university","loc":["United States","America, North","OECD"],"name":"Drexel University","used":1},{"affno":"3","country":"us","key":"northeastern university","loc":["United States","America, North","OECD"],"name":"Northeastern University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jichen","key":"zhupau","last":"Zhu","locid":"e383647f-00d3-41b1-ad95-ff69bdfffb42","name":"Zhu, Jichen","orcid":"0000-0001-6740-4550","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jennifer","key":"villarealepau","last":"Villareale","name":"Villareale, Jennifer","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Nithesh","key":"javvajipau","last":"Javvaji","name":"Javvaji, Nithesh","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sebastian","key":"risipau","last":"Risi","locid":"a420ffb3-2ca6-4925-a25f-baaa5228fc15","name":"Risi, Sebastian","orcid":"0000-0003-3607-8400","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mathias","key":"löwepau","last":"Löwe","name":"Löwe, Mathias","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Rush","key":"weigeltpau","last":"Weigelt","name":"Weigelt, Rush","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Casper","key":"harteveldpau","last":"Harteveld","name":"Harteveld, Casper","rank":7,"rolecode":"pau"}],"pub":{"doi":"10.1145/3411764.3445307","eisbn":["9781450380966"],"status":"p","title":"CHI '21: Proceedings of the 2021 CHI Conference on Human Factors in Computing Systems"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-66eb1199-34f5-4f8b-8c30-153651c65ce9"],"src":["ITU IT University of Copenhagen"],"title":"Player-AI Interaction: What Neural Network Games Reveal About AI as Play","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382816","year":"2021","yearsub":"2021"}
{"abstract":"This paper presents iNNK, a multiplayer drawing game where human players team up against an NN. The players need to successfully communicate a secret code word to each other through drawings, without being deciphered by the NN. With this game, we aim to foster a playful environment where players can, in a small way, go from passive consumers of NN applications to creative thinkers and critical challengers.","author_count":13,"contributors":["Villareale, Jennifer","Acosta-Ruiz, Ana V.","Arcaro, Samuel Adam","Fox, Thomas","Freed, Evan","Gray, Robert C.","Löwe, Mathias","Nuchprayoon, Panote","Sladek, Aleksanteri","Weigelt, Rush","Li, Yifu","Risi, Sebastian","Zhu, Jichen"],"cuid":["S01-000.00-384815"],"event":{"acronym":"CHI PLAY","title":"Annual Symposium on Computer-Human Interaction in Play"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Drexel University"],"keyword":["Creative engagement","Critical thinking","Human NN interaction","Multiplayer drawing game","Secret code communication"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"innk a multi player game to deceive a neural network","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85564216/2007.09177.pdf","version":"Authors Final Version"},"id":"S01-000.00-384815","identifier":[{"id":"85096807017","type":"scopus"}],"ids":["itu-f13603bb-3c75-469f-a923-83464e3a3c5e"],"keyword":["Creative engagement","Critical thinking","Human-NN interaction","Multiplayer drawing game","Secret code communication"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-372B6CCBBFEA60614C5CE62B966695A1"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85564216/2007.09177.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","country":"us","key":"drexel university","loc":["United States","America, North","OECD"],"name":"Drexel University","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Data, Systems, and Robotics, Robotics, Evolution, and Art Lab","IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jennifer","key":"villarealepau","last":"Villareale","name":"Villareale, Jennifer","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ana V.","key":"acostaruizpau","last":"Acosta-Ruiz","name":"Acosta-Ruiz, Ana V.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Samuel Adam","key":"arcaropau","last":"Arcaro","name":"Arcaro, Samuel Adam","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thomas","key":"foxpau","last":"Fox","name":"Fox, Thomas","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Evan","key":"freedpau","last":"Freed","name":"Freed, Evan","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Robert C.","key":"graypau","last":"Gray","name":"Gray, Robert C.","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mathias","key":"löwepau","last":"Löwe","name":"Löwe, Mathias","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Panote","key":"nuchprayoonpau","last":"Nuchprayoon","name":"Nuchprayoon, Panote","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Aleksanteri","key":"sladekpau","last":"Sladek","name":"Sladek, Aleksanteri","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rush","key":"weigeltpau","last":"Weigelt","name":"Weigelt, Rush","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yifu","key":"lipau","last":"Li","name":"Li, Yifu","rank":11,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Sebastian","key":"risipau","last":"Risi","locid":"a420ffb3-2ca6-4925-a25f-baaa5228fc15","name":"Risi, Sebastian","orcid":"0000-0003-3607-8400","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jichen","key":"zhupau","last":"Zhu","name":"Zhu, Jichen","rank":13,"rolecode":"pau"}],"pub":{"doi":"10.1145/3383668.3419858","eisbn":["9781450375870"],"pages":"33-37","status":"p","title":"CHI PLAY '20: Extended Abstracts of the 2020 Annual Symposium on Computer-Human Interaction in Play"},"review":"Peer Reviewed","scoID":["2-s2.0-85096807017"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-f13603bb-3c75-469f-a923-83464e3a3c5e"],"src":["ITU IT University of Copenhagen"],"title":"iNNk: A Multi-Player Game to Deceive a Neural Network","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384815","year":"2020","yearsub":"2020"}
{"abstract":"Growing interest in eXplainable Artificial Intelligence (XAI) aims to make AI and machine learning more understandable to human users. However, most existing work focuses on new algorithms, and not on usability, practical interpretability and efficacy on real users. In this vision paper, we propose a new research area of eXplainable AI for Designers (XAID), specifically for game designers. By focusing on a specific user group, their needs and tasks, we propose a human-centered approach for facilitating game designers to co-create with AI/ML techniques through XAID. We illustrate our initial XAID framework through three use cases, which require an understanding both of the innate properties of the AI techniques and users’ needs, and we identify key open challenges","author_count":5,"contributors":["Zhu, Jichen","Liapis, Antonios","Risi, Sebastian","Bidarra, Rafael","Youngblood, G Michael"],"cuid":["S01-000.00-381641"],"event":{"acronym":"CIG","title":"IEEE Conference on Computational Intelligence and Games"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","Europe, EU","OECD"],"country":["Netherlands","United States"],"glorg":["All Global Affiliations","Delft University of Technology","Drexel University","Palo Alto Research Center"],"keyword":["Co Creation with AI ML","Explainable artificial intelligence","Game Designers","Human centered design","Usability"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"explainable ai for designers a human centered perspective on mixed initiative co creation","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83703474/zhu_cig18.pdf","version":"Authors Final Version"},"id":"S01-000.00-381641","identifier":[{"id":"85054998782","type":"scopus"}],"ids":["itu-1905cb2c-0865-4aa7-898e-b11bd8f6ae3d"],"keyword":["Co-Creation with AI/ML","Game Designers","Human-Centered Design","Usability","eXplainable Artificial Intelligence"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-B15858D702D0CB4C5746A80F2F675322"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83703474/zhu_cig18.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","country":"us","key":"drexel university","loc":["United States","America, North","OECD"],"name":"Drexel University","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1},{"affno":"3","country":"nl","key":"delft university of technology","loc":["Netherlands","Europe, EU","OECD"],"name":"Delft University of Technology","used":1},{"affno":"4","country":"us","key":"palo alto research center","loc":["United States","America, North","OECD"],"name":"Palo Alto Research Center","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jichen","key":"zhupau","last":"Zhu","name":"Zhu, Jichen","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Antonios","key":"liapispau","last":"Liapis","name":"Liapis, Antonios","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Sebastian","key":"risipau","last":"Risi","locid":"a420ffb3-2ca6-4925-a25f-baaa5228fc15","name":"Risi, Sebastian","orcid":"0000-0003-3607-8400","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Rafael","key":"bidarrapau","last":"Bidarra","name":"Bidarra, Rafael","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":