"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jakob","key":"grinderslevpau","last":"Grinderslev","locid":"b53512aa-b477-434a-a629-1ff63f095eed","name":"Grinderslev, Jakob B.","name_org":"Grinderslev, Jakob","orcid":"0000-0001-7645-1383","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Torben René","key":"jensenpau","last":"Jensen","locid":"e0750478-df89-45bf-aa48-b6a86de93fa0","name":"Jensen, Torben René","orcid":"0000-0002-4278-3221","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Martin","key":"sahlbergpau","last":"Sahlberg","name":"Sahlberg, Martin","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Ulrich","key":"häussermannpau","last":"Häussermann","name":"Häussermann, Ulrich","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Maths","key":"karlssonpau","last":"Karlsson","name":"Karlsson, Maths","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Magnus","key":"nygårdpau","last":"Nygård","name":"Nygård, Magnus","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Bjørn","key":"haubackpau","last":"Hauback","name":"Hauback, Bjørn","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Magnus","key":"sørbypau","last":"Sørby","name":"Sørby, Magnus","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Gustav","key":"ekpau","last":"Ek","name":"Ek, Gustav","rank":9,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-dfc77731-d70a-4b53-922f-59dd28b5bc7d","au-fccf7092-094a-4713-ab12-ffb43b0d4aa7"],"src":["AU Aarhus University"],"title":"Neutrons for multi-functional hydrides - FunHy","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-080.65-028901","year":"2017","yearsub":"2017"}
{"abstract":"This research starts from an activist-centric perspective and explores how different actors interfere in activist communication in social media. We pursue this inquiry through a case study of the Blockupy action against the opening of the European Central Bank headquarters in Frankfurt am Main, Germany, on March 18, 2015. The investigation combines an ethnographic inquiry into activists’ social media tactics with a social network analysis of Twitter hashtags to explore how these tactics materialize in social media. The inquiry enhances our understanding of the consequences of activists’ use of corporate social media by identifying actors, communication, and networks. Moreover, although activists define Twitter hashtags as theirs, our research shows increasing police use of them, hindering activists’ attempts to communicate alternative perspectives.","author_count":3,"contributors":["Neumayer, Christina","Rossi, Luca","Karlsson, Björn"],"cuid":["S01-000.00-381688"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Activism","Ethnography","Social media","Social network analysis","Twitter"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"contested hashtags blockupy frankfurt in social media","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://pure.itu.dk/ws/files/82354795/5424_22797_1_PB.pdf","version":"Published Version"},"id":"S01-000.00-381688","ids":["itu-1c36d3f6-e19e-4a0e-91a8-3ee52171e277"],"keyword":["Twitter","activism","ethnography","social media","social network analysis"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-72C6A1A859268B0390579EFD63A3F30C"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://pure.itu.dk/ws/files/82354795/5424_22797_1_PB.pdf","version":"Published Version"},{"access":"oa","type":"rem","url":"http://ijoc.org/index.php/ijoc/article/view/5424/1840","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","The Department, Digital Society and Communication"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Christina","key":"neumayerpau","last":"Neumayer","name":"Neumayer, Christina","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Luca","key":"rossipau","last":"Rossi","locid":"1b45e3f5-b8cd-4c0d-a444-2901304f76ee","name":"Rossi, Luca","orcid":"0000-0002-3629-2039","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Björn","key":"karlssonpau","last":"Karlsson","locid":"3d49de50-0620-46fe-ae15-53b12dfb8649","name":"Karlsson, Björn","orcid":"0009-0006-0393-3676","rank":3,"rolecode":"pau"}],"pub":{"issn":["19328036"],"journal":"International Journal of Communication","pages":"5558-5579","publisher":"USC Annenberg School for Communication and Journalism","status":"p","title":"International Journal of Communication","volume":"10"},"review":"Peer Reviewed","scoID":["2-s2.0-85037650318"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-1c36d3f6-e19e-4a0e-91a8-3ee52171e277"],"src":["ITU IT University of Copenhagen"],"title":"Contested Hashtags : Blockupy Frankfurt in Social Media","type":"Journal Article","