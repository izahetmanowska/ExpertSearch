lf","rank":33,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Karin","key":"lindbergkarinpau","last":"Lindberg","name":"Lindberg, Karin","rank":34,"rolecode":"pau"}],"pmid":["40184836"],"pub":{"doi":"10.1016/j.lungcan.2025.108527","issn":["01695002","18728332"],"issn_org":["01695002"],"journal":"Lung Cancer","paperid":"108527","publisher":"Elsevier","status":"p","title":"Lung Cancer","title_org":"Lung cancer (Amsterdam, Netherlands)","volume":"203"},"review":"Peer Reviewed","scoID":["2-s2.0-105001737010"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-d435fc6d-7238-4d2a-a269-042cf000d50b","sdu-3ca93b3f-0da2-4b3a-adff-2754efd34430"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Stereotactic body radiation therapy (SBRT) of centrally located medically inoperable early-stage non-small cell lung cancer (T1-T3N0M0) − A subgroup analysis of the expanded HILUS study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-095.83-822738","year":"2025","yearsub":"2025"}
{"abstract":"Seaweeds (macroalgae) are an attractive resource for diverse microbial- and enzymatic production processes. They are abundant, underutilized, cheap, and rich in carbohydrates, and therefore have the potential to be used as a source of mono- or oligosaccharides, and as substrates for industrial fermentation processes. Many seaweed polysaccharides, including the sulfated polysaccharides ulvan and fucoidan, are however complex and heterogenous in structure, and there are currently few enzymes available to modify them, and understanding of their enzymatic depolymerization remains limited. The present study aimed to identify and characterize robust fucoidanases and ulvan lyases. Metagenomes were obtained from microbial enrichments from an intertidal hot-spring, genes identified that expressed putative fucoidanases and ulvan lyases, and following gene cloning and expression, the respective enzymes were screened for enzymatic activity. Consistent with their origin, the identified protein sequences were considerably divergent from previously characterized enzymes, with a 44% average maximal sequence identity. In total, the study resulted in the characterization of 10 new fucoidanases (GH107 and GH168 families) and 8 new ulvan lyases (PL24, PL25 and PL40 families). Notably, the new fucoidanases appeared to have functional specificity towards fucoidan containing α-1,3 linked L-fucosyl and several functioned at high temperature. The study contributes a metagenomics-based approach to identify new seaweed polysaccharide degrading enzymes and an increased understanding of the diversity of such enzymes, which may have implications for the realization of biotechnology based valorization of seaweed biomass.","author_count":16,"contributors":["Adalsteinsson, Bjorn Thor","Guðmundsson, Hörður","Jasilionis, Andrius","Schiøtt, Morten","Mikkelsen, Maria Dalgaard","Guðmundsdóttir, Elísabet Eik","Sivakumar, Pavithra","Malmgren, Annika","Kaushik, Tushar","Apelqvist, Erik","Vangsgaard, Signe","Leblay, Rébecca","Friðjónsson, Ólafur","Meyer, Anne S.","Karlsson, Eva Nordberg","Hreggviðsson, Guðmundur Óli"],"cuid":["S01-000.00-789338"],"filters":{"added":"2025-02","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Adalsteinsson, Bjorn Thor"],"country":["Iceland","Sweden"],"glorg":["All Global Affiliations","Lund University","Matís"],"keyword":["Fucoidanase","Polysaccharide","Seaweed","Thermophile"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"targeted metagenomics enrichment for enzymes active on sulfated polysaccharides from seaweeds","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.enzmictec.2024.110528","version":"Published Version"},"id":"S01-000.00-789338","identifier":[{"id":"39500133","type":"pmid"},{"id":"85208033360","type":"scopus"}],"ids":["dtu-cc232471-18ae-4c22-a4ee-0bc6b9c59f33"],"keyword":["Fucoidanase","Polysaccharide","Seaweed","Thermophile","Ulvan lyase"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-1FA7A0A14891806E22ADE5CE3979906C"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.enzmictec.2024.110528","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/380182933/1-s2.0-S0141022924001352-main.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"is","key":"matís","loc":["Iceland","Europe, Non-EU","Nordic","OECD"],"name":"Matís","used":1},{"affno":"2","country":"se","key":"lund university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Lund University","used":1},{"affno":"3","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Biotechnology and Biomedicine","Technical University of Denmark, Department of Biotechnology and Biomedicine, Section for Protein Chemistry and Enzyme Technology","Technical University of Denmark, Department of Biotechnology and Biomedicine, Section for Protein Chemistry and Enzyme Technology, Enzyme Technology"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Bjorn Thor","key":"adalsteinssonpau","last":"Adalsteinsson","name":"Adalsteinsson, Bjorn Thor","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hörður","key":"guðmundssonpau","last":"Guðmundsson","name":"Guðmundsson, Hörður","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Andrius","key":"jasilionispau","last":"Jasilionis","name":"Jasilionis, Andrius","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Morten","key":"schiøttpau","last":"Schiøtt","locid":"41b40da1-be22-4a3f-a9c1-b2d52e173ad4","name":"Schiøtt, Morten","orcid":"0000-0002-4309-8090","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Maria Dalgaard","key":"mikkelsenpau","last":"Mikkelsen","locid":"1c571c45-8910-49a5-8e91-69ca62c3f004","name":"Mikkelsen, Maria Dalgaard","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Elísabet Eik","key":"guðmundsdóttirpau","last":"Guðmundsdóttir","name":"Guðmundsdóttir, Elísabet Eik","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Pavithra","key":"sivakumarpau","last":"Sivakumar","name":"Sivakumar, Pavithra","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Annika","key":"malmgrenpau","last":"Malmgren","name":"Malmgren, Annika","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Tushar","key":"kaushikpau","last":"Kaushik","name":"Kaushik, Tushar","rank":9,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Erik","key":"apelqvistpau","last":"Apelqvist","name":"Apelqvist, Erik","rank":10,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Signe","key":"vangsgaardpau","last":"Vangsgaard","locid":"13a732b9-039d-4f1c-a2b5-ce238c5d8310","name":"Vangsgaard, Signe","orcid":"0009-0005-7926-482X","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rébecca","key":"leblaypau","last":"Leblay","name":"Leblay, Rébecca","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ólafur","key":"friðjónssonpau","last":"Friðjónsson","name":"Friðjónsson, Ólafur","rank":13,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Anne S.","key":"meyerpau","last":"Meyer","locid":"1e9f4759-72d8-4d52-94ec-ce192ffca184","name":"Meyer, Anne S.","orcid":"0000-0001-8910-9931","rank":14,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Eva Nordberg","key":"karlssonpau","last":"Karlsson","name":"Karlsson, Eva Nordberg","rank":15,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Guðmundur Óli","key":"hreggviðssonpau","last":"Hreggviðsson","name":"Hreggviðsson, Guðmundur Óli","rank":16,"rolecode":"pau"}],"pmid":["39500133"],"pub":{"doi":"10.1016/j.enzmictec.2024.110528","issn":["01410229","18790909"],"issn_org":["01410229"],"journal":"Enzyme and Microbial Technology","paperid":"110528","publisher":"Elsevier","status":"p","title":"Enzyme and Microbial Technology","volume":"182"},"review":"Peer Reviewed","scoID":["2-s2.0-85208033360"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-cc232471-18ae-4c22-a4ee-0bc6b9c59f33"],"src":["DTU Technical University of Denmark"],"title":"Targeted metagenomics – enrichment for enzymes active on sulfated polysaccharides from seaweeds","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-789338","year":"2025","yearsub":"2025"}
{"abstract":"Based on the empirical case of the POL-INTEL platform used by the Danish police, which is a customized version of Palantir Technologies’ Gotham platform, this article traces the interrelation between scientification and policing in the digital era as articulated in and through a private actor. Ethnographic fieldwork, interviews, publicly available policy documents as well as documents detailing police practices, organization, ambitions and workflows are used to problematize digital policing platforms and practices in terms of wider criminological theories and models. We show that POL-INTEL epitomizes a historical trajectory of scientification through privatization by drawing together intelligence practices, market logics, and datafication methodologies. With this point of departure, we trace back how the entanglement of private actors and the police organization raises concerns about the black boxing of criminological procedures, and the delegation of decisions and knowledge within the criminal justice system to private actors lacking public values.","author_count":2,"contributors":["Galis, Vasilis","Karlsson, Björn"],"cuid":["S01-000.00-818228"],"filters":{"added":"2025-08","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Predictive policing","Privatization","Science and Technology Studies","scientification"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"scientification through privatization pol intel in denmark","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-818228","identifier":[{"id":"105010124561","type":"scopus"}],"ids":["itu-011e4cae-aac1-4750-b1ff-27d6c17c0eb5"],"keyword":["intelligence-led policing","predictive policing","privatization","science and technology studies","scientification"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-6E21F4DC23548A326FDC24BF45DC6A47"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Digital Welfare","IT University of Copenhagen, Technologies in Practice","IT University of Copenhagen, Technologies in Practice, Technologies in Practice","IT University of Copenhagen, Technologies in Practice, Technologies of Social Order"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Vasilis","key":"galispau","last":"Galis","locid":"443362d7-b255-460d-a559-0fa80a8d9fbc","name":"Galis, Vasilis","orcid":"0000-0002-4621-3699","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Björn","key":"karlssonpau","last":"Karlsson","locid":"3d49de50-0620-46fe-ae15-53b12dfb8649","name":"Karlsson, Björn","orcid":"0009-0006-0393-3676","rank":2,"rolecode":"pau"}],"pub":{"status":"X"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Undefined"]},"sid":["itu-011e4cae-aac1-4750-b1ff-27d6c17c0eb5"],"src":["ITU IT University of Copenhagen"],"title":"Scientification through privatization : POL-INTEL in Denmark","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-818228","year":"2025","yearsub":"2025"}
{"abstract":"In this digital era, police forces across the globe are turning to cutting-edge data analytics for the purpose of enacting more efficient police power through predicting and pre-empting crime. In Denmark, allegedly one of the most digitalized countries in the world, the police have turned to the American firm Palantir Technologies to produce a platform named POL-INTEL to integrate, analyze and visualize mass amounts of data from different data bases. For the Danish national police, this platform was heralded as a “super weapon” with predictive policing capacities that would represent a “quantum leap” into the future of law enforcement. For critics, POL-INTEL has been branded a tool of mass surveillance. With this background in mind, this thesis asks two questions: How is police power imagined and enacted in the digital era? And how is governance over the police materialized in relation to data-driven policing? To answer these questions, this thesis develops a methodological framework that combines ethnographic, historiographic and interventionist approaches. Ethnographically, data is drawn from interviews with police officers as well as a variety of other actors, while following the data of those profiled by the police through the criminal justice system. Furthermore, a variety of documents, ranging from public accounts in the press serving to detail the public debate, to internal police handbooks, state reports, etc. are featured. In terms of theory, this thesis synthesizes concepts from critical theory and Science and Technology Studies in particular, alongside Critical Data Studies, police studies with a particular focus on predictive policing, as well as critical criminology. Together, these produce a useful framework for analyzing the complexities of police power, and the materialization of governance, on multiple different levels. Specifically, the thesis investigates the history of police power, tracing how police power has been imagined from the 17th century to the modern notion of predictive policing. POL-INTEL constitutes a case of digital police technology that is expected and portrayed as if it brings immense efficiency in producing social order through the application of science and technology. Through this investigation, the thesis historically ties the notion of predictive policing to the state in a way that has generally been obscured in earlier literature. Concretely, the thesis argues that predictive techniques and technologies have been a major element in the enactment of police power throughout history and follows how the specific notion of predictive policing has been revised and demarcated in the modern era, which has created conceptual inflation. In contrast, the notion of “prediction in action” is launched as a way of capturing the variety of ways law enforcement attempts to predict across different sites and with different technologies. Moreover, the thesis shows that police power has been imagined through predictive data analytics such as POL-INTEL in ways that conflict with how police power is enacted in practice, where the promised effects and new working methods are rarely fully implemented or successful. Instead, the thesis shows that the ways police power is imagined are ideological and serve to black box the enactment of police power. In turn, this black boxing means that police are able to hide their own biases, practices and politics, as well as how they influence the state itself by strategically navigating those forms of governance materialized to control law enforcement. This discovery reverses classical philosophical schemas of police as subordinate to the state and underlines instead how police power may influence government institutions and elected politicians. Details of the complexities, contradictions, and nuances of how police power is enacted in the digital era and how governance over the police is materialized in relation to data-driven policing are also explored. For instance, this thesis described in depth the internal conflicts and contradictions within the police regarding POL-INTEL as a managerial tool that attempts to curtail, limit or direct police discretion. At the same time, the thesis underlines how police discretionary power is still a significant factor in Danish law enforcement with racially biased police profiling practices feeding biased data into the platform. By utilizing and developing the concept of feedback loops, a multiplicity of feedback loops are also traced that quantitatively or qualitatively affect the lives of individuals profiled by the police, while mechanisms such as ghetto classifications and police predictions are fed into governance. This thesis thereby concretely connects the relation between police and the state in the digital era while also accentuating the contradictions of how police power is imagined and enacted. It specifies and details police predictive practices in action, thereby revealing a process that spans the human, non-human and the imaginary.","author_count":1,"contributors":["Karlsson, Björn"],"cuid":["S01-000.00-808916"],"filters":{"added":"2025-06","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"und","rtype":["clu"],"sorti":"the digital leviathan prediction politics and police power in pol intel","src":["itu"],"src-code":["DI-U-ITU"],"type":"doi","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/109527160/The_Digital_Leviathan_Prediction_Politics_and_Police_Power_in_POL-INTEL_.pdf","version":"Other Version"},"id":"S01-000.00-808916","ids":["itu-926818e6-6f45-4641-b684-d46490059993"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-F187B123DF69845116862B52DFE93F94"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/109527160/The_Digital_Leviathan_Prediction_Politics_and_Police_Power_in_POL-INTEL_.pdf","version":"Other Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Technologies in Practice","IT University of Copenhagen, Technologies in Practice, Technologies in Practice"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Björn","key":"karlssonpau","last":"Karlsson","locid":"3d49de50-0620-46fe-ae15-53b12dfb8649","name":"Karlsson, Björn","orcid":"0009-0006-0393-3676","rank":1,"rolecode":"pau"}],"pub":{"isbn":["9788779495357"],"issn":["16023536"],"issue":"237","pages":"233","publisher":"IT-Universitetet i København","series":"ITU-DS","status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-926818e6-6f45-4641-b684-d46490059993"],"src":["ITU IT University of Copenhagen"],"title":"The Digital Leviathan: Prediction, Politics and Police Power in POL-INTEL","type":"Other-Internet Publication","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-808916","year":"2025","yearsub":"2025"}
{"abstract":"When Palantir Technologies customized the Gotham platform into POL-INTEL, a data integration and analysis platform purchased and used by the Danish police, it also enforced a new ontology that simultaneously shaped the police organization and policing practices. In this context, the concept of ontology should be understood in a twofold, albeit interconnected, way: it stands for its usual philosophical burden, but also refers to a centralized concept repository. In Computer Science, ontology refers to the basic concepts for how data is structured. Based on a series of interviews with Palantir engineers and police-officer users of POL-INTEL, this paper investigates what kind of politics, concepts, and bias in the form of data are inserted, processed and materialized in and by POL-INTEL’s ontology. We argue that POL-INTEL’s ontology is inherently political, as it is articulated by an assemblage of data, ideological positions, and economic concerns that are translated into the Danish context. POL-INTEL as a vector of platformization of police work also implies ideological choices with important consequences for the organizational life and accountability of law enforcement, establishing new distributions of skills between the platform and police officers.","author_count":2,"contributors":["Galis, Vasilis","Karlsson, Björn"],"cuid":["S01-000.00-764502"],"filters":{"added":"2024-11","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Ontological politics","Ontology","Palantir","Predictive policing"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"a world of palantir ontological politics in the danish police s pol intel","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1080/1369118X.2024.2410255","version":"Published Version"},"id":"S01-000.00-764502","identifier":[{"id":"85205286090","type":"scopus"}],"ids":["itu-162d4df5-ad7b-415a-ad30-3fb1bcd9ca8c"],"keyword":["Ontological politics","Ontology","Palantir","Predictive policing"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-29BA85ABDA6F6FA69A77125F7AB59F2F"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1080/1369118X.2024.2410255","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Center for Digital Welfare","IT University of Copenhagen, Technologies in Practice, Technologies in Practice"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Vasilis","key":"galispau","last":"Galis","locid":"443362d7-b255-460d-a559-0fa80a8d9fbc","name":"Galis, Vasilis","orcid":"0000-0002-4621-3699","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Björn","key":"karlssonpau","last":"Karlsson","locid":"3d49de50-0620-46fe-ae15-53b12dfb8649","name":"Karlsson, Björn","orcid":"0009-0006-0393-3676","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1080/1369118x.2024.2410255","issn":["1369118X","14684462"],"issn_org":["1369118X"],"journal":"Information, Communication & Society","pages":"1-19","publisher":"Taylor & Francis","status":"p","title":"Information, Communication & Society"},"review":"Peer Reviewed","scoID":["2-s2.0-85205286090"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-162d4df5-ad7b-415a-ad30-3fb1bcd9ca8c"],"src":["ITU IT University of Copenhagen"],"title":"A world of Palantir : Ontological politics in the Danish police’s POL-INTEL","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-764502","year":"2024","yearsub":"2024"}
{"abstract":"OBJECTIVE: To investigate real-world effectiveness of tumor necrosis factor inhibitors (TNFi) in patients with axial spondyloarthritis (axSpA) and the association with 1) treatment line (second and third TNFi-series) and 2) reason for withdrawal from the preceding TNFi (lack of efficacy (LOE) versus adverse events (AE)). METHODS: Prospectively collected routine care data from 12 European registries were pooled. Rates for 12-month drug retention and 6-month remission (Ankylosing Spondylitis Disease Activity Score C-reactive protein inactive disease (ASDAS-ID)) were assessed in second and third TNFi-series and stratified by withdrawal reason. RESULTS: We included 8254 s and 2939 third TNFi-series; 12-month drug retention rates were similar (71%). Six-month ASDAS-ID rates were higher for the second (23%) than third TNFi (16%). Twelve-month drug retention rates for patients withdrawing from the preceding TNFi due to AE versus LOE were similar for the second (68% and 67%) and third TNFi (both 68%), while for the second TNFi, rates were lower in primary than secondary non-responders (LOE < 26 versus ≥26 weeks) (58% versus 71%, p< 0.001). Six-month ASDAS-ID rates for the second TNFi were higher if the withdrawal reason was AE (27%) versus LOE (17%), p< 0.001, while similar for the third TNFi (19% versus 13%, p= 0.20). CONCLUSION: A similar proportion of axSpA patients remained on a second and third TNFi after one year, but with low remission rates for the third TNFi. Remission rates on the second TNFi (but not the third) were higher if the withdrawal reason from the preceding TNFi was AE versus LOE.","author_count":26,"contributors":["Linde, Louise","Ørnbjerg, Lykke Midtbøll","Brahe, Cecilie Heegaard","Wallman, Johan Karlsson","Di Giuseppe, Daniela","Závada, Jakub","Castrejon, Isabel","Díaz-Gonzalez, Federico","Rotar, Ziga","Tomšič, Matija","Glintborg, Bente","Gudbjornsson, Bjorn","Geirsson, Arni Jon","Michelsen, Brigitte","Kristianslund, Eirik Klami","Santos, Maria José","Barcelos, Anabela","Nordström, Dan","Eklund, Kari K.","Ciurea, Adrian","Nissen, Michael","Akar, Servet","Hyldstrup, Lise Hejl","Krogh, Niels Steen","Hetland, Merete Lund","Østergaard, Mikkel"],"cuid":["S01-000.00-749426"],"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Asia, Middle East","Europe, EU","Europe, Non-EU","Nordic","OECD"],"country":["Czechia","Finland","Iceland","Norway","Portugal","Slovenia","Spain","Sweden","Switzerland","Turkey"],"glorg":["All Global Affiliations","Centro Hospitalar do Baixo Vouga","Charles University","Complutense University of Madrid","Diakonhjemmet Hospital","Geneva University Hospitals","Helsinki University Hospital","Hospital Garcia de Orta","Hospital General Universitario Gregorio Marañón","Hospital Universitario de Canarias","Hospital of Southern Norway","Izmir Katip Celebi University","Karolinska Institutet","Landspitali University Hospital","Lund University","NOVA University Lisbon","Skåne University Hospital","University Medical Centre Ljubljana","University of Iceland","University of La Laguna","University of Lisbon","University of Ljubljana","University of Zurich"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-PR","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-PR-OTH","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"second and third tnf inhibitors in european patients with axial spondyloarthritis effectiveness and impact of the reason for switching","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1093/rheumatology/kead494","version":"Published Version"},"id":"S01-000.00-749426","identifier":[{"id":"85197586238","type":"scopus"},{"id":"PMC11215991","type":"pmcid"},{"id":"37