u","last":"Kristianslund","name":"Kristianslund, Eirik Klami","rank":29,"rolecode":"pau"},{"affno":"34 35","corresponding":null,"first":"Maria José","key":"santospau","last":"Santos","name":"Santos, Maria José","rank":30,"rolecode":"pau"},{"affno":"24","corresponding":null,"first":"Corina","key":"mogosanpau","last":"Mogosan","name":"Mogosan, Corina","rank":31,"rolecode":"pau"},{"affno":"25","corresponding":null,"first":"Matija","key":"tomsicpau","last":"Tomsic","name":"Tomsic, Matija","rank":32,"rolecode":"pau"},{"affno":"36 37","corresponding":null,"first":"Federico","key":"díazgonzálezpau","last":"Díaz-González","name":"Díaz-González, Federico","rank":33,"rolecode":"pau"},{"affno":"38","corresponding":null,"first":"Daniela","key":"digiuseppepau","last":"Di Giuseppe","name":"Di Giuseppe, Daniela","rank":34,"rolecode":"pau"},{"affno":"3 4","first":"Merete Lund","key":"hetlandpau","last":"Hetland","locid":"3407b4a7-174d-43db-bae6-74e7f035a81f","name":"Hetland, Merete Lund","rank":35,"rolecode":"pau"}],"pmid":["37601339"],"pub":{"doi":"10.1016/j.lanepe.2023.100706","issn":["26667762"],"journal":"The Lancet Regional Health - Europe","paperid":"100706","publisher":"Elsevier","status":"p","title":"The Lancet Regional Health - Europe","volume":"33"},"review":"Peer Reviewed","scoID":["2-s2.0-85166759844"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-0c97f140-0292-4d9a-b0bc-6f9e9efe30b9","ku-a9c17415-e5e1-45cc-a881-4d0141e3b364"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Differences and similarities between the EULAR/ASAS-EULAR and national recommendations for treatment of patients with psoriatic arthritis and axial spondyloarthritis across Europe","type":"Journal Review","url":"https://local.forskningsportal.d