{"abstract":"Thalidomide and bortezomib have been frequently used for second-line therapy in patients with myeloma relapsing after or refractory to initial melphalan-based treatment, but no randomized trials have been published comparing these two treatment alternatives.","author_count":19,"contributors":["Hjorth, Martin","Hjertner, Øyvind","Knudsen, Lene Meldgaard","Gulbrandsen, Nina","Holmberg, Erik","Pedersen, Per Trøllund","Andersen, Niels Frost","Andréasson, Björn","Billström, Rolf","Carlson, Kristina","Carlsson, Margaretha S","Flogegård, Max","Forsberg, Karin","Gimsing, Peter","Karlsson, Torbjörn","Linder, Olle","Nahi, Hareth","Othzén, Annika","Swedin, Agneta"],"cuid":["S03-100.00-021522"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"corpau":["Nordic Myeloma Study Group (NMSG)"],"keyword":["Adult","Aged","Aged 80 and over","Antineoplastic Combined Chemotherapy Protocols","Boronic Acids","Cross Over Studies","Dexamethasone","Disease Free Survival","Drug Resistance Neoplasm","Female","Humans","Male","Melphalan","Middle Aged","Multiple myeloma","Pyrazines","Quality of Life","Recurrence","Thalidomide"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"thalidomide and dexamethasone vs bortezomib and dexamethasone for melphalan refractory myeloma a randomized study","src":["au","ku","sdu"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1111/j.1600-0609.2012.01775.x","version":"Other Version"},"id":"S03-100.00-021522","identifier":[{"id":"PMC3492844","type":"pmcid"},{"id":"84861198392","type":"scopus"},{"id":"22404182","type":"pmid"}],"ids":["au-79381