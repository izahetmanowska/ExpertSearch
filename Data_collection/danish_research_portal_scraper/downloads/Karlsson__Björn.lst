","key":"lindahlpau","last":"Lindahl","name":"Lindahl, Bertil","rank":6,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"country":"dk","first":"Ole","key":"fröbertpau","last":"Fröbert","locid":"4ace6e51-8f7a-44eb-84f4-f979e3e6bddf","name":"Fröbert, Ole","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sasha","key":"koulpau","last":"Koul","name":"Koul, Sasha","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"David","key":"erlingepau","last":"Erlinge","name":"Erlinge, David","rank":9,"rolecode":"pau"}],"pmid":["30541902"],"pub":{"doi":"10.1136/bmj.k4811","issn":["09598146","17561833"],"issn_org":["09598146"],"journal":"BMJ","paperid":"k4811","publisher":"BMJ Publishing Group","status":"p","title":"BMJ","title_org":"BMJ (Online)","volume":"363"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-2d3ea23e-1229-4dfc-ad62-c59def5cb30d"],"src":["AU Aarhus University"],"title":"Christmas, national holidays, sport events, and time factors as triggers of acute myocardial infarction : SWEDEHEART observational study 1998-2013","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-726971","year":"2018","yearsub":"2018"}
