":"Gluud, Christian Nyfeldt","orcid":"0000-0002-8861-0799","rank":12,"rolecode":"pau"}],"pmid":["22257841"],"pub":{"doi":"10.1016/j.jclinepi.2011.09.011","issn":["08954356","18785921"],"issn_org":["08954356"],"issue":"4","journal":"Journal of Clinical Epidemiology","pages":"444-53","publisher":"Elsevier","status":"p","title":"Journal of Clinical Epidemiology","volume":"65"},"review":"Peer Reviewed","scoID":["2-s2.0-84857658195"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Undetermined","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-80b1383f-bbe5-47fc-9d89-ba5e55e7ad5f","sdu-9eb25535-23cd-4311-9552-cb3bbe460b6d"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Good interobserver agreement was attainable on outcome adjudication in patients with stable coronary heart disease","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-093.18-043903","year":"2012","yearsub":"2012"}
