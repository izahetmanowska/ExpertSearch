{"abstract":"#75 Ultralyd elastografi i diagnostiseringen af endetarmskræft – foreløbige data","author_count":4,"contributors":["Loft, Martina Kastrup","Pedersen, Malene Roland Vils","Rafaelsen, Søren Rafael"],"cuid":["S02-083.33-048475"],"event":{"end":"2021-08-27","place":"Odense, dk","start":"2021-08-26","title":"Danske Kræftforskningsdage","year":"2021"},"filters":{"added":"2022-11","altsrc":["No Matches Found"],"author_count":"2-5 contributors","class":"merged","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"ultralyd elastografi i diagnostiseringen af endetarmskræft foreløbige data","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dca","type-grp":["all","pub"]},"id":"S02-083.33-048475","ids":["sdu-02fd9c3f-b29d-40c7-b1bd-6d6d6201f573","sdu-a7119246-d1a0-4eb3-a03e-079fa8169480"],"lang":"Danish","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-2-B71A983DBA6AE53DA941A137B3A7B992"],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Regional Health Research"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Martina Kastrup","key":"loftpau","last":"Loft","locid":"2f5b01a6-c7e9-4a6e-a810-9b95b154d58d","name":"Loft, Martina Kastrup","orcid":"0000-0003-3463-8574","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Malene Roland","key":"pedersenpau","last":"Pedersen","locid":"c30865f6-a1d6-4198-a239-5679a60ef5f6","name":"Pedersen, Malene Roland Vils","name_org":"Pedersen, Malene Roland","orcid":"0000-0001-5167-7968","rank":2,"ro