pau","last":"Belstrøm","locid":"9df60a8a-0bbd-4e2e-90fc-0cf48cbe5a00","name":"Belstrøm, Daniel","orcid":"0000-0001-7116-5388","rank":13,"rolecode":"pau"},{"affno":"1","first":"Christian","key":"vonbuchwaldpau","last":"von Buchwald","locid":"fc76b0d1-1263-48f7-a4d0-685e60bbc1b6","name":"von Buchwald, Christian","orcid":"0000-0001-6753-8129","rank":14,"rolecode":"pau"}],"pmid":["36496530"],"pub":{"doi":"10.1038/s43856-022-00223-3","issn":["2730664X"],"issue":"1","journal":"Communications Medicine","paperid":"160","publisher":"Springer Nature","status":"p","title":"Communications Medicine","volume":"2"},"review":"Peer Reviewed","scoID":["2-s2.0-85152465981"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region Zealand","Roskilde University","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-eeefb48a-5a57-4f1f-aed3-cc31af4cf376","ku-febddc54-1f35-4ea3-9db4-78522818b9c6","ruc-f60d526a-95a0-4bd7-9907-a0a1d51b2259"],"src":["AU Aarhus University","KU University of Copenhagen","RUC Roskilde University"],"title":"Intraglandular mesenchymal stem cell treatment induces changes in the salivary proteome of irradiated patients","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-099.13-716156","year":"2022","yearsub":"2022"}
{"abstract":"Seaweed is gaining attention as a sustainable source of protein. However, the nutritional protein quality needs further investigation to explore the potential of seaweed as a protein source. This study evaluates in vivo digestibility of six different seaweed protein products, four from Ulva sp. and two from Saccharina latissima. Ulva sp. was either preserved in a preservation liquid and spin flash-dried, freeze-dried without any pre-treatment or protein was extracted from the crude biomass with a screw press and isoelectrically precipitated (pH 2.5) with or without sulfite addition during extraction. Saccharina latissima was either freeze-dried or fermented with lactic acid bacteria prior to freeze-drying. The digestibility of the seaweed products was tested in a rat trial, where seaweed protein products constituted 50% of the nitrogen (N) in diets, the other 50% of N coming from whey protein concentrate. The protein concentration and proportion of essential amino acids (EAA) were increased upon protein extraction from Ulva sp. and the ash content was reduced. This led to an increased N digestibility of 55.5 ± 2.7% for the protein extract without sulfite, being 10–13%-points higher than for the other Ulva sp. products. The sulfite addition seemed to counteract the effect of extraction regarding the N digestibility. Fermentation of S. latissima increased the total amino acid content along with increased EAA proportion and lowered the ash content. However, the fermentation did not improve the organic matter, ash or N digestibility. Digestibility was in general low, but this study demonstrates the potential to increase seaweed N digestibility by more than 20% through protein extraction.","author_count":6,"contributors":["Pedersen, Louise Juul","Stødkilde-Jørgensen, Lene","Ingerslev, Anne Krog","Bruhn, Annette","Jensen, Søren Krogh","Dalsgaard, Trine Kastrup"],"cuid":["S01-000.00-141449"],"filters":{"added":"2022-04","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Dalsgaard, Trine Kastrup"],"keyword":["Digestibility","Fermentation","Macroalgae","Mechanical pressing","Protein extraction"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"digestibility of seaweed protein from ulva sp and saccharina latissima in rats","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.algal.2022.102644","version":"Published Version"},"id":"S01-000.00-141449","identifier":[{"id":"85124247197","type":"scopus"}],"ids":["au-14f18d98-d7c9-4eaf-a720-a831dea18e34"],"keyword":["Digestibility","Fermentation","Macroalgae","Mechanical pressing","Protein extraction"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-F0EB8A83F4A2EF91B568FE33ECB7F2C9"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.algal.2022.102644","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.au.dk/ws/files/333388132/1_s2.0_S2211926422000157_main.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, CBIO - Centre for Circular Bioeconomy, Foulum, CBIO - Centre for Circular Bioeconomy, Foulum - CBIO - Centre for Circular Bioeconomy, Agro Food Park","Aarhus University, Technical Sciences, Department of Food Science, Department of Food Science - Food Chemistry"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"L.","key":"juulpau","last":"Juul","locid":"264ede20-2da8-4436-b58c-0488cf8a9760","name":"Pedersen, Louise Juul","name_org":"Juul, L.","orcid":"0000-0002-2719-1447","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"L.","key":"stødkildepau","last":"Stødkilde","locid":"7edb699b-a75e-48cd-a351-9ee9e1321d4d","name":"Stødkilde-Jørgensen, Lene","name_org":"Stødkilde, L.","orcid":"0000-0001-9434-0118","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"A. K.","key":"ingerslevpau","last":"Ingerslev","locid":"3465939f-7907-44f3-9ce4-16edc0b86a2f","name":"Ingerslev, Anne Krog","name_org":"Ingerslev, A. K.","orcid":"0000-0001-5151-9548","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"A.","key":"bruhnpau","last":"Bruhn","locid":"15559017-3036-4e04-968e-338a24d800ce","name":"Bruhn, Annette","name_org":"Bruhn, A.","orcid":"0000-0002-7940-1338","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"S. K.","key":"jensenpau","last":"Jensen","locid":"7e493d39-1152-46c0-a822-c46e6ed914f3","name":"Jensen, Søren Krogh","name_org":"Jensen, S. K.","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"T. K.","key":"dalsgaardpau","last":"Dalsgaard","locid":"5627b57a-8751-4959-bbaf-dd5871851aa3","name":"Dalsgaard, Trine Kastrup","name_org":"Dalsgaard, T. K.","orcid":"0000-0002-5635-4102","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.algal.2022.102644","issn":["22119264"],"journal":"Algal Research","paperid":"102644","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"p","title":"Algal Research","volume":"63"},"review":"Peer Reviewed","scoID":["2-s2.0-85124247197"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-14f18d98-d7c9-4eaf-a720-a831dea18e34"],"src":["AU Aarhus University"],"title":"Digestibility of seaweed protein from Ulva sp. and Saccharina latissima in rats","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-141449","year":"2022","yearsub":"2022"}
{"abstract":"Seaweed is gaining attention as a possible alternative and sustainable source of proteins. This study investigates three protein extraction methods and their effect on protein yield and quality when applied to Ulva fenestrata. Two of the methods included alkaline extractions (pH-shifts); one version solubilizing the proteins at pH 8.5 and one solubilizing them at pH 8.5 followed by pH 12 (pH 8.5 + 12). The third method was a mechanical pressing, using a double screw press. All extraction methods were followed by isoelectric precipitation to concentrate the proteins. Extraction at pH 8.5 gave the significantly highest total protein yield after the isoelectric precipitation, followed by extraction at pH 8.5 + 12 and lastly mechanical extraction gave the lowest yield. Proteins extracted with both alkaline methods had a significantly higher solubility at pH 7 and pH 9, compared to proteins from the mechanical pressing. There were no significant differences between the three methods in total D/L-amino acid ratio. Amino acid cross-links measured as lysinoalanine (LAL) and lanthionine (LAN) where found in significantly higher amounts in alkali-extracted proteins compared to mechanically extracted, however not to a degree that expect to compromise functional or nutritional quality. Further, no significant difference in protein in vitro digestibility was found between extraction methods. In conclusion, results indicated that protein extraction at pH 8.5 can be recommended, especially regarding total protein yield and solubility of the final protein extract.","author_count":8,"contributors":["Pedersen, Louise Juul","Danielsen, Marianne","Nebel, Caroline","Steinhagen, S.","Bruhn, Annette","Jensen, Søren Krogh","Undeland, I.","Dalsgaard, Trine Kastrup"],"cuid":["S01-000.00-188571"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"corresponding_author":["Dalsgaard, Trine Kastrup"],"country":["Sweden"],"glorg":["All Global Affiliations","Chalmers University of Technology","University of Gothenburg"],"keyword":["Digestibility","Mechanical pressing","Protein extraction","Seaweed","pH shift"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"ulva fenestrata protein comparison of three extraction methods with respect to protein yield and protein quality","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.au.dk/ws/files/273666374/1_s2.0_S2211926421003155_main.pdf","version":"Published Version"},"id":"S01-000.00-188571","identifier":[{"id":"85115623368","type":"scopus"}],"ids":["au-67b08e37-35b3-4a2c-8248-52e0dd010ce4"],"keyword":["Digestibility","Mechanical pressing","Process-induced modifications","Protein extraction","Seaweed","pH-shift"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-90125B8C93E635806F5BA077521F4E9D"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.au.dk/ws/files/273666374/1_s2.0_S2211926421003155_main.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, CBIO - Centre for Circular Bioeconomy, Foulum","Aarhus University, Technical Sciences, Department of Food Science, Department of Food Science - Food Chemistry"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"se","key":"university of gothenburg","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"University of Gothenburg","used":1},{"affno":"3","country":"se","key":"chalmers university of technology","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Chalmers University of Technology","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"L.","key":"juulpau","last":"Juul","locid":"264ede20-2da8-4436-b58c-0488cf8a9760","name":"Pedersen, Louise Juul","name_org":"Juul, L.","orcid":"0000-0002-2719-1447","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"M.","key":"danielsenpau","last":"Danielsen","locid":"a4bd4af6-f9ac-4282-b928-08fbdf2c2a82","name":"Danielsen, Marianne","name_org":"Danielsen, M.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"C.","key":"nebelpau","last":"Nebel","locid":"838c55ff-c92a-43cb-ba2c-3c29b0ea71b9","name":"Nebel, Caroline","name_org":"Nebel, C.","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"S.","key":"steinhagenpau","last":"Steinhagen","name":"Steinhagen, S.","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"A.","key":"bruhnpau","last":"Bruhn","locid":"15559017-3036-4e04-968e-338a24d800ce","name":"Bruhn, Annette","name_org":"Bruhn, A.","orcid":"0000-0002-7940-1338","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"S. K.","key":"jensenpau","last":"Jensen","locid":"7e493d39-1152-46c0-a822-c46e6ed914f3","name":"Jensen, Søren Krogh","name_org":"Jensen, S. K.","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"I.","key":"undelandpau","last":"Undeland","name":"Undeland, I.","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"T. K.","key":"dalsgaardpau","last":"Dalsgaard","locid":"5627b57a-8751-4959-bbaf-dd5871851aa3","name":"Dalsgaard, Trine Kastrup","name_org":"Dalsgaard, T. K.","orcid":"0000-0002-5635-4102","rank":8,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.algal.2021.102496","issn":["22119264"],"journal":"Algal Research","paperid":"102496","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"p","title":"Algal Research","volume":"60"},"review":"Peer Reviewed","scoID":["2-s2.0-85115623368"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-67b08e37-35b3-4a2c-8248-52e0dd010ce4"],"src":["AU Aarhus University"],"title":"Ulva fenestrata protein – Comparison of three extraction methods with respect to protein yield and protein quality","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-188571","year":"2021","yearsub":"2021"}
{"abstract":"Ulva sp. is a cosmopolitan green macroalga with fast growth and a well-balanced amino acid composition, making it an interesting potential protein resource. Generally, the protein digestibility in unprocessed raw seaweed is low, which is why extraction and concentration of the protein is needed. During protein extraction from fresh Ulva sp. using double screw pressing, sulfite was added as antioxidant in order to increase protein quality by inhibiting oxidative reactions. By pressing, 13–14% of the total biomass protein was extracted. Isoelectric precipitation at pH 2 resulted in a yield of 36% of the extracted protein corresponding to 5% of the total protein, independent on sulfite treatment. However, size exclusion chromatography showed that sulfite addition resulted in a higher amount of native state Rubisco protein. This was explained by inhibited redox enzyme activity and improved polyphenol levels, suggesting prevention of polyphenol-protein crosslinking, resulting in higher amount of soluble protein and improved protein quality.","author_count":5,"contributors":["Pedersen, Louise Juul","Møller, Anders Hauer","Bruhn, Annette","Jensen, Søren Krogh","Dalsgaard, Trine Kastrup"],"cuid":["S01-000.00-242772"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Dalsgaard, Trine Kastrup"],"keyword":["Chlorophyta","Polyphenol","Protein quality","RuBisCO","Seaweed","Sulfite","Ulva"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"protein solubility is increased by antioxidant addition during protein extraction from the green macroalga i ulva i sp","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.au.dk/ws/files/230515099/Dalsgaard.pdf","version":"Authors Final Version"},"id":"S01-000.00-242772","identifier":[{"id":"85092376443","type":"scopus"}],"ids":["au-c6b49373-9753-43c9-bf24-4dc699cacfcc"],"keyword":["Chlorophyta","Polyphenol","Protein quality","Rubisco","Screw pressing","Seaweed","Sulfite","Ulva"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-E5E7239AFFFDC1330CABA7706E8747B4"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.au.dk/ws/files/230515099/Dalsgaard.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, CBIO - Centre for Circular Bioeconomy, Foulum","Aarhus University, Technical Sciences, Department of Food Science, Department of Food Science - Food Chemistry"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Louise Juul","key":"pedersenpau","last":"Pedersen","locid":"264ede20-2da8-4436-b58c-0488cf8a9760","name":"Pedersen, Louise Juul","orcid":"0000-0002-2719-1447","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders Hauer","key":"møllerpau","last":"Møller","locid":"679497ef-c9e0-4587-956e-6d5536543379","name":"Møller, Anders Hauer","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Annette","key":"bruhnpau","last":"Bruhn","locid":"15559017-3036-4e04-968e-338a24d800ce","name":"Bruhn, Annette","orcid":"0000-0002-7940-1338","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren Krogh","key":"jensenpau","last":"Jensen","locid":"7e493d39-1152-46c0-a822-c46e6ed914f3","name":"Jensen, Søren Krogh","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Trine Kastrup","key":"dalsgaardpau","last":"Dalsgaard","locid":"5627b57a-8751-4959-bbaf-dd5871851aa3","name":"Dalsgaard, Trine Kastrup","orcid":"0000-0002-5635-4102","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1007/s10811-020-02285-z","issn":["09218971","15735176"],"issn_org":["09218971"],"issue":"1","journal":"Journal of Applied Phycology","pages":"545-555","publisher":"Springer Science and Business Media BV","publisher_org":"Springer Science and Business Media B.V.","status":"p","title":"Journal of Applied Phycology","volume":"33"},"review":"Peer Reviewed","scoID":["2-s2.0-85092376443"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-c6b49373-9753-43c9-bf24-4dc699cacfcc"],"src":["AU Aarhus University"],"title":"Protein solubility is increased by antioxidant addition during protein extraction from the green macroalga, <i>Ulva </i>sp.","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-242772","year":"2021","yearsub":"2020"}
{"abstract":"Primary leiomyosarcoma of the colon mesentery is an extremely rare neoplasm, and only a small number of cases have been reported. We describe a case of leiomyosarcoma originating in the colonic mesentery, in a 68-year-old woman. Ultrasound showed a heterogeneous mass with varying vascularization in the left fossa. Central areas of the mass were hypoechoic, without detectable vascularization. Contrast enhanced computed tomography (CECT) of chest and abdomen showed a contrast enhanced tumour, with central non-enhanced areas. The tumour was radically resected and histopathology showed primary leiomyosarcoma. Two years after primary surgery, follow-up CECT revealed a local recurrence, which was re-resected. Subsequent follow-up CECT since have shown no sign of recurrence.","author_count":5,"contributors":["Otto, Peter Obel","Loft, Martina Kastrup","Grimm, Peter","Rafaelsen, Søren Rafael","Pedersen, Malene Roland Vils"],"cuid":["S01-000.00-640907"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Otto, Peter Obel"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"ultrasound and contrast enhanced ct imaging of a colon mesentery leiomyosarcoma","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.ejro.2021.100376","version":"Published Version"},"id":"S01-000.00-640907","identifier":[{"id":"85122692388","type":"scopus"},{"id":"PMC8484734","type":"pmcid"},{"id":"34621918","type":"pmid"}],"ids":["sdu-ec527030-13d5-4359-bc07-83e610551753"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-E57AC5A395482A74476A80F6FDBB8876"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.ejro.2021.100376","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/197098111/1_s2.0_S2352047721000563_main_1_.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Lillebælt Hospital, Research Unit of Radiology (Vejle)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Peter Obel","key":"ottopau","last":"Otto","locid":"af8af8d3-9114-4634-b2a4-3069f4b82701","name":"Otto, Peter Obel","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Martina K","key":"loftpau","last":"Loft","locid":"2f5b01a6-c7e9-4a6e-a810-9b95b154d58d","name":"Loft, Martina Kastrup","name_org":"Loft, Martina K","orcid":"0000-0003-3463-8574","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peter","key":"grimmpau","last":"Grimm","locid":"d40a89a6-1347-45d7-a7c7-1a83da13dfac","name":"Grimm, Peter","orcid":"0000-0003-0927-4609","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Rafael","key":"rafaelsenpau","last":"Rafaelsen","locid":"89253a87-a28b-4cb9-aa20-ded9a9d49536","name":"Rafaelsen, Søren Rafael","orcid":"0000-0001-5182-5545","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Malene Roland V","key":"pedersenpau","last":"Pedersen","locid":"c30865f6-a1d6-4198-a239-5679a60ef5f6","name":"Pedersen, Malene Roland Vils","name_org":"Pedersen, Malene Roland V","orcid":"0000-0001-5167-7968","rank":5,"rolecode":"pau"}]