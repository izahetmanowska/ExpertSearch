{"abstract":"YKL-40 is an inflammatory biomarker associated with disease activity and mortality in patients with diseases characterized by inflammation and tissue remodelling. The aim of this study was to describe the prognostic value of YKL-40 in an unselected patient population.","author_count":11,"contributors":["Mygind, Naja Dam","Iversen, Kasper","Køber, Lars","Goetze, Jens P.","Nielsen, H","Boesgaard, Søren","Bay, M","Johansen, Julia S.","Nielsen, Olav Wendelboe","Kirk, V","Kastrup, Jens"],"cuid":["S01-000.00-543612"],"filters":{"added":"2022-04","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Adipokines","Adult","Aged","Aged 80 and over","Biological Markers","Denmark","Female","Hospitalization","Humans","Lectins","Male","Middle Aged","Mortality","Predictive Value of Tests"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the inflammatory biomarker ykl 000000000040 at admission is a strong predictor of overall mortality","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1111/joim.12006","version":"Other Version"},"id":"S01-000.00-543612","identifier":[{"id":"23140269","type":"pmid"},{"id":"84872619792","type":"scopus"}],"ids":["ku-fb9096ea-095f-4642-ad4c-ae4f5f941b0f"],"keyword":["Adipokines","Adult","Aged","Aged, 80 and over","Biological Markers","Denmark","Female","Hospitalization","Humans","Lectins","Male","Middle Aged","Mortality","Predictive Value of Tests"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-EDA575DF02B9616A02E38577D3FBAC91"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1111/joim.12006","version":"Other Version"}],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"20