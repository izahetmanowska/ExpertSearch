niversities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-4193b5c0-7a70-46e5-8900-e0d485311e67","ku-8848af42-0e2e-4b14-b723-72c36dc99969"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Consumption of Whey in Combination with Dairy Medium-Chain Fatty Acids (MCFAs) may Reduce Lipid Storage due to Urinary Loss of Tricarboxylic Acid Cycle Intermediates and Increased Rates of MCFAs Oxidation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-097.44-017463","year":"2017","yearsub":"2017"}
{"abstract":"The angiopoietin-like 4 (ANGPLT4) protein is involved in lipid metabolism and is known to inhibit lipoprotein lipase in the bloodstream. We investigated the effect of milk on intestinal ANGPTL4 and the metabolic profile of growing pigs and the effect of free fatty acids (FFAs) on ANGPTL4 in ex vivo and in vitro assays. Feeding pigs whole milk increased intestinal ANGPTL4 mRNA and increased fecal excretion of long-chain FFA compared to the control group fed soybean oil (n = 9). Furthermore, FFAs (C4-C8) induced ANGPTL4 gene expression in porcine intestinal tissue mounted in Ussing chambers and ANGPTL4 protein secretion to both the apical and basolateral sides of intestinal Caco-2 cells on permeable membranes. Altogether, these results support an ANGPTL4-induced secretion of fecal FFAs. Urinary levels of FFAs (C4-C12), 3- hydroxyadipic acid, and suberic acid were also increased by milk consumption, indicating higher energy expenditure compared to the control group.","author_count":9,"contributors":["Nielsen, Søren Drud-Heydary","Amer, Bashar","Blaabjerg, Karoline","Dalsgaard, Trine Kastrup","Jessen, Randi","Petrat-Melin, Bjørn","Rasmussen, Martin Krøyer","Poulsen, Hanne Damgaard","Young, Jette F"],"cuid":["S01-000.00-258216"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["ANGPTL4","Fatty acids","Feces","Intestine","Milk","Secretion","Uptake","Urine"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"whole milk increases intestinal angptl000000000004 expression and excretion of fatty acids through feces and urine","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85021858410","version":"Other Version"},"id":"S01-000.00-258216","identifier":[{"id":"28004575","type":"pmid"},{"id":"85021858410","type":"scopus"}],"ids":["au-e1c3089b-a0bc-42ec-8d1e-3e390f056dac"],"keyword":["ANGPTL4","Intestine","Milk","fatty acids","feces","secretion","uptake","urine"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-3CA0EBA67CFEBEF83DE375728D164C6E"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Food Science, Department of Food Science - Food Chemistry"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Søren Drud","key":"nielsenpau","last":"Nielsen","locid":"030ede5c-2e12-40c1-9d0c-543f0c5ffadf","name":"Nielsen, Søren Drud-Heydary","name_org":"Nielsen, Søren Drud","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Bashar","key":"amerpau","last":"Amer","locid":"5114101c-24e1-45f3-a76b-f4fe19d8b821","name":"Amer, Bashar","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Karoline","key":"blaabjergpau","last":"Blaabjerg","locid":"e26bae75-86d0-453f-a76b-836e3633ce9e","name":"Blaabjerg, Karoline","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Trine K","key":"dalsgaardpau","last":"Dalsgaard","locid":"5627b57a-8751-4959-bbaf-dd5871851aa3","name":"Dalsgaard, Trine Kastrup","name_org":"Dalsgaard, Trine K","orcid":"0000-0002-5635-4102","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Randi","key":"jessenpau","last":"Jessen","locid":"e16d497e-d595-48b8-96f2-d153c8a1d835","name":"Jessen, Randi","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Bjørn","key":"petratmelinpau","last":"Petrat-Melin","locid":"38bd766b-e196-4cd1-8b30-eb309883cee5","name":"Petrat-Melin, Bjørn","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Martin Krøyer","key":"rasmussenpau","last":"Rasmussen","locid":"c5259478-eeef-4bbd-8dff-462bdefc04e3","name":"Rasmussen, Martin Krøyer","orcid":"0000-0002-1889-2874","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hanne Damgaard","key":"poulsenpau","last":"Poulsen","locid":"e6524dfb-d956-4c3e-b39d-618ae74e086e","name":"Poulsen, Hanne Damgaard","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jette F","key":"youngpau","last":"Young","locid":"93e1c32a-23c8-4141-8799-56c91ff992a2","name":"Young, Jette F","orcid":"0000-0002-8809-9513","rank":9,"rolecode":"pau"}],"pmid":["28004575"],"pub":{"doi":"10.1021/acs.jafc.6b04135","issn":["00218561","15205118"],"issn_org":["00218561"],"issue":"2","journal":"Journal of Agricultural and Food Chemistry","pages":"281-290","publisher":"American Chemical Society","status":"p","title":"Journal of Agricultural and Food Chemistry","volume":"65"},"review":"Peer Reviewed","scoID":["2-s2.0-85021858410"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-e1c3089b-a0bc-42ec-8d1e-3e390f056dac"],"src":["AU Aarhus University"],"title":"Whole Milk Increases Intestinal ANGPTL4 Expression and Excretion of Fatty Acids through Feces and Urine","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-258216","year":"2017","yearsub":"2017"}
{"abstract":"BACKGROUND: Abdominal obesity and exaggerated postprandial lipemia are independent risk factors for cardiovascular disease (CVD) and mortality, and both are affected by dietary behavior. OBJECTIVE: We investigated whether dietary supplementation with whey protein and medium-chain saturated fatty acids (MC-SFAs) improved postprandial lipid metabolism in humans with abdominal obesity. DESIGN: We conducted a 12-wk, randomized, double-blinded, diet intervention study. Sixty-three adults were randomly allocated to one of 4 diets in a 2 × 2 factorial design. Participants consumed 60 g milk protein (whey or casein) and 63 g milk fat (with high or low MC-SFA content) daily. Before and after the intervention, a high-fat meal test was performed. We measured changes from baseline in fasting and postprandial triacylglycerol, apolipoprotein B-48 (apoB-48; reflecting chylomicrons of intestinal origin), free fatty acids (FFAs), insulin, glucose, glucagon, glucagon-like peptide 1 (GLP-1), and gastric inhibitory polypeptide (GIP). Furthermore, changes in the expression of adipose tissue genes involved in lipid metabolism were investigated. Two-factor ANOVA was used to examine the difference between protein types and fatty acid compositions, as well as any interaction between the two. RESULTS: Fifty-two participants completed the study. We found that the postprandial apoB-48 response decreased significantly after whey compared with casein (P = 0.025) independently of fatty acid composition. Furthermore, supplementation with casein resulted in a significant increase in the postprandial GLP-1 response compared with whey (P = 0.003). We found no difference in postprandial triacylglycerol, FFA, insulin, glucose, glucagon, or GIP related to protein type or MC-SFA content. We observed no interaction between milk protein and milk fat on postprandial lipemia. CONCLUSION: We found that a whey protein supplement decreased the postprandial chylomicron response compared with casein in persons with abdominal obesity, thereby indicating a beneficial impact on CVD risk. This trial was registered at clinicaltrials.gov as NCT01472666.","author_count":20,"contributors":["Larsen, Mette Bohl","Bjørnshave, Ann","Rasmussen, Kia V","Schioldan, Anne Grethe","Amer, Bashar","Larsen, Mette Krogh","Holst, Jens J","Herrmann, Annkatrin","O'Neill, Sadhbh","O'Driscoll, Lorraine","Afman, Lydia","Jensen, Erik","Christensen, Merete M","Gregersen, Søren","Hermansen, Kjeld","Dalsgaard, Trine Kastrup"],"cuid":["S02-098.68-015372"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-ARLA"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-PR-ARLA","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"dairy proteins dairy lipids and postprandial lipemia in persons with abdominal obesity dairyhealth a 000000000012 wk randomized parallel controlled double blinded diet intervention study","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3945/ajcn.114.097923","version":"Published Version"},"id":"S02-098.68-015372","identifier":[{"id":"25833983","type":"pmid"},{"id":"84929659259","type":"scopus"}],"ids":["au-262bd500-c552-4484-a1dd-c33aded3a9f1","ku-384e772f-683a-4e6f-9682-0f430dbdf1bb"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-AB07619B735E0D61BA0C20A7676EAEE7"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.3945/ajcn.114.097923","version":"Published Version"}],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU