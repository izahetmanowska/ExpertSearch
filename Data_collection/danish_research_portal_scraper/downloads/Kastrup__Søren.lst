{"author_count":3,"contributors":["Loft, Martina Kastrup","Pedersen, Malene Roland Vils","Rafaelsen, Søren Rafael"],"cuid":["S01-000.00-591484"],"event":{"end":"2021-08-27","place":"Odense, dk","start":"2019-09-26","title":"Danske Kræftforskningsdage 2021","year":"2019"},"filters":{"added":"2022-03","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"ultralyd elastografi i diagnostiseringen af endetarmskræft foreløbige data","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dco","type-grp":["all","pub"]},"id":"S01-000.00-591484","ids":["sdu-3faf0dfc-a5c0-4bfb-827c-6af24c0dedac"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-14891BD08BA1FD13165040D0527AEC1D"],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Lillebælt Hospital, Research Unit of Radiology (Vejle)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Martina","key":"kastruploftpau","last":"Kastrup Loft","locid":"2f5b01a6-c7e9-4a6e-a810-9b95b154d58d","name":"Loft, Martina Kastrup","name_org":"Kastrup Loft, Martina","orcid":"0000-0003-3463-8574","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Malene Roland","key":"pedersenpau","last":"Pedersen","locid":"c30865f6-a1d6-4198-a239-5679a60ef5f6","name":"Pedersen, Malene Roland Vils","name_org":"Pedersen, Malene Roland","orcid":"0000-0001-5167-7968","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Rafael","key":"rafaelsenpau","last":"Rafaelsen","locid":"89253a87-a28b-4cb9-aa20-ded9a9d49536","name":"Rafaelsen, Søren Rafael","orcid":"0000-0001-5182-5545","rank":3,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-3faf0dfc-a5c0-4bfb-827c-6af24c0dedac"],"src":["SDU University of Southern Denmark"],"title":"Ultralyd elastografi i diagnostiseringen af endetarmskræft - foreløbige data","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-591484","year":"2021","yearsub":"2021"}
{"abstract":"Colorectal cancer is the second most common cancer in Europe, and accurate lymph node staging in rectal cancer patients is essential for the selection of their treatment. MRI lymph node staging is complex, and few studies have been published regarding its reproducibility. This study assesses the inter-and intraobserver variability in lymph node size, apparent diffusion coefficient (ADC) measurements, and morphological characterization among inexperienced and experienced radiologists. Four radiologists with different levels of experience in MRI rectal cancer staging analyzed 36 MRI scans of 36 patients with rectal adenocarcinoma. Inter-and intraobserver variation was calculated using interclass correlation coefficients and Cohens-kappa statistics, respectively. Inter-and intraobserver agreement for the length and width measurements was good to excellent, and for that of ADC it was fair to good. Interobserver agreement for the assessment of irregular border was moderate, heterogeneous signal was fair, round shape was fair to moderate, and extramesorectal lymph node location was moderate to almost perfect. Intraobserver agreement for the assessment of irregular border was fair to substantial, heterogeneous signal was fair to moderate, round shape was fair to moderate, and extramesorectal lymph node location was substantial to almost perfect. Our data indicate that subjective variables such as morphological characteristics are less reproducible than numerical variables, regardless of the level of experience of the observers.","author_count":6,"contributors":["Grimm, Peter","Loft, Martina Kastrup","Dam, Claus","Pedersen, Malene Roland Vils","Timm, Signe","Rafaelsen, Søren Rafael"],"cuid":["S01-000.00-621991"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Grimm, Peter"],"keyword":["Interobserver variability","Lymph node staging","Radiology","Rectal cancer"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"intra and interobserver variability in magnetic resonance imaging measurements in rectal cancer patients","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/cancers13205120","version":"Published Version"},"id":"S01-000.00-621991","identifier":[{"id":"85116923572","type":"scopus"},{"id":"PMC8534180","type":"pmcid"},{"id":"34680269","type":"pmid"}],"ids":["sdu-aa545d9a-ad0b-4f7b-b67f-6b0abc4fd197"],"keyword":["Interobserver variability","Intraobserver variability","Lymph node staging","Radiology","Rectal cancer"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-D10EA93109BE55B9D70CB75F49AB2570"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/cancers13205120","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/193406601/Open_Access_Version.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Lillebælt Hospital, Research Unit of Radiology (Vejle)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Peter","key":"grimmpau","last":"Grimm","locid":"d40a89a6-1347-45d7-a7c7-1a83da13dfac","name":"Grimm, Peter","orcid":"0000-0003-0927-4609","rank"