m","name":"Lindedam, Jane","rank":15,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Mette","key":"lübeckmettepau","last":"Lübeck","name":"Lübeck, Mette","rank":16,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Erik","key":"fogerikpau","last":"Fog","name":"Fog, Erik","rank":17,"rolecode":"pau"}],"pub":{"isbn":["9788793398665"],"issn":["22451684"],"issue":"93","pages":"72","publisher":"DCA - Nationalt Center for Fødevarer og Jordbrug","repno":"DCA rapport, No. 93","series":"DCA rapport","status":"p"},"review":"No Review","search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Private Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-f3f641da-087d-4b46-8bb5-d5590a2427b5"],"src":["AU Aarhus University"],"title":"Green biomass - protein production through biorefining","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-268486","year":"2017","yearsub":"2016"}
{"abstract":"Scope: The aim of the paper is to investigate whether changes in the metabolome could explain observed changes in body composition in overweight adults after consumption of butter with high level of medium-chain fatty acids (MCFAs) in combination with casein or whey. Methods and results: With GC-TOF and LC-Q/MS, metabolites in plasma and urine from a 12-week randomized double-blinded human intervention including 52-abdominally overweight adults were analyzed. The participants consumed 63 g per day of milk fat (high or low in MCFAs) and 60 g per day of protein (whey or casein). Urinary loss of the tricarboxylic acid cycle metabolites and a concomitantly increase of glycerol in blood were observed in the whey + high-MCFAs group, indicating potential lower anabolic processes, such as lipogenesis, by draining substrates. High intake of MCFAs resulted in elevated level of urinary adipic (independently of protein type) and plasma sebacic acid (with whey), indicating a potential increase in oxidation of MCFAs, which might lead to energy loss. Conclusion: The type of protein showed highest effect on the overall metabolic profiles, but ω-oxidation of MCFAs in the liver seemed to be the main reason for the observed reduction in body fat mass after consumption of high MCFAs, independent of type of protein.","author_count":12,"contributors":["Amer, Bashar","Clausen, Morten Rahr","Bertram, Hanne Christine S.","Larsen, Mette Bohl","Nebel, Caroline","Zheng, Hong","Skov, Thomas","Larsen, Mette Krogh","Gregersen, Søren","Hermansen, Kjeld","Dalsgaard, Trine Kastrup"],"cuid":["S02-097.44-017463"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"keyword":["Dairy","Fatty acids","Metabolic syndrome","Milk Proteins","Weight loss","Whey"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-HO-CDR","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"consumption of whey in combination with dairy medium chain fatty acids mcfas may reduce lipid storage due to urinary loss of tricarboxylic acid cycle intermediates and increased rates of mcfas oxidation","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"https://authorservices.wiley.com/author-resources/Journal-Authors/licensing/self-archiving.html","type":"loc","url":"https://pure.au.dk/ws/files/142138514/Consumption_of_Whey_in_Combination_with_Dairy_Medium_Chain_Fatty_Acids_MCFAs_may_Reduce_Lipid_Storage_due_to_Urinary_Loss_of_Tricarboxylic_Acid_Cycle_Intermediates_and_Increased_Rates_of_MCFAs_Oxidation.pdf","version":"Authors Final Version"},"id":"S02-097.44-017463","identifier":[{"id":"000417459400024","type":"wos"},{"id":"85032919551","type":"scopus"},{"id":"28949074","type":"pmid"}],"ids":["au-4193b5c0-7a70-46e5-8900-e0d485311e67","ku-8848af42-0e2e-4b14-b723-72c36dc99969"],"keyword":["Dairy","Fatty Acids","Whey","medium-chain fatty acids oxidation","metabolic syndrome","milk medium-chain fatty acids","milk proteins","weight loss"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-A22E4C290D51E704F2D00118F5139583"],"oa_link":[{"access":"oa","license":"https://authorservices.wiley.com/author-resources/Journal-Authors/licensing/self-archiving.html","type":"loc","url":"https://pure.au.dk/ws/files/142138514/Consumption_of_Whey_in_Combination_with_Dairy_Medium_Chain_Fatty_Acids_MCFAs_may_Reduce_Lipid_Storage_due_to_Urinary_Loss_of_Tricarboxylic_Acid_Cycle_Intermediates_and_Increased_Rates_of_MCFAs_Oxidation.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Food Science, Department of Food Science - Food Chemistry"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Food Science, Food Analytics and Biotechnology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Bashar","key":"amerbasharpau","last":"Amer","locid":"5114101c-24e1-45f3-a76b-f4fe19d8b821","name":"Amer, Bashar","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Morten Rahr","key":"clausenmortenrahrpau","last":"Clausen","locid":"18396755-daca-4cef-946e-a911a99addc0","name":"Clausen, Morten Rahr","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Hanne Christine S.","key":"bertramhannechristinespau","last":"Bertram","locid":"9ad2a927-38d2-4267-9382-a851bf3c7e06","name":"Bertram, Hanne Christine S.","orcid":"0000-0002-1882-5321","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mette Bohl","key":"larsenmettebohlpau","last":"Larsen","locid":"ba6b0126-cafc-4e4d-bad0-1c1ca37bea22","name":"Larsen, Mette Bohl","orcid":"0009-0009-9913-1011","rank":4,"rolecode":"pau"},{"affno":"2","first":"Mette","key":"bohlmettepau","last":"Bohl",