{"abstract":"Upon initial publication the article type for this manuscript was Original Research Article-Basic Science. Upon issue publication the article type has been updated to Original Research Article-Clinical.","author_count":6,"contributors":["Kristensen, Marie Skov","Kjærulff, Thora Majlund","Ersbøll, Annette Kjær","Green, Anders","Hallas, Jesper","Thygesen, Lau Caspar"],"cuid":["S01-000.00-607347"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"erratum the influence of antidepressants on the disease course among patients with crohn s disease and ulcerative colitis a danish nationwide register based cohort study","src":["sdu"],"src-code":["DI-U-SDU"],"type":"djc","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85073609950","version":"Other Version"},"id":"S01-000.00-607347","identifier":[{"id":"85073609950","type":"scopus"},{"id":"31626706","type":"pmid"},{"id":"PMC6799944","type":"pmcid"}],"ids":["sdu-77235e87-bf79-48a6-9790-8f16dd61afef"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-DDA562E18E0232AD2DAA90CFD0323BE0"],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, National Institute of Public Health","SDU, The Faculty of Health Sciences, National Institute of Public Health, Department of Population Health and Morbidity"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"fir