 Atmospheric Emissions & Modelling"],"nora_code":"DI-U-AU","used":1},{"affno":"5","country":"gb","key":"university of surrey","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Surrey","used":1}],"person":[{"affno":"1 2","country":"dk","first":"Mette","key":"sørensenpau","last":"Sørensen","locid":"5bf2a665-def4-499c-9c63-0c440da72e20","name":"Sørensen, Mette","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ulla","key":"arthurhvidtfeldtpau","last":"Arthur Hvidtfeldt","name":"Arthur Hvidtfeldt, Ulla","rank":2,"rolecode":"pau"},{"affno":"2","first":"Ulla Arthur","key":"hvidtfeldtpau","last":"Hvidtfeldt","name":"Hvidtfeldt, Ulla Arthur","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Aslak Harbo","key":"poulsenpau","last":"Poulsen","name":"Poulsen, Aslak Harbo","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Lau Caspar","key":"thygesenpau","last":"Thygesen","locid":"1932f287-552d-4539-8153-b2fc204a703b","name":"Thygesen, Lau Caspar","orcid":"0000-0001-8375-5211","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Lise Marie","key":"frohnpau","last":"Frohn","locid":"1db55612-df02-4189-ab0d-5c62193e1afc","name":"Frohn, Lise Marie","orcid":"0000-0002-4236-5708","rank":5,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"country":"dk","first":"Matthias","key":"ketzelpau","last":"Ketzel","locid":"798900d2-1d54-4c53-a4ca-671c12aa3015","name":"Ketzel, Matthias","orcid":"0000-0001-9519-1935","rank":6,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Jesper Heile","key":"christensenpau","last":"Christensen","locid":"5d084fe1-5909-4b7f-ac1a-907f4a30089e","name":"Christensen, Jesper Heile","orcid":"0000-0002-6741-5839","rank":7,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Jørgen","key":"brandtpau","last":"Brandt","locid":"5f570c62-a5a5-4760-b7c7-8755b6e37ebf","name":"Brandt, Jørgen","orcid":"0000-0002-7580-9547","rank":8,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Jibran","key":"khanpau","last":"Khan","locid":"c8fe96cd-050e-4aa9-8303-e03e7e92bf3e","name":"Khan, Jibran","orcid":"0000-0003-2080-2871","rank":9,"rolecode":"pau"},{"affno":"2 4","corresponding":null,"country":"dk","first":"Ole","key":"raaschounielsenpau","last":"Raaschou-Nielsen","locid":"9ae8831f-2034-4c09-84bc-01cd649e3b55","name":"Raaschou-Nielsen, Ole","rank":10,"rolecode":"pau"}],"pmid":["34411546"],"pub":{"doi":"10.1016/j.envres.2021.111886","issn":["00139351","10960953"],"issn_org":["00139351"],"journal":"Environmental Research","paperid":"111886","publisher":"Academic Press Inc.","status":"p","title":"Environmental Research","volume":"203"},"review":"Peer Reviewed","scoID":["2-s2.0-85112857154"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Non-Profit Organisations","All Universities","DI-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Non-Profit Organisations","Roskilde University","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-81914484-e1fa-4131-8587-53dc7b8b0ac3","ruc-18f2aa9c-1a87-4fd0-a387-70bcd9d19a0a","sdu-8f96d6b7-61f8-4883-a94e-fa7b1386fb47"],"src":["AU Aarhus University","RUC Roskilde University","SDU University of Southern Denmark"],"title":"The effect of adjustment to register-based and questionnaire-based covariates on the association between air pollution and cardiometabolic disease","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-098.81-022129","year":"2022","yearsub":"2022"}
{"abstract":"We aimed to investigate whether higher light intensity in the morning is associated with better nocturnal sleep quality and whether higher light intensities in the evening or night have the opposite effect. Light intensity was recorded for 7 consecutive days across the year among 317 indoor and outdoor daytime workers in Denmark (55–56° N) equipped with a personal light recorder. Participants reported sleep quality after each nocturnal sleep. Sleep quality was measured using three parameters; disturbed sleep index, awakening index, and sleep onset latency. Associations between increasing light intensities and sleep quality were analyzed using mixed effects models with participant identity as a random effect. Overall, neither white nor blue light intensities during morning, evening, or night were associated with sleep quality, awakening, or sleep onset latency of the subsequent nocturnal sleep. However, secondary analyses suggested that artificial light during the morning and day contrary to solar light may increase vulnerability to evening light exposure. Altogether, we were not able to confirm that higher morning light intensity significantly improves self-reported sleep quality or that higher evening or night light intensities impair self-reported sleep quality at exposure levels encountered during daily life in a working population in Denmark. This suggests that light intensities alone are not important for sleep quality to a degree that it is distinguishable from other important parameters in daily life settings.","author_count":12,"contributors":["Amdisen, Lau","Daugaard, Stine","Vestergaard, Jesper Medom","Vested, Anne","Bonde, Jens Peter","Vistisen, Helene Tilma","Christoffersen, Jens","Garde, Anne Helene","Hansen, Åse Marie","Markvart, Jakob","Schlünssen, Vivi","Kolstad, Henrik Albert"],"cuid":["S04-100.00-766933"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"corresponding_author":["Amdisen, Lau"],"keyword":["Awakening","Blue light","Light exposure","Light recordings","Sleep diary","Sleep onset latency","Sleep quality","Søvn","White light"],"level":"sci","mra":["med","sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-OT","DI-PR","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-WORK"],"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR"],"OT":["Department of Public Health, Section of Social Medicine, Institute of Public Health, University of Copenhagen, Copenhagen, Denmark."],"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-GV-WORK","DI-HO-CAP","DI-HO-CDR","DI-PR-OTH","DI-U-AAU","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"a longitudinal study of morning evening and night light intensities and nocturnal sleep quality in a working population","src":["aau","au","ku","nfa"],"src-code":["DI-GV-WORK","DI-U-AAU","DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85121445222","version":"Other Version"},"funding_acknowledgement":["The author(s) reported there is no funding associated with the work featured in this article."],"id":"S04-100.00-766933","identifier":[{"id":"000730097700001","type":"wos"},{"id":"85121445222","type":"scopus"},{"id":"34903140","type":"pmid"}],"ids":["aau-a6283f9b-8a06-4385-8c85-b2a006b1e439","au-c6c98f4a-60fc-412a-bfb5-25230296bd66","ku-836b4e55-fb87-47b4-9db0-921cfdb6bcae","nfa-1c9dd9c9-ddc3-49a8-b112-4eb31c922271"],"keyword":["Awakening","Blue light","Light exposure","Light recordings","Sleep diary","Sleep onset latency","Sleep quality","Søvn","White light"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-7-3484C23290860E28F6484F56FCB117E7"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"au aarhus