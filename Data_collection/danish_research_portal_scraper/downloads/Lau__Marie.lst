{"abstract":"As our society continues to age and family size decreases, there is increasing concern about lack of caregiver availability. This may be especially important in the context of end-of-life decision-making. The goal of this study was to characterize the size and composition of the family network of adults at the time of death using a population-based register study. All adults in Denmark who died of natural causes 2009-2016 (n= 401,000) were linked to living adult family members (parents, children, spouses, sibling, great/grandchildren). While the majority of decedents were linked to multiple family members (median =5), 21.6\\of-life, we must also recognize that there are many kinless individuals who may benefit from early formal care planning services to facilitate end-of-life decision-making.","author_count":5,"contributors":["Ornstein, Katherine","Mair, Christine","Kristensen, Marie Skov","Aldridge, Melissa","Thygesen, Lau Caspar"],"cuid":["S01-000.00-643790"],"event":{"end":"2019-11-17","place":"Austin, Texas, us","start":"2019-11-13","title":"The Gerontological Society of America (GSA) 2019 Annual Scientific Meeting","year":"2019"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Icahn School of Medicine at Mount Sinai","University of Maryland"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"kinlessness at the time of death implications for end of life decision making","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1093/geroni/igz038.885","version":"Published Version"},"id":"S01-000.00-643790","ids":["sdu-f6a56801-7d63-4aaf-945d-b38eb56ed525"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-FB4AADDC250D16DD1F8AB94B5B7329AE"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/169144121/igz038.885.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1093/geroni/igz038.885","version":"Published Version"}],"org":[{"affno":"1","country":"us","key":"icahn school of medicine at mount sinai","loc":["United States","America, North","OECD"],"name":"Icahn School of Medicine at Mount Sinai","used":1},{"affno":"2","country":"us","key":"university of maryland","loc":["United States","America, North","OECD"],"name":"University of Maryland","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, National Institute of Public Health"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Katherine","key":"ornsteinpau","last":"Ornstein","name":"Ornstein, Katherine","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Christine","key":"mairpau","last":"Mair","name":"Mair, Christine","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Marie Skov","key":"kristensenpau","last":"Kristensen","locid":"ede804e9-f7b6-414e-a9bd-557cb33be5bb","name":"Kristensen, Marie Skov","orcid":"0000-0002-8066-8937","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Melissa","key":"aldridgepau","last":"Aldridge","name":"Aldridge, Melissa","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Lau Caspar","key":"thygesenpau","last":"Thygesen","locid":"1932f287-552d-4539-8153-b2fc204a703b","name":"Thy