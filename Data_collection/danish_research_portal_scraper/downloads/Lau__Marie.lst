:"0000-0002-7614-9616","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ellen Frandsen","key":"laupau","last":"Lau","locid":"7f9eea58-bc93-4713-9ed2-69e1b88adab2","name":"Lau, Ellen Frandsen","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sebastian","key":"schlaferpau","last":"Schlafer","locid":"bcd4e1fe-3a80-4288-8b5f-d105f6f53982","name":"Schlafer, Sebastian","orcid":"0000-0003-2463-1926","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1159/000534630","issn":["00086568","1421976X"],"issn_org":["00086568"],"issue":"3","journal":"Caries Research","pages":"353-353","paperid":"72","publisher":"S. Karger AG","status":"p","title":"Caries Research","volume":"57"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-cf636bd5-903d-4233-af10-0de3e041283e"],"src":["AU Aarhus University"],"title":"Ratiometric monitoring of extracellular pH at the microscale in in situ-grown dental biofilms exposed to different saliva flow velocities and film thicknesses","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-709321","year":"2023","yearsub":"2023"}
{"abstract":"Apiospora and Arthrinium have undergone a period of upheaval with disparate phylogenic affiliation during the past ten years. Recently, they were divided into two separate clades with the majority being Apiospora and several species changing genus from Arthrinum to Apiospora. The first genome annotation became available in 2020, and the potential for novel secondary metabolite production appears very high in these yet unexplored genera compared to other more famous filamentous fungi. In this review, we present the current state of knowledge of 269 secondary metabolites isolated from the two fungal genera combined and highlight some of the compounds with known biological or toxic effects.","author_count":14,"contributors":["Overgaard, Marie L.","Aalborg, Trine","Zeuner, Emil Juel","Westphal, Klaus","Lau, Frederik A.","Nielsen, Vibeke S.","Carstensen, Kasper B.","Hundebøll, Emil A.","Westermann, Tia A.","Rathsach, Gustav G.","Sørensen, Jens L.","Frisvad, Jens Christian","Wimmer, Reinhard","Sondergaard, Teis E."],"cuid":["S02-093.91-005393"],"filters":{"added":"2023-03","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Sondergaard, Teis E.","Sondergaard, Teis Esben"],"keyword":["Apiospora","Arthrinium","Non ribosomal peptide","Polyketide","Secondary metabolism","Terpenoid"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-AAU","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"quick guide to secondary metabolites from i apiospora i and i arthrinium i","src":["aau","dtu"],"src-code":["DI-U-AAU","DI-U-DTU"],"type":"djr","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/769383095/Quick_guide_Fungal_Biol_Reviews_rev2.pdf","version":"Authors Final Version"},"id":"S02-093.91-005393","identif