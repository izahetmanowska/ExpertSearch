ia","rank":40,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Ary","key":"gadelhaarypau","last":"Gadelha","name":"Gadelha, Ary","rank":41,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Kuan-Pin","key":"sukuanpinpau","last":"Su","name":"Su, Kuan-Pin","rank":42,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jun Soo","key":"kwonjunsoopau","last":"Kwon","name":"Kwon, Jun Soo","rank":43,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Minah","key":"kimminahpau","last":"Kim","name":"Kim, Minah","rank":44,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Tae Young","key":"leetaeyoungpau","last":"Lee","name":"Lee, Tae Young","rank":45,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Oleg","key":"papsuevolegpau","last":"Papsuev","name":"Papsuev, Oleg","rank":46,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Denisa","key":"mankovádenisapau","last":"Manková","name":"Manková, Denisa","rank":47,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Andrea","key":"boscuttiandreapau","last":"Boscutti","name":"Boscutti, Andrea","rank":48,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Cristiano","key":"gerundacristianopau","last":"Gerunda","name":"Gerunda, Cristiano","rank":49,"rolecode":"pau"},{"affno":"16","corresponding":null,"first":"Sofie Have","key":"hoffmannsofiehavepau","last":"Hoffmann","locid":"c2921699-3b69-474c-8df2-f4883d6162a1","name":"Hoffmann, Sofie Have","orcid":"0000-0001-6558-2556","rank":50,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Christoph U.","key":"correllchristophupau","last":"Correll","name":"Correll, Christoph U.","rank":51,"rolecode":"pau"}],"pmid":["39305825"],"pub":{"doi":"10.1016/j.psychres.2024.115972","issn":["01651781","18727123"],"issn_org":["01651781"],"journal":"Psychiatry Research","paperid":"115972","publisher":"Elsevier","status":"p","title":"Psychiatry Research","volume":"342"},"review":"Peer Reviewed","scoID":["2-s2.0-85204393641"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-e2309d1c-3def-4309-9352-9ccb2c0a760e"],"src":["SDU University of Southern Denmark"],"title":"Global and risk-group stratified well-being and mental health during the COVID-19 pandemic in adults : Results from the international COH-FIT Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-766334","year":"2024","yearsub":"2024"}
{"abstract":"Preventing young people’s cigarette smoking is a major public health priority, and smoking is especially prevalent in vocational schools. Well-enforced comprehensive school tobacco policies accompanied by preventive efforts show potential to reduce smoking, but the implementation process is crucial to achieve the intended effect. We investigate whether and how implementation fidelity of a multi-component smoking prevention intervention impacted student smoking outcomes after 4–5 months among students in Danish vocational education and training (national age range 15–65 years, mean 25.6) and preparatory basic education (national age range 15–25 years, mean 17.6) institutions using questionnaire data from a cluster-RCT. The intervention included a smoke-free school hours policy, educational curriculum, and class competition. We calculated an overall implementation fidelity measure combining staff-reported school-level delivery (fidelity) and student-reported receipt (participation, responsiveness), and used multilevel regression models to analyze associations with smoking outcomes (smoking daily, regularly, and during school hours). We supplemented the analysis with restricted cubic spline regression. Additionally, we stratified the analyses by school types and analyzed associations between implementation fidelity of the separate intervention components and smoking outcomes. High implementation was associated with lower odds of regular smoking (OR: 0.37, 95% CI: 0.18–0.78) and smoking during school hours, but not daily smoking, and these associations varied between the school settings. When analyzed separately, implementation fidelity of the components did not affect the outcomes significantly. Our findings underline the need to support the implementation process of school tobacco policy interventions to ensure the intended effects of reducing students’ smoking.","author_count":5,"contributors":["Jensen, Marie Pil","Krølner, Rikke","Thygesen, Lau Caspar","Lund, Lisbeth","Andersen, Susan"],"cuid":["S01-000.00-766346"],"filters":{"added":"2024-11","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Jensen, Marie Pil"],"keyword":["Complex interventions","Process evaluation","School tobacco policies","Smoking Cessation"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"the impact of implementation fidelity of a school based multi component smoking prevention intervention on vocational students smoking behavior a cluster randomized controlled trial","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s11121-024-01712-8","version":"Published Version"},"id":"S01-000.00-766346","identifier":[{"id":"85200370584","type":"scopus"},{"id":"PMC11390863","type":"pmcid"},{"id":"39093518","type":"pmid"}],"ids":["sdu-e70c8fef-6110-4ba3-85ee-4a7bab8444f4"],"keyword":["Complex interventions","Older adolescents","Process evaluation","School tobacco policies","School-based smoking prevention","Smoking cessation"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-B286503F7B7CAB4C57CD7F525DB73209"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/268608982/dsf-024-01712-8.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s11121-024-01712-8","version":"Published Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, National Institute of Public Health","SDU, The Faculty of Health Sciences, National Institute of Public Health, Child and adolescent health"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Marie Pil","key":"jensenpau","last":"Jensen","locid":"dedd7dd7-0754-4e38-aad9-9904df4b6228","name":"Jensen, Marie Pil","orcid":"0000-0003-4434-238X","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rikke Fredenslund","key":"krølnerpau","last":"Krølner","locid":"7c22d49c-cc2e-49f8-a06a-ae4e659224cd","name":"Krølner, Rikke","name_org":"Krølner, Rikke Fredenslund","orcid":"0000-0002-4928-4310","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lau Caspar","key":"thygesenpau","last":"Thygesen","locid":"1932f287-552d-4539-8153-b2fc204a703b","name":"Thygesen, Lau Caspar","orcid":"0000-0001-8375-5211","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lisbeth","key":"lundpau","last":"Lund","locid":"3aaf33b5-c513-4638-9d7c-caa7227a1464","name":"Lund, Lisbeth","orcid":"0000-0002-9129-7174","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Susan","key":"andersenpau","last":"Andersen","locid":"0c579982-4271-4944-a15f-08bb2e8234c3","name":"Andersen, Susan","orcid":"0000-0002-2741-0742","rank":5,"rolecode":"pau"}],"pmid":["39093518"],"pub":{"doi":"10.1007/s11121-024-01712-8","issn":["13894986","15736695"],"issn_org":["13894986"],"issue":"6","journal":"Prevention Science","pages":"934-947","publisher":"Springer","status":"p","title":"Prevention Science","volume":"25"},"review":"Peer Reviewed","scoID":["2-s2.0-85200370584"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-e70c8fef-6110-4ba3-85ee-4a7bab8444f4"],"src":["SDU University of Southern Denmark"],"title":"The Impact of Implementation Fidelity of a School-Based Multi-Component Smoking Prevention Intervention on Vocational Students’ Smoking Behavior : A Cluster-Randomized Controlled Trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-766346","year":"2024","yearsub":"2024"}
{"abstract":"Objectives: Public health interventions are designed to improve specific health-related outcomes; however, they may also produce negative side effects, such as substitution use, psychological or social harms. Knowledge about the unintended effects of school-based smoking preventive interventions is sparse. Hence, this study examined these potential unintended effects of the smoking-reducing intervention, Focus, among students in the vocational education and training setting.  Design: Cluster randomised controlled trial stratified by school type with 5 months follow-up.  Setting and participants: Across Denmark, eight schools were randomised to the intervention group (n=844 students, response proportion 76%) and six schools to the control group (n=815 students, response proportion 75%). This study focused solely on students who smoked at baseline (N=491).  Interventions: The intervention was developed systematically based on theory and a thoroughly mixed-methods needs assessment. Intervention components included a comprehensive school tobacco policy (smoke-free school hours) supported by a 3-day course for school staff and launched by an edutainment session for students; class-based lessons and a quit-and-win competition; and individual telephone smoking cessation support. Outcomes: Alternative tobacco and nicotine products (regular use of smokeless tobacco, hookah and e-cigarettes), regular cannabis use, boredom and loneliness at school, stress and perceived stigmatisation among smokers.  Results: We found no statistically significant unintended effects of the intervention. Nonetheless, insignificant findings indicated that students in the intervention group were less likely to be bored during school hours (OR 0.59, 95% CI 0.32 to 1.10) and experience stress (OR 0.62, 95% CI 0.35 to 1.10), but more likely to report feeling stigmatised compared with the control group (OR 1.55, 95% CI 0.71 to 3.40).  Conclusions: Overall, findings suggested no unintended effects of the Focus trial with respect to substitution use, psychological, nor group or social harms. Future research is encouraged to report potential harmful outcomes of smoking preventive interventions, and interventions should be aware of the possible stigmatisation of smokers.  Trial registration number: ISRCTN16455577.","author_count":7,"contributors":["Kjeld, Simone Gad","Thygesen, Lau Caspar","Danielsen, Dina","Jensen, Marie Pil","Krølner, Rikke","Pisinger, Charlotta","Andersen, Susan"],"cuid":["S01-000.00-722875"],"filters":{"added":"2024-03","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Kjeld, Simone Gad"],"keyword":["Awareness","Electronic Nicotine Delivery Systems","Epidemiology","Humans","Mental health","Public health","Schools","Smoking","Statistics research methods","Students"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"OT":["Tryg Foundation"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"do school based smoking preventive interventions have unintended effects post hoc analysis of the focus cluster randomised controlled trial","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/bmjopen-2022-070176","version":"Published Version"},"funding_acknowledgement":["The study is funded by The Danish Cancer Society (proposal number: R163-A10653)."],"id":"S01-000.00-722875","identifier":[{"id":"85181997012","type":"scopus"},{"id":"PMC10806711","type":"pmcid"},{"id":"38191253","type":"pmid"}],"ids":["sdu-089fbf96-c46f-4d61-85ad-f7c5240e3855"],"keyword":["Awareness","Electronic Nicotine Delivery Systems","Humans","Schools","Smoking","Students","epidemiology","mental health","public health","statistics & research methods"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-4E5C5D9137A64CF5E35608718310BEAB"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/254800540/e070176.full.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/bmjopen-2022-070176","version":"Published Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, National Institute of Public Health","SDU, The Faculty of Health Sciences, National Institute of Public Health, Epidemiology and Interventions"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Miscellaneous","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Tryg Foundation"],"nora_code":"DI-OT","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Frederiksberg Hospital"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Simone G.","key":"kjeldpau","last":"Kjeld","locid":"815da2c0-de8c-442b-96ac-fbe1b87bcbc8","name":"Kjeld, Simone Gad","name_org":"Kjeld, Simone G.","orcid":"0000-0001-6883-8764","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lau C.","key":"thygesenpau","last":"Thygesen","locid":"1932f287-552d-4539-8153-b2fc204a703b","name":"Thygesen, Lau Caspar","name_org":"Thygesen, Lau C.","orcid":"0000-0001-8375-5211","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Dina","key":"danielsenpau","last":"Danielsen","locid":"0f0234b5-28f8-4d4d-9995-b7c6975aad21","name":"Danielsen, Dina","orcid":"0000-0002-0289-7961","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marie P.","key":"jensenpau","last":"Jensen","locid":"dedd7dd7-0754-4e38-aad9-9904df4b6228","name":"Jensen, Marie Pil","name_org":"Jensen, Marie P.","orcid":"0000-0003-4434-238X","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rikke F.","key":"krølnerpau","last":"Krølner","locid":"7c22d49c-cc2e-49f8-a06a-ae4e659224cd","name":"Krølner, Rikke","name_org":"Krølner, Rikke F.","orcid":"0000-0002-4928-4310","rank":5,"rolecode":"pau"},{"affno":"1 2 3","corresponding":null,"first":"Charlotta","key":"pisingerpau","last":"Pisinger","locid":"2753d4a1-21d5-4ba4-b750-5f450983909d","name":"Pisinger, Charlotta","orcid":"0000-0002-7970-3168","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Susan","key":"andersenpau","last":"Andersen","locid":"0c579982-4271-4944-a15f-08bb2e8234c3","name":"Andersen, Susan","orcid":"0000-0002-2741-0742","rank":7,"rolecode":"pau"}],"pmid":["38191253"],"pub":{"doi":"10.1136/bmjopen-2022-070176","issn":["20446055"],"issue":"1","journal":"BMJ Open","paperid":"e070176","publisher":"BMJ Publishing Group","status":"p","title":"BMJ Open","volume":"14"},"review":"Peer Reviewed","scoID":["2-s2.0-85181997012"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-089fbf96-c46f-4d61-85ad-f7c5240e3855"],"src":["SDU University of Southern Denmark"],"title":"Do school-based smoking preventive interventions have unintended effects? : Post hoc analysis of the Focus cluster randomised controlled trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-722875","year":"2024","yearsub":"2024"}
{"abstract":"INTRODUCTION: The incidence of type 2 diabetes is increasing globally. Recent research suggests that loneliness could be a potential risk factor for the development of type 2 diabetes. We aimed to investigate the association between loneliness and type 2 diabetes and the modifying effect of mental disorders. RESEARCH DESIGN AND METHODS: We conducted a prospective study including 465 290 adults (aged ≥16 years) who participated in either the Danish Health and Morbidity Survey or the Danish National Health Survey between 2000 and 2017. Loneliness was based on self-report, while type 2 diabetes was measured using an algorithm combining several health registers including type 2 diabetes patients treated both within the hospital sector and general practice. Cox proportional hazards regressions were used to estimate hazard ratios (HRs) and 95% confidence intervals (95% CIs). RESULTS: During a mean follow-up time of 6.3 years, 13 771 individuals (3%) developed type 2 diabetes. Feeling lonely once in a while was associated with a 14% increased risk of type 2 diabetes (95% CI 1.09 to 1.20), while feeling lonely often was associated with a 24% increased risk (95% CI 1.14 to 1.34), independent of sociodemographic factors and body mass index. The association was stronger among individuals without a mental disorder (HR 1.21, 95% CI 1.10 to 1.34 among those feeling lonely often) compared with those with a mental disorder (HR 1.07, 95% CI 0.93 to 1.23). CONCLUSIONS: Loneliness independently increased the risk of type 2 diabetes. The effect was more pronounced in individuals without a mental disorder, as having a mental disorder itself likely increases the risk of type 2 diabetes. These findings emphasize the importance of addressing loneliness as a modifiable risk factor in preventing type 2 diabetes.","author_count":10,"contributors":["Rosenkilde, Siri","Hoffmann, Sofie Have","Thorsted, Anne Bonde","Horsbøl, Trine Allerslev","Madsen, Katrine Rich","Fokdal Lehn, Sara","Kofoed-Enevoldsen, Allan","Iversen, Peter Bindslev","Grønkjær, Marie Stjerne","Thygesen, Lau Caspar"],"cuid":["S01-000.00-734364"],"filters":{"added":"2024-05","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Rosenkilde, Siri"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-STENO","DI-HO-ZEA"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-STENO","DI-HO-ZEA","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"loneliness and the risk of type 000000000002 diabetes","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/bmjdrc-2023-003934","version":"Published Version"},"id":"S01-000.00-734364","identifier":[{"id":"PMC11146379","type":"pmcid"},{"id":"38479777","type":"pmid"},{"id":"85187686547","type":"scopus"}],"ids":["sdu-e93ef3f1-9aee-48bb-8577-0bedcd793b03"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-FD1E51819D88C1E49C90905578882772"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/bmjdrc-2023-003934","version":"Published Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, National Institute of Public Health"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"steno diabetes centers","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-STENO","l3nn":"Steno Diabetes Centers","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Steno Diabetes Centers","namevar":["Steno Diabetes Center Sjæll