{"author_count":4,"contributors":["Mairey, Isabelle Pascale","Rosenkilde, Siri","Klitgaard, Marie Borring","Thygesen, Lau Caspar"],"cuid":["S01-000.00-685325"],"filters":{"added":"2023-09","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"sygdomsbyrden i danmark sygdomme","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://www.ft.dk/samling/20222/almdel/suu/bilag/107/2670755.pdf","version":"Published Version"},"id":"S01-000.00-685325","ids":["sdu-aa9fd063-e04b-42d1-81b2-3b24123f9422"],"lang":"Danish","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-712F9193BA289FCB52F148E9BE71ACB0"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://www.ft.dk/samling/20222/almdel/suu/bilag/107/2670755.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, National Institute of Public Health","SDU, The Faculty of Health Sciences, National Institute of Public Health, Public health epidemiology"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Isabelle Pascale","key":"maireypau","last":"Mairey","locid":"64511873-de85-47aa-a515-aaf63e66ee25","name":"Mairey, Isabelle Pascale","orcid":"0009-0008-8185-3764","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Siri","key":"rosenkildepau","last":"Rosenkilde","locid":"2ed017dc-04a9-42