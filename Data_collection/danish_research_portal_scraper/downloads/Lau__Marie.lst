ital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Capital Region of Denmark","Stolpegaard Psychotherapy Centre"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Lisa Grønberg","key":"riisagerpau","last":"Riisager","locid":"b011c717-c1f6-416e-94e2-6d80c699b1a0","name":"Riisager, Lisa Grønberg","orcid":"0000-0002-2598-710X","rank":1,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Anne Bryde","key":"christensenpau","last":"Christensen","name":"Christensen, Anne Bryde","rank":2,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Frederik Bernt","key":"scharffpau","last":"Scharff","name":"Scharff, Frederik Bernt","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Ida-Marie T. P.","key":"arendtpau","last":"Arendt","name":"Arendt, Ida-Marie T. P.","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Israa","key":"ismailoth","last":"Ismail","name":"Ismail, Israa","rank":5,"role":"Other","rolecode":"oth"},{"affno":"4 5","corresponding":null,"first":"Marianne Engelbrecht","key":"lauoth","last":"Lau","name":"Lau, Marianne Engelbrecht","rank":6,"role":"Other","rolecode":"oth"},{"affno":"2 1","corresponding":null,"first":"Stine Bjerrum","key":"møllerpau","last":"Møller","locid":"54bd623a-c96e-4d6b-ad07-c083a883109c","name":"Møller, Stine Bjerrum","orcid":"0000-0002-5019-8065","rank":7,"rolecode":"pau"}],"pmid":["34346896"],"pub":{"doi":"10.2196/26852","issn":["2561326X"],"issue":"8","journal":"JMIR Formative Research","paperid":"e26852","publisher":"JMIR Publications","status":"p","title":"JMIR Formative Research","volume":"5"},"review":"Peer Reviewed","scoID":["2-s2.0-85112049858"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Region Zealand","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-4f755cce-be37-4afb-808c-915c3199eb88"],"src":["SDU University of Southern Denmark"],"title":"Patients’ Experiences of Using a Self-help App for Posttraumatic Stress Disorder : Qualitative Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-595984","year":"2021","yearsub":"2021"}
{"abstract":"Aim: the objective was to test the hypothesis that a higher proportion of students with non-Western origin in high school classes is associated with lower and less frequent alcohol consumption among ethnic Danish students. Method: data on country of origin was obtained from the Danish Civil Registration System, while information on drinking habits were derived from the Danish National Youth Study 2014. Multilevel zero-inflated binominal regression was used to assess the association between class proportion of students with non-Western origin and odds of non-drinking and mean weekly alcohol consumption, while multilevel logistic regression was used to assess the association with frequent binge drinking. Results: a higher proportion of students with non-Western origin in class was associated with higher odds of non-drinking among ethnic Danish student in the same class. For example, ethnic Danish boys in classes with more than 15% of the students of non-Western origin had 77% higher odds of being non-drinkers, compared to ethnic Danish boys in classes where 0-5% had non-Western origin (OR: 1.77, 95% CI; 1.42-2.20). Among ethnic Danish students that did consume alcohol, class proportion of students with non-Western origin was not associated with weekly alcohol consumption, while a higher proportion of students with non-Western origin in class was associated with lower odds of frequent binge drinking. Conclusion: the downward drinking trend among adolescents in Western countries may be partly explained by the higher proportion of youth with non-Western origin, influencing the prevalence of drinking and frequency of binge drinking among adolescents in the ethnic majority population.","author_count":5,"contributors":["Hoffmann, Sofie H.","Pisinger, Veronica S. C.","Norredam, Marie","Tolstrup, Janne Schurmann","Thygesen, Lau C."],"cuid":["S02-099.91-042652"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"corresponding_author":["Hoffmann, Sofie Have"],"keyword":["Adolescents","Alcohol consumption","BURDEN","Disease","Immigrant","Patterns","Youth","countries"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"does class proportion of students with non western origin in high schools affect drinking habits among ethnic danish students","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Kun læseadgang","type":"doi","url":"https://doi.org/10.1093/alcalc/agaa069","version":"Published Version"},"id":"S02-099.91-042652","identifier":[{"id":"32734284","type":"pmid"},{"id":"85110295506","type":"scopus"},{"id":"000672760500009","type":"wos"}],"ids":["ku-59d1c504-4e41-4600-b33d-92a4badf9394","sdu-6f6924ae-1b5b-4028-ad1c-17e820f4ea75"],"keyword":["ADOLESCENTS","ALCOHOL-CONSUMPTION","BURDEN","COUNTRIES","DISEASE","IMMIGRANT","PATTERNS","SELF-REPORTED DRINKING","YOUTH"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-532B1B593F5826F7B576590C148970EE"],"oa_link":[{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/172951232/09.09.20_Manuscript_to_Alcohol_and_Alcoholism.pdf","version":"Authors Final Version"},{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://curis.ku.dk/ws/files/332603234/Does_Class_Proportion_of_Students_with_Non_Western_Origin_2_27.pdf","version":"Authors Final Version"},{"access":"oa","license":"Kun læseadgang","type":"doi","url":"https://doi.org/10.1093/alcalc/agaa069","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, National Institute of Public Health","SDU, The Faculty of Health Sciences, National Institute of Public Health, Department of Population Health and Morbidity"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Section of Health Services Research"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Sofie H","key":"hoffmannpau","last":"Hoffmann","locid":"c2921699-3b69-474c-8df2-f4883d6162a1","name":"Hoffmann, Sofie Have","name_org":"Hoffmann, Sofie H","orcid":"0000-0001-6558-2556","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Veronica S C","key":"pisingerpau","last":"Pisinger","locid":"371471c3-157d-4e9f-957b-08c7abbb01d1","name":"Pisinger, Veronica","name_org":"Pisinger, Veronica S C","orcid":"0000-0002-5605-138X","rank":2,"rolecode":"pau"},{"affno":"2","first":"Marie","key":"norredampau","last":"Norredam","locid":"b2ded723-225a-455c-ae7b-9be191ab1b53","name":"Norredam, Marie","rank":3,"rolecode":"pau"},{"affno":"2 1","first":"Janne S.","key":"tolstruppau","last":"Tolstrup","locid":"353f8161-921e-4dc0-927e-8bcff1e97fa4","name":"Tolstrup, Janne Schurmann","name_org":"Tolstrup, Janne S.","orcid":"0000-0002-9796-3967","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lau C","key":"thygesenpau","last":"Thygesen","locid":"1932f287-552d-4539-8153-b2fc204a703b","name":"Thygesen, Lau Caspar","name_org":"Thygesen, Lau C","orcid":"0000-0001-8375-5211","rank":5,"rolecode":"pau"}],"pmid":["32734284"],"pub":{"doi":"10.1093/alcalc/agaa069","issn":["07350414","14643502"],"issn_org":["07350414"],"issue":"4","journal":"Alcohol and Alcoholism","pages":"443-450","publisher":"Oxford University Press","status":"p","title":"Alcohol and Alcoholism","volume":"56"},"review":"Peer Reviewed","scoID":["2-s2.0-85110295506"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-59d1c504-4e41-4600-b33d-92a4badf9394","sdu-6f6924ae-1b5b-4028-ad1c-17e820f4ea75"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Does Class Proportion of Students with Non-Western Origin in High Schools Affect Drinking Habits Among Ethnic Danish Students?","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.91-042652","year":"2021","yearsub":"2021"}
{"abstract":"Background: Seriously ill individuals rely heavily on family caregivers at the end of life. Yet many do not have family support. Aim: To characterize the size and composition of decedents’ family networks by cause of death, demographic, clinical, socioeconomic, and geographic characteristics. Design: A cross-sectional population-level study with data collected from nation-wide registers. Setting/participants: All adults in Denmark born between 1935 and 1998 who died of natural causes between 2009 and 2016 were linked at the time of death to living adult spouses/partners, children, siblings, parents, and grandchildren. Results: Among 175,755 decedents (median age: 68 years, range: 18–81 years), 61% had a partner at the time of death and 78% had at least one adult child. Ten percent of decedents had no identified living adult family members. Decedents with family had a median of five relatives. Males were more likely to have a spouse/partner (65%) than females (56%). While 93% of decedents dying of cancer had adult family, only 70% of individuals dying of dementia had adult family at the time of death. The majority of cancer decedents co-resided or lived within 30 km of family (88%), compared to only 65% of those dying from psychiatric illness. Conclusions: While the majority of adults had an extensive family network at the time of death, a substantial proportion of decedents had no family, suggesting the need for non-family based long-term service and support systems. Assessment of family networks can expand our understanding of the end-of-life caregiving process and inform palliative care delivery.","author_count":7,"contributors":["Kristensen, Marie S.","Thygesen, Lau C.","Tay, Djin L.","Kumar, Raj","Grønvold, Mogens","Aldridge, Melissa","Ornstein, Katherine A."],"cuid":["S02-100.00-040578"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["America, North","OECD"],"corresponding_author":["Ornstein, Katherine A."],"country":["United States"],"glorg":["All Global Affiliations","Icahn School of Medicine at Mount Sinai","The University of Utah","University of Utah"],"keyword":["Bereavement","Caregivers","Family","Registries"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"size and composition of family networks of decedents a nationwide register based study","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85104045207","version":"Other Version"},"funding_acknowledgement":["The author(s) disclosed receipt of the following financial support for the research, authorship, and/or publication of this article: Dr. Ornstein was supported by: National Institute on Aging K01AG047923 and the National Palliative Care Research Center. Funding sources had no role in the design, conduct, and analysis of this study or in the decision to submit the manuscript for publication."],"id":"S02-100.00-040578","identifier":[{"id":"33823696","type":"pmid"},{"id":"85104045207","type":"scopus"}],"ids":["ku-1a20ddbd-f883-46ff-9b50-4c05bab2d467","sdu-b83a9b55-2510-41df-894e-bce2a12fc3a4"],"keyword":["Registries","bereavement","caregivers","family"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-A87F1967ED1E5AE9DEF3974DD3CC44E8"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, National Institute of Public Health","SDU, The Faculty of Health Sciences, National Institute of Public Health, Department of Population Health and Morbidity"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"us","key":"university of utah","loc":["United States","America, North","OECD"],"name":"University of Utah","used":1},{"affno":"3","country":"us","key":"the university of utah","loc":["United States","America, North","OECD"],"name":"The University of Utah","used":1},{"affno":"4","country":"us","key":"icahn school of medicine at mount sinai","loc":["United States","America, North","OECD"],"name":"Icahn School of Medicine at Mount Sinai","used":1},{"affno":"5","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Section of Health Services Research"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Marie S.","key":"kristensenpau","last":"Kristensen","locid":"ede804e9-f7b6-414e-a9bd-557cb33be5bb","name":"Kristensen, Marie Skov","name_org":"Kristensen, Marie S.","orcid":"0000-0002-8066-8937","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lau C.","key":"thygesenpau","last":"Thygesen","locid":"1932f287-552d-4539-8153-b2fc204a703b","name":"Thygesen, Lau Caspar","name_org":"Thygesen, Lau C.","orcid":"0000-0001-8375-5211","rank":2,"rolecode":"pau"},{"affno":"2 3","first":"Djin L.","key":"taypau","last":"Tay","name":"Tay, Djin L.","rank":3,"rolecode":"pau"},{"affno":"4","first":"Raj","key":"kumarpau","last":"Kumar","name":"Kumar, Raj","rank":4,"rolecode":"pau"},{"affno":"5","first":"Mogens","key":"grønvoldpau","last":"Grønvold","locid":"fe33c076-0051-42f0-8d87-75385ad541de","name":"Grønvo