o":"153","first":"Aïcha","key":"dahdouhaïchapau","last":"Dahdouh","name":"Dahdouh, Aïcha","rank":203,"rolecode":"pau"},{"affno":"154","first":"Björn","key":"gerdlebjörnpau","last":"Gerdle","name":"Gerdle, Björn","rank":204,"rolecode":"pau"},{"affno":"12 155","first":"Jari","key":"tiihonenjaripau","last":"Tiihonen","name":"Tiihonen, Jari","rank":205,"rolecode":"pau"},{"affno":"156","first":"Jae Il","key":"shinjaeilpau","last":"Shin","name":"Shin, Jae Il","rank":206,"rolecode":"pau"},{"affno":"157","first":"Jinhee","key":"leejinheepau","last":"Lee","name":"Lee, Jinhee","rank":207,"rolecode":"pau"},{"affno":"158","first":"Ahmed","key":"mhallaahmedpau","last":"Mhalla","name":"Mhalla, Ahmed","rank":208,"rolecode":"pau"},{"affno":"158","first":"Lotfi","key":"gahalotfipau","last":"Gaha","name":"Gaha, Lotfi","rank":209,"rolecode":"pau"},{"affno":"158","first":"Takoua","key":"brahimtakouapau","last":"Brahim","name":"Brahim, Takoua","rank":210,"rolecode":"pau"},{"affno":"159","first":"Kuanysh","key":"altynbekovkuanyshpau","last":"Altynbekov","name":"Altynbekov, Kuanysh","rank":211,"rolecode":"pau"},{"affno":"159","first":"Nikolay","key":"negaynikolaypau","last":"Negay","name":"Negay, Nikolay","rank":212,"rolecode":"pau"},{"affno":"159","first":"Saltanat","key":"nurmagambetovasaltanatpau","last":"Nurmagambetova","name":"Nurmagambetova, Saltanat","rank":213,"rolecode":"pau"},{"affno":"160","first":"Yasser Abu","key":"jameiyasserabupau","last":"Jamei","name":"Jamei, Yasser Abu","rank":214,"rolecode":"pau"},{"affno":"161","first":"Mark","key":"weisermarkpau","last":"Weiser","name":"Weiser, Mark","rank":215,"rolecode":"pau"},{"affno":"6 94 95 162","first":"Christoph U.","key":"correllchristophupau","last":"Correll","name":"Correll, Christoph U.","rank":216,"rolecode":"pau"}],"pmid":["36586617"],"pub":{"doi":"10.1016/j.jad.2022.12.022","issn":["01650327","15732517"],"issn_org":["01650327"],"journal":"Journal of Affective Disorders","pages":"249-261","publisher":"Elsevier","status":