coID":["2-s2.0-85173731134"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Hospitals","All Miscellaneous","All Private Research","All Universities","Capital Region of Denmark","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Miscellaneous","Novo Nordisk","Other Research","Private Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-92ad54d5-a2ad-408d-9ef1-3575296c0de7"],"src":["KU University of Copenhagen"],"title":"European and multi-ancestry genome-wide association meta-analysis of atopic dermatitis highlights importance of systemic immune regulation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-702024","year":"2023","yearsub":"2023"}
{"abstract":"In this register-based real-life cohort study, changes in symptom-specific hospital contacts among 12–18-year-olds following two doses of the BNT162b2 COVID-19 vaccine compared to unvaccinated peers were investigated. Using national register data, vaccinated and unvaccinated adolescents were sex and age-matched each week during the inclusion period from May to September 2021. Symptom-specific hospital contacts covering ICD-10 R diagnoses were assessed before first the vaccine dose and after the second vaccine dose. Taking previous rates of symptom-specific hospital contacts into account, differences between vaccinated and unvaccinated adolescents were found. For some hospital contacts, higher rates were seen among the vaccinated, and for others, higher rates were seen among the unvaccinated. Unspecific cognition symptoms may be important to monitor in vaccinated girls, and likewise for throat and chest pain in vaccinated boys within the first months post-vaccination. In perspective, symptom-specific hospital contacts after vaccination against COVID-19 must be assessed by taking the risk of infection and symptoms following COVID-19 infection into account.","author_count":10,"contributors":["Berg, Selina Kikkenborg","Wallach-Kildemoes, Helle","Rasmussen, Line Ryberg","Nygaard, Ulrikka","Birk, Nina Marie","Bundgaard, Henning","Ersbøll, Annette Kjær","Thygesen, Lau Caspar","Nielsen, Susanne Dam","Christensen, Anne Vinggaard"],"cuid":["S02-099.57-742381"],"filters":{"added":"2023-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Berg, Selina Kikkenborg"],"keyword":["Children and adolescents","Covid 19","Symptoms","Vaccine"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"symptom specific hospital contacts in 000000000012 000000000018 year olds vaccinated against covid 000000000019 a danish register based cohort study","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/vaccines11061049","version":"Published Version"},"funding_acknowledgement":["S.D.N. declares a research grant from Novo Nordic Foundation, a travel grant from Gilead, and that she is on the Advisory board for Gilead. G.S.K., M.S.D., and H.B. received lecture fees from Amgen, Sanofi, B.M.S., and M.S.D. None of the other authors have any conflicts to declare. This work was supported by the A.P. Møller and Chastine Mc-Kinney Møller Foundation (2021-00661). The study funder was not involved in the study."],"id":"S02-099.57-742381","identifier":[{"id":"PMC10301149","type":"pmcid"},{"id":"85163740470","type":"scopus"},{"id":"37376438","type":"pmid"}],"ids":["ku-b586e846-8c00-4a76-a26c-011f554e7d34","sdu-6c9bbf4c-cdfb-4f1b-b23b-9dd88d635b5a"],"keyword":["COVID-19","children and adolescents","symptoms","vaccine"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-3BD053DA1D2901FAC990E91901292DD1"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/239065269/vaccines_11_01049_v2.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/vaccines11061049","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/393846262/vaccines_11_01049_v2.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar"