 Danish Affiliations","All Non-Profit Organisations","All Universities","DI-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Non-Profit Organisations","Roskilde University","Universities","University of Southern Denmark"],"PST":["E-Published (ahead of print)"]},"sid":["au-414c2bcc-cb99-4b9a-b55a-c1a62d8f01e0"],"src":["AU Aarhus University"],"title":"Source-specific air pollution and risk of chronic obstructive pulmonary disease : A pooled cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-815584","year":"2025","yearsub":"2025"}
{"abstract":"Migrants are prone to poor working conditions in high-risk industries, yet little is known about their mortality risk compared to local-born workers. This study compares all-cause and cause-specific mortality between foreign-born and local-born workers, and identifies at-risk foreign-born workers. A nationwide register-based cohort study was performed using data on migrant workers obtaining residence permits in Denmark during 2015–22. Comparison group comprised Danish-born workers matched by age and sex. Survival analysis using extended Cox model was used to estimate all-cause and cause-specific mortality. Subgroup analysis was conducted by region of birth, economic sector, and occupation. Male migrant workers from Central Europe, Eastern Europe, and Central Asia had higher risk of all-cause mortality than Danish-born workers (HR = 1.30 [95% CI: 1.09–1.54]), attributed to accident deaths (HR = 1.64 [1.06–2.53]), whereas migrants from other regions had lower risk. Migrant workers from these regions were more likely to work in high-risk economic sectors and occupations, such as agriculture and construction. When stratified by economic sector and by occupation, among the elementary occupations, migrant workers from these regions still had a higher risk of all-cause mortality (HR = 1.70 [1.10–2.64]) and accident mortality (HR = 1.51 [1.22–1.85]) than Danish-born workers. Migrant workers from Central Europe, Eastern Europe, and Central Asia are more likely to die from accidents than Danish-born workers. This increased risk was partially explained by their higher representation in at-risk sectors and occupations. There is a need to better understand the structural determinants of health faced by these migrants, particularly in elementary occupations, to prevent avoidable deaths.","author_count":7,"contributors":["Lau, Karen","Mkoma, George Frederick","Kreshpaj, Bertina","Kiss, Ligia","Zimmerman, Cathy","Norredam, Marie","Hargreaves, Sally"],"cuid":["S01-000.00-829846"],"filters":{"added":"2025-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","London School of Hygiene and Tropical Medicine","University of London"],"keyword":["Health","Register","Risk"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"all cause and cause specific mortality differences between migrant workers and local workers a population based cohort study in denmark","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1093/eurpub/ckaf058","version":"Published Version"},"id":"S01-000.00-829846","identifier":[{"id":"40493532","type":"pmid"},{"id":"001504968300001","type":"wos"},{"id":"105012395999","type":"scopus"}],"ids":["ku-c6cf2991-fb79-4cf8-9ba8-73ba4e5b58ae"],"keyword":["Health","Register","Risk"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-7114263EA67593DFACFB322B70C340D6"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1093/eurpub/ckaf058","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/461321821/ckaf058.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"gb","key":"university of london","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of London","used":1},{"affno":"2","country":"gb","key":"london school of hygiene and tropical medicine","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"London School of Hygiene and Tropical Medicine","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Section of Health Services Research"],"nora_code":"DI-U-KU","used":1},{"affno":"4","country":"dk","key":"ssi statens serum institut","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-SSI","l3nn":"SSI Statens Serum Institut","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SSI Statens Serum Institut","namevar":["Statens Serum Institut"],"nora_code":"DI-GV-SSI","used":1},{"affno":"5","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Amager and Hvidovre"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1 2","first":"Karen","key":"laupau","last":"Lau","name":"Lau, Karen","rank":1,"rolecode":"pau"},{"affno":"3 4","first":"George F.","key":"mkomapau","last":"Mkoma","locid":"394851ba-eee1-41b5-9467-ab5f81e5089c","name":"Mkoma, George Frederick","name_org":"Mkoma, George F.","orcid":"0000-0001-8073-3586","rank":2,"rolecode":"pau"},{"affno":"3","first":"Bertina","key":"kreshpajpau","last":"Kreshpaj","locid":"aa873ebf-c3c1-45c8-88f1-060f8e3636ab","name":"Kreshpaj, Bertina","orcid":"0000-0002-2991-6026","rank":3,"rolecode":"pau"},{"affno":"2","first":"Ligia","key":"kisspau","last":"Kiss","name":"Kiss, Ligia","rank":4,"rolecode":"pau"},{"affno":"2","first":"Cathy","key":"zimmermanpau","last":"Zimmerman","name":"Zimmerman, Cathy","rank":5,"rolecode":"pau"},{"affno":"3 5","first":"Marie","key":"norredampau","last":"Norredam","locid":"b2ded723-225a-455c-ae7b-9be191ab1b53","name":"Norredam, Marie","rank":6,"rolecode":"pau"},{"affno":"1","first":"Sally","key":"hargreavespau","last":"Hargreaves","name":"Hargreaves, Sally","rank":7,"rolecode":"pau"}],"pmid":["40493532"],"pub":{"doi":"10.1093/eurpub/ckaf058","issn":["11011262","1464360X"],"issn_org":["11011262"],"issue":"4","journal":"European Journal of Public Health","pages":"672-679","status":"p","title":"European Journal of Public Health","volume":"35"},"review":"Peer Reviewed","scoID":["2-s2.0-105012395999"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-c6cf2991-fb79-4cf8-9ba8-73ba4e5b58ae"],"src":["KU University of Copenhagen"],"title":"All-cause and cause-specific mortality differences between migrant workers and local workers : a population-based cohort study in Denmark","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-829846","year":"2025","yearsub":"2025"}
{"abstract":"Background The positive effects of cardiac rehabilitation (CR) are well established; however, among older and vulnerable patients, nonattendance and dropout are prevalent problems. Aim The objective of this study is to explore if a 24-week peer-mentor intervention increases initial and long-term CR attendance. Secondary aims are whether peer-mentor intervention improves lifestyle (diet and physical activity) and psychological outcomes (self-efficacy, anxiety, depression, and quality of life) among older vulnerable patients with ischemic heart disease. Methods The study was designed as a 2-arm, single-center, parallel, 24-week, randomized controlled trial (RCT) with follow-up at 12 and 24 weeks. Patients were randomized at a ratio of 1:1 to receive either the peer-mentor intervention (in addition to standard CR) or standard CR along (control arm). Results Between August 2021 and March 2023, 117 older, vulnerable patients were enrolled and randomized (59 randomized to peer-mentor intervention and 58 to usual care). The peer-mentor intervention significantly increased CR attendance. This applies to both initial participation in 1 CR session of physical training or dietary advice (78.0% vs 58.6%; P =.03), and long-term attendance in ≥50% dietary advice sessions (50.8% vs 27.6%; P =.01) and completed ≥50% (64.4% vs 41.4% P =.01) or ≥75% of the physical training sessions (59.3% vs 37.9%; P =.02). The study found no statistically significant effect on secondary outcomes. Conclusions Low CR attendance is a well-known problem, especially among older, vulnerable patients; however, we tested a low-cost, peer-mentor intervention that significantly increased both initial CR participation and long-term attendance in CR sessions in this group of patients.","author_count":10,"contributors":["Pedersen, Maria","Overgaard, Dorthe","Boateng, Takyiwa","Bennich, Birgitte","Beck, Anne Marie","Andersen, Ingelise","Sibilitz, Kirstine Lærum","Mairey, Isabelle Pascale","Thygesen, Lau Caspar","Petersen, Rikke Agnete"],"cuid":["S02-099.93-823039"],"filters":{"added":"2025-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Pedersen, Maria"],"keyword":["Cardiac rehabilitation","Cardiovascular Diseases","Peer Group","Social Support"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U","DI-UC"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"],"UC":["DI-UC-ALL","DI-UC-KP"]},"level3all":["DI-HO-CAP","DI-U-KU","DI-U-SDU","DI-UC-KP"]},"review":"pr","rtype":["clu"],"sorti":"the effect of peer mentor support for older vulnerable patients with ischemic heart disease a 000000000024 week randomized controlled trial","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1097/JCN.0000000000001158","version":"Published Version"},"id":"S02-099.93-823039","identifier":[{"id":"PMC12379791","type":"pmcid"},{"id":"85207328711","type":"scopus"},{"id":"39390644","type":"pmid"}],"ids":["ku-c735570c-c591-4ceb-ad3d-8c4eb74de874","sdu-b3f13510-7be5-4f34-a796-4216a7314dca"],"keyword":["cardiac rehabilitation","cardiovascular diseases","peer group","social support"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-602257430FF8891333AEB000200ECA08"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1097/JCN.0000000000001158","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/462790553/the_effect_of_peer_mentor_support_for_older.12.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/294029781/the_effect_of_peer_mentor_support_for_older.12.pdf","version":"Publishe