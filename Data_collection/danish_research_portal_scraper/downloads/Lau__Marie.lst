":"Peer Reviewed","scoID":["2-s2.0-85137080834"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-0a8e70bb-86d0-47f5-aec9-39caf886d1b3"],"src":["KU University of Copenhagen"],"title":"Early-life respiratory tract infections and the risk of school-age lower lung function and asthma : a meta-analysis of 150 000 European children","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-399758","year":"2022","yearsub":"2022"}
{"author_count":3,"contributors":["Motzfeldt, Hanne Marie"],"cuid":["S01-000.00-419877"],"filters":{"added":"2022-07","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"databeskyttelse","src":["ku"],"src-code":["DI-U-KU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.jurabibliotek.dk/display/book/9788771987997/book-part-9788771987997-sec19.xml","version":"Other Version"},"id":"S01-000.00-419877","ids":["ku-2c5a6f01-56c8-44c0-bee7-ba49bf698cfc"],"lang":"Danish","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-F1E228E420C9DA567942047DA32188F8"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Law, Area of Research, Centre for Legal Studies in Welfare and Market"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Hanne Marie","key":"motzfeldtpau","last":"Motzfeldt","locid":"c9e7c3da-e2e2-44df-84e7-3de82aa9c8e8","name":"Motzfeldt, Hanne Marie","orcid":"0000-0002-3112-6760","rank":1,"rolecode":"pau"},{"affno":"","first":"Jesper","key":"lauhansenpedh","last":"Lau Hansen","name":"Lau Hansen, Jesper","rank":2,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Jørgen","key":"bwhansenpedh","last":"BW Hansen","name":"BW Hansen, Jørgen","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"edition":"3.","eisbn":["9788771987997"],"isbn":["9788757452198"],"publisher":"Djøf Forlag","status":"p","title":"Iværksætterens juridiske udfordringer"},"review":"Peer Reviewed","se