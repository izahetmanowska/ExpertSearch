D":["2-s2.0-85129930623"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-20816381-e100-4ec9-8d8e-652b3e5b13b9"],"src":["KU University of Copenhagen"],"title":"Cannabinoid receptor 1 antagonist genistein attenuates marijuana-induced vascular inflammation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-412807","year":"2022","yearsub":"2022"}
{"abstract":"The pancreatic hormone, glucagon, is known to regulate hepatic glucose production, but recent studies suggest that its regulation of hepatic amino metabolism is equally important. Here, we show that chronic glucagon receptor activation with a long-acting glucagon analog increases amino acid catabolism and ureagenesis and causes alpha cell hypoplasia in female mice. Conversely, chronic glucagon receptor inhibition with a glucagon receptor antibody decreases amino acid catabolism and ureagenesis and causes alpha cell hyperplasia and beta cell loss. These effects were associated with the transcriptional regulation of hepatic genes related to amino acid uptake and catabolism and by the non-transcriptional modulation of the rate-limiting ureagenesis enzyme, carbamoyl phosphate synthetase-1. Our results support the importance of glucagon receptor signaling for amino acid homeostasis and pancreatic islet integrity in mice and provide knowledge regarding the long-term consequences of chronic glucagon receptor agonism and antagonism.","author_count":13,"contributors":["Elmelund, Emilie","Galsgaard, Katrine D.","Johansen, Christian D.","Trammell, Samuel A.J.","Billeschou, Anna","Winther-Sørensen, Marie","Hunt, Jenna Elizabeth","Sørensen, Charlotte Mehlin","Kruse, Thomas","Lau, Jesper F.","Grevengoed, Trisha J.","Holst, Jens Juul","Wewer Albrechtsen, Nicolai J"],"cuid":["S01-000.00-445844"],"filters":{"added":"2022-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Biological sciences","Endocrinology","Transcriptomics"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-PR","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"PR":["DI-PR-ALL","DI-PR-NOVO"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-PR-NOVO","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"opposing effects of chronic glucagon receptor agonism and antagonism on amino acids hepatic gene expression and alpha cells","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.isci.2022.105296","version":"Published Version"},"id":"S01-000.00-445844","identifier":[{"id":"85140355202","type":"scopus"},{"id":"36325048","type":"pmid"},{"id":"PMC9618771","type":"pmcid"}],"ids":["ku-57a1410e-a319-476b-bb66-60d999c0b6c5"],"keyword":["Biological sciences","Endocrinology","Transcriptomics"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-EDDD58590126898CBED76635CE5ADE64"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.isci.2022.105296","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/324172692/1_s2.0_S2589004222015681_main.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Biomedical Sciences, Department of Biomedical Sciences"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"novo nordisk","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-NOVO","l3nl":"Novo Nordisk","l3nn":"Novo Nordisk","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Novo Nordisk","namevar":["Novo Nordisk"],"nora_code":"DI-PR-NOVO","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Bispebjerg and Frederiksberg"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","first":"Emilie","key":"elmelundpau","last":"Elmelund","locid":"50e6c2dd-69fe-4d12-8038-b85e7de1816f","name":"Elmelund, Emilie","rank":1,"rolecode":"pau"},{"affno":"1","first":"Katrine D.","key":"galsgaardpau","last":"Galsgaard","locid":"fd725ee8-8f2a-44c9-9e11-4db618356d5b","name":"Galsgaard, Katrine D.","orcid":"0000-0002-5679-2807","rank":2,"rolecode":"pau"},{"affno":"1","first":"Christian D.","key":"johansenpau","last":"Johansen","name":"Johansen, Christian D.","rank":3,"rolecode":"pau"},{"affno":"1","first":"Samuel A.J.","key":"trammellpau","last":"Trammell","locid":"051c3035-15c4-456f-a77e-8ce20970d70c","name":"Trammell, Samuel A.J.","orcid":"0000-0002-5941-4094","rank":4,"rolecode":"pau"},{"affno":"1","first":"Anna B.","key":"bomholtpau","last":"Bomholt","locid":"3fccc02f-0422-4234-883c-af26a4602f28","name":"Billeschou, Anna","name_org":"Bomholt, Anna B.","rank":5,"rolecode":"pau"},{"affno":"1","first":"Marie","key":"winthersørensenpau","last":"Winther-Sørensen","locid":"69ea5ab2-baa5-4302-8ba9-faf61abaa3db","name":"Winther-Sørensen, Marie","orcid":"0000-0003-2144-1385","rank":6,"rolecode":"pau"},{"affno":"1","first":"Jenna E.","key":"huntpau","last":"Hunt","locid":"47629671-da31-4cd8-9a58-368df1cf2264","name":"Hunt, Jenna Elizabeth","name_org":"Hunt, Jenna E.","orcid":"0000-0003-0508-7320","rank":7,"rolecode":"pau"},{"affno":"1","first":"Charlotte M.","key":"sørensenpau","last":"Sørensen","locid":"0ceca69d-e5cd-43dc-9995-305ac5855c4f","name":"Sørensen, Charlotte Mehlin","name_org":"Sørensen, Charlotte M.","orcid":"0000-0002-9984-3125","rank":8,"rolecode":"pau"},{"affno":"2","first":"Thomas","key":"krusepau","last":"Kruse","name":"Kruse, Thomas","rank":9,"rolecode":"pau"},{"affno":"2","first":"Jesper F.","key":"laupau","last":"Lau","name":"Lau, Jesper F.","rank":10,"rolecode":"pau"},{"affno":"1","first":"Trisha J.","key":"grevengoedpau","last":"Grevengoed","locid":"d25607ba-3d87-4d68-85ec-2cc86be64995","name":"Grevengoed, Trisha J.","orcid":"0000-0003-4433-3950","rank":11,"rolecode":"pau"},{"affno":"1","first":"Jens J.","key":"holstpau","last":"Holst","locid":"864b6401-9024-4773-9bdb-f4d4ca57dcad","name":"Holst, Jens Juul","name_org":"Holst, Jens J.","orcid":"0000-0001-6853-3805","rank":12,"rolecode":"pau"},{"affno":"1 3","first":"Nicolai J.","key":"weweralbrechtsenpau","last":"Wewer Albrechtsen","locid":"0d59b767-fdca-42a0-b879-70fb0ec55651","name":"Wewer Albrechtsen, Nicolai J","name_org":"Wewer Albrechtsen, Nicolai J.","orcid":"0000-0003-4230-5753","rank":13,"rolecode":"pau"}],"pmid":["36325048"],"pub":{"doi":"10.1016/j.isci.2022.105296","issn":["25890042"],"issue":"11","journal":"iScience","paperid":"105296","status":"p","title":"iScience","volume":"25"},"review":"Peer Reviewed","scoID":["2-s2.0-85140355202"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Private Research","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Hospitals","Novo Nordisk","Private Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-57a1410e-a319-476b-bb66-60d999c0b6c5"],"src":["KU University of Copenhagen"],"title":"Opposing effects of chronic glucagon receptor agonism and antagonism on amino acids, hepatic gene expression, and alpha cells","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-445844","year":"2022","yearsub":"2022"}
{"abstract":"The primary aim of the present study was to evaluate the effectiveness of standardized care package (CP) treatment for posttraumatic stress disorder (PTSD) in a Danish sample of adult psychiatric outpatients (N = 948). Secondary aims were to identify baseline predictors of treatment outcomes and investigate between-group differences in outcomes with regard to sex and treatment modality (i.e., group vs. individual therapy). The naturalistic, nonrandomized study followed a pre–post design. Patient data from five psychiatric outpatient clinics were collected between March 2011 and November 2017. Data were drawn from self-report questionnaires (i.e., SCL-90-R, WHO-5, BHS) and therapist-reported measures (i.e., GAF-S, GAF-F) administered at baseline and posttreatment. Between-group effects for sex and therapy modality (group vs. individual) were analyzed using analyses of variance, and possible predictors of outcomes were selected through LASSO regression and analyzed via hierarchical regression. Pre–post effects were small to moderate, ds = 0.39–0.69. No differences emerged regarding treatment modality, but women had significantly better outcomes than men. Aside from sex, only baseline symptom severity predicted outcomes. The effectiveness of the CP treatment was generally limited, indicating the need to implement improved therapeutic practices, such as the use of evidence-based treatments, and to provide better training to mental health clinicians. The findings underscore the need for further comparisons of group and individual treatment modalities using evidence-based therapies as well as the need to investigate factors that may affect treatment outcome.","author_count":6,"contributors":["Scharff, Frederik B.","Lau, Marianne E.","Gondan, Matthias","Folke, Sofie","Arendt, Ida Marie T.P.","Møller, Stine Bjerrum"],"cuid":["S01-000.00-638630"],"filters":{"added":"2022-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"corresponding_author":["Scharff, Frederik B."],"country":["Austria"],"glorg":["All Global Affiliations","University of Innsbruck"],"keyword":["Adult","Cognitive behavioral therapy","Female","Humans","Male","Mental health","Psychotherapy","Stress Disorders Post Traumatic psychology","Treatment Outcome"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"OT":["Danish Ministry of Defense"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"evaluation of a standardized posttraumatic stress disorder treatment framework in routine mental health care effectiveness and predictors of treatment outcome in a consecutive sample","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/203034735/jts.22790.pdf","version":"Authors Final Version"},"funding_acknowledgement":["Financial support was provided by The Danish Victims Fund (18‐610‐00018). The authors have no conflicts of interest to declare."],"id":"S01-000.00-638630","identifier":[{"id":"85127264973","type":"scopus"},{"id":"35338519","type":"pmid"}],"ids":["sdu-e479c9fe-9aae-4d2a-a54a-3dbad1a153ed"],"keyword":["Adult","Cognitive Behavioral Therapy","Female","Humans","Male","Mental Health","Psychotherapy","Stress Disorders, Post-Traumatic/psychology","Treatment Outcome"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-95E016F8C0D222E944494F7FCAC11C68"],"oa_link":[{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/203034735/jts.22790.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Capital Region of Denmark"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","country":"at","key":"university of innsbruck","loc":["Austria","Europe, EU","OECD"],"name":"University of Innsbruck","used":1},{"affno":"3","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Danish Ministry of Defense"],"nora_code":"DI-OT","used":1},{"affno":"4","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Psychology","SDU, The Faculty of Health Sciences, Department of Psychology, The National Center of Psychotraumatology"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Frederik B.","key":"scharffpau","last":"Scharff","name":"Scharff, Frederik B.","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marianne E.","key":"laupau","last":"Lau","name":"Lau, Marianne E.","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Matthias","key":"gondanpau","last":"Gondan","name":"Gondan, Matthias","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Sofie","key":"folkepau","last":"Folke","name":"Folke, Sofie","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ida Marie T.P.","key":"arendtpau","last":"Arendt","name":"Arendt, Ida Marie T.P.","rank":5,"rolecode":"pau"},{"affno":"1 4","corresponding":null,"first":"Stine B.","key":"moellerpau","last":"Moeller","locid":"54bd623a-c96e-4d6b-ad07-c083a883109c","name":"Møller, Stine Bjerrum","name_org":"Moeller, Stine B.","orcid":"0000-0002-5019-8065","rank":6,"rolecode":"pau"}],"pmid":["35338519"],"pub":{"doi":"10.1002/jts.22790","issn":["08949867","15736598"],"issn_org":["08949867"],"issue":"3","journal":"Journal of Traumatic Stress","pages":"827-838","publisher":"Wiley","status":"p","title":"Journal of Traumatic Stress","volume":"35"},"review":"Peer Reviewed","scoID":["2-s2.0-85127264973"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-e479c9fe-9aae-4d2a-a54a-3dbad1a153ed"],"src":["SDU University of Southern Denmark"],"title":"Evaluation of a standardized posttraumatic stress disorder treatment framework in routine mental health care : Effectiveness and predictors of treatment outcome in a consecutive sample","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-638630","year":"2022","yearsub":"2022"}
{"abstract":"Background: Recruiting young people for health and intervention studies by traditional methods has become increasingly challenging. The widespread access to the internet may offer new strategies for online recruitment. Objective: This study aims to assess the feasibility of online recruitment for a randomized controlled trial evaluating the effectiveness of Mindhelper, an online national youth mental health promotion service. The target group was young Danes aged 15-25 in need of mental health promotion. Methods: Advertisements for recruitment were set up on Facebook and Instagram. Browser history was collected for a subsample of participants. We compared basic characteristics of participants who completed the baseline survey and those who did not, as well as of participants who completed the follow-up survey and those who were lost to follow-up. The significance of these differences was tested with the Pearson chi-square test. Results: A total of 560 Danes aged 15-25 were recruited within 1 month (ie, had completed the baseline survey). Among these participants, 356 (63.6%) were at risk of developing depression or stress. The average advertisement price per participant completing the baseline questionnaire was 31 DKK (approximately €4 [US $4.2]). The follow-up survey was sent to 545 participants, of whom 318 (58.3%) completed the survey. No statistically significant differences were observed in baseline characteristics of participants who completed the follow-up and those who were lost to follow-up in terms of gender (P=.45), age (P=.35), occupation (P=.17), cohabitation (P=.90), mental well-being (P=.26), mental illness (P=.44; impact of the illness, P=.05), or use of the internet when having a hard time (P=.92). Conclusions: We conclude that it is feasible to recruit young Danes online for a large-scale randomized controlled trial assessing the effectiveness of Mindhelper.","author_count":8,"contributors":["Hoffmann, Sofie Have","Folker, Anna Paldam","Buskbjerg, Mark","Folker, Marie Paldam","Jezek, Andrea Huber","Svartá, Durita Lyngsø","Sølvhøj, Ida Nielsen","Thygesen, Lau Caspar"],"cuid":["S01-000.00-640688"],"filters":{"added":"2022-08","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Hoffmann, Sofie Have"],"keyword":["Mental health","Online","Recruitment","Web based","Well being","Young people"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"potential of online recruitment among 000000000015 000000000025 year olds feasibility randomized controlled trial","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.2196/35874","version":"Published Version"},"funding_acknowledgement":["This work was supported by TrygFonden (ID:128134)."],"id":"S01-000.00-640688","identifier":[{"id":"PMC9178448","type":"pmcid"},{"id":"85132042109","type":"scopus"},{"id":"35612877","type":"pmid"}],"ids":["sdu-eb955463-1b6e-4336-b787-06adc8682f1f"],"keyword":["mental health","online","recruitment","web based","well-being","young people"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-0B645CB0C7A2BA4E3D84889277283648"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/204220651/PDF.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.2196/35874","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, National Institute of Public Health"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Sofie Have","key":"hoffmannsofiehavepau","last":"Hoffmann","locid":"c2921699-3b69-474c-8df2-f4883d6162a1","name":"Hoffmann, Sofie Have","orcid":"0000-0001-6558-2556","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anna Paldam","key":"folkerannapaldampau","last":"Folker","locid":"a84a0de9-4073-4c86-a662-32e23aceb28b","name":"Folker, Anna Paldam","orcid":"0000-0003-3952-6918","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mark","key":"buskbjergmarkpau","last":"Buskbjerg","locid":"9fac2903-b91e-4a05-8670-1defe79c72bd","name":"Buskbjerg, Mark","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marie Paldam","key":"folkermariepaldampau","last":"Folker","locid":"521261e1-7f4c-4145-bb21-a18d2631c81b","name":"Folker, Marie Paldam","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andrea Huber","key":"jezekandreahuberpau","last":"Jezek","locid":"3ae288a0-7fbd-48cd-b239-80ed2b08635e","name":"Jezek, Andrea Huber","orcid":"0000-0001-8648-5202","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Durita Lyngsø","key":"svartáduritalyngsøpau","last":"Svarta","locid":"7d14a946-3c39-479f-9e88-0b5c3061f8e5","name":"Svartá, Durita Lyngsø","name_org":"Svarta, Durita Lyngsø","orcid":"0000-0002-8931-8386","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ida Nielsen","key":"sølvhøjidanielsenpau","last":"Sølvhøj","locid":"5c6cb3df-7733-4501-9640-fe32e32ad3f9","name":"Sølvhøj, Ida Nielsen","orcid":"0000-0001-6142-5684","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lau","key":"thygesenlaucasparpau","last":"Thygesen","locid":"1932f287-552d-4539-8153-b2fc204a703b","name":"Thygesen, Lau Caspar","name_org":"Thygesen, Lau","orcid":"0000-0001-8375-5211","rank":8,"rolecode":"pau"}],"pmid":["35612877"],"pub":{"doi":"10.2196/35874","issn":["2561326X"],"issue":"5","journal":"JMIR Formative Research","paperid":"e35874","publisher":"JMIR Publications","status":"p","title":"JMIR Formative Research","volume":"6"},"review":"Peer Reviewed","scoID":["2-s2.0-85132042109"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-eb955463-1b6e-4336-b787-06adc8682f1f"],"src":["SDU University of Southern Denmark"],"title":"Potential of Online Recruitment Among 15-25-Year Olds : Feasibility Randomized Controlled Trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-640688","year":"2022","yearsub":"2022"}
{"abstract":"Background: The COVID-19 pandemic has altered daily routines and family functioning, led to closing schools, and dramatically limited social interactions worldwide. Measuring its impact on mental health of vulnerable children and adolescents is crucial. Methods: The Collaborative Outcomes study on Health and Functioning during Infection Times (COH-FIT - www. coh-fit.com) is an on-line anonymous survey, available in 30 languages, involving >230 investigators from 49 countries supported by national/international professional associations. COH-FIT has thee waves (until the pandemic is declared over by the WHO, and 6-18 months plus 24-36 months after its end). In addition to adults, COH-FIT also includes adolescents (age 14-17 years), and children (age 6-13 years), recruited via nonprobability/snowball and representative sampling and assessed via self-rating and parental rating. Nonmodifiable/modifiable risk factors/treatment targets to inform prevention/intervention programs to promote health and prevent mental and physical illness in children and adolescents will be generated by COH-FIT. Co primary outcomes are changes in well-being (WHO-5) and a composite psychopathology P-Score. Multiple behavioral, family, coping strategy and service utilization factors are also assessed, including functioning and quality of life. Results: Up to June 2021, over 13,000 children and adolescents from 59 countries have participated in the COHFIT project, with representative samples from eleven countries. Limitations: Cross-sectional and anonymous design. Conclusions: Evidence generated by COH-FIT will provide an international estimate of the COVID-19 effect on children's, adolescents' and families', mental and physical health, well-being, functioning and quality of life, informing the formulation of present and future evidence-based interventions and policies to minimize adverse effects of the present and future pandemics on youth.","author_count":235,"contributors":["Solmi, Marco","Estrade, Andres","Thompson, Trevor","Agorastos, Agorastos","Radua, Joaquim","Cortese, Samuele","Dragioti, Elena","Leisch, Friedrich","Vancampfort, Davy","Thygesen, Lau Caspar","Aschauer, Harald","Schloegelhofer, Monika","Akimova, Elena","Schneeberger, Andres","Huber, Christian G.","Hasler, Gregor","Conus, Philippe","Do Cuenod, Kim Q.","von Kanel, Roland","Arrondo, Gonzalo","Fusar-Poli, Paolo","Gorwood, Philip","Llorca, Pierre-Michel","Krebs, Marie-Odile","Scanferla, Elisabetta","Kishimoto, Taishiro","Rabbani, Golam","Skonieczna-Zydecka, Karolina","Brambilla, Paolo","Favaro, Angela","Takamiya, Akihiro","Zoccante, Leonardo","Colizzi, Marco","Bourgin, Julie","Kaminski, Karol","Moghadasin, Maryam","Seedat, Soraya","Matthews, Evan","Wells, John","Vassilopoulou, Emilia","Gadelha, Ary","Su, Kuan-Pin","Kwon, Jun Soo","Kim, Minah","Lee, Tae Young","Papsuev, Oleg","Mankova, Denisa","Boscutti, Andrea","Gerunda, Cristiano","Saccon, Diego","Righi, Elena","Monaco, Francesco","Croatto, Giovanni","Cereda, Guido","Demurtas, Jacopo","Brondino, Natascia","Veronese, Nicola","Enrico, Paolo","Politi, Pierluigi","Ciappolino, Valentina","Pfennig, Andrea","Bechdolf, Andreas","Meyer-Lindenberg, Andreas","Kahl, Kai G.","Domschke, Katharina","Bauer, Michael","Koutsouleris, Nikolaos","Winter, Sibylle","Borgwardt, Stefan","Bitter, Istvan","Balazs, Judit","Czobor, Pal","Unoka, Zsolt","Mavridis, Dimitris","Tsamakis, Konstantinos","Bozikas, Vasilios P.","Tunvirachaisakul, Chavit","Maes, Michael","Rungnirundorn, Teerayuth","Supasitthumrong, Thitiporn","Haque, Ariful","Brunoni, Andre R.","Costardi, Carlos Gustavo","Schuch, Felipe Barreto","Polanczyk, Guilherme","Luiz, Jhoanne Merlyn","Fonseca, Lais","Aparicio, Luana","Valvassori, Samira S.","Nordentoft, Merete","Vendsborg, Per","Hoffmann, Sofie Have","Sehli, Jihed","Sartorius, Norman","Heuss, Sabina","Guinart, Daniel","Hamilton, Jane","Kane, John","Rubio, Jose","Sand, Michael","Koyanagi, Ai","Solanes, Aleix","Andreu-Bernabeu, Alvaro","Cace