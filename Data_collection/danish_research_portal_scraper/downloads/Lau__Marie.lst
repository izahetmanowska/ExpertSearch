enpau","last":"Kristensen","locid":"ede804e9-f7b6-414e-a9bd-557cb33be5bb","name":"Kristensen, Marie Skov","orcid":"0000-0002-8066-8937","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ann Dorthe Olsen","key":"zwislerpau","last":"Zwisler","locid":"6e2c85c0-d456-45f2-a017-7942ea7eb12a","name":"Zwisler, Ann Dorthe Olsen","orcid":"0000-0002-9241-2090","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Selina","key":"kikkenborgbergpau","last":"Kikkenborg Berg","locid":"c4711b9a-171b-41c8-adad-ba81de9f37ba","name":"Berg, Selina Kikkenborg","name_org":"Kikkenborg Berg, Selina","orcid":"0000-0002-9493-954X","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Graziella","key":"zanggerpau","last":"Zangger","locid":"4f4c0884-4346-4739-836f-e637c1922723","name":"Zangger, Graziella","orcid":"0000-0002-7606-3273","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Charlotte N","key":"grønsetpau","last":"Grønset","name":"Grønset, Charlotte N","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Signe Stelling","key":"risompau","last":"Risom","name":"Risom, Signe Stelling","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lau Caspar","key":"thygesenpau","last":"Thygesen","locid":"1932f287-552d-4539-8153-b2fc204a703b","name":"Thygesen, Lau Caspar","orcid":"0000-0001-8375-5211","rank":7,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-34e12817-9f48-4e14-b581-80c89c8e16f3"],"src":["SDU University of Southern Denmark"],"title":"Validation of the HeartQoL questionnaire in patients with atrial fibrillation","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-588348","year":"2016","yearsub":"2016"}
{"abstract":"Presset på velfærdsinstitutionerne i form af øgede forventninger og krav fra borgerne og samtidigt stadig snævre økonomiske rammer, øger behovet for en mere innovativ og kreativ praksis i velfærdsinstitutionerne. Det kommer til udtryk i de i professionsuddannelserne, der skal uddanne fremtidens professionelle i velfærdssamfundet. På disse professionsuddannelser er emner som social innovation, entreprenørskab og samskabelse blevet en del af indholdet og indskrevet i studieordningerne. Men hvad gemmer der sig bag disse ofte anvendte begreber og ”buzzwords”, hvordan etableres samskabelse i praksis, hvad er social innovation og hvilke værdier kommer der ud af det i praksis? Det forsøger en ny udgivelse fra Hans Reitzel at give svar på. Samskabelse og socialt entreprenørskab er en casebaseret grundbog til professionsuddannelserne, redigeret af undervisere ved VIA University College. Der er tale om en antologi med otte cases, der alle refererer til det indledende kapitel og dets gennemgående figur. Således er der en råd tråd og konsistens igennem alle bogens kapitler. Bogens sigte er at give de studerende indblik i de mange muligheder, drivkræfter, barrierer og besværligheder, der kendetegner samskabelse og praktisk innovationsarbejde i løsningen af offentlige opgaver. Bogen rummer teoretiske perspektiver, der forklarer begreberne samskabelse og socialt entreprenørskab, kobler dem til de otte cases og giver redskaber til de studerende, der bliver fremtidens offentlige ansatte. I forbindelse med udgivelsen er der med midler fra Fonden For Entreprenørskab produceret et site med casebaseret undervisningsmateriale. Det skal give de studerende viden og kompetencer om socialt entreprenørskab i praksis, f.eks. opstart og drift af socialøkonomiske virksomheder, og hvordan sådanne nye velfærdsteknologier kan bidrage til at skabe bedre vilkår for borgere.","author_count":15,"contributors":["Hulgård, Esben","Nielsen, Elof Nellemann","Juul-Olsen, Maja","Svendsen, Jeanette Ringgaard","Dybdahl, Frederikke","Føns, Hanne","Lyager, Mette","Larsen-Nielsen, Inger Marie","Vincenti, Gordon","Andreassen, Annette Auken","Johannesen, Rikke Møller","Lau, Dorthe","Højholdt, Andy","Nørgaard, Astrid Kidde","Løvstad, Charlotte Vange"],"cuid":["S02-100.00-038650"],"filters":{"added":"2023-02","altsrc":["No Matches Found"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"keyword":["Ledelse organisationsudvikling og innovation","Læring pædagogik og undervisning","Socialt arbejde og sociale forhold","Uddannelse professioner og erhverv"],"level":"edu","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-UC"],"level3":{"OT":["Diakonhøjskolen Aarhus"],"UC":["DI-UC-ALL","DI-UC-KP","DI-UC-VIA"]},"level3all":["DI-UC-KP","DI-UC-VIA"]},"review":"und","rtype":["clu"],"sorti":"samskabelse og socialt entreprenørskab en casebaseret grundbog til professionsuddannelserne","src":["kp","via"],"src-code":["DI-UC-KP","DI-UC-VIA"],"type":"db","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.hansreitzel.dk/Socialt-arbejde/Samskabelse-og-socialt-entrepren%C3%B8rskab/9788741264301","version":"Other Version"},"id":"S02-100.00-038650","ids":["kp-2ac8bda4-8b0a-4098-b748-aca5dfe48da7","via-2ac8bda4-8b0a-4098-b748-aca5dfe48da7"],"keyword":["Ledelse, organisationsudvikling og innovation","Læring, pædagogik og undervisning","Socialt arbejde og sociale forhold","Uddannelse, professioner og erhverv"],"lang":"Danish","level":"Educational","mra":["Humanities"],"noi":["Local-1-2-D50D9CC5487D3A33358D36E1B75680E4"],"org":[{"affno":"1","key":"via university college","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-VIA","l3nl":"VIA University College","l3nn":"VIA University College","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"VIA University College","namevar":["VIA, Forskning og udvikling, Forsk.center Pædagogik og dannelse","VIA, Uddannelser, Pædagoguddannelsen og pædagogisk assistent, Pædagoguddannelsen Horsens"],"nora_code":"DI-UC-VIA","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Diakonhøjskolen Aarhus"],"nora_code":"DI-OT","used":1},{"affno":"3","key":"kp university college copenhagen","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-KP","l3nl":"KP","l3nn":"KP University College Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KP University College Copenhagen","namevar":["Professionshøjskolen Metropol (ophørt), Læreruddannelserne (ophørt)"],"nora_code":"DI-UC-KP","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Esben","key":"hulgårdpau","last":"Hulgård","locid":"5f08cf5a-6169-497d-b849-fc02dc1e9005","name":"Hulgård, Esben","orcid":"0000-0002-3316-3119","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Elof Nellemann","key":"nielsenpau","last":"Nielsen","locid":"838de15c-fdd6-4962-849c-fbb4d2c62064","name":"Nielsen, Elof Nellemann","orcid":"0000-0002-3896-4468","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Maja","key":"juulolsenpau","last":"Juul-Olsen","locid":"b4273752-718b-4e2f-a530-1badf8669c44","name":"Juul-Olsen, Maja","orcid":"0000-0003-4067-3579","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jeanette Ringgaard","key":"svendsenpau","last":"Svendsen","locid":"d7a9a594-d2ac-4cb0-896b-d44caded7f75","name":"Svendsen, Jeanette Ringgaard","orcid":"0000-0001-5153-5548","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Frederikke","key":"dybdahlpau","last":"Dybdahl","locid":"2e925f92-496e-4728-afbb-cdd9dc0497f5","name":"Dybdahl, Frederikke","orcid":"0000-0001-8261-8784","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Hanne","key":"fønspau","last":"Føns","name":"Føns, Hanne","rank":6,"role