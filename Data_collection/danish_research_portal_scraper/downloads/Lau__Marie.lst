nmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","used":1},{"affno":"6","country":"us","key":"college of health sciences university of wisconsin milwaukee","loc":["United States","America, North","OECD"],"name":"College of Health Sciences, University of Wisconsin-Milwaukee","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Marie S","key":"kristensenpau","last":"Kristensen","locid":"ede804e9-f7b6-414e-a9bd-557cb33be5bb","name":"Kristensen, Marie Skov","name_org":"Kristensen, Marie S","orcid":"0000-0002-8066-8937","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Ann-Dorthe","key":"zwislerpau","last":"Zwisler","locid":"6e2c85c0-d456-45f2-a017-7942ea7eb12a","name":"Zwisler, Ann Dorthe Olsen","name_org":"Zwisler, Ann-Dorthe","orcid":"0000-0002-9241-2090","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Selina Kikkenborg","key":"bergpau","last":"Berg","name":"Berg, Selina Kikkenborg","orcid":"0000-0002-9493-954X","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Graziella","key":"zanggerpau","last":"Zangger","locid":"4f4c0884-4346-4739-836f-e637c1922723","name":"Zangger, Graziella","orcid":"0000-0002-7606-3273","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Charlotte","key":"grønsetpau","last":"Grønset","name":"Grønset, Charlotte","rank":5,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Signe Stelling","key":"risompau","last":"Risom","locid":"5a014329-7d13-4d40-b7a2-ffbb14185771","name":"Risom, Signe Stelling","rank":6,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Susanne S.","key":"pedersenpau","last":"Pedersen","name":"Pedersen, Susanne S.","orcid":"0000-0001-8055-3251","rank":7,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Neil","key":"oldridgepau","last":"Oldridge","name":"Oldridge, Neil","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lau C","key":"thygesenpau","last":"Thygesen","locid":"1932f287-552d-4539-8153-b2fc204a703b","name":"Thygesen, Lau Caspar","name_org":"Thygesen, Lau C","orcid":"0000-0001-8375-5211","rank":9,"rolecode":"pau"}],"pmid":["26976845"],"pub":{"doi":"10.1177/2047487316638485","issn":["20474873","20474881"],"issn_org":["20474873"],"issue":"14","journal":"European Journal of Preventive Cardiology","pages":"1496-1503","publisher":"Oxford University Press","status":"p","title":"European Journal of Preventive Cardiology","volume":"23"},"review":"Peer Reviewed","scoID":["2-s2.0-84984889429"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","All University Colleges","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","Hospitals","KP","Region of Southern Denmark","Universities","University Colleges","University of Southern Denmark"],"PST":["Published"]},"sid":["kp-7e0ac923-b48a-4516-b036-7b54dbd0debe","sdu-947ee0d3-1a6a-4f7e-9fd6-e20ee9cbf4b6"],"src":["KP University College Copenhagen","SDU University of Southern Denmark"],"title":"Validating the HeartQoL questionnaire in patients with atrial fibrillation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.94-039069","year":"2016","yearsub":"2016"}
{"abstract":"BACKGROUND: As with ischaemic heart disease, cardiac rehabilitation (CR) is recommended for patients undergoing heart valve surgery; recommendations are based on limited evidence. The organization of CR programmes and factors associated with uptake among patients undergoing heart valve surgery have not been studied. This study investigated CR programmes for these patients and factors associated with referral and participation. DESIGN AND METHODS: We distributed two nationwide surveys: one to 37 hospitals and 98 municipalities and one to 742 consecutive patients undergoing heart valve surgery. Data were linked to nationwide registries. We analysed the provision and content of programmes using descriptive statistics, and factors associated with referral and participation using logistic regression analysis. RESULTS: Coverage of CR programmes for these patients was high, with national programme variation. The overall uptake rate was 52%. Simultaneous CABG was associated with a higher probability of referral to CR (OR 2.02 (95%CI 1.12-3.65)); being unmarried (0.44 (0.27-0.72)) and having TAVI with a lower probability (0.26; 0.13-0.52). The referral pattern varied across administrative regions, with patients in the capital region less likely to be referred (0.22 (0.08-0.57)). Patients with TAVI were less likely to participate (0.29 (0.12-0.70)). CONCLUSIONS: Despite high national programme coverage, only half the patients post heart valve surgery received CR. Both factors identified at provider- and patient-level influenced uptake and included significant regional variation in referral pattern. Further research into the effect and organization of CR post heart valve surgery is needed.","author_count":7,"contributors":["Hansen, Tina B","Berg, Selina K","Sibilitz, Kirstine L","Søgaard, Rikke","Thygesen, Lau C","Yazbeck, Anne-Marie","Zwisler, Ann D"],"cuid":["S02-100.00-023359"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contribut