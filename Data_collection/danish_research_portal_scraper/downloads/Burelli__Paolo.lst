AI, Creative AI Lab","IT University of Copenhagen, Play, Culture, and AI, brAIn lab"],"nora_code":"DI-U-ITU","used":1},{"affno":"3","country":"de","key":"technische hochschule köln","loc":["Germany","Europe, EU","OECD"],"name":"Technische Hochschule Köln","used":1},{"affno":"4","country":"mt","key":"university of malta","loc":["Malta","Europe, EU"],"name":"University of Malta","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anders","key":"drachenpau","last":"Drachen","name":"Drachen, Anders","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Paolo","key":"burellipau","last":"Burelli","locid":"cf5e1d64-5489-4534-ba34-8dba5fd354a6","name":"Burelli, Paolo","orcid":"0000-0003-2804-9028","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Leonie","key":"kallabispau","last":"Kallabis","name":"Kallabis, Leonie","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"David","key":"melhartpau","last":"Melhart","name":"Melhart, David","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.4230/dagrep.14.6.130","status":"p","title":"Report from Dagstuhl Seminar 24261"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["itu-65ded193-a440-4d60-b714-236e7a2f576c"],"src":["ITU IT University of Copenhagen"],"title":"Introducing AI Experience: Games UX in the Age of Generative AI","type":"Report Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-789554","year":"2024","yearsub":"2024"}
{"abstract":"Face Emotion Recognition (FER) is a foundational human skill crucial for social interactions and understanding others' mental states. The use of eye tracking as a tool for investigating FER has provided valuable insights into the underlying cognitive processes. In this study, we adopted an instructionless paradigm, collecting eye movement data from 21 participants to explore two distinct FER processes: free viewing and grounded FER. We extracted fixational, pupillary, and microsaccadic events from eye movements and demonstrated their correlation with emotion perception and individual participant performance in the grounded task. By defining regions of interest on the face, we delved into the role of eye-gaze strategies in face processing and its connection to the presented emotions and emotion perception performance. During the free viewing phase, participants revealed distinct attention patterns for the different emotions. In the grounded FER tasks, participants interpreted emotions based on words, allowing for the assessment of performance and context. Interestingly, the participants' gaze patterns during free viewing were predictive of their success in the grounded FER tasks, emphasizing the importance of initial gaze behavior in emotion perception. We leveraged features from pre-trained deep-learning models for face recognition to analyze attention during free viewing, enhancing scalability and comparability across datasets and populations. This approach also enabled the prediction and modeling of individual emotion perception performance from limited observations. Our study contributes to a deeper understanding of the relationship between eye movements and emotion perception, with implications for psychology, human-computer interaction, and affective computing. Furthermore, it opens avenues for the development of precise emotion recognition systems.","author_count":3,"contributors":["Seikavandi, Meisam Jamshidi","Barrett, Maria Jung","Burelli, Paolo"],"cuid":["S01-000.00-789566"],"filters":{"added":"2025-02","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Eye tracking","Face Emotion Recognition","Gaze","Human Computer Interaction"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"modeling face emotion perception from naturalistic face viewing insights from fixational events and gaze strategies","src":["itu"],"src-code":["DI-U-ITU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/107930553/DL_Book_Chapter.pdf","version":"Pre-print"},"id":"S01-000.00-789566","ids":["itu-a5116a6f-5baf-4130-8314-2b6b2eafea80"],"keyword":["Eye Tracking","Face Emotion Recognition","Gaze","Human Computer Interaction"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-B2A2EFDE1DB8CE532A477A6F33EB82DD"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/107930553/DL_Book_Chapter.pdf","version":"Pre-print"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Play, Culture, and AI, brAIn lab"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Meisam Jamshidi","key":"seikavandipau","last":"Seikavandi","locid":"0080607f-9f26-4f73-a974-36b4940fb777","name":"Seikavandi, Meisam Jamshidi","orcid":"0000-0002-1271-2481","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Maria Jung","key":"barrettpau","last":"Barrett","locid":"ffc6db77-95ed-452f-92ac-ca143a9db73c","name":"Barrett, Maria Jung","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Paolo","key":"burellipau","last":"Burelli","locid":"cf5e1d64-5489-4534-ba34-8dba5fd354a6","name":"Burelli, Paolo","orcid":"0000-0003-2804-9028","rank":3,"rolecode":"pau"}],"pub":{"isbn":["9781032944623"],"publisher":"Taylor & Francis","status":"p","subtitle":"New Techniques and Practical Examples","title":"Recent Advances in Deep Learning Applications","volume":"1"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-a5116a6f-5baf-4130-8314-2b6b2eafea80"],"src":["ITU IT University of Copenhagen"],"title":"Modeling Face Emotion Perception from Naturalistic Face Viewing: Insights from Fixational Events and Gaze Strategies","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-789566","year":"2024","yearsub":"2024"}
{"abstract":"Accurately quantifying player experience is challenging for many reasons: identifying a ground truth and building validated and reliable scales are both challenging tasks; on top of that, empirical results are often moderated by individual factors. In this study, we investigate the impact of individual differences in the operationalisation of player experience by cross-referencing multiple modalities (i.e. questionnaires, gameplay and heart rate) and identifying the interplay between their scales","author_count":3,"contributors":["Frost Jensen, Maj","Dixen, Laurits","Burelli, Paolo"],"cuid":["S01-000.00-718910"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Cross referencing modalities","Individual differences","Operationalisation","Player Experience","Quantification"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"hades again and again a study on frustration tolerance physiology and player experience","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.48550/arXiv.2401.14878","version":"Pre-print"},"id":"S01-000.00-718910","ids":["itu-bdf9b4f9-9914-4dde-9854-7fec5e4d1efd"],"keyword":["Cross-referencing modalities","Individual differences","Operationalisation","Player experience","Quantification"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-5-8726CF0B64FABF54A138175273260310"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/100051885/IEEE_COG_2023_Hades.pdf","version":"Pre-print"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.48550/arXiv.2401.14878","version":"Pre-print"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Play, Culture, and AI, Creative AI Lab"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Maj","key":"frostjensenpau","last":"Frost Jensen","name":"Frost Jensen, Maj","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Laurits","key":"dixenpau","last":"Dixen","locid":"e20164d2-7e0c-4f05-88be-ca477dfc5f8c","name":"Dixen, Laurits","orcid":"0009-0001-4447-5222","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Paolo","key":"burellipau","last":"Burelli","locid":"cf5e1d64-5489-4534-ba34-8dba5fd354a6","name":"Burelli, Paolo","orcid":"0000-0003-2804-9028","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.48550/arxiv.2401.14878","eisbn":["9783031549670"],"issn":["03029743"],"publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","subtitle":"Proceedings of ACG 2023","title":"Lecture Notes in Computer Science","volume":"14528"},"review":"Peer Reviewed","scoID":["2-s2.0-85187704008"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-bdf9b4f9-9914-4dde-9854-7fec5e4d1efd"],"src":["ITU IT University of Copenhagen"],"title":"Hades Again and Again: A Study on Frustration Tolerance, Physiology and Player Experience","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-718910","year":"2024","yearsub":"2024"}
{"abstract":"Studies on software tutoring systems for complex learning have shown that confusion has a beneficial relationship with the learning experience and student engagement (Arguel et al., 2017). Causing confusion can prevent boredom while signs of confusion can serve as a signal of genuine learning and as a predecessor for frustration. There is little to no research on the role of confusion in early childhood education and playful learning, as these studies primarily focus on high school and university students during complex learning tasks. Despite that, the field acknowledges that confusion may be caused by inconsistency between information and a student’s internal model referred to as cognitive disequilibrium known from the theory of cognitive development, which was originally theorized based on observational studies on young children (D’Mello and Graesser, 2012). Therefore, there is reason to expect that the virtues of confusion also apply to young children engaging in learning activities, such as playful learning. To investigate the role of confusion in playful learning, we conducted an observational study, in which the behavior and expressed emotions of young children were collected by familiar pedagogues, using a web app, while they engaged with playful learning games designed for kindergartens. The expressed emotions were analyzed using a likelihood metric to determine the likely transitions between emotions (D’Mello and Graesser, 2012). The preliminary results showed that during short play sessions, children express confusion, frustration, and boredom. Furthermore, the observed emotional transitions were matched with previously established models of affect dynamics during complex learning. We argue that games with a learning objective can benefit by purposely confusing the player and how the player’s confusion may be managed to improve the learning experience.","author_count":2,"contributors":["Volden, Thomas Vase Schultz","Burelli, Paolo"],"cuid":["S01-000.00-776374"],"filters":{"added":"2025-01","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Affective Computing","Early childhood education","Playful learning"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"children s expressed emotions during playful learning games","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"doi","url":"https://doi.org/10.34190/ecgbl.18.1.2635","version":"Published Version"},"id":"S01-000.00-776374","identifier":[{"id":"85212947972","type":"scopus"}],"ids":["itu-19dd2ef9-15d7-4e0d-907e-b79f6ea87448"],"keyword":["Academic Emotions","Affect Dynamics","Affective Computing","Early Childhood Education","Playful Learning"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-703B65F51C1030C8B6DF99E8EFB9E89B"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"doi","url":"https://doi.org/10.34190/ecgbl.18.1.2635","version":"Published Version"},{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://papers.academic-conferences.org/index.php/ecgbl/article/view/2635/2559","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Play, Culture, and AI, Creative AI Lab"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Thomas Vase Schultz","key":"voldenpau","last":"Volden","locid":"7e884581-3d40-42e6-af12-453e052c9c87","name":"Volden, Thomas Vase Schultz","orcid":"0009-0009-2177-5482","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Paolo","key":"burellipau","last":"Burelli","locid":"cf5e1d64-5489-4534-ba34-8dba5fd354a6","name":"Burelli, Paolo","orcid":"0000-0003-2804-9028","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.34190/ecgbl.18.1.2635","eisbn":["9781917204200"],"isbn":["9781917204194"],"status":"p","title":"European Conference on Game Based Learning","volume":"18"},"review":"Peer Reviewed","scoID":["2-s2.0-85212947972"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-19dd2ef9-15d7-4e0d-907e-b79f6ea87448"],"src":["ITU IT University of Copenhagen"],"title":"Children’s expressed emotions during playful learning games","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-776374","year":"2024","yearsub":"2024"}
{"abstract":"Videogames have been a catalyst for advances in many research fields, such as artificial intelligence, human-computer interaction, or virtual reality. Over the years, research in fields such as artificial intelligence has enabled the design of new types of games, while games have often served as a powerful tool for testing and simulation. Can this also happen with neuroscience? What is the current relationship between neuroscience and games research? what can we expect from the future? In this article, we’ll try to answer these questions, analysing the current state-of-the-art at the crossroads between neuroscience and games and envisioning future directions.","author_count":2,"contributors":["Burelli, Paolo","Dixen, Laurits"],"cuid":["S01-000.00-776397"],"event":{"acronym":"CIG","title":"IEEE Conference on Computational Intelligence and Games"},"filters":{"added":"2025-01","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Accuracy and Precision","Biological system modeling","Games","Neuroimaging","Neuroscience","Solid modeling","Video games"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"playing with neuroscience past present and future of neuroimaging and games","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/103214159/IEEE_CoG_2024_Playing_with_Neuroscience_Vision_6_.pdf","version":"Pre-print"},"id":"S01-000.00-776397","ids":["itu-488fa670-bbb9-4c1d-9029-414f2f38523c"],"keyword":["Accuracy and Precision","Biological system modeling","Games","Neuroimaging","Neuroscience","Solid modeling","Video games"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-B266C693F1EF2913833D68F632798692"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/103214159/IEEE_CoG_2024_Playing_with_Neuroscience_Vision_6_.pdf","version":"Pre-print"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Digital Design, Play, Culture and AI Section","IT University of Copenhagen, Play, Culture, and AI, brAIn lab"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Paolo","key":"burellipau","last":"Burelli","locid":"cf5e1d64-5489-4534-ba34-8dba5fd354a6","name":"Burelli, Paolo","orcid":"0000-0003-2804-9028","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Laurits","key":"dixenpau","last":"Dixen","locid":"e20164d2-7e0c-4f05-88be-ca477dfc5f8c","name":"Dixen, Laurits","orcid":"0009-0001-4447-5222","rank":2,"rolecode":"pau"}],"pub":{"eisbn":["9798350350678"],"isbn":["9798350350685"],"publisher":"IEEE","status":"p","title":"IEEE Conference on Games 2024"},"review":"Peer Reviewed","scoID":["2-s2.0-85203545892"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-488fa670-bbb9-4c1d-9029-414f2f38523c"],"src":["ITU IT University of Copenhagen"],"title":"Playing With Neuroscience: Past, Present and Future of Neuroimaging and Games","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-776397","year":"2024","yearsub":"2024"}
{"abstract":"Scaling laws for large language models (LLMs) have allowed LLMs to achieve dramatic improvements in prediction accuracy and generative quality as the depth of their architectures (the number of layers, and of learnable parameters) and the breadth of their training datasets (ever larger subsets of the world-wide-web) grow in size and ambition (Kaplan et al., 2020). This impressive scaling allows LLMs to be applied to tasks that seem to demand more than mere gap-filling or next-word-prediction in text. However, the old truism, popularized by Stan Lee of Marvel Comics, that “with great power comes great responsibility” seems increasingly apt as LLMs grow in generative power. Their ability to produce novel and imaginative responses to arbitrary prompts– one might even say “creative” responses– gives them the ability to amuse and inform, but also an ability to misinform and offend. With the subtle and contextualized generalizations derived from their large training sets, and encoded in their large parameter sets, these models learn the best and the worst of the human condition. This duality, the ability to be used for good or (perhaps unintentionally) for ill, gives us pause when considering the role that LLMs might play in a new generation of computer games. This working group, which explored the topic of “smaller, safer language models for games”, explored whether smaller LLMs (so-called SLMs), with smaller and more selective training sets, can mitigate some of the concerns that are foreseen in a games context. The f indings of our group are briefly summarized in the following sub-sections.","author_count":6,"contributors":["Veale, Tony","Burelli, Paolo","Hoover, Amy K","Liapis, Antonios","Mountain, Gwaredd","Skubch, Hendrik"],"cuid":["S01-000.00-789536"],"filters":{"added":"2025-02","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Asia, East","Europe, EU","OECD"],"country":["Ireland","Japan","Malta","United States"],"glorg":["All Global Affiliations","New Jersey Institute of Technology","Square Enix","University College Dublin","University of Malta"],"keyword":["Game AI","Large Language Models","Scaling laws"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"nr","rtype":["clu"],"sorti":"small safe llms for in game generation","src":["itu"],"src-code":["DI-U-ITU"],"type":"dra","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.4230/DagRep.14.6.130","version":"Published Version"},"id":"S01-000.00-789536","ids":["itu-02c04371-43a6-4dba-a1d8-59a1ddb71f4b"],"keyword":["AI safety","game AI","large language models","scaling laws","smaller language models"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-3-EC545C25F1B8D62E69290096D67EA461"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.4230/DagRep.14.6.130","version":"Published Version"}],"org":[{"affno":"1","country":"ie","key":"university college dublin","loc":["Ireland","Europe, EU","OECD"],"name":"University College Dublin","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Play, Culture, and AI, Creative AI Lab","IT University of Copenhagen, Play, Culture, and AI, brAIn lab"],"nora_code":"DI-U-ITU","used":1},{"affno":"3","country":"us","key":"new jersey institute of technology","loc":["United States","America, North","OECD"],"name":"New Jersey Institute of Technology","used":1},{"affno":"4","country":"mt","key":"university of malta","loc":["Malta","Europe, EU"],"name":"University of Malta","used":1},{"affno":"5","country":"jp","key":"square enix","loc":["Japan","Asia, East","OECD"],"name":"Square Enix","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Tony","key":"vealepau","last":"Veale","name":"Veale, Tony","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Paolo","key":"burellipau","last":"Burelli","locid":"cf5e1d64-5489-4534-ba34-8dba5fd354a6","name":"Burelli, Paolo","orcid":"0000-0003-2804-9028","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Amy K","key":"hooverpau","last":"Hoover","name":"Hoover, Amy K","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Antonios","key":"liapispau","last":"Liapis","name":"Liapis, Antonios","rank":4,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Gwaredd","key":"mountainpau","last":"Mountain","name":"Mountain, Gwaredd","rank":5,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Hendrik","key":"skubchpau","last":"Skubch","name":"Skubch, Hendrik","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.4230/dagrep.14.6.130","pages":"206-208","status":"p","title":"Report from Dagstuhl Seminar 24261"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-02c04371-43a6-4dba-a1d8-59a1ddb71f4b"],"src":["ITU IT University of Copenhagen"],"title":"Small, Safe LLMs for In-Game Generation","type":"Report Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-789536","year":"2024","yearsub":"2024"}
{"abstract":"The Uncanny Valley phenomenon refers to the feeling of unease that arises when interacting with characters that appear almost, but not quite, human-like. First theorised by Masahiro Mori in 1970, it has since been widely observed in different contexts from humanoid robots to video games, in which it can result in players feeling uncomfortable or disconnected from the game, leading to a lack of immersion and potentially reducing the overall enjoyment. The phenomenon has been observed and described mostly through behavioural studies based on self-reported scales of uncanny feeling: however, there is still no consensus on its cognitive and perceptual origins, which limits our understanding of its impact on player experience. In this paper, we present a study aimed at identifying the mechanisms that trigger the uncanny response by collecting and analysing both self-reported feedback and EEG data. Index Terms—Uncanny Valley, Virtual Characters, Video Games, EEG, ERP, Survey, Perception, Cognition","author_count":3,"contributors":["Gorlini, Chiara","Dixen, Laurits","Burelli, Paolo"],"cuid":["S01-000.00-718833"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Italy"],"glorg":["All Global Affiliations","Polytechnic University of Milan"],"keyword":["Behavioural Studies","Cognitive Origins","Cognitive and Perceptual Origins","EEG Data","ERP","Human Computer Interaction","Human like Characters","Humanoid robots","Masahiro Mori","Perceptual Mechanisms","Player Feedback","Player Immersion","Self reported Scales","Uncanny Valley","Video Game Experience"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"investigating the uncanny valley phenomenon through the temporal dynamics of neural responses to virtual characters","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/100050924/IEEE_COG_2023_Uncanny_Valley_EEG_3_.pdf","version":"Other Version"},"id":"S01-000.00-718833","identifier":[{"id":"85180556743","type":"scopus"}],"ids":["itu-1c828948-693c-48e1-aaff-83894a1b75f7"],"keyword":["Behavioural Studies","Cognitive Origins","Cognitive and Perceptual Origins","EEG Data","ERP","Human-Computer Interaction","Human-like Characters","Humanoid Robots","Masahiro Mori","Perceptual Mechanisms","Player Feedback","Player Immersion","Self-reported Scales","Uncanny Valley","Video Game Experience"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-1A9EA8DEE3F1264E7A6E2A6E81B60D54"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/100050924/IEEE_COG_2023_Uncanny_Valley_EEG_3_.pdf","version":"Other Version"}],"org":[{"affno":"1","country":"it","key":"polytechnic university of milan","loc":["Italy","Europe, EU","OECD"],"name":"Polytechnic University of Milan","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Play, Culture, and AI, Creative AI Lab"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Chiara","key":"gorlinipau","last":"Gorlini","name":"Gorlini, Chiara","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Laurits","key":"dixenpau","last":"Dixen","locid":"e20164d2-7e0c-4f05-88be-ca477dfc5f8c","name":"Dixen, Laurits","orcid":"0009-0001-4447-5222","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Paolo","key":"burellipau","last":"Burelli","locid":"cf5e1d64-5489-4534-ba34-8dba5fd354a6","name":"Burelli, Paolo","orcid":"0000-0003-2804-9028","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1109/cog57401.2023.10333130","eisbn":["9798350322774"],"isbn":["9798350322781"],"publisher":"IEEE","series":"Proceedings of the 2023 IEEE conference on Games","status":"p","title":"Proceedings of the IEEE Conference on Game"},"review":"Peer Reviewed","scoID":["2-s2.0-85180556743"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-1c828948-693c-48e1-aaff-83894a1b75f7"],"src":["ITU IT University of Copenhagen"],"title":"Investigating the Uncanny Valley Phenomenon Through the Temporal Dynamics of Neural Responses to Virtual Characters","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-718833","year":"2023","yearsub":"2023"}
{"abstract":"Game difficulty is a crucial aspect of game design, that can be directly influenced by tweaking game mechanics. Perceived difficulty can however also be influenced by simply altering the graphics to something more threatening. Here, we present a study with 12 participants playing 4 different minigames with either altered graphics or mechanics to make the game more difficult. Using EEG bandpower analysis, we find that frontal lobe activity was heightened in all 4 of the mechanically challenging versions and in 2/4 of the visually altered versions, all differences that did not emerge from the self-reported player experience. This suggests that EEG could researchers with a more sensitive tool for investigating challenge in games.","author_count":4,"contributors":["Hegedues, Christine","Dias Constantino, João Pedro","Dixen, Laurits","Burelli, Paolo"],"cuid":["S01-000.00-718916"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Challenge Measurement","EEG Bandpower Analysis","Frontal Lobe Activity","Game Difficulty","Game Mechanics","Game design","Neurogaming Research","Perceived Difficulty","Player Experience","Visual Alterations"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"investigating perceived and mechanical challenge in games through cognitive activity","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/100051620/IEEE_COG_2023_Hades_1_.pdf","version":"Pre-print"},"id":"S01-000.00-718916","identifier":[{"id":"85180549906","type":"scopus"}],"ids":["itu-c7a73d9d-2dcd-4cbb-86e7-76b0639a56a4"],"keyword":["Challenge Measurement","EEG Bandpower Analysis","Frontal Lobe Activity","Game Design","Game Difficulty","Game Mechanics","Neurogaming Research","Perceived Difficulty","Player Experience","Visual Alterations"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-A41B198D57540787FAD3E3FA805C88F4"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/100051620/IEEE_COG_2023_Hades_1_.pdf","version":"Pre-print"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Play, Culture, and AI, Creative AI Lab"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Christine","key":"hegeduespau","last":"Hegedues","name":"Hegedues, Christine","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"João Pedro","key":"diasconstantinopau","last":"Dias Constantino","name":"Dias Constantino, João Pedro","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Laurits","key":"dixenpau","last":"Dixen","locid":"e20164d2-7e0c-4f05-88be-ca477dfc5f8c","name":"Dixen, Laurits","orcid":"0009-0001-4447-5222","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Paolo","key":"burellipau","last":"Burelli","locid":"cf5e1d64-5489-4534-ba34-8dba5fd354a6","name":"Burelli, Paolo","orcid":"0000-0003-2804-9028","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1109/cog57401.2023.10333149","eisbn":["9798350322774"],"isbn":["9798350322781"],"publisher":"IEEE","series":"Proceedings of the 2023 IEEE conference on Games","status":"p","title":"Proceedings of the IEEE Conference on Game"},"review":"Peer Reviewed","scoID":["2-s2.0-85180549906"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-c7a73d9d-2dcd-4cbb-86e7-76b0639a56a4"],"src":["ITU IT University of Copenhagen"],"title":"Investigating Perceived and Mechanical Challenge in Games Through Cognitive Activity","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-718916","year":"2023","yearsub":"2023"}
{"abstract":"This short paper focuses on procedurally generating rules and communicating them to players to adjust the difficulty. This is part of a larger project to collect and adapt games in educational games for young children using a digital puzzle game designed for kindergartens. A genetic algorithm is used together with a difficulty measure to find a target number of solution sets and a large language model is used to communicate the rules in a narrative context. During testing the approach was able to find rules that approximate any given target difficulty within two dozen generations on average. The approach was combined with a large language model to create a narrative puzzle game where players have to host a dinner for animals that can't get along. Future experiments will try to improve evaluation, specialize the language model on children's literature, and collect multi-modal data from players to guide adaptation.","author_count":3,"contributors":["Volden, Thomas Vase Schultz","Grbic, Djordje","Burelli, Paolo"],"cuid":["S01-000.00-718832"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Difficulty adjustment","Educational games","Genetic algorithm","Large Language Models","Procedural Generation"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"procedurally generating rules to adapt difficulty for narrative puzzle games","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.48550/arXiv.2307.05518","version":"Published Version"},"id":"S01-000.00-718832","identifier":[{"id":"85180554237","type":"scopus"}],"ids":["itu-1a158d41-175f-41ff-a1b9-08edad2f7bcd"],"keyword":["difficulty adjustment","educational games","genetic algorithm","large language models","procedural generation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-5-B34EC7EEDC9D83C5801381727E6815BF"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/100051811/IEEE_COG_2023_Yoli_Short.pdf","version":"Pre-print"},{"access":"oa","type":"doi","url":"https://doi.org/10.48550/arXiv.2307.05518","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Play, Culture, and AI, Creative AI Lab"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Thomas","key":"voldenpau","last":"Volden","locid":"7e884581-3d40-42e6-af12-453e052c9c87","name":"Volden, Thomas Vase Schultz","name_org":"Volden, Thomas","orcid":"0009-0009-2177-5482","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Djordje","key":"grbicpau","last":"Grbic","locid":"c596539b-3ceb-497c-9a43-e71d6b0f65a6","name":"Grbic, Djordje","orcid":"0000-0002-4388-2539","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Paolo","key":"burellipau","last":"Burelli","locid":"cf5e1d64-5489-4534-ba34-8dba5fd354a6","name":"Burelli, Paolo","orcid":"0000-0003-2804-9028","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.48550/arxiv.2307.05518","eisbn":["9798350322774"],"isbn":["9798350322781"],"pages":"1-4","publisher":"IEEE","series":"Proceedings of the 2023 IEEE conference on Games","status":"p","title":"Proceedings of the IEEE Conference on Game"},"review":"Peer Reviewed","scoID":["2-s2.0-85180554237"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-1a158d41-175f-41ff-a1b9-08edad2f7bcd"],"src":["ITU IT University of Copenhagen"],"title":"Procedurally generating rules to adapt difficulty for narrative puzzle games","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-718832","year":"2023","yearsub":"2023"}
{"abstract":"The accurate and personalized estimation of task difficulty provides many opportunities for optimizing user experience. However, user diversity makes such difficulty estimation hard, in that empirical measurements from some user sample do not necessarily generalize to others. In this paper, we contribute a new approach for personalized difficulty estimation of game levels, borrowing methods from content recommendation. Using factorization machines (FM) on a large dataset from a commercial puzzle game, we are able to predict difficulty as the number of attempts a player requires to pass future game levels, based on observed attempt counts from earlier levels and levels played by others. In addition to performance and scalability, FMs offer the benefit that the learned latent variable model can be used to study the characteristics of both players and game levels that contribute to difficulty. We compare the approach to a simple non-personalized baseline and a personalized prediction using Random Forests. Our results suggest that FMs are a promising tool enabling game designers to both optimize player experience and learn more about their players and the game.","author_count":4,"contributors":["Kristensen, Jeppe Theiss","Guckelsberger, Christian","Burelli, Paolo","Hämäläinen, Perttu"],"cuid":["S01-000.00-382992"],"event":{"acronym":"UIST","title":"ACM Symposium on User Interface Software and Technology"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Finland"],"glorg":["Aalto University","All Global Affiliations"],"keyword":["Factorization machines","Game level prediction","Latent variable model","Personalized difficulty estimation","User experience optimization"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"personalized game difficulty prediction using factorization machines","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://pure.itu.dk/ws/files/87056876/view.pdf","version":"Authors Final Version"},"id":"S01-000.00-382992","identifier":[{"id":"85141635857","type":"scopus"}],"ids":["itu-74f074f4-8d80-454c-b05a-7c3afcff1d8e"],"keyword":["Factorization machines","Game level prediction","Latent variable model","Personalized difficulty estimation","User experience optimization"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-7F5984CFB03C968F367099910EA23C3D"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://pure.itu.dk/ws/files/87056876/view.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Play, Culture, and AI, Creative AI Lab"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"fi","key":"aalto university","loc":["Finland","Europe, EU","Nordic","OECD"],"name":"Aalto University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jeppe Theiss","key":"kristensenpau","last":"Kristensen","name":"Kristensen, Jeppe Theiss","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Christian","key":"guckelsbergerpau","last":"Guckelsberger","name":"Guckelsberger, Christian","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Paolo","key":"burellipau","last":"Burelli","locid":"cf5e1d64-5489-4534-ba34-8dba5fd354a6","name":"Burelli, Paolo","orcid":"0000-0003-2804-9028","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Perttu","key":"hämäläinenpau","last":"Hämäläinen","name":"Hämäläinen, Perttu","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1145/3526113.3545624","issn":["00000040"],"journal":"UIST: User Interface Software and Technology","pages":"1-13","paperid":"88","status":"p","title":"UIST: User Interface Software and Technology"},"review":"Peer Reviewed","scoID":["2-s2.0-85141635857"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-74f074f4-8d80-454c-b05a-7c3afcff1d8e"],"src":["ITU IT University of Copenhagen"],"title":"Personalized Game Difficulty Prediction Using Factorization Machines","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382992","year":"2022","yearsub":"2022"}
{"abstract":"Successful and accurate modelling of level difficulty is a fundamental component of the operationalisation of player experience as difficulty is one of the most important and commonly used signals for content design and adaptation. In games that feature intermediate milestones, such as completable areas or levels, difficulty is often defined by the probability of completion or completion rate; however, this operationalisation is limited in that it does not describe the behaviour of the player within the area. In this research work, we formalise a model of level difficulty for puzzle games that goes beyond the classical probability of success. We accomplish this by describing the distribution of actions performed within a game level using a parametric statistical model thus creating a richer descriptor of difficulty. The model is fitted and evaluated on a dataset collected from the game Lily’s Garden by Tactile Games, and the results of the evaluation show that the it is able to describe and explain difficulty in a vast majority of the levels.","author_count":3,"contributors":["Kristensen, Jeppe Theiss","Burelli, Paolo","Valdivia, Arturo"],"cuid":["S01-000.00-382321"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Completion rate","Player Experience","Puzzle games","Statistical model","level difficulty modeling"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-PR-OTH","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"statistical modelling of level difficulty in puzzle games","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://ieee-cog.org/2021/assets/papers/paper_205.pdf","version":"Published Version"},"id":"S01-000.00-382321","ids":["itu-469ec823-eb1d-43ec-b77c-8969371865f3"],"keyword":["completion rate","level difficulty modeling","player experience","puzzle games","statistical model"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-4E21E7C7610D6AE082F9CBA1282B6B56"],"oa_link":[{"access":"oa","type":"rem","url":"https://ieee-cog.org/2021/assets/papers/paper_205.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["Tactile Entertainment A/S"],"nora_code":"DI-PR-OTH","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jeppe Theiss","key":"kristensenpau","last":"Kristensen","name":"Kristensen, Jeppe Theiss","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Paolo","key":"burellipau","last":"Burelli","locid":"cf5e1d64-5489-4534-ba34-8dba5fd354a6","name":"Burelli, Paolo","orcid":"0000-0003-2804-9028","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Arturo","key":"valdiviapau","last":"Valdivia","name":"Valdivia, Arturo","rank":3,"rolecode":"pau"}],"pub":{"publisher":"IEEE","status":"p","title":"Proceedings of the 2021 IEEE Conference on Games (CoG)"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Other Companies","Private Research","Universities","tactile entertainment a/s"],"PST":["Published"]},"sid":["itu-469ec823-eb1d-43ec-b77c-8969371865f3"],"src":["ITU IT University of Copenhagen"],"title":"Statistical Modelling of Level Difficulty in Puzzle Games","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382321","year":"2021","yearsub":"2021"}
{"abstract":"While traditionally a labour intensive task, the testing of game content is progressively becoming more automated. Among the many directions in which this automation is taking shape, automatic play-testing is one of the most promising thanks also to advancements of many supervised and reinforcement learning (RL) algorithms. However these type of algorithms, while extremely powerful, often suffer in production environments due to issues with reliability and transparency in their training and usage. In this research work we are investigating and evaluating strategies to apply the popular RL method Proximal Policy Optimization (PPO) in a casual mobile puzzle game with a specific focus on improving its reliability in training and generalization during game playing. We have implemented and tested a number of different strategies against a real-world mobile puzzle game (Lily's Garden from Tactile Games). We isolated the conditions that lead to a failure in either training or generalization during testing and we identified a few strategies to ensure a more stable behaviour of the algorithm in this game genre.","author_count":2,"contributors":["Kristensen, Jeppe Theiss","Burelli, Paolo"],"cuid":["S01-000.00-381419"],"event":{"acronym":"FGD(?)","end":"2020-09-18","place":"Malta, mt","start":"2020-09-16","title":"FDG 2020: Foundations of Digitale Games","year":"2020"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Algorithm generalization","Automatic play testing","Game AI","Game content testing","Machine learning algorithms","Mobile puzzle games","Reinforcement learning","Reliability in training","Supervised learning","proximal policy optimization PPO"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"strategies for using proximal policy optimization in mobile puzzle games","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85512701/FDG2020_PPO_In_Production.pdf","version":"Authors Final Version"},"id":"S01-000.00-381419","ids":["itu-0ac5f325-7672-47b3-9155-60527ae15661"],"keyword":["Algorithm generalization","Automatic play-testing","Game AI","Game content testing","Machine learning algorithms","Mobile puzzle games","Proximal Policy Optimization (PPO)","Reinforcement learning","Reliability in training","Supervised learning"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-5-B75C133A0D8C139E8BFA151B5AAD24CC"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85512701/FDG2020_PPO_In_Production.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jeppe Theiss","key":"kristensenpau","last":"Kristensen","name":"Kristensen, Jeppe Theiss","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Paolo","key":"burellipau","last":"Burelli","locid":"cf5e1d64-5489-4534-ba34-8dba5fd354a6","name":"Burelli, Paolo","orcid":"0000-0003-2804-9028","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1145/3402942","eisbn":["9781450388078"],"publisher":"Association for Computing Machinery","status":"p","title":"Proceedings of the International Conference on the Foundations of Digital Games"},"review":"Peer Reviewed","scoID":["2-s2.0-85092303804"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-0ac5f325-7672-47b3-9155-60527ae15661"],"src":["ITU IT University of Copenhagen"],"title":"Strategies for Using Proximal Policy Optimization in Mobile Puzzle Games","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381419","year":"2020","yearsub":"2020"}
{"abstract":"Personas are models of users that incorporate motivations, wishes, and objectives; These models are employed in user-centred design to help design better user experiences and have recently been employed in adaptive systems to help tailor the personalized user experience. Designing with personas involves the production of descriptions of fictitious users, which are often based on data from real users. The majority of data-driven persona development performed today is based on qualitative data from a limited set of interviewees and transformed into personas using labour-intensive manual techniques. In this study, we propose a method that employs the modelling of user stereotypes to automate part of the persona creation process and addresses the drawbacks of the existing semi-automated methods for persona development. The description of the method is accompanied by an empirical comparison with a manual technique and a semi-automated alternative (multiple correspondence analysis). The results of the comparison show that manual techniques differ between human persona designers leading to different results. The proposed algorithm provides similar results based on parameter input, but was more rigorous and will find optimal clusters, while lowering the labour associated with finding the clusters in the dataset. The output of the method also represents the largest variances in the dataset identified by the multiple correspondence analysis.","author_count":4,"contributors":["Korsgaard, Dannie Michael","Bjørner, Thomas","Sørensen, Pernille Krog","Burelli, Paolo"],"cuid":["S01-000.00-109479"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Ethnography","Mixed method","Older adults","Persona","Subspace clustering"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-AAU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"creating user stereotypes for persona development from qualitative data through semi automatic subspace clustering","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/440717302/UMUI_D_19_00007_accepted_manuscript.pdf","version":"Authors Final Version"},"id":"S01-000.00-109479","identifier":[{"id":"85077529989","type":"scopus"}],"ids":["aau-ccd3d67b-cfee-4fe4-bc37-e0c360d95525"],"keyword":["Ethnography","Mixed method","Older adults","Persona","Subspace clustering"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-5-F28EA5918C90344F88636B128E284AA8"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/440717302/UMUI_D_19_00007_accepted_manuscript.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science, VR Light","Aalborg University, The Technical Faculty of IT and Design","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology, MeCIS - Media Cognition and Interactive Systems","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology, Section for Media Technology - Campus Copenhagen","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology, The Center for Applied Game Research"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Dannie Michael","key":"korsgaardpau","last":"Korsgaard","locid":"652a335f-c760-4736-a788-11ecbbba31b3","name":"Korsgaard, Dannie Michael","orcid":"0000-0002-0067-4203","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Thomas","key":"bjørnerpau","last":"Bjørner","locid":"65c6cc27-0e30-49d1-aa84-7cbc986fa9e1","name":"Bjørner, Thomas","orcid":"0000-0001-9071-7168","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Pernille Krog","key":"sørensenpau","last":"Sørensen","locid":"a4943a18-af9c-4f8b-bc0f-83c3494ea15f","name":"Sørensen, Pernille Krog","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Paolo","key":"burellipau","last":"Burelli","name":"Burelli, Paolo","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1007/s11257-019-09252-5","issn":["09241868","15731391"],"issn_org":["09241868"],"issue":"1","journal":"User Modeling and User-Adapted Interaction","pages":"81-125","publisher":"Springer","status":"p","title":"User Modeling and User-Adapted Interaction","volume":"30"},"review":"Peer Reviewed","scoID":["2-s2.0-85077529989"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["aau-ccd3d67b-cfee-4fe4-bc37-e0c360d95525"],"src":["AAU Aalborg University"],"title":"Creating user stereotypes for persona development from qualitative data through semi-automatic subspace clustering","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-109479","year":"2020","yearsub":"2020"}
{"abstract":"In this work we investigate whether it is plausibleto use the performance of a reinforcement learning (RL) agentto estimate the difficulty measured as the player completion rateof different levels in the mobile puzzle game Lily’s Garden.For this purpose we train an RL agent and measure thenumber of moves required to complete a level. This is thencompared to the level completion rate of a large sample of realplayers.We find that the strongest predictor of player completion ratefor a level is the number of moves taken to complete a level of the∼5% best runs of the agent on a given level. A very interestingobservation is that, while in absolute terms, the agent is unable toreach human-level performance across all levels, the differencesin terms of behaviour between levels are highly correlated to thedifferences in human behaviour. Thus, despite performing sub-par, it is still possible to use the performance of the agent toestimate, and perhaps further model, player metrics","author_count":3,"contributors":["Kristensen, Jeppe Theiss","Valdivia, Arturo","Burelli, Paolo"],"cuid":["S01-000.00-381261"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Human Agent Behaviour Comparison","Mobile puzzle games","Performance prediction","Player Completion Rate","Reinforcement learning"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"estimating player completion rate in mobile puzzle games using reinforcement learning","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85512749/IEEE_COG_2020_SHORT_Plausibility_of_using_subpar_agents_2.pdf","version":"Authors Final Version"},"id":"S01-000.00-381261","identifier":[{"id":"85096928248","type":"scopus"}],"ids":["itu-00e4b270-e1e6-4b80-9752-30103614f7b4"],"keyword":["Human-Agent Behaviour Comparison","Mobile Puzzle Games","Performance Prediction","Player Completion Rate","Reinforcement Learning"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-1E211B5135D8D0A71C0584D6DCEF79DB"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85512749/IEEE_COG_2020_SHORT_Plausibility_of_using_subpar_agents_2.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jeppe Theiss","key":"kristensenpau","last":"Kristensen","name":"Kristensen, Jeppe Theiss","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Arturo","key":"valdiviapau","last":"Valdivia","name":"Valdivia, Arturo","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Paolo","key":"burellipau","last":"Burelli","locid":"cf5e1d64-5489-4534-ba34-8dba5fd354a6","name":"Burelli, Paolo","orcid":"0000-0003-2804-9028","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1109/cog47356.2020.9231581","eisbn":["9781728145334"],"isbn":["9781728145341"],"publisher":"IEEE","status":"p","title":"2020 IEEE Conference on Games (CoG)"},"review":"Peer Reviewed","scoID":["2-s2.0-85096928248"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-00e4b270-e1e6-4b80-9752-30103614f7b4"],"src":["ITU IT University of Copenhagen"],"title":"Estimating Player Completion Rate in Mobile Puzzle Games Using Reinforcement Learning","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381261","year":"2020","yearsub":"2020"}
{"abstract":"In this article, we present an experimental approach to using parameterized Generative Adversarial Networks (GANs) to produce levels for the puzzle game Lily’s Garden1. We extract two condition-vectors from the real levels in an effort to control the details of the GAN’s outputs. While the GANs performs well in approximating the first condition (map-shape), they struggle to approximate the second condition (piece distribution). We hypothesize that this might be improved by trying out alternative architectures for both the Generator and Discriminator of the GANs.","author_count":4,"contributors":["Hald, Andreas","Stuckermann Hansen, Jens","Kristensen, Jeppe Theiss","Burelli, Paolo"],"cuid":["S01-000.00-382108"],"event":{"acronym":"FGD(?)","end":"2020-09-18","place":"Malta, mt","start":"2020-09-16","title":"FDG 2020: Foundations of Digitale Games","year":"2020"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Conditional GAN Control","Generative Adversarial Networks","Map Shape Condition","Piece Distribution Challenge","Puzzle Game Levels"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"procedural content generation of puzzle games using conditional generative adversarial networks","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85512880/PCG_Parametric_GANS.pdf","version":"Authors Final Version"},"id":"S01-000.00-382108","identifier":[{"id":"85092286056","type":"scopus"}],"ids":["itu-390fd2a8-9fc1-4630-98c7-e4691cf744ef"],"keyword":["Conditional GAN Control","Generative Adversarial Networks","Map-Shape Condition","Piece Distribution Challenge","Puzzle Game Levels"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-353A46DF0F84973EFB86B4BB0FB85A0C"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85512880/PCG_Parametric_GANS.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Andreas","key":"haldpau","last":"Hald","name":"Hald, Andreas","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jens","key":"stuckermannhansenpau","last":"Stuckermann Hansen","name":"Stuckermann Hansen, Jens","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jeppe Theiss","key":"kristensenpau","last":"Kristensen","name":"Kristensen, Jeppe Theiss","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Paolo","key":"burellipau","last":"Burelli","locid":"cf5e1d64-5489-4534-ba34-8dba5fd354a6","name":"Burelli, Paolo","orcid":"0000-0003-2804-9028","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1145/3402942.3409601","eisbn":["9781450388078"],"publisher":"Association for Computing Machinery","status":"p","title":"FDG '20: International Conference on the Foundations of Digital Games"},"review":"Peer Reviewed","scoID":["2-s2.0-85092286056"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-390fd2a8-9fc1-4630-98c7-e4691cf744ef"],"src":["ITU IT University of Copenhagen"],"title":"Procedural Content Generation of Puzzle Games using Conditional Generative Adversarial Networks","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382108","year":"2020","yearsub":"2020"}
{"abstract":"Personas are models of users that incorporate motivations, wishes and objectives; These models are employed in user-centred design to help design better user experiences and have recently been employed in adaptive systems to help tailor the personalised user experience. Designing with personas involves the production of descriptions of fictitious users, which are often based on data from real users. The majority of data-driven persona development performed today is based on qualitative data from a limited set of interviewees and transformed into personas using labour-intensive manual techniques. In this study, we propose a method that employs the modelling of user stereotypes to automate part of the persona creation process and addresses the drawbacks of the existing semi-automated methods for persona development. The description of the method is accompanied by an empirical comparison with a manual technique and a semi-automated alternative (multiple correspondence analysis). The results of the comparison show that manual techniques differ between human persona designers leading to different results. The proposed algorithm provides similar results based on parameter input, but was more rigorous and will find optimal clusters, while lowering the labour associated with finding the clusters in the dataset. The output of the method also represents the largest variances in the dataset identified by the multiple correspondence analysis.","author_count":4,"contributors":["Korsgaard, Dannie Michael","Bjørner, Thomas","Sørensen, Pernille Søgaard","Burelli, Paolo"],"cuid":["S01-000.00-382252"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Ethnography","Mixed method","Older adults","Persona","Subspace clustering"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-AAU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"applying subspace clustering to semi automate cooperian persona development based on interview data","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s11257-019-09252-5","version":"Published Version"},"id":"S01-000.00-382252","identifier":[{"id":"85077529989","type":"scopus"}],"ids":["itu-424628aa-66cf-440e-a2dd-95fa2f32eaa4"],"keyword":["ethnography","mixed method","older adults","persona","subspace clustering"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-5-F28EA5918C90344F88636B128E284AA8"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s11257-019-09252-5","version":"Published Version"},{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84827968/subspace_personas_UMUAI_final.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"dk","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Dannie Michael","key":"korsgaardpau","last":"Korsgaard","name":"Korsgaard, Dannie Michael","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thomas","key":"bjørnerpau","last":"Bjørner","name":"Bjørner, Thomas","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Pernille Søgaard","key":"sørensenpau","last":"Sørensen","name":"Sørensen, Pernille Søgaard","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Paolo","key":"burellipau","last":"Burelli","locid":"cf5e1d64-5489-4534-ba34-8dba5fd354a6","name":"Burelli, Paolo","orcid":"0000-0003-2804-9028","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1007/s11257-019-09252-5","issn":["09241868","15731391"],"issn_org":["09241868"],"journal":"User Modeling and User-Adapted Interaction","pages":"1-45","publisher":"Springer","status":"p","title":"User Modeling and User-Adapted Interaction"},"review":"Peer Reviewed","scoID":["2-s2.0-85077529989"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-424628aa-66cf-440e-a2dd-95fa2f32eaa4"],"src":["ITU IT University of Copenhagen"],"title":"Applying subspace clustering to semi-automate Cooperian persona development based on interview data","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382252","year":"2020","yearsub":"2020"}
{"abstract":"As game companies embrace increasingly a service oriented business model, the need for predictive models of player behaviour becomes more pressing. Various activities, such as user acquisition, live game operations or game design need to be supported with information about the choices made by the players and the choices they could make in the future. This is especially true in the context of free-to-play games, where the absence of a pay wall and the erratic nature of the players' playing and spending behaviour make predictions about the revenue and allocation of budget and resources extremely challenging. In this chapter we will present and overview of customer lifetime value modelling across different fields, we will introduce the challenges specific to free-to-play games across different platforms and genres and we will discuss the state-of-the-art solutions with practical examples and references to existing implementations.","author_count":1,"contributors":["Burelli, Paolo"],"cuid":["S01-000.00-383375"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"1 contributor","cluster_size":1,"keyword":["Customer Lifetime Value Modelling","Free to Play Games","Game analytics","Player Behaviour Prediction","Service Oriented Business Model"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"predicting customer lifetime value in free to play games","src":["itu"],"src-code":["DI-U-ITU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85122969248","version":"Other Version"},"id":"S01-000.00-383375","identifier":[{"id":"85122969248","type":"scopus"}],"ids":["itu-8f2465d2-86d9-4e38-b959-5f0a3789330b"],"keyword":["Customer Lifetime Value Modelling","Free-to-Play Games","Game Analytics","Player Behaviour Prediction","Service-Oriented Business Model"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-372830CDAA4FD5E8064854F414698886"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Paolo","key":"burellipau","last":"Burelli","locid":"cf5e1d64-5489-4534-ba34-8dba5fd354a6","name":"Burelli, Paolo","orcid":"0000-0003-2804-9028","rank":1,"rolecode":"pau"}],"pub":{"isbn":["9781138104433"],"publisher":"Taylor & Francis","series":"Data Analytics Applications","status":"p","title":"Data Analytics Applications in Gaming and Entertainment"},"review":"Peer Reviewed","scoID":["2-s2.0-85122969248"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-8f2465d2-86d9-4e38-b959-5f0a3789330b"],"src":["ITU IT University of Copenhagen"],"title":"Predicting Customer Lifetime Value in Free-to-Play Games","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383375","year":"2019","yearsub":"2019"}
{"author_count":4,"contributors":["Nakashima, Tomoharu","Gravina, Daniele","Burelli, Paolo","Thawonmas, Ruck"],"cuid":["S01-000.00-383572"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Asia, East","Europe, EU","Nordic","OECD"],"country":["Japan","Sweden"],"glorg":["All Global Affiliations","Ericsson","Osaka Prefecture University","Ritsumeikan University"],"level":"com","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"nr","rtype":["clu"],"sorti":"general ai game commentary","src":["itu"],"src-code":["DI-U-ITU"],"type":"dr","type-grp":["all","pub"]},"id":"S01-000.00-383572","ids":["itu-9e396ccd-2598-4233-bbaf-e454f38cad15"],"lang":"English","level":"Commissioned","mra":["Science/Technology"],"noi":["Local-1-1-0B333707B49EF2614FCD4B2C9317D994"],"org":[{"affno":"1","country":"jp","key":"osaka prefecture university","loc":["Japan","Asia, East","OECD"],"name":"Osaka Prefecture University","used":1},{"affno":"2","country":"se","key":"ericsson","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Ericsson","used":1},{"affno":"3","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1},{"affno":"4","country":"jp","key":"ritsumeikan university","loc":["Japan","Asia, East","OECD"],"name":"Ritsumeikan University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Tomoharu","key":"nakashimapau","last":"Nakashima","name":"Nakashima, Tomoharu","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Daniele","key":"gravinapau","last":"Gravina","name":"Gravina, Daniele","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Paolo","key":"burellipau","last":"Burelli","locid":"cf5e1d64-5489-4534-ba34-8dba5fd354a6","name":"Burelli, Paolo","orcid":"0000-0003-2804-9028","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Ruck","key":"thawonmaspau","last":"Thawonmas","name":"Thawonmas, Ruck","rank":4,"rolecode":"pau"}],"pub":{"publisher":"National Institute of Informatics","status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-9e396ccd-2598-4233-bbaf-e454f38cad15"],"src":["ITU IT University of Copenhagen"],"title":"General AI Game Commentary","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383572","year":"2019","yearsub":"2019"}
{"abstract":"In freemium games, the revenue from a player comes from the in-app purchases made and the advertisement to which that player is exposed. The longer a player is playing the game, the higher will be the chances that he or she will generate a revenue within the game. Within this scenario, it is extremely important to be able to detect promptly when a player is about to quit playing (churn) in order to react and attempt to retain the player within the game, thus prolonging his or her game lifetime. In this article we investigate how to improve the current state-of-the-art in churn prediction by combining sequential and aggregate data using different neural network architectures. The results of the comparative analysis show that the combination of the two data types grants an improvement in the prediction accuracy over predictors based on either purely sequential or purely aggregated data.","author_count":2,"contributors":["Kristensen, Jeppe Theiss","Burelli, Paolo"],"cuid":["S01-000.00-382517"],"event":{"acronym":"CIG","title":"IEEE Conference on Computational Intelligence and Games"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Aggregate data","Churn prediction","Freemium games","Neural network architectures","Sequential data"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"combining sequential and aggregated data for churn prediction incasual freemium games","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84438416/main.pdf","version":"Authors Final Version"},"id":"S01-000.00-382517","identifier":[{"id":"85073122660","type":"scopus"}],"ids":["itu-53485f37-441b-42c4-aadb-3bed8975b104"],"keyword":["Aggregate data","Churn prediction","Freemium games","Neural network architectures","Sequential data"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-C4D2FE86A500CD565C23A7DFD2B86B39"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84438416/main.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jeppe Theiss","key":"kristensenpau","last":"Kristensen","name":"Kristensen, Jeppe Theiss","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Paolo","key":"burellipau","last":"Burelli","locid":"cf5e1d64-5489-4534-ba34-8dba5fd354a6","name":"Burelli, Paolo","orcid":"0000-0003-2804-9028","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1109/cig.2019.8848106","eisbn":["9781728118840"],"isbn":["9781728118857"],"publisher":"IEEE","status":"p","title":"Proceedings of the IEEE Conference on Games"},"review":"Peer Reviewed","scoID":["2-s2.0-85073122660"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-53485f37-441b-42c4-aadb-3bed8975b104"],"src":["ITU IT University of Copenhagen"],"title":"Combining Sequential and Aggregated Data for Churn Prediction inCasual Freemium Games","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382517","year":"2019","yearsub":"2019"}
