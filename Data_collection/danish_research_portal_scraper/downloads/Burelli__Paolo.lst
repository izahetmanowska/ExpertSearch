dy","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Sarune","key":"baceviciutepedh","last":"Baceviciute","name":"Baceviciute, Sarune","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-319-27036-4_18","eisbn":["9783319270364"],"isbn":["9783319270357"],"issn":["03029743"],"pages":"189-201","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","subtitle":"8th International Conference on Interactive Digital Storytelling, ICIDS 2015, Copenhagen, Denmark, November 30 - December 4, 2015, Proceedings","title":"Interactive Storytelling"},"review":"Peer Reviewed","scoID":["2-s2.0-84951871469"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-3575054c-f9c4-4f92-8945-6d0b98677295"],"src":["AAU Aalborg University"],"title":"Connecting the Dots : Quantifying the Narrative Experience in Interactive Media","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-065579","year":"2015","yearsub":"2015"}
{"abstract":"In this article, we present our efforts to try to increase cohesiveness and connectivity between quests generated by a recreation of an existing procedural quest generation system, with an addition of a progressive tier system called Quality System. A study gave strong indications that the Quality System successfully produced a positive effect on the feeling of cohesiveness and connectivity between the generated quests amongst Role-playing- and Massively Multiplayer Online games players.","author_count":8,"contributors":["Brogaard Buus, Daniel","Eland, Morten Vestergaard","Lystlund, Rasmus","Burelli, Paolo"],"cuid":["S01-000.00-059749"],"event":{"acronym":"ICIDS","end":"2015-12-04","place":"Copenhagen, dk","start":"2015-11-30","title":"8th International Conference on Interactive Digital Storytelling, ICIDS 2015","year":"2015"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"the quality system an attempt to increase cohesiveness between quest givers and quest types","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-059749","identifier":[{"id":"84951871794","type":"scopus"}],"ids":["aau-215318ce-f97f-49f7-b50f-4f61b53866d1"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-AC4B02371B89808C56EE07B858533227"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (TECH)","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Daniel","key":"brogaardbuuspau","last":"Brogaard Buus","locid":"de0450a8-9970-4588-a466-7cc329f7717b","name":"Brogaard Buus, Daniel","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Morten Vestergaard","key":"elandpau","last":"Eland","locid":"a12a8a20-09b8-404f-a87b-38bfb0972d45","name":"Eland, Morten Vestergaard","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rasmus","key":"lystlundpau","last":"Lystlund","locid":"e9c9ac0d-0769-4172-9041-16d1e8d5bc5a","name":"Lystlund, Rasmus","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Paolo","key":"burellipau","last":"Burelli","locid":"2953eb79-ca31-48d9-a3ef-f93554bacede","name":"Burelli, Paolo","orcid":"0000-0003-2804-9028","rank":4,"rolecode":"pau"},{"affno":"","first":"Henrik","key":"schoenaufogpedh","last":"Schoenau-Fog","name":"Schoenau-Fog, Henrik","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Luis Emilio","key":"brunipedh","last":"Bruni","name":"Bruni, Luis Emilio","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Sandy","key":"louchartpedh","last":"Louchart","name":"Louchart, Sandy","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Sarune","key":"baceviciutepedh","last":"Baceviciute","name":"Baceviciute, Sarune","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-319-27036-4_41","eisbn":["9783319270364"],"isbn":["9783319270357"],"issn":["03029743"],"pages":"381-384","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","subtitle":"8th International Conference on Interactive Digital Storytelling, ICIDS 2015, Copenhagen, Denmark, November 30 - December 4, 2015, Proceedings","title":"Interactive Storytelling"},"review":"Peer Reviewed","scoID":["2-s2.0-84951871794"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-215318ce-f97f-49f7-b50f-4f61b53866d1"],"src":["AAU Aalborg University"],"title":"The Quality System : An Attempt to Increase Cohesiveness Between Quest Givers and Quest Types","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-059749","year":"2015","yearsub":"2015"}
{"abstract":"The design of an interactive narrative begins with the choice of a type of story. In this paper I examine the potential of three kinds of plot for active user participation: the epic plot, which focuses on the struggle of the individual to survive in a hostile world, the dramatic plot, which deals with the evolution of a network of human relations, and the epistemic plot, which is propelled by the desire to solve a mystery. I distinguish two basic types of immersionludic and narrative, the latter subdivided into spatial, temporal and emotional variants, and I discuss the ability of the three kinds of plot to generate these various forms of immersion.","author_count":4,"contributors":["Hannesson, Hákon Jarl","Reimann-Andersen, Thorbjørn","Burelli, Paolo","Bruni, Luis Emilio"],"cuid":["S01-000.00-383841"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Closure","Computer games","Emergent narrative","Experienced narrative","Immersion","Interactive narrative","Narrative research","Narrative transport","Quantifying emergent narrative"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-AAU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"connecting the dots quantifying the narrative experience in interactive media","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/18844464169","version":"Other Version"},"id":"S01-000.00-383841","identifier":[{"id":"4520227","type":"pmid"},{"id":"18844464169","type":"scopus"}],"ids":["itu-b088c5cf-b0ae-4f40-90dc-33d74e47e8b0"],"keyword":["Closure","Computer games","Emergent narrative","Experienced narrative","Immersion","Interactive narrative","Narrative research","Narrative transport","Quantifying emergent narrative"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-5-390889E02962475032C23204AF05DAA3"],"org":[{"affno":"1","country":"dk","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Hákon Jarl","key":"hannessonpau","last":"Hannesson","name":"Hannesson, Hákon Jarl","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thorbjørn","key":"reimannandersenpau","last":"Reimann-Andersen","name":"Reimann-Andersen, Thorbjørn","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Paolo","key":"burellipau","last":"Burelli","locid":"cf5e1d64-5489-4534-ba34-8dba5fd354a6","name":"Burelli, Paolo","orcid":"0000-0003-2804-9028","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Luis Emilio","key":"brunipau","last":"Bruni","name":"Bruni, Luis Emilio","rank":4,"rolecode":"pau"}],"pmid":["4520227"],"pub":{"doi":"10.1007/978-3-319-27036-4_18","issn":["00010782","10591192"],"issn_org":["00010782"],"journal":"Communications of the ACM","pages":"189-201","publisher":"Association for Computing Machinery","status":"p","title":"Communications of the ACM","title_org":"Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)"},"review":"Peer Reviewed","scoID":["2-s2.0-84951871469"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-b088c5cf-b0ae-4f40-90dc-33d74e47e8b0"],"src":["ITU IT University of Copenhagen"],"title":"Connecting the dots: Quantifying the narrative experience in interactive media","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383841","year":"2015","yearsub":"2015"}
{"abstract":"Cinematographic games are a rising genre in the computer games industry and an increasing number of titles published include some aspects of cinematography in the gameplay or the storytelling. At present state, camera handling in computer games is managed primarily through custom scripts and animations and there is an inverse relationship between player freedom and cinematographic quality. In this paper, we present a description of a series of technical challenges connected with the development of an automatic camera control library for computer games and we showcase a set of algorithmic and engineering solutions.","author_count":1,"contributors":["Burelli, Paolo"],"cuid":["S01-000.00-073995"],"event":{"end":"2015-05-04","place":"Zurich, ch","start":"2015-05-04","title":"Eurographics Workshop on Intelligent Cinematography and Editing","year":"2015"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"implementing game cinematography technical challenges and solutions for automatic camera control in games","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/212227117/camon.pdf","version":"Pre-print"},"id":"S01-000.00-073995","ids":["aau-5270aae9-b1d9-496b-aef4-7b5a77ac7bd2"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-0442DB84D9F290123C1BBC9E145A5519"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/212227117/camon.pdf","version":"Pre-print"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (TECH)","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology, Light Research","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology, The Augmented Cognition Lab","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology, The Center for Applied Game Research"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Paolo","key":"burellipau","last":"Burelli","locid":"2953eb79-ca31-48d9-a3ef-f93554bacede","name":"Burelli, Paolo","orcid":"0000-0003-2804-9028","rank":1,"rolecode":"pau"}],"pub":{"doi":"10.2312/wiced.20151080","eisbn":["9783905674798"],"publisher":"European Association for Computer Graphics","status":"p","title":"Eurographics Workshop on Intelligent Cinematography and Editing"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-5270aae9-b1d9-496b-aef4-7b5a77ac7bd2"],"src":["AAU Aalborg University"],"title":"Implementing Game Cinematography : Technical Challenges and Solutions for Automatic Camera Control in Games","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-073995","year":"2015","yearsub":"2015"}
{"abstract":"Automatically animating and placing the virtual camera in a dynamic environment is a challenging task. The camera is expected to maximise and maintain a set of properties — i.e. visual composition — while smoothly moving through the environment and avoiding obstacles. A large number of different solutions to the problem have been proposed so far including, for instance, evolutionary techniques, swarm intelligence or ad hoc solutions. However, the large diversity of the solutions and the lack of a common benchmark, made any comparative analysis of the different solutions extremely difficult. For this reason, in this paper, we propose a benchmark for the problem of virtual camera control and we analyse a number of different problems in different virtual environments. Each of these scenarios is described through a set of complexity measures and, as a result of this analysis, a subset of scenarios is selected as the core of the benchmark.","author_count":4,"contributors":["Burelli, Paolo","Yannakakis, Georgios N."],"cuid":["S01-000.00-074140"],"event":{"acronym":"EvoApplications","end":"2015-04-10","place":"Copenhagen, dk","start":"2015-04-08","title":"18th Conference on the Applications of Evolutionary Computation 2015","year":"2015"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU"],"country":["Malta"],"glorg":["All Global Affiliations","University of Malta"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"a benchmark for virtual camera control","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/228081217/burelli.pdf","version":"Pre-print"},"id":"S01-000.00-074140","identifier":[{"id":"84925854274","type":"scopus"}],"ids":["aau-52f9f5f0-3b88-4e44-b790-01b7f9b94406"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-5-CC04E474B7B46551A4C0BDE26E5D9350"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/228081217/burelli.pdf","version":"Pre-print"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (TECH)","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology, Light Research","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology, The Augmented Cognition Lab","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology, The Center for Applied Game Research"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"mt","key":"university of malta","loc":["Malta","Europe, EU"],"name":"University of Malta","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Paolo","key":"burellipau","last":"Burelli","locid":"2953eb79-ca31-48d9-a3ef-f93554bacede","name":"Burelli, Paolo","orcid":"0000-0003-2804-9028","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Georgios N.","key":"yannakakispau","last":"Yannakakis","name":"Yannakakis, Georgios N.","rank":2,"rolecode":"pau"},{"affno":"","first":"A. M.","key":"morapedh","last":"Mora","name":"Mora, A. M.","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"G.","key