tals","Miscellaneous","Novo Nordisk","Other Hospitals","Other Research","Private Research","Universities","University of Copenhagen","University of Southern Denmark","danish diabetes academy"],"PST":["Published"]},"sid":["aau-c82f79ec-c84b-42ea-b5f5-c35702f4dc01","au-9a1452d1-d07c-480f-a392-0bd3bf61ee7c","ku-cc8da0b1-5e7b-46a4-b3c4-9c128786b6b6","sdu-d959c2b0-36e3-4df0-bfdb-23aa3e00469d"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Genetic drivers of heterogeneity in type 2 diabetes pathophysiology","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-091.61-724337","year":"2024","yearsub":"2024"}
{"abstract":"Patients admitted for acute medical conditions and major noncardiac surgery are at risk of myocardial injury. This is frequently asymptomatic, especially in the context of concomitant pain and analgesics, and detection thus relies on cardiac biomarkers. Continuous single-lead ST-segment monitoring from wireless electrocardiogram (ECG) may enable more timely intervention, but criteria for alerts need to be defined to reduce false alerts. This study aimed to determine optimal ST-deviation thresholds from wireless single-lead ECG for detection of myocardial injury following major abdominal cancer surgery and during acute exacerbation of chronic obstructive pulmonary disease. Patients were monitored with a wireless single-lead ECG patch for up to 4 days and had daily troponin measurements. Single-lead ST-segment deviations of <0.255 mV and/or >0.245 mV (based on previous study comparison with 0.1 mV 12-lead ECG and variation in single-lead ECG) were analyzed for relation to myocardial injury defined as hsTnT elevation of 20–64 ng/L with an absolute change of ≥5 ng/L, or a hsTnT level ≥ 65 ng/L. In total, 528 patients were included for analysis, of which 15.5% had myocardial injury. For corrected ST-thresholds lasting ≥10 and ≥ 20 min, we found specificities of 91% and 94% and sensitivities of 17% and 13% with odds ratios of 2.0 (95% CI: 1.1; 3.9) and 2.4 (95% CI: 1.1; 5.1) for myocardial injury. In conclusion, wireless single-lead ECG monitoring with corrected ST thresholds detected patients developing myocardial injury with specificities >90% and sensitivities <20%, suggesting increased focus on sensitivity improvement.","author_count":7,"contributors":["Starling, Jonathan Attilla Koefoed","Haahr-Raunkjaer, Camilla","Rasmussen, Søren S.","Ekenberg, Luna","Loft, Frederik Cornelius","Meyhoff, Christian S.","Aasvang, Eske K."],"cuid":["S02-088.24-768195"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Starling, Jonathan Attilla Koefoed"],"keyword":["Myocardial injury","Non cardiac surgery","ST deviations","Troponin T","single lead ECG"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"wireless continuous single lead st segment monitoring to detect new onset myocardial injury at the general ward an exploratory subanalysis","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1111/aas.14391","version":"Published Version"},"id":"S02-088.24-768195","identifier":[{"id":"85186918523","type":"scopus"},{"id":"38425057","type":"pmid"}],"ids":["dtu-2f3c02fb-1833-4c1f-81fc-da2a9fcc6ce5","ku-8b065cb3-a563-4972-9b29-3bdf9ae83d2f"],"keyword":["ST-deviations","myocardial injury","non-cardiac surgery","single-lead ECG","troponin T"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-538FC2E517E06AD556A7966C884A433E"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/382998152/Acta_Anaesthesiol_Scand_-_2024_-_Starling_-_Wireless_continuous_single_lead_ST_segment_monitoring_to_detect_new_onset.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1111/aas.14391","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://curis.ku.dk/ws/files/391884911/Acta_Anaesthesiol_Scand_2024_Starling_Wireless_continuous_single_lead_ST_segment_monitoring_to_detect_new_onset.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Health Technology","Technical University of Denmark, Department of Health Technology, Digital Health","Technical University of Denmark, Department of Health Technology, Digital Health, Personalized Health Technology"],"nora_code":"DI-U-DTU","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Anaesthesiology","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Jonathan Attilla Koefoed","key":"starlingpau","last":"Starling","name":"Starling, Jonathan Attilla Koefoed","rank":1,"rolecode":"pau"},{"affno":"1","first":"Camilla","key":"haahrraunkjaerpau","last":"Haahr-Raunkjaer","name":"Haahr-Raunkjaer, Camilla","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Søren S.","key":"rasmussenpau","last":"Rasmussen","locid":"8eb944f2-234b-4c0b-ab67-ba07620c814f","name":"Rasmussen, Søren M.","name_org":"Rasmussen, Søren S.","orcid":"0000-0002-6297-2871","rank":3,"rolecode":"pau"},{"affno":"1","first":"Luna","key":"ekenbergpau","last":"Ekenberg","name":"E