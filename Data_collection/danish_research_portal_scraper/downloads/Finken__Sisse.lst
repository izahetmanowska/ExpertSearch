me":"Finken, Sisse","orcid":"0000-0001-7792-7216","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Christina","key":"mörtbergpau","last":"Mörtberg","name":"Mörtberg, Christina","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Anita","key":"mirijamdotterpau","last":"Mirijamdotter","name":"Mirijamdotter, Anita","rank":3,"rolecode":"pau"}],"pub":{"publisher":"Linnaeus University Press","status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-811a6628-84aa-42f8-bd25-807a1dcc1b8a"],"src":["ITU IT University of Copenhagen"],"title":"Editorial : Dilemmas 2015 Papers from the 18th annual International Conference Dilemmas for Human Services: Organizing, Designing and Managing","type":"Other-Unknown","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383161","year":"2017","yearsub":"2017"}
{"abstract":"Awareness is a concept familiar to specialists within the field of Computer Supported Cooperative Work (CSCW). It is superior for analysing and describing some of the ad hoc work activities that unfold in cooperation. Such informal activities are outside the scope of engineers’ formal models, which are created to tackle challenges concerning human activities and their social interactions with regards to safety concerns in operation. This paper draws on fieldwork conducted in a marine setting of offshore operations. It presents an attempt to visualise the importance of cooperative work activities that shape computer systems. The aim, thus, is to portray cooperative work in a way that can be valuable for engineers implementing marine technology. We do so by way of presenting a transferring technique (2T) using insights from the CSCW field and Actor Network Theory (ANT).","author_count":2,"contributors":["Pan, Yushan","Finken, Sisse"],"cuid":["S01-000.00-382165"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, Non-EU","Nordic","OECD"],"country":["Norway"],"glorg":["All Global Affiliations","Norwegian University of Science and Technology"],"keyword":["ANT","Awareness","CSCW","Offshore operations"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"visualising actor network for cooperative systems in marine technology","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82454230/HCC12_final_report.pdf","version":"Authors Final Version"},"id":"S01-000.00-382165","identifier":[{"id":"84984940526","type":"scopus"}],"ids":["itu-3cd80c15-ec57-4506-91ff-f0295cf65703"],"keyword":["ANT","Awareness","CSCW","Offshore operations"],"lan