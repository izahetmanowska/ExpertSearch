y of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-85f7b1db-34b3-4924-ba01-9217fe49465d"],"src":["ITU IT University of Copenhagen"],"title":"Notes on smart bee-ing and un/natured technologies","type":"Other-Unknown","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383238","year":"2019","yearsub":"2019"}
{"abstract":"Abstract: This paper focuses on the process of translating insights from a Computer Supported Cooperative Work (CSCW)-based study, conducted on a vessel at sea, into a model that can assist systems developers working with simulators, which are used by vessel operators for training purposes on land. That is, the empirical study at sea brought about rich insights into cooperation, which is important for systems developers to know about and consider in their designs. In the paper, we establish a model that primarily consists of a ‘computational artifact’. The model is designed to support researchers working with systems developers. Drawing on marine examples, we focus on the translation process and investigate how the model serves to visualize work activities; how it addresses relations between technical and computational artifacts, as well as between functions in technical systems and functionalities in cooperative systems. In turn, we link design back to fieldwork studies.","author_count":2,"contributors":["Pan, Yushan","Finken, Sisse"],"cuid":["S01-000.00-381753"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, Non-EU","Nordic","OECD"],"country":["Norway"],"glorg":["All Global Affiliations","Norwegian University of Science and Technology"],"keyword":["Computer Supported Cooperative Work","Social computing","System design"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"from offshore operation to onshore simulator using visualized ethnographic outcomes to work with systems developers","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3390/informatics5010010","version":"Published Version"},"id":"S01-000.00-381753","identifier":[{"id":"85061286716","type":"scopus"}],"ids":["itu-2075442d-8cd7-485f-93cf-5e68a191bf56"],"keyword":["computer-supported cooperative work","social computing","system design"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-A5F6C8A970A0F2D736B70ACFB4A1D048"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.3390/informatics5010010","version":"Published Version"},{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84771158/informatics_05_00010_v3.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2019"},"org":[{"affno":"1","country":"no","key":"norwegian university of science and technology","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"Norwegian University of Science and Technology","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Technologies in Practice, Technologies in Practice"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Yushan","key":"panpau","last":"Pan","name":"Pan, Yushan","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Sisse","key":"finkenpau","last":"Finken","locid":"70f3c85a-9cd2-40b4-bed9-5e2a75609421","name":"Finken, Sisse","orcid":"0000-0001-7792-7216","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.3390/informatics5010010","issn":["22279709"],"issue":"10","journal":"Informatics","publisher":"MDPI AG","status":"p","title":"Informatics","volume":"5"},"review":"Peer Reviewed","scoID":["2-s2.0-85061286716"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-2075442d-8cd7-485f-93cf-5e68a191bf56"],"src":["ITU IT University of Copenhagen"],"title":"From Offshore Operation to Onshore Simulator: Using Visualized Ethnographic Outcomes to Work with Systems Developers","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381753","year":"2018","yearsub":"2019"}
{"abstract":"We draw on feminist technoscience to analyze actions and activities performed between participants in a Participatory Design workshop that unfolds in a realm of e-government. Stepping into this empirical site we want to show how participants (invited persons, researchers, methods, artifacts, gender stereotypes) become with each other. With such take on research endeavors we feed into current discussion in feminist research by illustrating how theory and practice intertwine and create realities.","author_count":7,"contributors":["Finken, Sisse","Mörtberg, Christina","Elovaara, Pirjo"],"cuid":["S01-000.00-381835"],"event":{"acronym":"IFIP WCC","title":"IFIP World Computer Congress"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Sweden"],"glorg":["All Global Affiliations","Blekinge Institute of Technology","Linnaeus University"],"keyword":["E government","Feminist Technoscience","Gender Stereotypes","Participatory Design","Theory Practice Integration"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"becoming with in participatory design","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83392421/FinkenMortbergElovaaraBecomingwithPDFinal.pdf","version":"Authors Final Version"},"id":"S01-000.00-381835","identifier":[{"id":"85053862382","type":"scopus"}],"ids":["itu-25aef658-b7ce-41ab-83d7-394e03e6b7f4"],"keyword":["E-Government","Feminist Technoscience","Gender Stereotypes","Participatory Design","Theory-Practice Integration"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-AD0B3DE02CDFE4498B24284EF3E2193D"],"oa_link":[{"access":"oa","type":"