"Jespersen, Astrid Pernille","orcid":"0000-0002-7583-1701","rank":22,"rolecode":"pau"},{"affno":"1","first":"Morten","key":"scheibyeknudsenmortenpau","last":"Scheibye-Knudsen","locid":"161fd11a-45bf-427a-8307-f111b06510bb","name":"Scheibye-Knudsen, Morten","rank":23,"rolecode":"pau"},{"affno":"2","first":"Anne Marie","key":"beckannemariepau","last":"Beck","name":"Beck, Anne Marie","rank":24,"rolecode":"pau"},{"affno":"1","first":"Niklas Rye","key":"jørgensenniklasryepau","last":"Jørgensen","locid":"3dc68a95-e26c-4b82-a4f0-7548313f8045","name":"Jørgensen, Niklas Rye","rank":25,"rolecode":"pau"}],"pub":{"issn":["13973290"],"newspaper":"Dagens Medicin","status":"p","title":"Dagens Medicin"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","All University Colleges","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","Hospitals","KP","Region Zealand","Technical University of Denmark","Universities","University Colleges","University of Copenhagen"],"PST":["Published"]},"sid":["ku-f8972099-9a85-43cc-be68-4090011c55fe"],"src":["KU University of Copenhagen"],"title":"Vi har brug for en national strategi for forskning i skrøbelige, ældre patienter","type":"Newspaper Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-820491","year":"2025","yearsub":"2025"}
{"abstract":"The enantioselective [4 + 4] cycloaddition for the construction of cyclooctanoids is a challenging transformation in organic chemistry. Herein, we present the first organocatalytic enantioselective [4 + 4] cycloaddition of furan ortho-quinodimethanes, activated by dearomatization of the heteroaromatic compound, which thereby allows for the cycloaddition with dienes. The [4 + 4] cycloaddition is catalyzed by a quinine-derived primary amine in combination with a chiral phosphoric acid and a carboxylic acid affording cyclooctanoids isolated as a single diastereoisomer in good yields and with up to 94% ee. This reaction concept allows for the formation of cyclooctanoids without benzofusion, as demonstrated by oxidative opening of the furan ring. Computational studies of the reaction mechanism for the [4 + 4] cycloaddition point to a stepwise process. Surprisingly, the stereochemical outcome of the reaction is attributed to protonation of the two organocatalyst-bound cyclooctanoid intermediates leading to a preferred set-up for catalyst elimination to account for the absolute configuration of the cyclooctanoid.","author_count":7,"contributors":["Østergaard, Niklas Lawaetz","Kristensen, Anne","Marcantonio, Enrico","Christensen, Mette Louise","Dudziński, Michał","McLeod, David","Jørgensen, Karl Anker"],"cuid":["S01-000.00-825528"],"filters":{"added":"2025-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Jørgensen, Karl Anker"],"keyword":["Asymmetric synthesis","Cycloaddition","Fused ring systems","Heterocycles","Organocatalysis"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"organocatalytic enantioselective 000000000004 000000000004 cycloadditions of furan ortho quinodimethanes","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1002/anie.202514300","version":"Published Version"},"id":"S01-000.00-825528","identifier":[{"id":"105014601991","type":"scopus"},{"id":"40883979","type":"pmid"}],"ids":["au-79771cc6-0b31-4845-b8bf-d839845f72ae"],"keyword":["Asymmetric synthesis","Cycloaddition","Fused-ring systems","Heterocycles","Organocatalysis"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-40E3206644632C578D1681AD43451DF0"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1002/anie.202514300","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Chemistry"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Niklas Lawaetz","key":"østergaardpau","last":"Østergaard","locid":"ce667101-a6ab-4f87-8747-59471ca1265c","name":"Østergaard, Niklas Lawaetz","orcid":"0000-0001-5586-9991","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anne","key":"kristensenpau","last":"Kristensen","locid":"2c62d321-2588-44f4-88c7-ebf510e19aa3","name":"Kristensen, Anne","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Enrico","key":"marcantoniopau","last":"Marcantonio","locid":"33d42d26-b015-46f6-95c1-d2278946d485","name":"Marcantonio, Enrico","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mette Louise","key":"skipperpau","last":"Skipper","locid":"cc259634-098b-4e9e-9d65-50fafde43e59","name":"Christensen, Mette Louise","name_org":"Skipper, Mette Louise","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Michał","key":"dudzińskipau","last":"Dudzińsk