t":"Jopling","name":"Jopling, Michael","rank":81,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Suzanne","key":"soohoosuzannepau","last":"SooHoo","name":"SooHoo, Suzanne","rank":82,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Nesta","key":"devinenestapau","last":"Devine","name":"Devine, Nesta","rank":83,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Sarah","key":"hayessarahpau","last":"Hayes","name":"Hayes, Sarah","rank":84,"rolecode":"pau"}],"pub":{"doi":"10.1007/s42438-021-00243-7","issn":["2524485X","25244868"],"issn_org":["25244868"],"journal":"Postdigital Science and Education","pages":"1073-1223","publisher":"Springer","status":"p","title":"Postdigital Science and Education","volume":"3"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-23c0f1a4-c4d9-462f-bac5-a9028eb601c9"],"src":["AAU Aalborg University"],"title":"Teaching in the Age of Covid-19 – 1 Year Later","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-060435","year":"2021","yearsub":"2021"}
{"abstract":"The hypocretin/orexin system regulates arousal through central nervous system mechanisms and plays an important role in sleep, wakefulness and energy homeostasis. It is unclear whether hypocretin peptides are also present in blood due to difficulties in measuring reliable and reproducible levels of the peptides in blood samples. Lack of hypocretin signalling causes the sleep disorder narcolepsy type 1, and low concentration of cerebrospinal fluid hypocretin-l/oreadn-A peptide is a hallmark of the disease. This measurement has high diagnostic value, but performing a lumbar puncture is not without discomfort and possible complications for the patient. A blood-based test to assess hypocretin-1 deficiency would therefore be of obvious benefit. We here demonstrate that heating plasma or scrum samples to 65 degrees C for 30 min at pH 8 significantly increases hypocretin-1 immunoreactivity enabling stable and reproducible measurement of hypocretin-1 in blood samples. Specificity of the signal was verified by high-performance liquid chromatography and by measuring blood samples from mice lacking hypocretin. Unspecific background signal in the assay was high. Using our method, we show that hypocretin-1 immunoreactivity in blood samples from narcolepsy type 1 patients does not differ from the levels detected in control samples. The data presented here suggest that hypocretin-1 is present in the blood stream in the low picograms per millilitres range and that peripheral hypocretin-1 concentrations are unchanged in narcolepsy type 1.","author_count":10,"contributors":["Aegidius, Helene M.","Kruse, Lars","Christensen, Gitte L.","Lorentzen, Marc P.","Jørgensen, Niklas Rye","Moresco, Monica","Pizza, Fabio","Plazzi, Giuseppe","Jennum, Poul","Kornum, Birgitte Rahbek"],"cuid":["S01-000.00-494813"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Italy"],"glorg":["All Global Affiliations","Osped Bellaria, IRCCS Istituto delle Scienze Neurologiche di Bologna (ISNB), IRCCS Bologna, Ist Sci Neurol","University of Bologna","University of Modena and Reggio Emilia"],"keyword":["CELLS","Expression","Hypocretin","Leptin","Narcolepsy type 1","Neurons","Neuropeptide","Orexin","Radioimmunoassay","Receptors"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"pre treatment of blood samples reveal normal blood hypocretin orexin signal in narcolepsy type i","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1093/braincomms/fcab050","version":"Published Version"},"id":"S01-000.00-494813","identifier":[{"id":"85113584272","type":"scopus"},{"id":"PMC8100001","type":"pmcid"},{"id":"33977264","type":"pmid"},{"id":"000667313900044","type":"wos"}],"ids":["ku-a9b43a32-b29f-45a6-b819-b63589930fcc"],"keyword":["CELLS","EXPRESSION","LEPTIN","NEURONS","NEUROPEPTIDE","PLASMA OREXIN-A","RECEPTORS","hypocretin","narcolepsy type 1","orexin","plasma hypocretin-1","radioimmunoassay"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-A369FDF4737D22E5FE5B9E123984B929"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1093/braincomms/fcab050","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/273811422/Pre_treatment_of_blood_samples_reveal_normal_blood_hypocretin_orexin_signal_in_narcolepsy_type_1.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Neuroscience, Neuronal Signalling"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","country":"it","key":"osped bellaria irccs istituto delle scienze neurologiche di bologna irccs bologna ist sci neurol","loc":["Italy","Europe, EU","OECD"],"name":"Osped Bellaria, IRCCS Istituto delle Scienze Neurologiche di Bologna (ISNB), IRCCS Bologna, Ist Sci Neurol","used":1},{"affno":"4","country":"it","key":"university of bologna","loc":["Italy","Europe, EU","OECD"],"name":"University of Bologna","used":1},{"affno":"5","country":"it","key":"university of modena and reggio emilia","loc":["Italy","Europe, EU","OECD"],"name":"University of Modena and Reggio Emilia","used":1}],"person":[{"affno":"1","country":"dk","first":"Helene M.","key":"aegidiuspau","last":"Aegidius","locid":"088f1995-b55c-4b7f-b100-eaae0faaecce","name":"Aegidius, Helene M.","rank":1,"rolecode":"pau"},{"affno":"","first":"Lars","key":"krusepau","last":"Kruse","name":"Kruse, Lars","rank":2,"rolecode":"pau"},{"affno":"","first":"Gitte L.","key":"christensenpau","last":"Christensen","name":"Christensen, Gitte L.","rank":3,"rolecode":"pau"},{"affno":"2","first":"Marc P.","key":"lorentzenpau","last":"Lorentzen","name":"Lorentzen, Marc P.","rank":4,"rolecode":"pau"},{"affno":"1","first":"Niklas R.","key":"jorgensenpau","last":"Jorgensen","locid":"3dc68a95-e26c-4b82-a4f0-7548313f8045","name":"Jørgensen, Niklas Rye","name_org":"Jorgensen, Niklas R.","rank":5,"rolecode":"pau"},{"affno":"3","first":"Monica","key":"morescopau","last":"Moresco","name":"Moresco, Monica","rank":6,"rolecode":"pau"},{"affno":"4","first":"Fabio","key":"pizzapau","last":"Pizza","name":"Pizza, Fabio","rank":7,"rolecode":"pau"},{"affno":"5","first":"Giuseppe","key":"plazzipau","last":"Plazzi","name":"Plazzi, Giuseppe","rank":8,"rolecode":"pau"},{"affno":"1","first":"Poul J.","key":"jennumpau","last":"Jennum","locid":"09499315-7437-47b1-a859-6783b0dd67c1","name":"Jennum, Poul","name_org":"Jennum, Poul J.","orcid":"0000-0001-6986-5254","rank":9,"rolecode":"pau"},{"affno":"1","first":"Birgitte R.","key":"kornumpau","last":"Kornum","locid":"4930e951-cb7c-4fdd-aba6-8dc9ed1d47c6","name":"Kornum, Birgitte Rahbek","name_org":"Kornum, Birgitte R.","orcid":"0000-0002-2515-9451","rank":10,"rolecode":"pau"}],"pmid":["33977264"],"pub":{"doi":"10.1093/braincomms/fcab050","issn":["26321297"],"issue":"2","journal":"Brain Communications","paperid":"050","status":"p","title":"Brain Communications","volume":"3"},"review":"Peer Reviewed","scoID":["2-s2.0-85113584272"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-a9b43a32-b29f-45a6-b819-b63589930fcc"],"src":["KU University of Copenhagen"],"title":"Pre-treatment of blood samples reveal normal blood hypocretin/orexin signal in narcolepsy type I","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-494813","year":"2021","yearsub":"2021"}
{"abstract":"Context: In healthy individuals, glucose-dependent insulinotropic polypeptide (GIP) enhances insulin secretion and reduces bone resorption by up to 25% estimated by absolute placebo-corrected changes in carboxy-terminal type 1 collagen crosslinks (CTX) during GIP and glucose administration. In patients with type 2 diabetes (T2D), GIP's insulinotropic effect is impaired and effects on bone may be reduced. Objective: To investigate GIP's effect on bone biomarkers in patients with T2D. Design: Randomized, double-blinded, crossover study investigating 6 interventions. Patients: Twelve male patients with T2D. Interventions: A primed continuous 90-minute GIP infusion (2 pmollkg/min) or matching placebo (saline) administered at 3 plasma glucose (PG) levels (i.e., paired days with \"insulin-induced hypoglycemia\" (PG lowered to 3 mmol/L), \"fasting hyperglycemia\" (mean PG similar to 8 mmol/L), or \"aggravated hyperglycemia\" (mean PG similar to 12 mmol/L). Main Outcome Measures: Bone biomarkers: CTX, procollagen type 1 N-terminal propeptide (P1NP) and PTH. Results: On days with insulin-induced hypoglycemia, CTX was suppressed by up to 40 +/- 15% during GIP administration compared with 12 +/- 11% during placebo infusion (P<0.0001). On days with fasting hyperglycemia, CTX was suppressed by up to 36 +/- 15% during GIP administration, compared with 0 +/- 9% during placebo infusion (P<0.0001). On days with aggravated hyperglycemia, CTX was suppressed by up to 47 +/- 23% during GIP administration compared with 10 +/- 9% during placebo infusion (P= 0.0005). At all glycemic levels, P1NP and PHI concentrations were similar between paired days after 90 minutes. Conclusions: Short-term GIP infusions reduce bone resorption by more than one-third (estimated by absolute placebo-corrected CTX reductions) in patients with T2DM, suggesting preserved bone effects of GIP in these patients. Precis: Short-term GIP infusions reduce the bone resorption marker CTX by one-third in patients with type 2 diabetes independent of glycemic levels. (C) Endocrine Society 2020.","author_count":6,"contributors":["Christensen, Mikkel Bring","Lund, Asger B.","Jørgensen, Niklas Rye","Holst, Jens Juul","Vilsbøll, Tina","Knop, Filip K."],"cuid":["S01-000.00-511087"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Bone markers","Gastric Inhibitory Polypeptide","Glucagon","Peptide","Secretion","Turnover","glucose dependent insulinotropic polypeptide GIP","procollagen type 1 N terminal propeptide P1NP"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"OT":["Steno Diabetes Centre, Gentofte, Denmark."],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"glucose dependent insulinotropic polypeptide gip reduces bone resorption in patients with type 000000000002 diabetes","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1210/jendso/bvaa097","version":"Published Version"},"id":"S01-000.00-511087","identifier":[{"id":"000577507800012","type":"wos"},{"id":"32904711","type":"pmid"},{"id":"PMC7458112","type":"pmcid"},{"id":"85096490416","type":"scopus"}],"ids":["ku-c526e854-5f8d-45e4-a583-4d7ca9884c44"],"keyword":["GLUCAGON","Gastric inhibitory polypeptide","PEPTIDE","SECRETION","TURNOVER","bone markers","carboxy-terminal collagen type 1 crosslinks (CTX)","glucose-dependent insulinotropic polypeptide (GIP)","procollagen type 1 N-terminal propeptide (P1NP)"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-F60DCFAE06C201D0DF4B35BAF4B3FC75"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1210/jendso/bvaa097","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/250484608/bvaa097.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Clinical Pharmacology","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Steno Diabetes Centre, Gentofte, Denmark."],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","first":"Mikkel B.","key":"christensenpau","last":"Christensen","locid":"4f5c91e2-3caa-4263-8d9c-df3bfdfbd31b","name":"Christensen, Mikkel Bring","name_org":"Christensen, Mikkel B.","rank":1,"rolecode":"pau"},{"affno":"2","first":"Asger B.","key":"lundpau","last":"Lund","name":"Lund, Asger B.","rank":2,"rolecode":"pau"},{"affno":"1","first":"Niklas R.","key":"jørgensenpau","last":"Jørgensen","locid":"3dc68a95-e26c-4b82-a4f0-7548313f8045","name":"Jørgensen, Niklas Rye","name_org":"Jørgensen, Niklas R.","rank":3,"rolecode":"pau"},{"affno":"1","first":"Jens J.","key":"holstpau","last":"Holst","locid":"864b6401-9024-4773-9bdb-f4d4ca57dcad","name":"Holst, Jens Juul","name_org":"Holst, Jens J.","orcid":"0000-0001-6853-3805","rank":4,"rolecode":"pau"},{"affno":"1","first":"Tina","key":"vilsbøllpau","last":"Vilsbøll","locid":"76773372-af8c-45a0-9447-a509cbf6d466","name":"Vilsbøll, Tina","orcid":"0000-0002-0456-6787","rank":5,"rolecode":"pau"},{"affno":"1 3","first":"Filip K.","key":"knoppau","last":"Knop","locid":"ce6eaad9-59f8-4ecf-8a1e-388a74734f6a","name":"Knop, Filip K.","rank":6,"rolecode":"pau"}],"pmid":["32904711"],"pub":{"doi":"10.1210/jendso/bvaa097","issn":["24721972"],"issue":"9","journal":"Journal of the Endocrine Society","paperid":"097","status":"p","title":"Journal of the Endocrine Society","title_org":"Journal of the endocrine society","volume":"4"},"review":"Peer Reviewed","scoID":["2-s2.0-85096490416"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-c526e854-5f8d-45e4-a583-4d7ca9884c44"],"src":["KU University of Copenhagen"],"title":"Glucose-Dependent Insulinotropic Polypeptide (GIP) Reduces Bone Resorption in Patients With Type 2 Diabetes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-511087","year":"2020","yearsub":"2020"}
{"abstract":"Infusion of the incretin hormone glucose-dependent insulinotropic polypeptide (GIP) suppresses the bone resorption marker carboxy-terminal type 1 collagen crosslinks (CTX). Using separate and combined infusions of the selective GIP receptor (GIPR) antagonist, GIP(3-30)NH2, and GIP, we investigated how GIPR inhibition affects bone turnover markers. Ten healthy men (median age 22.5 years (range 21-25), BMI 21.3 kg/m(2) (19.9-24.7)) participated in a randomized, doubled blinded, placebo-controlled, crossover study with four 1 h 12 mmol/l-hyperglycemic clamps on four separate study days with concomitant infusions of GIP, GIP + GIP(3-30)NH2, GIP(3-30)NH2, and placebo, respectively, separated by a period of at least one week. GIP was infused at 1.5 pmol/kg/min and GIP(3-30)NH2 at 800 pmol/kg/min. Plasma glucose was clamped at 12.0 +/- 1.2 mmol/l and plasma levels of GIP and GIP(3-30)NH2 amounted to similar to 80 pmol/l and similar to 50 nmol/l, respectively. GIP suppressed CTX more than placebo (baseline-subtracted AUC - 6,811 +/- 1,260 vs. - 3,012 +/- 3,018 ng/I x min, P = 0.002) and resulted in CTX values of 53 +/- 6.9% (GIP) versus 81 +/- 10% of baseline (placebo), respectively (P = 0.0006), at the end of the hyperglycemic clamp. Co-infusion of GIP and GIP(3-30)NH2 attenuated the GIP-induced CTX suppression by 51 +/- 33% (P = 0.01). The peak value of the bone formation marker N-terminal propeptide of type 1 procollagen (P1NP) peaked at higher levels during GIP (109 +/- 6.7% of baseline) than during GIP(3-30)NH2 infusion (101 +/- 8.9%) (P = 0.049) and GIP suppressed PTH levels compared to GIP(3-30)NH2 alone (P = 0.0158). In conclusion, blockade of the GIPR with GIP(3-30)NH2 diminished GIP-induced CTX and P1NP responses, showing that these effects are GIPR-mediated and that GIPR antagonism might interfere with bone resorption","author_count":10,"contributors":["Gasbjerg, Lærke S.","Hartmann, Bolette","Christensen, Mikkel Bring","Lanng, Amalie R.","Vilsbøll, Tina","Jørgensen, Niklas Rye","Holst, Jens Juul","Rosenkilde, Mette M.","Knop, Filip K."],"cuid":["S02-096.08-045547"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Glucose dependent insulinotropic polypeptide","Gut bone axis"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"gip s effect on bone metabolism is reduced by the selective gip receptor antagonist gip 000000000003 000000000030 nh000000000002","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85074258285","version":"Other Version"},"id":"S02-096.08-045547","identifier":[{"id":"85074258285","type":"scopus"},{"id":"000503321100040","type":"wos"},{"id":"31622777","type":"pmid"}],"ids":["ku-b586ce6f-95aa-43d6-bffa-cd73256638b7","sdu-ef76c7b8-9e70-4878-ac69-8ecb4a68b0b5"],"keyword":["Glucose-dependent insulinotropic polypeptide","Glucose-dependent insulinotropic polypeptide receptor antagonist","Gut-bone axis"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-8DD4492024F7BCBFC9304388F5F99EDF"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2019"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Biomedical Sciences, Molecular and Translational Pharmacology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research Unit OPEN (Odense)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","first":"Laerke S.","key":"gasbjergpau","last":"Gasbjerg","locid":"38691fd4-0b1c-4371-b423-954525f5f9b3","name":"Gasbjerg, Lærke S.","name_org":"Gasbjerg, Laerke S.","orcid":"0000-0002-7880-8515","rank":1,"rolecode":"pau"},{"affno":"1","first":"Bolette","key":"hartmannpau","last":"Hartmann","locid":"eb04fc6b-068a-4d5b-a106-1b7be3f7e12b","name":"Hartmann, Bolette","orcid":"0000-0001-8509-2036","rank":2,"rolecode":"pau"},{"affno":"1","first":"Mikkel B.","key":"christensenpau","last":"Christensen","locid":"4f5c91e2-3caa-4263-8d9c-df3bfdfbd31b","name":"Christensen, Mikkel Bring","name_org":"Christensen, Mikkel B.","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Amalie R","key":"lanngpau","last":"Lanng","name":"Lanng, Amalie R","rank":4,"rolecode":"pau"},{"affno":"1","first":"Tina","key":"vilsbøllpau","last":"Vilsbøll","locid":"76773372-af8c-45a0-9447-a509cbf6d466","name":"Vilsbøll, Tina","orcid":"0000-0002-0456-6787","rank":5,"rolecode":"pau"},{"affno":"1","first":"Niklas R.","key":"jorgensenpau","last":"Jorgensen","locid":"3dc68a95-e26c-4b82-a4f0-7548313f8045","name":"Jørgensen, Niklas Rye","name_org":"Jorgensen, Niklas R.","rank":6,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Niklas R","key":"jørgensenpau","last":"Jørgensen","locid":"cc73de9e-169b-4cd1-8e1c-1a2c3827b3e8","name":"Jørgensen, Niklas Rye","name_org":"Jørgensen, Niklas R","orcid":"0000-0001-9624-5210","rank":6,"rolecode":"pau"},{"affno":"1","first":"Jens J.","key":"holstpau","last":"Holst","locid":"864b6401-9024-4773-9bdb-f4d4ca57dcad","name":"Holst, Jens Juul","name_org":"Holst, Jens J.","orcid":"0000-0001-6853-3805","rank":7,"rolecode":"pau"},{"affno":"1","first":"Mette M.","key":"rosenkildepau","last":"Rosenkilde","locid":"d902feb8-1594-4fa8-bcb1-9f646dc30dd3","name":"Rosenkilde, Mette M.","orcid":"0000-0001-9600-3254","rank":8,"rolecode":"pau"},{"affno":"1","first":"Filip K.","key":"knoppau","last":"Knop","locid":"ce6eaad9-59f8-4ecf-8a1e-388a74734f6a","name":"Knop, Filip K.","rank":9,"rolecode":"pau"}],"pmid":["31622777"],"pub":{"doi":"10.1016/j.bone.2019.115079","issn":["18732763","87563282"],"issn_org":["87563282"],"journal":"Bone","paperid":"115079","publisher":"Elsevier","status":"p","title":"Bone","volume":"130"},"review":"Peer Reviewed","scoID":["2-s2.0-85074258285"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-b586ce6f-95aa-43d6-bffa-cd73256638b7","sdu-ef76c7b8-9e70-4878-ac69-8ecb4a68b0b5"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"GIP's effect on bone metabolism is reduced by the selective GIP receptor antagonist GIP(3-30)NH2","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-096.08-045547","year":"2020","yearsub":2020}
{"abstract":"Preclinical studies have shown a potential osteoanabolic effect of metformin but human studies of how metformin affects bone turnover are few. A post hoc sub-study analysis of an 18-month multicenter, placebo-controlled, double-blinded trial in type 2 diabetes mellitus (T2DM), randomizing participants to metformin versus placebo both in combination with different insulin analogue regimens (Metformin + Insulin vs. Placebo + Insulin). Patients were not treatment naive at baseline, 83% had received metformin, 69% had received insulin, 57.5% had received the combination of metformin and insulin before entering the study. Bone formation and resorption were assessed by measuring, N-terminal propeptide of type I procollagen (P1NP) and C-terminal telopeptide of type I collagen (CTX) at baseline and end of study. The influence of gender, age, smoking, body mass index (BMI), T2DM duration, glycosylated hemoglobin A1c (HbA1c), c-reactive protein (CRP) and insulin dosage was also included in the analyses. The levels of bone formation marker P1NP and bone resorption marker CTX increased significantly in both groups during the trial. P1NP increased less in the Metformin + Insulin compared to the placebo + insulin group (p = 0.001) (between group difference change), while the increases in CTX levels (p = 0.11) were not different. CRP was inversely associated (p = 0.012) and insulin dosage (p = 0.011) was positively related with change in P1NP levels. BMI (p = 0.002) and HbA1C (p = 0.037) were inversely associated with change in CTX levels. During 18 months of treatment with metformin or placebo, both in combination with insulin, bone turnover increased in both groups. But the pattern was different as the bone formation marker (P1NP) increased less during Metformin + Insulin treatment, while change in bone resorption (CTX) was not significantly different between the two groups.","author_count":20,"contributors":["Nordklint, Azra Karahasanovic","Almdal, Thomas Peter","Vestergaard, Peter","Lundby-Christensen, Louise","Jørgensen, Niklas Rye","Boesgaard, Trine W","Breum, Leif","Gade-Rasmussen, Birthe","Sneppen, Simone B","Gluud, Christian","Hemmingsen, Bianca","Krarup, Thure","Madsbad, Sten","Mathiesen, Elisabeth R","Perrild, Hans","Tarnow, Lise","Thorsteinsson, Birger","Vestergaard, Henrik","Lund, Søren S","Eiken, Pia"],"cuid":["S03-100.00-004263"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"continent":["Europe, EU","OECD"],"corresponding_author":["Nordklint, Azra Karahasanovic"],"country":["Germany"],"glorg":["All Global Affiliations","Boehringer Ingelheim Pharma GmbH &amp; Co. KG"],"keyword":["Bone turnover","CTX","Fracture risk","IMPACT","Insulin","MEN","Metabolism","Metformin","Mineral density","P1NP","Rosiglitazone","Therapy","Turnover","Type 2 diabetes"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-PR","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-NDR","DI-HO-STENO","DI-HO-ZEA"],"PR":["DI-PR-ALL","DI-PR-NOVO"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-NDR","DI-HO-STENO","DI-HO-ZEA","DI-PR-NOVO","DI-U-AAU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"effect of metformin vs placebo in combination with insulin analogues on bone markers p000000000001np and ctx in patients with type 000000000002 diabetes mellitus","src":["aau","ku","sdu"],"src-code":["DI-U-AAU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85085366484&partnerID=8YFLogxK","version":"Other Version"},"funding_acknowledgement":["Funding was obtained from Nordsjællands Hospital, the Jascha foundation, the Osteoporosis Association for patients, the foundation of A & J C Tvergaard, the foundation of Captain Lieutenant Harald Jensen and Wife, Inge and Per Refshalls research grant and Danish Bone Society travel grant. Azra Nordklint reports grants from the Jascha foundation, grants from the Osteoporosis Association for patients, grants from the foundation of A & J C Tvergaard, grants from the foundation of Captain Lieutenant Harald Jensen and Wife, grants from Inge and Per Refshalls research grant, grants from Danish Bone Society travel grant, grants from Nordsjællands Hospital, during the conduct of the study, and otherwise has no conflicts of interest to declare. Pia Eiken is an advisory board member for Amgen and Eli Lilly, and on the speakers’ bureau for Amgen and Eli Lilly, and own shares in Novo Nordisk A/S. Louise Lundby Christensen owns shares in Novo Nordisk A/S. Thomas Almdal owns shares in Novo Nordisk A/S. Søren S. Lund has previously published his opinion about the clinical effects of metformin treatment. Søren S. Lund owns shares in Novo Nordisk A/S and shares in dynamically traded investment funds, which may own stocks from pharmaceutical companies. Søren S. Lund has reported former employment at Steno Diabetes Center, which is a diabetes hospital and academic institution previously owned by Novo Nordisk. Søren S. Lund is now employed at Boehringer Ingelheim International GmbH, Ingelheim, Germany. Søren S. Lund’s contribution was his alone and does not necessarily reflect the official position of Boehringer Ingelheim. Trine W. Boesgaard owns shares in Novo Nordisk A/S. Trine W. Boesgaard has reported former employment at Steno Diabetes Center, which is a diabetes hospital and academic institution previously owned by Novo Nordisk. Trine W. Boesgaard is now employed at Novo Nordisk. Trine W Boesgaard’s contribution was hers alone and does not necessarily reflect the official position of Novo Nordisk. Peter Vestergaard, Leif Breum, Birthe Gade-Rasmussen, Simone B Sneppen, Christian Gluud, Bianca Hemmingsen, Thure Krarup, Sten Madsbad, Elisabeth R Mathiesen, Hans Perrild, Lise Tarnow, Birger Thorsteinsson, Niklas Rye Jørgensen and Henrik Vestergaard have no known conflicts of interest to declare."],"id":"S03-100.00-004263","identifier":[{"id":"000546386400007","type":"wos"},{"id":"85085366484","type":"scopus"},{"id":"32468187","type":"pmid"}],"ids":["aau-574463e8-041b-4780-99a9-c5f309f1fead","ku-39e19360-e15e-40b6-8879-3706832be4a2","sdu-9827f655-4d13-49c6-8b79-3755b3bd28a6"],"keyword":["Bone turnover","CTX","FRACTURE RISK","IMPACT","Insulin","MEN","METABOLISM","MINERAL DENSITY","Metformin","P1NP","ROSIGLITAZONE","THERAPY","TURNOVER","Type 2 diabetes"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-8B9C4AC3F24C0BBC7424B4D655B89B0D"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Medicin og Akut","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Steno Diabetes Center North Denmark","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, The Department of Endocrinology","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-AAU","used":1},{"affno":"3","country":"dk","key":"north denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"