83-a7c8-64bc2ea541ac","name":"Jensen, Jens Ulrik Stæhr","orcid":"0000-0003-4036-0521","rank":19,"rolecode":"pau"},{"affno":"1 10 11","corresponding":null,"first":"Tor","key":"bieringsørensentorpau","last":"Biering-Sørensen","name":"Biering-Sørensen, Tor","rank":20,"rolecode":"pau"}],"pmid":["39303788"],"pub":{"doi":"10.1016/j.jinf.2024.106276","issn":["01634453","15322742"],"issn_org":["01634453"],"issue":"5","journal":"Journal of Infection","paperid":"106276","publisher":"WB  Saunders Ltd","publisher_org":"W.B. Saunders Ltd","status":"p","title":"Journal of Infection","volume":"89"},"review":"Peer Reviewed","scoID":["2-s2.0-85205017556"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Private Research","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Companies","Other Research","Private Research","Universities","University of Copenhagen","sanofi dk"],"PST":["Published"]},"sid":["au-71b57deb-eb9c-40db-8d6c-05b18d2a4324","ku-4531b9ec-a56c-47bc-8f76-610cff75ca18"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Time of day for vaccination, outcomes, and relative effectiveness of high-dose vs. standard-dose quadrivalent influenza vaccine : A post hoc analysis of the DANFLU-1 randomized clinical trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.90-761766","year":"2024","yearsub":"2024"}
{"abstract":"Background: Improving oxygenation and ventilation in drowning patients early in the field is critical and may be lifesaving. The critical care interventions performed by physicians in drowning management are poorly described. The aim was to describe patient characteristics and critical care interventions with 30-day mortality as the primary outcome in drowning patients treated by the Danish Air Ambulance. Methods: This retrospective cohort study with 30-day follow-up identified drowning patients treated by the Danish Air Ambulance from January 1, 2016, through December 31, 2021. Drowning patients were identified using a text-search algorithm (Danish Drowning Formula) followed by manual review and validation. Operational and medical data were extracted from the Danish Air Ambulance database. Descriptive analyses were performed comparing non-fatal and fatal drowning incidents with 30-day mortality as the primary outcome. Results: Of 16,841 dispatches resulting in a patient encounter in the six years, the Danish Drowning Formula identified 138 potential drowning patients. After manual validation, 98 drowning patients were included in the analyses, and 82 completed 30-day follow-up. The prehospital and 30-day mortality rates were 33% and 67%, respectively. The National Advisory Committee for Aeronautics severity scores from 4 to 7, indicating a critical emergency, were observed in 90% of the total population. They were significantly higher in the fatal versus non-fatal group (p < 0.01). At least one critical care intervention was performed in 68% of all drowning patients, with endotracheal intubation (60%), use of an automated chest compression device (39%), and intraosseous cannulation (38%) as the most frequently performed interventions. More interventions were generally performed in the fatal group (p = 0.01), including intraosseous cannulation and automated chest compressions. Conclusions: The Danish Air Ambulance rarely treated drowning patients, but those treated were severely ill, with a 30-day mortality rate of 67% and frequently required critical care interventions. The most frequent interventions were endotracheal intubation, automated chest compressions, and intraosseous cannulation.","author_count":6,"contributors":["Breindahl, Niklas","Wolthers, Signe A.","Møller, Thea P.","Blomberg, Stig N. F.","Steinmetz, Jacob","Christensen, Helle Collatz"],"cuid":["S02-100.00-724894"],"filters":{"added":"2024-05","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corpau":["The Danish Drowning Validation Group"],"keyword":["Danish Air Ambulance","Danish drowning formula","Drowning","Emergency medical service EMS","Helicopter emergency medical service HEMS","National Danish Drowning Registry","Registry based"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-OTH","DI-HO-ZEA"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-HO-OTH","DI-HO-ZEA","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"characteristics and critical care interventions in drowning patients treated by the danish air ambulance from 000000002016 to 000000002021 a nationwide registry based study with 000000000030 day follow up","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s13049-024-01189-y","version":"Published Version"},"funding_acknowledgement":["The authors would like to acknowledge the Danish Drowning Validation Group for developing the Danish Drowning Formula in 2023, which was used in this study [12]. All Danish Drowning Validation Group members are affiliated with Prehospital Center Region Zealand, Næstved, Denmark: Niklas Breindahl, Signe A. Wolthers, Theo W. Jensen, and Mathias G. Holgersen. Open access funding provided by Copenhagen University This study was supported by the Danish foundation TrygFonden. TrygFonden did not influence trial design, data collection, analysis, interpretation, writing, or decision to submit the manuscript for publication. JS has a clinical professorship funded by the Norwegian Air Ambulance Foundation."],"id":"S02-100.00-724894","identifier":[{"id":"85186928913","type":"scopus"},{"id":"38448994","type":"pmid"},{"id":"PMC10916225","type":"pmcid"}],"ids":["au-dd80753a-b7b6-4e0a-a3d3-7d931841a37b","ku-9362e42a-e2be-4f85-85f7-ca76ba2790fe"],"keyword":["Danish Air Ambulance","Danish drowning formula","Drowning","Emergency medical service (EMS)","Helicopter emergency medical service (HEMS)","National Danish Drowning Registry","Registry-based"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-A99C9F07B32BC71D96B952A8555B7852"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s13049-024-01189-y","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/385569061/s13049_024_01189_y.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Copenhagen University Hospital - Næstved, Slagelse and Ringsted"],"nora_code":"DI-HO-ZEA","used":1},{"affno":"4","country":"dk","key":"other hospitals","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-OTH","l3nl":"Other Hospitals","l3nn":"Other Hospitals","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Hospitals","namevar":["Copenhagen University Hospital - Holbæk"],"nora_code":"DI-HO-OTH","used":1},{"affno":"5","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University"],"nora_code":"DI-U-AU","used":1},{"affno":6,"key":"the danish drowning validation group","name":"The Danish Drowning Validation Group","role":"oau"}],"person":[{"affno":"1 2 3","first":"Niklas","key":"breindahlpau","last":"Breindahl","name":"Breindahl, Niklas","rank":1,"rolecode":"pau"},{"affno":"1 3","first":"Signe A.","key":"woltherspau","last":"Wolthers","name":"Wolthers, Signe A.","rank":2,"rolecode":"pau"},{"affno":"3 4","first":"Thea P.","key":"møllerpau","last":"Møller","name":"Møller, Thea P.","rank":3,"rolecode":"pau"},{"affno":"3","first":"Stig N. F.","key":"blombergpau","last":"Blomberg","name":"Blomberg, Stig N. F.","rank":4,"rolecode":"pau"},{"affno":"2 1 4 5","first":"Jacob","key":"steinmetzpau","last":"Steinmetz","locid":"5a72d483-a14d-40ba-8294-4fefb8ec7755","name":"Steinmetz, Jacob","rank":5,"rolecode":"pau"},{"affno":"3 1","first":"Helle C.","key":"christensenpau","last":"Christensen","locid":"b05bae82-5e32-4f10-980c-147b4af03d6a","name":"Christensen, Helle Collatz","name_org":"Christensen, Helle C.","rank":6,"rolecode":"pau"}],"pmid":["38448994"],"pub":{"doi":"10.1186/s13049-024-01189-y","issn":["17577241"],"issue":"1","journal":"Scandinavian Journal of Trauma, Resuscitation and Emergency Medicine","paperid":"17","publisher":"BioMed Central","status":"p","title":"Scandinavian Journal of Trauma, Resuscitation and Emergency Medicine","volume":"32"},"review":"Peer Reviewed","scoID":["2-s2.0-85186928913"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Other Hospitals","Region Zealand","Universities","University of Copenhagen","copenhagen university hospital - holbæk","danish air ambulance"],"PST":["Published"]},"sid":["au-dd80753a-b7b6-4e0a-a3d3-7d931841a37b","ku-9362e42a-e2be-4f85-85f7-ca76ba2790fe"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Characteristics and critical care interventions in drowning patients treated by the Danish Air Ambulance from 2016 to 2021 : a nationwide registry-based study with 30-day follow-up","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-724894","year":"2024","yearsub":"2024"}
{"abstract":"Bacon manufacturing involves several processing steps including nitrite curing, followed by cooking processes, typically frying. During these processes, harmful processing contaminants such as N-nitrosamines (NAs) and heterocyclic aromatic amines (HAAs) can be formed. Consequently, we developed and validated a multi-class method for quantification of the most frequently reported HAAs and NAs in fried bacon. Satisfactory repeatability and reproducibility with limits of quantification between 0.1 and 0.5 ng g-1 for most of the compounds were achieved. Quantification in pan-fried bacon cubes and slices revealed generally low levels of individual HAAs (≤1.5 ng g-1), except in ready-to-eat bacon (0.9-2.9 ng g-1). Differences in amounts of individual HAAs were observed in cubes and slices, most likely due to meat thickness. Among volatile NAs (VNAs), only N-nitrosopiperidine (NPIP), N-nitrosopyrolidine (NPYR), and N-nitrosodibutylamine (NDBA) were found at generally low concentrations (≤5 ng g-1). In contrast, non-volatile NAs (NVNAs) were present in all tested samples at considerably higher amounts, for example, N-nitroso-thiazolidine-4-carboxylic acid (NTCA) at 12-77 ng g-1. N-nitrosodimethylamine (NDMA), N-nitrosodiethylamine (NDEA), N-nitrosodipropylamine (NDPA) were not detected in any samples. Statistical evaluation and principal component analysis revealed some differences among tested samples. Dietary exposure estimation of the Danish population to HAAs and NAs showed the highest exposure in the teenage group (10-17 years).","author_count":4,"contributors":["Niklas, Agnieszka Anna","Pedersen, Mikael","Christensen, Tue","Duedahl-Olesen, Lene"],"cuid":["S01-000.00-669466"],"filters":{"added":"2023-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Niklas, Agnieszka Anna"],"keyword":["Dietary exposure","Liquid chromatography tandem mass spectrometry","Processing contaminants"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"simultaneous determination of heterocyclic aromatic amines and n nitrosamines in fried bacon cubes and slices using lc esi apci ms ms","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85150500525","version":"Other Version"},"id":"S01-000.00-669466","identifier":[{"id":"85150500525","type":"scopus"},{"id":"36893441","type":"pmid"}],"ids":["dtu-d66e062a-d2ae-4322-8b78-4ca9bdf36e06"],"keyword":["Dietary exposure","Fried bacon","Liquid chromatography-tandem mass spectrometry","Multi-class method","Processing contaminants"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-531911B9F8FD9BAB97BE62BB1333FDD9"],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Food Institute","Technical University of Denmark, National Food Institute, Research Group for Analytical Food Chemistry"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Agnieszka Anna","key":"niklaspau","last":"Niklas","locid":"2ce01307-4d44-4504-99c2-e9b9bfe12094","name":"Niklas, Agnieszka Anna","orcid":"0000-0002-3395-3006","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mikael","key":"pedersenpau","last":"Pedersen","locid":"60030692-3fd7-418c-9a35-952a9834f37b","name":"Pedersen, Mikael","orcid":"0000-0001-6540-4805","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Tue","key":"christensenpau","last":"Christensen","locid":"189d4073-9f5b-4f14-95ad-31a1e1a382c8","name":"Christensen, Tue","orcid":"0000-0001-7693-7359","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lene","key":"duedahlolesenpau","last":"Duedahl-Olesen","locid":"886d06e9-73a3-4df8-a0af-dc0dd8f96baa","name":"Duedahl-Olesen, Lene","orcid":"0000-0002-3162-0101","rank":4,"rolecode":"pau"}],"pmid":["36893441"],"pub":{"doi":"10.1080/19440049.2023.2185082","issn":["19440049","19440057"],"issn_org":["19440049"],"issue":"4","journal":"Food Additives & Contaminants: Part A - Chemistry, Analysis, Control, Exposure & Risk Assessment","pages":"493-507","publisher":"Taylor and Francis Ltd.","status":"p","title":"Food Additives & Contaminants: Part A - Chemistry, Analysis, Control, Exposure & Risk Assessment","title_org":"Food Additives and Contaminants - Part A Chemistry, Analysis, Control, Exposure and Risk Assessment","volume":"40"},"review":"Peer Reviewed","scoID":["2-s2.0-85150500525"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-d66e062a-d2ae-4322-8b78-4ca9bdf36e06"],"src":["DTU Technical University of Denmark"],"title":"Simultaneous determination of heterocyclic aromatic amines and N-nitrosamines in fried bacon cubes and slices using LC-(ESI/APCI)-MS/MS","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-669466","year":"2023","yearsub":"2023"}
{"abstract":"Introduction: COVID-19 has spread globally in waves, and Danish treatment guidelines have been updated following the first wave. We sought to investigate whether the prognostic values of echocardiographic parameters changed with updates in treatment guidelines and the emergence of novel severe acute respiratory syndrome coronavirus 2 (SARS-CoV-2) variants, 20E (EU1) and alpha (B.1.1.7), and further to compare cardiac parameters between patients from the first and second wave. Methods: A total of 305 patients hospitalized with COVID-19 were prospectively included, 215 and 90 during the first and second wave, respectively. Treatment in the study was defined as treatment with remdesivir, dexamethasone, or both. Patients were assumed to be infected with the dominant SARS-CoV-2 variant at the time of their hospitalization. Results: Mean age for the first versus second wave was 68.7 ± 13.6 versus 69.7 ± 15.8 years, and 55% versus 62% were males. Left ventricular (LV) systolic and diastolic function was worse in patients hospitalized during the second wave (LV ejection fraction [LVEF] for first vs. second wave = 58.5 ± 8.1% vs. 52.4 ± 10.6%, p < 0.001; and global longitudinal strain [GLS] = 16.4 ± 4.3% vs. 14.2 ± 4.3%, p < 0.001). In univariable Cox regressions, reduced LVEF (hazard ratio [HR] = 1.07 per 1% decrease, p = 0.002), GLS (HR = 1.21 per 1% decrease, p < 0.001), and tricuspid annular plane systolic excursion (HR = 1.18 per 1 mm decrease, p < 0.001) were associated with COVID-related mortality, but only GLS remained significant in fully adjusted analysis (HR = 1.14, p = 0.02). Conclusion: Reduced GLS was associated with COVID-related mortality independently of wave, treatment, and the SARS-CoV-2 variant. LV function was significantly impaired in patients hospitalized during the second wave.","author_count":24,"contributors":["Christensen, Jacob","Skaarup, Kristoffer Grundtvig","Lassen, Mats Christian Højbjerg","Alhakak, Alia Sead","Sengeløv, Morten","Nielsen, Anne Bjerg","Johansen, Niklas Dyrby","Bundgaard, Henning","Hassager, Christian","Jabbari, Reza","Carlsen, Jørn","Kirk, Ole","Kristiansen, Ole Peter","Nielsen, Olav Wendelboe","Ulrik, Charlotte Suppli","Sivapalan, Pradeesh","Gislason, Gunnar","Iversen, Kasper","Jensen, Jens Ulrik Stæhr","Schou, Morten","Hviid, Anders","Krause, Tyra Grove","Biering-Sørensen, Tor","Davidovski, Filip Søskov"],"cuid":["S01-000.00-702415"],"filters":{"added":"2023-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Covid 19","Echocardiography","Global longitudinal strain","Prognostics","Speckle tracking echocardiography"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"cardiac characteristics of the first two waves of covid 000000000019 in denmark and the prognostic value of echocardiography the echovid 000000000019 study","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-702415","identifier":[{"id":"85148772942","type":"scopus"},{"id":"36455539","type":"pmid"}],"ids":["ku-db8228d3-fb48-4ccc-9670-42cce23e5dc4"],"keyword":["COVID-19","Echocardiography","Global longitudinal strain","Prognostics","Speckle-Tracking echocardiography"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-A571B3020E4572629DF615CFD94B805F"],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal medicine: Cardiology"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"dk","key":"ssi statens serum institut","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-SSI","l3nn":"SSI Statens Serum Institut","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SSI Statens Serum Institut","namevar":["Statens Serum Institut"],"nora_code":"DI-GV-SSI","used":1}],"person":[{"affno":"","first":"Jacob","key":"christensenjacobpau","last":"Christensen","name":"Christensen, Jacob","rank":1,"rolecode":"pau"},{"affno":"1","first":"Kristoffer Grundtvig","key":"skaarupkristoffergrundtvigpau","last":"Skaarup","name":"Skaarup, Kristoffer Grundtvig","rank":2,"rolecode":"pau"},{"affno":"1","first":"Mats Christian Højbjerg","key":"lassenmatschristianhøjbjergpau","last":"Lassen","name":"Lassen, Mats Christian Højbjerg","rank":3,"rolecode":"pau"},{"affno":"","first":"Alia Sead","key":"alhakakaliaseadpau","last":"Alhakak","name":"Alhakak, Alia Sead","rank":4,"rolecode":"pau"},{"affno":"","first":"Morten","key":"sengeløvmortenpau","last":"Sengeløv","name":"Sengeløv, Morten","rank":5,"rolecode":"pau"},{"affno":"1","first":"Anne Bjerg","key":"nielsenannebjergpau","last":"Nielsen","name":"Nielsen, Anne Bjerg","rank":6,"rolecode":"pau"},{"affno":"","first":"Niklas Dyrby","key":"johansenniklasdyrbypau","last":"Johansen","name":"Johansen, Niklas Dyrby","rank":7,"rolecode":"pau"},{"affno":"2","first":"Henning","key":"bundgaardhenningpau","last":"Bundgaard","locid":"254c7f8d-79dd-4a5d-870f-3ed78cb56464","name":"Bundgaard, Henning","rank":8,"rolecode":"pau"},{"affno":"2","first":"Christian","key":"hassagerchristianpau","last":"Hassager","locid":"49196e5d-0f61-44b2-a6b9-cd6c5f8f3bc2","name":"Hassager, Christian","orcid":"0000-0002-1199-0981","rank":9,"rolecode":"pau"},{"affno":"1","first":"Reza","key":"jabbarirezapau","last":"Jabbari","name":"Jabbari, Reza","rank":10,"rolecode":"pau"},{"affno":"2","first":"Jørn","key":"carlsenjørnpau","last":"Carlsen","locid":"d1394cd1-fa74-45ea-a5f4-7730f6c6de0c","name":"Carlsen, Jørn","rank":11,"rolecode":"pau"},{"affno":"2","first":"Ole","key":"kirkolepau","last":"Kirk","locid":"67bce469-8913-44ac-8d6d-7dff1171c771","name":"Kirk, Ole","rank":12,"rolecode":"pau"},{"affno":"","first":"Ole Peter","key":"kristiansenolepeterpau","last":"Kristiansen","name":"Kristiansen, Ole Peter","rank":13,"rolecode":"pau"},{"affno":"2","first":"Olav Wendelboe","key":"nielsenolavwendelboepau","last":"Nielsen","locid":"d9fc9e11-583d-43d9-994c-df128b7bf5cc","name":"Nielsen, Olav Wendelboe","orcid":"0000-0003-3532-9431","rank":14,"rolecode":"pau"},{"affno":"2","first":"Charlotte Suppli","key":"ulrikcharlottesupplipau","last":"Ulrik","locid":"ea578010-4d8b-498b-b9d0-8f3d8cc424df","name":"Ulrik, Charlotte Suppli","rank":15,"rolecode":"pau"},{"affno":"1","first":"Pradeesh","key":"sivapalanpradeeshpau","last":"Sivapalan","name":"Sivapalan, Pradeesh","rank":16,"rolecode":"pau"},{"affno":"2","first":"Gunnar","key":"gislasongunnarpau","last":"Gislason","locid":"c0f678a6-eb13-49a3-9485-8fae1e72e2a1","name":"Gislason, Gunnar","rank":17,"rolecode":"pau"},{"affno":"2","first":"Kasper","key":"iversenkasperpau","last":"Iversen","locid":"558df261-ca9f-440a-8bee-7d38813c253f","name":"Iversen, Kasper","rank":18,"rolecode":"pau"},{"affno":"2","first":"Jens Ulrik Stæhr","key":"jensenjensulrikstæhrpau","last":"Jensen","locid":"d9593acd-d6ae-4a83-a7c8-64bc2ea541ac","name":"Jensen, Jens Ulrik Stæhr","orcid":"0000-0003-4036-0521","rank":19,"rolecode":"pau"},{"affno":"2","first":"Morten","key":"schoumortenpau","last":"Schou","locid":"48fa6ec9-1941-4566-b931-14b0cc8cbae3","name":"Schou, Morten","rank":20,"rolecode":"pau"},{"affno":"3","first":"Anders","key":"hviidanderspau","last":"Hviid","name":"Hviid, Anders","rank":21,"rolecode":"pau"},{"affno":"3","first":"Tyra Grove","key":"krausetyragrovepau","last":"Krause","name":"Krause, Tyra Grove","rank":22,"rolecode":"pau"},{"affno":"1","first":"Tor","key":"bieringsørensentorpau","last":"Biering-Sørensen","name":"Biering-Sørensen, Tor","rank":23,"rolecode":"pau"},{"affno":"1","first":"Filip Søskov","key":"davidovskifilipsøskovpau","last":"Davidovski","name":"Davidovski, Filip Søskov","rank":24,"rolecode":"pau"}],"pmid":["36455539"],"pub":{"doi":"10.1159/000528308","issn":["00086312","14219751"],"issn_org":["00086312"],"issue":"1","journal":"Cardiology","pages":"48-57","status":"p","title":"Cardiology","title_org":"Cardiology (Switzerland)","volume":"148"},"review":"Peer Reviewed","scoID":["2-s2.0-85148772942"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-db8228d3-fb48-4ccc-9670-42cce23e5dc4"],"src":["KU University of Copenhagen"],"title":"Cardiac Characteristics of the First Two Waves of COVID-19 in Denmark and the Prognostic Value of Echocardiography : The ECHOVID-19 Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-702415","year":"2023","yearsub":"2023"}
{"abstract":"”ØK - Kompagniet i verdensklasse” er en dokumentarserie i seks dele, der suppleres af et tekstmateriale med elevopgaver og litteraturliste. De første fem dele handler om fem faser i ØK’s udviklingshistorie, mens sjette del orienterer om organisationen og virksomhedskulturen i ØK. Det Østasiatiske Kompagnis historie er et centralt kapitel i dansk erhvervshistorie. Vi sætter fokus på en af Danmarks mest visionære iværksættere, H.N. Andersen og på, hvordan han realiserede sin plan for et verdensomspændende kompagni. Vi trækker de store linjer op og følger, hvordan ØK navigerede gennem økonomiske op- og nedture, under krise og krig, og hvordan Kompagniet indrettede sig under skiftende rammebetingelser. ØK var i en lang årrække Danmarks største erhvervsvirksomhed og nåede i begyndelsen af 1970erne at blive Skandinaviens største - et konglomerat af rederi og datterselskaber, agenturer og industrielle partnerskaber. ØK havde længe førertrøjen på ift. innovative skibstyper som dieselskibe og containerskibe. Men i kølvandet på 70’ernes oliekriser vendte udviklingen fra ekspansion til tilbagegang. Kompagniet havde spredt sig over for mange forretningsområder og investeret alt for meget for lånte penge. I 1992 klappede gældsfælden sammen om ØK. Paradoksalt havde Danmarks mest internationale virksomhed svært ved at klare sig, da globaliseringen for alvor slog igennem. Efter en række fatale fejlinvesteringer var ØK efter 2005 en afviklingsforretning. Selvom ØK ikke længere eksisterer som selvstændig virksomhed, har Kompagniet sat varige spor. Dels som grundlægger af en række virksomheder, der fortsat eksisterer og dels som fødselshjælper for store danske virksomheders markedsføring over hele verden. Det samlede materiale er et gratis undervisningstilbud til elever i gymnasiet (Stx, Hhx, Htx, HF) og elever på Martec (maritim student). Materialet kan indgå i undervisningen på Simac (maritim akademiuddannelse) og på CBS (erhvervs- og søfartshistorie). ”ØK - Kompagniet i verdensklasse” henvender sig også mere bredt til danskere med interesse for erhvervs- og søfartshistorie samt ØK-Fondens internationale forbindelser. Produceret med støtte fra Orient’s Fond og ØK-Fonden.","author_count":11,"contributors":["Frydenberg, Anette Eggert","Kyrø, Ebbe","Kirk, Anne Lissner","Christensen, Erik Bøgh","Rasmussen, Henrik","Iversen, Martin Jes","Risom, Morten Beck","Poulsen, Niklas","Brandi, Niels-Peter","Lefeldt, Sven","Tulinius, Grete"],"cuid":["S01-000.00-710304"],"filters":{"added":"2024-02","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"level":"edu","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"nr","rtype":["clu"],"sorti":"øk kompagniet i verdensklasse del 000000000006 organisationen og øk ånden","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dnt","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://nexuslearning.dk/videregaaende-uddannelse/oek-kompagniet-i-verdensklasse/organisationen-og-oek-aanden/#_","version":"Published Version"},"id":"S01-000.00-710304","ids":["cbs-ad055573-9b9f-47f2-924e-056aa56e8bfe"],"lang":"Danish","level":"Educational","mra":["Social Science"],"noi":["Local-1-1-0FFE894E5994945BBA24ABFD34ADEB59"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://nexuslearning.dk/videregaaende-uddannelse/oek-kompagniet-i-verdensklasse/organisationen-og-oek-aanden/#_","version":"Published Version"}],"org":[{"affno":"1","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Strategy and Innovation"],"nora_code":"DI-U-CBS","used":1}],"person":[{"affno":"","corresponding":null,"first":"Anette Eggert","key":"frydenbergppu","last":"Frydenberg","name":"Frydenberg, Anette Eggert","rank":1,"role":"Publisher","rolecode":"ppu"},{"affno":"","corresponding":null,"first":"Ebbe","key":"kyrøppu","last":"Kyrø","name":"Kyrø, Ebbe","rank":2,"role":"Publisher","rolecode":"ppu"},{"affno":"","corresponding":null,"first":"Anne Lissner","key":"kirkpau","last":"Kirk","name":"Kirk, Anne Lissner","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Erik Bøgh","key":"christensenpau","last":"Christensen","name":"Christensen, Erik Bøgh","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Henrik","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Henrik","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Martin Jes","key":"iversenppu","last":"Iversen","locid":"70008003-7f75-4450-aba1-e1f24a13fa9d","name":"Iversen, Martin Jes","orcid":"0000-0003-4085-5524","rank":6,"role":"Publisher","rolecode":"ppu"},{"affno":"","corresponding":null,"first":"Morten Beck","key":"risompau","last":"Risom","name":"Risom, Morten Beck","rank":7,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Niklas","key":"poulsenpau","last":"Poulsen","name":"Poulsen, Niklas","rank":8,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Niels-Peter","key":"brandipau","last":"Brandi","name":"Brandi, Niels-Peter","rank":9,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Sven","key":"lefeldtpau","last":"Lefeldt","name":"Lefeldt, Sven","rank":10,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Grete","key":"tuliniuspau","last":"Tulinius","name":"Tulinius, Grete","rank":11,"rolecode":"pau"}],"pub":{"publisher":"Nexus Kommunikation A/S","status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["cbs-ad055573-9b9f-47f2-924e-056aa56e8bfe"],"src":["CBS Copenhagen Business School"],"title":"ØK - kompagniet i verdensklasse : Del 6: Organisationen og ØK-ånden","type":"Non-Textual Item","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-710304","year":"2023","yearsub":"2023"}
{"abstract":"Background: Accurate, reliable, and sufficient data is required to reduce the burden of drowning by targeting preventive measures and improving treatment. Today's drowning statistics are informed by various methods sometimes based on data sources with questionable reliability. These methods are likely responsible for a systematic and significant underreporting of drowning. This study's aim was to assess the 30-day survival of patients with out-of-hospital cardiac arrest (OHCA) identified in the Danish Cardiac Arrest Registry (DCAR) after applying the Danish Drowning Formula. Methods: This nationwide, cohort, registry-based study with 30-day follow-up used the Danish Drowning Formula to identify drowning-related OHCA with a resuscitation attempt from the DCAR from January 1st, 2016, through December 31st, 2021. The Danish Drowning Formula is a text-search algorithm constructed for this study based on trigger-words identified from the prehospital medical records of validated drowning cases. The primary outcome was 30-day survival from OHCA. Data were analyzed using multiple logistic regression. Results: Drowning-related OHCA occurred in 374 (1%) patients registered in the DCAR compared to 29,882 patients with OHCA from other causes. Drowning-related OHCA more frequently occurred at a public location (87% vs 25%, p < 0.001) and were more frequently witnessed by bystanders (80% vs 55%, p < 0.001). Both 30-day and 1-year survival for patients with drowning-related OHCA were significantly higher compared to OHCA from other causes (33% vs 14% and 32% vs 13%, respectively, p < 0.001). The adjusted odds ratio for 30-day survival for drowning-related OHCA and other causes of OHCA was 2.3 [1.7–3.2], p < 0.001. Increased 30-day survival was observed for drowning-related OHCA occurring at swimming pools compared to public location OHCA from other causes with an OR of 11.6 [6.0–22.6], p < 0.001. Conclusions: This study found higher 30-day survival among drowning-related OHCA compared to OHCA from other causes. This study proposed that a text-search algorithm (Danish Drowning Formula) could explore unstructured text fields to identify drowning persons. This method may present a low-resource solution to inform the drowning statistics in the future. Registration: This study was registered at ClinicalTrials.gov before analyses (NCT05323097).","author_count":7,"contributors":["Breindahl, Niklas","Wolthers, Signe A.","Jensen, Theo W.","Holgersen, Mathias G.","Blomberg, Stig N.F.","Steinmetz, Jacob","Christensen, Helle Collatz"],"cuid":["S01-000.00-719671"],"filters":{"added":"2024-02","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corpau":["the Danish Cardiac Arrest Group"],"keyword":["Cohort study","Danish drowning formula","Drowning","Out of hospital cardiac arrest","Prehospital"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-ZEA"],"OT":["Prehospital Center Region Zealand, Næstved"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-HO-ZEA","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"danish drowning formula for identification of out of hospital cardiac arrest from drowning","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.ajem.2023.08.024","version":"Published Version"},"id":"S01-000.00-719671","identifier":[{"id":"85168476643","type":"scopus"},{"id":"37619443","type":"pmid"}],"ids":["ku-2bb2ea3e-8a82-4e3b-96b3-5a89a81b3315"],"keyword":["Cohort study","Danish drowning formula","Drowning","Out-of-hospital cardiac arrest","Prehospital"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-8108ABDFD31C77BD6357DD90499EB13F"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/375053634/1_s2.0_S0735675723004448_main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.ajem.2023.08.024","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Prehospital Center Region Zealand"],"nora_code":"DI-HO-ZEA","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Prehospital Center Region Zealand, Næstved"],"nora_code":"DI-OT","used":1},{"affno":"4","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Anaesthesiology","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":5,"key":"the danish cardiac arrest group","name":"the Danish Cardiac Arrest Group","role":"oau"}],"person":[{"affno":"1 2","first":"Niklas","key":"breindahlpau","last":"Breindahl","name":"Breindahl, Niklas","rank":1,"rolecode":"pau"},{"affno":"1","first":"Signe A.","key":"woltherspau","last":"Wolthers","name":"Wolthers, Signe A.","rank":2,"rolecode":"pau"},{"affno":"1 2","first":"Theo W.","key":"jensenpau","last":"Jensen","name":"Jensen, Theo W.","rank":3,"rolecode":"pau"},{"affno":"2","first":"Mathias G.","key":"holgersenpau","last":"Holgersen","name":"Holgersen, Mathias G.","rank":4,"rolecode":"pau"},{"affno":"3","first":"Stig N.F.","key":"blombergpau","last":"Blomberg","name":"Blomberg, Stig N.F.","rank":5,"rolecode":"pau"},{"affno":"2 4","first":"Jacob","key":"steinmetzpau","last":"Steinmetz","locid":"5a72d483-a14d-40ba-8294-4fefb8ec7755","name":"Steinmetz, Jacob","rank":6,"rolecode":"pau"},{"affno":"4","first":"Helle C.","key":"christensenpau","last":"Christensen","locid":"b05bae82-5e32-4f10-980c-147b4af03d6a","name":"Christensen, Helle Collatz","name_org":"Christensen, Helle C.","rank":7,"rolecode":"pau"}],"pmid":["37619443"],"pub":{"doi":"10.1016/j.ajem.2023.08.024","issn":["07356757","15328171"],"issn_org":["07356757"],"journal":"American Journal of Emergency Medicine","pages":"55-62","status":"p","title":"American Journal of Emergency Medicine","volume":"73"},"review":"Peer Reviewed","scoID":["2-s2.0-85168476643"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Region Zealand","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-2bb2ea3e-8a82-4e3b-96b3-5a89a81b3315"],"src":["KU University of Copenhagen"],"title":"Danish Drowning Formula for identification of out-of-hospital cardiac arrest from drowning","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-719671","year":"2023","yearsub":"2023"}
{"abstract":"Background SGLT2 inhibitors, originally developed as glucose-lowering agents for treatment of type 2 diabetes, have been shown to have cardio- and kidney-protective effects among CKD patients with and without diabetes. However, the mechanisms remain largely unknown. Methods Dapagliflozin on EChOcardiographic Measures of CarDiac StructurE and Function in Patients with Chronic Kidney Disease (DECODE-CKD) is an investigator-initiated, prospective, single-center, randomized, placebo-controlled trial evaluating the effects of 6 months of treatment with 10 mg of dapagliflozin compared with placebo on cardiac structure and function in 222 adults with CKD. Results The primary objective was to assess whether dapagliflozin improves left ventricular mass index. Secondary and exploratory end points include changes in cardiac and kidney markers, quality of life, depressive symptoms, and cognitive function. Conclusions This is the first study to address the effects of SGLT2 inhibitors on cardiac structure and function in patients with CKD. The results will provide valuable insights into the mechanisms underlying the cardioprotective benefits of SGLT2 inhibitors in patients with CKD.","author_count":18,"contributors":["Bartholdy, Katja Vu","Johansen, Niklas Dyrby","Landler, Nino","Skaarup, Kristoffer Grundtvig","Jensen, Jesper","Bressendorff, Iain","Schou, Morten","Christensen, Jacob","Feldt-Rasmussen, Bo","Vaduganathan, Muthiah","Solomon, Scott","Haynes, Richard","Persson, Frederik","Rossing, Peter","Køber, Lars","Zannad, Faiez","Hansen, Ditte","Biering-Sørensen, Tor"],"cuid":["S01-000.00-690155"],"filters":{"added":"2023-10","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Europe, EU","Europe, Non-EU","OECD"],"country":["France","United Kingdom","United States"],"glorg":["All Global Affiliations","Harvard University","University of Lorraine","University of Oxford"],"keyword":["CKD","Cardiology","Echocardiography","RCT","SGLT2 inhibitors"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"OT":["Steno Diabetes Centre, Gentofte, Denmark."],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"effects of dapagliflozin on echocardiographic measures of cardiac structure and function in patients with chronic kidney disease the decode ckd trial","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-690155","identifier":[{"id":"PMC10103327","type":"pmcid"},{"id":"36649484","type":"pmid"},{"id":"85162983421","type":"scopus"}],"ids":["ku-a28439a3-3ead-49b7-9d3f-d6f3b020e9bb"],"keyword":["CKD","RCT","SGLT2-inhibitors","cardiology","echocardiography"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-0845435E82372BC0E921AD3F1AB88257"],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Herlev and Gentofte"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal medicine: Cardiology"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"us","key":"harvard university","loc":["United States","America, North","OECD"],"name":"Harvard University","used":1},{"affno":"4","country":"gb","key":"university of oxford","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Oxford","used":1},{"affno":"5","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Steno Diabetes Centre, Gentofte, Denmark."],"nora_code":"DI-OT","used":1},{"affno":"6","country":"fr","key":"university of lorraine","loc":["France","Europe, EU","OECD"],"name":"University of Lorraine","used":1}],"person":[{"affno":"1","first":"Katja Vu","key":"bartholdypau","last":"Bartholdy","name":"Bartholdy, Katja Vu","rank":1,"rolecode":"pau"},{"affno":"1","first":"Niklas Dyrby","key":"johansenpau","last":"Johansen","name":"Johansen, Niklas Dyrby","rank":2,"rolecode":"pau"},{"affno":"1","first":"Nino","key":"landlerpau","last":"Landler","name":"Landler, Nino","rank":3,"rolecode":"pau"},{"affno":"1","first":"Kristoffer Grundtvig","key":"skaaruppau","last":"Skaarup","name":"Skaarup, Kristoffer Grundtvig","rank":4,"rolecode":"pau"},{"affno":"1","first":"Jesper","key":"jensenpau","last":"Jensen","name":"Jensen, Jesper","rank":5,"rolecode":"pau"},{"affno":"1","first":"Iain","key":"bressendorffpau","last":"Bressendorff","name":"Bressendorff, Iain","rank":6,"rolecode":"pau"},{"affno":"2","first":"Morten","key":"schoupau","last":"Schou","locid":"48fa6ec9-1941-4566-b931-14b0cc8cbae3","name":"Schou, Morten","rank":7,"rolecode":"pau"},{"affno":"1","first":"Jacob","key":"christensenpau","last":"Christensen","name":"Christensen, Jacob","rank":8,"rolecode":"pau"},{"affno":"2","first":"Bo","key":"feldtrasmussenpau","last":"Feldt-Rasmussen","locid":"cdd06e7b-83c5-4118-8808-eb4591586aac","name":"Feldt-Rasmussen, Bo","rank":9,"rolecode":"pau"},{"affno":"3","first":"Muthiah","key":"vaduganathanpau","last":"Vaduganathan","name":"Vaduganathan, Muthiah","rank":10,"rolecode":"pau"},{"affno":"3","first":"Scott","key":"solomonpau","last":"Solomon","name":"Solomon, Scott","rank":11,"rolecode":"pau"},{"affno":"4","first":"Richard","key":"haynespau","last":"Haynes","name":"Haynes, Richard","rank":12,"rolecode":"pau"},{"affno":"5","first":"Frederik","key":"perssonpau","last":"Persson","name":"Persson, Frederik","rank":13,"rolecode":"pau"},{"affno":"2","first":"Peter","key":"rossingpau","last":"Rossing","locid":"ca397e2f-e1b3-430b-a537-a047438b44b6","name":"Rossing, Peter","orcid":"0000-0002-1531-4294","rank":14,"rolecode":"pau"},{"affno":"2","first":"Lars","key":"køberpau","last":"Køber","locid":"e3f0c57c-605a-431a-9c63-2213c46621e6","name":"Køber, Lars","rank":15,"rolecode":"pau"},{"affno":"6","first":"Faiez","key":"zannadpau","last":"Zannad","name":"Zannad, Faiez","rank":16,"rolecode":"pau"},{"affno":"2","first":"Ditte","key":"hansenpau","last":"Hansen","locid":"3ef1fd11-e190-4e49-8756-7c51dec3ab7d","name":"Hansen, Ditte","rank":17,"rolecode":"pau"},{"affno":"1","first":"Tor","key":"bieringsørensenpau","last":"Biering-Sørensen","name":"Biering-Sørensen, Tor","rank":18,"rolecode":"pau"}],"pmid":["36649484"],"pub":{"doi":"10.34067/kid.0006982022","issn":["26417650"],"issue":"2","journal":"Kidney360","pages":"143-149","status":"p","title":"Kidney360","volume":"4"},"review":"Peer Reviewed","scoID":["2-s2.0-85162983421"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-a28439a3-3ead-49b7-9d3f-d6f3b020e9bb"],"src":["KU University of Copenhagen"],"title":"Effects of Dapagliflozin on EChOcardiographic Measures of CarDiac StructurE and Function in Patients with Chronic Kidney Disease : The DECODE-CKD Trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-690155","year":"2023","yearsub":"2023"}
{"abstract":"Background Lifeguards may face many life-threatening situations during their careers and may be at increased risk of post-traumatic stress disorder (PTSD). Minimal evidence concerning critical incident management systems in lifeguard organisations exists. Objectives To develop, implement and evaluate an operational system for critical incident management in lifeguard organisations. Methods This retrospective study included data on occupational injury reports from 2013 to 2022 in TrygFonden Surf Lifesaving Denmark. All active lifeguards were invited to evaluate the system and the individual steps using an online questionnaire with three questions rated on a 5-point Likert scale. Primary outcome was a change in the frequency of psychological injury reports after system implementation in 2020. The secondary outcome was the lifeguards' satisfaction with the system. Results After implementation, the average annual number of psychological injury reports increased 6.5-fold from 2 (2013-2019) to 13 (2020-2022), without changes to the number of critical incidents attended by the lifeguards. Sixty-six (33.8%) active lifeguards answered the questionnaire and agreed that follow-up after critical incidents was very important (mean score 4.7/5). Satisfaction with steps 1-2 and 3 of critical incident management among involved lifeguards was high (mean score 4.4/5 and 4.6/5, respectively). The system included an operational workflow diagram and incident report template presented in this study. Conclusions The operational system for critical incident management may improve early recognition of symptoms for the prevention of PTSD. It may be used as a screening and decision tool for referral to a mental health professional.","author_count":4,"contributors":["Breindahl, Niklas","Strange, Kirstine Friderichsen","Østergaard, Doris","Christensen, Helle Collatz"],"cuid":["S01-000.00-423308"],"filters":{"added":"2023-03","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Belgium"],"glorg":["All Global Affiliations","International Life Saving Federation"],"keyword":["Performance","Psychology","Retrospective","Sports medicine","Water Sports"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-ZEA"],"OT":["Trygfonden"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-ZEA","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"evaluation of a critical incident management system on mental health in lifeguard organisations a retrospective study","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/bmjsem-2022-001499","version":"Published Version"},"id":"S01-000.00-423308","identifier":[{"id":"85146893900","type":"scopus"},{"id":"36704713","type":"pmid"},{"id":"PMC9872474","type":"pmcid"}],"ids":["ku-3230eb00-0e2c-470f-95f5-62b8eac0e33e"],"keyword":["performance","psychology","retrospective","sports medicine","water sports"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-E037DCAF25DF1B3748821801F319075E"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://curis.ku.dk/ws/files/335294887/e001499.full.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/bmjsem-2022-001499","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Copenhagen University Hospital - Næstved, Slagelse and Ringsted"],"nora_code":"DI-HO-ZEA","used":1},{"affno":"2","country":"dk","key":"capital region of denmark