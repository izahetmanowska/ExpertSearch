aytham","key":"tlayjehpau","last":"Tlayjeh","name":"Tlayjeh, Haytham","rank":47,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Franc","key":"svenšekpau","last":"Svenšek","name":"Svenšek, Franc","rank":48,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peter J","key":"mcguiganpau","last":"McGuigan","name":"McGuigan, Peter J","rank":49,"rolecode":"pau"}],"pmid":["37318140"],"pub":{"doi":"10.1056/nejmoa2214552","issn":["00284793","15334406"],"issn_org":["00284793"],"issue":"1","journal":"The New England Journal of Medicine","pages":"45-57","publisher":"Massachussetts Medical Society","status":"p","title":"The New England Journal of Medicine","volume":"389"},"review":"Peer Reviewed","scoID":["2-s2.0-85164131143"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-4364afca-aa0c-442a-99b3-88d743a6edd3"],"src":["AU Aarhus University"],"title":"Mild Hypercapnia or Normocapnia after Out-of-Hospital Cardiac Arrest","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-674850","year":"2023","yearsub":"2023"}
{"abstract":"Context: Severe osteodystrophy is common in patients with liver dysfunction. Markers of bone metabolism may help in early diagnosis of osteodystrophy and in understanding underlying pathophysiological mechanisms. Objective: To elucidate changes in bone metabolism associated with cirrhosis and to determine the route of elimination for the markers. Methods: Case-control study at a public university hospital. Fifty-nine patients with cirrhosis (47 alcoholic and 12 nonalcoholic cirrhosis) and 20 controls were included. Participants underwent catheterization of the femoral artery, and the hepatic, renal, and femoral veins with collection of blood from all 4 sites. Regional arteriovenous differences in concentrations of bone metabolism markers were determined: procollagen of type I collagen propeptide (PINP), C-terminal cross-linking telopeptide of type I collagen (CTX), osteocalcin, tartrate-resistant acid phosphatase isoform 5b (TRAcP5b), osteoprotegerin (OPG), and sclerostin and correlated with degree of disease (Child-Pugh classification). Results: PINP concentration was higher (median: 87.9 μg/L) in patients with cirrhosis than in controls (52.6 μg/L) (P =. 001), while hepatic extraction was lower (4.3% vs 14.5%) (P <. 001). Both CTX and TRAcP5b were higher in patients with cirrhosis (340 ng/L and 3.20 U/L) than in controls (215 ng/L and 1.60 U/L) (P <. 001 and P <. 0001). Hepatic sclerostin extraction was lower in patients with cirrhosis (14.6%) than in controls (28.7%) (P <. 0001). In both groups OPG showed a hepatic release rate (production) of 6%. Conclusion: Patients with cirrhosis have increased bone resorption, but unaltered bone formation. Sclerostin is eliminated through the liver while OPG is produced in the liver. Bone markers may prove useful in evaluating bone turnover in patients with cirrhosis.","author_count":6,"contributors":["Jørgensen, Niklas Rye","Diemar, Sarah Seberg","Christensen, Gitte Lund","Kimer, Nina","Danielsen, Karen Vagner","Møller, Søren"],"cuid":["S01-000.00-444871"],"filters":{"added":"2022-04","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Bone turnover","Liver Cirrhosis"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"patients with cirrhosis have elevated bone turnover but normal hepatic production of osteoprotegerin","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-444871","identifier":[{"id":"34718621","type":"pmid"},{"id":"85124850502","type":"scopus"}],"ids":["ku-5612e500-2a18-49d6-87e1-d543449e60c4"],"keyword":["Bone turnover","Liver cirrhosis"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-52B07774CF2238ED464DE8D65BC5EDF5"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Clinical Biochemistry","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","first":"Niklas Rye","key":"jørgensenpau","last":"Jørgensen","locid":"3dc68a95-e26c-4b82-a4f0-7548313f8045","name":"Jørgensen, Niklas Rye","rank":1,"rolecode":"pau"},{"affno":"2","first":"Sarah Seberg","key":"diemarpau","last":"Diemar","name":"Diemar, Sarah Seberg","rank":2,"rolecode":"pau"},{"affno":"2","first":"Gitte Lund","key":"christensenpau","last":"Christensen","name":"Christensen, Gitte Lund","rank":3,"rolecode":"pau"},{"affno":"1","first":"Nina","key":"kimerpau","last":"Kimer","locid":"d8a70dd2-6a83-4894-b5a6-9855c7753fc1","name":"Kimer, Nina","rank":4,"rolecode":"pau"},{"affno":"1","first":"Karen Vagner","key":"danielsenpau","last":"Danielsen","locid":"9d2dd35b-afad-490a-92ed-5efbae1c654e","name":"Danielsen, Karen Vagner","rank":5,"rolecode":"pau"},{"affno":"1","first":"Søren","key":"møllerpau","last":"Møller","locid":"a4bee617-45cc-4a85-a58a-817fb06a5525","name":"Møller, Søren","rank":6,"rolecode":"pau"}],"pmid":["34718621"],"pub":{"doi":"10.1210/clinem/dgab788","issn":["0021972X","19457197"],"issn_org":["0021972X"],"issue":"3","journal":"Journal of Clinical Endocrinology and Metabolism","status":"p","title":"Journal of Clinical Endocrinology and Metabolism","volume":"107"},"review":"Peer Reviewed","scoID":["2-s2.0-85124850502"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-5612e500-2a18-49d6-87e1-d543449e60c4"],"src":["KU University of Copenhagen"],"title":"Patients with Cirrhosis Have Elevated Bone Turnover but Normal Hepatic Production of Osteoprotegerin","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-444871","year":"2022","yearsub":"2022"}
{"abstract":"Background: Lung ultrasound (LUS) is a useful tool for diagnosis and monitoring in patients with active COVID-19-infection. However, less is known about the changes in LUS findings after a hospitalization for COVID-19. Methods: In a prospective, longitudinal study in patients with COVID-19 enrolled from non-ICU hospital units, adult patients underwent 8-zone LUS and blood sampling both during the hospitalization and 2–3 months after discharge. LUS images were analyzed blinded to clinical variables and outcomes. Results: A total of 71 patients with interpretable LUS at baseline and follow up (mean age 64 years, 61% male, 24% with acute respiratory distress syndrome (ARDS)) were included. The follow-up LUS was performed a median of 72 days after the initial LUS performed during hospitalization. At baseline, 87% had pathologic LUS findings in ≥1 zone (e.g. ≥3 B-lines, confluent B-lines or subpleural or lobar consolidation), whereas 30% had pathologic findings at follow-up (p < 0.001). The total number of B-lines and LUS score decreased significantly from hospitalization to follow-up (median 17 vs. 4, p < 0.001 and 4 vs. 0, p < 0.001, respectively). On the follow-up LUS, 28% of all patients had ≥3 B-lines in ≥1 zone, whereas in those with ARDS during the baseline hospitalization (n = 17), 47% had ≥3 B-lines in ≥1 zone. Conclusion: LUS findings improved significantly from hospitalization to follow-up 2–3 months after discharge in COVID-19 survivors. However, persistent B-lines were frequent at follow-up, especially among those who initially had ARDS. LUS seems to be a promising method to monitor COVID-19 lung changes over time. Clinicaltrials.gov ID: NCT04377035.","author_count":26,"contributors":["Espersen, Caroline","Platz, Elke","Alhakak, Alia Saed","Sengeløv, Morten","Simonsen, Jakob Øystein","Johansen, Niklas Dyrby","Davidovski, Filip Søskov","Christensen, Jacob","Bundgaard, Henning","Hassager, Christian","Jabbari, Reza","Carlsen, Jørn","Kirk, Ole","Lindholm, Matias Greve","Kristiansen, Ole Peter","Nielsen, Olav Wendelboe","Jeschke, Klaus Nielsen","Ulrik, Charlotte Suppli","Sivapalan, Pradeesh","Iversen, Kasper","Stæhr Jensen, Jens Ulrik","Schou, Morten","Skaarup, Søren Helbo","Højbjerg Lassen, Mats Christian","Skaarup, Kristoffer Grundtvig","Biering-Sørensen, Tor"],"cuid":["S03-100.00-672722"],"filters":{"added":"2022-06","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"continent":["America, North","OECD"],"corresponding_author":["Espersen, Caroline"],"country":["United States"],"glorg":["All Global Affiliations","Harvard Medical School","Harvard University"],"keyword":["Adult","COVID 19 diagnostic imaging","Cohort Studies","Covid 19","Female","Hospitalization","Humans","Longitudinal Studies","Longitudinal follow up","Lung diagnostic imaging","Lung ultrasound","Male","Middle Aged","Prospective Studies","Respiratory Distress Syndrome diagnostic imaging","Ultrasonography methods"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-SDR","DI-HO-ZEA"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-SDR","DI-HO-ZEA","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"lung ultrasound findings following covid 000000000019 hospitalization a prospective longitudinal cohort study","src":["au","ku","sdu"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.rmed.2022.106826","version":"Published Version"},"funding_acknowledgement":["TBS, together with KGS and MHL, received a research grant from the Novo Nordisk Foundation to conduct the study. Europcar Denmark provided cars for KGS and MHL to transport the equipment from hospital to hospital. TBS received funds from Herlev an