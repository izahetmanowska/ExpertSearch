e":"pau"},{"affno":"","corresponding":null,"first":"Hakon","key":"kampeperssonpau","last":"Kampe-Persson","name":"Kampe-Persson, Hakon","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kees","key":"koffijbergpau","last":"Koffijberg","name":"Koffijberg, Kees","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Vasiliy","key":"kostiushynpau","last":"Kostiushyn","name":"Kostiushyn, Vasiliy","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Niklas","key":"liljebäckpau","last":"Liljebäck","name":"Liljebäck, Niklas","rank":8,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Carl","key":"mitchellpau","last":"Mitchell","name":"Mitchell, Carl","rank":9,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Leif","key":"nilssonpau","last":"Nilsson","name":"Nilsson, Leif","rank":10,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Sonia","key":"rozenfeldpau","last":"Rozenfeld","name":"Rozenfeld, Sonia","rank":11,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Ulf","key":"skyllbergpau","last":"Skyllberg","name":"Skyllberg, Ulf","rank":12,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Mikko","key":"alhainenpau","last":"Alhainen","name":"Alhainen, Mikko","rank":13,"rolecode":"pau"}],"pub":{"pages":"21","place":"S.l.","publisher":"AEWA European Goose Management Platform Data Centre","status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-7b696b33-ab8c-4cfd-b480-78bf8d6c9d20"],"src":["AU Aarhus University"],"title":"Taiga Bean Goose Population Status Report 2019-2020 : Report prepared by the AEWA European Goose Management Platform (EGMP) Data Centre","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-199937","year":"2020","yea