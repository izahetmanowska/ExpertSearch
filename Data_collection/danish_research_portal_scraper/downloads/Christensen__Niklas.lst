f Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Signe Amalie","key":"woltherspau","last":"Wolthers","name":"Wolthers, Signe Amalie","rank":1,"rolecode":"pau"},{"affno":"2 1","corresponding":null,"first":"Stig Nikolaj Fasmer","key":"blombergpau","last":"Blomberg","name":"Blomberg, Stig Nikolaj Fasmer","rank":2,"rolecode":"pau"},{"affno":"1","first":"Niklas","key":"breindahlpau","last":"Breindahl","name":"Breindahl, Niklas","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Sair","key":"anjumpau","last":"Anjum","name":"Anjum, Sair","rank":4,"rolecode":"pau"},{"affno":"3 2 4","corresponding":null,"first":"Daniel","key":"hägipedersenpau","last":"Hägi-Pedersen","locid":"c2f688f1-c881-4983-b7c2-702951e6e9bb","name":"Hägi-Pedersen, Daniel","orcid":"0000-0001-8008-6614","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Annette","key":"ersbøllpau","last":"Ersbøll","locid":"ba343517-a6c5-47c1-a8ba-4cbe00b7409c","name":"Ersbøll, Annette Kjær","name_org":"Ersbøll, Annette","orcid":"0000-0002-9407-3387","rank":6,"rolecode":"pau"},{"affno":"2 1","corresponding":null,"first":"Lars Bredevang","key":"andersenpau","last":"Andersen","name":"Andersen, Lars Bredevang","rank":7,"rolecode":"pau"},{"affno":"4 1","first":"Helle Collatz","key":"christensenpau","last":"Christensen","locid":"b05bae82-5e32-4f10-980c-147b4af03d6a","name":"Christensen, Helle Collatz","rank":8,"rolecode":"pau"}],"pmid":["37739475"],"pub":{"doi":"10.1136/bmjopen-2023-075592","issn":["20446055"],"issue":"9","journal":"BMJ Open","paperid":"e075592","publisher":"BMJ Publishing Group","status":"p","title":"BMJ Open","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-85172425095"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Region Zealand","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-92a6bb7f-b9ac-4f6a-909b-7458a2419b7d","sdu-728d919f-0b5d-452c-8007-5348636c7a8f"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Association between using a prehospital assessment unit and hospital admission and mortality : A matched cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-716461","year":"2023","yearsub":"2023"}
{"abstract":"Study objectives: The assay currently used worldwide to measure cerebrospinal fluid hypocretin-1 (CSF-hcrt-1) for diagnosing narcolepsy uses a competitive radioimmunoassay with polyclonal anti-hcrt-1 antibodies. This assay detects multiple hypocretin-1 immunoreactive species in the CSF that are all derived from full-length hcrt-1. We aimed to revalidate CSF-hcrt-1 cut-offs for narcolepsy type 1 (NT1) diagnosis and to evaluate temporal changes in CSF-hcrt-1 levels in patients suspected of having central hypersomnia. Method: We carried out a repeat lumbar puncture with a mean follow-up of 4.0 years, to measure CSF-hcrt-1 in patients suspected of having central hypersomnia in a follow-up study. Data from CSF samples of patients with NT1 and of controls without known hypersomnia, from the Italian–Stanford and Danish populations, were examined using a receiver-operating characteristic analysis. Results: The optimal CSF-hcrt-1 cut-offs for identifying NT1 were 129 pg/ml and 179 pg/ml for the Italian-Stanford and Danish populations, respectively. The sensitivity was 0.93–0.99 and the specificity was 1. Follow-up lumbar puncture measurements of CSF-hcrt-1 were obtained from 73 patients. 30 of 32 patients with low CSF-hcrt-1 levels continued to be categorized as low, with an unaltered diagnosis; two patients showed a marked increase in CSF-hcrt-1, attaining normal values at follow-up. One of these patients relapsed to low CSF-hcrt-1 after follow-up. All 41 patients with normal CSF-hcrt-1 at baseline had normal CSF-hcrt-1 at follow-up. Conclusion: CSF-hcrt-1 measurement can provide an accurate test for diagnosing NT1, although it is important to validate the CSF-hcrt-1 cut-off for specific testing locations. Stable CSF-hcrt-1 levels support the already established prognosis of narcolepsy as permanent once the disorder has fully developed.","author_count":12,"contributors":["Torstensen, Eva Wiberg","Haubjerg Østerby, Niels Christian","Pizza, Fabio","Plazzi, Giuseppe","Antelmi, Elena","Moresco, Monica","Mignot, Emmanuel","Jørgensen, Niklas Rye","Christensen, Gitte Lund","Wanscher, Benedikte","Kornum, Birgitte Rahbek","Jennum, Poul"],"cuid":["S01-000.00-487988"],"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Europe, EU","OECD"],"country":["Italy","United States"],"glorg":["All Global Affiliations","IRCCS Istituto delle Scienze Neurologiche di Bologna","Stanford University","University of Bologna","University of Modena and Reggio Emilia","University of Verona"],"keyword":["Diagnostic validation","Orexin","Radioimmunoassay"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-ZEA"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-HO-ZEA","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"repeated measures of hypocretin 000000000001 in danish and italian patients with narcolepsy and in controls","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-487988","identifier":[{"id":"36427467","type":"pmid"},{"id":"85143167031","type":"scopus"}],"ids":["ku-9e345328-a42d-4d61-8722-757f87c4fa06"],"keyword":["Catalepsy","Central hypersomnia","Diagnostic-validation","Orexin","Radioimmunoassay"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-3C1E8443B4701C5E2EA5B3377DC3F5A0"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","country":"it","key":"university of bologna","loc":["Italy","Europe, EU","OECD"],"name":"University of Bologna","used":1},{"affno":"4","country":"it","key":"irccs istituto delle scienze neurologiche di bologna","loc":["Italy","Europe, EU","OECD"],"name":"IRCCS Istituto delle Scienze Neurologiche di Bologna","used":1},{"affno":"5","country":"it","key":"university of modena and reggio emilia","loc":["Italy","Europe, EU","OECD"],"name":"University of Modena and Reggio Emilia","used":1},{"affno":"6","country":"it","key":"university of verona","loc":["Italy","Europe, EU","OECD"],"name":"University of Verona","used":1},{"affno":"7","country":"us","key":"stanford university","loc":["United States","America, North","OECD"],"name":"Stanford University","used":1},{"affno":"8","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Copenhagen University Hospital - Næstved, Slagelse and Ringsted"],"nora_code":"DI-HO-ZEA","used":1}],"person":[{"affno":"1 2","first":"Eva Wiberg","key":"torstensenpau","last":"Torstensen","locid":"b78397a9-ad5c-4363-b81d-207fcc4e1e50","name":"Torstensen, Eva Wiberg","rank":1,"rolecode":"pau"},{"affno":"2","first":"Niels Christian","key":"haubjergøsterbypau","last":"Haubjerg Østerby","name":"Haubjerg Østerby, Niels Christian","rank":2,"rolecode":"pau"},{"affno":"3 4","first":"Fabio","key":"pizzapau","last":"Pizza","name":"Pizza, Fabio","rank":3,"rolecode":"pau"},{"affno":"4 5","first":"Giuseppe","key":"plazzipau","last":"Plazzi","name":"Plazzi, Giuseppe","rank":4,"rolecode":"p