en university hospital - holbæk","danish air ambulance"],"PST":["Published"]},"sid":["au-bf374a31-fe8a-45d4-9417-6bb28e740a94","ku-94184c12-cf4a-40d5-8060-83abd1edc14a","sdu-5cff08e6-292a-4e1d-87cc-c02ad1c66dc9"],"src":["AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Prehospital interventions and outcomes in traumatic cardiac arrest : A population-based cohort study using the Danish Helicopter Emergency Medical Services data","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-100.00-756090","year":"2024","yearsub":"2024"}
{"abstract":"BACKGROUND: The role of calcitonin gene-related peptide (CGRP) in the cyclic pattern of cluster headache is unclear. To acquire biological insight and to comprehend why only episodic cluster headache responds to CGRP monoclonal antibodies, we examined whether plasma CGRP changes between disease states (i.e. bout, remission and chronic) and controls. METHODS: The present study is a prospective case-control study. Participants with episodic cluster headache were sampled twice (bout and remission). Participants with chronic cluster headache and controls were sampled once. CGRP concentrations were measured in plasma with a validated radioimmunoassay. RESULTS: Plasma was collected from 201 participants diagnosed with cluster headache according to the International Classification of Headache Disorders, 3rd edition, and from 100 age- and sex-matched controls. Overall, plasma CGRP levels were significantly lower in participants with cluster headache compared to controls (p < 0.05). In episodic cluster headache, CGRP levels were higher in bout than in remission (mean difference: 17.1 pmol/L, 95% confidence interval = 9.8-24.3, p < 0.0001). CGRP levels in bout were not different from chronic cluster headache (p = 0.266). CONCLUSIONS: Plasma CGRP is unsuitable as a diagnostic biomarker of cluster headache or its disease states. The identified reduced CGRP levels suggest that CGRPs role in cluster headache is highly complex and future investigations are needed into the modulation of CGRP and its receptors.","author_count":8,"contributors":["Petersen, Anja Sofie","Lund, Nunu","Meßlinger, Karl","Christensen, Sarah Louise","Barloese, Mads","Jørgensen, Niklas Rye","Kogelman, Lisette","Jensen, Rigmor Højland"],"cuid":["S01-000.00-732112"],"filters":{"added":"2024-05","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","Friedrich-Alexander University Erlangen-Nürnberg"],"keyword":["CGRP","Chronic","Remission"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"reduced plasma calcitonin gene related peptide level identified in cluster headache a prospective and controlled study","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1177/03331024231223970","version":"Published Version"},"id":"S01-000.00-732112","identifier":[{"id":"85186956435","type":"scopus"},{"id":"38436282","type":"pmid"}],"ids":["ku-adc0cf63-2be9-478d-b99a-b1563f080216"],"keyword":["Bout","CGRP","cephalalgias","chronic","healthy control","remission","trigeminal autonomic"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-AF6157BFBC6155B1902A1E1A99C968EB"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1177/03331024231223970","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://curis.ku.dk/ws/files/385694159/petersen_et_al_2024_reduced_plasma_calcitonin_gene_related_peptide_level_identified_in_cluster_headache_a_prospective.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","country":"de","key":"friedrich alexander university erlangen nürnberg","loc":["Germany","Europe, EU","OECD"],"name":"Friedrich-Alexander University Erlangen-Nürnberg","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Anja Sofie","key":"petersenpau","last":"Petersen","name":"Petersen, Anja Sofie","rank":1,"rolecode":"pau"},{"affno":"1","first":"Nunu","key":"lundpau","last":"Lund","name":"Lund, Nunu","rank":2,"rolecode":"pau"},{"affno":"2","first":"Karl","key":"meßlingerpau","last":"Meßlinger","name":"Meßlinger, Karl","rank":3,"rolecode":"pau"},{"affno":"1","first":"Sarah Louise","key":"christensenpau","last":"Christensen","name":"Christensen, Sarah Louise","rank":4,"rolecode":"pau"},{"affno":"3 1","first":"Mads","key":"barloesepau","last":"Barloese","locid":"b88e9ee6-67ef-41b7-93a6-735e1645f516","name":"Barloese, Mads","rank":5,"rolecode":"pau"},{"affno":"1 3","first":"Niklas Rye","key":"jørgensenpau","last":"Jørgensen","locid":"3dc68a95-e26c-4b82-a4f0-7548313f8045","name":"Jørgensen, Niklas Rye","rank":6,"rolecode":"pau"},{"affno":"1","first":"Lisette","key":"kogelmanpau","last":"Kogelman","name":"Kogelman, Lisette","rank":7,"rolecode":"pau"},{"affno":"1 3","first":"Rigmor Højland","key":"jensenpau","last":"Jensen","locid":"ba001bf1-101a-4d39-b06f-d5c44f83da58","name":"Jensen, Rigmor Højland","rank":8,"rolecode":"pau"}],"pmid":["38436282"],"pub":{"doi":"10.1177/03331024231223970","issn":["03331024","08001952"],"issn_org":["08001952"],"issue":"3","journal":"Cephalalgia : an international journal of headache","status":"p","title":"Cephalalgia : an international journal of headache","volume":"44"},"review":"Peer Reviewed","scoID":["2-s2.0-85186956435"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-adc0cf63-2be9-478d-b99a-b1563f080216"],"src":["KU University of Copenhagen"],"title":"Reduced plasma calcitonin gene-related peptide level identified in cluster headache : A prospective and controlled study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-732112","year":"2024","yearsub":"2024"}
{"abstract":"Background: The purinergic P2X7 receptor (P2X7R) plays an important role in the crosstalk between pancreatic stellate cells (PSCs) and cancer cells, thus promoting progression of pancreatic ductal adenocarcinoma (PDAC). Single nucleotide polymorphisms (SNPs) in the P2X7R have been reported for several cancers, but have not been explored in PDAC. Materials and methods: Blood samples from PDAC patients and controls were genotyped for 11 non-synonymous SNPs in P2X7R and a risk analysis was performed. Relevant P2X7R-SNP GFP variants were expressed in PSCs and cancer cells and their function was assayed in the following tests. Responses in Ca2+ were studied with Fura-2 and dye uptake with YO-PRO-1. Cell migration was monitored by fluorescence microscopy. Released cytokines were measured with MSD assay. Results: Risk analysis showed that two SNPs 474G>A and 853G>A (rs28360447, rs7958316), that lead to the Gly150Arg and Arg276His variants, had a significant but opposite risk association with PDAC development, protecting against and predisposing to the disease, respectively. In vitro experiments performed on cancer cells and PSCs expressing the Gly150Arg variant showed reduced intracellular Ca2+ response, fluorescent dye uptake, and cell migration, while the Arg276His variant reduced dye uptake but displayed WT-like Ca2+ responses. As predicted, P2X7R was involved in cytokine release (IL-6, IL-1β, IL-8, TNF-α), but the P2X7R inhibitors displayed varied effects. Conclusion: In conclusion, we provide evidence for the P2X7R SNPs association with PDAC and propose that they could be considered as potential biomarkers.","author_count":11,"contributors":["Magni, Lara","Yu, Haoran","Christensen, Nynne M.","Poulsen, Mette Homann","Frueh, Alexander","Deshar, Ganga","Johansen, Astrid Z.","Johansen, Julia S.","Pless, Stephan A.","Jørgensen, Niklas Rye","Novak, Ivana"],"cuid":["S01-000.00-740040"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["IL 6","Pancreatic cancer cells","Pancreatic ductal adenocarcinoma","Pancreatic stellate cells","SNP"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"human p000000000002x000000000007 receptor variants gly000000000150arg and arg000000000276his polymorphisms have differential effects on risk association and cellular functions in pancreatic cancer","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12935-024-03339-9","version":"Published Version"},"id":"S01-000.00-740040","identifier":[{"id":"PMC11044319","type":"pmcid"},{"id":"38664691","type":"pmid"},{"id":"85191417683","type":"scopus"}],"ids":["ku-ee5a71e6-bdf1-48fb-80ef-91dfcc3e2338"],"keyword":["IL-6","P2X7R","Pancreatic cancer cells","Pancreatic ductal adenocarcinoma","Pancreatic stellate cells","SNP"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-B919C053F9F34449FCA6B0450E46575D"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/391154017/s12935_024_03339_9.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12935-024-03339-9","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Biology, Cell Biology and Physiology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Herlev and Gentofte"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","first":"Lara","key":"magnilarapau","last":"Magni","locid":"ae17e367-0b96-44e4-9df5-8791cfb1d39b","name":"Magni, Lara","rank":1,"rolecode":"pau"},{"affno":"1","first":"Haoran","key":"yuhaoranpau","last":"Yu","locid":"4b83270d-59f2-4dea-82fe-3b7d64a1ca22","name":"Yu, Haoran","rank":2,"rolecode":"pau"},{"affno":"1","first":"Nynne M.","key":"christensennynnempau","last":"Christensen","locid":"222cf1d1-5fac-4f91-9577-8e954d4bc89c","name":"Christensen, Nynne M.","rank":3,"rolecode":"pau"},{"affno":"1","first":"Mette H.","key":"poulsenmettehomannpau","last":"Poulsen","locid":"2e521080-f37a-4585-94ec-b91feb2baeec","name":"Poulsen, Mette Homann","name_org":"Poulsen, Mette H.","orcid":"0000-0003-2162-3007","rank":4,"rolecode":"pau"},{"affno":"1","first":"Alexander","key":"fruehalexanderpau","last":"Frueh","name":"Frueh, Alexander","rank":5,"rolecode":"pau"},{"affno":"1","first":"Ganga","key":"deshargangapau","last":"Deshar","locid":"bd978d4f-d3c7-4ade-8cda-e358657b99a9","name":"Deshar, Ganga","orcid":"0000-0002-7295-8731","rank":6,"rolecode":"pau"},{"affno":"2","first":"Astrid Z.","key":"johansenastridzpau","last":"Johansen","name":"Johansen, Astrid Z.","rank":7,"rolecode":"pau"},{"affno":"2","first":"Julia S.","key":"johansenjuliaspau","last":"Johansen","name":"Johansen, Julia S.","rank":8,"rolecode":"pau"},{"affno":"1","first":"Stephan A.","key":"plessstephanapau","last":"Pless","locid":"aebe453f-b19d-49c1-9eac-857e730086d1","name":"Pless, Stephan A.","orcid":"0000-0001-6654-114X","rank":9,"rolecode":"pau"},{"affno":"1","first":"Niklas R.","key":"jørgensenniklasryepau","last":"Jørgensen","locid":"3dc68a95-e26c-4b82-a4f0-7548313f8045","name":"Jørgensen, Niklas Rye","name_org":"Jørgensen, Niklas R.","rank":10,"rolecode":"pau"},{"affno":"1","first":"Ivana","key":"novakivanapau","last":"Novak","locid":"b9c12be3-f582-4213-9654-76677c2f3ff7","name":"Novak, Ivana","orcid":"0000-0002-8917-8010","rank":11,"rolecode":"pau"}],"pmid":["38664691"],"pub":{"doi":"10.1186/s12935-024-03339-9","issn":["14752867"],"issue":"1","journal":"Cancer Cell International","paperid":"148","status":"p","title":"Cancer Cell International","volume":"24"},"review":"Peer Reviewed","scoID":["2-s2.0-85191417683"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-ee5a71e6-bdf1-48fb-80ef-91dfcc3e2338"],"src":["KU University of Copenhagen"],"title":"Human P2X7 receptor variants Gly150Arg and Arg276His polymorphisms have differential effects on risk association and cellular functions in pancreatic cancer","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-740040","year":"2024","yearsub":"2024"}
{"abstract":"Objectives: Morning influenza vaccination enhances antibody response. In this post hoc analysis of the DANFLU-1 trial, we sought to evaluate the association between time of day for vaccination (ToV) and outcomes and whether ToV modified the relative effectiveness of high-dose (QIV-HD) vs. standard-dose (QIV-SD) quadrivalent influenza vaccine. Methods: DANFLU-1 was a pragmatic feasibility trial of QIV-HD vs. QIV-SD. Outcomes included hospitalizations and mortality. For subgroup analysis, the population was dichotomized at median ToV into two groups (early and late). Results: The study population included 12,477 participants. Mean age was 71.7 ± 3.9 years with 5877 (47.1%) female participants. Median ToV was 11.29 AM. Earlier ToV was associated with fewer respiratory hospitalizations independent of vaccine type, which persisted in adjusted analysis (IRR 0.88 per 1-hour decrement (95% CI 0.78- 0.98, p = 0.025). No effect modification by continuous or dichotomous ToV was found. In subgroup analysis, effects consistently favored QIV-HD against hospitalizations for pneumonia or influenza (early: IRR 0.30; late: 0.29), all-cause hospitalizations (early: IRR 0.87; late: 0.86), and mortality (early: HR 0.53; late: 0.50). Conclusion: In this exploratory post hoc analysis, earlier ToV was associated with fewer respiratory hospitalizations. The relative effectiveness of QIV-HD vs. QIV-SD was not modified by ToV. Further research is needed to confirm findings. Trial registration: Clinicaltrials.gov: NCT05048589","author_count":20,"contributors":["Christensen, Jacob","Johansen, Niklas Dyrby","Janstrup, Kira Hyldekær","Modin, Daniel","Skaarup, Kristoffer Grundtvig","Nealon, Joshua","Samson, Sandrine","Loiacono, Matthew","Harris, Rebecca","Larsen, Carsten Schade","Jensen, Anne Marie Reimer","Landler, Nino Emanuel","Claggett, Brian L.","Solomon, Scott D.","Gislason, Gunnar H.","Køber, Lars","Landray, Martin J.","Sivapalan, Pradeesh","Jensen, Jens Ulrik Stæhr","Biering-Sørensen, Tor"],"cuid":["S02-099.90-761766"],"filters":{"added":"2024-11","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","Asia, South","Europe, EU","Europe, Non-EU","OECD"],"corresponding_author":["Biering-Sørensen, Tor"],"country":["France","Singapore","United Kingdom","United States"],"glorg":["All Global Affiliations","Harvard University","Sanofi","Sanofi USA","University of Oxford"],"keyword":["Health care","Human","Influenza","Outcome assessment","Pragmatic clinical trial","Vaccination"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-PR","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-STENO"],"OT":["Steno Diabetes Centre, Gentofte, Denmark."],"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-STENO","DI-PR-OTH","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"time of day for vaccination outcomes and relative effectiveness of high dose vs standard dose quadrivalent influenza vaccine a post hoc analysis of the danflu 000000000001 randomized clinical trial","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.jinf.2024.106276","version":"Published Version"},"id":"S02-099.90-761766","identifier":[{"id":"39303788","type":"pmid"},{"id":"85205017556","type":"scopus"}],"ids":["au-71b57deb-eb9c-40db-8d6c-05b18d2a4324","ku-4531b9ec-a56c-47bc-8f76-610cff75ca18"],"keyword":["Health care","Human","Influenza","Outcome assessment","Pragmatic clinical trial","Vaccination"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-21B736220234B6F4292BA059904221E8"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.jinf.2024.106276","v