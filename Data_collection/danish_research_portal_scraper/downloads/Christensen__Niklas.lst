olecode":"pau"},{"affno":"1","first":"Julie L.B.","key":"kjerulffjulielbpau","last":"Kjerulff","name":"Kjerulff, Julie L.B.","rank":4,"rolecode":"pau"},{"affno":"1","first":"Sara H.","key":"breindahlsarahpau","last":"Breindahl","name":"Breindahl, Sara H.","rank":5,"rolecode":"pau"},{"affno":"4","first":"Stig Nikolaj Fasmer","key":"blombergstignikolajpau","last":"Blomberg","locid":"5a3912f5-540e-4f29-a5c6-5f28d1327eb0","name":"Blomberg, Stig Nikolaj","name_org":"Blomberg, Stig Nikolaj Fasmer","rank":6,"rolecode":"pau"},{"affno":"3","first":"Signe Amalie","key":"woltherssigneamaliepau","last":"Wolthers","name":"Wolthers, Signe Amalie","rank":7,"rolecode":"pau"},{"affno":"3","first":"Lars Bredevang","key":"andersenlarsbredevangpau","last":"Andersen","name":"Andersen, Lars Bredevang","rank":8,"rolecode":"pau"},{"affno":"4 1","first":"Christian","key":"torppedersenchristianpau","last":"Torp-Pedersen","locid":"f71bedc6-3736-4559-b937-6a18e770616e","name":"Torp-Pedersen, Christian","rank":9,"rolecode":"pau"},{"affno":"4","first":"Freddy","key":"lippertfreddypau","last":"Lippert","locid":"48ac5d81-3437-4345-b6c3-394683a09d5d","name":"Lippert, Freddy","orcid":"0000-0002-2356-8809","rank":11,"rolecode":"pau"},{"affno":"4 3","first":"Helle Collatz","key":"christensenhellecollatzpau","last":"Christensen","locid":"b05bae82-5e32-4f10-980c-147b4af03d6a","name":"Christensen, Helle Collatz","rank":12,"rolecode":"pau"}],"pmid":["36397074"],"pub":{"doi":"10.1186/s13049-022-01045-x","issn":["17577241"],"journal":"Scandinavian Journal of Trauma, Resuscitation and Emergency Medicine","paperid":"58","publisher":"BioMed Central","status":"p","title":"Scandinavian Journal of Trauma, Resuscitation and Emergency Medicine","volume":"30"},"review":"Peer Reviewed","scoID":["2-s2.0-85142186341"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Region Zealand","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-4bec8e39-4958-4cf4-b3fc-ce6c9c7c3caa","sdu-ab3158e9-a195-4eef-8495-f89b2a3df244"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Pediatric out-of-hospital cardiac arrest in Denmark","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-042207","year":"2022","yearsub":"2022"}
{"abstract":"Introduction The COVID-19 pandemic caused by the virus SARS-CoV has spread rapidly and caused damage worldwide. Data suggest a major overrepresentation of hypertension and diabetes among patients experiencing severe courses of COVID-19 including COVID-19-related deaths. Many of these patients receive renin-angiotensin system (RAS) inhibiting therapy, and evidence suggests that treatment with angiotensin II receptor blockers (ARBs) could attenuate SARS-CoV-induced acute respiratory distress syndrome, and ACE inhibitors and ARBs have been suggested to alleviate COVID-19 pulmonary manifestations. This randomised clinical trial will address whether RAS inhibiting therapy should be continued or discontinued in hospitalised patients with COVID-19. Methods and analysis This trial is a 30-day randomised parallel-group non-inferiority clinical trial with an embedded mechanistic substudy. In the main trial, 215 patients treated with a RAS inhibitor will be included. The participants will be randomly assigned in a 1:1 ratio to either discontinue or continue their RAS inhibiting therapy in addition to standard care. The patients are included during hospitalisation and followed for a period of 30 days. The primary end point is number of days alive and out of hospital within 14 days after recruitment. In a mechanistic substudy, 40 patients treated with RAS inhibition, who are not in hospital and not infected with COVID-19 will be randomly assigned to discontinue or continue their RAS inhibiting therapy with the primary end point of serum ACE2 activity. Ethics and dissemination This trial has been approved by the Scientific-Ethical Committee of the Capital Region of Denmark (identification no. H-20026484), the Danish Medicines Agency (identification no. 2020040883) and by the Danish Data Protection Agency (P-2020-366). The results of this project will be compiled into one or more manuscripts for publication in international peer-reviewed scientific journals. Trial registration number 2020-001544-26; NCT04351581.","author_count":13,"contributors":["Kliim-Hansen, Vivian","Gasbjerg, Lærke S.","Ellegaard, Anne Marie","Lorentsson, Hans Johan Niklas","Lynggaard, Mads Bank","Hagemann, Christoffer Andersen","Legart, Christian","Mathiesen, David Siersbæk","Sivapalan, Pradeesh","Jensen, Jens Ulrik Stæhr","Vilsbøll, Tina","Christensen, Mikkel Bring","Knop, Filip K."],"cuid":["S01-000.00-486554"],"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Covid 19","GENERAL MEDICINE see Internal Medicine","Hypertension"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-PR","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"PR":["DI-PR-ALL","DI-PR-GUB"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-PR-GUB","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"protocol for a 000000000030 day randomised parallel group non inferiority controlled trial investigating the effects of discontinuing renin angiotensin system inhibitors in patients with and without covid 000000000019 the rascovid 000000000019 trial","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/bmjopen-2022-062895","version":"Published Version"},"id":"S01-000.00-486554","identifier":[{"id":"36450422","type":"pmid"},{"id":"85143092675","type":"scopus"},{"id":"000924552900007","type":"wos"},{"id":"PMC9716414","type":"pmcid"}],"ids":["ku-9bbede25-8cdc-47dd-95a0-a7b03a36429a"],"keyword":["COVID-19","general medicine (see internal medicine)","hypertension"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-5C2529A2AA3A197FD1379FC630409C8E"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/bmjopen-2022-062895","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://curis.ku.dk/ws/files/329302076/e062895.full.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Biomedical Sciences, Molecular and Translational Pharmacology"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"dk","key":"gubra","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-GUB","l3nl":"Gubra","l3nn":"Gubra","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Gubra","namevar":["Gubra"],"nora_code":"DI-PR-GUB","used":1}],"person":[{"affno":"1","first":"Vivian","key":"kliimhansenpau","last":"Kliim-Hansen","name":"Kliim-Hansen, Vivian","rank":1,"rolecode":"pau"},{"affno":"2","first":"Lærke Smidt","key":"gasbjergpau","last":"Gasbjerg","locid":"38691fd4-0b1c-4371-b423-954525f5f9b3","name":"Gasbjerg, Lærke S.","name_org":"Gasbjerg, Lærke Smidt","orcid":"0000-0002-7880-8515","rank":2,"rolecode":"pau"},{"affno":"1","first":"Anne Marie","key":"ellegaardpau","last":"Ellegaard","name":"Ellegaard, Anne Marie","rank":3,"rolecode":"pau"},{"affno":"2","first":"Hans Johan Niklas","key":"lorentssonpau","last":"Lorentsson","locid":"66d78f1e-b2ed-482f-96b8-b053ff227f4c","name":"Lorentsson, Hans Johan Niklas","rank":4,"rolecode":"pau"},{"affno":"1","first":"Mads Bank","key":"lynggaardpau","last":"Lynggaard","name":"Lynggaard, Mads Bank","rank":5,"rolecode":"pau"},{"affno":"1 3","first":"Christoffer Andersen","key":"hagemannpau","last":"Hagemann","name":"Hagemann, Christoffer Andersen","rank":6,"rolecode":"pau"},{"affno":"1","first":"Christian","key":"legartpau","last":"Legart","name":"Legart, Christian","rank":7,"rolecode":"pau"},{"affno":"1","first":"David Siersbæk","key":"mathiesenpau","last":"Mathiesen","name":"Mathiesen, David Siersbæk","rank":8,"rolecode":"pau"},{"affno":"1","first":"Pradeesh","key":"sivapalanpau","last":"Sivapalan","name":"Sivapalan, Pradeesh","rank":9,"rolecode":"pau"},{"affno":"2","first":"Jens Ulrik Stæhr","key":"jensenpau","last":"Jensen","locid":"d9593acd-d6ae-4a83-a7c8-64bc2ea541ac","name":"Jensen, Jens Ulrik Stæhr","orcid":"0000-0003-4036-0521","rank":10,"rolecode":"pau"},{"affno":"2","first":"Tina","key":"vilsbøllpau","last":"Vilsbøll","locid":"76773372-af8c-45a0-9447-a509cbf6d466","name":"Vilsbøll, Tina","orcid":"0000-0002-0456-6787","rank":11,"rolecode":"pau"},{"affno":"2","first":"Mikkel Bring","key":"christensenpau","last":"Christensen","locid":"4f5c91e2-3caa-4263-8d9c-df3bfdfbd31b","name":"Christensen, Mikkel Bring","rank":12,"rolecode":"pau"},{"affno":"2","first":"Filip Krag","key":"knoppau","last":"Knop","locid":"ce6eaad9-59f8-4ecf-8a1e-388a74734f6a","name":"Knop, Filip K.","name_org":"Knop, Filip Krag","rank":13,"rolecode":"pau"}],"pmid":["36450422"],"pub":{"doi":"10.1136/bmjopen-2022-062895","issn":["20446055"],"issue":"11","journal":"BMJ Open","paperid":"e062895","status":"p","title":"BMJ Open","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-85143092675"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Private Research","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Gubra","Hospitals","Private Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-9bbede25-8cdc-47dd-95a0-a7b03a36429a"],"src":["KU University of Copenhagen"],"title":"Protocol for a 30-day randomised, parallel-group, non-inferiority, controlled trial investigating the effects of discontinuing renin-angiotensin system inhibitors in patients with and without COVID-19 : The RASCOVID-19 trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-486554","year":"2022","yearsub":"2022"}
{"abstract":"Objectives: Ethnic groups differ in prevalence of calcium-related diseases. Differences in the physiology and the endogenous circadian rhythm (CR) of calcium and bone homeostasis may play a role. Thus, we aimed to investigate details of CR pattern in calcium and bone homeostasis in East African Maasai. Methods: Ten clinically healthy adult Maasai men and women from Tanzania were examined. Blood samples were collected every 2nd hour for 24 h. Serum levels of total calcium, albumin, parathyroid hormone (PTH), 25(OH)D, creatinine, C-terminal telopeptide (CTX), bone-specific alkaline phosphatase (BSAP), procollagen type 1 N-terminal propeptide (P1NP), and osteocalcin were measured. Circadian patterns were derived from graphic curves of medians, and rhythmicity was assessed with Fourier analysis. Results: PTH-levels varied over the 24 h exhibiting a bimodal pattern. Nadir level corresponded to 65% of total 24-h mean. CTX and P1NP showed 24-h variations with a morning nadir and nocturnal peak with nadir levels corresponding to 23% and 79% of the 24-h mean, respectively. Albumin-corrected calcium level was held in a narrow range and alterations were corresponding to alterations in PTH. There was no distinct pattern in 24-h variations of 25(OH)D, creatinine, osteocalcin, or BSAP. Conclusions: All participants showed pronounced 24-h variations in PTH and bone turnover markers CTX and P1NP. These findings support that Maasai participants included in this study have typical patterns of CR in calcium and bone homeostasis consistent with findings from other ethnic populations.","author_count":9,"contributors":["Schou, Anne Sophie","Jørgensen, Niklas Rye","Maro, Venance Phillip","Kilonzo, Kajiru","Ramaiya, Kaushik","Sironga, Joseph","Jensen, Andreas Kryger","Christensen, Dirk Lund","Schwarz, Peter"],"cuid":["S01-000.00-502883"],"filters":{"added":"2022-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Africa"],"country":["Tanzania"],"glorg":["All Global Affiliations","Kilimanjaro Christian Medical College","Monduli District Hospital","Shree Hindu Mandal Hospital, Dar es Salam,Tanzania"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the circadian rhythm of calcium and bone homeostasis in maasai","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1002/ajhb.23756","version":"Published Version"},"id":"S01-000.00-502883","identifier":[{"id":"85128951504","type":"scopus"},{"id":"35481615","type":"pmid"},{"id":"PMC9539595","type":"pmcid"}],"ids":["ku-b73f1c88-cd76-4506-bcc9-b49430f3eb60"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-44817DEDF79215D46A7EF38733D8C460"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/317947420/Fulltext.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1002/ajhb.23756","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Global Health Section"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","country":"tz","key":"kilimanjaro christian medical college","loc":["Tanzania","Africa"],"name":"Kilimanjaro Christian Medical College","used":1},{"affno":"4","country":"tz","key":"shree hindu mandal hospital dar es salam tanzania","loc":["Tanzania","Africa"],"name":"Shree Hindu Mandal Hospital, Dar es Salam,Tanzania","used":1},{"affno":"5","country":"tz","key":"monduli district hospital","loc":["Tanzania","Africa"],"name":"Monduli District Hospital","used":1}],"person":[{"affno":"1 2","first":"Anne","key":"schoupau","last":"Schou","locid":"64588edf-ef59-469e-b7d8-99dfb9c1e297","name":"Schou, Anne Sophie","name_org":"Schou, Anne","rank":1,"rolecode":"pau"},{"affno":"2 1","first":"Niklas Rye","key":"jørgensenpau","last":"Jørgensen","locid":"3dc68a95-e26c-4b82-a4f0-7548313f8045","name":"Jørgensen, Niklas Rye","rank":2,"rolecode":"pau"},{"affno":"3","first":"Venance Phillip","key":"maropau","last":"Maro","name":"Maro, Venance Phillip","rank":3,"rolecode":"pau"},{"affno":"3","first":"Kajiru","key":"kilonzopau","last":"Kilonzo","name":"Kilonzo, Kajiru","rank":4,"rolecode":"pau"},{"affno":"4","first":"Kaushik","key":"ramaiyapau","last":"Ramaiya","name":"Ramaiya, Kaushik","rank":5,"rolecode":"pau"},{"affno":"3 5","first":"Joseph","key":"sirongapau","last":"Sironga","name":"Sironga, Joseph","rank":6,"rolecode":"pau"},{"affno":"1","first":"Andreas Kryger","key":"jensenpau","last":"Jensen","locid":"c165a0cc-b45c-485e-bfda-70d124e46012","name":"Jensen, Andreas Kryger","orcid":"0000-0002-8233-9176","rank":7,"rolecode":"pau"},{"affno":"1","first":"Dirk Lund","key":"christensenpau","last":"Christensen","locid":"abda6d9a-232d-4e7d-b46e-2f2973cb2c35","name":"Christensen, Dirk Lund","orcid":"0000-0003-2142-522X","rank":8,"rolecode":"pau"},{"affno":"2 1","first":"Peter","key":"schwarzpau","last":"Schwarz","locid":"058b1228-5dc0-458a-a98c-3faded28305b","name":"Schwarz, Peter","rank":9,"rolecode":"pau"}],"pmid":["35481615"],"pub":{"doi":"10.1002/ajhb.23756","issn":["10420533","15206300"],"issn_org":["10420533"],"issue":"8","journal":"American Journal of Human Biology","paperid":"e23756","status":"p","title":"American Journal of Human Biology","volume":"34"},"review":"Peer Reviewed","scoID":["2-s2.0-85128951504"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-b73f1c88-cd76-4506-bcc9-b49430f3eb60"],"src":["KU University of Copenhagen"],"title":"The circadian rhythm of calcium and bone homeostasis in Maasai","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-502883","year":"2022","yearsub":"2022"}
{"abstract":"Heterogeneous immobilized molecular catalysis has gained significant attention as a platform for creating more efficient and selective catalysts. A promising type of immobilized molecular catalysts are made from porous organic polymers (POPs) due to their high stability, porosity, and ability to mimic the catalytic activity and selectivity of homogeneous organometallic catalysts. These properties of the POP‐based systems make them very attractive as heterogeneous catalysts for hydrogenation of CO 2 to formate, where predominately homogeneous systems have been applied. In this study, five POPs were synthesized and assessed in the hydrogenation of CO 2 where the active catalysts were made in‐situ by mixing IrCl 3 and the POPs. One of the Ir/POP catalysts provided a turn‐over number (TON) >20,000, which is among the highest for POP‐based systems. Thorough characterization (CO 2 ‐ and N 2 ‐physisorption, TGA, CHN‐analysis, XRD, XPS, SEM, STEM and TEM) was performed. Notably, the developed Ir/POP system also showed catalytic activity for the decomposition of formic acid into H 2 enabling the use of formic acid as a renewable energy carrier.","author_count":7,"contributors":["Bennedsen, Niklas Rosendal","Christensen, David Benjamin","Mortensen, Rasmus Lykke","Wang, Bolun","Wang, Ryan","Kramer, Søren","Kegnæs, Søren"],"cuid":["S01-000.00-336076"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"corresponding_author":["Kegnæs, Søren"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University College London"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"heterogeneous formic acid production by hydrogenation of co000000000002 catalyzed by ir bpy embedded in polyphenylene porous organic polymers","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/238102441/cctc.202100002.pdf","version":"Authors Final Version"},"id":"S01-000.00-336076","identifier":[{"id":"85100879888","type":"scopus"}],"ids":["dtu-6991843e-7fe4-4efe-8933-dc8a298a490d"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-312953646D6522EB54D4CEE14A489B35"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/238102441/cctc.202100002.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Chemistry"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"gb","key":"university college london","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University College London","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Niklas Rosendal","key":"bennedsenniklasrosendalpau","last":"Bennedsen","locid":"8f839811-be1f-46fd-ae8e-5b1cd5c30dd8","name":"Bennedsen, Niklas Rosendal","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"David Benjamin","key":"christensendavidbenjaminpau","last":"Christensen","locid":"2ae22bd2-ed13-49ba-83eb-a484cb250dc9","name":"Christensen, David Benjamin","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rasmus Lykke","key":"mortensenrasmuslykkepau","last":"Mortensen","locid":"bb4ec633-3b7e-4c09-9d89-3d1ae06745a9","name":"Mortensen, Rasmus Lykke","orcid":"0000-0001-6643-9591","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Bolun","key":"wangbolunpau","last":"Wang","name":"Wang, Bolun","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ryan","key":"wangryanpau","last":"Wang","name":"Wang, Ryan","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren","key":"kramersørenpau","last":"Kramer","locid":"5b43766d-799a-4e55-a0d4-79fb4628d2e5","name":"Kramer, Søren","orcid":"0000-0001-6075-9615","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren","key":"kegnæssørenpau","last":"Kegnæs","locid":"0434f2bc-e0ba-4d4d-997a-860ec38d5e09","name":"Kegnæs, Søren","orcid":"0000-0002-6933-6931","rank":7,"rolecode":"pau"}],"pub":{"doi":"10.1002/cctc.202100002","issn":["18673880","18673899"],"issn_org":["18673880"],"issue":"7","journal":"ChemCatChem","pages":"1781-1786","publisher":"Wiley - VCH Verlag GmbH & Co. KGaA","publisher_org":"Wiley - V C H Verlag GmbH & Co. KGaA","status":"p","title":"ChemCatChem","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-85100879888"],"sdg":["7. Affordable and Clean Energy","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-6991843e-7fe4-4efe-8933-dc8a298a490d"],"src":["DTU Technical University of Denmark"],"title":"Heterogeneous formic acid production by hydrogenation of CO2 catalyzed by Ir‐bpy embedded in polyphenylene porous organic polymers","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-336076","year":"2021","yearsub":"2021"}
{"abstract":"Several cross-sectional studies have shown hair cortisol concentration to be associated with adiposity, but the relationship between hair cortisol concentration and longitudinal changes in measures of adiposity are largely unknown. We included 786 adults from the NoHoW trial, who had achieved a successful weight loss of ≥5% and had a body mass index of ≥25 kg/m2 prior to losing weight. Hair cortisol concentration (pg/mg hair) was measured at baseline and after 12 months. Body weight and body fat percentage were measured at baseline, 6-month, 12-month and 18-month visits. Participants weighed themselves at home ≥2 weekly using a Wi-Fi scale for the 18-month study duration, from which body weight variability was estimated using linear and non-linear approaches. Regression models were conducted to examine log hair cortisol concentration and change in log hair cortisol concentration as predictors of changes in body weight, change in body fat percentage and body weight variability. After adjustment for lifestyle and demographic factors, no associations between baseline log hair cortisol concentration and outcome measures were observed. Similar results were seen when analysing the association between 12-month concurrent development in log hair cortisol concentration and outcomes. However, an initial 12-month increase in log hair cortisol concentration was associated with a higher subsequent body weight variability between month 12 and 18, based on deviations from a nonlinear trend (β: 0.02% per unit increase in log hair cortisol concentration [95% CI: 0.00, 0.04]; P=0.016). Our data suggest that an association between hair cortisol concentration and subsequent change in body weight or body fat percentage is absent or marginal, but that an increase in hair cortisol concentration during a 12-month weight loss maintenance effort may predict a slightly higher subsequent 6-months body weight variability. Clinical Trial Registration: ISRCTN registry, identifier ISRCTN88405328.","author_count":16,"contributors":["Larsen, Sofus C.","Turicchi, Jake","Christensen, Gitte L.","Larsen, Charlotte S.","Jørgensen, Niklas Rye","Mikkelsen, Marie Louise K.","Horgan, Graham","O’Driscoll, Ruairi","Michalowska, Joanna","Duarte, Cristiana","Scott, Sarah E.","Santos, Inês","Encantado, Jorge","Palmeira, Antonio L.","Stubbs, R. James","Heitmann, Berit Lilienthal"],"cuid":["S01-000.00-393879"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","OECD"],"country":["Poland","Portugal","United Kingdom"],"glorg":["All Global Affiliations","Lusófona University","The James Hutton Institute","University of Leeds","University of Lisbon","University of Medical Sciences Poznan"],"keyword":["Hair cortisol","Obesity","Stress","Weight loss","Weight loss maintenance"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"hair cortisol concentration weight loss maintenance and body weight variability a prospective study based on data from the european nohow trial","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fendo.2021.655197","version":"Published Version"},"id":"S01-000.00-393879","identifier":[{"id":"PMC8511813","type":"pmcid"},{"id":"85117137437","type":"scopus"},{"id":"34659105","type":"pmid"}],"ids":["ku-00b0b790-1cf9-4306-9313-487a66bff99f"],"keyword":["hair cortisol","obesity","stress","weight loss","weight loss maintenance"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-7C5A53763EA58F439088ED9376CBF16C"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/