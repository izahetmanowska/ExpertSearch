yldekærpau","last":"Janstrup","name":"Janstrup, Kira Hyldekær","rank":4,"rolecode":"pau"},{"affno":"2","first":"Joshua","key":"nealonjoshuapau","last":"Nealon","name":"Nealon, Joshua","rank":5,"rolecode":"pau"},{"affno":"2","first":"Sandrine","key":"samsonsandrinepau","last":"Samson","name":"Samson, Sandrine","rank":6,"rolecode":"pau"},{"affno":"2","first":"Matthew","key":"loiaconomatthewpau","last":"Loiacono","name":"Loiacono, Matthew","rank":7,"rolecode":"pau"},{"affno":"3 2","first":"Rebecca","key":"harrisrebeccapau","last":"Harris","name":"Harris, Rebecca","rank":8,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Carsten Schade","key":"larsencarstenschadepau","last":"Larsen","locid":"2435cb82-03bd-498b-909d-1ef0e99443fe","name":"Larsen, Carsten Schade","rank":9,"rolecode":"pau"},{"affno":"1","first":"Anne Marie Reimer","key":"jensenannemariereimerpau","last":"Jensen","name":"Jensen, Anne Marie Reimer","rank":10,"rolecode":"pau"},{"affno":"1","first":"Nino Emanuel","key":"landlerninoemanuelpau","last":"Landler","name":"Landler, Nino Emanuel","rank":11,"rolecode":"pau"},{"affno":"5 6","first":"Brian L.","key":"claggettbrianlpau","last":"Claggett","name":"Claggett, Brian L.","rank":12,"rolecode":"pau"},{"affno":"5","first":"Scott D.","key":"solomonscottdpau","last":"Solomon","name":"Solomon, Scott D.","rank":13,"rolecode":"pau"},{"affno":"1","first":"Gunnar H.","key":"gislasongunnarhpau","last":"Gislason","name":"Gislason, Gunnar H.","rank":14,"rolecode":"pau"},{"affno":"1","first":"Lars","key":"køberlarspau","last":"Køber","name":"Køber, Lars","rank":15,"rolecode":"pau"},{"affno":"7","first":"Martin J.","key":"landraymartinjpau","last":"Landray","name":"Landray, Martin J.","rank":16,"rolecode":"pau"},{"affno":"1 8","first":"Pradeesh","key":"sivapalanpradeeshpau","last":"Sivapalan","locid":"bd238e0e-9259-49fe-b6b3-fcea0c6f20cd","name":"Sivapalan, Pradeesh","orcid":"0000-0002-8620-3655","rank":17,"rolecode":"pau"},{"affno":"1 8","first":"Jens Ulrik Stæhr","key":"jensenjensulrikstæhrpau","last":"Jensen","locid":"d9593acd-d6ae-4a83-a7c8-64bc2ea541ac","name":"Jensen, Jens Ulrik Stæhr","orcid":"0000-0003-4036-0521","rank":18,"rolecode":"pau"},{"affno":"1 9 10","first":"Tor","key":"bieringsørensentorpau","last":"Biering-Sørensen","name":"Biering-Sørensen, Tor","rank":19,"rolecode":"pau"}],"pmid":["39215646"],"pub":{"doi":"10.1161/circoutcomes.124.011496","issn":["19417705","19417713"],"issn_org":["19417713"],"issue":"2","journal":"Circulation: Cardiovascular Quality and Outcomes","paperid":"e011496","status":"p","title":"Circulation: Cardiovascular Quality and Outcomes","title_org":"Circulation. Cardiovascular quality and outcomes","volume":"18"},"review":"Peer Reviewed","scoID":["2-s2.0-85215266734"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-82871f92-6beb-4db3-85ad-578f09fc5741","ku-d794e858-4847-4613-b076-37649898428b"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Relative Effectiveness of High-Dose Versus Standard-Dose Quadrivalent Influenza Vaccine in Older Adults With Cardiovascular Disease : A Prespecified Analysis of the DANFLU-1 Randomized Clinical Trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-089.10-804122","year":"2025","yearsub":"2025"}
{"abstract":"Aim: This study aimed to investigate the associations between hypothermia and mortality or poor neurological outcome in a nationwide cohort of drowning patients with out-of-hospital cardiac arrest (OHCA). Methods: This nationwide, registry-based cohort study reported in-hospital data on drowning patients with OHCA following the Utstein Style For Drowning. Drowning patients with OHCA were identified in the Danish Cardiac Arrest Registry from 2016 to 2021. The primary outcome was the rate of mortality or poor neurological outcome (corresponding to a modified Rankin Scale [mRS] score > 3) at 180 days after the drowning incident in patients with OHCA and accidental hypothermia (<35 °C) vs normothermia (≥35 °C). Results: This study identified 118 drowning patients with OHCA and found an increased rate of mRS > 3 at 180 days after the drowning incident in the hypothermic group compared to the normothermic group (74% vs 18%, p < 0.001). The 180-day mortality (mRS = 6) was 69% in the hypothermic group compared to 16% in the normothermic group (p < 0.001). The hypothermic group had higher rates of ongoing CPR at hospital admission (45% vs 7%, p < 0.001), intensive care unit admission (70% vs 41%, p = 0.003), and mechanical ventilation during hospitalisation (78% vs 32%, p < 0.001) compared to the normothermic group. Conclusion: Hypothermic drowning patients with OHCA had a higher risk of mortality or poor neurological outcome at 180 days compared to normothermic drowning patients with OHCA. This association may likely be explained by confounding factors such as prolonged submersion and cardiac arrest. Further research is warranted.","author_count":12,"contributors":["Bitzer, Kasper","Breindahl, Niklas","Kelly, Benjamin","Sørensen, Oliver Beierholm","Laugesen, Monika","Wolthers, Signe Amalie","Blomberg, Stig Nikolaj Fasmer","Steinmetz, Jacob","Wiberg, Sebastian","Christensen, Helle Collatz"],"cuid":["S04-098.75-803706"],"filters":{"added":"2025-04","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"corpau":["Danish Cardiac Arrest Group","Danish Cardiac Arrest Registry Group"],"corresponding_author":["Breindahl, Niklas"],"keyword":["Accidental hypothermia","Adult","Aged","Cardiopulmonary Resuscitation methods","Cohort Extracorporeal Life Support","Cohort Studies","Danish Cardiac Arrest Registry","Danish Drowning Cohort","Danish drowning formula","Denmark epidemiology","Drowning","Female","Humans","Hypothermia complications","Male","Middle Aged","Out of Hospital Cardiac Arrest mortality","Out of hospital cardiac arrest","Registries","Registry based"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-NDR","DI-HO-OTH","DI-HO-SDR","DI-HO-ZEA"],"OT":["Forsvaret"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-NDR","DI-HO-OTH","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"the role of accidental hypothermia in drowning patients with out of hospital cardiac arrest a nationwide registry based cohort study","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.resuscitation.2024.110486","version":"Published Version"},"funding_acknowledgement":["The authors acknowledge the Danish Cardiac Arrest Group for registration of the first 211 potential drowning cases in 2016. This was the initial step in developing the text-search algorithm to identify drowning patients with OHCA. All members of the Danish Cardiac Arrest Group are affiliated with The Danish Clinical Quality Program, National Clinical Registries, Copenhagen, Denmark: Gunhild Kj\\u00E6rgaard-Andersen, Louise Milling, Ulrik Havsh\\u00F8j, Ren\\u00E9 Arne Bergmann, Jan Medom Linnebjerg, Michael Boddum, Heinrich Dedenroth Larsen, Theo Walther Jensen, Mathias Geldermann Holgersen, Stig Nikolaj Fasmer Blomberg, Helle Collatz Christensen, Harman Gailand Hassan Yonis, Julie Linding Bogh Kjerulff, Emilie Kabel Madsen, Kristian Bundgaard Ringgren, Dorthe Sofie Haals, Lars Borup, Kenneth L\\u00FCbcke."],"id":"S04-098.75-803706","identifier":[{"id":"85215835845","type":"scopus"},{"id":"39798890","type":"pmid"}],"ids":["aau-669443e8-ad70-4e86-869b-c6aa924fc7ec","au-72a9fb93-f7fc-4a45-9ff4-3edfa7558233","ku-bdb0d3c2-980f-49f9-9c3c-e419861af379","sdu-834e1938-61aa-4ec6-b4da-f57f92e00828"],"keyword":["Accidental hypothermia","Adult","Aged","Cardiopulmonary Resuscitation/methods","Cohort Studies","Cohort, Extracorporeal Life Support","Danish Cardiac Arrest Registry","Danish Drowning Cohort","Danish Drowning Formula","Denmark/epidemiology","Drowning","Female","Humans","Hypothermia/complications","Male","Middle Aged","Out-of-Hospital Cardiac Arrest/mortality","Out-of-hospital cardiac arrest","Registries","Registry-based"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-7-EC3903C2F558AC4463D2DA16CE14E7EE"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/767316882/Bitzer_et_al._2025_._The_role_of_accidental_hypothermia_in_drowning_patients_with_out-of-hospital_cardiac_arrest_-_A_nationwide_registry-based_cohort_study.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/444545342/1-s2.0-S030095722400861X-main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.resuscitation.2024.110486","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/286711379/Open_Access_Version.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"ku university