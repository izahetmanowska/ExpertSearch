gen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-8350c2e0-195b-4dbb-a01e-fdfacfba8ee1","ku-53f3278e-ed35-4287-bf61-29a6df903291","nfa-dc3dfab9-61e0-4cb5-af86-c4676363be07","sdu-8ba30694-3eae-4a36-8bb0-510d3bb80cd6"],"src":["AAU Aalborg University","KU University of Copenhagen","NFA National Research Centre for the Working Environment","SDU University of Southern Denmark"],"title":"Football training in men with prostate cancer undergoing androgen deprivation therapy : activity profile and short-term skeletal and postural balance adaptations","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-098.77-766829","year":"2016","yearsub":"2016"}
{"abstract":"OBJECTIVES: Epidemiological studies associate preeclampsia with increased risk of premature cardiovascular disease (CVD) later in life. This study aims to make a comprehensive CVD risk assessment comparing women with previous preeclamptic pregnancies to women with previous normotensive pregnancies 10years after index pregnancy. STUDY DESIGN: A nested, matched, observational cohort study. MAIN OUTCOME MEASURES: Markers of arterial stiffness, aortic pulse wave velocity (aPWV) and augmentation index (AIx-75), and markers of atherosclerosis, carotid intima-media thickness (cIMT) and carotid plaque presence. Traditional CVD risk factors and 10-year and 30-year Framingham CVD risk scores were also assessed. RESULTS: Women were included from April 2014 to October 2014 at a tertiary referral hospital in Denmark. Twenty-one exposed women with a history of preeclampsia and 21 unexposed with a history of normotensive pregnancies were included. Ten years after delivery, significantly more exposed women suffered from hypertension and received antihypertensive treatment and significantly more fulfilled the hypertension-definition at screening. Previously preeclamptic women also tended to have more unfavorable CVD risk estimates. The Framingham risk scores seemed to extend the unfavorable CVD risk. The exposed women tended to have a higher aPWV compared to unexposed women, (P=0.057). No differences were shown in the other examined arteriosclerotic or atherosclerotic variables. CONCLUSIONS: Ten years after delivery, we found increased risk of hypertension and trend toward unfavorable CVD risk profile in 40-year-old previously preeclamptic women. However, arterial stiffness and atherosclerosis did not uncover any additional CVD risk information at this time point.","author_count":5,"contributors":["Christensen, Martin","Kronborg, Camilla","Eldrup, Nikolaj","Rossen, Niklas B","Knudsen, Ulla Breth"],"cuid":["S01-000.00-194543"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Christensen, Martin"],"keyword":["Arterial stiffness","Atherosclerosis","Cardiovascular disease risk","Framingham risk score","Preeclampsia"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"preeclampsia and cardiovascular disease risk assessment do arterial stiffness and atherosclerosis uncover increased risk ten years after delivery","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84963603401","version":"Other Version"},"id":"S01-000.00-194543","identifier":[{"id":"84963603401","type":"scopus"},{"id":"27155337","type":"pmid"}],"ids":["au-72333e35-5d74-4672-9132-f1f49393c74f"],"keyword":["Arterial stiffness","Atherosclerosis","Cardiovascular disease risk","Framingham risk score","Preeclampsia"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-0D976EEDAC3E9643E1C13739211A8CBD"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University","Aarhus University, Aarhus BSS, Department of Management, Department of Management - ICOA - Interdisciplinary Center for Organizational Architecture","Aarhus University, Aarhus University, Faculty of Health Sciences, Institute of Clinical Medicine","Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Clinical Research Unit, Randers Regional Hospital"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Martin","key":"christensenpau","last":"Christensen","locid":"dcbdff9d-57dd-4234-b05b-97403021fda6","name":"Christensen, Martin","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Camilla Skovhus","key":"kronborgpau","last":"Kronborg","locid":"9a9a4aa2-9e29-4c11-9210-34be3def937a","name":"Kronborg, Camilla","name_org":"Kronborg, Camilla Skovhus","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Nikolaj","key":"eldruppau","last":"Eldrup","locid":"8915eb0d-6387-4796-ac45-c7eb215ff0fa","name":"Eldrup, Nikolaj","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Niklas Blach","key":"rossenpau","last":"Rossen","locid":"fde04f7b-b73f-42bb-8fed-7ced5a87b6fc","name":"Rossen, Niklas B","name_org":"Rossen, Niklas Blach","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ulla Breth","key":"knudsenpau","last":"Knudsen","locid":"819b29d7-2cff-463c-821a-c79663795b76","name":"Knudsen, Ulla Breth","rank":5,"rolecode":"pau"}],"pmid":["27155337"],"pub":{"doi":"10.1016/j.preghy.2016.04.001","issn":["22107789"],"issue":"2","journal":"Pregnancy Hypertension","pages":"110-114","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"p","title":"Pregnancy Hypertension","volume":"6"},"review":"Peer Reviewed","scoID":["2-s2.0-84963603401"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-72333e35-5d74-4672-9132-f1f49393c74f"],"src":["AU Aarhus University"],"title":"Preeclampsia and cardiovascular disease risk assessment - Do arterial stiffness and atherosclerosis uncover increased risk ten years after delivery?","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-194543","year":"2016","yearsub":"2016"}
{"abstract":"UNLABELLED: Androgen deprivation therapy (ADT) for prostate cancer (PCa) impairs musculoskeletal health. We evaluated the efficacy of 32-week football training on bone mineral density (BMD) and physical functioning in men undergoing ADT for PCa. Football training improved the femoral shaft and total hip BMD and physical functioning parameters compared to control. INTRODUCTION: ADT is a mainstay in PCa management. Side effects include decreased bone and muscle strength and increased fracture rates. The purpose of the present study was to evaluate the effects of 32 weeks of football training on BMD, bone turnover markers (BTMs), body composition, and physical functioning in men with PCa undergoing ADT. METHODS: Men receiving ADT >6 months (n = 57) were randomly allocated to a football training group (FTG) (n = 29) practising 2-3 times per week for 45-60 min or to a standard care control group (CON) (n = 28) for 32 weeks. Outcomes were total hip, femoral shaft, femoral neck and lumbar spine (L2-L4) BMD and systemic BTMs (procollagen type 1 amino-terminal propeptide, osteocalcin, C-terminal telopeptide of type 1 collagen). Additionally, physical functioning (postural balance, jump height, repeated chair rise, stair climbing) was evaluated. RESULTS: Thirty-two-week follow-up measures were obtained for FTG (n = 21) and for CON (n = 20), respectively. Analysis of mean changes from baseline to 32 weeks showed significant differences between FTG and CON in right (0.015 g/cm(2)) and left (0.017 g/cm(2)) total hip and in right (0.018 g/cm(2)) and left (0.024 g/cm(2)) femoral shaft BMD, jump height (1.7 cm) and stair climbing (-0.21 s) all in favour of FTG (p < 0.05). No other significant between-group differences were observed. CONCLUSIONS: Compared to standard care, 32 weeks of football training improved BMD at clinically important femoral sites and parameters of physical functioning in men undergoing ADT for PCa.","author_count":30,"contributors":["Uth, J.","Hornstrup, T.","Christensen, J. F.","Christensen, K. B.","Jørgensen, N. R.","Schmidt, J. F.","Brasso, K.","Jakobsen, M. D.","Sundstrup, E.","Andersen, Lars L.","Rørth, M.","Midtgaard, J.","Krustrup, P.","Helge, E. W."],"cuid":["S04-098.47-766865"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of Exeter"],"keyword":["Aged","Androgen Antagonists","Androgen deprivation therapy","Antineoplastic Agents Hormonal","Body composition","Bone Density","Bone Diseases Metabolic","Bone mineral density","Bone turnover markers","Exercise","Exercise Therapy","Femur","Follow Up Studies","Hip Joint","Humans","Journal Article","Male","Middle Aged","Multicenter Study","Muscle Skeletal","Muscle Strength","Patient Compliance","Physical Fitness","Physical activity","Postural Balance","Prostatic Neoplasms","Randomized Controlled Trial","Recreation Therapy","Research Support Non U S Gov t","Soccer","Sport"],"level":"sci","mra":["med","sci","soc"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-WORK"],"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-GV-WORK","DI-HO-CAP","DI-U-AAU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"efficacy of recreational football on bone health body composition and physical functioning in men with prostate cancer undergoing androgen deprivation therapy 000000000032 week follow up of the fc prostate randomised controlled trial","src":["aau","ku","nfa","sdu"],"src-code":["DI-GV-WORK","DI-U-AAU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84961061474","version":"Other Version"},"id":"S04-098.47-766865","identifier":[{"id":"00037230