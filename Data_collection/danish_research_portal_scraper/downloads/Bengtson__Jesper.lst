,"rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jonas B.","key":"jensenpau","last":"Jensen","name":"Jensen, Jonas B.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars","key":"birkedalpau","last":"Birkedal","name":"Birkedal, Lars","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-642-32347-8_21","eisbn":["9783642323478"],"isbn":["9783642323461"],"pages":"315-331","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","subtitle":"Third International Conference, ITP 2012, Princeton, NJ, USA, August 13-15, 2012. Proceedings","title":"Interactive Theorem Proving"},"review":"Peer Reviewed","scoID":["2-s2.0-84865594990"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-fa807e19-f204-48cd-add6-5e35677e7095"],"src":["ITU IT University of Copenhagen"],"title":"Charge! - A Framework for Higher-Order Separation Logic in Coq","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384954","year":"2012","yearsub":"2012"}
{"abstract":"We present a shallow Coq embedding of a higher-order separation logic with nested triples for an object-oriented programming language. Moreover, we develop novel specification and proof patterns for reasoning in higher-order separation logic with nested triples about programs that use interfaces and interface inheritance. In particular, we show how to use the higher-order features of the Coq formalisation to specify and reason modularly about programs that (1) depend on some unknown code satisfying a specification or that (2) return objects conforming to a certain specification. All of our results have been formally verified in the interactive theorem prover Coq.","author_count":4,"contributors":["Bengtson, Jesper","Jensen, Jonas Braband","Sieczkowski, Filip","Birkedal, Lars"],"cuid":["S01-000.00-383073"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Coq formalisation","Higher order separation logic","Modular reasoning","Nested triples","Object oriented programming"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"verifying object oriented programs with higher order separation logic in coq","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/37299430/itp2011.pdf","version":"Pre-print"},"id":"S01-000.00-383073","identifier":[{"id":"80052177243","type":"scopus"}],"ids":["itu-7ae07286-7b19-4d2f-ab53-b1dcc5855410"],"keyword":["Coq formalisation","Higher-order separation logic","Modular reasoning","Nested triples","Object-oriented programming"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-2602584954A759EBCE5237EF3F898A15"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/37299430/itp2011.pdf","version":"Pre-print"},{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-3-642-22863-6_5","version":"Other Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jesper","key":"bengtsonpau","last":"Bengtson","locid":"b2b68ce2-6257-45bf-ab48-dc17d05c885e","name":"Bengtson, Jesper","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jonas Braband","key":"jensenpau","last":"Jensen","name":"Jensen, Jonas Braband","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Filip","key":"sieczkowskipau","last":"Sieczkowski","name":"Sieczkowski, Filip","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Lars","key":"birkedalpau","last":"Birkedal","name":"Birkedal, Lars","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-642-22863-6_5","issn":["03029743","16113349"],"issn_org":["03029743"],"journal":"Lecture Notes in Computer Science","pages":"22-38","publisher":"Springer","status":"p","title":"Lecture Notes in Computer Science","volume":"6898"},"review":"Peer Reviewed","scoID":["2-s2.0-80052177243"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-7ae07286-7b19-4d2f-ab53-b1dcc5855410"],"src":["ITU IT University of Copenhagen"],"title":"Verifying object-oriented programs with higher-order separation logic in Coq","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383073","year":"2011","yearsub":"2011"}
