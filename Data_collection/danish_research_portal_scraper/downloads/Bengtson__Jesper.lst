925-0586","rank":11,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Torben Falck","key":"ørntofttorbenfalckpau","last":"Ørntoft","locid":"37db9bb8-c48f-42aa-947f-23679e86c464","name":"Ørntoft, Torben Falck","rank":12,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Claus Lindbjerg","key":"andersenclauslindbjergpau","last":"Andersen","locid":"f97421ce-9c23-4c51-9fcd-be0843ed0c0f","name":"Andersen, Claus Lindbjerg","orcid":"0000-0002-7406-2103","rank":13,"rolecode":"pau"}],"pmid":["27526785"],"pub":{"doi":"10.1038/ncomms12436","issn":["20411723"],"journal":"Nature Communications","paperid":"12436","publisher":"Nature Research","status":"p","title":"Nature Communications","volume":"7"},"review":"Peer Reviewed","scoID":["2-s2.0-84982124787"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-0c6e9d61-7868-40b5-86f6-2fa5e21cba5f","ku-0bccf696-215d-4aaf-b216-742f0a5007cd","sdu-18420cb5-de57-4ae5-b302-26b588d80f86"],"src":["AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"miR-625-3p regulates oxaliplatin resistance by targeting MAP2K6-p38 signalling in human colorectal adenocarcinoma cells","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-100.00-013509","year":"2016","yearsub":"2016"}
{"abstract":"Exosomes are small secreted vesicles that can transfer their content to recipient cells. In cancer, exosome secretion has been implicated in tumor growth and metastatic spread. In this study, we explored the possibility that exosomal pathways might discard tumor-suppressor miRNA that restricts metastatic progression. Secreted miRNA characterized from isogenic bladder carcinoma cell lines with differing metastatic potential were uncoupled from binding to target transcripts or the AGO2-miRISC complex. In metastatic cells, we observed a relative increase in secretion of miRNA with tumor-suppressor functions, including miR23b, miR224, and miR921. Ectopic expression of miR23b inhibited invasion, anoikis, angiogenesis, and pulmonary metastasis. Silencing of the exocytotic RAB family members RAB27A or RAB27B halted miR23b and miR921 secretion and reduced cellular invasion. Clinically, elevated levels of RAB27B expression were linked to poor prognosis in two independent cohorts of patients with bladder cancer. Moreover, highly exocytosed miRNA from metastatic cells, such as miR23b, were reduced in lymph node metastases compared with patient-matched primary tumors and were correlated with increments in miRNA-targeted RNA. Taken together, our results suggested that exosome-mediated secretion of tumor-suppressor miRNA is selected during tumor progression as a mechanism to coordinate activation of a metastatic cascade. Cancer Res; 74(20); 1-14. ©2014 AACR.","author_count":23,"contributors":["Ostenfeld, Marie Stampe","Jeppesen, Dennis Kjølhede","Laurberg, Jens R","Boysen, Anders T","Bramsen, Jesper Bertram","Primdal-Bengtson, Bjarke","Hendrix, An","Lamy, Philippe","Dagnæs-Hansen, Frederik","Rasmussen, Mads Heilskov","Bui, Khan H","Fristrup, Niels","Christensen, Erik Ilsø","Nordentoft, Iver","Morth, Jens P","Jensen, Jørgen Bjerggaard","Pedersen, Jakob Skou","Beck, Martin","Theodorescu, Dan","Borre, Michael","Howard, Kenneth Alan","Dyrskjøt, Lars","Ørntoft, Torben Falck"],"cuid":["S01-000.00-133318"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Europe, EU","Europe, Non-EU","Nordic","OECD"],"country":["Belgium","Germany","Norway","United States"],"glorg":["All Global Affiliations","European Molecular Biology Laboratory (EMBL)","Ghent University","University of Colorado Anschutz Medical Campus","University of Oslo"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-HO-CDR","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"cellular disposal of mir000000000023b by rab000000000027 dependent exosome release is linked to acquisition of metastatic properties","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1158/0008-5472.CAN-13-3512","version":"Other Version"},"id":"S01-000.00-133318","identifier":[{"id":"84908139770","type":"scopus"},{"id":"25261234","type":"pmid"}],"ids":["au-06f99f78-8b80-48d2-a501-2fc509d47005"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-EA20760391B88DDE241D5E4A4A0A493A"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1158/0008-5472.CAN-13-3512","version":"Other Version"}],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Molecular Medicine (MOMA)"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"central denmark region","l2"