nninx","name":"Penninx, Brenda W. J. H.","rank":48,"rolecode":"pau"},{"affno":"1","first":"Stine","key":"møllegaardpau","last":"Møllegaard","locid":"017bdbe6-a2c4-4d49-b0dd-503f08d2f645","name":"Møllegaard, Stine","orcid":"0000-0001-5676-2248","rank":49,"rolecode":"pau"},{"affno":"1","first":"Tune H","key":"perspau","last":"Pers","locid":"209c62ff-f452-48bc-8d42-63be1645edd5","name":"Pers, Tune H.","name_org":"Pers, Tune H","orcid":"0000-0003-0207-4831","rank":50,"rolecode":"pau"}],"pmid":["34211149"],"pub":{"doi":"10.1038/s41562-021-01135-3","issn":["23973374"],"journal":"Nature Human Behaviour","pages":"1717-1730","status":"p","title":"Nature Human Behaviour","volume":"5"},"review":"Peer Reviewed","scoID":["2-s2.0-85117508270"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-b5ddf72a-e742-4f5a-8c78-d5474563b93d"],"src":["KU University of Copenhagen"],"title":"Identification of 371 genetic variants for age at first sex and birth linked to externalising behaviour","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-502058","year":"2021","yearsub":"2021"}
{"abstract":"Dynamic polarisation of tumour cells is essential for metastasis. While the role of polarisation during dedifferentiation and migration is well established, polarisation of metastasising tumour cells during phases of detachment has not been investigated. Here we identify and characterise a type of polarisation maintained by single cells in liquid phase termed single-cell (sc) polarity and investigate its role during metastasis. We demonstrate that sc polarity is an inherent feature of cells from different tumour entities that is observed in circulating tumour cells in patients. Functionally, we propose that the sc pole is directly involved in early attachment, thereby affecting adhesion, transmigration and metastasis. In vivo, the metastatic capacity of cell lines correlates with the extent of sc polarisation. By manipulating sc polarity regulators and by generic depolarisation, we show that sc polarity prior to migration affects transmigration and metastasis in vitro and in vivo.","author_count":37,"contributors":["Lorentzen, Anna","Becker, Paul F.","Kosla, Jan","Saini, Massimo","Weidele, Kathrin","Ronchi, Paolo","Klein, Corinna","Wolf, Monika J.","Geist, Felix","Seubert, Bastian","Ringelhan, Marc","Mihic-Probst, Daniela","Esser, Knud","Roblek, Marko","Kuehne, Felix","Bianco, Gaia","O'Connor, Tracy","Müller, Quentin","Schuck, Kathleen","Lange, Sebastian","Hartmann, Daniel","Spaich, Saskia","Groß, Olaf","Utikal, Jochen","Haferkamp, Sebastian","Sprick, Martin R.","Damle-Vartak, Amruta","Hapfelmeier, Alexander","Hüser, Norbert","Protzer, Ulrike","Trumpp, Andreas","Saur, Dieter","Vartak, Nachiket","Klein, Christoph A.","Polzer, Bernhard","Borsig, Lubor","Heikenwalder, Mathias"],"cuid":["S01-000.00-139943"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","OECD"],"corresponding_author":["Lorentzen, Anna"],"country":["Czechia","Germany","Switzerland"],"glorg":["All Global Affiliations","Czech Academy of Sciences","European Molecular Biology Laboratory (EMBL)","Fraunhofer Institute for Toxicology and Experimental Medicine","German Cancer Research Center (DKFZ)","Leibniz Research Centre for Working Environment and Human Factors","Technical University of Munich","University Hospital Mannheim","University of Regensburg","University of Zurich"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"single cell polarity in liquid phase facilitates tumour metastasis","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41467-018-03139-6","version":"Published Version"},"id":"S01-000.00-139943","identifier":[{"id":"29491397","type":"pmid"},{"id":"85042774764","type":"scopus"},{"id":"PMC5830403","type":"pmcid"}],"ids":["au-1254471b-318a-4c7d-beb2-215c03feed94"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-F057C9F0E601174D28EE1F833E46802A"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41467-018-03139-6","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.au.dk/ws/files/124425671/s41467_018_03139_6.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Molecular Biology and Genetics, Department of Molecular Biology and Genetics -