t":"Vejre","locid":"e4073dcd-d8a8-4d8a-b2c6-149ce705394b","name":"Vejre, Henrik","orcid":"0000-0002-6820-0389","rank":78,"rolecode":"pau"},{"affno":"8","first":"Petteri","key":"vihervaarapau","last":"Vihervaara","name":"Vihervaara, Petteri","rank":79,"rolecode":"pau"},{"affno":"8","first":"Arto","key":"viinikkapau","last":"Viinikka","name":"Viinikka, Arto","rank":80,"rolecode":"pau"},{"affno":"44","first":"Miguel","key":"villosladapau","last":"Villoslada","name":"Villoslada, Miguel","rank":81,"rolecode":"pau"},{"affno":"30","first":"Bettina","key":"weibelpau","last":"Weibel","name":"Weibel, Bettina","rank":82,"rolecode":"pau"},{"affno":"3","first":"Grazia","key":"zulianpau","last":"Zulian","name":"Zulian, Grazia","rank":83,"rolecode":"pau"}],"pub":{"doi":"10.3897/oneeco.3.e29153","issn":["23678194"],"journal":"One Ecosystem","paperid":"e29153","status":"p","title":"One Ecosystem","volume":"3"},"review":"Peer Reviewed","scoID":["2-s2.0-85062814195"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-d741e7a5-9627-4af7-b7b2-028ba31c04b0"],"src":["KU University of Copenhagen"],"title":"Mapping and assessing ecosystem services in the EU - Lessons learned from the ESMERALDA approach of integration","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-522047","year":"2018","yearsub":"2018"}
{"abstract":"Solar-powered electrochemical production of hydrogen through water electrolysis is an active and important research endeavor. However, technologies and roadmaps for implementation of this process do not exist. In this perspective paper, we describe potential pathways for solar-hydrogen technologies into the marketplace in the form of photoelectrochemical or photovoltaic-driven electrolysis devices and systems. We detail technical approaches for device and system architectures, economic drivers, societal perceptions, political impacts, technological challenges, and research opportunities. Implementation scenarios are broken down into short-term and long-term markets, and a specific technology roadmap is defined. In the short term, the only plausible economical option will be photovoltaic-driven electrolysis systems for niche applications. In the long term, electrochemical solar-hydrogen technologies could be deployed more broadly in energy markets but will require advances in the technology, significant cost reductions, and/or policy changes. Ultimately, a transition to a society that significantly relies on solar-hydrogen technologies will benefit from continued creativity and influence from the scientific community.","author_count":45,"contributors":["Ardo, Shane","Fernandez Rivas, David","Modestino, Miguel A.","Schulze Greiving, Verena","Abdi, Fatwa F.","Alarcon Llado, Esther","Artero, Vincent","Ayers, Katherine","Battaglia, Corsin","Becker, Jan Philipp","Bederak, Dmytro","Berger, Alan","Buda, Francesco","Chinello, Enrico","Dam, Bernard","Di Palma, Valerio","Edvinsson, Tomas","Fujii, Katsushi","Gardeniers, Han","Geerlings, Hans","Hashemi, S. Mohammad","Haussener, Sophia","Houle, Frances","Huskens, Jurriaan","James, Brian D.","Konrad, Kornelia","Kudo, Akihiko","Kunturu, Pramod Patil","Lohse, Detlef","Mei, Bastian Timo","Miller, Eric L.","Moore, Gary F.","Muller, Jiri","Orchard, Katherine L.","Rosser, Timothy E.","Saadi, Fadl H.","Schüttauf, Jan Willem","Seger, Brian","Sheehan, Stafford W.","Smith, Wilson A.","Spurgeon, Joshua","Tang, Maureen H.","Van De Krol, Roel","Vesborg, Peter Christian Kjærgaard","Westerik, Pieter"],"cuid":["S01-000.00-322841"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Asia, East","Europe, EU","Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Ardo, Shane"],"country":["France","Germany","Japan","Netherlands","Norway","Sweden","Switzerland","United Kingdom","United States"],"glorg":["AMOLF","Air Products and Chemicals, Inc.","All Global Affiliations","Arizona State University","California Institute of Technology","Catalytic Innovations, LLC","Delft University of Technology","Drexel University","Eindhoven University of Technology","Forschungszentrum Jülich GmbH","Helmholtz Centre Berlin for Materials and Energy","Institute for Energy Technology","Lawrence Berkeley National Laboratory","Leiden University","New York University","Proton OnSite, Inc.","Strategic Analysis, Inc.","Swiss Center for Electronics and Microtechnology","Swiss Federal Institute of Technology Lausanne","Swiss Federal Laboratories for Materials Science and Technology (Empa)","The University of Kitakyushu","Tokyo University of Science","U.S. Department of Energy Wind and Water Power Program","University of California at Irvine","University of Cambridge","University of Groningen","University of Louisville","University of Twente","Université Grenoble Alpes","Uppsala University"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"pathways to electrochemical solar hydrogen technologies","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/190885947/C7EE03639F.pdf"