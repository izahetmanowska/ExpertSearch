dk","first":"Anders","key":"riisageranderspau","last":"Riisager","locid":"ccf85ca7-c97b-48e6-bfa8-30ea97d6e9b8","name":"Riisager, Anders","orcid":"0000-0002-7086-1143","rank":24,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Thomas Fruergaard","key":"astrupthomasfruergaardpau","last":"Astrup","locid":"4cd2a3af-f243-4eb3-bae2-0262e569b89f","name":"Astrup, Thomas Fruergaard","orcid":"0000-0002-2853-1001","rank":25,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ashraf Fathi Khalil","key":"khalilashrafpau","last":"Sulayman","locid":"1fb7831c-be8f-478f-b99e-9e43549823ad","name":"Khalil, Ashraf","name_org":"Sulayman, Ashraf Fathi Khalil","orcid":"0000-0001-5668-9781","rank":26,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ulla","key":"hoffmannullapau","last":"Hoffmann","locid":"64d08363-a6cf-4162-a5f6-7b708ddf21b1","name":"Hoffmann, Ulla","rank":27,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ditte Kirstine","key":"andersendittekirstinepau","last":"Andersen","locid":"a592a162-0ec0-4f83-b8fd-0a3df32402d4","name":"Andersen, Ditte Kirstine","rank":28,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars","key":"brücknerlarspau","last":"Brückner","locid":"73376a7b-568d-4cdf-b781-542fce59e302","name":"Brückner, Lars","rank":29,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Morten","key":"andersenmortenpau","last":"Andersen","name":"Andersen, Morten","rank":30,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Leon Aahave","key":"uhdleonaahavepau","last":"Uhd","locid":"50116acb-78a0-4d5a-a574-968dddac3347","name":"Uhd, Leon Aahave","rank":31,"rolecode":"pau"}],"pub":{"pages":"27","publisher":"Technical University of Denmark","status":"p"},"review":"Undetermined","sdg":["7. Affordable and Clean Energy","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All