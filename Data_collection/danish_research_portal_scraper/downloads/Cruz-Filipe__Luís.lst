r of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-030-13838-7_4","isbn":["9783030138370"],"issn":["03029743"],"pages":"59-76","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","title":"Logic-Based Program Synthesis and Transformation - 28th International Symposium, LOPSTR 2018"},"review":"Peer Reviewed","scoID":["2-s2.0-85064049666"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-761616b7-5223-435c-8664-1be02c302e2e"],"src":["SDU University of Southern Denmark"],"title":"Multiparty Classical Choreographies","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-606994","year":"2019","yearsub":"2019"}
{"abstract":"DRAT proofs have become the standard for verifying unsatisfiability proofs emitted by modern SAT solvers. However, recent work showed that the specification of the format differs from its implementation in existing tools due to optimizations necessary for efficiency. Although such differences do not compromise soundness of DRAT checkers, the sets of correct proofs according to the specification and to the implementation are incomparable. We discuss how it is possible to design DRAT checkers faithful to the specification by carefully modifying the standard optimization techniques. We implemented such modifications in a configurable DRAT checker. Our experimental results show negligible overhead due to these modifications, suggesting that efficient verification of the DRAT specification is possible. Furthermore, we show that the differences between specification and implementation of DRAT often arise in practice.","author_count":4,"contributors":["Rebola-Pardo, Adrián","Cruz-Filipe, Luís"],"cuid":["S01-000.00-599479"],"event":{"acronym":"FMCAD","end":"2018-11-02","place":"Austin, us","start":"2018-10-30","title":"Formal Methods in Computer-Aided Design","year":"2018"},"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Austria"],"glorg":["All Global Affiliations","Vienna University of Technology"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"complete and efficient drat proof checking","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85061659217","version":"Other Version"},"id":"S01-000.00-599479","identifier":[{"id":"85061659217","type":"scopus"}],"ids":["sdu-5bc4d8ac-1f4e-4c95-a232-ab1dcb3ee3b5"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-21D671ADEE051DAEE551B9CAF2E2534B"],"org":[{"affno":"1","country":"at","key":"vienna university of technology","loc":["Austria","Europe, EU","OECD"],"name":"Vienna University of Technology","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Science, Department of Mathematics and Computer Science","SDU, Faculty of Science, Department of Mathematics and Computer Science, Computer Science"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Adrián","key":"rebolapardopau","last":"Rebola-Pardo","name":"Rebola-Pardo, Adrián","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Luís","key":"cruzfilipepau","last":"Cruz-Filipe","locid":"44dd7cea-a613-4dfd-9c6d-ac91a0729aad","name":"Cruz-Filipe, Luís","orcid":"0000-0002-7866-7484","rank":2,"rolecode":"pau"},{"affno":"","first":"Nikolaj","key":"bjørnerpedh","last":"Bjørner","name":"Bjørner, Nikolaj","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Arie","key":"gurfinkelpedh","last":"Gurfinkel","name":"Gurfinkel, Arie","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.23919/fmcad.2018.8602993","eisbn":["9780983567882"],"isbn":["9781538675670"],"pages":"197-205","publisher":"IEEE","status":"p","title":"Proceedings of the 18th Conference on Formal Methods in Computer-Aided Design, FMCAD 2018"},"review":"Peer Reviewed","scoID":["2-s2.0-85061659217"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-5bc4d8ac-1f4e-4c95-a232-ab1dcb3ee3b5"],"src":["SDU University of Southern Denmark"],"title":"Complete and Efficient DRAT Proof Checking","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-599479","year":"2019","yearsub":"2019"}
{"abstract":"New properties of the front and back ends of sorting networks are studied, illustrating their utility when searching for bounds on optimal networks. Search focuses first on the \"out-sides\" of the network and then on the inner part. Previous works focused on properties of the front end to break symmetries in the search. The new, out-side-in, properties shed understanding on how sorting networks sort, and facilitate the computation of new bounds on optimality. We present new, faster, parallel sorting networks for 17-20 inputs. For 17 inputs, we show that no sorting network using less layers exists.","author_count":5,"contributors":["Codish, Michael","Cruz-Filipe, Luís","Ehlers, Thorsten","Müller, Mike","Schneider-Kamp, Peter"],"cuid":["S01-000.00-635948"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Asia, Middle East","Europe, EU","OECD"],"country":["Germany","Israel"],"glorg":["All Global Affiliations","Ben-Gurion University of the Negev","Christian-Albrechts-University of Kiel"],"keyword":["SAT solving","Sorting networks"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"sorting networks to the end and back again","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/143077338/Sorting_networks.pdf","version":"Pre-print"},"id":"S01-000.00-635948","identifier":[{"id":"85058722595","type":"scopus"}],"ids":["sdu-db1c6619-66d7-45bd-9b86-20cb2a15fc3c"],"keyword":["SAT-solving","Sorting networks"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-9D8B81C0963C34BBDE546BF51C546912"],"oa_link":[{"access":"oa","type":"rem","url":"https://arxiv.org/pdf/1507.01428.pdf","version":"Pre-print"},{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/143077338/Sorting_networks.pdf","version":"Pre-print"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","country":"il","key":"ben gurion university of the negev","loc":["Israel","Asia, Middle East","OECD"],"name":"Ben-Gurion University of the Negev","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Science, Department of Mathematics and Computer Science"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","country":"de","key":"christian albrechts university of kiel","loc":["Germany","Europe, EU","OECD"],"name":"Christian-Albrechts-University of Kiel","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Michael","key":"codishpau","last":"Codish","name":"Codish, Michael","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Luis","key":"cruzfilipepau","last":"Cruz-Filipe","locid":"44dd7cea-a613-4dfd-9c6d-ac91a0729aad","name":"Cruz-Filipe, Luís","name_org":"Cruz-Filipe, Luis","orcid":"0000-0002-7866-7484","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Thorsten","key":"ehlerspau","last":"Ehlers","name":"Ehlers, Thorsten","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Mike","key":"müllerpau","last":"Müller","name":"Müller, Mike","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Peter","key":"schneiderkamppau","last":"Schneider-Kamp","locid":"5a2afe33-7a0e-414d-b352-b4b366c08af8","name":"Schneider-Kamp, Peter","orcid":"0000-0003-4000-5570","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.jcss.2016.04.004","issn":["00220000","10902724"],"issn_org":["00220000"],"journal":"Journal of Computer and System Sciences","pages":"184-201","publisher":"Academic Press","status":"p","title":"Journal of Computer and System Sciences","volume":"104"},"review":"Peer Reviewed","scoID":["2-s2.0-85058722595"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-db1c6619-66d7-45bd-9b86-20cb2a15fc3c"],"src":["SDU University of Southern Denmark"],"title":"Sorting networks : To the end and back again","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-635948","year":"2019","yearsub":"2019"}
{"abstract":"Choreographic Programming is a paradigm for developing correct-by-construction concurrent programs, by writing high-level descriptions of the desired communications and then synthesising process implementations automatically. So far, choreographic programming has been explored in the monadic setting: interaction terms express point-to-point communications of a single value. However, real-world systems often rely on interactions of polyadic nature, where multiple values are communicated among two or more parties, like multicast, scatter-gather, and atomic exchanges. We introduce a new model for choreographic programming equipped with a primitive for grouped interactions that subsumes all the above scenarios. Intuitively, grouped interactions can be thought of as being carried out as one single interaction. In practice, they are implemented by processes that carry them out in a concurrent fashion. After formalising the intuitive semantics of grouped interactions, we prove that choreographic programs and their implementations are correct and deadlock-free by construction.","author_count":3,"contributors":["Cruz-Filipe, Luís","Montesi, Fabrizio","Peressotti, Marco"],"cuid":["S01-000.00-623894"],"event":{"acronym":"SAC","end":"2018-04-13","place":"Pau, fr","start":"2018-04-09","title":"33rd Annual ACM Symposium on Applied Computing, SAC 2018","year":"2018"},"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Choreography","Communication patterns","Concurrency","Formal methods","Programming Languages","Semantics"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"communications in choreographies revisited","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/143086336/Communications_in_choreographies_revisited.pdf","version":"Pre-print"},"id":"S01-000.00-623894","identifier":[{"id":"85050525738","type":"scopus"}],"ids":["sdu-b0f18632-55d1-4cf3-adfe-a98645b80769"],"keyword":["Choreography","Communication patterns","Concurrency","Formal methods","Programming languages","Semantics"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-D9636D8C0F49DAB2C161F844396D80E8"],"oa_link":[{"access":"oa","type":"rem","url":"https://arxiv.org/pdf/1711.10201.pdf","version":"Pre-print"},{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/143086336/Communications_in_choreographies_revisited.pdf","version":"Pre-print"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Science, Department of Mathematics and Computer Science","SDU, Faculty of Science, Department of Mathematics and Computer Science, Computer Science"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Luís","key":"cruzfilipepau","last":"Cruz-Filipe","locid":"44dd7cea-a613-4dfd-9c6d-ac91a0729aad","name":"Cruz-Filipe, Luís","orcid":"0000-0002-7866-7484","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Fabrizio","key":"montesipau","last":"Montesi","locid":"81d9220c-ba43-48b1-aa21-129c942a9c92","name":"Montesi, Fabrizio","orcid":"0000-0003-4666-901X","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marco","key":"peressottipau","last":"Peressotti","locid":"afca1964-ceda-46fa-b7c7-f6e77e401024","name":"Peressotti, Marco","orcid":"0000-0002-0243-0480","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1145/3167132.3167267","eisbn":["9781450351911/18/04"],"pages":"1248-1255","publisher":"Association for Computing Machinery","status":"p","title":"Proceedings of the 33rd Annual ACM Symposium on Applied Computing"},"review":"Peer Reviewed","scoID":["2-s2.0-85050525738"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-b0f18632-55d1-4cf3-adfe-a98645b80769"],"src":["SDU University of Southern Denmark"],"title":"Communications in choreographies, revisited","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-623894","year":"2018","yearsub":"2018"}
{"abstract":"Active integrity constraints (AICs) constitute a formalism to associate with a database not just the constraints it should adhere to, but also how to fix the database in case one or more of these constraints are violated. The intuitions regarding which repairs are “good” given such a description are closely related to intuitions that live in various areas of non-monotonic reasoning, such as logic programming and autoepistemic logic. In this paper, we apply approximation fixpoint theory, an abstract, algebraic framework designed to unify semantics of non-monotonic logics, to the field of AICs. This results in a new family of semantics for AICs. We study properties of our new semantics and relationships to existing semantics. In particular, we argue that two of the newly defined semantics stand out. Grounded repairs have a simple definition that is purely based on semantic principles that semantics for AICs should adhere to. And, as we show, they coincide with the intended interpretation of AICs on many examples. The second semantics of interest is the AFT-well-founded semantics: it is a computationally cheap semantics that provides upper and lower bounds for many other classes of repairs.","author_count":2,"contributors":["Bogaerts, Bart","Cruz-Filipe, Luís"],"cuid":["S01-000.00-578487"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Belgium"],"glorg":["All Global Affiliations","University of Leuven"],"keyword":["Active integrity constraints"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"fixpoint semantics for active integrity constraints","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/135803808/Fixpoint_Semantics_for_Active_Integrity_Constraints.pdf","version":"Authors Final Version"},"id":"S01-000.00-578487","identifier":[{"id":"85037066720","type":"scopus"}],"ids":["sdu-128b6a6b-457f-4ca0-8f32-d13fafec1692"],"keyword":["Active integrity constraints","Approximation fixpoint theory"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-C4D8E23E9EFCBF7BD43EDA8AE93AE14F"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/135803808/Fixpoint_Semantics_for_Active_Integrity_Constraints.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","country":"be","key":"university of leuven","loc":["Belgium","Europe, EU","OECD"],"name":"University of Leuven","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Science, Department of Mathematics and Computer Science","SDU, Faculty of Science, Department of Mathematics and Computer Science, Computer Science"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Bart","key":"bogaertspau","last":"Bogaerts","name":"Bogaerts, Bart","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Luís","key":"cruzfilipepau","last":"Cruz-Filipe","locid":"44dd7cea-a613-4dfd-9c6d-ac91a0729aad","name":"Cruz-Filipe, Luís","orcid":"0000-0002-7866-7484","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.artint.2017.11.003","issn":["00043702","18727921"],"issn_org":["00043702"],"journal":"Artificial Intelligence","pages":"43-70","publisher":"Elsevier","status":"p","title":"Artificial Intelligence","volume":"255"},"review":"Peer Reviewed","scoID":["2-s2.0-85037066720"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-128b6a6b-457f-4ca0-8f32-d13fafec1692"],"src":["SDU University of Southern Denmark"],"title":"Fixpoint Semantics for Active Integrity Constraints","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-578487","year":"2018","yearsub":"2018"}
{"abstract":"In the database world, integrity constraints are essential to guarantee database integrity. The related problem of database repair deals with finding the best way to change a database so that it satisfies its integrity constraints. These two topics have been studied intensively since the 1980s. The formalism of active integrity constraints, proposed in 2004, aims at addressing them jointly, by providing a syntax whereby a particular subclass of integrity constraints can be specified together with preferred ways to repair inconsistency. In the last decade, several authors have proposed adaptations of the notion of integrity constraints to other reasoning frameworks than relational databases. In this article, we extend this line of work in two ways. First, we target multi-context systems, a general-purpose framework for combining heterogeneous reasoning systems, able to model most other reasoning frameworks, as we demonstrate. Second, we extend the notions of active integrity constraints and grounded repairs to this generalized setting. This way of including repair suggestions inside integrity constraints, subject to a validity check, enables us to define simple iterative algorithms to find all possible grounded repairs for an inconsistent multi-context system, avoiding the need to solve complex or undecidable problems.","author_count":4,"contributors":["Cruz-Filipe, Luís","Gaspar, Graça","Nunes, Isabel","Schneider-Kamp, Peter"],"cuid":["S01-000.00-607383"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"corresponding_author":["Cruz-Filipe, Luís"],"country":["Portugal"],"glorg":["All Global Affiliations","Technical University of Lisbon"],"keyword":["Ontologies"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"active integrity constraints for general purpose knowledge bases","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85043698734","version":"Other Version"},"funding_acknowledgement":["Supported by the Danish Council for Independent Research, Natural Sciences, grants DFF-1323-00247 and DFF-7014-00041, and by FCT/MCTES/PIDDAC under center grant to BioISI (Center Reference: UID/MULTI/04046/2013)."],"id":"S01-000.00-607383","identifier":[{"id":"85043698734","type":"scopus"}],"ids":["sdu-773df411-3847-4705-8181-85a3c48ff239"],"keyword":["Integrity constraints","Multi-context systems","Ontologies","Repairs"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-7B82F41C913B245B09974BAB500B3580"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Science, Department of Mathematics and Computer Science","SDU, Faculty of Science, Department of Mathematics and Computer Science, Computer Science"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"pt","key":"technical university of lisbon","loc":["Portugal","Europe, EU","OECD"],"name":"Technical University of Lisbon","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Luís","key":"cruzfilipepau","last":"Cruz-Filipe","locid":"44dd7cea-a613-4dfd-9c6d-ac91a0729aad","name":"Cruz-Filipe, Luís","orcid":"0000-0002-7866-7484","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Graça","key":"gasparpau","last":"Gaspar","name":"Gaspar, Graça","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Isabel","key":"nunespau","last":"Nunes","name":"Nunes, Isabel","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter","key":"schneiderkamppau","last":"Schneider-Kamp","locid":"5a2afe33-7a0e-414d-b352-b4b366c08af8","name":"Schneider-Kamp, Peter","orcid":"0000-0003-4000-5570","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1007/s10472-018-9577-y","issn":["10122443","15737470"],"issn_org":["10122443"],"issue":"3-4","journal":"Annals of Mathematics and Artificial Intelligence","pages":"213-246","publisher":"Springer","status":"p","title":"Annals of Mathematics and Artificial Intelligence","volume":"83"},"review":"Peer Reviewed","scoID":["2-s2.0-85043698734"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-773df411-3847-4705-8181-85a3c48ff239"],"src":["SDU University of Southern Denmark"],"title":"Active integrity constraints for general-purpose knowledge bases","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-607383","year":"2018","yearsub":"2018"}
{"abstract":"Clausal proofs have become a popular approach to validate the results of SAT solvers. However, validating clausal proofs in the most widely supported format (DRAT) is expensive even in highly optimized implementations. We present a new format, called LRAT, which extends the DRAT format with hints that facilitate a simple and fast validation algorithm. Checking validity of LRAT proofs can be implemented using trusted systems such as the languages supported by theorem provers. We demonstrate this by implementing two certified LRAT checkers, one in Coq and one in ACL2.","author_count":6,"contributors":["Cruz-Filipe, Luís","Heule, Marijn","Hunt, Jr, Warren","Kaufmann, Matt","Schneider-Kamp, Peter"],"cuid":["S01-000.00-573917"],"event":{"acronym":"CADE","end":"2017-08-11","place":"Gothenburg, se","start":"2017-08-06","title":"26th International Conference on Automated Deduction","year":"2017"},"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","University of Texas at Austin"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"efficient certified rat verification","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/141252237/Efficient_Certified_RAT_Verification.pdf","version":"Pre-print"},"id":"S01-000.00-573917","identifier":[{"id":"85026782306","type":"scopus"}],"ids":["sdu-026f0018-4514-4833-8dc1-653b75a36365"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-BEB3003831E0984CC141F7E26BAA3A86"],"oa_link":[{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/141252237/Efficient_Certified_RAT_Verification.pdf","version":"Pre-print"},{"access":"oa","type":"rem","url":"https://arxiv.org/pdf/1612.02353.pdf","version":"Pre-print"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Science, Department of Mathematics and Computer Science","SDU, Faculty of Science, Department of Mathematics and Computer Science, Computer Science"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"us","key":"university of texas at austin","loc":["United States","America, North","OECD"],"name":"University of Texas at Austin","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Luís","key":"cruzfilipepau","last":"Cruz-Filipe","locid":"44dd7cea-a613-4dfd-9c6d-ac91a0729aad","name":"Cruz-Filipe, Luís","orcid":"0000-0002-7866-7484","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Marijn","key":"heulepau","last":"Heule","name":"Heule, Marijn","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Warren","key":"huntjrpau","last":"Hunt, Jr","name":"Hunt, Jr, Warren","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Matt","key":"kaufmannpau","last":"Kaufmann","name":"Kaufmann, Matt","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter","key":"schneiderkamppau","last":"Schneider-Kamp","locid":"5a2afe33-7a0e-414d-b352-b4b366c08af8","name":"Schneider-Kamp, Peter","orcid":"0000-0003-4000-5570","rank":5,"rolecode":"pau"},{"affno":"","first":"Leonardo","key":"demourapedh","last":"de Moura","name":"de Moura, Leonardo","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-319-63046-5_14","eisbn":["9783319630465"],"isbn":["9783319630458"],"issn":["03029743"],"pages":"220-236","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","subtitle":"Proceedings of the 26th International Conference on Automated Deduction","title":"Automated Deduction - CADE 26"},"review":"Peer Reviewed","scoID":["2-s2.0-85026782306"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-026f0018-4514-4833-8dc1-653b75a36365"],"src":["SDU University of Southern Denmark"],"title":"Efficient Certified RAT Verification","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-573917","year":"2017","yearsub":"2017"}
{"abstract":"Choreographies are global descriptions of interactions among concurrent components, most notably used in the settings of verification and synthesis of correct-by-construction software. They require a top-down approach: programmers first write choreographies, and then use them to verify or synthesize their programs. However, most software does not come with choreographies yet, which prevents their application. To attack this problem, previous work investigated choreography extraction, which automatically constructs a choreography that describes the behavior of a given set of programs or protocol specifications. We propose a new extraction methodology that improves on the state of the art: we can deal with programs that are equipped with state and internal computation; time complexity is dramatically better; and we capture programs that work by exploiting asynchronous communication.","author_count":5,"contributors":["Cruz-Filipe, Luís","Larsen, Kim Skak","Montesi, Fabrizio"],"cuid":["S01-000.00-575888"],"event":{"acronym":"FoSSaCS","end":"2017-04-29","place":"Uppsala, se","start":"2017-04-22","title":"20th International Conference on Foundations of Software Science and Computation Structures","year":"2017"},"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"the paths to choreography extraction","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/141252101/The_Paths_to_Choreography_Extraction.pdf","version":"Pre-print"},"id":"S01-000.00-575888","identifier":[{"id":"85015937808","type":"scopus"}],"ids":["sdu-097341b5-7578-4aed-aa0b-dc9c32b111aa"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-E1329A37A0DC17DA3715FC496340FC23"],"oa_link":[{"access":"oa","type":"rem","url":"https://arxiv.org/pdf/1610.10050.pdf","version":"Pre-print"},{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/141252101/The_Paths_to_Choreography_Extraction.pdf","version":"Pre-print"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Science, Department of Mathematics and Computer Science, Computer Science"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Luís","key":"cruzfilipepau","last":"Cruz-Filipe","locid":"44dd7cea-a613-4dfd-9c6d-ac91a0729aad","name":"Cruz-Filipe, Luís","orcid":"0000-0002-7866-7484","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kim S.","key":"larsenpau","last":"Larsen","locid":"0ecf13aa-3ad6-43a2-bd87-35fe8761ac7a","name":"Larsen, Kim Skak","name_org":"Larsen, Kim S.","orcid":"0000-0003-0560-3794","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Fabrizio","key":"montesipau","last":"Montesi","locid":"81d9220c-ba43-48b1-aa21-129c942a9c92","name":"Montesi, Fabrizio","orcid":"0000-0003-4666-901X","rank":3,"rolecode":"pau"},{"affno":"","first":"Javier","key":"esparzapedh","last":"Esparza","name":"Esparza, Javier","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Andrzej S.","key":"murawskipedh","last":"Murawski","name":"Murawski, Andrzej S.","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-662-54458-7_25","eisbn":["9783662544587"],"isbn":["9783662544570"],"issn":["03029743"],"pages":"424-440","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","subtitle":"Proceedings of the 20th International Conference, FOSSACS 2017, Held as Part of the European Joint Conferences on Theory and Practice of Software, ETAPS 2017","title":"Foundations of Software Science and Computation Structures"},"review":"Peer Reviewed","scoID":["2-s2.0-85015937808"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-097341b5-7578-4aed-aa0b-dc9c32b111aa"],"src":["SDU University of Southern Denmark"],"title":"The Paths to Choreography Extraction","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-575888","year":"2017","yearsub":"2017"}
{"abstract":"In this paper, we show how the theory of sorting networks can be applied to synthesize optimized general-purpose sorting libraries. Standard sorting libraries are often based on combinations of the classic Quicksort algorithm, with insertion sort applied as base case for small, fixed, numbers of inputs. Unrolling the code for the base case by ignoring loop conditions eliminates branching, resulting in code equivalent to a sorting network. By replacing it with faster sorting networks, we can improve the performance of these algorithms. We show that by considering the number of comparisons and swaps alone we are not able to predict any real advantage of this approach. However, significant speed-ups are obtained when taking advantage of instruction level parallelism and non-branching conditional assignment instructions, both of which are common in modern CPU architectures. Furthermore, a close control of how often registers have to be spilled to memory gives us a complete explanation of the performance of different sorting networks, allowing us to choose an optimal one for each particular architecture. Our experimental results show that using code synthesized from these efficient sorting networks as the base case for Quicksort libraries results in significant real-world speed-ups.","author_count":4,"contributors":["Codish, Michael","Cruz-Filipe, Luís","Nebel, Markus E.","Schneider-Kamp, Peter"],"cuid":["S01-000.00-612831"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Asia, Middle East","OECD"],"country":["Israel"],"glorg":["All Global Affiliations","Ben-Gurion University of the Negev"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"optimizing sorting algorithms by using sorting networks","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84994504826","version":"Other Version"},"id":"S01-000.00-612831","identifier":[{"id":"84994504826","type":"scopus"}],"ids":["sdu-8a3c01a5-9ae5-490d-bcd2-01b847ec1dda"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-EC7C1812E834CC1443B62CA1E8A256D2"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","country":"il","key":"ben gurion university of the negev","loc":["Israel","Asia, Middle East","OECD"],"name":"Ben-Gurion University of the Negev","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Science, Department of Mathematics and Computer Science, Computer Science"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Michael","key":"codishpau","last":"Codish","name":"Codish, Michael","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Luis","key":"cruzfilipepau","last":"Cruz-Filipe","locid":"44dd7cea-a613-4dfd-9c6d-ac91a0729aad","name":"Cruz-Filipe, Luís","name_org":"Cruz-Filipe, Luis","orcid":"0000-0002-7866-7484","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Markus","key":"nebelpau","last":"Nebel","locid":"4404941b-c94e-417e-83ad-5f01a5ba9db5","name":"Nebel, Markus E.","name_org":"Nebel, Markus","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Peter","key":"schneiderkamppau","last":"Schneider-Kamp","locid":"5a2afe33-7a0e-414d-b352-b4b366c08af8","name":"Schneider-Kamp, Peter","orcid":"0000-0003-4000-5570","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1007/s00165-016-0401-3","issn":["09345043","1433299X"],"issn_org":["09345043"],"issue":"3","journal":"Formal Aspects of Computing","pages":"559-579","publisher":"Association for Computing Machinery","status":"p","title":"Formal Aspects of Computing","volume":"29"},"review":"Peer Reviewed","scoID":["2-s2.0-84994504826"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-8a3c01a5-9ae5-490d-bcd2-01b847ec1dda"],"src":["SDU University of Southern Denmark"],"title":"Optimizing Sorting Algorithms by Using Sorting Networks","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-612831","year":"2017","yearsub":"2017"}
{"abstract":"Active integrity constraints (AICs) constitute a formalism to associate with a database not just the constraints it should adhere to, but also how to fix the database in case one or more of these constraints are violated. The intuitions regarding which repairs are “good” given such a description are closely related to intuitions that live in various areas of non-monotonic reasoning. In this paper, we apply approximation fixpoint theory, an algebraic framework that unifies semantics of non-monotonic logics, to the field of AICs. This results in a new family of semantics for AICs, of which we study semantics and relationships to existing semantics. We argue that the AFT-well-founded semantics has some desirable properties.","author_count":3,"contributors":["Bogaerts, Bart","Cruz-Filipe, Luís"],"cuid":["S01-000.00-621828"],"event":{"acronym":"IJCAI","end":"2017-08-25","place":"Melbourne, au","start":"2007-08-19","title":"2017 International Joint Conferences on Artificial Intelligence Organization","year":"2007"},"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Belgium"],"glorg":["All Global Affiliations","University of Leuven"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"semantics for active integrity constraints using approximation fixpoint theory","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85031942106","version":"Other Version"},"id":"S01-000.00-621828","identifier":[{"id":"85031942106","type":"scopus"}],"ids":["sdu-a9ba84a6-e01c-44c7-973c-c2fe2fe50308"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-4F24F920247F177BE9058060D9D3DB16"],"org":[{"affno":"1","country":"be","key":"university of leuven","loc":["Belgium","Europe, EU","OECD"],"name":"University of Leuven","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Science, Department of Mathematics and Computer Science","SDU, Faculty of Science, Department of Mathematics and Computer Science, Computer Science"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Bart","key":"bogaertspau","last":"Bogaerts","name":"Bogaerts, Bart","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Luís","key":"cruzfilipepau","last":"Cruz-Filipe","locid":"44dd7cea-a613-4dfd-9c6d-ac91a0729aad","name":"Cruz-Filipe, Luís","orcid":"0000-0002-7866-7484","rank":2,"rolecode":"pau"},{"affno":"","first":"Charles","key":"sierrapedh","last":"Sierra","name":"Sierra, Charles","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.24963/ijcai.2017/120","eisbn":["9780999241103"],"pages":"866-872","publisher":"IJCAI","status":"p","title":"Proceedings of the Twenty-Sixth International Joint Conference on Artificial Intelligence"},"review":"Peer Reviewed","scoID":["2-s2.0-85031942106"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-a9ba84a6-e01c-44c7-973c-c2fe2fe50308"],"src":["SDU University of Southern Denmark"],"title":"Semantics for Active Integrity Constraints Using Approximation Fixpoint Theory","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-621828","year":"2017","yearsub":"2017"}
{"abstract":"Choreographies are widely used both for the specification and the programming of concurrent and distributed software architectures. Since many of such architectures use asynchronous communications, it is essential to understand how the behaviour described in a choreography can be correctly implemented in asynchronous settings. So far, this problem has been addressed by relying on additional technical machinery, such as ad-hoc syntactic terms, semantics, or equivalences. In this work, we show that such extensions are not needed for choreography languages that support primitives for process spawning and name mobility. Instead, we can just encode asynchronous communications in choreographies themselves, yielding a simpler approach.","author_count":2,"contributors":["Cruz-Filipe, Luís","Montesi, Fabrizio"],"cuid":["S01-000.00-645947"],"event":{"acronym":"SAC","end":"2017-04-07","place":"Marrakesh, ma","start":"2017-04-03","title":"32nd Annual ACM Symposium on Applied Computing","year":"2017"},"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Asynchrony","Choreography","Concurrency"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"encoding asynchrony in choreographies","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://arxiv.org/pdf/1711.11211.pdf","version":"Pre-print"},"id":"S01-000.00-645947","identifier":[{"id":"85020887733","type":"scopus"}],"ids":["sdu-fe11d5b4-2a12-4509-af6e-9bba3d4f81e0"],"keyword":["Asynchrony","Choreography","Concurrency"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-1DE2B34469CC2FB7DC053E80B64FDE33"],"oa_link":[{"access":"oa","type":"rem","url":"https://arxiv.org/pdf/1711.11211.pdf","version":"Pre-print"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Science, Department of Mathematics and Computer Science","SDU, Faculty of Science, Department of Mathematics and Computer Science, Computer Science"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Luis","key":"cruzfilipepau","last":"Cruz-Filipe","locid":"44dd7cea-a613-4dfd-9c6d-ac91a0729aad","name":"Cruz-Filipe, Luís","name_org":"Cruz-Filipe, Luis","orcid":"0000-0002-7866-7484","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Fabrizio","key":"montesipau","last":"Montesi","locid":"81d9220c-ba43-48b1-aa21-129c942a9c92","name":"Montesi, Fabrizio","orcid":"0000-0003-4666-901X","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1145/3019612.3019901","eisbn":["9781450344869"],"isbn":["9781450344869"],"pages":"1175-1177","publisher":"Association for Computing Machinery","status":"p","title":"Proceedings of the Symposium on Applied Computing"},"review":"Peer Reviewed","scoID":["2-s2.0-85020887733"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-fe11d5b4-2a12-4509-af6e-9bba3d4f81e0"],"src":["SDU University of Southern Denmark"],"title":"Encoding Asynchrony in Choreographies","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-645947","year":"2017","yearsub":"2017"}
{"abstract":"The combination of logic program-style rules with other reasoning systems has been a fertile topic of research in the last years, with the proposal of several different systems that achieve this goal. In this work, we look at two of these systems, dl-programs and multi-context systems, which address different aspects of this combination, and include different, incomparable programming constructs. We prove that every dl-program can be transformed into a multi-context system in such a way that the different semantics for each paradigm are naturally related. As a consequence, constructions developed for dl-programs can be automatically ported to multi-context systems. In particular, we show how to model default rules over ontologies with the usual semantics.","author_count":3,"contributors":["Cruz-Filipe, Luís","Gaspar, Graca","Nunes, Isabel"],"cuid":["S01-000.00-586123"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Portugal"],"glorg":["All Global Affiliations","University of Lisbon"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"from description logic programs to multi context systems","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85025684927","version":"Other Version"},"id":"S01-000.00-586123","identifier":[{"id":"85025684927","type":"scopus"}],"ids":["sdu-2d177fae-50e1-4441-9f15-6296eb275fe6"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-AC6E89BF6DD62196F735CFEB63465D3E"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Science, Department of Mathematics and Computer Science, Computer Science"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"pt","key":"university of lisbon","loc":["Portugal","Europe, EU","OECD"],"name":"University of Lisbon","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Luis","key":"cruzfilipepau","last":"Cruz-Filipe","locid":"44dd7cea-a613-4dfd-9c6d-ac91a0729aad","name":"Cruz-Filipe, Luís","name_org":"Cruz-Filipe, Luis","orcid":"0000-0002-7866-7484","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Graca","key":"gasparpau","last":"Gaspar","name":"Gaspar, Graca","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Isabel","key":"nunespau","last":"Nunes","name":"Nunes, Isabel","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.jlamp.2017.01.005","issn":["23522208","23522216"],"issn_org":["23522208"],"journal":"Journal of Logic and Algebraic Programming","pages":"26-44","publisher":"Elsevier","status":"p","title":"Journal of Logic and Algebraic Programming","title_org":"Journal of Logical and Algebraic Methods in Programming","volume":"88"},"review":"Peer Reviewed","scoID":["2-s2.0-85025684927"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-2d177fae-50e1-4441-9f15-6296eb275fe6"],"src":["SDU University of Southern Denmark"],"title":"From description-logic programs to multi-context systems","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-586123","year":"2017","yearsub":"2017"}
{"abstract":"Choreographic Programming is a paradigm for the development of concurrent software, where deadlocks are prevented syntactically. However, choreography languages are typically synchronous, whereas many real-world systems have asynchronous communications. Previous attempts at enriching choreographies with asynchrony rely on ad-hoc constructions, whose adequacy is only argued informally. In this work, we formalise the properties that an asynchronous semantics for choreographies should have: messages can be sent without the intended receiver being ready, and all sent messages are eventually received. We explore how out-of-order execution, used in choreographies for modelling concurrency, can be exploited to endow choreographies with an asynchronous semantics. Our approach satisfies the properties we identified. We show how our development yields a pleasant correspondence with FIFO-based asynchronous messaging, modelled in a process calculus, and discuss how it can be adopted in more complex choreography models.","author_count":2,"contributors":["Cruz-Filipe, Luís","Montesi, Fabrizio"],"cuid":["S01-000.00-646307"],"event":{"end":"2017-06-23","start":"2017-06-22","title":"10th Interaction and Concurrency Experience","year":"2017"},"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"on asynchrony and choreographies","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.4204/EPTCS.261.8","version":"Published Version"},"id":"S01-000.00-646307","identifier":[{"id":"85040462783","type":"scopus"}],"ids":["sdu-ff48fbb4-4a96-41e9-8316-643ba9ae487a"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-372EB3B2A35D6051EE470906F00B2C30"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/135782006/On_Asynchrony_and_Choreographies.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.4204/EPTCS.261.8","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Science, Department of Mathematics and Computer Science","SDU, Faculty of Science, Department of Mathematics and Computer Science, Computer Science"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Luís","key":"cruzfilipepau","last":"Cruz-Filipe","locid":"44dd7cea-a613-4dfd-9c6d-ac91a0729aad","name":"Cruz-Filipe, Luís","orcid":"0000-0002-7866-7484","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Fabrizio","key":"montesipau","last":"Montesi","locid":"81d9220c-ba43-48b1-aa21-129c942a9c92","name":"Montesi, Fabrizio","orcid":"0000-0003-4666-901X","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.4204/eptcs.261.8","issn":["20752180"],"journal":"Electronic Proceedings in Theoretical Computer Science","pages":"76-90","publisher":"Open Publishing Association","status":"p","title":"Electronic Proceedings in Theoretical Computer Science","volume":"261"},"review":"Peer Reviewed","scoID":["2-s2.0-85040462783"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-ff48fbb4-4a96-41e9-8316-643ba9ae487a"],"src":["SDU University of Southern Denmark"],"title":"On Asynchrony and Choreographies","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-646307","year":"2017","yearsub":"2017"}
{"abstract":"We solve a 40-year-old open problem on depth optimality of sorting networks. In 1973, Donald E. Knuth detailed sorting networks of the smallest depth known for n≤16 inputs, quoting optimality for n≤8 (Volume 3 of “The Art of Computer Programming”). In 1989, Parberry proved optimality of networks with 9≤n≤10 inputs. We present a general technique for obtaining such results, proving optimality of the remaining open cases of 11≤n≤16 inputs. Exploiting symmetry, we construct a small set Rn of two-layer networks such that: if there is a depth-k sorting network on n inputs, then there is one whose first layers are in Rn. For each network in Rn, we construct a propositional formula whose satisfiability is necessary for the existence of a depth-k sorting network. Using an off-the-shelf SAT solver we prove optimality of the sorting networks listed by Knuth. For n≤10 inputs, our algorithm is orders of magnitude faster than prior ones.","author_count":5,"contributors":["Bundala, Daniel","Codish, Michael","Cruz-Filipe, Luís","Schneider-Kamp, Peter","Závodný, Jakub"],"cuid":["S01-000.00-573671"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Asia, Middle East","Europe, Non-EU","OECD"],"country":["Israel","United Kingdom"],"glorg":["All Global Affiliations","Ben-Gurion University of the Negev","University of Oxford"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"optimal depth sorting networks","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/141250472/Optimal_depth_sorting_networks.pdf","version":"Pre-print"},"id":"S01-000.00-573671","identifier":[{"id":"84995592246","type":"scopus"}],"ids":["sdu-017e73f5-eca6-4a36-9596-fe3610d6d81b"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-FB523DC05E23BFD9AE5326A618F9E788"],"oa_link":[{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/141250472/Optimal_depth_sorting_networks.pdf","version":"Pre-print"},{"access":"oa","type":"rem","url":"https://arxiv.org/pdf/1412.5302.pdf","version":"Pre-print"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","country":"gb","key":"university of oxford","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Oxford","used":1},{"affno":"2","country":"il","key":"ben gurion university of the negev","loc":["Israel","Asia, Middle East","OECD"],"name":"Ben-Gurion University of the Negev","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Science, Department of Mathematics and Computer Science","SDU, Faculty of Science, Department of Mathematics and Computer Science, Computer Science"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Daniel","key":"bundalapau","last":"Bundala","name":"Bundala, Daniel","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Michael","key":"codishpau","last":"Codish","name":"Codish, Michael","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Luís","key":"cruzfilipepau","last":"Cruz-Filipe","locid":"44dd7cea-a613-4dfd-9c6d-ac91a0729aad","name":"Cruz-Filipe, Luís","orcid":"0000-0002-7866-7484","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Peter","key":"schneiderkamppau","last":"Schneider-Kamp","locid":"5a2afe33-7a0e-414d-b352-b4b366c08af8","name":"Schneider-Kamp, Peter","orcid":"0000-0003-4000-5570","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jakub","key":"závodnýpau","last":"Závodný","name":"Závodný, Jakub","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.jcss.2016.09.004","issn":["00220000","10902724"],"issn_org":["00220000"],"journal":"Journal of Computer and System Sciences","pages":"185-204","publisher":"Academic Press","status":"p","title":"Journal of Computer and System Sciences","volume":"84"},"review":"Peer Reviewed","scoID":["2-s2.0-84995592246"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-017e73f5-eca6-4a36-9596-fe3610d6d81b"],"src":["SDU University of Southern Denmark"],"title":"Optimal-depth sorting networks","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-573671","year":"2017","yearsub":"2017"}
{"abstract":"The problem of database consistency relative to a set of integrity constraints has been extensively studied since the 1980s, and is still recognized as one of the most important and complex in the field. In recent years, with the proliferation of knowledge repositories (not only databases) in practical applications, there has also been an effort to develop implementations of consistency maintenance algorithms that have a solid theoretical basis. The framework of active integrity constraints (AICs) is one example of such an effort, providing theoretical grounds for rule-based algorithms for ensuring database consistency. An AIC consists of an integrity constraint together with a specification of actions that may be taken to repair a database that does not satisfy it. Both denotational and operational semantics have been proposed for AICs. In this paper, we describe repAIrC, a prototype implementation of the algorithms previously proposed targetting SQL databases, i.e., the most prolific type of databases. Using repAIrC, we can both validate an SQL database with respect to a given set of AICs and compute possible repairs in case the database is inconsistent; the tool is able to work with the different kinds of repairs that have been considered, and achieves optimal asymptotic complexity in their computation. It also implements strategies for parallelizing the search for repairs, which in many cases can make untractable problems become easily solvable.","author_count":11,"contributors":["Cruz-Filipe, Luís","Franz, Michael","Hakhverdyan, Artavazd","Ludovico, Marta","Nunes, Isabel","Schneider-Kamp, Peter"],"cuid":["S01-000.00-596481"],"event":{"end":"2015-11-14","place":"Lisbon, pt","start":"2015-11-12","title":"7th International Joint Conference on Knowledge Discovery, Knowledge Engineering and Knowledge Management","year":"2015"},"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Portugal"],"glorg":["All Global Affiliations","University of Lisbon"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"active integrity constraints from theory to implementation","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85011392078","version":"Other Version"},"id":"S01-000.00-596481","identifier":[{"id":"85011392078","type":"scopus"}],"ids":["sdu-5136ceec-0555-4abb-95c0-af0c11cf4799"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-60EFA90A00EC9B91CB80A001F0F77E33"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Science, Department of Mathematics and Computer Science","SDU, Faculty of Science, Department of Mathematics and Computer Science, Computer Science"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"pt","key":"university of lisbon","loc":["Portugal","Europe, EU","OECD"],"name":"University of Lisbon","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Luis","key":"cruzfilipepau","last":"Cruz-Filipe","locid":"44dd7cea-a613-4dfd-9c6d-ac91a0729aad","name":"Cruz-Filipe, Luís","name_org":"Cruz-Filipe, Luis","orcid":"0000-0002-7866-7484","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Michael","key":"franzpau","last":"Franz","locid":"05fa8cd6-e6f7-4e6a-a1fd-69b73ec12c50","name":"Franz, Michael","rank":