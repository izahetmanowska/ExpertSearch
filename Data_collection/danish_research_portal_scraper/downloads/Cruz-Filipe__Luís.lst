uzfilipepau","last":"Cruz-Filipe","locid":"44dd7cea-a613-4dfd-9c6d-ac91a0729aad","name":"Cruz-Filipe, Luís","orcid":"0000-0002-7866-7484","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Elisabetta","key":"dinittopau","last":"Di Nitto","name":"Di Nitto, Elisabetta","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jacopo","key":"mauropau","last":"Mauro","locid":"ad1ad59c-7294-44a8-98d6-d5329b94baac","name":"Mauro, Jacopo","orcid":"0000-0002-5285-2868","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1145/3329379","pages":"1224","publisher":"Association for Computing Machinery","status":"p","title":"Proceedings of the 34th ACM/SIGAPP Symposium on Applied Computing"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-daa9f437-f185-4516-bf83-fe53c0653e3f"],"src":["SDU University of Southern Denmark"],"title":"Special track on microservices, devops, and service-oriented architecture","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-635824","year":"2019","yearsub":"2019"}
{"abstract":"We present Multiparty Classical Choreographies (MCC), a language model where global descriptions of communicating systems (choreographies) implement typed multiparty sessions. Typing is achieved by generalising classical linear logic to judgements that explicitly record parallelism by means of hypersequents. Our approach unifies different lines of work on choreographies and processes with multiparty sessions, as well as their connection to linear logic. Thus, results developed in one context are carried over to the others. Key novelties of MCC include support for server invocation in choreographies, as well as logic-driven compilation of choreographies with replicated processes.","author_count":6,"contributors":["Carbone, Marco","Cruz-Filipe, Luís","Montesi, Fabrizio","Murawska, Agata"],"cuid":["S01-000.00-606994"],"event":{"acronym":"LOPSTR","end":"2018-09-06","place":"Frankfurt, de","start":"2018-09-04","title":"28th International Symposium on Logic-Based Program Synthesis and Transformation, LOPSTR 2018","year":"2018"},"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Carbone, Marco"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-SDU"]},"level3all":["DI-U-ITU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"multiparty classical choreographies","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://arxiv.org/pdf/1808.05088.pdf","version":"Pre-print"},"id":"S01-000.00-606994","identifier":[{"id":"85064049666","type":"scopus"}],"ids":["sdu-761616b7-5223-435c-8664-1be02c302e2e"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-4FF7E088212ABBC14B4D078B553295A3"],"oa_link":[{"access":"oa","type":"rem","url":"https://arxiv.org/pdf/1808.05088.pdf","versio