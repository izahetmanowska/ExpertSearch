u"},{"affno":"5 6","first":"Marta","key":"ribasésmartapau","last":"Ribasés","name":"Ribasés, Marta","rank":143,"rolecode":"pau"},{"affno":"4","first":"Paul","key":"lichtensteinpaulpau","last":"Lichtenstein","name":"Lichtenstein, Paul","rank":144,"rolecode":"pau"},{"affno":"65","first":"Sebastian","key":"lundströmsebastianpau","last":"Lundström","name":"Lundström, Sebastian","rank":145,"rolecode":"pau"},{"affno":"3","first":"Robert","key":"plominrobertpau","last":"Plomin","name":"Plomin, Robert","rank":146,"rolecode":"pau"},{"affno":"1 25","first":"Meike","key":"bartelsmeikepau","last":"Bartels","name":"Bartels, Meike","rank":147,"rolecode":"pau"},{"affno":"1","first":"Michel G.","key":"nivardmichelgpau","last":"Nivard","name":"Nivard, Michel G.","rank":148,"rolecode":"pau"},{"affno":"1 25","first":"Dorret I.","key":"boomsmadorretipau","last":"Boomsma","name":"Boomsma, Dorret I.","rank":149,"rolecode":"pau"}],"pmid":["34330890"],"pub":{"doi":"10.1038/s41398-021-01480-x","issn":["21583188"],"issue":"1","journal":"Translational Psychiatry","paperid":"413","status":"p","title":"Translational Psychiatry","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-85111704583"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-1e535179-48e6-4cba-8012-f7ec091e7a5e"],"src":["KU University of Copenhagen"],"title":"Genetic association study of childhood aggression across raters, instruments, and age","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-411463","year":"2021","yearsub":"2021"}
{"abstract":"Decision makers strive for optimal ways of production and usage of energy. To adjust their behavior to the future situation of markets and technology, the execution of different models predicting e.g. energy consumption, energy production, prices and consumer behavior is necessary. This execution is itself time-consuming and requires input data management. Furthermore, since different models cover different aspects of the energy domain, they need to be linked. To speed up the linkage and reduce manual errors, these linkage needs to be automated. We present IRPsim, an infrastructure for computation of different models and their linkage. The IRPsim-infrastructure enables management of model data in a structured database, parallelized model execution and automatic model linkage. Thereby, IRPsim allows researchers and practitioners to use energy system models for strategic business model analysis.","author_count":8,"contributors":["Reichelt, David Georg","Kühne, Stefan","Scheller, Fabian","Abitz, Daniel","Johanning, Simon"],"cuid":["S01-000.00-342878"],"event":{"end":"2020-10-01","place":"Karlsrühe, de","start":"2020-09-29","title":"Informatik 2020","year":"2020"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","Universität Leipzig"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"towards an infrastructure for energy model computation and linkage","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.18420/inf2020_21","version":"Published Version"},"id":"S01-000.00-342878","identifier":[{"id":"85118498391","type":"scopus"}],"ids":["dtu-80517ac4-c92e-42ef-be15-9dd64ae5dcce"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-C155F86C23C6FA6D8D94B5576C561E95"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/246753121/Reichelt_Towards_an_Infrastructure_for_Energy_Model_Computation_and_Linkage_171.pdf","version":"Authors Final Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.18420/inf2020_21","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/246753259/C2_1_1_.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"de","key":"universität leipzig","loc":["Germany","Europe, EU","OECD"],"name":"Universität Leipzig","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Technology, Management and Economics","Technical University of Denmark, Department of Technology, Management and Economics, Sustainability","Technical University of Denmark, Department of Technology, Management and Economics, Sustainability, Energy Systems Analysis"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"David Georg","key":"reicheltpau","last":"Reichelt","name":"Reichelt, David Georg","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Stefan","key":"kühnepau","last":"Kühne","name":"Kühne, Stefan","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Fabian","key":"schellerpau","last":"Scheller","locid":"7e830db3-1b7e-484e-9a1b-8c6848f0ca47","name":"Scheller, Fabian","orcid":"0000-0002-7676-1143","rank":3,"rolecode":"pau"},{"affno":"1","corres