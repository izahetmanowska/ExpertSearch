"rolecode":"pau"},{"affno":"41","corresponding":null,"first":"Vaclav","key":"kouckypau","last":"Koucky","name":"Koucky, Vaclav","rank":50,"rolecode":"pau"},{"affno":"42","corresponding":null,"first":"Juan A.","key":"lópezandreupau","last":"López-Andreu","name":"López-Andreu, Juan A.","rank":51,"rolecode":"pau"},{"affno":"43","corresponding":null,"first":"Nadia","key":"nathanpau","last":"Nathan","name":"Nathan, Nadia","rank":52,"rolecode":"pau"}],"pmid":["40054602"],"pub":{"doi":"10.1016/j.chest.2025.02.023","issn":["00123692","19313543"],"issn_org":["00123692"],"issue":"1","journal":"Chest","pages":"171-182","publisher":"Elsevier Inc.","status":"p","title":"Chest","volume":"168"},"review":"Peer Reviewed","scoID":["2-s2.0-105007425575"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities"],"PST":["Published"]},"sid":["au-7f0ceaf6-c630-40c6-913f-430c9e16e031"],"src":["AU Aarhus University"],"title":"Diagnostic Evaluation and Clinical Findings in Children With Persistent Tachypnea of Infancy/Neuroendocrine Cell Hyperplasia of Infancy : A European Multicenter Retrospective Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-816063","year":"2025","yearsub":"2025"}
{"abstract":"Understanding software systems is a vital task, often undertaken by teams of engineers, for the development and maintenance of systems. Collaborative software visualization tools are essential in this context, yet they are limited. Existing tools, particularly in virtual reality, allow exploration but lack the crucial feature of note-taking, which is a significant limitation. We introduce Immersive Software Archaeology (ISA), a virtual reality tool that enables engineering teams to collaboratively explore and comprehend software systems. Unique to ISA, it facilitates note-taking during exploration with virtual multimedia whiteboards that support freehand diagramming, audio recordings, and VR screenshots. Notes taken on these whiteboards are synchronized with an Integrated Development Environment (IDE), providing easy access to the results of a VR exploration while performing changes to the system’s source code.","author_count":4,"contributors":["Hoff, Adrian","Lungu, Mircea","Seidl, Christoph","Lanza, Michele"],"cuid":["S01-000.00-730169"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["Switzerland"],"glorg":["All Global Affiliations","Università della Svizzera italiana"],"keyword":["Collaborative Software Engineering","Software Comprehension","Software Visualization","Virtual reality"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"immersive software archaeology collaborative exploration and note taking in virtual reality","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/103694536/2024-icpc_-_isa_-_collaborative_exploration_note_taking_virtual_reality_tool_-_preprint.pdf","version":"Pre-print"},"id":"S01-000.00-730169","identifier":[{"id":"85197284794","type":"scopus"}],"ids":["itu-550e656b-4243-4bc9-8967-a34285c02d1a"],"keyword":["Collaborative Software Engineering","Software Comprehension","Software Visualization","Virtual Reality"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-0B3914CFD61760353E21C4B4BA297FF1"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/103694536/2024-icpc_-_isa_-_collaborative_exploration_note_taking_virtual_reality_tool_-_preprint.pdf","version":"Pre-print"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Quality Research"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"ch","key":"università della svizzera italiana","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"Università della Svizzera italiana","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Adrian","key":"hoffpau","last":"Hoff","locid":"6a57a243-af32-4e1d-849c-75146da60102","name":"Hoff, Adrian","orcid":"0000-0002-5254-6246","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mircea","key":"lungupau","last":"Lungu","locid":"02960d47-7677-4b2c-99d4-490a31fd6885","name":"Lungu, Mircea","orcid":"0000-0003-3944-5261","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christoph","key":"seidlpau","last":"Seidl","locid":"fda8c630-1b0a-4910-ae2a-602850616275","name":"Seidl, Christoph","orcid":"0000-0003-4539-8297","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Michele","key":"lanzapau","last":"Lanza","name":"Lanza, Michele","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1145/3643916.3644438","pages":"387-391","status":"p","title":"32nd IEEE/ACM International Conference on Program Comprehension (ICPC ’24)"},"review":"Peer Reviewed","scoID":["2-s2.0-85197284794"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-550e656b-4243-4bc9-8967-a34285c02d1a"],"src":["ITU IT University of Copenhagen"],"title":"Immersive Software Archaeology: Collaborative Exploration and Note Taking in Virtual Reality","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-730169","year":"2024","yearsub":"2024"}
{"abstract":"This research-to-practice paper shows how to visualize the conceptual framework of object-oriented programming. 'Classes' and 'objects' (from the solution domain) are respectively visualized as 'phenomena' and 'concepts' (from the problem domain), thereby visualizing the connection between code and reality. In the spirit of bringing research-to-practice, we implemented a prototype programming environment for Java called 'SHowMyCODE' based on this conceptual visualization. We report on a controlled experiment involving N=138 introductory programming (CS1) students. The experiment involves three tasks with progression (USE, Modify, and Create) and compares a treatment group with the reality-code visualization vs a control group without the visualization. The results show that, for Use tasks, students are faster (but not more accurate) when using the reality-code visualisation. In contrast, for Create tasks, learners are more accurate (but not faster) when using the reality visualisation. Finally, we report that students appear to value a visualization that shows the reality-code connection above a generic visualization without this connection.","author_count":6,"contributors":["Staugaard, Jakob","Bennedsen, Jens","Seidl, Christoph","Nicolajsen, Sebastian","Fink, Mathias","Brabrand, Claus"],"cuid":["S01-000.00-806917"],"event":{"end":"2024-10-16","place":"Washington, us","start":"2024-10-13","title":"54th IEEE Frontiers in Education Conference, FIE 2024","year":"2024"},"filters":{"added":"2025-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Brabrand, Claus","Fink, Mathias","Nicolajsen, Sebastian","Seidl, Christoph","Staugaard, Jakob"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-ITU"]},"level3all":["DI-U-AU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"visualizing the conceptual framework of object orientation for novice programmers","src":["au"],"src-code":["DI-U-AU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/105000619540","version":"Other Version"},"id":"S01-000.00-806917","identifier":[{"id":"105000619540","type":"scopus"}],"ids":["au-880b75f1-f78f-4d90-9010-9361ef27e49f"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-F6FD2B2C71079CE7A9604864FDF6D164"],"org":[{"affno":"1","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Electrical and Computer Engineering, Department of Electrical and Computer Engineering - Software Engineering & Computing systems - Edison"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jakob","key":"staugaardpau","last":"Staugaard","name":"Staugaard, Jakob","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jens","key":"bennedsenpau","last":"Bennedsen","locid":"acc52e24-257f-4176-aed2-1e9110da5dc9","name":"Bennedsen, Jens","orcid":"0000-0003-3014-7567","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christoph","key":"seidlpau","last":"Seidl","name":"Seidl, Christoph","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sebastian","key":"nicolajsenpau","last":"Nicolajsen","name":"Nicolajsen, Sebastian","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mathias","key":"finkpau","last":"Fink","name":"Fink, Mathias","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Claus","key":"brabrandpau","last":"Brabrand","name":"Brabrand, Claus","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1109/fie61694.2024.10893141","eisbn":["9798350351507"],"publisher":"IEEE","status":"p","title":"2024 IEEE Frontiers in Education Conference, FIE 2024 - Proceedings"},"review":"Peer Reviewed","scoID":["2-s2.0-105000619540"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["au-880b75f1-f78f-4d90-9010-9361ef27e49f"],"src":["AU Aarhus University"],"title":"Visualizing the Conceptual Framework of Object Orientation for Novice Programmers","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-806917","year":"2024","yearsub":"2024"}
{"abstract":"Comprehending large-scale software systems is a challenging and daunting task, particularly when only source code is available. While software visualization attempts to aid that process, existing tools primarily visualize a system’s structure in terms of files, folders, packages, or namespaces, neglecting its logical decomposition into cohesive architectural components. We present the tool Immersive Software Archaeology (ISA) which (i) estimates a view of a system’s architecture by utilizing concepts from software architecture recovery and (ii) visualizes the results in virtual reality (VR) so that users can explore a subject system interactively, making the process more engaging. In VR, a semantic zoom lets users gradually transition between architectural components of different granularity and class-level elements while relationship graphs let users navigate along connections across classes and architectural components. We present results from a controlled experiment with 54 participants to investigate the usefulness of ISA for assisting engineers with exploring an unfamiliar large-scale system compared to another state-of-the-art VR approach and an IDE.","author_count":3,"contributors":["Hoff, Adrian","Seidl, Christoph","Lanza, Michele"],"cuid":["S01-000.00-730167"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["Switzerland"],"glorg":["All Global Affiliations","Università della Svizzera italiana"],"keyword":["Software Architecture Visualization","Software Comprehension","Software Re Engineering","Software Visualization"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"immersive software archaeology exploring software architecture and design in virtual reality","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/103694385/2024-saner_-_isa_-_exploring_software_architecture_design_virtual_reality_-_tool.pdf","version":"Pre-print"},"funding_acknowledgement":["Hoff and Seidl are supported by the DFF (Independent Research Fund Denmark) within the project “Immersive Software Archaeology (ISA)” (0136-00070B). Lanza is supported by the Swiss National Science Foundation (SNSF) through the project “INSTINCT” (Project No. 190113)."],"id":"S01-000.00-730167","ids":["itu-4c8ae1c0-c775-4fe2-94cb-750ab52f8fa3"],"keyword":["Software Architecture Visualization","Software Comprehension","Software Re-Engineering","Software Visualization"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-9255558EAF1B1311C597B0D113A7C58D"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/103694385/2024-saner_-_isa_-_exploring_software_architecture_design_virtual_reality_-_tool.pdf","version":"Pre-print"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Quality Research"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"ch","key":"università della svizzera italiana","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"Università della Svizzera italiana","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Adrian","key":"hoffpau","last":"Hoff","locid":"6a57a243-af32-4e1d-849c-75146da60102","name":"Hoff, Adrian","orcid":"0000-0002-5254-6246","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christoph","key":"seidlpau","last":"Seidl","locid":"fda8c630-1b0a-4910-ae2a-602850616275","name":"Seidl, Christoph","orcid":"0000-0003-4539-8297","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Michele","key":"lanzapau","last":"Lanza","name":"Lanza, Michele","rank":3,"rolecode":"pau"}],"pub":{"publisher":"IEEE","status":"p","title":"International Conference on Software Analysis, Evolution and Reengineering (SANER) 2024"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-4c8ae1c0-c775-4fe2-94cb-750ab52f8fa3"],"src":["ITU IT University of Copenhagen"],"title":"Immersive Software Archaeology: Exploring Software Architecture and Design in Virtual Reality","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-730167","year":"2024","yearsub":"2024"}
{"abstract":"Exploring and comprehending a software system, e.g., as preparation for its re-engineering, is a relevant, yet challenging endeavour often conducted by teams of engineers. Collaborative exploration tools aim to ease the process, e.g., via interactive visualizations in virtual reality (VR). However, these neglect to provide engineers with capabilities for persisting their thoughts and findings. We present an interactive VR visualization method that enables (distributed) teams of engineers to collaboratively (1) explore a subject system, while (2) persisting insights via free-hand diagrams, audio recordings, and in-visualization VR screenshots. We invited pairs of software engineering practitioners to use our method to collaboratively explore a software system. We observed how they used our method and collected their feedback and impressions before replaying their findings to the original developers of the subject system for assessment.","author_count":4,"contributors":["Hoff, Adrian","Lungu, Mircea","Seidl, Christoph","Lanza, Michele"],"cuid":["S01-000.00-730177"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["Switzerland"],"glorg":["All Global Affiliations","Università della Svizzera italiana"],"keyword":["Collaborative Software Engineering","Software Comprehension","Software Visualization","Virtual reality"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"collaborative software exploration with multimedia note taking in virtual reality","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/103694435/2024-icpc_-_collaborative_exploration_multimedia_note_taking_virtual_reality_-_preprint.pdf","version":"Pre-print"},"funding_acknowledgement":["Hoff and Seidl are supported by the DFF (Independent Research Fund Denmark) project “Immersive Software Archaeology (ISA)” (0136-00070B). Lanza is supported by the Swiss National Science Foundation (SNSF) project “INSTINCT” (Project No. 190113)."],"id":"S01-000.00-730177","identifier":[{"id":"85197281862","type":"scopus"}],"ids":["itu-811cf3d3-78b1-4b95-9d62-bb9fe1d09121"],"keyword":["Collaborative Software Engineering","Software Comprehension","Software Visualization","Virtual Reality"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-B904066585D7F2F5A83D64FEB350BA66"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/103694435/2024-icpc_-_collaborative_exploration_multimedia_note_taking_virtual_reality_-_preprint.pdf","version":"Pre-print"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Quality Research"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"ch","key":"università della svizzera italiana","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"Università della Svizzera italiana","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Adrian","key":"hoffpau","last":"Hoff","locid":"6a57a243-af32-4e1d-849c-75146da60102","name":"Hoff, Adrian","orcid":"0000-0002-5254-6246","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mircea","key":"lungupau","last":"Lungu","locid":"02960d47-7677-4b2c-99d4-490a31fd6885","name":"Lungu, Mircea","orcid":"0000-0003-3944-5261","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christoph","key":"seidlpau","last":"Seidl","locid":"fda8c630-1b0a-4910-ae2a-602850616275","name":"Seidl, Christoph","orcid":"0000-0003-4539-8297","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Michele","key":"lanzapau","last":"Lanza","name":"Lanza, Michele","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1145/3643916.3644427","pages":"346-357","status":"p","title":"32nd IEEE/ACM International Conference on Program Comprehension (ICPC ’24)"},"review":"Peer Reviewed","scoID":["2-s2.0-85197281862"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-811cf3d3-78b1-4b95-9d62-bb9fe1d09121"],"src":["ITU IT University of Copenhagen"],"title":"Collaborative Software Exploration with Multimedia Note Taking in Virtual Reality","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-730177","year":"2024","yearsub":"2024"}
{"abstract":"Software visualization facilitates the interactive exploration of large-scale code bases, e.g., to rediscover the architecture of a legacy system. Visualizations of software structure suffer from repetitive patterns that complicate distinguishing different subsystems and recognizing previously visited parts of an architecture. We leverage variability-modeling techniques to \"uniquify\" visualizations of subsystems via custom-tailored 3D models of recognizable landmarks: For each subsystem, we derive a descriptor and translate it to a (random but deterministic) configuration of a feature model of variable 3D geometry to support large numbers of different 3D models while capturing the design language of a particular type of landmark. We devised a hybrid variant derivation mechanism using a slots-and-hooks composition system for 3D geometry as well as adjusting visual characteristics, e.g., material. We demonstrate our method by creating various different trophies as landmarks for the visualization of a software system.","author_count":3,"contributors":["Hoff, Adrian","Seidl, Christoph","Lanza, Michele"],"cuid":["S01-000.00-382366"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["Switzerland"],"glorg":["All Global Affiliations","Università della Svizzera italiana"],"keyword":["3D Model Generation","Software Visualization","Variability Modeling"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"uniquifying architecture visualization through variable 000000000003d model generation","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/93895042/authors_version.pdf","version":"Pre-print"},"id":"S01-000.00-382366","identifier":[{"id":"85147425594","type":"scopus"}],"ids":["itu-49a2cfa5-d105-4ad3-95a1-eae83947fd09"],"keyword":["3D Model Generation","Software Visualization","Variability Modeling"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-9EEBF7DD62A06C138C5794C7B1FA19D3"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/93895042/authors_version.pdf","version":"Pre-print"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Quality Research"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"ch","key":"università della svizzera italiana","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"Università della Svizzera italiana","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Adrian","key":"hoffpau","last":"Hoff","locid":"6a57a243-af32-4e1d-849c-75146da60102","name":"Hoff, Adrian","orcid":"0000-0002-5254-6246","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christoph","key":"seidlpau","last":"Seidl","locid":"fda8c630-1b0a-4910-ae2a-602850616275","name":"Seidl, Christoph","orcid":"0000-0003-4539-8297","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Michele","key":"lanzapau","last":"Lanza","name":"Lanza, Michele","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1145/3571788.3571798","isbn":["9798400700019/23/01"],"pages":"77-81","place":"Odense, Denmark","publisher":"Association for Computing Machinery","status":"p","subtitle":"VaMoS 2023","title":"17th International Working Conference on Variability Modelling of Software-Intensive Systems"},"review":"Peer Reviewed","scoID":["2-s2.0-85147425594"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-49a2cfa5-d105-4ad3-95a1-eae83947fd09"],"src":["ITU IT University of Copenhagen"],"title":"Uniquifying Architecture Visualization through Variable 3D Model Generation","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382366","year":"2023","yearsub":"2023"}
{"abstract":"Re-architecting a software system requires significant preparation, e.g., to scope and design new modules with their boundaries and constituent classes. When planning an intended future state of a system as a re-engineering goal, engineers often fall recur to mechanisms such as freehand sketching (using a whiteboard). While this ensures flexibility and expressiveness, the sketches remain disconnected from the source code. The alternative, tool-supported diagramming on the other hand considerably restricts flexibility and impedes free-form communication. We present a method for preparing the architectural software re-engineering via freehand sketches in virtual reality (VR) that can be seamlessly integrated with the model structure of a software visualization and, thus, also the code of a system, for productive use: Engineers explore a subject system in the immersive visualization, while freehand sketching their insights and plans. Our concept automatically interprets sketched shapes and connects them to the system’s source code, and superimposes code-level references into a sketch to support engineers in reflecting on their sketches. We evaluated our method in an iterative interview-based case study with software developers from four different companies, where they planned a hypothetical re-engineering of an opensource software system. Video Demonstration — https://youtu.be/NKC5YpH3n4Y","author_count":4,"contributors":["Hoff, Adrian","Seidl, Christoph","Lungu, Mircea","Lanza, Michele"],"cuid":["S01-000.00-712540"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["Switzerland"],"glorg":["All Global Affiliations","Università della Svizzera italiana"],"keyword":["Reflexion Models","Software Re Engineering","Software Visualization","Virtual reality","Whiteboard Sketching"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"preparing software re engineering via freehand sketches in virtual reality","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/102214462/model-based-vr-whiteboard-preprint.pdf","version":"Pre-print"},"funding_acknowledgement":["Hoff and Seidl are supported by the DFF (Independent Research Fund Denmark) within the project “Immersive Software Archaeology (ISA)” (0136-00070B). Lanza is supported by the Swiss National Science Foundation (SNSF) through the project “INSTINCT” (Project No. 190113)."],"id":"S01-000.00-712540","identifier":[{"id":"85181533358","type":"scopus"}],"ids":["itu-95253343-495f-41fe-baea-2c1c0140bde5"],"keyword":["Reflexion Models","Software Re-Engineering","Software Visualization","Virtual Reality","Whiteboard Sketching"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-69AE229AE5CB8FFD87D92A40B473844C"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/102214462/model-based-vr-whiteboard-preprint.pdf","version":"Pre-print"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Quality Research"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"ch","key":"università della svizzera italiana","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"Università della Svizzera italiana","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Adrian","key":"hoffpau","last":"Hoff","locid":"6a57a243-af32-4e1d-849c-75146da60102","name":"Hoff, Adrian","orcid":"0000-0002-5254-6246","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christoph","key":"seidlpau","last":"Seidl","locid":"fda8c630-1b0a-4910-ae2a-602850616275","name":"Seidl, Christoph","orcid":"0000-0003-4539-8297","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mircea","key":"lungupau","last":"Lungu","locid":"02960d47-7677-4b2c-99d4-490a31fd6885","name":"Lungu, Mircea","orcid":"0000-0003-3944-5261","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Michele","key":"lanzapau","last":"Lanza","name":"Lanza, Michele","rank":4,"rolecode":"pau"}],"pub":{"publisher":"IEEE","status":"p","subtitle":"ICSME 2023","title":"39th IEEE International Conference on Software Maintenance and Evolution"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-95253343-495f-41fe-baea-2c1c0140bde5"],"src":["ITU IT University of Copenhagen"],"title":"Preparing Software Re-Engineering via Freehand Sketches in Virtual Reality","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-712540","year":"2023","yearsub":"2023"}
{"abstract":"A Software Product Line (SPL) captures families of closely related software variants. The configuration options of an SPL are represented by features. Typically, SPLs are developed in a featurecentric manner and, thus, require different development methods and technologies from developing software products individually. For developers of single systems, this means a shift in paradigm and technology. Especially with invasive variability realization mechanisms, such as Delta-Oriented Programming (DOP), centering development around configurable features realized via source code transformation is commonly expected to pose an obstacle, but concrete experience reports are lacking. In this paper, we investigate how DOP and cutting-edge SPL development tools are picked up by non-expert developers. To this end, we report on our experiences from a student capstone SPL development project. Our results show that participants find easy access to SPL development concepts and tools. Based on our observations and the participants’ practices, we define guidelines for developers using DOP.","author_count":4,"contributors":["Nieke, Michael","Hoff, Adrian","Schaefer, Ina","Seidl, Christoph"],"cuid":["S01-000.00-382971"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","Technical University of Braunschweig"],"keyword":["Delta Oriented Programming","Feature centric Development","SPL Development Tools","Software Product Line","Variability Realization"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"experiences with constructing and evolving a software product line with delta oriented programming","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86606380/DeltaJava_Teamprojekt_Paper.pdf","version":"Authors Final Version"},"id":"S01-000.00-382971","identifier":[{"id":"85125393217","type":"scopus"}],"ids":["itu-732bf641-f72c-4d44-a68d-45d949d8b948"],"keyword":["Delta-Oriented Programming","Feature-centric Development","SPL Development Tools","Software Product Line","Variability Realization"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-0263CB16778222B8BB68C39D87421584"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86606380/DeltaJava_Teamprojekt_Paper.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"de","key":"technical university of braunschweig","loc":["Germany","Europe, EU","OECD"],"name":"Technical University of Braunschweig","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Michael","key":"niekepau","last":"Nieke","name":"Nieke, Michael","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Adrian","key":"hoffpau","last":"Hoff","locid":"6a57a243-af32-4e1d-849c-75146da60102","name":"Hoff, Adrian","orcid":"0000-0002-5254-6246","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ina","key":"schaeferpau","last":"Schaefer","name":"Schaefer, Ina","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christoph","key":"seidlpau","last":"Seidl","locid":"fda8c630-1b0a-4910-ae2a-602850616275","name":"Seidl, Christoph","orcid":"0000-0003-4539-8297","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1145/3510466.3511271","publisher":"Association for Computing Machinery","series":"International Working Conference on Variability Modelling of Software-Intensive Systems","status":"p","title":"Proceedings of the 16th International Working Conference on Variability Modelling of Software-Intensive Systems (VAMOS ’22)"},"review":"Peer Reviewed","scoID":["2-s2.0-85125393217"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-732bf641-f72c-4d44-a68d-45d949d8b948"],"src":["ITU IT University of Copenhagen"],"title":"Experiences with Constructing and Evolving a Software Product Line with Delta-Oriented Programming","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382971","year":"2022","yearsub":"2022"}
{"abstract":"A product line is an approach for systematically managing configuration options of customizable systems, usually by means of features. Products are generated for configurations consisting of selected features. Product-line evolution can lead to unintended changes to product behavior. We illustrate that updating configurations after product-line evolution requires decisions of both, domain engineers responsible for product-line evolution as well as application engineers responsible for configurations. The challenge is that domain and application engineers might not be able to interact with each other. We propose a formal foundation and a methodology that enables domain engineers to guide application engineers through configuration evolution by sharing knowledge on product-line evolution and by defining automatic update operations for configurations. As an effect, we enable knowledge transfer between those engineers without the need for interactions. We evaluate our methodology on four large-scale industrial product lines. The results of the qualitative evaluation indicate that our method is flexible enough for real-world product-line evolution. The quantitative evaluation indicates that we detect product behavior changes for up to 55.3% of the configurations which would not have been detected using existing methods.","author_count":6,"contributors":["Nieke, Michael","Sampaio, Gabriela","Thüm, Thomas","Seidl, Christoph","Teixeira, Leopoldo","Schaefer, Ina"],"cuid":["S01-000.00-383230"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, South","Europe, EU","Europe, Non-EU","OECD"],"country":["Brazil","Germany","United Kingdom"],"glorg":["All Global Affiliations","Federal University of Pernambuco","Imperial College London","Ulm University"],"keyword":["Guided feature configuration evolution","Product behavior preservation","Product line","Product line evolution"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"guiding the evolution of product line conﬁgurations","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://www.researchgate.net/publication/352982056_Guiding_the_evolution_of_product-line_configurations","version":"Published Version"},"id":"S01-000.00-383230","identifier":[{"id":"85109312091","type":"scopus"}],"ids":["itu-8557783a-3b9a-4a8d-a962-9c17c6965eab"],"keyword":["Guided feature configuration evolution","Product behavior preservation","Product line","Product-line evolution"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-101E1A0E199A9744DF2A28BF9D1220BA"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.researchgate.net/publication/352982056_Guiding_the_evolution_of_product-line_configurations","version":"Published Version"}],"org":[{"affno":"1","country":"gb","key":"imperial college london","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Imperial College London","used":1},{"affno":"2","country":"de","key":"ulm university","loc":["Germany","Europe, EU","OECD"],"name":"Ulm University","used":1},{"affno":"3","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Quality Research"],"nora_code":"DI-U-ITU","used":1},{"affno":"4","country":"br","key":"federal university of pernambuco","loc":["Brazil","America, South"],"name":"Federal University of Pernambuco","used":1}],"person":[{"affno":"","corresponding":null,"first":"Michael","key":"niekepau","last":"Nieke","name":"Nieke, Michael","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Gabriela","key":"sampaiopau","last":"Sampaio","name":"Sampaio, Gabriela","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Thomas","key":"thümpau","last":"Thüm","name":"Thüm, Thomas","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Christoph","key":"seidlpau","last":"Seidl","locid":"fda8c630-1b0a-4910-ae2a-602850616275","name":"Seidl, Christoph","orcid":"0000-0003-4539-8297","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Leopoldo","key":"teixeirapau","last":"Teixeira","name":"Teixeira, Leopoldo","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Ina","key":"schaeferpau","last":"Schaefer","name":"Schaefer, Ina","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1007/s10270-021-00906-w","issn":["16191374"],"journal":"Software & Systems Modeling","pages":"225-247","publisher":"Springer","status":"p","title":"Software & Systems Modeling","title_org":"Software & Systems Modeling (SoSyM)","volume":"21"},"review":"Peer Reviewed","scoID":["2-s2.0-85109312091"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-8557783a-3b9a-4a8d-a962-9c17c6965eab"],"src":["ITU IT University of Copenhagen"],"title":"Guiding the Evolution of Product-Line Conﬁgurations","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383230","year":"2022","yearsub":"2022"}
{"abstract":"In model-based systems engineering projects, engineers from multiple domains collaborate by establishing a common system model. Multi-level modeling is a technique that can be used to model the development from abstract ideas to concrete implementations. However, current multi-level modeling approaches are not adequate for processes with multiple modeling phases that might have to be rearranged later. In this paper, we introduce multi-phase modeling that utilizes concepts of multi-level modeling by considering a description of the expected phase ordering per domain. Constraints aware of this context can express that certain elements are only valid in specific phases without having to determine a concrete phase ordering for a particular model. This enables using multi-phase modeling in flexible workflows, adapting to changing requirements and the definition of access rules in domain notation. We show feasibility of this multi-phase modeling by applying it to multiple real-life systems engineering projects of the aerospace domain.","author_count":4,"contributors":["Franz, Tobias","Seidl, Christoph","Fischer, Philipp","Gerndt, Andreas"],"cuid":["S01-000.00-384540"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","German Aerospace Center"],"keyword":["Domain specific languages","Model based systems engineering","Multilevel modeling","Systems engineering"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"utilizing multi level concepts for multi phase modeling","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s10270-021-00963-1","version":"Published Version"},"id":"S01-000.00-384540","identifier":[{"id":"85123505642","type":"scopus"}],"ids":["itu-de781a51-6903-48a7-bf43-816adb4c8147"],"keyword":["Domain-Specific Languages","Model-based Systems Engineering","Multilevel Modeling","Systems Engineering"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-D7C38E5E08D69DF03BC71B53E7C60A10"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s10270-021-00963-1","version":"Published Version"},{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/90442898/_J9_Preprint_SoSyM_22_Utilizing_Multi_Level_Concepts_for_Multi_Phase_Modeling_T._Franz_C._Seidl_P._Fischer_A._Gerndt_2022_.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","country":"de","key":"german aerospace center","loc":["Germany","Europe, EU","OECD"],"name":"German Aerospace Center","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Quality Research"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Tobias","key":"franzpau","last":"Franz","name":"Franz, Tobias","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Christoph","key":"seidlpau","last":"Seidl","locid":"fda8c630-1b0a-4910-ae2a-602850616275","name":"Seidl, Christoph","orcid":"0000-0003-4539-8297","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Philipp","key":"fischerpau","last":"Fischer","name":"Fischer, Philipp","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andreas","key":"gerndtpau","last":"Gerndt","name":"Gerndt, Andreas","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1007/s10270-021-00963-1","issn":["16191374"],"journal":"Software & Systems Modeling","publisher":"Springer","status":"p","title":"Software & Systems Modeling","title_org":"Software & Systems Modeling (SoSyM)"},"review":"Peer Reviewed","scoID":["2-s2.0-85123505642"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-de781a51-6903-48a7-bf43-816adb4c8147"],"src":["ITU IT University of Copenhagen"],"title":"Utilizing Multi-Level Concepts for Multi-Phase Modeling","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384540","year":"2022","yearsub":"2022"}
{"abstract":"Domain-specific languages (DSLs) have demonstrated their usefulness within many domains such as finance, robotics, and telecommunication. This success has been exemplified by the publication of a wide range of articles regarding specific DSLs and their merits in terms of improved software quality, programmer efficiency, security, etc. However, there is little public information on what happens to these DSLs after they are developed and published. The lack of information makes it difficult for a DSL practitioner or tool creator to identify trends, current practices, and issues within the field. In this paper, we seek to establish the current state of a DSL’s life cycle by analysing 30 questionnaire answers from DSL authors on the design and development, launch, evolution, and end of life of their DSL. On this empirical foundation, we make six recommendations to DSL practitioners, scholars, and tool creators on the subjects of user involvement in the design process, DSL evolution, and the end of life of DSLs.","author_count":2,"contributors":["Borum, Holger Stadel","Seidl, Christoph"],"cuid":["S01-000.00-384736"],"event":{"acronym":"MoDELS","title":"ACM/IEEE International Conference on Model Driven Engineering Languages and Systems"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["DSL life cycle","Domain specific languages","Empirical study","Programmer efficiency","Software quality"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"survey of established practices in the life cycle of domain specific languages","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1145/3550355.3552413","version":"Published Version"},"id":"S01-000.00-384736","identifier":[{"id":"85141833901","type":"scopus"}],"ids":["itu-eb65421d-ef5d-4915-9245-507875b6a185"],"keyword":["DSL life cycle","Domain-specific languages","Empirical study","Programmer efficiency","Software quality"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-61626E4EEA640EB5642047BEE92C70AD"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1145/3550355.3552413","version":"Published Version"},{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://pure.itu.dk/ws/files/90366487/main.pdf","version":"Pre-print"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Holger Stadel","key":"borumpau","last":"Borum","name":"Borum, Holger Stadel","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christoph","key":"seidlpau","last":"Seidl","locid":"fda8c630-1b0a-4910-ae2a-602850616275","name":"Seidl, Christoph","orcid":"0000-0003-4539-8297","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1145/3550355.3552413","status":"p","title":"MODELS '22: Proceedings of the 25th International Conference on Model Driven Engineering Languages and Systems"},"review":"Peer Reviewed","scoID":["2-s2.0-85141833901"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-eb65421d-ef5d-4915-9245-507875b6a185"],"src":["ITU IT University of Copenhagen"],"title":"Survey of Established Practices in the Life Cycle of Domain-Specific Languages","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384736","year":"2022","yearsub":"2022"}
{"abstract":"Exploring an unfamiliar large-scale software system is challenging especially when based solely on source code. While software visualizations help in gaining an overview of a system, they generally neglect architecture knowledge in their representations, e.g., by arranging elements along package structures rather than functional components or locking users in a specific abstraction level only slightly above the source code. In this paper, we introduce an automated approach for software architecture recovery and use its results in an immersive 3D virtual reality software visualization to aid accessing and relating architecture knowledge. We further provide a semantic zoom that allows a user to access and relate information both horizontally on the same abstraction level, e.g., by following method calls, and vertically across different abstraction levels, e.g., from a member to its parent class. We evaluate our contribution in a controlled experiment contrasting the usefulness regarding software exploration and comprehension of our concepts with those of the established CityVR visualization and the Eclipse IDE.","author_count":3,"contributors":["Hoff, Adrian","Gerling, Lea","Seidl, Christoph"],"cuid":["S01-000.00-384800"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","University of Hildesheim"],"keyword":["Empirical Software Engineering","Software Architecture Recovery","Software Visualization","Virtual reality"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"utilizing software architecture recovery to explore large scale software systems in virtual reality","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/92854114/preprint_vissoft22.pdf","version":"Pre-print"},"id":"S01-000.00-384800","identifier":[{"id":"85146234736","type":"scopus"}],"ids":["itu-efee71b3-0de1-43c3-b84a-9dfedcf5b762"],"keyword":["Empirical Software Engineering","Software Architecture Recovery","Software Visualization","Virtual Reality"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-6586DD82B9C2FE82345274881CD5D0C2"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/92854114/preprint_vissoft22.pdf","version":"Pre-print"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Quality Research"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"de","key":"university of hildesheim","loc":["Germany","Europe, EU","OECD"],"name":"University of Hildesheim","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Adrian","key":"hoffpau","last":"Hoff","locid":"6a57a243-af32-4e1d-849c-75146da60102","name":"Hoff, Adrian","orcid":"0000-0002-5254-6246","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lea","key":"gerlingpau","last":"Gerling","name":"Gerling, Lea","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christoph","key":"seidlpau","last":"Seidl","locid":"fda8c630-1b0a-4910-ae2a-602850616275","name":"Seidl, Christoph","orcid":"0000-0003-4539-8297","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1109/vissoft55257.2022.00020","eisbn":["9781665480925"],"isbn":["9781665480932"],"publisher":"IEEE","status":"p","title":"2022 Working Conference on Software Visualization (VISSOFT)"},"review":"Peer Reviewed","scoID":["2-s2.0-85146234736"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-efee71b3-0de1-43c3-b84a-9dfedcf5b762"],"src":["ITU IT University of Copenhagen"],"title":"Utilizing Software Architecture Recovery to Explore Large-Scale Software Systems in Virtual Reality","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384800","year":"2022","yearsub":"2022"}
