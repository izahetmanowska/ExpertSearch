Sofia","key":"ananievapau","last":"Ananieva","name":"Ananieva, Sofia","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Sandra","key":"greinerpau","last":"Greiner","name":"Greiner, Sandra","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Thomas","key":"kühnpau","last":"Kühn","name":"Kühn, Thomas","rank":3,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"first":"Jacob","key":"krügerpau","last":"Krüger","name":"Krüger, Jacob","rank":4,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Lukas","key":"linsbauerpau","last":"Linsbauer","name":"Linsbauer, Lukas","rank":5,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Sten","key":"grünerpau","last":"Grüner","name":"Grüner, Sten","rank":6,"rolecode":"pau"},{"affno":"8","corresponding":null,"first":"Timo","key":"kehrerpau","last":"Kehrer","name":"Kehrer, Timo","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Heiko","key":"klarepau","last":"Klare","name":"Klare, Heiko","rank":8,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Anne","key":"koziolekpau","last":"Koziolek","name":"Koziolek, Anne","rank":9,"rolecode":"pau"},{"affno":"9","corresponding":null,"first":"Henrik","key":"lönnpau","last":"Lönn","name":"Lönn, Henrik","rank":10,"rolecode":"pau"},{"affno":"5 10","corresponding":null,"first":"Sebastian","key":"krieterpau","last":"Krieter","name":"Krieter, Sebastian","rank":11,"rolecode":"pau"},{"affno":"11","corresponding":null,"first":"Christoph","key":"seidlpau","last":"Seidl","locid":"fda8c630-1b0a-4910-ae2a-602850616275","name":"Seidl, Christoph","orcid":"0000-0003-4539-8297","rank":12,"rolecode":"pau"},{"affno":"12","corresponding":null,"first":"S.","key":"rameshpau","last":"Ramesh","name":"Ramesh, S.","rank":13,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Ralf","key":"reussnerpau","last":"Reussner","name":"Reussner, Ralf","rank":14,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Bernhard","k