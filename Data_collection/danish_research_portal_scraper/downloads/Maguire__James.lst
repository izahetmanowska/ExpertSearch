vel":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"a jwst near and mid infrared nebular spectrum of the type ia supernova 000000002021aefx","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3847/2041-8213/acb4ec","version":"Published Version"},"funding_acknowledgement":["L.G. acknowledges financial support from the Spanish Ministerio de Ciencia e Innovación (MCIN), the Agencia Estatal de Investigación (AEI) 10.13039/501100011033, and the European Social Fund (ESF) “Investing in your future” under the 2019 Ramón y Cajal program RYC2019-027683-I and the PID2020-115253GA-I00 HOSTFLOWS project, from Centro Superior de Investigaciones Científicas (CSIC) under the PIE project 20215AT016, and the program Unidad de Excelencia María de Maeztu CEX2020-001058-M. T.S. is supported by the NKFIH/OTKA FK-134432 grant of the National Research, Development and Innovation (NRDI) Office of Hungary, the János Bolyai Research Scholarship of the Hungarian Academy of Sciences, and the New National Excellence Program (ÚNKP-22-5) of the Ministry for Innovation and Technology of Hungary from the source of NRDI Fund. J.P.H. acknowledges support from the George A. and Margaret M. Downsbrough bequest. L.A.K. acknowledges support by NASA FINESST fellowship 80NSSC22K1599. C.L. acknowledges support from the National Science Foundation Graduate Research Fellowship under grant No. DGE-2233066. The Aarhus supernova group is funded in part by an Experiment grant (No. 28021) from the Villum FONDEN, and by a project (1) grant (No. 8021-00170B) from the Independent Research Fund Denmark (IRFD). This work is based on observations made with the NASA/ESA/CSA JWST. The data were obtained from the Mikulski Archive for Space Telescopes at the Space Telescope Science Institute, which is operated by the Association of Universities for Research in Astronomy, Inc., under NASA contract NAS 5-03127 for JWST. These observations are associated with JWST program No. 02072. Support for this program at Rutgers University was provided by NASA through grant JWST-GO-02072.001. Time-domain research by the University of Arizona team and D.J.S. is supported by NSF grants AST-1821987, 1813466, 1908972, and 2108032, and by the Heising-Simons Foundation under grant No. 2020-1864. K.M. acknowledges support from the Japan Society for the Promotion of Science (JSPS) KAKENHI grants JP18H05223 and JP20H00174. K.M. and M.D. are funded by the EU H2020 ERC grant No. 758638."],"id":"S01-000.00-687401","identifier":[{"id":"85147744972","type":"scopus"}],"ids":["au-0bcff776-45df-402d-99e6-a39b3ec674be"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-6D11A7C1E431F68A0D60EB843332730D"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3847/2041-8213/acb4ec","version":"Published Version"}],"org":[{"affno":"1","country":"us","key":"rutgers the state university of new jersey new brunswick","loc":["United States","America, North","OECD"],"name":"Rutgers - The State University of New Jersey, New Brunswick","used":1},{"affno":"2","country":"us","key":"princeton university","loc":["United States","America, North","OECD"],"name":"Princeton University","used":1},{"affno":"3","country":"us","key":"space telescope science institute","loc":["United States","America, North","OECD"],"name":"Space Telescope Science Institute","used":1},{"affno":"4","country":"us","key":"university of california at santa cruz","loc":["United States","America, North","OECD"],"name":"University of California at Santa Cruz","used":1},{"affno":"5","country":"us","key":"gemini observatory","loc":["United States","America, North","OECD"],"name":"Gemini Observatory","used":1},{"affno":"6","country":"us","key