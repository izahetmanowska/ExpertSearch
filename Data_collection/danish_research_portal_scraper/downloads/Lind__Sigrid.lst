{"abstract":"Growing evidence support an association between venous thromboembolism (VTE) and arterial thrombotic diseases (i.e. myocardial infarction (MI) and ischemic stroke). We aimed to study the association between VTE and future arterial events, and to determine the population attributable risk (PAR%) of arterial events by VTE in a large prospective cohort recruited from the general population.","author_count":11,"contributors":["Lind, Caroline","Flinterman, Linda","Enga, Kristin F","Severinsen, Marianne Tang","Kristensen, Søren Risom","Braekkan, Sigrid K","Mathiesen, Ellisiv B","Njølstad, Inger","Cannegieter, Suzanne C","Overvad, Kim","Hansen, John-Bjarne"],"cuid":["S02-098.86-005815"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-HO-CDR","DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"impact of incident venous thromboembolism on risk of arterial thrombotic diseases","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1161/CIRCULATIONAHA.113.004168","version":"Published Version"},"id":"S02-098.86-005815","identifier":[{"id":"WOS:000331776900010","type":"wos"},{"id":"84896708680","type":"scopus"},{"id":"24270266","type":"pmid"}],"ids":["aau-77e0795e-2dee-431b-96c5-6664b6936643","au-e4747d6e-39ca-470a-97cc-57354544c0c1"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-A41C7FC8C23A3F2A2AC49195BF866E05"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1161/CIRCULATIONAHA.113.004168","version":"Other Version"}],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"a