 Denmark","Universities"],"PST":["Published"]},"sid":["dtu-85c970e4-bd27-4fa5-ad69-a096d3c55632"],"src":["DTU Technical University of Denmark"],"title":"The CGE Tool Box","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-344515","year":"2017","yearsub":"2017"}
{"abstract":"In the work presented here, we designed and developed two easy-to-use Web tools for in silico detection and characterization of whole-genome sequence (WGS) and whole-plasmid sequence data from members of the family Enterobacteriaceae. These tools will facilitate bacterial typing based on draft genomes of multidrug-resistant Enterobacteriaceae species by the rapid detection of known plasmid types. Replicon sequences from 559 fully sequenced plasmids associated with the family Enterobacteriaceae in the NCBI nucleotide database were collected to build a consensus database for integration into a Web tool called PlasmidFinder that can be used for replicon sequence analysis of raw, contig group, or completely assembled and closed plasmid sequencing data. The PlasmidFinder database currently consists of 116 replicon sequences that match with at least at 80% nucleotide identity all replicon sequences identified in the 559 fully sequenced plasmids. For plasmid multilocus sequence typing (pMLST) analysis, a database that is updated weekly was generated from www.pubmlst.org and integrated into a Web tool called pMLST. Both databases were evaluated using draft genomes from a collection of Salmonella enterica serovar Typhimurium isolates. PlasmidFinder identified a total of 103 replicons and between zero and five different plasmid replicons within each of 49 S. Typhimurium draft genomes tested. The pMLST Web tool was able to subtype genomic sequencing data of plasmids, revealing both known plasmid sequence types (STs) and new alleles and ST variants. In conclusion, testing of the two Web tools using both fully assembled plasmid sequences and WGS-generated draft genomes showed them to be able to detect a broad variety of plasmids that are often associated with antimicrobial resistance in clinically relevant bacterial pathogens.","author_count":8,"contributors":["Carattoli, Alessandra","Zankari, Ea","García-Fernández, Aurora","Larsen, Mette Voldby","Lund, Ole","Villa, Laura","Aarestrup, Frank Møller","Hasman, Henrik"],"cuid":["S01-000.00-305731"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Italy"],"glorg":["All Global Affiliations","Istituto Superiore di Sanita"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"in silico detection and typing of plasmids using plasmidfinder and plasmid multilocus sequence typing","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/93522331/Antimicrob._Agents_Chemother._2014_Carattoli_3895_903.pdf","version":"Published Version"},"id":"S01-000.00-305731","identifier":[{"id":"84903160552","type":"scopus"},{"id":"24777092","type":"pmid"},{"id":"PMC4068535","type":"pmcid"}],"ids":["dtu-03d47e0d-d082-4b91-8a67-ffecf2824efe"],"keyword":["Epidemiology and Surveillance"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-16A40C1EED66EF4073457EC94B3AB7AC"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1128/AAC.02412-14","version":"Other Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/93522331/Antimicrob._Agents_Chemother._2014_Carattoli_3895_903.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","country":"it","key":"istituto superiore di sanita","loc":["Italy","Europe, EU","OECD"],"name":"Istituto Superiore di Sanita","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Food Institute","Technical University of Denmark, National Food Institute, Division of Epidemiology and Microbial Genomics"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Alessandra","key":"carattolipau","last":"Carattoli","name":"Carattoli, Alessandra","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Ea","key":"zankaripau","last":"Zankari","locid":"11bde48b-fac1-4faa-a538-50d6ef3144ca","name":"Zankari, Ea","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Aurora","key":"garcíafernándezpau","last":"García-Fernández","name":"García-Fernández, Aurora","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mette Voldby","key":"larsenpau","last":"Larsen","locid":"48f90aec-1c95-444e-a7e5-d7b3ddcf1b7e","name":"Larsen, Mette Voldby","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ole","key":"lundpau","last":"Lund","locid":"d2f5060c-0c9a-4875-820f-91180f3bb685","name":"Lund, Ole","orcid":"0000-0003-1108-0491","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Laura","key":"villapau","last":"Villa","name":"Villa, Laura","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Frank Møller","key":"aarestruppau","last":"Aarestrup","locid":"8a1eb030-2c37-4557-bce1-7bc6d5c75aaa","name":"Aarestrup, Frank Møller","orcid":"0000-0002-7116-2723","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Henrik","key":"hasmanpau","last":"Hasman","locid":"2aeb80b4-d42a-4da2-9212-86b697184f40","name":"Hasman, Henrik","rank":8,"rolecode":"pau"}],"pmid":["24777092"],"pub":{"doi":"10.1128/aac.02412-14","issn":["00664804","10706283"],"issn_org":["00664804"],"issue":"7","journal":"Antimicrobial Agents and Chemotherapy","pages":"3895-3903","publisher":"American Society for Microbiology","status":"p","title":"Antimicrobial Agents and Chemotherapy","volume":"58"},"review":"Peer Reviewed","scoID":["2-s2.0-84903160552"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-03d47e0d-d082-4b91-8a67-ffecf2824efe"],"src":["DTU Technical University of Denmark"],"title":"In Silico Detection and Typing of Plasmids using PlasmidFinder and Plasmid Multilocus Sequence Typing","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-305731","year":"2014","yearsub":"2014"}
{"abstract":"Objectives: Antimicrobial susceptibility testing of bacterial isolates is essential for clinical diagnosis, to detect emerging problems and to guide empirical treatment. Current phenotypic procedures are sometimes associated with mistakes and may require further genetic testing. Whole-genome sequencing (WGS) may soon be within reach even for routine surveillance and clinical diagnostics. The aim of this study was to evaluate WGS as a routine tool for surveillance of antimicrobial resistance compared with current phenotypic procedures. Methods: Antimicrobial susceptibility tests were performed on 200 isolates originating from Danish pigs, covering four bacterial species. Genomic DNA was purified from all isolates and sequenced as paired-end reads on the Illumina platform. The web servers ResFinder and MLST (www.genomicepidemiology.org) were used to identify acquired antimicrobial resistance genes and MLST types (where MLST stands for multilocus sequence typing). ResFinder results were compared with phenotypic antimicrobial susceptibility testing results using EUCAST epidemiological cut-off values and MLST types. Results: A total of 3051 different phenotypic tests were performed; 482 led to the categorizing of isolates as resistant and 2569 as susceptible. Seven cases of disagreement between tested and predicted susceptibility were observed, six of which were related to spectinomycin resistance in Escherichia coli. Correlation between MLST type and resistance profiles was only observed in Salmonella Typhimurium, where isolates belonging to sequence type (ST) 34 were more resistant than ST19 isolates. Conclusions: High concordance (99.74%) between phenotypic and predicted antimicrobial susceptibility was observed. Thus, antimicrobial resistance testing based on WGS is an alternative to conventional phenotypic methods.","author_count":8,"contributors":["Zankari, Ea","Hasman, Henrik","Kaas, Rolf Sommer","Seyfarth, Anne Mette","Agersø, Yvonne","Lund, Ole","Larsen, Mette Voldby","Aarestrup, Frank Møller"],"cuid":["S01-000.00-311023"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Enterococcus","Escherichia coli","Genomic","MLST","Resistance genes","Salmonella"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"genotyping using whole genome sequencing is a realistic alternative to surveillance based on phenotypic antimicrobial susceptibility testing","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1093/jac/dks496","version":"Other Version"},"id":"S01-000.00-311023","identifier":[{"id":"84875265483","type":"scopus"},{"id":"23233485","type":"pmid"}],"ids":["dtu-15613af0-dc8b-403c-8be4-796f688a36eb"],"keyword":["Enterococcus","Escherichia coli","Genomic","MLST","Resistance genes","Salmonella"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-3282228296984C41117621AAE6E8C4A0"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1093/jac/dks496","version":"Other Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Systems Biology, Center for Biological Sequence Analysis","Technical University of Denmark, National Food Institute","Technical University of Denmark, National Food Institute, Division of Epidemiology and Microbial Genomics"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Ea","key":"zankaripau","last":"Zankari","locid":"11bde48b-fac1-4faa-a538-50d6ef3144ca","name":"Zankari, Ea","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik","key":"hasmanpau","last":"Hasman","locid":"2aeb80b4-d42a-4da2-9212-86b697184f40","name":"Hasman, Henrik","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rolf Sommer","key":"kaaspau","last":"Kaas","locid":"71710852-60d1-4b9b-b4a1-2245be65b29e","name":"Kaas, Rolf Sommer","orcid":"0000-0002-5050-8668","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anne Mette","key":"seyfarthpau","last":"Seyfarth","locid":"1e478afd-afd1-4256-abb2-3aed9340635b","name":"Seyfarth, Anne Mette","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Yvonne","key":"agersøpau","last":"Agersø","locid":"727ec55d-b40c-4ff2-b27e-cc347dbeb7ed","name":"Agersø, Yvonne","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ole","key":"lundpau","last":"Lund","locid":"d2f5060c-0c9a-4875-820f-91180f3bb685","name":"Lund, Ole","orcid":"0000-0003-1108-0491","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mette Voldby","key":"larsenpau","last":"Larsen","locid":"48f90aec-1c95-444e-a7e5-d7b3ddcf1b7e","name":"Larsen, Mette Voldby","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Frank Møller","key":"aarestruppau","last":"Aarestrup","locid":"8a1eb030-2c37-4557-bce1-7bc6d5c75aaa","name":"Aarestrup, Frank Møller","orcid":"0000-0002-7116-2723","rank":8,"rolecode":"pau"}],"pmid":["23233485"],"pub":{"doi":"10.1093/jac/dks496","issn":["03057453","14602091"],"issn_org":["03057453"],"issue":"4","journal":"Journal of Antimicrobial Chemotherapy","pages":"771-777","publisher":"Oxford University Press","status":"p","title":"Journal of Antimicrobial Chemotherapy","volume":"68"},"review":"Peer Reviewed","scoID":["2-s2.0-84875265483"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-15613af0-dc8b-403c-8be4-796f688a36eb"],"src":["DTU Technical University of Denmark"],"title":"Genotyping using whole-genome sequencing is a realistic alternative to surveillance based on phenotypic antimicrobial susceptibility testing","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-311023","year":"2013","yearsub":"2012"}
{"abstract":"ObjectivesIdentification of antimicrobial resistance genes is important for understanding the underlying mechanisms and the epidemiology of antimicrobial resistance. As the costs of whole-genome sequencing (WGS) continue to decline, it becomes increasingly available in routine diagnostic laboratories and is anticipated to substitute traditional methods for resistance gene identification. Thus, the current challenge is to extract the relevant information from the large amount of generated data.MethodsWe developed a web-based method, ResFinder that uses BLAST for identification of acquired antimicrobial resistance genes in whole-genome data. As input, the method can use both pre-assembled, complete or partial genomes, and short sequence reads from four different sequencing platforms. The method was evaluated on 1862 GenBank files containing 1411 different resistance genes, as well as on 23 de-novo-sequenced isolates.ResultsWhen testing the 1862 GenBank files, the method identified the resistance genes with an ID = 100% (100% identity) to the genes in ResFinder. Agreement between in silico predictions and phenotypic testing was found when the method was further tested on 23 isolates of five different bacterial species, with available phenotypes. Furthermore, ResFinder was evaluated on WGS chromosomes and plasmids of 30 isolates. Seven of these isolates were annotated to have antimicrobial resistance, and in all cases, annotations were compatible with the ResFinder results.ConclusionsA web server providing a convenient way of identifying acquired antimicrobial resistance genes in completely sequenced isolates was created. ResFinder can be accessed at www.genomicepidemiology.org. ResFinder will continuously be updated as new resistance genes are identified.","author_count":8,"contributors":["Zankari, Ea","Hasman, Henrik","Cosentino, Salvatore","Vestergaard, Martin","Rasmussen, Simon","Lund, Ole","Aarestrup, Frank Møller","Larsen, Mette Voldby"],"cuid":["S01-000.00-366794"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Antibiotic resistance","Genotype"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"identification of acquired antimicrobial resistance genes","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1093/jac/dks261","version":"Other Version"},"id":"S01-000.00-366794","identifier":[{"id":"22782487","type":"pmid"},{"id":"PMC3468078","type":"pmcid"},{"id":"84867587461","type":"scopus"}],"ids":["dtu-d0565c5c-fb03-4d78-b53d-0af4a2316eb9"],"keyword":["ResFinder","antibiotic resistance","genotype","resistance gene identification"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-7305B5333B4A9307A041F2DE4FE6C85F"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1093/jac/dks261","version":"Other Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Systems Biology, Center for Biological Sequence Analysis","Technical University of Denmark, National Food Institute","Technical University of Denmark, National Food Institute, Division of Epidemiology and Microbial Genomics"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Ea","key":"zankaripau","last":"Zankari","locid":"11bde48b-fac1-4faa-a538-50d6ef3144ca","name":"Zankari, Ea","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik","key":"hasmanpau","last":"Hasman","locid":"2aeb80b4-d42a-4da2-9212-86b697184f40","name":"Hasman, Henrik","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Salvatore","key":"cosentinopau","last":"Cosentino","locid":"4bb9e1cb-cf15-49ec-8242-51af37011a9b","name":"Cosentino, Salvatore","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Martin","key":"vestergaardpau","last":"Vestergaard","locid":"f6c4295e-ccfe-4624-b66c-fcf690255c31","name":"Vestergaard, Martin","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Simon","key":"rasmussenpau","last":"Rasmussen","locid":"7dcb9d6e-8054-4bcf-a087-82517b291a32","name":"Rasmussen, Simon","orcid":"0000-0001-6323-9041","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ole","key":"lundpau","last":"Lund","locid":"d2f5060c-0c9a-4875-820f-91180f3bb685","name":"Lund, Ole","orcid":"0000-0003-1108-0491","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Frank Møller","key":"aarestruppau","last":"Aarestrup","locid":"8a1eb030-2c37-4557-bce1-7bc6d5c75aaa","name":"Aarestrup, Frank Møller","orcid":"0000-0002-7116-2723","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mette Voldby","key":"larsenpau","last":"Larsen","locid":"48f90aec-1c95-444e-a7e5-d7b3ddcf1b7e","name":"Larsen, Mette Voldby","rank":8,"rolecode":"pau"}],"pmid":["22782487"],"pub":{"doi":"10.1093/jac/dks261","issn":["03057453","14602091"],"issn_org":["03057453"],"issue":"11","journal":"Journal of Antimicrobial Chemotherapy","pages":"2640-2644","publisher":"Oxford University Press","status":"p","title":"Journal of Antimicrobial Chemotherapy","volume":"67"},"review":"Peer Reviewed","scoID":["2-s2.0-84867587461"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-d0565c5c-fb03-4d78-b53d-0af4a2316eb9"],"src":["DTU Technical University of Denmark"],"title":"Identification of acquired antimicrobial resistance genes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-366794","year":"2012","yearsub":"2012"}
