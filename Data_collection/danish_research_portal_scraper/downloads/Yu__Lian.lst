":"18 53 113","corresponding":null,"first":"Gongbo","key":"zhaogongbopau","last":"Zhao","name":"Zhao, Gongbo","rank":310,"rolecode":"pau"},{"affno":"34 53","corresponding":null,"first":"Zheng","key":"zhengzhengpau","last":"Zheng","name":"Zheng, Zheng","rank":311,"rolecode":"pau"},{"affno":"100","corresponding":null,"first":"Guangtun","key":"zhuguangtunpau","last":"Zhu","name":"Zhu, Guangtun","rank":313,"rolecode":"pau"},{"affno":"53","corresponding":null,"first":"Hu","key":"zouhupau","last":"Zou","name":"Zou, Hu","rank":314,"rolecode":"pau"}],"pub":{"doi":"10.3847/1538-4365/ab929e","issn":["15384365"],"issue":"1","journal":"Astrophysical Journal Supplement Series","paperid":"3","publisher":"Institute of Physics Publishing","status":"p","title":"Astrophysical Journal Supplement Series","volume":"249"},"review":"Peer Reviewed","scoID":["2-s2.0-85088298365"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-778973ca-a401-4f7a-aa8b-a46547463bf3"],"src":["AU Aarhus University"],"title":"The 16th Data Release of the Sloan Digital Sky Surveys : First Release from the APOGEE-2 Southern Survey and Full Release of eBOSS Spectra","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-197705","year":"2020","yearsub":"2020"}
{"abstract":"Thermogenic fat expends energy during cold for temperature homeostasis, and its activity regulates nutrient metabolism and insulin sensitivity. We measured cold-activated lipid landscapes in circulation and in adipose tissue by MS/MSALL shotgun lipidomics. We created an interactive online viewer to visualize the changes of specific lipid species in response to cold. In adipose tissue, among the approximately 1,600 lipid species profiled, we identified the biosynthetic pathway of the mitochondrial phospholipid cardiolipin as coordinately activated in brown and beige fat by cold in wild-type and transgenic mice with enhanced browning of white fat. Together, these data provide a comprehensive lipid bio-signature of thermogenic fat activation in circulation and tissue and suggest pathways regulated by cold exposure. In this resource, Lynes et al. use a sensitive MS/MSALL technique to profile over 1,000 lipid species in the blood and adipose tissue of humans and mice exposed to cold. Using the online viewer they created to view these data, pathways activated by cold exposure can be identified.","author_count":15,"contributors":["Lynes, Matthew D.","Shamsi, Farnaz","Sustarsic, Elahu G","Leiria, Luiz O.","Wang, Chih Hao","Su, Sheng Chiang","Huang, Tian Lian","Gao, Fei","Narain, Niven R.","Chen, Emily Y.","Cypess, Aaron M.","Schulz, Tim J.","Gerhart-Hines, Zachary","Kiebish, Michael A.","Tseng, Yu Hua"],"cuid":["S01-000.00-414768"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Europe, EU","OECD"],"country":["Germany","United States"],"glorg":["All Global Affiliations","BERG, LLC","German Institute of Human Nutrition","Harvard University","National Institutes of Health"],"keyword":["Brown adipose tissue","Cardiolipin","Lipidomics","Thermogenesis","White adipose tissue"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"cold activated lipid dynamics in adipose tissue highlights a role for cardiolipin in thermogenic metabolism","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.celrep.2018.06.073","version":"Published Version"},"id":"S01-000.00-414768","identifier":[{"id":"PMC6117118","type":"pmcid"},{"id":"30021173","type":"pmid"},{"id":"85049754305","type":"scopus"}],"ids":["ku-23bc9072-8e0e-4c90-bd49-9f59a99a45f6"],"keyword":["brown adipose tissue","cardiolipin","lipidomics","thermogenesis","white adipose tissue"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-68BC415909EF68E17B54650E04602213"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.celrep.2018.06.073","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/222166510/1_s2.0_S2211124718310003_main.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","country":"us","key":"harvard university","loc":["United States","America, North","OECD"],"name":"Harvard University","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Basic Metabolic Research, Gerhart-Hines Group","Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Basic Metabolic Research, Nutrient and Metabolite Sensing"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"us","key":"berg llc","loc":["United States","America, North","OECD"],"name":"BERG, LLC","used":1},{"affno":"4","country":"us","key":"national institutes of health","loc":["United States","America, North","OECD"],"name":"National Institutes of Health","used":1},{"affno":"5","country":"de","key":"german institute of human nutrition","loc":["Germany","Europe, EU","OECD"],"name":"German Institute of Human Nutrition","used":1}],"person":[{"affno":"1","first":"Matthew D.","key":"lynespau","last":"Lynes","name":"Lynes, Matthew D.","rank":1,"rolecode":"pau"},{"affno":"1","first":"Farnaz","key":"shamsipau","last":"Shamsi","name":"Shamsi, Farnaz","rank":2,"rolecode":"pau"},{"affno":"2","first":"Elahu Gosney","key":"sustarsicpau","last":"Sustarsic","locid":"1c3164ff-e8b9-428a-b4f6-c9d7f3af10cf","name":"Sustarsic, Elahu G","name_org":"Sustarsic, Elahu Gosney","orcid":"0000-0002-4792-4740","rank":3,"rolecode":"pau"},{"affno":"1","first":"Luiz O.","key":"leiriapau","last":"Leiria","name":"Leiria, Luiz O.","rank":4,"rolecode":"pau"},{"affno":"1","first":"Chih Hao","key":"wangpau","last":"Wang","name":"Wang, Chih Hao","rank":5,"rolecode":"pau"},{"affno":"1","first":"Sheng Chiang","key":"supau","last":"Su","name":"Su, Sheng Chiang","rank":6,"rolecode":"pau"},{"affno":"1","first":"Tian Lian","key":"huangpau","last":"Huang","name":"Huang, Tian Lian","rank":7,"rolecode":"pau"},{"affno":"3","first":"Fei","key":"gaopau","last":"Gao","name":"Gao, Fei","rank":8,"rolecode":"pau"},{"affno":"3","first":"Niven R.","key":"narainpau","last":"Narain","name":"Narain, Niven R.","rank":9,"rolecode":"pau"},{"affno":"3","first":"Emily Y.","key":"chenpau","last":"Chen","name":"Chen, Emily Y.","rank":10,"rolecode":"pau"},{"affno":"4","first":"Aaron M.","key":"cypesspau","last":"Cypess","name":"Cypess, Aaron M.","rank":11,"rolecode":"pau"},{"affno":"1 5","first":"Tim J.","key":"schulzpau","last":"Schulz","name":"Schulz, Tim J.","rank":12,"rolecode":"pau"},{"affno":"2","first":"Zachary","key":"gerharthinespau","last":"Gerhart-Hines","locid":"04fa1a49-5a2d-49c8-96ce-cb4eb14d091c","name":"Gerhart-Hines, Zachary","orcid":"0000-0003-2981-4991","rank":13,"rolecode":"pau"},{"affno":"3","first":"Michael A.","key":"kiebishpau","last":"Kiebish","name":"Kiebish, Michael A.","rank":14,"rolecode":"pau"},{"affno":"1","first":"Yu Hua","key":"tsengpau","last":"Tseng","name":"Tseng, Yu Hua","rank":15,"rolecode":"pau"}],"pmid":["30021173"],"pub":{"doi":"10.1016/j.celrep.2018.06.073","issn":["22111247"],"issue":"3","journal":"Cell Reports","pages":"781-790","status":"p","title":"Cell Reports","volume":"24"},"review":"Peer Reviewed","scoID":["2-s2.0-85049754305"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-23bc9072-8e0e-4c90-bd49-9f59a99a45f6"],"src":["KU University of Copenhagen"],"title":"Cold-Activated Lipid Dynamics in Adipose Tissue Highlights a Role for Cardiolipin in Thermogenic Metabolism","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-414768","year":"2018","yearsub":"2018"}
{"abstract":"Microbial fermentation conditions are dynamic, due to transcriptional induction, nutrient consumption, or changes to incubation conditions. In this study, 13C-metabolic flux analysis was used to characterize two violacein-producing E. coli strains with vastly different productivities, and to profile their metabolic adjustments resulting from external perturbations during fermentation. The two strains were first grown at 37°C in stage 1, and then the temperature was transitioned to 20°C in stage 2 for the optimal expression of the violacein synthesis pathway. After induction, violacein production was minimal in stage 3, but accelerated in stage 4 (early production phase) and 5 (late production phase) in the high producing strain, reaching a final concentration of 1.5mmol/L. On the contrary, ~0.02mmol/L of violacein was obtained from the low producing strain. To have a snapshot of the temporal metabolic changes in each stage, we performed 13C-MFA via isotopomer analysis of fast-turnover free metabolites. The results indicate strikingly stable flux ratios in the central metabolism throughout the early growth stages. In the late stages, however, the high producer rewired its flux distribution significantly, which featured an upregulated pentose phosphate pathway and TCA cycle, reflux from acetate utilization, negligible anabolic fluxes, and elevated maintenance loss, to compensate for nutrient depletion and drainage of some building blocks due to violacein overproduction. The low producer with stronger promoters shifted its relative fluxes in stage 5 by enhancing the flux through the TCA cycle and acetate overflow, while exhibiting a reduced biomass growth and a minimal flux towards violacein synthesis. Interestingly, the addition of the violacein precursor (tryptophan) in the medium inhibited high producer but enhanced low producer's productivity, leading to hypotheses of unknown pathway regulations (such as metabolite channeling).","author_count":7,"contributors":["He, Lian","Xiu, Yu","Jones, J. Andrew","Baidoo, Edward E. K.","Keasling, Jay D.","Tang, Yinjie J","Koffas, Mattheos A. G."],"cuid":["S01-000.00-306632"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Joint Bioenergy Institute","Rensselaer Polytechnic Institute","Washington University St. Louis"],"keyword":["Channeling","Promoter","Reflux","Tryptophan","Violacein"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"deciphering flux adjustments of engineered e coli cells during fermentation with changing growth conditions","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85009354635","version":"Other Version"},"id":"S01-000.00-306632","identifier":[{"id":"85009354635","type":"scopus"},{"id":"28017690","type":"pmid"}],"ids":["dtu-06d07d80-fff5-4b9f-97a1-502d02f2af31"],"keyword":["(13)C-MFA","Channeling","Free metabolites","Promoter","Reflux","Tryptophan","Violacein"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-10CDB6B5B5823D01217DE9E2C2175A3E"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2016"},"org":[{"affno":"1","country":"us","key":"washington university st louis","loc":["United States","America, North","OECD"],"name":"Washington University St. Louis","used":1},{"affno":"2","country":"us","key":"rensselaer polytechnic institute","loc":["United States","America, North","OECD"],"name":"Rensselaer Polytechnic Institute","used":1},{"affno":"3","country":"us","key":"joint bioenergy institute","loc":["United States","America, North","OECD"],"name":"Joint Bioenergy Institute","used":1},{"affno":"4","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Novo Nordisk Foundation Center for Biosustainability","Technical University of Denmark, Novo Nordisk Foundation Center for Biosustainability, Synthetic Biology Tools for Yeast"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lian","key":"hepau","last":"He","name":"He, Lian","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Yu","key":"xiupau","last":"Xiu","name":"Xiu, Yu","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"J. Andrew","key":"jonespau","last":"Jones","name":"Jones, J. Andrew","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Edward E. K.","key":"baidoopau","last":"Baidoo","name":"Baidoo, Edward E. K.","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Jay D.","key":"keaslingpau","last":"Keasling","locid":"4f3be9f5-dd00-46fe-9d54-d7af2735014c","name":"Keasling, Jay D.","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yinjie J","key":"tangpau","last":"Tang","name":"Tang, Yinjie J","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mattheos A. G.","key":"koffaspau","last":"Koffas","name":"Koffas, Mattheos A. G.","rank":7,"rolecode":"pau"}],"pmid":["28017690"],"pub":{"doi":"10.1016/j.ymben.2016.12.008","issn":["10967176","10967184"],"issn_org":["10967176"],"journal":"Metabolic Engineering","pages":"247-256","publisher":"Academic Press","status":"p","title":"Metabolic Engineering","volume":"39"},"review":"Peer Reviewed","scoID":["2-s2.0-85009354635"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-06d07d80-fff5-4b9f-97a1-502d02f2af31"],"src":["DTU Technical University of Denmark"],"title":"Deciphering flux adjustments of engineered E. coli cells during fermentation with changing growth conditions","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-306632","year":"2017","yearsub":"2016"}
{"abstract":"Brown adipose tissue (BAT) and beige adipose tissue combust fuels for heat production in adult humans, and so constitute an appealing target for the treatment of metabolic disorders such as obesity, diabetes and hyperlipidemia. Cold exposure can enhance energy expenditure by activating BAT, and it has been shown to improve nutrient metabolism. These therapies, however, are time consuming and uncomfortable, demonstrating the need for pharmacological interventions. Recently, lipids have been identified that are released from tissues and act locally or systemically to promote insulin sensitivity and glucose tolerance; as a class, these lipids are referred to as 'lipokines'. Because BAT is a specialized metabolic tissue that takes up and burns lipids and is linked to systemic metabolic homeostasis, we hypothesized that there might be thermogenic lipokines that activate BAT in response to cold. Here we show that the lipid 12,13-dihydroxy-9Z-octadecenoic acid (12,13-diHOME) is a stimulator of BAT activity, and that its levels are negatively correlated with body-mass index and insulin sensitivity. Using a global lipidomic analysis, we found that 12,13-diHOME was increased in the circulation of humans and mice exposed to cold. Furthermore, we found that the enzymes that produce 12,13-diHOME were uniquely induced in BAT by cold stimulation. The injection of 12,13-diHOME acutely activated BAT fuel uptake and enhanced cold tolerance, which resulted in decreased levels of serum triglycerides. Mechanistically, 12,13-diHOME increased fatty acid (FA) uptake into brown adipocytes by promoting the translocation of the FA transporters FATP1 and CD36 to the cell membrane. These data suggest that 12,13-diHOME, or a functional analog, could be developed as a treatment for metabolic disorders.","author_count":21,"contributors":["Lynes, Matthew D","Leiria, Luiz O","Lundh, Morten","Bartelt, Alexander","Shamsi, Farnaz","Huang, Tian Lian","Takahashi, Hirokazu","Hirshman, Michael F","Schlein, Christian","Lee, Alexandra","Baer, Lisa A","May, Francis J","Narain, Niven R","Chen, Emily Y","Kiebish, Michael A","Cypess, Aaron M","Blüher, Matthias","Goodyear, Laurie J","Hotamisligil, Gökhan S","Stanford, Kristin I","Tseng, Yu-Hua"],"cuid":["S01-000.00-506800"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Journal Article"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the cold induced lipokine 000000000012 000000000013 dihome promotes fatty acid transport into brown adipose tissue","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.nature.com/articles/nm1117-1384b","version":"Other Version"},"id":"S01-000.00-506800","identifier":[{"id":"85016102311","type":"scopus"},{"id":"PMC5699924","type":"pmcid"},{"id":"28346411","type":"pmid"}],"ids":["ku-bdeca2f4-d73c-4d48-b17c-6f339f315b00"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-800D68630A66BB5B7431C0F2C3BB1FEE"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Basic Metabolic Research, Integrative Metabolism and Environmental Influences"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Matthew D","key":"lynespau","last":"Lynes","name":"Lynes, Matthew D","rank":1,"rolecode":"pau"},{"affno":"","first":