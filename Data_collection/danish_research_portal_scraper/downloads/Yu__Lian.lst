d":"0a2a7ad3-1719-43c6-bdf3-c3491a43a8af","name":"Pedersen, Oluf","name_org":"Pedersen, Oluf Borbye","orcid":"0000-0002-3321-3972","rank":41,"rolecode":"pau"},{"affno":"1","first":"Zhengquan","key":"yuzhengquanpau","last":"Yu","name":"Yu, Zhengquan","rank":42,"rolecode":"pau"},{"affno":"15 16","first":"Stanislav Dusko","key":"ehrlichstanislavduskopau","last":"Ehrlich","name":"Ehrlich, Stanislav Dusko","rank":43,"rolecode":"pau"},{"affno":"1","first":"Fazheng","key":"renfazhengpau","last":"Ren","name":"Ren, Fazheng","rank":44,"rolecode":"pau"}],"pmid":["32241904"],"pub":{"doi":"10.1136/gutjnl-2019-319766","issn":["00175749","14683288"],"issn_org":["00175749"],"issue":"12","journal":"Gut","pages":"2131-2142","paperid":"319766","status":"p","title":"Gut","volume":"69"},"review":"Peer Reviewed","scoID":["2-s2.0-85083286914"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-1e761416-f215-463e-8e35-dce1aceca15c"],"src":["KU University of Copenhagen"],"title":"Aberrant gut microbiota alters host metabolome and impacts renal failure in humans and rodents","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-411567","year":"2020","yearsub":"2020"}
{"abstract":"Brown and brown-like beige/brite adipocytes dissipate energy and have been proposed as therapeutic targets to combat metabolic disorders. However, the therapeutic effects of cell-based therapy in humans remain unclear. Here, we created human brown-like (HUMBLE) cells by engineering human white preadipocytes using CRISPR-Cas9-SAM-gRNA to activate endogenous uncoupling protein 1 expression. Obese mice that received HUMBLE cell transplants showed a sustained improvement in glucose tolerance and insulin sensitivity, as well as increased energy expenditure. Mechanistically, increased arginine/nitric oxide (NO) metabolism in HUMBLE adipocytes promoted the production of NO that was carried by S-nitrosothiols and nitrite in red blood cells to activate endogenous brown fat and improved glucose homeostasis in recipient animals. Together, these data demonstrate the utility of using CRISPR-Cas9 technology to engineer human white adipocytes to display brown fat-like phenotypes and may open up cell-based therapeutic opportunities to combat obesity and diabetes.","author_count":19,"contributors":["Wang, Chih-Hao","Lundh, Morten","Fu, Accalia","Kriszt, Rókus","Huang, Tian Lian","Lynes, Matthew D","Leiria, Luiz O","Shamsi, Farnaz","Darcy, Justin","Greenwood, Bennett P","Narain, Niven R","Tolstikov, Vladimir","Smith, Kyle L","Emanuelli, Brice","Chang, Young-Tae","Hagen, Susan","Danial, Nika N","Kiebish, Michael A","Tseng, Yu-Hua"],"cuid":["S01-000.00-436541"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"crispr engineered human brown like adipocytes prevent diet induced obesity and ameliorate metabolic syndrome in mice","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"http://europepmc.org/Copyright","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC7704293/pdf/nihms-1639488.pdf","version":"Authors Final Version"},"id":"S01-000.00-436541","identifier":[{"id":"85089966226","type":"scopus"},{"id":"32848096","type":"pmid"},{"id":"PMC7704293","type":"pmcid"}],"ids":["ku-482c6e9b-d5f6-48eb-b66e-88800db73e46"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-D649DECCE09E5686CD85363F277A97B4"],"oa_link":[{"access":"oa","license":"http://europepmc.org/Copyright","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC7704293/pdf/nihms-1639488.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Basic Metabolic Research"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Chih-Hao","key":"wangpau","last":"Wang","name":"Wang, Chih-Hao","rank":1,"rolecode":"pau"},{"affno":"1","first":"Morten","key":"lundhpau","last":"Lundh","locid":"68d27e9f-656d-4e57-9090-56f9e9373fc1","name":"Lundh, Morten","orcid":"0000-0003-0918-577X","rank":2,"rolecode":"pau"},{"affno":"","first":"Accalia","key":"fupau","last":"Fu","name":"Fu, Accalia","rank":3,"rolecode":"pau"},{"affno":"","first":"Rókus","key":"krisztpau","last":"Kriszt","name":"Kriszt, Rókus","rank":4,"rolecode":"pau"},{"affno":"","first":"Tian Lian","key":"huangpau","last":"Huang","name":"Huang, Tian Lian","rank":5,"rolecode":"pau"},{"affno":"","first":"Matthew D","key":"lynespau","last":"Lynes","name":"Lynes, Matthew D","rank":6,"rolecode":"pau"},{"affno":"","first":"Luiz O","key":"leiriapau","last":"Leiria","name":"Leiria, Luiz O","rank":7,"rolecode":"pau"},{"affno":"","first":"Farnaz","key":"shamsipau","last":"Shamsi","name":"Shamsi, Farnaz","rank":8,"rolecode":"pau"},{"affno":"","first":"Justin","key":"darcypau","last":"Darcy","name":"Darcy, Justin","rank":9,"rolecode":"pau"},{"affno":"","first":"Bennett P","key":"greenwoodpau","last":"Greenwood","name":"Greenwood, Bennett P","rank":10,"rolecode":"pau"},{"affno":"","first":"Niven R","key":"narainpau","last":"Narain","name":"Narain, Niven R","rank":11,"rolecode":"pau"},{"affno":"","first":"Vladimir","key":"tolstikovpau","last":"Tolstikov","name":"Tolstikov, Vladimir","rank":12,"rolecode":"pau"},{"affno":"","first":"Kyle L","key":"smithpau","last":"Smith","name":"Smith, Kyle L","rank":13,"rolecode":"pau"},{"affno":"1","first":"Brice","key":"emanuellipau","last":"Emanuelli","locid":"67a4f742-a844-427b-9de5-db0ccf844016","name":"Emanuelli, Brice","orcid":"0000-0001-5795-5666","rank":14,"rolecode":"pau"},{"affno":"","first":"Young-Tae","key":"changpau","last":"Chang","name":"Chang, Young-Tae","rank":15,"rolecode":"pau"},{"affno":"","first":"Susan","key":"hagenpau","last":"Hagen","name":"Hagen, Susan","rank":16,"rolecode":"pau"},{"affno":"","first":"Nika N","key":"danialpau","last":"Danial","name":"Danial, Nika N","rank":17,"rolecode":"pau"},{"affno":"","first":"Michael A","key":"kiebishpau","last":"Kiebish","name":"Kiebish, Michael A","rank":18,"rolecode":"pau"},{"affno":"","first":"Yu-Hua","key":"tsengpau","last":"Tseng","name":"Tseng, Yu-Hua","rank":19,"rolecode":"pau"}],"pmid":["32848096"],"pub":{"doi":"10.1126/scitranslmed.aaz8664","issn":["19466234","19466242"],"issn_org":["19466234"],"issue":"558","journal":"Science Translational Medicine","paperid":"eaaz8664","status":"p","title":"Science Translational Medicine","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-85089966226"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-482c6e9b-d5f6-48eb-b66e-88800db73e46"],"src":["KU University of Copenhagen"],"title":"CRISPR-engineered human brown-like adipocytes prevent diet-induced obesity and ameliorate metabolic syndrome in mice","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-436541","year":"2020","yearsub":"2020"}
{"abstract":"Uncoupling protein-1 (UCP1) plays a central role in energy dissipation in brown adipose tissue (BAT). Using high-throughput library screening of secreted peptides, we identify two fibroblast growth factors (FGF), FGF6 and FGF9, as potent inducers of UCP1 expression in adipocytes and preadipocytes. Surprisingly, this occurs through a mechanism independent of adipogenesis and involves FGF receptor-3 (FGFR3), prostaglandin-E2 and interaction between estrogen receptor-related alpha, flightless-1 (FLII) and leucine-rich-repeat-(in FLII)-interacting-protein-1 as a regulatory complex for UCP1 transcription. Physiologically, FGF6/9 expression in adipose is upregulated by exercise and cold in mice, and FGF9/FGFR3 expression in human neck fat is significantly associated with UCP1 expression. Loss of FGF9 impairs BAT thermogenesis. In vivo administration of FGF9 increases UCP1 expression and thermogenic capacity. Thus, FGF6 and FGF9 are adipokines that can regulate UCP1 through a transcriptional network that is dissociated from brown adipogenesis, and act to modulate systemic energy metabolism.","author_count":26,"contributors":["Shamsi, Farnaz","Xue, Ruidan","Huang, Tian Lian","Lundh, Morten","Liu, Yang","Leiria, Luiz O","Lynes, Matthew D","Kempf, Elena","Wang, Chih-Hao","Sugimoto, Satoru","Nigro, Pasquale","Landgraf, Kathrin","Schulz, Tim","Li, Yiming","Emanuelli, Brice","Kothakota, Srinivas","Williams, Lewis T","Jessen, Niels","Pedersen, Steen Bønløkke","Böttcher, Yvonne","Blüher, Matthias","Körner, Antje","Goodyear, Laurie J","Mohammadi, Moosa","Kahn, C Ronald","Tseng, Yu-Hua"],"cuid":["S02-100.00-020254"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","America, South","Asia, East","Europe, EU","Europe, Non-EU","Nordic","OECD"],"country":["Brazil","China","Germany","Norway","United States"],"glorg":["Akershus Universitetssykehus","All Global Affiliations","Department of Clinical Molecular Biology","Department of Environment Science and Engineering, Fudan University","Five Prime Therapeutics, Inc.","Fudan University","German Institute of Human Nutrition","German Institute of Human Nutrition Potsdam-Rehbruecke","Harvard University","Leipzig University","New York University","Universidade Federal de Sao Paulo","Universidade de São Paulo","University of Oslo"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"fgf000000000006 and fgf000000000009 regulate ucp000000000001 expression independent of brown adipogenesis","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41467-020-15055-9","version":"Published Version"},"id":"S02-100.00-020254","identifier":[{"id":"85082023290","type":"scopus"},{"id":"PMC7078224","type":"pmcid"},{"id":"32184391","type":"pmid"}],"ids":["au-68486b87-089c-4977-ace8-b6d708790650","ku-46bfdae6-45a9-42d0-9034-aa61b50e0f39"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-FEF2E758E219E4455711238F05CA6E9A"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41467-020-15055-9","version":"Published Version"},{"access":"oa","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC7078224/pdf/41467_2020_Article_15055.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/250866756/s41467_020_15055_9.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"us","key":"harvard university","loc":["United States","America, N