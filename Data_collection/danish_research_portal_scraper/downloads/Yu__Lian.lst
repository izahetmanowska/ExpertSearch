ffno":"","first":"David W.","key":"burtdavidwpau","last":"Burt","name":"Burt, David W.","rank":98,"rolecode":"pau"},{"affno":"","first":"Peter","key":"houdepeterpau","last":"Houde","name":"Houde, Peter","rank":99,"rolecode":"pau"},{"affno":"","first":"Yong","key":"zhangyongpau","last":"Zhang","name":"Zhang, Yong","rank":100,"rolecode":"pau"},{"affno":"","first":"Huanming","key":"yanghuanmingpau","last":"Yang","name":"Yang, Huanming","rank":101,"rolecode":"pau"},{"affno":"","first":"Jian","key":"wangjianpau","last":"Wang","name":"Wang, Jian","rank":102,"rolecode":"pau"},{"affno":"","first":"Erich D.","key":"jarviserichdpau","last":"Jarvis","name":"Jarvis, Erich D.","rank":103,"rolecode":"pau"},{"affno":"1","first":"M Thomas P","key":"gilbertmthomasppau","last":"Gilbert","locid":"58c97189-c7e9-4486-afb1-e7669608599e","name":"Gilbert, M. Thomas P.","name_org":"Gilbert, M Thomas P","orcid":"0000-0002-5805-7195","rank":104,"rolecode":"pau"},{"affno":"1","first":"Jun","key":"wangjunpau","last":"Wang","locid":"5dee6edc-2876-496f-a341-4a07933f9928","name":"Wang, Jun","rank":105,"rolecode":"pau"}],"pub":{"doi":"10.1126/science.1251385","issn":["00368075","10959203"],"issn_org":["00368075"],"issue":"6215","journal":"Science","pages":"1311-1320","status":"p","title":"Science","volume":"346"},"review":"Peer Reviewed","scoID":["2-s2.0-84917678595"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-d2ddbede-21bd-4b54-98df-f85ce99e0629"],"src":["KU University of Copenhagen"],"title":"Comparative genomics reveals insights into avian genome evolution and adaptation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-519418","year":"2014","yearsub":"2014"}
{"abstract":"Two important aspects are associated with service composition. One is to understand the needs and constraints for a new added-value composite service, and otherwise it would lead to an ad-hoc effort for service composition. The second is to reflect the changes of computing environment to the service composition to catch up the on-demand of users. This paper introduces a goal-driven approach to specify the user requirements and demands that guides the service composition, and proposes context awareness to adapt to a dynamically changing environment. Computing contexts, including physical context, user profile and computed results, are gathered by various services, and imported into an ontology based a context repository. A Goal Description Language, Context Condition/Effect are designed to describe the dynamic semantics of goal requirements and service capability. A planner is designed and implemented to dynamically compose services based on the current contexts, and a service runner is designed and implemented to invoke proper services based on the contexts and interactions with users.","author_count":4,"contributors":["Yu, Lian","Glenstrup, Arne John","Zhang, Yang","Su, Shuang"],"cuid":["S01-000.00-381346"],"event":{"end":"2010-12-03","place":"Maribor, si","start":"2010-12-01","title":"5th IEEE International Conference on Pervasive Computing and Applications","year":"2010"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","Peking University"],"keyword":["Context awareness","Dynamic Service Planning","Goal driven Approach","Ontology based Context Repository","Service composition"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"goal driven context aware service composition","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/34548971/icpca_Goal_LianYu.pdf","version":"Pre-print"},"id":"S01-000.00-381346","ids":["itu-05d56f73-921d-4627-956a-c27aeec91d5f"],"keyword":["Context Awareness","Dynamic Service Planning","Goal-driven Approach","Ontology-based Context Repository","Service Composition"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-B25FD3CFBA99199D0872BE0CA1EB0359"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/34548971/icpca_Goal_LianYu.pdf","version":"Pre-print"}],"org":[{"affno":"1","country":"cn","key":"peking university","loc":["China","Asia, East"],"name":"Peking University","used":1},{"affno":2,"key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"ITU IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["ITU IT University of Copenhagen"],"nora_code":"DI-U-ITU"}],"person":[{"affno":"1","corresponding":null,"first":"Lian","key":"yupau","last":"Yu","name":"Yu, Lian","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Arne John","key":"glenstruppau","last":"Glenstrup","name":"Glenstrup, Arne John","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yang","key":"zhangpau","last":"Zhang","name":"Zhang, Yang","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Shuang","key":"supau","last":"Su","name":"Su, Shuang","rank":4,"rolecode":"pau"}],"pub":{"isbn":["9781424491445"],"pages":"342-347","publisher":"IEEE","status":"p","title":"Pervasive Computing and Applications (ICPCA) 2010. 5th International Conference on"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","ITU IT University of Copenhagen"],"PST":["Published"]},"sid":["itu-05d56f73-921d-4627-956a-c27aeec91d5f"],"src":["ITU IT University of Copenhagen"],"title":"Goal-Driven Context-aware Service Composition","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381346","year":"2011","yearsub":"2010"}
{"abstract":"Brown adipose tissue plays an important role in obesity, insulin resistance, and diabetes. We have previously shown that the transition from brown preadipocytes to mature adipocytes is mediated in part by insulin receptor substrate (IRS)-1 and the cell cycle regulator protein necdin. In this study, we used pharmacological inhibitors and adenoviral dominant negative constructs to demonstrate that this transition involves IRS-1 activation of Ras and ERK1/2, resulting in phosphorylation of cAMP response element-binding protein (CREB) and suppression of necdin expression. This signaling did not include an elevation of intracellular calcium. A constitutively active form of CREB expressed in IRS-1 knockout cells decreased necdin promoter activity, necdin mRNA, and necdin protein levels, leading to a partial restoration of differentiation. By contrast, forkhead box protein (Fox)O1, which is regulated by the phosphoinositide 3 kinase-Akt pathway, increased necdin promoter activity. Based on reporter gene assays using truncations of the necdin promoter and chromatin immunoprecipitation studies, we demonstrated that CREB and FoxO1 are recruited to the necdin promoter, likely interacting with specific consensus sequences in the proximal region. Based on these results, we propose that insulin/IGF-I act through IRS-1 phosphorylation to stimulate differentiation of brown preadipocytes via two complementary pathways: 1) the Ras-ERK1/2 pathway to activate CREB and 2) the phosphoinositide 3 kinase-Akt pathway to deactivate FoxO1. These two pathways combine to decrease necdin levels and permit the clonal expansion and coordinated gene expression necessary to complete brown adipocyte differentiation.","author_count":8,"contributors":["Cypess, Aaron M","Zhang, Hongbin","Schulz, Tim J","Huang, Tian Lian","Espinoza, Daniel O","Kristiansen, Karsten","Unterman, Terry G","Tseng, Yu-Hua"],"cuid":["S01-000.00-490974"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Adipocytes Brown","Adipogenesis","Animals","Cell Differentiation","Cells Cultured","Cyclic AMP Response Element Binding Protein","Extracellular Signal Regulated MAP Kinases","Forkhead Transcription Factors","Insulin","Insulin Like Growth Factor I","Insulin Receptor Substrate Proteins","Mice","Nerve Tissue Proteins","Nuclear Proteins","Phosphorylation","Promoter Regions Genetic","Signal Transduction"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"insulin igf i regulation of necdin and brown adipocyte differentiation via creb and foxo000000000001 associated pathways","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1210/en.2011-1229","version":"Other Version"},"id":"S01-000.00-490974","identifier":[{"id":"21862615","type":"pmid"},{"id":"80053143671","type":"scopus"},{"id":"PMC3176640","type":"pmcid"}],"ids":["ku-a33d329e-ae23-461c-a914-72cb75a1b08d"],"keyword":["Adipocytes, Brown","Adipogenesis","Animals","Cell Differentiation","Cells, Cultured","Cyclic AMP Response Element-Binding Protein","Extracellular Signal-Regulated MAP Kinases","Forkhead Transcription Factors","Insulin","Insulin Receptor Substrate Proteins","Insulin-Like Growth Factor I","Mice","Nerve Tissue Proteins","Nuclear Proteins","Phosphorylation","Promoter Regions, Genetic","Signal Transduction"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-781118545E36956B1128F930931FE598"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1210/en.2011-1229","version":"Other Version"}],"org":[{"affno":"1","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Biology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Aaron M","key":"cypesspau","last":"Cypess","name":"Cypess, Aaron M","rank":1,"rolecode":"pau"},{"affno":"1","first":"Hongbin","key":"zhangpau","last":"Zhang","name":"Zhang, Hongbin","rank":2,"rolecode":"pau"},{"affno":"","first":"Tim J","key":"schulzpau","last":"Schulz","name":"Schulz, Tim J","rank":3,"rolecode":"pau"},{"affno":"","first":"Tian Lian","key":"huangpau","last":"Huang","name":"Huang, Tian Lian","rank":4,"rolecode":"pau"},{"affno":"","first":"Daniel O","key":"espinozapau","last":"Espinoza","name":"Espinoza, Daniel O","rank":5,"rolecode":"pau"},{"affno":"2","first":"Karsten","key":"kristiansenpau","last":"Kristiansen","locid":"941041b1-1b8f-4be5-9a65-5e98f662c07e","name":"Kristiansen, Karsten","orcid":"0000-0002-6024-0917","rank":6,"rolecode":"pau"},{"affno":"","first":"Terry G","key":"untermanpau","last":"Unterman","name":"Unterman, Terry G","rank":7,"rolecode":"pau"},{"affno":"","first":"Yu-Hua","key":"tsengpau","last":"Tseng","name":"Tseng, Yu-Hua","rank":8,"rolecode":"pau"}],"pmid":["21862615"],"pub":{"doi":"10.1210/en.2011-1229","issn":["00137227","19457170"],"issn_org":["00137227"],"issue":"10","journal":"Endocrinology","pages":"3680-9","status":"p","title":"Endocrinology","volume":"152"},"review":"Peer Reviewed","scoID":["2-s2.0-80053143671"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Publ