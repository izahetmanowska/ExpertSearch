es","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-3ec675fd-cf43-43c5-9129-9e21134b4e43"],"src":["ITU IT University of Copenhagen"],"title":"Sustainability and Business Value of Big Data Analytics and Machine Learning: Data Volume and Algorithmic Complexity : What is the trade-off between data volume and algorithm complexity for machine learning performance?","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-759397","year":"2023","yearsub":"2023"}
{"abstract":"As social interactions increasingly take place in digital environments, a vast and increasing volume of digital traces in the form of unstructured textual data is produced. Currently, the machine learning techniques to analyze such data require deep knowledge of machine learning, usually confined to highly specialized data scientists and statisticians. This high competence threshold excludes a large group of businesses and data analysts from leveraging machine learning and creating value from unstructured digital trace data. This paper shows how the Midas framework can help data analysts analyze unstructured text data using neural networks. It outlines the framework's main features and provides example guides on how to implement the Midas framework on specific datasets. We hope this framework will make it easier and more accessible for data analysts working with unstructured text data to leverage neural networks.","author_count":3,"contributors":["Pedersen, Nikolaj Krebs","Meged, Anders Widtfeldt","Johansen, Rune André"],"cuid":["S01-000.00-759430"],"filters":{"added":"2024-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Neural networks","Text mining"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"nr","rtype":["clu"],"sorti":"midas a python framework for automated generating and training of neural network models","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/101769634/Midas_-_a_Python_Framework_for_Automated_Generating_and_Training_for_Neural_Network_Models.pdf","version":"Pre-print"},"id":"S01-000.00-759430","ids":["itu-f6d86abe-88fb-428a-8d75-8cd7f5fcb6ca"],"keyword":["Democratization of machine learning","Midas framework","Neural networks","Text mining","Unstructured text data"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-1C711F462F02FEB3BC03F5A9291189CE"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/101769634/Midas_-_a_Python_Framework_for_Automated_Generating_and_Training_for_Neural_Network_Models.pdf","version":"Pre-print"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Digital Business Innovation, Information Systems and Digital Innovation"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Nikolaj Krebs","key":"pedersenpau","last":"Pedersen","locid":"44aa2464-bb3c-413f-93fa-d5b56d85ec5c","name":"Pedersen, Nikolaj Krebs","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Anders Widtfeldt","key":"megedpau","last":"Meged","name":"Meged, Anders Widtfeldt","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Rune André","key":"johansenpau","last":"Johansen","name":"Johansen, Rune André","rank":3,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-f6d86abe-88fb-428a-8d75-8cd7f5fcb6ca"],"src":["ITU IT University of Copenhagen"],"title":"Midas: a Python Framework for Automated Generating and Training of Neural Network Models","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-759430","year":"2022","yearsub":"2022"}
