:{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-e78cb915-ea2f-4566-a46e-58391738ee5f"],"src":["AU Aarhus University"],"title":"The Data Lifecycle and Domains of Business Analytics in Decision Support Systems - An Integrative Framework","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-826685","year":"2025","yearsub":"2025"}
{"abstract":"The decision support systems (DSS) research literature within Information Systems (IS) is riddled with various overlapping definitions and approaches. Through an extensive literature review, this paper identifies key definitions, dimensions, and trends in the DSS literature and provides a unified classification. Based on the identified constructs, we identify a nesting challenge in DSS defined as the oversaturation of DSS approaches that occurs by continuously creating new approaches to cover specific use cases. We also argue that not all DSS approaches are comparable, as they address different aspects of decision support systems, with some defining application areas, while others focus on the technique or technology used. Through a discussion of the literature and the nesting classification, the paper draws on conceptual dimensions from business analytics (BA) research to define DSS approaches as domain-specific or technique-specific. From this point of departure, this paper calls for further research on integrating BA and DSS to enrich the application of DSS approaches in design and implementation. This literature review contributes to IS literature by showcasing a new perspective to create coherence within the DSS discipline.","author_count":2,"contributors":["Pedersen, Nikolaj Krebs","Andersen, Jonas Valbjørn"],"cuid":["S01-000.00-776400"],"filters":{"added":"2025-01","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Business analytics","Decision support systems","Literature review","Machine learning"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"examing approaches and addressing the nesting challenge in decision support systems","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/107199428/EXAMINING_APPROACHES_AND_ADDRESSING_THE_NESTING_CHALLENGE_IN_DECI.pdf","version":"Authors Final Version"},"id":"S01-000.00-776400","ids":["itu-536f4292-8841-47d4-ab4f-e838e664c20e"],"keyword":["Business Analytics","Decision Support Systems","Literature Review","Machine Learning"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-040256B38232E328E02982D3C04CCAE8"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/107199428/EXAMINING_APPROACHES_AND_ADDRESSING_THE_NESTING_CHALLENGE_IN_DECI.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Digital Business Innovation, Information Systems and Digital Innovation"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Nikolaj Krebs","key":"pedersenpau","last":"Pedersen","locid":"44aa2464-bb3c-413f-93fa-d5b56d85ec5c","name":"Pedersen, Nikolaj Krebs","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jonas Valbjørn","key":"andersenpau","last":"Andersen","locid":"3dac6e0e-2770-4c5e-b32a-d7750523516f","name":"Andersen, Jonas Valbjørn","orcid":"0000-0002-3366-5573","rank":2,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-536f4292-8841-47d4-ab4f-e838e664c20e"],"src":["ITU IT University of Copenhagen"],"title":"Examing Approaches and addressing the nesting challenge in Decision Support Systems.","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-776400","year":"2024","yearsub":"2024"}
