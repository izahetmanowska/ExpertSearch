stems","volume":"2"},"review":"Peer Reviewed","scoID":["2-s2.0-84983039628"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Roskilde University","Universities"],"PST":["Published"]},"sid":["aau-52145b6c-c5ed-4cdb-9514-de27120a14d2","ruc-a9168dd7-bbf3-459d-9723-c4aa25818747"],"src":["AAU Aalborg University","RUC Roskilde University"],"title":"Library perceptions of using social software as blogs in the idea generation phase of service innovations : Lessons from an experiment","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-093.95-004007","year":"2013","yearsub":"2013"}
