{"author_count":4,"contributors":["Scupola, Ada","Nicolajsen, Hanne Westh"],"cuid":["S01-000.00-558655"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-RUC"]},"level3all":["DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"a study of e services adoption factors","src":["ruc"],"src-code":["DI-U-RUC"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-558655","ids":["ruc-2853e15b-468a-4f33-81bb-c84686d2439f"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-3-5-AEF73508C551AD62796DF7C59F82CF98"],"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, The Department of Communication, Business and Information Technologies","Roskilde University, The Department of Communication, Business and Information Technologies, Innovation in Business and Enterprises"],"nora_code":"DI-U-RUC","used":1}],"person":[{"affno":"1","country":"dk","first":"Ada","key":"scupolapau","last":"Scupola","locid":"31120161-69fe-4720-8fd6-46383ba639df","name":"Scupola, Ada","orcid":"0000-0002-3537-7639","rank":1,"rolecode":"pau"},{"affno":"","first":"Hanne Westh","key":"nicolajsenpau","last":"Nicolajsen","name":"Nicolajsen, Hanne Westh","rank":2,"rolecode":"pau"},{"affno":"","first":"A.","key":"carugatipedh","last":"Carugati","name":"Carugati, A.","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"C.","key":"rossignolipedh","last":"Rossignoli","name":"Rossignoli, C.","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-7908-2739-2","isbn":["9783790827385"],"pages":"169-17