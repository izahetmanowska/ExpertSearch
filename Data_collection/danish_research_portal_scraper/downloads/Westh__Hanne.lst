{"author_count":2,"contributors":["Tjørnehøj, Gitte","Nicolajsen, Hanne Westh"],"cuid":["S01-000.00-117777"],"event":{"end":"2006-01-07","place":"Kauai, Hawaii, us","start":"2006-01-04","title":"HICSS-39","year":"2006"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"pursuing digitalization in the public sector through collaborative public private agile service innovation","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-117777","ids":["aau-e8f3e260-faaf-4bd4-ab40-c2a1927ae7c9"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-9B97125A503082B184ADB67BAD0B2F8F"],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Social Sciences","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Politics and Society, Centre for Information Systems Management","Aalborg University, The Faculty of Social Sciences, Department of Political Science"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Anne Birgitte Bay","key":"tjørnehøjpau","last":"Tjørnehøj","locid":"0c313b43-1daa-4d6a-8b70-463c557e4b82","name":"Tjørnehøj, Gitte","name_org":"Tjørnehøj, Anne Birgitte Bay","orcid":"0000-0002-3630-5688","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Hanne Westh","key":"nicolajsenpau","last":"Nicolajsen","locid":"fc0c09b9-7317-48b6-9bdb-a09739397660","name":"Nicolajsen, Hanne Westh","orcid":"0000-0003-0355-7421","rank":2,"rolecode":"pau"}],"pub":{"status":"p","title":"Workshop contribution - Service Science workshop."},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-e8f3e260-faaf-4bd4-ab40-c2a1927ae7c9"],"src":["AAU Aalborg University"],"title":"Pursuing Digitalization in the Public Sector through Collaborative Public-Private Agile Service Innovation","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-117777","year":"2018","yearsub":"2018"}
{"abstract":"Information Technology (IT) enables challenges and opportunities for how enterprises organize themselves and how work unfolds in digital settings. The changes in technology, work, organizations, and humans’ mindset, call for new ways to discuss leadership. In these new digital settings, traditional leadership no longer holds. Instead, new forms of digital leadership are needed. In this paper we review the IS research perspective on digital leadership. We conduct a systematic literature review combined with a hermeneutical approach. We compare the findings from our literature review with a theoretical lens inspired by e-leadership. We find that IS research has an exclusive scope on strategic implications, leaving out topics such as followership and emotions. On the other hand, IS research contributes with exactly these issues of strategic leadership and business transformation to the digital leadership discussion. We contribute to IS research by defining digital leadership, proposing a theoretical lens of three levels of analysis of digital leadership, as well as paths for future research.","author_count":3,"contributors":["Stana, Raluca-Alexandra Byskov","Fischer, Louise Harder","Nicolajsen, Hanne Westh"],"cuid":["S01-000.00-384278"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Information systems","Leadership","Literature review"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"review for future research in digital leadership","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84744390/Review_for_future_research_in_digital_leadership.pdf","version":"Authors Final Version"},"id":"S01-000.00-384278","ids":["itu-cdaf4a29-90b0-468d-bd86-07e32aaf0a51"],"keyword":["Information Systems","Leadership","literature review"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-5159904075F0509880930C09E28C9D1D"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84744390/Review_for_future_research_in_digital_leadership.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Raluca-Alexandra Byskov","key":"stanapau","last":"Stana","name":"Stana, Raluca-Alexandra Byskov","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Louise Harder","key":"fischerpau","last":"Fischer","locid":"a22e85da-82e3-410d-8ef1-31407362ba19","name":"Fischer, Louise Harder","orcid":"0000-0001-7193-3797","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hanne Westh","key":"nicolajsenpau","last":"Nicolajsen","locid":"54728da8-274d-40e6-b119-23318d995721","name":"Nicolajsen, Hanne Westh","orcid":"0000-0002-0158-5034","rank":3,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-cdaf4a29-90b0-468d-bd86-07e32aaf0a51"],"src":["ITU IT University of Copenhagen"],"title":"Review for future research in digital leadership","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384278","year":"2018","yearsub":"2019"}
