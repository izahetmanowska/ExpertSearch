me":"Zeitlinger, Markus","rank":36,"rolecode":"pau"},{"affno":"2","first":"Morten","key":"sommermortenpau","last":"Sommer","name":"Sommer, Morten","rank":37,"rolecode":"pau"}],"pmid":["35522900"],"pub":{"doi":"10.1002/ctm2.790","issn":["20011326"],"issue":"5","journal":"Clinical and Translational Medicine","paperid":"e790","status":"p","title":"Clinical and Translational Medicine","volume":"12"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Private Research","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Governmental Institutions","Other Companies","Private Research","Technical University of Denmark","Universities","University of Copenhagen","clinical-microbiomics a/s (biz)","union therapeutics"],"PST":["Published"]},"sid":["ku-afa75a43-2936-4cd1-a8ed-899282e9fedc"],"src":["KU University of Copenhagen"],"title":"Topical niclosamide (ATx201) reduces <i>Staphylococcus aureus</i> colonization and increases Shannon diversity of the skin microbiome in atopic dermatitis patients in a randomized, double-blind, placebo-controlled Phase 2 trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-498355","year":"2022","yearsub":"2022"}
{"abstract":"Although enterprise crowdsourcing systems that aim to harness the collective intelligence of employees for innovation purposes are proliferating, little is known about how they may impact organisations and their culture. To shed light on this problem, this paper conducts a case study to investigate an engineering consultancy’s efforts to implement an internal crowdsourcing as part of an effort to change the innovation culture of the organisation. Taking the starting point in the literature on the relationship between IT and organisational culture and enterprise crowdsourcing, this paper underscores the interplay between innovation culture and information technology. The study finds that enterprise crowdsourcing systems can contribute to small changes of the innovation culture of an organisation along several cultural determinants, including behaviours that encourage innovation, communication and knowledge sharing, employees’ relationships, support mechanisms, and strategy.","author_count":2,"contributors":["Scupola, Ada","Nicolajsen, Hanne Westh"],"cuid":["S01-000.00-573127"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Case study","Enterprise crowdsourcing","Innovation culture","Organisational culture","Social media"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-RUC"]},"level3all":["DI-U-ITU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"enterprise crowdsourcing and organizational culture lessons from an engineering consultancy","src":["ruc"],"src-code":["DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/74808313/culturecrowdsourcing_IJESMA_2021_vol_13no2.pdf","version":"Authors Final Version"},"id":"S01-000.00-573127","identifier":[{"id":"85124099759","type":"scopus"}],"ids":["ruc-fe6b3596-b740-4625-865d-ffd333f70c02"],"keyword":["Case study","Enterprise crowdsourcing","Innovation culture","Organisational culture","Social media"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-4-821B0DE126D645710662467139903C59"],"oa_link":[{"access":"oa","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/74808313/culturecrowdsourcing_IJESMA_2021_vol_13no2.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Social Science (SOC)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of Social Sciences and Business"],"nora_code":"DI-U-RUC","used":1},{"affno":"2","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","country":"dk","first":"Ada","key":"scupolapau","last":"Scupola","locid":"31120161-69fe-4720-8fd6-46383ba639df","name":"Scupola, Ada","orcid":"0000-0002-3537-7639","rank":1,"rolecode":"pau"},{"affno":"2","first":"Hanne Westh","key":"nicolajsenpau","last":"Nicolajsen","name":"Nicolajsen, Hanne Westh","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.4018/ijesma.2021040101","issn":["1941627X","19416288"],"issn_org":["1941627X"],"issue":"2","journal":"International Journal of e-Services and Mobile Applications","pages":"1-20","status":"p","title":"International Journal of e-Services and Mobile Applications","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-85124099759"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Roskilde University","Universities"],"PST":["Published"]},"sid":["ruc-fe6b3596-b740-4625-865d-ffd333f70c02"],"src":["RUC Roskilde University"],"title":"Enterprise Crowdsourcing and Organizational Culture : Lessons from an Engineering Consultancy","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-573127","year":"2021","yearsub":"2021"}
{"abstract":"In highly digitalized countries such as Denmark, statistics show that one out of four employees have experienced high-stress levels. However, despite ample research evidence on the presence of technostress, the knowledge on this phenomenon is not yet part of the material and guidelines by the official authorities. Previous research on technostress provides quantitative psychological and neurophysiological perspectives on technostress, focusing on the individual, the technology, or the technological environment. We see this as a limited approach, as it leaves out the social environment in which technostress arises. We aim to expose the sociological mechanisms that contribute to technostress by using the sociological lens of obligation. We ask: “What is the knowledge that the sociological lens of obligation can bring to the understanding and handling of technostress?” To answer our research question, we employ an embedded case study in Denmark by looking into the existing political material and interviews with 14 employees across six organizations. We find that stress is mostly addressed from a response perspective, which points to the individual. This view is inherited in how the individuals take responsibility for the technostress they experience. At the same time, obligations of availability and engagement in productive work predominate the social environment. We contribute to theory by using a new-to-IS theory and conduct qualitative research to investigate the mature phenomenon of technostress within IS. We contribute to practice by showing a need to move in the direction of seeing technostress as a societal phenomenon, rather than solely an individual responsibility.","author_count":2,"contributors":["Stana, Raluca","Nicolajsen, Hanne Westh"],"cuid":["S01-000.00-383542"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Information and communication technology","Information systems","Obligation","Qualitative study","Sociology","Technostress"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"sociological mechanisms behind ict related technostress in the workplace","src":["itu"],"src-code":["DI-U-ITU"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-383542","ids":["itu-9bd36b8b-d9dc-495f-9a33-1d8a0fbdf919"],"keyword":["Information Systems","Information and Communication Technology","Obligation","Qualitative Study","Sociology","Technostress"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-9366E98B3C2D2234A75EFE68D5507539"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Raluca","key":"stanapau","last":"Stana","name":"Stana, Raluca","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hanne Westh","key":"nicolajsenpau","last":"Nicolajsen","locid":"54728da8-274d-40e6-b119-23318d995721","name":"Nicolajsen, Hanne Westh","orcid":"0000-0002-0158-5034","rank":2,"rolecode":"pau"}],"pub":{"publisher":"Emerald Group Publishing","status":"p","title":"Information Technology in Organisations and Societies: Multidisciplinary Perspectives from AI to Technostress"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-9bd36b8b-d9dc-495f-9a33-1d8a0fbdf919"],"src":["ITU IT University of Copenhagen"],"title":"Sociological mechanisms behind ICT related technostress in the workplace","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383542","year":"2020","yearsub":"2020"}
{"abstract":"Background: Livestock-associated meticillin-resistant Staphylococcus aureus (LA-MRSA) clonal complex (CC) 398 may be transmitted and cause morbidity and mortality in hospitals. The economic cost of stopping hospital transmission of LA-MRSA CC398 is poorly described. Early detection of transmission may limit the extent of the intervention. Aim: To evaluate core genome multi-locus sequence typing (cgMLST) for detecting transmission chains and to estimate the costs for interventions to prevent further spread after discovery of hospital transmission of LA-MRSA CC398. Methods: Five patients were involved in two episodes of transmission of LA-MRSA CC398 in a hospital. Standard interventions including MRSA screening of patients and healthcare workers were initiated. Whole genome sequences of the five isolates and 17 epidemiologically unrelated MRSA CC398 isolates from other hospitalized patients were analysed by single nucleotide polymorphism (SNP) comparisons and cgMLST. The economic costs of constraining transmission were calculated from relevant sources. Findings: The five isolates suspected to be involved in hospital transmission clustered with ≤2 SNPs in the draft genome sequences with some distance to other isolates. cgMLST allocated the five isolates to the same type, which was different from all but two of the sporadic isolates. Furthermore, cgMLST separated the five transmission isolates from all other isolates. The economic costs of the outbreak interventions exceeded €11,000 per patient. Conclusion: LA-MRSA CC398 is transmittable in hospitals, and intervention against transmission may reach considerable costs. cgMLST is useful in surveillance of hospital transmission of LA-MRSA.","author_count":10,"contributors":["Slott Jensen, M. L.","Nielsine Skov, M.","Pries Kristiansen, H.","Toft, A.","Lundgaard, H.","Gumpert, H.","Westh, Henrik","Holm, A.","Kolmos, H. J.","Kemp, M."],"cuid":["S02-100.00-044716"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Slott Jensen, Marie Louise"],"keyword":["Economic costs","Hospital outbreak","Livestock associated MRSA","MRSA CC398","Whole genome sequencing","cgMLST"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"core genome multi locus sequence typing as an essential tool in a high cost livestock associated meticillin resistant i staphylococcus aureus i cc000000000398 hospital outbreak","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85078716296","version":"Other Version"},"id":"S02-100.00-044716","identifier":[{"id":"31857121","type":"pmid"},{"id":"85078716296","type":"scopus"}],"ids":["ku-9b8a17fd-5ade-4e63-a7b5-1da6b8c1fdbc","sdu-a349ece1-a784-4ffa-b171-bd1ee1634015"],"keyword":["Economic costs","Hospital outbreak","Livestock-associated MRSA","MRSA CC398","Whole genome sequencing","cgMLST"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-F1C2D396AC3135C1B6B62865FE1CA4FD"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Clinical Microbiology (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"M. L.","key":"slottjensenpau","last":"Slott Jensen","locid":"88d9403d-97a6-4ee4-95da-2e9249a16bf6","name":"Slott Jensen, Marie Louise","name_org":"Slott Jensen, M. L.","orcid":"0000-0002-5905-1465","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"M.","key":"nielsineskovpau","last":"Nielsine Skov","locid":"5b2553ab-dfde-4995-8c58-7840a16be668","name":"Skov, Marianne Nielsine","name_org":"Nielsine Skov, M.","orcid":"0000-0002-2619-0864","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"H.","key":"prieskristiansenpau","last":"Pries Kristiansen","locid":"063e84c2-537d-4323-98ec-6d51ef0a186a","name":"Pries Kristiansen, Helle","name_org":"Pries Kristiansen, H.","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"A.","key":"toftpau","last":"Toft","locid":"46df99b3-397d-47c4-b25a-01e80bd26765","name":"Toft, Annette","name_org":"Toft, A.","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"H.","key":"lundgaardpau","last":"Lundgaard","locid":"fe7776b8-240f-4bca-843e-08898c81c2e4","name":"Lundgaard, Hanne","name_org":"Lundgaard, H.","rank":5,"rolecode":"pau"},{"affno":"2","first":"H.","key":"gumpertpau","last":"Gumpert","locid":"ba02cec3-fc6b-491e-86eb-c44cd3acf9f1","name":"Gumpert, H.","rank":6,"rolecode":"pau"},{"affno":"2","first":"H.","key":"westhpau","last":"Westh","locid":"5ed71556-672c-4f57-95de-3abba6b821ea","name":"Westh, Henrik","name_org":"Westh, H.","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"A.","key":"holmpau","last":"Holm","locid":"bf236581-7ff9-4735-9100-9e863e41e609","name":"Holm, Anette","name_org":"Holm, A.","orcid":"0000-0001-7794-2846","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"H. J.","key":"kolmospau","last":"Kolmos","locid":"a3b7b0c5-f328-429d-8de3-91ad1079218e","name":"Kolmos, Hans Jørn","name_org":"Kolmos, H. J.","orcid":"0000-0002-5640-953X","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"M.","key":"kemppau","last":"Kemp","locid":"d28a28b7-cbe0-42f1-b2c6-ff6a89cafcf8","name":"Kemp, Michael","name_org":"Kemp, M.","orcid":"0000-0001-5989-0421","rank":10,"rolecode":"pau"}],"pmid":["31857121"],"pub":{"doi":"10.1016/j.jhin.2019.12.009","issn":["01956701","14759594"],"issn_org":["01956701"],"issue":"4","journal":"Journal of Hospital Infection","pages":"574-581","publisher":"Elsevier","status":"p","title":"Journal of Hospital Infection","volume":"104"},"review":"Peer Reviewed","scoID":["2-s2.0-85078716296"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-9b8a17fd-5ade-4e63-a7b5-1da6b8c1fdbc","sdu-a349ece1-a784-4ffa-b171-bd1ee1634015"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Core genome multi-locus sequence typing as an essential tool in a high-cost livestock-associated meticillin-resistant <i>Staphylococcus aureus</i> CC398 hospital outbreak","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-044716","year":"2020","yearsub":"2020"}
{"abstract":"This paper conducts an in depth case study of the implementation of an idea competition in a consulting company. Based on 27 interviews with company managers as well as employees acting as users or non users of the idea competition in the company has changed the innovation orientation of the company along several dimensions including creativity and empowerment, innovation infrastructure, innovation influence and innovation intention.","author_count":2,"contributors":["Nicolajsen, Hanne Westh","Scupola, Ada"],"cuid":["S01-000.00-384209"],"event":{"acronym":"MCIS","title":"Mediterranean Conference on Information Systems"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Consulting Industry","Employee Empowerment","Idea competition","Innovation management","Organizational change"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-RUC"]},"level3all":["DI-U-ITU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"creating a new innovation orientation through idea competitions","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85496575/creating_a_new_innovation_orientation_through_idea_competititon_springer_2020_1_.pdf","version":"Authors Final Version"},"id":"S01-000.00-384209","identifier":[{"id":"85092132002","type":"scopus"}],"ids":["itu-c8c2b724-1171-4854-b84a-0ed5e42205a2"],"keyword":["Consulting Industry","Employee Empowerment","Idea Competition","Innovation Management","Organizational Change"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-5-280B310F18B01B30AB7848CF0CB59265"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85496575/creating_a_new_innovation_orientation_through_idea_competititon_springer_2020_1_.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"dk","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University"],"nora_code":"DI-U-RUC","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Hanne Westh","key":"nicolajsenpau","last":"Nicolajsen","locid":"54728da8-274d-40e6-b119-23318d995721","name":"Nicolajsen, Hanne Westh","orcid":"0000-0002-0158-5034","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ada","key":"scupolapau","last":"Scupola","name":"Scupola, Ada","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-030-47355-6_7","isbn":["9783030473556"],"pages":"93-106","publisher":"Springer","status":"p","title":"ITAIS and MCIS 2019-Digital Transformation and Social Innovation"},"review":"Peer Reviewed","scoID":["2-s2.0-85092132002"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Roskilde University","Universities"],"PST":["Published"]},"sid":["itu-c8c2b724-1171-4854-b84a-0ed5e42205a2"],"src":["ITU IT University of Copenhagen"],"title":"Creating a New Innovation Orientation Through Idea Competitions","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384209","year":"2020","yearsub":"2020"}
{"abstract":"With the pervasiveness of information and communication technologies (ICTs) in organizations, employees continuously interact both online and offline. This continuous interaction leads to the construction of norms and obligations around the usage of technology, which can also result in negative impacts on the employees’ health, for example, technostress. Previous Information Systems research on technostress has focused on psychological or neurophysiological quantitative research on the use of ICTs and its effects. To our knowledge, there are no technostress studies that make use of the role of obligation, which in our view is a crucial lens, as it shifts the technostress debate to showing how the felt obligations constructed around the technology, can lead to technostress. To further explore how technostress arises, we use the analytical concept of obligation from the discipline Sociology of Emotions. Our data comes from an exploratory case study in a Danish fintech company. We find that employees take on themselves the ideals of ICTs being seamless, and when ICTs don’t live up to their expectations, they experience shame and guilt. To avoid such feelings, they construct obligations that lead to technostress. We contribute to technostress and IS literature by showing how obligation con- tributes to technostress.","author_count":2,"contributors":["Stana, Raluca","Nicolajsen, Hanne Westh"],"cuid":["S01-000.00-383852"],"event":{"acronym":"IRIS","title":"Information Systems Research Seminar in Scandinavia"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Information systems","Obligation","Sociology","Technostress"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"people on the other side are waiting work obligations and shame in ict related technostress","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85697523/PeopleonTheOtherSideAreWaiting_WorkObligationsandShame.pdf","version":"Pre-print"},"id":"S01-000.00-383852","ids":["itu-b11c8e45-8ba9-4743-bc06-4622b3b3dea1"],"keyword":["Information Systems","Obligation","Sociology","Technostress"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-030DACA14277D51954F936B73A1D764E"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85697523/PeopleonTheOtherSideAreWaiting_WorkObligationsandShame.pdf","version":"Pre-print"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Raluca","key":"stanapau","last":"Stana","name":"Stana, Raluca","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hanne Westh","key":"nicolajsenpau","last":"Nicolajsen","locid":"54728da8-274d-40e6-b119-23318d995721","name":"Nicolajsen, Hanne Westh","orcid":"0000-0002-0158-5034","rank":2,"rolecode":"pau"}],"pub":{"publisher":"AIS Electronic Library","status":"p","title":"Selected papers of the Information systems research seminar in Scandinavia (IRIS)"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-b11c8e45-8ba9-4743-bc06-4622b3b3dea1"],"src":["ITU IT University of Copenhagen"],"title":"People on the other side are waiting: work obligations and shame in ICT-related Technostress","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383852","year":"2020","yearsub":"2020"}
{"abstract":"Technostress is a growing area of research and a concern for practitioners. So far, IS research on technostress has focused on either neurophysiological or psychological measurements. We argue for a sociological approach that allows us to reveal the socially co-created obligations around using ICTs (information and communication technologies). We ask, \"What can the sociological analytical concept of obligation reveal about ICT related technostress in organizations?\" To investigate this question, we use the sociological concept of obligation. We conduct interpretative research based on qualitative interviews. We find that employees see technostress as their individual obligation and devise strategies to avoid it. These strategies add to their technostress and augment group obligations that can lead to technostress for the collective. We contribute to theory by employing a new-to-IS theory and a qualitative approach to investigate technostress. We also contribute to practice by revealing specific obligations that contribute to technostress.","author_count":2,"contributors":["Stana, Raluca","Nicolajsen, Hanne Westh"],"cuid":["S01-000.00-383629"],"event":{"acronym":"HICSS","title":"Hawaii International Conference on System Sciences"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["ICT usage","Obligations","Qualitative Research","Sociological approach","Technostress"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"a cautionary tale how co constructed work obligations lead to ict related technostress","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://pure.itu.dk/ws/files/85697380/0648.pdf","version":"Published Version"},"id":"S01-000.00-383629","ids":["itu-a233923c-ec6c-4659-9437-f94555596a3b"],"keyword":["ICT usage","Obligations","Qualitative research","Sociological approach","Technostress"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-16A4948CFE8E7E4991E1454BB1076BC5"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"rem","url":"https://hdl.handle.net/10125/71417","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://pure.itu.dk/ws/files/85697380/0648.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Raluca","key":"stanapau","last":"Stana","name":"Stana, Raluca","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hanne Westh","key":"nicolajsenpau","last":"Nicolajsen","locid":"54728da8-274d-40e6-b119-23318d995721","name":"Nicolajsen, Hanne Westh","orcid":"0000-0002-0158-5034","rank":2,"rolecode":"pau"}],"pub":{"publisher":"University of Hawai'i at Manoa","status":"p","title":"Proceedings of the 54th Hawaii International Conference on System Sciences"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-a233923c-ec6c-4659-9437-f94555596a3b"],"src":["ITU IT University of Copenhagen"],"title":"A Cautionary Tale: How Co-Constructed Work Obligations Lead to ICT-Related Technostress","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383629","year":"2020","yearsub":"2020"}
{"abstract":"This paper conducts an in depth case study of the implementation of an idea competition in a consulting company. Based on 27 interviews with company managers as well as employees acting as users or non users of the idea competition in the company has changed the innovation orientation of the company along several dimensions including creativity and empowerment, innovation infrastructure, innovation influence and innovation intention.","author_count":6,"contributors":["Nicolajsen, Hanne Westh","Scupola, Ada"],"cuid":["S01-000.00-557238"],"event":{"end":"2019-09-28","place":"Naples, it","start":"2019-09-27","title":"ITAIS and MCIS 2019-Digital Transformation and Social Innovation","year":"2019"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Culture","ICT","Idea competition","Innovation orientation"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-RUC"]},"level3all":["DI-U-DTU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"creating a new innovation orientation through idea competitions","src":["ruc"],"src-code":["DI-U-RUC"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/74113748/creating_a_new_innovation_orientation_through_idea_competititon_springer_2020.pdf","version":"Authors Final Version"},"id":"S01-000.00-557238","identifier":[{"id":"85092132002","type":"scopus"}],"ids":["ruc-12cc88fd-30b8-4d1a-97d6-dc7dede82726"],"keyword":["Culture","ICT","Idea competition","Innovation orientation"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-3-5-280B310F18B01B30AB7848CF0CB59265"],"oa_link":[{"access":"oa","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/74113748/creating_a_new_innovation_orientation_through_idea_competititon_springer_2020.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"dk","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of Social Sciences and Business"],"nora_code":"DI-U-RUC","used":1}],"person":[{"affno":"1","first":"Hanne Westh","key":"nicolajsenpau","last":"Nicolajsen","name":"Nicolajsen, Hanne Westh","rank":1,"rolecode":"pau"},{"affno":"2","country":"dk","first":"Ada","key":"scupolapau","last":"Scupola","locid":"31120161-69fe-4720-8fd6-46383ba639df","name":"Scupola, Ada","orcid":"0000-0002-3537-7639","rank":2,"rolecode":"pau"},{"affno":"","first":"Rocco","key":"agrifogliopedh","last":"Agrifoglio","name":"Agrifoglio, Rocco","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Rita","key":"lambogliapedh","last":"Lamboglia","name":"Lamboglia, Rita","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Daniela","key":"mancinipedh","last":"Mancini","name":"Mancini, Daniela","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Francesca","key":"ricciardipedh","last":"Ricciardi","name":"Ricciardi, Francesca","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-030-47355-6_7","isbn":["9783030473556"],"issn":["21954968"],"issue":"38","pages":"93-106","publisher":"Springer","series":"Lecture Notes in Information Systems and Organisation","status":"p","title":"Digital Business Transformation"},"review":"Peer Reviewed","scoID":["2-s2.0-85092132002"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Roskilde University","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["ruc-12cc88fd-30b8-4d1a-97d6-dc7dede82726"],"src":["RUC Roskilde University"],"title":"Creating a New Innovation Orientation Through Idea Competitions","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-557238","year":"2020","yearsub":"2020"}
{"abstract":"Idea competitions can help organizations innovate and IT support can make it easier to enrol participants, facilitate collaboration and manage the process. Thus far, the literature on IT‐enabled idea competitions has focused mainly on engaging external actors; consequently, we know less about the internal engagement of employees. Moreover, although the literature reveals several challenges in managing internal IT‐enabled idea competitions, there are no comprehensive empirical accounts of how these challenges manifest in organizational contexts. Against this backdrop, we investigate how an engineering consultancy adapted an IT‐enabled idea competition to support innovation, innovation awareness and knowledge sharing. This descriptive case study provides a detailed analysis of the breakdowns that manifested, what triggered the breakdowns, and how the organization responded. Our analysis reveals that the system required substantial adaptation, and, although it addressed well‐known challenges in managing idea competitions, other challenges surfaced. We combine these empirical insights with extant literature to propose a model for understanding and explaining how our case organization handled the breakdowns that occurred while implementing the idea competition system.","author_count":4,"contributors":["Nicolajsen, Hanne Westh","Matthiasen, Lars","Scupola, Ada"],"cuid":["S02-087.73-038390"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Georgia State University"],"keyword":["Case study","Idea competition","Implementation","Organizational Innovation"],"level":"sci","mra":["sci","soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-ITU","DI-U-RUC"]},"level3all":["DI-U-DTU","DI-U-ITU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"it enabled idea competitions for organizational innovation an inquiry into breakdowns in adaptation","src":["itu","ruc"],"src-code":["DI-U-ITU","DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/67277395/PostPrint_IT_enabled_Idea_Competitions_Published.pdf","version":"Authors Final Version"},"id":"S02-087.73-038390","identifier":[{"id":"85076584786","type":"scopus"}],"ids":["itu-d804ac08-61bb-48d8-9f82-9db21e77b193","ruc-8db09a8c-ac09-4d78-bc54-08c3f07f20f1"],"keyword":["case study","idea competition","implementation","organizational innovation"],"lang":"English","level":"Scientific","mra":["Science/Technology","Social Science"],"noi":["Global-Local-2-5-8103E5513800B42FD1551031F1F7E897"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84768217/PostPrint_IT_enabled_Idea_Competitions_Published.pdf","version":"Pre-print"},{"access":"oa","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/67277395/PostPrint_IT_enabled_Idea_Competitions_Published.pdf","version":"Authors Final Version"},{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84771028/PostPrint_Figures_Tables_IT_enabled_Idea_Competitions_Published.pdf","version":"Pre-print"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"dk","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark"],"nora_code":"DI-U-DTU","used":1},{"affno":"3","country":"us","key":"georgia state university","loc":["United States","America, North","OECD"],"name":"Georgia State University","used":1},{"affno":"4","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of Social Sciences and Business","Roskilde University, Department of Social Sciences and Business, Innovation in services and experiences"],"nora_code":"DI-U-RUC","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Hanne Westh","key":"nicolajsenpau","last":"Nicolajsen","locid":"54728da8-274d-40e6-b119-23318d995721","name":"Nicolajsen, Hanne Westh","orcid":"0000-0002-0158-5034","rank":1,"rolecode":"pau"},{"affno":"3","first":"Lars","key":"matthiasenpau","last":"Matthiasen","name":"Matthiasen, Lars","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Lars","key":"mathiassenpau","last":"Mathiassen","name":"Mathiassen, Lars","rank":2,"rolecode":"pau"},{"affno":"4","country":"dk","first":"Ada","key":"scupolapau","last":"Scupola","locid":"31120161-69fe-4720-8fd6-46383ba639df","name":"Scupola, Ada","orcid":"0000-0002-3537-7639","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1111/caim.12330","issn":["09631690","14678691"],"issn_org":["09631690"],"issue":"4","journal":"Creativity and Innovation Management","pages":"436","publisher":"Wiley-Blackwell","status":"p","title":"Creativity and Innovation Management","volume":"28"},"review":"Peer Reviewed","scoID":["2-s2.0-85076584786"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Roskilde University","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":[