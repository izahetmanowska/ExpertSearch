rolecode":"pau"},{"affno":"","first":"Rikke","key":"ørngreenpedh","last":"Ørngreen","name":"Ørngreen, Rikke","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9788799532803"],"pages":"120-122","status":"p","subtitle":"Conference Proceedings","title":"Designs for learning 2012, 3rd International Conference Exploring Learning Environments, 25-27 April 2012, Copenhagen, Denmark"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["aau-a5ec90b7-4c7d-43fd-884a-a8dfa94bd39f","itu-67dc949a-642c-47a2-b40a-9d9ddccbab9d"],"src":["AAU Aalborg University","ITU IT University of Copenhagen"],"title":"Designing for informed group formation","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-091.67-008025","year":"2012","yearsub":"2012"}
{"abstract":"In this article we investigate how social media-based crowdsourcing systems can be used to reengineer the innovation culture in an organization. Based on a case study of a large engineering consultancy's use of a social media crowdsourcing system we investigate the impact on the organizations innovation culture using theory on organizational culture and crowdsourcing. The analysis shows that the organizational crowdsourcing event has supported an innovation culture change in the case company towards a more open approach to innovation; creating a new and different awareness of innovation, allowing for internal process innovations, empowering the employees, supporting knowledge work and collaboration across the organization to a new extent and overcoming the traditional hierarchy in the organization.","author_count":2,"contributors":["Hugger, Ada Scupola","Nicolajsen, Hanne Westh"],"cuid":["S02-092.68-010230"],"event":{"end":"2011-12-07","place":"Shanghai","start":"2011-12-04","title":"OASIS","year":"2011"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Case study","Crowdsourcing","Crowdsourcing systems","Employee Empowerment","Innovation culture","Organizational","Organizational culture","Social Media Based Crowdsourcing"],"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-ITU","DI-U-UND"]},"level3all":["DI-U-AAU","DI-U-ITU","DI-U-UND"]},"review":"pr","rtype":["clu"],"sorti":"the impact of social media enterprise crowdsourcing on company innovation culture the case of an engineering consultancy","src":["aau","itu"],"src-code":["DI-U-AAU","DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://sprouts.aisnet.org/12-27/","version":"Other Version"},"id":"S02-092.68-010230","ids":["aau-d5ef3ad9-42e3-4baf-9cdd-82ab9be9e2cb","itu-facc282c-373c-49a0-87a3-34bb903b425e"],"keyword":["Crowdsourcing systems","Employee empowerment","Innovation culture","Social media-based crowdsourcing","case study","crowdsourcing","innovation awareness","organizational","organizational culture","social media-based crowdsourcing system"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-2-6F99F0C45A3DDC117DAF303DBE5A6F6D"],"oa_link":[{"access":"oa","type":"rem","url":"http://sprouts.aisnet.org/12-27/","version":"Other Version"}],"org":[{"affno":"1","country":"dk","key":"unclear universities","l2":"DI-U","l2n":"Universities","l3":"DI-U-UND","l3nl":"Undetermined","l3nn":"Unclear Universities","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Unclear Universities","namevar":["Department of Management Engineering"],"nora_code":"DI-U-UND","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Humanities","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Communication and Information Studies (CIS)","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, E-learning lab"],"nora_code":"DI-U-AAU","used":1},{"affno":"3","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Ada Scupola","key":"huggerpau","last":"Hugger","name":"Hugger, Ada Scupola","rank":1,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"country":"dk","first":"Hanne Westh","key":"nicolajsenpau","last":"Nicolajsen","locid":"fc0c09b9-7317-48b6-9bdb-a09739397660","name":"Nicolajsen, Hanne Westh","orcid":"0000-0003-0355-7421","rank":2,"rolecode":"pau"}],"pub":{"issn":["15356078"],"issue":"27","journal":"Sprouts","publisher":"Sprouts Alliance","status":"p","title":"Sprouts","volume":"12"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Undetermined","Universities"],"PST":["Published"]},"sid":["aau-d5ef3ad9-42e3-4baf-9cdd-82ab9be9e2cb","itu-facc282c-373c-49a0-87a3-34bb903b425e"],"src":["AAU Aalborg University","ITU IT University of Copenhagen"],"title":"The Impact of Social Media Enterprise Crowdsourcing on Company Innovation Culture : The case of an engineering consultancy","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-092.68-010230","year":"2012","yearsub":"2012"}
{"abstract":"In this article we investigate how social media-based crowdsourcing systems can be used to reengineer the innovation culture in an organization. Based on a case study of a large engineering consultancy’s use of a social media crowdsourcing system we investigate the impact on the organizations innovation culture using theory on organizational culture and crowdsourcing. The analysis shows that the organizational crowdsourcing event has supported an innovation culture change in the case company towards a more including approach to innovation; creating a new and different awareness of innovation, allowing for internal process innovations, empowering the employees, supporting knowledge work and collaboration across the organization to a new extent and overcoming the traditional hierarchy in the organization.","author_count":2,"contributors":["Scupola, Ada","Nicolajsen, Hanne Westh"],"cuid":["S02-092.31-003528"],"event":{"end":"2012-12-04","place":"Copenhagen, dk","start":"2012-12-03","title":"Det Danske Ledelsesakademi 2012","year":"2012"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Employee Empowerment","Innovation culture","Knowledge Work and Collaboration","Organizational culture","Social Media Based Crowdsourcing"],"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-ITU","DI-U-RUC"]},"level3all":["DI-U-AAU","DI-U-ITU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"reengineering the innovation culture through social media crowdsourcing when the customer encounter the employee","src":["aau","itu"],"src-code":["DI-U-AAU","DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/79346504/DDLA_2012_crowdsourcing_culture_ScupolaNicolajsen.pdf","version":"Pre-print"},"id":"S02-092.31-003528","ids":["