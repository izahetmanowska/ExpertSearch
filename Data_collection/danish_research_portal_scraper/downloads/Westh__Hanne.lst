RESER Conference ”Innovative Services in the 21st Century”","title":"Proceedings"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Roskilde University","Universities"],"PST":["Published"]},"sid":["ruc-7c00ea4b-064d-40ae-8fc2-67286cdc20a5"],"src":["RUC Roskilde University"],"title":"Comparing Methods for Involving Users in Ideation : The Use of Future Workshops and Blogs in Library Innovation","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-564306","year":"2015","yearsub":"2015"}
