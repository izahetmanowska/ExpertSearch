{"abstract":"Ny bog giver et skræmmende indblik i, hvordan teknologien stresser os i vores arbejdsliv samt gode råd til, hvordan virksomheder kan arbejde med at mindske medarbejdernes digitale stress.","author_count":3,"contributors":["Stana, Raluca Alexandra","Nicolajsen, Hanne Westh","Kickbusch, Jari"],"cuid":["S01-000.00-791573"],"filters":{"added":"2025-02","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"pop","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-RUC"]},"level3all":["DI-U-ITU","DI-U-RUC"]},"review":"und","rtype":["clu"],"sorti":"digital stress skal ikke fejes ind under gulvtæppet","src":["ruc"],"src-code":["DI-U-RUC"],"type":"dna","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://finans.dk/debat/ECE17718616/digital-stress-skal-ikke-fejes-ind-under-gulvtaeppet/","version":"Other Version"},"id":"S01-000.00-791573","ids":["ruc-bfd748c5-83fe-47c5-91ab-1566ea326dd3"],"lang":"Danish","level":"Popular","mra":["Science/Technology"],"noi":["Local-1-1-CF2368EFDF6A499380A80DE35A2AE545"],"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of People and Technology","Roskilde University, Department of People and Technology, Sustainable Digitalization"],"nora_code":"DI-U-RUC","used":1},{"affno":"2","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","country":"dk","fi