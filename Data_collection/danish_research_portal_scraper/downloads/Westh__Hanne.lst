h Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-4eb206f3-7de5-48e5-b45c-42a0d262a024"],"src":["ITU IT University of Copenhagen"],"title":"Pursuing Digitalization in the Public Sector through Collaborative Public-Private Agile Service Innovation","type":"Other-Unknown","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382444","year":"2017","yearsub":"2017"}
{"abstract":"Purpose. In Danish hospitals, the number of infections caused by vancomycin-resistant Enterococcus faecium (VRE faecium) has dramatically increased in recent years. Hospital disinfectants are essential in eliminating pathogenic microorganisms, and reduced susceptibility may contribute to hospital-associated infections. We have addressed whether clinical VRE faecium display decreased biocide susceptibility when compared to vancomycin-sensitive Enterococcus faecium (VSE faecium) isolates. Methodology. In total 12 VSE faecium and 37 VRE faecium isolates obtained from Danish hospitals over an extended time period were tested for susceptibility towards three commonly applied biocides, namely benzalkonium chloride, chlorhexidine and hydrogen peroxide. Results. For benzalkonium chloride, 89% of VRE faecium strains had a minimal inhibitory concentration (MIC) of 8mg l–1, whereas for VSE faecium, only 25% of the strains had an MIC of 8mgl–1. For chlorhexidine, the MIC of 95% of VRE faecium strains was 4 mgl–1 or higher, while only 33% of VSE faecium strains displayed MIC values at the same level. In contrast, both VRE and VSE faecium displayed equal susceptibility to hydrogen peroxide, but a higher minimal bactericidal concentration (MBC) was found for the former. The efflux activity was also assessed, and this was generally higher for the VRE faecium strains compared to VSE faecium. Conclusion. VRE faecium from Danish hospitals demonstrated decreased susceptibility towards benzalkonium chloride and chlorhexidine compared to VSE faecium, where the use of chlorhexidine is particularly heavy in the hospital environment. These findings suggest that biocide tolerance may characterize VRE faecium isolated in Danish hospitals.","author_count":9,"contributors":["Alotaibi, Sulaiman M.I.","Ayibiekea, Alafate","Pedersen, Annemette Frøling","Jakobsen, Lotte","Pinholt, Mette","Gumpert, Heidi","Hammerum, Anette M.","Westh, Henrik","Ingmer, Hanne"],"cuid":["S01-000.00-477619"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Benzalkonium chloride","Chlorhexidine","Enterococcus faecium","Nosocomial infection","VRE","VSE"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"susceptibility of vancomycin resistant and sensitive enterococcus faecium obtained from danish hospitals to benzalkonium chloride chlorhexidine and hydrogen eroxide biocides","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-477619","identifier":[{"id":"85037731167","type":"scopus"},{"id":"29134935","type":"pmid"}],"ids":["ku-8cc7e5f1-895c-40fe-b248-62f56241d5ca"],"keyword":["Benzalkonium chloride","Biocide tolerance","Chlorhexidine","Enterococcus faecium","Nosocomial infection","VRE","VSE"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-C250ED39248414DE21E98D72953654C3"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary and Animal Sciences, Food Safety and Zoonoses"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"ssi statens serum institut","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-SSI","l3nn":"SSI Statens Serum Institut","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SSI Statens Serum Institut","namevar":["Statens Serum Institut"],"nora_code":"DI-GV-SSI","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Amager and Hvidovre"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","first":"Sulaiman M.I.","key":"alotaibipau","last":"Alotaibi","locid":"74667751-2a4e-41b8-97b0-4fae845cc8fd","name":"Alotaibi, Sulaiman M.I.","rank":1,"rolecode":"pau"},{"affno":"1","first":"Alafate","key":"ayibiekeapau","last":"Ayibiekea","name":"Ayibiekea, Alafate","rank":2,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Annemette Frøling","key":"pedersenpau","last":"Pedersen","locid":"e484ccd9-9e19-4c71-9a66-770817def72e","name":"Pedersen, Annemette Frøling","rank":3,"rolecode":"pau"},{"affno":"2","first":"Lotte","key":"jakobsenpau","last":"Jakobsen","name":"Jakobsen, Lotte","rank":4,"rolecode":"pau"},{"affno":"3","first":"Mette","key":"pinholtpau","last":"Pinholt","name":"Pinholt, Mette","rank":5,"rolecode":"pau"},{"affno":"3","first":"Heidi","key":"gumpertpau","last":"Gumpert","name":"Gumpert, Heidi","rank":6,"rolecode":"pau"},{"affno":"2","first":"Anette M.","key":"hammerumpau","last":"Hammerum","name":"Hammerum, Anette M.","rank":7,"rolecode":"pau"},{"affno":"1","first":"Henrik","key":"westhpau","last":"Westh","locid":"5ed71556-672c-4f57-95de-3abba6b821ea","name":"Westh, Henrik","rank":8,"rolecode":"pau"},{"affno":"1","first":"Hanne","key":"ingmerpau","last":"Ingmer","locid":"abe2cd31-84e7-4f06-81a3-33e08bf93b8f","name":"Ingmer, Hanne","orcid":"0000-0002-8350-5631","rank":9,"rolecode":"pau"}],"pmid":["29134935"],"pub":{"doi":"10.1099/jmm.0.000642","issn":["00222615","14735644"],"issn_org":["00222615"],"issue":"12","journal":"Journal of Medical Microbiology","pages":"1744-1751","paperid":"000642","status":"p","title":"Journal of Medi