y":"catalanmorenopau","last":"Catalan Moreno","locid":"b3b235c0-6ed1-44f1-86f4-7f589b7de76e","name":"Catalan Moreno, Arancha","rank":4,"rolecode":"pau"},{"affno":"","first":"Jesper Boye","key":"nielsenpau","last":"Nielsen","locid":"be47b1a6-e531-464c-b0c8-3a2e54d7fa93","name":"Nielsen, Jesper Boye","rank":5,"rolecode":"pau"},{"affno":"1","first":"Henrik T.","key":"westhpau","last":"Westh","locid":"5ed71556-672c-4f57-95de-3abba6b821ea","name":"Westh, Henrik","name_org":"Westh, Henrik T.","rank":6,"rolecode":"pau"},{"affno":"2","first":"José R.","key":"penadéspau","last":"Penadés","name":"Penadés, José R.","rank":7,"rolecode":"pau"},{"affno":"1","first":"Hanne","key":"ingmerpau","last":"Ingmer","locid":"abe2cd31-84e7-4f06-81a3-33e08bf93b8f","name":"Ingmer, Hanne","orcid":"0000-0002-8350-5631","rank":8,"rolecode":"pau"}],"pmid":["27819286"],"pub":{"doi":"10.1038/ncomms13333","issn":["20411723"],"journal":"Nature Communications","paperid":"13333","status":"p","title":"Nature Communications","volume":"7"},"review":"Peer Reviewed","scoID":["2-s2.0-84994504484"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-8fcf1746-91ce-4580-8dda-9709dbda3f87"],"src":["KU University of Copenhagen"],"title":"Bacterial viruses enable their host to acquire antibiotic resistance genes from neighbouring cells","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-479392","year":"2016","yearsub":"2016"}
{"abstract":"This article discusses different ways in which users may be involved in the ideation phase of service innovation and the results and limitations of such involvement. The study compares the use of a blog and two differently setup future workshops (one with users only and the other with a mix of users and employees) in a library. The authors' study shows that the blog is efficient in giving the users voice whereas the mixed workshop method (involving users and employees) is particularly efficient at qualifying and further developing ideas. The findings suggest that methods for involving users in ideation should be carefully selected and combined to achieve optimum benefits and avoid potential disadvantages.","author_count":3,"contributors":["Nicolaisen, Hanne Westh","Sørensen, Flemming","Scupola, Ada"],"cuid":["S01-000.00-571710"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-RUC"]},"level3all":["DI-U-ITU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"the potential of workshops versus blogs for user involvement in service innovation","src":["ruc"],"src-code":["DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-571710","ids":["ruc-e97fafb1-7c49-48bf-adc0-138289a4a1da"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-3-28797039D50053887BC2A26A84134BC1"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of Social Sciences and Business","Roskilde University, Department of Social Sciences and Business, Innovation in services and experiences"],"nora_code":"DI-U-RUC","used":1}],"person":[{"affno":"1","first":"Hanne Westh","key":"nicolaisenpau","last":"Nicolaisen","name":"Nicolaisen, Hanne Westh","rank":1,"rolecode":"pau"},{"affno":"2","country":"dk","first":"Flemming","key":"sørensenpau","last":"Sørensen","locid":"363d85fe-c35b-4b16-879f-97ecf81fd285","name":"Sørensen, Flemming","orcid":"0000-0001-5972-2188","rank":2,"rolecode":"pau"},{"affno":"2","country":"dk","first":"Ada","key":"scupolapau","last":"Scupola","locid":"31120161-69fe-4720-8fd6-46383ba639df","name":"Scupola, Ada","orcid":"0000-0002-3537-7639","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.4018/ijesma.2016100101","issn":["1941627X","19416288"],"issn_org":["1941627X"],"issue":"4","journal":"International Journal of e-Services and Mobile Applications","status":"p","title":"International Journal of e-Services and Mobile Applications","volume":"8"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Roskilde University","Universities"],"PST":["Published"]},"sid":["ruc-e97fafb1-7c49-48bf-adc0-138289a4a1da"],"src":["RUC Roskilde University"],"title":"The potential of workshops versus blogs for user involvement in service innovation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-571710","year":"2016","yearsub":"2016"}
{"abstract":"In this paper we discuss how users may be involved in the ideation phase of innovation. The study compares the use of a blog and three future workshops (students, employees and a mix of the two) in a library. Our study shows that the blog is efficient in giving the users voice whereas the mixed workshop method (involving users and employees) is especially good at qualifying and further developing ideas. The findings suggest that methods for involving users in ideation should be carefully selected and combined to achieve optimum benefits and avoid potential disadvantages.","author_count":7,"contributors":["Nicolajsen, Hanne Westh","Scupola, Ada","Sørensen, Flemming"],"cuid":["S01-000.00-564306"],"event":{"end":"2015-09-12","place":"Copenhagen, dk","start":"2015-09-10","title":"RESER2015","year":"2015"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-RUC"]},"level3all":["DI-U-ITU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"comparing methods for involving users in ideation the use of future workshops and blogs in library innovation","src":["ruc"],"src-code":["DI-U-RUC"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/56551700/RESER2015_Proceedings_3_.pdf","version":"Published Version"},"id":"S01-000.00-564306","ids":["ruc-7c00ea4b-064d-40ae-8fc2-67286cdc20a5"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-7473C8EFE396E25FA748C782260367AB"],"oa_link":[{"access":"oa","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/56551700/RESER2015_Proceedings_3_.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenh