"first":"Nubia","key":"muñozpau","last":"Muñoz","name":"Muñoz, Nubia","rank":17,"rolecode":"pau"},{"affno":"","first":"Jorma","key":"paavonenpau","last":"Paavonen","name":"Paavonen, Jorma","rank":18,"rolecode":"pau"},{"affno":"","first":"Punnee","key":"pitisuttihumpau","last":"Pitisuttihum","name":"Pitisuttihum, Punnee","rank":19,"rolecode":"pau"},{"affno":"","first":"Brigitte M","key":"ronnettpau","last":"Ronnett","name":"Ronnett, Brigitte M","rank":20,"rolecode":"pau"},{"affno":"","first":"Marc","key":"stebenpau","last":"Steben","name":"Steben, Marc","rank":21,"rolecode":"pau"},{"affno":"","first":"Mark H","key":"stolerpau","last":"Stoler","name":"Stoler, Mark H","rank":22,"rolecode":"pau"},{"affno":"","first":"Cosette M","key":"wheelerpau","last":"Wheeler","name":"Wheeler, Cosette M","rank":23,"rolecode":"pau"},{"affno":"","first":"Dorothy J","key":"wileypau","last":"Wiley","name":"Wiley, Dorothy J","rank":24,"rolecode":"pau"},{"affno":"","first":"Gonzalo","key":"perezpau","last":"Perez","name":"Perez, Gonzalo","rank":25,"rolecode":"pau"},{"affno":"","first":"Alfred J","key":"saahpau","last":"Saah","name":"Saah, Alfred J","rank":26,"rolecode":"pau"},{"affno":"","first":"Alain","key":"luxembourgpau","last":"Luxembourg","name":"Luxembourg, Alain","rank":27,"rolecode":"pau"},{"affno":"","first":"Se","key":"lipau","last":"Li","name":"Li, Se","rank":28,"rolecode":"pau"},{"affno":"","first":"Mark J","key":"dinubilepau","last":"DiNubile","name":"DiNubile, Mark J","rank":29,"rolecode":"pau"},{"affno":"","first":"Monika","key":"wagnerpau","last":"Wagner","name":"Wagner, Monika","rank":30,"rolecode":"pau"},{"affno":"","first":"Christine","key":"velicerpau","last":"Velicer","name":"Velicer, Christine","rank":31,"rolecode":"pau"}],"pmid":["29995724"],"pub":{"doi":"10.1097/aog.0000000000002736","issn":["00297844","1873233X"],"issn_org":["00297844"],"issue":"2","journal":"Obstetrics and Gynecology","pages":"261-270","status":"p","title":"Obstetrics and Gynecology","volume":"13