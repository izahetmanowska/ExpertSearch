blished"]},"sid":["dtu-9feeed21-7b5f-4d77-b783-eca0d2666bd8","ku-e1e930d6-3670-4f86-884b-1dafdb69bfcc"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Adaptive Out-Orientations with Applications","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-091.11-735409","year":"2024","yearsub":"2024"}
{"abstract":"Inspired by the seminal result that a graph and an associated rotation system uniquely determine the topology of a closed manifold, we propose a combinatorial method for reconstruction of surfaces from points. Our method constructs a spanning tree and a rotation system. Since the tree is trivially a planar graph, its rotation system determines a genus zero surface with a single face which we proceed to incrementally refine by inserting edges to split faces. In order to raise the genus, special handles are added in a later stage by inserting edges between different faces and thus merging them. We apply our method to a wide range of input point clouds in order to investigate its effectiveness, and we compare our method to several other surface reconstruction methods. It turns out that our approach has two specific benefits over these other methods. First, the output mesh preserves the most information from the input point cloud. Second, our method provides control over the topology of the reconstructed surface. Code is available on https://github.com/cuirq3/RsR.","author_count":5,"contributors":["Cui, Ruiqi","Gæde, Emil Toftegaard","Rotenberg, Eva","Kobbelt, Leif","Bærentzen, Jakob Andreas"],"cuid":["S01-000.00-776040"],"filters":{"added":"2025-01","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","RWTH Aachen University"],"keyword":["Computing methodologies"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"surface reconstruction using rotation systems","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1145/3687956","version":"Published Version"},"id":"S01-000.00-776040","identifier":[{"id":"85210148105","type":"scopus"}],"ids":["dtu-c898f920-078b-42b5-b4bd-5e6b07e5021b"],"keyword":["Computing methodologies","Mesh models"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-4B98C6B918F439C58028C03479EE17AF"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1145/3687956","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/381093040/3687956.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Applied Mathematics and Computer Science","Technical University of Denmark, Department of Applied Mathematics and Computer Science, Visual Computing"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"de","key":"rwth aachen university","loc":["Germany","Europe, EU","OECD"],"name":"RWTH Aachen University","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Ruiqi","key":"cuipau","last":"Cui","locid":"17d8a4a0-946a-4a95-a883-6dabf7844c2c","name":"Cui, Ruiqi","orcid":"0000-0003-1993-5036","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Emil Toftegaard","key":"gædepau","last":"Gæde","locid":"065bac78-f781-460f-9046-441492e45e2d","name":"Gæde, Emil Toftegaard","orcid":"0009-0001-9462-6359","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Eva","key":"rotenbergpau","last":"Rotenberg","locid":"1a970eb9-57c6-4f5f-a453-117cbc7705ba","name":"Rotenberg, Eva","orcid":"0000-0001-5853-7909","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Leif","key":"kobbeltpau","last":"Kobbelt","name":"Kobbelt, Leif","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"J. Andreas","key":"bærentzenpau","last":"Bærentzen","locid":"f0d1a57d-f173-4c59-87ad-b554b3678a8c","name":"Bærentzen, Jakob Andreas","name_org":"Bærentzen, J. Andreas","orcid":"0000-0003-2583-0660","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1145/3687956","issn":["07300301","15577368"],"issn_org":["07300301"],"issue":"6","journal":"ACM Transactions on Graphics","paperid":"190","publisher":"Association for Computing Machinery","status":"p","title":"ACM Transactions on Graphics","volume":"43"},"review":"Peer Reviewed","scoID":["2-s2.0-85210148105"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-c898f920-078b-42b5-b4bd-5e6b07e5021b"],"src":["DTU Technical University of Denmark"],"title":"Surface Reconstruction Using Rotation Systems","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-776040","year":"2024","yearsub":"2024"}
{"abstract":"We study the edge-colouring problem, and give efficient algorithms where the number of colours is parameterised by the graph’s arboricity, α. In a dynamic graph, subject to insertions and deletions, we give a deterministic algorithm that updates a proper Δ + O(α) edge colouring in poly(log n) amortized time. Our algorithm is fully adaptive to the current value of the maximum degree and arboricity. In this fully-dynamic setting, the state-of-the-art edge-colouring algorithms are either a randomised algorithm using (1 + ε)Δ colours in poly(log n, ε^{-1}) time per update, or the naive greedy algorithm which is a deterministic 2Δ -1 edge colouring with log(Δ) update time. Compared to the (1+ε)Δ algorithm, our algorithm is deterministic and asymptotically faster, and when α is sufficiently small compared to Δ, it even uses fewer colours. In particular, ours is the first Δ+O(1) edge-colouring algorithm for dynamic forests, and dynamic planar graphs, with polylogarithmic update time. Additionally, in the static setting, we show that we can find a proper edge colouring with Δ + 2α colours in O(mlog n) time. Moreover, the colouring returned by our algorithm has the following local property: every edge uv is coloured with a colour in {1, max{deg(u), deg(v)} + 2α}. The time bound matches that of the greedy algorithm that computes a 2Δ-1 colouring of the graph’s edges, and improves the number of colours when α is sufficiently small compared to Δ.","author_count":3,"contributors":["Christiansen, Aleksander Bjørn Grodt","Rotenberg, Eva","Vlieghe, Juliette"],"cuid":["S01-000.00-747056"],"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Amortized analysis","Arboricity","Dynamic algorithms","Edge colouring"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"sparsity parameterised dynamic edge colouring","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.4230/LIPIcs.SWAT.2024.20","version":"Published Version"},"id":"S01-000.00-747056","identifier":[{"id":"85195389079","type":"scopus"}],"ids":["dtu-d7c758c3-c7f3-4693-bb3b-aeedf320f006"],"keyword":["Amortized analysis","Arboricity","Dynamic algorithms","Edge colouring","Hierarchical partition"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-2C41DD7B0B27FAD2646DE20940932FE6"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.4230/LIPIcs.SWAT.2024.20","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/364227614/LIPIcs.SWAT.2024.20.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Applied Mathematics and Computer Science","Technical University of Denmark, Department of Applied Mathematics and Computer Science, Algorithms, Logic and Graphs"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Aleksander B. G.","key":"christiansenpau","last":"Christiansen","locid":"c49eca57-bd53-46e3-886a-700b7f04954d","name":"Christiansen, Aleksander Bjørn Grodt","name_org":"Christiansen, Aleksander B. G.","orcid":"0000-0002-9486-9115","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Eva","key":"rotenbergpau","last":"Rotenberg","locid":"1a970eb9-57c6-4f5f-a453-117cbc7705ba","name":"Rotenberg, Eva","orcid":"0000-0001-5853-7909","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Juliette","key":"vlieghepau","last":"Vlieghe","locid":"5c260228-45b7-4660-91c7-8dfde555b947","name":"Vlieghe, Juliette","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.4230/lipics.swat.2024.20","isbn":["9783959773188"],"publisher":"Schloss Dagstuhl - Leibniz-Zentrum für Informatik","status":"p","title":"Proceedings of the 19th Scandinavian Symposium and Workshops on Algorithm Theory (SWAT 2024)","volume":"294"},"review":"Peer Reviewed","scoID":["2-s2.0-85195389079"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-d7c758c3-c7f3-4693-bb3b-aeedf320f006"],"src":["DTU Technical University of Denmark"],"title":"Sparsity-Parameterised Dynamic Edge Colouring","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-747056","year":"2024","yearsub":"2024"}
{"abstract":"A classical problem in computational geometry and graph algorithms is: given a dynamic set S of geometric shapes in the plane, efficiently maintain the connectivity of the intersection graph of S. Previous papers studied the setting where, before the updates, the data structure receives some parameter P. Then, updates could insert and delete disks as long as at all times the disks have a diameter that lies in a fixed range [1/P , 1]. As a consequence of that prerequisite, the aspect ratio ψ (i.e. the ratio between the largest and smallest diameter) of the disks would at all times satisfy ψ ≤ P. The state-of-the-art for storing disks in a dynamic connectivity data structure is a data structure that uses O(P n) space and that has amortized O(P log4 n) expected amortized update time. Connectivity queries between disks are supported in O(log n/ log log n) time. In the dynamic setting, one wishes for a more flexible data structure in which disks of any diameter may arrive and leave, independent of their diameter, changing the aspect ratio freely. Ideally, the aspect ratio should merely be part of the analysis. We restrict our attention to axis-aligned squares, and study fully-dynamic square intersection graph connectivity. Our result is fully-adaptive to the aspect ratio, spending time proportional to the current aspect ratio ψ, as opposed to some previously given maximum P. Our focus on squares allows us to simplify and streamline the connectivity pipeline from previous work. When n is the number of squares and ψ is the aspect ratio after insertion (or before deletion), our data structure answers connectivity queries in O(log n/ log log n) time. We can update connectivity information in O(ψ log4 n + log6 n) amortized time. We also improve space usage from O(P · n log n) to O(n log3 n log ψ) – while generalizing to a fully-adaptive aspect ratio – which yields a space usage that is near-linear in n for any polynomially bounded ψ.","author_count":4,"contributors":["van der Hoog, Ivor","Nusser, André","Rotenberg, Eva","Staals, Frank"],"cuid":["S01-000.00-764200"],"event":{"end":"2024-08-30","place":"Bratislava, sk","start":"2024-08-26","title":"49th International Symposium on Mathematical Foundations of Computer Science","year":"2024"},"filters":{"added":"2024-11","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["France","Netherlands"],"glorg":["All Global Affiliations","CNRS","Utrecht University"],"keyword":["Computational geometry","Data structures","Planar geometry"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"fully adaptive dynamic connectivity of square intersection graphs","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.4230/LIPIcs.MFCS.2024.63","version":"Published Version"},"id":"S01-000.00-764200","identifier":[{"id":"85203374225","type":"scopus"}],"ids":["dtu-4d91d716-66c8-432a-b252-ae2be4d15016"],"keyword":["Computational geometry","Data structures","Fully-dynamic algorithms","Geometric intersection graphs","Planar geometry"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-DA7639270F002DE75152C3539C9F01D3"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.4230/LIPIcs.MFCS.2024.63","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/377450905/LIPIcs.MFCS.2024.63.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Applied Mathematics and Computer Science","Technical University of Denmark, Department of Applied Mathematics and Computer Science, Algorithms, Logic and Graphs"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"fr","key":"cnrs","loc":["France","Europe, EU","OECD"],"name":"CNRS","used":1},{"affno":"3","country":"nl","key":"utrecht university","loc":["Netherlands","Europe, EU","OECD"],"name":"Utrecht University","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Ivor","key":"vanderhoogpau","last":"van der Hoog","locid":"572104ae-4bbf-426e-aebd-3455726726de","name":"van der Hoog, Ivor","orcid":"0009-0006-2624-0231","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"André","key":"nusserpau","last":"Nusser","name":"Nusser, André","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Eva","key":"rotenbergpau","last":"Rotenberg","locid":"1a970eb9-57c6-4f5f-a453-117cbc7705ba","name":"Rotenberg, Eva","orcid":"0000-0001-5853-7909","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Frank","key":"staalspau","last":"Staals","name":"Staals, Frank","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.4230/lipics.mfcs.2024.63","issn":["18688969"],"journal":"Leibniz International Proceedings in Informatics","paperid":"63","publisher":"Schloss Dagstuhl- Leibniz-Zentrum fur Informatik GmbH, Dagstuhl Publishing","status":"p","title":"Leibniz International Proceedings in Informatics","title_org":"Leibniz International Proceedings in Informatics, LIPIcs","volume":"306"},"review":"Peer Reviewed","scoID":["2-s2.0-85203374225"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-4d91d716-66c8-432a-b252-ae2be4d15016"],"src":["DTU Technical University of Denmark"],"title":"Fully-Adaptive Dynamic Connectivity of Square Intersection Graphs","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-764200","year":"2024","yearsub":"2024"}
{"abstract":"In Gapped String Indexing, the goal is to compactly represent a string S of length n such that for any query consisting of two strings P₁ and P₂, called patterns, and an integer interval [α, β], called gap range, we can quickly find occurrences of P₁ and P₂ in S with distance in [α, β]. Gapped String Indexing is a central problem in computational biology and text mining and has thus received significant research interest, including parameterized and heuristic approaches. Despite this interest, the best-known time-space trade-offs for Gapped String Indexing are the straightforward (n) space and (n+ occ) query time or Ω(n²) space and Õ(|P₁| + |P₂| + occ) query time. We break through this barrier obtaining the first interesting trade-offs with polynomially subquadratic space and polynomially sublinear query time. In particular, we show that, for every 0 ≤ δ ≤ 1, there is a data structure for Gapped String Indexing with either Õ(n2-δ/3) or Õ(n3-2δ) space and Õ(|P₁| + |P₂| + nδ⋅ (occ+1)) query time, where occ is the number of reported occurrences. As a new fundamental tool towards obtaining our main result, we introduce the Shifted Set Intersection problem: preprocess a collection of sets S₁, …, Sk of integers such that for any query consisting of three integers i,j,s, we can quickly output YES if and only if there exist a ∈ Si and b ∈ Sj with a+s = b. We start by showing that the Shifted Set Intersection problem is equivalent to the indexing variant of 3SUM (3SUM Indexing) [Golovnev et al., STOC 2020]. We then give a data structure for Shifted Set Intersection with gaps, which entails a solution to the Gapped String Indexing problem. Furthermore, we enhance our data structure for deciding Shifted Set Intersection, so that we can support the reporting variant of the problem, i.e., outputting all certificates in the affirmative case. Via the obtained equivalence to 3SUM Indexing, we thus give new improved data structures for the reporting variant of 3SUM Indexing, and we show how this improves upon the state-of-the-art solution for Jumbled Indexing [Chan and Lewenstein, STOC 2015] for any alphabet of constant size σ > 5.","author_count":6,"contributors":["Bille, Philip","Gørtz, Inge Li","Lewenstein, Moshe","Pissis, Solon P.","Rotenberg, Eva","Steiner, Teresa Anna"],"cuid":["S01-000.00-729582"],"event":{"end":"2024-04-14","place":"Clermont-Ferrand, fr","start":"2024-03-12","title":"41st International Symposium on Theoretical Aspects of Computer Science","year":"2024"},"filters":{"added":"2024-05","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, Middle East","Europe, EU","OECD"],"country":["Israel","Netherlands"],"glorg":["All Global Affiliations","Bar-Ilan University","Vrije Universiteit Amsterdam"],"keyword":["Data structures","String indexing","Two patterns"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"gapped string indexing in subquadratic space and sublinear query time","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.4230/LIPIcs.STACS.2024.16","version":"Published Version"},"id":"S01-000.00-729582","identifier":[{"id":"85187796283","type":"scopus"}],"ids":["dtu-56bdb0d0-8bc2-4253-9338-eebae464429f"],"keyword":["Data structures","Indexing with gaps","String indexing","Two patterns"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-DDE59A0C7BBD1A8B731C4F404CC4F07C"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/357079513/LIPIcs.STACS.2024.16.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.4230/LIPIcs.STACS.2024.16","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Applied Mathematics and Computer Science","Technical University of Denmark, Department of Applied Mathematics and Computer Science, Algorithms, Logic and Graphs"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"il","key":"bar ilan university","loc":["Israel","Asia, Middle East","OECD"],"name":"Bar-Ilan University","used":1},{"affno":"3","country":"nl","key":"vrije universiteit amsterdam","loc":["Netherlands","Europe, EU","OECD"],"name":"Vrije Universiteit Amsterdam","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Philip","key":"billepau","last":"Bille","locid":"81ad6edf-aa11-47bc-adaf-227fe7e6963e","name":"Bille, Philip","orcid":"0000-0002-1120-5154","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Inge Li","key":"gørtzpau","last":"Gørtz","locid":"08da98e0-b1f4-492e-94e7-15083cc40701","name":"Gørtz, Inge Li","orcid":"0000-0002-8322-4952","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Moshe","key":"lewensteinpau","last":"Lewenstein","name":"Lewenstein, Moshe","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Solon P.","key":"pissispau","last":"Pissis","name":"Pissis, Solon P.","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Eva","key":"rotenbergpau","last":"Rotenberg","locid":"1a970eb9-57c6-4f5f-a453-117cbc7705ba","name":"Rotenberg, Eva","orcid":"0000-0001-5853-7909","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Teresa Anna","key":"steinerpau","last":"Steiner","locid":"229ad7cd-2c7d-417c-8333-01832e47680e","name":"Steiner, Teresa Anna","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.4230/lipics.stacs.2024.16","isbn":["9783959773119"],"publisher":"Schloss Dagstuhl - Leibniz-Zentrum für Informatik","status":"p","title":"Proceedings of the 41st International Symposium on Theoretical Aspects of Computer Science (STACS 2024)","volume":"289"},"review":"Peer Reviewed","scoID":["2-s2.0-85187796283"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-56bdb0d0-8bc2-4253-9338-eebae464429f"],"src":["DTU Technical University of Denmark"],"title":"Gapped String Indexing in Subquadratic Space and Sublinear Query Time","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-729582","year":"2024","yearsub":"2024"}
{"abstract":"The convex hull of a data set P is the smallest convex set that contains P. A dynamic data set is one where points are inserted and deleted. In this work, we present a new data structure for convex hull, that allows for efficient dynamic updates, in theory and practice. In a dynamic convex hull implementation, the following traits are desirable: (1) algorithms for efficiently answering queries as to whether a specified point is inside or outside the hull, (2) adhering to geometric robustness, and (3) algorithmic simplicity. Furthermore, a specific but well-motivated type of two-dimensional data is rank-based data. Here, the input is a set of real-valued numbers Y where for any number y ∈ Y its rank is its index in Y 's sorted order. Each value in Y can be mapped to a point (rank, value) to obtain a two-dimensional point set. Note that for a single update, a linear number of (rank, value)-pairs may change; posing a challenge for dynamic algorithms. It is desirable for a dynamic convex hull implementation to also (4) accommodate rank-based data. In this work, we give an efficient, geometrically robust, dynamic convex hull algorithm, that facilitates queries to whether a point is internal. Furthermore, our construction can be used to efficiently update the convex hull of rank-ordered data, when the real-valued point set is subject to insertions and deletions. Our improved solution is based on an algorithmic simplification of the classical convex hull data structure by Overmars and van Leeuwen [STOC'80], combined with new algorithmic insights. Our theoretical guarantees on the update time match those of Overmars and van Leeuwen, namely O(log2 |P|), while we allow a wider range of functionalities (including rank-based data). Our algorithmic simplification includes simplifying an 11-case check down to a 3-case check that can be written in 20 lines of easily readable C-code. We extend our solution to provide a trade-off between theoretical guarantees and the practical performance of our algorithm. We test and compare our solutions extensively on inputs that were generated randomly or adversarially, including benchmarking datasets from the literature.","author_count":5,"contributors":["Gæde, Emil Toftegaard","Gørtz, Inge Li","van der Hoog, Ivor","Krogh, Christoffer","Rotenberg, Eva"],"cuid":["S01-000.00-729995"],"event":{"end":"2024-01-08","place":"Alexandria, us","start":"2024-01-07","title":"2024 SIAM Symposium on Algorithm Engineering and Experiments","year":"2024"},"filters":{"added":"2024-05","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"simple and robust dynamic two dimensional convex hull","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85183890550","version":"Other Version"},"id":"S01-000.00-729995","identifier":[{"id":"85183890550","type":"scopus"}],"ids":["dtu-ce001032-eea2-4386-9671-ca7d940e8cd8"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-FEE681ABB600F3FB33938B076176A87A"],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Applied Mathematics and Computer Science","Technical University of Denmark, Department of Applied Mathematics and Computer Science, Algorithms, Logic and Graphs"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Emil Toftegaard","key":"gædepau","last":"Gæde","locid":"065bac78-f781-460f-9046-441492e45e2d","name":"Gæde, Emil Toftegaard","orcid":"0009-0001-9462-6359","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Inge Li","key":"gørtzpau","last":"Gørtz","locid":"08da98e0-b1f4-492e-94e7-15083cc40701","name":"Gørtz, Inge Li","orcid":"0000-0002-8322-4952","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ivor","key":"vanderhoogpau","last":"Van Der Hoog","locid":"572104ae-4bbf-426e-aebd-3455726726de","name":"van der Hoog, Ivor","name_org":"Van Der Hoog, Ivor","orcid":"0009-0006-2624-0231","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Christoffer","key":"kroghpau","last":"Krogh","locid":"04d2017d-a94c-47e8-a84a-3732b7fe4186","name":"Krogh, Christoffer","orcid":"0009-0007-1873-4271","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Eva","key":"rotenbergpau","last":"Rotenberg","locid":"1a970eb9-57c6-4f5f-a453-117cbc7705ba","name":"Rotenberg, Eva","orcid":"0000-0001-5853-7909","rank":5,"rolecode":"pau"}],"pub":{"isbn":["9781611977929"],"pages":"144-156","publisher":"Society for Industrial and Applied Mathematics","status":"p","title":"Proceedings of 2024 SIAM Symposium on Algorithm Engineering and Experiments"},"review":"Peer Reviewed","scoID":["2-s2.0-85183890550"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-ce001032-eea2-4386-9671-ca7d940e8cd8"],"src":["DTU Technical University of Denmark"],"title":"Simple and Robust Dynamic Two-Dimensional Convex Hull","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-729995","year":"2024","yearsub":"2024"}
{"abstract":"We show that every planar triangulation on n > 10 vertices has a dominating set of size 2n/7 = n/3.5. This approaches the n/4 bound conjectured by Matheson and Tarjan [12], and improves significantly on the previous best bound of 17n/53 ≈ n/3.117 by Špacapan [18]. From our proof it follows that every 3-connected n-vertex near-triangulation (except for 3 sporadic examples) has a dominating set of size n/3.5. On the other hand, for 3-connected near-triangulations, we show a lower bound of 3(n−1)/11 ≈ n/3.666, demonstrating that the conjecture by Matheson and Tarjan [12] cannot be strengthened to 3-connected near-triangulations. Our proof uses a penalty function that, aside from the number of vertices, penalises vertices of degree 2 and specific constellations of neighbours of degree 3 along the boundary of the outer face. To facilitate induction, we not only consider near-triangulations, but a wider class of graphs (skeletal triangulations), allowing us to delete vertices more freely. Our main technical contribution is a set of attachments, that are small graphs we inductively attach to our graph, in order both to remember whether existing vertices are already dominated, and that serve as a tool in a divide and conquer approach. Along with a well-chosen potential function, we thus both remove and add vertices during the induction proof. We complement our proof with a constructive algorithm that returns a dominating set of size ≤ 2n/7. Our algorithm has a quadratic running time.","author_count":3,"contributors":["Christiansen, Aleksander Bjørn Grodt","Rotenberg, Eva","Rutschmann, Daniel"],"cuid":["S01-000.00-730008"],"event":{"end":"2024-01-10","place":"Alexandria, us","start":"2024-01-07","title":"2024 Annual ACM-SIAM Symposium on Discrete Algorithms","year":"2024"},"filters":{"added":"2024-05","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"triangulations admit dominating sets of size 000000000002 i n i 000000000007","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1137/1.9781611977912.47","version":"Published Version"},"id":"S01-000.00-730008","identifier":[{"id":"85188339073","type":"scopus"}],"ids":["dtu-d11b0268-afbd-47ce-b0ad-a5e6c89eca48"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-52E90C50044B1E256A2B4C4FADCF8416"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/356869036/1.9781611977912.47.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1137/1.9781611977912.47","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Applied Mathematics and Computer Science","Technical University of Denmark, Department of Applied Mathematics and Computer Science, Algorithms, Logic and Graphs"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Aleksander B.G.","key":"christiansenpau","last":"Christiansen","locid":"c49eca57-bd53-46e3-886a-700b7f04954d","name":"Christiansen, Aleksander Bjørn Grodt","name_org":"Christiansen, Aleksander B.G.","orcid":"0000-0002-9486-9115","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Eva","key":"rotenbergpau","last":"Rotenberg","locid":"1a970eb9-57c6-4f5f-a453-117cbc7705ba","name":"Rotenberg, Eva","orcid":"0000-0001-5853-7909","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Daniel","key":"rutschmannpau","last":"Rutschmann","locid":"11f18e5e-e42b-47ad-856a-e23469be187c","name":"Rutschmann, Daniel","orcid":"0009-0005-6838-2628","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1137/1.9781611977912.47","eisbn":["9781611977912"],"pages":"1194-1240","publisher":"Society for Industrial and Applied Mathematics","status":"p","title":"Proceedings of the 2024 Annual ACM-SIAM Symposium on Discrete Algorithms (SODA)"},"review":"Peer Reviewed","scoID":["2-s2.0-85188339073"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-d11b0268-afbd-47ce-b0ad-a5e6c89eca48"],"src":["DTU Technical University of Denmark"],"title":"Triangulations Admit Dominating Sets of Size 2<i>n</i>/7","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-730008","year":"2024","yearsub":"2024"}
{"abstract":"A directed graph G is upward planar if it admits a planar embedding where each edge is y-monotone. Unlike planarity testing, upward planarity testing is NP-hard except in restricted cases, such as when the graph has the single-source property (i.e., each connected component has one source). In this paper, we present a dynamic data structure for maintaining an upward combinatorial embedding →E (G) of a single-source upward planar graph subject to edge deletions, edge contractions, directed edge insertions across a face, and single-source-preserving vertex splits through specified corners (i.e., the gaps between pairs of consecutive edges that share a vertex and a face). We furthermore support changes to the embedding →E (G) in the form of subgraph flips that mirror or slide the placement of a subgraph that is connected to the rest of the graph via at most two vertices. Updates that are incompatible with the current upward planar embedding are identified and rejected. All update operations are supported as long as the graph remains upward planar. In addition, we support queries that can tell whether two vertices can be connected with a directed edge while the graph remains single-source (we call these uplinkability queries). If a pair of vertices are not uplinkable, we facilitate one-flip-linkable queries: These point to a flip that makes them uplinkable, if any such flip exists. We dynamically maintain a linear-size data structure on G which supports incidence queries between a vertex and a face, and uplinkability queries for vertex pairs. We support all updates and queries in O(log2n) worst-case time.","author_count":3,"contributors":["van der Hoog, Ivor","Parada, Irene","Rotenberg, Eva"],"cuid":["S01-000.00-764228"],"event":{"end":"2024-09-04","place":"London, gb","start":"2024-09-02","title":"32nd Annual European Symposium on Algorithms","year":"2024"},"filters":{"added":"2024-11","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Spain"],"glorg":["All Global Affiliations","Polytechnic University of Catalonia"],"keyword":["Computational geometry","Data structures","Dynamic graphs","Graph algorithms","Graph drawing"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"dynamic embeddings of dynamic single source upward planar graphs","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.4230/LIPIcs.ESA.2024.70","version":"Published Version"},"id":"S01-000.00-764228","identifier":[{"id":"85205687567","type":"scopus"}],"ids":["dtu-5fc46a6d-d054-4fef-9553-0c9f006399de"],"keyword":["Computational geometry","Data structures","Dynamic graphs","Graph algorithms","Graph drawing","Upward planarity"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-AAFFC782E77DC049D9903BAFF6314057"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/377544371/LIPIcs.ESA.2024.70.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.4230/LIPIcs.ESA.2024.70","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Applied Mathematics and Computer Science","Technical University of Denmark, Department of Applied Mathematics and Computer Science, Algorithms, Logic and Graphs"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"es","key":"polytechnic university of catalonia","loc":["Spain","Europe, EU","OECD"],"name":"Polytechnic University of Catalonia","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Ivor","key":"vanderhoogpau","last":"van der Hoog","locid":"572104ae-4bbf-426e-aebd-3455726726de","name":"van der Hoog, Ivor","orcid":"0009-0006-2624-0231","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Irene","key":"paradapau","last":"Parada","name":"Parada, Irene","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Eva","key":"rotenbergpau","last":"Rotenberg","locid":"1a970eb9-57c6-4f5f-a453-117cbc7705ba","name":"Rotenberg, Eva","orcid":"0000-0001-5853-7909","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.4230/lipics.esa.2024.70","issn":["18688969"],"journal":"Leibniz International Proceedings in Informatics","paperid":"70","publisher":"Schloss Dagstuhl- Leibniz-Zentrum fur Informatik GmbH, Dagstuhl Publishing","status":"p","title":"Leibniz International Proceedings in Informatics","title_org":"Leibniz International Proceedings in Informatics, LIPIcs","volume":"308"},"review":"Peer Reviewed","scoID":["2-s2.0-85205687567"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-5fc46a6d-d054-4fef-9553-0c9f006399de"],"src":["DTU Technical University of Denmark"],"title":"Dynamic Embeddings of Dynamic Single-Source Upward Planar Graphs","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-764228","year":"2024","yearsub":"2024"}
{"abstract":"Given a dynamic graph subject to edge insertions and deletions, we show how to update an implicit representation of a proper vertex colouring, such that colours of vertices are computable upon query time. We give a deterministic algorithm that uses O(α2) colours for a dynamic graph of arboricity α, and a randomised algorithm that uses O(min{α logα, α log log log n}) colours in the oblivious adversary model. Our deterministic algorithm has update- and query times polynomial in α and log n, and our randomised algorithm has amortised update- and query time that with high probability is polynomial in log n with no dependency on the arboricity. Thus, we improve the number of colours exponentially compared to the state-of-the art for implicit colouring, namely from O(2α) colours, and we approach the theoretical lower bound of Ω(α) for this arboricity-parameterised approach. Simultaneously, our randomised algorithm improves the update- and query time to run in time solely polynomial in log n with no dependency on α. Our algorithms are fully adaptive to the current value of the dynamic arboricity at query or update time.","author_count":5,"contributors":["Christiansen, Aleksander Bjørn Grodt","Nowicki, Krzysztof","Rotenberg, Eva"],"cuid":["S02-095.74-735382"],"event":{"end":"2023-06-23","place":"Orlando, us","start":"2023-06-20","title":"55th Annual ACM Symposium on Theory of Computing, STOC 2023","year":"2023"},"filters":{"added":"2023-07","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Arboricity","Dynamic algorithms","Graph colouring"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"improved dynamic colouring of sparse graphs","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dcp","type-grp":["all","pub"]}