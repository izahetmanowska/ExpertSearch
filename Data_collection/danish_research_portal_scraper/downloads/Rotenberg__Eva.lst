Algorithms, Logic and Graphs"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Eva","key":"rotenbergpau","last":"Rotenberg","locid":"1a970eb9-57c6-4f5f-a453-117cbc7705ba","name":"Rotenberg, Eva","orcid":"0000-0001-5853-7909","rank":1,"rolecode":"pau"}],"pub":{"doi":"10.4230/lipics.mfcs.2021.4","eisbn":["9783959772013"],"publisher":"Schloss Dagstuhl - Leibniz-Zentrum für Informatik","status":"p","title":"Proceedings of 46th International Symposium on Mathematical Foundations of Computer Science (MFCS 2021)","volume":"202"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-6c15a293-0dbb-4ee3-a6e0-80a921d77071"],"src":["DTU Technical University of Denmark"],"title":"On Dynamic Graphs","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-336862","year":"2021","yearsub":"2023"}
{"abstract":"We present a data structure that, given a graph G of n vertices and m edges, and a suitable pair of nested r-divisions of G, preprocesses G in O(m + n) time and handles any series of edge-deletions in O(m) total time while answering queries to pairwise biconnectivity in worst-case O(1) time. In case the vertices are not biconnected, the data structure can return a cutvertex separating them in worst-case O(1) time. As an immediate consequence, this gives optimal amortized decremental biconnectivity, 2-edge connectivity, and connectivity for large classes of graphs, including planar graphs and other minor free graphs.","author_count":4,"contributors":["Holm, Jacob","Rotenberg, Eva"],"cuid":["S02-083.67-033267"],"event":{"acronym":"STACS","end":"2021-03-19","place":"Virtual, Saarbrucken, de","start":"2021-03-16","title":"38th International Symposium on Theoretical Aspects of Computer Science, STACS 2021","year":"2021"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["2 connectivity","Dynamic graphs","Graph minors","Graph separators","R divisions"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"good i r i divisions imply optimal amortized decremental biconnectivity","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.4230/LIPIcs.STACS.2021.42","version":"Published Version"},"id":"S02-083.67-033267","identifier":[{"id":"000635691700042","type":"wos"},{"id":"85115247306","type":"scopus"}],"ids":["dtu-1f2fd1c6-b8f2-43f5-b9a6-632c1d694a79","ku-103e9717-9a11-4562-99ae-5a0c6aaca55f"],"keyword":["2-connectivity","Dynamic graphs","Graph minors","Graph separators","r-divisions"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-68AF6B524778325BCED0BB4BE4AE9AFE"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/246163664/LIPIcs_STACS_2021_42.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/298953676/LIPIcs_STACS_2021_42.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.4230/LIPIcs.STACS.2021.42","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Algorithms and Complexity"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Applied Mathematics and Computer Science","Technical University of Denmark, Department of Applied Mathematics and Computer Science, Algorithms and Logic"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","first":"Jacob","key":"holmpau","last":"Holm","locid":"b9128f70-a478-4df0-9f6b-cc665f65976c","name":"Holm, Jacob","orcid":"0000-0001-6997-9251","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Eva","key":"rotenbergpau","last":"Rotenberg","locid":"1a970eb9-57c6-4f5f-a453-117cbc7705ba","name":"Rotenberg, Eva","orcid":"0000-0001-5853-7909","rank":2,"rolecode":"pau"},{"affno":"","first":"Markus","key":"blaserpedh","last":"Blaser","name":"Blaser, Markus","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Benjamin","key":"monmegepedh","last":"Monmege","name":"Monmege, Benjamin","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.4230/lipics.stacs.2021.42","eisbn":["9783959771801"],"isbn":["9783959771801"],"issn":["18688969"],"pages":"1-18","publisher":"Schloss Dagstuhl- Leibniz-Zentrum fur Informatik GmbH, Dagstuhl Publishing","series":"Leibniz International Proceedings in Informatics, LIPIcs","status":"p","title":"38th International Symposium on Theoretical Aspects of Computer Science, STACS 2021"},"review":"Peer Reviewed","scoID":["2-s2.0-85115247306"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-1f2fd1c6-b8f2-43f5-b9a6-632c1d694a79","ku-103e9717-9a11-4562-99ae-5a0c6aaca55f"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Good <i>r</i>-Divisions Imply Optimal Amortized Decremental Biconnectivity","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-083.67-033267","year":"2021","yearsub":"2021"}
{"abstract":"We show that every labelled planar graph $G$ can be assigned a canonical embedding $\\phi(G)$, such that for any planar $G'$ that differs from $G$ by the insertion or deletion of one edge, the number of local changes to the combinatorial embedding needed to get from $\\phi(G)$ to $\\phi(G')$ is $O(\\log n)$. In contrast, there exist embedded graphs where $\\Omega(n)$ changes are necessary to accommodate one inserted edge. We provide a matching lower bound of $\\Omega(\\log n)$ local changes, and although our upper bound is worst-case, our lower bound hold in the amortized case as well. Our proof is based on BC trees and SPQR trees, and we develop \\emph{pre-split} variants of these for general graphs, based on a novel biased heavy-path decomposition, where the structural changes corresponding to edge insertions and deletions in the underlying graph consist of at most $O(\\log n)$ basic operations of a particularly simple form. As a secondary result, we show how to maintain the pre-split trees under edge insertions in the underlying graph deterministically in worst case $O(\\log^3 n)$ time. Using this, we obtain deterministic data structures for incremental planarity testing, incremental planar embedding, and incremental triconnectivity, that each have worst case $O(\\log^3 n)$ update and query time, answering an open question by La Poutr\\'e and Westbrook from 1998.","author_count":2,"contributors":["Holm, Jacob","Rotenberg, Eva"],"cuid":["S01-000.00-368142"],"event":{"end":"2020-01-08","place":"Salt Lake City, us","start":"2020-01-05","title":"ACM-SIAM Symposium on Discrete Algorithms","year":"2020"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"worst case polylog incremental spqr trees embeddings planarity and triconnectivity","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85084079597","version":"Other Version"},"id":"S01-000.00-368142","identifier":[{"id":"85084079597","type":"scopus"}],"ids":["dtu-d4de37bb-28da-465c-a665-2dd7af554f8f"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-4-CE63D237880DBCDA952788E4F3C99332"],"org":[{"affno":"1","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Applied Mathematics and Computer Science","Technical University of Denmark, Department of Applied Mathematics and Computer Science, Algorithms and Logic"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jacob","key":"holmpau","last":"Holm","name":"Holm, Jacob","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Eva","key":"rotenbergpau","last":"Rotenberg","locid":"1a970eb9-57c6-4f5f-a453-117cbc7705ba","name":"Rotenberg, Eva","orcid":"0000-0001-5853-7909","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1137/1.9781611975994.146","eisbn":["9781611975994"],"pages":"2378-2397","publisher":"Association for Computing Machinery","status":"p","title":"Proceedings of ACM-SIAM Symposium on Discrete Algorithms"},"review":"Peer Reviewed","scoID":["2-s2.0-85084079597"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-d4de37bb-28da-465c-a665-2dd7af554f8f"],"src":["DTU Technical University of Denmark"],"title":"Worst-Case Polylog Incremental SPQR-trees: Embeddings, Planarity, and Triconnectivity","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-368142","year":"2020","yearsub":"2020"}
{"abstract":"We consider the following game played in the Euclidean plane: There is any countable set of unit speed lions and one fast man who can run with speed 1 + epsilon for some value epsilon > 0 . Can the man survive? We answer the question in the affirmative for any epsilon > 0 .","author_count":4,"contributors":["Abrahamsen, Mikkel","Holm, Jacob","Rotenberg, Eva","Wulff-Nilsen, Christian"],"cuid":["S02-100.00-037015"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"escaping an infinitude of lions","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/245551811/2012.11181.pdf","version":"Authors Final Version"},"id":"S02-100.00-037015","identifier":[{"id":"85100556398","type":"scopus"},{"id":"000599815500002","type":"wos"}],"ids":["dtu-c346c632-c4aa-45b2-8716-e1f9bce263be","ku-00515bb4-38ee-455d-8684-5903b0ed6f07"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-DCDD8B6B9903ABA7C15835AF468CFB32"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/287756877/2012.11181.pdf","version":"Authors Final Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/245551811/2012.11181.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Algorithms and Complexity"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Applied Mathematics and Computer Science","Technical University of Denmark, Department of Applied Mathematics and Computer Science, Algorithms and Logic"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","first":"Mikkel","key":"abrahamsenpau","last":"Abrahamsen","locid":"63596832-461f-409a-a2cc-81023b9b8e46","name":"Abrahamsen, Mikkel","orcid":"0000-0003-2734-4690","rank":1,"rolecode":"pau"},{"affno":"1","first":"Jacob","key":"holmpau","last":"Holm","locid":"b9128f70-a478-4df0-9f6b-cc665f65976c","name":"Holm, Jacob","orcid":"0000-0001-6997-9251","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Eva","key":"rotenbergpau","last":"Rotenberg","locid":"1a970eb9-57c6-4f5f-a453-117cbc7705ba","name":"Rotenberg, Eva","orcid":"0000-0001-5853-7909","rank":3,"rolecode":"pau"},{"affno":"1","first":"Christian","key":"wulffnilsenpau","last":"Wulff-nilsen","locid":"10a26f7c-95c5-4716-ba80-32ad40ba4f07","name":"Wulff-Nilsen, Christian","name_org":"Wulff-nilsen, Christian","orcid":"0000-0002-3699-7821","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1080/00029890.2020.1820837","issn":["00029890","19300972"],"issn_org":["00029890"],"issue":"10","journal":"American Mathematical Monthly","pages":"880-896","status":"p","title":"American Mathematical Monthly","title_org":"The American Mathematical Monthly","volume":"127"},"review":"Peer Reviewed","scoID":["2-s2.0-85100556398"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-c346c632-c4aa-45b2-8716-e1f9bce263be","ku-00515bb4-38ee-455d-8684-5903b0ed6f07"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Escaping an Infinitude of Lions","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-037015","year":"2020","yearsub":2021}
{"abstract":"Given a string S of length n, its Lyndon array identifies for each suffix S[i..n] the next lexicographically smaller suffix S[j..n], i.e. the minimal index j > i with S[i..n] S[j..n]. Apart from its plain (n log2 n)-bit array representation, the Lyndon array can also be encoded as a succinct parentheses sequence that requires only 2n bits of space. While linear time construction algorithms for both representations exist, it has previously been unknown if the same time bound can be achieved with less than Ω(n lg n) bits of additional working space. We show that, in fact, o(n) additional bits are sufficient to compute the succinct 2n-bit version of the Lyndon array in linear time. For the plain (n log2 n)-bit version, we only need O(1) additional words to achieve linear time. Our space efficient construction algorithm makes the Lyndon array more accessible as a fundamental data structure in applications like full-text indexing.","author_count":10,"contributors":["Bille, Philip","Ellert, Jonas","Fischer, Johannes","Gørtz, Inge Li","Kurpicz, Florian","Ian Munro, J.","Rotenberg, Eva"],"cuid":["S01-000.00-346456"],"event":{"acronym":"ICALP","end":"2020-07-11","place":"Saarbrücken , de","start":"2020-07-08","title":"47<sup>th</sup> International Colloquium on Automata, Languages, and Programming","year":"2020"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Europe, EU","OECD"],"country":["Canada","Germany"],"glorg":["All Global Affiliations","TU Dortmund University","University of Waterloo"],"keyword":["String algorithms","Succinct data structures"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"space efficient construction of lyndon arrays in linear time","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.4230/LIPIcs.ICALP.2020.14","version":"Published Version"},"funding_acknowledgement":["Funding Philip Bille: Supported by the Danish Research Council (DFF-9131-00069B). Inge Li Gørtz: Partially supported by the Danish Research Council (DFF-8021-002498). Florian Kurpicz: Supported by the German Research Foundation DFG SPP 1736 “Algorithms for Big Data”. J. Ian Munro: Supported by the Canada Research Chairs Programme and NSERC Discovery Grant 8237. Eva Rotenberg: Partially supported by Independent Research Fund Denmark grants 2020-2023 (9131-00044B), 2020-2023 (8021-002498), and 2018-2021 (8021-00249B)."],"id":"S01-000.00-346456","identifier":[{"id":"85089348230","type":"scopus"}],"ids":["dtu-8c5fe45d-e07f-4121-9fce-dca252cff6e8"],"keyword":["Lyndon array","Lyndon word","Nearest smaller suffixes","Nearest smaller values","String algorithms","String suffixes","Succinct data structures"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-5736A8FC34B683FB1D2C2A69E235FFFF"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.4230/LIPIcs.ICALP.2020.14","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/223503093/LIPIcs_ICALP_2020_14.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Applied Mathematics and Computer Science","Technical University of Denmark, Department of Applied Mathematics and Computer Science, Algorithms and Logic"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"de","key":"tu dortmund university","loc":["Germany","Europe, EU","OECD"],"name":"TU Dortmund University","used":1},{"affno":"3","country":"ca","key":"university of waterloo","loc":["Canada","America, North","OECD"],"name":"University of Waterloo","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Philip","key":"billepau","last":"Bille","locid":"81ad6edf-aa11-47bc-adaf-227fe7e6963e","name":"Bille, Philip","orcid":"0000-0002-1120-5154","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jonas","key":"ellertpau","last":"Ellert","name":"Ellert, Jonas","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Johannes","key":"fischerpau","last":"Fischer","name":"Fischer, Johannes","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Inge Li","key":"gørtzpau","last":"Gørtz","locid":"08da98e0-b1f4-492e-94e7-15083cc40701","name":"Gørtz, Inge Li","orcid":"0000-0002-8322-4952","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Florian","key":"kurpiczpau","last":"Kurpicz","name":"Kurpicz, Florian","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"J.","key":"ianmunropau","last":"Ian Munro","name":"Ian Munro, J.","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Eva","key":"rotenbergpau","last":"Rotenberg","locid":"1a970eb9-57c6-4f5f-a453-117cbc7705ba","name":"Rotenberg, Eva","orcid":"0000-0001-5853-7909","rank":7,"rolecode":"pau"},{"affno":"","first":"Artur","key":"czumajpedh","last":"Czumaj","name":"Czumaj, Artur","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Anuj","key":"dawarpedh","last":"Dawar","name":"Dawar, Anuj","rank":9,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Emanuela","key":"merellipedh","last":"Merelli","name":"Merelli, Emanuela","rank":10,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.4230/lipics.icalp.2020.14","eisbn":["9783959771382"],"issn":["18688969"],"publisher":"Schloss Dagstuhl- Leibniz-Zentrum fur Informatik GmbH, Dagstuhl Publishing","series":"Leibniz International Proceedings in Informatics, LIPIcs","status":"p","title":"Proceedings of 47<sup>th</sup> International Colloquium on Automata, Languages and Programming"},"review":"Peer Reviewed","scoID":["2-s2.0-85089348230"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-8c5fe45d-e07f-4121-9fce-dca252cff6e8"],"src":["DTU Technical University of Denmark"],"title":"Space efficient construction of Lyndon arrays in linear time","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-346456","year":"2020","yearsub":"2020"}
{"abstract":"Given a dynamic graph subject to insertions and deletions of edges, a natural question is whether the graph presently admits a planar embedding. We give a deterministic fully-dynamic algorithm for general graphs, running in amortized O(log3 n) time per edge insertion or deletion, that maintains a bit indicating whether or not the graph is presently planar. This is an exponential improvement over the previous best algorithm [Eppstein, Galil, Italiano, Spencer, 1996] which spends amortized O(gn) time per update.","author_count":7,"contributors":["Holm, Jacob","Rotenberg, Eva"],"cuid":["S02-094.98-033995"],"event":{"acronym":"STOC","end":"2020-06-26","place":"Chicago, us","start":"2020-06-22","title":"52nd Annual ACM SIGACT Symposium on Theory of Computing, STOC 2020","year":"2020"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Deterministic amortized upper bound","Dynamic graphs","Planarity"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"fully dynamic planarity testing in polylogarithmic time","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/220704127/1911.03449.pdf","version":"Authors Final Version"},"funding_acknowledgement":["∗Partially supported by the VILLUM Foundation grant 16582, Basic Algorithms Research Copenhagen (BARC). †Partially supported by Independent Research Fund Denmark grant “AlgoGraph” 2018-2021 (8021-00249B)."],"id":"S02-094.98-033995","identifier":[{"id":"85086766769","type":"scopus"}],"ids":["dtu-3ec2ea61-bde9-47f8-b53f-70aad0726520","ku-8c747694-c370-4f2f-843c-42410486eaed"],"keyword":["Deterministic amortized upper bound","Dynamic graphs","Planarity"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-AC7745F96568D9ECA5056005988DBF3A"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/287763144/1911.03449.pdf","version":"Authors Final Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/220704127/1911.03449.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Algorithms and Complexity"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Applied Mathematics and Computer Science","Technical University of Denmark, Department of Applied Mathematics and Computer Science, Algorithms and Logic"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","first":"Jacob","key":"holmjacobpau","last":"Holm","locid":"b9128f70-a478-4df0-9f6b-cc665f65976c","name":"Holm, Jacob","orcid":"0000-0001-6997-9251","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Eva","key":"rotenbergevapau","last":"Rotenberg","locid":"1a970eb9-57c6-4f5f-a453-117cbc7705ba","name":"Rotenberg, Eva","orcid":"0000-0001-5853-7909","rank":2,"rolecode":"pau"},{"affno":"","first":"Konstantin","key":"makarychevkonstantinpedh","last":"Makarychev","name":"Makarychev, Konstantin","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Yury","key":"makarychevyurypedh","last":"Makarychev","name":"Makarychev, Yury","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Madhur","key":"tulsianimadhurpedh","last":"Tulsiani","name":"Tulsiani, Madhur","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Gautam","key":"kamathgautampedh","last":"Kamath","name":"Kamath, Gautam","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Julia","key":"chuzhoyjuliapedh","last":"Chuzhoy","name":"Chuzhoy, Julia","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1145/3357713.3384249","eisbn":["9781450369794"],"pages":"167-180","publisher":"Association for Computing Machinery","status":"p","title":"STOC 2020 - Proceedings of the 52nd Annual ACM SIGACT Symposium on Theory of Computing"},"review":"Peer Reviewed","scoID":["2-s2.0-85086766769"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-3ec2ea61-bde9-47f8-b53f-70aad0726520","ku-8c747694-c370-4f2f-843c-42410486eaed"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Fully-dynamic planarity testing in polylogarithmic time","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-094.98-033995","year":"2020","yearsub":"2020"}
{"abstract":"We show that every labelled planar graph G can be assigned a canonical embedding φ(G), such that for any planar G’ that differs from G by the insertion or deletion of one edge, the number of local changes to the combinatorial embedding needed to get from φ(G) to φ(G’) is (log n). In contrast, there exist embedded graphs where Ω(n) changes are necessary to accommodate one inserted edge. We provide a matching lower bound of Ω(log n) local changes, and although our upper bound is worst-case, our lower bound hold in the amortized case as well. Our proof is based on BC trees and SPQR trees, and we develop pre-split variants of these for general graphs, based on a novel biased heavy-path decomposition, where the structural changes corresponding to edge insertions and deletions in the underlying graph consist of at most (log n) basic operations of a particularly simple form. As a secondary result, we show how to maintain the pre-split trees under edge insertions in the underlying graph deterministically in worst case (log3 n) time. Using this, we obtain deterministic data structures for incremental planarity testing, incremental planar embedding, and incremental triconnectivity, that each have worst case (log3 n) update and query time, answering an open question by La Poutré and Westbrook from 1998.","author_count":3,"contributors":["Holm, Jacob","Rotenberg, Eva"],"cuid":["S01-000.00-451322"],"event":{"acronym":"SODA","end":"2020-01-08","place":"Salt Lake City, us","start":"2020-01-05","title":"2020 ACM-SIAM Symposium on Discrete Algorithms","year":"2020"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"worst case polylog incremental spqr trees embeddings planarity and triconnectivity","src":["ku"],"src-code":["DI-U-KU"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-451322","identifier":[{"id":"85084079597","type":"scopus"}],"ids":["ku-60bbf88c-ec23-44f6-bf67-bacc83784846"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-4-CE63D237880DBCDA952788E4F3C99332"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Algorithms and Complexity"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Jacob","key":"holmpau","last":"Holm","locid":"b9128f70-a478-4df0-9f6b-cc665f65976c","name":"Holm, Jacob","orcid":"0000-0001-6997-9251","rank":1,"rolecode":"pau"},{"affno":"","first":"Eva","key":"rotenbergpau","last":"Rotenberg","name":"Rotenberg, Eva","rank":2,"rolecode":"pau"},{"affno":"","first":"Shuchi","key":"chawlapedh","last":"Chawla","name":"Chawla, Shuchi","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1137/1.9781611975994.146","eisbn":["9781611975994"],"pages":"2378-2397","publisher":"Society for Industrial and Applied Mathematics","status":"p","title":"Proceedings of the Fourteenth Annual ACM-SIAM Symposium on Discrete Algorithms"},"review":"Peer Reviewed","scoID":["2-s2.0-85084079597"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-60bbf88c-ec23-44f6-bf67-bacc83784846"],"src":["KU University of Copenhagen"],"title":"Worst-Case Polylog Incremental SPQR-trees : Embeddings, Planarity, and Triconnectivity","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-451322","year":"2020","yearsub":"2020"}
{"abstract":"The classic string indexing problem is to preprocess a string S into a compact data structure that supports efficient subsequent pattern matching queries, that is, given a pattern string P, report all occurrences of P within S. In this paper, we study a basic and natural extension of string indexing called the string indexing for top-k close consecutive occurrences problem (Sitcco). Here, a consecutive occurrence is a pair (i, j), i < j, such that P occurs at positions i and j in S and there is no occurrence of P between i and j, and their distance is defined as j − i. Given a pattern P and a parameter k, the goal is to report the top-k consecutive occurrences of P in S of minimal distance. The challenge is to compactly represent S while supporting queries in time close to the length of P and k. We give two time-space trade-offs for the problem. Let n be the length of S, m the length of P, and ε ∈ (0, 1]. Our first result achieves O(n log n) space and optimal query time of O(m + k), and our second result achieves linear space and query time O(m + k1+ε). Along the way, we develop several techniques of independent interest, including a new translation of the problem into a line segment intersection problem and a new recursive clustering technique for trees.","author_count":7,"contributors":["Bille, Philip","Gørtz, Inge Li","Pedersen, Max Rishøj","Rotenberg, Eva","Steiner, Teresa Anna"],"cuid":["S01-000.00-326040"],"event":{"end":"2020-12-18","place":"Virtual, Goa, in","start":"2020-12-14","title":"40th IARCS Annual Conference on Foundations of Software Technology and Theoretical Computer Science","year":"2020"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Consecutive occurrences","Pattern matching","String indexing"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"string indexing for top k close consecutive occurrences","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.4230/LIPIcs.FSTTCS.2020.14","version":"Published Version"},"funding_acknowledgement":["Funding Philip Bille: Supported by the Danish Research Council grant DFF-8021-002498. Inge Li Gørtz: Supported by the Danish Research Council grant DFF-8021-002498. Max Rishøj Pedersen: Supported by the Danish Research Council grant DFF-8021-002498. Eva Rotenberg: Supported by the Danish Research Council grant DFF-8021-002498."],"id":"S01-000.00-326040","identifier":[{"id":"85101483067","type":"scopus"}],"ids":["dtu-482c56d6-bafc-4ddf-8af6-c2fb4f578998"],"keyword":["Consecutive occurrences","Pattern matching","String indexing"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-5ACB94D1658BE2E097994156932F6108"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/245618673/LIPIcs_FSTTCS_2020_14.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.4230/LIPIcs.FSTTCS.2020.14","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2021"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Applied Mathematics and Computer Science","Technical University of Denmark, Department of Applied Mathematics and Computer Science, Algorithms and Logic"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Philip","key":"billepau","last":"Bille","locid":"81ad6edf-aa11-47bc-adaf-227fe7e6963e","name":"Bille, Philip","orcid":"0000-0002-1120-5154","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Inge Li","key":"gørtzpau","last":"Gørtz","locid":"08da98e0-b1f4-492e-94e7-15083cc40701","name":"Gørtz, Inge Li","orcid":"0000-0002-8322-4952","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Max Rishøj","key":"pedersenpau","last":"Pedersen","locid":"d88e8491-c512-4a0a-a6c3-41f61be01870","name":"Pedersen, Max Rishøj","orcid":"0000-0002-8850-6422","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Eva","key":"rotenbergpau","last":"Rotenberg","locid":"1a970eb9-57c6-4f5f-a453-117cbc7705ba","name":"Rotenberg, Eva","orcid":"0000-0001-5853-7909","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Teresa Anna","key":"steinerpau","last":"Steiner","locid":"229ad7cd-2c7d-417c-8333-01832e47680e","name":"Steiner, Teresa Anna","rank":5,"rolecode":"pau"},{"affno":"","first":"Nitin","key":"saxenapedh","last":"Saxena","name":"Saxena, Nitin","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Sunil","key":"simonpedh","last":"Simon","name":"Simon, Sunil","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.4230/lipics.fsttcs.2020.14","eisbn":["9783959771740"],"issn":["18688969"],"publisher":"Schloss Dagstuhl- Leibniz-Zentrum fur Informatik GmbH, Dagstuhl Publishing","series":"Leibniz International Proceedings in Informatics, LIPIcs","status":"p","title":"Proceedings of 40<sup>th</sup> IARCS Annual Conference on Foundations of Software Technology and Theoretical Computer Science"},"review":"Peer Reviewed","scoID":["2-s2.0-85101483067"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-482c56d6-bafc-4ddf-8af6-c2fb4f578998"],"src":["DTU Technical University of Denmark"],"title":"String indexing for top-k close consecutive occurrences","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-326040","year":"2020","yearsub":"2021"}
{"abstract":"In the online bipartite matching problem with replacements, all the vertices on one side of the bipartition are given, and the vertices on the other side arrive one-by-one with all their incident edges. The goal is to maintain a maximum matching while minimizing the number of changes (replacements) to the matching. We show that the greedy algorithm that always takes the shortest augmenting path from the newly inserted vertex (denoted the SAP protocol) uses at most amortized O (log2 n) replacements per insertion, where n is the total number of vertices inserted. This is the first analysis to achieve a polylogarithmic number of replacements for any replacement strategy, almost matching the Ω (log n) lower bound. The previous best strategy known achieved amortized O (√n) replacements [Bosek, Leniowski, Sankowski, Zych, FOCS 2014]. For the SAP protocol in particular, nothing better than the trivial O (n) bound was known except in special cases. Our analysis immediately implies the same upper bound of O (log2 n) reassignments for the capacitated assignment problem, where each vertex on the static side of the bipartition is initialized with the capacity to serve a number of vertices. We also analyze the problem of minimizing the maximum server load. We show that if the final graph has maximum server load L, then the SAP protocol makes amortized O (min{L log2 n, √n log n}) reassignments. We also show that this is close to tight, because Ω (min{L, √n}) reassignments can be necessary.","author_count":3,"contributors":["Bernstein, Aaron","Holm, Jacob","Rotenberg, Eva"],"cuid":["S02-100.00-034656"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Rutgers - The State University of New Jersey, New Brunswick"],"keyword":["Bipartite graphs","Load balancing","Maximum matching","Online algorithms","Shortest augmenting path"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"online bipartite matching with amortized o log sup 000000000002 sup n replacements","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/210757891/hkkr_paper.pdf","version":"Authors Final Version"},"funding_acknowledgement":["This journal article is the full version of a conference paper of SODA’18, where it won the best-paper award. It differs from the extended abstract by the content of Sections 3.2.1 and 6.3. J. Holm is partially supported by grant DFF-0602-02499B from the Danish Council for Independent Research, and grant 16582, Basic Algorithms Research Copenhagen (BARC), from the VILLUM foundation. Authors’ addresses: A. Bernstein, Rutgers University, CoRE building, office 306, 96 Frelinghuysen road, Piscataway, NJ, 08854; email: bernstei@gmail.com; J. Holm, University of Copenhagen, Department of Computer Science, Univer-sitetsparken 1, 2100 Copenhagen, Denmark; email: jaho@di.ku.dk; E. Rotenberg, Richard Petersens Plads, Bygning 322, 2800 Kgs. Lyngby, Denmark; email: erot@dtu.dk. Permission to make digital or hard copies of all or part of this work for personal or classroom use is granted without fee provided that copies are not made or distributed for profit or commercial advantage and that copies bear this notice and the full citation on the first page. Copyrights for components of this work owned by others than the author(s) must be honored. Abstracting with credit is permitted. To copy otherwise, or republish, to post on servers or to redistribute to lists, requires prior specific permission and/or a fee. Request permissions from permissions@acm.org. © 2019 Copyright held by the owner/author(s). Publication rights licensed to ACM. 0004-5411/2019/09-ART37 $15.00 https://doi.org/10.1145/3344999"],"id":"S02-100.00-034656","identifier":[{"id":"85074506166","type":"scopus"}],"ids":["dtu-5b1126c3-9f12-41ed-923c-e06c836cbfa3","ku-06a49b5c-ca12-4d51-9895-7bd27fa3fe1f"],"keyword":["Bipartite graphs","Load balancing","Maximum matching","Online algorithms","Shortest augmenting path"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-12C924A218CC2A6CA4AF3CDB596505C9"],"oa_link":[{"access":"oa","type":"rem","url":"http://arxiv.org/pdf/1707.06063","version":"Pre-print"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/210757891/hkkr_paper.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","country":"us","key":"rutgers the state university of new jersey new brunswick","loc":["United States","America, North","OECD"],"name":"Rutgers - The State University of New Jersey, New Brunswick","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Algorithms and Complexity"],"nora_code":"DI-U-KU","used":1},{"affno":"3","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Applied Mathematics and Computer Science","Technical University of Denmark, Department of Applied Mathematics and Computer Science, Algorithms and Logic"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Aaron","key":"bernsteinpau","last":"Bernstein","name":"Bernstein, Aaron","rank":1,"rolecode":"pau"},{"affno":"2","first":"Jacob","key":"holmpau","last":"Holm","locid":"b9128f70-a478-4df0-9f6b-cc665f65976c","name":"Holm, Jacob","orcid":"0000-0001-6997-9251","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Eva","key":"rotenbergpau","last":"Rotenberg","locid":"1a970eb9-57c6-4f5f-a453-117cbc7705ba","name":"Rotenberg, Eva","orcid":"0000-0001-5853-7909","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1145/3344999","issn":["00045411","1557735X"],"issn_org":["00045411"],"issue":"5","journal":"Journal of the ACM","paperid":"37","publisher":"Association for Computing Machinery","status":"p","title":"Journal of the ACM","volume":"66"},"review":"Peer Reviewed","scoID":["2-s2.0-85074506166"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-5b1126c3-9f12-41ed-923c-e06c836cbfa3","ku-06a49b5c-ca12-4d51-9895-7bd27fa3fe1f"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Online Bipartite Matching with Amortized O(log<sup>2</sup> n) Replacements","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-034656","year":"2019","yearsub":2020}
{"abstract":"We consider very natural “fence enclosure” problems studied by Capoyleas, Rote, and Woeginger and Arkin, Khuller, and Mitchell in the early 90s. Given a set S of n points in the plane, we aim at finding a set of closed curves such that (1) each point is enclosed by a curve and (2) the total length of the curves is minimized. We consider two main variants. In the first variant, we pay a unit cost per curve in addition to the total length of the curves. An equivalent formulation of this version is that we have to enclose n unit disks, paying only the total length of the enclosing curves. In the other variant, we are allowed to use at most k closed curves and pay no cost per curve. For the variant with at most k closed curves, we present an algorithm that is polynomial in both n and k. For the variant with unit cost per curve, or unit disks, we present a near-linear time algorithm. Capoyleas, Rote, and Woeginger solved the problem with at most k curves in nO(k) time. Arkin, Khuller, and Mitchell used this to solve the unit cost per curve version in exponential time. At the time, they conjectured that the problem with k curves is NP-hard for general k. Our polynomial time algorithm refutes this unless P equals NP.","author_count":8,"contributors":["Abrahamsen, Mikkel","Adamaszek, Anna","Bringmann, Karl","Cohen-Addad, Vincent","Mehr, Mehran","Rotenberg, Eva","Roytman, Alan","Thorup, Mikkel"],"cuid":["S02-092.23-033927"],"event":{"acronym":"STOC","end":"2018-06-29","place":"Los Angeles, us","start":"2018-06-25","title":"50th Annual ACM Symposium on Theory of Computing, STOC 2018","year":"2018"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD"],"country":["France","Germany","Netherlands"],"glorg":["All Global Affiliations","Centre National de la Recherche Scientifique (CNRS)","Eindhoven University of Technology","Max Planck Institute for Informatics","Sorbonne Université"],"keyword":["Geometric clustering","Minimum perimeter sum"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"fast fencing","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85049877511&partnerID=8YFLogxK","version":"Other Version"},"id":"S02-092.23-033927","identifier":[{"id":"85049877511","type":"scopus"}],"ids":["dtu-3bdbcb55-8bf5-40dc-b5be-462afd6ce115","ku-c6184f10-5897-446c-8cc8-236a030d513e"],"keyword":["Geometric clustering","Minimum perimeter sum"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-369384C5A35B58E17E62BAFB0DC83B6D"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Algorithms and Programming Languages (APL)","Københavns Universitet, Faculty of Science, Department of Computer Science, The Image Section"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"de","key":"max planck institute for informatics","loc":["Germany","Europe, EU","OECD"],"name":"Max Planck Institute for Informatics","used":1},{"affno":"3","country":"fr","key":"sorbonne université","loc":["France","Europe, EU","OECD"],"name":"Sorbonne Université","used":1},{"affno":"4","country":"fr","key":"centre national de la recherche scientifique","loc":["France","Europe, EU","OECD"],"name":"Centre National de la Recherche Scientifique (CNRS)","used":1},{"affno":"5","country":"nl","key":"eindhoven university of technology","loc":["Netherlands","Europe, EU","OECD"],"name":"Eindhoven University of Technology","used":1},{"affno":"6","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Applied Mathematics and Computer Science","Technical University of Denmark, Department of Applied Mathematics and Computer Science, Algorithms and Logic"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","first":"Mikkel","key":"abrahamsenpau","last":"Abrahamsen","locid":"63596832-461f-409a-a2cc-81023b9b8e46","name":"Abrahamsen, Mikkel","orcid":"0000-0003-2734-4690","rank":1,"rolecode":"pau"},{"affno":"1","first":"Anna","key":"adamaszekpau","last":"Adamaszek","locid":"305d3163-3803-404a-a693-817f2a5f7eb8","name":"Adamaszek, Anna Maria","name_org":"Adamaszek, Anna","orcid":"0000-0003-3291-0124","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Karl","key":"bringmannpau","last":"Bringmann","name":"Bringmann, Karl","rank":3,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Vincent","key":"cohenaddadpau","last":"Cohen-Addad","name":"Cohen-Addad, Vincent","rank":4,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Mehran","key":"mehrpau","last":"Mehr","name":"Mehr, Mehran","rank":5,"rolecode":"pau"},{"affno":"6","corresponding":null,"country":"dk","first":"Eva","key":"rotenbergpau","last":"Rotenberg","locid":"1a970eb9-57c6-4f5f-a453-117cbc7705ba","name":"Rotenberg, Eva","orcid":"0000-0001-5853-7909","rank":6,"rolecode":"pau"},{"affno":"1","first":"Alan","key":"roytmanpau","last":"Roytman","locid":"a88f23fb-e4a1-40c8-b349-86e098ab60ea","name":"Roytman, Alan","rank":7,"rolecode":"pau"},{"affno":"1","first":"Mikkel","key":"thoruppau","last":"Thorup","locid":"9a753f32-9b71-4058-8b1e-a94b71903f10","name":"Thorup, Mikkel","orcid":"0000-0001-5237-1709","rank":8,"rolecode":"pau"}],"pub":{"doi":"10.1145/3188745.3188878","eisbn":["9781450355599"],"isbn":["9781450355599"],"pages":"564-573","publisher":"Association for Computing Machinery","status":"p","title":"STOC 2018 - Proceedings of the 50th Annual ACM SIGACT Symposium on Theory of Computing"},"review":"Peer Reviewed","scoID":["2-s2.0-85049877511"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-3bdbcb55-8bf5-40dc-b5be-462afd6ce115","ku-c6184f10-5897-446c-8cc8-236a030d513e"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Fast fencing","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-092.23-033927","year":"2018","yearsub":"2018"}
{"abstract":"We present a decremental data structure for maintaining the SPQR-tree of a planar graph subject to edge contractions and deletions. The update time, amortized over Ω(n) operations, is O(log2 n). Via SPQR-trees, we give a decremental data structure for maintaining 3-vertex connectivity in planar graphs. It answers queries in O(1) time and processes edge deletions and contractions in O(log2 n) amortized time. The previous best supported deletions and insertions in O(√n) time.","author_count":8,"contributors":["Holm, Jacob","Italiano, Giuseppe F.","Karczmarz, Adam","Łacki, Jakub","Rotenberg, Eva"],"cuid":["S02-097.53-032731"],"event":{"acronym":"ESA","end":"2018-08-22","place":"Helsinki, fi","start":"2018-08-20","title":"26th European Symposium on Algorithms, ESA 2018","year":"2018"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["America, North","Europe, EU","OECD"],"country":["Italy","Poland","United States"],"glorg":["All Global Affiliations","Alphabet Inc.","University of Rome Tor Vergata","University of Warsaw"],"keyword":["Data structures","Graph algorithms","Graph embeddings","Planar graphs","SPQR trees","Triconnectivity"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"decremental spqr trees for planar graphs","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.4230/LIPIcs.ESA.2018.46","version":"Published Version"},"funding_acknowledgement":["Jacob Holm is supported by Mikkel Thorup’s Advanced Grant DFF-0602-02499B from the Danish Council for Independent Research under the Sapere Aude research career programme. 2 Giuseppe F. Italiano is partially supported by the Italian Ministry of Education, University and Research under Project AMANDA (Algorithmics for MAssive and Networked DAta). 3 Adam Karczmarz is supported by the grants 2014/13/B/ST6/01811 and 2017/24/T/ST6/00036 of the Polish National Science Center. 4 When working on this paper Jakub Łącki was partly supported by the EU FET project MULTIPLEX no. 317532 and the Google Focused Award on “Algorithms for Large-scale Data Analysis” and Polish National Science Center grant number 2014/13/B/ST6/01811. Part of this work was done while Jakub Łącki was visiting the Simons Institute for the Theory of Computing."],"id":"S02-097.53-032731","identifier":[{"id":"85052540763","type":"scopus"}],"ids":["dtu-06bebd3f-b9b8-4c5a-a47c-7993c1f918e9","ku-a17cbc6f-d3c3-4899-b241-b3ea694d128e"],"keyword":["Data structures","Graph algorithms","Graph embeddings","Planar graphs","SPQR-trees","Triconnectivity"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-EFFF01A40BA39C5A97104C59EC3BC73C"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/193380694/LIPIcs_ESA_2018_46.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/236510737/OA_Decremental_SPQR_trees_for_Planar_Graphs.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.4230/LIPIcs.ESA.2018.46","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2019"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Algorithms and Complexity"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"it","key":"university of rome tor vergata","loc":["Italy","Europe, EU","OECD"],"name":"University of Rome Tor Vergata","used":1},{"affno":"3","country":"pl","key":"university of warsaw","loc":["Poland","Europe, EU","OECD"],"name":"University of Warsaw","used":1},{"affno":"4","country":"us","key":"alphabet inc","loc":["United States","America, North","OECD"],"name":"Alphabet Inc.","used":1},{"affno":"5","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Applied Mathematics and Computer Science","Technical University of Denmark, Department of Applied Mathematics and Computer Science, Algorithms and Logic"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","first":"Jacob","key":"holmpau","last":"Holm","locid":"b9128f70-a478-4df0-9f6b-cc665f65976c","name":"Holm, Jacob","orcid":"0000-0001-6997-9251","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Giuseppe F.","key":"italianopau","last":"Italiano","name":"Italiano, Giuseppe F.","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Adam","key":"karczmarzpau","last":"Karczmarz","name":"Karczmarz, Adam","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Jakub","key":"łackipau","last":"Łacki","name":"Łacki, Jakub","rank":4,"rolecode":"pau"},{"affno":"5","corresponding":null,"country":"dk","first":"Eva","key":"rotenbergpau","last":"Rotenberg","locid":"1a970eb9-57c6-4f5f-a453-117cbc7705ba","name":"Rotenberg, Eva","orcid":"0000-0001-5853-7909","rank":5,"rolecode":"pau"},{"affno":"","first":"Hannah","key":"bastpedh","last":"Bast","name":"Bast, Hannah","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Grzegorz","key":"hermanpedh","last":"Herman","name":"H