I-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-60b7772c-cc33-47e0-86c8-3e09c609153f"],"src":["ITU IT University of Copenhagen"],"title":"Towards a Proof System for Probabilistic Dynamic Logic","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-789552","year":"2024","yearsub":"2024"}
{"abstract":"We discuss an integrated approach for the design, specification, automatic deployment and simulation of microservice-based applications based on the ABS language. In particular, the integration of architectural modeling inspired by TOSCA (component types/port dependencies/architectural invariants) into the ABS language (static and dynamic aspects of ABS, including component properties, e.g., speed, and their use in timed/probabilistic simulations) via dedicated annotations. This is realized by the integration of the ABS toolchain with a dedicated tool, called Timed SmartDepl. Such a tool, at ABS code compile time, solves (starting from the provided architectural specification) the optimal deployment problem and produces ABS deployment orchestrations to be used in the context of timed simulations. Moreover, the potentialities and the expressive power of this approach are confirmed by further integration with external tools, e.g.: the Zephyrus tool, used by Timed SmartDepl to solve the optimal deployment problem via constraint solving, and a machine learning-based predictive module, that generates in advance data to be used in a timed ABS simulation exploiting such predicted data (e.g., simulating the usage, during the day, of predicted data generated during the preceding night).","author_count":10,"contributors":["Bacchiani, Lorenzo","Bravetti, Mario","Giallorenzo, Saverio","Mauro, Jacopo","Zavattaro, Gianluigi"],"cuid":["S01-000.00-750499"],"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"corresponding_author":["Bacchiani, Lorenzo"],"country":["France","Italy"],"glorg":["All Global Affiliations","French Institute for Research in Computer Science and Automation","University Nice Sophia Antipolis","University of Bologna"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"integrated timed architectural modeling execution language","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85184284855","version":"Other Version"},"funding_acknowledgement":["This research was funded in whole, or in part, by EPSRC EP/T006544/2, EP/K011715/1, EP/K034413/1, EP/L00058X/1, EP/N027833/2, EP/N028201/1, EP/T014709/2, EP/V000462/1, EP/X015955/1, NCSS/EPSRC VeTSS and Horizon EU TaRDIS 101093006."],"id":"S01-000.00-750499","identifier":[{"id":"85184284855","type":"scopus"}],"ids":["sdu-5dc7d1a2-6db5-4912-9dda-ad9278b9a2f6"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-46DCEE595D5470ED24D88B0C6D3E36A7"],"org":[{"affno":"1","country":"it","key":"university of bologna","loc":["Italy","Europe, EU","OECD"],"name":"University of Bologna","used":1},{"affno":"2","country":"fr","key":"university nice sophia antipolis","loc":["France","Europe, EU","OECD"],"name":"University Nice Sophia Antipolis","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Science, Department of Mathematics and Computer Science","SDU, The Faculty of Business and Social Sciences, Digital Democracy Centre"],"nora_code":"DI-U-SDU","used":1},{"affno":"4","country":"fr","key":"french institute for research in computer science and automation","loc":["France","Europe, EU","OECD"],"name":"French Institute for Research in Computer Science and Automation","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lorenzo","key":"bacchianipau","last":"Bacchiani","name":"Bacchiani, Lorenzo","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mario","key":"bravettipau","last":"Bravetti","name":"Bravetti, Mario","rank":2,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Saverio","key":"giallorenzopau","last":"Giallorenzo","name":"Giallorenzo, Saverio","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jacopo","key":"mauropau","last":"Mauro","locid":"ad1ad59c-7294-44a8-98d6-d5329b94baac","name":"Mauro, Jacopo","orcid":"0000-0002-5285-2868","rank":4,"rolecode":"pau"},{"affno":"1 4","corresponding":null,"first":"Gianluigi","key":"zavattaropau","last":"Zavattaro","name":"Zavattaro, Gianluigi","rank":5,"rolecode":"pau"},{"affno":"","first":"Frank","key":"deboerpedh","last":"de Boer","name":"de Boer, Frank","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Ferruccio","key":"damianipedh","last":"Damiani","name":"Damiani, Ferruccio","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Reiner","key":"hähnlepedh","last":"Hähnle","name":"Hähnle, Reiner","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Einar Broch","key":"johnsenpedh","last":"Johnsen","name":"Johnsen, Einar Broch","rank":9,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Eduard","key":"kamburjanpedh","last":"Kamburjan","name":"Kamburjan, Eduard","rank":10,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-031-51060-1_7","eisbn":["9783031510601"],"isbn":["9783031510595"],"issn":["03029743"],"pages":"169-198","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","title":"Active Object Languages: Current Research Trends"},"review":"Peer Reviewed","scoID":["2-s2.0-85184284855"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-5dc7d1a2-6db5-4912-9dda-ad9278b9a2f6"],"src":["SDU University of Southern Denmark"],"title":"Integrated Timed Architectural Modeling/Execution Language","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-750499","year":"2024","yearsub":"2024"}
{"abstract":"Autonomous Systems (AS) enable systems to adapt to drastic and unprecedented environmental changes, a capability that can be enhanced through the utilization of Digital Twins (DTs). However, the additional capabilities of AS come at the cost of explainability, as the expanding adaptation space complicates the reasoning about the system's behavior. For certain types of systems, it is crucial to ensure that specific properties are upheld despite the system's autonomous behavior. To facilitate the monitoring of these properties, we propose the use of Runtime Verification (RV). This tutorial demonstrates the integration of RV tools into the Digital Twins as a Service (DTaaS) platform to monitor and verify the behavior of AS in real-time. By exploring various methods to incorporate RV tools within a DT context, the tutorial aims to advance the application of RV technologies in autonomic computing and self-adaptive system design. Specifically, we demonstrate how the behavior of a self-configuring DT can be verified utilizing RV. This is accomplished through the DTaaS platform, which supports seamless deployment of DT-based AS.","author_count":14,"contributors":["Kristensen, Morten Haahr","Bonizzi, Alberto","Gomes, Cláudio","Hansen, Simon Thrane","Isasa Martin, Carlos Ignacio","Iven, Hannes","Kamburjan, Eduard","Larsen, Peter Gorm","Leucker, Martin","Talasila, Prasad","Evans, Valdemar Tang","Tonetta, Stefano","Vosteen, Lars B.","Wright, Thomas David"],"cuid":["S01-000.00-772163"],"event":{"end":"2024-09-20","start":"2024-09-16","title":"5th IEEE International Conference on Autonomic Computing and Self-Organizing Systems","year":"2024"},"filters":{"added":"2025-01","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD"],"country":["Germany","Italy","Luxembourg","Norway"],"glorg":["All Global Affiliations","Fondazione Bruno Kessler","University of Luxembourg","University of Lübeck","University of Oslo"],"keyword":["Digital twins","Monitor","Runtime verification"],"level":"pop","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"und","rtype":["clu"],"sorti":"runtime verification of autonomous systems utilizing digital twins as a service","src":["au"],"src-code":["DI-U-AU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85214840010","version":"Other Version"},"funding_acknowledgement":["The work presented here is partially supported by the RoboSAPIENS project funded by the European Commission’s Horizon Europe programme under grant agreement number 101133807, the O5G-N-IoT project, funded by the German Federal Ministry for Economic Affairs and Climate Action, due to a resolution of the German Bundestag, and the SM4RTENANCE project under grant no. 101123423."],"id":"S01-000.00-772163","identifier":[{"id":"85214840010","type":"scopus"}],"ids":["au-3dd83a3e-debc-4251-be9f-b7ea21287116"],"keyword":["NuRV","Self-adaptivity","TeSSLa","digital twins","monitor","runtime verification"],"lang":"English","level":"Popular","mra":["Science/Technology"],"noi":["Global-Local-2-4-9192F4B904E4DFAEC4F1BDE814E9D2F1"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Electrical and Computer Engineering, Department of Electrical and Computer Engineering - Software Engineering & Computing systems"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"it","key":"fondazione bruno kessler","loc":["Italy","Europe, EU","OECD"],"name":"Fondazione Bruno Kessler","used":1},{"affno":"3","country":"lu","key":"university of luxembourg","loc":["Luxembourg","Europe, EU","OECD"],"name":"University of Luxembourg","used":1},{"affno":"4","country":"de","key":"university of lübeck","loc":["Germany","Europe, EU","OECD"],"name":"University of Lübeck","used":1},{"affno":"5","country":"no","key":"university of oslo","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"University of Oslo","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Morten Haahr","key":"kristensenpau","last":"Kristensen","locid":"31d81494-4896-4be5-a484-cdd487229081","name":"Kristensen, Morten Haahr","orcid":"0009-0008-8467-7567","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Alberto","key":"bonizzipau","last":"Bonizzi","name":"Bonizzi, Alberto","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Cláudio","key":"gomespau","last":"Gomes","locid":"63d3d37d-ef61-40b6-a263-52792c5fd9e0","name":"Gomes, Cláudio","orcid":"0000-0003-2692-9742","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Simon Thrane","key":"hansenpau","last":"Hansen","name":"Hansen, Simon Thrane","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Carlos Ignacio","key":"isasamartinpau","last":"Isasa Martin","locid":"cbd5a37e-540e-4c38-998e-be7d80606137","name":"Isasa Martin, Carlos Ignacio","rank":5,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Hannes","key":"ivenpau","last":"Iven","name":"Iven, Hannes","rank":6,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Eduard","key":"kamburjanpau","last":"Kamburjan","name":"Kamburjan, Eduard","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter Gorm","key":"larsenpau","last":"Larsen","locid":"318d787b-3528-4a49-88be-60491de69409","name":"Larsen, Peter Gorm","orcid":"0000-0002-4589-1500","rank":8,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Martin","key":"leuckerpau","last":"Leucker","name":"Leucker, Martin","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Prasad","key":"talasilapau","last":"Talasila","locid":"7a6e2389-0e8e-4040-8125-6fcbea9ef434","name":"Talasila, Prasad","orcid":"0000-0002-8973-2640","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Valdemar Tang","key":"evanspau","last":"Evans","locid":"cff3561e-981d-4b7b-90c1-0373e3ccc579","name":"Evans, Valdemar Tang","rank":11,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Stefano","key":"tonettapau","last":"Tonetta","name":"Tonetta, Stefano","rank":12,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Lars B.","key":"vosteenpau","last":"Vosteen","name":"Vosteen, Lars B.","rank":13,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Thomas David","key":"wrightpau","last":"Wright","name":"Wright, Thomas David","rank":14,"rolecode":"pau"}],"pub":{"doi":"10.1109/acsos-c63493.2024.00042","eisbn":["9798350389760"],"isbn":["9798350389777"],"pages":"121-127","publisher":"IEEE","status":"p","title":"2024 IEEE International Conference on Autonomic Computing and Self-Organizing Systems Companion (ACSOS-C)"},"review":"Undetermined","scoID":["2-s2.0-85214840010"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-3dd83a3e-debc-4251-be9f-b7ea21287116"],"src":["AU Aarhus University"],"title":"Runtime Verification of Autonomous Systems Utilizing Digital Twins as a Service","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-772163","year":"2024","yearsub":"2024"}
{"abstract":"To enable the reuse of Digital Twins, in the form of simulation units or other forms of behavioral models, of single physical components, one must be able to connect and couple them. Current platform and architectures consider mostly monolithic digital twins and offer little support for coupling and checking the consistency of the coupling. The coupling must be internally consistent—satisfy constraints related to their co-simulation—and externally consistent—mirror the structure of the composed physical system. In this paper, we propose an extension to a behavior-extended Digital Twin architecture for individual Digital Twins to include co-simulation scenarios for coupled systems lifted from configuration files, which can be implemented along with a Digital-Twin-as-a-Service platform to make assets reusable in time. To monitor and query these connections, we introduce a semantic lifting service, which interprets the coupled Digital Twins as Knowledge Graphs and enables the use of queries to express internal and external consistency constraints. Two representative case studies for systems with coupled behavior are used for the demonstration of this approach and show that it indeed enables reusability of components and services between different Digital Twins.","author_count":4,"contributors":["Gil Arboleda, Santiago","Kamburjan, Eduard","Talasila, Prasad","Larsen, Peter Gorm"],"cuid":["S01-000.00-772878"],"filters":{"added":"2025-01","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Gil Arboleda, Santiago"],"country":["Norway"],"glorg":["All Global Affiliations","University of Oslo"],"keyword":["Behavioral model","Co simulation","Digital twin","Knowledge graph"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"an architecture for coupled digital twins with semantic lifting","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s10270-024-01221-w","version":"Published Version"},"id":"S01-000.00-772878","identifier":[{"id":"85208480166","type":"scopus"}],"ids":["au-81a22bd7-c175-4332-9bc6-727ab9ba8d0b"],"keyword":["Behavioral model","Co-simulation","Digital twin","Knowledge graph"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-61726F2F364BC71C670B0EB1CC9665E1"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s10270-024-01221-w","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Electrical and Computer Engineering, Department of Electrical and Computer Engineering - Software Engineering & Computing systems"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"no","key":"university of oslo","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"University of Oslo","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Santiago","key":"gilarboledapau","last":"Gil Arboleda","locid":"6562a786-f7e8-4007-ab15-472ea9b63f98","name":"Gil Arboleda, Santiago","orcid":"0000-0002-1789-531X","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Eduard","key":"kamburjanpau","last":"Kamburjan","name":"Kamburjan, Eduard","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Prasad","key":"talasilapau","last":"Talasila","locid":"7a6e2389-0e8e-4040-8125-6fcbea9ef434","name":"Talasila, Prasad","orcid":"0000-0002-8973-2640","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter Gorm","key":"larsenpau","last":"Larsen","locid":"318d787b-3528-4a49-88be-60491de69409","name":"Larsen, Peter Gorm","orcid":"0000-0002-4589-1500","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1007/s10270-024-01221-w","issn":["16191366","16191374"],"issn_org":["16191366"],"journal":"Software and Systems Modeling","publisher":"Springer","status":"e","title":"Software and Systems Modeling"},"review":"Peer Reviewed","scoID":["2-s2.0-85208480166"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["E-Published (ahead of print)"]},"sid":["au-81a22bd7-c175-4332-9bc6-727ab9ba8d0b"],"src":["AU Aarhus University"],"title":"An architecture for coupled digital twins with semantic lifting","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-772878","year":"2024","yearsub":"2025"}
{"abstract":"Establishing digital twins is a non-trivial endeavour especially when users face significant challenges in creating them from scratch. Ready availability of reusable models, data and tool assets, can help with creation and use of digital twins. A number of digital twin frameworks exist to facilitate creation and use of digital twins. In this paper we propose a digital twin framework to author digital twin assets, create digital twins from reusable assets and make the digital twins available as a service to other users. The proposed framework automates the management of reusable assets, storage, provision of compute infrastructure, communication and monitoring tasks. The users operate at the level of digital twins and delegate the rest of the work to the digital twin as a service framework.","author_count":6,"contributors":["Talasila, Prasad","Gomes, Cláudio","Mikkelsen, Peter Høgh","Gil Arboleda, Santiago","Kamburjan, Eduard","Larsen, Peter Gorm"],"cuid":["S01-000.00-674930"],"filters":{"added":"2023-07","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Gil Arboleda, Santiago","Gomes, Cláudio","Kamburjan, Eduard","Larsen, Peter Gorm","Mikkelsen, Peter Høgh","Talasila, Prasad"],"country":["Norway"],"glorg":["All Global Affiliations","University of Oslo"],"keyword":["Automation","Composition","Digital twins","Life cycle","Physical twin"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"und","rtype":["clu"],"sorti":"digital twin as a service dtaas a platform for digital twin developers and users","src":["au"],"src-code":["DI-U-AU"],"type":"dpr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.au.dk/ws/files/322541646/2305.07244v1.pdf","version":"Other Version"},"id":"S01-000.00-674930","ide