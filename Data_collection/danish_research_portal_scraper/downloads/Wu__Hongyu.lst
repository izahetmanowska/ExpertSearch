:"pau"},{"affno":"","corresponding":null,"first":"Frank B","key":"hupau","last":"Hu","name":"Hu, Frank B","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Qi","key":"sunpau","last":"Sun","name":"Sun, Qi","rank":4,"rolecode":"pau"}],"pmid":["26302090"],"pub":{"doi":"10.1097/ede.0000000000000369","issn":["10443983","15315487"],"issn_org":["10443983"],"issue":"6","journal":"Epidemiology","publisher":"Lippincott Williams and Wilkins Ltd.","status":"p","title":"Epidemiology","volume":"26"},"review":"Peer Reviewed","scoID":["2-s2.0-84942746555"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-90da8609-bc96-4767-90ce-70d0e059e2d5"],"src":["SDU University of Southern Denmark"],"title":"Consumption of White Rice and Brown Rice and Urinary Inorganic Arsenic Concentration","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-614706","year":"2015","yearsub":"2015"}
{"abstract":"OBJECTIVE: To evaluate and compare the correlations of various circulating persistent organic pollutants (POPs) with fat mass percentages (FM%) of trunk, leg, and whole body measured by dual-energy X-ray absorptiometry. METHODS: This study included 2358 adults (≥20 years) in the National Health and Nutrition Examination Survey 1999-2004. Partial Pearson correlation coefficients were calculated, after adjusting for major confounders, including age, smoking status, and history of lactation and parity. Wolfe's method was used to compare correlation coefficients derived from the same participants. RESULTS: Twelve POPs showed significantly different correlations with fat depots in trunk and leg regions. β-hexachlorocyclohexane, heptachlorodibenzo-p-dioxin, octachlorodibenzo-p-dioxin, and polychlorinated biphenyl (PCB)-126 showed stronger positive correlations with trunk FM% than with leg FM%, whereas PCBs with ≥6 chlorines were more inversely correlated with trunk FM% than leg FM%. Age-stratified analysis showed stronger inverse correlations between POPs and trunk FM% mainly in participants <40 years, whereas stronger positive correlations between POPs and trunk FM% were observed in older participants. CONCLUSIONS: Stronger associations between POPs and trunk fat as compared to leg fat possibly indicated a more important role of trunk fat in the pharmacokinetics of POPs, or a stronger effect of POPs, as endocrine disruptors, on trunk fat metabolism.","author_count":4,"contributors":["Zong, Geng","Grandjean, Philippe","Wu, Hongyu","Sun, Qi"],"cuid":["S01-000.00-583301"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"circulating persistent organic pollutants and body fat distribution evidence from nhanes 000000001999 000000002004","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1002/oby.21161","version":"Other Version"},"id":"S01-000.00-583301","identifier":[{"id":"84940447077","type":"scopus"},{"id":"26237202","type":"pmid"},{"id":"PMC4551580","type":"pmcid"}],"ids":["sdu-234c8203-f84d-4085-aa5d-e3cd500cceed"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-138C40D8B06D4DBF3E5E5C57F3187F70"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1002/oby.21161","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Public Health, Environmental Medicine"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Geng","key":"zongpau","last":"Zong","name":"Zong, Geng","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Philippe","key":"grandjeanpau","last":"Grandjean","locid":"6fe207c8-8ce6-41b9-8503-bc15b6cf3ea1","name":"Grandjean, Philippe","orcid":"0000-0003-4046-9658","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Hongyu","key":"wupau","last":"Wu","name":"Wu, Hongyu","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Qi","key":"sunpau","last":"Sun","name":"Sun, Qi","rank":4,"rolecode":"pau"}],"pmid":["26237202"],"pub":{"doi":"10.1002/oby.21161","issn":["19307381","1930739X"],"issn_org":["19307381"],"issue":"9","journal":"Obesity","pages":"1903-1910","publisher":"Wiley","status":"p","title":"Obesity","volume":"23"},"review":"Peer Reviewed","scoID":["2-s2.0-84940447077"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-234c8203-f84d-4085-aa5d-e3cd500cceed"],"src":["SDU University of Southern Denmark"],"title":"Circulating persistent organic pollutants and body fat distribution : Evidence from NHANES 1999-2004","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-583301","year":"2015","yearsub":"2015"}
{"abstract":"BACKGROUND: Prospective data regarding persistent organic pollutants (POPs) and risk of type 2 diabetes (T2D) are limited, and the results for individual POPs are not entirely consistent across studies. OBJECTIVES: We prospectively examined plasma POP concentrations in relation to incident T2D and summarized existing evidence in a meta-analysis. METHODS: Plasma polychlorinated biphenyls (PCBs), dichlorodiphenyltrichloroethane (DDT), dichlorodiphenyldichloroethylene (DDE), and hexachlorobenzene (HCB) concentrations were measured in 1,095 women who were free of diabetes at blood draw in 1989-1990 and participated in two case-control studies in the Nurses' Health Study. We identified 48 incident T2D cases through 30 June 2008. We conducted a literature search in PubMed and EMBASE through December 2011 to identify prospective studies on POPs in relation to diabetes. We used a fixed-effects model to summarize results. RESULTS: After multivariable adjustment, plasma HCB concentration was positively associated with incident T2D [pooled odds ratio (OR) 3.59 (95% CI: 1.49, 8.64, ptrend = 0.003) comparing extreme tertiles]. Other POPs were not significantly associated with diabetes. After pooling our results with those of six published prospective studies that included 842 diabetes cases in total, we found that HCB and total PCBs both were associated with diabetes: the pooled ORs were 2.00 (95% CI: 1.13, 3.53; I2 = 21.4%, pheterogeneity = 0.28) and 1.70 (95% CI: 1.28, 2.27; I2 = 16.3%, pheterogeneity = 0.30) for HCB and total PCBs, respectively. CONCLUSIONS: These findings support an association between POP exposure and the risk of T2D.","author_count":7,"contributors":["Wu, Hongyu","Bertrand, Kimberly A","Choi, Anna L","Hu, Frank B","Laden, Francine","Grandjean, Philippe","Sun, Qi"],"cuid":["S01-000.00-595473"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Adult","Diabetes Mellitus Type 2 metabolism","Female","Humans","Hydrocarbons Chlorinated metabolism","Middle Aged","Nurses","Prospective Studies"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"persistent organic pollutants and type 000000000002 diabetes a prospective analysis in the nurses health study and meta analysis","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1289/ehp.1205248","version":"Other Version"},"id":"S01-000.00-595473","identifier":[{"id":"23131992","type":"pmid"},{"id":"PMC3569682","type":"pmcid"},{"id":"84873393514","type":"scopus"}],"ids":["sdu-4da0839c-865f-49d2-ae1b-04866bc9c579"],"keyword":["Adult","Diabetes Mellitus, Type 2/metabolism","Environmental Pollutants/metabolism","Female","Humans","Hydrocarbons, Chlorinated/metabolism","Middle Aged","Nurses","Prospective Studies"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-49FF943889ACE962B0117267B589BD8D"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1289/ehp.1205248","version":"Other Version"},{"access":"oa","type":"rem","url":"http://www.ncbi.nlm.nih.gov/pmc/articles/PMC3569682/","version":"Other Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Public Health, Environmental Medicine"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Hongyu","key":"wupau","last":"Wu","name":"Wu, Hongyu","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Kimberly A","key":"bertrandpau","last":"Bertrand","name":"Bertrand, Kimberly A","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Anna L","key":"choipau","last":"Choi","name":"Choi, Anna L","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Frank B","key":"hupau","last":"Hu","name":"Hu, Frank B","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Francine","key":"ladenpau","last":"Laden","name":"Laden, Francine","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Philippe","key":"grandjeanpau","last":"Grandjean","locid":"6fe207c8-8ce6-41b9-8503-bc15b6cf3ea1","name":"Grandjean, Philippe","orcid":"0000-0003-4046-9658","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Qi","key":"sunpau","last":"Sun","name":"Sun, Qi","rank":7,"rolecode":"pau"}],"pmid":["23131992"],"pub":{"doi":"10.1289/ehp.1205248","issn":["00916765","15529924"],"issn_org":["00916765"],"issue":"2","journal":"Environmental Health Perspectives","pages":"153-161","publisher":"Public Health Services, US Dept of Health and Human Services","status":"p","title":"Environmental Health Perspectives","volume":"121"},"review":"Peer Reviewed","scoID":["2-s2.0-84873393514"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-4da0839c-865f-49d2-ae1b-04866bc9c579"],"src":["SDU University of Southern Denmark"],"title":"Persistent Organic Pollutants and Type 2 Diabetes : A Prospective Analysis in the Nurses' Health Study and Meta-analysis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-595473","year":"2013","yearsub":"2013"}
