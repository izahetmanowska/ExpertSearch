niversity","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-42758991-e305-4bab-ad15-456c7dbdfc61"],"src":["AU Aarhus University"],"title":"VPS34-dependent control of apical membrane function of proximal tubule cells and nutrient recovery by the kidney","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-167168","year":"2022","yearsub":"2022"}
{"abstract":"Background: Epidemiological studies have linked transportation noise and cardiovascular diseases, however, atrial fibrillation (AF) has received limited attention. We aimed to investigate the association between transportation noise and AF risk. Methods: Over the period 1990–2017 we estimated road and railway noise (L den) at the most and least exposed façades for all residential addresses across Denmark. We estimated time-weighted mean noise exposure for 3.6 million individuals age ≥35 years. Of these, 269,756 incident cases of AF were identified with a mean follow-up of 13.0 years. Analyses were conducted using Cox proportional hazards models with adjustment for individual and area-level sociodemographic covariates and long-term residential air pollution. Results: A 10 dB higher 10-year mean road traffic noise at the most and least exposed façades were associated with incidence rate ratios (IRR) and 95% confidence intervals (CI) for AF of 1.006 (1.001–1.011) and 1.013 (1.007–1.019), respectively. After further adjustment for PM 2.5, the IRRs (CIs) were 1.000 (0.995–1.005) and 1.007 (1.000–1.013), respectively. For railway noise, the IRRs per 10 dB increase in 10-year mean exposure were 1.017 (1.007–1.026) and 1.035 (1.021–1.050) for the most and least exposed façades, respectively, and were slightly attenuated when adjusted for PM 2.5. Aircraft noise between 55 and 60 dB and ≥60 dB were associated with IRRs of 1.055 (0.996–1.116) and 1.036 (0.931–1.154), respectively, when compared to <45 dB. Conclusion: Transportation noise seems to be associated with a small increase in AF risk, especially for exposure at the least exposed façade.","author_count":10,"contributors":["Thacher, Jesse D.","Poulsen, Aslak Harbo","Hvidtfeldt, Ulla Arthur","Raaschou-Nielsen, Ole","Ketzel, Matthias","Jensen, Steen Solvang","Brandt, Jørgen","Valencia, Victor H.","Münzel, Thomas","Sørensen, Mette"],"cuid":["S02-098.67-024149"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","Europe, Non-EU","OECD"],"country":["Germany","United Kingdom"],"glorg":["All Global Affiliations","Johannes Gutenberg University Mainz","University Medical Center Mainz","University of Surrey"],"keyword":["Cardiovascular disease","Cohort","Epidemiology","Traffic noise"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-NP","DI-U"],"level3":{"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-RUC"]},"level3all":["DI-NP-CAN","DI-U-AU","DI-U-KU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"long term exposure to transportation noise and risk for atrial fibrillation a danish nationwide cohort study","src":["au","ruc"],"src-code":["DI-U-AU","DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85116553399","version":"Other Version"},"id":"S02-098.67-024149","identifier":[{"id":"85116553399","type":"scopus"},{"id":"34619123","type":"pmid"}],"ids":["au-9d4fd7b3-dfad-4ad2-ab5f-88b97813b2ad","ruc-0583af61-5c47-4591-8408-e07c8cfac041"],"keyword":["Cardiovascular disease","Cohort","Epidemiology","Traffic noise"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-8526D15F1EC3A7B050032E10EBF9A3A6"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"dk","key":"dcrc danish cancer society research center","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-CAN","l3nn":"DCRC Danish Cancer Society Research Center","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DCRC Danish Cancer Society Research Center","namevar":["Danish Cancer Society"],"nora_code":"DI-NP-CAN","used":1},{"affno":"2","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Environmental Science"],"nora_code":"DI-U-AU","used":1},{"affno":"4","country":"gb","key":"university of surrey","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Surrey","used":1},{"affno":"5","country":"de","key":"johannes gutenberg university mainz","loc":["Germany","Europe, EU","OECD"],"name":"Johannes Gutenberg University Mainz","used":1},{"affno":"6","country":"de","key":"university medical center mainz","loc":["Germany","Europe, EU","OECD"],"name":"University Medical Center Mainz","used":1},{"affno":"7","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of Science and Environment"],"nora_code":"DI-U-RUC","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jesse D.","key":"thacherpau","last":"Thacher","name":"Thacher, Jesse D.","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Aslak Harbo","key":"poulsenpau","last":"Poulsen","name":"Poulsen, Aslak Harbo","rank":2,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Ulla Arthur","key":"hvidtfeldtpau","last":"Hvidtfeldt","name":"Hvidtfeldt, Ulla Arthur","rank":3,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"country":"dk","first":"Ole","key":"raaschounielsenpau","last":"Raaschou-Nielsen","locid":"9ae8831f-2034-4c09-84bc-01cd649e3b55","name":"Raaschou-Nielsen, Ole","rank":4,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"country":"dk","first":"Matthias","key":"ketzelpau","last":"Ketzel","locid":"798900d2-1d54-4c53-a4ca-671c12aa3015","name":"Ketzel, Matthias","orcid":"0000-0001-9519-1935","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Steen Solvang","key":"jensenpau","last":"Jensen","locid":"0d52f91a-4eaa-46f9-ab5f-d7fd3c31440d","name":"Jensen, Steen Solvang","orcid":"0000-0001-5923-8441","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Jørgen","key":"brandtpau","last":"Brandt","locid":"5f570c62-a5a5-4760-b7c7-8755b6e37ebf","name":"Brandt, Jørgen","orcid":"0000-0002-7580-9547","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Victor Hugo","key":"valenciaalvearpau","last":"Valencia Alvear","locid":"e073b447-a515-4272-887d-fe99110207e2","name":"Valencia, Victor H.","name_org":"Valencia Alvear, Victor Hugo","rank":8,"rolecode":"pau"},{"affno":"5 6","corresponding":null,"first":"Thomas","key":"münzelpau","last":"Münzel","name":"Münzel, Thomas","rank":9,"rolecode":"pau"},{"affno":"1 7","country":"dk","first":"Mette","key":"sørensenpau","last":"Sørensen","locid":"5bf2a665-def4-499c-9c63-0c440da72e20","name":"Sørensen, Mette","rank":10,"rolecode":"pau"}],"pmid":["34619123"],"pub":{"doi":"10.1016/j.envres.2021.112167","issn":["00139351","10960953"],"issn_org":["00139351"],"journal":"Environmental Research","paperid":"112167","publisher":"Academic Press Inc.","status":"p","title":"Environmental Research","volume":"207"},"review":"Peer Reviewed","scoID":["2-s2.0-85116553399"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Non-Profit Organisations","All Universities","DI-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Non-Profit Organisations","Roskilde University","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-9d4fd7b3-dfad-4ad2-ab5f-88b97813b2ad","ruc-0583af61-5c47-4591-8408-e07c8cfac041"],"src":["AU Aarhus University","RUC Roskilde University"],"title":"Long-term exposure to transportation noise and risk for atrial fibrillation : A Danish nationwide cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-098.67-024149","year":"2022","yearsub":"2022"}
{"abstract":"Objective: Air pollution, road traffic noise and lack of greenness coexist in urban environments and have all been associated with type 2 diabetes. We aimed to investigate how these co-exposures were associated with type 2 diabetes in a multi-exposure perspective. Methods: We estimated 5-year residential mean exposure to fine particles (PM2.5), ultrafine particles (UFP), elemental carbon (EC), nitrogen dioxide (NO2) and road traffic noise at the most (LdenMax) and least (LdenMin) exposed facade for all persons aged > 50 years living in Denmark in 2005 to 2017. For each air pollutant, we estimated total concentrations and traffic contributions. Based on land use maps, we estimated proportion of green and non-green space within 150 and 1000 m of all residences. In total, 1.9 million persons were included and 128,358 developed type 2 diabetes during follow-up. We performed analyses using Cox proportional hazards models, with adjustment for individual and neighborhood-level sociodemographic co-variates. Results: In single-pollutant models, all air pollutants, noise and lack of green space were associated with higher risk of diabetes. In two-, three- and four-pollutant analyses of the air pollutants, only UFP and NO2 remained associated with higher diabetes risk in all models. LdenMax, LdenMin and the two proxies of green space remained associated with diabetes in two-pollutant models of, respectively, noise and green space. In a multi-pollutant analysis, we found hazard ratios (95 % confidence intervals) per interquartile range of 1.021 (1.005; 1.038) for UFP, 1.012 (0.996; 1.028) for NO2, 1.022 (1.012; 1.033) for LdenMin, 1.013 (1.004; 1.022) for LdenMax, and 1.038 (1.031; 1.044) and 1.018 (1.010; 1.025) for lack of green space within, respectively, 150 m and 1000 m, and a cumulative risk index of 1.131 (1.113; 1.149). Conclusions: Air pollution, road traffic noise and lack of green space were independently associated with higher risk of type 2 diabetes.","author_count":11,"contributors":["Sørensen, Mette","Poulsen, Aslak H.","Hvidtfeldt, Ulla A.","Brandt, Jørgen","Frohn, Lise Marie","Ketzel, Matthias","Christensen, Jesper Heile","Im, Ulas","Khan, Jibran","Münzel, Thomas","Raaschou-Nielsen, Ole"],"cuid":["S02-100.00-027275"],"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","Europe, Non-EU","OECD"],"corresponding_author":["Sørensen, Mette"],"country":["Germany","United Kingdom"],"glorg":["All Global Affiliations","Johannes Gutenberg University Mainz","University Medical Center Mainz","University of Surrey"],"keyword":["Air pollution","Green space","Multi pollutant","Road traffic noise","Type 2 diabetes"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-NP","DI-OT","DI-U"],"level3":{"NP":["DI-NP-ALL","DI-NP-CAN"],"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-RUC"]},"level3all":["DI-NP-CAN","DI-U-AU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"air pollution road traffic noise and lack of greenness and risk of type 000000000002 diabetes a multi exposure prospective study covering denmark","src":["au","ruc"],"src-code":["DI-U-AU","DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.envint.2022.107570","version":"Published Version"},"id":"S02-100.00-027275","identifier":[{"id":"85142429625","type":"scopus"},{"id":"36334460","type":"pmid"}],"ids":["au-c95d54a7-28aa-4059-9960-3e806709ae25","ruc-16cbdf8a-7824-469d-bc07-cae374953ef3"],"keyword":["Air pollution","Green space","Multi-pollutant","Road traffic noise","Type 2 diabetes"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-C7D2036146DA1E9B8394686AFFEEFBC4"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.env