niversity of Copenhagen"],"PST":["Published"]},"sid":["ku-ce69e58c-17fe-41f3-afe8-56964ccad262"],"src":["KU University of Copenhagen"],"title":"Bridging the Gap From Proteomics Technology to Clinical Application : Highlights From the 68th Benzon Foundation Symposium","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-811079","year":"2024","yearsub":"2024"}
{"abstract":"OBJECTIVES To investigate associations between long term residential exposure to road traffic noise and particulate matter with a diameter <2.5 µm (PM2.5) and infertility in men and women. DESIGN Nationwide prospective cohort study. SETTING Denmark. PARTICIPANTS 526 056 men and 377 850 women aged 30-45 years, with fewer than two children, cohabiting or married, and residing in Denmark between 2000 and 2017. MAIN OUTCOME MEASURE Incident infertility in men and women during follow-up in the Danish National Patient Register. RESULTS Infertility was diagnosed in 16 172 men and 22 672 women during a mean follow-up of 4.3 years and 4.2 years, respectively. Mean exposure to PM2.5 over five years was strongly associated with risk of infertility in men, with hazard ratios of 1.24 (95% confidence interval 1.18 to 1.30) among men aged 30-36.9 years and 1.24 (1.15 to 1.33) among men aged 37-45 years for each interquartile (2.9 µg/m3) higher PM2.5 after adjustment for sociodemographic variables and road traffic noise. PM2.5 was not associated with infertility in women. Road traffic noise (Lden, most exposed facade of residence) was associated with a higher risk of infertility among women aged 35-45 years, with a hazard ratio of 1.14 (1.10 to 1.18) for each interquartile (10.2 dB) higher five year mean exposure. Noise was not associated with infertility among younger women (30-34.9 years). In men, road traffic noise was associated with higher risk of infertility in the 37-45 age group (1.06, 1.02 to 1.11), but not among those aged 30-36.9 years (0.93, 0.91 to 0.96). CONCLUSIONS PM2.5 was associated with a higher risk of an infertility diagnosis in men, whereas road traffic noise was associated with a higher risk of an infertility diagnosis in women older than 35 years, and potentially in men older than 37 years. If these results are confirmed in future studies, higher fertility could be added to the list of health benefits from regulating noise and air pollution.","author_count":8,"contributors":["Sørensen, Mette","Poulsen, Aslak Harbo","Nøhr, Bugge","Khan, Jibran","Ketzel, Matthias","Brandt, Jørgen","Raaschou-Nielsen, Ole","Jensen, Allan"],"cuid":["S02-091.56-761823"],"filters":{"added":"2024-11","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of Surrey"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-NP","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-ALL","DI-U-AU","DI-U-RUC"]},"level3all":["DI-HO-CAP","DI-NP-CAN","DI-U-AU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"long term exposure to road traffic noise and air pollution and risk of infertility in men and women nationwide danish cohort study","src":["au","ruc"],"src-code":["DI-U-AU","DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/bmj-2024-080664","version":"Published Version"},"id":"S02-091.56-761823","identifier":[{"id":"85203339106","type":"scopus"},{"id":"PMC11372855","type":"pmcid"},{"id":"39231578","type":"pmid"}],"ids":["au-b6c96424-4e31-4f73-b0a8-62c3fb06a2d0","ruc-a4f7c5a1-3e2a-48c6-a2df-c663737dc960"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-DCB21712611CC468DA70334376FF1572"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/106645460/bmj-2024-080664.full.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/bmj-2024-080664","version":"Published Version"}],"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of Science and Environment","Roskilde University, Department of Science and Environment, Molecular and Medical Biology"],"nora_code":"DI-U-RUC","used":1},{"affno":"2","country":"dk","key":"dcrc danish cancer society research center","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-CAN","l3nn":"DCRC Danish Cancer Society Research Center","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DCRC Danish Cancer Society Research Center","namevar":["Danish Cancer Society"],"nora_code":"DI-NP-CAN","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Herlev and Gentofte Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"4","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Environmental Science, Department of Environmental Science - Atmospheric Emissions & Modelling"],"nora_code":"DI-U-AU","used":1},{"affno":"5","country":"gb","key":"university of surrey","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Surrey","used":1}],"person":[{"affno":"1 2","country":"dk","first":"Mette","key":"sørensenpau","last":"Sørensen","locid":"5bf2a665-def4-499c-9c63-0c440da72e20","name":"Sørensen, Mette","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Aslak Harbo","key":"poulsenpau","last":"Poulsen","name":"Poulsen, Aslak Harbo","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Bugge","key":"nøhrpau","last":"Nøhr","name":"Nøhr, Bugge","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Jibran","key":"khanpau","last":"Khan","locid":"c8fe96cd-050e-4aa9-8303-e03e7e92bf3e","name":"Khan, Jibran","orcid":"0000-0003-2080-2871","rank":4,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"country":"dk","first":"Matthias","key":"ketzelpau","last":"Ketzel","locid":"798900d2-1d54-4c53-a4ca-671c12aa3015","name":"Ketzel, Matthias","orcid":"0000-0001-9519-1935","rank":5,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Jørgen","key":"brandtpau","last":"Brandt","locid":"5f570c62-a5a5-4760-b7c7-8755b6e37ebf","name":"Brandt, Jørgen","orcid":"0000-0002-7580-9547","rank":6,"rolecode":"pau"},{"affno":"2 4","corresponding":null,"country":"dk","first":"Ole","key":"raaschounielsenpau","last":"Raaschou-Nielsen","locid":"9ae8831f-2034-4c09-84bc-01cd649e3b55","name":"Raaschou-Nielsen, Ole","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Allan","key":"jensenpau","last":"Jensen","name":"Jensen, Allan","rank":8,"rolecode":"pau"}],"pmid":["39231578"],"pub":{"doi":"10.1136/bmj-2024-080664","issn":["09598146","17561833"],"issn_org":["09598146"],"journal":"BMJ","paperid":"e080664","publisher":"BMJ Publishing Group","status":"p","title":"BMJ","title_org":"BMJ (Clinical research ed.)","volume":"386"},"review":"Peer Reviewed","scoID":["2-s2.0-85203339106"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Non-Profit Organisations","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Hospitals","Non-Profit Organisations","Roskilde University","Universities"],"PST":["Published"]},"sid":["au-b6c96424-4e31-4f73-b0a8-62c3fb06a2d0","ruc-a4f7c5a1-3e2a-48c6-a2df-c663737dc960"],"src":["AU Aarhus University","RUC Roskilde University"],"title":"Long term exposure to road traffic noise and air pollution and risk of infertility in men and women : nationwide Danish cohort study","type":"Journal Article","