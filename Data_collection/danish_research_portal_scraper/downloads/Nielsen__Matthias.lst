{"author_count":11,"contributors":["Andersen, Zorana J.","Brebbia, Sara Ø.","Andersen, Klaus Kaae","Hvidberg, Martin","Jensen, Steen Solvang","Ketzel, Matthias","Loft, Steffen","Sørensen, Mette","Tjønneland, Anne","Overvad, Kim","Raaschou-Nielsen, Ole"],"cuid":["S01-000.00-237735"],"event":{"end":"2011-09-16","place":"Barcelona, es","start":"2011-09-13","title":"ISEE conference","year":"2011"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-NP","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-ALL","DI-U-AU","DI-U-DTU","DI-U-KU"]},"level3all":["DI-HO-CDR","DI-NP-CAN","DI-U-AU","DI-U-DTU","DI-U-KU"]},"review":"nr","rtype":["clu"],"sorti":"acute coronary syndrome and long term exposure to air pollution a cohort study","src":["au"],"src-code":["DI-U-AU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-237735","ids":["au-bdd88a7c-c1f3-4a86-9acd-ff850aa771ab"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-AD898CFE00AF71FEC8791C7E882166AD"],"org":[{"affno":"1","country":"dk","key":"dcrc danish cancer society research center","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-CAN","l3nn":"DCRC Danish Cancer Society Research Center","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DCRC Danish Cancer Society Research Center","namevar":["Danish Cancer Society"],"nora_code":"DI-NP-CAN","used":1},{"affno":"2","country":"dk","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark (DTU)"],"nora_code":"DI-U-DTU","used":1},{"affno":"3","key":"au aarh