"},{"affno":"1","corresponding":null,"first":"Gerard","key":"hoekpau","last":"Hoek","name":"Hoek, Gerard","rank":51,"rolecode":"pau"},{"affno":"5 6","corresponding":null,"first":"Evangelia","key":"samolipau","last":"Samoli","name":"Samoli, Evangelia","rank":52,"rolecode":"pau"}],"pmid":["34470785"],"pub":{"doi":"10.1136/bmj.n1904","issn":["09598146","17561833"],"issn_org":["09598146"],"journal":"BMJ","paperid":"n1904","publisher":"BMJ Publishing Group","status":"p","title":"BMJ","title_org":"BMJ (Clinical research ed.)","volume":"374"},"review":"Peer Reviewed","scoID":["2-s2.0-85114298591"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Non-Profit Organisations","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-NP","DI-NP-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Non-Profit Organisations","Other Hospitals","Other Research","Roskilde University","Universities","University of Copenhagen","dansk ramazzini center"],"PST":["Published"]},"sid":["au-dd84d1dd-0226-4953-92ed-9f24245f324e","ku-fa3546e6-6ed0-429b-980b-8d036de39a99","ruc-bdf81280-107f-4d91-a8db-c48bd5e4c140"],"src":["AU Aarhus University","KU University of Copenhagen","RUC Roskilde University"],"title":"Long term exposure to low level air pollution and mortality in eight European cohorts within the ELAPSE project : Pooled analysis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-088.71-666526","year":"2021","yearsub":"2021"}
{"abstract":"The integrated model system DEHM/UBM/AirGIS, developed at Aarhus University, Department of Environmental Science, has been extended with the dynamic aerosol module M7 to account for particle number concentrations of particles with diameters below 1 μm in the atmosphere. The aim of this development is to quantify the spatial and temporal distribution of particle number concentration across Denmark and evaluate the results with available measurements. This article presents model results for particle number concentrations from the regional scale model DEHM and the urban scale model UBM, for comparison with measurements of particle number concentrations from European and Danish measurement stations. The deterministic modelling of particle number concentration has been vitiated by the lack of consistency between emission inventories, and the evaluation of the models is challenged by the lack of consistent long-term measurements data. The performance evaluation of the DEHM and UBM models shows that both models overestimate the level of the particle number concentrations at all stations, however, the results for the correlation coefficients are 0.86 for DEHM and in the range from 0.86 to 0.87, for UBM, for annual mean particle number concentrations at Danish measurement stations. We conclude that the inclusion of particle number concentration in DEHM and UBM shows some capability of reproducing observed patterns, when comparing the results of the models with available measurements, but that there is also room for improvement, especially with respect to the emission inventories and preprocessing of emissions and to the treatment of volatile organic compounds based on natural emissions during summer time.","author_count":12,"contributors":["Frohn, Lise Marie","Ketzel, Matthias","Christensen, Jesper Heile","Brandt, Jørgen","Im, Ulas","Massling, Andreas","Andersen, Christopher","Plejdrup, Marlene Schmidt","Nielsen, Ole-Kenneth","Gon, Hugo Denier van der","Manders-Groot, Astrid","Raaschou-Nielsen, Ole"],"cuid":["S01-000.00-241444"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","OECD"],"corresponding_author":["Frohn, Lise Marie"],"country":["Netherlands","United Kingdom"],"glorg":["All Global Affiliations","Netherlands Organization for Applied Scientific Research (TNO)","University of Surrey"],"keyword":["Air pollution modelling","Particle dynamics","Ultrafine particles"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-NP","DI-U"],"level3":{"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-NP-CAN","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"modelling ultrafine particle number concentrations at address resolution in denmark from 000000001979 000000002018 part 000000000001 regional and urban scale modelling and evaluation","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.atmosenv.2021.118631","version":"Published Version"},"id":"S01-000.00-241444","identifier":[{"id":"85113433025","type":"scopus"}],"ids":["au-c46e0d54-6dac-4eac-8fef-14d0f7f7e51b"],"keyword":["Air pollution modelling","Particle dynamics","Ultrafine particles"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-4-8-08A58D8A7AA30E12EE38614B1DEED9B8"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.atmosenv.2021.118631","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.au.dk/ws/files/273780341/1_s2.0_S1352231021004532_main.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3