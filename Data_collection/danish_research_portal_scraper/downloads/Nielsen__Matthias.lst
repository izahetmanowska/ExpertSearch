a12f-ce9982a1cdeb","name":"Andersen, Christopher","orcid":"0000-0002-2337-8239","rank":8,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Victor Hugo","key":"valenciaalvearpau","last":"Valencia Alvear","locid":"e073b447-a515-4272-887d-fe99110207e2","name":"Valencia, Victor H.","name_org":"Valencia Alvear, Victor Hugo","rank":9,"rolecode":"pau"},{"affno":"5","first":"Christina Funch","key":"lassenpau","last":"Lassen","name":"Lassen, Christina Funch","rank":10,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"country":"dk","first":"Ole","key":"raaschounielsenpau","last":"Raaschou-Nielsen","locid":"9ae8831f-2034-4c09-84bc-01cd649e3b55","name":"Raaschou-Nielsen, Ole","rank":11,"rolecode":"pau"}],"pmid":["36802347"],"pub":{"doi":"10.1289/ehp11347","issn":["00916765","15529924"],"issn_org":["00916765"],"issue":"2","journal":"Environmental Health Perspectives","paperid":"027008","publisher":"Public Health Services, US Dept of Health and Human Services","status":"p","title":"Environmental Health Perspectives","volume":"131"},"review":"Peer Reviewed","scoID":["2-s2.0-85148382712"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Non-Profit Organisations","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Hospitals","Non-Profit Organisations","Roskilde University","Universities"],"PST":["Published"]},"sid":["au-3b535ee6-ae1f-4730-a2c6-06e128a024d4","ruc-9296d1eb-ecc9-4de8-b654-49d791801d4f"],"src":["AU Aarhus University","RUC Roskilde University"],"title":"Effects of Sociodemographic Characteristics, Comorbidity, and Coexposures on the Association between Air Pollution and Type 2 Diabetes : A Nationwide Cohort Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-097.87-741775","year":"2023","yearsub":"2023"}
{"abstract":"Patients with multiple sclerosis (MS) and spinal cord injury (SCI) commonly sustain central neuropathic pain (NP) and spasticity. Despite a lack of consistent evidence, cannabis-based medicine (CBM) has been suggested as a supplement treatment. We aimed to investigate the effect of CBM on NP and spasticity in patients with MS or SCI. We performed a randomized, double-blinded, placebo-controlled trial in Denmark. Patients aged ≥18 years with NP (intensity >3, ≤9 on a numerical rating scale (NRS0-10) and/or spasticity (>3 on NRS0-10) were randomized to treatment consisting of either delta-9-tetrahydrocannabinol (THC), cannabidiol (CBD), a combination of THC&CBD in maximum doses of 22.5 mg, 45 mg and 22.5/45 mg per day, respectively, or placebo. A baseline registration was performed before randomization. Treatment duration was six weeks followed by a one-week phaseout. Primary endpoints were the intensity of patient-reported NP and/or spasticity. Between February 2019 and December 2021, 134 patients were randomized (MS n = 119, SCI n = 15), where 32 were assigned to THC, 31 to CBD, 31 to THC&CBD, and 40 to placebo. No significant difference was found for: mean pain intensity (THC 0.42 (−0.54–1.38), CBD 0.45 (−0.47–1.38) and THC&CBD 0.16 (−0.75–1.08)), mean spasticity intensity (THC 0.24 (−0.67–1.45), CBD 0.46 (−0.74–1.65), and THC&CBD 0.10 (−1.18–1.39), secondary outcomes (patient global impression of change and quality of life), or any tertiary outcomes. We aimed to include 448 patients in the trial; however, due to COVID-19 and recruitment challenges, fewer were included. Nevertheless, in this four-arm parallel trial, no effect was found between placebo and active treatment with THC or CBD alone or in combination on NP or spasticity in patients with either MS or SCI. The trial was registered with the EU Clinical Trials Register EudraCT (2018-002315-98).","author_count":23,"contributors":["Hansen, Julie Schjødtz","Gustavsen, Stefan","Roshanisefat, Homayoun","Kant, Matthias","Biering-Sørensen, Fin","Andersen, Claus","Olsson, Anna","Chow, Helene Højsgaard","Asgari, Nasrin","Richter Hansen, Julie","Nielsen, Helle Hvilsted","Hansen, Rikke Bod Middelhede","Petersen, Thor","Oturai, Annette Bang","Sellebjerg, Finn Thorup","Sædder, Eva Aggerholm","Kasch, Helge","Rasmussen, Peter Vestergaard","Finnerup, Nanna Brix","Svendsen, Kristina Bacher"],"cuid":["S02-098.76-685835"],"filters":{"added":"2023-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Hansen, Julie Schjødtz"],"keyword":["Spasticity","cannabidiol CBD","cannabis based medicine CBM","delta 9 tetrahydrocannabinol THC","neuropathic pain NP"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-SDR","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"cannabis based medicine for neuropathic pain and spasticity a multicenter randomized double blinded placebo controlled trial","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/ph16081079","version":"Published Version"},"funding_acknowledgement":["The Danish Ministry of Health, The Danish Multiple Sclerosis Society, Bdr. Hartmann Foundation, Karen A Tolstrup Foundation, “Direktør Ejnar Jonasson kaldet Johnsen og Hustru’s Mindelegat”, Foundation for Research in Neurology, Lykfeldts Fond, and Familien Hede Nielsens Fond. J.S.H., J.R.H., C.A., M.K., H.R., A.O., H.H.N., E.A.S., N.A. and F.B.-S. declare no conflicts of interest. S.G. has received support for congress participation from Merck. H.K. has served on scientific advisory boards for Lundbeck A/S and Novartis and has received travel grants from IPSEN and Merck. K.B.S. has served as a consultant for Takeda Pharma A/S and received travel grants from TEVA, Biogen, Merck, and Novartis. N.B.F. has received consultancy fees from Almirall, NeuroPN, Vertex, Nanobiotix, and Novartis Pharma, and has undertaken consultancy work for Aarhus University with remunerated work for Biogen, Merz, and Confo Therapeutics. She has received grants from IMI2PainCare, an EU IMI 2 (Innovative Medicines Initiative) public-private consortium, and the companies involved are Grunenthal, Bayer, Eli Lilly, Esteve, and Teva. P.V.R. has received speaker honoraria from Biogen, Roche, Merck, Alexion, and Novartis; support for congress participation from Merck, Roche, and Sanofi; and fees for serving on advisory boards from Bristol–Myers–Squibb, Merck, Roche, Novartis, Biogen, Sanofi, and Alexion. H.H.C. reports non-financial support from Merck, non-financial support from Teva, non-financial support from Biogen, and non-financial support from Roche, outside the submitted work. F.S. has served on scientific advisory boards, as a consultant for, supported congress participation, or received speaker honoraria from Alexion, Biogen, Bristol–Myers–Squibb, H. Lundbeck A/S, Merck, Novartis, Roche, and Sanofi Genzyme. His laboratory has received research support from Biogen, Merck, Novartis, Roche, and Sanofi Genzyme. RMH has received support for congress participation from Merck, Ipsen, and speaker honoraria from AbbVie. ABO has served on scientific advisory boards for Biogen Idec, Novartis, and Sanofi Genzyme; has received research support from Novartis; has received speaker honoraria from Biogen, Novartis, and TEVA; and has received support for congress participation from Merck, TEVA, Biogen, Roche, Novartis, and Sanofi Genzyme. T.P. has received research support for the MS clinic at Aarhus University Hospital from Merck, Alexion, Roche, Biogen, Novartis, and Sanofi."],"id":"S02-098.76-685835","identifier":[{"id":"PMC10459421","type":"pmci