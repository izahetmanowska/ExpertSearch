me":"Brandt, Jørgen","orcid":"0000-0002-7580-9547","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Steen Solvang","key":"jensenpau","last":"Jensen","locid":"0d52f91a-4eaa-46f9-ab5f-d7fd3c31440d","name":"Jensen, Steen Solvang","orcid":"0000-0001-5923-8441","rank":7,"rolecode":"pau"},{"affno":"3 2","corresponding":null,"first":"Kim","key":"overvadpau","last":"Overvad","locid":"7ca4bfca-d3a3-484e-8ee5-d7cb6ad7314b","name":"Overvad, Kim","orcid":"0000-0001-6429-7921","rank":8,"rolecode":"pau"},{"affno":"4 5","first":"Anne","key":"tjønnelandpau","last":"Tjønneland","locid":"853b23de-35d6-44f7-88fa-edbe4a4f8b6d","name":"Tjønneland, Anne","orcid":"0000-0003-4385-2097","rank":9,"rolecode":"pau"},{"affno":"6 7 8","corresponding":null,"first":"Thomas","key":"münzelpau","last":"Münzel","name":"Münzel, Thomas","rank":10,"rolecode":"pau"},{"affno":"","first":"Thomas","key":"muenzelpau","last":"Muenzel","name":"Muenzel, Thomas","rank":10,"rolecode":"pau"},{"affno":"1 9","country":"dk","first":"Mette","key":"sørensenpau","last":"Sørensen","locid":"5bf2a665-def4-499c-9c63-0c440da72e20","name":"Sørensen, Mette","rank":11,"rolecode":"pau"}],"pmid":["32442789"],"pub":{"doi":"10.1016/j.envres.2020.109633","issn":["00139351","10960953"],"issn_org":["00139351"],"issue":"2020","journal":"Environmental Research","paperid":"109633","publisher":"Academic Press Inc.","status":"p","title":"Environmental Research","volume":"187"},"review":"Peer Reviewed","scoID":["2-s2.0-85084751937"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Non-Profit Organisations","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-NP","DI-NP-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Non-Profit Organisations","North Denmark Region","Other Research","Roskilde University","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-6e0ac84e-50f5-4305-9a53-712030af0f6c","au-b8c2afa6-29ce-40e8-8cd3-407c32694a44","ku-d10a8638-50d7-4914-a398-c8bfd896ef8c","ruc-2f30e2d8-6315-4242-94c2-19aba2b6f9f4"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","RUC Roskilde University"],"title":"Long-term residential road traffic noise and mortality in a Danish cohort","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-099.11-792903","year":"2020","yearsub":"2020"}
{"abstract":"Design parameters of a pellet mill die for pellet production are essential for running optimal pellet production in terms of energy consumption and quality of the pellets. In this study, the effects of the countersink angle and depth are investigated through experimental tests and Computational Fluid Dynamics (CFD) simulations. Inlet die designs with angles 0°, 60°, and 100° and three different depths, were tested via single pelleting tests with spruce. A new design parameter, AR, is suggested for comparison of the dies performances. The parameter is derived from the die's surface area, and is the ratio of the die's inlet area vs. total surface area and values tested here ranged 0.35 to 1. Specific energy consumption and mechanical pellet durability were measured experimentally, and the feedstock layer profiles in pellets were qualitatively analyzed via image processing. The layer profiles in the pellets were simulated with a CFD model using a simple Bingham viscosity model. The model was validated by comparing the simulated and experimentally obtained layer profiles. The results show that the lowest energy consumption was obtained with a 60° countersink and an AR value of 0.6–0.8. Furthermore, an AR value in this range were found to be optimal with respect to pellet durability. Analysis of the layer profiles shows interesting differences in the layer profiles of the pellets, and evaluation of the kurtosis of the layer profiles suggests that this can be used to predict the pellet durability and, thereby, the quality of the die design.","author_count":2,"contributors":["Nielsen, Simon Klinge","Mandø, Matthias"],"cuid":["S01-000.00-086472"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Biofuel","CFD","Image processing","Pelleting","Rheology","Simulation"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"experimental and numerical investigation of die designs in biomass pelleting and the effect on layer formation in pellets","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85092054180&partnerID=8YFLogxK","version":"Other Version"},"id":"S01-000.00-086472","identifier":[{"id":"85092054180","type":"scopus"}],"ids":["aau-7d4a713a-365b-4075-bff5-a6b5a0e08625"],"keyword":["Biofuel","CFD","Image processing","Pelleting","Rheology","Simulation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-C14A405C347BE59892C963569C5D20C4"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, AAU Energy","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Esbjerg Energy Section"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Simon Klinge","key":"nielsenpau","last":"Nielsen","locid":"d91cdb12-87dc-438a-8e14-f1ef8b16ab53","name":"Nielsen, Simon Klinge","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Matthias","key":"mandøpau","last":"Mandø","locid":"78efaa5a-edc5-4ba2-bf4a-36a9bcfd7c33","name":"Mandø, Matthias","orcid":"0000-0002-5692-278X","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.biosystemseng.2020.08.010","issn":["15375110","15375129"],"issn_org":["15375110"],"journal":"Biosystems Engineering","pages":"185-197","publisher":"Academic Press","status":"p","title":"Biosystems Engineering","volume":"198"},"review":"Peer Reviewed","scoID":["2-s2.0-85092054180"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-7d4a713a-365b-4075-bff5-a6b5a0e08625"],"src":["AAU Aalborg University"],"title":"Experimental and numerical investigation of die designs in biomass pelleting and the effect on layer formation in pellets","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-086472","year":"2020","yearsub":"2020"}
