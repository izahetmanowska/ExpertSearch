L","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-86bcb394-1ae9-41b8-a361-bea6c7e89d83","ku-db14233e-11e6-4c99-84f1-952a498004b1"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Diabetes Incidence and Long-Term Exposure to Air Pollution: A cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-081.55-022478","year":"2012","yearsub":"2012"}
