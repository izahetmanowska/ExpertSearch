DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-6df480ee-f8f4-4410-9aa1-611bea4c4be6"],"src":["AU Aarhus University"],"title":"Evaluation of AirGIS: a GIS-based air pollution and human exposure modelling system","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-192072","year":"2011","yearsub":"2011"}
{"author_count":10,"contributors":["Raaschou-Nielsen, Ole Lundsgaard","Andersen, Z.","Hvidberg, Martin","Jensen, Steen Solvang","Ketzel, Matthias","Sørensen, M.","Hansen, J.","Loft, Steffen","Overvad, Kim","Tjønneland, A."],"cuid":["S01-000.00-221783"],"event":{"end":"2011-09-16","place":"Barcelona, es","start":"2011-09-13","title":"23rd Conference of the International Society For Environmental Epidemiology","year":"2011"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"air pollution from traffic and cancer incidence in a danish cohort","src":["au"],"src-code":["DI-U-AU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-221783","ids":["au-a23ebffd-aed7-447e-a0cb-b45dd9a6ca2d"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-166A0AF6E7FAF073130FB715F57BE199"],"org":[{"affno":"1","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Det Sundhedsvidenskabelige Fakultet AU (historisk)"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Ole Lundsgaard","key":"raaschounielsenpau","last":"Raaschou-Nielsen","name":"Raaschou-Nielsen, Ole Lundsgaard","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Z.","key":"andersenpau","last":"Andersen","name":"Andersen, Z.","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Martin","key":"hvidbergpau","last":"Hvidberg","locid":"caad0d45-bf3a-4a5f-ae85-b78a367b5186","name":"Hvidberg, Martin","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Steen Solvang","key":"jensenpau","last":"Jensen","locid":"0d52f91a-4eaa-46f9-ab5f-d7fd3c31440d","name":"Jensen, Steen Solvang","orcid":"0000-0001-5923-8441","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Matthias","key":"ketzelpau","last":"Ketzel","locid":"798900d2-1d54-4c53-a4ca-671c12aa3015","name":"Ketzel, Matthias","orcid":"0000-0001-9519-1935","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"M.","key":"sørensenpau","last":"Sørensen","name":"Sørensen, M.","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"J.","key":"hansenpau","last":"Hansen","name":"Hansen, J.","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Steffen","key":"loftpau","last":"Loft","name":"Loft, Steffen","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kim","key":"overvadpau","last":"Overvad","locid":"83738c57-45d4-41e0-b807-ad0f6dec597c","name":"Overvad, Kim","orcid":"0000-0001-6429-7921","rank":9,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"A.","key":"tjønnelandpau","last":"Tjønneland","name":"Tjønneland, A.","rank":10,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-a23ebffd-aed7-447e-a0cb-b45dd9a6ca2d"],"src":["AU Aarhus University"],"title":"Air pollution from traffic and cancer incidence in a Danish cohort","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-221783","year":"2011","yearsub":"2011"}
{"abstract":"In this paper, a new assessment system is presented to evaluate infrastructure objects such as roads after natural disasters in near-realtime. A particular aim is the exploitation of multi-sensorial and multi-temporal imagery together with further {GIS-}data in a comprehensive assessment framework. The combination is accomplished combining probabilities derived from the different data sets. The assessment system is applied to two different test scenarios evaluating roads after flooding yielding very promising results and evaluation values concerning completeness and correctness. The benefit of the data combination, in particular the multi-temporal component, demonstrates the suitability of the proposed method for different application scenarios.","author_count":4,"contributors":["Butenuth, Matthias","Frey, Daniel","Nielsen, Allan Aasbjerg","Skriver, Henning"],"cuid":["S01-000.00-312365"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","Technical University of Munich"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"infrastructure assessment for disaster management using multi sensor and multi temporal remote sensing imagery","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1080/01431161.2010.542204","version":"Other Version"},"id":"S01-000.00-312365","identifier":[{"id":"79957667002","type":"scopus"}],"ids":["dtu-19ebd609-dbed-46f7-8dd5-4558eee07f8a"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-D36C7114117F5774477891E407DAC7F7"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1080/01431161.2010.542204","version":"Other Version"}],"org":[{"affno":"1","country":"de","key":"technical university of munich","loc":["Germany","Europe, EU","OECD"],"name":"Technical University of Munich","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Informatics and Mathematical Modeling","Technical University of Denmark, Department of Informatics and Mathematical Modeling, Image Analysis and Computer Graphics","Technical University of Denmark, National Space Institute","Technical University of Denmark, National Space Institute, Geodesy"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Matthias","key":"butenuthpau","last":"Butenuth","name":"Butenuth, Matthias","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Daniel","key":"freypau","last":"Frey","name":"Frey, Daniel","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Allan Aasbjerg","key":"nielsenpau","last":"Nielsen","locid":"599cc930-55d0-449f-ac37-2f7c5d74378a","name":"Nielsen, Allan Aasbjerg","orcid":"0000-0002-4837-9449","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Henning","key":"skriverpau","last":"Skriver","locid":"5c54754a-44e9-45b6-a942-8af753d07726","name":"Skriver, Henning","orcid":"0000-0002-7938-7476","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1080/01431161.2010.542204","issn":["01431161","13665901"],"issn_org":["01431161"],"issue":"23","journal":"International Journal of Remote Sensing","pages":"8575-8594","publisher":"Taylor and Francis Ltd.","status":"p","title":"International Journal of Remote Sensing","volume":"32"},"review":"Peer Reviewed","scoID":["2-s2.0-79957667002"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-19ebd609-dbed-46f7-8dd5-4558eee07f8a"],"src":["DTU Technical University of Denmark"],"title":"Infrastructure assessment for disaster management using multi-sensor and multi-temporal remote sensing imagery","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-312365","year":"2011","yearsub":"2011"}
{"abstract":"Post-translational modification of proteins by ubiquitin is a fundamentally important regulatory mechanism. However, proteome-wide analysis of endogenous ubiquitylation remains a challenging task, and almost always has relied on cells expressing affinity tagged ubiquitin. Here we combine single-step immunoenrichment of ubiquitylated peptides with peptide fractionation and high-resolution mass spectrometry to investigate endogenous ubiquitylation sites. We precisely map 11,054 endogenous putative ubiquitylation sites (diglycine-modified lysines) on 4,273 human proteins. The presented data set covers 67% of the known ubiquitylation sites and contains 10,254 novel sites on proteins with diverse cellular functions including cell signaling, receptor endocytosis, DNA replication, DNA damage repair, and cell cycle progression. Our method enables site-specific quantification of ubiquitylation in response to cellular perturbations and is applicable to any cell type or tissue. Global quantification of ubiquitylation in cells treated with the proteasome inhibitor MG-132 discovers sites that are involved in proteasomal degradation, and suggests a nonproteasomal function for almost half of all sites. Surprisingly, ubiquitylation of about 15% of sites decreased more than twofold within four hours of MG-132 treatment, showing that inhibition of proteasomal function can dramatically reduce ubiquitylation on many sites with non-proteasomal functions. Comparison of ubiquitylation sites with acetylation sites reveals an extensive overlap between the lysine residues targeted by these two modifications. However, the crosstalk between these two post-translational modifications is significantly less frequent on sites that show increased ubiquitylation upon proteasome inhibition. Taken together, we report the largest site-specific ubiquitylation dataset in human cells, and for the first time demonstrate proteome-wide, site-specific quantification of endogenous putative ubiquitylation sites.","author_count":7,"contributors":["Wagner, Sebastian A","Beli, Petra","Weinert, Brian T","Nielsen, Michael L.","Cox, Jürgen","Mann, Matthias","Choudhary, Chuna Ram"],"cuid":["S01-000.00-525467"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"a proteome wide quantitative survey of in vivo ubiquitylation sites reveals widespread regulatory roles","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1074/mcp.M111.013284","version":"Other Version"},"id":"S01-000.00-525467","identifier":[{"id":"80054033461","type":"scopus"},{"id":"PMC3205876","type":"pmcid"},{"id":"21890473","type":"pmid"}],"ids":["ku-dcffd1de-0f01-4580-8bd3-c964c4b2756f"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-7528FE90544902684E023A2274AF467F"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1074/mcp.M111.013284","version":"Other Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Protein Research, Proteomics Program"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Sebastian Alexander","key":"wagnerpau","last":"Wagner","locid":"aaf9b200-0a80-4014-ba01-2185ce0724f5","name":"Wagner, Sebastian A","name_org":"Wagner, Sebastian Alexander","rank":1,"rolecode":"pau"},{"affno":"1","first":"Petra","key":"belipau","last":"Beli","locid":"fd532bee-baa2-4159-9123-896bdaf62a03","name":"Beli, Petra","rank":2,"rolecode":"pau"},{"affno":"1","first":"Brian Tate","key":"weinertpau","last":"Weinert","locid":"3d27a4b2-413e-44e3-ba78-f39cea2f8b7f","name":"Weinert, Brian T","name_org":"Weinert, Brian Tate","orcid":"0000-0002-1335-9915","rank":3,"rolecode":"pau"},{"affno":"1","first":"Michael Lund","key":"nielsenpau","last":"Nielsen","locid":"b72d98f7-79fa-43a7-8066-783ed8034146","name":"Nielsen, Michael L.","name_org":"Nielsen, Michael Lund","orcid":"0000-0002-0067-9039","rank":4,"rolecode":"pau"},{"affno":"","first":"Jürgen","key":"coxpau","last":"Cox","name":"Cox, Jürgen","rank":5,"rolecode":"pau"},{"affno":"1","first":"Matthias","key":"mannpau","last":"Mann","locid":"f463f571-68c5-44fb-bff1-bb9d748fcda8","name":"Mann, Matthias","orcid":"0000-0003-1292-4799","rank":6,"rolecode":"pau"},{"affno":"1","first":"Chuna Ram","key":"choudharypau","last":"Choudhary","locid":"e44b2c69-62c8-4bfc-8f6a-9f91fdd45e86","name":"Choudhary, Chuna Ram","orcid":"0000-0002-9863-433X","rank":7,"rolecode":"pau"}],"pmid":["21890473"],"pub":{"doi":"10.1074/mcp.m111.013284","issn":["15359476","15359484"],"issn_org":["15359476"],"issue":"10","journal":"Molecular and Cellular Proteomics","status":"p","title":"Molecular and Cellular Proteomics","volume":"10"},"review":"Peer Reviewed","scoID":["2-s2.0-80054033461"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-dcffd1de-0f01-4580-8bd3-c964c4b2756f"],"src":["KU University of Copenhagen"],"title":"A Proteome-wide, Quantitative Survey of In Vivo Ubiquitylation Sites Reveals Widespread Regulatory Roles","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-525467","year":"2011","yearsub":"2011"}
