solarpau","last":"Solar","name":"Solar, Miroslav","rank":48,"rolecode":"pau"},{"affno":"4","first":"Theis","key":"langepau","last":"Lange","locid":"e4664578-01fc-4a93-8efd-1dbffb72cdd6","name":"Lange, Theis","orcid":"0000-0001-6807-8347","rank":49,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ola","key":"borgquistpau","last":"Borgquist","name":"Borgquist, Ola","rank":49,"rolecode":"pau"},{"affno":"4 29","first":"Niklas","key":"nielsenpau","last":"Nielsen","locid":"7f5e02f9-db74-437d-a29e-60baae07f850","name":"Nielsen, Niklas","rank":50,"rolecode":"pau"}],"pmid":["34133859"],"pub":{"doi":"10.1056/nejmoa2100591","issn":["00284793","15334406"],"issn_org":["00284793"],"issue":"24","journal":"The New England Journal of Medicine","pages":"2283-2294","status":"p","title":"The New England Journal of Medicine","title_org":"New England Journal of Medicine","volume":"384"},"review":"Peer Reviewed","scoID":["2-s2.0-85108262132"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-f4f7b09d-7df8-4e82-a015-41a26462eb32","sdu-2a51c7cc-4967-4a39-aa07-b08725f9b576"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Hypothermia versus Normothermia after Out-of-Hospital Cardiac Arrest","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-096.21-047416","year":"2021","yearsub":"2021"}
{"abstract":"Purpose: The etiology of Hodgkin lymphoma (HL) is obscure. Research on air pollution and risk of HL provides inconsistent results. We aimed to investigate the association between long-term residential exposure to air pollution and risk of adult Hodgkin lymphoma in Denmark. Methods: We performed a nationwide register-based case–control study, including all (n = 2,681) Hodgkin lymphoma cases registered in the nationwide Danish Cancer Registry between 1989 and 2014. We randomly selected 8,853 age- and sex-matched controls from the entire Danish population using the Civil Registration System, and identified 20-year residential address history for all cases and controls. We modeled outdoor air pollution concentrations at all these addresses using the high-resolution multiscale air pollution model system DEHM/UBM/AirGIS. We used conditional logistic regression to estimate odds ratios adjusted for individual and neighborhood level sociodemographic variables. Results: There was no association between 1, 5, 10, and 20 years’ time-weighted average exposure to fine particles (PM2.5), O3, SO2, NO2, or the PM2.5 constituents OC, NH4, NO3, and SO4 and risk of Hodgkin lymphoma. Conclusion: Residential exposure to ambient air pollution does not seem to increase the risk of developing Hodgkin lymphoma.","author_count":9,"contributors":["Taj, Tahir","Poulsen, Aslak Harbo","Ketzel, Matthias","Geels, Camilla","Brandt, Jørgen","Christensen, Jesper Heile","Hvidtfeldt, Ulla Arthur","Sørensen, Mette","Raaschou-Nielsen, Ole"],"cuid":["S02-100.00-018328"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, Non-EU","OECD"],"corresponding_author":["Taj, Tahir"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of Surrey"],"keyword":["Air pollution","Case control","Hodgkin lymphoma","Long term exposure"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-NP","DI-U"],"level3":{"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-ALL","DI-U-AU","DI-U-RUC"]},"level3all":["DI-NP-CAN","DI-U-AU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"long term residential exposure to air pollution and hodgkin lymphoma risk among adults in denmark a population based case control study","src":["au","ruc"],"src-code":["DI-U-AU","DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85107025944","version":"Other Version"},"funding_acknowledgement":["The research was funded by Nordforsk under the Nordic Programme on Health and Welfare (Project #75007: NordicWelfAir—Understanding the link between Air pollution and Distribution of related Health Impacts and Welfare in the Nordic countries). The funding source had no involvement in the study design, collection, analysis, interpretation, writing and decision to submit for publication. The research was funded by Nordforsk under the Nordic Programme on Health and Welfare (Project #75007: NordicWelfAir Understanding the link between Air pollution and Distribution of related Health Impacts and Welfare in the Nordic countries)."],"id":"S02-100.00-018328","identifier":[{"id":"34050843","type":"pmid"},{"id":"85107025944","type":"scopus"}],"ids":["au-4d9df9da-296f-4786-ad8d-08b3268f921a","ruc-b905ea83-0be9-49dc-a7f3-b1c5249c00f5"],"keyword":["Air pollution","Case–control","Hodgkin lymphoma","Long-term exposure"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-8A2E03875FA43B9345E9224B5CBCBF47"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"dk","key":"dcrc danish cancer society research center","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-CAN","l3nn":"DCRC Danish Cancer Society Research Center","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DCRC Danish Cancer Society Research Center","namevar":["Danish Cancer Society"],"nora_code":"DI-NP-CAN","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Environmental Science, Department of Environmental Science - Atmospheric Emissions & Modelling"],"nora_code":"DI-U-AU","used":1},{"affno":"3","country":"gb","key":"university of surrey","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Surrey","used":1},{"affno":"4","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of Science and Environment"],"nora_code":"DI-U-RUC","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Tahir","key":"tajpau","last":"Taj","name":"Taj, Tahir","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Aslak Harbo","key":"poulsenpau","last":"Poulsen","name":"Poulsen, Aslak Harbo","rank":2,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"country":"dk","first":"Matthias","key":"ketzelpau","last":"Ketzel","locid":"798900d2-1d54-4c53-a4ca-671c12aa3015","name":"Ketzel, Matthias","orcid":"0000-0001-9519-1935","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Camilla","key":"geelspau","last":"Geels","locid":"fbcefbda-1f0a-4649-8234-28012f2714d6","name":"Geels, Camilla","orcid":"0000-0003-2549-1750","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jørgen","key":"brandtpau","last":"Brandt","locid":"5f570c62-a5a5-4760-b7c7-8755b6e37ebf","name":"Brandt, Jørgen","orcid":"0000-0002-7580-9547","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jesper Heile","key":"christensenpau","last":"Christensen","locid":"5d084fe1-5909-4b7f-ac1a-907f4a30089e","name":"Christensen, Jesper Heile","orcid":"0000-0002-6741-5839","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ulla Arthur","key":"hvidtfeldtpau","last":"Hvidtfeldt","name":"Hvidtfeldt, Ulla Arthur","rank":7,"rolecode":"pau"},{"affno":"1 4","country":"dk","first":"Mette","key":"sørensenpau","last":"Sørensen","locid":"5bf2a665-def4-499c-9c63-0c440da72e20","name":"Sørensen, Mette","rank":8,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Ole","key":"raaschounielsenpau","last":"Raaschou-Nielsen","locid":"9ae8831f-2034-4c09-84bc-01cd649e3b55","name":"Raaschou-Nielsen, Ole","rank":9,"rolecode":"pau"}],"pmid":["34050843"],"pub":{"doi":"10.1007/s10552-021-01446-w","issn":["09575243","15737225"],"issn_org":["09575243"],"issue":"9","journal":"Cancer Causes & Control","pages":"935-942","publisher":"Springer Science and Business Media Deutschland GmbH","status":"p","title":"Cancer Causes & Control","volume":"32"},"review":"Peer Reviewed","scoID":["2-s2.0-85107025944"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Non-Profit Organisations","All Universities","DI-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Non-Profit Organisations","Roskilde University","Universities"],"PST":["Published"]},"sid":["au-4d9df9da-296f-4786-ad8d-08b3268f921a","ruc-b905ea83-0be9-49dc-a7f3-b1c5249c00f5"],"src":["AU Aarhus University","RUC Roskilde University"],"title":"Long-term residential exposure to air pollution and Hodgkin lymphoma risk among adults in Denmark : a population-based case–control study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-018328","year":"2021","yearsub":"2021"}
{"abstract":"Background: Leukemia is one of the most common forms of hematologic malignancy, which can affect people of all ages. We previously showed an association between exposure to ambient particulate matter 2.5 μg (PM2.5) and risk for leukemia in adults. The aim of this study was to investigate which PM2.5 constituents were responsible for our previous observation. Methods: This is a nationwide register-based case-control study. We identified 14,983 persons diagnosed with leukemia at age 20 or above, 1989–2014, in the Danish Cancer Registry. We selected up to four sex and age-matched controls per case at random from the entire Danish population (n = 51,613). We modelled concentrations of ambient PM2.5 and its constituents at the addresses of cases and controls for the 10-year period before index date with a state-of-the-art multiscale air pollution modeling system. We used conditional logistic regression to estimate odds ratios (ORs) adjusted for individual and neighborhood level socio-demographic variables. Result: The results showed higher risk for overall leukemia in association with interquartile range exposure to PM2.5 (OR = 1.09; 95% CI: 1.02, 1.17), black carbon (BC) (OR = 1.02; 95% CI: 1.00, 1.03), secondary inorganic aerosols (SIA) (OR = 1.15; 95% CI: 1.03, 1.29) and its components ammonium (NH4) (OR = 1.08; 95% CI: 1.00, 1.17) and nitrate (NO3) (OR = 1.08; 95% CI: 1.02, 1.14). In leukemia subtype analysis, statistically significant associations were found for AML with PM2.5 (OR = 1.14; 95% CI: 1.00, 1.29), BC (OR = 1.03; 95% CI: 1.00, 1.07), SIA (OR = 1.23; 95% CI: 1.01, 1.51), NH4 (OR = 1.16; 95% CI: 1.01, 1.34) and NO3 (OR = 1.12; 95% CI: 1.01, 1.24). The association between PM2.5 and leukemia persisted in two pollutants models including sum of primary emitted black and organic carbon (BC + OC), secondary organic aerosols (SOA), or sea-salt. The association between black carbon (BC) and leukemia persisted in two pollutants models including organic carbon (OC). The three pollutant model with sulfate (SO4), NH4 and NO3 showed an association with NO3 but not with SO4 or NH4. Conclusion: Ambient concentrations of the PM2.5 components BC, NH4 and NO3 at the residence showed associations with risk of incident leukemia in adults.","author_count":10,"contributors":["Taj, Tahir","Poulsen, Aslak Harbo","Ketzel, Matthias","Geels, Camilla","Brandt, Jørgen","Christensen, Jesper Heile","Puett, Robin","Hvidtfeldt, Ulla Arthur","Sørensen, Mette","Raaschou-Nielsen, Ole"],"cuid":["S02-100.00-026653"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["America, North","Europe, Non-EU","OECD"],"corresponding_author":["Taj, Tahir"],"country":["United Kingdom","United States"],"glorg":["All Global Affiliations","University System of Maryland","University of Maryland","University of Surrey"],"keyword":["Acute myeloid leukemia","Adult leukemia","Air pollution","Case control study"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-NP","DI-OT","DI-U"],"level3":{"NP":["DI-NP-ALL","DI-NP-CAN"],"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-RUC"]},"level3all":["DI-NP-CAN","DI-U-AU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"exposure to pm sub 000000000002 000000000005 sub constituents and risk of adult leukemia in denmark a population based case control study","src":["au","ruc"],"src-code":["DI-U-AU","DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85096378400","version":"Other Version"},"id":"S02-100.00-026653","identifier":[{"id":"33157111","type":"pmid"},{"id":"85096378400","type":"scopus"}],"ids":["au-c09e9407-8ad5-4930-98ba-ee19d9617443","ruc-823430b7-9174-48cf-a7e5-63520a4c68ea"],"keyword":["Acute myeloid leukemia","Adult leukemia","Air pollution","Case–control study"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-81D008D4E8599464C27F1557D5E1782E"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"dk","key":"dcrc danish cancer society research center","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-CAN","l3nn":"DCRC Danish Cancer Society Research Center","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DCRC Danish Cancer Society Research Center","namevar":["Danish Cancer Society"],"nora_code":"DI-NP-CAN","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Environmental Science, Department of Environmental Science - Atmospheric Emissions & Modelling"],"nora_code":"DI-U-AU","used":1},{"affno":"3","country":"gb","key":"university of surrey","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Surrey","used":1},{"affno":"4","country":"us","key":"university system of maryland","loc":["United States","America, North","OECD"],"name":"University System of Maryland","used":1},{"affno":"5","country":"us","key":"university of maryland","loc":["United States","America, North","OECD"],"name":"University of Maryland","used":1},{"affno":"6","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of Science and Environment"],"nora_code":"DI-U-RUC","used":1},{"affno":"7","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Tahir","key":"tajpau","last":"Taj","name":"Taj, Tahir","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Aslak Harbo","key":"poulsenpau","last":"Poulsen","name":"Poulsen, Aslak Harbo","rank":2,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"country":"dk","first":"Matthias","key":"ketzelpau","last":"Ketzel","locid":"798900d2-1d54-4c53-a4ca-671c12aa3015","name":"Ketzel, Matthias","orcid":"0000-0001-9519-1935","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Camilla","key":"geelspau","last":"Geels","locid":"fbcefbda-1f0a-4649-8234-28012f2714d6","name":"Geels, Camilla","orcid":"0000-0003-2549-1750","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jørgen","key":"brandtpau","last":"Brandt","locid":"5f570c62-a5a5-4760-b7c7-8755b6e37ebf","name":"Brandt, Jørgen","orcid":"0000-0002-7580-9547","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jesper Heile","key":"christensenpau","last":"Christensen","locid":"5d084fe1-5909-4b7f-ac1a-907f4a30089e","name":"Christensen, Jesper Heile","orcid":"0000-0002-6741-5839","rank":6,"rolecode":"pau"},{"affno":"1 4 5","corresponding":null,"first":"Robin","key":"puettpau","last":"Puett","name":"Puett, Robin","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ulla Arthur","key":"hvidtfeldtpau","last":"Hvidtfeldt","name":"Hvidtfeldt, Ulla Arthur","rank":8,"rolecode":"pau"},{"affno":"1 6 7","country":"dk","first":"Mette","key":"sørensenpau","last":"Sørensen","locid":"5bf2a665-def4-499c-9c63-0c440da72e20","name":"Sørensen, Mette","rank":9,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Ole","key":"raaschounielsenpau","last":"Raaschou-Nielsen","locid":"9ae8831f-2034-4c09-84bc-01cd649e3b55","name":"Raaschou-Nielsen, Ole","rank":10,"rolecode":"pau"}],"pmid":["33157111"],"pub":{"doi":"10.1016/j.envres.2020.110418","issn":["00139351","10960953"],"issn_org":["00139351"],"journal":"Environmental Research","paperid":"110418","publisher":"Academic Press Inc.","status":"p","title":"Environmental Research","volume":"196"},"review":"Peer Reviewed","scoID":["2-s2.0-85096378400"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Non-Profit Organisations","All Universities","DI-ALL","DI-NP","DI-NP-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Non-Profit Organisations","Other Research","Roskilde University","Universities"],"PST":["Published"]},"sid":["au-c09e9407-8ad5-4930-98ba-ee19d9617443","ruc-823430b7-9174-48cf-a7e5-63520a4c68ea"],"src":["AU Aarhus University","RUC Roskilde University"],"title":"Exposure to PM<sub>2.5</sub> constituents and risk of adult leukemia in Denmark : A population-based case–control study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-026653","year":"2021","yearsub":"2021"}
{"abstract":"OBJECTIVE To investigate the associations between air pollution and mortality, focusing on associations below current European Union, United States, and World Health Organization standards and guidelines. DESIGN Pooled analysis of eight cohorts. SETTING Multicentre project Effects of Low-Level Air Pollution: A Study in Europe (ELAPSE) in six European countries. PARTICIPANTS 325 367 adults from the general population recruited mostly in the 1990s or 2000s with detailed lifestyle data. Stratified Cox proportional hazard models were used to analyse the associations between air pollution and mortality. Western Europe-wide land use regression models were used to characterise residential air pollution concentrations of ambient fine particulate matter (PM2.5), nitrogen dioxide, ozone, and black carbon. MAIN OUTCOME MEASURES Deaths due to natural causes and cause specific mortality. RESULTS Of 325 367 adults followed-up for an average of 19.5 years, 47 131 deaths were observed. Higher exposure to PM2.5, nitrogen dioxide, and black carbon was associated with significantly increased risk of almost all outcomes. An increase of 5 mu g/m(3) in PM2.5 was associated with 13% (95% confidence interval 10.6% to 15.5%) increase in natural deaths; the corresponding figure for a 10 mu g/m(3) increase in nitrogen dioxide was 8.6% (7% to 10.2%). Associations with PM2.5, nitrogen dioxide, and black carbon remained significant at low concentrations. For participants with exposures below the US standard of 12 mu g/m(3) an increase of 5 mu g/m(3) in PM2.5 was associated with 29.6% (14% to 47.4%) increase in natural deaths. CONCLUSIONS Our study contributes to the evidence that outdoor air pollution is associated with mortality even at low pollution levels below the current European and North American standards and WHO guideline values. These findings are therefore an important contribution to the debate about revision of air quality limits, guidelines, and standards, and future assessments by the Global Burden of Disease.","author_count":56,"contributors":["Strak, Maciej","Weinmayr, Gudrun","Rodopoulou, Sophia","Chen, Jie","de Hoogh, Kees","Andersen, Zorana J","Atkinson, Richard","Bauwelinck, Mariska","Bekkevold, Terese","Bellander, Tom","Boutron-Ruault, Marie-Christine","Brandt, Jørgen","Cesaroni, Giulia","Concin, Hans","Fecht, Daniela","Forastiere, Francesco","Gulliver, John","Hertel, Ole","Hoffmann, Barbara","Hvidtfeldt, Ulla Arthur","Janssen, Nicole A H","Jöckel, Karl-Heinz","Jørgensen, Jeanette T","Ketzel, Matthias","Klompmaker, Jochem O","Lager, Anton","Leander, Karin","Liu, Shuo","Ljungman, Petter","Magnusson, Patrik K E","Mehta, Amar J","Nagel, Gabriele","Oftedal, Bente","Pershagen, Göran","Peters, Annette","Raaschou-Nielsen, Ole","Renzi, Matteo","Rizzuto, Debora","van der Schouw, Yvonne T","Schramm, Sara","Severi, Gianluca","Sigsgaard, Torben","Sørensen, Mette","Stafoggia, Massimo","Tjønneland, Anne","Verschuren, W M Monique","Vienneau, Danielle","Wolf, Kathrin","Katsouyanni, Klea","Brunekreef, Bert","Hoek, Gerard","Samoli, Evangelia"],"cuid":["S03-088.71-666526"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"51-200 contributors","class":"merged","cluster_size":3,"continent":["America, North","Europe, EU","Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Hoek, Gerard"],"country":["Austria","Belgium","France","Germany","Greece","Italy","Netherlands","Norway","Sweden","Switzerland","United Kingdom","United States"],"glorg":["Agency for Preventive and Social Medicine","All Global Affiliations","Ctr Occupat & Environm Med","Danderyd Hospital","Danderyds Hospital","Department of Epidemiology Lazio Regional Health Service","Dept Epidemiol Lazio Reg","Harvard T.H. Chan School of Public Health","Harvard University","Heinrich Heine University Düsseldorf","Helmholtz Association of German Research Centres","Helmholtz Munich","Helmholtz Zentrum München - German Research Center for Environmental Health","Imperial College London","Institut National de la Santé et de la Recherche Médicale (INSERM)","Karolinska Institute","Karolinska Institutet","King's College London","Ludwig Maximilian University","Ludwig Maximilian University of Munich","National Institute for Public Health and the Environment","National Institute for Public Health and the Environment (RIVM)","National and Kapodistrian University of Athens","Natl Inst Publ Hlth & Environm, Netherlands National Institute for Public Health & the Environment","Norwegian Institute of Public Health","Paris-Saclay University","Region Stockholm","St. George's University of London","Stockholm Gerontology Research Center","Swiss Tropical and Public Health Institute","UMC Utrecht Cancer Center","Ulm University","Universite Paris-Saclay","University Medical Center Utrecht","University Medical Centre Utrecht","University of Athens","University of Basel","University of Duisburg-Essen","University of Florence","University of Leicester","University of London","University of Surrey","Université Paris-Saclay","Université de Versailles Saint-Quentin-en-Yvelines","Utrecht University","Vrije Universiteit Brussel"],"keyword":["Air Pollutants adverse effects","Air Pollution adverse effects","Associations","CANADIAN CENSUS HEALTH","Cardiovascular Diseases mortality","Environmental Exposure adverse effects","Europe","Fine particulate matter","Global burden","Humans","MODELS","NO2","Noncommunicable Diseases mortality","O 3","PM2 5","Risk","Stability"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-NP","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-OTH"],"NP":["DI-NP-ALL","DI-NP-CAN"],"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-RUC"]},"level3all":["DI-HO-OTH","DI-NP-CAN","DI-U-AU","DI-U-KU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"long term exposure to low level air pollution and mortality in eight european cohorts within the elapse project pooled analysis","src":["au","ku","ruc"],"src-code":["DI-U-AU","DI-U-KU","DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/bmj.n1904","version":"Published Version"},"id":"S03-088.71-666526","identifier":[{"id":"34470785","type":"pmid"},{"id":"PMC8409282","type":"pmcid"},{"id":"85114298591","type":"scopus"},{"id":"000692238200011","type":"wos"}],"ids":["au-dd84d1dd-0226-4953-92ed-9f24245f324e","ku-fa3546e6-6ed0-429b-980b-8d036de39a99","ruc-bdf81280-107f-4d91-a8db-c48bd5e4c140"],"keyword":["ASSOCIATIONS","Air Pollutants/adverse effects","Air Pollution/adverse effects","CANADIAN CENSUS HEALTH","Cardiovascular Diseases/mortality","Environmental Exposure/adverse effects","Europe","FINE PARTICULATE MATTER","GLOBAL BURDEN","Humans","MODELS","NO2","Noncommunicable Diseases/mortality","O-3","PM2.5","RISK","STABILITY"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-6-F94A1D4648F6CC6A11267C41E338D602"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/78833429/bmj.n1904.full.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://pure.au.dk/ws/files/274827771/bmj.n1904.full.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/279382072/Long_term_exposure_to_low_level_air_pollution.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/bmj.n1904","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"nl","key":"utrecht university","loc":["Netherlands","Europe, EU","OECD"],"name":"Utrecht University","used":1},{"affno":"2","country":"nl","key":"national institute for public health and the environment