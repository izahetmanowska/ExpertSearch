lópezpau","last":"Dolores Chirlaque López","name":"Dolores Chirlaque López, María","rank":23,"rolecode":"pau"},{"affno":"30 31","corresponding":null,"first":"Matthias B.","key":"schulzepau","last":"Schulze","name":"Schulze, Matthias B.","rank":24,"rolecode":"pau"},{"affno":"32","corresponding":null,"first":"Maria","key":"wennbergpau","last":"Wennberg","name":"Wennberg, Maria","rank":25,"rolecode":"pau"},{"affno":"32","corresponding":null,"first":"Sophia","key":"harlidpau","last":"Harlid","name":"Harlid, Sophia","rank":26,"rolecode":"pau"},{"affno":"1 4 2 3","corresponding":null,"first":"Manon","key":"cairatpau","last":"Cairat","name":"Cairat, Manon","rank":27,"rolecode":"pau"},{"affno":"1 2 3","corresponding":null,"first":"Marina","key":"kvaskoffpau","last":"Kvaskoff","name":"Kvaskoff, Marina","rank":28,"rolecode":"pau"},{"affno":"4 33","corresponding":null,"first":"Inge","key":"huybrechtspau","last":"Huybrechts","name":"Huybrechts, Inge","rank":29,"rolecode":"pau"},{"affno":"1 2 3","corresponding":null,"first":"Francesca","key":"romanamancinipau","last":"Romana Mancini","name":"Romana Mancini, Francesca","rank":30,"rolecode":"pau"}],"pmid":["35364416"],"pub":{"doi":"10.1016/j.envint.2022.107213","issn":["01604120","18736750"],"issn_org":["01604120"],"journal":"Environment International","paperid":"107213","publisher":"Elsevier Ltd","status":"p","title":"Environment International","volume":"163"},"review":"Peer Reviewed","scoID":["2-s2.0-85127167792"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Non-Profit Organisations","All Universities","DI-ALL","DI-NP","DI-NP-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Non-Profit Organisations","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-025f1db3-69ed-464e-92f9-1c159455099e","ku-98bdf9ab-ae63-44f6-92da-d04eed5c25d3"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Dietary intakes of dioxins and polychlorobiphenyls (PCBs) and breast cancer risk in 9 European countries","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-012762","year":"2022","yearsub":"2022"}
{"abstract":"Background: The incidence rate risk of testicular cancer has increased over the last four decades, and the most significant increase has been among Caucasian men in Nordic countries. Second-generation immigrant studies indicate a significant role of environmental exposure in testicular cancer. Methods: We conducted a nationwide register-based case- control study including 6,390 testicular cancer cases registered in the Danish Cancer Registry between 1989 and 2014. Up to four agematched controls for each case (n 18,997) were randomly selected fromthe Civil Registration System.Ambient air pollution levels were estimated at addresses of cases and controls with a state-of-the-art air pollution modeling system. Results: We mostly found ORs close to 1.00 and with 95% confidence intervals (CI) spanning 1.00. Exposure during the year preceding birth was associated with ORs for nitrogen dioxide (NO2) of 0.87 (95% CI, 0.77-0.97) per 10 mg/m3 and for organic carbon of 0.84 (95% CI, 0.72-0.98) per 1 mg/m3. Exposure during the first 10 years of life was associated with ORs for organic carbon of 0.79 (95% CI, 0.67-0.93) per 1 mg/m3, for ozone (O3) of 1.20 (95% CI, 1.07-1.34) per 10 mg/m3, and for secondary inorganic aerosols of 1.07 (95% CI, 1.00-1.15) per 1 mg/m3. Conclusions: Early-life exposure to NO2 and organic carbon (OC) was associated with lower risk for testicular cancer whereas early-life exposure to O3 and secondary inorganic aerosols (SIA) was associated with higher risk.","author_count":9,"contributors":["Taj, Tahir","Poulsen, Aslak Harbo","Ketzel, Matthias","Geels, Camilla","Brandt, Jørgen","Christensen, Jesper Heile","Hvidtfeldt, Ulla Arthur","Sørensen, Mette","Raaschou-Nielsen, Ole"],"cuid":["S02-100.00-013864"],"filters":{"added":"2022-06","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, Non-EU","OECD"],"corresponding_author":["Taj, Tahir"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of Surrey"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-NP","DI-U"],"level3":{"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-ALL","DI-U-AU","DI-U-RUC"]},"level3all":["DI-NP-CAN","DI-U-AU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"long term residential exposure to air pollution and risk of testicular cancer in denmark a population based case control study","src":["au","ruc"],"src-code":["DI-U-AU","DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://aacrjournals.org/cebp/article/31/4/744/694018/Long-term-Residential-Exposure-to-Air-Pollution","version":"Other Version"},"id":"S02-100.00-013864","identifier":[{"id":"85128481893","type":"scopus"},{"id":"35131880","type":"pmid"}],"ids":["au-11c0d305-c187-483e-b86a-2111046c1901","ruc-9ae2c98b-6fca-456a-add2-2030ab81c361"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-C2FB11BF821F3F49FF5A6016DE324BE9"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"dk","key":"dcrc danish cancer society research center","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-CAN","l3nn":"DCRC Danish Cancer Society Research Center","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DCRC Danish Cancer Society Research Center","namevar":["Danish Cancer Society"],"nora_code":"DI-NP-CAN","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Environmental Science, Department of Environmental Science - Atmospheric Emissions & Modelling"],"nora_code":"DI-U-AU","used":1},{"affno":"3","country":"gb","key":"university of surrey","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Surrey","used":1},{"affno":"4","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of Science and Environment"],"nora_code":"DI-U-RUC","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Tahir","key":"tajpau","last":"Taj","name":"Taj, Tahir","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Aslak Harbo","key":"poulsenpau","last":"Poulsen","name":"Poulsen, Aslak Harbo","rank":2,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"country":"dk","first":"Matthias","key":"ketzelpau","last":"Ketzel","locid":"798900d2-1d54-4c53-a4ca-671c12aa3015","name":"Ketzel, Matthias","orcid":"0000-0001-9519-1935","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Camilla","key":"geelspau","last":"Geels","locid":"fbcefbda-1f0a-4649-8234-28012f2714d6","name":"Geels, Camilla","orcid":"0000-0003-2549-1750","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jørgen","key":"brandtpau","last":"Brandt","locid":"5f570c62-a5a5-4760-b7c7-8755b6e37ebf","name":"Brandt, Jørgen","orcid":"0000-0002-7580-9547","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jesper Heile","key":"christensenpau","last":"Christensen","locid":"5d084fe1-5909-4b7f-ac1a-907f4a30089e","name":"Christensen, Jesper Heile","orcid":"0000-0002-6741-5839","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ulla Arthur","key":"hvidtfeldtpau","last":"Hvidtfeldt","name":"Hvidtfeldt, Ulla Arthur","rank":7,"rolecode":"pau"},{"affno":"1 4","country":"dk","first":"Mette","key":"sørensenpau","last":"Sørensen","locid":"5bf2a665-def4-499c-9c63-0c440da72e20","name":"Sørensen, Mette","rank":8,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Ole","key":"raaschounielsenpau","last":"Raaschou-Nielsen","locid":"9ae8831f-2034-4c09-84bc-01cd649e3b55","name":"Raaschou-Nielsen, Ole","rank":9,"rolecode":"pau"}],"pmid":["35131880"],"pub":{"doi":"10.1158/1055-9965.epi-21-0961","issn":["10559965","15387755"],"issn_org":["10559965"],"issue":"4","journal":"Cancer Epidemiology, Biomarkers & Prevention","pages":"744-750","publisher":"American Association for Cancer Research Inc.","status":"p","title":"Cancer Epidemiology, Biomarkers & Prevention","title_org":"Cancer Epidemiology Biomarkers and Prevention","volume":"31"},"review":"Peer Reviewed","scoID":["2-s2.0-85128481893"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Non-Profit Organisations","All Universities","DI-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Non-Profit Organisations","Roskilde University","Universities"],"PST":["Published"]},"sid":["au-11c0d305-c187-483e-b86a-2111046c1901","ruc-9ae2c98b-6fca-456a-add2-2030ab81c361"],"src":["AU Aarhus University","RUC Roskilde University"],"title":"Long-term Residential Exposure to Air Pollution and Risk of Testicular Cancer in Denmark : A Population-Based Case-Control Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-013864","year":"2022","yearsub":"2022"}
{"abstract":"BACKGROUND: Potential supplemental disease-modifying and neuroprotective treatment strategies are warranted in multiple sclerosis (MS). Exercise is a promising non-pharmacological approach, and an uninvestigated 'window of opportunity' exists early in the disease course. OBJECTIVE: To investigate the effect of early exercise on relapse rate, global brain atrophy and secondary magnetic resonance imaging (MRI) outcomes. METHODS: This randomized controlled trial ( n  = 84, disease duration <2 years) included 48 weeks of supervised aerobic exercise or control condition. Population-based control data (Danish MS Registry) was included ( n  = 850, disease duration <2 years). Relapse rates were obtained from medical records, and patients underwent structural and diffusion-kurtosis MRI at baseline, 24 and 48 weeks. RESULTS: No between-group differences were observed for primary outcomes, relapse rate (incidence-rate-ratio exercise relative to control: (0.49 (0.15; 1.66), p  = 0.25) and global brain atrophy rate (-0.04 (-0.48; 0.40)%, p  = 0.87), or secondary measures of lesion load. Aerobic fitness increased in favour of the exercise group. Microstructural integrity was higher in four of eight a priori defined motor-related tracts and nuclei in the exercise group compared with the control (thalamus, corticospinal tract, globus pallidus, cingulate gyrus) at 48 weeks. CONCLUSION: Early supervised aerobic exercise did not reduce relapse rate or global brain atrophy, but does positively affect the microstructural integrity of important motor-related tracts and nuclei.","author_count":14,"contributors":["Riemenschneider, Morten","Hvid, Lars G.","Ringgaard, Steffen","Nygaard, Mikkel Karl Emil","Eskildsen, Simon Fristed","Gaemelke, Tobias","Magyari, Melinda","Jensen, Henrik Boye","Nielsen, Helle Hvilsted","Kant, Matthias","Falah, Masoud","Petersen, Thor","Stenager, Egon","Dalgas, Ulrik"],"cuid":["S03-089.96-020965"],"filters":{"added":"2022-06","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"corresponding_author":["Riemenschneider, Morten"],"keyword":["Atrophy pathology","Brain","Brain diagnostic imaging","Disease Progression","Early treatment","Exercise","Exercise Therapy","History","Humans","Magnetic Resonance Imaging methods","Multiple Sclerosis diagnostic imaging","Multiple sclerosis","Neoplasm Recurrence Local pathology","Neuroplasticity","Neuroprotection","RELAPSES","relapse rate"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR"],"OT":["MS Clin Hosp Unit Western Denmark, Dept Neurol"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"investigating the potential disease modifying and neuroprotective efficacy of exercise therapy early in the disease course of multiple sclerosis the early multiple sclerosis exercise study emses","src":["au","ku","sdu"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85126629273","version":"Other Version"},"funding_acknowledgement":["The author(s) declared the following potential conflicts of interest with respect to the research, authorship and/or publication of this article: M.R. and U.D. report grants for the present manuscript from the Tryg Foundation, The Danish MS Society and Augustinus Foundation. U.D. reports grants from the Canadian MS Society, Aarhus University, Sanofi Genzyme and Fabrikant Vilhelm Peternsens Legat, outside the submitted work. L.G.H. reports grants from The Danish MS Society and Helsefonden, outside the submitted work, and serves as an unpaid board member on the board of Rehabilitation in Multiple Sclerosis (RIMS). M.M. reports grants and personal fees from Biogen, Merck, Sanofi, Abbvie, Alexion and Roche, outside the submitted work. S.R., M.K.E.N., S.K.E., T.G., H.B.J., H.H.J., M.K., M.F., T.P. and E.S. have nothing to disclose."],"id":"S03-089.96-020965","identifier":[{"id":"35296183","type":"pmid"},{"id":"85126629273","type":"scopus"},{"id":"000773132700001","type":"wos"}],"ids":["au-715740a6-f609-4cf6-bc0e-5b518da49f6c","ku-6ad4b7e5-defb-4bdf-adf4-22df069cc842","sdu-dd0b89ff-dbc7-4705-89c6-d21bce02cc00"],"keyword":["Atrophy/pathology","BRAIN","Brain/diagnostic imaging","Disease Progression","Exercise Therapy","HISTORY","Humans","Magnetic Resonance Imaging/methods","Multiple Sclerosis/diagnostic imaging","Multiple sclerosis","NEUROPLASTICITY","Neoplasm Recurrence, Local/pathology","RELAPSES","early treatment","exercise","neuroprotection","relapse rate"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-C423606A368ACE148A6B147C4C6605C6"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Public Health, Department of Public Health - Sport Science"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","n