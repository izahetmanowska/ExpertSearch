{"abstract":"The report provides an outline of the THOR-AirPAS - air pollution assessment system and a brief manual for getting started with the air quality models and input data included in THOR-AirPAS.","author_count":8,"contributors":["Jensen, Steen Solvang","Ketzel, Matthias","Brandt, Jørgen","Plejdrup, Marlene Schmidt","Nielsen, Ole-Kenneth","Winther, Morten","Evdokimova, Olga","Gross, Allan"],"cuid":["S01-000.00-218933"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Air pollution","Air quality models","Emissions","Manual","User Interface"],"level":"com","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"manual for thor airpas air pollution assessment system technical project report for airqgov regional pilot project 000000000003 airqgov rpp000000000003","src":["au"],"src-code":["DI-U-AU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://dce2.au.dk/pub/TR46.pdf","version":"Other Version"},"id":"S01-000.00-218933","ids":["au-9d46923f-8ae9-43ee-96fb-cfa363615691"],"keyword":["Air pollution","air quality models","emissions","manual","user-interface"],"lang":"English","level":"Commissioned","mra":["Science/Technology"],"noi":["Local-1-1-56AF405153E3BFA49D1B4DD3A1761AF8"],"oa_link":[{"access":"oa","type":"rem","url":"http://dce2.au.dk/pub/TR46.pdf","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Environmental Science, Department of Environmental Science - Atmospheric Emissions & Modelling"],"nora