},{"affno":"32","corresponding":null,"first":"Mark","key":"wyattmarkpau","last":"Wyatt","name":"Wyatt, Mark","rank":836,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Dan","key":"yangdanpau","last":"Yang","name":"Yang, Dan","rank":837,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Jie","key":"yujiepau","last":"Yu","name":"Yu, Jie","rank":838,"rolecode":"pau"},{"affno":"11","corresponding":null,"first":"Ricardo","key":"zanmarsanchezricardopau","last":"Zanmar Sanchez","name":"Zanmar Sanchez, Ricardo","rank":839,"rolecode":"pau"},{"affno":"9","corresponding":null,"first":"María Rosa","key":"zapateroosoriomaríarosapau","last":"Zapatero Osorio","name":"Zapatero Osorio, María Rosa","rank":840,"rolecode":"pau"},{"affno":"134","corresponding":null,"first":"Mathias","key":"zechmeistermathiaspau","last":"Zechmeister","name":"Zechmeister, Mathias","rank":841,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Yixiao","key":"zhouyixiaopau","last":"Zhou","name":"Zhou, Yixiao","rank":842,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Claas","key":"ziemkeclaaspau","last":"Ziemke","name":"Ziemke, Claas","rank":843,"rolecode":"pau"},{"affno":"165","corresponding":null,"first":"Konstanze","key":"zwintzkonstanzepau","last":"Zwintz","name":"Zwintz, Konstanze","rank":844,"rolecode":"pau"},{"affno":"49","corresponding":null,"first":"Torsten","key":"böhmtorstenpau","last":"Böhm","name":"Böhm, Torsten","rank":845,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Léo Michel","key":"dansacléomichelpau","last":"Dansac","name":"Dansac, Léo Michel","rank":846,"rolecode":"pau"}],"pub":{"doi":"10.1007/s10686-025-09985-9","issn":["0004640X","09226435"],"issn_org":["15729508"],"issue":"3","journal":"Experimental Astronomy","paperid":"26","publisher":"Springer Netherlands","status":"p","title":"Experimental Astronomy","volume":"59"},"review":"Peer Reviewed","scoID":["2-s2.0-105003197453"],"search":{"DAF":["Aarhus University","All Danish Af