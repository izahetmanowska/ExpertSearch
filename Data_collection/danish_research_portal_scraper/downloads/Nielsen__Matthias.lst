{"author_count":6,"contributors":["Nielsen, Anne Ellerup"],"cuid":["S01-000.00-232430"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"kiva","src":["au"],"src-code":["DI-U-AU"],"type":"dbp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.statsbiblioteket.dk/au/%23/search?query=recordID:%22ebog_ssj0001451877%22","version":"Other Version"},"id":"S01-000.00-232430","ids":["au-b4b163ac-af0c-44ab-b77c-88dfd8099947"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-A167E4A3BAA4DFA5C1906EDE15327F4F"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus BSS, Department of Management, Department of Management"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Anne Ellerup","key":"nielsenpau","last":"Nielsen","locid":"607e3181-37dc-49b9-8c3e-e140cfa8359f","name":"Nielsen, Anne Ellerup","orcid":"0000-0002-1422-6663","rank":1,"rolecode":"pau"},{"affno":"","first":"Samuel","key":"idowupedh","last":"Idowu","name":"Idowu, Samuel","rank":2,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Nicholas","key":"capaldipedh","last":"Capaldi","name":"Capaldi, Nicholas","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Matthias S.","key":"fifkapedh","last":"Fifka","name":"Fifka, Matthias S.","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Liangrong","key":"zupedh","last":"Zu","name":"Zu, Liangron