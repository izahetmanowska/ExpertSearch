b3-9140-4f59-a55e-e68a73c9fa32","name":"Hertel, Ole","orcid":"0000-0003-0972-7735","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ole-Kenneth","key":"nielsenpau","last":"Nielsen","locid":"17ec76bb-7916-4024-867b-3aca60ca0c40","name":"Nielsen, Ole-Kenneth","orcid":"0000-0003-4350-0956","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Marlene Schmidt","key":"plejdruppau","last":"Plejdrup","locid":"9dede80b-ff3e-4171-9504-bf8547fec74d","name":"Plejdrup, Marlene Schmidt","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jørgen","key":"brandtpau","last":"Brandt","locid":"5f570c62-a5a5-4760-b7c7-8755b6e37ebf","name":"Brandt, Jørgen","orcid":"0000-0002-7580-9547","rank":10,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-319-57645-9_8","eisbn":["9783319576459"],"isbn":["9783319576442"],"pages":"49-54","publisher":"Springer","status":"p","title":"Springer Proceedings in Complexity"},"review":"Peer Reviewed","scoID":["2-s2.0-85060484901"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-afaf98aa-9b94-40a0-a70a-68c69134ed1a"],"src":["AU Aarhus University"],"title":"Air Pollutant Trends over Denmark over the Last 37 Years as Simulated by the Integrated THOR Model System","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-229560","year":"2018","yearsub":"2018"}
