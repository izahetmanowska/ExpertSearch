pau","last":"Zinchenko","name":"Zinchenko, Vadim","rank":360,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Victor","key":"zlotnickivictorpau","last":"Zlotnicki","name":"Zlotnicki, Victor","rank":361,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.asr.2021.01.022","issn":["02731177","18791948"],"issn_org":["02731177"],"issue":"2","journal":"Advances in Space Research","pages":"319-363","publisher":"Elsevier","status":"p","title":"Advances in Space Research","volume":"68"},"review":"Peer Reviewed","scoID":["2-s2.0-85103075118"],"sdg":["13. Climate Action","14. Life Below Water","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-97f8333a-17d1-4ab3-9db1-85de4087965f"],"src":["DTU Technical University of Denmark"],"title":"Altimetry for the future: Building on 25 years of progress","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-349902","year":"2021","yearsub":"2021"}
{"abstract":"Nicotinamide phosphoribosyltransferase (NAMPT) converts nicotinamide to NAD+. As low hepatic NAD+ levels have been linked to the development of nonalcoholic fatty liver disease, we hypothesized that ablation of hepatic Nampt would affect susceptibility to liver injury in response to diet-induced metabolic stress. Following 3 weeks on a low-methionine and choline-free 60% high-fat diet, hepatocyte-specific Nampt knockout (HNKO) mice accumulated less triglyceride than WT littermates but had increased histological scores for liver inflammation, necrosis, and fibrosis. Surprisingly, liver injury was also observed in HNKO mice on the purified control diet. This HNKO phenotype was associated with decreased abundance of mitochondrial proteins, especially proteins involved in oxidoreductase activity. High-resolution respirometry revealed lower respiratory capacity in purified control diet- fed HNKO liver. In addition, fibrotic area in HNKO liver sections correlated negatively with hepatic NAD+, and liver injury was prevented by supplementation with NAD+ precursors nicotinamide riboside and nicotinic acid. MS-based proteomic analysis revealed that nicotinamide riboside supplementation rescued hepatic levels of oxidoreductase and OXPHOS proteins. Finally, single-nucleus RNA-Seq showed that transcriptional changes in the HNKO liver mainly occurred in hepatocytes, and changes in the hepatocyte transcriptome were associated with liver necrosis. In conclusion, HNKO livers have reduced respiratory capacity, decreased abundance of mitochondrial proteins, and are susceptible to fibrosis because of low NAD+ levels. Our data suggest a critical threshold level of hepatic NAD+ that determines the predisposition to liver injury and supports that NAD+ precursor supplementation can prevent liver injury and nonalcoholic fatty liver disease progression.","author_count":14,"contributors":["Dall, Morten","Hassing, Anna S","Niu, Lili","Nielsen, Thomas Svava","Ingerslev, Lars Roed","Sulek, Karolina","Trammell, Samuel A.J.","Gillum, Matthew P.","Barrès, Romain","Larsen, Steen","Poulsen, Steen Seier","Mann, Matthias","Ørskov, Cathrine","Treebak, Jonas T."],"cuid":["S01-000.00-416019"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany","Poland"],"glorg":["All Global Affiliations","Max Planck Institute of Biochemistry","University of Białystok"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"hepatocyte specific perturbation of nad sup sup biosynthetic pathways in mice induces reversible nonalcoholic steatohepatitis like phenotypes","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.jbc.2021.101388","version":"Published Version"},"id":"S01-000.00-416019","identifier":[{"id":"000748397200003","type":"wos"},{"id":"PMC8648833","type":"pmcid"},{"id":"85120783047","type":"scopus"},{"id":"34762911","type":"pmid"}],"ids":["ku-25c9a015-4991-4c7d-8b21-aa8995fec3a0"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-AB400748AAF7C1D67EA2EB0A226E3937"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/287758770/1_s2.0_S0021925821011947_main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.jbc.2021.101388","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Basic Metabolic Research, Treebak Group"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"pl","key":"university of białystok","loc":["Poland","Europe, EU","OECD"],"name":"University of Białystok","used":1},{"affno":"3","country":"de","key":"max planck institute of biochemistry","loc":["Germany","Europe, EU","OECD"],"name":"Max Planck Institute of Biochemistry","used":1}],"person":[{"affno":"1","first":"Morten","key":"dallpau","last":"Dall","locid":"16f23ce0-9a8b-4fb9-ad56-835399aae31d","name":"Dall, Morten","orcid":"0000-0002-8577-3162","rank":1,"rolecode":"pau"},{"affno":"1","first":"Anna S.","key":"hassingpau","last":"Hassing","locid":"ced0e233-1399-489e-8b07-fb968ec21cbb","name":"Hassing, Anna S","name_org":"Hassing, Anna S.","orcid":"0000-0003-1650-8784","rank":2,"rolecode":"pau"},{"affno":"1","first":"Lili","key":"niupau","last":"Niu","locid":"f74df5eb-9404-4bdb-9d58-289bf2c90efa","name":"Niu, Lili","orcid":"0000-0003-4571-4368","rank":3,"rolecode":"pau"},{"affno":"1","first":"Thomas S.","key":"nielsenpau","last":"Nielsen","locid":"a579c623-8238-41b9-92fd-0d670a5cac39","name":"Nielsen, Thomas Svava","name_org":"Nielsen, Thomas S.","orcid":"0000-0002-9457-8000","rank":4,"rolecode":"pau"},{"affno":"1","first":"Lars R.","key":"ingerslevpau","last":"Ingerslev","locid":"26f3d9d2-f555-4a5b-9fda-25333d1838ed","name":"Ingerslev, Lars Roed","name_org":"Ingerslev, Lars R.","orcid":"0000-0002-4164-7690","rank":5,"rolecode":"pau"},{"affno":"1","first":"Karolina","key":"sulekpau","last":"Sulek","locid":"dfe091b3-bc3a-40cb-b540-ce37005de114","name":"Sulek, Karolina","rank":6,"rolecode":"pau"},{"affno":"1","first":"Samuel A.J.","key":"trammellpau","last":"Trammell","locid":"051c3035-15c4-456f-a77e-8ce20970d70c","name":"Trammell, Samuel A.J.","orcid":"0000-0002-5941-4094","rank":7,"rolecode":"pau"},{"affno":"1","first"