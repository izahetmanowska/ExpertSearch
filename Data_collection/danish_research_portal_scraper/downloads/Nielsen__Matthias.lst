080/19378629.2011.649921","issn":["19378629","19408374"],"issn_org":["19378629"],"journal":"Engineering Studies","pages":"11-31","publisher":"Taylor and Francis Ltd.","status":"p","title":"Engineering Studies","volume":"4/1"},"review":"Peer Reviewed","scoID":["2-s2.0-84862284481"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-0ecb9f23-7ad4-45fe-a1bb-dddd19bb7013"],"src":["AU Aarhus University"],"title":"Winds of change : communication and wind power technology development in Denmark and Germany from 1973 to ca. 1985","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-137833","year":"2012","yearsub":"2012"}
{"abstract":"RNA-seq, has recently become an attractive method of choice in the studies of transcriptomes, promising several advantages compared with microarrays. In this study, we sought to assess the contribution of the different analytical steps involved in the analysis of RNA-seq data generated with the Illumina platform, and to perform a cross-platform comparison based on the results obtained through Affymetrix microarray. As a case study for our work we, used the Saccharomyces cerevisiae strain CEN.PK 113-7D, grown under two different conditions (batch and chemostat). Here, we asses the influence of genetic variation on the estimation of gene expression level using three different aligners for read-mapping (Gsnap, Stampy and TopHat) on S288c genome, the capabilities of five different statistical methods to detect differential gene expression (baySeq, Cuffdiff, DESeq, edgeR and NOISeq) and we explored the consistency between RNA-seq analysis using reference genome and de novo assembly approach. High reproducibility among biological replicates (correlation ≥0.99) and high consistency between the two platforms for analysis of gene expression levels (correlation ≥0.91) are reported. The results from differential gene expression identification derived from the different statistical methods, as well as their integrated analysis results based on gene ontology annotation are in good agreement. Overall, our study provides a useful and comprehensive comparison between the two platforms (RNA-seq and microrrays) for gene expression analysis and addresses the contribution of the different steps involved in the analysis of RNA-seq data.","author_count":7,"contributors":["Nookaew, Intawat","Papini, Marta","Pornputtapong, Natapol","Scalcinati, Gionata","Fagerberg, Linn","Uhlén, Matthias","Nielsen, Jens"],"cuid":["S01-000.00-346682"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-NP","DI-U"],"level3":{"NP":["DI-NP-ALL","DI-NP-NOVO"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-NP-NOVO","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"a comprehensive comparison of rna seq based transcriptome analysis from reads to differential gene expression and cross comparison with microarrays a case study in saccharomyces cerevisiae","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/51205377/10084.full.pdf","version":"Pre-print"},"id":"S01-000.00-346682","identifier":[{"id":"84869014474","type":"scopus"},{"id":"22965124","type":"pmid"},{"id":"PMC3488244","type":"pmcid"}],"ids":["dtu-8d12447e-a943-4e02-8add-d26572399c40"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-64A1502760A094F0D55C5802CCAA7B76"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1093/nar/gks804","version":"Other Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/51205377/10084.full.pdf","version":"Pre-print"}],"org":[{"affno":"1","country":"dk","key":"novo nordisk foundation","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-NOVO","l3nn":"Novo Nordisk Foundation","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Novo Nordisk Foundation","namevar":["Novo Nordisk Foundation"],"nora_code":"DI-NP-NOVO","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Novo Nordisk Foundation Center for Biosustainability","Technical University of Denmark, Novo Nordisk Foundation Center for Biosustainability, Fungal Cell Factories"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Intawat","key":"nookaewpau","last":"Nookaew","name":"Nookaew, Intawat","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marta","key":"papinipau","last":"Papini","name":"Papini, Marta","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Natapol","key":"pornputtapongpau","last":"Pornputtapong","name":"Pornputtapong, Natapol","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Gionata","key":"scalcinatipau","last":"Scalcinati","name":"Scalcinati, Gionata","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Linn","key":"fagerbergpau","last":"Fagerberg","name":"Fagerberg, Linn","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Matthias","key":"uhlénpau","last":"Uhlén","name":"Uhlén, Matthias","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jens","key":"nielsenpau","last":"Nielsen","locid":"8bd86466-7840-438f-8360-ae1ad56f39a1","name":"Nielsen, Jens","rank":7,"rolecode":"pau"}],"pmid":["22965124"],"pub":{"doi":"10.1093/nar/gks804","issn":["03051048","13624962"],"issn_org":["03051048"],"issue":"20","journal":"Nucleic Acids Research","pages":"10084-10097","publisher":"Oxford University Press","status":"p","title":"Nucleic Acids Research","volume":"40"},"review":"Peer Reviewed","scoID":["2-s2.0-84869014474"],"search":{"DAF":["All Danish Affiliations","All Non-Profit Organisations","All Universities","DI-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Non-Profit Organisations","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-8d12447e-a943-4e02-8add-d26572399c40"],"src":["DTU Technical University of Denmark"],"title":"A comprehensive comparison of RNA-Seq-based transcriptome analysis from reads to differential gene expression and cross-comparison with microarrays: a case study in Saccharomyces cerevisiae","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-346682","year":"2012","yearsub":"2012"}
{"abstract":"ABSTRACT: BACKGROUND: Traffic air pollution has been linked to cardiovascular mortality, which might be due to co-exposure to road traffic noise. Further, personal and lifestyle characteristics might modify any association. METHODS: We followed up 52 061 participants in a Danish cohort for mortality in the nationwide Register of Causes of Death, from enrollment in 1993-1997 through 2009, and traced their residential addresses from 1971 onwards in the Central Population Registry. We used dispersion-modelled concentration of nitrogen dioxide (NO2) since 1971 as indicator of traffic air pollution and used Cox regression models to estimate mortality rate ratios (MRRs) with adjustment for potential confounders. RESULTS: Mean levels of NO2 at the residence since 1971 were significantly associated with mortality from cardiovascular disease (MRR, 1.26; 95% confidence interval [CI], 1.06-1.51, per doubling of NO2 concentration) and all causes (MRR, 1.13; 95% CI, 1.04-1.23, per doubling of NO2 concentration) after adjustment for potential confounders. For participants who ate <200 g of fruit and vegetables per day, the MRR was 1.45 (95% CI, 1.13-1.87) for mortality from cardiovascular disease and 1.25 (95% CI, 1.11-1.42) for mortality from all causes. CONCLUSIONS: Traffic air pollution is associated with mortality from cardiovascular diseases and all causes, after adjustment for traffic noise. The association was strongest for people with a low fruit and vegetable intake.","author_count":9,"contributors":["Raaschou-Nielsen, Ole","Andersen, Zorana Jovanovic","Jensen, Steen Solvang","Ketzel, Matthias","Sørensen, Mette","Hansen, Johnni","Loft, Steffen","Tjønneland, Anne","Overvad, Kim"],"cuid":["S02-084.22-012775"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-NP","DI-OT","DI-U"],"level3":{"NP":["DI-NP-ALL","DI-NP-CAN"],"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-NP-CAN","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"traffic air pollution and mortality from cardiovascular disease and all causes a danish cohort study","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1186/1476-069X-11-60","version":"Other Version"},"id":"S02-084.22-012775","identifier":[{"id":"84870058454","type":"scopus"},{"id":"PMC3515423","type":"pmcid"},{"id":"22950554","type":"pmid"}],"ids":["au-0283339b-5fe3-4c4b-b245-37b76a929c9b","ku-3f064976-3928-44a0-a635-c34fc10db429"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-6078957171F15B3E0A4D27A3999E24A4"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1186/1476-069X-11-60","version":"Other Version"}],"org":[{"affno":"1","country":"dk","key":"dcrc danish cancer society research center","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-CAN","l3nn":"DCRC Danish Cancer Society Research Center","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DCRC Danish Cancer Society Research Center","namevar":["Danish Cancer Society"],"nora_code":"DI-NP-CAN","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Center of Epidemiology and Screening"],"nora_code":"DI-U-KU","used":1},{"affno":"3","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1},{"affno":"4","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Environmental Science, Department of Environmental Science - Atmospheric Emissions & Modelling"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Ole","key":"raaschounielsenpau","last":"Raaschou-Nielsen","name":"Raaschou-Nielsen, Ole","rank":1,"rolecode":"pau"},{"affno":"2 3","first":"Zorana Jovanovic","key":"andersenpau","last":"Andersen","locid":"8bffc514-d71e-40ba-b979-910dfb03ec5e","name":"Andersen, Zorana Jovanovic","orcid":"0000-0003-4138-9828","rank":2,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Steen Solvang","key":"jensenpau","last":"Jensen","locid":"0d52f91a-4eaa-46f9-ab5f-d7fd3c31440d","name":"Jensen, Steen Solvang","orcid":"0000-0001-5923-8441","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Matthias","key":"ketzelpau","last":"Ketzel","locid":"798900d2-1d54-4c53-a4ca-671c12aa3015","name":"Ketzel, Matthias","orcid":"0000-0001-9519-1935","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Mette","key":"sørensenpau","last":"Sørensen","locid":"dd7aeb5b-d621-441c-98ed-e1e354debb66","name":"Sørensen, Mette","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Johnni","key":"hansenpau","last":"Hansen","name":"Hansen, Johnni","rank":6,"rolecode":"pau"},{"affno":"4 2","corresponding":null,"first":"Steffen","key":"loftpau","last":"Loft","name":"Loft, Steffen","orcid":"0000-0001-9552-8518","rank":7,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Anne","key":"tjønnelandpau","last":"Tjønneland","name":"Tjønneland, Anne","rank":8,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Kim","key":"overvadpau","last":"Overvad","locid":"83738c57-45d4-41e0-b807-ad0f6dec597c","name":"Overvad, Kim","orcid":"0000-0001-6429-7921","rank":9,"rolecode":"pau"}],"pmid":["22950554"],"pub":{"doi":"10.1186/1476-069x-11-60","issn":["1476069X"],"issue":"1","journal":"Environmental Health","pages":"60","publisher":"BioMed Central","status":"p","title":"Environmental Health","title_org":"Environmental Health: A Global Access Science Source","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-84870058454"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Non-Profit Organisations","All Universities","DI-ALL","DI-NP","DI-NP-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Non-Profit Organisations","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-0283339b-5fe3-4c4b-b245-37b76a929c9b","ku-3f064976-3928-44a0-a635-c34fc10db429"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Traffic air pollution and mortality from cardiovascular disease and all causes : a Danish cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-084.22-012775","year":"2012","yearsub":"2012"}
{"abstract":"Background Exposure to air pollution in early life contributes to the burden of childhood asthma, but it is not clear whether long-term exposure to air pollution can lead to asthma onset or progression in adulthood. Objectives The authors studied the effect of exposure to traffic-related air pollution over 35 years on the risk for asthma hospitalisation in older people. Methods 57 053 participants in the Danish Diet, Cancer and Health cohort, aged 50-65 years at baseline (1993-1997), were followed up for first hospital admission for asthma until 2006, and the annual nitrogen dioxide (NO(2)) levels were estimated as a proxy of the exposure to traffic-related air pollution at the residential addresses of the participants since 1971. The association between NO(2) and hospitalisation for asthma was modelled using Cox regression, for the full cohort and in people with and without previous hospitalisations for asthma, and the effect modification by comorbid conditions was assessed. Results During 10.2 years' median follow-up, 977 (1.9%) of 53 695 eligible people were admitted to hospital for asthma: 821 were first-ever admissions and 176 were readmissions. NO(2) levels were associated with risk for asthma hospitalisation in the full cohort (HR and 95% CI per IQR, 5.8 μg/m(3): 1.12; 1.04-1.22), and for first-ever admissions (1.10; 1.01-1.20), with the highest risk in people with a history of asthma (1.41; 1.15-2.07) or chronic obstructive pulmonary disease (COPD) (1.30; 1.07-1.52) hospitalisation. Conclusions Long-term exposure to traffic-related air pollution increases the risk for asthma hospitalisation in older people. People with previous asthma or COPD hospitalisations are most susceptible.","author_count":10,"contributors":["Andersen, Zorana Jovanovic","Bønnelykke, Klaus","Hvidberg, Martin","Jensen, Steen Solvang","Ketzel, Matthias","Loft, Steffen","Sørensen, Mette","Tjønneland, Anne","Overvad, Kim","Raaschou-Nielsen, Ole Lundsgaard"],"cuid":["S02-092.38-026250"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Aged","Air Pollutants","Asthma","Denmark","Disease Progression","Female","Follow Up Studies","Hospitalization","Humans","Incidence","Male","Middle Aged","Prevalence","Proportional Hazards Models","Retrospective Studies","Risk Factors","Time Factors"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"long term exposure to air pollution and asthma hospitalisations in older adults a cohort study","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1136/thoraxjnl-2011-200711","version":"Other Version"},"id":"S02-092.38-026250","identifier":[{"id":"84855188788","type":"scopus"},{"id":"21890573","type":"pmid"}],"ids":["au-bad19357-c4f1-42f2-8e5a-1862f233e4ce","ku-fa70bc97-bb82-4759-a22a-16afa16ec1ad"],"keyword":["Aged","Air Pollutants","Asthma","Denmark","Disease Progression","Female","Follow-Up Studies","Hospitalization","Humans","Incidence","Male","Middle Aged","Prevalence","Proportional Hazards Models","Retrospective Studies","Risk Factors","Time Factors"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-E1F4E73D697B9A18A2C6691EC51CD94D"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1136/thoraxjnl-2011-200711","version":"Other Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Section of Environmental Health"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Environmental Science, Department of Environmental Science - Atmospheric Emissions & Modelling"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","first":"Zorana Jovanovic","key":"andersenpau","last":"Andersen","locid":"8bffc514-d71e-40ba-b979-910dfb03ec5e","name":"Andersen, Zorana Jovanovic","orcid":"0000-0003-4138-9828","rank":1,"rolecode":"pau"},{"affno":"1","first":"Klaus","key":"bønnelykkepau","last":"Bønnelykke","locid":"c36b6936-2cc4-41b1-b7c5-a97978afe417","name":"Bønnelykke, Klaus","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Martin","key":"hvidbergpau","last":"Hvidberg","locid":"caad0d45-bf3a-4a5f-ae85-b78a367b5186","name":"Hvidberg, Martin","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Steen S","key":"jensenpau","last":"Jensen","locid":"0d52f91a-4eaa-46f9-ab5f-d7fd3c31440d","name":"Jensen, Steen Solvang","name_org":"Jensen, Steen S","orcid":"0000-0001-5923-8441","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Matthias","key":"ketzelpau","last":"Ketzel","locid":"798900d2-1d54-4c53-a4ca-671c12aa3015","name":"Ketzel, Matthias","orcid":"0000-0001-9519-1935","rank":5,"rolecode":"pau"},{"affno":"1","first":"Steffen","key":"loftpau","last":"Loft","locid":"cc94a7fc-b397-47b4-94a5-bde078bb4fb6","name":"Loft, Steffen","orcid":"0000-0001-9552-8518","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Mette","key":"sørensenpau","last":"Sørensen","name":"Sørensen, Mette","rank":7,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Anne","key":"tjønnelandpau","last":"Tjønneland","name":"Tjønneland, Anne","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kim","key":"overvadpau","last":"Overvad","locid":"83738c57-45d4-41e0-b807-ad0f6dec597c","name":"Overvad, Kim","orcid":"0000-0001-6429-7921","rank":9,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Ole Lundsgaard","key":"raaschounielsenpau","last":"Raaschou-Nielsen","name":"Raaschou-Nielsen, Ole Lundsgaard","rank":10,"rolecode":"pau"}],"pmid":["21890573"],"pub":{"doi":"10.1136/thoraxjnl-2011-200711","issn":["00406376","14683296"],"issn_org":["00406376"],"issue":"1","journal":"Thorax","pages":"6-11","publisher":"BMJ Publishing Group","status":"p","title":"Thorax","volume":"67"},"review":"Peer Reviewed","scoID":["2-s2.0-84855188788"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-bad19357-c4f1-42f2-8e5a-1862f233e4ce","ku-fa70bc97-bb82-4759-a22a-16afa16ec1ad"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Long-term exposure to air pollution and asthma hospitalisations in older adults: a cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-092.38-026250","year":"2012","yearsub":"2012"}
{"abstract":"Background Single nucleotide polymorphisms (SNPs) are increasingly becoming the DNA marker system of choice due to their prevalence in the genome and their ability to be used in highly multiplexed genotyping assays. Although needed in high numbers for genome-wide marker profiles and genomics-assisted breeding, a surprisingly low number of validated SNPs are currently available for perennial ryegrass. Results A perennial ryegrass unigene set representing 9,399 genes was used as a reference for the assembly of 802,156 high quality reads generated by 454 transcriptome sequencing and for in silico SNP discovery. Out of more than 15,433 SNPs in 1,778 unigenes fulfilling highly stringent assembly and detection parameters, a total of 768 SNP markers were selected for GoldenGate genotyping in 184 individuals of the perennial ryegrass mapping population VrnA, a population being previously evaluated for important agronomic traits. A total of 592 (77%) of the SNPs tested were successfully called with a cluster separation above 0.9. Of these, 509 (86%) genic SNP markers segregated in the VrnA mapping population, out of which 495 were assigned to map positions. The genetic linkage map presented here comprises a total of 838 DNA markers (767 gene-derived markers) and spans 750 centi Mogan (cM) with an average marker interval distance of less than 0.9 cM. Moreover, it locates 732 expressed genes involved in a broad range of molecular functions of different biological processes in the perennial ryegrass genome. Conclusions Here, we present an efficient approach of using next generation sequencing (NGS) data for SNP discovery, and the successful design of a 768-plex Illumina GoldenGate genotyping assay in a complex genome. The ryegrass SNPs along with the corresponding transcribed sequences represent a milestone in the establishment of genetic and genomics resources available for this species and constitute a further step towards molecular breeding strategies. Moreover, the high density genetic linkage map predominantly based on gene-associated DNA markers provides an important tool for the assignment of candidate genes to QTL, functional genomics and the integration of genetic and physical maps in perennial ryegrass, one of the most important temperate grassland species.","author_count":9,"contributors":["Studer, Bruno","Byrne, Stephen","Nielsen, Rasmus Ory","Panitz, Frank","Bendixen, Christian","Islam, Md. Shofiqul","Pfeifer, Matthias","Lubberstedt, Thomas","Asp, Torben"],"cuid":["S01-000.00-177044"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Europe, EU","OECD"],"country":["Germany","United States"],"glorg":["All Global Affiliations","Helmholtz Association of German Research Centres","Iowa State University"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"a transcriptome map of perennial ryegrass em lolium perenne em l","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1186/1471-2164-13-140","version":"Other Version"},"id":"S01-000.00-177044","identifier":[{"id":"22513206","type":"pmid"},{"id":"PMC3483695","type":"pmcid"},{"id":"84859789584","type":"scopus"}],"ids":["au-53a6c986-a19e-4f6c-988b-d3ed9f497c49"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-EF2FF683597FC5A8A7444DB3B4CF51AE"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1186/1471-2164-13-140","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Agroecology, Department of Agroecology - Crop Genetics and Biotechnology"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"de","key":"helmholtz association of german research centres","loc":["Germany","Europe, EU","OECD"],"name":"Helmholtz Association of German Research Centres","used":1},{"affno":"3","country":"us","key":"iowa state university","loc":["United States","America, North","OECD"],"name":"Iowa State University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Bruno","key":"studerpau","last":"Studer","locid":"27c265b9-8ab1-4806-8936-9d44eadd0296","name":"Studer, Bruno","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Stephen","key":"byrnepau","last":"Byrne","locid":"815e3e71-2893-4d42-8335-5f2ce2a13302","name":"Byrne, Stephen","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rasmus Ory","key":"nielsenpau","last":"Nielsen","locid":"f0797c4c-391e-4bd4-9ae2-e0957742496d","name":"Nielsen, Rasmus Ory","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Frank","key":"panitzpau","last":"Panitz","locid":"79bc592e-ce9c-48e5-952f-48f2e0fa4221","name":"Panitz, Frank","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christian","key":"bendixenpau","last":"Bendixen","locid":"527e8fa7-a9e1-4eac-a0bf-c84d3d2f9655","name":"Bendixen, Christian","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Md. Shofiqul","key":"islampau","last":"Islam","locid":"d01deb16-6521-4593-8a8d-a7cda522a25a","name":"Islam, Md. Shofiqul","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Matthias","key":"pfeiferpau","last":"Pfeifer","name":"Pfeifer, Matthias","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Thomas","key":"lubberstedtpau","last":"Lubberstedt","name":"Lubberstedt, Thomas","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Torben","key":"aspp