c-efd9f939d9cc"],"src":["KU University of Copenhagen"],"title":"Proteomics-Based Comparative Mapping of the Secretomes of Human Brown and White Adipocytes Reveals EPDR1 as a Novel Batokine","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-496096","year":"2019","yearsub":"2019"}
{"abstract":"The paper raised the question of how residents of a rehabilitation and education center in Denmark use the center's main corridor to seek for or engage in social or focused activities. With this, we aim to inform the design of Smart Learning Ecosystem to support adolescents with brain injury in social and informal learning. We argue that research on smart learning environments has as too strong focus on classroom interaction and often neglects the socially situated and interactional side of learning. Instead, we investigate (1) how a corridor can be understood as a place for informal and social learning; (2) How young people with brain injury, who have problems in engaging in social interaction, participate in social interactions on this corridor; (3) how this insights inform research on Smart Learning Ecosystems that aims to rethink traditional learning institutions tasks by creating room for informal and social learning and by doing so transforming traditional learning approaches as well as the actual layout and design for the built environment.","author_count":4,"contributors":["Krummheuer, Antonia Lina","Rehm, Matthias","Lund, Maja K. L.","Nielsen, Karen N."],"cuid":["S01-000.00-057441"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Brain injury","Participation","Smart Learning Ecosystem","Social learning"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"the chance for sociability how participation and interaction structures of adolescents with brain injury on an institutional corridor inform smart learning ecosystems","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/308459430/39_4.pdf","version":"Published Version"},"id":"S01-000.00-057441","identifier":[{"id":"85072631546","type":"scopus"}],"ids":["aau-193aa88c-e4ae-401b-a089-04a1b00f950d"],"keyword":["brain injury","participation","place for learning","smart learning ecosystem","social learning"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-611101B6F302EC6B307F43DDA8EBE80E"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/308459430/39_4.pdf","version":"Published Version"},{"access":"oa","type":"rem","url":"http://www.mifav.uniroma2.it/inevent/events/idea2010/doc/39_4.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2019"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Humanities","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Centre for Cultural Psychology","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Human Centred Health Informatics & Participation","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Mattering: Centre for Discourse & Practice"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Antonia Lina","key":"krummheuerpau","last":"Krummheuer","locid":"590e092a-280f-4856-a4db-9ceef7658c64","name":"Krummheuer, Antonia Lina","orcid":"0000-0003-4372-5928","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Matthias","key":"rehmpau","last":"Rehm","locid":"04553c36-2327-4e8d-8d3c-701b04cb2d77","name":"Rehm, Matthias","orcid":"0000-0001-6264-1688","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Maja K. L.","key":"lundpau","last":"Lund","name":"Lund, Maja K. L.","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Karen N.","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Karen N.","rank":4,"rolecode":"pau"}],"pub":{"issn":["18269745","22832998"],"issn_org":["18269745"],"issue":"39","journal":"Interaction Design and Architecture","pages":"78-95","paperid":"4","publisher":"ASLERD","status":"p","title":"Interaction Design and Architecture","title_org":"Interaction Design and Architecture(s)"},"review":"Peer Reviewed","scoID":["2-s2.0-85072631546"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-193aa88c-e4ae-401b-a089-04a1b00f950d"],"src":["AAU Aalborg University"],"title":"The chance for sociability - How Participation and Interaction Structures of Adolescents with Brain Injury on an Institutional Corridor Inform Smart Learning Ecosystems","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-057441","year":"2018","yearsub":"2019"}
{"abstract":"As part of the Commission's internal Low Carbon Energy Observatory (LCEO) project, the Joint Research Centre (JRC) is developing an inventory of Future Emerging Technologies (FET) relevant to energy supply. A key part of the LCEO initiative is the consultation of external experts, addressing both those with in-depth experience in specific fields and those with a broad perspective on relevant science and engineering aspects. In this context, on March 27, 2018 the JRC organised a Workshop on Identification of Future Emerging Technologies for Ocean Enery, on it premises in Ispra. The workshop was organized on the idea of a colloquium between international experts to discuss about future emerging technologies considering different aspects such as their technology readiness level (TRL) , the potential advantages and challenges affecting their development, and evaluating the possible speed of development . A number of different technological solutions were discussed, identified directly by the invited experts on the condition that they respected the following criteria: • To be a technology for energy supply/conversion in the field of ocean energy. • To be a radically new technology/concept, not achievable by incremental research on mainstream technologies (this should match the concept of the Future Emerging Technology in the Horizon 2020 work program http://ec.europa.eu/programmes/horizon2020/en/h2020-section/future-and-emerging-technologies). • To be in an early stage of development: their Technology Readiness Level should not be more than 3. Questionnaires were sent to experts for the identification of ocean energy FETs. The templates can be found in Appendix B. The structure of the workshop was builtupon the inputs received from the experts and on in-house analysis undertaken by the JRC. The aim of this document is to gather, organize and highlight all the knowledge and information, provided by the external and internal experts, which were discussed during the workshop.","author_count":32,"contributors":["Magagna, Davide","Margheritini, Lucia","Alessi, Andrea","Bannon, Elva","Boelman, Elisa","Bould, Dave","Coy, Vicky","Marchi, Eliana De","Frigaard, Peter","Soares, Carlos Guedes","Golightly, Chris","Hals Todalshaug, Jørgen","Heward, Myles","Hofmann, Matthias","Holmes, Brian","Johnstone, Cameron","Kamizuru, Yukio","Lewis, Tony","Macadre, Laura-Mae","Maisondieu, Christophe","Martini, Michele","Moro, Alberto","Nielsen, Kim","Reis, Vera","Robertson, Simon","Schild, Philippe","Soede, Matthijs","Taylor, Nigel","Viola, Ignazio","Wallet, Nicholas","Wadbled, Xavier","Yeats, Ben"],"cuid":["S01-000.00-074368"],"event":{"end":"2018-03-27","place":"Ispra, it","start":"2018-03-27","title":"JRC Conference and Workshop","year":"2018"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD"],"country":["Belgium","France","Germany","Ireland","Italy","Netherlands","Portugal","Sweden","United Kingdom"],"glorg":["All Global Affiliations","CorPower Ocean AB","Eni S.p.A.","European Commission Joint Research Centre Institute","European Commission – Directorate-General for Research and Innovation (DG Research and Innovation)","European Marine Energy Centre (EMEC) Ltd","GE Renewable Energy","Institut français de recherche pour l'exploitation de la mer","Instituto Superior Técnico (IST)","Joint Research Centre - Directorate for Energy, Transport and Climate","Offshore Renewable Energy Catapult","Robert Bosch Foundation","SKF Group","The european marine energy centre limited","UMBRAGROUP spa","University College Cork","University of Edinburgh","Wave Energy Scotland"],"keyword":["Emerging technologies"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-NP","DI-OT","DI-U"],"level3":{"NP":["DI-NP-ALL","DI-NP-RAM"],"OT":["TTI"],"U":["DI-U-AAU","DI-U-ALL","DI-U-SDU"]},"level3all":["DI-NP-RAM","DI-U-AAU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"workshop on identification of future emerging technologies in the ocean energy sector jrc conference and workshop reports","src":["aau"],"src-code":["DI-U-AAU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.2760/23207","version":"Published Version"},"id":"S01-000.00-074368","ids":["aau-53c7b236-f770-40af-97a2-041eaf53b65c"],"keyword":["Emerging technologies","Ocean energy sector"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-3DB5F969679D36F23D56F71B2CE8CB59"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.2760/23207","version":"Published Version"},{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/289697653/Workshop_on_identification_of_future_emerging_technologies_in_the_ocean_energy_sector.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"nl","key":"joint research centre directorate for energy transport and climate","loc":["Netherlands","Europe, EU","OECD"],"name":"Joint Research Centre - Directorate for Energy, Transport and Climate","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, Department of Civil Engineering","Aalborg University, The Faculty of Engineering and Science, Department of Civil Engineering, Division of Water and Environment (CIVIL)","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment, Division of Civil and Environmental Engineering","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment, Urban Pollution Research Group"],"n