 Atmospheric Emissions & Modelling"],"nora_code":"DI-U-AU","used":1},{"affno":"5","country":"gb","key":"university of surrey","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Surrey","used":1}],"person":[{"affno":"1 2","country":"dk","first":"Mette","key":"sørensenpau","last":"Sørensen","locid":"5bf2a665-def4-499c-9c63-0c440da72e20","name":"Sørensen, Mette","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ulla","key":"arthurhvidtfeldtpau","last":"Arthur Hvidtfeldt","name":"Arthur Hvidtfeldt, Ulla","rank":2,"rolecode":"pau"},{"affno":"2","first":"Ulla Arthur","key":"hvidtfeldtpau","last":"Hvidtfeldt","name":"Hvidtfeldt, Ulla Arthur","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Aslak Harbo","key":"poulsenpau","last":"Poulsen","name":"Poulsen, Aslak Harbo","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Lau Caspar","key":"thygesenpau","last":"Thygesen","locid":"1932f287-552d-4539-8153-b2fc204a703b","name":"Thygesen, Lau Caspar","orcid":"0000-0001-8375-5211","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Lise Marie","key":"frohnpau","last":"Frohn","locid":"1db55612-df02-4189-ab0d-5c62193e1afc","name":"Frohn, Lise Marie","orcid":"0000-0002-4236-5708","rank":5,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"country":"dk","first":"Matthias","key":"ketzelpau","last":"Ketzel","locid":"798900d2-1d54-4c53-a4ca-671c12aa3015","name":"Ketzel, Matthias","orcid":"0000-0001-9519-1935","rank":6,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Jesper Heile","key":"christensenpau","last":"Christensen","locid":"5d084fe1-5909-4b7f-ac1a-907f4a30089e","name":"Christensen, Jesper Heile","orcid":"0000-0002-6741-5839","rank":7,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Jørgen","key":"brandtpau","last":"Brandt","locid":"5f570c62-a5a5-4760-b7c7-8755b6e37ebf","name":"Brandt, Jørgen","orcid":"0000-0002-7580-9547","rank":8,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Jibran","key":"khanpau","last":"Khan","locid":"c8fe96cd-050e-4aa9-8303-e03e7e92bf3e","name":"Khan, Jibran","orcid":"0000-0003-2080-2871","rank":9,"rolecode":"pau"},{"affno":"2 4","corresponding":null,"country":"dk","first":"Ole","key":"raaschounielsenpau","last":"Raaschou-Nielsen","locid":"9ae8831f-2034-4c09-84bc-01cd649e3b55","name":"Raaschou-Nielsen, Ole","rank":10,"rolecode":"pau"}],"pmid":["34411546"],"pub":{"doi":"10.1016/j.envres.2021.111886","issn":["00139351","10960953"],"issn_org":["00139351"],"journal":"Environmental Research","paperid":"111886","publisher":"Academic Press Inc.","status":"p","title":"Environmental Research","volume":"203"},"review":"Peer Reviewed","scoID":["2-s2.0-85112857154"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Non-Profit Organisations","All Universities","DI-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Non-Profit Organisations","Roskilde University","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-81914484-e1fa-4131-8587-53dc7b8b0ac3","ruc-18f2aa9c-1a87-4fd0-a387-70bcd9d19a0a","sdu-8f96d6b7-61f8-4883-a94e-fa7b1386fb47"],"src":["AU Aarhus University","RUC Roskilde University","SDU University of Southern Denmark"],"title":"The effect of adjustment to register-based and questionnaire-based covariates on the association between air pollution and cardiometabolic disease","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-098.81-022129","year":"2022","yearsub":"2022"}
{"abstract":"The lipid kinase VPS34 orchestrates autophagy, endocytosis, and metabolism and is implicated in cancer and metabolic disease. The proximal tubule in the kidney is a key metabolic organ that controls reabsorption of nutrients such as fatty acids, amino acids, sugars, and proteins. Here, by combining metabolomics, proteomics, and phosphoproteomics analyses with functional and superresolution imaging assays of mice with an inducible deficiency in proximal tubular cells, we revealed that VPS34 controlled the metabolome of the proximal tubule. In addition to inhibiting pinocytosis and autophagy, VPS34 depletion induced membrane exocytosis and reduced the abundance of the retromer complex necessary for proper membrane recycling and lipid retention, leading to a loss of fuel and biomass. Integration of omics data into a kidney cell metabolomic model demonstrated that VPS34 deficiency increased β-oxidation, reduced gluconeogenesis, and enhanced the use of glutamine for energy consumption. Furthermore, the omics datasets revealed that VPS34 depletion triggered an antiviral response that included a decrease in the abundance of apically localized virus receptors such as ACE2. VPS34 inhibition abrogated SARS-CoV-2 infection in human kidney organoids and cultured proximal tubule cells in a glutamine-dependent manner. Thus, our results demonstrate that VPS34 adjusts endocytosis, nutrient transport, autophagy, and antiviral responses in proximal tubule cells in the kidney.","author_count":25,"contributors":["Rinschen, Markus M","Harder, Jennifer L","Carter-Timofte, Madalina E","Zanon Rodriguez, Luis","Mirabelli, Carmen","Demir, Fatih","Kurmasheva, Naziia","Ramakrishnan, Suresh K","Kunke, Madlen","Tan, Yifan","Billing, Anja M","Dahlke, Eileen","Larionov, Alexey A","Bechtel-Walz, Wibke","Aukschun, Ute","Grabbe, Marlen","Nielsen, Rikke","Christensen, Erik Ilsø","Kretzler, Matthias","Huber, Tobias B","Wobus, Christiane E","Olagnier, David","Siuzdak, Gary","Grahammer, Florian","Theilig, Franziska"],"cuid":["S01-000.00-167168"],"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Europe, EU","Europe, Non-EU","OECD"],"country":["Germany","Switzerland","United States"],"glorg":["All Global Affiliations","Kiel University","Scripps Research Institute","University of Cologne","University of Freiburg","University of Fribourg","University of Hamburg","University of Michigan"],"keyword":["Animals","Antiviral Agents","Covid 19","Glutamine","Humans","Kidney","Lipids","Mice","Nutrients","SARS CoV 2"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"vps000000000034 dependent control of apical membrane function of proximal tubule cells and nutrient recovery by the kidney","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC10350314/pdf/nihms-1861569.pdf","version":"Authors Final Version"},"id":"S01-000.00-167168","identifier":[{"id":"36445937","type":"pmid"},{"id":"85143081032","type":"scopus"},{"id":"PMC10350314","type":"pmcid"}],"ids":["au-42758991-e305-4bab-ad15-456c7dbdfc61"],"keyword":["Animals","Antiviral Agents","COVID-19","Glutamine","Humans","Kidney","Lipids","Mice","Nutrients","SARS-CoV-2"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-1D0775863DFFEAFE003B08B516C83529"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC10350314/pdf/nihms-1861569.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU