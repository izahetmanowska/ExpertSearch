hrt","orcid":"0000-0002-5156-2922","rank":9,"rolecode":"pau"},{"affno":"11","corresponding":null,"first":"Luís","key":"inêspau","last":"Inês","name":"Inês, Luís","rank":10,"rolecode":"pau"},{"affno":"12 13","corresponding":null,"first":"Søren","key":"jacobsenpau","last":"Jacobsen","name":"Jacobsen, Søren","rank":11,"rolecode":"pau"},{"affno":"14","corresponding":null,"first":"Charite Kjaerside","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Charite Kjaerside","rank":12,"rolecode":"pau"},{"affno":"15","corresponding":null,"first":"Emiliano","key":"marascopau","last":"Marasco","name":"Marasco, Emiliano","rank":13,"rolecode":"pau"},{"affno":"16","corresponding":null,"first":"Marta","key":"moscapau","last":"Mosca","name":"Mosca, Marta","rank":14,"rolecode":"pau"},{"affno":"14","corresponding":null,"first":"Kirsi","key":"myllyspau","last":"Myllys","name":"Myllys, Kirsi","rank":15,"rolecode":"pau"},{"affno":"17","corresponding":null,"first":"Cristina","key":"pamfilpau","last":"Pamfil","name":"Pamfil, Cristina","rank":16,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Jose M","key":"pegoreigosapau","last":"Pego-Reigosa","name":"Pego-Reigosa, Jose M","rank":17,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jutta G","key":"richterpau","last":"Richter","name":"Richter, Jutta G","rank":18,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Savino","key":"sciasciapau","last":"Sciascia","name":"Sciascia, Savino","rank":19,"rolecode":"pau"},{"affno":"18","corresponding":null,"first":"Farah","key":"tamiroupau","last":"Tamirou","name":"Tamirou, Farah","rank":20,"rolecode":"pau"},{"affno":"19","corresponding":null,"first":"Michel","key":"tsangasjoepau","last":"Tsang-A-Sjoe","name":"Tsang-A-Sjoe, Michel","rank":21,"rolecode":"pau"},{"affno":"20","corresponding":null,"first":"Edward M","key":"vitalpau","last":"Vital","name":"Vital, Edward M","rank":22,"rolecode":"pau"},{"affno":"19","corresponding":null,"first":"Ronald","key":"vanvollenhovenpau","last":"Van Vollenhoven","name":"Van Vollenhoven, Ronald","rank":23,"rolecode":"pau"},{"affno":"21","corresponding":null,"first":"Chris","key":"wincuppau","last":"Wincup","name":"Wincup, Chris","rank":24,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Matthias","key":"schneiderpau","last":"Schneider","name":"Schneider, Matthias","rank":25,"rolecode":"pau"}],"pmid":["40841299"],"pub":{"doi":"10.1016/j.ard.2025.07.001","issn":["00034967","14682060"],"issn_org":["00034967"],"journal":"Annals of the Rheumatic Diseases","publisher":"Elsevier","status":"e","title":"Annals of the Rheumatic Diseases"},"review":"Peer Reviewed","scoID":["2-s2.0-105013796953"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["E-Published (ahead of print)"]},"sid":["aau-30102aff-588e-4e80-b6e8-e1353134913a"],"src":["AAU Aalborg University"],"title":"EULAR recommendations for a core dataset to support clinical care and translational and observational research in systemic lupus erythematosus","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-823323","year":"2025","yearsub":"2025"}
{"abstract":"PURPOSEIt is a clinical challenge to select patients for BRAF-targeted therapy because of the lack of predictive biomarkers besides the BRAF V600E mutation. By analyzing the genome, transcriptome, and proteome, this study investigated the association between baseline molecular alterations and outcomes of BRAF-targeted therapy.PATIENTS AND METHODSFresh tumor tissue from patients enrolled in the Copenhagen Prospective Personalized Oncology study was collected and underwent comprehensive molecular profiling.RESULTSTP53 comutations were most frequently detected. Patients with a TP53 wild-type tumor had a significantly longer median progression-free survival than those with TP53 comutations (hazard ratio, 2.8 [95% CI, 1.13 to 7.08]; P =.02). RNAseq revealed a distinct gene expression signature for patients with long-term disease control (LDC), including hallmarks of cell cycle arrest and proliferation in the p53 pathway. The protein analysis demonstrated that ubiquitin-conjugating enzyme EK2 was significantly downregulated in patients with LDC.CONCLUSIONUsing a multiomic approach, we identified molecular alterations associated with treatment outcomes. The potential of analyzing multiomic data is promising and should be prioritized in translational cancer research to uncover the full potential within precision oncology.","author_count":12,"contributors":["Eriksen, Martina","Hansen, Anne M.","Nielsen, Annelaura Bach","Mundt, Filip","Mann, Matthias","Lassen, Ulrik","Ahlborn, Lise B.","Højgaard, Martin","Spanggaard, Iben","Qvortrup, Camilla","Yde, Christina W.","Rohrberg, Kristoffer S."],"cuid":["S01-000.00-810811"],"filters":{"added":"2025-06","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"multiomics identifies potential molecular profiles associated with outcomes after braf targeted therapy in patients with braf v000000000600e mutated advanced solid tumors","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1200/PO.24.00266","version":"Published Version"},"id":"S01-000.00-810811","identifier":[{"id":"40080754","type":"pmid"},{"id":"105000361580","type":"scopus"},{"id":"PMC11922189","type":"pmcid"}],"ids":["ku-b53cd2fe-92a2-4043-b542-8d8b5c05290d"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-5766AC88C841C8FCD23C21141A29E967"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1200/PO.24.00266","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/449771647/eriksen-et-al-2025-multiomics-identifies-potential-molecular-profiles-associated-with-outcomes-after-braf-targeted.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Protein Research, Mann Group"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Martina","key":"eriksenpau","last":"Eriksen","name":"Eriksen, Martina","rank":1,"rolecode":"pau"},{"affno":"1","first":"Anne M.","key":"hansenpau","last":"Hansen","name":"Hansen, Anne M.","rank":2,"rolecode":"pau"},{"affno":"2","first":"Annelaura B.","key":"nielsenpau","last":"Nielsen","locid":"2a42eff8-3176-4b59-8e7c-3857eb418d8b","name":"Nielsen, Annelaura Bach","name_org":"Nielsen, Annelaura B.","rank":3,"rolecode":"pau"},{"affno":"2","first":"Filip","key":"mundtpau","last":"Mundt","locid":"4e0c0ac4-807c-40a7-971e-6718396ef306","name":"Mundt, Filip","rank":4,"rolecode":"pau"},{"affno":"2","first":"Matthias","key":"mannpau","last":"Mann","locid":"f463f571-68c5-44fb-bff1-bb9d748fcda8","name":"Mann, Matthias","orcid":"0000-0003-1292-4799","rank":5,"rolecode":"pau"},{"affno":"1","first":"Ulrik","key":"lassenpau","last":"Lassen","name":"Lassen, Ulrik","rank":6,"rolecode":"pau"},{"affno":"1","first":"Lise B.","key":"ahlbornpau","last":"Ahlborn","name":"Ahlborn, Lise B.","rank":7,"rolecode":"pau"},{"affno":"1","first":"Martin","key":"højgaardpau","last":"Højgaard","name":"Højgaard, Martin","rank":8,"rolecode":"pau"},{"affno":"1","first":"Iben","key":"spanggaardpau","last":"Spanggaard","name":"Spanggaard, Iben","rank":9,"rolecode":"pau"},{"affno":"1","first":"Camilla","key":"qvortruppau","last":"Qvortrup","name":"Qvortrup, Camilla","rank":10,"rolecode":"pau"},{"affno":"1","first":"Christina W.","key":"ydepau","last":"Yde","name":"Yde, Christina W.","rank":11,"rolecode":"pau"},{"affno":"1","first":"Kristoffer S.","key":"rohrbergpau","last":"Rohrberg","name":"Rohrberg, Kristoffer S.","rank":12,"rolecode":"pau"}],"pmid":["40080754"],"pub":{"doi":"10.1200/po.24.00266","issn":["24734284"],"journal":"JCO Precision Oncology","paperid":"00266","status":"p","title":"JCO Precision Oncology","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-105000361580"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-b53cd2fe-92a2-4043-b542-8d8b5c05290d"],"src":["KU University of Copenhagen"],"title":"Multiomics Identifies Potential Molecular Profiles Associated With Outcomes After BRAF-Targeted Therapy in Patients With BRAF V600E-Mutated Advanced Solid Tumors","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-810811","year":"2025","yearsub":"2025"}
{"abstract":"Cells change their metabolic profiles in response to underlying gene regulatory networks, but how can alterations in metabolism encode specific transcriptional instructions? Here, we show that forcing a metabolic change in embryonic stem cells (ESCs) promotes a developmental identity that better approximates the inner cell mass (ICM) of the early mammalian blastocyst in cultures. This shift in cellular identity depends on the inhibition of glycolysis and stimulation of oxidative phosphorylation (OXPHOS) triggered by the replacement of d-glucose by d-galactose in ESC media. Enhanced OXPHOS in turn activates NAD + -dependent deacetylases of the Sirtuin family, resulting in the deacetylation of histones and key transcription factors to focus enhancer activity while reducing transcriptional noise, which results in a robustly enhanced ESC phenotype. This exploitation of a NAD + /NADH coenzyme coupled to OXPHOS as a means of programming lineage-specific transcription suggests new paradigms for how cells respond to alterations in their environment, and implies cellular rejuvenation exploits enzymatic activities for simultaneous activation of a discrete enhancer set alongside silencing genome-wide transcriptional noise.","author_count":20,"contributors":["Bone, Robert A","Lowndes, Molly","Raineri, Silvia","Redó-Riveiro, Alba","Lundregan, Sarah L.","Dall, Morten","Sulek, Karolina","Romero Herrera, Jose Alejandro","Malzard, Luna","Koigi, Sandra","Heckenbach, Indra","Solis-Mezarino, Victor","Völker-Albert, Moritz","Vasilopoulou, Catherine G.","Meier, Florian","Trusina, Ala","Mann, Matthias","Nielsen, Michael L.","Treebak, Jonas T.","Brickman, Joshua M."],"cuid":["S01-000.00-819389"],"filters":{"added":"2025-08","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","Max Planck Institute of Biochemistry","Moleqlar Analytics GmbH"],"keyword":["Aging","Enhancers","Metabolism","Pluripotency","Sirtuins"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"altering metabolism programs cell identity via nad sup sup dependent deacetylation","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s44318-025-00417-0","version":"Published Version"},"id":"S01-000.00-819389","identifier":[{"id":"PMC12130289","type":"pmcid"},{"id":"40281356","type":"pmid"},{"id":"105003470286","type":"scopus"}],"ids":["ku-74dec761-95cb-4fa2-b341-b1b088833615"],"keyword":["Aging","Enhancers","Metabolism","Pluripotency","Sirtuins"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-2BFB5E91F18479A0B75AC066B5DBF0E2"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/449126031/bone-et-al-altering-metabolism-programs-cell-identity-via-nad-dependent-deacetylation.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s44318-025-00417-0","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Dept. of Biomedical Sciences, reNEW, Brickman Lab"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"de","key":"moleqlar analytics gmbh","loc":["Germany","Europe, EU","OECD"],"name":"Moleqlar Analytics GmbH","used":1},{"affno":"3","country":"de","key":"max planck institute of biochemistry","loc":["Germany","Europe, EU","OECD"],"name":"Max Planck Institute of Biochemistry","used":1}],"person":[{"affno":"1","first":"Robert A.","key":"bonepau","last":"Bone","locid":"fd8ee879-f772-406e-958e-a9930ed30523","name":"Bone, Robert A","name_org":"Bone, Robert A.","rank":1,"rolecode":"pau"},{"affno":"1","first":"Molly P.","key":"lowndespau","last":"Lowndes","locid":"a9273238-2183-49d8-805d-9cc0aac7fcd9","name":"Lowndes, Molly","name_org":"Lowndes, Molly P.","orcid":"0000-0003-3692-7847","rank":2,"rolecode":"pau"},{"affno":"1","first":"Silvia","key":"raineripau","last":"Raineri","locid":"090b8f75-25c0-42d0-8d10-e51aef33cf85","name":"Raineri, Silvia","rank":3,"rolecode":"pau"},{"affno":"1","first":"Alba","key":"rriveiropau","last":"R Riveiro","locid":"6ee68a94-132a-4737-abea-dbf13dbe6de7","name":"Redó-Riveiro, Alba","name_org":"R Riveiro, Alba","rank":4,"rolecode":"pau"},{"affno":"1","first":"Sarah L.","key":"lundreganpau","last":"Lundregan","locid":"0431ad25-511f-4426-9df7-bbedfd58e98c","name":"Lundregan, Sarah L.","rank":5,"rolecode":"pau"},{"affno":"1","first":"Morten","key":"dallpau","last":"Dall","locid":"16f23ce0-9a8b-4fb9-ad56-835399aae31d","name":"Dall, Morten","orcid":"0000-0002-8577-3162","rank":6,"rolecode":"pau"},{"affno":"1","first":"Karolina","key":"sulekpau","last":"Sulek","locid":"dfe091b3-bc3a-40cb-b540-ce37005de114","name":"Sulek, Karolina","rank":7,"rolecode":"pau"},{"affno":"1","first":"Jose A.H.","key":"romeropau","last":"Romero","locid":"529a677f-f0cf-49ce-8367-9ffa8acda16e","name":"Romero Herrera, Jose Alejandro","name_org":"Romero, Jose A.H.","orcid":"0000-0002-4765-2087","rank":8,"rolecode":"pau"},{"affno":"1","first":"Luna","key":"malzardpau","last":"Malzard","name":"Malzard, Luna","rank":9,"rolecode":"pau"},{"affno":"1","first":"Sandra","key":"koigipau","last":"Koigi","name":"Koigi, Sandra","rank":10,"rolecode":"pau"},{"affno":"1","first":"Indra J.","key":"heckenbachpau","last":"Heckenbach","locid":"b02b1552-5fc6-4f4e-9b39-0c501811f812","name":"Heckenbach, Indra","name_org":"Heckenbach, Indra J.","rank":11,"rolecode":"pau"},{"affno":"2","first":"Victor","key":"solismezarinopau","last":"Solis-Mezarino","name":"Solis-Mezarino, Victor","rank":12,"rolecode":"pau"},{"affno":"2","first":"Moritz","key":"völkeralbertpau","last":"Völker-Albert","name":"Völker-Albert, Moritz","rank":13,"rolecode":"pau"},{"affno":"3","first":"Catherine G.","key":"vasilopouloupau","last":"Vasilopoulou","name":"Vasilopoulou, Catherine G.","rank":14,"rolecode":"pau"},{"affno":"3","first":"Florian","key":"meierpau","last":"Meier","name":"Meier, Florian","rank":15,"rolecode":"pau"},{"affno":"1","first":"Ala","key":"trusinapau","last":"Trusina","locid":"94af13f2-dd1e-4c9b-a531-3cf33052ef9f","name":"Trusina, Ala","orcid":"0000-0003-1945-454X","rank":16,"rolecode":"pau"},{"affno":"3 1","first":"Matthias","key":"mannpau","last":"Mann","locid":"f463f571-68c5-44fb-bff1-bb9d748fcda8","name":"Mann, Matthias","orcid":"0000-0003-1292-4799","rank":17,"rolecode":"pau"},{"affno":"1","first":"Michael","key":"lnielsenpau","last":"L Nielsen","locid":"b72d98f7-79fa-43a7-8066-783ed8034146","name":"Nielsen, Michael L.","name_org":"L Nielsen, Michael","orcid":"0000-0002-0067-9039","rank":18,"rolecode":"pau"},{"affno":"1","first":"Jonas T.","key":"treebakpau","last":"Treebak","locid":"a648ef82-ccb3-4add-83c1-384e0d90952b","name":"Treebak, Jonas T.","orcid":"0000-0003-1488-7012","rank":19,"rolecode":"pau"},{"affno":"1","first":"Joshua M.","key":"brickmanpau","last":"Brickman","locid":"7eb57bef-9866-4e13-981e-34c12c3ad759","name":"Brickman, Joshua M.","orcid":"0000-0003-1580-7491","rank":20,"rolecode":"pau"}],"pmid":["40281356"],"pub":{"doi":"10.1038/s44318-025-00417-0","issn":["02614189","14602075"],"issn_org":["02614189"],"issue":"11","journal":"EMBO Journal","pages":"3056-3084","status":"p","title":"EMBO Journal","volume":"44"},"review":"Peer Reviewed","scoID":["2-s2.0-105003470286"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-74dec761-95cb-4fa2-b341-b1b088833615"],"src":["KU University of Copenhagen"],"title":"Altering metabolism programs cell identity via NAD<sup>+</sup>-dependent deacetylation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-819389","year":"2025","yearsub":"2025"}
{"abstract":"Poly (ADP-ribose) polymerase inhibitors (PARPi) are widely used as targeted therapies against breast cancers with BRCA mutations. However, the development of resistance to PARPi poses a significant challenge for long-term efficacy of these therapies, warranting further understanding of mechanisms of PARPi resistance. Here, we generated and characterized Olaparib resistance (OR) in BRCA1/2 mutant breast cancer cell lines MDAMB436 and HCC1428 using a systems-level multi-omics approach, including transcriptome, proteome, phosphoproteome, and ADP-ribosylation analysis. Our analyses revealed that resistance development strongly correlated with protein expression changes, while modest effects on phosphorylation- and ADP-ribosylation-dependent signaling pathways were observed. We found that BRCA1 expression was reestablished in OR MDAMB436 cell lines, while PARP1 expression was decreased. In OR HCC1428 cell lines, the BRCA2 mutation was not reverted. However, we observed increased expression of Fanconi anemia group D2 (FANCD2), histone parylation factor 1 (HPF1), and Nicotinamide phosphoribosyltransferase (NAMPT) in various cell lines, suggesting increased replication fork protection, and changes in the ADPr pathway and adaptation of metabolic pathways as resistance mechanisms. Our findings provide valuable insights into the complex landscape of PARPi resistance, offering potential targets for further investigation and therapeutic intervention.","author_count":9,"contributors":["Anagho, Holda A.","Mullari, Meeli","Mattanovich, Matthias","Cho, Hayoung","Pedersen, Anna-Kathrine","Palasca, Oana","Olsen, Jesper V.","Locard-Paulet, Marie","Nielsen, Michael L."],"cuid":["S01-000.00-829479"],"filters":{"added":"2025-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["France"],"glorg":["All Global Affiliations","University of Toulouse","Université Paul Sabatier Toulouse III"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"multi omics characterization of acquired olaparib resistance in brca000000000001 and brca000000000002 mutant breast cancer cell lines","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.mcpro.2025.101034","version":"Published Version"},"id":"S01-000.00-829479","identifier":[{"id":"40669753","type":"pmid"}],"ids":["ku-9c4646eb-a831-49bb-aa6e-fe76ffe3399f"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-2-8547272ABD1672C5BE86A8F63A7C2E89"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.mcpro.2025.101034","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/461226057/1-s2.0-S1535947625001331-main.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Protein Research, Nielsen Group","Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Protein Research, Olsen Group"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"fr","key":"university of toulouse","loc":["France","Europe, EU","OECD"],"name":"University of Toulouse","used":1},{"affno":"3","country":"fr","key":"université paul sabatier toulouse iii","loc":["France","Europe, EU","OECD"],"name":"Université Paul Sabatier Toulouse III","used":1}],"person":[{"affno":"1","first":"Holda A.","key":"anaghoholdaapau","last":"Anagho-Mattanovich","locid":"ec80f51e-c254-4806-856f-5afcb8a11e43","name":"Anagho, Holda A.","name_org":"Anagho-Mattanovich, Holda A.","orcid":"0000-0001-6406-161X","rank":1,"rolecode":"pau"},{"affno":"1","first":"Meeli","key":"mullarimeelipau","last":"Mullari","locid":"8e49b7fe-11c8-41f6-83bb-900f011919dc","name":"Mullari, Meeli","rank":2,"rolecode":"pau"},{"affno":"1","first":"Matthias","key":"mattanovichmatthiaspau","last":"Anagho-Mattanovich","locid":"67fc21b3-1868-4100-bd04-fd100bd0ef16","name":"Mattanovich, Matthias","name_org":"Anagho-Mattanovich, Matthias","rank":3,"rolecode":"pau"},{"affno":"1","first":"Hayoung","key":"chohayoungpau","last":"Cho","locid":"a7f06542-3315-449c-8c62-6fb3d6ef9605","name":"Cho, Hayoung","rank":4,"rolecode":"pau"},{"affno":"1","first":"Anna-Kathrine","key":"pedersenannakathrinepau","last":"Pedersen","locid":"e50fa07a-adf6-4b6c-8c00-8a59742d2bc7","name":"Pedersen, Anna-Kathrine","rank":5,"rolecode":"pau"},{"affno":"1","first":"Oana","key":"palascaoanapau","last":"Palasca","locid":"44df6c67-6ba9-4b67-be09-1258df9a2e71","name":"Palasca, Oana","orcid":"0000-0002-8825-8465","rank":6,"rolecode":"pau"},{"affno":"1","first":"Jesper V","key":"olsenjespervpau","last":"Olsen","locid":"16f5cd56-244f-4fe8-bebd-13ee7bd17822","name":"Olsen, Jesper V.","name_org":"Olsen, Jesper V","orcid":"0000-0002-4747-4938","rank":7,"rolecode":"pau"},{"affno":"2 3","first":"Marie","key":"locardpauletmariepau","last":"Locard-Paulet","name":"Locard-Paulet, Marie","rank":8,"rolecode":"pau"},{"affno":"1","first":"Michael L.","key":"nielsenmichaellpau","last":"Nielsen","locid":"b72d98f7-79fa-43a7-8066-783ed8034146","name":"Nielsen, Michael L.","orcid":"0000-0002-0067-9039","rank":9,"rolecode":"pau"}],"pmid":["40669753"],"pub":{"doi":"10.1016/j.mcpro.2025.101034","issn":["15359476","15359484"],"issn_org":["15359476"],"issue":"8","journal":"Molecular and Cellular Proteomics","paperid":"101034","status":"p","title":"Molecular and Cellular Proteomics","title_org":"Molecular & cellular proteomics : MCP","volume":"24"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-9c4646eb-a831-49bb-aa6e-fe76ffe3399f"],"src":["KU University of Copenhagen"],"title":"Multi-omics characterization of acquired Olaparib resistance in BRCA1 and BRCA2 mutant breast cancer cell lines","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-829479","year":"2025","yearsub":"2025"}
{"abstract":"Background: The routine use of sedation and analgesia during post-cardiac arrest care and its association with clinical outcomes remain unclear. This study aimed to describe the use of sedatives and analgesics in post-cardiac arrest care, and evaluate associations with good functional outcome, survival, clinical seizures, and late awakening. Methods: This was a post hoc analysis of the TTM2-trial, which randomized 1900 out-of-hospital cardiac arrest patients to either normothermia or hypothermia. In both groups, deep sedation (Richmond Agitation and Sedation Scale ≤ -4) was mandatory during the 40-h intervention. Cumulative doses of sedatives and analgesic drugs were recorded within the first 72 h from randomization. Outcomes were functional outcome (modified Rankin Scale) and survival status at 6 months, occurrence of clinical seizures during the intensive care stay, and late awakening (Full outline of unresponsiveness motor score of four 96 h after randomization). Cumulative propofol doses were divided into quartiles (Q1-Q4). Logistic regression models were used to assess associations between sedative doses and functional outcome and survival, clinical seizures, and late awakening, adjusting for the severity of illness and other clinical factors influencing sedation. Results: A total of 1861 patients were analyzed. In a multivariable logistic regression model, higher propofol doses (Q3, 100.7–153.6 mg/kg) were associated with good functional outcome (OR 1.62, 95%CI 1.12—2.34) and (Q2 and Q3, 43.9–153.6 mg/kg) with survival (OR 1.49, 95%CI 1.05—2.12 and OR 1.84, 95%CI 1.27—2.65, respectively). Receiving fentanyl and remifentanil were associated with good functional outcome (OR 1.69, 95%CI 1.27—2.26 and OR 1.50, 95%CI 1.11—2.02) and survival (OR 1.80, 95%CI 1.35—2.40 and OR 1.56, 95%CI 1.16—2.10). Receiving fentanyl (OR 0.64, 95%CI 0.48—0.86) and higher propofol doses (Q2-4 (43.9–669.4 mg/kg) were associated with the occurrence of clinical seizures. The highest quartile of propofol dose (153.7–669.4 mg/kg, OR 3.19, 95%CI 1.91—5.42) was associated with late awakening. Conclusions: In this study, higher doses of propofol and the use of remifentanil and fentanyl were associated with good functional outcome and survival, occurrence of clinical seizures, and late awakening.","author_count":28,"contributors":["Ceric, Ameldina","Dankiewicz, Josef","Cronberg, Tobias","Düring, Joachim","Moseby-Knappe, Marion","Annborn, Martin","May, Teresa L.","Thomas, Matthew","Grejs, Anders Morten","Rylander, Christian","Belohlavek, Jan","Wendel-Garcia, Pedro","Haenggi, Matthias","Schrag, Claudia","Hilty, Matthias P.","Keeble, Thomas R.","Wise, Matt P.","Young, Paul","Taccone, Fabio Silvio","Robba, Chiara","Cariou, Alain","Eastwood, Glenn","Saxena, Manoj","Ullén, Susann","Lilja, Gisela","Jakobsen, Janus C.","Lybeck, Anna","Nielsen, Niklas"],"cuid":["S02-089.47-813837"],"filters":{"added":"2025-08","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","Europe, EU","Europe, Non-EU","Nordic","OECD","Oceania"],"corresponding_author":["Ceric, Ameldina"],"country":["Australia","Belgium","Czechia","France","Italy","New Zealand","Poland","Sweden","Switzerland","United Kingdom","United States"],"glorg":["AP-HP Assistance Publique - Hopitaux de Paris","All Global Affiliations","Anglia Ruskin School of Medicine","Anglia Ruskin University","Bankstown-Lidcombe Hospital","Bansltwon-Lidcombe Hospital","Capital & Coast District Health Board","Cardiff University","Charles University","ETH Zürich","General Teaching Hospital","Helsingborg Hospital","Hospital Cochin","Hôpital Universitaire de Bruxelles (HUB)","Kantonsspital St. Gallen","Kantonsspital St. Gallen, St. Gallen, Switzerland.","Lund University","Maine Medical Center","Monash University","San Martino Hospital Genoa","Skåne University Hospital","University Hospital Wales","University Hospital Zurich","University Hospital of Bern