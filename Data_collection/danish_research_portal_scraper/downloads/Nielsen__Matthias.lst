t":"Ulla A.","key":"hvidtfeldtpau","last":"Hvidtfeldt","name":"Hvidtfeldt, Ulla A.","rank":4,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"country":"dk","first":"Matthias","key":"ketzelpau","last":"Ketzel","locid":"798900d2-1d54-4c53-a4ca-671c12aa3015","name":"Ketzel, Matthias","orcid":"0000-0001-9519-1935","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper H.","key":"christensenpau","last":"Christensen","locid":"5d084fe1-5909-4b7f-ac1a-907f4a30089e","name":"Christensen, Jesper Heile","name_org":"Christensen, Jesper H.","orcid":"0000-0002-6741-5839","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jørgen","key":"brandtpau","last":"Brandt","locid":"5f570c62-a5a5-4760-b7c7-8755b6e37ebf","name":"Brandt, Jørgen","orcid":"0000-0002-7580-9547","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lise M.","key":"frohnpau","last":"Frohn","locid":"1db55612-df02-4189-ab0d-5c62193e1afc","name":"Frohn, Lise Marie","name_org":"Frohn, Lise M.","orcid":"0000-0002-4236-5708","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Camilla","key":"geelspau","last":"Geels","locid":"fbcefbda-1f0a-4649-8234-28012f2714d6","name":"Geels, Camilla","orcid":"0000-0003-2549-1750","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Victor H.","key":"valenciapau","last":"Valencia","locid":"e073b447-a515-4272-887d-fe99110207e2","name":"Valencia, Victor H.","rank":10,"rolecode":"pau"},{"affno":"4 2 5","country":"dk","first":"Mette","key":"sørensenpau","last":"Sørensen","locid":"5bf2a665-def4-499c-9c63-0c440da72e20","name":"Sørensen, Mette","rank":11,"rolecode":"pau"}],"pmid":["35031338"],"pub":{"doi":"10.1016/j.envres.2022.112714","issn":["00139351","10960953"],"issn_org":["00139351"],"journal":"Environmental Research","paperid":"112714","publisher":"Academic Press Inc.","status":"p","title":"Environmental Research","volume":"208"},"review":"Peer Reviewed","scoID":["2-s2.0-85122681400"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Non-Profit Organisations","All Universities","DI-ALL","DI-NP","DI-NP-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Non-Profit Organisations","Other Research","Roskilde University","Universities"],"PST":["Published"]},"sid":["au-ab096379-bc39-4735-97de-8946cacf468d","ruc-1c2e5a23-70c1-4f33-ac80-5c8ab5affbd7"],"src":["AU Aarhus University","RUC Roskilde University"],"title":"Air pollution at the residence of Danish adults, by socio-demographic characteristics, morbidity, and address level characteristics","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-025140","year":"2022","yearsub":"2022"}
{"abstract":"Objective: Recent studies on air pollution and disease have been based on millions of participants within a region or country, relying entirely on register-based confounder adjustment. We aimed to investigate the effects of increasing adjustment for register- and questionnaire-based covariates on the association between air pollution and cardiometabolic diseases. Methods: In a population-based cohort of 246,766 eligible participants randomly selected across Denmark in 2010 and 2013 and followed up until December 31, 2017, we identified 3,247 myocardial infarction (MI) cases, 4,166 stroke cases and 6,366 type 2 diabetes cases. Based on historical address-information, we calculated 5-year time-weighted exposure to PM 2.5 and NO 2 modelled using a validated air pollution model. We used Cox proportional hazards models to calculate hazard ratios (HR) with increasing adjustment for a number of individual- and area-level register-based covariates as well as lifestyle covariates assessed through questionnaires. Results: We found that a 5 μg/m 3 higher PM 2.5 was associated with HRs (95% CI) for MI, stroke and diabetes, of respectively, 1.18 (0.91–1.52), 1.11 (0.88–1.40) and 1.24 (1.03–1.50) in the fully adjusted models. For all three diseases, adjustment for either individual-level, area-level or lifestyle covariates, or combinations of these resulted in higher HRs compared to HRs adjusted only for age, sex and calendar-year, most marked for MI and diabetes. Further adjustment for lifestyle in models with full register-based individual- and area-level adjustment resulted in only minor changes in HRs for all three diseases. Conclusions: Our findings suggest that in studies of air pollution and cardiometabolic disease, which use an adjustment strategy with a broad range of register-based socioeconomic variables, there is no effect on risk estimates from subsequent lifestyle adjustment.","author_count":11,"contributors":["Sørensen, Mette","Arthur Hvidtfeldt, Ulla","Poulsen, Aslak Harbo","Thygesen, Lau Caspar","Frohn, Lise Marie","Ketzel, Matthias","Christensen, Jesper Heile","Brandt, Jørgen","Khan, Jibran","Raaschou-Nielsen, Ole"],"cuid":["S03-098.81-022129"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"continent":["Europe, Non-EU","OECD"],"corresponding_author":["Sørensen, Mette"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of Surrey"],"keyword":["Air pollution","Cardiometabolic disease","Cohort study","Confounders"],"level":"sci","mra":["med","sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-NP","DI-U"],"level3":{"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-ALL","DI-U-AU","DI-U-RUC","DI-U-SDU"]},"level3all":["DI-NP-CAN","DI-U-AU","DI-U-RUC","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"the effect of adjustment to register based and questionnaire based covariates on the association between air pollution and cardiometabolic disease","src":["au","ruc","sdu"],"src-code":["DI-U-AU","DI-U-RUC","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85112857154","version":"Other Version"},"funding_acknowledgement":["Research described in this article was conducted under contract to the Health Effects Institute (HEI), an organization jointly funded by the United States Environmental Protection Agency (EPA) (Assistance Award No. R-82811201) and certain motor vehicle and engine manufacturers. The contents of this article do not necessarily reflect the views of HEI, or its sponsors, nor do they necessarily reflect the views and policies of the EPA or motor vehicle and engine manufacturers."],"id":"S03-098.81-022129","identifier":[{"id":"85112857154","type":"scopus"},{"id":"34411546","type":"pmid"}],"ids":["au-81914484-e1fa-4131-8587-53dc7b8b0ac3","ruc-18f2aa9c-1a87-4fd0-a387-70bcd9d19a0a","sdu-8f96d6b7-61f