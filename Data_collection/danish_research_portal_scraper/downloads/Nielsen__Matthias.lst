0-9b9d-40c8-ab2c-ff256ae11f0f","name":"Olsen, Jørn","orcid":"0000-0001-7462-5140","rank":8,"rolecode":"pau"},{"affno":"9","corresponding":null,"first":"Annette Kjær","key":"ersbøllpau","last":"Ersbøll","locid":"ba343517-a6c5-47c1-a8ba-4cbe00b7409c","name":"Ersbøll, Annette Kjær","orcid":"0000-0002-9407-3387","rank":9,"rolecode":"pau"},{"affno":"5 10","corresponding":null,"country":"dk","first":"Matthias","key":"ketzelpau","last":"Ketzel","locid":"798900d2-1d54-4c53-a4ca-671c12aa3015","name":"Ketzel, Matthias","orcid":"0000-0001-9519-1935","rank":10,"rolecode":"pau"},{"affno":"5 11","corresponding":null,"country":"dk","first":"Ole","key":"raaschounielsenpau","last":"Raaschou-Nielsen","locid":"9ae8831f-2034-4c09-84bc-01cd649e3b55","name":"Raaschou-Nielsen, Ole","rank":11,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Beate R.","key":"ritzpau","last":"Ritz","name":"Ritz, Beate R.","rank":12,"rolecode":"pau"}],"pmid":["37010840"],"pub":{"doi":"10.1001/jamapediatrics.2023.0346","issn":["21686203","21686211"],"issn_org":["21686203"],"issue":"6","journal":"JAMA Pediatrics","pages":"617-624","publisher":"American Medical Association","status":"p","title":"JAMA Pediatrics","volume":"177"},"review":"Peer Reviewed","scoID":["2-s2.0-85159314969"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Miscellaneous","All Non-Profit Organisations","All Universities","Central Denmark Region","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-NP","DI-NP-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Miscellaneous","Non-Profit Organisations","Other Research","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-82bbee42-386e-43eb-bd0f-5bc917f0ddfd","sdu-836b610d-2ccd-4b83-9004-d1f340c139df"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Association between Estimated Geocoded Residential Maternal Exposure to Lithium in Drinking Water and Risk for Autism Spectrum Disorder in Offspring in Denmark","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.79-692016","year":"2023","yearsub":"2023"}
{"abstract":"Exploring mechanisms responsible for brown adipose tissue's (BAT) high metabolic activity is crucial to exploit its energy-dissipating ability for therapeutic purposes. Basigin (Bsg), a multifunctional highly glycosylated transmembrane protein, was recently proposed as one of the 98 critical markers allowing to distinguish 'white' and 'brown' adipocytes, yet its function in thermogenic brown adipocytes is unknown. Here, we report that Bsg is negatively associated with obesity in mice. By contrast, Bsg expression increased in the mature adipocyte fraction of BAT upon cold acclimation. Additionally, Bsg levels were highly induced during brown adipocyte maturation in vitro and were further increased upon β-adrenergic stimulation in a HIF-1α-dependent manner. siRNA-mediated Bsg gene silencing in cultured brown adipocytes did not impact adipogenesis nor mitochondrial function. However, a significant decrease in mitochondrial respiration, lipolysis and Ucp1 transcription was observed in adipocytes lacking Bsg, when activated by norepinephrine. Furthermore, using gas chromatography/mass spectrometry-time-of-flight analysis to assess the composition of cellular metabolites, we demonstrate that brown adipocytes lacking Bsg have lower levels of intracellular lactate and acetoacetate. Bsg was additionally required to regulate intracellular AcAc and tricarboxylic acid cycle intermediate levels in NE-stimulated adipocytes. Our study highlights the critical role of Bsg in active brown adipocytes, possibly by controlling cellular metabolism.","author_count":18,"contributors":["Rupar, Kaja","Isidor, Marie Sophie","Argemi-Muntadas, Lidia","Agueda-Oyarzabal, Marina","Plucińska, Kaja","Brown, Erin L.","Mattanovich, Matthias","Bossi, Simone","Tozzi, Marco","Tandio, David","Petersen, Patricia S.S.","Henriksen, Tora I","Trošt, Kajetan","Hansen, Jacob B.","Gerhart-Hines, Zachary","Nielsen, Søren","Moritz, Thomas","Emanuelli, Brice"],"cuid":["S02-100.00-704456"],"filters":{"added":"2023-07","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Emanuelli, Brice"],"keyword":["Basigin","Brown adipose tissue","Faculty of Health and Medical Sciences","Metabolism","Mitochondria","Thermogenesis"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-PR","DI-U"],"level3":{"OT":["Center for Aktiv Sundhed"],"PR":["DI-PR-ALL","DI-PR-NOVO"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-PR-NOVO","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"full activation of thermogenesis in brown adipocytes requires basigin action","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1111/febs.16716","version":"Published Version"},"funding_acknowledgement":["We thank Nynne Christensen for the support with the OPERA setup. Images were taken at the Center for Advanced Bioimaging (CAB), University of Copenhagen. We also thank Oksana Dmytriyeva for help with mouse BAT tissue processing for FISH experiments. This work was supported by the Novo Nordisk Foundation Center for Basic Metabolic Research, an independent research center at the University of Copenhagen partially funded by an unrestricted donation from the Novo Nordisk Foundation (NNF18CC0034900). The Centre for Physical Activity Research (CFAS) is supported by TrygFonden (grants 101390 and 20045). KR (NNF17CC0026760), MAO (NNF19SA0035436), DT (NNF20SA0035586) and MM (NNF19CC0035454) were supported by the Copenhagen Bioscience PhD program and the Novo Nordisk Foundation. KP was supported by the Danish Diabetes Academy (PD004‐18). SN acknowledges the Novo Nordisk Foundation (grant no. NNF20OC0061400). We thank Nynne Christensen for the support with the OPERA setup. Images were taken at the Center for Advanced Bioimaging (CAB), University of Copenhagen. We also thank Oksana Dmytriyeva for help with mouse BAT tissue processing for FISH experiments. This work was supported by the Novo Nordisk Foundation Center for Basic Metabolic Research, an independent research center at the University of Copenhagen partially funded by an unrestricted donation from the Novo Nordisk Foundation (NNF18CC0034900). The Centre for Physical Activity Research (CFAS) is supported by TrygFonden (grants 101390 and 20045). KR (NNF17CC0026760), MAO (NNF19SA0035436), DT (NNF20SA0035586) and MM (NNF19CC0035454) were supported by the Copenhagen Bioscience PhD program and the Novo Nordisk Foundation. KP was supported by the Danish Diabetes Academy (PD004-18). SN acknowledges the Novo Nordisk Foundation (grant no. NNF20OC0061400)."],"id":"S02-100.00-704456","identifier":[{"id":"36595342","type":"pmid"},{"id":"85146337960","type":"scopus"},{"id":"000915253600001","type":"wos"}],"ids":["dtu-3ac37712-80a1-4f36-9af9-4cd533eceaa4","ku-4c5b8e25-216b-48cd-862b-01704482ba36"],"keyword":["Basigin","Betabolism","Faculty of Health and Medical Sciences","Metabolism","Mitochondria","brown adipose tissue","thermogenesis"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-BE7FD8654DA71AE7EEB1B6486B6A1B5B"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/341115355/The_FEBS_Journal_-_2023_-_Rupar_-_Full_activation_of_thermogenesis_in_brown_adipocytes_requires_Basigin_action.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1111/febs.16716","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://curis.ku.dk/ws/files/356899023/The_FEBS_Journal_2023_Rupar_Full_activation_of_thermogenesis_in_brown_adipocytes_requires_Basigin_action.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"U