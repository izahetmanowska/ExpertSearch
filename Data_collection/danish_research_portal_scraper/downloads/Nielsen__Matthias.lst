1493"],"pub":{"doi":"10.1038/nature11307","issn":["00280836","14764687"],"issn_org":["00280836"],"issue":"7412","journal":"Nature","pages":"508-11","publisher":"Springer Nature","status":"p","title":"Nature","volume":"488"},"review":"Peer Reviewed","scoID":["2-s2.0-84865261493"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-d4ae8393-7eeb-4dc5-afa6-100c7efcfd01","ku-eb006576-269c-402d-966b-0ef6d70b3203"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"TNF receptor 1 genetic risk mirrors outcome of anti-TNF therapy in multiple sclerosis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-028057","year":"2012","yearsub":"2012"}
{"abstract":"BACKGROUND AND PURPOSE: Years of exposure to tobacco smoke substantially increase the risk for stroke. Whether long-term exposure to outdoor air pollution can lead to stroke is not yet established. We examined the association between long-term exposure to traffic-related air pollution and incident and fatal stroke in a prospective cohort study. METHODS: We followed 57 053 participants of the Danish Diet, Cancer and Health cohort in the Hospital Discharge Register for the first-ever hospital admission for stroke (incident stroke) between baseline (1993-1997) and 2006 and defined fatal strokes as death within 30 days of admission. We associated the estimated mean levels of nitrogen dioxide at residential addresses since 1971 to incident and fatal stroke by Cox regression analyses and examined the effects by stroke subtypes: ischemic, hemorrhagic, and nonspecified stroke. RESULTS: Over a mean follow-up of 9.8 years of 52 215 eligible subjects, there were 1984 (3.8%) first-ever (incident) hospital admissions for stroke of whom 142 (7.2%) died within 30 days. We detected borderline significant associations between mean nitrogen dioxide levels at residence since 1971 and incident stroke (hazard ratio, 1.05; 95% CI, 0.99-1.11, per interquartile range increase) and stroke hospitalization followed by death within 30 days (1.22; 1.00-1.50). The associations were strongest for nonspecified and ischemic strokes, whereas no association was detected with hemorrhagic stroke. CONCLUSIONS: Long-term exposure to traffic-related air pollution may contribute to the development of ischemic but not hemorrhagic stroke, especially severe ischemic strokes leading to death within 30 days.","author_count":16,"contributors":["Andersen, Zorana Jovanovic","Kristiansen, Luise Cederkvist","Andersen, Klaus K","Olsen, Tom Skyhøj","Hvidberg, Martin","Jensen, Steen Solvang","Ketzel, Matthias","Loft, Steffen","Sørensen, Mette","Tjønneland, Anne","Overvad, Kim","Raaschou-Nielsen, Ole"],"cuid":["S03-095.91-030663"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-NP","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-ALL","DI-U-AU","DI-U-DTU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-NP-CAN","DI-U-AU","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"stroke and long term exposure to outdoor air pollution from nitrogen dioxide a cohort study","src":["au","dtu","ku"],"src-code":["DI-U-AU","DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1161/STROKEAHA.111.629246","version":"Other Version"},"id":"S03-095.91-030663","identifier":[{"id":"84856490130","type":"scopus"},{"id":"22052517","type":"pmid"}],"ids":["au-fa131ac8-7f57-45a9-8b2d-5d91f04fae15","dtu-aa198a39-84f9-487d-9c30-f4f0635b50cb","ku-ce0ca078-54dd-4ea0-b562-7750f9201dc7"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-6-5F705969D90FD90FB51D46DC12EE09C6"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1161/STROKEAHA.111.629246","version":"Other Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Section of Environmental Health"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"dcrc danish cancer society research center","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-CAN","l3nn":"DCRC Danish Cancer Society Research Center","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DCRC Danish Cancer Society Research Center","namevar":["Danish Cancer Society"],"nora_code":"DI-NP-CAN","used":1},{"affno":"3","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Informatics and Mathematical Modeling","Technical University of Denmark, Department of Informatics and Mathematical Modeling, Mathematical Statistics"],"nora_code":"DI-U-DTU","used":1},{"affno":"4","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital Herlev and Gentofte"],"nora_code":"DI-HO-CAP","used":1},{"affno":"5","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Kardiovaskulært Forskningscenter, Aalborg Sygehus","Aarhus University, Health, Department of Public Health, Department of Public Health - Department of Epidemiology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1 2","first":"Zorana Jovanovic","key":"andersenzoranajovanovicpau","last":"Andersen","locid":"8bffc514-d71e-40ba-b979-910dfb03ec5e","name":"Andersen, Zorana Jovanovic","orcid":"0000-0003-4138-9828","rank":1,"rolecode":"pau"},{"affno":"3 2","corresponding":null,"first":"Luise Cederkvist","key":"kristiansenluisecederkvistpau","last":"Kristiansen","locid":"17960120-2f99-4da5-a265-069d2a2b2b53","name":"Kristiansen, Luise Cederkvist"