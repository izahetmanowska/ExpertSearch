er Heile","orcid":"0000-0002-6741-5839","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Camilla","key":"geelspau","last":"Geels","locid":"fbcefbda-1f0a-4649-8234-28012f2714d6","name":"Geels, Camilla","orcid":"0000-0003-2549-1750","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Matthias","key":"ketzelpau","last":"Ketzel","locid":"798900d2-1d54-4c53-a4ca-671c12aa3015","name":"Ketzel, Matthias","orcid":"0000-0001-9519-1935","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Morten","key":"wintherpau","last":"Winther","locid":"e6e4932c-38fd-445f-b1b1-67f483ecd22b","name":"Winther, Morten","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Marlene Schmidt","key":"plejdruppau","last":"Plejdrup","locid":"9dede80b-ff3e-4171-9504-bf8547fec74d","name":"Plejdrup, Marlene Schmidt","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ole-Kenneth","key":"nielsenpau","last":"Nielsen","locid":"17ec76bb-7916-4024-867b-3aca60ca0c40","name":"Nielsen, Ole-Kenneth","orcid":"0000-0003-4350-0956","rank":8,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-0c5a2e45-263c-4310-b61e-dd995f1c4cf9"],"src":["AU Aarhus University"],"title":"HOVEDRAPPORTVURDERING AF LUFT OG STØJ : KORTLÆGNING OG VIRKEMIDDELKATALOG","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-136414","year":"2018","yearsub":"2018"}
{"abstract":"Objectives Exposure to traffic noise and air pollution is suspected to increase susceptibility to viral infections – the main triggering factor for febrile seizures. No studies have examined these two exposures in relation to febrile seizures. We aimed to investigate whether exposure to road traffic noise and air pollution are associated with risk of febrile seizures in childhood. Methods From our study base of 51 465 singletons from a national birth cohort, we identified 2175 cases with febrile seizures using a nationwide registry. Residential address history from conception to six years of age were found in national registers, and road traffic noise (Lden) and air pollution (NO2) were modeled for all addresses. Analyses were done using Cox proportional hazard model with adjustment for potential confounders, including mutual exposure adjustment. Results An interquartile range (IQR) increase in childhood exposure to road traffic noise and air pollution was associated with an 11% [incidence rate ratio (IRR) 1.11, 95% confidence interval (CI) 1.04–1.19) and 5% (IRR 1.05, 95% CI 1.02–1.07) higher risk for febrile seizures, respectively, after adjustment for potential confounders. Weaker tendencies were seen for pregnancy exposure. In models with mutual exposure adjustment, the estimates were slightly lower, with IRR of 1.08 (95% CI 1.00–1.16) and 1.03 (95% CI 0.99–1.06) per IQR increase in childhood exposure to road traffic noise and air pollution, respectively. Conclusions This study suggests that residential exposure to road traffic noise and air pollution is associated with higher risk for febrile seizures.","author_count":5,"contributors":["Hjortebjerg, Dorrit","Andersen, Anne Marie Nybo","Ketzel, Matthias","Raaschou-Nielsen, Ole","Sørensen, Mette"],"cuid":["S02-099.70-029646"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"corresponding_author":["Hjortebjerg, Dorrit"],"keyword":["Child health","Epidemiology"],"level":"sci","mra":["med","sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-NP","DI-U"],"level3":{"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-NP-CAN","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"exposure to traffic noise and air pollution and risk for febrile seizure a cohort study","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85052761771","version":"Other Version"},"id":"S02-099.70-029646","identifier":[{"id":"29574476","type":"pmid"},{"id":"85052761771","type":"scopus"},{"id":"000449167400011","type":"wos"}],"ids":["au-ea333e81-4a47-4afa-b261-3220a403c478","ku-f75a33d2-9cac-4bc5-a008-dc0161260c0c"],"keyword":["Child health","Epidemiology"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-7BD8641B7A2BF1FE5250214BFF7F529B"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","country":"dk","key":"dcrc danish cancer society research center","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-CAN","l3nn":"DCRC Danish Cancer Society Research Center","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DCRC Danish Cancer Society Research Center","namevar":["Danish Cancer Society"],"nora_code":"DI-NP-CAN","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Section of Epidemiology"],"nora_code":"DI-U-KU","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Environmental Science, Department of Environmental Science - Atmospheric Emissions & Modelling"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Dorrit","key":"hjortebjergpau","last":"Hjortebjerg","name":"Hjortebjerg, Dorrit","rank":1,"rolecode":"pau"},{"affno":"2","first":"Anne-Marie Nybo","key":"andersenpau","last":"Andersen","locid":"249beb4b-1fec-4854-b57d-d2bf355767db","name":"Andersen, Anne-Marie Nybo","orcid":"0000-0002-4296-8488","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Matthias","key":"ketzelpau","last":"Ketzel","locid":"798900d2-1d54-4c53-a4ca-671c12aa3015","name":"Ketzel, Matthias","orcid":"0000-0001-9519-1935","rank":3,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"country":"dk","first":"Ole","key":"raaschounielsenpau","last":"Raaschou-Nielsen","locid":"9ae8831f-2034-4c09-84bc-01cd649e3b55","name":"Raaschou-Nielsen, Ole","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mette","key":"sørensenpau","last":"Sørensen","name":"Sørensen, Mette","rank":5,"rolecode":"pau"}],"pmid":["29574476"],"pub":{"doi":"10.5271/sjweh.3724","issn":["03553140","03566528"],"issn_org":["03553140"],"issue":"5","journal":"Scandinavian Journal of Work, Environment & Health","pages":"539-546","publisher":"Nordic Association of Occupational Safety and Health","status":"p","title":"Scandinavian Journal of Work, Environment & Health","title_org":"Scandinavian Journal of Work, Environment and Health","volume":"44"},"review":"Peer Reviewed","scoID":["2-s2.0-85052761771"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Non-Profit Organisations","All Universities","DI-ALL","DI-NP","DI-NP-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Non-Profit Organisations","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-ea333e81-4a47-4afa-b261-3220a403c478","ku-f75a33d2-9cac-4bc5-a008-dc0161260c0c"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Exposure to traffic noise and air pollution and risk for febrile seizure : A cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.70-029646","year":"2018","yearsub":"2018"}
{"abstract":"Noise from wind turbines (WTs) is reported as more annoying than traffic noise at similar levels, raising concerns as to whether WT noise (WTN) may negatively affect health, as reported for traffic noise. We aimed to investigate whether residential WTN is associated with adverse birth outcomes. Based on national registries, we identified all Danish dwellings situated within ≤ 20 wt heights radius and a random selection of 25% of dwellings situated within 20–40 wt heights radius of a WT. We identified 135,795 pregnant women living in the dwellings from 1982 to 2013, and collected information on gestational age and birth weight from a national birth registry. Using data on WT type and simulated hourly wind at each WT, we estimated hourly outdoor and low frequency (LF) indoor WTN at the dwellings of the pregnant women and aggregated as mean nighttime WTN during pregnancy. We used logistic regression with adjustment for individual and area-level covariates for the analyses. We did not find evidence suggesting that mean pregnancy or trimester-specific exposure to outdoor or indoor LF WTN were associated with any of the three adverse birth outcomes investigated: preterm birth (n = 13,003), term small for gestational age (n = 12,220) or term low birth weight (n = 1127). However, the number of cases in the highest exposure categories of ≥ 42 dB outdoor WTN or ≥ 15 dB indoor LF WTN were low for all outcomes (n between 0 and 31). The present study does not support an association between nighttime WTN and adverse birth outcomes. However, there were few cases in the high exposure groups and the results call for reproduction.","author_count":8,"contributors":["Poulsen, Aslak Harbo","Raaschou-Nielsen, Ole","Peña, Alfredo","Hahmann, Andrea N.","Nordsborg, Rikke Baastrup","Ketzel, Matthias","Brandt, Jørgen","Sørensen, Mette"],"cuid":["S03-097.95-023731"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"corresponding_author":["Poulsen, Aslak Harbo"],"keyword":["Epidemiology","Low birth weight","Noise","Preterm birth","Small for gestational age","Wind turbines"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-NP","DI-U"],"level3":{"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-ALL","DI-U-AU","DI-U-DTU","DI-U-RUC"]},"level3all":["DI-NP-CAN","DI-U-AU","DI-U-DTU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"pregnancy exposure to wind turbine noise and adverse birth outcomes a nationwide cohort study","src":["au","dtu","ruc"],"src-code":["DI-U-AU","DI-U-DTU","DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85053300870","version":"Other Version"},"id":"S03-097.95-023731","identifier":[{"id":"30236517","type":"pmid"},{"id":"85053300870","type":"scopus"}],"ids":["au-97f8099b-d7bf-4e12-a171-de5d99a26843","dtu-9f97524f-9065-4076-ae7f-c133f7e9c09c","ruc-d977d2ab-a62e-4617-99ad-de56ddf5b0fb"],"keyword":["Epidemiology","Low birth weight","Noise","Preterm birth","Small for gestational age","Wind turbines"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-6-910628A0F51DE8D999328A37AA68EF01"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","country":"dk","key":"dcrc danish cancer society research center","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-CAN","l3nn":"DCRC Danish Cancer Society Research Center","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DCRC Danish Cancer Society Research Center","namevar":["Danish Cancer Society"],"nora_code":"DI-NP-CAN","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Environmental Science"],"nora_code":"DI-U-AU","used":1},{"affno":"3","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Wind Energy","Technical University of Denmark, Department of Wind Energy, Meteorology & Remote Sensing"],"nora_code":"DI-U-DTU","used":1},{"affno":"4","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of Science and Environment"],"nora_code":"DI-U-RUC","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Aslak Harbo","key":"poulsenpau","last":"Poulsen","name":"Poulsen, Aslak Harbo","rank":1,"rolecode":"pau"},{"affno":"2 1","corresponding":null,"country":"dk","first":"Ole","key":"raaschounielsenpau","last":"Raaschou-Nielsen","locid":"9ae8831f-2034-4c09-84bc-01cd649e3b55","name":"Raaschou-Nielsen, Ole","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Alfredo","key":"penadiazpau","last":"Pena Diaz","locid":"2292abbf-9c66-4504-a423-128432556c8c","name":"Peña, Alfredo","name_org":"Pena Diaz, Alfredo","orcid":"0000-0002-7900-9651","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Andrea N.","key":"hahmannpau","last":"Hahmann","locid":"c8315d00-83a0-43f3-85c8-cf51258cdc00","name":"Hahmann, Andrea N.","orcid":"0000-0001-8785-3492","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rikke Baastrup","key":"nordsborgpau","last":"Nordsborg","name":"Nordsborg, Rikke Baastrup","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Matthias","key":"ketzelpau","last":"Ketzel","locid":"798900d2-1d54-4c53-a4ca-671c12aa3015","name":"Ketzel, Matthias","orcid":"0000-0001-9519-1935","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jørgen","key":"brandtpau","last":"Brandt","locid":"5f570c62-a5a5-4760-b7c7-8755b6e37ebf","name":"Brandt, Jørgen","orcid":"0000-0002-7580-9547","rank":7,"rolecode":"pau"},{"affno":"4 1","country":"dk","first":"Mette","key":"sørensenpau","last":"Sørensen","locid":"5bf2a665-def4-499c-9c63-0c440da72e20","name":"Sørensen, Mette","rank":8,"rolecode":"pau"}],"pmid":["30236517"],"pub":{"doi":"10.1016/j.envres.2018.09.011","issn":["00139351","10960953"],"issn_org":["00139351"],"journal":"Environmental Research","pages":"770-775","publisher":"Academic Press Inc.","status":"p","title":"Environmental Research","volume":"167"},"review":"Peer Reviewed","scoID":["2-s2.0-85053300870"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Non-Profit Organisations","All Universities","DI-ALL","DI-NP","DI-NP-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Non-Profit Organisations","Other Research","Roskilde University","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["au-97f8099b-d7bf-4e12-a171-de5d99a26843","dtu-9f97524f-9065-4076-ae7f-c133f7e9c09c","ruc-d977d2ab-a62e-4617-99ad-de56ddf5b0fb"],"src":["AU Aarhus University","DTU Technical University of Denmark","RUC Roskilde University"],"title":"Pregnancy exposure to wind turbine noise and adverse birth outcomes : a nationwide cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-097.95-023731","year":"2018","yearsub":"2018"}
{"abstract":"Schistosomiasis remains one of the most prevalent parasitic diseases worldwide and the infection is frequently found in travelers and migrants. The European Network for Tropical Medicine and Travel Health conducted a sentinel surveillance study on imported schistosomiasis between 1997 and 2010. This report summarizes epidemiological and clinical data from 1,465 cases of imported schistosomiasis. Direct pathogen detection and serology were the main diagnostic tools applied. Of these, 486 (33%) cases were identified among European travelers, 231 (16%) among long-term expatriates, and 748 (51%) among non-European immigrants. Overall, only 18.6% of travelers had received pretravel advice; 95% of infections were acquired in the African region. On species level, Schistosoma mansoni was identified in 570 (39%) and Schistosoma haematobium in 318 (22%) cases; 57.5% of patients were symptomatic. Acute symptoms were reported in 27% of patients leading to earlier presentation within 3 months. Praziquantel was used in all patients to treat schistosomiasis. Many infections were detected in asymptomatic patients. In 47.4% of asymptomatic patients infection was detected by microscopy and in 39% by serology or antigen testing. Schistosomiasis remains a frequent infection in travelers and migrants to Europe. Travelers should be made aware of the risk of schistosomiasis infection when traveling to sub-Saharan Africa. Posttravel consultations particularly for returning expatriates are useful given the high potential for detecting asymptomatic infections.","author_count":39,"contributors":["Lingscheid, Tilman","Kurth, Florian","Clerinx, Jan","Marocco, Stefania","Trevino, Begoña","Schunk, Mirjam","Muñoz, José","Gjørup, Ida E.","Jelinek, Tomas","Develoux, Michel","Fry, Graham","Jänisch, Thomas","Schmid, Matthias L.","Bouchaud, Olivier","Puente, Sabino","Zammarchi, Lorenzo","Mørch, Kristine","Björkman, Anders","Siikamäki, Heli","Neumayr, Andreas","Nielsen, Henrik","Hellgren, Urban","Paul, Malgorzata","Calleri, Guido","Kosina, Pavel","Myrvang, Bjørn","Ramos, José M.","Just-Nübling, Gudrun","Beltrame, Anna","Da Cunha, José Saraiva","Kern, Peter","Rochat, Laurence","Stich, August","Pongratz, Peter","Grobusch, Martin P.","Suttorp, Norbert","Witzenrath, Martin","Hatz, Christoph","Zoller, Thomas"],"cuid":["S01-000.00-087393"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Lingscheid, Tilman"],"country":["Belgium","Czechia","Finland","France","Germany","Ireland","Italy","Netherlands","Norway","Poland","Portugal","Spain","Sweden","Switzerland","United Kingdom"],"glorg":["All Global Affiliations","Amedeo di Savoia Hospital-ASLTO2","Autonomous University of Barcelona","Barcelona Institute for Global Health","Berlin Centre for Travel and Tropical Medicine","Charité – Universitätsmedizin Berlin","Charles University","Goethe University Frankfurt","Heidelberg University ","Hospital General Universitario de Elche","Hospital Universitario La Paz","Hôpital Avicenne","Institute of Tropical Medicine Antwerp","Karolinska Institutet","Ludwig Maximilian University of Munich","Missionsärztliche Klinik","Newcastle upon Tyne Hospitals NHS Foundation Trust","Ospedale S. Cuore","Sorbonne Université","Swiss Tropical and Public Health Institute","Tropical Medical Bureau","Ulm University","University Medical Centre Rostock","University of Amsterdam","University of Basel","University of Bergen","University of Coimbra","University of Florence","University of Helsinki","University of Lausanne","University of Medical Sciences Poznan","University of Oslo","University of Udine","University of Zurich"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-AAU","DI-U-KU"]},"review":"pr","rtype":["clu"],"so