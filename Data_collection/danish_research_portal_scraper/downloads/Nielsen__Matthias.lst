"last":"Sigsgaard","locid":"5d7f5dc8-00ea-48ba-9467-a93703b015b7","name":"Sigsgaard, Torben","orcid":"0000-0002-2043-7571","rank":34,"rolecode":"pau"},{"affno":"22 23","corresponding":null,"first":"Danielle","key":"vienneaupau","last":"Vienneau","name":"Vienneau, Danielle","rank":35,"rolecode":"pau"},{"affno":"25","corresponding":null,"first":"Gudrun","key":"weinmayrpau","last":"Weinmayr","name":"Weinmayr, Gudrun","rank":36,"rolecode":"pau"},{"affno":"9","corresponding":null,"first":"Gerard","key":"hoekpau","last":"Hoek","name":"Hoek, Gerard","rank":37,"rolecode":"pau"},{"affno":"1 18 2","corresponding":null,"first":"Klea","key":"katsouyannipau","last":"Katsouyanni","name":"Katsouyanni, Klea","rank":38,"rolecode":"pau"}],"pmid":["33422970"],"pub":{"doi":"10.1016/j.envint.2020.106371","issn":["01604120","18736750"],"issn_org":["01604120"],"journal":"Environment International","paperid":"106371","publisher":"Elsevier Ltd","status":"p","title":"Environment International","volume":"147"},"review":"Peer Reviewed","scoID":["2-s2.0-85098956014"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Non-Profit Organisations","All Universities","DI-ALL","DI-NP","DI-NP-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Non-Profit Organisations","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-5a9c1c8e-8a8b-41bd-b1eb-b062358bc45c","ku-a8fb0dfe-ec73-446f-88c5-fa3e061fa65a"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Modeling multi-level survival data in multi-center epidemiological cohort studies : Applications from the ELAPSE project","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-019254","year":"2021","yearsub":"2021"}
{"abstract":"Cardiovascular disease is one of the main causes of death and disability in the Western world, and there is increasing evidence that air pollution is a risk factor for developing sub-clinical cardiovascular diseases. Previous studies have shown a correlation between cardiovascular disease and short-term exposure to elevated air pollution levels. However, the literature on the impact of long-term effect of air pollution is limited. We have a unique opportunity to evaluate this correlation. The DEHM/UBM/AirGIS model system calculates air pollution in a high temporal and spatial resolution and traces air pollution retrospectively to year 1979. The model calculates accumulated exposure using annual exposure from PM2.5 in relation to home and work addresses and takes into account working hours and holidays. We link the results from this model system to a population-based cardiovascular screening cohort of 33,723 individuals in the age of 60-74 to assess the contribution of the specific accumulated air pollution to the presence of sub-clinical arteriosclerosis in the coronary vessels, abdominal aortic aneurysms, and peripheral arterial disease. This correlation will be further analyzed in relation to specific air pollutants. This study will introduce more precise data for a longer period of time and incorporate participant's home and work addresses.","author_count":11,"contributors":["Lambrechtsen, Jess","Mayntz, Stephan Krog","Engdam, Kalle Brunebjerg","Egstrup, Kenneth","Nielsen, Jan","Steffensen, Flemming Hald","Frohn, Lise Marie","Brandt, Jørgen","Ketzel, Matthias","Pyndt Diederichsen, Axel Cosmus","Lindholt, Jes Sanddal"],"cuid":["S02-100.00-030441"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Lambrechtsen, Jess"],"keyword":["Air pollution","Cardiovascular disease","DANCAVAS","DEHM UBM AirGIS","Environmental Exposure","Particulate matter","Sub clinical arteriosclerosis","Viborg Vascular trial"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-CDR","DI-HO-SDR","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"relation between accumulated air pollution exposure and sub clinical cardiovascular disease in 000000000033 000000000723 danish 000000000060 000000000074 year old males from the background population air card a method article","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85097049138","version":"Other Version"},"id":"S02-100.00-030441","identifier":[{"id":"85097049138","type":"scopus"},{"id":"33238279","type":"pmid"}],"ids":["au-f666f978-d177-4cd6-b9bb-acf722648fb1","sdu-b0f9534e-20ae-4539-9bc3-445f99fd2264"],"keyword":["Air pollution","Cardiovascular disease","DANCAVAS","DEHM/UBM/AirGIS","Environmental exposure","Particulate matter","Sub-clinical arteriosclerosis","Viborg Vascular trial"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-5EC33A1C7E3DFE65C7739D1F8B133B82"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Medicine (Svendborg)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Svendborg Sygehus"],"nora_code":"DI-HO-SDR","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Environmental Science, Department of Environmental Science - Atmospheric Emissions & Modelling"],"nora_code":"DI-U-AU","used":1},{"affno":"4","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jess","key":"lambrechtsenpau","last":"Lambrechtsen","locid":"364569fb-abc5-45bc-9783-cdfe7c1522b7","name":"Lambrechtsen, Jess","orcid":"0000-0002-9976-9981","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Stephan Krog","key":"mayntzpau","last":"Mayntz","locid":"6b26ede7-8bbb-4f21-a222-e96d05c077b3","name":"Mayntz, Stephan Peronard","name_org":"Mayntz, Stephan Krog","orcid":"0000-0001-9206-624X","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kalle Brunebjerg","key":"engdampau","last":"Engdam","name":"Engdam, Kalle Brunebjerg","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kenneth","key":"egstruppau","last":"Egstrup","locid":"12389a61-a119-4ff8-ba31-4b0accb0bbc5","name":"Egstrup, Kenneth","orcid":"0000-0002-6214-8751","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jan","key":"nielsenpau","last":"Nielsen","locid":"014149d9-906e-4c74-ac91-2ffd5cd77a49","name":"Nielsen, Jan","orcid":"0000-0002-7634-6812","rank":