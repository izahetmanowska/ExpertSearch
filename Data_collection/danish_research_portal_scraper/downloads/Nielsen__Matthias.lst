t":"Lise M.","key":"frohnpau","last":"Frohn","locid":"1db55612-df02-4189-ab0d-5c62193e1afc","name":"Frohn, Lise Marie","name_org":"Frohn, Lise M.","orcid":"0000-0002-4236-5708","rank":7,"rolecode":"pau"},{"affno":"5","corresponding":null,"country":"dk","first":"Jesper Heile","key":"christensenpau","last":"Christensen","locid":"5d084fe1-5909-4b7f-ac1a-907f4a30089e","name":"Christensen, Jesper Heile","orcid":"0000-0002-6741-5839","rank":8,"rolecode":"pau"},{"affno":"1 7 8","country":"dk","first":"Mette","key":"sørensenpau","last":"Sørensen","locid":"5bf2a665-def4-499c-9c63-0c440da72e20","name":"Sørensen, Mette","rank":9,"rolecode":"pau"},{"affno":"1 5","corresponding":null,"country":"dk","first":"Ole","key":"raaschounielsenpau","last":"Raaschou-Nielsen","locid":"9ae8831f-2034-4c09-84bc-01cd649e3b55","name":"Raaschou-Nielsen, Ole","rank":10,"rolecode":"pau"}],"pmid":["33271946"],"pub":{"doi":"10.3390/ijerph17238949","issn":["16604601","16617827"],"issn_org":["16617827"],"issue":"23","journal":"International Journal of Environmental Research and Public Health","pages":"1-10","paperid":"8949","publisher":"Multidisciplinary Digital Publishing Institute (MDPI)","status":"p","title":"International Journal of Environmental Research and Public Health","volume":"17"},"review":"Peer Reviewed","scoID":["2-s2.0-85097121390"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Non-Profit Organisations","All Universities","DI-ALL","DI-NP","DI-NP-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Non-Profit Organisations","Other Research","Roskilde University","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-5b173e3b-2e21-49a3-9f26-b1d4e229a90f","ku-fcb2d6a4-1ccd-4106-84cb-6f33e4e6ccc6","ruc-83655699-91c3-484f-bb2f-3d9140639082"],"src":["AU Aarhus University","KU University of Copenhagen","RUC Roskilde University"],"title":"Residential Exposure to PM<sub>2.5</sub> Components and Risk of Childhood Non-Hodgkin Lymphoma in Denmark : A Nationwide Register-Based Case-Control Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-099.93-019288","year":"2020","yearsub":"2020"}
{"abstract":"Transportation noise is a growing public health concern worldwide and epidemiological evidence has linked road traffic noise with mortality. However, incongruent effect estimates have been reported between incidence and mortality studies. Therefore, the present study aimed to investigate whether long-term exposure to residential road traffic noise at the most and least exposed façades was associated with all-cause, cardiovascular disease (CVD), ischemic heart disease (IHD), stroke, respiratory, or cancer mortality in a Danish cohort study. In a cohort of 52,758 individuals from Copenhagen and Aarhus, we estimated road traffic noise at the most and least exposed façades, as well as ambient air pollution, at all present and historical residential addresses from 1987 to 2016. Using the Danish cause of death register we identified cause-specific mortality. Analyses were conducted using Cox proportional hazards models. Ten-year time-weighted mean road traffic noise exposure at the most exposed façade was associated with an 8% higher risk for all-cause mortality per interquartile range (IQR; 10.4 dB) higher exposure level (95% CI: 1.05-1.11). Higher risks were also observed for CVD (HR = 1.13, 95% CI: 1.06-1.19) and stroke (HR = 1.11, 95% CI: 0.99-1.25) mortality. Road traffic noise at the least exposed façade (per IQR; 8.4 dB) was associated with CVD (HR = 1.09, 95% CI: 1.03-1.15), IHD (HR = 1.10, 95% CI: 1.01-1.21) and stroke (HR = 1.06, 95% CI: 0.95-1.19) mortality. Results were robust to adjustment for PM2.5 and NO2. In conclusion, this study adds to the body of evidence linking exposure to road traffic noise with higher risk of mortality.","author_count":12,"contributors":["Thacher, Jesse D","Hvidtfeldt, Ulla A","Poulsen, Aslak H","Raaschou-Nielsen, Ole","Ketzel, Matthias","Brandt, Jørgen","Jensen, Steen S","Overvad, Kim","Tjønneland, Anne","Münzel, Thomas","Sørensen, Mette"],"cuid":["S04-099.11-792903"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"continent":["Europe, EU","Europe, Non-EU","OECD"],"country":["Germany","United Kingdom"],"glorg":["All Global Affiliations","Johannes Gutenberg University Mainz","University Medical Center Mainz","University of Surrey"],"keyword":["Cardiovascular disease","Cause specific","Cohort","Epidemiology","Mortality","Road traffic noise"],"level":"sci","mra":["med","sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-NP","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"NP":["DI-NP-ALL","DI-NP-CAN"],"OT":["University Medical Center Mainz of the Johannes Gutenberg University"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-RUC"]},"level3all":["DI-HO-CAP","DI-NP-CAN","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"long term residential road traffic noise and mortality in a danish cohort","src":["aau","au","ku","ruc"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85084751937","version":"Other Version"},"id":"S04-099.11-792903","identifier":[{"id":"85084751937","type":"scopus"},{"id":"32442789","type":"pmid"},{"id":"000541251900027","type":"wos"}],"ids":["aau-6e0ac84e-50f5-4305-9a53-712030af0f6c","au-b8c2afa6-29ce-40e8-8cd3-407c32694a44","ku-d10a8638-50d7-4914-a398-c8bfd896ef8c","ruc-2f30e2d8-6315-4242-94c2-19aba2b6f9f4"],"keyword":["Cardiovascular disease","Cause specific","Cohort","Epidemiology","Mortality","Road traffic noise"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-7-DBE679965DBCB1E0D0296B146D0D4A91"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"dk","key":"dcrc danish cancer society research center","l2":"DI-NP","l2n":"Non-Profit Org