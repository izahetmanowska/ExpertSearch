affno":"2","corresponding":null,"first":"Michael","key":"bachmannnielsenmichaelpau","last":"Bachmann Nielsen","name":"Bachmann Nielsen, Michael","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jørgen Arendt","key":"jensenjørgenarendtpau","last":"Jensen","locid":"e197c9fc-743f-4736-8d06-3825897e0989","name":"Jensen, Jørgen Arendt","orcid":"0000-0002-7896-3136","rank":11,"rolecode":"pau"}],"pub":{"publisher":"IEEE","status":"p","title":"Proceedings of IEEE International Ultrasonics Symposium"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-41beed53-0803-4bd6-99b1-8e85b9665c4b"],"src":["DTU Technical University of Denmark"],"title":"Accuracy and Precision of Plane Wave Vector Flow Imaging for Laminar and Complex Flow In Vivo","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-694864","year":"2017","yearsub":"2017"}
{"abstract":"Background: Atrial fibrillation is the most common sustained arrhythmia and is associated with cardiovascular morbidity and mortality. The few studies conducted on short-term effects of air pollution on episodes of atrial fibrillation indicate a positive association, though not consistently. Objectives: The aim of this study was to evaluate the long-term impact of traffic-related air pollution on incidence of atrial fibrillation in the general population. Methods: In the Danish Diet, Cancer, and Health cohort of 57,053 people 50–64 years old at enrollment in 1993–1997, we identified 2,700 cases of first-ever hospital admission for atrial fibrillation from enrollment to end of follow-up in 2011. For all cohort members, exposure to traffic-related air pollution assessed as nitrogen dioxide (NO 2) and nitrogen oxides (NO x) was estimated at all present and past residential addresses from 1984 to 2011 using a validated dispersion model. We used Cox proportional hazard model to estimate associations between long-term residential exposure to NO2 and NO x and risk of atrial fibrillation, after adjusting for lifestyle and socioeconomic position. Results: A 10 μg/m 3 higher 10-year time-weighted mean exposure to NO 2 preceding diagnosis was associated with an 8% higher risk of atrial fibrillation [incidence rate ratio: 1.08; 95% confidence interval (CI): 1.01, 1.14] in adjusted analysis. Though weaker, similar results were obtained for longterm residential exposure to NO x. We found no clear tendencies regarding effect modification of the association between NO 2 and atrial fibrillation by sex, smoking, hypertension or myocardial infarction. Conclusion: We found long-term residential traffic-related air pollution to be associated with higher risk of atrial fibrillation. Accordingly, the present findings lend further support to the demand for abatement of air pollution.","author_count":9,"contributors":["Monrad, Maria","Sajadieh, Ahmad","Christensen, Jeppe Schultz","Ketzel, Matthias","Raaschou-Nielsen, Ole","Tjønneland, Anne","Overvad, Kim","Loft, Steffen","Sørensen, Mette"],"cuid":["S02-100.00-021368"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-NP","DI-U"],"level3":{"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-NP-CAN","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"long term exposure to traffic related air pollution and risk of incident atrial fibrillation a cohort study","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1289/EHP392","version":"Published Version"},"id":"S02-100.00-021368","identifier":[{"id":"27472911","type":"pmid"},{"id":"000395714400024","type":"wos"},{"id":"85014399353","type":"scopus"},{"id":"PMC5332191","type":"pmcid"}],"ids":["au-7702f0c7-fe31-4cc3-9320-5259386e87da","ku-1393f05f-07e5-4d03-9126-6cf718a00ca9"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-109EABEFA4003794D77959C885C306E1"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1289/EHP392","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","country":"dk","key":"dcrc danish cancer society research center","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-CAN","l3nn":"DCRC Danish Cancer Society Research Center","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DCRC Danish Cancer Society Research Center","namevar":["Danish Cancer Society"],"nora_code":"DI-NP-CAN","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal medicine: Cardiology"],"nora_code":"DI-U-KU","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Environmental Science, Department of Environmental Science - Atmospheric Emissions & Modelling"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Maria","key":"monradpau","last":"Monrad","name":"Monrad, Maria","rank":1,"rolecode":"pau"},{"affno":"2","first":"Ahmad","key":"sajadiehpau","last":"Sajadieh","locid":"2f54d4de-84ea-41ba-9d41-d30368bc7b59","name":"Sajadieh, Ahmad","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jeppe Schultz","key":"christensenpau","last":"Christensen","name":"Christensen, Jeppe Schultz","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Matthias","key":"ketzelpau","last":"Ketzel","locid":"798900d2-1d54-4c53-a4ca-671c12aa3015","name":"Ketzel, Matthias","orcid":"0000-0001-9519-1935","rank":4,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"country":"dk","first":"Ole","key":"raaschounielsenpau","last":"Raaschou-Nielsen","locid":"9ae8831f-2034-4c09-84bc-01cd649e3b55","name":"Raaschou-Nielsen, Ole","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anne","key":"tjønnelandpau","last":"Tjønneland","name":"Tjønneland, Anne","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Kim","key":"overvadpau","last":"Overvad","locid":"83738c57-45d4-41e0-b807-ad0f6dec597c","name":"Overvad, Kim","orcid":"0000-0001-6429-7921","rank":7,"rolecode":"pau"},{"affno":"2","first":"Steffen","key":"loftpau","last":"Loft","locid":"cc94a7fc-b397-47b4-94a5-bde078bb4fb6","name":"Loft, Steffen","orcid":"0000-0001-9552-8518","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mette","key":"sørensenpau","last":"Sørensen","name":"Sørensen, Mette","rank":9,"rolecode":"pau"}],"pmid":["27472911"],"pub":{"doi":"10.1289/ehp392","issn":["00916765","15529924"],"issn_org":["00916765"],"issue":"3","journal":"Environmental Health Perspectives","pages":"422-427","publisher":"Public Health Services, US Dept of Health and Human Services","status":"p","title":"Environmental Health Perspectives","volume":"125"},"review":"Peer Reviewed","scoID":["2-s2.0-85014399353"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Non-Profit Organisations","All Universities","DI-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Non-Profit Organisations","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-7702f0c7-fe31-4cc3-9320-5259386e87da","ku-1393f05f-07e5-4d03-9126-6cf718a00ca9"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Long-Term Exposure to Traffic-Related Air Pollution and Risk of Incident Atrial Fibrillation : A Cohort Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-021368","year":"2017","yearsub":"2017"}
{"abstract":"Background: Ambient air pollution has been associated with certain congenital anomalies, but few studies rely on assessment of fine-scale variation in air quality and associations with noise from road traffic are unexplored. Methods: Among 84,218 liveborn singletons (1997–2002) from the Danish National Birth Cohort with complete covariate data and residential address history from conception until birth, we identified major congenital anomalies in 4018 children. Nitrogen dioxide (NO 2) and noise from road traffic (L den) burden during fetal life was modeled. Outcome and covariate data were derived from registries, hospital records and questionnaires. Odds ratios (ORs) for eleven major anomaly groups associated with road traffic pollution during first trimester were estimated using logistic regression with generalized estimating equation (GEE) approach. Results: Most of the associations tested did not suggest increased risks. A 10-µg/m 3 increase in NO 2 exposure during first trimester was associated with an adjusted ORs of 1.22 (95% confidence interval: 0.98–1.52) for ear, face and neck anomalies; 1.14 0.98–1.33) for urinary anomalies. A 10-dB increase in road traffic noise was also associated with these subgroups of anomalies as well as with an increased OR for orofacial cleft anomalies (1.17, 0.94–1.47). Inverse associations for several both air pollution and noise were observed for atrial septal defects (0.85, 0.68–1.04 and 0.81, 0.65–0.99, respectively). Conclusions: Residential road traffic exposure to noise or air pollution during pregnancy did not seem to pose a risk for development of congenital anomalies.","author_count":9,"contributors":["Pedersen, Marie","Garne, Ester","Hansen-Nord, Nete","Hjortebjerg, Dorrit","Ketzel, Matthias","Raaschou-Nielsen, Ole","Andersen, Anne-Marie Nybo","Sorensen, Mette"],"cuid":["S03-097.74-016157"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"corresponding_author":["Pedersen, Marie"],"keyword":["Air pollution","Association","Cohort","Cohort Studies","Congenital Abnormalities","Congenital anomalies","DNA Adducts","Defects","Denmark","Female","Humans","Infant Newborn","Journal Article","Logistic Models","Male","Malformations","Maternal Exposure","Metaanalysis","Newborns","Nitrogen dioxide","Noise","Noise Transportation","Odds Ratio","Pregnancy","Pregnancy outcomes","Prevalence","Research Support Non U S Gov t","Risk Assessment","Stillbirth","Traffic"],"level":"sci","mra":["med","sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-NP","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-SDR"],"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-SDR","DI-NP-CAN","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"exposure to air pollution and noise from road traffic and risk of congenital anomalies in the danish national birth cohort","src":["au","ku","sdu"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85026390724","version":"Other Version"},"id":"S03-097.74-016157","identifier":[{"id":"85026390724","type":"scopus"},{"id":"28763732","type":"pmid"},{"id":"000413280500005","type":"wos"}],"ids":["au-30c75d63-a6f5-45d6-9229-b6336691c237","ku-fb9c546d-8395-4e64-9b58-1e0d6c656c20","sdu-53ae9ac0-71df-436b-b0be-8513e5dab9b0"],"keyword":["ASSOCIATION","Air pollution","Cohort","Cohort Studies","Congenital Abnormalities","Congenital anomalies","DEFECTS","DNA-ADDUCTS","Denmark","Female","Humans","Infant, Newborn","Journal Article","Logistic Models","MALFORMATIONS","MATERNAL EXPOSURE","METAANALYSIS","Male","NEWBORNS","Nitrogen Dioxide","Noise","Noise, Transportation","Odds Ratio","PREGNANCY OUTCOMES","Pregnancy","Prevalence","Research Support, Non-U.S. Gov't","Risk Assessment","SAN-JOAQUIN VALLEY"