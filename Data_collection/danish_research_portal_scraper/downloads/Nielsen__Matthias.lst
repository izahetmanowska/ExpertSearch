en, Jesper Heile","orcid":"0000-0002-6741-5839","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lise Marie","key":"frohnpau","last":"Frohn","locid":"1db55612-df02-4189-ab0d-5c62193e1afc","name":"Frohn, Lise Marie","orcid":"0000-0002-4236-5708","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Matthias","key":"ketzelpau","last":"Ketzel","locid":"798900d2-1d54-4c53-a4ca-671c12aa3015","name":"Ketzel, Matthias","orcid":"0000-0001-9519-1935","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ole-Kenneth","key":"nielsenpau","last":"Nielsen","locid":"17ec76bb-7916-4024-867b-3aca60ca0c40","name":"Nielsen, Ole-Kenneth","orcid":"0000-0003-4350-0956","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marlene Schmidt","key":"plejdruppau","last":"Plejdrup","locid":"9dede80b-ff3e-4171-9504-bf8547fec74d","name":"Plejdrup, Marlene Schmidt","rank":6,"rolecode":"pau"}],"pub":{"issn":["22449981"],"issue":"538","pages":"47","publisher":"Aarhus University, DCE - Danish Centre for Environment and Energy","repno":"Videnskabelig rapport fra DCE - Nationalt Center for Miljø og Energi, No. 538","series":"Videnskabelig rapport fra DCE - Nationalt Center for Miljø og Energi","status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-afb482e6-5079-4d14-9863-19758dcb94fd"],"src":["AU Aarhus University"],"title":"Nationalt program for reduktion af luftforurening (NAPCP) - Udvikling i luftkvalitet og kvælstofafsætning frem til 2030.","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-229569","year":"2023","yearsub":"2023"}
{"abstract":"Multi-omics datasets are becoming of key importance to drive discovery in fundamental research as much as generating knowledge for applied biotechnology. However, the construction of such large datasets is usually time-consuming and expensive. Automation is needed to overcome these issues by streamlining workflows from sample generation to data analysis. Here, we describe the construction of a complex workflow for the generation of high-throughput microbial multi-omics datasets. The workflow comprises a custom-built platform for automated cultivation and sampling of microbes, sample preparation protocols, analytical methods for sample analysis and automated scripts for raw data processing. We demonstrate possibilities and limitations of such workflow in generating data for three biotechnologically relevant model organisms, namely Escherichia coli, Saccharomyces cerevisiae, and Pseudomonas putida.","author_count":15,"contributors":["Donati, Stefano","Mattanovich, Matthias","Hjort, Pernille","Baallal Jacobsen, Simo Abdessamad","Blomquist, Sarah Dina","Mangaard, Drude","Gurdo, Nicolás","Pacheco Pastor, Felix","Maury, Jerome","Hanke, René","Herrgård, Markus J","Wulff, Tune","Jakociunas, Tadas","Nielsen, Lars K.","McCloskey, Douglas"],"cuid":["S01-000.00-677240"],"filters":{"added":"2023-07","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-NOSI"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-PR-NOSI","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"an automated workflow for multi omics screening of microbial model organisms","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1038/s41540-023-00277-6","version":"Published Version"},"id":"S01-000.00-677240","identifier":[{"id":"37208327","type":"pmid"},{"id":"85159664964","type":"scopus"},{"id":"PMC10199033","type":"pmcid"}],"ids":["dtu-ef757ea8-8d70-4985-a645-94d6cb70d635"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-6-BABF169AC5232AD0606164D2EF3815E4"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1101/2022.07.18.500181","version":"Pre-print"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/299790148/2022.07.18.500181v1.full.pdf","version":"Pre-print"},{"access":"oa","type":"doi","url":"https://doi.org/10.1038/s41540-023-00277-6","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/323167172/s41540_023_00277_6_1_1_.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Centers, DTU Microbes Initiative","Technical University of Denmark, Novo Nordisk Foundation Center for Biosustainability","Technical University of Denmark, Novo Nordisk Foundation Center for Biosustainability, Analytics","Technical University of Denmark, Novo Nordisk Foundation Center for Biosustainability, Autoflow","Technical University of Denmark, Novo Nordisk Foundation Center for Biosustainability, C1 Metabolism","Technical University of Denmark, Novo Nordisk Foundation Center for Biosustainability, Systems Environmental Microbiology"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"novonesis","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-NOSI","l3nn":"Novonesis","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Novonesis","namevar":["Chr. Hansen AS"],"nora_code":"DI-PR-NOSI","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"