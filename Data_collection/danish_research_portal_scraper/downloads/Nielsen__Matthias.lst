ocid":"9ae8831f-2034-4c09-84bc-01cd649e3b55","name":"Raaschou-Nielsen, Ole","rank":11,"rolecode":"pau"}],"pmid":["37086881"],"pub":{"doi":"10.1016/j.envres.2023.115905","issn":["00139351","10960953"],"issn_org":["00139351"],"journal":"Environmental Research","paperid":"115905","publisher":"Academic Press Inc.","status":"p","title":"Environmental Research","volume":"229"},"review":"Peer Reviewed","scoID":["2-s2.0-85154558669"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Non-Profit Organisations","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Hospitals","Non-Profit Organisations","Roskilde University","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-37e333ca-7712-475b-9a84-f2c28c33d87f","ruc-08942fed-450c-45d6-8a45-b301756b1201"],"src":["AU Aarhus University","RUC Roskilde University"],"title":"Air pollution and myocardial infarction; effect modification by sociodemographic and environmental factors. A cohort study from Denmark : Air pollution and MI, effect modification","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-091.16-681357","year":"2023","yearsub":"2023"}
{"abstract":"Air pollution with particulate matter is an established lung carcinogen. Studies have suggested an association with breast cancer, but the evidence is inconsistent. Methods: From nationwide registers, we identified all breast cancer cases (n = 55 745) in Denmark between 2000 and 2014. We matched one control for each case on age and year of birth. We used a multi-scale dispersion model to estimate outdoor concentrations of particulate matter <2.5 μm (PM2.5), elemental carbon (EC) and nitrogen dioxide (NO2) as time-weighted average over all addresses up to 20 years prior to diagnosis. We calculated odds ratios (OR) and 95% confidence intervals (CI) by conditional logistic regression with adjustment for marital status, educational level, occupational status, personal income, region of origin, medication and area-level socio-economic indicators. Results: A 10 μg/m3 higher PM2.5 was associated with an OR for breast cancer of 1.21 (95% CI: 1.11–1.33). The corresponding ORs for EC (per 1 μg/m3) and NO2 (per 10 μg/m3) were 1.03 (95% CI: 1.00–1.07) and 1.03 (95% CI: 1.01–1.06), respectively. In multi–pollutant models, the OR for PM2.5 changed only little, whereas ORs for EC or NO2 approached the null. In an analysis of persons below 55 years, PM2.5 was associated with an OR of 1.32 (95% CI: 1.09–1.60) per 10 μg/m3 increase. Conclusion: We found evidence of an association between the investigated air pollutants and breast cancer, especially PM2.5. There were indications that the association differed by age at diagnosis. We were not able to include all potential confounders and thus, results should be interpreted with caution.","author_count":10,"contributors":["Poulsen, Aslak Harbo","Hvidtfeldt, Ulla Arthur","Sørensen, Mette","Pedersen, Julie Elbæk","Ketzel, Matthias","Brandt, Jørgen","Geels, Camilla","Christensen, Jesper H.","Raaschou-Nielsen, Ole"],"cuid":["S02-097.20-027499"],"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, Non-EU","OECD"],"corresponding_author":["Poulsen, Aslak Harbo"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of Surrey"],"keyword":["Air pollution","Breast cancer","Cancer","Case control","Epidemiology","Risk Factors"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-NP","DI-U"],"level3":{"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-ALL","DI-U-AU","DI-U-RUC"]},"level3all":["DI-NP-CAN","DI-U-AU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"air pollution with no sub 000000000002 sub pm sub 000000000002 000000000005 sub and elemental carbon in relation to risk of breast cancer a nationwide case control study from denmark","src":["au","ruc"],"src-code":["DI-U-AU","DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85141521819","version":"Other Version"},"id":"S02-097.20-027499","identifier":[{"id":"85141521819","type":"scopus"},{"id":"36356668","type":"pmid"}],"ids":["au-cc84b1f1-16b9-4310-93e1-660a349d0d86","ruc-f8b03c8b-9dc0-453a-b3b7-ba6a3961c63e"],"keyword":["Air pollution","Breast cancer","Cancer","Case control","Epidemiology","Risk factors"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-0CEB7DC33ABFDF37F47FF4AC68844041"],"org":[{"affno":"1","country":"dk","key":"dcrc danish cancer society research center","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-CAN","l3nn":"DCRC Danish Cancer Society Research Center","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DCRC Danish Cancer Society Research Center","namevar":["Danish Cancer Society"],"nora_code":"DI-NP-CAN","used":1},{"affno":"2","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of Science and Environment"],"nora_code":"DI-U-RUC","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Environmental Science, Department of Environmental Science - Atmospheric Emissions & Modelling"],"nora_code":"DI-U-AU","used":1},{"affno":"4","country":"gb","key":"university of surrey","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Surrey","used":1}],"person":[{"affno":"1","first":"Aslak Harbo","key":"poulsenpau","last":"Poulsen","name":"Poulsen, Aslak Harbo","rank":1,"rolecode":"pau"},{"affno":"1","first":"Ulla Arthur","key":"hvidtfeldtpau","last":"Hvidtfeldt","name":"Hvidtfeldt, Ulla Arthur","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ulla","key":"arthurhvidtfeldtpau","last":"Arthur Hvidtfeldt","name":"Arthur Hvidtfeldt, Ulla","rank":2,"rolecode":"pau"},{"affno":"1 2","country":"dk","first":"Mette","key":"sørensenpau","last":"Sørensen","locid":"5bf2a665-def4-499c-9c63-0c440da72e20","name":"Sørensen, Mette","rank":3,"rolecode":"pau"},{"affno":"1","first":"Julie Elbæk","key":"pedersenpau","last":"Pedersen","name":"Pedersen, Julie Elbæk","rank":4,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"country":"dk","first":"Matthias","key":"ketzelpau","last":"Ketzel","locid":"798900d2-1d54-4c53-a4ca-671c12aa3015","name":"Ketzel, Matthias","orcid":"0000-0001-9519-1935","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Jørgen","key":"brandtpau","last":"Brandt","locid":"5f570c62-a5a5-4760-b7c7-8755b6e37ebf","name":"Brandt, Jørgen","orcid":"0000-0002-7580-9547","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Camilla","key":"geelspau","last":"Geels","locid":"fbcefbda-1f0a-4649-8234-28012f2714d6","name":"Geels, Camilla","orcid":"0000-0003-2549-1750","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Jesper Heile","key":"christensenpau","last":"Christensen","locid":"5d084fe1-5909-4b7f-ac1a-907f4a30089e","name":"Christensen, Jesper Heile","orcid":"0000-0002-6741-5839","rank":8,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"country":"dk","first":"Ole","key":"raaschounielsenpau","last":"Raaschou-Nielsen","locid":"9ae8831f-2034-4c09-84bc-01cd649e3b55","name":"Raaschou-Nielsen, Ole","rank":9,"rolecode":"pau"}],"pmid":["36356668"],"pub":{"doi":"10.1016/j.envres.2022.114740","issn":["00139351","10960953"],"issn_org":["00139351"],"issue":"3","journal":"Environmental Research","paperid":"114740","publisher":"Academic Press Inc.","status":"p","title":"Environmental Research","volume":"216"},"review":"Peer Reviewed","scoID":["2-s2.0-85141521819"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Non-Profit Organisations","All Universities","DI-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Non-Profit Organisations","Roskilde University","Universities"],"PST":["Published"]},"sid":["au-cc84b1f1-16b9-4310-93e1-660a349d0d86","ruc-f8b03c8b-9dc0-453a-b3b7-ba6a3961c63e"],"src":["AU Aarhus University","RUC Roskilde University"],"title":"Air pollution with NO<sub>2</sub>, PM<sub>2.5</sub>, and elemental carbon in relation to risk of breast cancer– a nationwide case-control study from Denmark","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-097.20-027499","year":"2023","yearsub":"2023"}
{"abstract":"BACKGROUND: Exposure to air pollution has been associated with a higher risk of type 2 diabetes (T2D), but studies investigating whether deprived groups are more susceptible to the harmful effects of air pollution are inconsistent. OBJECTIVES: We aimed to investigate whether the association between air pollution and T2D differed according to sociodemographic characteristics, comorbidity, and coexposures. METHODS: We estimated residential exposure to PM 2:5, ultrafine particles (UFP), elemental carbon, and NO 2 for all persons living in Denmark in the period 2005–2017. In total, 1:8 million persons 50–80 y of age were included for main analyses of whom 113,985 developed T2D during follow-up. We conducted additional analyses on 1:3 million persons age 35–50 y. Using Cox proportional hazards model (relative risk) and Aalens additive hazard model (absolute risk), we calculated associations between 5-y time-weighted running means of air pollution and T2D in strata of sociodemo-graphic variables, comorbidity, population density, road traffic noise, and green space proximity. RESULTS: Air pollution was associated with T2D, especially among people age 50–80 y, with hazard ratios of 1.17 [95% confidence interval (CI): 1.13, 1.21] per 5 lg/m 3 PM 2:5 and 1.16 (95% CI: 1.13, 1.19) per 10,000 UFP/cm 3. In the age 50–80 y population, we found higher associations between air pollution and T2D among men in comparison with women, people with lower education vs. individuals with high education, people with medium income vs. those with low or high income, people cohabiting vs. those living alone, and people with comorbidities vs. those without comor-bidities. We observed no marked changes according to occupation, population density, road noise, or surrounding greenness. In the age 35–50 y popu-lation, similar tendencies were observed, except in relation to sex and occupation, where we observed associations with air pollution only among women and blue-collar workers. DISCUSSION: We found stronger associations between air pollution and T2D among people with existing comorbidities and weaker associations among people with high socioeconomic status in comparison with those with lower socioeconomic status.","author_count":12,"contributors":["Sørensen, Mette","Poulsen, Aslak Harbo","Hvidtfeldt, Ulla Arthur","Christensen, Jesper H.","Brandt, Jørgen","Frohn, Lise Marie","Ketzel, Matthias","Andersen, Christopher","Valencia, Victor H.","Lassen, Christina Funch","Raaschou-Nielsen, Ole"],"cuid":["S02-097.87-741775"],"filters":{"added":"2023-04","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of Surrey"],"keyword":["Adult","Aged","Aged 80 and over","Air Pollutants analysis","Air pollution","Cohort Studies","Comorbidity","Diabetes Mellitus Type 2 epidemiology","Environmental Exposure analysis","Female","Humans","Male","Middle Aged","Particulate Matter analysis"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-NP","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-ALL","DI-U-AU","DI-U-RUC"]},"level3all":["DI-HO-CAP","DI-NP-CAN","DI-U-AU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"effects of sociodemographic characteristics comorbidity and coexposures on the association between air pollution and type 000000000002 diabetes a nationwide cohort study","src":["au","ruc"],"src-code":["DI-U-AU","DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1289/EHP11347","version":"Published Version"},"id":"S02-097.87-741775","identifier":[{"id":"85148382712","type":"scopus"},{"id":"PMC9942819","type":"pmcid"},{"id":"36802347","type":"pmid"}],"ids":["au-3b535ee6-ae1f-4730-a2c6-06e128a024d4","ruc-9296d1eb-ecc9-4de8-b654-49d791801d4f"],"keyword":["Adult","Aged","Aged, 80 and over","Air Pollutants/analysis","Air Pollution","Cohort Studies","Comorbidity","Diabetes Mellitus, Type 2/epidemiology","Environmental Exposure/analysis","Female","Humans","Male","Middle Aged","Particulate Matter/analysis"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-A2C7613266E3D61E100BACECC1FC666A"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1289/EHP11347","version":"Published Version"},{"access":"oa","license":"CC0","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/89990850/EHP11347.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of Science and Environment"],"nora_code":"DI-U-RUC","used":1},{"affno":"2","country":"dk","key":"dcrc danish cancer society research center","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-CAN","l3nn":"DCRC Danish Cancer Society Research Center","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DCRC Danish Cancer Society Research Center","namevar":["Danish Cancer Society"],"nora_code":"DI-NP-CAN","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Environmental Science, Department of Environmental Science - Atmospheric Emissions & Modelling"],"nora_code":"DI-U-AU","used":1},{"affno":"4","country":"gb","key":"university of surrey","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Surrey","used":1},{"affno":"5","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"