ecode":"pau"},{"affno":"20","corresponding":null,"first":"David","key":"hildicksmithpau","last":"Hildick-Smith","name":"Hildick-Smith, David","rank":43,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Evald H","key":"christiansenpau","last":"Christiansen","locid":"06b04feb-3d2f-402d-b211-7ad5fd0387f1","name":"Christiansen, Evald Høj","name_org":"Christiansen, Evald H","orcid":"0000-0002-8740-4862","rank":45,"rolecode":"pau"}],"pmid":["27810312"],"pub":{"doi":"10.1016/s0140-6736(16)32052-9","issn":["00995355","01406736"],"issn_org":["01406736"],"issue":"10061","journal":"The Lancet","pages":"2743-2752","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"p","title":"The Lancet","title_org":"Lancet","volume":"388"},"review":"Peer Reviewed","scoID":["2-s2.0-85003691664"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-f488eca9-3b93-4dc3-9eb5-b987ac41befc","au-d5628e39-f393-4c62-9922-3d5e79fb43d5"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Percutaneous coronary angioplasty versus coronary artery bypass grafting in treatment of unprotected left main stenosis (NOBLE) : a prospective, randomised, open-label, non-inferiority trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.72-011691","year":"2016","yearsub":"2016"}
{"abstract":"Objective-Arterial injury stimulates remodeling responses that, when excessive, lead to stenosis. These responses are influenced by integrin signaling in vascular smooth muscle cells (VSMCs). Microfibrillar-associated protein 4 (MFAP4) is an integrin ligand localized to extracellular matrix fibers in the vascular wall. The role of MFAP4 in vascular biology is unknown. We aimed to test the hypothesis that MFAP4 would enhance integrin-dependent VSMC activation. Approach and Results-We produced Mfap4-deficient (Mfap4-/-) mice and performed carotid artery ligation to explore the role of MFAP4 in vascular biology in vivo. Furthermore, we investigated the effects of MFAP4 in neointimal formation ex vivo and in primary VSMC and monocyte cultures in vitro. When challenged with carotid artery ligation, Mfap4-/- mice exhibited delayed neointimal formation, accompanied by early reduction in the number of proliferating medial and neointimal cells, as well as infiltrating leukocytes. Delayed neointimal formation was associated with decreased cross-sectional area of ligated Mfap4-/- carotid arteries resulting in lumen narrowing 28 days after ligation. MFAP4 blockade prohibited the formation of neointimal hyperplasia ex vivo. Moreover, we demonstrated that MFAP4 is a ligand for integrin αVβ3 and mediates VSMC phosphorylation of focal adhesion kinase, migration, and proliferation in vitro. MFAP4-dependent VSMC activation was reversible by treatment with MFAP4-blocking antibodies and inhibitors of focal adhesion kinase and downstream kinases. In addition, we showed that MFAP4 promotes monocyte chemotaxis in integrin αVβ3-dependent manner. Conclusions-MFAP4 regulates integrin αVβ3-induced VSMC proliferation and migration, as well as monocyte chemotaxis, and accelerates neointimal hyperplasia after vascular injury.","author_count":26,"contributors":["Schlosser, Anders","Pilecki, Bartosz","Hemstra, Line E.","Kejling, Karin","Kristmannsdottir, Gudlaug B.","Wulf-Johansson, Helle","Moeller, Jesper B.","Füchtbauer, Ernst-Martin","Nielsen, Ole","Kirketerp-Møller, Katrine","Dubey, Lalit K.","Hansen, Pernille B L","Stubbe, Jane","Wrede, Christoph","Hegermann, Jan","Ochs, Matthias","Rathkolb, Birgit","Schrewe, Anja","Bekeredjian, Raffi","Wolf, Eckhard","Gailus-Durner, Valérie","Fuchs, Helmut","De Angelis, Martin Hrabě","Lindholt, Jes S.","Holmskov, Uffe","Sorensen, Grith L."],"cuid":["S02-099.93-024672"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD"],"corresponding_author":["Sorensen, Grith L."],"country":["Germany"],"glorg":["All Global Affiliations","Excellence Cluster ORIGINS","German Mouse Clinic","Hannover Medical School","Heidelberg University ","Helmholtz Association of German Research Centres","Ludwig Maximilian University","Technical University of Munich"],"keyword":["Animals","Apoptosis","Carotid Artery Diseases genetics","Carotid Stenosis","Carrier Proteins genetics","Cell Movement drug effects","Cell Proliferation drug effects","Cells Cultured","Chemotaxis Leukocyte","Disease Models Animal","Extracellular Matrix Proteins","Genotype","Glycoproteins deficiency","Humans","Hyperplasia","Ligands","MFAP4 protein","Male","Mice Inbred BALB C","Mice Inbred C57BL","Mice Knockout","Monocytes metabolism","Mouse","Muscle","Muscle Smooth Vascular drug effects","Myocytes Smooth Muscle drug effects","Neointima","Phenotype","Phosphorylation","Protein Kinase Inhibitors pharmacology","Signal Transduction","Smooth","Time Factors","Vascular","Vascular remodeling","integrin alphaVbeta3"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR","DI-HO-SDR"],"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-CDR","DI-HO-SDR","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"