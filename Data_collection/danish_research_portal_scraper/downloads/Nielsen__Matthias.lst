7010-2350","rank":8,"rolecode":"pau"}],"pmid":["29988735"],"pub":{"doi":"10.2147/ppa.s166278","issn":["1177889X"],"journal":"Patient Preference and Adherence","pages":"1139-1150","publisher":"Dove Medical Press Ltd","publisher_org":"Dove Medical Press Ltd.","status":"p","title":"Patient Preference and Adherence","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-85058676433"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Private Research","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Other Companies","Private Research","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark","novartis healthcare a/s","novartis pharmaceutical a/s"],"PST":["Published"]},"sid":["aau-8360ff3b-e7e5-45f1-bd55-3446b856f966","au-4bbc150d-fbe8-4eb4-b8b3-dddbbda1f1ff","sdu-dac37830-fc62-4fed-a192-5c03dde5e146"],"src":["AAU Aalborg University","AU Aarhus University","SDU University of Southern Denmark"],"title":"High treatment adherence, satisfaction, motivation, and health-related quality of life with fingolimod in patients with relapsing-remitting multiple sclerosis - results from a 24-month, multicenter, open-label Danish study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-098.45-006362","year":"2018","yearsub":"2018"}
{"abstract":"Air pollutant levels over Denmark are simulated using the high resolution THOR model system for the years 1979–2015. The system employs the Danish Eulerian Hemispheric Model (DEHM), coupled to the Urban Background Model (UBM) that covers the whole of Denmark on a 1 km spatial resolution. This study evaluates the performance of the model system in simulating hourly, daily, monthly and yearly mean ozone (O 3), nitrogen oxides (NOx) and particulate matter (PM 10 and PM 2.5) concentrations using surface measurements from eight Danish monitoring stations between 1990 and 2015. The spatial and temporal variability of air pollutants and emissions are also investigated to better understand the air pollution trends over Denmark during this 37 year period.","author_count":10,"contributors":["Im, Ulas","Christensen, Jesper Heile","Ketzel, Matthias","Ellermann, Thomas","Geels, Camilla","Hansen, Kaj Mantzius","Hertel, Ole","Nielsen, Ole-Kenneth","Plejdrup, Marlene Schmidt","Brandt, Jørgen"],"cuid":["S01-000.00-229560"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Integrated modelling","Model evaluation","Ozone","Particulate matter","TRENDS"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"air pollutant trends over denmark over the last 000000000037 years as simulated by the integrated thor model system","src":["au"],"src-code":["DI-U-AU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85060484901","version":"Other Version"},"id":"S01-000.00-229560","identifier":[{"id":"85060484901","type":"scopus"}],"ids":["au-afaf98aa-9b94-40a0-a70a-68c69134ed1a"],"keyword":["Integrated modelling","Model evaluation","Ozone","Particulate matter","Trends"],"lang":"English","