y":"lutzpedh","last":"Lutz","name":"Lutz, Juliana","rank":20,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Daniel","key":"müllerpedh","last":"Müller","name":"Müller, Daniel","rank":21,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-319-33628-2","eisbn":["9783319336282"],"isbn":["9783319336268"],"issn":["22142339"],"pages":"127-147","publisher":"Springer","series":"Human - Environment Interactions","status":"p","subtitle":"Ecological, Economic and Social Perspectives","title":"Land Use Competition"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-8c66c155-e863-41f9-ae23-7af457b43e55"],"src":["KU University of Copenhagen"],"title":"Competition for Land-Based Ecosystem Services : Trade-Offs and Synergies","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-477408","year":"2016","yearsub":"2016"}
{"abstract":"This work presents the first in vivo results of 2-D high frame rate vector velocity imaging for transthoracic cardiac imaging. Measurements are made on a healthy volunteer using the SARUS experimental ultrasound scanner connected to an intercostal phased-Array probe. Two parasternal long-Axis view (PLAX) are obtained, one centred at the aortic valve and another centred at the left ventricle. The acquisition sequence was composed of 3 diverging waves for high frame rate synthetic aperture flow imaging. For verification a phantom measurement is performed on a transverse straight 5 mm diameter vessel at a depth of 100 mm in a tissue-mimicking phantom. A flow pump produced a 2 ml/s constant flow with a peak velocity of 0.2 m/s. The average estimated flow angle in the ROI was 86.22° ± 6.66° with a true flow angle of 90°. A relative velocity bias of-39% with a standard deviation of 13% was found. In-vivo acquisitions show complex flow patterns in the heart. In the aortic valve view, blood is seen exiting the left ventricle cavity through the aortic valve into the aorta during the systolic phase of the cardiac cycle. In the left ventricle view, blood flow is seen entering the left ventricle cavity through the mitral valve and splitting in two ways when approximating the left ventricle wall. The work presents 2-D velocity estimates on the heart from a non-invasive transthoracic scan. The ability of the method detecting flow regardless of the beam angle could potentially reveal a more complete view of the flow patterns presented on the heart.","author_count":7,"contributors":["Villagómez-Hoyos, Carlos A.","Stuart, Matthias B.","Bechsgaard, Thor","Nielsen, Michael Bachmann","Jensen, Jørgen Arendt"],"cuid":["S01-000.00-511769"],"event":{"end":"2016-02-29","place":"San Diego, us","start":"2016-02-28","title":"Medical Imaging 2016: Ultrasonic Imaging and Tomography","year":"2016"},"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Blood flow","Cardiac imaging","Medical ultrasound","Synthetic aperture","Vector flow imaging"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"high frame rate synthetic aperture vector flow imaging for transthoracic echocardiography","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=84976510399&partnerID=8YFLogxK","version":"Other Version"},"id":"S01-000.00-511769","identifier":[{"id":"84976510399","type":"scopus"}],"ids":["ku-c63a9ced-2f4c-4e67-90b4-dbc643182a50"],"keyword":["Blood Flow","Cardiac Imaging","Medical Ultrasound","Synthetic Aperture","Vector Flow Imaging"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-3-5-CC938441886824B10B22C5A4FE64E804"],"org":[{"affno":"1","country":"dk","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Carlos A.","key":"villagómezhoyoscarlosapau","last":"Villagómez-Hoyos","name":"Villagómez-Hoyos, Carlos A.","rank":1,"rolecode":"pau"},{"affno":"1","first":"Matthias B.","key":"stuartmatthiasbpau","last":"Stuart","name":"Stuart, Matthias B.","rank":2,"rolecode":"pau"},{"affno":"2","first":"Thor","key":"bechsgaardthorpau","last":"Bechsgaard","name":"Bechsgaard, Thor","rank":3,"rolecode":"pau"},{"affno":"2","first":"Michael Bachmann","key":"nielsenmichaelbachmannpau","last":"Nielsen","locid":"6c91b654-63b7-4eeb-8a6e-ee4a2708020a","name":"Nielsen, Michael Bachmann","orcid":"0000-0002-9380-1688","rank":4,"rolecode":"pau"},{"affno":"1","first":"Jørgen Arendt","key":"jensenjørgenarendtpau","last":"Jensen","name":"Jensen, Jørgen Arendt","rank":5,"rolecode":"pau"},{"affno":"","first":"Brecht","key":"heydebrechtpedh","last":"Heyde","name":"Heyde, Brecht","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Neb","key":"duricnebpedh","last":"Duric","name":"Duric, Neb","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1117/12.2216707","eisbn":["9781510600256"],"issn":["16057422"],"publisher":"SPIE","series":"Progress in Biomedical Optics and Imaging - Proceedings of SPIE","status":"p","subtitle":"Ultrasonic Imaging and Tomography","title":"Medical Imaging 2016"},"review":"Peer Reviewed","scoID":["2-s2.0-84976510399"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-c63a9ced-2f4c-4e67-90b4-dbc643182a50"],"src":["KU University of Copenhagen"],"title":"High frame rate synthetic aperture vector flow imaging for transthoracic echocardiography","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-511769","year":"2016","yearsub":"2016"}
{"abstract":"BACKGROUND: Studies have found long-term exposure to traffic noise to be associated with higher risk for hypertension, ischemic heart disease and stroke. We aimed to investigate the novel hypothesis that traffic noise increases the risk of atrial fibrillation (A-fib). METHODS: In a population-based cohort of 57,053 people aged 50-64years at enrolment in 1993-1997, we identified 2692 cases of first-ever hospital admission of A-fib from enrolment to end of follow-up in 2011 using a nationwide registry. The mean follow-up time was 14.7years. Present and historical residential addresses were identified for all cohort members from 1987 to 2011. For all addresses, exposure to road traffic and railway noise was estimated using the Nordic prediction method and exposure to air pollution was estimated using a validated dispersion model. We used Cox proportional hazard model for the analyses with adjustment for lifestyle, socioeconomic position and air pollution. RESULTS: A 10dB higher 5-year time-weighted mean exposure to road traffic noise was associated with a 6% higher risk of A-fib (incidence rate ratio (IRR): 1.06; 95% confidence interval (95% CI): 1.00-1.12) in models adjusted for factors related to lifestyle and socioeconomic position. The association followed a monotonic exposure-response relationship. In analyses with adjustment for air pollution, NOx or NO2, there were no statistically significant associations between exposure to road traffic noise and risk of A-fib; IRR: 1.04; (95% CI: 0.96-1.11) and IRR: 1.01; (95% CI: 0.94-1.09), respectively. Exposure to railway noise was not associated with A-fib. CONCLUSION: Exposure to residential road traffic noise may be associated with higher risk of A-fib, though associations were difficult to separate from exposure to air pollution.","author_count":9,"contributors":["Monrad, Maria","Sajadieh, Ahmad","Christensen, Jeppe Schultz","Ketzel, Matthias","Raaschou-Nielsen, Ole","Tjønneland, Anne","Overvad, Kim","Loft, Steffen","Sørensen, Mette"],"cuid":["S03-099.88-004707"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"keyword":["Arrhythmia","Cohort","Epidemiology","Traffic noise"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-NP","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-NDR"],"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-HO-NDR","DI-NP-CAN","DI-U-AAU","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"residential exposure to traffic noise and risk of incident atrial fibrillation a cohort study","src":["aau","au","ku"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84965036045","version":"Other Version"},"id":"S03-099.88-004707","identifier":[{"id":"000378951700048","type":"wos"},{"id":"27164554","type":"pmid"},{"id":"84965036045","type":"scopus"}],"ids":["aau-60f5d767-73ce-4a21-b6ba-9051b57566f7","au-8f8a5519-f8ef-4a69-8b71-751df958a9c2","ku-ab2536d0-1c18-4be4-a1d8-433cd15873f5"],"keyword":["Arrhythmia","Cohort","Epidemiology","Traffic noise"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-0CE89ECA552F4916C135DC31369EDE12"],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","country":"dk","key":"dcrc danish cancer society research center","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-CAN","l3nn":"DCRC Danish Cancer Society Research Center","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DCRC Danish Cancer Society Research Center","namevar":["Danish Cancer Society"],"nora_code":"DI-NP-CAN","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Environmental Science, Department of Environmental Science - Atmospheric Emissions & Modelling"],"nora_code":"DI-U-AU","used":1},{"affno":"4","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Hjertemedicin (Kardiologi) [Klinik Hjerte-Lunge]","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Hjerte-Lunge"],"nora_code":"DI-U-AAU","used":1},{"affno":"5","country":"dk","key":"north denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-NDR","l3nl":"North Denmark Region","l3nn":"North Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"North Denmark Region","namevar":["Aalborg University Hospital"],"nora_code":"DI-HO-NDR","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Maria","key":"monradpau","last":"Monrad","name":"Monrad, Maria","rank":1,"rolecode":"pau"},{"affno":"2","first":"Ahmad","key":"sajadiehpau","last":"Sajadieh","locid":"2f54d4de-84ea-41ba-9d41-d30368bc7b59","name":"Sajadieh, Ahmad","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jeppe Schultz","key":"christensenpau",