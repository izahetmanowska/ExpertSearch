ode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Brian","key":"nielsenpau","last":"Nielsen","locid":"741becc9-733e-42da-bad3-762408365b66","name":"Nielsen, Brian","orcid":"0000-0002-0935-2104","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Marius","key":"mikučionispau","last":"Mikučionis","locid":"22f2be61-abfe-4717-a5f7-a4f58bc77852","name":"Mikučionis, Marius","orcid":"0000-0001-8157-5428","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Petur","key":"olsenpau","last":"Olsen","locid":"efbc1e4c-7725-4774-93dd-10a62a21ba97","name":"Olsen, Petur","orcid":"0000-0003-3472-5846","rank":5,"rolecode":"pau"},{"affno":"","first":"Manuel","key":"núñezpedh","last":"Núñez","name":"Núñez, Manuel","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Matthias","key":"güdemannpedh","last":"Güdemann","name":"Güdemann, Matthias","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-319-19458-5_4","eisbn":["9783319194585"],"isbn":["9783319194578"],"issn":["03029743"],"issue":"9128","pages":"47-61","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","subtitle":"20th International Workshop, FMICS 2015 Oslo, Norway, June 22-23, 2015 Proceedings","title":"Formal Methods for Industrial Critical Systems"},"review":"Peer Reviewed","scoID":["2-s2.0-84931049769"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-9cc13688-2b80-45dc-b483-8522d42cdb35"],"src":["AAU Aalborg University"],"title":"Formal Analysis and Testing of Real-Time Automotive Systems Using UPPAAL Tools","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-095516","year":"2015","yearsub":"2015"}
{"abstract":"Exposure to traffic noise may result in stress and sleep disturbances, which have been associated with impairment of the immune system. People with weakened immune systems are known to have a higher risk for non-Hodgkin lymphoma (NHL). We aimed to determine whether traffic noise was associated with risk for NHL in a nationwide case-control study. We identified 2753 cases aged 30-84 years with a primary diagnosis of NHL in Denmark between 1992 and 2010. For each case we selected two random population controls, matched on sex and year of birth. Road traffic and railway noise were calculated, and airport noise was estimated for all present and historical residential addresses of cases and controls from 1987 to 2010. Associations between traffic noise and risk for NHL were estimated using conditional logistic regression, adjusted for disposable income, education, cohabiting status and comorbidity. We found that a 5-year time-weighted mean of road traffic noise above 65. dB was associated with an 18% higher risk for NHL (95% confidence interval (CI) 1.01-1.37) when compared to road traffic noise below 55. dB, whereas for exposure between 55 and 65. dB no association was found (odds ratio: 0.98; 95% CI: 0.88-1.08). In analyzes of NHL subtypes, we found no association between road traffic noise and risk for T-cell lymphoma, whereas increased risks for B-cell lymphoma and unspecified lymphomas were observed at exposures above 65. dB. In conclusion, our nationwide study may indicate that high exposure to traffic noise is associated with higher NHL risk.","author_count":6,"contributors":["Sørensen, Mette","Poulsen, Aslak Harbo","Ketzel, Matthias","Oksbjerg Dalton, Susanne","Friis, Søren","Raaschou-Nielsen, Ole"],"cuid":["S01-000.00-207039"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Sørensen, Mette"],"keyword":["Case control","Epidemiology","Traffic noise","non Hodgkin lymphoma"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-NP","DI-U"],"level3":{"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-NP-CAN","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"residential exposure to traffic noise and risk for non hodgkin lymphoma among adults","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84936746463","version":"Other Version"},"id":"S01-000.00-207039","identifier":[{"id":"84936746463","type":"scopus"},{"id":"26113038","type":"pmid"}],"ids":["au-8828ac34-e408-48e6-b538-0c09e29672ba"],"keyword":["Case-control","Epidemiology","Non-Hodgkin lymphoma","Traffic noise"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-8B4A235417851EF59E28718E035A234D"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","country":"dk","key":"dcrc danish cancer society research center","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-CAN","l3nn":"DCRC Danish Cancer Society Research Center","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DCRC Danish Cancer Society Research Center","namevar":["Danish Cancer Society"],"nora_code":"DI-NP-CAN","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Environmental Science, Department of Environmental Science - Environmental social science, Silkeborg"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Mette","key":"sørensenpau","last":"Sørensen","name":"Sørensen, Mette","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Aslak Harbo","key":"poulsenpau","last":"Poulsen","name":"Poulsen, Aslak Harbo","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Matthias","key":"ketzelpau","last":"Ketzel","locid":"798900d2-1d54-4c53-a4ca-671c12aa3015","name":"Ketzel, Matthias","orcid":"0000-0001-9519-1935","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Susanne","key":"oksbjergdaltonpau","last":"Oksbjerg Dalton","name":"Oksbjerg Dalton, Susanne","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren","key":"friispau","last":"Friis","name":"Friis, Søren","rank":5,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Ole","key":"raaschounielsenpau","last":"Raaschou-Nielsen","locid":"9ae8831f-2034-4c09-84bc-01cd649e3b55","name":"Raaschou-Nielsen, Ole","rank":6,"rolecode":"pau"}],"pmid":["26113038"],"pub":{"doi":"10.1016/j.envres.2015.06.016","issn":["00139351","10960953"],"issn_org":["00139351"],"journal":"Environmental Research","pages":"61-65","publisher":"Academic Press Inc.","status":"p","title":"Environmental Research","volume":"142"},"review":"Peer Reviewed","scoID":["2-s2.0-84936746463"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Non-Profit Organisations","All Universities","DI-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Non-Profit Organisations","Universities"],"PST":["Published"]},"sid":["au-8828ac34-e408-48e6-b538-0c09e29672ba"],"src":["AU Aarhus University"],"title":"Residential exposure to traffic noise and risk for non-hodgkin lymphoma among adults","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-207039","year":"2015","yearsub":"2015"}
{"abstract":"A large genotyping project within the Breast Cancer Association Consortium (BCAC) recently identified 41 associations between single nucleotide polymorphisms (SNPs) and overall breast cancer (BC) risk. We investigated whether the effects of these 41 SNPs, as well as six SNPs associated with estrogen receptor (ER) negative BC risk are modified by 13 environmental risk factors for BC. Data from 22 studies participating in BCAC were pooled, comprising up to 26,633 cases and 30,119 controls. Interactions between SNPs and environmental factors were evaluated using an empirical Bayes-type shrinkage estimator. Six SNPs showed interactions with associated p-values (pint ) <1.1 × 10(-3) . None of the observed interactions was significant after accounting for multiple testing. The Bayesian False Discovery Probability was used to rank the findings, which indicated three interactions as being noteworthy at 1% prior probability of interaction. SNP rs6828523 was associated with increased ER-negative BC risk in women ≥170 cm (OR = 1.22, p = 0.017), but inversely associated with ER-negative BC risk in women <160 cm (OR = 0.83, p = 0.039, pint = 1.9 × 10(-4) ). The inverse association between rs4808801 and overall BC risk was stronger for women who had had four or more pregnancies (OR = 0.85, p = 2.0 × 10(-4) ), and absent in women who had had just one (OR = 0.96, p = 0.19, pint = 6.1 × 10(-4) ). SNP rs11242675 was inversely associated with overall BC risk in never/former smokers (OR = 0.93, p = 2.8 × 10(-5) ), but no association was observed in current smokers (OR = 1.07, p = 0.14, pint = 3.4 × 10(-4) ). In conclusion, recently identified BC susceptibility loci are not strongly modified by established risk factors and the observed potential interactions require confirmation in independent studies.","author_count":50,"contributors":["Rudolph, Anja","Milne, Roger L","Truong, Thérèse","Knight, Julia A","Seibold, Petra","Flesch-Janys, Dieter","Behrens, Sabine","Eilber, Ursula","Bolla, Manjeet K","Wang, Qin","Dennis, Joe","Dunning, Alison M","Shah, Mitul","Munday, Hannah R","Darabi, Hatef","Eriksson, Mikael","Brand, Judith S","Olson, Janet","Vachon, Celine M","Hallberg, Emily","Castelao, J Esteban","Carracedo, Angel","Torres, Maria","Li, Jingmei","Humphreys, Keith","Cordina-Duverger, Emilie","Menegaux, Florence","Flyger, Henrik","Nordestgaard, Børge G","Nielsen, Sune F","Yesilyurt, Betul T","Floris, Giuseppe","Leunen, Karin","Engelhardt, Ellen G","Broeks, Annegien","Rutgers, Emiel J","Glendon, Gord","Mulligan, Anna Marie","Cross, Simon","Reed, Malcolm","Gonzalez-Neira, Anna","Arias Perez, José Ignacio","Provenzano, Elena","Apicella, Carmel","Southey, Melissa C","Spurdle, Amanda","Häberle, Lothar","Beckmann, Matthias W","Ekici, Arif B","Bojesen, Stig E"],"cuid":["S01-000.00-434660"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"corpau":["kConFab Investigators"],"keyword":["Breast Neoplasms","Female","Gene Environment Interaction","Genetic Loci","Genetic Predisposition to Disease","Humans","Polymorphism Single Nucleotide","Receptors Estrogen","Risk Factors"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"investigation of gene environment interactions between 000000000047 newly identified breast cancer susceptibility loci and environmental risk factors","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-434660","identifier":[{"id":"25227710","type":"pmid"},{"id":"PMC4289418","type":"pmcid"},{"id":"84961288344","type":"scopus"}],"ids":["ku-4509fc8e-3df6-431a-bd99-40a46e25022d"],"keyword":["Breast Neoplasms","Female","Gene-Environment Interaction","Genetic Loci","Genetic Predisposition to Disease","Humans","Polymorphism, Single Nucleotide","Receptors, Estrogen","Risk Fact