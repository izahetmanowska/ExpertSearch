,"corresponding":null,"first":"Kathrin","key":"wolfpau","last":"Wolf","name":"Wolf, Kathrin","rank":48,"rolecode":"pau"},{"affno":"1 18 38","corresponding":null,"first":"Bert","key":"brunekreefpau","last":"Brunekreef","name":"Brunekreef, Bert","rank":49,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Gerard","key":"hoekpau","last":"Hoek","name":"Hoek, Gerard","rank":50,"rolecode":"pau"}],"pmid":["33844598"],"pub":{"doi":"10.1289/ehp8368","issn":["00916765","15529924"],"issn_org":["00916765"],"issue":"4","journal":"Environmental Health Perspectives","paperid":"047009","publisher":"Public Health Services, US Dept of Health and Human Services","status":"p","title":"Environmental Health Perspectives","volume":"129"},"review":"Peer Reviewed","scoID":["2-s2.0-85104337619"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Non-Profit Organisations","All Universities","DI-ALL","DI-NP","DI-NP-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Non-Profit Organisations","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-704f30ac-ccb8-467d-9d6e-7ab0d0dab3a3","ku-c138d7fb-4059-4904-afd2-e8412ccdc346"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Long-Term Exposure to Fine Particle Elemental Components and Natural and Cause-Specific Mortality—a Pooled Analysis of Eight European Cohorts within the ELAPSE Project","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-097.52-020895","year":"2021","yearsub":"2021"}
{"abstract":"Background: Studies on transportation noise and incident stroke are few and inconclusive. We aimed to investigate associations between road-Traffic and railway noise and the risk of incident stroke in the entire Danish population. Methods: We estimated road-Traffic and railway noise (Lden) at the most and least exposed façades for all residential addresses across Denmark (2.8 million) for the period 1990-2017. Based on this, we estimated the 10-year time-weighted mean noise exposure for 3.6 million Danes aged >35 years, of whom 184 523 developed incident stroke during follow-up from 2000 to 2017. Analyses were conducted using Cox proportional-hazards models, with adjustment for various individual-and area-level demographic and socio-economic covariates collected from registries and air pollution [fine particulate matter with particles with a diameter of ≤2.5 μm (PM2.5) and nitrogen dioxide (NO2)]. Results: A 10-dB increase in the 10-year mean road-Traffic noise at the most exposed façade was associated with an incidence rate ratio (IRR) of 1.04 [95% confidence interval (CI): 1.03-1.05] for all strokes. For road-Traffic noise at the least exposed façade, the IRR per 10 dB was 1.03 (95% CI: 1.02-1.04) for all strokes. Railway noise was not associated with a higher risk of stroke. Conclusion: Road-Traffic noise increased the risk of stroke. These findings add to the evidence of road-Traffic noise as a cardiovascular risk factor.","author_count":10,"contributors":["Sørensen, Mette","Poulsen, Aslak Harbo","Hvidtfeldt, Ulla A.","Münzel, Thomas","Thacher, Jesse Daniel","Ketzel, Matthias","Brandt, Jørgen","Christensen, Jesper Heile","Levin, Gregor","Raaschou-Nielsen, Ole"],"cuid":["S02-099.88-027316"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","Europe, Non-EU","OECD"],"country":["Germany","United Kingdom"],"glorg":["All Global Affiliations","Johannes Gutenberg University Mainz","University Medical Center Mainz","University of Surrey"],"keyword":["Epidemiology","Railway noise","Road traffic noise","Transportation noise","incident stroke"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-NP","DI-U"],"level3":{"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-ALL","DI-U-AU","DI-U-RUC"]},"level3all":["DI-NP-CAN","DI-U-AU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"transportation noise and risk of stroke a nationwide prospective cohort study covering denmark","src":["au","ruc"],"src-code":["DI-U-AU","DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85114791156","version":"Other Version"},"id":"S02-099.88-027316","identifier":[{"id":"85114791156","type":"scopus"},{"id":"33755127","type":"pmid"},{"id":"000705268900017","type":"wos"}],"ids":["au-ca05ee5c-5b89-4fe7-aa11-eb1a0319bf59","ruc-14dd21b7-5006-4a9e-ac52-59b63f988906"],"keyword":["Transportation noise","epidemiology","incident stroke","railway noise","road-Traffic noise"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-1702B8AB4D5741F6FC8732C946E727BC"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of Science and Environment"],"nora_code":"DI-U-RUC","used":1},{"affno":"2","country":"dk","key":"dcrc danish cancer society research center","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-CAN","l3nn":"DCRC Danish Cancer Society Research Center","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DCRC Danish Cancer Society Research Center","namevar":["Danish Cancer Society"],"nora_code":"DI-NP-CAN","used":1},{"affno":"3","country":"de","key":"johannes gutenberg university mainz","loc":["Germany","Europe, EU","OECD"],"name":"Johannes Gutenberg University Mainz","used":1},{"affno":"4","country":"de","key":"university medical center mainz","loc":["Germany","Europe, EU","OECD"],"name":"University Medical Center Mainz","used":1},{"affno":"5","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Environmental Science, Department of Environmental Science - Atmospheric Emissions & Modelling"],"nora_code":"DI-U-AU","used":1},{"affno":"6","country":"gb","key":"university of surrey","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Surrey","used":1}],"person":[{"affno":"1 2","country":"dk","first":"Mette","key":"sørensenpau","last":"Sørensen","locid":"5bf2a665-def4-499c-9c63-0c440da72e20","name":"Sørensen, Mette","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Aslak Harbo","key":"poulsenpau","last":"Poulsen","name":"Poulsen, Aslak Harbo","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ulla A.","key":"hvidtfeldtpau","last":"Hvidtfeldt","name":"Hvidtfeldt, Ulla A.","rank":3,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Thomas","key":"münzelpau","last":"Münzel","name":"Münzel, Thomas","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jesse Daniel","key":"thacherpau","last":"Thacher","name":"Thacher, Jesse Daniel","rank":5,"rolecode":"pau"},{"affno":"5 6","corresponding":null,"country":"dk","first":"Matthias","key":"ketzelpau","last":"Ketzel","locid":"798900d2-1d54-4c53-a4ca-671c12aa3015","name":"Ketzel, Matthias","orcid":"0000-0001-9519-1935","rank":6,"rolecode":"pau"},{"affno":"5","corresponding":null,"country":"dk","first":"Jørgen","key":"brandtpau","last":"Brandt","locid":"5f570c62-a5a5-4760-b7c7-8755b6e37ebf","name":"Brandt, Jørgen","orcid":"0000-0002-7580-9547","rank":7,"rolecode":"pau"},{"affno":"5","corresponding":null,"country":"dk","first":"Jesper Heile","key":"christensenpau","last":"Christensen","locid":"5d084fe1-5909-4b7f-ac1a-907f4a30089e","name":"Christensen, Jesper Heile","orcid":"0000-0002-6741-5839","rank":8,"rolecode":"pau"},{"affno":"5","corresponding":null,"country":"dk","first":"Gregor","key":"levinpau","last":"Levin","locid":"64497988-a46c-415b-bcfe-9b09efad5289","name":"Levin, Gregor","orcid":"0000-0002-5223-914X","rank":9,"rolecode":"pau"},{"affno":"2 5","corresponding":null,"country":"dk","first":"Ole","key":"raaschounielsenpau","last":"Raaschou-Nielsen","locid":"9ae8831f-2034-4c09-84bc-01cd649e3b55","name":"Raaschou-Nielsen, Ole","rank":10,"rolecode":"pau"}],"pmid":["33755127"],"pub":{"doi":"10.1093/ije/dyab024","issn":["03005771","14643685"],"issn_org":["03005771"],"issue":"4","journal":"International Journal of Epidemiology","pages":"1147-1156","publisher":"Oxford University Press","status":"p","title":"International Journal of Epidemiology","volume":"50"},"review":"Peer Reviewed","scoID":["2-s2.0-85114791156"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Non-Profit Organisations","All Universities","DI-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Non-Profit Organisations","Roskilde University","Universities"],"PST":["Published"]},"sid":["au-ca05ee5c-5b89-4fe7-aa11-eb1a0319bf59","ruc-14dd21b7-5006-4a9e-ac52-59b63f988906"],"src":["AU Aarhus University","RUC Roskilde University"],"title":"Transportation noise and risk of stroke: a nationwide prospective cohort study covering Denmark","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.88-027316","year":"2021","yearsub":"2021"}
{"abstract":"Purpose: Few studies have suggested that traffic noise is a risk factor for cancer, but evidence is inconclusive. We aimed to investigate whether road traffic and railway noise are associated with risk of colorectal cancer. Methods: We obtained address history for all 3.5 million people above 40 years of age and living in Denmark for the period 1990–2017 and estimated road traffic and railway noise (Lden) at the most and least exposed facades of all addresses as well as air pollution (PM2.5). During follow-up (2000–2017), 35,881 persons developed colon cancer and 19,755 developed rectal cancer. Information on individual and area-level demographic and socioeconomic variables was collected from Danish registries. We analyzed data using Cox proportional hazards models, including traffic noise as time-varying 10-year average exposure. Results: Exposure to road traffic noise at the most exposed façade was associated with an incidence rate ratio and 95% confidence interval for proximal colon cancer of 1.018 (0.999–1.038) per 10 dB higher noise. We observed no associations for road traffic noise at the least exposed façade or for railway noise in relation to proximal colon cancer. Also, we found no association between road traffic or railway noise and risk for distal colon cancer or rectal cancer. Conclusion: Traffic noise did not seem associated with higher risk for colorectal cancer, although the suggestion of a slightly higher risk of proximal colon cancer following exposure to road traffic noise warrants further research.","author_count":9,"contributors":["Sørensen, Mette","Poulsen, Aslak Harbo","Thacher, Jesse","Hvidtfeldt, Ulla Arthur","Ketzel, Matthias","Geels, Camilla","Jensen, Steen Solvang","Valencia, Victor H.","Raaschou-Nielsen, Ole"],"cuid":["S02-100.00-017611"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, Non-EU","OECD"],"corresponding_author":["Sørensen, Mette"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of Surrey"],"keyword":["Cohort study","Colorectal cancer","Epidemiology","Traffic noise"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-NP","DI-U"],"level3":{"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-ALL","DI-U-AU","DI-U-RUC"]},"level3all":["DI-NP-CAN","DI-U-AU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"transportation noise and risk for colorectal cancer a nationwide study covering denmark","src":["au","ruc"],"src-code":["DI-U-AU","DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85113959907","version":"Other Version"},"id":"S02-100.00-017611","identifier":[{"id":"34467460","type":"pmid"},{"id":"85113959907","type":"scopus"}],"ids":["au-4415eb6b-afe8-48ae-8278-29db2a2c6686","ruc-2620ebdd-4e4b-4fb8-8abf-1c83dd1d5385"],"keyword":["Cohort study","Colorectal cancer","Epidemiology","Traffic noise"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-34E3FB90A5AB77E4087883A98D0C3DB0"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of Science and Environment","Roskilde University, Department of Science and Environment, Molecular and Medical Biology"],"nora_code":"DI-U-RUC","used":1},{"affno":"2","country":"dk","key":"dcrc danish cancer society research center","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-CAN","l3nn":"DCRC Danish Cancer Society Research Center","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DCRC Danish Cancer Society Research Center","namevar":["Danish Cancer Society"],"nora_code":"DI-NP-CAN","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Environmental Science, Department of Environmental Science - Atmospheric Emissions & Modelling"],"nora_code":"DI-U-AU","used":1},{"affno":"4","country":"gb","key":"university of surrey","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Surrey","used":1}],"person":[{"affno":"1","country":"dk","first":"Mette","key":"sørensenpau","last":"Sørensen","locid":"5bf2a665-def4-499c-9c63-0c440da72e20","name":"Sørensen, Mette","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Aslak Harbo","key":"poulsenpau","last":"Poulsen","name":"Poulsen, Aslak Harbo","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jesse","key":"thacherpau","last":"Thacher","name":"Thacher, Jesse","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ulla Arthur","key":"hvidtfeldtpau","last":"Hvidtfeldt","name":"Hvidtfeldt, Ulla Arthur","rank":4,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"country":"dk","first":"Matthias","key":"ketzelpau","last":"Ketzel","locid":"798900d2-1d54-4c53-a4ca-671c12aa3015","name":"Ketzel, Matthias","orcid":"0000-0001-9519-1935","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Camilla","key":"geelspau","last":"Geels","locid":"fbcefbda-1f0a-4649-8234-28012f2714d6","name":"Geels, Camilla","orcid":"0000-0003-2549-1750","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Steen Solvang","key":"jensenpau","last":"Jensen","locid":"0d52f91a-4eaa-46f9-ab5f-d7fd3c31440d","name":"Jensen, Steen Solvang","orcid":"0000-0001-5923-8441","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Victor H.","key":"valenciapau","last":"Valencia","locid":"e073b447-a515-4272-887d-fe99110207e2","name":"Valencia, Victor H.","rank":8,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"country":"dk","first":"Ole","key":"raaschounielsenpau","last":"Raaschou-Nielsen","locid":"9ae8831f-2034-4c09-84bc-01cd649e3b55","name":"Raaschou-Nielsen, Ole","rank":9,"rolecode":"pau"}],"pmid":["34467460"],"pub":{"doi":"10.1007/s10552-021-01492-4","issn":["09575243","15737225"],"issn_org":["09575243"],"issue":"12","journal":"Cancer Causes & Control","pages":"1447-1455","publisher":"Springer Science and Business Media Deutschland GmbH","status":"p","title":"Cancer Causes & Control","volume":"32"},"review":"Peer Reviewed","scoID":["2-s2.0-85113959907"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Non-Profit Organisations","All Universities","DI-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Non-Profit Organisations","Roskilde University","Universities"],"PST":["Published"]},"sid":["au-4415eb6b-afe8-48ae-8278-29db2a2c6686","ruc-2620ebdd-4e4b-4fb8-8abf-1c83dd1d5385"],"src":["AU Aarhus University","RUC Roskilde University"],"title":"Transportation noise and risk for colorectal cancer : a nationwide study covering Denmark","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-017611","year":"2021","yearsub":"2021"}
{"abstract":"BACKGROUND: Air pollution has been suggested as a risk factor for chronic obstructive pulmonary disease (COPD), but evidence is sparse and inconsistent. OBJECTIVES: We examined the association between long-term exposure to low-level air pollution and COPD incidence. METHODS: Within the 'Effects of Low-Level Air Pollution: A Study in Europe' (ELAPSE) study, we pooled data from three cohorts, from Denmark and Sweden, with information on COPD hospital discharge diagnoses. Hybrid land use regression models were used to estimate annual mean concentrations of particulate matter with a diameter < 2.5 µm (PM2.5), nitrogen dioxide (NO2), and black carbon (BC) in 2010 at participants' baseline residential addresses, which were analysed in relation to COPD incidence using Cox proportional hazards models. RESULTS: Of 98,058 participants, 4,928 developed COPD during 16.6 years mean follow-up. The adjusted hazard ratios (HRs) and 95% confidence intervals for associations with COPD incidence were 1.17 (1.06, 1.29) per 5 µg/m3 for PM2.5, 1.11 (1.06, 1.16) per 10 µg/m3 for NO2, and 1.11 (1.06, 1.15) per 0.5 10-5m-1 for BC. Associations persisted in subset participants with PM2.5 or NO2 levels below current EU and US limit values and WHO guidelines, with no evidence for a threshold. HRs for NO2 and BC remained unchanged in two-pollutant models with PM2.5, whereas the HR for PM2.5 was attenuated to unity with NO2 or BC. CONCLUSIONS: Long-term exposure to low-level air pollution is associated with the development of COPD, even below current EU and US limit values and possibly WHO guidelines. Traffic-related pollutants NO2 and BC may be the most relevant.","author_count":43,"contributors":["Liu, Shuo","Jørgensen, Jeanette T","Ljungman, Petter","Pershagen, Göran","Bellander, Tom","Leander, Karin","Magnusson, Patrik K E","Rizzuto, Debora","Hvidtfeldt, Ulla A","Raaschou-Nielsen, Ole","Wolf, Kathrin","Hoffmann, Barbara","Brunekreef, Bert","Strak, Maciej","Chen, Jie","Mehta, Amar","Atkinson, Richard W","Bauwelinck, Mariska","Varraso, Raphaëlle","Boutron-Ruault, Marie-Christine","Brandt, Jørgen","Cesaroni, Giulia","Forastiere, Francesco","Fecht, Daniela","Gulliver, John","Hertel, Ole","de Hoogh, Kees","Janssen, Nicole A H","Katsouyanni, Klea","Ketzel, Matthias","Klompmaker, Jochem O","Nagel, Gabriele","Oftedal, Bente","Peters, Annette","Tjønneland, Anne","Rodopoulou, Sophia P","Samoli, Evangelia","Bekkevold, Terese","Sigsgaard, Torben","Stafoggia, Massimo","Vienneau, Danielle","Weinmayr, Gudrun","Hoek, Gerard","Andersen, Zorana J"],"cuid":["S02-100.00-019666"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Andersen, Zorana J"],"country":["Belgium","France","Germany","Greece","Italy","Netherlands","Norway","Sweden","Switzerland","United Kingdom"],"glorg":["All Global Affiliations","Center for Occupational and Environmental Medicine","Department of Epidemiology, Lazio Regional Health Service","Dept Epidemiol Lazio Reg","Heinrich Heine University Düsseldorf","Helmholtz Association of German Research Centres","Helmholtz Zentrum München - German Research Center for Environmental Health","Imperial College London","Institut Gustave Roussy","Karolinska Institutet","Ludwig Maximilian University","Ludwig Maximilian University of Munich","National Institute for Public Health and the Environment (RIVM)","National Institute of Public Health and the Environment","National and Kapodistrian University of Athens","Norwegian Institute of Public Health","Paris-Saclay University","Region Stockholm","St. George's University of London","Stockholm Gerontology Research Center","Stockholm University","Swiss Tropical and Public Health Institute","Ulm University","Universite Paris-Saclay","University of Athens","University of Leicester","University of Surrey","Utrecht University","Vrije Universiteit Brussel"],"keyword":["Air pollution","COPD incidence","Low level exposure"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-NP","DI-OT","DI-U"],"level3":{"NP":["DI-NP-ALL","DI-NP-CAN"],"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-NP-CAN","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"long term exposure to low level air pollution and incidence of chronic obstructive pulmonary disease the elapse project","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.envint.2020.106267","version":"Published Version"},"id":"S02-100.00-019666","identifier":[{"id":"33276316","type":"pmid"},{"id":"85097128896","type":"scopus"}],"ids":["au-606c20fb-6f1d-4399-a0a8-23a6a056131c","ku-0b9ada21-f9a8-4570-813f-29c6cc605260"],"keyword":["COPD incidence","air pollution","low-level exposure"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-D96E38AD6F32282BF1C1C821AFE981D5"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.envint.2020.106267","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/255445838/Long_term_exposure_to_low_level_air_pollution_and_incidence_of_chronic_obstructive_pulmonary_disease.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Pub