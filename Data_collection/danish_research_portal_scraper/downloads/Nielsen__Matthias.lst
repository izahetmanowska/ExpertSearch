,"last":"Clasen","name":"Clasen, Matthias","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9788771855532"],"pages":"272-279","place":"Aarhus","publisher":"Aarhus Universitetsforlag","status":"p","subtitle":"et biokulturelt perspektiv","title":"Menneske, kultur, evolution"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-dcdbd907-5446-457c-9624-60cf5a2b11a8"],"src":["KU University of Copenhagen"],"title":"Menneskets biokulturelle historie","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-525374","year":"2019","yearsub":"2020"}
{"abstract":"We develop a bifurcation theory describing the conditions under which vortices are created or destroyed in a two-dimensional incompressible flow. We define vortices using the -criterion and analyse the vortex structure by considering the evolution of the zero contours of. The theory identifies topological changes of the vortex structure and classifies these as four possible types of bifurcations, two occurring away from boundaries, and two occurring near no-slip walls. Our theory provides a description of all possible codimension-one bifurcations where time is treated as the bifurcation parameter. To illustrate our results, we consider the early stages of boundary layer eruption at moderate Reynolds numbers in the range from to. By analysing numerical simulations of the phenomenon, we show how to describe the eruption process as sequences of the four possible bifurcations of codimension one. Our simulations show that there is a single codimension-two point within our parameter range. This codimension-two point arises at via the coalescence of two codimension-one bifurcations which are associated with the creation and subsequent destruction of one of the vortices that erupt from the boundary layer. We present a theoretical description of this process and explain how the occurrence of this phenomenon separates the parameter space into two regions with distinct evolution of the topology of the vortices.","author_count":4,"contributors":["Nielsen, Anne R.","Heil, Matthias","Andersen, Morten","Brøns, Morten"],"cuid":["S02-094.70-034885"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"continent":["Europe, Non-EU","OECD"],"corresponding_author":["Brøns, Morten"],"country":["United Kingdom"],"glorg":["All Global Affiliations","The University of Manchester","University of Manchester"],"keyword":["Boundary layer structure","Topological fluid dynamics","Vortex dynamics"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-RUC"]},"level3all":["DI-U-DTU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"bifurcation theory for vortices with application to boundary layer eruption","src":["dtu","ruc"],"src-code":["DI-U-DTU","DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/218593116/2nd_submission_002_.pdf","version":"Authors Final Version"},"id":"S02-094.70-034885","identifier":[{"id":"85062277787","type":"scopus"}],"ids":["dtu-6468f52e-25e1-448d-821c-d64e4c30f860","ruc-ff79e52c-4421-4042-ac7d-d21384d0d295"],"keyword":["Boundary layer structure","Topological fluid dynamics","Vortex dynamics"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-90757E6E83AA634F72381D6E7503CE23"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/218593116/2nd_submission_002_.pdf","version":"Authors Final Version"},{"access":"oa","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/64098476/2nd_submission_002_.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Applied Mathematics and Computer Science","Technical University of Denmark, Department of Applied Mathematics and Computer Science, Mathematics"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"gb","key":"university of manchester","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Manchester","used":1},{"affno":"3","country":"gb","key":"the university of manchester","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"The University of Manchester","used":1},{"affno":"4","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of Science and Environment"],"nora_code":"DI-U-RUC","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Anne R.","key":"nielsenpau","last":"Nielsen","locid":"08f659f4-035d-4e85-950a-0d4feb85ab96","name":"Nielsen, Anne R.","orcid":"0000-0001-7144-8978","rank":1,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Matthias","key":"heilpau","last":"Heil","name":"Heil, Matthias","rank":2,"rolecode":"pau"},{"affno":"4","country":"dk","first":"Morten","key":"wieneckeandersenpau","last":"Wienecke Andersen","locid":"c3e27de5-fa0e-4dde-9dd5-249374492239","name":"Andersen, Morten","name_org":"Wienecke Andersen, Morten","orcid":"0000-0001-7582-0685","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Morten","key":"bronspau","last":"Brons","locid":"b364a278-ce14-4e88-be21-7d0cd7ea6a7a","name":"Brøns, Morten","name_org":"Brons, Morten","orcid":"0000-0001-5522-3410","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1017/jfm.2019.97","issn":["00221120","14697645"],"issn_org":["00221120"],"journal":"Journal of Fluid Mechanics","pages":"831-849","publisher":"Cambridge University Press","status":"p","title":"Journal of Fluid Mechanics","volume":"865"},"review":"Peer Reviewed","scoID":["2-s2.0-85062277787"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Roskilde University","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-6468f52e-25e1-448d-821c-d64e4c30f860","ruc-ff79e52c-4421-4042-ac7d-d21384d0d295"],"src":["DTU Technical University of Denmark","RUC Roskilde University"],"title":"Bifurcation theory for vortices with application to boundary layer eruption","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-094.70-034885","year":"2019","yearsub":"2019"}
{"abstract":"BACKGROUND: Noise from wind turbines (WTs) is reported as more annoying than traffic noise at similar levels, raising concerns as to whether WT noise (WTN) increases risk for cardiovascular disease, as observed for traffic noise. OBJECTIVES: We aimed to investigate whether long-term exposure to WTN increases risk of myocardial infarction (MI) and stroke. METHODS: We identified all Danish dwellings within a radius 20 times the height of the closest WT and 25% of the dwellings within [Formula: see text] the height of the closest WT. Using data on WT type and simulated hourly wind at each WT, we estimated hourly outdoor and low frequency (LF) indoor WTN for each dwelling and derived 1-y and 5-y running nighttime averages. We used hospital and mortality registries to identify all incident cases of MI ([Formula: see text]) and stroke ([Formula: see text]) among all adults age 25-85 y ([Formula: see text]), who lived in one of these dwellings for [Formula: see text] over the period 1982-2013. We used Poisson regression to estimate incidence rate ratios (IRRs) adjusted for individual- and area-level covariates. RESULTS: IRRs for MI in association with 5-y nighttime outdoor WTN [Formula: see text] (vs. [Formula: see text]) dB(A) and indoor LF WTN [Formula: see text] (vs. [Formula: see text]) dB(A) were 1.21 [95% confidence interval (CI): 0.91, 1.62; 47 exposed cases] and 1.29 (95% CI: 0.73, 2.28; 12 exposed cases), respectively. IRRs for intermediate categories of outdoor WTN [24-30, 30-36, and [Formula: see text] vs. [Formula: see text]] were slightly above the null and of similar size: 1.08 (95% CI: 1.04, 1.12), 1.07 (95% CI: 1.00, 1.12), and 1.06 (95% CI: 0.93, 1.22), respectively. For stroke, IRRs for the second and third outdoor exposure groups were similar to those for MI, but near or below the null for higher exposures. CONCLUSIONS: We did not find convincing evidence of associations between WTN and MI or stroke. https://doi.org/10.1289/EHP3340.","author_count":8,"contributors":["Poulsen, Aslak Harbo","Raaschou-Nielsen, Ole","Peña, Alfredo","Hahmann, Andrea N.","Nordsborg, Rikke Baastrup","Ketzel, Matthias","Brandt, Jørgen","Sørensen, Mette"],"cuid":["S02-098.71-019918"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of Surrey"],"keyword":["Adult","Aged","Aged 80 and over","Denmark epidemiology","Energy Generating Resources","Environmental Exposure adverse effects","Female","Humans","Incidence","Male","Middle Aged","Myocardial Infarction epidemiology","Noise adverse effects","Prospective Studies","Risk","Stroke epidemiology"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-NP","DI-OT","DI-U"],"level3":{"NP":["DI-NP-ALL","DI-NP-CAN"],"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-DTU","DI-U-RUC"]},"level3all":["DI-NP-CAN","DI-U-AU","DI-U-DTU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"long term exposure to wind turbine noise and risk for myocardial infarction and stroke a nationwide cohort study","src":["au","ruc"],"src-code":["DI-U-AU","DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1289/EHP3340","version":"Published Version"},"id":"S02-098.71-019918","identifier":[{"id":"30864814","type":"pmid"},{"id":"PMC6768320","type":"pmcid"},{"id":"000462983500002","type":"wos"},{"id":"85062867482","type":"scopus"}],"ids":["au-63cfabe0-85c5-47f2-b598-4f387401b0e2","ruc-21da289a-e26d-422d-83f5-d36efcdf674d"],"keyword":["Adult","Aged","Aged, 80 and over","Denmark/epidemiology","Energy-Generating Resources","Environmental Exposure/adverse effects","Female","Humans","Incidence","Male","Middle Aged","Myocardial Infarction/epidemiology","Noise/adverse effects","Prospective Studies","Risk","Stroke/epidemiology"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-6-021234EA6F51312EF64F7067784500AC"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1289/EHP3340","version":"Published Version"},{"access":"oa","license":"Andet","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/67676768/EHP3340.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","country":"dk","key":"dcrc danish cancer society research center","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-CAN","l3nn":"DCRC Danish Cancer Society Research Center","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DCRC Danish Cancer Society Research Center","namevar":["Danish Cancer Society"],"nora_code":"DI-NP-CAN","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Environmental Science, Department of Environmental Science - Environmental social science and geography"],"nora_code":"DI-U-AU","used":1},{"affno":"3","country":"dk","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark (DTU)"],"nora_code":"DI-U-DTU","used":1},{"affno":"4","country":"gb","key":"university of surrey","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Surrey","used":1},{"affno":"5","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of Science and Environment","Roskilde University, Department of Science and Environment, Molecular and Medical Biology"],"nora_code":"DI-U-RUC","used":1},{"affno":"6","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Aslak Harbo","key":"poulsenpau","last":"Poulsen","name":"Poulsen, Aslak Harbo","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Ole","key":"raaschounielsenpau","last":"Raaschou-Nielsen","locid":"9ae8831f-2034-4c09-84bc-01cd649e3b55","name":"Raaschou-Nielsen, Ole","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Alfredo","key":"peñapau","last":"Peña","name":"Peña, Alfredo","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Andrea N.","key":"hahmannpau","last":"Hahmann","name":"Hahmann, Andrea N.","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rikke Baastrup","key":"nordsborgpau","last":"Nordsborg","name":"Nordsborg, Rikke Baastrup","rank":5,"rolecode":"pau"},{"affno":"2 4","corresponding":null,"country":"dk","first":"Matthias","key":"ketzelpau","last":"Ketzel","locid":"798900d2-1d54-4c53-a4ca-671c12aa3015","name":"Ketzel, Matthias","orcid":"0000-0001-9519-1935","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jørgen","key":"brandtpau","last":"Brandt","locid":"5f570c62-a5a5-4760-b7c7-8755b6e37ebf","name":"Brandt, Jørgen","orcid":"0000-0002-7580-9547","rank":7,"rolecode":"pau"},{"affno":"5 1 6","country":"dk","first":"Mette","key":"sørensenpau","last":"Sørensen","locid":"5bf2a665-def4-499c-9c63-0c440da72e20","name":"Sørensen, Mette","rank":8,"rolecode":"pau"}],"pmid":["30864814"],"pub":{"doi":"10.1289/ehp3340","issn":["00916765","15529924"],"issn_org":["00916765"],"issue":"3","journal":"Environmental Health Perspectives","paperid":"037004","publisher":"Public Health Services, US Dept of Health and Human Services","status":"p","title":"Environmental Health Perspectives","volume":"127"},"review":"Peer Reviewed","scoID":["2-s2.0-85062867482"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Non-Profit Organisations","All Universities","DI-ALL","DI-NP","DI-NP-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Non-Profit Organisations","Other Research","Roskilde University","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["au-63cfabe0-85c5-47f2-b598-4f387401b0e2","ruc-21da289a-e26d-422d-83f5-d36efcdf674d"],"src":["AU Aarhus University","RUC Roskilde University"],"title":"Long-Term Exposure to Wind Turbine Noise and Risk for Myocardial Infarction and Stroke : A Nationwide Cohort Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-098.71-019918","year":"2019","yearsub":"2019"}
{"abstract":"Breast cancer is a common disease partially caused by genetic risk factors. Germline pathogenic variants in DNA repair genes BRCA1, BRCA2, PALB2, ATM, and CHEK2 are associated with breast cancer risk. FANCM, which encodes for a DNA translocase, has been proposed as a breast cancer predisposition gene, with greater effects for the ER-negative and triple-negative breast cancer (TNBC) subtypes. We tested the three recurrent protein-truncating variants FANCM:p.Arg658*, p.Gln1701*, and p.Arg1931* for association with breast cancer risk in 67,112 cases, 53,766 controls, and 26,662 carriers of pathogenic variants of BRCA1 or BRCA2. These three variants were also studied functionally by measuring survival and chromosome fragility in FANCM−/− patient-derived immortalized fibroblasts treated with diepoxybutane or olaparib. We observed that FANCM:p.Arg658* was associated with increased risk of ER-negative disease and TNBC (OR = 2.44, P = 0.034 and OR = 3.79; P = 0.009, respectively). In a country-restricted analysis, we confirmed the associations detected for FANCM:p.Arg658* and found that also FANCM:p.Arg1931* was associated with ER-negative breast cancer risk (OR = 1.96; P = 0.006). The functional results indicated that all three variants were deleterious affecting cell survival and chromosome stability with FANCM:p.Arg658* causing more severe phenotypes. In conclusion, we confirmed that the two rare FANCM deleterious variants p.Arg658* and p.Arg1931* are risk factors for ER-negative and TNBC subtypes. Overall our data suggest that the effect of truncating variants on breast cancer risk may depend on their position in the gene. Cell sensitivity to olaparib exposure, identifies a possible therapeutic option to treat FANCM-associated tumors.","author_count":53,"contributors":["Figlioli, Gisella","Bogliolo, Massimo","Catucci, Irene","Caleca, Laura","Lasheras, Sandra Viz","Pujol, Roser","Kiiski, Johanna I","Muranen, Taru A","Barnes, Daniel R","Dennis, Joe","Michailidou, Kyriaki","Bolla, Manjeet K","Leslie, Goska","Aalfs, Cora M","Adank, Muriel A","Adlard, Julian","Agata, Simona","Cadoo, Karen","Agnarsson, Bjarni A","Ahearn, Thomas","Aittomäki, Kristiina","Ambrosone, Christine B","Andrews, Lesley","Anton-Culver, Hoda","Antonenkova, Natalia N","Arndt, Volker","Arnold, Norbert","Aronson, Kristan J","Arun, Banu K","Asseryanis, Ella","Auber, Bernd","Auvinen, Päivi","Azzollini, Jacopo","Balmaña, Judith","Barkardottir, Rosa B","Barrowdale, Daniel","Barwell, Julian","Beane Freeman, Laura E","Beauparlant, Charles Joly","Beckmann, Matthias W","Behrens, Sabine","Benitez, Javier","Berger, Raanan","Bermisheva, Marina","Blanco, Amie M","Blomqvist, Carl","Bogdanova, Natalia V","Bojesen, Anders","Bojesen, Stig E","Flyger, Henrik","Nielsen, Finn Cilius","Rossing, Maria","Thomassen, Mads"],"cuid":["S03-093.78-016361"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"51-200 contributors","class":"merged","cluster_size":3,"continent":["America, North","Asia, Middle East","Europe, EU","Europe, Non-EU","Nordic","OECD"],"corpau":["ABCTB Investigators","GEMO Study Collaborators","KConFab"],"country":["Austria","Belarus","Canada","Cyprus","Finland","Germany","Iceland","Israel","Italy","Netherlands","Russia","Spain","Sweden","United Kingdom","United States"],"glorg":["18Roswell Park Cancer Institute, Buffalo, NY USA.","All Global Affiliations","Amsterdam UMC","Antoni van Leeuwenhoek Hospital","Autonomous University of Barcelona","Casa Sollievo della Sofferenza","Center for Biomedical Network Research on Rare Diseases (CIBERER)","Chapel Allerton Hospital","Christian-Albrechts-University of Kiel","Cyprus Institute of Neurology and Genetics","FIRC Institute of Molecular Oncology","Fondazione IRCCS Istituto Nazionale dei Tumori","German Cancer Research Center","German Cancer Research Center (DKFZ)","Hannover Medical School","Helsinki University Hospital","Hospital of Santa Creu i Sant Pau","IRCCS Istituto Oncologico Veneto - Padova","I