","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85181010660","version":"Other Version"},"id":"S02-100.00-741961","identifier":[{"id":"38109117","type":"pmid"},{"id":"PMC10728804","type":"pmcid"},{"id":"85181010660","type":"scopus"}],"ids":["au-9edbc162-ad52-4150-8262-93a5c8d8f2c2","sdu-37590af7-2ee8-43c8-a64e-db7db1bd211d"],"keyword":["Adult","Aged","Cardiopulmonary Resuscitation","Humans","Hypothermia","Hypothermia, Induced/methods","Male","Out-of-Hospital Cardiac Arrest/therapy","Prognosis","Unconsciousness"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-D51FF08E9EBE18E4AF85BAE446B32C15"],"org":[{"affno":"1","country":"be","key":"université libre de bruxelles","loc":["Belgium","Europe, EU","OECD"],"name":"Université Libre de Bruxelles","used":1},{"affno":"2","country":"fr","key":"after rosc network","loc":["France","Europe, EU","OECD"],"name":"After ROSC Network","used":1},{"affno":"3","country":"se","key":"lund university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Lund University","used":1},{"affno":"4","country":"fr","key":"universite paris 5","loc":["France","Europe, EU","OECD"],"name":"Universite Paris 5","used":1},{"affno":"5","country":"fr","key":"paris cite university","loc":["France","Europe, EU","OECD"],"name":"Paris Cite University","used":1},{"affno":"6","country":"fr","key":"universite d angers","loc":["France","Europe, EU","OECD"],"name":"Universite d'Angers","used":1},{"affno":"7","country":"fr","key":"angers university hospital","loc":["France","Europe, EU","OECD"],"name":"Angers University Hospital","used":1},{"affno":"8","country":"cz","key":"charles university","loc":["Czechia","Europe, EU","OECD"],"name":"Charles University","used":1},{"affno":"9","country":"cz","key":"general teaching hospital","loc":["Czechia","Europe, EU","OECD"],"name":"General Teaching Hospital","used":1},