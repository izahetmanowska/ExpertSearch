":"pau"},{"affno":"2","corresponding":null,"first":"Allan Malta","key":"ryhammerpau","last":"Ryhammer","name":"Ryhammer, Allan Malta","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Anders","key":"holmnielsenpau","last":"Holm-Nielsen","name":"Holm-Nielsen, Anders","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Steen","key":"walterpau","last":"Walter","locid":"2338c183-0390-4e0f-9eae-d8aa1cb546e7","name":"Walter, Steen","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kim Hovgaard","key":"andreassenpau","last":"Andreassen","locid":"5b87bcb0-30f3-4587-b8d5-a489e3ecb123","name":"Andreassen, Kim Hovgaard","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Palle Jørn Sloth","key":"ostherpau","last":"Osther","locid":"d8ac081c-aa5c-4d65-8333-6b6b7aeb4c28","name":"Osther, Palle Jørn Sloth","orcid":"0000-0001-7962-1640","rank":6,"rolecode":"pau"}],"pub":{"issn":["21524920","21524939"],"issn_org":["21524920"],"issue":"A91-92","journal":"Journal of Endourology","publisher":"Mary Ann Liebert","status":"p","title":"Journal of Endourology","volume":"25/Suppl 1"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-b78b5e0c-02ad-48bb-a1ca-29dca03b8fdd"],"src":["SDU University of Southern Denmark"],"title":"USE OF THE THERMO-EXPANDABLE URETERAL METAL STENT (MEMOKATHTM051) FOR THE TREATMENT OF CHRONIC URETERAL STRICTURES DUE TO RETROPERITONEAL/PERIAORTAL FIBROSIS","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-625852","year":"2011","yearsub":"2011"}
{"abstract":"ABSTRACT: BACKGROUND: Vehicle engine exhaust includes ultrafine particles with a large surface area and containing absorbed polycyclic aromatic hydrocarbons, transition metals and other substances. Ultrafine particles and soluble chemicals can be transported from the airways to other organs, such as the liver, kidneys, and brain. Our aim was to investigate whether air pollution from traffic is associated with risk for other cancers than lung cancer. METHODS: We followed up 54,304 participants in the Danish Diet Cancer and Health cohort for 20 selected cancers in the Danish Cancer Registry, from enrolment in 1993-1997 until 2006, and traced their residential addresses from 1971 onwards in the Central Population Registry. We used modeled concentration of nitrogen oxides (NOx) and amount of traffic at the residence as indicators of traffic-related air pollution and used Cox models to estimate incidence rate ratios (IRRs) after adjustment for potential confounders. RESULTS: NOx at the residence was significantly associated with risks for cervical cancer (IRR, 2.45; 95% confidence interval [CI], 1.01;5.93, per 100 ug/m3 NOx) and brain cancer (IRR, 2.28; 95% CI, 1.25;4.19, per 100 ug/m3 NOx). CONCLUSIONS: This hypothesis-generating study indicates that traffic-related air pollution might increase the risks for cervical and brain cancer, which should be tested in future studies.","author_count":12,"contributors":["Raaschou-Nielsen, Ole","Andersen, Zorana Jovanovic","Hvidberg, Martin","Jensen, Steen Solvang","Ketzel, Matthias","Sorensen, Mette","Hansen, Johnni","Loft, Steffen","Overvad, Kim","Tjonneland, Anne"],"cuid":["S02-084.40-024602"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"keyword":["Air Pollutants","Cohort Studies","Denmark","Environmental Exposure","Female","Humans","Incidence","Male","Middle Aged","Neoplasms","Nitrogen oxides","Residence Characteristics","Vehicle Emissions"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"air pollution from traffic and cancer incidence a danish cohort study","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1186/1476-069X-10-67","version":"Other Version"},"id":"S02-084.40-024602","identifier":[{"id":"PMC3157417","type":"pmcid"},{"id":"79960562929","type":"scopus"},{"id":"21771295","type":"pmid"}],"ids":["au-a2fcc414-c340-4563-9d95-30cfe14807ba","ku-8a59f28f-30b2-4dd2-b389-e9fb6d5b0e8b"],"keyword":["Air Pollutants","Cohort Studies","Denmark","Environmental Exposure","Female","Humans","Incidence","Male","Middle Aged","Neoplasms","Nitrogen Oxides","Residence Characteristics","Vehicle Emissions"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-9C29C5CAFF8C68B5C514381DC46BF1AF"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.ehjournal.net/content/10/1/67","version":"Other Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1186/1476-069X-10-67","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus University, National Environmental Research Institute, Department of Atmospheric Environment"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Section of Environmental Health"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Ole","key":"raaschounielsenpau","last":"Raaschou-Nielsen","name":"Raaschou-Nielsen, Ole","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Zorana Jovanovic","key":"andersenpau","last":"Andersen","name":"Andersen, Zorana Jovanovic","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Martin","key":"hvidbergpau","last":"Hvidberg","locid":"caad0d45-bf3a-4a5f-ae85-b78a367b5186","name":"Hvidberg, Martin","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Steen Solvang","key":"jensenpau","last":"Jensen","locid":"0d52f91a-4eaa-46f9-ab5f-d7fd3c31440d","name":"Jensen, Steen Solvang","orcid":"0000-0001-5923-8441","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Matthias","key":"ketzelpau","last":"Ketzel","locid":"798900d2-1d54-4c53-a4ca-671c12aa3015","name":"Ketzel, Matthias","orcid":"0000-0001-9519-1935","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Mette","key":"sorensenpau","last":"Sorensen","name":"Sorensen, Mette","rank":6,"rolecode":"pau"},{"affno":"","first":"Mette","key":"sørensenpau","last":"Sørensen","name":"Sørensen, Mette","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Johnni","key":"hansenpau","last":"Hansen","name":"Hansen, Johnni","rank":7,"rolecode":"pau"},{"affno":"2","first":"Steffen","key":"loftpau","last":"Loft","locid":"cc94a7fc-b397-47b4-94a5-bde078bb4fb6","name":"Loft, Steffen","orcid":"0000-0001-9552-8518","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kim","key":"overvadpau","last":"Overvad","locid":"83738c57-45d4-41e0-b807-ad0f6dec597c","name":"Overvad, Kim","orcid":"0000-0001-6429-7921","rank