000-0002-0482-1397","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Line","key":"hagnernielsenpau","last":"Hagner Nielsen","locid":"a9a7a51b-9e8f-40cc-b691-6e64d62e7765","name":"Nielsen, Line Hagner","name_org":"Hagner Nielsen, Line","orcid":"0000-0002-3789-4816","rank":7,"rolecode":"pau"}],"pmid":["38190949"],"pub":{"doi":"10.1016/j.ijpharm.2024.123798","issn":["03785173","18733476"],"issn_org":["03785173"],"journal":"International Journal of Pharmaceutics","paperid":"123798","publisher":"Elsevier","status":"p","title":"International Journal of Pharmaceutics","volume":"652"},"review":"Peer Reviewed","scoID":["2-s2.0-85184752254"],"search":{"DAF":["All Danish Affiliations","All GTS Institutes","All Governmental Institutions","All Universities","DI-ALL","DI-GTS","DI-GTS-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","GTS Institutes","Governmental Institutions","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-08ac19fd-439c-46e3-a917-79ba42034261","ku-eb8b44ab-90d0-49ce-b01b-ef6221a53642"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"The interplay between trehalose and dextran as spray drying precursors for cationic liposomes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-724988","year":"2024","yearsub":"2024"}
{"abstract":"Despite the known link between air pollution and cause-specific mortality, its relation to chronic kidney disease (CKD)-associated mortality is understudied. Therefore, we investigated the association between long-term exposure to air pollution and CKD-related mortality in a large multicentre population-based European cohort. Cohort data were linked to local mortality registry data. CKD-death was defined as ICD10 codes N18–N19 or corresponding ICD9 codes. Mean annual exposure at participant's home address was determined with fine spatial resolution exposure models for nitrogen dioxide (NO2), black carbon (BC), ozone (O3), particulate matter ≤2.5 μm (PM2.5) and several elemental constituents of PM2.5. Cox regression models were adjusted for age, sex, cohort, calendar year of recruitment, smoking status, marital status, employment status and neighbourhood mean income. Over a mean follow-up time of 20.4 years, 313 of 289,564 persons died from CKD. Associations were positive for PM2.5 (hazard ratio (HR) with 95% confidence interval (CI) of 1.31 (1.03–1.66) per 5 μg/m3, BC (1.26 (1.03–1.53) per 0.5 × 10− 5/m), NO2 (1.13 (0.93–1.38) per 10 μg/m3) and inverse for O3 (0.71 (0.54–0.93) per 10 μg/m3). Results were robust to further covariate adjustment. Exclusion of the largest sub-cohort contributing 226 cases, led to null associations. Among the elemental constituents, Cu, Fe, K, Ni, S and Zn, representing different sources including traffic, biomass and oil burning and secondary pollutants, were associated with CKD-related mortality. In conclusion, our results suggest an association between air pollution from different sources and CKD-related mortality.","author_count":36,"contributors":["Kadelbach, Pauline","Weinmayr, Gudrun","Chen, Jie","Jaensch, Andrea","Rodopoulou, Sophia","Strak, Maciej","de Hoogh, Kees","Andersen, Zorana J.","Bellander, Tom","Brandt, Jørgen","Cesaroni, Giulia","Fecht, Daniela","Forastiere, Francesco","Gulliver, John","Hertel, Ole","Hoffmann, Barbara","Hvidtfeldt, Ulla Arthur","Katsouyanni, Klea","Ketzel, Matthias","Leander, Karin","Ljungman, Petter","Magnusson, Patrik K.E.","Pershagen, Göran","Rizzuto, Debora","Samoli, Evangelia","Severi, Gianluca","Stafoggia, Massimo","Tjønneland, Anne","Vermeulen, Roel","Peters, Annette","Wolf, Kathrin","Raaschou-Nielsen, Ole","Brunekreef, Bert","Hoek, Gerard","Zitt, Emanuel","Nagel, Gabriele"],"cuid":["S02-100.00-741936"],"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Weinmayr, Gudrun"],"country":["Austria","France","Germany","Greece","Italy","Netherlands","Sweden","Switzerland","United Kingdom"],"glorg":["Agency for Preventive and Social Medicine","All Global Affiliations","Department of Epidemiology, Lazio Regional Health Service","Dept Epidemiol Lazio Reg","Heinrich Heine University Düsseldorf","Helmholtz Zentrum Munich","Helmholtz Zentrum München - German Research Center for Environmental Health","Imperial College London","Karolinska Institutet","LKH Feldkirch","MRC Centre for Environment and Health","National Institute for Public Health and the Environment (RIVM)","National Institute of Public Health and the Environment","National and Kapodistrian University of Athens","Paris-Saclay University","Royal Brompton and Harefield NHS Foundation Trust","Stockholm Gerontology Research Center","Swiss Tropical and Public Health Institute","Ulm University","Universite Paris-Saclay","University of Athens","University of Basel","University of Leicester","University of Surrey","Utrecht University","Vorarlberg Institute for Vascular Investigation and Treatment","Vorarlberg Institute for Vascular Investigation and Treatment (VIVIT)"],"keyword":["Adult","Aged","Air Pollutants analysis","Air Pollution adverse effects","Air pollution","Chronic kidney disease","Cohort Studies","Environmental Exposure adverse effects","Europe epidemiology","Female","Humans","Long term exposure","Male","Middle Aged","Mortality","PM","Particulate Matter analysis","Particulate matter constituents"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-NP","DI-U"],"level3":{"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-NP-CAN","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"long term exposure to air pollution and chronic kidney disease associated mortality results from the pooled cohort of the european multicentre elapse study","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.envres.2024.118942","version":"Published Version"},"id":"S02-100.00-741936","identifier":[{"id":"85192278468","type":"scopus"},{"id":"38649012","type":"pmid"}],"ids":["au-8e3aa9d8-173b-47de-ada1-fe1428b49844","ku-4b27eeda-35ee-4944-9bfc-27f586b7d898"],"keyword":["Adult","Aged","Air Pollutants/analysis","Air Pollution/adverse effects","Air pollution","Chronic kidney disease","Cohort Studies","Environmental Exposure/adverse effects","Europe/epidemiology","Female","Humans","Long-term exposure","Male","Middle Aged","Mortality","PM","Particulate Matter/analysis","Particulate matter constituents","Renal Insufficiency, Chronic/mortality"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-2989B6C9E8E1749ED3341C77F82CCBE0"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.envres.2024.118942","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/395990585/1_s2.0_S0013935124008466_main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.au.dk/ws/files/431225345/1-s2.0-S0013935124008466-main.pdf","ve