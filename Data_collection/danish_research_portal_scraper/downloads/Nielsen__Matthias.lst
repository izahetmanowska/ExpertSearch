{"abstract":"We present terahertz near-field mode profiling of different polymer THz fibers. Images with a resolution below the THz wavelength show the fundamental mode profile and higher order modes appearing at higher frequencies.","author_count":9,"contributors":["Stecher, Matthias","Dürrschmidt, Stefan F.","Nielsen, Kristian","Stefani, Alessio","Rasmussen, Henrik K.","Jepsen, Peter Uhd","Bang, Ole","Town, Graham E.","Koch, Martin"],"cuid":["S01-000.00-351412"],"event":{"end":"2011-10-07","place":"Huston, TX, us","start":"2011-10-02","title":"36th International Conference on Infrared, Millimeter and THz waves","year":"2011"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD","Oceania"],"country":["Australia","Germany"],"glorg":["All Global Affiliations","Macquarie University","University of Marburg"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"mode profiling of thz fibers with dynamic aperture near field imaging","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/6341897/5F650d01.pdf","version":"Published Version"},"id":"S01-000.00-351412","identifier":[{"id":"84855901571","type":"scopus"}],"ids":["dtu-9d1e7e5c-642c-4535-9931-3873d6d6b08a"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-650057394EF35291AC68BA724D3CDCD0"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/6341897/5F650d01.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1109/irmmw-THz.2011.6105088","version":"Other Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/6341896/IRMMW2011_Stecher_