rcid":"0000-0001-9519-1935","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jørgen","key":"brandtpau","last":"Brandt","locid":"5f570c62-a5a5-4760-b7c7-8755b6e37ebf","name":"Brandt, Jørgen","orcid":"0000-0002-7580-9547","rank":7,"rolecode":"pau"},{"affno":"5","country":"dk","first":"Mette","key":"sørensenpau","last":"Sørensen","locid":"5bf2a665-def4-499c-9c63-0c440da72e20","name":"Sørensen, Mette","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mette","key":"sorensenpau","last":"Sorensen","name":"Sorensen, Mette","rank":8,"rolecode":"pau"}],"pmid":["30864815"],"pub":{"doi":"10.1289/ehp3909","issn":["00916765","15529924"],"issn_org":["00916765"],"issue":"3","journal":"Environmental Health Perspectives","paperid":"037005","publisher":"Public Health Services, US Dept of Health and Human Services","status":"p","title":"Environmental Health Perspectives","volume":"127"},"review":"Peer Reviewed","scoID":["2-s2.0-85062886360"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Non-Profit Organisations","All Universities","DI-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Non-Profit Organisations","Roskilde University","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["au-3c008ecb-e0c9-4b69-a976-54e692fc85e7","dtu-1030ecc3-0372-4213-bfac-265b82933f3d","ruc-5f6e344f-c203-4f3f-824a-22c7be4bdd03"],"src":["AU Aarhus University","DTU Technical University of Denmark","RUC Roskilde University"],"title":"Impact of Long-Term Exposure to Wind Turbine Noise on Redemption of Sleep Medication and Antidepressants : A Nationwide Cohort Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-089.68-017053","year":"2019","yearsub":"2019"}
{"abstract":"Studies on health effects of long-term exposure to specific PM2.5 constituents are few. Previous studies have reported an association between black carbon (BC) exposure and cardiovascular diseases (CVD) and a few studies have found an association between sulfate exposure and mortality. These studies, however, relied mainly on exposure data from centrally located air-monitoring stations, which is a crude approximation of personal exposure. We focused on specific chemical constituents of PM2.5, i.e. elemental and primary organic carbonaceous particles (BC/OC), sea salt, secondary inorganic aerosols (SIA, i.e. NO3 –, NH4 +, and SO4 2-), and secondary organic aerosols (SOA), in relation to all-cause, CVD and respiratory disease mortality. We followed a Danish cohort of 49,564 individuals from enrollment in 1993–1997 through 2015. We combined residential address history from 1979 onwards with mean annual air pollution concentrations obtained by the AirGIS air pollution modelling system, lifestyle information from baseline questionnaires and socio-demography obtained by register linkage. During 895,897 person-years of follow-up, 10,193 deaths from all causes occurred – of which 2319 were CVD-related and 870 were related to respiratory disease. The 15-year time-weighted average concentrations of PM2.5, BC/OC, sea salt, SIA and SOA were 13.8, 2.8, 3.4, 4.9, and 0.3 µg/m3, respectively. For all-cause mortality, a higher risk was observed with higher exposure to PM2.5, BC/OC and SOA with adjusted hazard ratios of 1.03 (95% confidence intervals: 1.01, 1.05), 1.06 (1.03, 1.09), and 1.08 (1.03, 1.13) per interquartile range, respectively. The associations for BC/OC and SOA remained after adjustment for PM2.5 in two-pollutant models. For CVD mortality, we observed elevated risks with higher exposure to PM2.5, BC/OC and SIA. The results showed no clear relationship between sea salt and mortality. In this study, we observed a relationship between long-term exposure to PM2.5, BC/OC, and SOA and all-cause mortality and between PM2.5, BC/OC, and SIA and CVD mortality.","author_count":9,"contributors":["Hvidtfeldt, Ulla Arthur","Geels, Camilla","Sørensen, Mette","Ketzel, Matthias","Khan, Jibran","Tjønneland, Anne","Christensen, Jesper Heile","Brandt, Jørgen","Raaschou-Nielsen, Ole"],"cuid":["S03-099.20-019437"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"continent":["Europe, Non-EU","OECD"],"corresponding_author":["Hvidtfeldt, Ulla Arthur"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of Surrey"],"keyword":["Carbonaceous particles","Mortality","Particulate matter chemical constituents","Sea salt","Secondary inorganic aerosols","Secondary organic aerosols"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-NP","DI-OT","DI-U"],"level3":{"NP":["DI-NP-ALL","DI-NP-CAN"],"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-RUC"]},"level3all":["DI-NP-CAN","DI-U-AU","DI-U-KU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"long term residential exposure to pm sub 000000000002 000000000005 sub constituents and mortality in a danish cohort","src":["au","ku","ruc"],"src-code":["DI-U-AU","DI-U-KU","DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.envint.2019.105268","version":"Published Version"},"id":"S03-099.20-019437","identifier":[{"id":"31675564","type":"pmid"},{"id":"000498906200050","type":"wos"},{"id":"85074167265","type":"scopus"}],"ids":["au-5d24bf79-72a7-4558-814e-6c6b2cf6acb0","ku-2d6de17f-ad2b-4f79-a2bf-f703362aa03a","ruc-63617181-b574-4dbf-ad8c-67ef70ea52ff"],"keyword":["Carbonaceous particles","Mortality","Particulate matter chemical constituents","Sea salt","Secondary inorganic aerosols","Secondary organic aerosols"],"lang":"English","level