me":"DCRC Danish Cancer Society Research Center","namevar":["Danish Cancer Society"],"nora_code":"DI-NP-CAN","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Section of Social Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Environmental Science, Department of Environmental Science - Atmospheric Emissions & Modelling"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Dorrit","key":"hjortebjergpau","last":"Hjortebjerg","name":"Hjortebjerg, Dorrit","rank":1,"rolecode":"pau"},{"affno":"2","first":"Anne Marie Nybo","key":"andersenpau","last":"Andersen","locid":"249beb4b-1fec-4854-b57d-d2bf355767db","name":"Andersen, Anne-Marie Nybo","name_org":"Andersen, Anne Marie Nybo","orcid":"0000-0002-4296-8488","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Matthias","key":"ketzelpau","last":"Ketzel","locid":"798900d2-1d54-4c53-a4ca-671c12aa3015","name":"Ketzel, Matthias","orcid":"0000-0001-9519-1935","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marie","key":"pedersenpau","last":"Pedersen","name":"Pedersen, Marie","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ole","key":"raaschounielsenpau","last":"Raaschou-Nielsen","name":"Raaschou-Nielsen, Ole","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mette","key":"sorensenpau","last":"Sorensen","name":"S