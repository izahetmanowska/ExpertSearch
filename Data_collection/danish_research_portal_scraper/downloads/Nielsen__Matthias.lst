,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"eisbn":["9781137596888"],"isbn":["9781137596871"],"pages":"47-71","publisher":"Palgrave Macmillan","series":"Palgrave Studies in the History of Science and Technology","status":"p","subtitle":"Cold War Science and Technology on Ice","title":"Exploring Greenland"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-f31a3015-961c-4adc-8a1f-af81b06d6e68"],"src":["AU Aarhus University"],"title":"Small State Preoccupations : Science and Technology in the Pursuit of Modernization, Security, and Sovereignty in Greenland","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-268003","year":"2016","yearsub":"2016"}
{"abstract":"ESA has recently released a study on the potential of ocean levelling as a novel approach to the study of height system unification taking the recent development in geoid accuracy trough GOCE data into account. The suggested investigation involves the use of measurements and modelling to estimate Mean Dynamic Topography (MDT) of the ocean along a coastline which contributes/requires reconciling altimetry, tide gauge and vertical land motion. The fundamental use of the MDT computed using altimetry, ocean models or through the use of tide gauges has values of between -2 and +1 meters at different points in the ocean. However, close to the coast the determination of the MDT is problematic due to i.e., the altimeter footprint, land motion or parameterization/modelling of coastal currents. The objective of this activity is to perform a consolidated and improved understanding and modelling of coastal processes and physics responsible for sea level changes on various temporal/spatial scales. The study runs from October 2015 to march 2017 and involves elements like: Develop an approach to estimate a consistent DT at tide gauges, coastal areas, and open ocean; Validate the approach in well-surveyed areas where DT can be determined at tide gauges; Determine a consistent MDT using GOCE with consistent error covariance fields; Connect measurements of a global set of tide gauges and investigate trends","author_count":11,"contributors":["Andersen, Ole Baltazar","Knudsen, Per","Nielsen, Karina","Hughes, Christopher","Woodworth, Philip","Bingham, Rory","Woppelmann, Guy","Mederic, Mederic","Fenoglio-Marc, Luciane","Becker, Matthias","Kern, Michael"],"cuid":["S01-000.00-347846"],"event":{"end":"2016-05-13","place":"Prague, cz","start":"2016-05-09","title":"ESA Living Planet Symposium 2016","year":"2016"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","OECD"],"country":["France","Germany","United Kingdom"],"glorg":["All Global Affiliations","European Space Agency - ESA","Technical University of Darmstadt","University of Bristol","University of Liverpool"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"goce dynamical coastal topography and tide gauge unification using altimetry and goce","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://lps16.esa.int/page_session189.php#1619p","version":"Published Version"},"id":"S01-000.00-347846","ids":["dtu-9117e43a-e8e4-4a37-a963-e069c0e72046"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-07163FE2C37CB7436854D4BD6D21360D"],"oa_link":[{"access":"oa","type":"rem","url":"http://lps16.esa.int/page_session189.php#1619p","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Space Institute","Technical University of Denmark, National Space Institute, Geodesy"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"gb","key":"university of liverpool","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Liverpool","used":1},{"affno":"3","country":"gb","key":"university of bristol","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Bristol","used":1},{"affno":"4","country":"de","key":"technical university of darmstadt","loc":["Germany","Europe, EU","OECD"],"name":"Technical University of Darmstadt","used":1},{"affno":"5","country":"fr","key":"european space agency esa","loc":["France","Europe, EU","OECD"],"name":"European Space Agency - ESA","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Ole Baltazar","key":"andersenpau","last":"Andersen","locid":"c003fa87-9771-43b6-80c8-d9d2ddae6549","name":"Andersen, Ole Baltazar","orcid":"0000-0002-6685-3415","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Per","key":"knudsenpau","last":"Knudsen","locid":"ed19967f-42c8-4114-b94d-7f6f43f931bb","name":"Knudsen, Per","orcid":"0000-0003-4640-6746","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Karina","key":"nielsenpau","last":"Nielsen","locid":"35a43dde-d05b-4527-b0e7-1094f9e66c04","name":"Nielsen, Karina","orcid":"0000-0002-0035-1869","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Christopher","key":"hughespau","last":"Hughes","name":"Hughes, Christopher","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Philip","key":"woodworthpau","last":"Woodworth","name":"Woodworth, Philip","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Rory","key":"binghampau","last":"Bingham","name":"Bingham, Rory","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Guy","key":"woppelmannpau","last":"Woppelmann","name":"Woppelmann, Guy","rank":7,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Mederic","key":"medericpau","last":"Mederic","name":"Mederic, Mederic","rank":8,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Luciane","key":"fenogliomarcpau","last":"Fenoglio-Marc","name":"Fenoglio-Marc, Luciane","rank":9,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Matthias","key":"beckerpau","last":"Becker","name":"Becker, Matthias","rank":10,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Michael","key":"kernpau","last":"Kern","name":"Kern, Michael","rank":11,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-9117e43a-e8e4-4a37-a963-e069c0e72046"],"src":["DTU Technical University of Denmark"],"title":"GOCE++ Dynamical Coastal Topography and tide gauge unification using altimetry and GOCE","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-347846","year":"2016","yearsub":"2016"}
{"abstract":"Directional beamforming (DB) estimates blood flowvelocities accurately when the flow angle is known. However, forautomatically finding the flow angle a computationally expensive approach is used. This work presents a method for estimating the flow angle using a combination of inexpensive transverse oscillation (TO) estimators and only 3 directional beamformed lines. The suggested DB vector flow estimator is employed with steered plane wave transmissions for high frame rate imaging.Two distinct plane wave sequences are used: a short sequence(3 angles) for fast flow and an interleaved long sequence (21angles) for both slow flow and B-mode. Parabolic flow with a peak velocity of 0.5 m/s is measured at beam-to-flow angles of60◦and 90◦. The DB method estimates the angle with a bias and standard deviation (STD) less than 2◦, and the STD of the velocity magnitude is 2.5 %. This is 7 - 8.5 % when using TO. The long sequence has a higher sensitivity, and when used forestimation of slow flow with a peak velocity of 0.04 m/s, the SDis 2.5 % and bias is 0.1 %. This is a factor of 4 better than ifthe short sequence is used. The carotid bifurcation was scanned on a healthy volunteer, and the short sequence was used with TO and DB to estimate velocity vectors. The STD of the velocity profile over a cardiac cycle was 6.1 % for TO and 4.9 % for DB.","author_count":6,"contributors":["Jensen, Jonas","Villagómez Hoyos, Carlos Armando","Stuart, Matthias Bo","Ewertsen, Caroline","Nielsen, Michael Bachmann","Jensen, Jørgen Arendt"],"cuid":["S02-083.74-034178"],"event":{"end":"2016-09-21","place":"Tours, fr","start":"2016-09-18","title":"2016 IEEE International Ultrasonics Symposium, IUS 2016","year":"2016"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"i in vivo i high frame rate vector flow imaging using plane waves and directional beamforming","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/125699907/paper_1_.pdf","version":"Authors Final Version"},"id":"S02-083.74-034178","identifier":[{"id":"84996598666","type":"scopus"}],"ids":["dtu-466a78c0-5dfa-43b9-9550-a6251200f723","ku-65c26cf2-604c-4f51-9ca1-edbeaa37ee2b"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-832F6A1933435E0ECBBF136A2DE87600"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/125699907/paper_1_.pdf","version":"Authors Final Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1109/ULTSYM.2016.7728662","version":"Other Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Electrical Engineering","Technical University of Denmark, Department of Electrical Engineering, Biomedical Engineering"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"dk","key":"capital region of denmar