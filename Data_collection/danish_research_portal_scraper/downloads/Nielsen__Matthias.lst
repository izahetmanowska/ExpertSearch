nk":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Josef","key":"dankiewiczpau","last":"Dankiewicz","name":"Dankiewicz, Josef","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hans","key":"fribergpau","last":"Friberg","name":"Friberg, Hans","rank":6,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Matthias","key":"haenggipau","last":"Haenggi","name":"Haenggi, Matthias","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Zana","key":"haxhijapau","last":"Haxhija","name":"Haxhija, Zana","rank":8,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Janus C.","key":"jakobsenpau","last":"Jakobsen","locid":"06691aa2-020b-4869-a6d9-56ac223008cc","name":"Jakobsen, Janus Christian","name_org":"Jakobsen, Janus C.","orcid":"0000-0002-3642-2120","rank":9,"rolecode":"pau"},{"affno":"6 7","corresponding":null,"first":"Halvor","key":"langelandpau","last":"Langeland","name":"Langeland, Halvor","rank":10,"rolecode":"pau"},{"affno":"8","corresponding":null,"first":"Fabio Silvio","key":"tacconepau","last":"Taccone","name":"Taccone, Fabio Silvio","rank":11,"rolecode":"pau"},{"affno":"9","corresponding":null,"first":"Matthew","key":"thomaspau","last":"Thomas","name":"Thomas, Matthew","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Susann","key":"ullénpau","last":"Ullén","name":"Ullén, Susann","rank":13,"rolecode":"pau"},{"affno":"10","corresponding":null,"first":"Matt P.","key":"wisepau","last":"Wise","name":"Wise, Matt P.","rank":14,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Niklas","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Niklas","rank":15,"rolecode":"pau"}],"pmid":["35909163"],"pub":{"doi":"10.1186/s13054-022-04107-9","issn":["1466609X"],"issn_org":["13648535"],"journal":"Critical Care","paperid":"231","publisher":"BioMed Central","status":"p","title":"Critical Care","volume":"26"},"review":"Peer Reviewed","scoID":["2-s2.0-85135198391"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-67df65cc-2dc7-44c6-8a58-feda3bf7e60f"],"src":["SDU University of Southern Denmark"],"title":"Influence of temperature management at 33 °C versus normothermia on survival in patients with vasopressor support after out-of-hospital cardiac arrest : a post hoc analysis of the TTM-2 trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-602939","year":"2022","yearsub":"2022"}
{"abstract":"Background: Teriflunomide 14 mg (Aubagio®) is a once-daily, oral drug approved for the treatment of relapsing forms of multiple sclerosis (MS). While the efficacy and safety of teriflunomide have been thoroughly characterised across an extensive clinical program, we were interested in studying performance of the drug with respect to quality-of-life (QoL) outcomes in persons with MS in a real-world setting. Methods: Teri-LIFE was a prospective, open label, non-interventional, observational, multi-centre study that enrolled 200 teriflunomide-treated patients from three Nordic countries. The primary outcome measure changes in patient-reported QoL over 24 months as measured by the Short Form-36 (SF-36) questionnaire. Secondary endpoints included clinical efficacy, fatigue, safety, treatment satisfaction (Treatment Satisfaction Questionnaire for Medication version 1.4 (TSQM-1.4)), treatment adherence, and health economic outcomes. Most assessments were made at baseline and then at 6-monthly intervals. Results: Overall, changes in SF-36 scores from baseline to last visit indicated a stable QoL during treatment with teriflunomide for up to 24 months. Relapse activity decreased during the study compared to the pre-baseline period (p<0.001), patient-reported disability increased marginally, and no substantial change was seen in fatigue scores. The mean scores for TSQM domains increased nominally though not significantly from Month 6 to Month 24. The convenience and side effects TSQM domains recorded the highest median scores, indicating the acceptability of oral teriflunomide in this cohort. This was reflected in a generally high treatment adherence and decreased healthcare utilization during the study period. Some differences were seen between treatment-naïve and previously treated patients, likely reflecting different patient demographics and disease status at study entry, along with different treatment expectations. Conclusion: Teri-LIFE offers a reliable snapshot of QoL, efficacy, safety, and health economic outcomes in persons with relapsing MS treated with teriflunomide in routine clinical practice in Nordic countries The results were consistent with previous clinical trials and real-world studies.","author_count":9,"contributors":["Hestvik, Anne Lise K.","Frederiksen, Jette Lautrup","Nielsen, Helle Hvilsted","Torkildsen, Øivind","Eek, Camilla","Huang-Link, Yumin","Haghighi, Sara","Tsai, Jon A.","Kant, Matthias"],"cuid":["S01-000.00-638689"],"filters":{"added":"2022-08","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Hestvik, Anne Lise K."],"country":["France","Norway","Sweden"],"glorg":["All Global Affiliations","Drammen Hospital","Haukeland University Hospital","Linköping University Hospital","Motala Hospital","Sanofi"],"keyword":["Adherence","Crotonates adverse effects","Fatigue drug therapy","Health economic outcomes","Humans","Hydroxybutyrates","Multiple Sclerosis drug therapy","Multiple sclerosis","Nitriles","Prospective Studies","Quality of Life","Recurrence","Teriflunomide","Toluidines adverse effects","Treatment satisfaction"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"real world study of relapsing remitting multiple sclerosis patients treated with teriflunomide in nordic countries quality of life efficacy safety and adherence outcomes","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85132428355","version":"Other Version"},"funding_acknowledgement":["This study was funded by Sanofi. The sponsor was involved in the study design, and collection, analysis, and interpretation of data, as well as verification of the data presented in the manuscript. DMT-naïve patients had lower mean TSQM scores than switch patients in all domains except for Convenience ( Fig. 6 ), possibly reflecting different treatment expectations and improved outcomes in switch patients after switching therapy. This result was supported by the lower ARRs for the two subgroups and could indicate better disease control from the study outset. There were no hospitalizations at all in the switch group. ALKH: Employee of Sanofi; JLF: Served on scientific advisory boards for and received funding for travel related to these activities as well as honoraria from Biogen Idec, Merck Serono, Sanofi-Aventis, Teva, Novartis, and Almirall. Received speaker honoraria from Biogen Idec, Teva, and Novartis; HHN: Has received financial compensation and travel reimbursements from Teva, Biogen Idec, Sanofi-Genzyme, Novartis, and Roche; ØT: Served on the scientific advisory boards for and received speaker honoraria from Novartis, Biogen, Genzyme, Roche, and Merck; CE: honorarium from Merck and contributed to sponsored research; YH-L: Financial support from Sanofi for research (Teri-LIFE study); SH: The Teri-LIFE project received financial support from Sanofi; EMP: Employee of Sanofi, with ownership interest; JAT: Employee of Sanofi, with ownership interest; MK: Support for congress participation from Biogen, Genzyme, Teva, Roche, and Novartis. This manuscript has not, in whole or in part, been published previously and is not under consideration for publication elsewhere."],"id":"S01-000.00-638689","identifier":[{"id":"35696880","type":"pmid"},{"id":"85132428355","type":"scopus"}],"ids":["sdu-e4acb7fa-ae1e-4cca-bc19-f0e04fd23923"],"keyword":["Adherence","Crotonates/adverse effects","Fatigue/drug therapy","Health economic outcomes","Humans","Hydroxybutyrates","Multiple Sclerosis, Relapsing-Remitting/chemically induced","Multiple Sclerosis/drug therapy","Multiple sclerosis","Nitriles","Prospective Studies","Quality-of-life","Recurrence","Teriflunomide","Toluidines/adverse effects","Treatment satisfaction"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-8014E4DBFF91382E8EB21E52747AE9C5"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"fr","key":"sanofi","loc":["France","Europe, EU","OECD"],"name":"Sanofi","used":1},{"affno":"2","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Neurology (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"4","country":"no","key":"haukeland university hospital","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"Haukeland University Hospital","used":1},{"affno":"5","country":"no","key":"drammen hospital","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"Drammen Hospital","used":1},{"affno":"6","country":"se","key":"linköping university hospital","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Linköping University Hospital","used":1},{"affno":"7","country":"se","key":"motala hospital","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Motala Hospital","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anne Lise K.","key":"hestvikpau","last":"Hestvik","name":"Hestvik, Anne Lise K.","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jette Lautrup","key":"frederiksenpau","last":"Frederiksen","name":"Frederiksen, Jette Lautrup","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Helle Hvilsted","key":"nielsenpau","last":"Nielsen","locid":"e1703e06-01b8-4d46-a1d1-4c4d5af99fa5","name":"Nielsen, Helle Hvilsted","orcid":"0000-0002-7319-1368","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Øivind","key":"torkildsenpau","last":"Torkildsen","name":"Torkildsen, Øivind","rank":4,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Camilla","key":"eekpau","last":"Eek","name":"Eek, Camilla","rank":5,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Yumin","key":"huanglinkpau","last":"Huang-Link","name":"Huang-Link, Yumin","rank":6,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Sara","key":"haghighipau","last":"Haghighi","name":"Haghighi, Sara","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jon A.","key":"tsaipau","last":"Tsai","name":"Tsai, Jon A.","rank":8,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Matthias","key":"kantpau","last":"Kant","locid":"be6ec287-1bfc-4785-bc68-ff709f2a9093","name":"Kant, Matthias","rank":9,"rolecode":"pau"}],"pmid":["35696880"],"pub":{"doi":"10.1016/j.msard.2022.103892","issn":["22110348","22110356"],"issn_org":["22110348"],"journal":"Multiple Sclerosis and Related Disorders","paperid":"103892","publisher":"Elsevier","status":"p","title":"Multiple Sclerosis and Related Disorders","volume":"63"},"review":"Peer Reviewed","scoID":["2-s2.0-85132428355"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-e4acb7fa-ae1e-4cca-bc19-f0e04fd23923"],"src":["SDU University of Southern Denmark"],"title":"Real-world study of relapsing-remitting multiple sclerosis patients treated with Teriflunomide in Nordic countries : Quality-Of-Life, efficacy, safety and adherence outcomes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-638689","year":"2022","yearsub":"2022"}
{"abstract":"OBJECTIVES: To investigate the association between occupational noise exposure and stroke incidence in a pooled study of five Scandinavian cohorts (NordSOUND). METHODS: We pooled and harmonised data from five Scandinavian cohorts resulting in 78 389 participants. We obtained job data from national registries or questionnaires and recoded these to match a job-exposure matrix developed in Sweden, which specified the annual average daily noise exposure in five exposure classes (L Aeq8h): <70, 70-74, 75-79, 80-84, ≥85 dB(A). We identified residential address history and estimated 1-year average road traffic noise at baseline. Using national patient and mortality registers, we identified 7777 stroke cases with a median follow-up of 20.2 years. Analyses were conducted using Cox proportional hazards models adjusting for individual and area-level potential confounders. RESULTS: Exposure to occupational noise at baseline was not associated with overall stroke in the fully adjusted models. For ischaemic stroke, occupational noise was associated with HRs (95% CI) of 1.08 (0.98 to 1.20), 1.09 (0.97 to 1.24) and 1.06 (0.92 to 1.21) in the 75-79, 80-84 and ≥85 dB(A) exposure groups, compared with <70 dB(A), respectively. In subanalyses using time-varying occupational noise exposure, we observed an indication of higher stroke risk among the most exposed (≥85 dB(A)), particularly when restricting analyses to people exposed to occupational noise within the last year (HR: 1.27; 95% CI: 0.99 to 1.63). CONCLUSIONS: We found no association between occupational noise and risk of overall stroke after adjustment for confounders. However, the non-significantly increased risk of ischaemic stroke warrants further investigation.","author_count":32,"contributors":["Thacher, Jesse D","Roswall, Nina","Lissåker, Claudia","Aasvang, Gunn Marit","Albin, Maria","Andersson, Eva M","Engström, Gunnar","Eriksson, Charlotta","Hvidtfeldt, Ulla Arthur","Ketzel, Matthias","Khan, Jibran","Lanki, Timo","Ljungman, Petter L S","Mattisson, Kristoffer","Molnar, Peter","Raaschou-Nielsen, Ole","Oudin, Anna","Overvad, Kim","Petersen, Sesilje Bondo","Pershagen, Göran","Poulsen, Aslak Harbo","Pyko, Andrei","Rizzuto, Debora","Rosengren, Annika","Schioler, Linus","Sjöström, Mattias","Stockfelt, Leo","Tiittanen, Pekka","Sallsten, Gerd","Ögren, Mikael","Selander, Jenny","Sorensen, Mette"],"cuid":["S02-099.86-017552"],"filters":{"added":"2022-06","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Thacher, Jesse D"],"country":["Finland","Norway","Sweden","United Kingdom"],"glorg":["All Global Affiliations","Danderyds Hospital","Finnish Institute for Health and Welfare","Karolinska Institute","Karolinska Institutet","Lund University","National Institute for Health and Welfare","Norwegian Institute of Public Health","Region Stockholm","Sahlgrenska University Hospital","Stockholm Gerontology Research Centre","Stockholm University","Umeå University","University of Eastern Finland","University of Gothenburg","University of Surrey"],"keyword":["Epidemiology","Noise","Public health"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-NP","DI-U"],"level3":{"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-RUC"]},"level3all":["DI-NP-CAN","DI-U-AU","DI-U-KU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"occupational noise exposure and risk of incident stroke a pooled study of five scandinavian cohorts","src":["au","ruc"],"src-code":["DI-U-AU","DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/oemed-2021-108053","version":"Published Version"},"id":"S02-099.86-017552","identifier":[{"id":"85130847985","type":"scopus"},{"id":"000786575000001","type":"wos"},{"id":"PMC9453564","type":"pmcid"}