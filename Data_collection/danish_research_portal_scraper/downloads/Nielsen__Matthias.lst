leheendanishpau","last":"Saleheen","name":"Saleheen, Danish","rank":228,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jerome I","key":"rotterjeromeipau","last":"Rotter","name":"Rotter, Jerome I","rank":230,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Mark I","key":"mccarthymarkipau","last":"McCarthy","name":"McCarthy, Mark I","rank":231,"rolecode":"pau"}],"pmid":["29632382"],"pub":{"doi":"10.1038/s41588-018-0084-1","issn":["10614036","15461718"],"issn_org":["10614036"],"issue":"4","journal":"Nature Genetics","pages":"559-571","publisher":"Nature Research","status":"p","title":"Nature Genetics","volume":"50"},"review":"Peer Reviewed","scoID":["2-s2.0-85042368356"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Hospitals","Other Research","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark","danish diabetes academy"],"PST":["Published"]},"sid":["aau-9a818b34-bc43-468a-ad29-7c478fd81ed5","au-c1213cf4-47ab-49e6-b8e6-e3a85d879ef4","ku-05a659f9-6d93-4390-b188-2e37cc62a3c4","sdu-d1a54638-1930-4544-8102-e8767d103bbb"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Refining the accuracy of validated target identification through coding variant fine-mapping in type 2 diabetes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-088.18-007500","year":"2018","yearsub":"2018"}
{"abstract":"Although movement is essential in location-based games to get from one point of interest to the next, it is seldom taken into account for the game design and the selection of locations. Instead, player movement is usually analyzed after the fact, i.e. when the game is ready to play. In this paper we compare this post-hoc movement analysis with an approach that utilizes the methods for movement analysis to inform the game design itself. We show that both approaches have their merits and solve different tasks, but that there is a benefit of taking movement more serious in designing location-based educational games.","author_count":8,"contributors":["Rehm, Matthias","Christensen, Bianca Clavio","Nielsen, Thorsten Bausbek","Rolfsen, Rasmus Albin","Schmuck, Viktor"],"cuid":["S01-000.00-061295"],"event":{"acronym":"SLERD","end":"2017-06-23","place":"Aveiro, pt","start":"2017-06-22","title":"2nd International Conference on Smart Learning Ecosystems and Regional Developments","year":"2017"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Educational game","Location based games","Movement analysis"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"movement patterns in educational games comparing a priori and post hoc analyses","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85022205964&partnerID=8YFLogxK","version":"Other Version"},"id":"S01-000.00-061295","identifier":[{"id":"85022205964","type":"scopus"}],"ids":["aau-26bbeb00-763d-4977-82d5-806f062e8b7f"],"keyword":["Educational Game","Location-based games","Movement analysis"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-595F36E6C24F042CD373D949B1EFF853"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Technical Faculty of IT and Design","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology, Centre for Mobility and Urban Studies","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology, Human Machine Interaction","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology, Mobility and Tracking Technologies","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology, Section for Media Technology - Campus Aalborg","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology, The Center for Applied Game Research"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Matthias","key":"rehmpau","last":"Rehm","locid":"04553c36-2327-4e8d-8d3c-701b04cb2d77","name":"Rehm, Matthias","orcid":"0000-0001-6264-1688","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Bianca Clavio","key":"christensenpau","last":"Christensen","locid":"847935db-95dd-4eee-acf4-1b077393c4fb","name":"Christensen, Bianca Clavio","orcid":"0000-0002-7686-6017","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thorsten Bausbek","key":"nielsenpau","last":"Nielsen","locid":"eabf9443-8db2-4442-93d2