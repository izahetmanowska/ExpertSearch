k":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lise Marie","key":"frohnpau","last":"Frohn","locid":"1db55612-df02-4189-ab0d-5c62193e1afc","name":"Frohn, Lise Marie","orcid":"0000-0002-4236-5708","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Matthias","key":"ketzelpau","last":"Ketzel","locid":"798900d2-1d54-4c53-a4ca-671c12aa3015","name":"Ketzel, Matthias","orcid":"0000-0001-9519-1935","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Morten","key":"wintherpau","last":"Winther","locid":"e6e4932c-38fd-445f-b1b1-67f483ecd22b","name":"Winther, Morten","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marlene Schmidt","key":"plejdruppau","last":"Plejdrup","locid":"9dede80b-ff3e-4171-9504-bf8547fec74d","name":"Plejdrup, Marlene Schmidt","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ole-Kenneth","key":"nielsenpau","last":"Nielsen","locid":"17ec76bb-7916-4024-867b-3aca60ca0c40","name":"Nielsen, Ole-Kenneth","orcid":"0000-0003-4350-0956","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thomas","key":"ellermannpau","last":"Ellermann","locid":"5e5a2168-23db-4863-b6d5-bda7dcb1f662","name":"Ellermann, Thomas","rank":8,"rolecode":"pau"}],"pub":{"isbn":["9788771565386"],"issue":"407","pages":"80","place":"Aarhus","publisher":"Aarhus Universitet","repno":"Videnskabelig rapport fra DCE - Nationalt Center for Miljø og Energi, No. 407","series":"Videnskabelig rapport fra DCE - Nationalt Center for Miljø og Energi","status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-802700f4-657d-4bd8-8d15-7e3752111173"],"src":["AU Aarhus University"],"title":"Kortlægning af luftforurening og dens helbredseffekter i Odense Kommune","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-202621","year":"2020","yearsub":"2020"}
{"abstract":"Exposure to traffic noise has been associated with adverse effects on neuropsychological development in children, but the results with regard to behavioral problems are inconsistent. In this study, we investigated associations between residential road traffic noise exposure and behavioral problems in 7-year old children using data from a national birth cohort in which we identified 46,940 children with complete information on both behavioral problems at 7 years of age and address history from conception to 7 years of age. Road traffic noise (Lden) was modeled at all present and historical addresses and behavioral problems were assessed by the Strengths and Difficulties Questionnaire. Associations between pregnancy and childhood exposure to noise and behavioral problems were analyzed by multinomial logistic regression models and adjusted for potential confounders. We found that for mean time-weighted exposure from birth to 7 years of age, a 10 dB higher road traffic noise was associated with a 7 % higher risk for scoring abnormal (95% CI: 1.00-1.14) compared to normal scores on the total difficulties score. A 5 % higher risk for scoring borderline (95% CI: 1.00-1.10) and a 10 % higher risk for scoring abnormal (95% CI: 1.03-1.18) were found on the hyperactivity/inattention subscale. Exposure to road traffic noise during the pregnancy period was not associated with child behavioral problems at 7 years of age. In conclusion, this study indicates that residential road traffic noise in early childhood may increase the risk for behavioral problems, particularly hyperactivity/inattention symptoms.","author_count":9,"contributors":["Hjortebjerg, Dorrit","Andersen, Anne-Marie Nybo","Christensen, Jeppe Schultz","Ketzel, Matthias","Raaschou-Nielsen, Ole","Sunyer, Jordi","Julvez, Jordi","Forns, Joan","Sørensen, Mette"],"cuid":["S01-000.00-397729"],"event":{"end":"2015-06-03","place":"Maastricht, nl","start":"2015-06-01","title":"10th European Congress and Exposition on Noise Control Engineering, Euronoise 2015","year":"2015"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD"],"country":["Norway","Spain"],"glorg":["All Global Affiliations","Barcelona Institute for Global Health","Norwegian Institute of Public Health"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-NP","DI-U"],"level3":{"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-NP-CAN","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"exposure to road traffic noise and risk for behavioral problems in 000000000007 year old children a cohort study","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-397729","identifier":[{"id":"85080913820","type":"scopus"}],"ids":["ku-0717f387-e3c3-40a6-84f9-e6c36783de13"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-B895E87220BE30A0F6C2A4A508B7934F"],"org":[{"affno":"1","country":"dk","key":"dcrc danish cancer society research center","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-CAN","l3nn":"DCRC Danish Cancer Society Research Center","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DCRC Danish Cancer Society Research Center","namevar":["Danish Cancer Society"],"nora_code":"DI-NP-CAN","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Section of Epidemiology"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University"],"nora_code":"DI-U-AU","used":1},{"affno":"4","country":"es","key":"barcelona institute for global health","loc":["Spain","Europe, EU","OECD"],"name":"Barcelona Institute for Global Health","used":1},{"affno":"5","country":"no","key":"norwegian institute of public health","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"Norwegian Institute of Public Health","used":1}],"person":[{"affno":"1","first":"Dorrit","key":"hjortebjergpau","last":"Hjortebjerg","name":"Hjortebjerg, Dorrit","rank":1,"rolecode":"pau"},{"affno":"2","first":"Anne Marie Nybo","key":"andersenpau","last":"Andersen","locid":"249beb4b-1fec-4854-b57d-d2bf355767db","name":"Andersen, Anne-Marie Nybo","name_org":"Andersen, Anne Marie Nybo","orcid":"0000-0002-4296-8488","rank":2,"rolecode":"pau"},{"affno":"1","first":"Jeppe Schultz","key":"christensenpau","last":"Christensen","name":"Christensen, Jeppe Schultz","rank":3,"rolecode":"pau"},{"affno":"3","first":"Matthias","key":"ketzelpau","last":"Ketzel","name":"Ketzel, Matthias","rank":4,"rolecode":"pau"},{"affno":"","first":"Ole","key":"raaschounielsenpau","last":"Raaschou-Nielsen","name":"Raaschou-Nielsen, Ole","rank":5,"rolecode":"pau"},{"affno":"4","first":"Jordi","key":"sunyerpau","last":"Sunyer","name":"Sunyer, Jordi","rank":6,"rolecode":"pau"},{"affno":"4","first":"Jordi","key":"julvezpau","last":"Julvez","name":"Julvez, Jordi","rank":7,"rolecode":"pau"},{"affno":"5","first":"Joan","key":"fornspau","last":"Forns","name":"Forns, Joan","rank":8,"rolecode":"pau"},{"affno":"","first":"Mette","key":"sørensenpau","last":"Sørensen","name":"Sørensen, Mette","rank":9,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Non-Profit Organisations","All Universities","DI-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Non-Profit Organisations","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-0717f387-e3c3-40a6-84f9-e6c36783de13"],"src":["KU University of Copenhagen"],"title":"Exposure to road traffic noise and risk for behavioral problems in 7-year old children : A cohort study","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-397729","year":"2020","yearsub":"2020"}
{"abstract":"Objectives: Transportation noise has been associated with markers of obesity. We aimed to investigate whether road traffic and railway noise were associated with weight gain during and after pregnancy. Methods: Among the women participating in the Danish National Birth Cohort, 74 065 reported on weight before and during the pregnancy (gestational week 30) and 52 661 reported on weight before and 18 months after pregnancy. Residential address history from conception to 18 months after pregnancy was obtained in national registers, and road traffic and railway noise were modelled for all addresses. Associations between noise and gestational weight gain (GWG) and postpartum weight retention (PPWR) were analysed using the linear and log-binomial regression. Results: A 10 dB(A) higher road traffic noise was associated with an increase in GWG of 3.8 g/week (95% CI 2.3 to 5.3) and PPWR of 0.09 kg (95% CI 0.02 to 0.16). For PPWR, this association seemed confined to women who were overweight (0.17 kg, 95% CI 0.02 to 0.32) or obese (0.49 kg, 95% CI 0.26 to 0.73) before pregnancy. Further adjustment by nitrogen dioxide reduced GWG risk estimates and slightly increased PPWR risk estimates. Railway noise ≥65 dB(A) was associated with an increase in GWG of 4.5 g/week (95% CI -2.7 to 11.6) and PPWR of 0.26 kg (95% CI -0.09 to 0.60) compared with levels <55 dB(A). Conclusions: Our findings suggest that road traffic noise is associated with weight gain during and after the pregnancy, which adds to the literature linking transportation noise to adiposity.","author_count":4,"contributors":["Sørensen, Mette","Sørensen, Thorkild I A","Ketzel, Matthias","Raaschou-Nielsen, Ole"],"cuid":["S03-099.96-025220"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":3,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of Surrey"],"keyword":["Epidemiology","Noise","Weight Gain"],"level":"sci","mra":["med","sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-NP","DI-U"],"level3":{"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-RUC"]},"level3all":["DI-NP-CAN","DI-U-AU","DI-U-KU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"exposure to traffic noise and gestational weight gain and postpartum weight retention a cohort study","src":["au","ku","ruc"],"src-code":["DI-U-AU","DI-U-KU","DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85076126911","version":"Other Version"},"id":"S03-099.96-025220","identifier":[{"id":"85076126911","type":"scopus"},{"id":"000518180300008","type":"wos"},{"id":"31801799","type":"pmid"}],"ids":["au-ac595e3a-de48-4507-827e-bd77f65b4f1e","ku-f14314be-7cef-4a56-93df-46621ba7a51a","ruc-aa2c9bf1-4f2f-4fd2-b3ac-6abe5886a55d"],"keyword":["epidemiology","noise","weight gain"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-6-3AE0F2F0F3BFF3F62E04870EB0043134"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of Science and Environment"],"nora_code":"DI-U-RUC","used":1},{"affno":"2","country":"dk","key":"dcrc danish cancer society research center","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-CAN","l3nn":"DCRC Danish Cancer Society Research Center","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DCRC Danish Cancer Society Research Center","namevar":["Danish Cancer Society"],"nora_code":"DI-NP-CAN","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Section of Epidemiology","Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Basic Metabolic Research"],"nora_code":"DI-U-KU","used":1},{"affno":"4","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Environmental Science, Department of Environmental Science - Atmospheric Emissions & Modelling"],"nora_code":"DI-U-AU","used":1},{"affno":"5","country":"gb","key":"university of surrey","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Surrey","used":1}],"person":[{"affno":"1 2","country":"dk","first":"Mette","key":"sørensenmettepau","last":"Sørensen","locid":"5bf2a665-def4-499c-9c63-0c440da72e20","name":"Sørensen, Mette","rank":1,"rolecode":"pau"},{"affno":"3","first":"Thorkild I. A.","key":"sørensenthorkildiapau","last":"Sørensen","locid":"2cb8cf47-6b6b-4010-bdf6-9ec77c7deed3","name":"Sørensen, Thorkild I A","name_org":"Sørensen, Thorkild I. A.","orcid":"0000-0003-4821-430X","rank":2,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"country":"dk","first":"Matthias","key":"ketzelmatthiaspau","last":"Ketzel","locid":"798900d2-1d54-4c53-a4ca-671c12aa3015","name":"Ketzel, Matthias","orcid":"0000-0001-9519-1935","rank":3,"rolecode":"pau"},{"affno":"2 4","corresponding":null,"country":"dk","first":"Ole","key":"raaschounielsenolepau","last":"Raaschou-Nielsen","locid":"9ae8831f-2034-4c09-84bc-01cd649e3b55","name":"Raaschou-Nielsen, Ole","rank":4,"rolecode":"pau"}],"pmid":["31801799"],"pub":{"doi":"10.1136/oemed-2019-105843","issn":["13510711","14707926"],"issn_org":["13510711"],"issue":"2","journal":"Occupational and Environmental Medicine","pages":"107-114","publisher":"BMJ Publishing Group","status":"p","title":"Occupational and Environmental Medicine","title_org":"Occupational & Environmental Medicine","volume":"77"},"review":"Peer Reviewed","scoID":["2-s2.0-85076126911"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Non-Profit Organisations","All Universities","DI-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Non-Profit Organisations","Roskilde University","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-ac595e3a-de48-4507-827e-bd77f65b4f1e","ku-f14314be-7cef-4a56-93df-46621ba7a51a","ruc-aa2c9bf1-4f2f-4fd2-b3ac-6abe5886a55d"],"src":["AU Aarhus University","KU University of Copenhagen","RUC Roskilde University"],"title":"Exposure to traffic noise and gestational weight gain and postpartum weight retention : A cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-099.96-025220","year":"2020","yearsub":"2020"}
{"abstract":"Background Despite the increasing role of ultrasound, structured ultrasound teaching is only slowly being integrated into the curricula of medical schools and universities all over Europe. Aim To survey the current situation at European universities regarding the integration of ultrasound in student medical education and to report on models of student ultrasound training from selected European universities. Methods A questionnaire survey focusing on the implementation of curricular ultrasound education was sent out to the 28 presidents of the national ultrasound societies of the European Federation of Societies for Ultrasound in Medicine and Biology (EFSUMB), who were asked to distribute the questionnaires to the medical universities of their countries. Results Overall, 53 questionnaires were returned from 46 universities in 17 European countries. In most of the universities (40/46 universities, 87%), the theoretical background of ultrasound is taught. However, in only a minority of universities is ultrasound integrated in anatomy courses (8/46 universities, 17%) or basic science courses (16/46 universities, 35%). Practical skills in ultrasound are taught in 56% of the universities (26/46 universities) and tested in a practical exam in seven of the responding universities (15%). The number of hours in which ultrasound was taught ranged from one to 58 (mean, seven). The respondents reported that lack of time and limited faculty funding were major hurdles. Conclusion According to our survey, only a minority of European universities has integrated ultrasound into the preclinical curriculum thus far. Future EFSUMB initiatives will continue to promote the introduction of ultrasound as an integrative part of the core curriculum of student medical education, and the preparation of proper teaching material.","author_count":17,"contributors":["Prosch, Helmut","Radzina, Maija","Dietrich, Christoph F.","Nielsen, Michael Bachmann","Baumann, Sven","Ewertsen, Caroline","Jenssen, Christian","Kabaalioǧlu, Adnan","Kosiak, Wojciech","Kratzer, Wolfgang","Lim, Adrian","Popescu, Alina","Mitkov, Vladimir","Schiavone, Cosima","Wohlin, Martin","Wüstner, Matthias","Cantisani, Vito"],"cuid":["S01-000.00-471621"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Asia, Middle East","Europe, EU","Europe, Non-EU","Nordic","OECD"],"country":["Austria","Germany","Italy","Latvia","Poland","Romania","Russia","Sweden","Switzerland","Turkey","United Kingdom"],"glorg":["All Global Affiliations","Gabriele d'Annunzio University","Imperial College London","Koc University","Krankenhaus Märkisch Oderland","Krankenhaus der Barmherzigen Brüder Trier","Medical University of Gdańsk","Medical University of Vienna","Paul Stradins Clinical University Hospital","Riga Stradins University","Russian Medical Academy of Continuous Professional Education","Schänzlihalde","Ulm University","University of Rome La Sapienza","Uppsala University","Victor Babes University of Medicine and Pharmacy"],"keyword":["Guideline","Teaching","Ultrasound","methods techniques"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"ultrasound curricula of student education in europe summary of the experience","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1055/a-1183-3009","version":"Published Version"},"id":"S01-000.00-471621","identifier":[{"id":"PMC7458842","type":"pmcid"},{"id":"32885138","type":"pmid"},{"id":"85090786895","type":"scopus"}],"ids":["ku-82ad1700-9416-41ad-aed3-9301f08350a2"],"keyword":["guideline","methods & techniques","teaching","ultrasound"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-