o":"1 2","corresponding":null,"first":"Christian Lund Nørgaard","key":"straszekpau","last":"Straszek","locid":"d0698a4c-1b54-4b95-87f7-14dc0335249c","name":"Straszek, Christian Lund Nørgaard","orcid":"0000-0001-9486-056X","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars Domino","key":"østergaardpau","last":"Østergaard","locid":"f9825a2c-e6b4-41b1-9807-6c3cb04b3f88","name":"Østergaard, Lars Domino","orcid":"0000-0002-7807-3926","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Thorkild","key":"hanghøjpau","last":"Hanghøj","locid":"f14a3800-5086-4fa8-880e-ac0725c8756d","name":"Hanghøj, Thorkild","orcid":"0000-0001-8053-8377","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Anne","key":"fiskaalipau","last":"Fiskaali","name":"Fiskaali, Anne","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Anne","key":"bruspau","last":"Brus","name":"Brus, Anne","rank":5,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Anne Mette","key":"thorhaugepau","last":"Thorhauge","name":"Thorhauge, Anne Mette","rank":6,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Rune Kristian","key":"lundedalnielsenpau","last":"Lundedal Nielsen","name":"Lundedal Nielsen, Rune Kristian","rank":7,"rolecode":"pau"}],"pub":{"issn":["22465553"],"journal":"Altinget.dk","status":"p","title":"Altinget.dk"},"review":"Undetermined","sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","All University Colleges","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","Hospitals","IT University of Copenhagen","Universities","University College of Northern Denmark","University Colleges","University of Copenhagen"],"PST":["Published"]},"sid":["aau-6330b558-2068-401d-8920-16998ee83d5d"],"src":["AAU Aalborg University"],"title":"Forskere: Vi skal afdække e-sportens skjulte vækstpotentiale","type":"Journal Comment","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-078845","year":"2022","yearsub":"2022"}
{"abstract":"Nearly all young people use the internet daily. Many youth with mental health concerns, especially since the Covid-19 pandemic, are using this route to seek help, whether through digital mental health treatment, illness prevention tools, or supports for mental wellbeing. Videogames also have wide appeal among young people, including those who receive mental health services. This review identifies the literature on videogame interventions for young people, ages 12-29, and maps the data on game use by those with mental health and substance use problems, focusing on evidence for the capacity of games to support treatment in youth mental health services; how stakeholders are involved in developing or evaluating games; and any potential harms and ethical remedies identified. A systematic scoping review methodology was used to identify and assess relevant studies. A search of multiple databases identified a total of 8,733 articles. They were screened, and 49 studies testing 32 digital games retained. An adapted stepped care model, including four levels, or steps, based on illness manifestation and severity, was used as a conceptual framework for organizing target populations, mental health conditions and corresponding digital games, and study results. The 49 selected studies included: 10 studies (20.4%) on mental health promotion/prevention or education for undiagnosed youth (Step 0: 7 games); 6 studies (12.2%) on at-risk groups or suspected mental problems (Step 1: 5 games); 24 studies (49.0%) on mild to moderate mental conditions (Steps 2-3: 16 games); and 9 studies (18.4%) focused on severe and complex mental conditions (Step 4: 7 games). Two interventions were played by youth at more than one level of illness severity: the SPARX game (Steps 1, 2-3, 4) and Dojo (Steps 2-3 and 4), bringing the total game count to 35 with these repetitions. Findings support the potential integration of digital games in youth services based on study outcomes, user satisfaction, relatively high program retention rates and the potential usefulness of most games for mental health treatment or promotion/prevention. Most studies included stakeholder feedback, and involvement ratings were very high for seven games. Potential harms were not addressed in this body of research. This review provides an important initial repository and evaluation of videogames for use in clinical settings concerned with youth mental health.","author_count":2,"contributors":["no-lastname, no-firstname","no-lastname, no-firstname","no-lastname, no-firstname","no-lastname, no-firstname","no-lastname, no-firstname","no-lastname, no-firstname","no-lastname, no-firstname","no-lastname, no-firstname","no-lastname, no-firstname","no-lastname, no-firstname","no-lastname, no-firstname","no-lastname, no-firstname","no-lastname, no-firstname","no-lastname, no-firstname","Nielsen, Rune Kristian Lundedal"],"cuid":["S01-000.00-381830"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Digital Games","Digital mental health interventions","Scoping review","Stepped care","Video games","Youth","e interventions","youth and young adults"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"gaming my way to recovery a systematic scoping review of digital game interventions for young people s mental health treatment and promotion","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/doi:%2010.3389/fdgth.2022.814248","version":"Published Version"},"id":"S01-000.00-381830","identifier":[{"id":"85131238804","type":"scopus"}],"ids":["itu-255def5d-d5a1-47b1-9e98-30aa5d4edbd2"],"keyword":["digital games","digital mental health interventions","e-interventions","scoping review","stepped care","video games","youth","youth and young adults"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-78D3C477A0CD0B3E6A13F4641714B5AE"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/doi:%2010.3389/fdgth.2022.814248","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Play, Culture, and AI, Games Research Group"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"","corresponding":null,"first":"no-firstname","key":"nolastnamenofirstnamepau","last":"no-lastname","name":"no-lastname, no-firstname","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rune Kristian Lundedal","key":"nielsenrunekristianlundedalpau","last":"Nielsen","locid":"80784458-06f6-4eff-b0c8-df982ffa9835","name":"Nielsen, Rune Kristian Lundedal","orcid":"0000-0002-7209-9041","rank":15,"rolecode":"pau"}],"pub":{"doi":"10.3389/fdgth.2022.814248","issn":["2673253X"],"journal":"Frontiers in Digital Health","publisher":"Frontiers","status":"p","title":"Frontiers in Digital Health","volume":"4"},"review":"Peer Reviewed","scoID":["2-s2.0-85131238804"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-255def5d-d5a1-47b1-9e98-30aa5d4edbd2"],"src":["ITU IT University of Copenhagen"],"title":"Gaming My Way to Recovery: A Systematic Scoping Review of Digital Game Interventions for Young People's Mental Health Treatment and Promotion","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381830","year":"2022","yearsub":"2022"}
