{"abstract":"Counter-Strike er måske verdens bedste og mest populære skydespil, ikke bare for amatører og for hyggens skyld men også som professionel sport. Desværre kan Counter-Strike også fungere som et ureguleret kasino for børn","author_count":1,"contributors":["Nielsen, Rune Kristian Lundedal"],"cuid":["S01-000.00-695250"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"keyword":["Counter Strike","Digital regulation","Esports","Online gambling","youth addiction"],"level":"pop","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"und","rtype":["clu"],"sorti":"counter strike 000000000002","src":["itu"],"src-code":["DI-U-ITU"],"type":"doi","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://tjekspillet.dk/counter-strike-2/","version":"Published Version"},"id":"S01-000.00-695250","ids":["itu-678c4c1f-9c36-4da5-94b3-3312fd479ae4"],"keyword":["Counter-Strike","digital regulation","esports","online gambling","youth addiction"],"lang":"Danish","level":"Popular","mra":["Science/Technology"],"noi":["Local-1-1-53EDB77B1AB4BF92739B378B149AF975"],"oa_link":[{"access":"oa","type":"rem","url":"https://tjekspillet.dk/counter-strike-2/","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Digital Design, Play, Culture and AI Section","IT University of Copenhagen, Play, Culture, and AI, Games Research Group"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Rune Kristian Lundedal","key":"nielsenpau","last":"