g":null,"first":"Nicole","key":"prausepau","last":"Prause","name":"Prause, Nicole","rank":29,"rolecode":"pau"},{"affno":"36","corresponding":null,"first":"Patrick","key":"praxpau","last":"Prax","name":"Prax, Patrick","rank":30,"rolecode":"pau"},{"affno":"37","corresponding":null,"first":"Thorsten","key":"quandtpau","last":"Quandt","name":"Quandt, Thorsten","rank":31,"rolecode":"pau"},{"affno":"38","corresponding":null,"first":"Adriano","key":"schimmentipau","last":"Schimmenti","name":"Schimmenti, Adriano","rank":32,"rolecode":"pau"},{"affno":"39","corresponding":null,"first":"Vladan","key":"starcevicpau","last":"Starcevic","name":"Starcevic, Vladan","rank":33,"rolecode":"pau"},{"affno":"34","corresponding":null,"first":"Gabrielle","key":"stutmanpau","last":"Stutman","name":"Stutman, Gabrielle","rank":34,"rolecode":"pau"},{"affno":"11 12","corresponding":null,"first":"Nigel E","key":"turnerpau","last":"Turner","name":"Turner, Nigel E","rank":35,"rolecode":"pau"},{"affno":"40","corresponding":null,"first":"Jan","key":"vanlooypau","last":"van Looy","name":"van Looy, Jan","rank":36,"rolecode":"pau"},{"affno":"33","corresponding":null,"first":"Andrew K","key":"przybylskipau","last":"Przybylski","name":"Przybylski, Andrew K","rank":37,"rolecode":"pau"}],"pmid":["29529886"],"pub":{"doi":"10.1556/2006.7.2018.19","issn":["20625871","20635303"],"issn_org":["20625871"],"issue":"1","journal":"Journal of Behavioral Addictions","pages":"1-9","publisher":"Akadémiai Kiadó","status":"p","title":"Journal of Behavioral Addictions","volume":"7"},"review":"Peer Reviewed","scoID":["2-s2.0-85045391593"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Miscellaneous","Other Research","Roskilde University","Universities"],"PST":["Published"]},"sid":["au-9a4302e5-3042-4365-8051-e697ebb3474f","itu-19590e84-65a0-4d1a-8408-55ac89d813b9","ruc-45e1adc1-cf2f-462e-a55b-5a0384ba77a8"],"src":["AU Aarhus University","ITU IT University of Copenhagen","RUC Roskilde University"],"title":"A weak scientific basis for gaming disorder : Let us err on the side of caution","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-093.62-023901","year":"2018","yearsub":"2018"}
{"abstract":"Policy makers and some scholars have expressed concerns regarding potential links between youth viewing smoking in movies and smoking in real life. Some advocacy groups have expressed the view that causal links between movie smoking and youth smoking definitively exist. However, research on actual smoking behaviors is relatively narrow, correlational, and tend to produce very small effect sizes. The current paper reviews the methodology of movie smoking studies and analyzes their results meta-analytically. A total of twelve independent data-sets were analyzed which involved youth smoking behaviors as outcome (total participants = 70,788). Meta-analytic results suggested that, due to the large sample size of most studies, results often achieved “statistical significance” despite producing trivial effect sizes. Further, even these trivial effects may be due to widespread methodological limitations including demand characteristics and potential researcher expectancy effects. Recommendations are made for improving this research field.","author_count":3,"contributors":["Ferguson, Christopher","Nielsen, Rune Kristian Lundedal","Markey, Patrick"],"cuid":["S01-000.00-383420"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Stetson University","Villanova University"],"keyword":["Adolescents","Mass Media","Movies","Smoking"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"movie smoking and teen smoking behavior a critical methodological and meta analytic review","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84088593/Ferguson_C._J._Nielsen_R._K._Markey_P._2018_._Movie_smoking_and_teen_smoking_behavior_A_critical_methodological_and_meta_analytic_review._Psychology_of_Popular_Media_Culture._Accepted_author_manuscript_.pdf","version":"Authors Final Version"},"id":"S01-000.00-383420","identifier":[{"id":"85055993244","type":"scopus"}],"ids":["itu-92aba582-bacb-4e3f-a1a8-c99f5def546d"],"keyword":["Adolescents","Mass Media","Movies","Smoking"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-418F6FA1784676512F42D8B5401BE217"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84088593/Ferguson_C._J._Nielsen_R._K._Markey_P._2018_._Movie_smoking_and_teen_smoking_behavior_A_critical_methodological_and_meta_analytic_review._Psychology_of_Popular_Media_Culture._Accepted_author_manuscript_.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","country":"us","key":"stetson university","loc":["United States","America, North","OECD"],"name":"Stetson University","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Play, Culture, and AI, Games Research Group"],"nora_code":"DI-U-ITU","used":1},{"affno":"3","country":"us","key":"villanova university","loc":["United States","America, North","OECD"],"name":"Villanova University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Christopher","key":"fergusonpau","last":"Ferguson","name":"Ferguson, Christopher","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Rune Kristian Lundedal","key":"nielsenpau","last":"Nielsen","locid":"80784458-06f6-4eff-b0c8-df982ffa9835","name":"Nielsen, Rune Kristian Lundedal","orcid":"0000-0002-7209-9041","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Patrick","key":"markeypau","last":"Markey","name":"Markey, Patrick","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1037/ppm0000212","issn":["21604134","21604142"],"issn_org":["21604134"],"journal":"Psychology of Popular Media Culture","publisher":"American Psychological Association","status":"p","title":"Psychology of Popular Media Culture"},"review":"Peer Reviewed","scoID":["2-s2.0-85110556667"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-92aba582-bacb-4e3f-a1a8-c99f5def546d"],"src":["ITU IT University of Copenhagen"],"title":"Movie Smoking and Teen Smoking Behavior : A Critical Methodological and Meta-Analytic Review","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383420","year":"2018","yearsub":"2018"}
{"abstract":"Digital technologies, including video games, are the cause of much concern and much optimism. Many parents are concerned by reports in the popular press about the concept of video game addiction. This chapter aims to critically examine some of the most prolific concerns surrounding the concept of video game addiction and provide a discussion of the science behind such concerns. Among the concerns discussed in this chapter are (1) the idea that increasing amount of time spent playing is a symptom of addiction, (2) the notion that video games are forms of digital substances akin to cocaine or heroin, (3) the concern that Internet descriptions of symptoms can be used for diagnostic purposes, and 4) the concern that video games necessarily have negative consequences. We argue that the term “addiction” is not well suited to describe children’s involvement with digital media.","author_count":3,"contributors":["Nielsen, Rune Kristian Lundedal","Kardefelt-Winther, Daniel"],"cuid":["S01-000.00-383502"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Sweden"],"glorg":["All Global Affiliations","Karolinska Institutet"],"keyword":["Addiction Symptoms","Digital media","Digital technologies","Parental Concerns","Video game addiction"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"helping parents make sense of video game addiction","src":["itu"],"src-code":["DI-U-ITU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83434220/Nielsen_R._K._L._Kardefelt_Winther_D._2018_._Helping_Parents_Make_Sense_of_Video_Game_Addiction._In_C._J._Ferguson_Ed._Video_Game_Influences_on_Aggression_Cognition_and_Attention_Final_author_accepted_version_pre_print.pdf","version":"Pre-print"},"id":"S01-000.00-383502","identifier":[{"id":"85063193980","type":"scopus"}],"ids":["itu-982e32c4-0a45-43b7-81b8-f7f1df4bf594"],"keyword":["Addiction Symptoms","Digital Media","Digital Technologies","Parental Concerns","Video Game Addiction"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-B284184D47EE947FD90EA3B154BE0432"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83434220/Nielsen_R._K._L._Kardefelt_Winther_D._2018_._Helping_Parents_Make_Sense_of_Video_Game_Addiction._In_C._J._Ferguson_Ed._Video_Game_Influences_on_Aggression_Cognition_and_Attention_Final_author_accepted_version_pre_print.pdf","version":"Pre-print"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Play, Culture, and AI, Games Research Group"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"se","key":"karolinska institutet","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Karolinska Institutet","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Rune Kristian Lundedal","key":"nielsenpau","last":"Nielsen","locid":"80784458-06f6-4eff-b0c8-df982ffa9835","name":"Nielsen, Rune Kristian Lundedal","orcid":"0000-0002-7209-9041","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Daniel","key":"kardefeltwintherpau","last":"Kardefelt-Winther","name":"Kardefelt-Winther, Daniel","rank":2,"rolecode":"pau"},{"affno":"","first":"Christopher","key":"fergusonpedh","last":"Ferguson","name":"Ferguson, Christopher","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-319-95495-0_5","eisbn":["9783319954950"],"isbn":["9783319954943"],"pages":"59-69","place":"Cham, Switzerland","publisher":"Springer","status":"p","title":"Video Game Influences on Aggression, Cognition, and Attention"},"review":"Peer Reviewed","scoID":["2-s2.0-85063193980"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-982e32c4-0a45-43b7-81b8-f7f1df4bf594"],"src":["ITU IT University of Copenhagen"],"title":"Helping Parents Make Sense of Video Game Addiction","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383502","year":"2018","yearsub":"2018"}
{"abstract":"In this paper we investigate the phenomenon colloquially known as “loot boxes” or “loot crates”. Loot boxes became a hot topic towards the end of 2017 when several legislative bodies proposed that they were essentially gambling mechanisms and should therefore be legislated as such. We argue that the term “loot box” and the phenomena it covers are not sufficiently precise for academic use and instead introduce the notion of “random reward mechanisms” (RRMs). We offer a categorization of RRMs, which distinguishes between RRMs that are either “isolated” from real world economies or “embedded” in them. This distinction will be useful in discussions about loot boxes in general, but specifically when it comes to the question of whether or not they represent instances of gambling. We argue that all classes of RRMs have gambling-like features, but that only one class can be considered to be genuine gambling.","author_count":2,"contributors":["Nielsen, Rune Kristian Lundedal","Grabarczyk, Pawel"],"cuid":["S01-000.00-677334"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Addiction","Classification","Gambling","Gaming","Internet gaming disorder","Loot boxes","Taxonomy","loot crates","random reward mechanisms"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"are loot boxes gambling random reward mechanisms in video games","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83333144/DIGRA_2018_Are_loot_boxes_gambling_pre_print_21.05.2018.pdf","version":"Other Version"},"id":"S01-000.00-677334","ids":["itu-c42f7b9f-2c56-49a7-b3b0-d8eeb6f942f9"],"keyword":["Internet gaming disorder","addiction","classification","gambling","gaming","loot boxes","loot crates","random reward mechanisms","taxonomy"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-40E0411F52B7E0B0FF54D88A03FA483B"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83333144/DIGRA_2018_Are_loot_boxes_gambling_pre_print_21.05.2018.pdf","version":"Other Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Rune Kristian Lundedal","key":"nielsenpau","last":"Nielsen","locid":"80784458-06f6-4eff-b0c8-df982ffa9835","name":"Nielsen, Rune Kristian Lundedal","orcid":"0000-0002-7209-9041","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Pawel","key":"grabarczykpau","last":"Grabarczyk","locid":"42147e05-f94c-471d-a889-c57a01e4bdd0","name":"Grabarczyk, Pawel","orcid":"0000-0002-1268-7474","rank":2,"rolecode":"pau"}],"pub":{"publisher":"Digital Games Research Association","status":"p","subtitle":"The Game is the Message","title":"DiGRA '18 - Proceedings of the 2018 DiGRA International Conference"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-c42f7b9f-2c56-49a7-b3b0-d8eeb6f942f9"],"src":["ITU IT University of Copenhagen"],"title":"Are Loot Boxes Gambling? : Random reward mechanisms in video games","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-677334","year":"2018","yearsub":"2018"}
{"abstract":"This paper attempts to correct common misunderstandings about the correlation between dopamine and pleasure in video games. By extension the paper argues that dopamine is not the cause of pleasure in games and that commonly drawn links between dopamine, games, and addiction are not valid. The paper further presents an auto-ethnographic account of Pokémon GO in order to provide an alternative perspective on why the game was so successful.","author_count":2,"contributors":["Nielsen, Rune Kristian Lundedal","Blom, Johanna"],"cuid":["S01-000.00-383475"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Addiction","Dopamine","Pokemon Go"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"crimes against pokémon go why dopamine does not explain the pleasure of video games","src":["itu"],"src-code":["DI-U-ITU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://digra2017.com/static/Extended%20Abstracts/108_DIGRA2017_EA_Nielsen_PokemonGo.pdf","version":"Other Version"},"id":"S01-000.00-383475","ids":["itu-968be703-79ab-473c-b5c1-4f2c34f1a1d7"],"keyword":["Addiction","Dopamine","Pokemon Go"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-6DE779A94B08370B4E5F0AE4EEE6177F"],"oa_link":[{"access":"oa","type":"rem","url":"http://digra2017.com/static/Extended%20Abstracts/108_DIGRA2017_EA_Nielsen_PokemonGo.pdf","version":"Other Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Play, Culture, and AI, Games Research Group"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Rune Kristian Lundedal","key":"nielsenpau","last":"Nielsen","locid":"80784458-06f6-4eff-b0c8-df982ffa9835","name":"Nielsen, Rune Kristian Lundedal","orcid":"0000-0002-7209-9041","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Johanna","key":"blompau","last":"Blom","name":"Blom, Johanna","rank":2,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-968be703-79ab-473c-b5c1-4f2c34f1a1d7"],"src":["ITU IT University of Copenhagen"],"title":"Crimes Against Pokémon GO : why dopamine does not explain the pleasure of video games","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383475","year":"2017","yearsub":"2017"}
{"abstract":"Whether or not gaming causes addiction continues to be debated in the scholarly literature. The American Psychiatric Association has proposed \"Internet gaming disorder,\" a non-substance addictive disorder, in order to encourage further research on the subject. We suggest that competitive gaming, better known as esports, might provide a unique platform on which to discuss the validity of the proposed disorder.","author_count":2,"contributors":["Nielsen, Rune Kristian Lundedal","Karhulahti, Veli-Matti"],"cuid":["S01-000.00-382332"],"event":{"acronym":"FGD(?)","title":"Foundations of Digital Games"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Finland"],"glorg":["All Global Affiliations","University of Turku"],"keyword":["Esports","Game addiction","Internet gaming disorder","excessive gaming"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"the problematic coexistence of internet gaming disorder and esports","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82428866/Nielsen_R._K._L._Karhulahti_V._M._2017_._The_Problematic_Coexistence_of_Internet_Gaming_Disorder_and_Esports.pdf","version":"Published Version"},"id":"S01-000.00-382332","identifier":[{"id":"85030761864","type":"scopus"}],"ids":["itu-4754f02e-92da-4a3d-8002-af360a977362"],"keyword":["Internet gaming disorder","esports","excessive gaming","game addiction"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-C47953DD1A960C1B539AB22E821B9131"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82428866/Nielsen_R._K._L._Karhulahti_V._M._2017_._The_Problematic_Coexistence_of_Internet_Gaming_Disorder_and_Esports.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Play, Culture, and AI, Games Research Group"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"fi","key":"university of turku","loc":["Finland","Europe, EU","Nordic","OECD"],"name":"University of Turku","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Rune Kristian Lundedal","key":"nielsenpau","last":"Nielsen","locid":"80784458-06f6-4eff-b0c8-df982ffa9835","name":"Nielsen, Rune Kristian Lundedal","orcid":"0000-0002-7209-9041","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Veli-Matti","key":"karhulahtipau","last":"Karhulahti","name":"Karhulahti, Veli-Matti","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1145/3102071.3106359","isbn":["9781450353199"],"publisher":"Association for Computing Machinery","status":"p","title":"FDG '17 Proceedings of the 12th International Conference on the Foundations of Digital Games"},"review":"Peer Reviewed","scoID":["2-s2.0-85030761864"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-4754f02e-92da-4a3d-8002-af360a977362"],"src":["ITU IT University of Copenhagen"],"title":"The problematic coexistence of \"internet gaming disorder\" and esports","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382332","year":"2017","yearsub":"2017"}
{"abstract":"With proposals to include “gaming disorder” in both the Diagnostic and Statistical Manual (DSM) and International Compendium of Diseases (ICD), the concept of video game addiction has gained traction. However, many aspects of this concept remain controversial. At present, little clarity has been achieved regarding diagnostic criteria and appropriate symptoms. It is unclear if symptoms that involve problematic video gaming behavior should be reified as a new disorder, or are the expression of underlying mental conditions. Nonetheless, the recent proposals around gaming disorder from respected bodies such as the World Health Organization and the American Psychiatric Association seem to lock much of the applied research into a confirmatory trajectory. Since the DSM–5 proposal, research is increasingly focused on the application of the proposed criteria, as opposed to broadly testing validity and necessity of the overarching construct. This raises multiple concerns. First, the current approaches to understanding “gaming addiction” are rooted in substance abuse research and approaches do not necessarily translate to media consumption. Second, some research has indicated that “video game addiction” is not a stable construct and clinical impairment might be low. Third, pathologizing gaming behavior has fallout beyond the therapeutic setting. In light of continuing controversies, it is argued that the currently proposed categories of video game addiction disorders are premature.","author_count":4,"contributors":["Nielsen, Rune Kristian Lundedal","Ferguson, Christopher","Bean, Anthony","van Rooij, Antonius"],"cuid":["S01-000.00-382885"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","Europe, EU","OECD"],"country":["Belgium","United States"],"glorg":["All Global Affiliations","Framingham State University","Stetson University","imec-MICT-Ghent University"],"keyword":["Diagnostic criteria","Gaming disorder","Mental health","Video game addiction","pathologizing behavior"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"video game addiction the push to pathologize video games","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82428906/Bean_Nielsen_van_Rooij_Ferguson_pre_print_Video_Game_Addiction_The_Push_To_Pathologize_Video_Games.pdf","version":"Pre-print"},"id":"S01-000.00-382885","identifier":[{"id":"85021796909","type":"scopus"}],"ids":["itu-6ca9575e-eee8-4d18-abcb-ef3c5903e1b3"],"keyword":["diagnostic criteria","gaming disorder","mental health","pathologizing behavior","video game addiction"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-F2DF39AE05CE44ED6B1641EC25013525"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82428906/Bean_Nielsen_van_Rooij_Ferguson_pre_print_Video_Game_Addiction_The_Push_To_Pathologize_Video_Games.pdf","version":"Pre-print"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Play, Culture, and AI, Games Research Group"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"us","key":"stetson university","loc":["United States","America, North","OECD"],"name":"Stetson University","used":1},{"affno":"3","country":"us","key":"framingham state university","loc":["United States","America, North","OECD"],"name":"Framingham State University","used":1},{"affno":"4","country":"be","key":"imec mict ghent university","loc":["Belgium","Europe, EU","OECD"],"name":"imec-MICT-Ghent University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Rune Kristian Lundedal","key":"nielsenpau","last":"Nielsen","locid":"80784458-06f6-4eff-b0c8-df982ffa9835","name":"Nielsen, Rune Kristian Lundedal","orcid":"0000-0002-7209-9041","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Christopher","key":"fergusonpau","last":"Ferguson","name":"Ferguson, Christopher","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Anthony","key":"beanpau","last":"Bean","name":"Bean, Anthony","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Antonius","key":"vanrooijpau","last":"van Rooij","name":"van Rooij, Antonius","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1037/pro0000150","issn":["07357028","19391323"],"issn_org":["07357028"],"issue":"5","journal":"Professional Psychology: Research and Practice","pages":"378-389","publisher":"American Psychological Association","status":"p","title":"Professional Psychology: Research and Practice","volume":"48"},"review":"Peer Reviewed","scoID":["2-s2.0-85021796909"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-6ca9575e-eee8-4d18-abcb-ef3c5903e1b3"],"src":["ITU IT University of Copenhagen"],"title":"Video game addiction: The push to pathologize video games","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382885","year":"2017","yearsub":"2017"}
{"abstract":"This Ph.D. dissertation critically examines the concept of \"video game addiction\" and the science behind the proposal that the disorder should be officially recognized as a mental disorder called \"Internet gaming disorder.\" Chapter One gives a short introduction to the history of the word \"addiction\" and describes how gambling disorder (the only officially recognized behavioral addiction) came to be defined as an addiction. Chapter 2 will take a look at the negative consequences of video game play that are most commonly cited in the literature on game addiction. This review will show how researchers' claims of negative effects caused by video game playing are wildly exaggerated. Chapter 3 adds a short review of what is sometimes cited as historical precursors to Internet gaming disorder and argue that these are, in fact, not examples of addictions. Chapter 4 will analyze the diagnostic criteria that make up \"Internet Gaming Disorder\" and provide some theoretical concerns about their validity. Chapter 5 is a qualitative study of the experiences and opinions of a small group of players who might wrongly be labeled as \"video game addicts.\" Chapter 6 is a case study of the unfortunate outcomes that may arise when anxiety is misdiagnosed as \"video game addiction.\" Chapter 7 reviews the argument that video games are addictive due to the neurochemical effects they produce in the brain. Chapter 8 draws on anthropological psychiatry and discusses the different cultural contexts in which \"video game addiction\" exists. The chapter highlights potential problems that arise when psychiatric disorders are transferred across cultures. The dissertation concludes that there is insufficient scientific evidence to support the notion that \"Internet gaming disorder\" is an addictive disorder.","author_count":1,"contributors":["Nielsen, Rune Kristian Lundedal"],"cuid":["S01-000.00-382344"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"und","rtype":["clu"],"sorti":"is game addiction a mental disorder a dissertation on the history and science of the concept of internet gaming disorder","src":["itu"],"src-code":["DI-U-ITU"],"type":"do","type-grp":["all","pub"]},"id":"S01-000.00-382344","ids":["itu-481739c3-84e0-43d2-8010-8b19f9311185"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-6E60E3C2D79AC15250C66385D7B33A55"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Play, Culture, and AI, Games Research Group","The Department, TiP and Games Section"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Rune Kristian Lundedal","key":"nielsenpau","last":"Nielsen","locid":"80784458-06f6-4eff-b0c8-df982ffa9835","name":"Nielsen, Rune Kristian Lundedal","orcid":"0000-0002-7209-9041","rank":1,"rolecode":"pau"}],"pub":{"isbn":["9788779493490"],"issn":["16023536"],"issue":"131","pages":"295","publisher":"IT-Universitetet i København","series":"ITU-DS","status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-481739c3-84e0-43d2-8010-8b19f9311185"],"src":["ITU IT University of Copenhagen"],"title":"Is game addiction a mental disorder? : A dissertation on the history and science of the concept of Internet gaming disorder","type":"Other","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382344","year":"2017","yearsub":"2017"}
{"abstract":"Concerns about problematic gaming behaviors deserve our full attention. However, we claim that it is far from clear that these problems can or should be attributed to a new disorder. The empirical basis for a Gaming Disorder proposal, such as in the new ICD-11, suffers from fundamental issues. Our main concerns are the low quality of the research base, the fact that the current operationalization leans too heavily on substance use and gambling criteria, and the lack of consensus on symptomatology and assessment of problematic gaming. The act of formalizing this disorder, even as a proposal, has negative medical, scientific, public-health, societal, and human rights fallout that should be considered. Of particular concern are moral panics around the harm of video gaming. They might result in premature application of diagnosis in the medical community and the treatment of abundant false-positive cases, especially for children and adolescents. Second, research will be locked into a confirmatory approach, rather than an exploration of the boundaries of normal versus pathological. Third, the healthy majority of gamers will be affected negatively. We expect that the premature inclusion of Gaming Disorder as a diagnosis in ICD-11 will cause significant stigma to the millions of children who play video games as a part of a normal, healthy life. At this point, suggesting formal diagnoses and categories is premature: the ICD-11 proposal for Gaming Disorder should be removed to avoid a waste of public health resources as well as to avoid causing harm to healthy video gamers around the world.","author_count":26,"contributors":["Aarseth, Espen","Bean, Anthony","Nielsen, Rune Kristian Lundedal","Boon, Huub","Carras, Michelle","Coulson, Mark","Das, Dimitri","Deleuze, Jory","Dunkels, Elza","Edman, Johan","Ferguson, Chris","Haagsma, Maria","Bergmark, Karin","Hussain, Zaheer","Jansz, Jeroen","Kardefelt-Winther, Daniel","Kutner, Lawrence","Markey, Patrick","Prause, Nicole","Przybylski, Andrew","Quandt, Thorsten","Schimmenti, Adriano","Starcevic, Vladan","Stutman, Gabrielle","van Looy, Jan","van Rooij, Antonius"],"cuid":["S01-000.00-382536"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Europe, EU","Europe, Non-EU","Nordic","OECD","Oceania"],"country":["Australia","Belgium","Germany","Italy","Netherlands","Sweden","United Kingdom","United States"],"glorg":["All Global Affiliations","CAD Limburg","Erasmus University Rotterdam","Framingham State University","GGZ Momentum","Johns Hopkins University","Karolinska Institutet","Kore University of Enna","Liberos LLC","Middlesex University","Stetson University","Stockholm University","The University of Sydney","UC Leuven-Limburg","Umeå University","University of Derby","University of Münster","University of Oxford","Université catholique de Louvain","Villanova University","imec-MICT-Ghent University"],"keyword":["Children and Adolescents in Gaming","Diagnosis and Symptomatology","False Positive Diagnoses","Gaming Disorder Proposal","ICD 11","Moral Panics in Gaming","Problematic Gaming Behaviors","Public Health Implications","Substance Use and Gambling Criteria","Video Gaming Stigma"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"nr","rtype":["clu"],"sorti":"scholars open debate paper on the world health organization icd 000000000011 gaming disorder proposal","src":["itu"],"src-code":["DI-U-ITU"],"type":"djc","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1556/2006.5.2016.088","version":"Published Version"},"id":"S01-000.00-382536","identifier":[{"id":"85031668702","type":"scopus"}],"ids":["itu-54c040e5-4b5a-4d19-8625-0b715b5c204f"],"keyword":["Children and Adolescents in Gaming","Diagnosis and Symptomatology","False-Positive 