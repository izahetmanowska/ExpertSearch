rank":8,"rolecode":"pau"},{"affno":"","first":"Michael A.","key":"benderpedh","last":"Bender","name":"Bender, Michael A.","rank":9,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Ola","key":"svenssonpedh","last":"Svensson","name":"Svensson, Ola","rank":10,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Grzegorz","key":"hermanpedh","last":"Herman","name":"Herman, Grzegorz","rank":11,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.4230/lipics.esa.2019.2","eisbn":["9783959771245"],"issn":["18688969"],"publisher":"Schloss Dagstuhl- Leibniz-Zentrum fur Informatik GmbH, Dagstuhl Publishing","series":"Leibniz International Proceedings in Informatics, LIPIcs","status":"p","title":"Proceedings of 27th Annual European Symposium on Algorithms, ESA 2019"},"review":"Peer Reviewed","scoID":["2-s2.0-85074867612"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-f0ddc06c-5660-446d-847b-a1072d9cc0cd","itu-dce87c22-5b0e-4126-8548-dde5f57b98c7","sdu-1cab1b10-ec5f-4b28-80eb-0046fb04fb79"],"src":["AU Aarhus University","ITU IT University of Copenhagen","SDU University of Southern Denmark"],"title":"Fragile Complexity of Comparison-Based Algorithms","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-095.83-030108","year":"2019","yearsub":"2019"}
{"abstract":"We present priority queues in the external memory model with block size $B$ and main memory size $M$ that support on $N$ elements, operation Update (a combination of operations Insert and Decrease-Key) in $O\\left( \\frac{1}{B}\\log_{\\frac{M}{B}} \\frac{N}{B}\\right)$ amortized I/Os and operations Extract-Min and Delete in $O\\left( \\lceil \\frac{M^{\\varepsilon}}{B} \\log_{\\frac{M}{B}} \\frac{N}{B} \\rceil \\log_{\\frac{M}{B}} \\frac{N}{B}\\right)$ amortized I/Os, for any real $\\varepsilon \\in \\left(0,1\\right)$, using $O\\left( \\frac{N}{B}\\log_{\\frac{M}{B}} \\frac{N}{B}\\right)$ blocks. Previous I/O-efficient priority queues either support these operations in $O\\left(\\frac{1}{B}\\log_2 \\frac{N}{B}\\right)$ amortized I/Os [Kumar and Schwabe, SPDP '96] or support only operations Insert, Delete and Extract-Min in optimal $O\\left( \\frac{1}{B}\\log_{\\frac{M}{B}} \\frac{N}{B}\\right) $ amortized I/Os, however without supporting Decrease-Key [Fadel et al., TCS '99]. We also present buffered repository trees that support on a multi-set of $N$ elements, operation Insert in $O\\left(\\frac{1}{B}\\log_{\\frac{M}{B}} \\frac{N}{B}\\right)$ I/Os and operation Extract on $K$ extracted elements in $O\\left( M^{\\varepsilon}\\log_{\\frac{M}{B}} \\frac{N}{B} + K/B\\right)$ amortized I/Os, using $O \\left(\\frac{N}{B}\\right)$ blocks. Previous results achieve $O\\left(\\frac{1}{B}\\log_2 \\frac{N}{B}\\right)$ I/Os and $O\\left( \\log_2 \\frac{N}{B} + \\frac{K}{B}\\right)$ I/Os, respectively [Buchsbaum et al., SODA '00]. Our results imply improved $O\\left(\\frac{E}{B}\\log_{\\frac{M}{B}} \\frac{E}{B}\\right)$ I/Os for single-source shortest paths, depth-first search and breadth-first search algorithms on massive directed dense graphs $\\left(V,E\\right)$ with $E = \\Omega \\left( V^{1+\\varepsilon}\\right), \\varepsilon > 0$ and $V = \\Omega \\left( M \\right)$, which is equal to the I/O-optimal bound for sorting $E$ values in external memory.","author_count":3,"contributors":["Iacono, John","Jacob, Riko","Tsakalidis, Konstantinos"],"cuid":["S01-000.00-384953"],"event":{"acronym":"ESA","title":"European Symposium on Algorithms"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","OECD"],"country":["Belgium","United Kingdom"],"glorg":["All Global Affiliations","University Libre du Bruxelles","University of Liverpool"],"keyword":["Buffered Repository Trees","External Memory Model","Graph algorithms","I O algorithms","Priority queues"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"external memory priority queues with decrease key and applications to graph algorithms","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.4230/LIPIcs.ESA.2019.60","version":"Published Version"},"id":"S01-000.00-384953","identifier":[{"id":"85074817275","type":"scopus"}],"ids":["itu-fa77121a-62f8-4a5e-85fc-48bb84fb978b"],"keyword":["Buffered Repository Trees","External Memory Model","Graph Algorithms","I/O Algorithms","Priority Queues"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-F50670308BF46C32FD73B029A924FE78"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.4230/LIPIcs.ESA.2019.60","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/84740719/LIPIcs_ESA_2019_60.pdf","version":"Other Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","country":"be","key":"university libre du bruxelles","loc":["Belgium","Europe, EU","OECD"],"name":"University Libre du Bruxelles","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, Machine Learning","IT University of Copenhagen, Theoretical Computer Science, Algorithms"],"nora_code":"DI-U-ITU","used":1},{"affno":"3","country":"gb","key":"university of liverpool","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Liverpool","used":1}],"person":[{"affno":"1","corresponding":null,"first":"John","key":"iaconopau","last":"Iacono","name":"Iacono, John","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Riko","key":"jacobpau","last":"Jacob","locid":"e6f70fb0-caf1-4736-b583-b0777bc1390f","name":"Jacob, Riko","orcid":"0000-0001-9470-1809","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Konstantinos","key":"tsakalidispau","last":"Tsakalidis","name":"Tsakalidis, Konstantinos","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.4230/lipics.esa.2019.60","issn":["18688969"],"journal":"Leibniz International Proceedings in Informatics","paperid":"60","publisher":"Schloss Dagstuhl - Leibniz-Zentrum fuer Informatik GmbH","status":"p","title":"Leibniz International Proceedings in Informatics"},"review":"Peer Reviewed","scoID":["2-s2.0-85074817275"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-fa77121a-62f8-4a5e-85fc-48bb84fb978b"],"src":["ITU IT University of Copenhagen"],"title":"External memory priority queues with decrease-key and applications to graph algorithms","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384953","year":"2019","yearsub":"2019"}
{"abstract":"In this article, we determine the amortized computational complexity of the planar dynamic convex hull problem by querying. We present a data structure that maintains a set of n points in the plane under the insertion and deletion of points in amortized O(log n) time per operation. The space usage of the data structure is O(n). The data structure supports extreme point queries in a given direction, tangent queries through a given point, and queries for the neighboring points on the convex hull in O(log n) time. The extreme point queries can be used to decide whether or not a given line intersects the convex hull, and the tangent queries to determine whether a given point is inside the convex hull. We give a lower bound on the amortized asymptotic time complexity that matches the performance of this data structure.","author_count":2,"contributors":["Jacob, Riko","Brodal, Gerth"],"cuid":["S01-000.00-382649"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Amortized computational complexity","Asymptotic time complexity","Data structures","Extreme point queries","Planar dynamic convex hull"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-ITU"]},"level3all":["DI-U-AU","DI-U-ITU"]},"review":"nr","rtype":["clu"],"sorti":"dynamic planar convex hull","src":["itu"],"src-code":["DI-U-ITU"],"type":"dw","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Andet","type":"doi","url":"https://doi.org/arXiv:1902.11169","version":"Published Version"},"id":"S01-000.00-382649","identifier":[{"id":"85094052188","type":"scopus"}],"ids":["itu-5c572d41-079a-46e5-a3cb-cd9be64b4c6f"],"keyword":["Amortized computational complexity","Asymptotic time complexity","Data structures","Extreme point queries","Planar dynamic convex hull"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-978132D5F3D5B24AE39538D7EC2F6C0A"],"oa_link":[{"access":"oa","license":"Andet","type":"doi","url":"https://doi.org/arXiv:1902.11169","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Information Security and Trust","IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, Machine Learning","IT University of Copenhagen, Theoretical Computer Science, Algorithms"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Riko","key":"jacobpau","last":"Jacob","locid":"e6f70fb0-caf1-4736-b583-b0777bc1390f","name":"Jacob, Riko","orcid":"0000-0001-9470-1809","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Gerth","key":"brodalpau","last":"Brodal","name":"Brodal, Gerth","rank":2,"rolecode":"pau"}],"pub":{"pages":"87","status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-5c572d41-079a-46e5-a3cb-cd9be64b4c6f"],"src":["ITU IT University of Copenhagen"],"title":"Dynamic Planar Convex Hull","type":"Working Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382649","year":"2019","yearsub":"2019"}
{"abstract":"An oblivious data structure is a data structure where the memory access patterns reveals no information about the operations performed on it. Such data structures were introduced by Wang et al. [ACM SIGSAC’14] and are intended for situations where one wishes to store the data structure at an untrusted server. One way to obtain an oblivious data structure is simply to run a classic data structure on an oblivious RAM (ORAM). Until very recently, this resulted in an overhead of ω(lg n) for the most natural setting of parameters. Moreover, a recent lower bound for ORAMs by Larsen and Nielsen [CRYPTO’18] show that they always incur an overhead of at least Ω(lg n) if used in a black box manner. To circumvent the ω(lg n) overhead, researchers have instead studied classic data structure problems more directly and have obtained efficient solutions for many such problems such as stacks, queues, deques, priority queues and search trees. However, none of these data structures process operations faster than Θ(lg n), leaving open the question of whether even faster solutions exist. In this paper, we rule out this possibility by proving Ω(lg n) lower bounds for oblivious stacks, queues, deques, priority queues and search trees.","author_count":4,"contributors":["Jacob, Riko","Larsen, Kasper Green","Nielsen, Jesper Buus"],"cuid":["S02-090.00-020238"],"event":{"acronym":"SODA","end":"2019-01-09","place":"San Diego, us","start":"2019-01-06","title":"Thirtieth Annual ACM-SIAM Symposium on Discrete Algorithms","year":"2019"},"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Data structure lower bounds","Memory access patterns","Oblivious RAM ORAM","Oblivious data structures","Untrusted servers"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-ITU"]},"level3all":["DI-U-AU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"lower bounds for oblivious data structures","src":["au","itu"],"src-code":["DI-U-AU","DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1137/1.9781611975482.149","version":"Published Version"},"id":"S02-090.00-020238","identifier":[{"id":"85066934958","type":"scopus"}],"ids":["au-68102b8b-3220-4def-8d7c-98dc32d32c7e","itu-5f0a648c-07e3-4728-afd7-db539373117a"],"keyword":["Data structure lower bounds","Memory access patterns","Oblivious RAM (ORAM)","Oblivious data structures","Untrusted servers"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-4058ED52A73D982995135D5E892B44BF"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1137/1.9781611975482.149","version":"Published Version"},{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84740929/1810.10635.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Information Security and Trust","IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, Machine Learning","IT University of Copenhagen, Theoretical Computer Science, Algorithms"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Computer Science"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Riko","key":"jacobpau","last":"Jacob","locid":"e6f70fb0-caf1-4736-b583-b0777bc1390f","name":"Jacob, Riko","orcid":"0000-0001-9470-1809","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Kasper Green","key":"larsenpau","last":"Larsen","locid":"13372598-332d-42b0-b510-3b70fefb0465","name":"Larsen, Kasper Green","orcid":"0000-0001-8841-5929","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jesper Buus","key":"nielsenpau","last":"Nielsen","locid":"f428c4b3-80b3-403a-ada6-9ecb0fad97b2","name":"Nielsen, Jesper Buus","rank":3,"rolecode":"pau"},{"affno":"","first":"Timothy M.","key":"chanpedh","last":"Chan","name":"Chan, Timothy M.","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1137/1.9781611975482.149","eisbn":["9781611975482"],"pages":"2439-2447","publisher":"Society for Industrial and Applied Mathematics","series":"Proceedings of the Thirtieth Annual ACM-SIAM Symposium on Discrete Algorithms","status":"p","title":"Proceedings of the Thirtieth Annual ACM-SIAM Symposium on Discrete Algorithms"},"review":"Peer Reviewed","scoID":["2-s2.0-85066934958"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["au-68102b8b-3220-4def-8d7c-98dc32d32c7e","itu-5f0a648c-07e3-4728-afd7-db539373117a"],"src":["AU Aarhus University","ITU IT University of Copenhagen"],"title":"Lower Bounds for Oblivious Data Structures","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-090.00-020238","year":"2019","yearsub":"2019"}
{"abstract":"Modern computer networks support interesting new routing models in which traffic flows from a source s to a destination t can be flexibly steered through a sequence of waypoints, such as (hardware) middleboxes or (virtualized) network functions (VNFs), to create innovative network services like service chains or segment routing. While the benefits and technological challenges of providing such routing models have been articulated and studied intensively over the last years, less is known about the underlying algorithmic traffic routing problems. The goal of this paper is to provide the network community with an overview of algorithmic techniques for waypoint routing and also inform about limitations due to computational hardness. In particular, we put the waypoint routing problem into perspective with respect to classic graph theoretical problems. For example, we find that while computing a shortest path from a source s to a destination t is simple (e.g., using Dijkstra’s algorithm), the problem of finding a shortest route from s to t via a single waypoint already features a deep combinatorial structure.","author_count":5,"contributors":["Amiri, Saeed Akhoondian","Foerster, Klaus Tycho","Jacob, Riko","Schmid, Stefan"],"cuid":["S02-088.24-000574"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD"],"country":["Austria","Germany"],"glorg":["All Global Affiliations","MPI Saarland","Technical University of Berlin","University of Vienna"],"keyword":["Algorithmic Traffic Routing","Algorithms","Complexity","Computational Hardness","Graph theory","Network Functions Virtualization NFV","Waypoint Routing","Waypoints"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-AAU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"charting the algorithmic complexity of waypoint routing","src":["aau","itu"],"src-code":["DI-U-AAU","DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83747639/1705.00055.pdf","version":"Authors Final Version"},"funding_acknowledgement":["We hope that our paper can provide the network community with algorithmic techniques but also inform about complexity bounds. In future research, it would be interesting to study a generalization to practically relevant scenarios in which waypoint placement is also subject to optimization or in which waypoints may be replicated for load balancing purposes. Moreover, more research is required on how to extend existing e cient tra c engineering heuristics to account for waypoint requirements. Acknowledgments. We thank Thore Husfeldt for inputs. Research supported by the Villum project ReNet and Aalborg University’s PreLytics project. Saeed Amiri’s research was partly supported by the European Research Council (ERC) grant agreement No 648527."],"id":"S02-088.24-000574","identifier":[{"id":"85047339336","type":"scopus"}],"ids":["aau-0ae6421e-22db-4439-af71-dc257f3efeb6","itu-b9648c71-598f-462e-b8bc-6c26a464490c"],"keyword":["Algorithmic Traffic Routing","Algorithms","Complexity","Computational Hardness","Graph Theory","Network Functions Virtualization (NFV)","VNFs","Waypoint Routing","Waypoints"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-D1F20DA015651B47B294E32E04591E1B"],"oa_link":[{"access":"oa","type":"rem","url":"https://arxiv.org/abs/1705.00055","version":"Other Version"},{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83747639/1705.00055.pdf","version":"Authors Final Version"},{"access":"oa","type":"rem","url":"https://arxiv.org/pdf/1705.00055.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","country":"de","key":"mpi saarland","loc":["Germany","Europe, EU","OECD"],"name":"MPI Saarland","used":1},{"affno":"2","country":"de","key":"technical university of berlin","loc":["Germany","Europe, EU","OECD"],"name":"Technical University of Berlin","used":1},{"affno":"3","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, Machine Learning","IT University of Copenhagen, Theoretical Computer Science, Algorithms"],"nora_code":"DI-U-ITU","used":1},{"affno":"4","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Technical Faculty of IT and Design","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science, Distributed, Embedded and Intelligent Systems"],"nora_code":"DI-U-AAU","used":1},{"affno":"5","country":"at","key":"university of vienna","loc":["Austria","Europe, EU","OECD"],"name":"University of Vienna","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Saeed Akhoondian","key":"amiripau","last":"Amiri","name":"Amiri, Saeed Akhoondian","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Saeed","key":"akhoondianamiripau","last":"Akhoondian Amiri","name":"Akhoondian Amiri, Saeed","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Klaus Tycho","key":"foersterpau","last":"Foerster","name":"Foerster, Klaus Tycho","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Riko","key":"jacobpau","last":"Jacob","locid":"e6f70fb0-caf1-4736-b583-b0777bc1390f","name":"Jacob, Riko","orcid":"0000-0001-9470-1809","rank":3,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"country":"dk","first":"Stefan","key":"schmidpau","last":"Schmid","locid":"30b548ef-7f7b-48fe-a0c7-fcb88cac67fa","name":"Schmid, Stefan","orcid":"0000-0002-7798-1711","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1145/3211852.3211859","issn":["01464833","19435819"],"issn_org":["01464833"],"issue":"1","journal":"Computer Communication Review","pages":"42-48","publisher":"Association for Computing Machinery","status":"p","title":"Computer Communication Review","title_org":"Computer Communications Review","volume":"48"},"review":"Peer Reviewed","scoID":["2-s2.0-85047339336"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["aau-0ae6421e-22db-4439-af71-dc257f3efeb6","itu-b9648c71-598f-462e-b8bc-6c26a464490c"],"src":["AAU Aalborg University","ITU IT University of Copenhagen"],"title":"Charting the Algorithmic Complexity of Waypoint Routing","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-088.24-000574","year":"2018","yearsub":"2018"}
{"abstract":"We study the problem of sparse matrix multiplication in theRandom Access Machine and in the Ideal Cache-Oblivious model. Wepresent a simple algorithm that exploits randomization to compute theproduct of two sparse matrices with elements over an arbitrary field. LetA ∈ Fn×n and C ∈ Fn×n be matrices with h nonzero entries in totalfrom a field F. In the RAM model, we are able to compute all the knonzero entries of the product matrix AC ∈ Fn×n using O˜(h + kn)time and O(h) space, where the notation O˜(·) suppresses logarithmicfactors. In the External Memory model, we are able to compute cacheobliviously all the k nonzero entries of the product matrix AC ∈ Fn×nusing O˜(h/B + kn/B) I/Os and O(h) space. In the Parallel ExternalMemory model, we are able to compute all the k nonzero entries ofthe product matrix AC ∈ Fn×n using O˜(h/PB + kn/PB) time andO(h) space, which makes the analysis in the External Memory model aspecial case of Parallel External Memory for P = 1. The guarantees aregiven in terms of the size of the field and by bounding the size of F as|F| > knlog(n2/k) we guarantee an error probability of at most 1/n forcomputing the matrix product.","author_count":2,"contributors":["Dusefante, Matteo","Jacob, Riko"],"cuid":["S01-000.00-383280"],"event":{"acronym":"LATIN","title":"Latin American Theoretical INformatics Symposium"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["External Memory Model","Ideal Cache Oblivious model","Parallel External Memory model","Random Access Machine RAM","Sparse matrix multiplication"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"cache oblivious sparse matrix multiplication","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Andet","type":"loc","url":"https://pure.itu.dk/ws/files/84095176/Dusefante_Jacob2018_Chapter_CacheObliviousSparseMatrixMult.pdf","version":"Published Version"},"id":"S01-000.00-383280","identifier":[{"id":"85045389257","type":"scopus"}],"ids":["itu-89603ca3-5dd0-44ad-8f4a-3481e23b5db0"],"keyword":["External Memory model","Ideal Cache-Oblivious model","Parallel External Memory model","Random Access Machine (RAM)","Sparse matrix multiplication"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-D79CE9FF54A413606E456C8DC161F95D"],"oa_link":[{"access":"oa","license":"Andet","type":"loc","url":"https://pure.itu.dk/ws/files/84095176/Dusefante_Jacob2018_Chapter_CacheObliviousSparseMatrixMult.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Theoretical Computer Science, Algorithms"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Matteo","key":"dusefantepau","last":"Dusefante","name":"Dusefante, Matteo","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Riko","key":"jacobpau","last":"Jacob","locid":"e6f70fb0-caf1-4736-b583-b0777bc1390f","name":"Jacob, Riko","orcid":"0000-0001-9470-1809","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-319-77404-6_32","eisbn":["9783319774046"],"isbn":["9783319774039"],"issn":["03029743"],"pages":"437-447","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","subtitle":"LATIN 2018: Theoretical Informatics","title":"Latin American Symposium on Theoretical Informatics"},"review":"Peer Reviewed","scoID":["2-s2.0-85045389257"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-89603ca3-5dd0-44ad-8f4a-3481e23b5db0"],"src":["ITU IT University of Copenhagen"],"title":"Cache Oblivious Sparse Matrix Multiplication","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383280","year":"2018","yearsub":"2018"}
{"abstract":"Motivated by the asymmetric read and write costs of emerging non-volatile memory technologies, we study lower bounds for the problems of sorting, permuting and multiplying a sparse matrix by a dense vector in the asymmetric external memory model (AEM). Given an AEM with internal (symmetric) memory of size M, transfers between symmetric and asymmetric memory in blocks of size B and the ratio ω between write and read costs, we show Ω(min (N, ωN/B logω M/B N/B) lower bound for the cost of permuting N input elements. This lower bound also applies to the problem of sorting N elements. This proves that the existing sorting algorithms in the AEM model are optimal to within a constant factor for reasonable ranges of parameters N, M, B, and ω. We also show a lower bound of Ω(min {H, ω H/B logω M/B N/ max{δ ,M}}) for the cost of multiplying an N x N matrix with at most H= δ N non-empty entries by a vector with N elements.","author_count":2,"contributors":["Jacob, Riko","Sitchinava, Nodari"],"cuid":["S01-000.00-384725"],"event":{"acronym":"SPAA","title":"ACM Symposium on Parallelism in Algorithms and Architectures"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Asymmetric External Memory AEM","Non volatile memory technologies","Permuting elements complexity","Sorting lower bound","Sparse matrix vector multiplication"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-ITU"]},"level3all":["DI-U-AU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"lower bounds in the asymmetric external memory model","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83025189/AEMspaa17.pdf","version":"Authors Final Version"},"id":"S01-000.00-384725","identifier":[{"id":"85027860615","type":"scopus"}],"ids":["itu-ea4003a3-8c22-4a40-8847-2cd6e2868d9e"],"keyword":["Asymmetric External Memory (AEM)","Non-volatile memory technologies","Permuting elements complexity","Sorting lower bound","Sparse matrix-vector multiplication"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-5E70E749E21E9D5DA757DE4298EF0A01"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.itu.dk/people/rikj/Publications/AEMspaa17.pdf","version":"Authors Final Version"},{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83025189/AEMspaa17.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, Machine Learning","IT University of Copenhagen, Theoretical Computer Science, Algorithms"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Riko","key":"jacobpau","last":"Jacob","locid":"e6f70fb0-caf1-4736-b583-b0777bc1390f","name":"Jacob, Riko","orcid":"0000-0001-9470-1809","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Nodari","key":"sitchinavapau","last":"Sitchinava","name":"Sitchinava, Nodari","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1145/3087556.3087583","isbn":["9781450345934"],"pages":"247-254","publisher":"Association for Computing Machinery","status":"p","title":"SPAA '17 Proceedings of the 29th ACM Symposium on Parallelism in Algorithms and Architectures"},"review":"Peer Reviewed","scoID":["2-s2.0-85027860615"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-ea4003a3-8c22-4a40-8847-2cd6e2868d9e"],"src":["ITU IT University of Copenhagen"],"title":"Lower Bounds in the Asymmetric External Memory Model","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384725","year":"2017","yearsub":"2017"}
{"abstract":"The sparse grid combination technique provides a framework to solve high-dimensional numerical problems with standard solvers by assembling a sparse grid from many coarse and anisotropic full grids called component grids. Hierarchization is one of the most fundamental tasks for sparse grids. It describes the transformation from the nodal basis to the hierarchical basis. In settings where the component grids have to be frequently combined and distributed in a massively parallel compute environment, hierarchization on component grids is relevant to minimize communication overhead. We present a cache-oblivious hierarchization algorithm for component grids of the combination technique. It causes ∣∣Gℓ∣∣⋅(1B+(1M√d)) cache misses under the tall cache assumption M=ω(Bd). Here, Gℓ denotes the component grid, d the dimension, M the size of the cache and B the cache line size. This algorithm decreases the leading term of the cache misses by a factor of d compared to the unidirectional algorithm which is the common standard up to now. The new algorithm is also optimal in the sense that the leading term of the cache misses is reduced to scanning complexity, i.e., every degree of freedom has to be touched once. We also present a variant of the algorithm that causes ∣∣Gℓ∣∣⋅(2B+(1M⋅Bd−2√d−1)) cache misses under the assumption M=ω(B) . The new algorithms have been implemented and outperform previously existing software. In several cases the measured performance is close to the best possible. The dimension d is assumed to be constant in the  -notation.","author_count":2,"contributors":["Hupp, Philipp","Jacob, Riko"],"cuid":["S01-000.00-382878"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["Switzerland"],"glorg":["All Global Affiliations","Swiss Federal Institute of Technology Zürich"],"keyword":["Cache oblivious algorithms","Combination Technique","Hierarchization","High Dimensional Numerical Problems","Sparse Grids"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"a cache optimal alternative to the unidirectional hierarchization algorithm","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82454287/paperSGA2014.pdf","version":"Authors Final Version"},"id":"S01-000.00-382878","identifier":[{"id":"84962491192","type":"scopus"}],"ids":["itu-6c04f647-d91c-4383-88e4-5b8cac5eb957"],"keyword":["Cache-Oblivious Algorithms","Combination Technique","Hierarchization","High-Dimensional Numerical Problems","Sparse Grids"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-F463F66C0DA9B42EF9D82630581D95E4"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82454287/paperSGA2014.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","country":"ch","key":"swiss federal institute of technology zürich","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"Swiss Federal Institute of Technology Zürich","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Theoretical Computer Science, Algorithms","The Department, Theoretical Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Philipp","key":"hupppau","last":"Hupp","name":"Hupp, Philipp","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Riko","key":"jacobpau","last":"Jacob","locid":"e6f70fb0-caf1-4736-b583-b0777bc1390f","name":"Jacob, Riko","orcid":"0000-0001-9470-1809","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-319-28262-6_5","eisbn":["9783319282626"],"isbn":["9783319282602"],"issn":["14397358"],"pages":"103-132","publisher":"Springer","series":"Lecture Notes in Computational Science and Engineering","status":"p","title":"Sparse Grids and Applications - Stuttgart 2014"},"review":"Peer Reviewed","scoID":["2-s2.0-84962491192"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-6c04f647-d91c-4383-88e4-5b8cac5eb957"],"src":["ITU IT University of Copenhagen"],"title":"A Cache-Optimal Alternative to the Unidirectional Hierarchization Algorithm","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382878","year":"2016","yearsub":"2016"}
{"abstract":"The numerical treatment of high-dimensional partial differential equations is among the most compute-hungry problems and in urgent need for current and future high-performance computing (HPC) systems. It is thus also facing the grand challenges of exascale computing such as the requirement to reduce global communication. To cope with high dimensionalities we employ a hierarchical discretization scheme, the sparse grid combination technique. Based on an extrapolation scheme, the combination technique additionally mitigates the need for global communication: multiple and much smaller problems can be computed independently for each time step, and the global communication shrinks to a reduce/broadcast step in between. Here, we focus on this remaining synchronization step of the combination technique and present two communication schemes designed to either minimize the number of communication rounds or the total communication volume. Experiments on two different supercomputers show that either of the schemes outperforms the other depending on the size of the problem. Furthermore, we present a communication model based on the system’s latency and bandwidth and validate the model with the experiments. The model can be used to predict the runtime of the reduce/broadcast step for dimensionalities that are yet out of scope on current supercomputers.","author_count":4,"contributors":["Hupp, Philipp","Heene, Mario","Jacob, Riko","Pflüger, Dirk"],"cuid":["S01-000.00-381350"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","OECD"],"country":["Germany","Switzerland"],"glorg":["All Global Affiliations","Swiss Federal Institute of Technology Zürich","University of Stuttgart"],"keyword":["Communication Model","Communication Performance Analysis","Experimental evaluation","Global communication","High performance computing","Sparse Grid Combination Technique"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"global communication schemes for the numerical solution of high dimensional pdes","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82527236/parcoCommSchemesSubmitted.pdf","version":"Pre-print"},"id":"S01-000.00-381350","identifier":[{"id":"84955275099","type":"scopus"}],"ids":["itu-06363b85-b765-413e-8737-ffe7ceca3bad"],"keyword":["Communication Model","Communication Performance Analysis","Experimental Evaluation","Global Communication","High-Performance Computing","Sparse Grid Combination Technique"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-A0ADC0F590B2DB3EB070D0BA1DCA61EF"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82527236/parcoCommSchemesSubmitted.pdf","version":"Pre-print"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","country":"ch","key":"swiss federal institute of technology zürich","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"Swiss Federal Institute of Technology Zürich","used":1},{"affno":"2","country":"de","key":"university of stuttgart","loc":["Germany","Europe, EU","OECD"],"name":"University of Stuttgart","used":1},{"affno":"3","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Theoretical Computer Science, Algorithms","The Department, Theoretical Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Philipp","key":"hupppau","last":"Hupp","name":"Hupp, Philipp","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mario","key":"heenepau","last":"Heene","name":"Heene, Mario","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Riko","key":"jacobpau","last":"Jacob","locid":"e6f70fb0-caf1-4736-b583-b0777bc1390f","name":"Jacob, Riko","orcid":"0000-0001-9470-1809","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Dirk","key":"pflügerpau","last":"Pflüger","name":"Pflüger, Dirk","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.parco.2015.12.006","issn":["01678191","18727336"],"issn_org":["01678191"],"journal":"Parallel Computing","pages":"78-105","publisher":"Elsevier","status":"p","title":"Parallel Computing","volume":"52"},"review":"Peer Reviewed","scoID":["2-s2.0-84955275099"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-06363b85-b765-413e-8737-ffe7ceca3bad"],"src":["ITU IT University of Copenhagen"],"title":"Global communication schemes for the numerical solution of high-dimensional PDEs","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381350","year":"2016","yearsub":"2016"}
{"abstract":"We consider the problem of multiplying two $U \\times U$ matrices $A$ and $C$ of elements from a field $\\F$. We present a new randomized algorithm that can use the known fast square matrix multiplication algorithms to perform fewer arithmetic operations than the current state of the art for output matrices that are sparse. In particular, let $\\omega$ be the best known constant such that two dense $U \\times U$ matrices can be multiplied with $\\mathcal{O} \\left( U^\\omega \\right)$ arithmetic operations. Further denote by $N$ the number of nonzero entries in the input matrices while $Z$ is the number of nonzero entries of matrix product $AC$. We present a new Monte Carlo algorithm that uses $\\tilde{\\mathcal{O}} \\left( U^2 \\left(\\frac{Z}{U}\\right)^{\\omega-2} + N \\right)$ arithmetic operations and outputs the nonzero entries of $AC$ with high probability. For dense input, i.e., $N=U^2$, if $Z$ is asymptotically larger than $U$, this improves over state of the art methods, and it is always at most $\\mathcal{O} \\left( U^\\omega \\right)$. For general input density we improve upon state of the art when $N$ is asymptotically larger than $U^{4 - \\omega} Z^{\\omega - 5/2}$. The algorithm is based on dividing the input into \"balanced\" subproblems which are then compressed and computed. The new subroutine that computes a matrix product with balanced rows and columns in its output uses time $\\tilde{\\mathcal{O}} \\left( U Z^{(\\omega -1)/2} + N\\right)$ which is better than the current state of the art for balanced matrices when $N$ is asymptotically larger than $U Z^{\\omega/2 - 1}$, which always holds when $N=U^2$. In the I/O model --- where $M$ is the memory size and $B$ is the block size --- our algorithm is the first nontrivial result that exploits cancellations and sparsity of the output. The I/O complexity of our algorithm is $\\tilde{\\mathcal{O}} \\left( U^2 (Z/U)^{\\omega-2}/(M^{\\omega/2 -1} B) + Z/B + N/B \\right)$, which is asymptotically faster than the state of the art unless $M$ is large.","author_count":2,"contributors":["Jacob, Riko","Stöckel, Morten"],"cuid":["S01-000.00-383623"],"event":{"acronym":"ESA","title":"European Symposium on Algorithms"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Arithmetic Operations","I O complexity","Monte Carlo Method","Randomized algorithms","Sparse matrix multiplication"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"fast output sensitive matrix multiplication","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/81821897/JacobStoeckelFastMatrix.pdf","version":"Authors Final Version"},"id":"S01-000.00-383623","identifier":[{"id":"84945550719","type":"scopus"}],"ids":["itu-a1e27e41-8953-451e-b096-63e34aad77a6"],"keyword":["Arithmetic Operations","I/O Complexity","Monte Carlo Method","Randomized Algorithms","Sparse Matrix Multiplication"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-5-7CB560651FBE9A690564C70093680821"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/81821897/JacobStoeckelFastMatrix.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Theoretical Computer Science, Algorithms","The Department, Theoretical Computer Science"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Riko","key":"jacobpau","last":"Jacob","locid":"e6f70fb0-caf1-4736-b583-b0777bc1390f","name":"Jacob, Riko","orcid":"0000-0001-9470-1809","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Morten","key":"stöckelpau","last":"Stöckel","name":"Stöckel, Morten","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-662-48350-3_64","eisbn":["9783662483503"],"isbn":["9783662483497"],"issn":["03029743"],"pages":"766-778","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","subtitle":"23rd Annual European Symposium, Patras, Greece, September 14-16, 2015, Proceedings","title":"Algorithms - ESA 2015"},"review":"Peer Reviewed","scoID":["2-s2.0-84945550719"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["itu-a1e27e41-8953-451e-b096-63e34aad77a6"],"src":["ITU IT University of Copenhagen"],"title":"Fast Output-sensitive Matrix Multiplication","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383623","year":"2015","yearsub":"2015"}
