:43,"rolecode":"pau"},{"affno":"29","first":"Christopher K.","key":"yostpau","last":"Yost","name":"Yost, Christopher K.","rank":44,"rolecode":"pau"},{"affno":"30","first":"Sivachandran","key":"parimannanpau","last":"Parimannan","name":"Parimannan, Sivachandran","rank":47,"rolecode":"pau"},{"affno":"9","first":"Yaovi Mahuton Gildas","key":"hounmanoupau","last":"Hounmanou","locid":"8ef8c6b5-01e5-430b-a301-d5ac8146da5a","name":"Hounmanou, Yaovi Mahuton Gildas","orcid":"0000-0003-3991-0864","rank":48,"rolecode":"pau"},{"affno":"31","first":"Jens","key":"thomsenpau","last":"Thomsen","name":"Thomsen, Jens","rank":49,"rolecode":"pau"}],"pmid":["36456547"],"pub":{"doi":"10.1038/s41467-022-34312-7","issn":["20411723"],"issue":"1","journal":"Nature Communications","paperid":"7251","publisher":"Nature Research","status":"p","title":"Nature Communications","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-85143185703"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-7cd867a3-ccff-418c-ad8f-39766fe57b6b","ku-c8e81d5d-3fa6-4080-91c2-771d00788678"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Genomic analysis of sewage from 101 countries reveals global landscape of antimicrobial resistance","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-088.89-035450","year":"2022","yearsub":"2022"}
{"abstract":"Currently, the majority of AML patients still die of their disease due to primary resistance or relapse toward conventional ROS- and DNA damage-inducing chemotherapy regimens. Herein, we explored the therapeutic potential to enhance chemotherapy response in AML, by targeting the ROS scavenger enzyme MutT homolog 1 (MTH1, NUDT1), which protects cellular integrity through prevention of fatal chemotherapy-induced oxidative DNA damage. We demonstrate that MTH1 is a potential druggable target expressed by the majority of AML patients and the inv(16)/KITD816Y AML mouse model mimicking the genetics of AML patients exhibiting poor response to standard chemotherapy (i.e. anthracycline & cytarabine). Strikingly, combinatorial treatment of inv(16)/KITD816Y AML cells with the MTH1 inhibitor TH1579 and ROS- and DNA damage-inducing standard chemotherapy induced growth arrest and incorporated oxidized nucleotides into DNA leading to significantly increased DNA damage. Consistently, TH1579 and chemotherapy synergistically inhibited growth of clonogenic inv(16)/KITD816Y AML cells without substantially inhibiting normal clonogenic bone marrow cells. In addition, combinatorial treatment of inv(16)/KITD816Y AML mice with TH1579 and chemotherapy significantly reduced AML burden and prolonged survival compared to untreated or single treated mice. In conclusion, our study provides a rationale for future clinical studies combining standard AML chemotherapy with TH1579 to boost standard chemotherapy response in AML patients. Moreover, other cancer entities treated with ROS- and DNA damage-inducing chemo- or radiation therapies might benefit therapeutically from complementary treatment with TH1579.","author_count":9,"contributors":["Centio, Anders","Estruch, Montserrat","Reckzeh, Kristian","Sanjiv, Kumar","Vittori, Camilla","Engelhard, Sophia","Warpman Berglund, Ulrika","Helleday, Thomas","Theilgaard-Mönch, Kim"],"cuid":["S01-000.00-480715"],"filters":{"added":"2022-07","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Sweden"],"glorg":["All Global Affiliations","Karolinska Institutet"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"inhibition of oxidized nucleotide sanitation by th000000001579 and conventional chemotherapy cooperatively enhance oxidative dna damage and survival in aml","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-480715","identifier":[{"id":"85130193861","type":"scopus"},{"id":"35247918","type":"pmid"},{"id":"000795899500001","type":"wos"}],"ids":["ku-920bd9ec-4a73-42f4-8f21-7b51c7df5206"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-4DA166F96A5B77A52822653D515ED330"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, BRIC, Theilgaard Group"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","country":"se","key":"karolinska institutet","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Karolinska Institutet","used":1}],"person":[{"affno":"1 2","first":"Anders","key":"centiopau","last":"Centio","locid":"87cace48-aaa7-4e72-93b8-2a4dd4496fec","name":"Centio, Anders","rank":1,"rolecode":"pau"},{"affno":"1 2","first":"Montserrat","key":"estruchpau","last":"Estruch","locid":"cf2f068f-12e3-448d-83b0-cf7f60eec259","name":"Estruch, Montserrat","orcid":"0000-0002-7162-4158","rank":2,"rolecode":"pau"},{"affno":"2 1","first":"Kristian","key":"reckzehpau","last":"Reckzeh","locid":"070a5b5e-7555-4e61-a291-5d0392a07f28","name":"Reckzeh, Kristian","orcid":"0000-0001-6391-625X","rank":3,"rolecode":"pau"},{"affno":"3","first":"Kumar","key":"sanjivpau","last":"Sanjiv","name":"Sanjiv, Kumar","rank":4,"rolecode":"pau"},{"affno":"1 2","first":"Camilla","key":"vittoripau","last":"Vittori","locid":"1b40e18f-d5a9-4d99-89b4-ea0650bc643e","name":"Vittori, Camilla","rank":5,"rolecode":"pau"},{"affno":"2 1","first":"Sophia","key":"engelhardpau","last":"Engelhard","locid":"9376044c-024b-4a31-8ce3-15da4ed11a76","name":"Engelhard, Sophia","rank":6,"rolecode":"pau"},{"affno":"3","first":"Ulrika","key":"warpmanberglundpau","last":"Warpman Berglund","name":"Warpman Berglund, Ulrika","rank":7,"rolecode":"pau"},{"affno":"3","first":"Thomas","key":"helledaypau","last":"Helleday","name":"Helleday, Thomas","rank":8,"rolecode":"pau"},{"affno":"2 1","first":"Kim","key":"theilgaardmönchpau","last":"Theilgaard-Mönch","locid":"1b42b29b-87d1-413a-88ec-3f2baff8ff1c","name":"Theilgaard-Mönch, Kim","orcid":"0000-0002-4239-4939","rank":9,"rolecode":"pau"}],"pmid":["35247918"],"pub":{"doi":"10.1158/1535-7163.mct-21-0185","issn":["15357163","15388514"],"issn_org":["15357163"],"journal":"Molecular Cancer Therapeutics","pages":"703-714","status":"p","title":"Molecular Cancer Therapeutics"},"review":"Peer Reviewed","scoID":["2-s2.0-85130193861"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-920bd9ec-4a73-42f4-8f21-7b51c7df5206"],"src":["KU University of Copenhagen"],"title":"Inhibition of oxidized nucleotide sanitation by TH1579 and conventional chemotherapy cooperatively enhance oxidative DNA-damage and survival in AML","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-480715","year":"2022","yearsub":"2022"}
{"abstract":"Background: Marfan syndrome is associated with abnormalities in the musculoskeletal system including scoliosis, pectus deformities, protrusio acetabuli, and foot deformities. Over a life span, many patients with Marfan syndrome will need treatment; however, the musculoskeletal morbidity over a life span is not well described. The aim of the present study was to assess the overall burden of musculoskeletal disease in patients with Marfan syndrome. Materials and methods: A registry-based, nationwide epidemiological study of patients with a Ghent II verified Marfan syndrome diagnosis from 1977 to 2014. Each patient was matched on age, and sex with up to 100 controls from the background population. Results: We identified 407 patients with Marfan syndrome and 40,700 controls and compared their musculoskeletal diagnoses and surgical treatments using Cox proportional hazards ratio (HR). The risk of a registration of a musculoskeletal diagnosis in patients with Marfan syndrome was significantly increased compared to controls (HR: 1.94 (1.69–2.24). One out of six with Marfan syndrome was registered with scoliosis (HR: 36.7 (27.5–48.9). Scoliosis was more common in women with Marfan syndrome compared to men (HR: 4.30 (1.73–1.08)). One out of 11 were registered with a pectus deformity HR: 40.8 (28.1–59.3), and one out of six with a deformity of the foot. Primarily pes planus (HR: 26.0 (15.2–44.3). The proportion of patients with Marfan syndrome (94/407) that underwent musculoskeletal surgery was also significantly higher (HR: 1.76 (1.43–2.16)). The major areas of surgery were the spine, pectups correction, and surgery of the foot/ankle. Ten patients with Marfan syndrome had elective orthopedic surgery without being recognized and diagnosed with Marfan syndrome until later in life. None of these had scoliosis, pectus deformity or a foot deformity. Among patients with an aortic dissection, the age at dissection was 34.3 years in those with at least one major musculoskeletal abnormality. In patients without a major abnormality the age at dissection was 45.1 years (p < 0.01). Conclusions: The extent of musculoskeletal disease is quite significant in Marfan syndrome, and many will need corrective surgery during their life span. Surgeons should be aware of undiagnosed patients with Marfan syndrome when treating patients with a Marfan syndrome like-phenotype.","author_count":7,"contributors":["Andersen, Niels Holmark","Hauge, Ellen-Margrethe","Baad-Hansen, Thomas","Groth, Kristian A.","Berglund, Agnethe","Gravholt, Claus H.","Stochholm, Kirstine"],"cuid":["S02-100.00-004173"],"filters":{"added":"2022-04","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Andersen, Niels H","Andersen, Niels Holmark"],"keyword":["Inherited disease","Marfan syndrome","Musculoskeletal abnormalities","Orthopedic surgery","Pediatrics","Spine"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-HO-CDR","DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"musculoskeletal diseases in marfan syndrome a nationwide registry study","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s13023-022-02272-2","version":"Published Version"},"id":"S02-100.00-004173","identifier":[{"id":"000764995000005","type":"wos"},{"id":"35248143","type":"pmid"},{"id":"PMC8898450","type":"pmcid"},{"id":"85125848039","type":"scopus"}],"ids":["aau-55571b96-ae64-4ee6-bb01-4b42b2bd66d1","au-65f7958f-2dfe-40e1-b6fb-50d425dfeb6f"],"keyword":["Inherited disease","Marfan syndrome","Musculoskeletal abnormalities","Orthopedic surgery","Pediatrics","Spine"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-8FA6EE675FC39460FEE5356F61A3F107"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s13023-022-02272-2","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/464817833/Andersen_et_al._2022_._Musculoskeletal_diseases_in_Marfan_syndrome_a_nationwide_registry_study.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Cardiology","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Anæstesi, Børn, Kredsløb og Kvinder","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Section for Rheumatology"],"nora_code":"DI-U-AU","used":1},{"affno":"3","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Niels Holma