,"rolecode":"pau"},{"affno":"1","first":"Nona","key":"struyfpau","last":"Struyf","name":"Struyf, Nona","rank":19,"rolecode":"pau"},{"affno":"6","first":"Torkild","key":"visnespau","last":"Visnes","name":"Visnes, Torkild","rank":20,"rolecode":"pau"},{"affno":"1","first":"Martin","key":"scobiepau","last":"Scobie","name":"Scobie, Martin","rank":21,"rolecode":"pau"},{"affno":"1","first":"Tobias","key":"koolmeisterpau","last":"Koolmeister","name":"Koolmeister, Tobias","rank":22,"rolecode":"pau"},{"affno":"1","first":"Martin","key":"henrikssonpau","last":"Henriksson","name":"Henriksson, Martin","rank":23,"rolecode":"pau"},{"affno":"1","first":"Olov","key":"wallnerpau","last":"Wallner","name":"Wallner, Olov","rank":24,"rolecode":"pau"},{"affno":"7","first":"Teresa","key":"sandvallpau","last":"Sandvall","name":"Sandvall, Teresa","rank":25,"rolecode":"pau"},{"affno":"8","first":"Sören","key":"lehmannpau","last":"Lehmann","name":"Lehmann, Sören","rank":26,"rolecode":"pau"},{"affno":"4","first":"Kim","key":"theilgaardmönchpau","last":"Theilgaard-Mönch","locid":"1b42b29b-87d1-413a-88ec-3f2baff8ff1c","name":"Theilgaard-Mönch, Kim","orcid":"0000-0002-4239-4939","rank":27,"rolecode":"pau"},{"affno":"9","first":"Mathew J","key":"garnettpau","last":"Garnett","name":"Garnett, Mathew J","rank":28,"rolecode":"pau"},{"affno":"1","first":"Päivi","key":"östlingpau","last":"Östling","name":"Östling, Päivi","rank":29,"rolecode":"pau"},{"affno":"1","first":"Julian","key":"walfridssonpau","last":"Walfridsson","name":"Walfridsson, Julian","rank":30,"rolecode":"pau"},{"affno":"1","first":"Thomas","key":"helledaypau","last":"Helleday","name":"Helleday, Thomas","rank":31,"rolecode":"pau"},{"affno":"7","first":"Ulrika","key":"warpmanberglundpau","last":"Warpman Berglund","name":"Warpman Berglund, Ulrika","rank":32,"rolecode":"pau"}],"pmid":["34593524"],"pub":{"doi":"10.1158/0008-5472.can-21-0061","issn":["00085472","05766656"],"issn_org":["00085472"],"issue":"22","journal":"Cancer Research","pages