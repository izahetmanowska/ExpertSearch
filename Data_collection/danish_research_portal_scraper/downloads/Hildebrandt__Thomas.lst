rit N.","rank":61,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Bodil S.","key":"rasmussenbodilsteenpau","last":"Rasmussen","locid":"3162c449-94c3-4d28-8dbb-c134d6eb76e1","name":"Rasmussen, Bodil Steen","name_org":"Rasmussen, Bodil S.","orcid":"0000-0003-2190-145X","rank":62,"rolecode":"pau"}],"pmid":["33471452"],"pub":{"doi":"10.1056/nejmoa2032510","issn":["00284793","15334406"],"issn_org":["00284793"],"issue":"14","journal":"The New England Journal of Medicine","pages":"1301-1311","publisher":"Massachussetts Medical Society","status":"p","title":"The New England Journal of Medicine","title_org":"New England Journal of Medicine","volume":"384"},"review":"Peer Reviewed","scoID":["2-s2.0-85102855467"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","North Denmark Region","Other Research","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-668d175b-6ff0-4694-a374-658f35c322ec","au-deb0a677-7e6f-45fb-b46a-c6f39005e16d","ku-9739bd99-7de7-4ff9-b169-508efaa5d5f0","sdu-e0b8f4f2-619b-4987-b961-2b1817ba6de2"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Lower or Higher Oxygenation Targets for Acute Hypoxemic Respiratory Failure","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-095.97-004962","year":"2021","yearsub":"2021"}
{"abstract":"Every day, millions of administrative decisions take place in the public sector: building permits, land use, tax deductions, social welfare support, and access to healthcare, etc. When such decisions affect the rights and duties of individual citizens and/or businesses, they must meet the requirements set out in administrative law. Of those is the requirement that the body responsible for the decision must provide an explanation of the decision to the recipient. As many administrative decisions are being considered for automation through algorithmic decision-making (ADM) systems, it raises questions about what kind of explanations they need to provide. Fearing the opaqueness of the dreaded black box of these ADM systems, countless ethical guidelines have been produced, often of a very general character. Rather than adding yet another ethical consideration to what in our view is an already overcrowded ethics-based literature, we focus on a concrete legal approach, and ask: what does the legal requirement to explain a decision in public administration actually entail in regards to both human and computer-aided decision-making? We argue that, instead of pursuing a new approach to explanation, retaining the existing standard (the human standard) for explanation already enshrined in administrative law will be more meaningful and safe. To add to this we introduce what we call an ‘administrative Turing test’ which could be used to continually validate and strengthen computationally assisted decision-making, providing a benchmark on which future applications of ADM can be measured.","author_count":3,"contributors":["Olsen, Henrik Palmer","Slosser, Jacob Livingston","Hildebrandt, Thomas T."],"cuid":["S01-000.00-504920"],"filters":{"added":"2022-03","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"what s in the box the legal requirement to explain computationally aided decision making in public administration","src":["ku"],"src-code":["DI-U-KU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/287078678/What_s_in_the_Box.pdf","version":"Published Version"},"id":"S01-000.00-504920","ids":["ku-babed18e-4f8a-4f35-98ab-14d675fdc9eb"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-E8EB2CE70B0E0547C0BFBCADD5FBC913"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/287078678/What_s_in_the_Box.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Law, Faculty Management, JUR Dean's Staff"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Henrik Palmer","key":"olsenpau","last":"Olsen","locid":"d6151186-5867-4059-bc35-8e82ae4be33e","name":"Olsen, Henrik Palmer","orcid":"0000-0001-8486-8752","rank":1,"rolecode":"pau"},{"affno":"1","first":"Jacob Livingston","key":"slosserpau","last":"Slosser","locid":"cb822107-30f9-435e-9bb4-28d9870a97fc","name":"Slosser, Jacob Livingston","orcid":"0000-0003-4913-4790","rank":2,"rolecode":"pau"},{"affno":"1","first":"Thomas Troels","key":"hildebrandtpau","last":"Hildebrandt","locid":"c1d69914-5f7a-4f0b-8ffb-766693004328","name":"Hildebrandt, Thomas T.","name_org":"Hildebrandt, Thomas Troels","orcid":"0000-0002-7435-5563","rank":3,"rolecode":"pau"}],"pub":{"eisbn":["9781108914857"],"pages":"219-235","publisher":"Cambridge University Press","status":"p","title":"Constitutional Challenges in the Algorithmic Society"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-babed18e-4f8a-4f35-98ab-14d675fdc9eb"],"src":["KU University of Copenhagen"],"title":"What’s in the Box? The Legal Requirement to Explain Computationally Aided Decision-Making in Public Administration","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-504920","year":"2021","yearsub":"2021"}
{"abstract":"BACKGROUND: Coronavirus disease (COVID-19) primarily affects the lungs and lower airways and may present as hypoxaemic respiratory failure requiring admission to an intensive care unit (ICU) for supportive treatment. Here, supplemental oxygen remains essential for COVID-19 patient management, but the optimal dosage is not defined. We hypothesize that targeting an arterial partial pressure of oxygen of 8 kPa throughout ICU admission is superior to targeting 12 kPa. METHODS: The Handling Oxygenation Targets in ICU patients with COVID-19 (HOT-COVID) trial, is an investigator-initiated, pragmatic, multicentre, randomized, parallel-group trial comparing a lower oxygenation target versus a higher oxygenation target in adult ICU patients with COVID-19. The primary outcome is days alive without life-support (use of mechanical ventilation, renal replacement therapy or vasoactive therapy) at day 90. Secondary outcomes are 90-day and 1-year mortality, serious adverse events in the ICU and days alive and out of hospital in the 90-day period, health-related quality-of-life at 1 year, and health economic analyses. One-year follow-up of cognitive and pulmonary function is planned in a subgroup of Danish patients. We will include 780 patients to detect or reject an absolute increase in days alive without life-support of 7 days with an α of 5% and a β of 20%. An interim analysis is planned after 90-day follow-up of 390 patients. CONCLUSIONS: The HOT-COVID trial will provide patient-important data on the effect of two oxygenation targets in ICU patients with COVID-19 and hypoxia. This protocol paper describes the background, design and statistical analysis plan for the trial.","author_count":18,"contributors":["Nielsen, Frederik Mølgaard","Lass Klitgaard, Thomas","Crescioli, Elena","Aagaard, Søren Rosborg","Andreasen, Anne Sofie","Musaeus Poulsen, Lone","Siegemund, Martin","Craveiro Brøchner, Anne","Bestle, Morten H","Andi Iversen, Susanne","Brand, Björn A","Laake, Jon Henrik","Grøfte, Thorbjørn","Hildebrandt, Thomas","Lange, Theis","Perner, Anders","Schjørring, Olav Lilleholt","Rasmussen, Bodil Steen"],"cuid":["S03-093.75-001458"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"continent":["Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Mølgaard Nielsen, Frederik","Nielsen, Frederik Mølgaard"],"country":["Norway","Switzerland"],"glorg":["All Global Affiliations","Oslo University Hospital","University Hospital Basel","University Hospital of Basel","University of Basel"],"keyword":["Covid 19","Hypoxia","Intensive Care Units","Oxygen"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-OTH","DI-HO-SDR","DI-HO-ZEA"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU","DI-U-UND"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-OTH","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU","DI-U-UND"]},"review":"pr","rtype":["clu"],"sorti":"handling oxygenation targets in icu patients with covid 000000000019 protocol and statistical analysis plan in the hot covid trial","src":["aau","ku","sdu"],"src-code":["DI-U-AAU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"https://www.ncbi.nlm.nih.gov/pmc/about/copyright/","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC8441913/pdf/AAS-9999-0.pdf","version":"Published Version"},"id":"S03-093.75-001458","identifier":[{"id":"PMC8441913","type":"pmcid"},{"id":"85112238395","type":"scopus"},{"id":"34310694","type":"pmid"}],"ids":["aau-1cc22e09-5e40-44e0-beb3-25309ed8a1c6","ku-9386dc25-4f64-4a40-94fe-b9bd72e2b595","sdu-99b4ced3-2690-4f34-ab12-617bc07eb9a2"],"keyword":["COVID-19","hypoxia","intensive care units","oxygen"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["