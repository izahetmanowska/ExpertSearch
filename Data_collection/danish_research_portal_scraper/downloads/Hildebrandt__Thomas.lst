agen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Leandro","key":"galrinhopau","last":"Galrinho","name":"Galrinho, Leandro","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"João Costa","key":"secopau","last":"Seco","name":"Seco, João Costa","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Søren","key":"deboispau","last":"Debois","name":"Debois, Søren","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Thomas T.","key":"hildebrandtpau","last":"Hildebrandt","name":"Hildebrandt, Thomas T.","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Håkon","key":"normanpau","last":"Norman","name":"Norman, Håkon","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Tijs","key":"slaatspau","last":"Slaats","name":"Slaats, Tijs","rank":6,"rolecode":"pau"}],"pub":{"issn":["03029743","16113349"],"journal":"Lecture Notes in Computer Science","pages":"188-205","publisher":"Springer","status":"p","title":"Lecture Notes in Computer Science","title_org":"Lecture notes in computer science","volume":"12717"},"review":"No Review","scoID":["2-s2.0-85111359056"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["itu-4fa2e6be-b222-45ae-8cdc-407a1c3d0ac3"],"src":["ITU IT University of Copenhagen"],"title":"ReGraDa: Reactive graph data","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382460","year":"2021","yearsub":"2021"}
{"abstract":"This paper draws attention to new complexities of deploying artificial intelligence (AI) to sensitive contexts, such as welfare allocation. AI is increasingly used in public administration with the promise of improving decision-making through predictive modelling. To accurately predict, it needs all the agreed criteria used as part of decisions, formal and informal. This paper empirically explores the informal classifications used by caseworkers to make unemployed welfare seekers 'fit' into the formal categories applied in a Danish job centre. Our findings show that these classifications are documentable, and hence traceable to AI. However, to the caseworkers, they are at odds with the stable explanations assumed by any bureaucratic recording system as they involve negotiated and situated judgments of people's character. Thus, for moral reasons, caseworkers find them ill-suited for formal representation and predictive …","author_count":4,"contributors":["Petersen, Anette","Christensen, Lars Rune","Harper, Richard","Hildebrandt, Thomas"],"cuid":["S01-000.00-384149"],"event":{"acronym":"CSCW","title":"ACM Conference on Computer Supported Cooperative Work"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","Lancaster University"],"keyword":["Artificial intelligence","Informal Classifications","Predictive modelling","Public administration","Welfare Allocation"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"we would never write that down classifications of unemployed and data challenges for ai","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"doi","url":"https://doi.org/10.1145/3449176","version":"Published Version"},"id":"S01-000.00-384149","identifier":[{"id":"85112686825","type":"scopus"}],"ids":["itu-c4ada0ea-85f6-472a-a5ef-bf730a96f438"],"keyword":["Artificial Intelligence","Informal Classifications","Predictive Modelling","Public Administration","Welfare Allocation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-8B14E853E6107E8BCE8D4A28386FC331"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"doi","url":"https://doi.org/10.1145/3449176","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Technologies in Practice, Technologies in Practice"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"gb","key":"lancaster university","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Lancaster University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anette","key":"petersenpau","last":"Petersen","name":"Petersen, Anette","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars Rune","key":"christensenpau","last":"Christensen","locid":"92f6c3f3-0ad2-40fc-b278-69170f87567d","name":"Christensen, Lars Rune","orcid":"0000-0001-7204-465X","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Richard","key":"harperpau","last":"Harper","name":"Harper, Richard","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thomas","key":"hildebrandtpau","last":"Hildebrandt","name":"Hildebrandt, Thomas","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1145/3449176","issn":["25730142"],"issue":"CSCW1","journal":"Proceedings of the ACM on Human-Computer Interaction","pages":"1","paperid":"102","publisher":"Association for Computing Machinery","status":"p","title":"Proceedings of the ACM on Human-Computer Interaction","title_org":"Proceedings of the ACM on Human-Computer Interaction - CSCW","volume":"5"},"review":"Peer Reviewed","scoID":["2-s2.0-85112686825"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-c4ada0ea-85f6-472a-a5ef-bf730a96f438"],"src":["ITU IT University of Copenhagen"],"title":"\" We Would Never Write That Down\" Classifications of Unemployed and Data Challenges for AI","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384149","year":"2021","yearsub":"2021"}
{"abstract":"The research outlined in this paper is focusing on understanding asylum decision-making and outcome variations across the Nordic countries. As a preliminary study, we extract data from an open dataset1 of decision summaries from the Danish Refugee Appeals Board. The approach we propose, offers points for discussion of how prototyping context and participation can help raise questions about such data and engage stakeholders. Combining the application of Machine Learning (ML) and Natural Language Processing (NLP) with participatory methods (e.g. critically designed artefacts) enable us to 1) move beyond “obvious” ML-application areas, 2) through sensemaking of data with stakeholders, and 3) co-develop approaches to data science from a CSCW-perspective. en dc.language.iso en","author_count":9,"contributors":["Nielsen, Trine Rask","Katsikouli, Panagiota","Høgenhaug, Anna Murphy","Byrne, William Hamilton","Gammeltoft-Hansen, Thomas","Slaats, Tijs","Olsen, Henrik Palmer","Hildebrandt, Thomas T.","Møller, Naja Holten"],"cuid":["S01-000.00-427852"],"event":{"acronym":"ECSCW","end":"2021-06-11","place":"Zürich, ch","start":"2021-06-07","title":"19th European Conference on Computer Supported Cooperative Work","year":"2021"},"filters":{"added":"2022-04","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"confronting asylum decision making through prototyping sensemaking of data and participation","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.18420/ecscw2021_p08","version":"Published Version"},"id":"S01-000.00-427852","ids":["ku-39cc4003-a6da-4fd4-912b-e255b8b9fc1a"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi