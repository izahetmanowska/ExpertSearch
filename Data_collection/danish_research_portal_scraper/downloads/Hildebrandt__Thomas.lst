10 11 12 13","corresponding":null,"first":"Finn H.","key":"andersenpau","last":"Andersen","name":"Andersen, Finn H.","rank":14,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Thomas","key":"strømpau","last":"Strøm","locid":"d8661084-479b-4746-96af-9cfd0b539d72","name":"Strøm, Thomas","orcid":"0000-0002-1868-0978","rank":15,"rolecode":"pau"},{"affno":"14 15 16","corresponding":null,"first":"Mikko","key":"järvisalopau","last":"Järvisalo","name":"Järvisalo, Mikko","rank":16,"rolecode":"pau"},{"affno":"6 7","corresponding":null,"first":"Kjeld A. J.","key":"damgaardpau","last":"Damgaard","locid":"d31fbb52-e04e-46b7-abb8-126efae256b2","name":"Damgaard, Kjeld","name_org":"Damgaard, Kjeld A. J.","rank":17,"rolecode":"pau"},{"affno":"17 18","corresponding":null,"first":"Marianne L.","key":"vangpau","last":"Vang","locid":"d4e93e29-c38f-4079-a4d2-a7642da290c6","name":"Vang, Marianne L.","rank":18,"rolecode":"pau"},{"affno":"19 20","corresponding":null,"first":"Rebecka R.","key":"wahlinpau","last":"Wahlin","name":"Wahlin, Rebecka R.","rank":19,"rolecode":"pau"},{"affno":"21 22 23","corresponding":null,"first":"Martin I.","key":"sigurdssonpau","last":"Sigurdsson","name":"Sigurdsson, Martin I.","rank":20,"rolecode":"pau"},{"affno":"21 23","corresponding":null,"first":"Katrin M.","key":"thormarpau","last":"Thormar","name":"Thormar, Katrin M.","rank":21,"rolecode":"pau"},{"affno":"24 25 26","corresponding":null,"first":"Marlies","key":"ostermannpau","last":"Ostermann","name":"Ostermann, Marlies","rank":22,"rolecode":"pau"},{"affno":"27 28","corresponding":null,"first":"Frederik","key":"keuspau","last":"Keus","name":"Keus, Frederik","rank":23,"rolecode":"pau"},{"affno":"2 1","first":"Morten H.","key":"bestlepau","last":"Bestle","locid":"2f7d8164-ff5b-453b-9010-aa7c5268f3b4","name":"Bestle, Morten H.","rank":24,"rolecode":"pau"}],"pmid":["35898170"],"pub":{"doi":"10.1111/aas.14121","issn":["00015172"],"issue":"9","journal":"Acta Anaesthesiologica Scandinavica","pages":"1138-1145","publisher":"Blackwell Munksgaard","status":"p","title":"Acta Anaesthesiologica Scandinavica","volume":"66"},"review":"Peer Reviewed","scoID":["2-s2.0-85135607126"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-68691846-1bde-4572-b66b-c2be5eaf5d79","au-b4db5210-5dd3-468c-b0ce-c272aa359d1e","ku-a9a267fa-45f1-4d92-88d3-1f12f28db44e","sdu-768fba80-4006-4895-aadb-79a025cd71e0"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Goal directed fluid removal with furosemide versus placebo in intensive care patients with fluid overload : a trial protocol for a randomised, blinded trial (GODIF Trial)","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-092.05-005056","year":"2022","yearsub":"2022"}
{"abstract":"Recent comparative studies of billfishes (Istiophoridae and Xiphiidae) have provided evidence of differences in the form and function of the rostra (bill) among species. Here, we report the discovery of a new structure, lacuna rostralis, on the rostra of sailfish Istiophorus platypterus, which is absent on the rostra of swordfish Xiphias gladius, striped marlin Kajikia audax and blue marlin Makaira nigricans. The lacunae rostralis are small cavities that contain teeth. They were found on the ventral rostrum surface of all I. platypterus specimens examined and dorsally in half of them. Ventrally, the lacunae rostralis were most prominent in the mid-section of the rostrum. Dorsally, they occurred closer to the tip. The density of lacunae rostralis increased towards the rostrum tip but, because they are smaller in size, the percentage of rostrum coverage decreased. The teeth located within the lacunae rostralis were found to be different in size, location and orientation from the previously identified micro-teeth of billfish. We propose two potential functions of the lacunae rostralis that both relate to the use of the bill in feeding: mechanoreception of prey before tapping it with the bill and more efficient prey handling via the creation of suction, or physical grip.","author_count":17,"contributors":["Häge, Jan","Hansen, Matthew J.","Pacher, Korbinian","Dhellemmes, Félicie","Domenici, Paolo","Steffensen, John Fleng","Breuker, Michael","Krause, Stefan","Hildebrandt, Thomas B.","Fritsch, Guido","Bach, Pascal","Sabarros, Philippe S.","Zaslansky, Paul","Mahlow, Kristin","Schauer, Maria","Müller, Johannes","Krause, Jens"],"cuid":["S01-000.00-408607"],"filters":{"added":"2022-07","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["France","Germany","Italy"],"glorg":["All Global Affiliations","Charité – Universitätsmedizin Berlin","Humboldt University of Berlin","IRD Institut de Recherche pour le Developpement","Leibniz Institute for Zoo and Wildlife Research","Leibniz-Institute of Freshwater Ecology and Inland Fisheries","Lübeck University of Applied Sciences","Montpellier University","Museum für Naturkunde - Leibniz Institute for Evolution and Biodiversity Science","National Research Council of Italy (CNR)"],"keyword":["Rostrum","sailfish"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"lacunae rostralis a new structure on the rostrum of sailfish i istiophorus platypterus i","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1111/jfb.15018","version":"Published Version"},"id":"S01-000.00-408607","identifier":[{"id":"85125857581","type":"scopus"},{"id":"35194781","type":"pmid"}],"ids":["ku-19611d1d-c7db-48fe-915d-577d4280b58c"],"keyword":["billfishes","lacunae rostralis","prey-handling","rostrum","sailfish"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-C3A77CEAF23228F1F16C2E749E44D720"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/308372829/Journal_of_Fish_Biology_2022_H_ge_Lacunae_rostralis_A_new_structure_on_the_rostrum_of_sailfish_Istiophorus.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1111/jfb.15018","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"de","key":"humboldt university of berlin","loc":["Germany","Europe, EU","OECD"],"name":"Humboldt University of Berlin","used":1},{"affno":"2","country":"de","key":"leibniz institute of freshwater ecology and inland fisheries","loc":["Germany","Europe, 