o":"","corresponding":null,"first":"Joseph","key":"shlomaijosephpau","last":"Shlomai","name":"Shlomai, Joseph","rank":67,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Gudrun","key":"nurnberggudrunpau","last":"Nurnberg","name":"Nurnberg, Gudrun","rank":68,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Peter","key":"nurnbergpeterpau","last":"Nurnberg","name":"Nurnberg, Peter","rank":69,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Shawn","key":"levyshawnpau","last":"Levy","name":"Levy, Shawn","rank":70,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Agata","key":"smogorzewskaagatapau","last":"Smogorzewska","name":"Smogorzewska, Agata","rank":71,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Edgar A","key":"ottoedgarapau","last":"Otto","name":"Otto, Edgar A","rank":72,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Friedhelm","key":"hildebrandtfriedhelmpau","last":"Hildebrandt","name":"Hildebrandt, Friedhelm","rank":73,"rolecode":"pau"}],"pmid":["22863007"],"pub":{"doi":"10.1016/j.cell.2012.06.028","issn":["19345909"],"issue":"3","journal":"Cell Stem Cell","pages":"533-48","publisher":"Cell Press","status":"p","title":"Cell Stem Cell","volume":"150"},"review":"Peer Reviewed","scoID":["2-s2.0-84864584531"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-762d49c6-15e4-42f1-b5c9-eee49ab8650d"],"src":["SDU University of Southern Denmark"],"title":"Exome capture reveals ZNF423 and CEP164 mutations, linking renal ciliopathies to DNA damage response signaling","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-607024","year":"2012","yearsub":"2012"}
{"abstract":"We present a formal technique for safe distribution of workflow processes described declaratively as Nested Condition Response (NCR) Graphs and apply the technique to a distributed healthcare workflow. Concretely, we provide a method to synthesize from a NCR Graph and any distribution of its events a set of local process graphs communicating by shared events, such that the distributed execution of the local processes is equivalent to executing the original process. The technique is based on our recent similar work on safe distribution of Dynamic Condition Response (DCR) Graphs applied to cross-organizational case management. The contributions of this paper is to adapt the technique to allow for nested processes and milestones and to apply it to a healthcare workflow identified in a previous field study at danish hospitals.","author_count":3,"contributors":["Hildebrandt, Thomas","Mukkamala, Raghava Rao","Slaats, Tijs"],"cuid":["S01-000.00-384594"],"event":{"end":"2011-08-30","place":"Johannesburg, za","start":"2011-08-29","title":"International Symposium on Foundations of Health Information Engineering and Systems","year":"2011"},"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["NCR Graphs","Process synthesis","distributed execution","healthcare workflow","workflow distribution"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"declarative modelling and safe distribution of healthcare workflows","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/37342268/paper_17.pdf","version":"Authors Final Version"},"id":"S01-000.00-384594","identifier":[{"id":"84864971529","type":"scopus"}],"ids":["itu-e1d355a9-e451-44d1-a02b-98f0ebb7097b"],"keyword":["NCR Graphs","distributed execution","healthcare workflow","process synthesis","workflow distribution"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-FD39CFD34FBA41E5F358DEDE1B2145B1"],"oa_link":[{"access":"oa","type":"rem","url":"http://link.springer.com/chapter/10.1007%2F978-3-642-32355-3_3?LI=true","version":"Other Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-3-642-32355-3_3","version":"Other Version"},{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/37342268/paper_17.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Theoretical Computer Science, Programming Logic and Semantics","The Department, Theoretical Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Thomas","key":"hildebrandtpau","last":"Hildebrandt","name":"Hildebrandt, Thomas","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Raghava Rao","key":"mukkamalapau","last":"Mukkamala","name":"Mukkamala, Raghava Rao","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Tijs","key":"slaatspau","last":"Slaats","name":"Slaats, Tijs","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-642-32355-3_3","issn":["03029743","16113349"],"issn_org":["03029743"],"journal":"Lecture Notes in Computer Science","pages":"39-56","publisher":"Springer","status":"p","title":"Lecture Notes in Computer Science","volume":"7151"},"review":"Peer Reviewed","scoID":["2-s2.0-84864971529"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-e1d355a9-e451-44d1-a02b-98f0ebb7097b"],"src":["ITU IT University of Copenhagen"],"title":"Declarative Modelling and Safe Distribution of Healthcare Workflows","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384594","year":"2012","yearsub":"2012"}
{"abstract":"We present a model checking tool for Bigraphical Reactive Systems that may be instantiated as a model checker for any formalism or domain-specific modelling language encoded as a Bigraphical Reactive System. We describe the implementation of the tool, and how it can be used to verify correctness properties of some infinite-state models by applying a static analysis to reaction rules that permits the exclusion of some infinite branches of execution shown to always be free of violations. We give a proof of correctness for this method, and illustrate the usage of the tool with two examples — a textbook implementation of the Dining Philosophers prob- lem, and an example motivated by a ubiquitous computing application.","author_count":3,"contributors":["Perrone, Gian David","Debois, Søren","Hildebrandt, Thomas"],"cuid":["S01-000.00-384977"],"event":{"end":"2012-03-30","place":"Riva del Garda, it","start":"2012-03-26","title":"ACM Symposium on Applied Computing 2012","year":"2012"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Bigraphical Reactive Systems","Formal verification","Infinite State Models","Model checking","Static analysis"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"a model checker for bigraphs","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1145/2245276.2231985","version":"Other Version"},"id":"S01-000.00-384977","identifier":[{"id":"84863594592","type":"scopus"}],"ids":["itu-fc0d85e2-570a-4bf4-b7ce-6f002e5c397f"],"keyword":["Bigraphical Reactive Systems","Formal Verification","Infinite-State Models","Model Checking","Static Analysis"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-9C4668C811A93BB39DE03634E4AEFF03"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1145/2245276.2231985","version":"Other Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["The Department, Theoretical Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Gian David","key":"perronepau","last":"Perrone","name":"Perrone, Gian David","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren","key":"deboispau","last":"Debois","name":"Debois, Søren","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thomas","key":"hildebrandtpau","last":"Hildebrandt","name":"Hildebrandt, Thomas","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1145/2245276.2231985","isbn":["9781450308571"],"pages":"1320-1325","place":"New York, NY, USA","publisher":"Association for Computing Machinery","status":"p","title":"SAC '12. Proceedings of the 27th Annual ACM Symposium on Applied Computing"},"review":"Peer Reviewed","scoID":["2-s2.0-84863594592"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-fc0d85e2-570a-4bf4-b7ce-6f002e5c397f"],"src":["ITU IT University of Copenhagen"],"title":"A Model Checker for Bigraphs","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384977","year":"2012","yearsub":"2012"}
{"author_count":3,"contributors":["Christiansen, David Raymond","Carbone, Marco","Hildebrandt, Thomas"],"cuid":["S01-000.00-382942"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"formal semantics and implementation of bpmn 000000000002 000000000000 inclusive gateways","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/79953113399","version":"Other Version"},"id":"S01-000.00-382942","identifier":[{"id":"79953113399","type":"scopus"}],"ids":["itu-70ae84be-c9f8-4d55-84f5-b928ca67bf36"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-BFC481204128DD1CCC0BB4975DC08E2F"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["The Department, Software & Systems"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"David Raymond","key":"christiansenpau","last":"Christiansen","name":"Christiansen, David Raymond","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marco","key":"carbonepau","last":"Carbone","locid":"9027b41a-4159-4db7-9ddd-8fc8f41f1fb3","name":"Carbone, Marco","orcid":"0000-0001-9479-2632","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thomas","key":"hildebrandtpau","last":"Hildebrandt","name":"Hildebrandt, Thomas","rank":3,"rolecode":"pau"}],"pub":{"issn":["03029743","16113349"],"journal":"Lecture Notes in Computer Science","pages":"146-160","publisher":"Springer","status":"p","title":"Lecture Notes in Computer Science","volume":"6551"},"review":"Peer Reviewed","scoID":["2-s2.0-79953113399"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-70ae84be-c9f8-4d55-84f5-b928ca67bf36"],"src":["ITU IT University of Copenhagen"],"title":"Formal Semantics and Implementation of BPMN 2.0 Inclusive Gateways","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382942","year":"2011","yearsub":"2011"}
{"abstract":"We give a general technique for safe distribution of a declarative (global) process as a network of (local) synchronously communicating declarative processes. Both the global and local processes are given as Dynamic Condition Response (DCR) Graphs. DCR Graphs is a recently introduced declarative process model generalizing labelled prime event structures to a systems model able to finitely represent ω-regular languages. An operational semantics given as a transition semantics between markings of the graph allows DCR Graphs to be conveniently used as both specification and execution model. The technique for distribution is based on a new general notion of projection of DCR Graphs relative to a subset of labels and events identifying the set of external events that must be communicated from the other processes in the network in order for the distribution to be safe.We prove that for any vector of projections that covers a DCR Graph that the network of synchronously communicating DCR Graphs given by the projections is bisimilar to the original global process graph. We exemplify the distribution technique on a process identified in a case study of an cross-organizational case management system carried out jointly with Exformatics A/S.","author_count":3,"contributors":["Hildebrandt, Thomas","Mukkamala, Raghava Rao","Slaats, Tijs"],"cuid":["S01-000.00-383780"],"event":{"end":"2011-11-18","place":"Montevideo, uy","start":"2011-11-14","title":"9th International Conference on Software Engineering and Formal Methods","year":"2011"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Bisimilarity","Cross Organizational Case Management","DCR Graphs","Declarative Process Model","Dynamic Condition Response","Operational semantics","Projection Technique","Safe Distribution","Synchronous Communication","ω regular Languages"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"safe distribution of declarative processes","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/34548793/paper_5.pdf","version":"Authors Final Version"},"id":"S01-000.00-383780","identifier":[{"id":"81055124347","type":"scopus"}],"ids":["itu-ad2099fd-feb0-47a0-94eb-bba6ed2d85a8"],"keyword":["Bisimilarity","Cross-Organizational Case Management","DCR Graphs","Declarative Process Model","Dynamic Condition Response","Operational Semantics","Projection Technique","Safe Distribution","Synchronous Communication","ω-regular Languages"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-66CF4F5E1B728FD68208CF791739CB34"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/34548793/paper_5.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Thomas","key":"hildebrandtpau","last":"Hildebrandt","name":"Hildebrandt, Thomas","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Raghava Rao","key":"mukkamalapau","last":"Mukkamala","name":"Mukkamala, Raghava Rao","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Tijs","key":"slaatspau","last":"Slaats","name":"Slaats, Tijs","rank":3,"rolecode":"pau"}],"pub":{"isbn":["237252"],"pages":"237-252","publisher":"Springer","status":"p","title":"SEFM'11 Proceedings of the 9th international conference on Software engineering and formal methods"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-ad2099fd-feb0-47a0-94eb-bba6ed2d85a8"],"src":["ITU IT University of Copenhagen"],"title":"Safe Distribution of Declarative Processes","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383780","year":"2011","yearsub":"2011"}
{"abstract":"We present a case study of the use of Dynamic Con- dition Response (DCR) Graphs, a recently introduced declarative business process model, in the design of a cross-organizational case management system being developed by Exformatics A/S, a danish provider of knowledge and workflow management systems. We show how DCR Graphs allow to capture directly both the behavioral constraints identified during meetings with the customer and the operational execution as markings of the graph. In comparison, imperative models such as BPMN, Petri Net, UML Sequence or Activity diagrams are only good at describing the operational way to fulfill the constraints, leaving the constraints implicit. In particular, we point out that the BPMN ad-hoc sub process activity, intended to support more loosely structured goal driven ad-hoc processes, is inconsistently described in the final version of the BPMN 2.0 standard. The case study motivated an extension of the DCR Graphs model to nested graphs and the development of graphical design and simulation tools to increase the understanding of the models. The study also revealed a number of challenges for future research in techniques for model-driven design of cross-organizational process-aware information systems combining declarative and imperative models.","author_count":3,"contributors":["Hildebrandt, Thomas","Mukkamala, Raghava Rao","Slaats, Tijs"],"cuid":["S01-000.00-382037"],"event":{"acronym":"EDOC","end":"2011-09-02","place":"Helsinki, fi","start":"2011-08-29","title":"15th IEEE International EDOC Conference 2011","year":"2011"},"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Behavioral Constraints","Cross Organizational Case Management","Declarative Business Process Model","Dynamic Condition Response DCR Graphs","Model Driven Design"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"designing a cross organizational case management system using dynamic condition response graphs","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/34475285/02_Designing_a_Cross_Organizational_Case_Management_System_Using_Dynamic_Condition_Response_Graphs.pdf","version":"Authors Final Version"},"id":"S01-000.00-382037","identifier":[{"id":"80054893701","type":"scopus"}],"ids":["itu-347cc593-5e8f-4b6b-bee0-7212c9fe3711"],"keyword":["Behavioral Constraints","Cross-Organizational Case Management","Declarative Business Process Model","Dynamic Condition Response (DCR) Graphs","Model-Driven Design"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-F3C4FA17C0ECD596A7B7DF8D4C022F16"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/34475285/02_Designing_a_Cross_Organizational_Case_Management_System_Using_Dynamic_Condition_Response_Graphs.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Thomas","key":"hildebrandtpau","last":"Hildebrandt","name":"Hildebrandt, Thomas","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Raghava Rao","key":"mukkamalapau","last":"Mukkamala","name":"Mukkamala, Raghava Rao","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Tijs","key":"slaatspau","last":"Slaats","name":"Slaats, Tijs","rank":3,"rolecode":"pau"}],"pub":{"issn":["15417719"],"journal":"International Enterprise Distributed Object Computing Conference. Proceedings","pages":"161-170","status":"p","title":"International Enterprise Distributed Object Computing Conference. Proceedings"},"review":"Peer Reviewed","scoID":["2-s2.0-80054893701"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-347cc593-5e8f-4b6b-bee0-7212c9fe3711"],"src":["ITU IT University of Copenhagen"],"title":"Designing a Cross-organizational Case Management System using Dynamic Condition Response Graphs","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382037","year":"2011","yearsub":"2011"}
{"abstract":"We present distributed dynamic condition response structures as a declarative process model inspired by the workflow language employed by our industrial partner and conservatively generalizing labelled event structures. The model adds to event structures the possibility to 1) finitely specify repeated, possibly infinite behavior, 2) finitely specify fine-grained acceptance conditions for (possibly infinite) runs based on the notion of responses and 3) distribute events via roles. We give a graphical notation inspired by related work by van der Aalst et al and formalize the execution semantics as a labelled transition system. Exploration of the relationship between dynamic condition response structures and traditional models for concurrency, application to more complex scenarios, and further extensions of the model is left to future work.","author_count":2,"contributors":["Hildebrandt, Thomas","Mukkamala, Raghava Rao"],"cuid":["S01-000.00-382386"],"event":{"end":"2010-03-28","place":"Paphos, Cyprus, gr","start":"2010-03-20","title":"The European Joint Conferences on Theory and Practice of Software (ETAPS)","year":"2010"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Concurrent Systems","Declarative Process Model","Distributed Dynamic Condition Response Structures","Graphical Notation","Labelled Event Structures"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"distributed dynamic condition response structures","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/32037793/dcrsplacescamredver.pdf","version":"Authors Final Version"},"id":"S01-000.00-382386","ids":["itu-4b010bb6-18f8-4cd4-a2f8-7f4c37444cfc"],"keyword":["Concurrent Systems","Declarative Process Model","Distributed Dynamic Condition Response Structures","Graphical Notation","Labelled Event Structures"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-4F7C7AB4E2B86BBAEBC31CE480E56778"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/32037793/dcrsplacescamredver.pdf","version":"Authors Final Version"},{"access":"oa","type":"rem","url":"http://www.itu.dk/people/rao/pubs_accepted/dcrsplacescamredver.pdf","version":"Other Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Thomas","key":"hildebrandtpau","last":"Hildebrandt","name":"Hildebrandt, Thomas","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Raghava Rao","key":"mukkamalapau","last":"Mukkamala","name":"Mukkamala, Raghava Rao","rank":2,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-4b010bb6-18f8-4cd4-a2f8-7f4c37444cfc"],"src":["ITU IT University of Copenhagen"],"title":"Distributed Dynamic Condition Response Structures","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382386","year":"2011","yearsub":"2011"}
