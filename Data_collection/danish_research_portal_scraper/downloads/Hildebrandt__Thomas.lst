enhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Department of Computer Science"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Morten","key":"marquardpau","last":"Marquard","name":"Marquard, Morten","rank":1,"rolecode":"pau"},{"affno":"1 2","first":"Søren","key":"deboispau","last":"Debois","name":"Debois, Søren","rank":2,"rolecode":"pau"},{"affno":"3","first":"Tijs","key":"slaatspau","last":"Slaats","locid":"85f00008-e9c6-439c-aae5-e5bd725f2099","name":"Slaats, Tijs","orcid":"0000-0001-6244-6970","rank":3,"rolecode":"pau"},{"affno":"2","first":"Thomas","key":"hildebrandtpau","last":"Hildebrandt","name":"Hildebrandt, Thomas","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Other Companies","Private Research","Universities","University of Copenhagen","exformatics a/s (biz)"],"PST":["Published"]},"sid":["ku-7b4a4f76-fd22-4cc6-96b0-0a7ce3d0eba6"],"src":["KU University of Copenhagen"],"title":"Forms are declarative processes!","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-467271","year":"2016","yearsub":"2016"}
{"abstract":"We report on experiences from a case study applying a constraint-based process-modelling and -simulation tool, dcrgraphs.net, to the modelling and rehearsal of railway emergency response plans with domain experts. The case study confirmed the approach as a viable means for domain experts to analyse and rehearse emergency response plans, through the activities of formally modelling the plan and subsequently rehearsing it by simulating that model collaboratively. In particular, the constraint-based modelling notation resulted in a flexible model giving rehearsal participants freedom to explore different ways to proceed, including ways not necessarily anticipated in the paper-based emergency response plans. The case study was undertaken as part of a short research, ProSec, project funded by the Danish Defence Agency, with the aim of applying and developing methods for collaborative mapping of emergency and security processes in the danish public transport sector and their dependency on ICT.","author_count":3,"contributors":["Debois, Søren","Hildebrandt, Thomas","Sandberg, Lene"],"cuid":["S02-095.65-038400"],"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Case studies","Collaborative Rehearsal","Constraint based Process Modelling","Cooperative learning","Emergency management","It","Railway Emergency Response","Security Processes in Public Transport","Simulation tool"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U","DI-UC"],"level3":{"U":["DI-U-ALL","DI-U-ITU"],"UC":["DI-UC-ALL","DI-UC-KP"]},"level3all":["DI-U-ITU","DI-UC-KP"]},"review":"pr","rtype":["clu"],"sorti":"experience report constraint based modelling and simulation of railway emergency response plans","src":["itu","kp"],"src-code":["DI-U-ITU","DI-UC-KP"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.procs.2016.04.269","version":"Published Version"},"id":"S02-095.65-038400","identifier":[{"id":"84971320579","type":"scopus"}],"ids":["itu-e12ad2f8-60b2-4d15-b01a-6c3196c9d80b","kp-342b27c1-ee02-437b-beb1-98ea2d46e847"],"keyword":["Collaborative Rehearsal","Constraint-based Process Modelling","Railway Emergency Response","Security Processes in Public Transport","Simulation Tool","case studies","cooperative learning","emergency management","it"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-77AD31C82C7E418FE30745D7148EA1EA"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://pure.itu.dk/ws/files/82367853/1_s2.0_S1877050916303027_main.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.procs.2016.04.269","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","The Department, Theoretical Computer Science"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","key":"kp university college copenhagen","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-KP","l3nl":"KP","l3nn":"KP University College Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KP University College Copenhagen","namevar":["Københavns Professionshøjskole, Rektors område, Fakultet for pædagogiske og samfundsfaglige uddannelser-Dekan, Katastrofe- og Risikomanageruddannelsen","Societal safety and security"],"nora_code":"DI-UC-KP","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Søren","key":"deboispau","last":"Debois","name":"Debois, Søren","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thomas","key":"hildebrandtpau","last":"Hildebrandt","name":"Hildebrandt, Thomas","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lene","key":"sandbergpau","last":"Sandberg","locid":"45607bcd-7c3b-49ea-8b5d-a006ee44133e","name":"Sandberg, Lene","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.procs.2016.04.269","issn":["18770509"],"journal":"Procedia Computer Science","pages":"1295-1300","publisher":"Elsevier","status":"p","title":"Procedia Computer Science","volume":"83"},"review":"Peer Reviewed","scoID":["2-s2.0-84971320579"],"search":{"DAF":["All Danish Affiliations","All Universities","All University Colleges","DI-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","IT University of Copenhagen","KP","Universities","University Colleges"],"PST":["Published"]},"sid":["itu-e12ad2f8-60b2-4d15-b01a-6c3196c9d80b","kp-342b27c1-ee02-437b-beb1-98ea2d46e847"],"src":["ITU IT University of Copenhagen","KP University College Copenhagen"],"title":"Experience Report: Constraint-Based Modelling and Simulation of Railway Emergency Response Plans","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-095.65-038400","year":"2016","yearsub":"2016"}
{"abstract":"BACKGROUND: Regulatory T (Treg) cells, a subset of CD4+ T lymphocytes, are mediators of immunosuppression in cancer, and, thus, variants in genes encoding Treg cell immune molecules could be associated with ovarian cancer. METHODS: In a population of 15,596 epithelial ovarian cancer (EOC) cases and 23,236 controls, we measured genetic associations of 1,351 SNPs in Treg cell pathway genes with odds of ovarian cancer and tested pathway and gene-level associations, overall and by histotype, for the 25 genes, using the admixture likelihood (AML) method. The most significant single SNP associations were tested for correlation with expression levels in 44 ovarian cancer patients. RESULTS: The most significant global associations for all genes in the pathway were seen in endometrioid ( p = 0.082) and clear cell ( p = 0.083), with the most significant gene level association seen with TGFBR2 ( p = 0.001) and clear cell EOC. Gene associations with histotypes at p < 0.05 included: IL12 ( p = 0.005 and p = 0.008, serous and high-grade serous, respectively), IL8RA ( p = 0.035, endometrioid and mucinous), LGALS1 ( p = 0.03, mucinous), STAT5B ( p = 0.022, clear cell), TGFBR1 ( p = 0.021 endometrioid) and TGFBR2 ( p = 0.017 and p = 0.025, endometrioid and mucinous, respectively). CONCLUSIONS: Common inherited gene variation in Treg cell pathways shows some evidence of germline genetic contribution to odds of EOC that varies by histologic subtype and may be associated with mRNA expression of immune-complex receptor in EOC patients.","author_count":170,"contributors":["Hampras, Shalaka S","Sucheston-Campbell, Lara E","Cannioto, Rikki","Chang-Claude, Jenny","Modugno, Francesmary","Doerk, Thilo","Hillemanns, Peter","Preus, Leah","Knutson, Keith L","Wallace, Paul K","Hong, Chi-chen","Friel, Grace","Davis, Warren","Nesline, Mary","Pearce, Celeste L","Kelemen, Linda E","Goodman, Marc T","Bandera, Elisa V","Terry, Kathryn L","Schoof, Nils","Eng, Kevin H","Clay, Alyssa I","Singh, Prashant K","Joseph, Janine M","Aben, Katja K H","Anton-Culver, Hoda","Antonenkova, Natalia","Baker, Helen","Bean, Yukie","Beckmann, Matthias W","Bisogna, Maria","Bjorge, Line","Bogdanova, Natalia","Brinton, Louise A","Brooks-Wilson, Angela","Bruinsma, Fiona","Butzow, Ralf","Campbell, Ian G","Carty, Karen","Cook, Linda S","Cramer, Daniel W","Cybulski, Cezary","Dansonka-Mieszkowska, Agnieszka","Dennis, Joe","Despierre, Evelyn","Dicks, Ed","Doherty, Jennifer A","Du Bois, Andreas","Durst, Matthias","Easton, Doug","Eccles, Diana","Edwards, Robert P","Ekici, Arif B","Fasching, Peter A","Fridley, Brooke L","Gao, Yu-Tang","Gentry-Maharaj, Aleksandra","Giles, Graham","Glasspool, Rosalind M","Gronwald, Jacek","Harrington, Patricia","Harter, Philipp","Hasmad, Hanis Nazihah","Hein, Alexander","Heitz, Florian","Hildebrandt, Michelle A T","Høgdall, Claus","Hogdall, Estrid","Hosono, Satoyo","Iversen, Edwin S","Jakubowska, Anna","Jensen, Allan","Ji, Bu-Tian","Karlan, Beth Y","Kellar, Melissa","Kelley, Joseph L","Kiemeney, Lambertus A","Klapdor, Rüdiger","Kolomeyevskaya, Nonna","Krakstad, Camilla","Kjaer, Susanne K.","Kruszka, Bridget","Kupryjanczyk, Jolanta","Lambrechts, Diether","Lambrechts, Sandrina","Le, Nhu D","Lee, Alice W","Lele, Shashikant","Leminen, Arto","Lester, Jenny","Levine, Douglas A","Liang, Dong","Lissowska, Jolanta","Liu, Song","Lu, Karen","Lubinski, Jan","Lundvall, Lene","Massuger, Leon F A G","Matsuo, Keitaro","McGuire, Valeria","McLaughlin, John R","McNeish, Ian","Menon, Usha","Moes-Sosnowska, Joanna","Narod, Steven A","Nedergaard, Lotte","Nevanlinna, Heli","Nickels, Stefan","Olson, Sara H","Orlow, Irene","Weber, Rachel Palmieri","Paul, James","Pejovic, Tanja","Pelttari, Liisa M","Perkins, Barbara","Permuth-Wey, Jenny","Pike, Malcolm C","Plisiecka-Halasa, Joanna","Poole, Elizabeth M","Risch, Harvey A","Rossing, Mary Anne","Rothstein, Joseph H","Rudolph, Anja","Runnebaum, Ingo B","Rzepecka, Iwona K","Salvesen, Helga B","Schernhammer, Eva","Schmitt, Kristina",