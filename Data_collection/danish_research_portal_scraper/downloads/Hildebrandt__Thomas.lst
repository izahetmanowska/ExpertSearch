sponding":null,"first":"Morten","key":"borupmortenpau","last":"Borup","locid":"daa98fdc-4ff4-41a1-bf93-d08e1c96059a","name":"Borup, Morten","rank":36,"rolecode":"pau"},{"affno":"15","first":"Thorbjørn","key":"grøftethorbjørnpau","last":"Grøfte","name":"Grøfte, Thorbjørn","rank":37,"rolecode":"pau"},{"affno":"11","first":"Thomas","key":"hildebrandtthomaspau","last":"Hildebrandt","name":"Hildebrandt, Thomas","rank":38,"rolecode":"pau"},{"affno":"12","first":"Maj-Brit N","key":"kjærmajbritnpau","last":"Kjær","name":"Kjær, Maj-Brit N","rank":39,"rolecode":"pau"},{"affno":"12","first":"Janus","key":"engstrømjanuspau","last":"Engstrøm","name":"Engstrøm, Janus","rank":40,"rolecode":"pau"},{"affno":"16","first":"Theis","key":"langetheispau","last":"Lange","locid":"e4664578-01fc-4a93-8efd-1dbffb72cdd6","name":"Lange, Theis","orcid":"0000-0001-6807-8347","rank":41,"rolecode":"pau"},{"affno":"12 16","first":"Anders","key":"perneranderspau","last":"Perner","locid":"8a389541-d529-4ee3-8364-66bfc85f77c9","name":"Perner, Anders","rank":42,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Olav L.","key":"schjørringolavlilleholtpau","last":"Schjørring","locid":"7dac619e-9b5c-46ac-9170-10ac13165da5","name":"Schjørring, Olav Lilleholt","name_org":"Schjørring, Olav L.","rank":43,"rolecode":"pau"},{"affno":"2","first":"Olav L","key":"schjørringolavlpau","last":"Schjørring","name":"Schjørring, Olav L","rank":43,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Bodil S.","key":"rasmussenbodilsteenpau","last":"Rasmussen","locid":"3162c449-94c3-4d28-8dbb-c134d6eb76e1","name":"Rasmussen, Bodil Steen","name_org":"Rasmussen, Bodil S.","orcid":"0000-0003-2190-145X","rank":44,"rolecode":"pau"}],"pmid":["38501214"],"pub":{"doi":"10.1001/jama.2024.2934","issn":["00987484","01851160"],"issn_org":["00987484"],"issue":"14","journal":"JAMA  The Journal of the American Medical Association","pages":"1185-1194","publisher":"American Medical Association","status":"p","title":"JAMA  The Journal of the American Medical Association","title_org":"JAMA","volume":"331"},"review":"Peer Reviewed","scoID":["2-s2.0-85189877590"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","North Denmark Region","Other Research","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-cf52a64f-0df8-4326-8978-7bf8673b40e7","ku-3bfc4b92-9fdc-48ad-8095-6e7f2c56c6f7","sdu-843503aa-74a6-429d-ad30-3c675f6e0afa"],"src":["AAU Aalborg University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Lower vs Higher Oxygenation Target and Days Alive Without Life Support in COVID-19 : The HOT-COVID Randomized Clinical Trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-099.97-735023","year":"2024","yearsub":"2024"}
{"abstract":"Billfish rostra potentially have several functions; however, their role in feeding is unequivocal in some species. Recent work linked morphological variation in rostral micro-teeth to differences in feeding behavior in two billfish species, the striped marlin (Kajikia audax) and the sailfish (Istiophorus platypterus). Here, we present the rostral micro-tooth morphology for a third billfish species, the blue marlin (Makaira nigricans), for which the use of the rostrum in feeding behavior is still undocumented from systematic observations in the wild. We measured the micro-teeth on rostrum tips of blue marlin, striped marlin, and sailfish using a micro–computed tomography approach and compared the tooth morphology among the three species. This was done after an analysis of video-recorded hunting behavior of striped marlin and sailfish revealed that both species strike prey predominantly with the first third of the rostrum, which provided the justification to focus our analysis on the rostrum tips. In blue marlin, intact micro-teeth were longer compared to striped marlin but not to sailfish. Blue marlin had a higher fraction of broken teeth than both striped marlin and sailfish, and broken teeth were distributed more evenly on the rostrum. Micro-tooth regrowth was equally low in both marlin species but higher in sailfish. Based on the differences and similarities in the micro-tooth morphology between the billfish species, we discuss potential feeding-related rostrum use in blue marlin. We put forward the hypothesis that blue marlin might use their rostra in high-speed dashes as observed in striped marlin, rather than in the high-precision rostral strikes described for sailfish, possibly focusing on larger prey organisms.","author_count":20,"contributors":["Pacher, Korbinian","Breuker, Michael","Hansen, Matthew J.","Kurvers, Ralf H.J.M.","Häge, Jan","Dhellemmes, Felicie","Domenici, Paolo","Steffensen, John Fleng","Krause, Stefan","Hildebrandt, Thomas","Fritsch, Guido","Bach, Pascal","Sabarros, Philippe S.","Zaslansky, Paul","Mahlow, Kristin","Müller, Johannes","Armas, Rogelio González","Ortiz, Hector Villalobos","Galván-Magaña, Felipe","Krause, Jens"],"cuid":["S01-000.00-731986"],"filters":{"added":"2024-05","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, Central","Europe, EU","Nordic","OECD"],"country":["Finland","France","Germany","Italy","Mexico"],"glorg":["All Global Affiliations","Charité – Universitätsmedizin Berlin","Humboldt University of Berlin","IRD Institut de Recherche pour le Developpement","Instituto Politécnico Nacional","Leibniz Institute for Zoo and Wildlife Research","Leibniz-Institute of Freshwater Ecology and Inland Fisheries","Lübeck University of Applied Sciences","Max Planck Institute for Human Development","Montpellier University","Museum für Naturkunde - Leibniz Institute for Evolution and Biodiversity Science","National Research Council of Italy (CNR)","Technical University of Berlin","University of Helsinki"],"keyword":["Billfish","Rostrum"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the rostral micro tooth morphology of blue marlin i makaira nigricans i","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1111/jfb.15608","version":"Published Version"},"id":"S01-000.00-731986","identifier":[{"id":"37987173","type":"pmid"},{"id":"85178227219","type":"scopus"}],"ids":["ku-a2eb4e25-801b-4772-a3e1-18e8d450fd50"],"keyword":["billfish","blue marlin","micro-tooth morphology","rostrum"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-5441500A1382BDE18AF5A3EE51395C51"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"