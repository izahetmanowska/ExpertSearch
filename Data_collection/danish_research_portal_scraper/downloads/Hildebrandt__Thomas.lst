carvajalcarmonapau","last":"Carvajal-Carmona","name":"Carvajal-Carmona, Luis G.","rank":49,"rolecode":"pau"},{"affno":"40","first":"Daria","key":"zawirskapau","last":"Zawirska","name":"Zawirska, Daria","rank":50,"rolecode":"pau"},{"affno":"9","first":"Aaron D.","key":"normanpau","last":"Norman","name":"Norman, Aaron D.","rank":51,"rolecode":"pau"},{"affno":"28","first":"Grzegorz","key":"mazurpau","last":"Mazur","name":"Mazur, Grzegorz","rank":52,"rolecode":"pau"},{"affno":"10","first":"Sonja I.","key":"berndtpau","last":"Berndt","name":"Berndt, Sonja I.","rank":53,"rolecode":"pau"},{"affno":"2","first":"Daniele","key":"campapau","last":"Campa","name":"Campa, Daniele","rank":54,"rolecode":"pau"},{"affno":"9","first":"Celine M.","key":"vachonpau","last":"Vachon","name":"Vachon, Celine M.","rank":55,"rolecode":"pau"},{"affno":"1","first":"Federico","key":"canzianpau","last":"Canzian","name":"Canzian, Federico","rank":56,"rolecode":"pau"}],"pmid":["35700034"],"pub":{"doi":"10.1158/1055-9965.epi-22-0043","issn":["10559965","15387755"],"issn_org":["10559965"],"issue":"9","journal":"Cancer Epidemiology, Biomarkers & Prevention","pages":"1863-1866","status":"p","title":"Cancer Epidemiology, Biomarkers & Prevention","title_org":"Cancer Epidemiology Biomarkers and Prevention","volume":"31"},"review":"Peer Reviewed","scoID":["2-s2.0-85137076893"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-7efa12e6-135c-4274-9101-7f4f57484e1e"],"src":["KU University of Copenhagen"],"title":"Does a Multiple Myeloma Polygenic Risk Score Predict Overall Survival of Patients with Myeloma?","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-469448","year":"2022","yearsub":"2022"}
{"abstract":"Declarative process modeling formalisms—which capture high-level process constraints—have seen growing interest, especially for modeling flexible processes. This paper presents DisCoveR, an efficient and accurate declarative miner for learning Dynamic Condition Response (DCR) Graphs from event logs. We present a precise formalization of the algorithm, describe a highly efficient bit vector implementation and present a preliminary evaluation against five other miners, representing the state-of-the-art in declarative and imperative mining. DisCoveR performs competitively with each of these w.r.t. a fully automated binary classification task, achieving an average accuracy of 96.1% in the Process Discovery Contest 2019 (Results are available at https://icpmconference.org/2019/process-discovery-contest). We appeal to computational learning theory to gain insight into its performance as a classifier. Due to its linear time complexity, DisCoveR also achieves much faster run times than other declarative miners. Finally, we show how the miner has been integrated in a state-of-the-art declarative process modeling framework as a model recommendation tool and discuss how discovery can play an integral part of the modeling task and report on how the integration has improved the modeling experience of end-users.","author_count":4,"contributors":["Back, Christoffer Olling","Slaats, Tijs","Hildebrandt, Thomas T.","Marquard, Morten"],"cuid":["S01-000.00-436419"],"filters":{"added":"2023-03","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-PR-OTH","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"discover accurate and efficient discovery of declarative process models","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-436419","identifier":[{"id":"85108999058","type":"scopus"}],"ids":["ku-47fce546-8767-4db7-8b4b-dcbc3b8f8406"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-49FFDB0F308EB2420995D71E6345D4F9"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Software, Data, People & Society"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["DCR Solutions A/S"],"nora_code":"DI-PR-OTH","used":1}],"person":[{"affno":"1","first":"Christoffer Olling","key":"backpau","last":"Back","locid":"0ce144c3-eaf9-43e2-8f2b-03d6e4212b6a","name":"Back, Christoffer Olling","orcid":"0000-0001-7998-7167","rank":1,"rolecode":"pau"},{"affno":"1","first":"Tijs","key":"slaatspau","last":"Slaats","locid":"85f00008-e9c6-439c-aae5-e5bd725f2099","name":"Slaats, Tijs","orcid":"0000-0001-6244-6970","rank":2,"rolecode":"pau"},{"affno":"1","first":"Thomas Troels","key":"hildebrandtpau","last":"Hildebrandt","locid":"c1d69914-5f7a-4f0b-8ffb-766693004328","name":"Hildebrandt, Thomas T.","name_org":"Hildebrandt, Thomas Troels","orcid":"0000-0002-7435-5563","rank":3,"rolecode":"pau"},{"affno":"2","first":"Morten","key":"marquardpau","last":"Marquard","name":"Marquard, Morten","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1007/s10009-021-00616-0","issn":["14332779","14332787"],"issn_org":["14332779"],"issue":"4","journal":"International Journal on Software Tools for Technology Transfer","pages":"563-587","status":"p","title":"International Journal on Software Tools for Technology Transfer","volume":"24"},"review":"Peer Reviewed","scoID":["2-s2.0-85108999058"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Other Companies","Private Research","Universities","University of Copenhagen","dcr solutions a/s"],"PST":["Published"]},"sid":["ku-47fce546-8767-4db7-8b4b-dcbc3b8f8406"],"src":["KU University of Copenhagen"],"title":"DisCoveR : accurate and efficient discovery of declarative process models","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-436419","year":"2022","yearsub":"2022"}
{"abstract":"We provide a formal semantics for timed DCR graphs with decision events and data, and show how the model supports merging declarative decision modelling and process modelling in one notation. We exemplify the model by an expense report process and discuss how decisions may be presented using DMN jointly with the DCR process notation. If data domains are bounded, models are finite state and allow formal verification of both safety and liveness properties. The formal model is fully implemented in commercial process design and workflow management systems provided by DCR Solutions and also freely available for academic use.","author_count":7,"contributors":["Hildebrandt, Thomas T.","Normann, Håkon","Marquard, Morten","Debois, Søren","Slaats, Tijs"],"cuid":["S01-000.00-471470"],"event":{"end":"2021-09-10","place":"Rome, it","start":"2021-09-06","title":"BPM 2021 International Workshops<br/>","year":"2021"},"filters":{"added":"2022-07","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["DCR Graphs","DMN","Data","Declarative modelling","Time"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-PR-OTH","DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"decision modelling in timed dynamic condition response graphs with data","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-471470","identifier":[{"id":"85124662656","type":"scopus"}],"ids":["ku-826bc9eb-f60b-474b-abbe-92533edea43b"],"keyword":["DCR Graphs","DMN","Data","Declarative modelling","Time"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-D6A952C3EAA657A34EFA100A1D950FF8"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"ku universit