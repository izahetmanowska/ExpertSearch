":"perneranderspau","last":"Perner","locid":"8a389541-d529-4ee3-8364-66bfc85f77c9","name":"Perner, Anders","rank":68,"rolecode":"pau"},{"affno":"23","corresponding":null,"first":"Rine Moulvad","key":"siegumfeldtrinemoulvadoth","last":"Siegumfeldt","locid":"e57237fc-4c35-458a-95f8-221a377c8734","name":"Siegumfeldt, Rine Moulvad","rank":69,"role":"Other","rolecode":"oth"},{"affno":"23","corresponding":null,"first":"Stine Rom","key":"vestergaardstineromoth","last":"Vestergaard","locid":"f841510b-8964-42ea-b510-22e1baf0b226","name":"Vestergaard, Stine Rom","rank":70,"role":"Other","rolecode":"oth"}],"pmid":["35709019"],"pub":{"doi":"10.1056/nejmoa2202707","issn":["00284793","15334406"],"issn_org":["00284793"],"issue":"26","journal":"The New England Journal of Medicine","pages":"2459-2470","publisher":"Massachussetts Medical Society","status":"p","title":"The New England Journal of Medicine","title_org":"New England Journal of Medicine","volume":"386"},"review":"Peer Reviewed","scoID":["2-s2.0-85133214877"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","North Denmark Region","Other Research","Region Zealand","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-9eac7765-86f2-4d3c-856f-6537ab1cecb6","au-34a83b86-7b4a-467d-9ec7-adf72b6e7b09","ku-637bb267-bce9-4d5e-8032-f7b892c52dc0","sdu-126603fd-5865-4179-9637-4c1cd22c7ff5"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Restriction of Intravenous Fluid in ICU Patients with Septic Shock","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-096.18-007689","year":"2022","yearsub":"2022"}
{"abstract":"Background: The use of hybrid PET/MRI for clinical staging is growing in several cancer forms and, consequently, PET/MRI has also gained interest in the assessment of non-small cell lung cancer (NSCLC) and lung lesions. However, lung evaluation with PET/MRI is associated with challenges related to technical issues and diagnostic image quality. We, therefore, investigated the published literature on PET/MRI for clinical staging in NSCLC or lung nodule detection specifically addressing diagnostic accuracy and technical issues. Methods: The data originates from a systematic search performed in PubMed/MEDLINE, Embase, and Cochrane Library on hybrid PET/MRI in patients with cancer for a scoping review published earlier (https://doi.org/10.1007/s00259-019-04402-8). Studies in English and German evaluating the diagnostic performance of hybrid PET/MRI for NSCLC or lung nodule detection in cancer patients were selected. Data reported in peer-reviewed journals without restrictions to year of publication were included. Results: A total of 3138 publications were identified from which 116 published 2012–2018 were included. Of these, nine studies addressed PET/MRI in NSCLC (4) or lung nodule detection (5). Overall, PET/MRI did not provide advantages in preoperative T- and N-staging in NSCLC compared to PET/CT. The data on M-staging were too few for conclusions to be drawn. The lung nodule detection rate of PET/MRI was comparable to that of PET/CT for FDG-avid nodules larger than 10 mm, but the sensitivity of PET/MRI for detection of non-FDG-avid nodules smaller than 5 mm was low. Conclusion: PET/MRI did not provide advantages in T- and N-staging of NSCLC compared to PET/CT. PET/MRI had a comparable sensitivity for detection of FDG-avid lung nodules and nodules over 10 mm, but PET/CT yielded a higher detection rate in non FDG-avid lung nodules under 5 mm. With PET/MRI, the overall detection rate for lung nodules in various cancer types remains inferior to that of PET/CT due to the lower diagnostic performance of MRI than CT in the lungs.","author_count":9,"contributors":["Dahlsgaard-Wallenius, Sara Elisabeth","Hildebrandt, Malene Grubbe","Johansen, Allan","Vilstrup, Mie Holm","Petersen, Henrik","Gerke, Oke","Høilund-Carlsen, Poul Flemming","Morsing, Anni","Andersen, Thomas Lund"],"cuid":["S01-000.00-627373"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Dahlsgaard-Wallenius, Sara Elisabeth"],"keyword":["18F FDG","NSCLC","PET CT","PET MRI"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-NOVO"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-PR-NOVO","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"hybrid pet mri in non small cell lung cancer nsclc and lung nodules a literature review","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/172897224/EJNM_D_19_01315_R3_1_.pdf","version":"Authors Final Version"},"id":"S01-000.00-627373","identifier":[{"id":"32719914","type":"pmid"},{"id":"85088645187","type":"scopus"}],"ids":["sdu-bcec58a8-9c6d-4e29-aa05-1d82a64d9a6b"],"keyword":["18F-FDG","Lung lesions","NSCLC","PET/CT","PET/MRI"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-07707BF9B7D6511069D985065B1E2C1C"],"oa_link":[{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/172897224/EJNM_D_19_01315_R3_1_.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SD