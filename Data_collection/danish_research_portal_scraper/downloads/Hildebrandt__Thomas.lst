{"author_count":4,"contributors":["Olsen, Henrik Palmer","Slosser, Jacob Livingston","Hildebrandt, Thomas T.","Wiesener, Cornelius"],"cuid":["S01-000.00-420693"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"nr","rtype":["clu"],"sorti":"what s in the box the legal requirement of explainability in computationally aided decision making in public administration","src":["ku"],"src-code":["DI-U-KU"],"type":"dw","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Andet","type":"loc","url":"https://curis.ku.dk/ws/files/235473618/WorkingPaper_SSRN_id3402974.pdf","version":"Published Version"},"id":"S01-000.00-420693","ids":["ku-2db26651-0080-468b-895a-356c7acab61a"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-A40D086EA5B93DE58DA9A9BD7F469FF1"],"oa_link":[{"access":"oa","license":"Andet","type":"loc","url":"https://curis.ku.dk/ws/files/235473618/WorkingPaper_SSRN_id3402974.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Law, Area of Research, Centre of Excellence for International Courts and Governance"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Henrik Palmer","key":"olsenpau","last":"Olsen","locid":"d6151186-5867-4059-bc35-8e82ae4be33e","name":"Olsen, Henrik Palmer","orcid":"0000-0001-8486-8752","rank":1,"rolecode":"pau"},{"affno":"1","first":"Jacob Livingston","key":"slosserpau","last":"Slosser","locid":"cb822107-30f9-435e-9bb4-28d9870a97fc","name":"Slosser, Jacob Livingston","orcid":"0000-0003-4913-4790","rank":2,"rolecode":"pau"},{"affno":"1","first":"Thomas Troels","key":"hildebrandtpau","last":"Hildebrandt","locid":"c1d69914-5f7a-4f0b-8ffb-766693004328","name":"Hildebrandt, Thomas T.","name_org":"Hildebrandt, Thomas Troels","orcid":"0000-0002-7435-5563","rank":3,"rolecode":"pau"},{"affno":"1","first":"Cornelius","key":"wiesenerpau","last":"Wiesener","locid":"e51ee645-3ce8-41f9-b9a4-918882937c3f","name":"Wiesener, Cornelius","rank":4,"rolecode":"pau"}],"pub":{"issue":"162","pages":"28","publisher":"SSRN: Social Science Research Network","series":"iCourts Working Paper Series","status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-2db26651-0080-468b-895a-356c7acab61a"],"src":["KU University of Copenhagen"],"title":"What's in the Box? : The Legal Requirement of Explainability in Computationally Aided Decision-Making in Public Administration","type":"Working Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-420693","year":"2019","yearsub":"2019"}
{"abstract":"We provide the first formal model for declarative choreographies, which is able to express general omega-regular liveness properties. We use the Dynamic Condition Response (DCR) graphs notation for both choreographies and end-points. We define end-point projection as a restriction of DCR graphs and derive the condition for end-point projectability from the causal relationships of the graph. We illustrate the results with a running example of a Buyer-Seller-Shipper protocol. All the examples are available for simulation in the online DCR workbench at http://dcr.tools/forte19.","author_count":7,"contributors":["Hildebrandt, Thomas T.","Slaats, Tijs","López, Hugo A.","Debois, Søren","Carbone, Marco"],"cuid":["S01-000.00-451792"],"event":{"acronym":"FORTE","end":"2019-06-21","place":"Kongens Lyngby, dk","start":"2019-06-17","title":"39th IFIP WG 6.1 International Conference on Formal Techniques for Distributed Objects, Components, and Systems, FORTE 2019 held as part of the 14th International Federated Conference on Distributed Computing Techniques, DisCoTec 2019","year":"2019"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Choreographies","Declarative models","Liveness"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-PR-OTH","DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"declarative choreographies and liveness","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-451792","identifier":[{"id":"85067365596","type":"scopus"}],"ids":["ku-6184f633-0354-4f87-958c-828245aa7345"],"keyword":["Choreographies","Declarative models","Liveness"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-5-4192F8BEA87681AD39220F45040EF23B"],"oai":{