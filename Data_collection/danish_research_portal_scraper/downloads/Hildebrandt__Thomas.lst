,"rolecode":"pedh"}],"pub":{"isbn":["9788757444896"],"pages":"64-77","place":"København","publisher":"Djøf Forlag","status":"p","subtitle":"Visionen om bæredygtig udvikling","title":"Globale Mål"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Roskilde University","Universities"],"PST":["Published"]},"sid":["ruc-4355d800-9da2-4533-bf00-ff171fa892f5"],"src":["RUC Roskilde University"],"title":"Det Globale Civilsamfund : Aktør i realisering af verdensmålene?","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-560499","year":"2019","yearsub":"2019"}
{"abstract":"The EcoKnow project strives to promote flexible case management systems in the public administration and empower end-users (i.e., case workers) to make sense of digitized models of the law. For this, a hybrid representation combining the declarative DCR notation with textual annotations depicting the law text and a simulation tool to simulate the execution of single process instances was proposed. This hybrid representation aims to overcome the notorious limitations of existing declarative notations in term of understandability. Using eye tracking, this paper investigates how users engage with the different artifacts of the hybrid representation.","author_count":8,"contributors":["Abbad Andaloussi, Amine","Slaats, Tijs","Burattin, Andrea","Hildebrandt, Thomas T.","Weber, Barbara"],"cuid":["S02-091.19-037735"],"event":{"acronym":"BPM","end":"2018-09-14","place":"Sydney, au","start":"2018-09-09","title":"16th International Conference on Business Process Management, BPM 2018","year":"2018"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Abbad Andaloussi, Amine"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"evaluating the understandability of hybrid process model representations using eye tracking first insights","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/250866130/Evaluating_the_Understandability_of_Hybrid_Process_Model_Representations_Using_Eye.pdf","version":"Authors Final Version"},"funding_acknowledgement":["Work supported by the Innovation Fund Denmark project EcoKnow (7050-00034A); the second author additionally by the Danish Council for Independent Research project Hybrid Business Process Management Technologies (DFF-6111-00337)."],"id":"S02-091.19-037735","identifier":[{"id":"85061350833","type":"scopus"}],"ids":["dtu-e65e26a1-0ba0-4404-aeb9-980ffc035aff","ku-07b88c6f-0bc5-4c33-a8d1-c652a150cc33"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-69860A76AFBAA57358404C1D51C07231"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/218530969/2018_dehmimop.pdf","version":"Authors Final Version"},{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/250866130/Evaluating_the_Understandability_of_Hybrid_Process_Model_Representations_Using_Eye.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Applied Mathematics and Computer Science","Technical University of Denmark, Department of Applied Mathematics and Computer Science, Software and Process Engineering"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Software, Data, People & Society"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Amine","key":"abbadandaloussipau","last":"Abbad Andaloussi","locid":"ec567f0e-aa1c-42e2-a523-fccf2f03efbe","name":"Abbad Andaloussi, Amine","orcid":"0000-0002-3404-7849","rank":1,"rolecode":"pau"},{"affno":"2","first":"Tijs","key":"slaatspau","last":"Slaats","locid":"85f00008-e9c6-439c-aae5-e5bd725f2099","name":"Slaats, Tijs","orcid":"0000-0001-6244-6970","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Andrea","key":"burattinpau","last":"Burattin","locid":"75b43f3c-f477-4ac8-8717-c6d2b93bed02","name":"Burattin, Andrea","orcid":"0000-0002-0837-0183","rank":3,"rolecode":"pau"},{"affno":"2","first":"Thomas T.","key":"hildebrandtpau","last":"Hildebrandt","locid":"c1d69914-5f7a-4f0b-8ffb-766693004328","name":"Hildebrandt, Thomas T.","orcid":"0000-0002-7435-5563","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Barbara","key":"weberpau","last":"Weber","locid":"4bbfa31e-3aa1-4565-88b1-8c19946807e6","name":"Weber, Barbara","orcid":"0000-0002-6004-4860","rank":5,"rolecode":"pau"},{"affno":"","first":"Florian","key":"danielpedh","last":"Daniel","name":"Daniel, Florian","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Quan Z.","key":"shengpedh","last":"Sheng","name":"Sheng, Quan Z.","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Hamid","key":"motaharipedh","last":"Motahari","name":"Motahari, Hamid","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-030-11641-5_37","isbn":["9783030116408"],"issn":["18651348"],"pages":"475-481","publisher":"Springer","series":"Lecture Notes in Business Information Processing","status":"p","title":"Business Process Management Workshops - BPM 2018 International Workshops, Revised Papers"},"review":"Peer Reviewed","scoID":["2-s2.0-85061350833"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-e65e26a1-0ba0-4404-aeb9-980ffc035aff","ku-07b88c6f-0bc5-4c33-a8d1-c652a150cc33"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Evaluating the Understandability of Hybrid Process Model Representations Using Eye Tracking: First Insights","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-091.19-037735","year":"2019","yearsub":"2019"}
{"abstract":"Process design artifacts (e.g., process models, textual process descriptions and simulations) are increasingly used to provide input for requirements elicitation and to facilitate the design of business processes. To support the understandability of process models and make them accessible for end-users with different backgrounds, several hybrid representations combining different design artifacts have been proposed in the literature. This paper investigates the understandability of DCR-HR, a new hybrid process design artifact based on DCR graphs. Using eye-tracking and think-aloud techniques, this paper explores the benefits and challenges associated with the use of different design artifacts and investigates the way end-users engage with them. The results motivate the use of DCR-HR and provide insights about the support it provides to end-users with different backgrounds.","author_count":10,"contributors":["Abbad Andaloussi, Amine","Burattin, Andrea","Slaats, Tijs","Petersen, Anette Chelina Møller","Hildebrandt, Thomas","Weber, Barbara"],"cuid":["S02-080.47-033542"],"event":{"end":"2019-06-04","place":"Rome, it","start":"2019-06-03","title":"20th International Conference on Business Process Modeling, Development and Support, BPMDS 2019 and 24th International Conference on Evaluation and Modeling Methods for Systems Analysis and Development, EMMSAD 2019","year":"2019"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, Non-EU","OECD"],"corresponding_author":["Abbad Andaloussi, Amine"],"country":["Switzerland"],"glorg":["All Global Affiliations","University of St. Gallen"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-ITU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"exploring the understandability of a hybrid process design artifact based on dcr graphs","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/250866149/Exploring_the_Understandability_of_a_Hybrid_Process_Design_Artifact_Based_on_DCR.pdf","version":"Authors Final Version"},"id":"S02-080.47-033542","identifier":[{"id":"85069160403","type":"scopus"}],"ids":["dtu-2b5babab-2ca0-4ba0-8229-bb0005c1f69e","ku-aa551baf-6d1b-45a4-9fd0-f2336b5de21c"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-4D31F4FFA2A448E8A921D95F38954047"],"oa_link":[{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/250866149/Exploring_the_Understandability_of_a_Hybrid_Process_Design_Artifact_Based_on_DCR.pdf","version":"Authors Final Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/183365630/camera_ready_version_of_paper.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Applied Mathematics and Computer Science","Technical University of Denmark, Department of Applied Mathematics and Computer Science, Software and Process Engineering"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Software, Data, People & Society"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Amine","key":"abbadandaloussipau","last":"Abbad Andaloussi","locid":"ec567f0e-aa1c-42e2-a523-fccf2f03efbe","name":"Abbad Andaloussi, Amine","orcid":"0000-0002-3404-7849","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Andrea","key":"burattinpau","last":"Burattin","locid":"75b43f3c-f477-4ac8-8717-c6d2b93bed02","name":"Burattin, Andrea","orcid":"0000-0002-0837-0183","rank":2,"rolecode":"pau"},{"affno":"2","first":"Tijs","key":"slaatspau","last":"Slaats","locid":"85f00008-e9c6-439c-aae5-e5bd725f2099","name":"Slaats, Tijs","orcid":"0000-0001-6244-6970","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Anette Chelina Møller","key":"petersenpau","last":"Petersen","name":"Petersen, Anette Chelina Møller","rank":4,"rolecode":"pau"},{"affno":"2","first":"Thomas T.","key":"hildebrandtpau","last":"Hildebrandt","locid":"c1d69914-5f7a-4f0b-8ffb-766693004328","name":"Hildebrandt, Thomas T.","orcid":"0000-0002-7435-5563","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Barbara","key":"weberpau","last":"Weber","locid":"4bbfa31e-3aa1-4565-88b1-8c19946807e6","name":"Weber, Barbara","orcid":"0000-0002-6004-4860","rank":6,"rolecode":"pau"},{"affno":"","first":"Jens","key":"guldenpedh","last":"Gulden","name":"Gulden, Jens","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Iris","key":"reinhartzbergerpedh","last":"Reinhartz-Berger","name":"Reinhartz-Berger, Iris","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Jelena","key":"zdravkovicpedh","last":"Zdravkovic","name":"Zdravkovic, Jelena","rank":9,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Rainer","key":"schmidtpedh","last":"Schmidt","name":"Schmidt, Rainer","rank":10,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-030-20618-5_5","isbn":["9783030206178"],"issn":["18651348"],"pages":"69-84","publisher":"Springer","series":"Lecture Notes in Business Information Processing","status":"p","title":"Enterprise, Business-Process and Information Systems Modeling - 20th International Conference, BPMDS 2019, 24th International Conference, EMMSAD 2019, Held at CAiSE 2019, Proceedings"},"review":"Peer Reviewed","scoID":["2-s2.0-85069160403"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-2b5babab-2ca0-4ba0-8229-bb0005c1f69e","ku-aa551baf-6d1b-45a4-9fd0-f2336b5de21c"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Exploring the Understandability of a Hybrid Process Design Artifact Based on DCR Graphs","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-080.47-033542","year":"2019","yearsub":"2019"}
{"abstract":"AIM: The Danish Study to Assess the Efficacy of Implantable Cardioverter-Defibrillators (ICD) in Patients with Non-ischaemic Systolic Heart Failure (HF) on Mortality (DANISH) found no overall effect on all-cause mortality. The effect of ICD implantation on health-related quality of life (HRQoL) remains to be established as previous trials have demonstrated conflicting results. We investigated the impact of ICD implantation on HRQoL in patients with non-ischaemic systolic HF, a prespecified secondary endpoint in DANISH. METHODS AND RESULTS: In DANISH, a total of 1116 patients with non-ischaemic systolic HF were randomly assigned (1:1) to ICD implantation or usual clinical care (control). Patients completed disease-specific HRQoL as assessed by Minnesota Living with Heart Failure Questionnaire (MLHFQ; 0-105, high indicating worse). Changes in HRQoL 8 months after randomization were assessed with a mixed-effects model. At randomization, MLHFQ was completed by 935 (84%) patients (n = 472 in the ICD group and n = 463 in the control group) and was reassessed in 274 (58%) and 292 (63%) patients, respectively after 8 months for the primary analysis. Patients in the ICD group vs. the control group had similar improvements in MLHFQ after 8 months [least square mean -7.0 vs. -4.2 (P = 0.13)]. A clinically relevant improvement (decrease ≥5) in the MLHFQ overall score at 8 months was observed in 151 patients in the ICD group and 148 patients in the control group [55% vs. 51%, respectively (P = 0.25)]. CONCLUSION: Implantable cardioverter-defibrillator implantation in patients with non-ischaemic systolic HF did not significantly alter HRQoL compared with patients randomized to usual clinical care.","author_count":31,"contributors":["Bundgaard, Johan S","Thune, Jens J","Nielsen, Jens C","Videbæk, Regitze","Haarbo, Jens","Bruun, Niels Eske","Videbæk, Lars","Aagaard, David","Korup, Eva","Jensen, Gunnar","Hildebrandt, Per","Steffensen, Flemming H","Eiskjær, Hans","Brandes, Axel","Thøgersen, Anna Margrethe","Melchior, Thomas M","Pedersen, Ole D","Gustafsson, Finn","Egstrup, Kenneth","Hassager, Christian","Svendsen, Jesper H","Høfsten, Dan E","Torp-Pedersen, Christian","Pedersen, Susanne S","Pehrson, Steen","Køber, Lars","Mogensen, Ulrik M"],"cuid":["S04-100.00-005067"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"corresponding_author":["Bundgaard, Johan S"],"keyword":["Cardiovascular disease","Heart failure","Implantable cardioverter defibrillator","Quality of Life"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-OTH","DI-HO-SDR","DI-HO-ZEA"],"OT":["Frederiksberg Heart Clinic"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-OTH","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"the impact of implantable cardioverter defibrillator implantation on health related quality of life in the danish trial","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85067117894","version":"Other Version"},"id":"S04-100.00-005067","identifier":[{"id":"85067117894","type":"scopus"},{"id":"30796456","type":"pmid"}],"ids":["aau-688da9f8-e190-4525-981b-7ca5006c6407","au-06109428-0aec-4b73-abbb-dec672c515e7","ku-c318ed9e-8316-49c1-9773-96f2fc20e385","sdu-0bfb96a1-6376-43b7-b3e3-3ce9ba702293"],"keyword":["Cardiovascular disease","Heart failure","Implantable cardioverter-defibrillator","Quality of life"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-7-4377EEABE8D2A54F5DB4DFE4637EDA5E"],"oai":{"class":"Unused","mra