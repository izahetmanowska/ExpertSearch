{"author_count":4,"contributors":["Jeuris, Steven","Tell, Paolo","Houben, Steven","Bardram, Jakob E."],"cuid":["S01-000.00-383065"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-ITU"]},"level3all":["DI-U-DTU","DI-U-ITU"]},"review":"nr","rtype":["clu"],"sorti":"the hidden cost of window management","src":["itu"],"src-code":["DI-U-ITU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://arxiv.org/pdf/1810.04673.pdf","version":"Other Version"},"id":"S01-000.00-383065","ids":["itu-7a48bb8b-82d2-4465-8657-9acf4dcab7b4"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-5554480BE489DDC0A02090B86BE7FA37"],"org":[{"affno":"1","country":"dk","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Engineering"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Steven","key":"jeurispau","last":"Jeuris","name":"Jeuris, Steven","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Paolo","key":"tellpau","last":"Tell","locid":"2b8ff3a4-e9b0-403d-8bd8-1bf26121c234","name":"Tell, Paolo","orcid":"0000-0001-7391-0046","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Steven","key":"houbenpau","last":"Houben","name":"Houben, Steven","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jakob E.","key":"bardrampau","last":"Bardram","name":"Bardram, Jakob E.","rank":4,"rolecode":"pau"}],"pub":{"issn":["00000000"],"repno":"CoRR","series":"CoRR","status":"p","volume":"abs/1810.04673"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["itu-7a48bb8b-82d2-4465-8657-9acf4dcab7b4"],"src":["ITU IT University of Copenhagen"],"title":"The Hidden Cost of Window Management","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383065","year":"2018","yearsub":"2018"}
{"abstract":"This paper was accepted and presented in 2017 as a Full Research Paper at the International Conference on Software and Systems Process (ICSSP). This paper examines the question of which software and system development approaches are used in practice. The underlying HELENA study (hybrid dEveLPmENt approaches in software systems development) breaks away from the discussion of \"traditional\" versus \"agile\" development and examines actual combinations of processes and methods in so-called hybrid development approaches. This paper reports on the results of the first stage of the HELENA study, in which 69 participants, mainly European, participated in an online survey. Participants were asked to rate and present 40 different development approaches how and why the approaches are used in their companies / projects. The results show that in practice, a structured traditional process often forms the organizational framework for a project, while fine-grained tasks are addressed through individually introduced agile practices. This combination can be found in almost all companies, regardless of company size and industry. In addition, using affinity propagation clustering and spectral clustering, different combination patterns were derived from the data, which were successfully tested for realism with other external studies. Our study shows the widespread use of hybrid development processes and that they usually arise through an individual learning process.","author_count":11,"contributors":["Kuhrmann, Marco","Diebold, Philipp","Münch, Jürgen","Tell, Paolo","Garousi, Vahid","Felderer, Michael","Trektere, Kitija","McCaffery, Fergal","Linssen, Oliver","Hanser, Eckhart","Prause, Christian"],"cuid":["S01-000.00-384152"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Austria","Germany","Ireland","Netherlands"],"glorg":["All Global Affiliations","Clausthal University of Technology","Dundalk Institute of Technology","FOM University of Applied Sciences","Fraunhofer Institute for Experimental Software Engineering","German Aerospace Center","Reutlingen University","University of Applied Sciences Baden-Württemberg Lörrach","University of Innsbruck","Wageningen University & Research"],"keyword":["Affinity Propagation Clustering","Hybrid Development Approaches","Process Combination Patterns","Software Systems Development","Traditional vs Agile Processes"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"hybrid software and system development in practice","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://pure.itu.dk/ws/files/83857827/A1_39.pdf","version":"Published Version"},"id":"S01-000.00-384152","ids":["itu-c4c392e6-43ed-4065-9227-062a0fd21138"],"keyword":["Affinity Propagation Clustering","Hybrid Development Approaches","Process Combination Patterns","Software Systems Development","Traditional vs. Agile Processes"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-70C53590B76515D9AACC5165F7585919"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"rem","url":"https://dl.gi.de/bitstream/handle/20.500.12116/16326/A1-39.pdf?sequence=1&isAllowed=y","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"rem","url":"https://dl.gi.de/handle/20.500.12116/16326","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://pure.itu.dk/ws/files/83857827/A1_39.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","country":"de","key":"clausthal university of technology","loc":["German