u","last":"Tell","locid":"2b8ff3a4-e9b0-403d-8bd8-1bf26121c234","name":"Tell, Paolo","name_org":"Tell, P.","orcid":"0000-0001-7391-0046","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Jil","key":"klünderpau","last":"Klünder","name":"Klünder, Jil","rank":5,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"T.","key":"contepau","last":"Conte","name":"Conte, T.","rank":6,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Stephen G.","key":"macdonellpau","last":"MacDonell","name":"MacDonell, Stephen G.","rank":7,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Regina","key":"hebigpau","last":"Hebig","name":"Hebig, Regina","rank":8,"rolecode":"pau"}],"pub":{"doi":"10.1109/icse-seet.2019.00009","pages":"1-11","publisher":"IEEE","status":"p","title":"2019 IEEE/ACM 41st International Conference on Software Engineering: Software Engineering Education and Training (ICSE-SEET)"},"review":"Peer Reviewed","scoID":["2-s2.0-85072106054"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-64c83607-c69d-4e9a-80c9-d34c25ec8366"],"src":["ITU IT University of Copenhagen"],"title":"Walking Through the Method Zoo: Does Higher Education Really Meet Software Industry Demands?","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382775","year":"2019","yearsub":"2019"}
{"abstract":"The surveyed companies applied hybrid development approaches to specific projects even when company-wide policies for process usage existed. These approaches emerged from the evolution of different work practices and were consistently used regardless of company size or industry sector.","author_count":11,"contributors":["Kuhrmann, Marco","Diebold, P.","Munch, J.","Tell, Paolo","Trektere, K.","McCaffery, F.","Garousi, V.","Felderer, M.","Linssen, O.","Hanser, E.","Prause, C. R."],"cuid":["S01-000.00-382409"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Agile practices","Agile software development","European perspective","Hybrid Development Approaches","Management of Computing and Information Systems","Organisational aspects","Organizational aspects","Software Management","Software development","Software development management","Software development practice","Software process","Work practices","company wide policies","computing milieux","hybrid development approach","hybrid software development approaches","process usage","software development method","traditional development approach"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"hybrid software development approaches in practice a european perspective","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84929331/2017_08_31_helena_ieee_sw_author_small.pdf","version":"Authors Final Version"},"id":"S01-000.00-382409","identifier":[{"id":"85034583163","type":"scopus"}],"ids":["itu-4c37f65c-b8d0-46ec-9507-a1cc5ac0e40d"],"keyword":["Agile software development","European perspective","Organizational aspects","Software development","Software process","agile practices","compan