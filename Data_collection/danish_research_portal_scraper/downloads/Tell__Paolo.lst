],"name":"Lancaster University","used":1},{"affno":"4","country":"us","key":"university of colorado boulder","loc":["United States","America, North","OECD"],"name":"University of Colorado Boulder","used":1},{"affno":"5","country":"us","key":"university of colorado","loc":["United States","America, North","OECD"],"name":"University of Colorado","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jakob Eyvind","key":"bardrampau","last":"Bardram","locid":"ab5f4cf7-e35a-4011-a892-1f0de591f2b9","name":"Bardram, Jakob Eyvind","orcid":"0000-0003-1390-8758","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Steven Tom","key":"jeurispau","last":"Jeuris","locid":"f2fa8274-2858-404c-b993-fef507b81304","name":"Jeuris, Steven Tom","orcid":"0000-0001-9645-8275","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Paolo","key":"tellpau","last":"Tell","locid":"2b8ff3a4-e9b0-403d-8bd8-1bf26121c234","name":"Tell, Paolo","orcid":"0000-0001-7391-0046","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Steven","key":"houbenpau","last":"Houben","name":"Houben, Steven","rank":4,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"first":"Stephen","key":"voidapau","last":"Voida","name":"Voida, Stephen","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1145/3325901","issn":["00010782","10591192"],"issn_org":["00010782"],"issue":"8","journal":"Communications of the ACM","pages":"72-81","publisher":"Association for Computing Machinery","status":"p","title":"Communications of the ACM","title_org":"Communications of the A C M","volume":"62"},"review":"Peer Reviewed","scoID":["2-s2.0-85073911960"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-ce3e324a-0199-4620-83ad-4cb14ddd68c4","itu-682af743-eca6-47c0-9703-8d2d978c4d7f"],"src":["DTU Technical University of Denmark","ITU IT University of Copenhagen"],"title":"Activity-Centric Computing Systems","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-086.49-037239","year":"2019","yearsub":"2019"}
{"abstract":"Background: Agile and distributed software development are two trends that continue to increase rapidly in today's software industry. Even though the benefits achievable by combining them are potentially many, the intrinsic challenges of such marriage often lead to severe complications that can jeopardize the successful completion of software projects. Method: To investigate empirically how these two trends can coexist without compromising on the agile core values and principles, we conducted an exploratory holistic case study. Focusing on the development team of a Danish SME having both distributed offices as well as teleworking arrangements, we showcase (the evolution of) their practices. Results: The case is an example of the effective application of the agile reflective culture that allowed the company to evolve to a level in which the collocation restrictions of agile software development are overcome by a continuously evolving software process geared towards reducing waste to achieve speed and simplicity. Conclusions: Even though results need to be considered carefully due to the single nature of the reported case, we highlight five elements that have been fundamental in such journey: agile servant-leader, agile team, trust, virtual work environment, inspect & adapt, and reduce waste. Extensive information is provided to frame the context and to allow meaningful future comparisons.","author_count":5,"contributors":["Lous, Pernille","Tell, Paolo","Michelsen, Christian Bo","Dittrich, Yvonne","Ebdrup, Allan"],"cuid":["S01-000.00-384049"],"event":{"acronym":"ICSP","title":"International Conference on Software and Systems Process"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["agile software development case study continuous deployment continuous software engineering distributed software engineering software process improvement"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"from scrum to agile a journey to tackle the challenges of distributed development in an agile team","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83527136/ICSSP_2018_author_version.pdf","version":"Authors Final Version"},"id":"S01-000.00-384049","identifier":[{"id":"85048358650","type":"scopus"}],"ids":["itu-bddc0cb2-59e9-41a7-8b27-fdce2e25909c"],"keyword":["agile software development, case study, continuous deployment, continuous software engineering, distributed software engineering, software process improvement"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-E625A56E7AF9656A40670F6CBA7E9AF1"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83527136/ICSSP_2018_author_version.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Pernille","key":"louspau","last":"Lous","name":"Lous, Pernille","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Paolo","key":"tellpau","last":"Tell","locid":"2b8ff3a4-e9b0-403d-8bd8-1bf26121c234","name":"Tell, Paolo","orcid":"0000-0001-7391-0046","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Christian Bo","key":"michelsenpau","last":"Michelsen","name":"Michelsen, Christian Bo","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yvonne","key":"ditt