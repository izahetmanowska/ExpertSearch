h Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-586588fb-1f33-43b8-bbec-bd6ee005b40e"],"src":["ITU IT University of Copenhagen"],"title":"The dBoard: a Digital Scrum Board for Distributed Software Development","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382580","year":"2015","yearsub":"2015"}
