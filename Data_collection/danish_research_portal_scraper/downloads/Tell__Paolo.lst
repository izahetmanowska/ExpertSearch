neering, Software Engineering"],"nora_code":"DI-U-ITU","used":1},{"affno":"3","country":"in","key":"accenture bengaluru innovation hub","loc":["India","Asia, South"],"name":"Accenture Bengaluru Innovation Hub","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Fabio","key":"calefatopau","last":"Calefato","name":"Calefato, Fabio","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Paolo","key":"tellpau","last":"Tell","locid":"2b8ff3a4-e9b0-403d-8bd8-1bf26121c234","name":"Tell, Paolo","orcid":"0000-0001-7391-0046","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Alpana","key":"dubeypau","last":"Dubey","name":"Dubey, Alpana","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1145/3356773.3356802","issn":["01635948","19435843"],"issn_org":["01635948"],"issue":"3","journal":"Software Engineering Notes","pages":"30-33","publisher":"Association for Computing Machinery","status":"p","title":"Software Engineering Notes","volume":"44"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-408855f2-5cf6-4b6d-a2c7-233ebd5bc4da"],"src":["ITU IT University of Copenhagen"],"title":"Summary of the 14th International Conference on Global Software Engineering (ICGSE)","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382222","year":"2019","yearsub":"2019"}
{"abstract":"Software engineering educators are continually challenged by rapidly evolving concepts, technologies, and industry demands. Due to the omnipresence of software in a digitalized society, higher education institutions (HEIs) have to educate the students such that they learn how to learn, and that they are equipped with a profound basic knowledge and with latest knowledge about modern software and system development. Since industry demands change constantly, HEIs are challenged in meeting such current and future demands in a timely manner. This paper analyzes the current state of practice in software engineering education. Specifically, we want to compare contemporary education with industrial practice to understand if frameworks, methods and practices for software and system development taught at HEIs reflect industrial practice. For this, we conducted an online survey and collected information about 67 software engineering courses. Our findings show that development approaches taught at HEIs quite closely reflect industrial practice. We also found that the choice of what process to teach is sometimes driven by the wish to make a course successful. Especially when this happens for project courses, it could be beneficial to put more emphasis on building learning sequences with other courses.","author_count":8,"contributors":["Kuhrmann, Marco","Nakatumba-Nabende, J.","Pfeiffer, Helge","Tell, Paolo","Klünder, Jil","Conte, T.","MacDonell, Stephen G.","Hebig, Regina"],"cuid":["S01-000.00-382775"],"event":{"acronym":"ICSE","title":"International Conference on Software Engineering"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Africa","America, South","Europe, EU","Nordic","OECD","Oceania"],"country":["Brazil","Germany","New Zealand","Sweden","Uganda"],"glorg":["All Global Affiliations","Auckland University of Technology","Chalmers University of Technology","Federal University of Amazonas","Leibniz Universität Hannover","Makerere University","University of Passau"],"keyword":["Computer Science Education","DP industry","Education","Educational courses","Educational institutions","Further education","HEIs","Higher education institutions","Software Engineering","Software Engineering Education","Software development","Software process","Survey research","System development","Teaching","hybrid methods","software engineering courses","software engineering educators","software industry demands"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"walking through the method zoo does higher education really meet software industry demands","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84934224/Walking_Through_the_Method_Zoo_Does_Higher_Education_Really_Meet_Software_Industry_Demands_.pdf","version":"Authors Final Version"},"id":"S01-000.00-382775","identifier":[{"id":"85072106054","type":"scopus"}],"ids":["itu-64c83607-c69d-4e9a-80c9-d34c25ec8366"],"keyword":["DP industry","HEIs","computer science education","education","educational courses","educational institutions","further education","higher education institutions","hybrid methods","software development","software engineering","software engineering courses","software engineering education","software engineering educators","software industry demands","software process","survey research","system development","teaching"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-C005AAE9D26B5970A1353CECBD014050"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84934224/Walking_Through_the_Method_Zoo_Does_Higher_Education_Really_Meet_Software_Industry_Demands_.pdf","version":"Authors Final 