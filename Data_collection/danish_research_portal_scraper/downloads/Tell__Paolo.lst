onpau","last":"Richardson","name":"Richardson, Ita","rank":47,"rolecode":"pau"}],"pub":{"doi":"10.1109/tse.2021.3099532","issn":["00985589","19393520"],"issn_org":["00985589"],"issue":"9","journal":"IEEE Transactions on Software Engineering","pages":"3523-3539","publisher":"IEEE","status":"p","title":"IEEE Transactions on Software Engineering","volume":"48"},"review":"Peer Reviewed","scoID":["2-s2.0-85112653399"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Miscellaneous","Other Research","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["itu-df83e492-acad-48ce-80a1-dc67c532b229","sdu-300d853b-473d-4ae7-8e5c-82ee92b9db1e"],"src":["ITU IT University of Copenhagen","SDU University of Southern Denmark"],"title":"What Makes Agile Software Development Agile","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-095.45-038398","year":2022,"yearsub":"2022"}
{"abstract":"This paper presents the design of eight tools for working with psychological safety in agile software teams, which were designed in collaboration with industry practitioners using design science. The tools were adopted over a two-week period by four Danish industry software teams and evaluated through team interviews and surveys. Results show that the designed tools can be successfully adopted and integrated in the practices of a software team. Participating teams found the tool format valuable, as it allowed them (i) to engage in discussions they were not always capable of having, (ii) to find the right shared vocabulary to frame these discussions, and (iii) to provide them with needed prompts to let such discussion surface. Finally, teams unanimously reported interest in the continued use of the designed tools.","author_count":6,"contributors":["Christensen, Mikkel Agerlin","Tell, Paolo"],"cuid":["S01-000.00-383732"],"event":{"acronym":"AGILE","title":"Agile Development Conference"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Agile Software Teams","Design science","Industry collaboration","Psychological safety","Team Communication Tools"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"building a toolbox for working with psychological safety in agile software teams","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/92456739/Building_A_Toolbox_for_Working_with_PS_in_Agile_Software_Teams.pdf","version":"Authors Final Version"},"id":"S01-000.00-383732","identifier":[{"id":"85133019432","type":"scopus"}],"ids":["itu-a9c2936f-9841-46b8-9930-aae51aabc602"],"keyword":["Agile Software Teams","Design Science","Industry Collaboration","Psychological Safety","Team Communication Tools"],"lang":"Undetermined","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-F369185F0D44BF2A1801FFA83B5803EB"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/92456739/Building_A_Toolbox_for_Working_with_PS_in_Agile_Software_Teams.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Mikkel Agerlin","key":"christensenpau","last":"Christensen","name":"Christensen, Mikkel Agerlin","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Paolo","key":"tellpau","last":"Tell","locid":"2b8ff3a4-e9b0-403d-8bd8-1bf26121c234","name":"Tell, Paolo","orcid":"0000-0001-7391-0046","rank":2,"rolecode":"pau"},{"affno":"","first":"Viktoria","key":"straypedh","last":"Stray","name":"Stray, Viktoria","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Klaas-Jan","key":"stolpedh","last":"Stol","name":"Stol, Klaas-Jan","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Maria","key":"paasivaarapedh","last":"Paasivaara","name":"Paasivaara, Maria","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Philippe","key":"kruchtenpedh","last":"Kruchten","name":"Kruchten, Philippe","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-031-08169-9_6","isbn":["9783031081699"],"pages":"82-98","place":"Cham","publisher":"Springer","status":"p","title":"Agile Processes in Software Engineering and Extreme Programming"},"review":"Peer Reviewed","scoID":["2-s2.0-85133019432"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-a9c2936f-9841-46b8-9930-aae51aabc602"],"src":["ITU IT University of Copenhagen"],"title":"Building a Toolbox for Working with Psychological Safety in Agile Software Teams","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383732","year":"2022","yearsub":"2022"}
{"abstract":"Hardly any software development process is used as prescribed by authors or standards. Regardless of company size or industry sector, a majority of project teams and companies use hybrid development methods (short: hybrid methods) that combine different development methods and practices. Even though such hybrid methods are highly individualized, a common understanding of how to systematically construct synergetic practices is missing. In this article, we make a first step towards a statistical construction procedure for hybrid methods. Grounded in 1467 data points from a large‐scale practitioner survey, we study the question: What are hybrid methods made of and how can they be systematically constructed? Our findings show that only eight methods and few practices build the core of modern software development. Using an 85% agreement level in the participants' selections, we provide examples illustrating how hybrid methods can be characterized by the practices they are made of. Furthermore, using this characterization, we develop an initial construction procedure, which allows for defining a method frame and enriching it incrementally to devise a hybrid method using ranked sets of practice.","author_count":9,"contributors":["Tell, Paolo","Klünder, Jil","Küpper, Steffen","Raffo, David","MacDonell, Stephen","Münch, Jürgen","Pfahl, Dietmar","Linssen, Oliver","Kuhrmann, Marco"],"cuid":["S01-000.00-382110"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Europe, EU","OECD","Oceania"],"country":["Estonia","Germany","New Zealand","United States"],"glorg":["All Global Affiliations","Auckland University of Technology","Clausthal University of Technology","FOM University of Applied Sciences","Leibniz University Hannover","Portland State University","Reutlingen University","University of Passau","University of Tartu"],"keyword":["Software development","Software process","Survey research","hybrid methods"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"towards the statistical construction of hybrid development methods","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85582912/2020_08_31_paper_web.pdf","version":"Authors Final Version"},"id":"S01-000.00-382110","identifier":[{"id":"85096761266","type":"scopus"}],"ids":["itu-39418e9e-2933-4580-90de-fb7cfa33cd43"],"keyword":["hybrid methods","software development","software process","survey research"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-746B4190C4791C4F961917747DF4ADBC"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85582912/2020_08_31_paper_web.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Engineering"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"de","key":"leibniz university hannover","loc":["Germany","Europe, EU","OECD"],"name":"Leibniz University Hannover","used":1},{"affno":"3","country":"de","key":"clausthal university of technology","loc":["Germany","Europe, EU","OECD"],"name":"Clausthal University of Technology","used":1},{"affno":"4","country":"us","key":"portland state university","loc":["United States","America, North","OECD"],"name":"Portland S