{"abstract":"The span of most chemical shifts recorded in conventional 25Mg-NMR spectroscopy is ~ 100 ppm. Accordingly, linewidths of ~ 10 ppm or better are desirable to achieve adequate resolution for applications in chemistry. Here we present first high-field 31Mg- β-NMR measurements of 31Mg+ ions implanted into a MgO single crystal carried out at the ISAC facility at TRIUMF. The resonances recorded at 2.5 T and 3.5 T show strong linewidth dependency on the applied RF power, ranging from ~ 419 ppm for the highest RF power down to ~ 48 ppm for the lowest one.","author_count":20,"contributors":["Stachura, M.","McFadden, R. M. L.","Chatzichristos, A.","Dehn, M. H.","Gottberg, A.","Hemmingsen, Lars Bo Stegeager","Jancso, A.","Karner, V. L.","Kiefl, R. F.","Larsen, Flemming Hofmann","Lassen, J.","Levy, C. D. P.","Li, R.","MacFarlane, W. A.","Morris, G. D.","Pallada, S.","Pearson, M. R.","Szunyogh, Daniel","Thulstrup, Peter Waaben","Voss, A."],"cuid":["S01-000.00-434424"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Europe, EU","Europe, Non-EU","Nordic","OECD"],"country":["Canada","Finland","Hungary","Switzerland"],"glorg":["All Global Affiliations","CERN","TRIUMF","University of British Columbia","University of Jyväskylä","University of Szeged"],"keyword":["Linewidth","Magnesium","NMR"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"towards sup 000000000031 sup mg β nmr resonance linewidths adequate for applications in magnesium chemistry","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-434424","identifier":[{"id":"000401504500003","type":"wos"},{"id":"85013078323","type":"scopus"}],"ids":["ku-449e9ea9-a649-4984-b2c4-65ae4c8ffdab"],"keyword":["Linewidth","Magnesium","Metallobiochemistry","NMR","beta-NMR"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-B644F7A5432C638BAA341ADF08B1B12D"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","country":"ca","key":"triumf","loc":["Canada","America, North","OECD"],"name":"TRIUMF","used":1},{"affno":"2","country":"ca","key":"university of british columbia","loc":["Canada","America, North","OECD"],"name":"University of British Columbia","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Chemistry, Department of Chemistry"],"nora_code":"DI-U-KU","used":1},{"affno":"4","country":"hu","key":"university of szeged","loc":["Hungary","Europe, EU","OECD"],"name":"University of Szeged","used":1},{"affno":"5","country":"ch","key":"cern","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"CERN","used":1},{"affno":"6","country":"fi","key":"university of jyväskylä","loc":["Finland","Europe, EU","Nordic","OECD"],"name":"University of Jyväskylä","used":1}],"person":[{"affno":"1","first":"M.","key":"stachurapau","last":"Stachura","name":"Stachura, M.","rank":1,"rolecode":"pau"},{"affno":"2","first":"R. M. L.","key":"mcfaddenpau","last":"McFadden","name":"McFadden, R. M. L.","rank":2,"rolecode":"pau"},{"affno":"2","first":"A.","key":"chatzichristospau","last":"Chatzichristos","name":"Chatzichristos, A.","rank":3,"rolecode":"pau"},{"affno":"2","first":"M. H.","key":"dehnpau","last":"Dehn","name":"Dehn, M. H.","rank":4,"rolecode":"pau"},{"affno":"1","first":"A.","key":"gottbergpau","last":"Gottberg","name":"Gottberg, A.","rank":5,"rolecode":"pau"},{"affno":"3","first":"Lars Bo Stegeager","key":"hemmingsenpau","last":"Hemmingsen","locid":"6a84ab43-ff33-409e-954d-3ca73fafada5","name":"Hemmingsen, Lars Bo Stegeager","orcid":"0000-0002-1823-3035","rank":6,"rolecode":"pau"},{"affno":"4","first":"A.","key":"jancsopau","last":"Jancso","name":"Jancso, A.","rank":7,"rolecode":"pau"},{"affno":"2","first":"V. L.","key":"karnerpau","last":"Karner","name":"Karner, V. L.","rank":8,"rolecode":"pau"},{"affno":"2","first":"R. F.","key":"kieflpau","last":"Kiefl","name":"Kiefl, R. F.","rank":9,"rolecode":"pau"},{"affno":"3","first":"Flemming Hofmann","key":"larsenpau","last":"Larsen","locid":"eda11dab-a7a0-43f1-91cc-0087bd5538b5","name":"Larsen, Flemming Hofmann","orcid":"0000-0001-5180-6870","rank":10,"rolecode":"pau"},{"affno":"1","first":"J.","key":"lassenpau","last":"Lassen","name":"Lassen, J.","rank":11,"rolecode":"pau"},{"affno":"1","first":"C. D. P.","key":"levypau","last":"Levy","name":"Levy, C. D. P.","rank":12,"rolecode":"pau"},{"affno":"1","first":"R.","key":"lipau","last":"Li","name":"Li, R.","rank":13,"rolecode":"pau"},{"affno":"2","first":"W. A.","key":"macfarlanepau","last":"MacFarlane","name":"MacFarlane, W. A.","rank":14,"rolecode":"pau"},{"affno":"1","first":"G. D.","key":"morrispau","last":"Morris","name":"Morris, G. D.","rank":15,"rolecode":"pau"},{"affno":"5","first":"S.","key":"palladapau","last":"Pallada","name":"Pallada, S.","rank":16,"rolecode":"pau"},{"affno":"1","first":"M. R.","key":"pearsonpau","last":"Pearson","name":"Pearson, M. R.","rank":17,"rolecode":"pau"},{"affno":"3","first":"Daniel Mihaly","key":"szunyoghpau","last":"Szunyogh","locid":"ab2652e4-a5e8-4c2e-b0ad-e19a4166a2d5","name":"Szunyogh, Daniel","name_org":"Szunyogh, Daniel Mihaly","orcid":"0000-0001-9161-7257","rank":18,"rolecode":"pau"},{"affno":"3","first":"Peter Waaben","key":"thulstruppau","last":"Thulstrup","locid":"043e3b07-d7e1-4f25-9359-6f55b4e2ba92","name":"Thulstrup, Peter Waaben","orcid":"0000-0002-9241-4352","rank":19,"rolecode":"pau"},{"affno":"6","first":"A.","key":"vosspau","last":"Voss","name":"Voss, A.","rank":20,"rolecode":"pau"}],"pub":{"doi":"10.1007/s10751-017-1408-8","issn":["03043843","15729540"],"issn_org":["03043843"],"issue":"1","journal":"Hyperfine Interactions","paperid":"32","status":"p","title":"Hyperfine Interactions","volume":"238"},"review":"Peer Reviewed","scoID":["2-s2.0-85013078323"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-449e9ea9-a649-4984-b2c4-65ae4c8ffdab"],"src":["KU University of Copenhagen"],"title":"Towards <sup>31</sup>Mg-β-NMR resonance linewidths adequate for applications in magnesium chemistry","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-434424","year":"2017","yearsub":"2017"}
{"abstract":"Genome-wide association (GWA) studies have identified 19 independent common risk loci for endometriosis. Most of the GWA variants are non-coding and the genes responsible for the association signals have not been identified. Herein, we aimed to assess the potential role of protein-modifying variants in endometriosis using exome-array genotyping in 7164 cases and 21005 controls, and a replication set of 1840 cases and 129016 controls of European ancestry. Results in the discovery sample identified significant evidence for association with coding variants in single-variant (rs1801232-CUBN) and gene-level (CIITA and PARP4) meta-analyses, but these did not survive replication. In the combined analysis, there was genome-wide significant evidence for rs13394619 (P = 2.3 × 10(-9)) in GREB1 at 2p25.1 - a locus previously identified in a GWA meta-analysis of European and Japanese samples. Despite sufficient power, our results did not identify any protein-modifying variants (MAF > 0.01) with moderate or large effect sizes in endometriosis, although these variants may exist in non-European populations or in high-risk families. The results suggest continued discovery efforts should focus on genotyping large numbers of surgically-confirmed endometriosis cases and controls, and/or sequencing high-risk families to identify novel rare variants to provide greater insights into the molecular pathogenesis of the disease.","author_count":26,"contributors":["Sapkota, Yadav","Vivo, Immaculata De","Steinthorsdottir, Valgerdur","Fassbender, Amelie","Bowdler, Lisa","Buring, Julie E","Edwards, Todd L","Jones, Sarah","O, Dorien","Peterse, Daniëlle","Rexrode, Kathryn M","Ridker, Paul M","Schork, Andrew J","Thorleifsson, Gudmar","Wallace, Leanne M","Kraft, Peter","Morris, Andrew P","Nyholt, Dale R","Edwards, Digna R Velez","Nyegaard, Mette","D'Hooghe, Thomas","Chasman, Daniel I","Stefansson, Kari","Missmer, Stacey A","Montgomery, Grant W"],"cuid":["S02-085.84-019910"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","Europe, EU","Europe, Non-EU","Nordic","OECD","Oceania"],"corpau":["iPSYCH-SSI-Broad Group"],"country":["Australia","Belgium","Iceland","United Kingdom","United States"],"glorg":["All Global Affiliations","Harvard University","KU Leuven","Queensland Institute of Medical Research","Queensland University of Technology","St. Jude Children Research Hospital","University of Iceland","University of Liverpool","University of Queensland","Vanderbilt University","deCODE Genetics"],"keyword":["Journal Article"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"analysis of potential protein modifying variants in 000000009000 endometriosis patients and 000000150000 controls of european ancestry","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41598-017-10440-9","version":"Published Version"},"id":"S02-085.84-019910","identifier":[{"id":"28900119","type":"pmid"},{"id":"85029324920","type":"scopus"},{"id":"PMC5595920","type":"pmcid"}],"ids":["au-63b68439-4a4a-4a26-9bf8-2c111c9fa06d","ku-8e68455f-1a6c-4d02-967d-4e75ba6def39"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-4D52A77F21C52DE9912DB8FA99337B36"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/189347804/s41598_017_10440_9.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41598-017-10440-9","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2