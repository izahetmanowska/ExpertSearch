ntry":"ch","key":"world health organization","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"World Health Organization","used":1},{"affno":"12","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Nutrition, Exercise and Sports, Movement and Neuroscience"],"nora_code":"DI-U-KU","used":1},{"affno":"13","country":"ch","key":"who wmo joint climate and health office geneva","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"WHO/WMO Joint Climate and Health Office, Geneva","used":1},{"affno":"14","country":"nl","key":"vggm","loc":["Netherlands","Europe, EU","OECD"],"name":"VGGM","used":1}],"person":[{"affno":"1","first":"Hein","key":"daanenpau","last":"Daanen","name":"Daanen, Hein","rank":1,"rolecode":"pau"},{"affno":"2 3 4","first":"Stephan","key":"boseoreillypau","last":"Bose-O’Reilly","name":"Bose-O’Reilly, Stephan","rank":2,"rolecode":"pau"},{"affno":"5","first":"Matt","key":"brearleypau","last":"Brearley","name":"Brearley, Matt","rank":3,"rolecode":"pau"},{"affno":"6","first":"D. Andreas","key":"flourispau","last":"Flouris","name":"Flouris, D. Andreas","rank":4,"rolecode":"pau"},{"affno":"1","first":"Nicola M","key":"gerrettpau","last":"Gerrett","name":"Gerrett, Nicola M","rank":5,"rolecode":"pau"},{"affno":"7","first":"Maud","key":"huynenpau","last":"Huynen","name":"Huynen, Maud","rank":6,"rolecode":"pau"},{"affno":"8","first":"Hunter M","key":"jonespau","last":"Jones","name":"Jones, Hunter M","rank":7,"rolecode":"pau"},{"affno":"9","first":"Jason Kai Wei","key":"leepau","last":"Lee","name":"Lee, Jason Kai Wei","rank":8,"rolecode":"pau"},{"affno":"","first":"Nathan Bradley","key":"morrispau","last":"Morris","locid":"795844d6-4d76-49f3-9e28-7cf966133da4","name":"Morris, Nathan Bradley","orcid":"0000-0003-0201-066X","rank":9,"rolecode":"pau"},{"affno":"10 11","first":"Ian","key":"nortonpau","last":"Norton","name":"Norton, Ian","rank":10,"rolecode":"pau"},{"affno":"12","first":"Lars","key":"nybopau","last":"Nybo","locid":"2c75532e-9e05-43c2-8d51-42a8456aba2e","name":"Nybo, Lars","orcid":"0000-0002-9090-1958","rank":11,"rolecode":"pau"},{"affno":"2","first":"Elspeth","key":"oppermannpau","last":"Oppermann","name":"Oppermann, Elspeth","rank":12,"rolecode":"pau"},{"affno":"11 13","first":"Joy","key":"shumakeguillemotpau","last":"Shumake-Guillemot","name":"Shumake-Guillemot, Joy","rank":13,"rolecode":"pau"},{"affno":"14","first":"Peter","key":"vandenhazelpau","last":"Van den Hazel","name":"Van den Hazel, Peter","rank":14,"rolecode":"pau"}],"pmid":["33553500"],"pub":{"doi":"10.1080/23328940.2020.1790971","issn":["23328940","23328959"],"issn_org":["23328940"],"issue":"1","journal":"Temperature","pages":"1-11","status":"p","title":"Temperature","volume":"8"},"review":"Peer Reviewed","scoID":["2-s2.0-85089190580"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-7acc7081-95ea-4816-873b-0f4555f66eef"],"src":["KU University of Copenhagen"],"title":"COVID-19 and thermoregulation-related problems: Practical recommendations","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-466964","year":"2021","yearsub":"2021"}
{"abstract":"Context. This work is part of the Gaia Data Processing and Analysis Consortium papers published with the Gaia Early Data Release 3 (EDR3). It is one of the demonstration papers aiming to highlight the improvements and quality of the newly published data by applying them to a scientific case. Aims. We use the Gaia EDR3 data to study the structure and kinematics of the Magellanic Clouds. The large distance to the Clouds is a challenge for the Gaia astrometry. The Clouds lie at the very limits of the usability of the Gaia data, which makes the Clouds an excellent case study for evaluating the quality and properties of the Gaia data. Methods. The basis of our work are two samples selected to provide a representation as clean as possible of the stars of the Large Magellanic Cloud (LMC) and the Small Magellanic Cloud (SMC). The selection used criteria based on position, parallax, and proper motions to remove foreground contamination from the Milky Way, and allowed the separation of the stars of both Clouds. From these two samples we defined a series of subsamples based on cuts in the colour-magnitude diagram; these subsamples were used to select stars in a common evolutionary phase and can also be used as approximate proxies of a selection by age. Results. We compared the Gaia Data Release 2 and Gaia EDR3 performances in the study of the Magellanic Clouds and show the clear improvements in precision and accuracy in the new release. We also show that the systematics still present in the data make the determination of the 3D geometry of the LMC a difficult endeavour; this is at the very limit of the usefulness of the Gaia EDR3 astrometry, but it may become feasible with the use of additional external data. We derive radial and tangential velocity maps and global profiles for the LMC for the several subsamples we defined. To our knowledge, this is the first time that the two planar components of the ordered and random motions are derived for multiple stellar evolutionary phases in a galactic disc outside the Milky Way, showing the differences between younger and older phases. We also analyse the spatial structure and motions in the central region, the bar, and the disc, providing new insightsinto features and kinematics. Finally, we show that the Gaia EDR3 data allows clearly resolving the Magellanic Bridge, and we trace the density and velocity flow of the stars from the SMC towards the LMC not only globally, but also separately for young and evolved populations. This allows us to confirm an evolved population in the Bridge that is slightly shift from the younger population. Additionally, we were able to study the outskirts of both Magellanic Clouds, in which we detected some well-known features and indications of new ones.","author_count":50,"contributors":["Luri, X.","Chemin, L.","Clementini, G.","Delgado, H. E.","McMillan, P. J.","Romero-Gomez, M.","Balbinot, E.","Castro-Ginard, A.","Mor, R.","Ripepi, V.","Sarro, L. M.","Cioni, M. -R. L.","Fabricius, C.","Garofalo, A.","Helmi, A.","Muraveva, T.","Brown, A. G. A.","Vallenari, A.","Prusti, T.","de Bruijne, J. H. J.","Babusiaux, C.","Biermann, M.","Creevey, O. L.","Evans, D. W.","Eyer, L.","Hutton, A.","Jansen, F.","Jordi, C.","Klioner, S. A.","Lammers, U.","Lindegren, L.","Mignard, F.","Panem, C.","Pourbaix, D.","Randich, S.","Sartoretti, P.","Soubiran, C.","Walton, N. A.","Arenou, F.","Bailer-Jones, C. A. L.","Smith, M.","Anderson, R. I.","Gerlach, E.","Hauser, M.","Lindstrøm, Hans Erik Peter","Morris, D.","Pagani, C.","Siebert, A.","Stephenson, C. A.","Zhao, H."],"cuid":["S01-000.00-470134"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, South","Europe, EU","Europe, Non-EU","Nordic","OECD"],"corpau":["Gaia Collaboration"],"country":["Belgium","Chile","France","Germany","Italy","Netherlands","Spain","Sweden","Switzerland","United Kingdom"],"glorg":["All Global Affiliations","Aurora Techno