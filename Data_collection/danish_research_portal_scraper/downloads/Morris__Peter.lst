last":"McCarthy","name":"McCarthy, Mark I.","rank":235,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"James B.","key":"meigsjamesbpau","last":"Meigs","name":"Meigs, James B.","rank":236,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Anubha","key":"mahajananubhapau","last":"Mahajan","name":"Mahajan, Anubha","rank":237,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Robert A.","key":"scottrobertapau","last":"Scott","name":"Scott, Robert A.","rank":238,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Anna L.","key":"gloynannalpau","last":"Gloyn","name":"Gloyn, Anna L.","rank":239,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Inês","key":"barrosoinêspau","last":"Barroso","name":"Barroso, Inês","rank":240,"rolecode":"pau"}],"pmid":["39280063"],"pub":{"doi":"10.12688/wellcomeopenres.18754.1","issn":["2398502X"],"journal":"Wellcome Open Research","paperid":"483","publisher":"F1000 Research Ltd","publisher_org":"F1000 Research Ltd.","status":"p","title":"Wellcome Open Research","volume":"8"},"review":"Peer Reviewed","scoID":["2-s2.0-85204904115"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-66ef8917-2111-47bf-9d0f-8f4711d16c2d","ku-3b86f1af-883d-4715-a4fd-2c8eb2a1f065","sdu-bd1bdaa1-2e98-4731-b576-509ec6c1fe50"],"src":["AAU Aalborg University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Large-scale exome array summary statistics resources for glycemic traits to aid effector gene prioritization","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-093.22-792897","year":"2023","yearsub":"2023"}
{"abstract":"Background: A scientific framework on exposure science will boost the multiuse of exposure knowledge across EU chemicals-related policies and improve risk assessment, risk management and communication across EU safety, security and sustainability domains. Objective: To stimulate public and private actors to align and strengthen the cross-policy adoption of exposure assessment data, methods and tools across EU legislation. Methods: By mapping and analysing the EU regulatory landscape making use of exposure information, policy and research challenges and key areas of action are identified and translated into opportunities enhancing policy and scientific efficiency. Results: Identified key areas of actions are to develop a common scientific exposure assessment framework, supported by baseline acceptance criteria and a shared knowledge base enhancing exchangeability and acceptability of exposure knowledge within and across EU chemicals-related policies. Furthermore, such framework will improve communication and management across EU chemical safety, security and sustainability policies comprising sourcing, manufacturing and global trade of goods and waste management. In support of building such a common framework and its effective use in policy and industry, exposure science innovation needs to be better embedded along the whole policymaking cycle, and be integrated into companies' safety and sustainability management systems. This will help to systemically improve regulatory risk management practices. Significance: This paper constitutes an important step towards the implementation of the EU Green Deal and its underlying policy strategies, such as the Chemicals Strategy for Sustainability.","author_count":19,"contributors":["Bruinen de Bruin, Yuri","Franco, Antonio","Ahrens, Andreas","Morris, Alick","Verhagen, Hans","Kephalopoulos, Stylianos","Dulio, Valeria","Slobodnik, Jaroslav","Sijm, Dick T. H. M.","Vermeire, Theo","Ito, Takaaki","Takaki, Koki","De Mello, Jonathas","Bessems, Jos","Zare Jeddi, Maryam","Tanarro Gozalo, Celia","Pollard, Kevin","McCourt, Josephine","Fantke, Peter"],"cuid":["S01-000.00-352369"],"filters":{"added":"2022-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"corresponding_author":["Bruinen de Bruin, Yuri"],"country":["Belgium","Finland","France","Netherlands","Slovakia"],"glorg":["All Global Affiliations","Environmental Institute, s.r.o.","European Chemicals Agency","European Commission","European Commission Joint Research Centre Institute","Flemish Institute for Technological Research","Institut national de l'environnement industriel et des risques","National Institute of Public Health and the Environment","Netherlands Food and Consumer Product Safety Authority","Organisation for Economic Co-operation and Development","United Nations Environment Programme"],"keyword":["Chemical Safety","EU Green Deal","Environmental sustainability","Exposure assessment","ISES Europe"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"enhancing the use of exposure science across eu chemical policies as part of the european exposure science strategy 000000002020 000000002030","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41370-021-00388-4","version":"Published Version"},"id":"S01-000.00-352369","identifier":[{"id":"85117933803","type":"scopus"},{"id":"34697409","type":"pmid"},{"id":"PMC9349036","type":"pmcid"}],"ids":["dtu-a0329334-fa8a-43dd-b6b2-c714be7d2ac7"],"keyword":["Chemical safety","Chemical security","EU Green Deal","Environmental sustainability","Exposure assessment","ISES Europe"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"