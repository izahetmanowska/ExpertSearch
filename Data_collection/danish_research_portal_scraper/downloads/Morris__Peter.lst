no":"2","corresponding":null,"first":"Timothy D.","key":"mortonpau","last":"Morton","name":"Morton, Timothy D.","rank":62,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Martin","key":"stillpau","last":"Still","name":"Still, Martin","rank":63,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Susan E.","key":"thompsonpau","last":"Thompson","name":"Thompson, Susan E.","rank":64,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Fergal","key":"mullallypau","last":"Mullally","name":"Mullally, Fergal","rank":65,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Michael","key":"endlpau","last":"Endl","name":"Endl, Michael","rank":66,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Phillip J.","key":"macqueenpau","last":"MacQueen","name":"MacQueen, Phillip J.","rank":67,"rolecode":"pau"}],"pub":{"doi":"10.1088/0067-0049/201/2/15","issn":["20418205","20418213"],"issn_org":["20418205"],"issue":"2","journal":"The Astrophysical Journal Letters","publisher":"American Astronomical Society","status":"p","title":"The Astrophysical Journal Letters","volume":"201"},"review":"Peer Reviewed","scoID":["2-s2.0-84863822941"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-5980f85b-ea6a-4254-a1a2-00c1c6b006b1"],"src":["AU Aarhus University"],"title":"Planet Occurrence within 0.25 AU of Solar-type Stars from Kepler","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-180345","year":"2012","yearsub":"2012"}
{"abstract":"Genome-wide association studies have identified hundreds of loci for type 2 diabetes, coronary artery disease and myocardial infarction, as well as for related traits such as body mass index, glucose and insulin levels, lipid levels, and blood pressure. These studies also have pointed to thousands of loci with promising but not yet compelling association evidence. To establish association at additional loci and to characterize the genome-wide significant loci by fine-mapping, we designed the \"Metabochip,\" a custom genotyping array that assays nearly 200,000 SNP markers. Here, we describe the Metabochip and its component SNP sets, evaluate its performance in capturing variation across the allele-frequency spectrum, describe solutions to methodological challenges commonly encountered in its analysis, and evaluate its performance as a platform for genotype imputation. The metabochip achieves dramatic cost efficiencies compared to designing single-trait follow-up reagents, and provides the opportunity to compare results across a range of related traits. The metabochip and similar custom genotyping arrays offer a powerful and cost-effective approach to follow-up large-scale genotyping and sequencing studies and advance our understanding of the genetic basis of complex human diseases and traits.","author_count":49,"contributors":["Voight, Benjamin F","Kang, Hyun Min","Ding, Jun","Palmer, Cameron D","Sidore, Carlo","Chines, Peter S","Burtt, Noël P","Fuchsberger, Christian","Li, Yanming","Erdmann, Jeanette","Frayling, Timothy M","Heid, Iris M","Jackson, Anne U","Johnson, Toby","Kilpeläinen, Tuomas O","Lindgren, Cecilia M","Morris, Andrew P","Prokopenko, Inga","Randall, Joshua C","Saxena, Richa","Soranzo, Nicole","Speliotes, Elizabeth K","Teslovich, Tanya M","Wheeler, Eleanor","Maguire, Jared","Parkin, Melissa","Potter, Simon","Rayner, N William","Robertson, Neil","Stirrups, Kathleen","Winckler, Wendy","Sanna, Serena","Mulas, Antonella","Nagaraja, Ramaiah","Cucca, Francesco","Barroso, Inês","Deloukas, Panos","Loos, Ruth J F","Kathiresan, Sekar","Munroe, Patricia B","Newton-Cheh, Christopher","Pfeufer, Arne","Samani, Nilesh J","Schunkert, Heribert","Hirschhorn, Joel N","Altshuler, David","McCarthy, Mark I","Abecasis, Gonçalo R","Boehnke, Michael"],"cuid":["S01-000.00-465662"],"filters":{"added":"2022-04","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Alleles","Anthropometry","Cardiovascular Diseases","Diabetes Mellitus Type 2","Gene Frequency","Genome Human","Genome Wide Association Study","Genotype","Genotyping Techniques","Humans","Metabolomics","Oligonucleotide Array Sequence Analysis","Phenotype","Polymorphism Single Nucleotide","Quantitative Trait Loci"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the metabochip a custom genotyping array for genetic studies of metabolic cardiovascular and anthropometric traits","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1371/journal.pgen.1002793","version":"Other Version"},"id":"S01-000.00-465662","identifier":[{"id":"PMC3410907","type":"pmcid"},{"id":"84865693681","type":"scopus"},{"id":"22876189","type":"pmid"}],"ids":["ku-78a617dc-22cc-48ba-b2b1-bd0d902310db"],"keyword":["Alleles","Anthropometry","Cardiovascular Diseases","Diabetes Mellitus, Type 2","Gene Frequency","Genome, Human","Genome-Wide Association Study","Genotype","Genotyping Techniques","Humans","Metabolomics","Oligonucleotide Array Sequence Analysis","Phenotype","Polymorphism, Single Nucleotide","Quantitative Trait Loci"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-66BB88445E0A2E447EE272926B90903B"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1371/journal.p