ocid":"5223d59a-d9b3-41ee-9664-4f1313d4b8c6","name":"Melbye, Mads","orcid":"0000-0001-8264-6785","rank":309,"rolecode":"pau"},{"affno":"4","first":"Camilla S.","key":"morgencamillaspau","last":"Morgen","locid":"cdeb58f1-1a74-4186-9d41-f3eccd19677f","name":"Morgen, Camilla S.","rank":313,"rolecode":"pau"},{"affno":"4","first":"Henrik","key":"larssonhenrikbwpau","last":"Larsson","locid":"3c09e175-dfd1-4df5-9132-536a42c19373","name":"Larsson, Henrik B W","name_org":"Larsson, Henrik","rank":415,"rolecode":"pau"}],"pmid":["30887376"],"pub":{"doi":"10.1007/s10654-019-00502-9","issn":["03932990","15737284"],"issn_org":["03932990"],"issue":"3","journal":"European Journal of Epidemiology","pages":"279-300","publisher":"Springer Science and Business Media BV","publisher_org":"Springer Science and Business Media B.V.","status":"p","title":"European Journal of Epidemiology","volume":"34"},"review":"Peer Reviewed","sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["dtu-00a79dd4-df7d-4583-8a17-6c949ee97174","ku-b8c677a0-f71f-490f-bf13-bdeb41864494","sdu-eefb7a57-e16f-4f5d-ae82-5c5c87b061a6"],"src":["DTU Technical University of Denmark","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"The Early Growth Genetics (EGG) and EArly Genetics and Lifecourse Epidemiology (EAGLE) consortia: design, results and future prospects","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-086.77-032564","year":"2019","yearsub":"2019"}
{"abstract":"Introduction: The terminology for nocturia and nocturnal lower urinary tract function is reviewed and updated in a clinically and practically-based consensus report. Methods: This report has been created by a Working Group under the auspices and guidelines of the International Continence Society (ICS) Standardisation Steering Committee (SSC). All relevant definitions were updated on the basis of research over the last 16 years since the publication of the first nocturia standardization document in 2002. An extensive process of 16 rounds of internal and external reviews was involved to examine each definition exhaustively, with decision-making by collective opinion (consensus). Results: A clinically-based terminology report for nocturia and nocturnal lower urinary tract function, encompassing five key definitions divided into signs and symptoms has been developed. Clarity and user-friendliness have been key aims to make it interpretable by healthcare professionals and allied healthcare practitioners involved in the care of individuals with nocturnal lower urinary tract function. Conclusion: A consensus-based terminology report for nocturia and nocturnal lower urinary tract function has been produced to aid clinical practice and research.","author_count":9,"contributors":["Hashim, Hashim","Blanker, Marco H.","Drake, Marcus J.","Djurhuus, Jens Christian","Meijlink, Jane","Morris, Vikky","Petros, Peter","Wen, Jian Guo","Wein, Alan"],"cuid":["S01-000.00-222689"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Asia, East","Europe, EU","Europe, Non-EU","OECD","Oceania"],"corresponding_author":["Hashim, Hashim"],"country":["Australia","China","Netherlands","United Kingdom","United States"],"glorg":["All Global Affiliations","Pennsylvania State University","Taunton and Somerset NHS Trust","The First Affiliated Hospital of Zhengzhou University","University of Bristol","University of Groningen","University of New South Wales"],"keyword":["Enuresis","Nocturia","Nocturnal polyuria","Terminology"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"international continence society ics report on the terminology for nocturia and nocturnal lower urinary tract function","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85060178171","version":"Other Version"},"id":"S01-000.00-222689","identifier":[{"id":"30644584","type":"pmid"},{"id":"85060178171","type":"scopus"}],"ids":["au-a3e02ed2-bdd3-463f-b33c-50f08fab9ef2"],"keyword":["International Continence Society","enuresis","nocturia","nocturnal polyuria","terminology"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-C1D62EA61C19440D05EF111F33B72FDC"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","country":"nl","key":"university of groningen","loc":["Netherlands","Europe, EU","OECD"],"name":"University of Groningen","used":1},{"affno":"2","country":"gb","key":"university of bristol","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Bristol","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine"],"nora_code":"DI-U-AU","used":1},{"affno":"4","country":"gb","key":"taunton and somerset nhs trust","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Taunton and Somerset NHS Trust","used":1},{"affno":"5","country":"au","key":"university of new south wales","loc":["Austr