ty of Denmark, Department of Technology, Management and Economics, Innovation, Engineering Systems Design"],"nora_code":"DI-U-DTU","used":1},{"affno":"6","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Organization"],"nora_code":"DI-U-CBS","used":1},{"affno":"7","country":"gb","key":"association for project management","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Association for Project Management (APM)","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Efrosyni","key":"konstantinoupau","last":"Konstantinou","name":"Konstantinou, Efrosyni","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Vedran","key":"zerjavpau","last":"Zerjav","name":"Zerjav, Vedran","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Sittimont","key":"kanjanabootrapau","last":"Kanjanabootra","name":"Kanjanabootra, Sittimont","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Satu","key":"teerikangaspau","last":"Teerikangas","name":"Teerikangas, Satu","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Satu","key":"teerikangaslpau","last":"Teerikangasl","name":"Teerikangasl, Satu","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Magnus","key":"hellströmpau","last":"Hellström","name":"Hellström, Magnus","rank":5,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Christian","key":"thuesenpau","last":"Thuesen","locid":"cc120585-8af4-4c32-a1e1-29eaaca1727a","name":"Thuesen, Christian","orcid":"0000-0003-3552-7796","rank":6,"rolecode":"pau"},{"affno":"6","corresponding":null,"country":"dk","first":"Joana","key":"geraldipau","last":"Geraldi","locid":"3e0eb86c-70e3-47d8-b228-513d9edd3662","name":"Geraldi, Joana","orcid":"