 Pamela","St Clair, David","Walters, James T R","Werge, Thomas","Sullivan, Patrick F.","O'Donovan, Michael C.","Scherer, Stephen W.","Neale, Benjamin M.","Sebat, Jonathan"],"cuid":["S02-089.55-035398"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"201-1000 contributors","class":"merged","cluster_size":2,"corpau":["CNV and Schizophrenia Working Groups of the Psychiatric Genomics Consortium"],"keyword":["Genetics"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-AU","DI-U-DTU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-AU","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"contribution of copy number variants to schizophrenia from a genome wide study of 000000000041 000000000321 subjects","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/151666469/2017MarshallContributionOfCopyNatGen.pdf","version":"Authors Final Version"},"id":"S02-089.55-035398","identifier":[{"id":"27869829","type":"pmid"},{"id":"PMC5737772","type":"pmcid"},{"id":"84997770295","type":"scopus"}],"ids":["dtu-7a27d5f6-733e-44b3-a4e7-1adae4282aa6","ku-bac293b3-341a-414e-b991-08565852c280"],"keyword":["Genetics"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-1C3D46222225E2F378955D4A7A9B0B9D"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/151666469/2017MarshallContributionOfCopyNatGen.pdf","version":"Authors Final Version"},{"access":"oa","license":"http://europepmc.org/Copyright","type":"rem","url":"http://europepmc.org/articles/pmc5737772?pdf=render","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"k