o":"","first":"Paolo","key":"sorrentinopaolopau","last":"Sorrentino","name":"Sorrentino, Paolo","rank":145,"rolecode":"pau"},{"affno":"","first":"Mark","key":"kristiansenmarkpau","last":"Kristiansen","name":"Kristiansen, Mark","rank":146,"rolecode":"pau"},{"affno":"","first":"Huei Hsin","key":"chianghueihsinpau","last":"Chiang","name":"Chiang, Huei Hsin","rank":147,"rolecode":"pau"},{"affno":"","first":"Caroline","key":"graffcarolinepau","last":"Graff","name":"Graff, Caroline","rank":148,"rolecode":"pau"},{"affno":"","first":"Florence","key":"pasquierflorencepau","last":"Pasquier","name":"Pasquier, Florence","rank":149,"rolecode":"pau"},{"affno":"","first":"Adeline","key":"rollinadelinepau","last":"Rollin","name":"Rollin, Adeline","rank":150,"rolecode":"pau"},{"affno":"","first":"Vincent","key":"deramecourtvincentpau","last":"Deramecourt","name":"Deramecourt, Vincent","rank":151,"rolecode":"pau"},{"affno":"","first":"Florence","key":"lebertflorencepau","last":"Lebert","name":"Lebert, Florence","rank":152,"rolecode":"pau"},{"affno":"","first":"Dimitrios","key":"kapogiannisdimitriospau","last":"Kapogiannis","name":"Kapogiannis, Dimitrios","rank":153,"rolecode":"pau"},{"affno":"","first":"Luigi","key":"ferrucciluigipau","last":"Ferrucci","name":"Ferrucci, Luigi","rank":154,"rolecode":"pau"},{"affno":"","first":"Stuart","key":"pickeringbrownstuartpau","last":"Pickering-Brown","name":"Pickering-Brown, Stuart","rank":155,"rolecode":"pau"},{"affno":"","first":"Andrew B.","key":"singletonandrewbpau","last":"Singleton","name":"Singleton, Andrew B.","rank":156,"rolecode":"pau"},{"affno":"","first":"John","key":"hardyjohnpau","last":"Hardy","name":"Hardy, John","rank":157,"rolecode":"pau"},{"affno":"","first":"Parastoo","key":"momeniparastoopau","last":"Momeni","name":"Momeni, Parastoo","rank":158,"rolecode":"pau"},{"affno":"","first":"Roel A.","key":"ophoffroelapau","last":"Ophoff","name":"Ophoff, Roel A.","rank":159,"rolecode":"pau"}],"pmid":["33637304"],"pub":{"doi":"10.1016/j.biopsych.2020.12.023","issn":["00063223","18732402"],"issn_org":["00063223"],"issue":"8","journal":"Biological Psychiatry","pages":"825-835","status":"p","title":"Biological Psychiatry","volume":"89"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-8d1c3bb5-dd60-4dda-acb8-d35b4f6e895e"],"src":["KU University of Copenhagen"],"title":"Gene Expression Imputation Across Multiple Tissue Types Provides Insight Into the Genetic Architecture of Frontotemporal Dementia and Its Clinical Subtypes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-477814","year":"2021","yearsub":"2021"}
{"abstract":"Heat extremes (ie, heatwaves) already have a serious impact on human health, with ageing, poverty, and chronic illnesses as aggravating factors. As the global community seeks to contend with even hotter weather in the future as a consequence of global climate change, there is a pressing need to better understand the most effective prevention and response measures that can be implemented, particularly in low-resource settings. In this Series paper, we describe how a future reliance on air conditioning is unsustainable and further marginalises the communities most vulnerable to the heat. We then show that a more holistic understanding of the thermal environment at the landscape and urban, building, and individual scales supports the identification of numerous sustainable opportunities to keep people cooler. We summarise the benefits (eg, effectiveness) and limitations of each identified cooling strategy, and recommend optimal interventions for settings such as aged care homes, slums, workplaces, mass gatherings, refugee camps, and playing sport. The integration of this information into well communicated heat action plans with robust surveillance and monitoring is essential for reducing the adverse health consequences of current and future extreme heat.","author_count":15,"contributors":["Jay, Ollie","Capon, Anthony","Berry, Peter","Broderick, Carolyn","de Dear, Richard","Havenith, George","Honda, Yasushi","Kovats, R Sari","Ma, Wei","Malik, Arunima","Morris, Nathan Bradley","Nybo, Lars","Seneviratne, Sonia I","Vanos, Jennifer","Ebi, Kristie L"],"cuid":["S01-000.00-482607"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Asia, East","Europe, Non-EU","OECD","Oceania"],"country":["Australia","Canada","China","Japan","Switzerland","United Kingdom","United States"],"glorg":["All Global Affiliations","Arizona State University","ETH Zürich","London School of Hygiene and Tropical Medicine","Loughborough University","Monash University","School of Medical Sciences, UNSW Medicine, Sydney","Shandong University","The Children's Hospital at Westmead, Sydney","University of Sydney","University of Tsukuba","University of Washington","University of Waterloo"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"reducing the health effects of hot weather and heat extremes from personal cooling strategies to green cities","src":["ku"],"src-code":["DI-U-KU"],"type":"djr","type-grp":["all","pub"]},"id":"S01-000.00-482607","identifier":[{"id":"85113172211","type":"scopus"},{"id":"34419206","type":"pmid"}],"ids":["ku-9541c901-9738-4114-aa13-4b6ae4c0cfd1"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-A2AA533E10D123273A2DF916409DC091"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"au","key":"university of sydney","loc":["Australia","Oceania","OECD"],"name":"University of Sydney","used":1},{"affno":"2","country":"au","key":"monash university","loc":["Australia","Oceania","OECD"],"name":"Monash University","used":1},{"affno":"3","country":"ca","key":"university of waterloo","loc":["Canada","America, North","OECD"],"name":"University of Waterloo","used":1},{"affno":"4","country":"au","key":"school of medical sciences unsw medicine sydney","loc":["Australia","Oceania","OECD"],"name":"School of Medical Sciences, UNSW Medicine, Sydney","used":1},{"affno":"5","country":"au","key":"the children s hospital at westmead sydney","loc":["Australia","Oceania","OECD"],"name":"The Children's Hospital at Westmead, Sydney","used":1},{"affno":"6","country":"gb","key":"loughborough university","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Loughborough University","used":1},{"