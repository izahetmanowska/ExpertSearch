pau","last":"Varbo","name":"Varbo, Anette","rank":334,"rolecode":"pau"},{"affno":"","first":"Peter","key":"whincuppeterpau","last":"Whincup","name":"Whincup, Peter","rank":335,"rolecode":"pau"},{"affno":"","first":"Gianluigi","key":"zazagianluigipau","last":"Zaza","name":"Zaza, Gianluigi","rank":336,"rolecode":"pau"},{"affno":"","first":"Weihua","key":"zhangweihuapau","last":"Zhang","name":"Zhang, Weihua","rank":338,"rolecode":"pau"},{"affno":"1","first":"Marianne","key":"bennmariannepau","last":"Benn","locid":"b9e8f763-a852-4910-8b80-6d3b75b4aee3","name":"Benn, Marianne","orcid":"0000-0002-1701-595X","rank":339,"rolecode":"pau"}],"pmid":["26367797"],"pub":{"doi":"10.1038/nature14962","issn":["00280836","14764687"],"issn_org":["00280836"],"issue":"7571","journal":"Nature","pages":"82-90","status":"p","title":"Nature","volume":"526"},"review":"Peer Reviewed","scoID":["2-s2.0-84943182742"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-444ba8bd-45f5-4791-9bb4-84b96c0d33d6"],"src":["KU University of Copenhagen"],"title":"The UK10K project identifies rare variants in health and disease","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-434235","year":"2015","yearsub":"2015"}
{"abstract":"Variants associated with blood lipid levels may be population-specific. To identify low-frequency variants associated with this phenotype, population-specific reference panels may be used. Here we impute nine large Dutch biobanks (∼35,000 samples) with the population-specific reference panel created by the Genome of the Netherlands Project and perform association testing with blood lipid levels. We report the discovery of five novel associations at four loci (P value -4), including a rare missense variant in ABCA6 (rs77542162, p.Cys1359Arg, frequency 0.034), which is predicted to be deleterious. The frequency of this ABCA6 variant is 3.65-fold increased in the Dutch and its effect (βLDL-C =0.135, βTC =0.140) is estimated to be very similar to those observed for single variants in well-known lipid genes, such as LDLR.","author_count":125,"contributors":["Van Leeuwen, Elisabeth M.","Karssen, Lennart C.","Deelen, Joris","Isaacs, Aaron","Medina-Gomez, Carolina","Mbarek, Hamdi","Kanterakis, Alexandros","Trompet, Stella","Postmus, Iris","Verweij, Niek","Van Enckevort, David J.","Huffman, Jennifer E.","White, Charles C.","Feitosa, Mary F.","Bartz, Traci M.","Manichaikul, Ani","Joshi, Peter K.","Peloso, Gina M.","Deelen, Patrick","Van Dijk, Freerk","Willemsen, Gonneke","De Geus, Eco J.","Milaneschi, Yuri","Penninx, Brenda W J H","Francioli, Laurent C.","Menelaou, Androniki","Pulit, Sara L.","Rivadeneira, Fernando","Hofman, Albert","Oostra, Ben A.","Franco, Oscar H.","Leach, Irene Mateo","Beekman, Marian","De Craen, Anton J M","Uh, Hae Won","Trochet, Holly","Hocking, Lynne J.","Porteous, David J.","Sattar, Naveed","Packard, Chris J.","Buckley, Brendan M.","Brody, Jennifer A.","Bis, Joshua C.","Rotter, Jerome I.","Mychaleckyj, Josyf C.","Campbell, Harry","Duan, Qing","Lange, Leslie A.","Wilson, James F.","Hayward, Caroline","Polasek, Ozren","Vitart, Veronique","Rudan, Igor","Wright, Alan F.","Rich, Stephen S.","Psaty, Bruce M.","Borecki, Ingrid B.","Kearney, Patricia M.","Stott, David J.","Cupples, L. Adrienne","Jukema, J. Wouter","Van Der Harst, Pim","Sijbrands, Eric J.","Hottenga, Jouke Jan","Uitterlinden, Andre G.","Swertz, Morris A.","Van Ommen, Gert Jan B","De Bakker, Paul I W","Eline Slagboom, P.","Boomsma, Dorret I.","Wijmenga, Cisca","Van Duijn, Cornelia M.","Neerincx, Pieter B T","Elbers, Clara C.","Palamara, Pier Francesco","Peer, Itsik","Abdellaoui, Abdel","Kloosterman, Wigard P.","Van Oven, Mannis","Vermaat, Martijn","Li, Mingkun","Laros, Jeroen F J","Stoneking, Mark","De Knijff, Peter","Kayser, Manfred","Veldink, Jan H.","Van Den Berg, Leonard H.","Byelas, Heorhiy","Den Dunnen, Johan T.","Dijkstra, Martijn","Amin, Najaf","Van Der Velde, K. Joeri","Van Setten, Jessica","Kattenberg, Mathijs","Van Schaik, Barbera D C","Bot, Jan","Nijman, Isaäc J.","Mei, Hailiang","Koval, Vyacheslav","Ye, Kai","Lameijer, Eric Wubbo","Moed, Matthijs H.","Hehir-Kwa, Jayne Y.","Handsaker, Robert E.","Sunyaev, Shamil R.","Sohail, Mashaal","Hormozdiari, Fereydoun","Marschall, Tobias","Schönhuth, Alexander","Guryev, Victor","Suchiman, H. Eka D","Wolffenbuttel, Bruce H.","Platteel, Mathieu","Pitts, Steven J.","Potluri, Shobha","Cox, David R.","Li, Qibin","Li, Yingrui","Du, Yuanping","Chen, Ruoyan","Cao, Hongzhi","Li, Ning","Cao, Sujie","Wang, Jun","Bovenberg, Jasper A."],"cuid":["S01-000.00-445666"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"51-200 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-PR-OTH","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"genome of the netherlands population specific imputations identify an i abca000000000006 i variant associated with cholesterol levels","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1038/ncomms7065","version":"Published Version"},"id":"S01-000.00-445666","identifier":[{"id":"25751400","type":"pmid"},{"id":"PMC4366498","type":"pmcid"},{"id":"84924363528","type":"scopus"}],"ids":["ku-5761109d-46a4-45e1-829f-04a64bae5ede"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-B552E2E75B6FBF2F69A4910C2A9F1887"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1038/ncomms7065","version":"Published Version"},{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/153603725/Genome_of_the_Netherlands_population_specific_imputations_identify_an_ABCA6_variant_associated_with_cholesterol_levels.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["BGI-Europe"],"nora_code":"DI-PR-OTH","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Basic Metabolic Research, Human Genomics and Metagenomics in Metabolism","Københavns Universitet, Faculty of Science, Department of Biology, Genome Research and Molecular Bio Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Elisabeth M.","key":"vanleeuwenelisabethmpau","last":"Van Leeuwen","name":"Van Leeuwen, Elisabeth M.","rank":1,"rolecode":"pau"},{"affno":"","first":"Lennart C.","key":"karssenlennartcpau","last":"Karssen","name":"Karssen, Lennart C.","rank":2,"rolecode":"pau"},{"affno":"","first":"Joris","key":"deelenj