","rank":207,"rolecode":"pau"},{"affno":"1","first":"James T R","key":"waltersjamestrpau","last":"Walters","name":"Walters, James T R","rank":208,"rolecode":"pau"},{"affno":"32","first":"Guangbiao","key":"wangguangbiaopau","last":"Wang","name":"Wang, Guangbiao","rank":209,"rolecode":"pau"},{"affno":"48","first":"Jun","key":"wangjunpau","last":"Wang","locid":"5dee6edc-2876-496f-a341-4a07933f9928","name":"Wang, Jun","rank":210,"rolecode":"pau"},{"affno":"32","first":"Yu","key":"wangyupau","last":"Wang","name":"Wang, Yu","rank":211,"rolecode":"pau"},{"affno":"14","first":"Kirsten","key":"wardkirstenpau","last":"Ward","name":"Ward, Kirsten","rank":212,"rolecode":"pau"},{"affno":"7","first":"Elanor","key":"wheelerelanorpau","last":"Wheeler","name":"Wheeler, Elanor","rank":213,"rolecode":"pau"},{"affno":"21","first":"Tamieka","key":"whytetamiekapau","last":"Whyte","name":"Whyte, Tamieka","rank":214,"rolecode":"pau"},{"affno":"1","first":"Hywel","key":"williamshywelpau","last":"Williams","name":"Williams, Hywel","rank":215,"rolecode":"pau"},{"affno":"25","first":"Kathleen A.","key":"williamsonkathleenapau","last":"Williamson","name":"Williamson, Kathleen A.","rank":216,"rolecode":"pau"},{"affno":"23","first":"Crispian","key":"wilsoncrispianpau","last":"Wilson","name":"Wilson, Crispian","rank":217,"rolecode":"pau"},{"affno":"7","first":"Kim","key":"wongkimpau","last":"Wong","name":"Wong, Kim","rank":218,"rolecode":"pau"},{"affno":"11","first":"Chang Jiang","key":"xuchangjiangpau","last":"Xu","name":"Xu, Chang Jiang","rank":219,"rolecode":"pau"},{"affno":"6","first":"Jian","key":"yangjianpau","last":"Yang","name":"Yang, Jian","rank":220,"rolecode":"pau"},{"affno":"14","first":"Fend","key":"zhangfendpau","last":"Zhang","name":"Zhang, Fend","rank":221,"rolecode":"pau"},{"affno":"32","first":"Pingbo","key":"zhangpingbopau","last":"Zhang","name":"Zhang, Pingbo","rank":222,"rolecode":"pau"}],"pmid":["25743335"],"pub":{"doi":"10.1038/ncomms6681","issn":["20411723"],"journal":"Natu