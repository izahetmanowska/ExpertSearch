{"abstract":"We have developed a rapid method, based on lamellar body counts (LBC) on gastric aspirate, for identifying newborns who will develop respiratory distress syndrome with a need for surfactant supplementation. Objective: We set out to test whether it was possible to improve the outcome when used in a clinical trial.","author_count":18,"contributors":["Verder, Henrik Axel","Ebbesen, Finn","Fenger-Grøn, Jesper","Henriksen, Tine Brink","Andreasson, Bengt","Bender, Lars","Bertelsen, Aksel","Björklund, Lars J","Dahl, Marianne","Esberg, Gitte","Eschen, Christian","Høvring, Marie","Kreft, Andreas","Kroner, Jørn","Lundberg, Fredrik","Pedersen, Pernille","Reinholdt, Jes","Stanchev, Hristo"],"cuid":["S02-098.94-005735"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-OTH"],"OT":["Unspecified organisation"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-HO-OTH","DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"early surfactant guided by lamellar body counts on gastric aspirate in very preterm infants","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1159/000351638","version":"Other Version"},"id":"S02-098.94-005735","identifier":[{"id":"000322733700007","type":"wos"},{"id":"23942627","type":"pmid"},{"id":"84882300700","type":"scopus"}],"ids":["aau-76479493-337e-49db-9248-a13c02f6b3ca","au-ee8734ae-2323-4774-bffe-f922582fbcd4"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-3-6-08436857AD716AE0B042267076CCED14"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1159/000351638","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearP