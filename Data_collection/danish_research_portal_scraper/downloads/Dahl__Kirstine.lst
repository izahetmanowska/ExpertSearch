ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-5bcb80e9-35ee-4952-a96e-193d1673c811","sdu-120db404-266f-4eeb-ac8e-0a7e03c753a7"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Occurrence and predictors of pericardial effusion requiring invasive treatment following heart valve surgery","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-019352","year":"2022","yearsub":"2022"}
{"abstract":"At veterinary university hospitals, clinical teachers have two responsibilities: treating patients and teaching students.At the University of Copenhagen, many teachers are involved in the clinical teaching and assessment of veterinary students, but only some of these teachers-the academic faculty-have access to pedagogical training.We conceived an idea to develop a pedagogical program aimed specifically at clinical teachers. However, instead of implementing an existing program developed elsewhere, we decided to create a discipline-specific, context-relevant program. The creational process applied the principles of action learning consulting (ALC), which dictate that a pedagogical consultant and key involved employees cooperate closely in a dynamic, creational process. A program was developed with content focused on addressing the perceived needs expressed by the clinical teachers.The program consisted of three 2.5-hour seminars, each covering one of the main themes: teaching situations in clinical settings, pedagogical psychology in clinical teaching, and assessment and feedback.The seminars were conducted in the afternoon approximately 2 months apart and were facilitated by the two authors with a veterinary background (CBM, RL).Ten to 20 clinical teachers participated in each seminar, and feedback from participants was positive overall, acknowledging the creation of a forum for critical discussions on clinical teaching and learning and greater insight into pedagogical themes. As a result of the application of the ALC principle, the program is highly context relevant and has gained optimal anchorage within the organization; the seminars will therefore be repeated and allowed to continuously evolve.","author_count":3,"contributors":["Marschner, Clara Büchner","Dahl, Kirstine","Langebæk, Rikke"],"cuid":["S01-000.00-527375"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Clinical teaching","Faculty development","Staff Development"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"creating a pedagogical development program for veterinary clinical teachers a discipline specific context relevant bottom up initiative","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-527375","identifier":[{"id":"32758089","type":"pmid"},{"id":"85104559846","type":"scopus"}],"ids":["ku-e02edc2f-fff4-4bbb-970a-ca5e395d623d"],"keyword":["Clinical teaching","Faculty development","Staff development"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-5802892C1F7015DE9D43965F358B19DC"],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary Clinical Sciences, Section for Internal Medicine, Oncology and Clinical Pathology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Clara B.","key":"marschnerpau","last":"Marschner","locid":"2157a32f-603b-4c09-9b0a-e40ab76c3255","name":"Marschner, Clara Büchner","name_org":"Marschner, Clara B.","orcid":"0000-0002-2895-3546","rank":1,"rolecode":"pau"},{"affno":"1","first":"Kirstine","key":"dahlpau","last":"Dahl","locid":"7c1ec89a-1586-4263-9fc9-e0e19792a244","name":"Dahl, Kirstine","rank":2,"rolecode":"pau"},{"affno":"1","first":"Rikke","key":"langebækpau","last":"Langebæk","locid":"d475a466-b761-4225-948a-0748339494d6","name":"Langebæk, Rikke","orcid":"0000-0002-8605-6464","rank":3,"rolecode":"pau"}],"pmid":["32758089"],"pub":{"doi":"10.3138/jvme.2019-0042","issn":["0748321X","19437218"],"issn_org":["0748321X"],"issue":"2","journal":"Journal of Veterinary Medical Education","pages":"129-135","status":"p","title":"Journal of Veterinary Medical Education","volume":"48"},"review":"Peer Reviewed","scoID":["2-s2.0-85104559846"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-e02edc2f-fff4-4bbb-970a-ca5e395d623d"],"src":["KU University of Copenhagen"],"title":"Creating a pedagogical development program for veterinary clinical teachers : A discipline-specific, context-relevant, bottom-up initiative","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-527375","year":"2021","yearsub":"2021"}
{"abstract":"Beginning in late 2017, highly pathogenic avian influenza (HPAI) H5N6 viruses caused outbreaks in wild birds and poultry in several European countries. H5N6 viruses were detected in 43 wild birds found dead throughout Denmark. Most of the Danish virus-positive dead birds were found in the period from February to April 2018. However, unlike the rest of Europe, sporadic HPAI H5N6-positive dead wild birds were detected in Denmark in July, August, September, and December 2018, with the last positive bird being found in January 2019. HPAI viruses were not detected in active surveillance of apparently healthy wild birds. In this study, we use full genome sequencing and phylogenetic analysis to investigate the wild bird HPAI H5N6 viruses found in Denmark. The Danish viruses were found to be closely related to those of contemporary HPAI H5N6 viruses detected in Europe. Their sequences formed two clusters indicating that at least two or more introductions of H5N6 into Denmark occurred. Notably, all viruses detected in the latter half of 2018 and in 2019 grouped into the same cluster. The H5N6 viruses appeared to have been maintained undetected in the autumn 2018.","author_count":12,"contributors":["Liang, Yuan","Krog, Jesper Schak","Ryt-Hansen, Pia","Pedersen, Anders Gorm","Kvisgaard, Lise Kirstine","Holm, Elisabeth","Nielsen, Pernille Dahl","Hammer, Anne Sofie","Madsen, Jesper Johannes","Thorup, Kasper","Larsen, Lars Erik","Hjulsager, Charlotte Kristiane"],"cuid":["S02-100.00-034126"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Hjulsager, Charlotte Kristiane"],"keyword":["Birds","Disease Outbreaks","Europa","H5N6 subtype","Highly pathogenic avian influenza","Infectious disease outbreak","Influenza A virus","Phylogeny","Surveillance","WILD"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-OT","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"OT":["Danish Veterinary and Food Administration"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-GV-SSI","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"molecular characterization of highly pathogenic avian influenza viruses h000000000005n000000000006 detected in denmark in 000000002018 000000002019","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/v13061052","version":"Published Version"},"funding_acknowledgement":["Funding: This research was funded by The Danish Veterinary and Food Administration."],"id":"S02-100.00-034126","identifier":[{"id":"34199456","type":"pmid"},{"id":"85107011816","type":"scopus"},{"id":"PMC8226499","type":"pmcid"}],"ids":["dtu-43f71313-9de2-4ecd-abb1-8a219930abe9","ku-523ae191-2dbb-43b9-a3c3-89a1635490c0"],"keyword":["Birds","Disease outbreaks","Europa","H5N6 subtype","Highly pathogenic avian influenza","Infectious disease outbreak","Influenza A virus","Phylogeny","Surveillance","Wild"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-AE0DCE14ED8BB8513BA95604679E25A5"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/v13061052","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/264497580/viruses_13_01052.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/273370124/viruses_13_01052.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nord