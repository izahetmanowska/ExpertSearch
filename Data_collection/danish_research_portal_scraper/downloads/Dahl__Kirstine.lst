":"kytepau","last":"Kyte","name":"Kyte, Derek","rank":9,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Melanie","key":"calvertpau","last":"Calvert","name":"Calvert, Melanie","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars","key":"riberpau","last":"Riber","locid":"607e34a6-2b96-4466-ad5f-48b2c188f589","name":"Riber, Lars","orcid":"0000-0001-6898-2715","rank":11,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"first":"Jacob Eifer","key":"møllerpau","last":"Møller","locid":"5e4d3cb6-b0a0-4541-aea1-30e73f7c10b8","name":"Møller, Jacob Eifer","orcid":"0000-0003-2873-5845","rank":12,"rolecode":"pau"}],"pmid":["31875308"],"pub":{"doi":"10.1007/s11136-019-02400-9","issn":["09629343"],"issue":"5","journal":"Quality of Life Research","pages":"1247-1258","publisher":"Springer","status":"p","title":"Quality of Life Research","volume":"29"},"review":"Peer Reviewed","scoID":["2-s2.0-85077400877"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-bbc33d53-efb8-46e2-8c20-69b39c0c6126","sdu-77e4293b-12b7-41d1-ba9e-4e26fb8c3e87"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"What to expect after open heart valve surgery? Changes in health-related quality of life","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-098.93-045729","year":"2020","yearsub":"2020"}
{"abstract":"Objective Detachment from the workforce following open heart valve surgery is a burden for the patient and society. The objectives were to examine patterns of employment status at different time points and to investigate factors associated with a lower likelihood of returning to the workforce within six months. Methods A cohort study of patients aged 18-63 undergoing valvular surgery at a Danish tertiary centre from 2013-2017. Return to the workforce was defined as being employed, unemployed (still capable of working) or receiving paid leave of absence. The association between demographic-, clinical characteristics (including a surgical risk evaluation, EuroScore), and return to the workforce were investigated with a multivariable logistic regression model. Results In total, 1,395 consecutive patients underwent surgery, 347 were between 18 and 63 years and eligible for inclusion. Of those, 282 were attached to the workforce before surgery and included in the study. At the time of surgery, 79% were on paid sick leave. After six months, 21% of the patients (being part of the workforce before surgery), were still on sick leave. In the regression model, prolonged sick leave prior to surgery (OR 0.43, 95% CI 0.23-0.79) and EuroScore ≥ 2.3 (OR 0.39, 95% CI 0.21-0.74) significantly reduced the likelihood of returning to the workforce. Conclusion One-fifth of patients in the working-age were on sick leave six months after surgery. Prolonged sick leave prior to surgery and a EuroScore ≥2.3 were associated with a lower likelihood of returning to the workforce.","author_count":11,"contributors":["Borregaard, Britt","Dahl, Jordi S.","Ekholm, Ola","Fosbøl, Emil","Riber, Lars P.S.","Sibilitz, Kirstine L.","Pedersen, Sasja M.","Rothberg, Thomas P.H.","Nielsen, Maiken H.","Berg, Selina Kikkenborg","Møller, Jacob E."],"cuid":["S02-089.29-044098"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Borregaard, Britt"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"employment status before and after open heart valve surgery a cohort study","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pone.0240210","version":"Published Version"},"id":"S02-089.29-044098","identifier":[{"id":"33027303","type":"pmid"},{"id":"PMC7541055","type":"pmcid"},{"id":"85092630391","type":"scopus"}],"ids":["ku-86bc6c35-3c6f-4d8d-8981-28904196a58c","sdu-293df748-bd26-4849-a1de-7a7802091065"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-53FDA84DCA0CBA3A63C7F89E81C31A9F"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pone.0240210","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/174170863/journal.pone.0240210.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/250541116/journal.pone.0240210.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research Unit OPEN (Odense)","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Cardiac, thoracic, and Vascular surgery (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal medicine: Cardiology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Britt","key":"borregaardpau","last":"Borregaard","locid":"ca3a0f85-e4e4-42dc-98f0-a7ddfe619020","name":"Borregaard, Britt","orcid":"0000-0003-2702-0231","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jordi S.","key":"dahlpau","last":"Dahl","locid":"fa82ce60-e408-4c0f-b013-151f87c6998c","name":"Dahl, Jordi Sanchez","name_org":"Dahl, Jordi S.","orcid":"0000-0002-8345-204X","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ola","key":"ekholmpau","last":"Ekholm","locid":"b59d640e-8087-46d7-8284-5a45e6ebd03f","name":"Ekholm, Ola","orcid":"0000-0002-5563-7098","rank":3,"rolecode":"pau"},{"affno":"2","first":"Emil","key":"fosbølpau","last":"Fosbøl","name":"Fosbøl, Emil","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars P.S.","key":"riberpau","last":"Riber","locid":"607e34a6-2b96-4466-ad5f-48b2c188f589","name":"Riber, Lars","name_org":"Riber, Lars P.S.","orcid":"0000-0001-6898-2715","rank":5,"rolecode":"pau"},{"affno":"2","first":"Kirstine L.","key":"sibilitzpau","last":"Sibilitz","name":"Sibilitz, Kirstine L.","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sasja M.","key":"pedersenpau","last":"Pedersen","name":"Pedersen, Sasja M.","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thomas P.H.","key":"rothbergpau","last":"Rothberg","locid":"2169d9ca-5f07-4cfd-80f7-80b28280f604","name":"Rothberg, Thomas P.H.","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Maiken H.","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Maiken H.","rank":9,"rolecode":"pau"},{"affno":"3","first":"Selina K.","key":"bergpau","last":"Berg","locid":"92d15fb6-c29f-4d38-88a4-53d28ecc9a13","name":"Berg, Selina Kikkenborg","name_org":"Berg, Selina K.","rank":10,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Jacob E.","key":"møllerpau","last":"Møller","locid":"5e4d3cb6-b0a0-4541-aea1-30e73f7c10b8","name":"Møller, Jacob Eifer","name_org":"Møller, Jacob E.","orcid":"0000-0003-2873-5845","rank":11,"rolecode":"pau"}],"pmid":["33027303"],"pub":{"doi":"10.1371/journal.pone.0240210","issn":["19326203"],"issue":"10","journal":"PLOS ONE","paperid":"e0240210","publisher":"Public Library of Science","status":"p","title":"PLOS ONE","volume":"15"},"review":"Peer Reviewed","scoID":["2-s2.0-85092630391"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-86bc6c35-3c6f-4d8d-8981-28904196a58c","sdu-293df748-bd26-4849-a1de-7a7802091065"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Employment status before and after open heart valve surgery : A cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-089.29-044098","year":"2020","yearsub":"2020"}
{"abstract":"Background: Unplanned readmissions after heart valve surgery are common, and constitute a significant burden for the patient and the health care system. The objective was to investigate the effect of individualised follow-up after open heart valve surgery on a composite endpoint of first unplanned cardiac hospital readmission or all-cause mortality within 180 days of discharge. Methods: The study is a prospective cohort study comparing the composite endpoint in patients undergoing early, individualised and intensified follow-up after heart valve surgery with a propensity matched historical control group. A total of 308 consecutive patients were enrolled in the prospective cohort study, 980 consecutive patients comprised the control group. The propensity matched group consisted of n = 300 (intervention)and n = 580 (controls). Time to first event was analysed using uni- and multivariable Cox proportional hazard analysis. Kaplan-Meier survival curves were constructed to assess the probability of survival without readmission. Results: After 180 days, the proportion of patients experiencing the composite endpoint was significantly lower in the intervention group compared with the controls for the overall, unmatched population (23% vs. 38%; HR 0.55; 95% CI, 0.42 to 0.73; P < 0.001). The effect did not change in the propensity matched population (HR 0.57; 95% CI 0.43;0.75, P < 0.001). The difference was related to reduction in readmission rates, whereas death rates were similar in intervention and control group (1.6% vs. 1.8%). Conclusion: An intervention consisting of early, individualised and intensified follow-up after open heart valve surgery reduced the risk of a composite endpoint of first, unplanned cardiac hospital readmission or all-cause mortality within 180 days.","author_count":9,"contributors":["Borregaard, Britt","Dahl, Jordi Sanchez","Riber, Lars Peter Schødt","Ekholm, Ola","Sibilitz, Kirstine Lærum","Weiss, Marc Gjern","Sørensen, Jan","Berg, Selina Kikkenborg","Møller, Jacob Eifer"],"cuid":["S03-099.97-026109"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"continent":["Europe, EU","OECD"],"corresponding_author":["Borregaard, Britt"],"country":["Ireland"],"glorg":["All Global Affiliations","Royal College of Surgeons in Ireland"],"keyword":["Heart valve surgery","Heart valves","Intervention","Propensity matched","Readmission"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"effect of early individualised and intensified follow up after open heart valve surgery on unplanned cardiac hospital readmissions and all cause mortality","src":["au","ku","sdu"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/153658147/Effect_of_early_individualised_and_intensified_follow_up_after_open_heart_valve_surgery_on_unplanned_cardiac.pdf","version":"Authors Final Version"},"funding_acknowledgement":["Helsefonden (Grant ID 18-B-0196 ), The Odense University Hospital (Grant ID A2224 ) PhD foundation, Ove William Buhl Olesen og Edith Buhl Olesen Foundation (Grant ID 3555 ), and Kurt Bønnelycke og Grethe Bønnelycke Foundation (Grant ID 10053-030 ) funded this research. The funders had no role in the design and conduct of the study; collection, management, analysis, and interpretation of the data; or in the preparation, review, and approval of the manuscript."],"id":"S03-099.97-026109","identifier":[{"id":"85064324761","type":"scopus"},{"id":"31006596","type":"pmid"}],"ids":["au-b8bf4017-67d8-4bef-bb94-d56ee806c621","ku-bb95b003-d5e6-4b7f-9e79-41bb08eb5634","sdu-6