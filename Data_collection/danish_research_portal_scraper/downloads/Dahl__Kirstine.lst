orm","key":"pedersenpau","last":"Pedersen","locid":"bb3513aa-fb20-46ef-ba14-9c150c929cf1","name":"Pedersen, Anders Gorm","orcid":"0000-0001-9650-8965","rank":4,"rolecode":"pau"},{"affno":"1","first":"Lise Kirstine","key":"kvisgaardpau","last":"Kvisgaard","name":"Kvisgaard, Lise Kirstine","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Elisabeth","key":"holmpau","last":"Holm","name":"Holm, Elisabeth","rank":6,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Pernille Dahl","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Pernille Dahl","rank":7,"rolecode":"pau"},{"affno":"1","first":"Anne Sofie","key":"hammerpau","last":"Hammer","locid":"d86de80d-40da-4128-b0d2-55a9f244b129","name":"Hammer, Anne Sofie Vedsted","name_org":"Hammer, Anne Sofie","rank":8,"rolecode":"pau"},{"affno":"1","first":"Jesper Johannes","key":"madsenpau","last":"Madsen","locid":"d82924e0-e9c4-4f0c-b403-a2f210e07b58","name":"Madsen, Jesper Johannes","rank":9,"rolecode":"pau"},{"affno":"1","first":"Kasper","key":"thoruppau","last":"Thorup","locid":"d93b22de-bf1d-45f5-bcea-9dacd45b6420","name":"Thorup, Kasper","orcid":"0000-0002-0320-0601","rank":10,"rolecode":"pau"},{"affno":"1","first":"Lars Erik","key":"larsenpau","last":"Larsen","locid":"135a9407-d29c-4508-8f79-978f5b295a15","name":"Larsen, Lars Erik","orcid":"0000-0003-0730-5555","rank":11,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Charlotte Kristiane","key":"hjulsagerpau","last":"Hjulsager","name":"Hjulsager, Charlotte Kristiane","rank":12,"rolecode":"pau"}],"pmid":["34199456"],"pub":{"doi":"10.3390/v13061052","issn":["19994915"],"issue":"6","journal":"Viruses","paperid":"1052","publisher":"MDPI AG","publisher_org":"M D P I AG","status":"p","title":"Viruses","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-85107011816"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Miscellaneous","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Governmental Institutions","Miscellaneous","Other Research","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-43f71313-9de2-4ecd-abb1-8a219930abe9","ku-523ae191-2dbb-43b9-a3c3-89a1635490c0"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Molecular characterization of highly pathogenic avian influenza viruses h5n6 detected in denmark in 2018–2019","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-034126","year":"2021","yearsub":"2021"}
{"abstract":"Objectives: Peptide receptor radionuclide therapy (PRRT) is an established treatment for metastatic neuroendocrine neoplasms (NEN). However, only limited data exists for the effect of multiple series of PRRT. The aim of this study was to investigate PFS and OS inNEN patients treated with multiple series of PRRT conforming to the ENETS treatment protocol. Methods: We included all patients with gastrointestinal (GI), pancreatic and bronchopulmonary (BP) NEN treated with PRRT from 2008 to 2018. We used Kaplan-Meier estimation to evaluate PFS and OS with subgroup analysis of primary tumor, Ki67-index, type of radioisotope and number of PRRT series. Results: 133 patients (female/male 61/72) were included, median age 70 (interquartile range 64–76) years. GI-NEN comprised 62%, pancreatic 23% and BP 11%. Median Ki67-index was 5%. After first PRRTG1- and G2-tumors had PFS of 25 and 22 months, compared to 11 months in G3-NENs (p <.05) and PFS was longer in G1/G2 GI-NENs than BP-NEN (30vs. 12 months, p <.05). After retreatment with a second series of PRRT, the overall PFS (G1–G3) was 19 months, with G1- and G2-tumors having the highest PFS of 19 and 22 months, respectively. Overall, the GI and BP tumors had an OS of 54 and 51 months. Conclusions: PRRT is an effective therapy with long-term PFS and OS, especially in G1 and G2 NENs, and with better prognosis in GI-NEN compared with BP-NENs. OS and PFS was shorter after the second series of PRRT compared with the first, however results were still encouraging.","author_count":7,"contributors":["Zacho, M. D.","Iversen, Peter","Villadsen, Gerda Elisabeth","Baunwall, Simon Mark Dahl","Arveschoug, Anne Kirstine","Grønbæk, Henning","Dam, Gitte"],"cuid":["S01-000.00-133682"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Zacho, M. D."],"keyword":["Neuroendocrine","Peptide receptor radionuclide therapy"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"clinical efficacy of first and second series of peptide receptor radionuclide therapy in patients with neuroendocrine neoplasm a cohort study","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85099748440","version":"Other Version"},"id":"S01-000.00-133682","identifier":[{"id":"85099748440","type":"scopus"},{"id":"33470864","type":"pmid"}],"ids":["au-07a6c82d-2113-4529-ae8c-79e939635be5"],"keyword":["Neuroendocrine","bronchopulmonary tumors","first and second series","gastropancreatic tumors","peptide receptor radionuclide therapy"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-3680269DC20FB58AA880D296008551E1"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Hepatology and Gastroenterology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"M. D.","key":"zachopau","last":"Zacho","locid":"d79b15a0-0578-4f44-a7dc-b40dd11354d6","name":"Zacho, M. D.","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"P.","key":"iversenpau","last":"Iversen","locid":"652caf77-ea4a-47a4-b9bf-98a5ec21d9dc","name":"Iversen, Peter","name_org":"Iversen, P.","orcid":"0000-0003-2455-5142","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"G. E.","key":"villadsenpau","last":"Villadsen","locid":"6e593826-d87d-47db-8aa1-92e03dc390a9","name":"Villadsen, Gerda Elisabeth","name_org":"Villadsen, G. E.","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"S. M.D.","key":"baunwallpau","last":"Baunwall","locid":"c2a9d590-d3a4-47cc-b7ea-b74f4a373083","name":"Baunwall, Simon Mark Dahl","name_org":"Baunwall, S. M.D.","orcid":"0000-0002-5135-7435","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"A. K.","key":"arveschougpau","last":"Arveschoug","locid":"ddccbd46-0d20-441c-a990-e6881ca12a01","name":"Arveschoug, Anne Kirstine","name_org":"Arveschoug, A. K.","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"H.","key":"grønbaekpau","last":"Grønbaek","locid":"32aaf9c5-5cf0-4e7b-86d8-a534fa4a9ae9","name":"Grønbæk, Henning","name_org":"Grønbaek, H.","orcid":"0000-0001-8998-7910","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"G.","key":"dampau","last":"Dam","locid":"66e3c066-e8bf-48c7-872c-7975c3f4dcfd","name":"Dam, Gitte","name_org":"Dam, G.","orcid":"0000-0003-3526-0171","rank":7,"rolecode":"pau"}],"pmid":["33470864"],"pub":{"doi":"10.1080/00365521.2021.1872095","issn":["00365521","15027708"],"issn_org":["00365521"],"issue":"3","journal":"Scandinavian Journal of Gastroenterology","pages":"289-297","publisher":"Informa Healthcare","status":"p","title":"Scandinavian Journal of Gastroenterology","volume":"56"},"review":"Peer Reviewed","scoID":["2-s2.0-85099748440"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-07a6c82d-2113-4529-ae8c-79e939635be5"],"src":["AU Aarhus University"],"title":"Clinical efficacy of first and second series of peptide receptor radionuclide therapy in patients with neuroendocrine neoplasm : a cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-133682","year":"2021","yearsub":"2021"}
{"abstract":"Objective: Osteogenesis imperfecta (OI) is a rare, hereditary disease affecting collagen type-1 in connective tissue. Collagen type-1 is a substantial component of dentine, and it is speculated, whether affected dentine could cause altered mesiodistal tooth dimension possibly affecting restorative treatment regimen. Therefore, the aim of the present study was to measure mesiodistal tooth dimensions in individuals with OI and compare them with healthy controls. Materials and methods: Fifty-seven individuals aged 20–77 years with OI type 1–4 were included and 70 control patients aged 11–34 years were drawn from an orthodontic database. Mesiodistal tooth dimensions of all tooth types, except third molars, were measured in mm (two decimals) on digital 3 D-models of the tooth-bearing arches. Results: Multilevel mixed-effects linear regression analysis showed that mesiodistal tooth dimension on average was 0.17 mm (95% CI = (−0.33; −0.01)) reduced for the OI group compared to controls. The analysis revealed variation between tooth types; incisors and first premolars were most affected and molars minimally affected. Conclusions: The mesiodistal tooth dimension in individuals diagnosed with OI is significantly smaller compared to healthy controls, which should be taken into consideration in the restorative treatment planning of individuals with OI, although the magnitude of the deviation is relatively small. The results on mesiodistal tooth dimensions of the present controls may be used as a standard for comparisons in future studies on tooth dimensions.","author_count":7,"contributors":["Staun Larsen, Line","Thuesen, Kirstine Juhl","Gjørup, Hans","Dahl, Jannie","Væth, Michael","Dalstra, Michel","Haubek, Dorte"],"cuid":["S01-000.00-271330"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"corresponding_author":["Staun Larsen, Line"],"country":["Switzerland"],"glorg":["All Global Affiliations","University of Basel"],"keyword":["Adolescent","Adult","Aged","Bicuspid","Child","Cross Sectional Studies","Dental Arch","Dentinogenesis imperfecta","Digital Model","Humans","Incisor","Middle Aged","Osteogenesis imperfecta","Tooth","Young Adult","tooth dimension","tooth size"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"reduced mesiodistal tooth dimension in individuals with osteogenesis imperfecta a cross sectional study","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1080/00016357.2020.1836391","version":"Published Version"},"id":"S01-000.00-271330","identifier":[{"id":"000583823200001","type":"wos"},{"id":"85094131909","type":"scopus"},{"id":"33103531","type":"pmid"}],"ids":["au-f8e904c6-ab66-4539-b13c-962eb95bb5a7"],"keyword":["Adolescent","Adult","Aged","Bicuspid","Child","Cross-Sectional Studies","Dental Arch","Humans","Incisor","Middle Aged","Young Adult","collagen diseases","dentinogenesis imperfecta","digital model","osteogenesis imperfecta","plaster model","tooth","tooth dimension","tooth size"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-0EA6CEB7F8226AB4EDCC2FB444A5DCAB"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1080/00016357.2020.1836391","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://pure.au.dk/ws/files/274249486/00016357.2020.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Dentistry and Oral Health, Department of Dentistry and Oral Health - Section for Oral Ecology and Caries Control"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1},{"affno":"3","country":"ch","key":"university of basel","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"University of Basel","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Line","key":"staunlarsenpau","last":"Staun Larsen","locid":"35e2ae60-25db-4a15-893f-dc8906e2bccf","name":"Staun Larsen, Line","orcid":"0000-0002-4155-5884","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kirstine Juhl","key":"thuesenpau","last":"Thuesen","name":"Thuesen, Kirstine Juhl","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hans","key":"gjøruppau","last":"Gjørup","locid":"09e05c36-ee41-48dd-ab77-12b82e3ea6db","name":"Gjørup, Hans","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jannie","key":"dahlpau","last":"Dahl","locid":"ff28625c-4331-45c8-9c95-035c52847347","name":"Dahl, Jannie","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Michael","key":"væthpau","last":"Væth","locid":"b646a6f8-cf55-4b01-9c73-f252a48f9fdd","name":"Væth, Michael","rank":5,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"country":"dk","first":"Michel","key":"dalstrapau","last":"Dalstra","locid":"e8ed52b4-5c3f-4216-9b0d-b30dff189fa4","name":"Dalstra, Michel","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Dorte","key":"haubekpau","last":"Haubek","locid":"5810b477-1799-4dc4-b619-5c04fe335800","name":"Haubek, Dorte","rank":7,"rolecode":"pau"}],"pmid":["33103531"],"pub":{"doi":"10.1080/00016357.2020.1836391","issn":["00016357","15023850"],"issn_org":["00016357"],"issue":"4","journal":"Acta Odontologica Scandinavica","pages":"262-267","publisher":"Medical Journals Sweden AB","status":"p","title":"Acta Odontologica Scandinavica","volume":"79"},"review":"Peer Reviewed","scoID":["2-s2.0-85094131909"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-f8e904c6-ab66-4539-b13c-962eb95bb5a7"],"src":["AU Aarhus University"],"title":"Reduced mesiodistal tooth dimension in individuals with osteogenesis imperfecta : a cross-sectional study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-271330","year":"2021","yearsub":"2021"}
{"abstract":"Objectives: The objectives of the study were to describe the causes of readmission from discharge to 30 days and from day 31 to 180 after discharge and to investigate the characteristics associated with overall and cause-specific readmissions after open-heart valve surgery. Methods: A single-center, retrospective cohort of 980 patients undergoing open-heart valve surgery from 2013 to 2016. Time to the first readmission was analyzed using univariable and multivariable Cox proportional hazard models. Results are reported as hazard ratios (HR) with 95% confidence intervals (CI). Results: In total, 366 patients (37%) experienced unplanned cardiac readmission within 180 days after discharge. Within 30 days after discharge, the most frequent causes of readmission were pericardial/pleural effusions (n = 87), infections (n = 50), and atrial fibrillation/flutter (n = 45). Accordingly, infections (n = 32) were the most common cause from day 31 to 180. No powerful predictors of overall cardiac readmission were identified, but several characteristics were associated with cause-specific readmissions: age ≤65 years (HR: 1.85; CI: 1.18-2.88), male gender (HR: 1.85; CI: 1.11-3.09), high alcohol intake (HR: 1.99; CI: 1.22-3.24) and mitral valve procedures (HR: 1.86; CI: 1.11-3.10) were associated with readmissions due to effusions. Ischemic heart disease with a prior percutaneous coronary intervention (HR: 2.94; CI: 1.53-5.63), mitral valve procedures (HR: 2.10; CI: 1.23-3.59), and postoperative atrial fibrillation/flutter (HR: 1.71; CI: 1.03-2.85) were associated with atrial fibrillation/flutter readmissions. Conclusion: Predicting overall readmissions after open-heart valve surgery is difficult as causes of readmissions vary and different causes are associated with different characteristics. Future studies should target reducing cause-specific readmissions.","author_count":7,"contributors":["Weiss, Marc Gjern","Møller, Jacob Eifer","Dahl, Jordi Sanchez","Riber, Lars","Sibilitz, Kirstine L.","Lykking, Emilie Karense","Borregaard, Britt"],"cuid":["S01-000.00-591983"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Weiss, Marc Gjern"],"keyword":["Atrial fibrillation","Readmission"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"causes and characteristics associated with early and late readmission after open heart valve surgery","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/170573153/jocs.14460.pdf","version":"Authors Final Version"},"id":"S01-000.00-591983","identifier":[{"id":"85079421375","type":"scopus"},{"id":"32048362","type":"pmid"}],"ids":["sdu-41768245-b1e9-45c3-b15a-7d44e665e667"],"keyword":["atrial fibrillation","pericardial/pleural effusion","readmission","valve repair/replacement"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-CA6AE66D2ED95D6677B1C82A448C0FC9"],"oa_link":[{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/170573153/jocs.14460.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Cardiac, thoracic, and Vascular surgery (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Marc G.","key":"weisspau","last":"Weiss","locid":"f347dc8a-7e46-490c-9e0e-f70a6dd4f043","name":"Weiss, Marc Gjern","name_org":"Weiss, Marc G.","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Jacob E.","key":"møllerpau","last":"Møller","locid":"5e4d3cb6-b0a0-4541-aea1-30e73f7c10b8","name":"Møller, Jacob Eifer","name_org":"Møller, Jacob E.","orcid":"0000-0003-2873-5845","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jordi S.","key":"dahlpau","last":"Dahl","locid":"fa82ce60-e408-4c0f-b013-151f87c6998c","name":"Dahl, Jordi Sanchez","name_org":"Dahl, Jordi S.","orcid":"0000-0002-8345-204X","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars","key":"riberpau","last":"Riber","locid":"607e34a6-2b96-4466-ad5f-48b2c188f589","name":"Riber, Lars","orcid":"0000-0001-6898-2715","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kirstine L.","key":"sibilitzpau","last":"Sibilitz","name":"Sibilitz, Kirstine L.","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Emilie K.","key":"lykkingpau","last":"Lykking","locid":"e5f738f4-5a42-4ec0-9ff1-faeb5a5212f4","name":"Lykking, Emilie Karense","name_org":"Lykking, Emilie K.","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Britt","key":"borregaardpau","last":"Borregaard","locid":"ca3a0f85-e4e4-42dc-98f0-a7ddfe619020","name":"Borregaard, Britt","orcid":"0000-0003-2702-0231","rank":7,"rolecode":"pau"}],"pmid":["32048362"],"pub":{"doi":"10.1111/jocs.14460","issn":["08860440","15408191"],"issn_org":["08860440"],"issue":"4","journal":"Journal of Cardiac Surgery","pages":"747-754","publisher":"Wiley","status":"p","title":"Journal of Cardiac Surgery","volume":"35"},"review":"Peer Reviewed","scoID":["2-s2.0-85079421375"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-41768245-b1e9-45c3-b15a-7d44e665e667"],"src":["SDU University of Southern Denmark"],"title":"Causes and characteristics associated with early and late readmission after open-heart valve surgery","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-591983","year":"2020","yearsub":"2020"}
{"abstract":"ESC guidelines recommend annual echocardiographic evaluation following biological surgical aortic valve replacement (SAVR), and 5 years following mechanical SAVR. Conversely, increased life expectancy result in increasing demand on health care resources.To assess aortic reintervention rates at 1-year, 3-year and 5-year following biological and mechanical SAVR in relation to estimated echocardiographic controls.From the nationwide Danish Register of Surgical Procedures, we identified all patients ≥40 years with isolated biological or mechanical SAVR +/− concomitant coronary artery bypass graft surgery (CABG) during 2000–2016. In 90-day reintervention-free survivors we assessed aortic valve reintervention rates at 1-year, 3-years and 5-years until December 31st, 2017. We further assessed cumulative risk of reintervention by age (\\lt;60, 60–69, 70–79, ≥80 years at SAVR) accounting for the competing risk of death during the study period.The population of 90-day reintervention-free survivors included 10,526 patients with biological SAVR (CABG 39.7\\ and 3,677 patients with mechanical SAVR (CABG 23.8\\. Reintervention rates at 1-year, 3-years and 5-years were comparable across type of SAVR, and generally low (Figure). Accounting for the competing risk of death, reintervention rates at 5-years were 1.4\\95\\.1–1.6) for biological SAVR and 1.5\\95\\.1–1.9) for mechanical SAVR, respectively. In age-stratified competing risk analyses, we observed the highest rates in patients aged 40–59 years (4\\95\\.8–6] at 5 years for biological SAVR, and 2\\95\\.3–3] for mechanical SAVR). Following biological SAVR, annual echocardiographic controls would yield a total of 34,516 scans in our population in the first 5 years following surgery. This contrasts to a total of 66 reinterventions following biological SAVR in our population between years 1–5 of which the majority was preceded by a hospital admission with a primary diagnosis of endocarditis within the last 90 days prior to the reintervention; which are unlikely to have been diagnosed at the annual assessment scan.In this nationwide study, reintervention rates following biological or mechanical SAVR were very low within the first five years after surgery suggesting a discrepancy between ESC recommendations on echocardiographic controls following SAVR, the benefit for patients, and the associated resource burden on the health care system.Figure 1Type of funding source: None","author_count":16,"contributors":["Schmiegelow, M","Bruun, N.E","Carranza, C.L","Dahl, J","Elming, H","Kober, L","Sibilitz, K","Torp-Pedersen, Christian","Schmiegelow, S.S"],"cuid":["S02-097.12-006709"],"event":{"end":"2020-09-01","place":"Virtuel","start":"2020-08-29","title":"ESC Congress 2020 - The Digital Experience","year":"2020"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-NDR","DI-HO-ZEA"],"U":["DI-U-AAU","DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-NDR","DI-HO-ZEA","DI-U-AAU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"recommendations on echocardiography following surgical aortic valve replacement savr time for revision","src":["aau","sdu"],"src-code":["DI-U-AAU","DI-U-SDU"],"type":"dca","type-grp":["all","pub"]},"id":"S02-097.12-006709","ids":["aau-8a799c70-ac53-47fe-8d43-774e4cfcd9f7","sdu-ce0c9341-a58e-4a0c-9bde-a370fa334752"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-D66B309C2776887185714F5481CAE96C"],"org":[{"affno":"1","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Regional Hospitals Zealand"],"nora_code":"DI-HO-ZEA","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Cardiology (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"4","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Cardiology","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Anæstesi, Børn, Kredsløb og Kvinder","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-AAU","used":1},{"affno":"5","country":"dk","key":"north denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-NDR","l3nl":"North Denmark Region","l3nn":"North Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"North Denmark Region","namevar":["Aalborg University Hospital"],"nora_code":"DI-HO-NDR","used":1}],"person":[{"affno":"1","corresponding":null,"first":"M","key":"schmiegelowmpau","last":"Schmiegelow","name":"Schmiegelow, M","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"N.E","key":"bruunnepau","last":"Bruun","name":"Bruun, N.E","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Niels Eske","key":"bruunnielseskepau","last":"Bruun","name":"Bruun, Niels Eske","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"C.L","key":"carranzaclpau","last":"Carranza","name":"Carranza, C.L","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Christian L.","key":"carranzachristianlpau","last":"Carranza","name":"Carranza, Christian L.","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Jordi","key":"dahljordisanchezpau","last":"Dahl","locid":"fa82ce60-e408-4c0f-b013-151f87c6998c","name":"Dahl, Jordi Sanchez","name_org":"Dahl, Jordi","orcid":"0000-0002-8345-204X","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"J","key":"dahljpau","last":"Dahl","name":"Dahl, J","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"H","key":"elminghpau","last":"Elming","name":"Elming, H","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hanne","key":"elminghannepau","last":"Elming","name":"Elming, Hanne","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"L","key":"koberlpau","last":"Kober","name":"Kober, L","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lars","key":"koberlarspau","last":"Kober","name":"Kober, Lars","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"K","key":"sibilitzkpau","last":"Sibilitz","name":"Sibilitz, K","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kirstine","key":"sibilitzkirstinepau","last":"Sibilitz","name":"Sibilitz, Kirstine","rank":7,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"C.L","key":"torppedersenchristianpau","last":"Torp-Pedersen","locid":"5417d806-0578-4505-b3fe-68ae0359913e","name":"Torp-Pedersen, Christian","name_org":"Torp-Pedersen, C.L","rank":8,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"C. L","key":"torppedersenclpau","last":"Torp-Pedersen","name":"Torp-Pedersen, C. L","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"S.S","key":"schmiegelowsspau","last":"Schmiegelow","name":"Schmiegelow, S.S","rank":9,"rolecode":"pau"}],"pub":{"doi":"10.1093/ehjci/ehaa946.1994","issn":["0195668X","15229645"],"issn_org":["0195668X"],"issue":"Suppl. 2","journal":"European Heart Journal","pages":"1994","paperid":"ehaa946.1994","publisher":"Oxford University Press","status":"p","title":"European Heart Journal","volume":"41"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Region Zealand","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-8a799c70-ac53-47fe-8d43-774e4cfcd9f7","sdu-ce0c9341-a58e-4a0c-9bde-a370fa334752"],"src":["AAU Aalborg University","SDU University of Southern Denmark"],"title":"Recommendations on echocardiography following surgical aortic valve replacement (SAVR) : time for revision?","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-097.12-006709","year":"2020","yearsub":"2020"}
{"abstract":"Acute kidney injury and hepatorenal syndrome (HRS) are frequent complications in patients with cirrhosis and ascites. First-line treatment is terlipressin, which reverses HRS in ~40% of patients but also lowers cardiac output (CO). We aimed to investigate whether reversing the cardio-suppressive effect of terlipressin with the β-adrenoceptor agonist dobutamine would increase CO and thereby increase the glomerular filtration rate (GFR). We randomized 25 patients with cirrhosis, ascites, and impaired renal function (2:2:1): group A received terlipressin followed by the addition of dobutamine; group B received dobutamine and terlipressin as monotherapies; and group C received placebo. Renal and cardiac functions were assessed during 8 clearance periods of 30 min, and concentrations of vasoactive hormones were measured. Dobutamine as a monotherapy increased CO (1.03 L/min, P < 0.01) but had no significant effects on GFR. Renin (P < 0.05), angiotensin II (P < 0.005), and aldosterone (P < 0.05) increased after dobutamine infusion. Terlipressin as a monotherapy improved GFR (18.9 mL·min-1·m-2, P = 0.005) and mean arterial pressure (MAP) (14 mmHg, P = 0.001) but reduced CO (-0.92 L/min, P < 0.005) and renin (P < .005). A combined treatment of dobutamine and terlipressin had a positive effect on CO (1.19 L/min, P < 0.05) and increased renin (P < 0.005), angiotensin II (P < 0.005), and aldosterone (P < 0.05), but it had no significant effects on MAP or GFR. Dobutamine reversed the cardio-suppressive effect of terlipressin in cirrhosis, ascites, and impaired renal function. However, dobutamine reduced peripheral vascular resistance, activated renin-angiotensin-aldosterone system, and did not improve GFR compared with terlipressin as a monotherapy. Therefore, dobutamine cannot be recommended in cirrhosis and ascites.NEW & NOTEWORTHY This study shows that the cardio-suppressive effects of the vasopressin receptor agonist terlipressin can be reversed by dobutamine. This is a novel observation in patients with decompensated cirrhosis. Furthermore, we show that dobutamine reduced the peripheral vascular resistance and activated the renin-angiotensin system, whereas renal function was not further improved by terlipressin alone.","author_count":9,"contributors":["Israelsen, Mads","Dahl, Emilie Kristine","Madsen, Bjørn Stæhr","Wiese, Signe","Bendtsen, Flemming","Møller, Søren","Fialla, Annette Dam","Jensen, Boye L","Krag, Aleksander"],"cuid":["S02-099.96-042104"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["AKI","Acute Kidney Injury drug therapy","Acute kidney injury","Adolescent","Adult","Aged","Arterial Pressure drug effects","Ascites metabolism","Cardiac Output drug effects","Female","Hepatorenal Syndrome drug therapy","Humans","Kidney Function Tests","Liver Cirrhosis metabolism","Male","Middle Aged","Portal hypertension","Young Adult"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"dobutamine reverses the cardio suppressive effects of terlipressin without improving renal function in cirrhosis and ascites a randomized controlled trial","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/159958753/ajpgi.00328.2019.pdf","version":"Authors Final Version"},"id":"S02-099.96-042104","identifier":[{"id":"31841026","type":"pmid"},{"id":"85079021989","type":"scopus"}],"ids":["ku-49079b44-5180-41ec-9e11-929c50a78574","sdu-376872c4-5761-4f7c-81be-ab871b22843d"],"keyword":["AKI","Acute Kidney Injury/drug therapy","Acute kidney injury","Adolescent","Adrenergic beta-Agonists/therapeutic use","Adult","Aged","Arterial Pressure/drug effects","Ascites/metabolism","Cardiac Output/drug effects","Dobutamine/therapeutic use","Female","Glaucoma Drainage Implants","HRS","Hepatorenal","Hepatorenal Syndrome/drug therapy","Humans","Kidney Diseases/prevention & control","Kidney Function Tests","Liver Cirrhosis/metabolism","Male","Middle Aged","Portal hypertension","Renin/urine","Terlipressin/adverse effects","Young Adult"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-9BDB3B7FAC9D54B67AF51F051A29BC3A"],"oa_link":[{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/159958753/ajpgi.00328.2019.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, FLASH - Centre for Liver Research (Odense)","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Medical Gastroenterology (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Amager and Hvidovre"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal Medicine: Gastroenterology and Hepatology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Mads","key":"israelsenpau","last":"Israelsen","locid":"c21de3a3-e0de-4b11-aefe-b3465cc29d33","name":"Israelsen, Mads","orcid":"0000-0001-9443-5846","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Emilie K","key":"dahlpau","last":"Dahl","locid":"fca5040e-a219-4952-b9a8-a75dc3daf983","name":"Dahl, Emilie Kirstine","name_org":"Dahl, Emilie K","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Bjørn S","key":"madsenpau","last":"Madsen","locid":"8e118b7b-0ddc-46ae-a586-7f7286de5b3f","name":"Stæhr Madsen, Bjørn","name_org":"Madsen, Bjørn S","orcid":"0000-0002-2846-3598","rank":3,"rolecode":"pau"},{"affno":"2","first":"Signe","key":"wiesepau","last":"Wiese","name":"Wiese, Signe","rank":4,"rolecode":"pau"},{"affno":"3 2","first":"Flemming","key":"bendtsenpau","last":"Bendtsen","locid":"18608d49-a3d5-4de9-8053-3edef5ba12f9","name":"Bendtsen, Flemming","rank":5,"rolecode":"pau"},{"affno":"3 2","first":"Søren","key":"møllerpau","last":"Møller","locid":"a4bee617-45cc-4a85-a58a-817fb06a5525","name":"Møller, Søren","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Annette Dam","key":"fiallapau","last":"Fialla","locid":"a955ed23-f54f-4efe-ab85-73ab83e01dc6","name":"Fialla, Annette Dam","orcid":"0000-0003-0890-4728","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Boye L","key":"jensenpau","last":"Jensen","locid":"99cae4af-9de0-480a-b55b-4de8fa55a446","name":"Jensen, Boye L.","name_org":"Jensen, Boye L","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Aleksander","key":"kragpau","last":"Krag","locid":"0064696b-9c65-4990-ab96-3635d5a20e4b","name":"Krag, Aleksander","orcid":"0000-0002-9598-4932","rank":9,"rolecode":"pau"}],"pmid":["31841026"],"pub":{"doi":"10.1152/ajpgi.00328.2019","issn":["01931857","15221547"],"issn_org":["01931857"],"issue":"2","journal":"American Journal of Physiology: Gastrointestinal and Liver Physiology","publisher":"American Physiological Society","status":"p","title":"American Journal of Physiology: Gastrointestinal and Liver Physiology","volume":"318"},"review":"Peer Reviewed","scoID":["2-s2.0-85079021989"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-49079b44-5180-41ec-9e11-929c50a78574","sdu-376872c4-5761-4f7c-81be-ab871b22843d"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Dobutamine reverses the cardio-suppressive effects of terlipressin without improving renal function in cirrhosis and ascites : a randomized controlled trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.96-042104","year":"2020","yearsub":"2020"}
{"abstract":"Purpose: To (i) describe changes in health-related quality of life (HRQoL) pre-operatively, at discharge, and 4 weeks after discharge following open heart surgery, (ii) compare the performance of the EuroQol Questionnaire (EQ-5D 5L) and the Kansas City Cardiomyopathy Questionnaire (KCCQ) against an anchor-based approach, and to (iii) investigate the association between HRQoL and 180-day readmission. Methods: A prospective, consecutive cohort (single-center study) of 291 patients completed the EQ-5D 5L and KCCQ pre-operatively, at discharge and 4 weeks post-discharge. Changes in HRQoL over time were evaluated, and the performance of the instruments was investigated. The association between HRQoL and readmission were investigated with Cox Proportional Hazard models. Results: Scores of the EQ-5D Index and VAS decreased significantly from the pre-operative assessment to discharge and improved from discharge to 4 weeks after. The KCCQ scores significantly improved from baseline to 4 weeks after. Minimal clinically important improvements from before surgery to 4 weeks after were seen among 24% (EQ-5D Index), 45% (EQ-5D VAS), and 57% (KCCQ). More than one-third experienced worse HRQoL 1 month after discharge. Area under the curve (AUC) (performance of the instruments) demonstrated the following: EQ-5D Index AUC 0.622 (95% CI 0.540–0.704), VAS AUC 0.674 (95% CI 0.598–0.750), and KCCQ AUC 0.722 (95% CI 0.65–0.792). None of the HRQoL measurements were associated with 180-day readmission. Conclusions: This study revealed that HRQoL measured with the EQ-5D is significantly worse at discharge compared to before surgery, but scores increases within the first month measured with the EQ-5D and the KCCQ. The EQ-5D and KCCQ have a moderate correlation with an anchor-based approach but were not associated with readmission.","author_count":13,"contributors":["Borregaard, Britt","Pedersen, Susanne S.","Berg, Selina Kikkenborg","Dahl, Jordi","Ekholm, Ola","Sibilitz, Kirstine","Zwisler, Ann Dorthe Olsen","Lauck, Sandra B.","Kyte, Derek","Calvert, Melanie","Riber, Lars Peter Schødt","Møller, Jacob Eifer"],"cuid":["S02-098.93-045729"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","Europe, Non-EU","OECD"],"country":["Canada","United Kingdom"],"glorg":["All Global Affiliations","St. Paul's Hospital","University of Birmingham","University of British Columbia (UBC)"],"keyword":["Cardiac surgery","Heart valves","Quality of Life"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"what to expect after open heart valve surgery changes in health related quality of life","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/157528605/Accepted_manuscript_for_PURE.pdf","version":"Authors Final Version"},"id":"S02-098.93-045729","identifier":[{"id":"85077400877","type":"scopus"},{"id":"31875308","type":"pmid"}],"ids":["ku-bbc33d53-efb8-46e2-8c20-69b39c0c6126","sdu-77e4293b-12b7-41d1-ba9e-4e26fb8c3e87"],"keyword":["Cardiac surgery","Heart valves","Quality of life"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-C3E933530095FD90A98C433D28C43EDF"],"oa_link":[{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/290451615/267199366_2_32.pdf","version":"Authors Final Version"},{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/157528605/Accepted_manuscript_for_PURE.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"sdu univers