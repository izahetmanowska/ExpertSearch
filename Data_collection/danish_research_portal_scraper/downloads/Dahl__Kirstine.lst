4bf2e","name":"Krogh, Klaus","orcid":"0000-0001-9168-2403","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Brian","key":"damsgaardbrianpau","last":"Damsgaard","locid":"f48c192a-c313-4b3a-b893-2fd18cbb44d0","name":"Damsgaard, Brian","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anne Kirstine","key":"arveschougannekirstinepau","last":"Arveschough","locid":"ddccbd46-0d20-441c-a990-e6881ca12a01","name":"Arveschoug, Anne Kirstine","name_org":"Arveschough, Anne Kirstine","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jørgen","key":"agnholtjørgenpau","last":"Agnholt","locid":"66d6b88f-b5c0-4c2e-b073-056cd18dc1ea","name":"Agnholt, Jørgen","orcid":"0009-0006-4776-0121","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens Frederik","key":"dahlerupjensfrederikpau","last":"Dahlerup","locid":"0f52b503-fe76-4e51-939a-7a24f226f420","name":"Dahlerup, Jens Frederik","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren Peter","key":"jørgensensørenpeterpau","last":"Jørgensen","locid":"8af81c1a-8d41-4579-8030-c7097092767e","name":"Jørgensen, Søren Peter","rank":7,"rolecode":"pau"}],"pmid":["31184393"],"pub":{"doi":"10.1111/apt.15301","issn":["02692813","09530673"],"issn_org":["02692813"],"issue":"1","journal":"Alimentary Pharmacology and Therapeutics","pages":"110-111","publisher":"John Wiley & Sons Inc.","status":"p","title":"Alimentary Pharmacology and Therapeutics","volume":"50"},"review":"No Review","scoID":["2-s2.0-85067003149"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-c0ce2e2e-9c70-410e-b4aa-59a900e4089f"],"src":["AU Aarhus University"],"title":"Letter: post-infective bile acid malabsorption and diarrhoea. Authors' reply","type":"Journal Comment","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-239349","year":"2019","yearsub":"2019"}
{"abstract":"Objectives: The objective was to assess differences in healthcare costs within 180 days after discharge from open heart valve surgery in an intervention group receiving early, individualised and intensified follow-up compared with a historical control group. Methods: A cost-minimisation analysis comparing costs from a consecutive prospective cohort compared with a propensity matched cohort. Costs related to the intervention, hospital (outpatient visits and readmissions) and general practitioners (all contacts) were included. Data were obtained from electronic patient records and registry data. A logistic propensity model was used to identify the historical control group. Main results are presented as mean differences and 95% CIs based on bootstrapping. Results: After matching, the analysis included 300 patients from the intervention group and 580 controls. The mean intervention cost was €171 (SD 79) per patient. After 180 days, the mean healthcare costs were €1284 (SD 2567) for the intervention group and €2077 (SD 4773) for the controls. The cost of the intervention group was €793 (p<0.001) less per patient. The cost differences were explained mainly by fewer readmissions, fewer overall emergency visits and fewer contacts to the general practitioner during out-of-hours in the intervention group. Conclusions: The intervention consisting of early, individualised and intensified follow-up after open heart valve surgery significantly reduced the healthcare costs within 180 days after discharge.","author_count":10,"contributors":["Borregaard, Britt","Møller, Jacob Eifer","Dahl, Jordi Sanchez","Riber, Lars Peter Schødt","Berg, Selina Kikkenborg","Ekholm, Ola","Weiss, Marc Gjern","Lykking, Emilie Karense","Sibilitz, Kirstine Lærum","Sørensen, Jan"],"cuid":["S02-099.86-045257"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD"],"corresponding_author":["Borregaard, Britt"],"country":["Ireland"],"glorg":["All Global Affiliations","Royal College of Surgeons in Ireland"],"keyword":["Follow up study","Health Care Costs","Heart valves","Propensity matching","Readmissions"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"early follow up after open heart valve surgery reduces healthcare costs a propensity matched study","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/openhrt-2019-001122","version":"Published Version"},"id":"S02-099.86-045257","identifier":[{"id":"PMC6861062","type":"pmcid"},{"id":"85074931508","type":"scopus"},{"id":"31798915","type":"pmid"}],"ids":["ku-ac817f26-3501-4d80-8a4e-5ddf512b7443","sdu-53ad6e6f-8f49-45ea-ad60-8e8029384c08"],"keyword":["follow-up study","health care costs","heart valves","propensity matching","readmissions"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-A607DE26CB8A22969908C5D98C7FFA7B"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/156518501/Early_follow_up_after_open_heart_valve_surgery_reduces_healthcare_costs.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://curis.ku.dk/ws/files/240790987/Early_follow_up_after_open_heart_valve_surgery_reduces_healthcare_costs.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/openhrt-2019-001122","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"sdu university of southern denm