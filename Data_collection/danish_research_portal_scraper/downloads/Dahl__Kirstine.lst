":"pau"}],"pmid":["34411227"],"pub":{"doi":"10.1093/ejcts/ezab365","issn":["10107940","1873734X"],"issn_org":["10107940"],"issue":"3","journal":"European Journal of Cardio-Thoracic Surgery","pages":"614-622","publisher":"European Association for Cardio-Thoracic Surgery","status":"p","title":"European Journal of Cardio-Thoracic Surgery","volume":"61"},"review":"Peer Reviewed","scoID":["2-s2.0-85125000410"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Other Hospitals","Region Zealand","Universities","University of Copenhagen","University of Southern Denmark","copenhagen university hospital - holbæk"],"PST":["Published"]},"sid":["aau-65aef37d-905f-4279-8c8f-9b6b50d26b24","ku-9603c369-8f15-499c-9a60-5114b786c150","sdu-4a2e7a73-2043-4f52-963d-43dd55421e39"],"src":["AAU Aalborg University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Reintervention rates following bioprosthetic surgical aortic valve replacement - A Danish Nationwide Cohort Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-094.23-004925","year":"2022","yearsub":"2022"}
{"abstract":"OBJECTIVES: To describe the occurrence of significant pericardial effusion, and to investigate characteristics associated with pericardial effusion within three months following heart valve surgery. METHODS: A retrospective, observational cohort study including adult patients undergoing heart valve surgery at Odense University Hospital from August 2013 to November 2017. Data were gathered from The Western Denmark Heart Registry and electronic patient records.Cox proportional hazard models were used to investigate the associations between characteristics associated with significant pericardial effusion during index admission and within 3 months. Results are presented as HR with 95% CI. RESULTS: In total, 1460 patients were included (70% men, median age 71 years (IQR 63-76)) and of those, n=230 patients (16%) developed significant pericardial effusion.EuroScore II was significantly associated with an increased risk of pericardial effusion during index admission and associated with a lower risk following discharge (index admission HR 1.05, 95% CI 1.02 to 1.08, after discharge HR 0.80, 95% CI 0.69 to 0.92). Increasing age (HR 0.97, 95% CI 0.95 to 0.98 per year) and concomitant coronary artery bypass grafting versus isolated valve surgery (HR 0.58, 95% CI 0.35 to 0.97) were significantly associated with a reduced risk of pericardial effusions in both periods. Being a man (HR 2.30, 95% CI 1.32 to 4.01) and aortic valve disease versus mitral valve disease (HR 2.16, 95% CI 1.20 to 3.90) were significantly associated with an increased risk after discharge. CONCLUSION: Significant pericardial effusions requiring drainage were present in 16% of cases following heart valve surgery, and different clinical characteristics were associated with the development of effusion.","author_count":9,"contributors":["Borregaard, Britt","Sibilitz, Kirstine Lærum","Weiss, Marc Gjern","Ekholm, Ola","Lykking, Emilie Karense","Nielsen, Stine Nørris","Riber, Lars Peter","Dahl, Jordi Sanchez","Moller, Jacob Eifer"],"cuid":["S02-100.00-019352"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Borregaard, Britt"],"keyword":["Cardiac Surgical Procedures","Heart Valve Diseases","Pericardial effusion"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"occurrence and predictors of pericardial effusion requiring invasive treatment following heart valve surgery","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/openhrt-2021-001880","version":"Published Version"},"id":"S02-100.00-019352","identifier":[{"id":"35064056","type":"pmid"},{"id":"000746632000001","type":"wos"},{"id":"PMC8785202","type":"pmcid"},{"id":"85124012757","type":"scopus"}],"ids":["au-5bcb80e9-35ee-4952-a96e-193d1673c811","sdu-120db404-266f-4eeb-ac8e-0a7e03c753a7"],"keyword":["cardiac surgical procedures","heart valve diseases","pericardial effusion"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-9CE83C056FB621C2A3D1A2A383057E51"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/openhrt-2021-001880","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/201015138/e001880.full.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU U