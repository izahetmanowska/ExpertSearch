":["au-f7af9563-c886-4164-9d37-ada2440539af"],"src":["AU Aarhus University"],"title":"Validation of an indirect ELISA assay for assessment of autoantibodies against full-length TRIM21 and its individual domains","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-709842","year":"2023","yearsub":"2023"}
{"abstract":"The 12-item version of the Kansas City Cardiomyopathy Questionnaire (KCCQ-12) was originally developed for patients with heart failure but has been used and tested among patients with severe aortic stenosis (AS) who underwent transcatheter aortic valve implantation. Whether the instrument is suitable for patients with AS who underwent surgical aortic valve replacement (SAVR) is currently unknown. Thus, we aimed to investigate the psychometric properties of the KCCQ-12 before and after SAVR among patients with severe AS. We conducted a prospective cohort of 184 patients with AS who completed the KCCQ-12 and the EuroQol 5 Dimension 5 Levels before and 4 weeks after surgery. Construct validity was investigated with hypothesis testing and an analysis of Spearman's correlation between the two instruments. Structural validity was investigated with explorative and confirmatory factor analyses and reliability with Cronbach's α. All analyses were conducted on data from the two time points (preoperatively and four weeks after surgery). The hypothesis testing revealed how the New York Heart Association class was significantly correlated with the preoperative KCCQ-12 total score (higher New York Heart Association class, worse score). A longer length of hospital stay and living alone were significantly associated with poorer postoperative KCCQ-12 total score. KCCQ-12 and EuroQol 5 Dimension 5 Levels were moderately correlated in most domains/the total score/Visual Analogue Scale score. Principal component analyses revealed two 3-factor structures. The confirmatory factor analyses did not support the original model at any time point. Cronbach's α ranged from 0.22 to 0.84 in three preoperative factors and from 0.39 to 0.76 in the postoperative factors. The total Cronbach's α was 0.83 for the suggested preoperative 3-factor model and 0.83 for the postoperative model. In conclusion, the Danish version of the KCCQ-12 tested in a population of patients with AS who underwent SAVR appears to have acceptable construct validity, whereas structural validity cannot be confirmed for the original four-factor model. Overall reliability is good.","author_count":12,"contributors":["Borregaard, Britt","Bruvik, Sofie Moesgaard","Dahl, Jordi Sanchez","Ekholm, Ola","Bekker-Jensen, Ditte","Sibilitz, Kirstine Lærum","Zwisler, Ann Dorthe Olsen","Lauck, Sandra B","Pedersen, Susanne S.","Norekvål, Tone","Riber, Lars","Møller, Jacob Eifer"],"cuid":["S01-000.00-722907"],"filters":{"added":"2024-03","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Borregaard, Britt"],"country":["Canada","Norway"],"glorg":["All Global Affiliations","Haukeland University Hospital","St. Paul's Hospital","University of British Columbia (UBC)"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"psychometric properties of the kansas city cardiomyopathy questionnaire in a surgical population of patients with aortic valve stenosis","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.amjcard.2023.09.068","version":"Published Version"},"id":"S01-000.00-722907","identifier":[{"id":"85174976197","type":"scopus"},{"id":"37898098","type":"pmid"}],"ids":["sdu-1152e356-eb05-4907-950c-709387e43182"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-C79B8E2BC09A9A8D9760AFD5B5E71C14"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/245487948/1_s2.0_S0002914923010627_main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.amjcard.2023.09.068","version":"Published Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research Unit OPEN (Odense)","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Cardiac, thoracic, and Vascular surgery (Odense)","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Cardiology (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","country":"ca","key":"st paul s hospital","loc":["Canada","America, North","OECD"],"name":"St. Paul's Hospital","used":1},{"affno":"4","country":"ca","key":"university of british columbia","loc":["Canada","America, North","OECD"],"name":"University of British Columbia (UBC)","used":1},{"affno":"5","country":"no","key":"haukeland university hospital","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"Haukeland University Hospital","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Britt","key":"borregaardpau","last":"Borregaard","locid":"ca3a0f85-e4e4-42dc-98f0-a7ddfe619020","name":"Borregaard, Britt","orcid":"0000-0003-2702-0231","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sofie Moesgaard","key":"bruvikpau","last":"Bruvik","locid":"60983f8a-f7c0-49b3-8e6