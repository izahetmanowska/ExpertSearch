Lars Peter Schødt","orcid":"0000-0001-6898-2715","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ola","key":"ekholmpau","last":"Ekholm","locid":"b59d640e-8087-46d7-8284-5a45e6ebd03f","name":"Ekholm, Ola","orcid":"0000-0002-5563-7098","rank":4,"rolecode":"pau"},{"affno":"2","first":"Kirstine Lærum","key":"sibilitzpau","last":"Sibilitz","name":"Sibilitz, Kirstine Lærum","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marc","key":"weisspau","last":"Weiss","locid":"f347dc8a-7e46-490c-9e0e-f70a6dd4f043","name":"Weiss, Marc Gjern","name_org":"Weiss, Marc","rank":6,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"country":"dk","first":"Jan","key":"sørensenpau","last":"Sørensen","locid":"239cd9bd-c49f-497e-9e4c-5fc8275d360b","name":"Sørensen, Jan","orcid":"0000-0003-0857-9267","rank":7,"rolecode":"pau"},{"affno":"4","first":"Selina Kikkenborg","key":"bergpau","last":"Berg","locid":"92d15fb6-c29f-4d38-88a4-53d28ecc9a13","name":"Berg, Selina Kikkenborg","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jacob Eifer","key":"møllerpau","last":"Møller","locid":"5e4d3cb6-b0a0-4541-aea1-30e73f7c10b8","name":"Møller, Jacob Eifer","orcid":"0000-0003-2873-5845","rank":9,"rolecode":"pau"}],"pmid":["31193065"],"pub":{"doi":"10.1016/j.dib.2019.103926","issn":["23523409"],"journal":"Data in Brief","paperid":"103926","publisher":"Elsevier","status":"p","title":"Data in Brief","volume":"24"},"review":"Peer Reviewed","scoID":["2-s2.0-85064312431"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-9479ee35-209f-41dd-a78f-1deff509c008","sdu-71cded66-2552-4f21-b65c-86a591f1814b"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Data on an intervention to reduce readmissions after open heart valve surgery","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-044506","year":"2019","yearsub":"2019"}
{"abstract":"Background: To report on dental characteristics and treatment load in Danish adult patients with osteogenesis imperfecta (OI). Methods: Oral examination of 73 patients with OI was performed and OI type I, III, and IV were represented by 75.3%, 8.2%, and 16.4%, respectively. Patients were diagnosed as having dentinogenesis imperfecta (DI) if they had clinical and radiological signs of DI. In the data analysis, mild OI (type I) was compared to moderate-severe OI (type III and IV). Results: Discoloration of teeth was prevalent in patients with moderate-severe compared to mild OI (83.3% vs. 5.5%, p<0.001). Cervical constriction and pulpal obliteration were frequent findings in patients with moderate-severe OI (61.1% and 88.9%, respectively), whereas pulp stones and taurodontism were diagnosed in patients with mild OI only (29.1% and 9.1%, respectively). DI was found in 24.7% of OI patients and considerably more frequent in patients with moderate-severe (94.4%) compared to mild OI (1.8%) (p<0.001). The number of teeth with artificial crowns was significantly higher in patients with moderate-severe OI than in patients with mild OI (median 1.5, range 0-23 vs. median 0, range 0-14) (p<0.001). The number of teeth with fillings in patients with mild OI was significantly higher than in patients with moderate-severe OI (mean 9.7, SD 5.1, median 9.0, range 1-21 vs. mean 5.0, SD 4.4, median 4.0, range 0-16) (p<0.001). Conclusions: One fourth of patients with OI had DI, and the vast majority of them had moderate-severe OI. Whereas discoloration of teeth, cervical constriction and pulp obliteration were frequent findings in patients with moderate-severe OI, pulp stones and taurodontism were found in patients with mild OI only. In patients with moderate-severe OI, the dental treatment load was dominated by prosthetic treatment, whereas restorative treatment with fillings was more prevalent in patients with mild OI.","author_count":7,"contributors":["Thuesen, Kirstine Juhl","Gjørup, Hans","Hald, Jannie Dahl","Schmidt, Malene","Harsløf, Torben","Langdahl, Bente Lomholt","Haubek, Dorte"],"cuid":["S01-000.00-145739"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Collagen","Dentinogenesis imperfecta"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"the dental perspective on osteogenesis imperfecta in a danish adult population","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1186/s12903-018-0639-7","version":"Published Version"},"id":"S01-000.00-145739","identifier":[{"id":"30355314","type":"pmid"},{"id":"85055477532","type":"scopus"},{"id":"PMC6201594","type":"pmcid"}],"ids":["au-1ca8846a-b67b-48ae-93b4-b23120ffb36a"],"keyword":["Collagen","Dental treatment load","Dentinogenesis imperfecta","Radiographic findings"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-79E74FB51B924E714DEF62A4C87F5D35"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1186/s12903-018-0639-7","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Dentistry and Oral Health, Department of Dentistry and Oral Health - Section for Pediatric Dentistry"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Kirstine Juhl","key":"thuesenpau","last":"Thuesen","locid":"4309e3b9-b50b-47de-96a0-fecbac722351","name":"Thuesen, Kirstine Juhl","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hans","key":"gjøruppau","last":"Gjørup","locid":"09e05c36-ee41-48dd-ab77-12b82e3ea6db","name":"Gjørup, Hans","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jannie Dahl","key":"haldpau","last":"Hald","locid":"54ea4787-ebce-4811-81f6-d46e385db55b","name":"Hald, Jannie Dahl","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Malene Hørnø","key":"schmidtpau","last":"Schmidt","locid":"5cd2e04c-40d9-4ae2-acfc-bdd5e3382842","name":"Schmidt, Malene","name_org":"Schmidt, Malene Hørnø","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Torben","key":"harsløfpau","last":"Harsløf","locid":"10ba525b-3079-4cc3-acf9-5e49908ba752","name":"Harsløf, Torben","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Bente Lomholt","key":"langdahlpau","last":"Langdahl","locid":"1c4e9957-996d-4c56-aa0d-4e57e7be12a5","name":"Langdahl, Bente Lomholt","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Dorte","key":"haubekpau","last":"Haubek","locid":"5810b477-1799-4dc4-b619-5c04fe335800","name":"Haubek, Dorte","rank":7,"rolecode":"pau"}],"pmid":["30355314"],"pub":{"doi":"10.1186/s12903-018-0639-7","issn":["14726831"],"issue":"1","journal":"BMC Oral Health","pages":"1-7","paperid":"175","publisher":"BioMed Central","status":"p","title":"BMC Oral Health","volume":"18"},"review":"Peer Reviewed","scoID":["2-s2.0-85055477532"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-1ca8846a-b67b-48ae-93b4-b23120ffb36a"],"src":["AU Aarhus University"],"title":"The dental perspective on osteogenesis imperfecta in a Danish adult population","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-145739","year":"2018","yearsub":"2018"}
{"abstract":"Background: Excessive amounts of bile acids entering the colon due to bile acid malabsorption cause chronic bile acid diarrhoea. Diagnosis is possible by measuring the retention fraction of orally ingested 75 Selenium homotaurocholic acid (SeHCAT). The knowledge of long-term effects of medical treatment is sparse. Aim: To describe diarrhoea, adherence to treatment, treatment effects and quality of life in a large, well-defined cohort of patients with bile acid diarrhoea. Methods: A retrospective survey was performed among 594 patients with bile acid malabsorption verified by SeHCAT scans at our unit between 2003 and 2016. Questionnaires about medical history, diarrhoea, use of medication, and quality of life scores were mailed to all patients. Results: Among 594 patients 377 (69%) responded. Among respondents, 121 (32%) had bile acid diarrhoea due to ileal disease or resection (type 1), 198 (52%) idiopathic bile acid diarrhoea (type 2) and 58 (16%) bile acid diarrhoea due to other non-ileal disease, mainly cholecystectomy (type 3). At follow-up, half of the patients, 184 (50%), reported improvement of diarrhoea. However, 273 patients (74%) still reported diarrhoea and 234 (62%) regularly used anti-diarrhoeal medication. In spite of treatment, 235 (64%) considered reduced quality of life by diarrhoea and 184 (50%) reported that diarrhoea was unaltered or worse than before established diagnosis. Conclusion: Many patients with bile acid diarrhoea continue to have bothersome diarrhoea in spite of correct diagnosis and treatment.","author_count":8,"contributors":["Damsgaard, Brian","Dalby, Helene Rask","Krogh, Klaus","Baunwall, Simon Mark Dahl","Arveschoug, Anne Kirstine","Agnholt, Jørgen","Dahlerup, Jens Frederik","Jørgensen, Søren Peter"],"cuid":["S01-000.00-164926"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Journal Article"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"long term effect of medical treatment of diarrhoea in 000000000377 patients with sehcat scan diagnosed bile acid malabsorption from 000000002003 to 000000002016 a retrospective study","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85041049169","version":"Other Version"},"id":"S01-000.00-164926","identifier":[{"id":"85041049169","type":"scopus"},{"id":"29368342","type":"pmid"}],"ids":["au-3e7eb206-8d96-456e-bce2-7f7a790087ee"],"keyword":["Journal Article","galdesyremalabsorption"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-9E852EF093DFD3C9DB660E15B7B1E096"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Hepatology and Gastroenterology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"B","key":"damsgaardbrianpau","last":"Damsgaard","locid":"f48c192a-c313-4b3a-b893-2fd18cbb44d0","name":"Damsgaard, Brian","name_org":"Damsgaard, B","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"H R","key":"dalbyheleneraskpau","last":"Dalby","locid":"be2e9a57-352a-4ed8-b1e2-be9ab9b477a2","name":"Dalby, Helene Rask","name_org":"Dalby, H R","orcid":"0000-0001-8923-314X","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"K","key":"kroghklauspau","last":"Krogh","locid":"e69f7028-9eb1-4f3a-ab4e-c684c234bf2e","name":"Krogh, Klaus","name_org":"Krogh, K","orcid":"0000-0001-9168-2403","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"S M D","key":"baunwallsimonmarkdahlpau","last":"Jørgensen","locid":"c2a9d590-d3a4-47cc-b7ea-b74f4a373083","name":"Baunwall, Simon Mark Dahl","name_org":"Jørgensen, S M D","orcid":"0000-0002-5135-7435","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anne Kirstine","key":"arveschougannekirstinepau","last":"Arveschoug","locid":"ddccbd46-0d20-441c-a990-e6881ca12a01","name":"Arveschoug, Anne Kirstine","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"J","key":"agnholtjørgenpau","last":"Agnholt","locid":"66d6b88f-b5c0-4c2e-b073-056cd18dc1ea","name":"Agnholt, Jørgen","name_org":"Agnholt, J","orcid":"0009-0006-4776-0121","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"J F","key":"dahlerupjensfrederikpau","last":"Dahlerup","locid":"0f52b503-fe76-4e51-939a-7a24f226f420","name":"Dahlerup, Jens Frederik","name_org":"Dahlerup, J F","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"S P","key":"jørgensensørenpeterpau","last":"Jørgensen","locid":"8af81c1a-8d41-4579-8030-c7097092767e","name":"Jørgensen, Søren Peter","name_org":"Jørgensen, S P","rank":8,"rolecode":"pau"}],"pmid":["29368342"],"pub":{"doi":"10.1111/apt.14533","issn":["02692813","09530673"],"issn_org":["02692813"],"issue":"7","journal":"Alimentary Pharmacology and Therapeutics","pages":"951-957","publisher":"John Wiley & Sons Inc.","status":"p","title":"Alimentary Pharmacology and Therapeutics","volume":"47"},"review":"Peer Reviewed","scoID":["2-s2.0-85041049169"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-3e7eb206-8d96-456e-bce2-7f7a790087ee"],"src":["AU Aarhus University"],"title":"Long-term effect of medical treatment of diarrhoea in 377 patients with SeHCAT scan diagnosed bile acid malabsorption from 2003 to 2016; a retrospective study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-164926","year":"2018","yearsub":"2018"}
{"abstract":"Aberrant expression of O-glycans is a hallmark of epithelial cancers. Mucin type O-glycosylation is initiated by a large family of UDP-GalNAc:polypeptide N-acetyl-galactosaminyltransferases (GalNAc-Ts), that target different proteins and are differentially expressed in cells and organs. Here we investigated the expression patterns of all of the GalNAc-Ts in colon cancer by analysing transcriptomic data. We found that GalNAc-T6 was highly upregulated in colon adenocarcinomas but absent in normal-appearing adjacent colon tissue. The results were verified by immunohistochemistry, suggesting that GalNAc-T6 plays a role in colon carcinogenesis. To investigate the function of GalNAc-T6 in colon cancer, we used precise gene targeting to produce isogenic colon cancer cell lines with a knockout/-rescue system for GalNAc-T6. GalNAc-T6 expression was associated with a cancer-like, dysplastic growth pattern, whereas GalNAc-T6 knockout cells showed a more normal differentiation pattern, reduced proliferation, normalized cell-cell adhesion, and formation of crypts in tissue cultures. O-glycoproteomic analysis of the engineered cell lines identified a small set of GalNAc-T6-specific targets, suggesting that this isoform has unique cellular functions. In support of this notion, the genetically and functionally closely related GalNAc-T3 homologue did not shown compensatory functionality for effects observed for GalNAc-T6. Taken together, these data strongly suggest that aberrant GalNAc-T6 expression and site-specific glycosylation is involved in oncogenic transformation.","author_count":11,"contributors":["Lavrsen, Kirstine","Dabelsteen, Sally","Vakhrushev, Sergey Y.","Levann, Asha Maria Rudjord","Haue, Amalie Dahl","Dylander, August","Mandel, Ulla","Hansen, Lars","Frödin, Morten","Bennett, Eric P","Wandall, Hans H"],"cuid":["S01-000.00-541954"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"de novo expression of human polypeptide n acetylgalactosaminyltransferase 000000000006 galnac t000000000006 in colon adenocarcinoma inhibits the differentiation of colonic epithelium","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"doi","url":"https://doi.org/10.1074/jbc.M117.812826","version":"Published Version"},"id":"S01-000.00-541954","identifier":[{"id":"29187600","type":"pmid"},{"id":"85041212100","type":"scopus"},{"id":"PMC5787806","type":"pmcid"}],"ids":["ku-f8cadfc4-4ad6-4020-8a20-c46cc278c969"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-E1452A304819C77D4A6A1AEB34FB37AE"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"doi","url":"https://doi.org/10.1074/jbc.M117.812826","version":"Published Version"},{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC5787806/pdf/zbc1298.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Cellular and Molecular Medicine, Glycomics Program"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Kirstine","key":"lavrsenpau","last":"Lavrsen","locid":"79304d80-2ecf-4547-94dc-7fd7f73350f6","name":"Lavrsen, Kirstine","rank":1,"rolecode":"pau"},{"affno":"1","first":"Sally","key":"dabelsteenpau","last":"Dabelsteen