pub":{"doi":"10.1016/s0168-8278(23)00899-1","issn":["01688278","16000641"],"issn_org":["01688278"],"issue":"Suppl. 1","journal":"Journal of Hepatology","pages":"303-304","publisher":"Elsevier","status":"p","title":"Journal of Hepatology","volume":"78"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Nordic Bioscience","Private Research","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-3f551e21-2e07-47d6-887f-e77d85805c16"],"src":["SDU University of Southern Denmark"],"title":"Terlipressin has acute effects on systemic inflammation markers in patients with cirrhosis and ascites","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-685071","year":"2023","yearsub":"2023"}
{"abstract":"Anti-SSA-autoantibodies are common in patients with rheumatologic disease, especially Sjögren's syndrome, systemic lupus erythematosus and rheumatoid arthritis. They consist of both autoantibodies towards Ro60 and Ro52, the latter also known as TRIM21. TRIM21 is an intracellular protein consisting of four domains; PRY/SPRY, Coiled-Coil, B-box and RING. The aim of this study was to establish an indirect ELISA detecting autoantibodies towards both the full-length TRIM21 protein and its four domains. We expressed the five constructs, created, and validated indirect ELISA protocols for each target using plasma from anti-SSA positive patients and healthy controls. Our findings were validated to the clinically used standards. We measured significantly higher levels of autoantibodies towards our full-length TRIM21, and the PRY/SPRY, Coiled-Coil and RING domains in patients compared to healthy controls. No significant difference in the level of autoantibodies were detected against the B-box domain. Our setups had a signal to noise ratio in the range of 30 to 184, and an OD between 2 and 3. Readings did not decline using NaCl of 500 mM as wash, affirming the high binding affinity of the autoantibodies measured. Our protocols allow us to further study the different autoantibodies of anti-SSA positive patients. This creates the possibility to stratify our patients into subgroups regarding autoantibody profile and specific pheno- or endotype.","author_count":8,"contributors":["Dahl, Marie Louise Næstholt","Mikkelsen, Jakob Hauge","Hvid, Malene","Korsholm, Trine-Line","Nielsen, Kirstine Overgaard","Andersen, Christian Brix Folsted","Greisen, Stinne Ravn","Deleuran, Bent"],"cuid":["S01-000.00-709842"],"filters":{"added":"2024-02","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Dahl, Marie Louise Næstholt"],"keyword":["Autoantibodies","Autoantigens","Enzyme Linked Immunosorbent Assay","Humans","Lupus Erythematosus Systemic diagnosis","Protein Domains","Sjogren s Syndrome diagnosis"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"validation of an indirect elisa assay for assessment of autoantibodies against full length trim000000000021 and its individual domains","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85163469790","version":"Other Version"},"id":"S01-000.00-709842","identifier":[{"id":"85163469790","type":"scopus"},{"id":"37379227","type":"pmid"}],"ids":["au-f7af9563-c886-4164-9d37-ada2440539af"],"keyword":["Autoantibodies","Autoantigens","Enzyme-Linked Immunosorbent Assay","Humans","Lupus Erythematosus, Systemic/diagnosis","Protein Domains","Sjogren's Syndrome/diagnosis"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-FFB35F1E660C9C41362D9338DACCAA55"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Biomedicine","Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Section for Rheumatology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Marie Louise Næstholt","key":"dahlpau","last":"Dahl","locid":"3595a0ec-4ec5-4d9c-ade5-03d97811ab69","name":"Dahl, Marie Louise Næstholt","orcid":"0000-0003-2138-2477","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jakob Hauge","key":"mikkelsenpau","last":"Mikkelsen","locid":"add25105-9c97-437e-9ffb-acbcbdd65a7c","name":"Mikkelsen, Jakob Hauge","orcid":"0