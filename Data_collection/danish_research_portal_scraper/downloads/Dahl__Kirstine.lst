","rank":5,"rolecode":"pau"},{"affno":"6 1","first":"Lisbeth S.","key":"schmidtpau","last":"Schmidt","locid":"cac4bfbd-c7b5-48c1-946f-03a0d4596cea","name":"Schmidt, Lisbeth Samsø","name_org":"Schmidt, Lisbeth S.","rank":6,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Lise B.","key":"toustruppau","last":"Toustrup","locid":"564c2ff1-8e7d-40f7-8754-c39b1414979f","name":"Toustrup, Lise Bols","name_org":"Toustrup, Lise B.","rank":7,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"first":"Lotte H.","key":"hansenpau","last":"Hansen","locid":"92c1a24c-61ec-469b-914f-0f5b42a2831c","name":"Hansen, Lotte Høeg","name_org":"Hansen, Lotte H.","orcid":"0000-0002-8679-9364","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kathrin W.","key":"dahlpau","last":"Dahl","name":"Dahl, Kathrin W.","rank":9,"rolecode":"pau"},{"affno":"8 9","corresponding":null,"first":"Kirstine T.","key":"matthesenpau","last":"Matthesen","locid":"07d2c060-5e03-4d97-9186-e20df5efd02f","name":"Matthesen, Kirstine Thaarup","name_org":"Matthesen, Kirstine T.","rank":10,"rolecode":"pau"},{"affno":"10","corresponding":null,"first":"Anne C.","key":"nordholmpau","last":"Nordholm","name":"Nordholm, Anne C.","rank":11,"rolecode":"pau"},{"affno":"10","corresponding":null,"first":"Søren","key":"uldumpau","last":"Uldum","name":"Uldum, Søren","rank":12,"rolecode":"pau"},{"affno":"10","corresponding":null,"first":"Hanne Dorthe","key":"emborgpau","last":"Emborg","name":"Emborg, Hanne Dorthe","rank":13,"rolecode":"pau"},{"affno":"6 7","first":"Maren J.H.","key":"rytterpau","last":"Rytter","locid":"dd4e1fa9-0366-420b-81cb-0c341b6125b7","name":"Rytter, Maren Johanne Heilskov","name_org":"Rytter, Maren J.H.","rank":14,"rolecode":"pau"},{"affno":"1 6","first":"Ulrikka","key":"nygaardpau","last":"Nygaard","locid":"43b2e239-ddc1-4676-a8db-0a0f23906813","name":"Nygaard, Ulrikka","rank":15,"rolecode":"pau"}],"pmid":["39469091"],"pub":{"doi":"10.1016/j.lanepe.2024.101103","issn":["26667762"],"journal":"The Lancet Regional Health - Europe","paperid":"101103","publisher":"Elsevier","status":"p","title":"The Lancet Regional Health - Europe","volume":"47"},"review":"Peer Reviewed","scoID":["2-s2.0-85206433309"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","North Denmark Region","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-9b7136fa-f968-431a-ac9d-2be2dee84254","au-c1191eac-395b-4f9d-9107-fbdbc9680b48","ku-3cab93f1-0839-40fe-9eca-1277e59ed329","sdu-3bfd7329-7f1e-4ddf-b432-03bc94fc0b3d"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Mycoplasma pneumoniae incidence, phenotype, and severity in children and adolescents in Denmark before, during, and after the COVID-19 pandemic: a nationwide multicentre population-based cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-099.72-803772","year":"2024","yearsub":"2024"}
{"abstract":"Objectives: An increasing incidence of positive blood cultures has been reported in several countries. This represents an important challenge for public health due to the large number of hospital admissions with high mortality among these patients. This study aims to characterize the epidemiology and mortality associated with positive blood cultures. Study design and methods: We performed a nationwide cohort study, identifying all individuals with a blood culture drawn in Denmark from 2010 to 2022. We estimated the incidence of positive blood cultures and 30-day mortality per 100,000 individuals and modeled the case fatality rate (CFR) and population incidences with regression techniques. Results: We identified almost 4 million blood cultures drawn during the study period, increasing 64% from 220,757 in 2010 to 362,239 in 2022. During this period, the underlying population increased only 10%, whereas the population of older adults above 85 years increased 3.3 times. The positivity rate was 9.8%, and the most common pathogens were Escherichia coli (29%) and other pathogens associated with urinary tract infection, whereas Staphylococcus aureus accounted for 12%, and Enterococcus faecium for 4.1%. The 30-day CFR was 17% with a small reduction during the study period, with notable differences according to species. Conclusion: We found a substantial rise in blood culture activity and the incidence of positive cultures. This rise is driven by an increasing number of older citizens, which is expected to increase further in the coming years. Considering the high risk of mortality and increasing incidence, a national surveillance of bacteremia is warranted.","author_count":17,"contributors":["Dessau, Ram B.","Andersen, Christian Østergaard","Coia, John","Ellermann-Eriksen, Svend","Gubbels, Sophie","Jensen, Thøger Gorm","Knudsen, Jenny Dahl","Kähler, Jonas","Lomborg, Steen","Lützen, Lisbeth","Nielsen, Marc Trunjer Kusk","Olesen, Bente Scharvik","Pinholt, Mette","Scheutz, Flemming","Søgaard, Kirstine K.","Voldstedlund, Marianne","Mølbak, Kåre"],"cuid":["S04-100.00-803794"],"filters":{"added":"2025-02","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"corresponding_author":["Dessau, Ram B.","Dessau, Ram Benny"],"keyword":["Adolescent","Adult","Aged","Aged 80 and over","Bacteremia","Bacteremia mortality","Blood Culture statistics numerical data","Blood culture","Child","Child Preschool","Cohort Studies","Denmark epidemiology","Epidemiology","Female","Humans","Incidence","Infant","Male","Middle Aged","Urinary tract infection","Young Adult","aging adults"],"level":"sci","mra":["med","soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-OT","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR"],"OT":["Esbjerg og Grindsted Sygehus"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"the increasing incidence and mortality of bacteremia in denmark from 000000002010 to 000000002022 a population based nationwide cohort study","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fpubh.2024.1502893","version":"Published Version"},"funding_acknowledgement":["SSI har betalt open access"],"id":"S04-100.00-803794","identifier":[{"id":"39758201","type":"pmid"},{"id":"PMC11695369","type":"pmcid"},{"id":"85214091864","type":"scopus"}],"ids":["aau-abde9d0c-16da-43fa-813f-1038901fef5b","au-f4f13187-c8fa-4857-8ae1-2cb47eadf819","ku-4ff2e1f0-a745-4b81-b57a-4b3d393c5c14","sdu-45d95c75-025b-4ea4-8944-08ab1986e294"],"keyword":["Adolescent","Adult","Aged","Aged, 80 and over","Bacteremi