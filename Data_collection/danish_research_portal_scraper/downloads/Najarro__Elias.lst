{"author_count":3,"contributors":["Najarro, Elias","Risi, Sebastian","Sudhakaran, Shyam"],"cuid":["S01-000.00-718862"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"towards self assembling artificial neural networks through neural developmental programs","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/108495234/isal_a_00697.pdf","version":"Published Version"},"id":"S01-000.00-718862","identifier":[{"id":"105007222482","type":"scopus"}],"ids":["itu-64fc45cd-4f71-4b75-a3dd-833b32125ca2"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-59704F792D60173F3B3CF5CD02225852"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/108495234/isal_a_00697.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Play, Culture, and AI, Creative AI Lab"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Elias","key":"najarropau","last":"Najarro","locid":"98a59a44-499e-4a6e-a8e8-24211f117b23","name":"Najarro, Elias","orcid":"0000-0002-7875-3251","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sebastian","key":"risipau","last":"Risi","locid":"a420ffb3-2ca6-4925-a25f-baaa5228fc15","name":"Risi, Sebastian","orcid":"0000-0003-3607-8400","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Shyam","key":"sudhakaranpau","last":"Sudhakaran","locid":"b4a6e67f-0caa-4faf-a136-bf77496f3659","name":"Sudhakaran, Shyam","rank":3,"rolecode":"pau"}],"pub":{"issn":["26931508"],"journal":"Artificial Life Conference Proceedings","publisher":"MIT Press","status":"p","title":"Artificial Life Conference Proceedings"},"review":"Peer Reviewed","scoID":["2-s2.0-105007222482"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-64fc45cd-4f71-4b75-a3dd-833b32125ca2"],"src":["ITU IT University of Copenhagen"],"title":"Towards Self-Assembling Artificial Neural Networks through Neural Developmental Programs","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-718862","year":"2023","yearsub":"2023"}
{"abstract":"A successful development of a complex multicellular organism took millions of years of evolution. The genome of such a multicellular organism guides the development of its body from a single cell, including its control system. Our goal is to imitate this natural process using a single neural cellular automaton (NCA) as a genome for modular robotic agents. In the introduced approach, called Neural Cellular Robot Substrate (NCRS), a single NCA guides the growth of a robot and the cellular activity which controls the robot during deployment. We also introduce three benchmark environments, which test the ability of the approach to grow different robot morphologies. We evolve the NCRS with covariance matrix adaptation evolution strategy (CMA-ES), and covariance matrix adaptation MAP-Elites (CMA-ME) for quality diversity and observe that CMA-ME generates more diverse robot morphologies with higher fitness scores. While the NCRS is able to solve the easier tasks in the benchmark, the success rate reduces when the difficulty of the task increases. We discuss directions for future work that may facilitate the use of the NCRS approach for more complex domains.","author_count":5,"contributors":["Pontes-Filho, Sidney","Walker, Kathryn Elizabeth","Najarro, Elias","Nichele, Stefano","Risi, Sebastian"],"cuid":["S01-000.00-383201"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Evolutionary Robotics","Modular Robots","Neural Cellular Automata NCA","Quality Diversity Evolution Strategies","Robot Morphogenesis"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"a unified substrate for body brain co evolution","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/92843039/2203.12066.pdf","version":"Published Version"},"id":"S01-000.00-383201","ids":["itu-836fa242-af47-4796-8c83-a96d8e0f0727"],"keyword":["- Evolutionary Robotics","- Modular Robots","- Neural Cellular Automata (NCA)","- Quality Diversity Evolution Strategies","- Robot Morphogenesis"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-4F23317C3979AA9EAFAD5718CC0533DC"],"oa_link":[{"access":"oa","license":"CC BY","type":"rem","url":"https://arxiv.org/abs/2203.12066","version":"Authors Final Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/92843039/2203.12066.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Play, Culture, and AI, Creative AI Lab"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Sidney","key":"pontesfilhopau","last":"Pontes-Filho","name":"Pontes-Filho, Sidney","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kathryn Elizabeth","key":"walkerpau","last":"Walker","name":"Walker, Kathryn Elizabeth","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Elias","key":"najarropau","last":"Najarro","locid":"98a59a44-499e-4a6e-a8e8-24211f117b23","name":"Najarro, Elias","orcid":"0000-0002-7875-3251","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Stefano","key":"nichelepau","last":"Nichele","name":"Nichele, Stefano","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sebastian","key":"risipau","last":"Risi","locid":"a420ffb3-2ca6-4925-a25f-baaa5228fc15","name":"Risi, Sebastian","orcid":"0000-0003-3607-8400","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-836fa242-af47-4796-8c83-a96d8e0f0727"],"src":["ITU IT University of Copenhagen"],"title":"A Unified Substrate for Body-Brain Co-evolution","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383201","year":"2022","yearsub":"2022"}
{"abstract":"In contrast to deep reinforcement learning agents, biological neural networks are grown through a self-organized developmental process. Here we propose a new hypernetwork approach to grow artificial neural networks based on neural cellular automata (NCA). Inspired by self-organising systems and information-theoretic approaches to developmental biology, we show that our HyperNCA method can grow neural networks capable of solving common reinforcement learning tasks. Finally, we explore how the same approach can be used to build developmental metamorphosis networks capable of transforming their weights to solve variations of the initial RL task.","author_count":4,"contributors":["Najarro, Elias","Sudhakaran, Shyam","Glanois, Claire","Risi, Sebastian"],"cuid":["S01-000.00-381397"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Biological neural networks","HyperNCA","Neural Cellular Automata","metamorphosis networks","self organized developmental process"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"hypernca growing developmental networks with neural cellular automata","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://arxiv.org/abs/2204.11674","version":"Authors Final Version"},"id":"S01-000.00-381397","ids":["itu-099e48ae-434e-48d0-ad58-ec423e84d5d1"],"keyword":["HyperNCA","biological neural networks","metamorphosis networks","neural cellular automata","self-organized developmental process"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-CD59130E627483E1D80EA92262A79812"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/92842983/10.4324_9780429355950_14_chapterpdf.pdf","version":"Pre-print"},{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://arxiv.org/abs/2204.11674","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Play, Culture, and AI, Creative AI Lab"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Elias","key":"najarropau","last":"Najarro","locid":"98a59a44-499e-4a6e-a8e8-24211f117b23","name":"Najarro, Elias","orcid":"0000-0002-7875-3251","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Shyam","key":"sudhakaranpau","last":"Sudhakaran","locid":"b4a6e67f-0caa-4faf-a136-bf77496f3659","name":"Sudhakaran, Shyam","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Claire","key":"glanoispau","last":"Glanois","locid":"f2b81a70-1d6c-42d1-a3b5-1d4338be4b8c","name":"Glanois, Claire","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sebastian","key":"risipau","last":"Risi","locid":"a420ffb3-2ca6-4925-a25f-baaa5228fc15","name":"Risi, Sebastian","orcid":"0000-0003-3607-8400","rank":4,"rolecode":"pau"}],"pub":{"issn":["19765541"],"issn_org":["23318422"],"journal":"arXiv","publisher":"arXiv","status":"p","title":"arXiv"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-099e48ae-434e-48d0-ad58-ec423e84d5d1"],"src":["ITU IT University of Copenhagen"],"title":"HyperNCA: Growing Developmental Networks with Neural Cellular Automata","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381397","year":"2022","yearsub":"2022"}
{"abstract":"Recent work has shown promising results using Hebbian meta-learning to solve hard reinforcement learning problems and adapt-to a limited degree-to changes in the environment. In previous works each synapse has its own learning rule. This allows each synapse to learn very specific learning rules and we hypothesize this limits the ability to discover generally useful Hebbian learning rules. We hypothesize that limiting the number of Hebbian learning rules through a \"genomic bottleneck\" can act as a regularizer leading to better generalization across changes to the environment. We test this hypothesis by decoupling the number of Hebbian learning rules from the number of synapses and systematically varying the number of Hebbian learning rules. We thoroughly explore how well these Hebbian meta-learning networks adapt to changes in their environment.","author_count":3,"contributors":["Palm, Rasmus Berg","Najarro, Elias","Risi, Sebastian"],"cuid":["S01-000.00-383522"],"event":{"acronym":"NeurIPS","title":"Conference on Neural Information Processing Systems"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Genomic Bottleneck","Hebbian learning","Meta learning"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"testing the genomic bottleneck hypothesis in hebbian meta learning","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.48550/arXiv.2011.06811","version":"Published Version"},"id":"S01-000.00-383522","identifier":[{"id":"85131026589","type":"scopus"}],"ids":["itu-9a449cd6-cfcc-420c-bd71-91b46953b610"],"keyword":["Genomic Bottleneck","Hebbian learning","Meta learning"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-3-4D89DCA0B6722F767CFEC70959E461CF"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.48550/arXiv.2011.06811","version":"Published Version"},{"access":"oa","type":"rem","url":"https://arxiv.org/abs/2011.06811","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Rasmus Berg","key":"palmpau","last":"Palm","name":"Palm, Rasmus Berg","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Elias","key":"najarropau","last":"Najarro","locid":"98a59a44-499e-4a6e-a8e8-24211f117b23","name":"Najarro, Elias","orcid":"0000-0002-7875-3251","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sebastian","key":"risipau","last":"Risi","locid":"a420ffb3-2ca6-4925-a25f-baaa5228fc15","name":"Risi, Sebastian","orcid":"0000-0003-3607-8400","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.48550/arxiv.2011.06811","issn":["26403498"],"journal":"Proceedings of Machine Learning Research","status":"p","title":"Proceedings of Machine Learning Research","volume":"148"},"review":"Peer Reviewed","scoID":["2-s2.0-85131026589"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-9a449cd6-cfcc-420c-bd71-91b46953b610"],"src":["ITU IT University of Copenhagen"],"title":"Testing the Genomic Bottleneck Hypothesis in Hebbian Meta-Learning","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383522","year":"2021","yearsub":"2021"}
{"abstract":"This paper introduces EvoCraft, a framework for Minecraft designed to study open-ended algorithms. We introduce an API that provides an open-source Python interface for communicating with Minecraft to place and track blocks. In contrast to previous work in Minecraft that focused on learning to play the game, the grand challenge we pose here is to automatically search for increasingly complex artifacts in an open-ended fashion. Compared to other environments used to study open-endedness, Minecraft allows the construction of almost any kind of structure, including actuated machines with circuits and mechanical components. We present initial baseline results in evolving simple Minecraft creations through both interactive and automated evolution. While evolution succeeds when tasked to grow a structure towards a specific target, it is unable to find a solution when rewarded for creating a simple machine that moves. Thus, EvoCraft offers a challenging new environment for automated search methods (such as evolution) to find complex artifacts that we hope will spur the development of more open-ended algorithms. A Python implementation of the EvoCraft framework is available at: github.com/real-itu/Evocraft-py.","author_count":5,"contributors":["Grbic, Djordje","Berg Palm, Rasmus","Najarro, Elias","Glanois, Claire","Risi, Sebastian"],"cuid":["S01-000.00-382906"],"event":{"acronym":"EvoApplications","title":"European Conference on the Applications of Evolutionary Computation"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Evolutionary computation","MIECRAFT","Open ended evolution"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"evocraft a new challenge for open endedness","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86421848/2012.04751.pdf","version":"Other Version"},"id":"S01-000.00-382906","ids":["itu-6e406c79-2b12-4d2d-a7ab-a2aa0aedef80"],"keyword":["Evolutionary computation","MIECRAFT","OPEN ENDED EVOLUTION"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-B3563055C60A4A0D2D68E0538909CC59"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86421848/2012.04751.pdf","version":"Other Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Data, Systems, and Robotics, Robotics, Evolution, and Art Lab","IT University of Copenhagen, Digital Design","IT University of Copenhagen, Play, Culture, and AI, Creative AI Lab"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Djordje","key":"grbicpau","last":"Grbic","locid":"c596539b-3ceb-497c-9a43-e71d6b0f65a6","name":"Grbic, Djordje","orcid":"0000-0002-4388-2539","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rasmus","key":"bergpalmpau","last":"Berg Palm","name":"Berg Palm, Rasmus","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Elias","key":"najarropau","last":"Najarro","locid":"98a59a44-499e-4a6e-a8e8-24211f117b23","name":"Najarro, Elias","orcid":"0000-0002-7875-3251","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Claire","key":"glanoispau","last":"Glanois","locid":"f2b81a70-1d6c-42d1-a3b5-1d4338be4b8c","name":"Glanois, Claire","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sebastian","key":"risipau","last":"Risi","locid":"a420ffb3-2ca6-4925-a25f-baaa5228fc15","name":"Risi, Sebastian","orcid":"0000-0003-3607-8400","rank":5,"rolecode":"pau"}],"pub":{"journal":"Applications of Evolutionary Computation","status":"p","title":"Applications of Evolutionary Computation","volume":"1"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-6e406c79-2b12-4d2d-a7ab-a2aa0aedef80"],"src":["ITU IT University of Copenhagen"],"title":"EvoCraft: A New Challenge for Open-Endedness","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382906","year":"2021","yearsub":"2021"}
{"abstract":"Neural Cellular Automata (NCAs) have been proven effective in simulating morphogenetic processes, the continuous construction of complex structures from very few starting cells. Recent developments in NCAs lie in the 2D domain, namely reconstructing target images from a single pixel or infinitely growing 2D textures. In this work, we propose an extension of NCAs to 3D, utilizing 3D convolutions in the proposed neural network architecture. Minecraft is selected as the environment for our automaton since it allows the generation of both static structures and moving machines. We show that despite their simplicity, NCAs are capable of growing complex entities such as castles, apartment blocks, and trees, some of which are composed of over 3,000 blocks. Additionally, when trained for regeneration, the system is able to regrow parts of simple functional machines, significantly expanding the capabilities of simulated morphogenetic systems. The code for the experiment in this paper can be found at: https://github.com/real-itu/3d-artefacts-nca.","author_count":7,"contributors":["Sudhakaran, Shyam","Grbic, Djordje","Li, Siyan","Katona, Adam","Najarro, Elias","Glanois, Claire","Risi, Sebastian"],"cuid":["S01-000.00-383561"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Cellular automata","Minecraft","Neural Cellular Automata","Open ended evolution"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"growing 000000000003d artefacts and functional machines with neural cellular automata","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86421939/isal_a_00451.pdf","version":"Other Version"},"id":"S01-000.00-383561","identifier":[{"id":"86000272077","type":"scopus"}],"ids":["itu-9cfbe7f0-0225-46d0-ac0e-eaca10caa909"],"keyword":["Minecraft","Neural Cellular Automata","cellular automata","open ended evolution"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-F452FA7C08B2A4307CD75B7EBE9D26C6"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86421939/isal_a_00451.pdf","version":"Other Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Shyam","key":"sudhakaranpau","last":"Sudhakaran","locid":"b4a6e67f-0caa-4faf-a136-bf77496f3659","name":"Sudhakaran, Shyam","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Djordje","key":"grbicpau","last":"Grbic","locid":"c596539b-3ceb-497c-9a43-e71d6b0f65a6","name":"Grbic, Djordje","orcid":"0000-0002-4388-2539","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Siyan","key":"lipau","last":"Li","locid":"71efb6df-0032-4f63-9a05-8489aedd9023","name":"Li, Siyan","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Adam","key":"katonapau","last":"Katona","name":"Katona, Adam","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Elias","key":"najarropau","last":"Najarro","locid":"98a59a44-499e-4a6e-a8e8-24211f117b23","name":"Najarro, Elias","orcid":"0000-0002-7875-3251","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Claire","key":"glanoispau","last":"Glanois","locid":"f2b81a70-1d6c-42d1-a3b5-1d4338be4b8c","name":"Glanois, Claire","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sebastian","key":"risipau","last":"Risi","locid":"a420ffb3-2ca6-4925-a25f-baaa5228fc15","name":"Risi, Sebastian","orcid":"0000-0003-3607-8400","rank":7,"rolecode":"pau"}],"pub":{"issn":["26931508"],"journal":"Artificial Life Conference Proceedings","publisher":"MIT Press","status":"p","title":"Artificial Life Conference Proceedings","volume":"2021"},"review":"Peer Reviewed","scoID":["2-s2.0-86000272077"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-9cfbe7f0-0225-46d0-ac0e-eaca10caa909"],"src":["ITU IT University of Copenhagen"],"title":"Growing 3D Artefacts and Functional Machines with Neural Cellular Automata","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383561","year":"2021","yearsub":"2021"}
{"abstract":"Lifelong learning and adaptability are two defining aspects of biological agents. Modern reinforcement learning (RL) approaches have shown significant progress in solving complex tasks, however once training is concluded, the found solutions are typically static and incapable of adapting to new information or perturbations. While it is still not completely understood how biological brains learn and adapt so efficiently from experience, it is believed that synaptic plasticity plays a prominent role in this process. Inspired by this biological mechanism, we propose a search method that, instead of optimizing the weight parameters of neural networks directly, only searches for synapse-specific Hebbian learning rules that allow the network to continuously self-organize its weights during the lifetime of the agent. We demonstrate our approach on several reinforcement learning tasks with different sensory modalities and more than 450K trainable plasticity parameters. We find that starting from completely random weights, the discovered Hebbian rules enable an agent to navigate a dynamical 2D-pixel environment; likewise they allow a simulated 3D quadrupedal robot to learn how to walk while adapting to morphological damage not seen during training and in the absence of any explicit reward or error signal in less than 100 timesteps.","author_count":2,"contributors":["Najarro, Elias","Risi, Sebastian"],"cuid":["S01-000.00-383933"],"event":{"acronym":"NeurIPS","title":"Conference on Neural Information Processing Systems"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Evolutionary algorithms","Lifelong learning","Machine learning","Reinforcement learning"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"meta learning through hebbian plasticity in random networks","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://proceedings.neurips.cc//paper/2020/hash/ee23e7ad9b473ad072d57aaa9b2a5222-Abstract.html","version":"Published Version"},"id":"S01-000.00-383933","identifier":[{"id":"85107065599","type":"scopus"}],"ids":["itu-b6be272a-9932-4578-9880-a1c7aa03220f"],"keyword":["Evolutionary algorithms","Lifelong learning","Machine learning","Reinforcement learning"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-17FA985D3794A7652B36B2E2155304F3"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85564051/2007.02686.pdf","version":"Other Version"},{"access":"oa","type":"rem","url":"https://proceedings.neurips.cc//paper/2020/hash/ee23e7ad9b473ad072d57aaa9b2a5222-Abstract.html","version":"Published Version"},{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85564182/Meta_Learning_through_Hebbian_Plasticity.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Elias","key":"najarropau","last":"Najarro","locid":"98a59a44-499e-4a6e-a8e8-24211f117b23","name":"Najarro, Elias","orcid":"0000-0002-7875-3251","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sebastian","key":"risipau","last":"Risi","locid":"a420ffb3-2ca6-4925-a25f-baaa5228fc15","name":"Risi, Sebastian","orcid":"0000-0003-3607-8400","rank":2,"rolecode":"pau"}],"pub":{"issn":["10495258"],"journal":"Advances in Neural Information Processing Systems","publisher":"Morgan Kaufmann Publishers","status":"p","title":"Advances in Neural Information Processing Systems","volume":"33"},"review":"Peer Reviewed","scoID":["2-s2.0-85107065599"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-b6be272a-9932-4578-9880-a1c7aa03220f"],"src":["ITU IT University of Copenhagen"],"title":"Meta-Learning through Hebbian Plasticity in Random Networks","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383933","year":"2020","yearsub":"2020"}
