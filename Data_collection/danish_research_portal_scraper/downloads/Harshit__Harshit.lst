mborgpau","last":"Clasen","locid":"da356e76-51f3-4508-8fee-e936bec8ab6b","name":"Clasen, Pernille Damborg","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lili Worre Høpfner","key":"jensenliliworrehøpfnerpau","last":"Jensen","locid":"d15ed510-0b36-42e5-96a0-3e70c811f478","name":"Jensen, Lili Worre Høpfner","orcid":"0000-0001-5932-7700","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Tina Lyngholm","key":"jensentinalyngholmpau","last":"Jensen","locid":"b8c2ffc1-e7b0-4057-a88e-3f7c3e0cd7e3","name":"Jensen, Tina Lyngholm","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Arash","key":"ghaffariarashpau","last":"Ghaffari","locid":"b9c40ef8-06d9-4620-be3c-da453517832b","name":"Ghaffari, Arash","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Harshit","key":"mahapatraharshitpau","last":"Mahapatra","name":"Mahapatra, Harshit","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ole","key":"rahbekolepau","last":"Rahbek","locid":"08263b8a-76aa-4ecd-85fc-e2df9eb8c8e5","name":"Rahbek, Ole","orcid":"0000-0002-5602-4533","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren","key":"koldsørenpau","last":"Kold","locid":"d34549be-50d2-4e77-b6c4-c07def607395","name":"Kold, Søren","orcid":"0000-0002-3387-1473","rank":7,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["Aalborg University","All Danish Affiliations","All GTS Institutes","All Universities","DI-ALL","DI-GTS","DI-GTS-ALL","DI-U","DI-U-ALL","GTS Institutes","Universities"],"PST":["Published"]},"sid":["aau-9b8ee1f5-732e-437f-ba02-64b81d6a8d35"],"src":["AAU Aalborg University"],"title":"Digital monitoring of patients undergoing orthopedic deformity correction: feasibility and patient acceptability","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-805297","year":"2025","yearsub":"2025"}
{"abstract":"This study presents a deep neural network (DNN) model to estimate wave-added resistance using ships main particulars like length, beam, draft, block coefficient, and slenderness ratio. The training dataset is generated from strip-theory calculations across various hull geometries and operational conditions. The model provides fast and reliable wave resistance predictions, outperforming simplified empirical methods which often used in the industry for evaluation of ship performance. The DNN model delivers robust results when validated against direct numerical calculations from the DTU Solver. Additionally, we apply the model within a vessel performance framework to predict propulsion power and analyze biofouling for Ultrabulk ships. Key factors like hyperparameter tuning and dataset selection greatly impact the performance of deep learning models. In this research, the numerical calculations, rather than experimental data, form the training dataset, allowing a more generalized and versatile approach. By optimizing learning rates and other parameters, the model overcomes issues like local minima. The addition of more hull data points and input features could further enhance the accuracy of the DNN model. The model's integration into a ship performance framework enables operators to estimate delivered engine power and compare it with noon reports. This assists in evaluating hull and propeller efficiency, leading to more cost-effective voyages and energy-efficient ship operations. The developed tool has potential for further refinement into a more accurate ship performance monitoring system. This system could improve ship performance through maintenance optimization and quantify the impact of energy-saving retrofits or advanced anti-fouling coatings. These efforts directly reduce greenhouse gas emissions and improve fleet environmental ratings, such as the Energy Efficiency Operational Indicator (EEOI) and Carbon Intensity Indicator (CII).","author_count":6,"contributors":["Eftekhar, Faraz","Bingham, Harry B.","Amini-Afshar, Mostafa","Mittendorf, Malte","Tripathi, Harshit","Nielsen, Ulrik Dam"],"cuid":["S01-000.00-798099"],"event":{"end":"2025-01-31","place":"Kgs. Lyngby, dk","start":"2025-01-30","title":"The 25<sup>th</sup> DNV Nordic Maritime Universities Workshop","year":"2025"},"filters":{"added":"2025-04","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-MAE","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-PR-MAE","DI-PR-OTH","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"use of machine learning for estimation of wave added resistance and its application in ship performance analysis","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/389351286/25th_nmuw_program_abstracts_35.pdf","version":"Published Version"},"id":"S01-000.00-798099","ids":["dtu-7068ab68-cb75-4c3e-ada9-20bdbb0626ff"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-3303D1A57810DB54AF1C890EF08DE748"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/389351286/25th_nmuw_program_abstracts_35.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["Ultrabulk A/S"],"nora_code":"DI-PR-OTH","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Civil and Mechanical Engineering","Technical University of Denmark, Department of Civil and Mechanical Engineering, Fluid Mechanics, Coastal and Maritime Engineering"],"nora_code":"DI-U-DTU","used":1},{"affno":"3","country":"dk","key":"a p moller maersk","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-MAE","l3nl":"A.P. Møller – Mærsk","l3nn":"A.P. Moller - Maersk","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"A.P. Moller - Maersk","namevar":["Maersk Group"],"nora_code":"DI-PR-MAE","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Faraz","key":"eftekharpau","last":"Eftekhar","name":"Eftekhar, Faraz","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Harry B.","key":"binghampau","last":"Bingham","locid":"ce245728-e918-4e11-90de-d143c2403110","name":"Bingham, Harry B.","orcid":"0000-0002-7263-442X","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Mostafa","key":"aminiafsharpau","last":"Amini-Afshar","locid":"14bc2889-74a2-41dc-8997-aa630c9710f0","name":"Amini-Afshar, Mostafa","orcid":"0000-0001-6941-6117","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Malte","key":"mittendorfpau","last":"Mittendorf","name":"Mittendorf, Malte","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Harshit","key":"tripathipau","last":"Tripathi","name":"Tripathi, Harshit","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Ulrik Dam","key":"nielsenpau","last":"Nielsen","locid":"106115f2-5a14-4e9b-ba17-0199c93439b5","name":"Nielsen, Ulrik Dam","orcid":"0000-0001-7470-2003","rank":6,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","sdg":["7. Affordable and Clean Energy","All UN SDG Classification"],"search":{"DAF":["A.P. Møller – Mærsk","All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Other Companies","Private Research","Technical University of Denmark","Universities","ultrabulk a/s"],"PST":["Published"]},"sid":["dtu-7068ab68-cb75-4c3e-ada9-20bdbb0626ff"],"src":["DTU Technical University of Denmark"],"title":"Use of Machine Learning for Estimation of Wave Added Resistance and its Application in Ship Performance Analysis","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-798099","year":"2025","yearsub":"2025"}
{"abstract":"In this article, we develop a deep neural network model to estimate the wave added resistance. The required data to train the model is generated using strip theory calculations over a wide range of hull geometries and operational conditions. The model is efficient as it only requires the ship’s main particulars: length, beam, draft, block coefficient, and slenderness ratio. In addition, we present an application of this model in a vessel performance framework. This will be used for predicting propulsion power and analyzing the degree of biofouling on ships from the company Ultrabulk2. The study shows that the developed deep neural network model produces reliable results in predicting the added wave resistance coefficient in comparison to strip theory calculations. Also, the developed ship propulsion and biofouling analysis display satisfactory output for monitoring hull performance under actual ship operational conditions.","author_count":6,"contributors":["Eftekhar, Faraz","Bingham, Harry B.","Amini-Afshar, Mostafa","Mittendorf, Malte","Tripathi, Harshit","Nielsen, Ulrik Dam"],"cuid":["S01-000.00-797942"],"filters":{"added":"2025-04","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-PR-OTH","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"use of machine learning for estimation of wave added resistance and its application in ship performance analysis","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1115/1.4067794","version":"Published Version"},"id":"S01-000.00-797942","ids":["dtu-35287e3c-955a-440f-aa79-af29b5ecbdca"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-4