senpau","last":"Mølgaard Thaysen","name":"Mølgaard Thaysen, Frederik","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Michael","key":"christensenpau","last":"Christensen","name":"Christensen, Michael","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Isuru","key":"dewundarapau","last":"Dewundara","name":"Dewundara, Isuru","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Thor-Bjørn","key":"ottosenpau","last":"Ottosen","name":"Ottosen, Thor-Bjørn","rank":7,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Klaus","key":"kirketerpmøllerpau","last":"Kirketerp-Møller","name":"Kirketerp-Møller, Klaus","rank":8,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["Aalborg University","All Danish Affiliations","All GTS Institutes","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-GTS","DI-GTS-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","GTS Institutes","Hospitals","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["aau-ac8b4832-96c3-4b0e-bede-875c8f342ca0"],"src":["AAU Aalborg University"],"title":"THE WOUND APP – A CITIZEN TOOL","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-705763","year":"2023","yearsub":"2023"}
{"abstract":"Background: Smartphones are often equipped with inertial sensors that measure individuals' physical activity (PA). However, their role in remote monitoring of the patients' PAs in telemedicine needs to be adequately explored. Objective: This study aimed to explore the correlation between a participant's actual daily step counts and the daily step counts reported by their smartphone. In addition, we inquired about the usability of smartphones for collecting PA data. Methods: This prospective observational study was conducted among patients undergoing lower limb orthopedic surgery and a group of nonpatients as control. The data from the patients were collected from 2 weeks before surgery until 4 weeks after the surgery, whereas the data collection period for the nonpatients was 2 weeks. The participant's daily step count was recorded by PA trackers worn 24/7. In addition, a smartphone app collected the number of daily steps registered by the participants' smartphones. We compared the cross-correlation between the daily steps time series obtained from the smartphones and PA trackers in different groups of participants. We also used mixed modeling to estimate the total number of steps, using smartphone step counts and the characteristics of the patients as independent variables. The System Usability Scale was used to evaluate the participants' experience with the smartphone app and the PA tracker. Results: Overall, 1067 days of data were collected from 21 patients (n=11, 52% female patients) and 10 nonpatients (n=6, 60% female patients). The median cross-correlation coefficient on the same day was 0.70 (IQR 0.53-0.83). The correlation in the nonpatient group was slightly higher than that in the patient group (median 0.74, IQR 0.60-0.90 and median 0.69, IQR 0.52-0.81, respectively). The likelihood ratio tests on the models fitted by mixed effects methods demonstrated that the smartphone step count was positively correlated with the PA tracker's total number of steps (2 1=34.7, P<.001). In addition, the median usability score for the smartphone app was 78 (IQR 73-88) compared with median 73 (IQR 68-80) for the PA tracker. Conclusions: Considering the ubiquity, convenience, and practicality of smartphones, the high correlation between the smartphones and the total daily step count time series highlights the potential usefulness of smartphones in detecting changes in the number of steps in remote monitoring of a patient's PA.","author_count":8,"contributors":["Ghaffari, Arash","Kildahl Lauritsen, Rikke Emilie","Christensen, Michael","Thomsen, Trine Rolighed","Mahapatra, Harshit","Heck, Robert","Kold, Søren","Rahbek, Ole"],"cuid":["S02-099.96-681243"],"filters":{"added":"2023-07","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Ghaffari, Arash"],"keyword":["Mixed effects modeling","Mobile phone","Physical activity","Remote monitoring","Smartphone application","Step count","Wearable sensors","step count prediction"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GTS","DI-U"],"level3":{"GTS":["DI-GTS-ALL","DI-GTS-ALX","DI-GTS-DTCI"],"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-GTS-ALX","DI-GTS-DTCI","DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"exploring the feasibility and usability of smartphones for monitoring physical activity in orthopedic patients prospective observational study","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.2196/44442","version":"Published Version"},"id":"S02-099.96-681243","identifier":[{"id":"PMC10354652","type":"pmcid"},{"id":"85164243508","type":"scopus"},{"id":"37283228","type":"pmid"}],"ids":["aau-5b487cf0-a96f-4305-b7dc-d81b07df39ec","au-3c03e44c-daff-4dcd-aecc-f8a3a13f41ce"],"keyword":["mixed effects modeling","mobile phone","physical activity","remote monitoring","smartphone application","step count","step count prediction","wearable sensors"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-8C5FDA799C43B1C486065AC8E5ABE90D"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/550216483/PDF.pdf","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.2196/44442","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Orthopaedic Surgery","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"alexandra institute","l2":"DI-GTS","l2n":"GTS Institutes","l3":"DI-GTS-ALX","l3nn":"Alexandra Institute","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Alexandra Institute","namevar":["Alexandra Institute"],"nora_code":"DI-GTS-ALX","used":1},{"affno":"3","country":"dk","key":"danish technological institute","l2":"DI-GTS","l2n":"GTS Institutes","l3":"DI-GTS-DTCI","l3nn":"Danish Technological Institute","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Danish Technological Institute","namevar":["Danish Technological Institute"],"nora_code":"DI-GTS-DTCI","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Arash","key":"ghaffaripau","last":"Ghaffari","locid":"b9c40ef8-06d9-4620-be3c-da453517832b","name":"Ghaffari, Arash","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rikke Emilie","ke