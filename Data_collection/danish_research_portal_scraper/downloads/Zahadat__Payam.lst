t":"Heinrich","locid":"08c85002-6341-40a3-9046-b6222a08f965","name":"Heinrich, Mary Katherine","rank":1,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Sebastian","key":"vonmammenpau","last":"von Mammen","name":"von Mammen, Sebastian","rank":2,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Sebastian von","key":"mammenpau","last":"Mammen","name":"Mammen, Sebastian von","rank":2,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Daniel Nicolas","key":"hofstadlerpau","last":"Hofstadler","name":"Hofstadler, Daniel Nicolas","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mostafa","key":"wahbypau","last":"Wahby","name":"Wahby, Mostafa","rank":4,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Payam","key":"zahadatpau","last":"Zahadat","name":"Zahadat, Payam","rank":5,"rolecode":"pau"},{"affno":"6 7","corresponding":null,"first":"Tomasz","key":"skrzypczakpau","last":"Skrzypczak","name":"Skrzypczak, Tomasz","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mohammad","key":"divbandsooratipau","last":"Divband Soorati","name":"Divband Soorati, Mohammad","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mohammad Divband","key":"sooratipau","last":"Soorati","name":"Soorati, Mohammad Divband","rank":7,"rolecode":"pau"},{"affno":"6 7","corresponding":null,"first":"Rafal","key":"krelapau","last":"Krela","name":"Krela, Rafal","rank":8,"rolecode":"pau"},{"affno":"6 7","corresponding":null,"first":"Wojciech","key":"kwiatkowskipau","last":"Kwiatkowski","name":"Kwiatkowski, Wojciech","rank":9,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Thomas","key":"schmicklpau","last":"Schmickl","name":"Schmickl, Thomas","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Phil","key":"ayrespau","last":"Ayres","locid":"809e3672-ddc8-44e7-8a1b-1c1309974305","name":"Ayres, Phil","orcid":"0000-0002-9266-065X","rank":11,"rolecode":"pau"},{"affno":"8","corresponding":null,"first":"Kasper","key":"støypau","last":"Støy","locid":"2a9c0934-98ca-4101-b829-b88d77f6487e","name":"Støy, Kasper","orcid":"0000-0003-0179-2487","rank":12,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Heiko","key":"hamannpau","last":"Hamann","name":"Hamann, Heiko","rank":13,"rolecode":"pau"}],"pub":{"doi":"10.1098/rsif.2019.0238","issn":["17425662","17425689"],"issn_org":["17425662"],"issue":"156","journal":"Journal of the Royal Society. Interface","status":"p","title":"Journal of the Royal Society. Interface","title_org":"Journal of The Royal Society Interface","volume":"16"},"review":"Peer Reviewed","scoID":["2-s2.0-85070269359"],"search":{"DAF":["All Artistic Higher Education Institutions","All Danish Affiliations","All Universities","Artistic Higher Education Institutions","DI-ALL","DI-ART","DI-ART-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["arkc-2f61f70f-9974-4ddd-86c2-49506a657f3f","itu-acd3a16c-1836-4ff8-8447-34f1f3375642"],"src":["ITU IT University of Copenhagen","Royal Danish Academy - Architecture, Design, Conservation"],"title":"Constructing Living Buildings : A Review of Relevant Technologies for a Novel Application of Biohybrid Robotics","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-091.84-666042","year":"2019","yearsub":"2019"}
{"abstract":"Robot systems are actively researched for manipulation of natural plants, typically restricted to agricultural automation activities such as harvest, irrigation, and mechanical weed control. Extending this research, we introduce here a novel methodology to manipulate the directional growth of plants via their natural mechanisms for signaling and hormone distribution. An effective methodology of robotic stimuli provision can open up possibilities for new experimentation with later developmental phases in plants, or for new biotechnology applications such as shaping plants for green walls. Interaction with plants presents several robotic challenges, including short-range sensing of small and variable plant organs, and the controlled actuation of plant responses that are impacted by the environment in addition to the provided stimuli. In order to steer plant growth, we develop a group of immobile robots with sensors to detect the proximity of growing tips, and with diodes to provide light stimuli that actuate phototropism. The robots are tested with the climbing common bean, Phaseolus vulgaris, in experiments having durations up to five weeks in a controlled environment. With robots sequentially emitting blue light—peak emission at wavelength 465 nm—plant growth is successfully steered through successive binary decisions along mechanical supports to reach target positions. Growth patterns are tested in a setup up to 180 cm in height, with plant stems grown up to roughly 250 cm in cumulative length over a period of approximately seven weeks. The robots coordinate themselves and operate fully autonomously. They detect approaching plant tips by infrared proximity sensors and communicate via radio to switch between blue light stimuli and dormant status, as required. Overall, the obtained results support the effectiveness of combining robot and plant experiment methodologies, for the study of potentially complex interactions between natural and engineered autonomous systems.","author_count":9,"contributors":["Wahby, Mostafa","Heinrich, Mary Katherine","Hofstadler, Daniel Nicolas","Petzold, Julien","Kuksin, Igor","Zahadat, Payam","Schmickl, Thomas","Ayres, Phil","Hamann, Heiko"],"cuid":["S02-100.00-012429"],"filters":{"added":"2023-01","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD"],"country":["Austria","Germany"],"glorg":["All Global Affiliations","CYBERTRONICA UG (HAFTUNGSBESCHRANKT) GMBH","Cybertronica UG (Haftungsbeschrankt)","University of Graz","University of Lübeck"],"keyword":["Adaptive Construction","Bio hybid","Bio hybrid","Biotechnology","Distributed control","Engineering","Issue 149","Phototropism","Self organisation","Self organization"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-ART","DI-U"],"level3":{"ART":["DI-ART-ALL","DI-ART-RDKA"],"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-ART-RDKA","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"robotic sensing and stimuli provision for guided plant growth","src":["arkc","itu"],"src-code":["DI-ART-RDKA","DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.3791/59835","version":"Published Version"},"id":"S02-100.00-012429","identifier":[{"id":"85069847559","type":"scopus"}],"ids":["arkc-8903f421-03ea-4a4a-a077-ba997dc16a04","itu-249a3e08-057c-40a0-81df-e3250af84425"],"keyword":["Adaptive construction","Bio-hybid","Bio-technology","Distributed control","Engineering","Issue 149","No","Phototropism","Self-organisation","bio-hybrid","self-organization"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-5-1805A33DFAFED6128B372CA89D68332B"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://pure.itu.dk/ws/files/84833975/jove_protocol_59835_robotic_sensing_and_stimuli_provision_for_guided_plant_growth.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"rem","url":"https://www.researchgate.net/publication/333917459","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.3791/59835","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","country":"de","key":"university of lübeck","loc":["Germany","Europe, EU","OECD"],"name":"University of Lübeck","used":1},{"affno":"2","key":"royal danish academy architecture design conservation","l2":"DI-ART","l2n":"Artistic Higher Education Institutions","l3":"DI-ART-RDKA","l3nn":"Royal Danish Academy - Architecture, Design, Conservation","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Royal Danish Academy - Architecture, Design, Conservation","namevar":["Royal Danish Academy - Architecture, Design, Conservation, Royal Danish Academy - Architecture, Institute of Architecture and Technology, CITA - Centre for Information Technology and Architecture"],"nora_code":"DI-ART-RDKA","used":1},{"affno":"3","country":"at","key":"university of graz","loc":["Austria","Europe, EU","OECD"],"name":"University of Graz","used":1},{"affno":"4","country":"de","key":"cybertronica ug","loc":["Germany","Europe, EU","OECD"],"name":"Cybertronica UG (Haftungsbeschrankt)","used":1},{"affno":"5","country":"de","key":"cybertronica ug gmbh","loc":["Germany","Europe, EU","OECD"],"name":"CYBERTRONICA UG (HAFTUNGSBESCHRANKT) GMBH","used":1},{"affno":"6","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Mostafa","key":"wahbypau","last":"Wahby","name":"Wahby, Mostafa","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Mary Katherine","key":"heinrichpau","last":"Heinrich","locid":"08c85002-6341-40a3-9046-b6222a08f965","name":"Heinrich, Mary Katherine","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Daniel Nicolas","key":"hofstadlerpau","last":"Hofstadler","name":"Hofstadler, Daniel Nicolas","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Julien","key":"petzoldpau","last":"Petzold","name":"Petzold, Julien","rank":4,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"first":"Igor","key":"kuksinpau","last":"Kuksin","name":"Kuksin, Igor","rank":5,"rolecode":"pau"},{"affno":"6 3","corresponding":null,"first":"Payam","key":"zahadatpau","last":"Zahadat","locid":"8785f18a-1bf3-4c63-8d8b-d3e5d516ca40","name":"Zahadat, Payam","orcid":"0000-0002-4521-7428","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Thomas","key":"schmicklpau","last":"Schmickl","name":"Schmickl, Thomas","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Phil","key":"ayrespau","last":"Ayres","locid":"809e3672-ddc8-44e7-8a1b-1c1309974305","name":"Ayres, Phil","orcid":"0000-0002-9266-065X","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Heiko","key":"hamannpau","last":"Hamann","name":"Hamann, Heiko","rank":9,"rolecode":"pau"}],"pub":{"doi":"10.3791/59835","issn":["1940087X"],"issue":"149","journal":"Journal of Visualized Experiments","publisher":"MyJoVE Corporation","publisher_org":"MYJoVE Corporation","status":"p","title":"Journal of Visualized Experiments"},"review":"Peer Reviewed","scoID":["2-s2.0-85069847559"],"search":{"DAF":["All Artistic Higher Education Institutions","All Danish Affiliations","All Universities","Artistic Higher Education Institutions","DI-ALL","DI-ART","DI-ART-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["arkc-8903f421-03ea-4a4a-a077-ba997dc16a04","itu-249a3e08-057c-40a0-81df-e3250af84425"],"src":["ITU IT University of Copenhagen","Royal Danish Academy - Architecture, Design, Conservation"],"title":"Robotic Sensing and Stimuli Provision for Guided Plant Growth","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-012429","year":"2019","yearsub":"2019"}
{"abstract":"Plant growth is a self-organized process incorporating distributed sensing, internal communication and morphology dynamics. We develop a distributed mechatronic system that autonomously interacts with natural climbing plants, steering their behaviours to grow user-defined shapes and patterns. Investigating this bio-hybrid system paves the way towards the development of living adaptive structures and grown building components. In this new application domain, challenges include sensing, actuation and the combination of engineering methods and natural plants in the experimental set-up. By triggering behavioural responses in the plants through light spectra stimuli, we use static mechatronic nodes to grow climbing plants in a user-defined pattern at a two-dimensional plane. The experiments show successful growth over periods up to eight weeks. Results of the stimuli-guided experiments are substantially different from the control experiments. Key limitations are the number of repetitions performed and the scale of the systems tested. Recommended future research would investigate the use of similar bio-hybrids to connect construction elements and grow shapes of larger size.","author_count":9,"contributors":["Wahby, Mostafa","Heinrich, Mary Katherine","Hofstadler, Daniel Nicolas","Neufeld, Ewald","Kuksin, Igor","Zahadat, Payam","Schmickl, Thomas","Ayres, Phil","Hamann, Heiko"],"cuid":["S01-000.00-126307"],"filters":{"added":"2023-01","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Austria","Germany"],"glorg":["All Global Affiliations","Cybertronica UG (Haftungsbeschrankt)","University of Graz","University of Lübeck"],"keyword":["Adaptive Construction","Bio hybrid","Biotechnology","Distributed control","Self organisation"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-ART"],"level3":{"ART":["DI-ART-ALL","DI-ART-RDKA"]},"level3all":["DI-ART-RDKA"]},"review":"pr","rtype":["clu"],"sorti":"autonomously shaping natural climbing plants a bio hybrid approach","src":["arkc"],"src-code":["DI-ART-RDKA"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1098/rsos.180296","version":"Published Version"},"id":"S01-000.00-126307","identifier":[{"id":"85056747110","type":"scopus"}],"ids":["arkc-2572cba1-5469-40a7-9ff9-516ab26aa809"],"keyword":["Adaptive Construction","Bio-hybrid","Biotechnology","Distributed Control","Natural Plants","No","Self-organisation"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-4-F14E04117FC39E746CAC0CBD6FE1D331"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1098/rsos.180296","version":"Published Version"}],"org":[{"affno":"1","country":"de","key":"university of lübeck","loc":["Germany","Europe, EU","OECD"],"name":"University of Lübeck","used":1},{"affno":"2","country":"at","key":"university of graz","loc":["Austria","Europe, EU","OECD"],"name":"University of Graz","used":1},{"affno":"3","country":"de","key":"cybertronica ug","loc":["Germany","Europe, EU","OECD"],"name":"Cybertronica UG (Haftungsbeschrankt)","used":1},{"affno":"4","key":"royal danish academy architecture design conservation","l2":"DI-ART","l2n":"Artistic Higher Education Institutions","l3":"DI-ART-RDKA","l3nn":"Royal Danish Academy - Architecture, Design, Conservation","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Royal Danish Academy - Architecture, Design, Conservation","namevar":["Royal Danish Academy - Architecture, Design, Conservation, Royal Danish Academy - Architecture, Institute of Architecture and Technology","Royal Danish Academy - Architecture, Design, Conservation, Royal Danish Academy - Architecture, Institute of Architecture and Technology, CITA - Centre for Information Technology and Architecture","The Royal Danish Academy of Fine Arts, Schools of Architecture, Design and Conservation"],"nora_code":"DI-ART-RDKA","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Mostafa","key":"wahbypau","last":"Wahby","name":"Wahby, Mostafa","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Mary Katherine","key":"heinrichpau","last":"Heinrich","locid":"08c85002-6341-40a3-9046-b6222a08f965","name":"Heinrich, Mary Katherine","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Daniel Nicolas","key":"hofstadlerpau","last":"Hofstadler","name":"Hofstadler, Daniel Nicolas","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ewald","key":"neufeldpau","last":"Neufeld","name":"Neufeld, Ewald","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Igor","key":"kuksinpau","last":"Kuksin","name":"Kuksin, Igor","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Payam","key":"zahadatpau","last":"Zahadat","name":"Zahadat, Payam","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Thomas","key":"schmicklpau","last":"Schmickl","name":"Schmickl, Thomas","rank":7,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Phil","key":"ayrespau","last":"Ayres","locid":"809e3672-ddc8-44e7-8a1b-1c1309974305","name":"Ayres, Phil","orcid":"0000-0002-9266-065X","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Heiko","key":"hamannpau","last":"Hamann","name":"Hamann, Heiko","rank":9,"rolecode":"pau"}],"pub":{"doi":"10.1098/rsos.180296","issn":["20545703"],"issue":"10","journal":"Royal Society Open Science","paperid":"180296","status":"p","title":"Royal Society Open Science","volume":"5"},"review":"Peer Reviewed","scoID":["2-s2.0-85056747110"],"search":{"DAF":["All Artistic Higher Education Institutions","All Danish Affiliations","Artistic Higher Education Institutions","DI-ALL","DI-ART","DI-ART-ALL"],"PST":["Published"]},"sid":["arkc-2572cba1-5469-40a7-9ff9-516ab26aa809"],"src":["Royal Danish Academy - Architecture, Design, Conservation"],"title":"Autonomously shaping natural climbing plants : a bio-hybrid approach","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-126307","year":"2018","yearsub":"2018"}
{"abstract":"Natural plants are exemplars of adaptation through self-organisation and collective decision making. As such, they provide a rich source of inspiration for adaptive mechanisms in artificial systems. Plant growth-a structure development mechanism of continuous material accumulation that expresses encoded morphological features through environmental interactions-has been extensively explored in-silico. However, ex-silico scalable morphological adaptation through material accumulation remains an open challenge. In this paper, we present a novel type of biologically inspired modularity, and an approach to artificial growth that combines the benefits of material continuity through braiding with a distributed and decentralised plant-inspired Vascular Morphogenesis Controller (VMC). The controller runs on nodes that are capable of sensing and communicating with their neighbours. The nodes are embedded within the braided structure, which can be morphologically adapted based on collective decision making between nodes. Human agents realise the material adaptation by physically adding to the braided structure according to the suggestion of the embedded controller. This work offers a novel, tangible and accessible approach to embedding mechanisms of artificial growth and morphological adaptation within physically embodied systems, offering radically new functionalities, innovation potentials and approaches to continuous autonomous or steered design that could find application within fields contributing to the built environment, such as Architecture.","author_count":7,"contributors":["Hofstadler, Daniel Nicolas","Varughese, Joshua Cherian","Nielsen, Stig Anton","Leon, David Andres","Ayres, Phil","Zahadat, Payam","Schmickl, Thomas"],"cuid":["S01-000.00-127042"],"filters":{"added":"2023-01","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Austria"],"glorg":["All Global Affiliations","University of Graz"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-ART","DI-U"],"level3":{"ART":["DI-ART-ALL","DI-ART-RDKA"],"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-ART-RDKA","DI-U-ITU"]},"review":"nr","rtype":["clu"],"sorti":"artificial plants vascular morphogenesis controller guided growth of braided structures","src":["arkc"],"src-code":["DI-ART-RDKA"],"type":"dw","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://adk.elsevierpure.com/ws/files/62447352/Hofstadler_et_al_ArtificialPlants_arXiv_2018.pdf","version":"Published Version"},"id":"S01-000.00-127042","ids":["arkc-6796856c-6b04-4a04-915a-a1503b389de9"],"keyword":["No"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-204BEDE1B221BE7125257612D0231D6A"],"oa_link":[{"access":"oa","type":"loc","url":"https://adk.elsevierpure.com/ws/files/62447352/Hofstadler_et_al_ArtificialPlants_arXiv_2018.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"at","key":"university of graz","loc":["Austria","Europe, EU","OECD"],"name":"University of Graz","used":1},{"affno":"2","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1},{"affno":"3","key":"royal danish academy architecture design conservation","l2":"DI-ART","l2n":"Artistic Higher Education Institutions","l3":"DI-ART-RDKA","l3nn":"Royal Danish Academy - Architecture, Design, Conservation","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Royal Danish Academy - Architecture, Design, Conservation","namevar":["Royal Danish Academy - Architecture, Design, Conservation, Royal Danish Academy - Architecture, Institute of Architecture and Technology","Royal Danish Academy - Architecture, Design, Conservation, Royal Danish Academy - Architecture, Institute of Architecture and Technology, CITA - Centre for Information Technology and Architecture","The Royal Danish Academy of Fine Arts, Schools of Architecture, Design and Conservation"],"nora_code":"DI-ART-RDKA","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Daniel Nicolas","key":"hofstadlerpau","last":"Hofstadler","name":"Hofstadler, Daniel Nicolas","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Joshua Cherian","key":"varughesepau","last":"Varughese","name":"Varughese, Joshua Cherian","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Stig Anton","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Stig Anton","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"David Andres","key":"leonpau","last":"Leon","name":"Leon, David Andres","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Phil","key":"ayrespau","last":"Ayres","locid":"809e3672-ddc8-44e7-8a1b-1c1309974305","name":"Ayres, Phil","orcid":"0000-0002-9266-065X","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Payam","key":"zahadatpau","last":"Zahadat","name":"Zahadat, Payam","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thomas","key":"schmicklpau","last":"Schmickl","name":"Schmickl, Thomas","rank":7,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["All Artistic Higher Education Institutions","All Danish Affiliations","All Universities","Artistic Higher Education Institutions","DI-ALL","DI-ART","DI-ART-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["arkc-6796856c-6b04-4a04-915a-a1503b389de9"],"src":["Royal Danish Academy - Architecture, Design, Conservation"],"title":"Artificial Plants : Vascular Morphogenesis Controller-guided growth of braided structures","type":"Working Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-127042","year":"2018","yearsub":"2018"}
{"abstract":"Bio-hybrid systems---close couplings of natural organisms with technology---are high potential and still underexplored. In existing work, robots have mostly influenced group behaviors of animals. We explore the possibilities of mixing robots with natural plants, merging useful attributes. Significant synergies arise by combining the plants' ability to efficiently produce shaped material and the robots' ability to extend sensing and decision-making behaviors. However, programming robots to control plant motion and shape requires good knowledge of complex plant behaviors. Therefore, we use machine learning to create a holistic plant model and evolve robot controllers. As a benchmark task we choose obstacle avoidance. We use computer vision to construct a model of plant stem stiffening and motion dynamics by training an LSTM network. The LSTM network acts as a forward model predicting change in the plant, driving the evolution of neural network robot controllers. The evolved controllers augment the plants' natural light-finding and tissue-stiffening behaviors to avoid obstacles and grow desired shapes. We successfully verify the robot controllers and bio-hybrid behavior in reality, with a physical setup and actual plants.","author_count":8,"contributors":["Wahby, Mostafa","Heinrich, Mary Katherine","Hofstadler, Daniel Nicolas","Risi, Sebastian","Zahadat, Payam","Schmickl, Thomas","Ayres, Phil","Hamann, Heiko"],"cuid":["S01-000.00-128626"],"filters":{"added":"2023-01","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Austria","Germany"],"glorg":["All Global Affiliations","University of Graz","University of Lübeck"],"keyword":["Bio hybrid systems","Machine learning","Plant Model"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-ART","DI-U"],"level3":{"ART":["DI-ART-ALL","DI-ART-RDKA"],"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-ART-RDKA","DI-U-ITU"]},"review":"nr","rtype":["clu"],"sorti":"a robot to shape your natural plant the machine learning approach to model and control bio hybrid systems","src":["arkc"],"src-code":["DI-ART-RDKA"],"type":"dw","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://adk.elsevierpure.com/ws/files/62447386/Wahby_et_al_A_Robot_To_Shape_Your_Natural_Plant_arXiv_2018.pdf","version":"Published Version"},"id":"S01-000.00-128626","identifier":[{"id":"85050634013","type":"scopus"}],"ids":["arkc-eceb4dd5-1e91-420c-8147-e4174552364f"],"keyword":["Bio-hybrid Systems","Evolved Robotic Controllers","LSTM Network","Machine Learning","No","Plant Model"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-E95B4A7B07342C940B98D5B35B6BC2BA"],"oa_link":[{"access":"oa","type":"loc","url":"https://adk.elsevierpure.com/ws/files/62447386/Wahby_et_al_A_Robot_To_Shape_Your_Natural_Plant_arXiv_2018.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"de","key":"university of lübeck","loc":["Germany","Europe, EU","OECD"],"name":"University of Lübeck","used":1},{"affno":"2","country":"at","key":"university of graz","loc":["Austria","Europe, EU","OECD"],"name":"University of Graz","used":1},{"affno":"3","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT Universitetet, Games & Culture","IT University of Copenhagen, Center for Computer Games Research","IT University, Robotics, Evolution, and Art Lab"],"nora_code":"DI-U-ITU","used":1},{"affno":"4","key":"royal danish academy architecture design conservation","l2":"DI-ART","l2n":"Artistic Higher Education Institutions","l3":"DI-ART-RDKA","l3nn":"Royal Danish Academy - Architecture, Design, Conservation","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Royal Danish Academy - Architecture, Design, Conservation","namevar":["Royal Danish Academy - Architecture, Design, Conservation, Royal Danish Academy - Architecture, Institute of Architecture and Technology","Royal Danish Academy - Architecture, Design, Conservation, Royal Danish Academy - Architecture, Institute of Architecture and Technology, CITA - Centre for Information Technology and Architecture","The Royal Danish Academy of Fine Arts, Schools of Architecture, Design and Conservation"],"nora_code":"DI-ART-RDKA","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Mostafa","key":"wahbypau","last":"Wahby","name":"Wahby, Mostafa","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Mary Katherine","key":"heinrichpau","last":"Heinrich","locid":"08c85002-6341-40a3-9046-b6222a08f965","name":"Heinrich, Mary Katherine","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Daniel Nicolas","key":"hofstadlerpau","last":"Hofstadler","name":"Hofstadler, Daniel Nicolas","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Sebastian","key":"risipau","last":"Risi","name":"Risi, Sebastian","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Payam","key":"zahadatpau","last":"Zahadat","name":"Zahadat, Payam","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Thomas","key":"schmicklpau","last":"Schmickl","name":"Schmickl, Thomas","rank":6,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Phil","key":"ayrespau","last":"Ayres","locid":"809e3672-ddc8-44e7-8a1b-1c1309974305","name":"Ayres, Phil","orcid":"0000-0002-9266-065X","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Heiko","key":"hamannpau","last":"Hamann","name":"Hamann, Heiko","rank":8,"rolecode":"pau"}],"pub":{"pages":"15","status":"p"},"review":"No Review","search":{"DAF":["All Artistic Higher Education Institutions","All Danish Affiliations","All Universities","Artistic Higher Education Institutions","DI-ALL","DI-ART","DI-ART-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["arkc-eceb4dd5-1e91-420c-8147-e4174552364f"],"src":["Royal Danish Academy - Architecture, Design, Conservation"],"title":"A Robot to Shape your Natural Plant : The Machine Learning Approach to Model and Control Bio-Hybrid Systems","type":"Working Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-128626","year":"2018","yearsub":"2018"}
{"abstract":"Self-organizing construction is an emerging subdomain for on-site construction robots. This not only presents new challenges for robotics, but due to the stochasticity involved in such systems, impacts the modeling and prediction of resulting built structures. Self-organizing models have been explored by architects for generative design and for optimization, but so far have infrequently been studied in the context of construction. Here we present a strategy for architects to design with non-deterministic self-organizing behaviors, using interactive evolution to incorporate user judgment. We introduce our “Integrated Growth Projection” method, having implemented it into a software pipeline for early phase design. We test the software with an initial user group of architects, to see whether the method and pipeline helps them design a non-deterministic self-organizing behavior. The user group creates several hybrid controllers that reliably solve their chosen design tasks.","author_count":26,"contributors":["Heinrich, Mary Katherine","Zahadat, Payam","Harding, John","Brandt, Mads Nikolaj","Buchwald, Emil Fabritius","Castaman, Leonardo","Chan, Kit Wai","Harrig, Malte","Holte, Stian Vestly","Kieffer, Lynn","Jørgensen, Jens Lee","Liang, Chao-Yuan","Skjæveland, Erik Lima","Michaelsen, Sofie Lund","Millentrup, Viktoria","Petersen, Suna","Petrov, Martin","Pontello, Enrico","Puller, Fabian","Rossi, Gabriella","Skalle, Johanne Marie","Stylianou, Sofia","Svendsen, Alma Bangsgaard","Walker, James","Nicholas, Paul","Ayres, Phil"],"cuid":["S01-000.00-128144"],"event":{"end":"2018-06-07","place":"Delft, nl","start":"2018-06-05","title":"Symposium on Simulation for Architecture &amp; Urban Design 2018","year":"2018"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","OECD"],"country":["Austria","United Kingdom"],"glorg":["All Global Affiliations","University of Graz","University of Reading"],"keyword":["Artificial Growth","Artificial selection","Interactive Evolution","Self organisation"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-ART"],"level3":{"ART":["DI-ART-ALL","DI-ART-RDKA"]},"level3all":["DI-ART-RDKA"]},"review":"pr","rtype":["clu"],"sorti":"using interactive evolution to design behaviors for non deterministic self organized construction","src":["arkc"],"src-code":["DI-ART-RDKA"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://adk.elsevierpure.com/ws/files/62465918/SimAUD2018_Using_Interactive_Evolution_To_Design_Behaviours.pdf","version":"Published Version"},"id":"S01-000.00-128144","identifier":[{"id":"85056661104","type":"scopus"}],"ids":["arkc-c50245a1-fefb-48ae-9795-80379595fa38"],"keyword":["Artificial Growth","Artificial Selection","Interactive Evolution","No","Self-organisation","Swarm Construction"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-FD0D811CB113848812845C22F320AFCA"],"oa_link":[{"access":"oa","type":"loc","url":"https://adk.elsevierpure.com/ws/files/62465918/SimAUD2018_Using_Interactive_Evolution_To_Design_Behaviours.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"royal danish academy architecture design conservation","l2":"DI-ART","l2n":"Artistic Higher Education Institutions","l3":"DI-ART-RDKA","l3nn":"Royal Danish Academy - Architecture, Design, Conservation","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Royal Danish Academy - Architecture, Design, Conservation","namevar":["Royal Danish Academy - Architecture, Design, Conservation, Royal Danish Academy - Architecture, Institute of Architecture and Technology","Royal Danish Academy - Architecture, Design, Conservation, Royal Danish Academy - Architecture, Institute of Architecture and Technology, CITA - Centre for Information Technology and Architecture","The Royal Danish Academy of Fin