rolecode":"pau"},{"affno":"","corresponding":null,"first":"Phil","key":"ayersphilpau","last":"Ayers","name":"Ayers, Phil","rank":13,"rolecode":"pau"}],"pub":{"doi":"10.1109/ssci.2015.158","isbn":["9781479975600"],"pages":"1102-1109","publisher":"IEEE","status":"p","title":"Computational Intelligence, 2015 IEEE Symposium Series on"},"review":"Peer Reviewed","scoID":["2-s2.0-84964937762"],"search":{"DAF":["All Artistic Higher Education Institutions","All Danish Affiliations","All Universities","Artistic Higher Education Institutions","DI-ALL","DI-ART","DI-ART-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["arkc-8a5ce1d1-e2e0-4c7d-9e51-2001d8744f9a","itu-4181dddd-1be3-4361-8109-ca1419e73d88"],"src":["ITU IT University of Copenhagen","Royal Danish Academy - Architecture, Design, Conservation"],"title":"Flora Robotica – Mixed Societies of Symbiotic Robot-Plant Bio-Hybrids","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-089.67-012432","year":"2015","yearsub":"2015"}
{"abstract":"In this paper we study fractal gene regulatory network (FGRN) controllers based on sensory information. The FGRN controllers are evolved to control a snake robot consisting of seven simulated ATRON modules. Each module contains three tilt sensors which represent the direction of gravity in the coordination system of the module. The modules are controlled locally and there is no explicit communication between them. So, they can synchronize implicitly using their sensors, and coordination of their behavior takes place through the environment. In one of our experiments, all the three tilt sensors are available for the FGRNs and a simple controller is evolved. The controller is a linear mapping of one input sensor to the output. It is only based on one sensor input and ignores the other sensors as well as the regulatory part of the network. In another experiment, the controller's input uses one of the other sensors that carries less information. In this case, the evolved controller blends sensory information with the regulatory network capabilities to come up with a proper distributed controller. © 2013 Springer-Verlag.","author_count":4,"contributors":["Zahadat, Payam","Christensen, David Johan","Katebi, Serajeddin","Stoy, Kasper"],"cuid":["S01-000.00-337627"],"event":{"end":"2010-11-03","place":"Lausanne, ch","start":"2010-11-01","title":"10th International Symposium on Distributed Autonomous Robotic Systems (DARS 2010)","year":"2010"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Asia, Middle East"],"country":["Iran"],"glorg":["All Global Affiliations","Shiraz University"],"keyword":["Controllers","Experiments","Fractals","GENES","Sensors"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-SDU"]},"level3all":["DI-U-DTU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"sensor coupled fractal gene regulatory networks for locomotion control of a modular snake robot","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-3-642-32723-0_37","version":"Other Version"},"id":"S01-000.00-337627","identifier":[{"id":"84870758144","type":"scopus"}],"ids":["dtu-6eb477d7-f11d-4a34-9764-e76d539f93ba"],"keyword":["Controllers","Experiments","Fractals","Genes","Sensors"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-CA47A7BDA18193084324F326A3F40F88"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-3-642-32723-0_37","version":"Other Version"}],"org":[{"affno":"1","country":"dk","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["University of Southern Denmark"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Centers, Centre for Playware","Technical University of Denmark, Department of Electrical Engineering","Technical University of Denmark, Department of Electrical Engineering, Automation and Control"],"nora_code":"DI-U-DTU","used":1},{"affno":"3","country":"ir","key":"shiraz university","loc":["Iran","Asia, Middle East"],"name":"Shiraz University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Payam","key":"zahadatpau","last":"Zahadat","name":"Zahadat, Payam","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"David Johan","key":"christensenpau","last":"Christensen","locid":"a721954c-7276-4e0c-a025-82fd7496b5ab","name":"Christensen, David Johan","orcid":"0000-0002-4358-4371","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Serajeddin","key":"katebipau","last":"Katebi","name":"Katebi, Serajeddin","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kasper","key":"stoypau","last":"Stoy","name":"Stoy, Kasper","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-642-32723-0_37","eisbn":["9783642327230"],"isbn":["9783642327223"],"issn":["16107438"],"issue":"83","pages":"517-530","publisher":"Springer Verlag","series":"Springer Tracts in Advanced Robotics","status":"p","title":"Distributed Autonomous Robotic Systems. The 10th International Symposium"},"review":"Peer Reviewed","scoID":["2-s2.0-84870758144"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["dtu-6eb477d7-f11d-4a34-9764-e76d539f93ba"],"src":["DTU Technical University of Denmark"],"title":"Sensor-coupled fractal gene regulatory networks for locomotion control of a modular snake robot","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-337627","year":"2013","yearsub":"2013"}
