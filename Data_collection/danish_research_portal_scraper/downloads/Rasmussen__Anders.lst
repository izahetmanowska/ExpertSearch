{"author_count":3,"contributors":["Rasmussen, Anders Juhl"],"cuid":["S01-000.00-617519"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"diætens patos peter seebergs epikuræisme","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-617519","ids":["sdu-9ac02d8f-2bb9-4051-b7c6-2061aa166800"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-9E53D125930AFDC0DE17BA9B74CD2CE5"],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Humanities, Department for the Study of Culture","SDU, Faculty of Humanities, Department of Culture and Language, Cultural Studies","SDU, Faculty of Humanities, Department of Culture and Language, Uses of Literature"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anders Juhl","key":"rasmussenpau","last":"Rasmussen","locid":"6612df8e-d9f9-4004-b959-a9c30b0762a5","name":"Rasmussen, Anders Juhl","orcid":"0000-0001-7718-5208","rank":1,"rolecode":"pau"},{"affno":"","first":"Anders","key":"ehlersdampedh","last":"Ehlers Dam","name":"Ehlers Dam, Anders","rank":2,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Marianne","key":"stidsenpedh","last":"Stidsen","name":"Stidsen, Marianne","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9788793060623"],"pages":"221-234","publisher":"U Press","status":"p","title":"Distancens patos"},"review":"Peer Reviewed","search