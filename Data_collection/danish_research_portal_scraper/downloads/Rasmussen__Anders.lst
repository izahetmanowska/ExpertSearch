en","orcid":"0000-0003-2190-145X","rank":11,"rolecode":"pau"}],"pmid":["38272985"],"pub":{"doi":"10.1111/aas.14379","issn":["00015172"],"issue":"4","journal":"Acta Anaesthesiologica Scandinavica","pages":"575-578","publisher":"Blackwell Munksgaard","status":"p","title":"Acta Anaesthesiologica Scandinavica","volume":"68"},"review":"Peer Reviewed","scoID":["2-s2.0-85183606162"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-e2655c62-4165-46f3-a75a-88177acbde81","ku-99d2768d-1349-49b9-b31a-8b8177eddf6c","sdu-3feab66c-250d-4afd-89f5-113e1f1ed2a2"],"src":["AAU Aalborg University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Long-term cognitive and pulmonary functions following a lower versus a higher oxygenation target in the HOT-ICU and HOT-COVID trials: A protocol update","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-093.29-735042","year":"2024","yearsub":"2024"}
{"abstract":"Nontuberculous mycobacteria (NTM) are emerging as notable causative agents of opportunistic infections. To examine clinical significance, species distribution, and temporal trends of NTM in Denmark, we performed a nationwide register-based study of all unique persons with NTM isolated in the country during 1991–2022. We categorized patients as having definite disease, possible disease, or isolation by using a previously validated method. The incidence of pulmonary NTM increased throughout the study period, in contrast to earlier findings. Mycobacterium malmoense, M. kansasii, M. szulgai, and M. avium complex were the most clinically significant species based on microbiologic findings; M. avium dominated in incidence. This study shows the need for surveillance for an emerging infection that is not notifiable in most countries, provides evidence to support clinical decision-making, and highlights the importance of not considering NTM as a single entity.","author_count":8,"contributors":["Dahl, Victor Naestholt","Pedersen, Andreas Arnholdt","Norman, Anders","Rasmussen, E. Michael","van Ingen, Jakko","Andersen, Aase Bengaard","Wejse, Christian","Lillebaek, Troels"],"cuid":["S03-094.12-767600"],"filters":{"added":"2024-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"continent":["Europe, EU","OECD"],"corresponding_author":["Dahl, Victor Naestholt"],"country":["Netherlands"],"glorg":["All Global Affiliations","Radboud University Medical Center","Radboud University Nijmegen"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-HO-SDR","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"clinical significance species distribution and tempora