code":"pau"},{"affno":"1","first":"Klaus","key":"bønnelykkeklauspau","last":"Bønnelykke","locid":"c36b6936-2cc4-41b1-b7c5-a97978afe417","name":"Bønnelykke, Klaus","rank":19,"rolecode":"pau"}],"pmid":["28029926"],"pub":{"doi":"10.1056/nejmoa1503734","issn":["00284793","15334406"],"issn_org":["00284793"],"issue":"26","journal":"The New England Journal of Medicine","pages":"2530-2539","publisher":"Massachussetts Medical Society","status":"p","title":"The New England Journal of Medicine","title_org":"New England Journal of Medicine","volume":"375"},"review":"Peer Reviewed","scoID":["2-s2.0-85007378118"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Region Zealand","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-b01f6b9d-43ae-4e1c-aaa7-c12fb3aaef79","ku-2f072a4f-57b7-4437-9991-813b1795c7ae"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Fish Oil-Derived Fatty Acids in Pregnancy and Wheeze and Asthma in Offspring","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.27-036583","year":"2016","yearsub":"2016"}
{"abstract":"Background. Belinostat is a novel histone deacetylase inhibitor. Primary Objectives. Maximum tolerated dose (MTD) and dose limiting toxicities (DLTs) of belinostat (Bel) in combination with doxorubicin (Dox) in solid tumours (phase I) and response rate (RR) in soft tissue sarcomas (phase II). Methods. Bel was administered as a 30-minute IV infusion on days 1-5 and on day 5 with Dox. The dose escalation schedule was as follows: cohort 1: Bel 600 mg/m(2) and 50 mg/m(2) Dox, cohort 2: Bel 600 mg/m(2) and 75 mg/m(2) Dox, cohort 3: Bel 800 mg/m(2) and 75 mg/m(2) Dox, and cohort 4: Bel 1000 mg/m(2) and 75 mg/m(2) Dox. Results. 41 patients were included (25 in phase I, 16 in phase II). Adverse events were fatigue (95%), nausea (76%), and alopecia (63%). There was one DLT, grade 3 rash/hand and foot syndrome. MTD was Bel 1000 mg/m(2)/d and Dox 75 mg/m(2). Four responses were seen: 2 PR in phase I, RR of 8%; in phase II, 1 PR/1 CR, RR of 13%, and 9 patients (56%) with SD. Conclusion. The combination was well tolerated. Response rate was moderate but median time to progression was 6.0 months (95% CI, 1.6-9.7 months) which is superior to some reports of single-agent Dox.","author_count":8,"contributors":["Vitfell-Rasmussen, Joanna","Judson, Ian","Safwat, Akmal","Jones, Robin L","Rossen, Philip Blach","Lind-Hansen, Maja","Knoblauch, Poul","Krarup-Hansen, Anders"],"cuid":["S02-100.00-022573"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","Institute of Cancer Research"],"keyword":["Journal Article"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"a phase i ii clinical trial of belinostat pxd000000000101 in combination with doxorubicin in patients with soft tissue sarcomas","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1155/2016/2090271","version":"Published Version"},"id":"S02-100.00-022573","identifier":[{"id":"84976523724","type":"scopus"},{"id":"PMC4923583","type":"pmcid"},{"id":"27403082","type":"pmid"}],"ids":["au-87eca277-2c84-4487-8918-38123280bfdf","ku-75030c7c-d3bd-4b03-bcf4-58559805b1a0"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-6048B02429DC9A5086093400DC55426D"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1155/2016/2090271","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/179888617/2090271.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","country":"gb","key":"institute of cancer research","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Institute of Cancer Research","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Oncology"],"nora_code":"DI-U-AU","used":1},{"affno":"3","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1},{"affno":"4","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"5","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Capitol Region of Denmark"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"","first":"Joanna","key":"vitfellrasmussenpau","last":"Vitfell-Rasmussen","name":"Vitfell-Rasmussen, Joanna","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ian","key":"judsonpau","last":"Judson","name":"Judson, Ian","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Akmal","key":"safwatpau","last":"Safwat","locid":"8d664922-6cc3-4d2a-a032-44cdfc5febb3","name":"Safwat, Akmal","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Robin L","key":"jonespau","last":"Jones","name":"Jones, Robin L","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Philip Blach","key":"rossenpau","last":"Rossen","locid":"ff9a31f8-f56b-4359-b95e-84d0d8b1e5a9","name":"Rossen, Philip Blach","rank":5,"rolecode":"pau"},{"affno":"","first":"Maja","key":"lindhansenpau","last":"Lind-Hansen","name":"Lind-Hansen, Maja","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Poul","key":"knoblauchpau","last":"Knoblauch","name":"Knoblauch, Poul","rank":7,"rolecode":"pau"},{"affno":"4 5","first":"Anders","key":"kraruphansenpau","last":"Krarup-Hansen","locid":"5fb06b4f-2517-4150-923a-06d5cde8fc83","name":"Krarup-Hansen, Anders","rank":8,"rolecode":"pau"}],"pmid":["27403082"],"pub":{"doi":"10.1155/2016/2090271","issn":["1357714X","13691643"],"issn_org":["1357714X"],"journal":"Sarcoma","paperid":"2090271","publisher":"John Wiley and Sons Ltd","status":"p","title":"Sarcoma","volume":"2016"},"review":"Peer Reviewed","scoID":["2-s2.0-84976523724"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-87eca277-2c84-4487-8918-38123280bfdf","ku-75030c7c-d3bd-4b03-bcf4-58559805b1a0"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"A Phase I/II Clinical Trial of Belinostat (PXD101) in Combination with Doxorubicin in Patients with Soft Tissue Sarcomas","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-022573","year":"2016","yearsub":"2016"}
{"abstract":"BACKGROUND: Cycling is a recreational activity and mode of commuting with substantial potential to improve public health in many countries around the world. The aim of this study was to examine prospective associations between recreational and commuter cycling, changes in cycling habits, and risk of type 2 diabetes (T2D) in Danish adults from the Diet, Cancer and Health cohort study. METHODS AND FINDINGS: At baseline from 1993 to 1997, 24,623 men and 27,890 women from Denmark, 50-65 y of age and free of T2D and other chronic diseases, underwent a number of assessments, including completing a lifestyle questionnaire also addressing cycling habits. Approximately 5 y later, at a second examination, participants completed a new, updated lifestyle questionnaire. Cox regression was used to estimate hazard ratios (HRs) of incident T2D registered in the Danish National Diabetes Registry, according to recreational and commuter cycling and changes in cycling habits, with adjustment for a priori known T2D risk factors. During 743,245.4 person-years of follow-up (mean follow-up 14.2 y), 6,779 incident cases of T2D were documented. Multivariable adjusted HRs (95% confidence interval [CI]) were 1, 0.87 (0.82, 0.93), 0.83 (0.77, 0.89), 0.80 (0.74, 0.86) and 0.80 (0.74, 0.87) (p for trend = <0.001) for 0, 1-60, 61-150, 151-300, and >300 min/wk of total cycling (recreational and commuter cycling), respectively. In analysis of seasonal cycling, multivariable adjusted HRs (95% CI) were 1, 0.88 (0.83, 0.94), and 0.80 (0.76, 0.85) for non-cyclists, seasonal cyclists (those cycling only in summer or winter), and those cycling during both summer and winter, respectively. How changes in total cycling from baseline to the second examination affected risk was also investigated, and multivariable adjusted HRs (95% CI) were 1, 0.88 (0.78, 1.01), 0.80 (0.69, 0.91), and 0.71 (0.65, 0.77) for non-cyclists and for those who ceased, initiated, or continued cycling between baseline and the second examination, respectively. Lastly, in the analysis of commuter cycling, multivariable HRs (95% CI) were 1, 0.72 (0.60, 0.87), 0.83 (0.69, 1.00), and 0.70 (0.57, 0.85) (p for trend = <0.001) for cycling 0, 1-60, 61-150, and >150 min/wk to work, respectively. The main limitation of the current study is the use of self-reported physical activity. CONCLUSIONS: Commuter and recreational cycling was consistently associated with lower risk of T2D in Danish adults. Our results also provide evidence that late-in-life initiation of or continued engagement in cycling lowers risk of T2D.","author_count":7,"contributors":["Rasmussen, Martin G","Grøntved, Anders","Blond, Kim","Overvad, Kim","Tjønneland, Anne","Jensen, Majken K","Østergaard, Lars"],"cuid":["S03-090.74-010702"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"keyword":["Journal Article"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-NDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-NDR","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"associations between recreational and commuter cycling changes in cycling and type 000000000002 diabetes risk a cohort study of danish men and women","src":["aau","au","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1371/journal.pmed.1002076","version":"Published Version"},"id":"S03-090.74-010702","identifier":[{"id":"84980332348","type":"scopus"},{"id":"PMC4942105","type":"pmcid"},{"id":"27403867","type":"pmid"},{"id":"000383354300006","type":"wos"}],"ids":["aau-e02ad517-bc6d-4916-a231-afb99bea5eda","au-41002c2e-c4e7-4bbf-a289-86dd12f4993e","sdu-fbbabe19-4453-48cd-9c7a-df1395a3176e"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-65CE9BDF5EA4A26E943FACA118F0732B"],"oa_link":[{"access":"oa","license":"CC BY-SA","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/120749374/asset.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1371/journal.pmed.1002076","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics, RICH - Research In Childhood Health","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics, Research Unit of Exercise Epidemiology"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Hjertemedicin (Kardiologi) [Klinik Hjerte-Lunge]","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Hjerte-Lunge"],"nora_code":"DI-U-AAU","used":1},{"affno":"3","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"