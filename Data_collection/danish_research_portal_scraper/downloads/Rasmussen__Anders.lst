Engineering, Geotechnics & Geology"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"geus geological survey of denmark and greenland","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-GEUS","l3nn":"GEUS Geological Survey of Denmark and Greenland","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"GEUS Geological Survey of Denmark and Greenland","namevar":["Geological Survey of Denmark and Greenland"],"nora_code":"DI-GV-GEUS","used":1}],"person":[{"affno":"1","corresponding":null,"first":"E.","key":"proestakispau","last":"Proestakis","locid":"c504c59f-f12c-4e48-b3d0-e11dfa573b2e","name":"Proestakis, Ermis","name_org":"Proestakis, E.","orcid":"0000-0002-3445-5092","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"M. A. J. G.","key":"thomaspau","last":"Thomas","locid":"d4a72276-99a5-4f66-8c7a-6c71a6ed282a","name":"Thomas, Marcus Anders Jonathan Gordon","name_org":"Thomas, M. A. J. G.","orcid":"0000-0002-6896-272X","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"R.","key":"weibelpau","last":"Weibel","name":"Weibel, R.","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"K.","key":"dybkjærpau","last":"Dybkjær","name":"Dybkjær, K.","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"M. R.","key":"hajiabadipau","last":"Hajiabadi","locid":"d26e4100-36cb-4eaa-b4bd-a952c3e7ac8c","name":"Hajiabadi, Mohammad Reza","name_org":"Hajiabadi, M. R.","orcid":"0000-0003-3602-2597","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"L. T. P.","key":"meirelespau","last":"Meireles","locid":"a6fbe493-2ddb-48cd-b6ea-c4963ef80029","name":"Meireles, Leonardo Teixeira Pinto","name_org":"Meireles, L. T. P.","orcid":"0000-0001-9857-2258","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"I. L.","key":"fabriciuspau","last":"Fabricius","locid":"b6bb8355-5060-4597-b762-b85dbc92fc15","name":"Fabricius, Ida Lykke","name_org":"Fabricius, I. L.","orcid":"0000-0002-5292-1384","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"H.","key":"nickpau","last":"Nick","locid":"f03678ef-1555-4967-b8d0-7ef95483bb77","name":"Nick, Hamid","name_org":"Nick, H.","orcid":"0000-0002-0623-6095","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"E. S.","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, E. S.","rank":9,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-de8efcad-29bd-44a5-bc58-fe078576d6b0"],"src":["DTU Technical University of Denmark"],"title":"Modelling permeability and flow in siliceous shales of Danish North Sea","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-712245","year":"2023","yearsub":"2023"}
{"abstract":"Background. Plasma (p-) activin A is elevated in chronic kidney disease–mineral and bone disorder (CKD-MBD). Activin A inhibition ameliorates CKD-MBD complications (vascular calcification and bone disease) in rodent CKD models. We examined whether p-activin A was associated with major adverse cardiovascular events (MACE), all-cause mortality and CKD-MBD complications in CKD patients. Methods. The study included 916 participants (741 patients and 175 controls) from the prospective Copenhagen CKD cohort. Comparisons of p-activin A with estimated glomerular filtration rate (eGFR), coronary and thoracic aorta Agatston scores, and bone mineral density (BMD) were evaluated by univariable linear regression using Spearman’s rank correlation, analysis of covariance and ordinal logistic regression with adjustments. Association of p-activin A with rates of MACE and all-cause mortality was evaluated by the Aalen–Johansen or Kaplan–Meier estimator, with subsequent multiple Cox regression analyses. Results. P-activin A was increased by CKD stage 3 (124–225 pg/mL, P < .001) and correlated inversely with eGFR (r = −0.53, P < 0.01). P-activin A was associated with all-cause mortality [97 events, hazard ratio 1.55 (95% confidence interval 1.04; 2.32), P < 0.05] after adjusting for age, sex, diabetes mellitus (DM) and eGFR. Median follow-up was 4.36 (interquartile range 3.64–4.75) years. The association with MACE was not significant after eGFR adjustment. Agatston scores and BMD were not associated with p-activin A.","author_count":11,"contributors":["Nordholm, Anders","Sørensen, Ida M.H.","Bjergfelt, Sasha Saurbrey","Fuchs, Andreas","Kofoed, Klaus Fuglsang","Landler, Nino E.","Biering-Sørensen, Tor","Carlson, Nicholas","Feldt-Rasmussen, Bo","Christoffersen, Christina","Bro, Susanne"],"cuid":["S01-000.00-730806"],"filters":{"added":"2024-05","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Activin A","CKD MBD","MACE","Renal osteodystrophy","Vascular Calcification"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"plasma activin a rises with declining kidney function and is independently associated with mortality in patients with chronic kidney disease","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1093/ckj/sfad238","version":"Published Version"},"id":"S01-000.00-730806","identifier":[{"id":"PMC10689128","type":"pmcid"},{"id":"85184777750","type":"scopus"},{"id":"38046005","type":"pmid"}],"ids":["ku-34e750fa-3ea3-44cd-baf6-c60932d4611e"],"keyword":["CKD-MBD","MACE","activin A","renal osteodystrophy","vascular calcification"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-EB36B9C73C8ED0E2B446EADCBBFC695A"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://curis.ku.dk/ws/files/386611195/sfad238.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1093/ckj/sfad238","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Herlev and Gentofte","Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Biomedical Sciences, Physiology of circulation, kidney and lung"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Anders","key":"nordholmpau","last":"Nordholm","name":"Nordholm, Anders","rank":1,"rolecode":"pau"},{"affno":"1","first":"Ida M.H.","key":"sørensenpau","last":"Sørensen","name":"Sørensen, Ida M.H.","rank":2,"rolecode":"pau"},{"affno":"1 2","first":"Sasha S.","key":"bjergfeltpau","last":"Bjergfelt","locid":"93674260-6689-418c-92de-b601f740f31a","name":"Bjergfelt, Sasha Saurbrey","name_org":"Bjergfelt, Sasha S.","rank":3,"rolecode":"pau"},{"affno":"1","first":"Andreas","key":"fuchspau","last":"Fuchs","name":"Fuchs, Andreas","rank":4,"rolecode":"pau"},{"affno":"1 2","first":"Klaus F.","key":"kofoedpau","last":"Kofoed","locid":"ec141562-c77f-498d-af6e-db9e08a4e895","name":"Kofoed, Klaus Fuglsang","name_org":"Kofoed, Klaus F.","rank":5,"rolecode":"pau"},{"affno":"1","first":"Nino E.","key":"landlerpau","last":"Landler","name":"Landler, Nino E.","rank":6,"rolecode":"pau"},{"affno":"1 2","first":"Tor","key":"bieringsørensenpau","last":"Biering-Sørensen","locid":"2a25298f-30d3-4b37-b20b-646684a29fd8","name":"Biering-Sørensen, Tor","rank":7,"rolecode":"pau"},{"affno":"1","first":"Nicholas","key":"carlsonpau","last":"Carlson","name":"Carlson, Nicholas","rank":8,"rolecode":"pau"},{"affno":"1 2","first":"Bo","key":"feldtrasmussenpau","last":"Feldt-Rasmussen","locid":"cdd06e7b-83c5-4118-8808-eb4591586aac","name":"Feldt-Rasmussen, Bo","rank":9,"rolecode":"pau"},{"affno":"1 2","first":"Christina","key":"christoffersenpau","last":"Christoffersen","locid":"7f6ac9b3-a8ee-401d-8c45-dc0bf731314a","name":"Christoffersen, Christina","rank":10,"rolecode":"pau"},{"affno":"1","first":"Susanne","key":"bropau","last":"Bro","name":"Bro, Susanne","rank":11,"rolecode":"pau"}],"pmid":["38046005"],"pub":{"doi":"10.1093/ckj/sfad238","issn":["20488505","20488513"],"issn_org":["20488505"],"issue":"12","journal":"Clinical Kidney Journal","pages":"2712-2720","status":"p","title":"Clinical Kidney Journal","volume":"16"},"review":"Peer Reviewed","scoID":["2-s2.0-85184777750"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-34e750fa-3ea3-44cd-baf6-c60932d4611e"],"src":["KU University of Copenhagen"],"title":"Plasma activin A rises with declining kidney function and is independently associated with mortality in patients with chronic kidney disease","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-730806","year":"2023","yearsub":"2023"}
{"abstract":"BACKGROUND: Mechanisms for how environmental chemicals might influence pain has received little attention. Epidemiological studies suggest that environmental factors such as pollutants might play a role in migraine prevalence. Potential targets for pollutants are the transient receptor potential (TRP) channels ankyrin 1 (TRPA1) and vanilloid 1 (TRPV1), which on activation release pain-inducing neuropeptide calcitonin gene-related peptide (CGRP). OBJECTIVE: In this study, we aimed to examine the hypothesis that environmental pollutants via TRP channel signaling and subsequent CGRP release trigger migraine signaling and pain. METHODS: A calcium imaging-based screen of environmental chemicals was used to investigate activation of migraine pain-associated TRP channels TRPA1 and TRPV1. Based on this screen, whole-cell patch clamp and in silico docking were performed for the pesticide pentachlorophenol (PCP) as proof of concept. Subsequently, PCP-mediated release of CGRP and vasodilatory responses of cerebral arteries were investigated. Finally, we tested whether PCP could induce a TRPA1-dependent induction of cutaneous hypersensitivity in vivo in mice as a model of migraine-like pain. RESULTS: A total of 16 out of the 52 screened environmental chemicals activated TRPA1 at 10 or formula presented . None of the investigated compounds activated TRPV1. Using PCP as a model of chemical interaction with TRPA1, in silico molecular modeling suggested that PCP is stabilized in a lipid-binding pocket of TRPA1 in comparison with TRPV1. In vitro, ex vivo, and in vivo experiments showed that PCP induced calcium influx in neurons and resulted in a TRPA1-dependent CGRP release from the brainstem and dilation of cerebral arteries. In a mouse model of migraine-like pain, PCP induced a TRPA1-dependent increased pain response (formula presented ). DISCUSSION: Here we show that multiple environmental pollutants interact with the TRPA1-CGRP migraine pain pathway. The data provide valuable insights into how environmental chemicals can interact with neurobiology and provide a potential mechanism for putative increases in migraine prevalence over the last decades. https://doi.org/10.1289/EHP12413.","author_count":12,"contributors":["Rasmussen, Rikke H.","Christensen, Sarah L.","Calloe, Kirstine","Nielsen, Brian Skriver","Rehfeld, Anders","Taylor-Clark, Thomas E.","Haanes, Kristian A.","Taboureau, Olivier","Audouze, Karine","Klaerke, Dan A.","Olesen, Jes","Kristensen, David Møbjerg"],"cuid":["S02-099.60-716418"],"filters":{"added":"2023-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","Europe, EU","OECD"],"country":["France","United States"],"glorg":["All Global Affiliations","Morsani College of Medicine","Paris-Cité University","Unité de Biologie Fonctionnelle et Adaptative (BFA)","University of Rennes","University of South Florida","Université Paris Cité"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU","DI-U-RUC"]},"level3all":["DI-HO-CAP","DI-U-KU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"xenobiotic exposure and migraine associated signaling a multimethod experimental study exploring cellular assays in combination with ex vivo and in vivo mouse models","src":["ku","ruc"],"src-code":["DI-U-KU","DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1289/EHP12413","version":"Published Version"},"id":"S02-099.60-716418","identifier":[{"id":"37909725","type":"pmid"},{"id":"PMC10619430","type":"pmcid"},{"id":"85175878443","type":"scopus"}],"ids":["ku-6585cf84-7c26-4026-842c-afaf2cf96f8a","ruc-7019ef01-09ec-4e88-9f74-5daa76969078"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-002045D7D083A68ACDA6EA661CC5D1D2"],"oa_link":[{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/388035019/Xenobiotic_Exposure_and_Migraine_Associated_Signaling.pdf","version":"Published Version"},{"access":"oa","license":"CC0","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/98403188/rasmussen-et-al-2023-xenobiotic-exposure-and-migraine-associated-signaling-a-multimethod-experimental-study-exploring.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1289/EHP12413","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary and Animal Sciences, Pathobiological Sciences"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"us","key":"morsani college of medicine","loc":["United States","America, North","OECD"],"name":"Morsani College of Medicine","used":1},{"affno":"4","country":"us","key":"university of south florida","loc":["United States","America, North","OECD"],"name":"University of South Florida","used":1},{"affno":"5","country":"fr","key":"unité de biologie fonctionnelle et adaptative","loc":["France","Europe, EU","OECD"],"name":"Unité de Biologie Fonctionnelle et Adaptative (BFA)","used":1},{"affno":"6","country":"fr","key":"paris cité university","loc":["France","Europe, EU","OECD"],"name":"Paris-Cité University","used":1},{"affno":"7","country":"fr","key":"universit