cine, Aalborg University Hospital, Klinik Hjerte-Lunge","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine, Aalborg Thrombosis Research Unit"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"gb","key":"university of birmingham","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Birmingham","used":1},{"affno":"3","country":"gb","key":"city hospital in birmingham","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"City Hospital in Birmingham","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Line","key":"melgaardpau","last":"Melgaard","locid":"88687b9c-5b56-4584-a89a-89fdeca4fd54","name":"Melgaard, Line","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders","key":"gorstrasmussenpau","last":"Gorst-Rasmussen","locid":"2aa85786-c0b1-42ec-93d4-eb7a75696409","name":"Gorst-Rasmussen, Anders","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Torben Bjerregaard","key":"larsenpau","last":"Larsen","locid":"a3c6747f-b9db-488b-8eb9-887d38742880","name":"Larsen, Torben Bjerregaard","orcid":"0000-0002-8485-8674","rank":3,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Gregory Y.H.","key":"lippau","last":"Lip","name":"Lip, Gregory Y.H.","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1002/ejhf.277","issn":["13889842","18790844"],"issn_org":["13889842"],"issue":"Suppl. 1","journal":"European Journal of Heart Failure","pages":"249","paperid":"1143","publisher":"Wiley","status":"p","title":"European Journal of Heart Failure","volume":"17"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-87bd4775-7b10-4d1f-9ceb-4ae6d6173e3a"],"src":["AAU Aalborg University"],"title":"Vascular disease as a risk factor of stroke or death in heart failure patients in sinus rhythm : A nationwide cohort study","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-089565","year":"2015","yearsub":"2015"}
{"abstract":"INTRODUCTION: The mental health prognosis following a venous thromboembolism in youth has not been investigated comprehensively. Using psychotropic drug purchase as a proxy for mental health status, we investigated this issue in a large cohort of young incident venous thromboembolism patients. METHODS: Using Danish nationwide administrative registries from the period 1997-2010, we identified 4,132 patients aged 13-33 years with a first-time venous thromboembolism diagnosis and no history of psychotropic drug usage. We sampled comparison cohort of random general population controls, matched individually in a 1:5 ratio based on sex and birth year. Participants were followed in prescription purchase registries for their first psychotropic drug purchase. RESULTS: Among young venous thromboembolism case cases, the 1-year risk of psychotropic drug purchase was 7.1% (95% confidence interval [CI] 6.3, 7.9) and the 5-year risk 22.1% (95% CI 20.7, 23.5). This was substantially higher than among population controls, with 1- and 5-year risk differences relative to the controls of 4.7% (95% CI 3.9, 5.5), and 10.8% (95% CI 9.4, 12.3), respectively. Adjustment for the effects of recent pregnancy or somatic provocations attenuated risk differences to 4.1% (95% CI 3.5, 5.1) after 1year and 9.6% (95% CI 8.3, 11.2) after 5years. CONCLUSIONS: A venous thromboembolism diagnosis in youth is associated with a poorer mental health prognosis: one in five patients are prescribed psychotropic medication within the first 5year after diagnosis.","author_count":7,"contributors":["Højen, Anette Arbjerg","Gorst-Rasmussen, Anders","Lip, Gregory Y H","Lane, Deirdre A","Rasmussen, Lars Hvilsted","Sørensen, Erik Elgaard","Larsen, Torben Bjerregaard"],"cuid":["S01-000.00-104718"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","City Hospital in Birmingham","University of Birmingham"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"use of psychotropic drugs following venous thromboembolism in youth a nationwide cohort study","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-104718","identifier":[{"id":"84924989584","type":"scopus"},{"id":"WOS:000351086000013","type":"wos"},{"id":"25661687","type":"pmid"}],"ids":["aau-bc96ce79-9982-43af-84f3-051fe376d5f6"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-CE3FEEDA9A4B16D3884B667781D0691D"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Forskningsadministrationen, Aalborg Universitetshospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Hjertemedicin (Kardiologi) [Klinik Hjerte-Lunge]","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Hjerte-Lunge","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, The Clinical Nursing Research Unit","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine, Aalborg Thrombosis Research Unit"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"gb","key":"university of birmingham","loc":["United Kingdom"