fno":"2","first":"Rikke","key":"sørensenrikkepau","last":"Sørensen","locid":"abd88842-f28b-445c-bd7c-790de6ace4cc","name":"Sørensen, Rikke","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Emil Loldrup","key":"fosbølemilloldruppau","last":"Fosbøl","name":"Fosbøl, Emil Loldrup","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jan Kyst","key":"madsenjankystpau","last":"Madsen","name":"Madsen, Jan Kyst","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren","key":"rasmussensørenpau","last":"Rasmussen","locid":"81e338f2-8905-4283-be48-82958d45334f","name":"Rasmussen, Søren","rank":8,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Erik","key":"jørgensenerikpau","last":"Jørgensen","name":"Jørgensen, Erik","rank":9,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Leif","key":"thuesenleifpau","last":"Thuesen","locid":"3f010c74-29b4-4435-8e47-60af1dcd7597","name":"Thuesen, Leif","rank":10,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Christian Holflod","key":"møllerchristianholflodpau","last":"Møller","name":"Møller, Christian Holflod","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Steen Zabell","key":"abildstromszpau","last":"Abildstrøm","locid":"8c578136-f71b-4f74-8f79-c0adef021924","name":"Abildstrom, S. Z.","name_org":"Abildstrøm, Steen Zabell","rank":12,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Steen Zabell","key":"abildstrømsteenzabellpau","last":"Abildstrøm","name":"Abildstrøm, Steen Zabell","rank":12,"rolecode":"pau"}],"pmid":["21051459"],"pub":{"doi":"10.1136/hrt.2010.203901","issn":["13556037","1468201X"],"issn_org":["13556037"],"issue":"1","journal":"Heart","pages":"27-32","publisher":"BMJ Publishing Group","status":"p","title":"Heart","volume":"97"},"review":"Peer Reviewed","scoID":["2-s2.0-78651233253"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-006e4875-0080-4b23-9b3c-e9a8420d1ab2","ku-5ff47123-f525-4ec6-a4cc-c22615110565","sdu-207fea8e-13d7-46d8-96a5-cc284d01d0d9"],"src":["AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Influence of distance from home to invasive centre on invasive treatment after acute coronary syndrome: a nationwide study of 24 910 patients","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-092.54-012601","year":"2011","yearsub":"2011"}
{"abstract":"For survival data with a large number of explanatory variables, lasso penalized Cox regression is a popular regularization strategy. However, a penalized Cox model may not always provide the best fit to data and can be difficult to estimate in high dimension because of its intrinsic nonlinearity. The semiparametric additive hazards model is a flexible alternative which is a natural survival analogue of the standard linear regression model. Building on this analogy, we develop a cyclic coordinate descent algorithm for fitting the lasso and elastic net penalized additive hazards model. The algorithm requires no nonlinear optimization steps and offers excellent performance and stability. An implementation is available in the R-package ahaz and we demonstrate this package in a small timing study and in an application to real data.","author_count":2,"contributors":["Gorst-Rasmussen, Anders","Scheike, Thomas"],"cuid":["S01-000.00-051117"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Additive hazards","LASSO","Survival"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Institut for Folkesundhedsvidenskab"],"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"nr","rtype":["clu"],"sorti":"coordinate descent methods for the penalized semiparametric additive hazards model","src":["aau"],"src-code":["DI-U-AAU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/53333533/R_2011_10.pdf","version":"Pre-print"},"id":"S01-000.00-051117","ids":["aau-03c1c4a6-d8c4-4ad3-aab3-ccccfe82c236"],"keyword":["additive hazards","coordinate descent","elasti net","lasso","survival"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-907D6CF31988BD6B137942A36FA2426D"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/53333533/R_2011_10.pdf","version":"Pre-print"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (ENG)","Aalborg University, The Faculty of Engineering and Science, Department of Mathematical Sciences"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Institut for Folkesundhedsvidenskab"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Anders","key":"gorstrasmussenpau","last":"Gorst-Rasmussen","locid":"2aa85786-c0b1-42ec-93d4-eb7a75696409","name":"Gorst-Rasmussen, Anders","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Thomas","key":"scheikepau","last":"Scheike","name":"Scheike, Thomas","rank":2,"rolecode":"pau"}],"pub":{"issn":["13992503"],"issue":"R-2011-10","pages":"17","publisher":"Department of Mathematical Sciences, Aalborg University","repno":"Research Report Series, R-2011-10","series":"Research Report Series","status":"p"},"review":"No Review","search":{"DAF":["Aalborg University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["aau-03c1c4a6-d8c4-4ad3-aab3-ccccfe82c236"],"src":["AAU Aalborg University"],"title":"Coordinate descent methods for the penalized semiparametric additive hazards model","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-051117","year":"2011","yearsub":"2011"}
{"abstract":"This paper presents the Danish 10-year experience (1999-2009) with cryopreservation (n=386) and autotransplantation of ovarian tissue (n=18). Before applying the technique to humans, the method was thoroughly tested and validated. The cryoprotectant solution was chosen after histological evaluation of mouse and human ovarian tissue after freezing with four different combinations of cryoprotectants. Viability was confirmed by transplantation of frozen-thawed human ovarian tissue (n=49) to oophorectomized Nude mice. Viability after transport of fresh tissue 4-5h prior to freezing had previously been validated. Overnight transport of fresh ovarian tissue prior to cryopreservation was evaluated when human ovarian tissue was kept on ice for 20h and then cryopreserved. The thawed ovarian tissue was transplanted to an oophorectomized Nude mouse and histology confirmed viability. In Denmark 12 women have received a total of 18 autotransplantations of ovarian tissue. All women resumed ovarian function and three healthy babies were born to two women. In both women, the tissue was transported on ice for 4-5h prior to cryopreservation. Ovarian tissue cryopreservation is an important method for fertility preservation; however, before applying the method clinically, each laboratory should perform thorough validation of their technique. Young female patients with cancer may be deprived of future fertility due to the side-effects of cancer treatment. This paper presents the Danish 10-year experience with development and validation of techniques to preserve female fertility. One method, which has been an area of interest in Denmark, is freezing of ovarian tissue. The tissue is taken out surgically before the toxic chemotherapy is initiated and can be transplanted back to the patient if she is cured and has become infertile because of the treatment. However, before the method was used on humans, we performed a series of laboratory and animal experiments to ensure the survival of the tissue and the safety of the technique. Once the protocol had been validated, the clinical use of the technique was implemented. To date, we have frozen the ovarian tissue of almost 400 patients and 12 patients have received transplantation with their own frozen-thawed tissue. So far, three healthy children have been born in Denmark as a result of the procedure. We conclude that freezing of ovarian tissue is an important part of preservation of fertility in young patients with cancer but each centre should validate their protocols prior to applying the technique to humans.","author_count":8,"contributors":["Rosendahl, Mikkel","Schmidt, Kirsten Louise Tryde","Ernst, Erik","Rasmussen, Per Emil","Loft, Anne","Byskov, Anne Grethe","Andersen, Anders Nyboe","Andersen, Claus Yding"],"cuid":["S01-000.00-207706"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"cryopreservation of ovarian tissue for a decade in denmark a view of the technique","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.rbmo.2010.10.015","version":"Other Version"},"id":"S01-000.00-207706","identifier":[{"id":"79551518489","type":"scopus"},{"id":"21239230","type":"pmid"}],"ids":["au-895dcec9-bfc9-4134-94cc-5f41b1a3c523"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-3-4-87E9E6010CDF08A5499A01D6779BD4B7"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.rbmo.2010.10.015","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus University, Faculty of Health Sciences, Department of Anatomy","Aarhus University, Aarhus University, Faculty of Health Sciences, Obstetrics and Gynaecology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Mikkel","key":"rosendahlmikkelpau","last":"Rosendahl","name":"Rosendahl, Mikkel","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Kirsten Louise Tryde","key":"schmidtkirstenlouisetrydepau","last":"Schmidt","name":"Schmidt, Kirsten Louise Tryde","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Erik","key":"ernsterikpau","last":"Ernst","locid":"22960729-0a02-43cc-810e-57fcb57a74ee","name":"Ernst, Erik","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Per Emil","key":"rasmussenperemilpau","last":"Rasmussen","locid":"1b086803-3b59-442b-a6bd-ba22e6874d76","name":"Rasmussen, Per Emil","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Anne","key":"loftannepau","last":"Loft","name":"Loft, Anne","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Anne Grethe","key":"byskovannegrethepau","last":"Byskov","name":"Byskov, Anne Grethe","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Anders Nyboe","key":"andersenandersnyboepau","last":"Andersen","name":"Andersen, Anders Nyboe","rank":7,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Claus Yding","key":"andersenclausydingpau","last":"Andersen","name":"Andersen, Claus Yding","rank":8,"rolecode":"pau"}],"pmid":["21239230"],"pub":{"doi":"10.1016/j.rbmo.2010.10.015","issn":["14726483","14726491"],"issn_org":["14726491"],"issue":"2","journal":"Reproductive BioMedicine Online","pages":"162-71","publisher":"Elsevier Ltd","status":"p","title":"Reproductive BioMedicine Online","title_org":"RBM Online","volume":"22"},"review":"Peer Reviewed","scoID":["2-s2.0-79551518489"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-895dcec9-bfc9-4134-94cc-5f41b1a3c523"],"src":["AU Aarhus University"],"title":"Cryopreservation of ovarian tissue for a decade in Denmark: a view of the technique","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-207706","year":"2011","yearsub":"2011"}
{"author_count":9,"contributors":["Mehlmann, F.","Schrittwieser, R.","Naulin, Volker","Rasmussen, Jens Juul","Müller, H.W.","Ionita, C.","Nielsen, Anders Henry","Vianello, N.","Rohde, V."],"cuid":["S01-000.00-370997"],"event":{"end":"2011-07-01","place":"Strasbourg, fr","start":"2011-06-27","title":"38th EPS Conference on Plasma Physics","year":"2011"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Fusion energy","Fusionsenergiforskning"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"radial transport of poloidal momentum in asdex upgrade","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-370997","ids":["dtu-de1d9ec5-0ddd-43b1-93fb-e88be54055ec"],"keyword":["Fusion energy","Fusionsenergiforskning"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-A9606AD42C30449A224CE6B5B44736E9"],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Risø National Laboratory for Sustainable Energy","Technical University of Denmark, Risø National Laboratory for Sustainable Energy, Plasma Physics and Technology Programme"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"","corresponding":null,"first":"F.","key":"mehlmannpau","last":"Mehlmann","name":"Mehlmann, F.","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"R.","key":"schrittwieserpau","last":"Schrittwieser","name":"Schrittwieser, R.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Vol