0000-0002-7815-4806","rank":12,"rolecode":"pau"},{"affno":"2","first":"Nina","key":"weisninapau","last":"Weis","locid":"3a88aaad-c729-432b-b725-999664af7a45","name":"Weis, Nina","rank":13,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Susanne Gjørup","key":"sækmosesusannegjøruppau","last":"Sækmose","name":"Sækmose, Susanne Gjørup","rank":14,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Bitten","key":"aagaardbittenpau","last":"Aagaard","locid":"c9664360-51bb-439a-a8f0-ca5fc271587a","name":"Aagaard, Bitten","rank":15,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Alonzo","key":"alfaronúñezalonzopau","last":"Alfaro-Núñez","name":"Alfaro-Núñez, Alonzo","rank":16,"rolecode":"pau"},{"affno":"2","first":"Kåre","key":"mølbakkårepau","last":"Mølbak","locid":"d94c7db7-f909-4a03-bdb7-185bb3eb5a96","name":"Mølbak, Kåre","rank":17,"rolecode":"pau"},{"affno":"2","first":"Anette","key":"bøtneranettepau","last":"Bøtner","locid":"2c9cba38-acc7-4b80-8e53-f1cadd5a0731","name":"Bøtner, Anette","rank":18,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders","key":"fomsgaardanderspau","last":"Fomsgaard","name":"Fomsgaard, Anders","rank":19,"rolecode":"pau"}],"pmid":["34248922"],"pub":{"doi":"10.3389/fmicb.2021.698944","issn":["1664302X"],"journal":"Frontiers in Microbiology","paperid":"698944","publisher":"Frontiers Media SA","status":"p","title":"Frontiers in Microbiology","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-85109606136"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Region Zealand","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-2af536f1-8007-463f-adc8-0c3370c7b1a0","ku-b0cf214b-3f19-43f2-83f9-371ad9f49612"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"In vitro Characterization of Fitness and Convalescent Antibody Neutralization of SARS-CoV-2 Cluster 5 Variant Emerging in Mink at Danish Farms","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-002159","year":"2021","yearsub":"2021"}
{"abstract":"Purpose: Evidence of the effects of inpatient multidisciplinary rehabilitation (MDR) on physical function in patients with multiple sclerosis (MS) is limited, particularly whether clinically relevant improvements can be achieved. The aim of this study, therefore, was to investigate the effects of personalised inpatient MDR on the physical function of MS patients. Methods: Embedded in the Danish MS Hospitals Rehabilitation Study, a pragmatic study was performed in MS patients undergoing four weeks of inpatient MDR specifically targeting physical function. Outcomes were assessed at baseline (n = 142), at discharge (n = 137) and at six months follow-up (n = 126) using the six-minute walk test (6MWT), six-spot step test (SSST), five times sit to stand test (5STS), nine-hole peg test (NHPT), dynamic gait index (DGI) and 12-item MS walking scale (MSWS). Results: From Baseline-to-Discharge, significant and clinically relevant improvements were found in all measures of walking capacity (6MWT, SSST, 5STS, DGI and MSWS; p < 0.05) along with significant (but not clinically relevant) improvements in upper extremity function (NHPT; p < 0.05). Whilst comparable improvements were observed within subgroups of MS phenotype (relapsing-remitting [RR] vs. secondary + primary progressive [SP + PP]), disease severity (moderate [EDSS2.5–5.5] vs. severe [EDSS6.0–7.5]) and age (young/middle-aged [Age24–59] vs. old [Age60–65]), an attenuated adaptation was nevertheless observed for 6MWT in the most affected and vulnerable subgroups (i.e. SP + PP, EDSS6.0–7.5 and Age60–65). The significant improvements in walking capacity and upper extremity function persisted at six months follow-up but did not exceed anymore the thresholds regarded as clinically relevant. Conclusion: The results provide novel evidence that personalised inpatient MDR targeting physical function in MS patients elicits significant and clinically relevant improvements in physical function.","author_count":9,"contributors":["Hvid, Lars G.","Gaemelke, Tobias","Dalgas, Ulrik","Slipsager, Mette K.","Rasmussen, Peter Vestergaard","Petersen, Thor","Nørgaard, Michael","Skjerbaek, Anders G.","Boesen, Finn"],"cuid":["S02-100.00-023815"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Hvid, Lars G."],"keyword":["Multiple sclerosis","Physical Functional Performance","Rehabilitation"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR","DI-HO-OTH"],"OT":["MS Hospitals in Ry and Haslev"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-CDR","DI-HO-OTH","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"personalised inpatient multidisciplinary rehabilitation elicits clinically relevant improvements in physical function in patients with multiple sclerosis the danish ms hospitals rehabilitation study","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1177/2055217321989384","version":"Published Version"},"funding_acknowledgement":["This study was made possible through a non-earmarked inheritance from Maja and Johan J?rgensen to the Danish MS Hospitals. No other funding was received. We thank all the patients and the staff who participated in this study, as well as the volunteers from the MS Society; their contributions are wholeheartedly acknowledged. The author(s) received no financial support for the research, authorship, and/or publication of this article."],"id":"S02-100.00-023815","identifier":[{"id":"85101001646","type":"scopus"},{"id":"PMC7894699","type":"pmcid"},{"id":"33643662","type":"pmid"}],"ids":["au-9930a4e5-5212-48e8-befb-071d31e78697","sdu-2c63159e-589d-4e33-b0ee-1ff0c3a8ef68"],"keyword":["Multiple sclerosis","physical functional performance","rehabilitation"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-70BF8007EA0A21C47BB95E744B5FA709"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1177/2055217321989384","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/180276062/2055217321989384.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Public Health, Department of Public Health - Sport Science"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Hospital Sønderjylland, Research Unit of Neurology (Sønderborg)"],"nora_code":"DI-U-SDU","used":1},{"affno":"4","country":"dk","key":"other hospitals","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-OTH","l3nl":"Other Hospitals","l3nn":"Other Hospitals","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Hospitals","namevar":["The Danish MS Hospitals"],"nora_code":"DI-HO-OTH","used":1},{"affno":"5","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["MS Hospitals in Ry and Haslev"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Lars G.","key":"hvidpau","last":"Hvid","locid":"165f797e-aeb6-4650-a7a1-e33b77aaea96","name":"Hvid, Lars G.","orcid":"0000-0003-3233-0429","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Tobias","key":"gaemelkepau","last":"Gaemelke","name":"Gaemelke, Tobias","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ulrik","key":"dalgaspau","last":"Dalgas","locid":"2102ffe9-e66f-4d73-b757-78b5630fb6d6","name":"Dalgas, Ulrik","orcid":"0000-0003-4132-2789","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Mette K.","key":"slipsagerpau","last":"Slipsager","name":"Slipsager, Mette K.","rank":4,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Peter V.","key":"rasmussenpau","last":"Rasmussen","locid":"9ce13abe-9b52-4d0d-9f48-95682e1c0960","name":"Rasmussen, Peter Vestergaard","name_org":"Rasmussen, Peter V.","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Thor","key":"petersenpau","last":"Petersen","locid":"237a4f17-6e58-4e65-9bc5-9cb627526d7f","name":"Petersen, Thor","orcid":"0000-0001-5633-2600","rank":6,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"first":"Michael","key":"nørgaardpau","last":"Nørgaard","name":"Nørgaard, Michael","rank":7,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"first":"Anders G.","key":"skjerbaekpau","last":"Skjerbaek","name":"Skjerbaek, Anders G.","rank":8,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"first":"Finn","key":"boesenpau","last":"Boesen","name":"Boesen, Finn","rank":9,"rolecode":"pau"}],"pmid":["33643662"],"pub":{"doi":"10.1177/2055217321989384","issn":["20552173"],"issue":"1","journal":"Multiple Sclerosis Journal - Experimental, Translational and Clinical","pages":"1-12","publisher":"SAGE Publications","publisher_org":": SAGE Publications","status":"p","title":"Multiple Sclerosis Journal - Experimental, Translational and Clinical","title_org":"Multiple sclerosis journal - experimental, translational and clinical","volume":"7"},"review":"Peer Reviewed","scoID":["2-s2.0-85101001646"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Hospitals","Other Research","Universities","University of Southern Denmark","the danish ms hospitals"],"PST":["Published"]},"sid":["au-9930a4e5-5212-48e8-befb-071d31e78697","sdu-2c63159e-589d-4e33-b0ee-1ff0c3a8ef68"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Personalised inpatient multidisciplinary rehabilitation elicits clinically relevant improvements in physical function in patients with multiple sclerosis : The Danish MS Hospitals Rehabilitation Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-023815","year":"2021","yearsub":"2021"}
{"abstract":"Integration of unstructured and very diverse data is often required for a deeper understanding of the complex biological systems. In order to uncover communalities between heterogeneous data, the data are often harmonized by constructing a kernel and perform numerical integration. In this study, we propose a method for data integration in the framework of an undirected graphical model, where the nodes represent individual data sources of varying nature in terms of complexity and underlying distribution and where the edges represent the partial correlations between two blocks of data. We propose a modified GLASSO for estimation of the graph, with a combination of cross-validation and extended Bayes Information Criterion for sparsity tuning. Furthermore, hierarchical clustering on the weighted consensus kernels from a fixed network is used to partitioning the samples into different classes. Simulations show increasing ability to uncover true edges with increasing sample size and signal to noise. Likewise, identification of nonexisting edges towards disconnected nodes is feasible. The framework is demonstrated for integration of longitudinal symptom burden data, from the second and third year of life, combined with 21 diseases precursors and information of the development of asthma and eczema at the age of 6 years, from 403 children from the COPSAC2010 mother-child cohort. This suggests that maternal predisposition as well as being born preterm indirectly lead to a higher risk of asthma via an increased respiratory symptom burden.","author_count":9,"contributors":["Nørgaard, Sarah Kristine","Linder-Steinlein, Kristoffer","Eliasen, Anders","Stokholm, Jakob","Chawes, Bo L.","Bønnelykke, Klaus","Bisggard, Hans","Smilde, Age K.","Rasmussen, Morten Arendt"],"cuid":["S02-100.00-036345"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD"],"corresponding_author":["Rasmussen, Morten Arendt"],"country":["Netherlands"],"glorg":["All Global Affiliations","Swammerdam Institute for Life Sciences","University of Amsterdam"],"keyword":["Dual primal optimization","GLASSO","Heterogeneous data integration","Kernelization","Undirected graphical models"],"level":"sci","mra":["med","sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"on using kernel integration by graphical lasso to study partial correlations between heterogeneous data sets","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85097781764","version":"Other Version"},"id":"S02-100.00-036345","identifier":[{"id":"85097781764","type":"scopus"}],"ids":["dtu-a50f823b-631f-4938-956b-24d16a402b78","ku-2b1b59f6-45aa-4f31-8f2e-00e517c3da29"],"keyword":["Dual-primal optimization","GLASSO","Heterogeneous data integration","Kernelization","Undirected graphical models"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-92CF6E3CAB4C688D5561C17EEF6879A7"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Health Technology","Technical University of Denmark, Department of Health Technology, Bioinformatics","Technical University of Denmark, Department of Health Technology, Bioinformatics, Bayesian modeling, Machine learning, Molecular Evolution, and Metagenomics"],"nora_code":"DI-U-DTU","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"4","country":"nl","key":"university of amsterdam","loc":["Netherlands","Europe, EU","OECD"],"name":"University of Amsterdam","used":1},{"affno":"5","country":"nl","key":"swammerdam institute for life sciences","loc":["Netherlands","Europe, EU","OECD"],"name":"Swammerdam Institute for Life Sciences","used":1}],"person":[{"affno":"1","first":"Sarah Kristine","key":"nørgaardpau","last":"Nørgaard","name":"Nørgaard, Sarah Kristine","rank":1,"rolecode":"pau"},{"affno":"1","first":"Kristoffer","key":"lindersteinleinpau","last":"Linder-Steinlein","name":"Linder-Steinlein, Kristoffer","rank":2,"rolecode":"pau"},{"affno":"2 1","corresponding":null,"country":"dk","first":"Anders Ulrik","key":"eliasenpau","last":"Eliasen","locid":"65035866-6e6c-4ac5-b1a2-e92d04cbe8aa","name":"Eliasen, Anders","name_org":"Eliasen, Anders Ulrik","rank":3,"rolecode":"pau"},{"affno":"3","first":"Jakob","key":"stokholmpau","last":"Stokholm","name":"Stokholm, Jakob","rank":4,"rolecode":"pau"},{"affno":"1","first":"Bo L.","key":"chawespau","last":"Chawes","locid":"a43d3bab-d625-4981-a8aa-d58d4b4a8b75","name":"Chawes, Bo","name_org":"Chawes, Bo L.","orcid":"0000-0001-6846-6243","rank":5,"rolecode":"pau"},{"affno":"1","first":"Klaus","key":"bønnelykkepau","last":"Bønnelykke","locid":"c36b6936-2cc4-41b1-b7c5-a97978afe417","name":"Bønnelykke, Klaus","rank":6,"rolecode":"pau"},{"affno":"1","first":"Hans","key":"bisggardpau","last":"Bisggard","name":"Bisggard, Hans","rank":7,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"first":"Age K.","key":"smildepau","last":"Smilde","name":"Smilde, Age K.","rank":8,"rolecode":"pau"},{"affno":"3 1","first":"Morten Arendt","key":"rasmussenpau","last":"Rasmussen","locid":"ec31e7b7-ef67-4c14-89d1-2ebe144b638b","name":"Rasmussen, Morten Arendt","orcid":"0000-0001-7431-5206","rank":9,"rolecode":"pau"}],"pub":{"doi":"10.1002/cem.3324","issn":["08869383","1099128X"],"issn_org":["08869383"],"issue":"10","journal":"Journal of Chemometrics","paperid":"e3324","publisher":"John Wiley & Sons Ltd","status":"p","title":"Journal of Chemometrics","volume":"35"},"review":"Peer Reviewed","scoID":["2-s2.0-85097781764"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-a50f823b-631f-4938-956b-24d16a402b78","ku-2b1b59f6-45aa-4f31-8f2e-00e517c3da29"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"On using kernel integration by graphical LASSO to study partial correlations between heterogeneous data sets","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-036345","year":"2021","yearsub":"2021"}
{"abstract":"Background: The coronavirus disease 2019 (COVID-19) pandemic has resulted in millions of deaths and overburdened healthcare systems worldwide. Systemic low-dose corticosteroids have proven clinical benefit in patients with severe COVID-19. Higher doses of corticosteroids are used in other inflammatory lung diseases and may offer additional clinical benefits in COVID-19. At present, the balance between benefits and harms of higher vs. lower doses of corticosteroids for patients with COVID-19 is unclear. Methods: The COVID STEROID 2 trial is an investigator-initiated, international, parallel-grouped, blinded, centrally randomised and stratified clinical trial assessing higher (12 mg) vs. lower (6 mg) doses of dexamethasone for adults with COVID-19 and severe hypoxia. We plan to enrol 1,000 patients in Denmark, Sweden, Switzerland and India. The primary outcome is days alive without life support (invasive mechanical ventilation, circulatory support or renal replacement therapy) at day 28. Secondary outcomes include serious adverse reactions at day 28; all-cause mortality at day 28, 90 and 180; days alive without life support at day 90; days alive and out of hospital at day 90; and health-related quality of life at day 180. The primary outcome will be analysed using the Kryger Jensen and Lange test adjusted for stratification variables and reported as adjusted mean differences and median differences. The full statistical analysis plan is outlined in this protocol. Discussion: The COVID STEROID 2 trial will provide evidence on the optimal dosing of systemic corticosteroids for COVID-19 patients with severe hypoxia with important implications for patients, their relatives and society.","author_count":55,"contributors":["Munch, M. W.","Granholm, Anders","Myatra, S. N.","Vijayaraghavan, B. K.T.","Cronhjort, Maria","Wahlin, R. R.","Jakob, Stephan M.","Cioccari, Luca","Kjær, M. N.","Vesterlund, G. K.","Meyhoff, T. S.","Helleberg, Marie","Møller, M. H.","Benfield, Thomas","Venkatesh, Balasubramanian","Hammond, Naomi","Micallef, Sharon","Bassi, Abhinav","John, Oommen","Jha, Vivekanand","Kristiansen, K. T.","Ulrik, C. S.","Jørgensen, V. L.","Smitt, Margit","Bestle, Morten H.","Andreasen, A. S.","Poulsen, L. M.","Rasmussen, Bodil Steen","Brøchner, A. C.","Strøm, Thomas","Møller, Anders","Khan, M. S.","Padmanaban, Ajay","Divatia, J. V.","Saseedharan, Sanjith","Borawake, Kapil","Kapadia, Farhad","Dixit, Subhal","Chawla, Rajesh","Shukla, Urvi","Amin, Pravin","Chew, Michelle S.","Gluud, Christian","Lange, Theis","Perner, Anders"],"cuid":["S03-091.28-011730"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"51-200 contributors","class":"merged","cluster_size":3,"continent":["Asia, South","Europe, EU","Europe, Non-EU","Nordic","OECD","Oceania"],"corresponding_author":["Munch, M. W.","Warrer Munch, Marie"],"country":["Australia","India","Sweden","Switzerland","United Kingdom"],"glorg":["All Global Affiliations","Apollo Hospitals Group","Bombay Hospital Institute of Medical Sciences","Bombay Hospital and Medical Research Centre","Chennai Critical Care Consultants","Hinduja Hospital","Imperial College London","Indraprastha Apollo Hospitals","Karolinska Institute","Karolinska Institutet","Linköping University","Manipal Academy of Higher Education","Manipal University","P.D. Hinduja National Hospital and Medical Research Centre","Rajendra Institute of Medical Sciences","S.L. Raheja Hospital","Sanjeevan Hospital","Symbiosis International University","Symbiosis University Hospital and Research Centre","Tata Memorial Hospital","University Hospital of Bern","University of Bern","University of New South Wales","Vishwaraj Hospital"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-NDR","DI-HO-OTH","DI-HO-SDR","DI-HO-ZEA"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU","DI-U-SDU","DI-U-UND"]},"level3all":["DI-HO-CAP","DI-HO-NDR","DI-HO-OTH","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-KU","DI-U-SDU","DI-U-UND"]},"review":"pr","rtype":["clu"],"sorti":"higher vs lower doses of dexamethasone in patients with covid 000000000019 and severe hypoxia covid steroid 000000000002 trial protocol and statistical analysis plan","src":["aau","ku","sdu"],"src-code":["DI-U-AAU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC8014264/pdf/AAS-9999-0.pdf","version":"Published Version"},"funding_acknowledgement":["Rigshospitalet's Research Council, Grant/Award Number: E-22703-06; Novo Nordisk Fonden, Grant/Award Number: 0062998. The funding sources were not involved in the design or conduct of the COVID STEROID 2 trial. We would like to thank all patients and relatives agreeing to participate in the COVID STEROID 2 trial; all clinical and research staff at the participating departments for conducting the trial; the regulatory authorities in the participating countries for rapid handling and approvals; and the funding sources. We would also like to thank all clinical and research staff involved in the design and conduction of the ?Low-dose hydrocortisone in patients with COVID-19 and severe hypoxia (COVID STEROID) trial? which preceded the COVID STEROID 2 trial. Balasubramanian Venkatesh have received financial support from the Medical Research Future Fund Australia."],"id":"S03-091.28-011730","identifier":[{"id":"PMC8014264","type":"pmcid"},{"id":"85102303150","type":"scopus"},{"id":"33583034","type":"pmid"}],"ids":["aau-f56079a6-1144-4e96-bb6d-3599f9a58410","ku-b8b71a97-1402-430c-86af-fe4f5cd0dab7","sdu-72a194ea-dfaf-4c09-8dfc-b4b78502a241"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-B62CDFB66D97F5803FFA7BCC9993263F"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC8014264/pdf/AAS-9999-0.pdf","version":"Published Vers