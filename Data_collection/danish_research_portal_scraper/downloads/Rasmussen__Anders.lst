person":[{"affno":"1","corresponding":null,"first":"Johann M.","key":"gudbergssonpau","last":"Gudbergsson","name":"Gudbergsson, Johann M.","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Line M.","key":"strausspau","last":"Strauss","name":"Strauss, Line M.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Qi","key":"wupau","last":"Wu","name":"Wu, Qi","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rikke K.","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Rikke K.","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Malene Møller","key":"jørgensenpau","last":"Jørgensen","locid":"8838d38e-52f3-42a8-83fd-e3e6342d235c","name":"Jørgensen, Malene Møller","orcid":"0000-0003-1381-3863","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Robert A.","key":"fentonpau","last":"Fenton","name":"Fenton, Robert A.","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders","key":"etzerodtpau","last":"Etzerodt","name":"Etzerodt, Anders","rank":7,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-03200463-f709-4b03-8849-30834389a174"],"src":["AAU Aalborg University"],"title":"Malignant ascites-derived extracellular vesicles present myeloid cell signatures in metastatic ovarian cancer","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-794049","year":"2024","yearsub":"2024"}
{"abstract":"Purpose: After curatively intended rectal cancer (RC) surgery, new follow-up strategies are warranted, seeking more individualised care and targeting health-related quality of life (HRQoL) and functional outcomes. The FURCA trial aimed to investigate the effect of patient-led follow-up on HRQoL and symptom burden 3 years after surgery. Methods: RC patients from four Danish centres were randomised 1:1 to intervention (patient-led follow-up with patient education and self-referral to a specialist nurse) or control (standard follow-up with five routine doctor visits). Patients in both groups had a computed tomography (CT) at 1 and 3 years. The primary outcome (HRQoL) was assessed by the Functional Assessment of Cancer Therapy – colorectal (FACT-C) score (Ward et al. in Qual Life Res. 8(3):181-95, 18). Secondary outcomes were functional measures, patient involvement and satisfaction and cancer recurrence at 3 years. Results: From Feb 2016 to Aug 2018, 336 patients were included of whom 248 completed 3 years of follow-up. Between-group differences were found neither for the primary endpoint, nor for functional outcomes. The recurrence rate did not differ between the groups. Patient involvement and satisfaction were higher in the intervention group with statistical significance in almost half of the items. Conclusions: We found no effect on HRQoL and symptom burden from patient-led follow-up, although it may improve patient-perceived involvement and satisfaction. Implications for Cancer Survivors: The findings in this study suggest that patient-led follow-up is a more tailored approach to meet cancer survivors’ needs and might improve their ability to cope with survivorship. ClinicalTrials.gov identifier: R97-A6511-14-S23.","author_count":17,"contributors":["Jakobsen, Ida Hovdenak","Thaysen, Henriette Vind","Bernstein, Inge Thomsen","Christensen, Peter","Hauberg, Ann","Iversen, Lene Hjerrild","Johansen, Christoffer","Lindhardt Larsen, Susie","Laurberg, Søren","Madsen, Anders Husted","Madsen, Mogens Rørbæk","Rasmussen, Helle Vindfeldt","Thorlacius-Ussing, Ole","Juul, Therese"],"cuid":["S02-098.21-681208"],"filters":{"added":"2023-08","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Hovdenak, Ida"],"keyword":["Health related quality of life","Late sequelae","Patient led follow up","Rectal cancer"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"quality of life and symptom burden after rectal cancer surgery a randomised controlled trial comparing patient led versus standard follow up","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1007/s11764-023-01410-4","version":"Published Version"},"funding_acknowledgement":["Open access funding provided by Aarhus University Hospital The FURCA trial was funded by the Danish Cancer Society [Grant number R97-A6511-14-S23]."],"id":"S02-098.21-681208","identifier":[{"id":"85163863378","type":"scopus"},{"id":"PMC11424718","type":"pmcid"},{"id":"37395934","type":"pmid"}],"ids":["aau-244942b6-c638-4c2e-b959-fe22823f433d","au-20e7d775-cbbd-4bb6-a5f1-b55b8a2a3d7a"],"keyword":["Health-related quality of life","Late sequelae","Patient-led follow-up","Rectal cancer"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-CBBC2A42928047AD26DE96757C445A33"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/746358168/Hovdenak_et_al._2024_._Quality_of_life_and_symptom_burden_after_rectal_cancer_surgery_-_a_randomised_controlled_trial_comparing_patient-led_versus_standard_follow-up.pdf","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1007/s11764-023-01410-4","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Surgical Gastroenterology"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1},{"affno":"3","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Gastrointestinal Surgery","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-AAU","used":1},{"affno":"4","country":"dk","key":"north denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-NDR","l3nl":"North Denmark Region","l3nn":"North Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"North Denmark Region","namevar":["Aalborg University Hospital"],"nora_code":"DI-HO-NDR","used":1},{"affno":"5","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","