-2322-4b15-bfae-1e8a8c3895e7","name":"Ostrowski, Sisse Rye","orcid":"0000-0001-5288-3851","rank":8,"rolecode":"pau"},{"affno":"2","first":"Robert","key":"erikssonpau","last":"Eriksson","name":"Eriksson, Robert","rank":9,"rolecode":"pau"},{"affno":"1 2","first":"Christian","key":"søborgpau","last":"Søborg","locid":"48fef9a6-5fde-42e4-833c-736dd0c205a9","name":"Søborg, Christian","rank":10,"rolecode":"pau"},{"affno":"1 2","first":"Thyge L.","key":"nielsenpau","last":"Nielsen","locid":"6c00a237-f88d-4beb-9bcb-74353b5d4854","name":"Nielsen, Thyge Lynghøj","name_org":"Nielsen, Thyge L.","rank":11,"rolecode":"pau"},{"affno":"2 1","first":"Thea K.","key":"fischerpau","last":"Fischer","locid":"97c4bf8d-8bd1-470b-8e0b-91eb4faf7703","name":"Fischer, Thea K.","rank":12,"rolecode":"pau"},{"affno":"2 1","first":"Birgitte","key":"lindegaardpau","last":"Lindegaard","locid":"f8c3a235-1f94-4c1d-afe3-c6c7f9b31002","name":"Lindegaard, Birgitte","rank":13,"rolecode":"pau"},{"affno":"3","first":"Kristina Træholt","key":"franckpau","last":"Franck","name":"Franck, Kristina Træholt","rank":14,"rolecode":"pau"},{"affno":"2 1","first":"Zitta Barrella","key":"harboepau","last":"Harboe","locid":"2b596a33-5659-4236-b5ea-c0991866af44","name":"Harboe, Zitta Barrella","orcid":"0000-0001-5552-0095","rank":15,"rolecode":"pau"}],"pmid":["36698135"],"pub":{"doi":"10.1186/s12985-023-01974-8","issn":["1743422X"],"issue":"1","journal":"Virology Journal","paperid":"14","status":"p","title":"Virology Journal","volume":"20"},"review":"Peer Reviewed","scoID":["2-s2.0-85146878971"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-a054084b-1410-4b15-ba42-fbdf61352f8b"],"src":["KU University of Copenhagen"],"title":"High titers of neutralizing SARS-CoV-2 antibodies six months after symptom onset are associated with increased severity in COVID-19 hospitalized patients","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-489293","year":"2023","yearsub":"2023"}
{"abstract":"Erhvervsdidaktisk opslagsbog handler om, hvordan didaktisk teori og begreber kan forstås og anvendes i praksis på de uddannelser, der retter sig specifikt mod at uddanne til forskellige erhverv og brancher. I bogen findes opslag om klassiske og moderne erhvervsdidaktiske begreber såsom instruktion, multimodalitet, stilladsering og refleksion. Hvert opslag præsenterer begrebets teoretiske baggrund, dets betydning i en praksis og dets bidrag til professionel analyse, forberedelse eller evaluering af undervisning. Gennem et casebaseret format viser 58 opslag didaktiske begreber, som de kan “se ud” i praksis: Vi er med faglæreren i værkstedet, når hun giver feedback, med i dialogen, når lærerteams udvikler praksis, med, når undervisningen differentieres, og med, når lærere overvejer, hvordan undervisningen kan invitere til deltagelse og motivere elever og kursister.","author_count":2,"contributors":["Skovbjerg, Louise Duus","Rasmussen, Anders"],"cuid":["S01-000.00-649966"],"filters":{"added":"2023-02","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Didaktik","Klasseledelse","Læring pædagogik og undervisning"],"level":"pop","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-UC"],"level3":{"UC":["DI-UC-ALL","DI-UC-UCL"]},"level3all":["DI-UC-UCL"]},"review":"und","rtype":["clu"],"sorti":"erhvervsdidaktisk opslagsbog klasseledelse","src":["ucl"],"src-code":["DI-UC-UCL"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://hansreitzel.dk/fag/paedagogik/paedagogik-alle-produkter/erhvervsdidaktisk-opslagsbog-bog-56026-9788702373929","version":"Other Version"},"id":"S01-000.00-649966","ids":["ucl-fb7d909e-a737-4fee-8257-a1bfac277f81"],"keyword":["Didaktik","Klasseledelse","Læring, pædagogik og undervisning"],"lang":"Danish","level":"Popular","mra":["Humanities"],"noi":["Local-1-1-A93DD290850F53D599D48EF6C19F0C74"],"org":[{"affno":"1","key":"ucl university college","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-UCL","l3nl":"UCL University College","l3nn":"UCL University College","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"UCL University College","namevar":["UCL Erhvervsakademi og Professionshøjskole, Direktion, Kompetence- og Organisationsudvikling, Center for Undervisningsmidler"],"nora_code":"DI-UC-UCL","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Louise Duus","key":"skovbjergpau","last":"Skovbjerg","locid":"61352d68-f025-400a-9941-63d8ca9ae21a","name":"Skovbjerg, Louise Duus","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders","key":"rasmussenpau","last":"Rasmussen","locid":"2a136974-b782-43e4-9ff2-f630c2ddb5a1","name":"Rasmussen, Anders","rank":2,"rolecode":"pau"}],"pub":{"eisbn":["9788702373929"],"pages":"185-190","publisher":"Hans Reitzels Forlag","status":"p","title":"Erhvervsdidaktisk opslagsbog"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All University Colleges","DI-ALL","DI-UC","DI-UC-ALL","UCL University College","University Colleges"],"PST":["Published"]},"sid":["ucl-fb7d909e-a737-4fee-8257-a1bfac277f81"],"src":["UCL University College"],"title":"Erhvervsdidaktisk opslagsbog : Klasseledelse","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-649966","year":"2023","yearsub":"2023"}
{"abstract":"The iconic Cape buffalo has experienced several documented population declines in recent history. These declines have been largely attributed to the late 19th century rinderpest pandemic. However, the effect of the rinderpest pandemic on their genetic diversity remains contentious, and other factors that have potentially affected this diversity include environmental changes during the Pleistocene, range expansions and recent human activity. Motivated by this, we present analyses of whole genome sequencing data from 59 individuals from across the Cape buffalo range to assess present-day levels of genome-wide genetic diversity and what factors have influenced these levels. We found that the Cape buffalo has high average heterozygosity overall (0.40%), with the two southernmost populations having significantly lower heterozygosity levels (0.33% and 0.29%) on par with that of the domesticated water buffalo (0.29%). Interestingly, we found that these lower levels are probably due to recent inbreeding (average fraction of runs of homozygosity 23.7% and 19.9%) rather than factors further back in time during the Pleistocene. Moreover, detailed investigations of recent demographic history show that events across the past three centuries were the main drivers of the exceptional loss of genetic diversity in the southernmost populations, coincident with the onset of colonialism in the southern extreme of the Cape buffalo range. Hence, our results add to the growing body of studies suggesting that multiple recent human-mediated impacts during the colonial period caused massive losses of large mammal abundance in southern Africa.","author_count":17,"contributors":["Quinn, Liam","Garcia-Erill, Genís","Santander, Cindy G.","Brüniche-Olsen, Anna","Liu, Xiaodong","Sinding, Mikkel Holger S.","Heaton, Michael P.","Smith, Timothy P. L.","Pečnerová, Patrícia","Bertola, Laura D.","Hanghøj, Kristian","Rasmussen, Malthe Sebro","de Jager, Deon","Siegismund, Hans Redlef","Albrechtsen, Anders","Heller, Rasmus","Moltke, Ida"],"cuid":["S01-000.00-671152"],"filters":{"added":"2023-06","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","United States Department of Agriculture"],"keyword":["Conservation genetics","Demographic history","Inbreeding","Population genetics"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"colonialism in south africa leaves a lasting legacy of reduced genetic diversity in cape buffalo","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1111/mec.16851","version":"Published Version"},"id":"S01-000.00-671152","identifier":[{"id":"85147454652","type":"scopus"},{"id":"36651275","type":"pmid"}],"ids":["ku-ebb99afc-d670-4053-ac8c-c5bc0fdb31bb"],"keyword":["cape buffalo","conservation genetics","demographic history","inbreeding","population genetics"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-945EB5D581F78C26734B6BAFE92BDA81"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/344730590/Molecular_Ecology_2023_Quinn_Colonialism_in_South_Africa_leaves_a_lasting_legacy_of_reduced_genetic_diversity_in_Cape.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1111/mec.16851","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Biology, Computational and RNA Biology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"us","key":"united states department of agriculture","loc":["United States","America, North","OECD"],"name":"United States Department of Agriculture","used":1}],"person":[{"affno":"1","first":"Liam","key":"quinnpau","last":"Quinn","locid":"51f8bb78-3a6e-4579-9b13-a376374277dc","name":"Quinn, Liam","rank":1,"rolecode":"pau"},{"affno":"1","first":"Genís","key":"garciaerillpau","last":"Garcia-Erill","locid":"a03971a5-00fa-4ccf-ae13-f15fdcd34405","name":"Garcia-Erill, Genís","rank":2,"rolecode":"pau"},{"affno":"1","first":"Cindy","key":"santanderpau","last":"Santander","locid":"7fb91780-169e-48b7-80ed-6741e9f3af9e","name":"Santander, Cindy G.","name_org":"Santander, Cindy","rank":3,"rolecode":"pau"},{"affno":"1","first":"Anna","key":"brünicheolsenpau","last":"Brüniche-Olsen","locid":"80ae8cb5-8bcc-4126-9e57-555810402c5b","name":"Brüniche-Olsen, Anna","orcid":"0000-0002-3364-2064","rank":4,"rolecode":"pau"},{"affno":"1","first":"Xiaodong","key":"liupau","last":"Liu","locid":"e20c5ca2-aa50-4de3-9ee9-ce2aee1875dc","name":"Liu, Xiaodong","rank":5,"rolecode":"pau"},{"affno":"1","first":"Mikkel-Holger S.","key":"sindingpau","last":"Sinding","locid":"d441872e-7274-486b-b9b2-0c0ee8bb3545","name":"Sinding, Mikkel Holger S.","name_org":"Sinding, Mikkel-Holger S.","orcid":"0000-0003-1371-219X","rank":6,"rolecode":"pau"},{"affno":"2","first":"Michael P.","key":"heatonpau","last":"Heaton","name":"Heaton, Michael P.","rank":7,"rolecode":"pau"},{"affno":"2","first":"Timothy P. L.","key":"smithpau","last":"Smith","name":"Smith, Timothy P. L.","rank":8,"rolecode":"pau"},{"affno":"1","first":"Patrícia","key":"pečnerovápau","last":"Pečnerová","locid":"840078a0-bb20-4c9f-87ab-33b4d3058bfc","name":"Pečnerová, Patrícia","rank":9,"rolecode":"pau"},{"affno":"1","first":"Laura D.","key":"bertolapau","last":"Bertola","locid":"4642ddac-d5be-4ac5-af29-3b0cf9faf187","name":