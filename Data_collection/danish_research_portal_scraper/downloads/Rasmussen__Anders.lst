,"orcid":"0000-0002-1265-7355","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter Lund","key":"kristensenpau","last":"Kristensen","locid":"751d26de-66d4-4ef9-8183-880c48c96dc7","name":"Kristensen, Peter Lund","orcid":"0000-0002-5666-9614","rank":7,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Eli","key":"putermanpau","last":"Puterman","name":"Puterman, Eli","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders","key":"grøntvedpau","last":"Grøntved","locid":"393b1ca1-e658-437c-9ca3-73aea925ad58","name":"Grøntved, Anders","orcid":"0000-0003-1584-679X","rank":9,"rolecode":"pau"}],"pmid":["37521498"],"pub":{"doi":"10.1038/s44184-022-00015-6","issn":["27314251"],"journal":"npj mental health research","paperid":"14","publisher":"Springer","status":"p","title":"npj mental health research","title_org":"npj Mental Health Research"},"review":"Peer Reviewed","scoID":["2-s2.0-105006459590"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region Zealand","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-c5b68fee-e14e-4896-a00c-29118cf48755"],"src":["SDU University of Southern Denmark"],"title":"Effects of limiting digital screen use on well-being, mood, and biomarkers of stress in adults","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-629855","year":"2022","yearsub":"2022"}
{"author_count":6,"contributors":["Kaasgaard, Mette","Rasmussen, Daniel Bech","Løkke, Anders","Vuust, Peter","Hilberg, Ole","Bodtger, Uffe"],"cuid":["S01-000.00-802814"],"event":{"end":"2022-11-26","start":"2022-11-25","title":"Danish Respiratory Society Congress 2022","year":"2022"},"filters":{"added":"2023-02","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"sing a lung does singing for lung health provide physiological changes in copd","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-802814","ids":["sdu-c141ea08-4613-47f4-872b-f8d193a8382d"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-870B64CE6A7A561A74DF0BDD4ABF364D"],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Regional Health Research","SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Zealand University Hospital"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Mette","key":"kaasgaardpau","last":"Kaasgaard","locid":"2b472c7a-7c51-482b-9155-59dea1d8ae37","name":"Kaasgaard, Mette","orcid":"0000-0003-3833-2943","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Daniel Bech","key":"rasmussenpau","last":"Rasmussen","locid":"18525822-35fd-4cd8-afdd-a608be44cc84","name":"Rasmussen, Daniel Bech","orcid":"0000-0003-1213-9483","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders Løkke","key":"ottesenpau","last":"Ottesen","locid":"db3d3870-0459-4783-8f0b-6a8e5d9dce78","name":"Løkke, Anders","name_org":"Ottesen, Anders Løkke","orcid":"0000-0002-6905-4141","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Peter","key":"vuustpau","last":"Vuust","name":"Vuust, Peter","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ole","key":"hilbergpau","last":"Hilberg","locid":"6c545c65-1d94-45a3-a8b4-f90eae06d248","name":"Hilberg, Ole","orcid":"0000-0002-3075-3463","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Uffe","key":"bodtgerpau","last":"Bodtger","locid":"2f4e70da-63bb-4b8d-af09-2a959d6df5e8","name":"Bodtger, Uffe","orcid":"0000-0002-1231-9209","rank":6,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-c141ea08-4613-47f4-872b-f8d193a8382d"],"src":["SDU University of Southern Denmark"],"title":"Sing-a-Lung: Does Singing for Lung Health provide physiological changes in COPD?","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-802814","year":"2022","yearsub":"2022"}
{"abstract":"Background: Intensive care unit (ICU) patients receive numerous interventions, but knowledge about potential interactions between these interventions is limited. Co-enrolment in randomized clinical trials represents a unique opportunity to investigate any such interactions. We aim to assess interactions in four randomized clinical trials with overlap in inclusion periods and patient populations. Methods: This protocol and statistical analysis plan describes a secondary explorative analysis of interactions in four international ICU trials on pantoprazole, oxygenations targets, haloperidol and intravenous fluids, respectively. The primary outcome will be 90-day all-cause mortality. The secondary outcome will be days alive and out of hospital in 90 days after randomization. All patients included in the intention-to-treat populations of the four trials will be included. Four co-primary analyses will be conducted, one with each of the included trials as reference using a logistic regression model adjusted for the reference trial's stratification variables and for the co-interventions with interactions terms. The primary analytical measure of interest will be the analyses’ tests of interaction. A p-value below.05 will be considered statically significant. The stratification variable- and co-intervention-adjusted effect estimates will be reported with 95% confidence intervals without adjustments for multiplicity. Conclusion: This exploratory analysis will investigate the presence of any interactions between pantoprazole, oxygenation targets, haloperidol and amount of intravenous fluids in four international ICU trials using co-enrolment. Assessment of possible interactions represents valuable information to guide the design, statistical powering and conduct of future trials.","author_count":12,"contributors":["Schjørring, Olav Lilleholt","Lange, Theis","Krag, Mette","Andersen-Ranberg, Nina Christine","Meyhoff, Tine S.","Marker, Søren","Lass Klitgaard, Thomas","Estrup, Stine","Møller, Morten Hylander","Rasmussen, Bodil Steen","Poulsen, Lone M.","Perner, Anders"],"cuid":["S02-087.24-007464"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Schjørring, Olav Lilleholt"],"keyword":["Critical Illness","Delirium","Drug Interactions","Haloperidol","Intensive Care Units","Intravenous","Oxygen Inhalation Therapy","Pantoprazole","Pragmatic clinical trials","Randomized controlled trials","infusions"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-OTH","DI-HO-ZEA"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-HO-OTH","DI-HO-ZEA","DI-U-AAU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"interactions in clinical trials protocol and statistical analysis plan for an explorative study of four randomized icu trials on use of pantoprazole oxygenation targets haloperidol and intravenous fluids","src":["aau","ku"],"src-code":["DI-U-AAU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/532523966/Interactions_in_clinical_trials_Protocol_and_statistical_analysis_plan_for_an_explorative_study_of_four_randomised_ICU_trials_on_use_of_pantoprazole_oxygenation_targets_haloperidol_and_intravenous_fluids.pdf","version":"Authors Final Version"},"funding_acknowledgement":["The SUP‐ICU, HOT‐ICU and AID‐ICU trials were primarily funded by a grant from the public Innovation Fund Denmark (4108‐00011A). The CLASSIC trial was primarily funded by a grant from the Novo Nordisk Foundation (Grant number NNF17OC0028608). Information on additional funding sources of the individual trials can be found in the respective trial publications. 4–9,14,15,18"],"id":"S02-087.24-007464","identifier":[{"id":"34606090","type":"pmid"},{"id":"85116779542","type":"scop