olecode":"pau"},{"affno":"2","first":"Thomas","key":"ringbækpau","last":"Ringbæk","name":"Ringbæk, Thomas","rank":26,"rolecode":"pau"},{"affno":"8","first":"Uffe","key":"bødtgerpau","last":"Bødtger","name":"Bødtger, Uffe","rank":27,"rolecode":"pau"},{"affno":"2","first":"Jesper","key":"ravnpau","last":"Ravn","name":"Ravn, Jesper","rank":28,"rolecode":"pau"},{"affno":"2","first":"Jens Benn","key":"sørensenpau","last":"Sørensen","name":"Sørensen, Jens Benn","rank":29,"rolecode":"pau"},{"affno":"","first":"Ove B","key":"schaffalitzkydemuckadellpedh","last":"Schaffalitzky de Muckadell","name":"Schaffalitzky de Muckadell, Ove B","rank":30,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Jesper","key":"hastrupsvendsenpedh","last":"Hastrup Svendsen","name":"Hastrup Svendsen, Jesper","rank":31,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Hendrik","key":"vilstruppedh","last":"Vilstrup","name":"Vilstrup, Hendrik","rank":32,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"edition":"19","isbn":["9788762817524"],"pages":"783-937","place":"København","publisher":"Munksgaard","status":"p","title":"Medicinsk Kompendium"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Other Hospitals","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark","copenhagen university hospital - holbæk","institut for klinisk medicin - lungemedicinsk afdeling, nbg"],"PST":["Published"]},"sid":["ku-d3cbd3c2-5319-460d-8cb0-acba8d188e5e"],"src":["KU University of Copenhagen"],"title":"Lungesygdomme","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-519956","year":"2019","yearsub":"2019"}
{"abstract":"OBJECTIVES: A recent study from Sweden showed that European hedgehogs may constitute a reservoir for methicillin-resistant Staphylococcus aureus (MRSA), but this host-parasite relationship remains to be investigated in other countries. In this study, we therefore sought to: 1) determine the dissemination of MRSA in European hedgehogs throughout Denmark; 2) investigate determinants of MRSA carriage in hedgehogs; 3) determine the potential for zoonotic transmission of MRSA from hedgehogs to humans; and 4) characterise the detected MRSA on both a phenotypic and molecular level. METHODS: Nasal swabs were taken from 188 dead hedgehogs collected by volunteers throughout Denmark to determine the occurrence of MRSA. Additionally, 16 hedgehog rehabilitators were tested for potential zoonotic transmission of MRSA from hedgehogs to humans. The swabs were incubated in tryptic soy broth supplemented with 6.5% NaCl, followed by spread of 10 μl on Brilliance MRSA 2 agar. One presumptive MRSA colony from each plate was subcultured on 5% blood agar. All S. aureus subcultures were verified by a PCR assay detecting mecA, mecC, lukF-PV, scn, and spa, followed by spa typing. RESULTS: A total of 114 (61%) hedgehogs carried mecC-MRSA, whereas none carried mecA-MRSA. The detected mecC-MRSA belonged to two genetic lineages CC130 (spa-types: t528, t843, t1048, t3256, t3570, t6220, t17133) and CC1943 (spa-types: t978, t2345, t3391, t8835, t16868), 52% of which were spa-type t843 (CC130).The detection rate of mecC-MRSA in the hedgehogs was similar regardless of cause of death, sex, region and habitat type. None of the hedgehog rehabilitators carried MRSA. CONCLUSIONS: This nationwide study confirms a high occurrence of mecC-MRSA in hedgehogs, which could serve as a natural reservoir for this specific type of MRSA. Furthermore, our study did not find signs of zoonotic transmission of mecC-MRSA to hedgehog rehabilitators.","author_count":7,"contributors":["Rasmussen, Sophie Lund","Larsen, Jesper","van Wijk, Rien E","Jones, Owen","Berg, Thomas Bjørneboe","Angen, Øystein","Larsen, Anders Rhod"],"cuid":["S01-000.00-602109"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-OT","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"OT":["Van Wijk Eco Research, Søborg, Denmark."],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-GV-SSI","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"european hedgehogs erinaceus europaeus as a natural reservoir of methicillin resistant staphylococcus aureus carrying mecc in denmark","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pone.0222031","version":"Published Version"},"id":"S01-000.00-602109","identifier":[{"id":"PMC6730924","type":"pmcid"},{"id":"31490992","type":"pmid"},{"id":"85071990348","type":"scopus"}],"ids":["sdu-64fffee0-570f-4569-af8d-c62f8aac0c44"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-A3F935D22A8290258D0C3494D9918021"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/153572809/European_hedgehogs_Erinaceus_europaeus_as_a_natural_reservoir_of_methicillin_resistant_Staphylococcus_aureus_carrying_mecC_in_Denmark.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pone.0222031","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"n