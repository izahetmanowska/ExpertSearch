00-464324","year":"2015","yearsub":"2015"}
{"abstract":"Denne rapport dokumenterer den evaluering, som er foretaget af et kompetenceudviklingsprojekt for lærere, pædagoger og ledere i Fredericia Kommune. Projektet skal udvikle “stærke samarbejdskulturer”, hvor man bl.a. ændrer praksis i retning af at arbejde med inklusion af alle børn og elever i de kommunale skoler og institutioner. Evalueringen er gennemført som en virkningsevaluering, hvilket vil sige, at intentionen var, at generere viden om virkningen (udbyttet eller effekten) af kompetenceudviklingsprojektet samt at generere viden om, hvordan selve interventionen (undervisning, læreprocesser m.m.) virker. Data er indsamlet via semistrukturerede fokusgruppeinterview med lærere og pædagoger fra to forskellige undervisningsforløb. Lærerne har gennemgået diplommodulet ‘Fagdidaktik og klasseledelse ‘ medens pædagogerne har gennemgået diplommodulet ‘Social inklusion‘. Analysen af data viser, at den opstillede programteori kan bekræftes, hvorfor det konkluderes, at interventionen i Fredericia Kommune i høj grad har medvirket til, at der er igangsat læreprocesser hos deltagerne, som kan føre til realisering af de kommunalt opstillede mål.","author_count":3,"contributors":["Sørensen, Peter","Pless, Thomas Peter","Rasmussen, Anders"],"cuid":["S01-000.00-648595"],"filters":{"added":"2023-01","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"pop","oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-UC"],"level3":{"UC":["DI-UC-ALL","DI-UC-UCL"]},"level3all":["DI-UC-UCL"]},"review":"und","rtype":["clu"],"sorti":"evaluering af kompetenceudviklingsforløb i fredericia kommune","src":["ucl"],"src-code":["DI-UC-UCL"],"type":"doo","type-grp":["all","pub"]},"id":"S01-000.00-648595","ids":["ucl-98fadcfa-ea32-4871-b642-8bd5ae597c75"],"lang":"Danish","level":"Popular","noi":["Local-1-1-75C6F665A0A2C02BE9093F5B1F14E9A6"],"org":[{"affno":"1","key":"ucl university college","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-UCL","l3nl":"UCL University College","l3nn":"UCL University College","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"UCL University College","namevar":["UCL Erhvervsakademi og Professionshøjskole, Direktion, Kompetence- og Organisationsudvikling, Anvendt Velfærdsforskning"],"nora_code":"DI-UC-UCL","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Peter","key":"sørensenpau","last":"Sørensen","locid":"6fff95b6-be42-4562-8733-5f2f8d1431a2","name":"Sørensen, Peter","orcid":"0000-0002-7903-3539","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thomas Peter","key":"plesspau","last":"Pless","locid":"18ad61e5-1378-4473-af0a-e5933244045d","name":"Pless, Thomas Peter","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders","key":"rasmussenpau","last":"Rasmussen","locid":"2a136974-b782-43e4-9ff2-f630c2ddb5a1","name":"Rasmussen, Anders","rank":3,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All University Colleges","DI-ALL","DI-UC","DI-UC-ALL","UCL University College","University Colleges"],"PST":["Published"]},"sid":["ucl-98fadcfa-ea32-4871-b642-8bd5ae597c75"],"src":["UCL University College"],"title":"Evaluering af kompetenceudviklingsforløb i Fredericia Kommune","type":"Other-Unknown","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-648595","year":"2015","yearsub":"2016"}
{"abstract":"Identifikation af forandringen i, hvad der opfattes som sociale problemer i efterkrigstiden. Der tages afsæt i perioden for den moderne velfærdsstatsudfoldelse, og der fokuseres på forskelle mellem hvordan sociale problemer anskues her (ydre vilkår) set i relation til den aktuelle situation (indre- og interpersonelle forhold). Der skelnes i analysen mellem et politisk og videnskabeligt begreb om sociale problemer.","author_count":4,"contributors":["Rasmussen, Tove"],"cuid":["S01-000.00-655358"],"filters":{"added":"2023-08","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Socialt udsatte"],"level":"edu","oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-UC"],"level3":{"UC":["DI-UC-ALL","DI-UC-VIA"]},"level3all":["DI-UC-VIA"]},"review":"und","rtype":["clu"],"sorti":"sociale problemer i historisk belysning","src":["via"],"src-code":["DI-UC-VIA"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-655358","ids":["via-116b0588-1a66-462d-b01a-ccad93a353c4"],"keyword":["socialt udsatte"],"lang":"Danish","level":"Educational","noi":["Local-1-1-0219F659A22C73DE9155155BC50B4344"],"org":[{"affno":"1","key":"via university college","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-VIA","l3nl":"VIA University College","l3nn":"VIA University College","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"VIA University College","namevar":["VIA, Forskning og udvikling, Forsk.center Pædagogik og dannelse","VIA, Uddannelser, Social- og samfundsuddannelserne, Socialrådgiveruddannelsen Aarhus C"],"nora_code":"DI-UC-VIA","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Tove","key":"rasmussenpau","last":"Rasmussen","locid":"5b42d1f0-0ade-42de-b87e-72e91f26d0af","name":"Rasmussen, Tove","orcid":"0000-0002-6599-884X","rank":1,"rolecode":"pau"},{"affno":"","first":"Peter","key":"bundesenpedh","last":"Bundesen","name":"Bundesen, Peter","rank":2,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Anders Bøggild","key":"christensenpedh","last":"Christensen","name":"Christensen, Anders Bøggild","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Tove","key":"rasmussenpedh","last":"Rasmussen","name":"Rasmussen, Tove","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9788741260518"],"place":"København","publisher":"Hans Reitzels Forlag","status":"p","title":"Sociale problemer","volume":"1"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All University Colleges","DI-ALL","DI-UC","DI-UC-ALL","University Colleges","VIA University College"],"PST":["Published"]},"sid":["via-116b0588-1a66-462d-b01a-ccad93a353c4"],"src":["VIA University College"],"title":"Sociale problemer i historisk belysning","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-655358","year":"2015","yearsub":"2015"}
{"abstract":"Study design: Prospective cohort study. Objective: Although introduced for neurogenic bladder dysfunction, it has been suggested that the artificial somato-autonomic reflex arch alleviates neurogenic bowel dysfunction (NBD). We aimed at evaluating the effects of the reflex arch on NBD. Setting: Denmark. Methods: Ten subjects with supraconal spinal cord injury (SCI) (nine males, median age 46 years) had an anastomosis created between the ventral part of the fifth lumbar or first sacral nerve root and the ventral part of the second sacral nerve root. Standardized assessment of segmental colorectal transit times with radiopaque markers, evaluation of scintigraphic assessed colorectal emptying upon defecation, scintigraphic assessment of colorectal transport during stimulation of the reflex arch, standard anorectal physiology tests and colorectal symptoms were performed at baseline and 18 months after surgery. Results: No significant change was observed in colorectal emptying upon defecation (median 31% of the rectosigmoid at baseline vs 75% at follow-up, P=0.50), no movement of colorectal contents was observed during stimulation of the reflex arch. Segmental colorectal transit times, anal sphincter pressures and rectal capacity did not change, and no change was seen in NBD score (median 13.5 (baseline) vs 12.5 (follow-up), P=0.51), St Marks fecal incontinence score (4.5 vs 5.0, P=0.36) and Cleveland constipation score (6.0 vs 8.0, P=0.75). Conclusions: The artificial somato-autonomic reflex arch has no effect on bowel function in subjects with supraconal SCI.","author_count":8,"contributors":["Rasmussen, Mikkel Mylius","Krogh, Klaus","Clemmensen, Dorte","Tankisi, Hatice","Fuglsang-Frederiksen, Anders","Rawashdeh, Yazan F.","Bluhme, Henrik","Christensen, Peter"],"cuid":["S02-100.00-014713"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":1,"keyword":["Anal Canal physiopathology","Anastomosis Surgical methods","Colon diagnostic imaging","Constipation etiology","Contrast Media","Defecation physiology","Denmark","Fecal Incontinence etiology","Female","Follow Up Studies","Humans","Male","Middle Aged","Neurologic Examination","Neurosurgical Procedures adverse effects","Pilot Projects","Radionuclide Imaging","Rectum diagnostic imaging","Reflex physiology","Spinal Cord Injuries complications","Treatment Outcome"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR"],"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"the artificial somato autonomic reflex arch does not improve bowel function in subjects with spinal cord injury","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1038/sc.2015.75","version":"Other Version"},"id":"S02-100.00-014713","identifier":[{"id":"84941024997","type":"scopus"},{"id":"25917948","type":"pmid"}],"ids":["au-1d0bced4-9fb3-466d-b5bb-90e7181d4776","au-8d02d335-e778-4bd6-91b2-40a2bd6ef412"],"keyword":["Anal Canal/physiopathology","Anastomosis, Surgical/methods","Colon/diagnostic imaging","Constipation/etiology","Contrast Media","Defecation/physiology","Denmark","Fecal Incontinence/etiology","Female","Follow-Up Studies","Humans","Male","Middle Aged","Neurogenic Bowel/diagnostic imaging","Neurologic Examination","Neurosurgical Procedures/adverse effects","Pilot Projects","Radionuclide Imaging","Rectum/diagnostic imaging","Reflex/physiology","Spinal Cord Injuries/complications","Spinal Nerve Roots/physiopathology","Treatment Outcome"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-7AE652171EDA478B0B465064AD689337"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1038/sc.2015.75","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2015","yearSub":"2016"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Neurosurgery","Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Surgical Gastroenterology L"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus Amtssygehus"],"nora_code":"DI-HO-CDR","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"4","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1 2 3","corresponding":null,"country":"dk","first":"Mikkel Mylius","key":"rasmussenpau","last":"Rasmussen","locid":"0a611a7f-8a19-41f3-9221-58fe673b3ef1","name":"Rasmussen, Mikkel Mylius","orcid":"0000-0002-4768-7255","rank":1,"rolecode":"pau"},{"affno":"1 3 4","corresponding":null,"country":"dk","first":"Klaus","key":"kroghpau","last":"Krogh","locid":"e69f7028-9eb1-4f3a-ab4e-c684c234bf2e","name":"Krogh, Klaus","orcid":"0000-0001-9168-2403","rank":2,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"first":"Dorte","key":"clemmensenpau","last":"Clemmensen","locid":"826b8629-1e7d-42d6-8e46-7f9a993bf743","name":"Clemmensen, Dorte","rank":3,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"country":"dk","first":"Hatice","key":"tankisipau","last":"Tankisi","locid":"2b3f7bfd-71e0-4e1e-9a63-62cf6d26d1ea","name":"Tankisi, Hatice","rank":4,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"country":"dk","first":"Anders","key":"fuglsangfrederiksenpau","last":"Fuglsang-Frederiksen","locid":"9dbd8297-9ebb-41f0-ab0b-8ddfef8c33bd","name":"Fuglsang-Frederiksen, Anders","orcid":"0000-0003-3926-5287","rank":5,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"country":"dk","first":"Yazan F. H.","key":"rawashdehpau","last":"Rawashdeh","locid":"dd97020c-c4f8-4898-8b08-a088d13d45de","name":"Rawashdeh, Yazan F.","name_org":"Rawashdeh, Yazan F. H.","orcid":"0000-0002-5517-2980","rank":6,"rolecode":"pau"},{"affno":"1 3 4","corresponding":null,"country":"dk","first":"Henrik","key":"bluhmepau","last":"Bluhme","locid":"1d472181-ac97-412b-afb4-4e8571c23a9c","name":"Bluhme, Henrik","rank":7,"rolecode":"pau"},{"affno":"1 2 3","corresponding":null,"country":"dk","first":"Peter","key":"christensenpau","last":"Christensen","locid":"456d99d5-ee96-4333-afef-d1596a62cf74","name":"Christensen, Peter","orcid":"0000-0002-6611-3935","rank":8,"rolecode":"pau"}],"pmid":["25917948"],"pub":{"doi":"10.1038/sc.2015.75","issn":["13624393","14765624"],"issn_org":["13624393"],"issue":"9","journal":"Spinal Cord","pages":"705-10","publisher":"Springer Nature","status":"p","title":"Spinal Cord","volume":"53"},"review":"Peer Reviewed","scoID":["2-s2.0-84941024997"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-1d0bced4-9fb3-466d-b5bb-90e7181d4776","au-8d02d335-e778-4bd6-91b2-40a2bd6ef412"],"src":["AU Aarhus University"],"title":"The artificial somato-autonomic reflex arch does not improve bowel function in subjects with spinal cord injury","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-014713","year":"2015","yearsub":2016}
{"abstract":"The response in production parameters to projected future levels of temperature, atmospheric carbondioxide ([CO2]), and ozone ([O3]) was investigated in 138 spring barley accessions. The comprehensive setof landraces, cultivars, and breeder-lines, were during their entire life cycle exposed to a two-factor treat-ment of combined elevated temperature (+5◦C day/night) and [CO2] (700 ppm), as well as single-factortreatments of elevated temperature (+5◦C day/night), [CO2] (700 ppm), and [O3] (100–150 ppb). Thecontrol treatment was equivalent to present average South Scandinavian climate (temperature: 19/12◦C(day/night), [CO2]: 385 ppm). Overall grain yield was found to decrease 29% in the two-factor treatmentwith concurrent elevation of [CO2] and temperature, and this response could not be predicted from theresults of treatments with elevated [CO2] and temperature as single factors, where grain yield increased16% and decreased 56%, respectively. Elevated [O3] was found to decrease grain yield by 15%. Substantialvariation in response to the applied climate treatments was found between the accessions. The resultsrevealed landraces, cultivars, and breeder-lines with phenotypes applicable for breeding towards stableand high yield under future climate conditions. Further, we suggest identifying resources for breedingunder multifactor climate conditions, as single-factor treatments did not accurately forecast the response,when factors were combined.","author_count":11,"contributors":["Ingvordsen, Cathrine Heinz","Backes, Gunter","Lyngkjær, Michael Foged","Peltonen-Sainio, Pirjo","Jensen, Jens Due","Jalli, Marja","Jahoor, Ahmed","Rasmussen, Morten","Mikkelsen, Teis Nørgaard","Stockmarr, Anders","Bagger Jørgensen, Rikke"],"cuid":["S02-100.00-034827"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","Nordic","OECD"],"country":["Finland","Germany","Sweden"],"glorg":["All Global Affiliations","MTT Agrifood Research","NordGen","Nordic Genetic Resource Center","University of Kassel"],"keyword":["Carbon dioxide","Climate change","Combined treatment","Hordeum vulgare","Ozone","Phenotypes","Production parameters","Temperature"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-PR-OTH","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"significant decrease in yield under future climate conditions stability and production of 000000000138 spring barley accessions","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.eja.2014.12.003","version":"Other Version"},"id":"S02-100.00-034827","identifier":[{"id":"84949116791","type":"scopus"}],"ids":["dtu-61f8f182-50ac-4821-bcfc-360971d1e0b5","ku-4a324412-8586-4e23-ad16-a483d1177cad"],"keyword":["Carbon dioxide","Carbon dioxide exploitation","Climate change","Combined treatment","Hordeum vulgare","Ozone","Phenotypes","Production parameters","Temperature","Temperaturea"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-83784C8CF0B4F2623C47F82C0E28A87E"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.eja.2014.12.003","version":"Other Version"}],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Chemical and Biochemical Engineering"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"de","key":"university of kassel","loc":["Germany","Europe, EU","OECD"],"name":"University of Kassel","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Plant and Environmental Sciences, Section for Plant Biochemistry"],"nora_code":"DI-U-KU","used":1},{"affno":"4","country":"fi","key":"mtt agrifood research","loc":["Finland","Europe, EU","Nordic","OECD"],"name":"MTT Agrifood Research","used":1},{"affno":"5","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["Nordic Seed A/S"],"nora_code":"DI-PR-OTH","used":1},{"affno":"6","country":"se","key":"nordic genetic resource center","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Nordic Genetic Resource Center","used":1},{"affno":"7","country":"se","key":"nordgen","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"NordGen","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Cathrine Heinz","key":"ingvordsenpau","last":"Ingvordsen","locid":"8f53ec3c-a7b0-4195-aa56-79d4a7acf890","name":"Ingvordsen, Cathrine Heinz","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Gunter","key":"backespau","last":"Backes","name":"Backes, Gunter","rank":2,"rolecode":"pau"},{"affno":"3","first":"Michael Foged","key":"lyngkjærpau","last":"Lyngkjær","locid":"4b5150c8-5b52-402f-9535-88f053812136","name":"Lyngkjær, Michael Foged","orcid":"0000-0003-2179-7090","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Pirjo","key":"peltonensainiopau","last":"Peltonen-Sainio","name":"Peltonen-Sainio, Pirjo","rank