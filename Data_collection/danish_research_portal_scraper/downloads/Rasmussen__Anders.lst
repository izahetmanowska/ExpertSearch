Berentzen","name":"Berentzen, Tina L.","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lotte Maxild","key":"mortensenpau","last":"Mortensen","locid":"d53932e7-7b4d-43a3-8c51-fa3b0087ce3a","name":"Mortensen, Lotte Maxild","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Anne","key":"tjønnelandpau","last":"Tjønneland","name":"Tjønneland, Anne","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Marianne Uhre","key":"jakobsenpau","last":"Jakobsen","name":"Jakobsen, Marianne Uhre","rank":7,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Thorkild I.A.","key":"sørensenpau","last":"Sørensen","name":"Sørensen, Thorkild I.A.","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kim","key":"overvadpau","last":"Overvad","locid":"7ca4bfca-d3a3-484e-8ee5-d7cb6ad7314b","name":"Overvad, Kim","rank":9,"rolecode":"pau"}],"pub":{"issn":["03932990","15737284"],"issn_org":["03932990"],"issue":"Suppl 1","journal":"European Journal of Epidemiology","paperid":"P-351","publisher":"Springer","status":"p","title":"European Journal of Epidemiology","volume":"28"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Non-Profit Organisations","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-NP","DI-NP-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Non-Profit Organisations","Other Research","Universities"],"PST":["Published"]},"sid":["aau-26c584d1-ef4f-4f71-9b64-075ebc4ab798"],"src":["AAU Aalborg University"],"title":"Characteristics of dietary patterns behind change in waist circumference and body weight","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-061302","year":"2013","yearsub":"2013"}
{"abstract":"Study Design. Experimental investigation of short-term and long-term corticomotor effects of specific neck training, coordination training, and no training.Objective. To determine the effects of different training programs on the motor neurons controlling the neck muscles as well as the effects of training on muscle strength and muscle fatigue, and the correlations between corticomotor control and motor learning.Summary of Background Data. Training is usually recommended for unspecific neck pain and consists of neck and upper body coordination, strengthening, and endurance exercises. However, it is unclear which type of training is the most effective. No studies have previously investigated the neural effect of neck training and the possible differential effect of specific versus coordination training on corticomotor control.Methods. Transcranial magnetic stimulation and electromyography were used to elicit and monitor motor-evoked potentials (MEPs) from the trapezius and thumb muscles before and 30 min, 1 hour, and 7 days after training. Parameters measured were MEPs, MEP latency, strength, learning effects, and muscle fatigue.Results. Only specific neck training yielded a 65% increase in MEP up to 7 days after training compared to baseline (P <0.001). No significant changes were seen following coordination training, no training, and in the within-subject control muscle. The mean muscle strength increased immediately after specific neck training from 56.6 to 61 kg (P <0.001). No subjective or objective measures of fatigue were observed.Conclusion. Specific neck training induced a sustained hyperexcitability of motor neurons controlling the neck muscles compared to coordination training and controls. These findings may prove valuable in the process of developing more effective clinical training programs for unspecific neck pain.","author_count":5,"contributors":["Rittig-Rasmussen, Bjarne","Kasch, Helge","Fuglsang-Frederiksen, Anders","Jensen, Troels Staehelin","Svensson, Peter"],"cuid":["S01-000.00-160383"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"specific neck training induces sustained corticomotor hyperexcitability as assessed by motor evoked potentials","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1097/BRS.0b013e3182975310","version":"Other Version"},"id":"S01-000.00-160383","identifier":[{"id":"84880729076","type":"scopus"},{"id":"23609207","type":"pmid"}],"ids":["au-364f3c2a-8bc9-4e2a-be07-8c8572a55253"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-796F7DF5D58F409A6DB9584B1D0CE571"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1097/BRS.0b013e3182975310","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Danish Pain Research Center","Aarhus University, Health, Department of Dentistry and Oral Health, Department of Dentistry and Oral Health - Dentistry"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Bjarne","key":"rittigrasmussenpau","last":"Rittig-Rasmussen","locid":"8de237b5-c7a3-4019-b3ac-23504cd42e0a","name":"Rittig-Rasmussen, Bjarne","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Helge","key":"kaschpau","last":"Kasch","locid":"f78dc707-c440-4d0c-8afb-a43de72ff13c","name":"Kasch, Helge","orcid":"0000-0002-9302-4946","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anders","key":"fuglsangfrederiksenpau","last":"Fuglsang-Frederiksen","locid":"9dbd8297-9ebb-41f0-ab0b-8ddfef8c33bd","name":"Fuglsang-Frederiksen, Anders","orcid":"0000-0003-3926-5287","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Troels S","key":"jensenpau","last":"Jensen","locid":"e1a6c2c8-3a85-464d-a1b3-53c8bab37d6d","name":"Jensen, Troels Staehelin","name_org":"Jensen, Troels S","orcid":"0000-0002-3487-6380","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peter","key":"svenssonpau","last":"Svensson","locid":"163ec423-3f89-45a0-8cd8-81455aa6a507","name":"Svensson, Peter","rank":5,"rolecode":"pau"}],"pmid":["23609207"],"pub":{"doi":"10.1097/brs.0b013e3182975310","issn":["03622436","15281159"],"issn_org":["03622436"],"issue":"16","journal":"Spine","publisher":"Wolters Kluwer Health","status":"p","title":"Spine","volume":"38"},"review":"Peer Reviewed","scoID":["2-s2.0-84880729076"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-364f3c2a-8bc9-4e2a-be07-8c8572a55253"],"src":["AU Aarhus University"],"title":"Specific Neck Training Induces Sustained Corticomotor Hyperexcitability as Assessed by Motor Evoked Potentials","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-160383","year":"2013","yearsub":"2013"}
