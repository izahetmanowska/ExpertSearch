,"OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"9","country":"se","key":"university of gothenburg","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"University of Gothenburg","used":1},{"affno":"10","country":"se","key":"sahlgrenska university hospital","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Sahlgrenska University Hospital","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Tim","key":"spelmanpau","last":"Spelman","name":"Spelman, Tim","rank":1,"rolecode":"pau"},{"affno":"3","first":"Melinda","key":"magyaripau","last":"Magyari","locid":"1efd2abb-1b20-49bb-a6c6-f3dc13b48021","name":"Magyari, Melinda","orcid":"0000-0002-0972-5222","rank":2,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Fredrik","key":"piehlpau","last":"Piehl","name":"Piehl, Fredrik","rank":3,"rolecode":"pau"},{"affno":"1 4","corresponding":null,"first":"Anders","key":"svenningssonpau","last":"Svenningsson","name":"Svenningsson, Anders","rank":4,"rolecode":"pau"},{"affno":"5 6","corresponding":null,"country":"dk","first":"Peter Vestergaard","key":"rasmussenpau","last":"Rasmussen","locid":"9ce13abe-9b52-4d0d-9f48-95682e1c0960","name":"Rasmussen, Peter Vestergaard","rank":5,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Matthias","key":"kantpau","last":"Kant","locid":"be6ec287-1bfc-4785-bc68-ff709f2a9093","name":"Kant, Matthias","rank":6,"rolecode":"pau"},{"affno":"3","first":"Finn","key":"sellebjergpau","last":"Sellebjerg","locid":"4cbcdba1-9f69-4103-b595-68788ee7aacc","name":"Sellebjerg, Finn","rank":7,"rolecode":"pau"},{"affno":"8","first":"Hanna","key":"joensenpau","last":"Joensen","name":"Joensen, Hanna","rank":8,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Jan","key":"hillertpau","last":"Hillert","name":"Hillert, Jan","rank":9,"rolecode":"pau"},{"affno":"9 10","corresponding":null,"first":"Jan","key":"lyckepau","last":"Lycke","name":"Lycke, Jan","rank":10,"rolecode":"pau"}],"pmid":["34398221"],"pub":{"doi":"10.1001/jamaneurol.2021.2738","issn":["21686149","21686157"],"issn_org":["21686149"],"issue":"10","journal":"JAMA Neurology","pages":"1197-1204","publisher":"American Medical Association","status":"p","title":"JAMA Neurology","volume":"78"},"review":"Peer Reviewed","scoID":["2-s2.0-85112766010"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-02e62ba6-22ff-4344-870e-11c3ba44c672","ku-aaf65546-1739-493a-94e1-a37381553bd5","sdu-495ebac2-7f5e-4459-bbd4-c303291f4840"],"src":["AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Treatment Escalation vs Immediate Initiation of Highly Effective Treatment for Patients with Relapsing-Remitting Multiple Sclerosis : Data from 2 Different National Strategies","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-094.71-012806","year":"2021","yearsub":"2021"}
{"abstract":"BACKGROUND: Comatose patients admitted after out-of-hospital cardiac arrest frequently experience haemodynamic instability and anoxic brain injury. Targeted temperature management is used for neuroprotection; however, targeted temperature management also affects patients' haemodynamic status. This study assessed the haemodynamic status of out-of-hospital cardiac arrest survivors during prolonged (48 hours) targeted temperature management at 33°C. METHODS: Analysis of haemodynamic and vasopressor data from 311 patients included in a randomised, clinical trial conducted in 10 European hospitals (the TTH48 trial). Patients were randomly allocated to targeted temperature management at 33°C for 24 (TTM24) or 48 (TTM48) hours. Vasopressor and haemodynamic data were reported hourly for 72 hours after admission. Vasopressor load was calculated as norepinephrine (µg/kg/min) plus dopamine(µg/kg/min/100) plus epinephrine (µg/kg/min). RESULTS: After 24 hours, mean arterial pressure (mean±SD) was 74±9 versus 75±9 mmHg (P=0.19), heart rate was 57±16 and 55±14 beats/min (P=0.18), vasopressor load was 0.06 (0.03-0.15) versus 0.08 (0.03-0.15) µg/kg/min (P=0.22) for the TTM24 and TTM48 groups, respectively. From 24 to 48 hours, there was no difference in mean arterial pressure (Pgroup=0.32) or lactate (Pgroup=0.20), while heart rate was significantly lower (average difference 5 (95% confidence interval 2-8) beats/min, Pgroup<0.0001) and vasopressor load was significantly higher in the TTM48 group (Pgroup=0.005). In a univariate Cox regression model, high vasopressor load was associated with mortality in univariate analysis (hazard ratio 1.59 (1.05-2.42) P=0.03), but not in multivariate analysis (hazard ratio 0.77 (0.46-1.29) P=0.33). CONCLUSIONS: In this study, prolonged targeted temperature management at 33°C for 48 hours was associated with higher vasopressor requirement but no sign of any detrimental haemodynamic effects.","author_count":13,"contributors":["Grand, Johannes","Hassager, Christian","Skrifvars, Markus B","Tiainen, Marjaana","Grejs, Anders M","Jeppesen, Anni Nørgaard","Duez, Christophe Henri Valdemar","Rasmussen, Bodil Steen","Laitio, Timo","Nee, Jens","Taccone, FabioSilvio","Søreide, Eldar","Kirkegaard, Hans"],"cuid":["S03-099.00-009638"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Grand, Johannes"],"country":["Belgium","Finland","Germany","Norway"],"glorg":["All Global Affiliations","Charité – Universitätsmedizin Berlin","Helsinki University Hospital","Hôpital Erasme","Stavanger University Hospital","Turku University Central Hospital","Turku University Hospital","University Hospitals Brussels (UZB)","University of Bergen","University of Helsinki","University of Turku"],"keyword":["33 DEGREES C","36 DEGREES C","Associations","Autoregulation","COMATOSE SURVIVORS","Cardiac arrest","Cerebral blood flow","Haemodynamics","Mean arterial pressure","Mortality","Outcomes","Post cardiac arrest syndrome","Resuscitation","Targeted temperature management","Vasopressor"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR"],"OT":["Erasme Hospital (ULB)"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-U-AAU","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"haemodynamics and vasopressor support during prolonged targeted temperature management for 000000000048 hours after out of hospital cardiac arrest a post hoc substudy of a randomised clinical trial","src":["aau","au","ku"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85164552077","version":"Oth