"nielsenpau","last":"Nielsen","name":"Nielsen, Anders","rank":12,"rolecode":"pau"},{"affno":"5","corresponding":null,"country":"dk","first":"Jens M.","key":"olesenpau","last":"Olesen","locid":"5beee907-781b-4998-8f99-97083ea86835","name":"Olesen, Jens M.","orcid":"0000-0003-1998-1083","rank":13,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Megan","key":"snowellpau","last":"S. Nowell","name":"S. Nowell, Megan","rank":14,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Graciela M.","key":"ruschpau","last":"Rusch","name":"Rusch, Graciela M.","rank":15,"rolecode":"pau"}],"pub":{"doi":"10.1111/ecog.06379","issn":["09067590","16000587"],"issn_org":["09067590"],"issue":"12","journal":"Ecography","paperid":"e06379","publisher":"Wiley-Blackwell Publishing Ltd","status":"p","title":"Ecography","volume":"2022"},"review":"Peer Reviewed","scoID":["2-s2.0-85139937582"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-7177b320-cd61-4809-94bc-e43404262945"],"src":["AU Aarhus University"],"title":"Neutral processes related to regional bee commonness and dispersal distances are important predictors of plant–pollinator networks along gradients of climate and landscape conditions","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-194130","year":"2022","yearsub":"2022"}
{"abstract":"Circulating tumour DNA (ctDNA) detection for postoperative risk stratification in cancer patients has great clinical potential. However, low ctDNA abundances complicates detection. Multitarget (MT) detection strategies have been developed to increase sensitivity. Yet, empirical evidence supporting performance gains of MT vs. single-target (ST) strategies in a postoperative setting is limited. We compared ctDNA detection in 379 paired plasma samples from 112 stage II-III colorectal cancer patients by ST digital PCR and MT sequencing of 16 patient-specific variants. The strategies exhibited good concordance (90%, Cohen's Kappa 0.79), with highly correlated ctDNA quantifications (Pearson r = 0.985). A difference was observed in ctDNA detection preoperatively (ST 72/92, MT 88/92). However, no difference was observed immediately after surgery in recurrence (ST 11/22, MT 10/22) or nonrecurrence (both 2/34) patients. In serial samples, detection was similar within recurrence (ST 13/16, MT 14/16) and nonrecurrence (ST 3/49, MT 1/49) patients. Both approaches yielded similar lead times to standard-of-care radiology (ST 4.0 months, MT 4.1 months). Our findings do not support significant performance gains of the MT strategy over the ST strategy for postoperative ctDNA detection.","author_count":9,"contributors":["Henriksen, Tenna Vesterman","Reinert, Thomas","Rasmussen, Mads Heilskov","Demuth, Christina","Løve, Uffe Schou","Madsen, Anders Husted","Gotschalck, Kåre Andersson","Iversen, Lene Hjerrild","Andersen, Claus Lindbjerg"],"cuid":["S01-000.00-207744"],"filters":{"added":"2022-11","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Andersen, Claus Lindbjerg"],"keyword":["Circulating tumour DNA","Colorectal cancer","Liquid biopsy","Residual disease"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"comparing single target and multitarget approaches for postoperative circulating tumour dna detection in stage ii iii colorectal cancer patients","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1002/1878-0261.13294","version":"Published Version"},"id":"S01-000.00-207744","identifier":[{"id":"85135967598","type":"scopus"},{"id":"35895438","type":"pmid"},{"id":"PMC9580876","type":"pmcid"}],"ids":["au-896bff4f-e077-4ae5-a996-fda51ae1b4e3"],"keyword":["circulating tumour DNA","colorectal cancer","liquid biopsy","residual disease"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-A8DD24AD02DC7420BA9F3733DE01137A"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1002/1878-0261.13294","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Molecular Medicine (MOMA)"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Tenna Vesterman","key":"henriksenpau","last":"Henriksen","locid":"3861b20b-cac4-4754-bb98-8ae8cca5ac57","name":"Henriksen, Tenna Vesterman","orcid":"0000-0002-8541-1735","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Thomas","key":"reinertpau","last":"Reinert","locid":"22f4f867-bf80-4a55-89ac-be06f063db03","name":"Reinert, Thomas","orcid":"0000-0003-4835-4804","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mads Heilskov","key":"rasmussenpau","last":"Rasmussen","locid":"3285e14f-ef19-480d-97ff-c95d6a90b354","name":"Rasmussen, Mads Heilskov","orcid":"0000-0001-5723-6303","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Christina","key":"demuthpau","last":"Demuth","locid":"cc733c50-0ae7-4069-936d-85392ba5a273","name":"Demuth, Christina","orcid":"0000-0003-0237-9758","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Uffe Schou","key":"løvepau","last":"Løve","locid":"9837418b-432d-4a86-bd1a-e2de386c9014","name":"Løve, Uffe Schou","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anders Husted","key":"madsenpau","last":"Madsen","locid":"fadf30da-6cbc-427e-ae16-72d99c1ac48d","name":"Madsen, Anders Husted","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kåre Andersson","key":"gotschalckpau","last":"Gotschalck","locid":"985d1890-0823-439b-937e-1ec61a97615a","name":"Gotschalck, Kåre Andersson","orcid":"0000-0001-5119-2231","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lene Hjerrild","key":"iversenpau","last":"Iversen","locid":"4d8ada79-98c2-49eb-ac2f-472b41434eff","name":"Iversen, Lene Hjerrild","orcid":"0000-0002-2336-2923","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Claus Lindbjerg","key":"andersenpau","last":"Andersen","locid":"f97421ce-9c23-4c51-9fcd-be0843ed0c0f","name":"Andersen, Claus Lindbjerg","orcid":"0000-0002-7406-2103","rank":9,"rolecode":"pau"}],"pmid":["35895438"],"pub":{"doi":"10.1002/1878-0261.13294","issn":["15747891","18780261"],"issn_org":["15747891"],"issue":"20","journal":"Molecular Oncology","pages":"3654-3665","publisher":"John Wiley and Sons Ltd","status":"p","title":"Molecular Oncology","volume":"16"},"review":"Peer Reviewed","scoID":["2-s2.0-85135967598"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-896bff4f-e077-4ae5-a996-fda51ae1b4e3"],"src":["AU Aarhus University"],"title":"Comparing single-target and multitarget approaches for postoperative circulating tumour DNA detection in stage II-III colorectal cancer patients","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-207744","year":"2022","yearsub":"2022"}
{"abstract":"The recurrence rate of colorectal liver metastases (CRLM) patients treated with curative intent is above 50%. Standard of care surveillance includes intensive computed tomographic (CT) imaging as well as carcinoembryonic antigen (CEA) measurements. Nonetheless, relapse detection often happens too late to resume curative treatment. This longitudinal cohort study enrolled 115 patients with plasma samples (N = 439) prospectively collected before surgery, postoperatively at day 30 and every third month for up to 3 years. Droplet digital PCR (ddPCR) was used to monitor serial plasma samples for somatic mutations. Assessment of ctDNA status either immediately after surgery, or serially during surveillance, stratified the patients into groups of high and low recurrence risk (hazard ratio [HR], 7.6; 95% CI, 3.0-19.7; P <.0001; and HR, 4.3; 95% CI, 2.3-8.1; P <.0001, respectively). The positive predictive value (PPV) of ctDNA was 100% in all postoperative analyses. In multivariable analyses, postoperative ctDNA status was the only consistently significant risk marker associated with relapse (P <.0001). Indeterminate CT findings were observed for 30.8% (21/68) of patients. All patients (9/21) that were ctDNA positive at the time of the indeterminate CT scan later relapsed, contrasting 42.6% (5/12) of those ctDNA negative (P =.0046). Recurrence diagnoses in patients with indeterminate CT findings were delayed (median 2.8 months, P <.0001). ctDNA status is strongly associated with detection of minimal residual disease and early detection of relapse. Furthermore, ctDNA status can potentially contribute to clinical decision-making in case of indeterminate CT findings, reducing time-to-intervention.","author_count":14,"contributors":["Reinert, Thomas","Petersen, Lena Marie Skindhøj","Henriksen, Tenna Vesterman","Larsen, Marie Øbo","Rasmussen, Mads Heilskov","Frydendahl, Amanda","Øgaard, Nadia","Knudsen, Michael","Nordentoft, Iver","Vang, Søren","Krag, Søren Rasmus Palmelund","Knudsen, Anders Riegels","Mortensen, Frank Viborg","Andersen, Claus Lindbjerg"],"cuid":["S01-000.00-207785"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"corresponding_author":["Andersen, Claus Lindbjerg"],"keyword":["Biomarkers Tumor genetics","Circulating Tumor DNA genetics","Colorectal Neoplasms diagnosis","Colorectal cancer liver metastases","Droplet digital PCR","Humans","Liver Neoplasms genetics","Longitudinal Studies","Minimal residual disease","Neoplasm Recurrence Local epidemiology","Prognosis","Prospective Studies","Recurrence surveillance","circulating tumor DNA"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"circulating tumor dna for prognosis assessment and postoperative management after curative intent resection of colorectal liver metastases","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1002/ijc.33924","version":"Published Version"},"id":"S01-000.00-207785","identifier":[{"id":"PMC9303459","type":"pmcid"},{"id":"34994972","type":"pmid"},{"id":"85122933499","type":"scopus"}],"ids":["au-8981151a-7114-47f2-9de3-3de3a3064715"],"keyword":["Biomarkers, Tumor/genetics","Circulating Tumor DNA/genetics","Circulating tumor DNA","Colorectal Neoplasms/diagnosis","Colorectal cancer liver metastases","Droplet digital PCR","Humans","Liver Neoplasms/genetics","Longitudinal Studies","Minimal residual disease","Neoplasm Recurrence, Local/epidemiology","Prognosis","Prospective Studies","Recurrence surveillance"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-2838AC7BC4FBD7ABCFC8C770DC5865DA"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1002/ijc.33924","version":"Published Version"},{"access":"oa","license":"CC BY","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC9303459/pdf/IJC-150-1537.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Molecular Medicine (MOMA)"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Thomas","key":"reinertthomaspau","last":"Reinert","locid":"22f4f867-bf80-4a55-89ac-be06f063db03","name":"Reinert, Thomas","orcid":"0000-0003-4835-4804","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lena Marie Skindhøj","key":"petersenlenamarieskindhøjpau","last":"Petersen","locid":"662ca33b-5b25-4e51-9243-dd5dc6262446","name":"Petersen, Lena Marie Skindhøj","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Tenna Vesterman","key":"henriksentennavestermanpau","last":"Henriksen","locid":"3861b20b-cac4-4754-bb98-8ae8cca5ac57","name":"Henriksen, Tenna Vesterman","orcid":"0000-0002-8541-1735","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marie Øbo","key":"larsenmarieøbopau","last":"Larsen","name":"Larsen, Marie Øbo","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mads Heilskov","key":"rasmussenmadsheilskovpau","last":"Rasmussen","locid":"3285e14f-ef19-480d-97ff-c95d6a90b354","name":"Rasmussen, Mads Heilskov","orcid":"0000-0001-5723-6303","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Amanda Frydendahl Boll","key":"frydendahlamandapau","last":"Johansen","locid":"f36c28b3-