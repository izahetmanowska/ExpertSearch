ank":35,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Nicolai","key":"haasenicolaipau","last":"Haase","name":"Haase, Nicolai","rank":36,"rolecode":"pau"}],"pmid":["37288935"],"pub":{"doi":"10.1111/aas.14290","issn":["00015172"],"issue":"9","journal":"Acta Anaesthesiologica Scandinavica","pages":"1239-1248","publisher":"Blackwell Munksgaard","status":"p","title":"Acta Anaesthesiologica Scandinavica","volume":"67"},"review":"Peer Reviewed","scoID":["2-s2.0-85161547094"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","North Denmark Region","Other Research","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-dc1aa9f2-6f50-4853-83ad-28bb1d1c9220","au-7d1ff590-4fb4-45a0-9d19-615bdb53efcd","ku-4e400344-3f4a-4a48-a016-1486b7f1e790","sdu-4aef73d2-4d94-41fb-87da-3b3d33084801"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Long-term outcomes in COVID-19 patients admitted to intensive care in Denmark : A nationwide observational study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-096.25-715795","year":"2023","yearsub":"2023"}
{"abstract":"Tilbage i 2005 gennemførte Trafikforskningsgruppen sammen med Odense Kommune et projekt, hvor vi testede den sikkerhedsmæssige effekt af kørelys på cykel. Vi testede den sikkerhedsmæssige effekt på en, på det tidspunkt, nyudviklet magnetlygte, som konstant blinkede. Testen var tilrettelagt som et lodtrækningsstudie, hvor 4.000 cyklister fra Odense deltog – 2.000 fik monteret lygten, og 2.000 var kontrolgruppe. Testen viste signifikante resultater, idet testgruppen havde 47 % færre flerpartsulykker med personskade end kontrolgruppen. Lygterne var udviklet og stillet til rådighed af firmaet Reelight. I 2017 henvendte Jochum Kirsebom fra Reelight (www.reelight.dk) sig til Trafikforskningsgruppen med henblik på at gentage forsøget fra 2005, men nu med en ny generation af kørelys, der lyser langt kraftigere end 2005-lygterne. Efter en periode, hvor projektet blev planlagt, og der blev skaffet finansiering til Trafikforskningsgruppens deltagelse i projektet, blev projektet igangsat i 2020. Lygterne blev også denne gang stillet til rådighed af Reelight, og igen blev projektet planlagt i tæt samarbejde med Odense Kommune, mens deltagelse denne gang ikke blev begrænset til indbyggere i Odense. Trafikforskningsgruppen vil gerne takke Troels Andersen og Tanja Bruntse Andersen, begge fra Odense Kommune, for hjælpen med planlægningen af projektet. Vi vil også gerne takke Reelight for at stille lygterne til rådighed, men også for at respektere den armslænge, der nødvendigvis har måttet være mellem producenten af lygten og dem, der evaluerer lygten. Endelig vil vi gerne takke A.P. Møller Fonden og Det Nissenske Familiefond for økonomisk støtte til projektet, uden hvilken projektet ikke ville have været muligt.","author_count":8,"contributors":["Lahrmann, Harry","Christensen, Michelle Cederstrøm","Tallaksen, Anders Brogaard","Tønning, Charlotte","Larsen, Mette Kathrine","Madsen, Tanja Kidholm Osmann","Rasmussen, Line Røjkjær","Olesen, Anne Vingaard"],"cuid":["S01-000.00-064044"],"filters":{"added":"2023-03","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Sikkerhed","Trafik","Ulykker"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"nr","rtype":["clu"],"sorti":"projekt cykelliv en undersøgelse af den sikkerhedsmæssige effekt af kørelys på cykler","src":["aau"],"src-code":["DI-U-AAU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://vbn.aau.dk/ws/files/515256123/Projekt_Cykelliv.pdf","version":"Published Version"},"id":"S01-000.00-064044","ids":["aau-30579b3a-3e03-4da7-8c0a-f7b5c2ed684f"],"keyword":["Cykellygter","Sikkerhed","Trafik","Ulykker"],"lang":"Danish","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-3537B659CF4413586DC0BEA0CE7A477B"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://vbn.aau.dk/ws/files/515256123/Projekt_Cykelliv.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment, Division of Civil and Environmental Engineering","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment, Traffic Research Group","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science, CITS"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","fi