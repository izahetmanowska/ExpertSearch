rresponding":null,"first":"Nathalie Fogh","key":"rasmussenpau","last":"Rasmussen","locid":"a587221d-2713-4f5b-82ea-1f4d3f163006","name":"Rasmussen, Nathalie Fogh","orcid":"0000-0003-3315-1094","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders","key":"greenpau","last":"Green","locid":"efdbf426-9cae-4f5c-8c23-56c94fc85853","name":"Green, Anders","orcid":"0000-0002-5059-3655","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Kristine Højgaard","key":"allinpau","last":"Allin","locid":"eaf730c8-2c38-4a9c-ab42-d8a01518f4f2","name":"Allin, Kristine H.","name_org":"Allin, Kristine Højgaard","orcid":"0000-0002-6880-5759","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Aske T","key":"iversenpau","last":"Iversen","locid":"6a5a4937-2c9e-4bd9-a778-6c3a07b14043","name":"Iversen, Aske T.","name_org":"Iversen, Aske T","rank":4,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"first":"Gunvor Iben","key":"madsenpau","last":"Madsen","locid":"d2769587-82f0-42f5-8ae7-01f1b805c4de","name":"Madsen, Gunvor Iben","rank":5,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"first":"Andreas Kristian","key":"pedersenpau","last":"Pedersen","locid":"2aa75881-8923-493b-8ea0-9528b7334796","name":"Pedersen, Andreas Kristian","orcid":"0000-0001-5406-1675","rank":6,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"first":"Donna Lykke","key":"wolffpau","last":"Wolff","locid":"5bee59a2-dd58-437e-bae0-452a4f279d56","name":"Wolff, Donna Lykke","orcid":"0000-0002-9131-8991","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Tine","key":"jesspau","last":"Jess","locid":"ab65eac5-33fc-4361-882d-e595188169d3","name":"Jess, Tine","orcid":"0000-0002-4391-7332","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Vibeke","key":"andersenpau","last":"Andersen","locid":"13a7e111-7511-412b-9e1e-4c3bc8982e21","name":"Andersen, Vibeke","orcid":"0000-0002-0127-2863","rank":9,"rolecode":"pau"}],"pmid":["36028261"],"pub":{"doi":"10.1136/bmjgast-2022-000958","issn":["20544774"],"issue":"1","journal":"BMJ Open Gastroenterology","paperid":"e000958","publisher":"BMJ Group","publisher_org":"B M J Group","status":"p","title":"BMJ Open Gastroenterology","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-85137919562"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-d31d7ee5-ec5f-44f2-9d08-46351ca4b9c8","sdu-21cf6eb5-1d8f-46ab-bf31-0f89a540e66e"],"src":["AAU Aalborg University","SDU University of Southern Denmark"],"title":"Clinical procedures used to diagnose inflammatory bowel disease : real-world evidence from a Danish nationwide population-based study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.94-010111","year":"2022","yearsub":"2022"}
{"abstract":"Background: Supplemental oxygen is the key intervention for severe and critical COVID-19 patients. With the unstable supplies of oxygen in many countries, it is important to define the lowest safe dosage. Methods: In spring 2020, 110 COVID-19 patients were enrolled as part of the Handling Oxygenation Targets in the ICU trial (HOT-ICU). Patients were allocated within 12 h of ICU admission. Oxygen therapy was titrated to a partial pressure of arterial oxygen (PaO2) of 8 kPa (lower oxygenation group) or a PaO2 of 12 kPa (higher oxygenation group) during ICU stay up to 90 days. We report key outcomes at 90 days for the subgroup of COVID-19 patients. Results: At 90 days, 22 of 54 patients (40.7%) in the lower oxygenation group and 23 of 55 patients (41.8%) in the higher oxygenation group had died (adjusted risk ratio: 0.87; 95% confidence interval, 0.58–1.32). The percentage of days alive without life support was significantly higher in the lower oxygenation group (p = 0.03). The numbers of severe ischemic events were low with no difference between the two groups. Proning and inhaled vasodilators were used more frequently, and the positive end-expiratory pressure was higher in the higher oxygenation group. Tests for interactions with the results of the remaining HOT-ICU population were insignificant. Conclusions: Targeting a PaO2 of 8 kPa may be beneficial in ICU patients with COVID-19. These results come with uncertainty due to the low number of patients in this unplanned subgroup analysis, and insignificant tests for interaction with the main HOT-ICU trial. Trial registration number: ClinicalTrials.gov number, NCT03174002. Date of registration: June 2, 2017.","author_count":27,"contributors":["Rasmussen, Bodil Steen","Lass Klitgaard, Thomas","Perner, Anders","Brandt, Björn Anders","Hildebrandt, Thomas","Siegemund, Martin","Hollinger, Alexa","Aagaard, Søren Rosborg","Heiberg Bestle, Morten","Marcussen, Klaus Vennick","Craveiro Brøchner, Anne","Sølling, Christoffer Grant","Musaeus Poulsen, Lone","Laake, Jon Henrik","Aslam, Tayyba Naz","Bäcklund, Minna","Okkonen, Marjatta","Morgan, Matthew","Sharman, Mike","Lange, Theis","Wetterslev, Jørn","Schjørring, Olav Lilleholt"],"cuid":["S04-089.96-665954"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Rasmussen, Bodil S.","Rasmussen, Bodil Steen"],"country":["Finland","Norway","Switzerland","United Kingdom"],"glorg":["All Global Affiliations","Cardiff University","Helsinki University Hospital","Manchester Royal Infirmary","Manchester University NHS Foundation Trust","Oslo University Hospital","University Hospital Basel","University Hospital Wales","University Hospital of Basel","University Hospital of Wales","University of Basel","University of Helsinki","University of Oslo"],"keyword":["Covid 19","Humans","Intensive Care Units","Lung","Oxygen Inhalation Therapy","Randomised controlled trial","Randomized Controlled Trial","Respiration Artificial","Respiratory Insufficiency","SARS CoV 2","Severe acute respiratory syndrome coronavirus 2"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-SDR","DI-HO-ZEA"],"OT":["Unspecified organisation"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"oxygenation targets in icu patients with covid 000000000019 a post hoc sub group analysis of the hot icu trial","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1111/aas.13977","version":"Published Ve