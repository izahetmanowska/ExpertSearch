"]},"sid":["ku-bef90b48-b744-42d5-9c77-4f24d028156b","sdu-ac766afc-5180-47b8-b890-68a33202fe2a"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Effects of letrozole therapy in former users of anabolic steroids : A randomized clinical trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-088.68-785502","year":"2025","yearsub":"2025"}
{"abstract":"Four novel nontuberculous mycobacteria were discovered from a historical strain collection at the International Reference Laboratory of Mycobacteriology at Statens Serum Institut in Copenhagen, Denmark. Phylogenetic analysis combining the 16S rrs, internal transcribed spacer and 23S rrl elements, as well as a single-copy core-gene (hsp65, rpoB+C, secA and tuf) analysis of these freeze-dried mycobacteria, clinically isolated from gastric lavage samples between 1948 and 1955, showed to be associated with type strains grouping within the Terra and Fortuitum-Vaccae clade. Phenotypic characteristics, biochemical properties and fatty acid and mycolic acid profiles supported the classification as novel strains. A genomic comparison to the closest related type strain was done by calculating average nucleotide identity and in silico DNA:DNA hybridization values, which showed 87.9% and 33.0% for Mu0050, 85.2% and 27.4% for Mu0053, 85.3% and 27.6% for Mu0083 and 93.3% and 50.1% for Mu0102, respectively. The names proposed for the new species are Mycobacterium wendilense sp. nov. (Mu0050T=ITM 501390T=CCUG 77525T), Mycobacterium burgundiense sp. nov. (Mu0053T=ITM 501391T=CCUG 77526T), Mycobacterium kokjensenii sp. nov. (Mu0083T=ITM 501392T=CCUG 77527T) and Mycobacterium holstebronense sp. nov. (Mu0102T=ITM 501393T=CCUG 77528T).","author_count":8,"contributors":["Iversen, Xenia Emilie Sinding","Rasmussen, Erik Michael","Folkvardsen, Dorte Bek","Svensson, Erik","Meehan, Conor J","Jørgensen, René","Norman, Anders","Lillebaek, Troels"],"cuid":["S02-088.68-793656"],"filters":{"added":"2025-04","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","Nottingham Trent University"],"keyword":["Bacterial Typing Techniques","DNA Bacterial genetics","Denmark","Fatty acids","Humans","Mycobacterium Infections Nontuberculous microbiology","Mycobacterium burgundiense sp nov","Mycobacterium holstebronense sp nov","Mycobacterium kokjensenii sp nov","Mycobacterium wendilense sp nov","Nontuberculous mycobacteria","Novel species","Nucleic Acid Hybridization","Phylogeny","RNA Ribosomal 16S genetics","Sequence Analysis DNA","Taxonomic description"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"U":["DI-U-ALL","DI-U-KU","DI-U-RUC"]},"level3all":["DI-GV-SSI","DI-U-KU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"four novel nontuberculous mycobacteria species i mycobacterium wendilense i sp nov i mycobacterium burgundiense i sp nov i mycobacterium kokjensenii i sp nov and i mycobacterium holstebronense i sp nov revived from a historical danish strain collection","src":["ku","ruc"],"src-code":["DI-U-KU","DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1099/ijsem.0.006620","version":"Published Version"},"id":"S02-088.68-793656","identifier":[{"id":"85215073447","type":"scopus"},{"id":"PMC11706282","type":"pmcid"},{"id":"39773688","type":"pmid"}],"ids":["ku-0a52f385-35cf-4ec6-9ca3-6281dd39ebd1","ruc-7948c7ca-b45b-4db1-b007-4c7e726b8af9"],"keyword":["Bacterial Typing Techniques","DNA, Bacterial/genetics","DNA, Ribosomal Spacer/genetics","Denmark","Fatty Acids","Humans","Mycobacterium Infections, Nontuberculous/microbiology","Mycobacterium burgundiense sp. nov","Mycobacterium holstebronense sp. nov","Mycobacterium kokjensenii sp. nov","Mycobacterium wendilense sp. nov","Mycolic Acids/analysis","Nontuberculous Mycobacteria/genetics","Nontuberculous mycobacteria","Novel species","Nucleic Acid Hybridization","Phylogeny","RNA, Ribosomal, 16S/genetics","Sequence Analysis, DNA","Taxonomic description"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-F6E08CED123A3D8541C14BEE92A431C4"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/417146568/ijsem006620.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1099/ijsem.0.006620","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/108691846/ijsem006620.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"ssi statens serum institut","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-SSI","l3nn":"SSI Statens Serum Institut","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SSI Statens Serum Institut","namevar":["Statens Serum Institut"],"nora_code":"DI-GV-SSI","used":1},{"affno":"2","country":"gb","key":"nottingham trent university","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Nottingham Trent University","used":1},{"affno":"3","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of Science and Environment","Roskilde University, Department of Science and Environment, Molecular and Medical Biology"],"nora_code":"DI-U-RUC","used":1},{"affno":"4","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Global Health Section"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Xenia Emilie Sinding","key":"iversenpau","last":"Iversen","name":"Iversen, Xenia Emilie Sinding","rank":1,"rolecode":"pau"},{"affno":"1","first":"Erik Michael","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Erik Michael","rank":2,"rolecode":"pau"},{"affno":"1","first":"Dorte Bek","key":"folkvardsenpau","last":"Folkvardsen","name":"Folkvardsen, Dorte Bek","rank":3,"rolecode":"pau"},{"affno":"1","first":"Erik","key":"svenssonpau","last":"Svensson","name":"Svensson, Erik","rank":4,"rolecode":"pau"},{"affno":"2","first":"Conor J","key":"meehanpau","last":"Meehan","name":"Meehan, Conor J","rank":5,"rolecode":"pau"},{"affno":"3","country":"dk","first":"René","key":"jørgensenpau","last":"Jørgensen","locid":"72cbaf6e-0946-42e0-a94a-99acf2b18f69","name":"Jørgensen, René","orcid":"0000-0003-0672-466X","rank":6,"rolecode":"pau"},{"affno":"1","first":"Anders","key":"normanpau","last":"Norman","name":"Norman, Anders","rank":7,"rolecode":"pau"},{"affno":"1 4","first":"Troels","key":"lillebaekpau","last":"Lillebaek","locid":"4c4e219b-6ac0-4067-a078-ef52b9c2beff","name":"Lillebaek, Troels","orcid":"0000-0002-2601-2718","rank":8,"rolecode":"pau"}],"pmid":["39773688"],"pub":{"doi":"10.1099/ijsem.0.006620","issn":["10706259","14665026"],"issn_org":["14665026"],"issue":"1","journal":"International Journal of Systematic and Evolutionary Microbiology","paperid":"006620","status":"p","title":"International Journal of Systematic and Evolutionary Microbiology","volume":"75"},"review":"Peer Reviewed","scoID":["2-s2.0-85215073447"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Roskilde University","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-0a52f385-35cf-4ec6-9ca3-6281dd39ebd1","ruc-7948c7ca-b45b-4db1-b007-4c7e726b8af9"],"src":["KU University of Copenhagen","RUC Roskilde University"],"title":"Four novel nontuberculous mycobacteria species : <i>Mycobacterium wendilense</i> sp. nov., <i>Mycobacterium burgundiense</i> sp. nov., <i>Mycobacterium kokjensenii</i> sp. nov. and <i>Mycobacterium holstebronense</i> sp. nov. revived from a historical Danish strain collection","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-088.68-793656","year":"2025","yearsub":"2025"}
{"abstract":"Objectives The childcare sector faces several challenges such as high rates of sick leave, employee turnover, and pain. We know that the physical behaviours the workers do at work are important for their musculoskeletal health and sick leave. However, we lack knowledge of which workplace factors determine the physical behaviours of workers. Therefore, we aimed to investigate which organisational levels and factors of Danish day nurseries determine the physical behaviours at work of childcare workers. Methods This cross-sectional study included 178 childcare workers from 73 teams and 16 day nurseries in Denmark. Workers were, on average, 36.5 years of age, mostly female (84%) and 57% were educated pedagogues. We measured physical behaviours (i.e. sedentary, light physical activity, and moderate-to-vigorous physical activity) during working hours using a thigh-worn accelerometer, and expressed them as isometric log-ratio coordinates for analysis according to compositional data analysis procedures. We examined 15 potential determinants of physical behaviours at work at three organisational levels: institutions (e.g. permanent-to-not-permanent staff ratio), teams (e.g. worker-to-child ratio), and workers (e.g. age, BMI, physical exertion). Variance component analysis identified the percentage contribution to the total variance of physical behaviours of each organisational level. Linear mixed models were used to investigate associations between determinants at each level and the physical behaviours. Results The largest contribution to the total variance in childcare workers' physical behaviours was observed at the worker level (95.5%), while team (2%) and institution (2.5%) levels contributed to only a minor extent. Two individual factors at the worker level - physical exertion (P < 0.01) and pain intensity (P = 0.01) - were significantly, but weakly associated with physical behaviours. Specifically, an increased physical exertion was associated with a 3.7% increase in moderate-to-vigorous physical activity (P = 0.019) and a 6% decrease in sedentary behaviour (P = 0.009), relative to the remaining behaviours. Also, an increased pain intensity was associated with a 3.6% decrease in moderate-to-vigorous physical activity (P = 0.008), relative to the remaining behaviours. No determinants at the institution and team levels were significantly associated with physical behaviours. Conclusions In this study, worker level determines nearly all of the variability in physical behaviours while the institution and team levels only explain a little. That only two individual worker-level factors were weakly associated with physical behaviours indicates that other unmeasured worker-level factors are important determinants of the physical behaviours of childcare workers.","author_count":7,"contributors":["Wester, Christian Tolstrup","Brusaca, Luiz Augusto","Palarea-Albaladejo, Javier","Kyriakidis, Stavros","Frost, Anders Dreyer","Holtermann, Andreas","Rasmussen, Charlotte Diana Nørregaard"],"cuid":["S02-099.32-814126"],"filters":{"added":"2025-06","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["America, South","Europe, EU","OECD"],"corresponding_author":["Wester, Christian Tolstrup"],"country":["Brazil","Spain"],"glorg":["All Global Affiliations","Federal University of São Carlos","Universidade Federal de São Carlos","University of Girona"],"keyword":["Accelerometry","Adult","Child Day Care Centers","Childcare","Compositional data","Cross Sectional Studies","Denmark","Exercise","Female","Fysisk aktivitet","Humans","Male","Middle Aged","Organisation","Pædagoger","Sedentary Behavior","Stillesiddende arbejde","Vuggestuepædagoger","Vuggestuer","Workplace","organisational determinants","physical behaviours"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-WORK"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-GV-WORK","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"what determines childcare workers physical behaviours at work an investigation of determinants at the institution team and worker levels in danish day nurseries","src":["nfa","sdu"],"src-code":["DI-GV-WORK","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1093/annweh/wxaf016","version":"Published Version"},"funding_acknowledgement":["This research was funded by the Danish Work Environment Research Fund (project number: 74102). JPA was partly supported by the Spanish Ministry of Science and Innovation (MCIN/AEI/10.13039/501100011033) and European Regional Development Fund (Grant PID2021-123833OB-I00) and the Generalitat de Catalunya (Grant Number 2021SGR01197). LAB was supported with a PhD scholarship from the São Paulo Research Foundation (FAPESP; grant numbers 2019/25140-6 and 2023/01672-4)."],"id":"S02-099.32-814126","identifier":[{"id":"105009578588","type":"scopus"},{"id":"40357710","type":"pmid"},{"id":"PMC12208360","type":"pmcid"}],"ids":["nfa-e2a69e74-33d3-49ab-a7a8-19845b6503a6","sdu-def79930-7c0b-48ac-a47c-519423c790ab"],"keyword":["Adult","Child Day Care Centers","Cross-Sectional Studies","Denmark","Exercise","Female","Fysisk aktivitet","Humans","Male","Middle Aged","Organisation","Pædagoger","Sedentary Behavior","Stillesiddende arbejde","Vuggestuepædagoger","Vuggestuer","Workplace","accelerometry","childcare","compositional data","organisational determinants","physical behaviours"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-9EC4C556E4F6944BAF8A6E37E34FA5DB"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/292989668/wxaf016.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1093/annweh/wxaf016","version":"Published Version"}],"org":[{"affno":"1","key":"nfa national research centre for the working environment","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-WORK","l3nn":"NFA National Research Centre for the Working Environment","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"NFA National Research Centre for the Working Environment","namevar":["The National Research Centre for the Working Environment","The National Research Centre for the Working Environment, Directors, Musculoskeletal Disorders and Physical Workload"],"nora_code":"DI-GV-WORK","used":1},{"affno":"2","country":"br","key":"universidade federal de são carlos","loc":["Brazil","America, South"],"name":"Universidade Federal de São Carlos","used":1},{"affno":"3","country":"es","key":"university of girona","loc":["Spain","Europe, EU","OECD"],"name":"University of Girona","used":1},{"affno":"4","country":"dk","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["University of Southern Denmark"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Christian Tolstrup","key":"westerpau","last":"Wester","locid":"c6eadf35-e668-4b28-b196-54c960531585","name":"Wester, Christian Tolstrup","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Luiz Augusto","key":"brusacapau","last":"Brusaca","locid":"3b5fe3e2-aa38-4bf8-8e39-2677e2b6aa9d","name":"Brusaca, Luiz Augusto","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Javier","key":"palareaalbaladejopau","last":"Palarea-Albaladejo","name":"Palarea-Albaladejo, Javier","rank":3,"rolecode":"pau"},{"affno":"1 4","corresponding":null,"first":"Stavros","key":"kyriakidispau","last":"Kyriakidis","locid":"665a4636-fc27-43cf-99e3-e143767eb410","name":"Kyriakidis, Stavros","orcid":"0000-0002-3181-8871","rank":4,"rolecode":"pau"},{"affno":"1 4","corresponding":null,"first":"Anders Dreyer","key":"frostpau","last":"Frost","locid":"bab16b2f-2e20-47b6-b77e-b10e8bdd97ba","name":"Frost, Anders Dreyer","orcid":"0009-0006-1093-4984","rank":5,"rolecode":"pau"},{"affno":"4 1","corresponding":null,"first":"Andreas","key":"holtermannpau","last":"Holtermann","locid":"fd559bce-74b0-4973-a2d9-dd622af8b0c8","name":"Holtermann, Andreas","orcid":"0000-0003-4825-5697","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Charlotte Diana Norregaard","key":"rasmussenpau","last":"Rasmussen","locid":"180d2a5d-fe8e-4956-b192-48aed7083301","name":"Rasmussen, Charlotte Diana Nørregaard","name_org":"Rasmussen, Charlotte Diana Norregaard","orcid":"0000-0002-1769-717X","rank":7,"rolecode":"pau"}],"pmid":["40357710"],"pub":{"doi":"10.1093/annweh/wxaf016","issn":["23987308","23987316"],"issn_org":["23987308"],"issue":"5","journal":"Annals of Work Exposures and Health","pages":"520-530","publisher":"Oxford University Press","status":"p","title":"Annals of Work Exposures and Health","volume":"69"},"review":"Peer Reviewed","scoID":["2-s2.0-105009578588"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["nfa-e2a69e74-33d3-49ab-a7a8-19845b6503a6","sdu-def79930-7c0b-48ac-a47c-519423c790ab"],"src":["NFA National Research Centre for the Working Environment","SDU University of Southern Denmark"],"title":"What determines childcare workers physical behaviours at work? An investigation of determinants at the institution, team, and worker levels in Danish day nurseries","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.32-814126","year":"2025","yearsub":"2025"}
{"abstract":"Despite the high prevalence of neurodevelopmental disorders, the influence of maternal diet during pregnancy on child neurodevelopment remains understudied. Here we show that a western dietary pattern during pregnancy is associated with child neurodevelopmental disorders. We analyse self-reported maternal dietary patterns at 24 weeks of pregnancy and clinically evaluated neurodevelopmental disorders at 10 years of age in the COPSAC2010 cohort (n = 508). We find significant associations with attention-deficit hyperactivity disorder (ADHD) and autism diagnoses. We validate the ADHD findings in three large, independent mother-child cohorts (n = 59,725, n = 656 and n = 348) through self-reported dietary modelling, maternal blood metabolomics and foetal blood metabolomics. Metabolome analyses identify 15 mediating metabolites in pregnancy that improve ADHD prediction. Longitudinal blood metabolome analyses, incorporating five time points per cohort in two independent cohorts, reveal that associations between western dietary pattern metabolite scores and neurodevelopmental outcomes are consistently significant in early-mid-pregnancy. These findings highlight the potential for targeted prenatal dietary interventions to prevent neurodevelopmental disorders and emphasise the importance of early intervention.","author_count":29,"contributors":["Horner, David","Jepsen, Jens Richardt M","Chawes, Bo","Aagaard, Kristina","Rosenberg, Julie B.","Mohammadzadeh, Parisa","Sevelsted, Astrid","Vahman, Nilo","Vinding, Rebecca","Fagerlund, Birgitte","Pantelis, Christos","Bilenberg, Niels","Pedersen, Casper-Emil T","Eliasen, Anders","Brandt, Sarah","Chen, Yulu","Prince, Nicole","Chu, Su H","Kelly, Rachel S","Lasky-Su, Jessica","Halldorsson, Thorhallur I.","Strøm, Marin","Strandberg-Larsen, Katrine","Olsen, Sjurdur Frodi","Glenthøj, Birte","Bønnelykke, Klaus","Ebdrup, Bjørn H.","Stokholm, Jakob","Rasmussen, Morten Arendt"],"cuid":["S02-100.00-804556"],"filters":{"added":"2025-0