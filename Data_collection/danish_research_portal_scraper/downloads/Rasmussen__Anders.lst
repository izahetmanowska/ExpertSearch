","locid":"0a3c43a0-a0c5-4a91-85d6-6e80e16af8b5","name":"Kehlet, Henrik","orcid":"0000-0002-2209-1711","rank":2,"rolecode":"pau"},{"affno":"2","first":"Kirill","key":"gromovpau","last":"Gromov","locid":"efb84811-45bd-4724-97f5-e10d5b84525f","name":"Gromov, Kirill","rank":3,"rolecode":"pau"},{"affno":"2","first":"Anders","key":"troelsenpau","last":"Troelsen","locid":"49cb6bcf-2ff6-41af-a356-a2a09c2ce7ba","name":"Troelsen, Anders","orcid":"0000-0003-0132-8182","rank":4,"rolecode":"pau"},{"affno":"1","first":"Henrik","key":"hustedpau","last":"Husted","name":"Husted, Henrik","rank":5,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Claus","key":"varnumpau","last":"Varnum","locid":"0f639544-4ebc-467c-a15b-3c049a26f62f","name":"Varnum, Claus","orcid":"0000-0002-0625-5691","rank":6,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"country":"dk","first":"Per","key":"kjærsgaardandersenpau","last":"Kjærsgaard-Andersen","locid":"9d7006f6-37d8-43c1-a108-2705353942f6","name":"Kjærsgaard-Andersen, Per","orcid":"0000-0001-6845-4218","rank":7,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Lasse E.","key":"rasmussenpau","last":"Rasmussen","locid":"ada7d12e-e6cc-4568-b072-91b059d28c72","name":"Rasmussen, Lasse Enkebølle","name_org":"Rasmussen, Lasse E.","rank":8,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Lina","key":"pleckaitienepau","last":"Pleckaitiene","locid":"806dda50-3350-49fd-8060-2bf36188d853","name":"Pleckaitiene, Lina","rank":9,"rolecode":"pau"},{"affno":"2","first":"Nicolai B.","key":"fosspau","last":"Foss","locid":"dc8c28e3-27ee-4329-8985-2b176ab69b4b","name":"Foss, Nicolai Bang","name_org":"Foss, Nicolai B.","rank":10,"rolecode":"pau"}],"pmid":["34749994"],"pub":{"doi":"10.1016/j.bja.2021.10.001","issn":["00070912","14716771"],"issn_org":["00070912"],"issue":"1","journal":"British Journal of Anaesthesia","pages":"150-158","publisher":"Elsevier","status":"p","title":"British Journal of Anaesthesia","volume":"128"},"review":"Peer Reviewed","scoID":["2-s2.0-85118930006"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-70981fdb-0e5d-4ab6-9b47-f0b4cf6e3b58","sdu-58c96eff-89c5-44b6-aa6f-e9cf1250af42"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"High-dose steroids in high pain responders undergoing total knee arthroplasty : a randomised double-blind trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-043382","year":"2022","yearsub":"2022"}
{"abstract":"Background: Optimal oxygen targets in patients resuscitated after cardiac arrest are uncertain. The primary aim of this study was to describe the values of partial pressure of oxygen values (PaO2) and the episodes of hypoxemia and hyperoxemia occurring within the first 72 h of mechanical ventilation in out of hospital cardiac arrest (OHCA) patients. The secondary aim was to evaluate the association of PaO2 with patients’ outcome. Methods: Preplanned secondary analysis of the targeted hypothermia versus targeted normothermia after OHCA (TTM2) trial. Arterial blood gases values were collected from randomization every 4 h for the first 32 h, and then, every 8 h until day 3. Hypoxemia was defined as PaO2 < 60 mmHg and severe hyperoxemia as PaO2 > 300 mmHg. Mortality and poor neurological outcome (defined according to modified Rankin scale) were collected at 6 months. Results: 1418 patients were included in the analysis. The mean age was 64 ± 14 years, and 292 patients (20.6%) were female. 24.9% of patients had at least one episode of hypoxemia, and 7.6% of patients had at least one episode of severe hyperoxemia. Both hypoxemia and hyperoxemia were independently associated with 6-month mortality, but not with poor neurological outcome. The best cutoff point associated with 6-month mortality for hypoxemia was 69 mmHg (Risk Ratio, RR = 1.009, 95% CI 0.93–1.09), and for hyperoxemia was 195 mmHg (RR = 1.006, 95% CI 0.95–1.06). The time exposure, i.e., the area under the curve (PaO2-AUC), for hyperoxemia was significantly associated with mortality (p = 0.003). Conclusions: In OHCA patients, both hypoxemia and hyperoxemia are associated with 6-months mortality, with an effect mediated by the timing exposure to high values of oxygen. Precise titration of oxygen levels should be considered in this group of patients. Trial registration: clinicaltrials.gov NCT02908308, Registered September 20, 2016.","author_count":50,"contributors":["Robba, Chiara","Badenes, Rafael","Battaglini, Denise","Ball, Lorenzo","Sanfilippo, Filippo","Brunetti, Iole","Jakobsen, Janus Christian","Lilja, Gisela","Friberg, Hans","Wendel-Garcia, Pedro David","Young, Paul J.","Eastwood, Glenn","Chew, Michelle S.","Unden, Johan","Thomas, Matthew","Joannidis, Michael","Nichol, Alistair","Lundin, Andreas","Hollenberg, Jacob","Hammond, Naomi","Saxena, Manoj","Martin, Annborn","Solar, Miroslav","Taccone, Fabio Silvio","Dankiewicz, Josef","Nielsen, Niklas","Grejs, Anders Morten","Ebner, Florian","Pelosi, Paolo","Bělohlávek, Jan","Callaway, Clifton","Cariou, Alain","Cronberg, Tobias","Erlinge, David","Hovdenes, Jan","Kirkegaard, Hans","Levin, Helena","Morgan, Matt P.G.","Nordberg, Per","Oddo, Mauro","Rylander, Christian","Storm, Christian","Ullén, Susann","Wise, Matt P.","Rowan, Kathy","Lange, Theis","Li, Yang","Pilowsky, Julia","Jacobsen, Simon","Rasmussen, Åse"],"cuid":["S03-091.99-755953"],"filters":{"added":"2022-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD","Oceania"],"corpau":["TTM2 Trial collaborators"],"corresponding_author":["Robba, Chiara"],"country":["Australia","Austria","Belgium","Czechia","Italy","New Zealand","Spain","Sweden","Switzerland","United Kingdom"],"glorg":["A.O.U. “Policlinico-San Marco”","All Global Affiliations","Austin Hospital","Azienda Ospedaliero-Universitaria policlinico - Vittorio Emanuele","Capital & Coast District Health Board","Charles University","Erasme University Hospital ULB","Free University of Brussels","Hospital Clinico Universitario de Valencia","IRCCS Azienda Ospedaliera Universitaria San Martino IST","IRCCS Azienda Ospedaliera Universitaria San Martino IST - Istituto Nazionale per la Ricerca sul Cancro","Innsbruck Medical University","Karolinska Institute","Karolinska Institutet","Linköping University","Lund University","Medical Research Institute of New Zealand","Medical University of Innsbruck","Monash Univer