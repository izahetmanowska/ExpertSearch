om","orcid":"0000-0001-5715-6901","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Naveed","key":"urrehmanpau","last":"Ur Rehman","locid":"8c3547a5-d8d3-40c4-868b-a3c61f5e3009","name":"Rehman, Naveed Ur","name_org":"Ur Rehman, Naveed","orcid":"0000-0002-3700-5839","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anders","key":"rosendalkorshoejpau","last":"Rosendal Korshoej","locid":"09d94078-676a-42ee-91c2-eb8ba8df356b","name":"Korshoej, Anders Rosendal","name_org":"Rosendal Korshoej, Anders","orcid":"0000-0003-4285-8171","rank":10,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Anders Rosendal","key":"korshoejpau","last":"Korshoej","name":"Korshoej, Anders Rosendal","rank":10,"rolecode":"pau"}],"pmid":["38626156"],"pub":{"doi":"10.1371/journal.pone.0297131","issn":["19326203"],"issue":"4 April","journal":"PLOS ONE","paperid":"e0297131","publisher":"Public Library of Science","status":"p","title":"PLOS ONE","volume":"19"},"review":"Peer Reviewed","scoID":["2-s2.0-85190737620"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-dced008e-8429-4138-9cd1-6e2003c59f17","sdu-c33389f9-a55e-42ca-8e1c-a03b81605e98"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Reliability and performance of the IRRAflow® system for intracranial lavage and evacuation of hematomas-A technical note","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-098.67-735336","year":"2024","yearsub":"2024"}
{"abstract":"Genomic studies of species threatened by extinction are providing crucial information about evolutionary mechanisms and genetic consequences of population declines and bottlenecks. However, to understand how species avoid the extinction vortex, insights can be drawn by studying species that thrive despite past declines. Here, we studied the population genomics of the muskox (Ovibos moschatus), an Ice Age relict that was at the brink of extinction for thousands of years at the end of the Pleistocene yet appears to be thriving today. We analysed 108 whole genomes, including present-day individuals representing the current native range of both muskox subspecies, the white-faced and the barren-ground muskox (O. moschatus wardi and O. moschatus moschatus) and a ~21,000-year-old ancient individual from Siberia. We found that the muskox' demographic history was profoundly shaped by past climate changes and post-glacial re-colonizations. In particular, the white-faced muskox has the lowest genome-wide heterozygosity recorded in an ungulate. Yet, there is no evidence of inbreeding depression in native muskox populations. We hypothesize that this can be explained by the effect of long-term gradual population declines that allowed for purging of strongly deleterious mutations. This study provides insights into how species with a history of population bottlenecks, small population sizes and low genetic diversity survive against all odds.","author_count":31,"contributors":["Pečnerová, Patrícia","Lord, Edana","Garcia-Erill, Genís","Hanghøj, Kristian","Rasmussen, Malthe Sebro","Meisner, Jonas","Liu, Xiaodong","van der Valk, Tom","Santander, Cindy G.","Quinn, Liam","Lin, Long","Liu, Shanlin","Carøe, Christian","Dalerum, Fredrik","Götherström, Anders","Måsviken, Johannes","Vartanyan, Sergey","Raundrup, Katrine","Al-Chaer, Amal","Rasmussen, Linett","Hvilsom, Christina","Heide-Jørgensen, Mads Peter","Sinding, Mikkel Holger S.","Aastrup, Peter","Van Coeverden de Groot, Peter J.","Schmidt, Niels Martin","Albrechtsen, Anders","Dalén, Love","Heller, Rasmus","Moltke, Ida","Siegismund, Hans Redlef"],"cuid":["S02-100.00-742017"],"filters":{"added":"2024-02","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Africa","America, North","Asia, East","Europe, EU","Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Pečnerová, Patrícia","Siegismund, Hans Redlef"],"country":["Canada","China","Greenland","Russia","South Africa","Spain","Sweden"],"glorg":["All Global Affiliations","Centre for Palaeogenetics","China Agricultural University","Greenland Institute of Natural Resources","Instituto Mixto de Investigación en Biodiversidad","Queen's University Kingston","RAS - North-East Interdisciplinary Scientific Research Institute, Far Eastern Branch","Russian Academy of Sciences","Stockholm University","Swedish Museum of Natural History","The Centre for Palaeogenetics","University of Pretoria"],"keyword":["Ancient DNA","Genetic Load","Genetic diversity","Inbreeding","Muskox","Population genomics"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-ZEA"],"OT":["Copenhagen Zoo"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-HO-ZEA","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"population genomics of the muskox resilience in the near absence of genetic variation","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85176923803","version":"Other Version"},"id":"S02-100.00-742017","identifier":[{"id":"37971141","type":"pmid"},{"id":"85176923803","type":"scopus"}],"ids":["au-b7ce4b55-54e5-4b24-a20e-98d6c2a603fd","ku-53fd9f10-5cf8-4754-99fd-734455e90975"],"keyword":["ancient DNA","genetic diversity","genetic load","inbreeding","muskox","populat