DR","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Olav L","key":"schjørringpau","last":"Schjørring","locid":"7dac619e-9b5c-46ac-9170-10ac13165da5","name":"Schjørring, Olav Lilleholt","name_org":"Schjørring, Olav L","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thomas L","key":"klitgaardpau","last":"Klitgaard","locid":"f3e0e4b8-0772-4f4f-8be2-b99763b3917c","name":"Lass Klitgaard, Thomas","name_org":"Klitgaard, Thomas L","orcid":"0000-0002-8781-1206","rank":2,"rolecode":"pau"},{"affno":"3 4","first":"Anders","key":"pernerpau","last":"Perner","locid":"8a389541-d529-4ee3-8364-66bfc85f77c9","name":"Perner, Anders","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Jørn","key":"wetterslevpau","last":"Wetterslev","name":"Wetterslev, Jørn","rank":4,"rolecode":"pau"},{"affno":"3 2","first":"Theis","key":"langepau","last":"Lange","locid":"e4664578-01fc-4a93-8efd-1dbffb72cdd6","name":"Lange, Theis","orcid":"0000-0001-6807-8347","rank":5,"rolecode":"pau"},{"affno":"5 6","corresponding":null,"first":"Frederik","key":"keuspau","last":"Keus","name":"Keus, Frederik","rank":6,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Jon H","key":"laakepau","last":"Laake","name":"Laake, Jon H","rank":7,"rolecode":"pau"},{"affno":"8 9","corresponding":null,"first":"Matthew","key":"morganpau","last":"Morgan","name":"Morgan, Matthew","rank":8,"rolecode":"pau"},{"affno":"10 11","corresponding":null,"first":"Minna","key":"bäcklundpau","last":"Bäcklund","name":"Bäcklund, Minna","rank":9,"rolecode":"pau"},{"affno":"12 13","corresponding":null,"first":"Martin","key":"siegemundpau","last":"Siegemund","name":"Siegemund, Martin","rank":10,"rolecode":"pau"},{"affno":"14","corresponding":null,"first":"Katrin M","key":"thormarpau","last":"Thormar","name":"Thormar, Katrin M","rank":11,"rolecode":"pau"},{"affno":"1 2 15","corresponding":null,"country":"dk","first":"Bodil S","key":"rasmussenpau","last":"Rasmussen","locid":"3162c449-94c3-4d28-8dbb-c134d6eb76e1","name":"Rasmussen, Bodil Steen","name_org":"Rasmussen, Bodil S","orcid":"0000-0003-2190-145X","rank":12,"rolecode":"pau"}],"pmid":["32068884"],"pub":{"doi":"10.1111/aas.13569","issn":["00015172"],"issue":"6","journal":"Acta Anaesthesiologica Scandinavica","pages":"847-856","publisher":"Blackwell Munksgaard","status":"p","title":"Acta Anaesthesiologica Scandinavica","volume":"64"},"review":"Peer Reviewed","scoID":["2-s2.0-85082314024"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Other Hospitals","Undetermined","Universities","University of Copenhagen","collaboration for research in intensive care"],"PST":["Published"]},"sid":["aau-89d835f0-100d-4514-863a-b81bcf190619","ku-514cccda-ffda-46bc-a6d0-ca777e645705"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"The handling oxygenation targets in the intensive care unit (HOT-ICU) trial : Detailed statistical analysis plan","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-088.89-006677","year":"2020","yearsub":"2020"}
{"abstract":"Background: Supplemental oxygen therapy is commonly required for respiratory failure requiring mechanical ventilation in the ICU. However, hyperoxaemia may be injurious and may increase mortality. We evaluated the relationship amongst the degree of hyperoxaemia and changes in fraction of inspired oxygen (FIO2) in response to hyperoxaemia, as well as associations with mortality in mechanically ventilated ICU patients. Methods: We retrospectively identified all invasively mechanically ventilated patients admitted to five ICUs, and retrieved all oxygen tension (PaO2) and FIO2 data. We assessed the time between arterial blood gas (ABG) samples, proportions of patients with hyperoxaemia, and changes in FIO2 when hyperoxaemia was present. The primary outcome was the association between PaO2 (assessed by mechanically ventilated exposure-time-divided area under the curve [AUC]) and mortality (in-ICU and post-ICU discharge) using a multistate illness–death model with transition intensities estimated by Cox proportional hazards models. Results: We assessed 177 769 ABG analyses obtained from 4998 patients between January 2012 and June 2016. The median time between ABGs was 3 h (inter-quartile range: 2–4 h); the median PaO2 was 11.3 kPa (9.8–13.6 kPa), and FIO2 was 0.40 (0.35–0.50). Hyperoxaemia (PaO2 >13.7 kPa) was present in 23.9% of the ABGs, and hyperoxaemia seemed to be disregarded when FIO2 was <0.40, as >50% of these FIO2 values were not subsequently reduced. AUC PaO2 >16.0 kPa was associated with increased ICU mortality (adjusted hazard ratio: 1.75; 95% confidence interval: 1.28–2.40). Conclusions: In mechanically ventilated ICU patients, hyperoxaemia was common. Although oxygen supplementation was often reduced when hyperoxaemia was observed, several patients remained hyperoxaemic. Hyperoxaemia was associated with increased ICU mortality in these patients.","author_count":9,"contributors":["Schjørring, Olav Lilleholt","Jensen, Aksel K.G.","Nielsen, Claus Gyrup","Ciubotariu, Andrei","Perner, Anders","Wetterslev, Jørn","Lange, Theis","Rasmussen, Bodil Steen"],"cuid":["S02-095.96-008882"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Hyperoxia","Intensive care unit","Mechanical ventilation","Mortality","Observational Study","Oxygen Inhalation Therapy","Respiratory failure"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-NDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-NDR","DI-U-AAU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"arterial oxygen tensions in mechanically ventilated icu patients and mortality a retrospective multicentre observational cohort study","src":["aau","ku"],"src-code":["DI-U-AAU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.bja.2019.12.039","version":"Published Version"},"id":"S02-095.96-008882","identifier":[{"id":"85079038879","type":"scopus"},{"id":"32753102","type":"pmid"},{"id":"000519986700017","type":"wos"}],"ids":["aau-b82d70a7-2e01-4fb8-afdc-995cd7f74cce","ku-ee6f0a1c-3bce-4299-bdc9-84b81ab24660"],"keyword":["hyperoxia","intensive care unit","mechanical ventilation","mortality","observational study","oxygen inhalation therapy","respiratory failure"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-CC07DF7178031F1D97A56014C308D795"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.bja.2019.12.039","version":"Published Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg Universi