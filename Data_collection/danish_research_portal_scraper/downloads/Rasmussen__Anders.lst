o":"2","first":"Berit Lilienthal","key":"heitmannpau","last":"Heitmann","locid":"b644e477-0a57-40f2-b0a7-71e52f624356","name":"Heitmann, Berit Lilienthal","rank":15,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Else Marie","key":"bartelspau","last":"Bartels","name":"Bartels, Else Marie","rank":16,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Bente","key":"danneskioldsamsøepau","last":"Danneskiold-Samsøe","name":"Danneskiold-Samsøe, Bente","rank":17,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars Erik","key":"kristensenpau","last":"Kristensen","name":"Kristensen, Lars Erik","rank":18,"rolecode":"pau"}],"pmid":["33471039"],"pub":{"doi":"10.1093/ajcn/nqaa328","issn":["00029165","19383207"],"issn_org":["00029165"],"issue":"2","journal":"American Journal of Clinical Nutrition","pages":"314-323","publisher":"Elsevier","status":"p","title":"American Journal of Clinical Nutrition","title_org":"The American Journal of Clinical Nutrition","volume":"113"},"review":"Peer Reviewed","scoID":["2-s2.0-85102222232"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-d4ab1101-daad-49b9-9fd8-42b4bb2ef7ff","sdu-0751ea77-46bf-4380-878e-024b0b07c817"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Liraglutide after diet-induced weight loss for pain and weight control in knee osteoarthritis : A randomized controlled trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.95-046498","year":"2021","yearsub":"2021"}
{"abstract":"Purpose: We explored whether severe or critical hypotension can be predicted, based on patient and resuscitation characteristics in out-of-hospital cardiac arrest (OHCA) patients. We also explored the association of hypotension with mortality and neurological outcome. Materials and methods: We conducted a post hoc analysis of the TTH48 study (NCT01689077), where 355 out-of-hospital cardiac arrest (OHCA) patients were randomized to targeted temperature management (TTM) treatment at 33 °C for either 24 or 48 h. We recorded hypotension, according to four severity categories, within four days from admission. We used multivariable logistic regression analysis to test association of admission data with severe or critical hypotension. Results: Diabetes mellitus (OR 3.715, 95% CI 1.180–11.692), longer ROSC delay (OR 1.064, 95% CI 1.022–1.108), admission MAP (OR 0.960, 95% CI 0.929–0.991) and non-shockable rhythm (OR 5.307, 95% CI 1.604–17.557) were associated with severe or critical hypotension. Severe or critical hypotension was associated with increased mortality and poor neurological outcome at 6 months. Conclusions: Diabetes, non-shockable rhythm, longer delay to ROSC and lower admission MAP were predictors of severe or critical hypotension. Severe or critical hypotension was associated with poor outcome.","author_count":12,"contributors":["Hästbacka, Johanna","Kirkegaard, Hans","Søreide, Eldar","Taccone, Fabio Silvio","Rasmussen, Bodil Steen","Storm, Christian","Kjaergaard, Jesper","Laitio, Timo","Duez, Christophe Henri Valdemar","Jeppesen, Anni N.","Grejs, Anders M.","Skrifvars, Markus B."],"cuid":["S02-100.00-008213"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Hästbacka, Johanna"],"country":["Belgium","Finland","Germany","Norway"],"glorg":["All Global Affiliations","Charité – Universitätsmedizin Berlin","Helsinki University Hospital","Stavanger University Hospital","Turku University Central Hospital","University of Bergen","University of Helsinki","University of Turku","Université libre de Bruxelles"],"keyword":["Hemodynamics","Hypotension","Out of hospital cardiac arrest","Outcome","Predicting","Targeted temperature management"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-AAU","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"severe or critical hypotension during post cardiac arrest care is associated with factors available on admission a post hoc analysis of the tth000000000048 trial","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/475845224/H_stbacka_et_al._J_Crit_Care_2021.pdf","version":"Authors Final Version"},"funding_acknowledgement":["This work was supported by Finska Läkaresällskapet and Stiftelsen Dorothea Olivia, Karl Walter och Jarl Walter Perkléns minne ."],"id":"S02-100.00-008213","identifier":[{"id":"33181415","type":"pmid"},{"id":"85095728447","type":"scopus"}],"ids":["aau-aa4f08a6-e19a-4abd-bba9-ab22fdc60543","au-df7597b6-1061-47b2-9e44-472fe0d91b7c"],"keyword":["Hemodynamics","Hypotension","Out-of-hospital cardiac arrest","Outcome","Predicting","Targeted temperature management"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-86AEB08F10DBB5E0E72CE0462F2D532D"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/475845224/H_stbacka_et_al._J_Crit_Care_2021.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","c