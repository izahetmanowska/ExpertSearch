id":"0000-0003-0721-926X","rank":28,"rolecode":"pau"},{"affno":"35 36","corresponding":null,"country":"dk","first":"Bodil Steen","key":"rasmussenbodilsteenpau","last":"Rasmussen","locid":"3162c449-94c3-4d28-8dbb-c134d6eb76e1","name":"Rasmussen, Bodil Steen","orcid":"0000-0003-2190-145X","rank":29,"rolecode":"pau"},{"affno":"37 38","corresponding":null,"country":"dk","first":"Anne Craveiro","key":"brøchnerannecraveiropau","last":"Brøchner","locid":"fc2f6df3-3473-44fa-abd5-b38b523db807","name":"Brøchner, Anne Craveiro","orcid":"0000-0001-6453-6152","rank":30,"rolecode":"pau"},{"affno":"2 1 3 4","first":"Anders","key":"perneranderspau","last":"Perner","locid":"8a389541-d529-4ee3-8364-66bfc85f77c9","name":"Perner, Anders","rank":31,"rolecode":"pau"}],"pmid":["31276193"],"pub":{"doi":"10.1111/aas.13434","issn":["00015172"],"issue":"9","journal":"Acta Anaesthesiologica Scandinavica","pages":"1262-1271","publisher":"Blackwell Munksgaard","status":"p","title":"Acta Anaesthesiologica Scandinavica","volume":"63"},"review":"Peer Reviewed","scoID":["2-s2.0-85069719599"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","North Denmark Region","Other Hospitals","Other Research","Region Zealand","Region of Southern Denmark","Undetermined","Universities","University of Copenhagen","University of Southern Denmark","collaboration for research in intensive care"],"PST":["Published"]},"sid":["aau-d6049673-40d0-4d83-bf77-24f524badf08","au-ae4dfecc-8aec-4a93-b0a4-0435301efa68","ku-fdff00b8-240d-4025-ba85-fd9897443796","sdu-a1da1d8b-30d9-41d3-a874-2be64b1099e1"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Conservative vs liberal fluid therapy in septic shock (CLASSIC) trial—Protocol and statistical analysis plan","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-095.59-715786","year":"2019","yearsub":"2019"}
{"abstract":"BACKGROUND: In treatment of isolated medial unicondylar osteoarthritis of the knee, it is possible to choose between medial unicondylar knee arthroplasty (mUKA), or a total knee prosthesis (TKA). The demand for a blinded multicenter RCT with the comparison of mUKA and TKA has been increasing in recent years, to determine which prosthesis is better. Supporters of TKA suggest this treatment gives a more predictable and better result, whereas supporters of UKA suggest it is unnecessary to remove functional cartilage in other compartments. If the mUKA is worn or loosens, revision surgery will be relatively easy, whereas revision-surgery after a TKA can be more problematic. METHODS: A double-blinded multicenter Randomized Clinical Trial setup is the aim of the study. 6 hospitals throughout all 5 municipal regions of Denmark will be participating in the study. 350 patients will be included prospectively. Follow-up will be with PROM-questionnaires and clinical controls up to 20 years. DISCUSSION: Results will be assessed in terms of 1) PROM-questionnaires, 2) Clinical assessment of knee condition, 3) cost analysis. To avoid bias, all participants except the theatre-staff will be blinded. PROMS: OKS, KOOS, SF36, Forgotten Joint Score, EQ5D, UCLA activity scale, Copenhagen Knee ROM scale, and Anchor questions. Publications are planned at 2, 5 and 10 years after inclusion of the last patient. The development of variables over time will be analyzed by calculating the area under the curve (AUC) for the variable relative to the initial value, and comparisons of the between-group differences will be based on parametric statistics. In this study, we feel that we have designed a study that will address these concerns with a well-designed double-blinded multicentre RCT. TRIAL REGISTRATION: ClinicalTrials.gov ID: NCT03396640 . Initial Release: 09/19/2017. Date of enrolment of first participant: 10/11/17.","author_count":7,"contributors":["Mortensen, Jacob Fyhring","Rasmussen, Lasse Enkebølle","Østgaard, Svend Erik","Kappel, Andreas","Madsen, Frank","Schrøder, Henrik Morville","Odgaard, Anders"],"cuid":["S04-099.22-003733"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":4,"corresponding_author":["Mortensen, Jacob Fyhring"],"keyword":["Adolescent","Anteromedial osteoarthritis","Arthroplasty Replacement Knee methods","Child","Child Preschool","Double Blind Method","Female","Femur diagnostic imaging","Follow Up Studies","Humans","Infant","Infant Newborn","Knee replacement","Male","Medial Unicondylar knee arthroplasty","OKS","Osteoarthritis Knee diagnostic imaging","Prospective Studies","Tibia diagnostic imaging","Total knee arthroplasty","Young Adult"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA"],"OT":["Unspecified organisation"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"randomized clinical trial of medial unicompartmentel versus total knee arthroplasty for anteromedial tibio femoral osteoarthritis the study protocol","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12891-019-2508-1","version":"Published Version"},"funding_acknowledgement":["A heartfelt thank you to all participating departments, and to Region Hovedstaden for financial funding."],"id":"S04-099.22-003733","identifier":[{"id":"PMC6425587","type":"pmcid"},{"id":"30894146","type":"pmid"},{"id":"85063261680","type":"scopus"},{"id":"000462228800002","type":"wos"}],"ids":["aau-4c7e92b8-a0d7-4350-bb07-429f3d