au","last":"Wandall","locid":"05df527d-13fd-4de9-9bb6-1a7b604bc6fa","name":"Wandall, Hans H","orcid":"0000-0003-0240-9232","rank":4,"rolecode":"pau"},{"affno":"3","first":"Søren","key":"buussørenpau","last":"Buus","locid":"994343ae-c005-48f6-afca-d9e657570abc","name":"Buus, Søren","orcid":"0000-0001-8363-1999","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Mikkel","key":"harndahlmikkelpau","last":"Harndahl","name":"Harndahl, Mikkel","rank":6,"rolecode":"pau"},{"affno":"3","first":"Peter","key":"braendstruppeterpau","last":"Braendstrup","locid":"3d722a21-a77f-40dd-b409-658c34f40f8d","name":"Braendstrup, Peter","rank":7,"rolecode":"pau"},{"affno":"3","first":"Mogens H","key":"claessonmogenshelwegpau","last":"Claesson","locid":"6bb71e49-0031-4ee2-9052-7a1c1acdb478","name":"Claesson, Mogens Helweg","name_org":"Claesson, Mogens H","rank":8,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Mogens H","key":"claessonmogenshpau","last":"Claesson","name":"Claesson, Mogens H","rank":8,"rolecode":"pau"},{"affno":"3","first":"Anders Elm","key":"pedersenanderselmpau","last":"Pedersen","locid":"dcd1cfb9-0ba1-4151-897d-f04233bd6c91","name":"Pedersen, Anders Elm","rank":9,"rolecode":"pau"}],"pmid":["23802595"],"pub":{"doi":"10.3109/08923973.2013.802802","issn":["08923973","15322513"],"issn_org":["08923973"],"issue":"4","journal":"Immunopharmacology and Immunotoxicology","pages":"487-96","publisher":"Taylor and Francis Ltd.","status":"p","title":"Immunopharmacology and Immunotoxicology","volume":"35"},"review":"Peer Reviewed","scoID":["2-s2.0-84880321316"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Undetermined","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-bae9313a-01c7-4d9e-a37d-0a9ac1205f4f","ku-70462ff6-c00b-4d7e-9e42-339002b01a83"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Carbon anhydrase IX specific immune responses in patients with metastatic renal cell carcinoma potentially cured by interleukin-2 based immunotherapy","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.90-026256","year":"2013","yearsub":"2013"}
{"abstract":"Within recent years data has accumulated demonstrating the efficacy of recombinant interferon alpha2 (rIFN-alpha2) in the treatment of chronic myeloproliferative neoplasms (MPNs). We report on clinical and molecular data in the largest cohort of JAK2 V617F mutant MPN Danish patients (n=102) being treated long-term with rIFN-alpha2 (rIFN-alpha2a and rIFN-alpha2b in a non-clinical trial setting. The median follow-up was 42 months. We substantiate the capacity of rIFN-alpha2 to induce complete hematologic remissions (ET 95%, PV 68%) and molecular response. In total 76 patients (74.5%) had a decline in JAK2 V617F allele burden with a median reduction from baseline of 59% (95% c.i. 50-73%, range 3-99%). A decline in JAK2 V617F allele burden was recorded in both ET (median 24-10% (95% c.i.: 8-16%), and PV (median 59-35% (95% c.i.: 17-33%). Patients with the lowest pre-treatment JAK2 V617F allele burdens tend to achieve the most favourable responses on long term treatment with rIFN-alpha2. Eleven patients (10%) had deep molecular remissions with ≤ 2% JAK2 V617F mutant DNA. Finally, long term treatment with rIFN-alpha2 was associated with a very low thrombosis rate. Our observations are supportive of the concept of early up-front treatment with rIFN-alpha2.","author_count":19,"contributors":["Larsen, Thomas Stauffer","Iversen, Katrine F.","Hansen, Esben","Mathiasen, Anders Bruun","Marcher, Claus Werenberg","Frederiksen, Mikael","Larsen, Herdis","Rasmussen, Inge Helleberg","Riley, Caroline Hasselbalch","Bjerrum, Ole Weis","Rønnov-Jessen, Dorthe","Møller, Michael Boe","de Stricker, Karin","Vestergaard, Hanne","Hasselbalch, Hans Carl"],"cuid":["S03-097.68-011659"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"keyword":["Adolescent","Adult","Aged","Denmark","Female","Follow Up Studies","Humans","Interferon","Interferon alpha","JAK2","Janus Kinase 2","Male","Middle Aged","Molecular","Mutation","Polycythemia Vera","Primary Myelofibrosis","Prognosis","Recombinant Proteins","Remission Induction","Retrospective Studies","Thrombocythemia Essential","Time Factors","Young Adult"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA"],"OT":["Haderslev Sygehus"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"long term molecular responses in a cohort of danish patients with essential thrombocythemia polycythemia vera and myelofibrosis treated with recombinant interferon alpha","src":["aau","ku","sdu"],"src-code":["DI-U-AAU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.leukres.2013.06.012","version":"Other Version"},"id":"S03-097.68-011659","identifier":[{"id":"84880944672","type":"scopus"},{"id":"000324097600010","type":"wos"},{"id":"23827351","type":"pmid"}],"ids":["aau-f3faae50-49da-447b-8939-af45174f592c","ku-6f3d954f-fd19-4205-a7e8-31e1e73b3df8","sdu-d4b6e754-9361-4691-aef6-c75790155fad"],"keyword":["Adolescent","Adult","Aged","Denmark","Female","Follow-Up Studies","Humans","Interferon","Interferon-alpha","JAK2","Janus Kinase 2","Male","Middle Aged","Molecular","Mutation","Myeloproliferative","Polycythemia Vera","Primary Myelofibrosis","Prognosis","Recombinant Proteins","Remission Induction","Retrospective Studies","Thrombocythemia, Essential","Time Factors","Young Adult"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-B63CD708C3A731C53612A7218617A5EA"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.leukres.2013.06.012","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearP