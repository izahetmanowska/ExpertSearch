-2449","rank":41,"rolecode":"pau"},{"affno":"8","corresponding":null,"first":"John Eugenio","key":"coiapau","last":"Coia","locid":"769fe8ad-d320-4c3b-9d12-bf9f8ff450b3","name":"Coia, John","name_org":"Coia, John Eugenio","orcid":"0000-0002-4966-8453","rank":42,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Ea Sofie","key":"marmolinpau","last":"Marmolin","name":"Marmolin, Ea Sofie","rank":43,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders","key":"fomsgaardpau","last":"Fomsgaard","name":"Fomsgaard, Anders","rank":44,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jannik","key":"fonagerpau","last":"Fonager","name":"Fonager, Jannik","rank":45,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Morten","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Morten","rank":46,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Arieh","key":"cohenpau","last":"Cohen","name":"Cohen, Arieh","rank":47,"rolecode":"pau"}],"pmid":["35468331"],"pub":{"doi":"10.1016/s1473-3099(22)00154-2","issn":["14733099","14744457"],"issn_org":["14733099"],"issue":"7","journal":"The Lancet Infectious Diseases","pages":"967-976","publisher":"Elsevier Ltd","status":"p","title":"The Lancet Infectious Diseases","volume":"22"},"review":"Peer Reviewed","scoID":["2-s2.0-85132538661"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Miscellaneous","North Denmark Region","Other Research","Roskilde University","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-f75fdaf4-c889-489c-a364-0d3e35b40a12","ku-19e074a0-53c9-4239-bc75-9934607563bb","ruc-315c39df-ad6e-493e-a6fd-cc823ff0edcf","sdu-066fad72-70a8-437d-a96e-37fc4d3f30c9"],"src":["AU Aarhus University","KU University of Copenhagen","RUC Roskilde University","SDU University of Southern Denmark"],"title":"Risk of hospitalisation associated with infection with SARS-CoV-2 omicron variant versus delta variant in Denmark : an observational cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-094.79-030496","year":"2022","yearsub":"2022"}
{"abstract":"Here, we investigate the spontaneous locomotor patterns in three spiders with different hunting strategies. The locomotor activity of adult wolf spiders Pardosa amentata, with a sit-and-move hunting strategy, has previously been demonstrated to follow strictly mathematical rules, with most time spent at lower velocities and exponentially decreasing time spent at increasing velocities. Likewise, they have an abundance of short quiescent (resting) periods following a power decay function towards longer quiescent periods. In the present study, we explored whether similar distributions were expressed in juveniles of P. amentata and in two other spider species with different hunting strategies: the sit-and-wait spider Xysticus cristatus and the actively searching sac spider Clubiona phragmitis. We found that all three spider species followed the same two general rules of movement. However, there were differences among the three species. On a logarithmic scale of exponential velocities and a double-logarithmic scale of the rest power decay function, the slopes of the lines for the three species differed. We propose that these differences reflect the behavioural and locomotor differences of the three hunting strategies. Furthermore, we compare our results with similar movement distributions in single cells, fruit flies, mice and even humans.","author_count":4,"contributors":["Baatrup, Erik","Rasmussen, Anders Overgaard","Malte, Hans","Toft, Søren"],"cuid":["S01-000.00-143411"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Baatrup, Erik"],"keyword":["Araneae","Frequency distributions","Hunting mode","Predation strategy"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"exponential distribution of velocities and power distribution of quiescent periods in the spontaneous movement patterns of three hunting spiders","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85109456754","version":"Other Version"},"id":"S01-000.00-143411","identifier":[{"id":"85109456754","type":"scopus"}],"ids":["au-188471d2-01b7-49e4-ad81-d9136804f3c9"],"keyword":["Araneae","frequency distributions","hunting mode","predation strategy","quiescent periods"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-C8EEC98600032E19F0FCB9D03729C0A7"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Biology, Department of Biology - Zoophysiology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Erik","key":"baatruppau","last":"Baatrup","locid":"89662914-e86f-4ef3-8f40-5b047092da49","name":"Baatrup, Erik","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders O.","key":"rasmussenpau","last":"Rasmussen","locid":"5090d4ce-11da-49fd-aa27-db685e0c4c3d","name":"Rasmussen, Anders Overgaard","name_org":"Rasmussen, Anders O.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Hans","key":"maltepau","last":"Malte","locid":"d18fc340-77ef-4d8b-9101-6ac18ac2f032","name":"Malte, Hans","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren","key":"toftpau","last":"Toft","locid":"b9eacec2-544f-4d54-8ef8-63f2c0affe65","name":"Toft, Søren","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1093/biolinnean/blab020","issn":["00244066","10958312"],"issn_org":["00244066"],"issue":"3","journal":"Biological Journal of the Linnean Society","pages":"806-816","publisher":"Oxford University Press","status":"p","title":"Biological Journal of the Linnean Society","volume":"133"},"review":"Peer Reviewed","scoID":["2-s2.0-85109456754"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-188471d2-01b7-49e4-ad81-d9136804f3c9"],"src":["AU Aarhus University"],"title":"Exponential distribution of velocities and power distribution of quiescent periods in the spontaneous movement patterns of three hunting spiders","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-143411","year":"2021","yearsub":"2021"}
