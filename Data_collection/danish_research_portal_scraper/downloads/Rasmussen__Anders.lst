{"author_count":4,"contributors":["Svensson, Anders","Lohmann, Johannes","Rasmussen, Sune Olander","Buizert, Christo"],"cuid":["S01-000.00-525312"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"und","rtype":["clu"],"sorti":"the role of volcanism for abrupt climate change during the last glacial period","src":["ku"],"src-code":["DI-U-KU"],"type":"doi","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.5194/egusphere-egu2020-12846","version":"Published Version"},"id":"S01-000.00-525312","ids":["ku-dcc10cea-ee9d-4d10-b38c-e3f2f8309854"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-F625FC1669234B0DBD1A2555D22B77D1"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/275885267/EGU2020_12846_print.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.5194/egusphere-egu2020-12846","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Niels Bohr Institute, Physics of Ice, Climate and Earth"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Anders","key":"svenssonpau","last":"Svensson","locid":"e0501b84-a817-417e-9c70-9601c6b26cb8","name":"Svensson, Anders","orcid":"0000-0002-4364-6085","rank":1,"rolecode":"pau"},{"affno":"1","first":"Johannes","key":"lohmannpau","last":"Lohmann","locid":"79ca67ea-2fbf-4710-8c29-54a20d17a48d","name":"Lohmann, Johannes","orcid":"0000-0002-6323-6243","rank":2,"rolecode":"pau"},{"affno":"1","first":"Sune Olander","key":"rasmussenpau","last":"Rasmussen","locid":"3f1d51b2-26a1-4a40-af3f-05f030c7bb9d","name":"Rasmussen, Sune Olander","orcid":"0000-0002-4177-3611","rank":3,"rolecode":"pau"},{"affno":"1","first":"Christo","key":"buizertpau","last":"Buizert","locid":"407486ee-0fd9-4463-8479-4f78b629cffd","name":"Buizert, Christo","rank":4,"rolecode":"pau"}],"pub":{"publisher":"Copernicus/EGU","status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-dcc10cea-ee9d-4d10-b38c-e3f2f8309854"],"src":["KU University of Copenhagen"],"title":"The role of volcanism for abrupt climate change during the last glacial period","type":"Other-Internet Publication","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-525312","year":"2020","yearsub":"2020"}
{"abstract":"This chapter argues that Scandinavian immigrants’ desire for land ownership and social mobility laid bare the discrepancy between their egalitarian ideals and a white racial reality after the Civil War. With abolition achieved in 1865, Norwegian, Swedish, and Danish ethnic leaders in America quickly withdrew active political support for freedpeople’s economic opportunities. Instead, they regularly interpreted discussions over race and ethnicity through an Old World colonial mindset where white Scandinavians were perceived as more deserving of political and economic opportunities than other minority groups in the New World.","author_count":5,"contributors":["Rasmussen, Anders Bo"],"cuid":["S01-000.00-606437"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Race","Reconstruction","Whiteness"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"on liberty and equality race and reconstruction among scandinavian immigrants 000000001864 000000001868","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.routledge.com/Nordic-Whiteness-and-Migration-to-the-USA-A-Historical-Exploration-of-Identity/Sverdljuk-Joranger-Jackson-Kivisto/p/book/9780367277185?gclid=EAIaIQobChMIpsmj08nF7QIVqAZ7Ch34xACZEAAYASAAEgJ-2_D_BwE","version":"Other Version"},"id":"S01-000.00-606437","ids":["sdu-7418df49-108d-4827-a007-e15af7f0ab06"],"keyword":["Race","Reconstruction","Whiteness"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-9FB5B058C3FD2D6A3DFF0A6521D03578"],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Humanities, Department of History","SDU, Faculty of Humanities, Department of History, Center for American Studies"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Anders Bo","key":"rasmussenpau","last":"Rasmussen","locid":"f284f3a3-297f-4882-81e1-b591c41ead80","name":"Rasmussen, Anders Bo","orcid":"0000-0001-9817-9595","rank":1,"rolecode":"pau"},{"affno":"","first":"Jana","key":"sverdljukpedh","last":"Sverdljuk","name":"Sverdljuk, Jana","rank":2,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Terje Mikael Hasle","key":"jorangerpedh","last":"Joranger","name":"Joranger, Terje Mikael Hasle","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Erika K.","key":"jacksonpedh","last":"Jackson","name":"Jackson, Erika K.","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Peter","key":"kivistopedh","last":"Kivisto","name":"Kivisto, Peter","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.4324/9780429297472-7","isbn":["9780367277185"],"publisher":"Routledge","status":"p","subtitle":"A Hierarchy of Colour","title":"Nordic Whiteness and Migration to the USA"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-7418df49-108d-4827-a007-e15af7f0ab06"],"src":["SDU University of Southern Denmark"],"title":"\"On Liberty and Equality\" : Race and Reconstruction among Scandinavian Immigrants, 1864-1868","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-606437","year":"2020","yearsub":"2020"}
{"abstract":"Pædagogiske data kan være en ressource og en øjenåbner for lærere og pædagogers arbejde med un-dervisning og andre pædagogiske aktiviteter i skolen. I denne artikel sættes der fokus på, hvordan pæ-dagogiske data kan indgå i arbejdet med at sikre problembestemmelse og problemløsning i lærerens og pædagogens arbejde. Problembestemmelse og problemløsning er blevet aktuelt som en optik i forbin-delse med, at aktionslæringstilgange vinder kraftigt frem som en kollegial samarbejdsform i teams. Vi vil i artiklen vise, hvorfor og hvordan vores bud på nogle refleksionsigangsættende sætninger kan bi-drage til at støtte læreres og pædagogers arbejde med problembestemmelse og efterfølgende arbejde problemløsende med oplevede udfordringer i praksis. De refleksionsigangsættende sætninger under-støtter det at insistere på problemernes kompleksitet og forholde sig nysgerrigt hertil. Arbejdet med sætningen sikrer, at det pædagogiske personale foruden eget perspektiv også tager elevens perspektiv samt inddrager pædagogiske data som kilde til at belyse en given problemstilling","author_count":3,"contributors":["Rasmussen, Anders","Jensen, Anders","Lund, Lea"],"cuid":["S01-000.00-647257"],"filters":{"added":"2023-01","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"pop","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-UC"],"level3":{"UC":["DI-UC-ALL","DI-UC-UCL"]},"level3all":["DI-UC-UCL"]},"review":"und","rtype":["clu"],"sorti":"pædagogiske data kan være en øjenåbner at arbejde med problemforståelse og problemløsning når praksis skal videreudvikles","src":["ucl"],"src-code":["DI-UC-UCL"],"type":"doi","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://ucviden.ucl.dk/ws/files/73188405/Rasmussen_og_Jensen_2020_P_dagogiske_data_kan_v_re_en_jen_bner.pdf","version":"Published Version"},"id":"S01-000.00-647257","ids":["ucl-35c34283-1394-484e-aec4-863f65a78d68"],"lang":"Danish","level":"Popular","mra":["Humanities"],"noi":["Local-1-1-A38EC15D773748BEAD4E516A80BAE6FC"],"oa_link":[{"access":"oa","type":"loc","url":"https://ucviden.ucl.dk/ws/files/73188405/Rasmussen_og_Jensen_2020_P_dagogiske_data_kan_v_re_en_jen_bner.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ucl university college","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-UCL","l3nl":"UCL University College","l3nn":"UCL University College","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"UCL University College","namevar":["UCL Erhvervsakademi og Professionshøjskole, Akademiske Praksisartikler","UCL Erhvervsakademi og Professionshøjskole, Direktion, Kompetence- og Organisationsudvikling, Pædagogik og Læring"],"nora_code":"DI-UC-UCL","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anders","key":"rasmussenpau","last":"Rasmussen","locid":"2a136974-b782-43e4-9ff2-f630c2ddb5a1","name":"Rasmussen, Anders","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders","key":"jensenpau","last":"Jensen","locid":"16754fea-fa46-4045-a85e-a64480532ca2","name":"Jensen, Anders","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lea","key":"lundped","last":"Lund","locid":"4c4bddc4-0df7-4d4b-8afb-35f756960fce","name":"Lund, Lea","rank":3,"role":"Editor","rolecode":"ped"}],"pub":{"publisher":"UCL Erhvervsakademi og Professionshøjskole","status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All University Colleges","DI-ALL","DI-UC","DI-UC-ALL","UCL University College","University Colleges"],"PST":["Published"]},"sid":["ucl-35c34283-1394-484e-aec4-863f65a78d68"],"src":["UCL University College"],"title":"Pædagogiske data kan være en øjenåbner – : at arbejde med problemforståelse og problemløsning når praksis skal videreudvikles","type":"Other-Internet Publication","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-647257","year":"2020","yearsub":"2020"}
{"abstract":"Et nyt skrotmetaldepotfund fra ældre germansk jernalder på Lolland give et indblik i datidens forbindelser med den romerske verden.","author_count":1,"contributors":["Rasmussen, Anders"],"cuid":["S01-000.00-830371"],"filters":{"added":"2025-10","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"keyword":["Depotfund","Jernalder","Lolland","Lolland Falster","Metaldetektor"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV"],"level3":{"GV":["DI-GV-ALL","DI-GV-KUM"]},"level3all":["DI-GV-KUM"]},"review":"nr","rtype":["clu"],"sorti":"skrotmetaldepotet fra rågelunde et nyt og spændende detektorfund fra den yngre jernalder","src":["kum"],"src-code":["DI-GV-KUM"],"type":"doi","type-grp":["all","pub"]},"ft":{"access":"oa","text":"Undefined","type":"url","url":"https://kalejdoskop.atavist.com/skrotmetaldepotet-fra-rgelunde","version":"Other Version"},"id":"S01-000.00-830371","ids":["kum-4b91d685-8a9a-4c50-8e36-17ca86034088"],"keyword":["Depotfund","Jernalder","Lolland","Lolland-Falster","Metaldetektor","Skrotmetal"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-84C334E0691A0E5E8E0E8249C0A71D74"],"org":[{"affno":"1","key":"kum ministry of culture archives museums and royal library denmark","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-KUM","l3nn":"KUM Ministry of Culture - Archives, Museums, and Royal Library Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KUM Ministry of Culture - Archives, Museums, and Royal Library Denmark","namevar":["Ministry of Culture Denmark, Museum Lolland-Falster"],"nora_code":"DI-GV-KUM","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Anders","key":"rasmussenpau","last":"Rasmussen","locid":"831558a0-727f-45a9-bbbb-8f8b30058802","name":"Rasmussen, Anders","orcid":"0000-0002-6769-9122","rank":1,"rolecode":"pau"}],"pub":{"status":"X"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Governmental Institutions","DI-ALL","DI-GV","DI-GV-ALL","Governmental Institutions"],"PST":["Undefined"]},"sid":["kum-4b91d685-8a9a-4c50-8e36-17ca86034088"],"src":["KUM Ministry of Culture - Archives, Museums, and Royal Library Denmark"],"title":"Skrotmetaldepotet fra Rågelunde : Et nyt og spændende detektorfund fra den yngre jernalder","type":"Other-Internet Publication","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-830371","year":"2020","yearsub":"2020"}
{"abstract":"Background: The Handling Oxygenation Targets in the Intensive Care Unit (HOT-ICU) trial is an ongoing randomised clinical trial exploring the benefits and harms of targeting a lower (8 kPa) versus a higher (12 kPa) arterial oxygenation target in adult patients acutely admitted to the intensive care unit (ICU) with hypoxaemic respiratory failure. Methods: This protocol describes a secondary analysis of the primary trial outcome, 90-day all-cause mortality. We will analyse the primary outcome using Bayesian methods, which allows quantification of probabilities of all effect sizes. We will explore the presence of heterogeneity of treatment effects (HTE) using Bayesian hierarchical models in subgroups based on baseline parameters: (a) severity of illness (Sequential Organ Failure Assessment (SOFA) score), (b) severity of hypoxaemic respiratory failure (partial pressure of arterial oxygen (PaO 2)/fraction of inspired oxygen (FiO 2) ratio), (c) vasopressor requirement (highest noradrenaline dose in the 24 hours prior to randomisation), and (d) plasma lactate concentration (latest prior to randomisation). Additionally, we will perform separate assessments of the treatment effect interaction with each of the baseline parameters above on the continuous scale and present these using conditional effects plots. Conclusions: This secondary analysis will aid the interpretation of the HOT-ICU trial by evaluating probabilities of all effect sizes. In addition, we will evaluate whether HTE is present, thus, further evaluating benefits and harms of a lower versus a higher oxygenation target in adult ICU patients with acute hypoxaemic respiratory failure.","author_count":8,"contributors":["Lass Klitgaard, Thomas","Schjørring, Olav Lilleholt","Lange, Theis","Møller, Morten Hylander","Perner, Anders","Rasmussen, Bodil Steen","Granholm, Anders"],"cuid":["S02-082.64-011287"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Guidelines","Oxygen therapy","R package","Sepsis"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-NDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-HO-NDR","DI-U-AAU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"bayesian and heterogeneity of treatment effect analyses of the hot icu trial a secondary analysis protocol","src":["aau","ku"],"src-code":["DI-U-AAU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85089012360&partnerID=8YFLogxK","version":"Other Version"},"id":"S02-082.64-011287","identifier":[{"id":"000555726200001","type":"wos"},{"id":"85089012360","type":"scopus"},{"id":"32659856","type":"pmid"}],"ids":["aau-ec63cbd9-fccb-4bcb-afe4-402e2b6d7e63","ku-9c57fb5c-141b-4afc-be81-b32791f93daf"],"keyword":["GUIDELINES","OXYGEN-THERAPY","R PACKAGE","SEPSIS"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-EB979716B289FB5803313D3E0752B1C4"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Anaesthesiology and Intensive Care","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Anæstesi, Børn, Kredsløb og Kvinder","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"