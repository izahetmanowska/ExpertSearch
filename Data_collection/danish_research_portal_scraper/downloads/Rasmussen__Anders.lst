urnal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-477309","year":"2011","yearsub":"2011"}
{"abstract":"Cancer-associated autoantibodies hold promise as sensitive biomarkers for early detection of cancer. Aberrant post-translational variants of proteins are likely to induce autoantibodies, and changes in O-linked glycosylation represent one of the most important cancer-associated post-translational modifications (PTMs). Short aberrant O-glycans on proteins may introduce novel glycopeptide epitopes that can elicit autoantibodies because of lack of tolerance. Technical barriers, however, have hampered detection of such glycopeptide-specific autoantibodies. Here, we have constructed an expanded glycopeptide array displaying a comprehensive library of glycopeptides and glycoproteins derived from a panel of human mucins (MUC1, MUC2, MUC4, MUC5AC, MUC6 and MUC7) known to have altered glycosylation and expression in cancer. Seromic profiling of patients with colorectal cancer identified cancer-associated autoantibodies to a set of aberrant glycopeptides derived from MUC1 and MUC4. The cumulative sensitivity of the array analysis was 79% with a specificity of 92%. The most prevalent of the identified autoantibody targets were validated as authentic cancer immunogens by showing expression of the epitopes in cancer using novel monoclonal antibodies. Our study provides evidence for the value of glycopeptides and other PTM-peptide arrays in diagnostic measures.","author_count":12,"contributors":["Pedersen, Johannes W","Blixt, Klas Ola","Bennett, Eric P","Tarp, Mads Peter Agervig","Dar, Imran","Mandel, Ulla","Poulsen, Steen Seier","Pedersen, Anders Elm","Rasmussen, Susanne","Jess, Per","Clausen, Henrik","Wandall, Hans H"],"cuid":["S01-000.00-499340"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"seromic profiling of colorectal cancer patients with novel glycopeptide microarray","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1002/ijc.25778","version":"Other Version"},"id":"S01-000.00-499340","identifier":[{"id":"21344374","type":"pmid"},{"id":"79951974583","type":"scopus"}],"ids":["ku-b14b6723-0f61-41da-b9e0-d8450dd2695c"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-42BF82455E535E9C10D09A5580173F13"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1002/ijc.25778","version":"Other Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Cellular and Molecular Medicine, Glycomics Program","Københavns Universitet, Faculty of Health and Medical Sciences, Graduate School of Health and Medical Sciences, Ph.d.-studienævnet for Medicin"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Johannes W","key":"pedersenjohanneswpau","last":"Pedersen","locid":"7ea2d467-6a18-4d2e-8ffb-c24caaf52cf5","name":"Pedersen, Johannes W","rank":1,"rolecode":"pau"},{"affno":"1","first":"Ola","key":"blixtklasolapau","last":"Blixt","locid":"8f041b74-7499-4286-bbec-a777b8d2f3eb","name":"Blixt, Klas Ola","name_org":"Blixt, Ola","orcid":"0000-0003-4143-6276","rank":2,"rolecode":"pau"},{"affno":"1","first":"Eric P","key":"bennettericppau","last":"Bennett","locid":"985ebfda-1253-424b-8e7d-d5918fa165bf","name":"Bennett, Eric P","orcid":"0000-0002-4976-0647","rank":3,"rolecode":"pau"},{"affno":"","first":"Mads A","key":"tarpmadspeteragervigpau","last":"Tarp","locid":"cc5c56d0-235a-49a3-8951-3d98dab2809a","name":"Tarp, Mads Peter Agervig","name_org":"Tarp, Mads A","rank":4,"rolecode":"pau"},{"affno":"","first":"Imran","key":"darimranpau","last":"Dar","locid":"6aebff43-05c5-4b90-bd16-7f8dd3afa3bf","name":"Dar, Imran","rank":5,"rolecode":"pau"},{"affno":"1","first":"Ulla","key":"mandelullapau","last":"Mandel","locid":"5b548729-0f0e-4986-910e-ae324c866105","name":"Mandel, Ulla","orcid":"0000-0001-7012-9836","rank":6,"rolecode":"pau"},{"affno":"1","first":"Steen S","key":"poulsensteenseierpau","last":"Poulsen","locid":"8959d81d-fe64-4ef4-86b7-003b7b637e8e","name":"Poulsen, Steen Seier","name_org":"Poulsen, Steen S","orcid":"0000-0003-4419-4911","rank":7,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Anders E","key":"pedersenanderselmpau","last":"Pedersen","locid":"dcd1cfb9-0ba1-4151-897d-f04233bd6c91","name":"Pedersen, Anders Elm","name_org":"Pedersen, Anders E","rank":8,"rolecode":"pau"},{"affno":"","first":"Susanne","key":"rasmussensusannepau","last":"Rasmussen","locid":"8b081b36-5de6-4bc8-bced-312a1dd01c69","name":"Rasmussen, Susanne","rank":9,"rolecode":"pau"},{"affno":"1","first":"Per","key":"jessperpau","last":"Jess","locid":"f248f207-a9c9-4700-8132-966960aa3eee","name":"Jess, Per","rank":10,"rolecode":"pau"},{"affno":"1","first":"Henrik","key":"clausenhenrikpau","last":"Clausen","locid":"a7882c09-1275-4857-8b5b-7e3efc1d088d","name":"Clausen, Henrik","orcid":"0000-0002-0915-5055","rank":11,"rolecode":"pau"},{"affno":"1","first":"Hans H","key":"wandallhanshpau","last":"Wandall","locid":"05df527d-13fd-4de9-9bb6-1a7b604bc6fa","name":"Wandall, Hans H","orcid":"0000-0003-0240-9232","rank":12,"rolecode":"pau"}],"pmid":["21344374"],"pub":{"doi":"10.1002/ijc.25778","issn":["00207136"],"issue":"8","journal":"International Journal of Cancer","pages":"1860-71","status":"p","title":"International Journal of Cancer","volume":"128"},"review":"Peer Reviewed","scoID":["2-s2.0-79951974583"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-b14b6723-0f61-41da-b9e0-d8450dd2695c"],"src":["KU University of Copenhagen"],"title":"Seromic profiling of colorectal cancer patients with novel glycopeptide microarray","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-499340","year":"2011","yearsub":"2011"}
{"abstract":"Effects of quetiapine on cognition were assessed in a group of first-episode antipsychotic-naïve patients with schizophrenia (N=24). A comprehensive battery of neuropsychological tests was administered at baseline and after 6months of treatment with quetiapine. In order to examine retest effects, a matched healthy control group (N=24) was also tested at baseline and after 6months. Only few differential changes were observed between patients and healthy controls. Of 8 cognitive domains examined, only significant changes in executive function suggested possible ameliorating effects of quetiapine. Patients also improved on speed of processing; however, this was parallel to the retest effects found in healthy controls. When covaried for differences at baseline, patients showed smaller improvements in speed of processing than the retest effects found in controls, as well as a lack of retest effects on sustained attention and working memory that were found in healthy controls. The main result of the study is that there was very little evidence of efficacy of quetiapine on cognition. The study also indicated a lack of normal retest effects in patients compared to controls.","author_count":8,"contributors":["Andersen, Rune","Fagerlund, Birgitte","Rasmussen, Hans","Ebdrup, Bjorn H","Aggernæs, Bodil","Gade, Anders","Oranje, Bob","Glenthøj, Birte"],"cuid":["S01-000.00-520580"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"cognitive effects of six months of treatment with quetiapine in antipsychotic naïve first episode schizophrenia","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://www.sciencedirect.com.ep.fjernadgang.kb.dk/science/article/pii/S0165178110006438","version":"Other Version"},"id":"S01-000.00-520580","identifier":[{"id":"79953081209","type":"scopus"}],"ids":["ku-d4ca0cc1-c5e1-4d65-8605-3b736911dbeb"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-2-F281417B9B3156D148029CCE4BAB838C"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.sciencedirect.com.ep.fjernadgang.kb.dk/science/article/pii/S0165178110006438","version":"Other Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Social Sciences, Department of Psychology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Rune","key":"andersenpau","last":"Andersen","locid":"3c90c479-115c-418d-a31b-7f2190ab10aa","name":"Andersen, Rune","rank":1,"rolecode":"pau"},{"affno":"","first":"Birgitte","key":"fagerlundpau","last":"Fagerlund","locid":"b4344e58-3952-4d72-934c-6a409f40139d","name":"Fagerlund, Birgitte","rank":2,"rolecode":"pau"},{"affno":"","first":"Hans","key":"rasmussenpau","last":"Rasmussen","locid":"af5c9d62-07bb-4ad9-8c5a-5ae7c9180716","name":"Rasmussen, Hans","rank":3,"rolecode":"pau"},{"affno":"","first":"Bjorn H","key":"ebdruppau","last":"Ebdrup","name":"Ebdrup, Bjorn H","rank":4,"rolecode":"pau"},{"affno":"","first":"Bodil","key":"aggernaespau","last":"Aggernaes","locid":"7ef120f2-e9c9-420c-8ec7-d1f78966b6d4","name":"Aggernæs, Bodil","name_org":"Aggernaes, Bodil","rank":5,"rolecode":"pau"},{"affno":"1","first":"Anders","key":"gadepau","last":"Gade","locid":"d275da50-7603-4fc3-90c8-01f34197d626","name":"Gade, Anders","rank":6,"rolecode":"pau"},{"affno":"","first":"Bob","key":"oranjepau","last":"Oranje","locid":"ee02ba69-402f-4381-b508-3941d7ec0282","name":"Oranje, Bob","rank":7,"rolecode":"pau"}