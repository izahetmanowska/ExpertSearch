ngsted Hospitals (NSR), Research Unit of Medicine (Slagelse)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1 2 3","corresponding":null,"country":"dk","first":"Mette","key":"kaasgaardpau","last":"Kaasgaard","locid":"fc5784b6-66d8-4b92-8c4a-74bf4628c9c3","name":"Kaasgaard, Mette","orcid":"0000-0003-3833-2943","rank":1,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Daniel Bech","key":"rasmussenpau","last":"Rasmussen","locid":"18525822-35fd-4cd8-afdd-a608be44cc84","name":"Rasmussen, Daniel Bech","orcid":"0000-0003-1213-9483","rank":2,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Karen Hjerrild","key":"andreassonpau","last":"Andreasson","locid":"8af88feb-2896-4499-89bd-750df2e82461","name":"Andreasson, Karen Hjerrild","orcid":"0000-0002-8752-9614","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Ole","key":"hilbergpau","last":"Hilberg","locid":"6c545c65-1d94-45a3-a8b4-f90eae06d248","name":"Hilberg, Ole","orcid":"0000-0002-3075-3463","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Anders","key":"løkkepau","last":"Løkke","locid":"db3d3870-0459-4783-8f0b-6a8e5d9dce78","name":"Løkke, Anders","orcid":"0000-0002-6905-4141","rank":5,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"country":"dk","first":"Peter","key":"vuustpau","last":"Vuust","locid":"2c697ab6-9b06-4a16-a687-c8cdbd56f661","name":"Vuust, Peter","rank":6,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Uffe","key":"bodtgerpau","last":"Bodtger","locid":"2f4e70da-63bb-4b8d-af09-2a959d6df5e8","name":"Bodtger, Uffe","orcid":"0000-0002-1231-9209","rank":7,"rolecode":"pau"}],"pmid":["34625480"],"pub":{"doi":"10.1183/13993003.01142-2021","issn":["09031936","13993003"],"issn_org":["09031936"],"issue":"5","journal":"European Respiratory Journal","paperid":"2101142","publisher":"European Respiratory Society","status":"p","title":"European Respiratory Journal","volume":"59"},"review":"Peer Reviewed","scoID":["2-s2.0-85130768115"],"search":{"DAF":["Aarhus University","All Artistic Higher Education Institutions","All Danish Affiliations","All Hospitals","All Universities","Artistic Higher Education Institutions","DI-ALL","DI-ART","DI-ART-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region Zealand","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-4cbe30d7-c900-42c3-8745-9501c76038be","sdu-35ac88a8-2480-429d-b772-d94a0a9dc44b"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Use of Singing for Lung Health as an alternative training modality within pulmonary rehabilitation for COPD : a randomised controlled trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-087.50-018267","year":"2022","yearsub":"2022"}
{"abstract":"BACKGROUND: Birth by cesarean section (CS) is linked to an increased risk of developing asthma, but the underlying mechanisms are unclear. OBJECTIVE: To elucidate the link between birth by CS and asthma using newborn metabolomic profiles and integrating early life gut microbiome data and cord blood immunology. METHODS: We investigated the influence of CS on liquid chromatography mass spectrometry (LC-MS) metabolomic profiles of dried blood spots from newborns of the two independent Copenhagen Prospective Studies on Asthma in Childhood cohorts, i.e. COPSAC2010 (n=677) and COPSAC2000 (n=387). We assessed the associations between the CS metabolic profile, age one-week gut microbiome data and frequency of cord blood Tregs. RESULTS: In COPSAC2010, a partial least square-discriminant analysis (PLS-DA) model showed that children born by CS versus natural delivery had different metabolic profiles (AUC=0.77, p=2.2e-16), which was replicated in COPSAC2000 (AUC=0.66, p=1.2e-5). The metabolic profile of CS was significantly associated with an increased risk of asthma at school-age in both COPSAC2010 (p=0.03) and COPSAC2000 (p=0.005). CS was associated with lower abundance of tryptophan, bile acid and phenylalanine metabolites, indicative of a perturbed gut microbiota. Further, gut bacteria dominating after natural delivery, i.e. Bifidobacterium and Bacteroides were correlated with CS-discriminative microbial metabolites, suggesting maternal microbial transmission during birth regulating the newborn's metabolism. Finally, the CS metabolic profile was associated with frequency of cord blood Tregs. CONCLUSIONS: These findings propose that CS is programming the risk of childhood asthma through perturbed immune responses and gut microbial colonization patterns reflected in the blood metabolome at birth.","author_count":16,"contributors":["Gürdeniz, Gözde","Ernst, Madeleine","Rago, Daniela","Kim, Min","Courraud, Julie","Stokholm, Jakob","Bønnelykke, Klaus","Björkbom, Anders","Trivedi, Urvish","Sørensen, Søren J.","Brix, Susanne","Hougaard, David","Rasmussen, Morten","Cohen, Arieh S.","Bisgaard, Hans","Chawes, Bo"],"cuid":["S02-094.93-034293"],"filters":{"added":"2022-08","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Bisgaard, Hans"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"neonatal metabolome of caesarean section and risk of childhood asthma","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/337746661/Neonatal_metabolome.pdf","version":"Authors Final Version"},"id":"S02-094.93-034293","identifier":[{"id":"85133101204","type":"scopus"},{"id":"34887324","type":"pmid"}],"ids":["dtu-4c076d95-e279-443d-b7e4-74b6d7f8efad","ku-fcacf093-3bca-4ad6-b5f6-1e3af08e773f"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-2A6D4557EFF1DBF92793EC341BE6B94A"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/337746661/Neonatal_metabolome.pdf","version":"Authors Final Version"},{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/301625302/13993003.02406_2021.full.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital Herlev and Gentofte"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","country":"dk","key":"ssi statens serum institut","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-SSI","l3nn":"SSI Statens Serum Institut","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SSI Statens Serum Institut","namevar":["Statens Serum Institut"],"nora_code":"DI-GV-SSI","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Paediatrics"],"nora_code":"DI-U-KU","used":1},{"affno":"4","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Biotechnology and Biomedicine","Technical University of Denmark, Department of Biotechnology and Biomedicine, Section for Protein Science and Biotherapeutics, Disease Systems Immunology"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Gözde","key":"gürdenizpau","last":"Gürdeniz","name":"Gürdeniz, Gözde","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Madeleine","key":"ernstpau","last":"Ernst","name":"Ernst, Madeleine","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Daniela","key":"ragopau","last":"Rago","name":"Rago, Daniela","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Min","key"