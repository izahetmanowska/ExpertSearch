ame":"Rasmussen, Anders Moe","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Sune","key":"liisbergpedh","last":"Liisberg","name":"Liisberg, Sune","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9788788663846"],"pages":"7-19","place":"Aarhus","publisher":"Forlaget Philosophia","status":"p","title":"Når værker kommer til verden: Om filosofiske indsigters genese"},"review":"Undetermined","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-3bbec594-c195-4d58-a01d-65b17e50ce07"],"src":["AU Aarhus University"],"title":"Introduktion til Dieter Henrich, \"Når værker kommer til verden. Om filosofiske indsigters genese\"","type":"Book Preface, Encycl. Entry","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-163391","year":"2013","yearsub":"2013"}
{"abstract":"Following the completion in May 2011 of the shutdown for the installation of the beryllium wall and the tungsten divertor, the first set of JET campaigns have addressed the investigation of the retention properties and the development of operational scenarios with the new plasma-facing materials. The large reduction in the carbon content (more than a factor ten) led to a much lower Zeff (1.2–1.4) during L- and H-mode plasmas, and radiation during the burn-through phase of the plasma initiation with the consequence that breakdown failures are almost absent. Gas balance experiments have shown that the fuel retention rate with the new wall is substantially reduced with respect to the C wall. The re-establishment of the baseline H-mode and hybrid scenarios compatible with the new wall has required an optimization of the control of metallic impurity sources and heat loads. Stable type-I ELMy H-mode regimes with H98,y2 close to 1 and βN ∼ 1.6 have been achieved using gas injection. ELM frequency is a key factor for the control of the metallic impurity accumulation. Pedestal temperatures tend to be lower with the new wall, leading to reduced confinement, but nitrogen seeding restores high pedestal temperatures and confinement. Compared with the carbon wall, major disruptions with the new wall show a lower radiated power and a slower current quench. The higher heat loads on Be wall plasma-facing components due to lower radiation made the routine use of massive gas injection for disruption mitigation essential.","author_count":8,"contributors":["Romanelli, F.","Madsen, Jens","Naulin, Volker","Nielsen, Anders Henry","Nielsen, Stefan Kragh","Rasmussen, Jens Juul","Salewski, Mirko","Stejner Pedersen, Morten"],"cuid":["S01-000.00-313851"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","United Kingdom Atomic Energy Authority"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"overview of the jet results with the iter like wall","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1088/0029-5515/53/10/104002","version":"Other Version"},"id":"S01-000.00-313851","identifier":[{"id":"84988385351","type":"scopus"}],"ids":["dtu-1f1c89ce-565e-4acb-adea-239a6a8cc6bb"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-4D390159C94FA75B058A6E6A41B011DD"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1088/0029-5515/53/10/104002","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","country":"gb","key":"united kingdom atomic energy authority","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"United Kingdom Atomic Energy Authority","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Physics","Technical University of Denmark, Department of Physics, Plasma Physics and Fusion Energy"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"F.","key":"romanellifpau","last":"Romanelli","name":"Romanelli, F.","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jens","key":"madsenjenspau","last":"Madsen","locid":"ed287c2f-88ab-4d2f-8609-c89f2c2f7633","name":"Madsen, Jens","orcid":"0000-0002-6874-2970","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Volker","key":"naulinvolkerpau","last":"Naulin","locid":"68cb67c0-c64d-4fef-a301-67ab58d8ace6","name":"Naulin, Volker","orcid":"0000-0001-5452-9215","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Anders Henry","key":"nielsenandershenrypau","last":"Nielsen","locid":"1d9aa958-9d84-4a3b-8300-f6fe9b0be73e","name":"Nielsen, Anders Henry","orcid":"0000-0003-3642-3905","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Stefan Kragh","key":"nielsenstefankraghpau","last":"Nielsen","locid":"185da313-7f9e-45e7-9ee7-83306c90e806","name":"Nielsen, Stefan Kragh","orcid":"0000-0003-4175-3829","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jens Juul","key":"rasmussenjensjuulpau","last":"Rasmussen","locid":"125b9658-f84c-4e0e-859e-5899413288ee","name":"Rasmussen, Jens Juul","orcid":"0000-0002-3543-690X","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Mirko","key":"salewskimirkopau","last":"Salewski","locid":"38100e3a-6385-47d3-aa2d-6fc5608a8649","name":"Salewski, Mirko","orcid":"0000-0002-3699-679X","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Morten Stejner","key":"stejnerpedersenmortenpau","last":"Pedersen","locid":"5e16534e-b167-4a1f-a316-ea12e478d879","name":"Stejner Pedersen, Morten","name_org":"Pedersen, Morten Stejner","orcid":"0000-0003-1300-8135","rank":8,"rolecode":"pau"}],"pub":{"doi":"10.1088/0029-5515/53/10/104002","issn":["00295515","10185577"],"issn_org":["00295515"],"journal":"Nuclear Fusion","paperid":"104002","publisher":"IOP Publishing","status":"p","title":"Nuclear Fusion","volume":"53"},"review":"Peer Reviewed","scoID":["2-s2.0-84988385351"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-1f1c89ce-565e-4acb-adea-239a6a8cc6bb"],"src":["DTU Technical University of Denmark"],"title":"Overview of the JET results with the ITER-like wall","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-313851","year":"2013","yearsub":"2013"}
{"abstract":"When stretching and imaging DNA molecules in nanofluidic devices, it is important to know the relation between the physical length as measured in the lab and the distance along the contour of the DNA. Here a single DNA molecule longer than 1 Mbp is loaded into a nanofluidic device consisting of two crossing nanoslits (85nm x 50 microns) connected to microchannels. An applied pressure creates a stagnation point at the crossing of the nanoslits. The drag force from the fluid stretches the DNA. We determine the degree of stretching of the molecule (i) without the use of markers, (ii) without knowing the contour length of the DNA, and (iii) without having the full DNA molecule inside the field-of-view. The analysis is based on the transverse motion of the DNA due its Brownian motion, i.e. the DNA's response to the thermal fluctuations of the liquid surrounding it. The parameter values obtained by fitting agree well with values we obtain from simplified modeling of the DNA as a cylinder in a parallel flow. Secondly, DNA molecules stained with the intercalating dye YOYO-1 are de- and renatured locally following a modified version of the protocol used in Ref. 1. The result is a melting pattern which reflects the local AT/GC-content. Single molecules are loaded into the chip and imaged. Due to the almost complete stretching of the DNA, structural variations in the size range from kbp to Mbp can be detected and quantified from the melting pattern alone.","author_count":9,"contributors":["Pedersen, Jonas Nyvold","Marie, Rodolphe","Bauer, D. L.","Rasmussen, Kristian Hagsted","Yusuf, Mohamed Adan","Volpi, E. V.","Kristensen, Anders","Mir, K. U.","Flyvbjerg, Henrik"],"cuid":["S01-000.00-318460"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of Oxford"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"fully streched single dna molecules in a nanofluidic chip show large scale structural variation","src":["dtu"],"src-code":["DI-U-DTU"],"type":"djc","type-grp":["all","pub"]},"id":"S01-000.00-318460","ids":["dtu-2ebf2c9f-feee-4a1a-963b-533e1be4f615"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-4FB1969B2ACD538A5B05BC29942DEF5C"],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Micro- and Nanotechnology","Technical University of Denmark, Department of Micro- and Nanotechnology, Stochastic Systems and Signals"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"gb","key":"university of oxford","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Oxford","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jonas Nyvold","key":"pedersenpau","last":"Pedersen","locid":"bafd597a-c1ed-4c65-b484-741359d87d7f","name":"Pedersen, Jonas Nyvold","orcid":"0000-0001-7642-8212","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rodolphe","key":"mariepau","last":"Marie","locid":"0e01d976-5d97-42d2-9b08-d7a8f8fb48f7","name":"Marie, Rodolphe","orcid":"0000-0002-8338-1990","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"D. L.","key":"bauerpau","last":"Bauer","name":"Bauer, D. L.","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kristian Hagsted","key":"rasmussenpau","last":"Rasmussen","locid":"f8079726-bd61-4d72-801c-f70ecafc96b3"