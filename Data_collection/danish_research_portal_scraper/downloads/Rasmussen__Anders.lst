{"author_count":12,"contributors":["Costea, S.","Rasmussen, Jens Juul","Vianello, N.","Müller, Hans Werner","Naulin, Volker","Schrittwieser, R.","Nielsen, Anders Henry","Madsen, Jens","Ionita, C.","Spolaore, M.","Carralero, D.","Mehlmann, Franz"],"cuid":["S01-000.00-305594"],"event":{"end":"2015-06-26","place":"Lisbon, pt","start":"2015-06-22","title":"42nd European Physical Society Conference on Plasma Physics","year":"2015"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","OECD"],"country":["Austria","Germany","Italy","Switzerland"],"glorg":["All Global Affiliations","Consorzio RFX","Max Planck Institute","Max Planck Institute for Plasma Physics","Swiss Federal Institute of Technology Lausanne","University of Innsbruck"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"investigation on radial transport of perpendicular momentum in the sol of aug during l i h transition","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84979663011","version":"Other Version"},"id":"S01-000.00-305594","identifier":[{"id":"84979663011","type":"scopus"}],"ids":["dtu-0363bf51-73b5-4e02-8652-0e0c310395a6"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-A6B132F5C72475AF3CAFAD3BD52A08E0"],"org":[{"affno":"1","country":"at","key":"university of innsbruck","loc":["Austria","Europe, EU","OECD"],"name":"University of Innsbruck","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name