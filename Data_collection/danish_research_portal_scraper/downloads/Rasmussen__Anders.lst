per Anton","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Casper Anton","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Anders Klostergaard","key":"petersenpau","last":"Petersen","locid":"966b9914-b583-4e39-8af5-6c1684239191","name":"Petersen, Anders Klostergaard","orcid":"0000-0003-0821-4049","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Niki Smith","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Niki Smith","rank":4,"rolecode":"pau"}],"pub":{"issn":["09046054"],"newspaper":"Kristeligt Dagblad","pages":"9","publisher":"Kristeligt Dagblad AS","publisher_org":"Kristeligt Dagblad A/S","status":"p","title":"Kristeligt Dagblad"},"review":"Undetermined","search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-a9ce4052-4f7c-44bb-842a-d1cbd974ea62"],"src":["AU Aarhus University"],"title":"Kip med flaget for lærer og skole","type":"Newspaper Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-226191","year":"2018","yearsub":"2018"}
{"abstract":"Introduction: In addition to the highest incidence rate of lung cancer among the Nordic countries, Denmark has the highest mortality rate. Moreover, rates of tobacco and alcohol consumption are among the highest in these countries. Method: In a population-based matched case/control study, we aimed to assess the association between one-year all-cause mortality and a number of smoking-related parameters, high-risk alcohol intake, and nutritional status in clinical stage I lung cancer patients. Results: We included 221 patients who died within one year after diagnosis (early death) and 410 matched controls who survived more than one year (survivor). The odds ratio (OR) for early death among never-smokers was 0.3 (CI 95%: 0.1–0.9). There was no significant difference between patients who died early and survivors in proportions of current smokers (49 vs. 45%), number of cumulated pack-years (45 vs. 46), daily tobacco consumption (15 vs. 14 cigarettes/day), patients who quit smoking after diagnosis (25 vs. 40%) and the prevalence of chronic obstructive pulmonary disease (COPD) (43 vs. 38%). Patients that died early received more medications for COPD (p = 0.03) and smoked more after diagnosis, 14 vs. 10 cigarettes per day (p = 0.03). The unadjusted OR for high-risk alcohol intake was 2.2 (CI 95% 1.3–3.7) in the early death group vs. the survivors. However, in a treatment-stratified analysis this was observed only for surgically treated patients (OR, 3.2; CI 95% 1.7–6.1). Low nutritional status was associated with early death, unadjusted (OR 2.3; CI 95% 1.4–3.7), while OR was 1.8 (95% CI 1.0–2.3) adjusted for high-risk alcohol intake and COPD. Treatment selection according to and interventions against these factors before and after lung cancer diagnosis may improve outcomes.","author_count":4,"contributors":["Christensen, Niels Lyhne","Løkke, Anders","Dalton, Susanne Oksbjerg","Rasmussen, Torben Riis"],"cuid":["S01-000.00-238235"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Christensen, Niels Lyhne"],"keyword":["Alcohol","Clinical practice","Prognosis","Smoking","Stage I","Tobacco"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-NP","DI-OT","DI-U"],"level3":{"NP":["DI-NP-ALL","DI-NP-CAN"],"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-NP-CAN","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"smoking alcohol and nutritional status in relation to one year mortality in danish stage i lung cancer patients","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85050526307","version":"Other Version"},"id":"S01-000.00-238235","identifier":[{"id":"85050526307","type":"scopus"},{"id":"30268478","type":"pmid"}],"ids":["au-bec7438e-97bd-4c35-a189-6c2d6f559dc6"],"keyword":["Alcohol","Clinical practice","Prognosis","Smoking","Stage I","Tobacco"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-79568509360B3C25631FE93BE9E89A3C"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1},{"affno":"2","country":"dk","key":"dcrc danish cancer society research center","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-CAN","l3nn":"DCRC Danish Cancer Society Research Center","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DCRC Danish Cancer Society Research Center","namevar":["Danish Cancer Society"],"nora_code":"DI-NP-CAN","used":1},{"affno":"3","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University (AU)","Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Respiratory Diseases and Allergy"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1 2 3","corresponding":null,"country":"dk","first":"Niels Lyhne","key":"christensenpau","last":"Christensen","locid":"602d74ce-1885-499c-90da-05dd61bb3148","name":"Christensen, Niels Lyhne","rank":1,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Anders","key":"løkkepau","last":"Løkke","locid":"93e030be-623c-4143-ab57-fb097315970e","name":"Løkke, Anders","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Susanne Oksbjerg","key":"daltonpau","last":"Dalton","name":"Dalton, Susanne Oksbjerg","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Torben Riis","key":"rasmussenpau","last":"Rasmussen","locid":"311942d4-5b0f-4c92-879f-8d32a246ebf6","name":"Rasmussen, Torben Riis","orcid":"0000-0002-7030-9260","rank":4,"rolecode":"pau"}],"pmid":["30268478"],"pub":{"doi":"10.1016/j.lungcan.2018.07.025","issn":["01695002","18728332"],"issn_org":["01695002"],"journal":"Lung Cancer","pages":"40-44","publisher":"Elsevier Ireland Ltd","status":"p","title":"Lung Cancer","volume":"124"},"review":"Peer Reviewed","scoID":["2-s2.0-85050526307"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Non-Profit Organisations","All Universities","DI-ALL","DI-NP","DI-NP-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Non-Profit Organisations","Other Research","Universities"],"PST":["Published"]},"sid":["au-bec7438e-97bd-4c35-a189-6c2d6f559dc6"],"src":["AU Aarhus University"],"title":"Smoking, alcohol, and nutritional status in relation to one-year mortality in Danish stage I lung cancer patients","t