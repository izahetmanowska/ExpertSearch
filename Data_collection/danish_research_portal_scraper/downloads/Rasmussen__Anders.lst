","corresponding":null,"first":"Marco","key":"doniapau","last":"Donia","name":"Donia, Marco","rank":23,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Sine Reker","key":"hadruppau","last":"Hadrup","locid":"f97235ed-98bc-4889-8441-2f1e67076b8e","name":"Hadrup, Sine Reker","orcid":"0000-0002-5937-4344","rank":24,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Inge","key":"mariesvanepau","last":"Marie Svane","name":"Marie Svane, Inge","rank":25,"rolecode":"pau"}],"pmid":["38782542"],"pub":{"doi":"10.1136/jitc-2024-008817","issn":["20511426"],"issue":"5","journal":"Journal for ImmunoTherapy of Cancer","paperid":"e008817","publisher":"BioMed Central Ltd.","status":"p","title":"Journal for ImmunoTherapy of Cancer","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-85194128897"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Private Research","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Governmental Institutions","Other Companies","Private Research","Technical University of Denmark","Universities","University of Copenhagen","evaxion biotech a/s"],"PST":["Published"]},"sid":["dtu-9853c773-d8c9-4fa8-83ef-1bc3fc470251"],"src":["DTU Technical University of Denmark"],"title":"Dose escalation study of a personalized peptide-based neoantigen vaccine (EVX-01) in patients with metastatic melanoma","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-746810","year":"2024","yearsub":"2024"}
{"abstract":"Elever med indvandrerbaggrund ligger fortsat lavere end øvrige elever i PISA-målingen, men forskellen er blevet mindre på flere områder. Det viser PISA Etnisk 2022. Indhold: Denne PISA-delrapport har fokus på elever med indvandrerbaggrund og præsenterer deres resultater i matematik, læsning og naturfag i PISA 2022. Desuden undersøger rapporten betydningen af elevernes baggrunde for deres PISA-resultater og elevernes oplevelse af skolen og skolemiljøet, hvilket også er en del af PISA-undersøgelsen. Elever med indvandrerbaggrund opnår gennemsnitligt lavere PISA-resultater i matematik, læsning og naturfag end elever uden indvandrerbaggrund. PISA 2022 viste, at elever i både Danmark og mange andre lande er faldet markant i matematik og læsning fra seneste PISA-undersøgelse i 2018. Denne rapport viser, at det fald både ses blandt elever med og uden indvandrerbaggrund. Dog er faldet blandt elever med indvandrerbaggrund lidt mindre end blandt øvrige elever, og ser man over en 10-årig periode fra PISA 2012 til 2022, er den gennemsnitlige pointforskel i matematik mellem elever med og uden indvandrerbaggrund faldet: I PISA 2012 var forskellen 67 point, mens den er reduceret til 54 point i PISA 2022. Også i naturfag er forskellen blevet mindre.","author_count":4,"contributors":["Beuchert, Louise","Brandsen, Anders Skarregaard","Christensen, Vibeke Tornhøj","Rasmussen, Daniel"],"cuid":["S01-000.00-751493"],"filters":{"added":"2024-08","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Læsning","Matematik","Naturfag","PISA","Skolemiljø","Trivsel"],"level":"com","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV"],"level3":{"GV":["DI-GV-ALL","DI-GV-VIVE"]},"level3all":["DI-GV-VIVE"]},"review":"pr","rtype":["clu"],"sorti":"pisa etnisk 000000002022 delrapport med fokus på elever med indvandrerbaggrund","src":["vive"],"src-code":["DI-GV-VIVE"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.vive.dk/ws/files/25160249/301336_HR_PISA_ETNISK_2022.pdf","version":"Published Version"},"id":"S01-000.00-751493","ids":["vive-93bae6a4-7452-4f7c-8f0a-766773217433"],"keyword":["Læsning","Matematik","PISA","naturfag","skolemiljø","trivsel"],"lang":"Danish","level":"Commissioned","mra":["Social Science"],"noi":["Local-1-1-61E28F387FD806C421C38F0C9D93C1C2"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.vive.dk/ws/files/25160249/301336_HR_PISA_ETNISK_2022.pdf","version":"Published Version"},{"access":"oa","type":"loc","url":"https://pure.vive.dk/ws/files/25193782/301336_PISA_ETNISK_2022_PDF-UA.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"vive the danish center for social science research","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-VIVE","l3nn":"VIVE The Danish Center for Social Science Research","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"VIVE The Danish Center for Social Science Research","namevar":["VIVE - The Danish Center for Social Science Research, VIVE Children and Education"],"nora_code":"DI-GV-VIVE","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Louise","key":"beuchertpau","last":"Beuchert","locid":"da6b401d-a4c5-480b-b6e3-30e4d7ddec49","name":"Beuchert, Louise","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anders Skarregaard","key":"brandsenpau","last":"Brandsen","locid":"8f741d98-f5ff-474b-a8b6-cdc9ad89f3b0","name":"Brandsen, Anders Skarregaard","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Vibeke Tornhøj","key":"christensenpau","last":"Christensen","locid":"ef14cd00-0c2e-4fe3-8ba1-4fbfae2f9ef4","name":"Christensen, Vibeke Tornhøj","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Daniel","key":"rasmussenpau","last":"Rasmussen","locid":"1205ba61-1f42-4728-84ab-347c02cd6b25","name":"Rasmussen, Daniel","rank":4,"rolecode":"pau"}],"pub":{"pages":"76","publisher":"VIVE - Det Nationale Forsknings- og Analysecenter for Velfærd","status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Governmental Institutions","DI-ALL","DI-GV","DI-GV-ALL","Governmental Institutions"],"PST":["Published"]},"sid":["vive-93bae6a4-7452-4f7c-8f0a-766773217433"],"src":["VIVE The Danish Center for Social Science Research"],"title":"PISA Etnisk 2022 : Delrapport med fokus på elever med indvandrerbaggrund","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-751493","year":"2024","yearsub":"2024"}
{"abstract":"Background: Fecal microbiota transplantation (FMT) and fecal virome transplantation (FVT, sterile filtrated donor feces) have been effective in treating recurrent Clostridioides difficile infections, possibly through bacteriophage-mediated modulation of the gut microbiome. However, challenges like donor variability, costly screening, coupled with concerns over pathogen transfer (incl. eukaryotic viruses) with FMT or FVT hinder their wider clinical application in treating less acute diseases. Methods: To overcome these challenges, we developed methods to broaden FVT’s clinical application while maintaining efficacy and increasing safety. Specifically, we employed the following approaches: (1) chemostat-fermentation to reproduce the bacteriophage FVT donor component and remove eukaryotic viruses (FVT-ChP), (2) solvent-detergent treatment to inactivate enveloped viruses (FVT-SDT), and (3) pyronin-Y treatment to inhibit RNA virus replication (FVT-PyT). We assessed the efficacy of these processed FVTs in a C. difficile infection mouse model and compared them with untreated FVT (FVT-UnT), FMT, and saline. Results: FVT-SDT, FVT-UnT, and FVT-ChP reduced the incidence of mice reaching the humane endpoint (0/8, 2/7, and 3/8, respectively) compared to FMT, FVT-PyT, and saline (5/8, 7/8, and 5/7, respectively) and significantly reduced the load of colonizing C. difficile cells and associated toxin A/B levels. There was a potential elimination of C. difficile colonization, with seven out of eight mice treated with FVT-SDT testing negative with qPCR. In contrast, all other treatments exhibited the continued presence of C. difficile. Moreover, the results were supported by changes in the gut microbiome profiles, cecal cytokine levels, and histopathological findings. Assessment of viral engraftment following FMT/FVT treatment and host-phage correlations analysis suggested that transfer of phages likely were an important contributing factor associated with treatment efficacy. Conclusions: This proof-of-concept study shows that specific modifications of FVT hold promise in addressing challenges related to donor variability and infection risks. Two strategies lead to treatments significantly limiting C. difficile colonization in mice, with solvent/detergent treatment and chemostat propagation of donor phages emerging as promising approaches. DixucG6bYNjUQ1q5irdn5dVideo Abstract","author_count":14,"contributors":["Rasmussen, Torben Sølbeck","Mao, Xiaotian","Forster, Sarah","Larsen, Sabina Birgitte","Von Münchow, Alexandra","Tranæs, Kaare Dyekær","Brunse, Anders","Larsen, Frej","Castro-Mejía, Josué L.","Adamberg, Signe","Hansen, Axel Kornerup","Adamberg, Kaarel","Hansen, Camilla Hartmann Friis","Nielsen, Dennis Sandris"],"cuid":["S01-000.00-754370"],"filters":{"added":"2024-09","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Estonia"],"glorg":["All Global Affiliations","Tallinn University of Technology"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"overcoming donor variability and risks associated with fecal microbiota transplants through bacteriophage mediated treatments","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s40168-024-01820-1","version":"Published Version"},"id":"S01-000.00-754370","identifier":[{"id":"38951925","type":"pmid"},{"id":"PMC11218093","type":"pmcid"},{"id":"85197723758","type":"scopus"}],"ids":["ku-44505a00-701c-4372-b84b-534fc60fdb5a"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-737612E5A23D9A20AF66519EC2618E40"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s40168-024-01820-1","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/399669835/s40168_024_01820_1.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Food Science, Food Microbiology, Gut Health, and Fermentation"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"ee","key":"tallinn university of technology","loc":["Estonia","Europe, EU","OECD"],"name":"Tallinn University of Technology","used":1}],"person":[{"affno":"1","country":"dk","first":"Torben Sølbeck","key":"rasmussentorbensølbeckpau","last":"Rasmussen","locid":"37b31216-f69f-4ff3-bc9c-ffd6b36fc003","name":"Rasmussen, Torben Sølbeck","orcid":"0000-0002-9907-8953","rank":1,"rolecode":"pau"},{"affno":"1","first":"Xiaotian","key":"maoxiaotianpau","last":"Mao","locid":"b95866c7-bb3f-4bc8-be38-fc921bb75a01","name":"Mao, Xiaotian","orcid":"0000-0001-9425-683X","rank":2,"rolecode":"pau"},{"affno":"1","first":"Sarah","key":"forstersarahpau","last":"Forster","name":"Forster, Sarah","rank":3,"rolecode":"pau"},{"affno":"1","first":"Sabina Birgitte","key":"larsensabinabirgittepau","last":"Larsen","name":"Larsen, Sabina Birgitte","rank":4,"rolecode":"pau"},{"affno":"1","first":"Alexandra","key":"vonmünchowalexandrapau","last":"Von Münchow","locid":"be50440b-7d31-41d3-9962-622c2a44af93","name":"Von Münchow, Alexandra","orcid":"0000-0003-2288-7047","rank":5,"rolecode":"pau"},{"affno":"1","first":"Kaare Dyekær","key":"tranæskaaredyekærpau","last":"Tranæs","locid":"2a68803f-02c6-4a29-969d-8b9062a3c980","name":"Tranæs, Kaare Dyekær","rank":6,"rolecode":"pau"},{"affno":"1","first":"Anders","key":"brunseanderspau","last":"Brunse","locid":"1413cafd-59f7-49d5-9c9b-00f