{"author_count":2,"contributors":["Rasmussen, Anders Bo"],"cuid":["S01-000.00-580796"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Civil war","Collective memory","Identity","Reenactment","Regionalism"],"level":"pop","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"und","rtype":["clu"],"sorti":"slaget om historien kæmpes stadig ved gettysburg","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-580796","ids":["sdu-1a7b5ecc-20bd-4b9c-95e6-f4a9fc46f98f"],"keyword":["Civil War","Collective memory","Identity","Reenactment","Regionalism"],"lang":"Danish","level":"Popular","mra":["Humanities"],"noi":["Local-1-1-651B03240032D1792E52147172DA5333"],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Humanities, Department of History","SDU, Faculty of Humanities, Department of History, Center for American Studies"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Anders Bo","key":"rasmussenpau","last":"Rasmussen","locid":"f284f3a3-297f-4882-81e1-b591c41ead80","name":"Rasmussen, Anders Bo","orcid":"0000-0001-9817-9595","rank":1,"rolecode":"pau"},{"affno":"","first":"Anders Agner","key":"pedersenpedh","last":"Pedersen","name":"Pedersen, Anders Agner","rank":2,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"edition":"2.","isbn":["9788771288919"],"pages":"435-452","place":"København","publisher":"Forlaget Rosenkilde","status":"p","title":"Glimt af America"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-1a7b5ecc-20bd-4b9c-95e6-f4a9fc46f98f"],"src":["SDU University of Southern Denmark"],"title":"Slaget om historien kæmpes stadig ved Gettysburg","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-580796","year":"2015","yearsub":"2015"}
{"abstract":"INTRODUCTION: Using multidetector computed tomography, we aimed to assess the early response of neoadjuvant drug therapy for locally advanced colon cancer. METHODS: Computed tomography with IV contrast was acquired from 67 patients before and after up to three cycles of preoperative treatment. All patients had histologically confirmed colon cancer, a T4 or T3 tumour with extramural invasion ≥ 5 mm and no distant metastases or peritoneal nodules. The patients were treated with oxaliplatin and capecitabine. In addition, those with no mutations in the KRAS, BRAF and PIK3CA genes were also treated with panitumumab. Before and after treatment, we measured the tumour diameter in two different planes, the extension of the extramural tumour invasion, and the number and size of enlarged lymph nodes. RESULTS: The mean tumour length was 7.8 cm (95% confidence interval (CI): 5.3-10.4) at baseline and 4.34 cm (95% CI: 4.0-4.9) after treatment. The mean extramural tumour invasion was 10.6 mm (95% CI: 9.5-11.8) at baseline and 5.7 mm (95% CI: 4.7-6.7) after treatment. The mean number of enlarged lymph nodes was 4.1 (95% CI: 3.4-4.9) at baseline and 2.1 (95% CI: 1.4-2.7) after treatment. According to RECIST 1.1, 45% (95% CI: 34-57) of the patients had a response and 55% (95% CI: 43-67) had stable disease. None of the patients showed progressive disease. CONCLUSION: Using CT, we demonstrated a significant reduction in tumour size, extramural tumour invasion, number and size of enlarged lymph nodes following neoadjuvant treatment. FUNDING: not relevant. TRIAL REGISTRATION: Registered with ClinicalTrials.gov (NCT 01108107).","author_count":5,"contributors":["Dam, Claus","Lund-Rasmussen, Vera","Pløen, John","Jakobsen, Anders","Rafaelsen, Søren Rafael"],"cuid":["S01-000.00-601721"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["CT scanning","Chemotherapy Adjuvant","Colon cancer","Colonic cancer","Neoadjuvant Therapy"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"computed tomography assessment of early response to neoadjuvant therapy in colon cancer","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84936777047","version":"Other Version"},"id":"S01-000.00-601721","identifier":[{"id":"84936777047","type":"scopus"},{"id":"26183044","type":"pmid"}],"ids":["sdu-63a63282-7708-4ef7-a227-c88ceb79e2b5"],"keyword":["CT-scanning","Chemotherapy, Adjuvant","Colon Cancer","Neoadjuvant Therapy","colonic cancer"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-9661A8F7F2441CB5E19EB280977CFF8F"],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Lillebælt Hospital","SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Lillebælt Hospital, Research Unit of Radiology (Vejle)","SDU, The Faculty of Health Sciences, Department of Regional Health Research, Vejle Hospital"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Herlev Hospital"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Claus","key":"dampau","last":"Dam","locid":"103f5188-29ea-414d-ac02-ab5253a7e41b","name":"Dam, Claus","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Vera","key":"lundrasmussenpau","last":"Lund-Rasmussen","name":"Lund-Rasmussen, Vera","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"John","key":"pløenpau","last":"Pløen","locid":"66df5d1a-fea1-429b-954d-c635ef4364bb","name":"Pløen, John","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders","key":"jakobsenpau","last":"Jakobsen","locid":"6c772581-e8fe-48bc-a932-1d1c5122c25a","name":"Jakobsen, Anders","orcid":"0000-0003-2110-2615","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Rafael","key":"rafaelsenpau","last":"Rafaelsen","locid":"89253a87-a28b-4cb9-aa20-ded9a9d49536","name":"Rafaelsen, Søren Rafael","orcid":"0000-0001-5182-5545","rank":5,"rolecode":"pau"}],"pmid":["26183044"],"pub":{"issn":["09078916","22451919"],"issn_org":["22451919"],"issue":"7","journal":"Danish Medical Journal","pages":"1-5","paperid":"A5103","publisher":"Lægeforeningen","status":"p","title":"Danish Medical Journal","volume":"62"},"review":"Peer Reviewed","scoID":["2-s2.0-84936777047"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-63a63282-7708-4ef7-a227-c88ceb79e2b5"],"src":["SDU University of Southern Denmark"],"title":"Computed tomography assessment of early response to neoadjuvant therapy in colon cancer","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-601721","year":"2015","yearsub":"2015"}
