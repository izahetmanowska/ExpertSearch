870156","15461696"],"issn_org":["10870156"],"issue":"3","journal":"Nature Biotechnology","pages":"399-408","publisher":"Nature Research","status":"p","title":"Nature Biotechnology","volume":"41"},"review":"Peer Reviewed","scoID":["2-s2.0-85145508974"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-0673c22b-1410-4518-b3fb-51b4e20af2bc","ku-88eb674c-a6cf-4bab-b529-a9e4015dbaec"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Discovery of drug-omics associations in type 2 diabetes with generative deep-learning models : [with Author Correction]","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-096.16-672879","year":"2023","yearsub":"2023"}
{"abstract":"Key Points - Trial-based case definitions assume close patient monitoring that captures both clinical and subclinical disease manifestations. Adapting such definitions as reference standards to validate cases in observational studies of routinely collected data is therefore challenging. - In validation studies, trial-based case definitions should be calibrated to reflect routine medical care. - When multiple databases are involved in a validation study, database- and country-specific differences in the availability and completeness of the required information should be taken into account. - Researchers should also consider more than one validation approach to ensure cases are accurately captured; additionally, procedures for quantifying uncertainty should be explored. - Results from validations of case definitions in routinely collected data should be appropriately interpreted in light of how the case definitions were derived.","author_count":17,"contributors":["Arena, Patrick J.","Huang, Kui","Löfling, Lukas","Bahmanyar, Shahram","Mo, Jingping","Schachterle, Stephen E.","Nunes, Anthony P.","Smits, Elisabeth","Juuti, Rosa","Hoti, Fabian","Korhonen, Pasi","Adelborg, Kasper","Sundbøll, Jens","Rasmussen, Torben Riis","Løkke, Anders","Ehrenstein, Vera"],"cuid":["S02-096.60-666401"],"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","Europe, EU","Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Huang, Kui"],"country":["Finland","Netherlands","Norway","Sweden","United States"],"glorg":["All Global Affiliations","Cancer Registry of Norway","EPID Research","Karolinska Institute","Karolinska Institutet","Optum Inc.","PHARMO Institute","PHARMO Institute for Drug Outcomes Research","Pfizer Inc","UnitedHealth Group","University of California at Los Angeles","University of Massachusetts","University of Massachusetts Medical School","University of Southern California"],"keyword":["Denmark","Finland","Kinase inhibitors","Lung cancer","Routinely collected data","Safety outcomes","Sweden","The Netherlands","United States","Validation study"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-CDR","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"validation of safety outcomes in routinely collected data lessons learned from a multinational postapproval safety study","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"djc","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1002/pds.5582","version":"Published Version"},"id":"S02-096.60-666401","identifier":[{"id":"85145290505","type":"scopus"},{"id":"36495188","type":"pmid"}],"ids":["au-a6145f1a-f724-41c9-a273-8fcd819dd071","sdu-f0e845a8-4602-4ec4-8059-70c333ec6f93"],"keyword":["Denmark","Finland","Sweden","United States","kinase inhibitors","lung cancer","routinely collected data","safety outcomes","the Netherlands","validation study"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-6B07D4AA0C5FB1586010B493B79B7216"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/221089181/Pharmacoepidemiology_and_Drug_2022_Arena_Validation_of_safety_outcomes_in_routinely_collected_data_Lessons_learned.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1002/pds.5582","version":"Published Version"}],"org":[{"affno":"1","country":"us","key":"pfizer inc","loc":["United States","America, North","OECD"],"name":"Pfizer Inc","used":1},{"affno":"2","country":"us","key":"university of california at los angeles","loc":["United States","America, North","OECD"],