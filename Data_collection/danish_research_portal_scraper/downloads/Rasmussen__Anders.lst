evar":["Københavns Universitet, Faculty of Social Sciences, Department of Psychology, Department of Psychology"],"nora_code":"DI-U-KU","used":1},{"affno":"4","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, Research Unit of Child and Adolescent Psychiatry (Southern Denmark)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","first":"Kristina","key":"aagaardpau","last":"Aagaard","name":"Aagaard, Kristina","rank":1,"rolecode":"pau"},{"affno":"1","first":"Jens Richardt Møllegaard","key":"jepsenpau","last":"Jepsen","name":"Jepsen, Jens Richardt Møllegaard","rank":2,"rolecode":"pau"},{"affno":"1","first":"Astrid","key":"sevelstedpau","last":"Sevelsted","name":"Sevelsted, Astrid","rank":3,"rolecode":"pau"},{"affno":"1","first":"David","key":"hornerpau","last":"Horner","name":"Horner, David","rank":4,"rolecode":"pau"},{"affno":"1","first":"Rebecca","key":"vindingpau","last":"Vinding","name":"Vinding, Rebecca","rank":5,"rolecode":"pau"},{"affno":"1","first":"Julie Bøjstrup","key":"rosenbergpau","last":"Rosenberg","name":"Rosenberg, Julie Bøjstrup","rank":6,"rolecode":"pau"},{"affno":"1","first":"Nicklas","key":"brustadpau","last":"Brustad","name":"Brustad, Nicklas","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Anders","key":"eliasenpau","last":"Eliasen","locid":"65035866-6e6c-4ac5-b1a2-e92d04cbe8aa","name":"Eliasen, Anders","rank":8,"rolecode":"pau"},{"affno":"1","first":"Parisa","key":"mohammadzadehpau","last":"Mohammadzadeh","name":"Mohammadzadeh, Parisa","rank":9,"rolecode":"pau"},{"affno":"1","first":"Nilofar","key":"følsgaardpau","last":"Følsgaard","name"