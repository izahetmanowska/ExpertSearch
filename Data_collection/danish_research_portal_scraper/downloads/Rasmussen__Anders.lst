00-0003-0132-8182","rank":8,"rolecode":"pau"},{"affno":"4","first":"Henrik","key":"kehletpau","last":"Kehlet","locid":"0a3c43a0-a0c5-4a91-85d6-6e80e16af8b5","name":"Kehlet, Henrik","orcid":"0000-0002-2209-1711","rank":9,"rolecode":"pau"},{"affno":"4","first":"Nicolai B.","key":"fosspau","last":"Foss","locid":"dc8c28e3-27ee-4329-8985-2b176ab69b4b","name":"Foss, Nicolai Bang","name_org":"Foss, Nicolai B.","rank":10,"rolecode":"pau"}],"pmid":["36695403"],"pub":{"doi":"10.1111/aas.14207","issn":["00015172"],"issue":"5","journal":"Acta Anaesthesiologica Scandinavica","pages":"675-681","publisher":"Wiley","status":"p","title":"Acta Anaesthesiologica Scandinavica","volume":"67"},"review":"Peer Reviewed","scoID":["2-s2.0-85147432376"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-fc4c6dc3-d477-4c24-8b02-10f9bc6683fa","sdu-8e4e782b-5dba-41c9-b9b2-5eda2524d9df"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Repeat dose steroid in high pain responders after total knee arthroplasty : A study protocol","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-088.93-673189","year":"2023","yearsub":"2023"}
{"abstract":"The gut microbiome is shaped through infancy and impacts the maturation of the immune system, thus protecting against chronic disease later in life. Phages, or viruses that infect bacteria, modulate bacterial growth by lysis and lysogeny, with the latter being especially prominent in the infant gut. Viral metagenomes (viromes) are difficult to analyse because they span uncharted viral diversity, lacking marker genes and standardized detection methods. Here we systematically resolved the viral diversity in faecal viromes from 647 1-year-olds belonging to Copenhagen Prospective Studies on Asthma in Childhood 2010, an unselected Danish cohort of healthy mother–child pairs. By assembly and curation we uncovered 10,000 viral species from 248 virus family-level clades (VFCs). Most (232 VFCs) were previously unknown, belonging to the Caudoviricetes viral class. Hosts were determined for 79% of phage using clustered regularly interspaced short palindromic repeat spacers within bacterial metagenomes from the same children. Typical Bacteroides-infecting crAssphages were outnumbered by undescribed phage families infecting Clostridiales and Bifidobacterium. Phage lifestyles were conserved at the viral family level, with 33 virulent and 118 temperate phage families. Virulent phages were more abundant, while temperate ones were more prevalent and diverse. Together, the viral families found in this study expand existing phage taxonomy and provide a resource aiding future infant gut virome research.","author_count":26,"contributors":["Shah, Shiraz A.","Deng, Ling","Thorsen, Jonathan","Pedersen, Anders Gorm","Dion, Moïra B.","Castro-Mejía, Josué L.","Silins, Ronalds","Romme, Fie O.","Sausset, Romain","Jessen, Leon Eyrich","Ndela, Eric Olo","Hjelmsø, Mathis","Rasmussen, Morten A.","Redgwell, Tamsin A.","Leal Rodríguez, Cristina","Vestergaard, Gisle","Zhang, Yichang","Chawes, Bo","Bønnelykke, Klaus","Sørensen, Søren J.","Bisgaard, Hans","Enault, Francois","Stokholm, Jakob","Moineau, Sylvain","Petit, Marie Agnès","Nielsen, Dennis S."],"cuid":["S02-099.50-666697"],"filters":{"added":"2023-06","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","Europe, EU","OECD"],"corresponding_author":["Nielsen, Dennis S.","Shah, Shiraz A."],"country":["Canada","France"],"glorg":["All Global Affiliations","Laval University","Paris-Saclay University","University of Clermont Auvergne","Université Clermont Auvergne","Université Laval","Université Paris-Saclay"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"expanding known viral diversity in the healthy infant gut","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41564-023-01345-7","version":"Published Version"},"funding_acknowledgement":["We express our deepest gratitude to the children and families of the COPSAC2010 cohort study for all their support and commitment. We acknowledge and appreciate the unique efforts of the COPSAC research team. This work is supported by the Joint Programming Initiative ‘Healthy Diet for a Healthy Life’, specifically here, the Danish Agency for Science and Higher Education, Institut National de la Recherche pour l’Agriculture, l’Alimentation et l’Environnement (INRAE), and the Canadian Institutes of Health Research (Team grant on Intestinal Microbiomics, Institute of Nutrition, Metabolism, and Diabetes, grant number 143924). M.B.D. is recipient of graduate scholarships from the Fonds de Recherche du Québec—Nature et Technologies (259257) as well as Sentinel North and is a recipient of the Goran-Enhorning Graduate Student Research Award from the Canadian Allergy, Asthma and Immunology Foundation. J.T. is supported by the BRIDGE Translational Excellence Program (bridge.ku.dk) at the Faculty of Health and Medical Sciences, University of Copenhagen, funded by the Novo Nordisk Foundation (grant no. NNF18SA0034956). S.M. holds the Tier 1 Canada Research Chair in Bacteriophages (950-232136). S.A.S. is a recipient of a Novo Nordisk Foundation project grant in basic bioscience (NNF18OC0052965), along with M.A.R., J.S. and D.S.N. are recipients of Novo Nordisk Foundation grant NNF20OC0061029."],"id":"S02-099.50-666697","identifier":[{"id":"PMC10159846","type":"pmcid"},{"id":"000966592700003","type":"wos"},{"id":"37037943","type":"pmid"},{"id":"85152465966","type":"scopus"}],"ids":["dtu-bc4de17c-0937-4dd3-a736-f576f6e6c0bd","ku-43016fe6-a1a5-4617-9ec9-d2c53a61b291"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-C25EF1ECFD13D7364D4BB6368AEF98FC"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/320582124/s41564_023_01345_7.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41564-023-01345-7","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/346061810/Expanding_known_viral_diversity_in_the_healthy_infant_gut.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OE