{"abstract":"This is a protocol for a Cochrane Review (Intervention). The objectives are as follows: To assess the benefits and harms of higher versus lower inspiratory oxygen fraction or targets of arterial oxygenation in adults in intensive care units.","author_count":9,"contributors":["Barbateskovic, Marija","Schjørring, Olav Lilleholt","Jakobsen, Janus C.","Meyhoff, Christian S.","Dahl, Rikke M.","Rasmussen, Bodil Steen","Perner, Anders","Wetterslev, Jørn"],"cuid":["S02-094.20-001689"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Barbateskovic, Marija"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-AAU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"higher versus lower inspiratory oxygen fraction or targets of arterial oxygenation for adult intensive care patients","src":["aau","ku"],"src-code":["DI-U-AAU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S02-094.20-001689","identifier":[{"id":"85018340941","type":"scopus"}],"ids":["aau-2163e9c3-3130-4b39-954f-eb7f08405ed5","ku-9ed63554-fe0e-4027-bc92-f4cb7a7fa646"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-7D7940F6337415975DD269C8C1EC9E34"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Anæstesi og Intensiv [Klinik Akut]","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Akut"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Rigshospitalet, Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Anaesthesiology","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Marija","key":"barbateskovicpau","last":"Barbateskovic","name":"Barbateskovic, Marija","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Olav","key":"lilleholtschjørringpau","last":"Lilleholt Schjørring","locid":"7dac619e-9b5c-46ac-9170-10ac13165da5","name":"Schjørring, Olav Lilleholt","name_org":"Lilleholt Schjørring, Olav","rank":2,"rolecode":"pau"},{"affno":"","first":"Olav L.","key":"schjørringpau","last":"Schjørring","name":"Schjørring, Olav L.","rank":2,"rolecode":"pau"},{"affno":"","first":"Janus C.","key":"jakobsenpau","last":"Jakobsen","name":"Jakobsen, Janus C.","rank":3,"rolecode":"pau"},{"affno":"3","first":"Christian S.","key":"meyhoffpau","last":"Meyhoff","locid":"4d112eed-e878-476d-8f1f-df10d39439b2","name":"Meyhoff, Christian S.","orcid":"0000-0002-4885-4609","rank":4,"rolecode":"pau"},{"affno":"","first":"Rikke M.","key":"dahlpau","last":"Dahl","name":"Dahl, Rikke M.",