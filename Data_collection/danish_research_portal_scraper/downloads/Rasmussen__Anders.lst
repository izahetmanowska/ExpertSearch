_et_al_2020_Mortality_and_HRQoL_in_ICU_patients_with_delirium.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1111/aas.13679","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Zealand University Hospital - Køge"],"nora_code":"DI-HO-ZEA","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Anaesthesiology","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"3","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Anaesthesiology and Intensive Care","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Anæstesi, Børn, Kredsløb og Kvinder","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-AAU","used":1},{"affno":"4","country":"dk","key":"north denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-NDR","l3nl":"North Denmark Region","l3nn":"North Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"North Denmark Region","namevar":["Aalborg University Hospital"],"nora_code":"DI-HO-NDR","used":1},{"affno":"5","country":"fi","key":"university of helsinki","loc":["Finland","Europe, EU","Nordic","OECD"],"name":"University of Helsinki","used":1},{"affno":"6","country":"es","key":"autonomous university of barcelona","loc":["Spain","Europe, EU","OECD"],"name":"Autonomous University of Barcelona","used":1},{"affno":"7","country":"gb","key":"cardiff university","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Cardiff University","used":1},{"affno":"8","country":"it","key":"university of milano bicocca","loc":["Italy","Europe, EU","OECD"],"name":"University of Milano Bicocca","used":1},{"affno":"9","country":"se","key":"lund university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Lund University","used":1}],"person":[{"affno":"1","first":"Camilla B.","key":"mortensenpau","last":"Mortensen","name":"Mortensen, Camilla B.","rank":1,"rolecode":"pau"},{"affno":"1","first":"Lone M.","key":"poulsenpau","last":"Poulsen","name":"Poulsen, Lone M.","rank":2,"rolecode":"pau"},{"affno":"1","first":"Nina C.","key":"andersenranbergpau","last":"Andersen-Ranberg","name":"Andersen-Ranberg, Nina C.","rank":3,"rolecode":"pau"},{"affno":"2","first":"Anders","key":"pernerpau","last":"Perner","locid":"8a389541-d529-4ee3-8364-66bfc85f77c9","name":"Perner, Anders","rank":4,"rolecode":"pau"},{"affno":"2","first":"Theis","key":"langepau","last":"Lange","locid":"e4664578-01fc-4a93-8efd-1dbffb72cdd6","name":"Lange, Theis","orcid":"0000-0001-6807-8347","rank":5,"rolecode":"pau"},{"affno":"1","first":"Stine S.","key":"estruppau","last":"Estrup","name":"Estrup, Stine S.","rank":6,"rolecode":"pau"},{"affno":"2","first":"Bjørn H.","key":"ebdruppau","last":"Ebdrup","locid":"0de576bf-a78e-45a2-baa6-5273c025cfa5","name":"Ebdrup, Bjørn H.","rank":7,"rolecode":"pau"},{"affno":"2","first":"Ingrid","key":"egerodpau","last":"Egerod","locid":"ea1afcef-507d-4b0a-bb0e-793eadbbab3e","name":"Egerod, Ingrid","rank":8,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"country":"dk","first":"Bodil S","key":"rasmussenpau","last":"Rasmussen","locid":"3162c449-94c3-4d28-8dbb-c134d6eb76e1","name":"Rasmussen, Bodil Steen","name_org":"Rasmussen, Bodil S","orcid":"0000-0003-2190-145X","rank":9,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Johanna","key":"hästbackapau","last":"Hästbacka","name":"Hästbacka, Johanna","rank":10,"rolecode":"pau"},{"affno":"5","first":"Johanna","key":"hastbackapau","last":"Hastbacka","name":"Hastbacka, Johanna","rank":10,"rolecode":"pau"},{"affno":"6","first":"Jesus","key":"caballeropau","last":"Caballero","name":"Caballero, Jesus","rank":11,"rolecode":"pau"},{"affno":"7","first":"Giuseppe","key":"citeriopau","last":"Citerio","name":"Citerio, Giuseppe","rank":12,"rolecode":"pau"},{"affno":"8","first":"Matthew P. G.","key":"morganpau","last":"Morgan","name":"Morgan, Matthew P. G.","rank":13,"rolecode":"pau"},{"affno":"9","first":"Karin","key":"samuelsonpau","last":"Samuelson","name":"Samuelson, Karin","rank":14,"rolecode":"pau"},{"affno":"3 1 2","corresponding":null,"first":"Ole","key":"mathiesenpau","last":"Mathiesen","locid":"31a4dd8e-8351-4c91-8782-e10ac6cc3a05","name":"Mathiesen, Ole","orcid":"0000-0003-4544-0619","rank":15,"rolecode":"pau"}],"pmid":["33460045"],"pub":{"doi":"10.1111/aas.13679","issn":["00015172"],"issue":"10","journal":"Acta Anaesthesiologica Scandinavica","pages":"1519-1525","publisher":"Blackwell Munksgaard","status":"p","title":"Acta Anaesthesiologica Scandinavica","volume":"64"},"review":"Peer Reviewed","scoID":["2-s2.0-85089445339"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Region Zealand","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-20e6af3b-d214-42fe-bc5c-49ed4b363aff","ku-14bd7159-9f6b-49a5-9fcc-f5d1e431f963"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"Mortality and HRQoL in ICU patients with delirium : Protocol for 1-year follow-up of AID-ICU trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-087.53-001660","year":"2020","yearsub":"2020"}
{"abstract":"OBJECTIVES: Singing is considered a beneficial leisure time intervention for people with respiratory diseases, and lung choirs have gained increasing attention. However, there is no available guideline on preferred methodology, and hence, outcomes, delivery, and benefits are unclear. The present study investigated for the first time ever emerged delivery, approach, and experiences in Danish lung choirs and their singing leaders, hypothesising the array to be heterogeneous, without disease-specific approach, and a challenging field to navigate for the singing leaders. SETTING: An online survey comprising 25 questions was performed individually, May 2017, in Denmark. PARTICIPANTS: Current singing leaders of Danish lung choirs, identified by hand searches on the internet. In total, 33 singing leaders in formal and informal settings were identified and 20 (67%) responded. PRIMARY AND SECONDARY OUTCOME MEASURES: Distribution in content, delivery, and approach; level of disease-specific knowledge and modification; experience of challenges and benefits. Quantitative variables were counted, and an inductive content analysis approach was used for the qualitative study component. RESULTS: The lung choirs were heterogeneous concerning setting, duration, and content. The approach was traditional without disease-specific content or physical activity. Most singing leaders held various academic degrees in music, but lacked skills in lung diseases. However, they experienced lung choirs as a highly meaningful activity, and reported that participants benefited both musically, psychosocially, and physically. Singing leaders were enthusiastic regarding potentials in the 'arts-and-health' cross-field and experienced an expansion of their role and overall purpose, professionally as well as personally. However, they also experienced insecurity, inadequacy, and isolation, and requested methodological guidelines, formal support, and peer network. CONCLUSION: Danish lung choirs are led without any disease-specific guideline or methodological approach. Further studies are needed to develop and distribute a preferred methodological approach. TRIAL REGISTRATION NUMBER: This study is linked to clinical trial number NCT03280355 and was performed prior to data collection and results of the clinical trial.","author_count":7,"contributors":["Kaasgaard, Mette","Andersen, Ingrid Charlotte","Rasmussen, Daniel Bech","Hilberg, Ole","Løkke, Anders","Vuust, Peter","Bodtger, Uffe"],"cuid":["S02-100.00-024160"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Kaasgaard, Mette"],"keyword":["Chronic airways disease","Rehabilitation medicine","thoracic medicine"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-ART","DI-HO","DI-U"],"level3":{"ART":["DI-ART-ALL","DI-ART-RDAM"],"HO":["DI-HO-ALL","DI-HO-ZEA"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-ART-RDAM","DI-HO-ZEA","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"heterogeneity in danish lung choirs and their singing leaders delivery approach and experiences a survey based study","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/bmjopen-2020-041700","version":"Published Version"},"id":"S02-100.00-024160","identifier":[{"id":"85097034868","type":"scopus"},{"id":"PMC7705518","type":"pmcid"},{"id":"33257493","type":"pmid"}],"ids":["au-9d6dfaa6-82eb-44f2-b70f-a4690d3074e6","sdu-d90158c2-51fc-47bb-a487-91e1974b1c5d"],"keyword":["chronic airways disease","rehabilitation medicine","thoracic medicine"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-5ED4792923BB64DE7338388419CABABA"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/bmjopen-2020-041700","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/175868769/e041700.full.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Center for Music In the Brain"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Næstved, Slagelse, Ringsted Hospitals (NSR), Research Unit of Medicine (Slagelse)"],"nora_code":"DI-U-SDU","used":1},{"affno":"4","country":"dk","key":"rdam the royal danish academy of music","l2":"DI-ART","l2n":"Artistic Higher Education Institutions","l3":"DI-ART-RDAM","l3nn":"RDAM The Royal Danish Academy of Music","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RDAM The Royal Danish Academy of Music","namevar":["Royal Academy of Music"],"nora_code":"DI-ART-RDAM","used":1},{"affno":"5","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Zealand University Hospital, Roskilde"],"nora_code":"DI-HO-ZEA","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"Mette","key":"kaasgaardpau","last":"Kaasgaard","locid":"fc5784b6-66d8-4b92-8c4a-74bf4628c9c3","name":"Kaasgaard, Mette","orcid":"0000-0003-3833-2943","rank":1,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Ingrid Charlotte","key":"andersenpau","last":"Andersen","locid":"75cc4ddc-f191-495e-9399-e1063e12e9df","name":"Andersen, Ingrid Charlotte","orcid":"0000-0003-2558-0673","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Daniel Bech","key":"rasmussenpau","last":"Rasmussen","locid":"18525822-35fd-4cd8-afdd-a608be44cc84","name":"Rasmussen, Daniel Bech","orcid":"0000-0003-1213-9483","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Ole","key":"hilbergpau","last":"Hilberg","locid":"6c545c65-1d94-45a3-a8b4-f90eae06d248","name":"Hilberg, Ole","orcid":"0000-0002-3075-3463","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Anders","key":"løkkepau","last":"Løkke","locid":"db3d3870-0459-4783-8f0b-6a8e5d9dce78","name":"Løkke, Anders","orcid":"0000-0002-6905-4141","rank":5,"rolecode":"pau"},{"affno":"1 4","corresponding":null,"country":"dk","first":"Peter","key":"vuustpau","last":"Vuust","locid":"2c697ab6-9b06-4a16-a687-c8cdbd56f661","name":"Vuust, Peter","rank":6,"rolecode":"pau"},{"affno":"3 5","corresponding":null,"first":"Uffe","key":"bodtgerpau","last":"Bodtger","locid":"2f4e70da-63bb-4b8d-af09-2a959d6df5e8","name":"Bodtger, Uffe","orcid":"0000-0002-1231-9209","rank":7,"rolecode":"pau"}],"pmid":["33257493"],"pub":{"doi":"10.1136/bmjopen-2020-041700","issn":["20446055"],"issue":"11","journal":"BMJ Open","paperid":"e041700","publisher":"BMJ Publishing Group","status":"p","title":"BMJ Open","volume":"10"},"review":"Peer Reviewed","scoID":["2-s2.0-85097034868"],"search":{"DAF":["Aarhus University","All Artistic Higher Education Institutions","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Artistic Higher Education Institutions","DI-ALL","DI-ART","DI-ART-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Region Zealand","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-9d6dfaa6-82eb-44f2-b70f-a4690d3074e6","sdu-d90158c2-51fc-47bb-a487-91e1974b1c5d"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Heterogeneity in Danish lung choirs and their singing leaders : delivery, approach, and experiences: a survey-based study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-024160","year":"2020","yearsub":"2020"}
{"abstract":"Magnetic gears with an integrated permanent magnet machine provides advantages within the field of wind turbine drive trains compared to both mechanically geared generators due to non physical contact between rotors as well as direct driven generators where size and weight can be reduced. Theoretical and practical benchmark of the technology against commercial direct drive generators with regards to material use and performance is yet to be found in the literature. In this article, a magnetically geared permanent magnet generator is designed with operational specifications based on a commercial 3.5 kW permanent magnet generator designed for direct drive wind turbines. A demonstrator is fabricated and the design models are validated experimentally. Performance and material use for both the demonstrator and the direct drive generator is mapped. The experimentally verified results are used for benchmarking and the comparison shows promising results as both size and weight is significantly reduced for similar performance. It is also found that the material consumption is reduced, and contrary to popular belief, the use of magnet material in the magnetically geared machine is actually less than that of the benchmark generator.","author_count":5,"contributors":["Kjær, Anders Byrdal","Korsgaard, Steffen","Nielsen, Simon Staal","Demsa, Lorand","Rasmussen, Peter Omand"],"cuid":["S01-000.00-052044"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Benchmark","Magnetic gears","Mechanical design","Model validation","Permanent magnet generator","Wind power"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-VES"],"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-PR-VES","DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"design fabrication test and benchmark of a magnetically geared permanent magnet generator for wind power generation","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85080953711&partnerID=8YFLogxK","version":"Other Version"},"id":"S01-000.00-052044","identifier":[{"id":"85080953711","type":"scopus"}],"ids":["aau-06f94b93-092d-49a6-b95a-11d7b2537ad1"],"keyword":["Benchmark","magnetic gears","mechanical design","model validation","permanent magnet generator","wind power"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-87ECF7D73CDDA694A775294E9EB91637"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, AAU Energy","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Electrical Machines"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"vestas","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-VES","l3nl":"Vestas Wind Systems","l3nn":"Vestas","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Vestas","namevar":["Vestas Wind Systems AS"],"nora_code":"DI-PR-VES","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anders Byrdal","key":"kjærpau","last":"Kjær","locid":"fb2f0dc9-1269-4f5b-b62b-907ec5a7fb19","name":"Kjær, Anders Byrdal","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Steffen","key":"korsgaardpau","last":"Korsgaard","locid":"823129f3-4778-4edb-be77-bf95bbfc60e6","name":"Korsgaard, Steffen","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Simon Staal","key":"nielsenpau","last":"Nielsen","locid":"4de25bba-0633-497c-a3b7-68d936e1c5e8","name":"Nielsen, Simon Staal","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lorand","key":"demsapau","last":"Demsa","name":"Demsa, Lorand","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter Omand","key":"rasmussenpau","last":"Rasmussen","locid":"13f9644b-1262-4526-8c71-19d53d340684","name":"Rasmussen, Peter Omand","orcid":"0000-0003-1022-3681","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1109/tec.2019.2951998","issn":["08858969"],"issue":"1","journal":"IEEE Transactions on Energy Conversion","pages":"24-32","paperid":"8894133","publisher":"IEEE (Institute of Electrical and Electronics Engineers)","status":"p","title":"IEEE Transactions on Energy Conversion","title_org":"I E E E Transactions on Energy Conversion","volume":"35"},"review":"Peer Reviewed","scoID":["2-s2.0-85080953711"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Private Research","Universities","Vestas Wind Systems"],"PST":["Published"]},"sid":["aau-06f94b93-092d-49a6-b95a-11d7b2537ad1"],"src":["AAU Aalborg University"],"title":"Design, Fabrication, Test, and Benchmark of a Magnetically Geared Permanent Magnet Generator for Wind Power Generation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-052044","year":"2020","yearsub":"2020"}
{"abstract":"Aims: The aim of present study was to examine the preoperative prevalence and distribution of impaired left ventricular global longitudinal strain (LVGLS) in elderly patients with symptomatic aortic stenosis (AS) undergoing transcutaneous aortic valve replacement (TAVR) and to determine the predictive value of LVGLS on survival. Methods: We included 411 patients with symptomatic severe AS treated with TAVR during a 5-year period, where a baseline echocardiography including LVGLS assessment was available. Results: Mean age was 80.1 ± 7.1 years and aortic valve area (AVA) index 0.4 ± 0.1 cm 2. 78 patients died during a median follow-up of 762 days. Mean left ventricular ejection fraction (LVEF) was 50 ± 13% and mean LVGLS was − 14.0%. LVEF was preserved in 60% of patients, while impaired LVGLS > − 18% was seen in 75% of the patients. Previous myocardial infarction, LVEF < 50%, LVGLS > − 14%, low gradient AS (< 4.0 m/s), tricuspid regurgitant gradient > 30 mmHg were identified as significant univariate predictors of all-cause mortality. On multivariate analysis LVGLS > − 14% (HR 1.79 [1.02–3.14], p = 0.04) was identified as the only independent variable associated with all-cause mortality. Reduced survival was observed with an impaired LVGLS > − 14% in the total population (p < 0.002) but also in patients with high AS gradient with preserved LVEF. LVGLS provided incremental prognostic value with respect to clinical characteristics, AVA and LVEF (χ 2 19.9, p = 0.006). Conclusions: In patients with symptomatic AS undergoing TAVR, impaired LVGLS was highly prevalent despite preserved LVEF. LVGLS > − 14% was an independent predictor of all-cause mortality, and survival was reduced if LVGLS > − 14%.","author_count":9,"contributors":["Povlsen, Jonas Agerlund","Rasmussen, Vibeke Guldbrand","Vase, Henrik","Jensen, Kaare Troels","Terkelsen, Christian Juhl","Christiansen, Evald Høj","Tang, Mariann","Pedersen, Anders Lehmann Dahl","Poulsen, Steen Hvitfeldt"],"cuid":["S01-000.00-152552"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Povlsen, Jonas Agerlund"],"keyword":["Aortic stenosis","Echocardiography","Global longitudinal strain","TAVR"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"distribution and prognostic value of left ventricular global longitudinal strain in elderly patients with symptomatic severe aortic stenosis undergoing transcatheter aortic valve replacement","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12872-020-01791-9","version":"Published Version"},"id":"S01-000.00-152552","identifier":[{"id":"PMC7709407","type":"pmcid"},{"id":"85096950099","type":"scopus"},{"id":"33267772","type":"pmid"}],"ids":["au-287b53fd-b2e2-40ba-8797-f6d392beca94"],"keyword":["Aortic stenosis","Echocardiography","Global longitudinal strain","TAVR"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-71295D63786CC1872B2A2B2B1C0BA38A"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12872-020-01791-9","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Cardiological Medicine B"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jonas Agerlund","key":"povlsenpau","last":"Povlsen","locid":"a8131022-196c-4691-b4d5-1b11d623a4ff","name":"Povlsen, Jonas Agerlund","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Vibeke Guldbrand","key":"rasmussenpau","last":"Rasmussen","locid":"060a99a8-79d9-4755-bd97-85fb1041e8cf","name":"Rasmussen, Vibeke Guldbrand","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik","key":"vasepau","last":"Vase","locid":"aac9f515-f357-49af-b2df-84200398112b","name":"Vase, Henrik","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kaare Troels","key":"jensenpau","last":"Jensen","locid":"943ad0a4-917a-42bd-bd90-d028ed50a117","name":"Jensen, Kaare Troels","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Christian Juhl","key":"terkelsenpau","last":"Terkelsen","locid":"c0d7f995-6ff2-458e-996a-e9a0fccd663f","name":"Terkelsen, Christian Juhl","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Evald Høj","key":"christiansenpau","last":"Christiansen","locid":"06b04feb-3d2f-402d-b211-7ad5fd0387f1","name":"Christiansen, Evald Høj","orcid":"0000-0002-8740-4862","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mariann","key":"tangpau","last":"Tang","locid":"0fdc96d2-9f5c-4e81-9396-e8ab7652b824","name":"Tang, Mariann","orcid":"0000-0003-2861-682X","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anders Lehmann Dahl","key":"pedersenpau","last":"Pedersen","locid":"7e7debe0-e391-4c37-9cbd-c136c98fc08a","name":"Pedersen, Anders Lehmann Dahl","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Steen Hvitfeldt","key":"poulsenpau","last":"Poulsen","locid":"ec1d0fd4-f6ae-4071-907f-1448dfe832fe","name":"Poulsen, Steen Hvitfeldt","orcid":"0000-0002-9586-835X","rank":9,"rolecode":"pau"}],"pmid":["33267772"],"pub":{"doi":"10.1186/s12872-020-01791-9","issn":["14712261"],"issue":"1","journal":"BMC Cardiovascular Disorders","paperid":"506","publisher":"BioMed Central","status":"p","title":"BMC Cardiovascular Disorders","volume":"20"},"review":"Peer Reviewed","scoID":["2-s2.0-85096950099"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-287b53fd-b2e2-40ba-8797-f6d392beca94"],"src":["AU Aarhus University"],"title":"Distribution and prognostic value of left ventricular global longitudinal strain in elderly patients with symptomatic severe aortic stenosis undergoing transcatheter aortic valve replacement","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-152552","year":"2020","yearsub":"2020"}
{"abstract":"Computer modelling is expected to play an increasingly important role in fusion design and technology, where the complexity of the physical processes involved (plasma, materials, engineering), and the highly interconnected nature of systems and components (“system of systems” design), call for support from sophisticated and integrated computer simulation tools. In this paper, we review the contribution of coupled computer modelling to the design of the reactor, breeding blanket and integrated first wall in terms of neutronics, materials behaviour (including plasma-materials interaction, radiation effects and compatibility with fluids), magnetohydrodynamics thermofluid issues and thermo-hydraulic aspects, as well as simulations of plasma transport out of the confinement region to determine heat and particle loads on plasma facing components. The current capabilities and levels of maturity of existing simulation tools are critically analysed, having in mind the possibility of integrating several tools in a single computational suite in the future and highlighting the perspectives and difficulties of such an endeavour.","author_count":9,"contributors":["Smolentsev, Sergey","Spagnuolo, Gandolfo Alessandro","Serikov, Arkady","Rasmussen, Jens Juul","Nielsen, Anders Henry","Naulin, Volker","Marian, Jaime","Coleman, Matti","Malerba, Lorenzo"],"cuid":["S01-000.00-364869"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Europe, EU","Europe, Non-EU","OECD"],"corresponding_author":["Malerba, Lorenzo"],"country":["Germany","Spain","United Kingdom","United States"],"glorg":["All Global Affiliations","CIEMAT","Karlsruhe Institute of Technology","University of California at Los Angeles","University of Cambridge"],"keyword":["Computer modelling","Fusion technology","Materials","Model integration","Neutronics","Plasma"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"on the role of integrated computer modelling in fusion technology","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85083283180","version":"Other Version"},"id":"S01-000.00-364869","identifier":[{"id":"85083283180","type":"scopus"}],"ids":["dtu-c9d68834-4957-493c-9fab-0db5fa65e364"],"keyword":["Computer modelling","Fusion technology","MHD thermofluids","Materials","Model integration","Neutronics","Plasma"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-4711D08F15E473B7B988BDFAD6435A50"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"us","key":"university of california at los angeles","loc":["United States","America, North","OECD"],"name":"University of California at Los Angeles","used":1},{"affno":"2","country":"de","key":"karlsruhe institute of technology","loc":["Germany","Europe, EU","OECD"],"name":"Karlsruhe Institute of Technology","used":1},{"affno":"3","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Physics","Technical University of Denmark, Department of Physics, Plasma Physics and Fusion Energy"],"nora_code":"DI-U-DTU","used":1},{"affno":"4","country":"gb","key":"university of cambridge","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Cambridge","used":1},{"affno":"5","country":"es","key":"ciemat","loc":["Spain","Europe, EU","OECD"],"name":"CIEMAT","used":1}],"person":[{"aff