U-ALL","Universities"],"PST":["Published"]},"sid":["au-d5b54109-aea3-4799-974a-2d5170c67016"],"src":["AU Aarhus University"],"title":"Retroaktivitet, system, excess : en diskussion af Hegels forståelse af dialektik","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-251363","year":"2016","yearsub":"2016"}
{"abstract":"Ultrasound images placed at a grave of a deceased future grandfather (see Figure 4.1a), together with his photograph, raise the question of what relation between death and time they entail. The pictures link the unborn child with the passed away man. Both will undergo a change of social status, but they cannot be met in person yet or anymore, respectively. Absent is also the pregnant woman, who visited the grave, informing the ones who pass it about her impending motherhood. Her father has already Figure 4.1 a) Ultrasound images placed at a grave with a photograph of the (deceased) grandfather-to-be, 2012; b) photograph of the new-born child placed at the same grave five months later, Nijmegen region, the Netherlands, 2013 passed from this world and her child has yet to enter it. The images of the foetus point to a childbirth in the near future of which the dead man apparently should not be unaware. When we visited the grave five months later, the ultrasound images had been replaced by a photo of a new-born child (Figure 4.1b). The dead man now had a granddaughter. At another grave in the same cemetery near Nijmegen, the Netherlands, there was, similarly, a photograph of a baby substituted for a framed ultrasound image.","author_count":5,"contributors":["Kjærsgaard, Anne","Venbrux, Eric"],"cuid":["S01-000.00-262473"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"still in the picture photographs at graves and social time","src":["au"],"src-code":["DI-U-AU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85062644252","version":"Other Version"},"id":"S01-000.00-262473","identifier":[{"id":"85062644252","type":"scopus"}],"ids":["au-e9531dfb-70b8-4460-a8d0-0b8ccf24b60c"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-C9906EE76AAF4DE184CC28433E71517E"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, School of Culture and Society, School of Culture and Society - Church History and Practical Theology, subject"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anne","key":"kjærsgaardpau","last":"Kjærsgaard","locid":"a7707acc-b6f9-4d59-825b-f48017ba45c5","name":"Kjærsgaard, Anne","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Eric","key":"venbruxpau","last":"Venbrux","name":"Venbrux, Eric","rank":2,"rolecode":"pau"},{"affno":"","first":"Peter","key":"bjerregaardpedh","last":"Bjerregaard","name":"Bjerregaard, Peter","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Anders Emil","key":"rasmussenpedh","last":"Rasmussen","name":"Rasmussen, Anders Emil","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Tim","key":"flohrsørensenpedh","last":"Flohr Sørensen","name":"Flohr Sørensen, Tim","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"eisbn":["9781315594309"],"isbn":["9781472441973"],"pages":"85-109","place":"Abingdon","publisher":"Routledge","series":"Studies in Death, Materiality and the Origin of Time","status":"p","subtitle":"Explorations in Transformation, Transition and Transience","title":"Materialities of Passing"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-e9531dfb-70b8-4460-a8d0-0b8ccf24b60c"],"src":["AU Aarhus University"],"title":"Still in the picture : Photographs at graves and social time","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-262473","year":"2016","yearsub":"2016"}
