,"locid":"4d112eed-e878-476d-8f1f-df10d39439b2","name":"Meyhoff, Christian S.","orcid":"0000-0002-4885-4609","rank":4,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Janus C.","key":"jakobsenpau","last":"Jakobsen","locid":"06691aa2-020b-4869-a6d9-56ac223008cc","name":"Jakobsen, Janus Christian","name_org":"Jakobsen, Janus C.","orcid":"0000-0002-3642-2120","rank":5,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Bodil S","key":"rasmussenpau","last":"Rasmussen","locid":"3162c449-94c3-4d28-8dbb-c134d6eb76e1","name":"Rasmussen, Bodil Steen","name_org":"Rasmussen, Bodil S","orcid":"0000-0003-2190-145X","rank":6,"rolecode":"pau"},{"affno":"3 1","first":"Anders","key":"pernerpau","last":"Perner","locid":"8a389541-d529-4ee3-8364-66bfc85f77c9","name":"Perner, Anders","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jørn","key":"wetterslevpau","last":"Wetterslev","name":"Wetterslev, Jørn","rank":8,"rolecode":"pau"}],"pmid":["32687907"],"pub":{"doi":"10.1016/j.chest.2020.07.015","issn":["00123692","19313543"],"issn_org":["00123692"],"issue":"1","journal":"Chest","pages":"154-173","publisher":"Elsevier","status":"p","title":"Chest","volume":"159"},"review":"Peer Reviewed","scoID":["2-s2.0-85098788380"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-7b2020f7-5f73-4607-acc1-3fb33a023ae3","ku-90919815-ccbc-4d6c-a895-f078dfaa35af","sdu-4a7f0c81-4c0e-4ae4-8480-3e5a35d35d73"],"src":["AAU Aalborg University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Higher vs Lower Oxygenation Strategies in Acutely Ill Adults : A Systematic Review With Meta-Analysis and Trial Sequential Analysis","type":"Journal Article","url":"https://