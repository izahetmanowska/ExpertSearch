dk","first":"Janne","key":"frittrasmussenpau","last":"Fritt-Rasmussen","locid":"ee0f4272-d879-4350-9617-affc0cc83535","name":"Fritt-Rasmussen, Janne","orcid":"0000-0002-6496-8032","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Kasper Lambert","key":"johansenpau","last":"Johansen","locid":"2350f010-0c80-4de7-a007-31e878d76732","name":"Johansen, Kasper Lambert","orcid":"0000-0003-0111-9516","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Anders","key":"mosbechpau","last":"Mosbech","locid":"0d8b3009-ff00-40a7-b738-abfa87e31ccf","name":"Mosbech, Anders","orcid":"0000-0002-7581-7037","rank":4,"rolecode":"pau"}],"pub":{"eisbn":["9788771568394"],"pages":"120-127","place":"Aarhus","publisher":"Aarhus University, DCE - Danish Centre for Environment and Energy","series":"Scientific Report from DCE - Danish Centre for Environment and Energy","status":"p","title":"Uummannap Kangerlua and Sigguup Nunaa (Svartenhuk) - Regional environmental baseline assessment for mining activities"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-0d82dc93-f031-4c86-b2e2-d5a68bef506d"],"src":["AU Aarhus University"],"title":"Future perspectives and data gaps","type":"Report Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-717226","year":"2024","yearsub":"2024"}
{"abstract":"BACKGROUND: Myocardial injury after noncardiac surgery (MINS) is associated with 30-day mortality in heterogeneous surgical populations but is barely described after acute high-risk abdominal surgery. The impact of dynamic changes has not previously been investigated. The objectives were to determine the incidence of MINS in this population, the association between mortality and MINS, and whether plasma troponin I (TnI) dynamics have any impact on mortality. METHODS: A prospective cohort study of 341 patients undergoing acute high-risk gastrointestinal surgery was conducted. Plasma TnI was measured at the first four postoperative days. MINS was defined as any increased TnI level >59 ng/L. TnI dynamic required either two succeeding measurements of TnI >59 ng/L with a >20% increase/fall or one measurement of TnI >59 ng/L with a succeeding measurement of TnI <59 ng/L with a >50% decrease. Adjusted mortality rates were calculated using inverse probability of treatment weighting and competing risk analyses. RESULTS: The incidence of MINS was 23.8% and dynamic TnI changes occurred in 15.6% of the patients. The unadjusted 30-day and 1-year mortality were 19.8% and 35.9% in patients with MINS, compared with 2.7% and 11.6%, respectively, in patients without MINS (p < 0.001). After adjusting, the differences remained significant. There was no difference in mortality between patients with or without dynamic changes in TnI level. CONCLUSION: MINS occurred frequently and was associated with increased mortality. TnI monitoring might help identify patients with increased risk of mortality and improve care. Research on preventive measures and treatments is warranted. TRIAL REGISTRATION NUMBER AND AGENCY: ClinicalTrials.gov Identifier: NCT05933837, retrospective registered.","author_count":7,"contributors":["Kanstrup, Charlotte Tiffanie Bendtz","Serup, Camilla Mattesen","Svarre, Kristina Johansen","Rasmussen, Maja Christine","Lundstrøm, Lars Hyldborg","Kleif, Jakob","Bertelsen, Claus Anders"],"cuid":["S01-000.00-731610"],"filters":{"added":"2024-05","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Cardiac","Colorectal","Critical care","Gastrointestinal","Outcomes"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"association between troponin i levels and mortality among patients undergoing acute high risk abdominal surgery a cohort study","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1002/wjs.12035","version":"Published Version"},"id":"S01-000.00-731610","identifier":[{"id":"85184284555","type":"scopus"},{"id":"38284768","type":"pmid"}],"ids":["ku-7e37b882-6843-486b-89f0-234a562fc36e"],"keyword":["cardiac","colorectal","critical care","gastrointestinal","outcomes"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-AFABE832652A8DA242760736B5A918F5"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/382978319/World_j_surg_2024_Kanstrup_Association_between_troponin_I_levels_and_mortality_among_patients_undergoing_acute.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1002/wjs.12035","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital – North Zealand"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Anaesthesiology","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Charlotte Tiffanie Bendtz","key":"kanstruppau","last":"Kanstrup","name":"Kanstrup, Charlotte Tiffanie Bendtz","rank":1,"rolecode":"pau"},{"affno":"1","first":"Camilla Mattesen","key":"seruppau","last":"Serup","name":"Serup, Camilla Mattesen","rank":2,"rolecode":"pau"},{"affno":"1","first":"Kristina Johansen","key":"svarrepau","last":"Svarre","name":"Svarre, Kristina Johansen","rank":3,"rolecode":"pau"},{"affno":"1","first":"Maja Christine","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Maja Christine","rank":4,"rolecode":"pau"},{"affno":"1 2","first":"Lars Hyldborg","key":"lundstrømpau","last":"Lundstrøm","locid":"3c02fe75-6e40-49a3-a116-726fc8874dfc","name":"Lundstrøm, Lars Hyldborg","rank":5,"rolecode":"pau"},{"affno":"1 2","first":"Jakob","key":"kleifpau","last":"Kleif","locid":"16ca332d-b612-4ab7-8b98-622d5d45d108","name":"Kleif, Jakob","rank":6,"rolecode":"pau"},{"affno":"1 2","first":"Claus Anders","key":"bertelsenpau","last":"Bertelsen","locid":"0ea5cd22-b4bb-4c76-9ce7-77f7a44949f1","name":"Bertelsen, Claus Anders","rank":7,"rolecode":"pau"}],"pmid":["38284768"],"pub":{"doi":"10.1002/wjs.12035","issn":["03642313","14322323"],"issn_org":["03642313"],"issue":"2","journal":"World Journal of Surgery","pages":"361-370","status":"p","title":"World Journal of Surgery","volume":"48"},"review":"Peer Reviewed","scoID":["2-s2.0-85184284555"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-7e37b882-6843-486b-89f0-234a562fc36e"],"src":["KU University of Copenhagen"],"title":"Association between troponin I levels and mortality among patients undergoing acute high-risk abdominal surgery-A cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-731610","year":"2024","yearsub":"2024"}
{"abstract":"Human genome-wide association studies (GWAS) suggest a functional role for central glutamate receptor signaling and plasticity in body weight regulation. Here, we use UK Biobank GWAS summary statistics of body mass index (BMI) and body fat percentage (BF%) to identify genes encoding proteins known to interact with postsynaptic α-amino-3-hydroxy-5-methyl-4-isoxazolepropionic acid (AMPA) and N-methyl-d-aspartate (NMDA) receptors. Loci in/near discs large homolog 4 (DLG4) and protein interacting with C kinase 1 (PICK1) reached genome-wide significance (P < 5 × 10^−8) for BF% and/or BMI. To further evaluate the functional role of postsynaptic density protein-95 (PSD-95; gene name: DLG4) and PICK1 in energy homeostasis, we used dimeric PSD-95/disc large/ZO-1 (PDZ) domain–targeting peptides of PSD-95 and PICK1 to demonstrate that pharmacological inhibition of PSD-95 and PICK1 induces prolonged weight-lowering effects in obese mice. Collectively, these data demonstrate that the glutamate receptor scaffolding proteins, PICK1 and PSD-95, are genetically linked to obesity and that pharmacological targeting of their PDZ domains represents a promising therapeutic avenue for sustained weight loss.","author_count":22,"contributors":["Fadahunsi, Nicole","Petersen, Jonas","Metz, Sophia","Jakobsen, Alexander","Mathiesen, Cecilie Vad","Buch-Rasmussen, Alberte Silke","Kurgan, Nigel Kilty","Larsen, Jeppe Kjærgaard","Andersen, Rita Chan","Topilko, Thomas","Svendsen, Charlotte","Christiansen, M.","Skovbjerg, Grethe","Schmidt, Jan Hendrik","Houser, Grace Anne","Jager, Sara Elgaard","Bach, Anders","Deshmukh, Atul S.","Kilpeläinen, Tuomas O","Strømgaard, Kristian","Madsen, Kenneth Lindegaard","Clemmensen, Christoffer"],"cuid":["S01-000.00-732628"],"filters":{"added":"2024-05","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-GUB","DI-PR-NOVO"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-PR-GUB","DI-PR-NOVO","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"targeting postsynaptic glutamate receptor scaffolding proteins psd 000000000095 and pick000000000001 for obesity treatment","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1126/sciadv.adg2636","version":"Published Version"},"id":"S01-000.00-732628","identifier":[{"id":"PMC10906926","type":"pmcid"},{"id":"85186745286","type":"scopus"},{"id":"38427737","type":"pmid"}],"ids":["ku-dfce2447-cc09-4544-9a63-aa1a45df51a5"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-CBAEE35E9E1D7C1D71CC232FFCAD66DD"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://curis.ku.dk/ws/files/384958169/sciadv.adg2636_1_.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1126/sciadv.adg2636","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Basic Metabolic Research, Clemmensen Group"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"novo nordisk","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-NOVO","l3nl":"Novo Nordisk","l3nn":"Novo Nordisk","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Novo Nordisk","namevar":["Novo Nordisk"],"nora_code":"DI-PR-NOVO","used":1},{"affno":"3","country":"dk","key":"gubra","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-GUB","l3nl":"Gubra","l3nn":"Gubra","loc":["Denmark","Europe, EU","Nordic","OEC