jensenpau","last":"Møller Jensen","name":"Møller Jensen, Anders","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Susanne","key":"overgaardpau","last":"Overgaard","locid":"a0dd688d-455b-4b01-912d-6086640c5e6b","name":"Overgaard, Susanne Bollerup","name_org":"Overgaard, Susanne","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Agnete","key":"amlundrasmussenpau","last":"Amlund Rasmussen","name":"Amlund Rasmussen, Agnete","rank":3,"rolecode":"pau"},{"affno":"","first":"Anne Marie","key":"beckpedh","last":"Beck","name":"Beck, Anne Marie","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Birgitte","key":"højlundpedh","last":"Højlund","name":"Højlund, Birgitte","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Louise Scheel","key":"thomasenpedh","last":"Thomasen","name":"Thomasen, Louise Scheel","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"eisbn":["978879814077"],"isbn":["9788798140719"],"pages":"84-91","publisher":"Dansk Gerontologisk Selskab","status":"p","subtitle":"Hverdagsliv i et gerontologisk perspektiv","title":"At skabe gode dage"},"review":"Undetermined","search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-2d79c9cf-30a3-4814-95c9-97a880dca61b"],"src":["AU Aarhus University"],"title":"Reminiscens : Samvær og livskvalitet i demensomsorgen","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-772005","year":"2016","yearsub":"2016"}
{"abstract":"The CI repressor from the temperate bacteriophage TP901-1 consists of two folded domains, an N-terminal helix-turn-helix DNA-binding domain (NTD) and a C-terminal oligomerization domain (CTD), which we here suggest to be further divided into CTD1 and CTD2. Full-length CI is a hexameric protein, whereas a truncated version, CIΔ58, forms dimers. We identify the dimerization region of CIΔ58 as CTD1 and determine its secondary structure to be helical both within the context of CIΔ58 and in isolation. To our knowledge this is the first time that a helical dimerization domain has been found in a phage repressor. We also precisely determine the length of the flexible linker connecting the NTD to the CTD. Using electrophoretic mobility shift assays and native mass spectrometry, we show that CIΔ58 interacts with the O-L operator site as one dimer bound to both half-sites, and with much higher affinity than the isolated NTD domain thus demonstrating cooperativity between the two DNA binding domains. Finally, using small angle X-ray scattering data and state-of-the-art ensemble selection techniques, we delineate the conformational space sampled by CIΔ58 in solution, and we discuss the possible role that the dynamics play in CI-repressor function.","author_count":12,"contributors":["Rasmussen, Kim Krighaar","Frandsen, Kristian E. H.","Erba, Elisabetta Boeri","Pedersen, Margit","Varming, Anders K.","Hammer, Karin","Kilstrup, Mogens","Thulstrup, Peter W.","Blackledge, Martin","Jensen, Malene Ringkjobing","Lo Leggio, Leila"],"cuid":["S02-098.75-035978"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD"],"country":["France"],"glorg":["All Global Affiliations","University of Grenoble"],"keyword":["Bacteriophages","Structural biology","Transcription Factors"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"structural and dynamics studies of a truncated variant of ci repressor from bacteriophage tp000000000901 000000000001","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/srep29574","version":"Published Version"},"id":"S02-098.75-035978","identifier":[{"id":"84978393051","type":"scopus"},{"id":"27403839","type":"pmid"},{"id":"PMC4941734","type":"pmcid"}],"ids":["dtu-9438abc6-b8b2-4028-8c59-cae225cd1876","ku-3a8eebb4-29b9-46ad-b479-656a459fa6ea"],"keyword":["Bacteriophages","Structural biology","Transcription factors"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-C00981DEFA6870982F8845F8BFE56F27"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/srep29574","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/125119782/Structural_and_dynamics_studies_of_a_truncated_variant_of_CI_repressor_from_bacteriophage_TP901_1.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/169692962/Rasmussen_2016_Structural_and_dynamics.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Chemistry, Department of Chemistry"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"fr","key":"university of grenoble","loc":["France","Europe, EU","OECD"],"name":"University of Grenoble","used":1},{"affno":"3","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Systems Biology","Technical University of Denmark, Department of Systems Biology, Metabolic Signaling and Regulation"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","first":"Kim Krighaar","key":"rasmussenpau","last":"Rasmussen","locid":"034b2040-ed8d-4f78-a082-bbf70c6d6d95","name":"Rasmussen, Kim Krighaar","rank":1,"rolecode":"pau"},{"affno":"1","first":"Kristian Erik Høpfner","key":"frandsenpau","last":"Frandsen","locid":"a84a68d8-20a4-41e6-8f50-eb4cccb8bd7f","name":"Frandsen, Kristian Erik Høpfner","orcid":"0000-0002-7136-9820","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Elisabetta Boeri","key":"erbapau","last":"Erba","name":"Erba, Elisabetta Boeri","rank":3,"rolecode":"pau"},{"affno":"","first":"Elisabetta","key":"boerierbapau","last":"Boeri Erba","name":"Boeri Erba, Elisabetta","rank":3,"rolecode":"pau"},{"affno":"1","first":"Margit","key":"pedersenpau","last":"Pedersen","locid":"b3748974-5675-492a-af24-3372f03c306c","name":"Pedersen, Margit","rank":4,"rolecode":"pau"},{"affno":"1","first":"Anders Kokkenborg","key":"varmingpau","last":"Varming","locid":"6e74f1ad-2605-40bb-a45e-7d34896e6f35","name":"Varming, Anders Kokkenborg","orcid":"0000-0001-6865-990X","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Karin","key":"hammerpau","last":"Hammer","locid":"9fcdb463-9cb0-4066-ab81-e81bcd8a22e0","name":"Hammer, Karin","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Mogens","key":"kilstruppau","last":"Kilstrup","locid":"f852c88c-c2dd-4c1c-bb1d-119775a3d7e7","name":"Kilstrup, Mogens","orcid":"0000-0002-3900-723X","rank":7,"rolecode":"pau"},{"affno":"1","first":"Peter Waaben","key":"thulstruppau","last":"Thulstrup","locid":"043e3b07-d7e1-4f25-9359-6f55b4e2ba92","name":"Thulstrup, Peter Waaben","orcid":"0000-0002-9241-4352","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Martin","key":"blackledgepau","last":"Blackledge","name":"Blackledge, Martin","rank":9,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Malene Ringkjobing","key":"jensenpau","last":"Jensen","name":"Jensen, Malene Ringkjobing","rank":10,"rolecode":"pau"},{"affno":"1","first":"Leila","key":"loleggiopau","last":"Lo Leggio","locid":"9b2c31e6-b95b-4a32-a86f-6c3c0d53fd03","name":"Lo Leggio, Leila","orcid":"0000-0002-5135-0882","rank":11,"rolecode":"pau"}],"pmid":["27403839"],"pub":{"doi":"10.1038/srep29574","issn":["20452322"],"journal":"Scientific Reports","paperid":"29574","publisher":"Nature Publishing Group","status":"p","title":"Scientific Reports","volume":"6"},"review":"Peer Reviewed","scoID":["2-s2.0-84978393051"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-9438abc6-b8b2-4028-8c59-cae225cd1876","ku-3a8eebb4-29b9-46ad-b479-656a459fa6ea"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Structural and dynamics studies of a truncated variant of CI repressor from bacteriophage TP901-1","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-098.75-035978","year":"2016","yearsub":"2016"}
{"abstract":"Background: Reduced intake of n-3 long-chain polyunsaturated fatty acids (LCPUFAs) may be a contributing factor to the increasing prevalence of wheezing disorders. We assessed the effect of supplementation with n-3 LCPUFAs in pregnant women on the risk of persistent wheeze and asthma in their offspring. Methods: We randomly assigned 736 pregnant women at 24 weeks of gestation to receive 2.4 g of n-3 LCPUFA (fish oil) or placebo (olive oil) per day. Their children formed the Copenhagen Prospective Studies on Asthma in Childhood2010 (COPSAC2010) cohort and were followed prospectively with extensive clinical phenotyping. Neither the investigators nor the participants were aware of group assignments during follow-up for the first 3 years of the children's lives, after which there was a 2-year follow-up period during which only the investigators were unaware of group assignments. The primary end point was persistent wheeze or asthma, and the secondary end points included lower respiratory tract infections, asthma exacerbations, eczema, and allergic sensitization. Results: A total of 695 children were included in the trial, and 95.5% completed the 3-year, double-blind follow-up period. The risk of persistent wheeze or asthma in the treatment group was 16.9%, versus 23.7% in the control group (hazard ratio, 0.69; 95% confidence interval [CI], 0.49 to 0.97; P=0.035), corresponding to a relative reduction of 30.7%. Prespecified subgroup analyses suggested that the effect was strongest in the children of women whose blood levels of eicosapentaenoic acid and docosahexaenoic acid were in the lowest third of the trial population at randomization: 17.5% versus 34.1% (hazard ratio, 0.46; 95% CI, 0.25 to 0.83; P=0.011). Analyses of secondary end points showed that supplementation with n-3 LCPUFA was associated with a reduced risk of infections of the lower respiratory tract (31.7% vs. 39.1%; hazard ratio, 0.75; 95% CI, 0.58 to 0.98; P=0.033), but there was no statistically significant association between supplementation and asthma exacerbations, eczema, or allergic sensitization. Conclusions: Supplementation with n-3 LCPUFA in the third trimester of pregnancy reduced the absolute risk of persistent wheeze or asthma and infections of the lower respiratory tract in offspring by approximately 7 percentage points, or one third. (Funded by the Lundbeck Foundation and others; ClinicalTrials.gov number, NCT00798226 .).","author_count":20,"contributors":["Bisgaard, Hans","Stokholm, Jakob","Chawes, Bo L","Vissing, Nadja H.","Bjarnadóttir, Elín","Schoos, Ann-Marie Malby","Wolsk, Helene M","Pedersen, Tine M","Vinding, Rebecca Kofod","Thorsteinsdóttir, Sunna","Følsgaard, Nilofar V","Fink, Nadia R","Thorsen, Jonathan","Pedersen, Anders G.","Waage, Johannes","Rasmussen, Morten Arendt","Stark, Ken D","Olsen, Sjurdur F","Bønnelykke, Klaus"],"cuid":["S02-099.27-036583"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","OECD"],"country":["Canada"],"glorg":["All Global Affiliations","University of Waterloo"],"keyword":["Asthma","Child Preschool","Dietary Supplements","Double Blind Method","Fatty Acids Omega 3","Female","Fish Oils","Follow Up Studies","Humans","Journal Article","Kaplan Meier Estimate","Male","Medication Adherence","Olive oil","Pregnancy","Pregnancy Trimester Third","Randomized Controlled Trial","Respiratory Sounds","Respiratory tract infections","Risk"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-ZEA"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-HO-ZEA","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"fish oil derived fatty acids in pregnancy and wheeze and asthma in offspring","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/127978874/NEJMoa1503734.pdf","version":"Published Version"},"id":"S02-099.27-036583","identifier":[{"id":"28029926","type":"pmid"},{"id":"85007378118","type":"scopus"}],"ids":["dtu-b01f6b9d-43ae-4e1c-aaa7-c12fb3aaef79","ku-2f072a4f-57b7-4437-9991-813b1795c7ae"],"keyword":["Asthma","Child, Preschool","Dietary Supplements","Double-Blind Method","Fatty Acids, Omega-3","Female","Fish Oils","Follow-Up Studies","Humans","Journal Article","Kaplan-Meier Estimate","Male","Medication Adherence","Olive Oil","Pregnancy","Pregnancy Trimester, Third","Randomized Controlled Trial","Respiratory Sounds","Respiratory Tract Infections","Risk"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-268AC89F9345EEB803227070291CE61E"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/127978874/NEJMoa1503734.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","country":"dk","key":"region zealand","l2":"DI-HO","l