rsity of Southern Denmark"],"PST":["Published"]},"sid":["sdu-e664d27c-beb4-4cb0-ac3c-ad33e88156d1"],"src":["SDU University of Southern Denmark"],"title":"Prediction of liver fibrosis severity in alcoholic liver disease by human microfibrillar-associated protein 4","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-639164","year":"2020","yearsub":"2020"}
{"abstract":"We have seismically characterized a Triassic-Jurassic deep geothermal sandstone reservoir north of Copenhagen, onshore Denmark. A suite of regional geophysical measurements, including prestack seismic data and well logs, was integrated with geologic information to obtain facies and reservoir property predictions in a Bayesian framework. The applied workflow combined a facies-dependent calibrated rock-physics model with a simultaneous amplitude-variation-with-offset seismic inversion. The results suggest that certain sandstone distributions are potential aquifers within the target interval, which appear reasonable based on the geologic properties. However, prediction accuracy suffers from a restricted data foundation and should, therefore, only be considered as an indicator of potential aquifers. Despite these issues, the results demonstrate new possibilities for future seismic reservoir characterization and rock-physics modeling for exploration purposes, derisking, and the exploitation of geothermal energy as a green and sustainable energy resource.","author_count":5,"contributors":["Bredesen, Kenneth","Dalgaard, Esben","Mathiesen, Anders","Rasmussen, Rasmus","Balling, Niels"],"cuid":["S01-000.00-787635"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Nordic"],"corresponding_author":["Bredesen, Kenneth"],"country":["Greenland"],"glorg":["All Global Affiliations","Geological Survey of Denmark and Greenland"],"keyword":["Geothermal","Inversion","Reservoir characterization","Rock physics"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"seismic characterization of geothermal sedimentary reservoirs a field example from the copenhagen area denmark","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1190/INT-2019-0184.1","version":"Published Version"},"id":"S01-000.00-787635","identifier":[{"id":"85077308084","type":"scopus"},{"id":"85084292756","type":"scopus"}],"ids":["au-9b6369b5-f1b6-4347-a18f-aac977d065fb"],"keyword":["geothermal","inversion","reservoir characterization","rock physics"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-80CB525926B284DEF3575AA38EA9329D"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1190/int-2019-0184.1","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.au.dk/ws/files/224091590/int_2019_0184.1.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"gl","key":"geological survey of denmark and greenland","loc":["Greenland","Nordic"],"name":"Geological Survey of Denmark and Greenland","used":1},{"affno":"2","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Geoscience"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Kenneth","key":"bredesenpau","last":"Bredesen","name":"Bredesen, Kenneth","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Esben","key":"dalgaardpau","last":"Dalgaard","name":"Dalgaard, Esben","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders","key":"mathiesenpau","last":"Mathiesen","name":"Mathiesen, Anders","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rasmus","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Rasmus","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Niels","key":"ballingpau","last":"Balling","locid":"9ea4505e-242a-4183-b811-0943e15de808","name":"Balling, Niels","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1190/int-2019-0184.1","issn":["00209643","2159340X"],"issn_org":["23248858"],"issue":"2","journal":"Interpretation","publisher":"Society of Exploration Geophysicists","status":"p","title":"Interpretation","volume":"8"},"review":"Peer Reviewed","scoID":["2-s2.0-85077308084","2-s2.0-85084292756"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-9b6369b5-f1b6-4347-a18f-aac977d065fb"],"src":["AU Aarhus University"],"title":"Seismic characterization of geothermal sedimentary reservoirs : A field example from the Copenhagen area, Denmark","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-787635","year":"2020","yearsub":"2020"}
{"abstract":"Introduction. The pathogenesis of atopic dermatitis (AD) is not yet fully understood, but the bacterial composition of AD patients' skin has been shown to have an increased abundance of Staphylococcus aureus. More recently, coagulasenegative Staphylococcus (CoNS) species were shown to be able to inhibit S. aureus, but further studies are required to determine the effects of Staphylococcus community variation in AD. Aim. Here we investigated whether analysing metabarcoding data with the more recently developed DADA2 approach improves metabarcoding analyses compared to the previously used operational taxonomic unit (OTU) clustering, and can be used to study Staphylococcus community dynamics. Methods. The bacterial 16S rRNA region from tape strip samples of the stratum corneum of AD patients (nonlesional skin) and non AD controls was metabarcoded. We processed metabarcoding data with two different bioinformatic pipelines (an OTU clustering method and DADA2), which were analysed with and without technical replication (sampling strategy). Results. We found that OTU clustering and DADA2 performed well for community level studies, as demonstrated by the identification of significant differences in the skin bacterial communities associated with AD. However, the OTU clustering approach inflated bacterial richness, which was worsened by not having technical replication. Data processed with DADA2 likely handled sequencing errors more effectively and thereby did not inflate molecular richness. Conclusion. We believe that DADA2 represents an improvement over an OTU clustering approach, and that biological replication rather than technical replication is a more effective use of resources. However, neither OTU clustering nor DADA2 gave insights into Staphylococcus community dynamics, and caution should remain in not overinterpreting the taxonomic assignments at lower taxonomic ranks.","author_count":7,"contributors":["Barnes, Christopher James","Rasmussen, Linett","Asplund, Maria","Knudsen, Steen Wilhelm","Clausen, Maja-Lisa","Agner, Tove","Hansen, Anders Johannes"],"cuid":["S01-000.00-818721"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Atopic dermatitis","Eczema","Metabarcoding","Ribosomal RNA","Skin microbiome","Staphylococcus aureus"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"OT":["NIVA Denmark Water Research"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"comparing dada000000000002 and otu clustering approaches in studying the bacterial communities of atopic dermatitis","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1099/jmm.0.001256","version":"Published Version"},"id":"S01-000.00-818721","identifier":[{"id":"85097003657","type":"scopus"},{"id":"000614291000004","type":"wos"},{"id":"PMC7717693","type":"pmcid"},{"id":"32965212","type":"pmid"}],"ids":["ku-247b8624-ff08-4b58-83e1-a9dc828604d2"],"keyword":["DADA2","OTU clustering","RIBOSOMAL-RNA","Staphylococcus aureus","atopic dermatitis","eczema","metabarcoding","skin microbiome"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-053050609EEF17C67A1AA9B4FD11EDB2"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1099/jmm.0.001256","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/260746441/1293_jmm001256.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University