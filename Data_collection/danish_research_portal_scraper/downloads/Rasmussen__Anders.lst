oi":"10.1530/eje-13-0672","issn":["08044643","1479683X"],"issn_org":["08044643"],"issue":"2","journal":"European Journal of Endocrinology","pages":"329-339","status":"p","title":"European Journal of Endocrinology","volume":"170"},"review":"Peer Reviewed","scoID":["2-s2.0-84893643624"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-c117d988-9e0c-455f-b270-2dafed77fdd9"],"src":["KU University of Copenhagen"],"title":"Gestational age-specific reference ranges from different laboratories misclassify pregnant women's thyroid status : comparison of two longitudinal prospective cohort studies","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-508684","year":"2014","yearsub":"2014"}
{"author_count":5,"contributors":["Rasmussen, Helle Mätzke","Nielsen, Dennis Brandborg","Pedersen, Niels Wisbech","Overgaard, Søren","Holsgaard-Larsen, Anders"],"cuid":["S01-000.00-632647"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"reliability of gait deviation index in children with spastic cerebral palsy","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-632647","ids":["sdu-cf5509cb-3b54-42ec-874e-902d0fe5b647"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-5966D16D02A1A0CB0018FC35F9B07987"],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of orthopaedic surgery (Odense)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Helle Mätzke","key":"rasmussenpau","last":"Rasmussen","locid":"fc740e3e-3a84-4904-bd04-4db023a123db","name":"Rasmussen, Helle Mätzke","orcid":"0000-0002-7522-8144","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Dennis Brandborg","key":"nielsenpau","last":"Nielsen","locid":"196dd8e9-a6c1-4b81-b9c1-175e516ae16d","name":"Nielsen, Dennis Brandborg","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Niels Wisbech","key":"pedersenpau","last":"Pedersen","locid":"ed21518f-c0c3-4e67-9b9e-fd9f355c6612","name":"Pedersen, Niels Wisbech","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren","key":"overgaardpau","last":"Overgaard","locid":"b394ea8b-39e4-46bc-8651-f6321e37c2eb","name":"Overgaard, Søren","orcid":"0000-0001-6829-4787","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anders","key":"holsgaardlarsenpau","last":"Holsgaard-Larsen","locid":"3c1cf5a4-81b1-49f3-ad79-d086b74b1561","name":"Holsgaard-Larsen, Anders","orcid":"0000-0003-4106-6930","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-cf5509cb-3b54-42ec-874e-902d0fe5b647"],"src":["SDU University of Southern Denmark"],"title":"RELIABILITY OF GAIT DEVIATION INDEX IN CHILDREN WITH SPASTIC CEREBRAL PALSY","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-632647","year":"2014","yearsub":"2014"}
{"abstract":"BACKGROUND: We sought to perform a study assessing the association between electrocardiographic ST-segment deviations and cardiovascular death (CVD), in relation to sex and age (≥ and <65 years), in a large primary care population without overt ischemic heart disease. METHODS AND RESULTS: Using computerized analysis of ECGs from 285 194 persons, we evaluated the association between precordial ST-segment deviations and the risk of CVD. All data on medication, comorbidity, and outcomes were retrieved from Danish registries. After a median follow-up period of 5.8 years, there were 6679 cardiovascular deaths. Increasing ST-depression was associated with an increased risk of CVD in almost all of the precordial leads, with the most robust association seen in lead V5 to V6. ST-elevations in lead V2 to V6 were associated with increased risk of CVD in young women, but not in men. However, ST-elevations in V1 increased the risk for both genders and age groups, exemplified by a HR of 1.80 (95% CI [1.19 to 2.74], P=0.005) for men <65 years with ST-elevations ≥ 150 μV versus a nondeviating ST-segment (-50 μV to +50 μV). In contrast, for men <65 years, ST-elevations in lead V2 to V3 conferred a decreased risk of CVD with a HR of 0.77 (95% CI [0.62 to 0.96], P<0.001) for ST-elevations ≥ 150 μV in V2. CONCLUSION: We found that ST-depressions were associated with a dose-responsive increased risk of CVD in nearly all the precordial leads. ST-elevations conferred an increased risk of CVD in women and with regard to lead V1 also in men. However, ST-elevations in V2 to V3 were associated with a decreased risk of CVD in young men.","author_count":11,"contributors":["Rasmussen, Peter Vibe","Nielsen, Jonas Bille","Pietersen, Adrian","Graff, Claus","Lind, Bent","Struijk, Johannes","Olesen, Morten Salling","Haunsø, Stig","Køber, Lars","Svendsen, Jesper Hastrup","Holst, Anders Gaarsdal"],"cuid":["S02-093.88-008898"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"keyword":["Adult","Age Factors","Aged","Aged 80 and over","Cardiovascular Diseases","Denmark","Electrocardiography","Female","Heart","Humans","Male","Middle Aged","Proportional Hazards Models","Risk Factors","Sex Factors"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-AAU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"electrocardiographic precordial st segment deviations and the risk of cardiovascular death results from the copenhagen ecg study","src":["aau","ku"],"src-code":["DI-U-AAU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1161/JAHA.113.000549","version":"Published Version"},"id":"S02-093.88-008898","identifier":[{"id":"24815495","type":"pmid"},{"id":"PMC4309043","type":"pmcid"},{"id":"WOS:000336848800005","type":"wos"},{"id":"84939461890","type":"scopus"}],"ids":["aau-b87a7eb9-b2f1-4c2c-a9a8-f395fb47cf2d","ku-bf2774dd-6828-4e30-b80c-9bd28910df3c"],"keyword":["Adult","Age Factors","Aged","Aged, 80 and over","Cardiovascular Diseases","Denmark","Electrocardiography","Female","Heart","Humans","Male","Middle Aged","Proportional Hazards Models","Risk Factors","Sex Factors"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-1C13B8E33EF1900E97357045A0505543"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://curis.ku.dk/ws/files/189350352/e000549.full.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1161/JAHA.113.000549","version":"Published Version"},{"access":"oa","type":"rem","url":"http://jaha.ahajournals.org/content/3/3/e000549","version":"Published Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"aff