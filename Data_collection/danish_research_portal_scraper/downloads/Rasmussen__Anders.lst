N.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Harold","key":"fellermannpau","last":"Fellermann","locid":"3bcc1379-297f-40c9-9bec-391ce84df55a","name":"Fellermann, Harold","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Steen","key":"rasmussenpau","last":"Rasmussen","locid":"2601890b-b919-4cbf-b46f-7867f89312c9","name":"Rasmussen, Steen","orcid":"0000-0002-3336-843X","rank":4,"rolecode":"pau"}],"pub":{"issn":["13992309"],"journal":"Aktuel Naturvidenskab","publisher":"Aarhus Universitet","status":"p","title":"Aktuel Naturvidenskab"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-622648af-d15d-4f2b-af57-f793aa65c692"],"src":["SDU University of Southern Denmark"],"title":"Fra syntetisk liv til levende teknologi","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-601282","year":"2011","yearsub":"2011"}
{"abstract":"Introduction Diets rich in n-3 long chain polyunsaturated fatty acids (LC-PUFA), but low in n-6 LC-PUFA and 18:1 trans-fatty acids (TFA), may lower the risk of overweight and obesity. These fatty acids have often been investigated individually. We explored associations between global patterns in adipose tissue fatty acids and changes in anthropometry. Methods 34 fatty acid species from adipose tissue biopsies were determined in a random sample of 1100 men and women from a Danish cohort study. We used sex-specific principal component analysis and multiple linear regression to investigate the associations of adipose tissue fatty acid patterns with changes in weight, waist circumference (WC), and WC controlled for changes in body mass index (WCBMI), adjusting for confounders. Results 7 principal components were extracted for each sex, explaining 77.6% and 78.3% of fatty acid variation in men and women, respectively. Fatty acid patterns with high levels of TFA tended to be positively associated with changes in weight and WC for both sexes. Patterns with high levels of n-6 LC-PUFA tended to be negatively associated with changes in weight and WC in men, and positively associated in women. Associations with patterns with high levels of n-3 LC-PUFA were dependent on the context of the rest of the fatty acid pattern. Conclusions Adipose tissue fatty acid patterns with high levels of TFA may be linked to weight gain, but patterns with high n-3 LC-PUFA did not appear to be linked to weight loss. Associations depended on characteristics of the rest of the pattern.","author_count":7,"contributors":["Dahm, Christina Catherine","Gorst-Rasmussen, Anders","Jakobsen, Marianne Uhre","Schmidt, Erik Berg","Tjønneland, Anne","Sørensen, Thorkild I.A.","Overvad, Kim"],"cuid":["S02-089.20-010200"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"OT":["Kardiologisk Afdeling, Aalborg Sygehus, Århus Universitetshospital"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-UND"]},"level3all":["DI-HO-CDR","DI-U-AAU","DI-U-AU","DI-U-UND"]},"review":"pr","rtype":["clu"],"sorti":"adipose tissue fatty acid patterns and changes in antrhropometry a cohort study","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1371%2Fjournal.pone.0022587","version":"Other Version"},"id":"S02-089.20-010200","identifier":[{"id":"PMC3141072","type":"pmcid"},{"id":"21811635","type":"pmid"},{"id":"WOS:000292956800072","type":"wos"},{"id":"79960626659","type":"scopus"}],"ids":["aau-d5458eba-2ed5-47a1-9b38-63ae1d06e621","au-21004021-0899-4ad1-a0fc-5350e4346c46"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-3-6-DBA88CFD0DA4904081308438A172DD6E"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.plosone.org/article/info%3Adoi%2F10.1371%2Fjournal.pone.0022587","version":"Other Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1371%2Fjournal.pone.0022587","version":"Other Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1371/journal.pone.0022587","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus University, Faculty of Health Sciences, Institute of Epidemiology and Social Medicine"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Eu