,"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anders Melchior","key":"hansenpau","last":"Hansen","locid":"716e89be-ac6e-4cb8-9a44-982d3d966560","name":"Hansen, Anders Melchior","orcid":"0000-0002-9284-1936","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Flemming","key":"rasmussenpau","last":"Rasmussen","locid":"b6532be0-3ac5-4c05-81b5-270b78b3ec82","name":"Rasmussen, Flemming","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Torben J.","key":"larsenpau","last":"Larsen","locid":"965dbaf9-67c6-4f4d-b512-2df4845d740d","name":"Larsen, Torben J.","orcid":"0000-0001-6741-5057","rank":3,"rolecode":"pau"}],"pub":{"publisher":"European Wind Energy Association (EWEA)","status":"p","title":"Proceedings"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-28804817-7095-4305-9b41-d4ffbc625301"],"src":["DTU Technical University of Denmark"],"title":"Gearbox loads caused by double contact simulated with HAWC2","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-316616","year":"2011","yearsub":"2011"}
{"abstract":"Ion's toroidal velocity, vt, in both the outermost 4 cm of the confined region and the scrap-off layer of Ohmic L-mode plasmas in EAST was measured using Mach probes. At about 1 cm inside the separatrix a local minimum in vt was observed, from which a cocurrent rotation increased both inwards and outwards. The radial width of the vt dip was 1 cm to 2 cm, and both the density and electron temperature profiles exhibited steep gradients at this dip position. It was observed in both divertor and limiter configurations. To find out its origin, the toroidal torques induced by neutral friction, neoclassical viscosity, collisional perpendicular shear viscosity, ion orbit loss and turbulent Reynolds stress were estimated using the measured parameters. Our results indicate that in this particular parameter regime the neutral friction was the dominant damping force. The calculated cocurrent toroidal torque by the neoclassical viscosity dominates over those from the collisional perpendicular shear viscosity, ion orbit loss and turbulent Reynolds stress. These results are potentially important for the understanding of boundary conditions for the intrinsic toroidal momentum in tokamak plasmas.","author_count":23,"contributors":["Xu, Guosheng","Naulin, Volker","Wan, Baonian","Guo, Houyang","Zhang, Wei","Chang, Jiafeng","Yan, Ning","Ding, Siye","Zhang, Ling","Wang, Liang","Liu, Shaocheng","Liu, Peng","Jiang, Min","Wang, Huiqian","Rasmussen, Jens Juul","Nielsen, Anders Henry","Xiao, Chijin","Gao, Xiang","Hu, Liqun","Zhu, Sizheng","Wu, Zhenwei","Qian, Jinping","Gong, Xianzu"],"cuid":["S01-000.00-316633"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Asia, East","OECD"],"country":["Canada","China","United States"],"glorg":["All Global Affiliations","Chinese Academy of Sciences","TAE Technologies","University of Saskatchewan"],"keyword":["Fusion energy"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"a dip structure in the intrinsic toroidal rotation near the edge of the ohmic plasmas in east","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1088/1009-0630/13/4/03","version":"Other Version"},"id":"S01-000.00-316633","identifier":[{"id":"80052700335","type":"scopus"}],"ids":["dtu-2890aaad-f216-41f4-8d3d-cf8094826ba9"],"keyword":["Fusion energy","Fusioneenergiforskning"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-F8AE56C602B26380D51983592B7B9EAB"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1088/1009-0630/13/4/03","version":"Other Version"}],"org":[{"affno":"1","country":"cn","key":"chinese academy of sciences","loc":["China","Asia, East"],"name":"Chinese Academy of Sciences","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Risø National Laboratory for Sustainable Energy","Technical University of Denmark, Risø National Laboratory for Sustainable Energy, Plasma Physics and Technology Programme"],"nora_code":"DI-U-DTU","used":1},{"affno":"3","country":"us","key":"tae technologies","loc":["United States","America, North","OECD"],"name":"TAE Technologies","used":1},{"affno":"4","country":"ca","key":"university of saskatchewan","loc":["Canada","America, North","OECD"],"name":"University of Saskatchewan","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Guosheng","key":"xuguoshengpau","last":"Xu","name":"Xu, Guosheng","rank":1,"role