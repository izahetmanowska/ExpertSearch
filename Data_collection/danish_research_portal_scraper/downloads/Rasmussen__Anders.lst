c9","name":"Mohn, Christian","orcid":"0000-0002-4331-1365","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anders","key":"mosbechpau","last":"Mosbech","locid":"0d8b3009-ff00-40a7-b738-abfa87e31ccf","name":"Mosbech, Anders","orcid":"0000-0002-7581-7037","rank":3,"rolecode":"pau"}],"pub":{"issue":"11","pages":"39","publisher":"Aarhus University, DCE - Danish Centre for Environment and Energy","repno":"Fagligt notat fra DCE – Nationalt Center for Miljø og Energi , No. 11","series":"Fagligt notat fra DCE - Nationalt Center for Miljø og Energi","status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-aeca78fb-f0e7-4e73-86b0-399c2051ed55"],"src":["AU Aarhus University"],"title":"Dybhavsminedrift : En beskrivelse af miljømæssige problemstillinger ved forskellige typer minedrift i dybhavet","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-728186","year":"2024","yearsub":"2024"}
{"abstract":"The blue wildebeest (Connochaetes taurinus) is a keystone species in savanna ecosystems from southern to eastern Africa, and is well known for its spectacular migrations and locally extreme abundance. In contrast, the black wildebeest (C. gnou) is endemic to southern Africa, barely escaped extinction in the 1900s and is feared to be in danger of genetic swamping from the blue wildebeest. Despite the ecological importance of the wildebeest, there is a lack of understanding of how its unique migratory ecology has affected its gene flow, genetic structure and phylogeography. Here, we analyze whole genomes from 121 blue and 22 black wildebeest across the genus’ range. We find discrete genetic structure consistent with the morphologically defined subspecies. Unexpectedly, our analyses reveal no signs of recent interspecific admixture, but rather a late Pleistocene introgression of black wildebeest into the southern blue wildebeest populations. Finally, we find that migratory blue wildebeest populations exhibit a combination of long-range panmixia, higher genetic diversity and lower inbreeding levels compared to neighboring populations whose migration has recently been disrupted. These findings provide crucial insights into the evolutionary history of the wildebeest, and tangible genetic evidence for the negative effects of anthropogenic activities on highly migratory ungulates.","author_count":28,"contributors":["Liu, Xiaodong","Lin, Long","Sinding, Mikkel Holger S.","Bertola, Laura D.","Hanghøj, Kristian","Quinn, Liam","Garcia-Erill, Genís","Rasmussen, Malthe Sebro","Schubert, Mikkel","Pečnerová, Patrícia","Balboa, Renzo F.","Li, Zilong","Heaton, Michael P.","Smith, Timothy P.L.","Pinto, Rui Resende","Wang, Xi","Kuja, Josiah","Brüniche-Olsen, Anna","Meisner, Jonas","Santander, Cindy G.","Ogutu, Joseph O.","Masembe, Charles","da Fonseca, Rute R.","Muwanika, Vincent","Siegismund, Hans Redlef","Albrechtsen, Anders","Moltke, Ida","Heller, Rasmus"],"cuid":["S01-000.00-738993"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Africa","America, North","Europe, EU","OECD"],"country":["Germany","Portugal","Uganda","United States"],"glorg":["All Global Affiliations","Makerere University","United States Department of Agriculture","University of Hohenheim","University of Porto"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"introgression and disruption of migration routes have shaped the genetic integrity of wildebeest populations","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41467-024-47015-y","version":"Published Version"},"id":"S01-000.00-738993","identifier":[{"id":"85190273859","type":"scopus"},{"id":"38609362","type":"pmid"},{"id":"PMC11014984","type":"pmcid"}],"ids":["ku-40c03343-41e3-4df0-ae4b-15cfadaed82c"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-0C15786A4D48B8E2E5298CA436F78DD5"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/389553133/s41467_024_47015_y.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41467-024-47015-y","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Biology, Computational and RNA Biology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"us","key":"united states department of agriculture","loc":["United States","America, North","OECD"],"name":"United States Department of Agriculture","used":1},{"affno":"3","country":"pt","key":"university of porto","loc":["Portugal","Europe, EU","OECD"],"name":"University of Porto","used":1},{"affno":"4","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Mental Health Services Glostrup"],"nora_code":"DI-HO-CAP","used":1},{"affno":"5","country":"de","key":"university of hohenheim","loc":["Germany","Europe, EU","OECD"],"name":"University of Hohenheim","used":1},{"affno":"6","country":"ug","key":"makerere university","loc":["Uganda","Africa"],"name":"Makerere University","used":1}],"person":[{"affno":"1","first":"Xiaodong","key":"liupau","last":"Liu","locid":"e20c5ca2-aa50-4de3-9ee9-ce2aee1875dc","name":"Liu, Xiaodong","rank":1,"rolecode":"pau"},{"affno":"1","first":"Long","key":"linpau","last":"Lin","locid":"e9851fa0-67e2-4bfa-a5db-29e79ed51e73","name":"Lin, Long","orcid":"0000-0002-1075-6800","rank":2,"rolecode":"pau"},{"affno":"1","first":"Mikkel Holger S.","key":"sindingpau","last":"Sinding","locid":"d441872e-7274-486b-b9b2-0c0ee8bb3545","name":"Sinding, Mikkel Holger S.","orcid":"0000-0003-1371-219X","rank":3,"rolecode":"pau"},{"affno":"1","first":"Laura D.","key":"bertolapau","last":"Bertola","locid":"4642ddac-d5be-4ac5-af29-3b0cf9faf187","name":"Bertola, Laura D.","rank":4,"rolecode":"pau"},{"affno":"1","first":"Kristian","key":"hanghøjpau","last":"Hanghøj","locid":"a17e9d55-e472-4c3b-b988-a1e924c30337","name":"Hanghøj, Kristian","orcid":"0000-0003-1941-5495","rank":5,"rolecode":"pau"},{"affno":"1","first":"Liam","key":"quinnpau","last":"Quinn","locid":"51f8bb78-3a6e-4579-9b13-a376374277dc","name":"Quinn, Liam","rank":6,"rolecode":"pau"},{"affno":"