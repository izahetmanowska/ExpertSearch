,"first":"Maja","key":"vilhelmsenpau","last":"Vilhelmsen","name":"Vilhelmsen, Maja","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kathrine Greby","key":"schmidtpau","last":"Schmidt","locid":"fe5a3b12-fb63-489c-845f-6c39c5e3d62f","name":"Schmidt, Kathrine Greby","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Rasmus","key":"kildedalpau","last":"Kildedal","locid":"4ef5cf07-a9e2-42bb-a947-f2c6e422f506","name":"Kildedal, Rasmus","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Natja","key":"launbopau","last":"Launbo","name":"Launbo, Natja","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Pernille Kold","key":"munchpau","last":"Munch","name":"Munch, Pernille Kold","rank":6,"rolecode":"pau"},{"affno":"3 4","first":"Mark","key":"lidegaardpau","last":"Lidegaard","name":"Lidegaard, Mark","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Sandra Schade","key":"jacobsenpau","last":"Jacobsen","locid":"b7ed90e4-5f06-4835-afa5-d14b82da0e01","name":"Jacobsen, Sandra Schade","rank":8,"rolecode":"pau"},{"affno":"5 2","country":"dk","first":"Charlotte Lund","key":"rasmussenpau","last":"Rasmussen","locid":"3dd09469-6df0-44c2-9f98-09b9c03b2c27","name":"Rasmussen, Charlotte Lund","rank":9,"rolecode":"pau"},{"affno":"6 7","first":"Svend Erik","key":"mathiassenpau","last":"Mathiassen","name":"Mathiassen, Svend Erik","rank":10,"rolecode":"pau"},{"affno":"8 9","first":"Leon","key":"strakerpau","last":"Straker","name":"Straker, Leon","rank":11,"rolecode":"pau"},{"affno":"5 2","first":"Andreas","key":"holtermannpau","last":"Holtermann","locid":"87651477-683c-4f73-9aa0-ae43ad791f2b","name":"Holtermann, Andreas","orcid":"0000-0003-4825-5697","rank":12,"rolecode":"pau"}],"pmid":["33053791"],"pub":{"doi":"10.3390/ijerph17207419","issn":["16604601","16617827"],"issn_org":["16617827"],"issue":"20","journal":"International Journal of Environmental Research and Public Health","paperid":"7419","p