{"abstract":"Vascular endothelial growth factor B (VEGFB) is a pleiotropic trophic factor which, in contrast to the closely related VEGFA, is known to have a limited effect on angiogenesis. VEGFB improves survi...","author_count":12,"contributors":["Dmytriyeva, Oksana","de Diego Ajenjo, Amaia","Lundø, Kathrine","Hertz, Henrik","Rasmussen, Kim K.","Christiansen, Anders Tolstrup","Klingelhofer, Jorg","Nielsen, Alexander L.","Hoeber, Jan","Kozlova, Elena Nickolaevna","Woldbye, David Paul Drucker","Pankratova, Stanislava"],"cuid":["S01-000.00-442880"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"neurotrophic effects of vascular endothelial growth factor b and novel mimetic peptides on neurons from the central nervous system","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-442880","identifier":[{"id":"85084272615","type":"scopus"},{"id":"32283014","type":"pmid"}],"ids":["ku-52d3d174-1dc1-4ce6-a261-4a19fbb5cb20"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-E68D50154534EB91ECB8CED68082078F"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Biomedical Sciences, Molecular and Translational Pharmacology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Oksana","key":"dmytriyevapau","last":"Dmytriyeva","locid":"733b204a-bf