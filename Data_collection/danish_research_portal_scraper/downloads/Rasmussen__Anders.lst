d":["36495188"],"pub":{"doi":"10.1002/pds.5582","issn":["10538569","10991557"],"issn_org":["10538569"],"issue":"5","journal":"Pharmacoepidemiology and Drug Safety","pages":"592-596","publisher":"John Wiley and Sons Ltd","status":"p","title":"Pharmacoepidemiology and Drug Safety","volume":"32"},"review":"Peer Reviewed","scoID":["2-s2.0-85145290505"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-a6145f1a-f724-41c9-a273-8fcd819dd071","sdu-f0e845a8-4602-4ec4-8059-70c333ec6f93"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Validation of safety outcomes in routinely collected data : Lessons learned from a multinational postapproval safety study","type":"Journal Comment","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-096.60-666401","year":"2023","yearsub":"2023"}
{"abstract":"BACKGROUND: Children spend increasing amounts of time on recreational screen media, which may lead to an obesogenic environment. OBJECTIVES: We investigated the association of trajectories of screen time across ages 3, 5 and 7 years with body composition at age 7 in the Odense Child Cohort. METHODS: Data were collected in the Municipality of Odense, Denmark, between 2010 and 2019. Group-based trajectory modelling was applied to group participants into four trajectories of prospective parent-reported screen time. Body composition was assessed using dual-energy x-ray absorptiometry with calculated fat-mass index (FMI) as the primary outcome. Primary models were linear multivariable regression models adjusted for participants' sex, age, birthweight, maternal origin, maternal education, maternal body-mass-index, and maternal age. Further models were adjusted for additional possible confounders. Selection bias was addressed by inverse probability weighting. RESULTS: In total, 803 children (48.2% female) were included in the primary analysis. Participants with screen time at all time points were assigned to four trajectory groups [constant low screen time (12.7%), low increase (36.3%), high increase between ages 3 and 5 (33.5%) and high increase in screen time (17.5%)]. Sample characteristics differed across missing data status and trajectories. Mean FMI (kg/m2 ) and standard deviation (SD) were 3.7 (SD 1.3) and 3.9 (SD 1.6) for the constant low versus high screen time, respectively. No differences in FMI were found between screen time trajectory groups at age 7 (adjusted mean difference 0.1 kg/m2 , 95% confidence interval -0.3, 0.5 for constant low versus high screen time). No consistent associations between screen time groups and secondary body composition outcomes were found. CONCLUSIONS: Results from this study do not suggest that recreational screen time from age 3 to 7 years is associated with adiposity or other measures of body composition.","author_count":7,"contributors":["Rietz, Marlene","Schmidt-Persson, Jesper","Rasmussen, Martin Gillies Banke","Klakk, Heidi","Wedderkopp, Niels","Kristensen, Peter Lund","Grøntved, Anders"],"cuid":["S02-099.37-681612"],"filters":{"added":"2023-08","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Rietz, Marlene"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U","DI-UC"],"level3":{"U":["DI-U-ALL","DI-U-SDU"],"UC":["DI-UC-ALL","DI-UC-UCS"]},"level3all":["DI-U-SDU","DI-UC-UCS"]},"review":"pr","rtype":["clu"],"sorti":"recreational screen time trajectories during early childhood and imaging measured body composition at age 000000000007 in the odense child cohort","src":["sdu","ucsyd"],"src-code":["DI-U-SDU","DI-UC-UCS"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1111/ppe.12956","version":"Published Version"},"id":"S02-099.37-681612","identifier":[{"id":"36799105","type":"pmid"},{"id":"85148424377","type":"scopus"}],"ids":["sdu-642e6288-c8bb-4c27-b51d-56c604c43c5e","ucsyd-6a718c00-c457-43f1-a13e-e95bf090ec92"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-F18F864135A470757A65573AC758977C"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/236256610/Paediatric_Perinatal_Epid_2023_Rietz_Recreational_screen_time_trajectories_during_early_childhood_and.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1111/ppe.12956","version":"Published Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics, Research Unit of Exercise Epidemiology"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","key":"uc syd university college south denmark","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-UCS","l3nl":"UC SYD, University College South Denmark","l3nn":"UC SYD University College South Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"UC SYD University College South Denmark","namevar":["UC SYD, Pædagogik og skole, Forskning, Forskning"],"nora_code":"DI-UC-UCS","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Marlene","key":"rietzpau","last":"Rietz","locid":"11707e1a-a853-411c-a38c-b10a6c65914b","name":"Rietz, Marlene","orcid":"0000-0002-6422-6215","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper","key":"schmidtperssonpau","last":"Schmidt-Persson","locid":"f321394d-8abe-49b2-ab02-1b528e734f63","name":"Pedersen, Jesper","name_org":"Schmidt-Persson, Jesper","orcid":"0000-0002-9475-0341","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Martin Gillies Banke","key":"rasmussenpau","last":"Rasmussen","locid":"8b86a1ef-e6c1-4de3-8300-e30d144bbf60","name":"Rasmussen, Martin Gillies Banke","orcid":"0000-0002-2114-2185","rank":3,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Heidi Klakk","key":"egebaekpau","last":"Egebaek","locid":"0ca52676-95ab-44b8-89f9-0dd375d8adb8","name":"Klakk, Heidi","name_org":"Egebaek, Heidi Klakk","orcid":"0000-0002-9299-4334","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Niels","key":"wedderkopppau","last":"Wedderkopp","locid":"bcfae344-0a75-458d-8ba2-4198ee915d40","name":"Wedderkopp, Niels","orcid":"0000-0002-9660-6618","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter Lund","key":"kristensenpau","last":"Kristensen","locid":"751d26de-66d4-4ef9-8183-880c48c96dc7","name":"Kristensen, Peter Lund","orcid":"0000-0002-5666-9614","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders","key":"grøntvedpau","last":"Grøntved","locid":"393b1ca1-e658-437c-9ca3-73aea925ad58","name":"Grøntved, Anders","orcid":"0000-0003-1584-679X","rank":7,"rolecode":"pau"}],"pmid":["36799105"],"pub":{"doi":"10.1111/ppe.12956","issn":["02695022","13653016"],"issn_org":["02695022"],"issue":"5","journal":"Paediatric and Perinatal Epidemiology","pages":"415-424","publisher":"Wiley-Blackwell","status":"p","title":"Paediatric and Perinatal Epidemiology","volume":"37"},"review":"Peer Reviewed","scoID":["2-s2.0-85148424377"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","All University Colleges","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","Hospitals","Region of Southern Denmark","UC SYD, University College South Denmark","Universities","University Colleges","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-642e6288-c8bb-4c27-b51d-56c604c43c5e","ucsyd-6a718c00-c457-43f1-a13e-e95bf090ec92"],"src":["SDU University of Southern Denmark","UC SYD University College South Denmark"],"title":"Recreational screen time trajectories during early childhood and imaging-measured body composition at age 7 in the Odense child cohort","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.37-681612","year":"2023","yearsub":"2023"}
{"abstract":"Background: Postoperative pain after total knee arthroplasty (TKA) is a continuing problem despite optimised multimodal analgesia. Previous studies have shown preoperative glucocorticoids to reduce postoperative pain, but knowledge about specific doses and effects in specific patient groups is lacking. Methods: A two-centre, double-blind, two-arm study comparing preoperative dexamethasone (1 mg kg−1 vs 0.3 mg kg−1 i.v.) on postoperative pain in 160 planned TKA subjects with low preoperative pain catastrophising and no opioid use. Subjects received multimodal analgesia with paracetamol, cyclooxygenase-2 inhibitors, local anaesthetic infiltration analgesia, and rescue opioids. The primary outcome was percentage of subjects experiencing moderate to severe pain (visual analogue scale >30 mm) upon ambulation at 24 h. Secondary outcomes included pain scores, postoperative inflammation (C-reactive protein), opioid and antiemetics use, and ‘Quality of Recovery-15’ and ‘Opioid-Related Symptom Distress Scale’, length of stay, readmissions, and complications up to Day 90. Results: A total of 157 subjects (80 vs 77) were included. No difference was found between groups in the incidence of subjects experiencing visual analogue scale >30 on ambulation 24 h after surgery (56% vs 53%, relative risk =1.07, confidence interval: 0.8–1.4, P=0.65). No differences in other pain outcomes or use of rescue opioids and antiemetics, in Quality of Recovery-15 and Opioid-Related Symptom Distress Scale, length of stay, readmissions, or complications. C-reactive protein values were comparable at 24 h (13 [6–25] mg L−1 vs 16 [9–38] mg L−1, P = 0.07), but lower at 48 h (26 [9–52] mg L−1 vs 50 [30–72] mg L−1, P<0.01) in the high-dose group. Conclusion: Use of 1 mg kg−1 vs 0.3 mg kg−1 i.v. dexamethasone in low pain responders after TKA did not improve early postoperative pain or other outcomes in contrast to benefits in a high pain responder population. Clinical trial registration: NCT03758170 (first registration 29-11-2018).","author_count":10,"contributors":["Nielsen, Niklas I.","Kehlet, Henrik","Gromov, Kirill","Troelsen, Anders","Husted, Henrik","Varnum, Claus","Kjærsgaard-Andersen, Per","Rasmussen, Lasse Enkebølle","Pleckaitiene, Lina","Foss, Nicolai B."],"cuid":["S02-100.00-698298"],"filters":{"added":"2023-04","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Nielsen, Niklas I."],"keyword":["Anaesthesia","Analgesics Opioid","Anesthetics Local","Antiemetics therapeutic use","Arthroplasty Replacement Knee adverse effects","C Reactive Protein","Dexamethasone","Dexamethasone therapeutic use","Double Blind Method","Fast track surgery","Humans","Multimodal analgesia","Pain Postoperative drug therapy","Perioperative medicine","Postoperative pain","Total knee arthroplasty"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-SDR","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"high dose dexamethasone in low pain responders undergoing total knee arthroplasty a randomised double blind trial","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.bja.2022.10.038","version":"Published Version"},"funding_acknowledgement":["An unconditional grant from Candys Foundation to HK ."],"id":"S02-100.00-698298","identifier":[{"id":"36526481","type":"pmid"},{"id":"85148479543","type":"scopus"}],"ids":["ku-c620a60b-4c45-47bf-85dd-a48944f50e8d","sdu-19e155b7-b930-4135-b61d-f0fab62a5d2d"],"keyword":["Analgesics, Opioid","Anesthetics, Local","Antiemetics/therapeutic use","Arthroplasty, Replacement, Knee/adverse effects","C-Reactive Protein","Dexamethasone/therapeutic use","Double-Blind Method","Humans","Pain, Postoperative/drug therapy","anaesthesia","dexamethasone","fast-track surgery","multimodal analgesia","perioperative medicine","postoperative pain","total knee arthroplasty"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-1FECB899EECF388A134C667024103E45"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/370207606/1_s2.0_S0007091222006304_main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/222923878/Open_Access_Version.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.bja.2022.10.038","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Regional Health Research","SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Lillebælt Hospital, Research Unit of Orthopaedics (Vejle)"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Lillebaelt University Hospital"],"nora_code":"DI-HO-SDR","used":1}],"person":[{"affno":"1","first":"Niklas I.","key":"nielsenpau","last":"Nielsen","locid":"7f5e02f9-db74-437d-a29e-60baae07f850","name":"Nielsen, Niklas","name_org":"Nielsen, Niklas I.","rank":1,"rolecode":"pau"},{"affno":"1","first":"Henrik","key":"kehletpau","last":"Kehlet","locid":"0a3c43a0-a0c5-4a91-85d6-6e80e16af8b5","name":"Kehlet, Henrik","orcid":"0000-0002-2209-1711","rank":2,"rolecode":"pau"},{"affno":"1","first":"Kirill","key":"gromovpau","last":"Gromov","locid":"efb84811-45bd-4724-97f5-e10d5b84525f","name":"Gromov, Kirill","rank":3,"rolecode":"pau"},{"affno":"1","first":"Anders","key":"troelsenpau","last":"Troelsen","locid":"49cb6bcf-2ff6-41af-a356-a2a09c2ce7ba","name":"Troelsen, Anders","orcid":"0000-0003-0132-8182","rank":4,"rolecode":"pau"},{"affno":"1","first":"Henrik","key":"hustedpau","last":"Husted","locid":"f8dc9a5b-bf7f-45e7-b210-3b25c01cfa24","name":"Husted, Henrik","rank":5,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Claus","key":"varnumpau","last":"Varnum","locid":"0f639544-4ebc-467c-a15b-3c049a26f62f","name":"Varnum, Claus","orcid":"0000-0002-0625-5691","rank":6,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Per","key":"kjærsgaardandersenpau","last":"Kjærsgaard-Andersen","locid":"9d7006f6-37d8-43c1-a108-2705353942f6","name":"Kjærsgaard-Andersen, Per","orcid":"0000-0001-6845-4218","rank":7,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Lasse E.","key":"rasmussenpau","last":"Rasmussen","locid":"ada7d12e-e6cc-4568-b072-91b059d28c72","name":"Rasmussen, Lasse Enkebølle","name_org":"Rasmussen, Lasse E.","rank":8,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Lina","key":"pleckaitienepau","last":"Pleckaitiene","locid":"806dda50-3350-49fd-8060-2bf36188d853","name":"Pleckaitiene, Lina","rank":9,"rolecode":"pau"},{"affno":"1","first":"Nicolai B.","key":"fosspau","last":"Foss","locid":"dc8c28e3-27ee-4329-8985-2b176ab69b4b","name":"Foss, Nicolai Bang","name_org":"Foss, Nicolai B.","rank":10,"rolecode":"pau"}],"pmid":["36526481"],"pub":{"doi":"10.1016/j.bja.2022.10.038","issn":["00070912","14716771"],"issn_org":["00070912"],"issue":"3","journal":"British Journal of Anaesthesia","pages":"322-330","publisher":"Elsevier","status":"p","title":"British Journal of Anaesthesia","volume":"130"},"review":"Peer Reviewed","scoID":["2-s2.0-85148479543"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-c620a60b-4c45-47bf-85dd-a48944f50e8d","sdu-19e155b7-b930-4135-b61d-f0fab62a5d2d"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"High-dose dexamethasone in low pain responders undergoing total knee arthroplasty : a randomised double-blind trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-698298","year":"2023","yearsub":"2023"}
{"abstract":"For at least 9000 years dogs have been pulling sleds across the Arctic, facilitating subsistence strategies and migrations. Despite the enduring presence of dogs in the Arctic there is an absence of comprehensive studies of the material culture associate with dog sledding, including the diverse technical elements needed for the activity. This study proposes a framework for the recognition of reliable archaeological indicators of dog sledding. The outcome is based on comparisons between ethnographic information of the dog traction technology and archaeological sites from the Arctic regions of Siberia, Alaska, Canada, and Greenland using multivariate analysis. These sites were selected as case studies to encompass the breadth of geographical and Inuit cultural diversity where dog sledding traditionally has been practiced. We argue, that by using this framework it is possible to study dog sledding in the Arctic prior to the Thule Inuit period and gain more knowledge about the origin of the practice. By combining sources from ethnography, history and archaeology, our framework identified items involved in dog sledding that were universal to the practice as well as items that were regionally specific. However, the most reliable evidence for dog sledding is the presence of both sled parts, dog bones and equipment for harnessing the dogs.","author_count":6,"contributors":["Vitale, Emma","Rasmussen, Jacob Agerbo","Grønnow, Bjarne","Hansen, Anders Johannes","Meldgaard, Morten","Feuerborn, Tatiana R."],"cuid":["S02-100.00-716463"],"filters":{"added":"2023-11","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["America, North","Nordic","OECD"],"country":["Greenland","United States"],"glorg":["All Global Affiliations","National Human Genome Research Institute","National Institutes of Health","University of Greenland"],"keyword":["Archaeology","Arctic","Arctic Regions","Dog sledding","Ethnography","Faculty of Health and Medical Sciences","Material Culture"],"level":"sci","mra":["hum","med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-KUM"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-GV-KUM","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"an ethnographic framework for identifying dog sledding in the archaeological record","src":["ku","kum"],"src-code":["DI-GV-KUM","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1016/j.jas.2023.105856","version":"Published Version"},"id":"S02-100.00-716463","identifier":[{"id":"85171800909","type":"scopus"}],"ids":["ku-9336beaf-0f75-4677-a015-87dd1ae124f8","kum-0b6d0f0f-231c-4ef2-a660-7fc439d14ff9"],"keyword":["Arctic","Dog sledding","Ethnography","Faculty of Health and Medical Sciences","Material culture","archaeology","arctic regions"],"lang":"English","level":"Scientific","mra":["Humanities","Medical Science"],"noi":["Global-Local-2-5-01E312A8A218FA0D810CAFAA59E371AF"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://curis.ku.dk/ws/files/368727802/1_s2.0_S030544032300136X_main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1016/j.jas.2023.105856","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Globe Institute, Section for Geogenetics"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"gl","key":"university of greenland","loc":["Greenland","Nordic"],"name":"University of Greenland","used":1},{"affno":"3","country":"dk","key":"kum ministry of culture archives museums and royal library denmark","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-KUM","l3nn":"KUM Ministry of Culture - Archives, Museums, and Royal Library Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KUM Ministry of Culture - Archives, Museums, and Royal Library Denmark","namevar":["National Museum of Denmark"],"nora_code":"DI-GV-KUM","used":1},{"affno":"4","country":"us","key":"national institutes of health","loc":["United States","America, North","OECD"],"name":"National Institutes of Health","used":1},{"affno":"5","country":"us","key":"national human genome research institute","loc":["United States","America, North","OECD"],"name":"National Human Genome Research Institute","used":1}],"person":[{"affno":"1 2 3","first":"Emma","key":"vitalepau","last":"Vitale","locid":"5a5b3680-8400-4057-b593-e59a55f796ca","name":"Vitale, Emma","orcid":"0000-0003-1696-4261","rank":1,"rolecode":"pau"},{"affno":"1","first":"Jacob Agerbo","key":"rasmussenpau","last":"Rasmussen","locid":"f89cd3c8-6ae8-4cbc-831a-7471eed8e5f5","name":"Rasmussen, Jacob Agerbo","orcid":"0000-0002-7710-8912","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Bjarne","key":"grønnowpau","last":"Grønnow","locid":"f1560a3d-f23b-48b5-b66c-628e15692a53","name":"Grønnow, Bjarne","orcid":"0000-0003-1979-1482","rank":3,"rolecode":"pau"},{"affno":"1","first":"Anders Johannes","key":"hansenpau","last":"Hansen","locid":"846e4329-bfc5-4ddb-968c-445cdb16825a","name":"Hansen, Anders Johannes","orcid":"0000-0002-1890-2702","rank":4,"rolecode":"pau"},{"affno":"2 1","first":"Morten","key":"meldgaardpau","last":"Meldgaard","locid":"1b869e6b-0d67-4e8b-9c79-12c7e6e07103","name":"Meldgaard, Morten","rank":5,"rolecode":"pau"},{"affno":"4 5","first":"Tatiana R.","key":"feuerbornpau","last":"Feuerborn","name":"Feuerborn, Tatiana R.","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.jas.2023.105856","issn":["03054403","10959238"],"issn_org":["03054403"],"issue":"2023","journal":"Journal of Archaeological Science","pages":"1-10","paperid":"105856","publisher":"Elsevier Inc.","status":"p","title":"Journal of Archaeological Science","volume":"159"},"review":"Peer Reviewed","scoID":["2-s2.0-85171800909"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-9336beaf-0f75-4677-a015-87dd1ae124f8","kum-0b6d0f0f-231c-4ef2-a660-7fc439d14ff9"],"src":["KU University of Copenhagen","KUM Ministry of Culture - Archives, Museums, and Royal Library Denmark"],"title":"An ethnographic framework for identifying dog sledding in the archaeological record","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-716463","year":"2023","yearsub":"2023"}
{"abstract":"BACKGROUND: Intensive care unit (ICU) patients with Coronavirus disease 2019 (COVID-19) have an increased risk of thromboembolic complications. We describe the occurrence of thromboembolic and bleeding events in all ICU patients with COVID-19 in Denmark during the first and second waves of the pandemic. METHODS: This was a sub-study of the Danish Intensive Care Covid database, in which all patients with SARS-CoV-2 admitted to Danish ICUs from 10th March 2020 to 30th June 2021 were included. We registered coagulation variables at admission, and all thromboembolic and bleeding events, and the use of heparins during ICU stay. Variables associated with thrombosis and bleeding and any association with 90-day mortality were estimated using Cox regression analyses. RESULTS: We included 1369 patients in this sub-study; 158 (12%, 95% confidence interval 10-13) had a thromboembolic event in ICU and 309 (23%, 20-25) had a bleeding event, among whom 81 patients (6%, 4.8-7.3) had major bleeding. We found that mechanical ventilation and increased D-dimer were associated with thrombosis and mechanical ventilation, low platelet count and presence of haematological malignancy were associated with bleeding. Most patients (76%) received increased doses of thromboprophylaxis during their ICU stay. Thromboembolic events were not associated with mortality in adjusted analysis (hazard ratio 1.35 [0.91-2.01, p = .14], whereas bleeding events were 1.55 [1.18-2.05, p = .002]). CONCLUSIONS: Both thromboembolic and bleeding events frequently occurred in ICU patients with COVID-19. Based on these data, it is not apparent that increased doses of thromboprophylaxis were beneficial.","author_count":30,"contributors":["Russell, Lene","Weihe, Sarah","Madsen, Emilie Kabel","Hvas, Christine Lodberg","Leistner, Jens Wolfgang","Michelsen, Jens","Brøchner, Anne Craveiro","Bastiansen, Anders","Nielsen, Frederik Mølgaard","Meier, Nick","Andreasen, Anne Sofie","Ribergaard, Niels-Erik","Rasmussen, Bodil Steen","Sølling, Christoffer Grant","Buck, David Levarett","Bundgaard, Helle","Pedersen, Helle Scharling","Darfelt, Iben Strøm","Poulsen, Lone Musaeus","Ibsen, Michael","Plovsing, Ronni R.","Sigurdsson, Sigurdur T.","Iversen, Susanne","Hildebrandt, Thomas","Mohr, Thomas","Espelund, Ulrick Skipper","Jørgensen, Vibeke","Haase, Nicolai","Perner, Anders"],"cuid":["S03-091.33-004156"],"filters":{"added":"2022-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"corresponding_author":["Russell, Lene"],"keyword":["Anticoagulants adverse effects","Bleeding","COVID 19 complications","Covid 19","Critical care","Hemorrhage","Humans","Intensive Care Units","SARS CoV 2","Thromboprophylaxis","Thrombosis","Venous Thromboembolism epidemiology"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA"],"OT":["Hjørring Regional Hospital"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"thromboembolic and bleeding events in icu patients with covid 000000000019 a nationwide observational study","src":["aau","au","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1111/aas.14157","version":"Published Version"},"funding_acknowledgement":["Anders Perner holds grants from the Novo Nordisk Foundation to do trials in ICU patients, including those with COVID‐19. Bodil Steen Rasmussen holds a grant from the Novo Nordisk Foundation for a trial in COVID‐19 patients. The Department of Intensive Care, Rigshospitalet, has received research funds from Fresenius Kabi, Pfizer, AM‐Pharma and Sygeforsikringen ‘Danmark’."],"id":"S03-091.33-004156","identifier":[{"id":"PMC9874434","type":"pmcid"},{"id":"36263897","type":"pmid"},{"id":"85141525308","type":"scopus"}],"ids":["aau-54fc80e4-96a1-4df7-bea8-ab067d6bd25a","au-24eeb516-8696-420f-9b42-766e9f782a2e","sdu-d7d06e58-1d0d-4640-b65a-c2432952f697"],"keyword":["Anticoagulants/adverse effects","COVID-19","COVID-19/complications","Critical Care","Hemorrhage","Humans","Intensive Care Units","SARS-CoV-2","Venous Thromboembolism/epidemiology","bleeding","thromboprophylaxis","thrombosis"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-3-7-4CD97EEF47B136BF914DE26DF9F698BE"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/513850862/Russell_et_al._2022_._Thromboembolic_and_bleeding_events_in_ICU_patients_with_COVID_19_A_nationwide_observational_study.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1111/aas.14157","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://pure.au.dk/ws/files/414662955/Acta_Anaesthesiol_Scand_-_2022_-_Russell_-_Thromboembolic_and_bleeding_events_in_ICU_patients_with_COVID_19_A_nationwide_.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/217820815/Acta_Anaesthesiol_Scand_2022_Russell_Thromboembolic_and_bleeding_events_in_ICU_patients_with_COVID_19_A_nationwide_.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Rigshospitalet, Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","country":"dk","key":"ku university of copenhagen","l2":