. Juul","key":"rasmussenpau","last":"Rasmussen","locid":"125b9658-f84c-4e0e-859e-5899413288ee","name":"Rasmussen, Jens Juul","name_org":"Rasmussen, J. Juul","orcid":"0000-0002-3543-690X","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Volker","key":"naulinpau","last":"Naulin","locid":"68cb67c0-c64d-4fef-a301-67ab58d8ace6","name":"Naulin, Volker","orcid":"0000-0001-5452-9215","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anders Henry","key":"nielsenpau","last":"Nielsen","locid":"1d9aa958-9d84-4a3b-8300-f6fe9b0be73e","name":"Nielsen, Anders Henry","orcid":"0000-0003-3642-3905","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Frederik","key":"treuepau","last":"Treue","locid":"6f36667b-82a1-474f-9267-dc647e79c335","name":"Treue, Frederik","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1088/0741-3335/57/7/079501","issn":["07413335","13616587"],"issn_org":["07413335"],"issue":"7","journal":"Plasma Physics and Controlled Fusion","paperid":"079501","publisher":"IOP Publishing","status":"p","title":"Plasma Physics and Controlled Fusion","volume":"57"},"review":"Peer Reviewed","scoID":["2-s2.0-84936791684"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-af137347-3137-4bc0-bf26-8248b650f239"],"src":["DTU Technical University of Denmark"],"title":"Gyrofluid potential vorticity equation and turbulent equipartion states (vol 57, 054016, 2015) : Corrigenda","type":"Journal Comment","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-356867","year":"2015","yearsub":"2015"}
{"abstract":"To understand the connection between the dynamics of microscopic turbulence and the macroscale power scaling in the L-I-H transition in magnetically confined plasmas, a new time-dependent, one-dimensional (in radius) model has been developed. The model investigates the radial force balance equation at the edge region of the plasma and applies the quenching effect of turbulence via the E x B flow shear rate exceeding the shear suppression threshold. By slightly ramping up the heating power, the spatio-temporal evolution of turbulence intensity, density and pressure profiles, poloidal flow and E x B flow selfconsistently displays the L-H transition with an intermediate phase (I-phase) characterized by limit-cycle oscillations. Since the poloidal flow is partially damped to the neoclassical flow in the edge region, the numerical results reveal two different oscillation relationships between the E x B flow and the turbulence intensity depending on which oscillation of the diamagnetic flow or poloidal flow is dominant. Specifically, by including the effects of boundary conditions of density and temperature, the model results in a linear dependence of the H-mode access power on the density and magnetic field. These results imply that the microscopic turbulence dynamics and the macroscale power scaling for the L-H transition are strongly connected.","author_count":6,"contributors":["Wu, Xingquan","Xu, Guosheng","Wan, Baonian","Rasmussen, Jens Juul","Naulin, Volker","Nielsen, Anders Henry"],"cuid":["S01-000.00-373271"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","Chinese Academy of Sciences"],"keyword":["E x B flow shear","L H transition"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"one dimensional modelling of limit cycle oscillation and h mode power scaling","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/110825148/0029_5515_55_5_053029.pdf","version":"Published Version"},"id":"S01-000.00-373271","identifier":[{"id":"000353546700030","type":"wos"},{"id":"84928680114","type":"scopus"}],"ids":["dtu-e5df5505-16e5-4688-befb-fc93ebe92604"],"keyword":["E x B flow shear","L-H transition","Limit-cycle oscillation","Power threshold scaling"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-C50962A0829A5E980636F452D66CBE1A"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1088/0029-5515/55/5/053029","version":"Other Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/110825148/0029_5515_55_5_053029.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","country":"cn","key":"chinese academy of sciences","loc":["China","Asia, East"],"name":"Chinese Academy of Sciences","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Physics","Technical University of Denmark, Department of Physics, Plasma Physics and Fusion Energy"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Xingquan","key":"wupau","last":"Wu","name":"Wu, Xingquan","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Guosheng","key":"xupau","last":"Xu","name":"Xu, Guosheng","rank":2,"rolecode":"pau"},{"affno":"1","corre