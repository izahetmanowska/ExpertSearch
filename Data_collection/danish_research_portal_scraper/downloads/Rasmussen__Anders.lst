mussen, Jon Bjarke Jarløv","name_org":"Rasmussen, Jon","rank":10,"rolecode":"pau"},{"affno":"5 6","corresponding":null,"first":"Trine Welløv","key":"boesgaardpau","last":"Boesgaard","name":"Boesgaard, Trine Welløv","rank":11,"rolecode":"pau"},{"affno":"3 2","first":"Morten","key":"schoupau","last":"Schou","locid":"48fa6ec9-1941-4566-b931-14b0cc8cbae3","name":"Schou, Morten","rank":12,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Lars","key":"videbaekpau","last":"Videbaek","locid":"c0abdf18-4e26-411a-99c3-de3cbe029dee","name":"Videbæk, Lars","name_org":"Videbaek, Lars","rank":13,"rolecode":"pau"},{"affno":"","first":"Lars","key":"videbækpau","last":"Videbæk","name":"Videbæk, Lars","rank":13,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Ida","key":"gustafssonpau","last":"Gustafsson","name":"Gustafsson, Ida","rank":14,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Allan","key":"flyvbjergpau","last":"Flyvbjerg","locid":"29cf36bd-c1a0-4026-8c90-a70cb1f46402","name":"Flyvbjerg, Allan","rank":15,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik","key":"wiggerspau","last":"Wiggers","locid":"aef6a13e-8c07-474c-a4f6-bc35236a6eda","name":"Wiggers, Henrik","rank":16,"rolecode":"pau"},{"affno":"5 6 3","corresponding":null,"first":"Lise","key":"tarnowpau","last":"Tarnow","name":"Tarnow, Lise","rank":17,"rolecode":"pau"}],"pmid":["27790809"],"pub":{"doi":"10.1002/ejhf.657","issn":["13889842","18790844"],"issn_org":["13889842"],"issue":"1","journal":"European Journal of Heart Failure","pages":"69-77","publisher":"John Wiley and Sons Ltd","status":"p","title":"European Journal of Heart Failure","volume":"19"},"review":"Peer Reviewed","scoID":["2-s2.0-84996938099"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospital