,{"affno":"1","corresponding":null,"first":"Alfonso","key":"builpau","last":"Buil","name":"Buil, Alfonso","rank":6,"rolecode":"pau"},{"affno":"4","first":"Simon","key":"rasmussenpau","last":"Rasmussen","locid":"274c7fdf-d0c2-4c4e-8739-9b5e74d5005f","name":"Rasmussen, Simon","orcid":"0000-0001-6323-9041","rank":7,"rolecode":"pau"},{"affno":"4","first":"Rosa L","key":"allesøepau","last":"Allesøe","locid":"002d4d20-9338-4cb0-8b1d-118b4885729a","name":"Allesøe, Rosa Lundbye","name_org":"Allesøe, Rosa L","rank":8,"rolecode":"pau"},{"affno":"4","first":"Thomas","key":"wergepau","last":"Werge","locid":"905c01bb-6319-4ce6-a38e-ceb5bf73d2f6","name":"Werge, Thomas","rank":9,"rolecode":"pau"},{"affno":"5 3","corresponding":null,"country":"dk","first":"Ole","key":"morspau","last":"Mors","locid":"5f2ed327-ac0b-4d3e-aa1b-e6991cc4d11c","name":"Mors, Ole","rank":10,"rolecode":"pau"},{"affno":"3 5","corresponding":null,"first":"Anders D","key":"børglumpau","last":"Børglum","locid":"c07475fc-3b67-4893-9a76-9587000870ee","name":"Børglum, Anders D","rank":11,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"David M","key":"hougaardpau","last":"Hougaard","name":"Hougaard, David M","rank":12,"rolecode":"pau"},{"affno":"5","corresponding":null,"country":"dk","first":"Preben B","key":"mortensenpau","last":"Mortensen","locid":"59099748-c5c8-4c1c-8bcb-023f8c51a090","name":"Mortensen, Preben Bo","name_org":"Mortensen, Preben B","orcid":"0000-0002-5230-9865","rank":13,"rolecode":"pau"},{"affno":"4","first":"Merete","key":"nordentoftpau","last":"Nordentoft","locid":"6d0fe19c-7c81-463b-8bc8-822d71584b69","name":"Nordentoft, Merete","rank":14,"rolecode":"pau"},{"affno":"4","first":"Michael E","key":"benrospau","last":"Benros","locid":"1b26702e-798a-4c72-a950-39f4b6f71495","name":"Benros, Michael Eriksen","name_org":"Benros, Michael E","orcid":"0000-0003-4939-9465","rank":15,"rolecode":"pau"}],"pmid":["32534018"],"pub":{"doi":"10.1016/j.bbi.2020.06.014","issn":["08891591","10902139"],"issn_org":["08891591"],"journal":"Brain, Behavior, and Immunity","pages":"10-23","publisher":"Academic Press Inc.","status":"p","title":"Brain, Behavior, and Immunity","volume":"91"},"review":"Peer Reviewed","scoID":["2-s2.0-85089989285"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Non-Profit Organisations","All Universities","Capital Region of Denmark","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Non-Profit Organisations","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-921a0c02-a4d8-4bed-a77f-d6d21cc57357","ku-4a689642-4763-4064-8472-967b2b55e0c5"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Genetic factors underlying the bidirectional relationship between autoimmune and mental disorders - findings from a Danish population-based study : [Incl. Corrigendum]","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-098.60-023337","year":"2021","yearsub":"2021"}
{"abstract":"OBJECTIVES: To compare diagnostic accuracy of contrast-enhanced CT, dual-layer detector spectral CT (DL-CT), and whole-body MRI (WB-MRI) for diagnosing metastatic breast cancer. METHODS: One hundred eighty-two biopsy-verified breast cancer patients suspected of metastatic disease prospectively underwent contrast-enhanced DL-CT and WB-MRI. Two radiologists read the CT examinations with and without spectral data in consensus with 3-month washout between readings. Two other radiologists read the WB-MRI examinations in consensus. Lymph nodes, visceral lesions, and bone lesions were assessed. Readers were blinded to other test results. Reference standard was histopathology, previous or follow-up imaging, and clinical follow-up. RESULTS: Per-lesion AUC was 0.80, 0.84, and 0.82 (CT, DL-CT, and WB-MRI, respectively). DL-CT showed significantly higher AUC than CT (p = 0.001) and WB-MRI (p = 0.02). Sensitivity and specificity of CT, DL-CT, and WB-MRI were 0.66 and 0.94, 0.75 and 0.95, and 0.65 and 0.98, respectively. DL-CT significantly improved sensitivity compared to CT (p < 0.0001) and WB-MRI (p = 0.002). Per-patient AUC was 0.85, 0.90, and 0.92 (CT, DL-CT, and WB-MRI, respectively). DL-CT and WB-MRI had significantly higher AUC than CT (p = 0.04 and p = 0.03). DL-CT significantly increased sensitivity compared to CT (0.89 vs. 0.79, p = 0.04). WB-MRI had significantly higher specificity than CT (0.84 vs. 0.96, p = 0.001) and DL-CT (0.87 vs. 0.96, p = 0.02). CONCLUSIONS: DL-CT showed significantly higher per-lesion diagnostic performance and sensitivity than CT and WB-MRI. On a per-patient basis, DL-CT and WB-MRI had equal diagnostic performance superior to CT. KEY POINTS: • Spectral CT has higher diagnostic performance for diagnosing breast cancer metastases compared to conventional CT and whole-body MRI on a per-lesion basis. • Spectral CT and whole-body MRI are superior to conventional CT for diagnosing patients with metastatic breast cancer. • Whole-body MRI is superior to conventional CT and spectral CT for diagnosing bone metastases.","author_count":8,"contributors":["Buus, Thomas Winther","Rasmussen, Finn","Nellemann, Hanne Marie","Løgager, Vibeke","Jensen, Anders Bonde","Hauerslev, Katrine Rye","Christiansen, Peer","Pedersen, Erik Morre"],"cuid":["S02-100.00-021113"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Breast Neoplasms","Diffusion Magnetic Resonance Imaging","Neoplasm Staging","Tomography X Ray Computed","Whole Body Imaging"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-HO-CDR","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"comparison of contrast enhanced ct dual layer detector spectral ct and whole body mri in suspected metastatic breast cancer a prospective diagnostic accuracy study","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85106253372","version":"Other Version"},"id":"S02-100.00-021113","identifier":[{"id":"000651707200003","type":"wos"},{"id":"34008104","type":"pmid"},{"id":"85106253372","type":"scopus"}],"ids":["au-73700cb8-5d8c-45c5-ae2c-d9a2e4685291","ku-31b1c167-eeea-493a-84c3-5d488f4b0f57"],"keyword":["Breast neoplasms","Diffusion magnetic resonance imaging","Neoplasm staging","Tomography, X-ray computed","Whole-body imaging"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-09FF25850511EA8191D6F662560AA267"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Radiology"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Radiology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"Thomas Winther","key":"buuspau","last":"Buus","locid":"ba41fa4b-3c35-4101-9145-13bbd7c6f503","name":"Buus, Thomas Winther","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Finn","key":"rasmussenpau","last":"Rasmussen","locid":"1c4dadf5-d001-4c6c-9f23-347af298c53d","name":"Rasmussen, Finn","rank":2,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Hanne Marie","key":"nellemannpau","last":"Nellemann","locid":"925220b7-5fff-41a4-a8b9-14e53b19d742","name":"Nellemann, Hanne Marie","rank":3,"rolecode":"pau"},{"affno":"3","first":"Vibeke","key":"løgagerpau","last":"Løgager","locid":"7e61bd60-be88-4e20-a554-7bd6279a9922","name":"Løgager, Vibeke","rank":4,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Anders Bonde","key":"jensenpau","last":"Jensen","locid":"bc1410f2-b563-4741-8f04-b019a2562102","name":"Jensen, Anders Bonde","rank":5,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Katrine Rye","key":"hauerslevpau","last":"Hauerslev","locid":"41832c71-b206-4608-ad23-ff911729a5c7","name":"Hauerslev, Katrine Rye","rank":6,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Peer","key":"christiansenpau","last":"Christiansen","locid":"31f1ce54-ae25-4084-b4fc-798d3e0eb07d","name":"Christiansen, Peer","orcid":"0000-0003-2748-9240","rank":7,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Erik Morre","key":"pedersenpau","last":"Pedersen","locid":"397a353e-5325-4d03-b334-b0841f4e8daf","name":"Pedersen, Erik Morre","orcid":"0000-0001-6798-3644","rank":8,"rolecode":"pau"}],"pmid":["34008104"],"pub":{"doi":"10.1007/s00330-021-08041-2","issn":["09387994","14321084"],"issn_org":["09387994"],"issue":"12","journal":"European Radiology","pages":"8838-8849","publisher":"Springer","status":"p","title":"European Radiology","volume":"31"},"review":"Peer Reviewed","scoID":["2-s2.0-85106253372"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-73700cb8-5d8c-45c5-ae2c-d9a2e4685291","ku-31b1c167-eeea-493a-84c3-5d488f4b0f57"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Comparison of contrast-enhanced CT, dual-layer detector spectral CT, and whole-body MRI in suspected metastatic breast cancer: a prospective diagnostic accuracy study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-021113","year":"2021","yearsub":"2021"}
{"abstract":"Xia-Gibbs syndrome (XGS) is a neurodevelopmental disorder characterized by intellectual disability, developmental delay, seizures, hypotonia, obstructive sleep apnoea and mild facial dysmorphism. Heterozygosity for loss-of-function variants in AHDC1, encoding the AT-hook DNA binding motif containing protein 1, were discovered in 2014 as the likely genetic cause of Xia-Gibbs syndrome. We present five patients with Xia-Gibbs syndrome caused by previously unreported variants in AHDC1. Two of the patients share a frameshift variant: c.2849del (p.(Pro950Argfs*192)) in AHDC1. Despite sharing this variant, the two patients show remarkable phenotypic differences underscoring the clinical heterogeneity of Xia-Gibbs syndrome. In addition, we present a case of Xia-Gibbs syndrome caused by mosaicism for an AHDC1 variant.","author_count":26,"contributors":["Færgeman, Søren Lejsted","Bojesen, Anders","Rasmussen, Maria","Becher, Naja","Andreasen, Lotte","Andersen, Brian Nauheimer","Erbs, Emilie","Lildballe, Dorte L.","Nielsen, Jens Erik K.","Zilmer, Monica","Hammer, Trine Bjørg","Andersen, Mikkel","Brasch-Andersen, Charlotte","Fagerberg, Christina R.","Illum, Niels O.","Thorup, Mette Bendixen","Gregersen, Pernille A"],"cuid":["S03-100.00-014009"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"corresponding_author":["Faergeman, Soren L.","Færgeman, Søren Lejsted"],"keyword":["AHDC1","Dysmorphism","Reverse phenotyping","Whole exome sequencing","Xia gibbs syndrome"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-FILA","DI-HO-SDR","DI-HO-ZEA"],"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-FILA","DI-HO-SDR","DI-HO-ZEA","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"phenotypic heterogeneity and mosaicism in xia gibbs syndrome five danish patients with novel variants in ahdc000000000001","src":["au","ku","sdu"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85109430816","version":"Other Version"},"funding_acknowledgement":["We would like to thank the families for their participation in this study. The research project has not received any funding."],"id":"S03-100.00-014009","identifier":[{"id":"34229113","type":"pmid"},{"id":"000683558800013","type":"wos"},{"id":"85109430816","type":"scopus"}],"ids":["au-13a270cc-3718-4690-a558-995275d1ab84","ku-e8be25c8-a4fa-4f02-ba58-9da42bf29ab3","sdu-3079a8e4-54f3-4794-9118-690af5b3853a"],"keyword":["AHDC1","Dysmorphism","Reverse phenotyping","Whole exome sequencing","Xia-gibbs syndrome"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-D51C755AAEF560C73F5FB0B11D00C535"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department for Clinical Genetics"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU 