"ed287c2f-88ab-4d2f-8609-c89f2c2f7633","name":"Madsen, Jens","orcid":"0000-0002-6874-2970","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Volker","key":"naulinpau","last":"Naulin","locid":"68cb67c0-c64d-4fef-a301-67ab58d8ace6","name":"Naulin, Volker","orcid":"0000-0001-5452-9215","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anders Henry","key":"nielsenpau","last":"Nielsen","locid":"1d9aa958-9d84-4a3b-8300-f6fe9b0be73e","name":"Nielsen, Anders Henry","orcid":"0000-0003-3642-3905","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens Juul","key":"rasmussenpau","last":"Rasmussen","locid":"125b9658-f84c-4e0e-859e-5899413288ee","name":"Rasmussen, Jens Juul","orcid":"0000-0002-3543-690X","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-6aa369ad-2ee1-462b-a710-dcea5c887895"],"src":["DTU Technical University of Denmark"],"title":"How should we fuel future fusion power plants?","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-336412","year":"2016","yearsub":"2016"}
{"abstract":"The influence of electron and ion temperature dynamics on the radial convection of isolated structures in magnetically confined plasmas is investigated by means of numerical simulations. It is demonstrated that the maximum radial velocity of these plasma blobs roughly follows the inertial velocity scaling, which is proportional to the ion acoustic speed times the square root of the filament particle density times the sum of the electron and ion temperature perturbations. Only for small blobs the cross field convection does not follow this scaling. The influence of finite Larmor radius effects on the cross-field blob convection is shown not to depend strongly on the dynamical ion temperature field. The blob dynamics of constant finite and dynamical ion temperature blobs is similar. When the blob size is on the order of 10 times the ion Larmor radius the blobs stay coherent and decelerate slowly compared to larger blobs which dissipate faster due to fragmentation and turbulent mixing.","author_count":5,"contributors":["Olsen, Jeppe Miki Busk","Madsen, Jens","Nielsen, Anders Henry","Rasmussen, Jens Juul","Naulin, Volker"],"cuid":["S01-000.00-379337"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Blob dynamics","Scrape off layer transport"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"temperature dynamics and velocity scaling laws for interchange driven warm ion plasma filaments","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84961738587","version":"Other Version"},"id":"S01-000.00-379337","identifier":[{"id":"84961738587","type":"scopus"}],"ids":["dtu-f9d350c8-8e5e-4b96-9c8f-706d6a4478e9"],"keyword":["Blob dynamics","Scrape-off layer transport","Velocity scaling","Warm ions"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-E4A96E906F619951B245D4292809D778"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Physics","Technical University of Denmark, Department of Physics, Plasma Physics and Fusion Energy"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jeppe Miki Busk","key":"olsenpau","last":"Olsen","locid":"8cd18be3-5451-4463-8b96-a06469e1eca4","name":"Olsen, Jeppe Miki Busk","orcid":"0000-0002-4156-6671","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens","key":"madsenpau","last":"Madsen","locid":"ed287c2f-88ab-4d2f-8609-c89f2c2f7633","name":"Madsen, Jens","orcid":"0000-0002-6874-2970","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anders Henry","key":"nielsenpau","last":"Nielsen","locid":"1d9aa958-9d84-4a3b-8300-f6fe9b0be73e","name":"Nielsen, Anders Henry","orcid":"0000-0003-3642-3905","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens Juul","key":"rasmussenpau","last":"Rasmussen","locid":"125b9658-f84c-4e0e-859e-5899413288ee","name":"Rasmussen, Jens Juul","orcid":"0000-0002-3543-690X","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Volker","key":"naulinpau","last":"Naulin","locid":"68cb67c0-c64d-4fef-a301-67ab58d8ace6","name":"Naulin, Volker","orcid":"0000-0001-5452-9215","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1088/0741-3335/58/4/044011","issn":["07413335","13616587"],"issn_org":["07413335"],"issue":"4","journal":"Plasma Physics and Controlled Fusion","paperid":"044011","publisher":"IOP Publishing","status":"p","title":"Plasma Physics and Controlled Fusion","volume":"58"},"review":"Peer Reviewed","scoID":["2-s2.0-84961738587"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-f9d350c8-8e5e-4b96-9c8f-706d6a4478e9"],"src":["DTU Technical University of Denmark"],"title":"Temperature dynamics and velocity scaling laws for interchange driven, warm ion plasma filaments","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-379337","year":"2016","yearsub":"2016"}
