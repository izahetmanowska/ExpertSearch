{"author_count":3,"contributors":["Rasmussen, Anders Emil"],"cuid":["S01-000.00-157589"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"visible while away migration personhood and the movement of money amongst the mbuke of papua new guinea","src":["au"],"src-code":["DI-U-AU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84979987566","version":"Other Version"},"id":"S01-000.00-157589","identifier":[{"id":"84979987566","type":"scopus"}],"ids":["au-3167f6ef-51fd-45ba-acd0-90585de0700a"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-2-05101A2D295F2147F4BD252B7802251C"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, School of Culture and Society, School of Culture and Society - Department of Anthropology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Anders Emil","key":"rasmussenpau","last":"Rasmussen","locid":"29fd4913-24ba-4f16-a5e1-6c84d4a64c83","name":"Rasmussen, Anders Emil","rank":1,"rolecode":"pau"},{"affno":"","first":"Øivind","key":"fuglerudpedh","last":"Fuglerud","name":"Fuglerud, Øivind","rank":2,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Leon","key":"wainwrightpedh","last":"Wainwright","name":"Wainwright, Leon","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9781782385660"],"pages":"81-92","publisher":"Berghahn Books","status":"p","subtitle":"P