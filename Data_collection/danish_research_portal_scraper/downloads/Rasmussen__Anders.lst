nhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Peter B","key":"sørensenpau","last":"Sørensen","name":"Sørensen, Peter B","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christian F","key":"damgaardpau","last":"Damgaard","name":"Damgaard, Christian F","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Anders","key":"nielsenpau","last":"Nielsen","locid":"b954c930-484f-4d22-8431-f896942080ec","name":"Nielsen, Anders","orcid":"0000-0001-9683-9262","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hans","key":"thodsenpau","last":"Thodsen","name":"Thodsen, Hans","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik","key":"tornbjergpau","last":"Tornbjerg","name":"Tornbjerg, Henrik","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Lærke","key":"thorlingpau","last":"Thorling","name":"Thorling, Lærke","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Poul L.","key":"bjergpau","last":"Bjerg","locid":"c06e1108-55d2-4602-bac0-d7c020b40374","name":"Bjerg, Poul Løgstrup","name_org":"Bjerg, Poul L.","orcid":"0000-0002-1977-1871","rank":7,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"first":"Peter E","key":"holmpau","last":"Holm","name":"Holm, Peter E","rank":8,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Dorte","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Dorte","rank":9,"rolecode":"pau"}],"pub":{"isbn":["9788771569223"],"issn":["2244999X"],"issue":"329","pages":"50","publisher":"Aarhus Universitet, DCE - Nationalt Center for Miljø og Energi ©","publisher_org":"Aarhus Universitet, DCE – Nationalt Center for Miljø og Energi ©","repno":"Teknisk rapport fra DCE - Nationalt Center for Miljø og Energi. DCE Technical report, No. 329","series":"Teknisk rapport fra DCE - Nationalt Center for Miljø og Energi. DCE Technical report","status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All GTS Institutes","All Governmental Institutions","All Universities","DI-ALL","DI-GTS","DI-GTS-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","GTS Institutes","Governmental Institutions","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-8425a391-75cb-4496-9a88-8420f2f71d88"],"src":["DTU Technical University of Denmark"],"title":"Videreudvikling af model for miljøfarlige forurenende stoffer : Forbedring af statistik model og udvidelse af stofgruppe","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-817807","year":"2025","yearsub":"2025"}
{"abstract":"Background: Despite advances in pain management, inadequate pain relief and opioid-related adverse events remain common challenges in perioperative care, often contributing to prolonged recovery and reduced quality of life. The perioperative opioid algorithms for individualized dosing (OPIAID) project aims to develop machine-learning algorithms tailored to provide patient-specific opioid dosing across the different phases of perioperative care. For each phase, eight models are trained on granular data from 1.1 million surgical procedures, including demographic and surgical details, vital signs, administered analgesics, pain, and opioid-related adverse events. The two most accurate models will proceed to external validation. The best-performing model will subsequently be tested as a decision support against current standard of care. Objectives This protocol describes the design and external validation of the intraoperative OPIAID algorithm, which suggests the end-of-surgery opioid dose intended for postoperative analgesia by approximating clinical performance and evaluating reliability, agreement, and calibration. Methods: In this multicenter, TRIPOD+AI-adherent, prospective observational cohort study, we will collect data from a diverse surgical population of 656 adult patients undergoing elective or acute surgery under general anesthesia. All patients will require intraoperative opioid administration at the end of surgery for postoperative pain management and a subsequent stay in the post-anesthesia care unit. The cohort will be used to externally validate two machine-learning models through standardized measures of reliability, agreement, and calibration, and thereby designate the intraoperative OPIAID algorithm. Subsequently, the cohort will be used to approximate the clinical efficacy, safety and overall performance of the intraoperative OPIAID algorithm's recommended doses versus the clinician-administered doses. These comparisons will be based on each approach's proximity to a golden standard “optimal dose,” which is calculated based on a predefined generic ruleset incorporating intraoperative opioid dosing, postoperative pain, opioid-related adverse events, and need for rescue opioid administrations. Conclusion: The intraoperative OPIAID algorithm is intended as a clinical decision aid for anesthesiologists and nurse anesthetists in providing adequate postoperative pain management.","author_count":12,"contributors":["Karlsen, Anders Peder Højer","Sunde, Pernille Bjersand","Rasmussen, Ida Houtved","Folkersen, Caroline","Tran, Trang Xuan Minh","Nguyen, Markus Kien Trung","Elkær, Ine Maria","Lunn, Troels Haxhold","Meyhoff, Christian S.","Andersen, Jonas Valbjørn","Mathiesen, Ole","Olsen, Markus Harboe"],"cuid":["S01-000.00-818231"],"filters":{"added":"2025-08","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Opioids","Pain","Personalized medicine","Postoperative management","Surgery"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"OT":["Køge Sygehus - Sjællands Universitetshospital"],"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"external validation of an algorithm to guide opioid administration at the end of surgery protocol for an observational cohort study of the opiaid algorithm","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"doi","url":"https://doi.org/10.1111/aas.70071","version":"Published Version"},"id":"S01-000.00-818231","identifier":[{"id":"105008896957","type":"scopus"}],"ids":["itu-04dbe54c-f97b-4c5b-8450-d66b32441671"],"keyword":["Opioids","Pain","Personalized medicine","Postoperative management","Surgery"],"lang":"English","level":"Scientific","mra":["Science/Techn