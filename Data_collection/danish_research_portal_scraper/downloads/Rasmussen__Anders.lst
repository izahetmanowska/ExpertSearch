ame":"Uppsala University","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Sisse Anette","key":"thomassenpau","last":"Thomassen","locid":"73e2edc3-99c7-480b-830d-e5e7631b9179","name":"Thomassen, Sisse Anette","orcid":"0000-0003-0955-4600","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Benedict","key":"kjærgaardpau","last":"Kjærgaard","locid":"3afc0400-089d-4805-be84-ecdf45e6e318","name":"Kjærgaard, Benedict","orcid":"0000-0001-5797-7638","rank":2,"rolecode":"pau"},{"affno":"3 2","corresponding":null,"country":"dk","first":"Aage Kristian Olsen","key":"alstruppau","last":"Alstrup","locid":"fa66f5b8-0468-4e85-b570-969776c5ebde","name":"Alstrup, Aage Kristian Olsen","orcid":"0000-0002-0084-9122","rank":3,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"country":"dk","first":"Ole Lajord","key":"munkpau","last":"Munk","locid":"420e3a6e-40ef-462a-923a-d13976538a05","name":"Munk, Ole Lajord","orcid":"0000-0002-7232-5088","rank":4,"rolecode":"pau"},{"affno":"3 2","corresponding":null,"country":"dk","first":"Jørgen","key":"frøkiærpau","last":"Frøkiær","locid":"49d24192-9cad-4d32-88ee-cf46bb315b72","name":"Frøkiær, Jørgen","rank":5,"rolecode":"pau"},{"affno":"5 6","corresponding":null,"first":"Anders","key":"larssonpau","last":"Larsson","name":"Larsson, Anders","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Bodil Steen","key":"rasmussenpau","last":"Rasmussen","locid":"3162c449-94c3-4d28-8dbb-c134d6eb76e1","name":"Rasmussen, Bodil Steen","orcid":"0000-0003-2190-145X","rank":7,"rolecode":"pau"}],"pmid":["29380669"],"pub":{"doi":"10.1177/0267659118755271","issn":["02676591","1477111X"],"issn_org":["02676591"],"issue":"5","journal":"Perfusion","pages":"346-353","publisher":"SAGE Publications Ltd","status":"p","title":"Perfusion","volume":"33"},"review":"Peer Reviewed","scoID":["2-s2.0-85041922035"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["aau-ee8d4fc5-fa87-430a-8262-e39b37204c3e","au-01957053-353f-4cea-837d-4a974f5b4cc1"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Cerebral blood flow measured by positron emission tomography during normothermic cardiopulmonary bypass: An experimental porcine study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-096.05-011396","year":"2018","yearsub":"2018"}
{"abstract":"Denmark, a tuberculosis low burden country, still experiences significant active Mycobacterium tuberculosis (Mtb) transmission, especially with one specific genotype named Cluster 2/1112-15 (C2), the most prevalent lineage in Scandinavia. In addition to environmental factors, antibiotic resistance, and human genetics, there is increasing evidence that Mtb strain variation plays a role for the outcome of infection and disease. In this study, we explore the reasons for the success of the C2 genotype by analysing strain specific polymorphisms identified through whole genome sequencing of all C2 isolates identified in Denmark between 1992 and 2014 (n = 952), and the demographic distribution of C2. Of 234 non-synonymous (NS) monomorphic SNPs found in C2 in comparison with Mtb reference strain H37Rv, 23 were in genes previously reported to be involved in Mtb virulence. Of these 23 SNPs, three were specific for C2 including a NS mutation in a gene associated with hyper-virulence. We show that the genotype is readily transmitted to different ethnicities and is also found outside Denmark. Our data suggest that strain specific virulence factor variations are important for the success of the C2 genotype. These factors, likely in combination with poor TB control, seem to be the main drivers of C2 success.","author_count":6,"contributors":["Folkvardsen, Dorte Bek","Norman, Anders","Andersen, Åse Bengard","Rasmussen, Erik Michael","Lillebaek, Troels","Jelsbak, Lars"],"cuid":["S02-097.14-034540"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Folkvardsen, Dorte Bek"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-DTU","DI-U-SDU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-U-DTU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"a major i mycobacterium tuberculosis i outbreak caused by one specific genotype in a low incidence country exploring gene profile virulence explanations exploring gene profile virulence explanations","src":["dtu","sdu"],"src-code":["DI-U-DTU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41598-018-30363-3","version":"Published Version"},"id":"S02-097.14-034540","identifier":[{"id":"PMC6082827","type":"pmcid"},{"id":"30089859","type":"pmid"},{"id":"85051271211","type":"scopus"}],"ids":["dtu-565cb0d5-af03-484e-a9d5-b51edeb46663","sdu-b256a6f9-d63f-429a-92a7-b80485c7fd56"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-F1E595430B795EEBD94AEEBBB585E4BF"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/142372407/A_Major_Mycobacterium_tuberculosis_outbreak_caused_by_one_specific_genotype_in_a_low_incidence_country.pdf","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/152853055/s41598_018_30363_3.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41598-018-30363-3","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","country":"dk","key":"ssi statens serum institut","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-SSI","l3nn":"SSI Statens Serum Institut","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SSI Statens Serum Institut","namevar":["Statens Serum Institut"],"nora_code":"DI-GV-SSI","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Systems Biology","Technical University of Denmark, Department of Systems Biology, Infection Microbiology"],"nora_code":"DI-U-DTU","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Infectious Diseases (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"4","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Dorte Bek","key":"folkvardsenpau","last":"Folkvardsen","name":"Folkvardsen, Dorte Bek","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Anders","key":"normanpau","last":"Norman","locid":"01abb082-e735-40c1-ae3b-0cfac5bfe1f4","name":"Norman, Anders","orcid":"0000-0002-1282-394X","rank":2,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Åse Bengård","key":"andersenpau","last":"Andersen","locid":"a8872eef-ddea-4708-acdb-b238eaef934c","name":"Andersen, Åse Bengård","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Erik Michael","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Erik Michael","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Troels","key":"lillebaekpau","last":"Lillebaek","name":"Lillebaek, Troels","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Lars","key":"jelsbakpau","last":"Jelsbak","locid":"0f152051-d6ff-4b86-b98f-2ce118ee9ee1","name":"Jelsbak, Lars","orcid":"0000-0002-5759-9769","rank":6,"rolecode":"pau"}],"pmid":["30089859"],"pub":{"doi":"10.1038/s41598-018-30363-3","issn":["20452322"],"journal":"Scientific Reports","paperid":"11869","publisher":"Nature Publishing Group","status":"p","title":"Scientific Reports","volume":"8"},"review":"Peer Reviewed","scoID":["2-s2.0-85051271211"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Technical University of Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["dtu-565cb0d5-af03-484e-a9d5-b51edeb46663","sdu-b256a6f9-d63f-429a-92a7-b80485c7fd56"],"src":["DTU Technical University of Denmark","SDU University of Southern Denmark"],"title":"A Major <i>Mycobacterium tuberculosis</i> outbreak caused by one specific genotype in a low-incidence country: Exploring gene profile virulence explanations: Exploring gene profile virulence explanations","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-097.14-034540","year":"2018","yearsub":"2018"}
{"abstract":"PURPOSE: Cardiorespiratory fitness is positively related to heart failure (HF) prognosis, but lack of time and low energy are barriers for adherence to exercise. We, therefore, compared the effect of low-volume time-based resistance exercise training (TRE) with aerobic moderate-intensity cycling (AMC) on maximal and submaximal exercise capacity, health-related quality of life, and vascular function. METHODS: Twenty-eight HF patients (New York Heart Association class I-II) performed AMC (n = 14) or TRE (n = 14). Maximal and submaximal exercise capacity, health-related quality of life, and vascular function were evaluated before and after a 6-wk training intervention with 3 training sessions per week. The AMC group and the TRE group trained for 45 and 25 min per training session, respectively. During the training sessions, the TRE and AMC groups trained at 60 ± 4% and 59 ± 2% (mean ± standard deviation) of (Equation is included in full-text article.)O2peak, respectively. RESULTS: The energy expenditure was significantly greater in AMC than in TRE (P < .05). The (Equation is included in full-text article.)O2peak and Wattpeak increased in AMC group (P < .001) and TRE group (P = .001), with no differences between groups. Six-minute walk distance also increased in both groups (AMC, P = .006 and TRE, P = .036), with no difference between groups. Health-related quality of life improved equally in the 2 groups, whereas vascular function did not change in either group. CONCLUSION: These results demonstrate that AMC and TRE equally improved exercise capacity and health-related quality of life in lower New York Heart Association-stage HF patients, despite less time required as well as lower energy expenditure during TRE than during AMC. Therefore, TRE might represent a time-efficient exercise modality for improving adherence to exercise in patients with class I-II HF.","author_count":8,"contributors":["Munch, Gregers Winding","Rosenmeier, Jaya Birgitte","Petersen, Morten","Rinnov, Anders Rasmussen","Iepsen, Ulrik Winning","Pedersen, Bente Klarlund","Mortensen, Stefan Peter"],"cuid":["S02-097.79-040233"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Cardiac rehabilitation","Exercise capacity","Heart failure"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"comparative effectiveness of low volume time efficient resistance training versus endurance training in patients with heart failure","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/153085661/Open_Access.pdf","version":"Authors Final Version"},"id":"S02-097.79-040233","identifier":[{"id":"29351130","type":"pmid"},{"id":"85070363387","type":"scopus"}],"ids":["ku-1075454c-dc13-4aa4-b1f6-d699d0aadaa6","sdu-0df449bf-689f-42e8-a132-5bc73646ea1b"],"keyword":["Cardiac rehabilitation","exercise capacity","heart failure","resistance exercises","time-efficient exercise modality"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-4-3A9FE791B098DA441F4B57BDE356B6A7"],"oa_link":[{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/153085661/Open_Access.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Biology, Functional Genomics"],"nora_code":"DI-U-KU","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Molecular Medicine, Cardiovascular and Renal Research Unit"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Gregers Winding","key":"munchpau","last":"Munch","name":"Munch, Gregers Winding","rank":1,"rolecode":"pau"},{"affno":"","first":"Jaya Birgitte","key":"rosenmeierpau","last":"Rosenmeier","name":"Rosenmeier, Jaya Birgitte","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jaya","key":"birgitterosenmeierpau","last":"Birgitte Rosenmeier","name":"Birgitte Rosenmeier, Jaya","rank":2,"rolecode":"pau"},{"affno":"2 1","first":"Morten","key":"petersenpau","last":"Petersen","locid":"1972eb91-910c-432c-8661-bcc58c82b4df","name":"Petersen, Morten","orcid":"0000-0002-3035-5991","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders Rasmussen","key":"rinnovpau","last":"Rinnov","name":"Rinnov, Anders Rasmussen","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ulrik Winning","key":"iepsenpau","last":"Iepsen","name":"Iepsen, Ulrik Winning","rank":5,"rolecode":"pau"},{"affno":"2 1","first":"Bente Klarlund","key":"pedersenpau","last":"Pedersen","locid":"5d38d54e-e0d1-4397-98ca-6d8c9b78606d","name":"Pedersen, Bente Klarlund","rank":6,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"first":"Stefan Peter","key":"mortensenpau","last":"Mortensen","locid":"bf24e40c-62a2-43d7-bc5c-920733c20083","name":"Mortensen, Stefan","name_org":"Mortensen, Stefan Peter","orcid":"0000-0001-8958-1048","rank":7,"rolecode":"pau"}],"pmid":["29351130"],"pub":{"doi":"10.1097/hcr.0000000000000304","issn":["19327501","1932751X"],"issn_org":["19327501"],"issue":"3","journal":"Journal of Cardiopulmonary Rehabilitation and Prevention","pages":"175-181","publisher":"Lippincott Williams and Wilkins Ltd.","status":"p","title":"Journal of Cardiopulmonary Rehabilitation and Prevention","volume":"38"},"review":"Peer Reviewed","scoID":["2-s2.0-85070363387"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-1075454c-dc13-4aa4-b1f6-d699d0aadaa6","sdu-0df449bf-689f-42e8-a132-5bc73646ea1b"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Comparative Effectiveness of Low-Volume Time-Efficient Resistance Training Versus Endurance Training in Patients With Heart Failure","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-097.79-040233","year":"2018","yearsub":"2018"}
{"abstract":"Hepatitis B virus (HBV) is a major cause of human hepatitis. There is considerable uncertainty about the timescale of its evolution and its association with humans. Here we present 12 full or partial ancient HBV genomes that are between approximately 0.8 and 4.5 thousand years old. The ancient sequences group either within or in a sister relationship with extant human or other ape HBV clades. Generally, the genome properties follow those of modern HBV. The root of the HBV tree is projected to between 8.6 and 20.9 thousand years ago, and we estimate a substitution rate of 8.04 × 10-6-1.51 × 10-5 nucleotide substitutions per site per year. In several cases, the geographical locations of the ancient genotypes do not match present-day distributions. Genotypes that today are typical of Africa and Asia, and a subgenotype from India, are shown to have an early Eurasian presence. The geographical and temporal patterns that we observe in ancient and modern HBV genotypes are compatible with well-documented human migrations during the Bronze and Iron Ages1,2. We provide evidence for the creation of HBV genotype A via recombination, and for a long-term association of modern HBV genotypes with humans, including the discovery of a human genotype that is now extinct. These data expose a complexity of HBV evolution that is not evident when considering modern sequences alone.","author_count":35,"contributors":["Mühlemann, Barbara","Jones, Terry C.","Damgaard, Peter de Barros","Allentoft, Morten E.","Shevnina, Irina","Logvin, Andrey","Usmanova, Emma","Panyushkina, Irina P.","Boldgiv, Bazartseren","Bazartseren, Tsevel","Tashbaeva, Kadicha","Merz, Victor","Lau, Nina","Smrčka, Václav","Voyakin, Dmitry","Kitov, Egor","Epimakhov, Andrey","Pokutta, Dalia","Vicze, Magdolna","Price, T. Douglas","Moiseyev, Vyacheslav","Hansen, Anders J.","Orlando, Ludovic","Rasmussen, Simon","Sikora, Martin","Vinner, Lasse","Osterhaus, Albert D. M. E.","Smith, Derek J.","Glebe, Dieter","Fouchier, Ron A. M.","Drosten, Christian","Sjögren, Karl-Göran","Kristiansen, Kristian","Willerslev, Eske"],"cuid":["S02-099.20-037867"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","Asia, Central","Europe, EU","Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Willerslev, Eske"],"country":["Czechia","France","Germany","Hungary","Kazakhstan","Kyrgyzstan","Mongolia","Netherlands","Russia","Sweden","United Kingdom","United States"],"glorg":["All Global Affiliations","Baitursynov Kostanay Regional University","Buketov Karaganda State University","Centre for Baltic and Scandinavian Archaeology","Charité – Universitätsmedizin Berlin","Charles University","Erasmus University Medical Center","Erasmus University Rotterdam","German Center for Infection Research (DZIF)","Institute of Archaeology of the Academy of Sciences of Kazakhstan","Justus Liebig University Giessen","Kostanay State University","Kyrgyz National Academy of Sciences","Margulan Institute of Archaeology","Matrica Museum","Mongolian University of Life Sciences","National University of Mongolia","Peter the Great Museum of Anthropology and Ethnography","Russian Academy of Sciences","S. Toraighyrov Pavlodar State University","South Ural State University","Stockholm University","University of Arizona","University of Cambridge","University of Gothenburg","University of Veterinary Medicine Hannover, Foundation","Université Paul Sabatier Toulouse III","Wellcome Sanger Institute"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"ancient hepatitis b viruses from the bronze age to the medieval period","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url