Jeppe Møller","rank":6,"rolecode":"pau"},{"affno":"2 5","corresponding":null,"country":"dk","first":"Anja","key":"holmpau","last":"Holm","locid":"13eb6f8c-f573-411d-ac00-815f30165b09","name":"Holm, Anja","rank":7,"rolecode":"pau"},{"affno":"2","first":"Sabrina Prehn","key":"lauritzenpau","last":"Lauritzen","name":"Lauritzen, Sabrina Prehn","rank":8,"rolecode":"pau"},{"affno":"6","first":"Glenn","key":"dorsampau","last":"Dorsam","name":"Dorsam, Glenn","rank":9,"rolecode":"pau"},{"affno":"1 2","first":"Jens","key":"hannibalpau","last":"Hannibal","locid":"b2810b1e-a8c8-41cb-bb4f-669ad1ff6b65","name":"Hannibal, Jens","rank":10,"rolecode":"pau"},{"affno":"2","first":"Birgitte","key":"georgpau","last":"Georg","name":"Georg, Birgitte","rank":11,"rolecode":"pau"},{"affno":"2 7","country":"dk","first":"David Møbjerg","key":"kristensenpau","last":"Kristensen","locid":"974319d1-cbac-46f5-b3f3-9801a48206c9","name":"Kristensen, David Møbjerg","rank":12,"rolecode":"pau"},{"affno":"2","first":"Jes","key":"olesenpau","last":"Olesen","name":"Olesen, Jes","rank":13,"rolecode":"pau"},{"affno":"2 8 9 10","first":"Sarah Louise","key":"christensenpau","last":"Christensen","name":"Christensen, Sarah Louise","rank":14,"rolecode":"pau"}],"pmid":["39085771"],"pub":{"doi":"10.1186/s10194-024-01830-2","issn":["11292369","11292377"],"issn_org":["11292369"],"issue":"1","journal":"Journal of Headache and Pain","paperid":"126","publisher":"Springer","status":"p","title":"Journal of Headache and Pain","title_org":"The Journal of Headache and Pain","volume":"25"},"review":"Peer Reviewed","scoID":["2-s2.0-85200292010"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Non-Profit Organisations","All Private Research","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-NP","DI-NP-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Hospitals","Lundbeck Pharma","Non-Profit Organisations","Private Research","Roskilde University","Universities","Univer