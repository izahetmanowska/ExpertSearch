96","rank":3,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Niels-Henrik","key":"vonholsteinrathloupau","last":"von Holstein-Rathlou","locid":"6476af94-cb91-43db-bc71-5f81cd3d5827","name":"von Holstein-Rathlou, Niels-Henrik","rank":4,"rolecode":"pau"},{"affno":"1","first":"Anders Holm","key":"rasmussenpau","last":"Rasmussen","locid":"0382398f-ba6a-4367-a3e8-a54da1aa6fd8","name":"Rasmussen, Anders Holm","rank":5,"rolecode":"pau"},{"affno":"1","first":"Christian","key":"schultzpau","last":"Schultz","locid":"27c6a06f-1322-4c24-80d8-33bbe71b255c","name":"Schultz, Christian","orcid":"0000-0003-1972-9929","rank":6,"rolecode":"pau"}],"pub":{"pages":"55","place":"København","publisher":"Københavns Universitet","status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-9ba6510f-9c42-4f9c-a09d-2d2c3c65f1c3"],"src":["KU University of Copenhagen"],"title":"Stakeholderbogen : En værktøjskasse for mapping og prioritering af centrale stakeholdere","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-486500","year":"2013","yearsub":"2013"}
{"abstract":"A broad forensic screening method for 256 analytes in whole blood based on a fully automated SPE robotic extraction and UHPLC-TOF-MS with data-independent acquisition has been developed. The limit of identification was evaluated for all 256 compounds and 95 of these compounds were validated with regard to matrix effects, extraction recovery, and process efficiency. The limit of identification ranged from 0.001 to 0.1 mg/kg, and the process efficiency exceeded 50% for 73 of the 95 analytes. As an example of application, 1335 forensic traffic cases were analyzed with the presented screening method. Of these, 992 cases (74%) were positive for one or more traffic relevant drugs above the Danish legal limits. Commonly abused drugs such as amphetamine, cocaine, and frequent types of benzodiazepines were the major findings. Nineteen less frequently encountered drugs were detected e.g., buprenorphine, butylone, cathine, fentanyl, LSD, mCPP, MDPV, mephedrone, 4-methylamphetamine, p-fluoroamphetamine, and PMMA. In conclusion, using UHPLC-TOF-MS screening with data-independent acquisition resulted in detection of common drugs of abuse as well as new designer-drugs and more rarely occurring drugs. Thus, TOF-MS screening of blood samples constitutes a practical way for screening traffic cases, with the exception of THC, which should be handled in a separate method. This article is protected by copyright. All rights reserved.","author_count":7,"contributors":["Pedersen, Anders Just","Dalsgaard, Petur Weihe","Rode, Andrej Jaroslav","Rasmussen, Brian Schou","Müller, Irene Breum","Johansen, Sys Stybe","Linnet, Kristian"],"cuid":["S01-000.00-496153"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"screening for illicit and medicinal drugs in whole blood using fully automated spe and uhplc tof ms with data independent acquisition","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-496153","identifier":[{"id":"84879667267","type":"scopus"},{"id":"23610028","type":"pmid"}],"ids":["ku-abf79f66-e937-434a-8efb-de43e9adaa31"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-F720684592A6A72DABE0AD1EE9C8045D"],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Forensic Medicine, Section of Forensic Chemistry"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Anders Just","key":"pedersenpau","last":"Pedersen","locid":"24f67ff0-1083-435c-9646-117dbf7eb89f","name":"Pedersen, Anders Just","rank":1,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Petur Weihe","key":"dalsgaardpau","last":"Dalsgaard","locid":"592bf666-0119-448f-bac2-d5726fb6ce21","name":"Dalsgaard, Petur Weihe","orcid":"0000-0002-8967-7477","rank":2,"rolecode":"pau"},{"affno":"1","first":"Andrej Jaroslav","key":"rodepau","last":"Rode","locid":"168901ec-6b3f-46b7-8e63-4f142de20f31","name":"Rode, Andrej Jaroslav","rank":3,"rolecode":"pau"},{"affno":"1","first":"Brian Schou","key":"rasmussenpau","last":"Rasmussen","locid":"64c8b3ca-ead6-4128-9072-7aa9bce9dae5","name":"Rasmussen, Brian Schou","rank":4,"rolecode":"pau"},{"affno":"1","first":"Irene Breum","key":"müllerpau","last":"Müller","locid":"44362e95-ccee-4dc7-9616-19d8ecda5a5c","name":"Müller, Irene Breum","rank":5,"rolecode":"pau"},{"affno":"1","first":"Sys Stybe","key":"johansenpau","last":"Johansen","locid":"4b759c18-fd10-41b0-989c-6f675a5d2643","name":"Johansen, Sys Stybe","orcid":"0000-0002-9555-5134","rank":6,"rolecode":"pau"},{"affno":"1","first":"Kristian","key":"linnetpau","last":"Linnet","locid":"88096aa7-7872-42e2-8ef1-5340a46080d7","name":"Linnet, Kristian","orcid":"0000-0001-6974-5535","rank":7,"rolecode":"pau"}],"pmid":["23610028"],"pub":{"doi":"10.1002/jssc.201200921","issn":["16159306","16159314"],"issn_org":["16159306"],"issue":"13","journal":"Journal of Separation Science","pages":"2081-2089","status":"p","title":"Journal of Separation Science","volume":"36"},"review":"Peer Reviewed","scoID":["2-s2.0-84879667267"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-abf79f66-e937-434a-8efb-de43e9adaa31"],"src":["KU University of Copenhagen"],"title":"Screening for illicit and medicinal drugs in whole blood using fully automated SPE and UHPLC-TOF-MS with data-independent acquisition","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-496153","year":"2013","yearsub":"2013"}
