Nørregaard","name_org":"Kjær, Maj-Brit Nørregaard","rank":17,"rolecode":"pau"},{"affno":"4","first":"Aksel Karl Georg","key":"jensenakselkarlgeorgpau","last":"Jensen","locid":"b0add8ae-69a3-472b-ab21-e2a53d1f4315","name":"Jensen, Aksel Karl Georg","orcid":"0000-0002-1459-0465","rank":18,"rolecode":"pau"},{"affno":"4","first":"Theis","key":"langetheispau","last":"Lange","locid":"e4664578-01fc-4a93-8efd-1dbffb72cdd6","name":"Lange, Theis","orcid":"0000-0001-6807-8347","rank":19,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jørn","key":"wetterslevjørnpau","last":"Wetterslev","name":"Wetterslev, Jørn","rank":20,"rolecode":"pau"},{"affno":"4 2 6","first":"Anders","key":"perneranderspau","last":"Perner","locid":"8a389541-d529-4ee3-8364-66bfc85f77c9","name":"Perner, Anders","rank":21,"rolecode":"pau"},{"affno":"1 2 3","corresponding":null,"first":"Olav Lilleholt","key":"schjørringolavlilleholtpau","last":"Schjørring","locid":"7dac619e-9b5c-46ac-9170-10ac13165da5","name":"Schjørring, Olav Lilleholt","rank":22,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Bodil Steen","key":"rasmussenbodilsteenpau","last":"Rasmussen","locid":"3162c449-94c3-4d28-8dbb-c134d6eb76e1","name":"Rasmussen, Bodil Steen","orcid":"0000-0003-2190-145X","rank":23,"rolecode":"pau"}],"pmid":["35441849"],"pub":{"doi":"10.1007/s00134-022-06695-0","issn":["03424642","09351701"],"issn_org":["03424642"],"issue":"6","journal":"Intensive Care Medicine","pages":"714-722","publisher":"Springer","status":"p","title":"Intensive Care Medicine","volume":"48"},"review":"Peer Reviewed","scoID":["2-s2.0-85128459024"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Other Hospitals","Region Zealand","Universities","University of Copenhagen","collaboration for research in intensive care"],"PST":["Published"]},"sid":["aau-8dfd4b31-4fb1-470c-a612-de2000b459ae","ku-c2d05113-5e70-4289-a0b9-2be17b215190"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"Long-term mortality and health-related quality of life of lower versus higher oxygenation targets in ICU patients with severe hypoxaemia","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-088.24-006883","year":"2022","yearsub":"2022"}
{"abstract":"Objective Although clinical guidelines exist, the diagnostic work-up for diagnosing inflammatory bowel disease (IBD) is complex and varies in clinical practice. This study used real-life data to characterise the current diagnostic procedures used to establish IBD diagnoses in a Danish nationwide setting. Design Person-level data on patients diagnosed with IBD between 1 January 2014 and 30 June 2018 were linked between Danish health registers. Information on age, sex, registration of other gastrointestinal diseases, and diagnostic procedures (endoscopies, biopsies, and imaging) performed in relation to the first IBD hospital admission was analysed for the total study population and was stratified by IBD type, sex, and age. Results The majority of the 12 871 patients with IBD included underwent endoscopy (84%), had a biopsy taken (84%), and/or underwent imaging procedures (44%). In total, 7.5% of the population (6% for Crohn's disease and 8% for ulcerative colitis) were diagnosed with IBD despite not undergoing any of these diagnostic procedures. Patients with Crohn's disease underwent more procedures than patients with ulcerative colitis (94% vs 92%, p<0.001). Children underwent slightly fewer diagnostic procedures than adults (92% vs 93%, p=0.004). Slightly more men underwent at least one procedure than women (92% vs 94%, p<0.001). Conclusion For 7.5% of patients with IBD, this study did not detect any registrations of the recommended diagnostic procedures for establishing an IBD diagnosis. Further research is needed to examine whether these findings are mainly explained by limitations of the register data or also indicate shortcomings of the general approach to IBD.","author_count":9,"contributors":["Rasmussen, Nathalie Fogh","Green, Anders","Allin, Kristine H.","Iversen, Aske T.","Madsen, Gunvor Iben","Pedersen, Andreas Kristian","Wolff, Donna Lykke","Jess, Tine","Andersen, Vibeke"],"cuid":["S02-099.94-010111"],"filters":{"added":"2022-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Rasmussen, Nathalie Fogh"],"keyword":["Adult","Child","Chronic Disease","Colitis Ulcerative","Crohn Disease","Crohn s disease","Denmark","Endoscopy","Endoscopy Gastrointestinal","Female","Humans","Imaging","Inflammatory Bowel Diseases","Inflammatory bowel disease","Male","Ulcerative colitis"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-SDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-SDR","DI-U-AAU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"clinical procedures used to diagnose inflammatory bowel disease real world evidence from a danish nationwide population based study","src":["aau","sdu"],"src-code":["DI-U-AAU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/bmjgast-2022-000958","version":"Published Version"},"id":"S02-099.94-010111","identifier":[{"id":"36028261","type":"pmid"},{"id":"85137919562","type":"scopus"},{"id":"PMC9422868","type":"pmcid"}],"ids":["aau-d31d7ee5-ec5f-44f2-9d08-46351ca4b9c8","sdu-21cf6eb5-1d8f-46ab-bf31-0f89a540e66e"],"keyword":["Adult","CROHN'S DISEASE","Child","Chronic Disease","Colitis, Ulcerative","Crohn Disease","Denmark","ENDOSCOPY","Endoscopy, Gastrointestinal","Female","Humans","IMAGING","INFLAMMATORY BOWEL DISEASE","Inflammatory Bowel Diseases","Male","ULCERATIVE COLITIS"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-65C144D82C741CB47EF477F1A610C981"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/206589547/Open_Access_Version.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/484176550/Fogh_Rasmussen_2022_Clinical_procedures_us