ark","namevar":["Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Bodil Steen","key":"rasmussenpau","last":"Rasmussen","locid":"3162c449-94c3-4d28-8dbb-c134d6eb76e1","name":"Rasmussen, Bodil Steen","orcid":"0000-0003-2190-145X","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Anders","key":"pernerpau","last":"Perner","name":"Perner, Anders","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jørn","key":"wetterslevpau","last":"Wetterslev","name":"Wetterslev, Jørn","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Christian S.","key":"meyhoffpau","last":"Meyhoff","name":"Meyhoff, Christian S.","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Olav L.","key":"schjørringpau","last":"Schjørring","locid":"7dac619e-9b5c-46ac-9170-10ac13165da5","name":"Schjørring, Olav Lilleholt","name_org":"Schjørring, Olav L.","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1016/s0140-6736(18)32201-3","issn":["00995355","01406736"],"issn_org":["01406736"],"issue":"10163","journal":"The Lancet","pages":"2436-2437","publisher":"Elsevier","status":"p","title":"The Lancet","title_org":"Lancet","volume":"392"},"review":"Peer Reviewed","scoID":["2-s2.0-85057606517"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities"],"PST":["Published"]},"sid":["aau-d7c3da64-deea-47c7-b2a2-c68c7a24dd09"],"src":["AAU Aalborg University"],"title":"Oxygenation targets in acutely ill patients : still a matter of debate","type":"Journal Comment","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-112738","year":"2018","yearsub":"2018"}
{"abstract":"Greenland covers < 2 million km 2 and, being completely surrounded by water, is the largest island in the world. The seas around Greenland cover an area from the High Arctic in the north to the Subarctic in the south and include the three Large Marine Ecosystems (LME) developed by the US National Oceanic and Atmospheric Administration (NOAA). The water masses are dominated by inflow of cold, nutrient-rich water from the Polar region through the Fram Strait in the east and the Nares Strait and the Canadian Archipelago in west, and by inflow of relatively warm and salty water from the North Atlantic. The Greenland shelf is wide in the southwest and here the combination of fronts of the cold and warm waters creates a very productive ecosystem. Only around 56,000 people live in Greenland, mainly in the central and southern part of West Greenland. There is a long tradition of fishing and hunting, and the commercial fishery is today by far the most important export industry. Two species-Greenland halibut and northern shrimp-form the basis for this industry, while several other species are utilized on a subsistence basis. Marine mammals and seabirds are also utilized for local marketing and on a subsistence basis. Other uses of the marine environment include oil exploration, but so far no discoveries have been made. Contaminant levels of, for example, persistent organic pollutants (POP) in the Greenland marine ecosystem are relatively low compared to more southern latitudes. However, relatively high concentrations are found of some contaminants in the higher trophic levels as a result of biomagnification in the food web. These compounds are of concern because, in some areas, marine mammals and seabirds constitute a significant part of the human diet. However, the threat of contaminants must be weighed against the health benefits of the consumption of traditional food. Climate change in the Arctic has been and will continue to be a main driver of future changes in the Greenland ecosystems, and these changes include increasing water temperatures, decreasing sea-ice coverage, and increasing freshwater discharge to the sea. An example of effects of such changes is the emergence of mackerel in the waters off Southeast Greenland. Another example is the retreat of species that depend on the sea-ice habitat for example, polar bears. Decreasing sea-ice coverage will influence future shipping activities and likely also oil exploration activities, which both increase the risk of causing negative impacts on the environment from increased emissions and oil accidents.","author_count":11,"contributors":["Riget, Frank Farsø","Mosbech, Anders","Boertmann, David","Wegeberg, Susse","Merkel, Flemming Ravn","Aastrup, Peter","Christensen, Tom","Ugarte, Fernando","Berg Hedeholm, Rasmus","Fritt-Rasmussen, Janne"],"cuid":["S01-000.00-197762"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Nordic"],"country":["Greenland"],"glorg":["All Global Affiliations","Greenland Institute of Natural Resources"],"keyword":["Currents","Fishing","Greenland","Industry","Mining","Pollutants","Protected areas"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"the seas around greenland an environmental status and future perspective","src":["au"],"src-code":["DI-U-AU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85081529755","version":"Other Version"},"id":"S01-000.00-197762","identifier":[{"id":"85081529755","type":"scopus"}],"ids":["au-77a327c4-0d7d-48c0-ab51-1b96445da02c"],"keyword":["Currents","Fishing","Greenland","Industry","Mining","Pollutants","Protected areas"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-0300596304F44AAE5D222B1C76FB1EA3"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Arctic Research Centre, Arctic Research Centre - Arctic Research Centre, Roskilde","Aarhus University, Technical Sciences, Department of Ecoscience, Department of Ecoscience - Marine Mammal Research 1"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"gl","key":"greenland institute of natural resources","loc":["Greenland","Nordic"],"name":"Greenland Institute of Natural Resources","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Frank Farsø","key":"rigetpau","last":"Riget","locid":"17f6c904-057a-4571-86e8-956d9927ca1b","name":"Riget, Frank Farsø","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anders","key":"mosbechpau","last":"Mosbech","locid":"0d8b3009-ff00-40a7-b738-abfa87e31ccf","name":"Mosbech, Anders","orcid":"0000-0002-7581-7037","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"David","key":"boertmannpau","last":"Boertmann","locid":"3fd0130d-e557-4b1b-af39-8a3f236852ed","name":"Boertmann, David","orcid":"0000-0002-5620-7356","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Susse","key":"wegebergpau","last":"Wegeberg","locid":"05370847-e1d3-4253-b818-046251260ff5","name":"Wegeberg, Susse","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Flemming Ravn","key":"merkelpau","last":"Merkel","locid":"7ebb69f4-00b0-438d-ae73-5305d25780ec","name":"Merkel, Flemming Ravn","orcid":"0000-0003-3779-8012","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter","key":"aastruppau","last":"Aastrup","locid":"50a88b32-1dc2-47e8-9113-fd98ae9ff05d","name":"Aastrup, Peter","orcid":"0000-0003-4258-3358","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Tom","key":"christensenpau","last":"Christensen","locid":"c2b982ca-b8de-47c1-b339-145ce573ef02","name":"Christensen, Tom","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Fernando","key":"ugartepau","last":"Ugarte","name":"Ugarte, Fernando","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Rasmus","key":"berghedeholmpau","last":"Berg Hedeholm","name":"Berg Hedeholm, Rasmus","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Janne","key":"frittrasmussenpau","last":"Fritt-Rasmussen","locid":"ee0f4272-d879-4350-9617-affc0cc83535","name":"Fritt-Rasmussen, Janne","orcid":"0000-0002-6496-8032","rank":10,"rolecode":"pau"},{"affno":"","first":"Charles","key":"sheppardpedh","last":"Sheppard","name":"Sheppard, Charles","rank":11,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"edition":"2","eisbn":["9780128050682"],"isbn":["9780128050682"],"pages":"45-68","publisher":"Academic Press","series":"World Seas: An Environmental Evaluation","status":"p","subtitle":"An Environmental Evaluation Volume I: Europe, the Americas and West Africa","title":"World Seas","volume":"1"},"review":"Peer Reviewed","scoID":["2-s2.0-85081529755"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-77a327c4-0d7d-48c0-ab51-1b96445da02c"],"src":["AU Aarhus University"],"title":"The Seas around Greenland: An Environmental Status and Future Perspective","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-197762","year":"2018","yearsub":"2018"}
{"abstract":"T helper 17 (Th17) cells produce interleukin (IL) 17-A. In addition, Th17 cells produce IL-21 and IL-22. Th17 cells have a disease-promoting role in Crohn's disease (CD). We investigated the effects of anti-TNFα treatment on mucosal gene expression (qPCR) of IL-17A, IL-21, and IL-22 as well as on the frequency of lamina propria (LP) T cell subsets producing these cytokines (flow cytometry) in 12 active CD patients before and after 4 weeks of anti-TNFα treatment with adalimumab. At baseline, in inflamed mucosa we found increased gene expression of IL-17A and IL-22 but not IL-21 when compared to noninflamed mucosa. There were increased frequencies of IL-21-producing LP T cells but no differences in the frequencies of IL-17A- or IL-22-producing LP T cells when comparing inflamed versus noninflamed mucosa at baseline. There were no changes in the mucosal gene expression of IL-17A, IL-21, and IL-22 or the frequencies of IL-17A-, IL-21- and IL-22-producing LP T cell subsets between baseline and following 4 weeks of adalimumab initiation. Our results do not support the hypothesis that anti-TNFα treatment has an early effect on the mucosal levels of IL-17A, IL-21, and IL-22 or LP T cell production of these cytokines in CD.","author_count":8,"contributors":["Dige, Anders","Magnusson, Maria K","Uhrenholt, Claus","Rasmussen, Tue Kruse","Kragstrup, Tue Wenzel","Öhman, Lena","Dahlerup, Jens Frederik","Agnholt, Jørgen"],"cuid":["S01-000.00-220921"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Sweden"],"glorg":["All Global Affiliations","University of Gothenburg"],"keyword":["Activity index","Apoptosis","Gene expression","Inflammatory bowel disease","Infliximab","Interleukin 21","Lymphocytes","Macrophages","Th17 cells"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"effects of anti tnfα treatment on mucosal expression of il 000000000017a il 000000000021 and il 000000000022 and cytokine producing t cell subsets in crohn s disease","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85054054361","version":"Other Version"},"id":"S01-000.00-220921","identifier":[{"id":"PMC5944277","type":"pmcid"},{"id":"000431591400001","type":"wos"},{"id":"29853788","type":"pmid"},{"id":"85054054361","type":"scopus"}],"ids":["au-a0baf277-0afa-45f5-9d04-9b29fd4ca7b8"],"keyword":["ACTIVITY INDEX","APOPTOSIS","GENE-EXPRESSION","IMMUNOPATHOGENESIS","INFLAMMATORY-BOWEL-DISEASE","INFLIXIMAB","INTERLEUKIN-21","LYMPHOCYTES","MACROPHAGES","TH17 CELLS"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-8F754B654D362FFA49FE5F83D864032B"],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Hepatology and Gastroenterology"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"se","key":"university of gothenburg","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"University of Gothenburg","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Anders","key":"digepau","last":"Dige","locid":"c5b7ed9d-4c85-4d70-b215-6b023bdc20f5","name":"Dige, Anders","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Maria K","key":"magnussonpau","last":"Magnusson","name":"Magnusson, Maria K","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Claus","key":"uhrenholtpau","last":"Uhrenholt","name":"Uhrenholt, Claus","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Tue Kruse","key":"rasmussenpau","last":"Rasmussen","locid":"0b1018e8-2ad6-4f8d-8413-5c10a8db586d","name":"Rasmussen, Tue Kruse","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Tue","key":"kragstruppau","last":"Kragstrup","locid":"e1e2fde6-99ce-4d01-b3d4-5c8160d80136","name":"Kragstrup, Tue Wenzel","name_org":"Kragstrup, Tue","orcid":"0000-0002-6439-397X","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lena","key":"öhmanpau","last":"Öhman","name":"Öhman, Lena","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens","key":"dahleruppau","last":"Dahlerup","locid":"0f52b503-fe76-4e51-939a-7a24f226f420","name":"Dahlerup, Jens Frederik","name_org":"Dahlerup, Jens","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jørgen","key":"agnholtpau","last":"Agnholt","locid":"66d6b88f-b5c0-4c2e-b073-056cd18dc1ea","name":"Agnholt, Jørgen","orcid":"0009-0006-4776-0121","rank":8,"rolecode":"pau"}],"pmid":["29853788"],"pub":{"doi":"10.1155/2018/3279607","issn":["09629351","14661861"],"issn_org":["09629351"],"journal":"Mediators of Inflammation","pages":"3279607","paperid":"3279607","publisher":"John Wiley and Sons Ltd","status":"p","title":"Mediators of Inflammation","volume":"2018"},"review":"Peer Reviewed","scoID":["2-s2.0-85054054361"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-a0baf277-0afa-45f5-9d04-9b29fd4ca7b8"],"src":["AU Aarhus University"],"title":"Effects of Anti-TNFα Treatment on Mucosal Expression of IL-17A, IL-21, and IL-22 and Cytokine-Producing T Cell Subsets in Crohn's Disease","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-220921","year":"2018","yearsub":"2018"}
{"abstract":"Methods for quantifying methane (CH4) emissions from biogas plants are needed, in order to ensure that emissions are within acceptable levels and to identify options for emission mitigation. Two emission measuring approaches were used at four biogas plants: an on-site approach, whereby emission sources were identified and subsequently quantified one at a time, and a ground-based remote sensing approach, which was applied to measure total CH4 emissions. The emissions were between 5.5 to 13.5 kg CH4 h-1 from the four plants, measured using ground-based remote sensing. Even though the measurements were performed on the same days at each facility, the sum of on-site emission rates varied between the remote sensing measurements (up to ∼100%). Several factors may have caused this difference: emission sources not measured using an on-site approach and short-time emission variation. On-site measurements showed that the majority of the emissions often occurred from just a few sources","author_count":5,"contributors":["Fredenslund, Anders Michael","Hinge, Jørgen","Holmgren, Magnus A.","Rasmussen, Søren G.","Scheutz, Charlotte"],"cuid":["S01-000.00-362832"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"corresponding_author":["Fredenslund, Anders Michael"],"country":["Sweden"],"glorg":["All Global Affiliations","RISE Research Institutes of Sweden"],"keyword":["Anaerobic digestion","Fugitive emissions","Method comparison"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GTS","DI-U"],"level3":{"GTS":["DI-GTS-ALL","DI-GTS-DTCI"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-GTS-DTCI","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"on site and ground based remote sensing measurements of methane emissions from four biogas plants a comparison study","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/152315954/1_s2.0_S0960852418311842_main.pdf","version":"Authors Final Version"},"id":"S01-000.00-362832","identifier":[{"id":"30212778","type":"pmid"},{"id":"85053059153","type":"scopus"}],"ids":["dtu-c2d01667-7ce1-461a-a373-ba89c648e87c"],"keyword":["Anaerobic digestion","Fugitive emissions","Method comparison","Tracer gas dspersion method"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-3FF45B471EFC89C0350216624CEEDA0A"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/152315954/1_s2.0_S0960852418311842_main.pdf","version":"Authors Final Version"}],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Environmental Engineering","Technical University of Denmark, Department of Environmental Engineering, Air, Land & Water Resources","Technical University of Denmark, Department of Environmental Engineering, Residual Resource Engineering"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"danish technological institute","l2":"DI-GTS","l2n":"GTS Institutes","l3":"DI-GTS-DTCI","l3nn":"Danish Technological Institute","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Danish Technological Institute","namevar":["AgroTech AS"],"nora_code":"DI-GTS-DTCI","used":1},{"affno":"3","country":"se","key":"rise research institutes of sweden","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"RISE Research Institutes of Sweden","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anders Michael","key":"fredenslundpau","last":"Fredenslund","locid":"31c0d967-33a7-4b71-b520-f4a8645f1088","name":"Fredenslund, Anders Michael","orcid":"0000-0002-5196-688X","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jørgen","key":"hingepau","last":"Hinge","name":"Hinge, Jørgen","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Magnus A.","key":"holmgrenpau","last":"Holmgren","name":"Holmgren, Magnus A.","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Søren G.","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Søren G.","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Charlotte","key":"scheutzpau","last":"Scheutz","locid":"48fe2850-fdc6-4282-9b97-ac5773419e5c","name":"Scheutz, Charlotte","orcid":"0000-0003-2218-5934","rank":5,"rolecode":"pau"}],"pmid":["30212778"],"pub":{"doi":"10.1016/j.biortech.2018.08.080","issn":["09608524","18732976"],"issn_org":["09608524"],"journal":"Bioresource Technology","pages":"88-95","publisher":"Elsevier","status":"p","title":"Bioresource Technology","volume":"270"},"review":"Peer Reviewed","scoID":["2-s2.0-85053059153"],"search":{"DAF":["All Danish Affiliations","All GTS Institutes","All Universities","DI-ALL","DI-GTS","DI-GTS-ALL","DI-U","DI-U-ALL","GTS Institutes","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-c2d01667-7ce1-461a-a373-ba89c648e87c"],"src":["DTU Technical University of Denmark"],"title":"On-site and ground-based remote sensing measurements of methane emissions from four biogas plants: a comparison study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-362832","year":"2018","yearsub":"2018"}
{"author_count":3,"contributors":["Løvlie, Anders Sundnes","Rasmussen, Mette Grønbæk","Kickbusch, Jari"],"cuid":["S01-000.00-384173"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"pop","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"und","rtype":["clu"],"sorti":"gift project deliverable d000000000007 000000000002 communication strategy","src":["itu"],"src-code":["DI-U-ITU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85639708/GIFT_D7.2_Communication_Strategy.pdf","version":"Published Version"},"id":"S01-000.00-384173","ids":["itu-c6200a16-d50d-4768-aa5b-ef4f6b191265"],"lang":"English","level":"Popular","mra":["Science/Technology"],"noi":["Local-1-1-FE4EC2EAA4D3507DA2FF2E019EC48388"],"oa_link":[{"access":"oa","type":"rem","url":"https://cordis.europa.eu/project/id/727040/results","version":"Published Version"},{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85639708/GIFT_D7.2_Communication_Strategy.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Data Science, Audio-Visual Computing","IT University of Copenhagen, Digital Design","IT University of Copenhagen, Play, Culture, and AI, Media, Art & Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anders Sundnes","key":"løvliepau","last":"Løvlie","locid":"22ec9269-2fff-4dbf-a9c7-5037559a15ee","name":"Løvlie, Anders Sundnes","orcid":"0000-0003-0484-4668","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Mette Grønbæk","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Mette Grønbæk","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jari","key":"kickbuschpau","last":"Kickbusch","name":"Kickbusch, Jari","rank":3,"rolecode":"pau"}],"pub":{"publisher":"The European Commission","status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-c6200a16-d50d-4768-aa5b-ef4f6b191265"],"src":["ITU IT University of Copenhagen"],"title":"GIFT Project Deliverable D7.2 Communication Strategy","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384173","year":"2018"}
{"abstract":"Context: Data on the association between growth hormone (GH) replacement in patients with GH deficiency (GHD) after malignancies and new neoplasms show conflicting results. Objective: To clarify the incidence of new malignant neoplasm in childhood-onset (CO) and adult-onset (AO) adult cancer survivors (CSs). Design: Retrospective comparison of CO-CS and AO-CS with CO idiopathic GHD (IGHD) and AO nonfunctioning pituitary adenoma (NFPA) patients and with the general population [standardized incidence ratio (SIR)]. Setting: Data from the Pfizer International Metabolic Database study (KIMS). Patients: CO-CS [n = 349; 50.4% females; mean baseline (MBL) IGF-I standard deviation score (SDS), -2.4], IGHD (n = 619; 35.7% females; MBL IGF-I SDS, -3.4), AO-CS (n = 174; 42.5% females; MBL IGF-I SDS, -1.4), and NFPA (n = 2449; 38.1% females; MBL IGF-I SDS, -1.0). Main Outcome Measures: SIRs of malignant neoplasms. Results: After a median follow-up of 5.9 years (2192 patient-years), 15 CO-CS (4.3%) had developed 16 new neoplasms. The SIR was 10.4 [95% confidence interval (CI), 5.9 to 16.9] and 6.5 (95% CI, 3.0 to 12.4) after exclusion of seven patients with skin cancers. In IGHD, three malignant neoplasms (0.5%) were observed after a median follow-up of 5.4 years (3908 patient-years; SIR, 0.47; 95% CI, 0.09 to 1.37). New malignant neoplasms occurred in three AO-CS (1.7%; SIR, 1.1; 95% CI, 0.2 to 3.2) and 146 NFPA patients (153 cases, 6.0%; SIR, 1.1; 95% CI, 0.9 to 1.2) after a median follow-up of 4.9 (1024 patient-years) and 5.6 years (15,215 patient-years). Conclusions: The risk of second malignant neoplasms was increased in CO-CS but not in AO-CS, which illustrates the need to closely follow patients on GH replacement because of a prior malignancy.","author_count":7,"contributors":["Krzyzanowska-Mittermayer, Katarzyna","Mattsson, Anders F","Maiter, Dominique","Feldt-Rasmussen, Ulla","Camacho-Hübner, Cecilia","Luger, Anton","Abs, Roger"],"cuid":["S01-000.00-398627"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Adenoma complications","Adolescent","Adult","Cancer Survivors statistics numerical data","Child","Databases Factual","Female","Follow Up Studies","Hormone Replacement Therapy adverse effects","Human Growth Hormone adverse effects","Humans","Hypopituitarism drug therapy","Male","Middle Aged","Neoplasms Second Primary chemically induced","Pituitary Neoplasms complications","Retrospective Studies","Young Adult"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"new neoplasm during gh replacement in adults with pituitary deficiency following malignancy a kims analysis","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-398627","identifier":[{"id":"85041892687","type":"scopus"},{"id":"29228199","type":"pmid"}],"ids":["ku-089809e9-81af-4739-ada1-6a0bd265b867"],"keyword":["Adenoma/complications","Adolescent","Adult","Cancer Survivors/statistics & numerical data","Child","Databases, Factual","Female","Follow-Up Studies","Hormone Replacement Therapy/adverse effects","Human Growth Hormone/adverse effects","Humans","Hypopituitarism/drug therapy","Male","Middle Aged","Neoplasms, Second Primary/chemically induced","Pituitary Neoplasms/complications","Retrospective Studies","Young Adult"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-188A52B65F63A51CECD8F684E598A993"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal Medicine: Endocrinology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Katarzyna","key":"krzyzanowskamittermayerpau","last":"Krzyzanowska-Mittermayer","name":"Krzyzanowska-Mittermayer, Katarzyna","rank":1,"rolecode":"pau"},{"affno":"","first":"Anders F","key":"mattssonpau","last":"Mattsson","name":"Mattsson, Anders F","rank":2,"rolecode":"pau"},{"affno":"","first":"Dominique","key":"maiterpau","last":"Maiter","name":"Maiter, Dominique","rank":3,"rolecode":"pau"},{"affno":"1","first":"Ulla","key":"feldtrasmussenpau","last":"Feldt-Rasmussen","locid":"b5898535-d448-4e2f-9f41-d5199873676b","name":"Feldt-Rasmussen, Ulla","rank":4,"rolecode":"pau"},{"affno":"","first":"Cecilia","key":"camachohübnerpau","last":"Camacho-Hübner","name":"Camacho-Hübner, Cecilia","rank":5,"rolecode":"pau"},{"affno":"","first":"Anton","key":"lugerpau","last":"Luger","name":"Luger, Anton","rank":6,"rolecode":"pau"},{"affno":"","first":"Roger","key":"abspau","last":"Abs","name":"Abs, Roger","rank":7,"rolecode":"pau"}],"pmid":["29228199"],"pub":{"doi":"10.1210/jc.2017-01899","issn":["0021972X","19457197"],"issn_org":["0021972X"],"issue":"2","journal":"Journal of Clinical Endocrinology and Metabolism","pages":"523-531","status":"p","title":"Journal of Clinical Endocrinology and Metabolism","title_org":"The Journal of clinical endocrinology and metabolism","volume":"103"},"review":"Peer Reviewed","scoID":["2-s2.0-85041892687"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-089809e9-81af-4739-ada1-6a0bd265b867"],"src":["KU University of Copenhagen"],"title":"New Neoplasm During GH Replacement in Adults With Pituitary Deficiency Following Malignancy : A KIMS Analysis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-398627","year":"2018","yearsub":"2018"}
