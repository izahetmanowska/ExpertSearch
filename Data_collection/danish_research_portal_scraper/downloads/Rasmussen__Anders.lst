 of Health Sciences, Department of Regional Health Research","SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Lillebælt Hospital, Research Unit of Medicine (Vejle)"],"nora_code":"DI-U-SDU","used":1},{"affno":"4","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Lillebaelt University Hospital"],"nora_code":"DI-HO-SDR","used":1},{"affno":"5","country":"nl","key":"radboud university nijmegen","loc":["Netherlands","Europe, EU","OECD"],"name":"Radboud University Nijmegen","used":1},{"affno":"6","country":"nl","key":"radboud university medical center","loc":["Netherlands","Europe, EU","OECD"],"name":"Radboud University Medical Center","used":1},{"affno":"7","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["National Hospital of Denmark"],"nora_code":"DI-HO-CAP","used":1},{"affno":"8","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Global Health Section"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"Victor Naestholt","key":"dahlpau","last":"Dahl","locid":"70668643-7b23-4f6f-be24-30500697e3e5","name":"Dahl, Victor Naestholt","orcid":"0000-0003-2965-6348","rank":1,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Andreas Arnholdt","key":"pedersenpau","last":"Pedersen","locid":"ca60d895-0d57-4c38-a3f7-a8195e27e795","name":"Pedersen, Andreas Arnholdt","orcid":"0000-0003-0751-6918","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Anders","key":"normanpau","last":"Norman","name":"Norman, Anders","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"E. Michael","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, E. Michael","rank":4,"rolecode":"pau"},{"affno":"5 6","corresponding":null,"first":"Jakko","key":"vaningenpau","last":"van Ingen","name":"van Ingen, Jakko","rank":5,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Aase Bengaard","key":"andersenpau","last":"Andersen","name":"Andersen, Aase Bengaard","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Christian Morberg","key":"wejsepau","last":"Wejse","locid":"382d58c8-3a9b-48f2-a419-ad70bdeaa4e3","name":"Wejse, Christian","name_org":"Wejse, Christian Morberg","orcid":"0000-0002-2534-2942","rank":7,"rolecode":"pau"},{"affno":"8","first":"Troels","key":"lillebaekpau","last":"Lillebaek","locid":"4c4e219b-6ac0-4067-a078-ef52b9c2beff","name":"Lillebaek, Troels","orcid":"0000-0002-2601-2718","rank":8,"rolecode":"pau"}],"pmid":["39173666"],"pub":{"doi":"10.3201/eid3009.240095","issn":["10806040","10806059"],"issn_org":["10806040"],"issue":"9","journal":"Emerging Infectious Diseases","pages":"1755-1762","publisher":"Centers for Disease Control and Prevention (CDC)","status":"p","title":"Emerging Infectious Diseases","volume":"30"},"review":"Peer Reviewed","scoID":["2-s2.0-85201999936"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-7c70c186-f240-4df2-b999-354d0ffefcee","ku-56beeff0-b614-4586-bded-b24f72d8e945","sdu-f490aae2-a5c1-4a1b-8acf-04cdc22ac425"],"src":["AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Clinical Significance, Species Distribution, and Temporal Trends of Nontuberculous Mycobacteria, Denmark, 1991–2022","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-094.12-767600","year":"2024","yearsub":"2024"}
{"abstract":"Importance: Excessive screen media use has been associated with poorer mental health among children and adolescents in several observational studies. However, experimental evidence supporting this hypothesis is lacking. Objective: To investigate the effects of a 2-week screen media reduction intervention on children's and adolescents' mental health. Design, Setting, and Participants: This prespecified secondary analysis of a cluster randomized clinical trial with a 2-week follow-up included 89 families (with 181 children and adolescents) from 10 Danish municipalities in the region of Southern Denmark. All study procedures were carried out in the home of the participants. Enrollment began on June 6, 2019, and ended on March 30, 2021. This analysis was conducted between January 1 and November 30, 2023. Intervention: Families were randomly allocated to a screen media reduction group or a control group. The 2-week screen media reduction intervention was designed to ensure a high level of compliance to the reduction in leisure-time screen media use. Participants allocated to the intervention group had to reduce their leisure-time screen media use to 3 hours per week or less per person and hand over smartphones and tablets. Main Outcomes and Measures: The main outcome was the between-group mean difference in change in total behavioral difficulties, measured by the Strengths and Difficulties Questionnaire at 2-week follow-up. Results were estimated using mixed-effects tobit regression models. Analyses were carried out as both intention to treat and complete case. Results: In the sample of 89 families including 181 children and adolescents (intervention group [45 families]: 86 children; mean [SD] age, 8.6 [2.7] years; 42 girls [49%]; control group [44 families]: 95 children; mean [SD] age, 9.5 [2.5] years; 57 girls [60%]), there was a statistically significant between-group mean difference in the total difficulties score, favoring the screen media reduction intervention (-1.67; 95% CI, -2.68 to -0.67; Cohen d, 0.53). The greatest improvements were observed for internalizing symptoms (emotional symptoms and peer problems; between-group mean difference, -1.03; 95% CI, -1.76 to -0.29) and prosocial behavior (between-group mean difference, 0.84; 95% CI, 0.39-1.30). Conclusions and Relevance: This secondary analysis of a randomized clinical trial found that a short-term reduction in leisure-time screen media use within families positively affected psychological symptoms of children and adolescents, particularly by mitigating internalizing behavioral issues and enhancing prosocial behavior. More research is needed to confirm whether these effects are sustainable in the long term. Trial Registration: ClinicalTrials.gov Identifier: NCT04098913.","author_count":9,"contributors":["Schmidt-Persson, Jesper","Rasmussen, Martin Gillies Banke","Sørensen, Sarah Overgaard","Mortensen, Sofie Rath","Olesen, Line Grønholt","Brage, Søren","Kristensen, Peter Lund","Bilenberg, Niels","Grøntved, Anders"],"cuid":["S03-100.00-793421"],"filters":{"added":"2024-09","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"continent":["Europe, Non-EU","OECD"],"corresponding_author":["Pedersen, Jesper"],"country":["United Kingdom"],"glorg":["All Global Affiliations","Medical Research Council (GB)","University of Cambridge"],"keyword":["Adolescent","Child","Denmark","Female","Humans","Male","Mental health","Screen time"],"level":"sci","mra":["hum","med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U","DI-UC"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR","DI-HO-SDR","DI-HO-ZEA"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"],"UC":["DI-UC-ALL","DI-UC-KP"]},"level3all":["DI-HO-CDR","DI-HO-SDR","DI-HO-ZEA","DI-U-AU","DI-U-SDU","DI-UC-KP"]},"review":"pr","rtype":["clu"],"sorti":"screen media use and mental health of children and adolescents a secondary analysis of a randomized clinical tria