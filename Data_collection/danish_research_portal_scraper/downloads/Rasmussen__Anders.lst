3","rank":7,"rolecode":"pau"},{"affno":"2","first":"Stig","key":"haunsøpau","last":"Haunsø","locid":"2d7a08cf-874a-4f9e-8964-e9c473cecd38","name":"Haunsø, Stig","rank":8,"rolecode":"pau"},{"affno":"2","first":"Jesper H","key":"svendsenpau","last":"Svendsen","locid":"d80910cf-2f9c-457c-9e85-34b4b258bb81","name":"Svendsen, Jesper Hastrup","name_org":"Svendsen, Jesper H","orcid":"0000-0001-8466-8515","rank":9,"rolecode":"pau"},{"affno":"2","first":"Lars","key":"køberpau","last":"Køber","locid":"e3f0c57c-605a-431a-9c63-2213c46621e6","name":"Køber, Lars","rank":10,"rolecode":"pau"},{"affno":"2","country":"dk","first":"Thomas A","key":"gerdspau","last":"Gerds","locid":"b87ed711-194a-48dc-b83a-3c7aad18a00d","name":"Gerds, Thomas Alexander","name_org":"Gerds, Thomas A","orcid":"0000-0002-5955-816X","rank":11,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Anders G.","key":"holstpau","last":"Holst","name":"Holst, Anders G.","rank":12,"rolecode":"pau"}],"pmid":["24603310"],"pub":{"doi":"10.1093/eurheartj/ehu081","issn":["0195668X","15229645"],"issn_org":["0195668X"],"issue":"20","journal":"European Heart Journal","pages":"1335-1344","publisher":"Oxford University Press","status":"p","title":"European Heart Journal","volume":"35"},"review":"Peer Reviewed","scoID":["2-s2.0-84901378801"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-8dda847b-fbb2-4041-9bd5-f1388c05429c","ku-ab5bd556-2159-4994-b58b-a827226f19dd"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"Risk prediction of cardiovascular death based on the QTc interval : evaluating age and gender differences in a large primary care population","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-098.91-006877","year":"2014","yearsub":"2014"}
{"abstract":"Understanding the peopling of the Americas remains an important and challenging question. Here, we present 14C dates, and morphological, isotopic and genomic sequence data from two human skulls from the state of Minas Gerais, Brazil, part of one of the indigenous groups known as ‘Botocudos’. We find that their genomic ancestry is Polynesian, with no detectable Native American component. Radiocarbon analysis of the skulls shows that the individuals had died prior to the beginning of the 19th century. Our findings could either represent genomic evidence of Polynesians reaching South America during their Pacific expansion, or European-mediated transport.","author_count":40,"contributors":["Malaspinas, Anna Sapfo","Lao, Oscar","Schroeder, Hannes","Rasmussen, Morten","Raghavan, Maanasa","Moltke, Ida","Campos, Paula F.","Sagredo, Francisca Santana","Rasmussen, Simon","Gonçalves, Vanessa F.","Albrechtsen, Anders","Allentoft, Morten E.","Johnson, Philip L F","Li, Mingkun","Reis, Silvia","Bernardo, Danilo V.","Degiorgio, Michael","Duggan, Ana T.","Bastos, Murilo","Wang, Yong","Stenderup, Jesper","Moreno-Mayar, J. Victor","Brunak, Søren","Sicheritz-Ponten, Thomas","Hodges, Emily","Hannon, Gregory J.","Orlando, Ludovic","Price, T. Douglas","Jensen, Jeffrey D.","Nielsen, Rasmus","Heinemeier, Jan","Olsen, Jesper","Rodrigues-Carvalho, Claudia","Lahr, Marta Mirazón","Neves, Walter A.","Kayser, Manfred","Higham, Thomas","Stoneking, Mark","Pena, Sergio D J","Willerslev, Eske"],"cuid":["S03-093.88-028714"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"continent":["America, North","America, South","Europe, EU","Europe, Non-EU","OECD"],"country":["Brazil","Canada","Germany","Netherlands","Switzerland","United Kingdom","United States"],"glorg":["All Global Affiliations","Cold Spring Harbor Laboratory","Emory University","Erasmus University Medical Center","Erasmus University Rotterdam","Laborator