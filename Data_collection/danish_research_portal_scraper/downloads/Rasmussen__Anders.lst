rch","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-f1388c9a-d70a-4ff4-8bfb-43ab7e1864ad"],"src":["SDU University of Southern Denmark"],"title":"An increased potential for organ donors may be found among patients with out-of-hospital cardiac arrest","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-642268","year":"2022","yearsub":"2022"}
