{"abstract":"Anders Juhl Rasmussen have made an interview with Prof. Mogens Hørder, former Dean of the Faculty of Health Sciences (SDU) and chief physician at Odense University Hospital about how places and spaces have been conceptualized in the history of Danish Health Services, and what function they will have in the future.","author_count":2,"contributors":["Rasmussen, Anders Juhl","Hørder, Mogens"],"cuid":["S01-000.00-646098"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Brugerinddragelse","Hospitaler","Narrativ medicin","sted og rum"],"level":"pop","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"und","rtype":["clu"],"sorti":"places and spaces in the danish health services over time","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://medicalhealthhumanities.com/2020/03/09/places-and-spaces-in-the-danish-health-services-over-time/","version":"Published Version"},"id":"S01-000.00-646098","ids":["sdu-fe80cb71-1784-4fb1-98ce-406de843d1f6"],"keyword":["brugerinddragelse","hospitaler","narrativ medicin","sted og rum"],"lang":"English","level":"Popular","mra":["Humanities"],"noi":["Local-1-1-D29CF42FB13D9412CC114013103E5AF7"],"oa_link":[{"access":"oa","type":"rem","url":"https://medicalhealthhumanities.com/2020/03/09/places-and-spaces-in-the-danish-health-services-over-time/","version":"Published Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Humanities, Department for the Study of Culture","SDU, Faculty of Humanities, Department of Culture and Language, Cultural Studies","SDU, Faculty of Humanities, Department of Culture and Language, Uses of Literature"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anders Juhl","key":"rasmussenpau","last":"Rasmussen","locid":"6612df8e-d9f9-4004-b959-a9c30b0762a5","name":"Rasmussen, Anders Juhl","orcid":"0000-0001-7718-5208","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mogens","key":"hørderpau","last":"Hørder","locid":"487fb338-3245-49cd-8535-dc4718700ffd","name":"Hørder, Mogens","orcid":"0000-0001-7243-2070","rank":2,"rolecode":"pau"}],"pub":{"journal":"Synapsis: A Health Humanities Journal","status":"p","title":"Synapsis: A Health Humanities Journal"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-fe80cb71-1784-4fb1-98ce-406de843d1f6"],"src":["SDU University of Southern Denmark"],"title":"Places and Spaces in the Danish Health Services Over Time","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-646098","year":"2020","yearsub":"2020"}
{"abstract":"Historisk og begrebslig introduktion til Schellings \"Den transcendentale idealismes system\" samt nedslag i værkets samtidige og senere receptionshistorie.","author_count":2,"contributors":["Rasmussen, Jesper Lundsfryd","Rasmussen, Anders Moe"],"cuid":["S01-000.00-671756"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Idealisme","Naturalisme","Schelling"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Ukendt"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"introduktion","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://philosophia.dk/?product=den-transcendentale-idealismes-system","version":"Other Version"},"id":"S01-000.00-671756","ids":["sdu-9396b764-6880-45b4-9ba2-786263f939e3"],"keyword":["Idealisme","Klassisk tysk filosofi","Naturalisme","Schelling"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-7F352AC9C5C85EE60E36D398014A0FED"],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Humanities, Department for the Study of Culture","SDU, Faculty of Humanities, Human Health"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Ukendt"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jesper Lundsfryd","key":"rasmussenjesperlundsfrydpau","last":"Rasmussen","locid":"3c2fa8c2-d7b2-4c69-936b-3b8e08e88c38","name":"Rasmussen, Jesper Lundsfryd","orcid":"0000-0001-8742-9368","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Anders Moe","key":"rasmussenandersmoepau","last":"Rasmussen","name":"Rasmussen, Anders Moe","rank":2,"rolecode":"pau"}],"pub":{"isbn":["9788793041561"],"pages":"13-51","place":"Aarhus","publisher":"Forlaget Philosophia","status":"p","title":"Den transcendentale idealismes system"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-9396b764-6880-45b4-9ba2-786263f939e3"],"src":["SDU University of Southern Denmark"],"title":"Introduktion","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-671756","year":"2020","yearsub":"2020"}
{"abstract":"Coral reefs worldwide are rapidly declining due to increasing anthropogenic stressors and environmental changes, with large-scale mortalities of coral reefs observed in many locations across the globe. It has become clear that the microbiome of corals is important in understanding the causes of coral infections, although its exact role is yet to be fully understood. Here, we characterize the bacteria and fungi associated with the non-lesional and lesional (identified by discoloration and tissue loss) tissues of coral species from Vietnam. Metabarcoding of the bacterial 16S rRNA gene and the fungal ITS rRNA gene region were performed. We sampled across two Porites species with potentially multiple causes of stresses, yet the bacterial compositions of lesional regions were consistently different from non-lesional areas of the same coral. These differences were driven by a considerable and significant increase in OTU richness within the lesional region compared to the non-lesional region. While no single OTU was consistently associated with lesional tissue, indicator analysis revealed that nine OTUs were significantly more persistent in the lesional regions that could represent useful bioindicators of stress. Meanwhile, there were no indicator OTUs in the non-lesional region. Further investigations are needed to determine whether changing bacterial communities play a mechanistic role in inducing lesioning, or are opportunistically colonizing stressed corals.","author_count":10,"contributors":["Rasmussen, Linett","Barnes, Christopher James","Mak, Sarah S. T.","Kjartansdóttir, Kristin Rós","Hansen, Thomas Arn","Doan-Nhu, Hai","Nguyen-Ngoc, Lam","Frøslev, Tobias Guldberg","Hellström, Ann Micaela","Hansen, Anders Johannes"],"cuid":["S01-000.00-818461"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, South"],"country":["Vietnam"],"glorg":["All Global Affiliations","Vietnamese Academy of Science and Technology"],"keyword":["Bacteria","Fungi","Metabarcoding","Microbiome","Molecular ecology"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"increased bacterial richness associated with lesions within the porites spp of vietnam","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fevo.2020.00151","version":"Published Version"},"id":"S01-000.00-818461","identifier":[{"id":"85086161067","type":"scopus"}],"ids":["ku-067ac9df-82d9-42e8-8e9a-d4497b2538bb"],"keyword":["bacteria","fungi","metabarcoding","microbiome","molecular ecology"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-CE98B5B2E19F6402A5421A526DF4210B"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/247446446/fevo_08_00151.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fevo.2020.00151","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Globe Institute, Section for Hologenomics"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"vn","key":"vietnamese academy of science and technology","loc":["Vietnam","Asia, South"],"name":"Vietnamese Academy of Science and Technology","used":1}],"person":[{"affno":"1","first":"Linett","key":"rasmussenlinettpau","last":"Rasmussen","locid":"0543380d-1a58-4cdf-b490-9c1861185f30","name":"Rasmussen, Linett","rank":1,"rolecode":"pau"},{"affno":"1","first":"Christopher","key":"barneschristopherjamespau","last":"Barnes","locid":"369a0b39-cf9f-4240-b9b4-4eb69c878bcd","name":"Barnes, Christopher James","name_org":"Barnes, Christopher","orcid":"0000-0001-6800-4233","rank":2,"rolecode":"pau"},{"affno":"1","first":"Sarah Siu Tze","key":"maksarahstpau","last":"Mak","locid":"1d32ab5b-aa6f-494a-a7de-fe4baf7fa20b","name":"Mak, Sarah S. T.","name_org":"Mak, Sarah Siu Tze","orcid":"0000-0003-1119-0519","rank":3,"rolecode":"pau"},{"affno":"1","first":"Kristín Rós","key":"kjartansdóttirkristinróspau","last":"Kjartansdóttir","locid":"2a883405-a34d-4781-b9f2-1ee1cc6fb4e0","name":"Kjartansdóttir, Kristin Rós","name_org":"Kjartansdóttir, Kristín Rós","rank":4,"rolecode":"pau"},{"affno":"1","first":"Thomas Arn","key":"hansenthomasarnpau","last":"Hansen","locid":"e7c51e1e-cfdc-4173-a027-623f1d08ad7b","name":"Hansen, Thomas Arn","rank":5,"rolecode":"pau"},{"affno":"2","first":"Hai","key":"doannhuhaipau","last":"Doan-Nhu","name":"Doan-Nhu, Hai","rank":6,"rolecode":"pau"},{"affno":"2","first":"Lam","key":"nguyenngoclampau","last":"Nguyen-Ngoc","name":"Nguyen-Ngoc, Lam","rank":7,"rolecode":"pau"},{"affno":"1","first":"Tobias","key":"frøslevtobiasguldbergpau","last":"Guldberg Frøslev","locid":"68c04506-5e2f-4f9a-890d-26d7353651b5","name":"Frøslev, Tobias Guldberg","name_org":"Guldberg Frøslev, Tobias","orcid":"0000-0002-3530-013X","rank":8,"rolecode":"pau"},{"affno":"1","first":"Micaela","key":"hellströmannmicaelapau","last":"Hellström","locid":"50c9725c-f8e8-46af-a70e-91cfd382cc00","name":"Hellström, Ann Micaela","name_org":"Hellström, Micaela","rank":9,"rolecode":"pau"},{"affno":"1","first":"Anders Johannes","key":"hansenandersjohannespau","last":"Hansen","locid":"846e4329-bfc5-4ddb-968c-445cdb16825a","name":"Hansen, Anders Johannes","orcid":"0000-0002-1890-2702","rank":10,"rolecode":"pau"}],"pub":{"doi":"10.3389/fevo.2020.00151","issn":["2296701X"],"journal":"Frontiers in Ecology and Evolution","paperid":"151","status":"p","title":"Frontiers in Ecology and Evolution","volume":"8"},"review":"Peer Reviewed","scoID":["2-s2.0-85086161067"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-067ac9df-82d9-42e8-8e9a-d4497b2538bb"],"src":["KU University of Copenhagen"],"title":"Increased Bacterial Richness Associated With Lesions Within the Porites spp. of Vietnam","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-818461","year":"2020","yearsub":"2020"}
{"abstract":"Background: Pulmonary rehabilitation (PR) is a cornerstone in COPD care. Physical training (PT) is a key component of PR programmes. However, PR adherence is suboptimal, and barriers include inability to perform PT. There is an emerging need for alternative, evidence-based PR programmes. Lung choirs or singing training (ST) has potential benefits concerning improved respiratory control and wellbeing but impact on physical capacity is unknown. Methods: We investigated the effects of ST compared to PT in a 10 weeks’ PR program in a randomised controlled trial (NCT03280355). Primary outcome was change in physical capacity (6-Minutes Walk Test, 6MWT) from baseline to post-PR, and secondary outcomes were changes in Quality of Life (QoL; St George’s Respiratory Questionnaire, SGRQ), depression or anxiety (HADS), dyspnea (mMRC), lung function (FEV1%predicted), and overall PR adherence. Results: We included 270 patients with COPD and 195 completed the study. Study arms were comparable, and both study arms benefitted significantly in 6MWT and SGRQ. ST was non-inferior to PT in 6MWT (p=0.94), though superior in SGRQ Impact improvement (p<0.01). No significant inter-group differences were seen in depression or anxiety, dyspnoea, lung function, or adherence. Conclusions: ST appears to be as efficacious as PT in improving physical capacity and superior concerning QoL. The long-term effects and impact of COPD exacerbation rate is unknown. There is a need to explore and standardise the optimal content of ST to provide evidence-based and personalised medicine to COPD patients needing PR.","author_count":7,"contributors":["Kaasgaard, Mette","Rasmussen, Daniel Bech","Løkke, Anders","Vuust, Peter","Hilberg, Ole","Bødtger, Uffe"],"cuid":["S02-080.22-017396"],"event":{"end":"2020-09-09","place":"Virtuel","start":"2020-08-24","title":"ERS International Congress 2020","year":"2020"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-ART","DI-U"],"level3":{"ART":["DI-ART-ALL","DI-ART-RDAM"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-ART-RDAM","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"sing a lung group singing as training modality in pulmonary rehabilitation for patients with chronic obstructive pulmonary disease copd a multicenter cluster randomised non inferiority controlled trial","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Kun læseadgang","type":"doi","url":"https://doi.org/10.1183/13993003.congress-2020.4663","version":"Published Version"},"id":"S02-080.22-017396","identifier":[{"id":"000606501407463","type":"wos"}],"ids":["au-40b32be1-8a72-4161-ae8e-e858d7221717","sdu-52074255-ef1e-4893-a2fa-9a7fa6dfbf27"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-578F3CF69FF6377D3D218A818E37D245"],"oa_link":[{"access":"oa","license":"Kun læseadgang","type":"doi","url":"https://doi.org/10.1183/13993003.congress-2020.4663","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Center for Music In the Brain"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Regional Health Research","SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Zealand University Hospital"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","country":"dk","key":"rdam the royal danish academy of music","l2":"DI-ART","l2n":"Artistic Higher Education Institutions","l3":"DI-ART-RDAM","l3nn":"RDAM The Royal Danish Academy of Music","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RDAM The Royal Danish Academy of Music","namevar":["Royal Academy of Music"],"nora_code":"DI-ART-RDAM","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Mette","key":"kaasgaardpau","last":"Kaasgaard","locid":"fc5784b6-66d8-4b92-8c4a-74bf4628c9c3","name":"Kaasgaard, Mette","orcid":"0000-0003-3833-2943","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Daniel Bech","key":"rasmussenpau","last":"Rasmussen","locid":"18525822-35fd-4cd8-afdd-a608be44cc84","name":"Rasmussen, Daniel Bech","orcid":"0000-0003-1213-9483","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Anders Løkke","key":"ottesenpau","last":"Ottesen","locid":"db3d3870-0459-4783-8f0b-6a8e5d9dce78","name":"Løkke, Anders","name_org":"Ottesen, Anders Løkke","orcid":"0000-0002-6905-4141","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Peter","key":"vuustpau","last":"Vuust","name":"Vuust, Peter","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ole","key":"hilbergpau","last":"Hilberg","locid":"6c545c65-1d94-45a3-a8b4-f90eae06d248","name":"Hilberg, Ole","orcid":"0000-0002-3075-3463","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Uffe","key":"bodtgerpau","last":"Bodtger","locid":"2f4e70da-63bb-4b8d-af09-2a959d6df5e8","name":"Bodtger, Uffe","orcid":"0000-0002-1231-9209","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Uffe","key":"bødtgerpau","last":"Bødtger","name":"Bødtger, Uffe","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1183/13993003.congress-2020.4663","issn":["09031936","13993003"],"issn_org":["09031936"],"issue":"Suppl. 64","journal":"European Respiratory Journal","paperid":"4663","publisher":"European Respiratory Society","status":"p","title":"European Respiratory Journal","volume":"56"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Artistic Higher Education Institutions","All Danish Affiliations","All Universities","Artistic Higher Education Institutions","DI-ALL","DI-ART","DI-ART-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-40b32be1-8a72-4161-ae8e-e858d7221717","sdu-52074255-ef1e-4893-a2fa-9a7fa6dfbf27"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Sing-a-Lung: Group singing as training modality in pulmonary rehabilitation for patients with Chronic Obstructive Pulmonary Disease (COPD) : A multicenter, cluster-randomised, non-inferiority, controlled trial","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-080.22-017396","year":"2020","yearsub":"2020"}
{"abstract":"Background: Patients undergoing total knee arthroplasty (TKA)/ total hip arthroplasty (THA) still experience moderate-severe postoperative pain despite optimized pain management regimes. The patients already on opioid treatment and pain catastrophizers (PCs) have a higher risk of postoperative pain. The use of preoperative intravenous high-dose glucocorticoids decreases postoperative pain after TKA and THA, but optimal dose is yet to be found, and the effect on subpopulations at high pain risk is unknown. Aim: To investigate the effect of a higher than previously used dose of glucocorticoids (dexamethasone (DXM)), administered intravenously before surgery, as part of standardized fast-track regimen, on postoperative pain in TKA/THA subgroups. Method: Three separate randomized, double-blinded, controlled trials were planned to compare a new higher dose DXM (1 mg/kg) to the earlier used high-dose DXM (0.3 mg/kg). Study 1: predicted Low Pain TKA; study 2: predicted High Pain Responder (HPR) TKA; study 3: predicted HPR THA. Predicted HPR groups consist of either PCs with PCS-score of ≥ 21 and/or history of ongoing opioid-treatment of 30 mg/day of morphine or equivalents > 30 days. In total, 408 patients were planned for inclusion (160 Low Pain TKA, 88 HPR TKA, 160 HPR THA). Primary outcome : Pain upon ambulation in a 5-meter walk test 24 hours after surgery. Secondary outcomes include use of analgesics, rescue-opioids, antiemetics, cumulated pain, CRP, OR-SDS, QoR-15, quality of sleep, length of stay (LOS), reasons for hospitalization, readmission, morbidity, and mortality. Patients completed follow-up on day 90. Recruiting commenced February 2019 and is expected to finish in September 2020.","author_count":10,"contributors":["Nielsen, Niklas","Kehlet, Henrik","Gromov, Kirill","Troelsen, Anders","Husted, Henrik","Varnum, Claus","Kjærsgaard-Andersen, Per","Rasmussen, Lasse E.","Mandøe, Hans","Foss, Nicolai Bang"],"cuid":["S02-086.67-047354"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Nielsen, Niklas I."],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-SDR","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"preoperative high dose steroids in total knee and hip arthroplasty protocols for three randomized controlled trials","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/171664678/aas.13656.pdf","version":"Authors Final Version"},"id":"S02-086.67-047354","identifier":[{"id":"32533723","type":"pmid"},{"id":"85087161358","type":"scopus"}],"ids":["ku-f314477d-78d0-4d20-9157-0afc8e4ae125","sdu-d0cb623e-12bd-4c21-bfb6-600407bb9fc3"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-158AE3EDC6AE52D87A06BF8F575A34B2"],"oa_link":[{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/171664678/aas.13656.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Lillebælt Hospital, Research Unit of Orthopaedics (Vejle)"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Lillebaelt University Hospital"],"nora_code":"DI-HO-SDR","used":1}],"person":[{"affno":"1","first":"Niklas I.","key":"nielsenpau","last":"Nielsen","locid":"7f5e02f9-db74-437d-a29e-60baae07f850","name":"Nielsen, Niklas","name_org":"Nielsen, Niklas I.","rank":1,"rolecode":"pau"},{"affno":"1","first":"Henrik","key":"kehletpau","last":"Kehlet","locid":"0a3c43a0-a0c5-4a91-85d6-6e80e16af8b5","name":"Kehlet, Henrik","orcid":"0000-0002-2209-1711","rank":2,"rolecode":"pau"},{"affno":"1","first":"Kirill","key":"gromovpau","last":"Gromov","locid":"efb84811-45bd-4724-97f5-e10d5b84525f","name":"Gromov, Kirill","rank":3,"rolecode":"pau"},{"affno":"1","first":"Anders","key":"troelsenpau","last":"Troelsen","locid":"49cb6bcf-2ff6-41af-a356-a2a09c2ce7ba","name":"Troelsen, Anders","orcid":"0000-0003-0132-8182","rank":4,"rolecode":"pau"},{"affno":"1","first":"Henrik","key":"hustedpau","last":"Husted","locid":"f8dc9a5b-bf7f-45e7-b210-3b25c01cfa24","name":"Husted, Henrik","rank":5,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Claus","key":"varnumpau","last":"Varnum","locid":"0f639544-4ebc-467c-a15b-3c049a26f62f","name":"Varnum, Claus","orcid":"0000-0002-0625-5691","rank":6,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"country":"dk","first":"Per","key":"kjærsgaardandersenpau","last":"Kjærsgaard-Andersen","locid":"9d7006f6-37d8-43c1-a108-2705353942f6","name":"Kjærsgaard-Andersen, Per","orcid":"0000-0001-6845-4218","rank":7,"rolecode":"pau"},{"aff