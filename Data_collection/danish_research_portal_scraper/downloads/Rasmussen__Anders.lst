lisher":"American Association for the Advancement of Science","status":"p","title":"Science","volume":"358"},"review":"Peer Reviewed","scoID":["2-s2.0-85030861669"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-f8cd401f-29cc-4ac5-a589-ba1c4ddbee12","ku-1ef4d855-e17e-4586-98c7-0c78680173bb"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Ancient genomes show social and reproductive behavior of early Upper Paleolithic foragers","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.01-038107","year":"2017","yearsub":"2017"}
{"abstract":"Since 1992, Denmark has documented the largest outbreak of tuberculosis in Scandinavia ascribed to a single genotype, termed C2/1112-15. As of spring 2017, the International Reference Laboratory of Mycobacteriology in Copenhagen has collected and identified isolates from more than a thousand cases belonging to this outbreak via routine mycobacterial interspersed repetitive units-variable number of tandem repeats typing. Here, we present a retrospective analysis of the C2/1112-15 dataset, based on whole-genome data from a sparse time series consisting of 5 randomly selected isolates from 23 years of sampling. Even if these data are derived from only 12% of the collected isolates, we have been able to extract important key information, such as mutation rate and conserved single-nucleotide polymorphisms to identify discrete transmission chains, as well as the possible historical origins of the outbreak.","author_count":7,"contributors":["Folkvardsen, Dorte Bek","Norman, Anders","Andersen, Åse Bengård","Rasmussen, Erik Michael","Jelsbak, Lars","Lillebaek, Troels"],"cuid":["S03-096.47-035784"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"keyword":["Bacterial Typing Techniques","DNA Bacterial","DNA Bacterial genetics","Denmark","Denmark epidemiology","Evolution","Genotype","Humans","Incidence","Journal Article","Linear Models","M tuberculosis","Molecular epidemiology","Mutation Rate","Mycobacterium tuberculosis","Mycobacterium tuberculosis genetics","Outbreak","Polymorphism Single Nucleotide","Retrospective Studies","Sequence Analysis DNA","Transmission","Tuberculosis","Tuberculosis epidemiology","WGS"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-U-DTU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"genomic epidemiology of a major mycobacterium tuberculosis outbreak retrospective cohort study in a low incidence setting using sparse time series sampling","src":["dtu","ku","sdu"],"src-code":["DI-U-DTU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/202373524/Genomic_Epidemiology_of_a_Major_Mycobacterium_tuberculosis_Outbreak_2017_accepted.pdf","version":"Authors Final Version"},"id":"S03-096.47-035784","identifier":[{"id":"85029550829","type":"scopus"},{"id":"28666374","type":"pmid"}],"ids":["dtu-8af073db-83a7-4a56-ab65-5dc20e236099","ku-de1886db-b957-425b-8288-a4e12159bf8a","sdu-47915075-8519-42c8-b2ad-ad8b4285f513"],"keyword":["Bacterial Typing Techniques","DNA, Bacterial","DNA, Bacterial/genetics","Denmark","Denmark/epidemiology","Evolution","Genotype","Humans","Incidence","Journal Article","Linear Models","M. tuberculosis","Molecular Epidemiology","Mutation Rate","Mycobacterium tuberculosis","Mycobacterium tuberculosis/genetics","Outbreak","Polymorphism, Single Nucleotide","Retrospective Studies","Sequence Analysis, DNA","Transmission","Tuberculosis","Tuberculosis/epidemiology","WGS"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-6-6017AE1EEF1A1ED3D43D38069EE5986F"],"oa_link":[{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/143107991/Genomic_Epidemiology_of_a_Major_Mycobacterium_tuberculosis_Outbreak.pdf","version":"Authors Final Version"},{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/202373524/Genomic_Epidemiology_of_a_Major_Mycobacterium_tuberculosis_Outbreak_2017_accepted.pdf","version":"Authors Final Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/133980310/jix298.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)