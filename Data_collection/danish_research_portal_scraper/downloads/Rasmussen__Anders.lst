orresponding":null,"first":"Anders Juhl","key":"rasmussenpau","last":"Rasmussen","locid":"6612df8e-d9f9-4004-b959-a9c30b0762a5","name":"Rasmussen, Anders Juhl","orcid":"0000-0001-7718-5208","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Merethe Kirstine Kousgaard","key":"andersenpau","last":"Andersen","locid":"c6a8bf7f-78bf-4e29-a55d-5c1771a197f9","name":"Andersen, Merethe Kirstine Kousgaard","orcid":"0000-0002-4833-1867","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anette","key":"bygumpau","last":"Bygum","locid":"fb8a6c5b-bfda-4ca1-b7c8-fc0714e18b1e","name":"Bygum, Anette","orcid":"0000-0002-3004-0180","rank":4,"rolecode":"pau"}],"pub":{"issn":["00415782","13994174"],"issn_org":["00415782"],"issue":"11","journal":"Ugeskrift for Læger","publisher":"Lægeforeningen","status":"p","title":"Ugeskrift for Læger","volume":"182"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-51be2576-365a-4d21-ad11-0b4bd3536b33"],"src":["SDU University of Southern Denmark"],"title":"Den gode læge behandler sygdommen - den særligt gode læge behandler mennesket, som har sygdommen","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-596650","year":"2020","yearsub":"2020"}
{"abstract":"This article presents narrative medicine as a new field of medical humanities. Narrative medicine has become influential over the world as well as in Denmark in recent years. Narrative medicine aims to counter the often reductionist way patients are perceived and treated in biomedicine and argues for the importance of seeing and hearing patients in the clinical practice as whole, complex persons. Through close reading of literary narratives about illness the medical students are assumed to become less unemphatic, more attuned to self-care and more tolerant towards ambiguity in the clinic.","author_count":2,"contributors":["Rasmussen, Anders Juhl","Sodemann, Morten"],"cuid":["S01-000.00-628126"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Humanities","Humans","Narration","Narrative Medicine","Self Care"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"narrativ medicin som nyt interdisciplinært felt","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85081530512","version":"Other Version"},"id":"S01-000.00-628126","identifier":[{"id":"85081530512","type":"scopus"},{"id":"32138815","type":"pmid"}],"ids":["sdu-bf8a1d26-3313-4989-8d08-93d63b8acda1"],"keyword":["Humanities","Humans","Narration","Narrative Medicine","Self Care"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-2-513187D8116E25754149256703BA061C"],"oai":{"class":"Blocked","mra":["Humanities (HUM)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Humanities, Department for the Study of Culture","SDU, Faculty of Humanities, Department of Culture and Language, Cultural Studies","SDU, Faculty of Humanities, Department of Culture and Language, Uses of Literature"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anders Juhl","key":"rasmussenpau","last":"Rasmussen","locid":"6612df8e-d9f9-4004-b959-a9c30b0762a5","name":"Rasmussen, Anders Juhl","orcid":"0000-0001-7718-5208","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Morten","key":"sodemannpau","last":"Sodemann","locid":"e4e58879-7d72-4665-880c-38ad97d0ebe5","name":"Sodemann, Morten","orcid":"0000-0001-8992-2500","rank":2,"rolecode":"pau"}],"pmid":["32138815"],"pub":{"issn":["00415782","13994174"],"issn_org":["00415782"],"issue":"21","journal":"Ugeskrift for Læger","paperid":"V08190446","publisher":"Lægeforeningen","status":"p","title":"Ugeskrift for Læger","volume":"182"},"review":"Peer Reviewed","scoID":["2-s2.0-85126970167"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-bf8a1d26-3313-4989-8d08-93d63b8acda1"],"src":["SDU University of Southern Denmark"],"title":"Narrativ medicin som nyt, interdisciplinært felt","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-628126","year":"2020","yearsub":"2020"}
{"abstract":"Background: Pulmonary rehabilitation (PR) is a cornerstone in COPD care. Physical training (PT) is a key component of PR programmes. However, PR adherence is suboptimal, and barriers include inability to perform PT. There is an emerging need for alternative, evidence-based PR programmes. Lung choirs or singing training (ST) has potential benefits concerning improved respiratory control and wellbeing but impact on physical capacity is unknown. Methods: We investigated the effects of ST compared to PT in a 10 weeks’ PR program in a randomised controlled trial (NCT03280355). Primary outcome was change in physical capacity (6-Minutes Walk Test, 6MWT) from baseline to post-PR, and secondary outcomes were changes in Quality of Life (QoL; St. George’s Respiratory Questionnaire, SGRQ), depression or anxiety (HADS), dyspnea (mMRC), lung function (FEV1%predicted), and overall PR adherence. Results: We included 270 patients with COPD and 195 completed the study. Study arms were comparable, and both study arms benefitted significantly in 6MWT and SGRQ. ST was non-inferior to PT in 6MWT (p=0.94), though superior in SGRQ Impact improvement (p<0.01). No significant inter-group differences were seen in depression or anxiety, dyspnoea, lung function, or adherence. Conclusions: ST appears to be as efficacious as PT in improving physical capacity and superior concerning QoL. The long-term effects and impact of COPD exacerbation rate is unknown. There is a need to explore and standardise the optimal content of ST to provide evidence-based and personalized medicine to COPD patients needing PR.","author_count":6,"contributors":["Kaasgaard, Mette","Rasmussen, Daniel Bech","Løkke, Anders","Vuust, Peter","Hilberg, Ole","Bodtger, Uffe"],"cuid":["S01-000.00-745770"],"filters":{"added":"2022-03","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["COPD management","Physical activity","Quality of Life"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-SDR","DI-HO-ZEA"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-SDR","DI-HO-ZEA","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"nr","rtype":["clu"],"sorti":"sing a lung group singing as training modality in pulmonary rehabilitation for patients with chronic obstructive pulmonary disease copd a multicenter cluster randomised non inferiority controlled trial","src":["au"],"src-code":["DI-U-AU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1183/13993003.congress-2020.4663","version":"Published Version"},"id":"S01-000.00-745770","identifier":[{"id":"000606501407463","type":"wos"}],"ids":["au-fb6f1746-391c-469d-a380-a1216fb0e8eb"],"keyword":["COPD - management","Physical activity","Quality of life"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-59FC15552EA3BD7F3C22FAA725B4F257"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1183/13993003.congress-2020.4663","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Center for Music In the Brain"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["University of Southern Denmark (SDU)"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Lillebælt Hospital"],"nora_code":"DI-HO-SDR","used":1},{"affno":"4","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Næstved, Slagelse og Ringsted Hospitals","Zealand University Hospital"],"nora_code":"DI-HO-ZEA","used":1},{"affno":"5","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Mette","key":"kaasgaardpau","last":"Kaasgaard","locid":"fc5784b6-66d8-4b92-8c4a-74bf4628c9c3","name":"Kaasgaard, Mette","orcid":"0000-0003-3833-2943","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Daniel Bech","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Daniel Bech","rank":2,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Anders","key":"løkkepau","last":"Løkke","name":"Løkke, Anders","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter","key":"vuustpau","last":"Vuust","locid":"2c697ab6-9b06-4a16-a687-c8cdbd56f661","name":"Vuust, Peter","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Ole","key":"hilbergpau","last":"Hilberg","name":"Hilberg, Ole","rank":5,"rolecode":"pau"},{"affno":"2 4 5","corresponding":null,"first":"Uffe","key":"bodtgerpau","last":"Bodtger","name":"Bodtger, Uffe","rank":6,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-fb6f1746-391c-469d-a380-a1216fb0e8eb"],"src":["AU Aarhus University"],"title":"Sing-a-Lung: Group singing as training modality in pulmonary rehabilitation for patients with Chronic Obstructive Pulmonary Disease (COPD): A multicenter, cluster-randomised, non-inferiority, controlled trial","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-745770","year":"2020","yearsub":"2020"}
{"abstract":"Multiple and rapid environmental changes in the Arctic have major consequences for the entire ecosystem. Soil water chemistry is one component with important implications for understanding climate feedbacks, plant growth, microbial turnover and net greenhouse gas emissions. Here we assess the contrasting growing season soil water chemistry in a Low arctic Greenlandic mesic tundra heath and a fen, which have been subjected to factorial treatments of summer warming using open top chambers (OTCs), snow addition using snow fences, which increase soil temperature in late winter, and shrub removal mimicking herbivory attack. Dissolved Organic Carbon (DOC) and plant nutrients, including NO3 −, NH4 +, PO4 2+ and total dissolved N were measured during multiple growing seasons (2013–2016) to quantify the treatment effects on nutrient availability in two dominating, but contrasting, vegetation types. Ambient nutrient concentrations in the mesic tundra heath decreased throughout the growing season and increased during senescence, while concentrations were highest during peak growing season in the fen. The content of NH4 + and DOC were highest in the fen, whereas NO3 − was highest in the mesic tundra heath. The fen had no seasonal pattern. Summer warming in the mesic tundra heath did not change the availability of nutrients, but in combination with shrub removal, both NO3 − and DOC concentrations increased, likely due to reduced plant uptake. Shrub removal alone increased NO3 − in one growing season, and, combined with snow addition, increased DOC. Significant effects of shrub removal were mostly found in 2016. Snow addition combined with summer warming increased DOC and total N concentrations and highlights the potential loss of dissolved C from the ecosystem. In the fen, shrub removal alone and combined with summer warming decreased DOC. Snow addition alone and in combination with summer warming similarly decreased DOC. In the mesic tundra heath, shrub removal caused higher soil water contents in all years. In the dry and warm 2016, it meant <10% soil water content in controls and 15–20% in shrub removal plots during the peak growing season, which may have relieved soil moisture limitation on mineralization rates in the latter. We conclude that soil water chemistry is vegetation-specific, and that treatment effects are surprisingly limited when comparing multiple years with contrasting precipitation patterns. Herbivory may have larger impact in very dry, warm summers and, together with extreme weather events, exert similar or larger effects than four years of temperature manipulations. The effects of summer warming or increased winter snow depend on ecosystem type and moisture status of the soil. The combination of multi-year and multi-site studies therefore seem important for understanding future biogeochemical dynamics in Arctic landscapes.","author_count":5,"contributors":["Rasmussen, Laura","Michelsen, Anders","Ladegaard-Pedersen, Pernille","Nielsen, Cecilie","Elberling, Bo"],"cuid":["S02-092.71-045444"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Arctic","Extreme weather","Herbivory","Snow fence"],"level":"sci","mra":["hum","sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-KUM"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-GV-KUM","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"arctic soil water chemistry in dry and wet tundra subject to snow addition summer warming and herbivory simulation","src":["ku","kum"],"src-code":["DI-GV-KUM","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85075507995","version":"Other Version"},"id":"S02-092.71-045444","identifier":[{"id":"85075507995","type":"scopus"}],"ids":["ku-b1f80c30-2bc8-4f8c-a4d7-4d8bf892f642","kum-0fe7a6dc-864d-4551-bba1-d0db554db113"],"keyword":["Arctic","Extreme weather","Gradual climate change","Herbivory","Snow fence","Soil water chemistry"],"lang":"English","level":"Scientific","mra":["Humanities","Science/Technology"],"noi":["Global-Local-2-5-CB84F500DED1683C96E74140C8955B8C"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Geosciences and Natural Resource Management, Geography","University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"kum ministry of culture archives museums and royal library denmark","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-KUM","l3nn":"KUM Ministry of Culture - Archives, Museums, and Royal Library Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KUM Ministry of Culture - Archives, Museums, and Royal Library Denmark","namevar":["Ministry of Culture Denmark, The National Museum of Denmark, Environmental Archaeology and Materials Science"],"nora_code":"DI-GV-KUM","used":1}],"person":[{"affno":"1","first":"Laura H.","key":"rasmussenpau","last":"Rasmussen","locid":"1d17b04f-b957-4a10-977e-3e525b9e3a2d","name":"Rasmussen, Laura Helene","name_org":"Rasmussen, Laura H.","rank":1,"rolecode":"pau"},{"affno":"1","first":"Anders","key":"michelsenpau","last":"Michelsen","locid":"5f62798d-50c6-41c3-8018-18babf5e5046","name":"Michelsen, Anders","orcid":"0000-0002-9541-8658","rank":2,"rolecode":"pau"},{"affno":"2 1","corresponding":null,"first":"Pernille","key":"ladegaardpedersenpau","last":"Ladegaard-Pedersen","locid":"e4e39353-1fc6-4919-af22-dc45fd5717b8","name":"Ladegaard-Pedersen, Pernille","orcid":"0000-0001-9056-3699","rank":3,"rolecode":"pau"},{"affno":"1","first":"Cecilie S.","key":"nielsenpau","last":"Nielsen","locid":"a8e5f0a6-9f43-4217-88cf-1273168a1d8b","name":"Nielsen, Cecilie Skov","name_org":"Nielsen, Cecilie S.","rank":4,"rolecode":"pau"},{"affno":"1","first":"Bo","key":"elberlingpau","last":"Elberling","locid":"e12e4d80-dea0-424d-82bf-4dc019f65547","name":"Elberling, Bo","orcid":"0000-0002-6023-885X","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.soilbio.2019.107676","issn":["00380717","18793428"],"issn_org":["00380717"],"journal":"Soil Biology & Biochemistry","paperid":"107676","status":"p","title":"Soil Biology & Biochemistry","title_org":"Soil Biology and Biochemistry","volume":"141"},"review":"Peer Reviewed","scoID":["2-s2.0-85075507995"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-b1f80c30-2bc8-4f8c-a4d7-4d8bf892f642","kum-0fe7a6dc-864d-4551-bba1-d0db554db113"],"src":["KU University of Copenhagen","KUM Ministry of Culture - Archives, Museums, and Royal Library Denmark"],"title":"Arctic soil water chemistry in dry and wet tundra subject to snow addition, summer warming and herbivory simulation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-092.71-045444","year":2020,"yearsub":2020}
{"abstract":"Background: During the recent decade presence of digital media, especially handheld devices, in everyday life, has been increasing. Survey data suggests that children and adults spend much of their leisure on screen media, including use of social media and video services. Despite much public debate on possible harmful effects of such behavioral shifts, evidence from rigorously conducted randomized controlled trials in free-living settings, investigating the efficacy of reducing screen media use on physical activity, sleep, and physiological stress, is still lacking. Therefore, a family and home-based randomized controlled trial-the SCREENS trial-is being conducted. Here we describe in detail the rationale and protocol of this study. Methods: The SCREENS pilot trial was conducted during the fall of 2018 and spring of 2019. Based on experiences from the pilot study, we developed a protocol for a parallel group randomized controlled trial. The trial is being conducted from May 2019 to ultimo 2020 in 95 families with children 4-14 years recruited from a population-based survey. As part of the intervention family members must handover most portable devices for a 2-week time frame, in exchange for classic mobile phones (not smartphones). Also, entertainment-based screen media use during leisure must be limited to no more than 3 hours/week/person. At baseline and follow-up, 7-day 24-h physical activity will be assessed using two triaxial accelerometers; one at the right hip and one the middle of the right thigh. Sleep duration will be assessed using a single channel EEG-based sleep monitor system. Also, to assess physiological stress (only assessed in adults), parameters of 24-h heart rate variability, the cortisol awakening response and diurnal cortisol slope will be quantified using data sampled over three consecutive days. During the study we will objectively monitor the families' screen media use via different software and hardware monitoring systems. Discussion: Using a rigorous study design with state-of-the-art methodology to assess outcomes and intervention compliance, analyses of data from the SCREENS trial will help answer important causal questions of leisure screen media habits and its short-term influence on physical activity, sleep, and other health related outcomes among children and adults. Trial registration: NCT04098913 at https://clinicaltrials.gov [20-09-2019, retrospectively registered].","author_count":8,"contributors":["Rasmussen, Martin Gillies Banke","Pedersen, Jesper","Olesen, Line Grønholt","Brage, Søren","Klakk, Heidi","Kristensen, Peter Lund","Brønd, Jan Christian","Grøntved, Anders"],"cuid":["S02-099.96-049522"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, Non-EU","OECD"],"corresponding_author":["Rasmussen, Martin Gillies Banke"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of Cambridge"],"keyword":["Effekt","Physical activity","Randomized Controlled Trial","Screen media use","Screen time","Sleep","Stress","children and youth","skærmtid"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U","DI-UC"],"level3":{"U":["DI-U-ALL","DI-U-SDU"],"UC":["DI-UC-ALL","DI-UC-UCL"]},"level3all":["DI-U-SDU","DI-UC-UCL"]},"review":"pr","rtype":["clu"],"sorti":"short term efficacy of reducing screen media use on physical activity sleep and physiological stress in families with children aged 000000000004 000000000014 study protocol for the screens randomized controlled trial","src":["sdu","ucl"],"src-code":["DI-U-SDU","DI-UC-UCL"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1186/s12889-020-8458-6","version":"Published Version"},"funding_acknowledgement":["A European Research Council Starting Grant (no. 716657) was the source of funding for the project. The funders had no role in the design of the study design, nor did they play a role in the collection, management, analysis, and interpretation of the data from the study. Nor did they have a role in the writing of the study protocol as well as in the decision to submit the report for publication in BMC Public Health."],"id":"S02-099.96-049522","identifier":[{"id":"PMC7092494","type":"pmcid"},{"id":"32293374","type":"pmid"},{"id":"85082193998","type":"scopus"}],"ids":["sdu-cde9b6f7-d311-44ec-be62-f8607cc18424","ucl-fdb2788a-3792-43da-a394-67c34e505770"],"keyword":["Physical activity","Randomized controlled trial","Screen time","Sleep","Stress","children and youth","effekt","reduction of screen media use","screen media use","skærmtid"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-1CA5707A91D0049790E65ABB531E1C50"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/168787758/s12889_020_8458_6.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1186/s12889-020-8458-6","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics, RICH - Research In Childhood Health","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics, Research Unit of Exercise Epidemiology"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"gb","key":"university of cambridge","loc":["United Kingdom","Europe, N