I-U-ALL","Hospitals","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-1e763658-bc3f-4fa7-aab5-0d4052722987","ku-d4060b94-07bc-4cd4-b346-635e37a19bd8"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"Forced fluid removal in intensive care patients with acute kidney injury : The randomised FFAKI feasibility trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-089.47-001535","year":"2018","yearsub":"2018"}
{"abstract":"Et skriveværksted for mennesker med kræft blev iværksat på Videncenter for Rehabilitering og Palliation – og efterfølgende evalueret. Alvorlig sygdom kan opleves som et forstyrrende brud på ens hidtidige livshistorie, skabe kaos og mangel på sprog til at udtrykke, hvordan man har det. Tankerne bag kreativ skrivning er, at det kan ses som en mulig vej til selverkendelse og som en mulig vej til at blive forstået af andre. Antagelsen er, at en sådan skabende aktivitet kan skabe et frirum for mennesker med kræft, når de oplever glæden ved at skrive, gå på opdagelse i ordenes og deres egen verden, samt finde nye former til fortællinger. Gennem en sådan proces åbnes mulighed for at skabe orden i kaos og dermed fremme den rehabilitering, som mennesker med alvorlig, livstruende sygdom er i gang med. Grundlæggende peger evalueringen på, at kreativ skrivning kan have et potentiale i forhold til at gøre en forskel for mennesker med kræft, som har lyst til at skrive.","author_count":3,"contributors":["Hansen, Helle Ploug","Rasmussen, Anders Juhl","Zwisler, Ann Dorthe Olsen"],"cuid":["S02-091.58-686318"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Narrativ medicin","Rehabilitering"],"level":"sci","mra":["hum","med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-U-KU","DI-U-SDU"]},"review":"nr","rtype":["clu"],"sorti":"skrivning som heling de første danske erfaringer med skrivning som del af rehabilitering","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.maanedsskriftet.dk/mpl/2018/276/12091/","version":"Other Version"},"id":"S02-091.58-686318","ids":["ku-cfe3cd98-1172-4351-902a-19c5e887bf86","sdu-846bb7f7-bdae-4143-875d-d78616abec00"],"keyword":["Narrativ medicin","Rehabilitering"],"lang":"Danish","level":"Scientific","mra":["Humanities","Medical Science"],"noi":["Local-1-2-7A1C514C96900FE5EB88B951786F8F9A"],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Public Health, Research Unit of General Pratice"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Humanities, Department of Nordic Studies and Linguistics"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Helle Ploug","key":"hansenpau","last":"Hansen","locid":"aff3454d-836b-44db-9a85-391f83361116","name":"Hansen, Helle Ploug","orcid":"0000-0002-5075-8739","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Anders Juhl","key":"rasmussenpau","last":"Rasmussen","locid":"6612df8e-d9f9-4004-b959-a9c30b0762a5","name":"Rasmussen, Anders Juhl","orcid":"0000-0001-7718-5208","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ann Dorthe Olsen","key":"zwislerpau","last":"Zwisler","locid":"6e2c85c0-d456-45f2-a017-7942ea7eb12a","name":"Zwisler, Ann Dorthe Olsen","orcid":"0000-0002-9241-2090","rank":3,"rolecode":"pau"}],"pub":{"issn":["13955217","19047002"],"issn_org":["19047002"],"issue":"5","journal":"Månedsskrift for Almen Praksis","pages":"359-366","publisher":"Maanedsskrift for Almen Praksis","status":"p","title":"Månedsskrift for Almen Praksis","volume":"96"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-cfe3cd98-1172-4351-902a-19c5e887bf86","sdu-846bb7f7-bdae-4143-875d-d78616abec00"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Skrivning som heling? : De første danske erfaringer med skrivning som del af rehabilitering","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-091.58-686318","year":"2018","yearsub":"2018"}
{"abstract":"High-fat diet (HFD) induces several changes to the pathways regulating energy homeostasis and changes the expression of the hepatic cytochrome p450 (Cyp) enzyme-system. Despite these pervious findings, it is still unclear how the effects of HFD and especially HFD in combination with treadmill running affect hepatic Cyp expression. In this study, we investigated the mRNA and protein expression of selected Cyp's in mice subjected to 16 weeks of HFD and treadmill running. To understand the regulatory mechanisms behind the exercise-induced reversion of the HFDinduced changes in Cyp expression, we used a model in which the exercise-induced myokine and known regulator of hepatic Cyp's, interleukin-6 (IL-6), were knocked out specifically in skeletal muscle. We found that HFD increased the mRNA expression of Cyp1a1 and Cyp4a10, and decreased the expression of Cyp2a4, Cyp2b10, Cyp2e1, and Cyp3a11. HFD in combination with treadmill running reversed the HFD increase in Cyp4a10 mRNA expression. In addition, we observed increased Cyp1a and Cyp3a protein expression as an effect of exercise, whereas Cyp2b expression was lowered as an effect of HFD. IL-6 effected the response in Cyp3a11 and Cyp1a expression. We observed no changes in the content of the aryl hydrocarbon receptor, constitutive androstane receptor, pregnane X receptor, or peroxisome proliferation activator receptor alpha. In conclusion, we show that both HFD and exercise in HFD-fed animals can regulate hepatic Cyp expression and that changes in Cyp3a in response to HFD and exercise are dependent on skeletal muscular IL-6.","author_count":5,"contributors":["G. Knudsen, Jakob","Bertholdt, Lærke","Gudiksen, Anders","Gerbal-Chaloin, Sabine","Rasmussen, Martin Krøyer"],"cuid":["S02-097.62-029701"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD"],"country":["France"],"glorg":["All Global Affiliations","Montpellier University","Universite de Montpellier"],"keyword":["Detoxification","Drug metabolism","Endurance training","IL 6","Nuclear receptors"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"skeletal muscle interleukin 000000000006 regulates hepatic cytochrome p000000000450 expression effects of 000000000016 week high fat diet and exercise","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85052648622","version":"Other Version"},"id":"S02-097.62-029701","identifier":[{"id":"85052648622","type":"scopus"},{"id":"000427020900030","type":"wos"},{"id":"29177473","type":"pmid"}],"ids":["au-eaead898-e003-4800-aea0-f6f1cb915097","ku-9cbfd191-6978-47cc-a9ea-5ae36950369a"],"keyword":["Detoxification","Drug metabolism","Endurance training","IL-6","Nuclear receptors"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-67EE81C2F4483E5D30ADACC7085B7ECC"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Biology, Molecular Integrative Physiology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"fr","key":"universite de montpellier","loc":["France","Europe, EU","OECD"],"name":"Universite de Montpellier","used":1},{"affno":"3","country":"fr","key":"montpellier university","loc":["France","Europe, EU","OECD"],"name":"Montpellier University","used":1},{"affno":"4","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Food Science, Department of Food Science - Differentiated & Biofunctional Foods"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","first":"Jakob Grunnet","key":"knudsenpau","last":"Knudsen","locid":"820c7a12-b0e8-45d5-b8f7-35af01f74d37","name":"Knudsen, Jakob G.","name_org":"Knudsen, Jakob Grunnet","rank":1,"rolecode":"pau"},{"affno":"1","first":"Lærke","key":"bertholdtpau","last":"Bertholdt","locid":"01cf8c34-badb-4ee1-a5a6-dfff9d76c85e","name":"Bertholdt, Lærke","orcid":"0000-0002-9059-5276","rank":2,"rolecode":"pau"},{"affno":"1","first":"Anders","key":"gudiksenpau","last":"Gudiksen","locid":"c606f51e-8e40-4c33-a459-45f96c93b102","name":"Gudiksen, Anders","rank":3,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Sabine","key":"gerbalchaloinpau","last":"Gerbal-Chaloin","name":"Gerbal-Chaloin, Sabine","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Martin Krøyer","key":"rasmussenpau","last":"Rasmussen","locid":"c5259478-eeef-4bbd-8dff-462bdefc04e3","name":"Rasmussen, Martin Krøyer","orcid":"0000-0002-1889-2874","rank":5,"rolecode":"pau"}],"pmid":["29177473"],"pub":{"doi":"10.1093/toxsci/kfx258","issn":["10960929","10966080"],"issn_org":["10966080"],"issue":"1","journal":"Toxicological Sciences","pages":"309-317","publisher":"Oxford University Press","status":"p","title":"Toxicological Sciences","volume":"162"},"review":"Peer Reviewed","scoID":["2-s2.0-85052648622"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-eaead898-e003-4800-aea0-f6f1cb915097","ku-9cbfd191-6978-47cc-a9ea-5ae36950369a"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Skeletal Muscle Interleukin-6 Regulates Hepatic Cytochrome P450 Expression: Effects of 16-Week High-Fat Diet and Exercise","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-097.62-029701","year":"2018","yearsub":"2018"}
{"abstract":"A family history of atrial fibrillation constitutes a substantial risk of developing the disease, however, the pathogenesis of this complex disease is poorly understood. We perform whole-exome sequencing on 24 families with at least three family members diagnosed with atrial fibrillation (AF) and find that titin-truncating variants (TTNtv) are significantly enriched in these patients (P = 1.76 × 10-6). This finding is replicated in an independent cohort of early-onset lone AF patients (n = 399; odds ratio = 36.8; P = 4.13 × 10-6). A CRISPR/Cas9 modified zebrafish carrying a truncating variant of titin is used to investigate TTNtv effect in atrial development. We observe compromised assembly of the sarcomere in both atria and ventricle, longer PR interval, and heterozygous adult zebrafish have a higher degree of fibrosis in the atria, indicating that TTNtv are important risk factors for AF. This aligns with the early onset of the disease and adds an important dimension to the understanding of the molecular predisposition for AF.","author_count":19,"contributors":["Ahlberg, Gustav","Refsgaard, Lena","Lundegaard, Pia R","Andreasen, Laura","Ranthe, Mattis F","Linscheid, Nora","Nielsen, Jonas B","Melbye, Mads","Haunsø, Stig","Sajadieh, Ahmad","Camp, Lu","Olesen, Søren-Peter","Rasmussen, Simon","Lundby, Alicia","Ellinor, Patrick T","Holst, Anders G","Svendsen, Jesper H","Olesen, Morten S"],"cuid":["S02-100.00-036370"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","OECD"],"corresponding_author":["Olesen, Morten S"],"country":["United States"],"glorg":["All Global Affiliations","Broad Institute","Massachusetts General Hospital","Stanford University"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-NP","DI-OT","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP"],"NP":["DI-NP-ALL","DI-NP-LUND"],"OT":["The Lundbeck Foundation Centre for Applied Medical Genomics in Personalized Disease Prediction, Prevention and Care, Copenhagen, 2200 N, Denmark."],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-NP-LUND","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"rare truncating variants in the sarcomeric protein titin associate with familial and early onset atrial fibrillation","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41467-018-06618-y","version":"Published Version"},"id":"S02-100.00-036370","identifier":[{"id":"PMC6193003","type":"pmcid"},{"id":"85055120704","type":"scopus"},{"id":"30333491","type":"pmid"}],"ids":["dtu-a61f6e59-b3ab-49af-9f9f-31287827e8d4","ku-11c0e0fb-9a7c-438f-8650-96436515dccc"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-15B987C41EA25030C2F384571BD58EFE"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/157789862/s41467_018_06618_y.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41467-018-06618-y","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/209551337/Rare_truncating_variants_in_the_sarcomeric_protein_titin_associate_with_familial_and_early_onset_atrial_fibrillation.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Biomedical Sciences"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital Herlev and Gentofte"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","country":"dk","key":"ssi statens serum institut","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-SSI","l3nn":"SSI Statens Serum Institut","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SSI Statens Serum Institut","namevar":["Statens Serum Institut"],"nora_code":"DI-GV-SSI","used":1},{"affno":"4","country":"us","key":"stanford university","loc":["United States","America, North","OECD"],"name":"Stanford University","used":1},{"affno":"5","country":"dk","key":"lundbeck foundation","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-LUND","l3nn":"Lundbeck Foundation","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Lundbeck Foundation","namevar":["Lundbeckfonden"],"nora_code":"DI-NP-LUND","used":1},{"affno":"6","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["The Lundbeck Foundation Centre for Applied Medical Genomics in Personalized Disease Prediction, Prevention and Care, Copenhagen, 2200 N, Denmark."],"nora_code":"DI-OT","used":1},{"affno":"7","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Bio and Health Informatics","Technical University of Denmark, Depa