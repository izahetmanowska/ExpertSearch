mas","name_org":"Klitgaard, Thomas L","orcid":"0000-0002-8781-1206","rank":2,"rolecode":"pau"},{"affno":"3 4","first":"Morten H.","key":"møllerpau","last":"Møller","locid":"9463b017-3c43-470d-b95b-cf3cba8a27d4","name":"Møller, Morten Hylander","name_org":"Møller, Morten H.","rank":3,"rolecode":"pau"},{"affno":"3 5","first":"Anders","key":"pernerpau","last":"Perner","locid":"8a389541-d529-4ee3-8364-66bfc85f77c9","name":"Perner, Anders","rank":4,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Kristin","key":"hofsøpau","last":"Hofsø","name":"Hofsø, Kristin","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Conni","key":"skrubbeltrangpau","last":"Skrubbeltrang","locid":"74663b05-4b0b-4638-89ad-a56ff2f2dde5","name":"Skrubbeltrang, Conni","orcid":"0000-0002-7478-8422","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hilde I","key":"flaattenpau","last":"Flaatten","name":"Flaatten, Hilde I","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Bodil S","key":"rasmussenpau","last":"Rasmussen","locid":"3162c449-94c3-4d28-8dbb-c134d6eb76e1","name":"Rasmussen, Bodil Steen","name_org":"Rasmussen, Bodil S","orcid":"0000-0003-2190-145X","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jon H","key":"laakepau","last":"Laake","name":"Laake, Jon H","rank":9,"rolecode":"pau"}],"pmid":["32157683"],"pub":{"doi":"10.1111/aas.13570","issn":["00015172"],"issue":"6","journal":"Acta Anaesthesiologica Scandinavica","pages":"857-860","publisher":"Blackwell Munksgaard","status":"p","title":"Acta Anaesthesiologica Scandinavica","volume":"64"},"review":"Peer Reviewed","scoID":["2-s2.0-85082025521"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Hospitals","Other Research","Universities","University of Copenhagen","collaboration for research in intensive care"],"PST":["Published"]},"sid":["aau-0b555617-d666-4bbd-8c5c-b0c74dc5c570","ku-824d69bb-43ce-43ab-a941-b217ff315b49"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"Spontaneous versus controlled mechanical ventilation in patients with acute respiratory distress syndrome - Protocol for a scoping review","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-083.67-000597","year":"2020","yearsub":"2020"}
{"abstract":"OBJECTIVES: The main study aim was to examine the applicability of a novel method to assess the criterion of values and preferences within the Grading of Recommendation, Assessment, Development and Evaluation evidence to decision framework. The group concept mapping (GCM) approach was applied to identify, organise and prioritise values and preferences in the example of health professionals' choice of analgesia for patients with acute trauma pain. SETTING: Prehospital and emergency care centres in the Nordic countries of Denmark, Norway, Sweden, Finland and Iceland. PARTICIPANTS: Acute care health professionals with qualifications to administer analgesic agents to patients in emergency and prehospital settings, including advanced ambulance assistants, rescue officers, paramedics, emergency physicians and emergency nurses, participated in an online survey in which statements were generated (n=40) and structured (n=11) and finally analysed and interpreted in a validation meeting (n=4). RESULTS: Using GCM, ideas were generated and structured through online participation. Results were interpreted at a validation meeting. In total, 111 unique ideas were identified and organised into seven clusters: drug profile, administration, context, health professionals' preferences and logistics, safety profile, patient's medical history and acute clinical situation. CONCLUSIONS: Based on GCM, a conceptual model was developed, and values and preferences around choice of analgesia in emergency care were revealed. Health professionals within acute care can apply the conceptual model to support their decision-making when choosing the best available treatment for pain for their patients in emergency care.","author_count":6,"contributors":["Nielsen, Kristina Tomra","Rasmussen, Marianne Uggen","Overgaard, Anders Foehrby","Klokker, Louise","Christensen, Robin","Wæhrens, Eva Elisabet Ejlersen"],"cuid":["S02-099.93-049080"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Acute pain","Analgesia","Conceptual model","Group Concept Mapping","Occupational Therapy","Preferences","Values"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U","DI-UC"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"],"UC":["DI-UC-ALL","DI-UC-UCN"]},"level3all":["DI-HO-CAP","DI-HO-SDR","DI-U-KU","DI-U-SDU","DI-UC-UCN"]},"review":"pr","rtype":["clu"],"sorti":"identifying values and preferences around the choice of analgesia for patients with acute trauma pain in emergency and prehospital settings using group concept mapping methodology","src":["sdu","ucn"],"src-code":["DI-U-SDU","DI-UC-UCN"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1136/bmjopen-2019-031863","version":"Published Version"},"id":"S02-099.93-049080","identifier":[{"id":"85081700150","type":"scopus"},{"id":"PMC7066635","type":"pmcid"},{"id":"32161154","type":"pmid"}],"ids":["sdu-6cab705a-9ee0-4fbb-bd51-d6ed8c5a6943","ucn-f657f1e0-1332-4996-9a29-8f293fe08311"],"keyword":["acute pain","analgesia","conceptual model","group concept mapping","occupational therapy","preferences","values"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-92F3B144D8A6C45C3D4EAEC43E32D44B"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1136/bmjopen-2019-031863","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/168598899/e031863.full.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"ucn university college of northern denmark","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-UCN","l3nl":"University College of Northern Denmark","l3nn":"UCN University 