ocid":"4b040c73-6b49-4e97-be60-5e34608e0615","name":"Albrechtsen, Anders","orcid":"0000-0001-7306-031X","rank":27,"rolecode":"pau"},{"affno":"3 4 5 6","first":"Love","key":"dalénlovepau","last":"Dalén","name":"Dalén, Love","rank":28,"rolecode":"pau"},{"affno":"1","first":"Rasmus","key":"hellerrasmuspau","last":"Heller","locid":"efbe80a4-e869-43e8-b962-989c40c79f93","name":"Heller, Rasmus","orcid":"0000-0001-6583-6923","rank":29,"rolecode":"pau"},{"affno":"1","first":"Ida","key":"moltkeidapau","last":"Moltke","locid":"9aab69f1-a07a-4a34-b844-9c7c61756cc5","name":"Moltke, Ida","orcid":"0000-0001-7052-8554","rank":30,"rolecode":"pau"},{"affno":"1","first":"Hans Redlef","key":"siegismundhansredlefpau","last":"Siegismund","locid":"a7a17541-9c18-46cd-822b-c8d82a24c1dc","name":"Siegismund, Hans Redlef","orcid":"0000-0001-5757-3131","rank":31,"rolecode":"pau"}],"pmid":["37971141"],"pub":{"doi":"10.1111/mec.17205","issn":["09621083","1365294X"],"issn_org":["09621083"],"issue":"2","journal":"Molecular Ecology","paperid":"e17205","publisher":"Wiley-Blackwell Publishing Ltd","status":"p","title":"Molecular Ecology","volume":"33"},"review":"Peer Reviewed","scoID":["2-s2.0-85176923803"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Region Zealand","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-b7ce4b55-54e5-4b24-a20e-98d6c2a603fd","ku-53fd9f10-5cf8-4754-99fd-734455e90975"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Population genomics of the muskox' resilience in the near absence of genetic variation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-742017","year":"2024","yearsub":"2024"}
{"abstract":"Background: With the development of immune checkpoint inhibitors for the treatment of non-small cell lung cancer, the need for new functional imaging techniques and early response assessments has increased to account for new response patterns and the high cost of treatment. The present study was designed to assess the prognostic impact of dynamic contrast-enhanced computed tomography (DCE-CT) on survival outcomes in non-small cell lung cancer patients treated with immune checkpoint inhibitors. Methods: Thirty-three patients with inoperable non-small-cell lung cancer treated with immune checkpoint inhibitors were prospectively enrolled for DCE-CT as part of their follow-up. A single target lesion at baseline and subsequent follow-up examinations were enclosed in the DCE-CT. Blood volume deconvolution (BVdecon), blood flow deconvolution (BFdecon), blood flow maximum slope (BFMax slope) and permeability were assessed using overall survival (OS) and progression-free survival (PFS) as endpoints in Kaplan Meier and Cox regression analyses. Results: High baseline Blood Volume (BVdecon) (> 12.97 ml × 100 g−1) was associated with a favorable OS (26.7 vs 7.9 months; p = 0.050) and PFS (14.6 vs 2.5 months; p = 0.050). At early follow-up on day seven a higher relative increase in BFdecon (> 24.50% for OS and > 12.04% for PFS) was associated with an unfavorable OS (8.7 months vs 23.1 months; p < 0.025) and PFS (2.5 vs 13.7 months; p < 0.018). The relative change in BFdecon (categorical) on day seven was a predictor of OS (HR 0.26, CI95: 0.06 to 0.93 p = 0.039) and PFS (HR 0.27, CI95: 0.09 to 0.85 p = 0.026). Conclusion: DCE-CT-identified parameters may serve as potential prognostic biomarkers at baseline and during early treatment in patients with NSCLC treated with immune checkpoint inhibitor therapy.","author_count":7,"contributors":["Andersen, Michael Brun","Drljevic-Nielsen, Aska","Ehlers, Jeanette Haar","Thorup, Kennet","Baandrup, Anders Ohlhues","Palne, Majbritt","Rasmussen, Finn"],"cuid":["S02-100.00-756120"],"filters":{"added":"2024-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Andersen, Michael Brun"],"keyword":["Carcinoma","Clinical oncology","Immunotherapy","Non small cell lung","Spiral computed","Thorax","Tomography"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-ZEA"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-ZEA","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"dce ct parameters as new functional imaging biomarkers at baseline and during immune checkpoint inhibitor therapy in patients with lung cancer a feasibility study","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s40644-024-00745-0","version":"Published Version"},"id":"S02-100.00-756120","identifier":[{"id":"39135095","type":"pmid"},{"id":"PMC11320886","type":"pmcid"},{"id":"85201252643","type":"scopus"}],"ids":["au-eab2c16f-e2ac-4611-b8b0-fc5a32744f5f","ku-491cd8cd-fdcf-4ba5-b3fd-d610f8a3ef22"],"keyword":["Carcinoma","Clinical oncology","Immunotherapy","Non-small-cell lung","Spiral computed","Thorax","Tomography"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-2B84BD2A9379F9E7889A6C14709DF7D1"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/402750817/s40644_024_00745_0.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s40644-024-00745-0","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Radiology"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Herlev and Gentofte Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Zealand University Hospital"],"nora_code":"DI-HO-ZEA","used":1},{"affno":"4","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Radiology"],"nora_code":"DI-U-KU","used":1},{"affno":"5","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1}],"person":[{"affno":"1 2 3 4 5","corresponding":null,"country":"dk","first":"Michael Brun","key":"andersenpau","last":"Andersen","locid":"f1d3f9b4-8b12-4c15-b083-e46d121b1d6d","name":"Andersen, Michael Brun","rank":1,"rolecode":"pau"},{"affno":"1 5","corresponding":null,"first":"Aska","key":"drljevicnielsenpau","last":"Drljevic-Nielsen","locid":"10a1cade-abdc-4a12-821b-9c94f3f7ddfd","name":"Drljevic-Nielsen, Aska","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jeanette Haar","key":"ehlerspau","last":"Ehlers","name":"Ehlers, Jeanette Haar","rank":3,"rolecode":"pau"},{"affno":"1 5","corresponding":null,"first":"Kennet Sønderstgaard","key":"thoruppau","last":"Thorup","locid":"553c96cd-3b3e-4721-9d18-1be53da825dc","name":"Thorup, Kennet","name_org":"Thorup, Kennet Sønderstgaard","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Anders Ohlhues","key":"baandruppau","last":"Baandrup","name":"Baandrup, Anders Ohlhues","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Majbritt","key":"palnepau","last":"Palne","name":"Palne, Majbritt","rank":6,"rolecode":"pau"},{"affno":"1 5","corresponding":null,"first":"Finn","key":"rasmussenpau","last":"Rasmussen","locid":"1c4dadf5-d001-4c6c-9f23-347af298c53d","name":"Rasmussen, Finn","rank":7,"rolecode":"pau"}],"pmid":["39135095"],"pub":{"doi":"10.1186/s40644-024-00745-0","issn":["14707330"],"issn_org":["17405025"],"issue":"1","journal":"Cancer Imaging","paperid":"105","publisher":"BioMed Central","status":"p","title":"Cancer Imaging","volume":"24"},"review":"Peer Reviewed","scoID":["2-s2.0-85201252643"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region Zealand","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-eab2c16f-e2ac-4611-b8b0-fc5a32744f5f","ku-491cd8cd-fdcf-4ba5-b3fd-d610f8a3ef22"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"DCE-CT parameters as new functional imaging biomarkers at baseline and during immune checkpoint inhibitor therapy in patients with lung cancer – a feasibility study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-756120","year":"2024","yearsub":"2024"}
{"abstract":"BACKGROUND: The Handling Oxygenation Targets in the Intensive Care Unit (HOT-ICU) trial was a multicentre, randomised, parallel-group trial of a lower oxygenation target (arterial partial pressure of oxygen [PaO2 ] = 8 kPa) versus a higher oxygenation target (PaO2  = 12 kPa) in adult ICU patients with acute hypoxaemic respiratory failure; the Handling Oxygenation Targets in coronavirus disease 2019 (HOT-COVID) tested the same oxygenation targets in patients with confirmed COVID-19. In this study, we aim to evaluate the long-term effects of these oxygenation targets on cognitive and pulmonary function. We hypothesise that a lower oxygenation target throughout the ICU stay may result in cognitive impairment, whereas a higher oxygenation target may result in impaired pulmonary function. METHODS: This is the updated protocol and statistical analysis plan of two pre-planned secondary outcomes, the long-term cognitive function, and long-term pulmonary function, in the HOT-ICU and HOT-COVID trials. Patients enrolled in both trials at selected Danish sites and surviving to 1 year after randomisation are eligible to participate. A Repeatable Battery for the Assessment of Neuropsychological Status score and a full-body plethysmography, including diffusion capacity for carbon monoxide, will be obtained. The last patient is expected to be included in the spring of 2024. CONCLUSION: This study will provide important information on the long-term effects of a lower versus a higher oxygenation target on long-term cognitive and pulmonary functions in adult ICU patients with acute hypoxaemic respiratory failure.","author_count":11,"contributors":["Crescioli, Elena","Riis, Jens Østergaard","Weinreich, Ulla Møller","Jensen, Jens Ulrik Staehr","Poulsen, Lone Musaeus","Brøchner, Anne Craveiro","Lange, Theis","Perner, Anders","Lass Klitgaard, Thomas","Schjørring, Olav Lilleholt","Rasmussen, Bodil Steen"],"cuid":["S03-093.29-735042"],"filters":{"added":"2024-05","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"corresponding_author":["Crescioli, Elena"],"keyword":["Adult","Clinical trial","Covid 19","Critical care outcomes","Humans","ICU","Intensive Care Units","Lung","Multicenter Studies as Topic","Oxygen Inhalation Therapy","Randomized Controlled Trials as Topic","Respiratory Insufficiency","SARS CoV 2"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-NDR","DI-HO-ZEA"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-NDR","DI-HO-ZEA","DI-U-AAU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"long term cognitive and pulmonary functions following a lower versus a higher oxygenation target in the hot icu and hot covid trials a protocol update","src":["aau","ku","sdu"],"src-code":["DI-U-AAU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1111/aas.14379","version":"Published Version"},"funding_acknowledgement":["This study is funded by the Novo Nordisk Foundation (NNF18OC0034614) and the Danish Ministry of Higher Education and Research (0238‐00004B), who had no influence on study design, scientific content of the protocol, trial conduct, data collection or analysis, interpretation of the results, or on the final publication."],"id":"S03-093.29-735042","identifier":[{"id":"85183606162","type":"scopus"},{"id":"38272985","type":"pmid"}],"ids":["aau-e2655c62-4165-46f3-a75a-88177acbde81","ku-99d2768d-1349-49b9-b31a-8b8177eddf6c","sdu-3feab66c-250d-4afd-89f5-113e1f1ed2a2"],"keyword":["Adult","COVID-19","Humans","ICU","Intensive Care Units","Lung","Multicenter Studies as Topic","Randomized Controlled Trials as Topic","Respiratory Insufficiency","SARS-CoV-2","clinical trial","critical care outcomes","oxygen inhalation therapy"],"lang":"English"