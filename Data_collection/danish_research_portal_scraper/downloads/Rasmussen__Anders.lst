agen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KP University College Copenhagen","namevar":["University College Copenhagen (KP)"],"nora_code":"DI-UC-KP","used":1}],"person":[{"affno":"1","first":"Beckey","key":"trinhpau","last":"Trinh","name":"Trinh, Beckey","rank":1,"rolecode":"pau"},{"affno":"1","first":"Anders","key":"rasmussenrinnovpau","last":"Rasmussen Rinnov","name":"Rasmussen Rinnov, Anders","rank":2,"rolecode":"pau"},{"affno":"2 1","first":"Ulrik","key":"winningiepsenpau","last":"Winning Iepsen","locid":"933b0356-2601-4bfa-9eec-da6ba94be322","name":"Iepsen, Ulrik Winning","name_org":"Winning Iepsen, Ulrik","orcid":"0000-0002-8140-2583","rank":3,"rolecode":"pau"},{"affno":"1","first":"Gregers","key":"windingmunchpau","last":"Winding Munch","name":"Winding Munch, Gregers","rank":4,"rolecode":"pau"},{"affno":"1","first":"Kamilla","key":"munchwindingpau","last":"Munch Winding","name":"Munch Winding, Kamilla","rank":5,"rolecode":"pau"},{"affno":"1 3","first":"Carsten","key":"lauridsenpau","last":"Lauridsen","name":"Lauridsen, Carsten","rank":6,"rolecode":"pau"},{"affno":"1 2","first":"Lise Lotte","key":"gluudpau","last":"Gluud","locid":"5f316a6f-fef0-44ac-ad8d-522731684721","name":"Gluud, Lise Lotte","rank":7,"rolecode":"pau"},{"affno":"1 2","first":"Gerrit","key":"vanhallpau","last":"van Hall","locid":"55a9b111-6dbb-4a42-a9ab-d5f3785fbdae","name":"van Hall, Gerrit","orcid":"0000-0002-2519-8127","rank":8,"rolecode":"pau"},{"affno":"1","first":"Helga","key":"ellingsgaardpau","last":"Ellingsgaard","name":"Ellingsgaard, Helga","rank":9,"rolecode":"pau"}],"pmid":["38479917"],"pub":{"doi":"10.1016/j.clnesp.2024.02.013","issn":["24054577"],"journal":"Clinical Nutrition ESPEN","pages":"240-246","status":"p","title":"Clinical Nutrition ESPEN","volume":"60"},"review":"Peer Reviewed","scoID":["2-s2.0-85186242972"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","All University Colleges","Capital Region of Denmark","DI-ALL","DI-H