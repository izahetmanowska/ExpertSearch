pau"},{"affno":"1","first":"Morten Tønsberg","key":"limborgpau","last":"Limborg","locid":"e0cb3d32-1c00-4ec6-a083-d1d14862135b","name":"Limborg, Morten T.","name_org":"Limborg, Morten Tønsberg","orcid":"0000-0002-7718-6531","rank":10,"rolecode":"pau"}],"pmid":["35094708"],"pub":{"doi":"10.1186/s40168-021-01221-8","issn":["20492618"],"journal":"Microbiome","paperid":"21","publisher":"BioMed Central","status":"p","title":"Microbiome","volume":"10"},"review":"Peer Reviewed","scoID":["2-s2.0-85123904867"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Governmental Institutions","All Miscellaneous","All Private Research","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-OT","DI-OT-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Governmental Institutions","Miscellaneous","Other Companies","Other Research","Private Research","Universities","University of Copenhagen","biomar a/s (biz)"],"PST":["Published"]},"sid":["au-833d23bd-cc48-4e4a-a9c5-d0dc07d6a5b6","ku-812a9d53-2749-4877-9881-a09494ad8587"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"A multi-omics approach unravels metagenomic and metabolic alterations of a probiotic and synbiotic additive in rainbow trout (Oncorhynchus mykiss)","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-022248","year":"2022","yearsub":"2022"}
{"abstract":"In late 2021, the Omicron SARS-CoV-2 variant overtook the previously dominant Delta variant, but the extent to which this transition was driven by immune evasion or a change in the inherent transmissibility is currently unclear. We estimate SARS-CoV-2 transmission within Danish households during December 2021. Among 26,675 households (8,568 with the Omicron VOC), we identified 14,140 secondary infections within a 1-7-day follow-up period. The secondary attack rate was 29% and 21% in households infected with Omicron and Delta, respectively. For Omicron, the odds of infection were 1.10 (95%-CI: 1.00-1.21) times higher for unvaccinated, 2.38 (95%-CI: 2.23-2.54) times higher for fully vaccinated and 3.20 (95%-CI: 2.67-3.83) times higher for booster-vaccinated contacts compared to Delta. We conclude that the transition from Delta to Omicron VOC was primarily driven by immune evasiveness and to a lesser extent an inherent increase in the basic transmissibility of the Omicron variant.","author_count":19,"contributors":["Lyngse, Frederik Plesner","Mortensen, Laust Hvas","Denwood, Matt","Christiansen, Lasse Engbo","Møller, Camilla Holten","Skov, Robert Leo","Spiess, Katja","Fomsgaard, Anders","Lassaunière, Ria","Rasmussen, Morten","Stegger, Marc","Nielsen, Claus","Sieber, Raphael Niklaus","Cohen, Arieh Sierra","Møller, Frederik Trier","Overvad, Maria","Mølbak, Kåre","Krause, Tyra Grove","Kirkeby, Carsten"],"cuid":["S02-100.00-032627"],"filters":{"added":"2022-11","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Lyngse, Frederik Plesner"],"level":"sci","mra":["sci","soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-GV-SSI","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"household transmission of the sars cov 000000000002 omicron variant in denmark","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41467-022-33328-3","version":"Published Version"},"funding_acknowledgement":["The authors thank Statens Serum Institut and The Danish Health Data Authority for collecting and providing access to data access. We also thank the rest of the Expert Group for Mathematical Modelling of COVID-19 at Statens Serum Institut for helpful discussions. We thank the Danish Covid-19 Genome Consortium for genotyping SARS-CoV-2 positive samples. We thank Samir Bhatt for helpful comments. We thank Carl Benjamin Simpson (Department of Economics, University of Copenhagen) for proofreading the manuscript. Frederik Plesner Lyngse is supported in part by grants from Independent Research Fund Denmark (Grant no. 9061-00035B); Novo Nordisk Foundation (grant no. NNF17OC0026542); the Danish National Research Foundation through its grant (DNRF-134) to the Center for Economic Behavior and Inequality (CEBI) at the University of Copenhagen. Laust Hvas Mortensen is supported in part by grants from the Novo Nordisk Foundation (grant no. NNF17OC0027594, NNF17OC0027812). Matthew Denwood, Lasse Christiansen, and Carsten Kirkeby receive funding from Statens Serum Institut as part of the Expert Group for Mathematical Modelling of COVID-19. The authors thank Statens Serum Institut and The Danish Health Data Authority for collecting and providing access to data access. We also thank the rest of the Expert Group for Mathematical Modelling of COVID-19 at Statens Serum Institut for helpful discussions. We thank the Danish Covid-19 Genome Consortium for genotyping SARS-CoV-2 positive samples. We thank Samir Bhatt for helpful comments. We thank Carl Benjamin Simpson (Department of Economics, University of Copenhagen) for proofreading the manuscript. Frederik Plesner Lyngse is supported in part by grants from Independent Research Fund Denmark (Grant no. 9061-00035B); Novo Nordisk Foundation (grant no. NNF17OC0026542); the Danish National Research Foundation through its grant (DNRF-134) to the Center for Economic Behavior and Inequality (CEBI) at the University of Copenhagen. Laust Hvas Mortensen is supported in part by grants from the Novo Nordisk Foundation (grant no. NNF17OC0027594, NNF17OC0027812). Matthew Denwood, Lasse Christiansen, and Carsten Kirkeby receive funding from Statens Serum Institut as part of the Expert Group for Mathematical Modelling of COVID-19."],"id":"S02-100.00-032627","identifier":[{"id":"PMC9508106","type":"pmcid"},{"id":"85138459679","type":"scopus"},{"id":"36151099","type":"pmid"}],"ids":["dtu-029eedf1-af21-43a8-95b2-4f09829600a4","ku-861bcc84-665d-4bf7-9ba2-ce0acefb7e47"],"lang":"English","level":"Scientific","mra":["Science/Technology","Social Science"],"noi":["Global-Local-2-5-5F731BB67705CCB8B05C7F4C83EFD0CD"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/320489175/s41467_022_33328_3.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/296743672/s41467_022_33328_3.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41467-022-33328-3","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Social Sciences, Department of Economics, Department of Economics"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Techn