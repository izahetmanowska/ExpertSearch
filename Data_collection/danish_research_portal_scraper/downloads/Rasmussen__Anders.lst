locid":"09d94078-676a-42ee-91c2-eb8ba8df356b","name":"Korshoej, Anders Rosendal","orcid":"0000-0003-4285-8171","rank":13,"rolecode":"pau"}],"pub":{"doi":"10.1101/2023.07.08.23292286","publisher":"medRxiv","status":"p"},"review":"Undetermined","search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-832902dd-7576-430e-9728-080a6baa65b9"],"src":["AU Aarhus University"],"title":"Safety, harm, and efficacy of IRRAflow® versus external ventricular drainage for intraventricular hemorrhage: A randomized clinical trial","type":"Preprint","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-708314","year":"2023","yearsub":"2023"}
