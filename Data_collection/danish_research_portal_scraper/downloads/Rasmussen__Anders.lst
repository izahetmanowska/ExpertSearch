d Bones","Canada","Canada North America Nearctic region","DNA Mitochondrial","Diversity","Dorset","Gene flow","Genetics","Genome Human","Genome sequence","Geographical distribution","Greenland","Greenland Nearctic region","Hair","History Ancient","Human Geography","Human migration","Humans","Inuits","Molecular Sequence Data","Multidisciplinary","Online","Paleobiology","Population Studies","Population genetics","Population history","Research articles","Siberia","Survivors","Tooth","eskimo","mtDNA variation","species migration"],"level":"sci","mra":["hum","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-OT","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-KUM"],"OT":["Bioinformatics Centre, Department of Biology, University of Copenhagen,"],"U":["DI-U-ALL","DI-U-AU","DI-U-DTU","DI-U-KU"]},"level3all":["DI-GV-KUM","DI-U-AU","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the genetic prehistory of the new world arctic","src":["au","dtu","ku","kum"],"src-code":["DI-GV-KUM","DI-U-AU","DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1126/science.1255832","version":"Other Version"},"id":"S04-099.56-681400","identifier":[{"id":"25170159","type":"pmid"},{"id":"84907279761","type":"scopus"}],"ids":["au-90da0e65-f29d-4864-b83a-56ec380d51a2","dtu-38d35f0c-2808-47f3-9dec-b83ad4698276","ku-c6a175c9-3a8e-4a89-a259-b47e82b49111","kum-4d492f36-ee87-4f17-809a-6d32a919ea02"],"keyword":["03506, Genetics - Animal","03508, Genetics - Human","03509, Genetics - Population genetics","05000, Physical anthropology and ethnobiology","10062, Biochemistry studies - Nucleic acids, purines and pyrimidines","62520, Chordata: general and systematic - Mammalia","63000, Paleozoology","64500, Paleobiology","ADMIXTURE","AMERICA","Alaska","Alaska USA, North America Nearctic region","Aleutian Islands North Pacific Pacific Ocean","Anthropology","Arctic Ocean Arctic Ocean","Arctic Re