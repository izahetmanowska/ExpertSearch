"key":"rossingpau","last":"Rossing","name":"Rossing, Kasper","rank":17,"rolecode":"pau"},{"affno":"3 1","first":"Lars","key":"køberpau","last":"Køber","locid":"e3f0c57c-605a-431a-9c63-2213c46621e6","name":"Køber, Lars","rank":18,"rolecode":"pau"},{"affno":"3 1","first":"Finn","key":"gustafssonpau","last":"Gustafsson","locid":"6716eef1-891b-4209-a823-e96e765b9433","name":"Gustafsson, Finn","rank":19,"rolecode":"pau"},{"affno":"1","first":"Jens Jakob","key":"thunepau","last":"Thune","name":"Thune, Jens Jakob","rank":20,"rolecode":"pau"}],"pmid":["38245015"],"pub":{"doi":"10.1136/bmjopen-2023-078155","issn":["20446055"],"issue":"1","journal":"BMJ Open","paperid":"e078155","publisher":"BMJ Publishing Group","status":"p","title":"BMJ Open","volume":"14"},"review":"Peer Reviewed","scoID":["2-s2.0-85182851760"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-6a56e853-e78a-42de-9608-6f4a85f6c78c","au-dfd33bc4-8359-4bcf-9ea0-29552c7a687a","ku-be984a11-58ed-46a7-8aaf-e5b85f7c2bcf","sdu-45e876b4-de18-4496-b6ae-e7df1acc4424"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Thoracentesis to alleviate pleural effusion in acute heart failure : Study protocol for the multicentre, open-label, randomised controlled TAP-IT trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-099.95-724182","year":"2024","yearsub":"2024"}
{"abstract":"The Environment & Oil Spill Response tool (EOS), supports oil spill response planning and decision making. This tool is developed on a research basis, and is an index based, generic and open-source analytic tool, which environmentally can optimise the choice of oil spill response methods for a given spill situation and for a given sea area with respect to environment and nature. The tool is not linked to a particular oil spill simulation model, although it is recommended using oil spill simulation models to have detailed data available for the analysis. The EOS tool consists of an Excel workbook with formulas for calculations and scores followed by screening through decision trees. As case for the EOS tool proof-of-concept, the area of Store Hellefiskebanke, West Greenland, is used. The tool can be downloaded from the Aarhus University home page as a free-of-charge application and is accompanied by a handbook for guidance.","author_count":10,"contributors":["Wegeberg, Susse","Fritt-Rasmussen, Janne","Gustavson, Kim","Lilover, Madis-Jaak","Boertmann, David","Christensen, Tom","Johansen, Kasper Lambert","Clausen, Daniel Spelling","Riget, Frank Farsø","Mosbech, Anders"],"cuid":["S01-000.00-709395"],"filters":{"added":"2024-02","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"corresponding_author":["Wegeberg, Susse"],"country":["Estonia"],"glorg":["All Global Affiliations","Tallinn University of Technology"],"keyword":["Contingency planning","Decision tree","Environmental assessment","Interactive"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"eos environment amp oil spill response an analytic tool for environmental assessments to support oil spill response planning framework principles and proof of concept by an arctic example","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.marpolbul.2023.115948","version":"Published Version"},"id":"S01-000.00-709395","identifier":[{"id":"85180529245","type":"scopus"},{"id":"38141583","type":"pmid"}],"ids":["au-d5ea7d05-d5ba-4b23-82c6-ae0c033dbcfa"],"keyword":["Analytic tool","Contingency planning","Decision tree","Environmental assessment","Interactive","Marine oil spill response"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-B982ACE7EA18B785D4D4924A721D12AC"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.marpolbul.2023.115948","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.au.dk/ws/files/378855668/1-s2.0-S0025326X23013838-main.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Ecoscience, Department of Ecoscience - Arctic Environment"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"ee","key":"tallinn university of technology","loc":["Estonia","Europe, EU","OECD"],"name":"Tallinn University of Technology","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Susse","key":"wegebergpau","last":"Wegeberg","locid":"05370847-e1d3-4253-b818-046251260ff5","name":"Wegeberg, Susse","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Janne","key":"frittrasmussenpau","last":"Fritt-Rasmussen","locid":"ee0f4272-d879-4350-9617-affc0cc83535","name":"Fritt-Rasmussen, Janne","orcid":"0000-0002-6496-8032","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kim","key":"gustavsonpau","last":"Gustavson"