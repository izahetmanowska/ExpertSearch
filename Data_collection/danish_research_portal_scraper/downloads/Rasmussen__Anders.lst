,"country":"us","key":"the university of akron","loc":["United States","America, North","OECD"],"name":"The University of Akron","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Michael","key":"jdoumapau","last":"J. Douma","name":"J. Douma, Michael","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Anders Bo","key":"rasmussenpau","last":"Rasmussen","locid":"f284f3a3-297f-4882-81e1-b591c41ead80","name":"Rasmussen, Anders Bo","orcid":"0000-0001-9817-9595","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Robert O.","key":"faithpau","last":"Faith","name":"Faith, Robert O.","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.5406/jamerethnhist.38.3.0076","issn":["02785927","19364695"],"issn_org":["02785927"],"issue":"3","journal":"Journal of American Ethnic History","pages":"76-10","publisher":"University of Illinois Press","status":"p","title":"Journal of American Ethnic History","volume":"38"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-2f968732-e284-436e-a9d9-f9002886cf73"],"src":["SDU University of Southern Denmark"],"title":"The Impressment of Foreign-born Soldiers in the Union Army","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-586822","year":"2019","yearsub":"2019"}
{"abstract":"AIM: To test the hypothesis that improvements in gait and function following individualized interdisciplinary interventions consisting of physical therapy, orthotics, spasticity management, and orthopaedic surgery using instrumented gait analysis are superior to 'usual care' in children with cerebral palsy (CP). METHOD: This was a prospective, single-blind, parallel-group, randomized controlled trial investigating the effectiveness of interventions based on the use of gait analysis. Primary outcome was gait (Gait Deviation Index) and secondary outcomes were walking and patient-reported outcome measures of function, disability, and health-related quality of life. Follow-ups were done at 26 weeks (questionnaires) and at the primary end point of 52 weeks (all outcomes). RESULTS: Sixty participants with CP (39 males, 21 females, mean age 6y 10mo, standard deviation 1y 3mo, range 5y-9y 1mo) in Gross Motor Function Classification System levels I or II, were randomized to interventions with or without gait analysis. No significant or clinically relevant between-group differences in change scores of the primary or secondary outcomes were found. The recommended categories of interventions were dominated by non-surgical interventions and were applied in 36% to 86% of the participants. INTERPRETATION: Interventions using gait analysis were not superior to 'usual care' on gait, walking, or patient-reported outcomes in a sample of relatively young and independently walking children with CP not expected to need surgery. WHAT THIS PAPER ADDS: Gait analysis in children with cerebral palsy in Gross Motor Function Classification System levels I or II recommends interdisciplinary interventions. Compliance to interventions recommended after gait analysis was low. No statistically significant advantages were identified for the intervention group versus the control group.","author_count":8,"contributors":["Rasmussen, Helle Mätzke","Pedersen, Niels Wisbech","Overgaard, Søren","Hansen, Lars Kjærsgaard","Dunkhase-Heinl, Ulrike","Petkov, Yanko","Engell, Vilhelm","Holsgaard-Larsen, Anders"],"cuid":["S01-000.00-589333"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Rasmussen, Helle Mätzke"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"gait analysis for individually tailored interdisciplinary interventions in children with cerebral palsy a randomized controlled trial","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/170735845/dmcn.14178.pdf","version":"Authors Final Version"},"id":"S01-000.00-589333","identifier":[{"id":"85061429753","type":"scopus"},{"id":"30740658","type":"pmid"}],"ids":["sdu-38722a21-166f-41bf-b742-e6724be6cca4"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-D870B5115C900CF999D1970075DD30AE"],"oa_link":[{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/170735845/dmcn.14178.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of orthopaedic surgery (Odense)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Helle M","key":"rasmussenpau","last":"Rasmussen","locid":"fc740e3e-3a84-4904-bd04-4db023a123db","name":"Rasmussen, Helle Mätzke","name_org":"Rasmussen, Helle M","orcid":"0000-0002-7522-8144","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Niels W","key":"pedersenpau","last":"Pedersen","locid":"ed21518f-c0c3-4e67-9b9e-fd9f355c6612","name":"Pedersen, Niels Wisbech","name_org":"Pedersen, Niels W","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren","key":"overgaardpau","last":"Overgaard","locid":"b394ea8b-39e4-46bc-8651-f6321e37c2eb","name":"Overgaard, Søren","orcid":"0000-0001-6829-4787","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars K","key":"hansenpau","last":"Hansen","locid":"79b933b7-6119-448d-9632-9789032b4ab5","name":"Hansen, Lars Kjærsgaard","name_org":"Hansen, Lars K","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ulrike","key":"dunkhaseheinlpau","last":"Dunkhase-Heinl","locid":"462898ec-4b19-4b5e-8c8d-e817c76b641f","name":"Dunkhase-Heinl, Ulrike","orcid":"0000-0002-3712-8871","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yanko","key":"petkovpau","last":"Petkov","locid":"2fa45fb4-c1d5-42bd-aaf4-0725100b3d8f","name":"Petkov, Yanko","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Vilhelm","key":"engellpau","last":"Engell","locid":"d0f62d00-d46d-426b-8f33-2c5098aac9ee","name":"Engell, Vilhelm","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anders","key":"holsgaardlarsenpau","last":"Holsgaard-Larsen","locid":"3c1cf5a4-81b1-49f3-ad79-d086b74b1561","name":"Holsgaard-Larsen, Anders","orcid":"0000-0003-4106-6930","rank":8,"rolecode":"pau"}],"pmid":["30740658"],"pub":{"doi":"10.1111/dmcn.14178","issn":["00121622","04190238"],"issn_org":["00121622"],"issue":"10","journal":"Developmental Medicine and Child Neurology","pages":"1189-1195","publisher":"Wiley","status":"p","title":"Developmental Medicine and Child Neurology","volume":"61"},"review":"Peer Reviewed","scoID":["2-s2.0-85061429753"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-38722a21-166f-41bf-b742-e6724be6cca4"],"src":["SDU University of Southern Denmark"],"title":"Gait analysis for individually tailored interdisciplinary interventions in children with cerebral palsy : a randomized controlled trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-589333","year":"2019","yearsub":"2019"}
{"abstract":"The University of Southern Denmark has introduced a mandatory course in Narrative Medicine into the curriculum of undergraduate medical students. It is part of a trajectory called ‘Human First’, which aims to improve the students’ empathic abilities by teaching them narrative competencies to draw on in their future clinical encounters as medical doctors. Although, theoretical accounts seem to make a strong case for the utility and value of educational interventions, such as courses in narrative medicine or medical humanities, there has been a lack of empirical studies providing evidence to support such accounts – especially those focusing on the long-term effects and impact on patient care. Our systematic literature search and review of empirical studies regarding the effects of teaching close reading of fictional texts and creative writing to medical and health care students, tentatively confirmed previous indications of positive effects. Larger, multi-site and more rigorous studies that assess the long-term impacts of these educational interventions and adjust for local variations are, however, still in short supply. Finally, we present critical reflections on whether empathy and similar phenomena are at all measurable and discuss the possibility of meaningfully evaluating the utility of curricular interventions such as narrative medicine courses.","author_count":4,"contributors":["Hansen, Helle Ploug","Laursen, Sara Seerup","Zwisler, Ann Dorthe Olsen","Rasmussen, Anders Juhl"],"cuid":["S01-000.00-627154"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Hansen, Helle Ploug"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"i m sure that there is something healing in the writing process creative writing workshops for people with a cancer disease","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.7146/tfss.v16i31.116963","version":"Published Version"},"id":"S01-000.00-627154","ids":["sdu-bc335e87-f6f0-4b68-b484-ac058ee4fcc5"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-2-039F690F541FABECFBB739C20E3FF6E7"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.7146/tfss.v16i31.116963","version":"Published Version"},{"access":"oa","type":"rem","url":"https://tidsskrift.dk/sygdomogsamfund/article/download/116963/165032/","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Public Health, Research Unit of General Pratice"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Helle Ploug","key":"hansenpau","last":"Hansen","locid":"aff3454d-836b-44db-9a85-391f83361116","name":"Hansen, Helle Ploug","orcid":"0000-0002-5075-8739","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sara Seerup","key":"laursenpau","last":"Laursen","locid":"96243215-7e29-4653-bef7-bc421ab3e8e7","name":"Laursen, Sara Seerup","orcid":"0000-0003-2397-2139","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ann Dorthe Olsen","key":"zwislerpau","last":"Zwisler","locid":"6e2c85c0-d456-45f2-a017-7942ea7eb12a","name":"Zwisler, Ann Dorthe Olsen","orcid":"0000-0002-9241-2090","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders Juhl","key":"rasmussenpau","last":"Rasmussen","locid":"6612df8e-d9f9-4004-b959-a9c30b0762a5","name":"Rasmussen, Anders Juhl","orcid":"0000-0001-7718-5208","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.7146/tfss.v16i31.116963","issn":["16043405"],"issue":"31","journal":"Tidsskrift for Forskning i Sygdom og Samfund","pages":"167-185","publisher":"Medicinsk Antropologisk Forum","status":"p","title":"Tidsskrift for Forskning i Sygdom og Samfund","volume":"16"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-bc335e87-f6f0-4b68-b484-ac058ee4fcc5"],"src":["SDU University of Southern Denmark"],"title":"“I’m sure that there is something healing in the writing process” : Creative Writing Workshops for People with a Cancer Disease","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-627154","year":"2019","yearsub":"2019"}
{"abstract":"Introduction With an increasing prevalence of citizens of older age and with overweight, the health issues related to knee osteoarthritis (OA) will intensify. Weight loss is considered a primary management strategy in patients with concomitant overweight and knee OA. However, there are no widely available and feasible methods to sustain weight loss in patients with overweight and knee OA. The present protocol describes a randomised controlled trial evaluating the efficacy and safety of the glucagon-like peptide-1 receptor agonist liraglutide in a 3 mg/day dosing in patients with overweight and knee OA. Methods and analysis 150 volunteer adult patients with overweight or obesity and knee OA will participate in a randomised, double-blind, placebo-controlled, parallel-group and single-centre trial. The participants will partake in a run-in diet intervention phase (week-8 to 0) including a low calorie diet and dietetic counselling. At week 0, patients will be randomised to either liraglutide 3 mg/day or liraglutide placebo 3 mg/day for 52 weeks as an add-on to dietetic guidance on re-introducing regular foods and a focus on continued motivation to engage in a healthy lifestyle. The co-primary outcomes are changes in body weight and the Knee Injury and Osteoarthritis Outcome Score pain subscale from week 0 to week 52. Ethics and dissemination The trial has been approved by the regional ethics committee in the Capital Region of Denmark, the Danish Medicines Agency and the Danish Data Protection Agency. An external monitoring committee (The Good Clinical Practice Unit at Copenhagen University Hospitals) will oversee the trial. The results will be presented at international scientific meetings and through publications in peer-reviewed journals. Trial registration numbers 2015-005163-16, NCT02905864, U1111-1171-4970 Based on protocol version V.6; 30 January 2017, 15:30 hours.","author_count":16,"contributors":["Gudbergsen, Henrik Rindel","Henriksen, Marius","Wæhrens, Eva Ejlersen","Overgaard, Anders","Bliddal, Henning","Christensen, Robin","Boesen, Mikael","Knop, Filip K.","Astrup, Arne","Rasmussen, Marianne Uggen","Bartholdy, Cecilie","Daugaard, Cecilie","Bartels, Else Marie","Ellegaard, Karen","Heitmann, Berit Lilienthal","Kristensen, Lars Erik"],"cuid":["S02-085.94-044007"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Gudbergsen, Henrik"],"keyword":["Dietary intervention","Faculty of Science","Knee","Liraglutide","Osteoarthritis","Overweight","Protocol","Rheumatology","Weight loss"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"OT":["Steno Diabetes Centre, Gentofte, Denmark."],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"effect of liraglutide on body weight and pain in patients with overweight and knee osteoarthritis protocol for a randomised double blind placebocontrolled parallel group singlecentre trial","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/bmjopen-2018-024065","version":"Published Version"},"funding_acknowledgement":["Funding This work was supported by Novo Nordisk A/S, both financially and through the delivery of active and placebo medicine, and by The Cambridge Weight Plan through the delivery of dietary supplements. The trial is an investigator-initiated study, initiated by the primary investigator Henrik Gudbergsen and the sponsor-investigator Henning Bliddal. In addition, this work was supported by a core grant from the Oak Foundation (OCAY-13-309) given to the Parker Institute, Copenhagen University Hospital, Bispebjerg and Frederiksberg."],"id":"S02-085.94-044007","identifier":[{"id":"31061017","type":"pmid"},{"id":"PMC6501972","type":"pmcid"},{"id":"85065397420","type":"scopus"}],"ids":["ku-83d9ac31-298a-4909-bd2e-792616460010","sdu-7a5da3fa-66fd-405a-84e4-cea83d6e6e0e"],"keyword":["Faculty of Science","Overweight","Protocol","Rheumatology","dietary intervention","knee","liraglutide","osteoarthritis","weight loss"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-F5AB481697086E3C8075A248ED03F1E1"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/bmjopen-2018-024065","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://curis.ku.dk/ws/files/217551353/Gudbergsen_et_al_B_M_J_Open_2019_Vol_9_5_e024065.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/150390787/Effect_of_liraglutide_on_body_weight_and_pain_in_patients_with_overweight_and_knee_osteoarthritis.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Bispebjerg and Frederiksberg"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Rheumatology (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Radiology"],"nora_code":"DI-U-KU","used":1},{"affno":"4","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Steno Diabetes Centre, Gentofte, Denmark."],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","first":"Henrik Rindel","key":"gudbergsenpau","last":"Gudbergsen","name":"Gudbergsen, Henrik Rindel","rank":1,"rolecode":"pau"},{"affno":"1","first":"Marius","key":"henriksenpau","last":"Henriksen","name":"Henriksen, Marius","rank":2,"rolecode":"pau"},{"affno":"1","first":"Eva Ejlersen","key":"wæhrenspau","last":"Wæhrens","name":"Wæhrens, Eva Ejlersen","rank":3,"rolecode":"pau"},{"affno":"1","first":"Anders","key":"overgaardpau","last":"Overgaard","name":"Overgaard, Anders","rank":4,"rolecode":"pau"},{"affno":"1","first":"Henning","key":"bliddalpau","last":"Bliddal","name":"Bliddal, Henning","rank":5,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Robin","key":"christensenpau","last":"Christensen","locid":"04bf2bf9-a6d8-4be8-93fd-82f3f2ddc9ba","name":"Christensen, Robin","orcid":"0000-0002-6600-0631","rank":6,"rolecode":"pau"},{"affno":"1 3","first":"Mikael Ploug","key":"boesenpau","last":"Boesen","locid":"b449f652-d441-4b23-836f-2d5111ef64dd","name":"Boesen, Mikael","name_org":"Boesen, Mikael Ploug","rank":7,"rolecode":"pau"},{"affno":"3 4","first":"Filip K Krag","key":"knoppau","last":"Knop","locid":"ce6eaad9-59f8-4ecf-8a1e-388a74734f6a","name":"Knop, Filip K.","name_org":"Knop, Filip K Krag","rank":8,"rolecode":"pau"},{"affno":"3","first":"Arne","key":"astruppau","last":"Astrup","locid":"5d943631-c9fc-4b63-8aaa-263ba4248735","name":"Astrup, Arne","orcid":"0000-0001-8968-8996","rank":9,"rolecode":"pau"},{"affno":"1","first":"Marianne Uggen","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Marianne Uggen","rank":10,"rolecode":"pau"},{"affno":"1","first":"Cecilie","key":"bartholdypau","last":"Bartholdy","name":"Bartholdy, Cecilie","rank":11,"rolecode":"pau"},{"affno":"1","first":"Cecilie","key":"daugaardpau","last":"Daugaard","name":"Daugaard, Cecilie","rank":12,"rolecode":"pau"},{"affno":"1","first":"Else Marie","key":"bartelspau","last":"Bartels","name":"Bartels, Else Marie","rank":13,"rolecode":"pau"},{"affno":"1","first":"Karen","key":"ellegaardpau","last":"Ellegaard","name":"Ellegaard, Karen","rank":14,"rolecode":"pau"},{"affno":"1 3","first":"Berit","key":"heitmannpau","last":"Heitmann","locid":"b644e477-0a57-40f2-b0a7-71e52f624356","name":"Heitmann, Berit Lilienthal","name_org":"Heitmann, Berit","rank":15,"rolecode":"pau"},{"affno":"1","first":"Lars Erik","key":"kristensenpau","last":"Kristensen","name":"Kristensen, Lars Erik","rank":16,"rolecode":"pau"}],"pmid":["31061017"],"pub":{"doi":"10.1136/bmjopen-2018-024065","issn":["20446055"],"issue":"5","journal":"BMJ Open","paperid":"e024065","publisher":"BMJ Publishing Group","status":"p","title":"BMJ Open","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-85065397420"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-83d9ac31-298a-4909-bd2e-792616460010","sdu-7a5da3fa-66fd-405a-84e4-cea83d6e6e0e"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Effect of liraglutide on body weight and pain in patients with overweight and knee osteoarthritis : Protocol for a randomised, double-blind, placebo-controlled, parallel-group, single-centre trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-085.94-044007","year":"2019","yearsub":"2019"}
{"abstract":"Background: RECIST 1.1 presents challenges when evaluating treatment response to angiogenesis inhibitors. The objective response rate, when evaluating the treatment effect of regorafenib, using RECIST 1.1, is < 2% and beneficial treatment could erroneously be terminated. Dynamic contrast-enhanced computed tomography (DCE-CT) has potential as a non-invasive functional imaging biomarker, by quantifying the treatment effect of this targeted therapy. Purpose: To evaluate three-dimensional (3D) tumor dynamic parameters representing tumor microcirculation assessed by DCE-CT during the treatment with regorafenib in a cohort of patients with treatment-refractory metastatic colorectal cancer. Material and Methods: Thirty-three patients with colorectal metastases (27 liver lesions, three abdominal lesions, and three pulmonary lesions) were treated with regorafenib and evaluated using DCE-CT. A total of 112 DCE-CT scans were analyzed using Advanced Perfusion and Permeability Application and correlated to standard contrast-enhanced computed tomography (CE-CT) evaluated using RECIST 1.1. Results: A significant decrease in most DCE-CT parameters, a simultaneous decrease in tumor attenuation and an increase in tumor volume were detected during treatment. However, no associations were found between the DCE-CT parameters and PFS or OS using simple COX proportional hazards regression. Conclusion: In this exploratory study, a significant decrease in most dynamic parameters suggests an overall treatment effect of regorafenib in tumor vasculature. DCE-CT may assist in an objective evaluation of these responses compared to RECIST. The anti-angiogenic changes could not be associated with treatment outcome in terms of PFS and OS, which might be due to the small cohort or a rather limited survival benefit in this pre-medicated treatment-refractory group of patients.","author_count":7,"contributors":["Andersen, Iben Rahbek","Olesen, Rene K.","Boysen, Anders Kindberg","Jensen, Lars H.","Mortensen, Frank Viborg","Nielsen, Dennis Tønner","Rasmussen, Finn"],"cuid":["S02-087.76-025071"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Andersen, Iben R","Andersen, Iben Rahbek"],"keyword":["Abdominal Neoplasms diagnostic imaging","Aged","Angiogenesis Inhibitors","Biomarkers","CT quantitative","Colorectal Neoplasms pathology","Contrast Media","Female","Four Dimensional Computed Tomography methods","Humans","Liver Neoplasms diagnostic imaging","Lung Neoplasms diagnostic imaging","Male","Metastatic colorectal cancer","Middle Aged","Patient outcome","Phenylurea Compounds therapeutic use","Pyridines therapeutic use","Radiographic Image Enhancement methods","Response Evaluation Criteria in Solid Tumors","Treatment Outcome","Triiodobenzoic Acids","dynamic contrast enhanced computed tomography"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-CDR","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"dynamic contrast enhanced computed tomography as a potential biomarker in patients with metastatic colorectal cancer treated with regorafenib","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85060551076","version":"Other Version"},"id":"S02-087.76-025071","identifier":[{"id":"85060551076","type":"scopus"},{"id":"30348001","type":"pmid"}],"ids":["au-aa1abcf0-727f-46cb-b85e-f4a5f2977d68","sdu-0f211700-3df8-4bf8-b7da-b96903ee8ae1"],"keyword":["Abdominal Neoplasms/diagnostic imaging","Aged","Biomarkers","CT quantitative","Colorectal Neoplasms/pathology","Contrast Media","Female","Four-Dimensional Computed Tomography/methods","Humans","Liver Neoplasms/diagnostic 