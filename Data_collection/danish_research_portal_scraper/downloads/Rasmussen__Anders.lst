00-0003-0853-0893","rank":24,"rolecode":"pau"},{"affno":"10 11","corresponding":null,"first":"Coca","key":"necsoipau","last":"Necsoi","name":"Necsoi, Coca","rank":25,"rolecode":"pau"},{"affno":"12","corresponding":null,"first":"Marc","key":"vandervalkpau","last":"van der Valk","name":"van der Valk, Marc","rank":26,"rolecode":"pau"},{"affno":"13","corresponding":null,"first":"Marianna","key":"menozzipau","last":"Menozzi","name":"Menozzi, Marianna","rank":27,"rolecode":"pau"},{"affno":"14 15","corresponding":null,"first":"Camilla","key":"muccinipau","last":"Muccini","name":"Muccini, Camilla","rank":28,"rolecode":"pau"},{"affno":"1","first":"Lars","key":"peterspau","last":"Peters","name":"Peters, Lars","rank":29,"rolecode":"pau"},{"affno":"2 27","first":"Amanda","key":"mocroftpau","last":"Mocroft","name":"Mocroft, Amanda","rank":30,"rolecode":"pau"},{"affno":"27","first":"Lene","key":"ryompau","last":"Ryom","name":"Ryom, Lene","rank":31,"rolecode":"pau"}],"pmid":["35688166"],"pub":{"doi":"10.1016/s2352-3018(22)00094-7","issn":["23523018"],"issue":"7","journal":"The Lancet HIV","publisher":"Elsevier","status":"p","title":"The Lancet HIV","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-85133261410"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-275e316c-b407-4239-9851-7134beaf3d0b","sdu-1e8980f4-5347-40ab-901c-67bbaa327d24"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Associations between integrase strand-transfer inhibitors and cardiovascular disease in people living with HIV : a multicentre prospective study from the RESPOND cohort consortium","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-666801","year":"2022","yearsub":"2022"}
{"abstract":"Background: The Goldilocks Work Principle expresses that productive work should be designed to promote workers’ health. We recently showed that it is feasible to develop and implement modifications to productive work that change physical behaviors (i.e. sitting, standing and being active) in a direction that may promote health among industrial workers. Therefore, the aim of the present study is to conduct a cluster randomised controlled trial investigating health effects of implementing the Goldilocks Work intervention among industrial workers. Methods: Our implementation plan consists of educating work teams, organizing implementation meetings, and providing feedback to workers. Three meetings with a preselected local workplace group will be scheduled. The first meeting educates the group to use a planning tool by which work can be planned to have ‘just right’ physical behaviors. The second and third meetings will focus on supporting implementation of the tool in daily work. An expected 28 clusters of work teams across two participating production sites will be randomized to either intervention or control group. Data collection will consist of 1) questionnaires regarding work and musculoskeletal health, 2) wearable sensor measurements of the physical behavior, and 3) assessment of general health indicators, including BMI, blood pressure, and fat percentage. The primary outcome is musculoskeletal health, measured by low back pain intensity, and secondary outcomes are 1) physical behaviors at work, 2) accumulated time in long bouts of sitting, standing, and being active and 3) perceived fatigue and energy during work. Furthermore, implementation and cost of the intervention will be evaluated based on questionnaires and data from the planning tool completed by the workers. Discussion: This study will evaluate the effectiveness and implementation of a 12 - weeks Goldilocks Work intervention with the aim of improving musculoskeletal health among industrial workers. The cluster randomized controlled study design and the evaluation of the implementation, results and costs of the intervention will make it capable of contributing with valuable evidence of how productive work may be designed to promote industrial workers’ health. Trial registration: Clinical trial registration was assigned 10–09-2021 (ISRCTN80969503). https://doi.org/10.1186/ISRCTN80969503.","author_count":6,"contributors":["Lerche, Anders Fritz","Mathiassen, Svend Erik","Rasmussen, Charlotte Lund","Straker, Leon","Søgaard, Karen","Holtermann, Andreas"],"cuid":["S02-100.00-769438"],"filters":{"added":"2022-04","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD","Oceania"],"corresponding_author":["Lerche, Anders Fritz"],"country":["Australia","Czechia","Norway","Sweden"],"glorg":["All Global Affiliations","Centre for Musculoskeletal Research, Department of Occupational and Public Health Sciences, University of Gävle, Gävle, Sweden.","Curtin University","Norwegian University of Science and Technology","Norwegian University of Science and Technology, Trondheim, Norway.","Palacký University Olomouc","School of Allied Health, Curtin University, Perth, Australia.","University of Gävle"],"keyword":["Goldilocks Work Principle","Health","Intervention","Interventioner","Journal Article","Physical behavior","Sundhedsmiljø"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-WORK"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-GV-WORK","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"designing industrial work to be just right to promote health a study protocol for a goldilocks work intervention","src":["nfa","sdu"],"src-code":["DI-GV-WORK","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1186/s12889-022-12643-w","version":"Published Version"},"funding_acknowledgement":["The Danish Working Environment Research Fund (grant no. 18- 2018–03) funds this study. The approved funding application has been peer reviewed. The funding source had no role in the design of the study and will not have any role in the implementation of the intervention, the data collection, data analysis, interpretation of the data, or decisions on when or where to report the results. The Danish Working Environment Research Fund can be reached at forskningsfonden@at.dk."],"id":"S02-100.00-769438","identifier":[{"id":"85125157516","type":"scopus"},{"id":"35197018","type":"pmid"},{"id":"PMC8867863","type":"pmcid"}],"ids":["nfa-29b00bfb-f9c7-4381-a5e3-f662c1e656ed","sdu-d353bab2-7822-425c-89f1-1ca106d852f8"],"keyword":["Goldilocks Work Principle","Health","Intervention","Interventioner","Journal Article","Physical Behavior","Sundhedsmiljø"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-F7F0B3B70835441D25EBB9725102122B"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1186/s12889-022-12643-w","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/199888681/s12889_022_12643_w.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics, Research Unit of Physical Activity and Health in Working life"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"nfa national research centre for the working environment","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-WORK","l3nn":"NFA National Research Centre for the Working Environment","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"NFA National Research Centre for the Working Environment","namevar":["National Research Centre for the Working Environment"],"nora_code":"DI-GV-WORK","used":1},{"affno":"3","country":"se","key":"university of gävle","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"University of Gävle","used":1},{"affno":"4","country":"se","key":"centre for musculoskeletal research department of occupational and public health sciences university of gävle gävle sweden","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Centre for Musculoskeletal Research, Department of Occupational and Public Health Sciences, University of Gävle, Gävle, Sweden.","used":1},{"affno":"5","country":"no","key":"norwegian university of science and technology","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"Norwegian University of Science and Technology","used":1},{"affno":"6","country":"cz","key":"palacký university olomouc","loc":["Czechia","Europe, EU","OECD"],"name":"Palacký University Olomouc","used":1},{"affno":"7","country":"no","key":"norwegian university of science and technology trondheim norway","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"Norwegian University of Science and Technology, Trondheim, Norway.","used":1},{"affno":"8","country":"au","key":"curtin university","loc":["Australia","Oceania","OECD"],"name":"Curtin University","used":1},{"affno":"9","country":"au","key":"school of allied health curtin university perth australia","loc":["Australia","Oceania","OECD"],"name":"School of Allied Health, Curtin University, Perth, Australia.","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Anders Fritz","key":"lerchepau","last":"Lerche","locid":"8ca85f92-8c87-439e-86fc-e2ca9cd5bbcb","name":"Lerche, Anders Fritz","orcid":"0000-0002-3199-6571","rank":1,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Svend Erik","key":"mathiassenpau","last":"Mathiassen","name":"Mathiassen, Svend Erik","rank":2,"rolecode":"pau"},{"affno":"5 6 7","corresponding":null,"first":"Charlotte Lund","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Charlotte Lund","rank":3,"rolecode":"pau"},{"affno":"8 9","corresponding":null,"first":"Leon","key":"strakerpau","last":"Straker","name":"Straker, Leon","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Karen","key":"søgaardpau","last":"Søgaard","locid":"01571423-fcd0-4dbc-9112-e9b52d4a1131","name":"Søgaard, Karen","orcid":"0000-0003-3968-6364","rank":5,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Andreas","key":"holtermannpau","last":"Holtermann","locid":"f0d131d6-aefa-4dd3-a64e-2e237f273adf","name":"Holtermann, Andreas","orcid":"0000-0003-4825-5697","rank":6,"rolecode":"pau"}],"pmid":["35197018"],"pub":{"doi":"10.1186/s12889-022-12643-w","issn":["14712458"],"issue":"1","journal":"BMC Public Health","pages":"381","publisher":"BioMed Central","status":"p","title":"BMC Public Health","volume":"22"},"review":"Peer Reviewed","scoID":["2-s2.0-85125157516"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["nfa-29b00bfb-f9c7-4381-a5e3-f662c1e656ed","sdu-d353bab2-7822-425c-89f1-1ca106d852f8"],"src":["NFA National Research Centre for the Working Environment","SDU University of Southern Denmark"],"title":"Designing industrial work to be ‘just right’ to promote health - a study protocol for a goldilocks work intervention","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-769438","year":"2022","yearsub":"2022"}
{"abstract":"This study evaluated the criterion validity of a newly developed application for assessing smartphone use on iOS and Android based devices. A sample of adult Danes (n=40; 40% female; median age= 42.0 years) had the application SDU DeviceTracker installed on their mobile phone together with a commercial application that served as a reference for comparison (Apple Screen Time (iOS) or ActionDash (Android)). Each participant collected data for at least 6 days, adding up to a total of 277 assessment days. Day-level analyses were performed and Bland-Altman limits of agreement for repeated measurements and repeated measurement correlation was calculated. A non-significant mean bias of −0.8 min/day and a correlation coefficient of 0.99 (95% CI: 0.98 to 0.99) was observed for the assessment of screen time on Android devices compared to the reference method. For iOS devices a significant mean bias of 19.3 min/day and a correlation coefficient of r=0.88 (95% CI: 0.84 to 0.91) was observed. A correction method for systematic error in the assessment of screen time on iOS devices was provided. The study concluded that SDU DeviceTracker provides an opportunity to collect highly detailed and valid information about screen usage over extended periods of time.","author_count":7,"contributors":["Kristensen, Peter Lund","Olesen, Line Grønholt","Klakk, Heidi","Pedersen, Jesper","Rasmussen, Martin Gillies Banke","Grøntved, Anders"],"cuid":["S03-091.93-794029"],"filters":{"added":"2022-04","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"corresponding_author":["Kristensen, Peter Lund"],"keyword":["Limit of agreement","Objective assessment","Reproducibility","Screen time","Smartphone","Validity"],"level":"sci","mra":["hum","med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U","DI-UC"],"level3":{"U":["DI-U-ALL","DI-U-SDU"],"UC":["DI-UC-ALL","DI-UC-UCL","DI-UC-UCS"]},"level3all":["DI-U-SDU","DI-UC-UCL","DI-UC-UCS"]},"review":"pr","rtype":["clu"],"sorti":"criterion validity of a research based application for tracking screen time on android and ios smartphones and tablets","src":["sdu","ucl","ucsyd"],"src-code":["DI-U-SDU","DI-UC-UCL","DI-UC-UCS"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.chbr.2021.100164","version":"Published Version"},"id":"S03-091.93-794029","identifier":[{"id":"85125679059","type":"scopus"}],"ids":["sdu-fcdc5445-3e38-4e0f-9743-9ebe208be15d","ucl-138affe5-2026-49ac-97d2-80d82f388735","ucsyd-50e06df8-df2b-416f-8f28-89185dbd025d"],"keyword":["Limit of agreement","Objective assessment","Reproducibility","Screen time","Smartphone","Validity"],"lang":"English","level":"Scientific","mra":["Humanities","Medical Science"],"noi":["Global-Local-2-6-0578934C5F5508AA6094F4D45F3FAFB4"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.chbr.2021.100164","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/200073147/1_s2.0_S2451958821001123_main.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics, RICH - Research In Childhood Health","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics, Research Unit of Exercise Epidemiology"],"nora_code":"DI-U-SDU","used":1},{"a