artment of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Obstetrics and Gynaecology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Steno Diabetes Centre, Gentofte, Denmark."],"nora_code":"DI-OT","used":1}],"person":[{"affno":"","first":"Pia","key":"egeruppau","last":"Egerup","name":"Egerup, Pia","rank":1,"rolecode":"pau"},{"affno":"","first":"Anders P.","key":"mikkelsenpau","last":"Mikkelsen","name":"Mikkelsen, Anders P.","rank":2,"rolecode":"pau"},{"affno":"1","first":"Astrid Marie","key":"koltepau","last":"Kolte","locid":"f64337ee-fb99-4261-9e2a-ea6fc8323edb","name":"Kolte, Astrid Marie","rank":3,"rolecode":"pau"},{"affno":"1","first":"David","key":"westergaardpau","last":"Westergaard","locid":"049e0f46-367a-4436-9553-149dfa1b62ac","name":"Westergaard, David","orcid":"0000-0003-0128-8432","rank":4,"rolecode":"pau"},{"affno":"","first":"Steen","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Steen","rank":5,"rolecode":"pau"},{"affno":"1 2","first":"Filip","key":"kknoppau","last":"K Knop","locid":"ce6eaad9-59f8-4ecf-8a1e-388a74734f6a","name":"Knop, Filip K.","name_org":"K Knop, Filip","rank":6,"rolecode":"pau"},{"affno":"1","first":"Øjvind","key":"lidegaardpau","last":"Lidegaard","locid":"477519a8-a5d9-4dcf-970a-e11c7e4f936f","name":"Lidegaard, Øjvind","rank":7,"rolecode":"pau"},{"affno":"1","first":"Henriette S.","key":"nielsenpau","last":"Nielsen","locid":"8c0dbb49-ded3-4607-aca2-08fd68b6a558","name":"Nielsen, Henriette Svarre","name_org":"Nielsen, Henriette S.","rank":8,"rolecode":"pau"}],"pmid":["32424542"],"pub":{"doi":"10.1007/s00125-020-05154-z","issn":["0012186X","14320428"],"issn_org":["0012186X"],"issue":"8","journal":"Diabetologia","