"Callesen","locid":"7fe33188-4ec4-4b54-bc7a-c922c5ebaa54","name":"Callesen, Henrik","orcid":"0000-0002-0185-7300","rank":17,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Tofuko Awori","key":"woyengopau","last":"Woyengo","locid":"eac4b0a9-47b2-4ec3-918b-20c60bf66a55","name":"Woyengo, Tofuko Awori","rank":18,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rasmus","key":"ejrnæspau","last":"Ejrnæs","locid":"de0d0e9b-b9f3-46a7-9a70-ed6e45dba8d8","name":"Ejrnæs, Rasmus","rank":19,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Camilla","key":"fløjgaardpau","last":"Fløjgaard","locid":"734c7835-fada-4583-95a3-e7ac25f34175","name":"Fløjgaard, Camilla","orcid":"0000-0002-5829-8503","rank":20,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Paul Henning","key":"kroghpau","last":"Krogh","locid":"afaf03ea-44d9-4c45-b081-ce7e524cad38","name":"Krogh, Paul Henning","orcid":"0000-0003-2033-553X","rank":21,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Trine Michelle","key":"villumsenpau","last":"Villumsen","locid":"14e15b52-db51-4a1c-aa7f-41c577c6b605","name":"Villumsen, Trine Michelle","rank":22,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anders Peter S.","key":"adamsenpau","last":"Adamsen","locid":"b9cb7cb6-d18d-4aed-b6ef-9a7b51169ea4","name":"Adamsen, Anders Peter S.","rank":23,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Morten Dam","key":"rasmussenpau","last":"Rasmussen","locid":"c8fc0a65-2cc3-4039-9684-c6bb82d4a5a9","name":"Rasmussen, Morten Dam","rank":24,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lise Bonne","key":"guldbergpau","last":"Guldberg","locid":"a8e528a6-f444-4739-abfe-4aa8285916c0","name":"Guldberg, Lise Bonne","rank":25,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Li","key":"rongpau","last":"Rong","locid":"f946db2a-3da4-452d-92df-8633084731ea","name":"Rong, Li","orcid":"0000-0003-0622-3590","rank":26,"rolecode":"pau"}],"pub":{"isbn":["788794420068"],"issn":["22451684"],"issue":"214","pages":"127","publisher":"DCA - Nationalt Center for Fødevarer og Jordbrug","repno":"DCA rapport, No. 214","series":"DCA rapport","status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-b4e74def-d5ed-462d-ad4e-c8a04bf98ba1"],"src":["AU Aarhus University"],"title":"Vidensyntese om klimatilpasning og landbrug","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-232551","year":"2023","yearsub":"2023"}
{"abstract":"Background and purpose: In cancer treatment precise definition of the tumor volume is essential, but despite development in imaging modalities, this remains a challenge. Here, pathological tumor volumes from the surgical specimens were obtained and compared to tumor volumes defined from modern PET/MRI hybrid imaging. The purpose is to evaluate mismatch between the volumes defined from imaging and pathology was estimated and potential clinical impact. Methods and Materials: Twenty-five patients with head and neck squamous cell carcinoma were scanned on an integrated PET/MRI system prior to surgery. Three gross tumor volumes (GTVs) from the primary tumor site were delineated defined from MRI (GTVMRI), PET (GTVPET) and one by utilizing both anatomical images and clinical information (GTVONCO). Twenty-five primary tumor specimens were extracted en bloc, scanned with PET/MRI and co-registered to the patient images. Each specimen was sectioned in blocks, sliced and stained with haematoxylin and eosin. All slices were digitalized and tumor delineated by a head and neck pathologist. The pathological tumor areas in all slices were interpolated yielding a pathological 3D tumor volume (GTVPATO). GTVPATO was compared with the imaging GTV's and potential mismatch was estimated. Results: Thirteen patients were included. The mean volume of GTVONCO was larger than the GTV's defined from PET or MRI. The mean mismatch of the GTVPATO compared to the GTVPET, GTVMRI and GTVONCO was 31.9 %, 54.5 % and 27.9 % respectively, and the entire GTVPATO was only fully encompassed in GTVONCO in 1 of 13 patients. However, after the addition of a clinical 5 mm margin the GTVPATO was fully encompassed in GTVONCO in 11 out of 13 patients. Conclusions: Despite modern hybrid imaging modalities, a mismatch between imaging and pathological defined tumor volumes was observed in all patients. A 5 mm clinical margin was sufficient to ensure inclusion of the entire pathological volume in 11 out of 13 patients.","author_count":10,"contributors":["Terzidis, Emmanouil","Friborg, Jeppe","Vogelius, Ivan R.","Lelkaitis, Giedrius","von Buchwald, Christian","Olin, Anders B.","Johannesen, Helle H.","Fischer, Barbara Malene","Wessel, Irene","Rasmussen, Jacob Høygaard"],"cuid":["S01-000.00-521359"],"filters":{"added":"2023-05","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Sweden"],"glorg":["All Global Affiliations","University of Gothenburg"],"keyword":["Magnetic Resonance Imaging","Pathology","Positron Emission Tomography","Squamous Cell Carcinoma of Head and Neck"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"tumor volume definitions in head and neck squamous cell carcinoma comparing pet mri and histopathology","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.radonc.2023.109484","version":"Published Version"},"id":"S01-000.00-521359","identifier":[{"id":"85147228062","type":"scopus"},{"id":"36690303","type":"pmid"}],"ids":["ku-d61d9003-d4d4-4db5-a701-ed3c5c72c29e"],"keyword":["Magnetic resonance imaging","Pathology","Positron emission tomography","Squamous cell carcinoma of head and neck"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-93182B1E066ADFC9AEE57EDEF4DF7C6D"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/341276679/1_s2.0_S0167814023000221_main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.radonc.2023.109484","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","country":"se","key":"university of gothenburg","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"University of Gothenburg","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Clinical Oncology","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1 2","first":"Emmanouil","key":"terzidispau","last":"Terzidis","name":"Terzidis, Emmanouil","rank":1,"rolecode":"pau"},{"affno":"3","first":"Jeppe","key":"friborgpau","last":"Friborg","locid":"d68fc520-8f1c-4d96-800c-31d120450673","name":"Friborg, Jeppe","orcid":"0000-0001-5423-0627","rank":2,"rolecode":"pau"},{"affno":"3","first":"Ivan R.","key":"vogeliuspau","last":"Vogelius","locid":"66f4607a-ae94-4767-aaf0-79279bb24c31","name":"Vogelius, Ivan R.","rank":3,"rolecode":"pau"},{"affno":"3","first":"Giedrius","key":"lelkaitispau","last":"Lelkaitis","locid":"f7aba425-cebc-418e-a5f5-99a6e1ad6c16","name":"Lelkaitis, Giedrius","rank":4,"rolecode":"pau"},{"affno":"3","first":"Christian","key":"vonbuchwaldpau","last":"von Buchwald","locid":"fc76b0d1-1263-48f7-a4d0-685e60bbc1b6","name":"von Buchwald, Christian","orcid":"0000-0001-6753-8129","rank":5,"rolecode":"pau"},{"affno":"1","first":"Anders B.","key":"olinpau","last":"Olin","name":"Olin, Anders B.","rank":6,"r