yhoffpau","last":"Meyhoff","locid":"400ce1b5-dea2-491f-a8d1-843e6e48f569","name":"Meyhoff, Tine Sylvest","name_org":"Meyhoff, Tine S.","rank":5,"rolecode":"pau"},{"affno":"2 5","corresponding":null,"first":"Søren","key":"markerpau","last":"Marker","name":"Marker, Søren","rank":6,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Thomas L.","key":"klitgaardpau","last":"Klitgaard","locid":"f3e0e4b8-0772-4f4f-8be2-b99763b3917c","name":"Lass Klitgaard, Thomas","name_org":"Klitgaard, Thomas L.","orcid":"0000-0002-8781-1206","rank":7,"rolecode":"pau"},{"affno":"2 4","corresponding":null,"first":"Stine","key":"estruppau","last":"Estrup","name":"Estrup, Stine","rank":8,"rolecode":"pau"},{"affno":"3","first":"Morten Hylander","key":"mollerpau","last":"Moller","locid":"9463b017-3c43-470d-b95b-cf3cba8a27d4","name":"Møller, Morten Hylander","name_org":"Moller, Morten Hylander","rank":9,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Bodil S.","key":"rasmussenpau","last":"Rasmussen","locid":"3162c449-94c3-4d28-8dbb-c134d6eb76e1","name":"Rasmussen, Bodil Steen","name_org":"Rasmussen, Bodil S.","orcid":"0000-0003-2190-145X","rank":10,"rolecode":"pau"},{"affno":"3 2 4","first":"Lone M.","key":"poulsenpau","last":"Poulsen","locid":"abd9a887-5a95-4dbb-97fd-42dc901fc761","name":"Poulsen, Lone M.","rank":11,"rolecode":"pau"},{"affno":"3","first":"Anders","key":"pernerpau","last":"Perner","locid":"8a389541-d529-4ee3-8364-66bfc85f77c9","name":"Perner, Anders","rank":12,"rolecode":"pau"}],"pmid":["34606090"],"pub":{"doi":"10.1111/aas.13990","issn":["00015172"],"issue":"1","journal":"Acta Anaesthesiologica Scandinavica","pages":"156-162","publisher":"Blackwell Munksgaard","status":"p","title":"Acta Anaesthesiologica Scandinavica","volume":"66"},"review":"Peer Reviewed","scoID":["2-s2.0-85116779542"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Other Hospitals","Region Zealand","Universities","University of Copenhagen","collaboration for research in intensive care"],"PST":["Published"]},"sid":["aau-99bb5e13-b0d1-4364-83f2-ec258c1b4bdc","ku-b744b7dd-214d-4af4-81c0-f8ef531ddb19"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"Interactions in clinical trials : Protocol and statistical analysis plan for an explorative study of four randomized ICU trials on use of pantoprazole, oxygenation targets, haloperidol and intravenous fluids","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-087.24-007464","year":"2022","yearsub":"2022"}
{"abstract":"Background: Respiratory failure is the main cause of mortality and morbidity among ICU patients with coronavirus disease 2019 (COVID-19). In these patients, supplemental oxygen therapy is essential, but there is limited evidence the optimal target. To address this, the ongoing handling oxygenation targets in COVID-19 (HOT-COVID) trial was initiated to investigate the effect of a lower oxygenation target (partial pressure of arterial oxygen (PaO2) of 8 kPa) versus a higher oxygenation target (PaO2 of 12 kPa) in the ICU on clinical outcome in patients with COVID-19 and hypoxaemia. Methods: The HOT-COVID is planned to enrol 780 patients. This paper presents the protocol and statistical analysis plan for the conduct of a secondary Bayesian analysis of the primary outcome of HOT-COVID being days alive without life-support at 90 days and the secondary outcome 90-day all-cause mortality. Furthermore, both outcomes will be investigated for the presence heterogeneity of treatment effects based on four baseline parameters being sequential organ failure assessment score, PaO2/fraction of inspired oxygen ratio, highest dose of norepinephrine during the 24 h before randomisation, and plasma concentration of lactate at randomisation. Conclusion: The results of this pre-planned secondary Bayesian analysis will complement the primary frequentist analysis of the HOT-COVID trial and may facilitate a more nuanced interpretation of the trial results.","author_count":7,"contributors":["Nielsen, Frederik Mølgaard","Lass Klitgaard, Thomas","Granholm, Anders","Lange, Theis","Perner, Anders","Schjørring, Olav Lilleholt","Rasmussen, Bodil Steen"],"cuid":["S02-088.89-010560"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Nielsen, Frederik Mølgaard"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-OTH"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-HO-OTH","DI-U-AAU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"higher versus lower oxygenation targets in covid 000000000019 patients with severe hypoxaemia hot covid trial protocol for a secondary bayesian analysis","src":["aau","ku"],"src-code":["DI-U-AAU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/298652907/LINI_Acta_Anaesthesiol_Scand_2021_M_lgaard_Nielsen_Higher_vs_lower_oxygenation_targets_in_COVID_19_patients_with_severe.pdf","version":"Authors Final Version"},"id":"S02-088.89-010560","identifier":[{"id":"85122087835","type":"scopus"},{"id":"34951717","type":"pmid"}],"ids":["aau-ddb415e2-594d-4ba5-b5d5-362050eff76f","ku-3a3fa994-d105-43a2-bfc4-a95738adde2e"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-3927E1BC8482EA5765BFCD0F403F17FA"],"oa_link":[{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/298652907/LINI_Acta_Anaesthesiol_Scand_2021_M_lgaard_Nielsen_Higher_vs_lower_oxygenation_targets_in_COVID_19_patients_with_severe.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Anaesthesiology and Intensive Care","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Anæstesi, Børn, Kredsløb og Kvinder","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"other hospitals","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-OTH","l3nl":"Other Hospitals","l3nn":"Other Hospitals","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Hospitals","namevar":["Collaboration for Research in Intensive Care"],"nora_code":"DI-HO-OTH","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Rigshospitalet, Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"4","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Frederik","key":"mølgaardnielsenpau","last":"Mølgaard Nielsen","locid":"d7387610-1579-4bc0-892f-a8523e6579ba","name":"Nielsen, Frederik Mølgaard","name_org":"Mølgaard Nielsen, Frederik","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Thomas","key":"lassklitgaardpau","last":"Lass Klitgaard","locid":"f3e0e4b8-0772-4f4f-8be2-b99763b3917c","name":"Lass Klitgaard, Thomas","orcid":"0000-0002-8781-1206","rank":2,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Anders","key":"granholmpau","last":"Granholm","name":"Granholm, Anders","rank":3,"rolecode":"pau"},{"affno":"4","first":"Theis","key":"langepau","last":"Lange","locid":"e4664578-01fc-4a93-8efd-1dbffb72cdd6","name":"Lange, Theis","orcid":"0000-0001-6807-8347","rank":4,"rolecode":"pau"},{"affno":"4 2 3","first":"Anders","key":"pernerpau","last":"Perner","locid":"8a389541-d529-4ee3-8364-66bfc85f77c9","name":"Perner, Anders","rank":5,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Olav","key":"lilleholtschjørringpau","last":"Lilleholt Schjørring","locid":"7dac619e-9b5c-46ac-9170-10ac13165da5","name":"Schjørring, Olav Lilleholt","name_org":"Lilleholt Schjørring, Olav","rank":6,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Bodil","key":"steenrasmussenpau","last":"Steen Rasmussen","locid":"3162c449-94c3-4d28-8dbb-c134d6eb76e1","name":"Rasmussen, Bodil Steen","name_org":"Steen Rasmussen, Bodil","orcid":"0000-0003-2190-145X","rank":7,"rolecode":"pau"}],"pmid":["34951717"],"pub":{"doi":"10.1111/aas.14023","issn":["00015172"],"issue":"3","journal":"Acta Anaesthesiologica Scandinavica","pages":"408-414","publisher":"Blackwell Munksgaard","status":"p","title":"Acta Anaesthesiologica Scandinavica","volume":"66"},"review":"Peer Reviewed","scoID":["2-s2.0-85122087835"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Other Hospitals","Undetermined","Universities","University of Copenhagen","collaboration for research in intensive care"],"PST":["Published"]},"sid":["aau-ddb415e2-594d-4ba5-b5d5-362050eff76f","ku-3a3fa994-d105-43a2-bfc4-a95738adde2e"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"Higher versus lower oxygenation targets in COVID-19 patients with severe hypoxaemia (HOT-COVID) trial : Protocol for a secondary Bayesian analysis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-088.89-010560","year":"2022","yearsub":"2022"}
{"abstract":"Inhibition of the interaction between the scaffolding protein PSD-95 and the NMDA receptor has been shown to obstruct ischemic stroke-triggered excitotoxic reactions, leading to neuronal death. The peptides NR2B9c and N-dimer are inhibitors of this interaction. Delivery of the peptides to the brain is challenging due to the general low blood–brain barrier (BBB) permeability. NR2B9c and N-dimer have therefore been conjugated to the cell-penetrating peptide (CPP) Tat, to facilitate blood–brain barrier permeation. However, the BBB permeation of Tat-NR2B9c and Tat-N-dimer has not been fully elucidated. We recently demonstrated that the BBB permeation in vitro and in vivo was lowered upon conjugation of NR2B9c or N-dimer to Tat. In the present study, we aimed to further understand the impact of cargo conjugation to Tat with respect to interaction with and permeation across the BBB in vitro and in vivo. The peptides were labeled with the fluorophore TAMRA (T) and demonstrated efficient Tat-mediated uptake into BBB endothelial cells but differed in their degree of plasma membrane interaction and embedding (T-Tat-NR2B9c = T-Tat > T-Tat-N-dimer) as well as in their chemical stability (T-Tat-N-dimer = T-Tat > T-Tat-NR2B9c). The Tat conjugates all displayed a similar degree of self-association and/or plasma protein adsorption. T-Tat-NR2B9c and T-Tat affected the BBB integrity but not the permeation of the paracellular marker C14-mannitol. T-Tat-NR2B9c and T-Tat-N-dimer displayed less efficient permeation across an in vitro model representing the healthy BBB, when compared to T-Tat, and low BBB permeation in healthy rats.","author_count":12,"contributors":["Lisa Al Humaidan, Emma","Lund Pedersen, Sidse","Burkhart, Annette","Laurfelt Munch Rasmussen, Charlotte","Moos, Torben","Fuchs, Peter","Alves Fernandes, Eduardo Felipe","Ozgür, Burak","Strømgaard, Kristian","Bach, Anders","Brodin, Birger","Kristensen, Mie"],"cuid":["S02-090.04-822222"],"filters":{"added":"2022-06","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Kristensen, Mie"],"keyword":["Brain drug delivery","Cell penetrating peptide","Ischemic stroke","TAT"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Neurobiological Research and Drug Delivery"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-AAU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the cell penetrating peptide tat facilitates effective internalization of psd 000000000095 inhibitors into blood brain barrier endothelial cells but less efficient permeation across the blood brain barrier i in i i vitro i and i in vivo i","src":["aau","ku"],"src-code":["DI-U-AAU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3389/fddev.2022.854703","version":"Published Version"},"id":"S02-090.04-822222","identifier":[{"id":"105003731645","type":"scopus"}],"ids":["aau-03edc853-4a7a-4fa8-bfdf-147c4ba8fcf5","ku-a04f6606-d2d6-41b9-aab5-2dd231c3a34e"],"keyword":["blood-brain barrer","brain drug delivery","cell-penetrating peptide","ischemic stroke","tat"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-9930B0482F52261C8E3CA121D2A02529"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/305114239/fddev_02_854703.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.3389/fddev.2022.854703","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University","Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Neurobiology Research and Drug Delivery"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Neurobiological Research and Drug Delivery"],"nora_code":"DI-OT","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Pharmacy, Department of Pharmacy"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Emma","key":"lisaalhumaidanpau","last":"Lisa Al Humaidan","name":"Lisa Al Humaidan, Emma","rank":1,"rolecode":"pau"},{"affno":"","first":"Sidse","key":"lundpedersenpau","last":"Lund Pedersen","name":"Lund Pedersen, Sidse","rank":2,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Annette","key":"burkhartpau","last":"Burkhart","locid":"7b6bd909-a011-463c-9e09-3623fee043b3","name":"Burkhart, Annette","orcid":"0000-0003-2086-4693","rank":3,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Charlotte Laurfelt Munch","key":"rasmussenpau","last":"Rasmussen","locid":"608faa0d-42e3-46c7-bbeb-95118471e801","name":"Rasmussen, Charlotte Laurfelt Munch","orcid":"0000-0001-6535-3729","rank":4,"rolecode":"pau"},{"affno":"2 1","corresponding":null,"country":"dk","first":"Torben","key":"moospau","last":"Moos","locid":"e51cbd29-97d2-42d8-bbca-11f026378a2f","name":"Moos, Torben","rank":5,"rolecode":"pau"},{"affno":"","first":"Peter","key":"fuchspau","last":"Fuchs","name":"Fuchs, Peter","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Eduardo Filipe Alves","key":"fernandespau","last":"Fernandes","name":"Fernandes, Eduardo Filipe Alves","rank":7,"rolecode":"pau"},{"affno":"3","first":"Burak","key":"ozgürpau","last":"Ozgür","locid":"e24027b0-be57-4348-8a2d-3301a5e7ba99","name":"Ozgür, Burak","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kristian","key":"strømgaardpau","last":"Strømgaard","name":"Strømgaard, Kristian","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders","key":"bachpau","last":"Bach","name":"Bach, Anders","rank":10,"rolecode":"pau"},{"affno":"3","first":"Birger Brodin","key":"larsenpau","last":"Larsen","locid":"5cbca78f-7ea7-45f1-bf9b-52b468d2aa84","name":"Brodin, Birger","name_org":"Larsen, Birger Brodin","rank":11,"rolecode":"pau"},{"affno":"3","first":"Mie","key":"kristensenpau","last":"Kristensen","locid":"f431ca62-aa71-4250-bc1b-f06ff545ec3d","name":"Kristensen, Mie","orcid":"0000-0002-4086-5266","rank":12,"rolecode":"pau"}],"pub":{"doi":"10.3389/fddev.2022.854703","issn":["26740850"],"journal":"Frontiers in Drug Delivery","paperid":"854703","publisher":"Frontiers Media SA","publisher_org":"Frontiers Media S.A.","status":"p","title":"Frontiers in Drug Delivery","volume":"2"},"review":"Peer Reviewed","scoID":["2-s2.0-105003731645"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-03edc853-4a7a-4fa8-bfdf-147c4ba8fcf5","ku-a04f6606-d2d6-41b9-aab5-2dd231c3a34e"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"The Cell-Penetrating Peptide Tat Facilitates Effective Internalization of PSD-95 Inhibitors Into Blood–Brain Barrier Endothelial Cells but less Efficient Permeation Across the Blood–Brain Barrier<i> In</i> <i>Vitro</i> and <i>In Vivo</i>","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-090.04-822222","year":"2022","yearsub":"2022"}
{"abstract":"Background Singing for Lung Health (SLH) was non-inferior to physical exercise training in improving 6-minute walking test distance (6MWD) and quality of life (St. George’s Respiratory Questionnaire (SGRQ)) within a 10-week pulmonary rehabilitation (PR) programme for COPD in our recent randomised controlled trial (RCT) (NCT03280355). Previous studies suggest that singing improves lung function, respiratory control and dyspnoea, however this has not yet been convincingly confirmed. Therefore, this study aimed to explore the impact of SLH on physiological parameters and the associations with achieving the minimal important difference (MID) in 6MWD and/or SGRQ. Methods We conducted post hoc, per-protocol analyses mainly of the SLH group of the RCT, exploring associations with 6MWD and SGRQ results by stratifying into achieving versus not-achieving 6MWD-MID (≥30 m) and SGRQ-MID (≤−4 points): changes in lung function, inspiratory muscle strength/control, dyspnoea, and heart rate response using logistic regression models. Further, we explored correlation and association in achieving both 6MWD-MID and SGRQ-MID (or in neither/nor) using Cohen’s κ and Cochran-Mantel-Haenszel Test. Results In the SLH study group (n=108), 6MWD-MID was achieved by 31/108 (29%) and in SGRQ by 53/108 (49%). Baseline factors associated with achieving MID in either outcome included short baseline 6MWD and high body mass index. Achieving 6MWD-MID was correlated with improved heart rate response (OR: 3.14; p=0.03) and achieving SGRQ-MID was correlated with improved maximal inspiratory pressure (OR: 4.35; p=0.04). Neither outcome was correlated with significant spirometric changes. Agreement in achieving both 6MWD-MID and SGRQ-MID was surprisingly insignificant. Conclusions This explorative post hoc study suggests that SLH is associated with physiological changes after short-term PR for COPD. Future physiological studies will help us to understand the mechanisms of singing in COPD. Our study furthermore raises concern about poor agreement between subjective and objective benefits of PR despite state-of-the-art tools.","author_count":6,"contributors":["Kaasgaard, Mette","Rasmussen, Daniel Bech","Løkke, Anders","Vuust, Peter","Hilberg, Ole","Bodtger, Uffe"],"cuid":["S02-093.09-030316"],"filters":{"added":"2022-06","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Kaasgaard, Mette"],"keyword":["Emphysema","Exercise","Lung physiology","Pulmonary rehabilitation","Respiratory muscles"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-ART","DI-U"],"level3":{"ART":["DI-ART-ALL","DI-ART-RDAM"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-ART-RDAM","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"physiological changes related to 000000000010 weeks of singing for lung health in patients with copd","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/bmjresp-2022-001206","version":"Published Version"},"id":"S02-093.09-030316","identifier":[{"id":"PMC9096537","type":"pmcid"},{"id":"85129926685","type":"scopus"},{"id":"35545297","type":"pmid"}],"ids":["au-f48ccbbe-b582-4083-9df2-ffd36d603ce4","sdu-2dc4d069-1683-441b-86a8-2a453e22816f"],"keyword":["emphysema","exercise","lung physiology","pulmonary rehabilitation","respiratory muscles"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-17AB507D721AD9104A678543574AB757"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/202687677/Open_Access_Version.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/bmjresp-2022-001206","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Center for Music In the Brain"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Regional Health Research","SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Zealand University Hospital"],"nora_code":"DI-U-SDU","used":1},{"affno":"4","country":"dk","key":"rdam the royal danish academy of music","l2":"DI-ART","l2n":"Artistic Higher Education Institutions","l3":"DI-ART-RDAM","l3nn":"RDAM The Royal Danish Academy of Music","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RDAM The Royal Danish Academy of Music","namevar":["Royal Academy of Music"],"nora_code":"DI-ART-RDAM","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"Mette","key":"kaasgaardpau","last":"Kaasgaard","locid":"fc5784b6-66d8-4b92-8c4a-74bf4628c9c3","name":"Kaasgaard, Mette","orcid":"0000-0003-3833-2943","rank":1,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Daniel Bech","key":"rasmussenpau","last":"Rasmussen","locid":"18525822-35fd-4cd8-afdd-a608be44cc84","name":"Rasmussen, Daniel Bech","orcid":"0000-0003-1213-9483","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Anders","key":"løkkepau","last":"Løkke","locid":"db3d3870-0459-4783-8f0b-6a8e5d9dce78","name":"Løkke, Anders","orcid":"0000-0002-6905-4141","rank":3,"rolecode":"pau"},{"affno":"1 4","corresponding":null,"country":"dk","first":"Peter","key":"vuustpau","last":"Vuust","locid":"2c697ab6-9b06-4a16-a687-c8cdbd56f661","name":"Vuust, Peter","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Ole","key":"hilbergpau","last":"Hilberg","locid":"6c545c65-1d94-45a3-a8b4-f90eae06d248","name":"Hilberg, Ole","orcid":"0000-0002-3075-3463","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Uffe","key":"bodtgerpau","last":"Bodtger","locid":"2f4e70da-63bb-4b8d-af09-2a959d6df5e8","name":"Bodtger, Uffe","orcid":"0000-0002-1231-9209","rank":6,"rolecode":"pau"}],"pmid":["35545297"],"pub":{"doi":"10.1136/bmjresp-2022-001206","issn":["20524439"],"issue":"1","journal":"BMJ Open Respiratory Research","paperid":"e001206","publisher":"BMJ Group","publisher_org":"B M J Group","status":"p","title":"BMJ Open Respiratory Research","title_org":"B M J Open Respiratory Research","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-85129926685"],"search":{"DAF":["Aarhus University","All Artistic Higher Education Institutions","All Danish Affiliations","All Hospitals","All Universities","Artistic Higher Education Institutions","DI-ALL","DI-ART","DI-ART-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region Zealand","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-f48ccbbe-b582-4083-9df2-ffd36d603ce4","sdu-2dc4d069-1683-441b-86a8-2a453e22816f"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Physiological changes related to 10 weeks of singing for lung health in patients with COPD","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-093.09-030316","year":"2022","yearsub":"2022"}
{"abstract":"Temperate bacteriophages can switch between two life cycles following infection of a host bacterium: the lytic or lysogenic life cycle. The choice between these is controlled by a bistable genetic switch. We investigated the genetic switch of the lactococcal temperate bacteriophage, TP901-1, which is controlled by two regulatory proteins, the Clear 1 (CI) repressor and modulator of repression (MOR) antirepressor. CI consists of a DNA-binding N-terminal domain and a C-terminal domain responsible for oligomerization, connected by a flexible interdomain linker. Full-length CI is hexameric, whereas the truncated version CI with 58 C-terminal residues truncated (CIΔ58), missing the second C-terminal subdomain, is dimeric, but binds with the same affinity as full-length CI to the OL operator site, responsible for lytic genes transcription repression. Three variants of CIΔ58 with shorter, longer, and PP substituted linkers were produced and confirmed by circular dichroism spectroscopy and nanodifferential scanning fluorimetry to be well folded. With small-angle X-ray scattering, we delineated the conformational space sampled by the variants and wild-type in solution and found that shortening and lengthening the linker decrease and increase this, respectively, as also substantiated by molecular dynamics and as intended. Isoelectric focusing electrophoresis confirmed that all variants are able to bind to the MOR antirepressor. However, using electrophoretic mobility shift assays, we showed that shortening and lengthening the linker lead to a 94 and 17 times decrease in affinity to OL, respectively. Thus, an appropriate linker length appears to be crucial for appropriate DNA-binding and subsequent TP901-1 genetic switch function.","author_count":6,"contributors":["Varming, Anders Kokkenborg","Rasmussen, Kim Krighaar","Zong, Zhiyou","Waaben Thulstrup, Peter","Kilstrup, Mogens","Lo Leggio, Leila"],"cuid":["S02-095.71-035846"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Lo Leggio, Leila"],"keyword":["Bacteriophage","Flexible linker","Genetic switch","Lysogeny","Repressor"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the flexible linker modulates the binding affinity of the tp000000000901 000000000001 ci phage repressor to dna","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/258981909/febs.16238.pdf","version":"Authors Final Version"},"id":"S02-095.71-035846","identifier":[{"id":"85118330867","type":"scopus"},{"id":"34665941","type":"pmid"}],"ids":["dtu-8e29b6ac-4ff5-49ce-9a16-917d28ac3668","ku-3d05c70c-8711-4117-9587-18beeb11f2cd"],"keyword":["Bacteriophage","Flexible linker","Genetic switch","Lysogeny","Repressor"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-8BE3D2C5AACA5288E929EAAC716D1349"],"oa_link":[{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/300764448/ASDA_febs.16238.pdf","version":"Authors Final Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/258981909/febs.16238.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Chemistry, Department of Chemistry"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Biotechnology and Biomedicine","Technical University of Denmark, Department of Biotechnology and Biomedicine, Section for Microbial and Chemical Ecology, Metabolic Signaling and Regulation"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","first":"Anders Kokkenborg","key":"varmingpau","last":"Varming","locid":"6e74f1ad-2605-40bb-a45e-7d34896e6f35","name":"Varming, Anders Kokkenborg","orcid":"0000-0001-6865-990X","rank":1,"rolecode":"pau"},{"affno":"1","first":"Kim Krighaar","key":"rasmussenpau","last":"Rasmussen","locid":"034b2040-ed8d-4f78-a082-bbf70c6d6d95","name":"Rasmussen, Kim Krighaar","rank":2,"rolecode":"pau"},{"affno":"1","first":"Zhiyou","key":"zongpau","last":"Zong","locid":"14d88786-31cb-40cd-a4e2-5c0e6652228d","name":"Zong, Zhiyou","orcid":"0000-0002-4453-7331","rank":3,"rolecode":"pau"},{"affno":"1","first":"Peter Waaben","key":"thulstruppau","last":"Thulstrup","locid":"043e3b07-d7e1-4f25-9359-6f55b4e2ba92","name":"Thulstrup, Peter Waaben","orcid":"0000-0002-9241-4352","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Mogens","key":"kilstruppau","last":"Kilstrup","locid":"f852c88c-c2dd-4c1c-bb1d-119775a3d7e7","name":"Kilstrup, Mogens","orcid":"0000-0002-3900-723X","rank":5,"rolecode":"pau"},{"affno":"1","first":"Leila","key":"loleggiopau","last":"Lo Leggio","locid":"9b2c31e6-b95b-4a32-a86f-6c3c0d53fd03","name":"Lo Leggio, Leila","orcid":"0000-0002-5135-0882","rank":6,"rolecode":"pau"}],"pmid":["34665941"],"pub":{"doi":"10.1111/febs.16238","issn":["14321033","1742464X"],"issn_org":["1742464X"],"issue":"4","journal":"FEBS Journal","pages":"1135-1148","publisher":"Wiley","status":"p","title":"FEBS Journal","volume":"289"},"review":"Peer Reviewed","scoID":["2-s2.0-85118330867"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-8e29b6ac-4ff5-49ce-9a16-917d28ac3668","ku-3d05c70c-8711-4117-9587-18beeb11f2cd"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"The flexible linker modulates the binding affinity of the TP901-1 CI phage repressor to DNA","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-095.71-035846","year":"2022","yearsub":"2022"}
{"abstract":"Background: Fascicular heart blocks can progress to complete heart blocks, but this risk has not been evaluated in a large general population. Objective: The purpose of this study was to investigate the association between various types of fascicular blocks diagnosed by electrocardiographic (ECG) readings and the risk of incident higher degree atrioventricular block (AVB), syncope, pacemaker implantation, and death. Methods: We studied primary care patients referred for ECG recording between 2001 and 2015. Cox regression models were used to estimate hazard ratios (HRs) as well as absolute risks of cardiovascular outcomes. Results: Of 358,958 primary care patients (median age 54 years; 55% women), 13,636 (3.8%) had any type of fascicular block. Patients were followed up to 15.9 years. We found increasing HRs of incident syncope, pacemaker implantation, and third-degree AVB with increasing complexity of fascicular block. Compared with no block, isolated left anterior fascicular block (LAFB) was associated with 0%–2% increased 10-year risk of developing third-degree AVB (HR 1.6; 95% confidence interval [CI] 1.25–2.05), whereas right bundle branch block combined with LAFB and first-degree AVB was associated with up to 23% increased 10-year risk (HR 11.0; 95% CI 7.7–15.7), depending on age and sex group. Except for left posterior fascicular block (HR 2.09; 95% CI 1.87–2.32), we did not find any relevant associations between fascicular block and death. Conclusion: We found that higher degrees of fascicular blocks were associated with increasing risk of syncope, pacemaker implantation, and complete heart block, but the association with death was negligible.","author_count":16,"contributors":["Nyholm, Benjamin Chris","Ghouse, Jonas","Ji-Young Lee, Christina","Rasmussen, Peter Vibe","Pietersen, Adrian","Hansen, Steen Møller","Torp-Pedersen, Christian","Køber, Lars","Haunso, Stig","Olesen, Morten Salling","Svendsen, Jesper Hastrup","Graff, Claus","Holst, Anders Gaarsdal","Nielsen, Jonas Bille","Skov, Morten Wagner"],"cuid":["S02-097.96-007317"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Nyholm, Benjamin Chris"],"country":["Norway"],"glorg":["All Global Affiliations","Norwegian University of Science and Technology"],"keyword":["Complete heart block","Electrocardiography","Fascicular heart block","Pacemaker implantation","Risk prediction"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-OTH"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-HO-OTH","DI-U-AAU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"fascicular heart blocks and risk of adverse cardiovascular outcomes results from a large primary care population","src":["aau","ku"],"src-code":["DI-U-AAU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85118526253&partnerID=8YFLogxK","version":"Other Version"},"id":"S02-097.96-007317","identifier":[{"id":"34673253","type":"pmid"},{"id":"85118526253","type":"scopus"}],"ids":["aau-96fde0f7-9e23-4b60-8249-460caa1e8ed7","ku-5b44f1da-1bd3-49f8-9cdd-3ff06053e316"],"keyword":["Complete heart block","Electrocardiography","Fascicular heart block","Pacemaker implantation","Risk prediction"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-0BEC459A939B3F385E04683B6978F6B8"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Rigshospitalet, Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","country":"dk","key":"other hospitals","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-OTH","l3nl":"Other Hospitals","l3nn":"Other Hospitals","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Hospitals","namevar":["Copenhagen General Practitioners’ Laboratory"],"nora_code":"DI-HO-OTH","used":1},{"affno":"4","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, CardioTech"],"nora_code":"DI-U-AAU","used":1},{"affno":"5","country":"dk","key":"ssi statens serum institut","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-SSI","l3nn":"SSI Statens Serum Institut","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SSI Statens Serum Institut","namevar":["Statens Serum Institut"],"nora_code":"DI-GV-SSI","used":1},{"affno":"6","country":"no","key":"norwegian university of science and technology","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"Norwegian University of Science and Technology","used":1}],"person":[{"affno":"1 2","first":"Benjamin Chris","key":"nyholmpau","last":