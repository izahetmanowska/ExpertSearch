k","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Holbæk Hospital, Research Unit of Medicine (Holbæk)"],"nora_code":"DI-U-SDU","used":1},{"affno":"5","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Regional Hospitals Zealand"],"nora_code":"DI-HO-ZEA","used":1},{"affno":"6","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Anaesthesiology","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Marija","key":"barbateskovicpau","last":"Barbateskovic","name":"Barbateskovic, Marija","rank":1,"rolecode":"pau"},{"affno":"1 2 3","corresponding":null,"first":"Olav L","key":"schjørringpau","last":"Schjørring","locid":"7dac619e-9b5c-46ac-9170-10ac13165da5","name":"Schjørring, Olav Lilleholt","name_org":"Schjørring, Olav L","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sara","key":"russokrausspau","last":"Russo Krauss","name":"Russo Krauss, Sara","rank":3,"rolecode":"pau"},{"affno":"1 4 5","corresponding":null,"first":"Janus C.","key":"jakobsenpau","last":"Jakobsen","locid":"06691aa2-020b-4869-a6d9-56ac223008cc","name":"Jakobsen, Janus Christian","name_org":"Jakobsen, Janus C.","orcid":"0000-0002-3642-2120","rank":4,"rolecode":"pau"},{"affno":"6","first":"Christian S.","key":"meyhoffpau","last":"Meyhoff","locid":"4d112eed-e878-476d-8f1f-df10d39439b2","name":"Meyhoff, Christian S.","orcid":"0000-0002-4885-4609","rank":5,"rolecode":"pau"},{"affno":"","first":"Rikke M","key":"dahlpau","last":"Dahl","name":"Dahl, Rikke M","rank":6,"rolecode":"pau"},{"affno":"1 2 3","corresponding":null,"country":"dk","first":"Bodil S","key":"rasmussenpau","last":"Rasmussen","locid":"3162c449-94c3-4d28-8dbb-c134d6eb76e1","name":"Rasmussen, Bodil Steen","name_org":"Rasmussen, Bodil S","orcid":"0000-0003-2190-145X","rank":7,"rolecode":"pau"},{"affno":"6 1","first":"Anders","key":"pernerpau","last":"Perner","locid":"8a389541-d529-4ee3-8364-66bfc85f77c9","name":"Perner, Anders","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jørn","key":"wetterslevpau","last":"Wetterslev","name":"Wetterslev, Jørn","rank":9,"rolecode":"pau"}],"pmid":["31773728"],"pub":{"doi":"10.1002/14651858.cd012631.pub2","issn":["13616137","1469493X"],"issn_org":["13616137"],"issue":"11","journal":"Cochrane Database of Systematic Reviews","paperid":"CD012631","publisher":"Wiley","status":"p","title":"Cochrane Database of Systematic Reviews","title_org":"The Cochrane Database of Systematic Reviews","volume":"2019"},"review":"Peer Reviewed","scoID":["2-s2.0-85075715882","2-s2.0-85109579032"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Region Zealand","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-3a4d5127-5a9e-4b29-851e-cfd5f32a5658","ku-c77e24ec-84df-4d03-92bd-127c25621ed8","sdu-f7eed0fc-07b2-40a5-a87d-6b0a2f226c38"],"src":["AAU Aalborg University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Higher versus lower fraction of inspired oxygen or targets of arterial oxygenation for adults admitted to the intensive care unit","type":"Journal Review","url":"https:/