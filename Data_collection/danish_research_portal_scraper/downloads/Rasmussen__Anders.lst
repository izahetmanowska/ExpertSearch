y of Science","status":"p","title":"PLoS Pathogens","title_org":"PLoS pathogens","volume":"17"},"review":"Peer Reviewed","scoID":["2-s2.0-85119930268"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Governmental Institutions","All Miscellaneous","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Governmental Institutions","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-70f631cc-bc97-4fe9-8853-0a6cd62c457f","ku-b492d07f-b689-4660-8991-db5a09010c63"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"Infection, recovery and re-infection of farmed mink with SARS-CoV-2","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-005476","year":"2021","yearsub":"2021"}
{"abstract":"Background: Lung cancer is the leading cause of cancer death worldwide, but the additional economic burden regarding direct and indirect costs is largely unknown. This study provides information on the economic consequences of lung cancer on a national level. Methods: From the Danish National Patient Registry (NPR) and the Danish Civil Registration System (CPR), 53,749 patients with lung cancer were identified and matched with 214,304 controls on age, gender, region of residence and marital status in the period 1998–2010. Direct and indirect costs, health care contacts and frequency, medication and social transfer payments were extracted from national databases. Results: Direct health care cost were higher for lung cancer patients than controls both before and after being diagnosed with lung cancer. At the year of diagnosis, health care cost peaked with cost of €21,497 compared to €2,880 for controls. Average difference in income from employment was €+3,118 in years prior to diagnosis and €+748 after diagnosis in favor of controls. Average difference in total public transfer income was €+1,288 before and €+441 after diagnosis, with higher public transfer income for lung cancer patients. Conclusion: For both genders, lung cancer was associated with significantly higher rates of health-related costs, medication costs, public transfer income, social transfer payments and significantly lower income from employment until retirement (age 65).","author_count":7,"contributors":["Gouliaev, Anja","Risikesan, Jeyanthini","Christensen, Niels Lyhne","Rasmussen, Torben Riis","Hilberg, Ole","Ibsen, Rikke","Løkke, Anders"],"cuid":["S02-100.00-021821"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Gouliaev, Anja"],"keyword":["Case control study","Direct cost","Economic burden","Indirect cost","Lung cancer"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-PR","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-CDR","DI-PR-OTH","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"direct and indirect economic burden of lung cancer in denmark a nationwide study","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1080/20018525.2021.1951963","version":"Published Version"},"id":"S02-100.00-021821","identifier":[{"id":"000679111500001","type":"wos"},{"id":"34377377","type":"pmid"},{"id":"PMC8330737","type":"pmcid"},{"id":"85111531365","type":"scopus"}],"ids":["au-7d88115a-9720-4a8c-b4c9-feabbd61a932","sdu-44b94a83-e98c-4efb-a7c3-39862c79ad9f"],"keyword":["Lung cancer","case-control study","direct cost","economic burden","indirect cost"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-711CEB57D4B4BBDF2721500C2497AFBA"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/189207827/Open_Access_Version.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1080/20018525.2021.1951963","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Respiratory Diseases and Allergy"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Lillebælt Hospital, Research Unit of Medicine (Vejle)"],"nora_code":"DI-U-SDU","used":1},{"affno":"4","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["i2minds"],"nora_code":"DI-PR-OTH","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"Anja","key":"gouliaevpau","last":"Gouliaev","locid":"d48d50b4-27b5-42a6-a489-667d1e3be97e","name":"Gouliaev, Anja","orcid":"0000-0002-6161-5936","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Jeyanthini","key":"risikesanpau","last":"Risikesan","locid":"1a3fb314-dab7-4e8f-913b-3803634c0dd6","name":"Risikesan, Jeyanthini","rank":2,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Niels Lyhne","key":"christensenpau","last":"Christensen","locid":"602d74ce-1885-499c-90da-05dd61bb3148","name":"Christensen, Niels Lyhne","rank":3,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Torben Riis","key":"rasmussenpau","last":"Rasmussen","locid":"311942d4-5b0f-4c92-879f-8d32a246ebf6","name":"Rasmussen, Torben Riis","orcid":"0000-0002-7030-9260","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Ole","key":"hilbergpau","last":"Hilberg","locid":"6c545c65-1d94-45a3-a8b4-f90eae06d248","name":"Hilberg, Ole","orcid":"0000-0002-3075-3463","rank":5,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Rikke","key":"ibsenpau","last":"Ibsen","name":"Ibsen, Rikke","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Anders","key":"løkkepau","last":"Løkke","locid":"db3d3870-0459-4783-8f0b-6a8e5d9dce78","name":"Løkke, Anders","orcid":"0000-0002-6905-4141","rank":7,"rolecode":"pau"}],"pmid":["34377377"],"pub":{"doi":"10.1080/20018525.2021.1951963","issn":["20018525"],"issue":"1","journal":"European Clinical Respiratory Journal","paperid":"1951963","publisher":"Taylor & Francis","status":"p","title":"European Clinical Respiratory Journal","volume":"8"},"review":"Peer Reviewed","scoID":["2-s2.0-85111531365"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Private Research","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Hospitals","Other Companies","Private Research","Universities","University of Southern Denmark","i2minds"],"PST":["Published"]},"sid":["au-7d88115a-9720-4a8c-b4c9-feabbd61a932","sdu-44b94a83-e98c-4efb-a7c3-39862c79ad9f"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Direct and indirect economic burden of lung cancer in Denmark a nationwide study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-021821","year":"2021","yearsub":"2021"}
{"abstract":"Background: Aortic dilations (ectasias and aneurysms) may occur on any segment of the aorta. Pathogenesis varies between locations, suggesting that etiology and risk factors may differ. Despite this discrepancy, guidelines recommend screening of the whole aorta if 1 segmental dilation is discovered. Objectives: The purpose of this study was to determine the most dominant predictors for dilations at the ascending, arch, descending, and abdominal part of the aorta, and to establish comprehensive risk factor profiles for each aortic segment. Methods: Individuals aged 60-74 years were randomly selected to participate in DANCAVAS I+II (Danish Cardiovascular Multicenter Screening Trials). Participants underwent cardiovascular risk assessments, including blood samples, blood pressure readings, medical records, and noncontrast computed tomography scans. Adjusted odds ratios for potential risk factors of dilations were estimated by multivariate logistic analyses. Results: The study population consisted of 14,989 participants (14,235 men, 754 women) with an average age of 68 ± 4 years. The highest adjusted odd ratios for having any aortic dilation were observed when coexisting aortic dilations were present. Other noteworthy predictors included coexisting iliac dilations, hypertension, increasing body surface area, male sex, familial disposition, and atrial fibrillation, which were present in various combinations for the different aortic parts. Smoking and acute myocardial infarction were inversely associated with ascending and abdominal dilations. Diabetes was a shared protective factor. Conclusions: Risk factors differ for aortic dilations between locations. The most dominant predictor for having a dilation at any aortic segment is the presence of an aortic dilation elsewhere. This supports current guidelines when recommending a full screening of the aorta if a focal aortic dilation is discovered.","author_count":13,"contributors":["Obel, Lasse M.","Diederichsen, Axel C.","Steffensen, Flemming H.","Frost, Lars","Lambrechtsen, Jess","Busk, Martin","Urbonaviciene, Grazina","Egstrup, Kenneth","Karon, Marek","Rasmussen, Lars M.","Gerke, Oke","Bovling, Anders S.","Lindholt, Jes S."],"cuid":["S02-100.00-023006"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Obel, Lasse M."],"keyword":["Epidemiology","Population based","Prevalence","Risk Factors","abdominal and thoracic aorta","aortic dilations and aneurysms"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR","DI-HO-ZEA"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CDR","DI-HO-ZEA","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"population based risk factors for ascending arch descending and abdominal aortic dilations for 000000000060 000000000074 year old individuals","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/183255188/Obel_JACC_authors_accepted_manuscript.pdf","version":"Authors Final Version"},"funding_acknowledgement":["This study was supported by The Region of Southern Denmark, Elitary Research Center of Individualized Medicine in Arterial Diseases (CIMA), Danish Council for Independent Research, The Danish Heart Foundation, Odense University Hospital, and The Helse Foundation. The authors have reported that they have no relationships relevant to the contents of this paper to disclose."],"id":"S02-100.00-023006","identifier":[{"id":"85109202840","type":"scopus"},{"id":"34266574","type":"pmid"}],"ids":["au-8de5ae6b-13b9-4bb5-8c5e-dc3663505abd","sdu-55d04213-93bb-4225-a514-c3cf98afb5c3"],"keyword":["abdominal and thoracic aorta","aortic dilations and aneurysms","epidemiology","population-based","prevalence","risk factors"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-F2C9A86B567A3E657949E9236448674A"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/183255188/Obel_JACC_authors_accepted_manuscript.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, CIMA","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Cardiac, thoracic, and Vascular surgery (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Diagnostisk Center, Universitetsklinik for Innovative Patientforløb, Silkeborg"],"nora_code":"DI-U-AU","used":1},{"affno":"3","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Regionshospitalet Silkeborg"],"nora_code":"DI-HO-CDR","used":1},{"affno":"4","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"5","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Nykøbing Falster Sygehus"],"nora_code":"DI-HO-ZEA","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lasse M.","key":"obelpau","last":"Obel","locid":"17bb0772-8f32-409a-b977-05438dd78b3a","name":"Obel, Lasse M.","orcid":"0000-0003-0037-8962","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Axel C.","key":"diederichsenpau","last":"Diederichsen","locid":"d84be6bc-52bf-4710-9f66-0209cfab4f54","name":"Diederichsen, Axel Cosmus Pyndt","name_org":"Diederichsen, Axel C.","orcid":"0000-0002-1285-4826","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Flemming H.","key":"steffensenpau","last":"Steffensen","locid":"d071bc54-c431-4b1b-a1ec-0ce7e12c2ef6","name":"Hald Steffensen, Flemming","name_org":"Steffensen, Flemming H.","rank":3,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Lars","key":"frostpau","last":"Frost","locid":"49976e26-d720-4133-b124-24d3f371954b","name":"Frost, Lars","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jess","key":"lambrechtsenpau","last":"Lambrechtsen","locid":"364569fb-abc5-45bc-9783-cdfe7c1522b7","name":"Lambrechtsen, Jess","orcid":"0000-0002-9976-9981","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Martin","key":"buskpau","last":"Busk","locid":"c2b03ccc-2346-4b69-bd24-b379014c5a33","name":"Busk, Martin","rank":6,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"country":"dk","first":"Grazina","key":"urbonavicienepau","last":"Urbonaviciene","locid":"1b132b5a-1328-4359-9f72-e4773d2e2577","name":"Urbonaviciene, Grazina","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kenneth","key":"egstruppau","last":"Egstrup","locid":"12389a61-a119-4ff8-ba31-4b0accb0bbc5","name":"Egstrup, Kenneth","orcid":"0000-0002-6214-8751","rank":8,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"first":"Marek","key":"karonpau","last":"Karon","name":"Karon, Marek","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars M.","key":"rasmussenpau","last":"Rasmussen","locid":"bf5d4e3b-cb51-4e61-a6d1-e22445213324","name":"Rasmussen, Lars Melholt","name_org":"Rasmussen, Lars M.","orcid":"0000-0001-5795-4794","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Oke","key":"gerkepau","last":"Gerke","locid":"596baeb1-6754-4d53-948f-30470dd1d976","name":"Gerke, Oke","orcid":"0000-0001-6335-3303","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders S.","key":"bovlingpau","last":"Bovling","locid":"95d51da0-20a5-45db-bfa4-357ffd7e064c","name":"Sarkisian Bøvling, Anders","name_org":"Bovling, Anders S.","orcid":"0000-0001-9713-7350","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jes S.","key":"lindholtpau","last":"Lindholt","locid":"27d83f24-51cd-4d27-9e32-7501319bdf2b","name":"Lindholt, Jes Sanddal","name_org":"Lindholt, Jes S.","orcid":"0000-0001-9536-4488","rank":13,"rolecode":"pau"}],"pmid":["34266574"],"pub":{"doi":"10.1016/j.jacc.2021.04.094","issn":["07351097","15583597"],"issn_org":["07351097"],"issue":"3","journal":"Journal of the American College of Cardiology","pages":"201-211","publisher":"Elsevier Inc.","status":"p","title":"Journal of the American College of Cardiology","volume":"78"},"review":"Peer Reviewed","scoID":["2-s2.0-85109202840"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region Zealand","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-8de5ae6b-13b9-4bb5-8c5e-dc3663505abd","sdu-55d04213-93bb-4225-a514-c3cf98afb5c3"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Population-Based Risk Factors for Ascending, Arch, Descending, and Abdominal Aortic Dilations for 60-74–Year-Old Individuals","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-023006","year":"2021","yearsub":"2021"}
{"abstract":"BACKGROUND: Coronavirus disease (COVID-19) primarily affects the lungs and lower airways and may present as hypoxaemic respiratory failure requiring admission to an intensive care unit (ICU) for supportive treatment. Here, supplemental oxygen remains essential for COVID-19 patient management, but the optimal dosage is not defined. We hypothesize that targeting an arterial partial pressure of oxygen of 8 kPa throughout ICU admission is superior to targeting 12 kPa. METHODS: The Handling Oxygenation Targets in ICU patients with COVID-19 (HOT-COVID) trial, is an investigator-initiated, pragmatic, multicentre, randomized, parallel-group trial comparing a lower oxygenation target versus a higher oxygenation target in adult ICU patients with COVID-19. The primary outcome is days alive without life-support (use of mechanical ventilation, renal replacement therapy or vasoactive therapy) at day 90. Secondary outcomes are 90-day and 1-year mortality, serious adverse events in the ICU and days alive and out of hospital in the 90-day period, health-related quality-of-life at 1 year, and health economic analyses. One-year follow-up of cognitive and pulmonary function is planned in a subgroup of Danish patients. We will include 780 patients to detect or reject an absolute increase in days alive without life-support of 7 days with an α of 5% and a β of 20%. An interim analysis is planned after 90-day follow-up of 390 patients. CONCLUSIONS: The HOT-COVID trial will provide patient-important data on the effect of two oxygenation targets in ICU patients with COVID-19 and hypoxia. This protocol paper describes the background, design and statistical analysis plan for the trial.","author_count":18,"contributors":["Nielsen, Frederik Mølgaard","Lass Klitgaard, Thomas","Crescioli, Elena","Aagaard, Søren Rosborg","Andreasen, Anne Sofie","Musaeus Poulsen, Lone","Siegemund, Martin","Craveiro Brøchner, Anne","Bestle, Morten H","Andi Iversen, Susanne","Brand, Björn A","Laake, Jon Henrik","Grøfte, Thorbjørn","Hildebrandt, Thomas","Lange, Theis","Perner, Anders","Schjørring, Olav Lilleholt","Rasmussen, Bodil Steen"],"cuid":["S03-093.75-001458"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"continent":["Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Mølgaard Nielsen, Frederik","Nielsen, Frederik Mølgaard"],"country":["Norway","Switzerland"],"glorg":["All Global Affiliations","Oslo University Hospital","University Hospital Basel","University Hospital of Basel","University of Basel"],"keyword":["Covid 19","Hypoxia","Intensive Care Units","Oxygen"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-OTH","DI-HO-SDR","DI-HO-ZEA"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU","DI-U-UND"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-OTH","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU","DI-U-UND"]},"review":"pr","rtype":["clu"],"sorti":"handling oxygenation targets in icu patients with covid 000000000019 protocol and statistical analysis plan in the hot covid trial","src":["aau","ku","sdu"],"src-code":["DI-U-AAU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"https://www.ncbi.nlm.nih.gov/pmc/about/copyright/","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC8441913/pdf/AAS-9999-0.pdf","version":"Published Version"},"id":"S03-093.75-001458","identifier":[{"id":"PMC8441913","type":"pmcid"},{"id":"85112238395","type":"scopus"},{"id":"34310694","type":"pmid"}],"ids":["aau-1cc22e09-5e40-44e0-beb3-25309ed8a1c6","ku-9386dc25-4f64-4a40-94fe-b9bd72e2b595","sdu-99b4ced3-2690-4f34-ab12-617bc07eb9a2"],"keyword":["COVID-19","hypoxia","intensive care units","oxygen"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["