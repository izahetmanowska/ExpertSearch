2","corresponding":null,"country":"dk","first":"David Martin","key":"boertmannpau","last":"Boertmann","locid":"3fd0130d-e557-4b1b-af39-8a3f236852ed","name":"Boertmann, David","name_org":"Boertmann, David Martin","orcid":"0000-0002-5620-7356","rank":3,"rolecode":"pau"},{"affno":"","first":"Janne","key":"frittrasmussenpedh","last":"Fritt-Rasmussen","name":"Fritt-Rasmussen, Janne","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Katrine","key":"raundruppedh","last":"Raundrup","name":"Raundrup, Katrine","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Anders","key":"mosbechpedh","last":"Mosbech","name":"Mosbech, Anders","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9788771566598"],"pages":"36-61","publisher":"Aarhus University, DCE - Danish Centre for Environment and Energy","series":"Scientific Report from DCE - Danish Centre for Environment and Energy","status":"p","title":"South Greenland - Regional environmental baseline assessment for mining activities"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-88b9d389-ce27-46c4-afcc-c9aebeb7b8f3"],"src":["AU Aarhus University"],"title":"Biodiversity and biologically important and protected areas.","type":"Report Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-207325","year":"2023","yearsub":"2023"}
{"abstract":"Purpose: The purpose of this single-blinded, 2-centre, randomized controlled trial was to test if near-infrared (NIR) autofluorescence image guidance for parathyroid gland (PG) detection during total thyroidectomy can reduce the incidence of hypoparathyroidism in both malignant and benign cases. Method: Patients admitted for primary or completion total thyroidectomy were randomized to either the NIR intervention group or the standard care NONIR (no near infrared) group. The primary endpoint was the rate of hypoparathyroidism at the 3-month follow-up, defined as hypocalcemia and inappropriately low parathyroid hormone levels and/or continuous treatment with active vitamin D. The secondary endpoint was the PG identification rate. Results: A total of 147 patients were included of whom 73 were allocated to NIR. Primary or completion thyroidectomy was conducted in 84 and 63 cases, respectively. A total of 130 completed 3 months follow-up. Postoperative hypoparathyroidism in the NIR group at 12 h, 1 month and 3 months was, respectively, 31.8, 14.1, 6.5% compared with 35.9, 18.9, 11.8% in the NONIR group (all p > 0.46). In the NIR group, the identification rate of PGs was 69.5% (146 of 210 PGs), and 9% (19 of 210 PGs) were identified only due to additional use of NIR. For 15 out of 69 patients (21.7%) additionally PGs was found. Conclusion: Hypoparathyroidism was nominally less frequent in the NIR group, although not statistically significant. Further studies are needed to confirm if NIR may be a supportive PG identification tool to minimize the number of PG which would have been otherwise missed, especially during more complicated thyroid procedures. Trial registry: ClinicalTrials.gov: NCT04193332. Registration date: 16.08.2019.","author_count":17,"contributors":["Lykke, Eva","Christensen, Anders","Juhl, Karina","Feldt-Rasmussen, Ulla","Hitz, Mette Friberg","Svenningsen Sjöstedt, Sannia Mia","Hahn, Christoffer Holst","Kraik Svensson, Ditte Maria","Kanstrup Springborg, Karoline","Stage, Mads Georg","Hvilsom, Gitte Bjørn","Hilsted, Linda Maria","Dahl, Morten","Lelkaitis, Giedrius","Kjaer, Andreas","Homøe, Preben","von Buchwald, Christian"],"cuid":["S01-000.00-677706"],"filters":{"added":"2023-08","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Hypocalcemia","Hypoparathyroidism","Parathyroid glands","Thyroidectomy"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"effect of near infrared autofluorescence guided total thyroidectomy on postoperative hypoparathyroidism a randomized clinical trial","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"https://www.ncbi.nlm.nih.gov/pmc/about/copyright/","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC9971666/pdf/405_2023_Article_7867.pdf","version":"Published Version"},"id":"S01-000.00-677706","identifier":[{"id":"PMC9971666","type":"pmcid"},{"id":"85148998852","type":"scopus"},{"id":"36853388","type":"pmid"}],"ids":["ku-21258c28-03ac-4abf-af0d-a24fd560cdf2"],"keyword":["Hypocalcemia","Hypoparathyroidism","Near-infrared autofluorescence","Parathyroid glands","Thyroidectomy"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-C05F9BB224E589D406BFAE935E3FE6C9"],"oa_link":[{"access":"oa","license":"https://www.ncbi.nlm.nih.gov/pmc/about/copyright/","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC9971666/pdf/405_2023_Article_7867.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1 2","first":"Eva","key":"lykkepau","last":"Lykke","locid":"dfeb73f1-a704-4e43-8429-93aa7c6d1e1d","name":"Lykke, Eva","rank":1,"rolecode":"pau"},{"affno":"2 1","first":"Anders","key":"christensenpau","last":"Christensen","locid":"c4fc2962-72f2-4db6-a758-a762332e496f","name":"Christensen, Anders","rank":2,"rolecode":"pau"},{"affno":"2 1","first":"Karina","key":"juhlpau","last":"Juhl","locid":"0ec9cccd-ec69-40d4-b506-34dcb3cf01a8","name":"Juhl, Karina","rank":3,"rolecode":"pau"},{"affno":"1","first":"Ulla","key":"feldtrasmussenpau","last":"Feldt-Rasmussen","locid":"b5898535-d448-4e2f-9f41-d5199873676b","name":"Feldt-Rasmussen, Ulla","rank":4,"rolecode":"pau"},{"affno":"1","first":"Mette","key":"friberghitzpau","last":"Friberg Hitz","locid":"4f1ef728-a1d0-478a-9993-4bf9d5cf4ab6","name":"Hitz, Mette Friberg","name_org":"Friberg Hitz, Mette","rank":5,"rolecode":"pau"},{"affno":"2","first":"Sannia Mia","key":"svenningsensjöstedtpau","last":"Svenningsen Sjöstedt","name":"Svenningsen Sjöstedt, Sannia Mia","rank":6,"rolecode":"pau"},{"affno":"1","first":"Christoffer","key":"holsthahnpau","last":"Holst Hahn","locid":"48ba72a8-a237-44e4-9b8b-9dcabc7be658","name":"Hahn, Christoffer Holst","name_org":"Holst Hahn, Christoffer","rank":7,"rolecode":"pau"},{"affno":"2","first":"Ditte Maria","key":"kraiksvenssonpau","last":"Kraik Svensson","name":"Kraik Svensson, Ditte Maria","rank":8,"rolecode":"pau"},{"affno":"2","first":"Ka