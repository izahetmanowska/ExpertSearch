corresponding":null,"country":"dk","first":"Jens","key":"madsenpau","last":"Madsen","locid":"ed287c2f-88ab-4d2f-8609-c89f2c2f7633","name":"Madsen, Jens","orcid":"0000-0002-6874-2970","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Volker","key":"naulinpau","last":"Naulin","locid":"68cb67c0-c64d-4fef-a301-67ab58d8ace6","name":"Naulin, Volker","orcid":"0000-0001-5452-9215","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anders Henry","key":"nielsenpau","last":"Nielsen","locid":"1d9aa958-9d84-4a3b-8300-f6fe9b0be73e","name":"Nielsen, Anders Henry","orcid":"0000-0003-3642-3905","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens Juul","key":"rasmussenpau","last":"Rasmussen","locid":"125b9658-f84c-4e0e-859e-5899413288ee","name":"Rasmussen, Jens Juul","orcid":"0000-0002-3543-690X","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-23a65d0b-924a-43d0-b499-e1aeca006023"],"src":["DTU Technical University of Denmark"],"title":"Gas puff fuelling simulation with a combined neutral/HESEL model","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-315179","year":"2016","yearsub":"2017"}
{"abstract":"The receptor is highly involved in aspects of cognition and executive function and seen to be affected in neurodegenerative diseases like Alzheimer’s disease and related to the disease pathology. Even though Parkinson’s disease (PD) is primarily a motor disorder, reports of impaired executive function are also steadily being associated with this disease. Not much is known about the pathophysiology behind this. The aim of this study was thereby twofold: (1) to investigate receptor binding levels in Parkinson’s brains and (2) to investigate whether PD associated pathology, alpha-synuclein (AS) overexpression, could be associated with alterations. Binding density for the -specific radioligand [3H]-MDL 100.907 was measured in membrane suspensions of frontal cortex tissue from PD patients. Protein levels of AS were further measured using western blotting. Results showed higher AS levels accompanied by increased receptor binding in PD brains. In a separate study, we looked for changes in receptors in the prefrontal cortex in 52-week-old transgenic mice overexpressing human AS. We performed region-specific receptor binding measurements followed by gene expression analysis. The transgenic mice showed lower binding in the frontal association cortex that was not accompanied by changes in gene expression levels. This study is one of the first to look at differences in serotonin receptor levels in PD and in relation to AS overexpression.","author_count":9,"contributors":["Rasmussen, Nadja Bredo","Olesen, Mikkel Vestergaard","Brudek, Tomasz","Plenge, Per","Klein, Anders Bue","Westin, Jenny E.","Fog, Karina","Wörtwein, Gitta","Aznar, Susana"],"cuid":["S01-000.00-410154"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"000000000005 ht000000000002a receptor binding in the frontal cortex of parkinson s disease patients and alpha synuclein overexpressing mice a postmortem study","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1155/2016/3682936","version":"Published Version"},"id":"S01-000.00-410154","identifier":[{"id":"27579212","type":"pmid"},{"id":"000381419800001","type":"wos"},{"id":"PMC4989080","type":"pmcid"},{"id":"85009350950","type":"scopus"}],"ids":["ku-1c0ad78e-ffe3-468c-8c00-37cfc4c81547"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-65674B42182CB9952B20CD32BAFDC647"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1155/2016/3682936","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/167919048/3682936.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Neuroscience, Neuropharm and Genetics"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Nadja Bredo","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Nadja Bredo","rank":1,"rolecode":"pau"},{"affno":"","first":"Mikkel Vestergaard","key":"olesenpau","last":"Olesen","name":"Olesen, Mikkel Vestergaard","rank":2,"rolecode":"pau"},{"affno":"","first":"Tomasz","key":"brudekpau","last":"Brudek","name":"Brudek, Tomasz","rank":3,"rolecode":"pau"},{"affno":"1","first":"Per","key":"plengepau","last":"Plenge","locid":"a2d14757-ab43-4174