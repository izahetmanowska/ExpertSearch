"country":"fr","key":"necker enfants malades hospital","loc":["France","Europe, EU","OECD"],"name":"Necker Enfants Malades Hospital","used":1},{"affno":"10","country":"jp","key":"national center for child health and development","loc":["Japan","Asia, East","OECD"],"name":"National Center for Child Health and Development","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Bradley S.","key":"millerpau","last":"Miller","name":"Miller, Bradley S.","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Joanne C.","key":"blairpau","last":"Blair","name":"Blair, Joanne C.","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Michael Højby","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Michael Højby","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Jan","key":"frystykpau","last":"Frystyk","locid":"f2cb8a2e-0578-4580-8e6d-9258a274faf8","name":"Frystyk, Jan","orcid":"0000-0002-5379-0961","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Anders Krogh","key":"lemmingerpau","last":"Lemminger","name":"Lemminger, Anders Krogh","rank":5,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Aristides","key":"maniatispau","last":"Maniatis","name":"Maniatis, Aristides","rank":6,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Jun","key":"moripau","last":"Mori","name":"Mori, Jun","rank":7,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Volker","key":"böttcherpau","last":"Böttcher","name":"Böttcher, Volker","rank":8,"rolecode":"pau"},{"affno":"8","corresponding":null,"first":"Ho Seong","key":"kimpau","last":"Kim","name":"Kim, Ho Seong","rank":9,"rolecode":"pau"},{"affno":"9","corresponding":null,"first":"Michel","key":"polakpau","last":"Polak","name":"Polak, Michel","rank":10,"rolecode":"pau"},{"affno":"10","corresponding":null,"first":"Reiko","key":"horikawapau","last":"Horikawa","name":"Horikawa, Reiko","rank":11,"rolecode":"pau"}],"pmid":["40400262"],"pub":{"doi":"10.1093/ejendo/lvaf096","issn":["08044643","1479683X"],"issn_org":["08044643"],"issue":"5","journal":"European Journal of Endocrinology","pages":"651-661","publisher":"Oxford University Press","status":"p","title":"European Journal of Endocrinology","volume":"192"},"review":"Peer Reviewed","scoID":["2-s2.0-105005777910"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Private Research","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Miscellaneous","Novo Nordisk","Other Research","Private Research","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-7da345ae-7ae6-4a2d-ae9f-ca2b6868aab6"],"src":["SDU University of Southern Denmark"],"title":"Efficacy, safety, and insulin-like growth factor I of weekly somapacitan in children with growth hormone deficiency : 3-year results from REAL4","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-821404","year":"2025","yearsub":"2025"}
{"abstract":"Excess aldosterone production contributes to the development of hypertension and results in fibrosis with dysfunction of the heart, vasculature and kidneys. Consequently, new agents have been developed to reduce endogenous aldosterone synthesis. The primary objective of this systematic review is to describe the BP-lowering effects of aldosterone synthase inhibitors (ASIs) in hypertensive patients and, secondly, to describe their potential renal protective effects and possible influence on cortisol production and plasma potassium. We searched PubMed, Embase and ClinicalTrials.gov and included randomized controlled and clinical trials according to PICO using the review tool Covidence. Thirteen studies were included and all demonstrated BP reduction through ASI treatment. Among patients with apparent resistant hypertension, the placebo-corrected reductions in seated systolic BP were 11.0 mmHg for baxdrostat and 9.6 mmHg for lorundrostat. A significant suppression of cortisol production was found for LCI699 (osilodrostat) but not for baxdrostat, lorundrostat, BI 690517 (vicadrostat) or dexfadrostat. Studies on BI 690517 showed a reduction in urine–albumin–creatinine ratio, indicating renal protection. ASIs may increase potassium levels. We conclude that ASIs have promising BP-lowering effects with very limited effects on cortisol production and offer reno-protective effects in chronic kidney disease. Studies on hypertensive target organ damage and cardiovascular outcomes are, however, lacking.","author_count":4,"contributors":["Rasmussen, Anders Almskou","Nordestgaard, Ketil Lehm","Simonsen, Ulf","Buus, Niels Henrik"],"cuid":["S01-000.00-825941"],"filters":{"added":"2025-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Buus, Niels Henrik"],"keyword":["Albuminuria","Blood Pressure","Chronic kidney disease","Cortisol","Hyperkalaemia","Hypertension"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"blood pressure lowering effects of aldosterone synthase inhibitors a systematic review","src":["au"],"src-code":["DI-U-AU"],"type":"djr","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1111/bcpt.70080","version":"Published Version"},"id":"S01-000.00-825941","identifier":[{"id":"105011540723","type":"scopus"},{"id":"40693351","type":"pmid"},{"id":"PMC12281267","type":"pmcid"}],"ids":["au-9d3edcc4-5baa-484c-b65f-29e277c3182c"],"keyword":["albuminuria","aldosterone synthase inhibition","blood pressure","chronic kidney disease","cortisol","hyperkalaemia","hypertension"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-1F950DFF918CDC09E89578C2D8C78C1F"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1111/bcpt.70080","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Biomedicine, Department of Biomedicine - Forskning og uddannelse, Skou-bygningen"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Anders Almskou","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Anders Almskou","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Ketil Lehm","key":"nordestgaardpau","last":"Nordestgaard","name":"Nordestgaard, Ketil Lehm","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ulf","key":"simonsenpau","last":"Simonsen","locid":"eed8d0f5-bdc4-462e-9638-d2e314b2363c","name":"Simonsen, Ulf","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Niels Henrik","key":"buuspau","last":"Buus","locid":"cb682ed6-2fe3-4664-90d6-0690462e8f80","name":"Buus, Niels Henrik","name_org":"Buus, Niels Henrik","rank":4,"rolecode":"pau"}],"pmid":["40693351"],"pub":{"doi":"10.1111/bcpt.70080","issn":["17427835"],"issue":"2","journal":"Basic & Clinical Pharmacology & Toxicology","paperid":"e70080","publisher":"Wiley-Blackwell Publishing Ltd","publisher_org":"Wiley-Blackwell Publishing Ltd.","status":"p","title":"Basic & Clinical Pharmacology & Toxicology","title_org":"Basic and Clinical Pharmacology and Toxicology","volume":"137"},"review":"Peer Reviewed","scoID":["2-s2.0-105011540723"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-9d3edcc4-5baa-484c-b65f-29e277c3182c"],"src":["AU Aarhus University"],"title":"Blood Pressure–Lowering Effects of Aldosterone Synthase Inhibitors—A Systematic Review","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-825941","year":"2025","yearsub":"2025"}
{"abstract":"Purpose We report the cognitive outcomes at 1-year in the Agents Intervening against Delirium in the ICU (AID-ICU) trial. Methods We conducted the pre-planned 1-year follow-up study at three selected Danish sites assessing cognitive outcomes in the AID-ICU trial, which randomised acutely admitted, adult ICU patients with delirium effects to haloperidol versus placebo. The primary outcome was the global index score for cognitive function at 1-year, assessed using Repeatable Battery for the Assessment of Neuropsychological Status (RBANS). Secondary outcomes included domain-specific cognitive functions in RBANS and executive function, measured by Trail-Making Tests A & B (TMT A & B). Analyses were conducted in the intention-to-treat population with non-survivors assigned lowest possible scores and multiple imputation of missing data. Results In total, 624 of 632 randomly assigned patients were included; however, 1-year cognitive outcomes were missing for 116 patients in the haloperidol group and 93 in the placebo group. Median global cognitive index scores were 40 (IQR: 40–75) in the haloperidol group versus 40 (40–72) in the placebo group (mean difference 2; 95% CI: -3 to 7; P = 0.48). We found no statistically significant differences in secondary cognitive outcomes. Conclusions We found no statistically significant differences between haloperidol and placebo for 1-year cognitive function in acutely admitted, adult ICU patients with delirium. However, due to uncertainty of the estimates we were unable to rule out any clinically important effects of haloperidol on cognitive function.","author_count":13,"contributors":["Mortensen, Camilla Bekker","Poulsen, Lone M.","Andersen-Ranberg, Nina C.","Granholm, Anders","Vestergård, Stine Rom","Rasmussen, Bodil","Kjær, Maj Brit Nørregaard","Collet, Marie Oxenbøll","Herlev, Louise Stenbryggen","Riis, Jens Østergaard","Perner, Anders","Samuelson, Karin","Mathiesen, Ole"],"cuid":["S01-000.00-829924"],"filters":{"added":"2025-10","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"und","rtype":["clu"],"sorti":"long term cognitive function following haloperidol versus placebo treatment in icu patients with delirium","src":["ku"],"src-code":["DI-U-KU"],"type":"dw","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.21203/rs.3.rs-6518974/v1","version":"Published Version"},"id":"S01-000.00-829924","ids":["ku-cf5db91c-d114-457b-85cb-ea3e31331933"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-2-1FC38898256AE049694F8C1DFD08A558"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.21203/rs.3.rs-6518974/v1","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/463576486/f5f8a49d-f398-4941-a266-3a4a143e2b89.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Camilla Bekker","key":"mortensenpau","last":"Mortensen","name":"Mortensen, Camilla Bekker","rank":1,"rolecode":"pau"},{"affno":"1","first":"Lone Musaeus Musaeus","key":"poulsenpau","last":"Poulsen","locid":"abd9a887-5a95-4dbb-97fd-42dc901fc761","name":"Poulsen, Lone M.","name_org":"Poulsen, Lone Musaeus Musaeus","rank":2,"rolecode":"pau"},{"affno":"1","first":"Nina Christine","key":"andersenranbergpau","last":"Andersen-Ranberg","locid":"80081a2f-e2e2-4706-94d5-2e4f81fa41e8","name":"Andersen-Ranberg, Nina C.","name_org":"Andersen-Ranberg, Nina Christine","rank":3,"rolecode":"pau"},{"affno":"1","first":"Anders","key":"granholmpau","last":"Granholm","locid":"1fbdc7e9-7f6e-4c83-8d15-f6d3e97d763f","name":"Granholm, Anders","orcid":"0000-0001-5799-7655","rank":4,"rolecode":"pau"},{"affno":"","first":"Stine Rom","key":"vestergårdpau","last":"Vestergård","name":"Vestergård, Stine Rom","rank":5,"rolecode":"pau"},{"affno":"1","first":"Bodil","key":"rasmussenpau","last":"Rasmussen","locid":"e23bf776-155b-4548-93af-d2d5fdddb152","name":"Rasmussen, Bodil","rank":6,"rolecode":"pau"},{"affno":"1","first":"Maj-Brit Nørregaard","key":"kjærpau","last":"Kjær","locid":"e1004550-4b86-45e5-9ed3-42b2f37f32b6","name":"Kjær, Maj Brit Nørregaard","name_org":"Kjær, Maj-Brit Nørregaard","rank":7,"rolecode":"pau"},{"affno":"1","first":"Marie Oxenbøll","key":"colletpau","last":"Collet","locid":"9d9686b5-a728-4e95-acad-3363bc48e83d","name":"Collet, Marie Oxenbøll","rank":8,"rolecode":"pau"},{"affno":"","first":"Louise Stenbryggen","key":"herlevpau","last":"Herlev","name":"Herlev, Louise Stenbryggen","rank":9,"rolecode":"pau"},{"affno":"","first":"Jens Østergaard","key":"riispau","last":"Riis","name":"Riis, Jens Østergaard","rank":10,"rolecode":"pau"},{"affno":"1","first":"Anders","key":"pernerpau","last":"Perner","locid":"8a389541-d529-4ee3-8364-66bfc85f77c9","name":"Perner, Anders","rank":11,"rolecode":"pau"},{"affno":"","first":"Karin","key":"samuelsonpau","last":"Samuelson","name":"Samuelson, Karin","rank":12,"rolecode":"pau"},{"affno":"1","first":"Ole","key":"mathiesenpau","last":"Mathiesen","locid":"6cff39d5-4c65-460c-9bff-e8253a690086","name":"Mathiesen, Ole","orcid":"0000-0003-4544-0619","rank":13,"rolecode":"pau"}],"pub":{"doi":"10.21203/rs.3.rs-6518974/v1","pages":"21","status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-cf5db91c-d114-457b-85cb-ea3e31331933"],"src":["KU University of Copenhagen"],"title":"Long-term cognitive function following haloperidol versus placebo treatment in ICU patients with delirium.","type":"Working Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-829924","year":"2025","yearsub":"2025"}
{"abstract":"Background: Mechanically ventilated patients with acute respiratory distress syndrome (ARDS) can be managed using either controlled or spontaneous (assisted) breathing modes. While both approaches are used in clinical practice, the proportion of patients receiving mechanical ventilation that allows for spontaneous breaths and the impact of this strategy on patient outcomes remain unclear. This scoping review aimed to map and summarise the scope, range and nature of the evidence for assisted versus controlled breathing in mechanically ventilated patients with ARDS, including identification of research gaps. Methods: We conducted a scoping review according to the Preferred Reporting Items for Systematic Reviews and Meta-Analyses (PRISMA) extension for scoping reviews. We searched PubMed, CINAHL, Embase and the Cochrane Library for literature on controlled versus spontaneous breathing in mechanically ventilated patients with ARDS, irrespective of severity. Studies reporting qualitative and/or quantitative data from any world region were included. Where relevant, we performed meta-analyses to summarise data, and we assessed the overall quality of evidence using the Grading of Recommendations Assessment, Development and Evaluation (GRADE) methodology. Results: Our search was completed on May 13, 2025. We identified 6827 titles, with 1193 studies assessed in full text. A total of 564 studies were included in the final review, comprising 114 clinical trials, 267 observational studies, as well as case reports, conference abstracts and surveys. Both invasive and non-invasive ventilation techniques were described. Patient-important outcomes were limited to short- and long-term survival, duration of mechanical ventilation, length of stay and complications (e.g., pneumothorax). Patient-reported long-term outcomes were rarely reported. The evidence does not conclusively favour either spontaneous or controlled mechanical ventilation. Conclusion: Our scoping review identifies extensive documentation of widespread use of spontaneous breathing techniques, with both invasive and non-invasive ventilation, in patients with ARDS. Despite data from several large observational studies and one large randomised clinical trial, the benefits and harms of spontaneous versus controlled ventilation remain unclear. The near absence of long-term, patient-reported outcomes defines an important research gap. Editorial Comment: This systematic review addresses current evidence concerning whether or not spontaneous ventilation with support or assistance is more advantageous for critically ill ventilator-dependent ARDS cases versus passive positive pressure ventilatory support. To distinguish and separate these 2 approaches in critical care treatment is challenging, and this review nicely presents the current state of evidence for this field, including knowledge gaps.","author_count":8,"contributors":["Aslam, Tayyba Naz","Lass Klitgaard, Thomas","Møller, Morten Hylander","Perner, Anders","Hofsø, Kristin","Skrubbeltrang, Conni","Rasmussen, Bodil Steen","Laake, Jon Henrik"],"cuid":["S02-084.31-822507"],"filters":{"added":"2025-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Aslam, Tayyba Naz"],"country":["Norway"],"glorg":["All Global Affiliations","Lovisenberg Diaconal University College","Oslo University Hospital","University of Oslo"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-NDR","DI-HO-OTH"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-HO-NDR","DI-HO-OTH","DI-U-AAU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"spontaneous versus controlled mechanical ventilation in patients with acute respiratory distress syndrome a scoping review","src":["aau","ku"],"src-code":["DI-U-AAU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=105012430525&partnerID=8YFLogxK","version":"Other Version"},"id":"S02-084.31-822507","identifier":[{"id":"40757745","type":"pmid"},{"id":"105012430525","type":"scopus"}],"ids":["aau-f977c354-72fa-4c42-b1f8-f3dc645d7240","ku-25434444-47ca-4ca6-9490-8aa82d601a44"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-4234333E72ED02CB74BC14A87E581FFD"],"org":[{"affno":"1","country":"no","key":"university of oslo","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"University of Oslo","used":1},{"affno":"2","country":"no","key":"oslo university hospital","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"Oslo University Hospital","used":1},{"affno":"3","country":"dk","key":"other hospitals","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-OTH","l3nl":"Other Hospitals","l3nn":"Other Hospitals","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Hospitals","namevar":["Collaboration for Research in Intensive Care"],"nora_code":"DI-HO-OTH","used":1},{"affno":"4","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Anaesthesiology and Intensive Care"],"nora_code":"DI-U-AAU","used":1},{"affno":"5","country":"dk","key":"north denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-NDR","l3nl":"North Denmark Region","l3nn":"North Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"North Denmark Region","namevar":["Aalborg University Hospital"],"nora_code":"DI-HO-NDR","used":1},{"affno":"6","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Anaesthesiology","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"7","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"8","country":"no","key":"lovisenberg diaconal university college","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"Lovisenberg Diaconal University College","used":1}],"person":[{"affno":"1 2 3","corresponding":null,"first":"Tayyba Naz","key":"aslampau","last":"Aslam","name":"Aslam, Tayyba Naz","rank":1,"rolecode":"pau"},{"affno":"3 4 5","corresponding":null,"first":"Thomas Lass","key":"klitgaardpau","last":"Klitgaard","locid":"f3e0e4b8-0772-4f4f-8be2-b99763b3917c","name":"Lass Klitgaard, Thomas","name_org":"Klitgaard, Thomas Lass","orcid":"0000-0002-8781-1206","rank":2,"rolecode":"pau"},{"affno":"3 6 7","first":"Morten Hylander","key":"møllerpau","last":"Møller","locid":"9463b017-3c43-470d-b95b-cf3cba8a27d4","name":"Møller, Morten Hylander","rank":3,"rolecode":"pau"},{"affno":"3 6 7","first":"Anders","key":"pernerpau","last":"Perner","locid":"8a389541-d529-4ee3-8364-66bfc85f77c9","name":"Perner, Anders","rank":4,"rolecode":"pau"},{"affno":"2 3 8","corresponding":null,"first":"Kristin","key":"hofsøpau","last":"Hofsø","name":"Hofsø, Kristin","rank":5,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"first":"Conni","key":"skrubbeltrangpau","last":"Skrubbeltrang","locid":"74663b05-4b0b-4638-89ad-a56ff2f2dde5","name":"Skrubbeltrang, Conni","orcid":"0000-0002-7478-8422","rank":6,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"country":"dk","first":"Bodil Steen","key":"rasmussenpau","last":"Rasmussen","locid":"3162c449-94c3-4d28-8dbb-c134d6eb76e1","name":"Rasmussen, Bodil Steen","orcid":"0000-0003-2190-145X","rank":7,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Jon Henrik","key":"laakepau","last":"Laake","name":"Laake, Jon Henrik","rank":8,"rolecode":"pau"}],"pmid":["40757745"],"pub":{"doi":"10.1111/aas.70096","issn":["00015172"],"issue":"8","journal":"Acta Anaesthesiologica Scandinavica","paperid":"e70096","publisher":"Blackwell Munksgaard","status":"p","title":"Acta Anaesthesiologica Scandinavica","volume":"69"},"review":"Peer Reviewed","scoID":["2-s2.0-105012430525"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Other Hospitals","Universities","University of Copenhagen","collaboration for research in intensive care"],"PST":["Published"]},"sid":["aau-f977c354-72fa-4c42-b1f8-f3dc645d7240","ku-25434444-47ca-4ca6-9490-8aa82d601a44"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"Spontaneous Versus Controlled Mechanical Ventilation in Patients With Acute Respiratory Distress Syndrome—A Scoping Review","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-084.31-822507","year":"2025","yearsub":"2025"}
{"abstract":"Background: The gut microbiota has been implicated in adult obesity, but the causality is still unclear. It has been hypothesized that an obesity-prone gut microbiota can be established in infancy, but only few studies have examined the early-life gut microbiota in relation to obesity in childhood, and no consistent associations have been reported. Here, we examine the association between the early-life gut microbiota and body mass index (BMI) development and body composition throughout childhood. Methods: Gut microbiota from stool were collected from 700 children in the Copenhagen Prospective Studies on Asthma in Childhood2010 (COPSAC2010) cohort at ages of 1 week, 1month, 1 year, 4 years, and 6 years and analyzed by 16S rRNA gene sequencing. Outcomes included BMI World Health Organization (WHO) Z scores (zBMI), overweight (zBMI > 1.04) and obesity (zBMI > 1.64) (0–10 years), and adiposity rebound and body composition from dual-energy X-ray absorptiometry at 6 years. Findings: The early-life gut microbiota diversity, overall composition, and individual taxon abundances in unsupervised and supervised models were not consistently associated with either current or later BMI Z scores, overweight, obesity, adiposity rebound, or body composition in childhood. Conclusions: In a deeply characterized longitudinal birth cohort, we did not observe any consistent associations between the early-life gut microbiota and BMI or risk of obesity in later childhood. While this does not conclusively rule out a relationship, it suggests that if such associations exist, they may be more complex and potentially influenced by factors emerging later in life, including lifestyle changes. Funding: COPSAC is funded by private and public research funds (all listed on www.copsac.com).","author_count":16,"contributors":["Poulsen, Christina Egeø","Vinding, Rebecca","Rasmussen, Morten Arendt","Shah, Shiraz","Trivedi, Urvish","Rodriguez, Cristina Leal","Widdowson, Michael L.","Jiang, Jie","Poulsen, Casper S.","Eliasen, Anders","Chawes, Bo","Bønnelykke, Klaus","Hansen, Camilla Hartmann Friis","Sørensen, Søren Johannes","Thorsen, Jonathan","Stokholm, Jakob"],"cuid":["S02-100.00-822835"],"filters":{"added":"2025-06","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Stokholm, Jakob"],"keyword":["16S","Childhood","GROWTH","Metagenomics","Microbiota","Obesity","RNA","Ribosomal","Translation to population health"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"no association between the early life gut microbiota and childhood body mass index and body composition","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85210742057","version":"Other Version"},"id":"S02-100.00-822835","identifier":[{"id":"85210742057","type":"scopus"},{"id":"39536756","type":"pmid"}],"ids":["dtu-6fccf5a5-d816-4358-9342-c71b03ad0279","ku-98224bad-332a-4da5-b898-5eabf618769a"],"keyword":["16S","RNA","Translation to population health","childhood","growth","metagenomics","microbiota","obesity","ribosomal"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-F5F67989110C7971FB7C65A486D31491"],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Herlev and Gentofte"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","