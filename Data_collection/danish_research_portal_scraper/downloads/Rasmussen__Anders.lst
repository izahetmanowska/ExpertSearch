ished"]},"sid":["au-dd41342a-ed63-4b82-94f0-2e37a5b9eea0","dtu-08134b2d-7c4a-4da0-abf6-0fbd85cedded","ku-5b6347ff-d000-4bdb-9c17-c239a86fec7b"],"src":["AU Aarhus University","DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Two ancient human genomes reveal Polynesian ancestry among the indigenous Botocudos of Brazil","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-093.88-028714","year":"2014","yearsub":"2014"}
{"abstract":"Dialogic reading, in which the reader prompts the child to speak while listening to the story being read, represents a promising way to boost children’s lingual development but it is unclear how content interactivity and agency affect the technique. We used video interaction analysis to investigate the effect of interactive elements on speech production of 12 children between the ages of 16 and 33 months when engaged in individual dialogic reading sessions with a tablet-based e-book. Interaction with interactive elements did not reduce the children’s responses to dialogic reading prompts. Spontaneous utterances were longer than prompted ones and the children’s engagement with interactive elements or sounds coming from the application most often triggered these spontaneous utterances.","author_count":5,"contributors":["Knoche, Hendrik","Rasmussen, Niklas Ammitzbøl","Boldreel, Kasper","Olesen, Joachim Lykke Østergaard","Pedersen, Anders Etzerodt Salling"],"cuid":["S01-000.00-072784"],"event":{"acronym":"IDC","end":"2014-06-20","place":"Aarhus, dk","start":"2014-06-17","title":"Interaction Design and Children","year":"2014"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"do interactions speak louder than words dialogic reading of an interactive tablet based e book with children between 000000000016 months and three years of age","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1145/2593968.2610473","version":"Other Version"},"id":"S01-000.00-072784","identifier":[{"id":"84903782276","type":"scopus"}],"ids":["aau-4e79ed2e-e9b5-4e59-ba61-582917b1e5ff"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-6F8168CC02DE89D503DCF32EDDC855FB"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1145/2593968.2610473","version":"Other Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (TECH)","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology, Mobility and Tracking Technologies","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology, Section for Media Technology - Campus Aalborg"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Hendrik","key":"knochepau","last":"Knoche","locid":"79ea8853-5447-4a43-9b23-23fb4043510d","name":"Knoche, Hendrik","orcid":"0000-0003-3950-8453","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Niklas Ammitzbøl","key":"rasmussenpau","last":"Rasmussen","locid":"7192cf41-d303-4d5d-950d-2d4557c4fb5b","name":"Rasmussen, Niklas Ammitzbøl","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kasper","key":"boldreelpau","last":"Boldreel","locid":"4da9095c-181a-4297-af55-24f3b467fa20","name":"Boldreel, Kasper","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Joachim Lykke Østergaard","key":"olesenpau","last":"Olesen","locid":"d0139269-fb5c-4add-9bbe-698d40de7412","name":"Olesen, Joachim Lykke Østergaard","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders Etzerodt Salling","key":"pedersenpau","last":"Pedersen","locid":"4002ae93-131d-4448-9722-a6bd807c7584","name":"Pedersen, Anders Etzerodt Salling","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1145/2593968.2610473","isbn":["9781450322720"],"publisher":"Association for Computing Machinery (ACM)","status":"p","title":"Proceedings of the International Conference on Interaction Design and Children"},"review":"Peer Reviewed","scoID":["2-s2.0-84903782276"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-4e79ed2e-e9b5-4e59-ba61-582917b1e5ff"],"src":["AAU Aalborg University"],"title":"Do interactions speak louder than words? Dialogic reading of an interactive tablet-based e-book with children between 16 months and three years of age","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-072784","year":"2014","yearsub":"2014"}
{"abstract":"BACKGROUND AND PURPOSE: Tourniquet application is still a common practice in total knee arthroplasty (TKA) surgery despite being associated with several adverse effects. We evaluated the effects of tourniquet use on functional and clinical outcome and on knee range of motion (ROM). PATIENTS AND METHODS: 70 patients who underwent TKA were randomized into a tourniquet group (n = 35) and a non-tourniquet group (n = 35). All operations were performed by the same surgeon and follow-up was for 1 year. Primary outcomes were functional and clinical outcomes, as evaluated by KOOS and knee ROM. Secondary outcomes were intraoperative blood loss, surgical time and visibility, postoperative pain, analgesic consumption, and transfusion requirements. RESULTS: Patients in the non-tourniquet group showed a better outcome in all KOOS subscores and better early knee ROM from surgery to week 8. No difference was detected at the 6- and 12-month follow-ups. Postoperative pain and analgesic consumption were less when a tourniquet was not used. Surgical time and visibility were similar between groups. Intraoperative blood loss was greater when not using a tourniquet, but no postoperative transfusions were required. INTERPRETATION: This study shows that TKA without the use of a tourniquet results in faster recovery in terms of better functional outcome and improved knee ROM. Furthermore, reduced pain and analgesic use were registered and no intraoperative difficulties were encountered.","author_count":7,"contributors":["Ejaz, Ashir","Laursen, Anders Christian","Kappel, Andreas","Laursen, Mogens Berg","Jakobsen, Thomas","Rasmussen, Sten","Nielsen, Poul Torben"],"cuid":["S01-000.00-104153"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Aged","Aged 80 and over","Arthralgia","Arthroplasty Replacement Knee","Female","Follow Up Studies","Humans","Male","Middle Aged","Pain Postoperative","Prospective Studies","Range of Motion Articular","Recovery of Function","Tourniquets","Treatment Outcome","Venous Thrombosis"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"faster recovery without the use of a tourniquet in total knee arthroplasty","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3109/17453674.2014.931197","version":"Published Version"},"id":"S01-000.00-104153","identifier":[{"id":"84904321514","type":"scopus"},{"id":"WOS:000340108300014","type":"wos"},{"id":"24954487","type":"pmid"}],"ids":["aau-ba66d91f-21d8-4772-8412-923f72af12b6"],"keyword":["Aged","Aged, 80 and over","Arthralgia","Arthroplasty, Replacement, Knee","Female","Follow-Up Studies","Humans","Male","Middle Aged","Pain, Postoperative","Prospective Studies","Range of Motion, Articular","Recovery of Function","Tourniquets","Treatment Outcome","Venous Thrombosis"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-9A128D5A54102CAB74DA697899F5F385"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.3109/17453674.2014.931197","version":"Published Version"},{"access":"oa","type":"rem","url":"http://informahealthcare.com/doi/abs/10.3109/17453674.2014.931197","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Orthopaedic Surgery","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Hoved-Orto","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Ashir","key":"ejazashirpau","last":"Ejaz","locid":"d14dcef2-26f0-4374-b32b-9f078e895d48","name":"Ejaz, Ashir","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders C","key":"laursenanderschristianpau","last":"Laursen","locid":"becbdeb4-e247-4a3d-9aa2-0be9086e449c","name":"Laursen, Anders Christian","name_org":"Laursen, Anders C","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Andreas","key":"kappelandreaspau","last":"Kappel","locid":"8c042227-bd3b-4e95-a0b2-fa2dfdd79328","name":"Kappel, Andreas","orcid":"0000-0001-8385-3567","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mogens B","key":"laursenmogensbergpau","last":"Laursen","locid":"26102317-00ee-41ec-ae85-c7a3bde4c391","name":"Laursen, Mogens Berg","name_org":"Laursen, Mogens B","orcid":"0000-0002-2791-3921","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Thomas","key":"jakobsenthomaspau","last":"Jakobsen","locid":"79a81435-8014-4695-8dd2-952c5e3d513a","name":"Jakobsen, Thomas","orcid":"0009-0005-9030-3498","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sten","key":"rasmussenstenpau","last":"Rasmussen","locid":"05d1d595-13be-4295-8ad1-8d29206859c8","name":"Rasmussen, Sten","orcid":"0000-0002-8664-352X","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Poul Torben","key":"nielsenpoultorbenpau","last":"Nielsen","locid":"86b36233-dca4-4a54-b791-febbe6161c2f","name":"Nielsen, Poul Torben","rank":7,"rolecode":"pau"}],"pmid":["24954487"],"pub":{"doi":"10.3109/17453674.2014.931197","issn":["17453674","17453682"],"issn_org":["17453674"],"issue":"4","journal":"Acta Orthopaedica","pages":"422-426","publisher":"Medical Journals Sweden AB","status":"p","title":"Acta Orthopaedica","title_org":"Acta Orthopaedica (Print Edition)","volume":"85"},"review":"Peer Reviewed","scoID":["2-s2.0-84904321514"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-ba66d91f-21d8-4772-8412-923f72af12b6"],"src":["AAU Aalborg University"],"title":"Faster recovery without the use of a tourniquet in total knee arthroplasty","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-104153","year":"2014","yearsub":"2014"}
{"abstract":"BACKGROUND: Corticomotor excitability has been shown to correlate with motor learning and functional recovery. The aim of the present study was to monitor changes in excitability of the corticomotor pathways induced by neck training and to compare the effects in patients with neck or knee pain and pain-free participants. METHODS: Corticomotor excitability was assessed using transcranial magnetic stimulation and electromyography at baseline, after 30 min and 1 h, and at a 1-week follow-up visit. The primary outcome measures were changes in amplitudes and latencies of motor evoked potentials (MEPs) at 1-week follow-up. RESULTS: MEP responses induced by neck training yielded significantly different outcomes in the three groups. In the group with neck pain and training, MEP amplitudes were significantly reduced between baseline and 30 min (p ≤ 0.05), but with no significant difference between baseline, 1 h (p = 0.178) and 1 week (p = 0.067). In the group with knee pain and training, MEP amplitudes significantly increased between baseline and 30 min (p ≤ 0.01) and 1 h (p < 0.001), but not after 1 week (p = 0.524) compared with baseline. In the pain-free group, there were no changes over time. CONCLUSION: Neck training reduced neuroplastic responsiveness of corticomotor pathways in neck pain patients in contrast to knee pain patients and pain-free participants. Increased attention to adaptive and maladaptive neuroplastic responses induced by training may prove valuable in the process of optimizing clinical outcomes.","author_count":5,"contributors":["Rittig-Rasmussen, Bjarne","Kasch, Helge","Fuglsang-Frederiksen, Anders","Svensson, Peter","Jensen, Troels Staehelin"],"cuid":["S01-000.00-171404"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"effect of training on corticomotor excitability in clinical neck pain","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1002/j.1532-2149.2014.487.x","version":"Other Version"},"id":"S01-000.00-171404","identifier":[{"id":"84906229043","type":"scopus"},{"id":"24664588","type":"pmid"}],"ids":["au-49c4a19c-e4b0-4d99-86e3-09f3be8e949b"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-A4D2BD1849F786280863E38263AF0260"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1002/j.1532-2149.2014.487.x","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University (AU)","Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Danish Pain Research Center"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"B","key":"rittigrasmussenpau","last":"Rittig-Rasmussen","locid":"8de237b5-c7a3-4019-b3ac-23504cd42e0a","name":"Rittig-Rasmussen, Bjarne","name_org":"Rittig-Rasmussen, B","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"H","key":"kaschpau","last":"Kasch","locid":"f78dc707-c440-4d0c-8afb-a43de72ff13c","name":"Kasch, Helge","name_org":"Kasch, H","orcid":"0000-0002-9302-4946","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"A","key":"fuglsangfrederiksenpau","last":"Fuglsang-Frederiksen","locid":"9dbd8297-9ebb-41f0-ab0b-8ddfef8c33bd","name":"Fuglsang-Frederiksen, Anders","name_org":"Fuglsang-Frederiksen, A","orcid":"0000-0003-3926-5287","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"P","key":"svenssonpau","last":"Svensson","locid":"163ec423-3f89-45a0-8cd8-81455aa6a507","name":"Svensson, Peter","name_org":"Svensson, P","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"T S","key":"jensenpau","last":"Jensen","locid":"e1a6c2c8-3a85-464d-a1b3-53c8bab37d6d","name":"Jensen, Troels Staehelin","name_org":"Jensen, T S","orcid":"0000-0002-3487-6380","rank":5,"rolecode":"pau"}],"pmid":["24664588"],"pub":{"doi":"10.1002/j.1532-2149.2014.487.x","issn":["10903801","15322149"],"issn_org":["10903801"],"issue":"8","journal":"European Journal of Pain","pages":"1207-1216","publisher":"John Wiley & Sons Inc.","status":"p","title":"European Journal of Pain","title_org":"European journal of pain (London, England)","volume":"18"},"review":"Peer Reviewed","scoID":["2-s2.0-84906229043"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-49c4a19c-e4b0-4d99-86e3-09f3be8e949b"],"src":["AU Aarhus University"],"title":"Effect of training on corticomotor excitability in clinical neck pain","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-171404","year":"2014","yearsub":"2014"}
