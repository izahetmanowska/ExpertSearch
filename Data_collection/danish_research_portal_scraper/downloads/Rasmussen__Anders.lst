Care Society United Kingdom."],"id":"S04-091.49-803636","identifier":[{"id":"39761440","type":"pmid"},{"id":"40036020","type":"pmid"},{"id":"85214866017","type":"scopus"}],"ids":["aau-27cf2f7b-b367-465a-8821-c8998fb79c74","au-e9aab9e6-479a-4f39-91f9-ad9dffd5f75d","ku-c1b9c0c6-01f7-4b3a-9091-0da9c194249a","sdu-9d746e58-089a-4211-8204-92a492d6ac3f"],"keyword":["clinical trials","core outcome set","critical care","intensive care","patient and public involvement","patient-important outcomes"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-7-2817E585CBCCF19DEFFD0972C5E8B8D1"],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Rigshospitalet, Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","country":"dk","key":"other hospitals","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-OTH","l3nl":"Other Hospitals","l3nn":"Other Hospitals","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Hospitals","namevar":["Collaboration for Research in Intensive Care"],"nora_code":"DI-HO-OTH","used":1},{"affno":"3","country":"dk","key":"unclear universities","l2":"DI-U","l2n":"Universities","l3":"DI-U-UND","l3nl":"Undetermined","l3nn":"Unclear Universities","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Unclear Universities","namevar":["Centre for Research in Intensive Care"],"nora_code":"DI-U-UND","used":1},{"affno":"4","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Anaesthesiology","Købe