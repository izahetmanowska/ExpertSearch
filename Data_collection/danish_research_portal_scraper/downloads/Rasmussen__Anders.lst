Venter","name":"Venter, Zander S.","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Trond","key":"reitanpau","last":"Reitan","name":"Reitan, Trond","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Claus","key":"rasmussenpau","last":"Rasmussen","locid":"24ea7809-dde1-44f9-ac17-63b508b998f7","name":"Rasmussen, Claus","orcid":"0000-0003-1529-6548","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Astrid B.","key":"skrindopau","last":"Skrindo","name":"Skrindo, Astrid B.","rank":5,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Daniel I.J.","key":"skoogpau","last":"Skoog","name":"Skoog, Daniel I.J.","rank":6,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Kaj Andreas","key":"hanevikpau","last":"Hanevik","name":"Hanevik, Kaj Andreas","rank":7,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Stein Joar","key":"heglandpau","last":"Hegland","name":"Hegland, Stein Joar","rank":8,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Yoko L.","key":"dupontpau","last":"Dupont","locid":"2a165175-a558-448c-9b2e-8fe1150a0fac","name":"Dupont, Yoko Luise","name_org":"Dupont, Yoko L.","rank":9,"rolecode":"pau"},{"affno":"2 6","corresponding":null,"first":"Anders","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Anders","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Joseph","key":"chipperfieldpau","last":"Chipperfield","name":"Chipperfield, Joseph","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Graciela M.","key":"ruschpau","last":"Rusch","name":"Rusch, Graciela M.","rank":12,"rolecode":"pau"}],"pub":{"doi":"10.1111/2041-210x.13762","issn":["2041210X"],"issue":"2","journal":"Methods in Ecology and Evolution","pages":"500-513","publisher":"John Wiley & Sons Inc.","status":"p","title":"Methods in Ecology and Evolution","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-85120459994"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-feb9422f-3ecd-4ec8-957b-824ad1633677"],"src":["AU Aarhus University"],"title":"MetaComNet : A random forest-based framework for making spatial predictions of plant–pollinator interactions","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-274687","year":"2022","yearsub":"2022"}
{"abstract":"Medie Pluralism Monitor (MPM) er et forskningsredskab designet til at identificere potentielle risici for mediepluralismen i medlems i den Europæiske Union og i kandidatlandene. Denne rapport er blevet produceret på baggrund af anvendelsen af MPM'en i 2021.","author_count":3,"contributors":["Santos Rasmussen, Christiern","Ahm, Kristian Redhead","Bollmann, Anders Theis"],"cuid":["S01-000.00-303807"],"filters":{"added":"2023-01","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Digital kommunikation","Digitalisering","Informations og kommunikationsteknologi og e læring"],"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-UC"],"level3":{"UC":["DI-UC-ALL","DI-UC-DMJX"]},"level3all":["DI-UC-DMJX"]},"review":"pr","rtype":["clu"],"sorti":"monitorering af mediepluralisme i den digitale tidsalder anvendelse af medie pluralisme minitor i den europæiske union albanien montenegro den nordmakedonske republik serbien og tyrkiet i året 000000002021 landerapport danmark","src":["dmjx"],"src-code":["DI-UC-DMJX"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.2871/158124","version":"Published Version"},"id":"S01-000.00-303807","ids":["dmjx-47787e89-249a-40e8-aff2-92e8121f381a"],"keyword":["Informations- og kommunikationsteknologi, og e-læring","digital kommunikation","digitalisering"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-2-78CAD64736FAC8CF50D201EBECB94648"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.2871/158124","version":"Published Version"},{"access":"oa","license":"CC BY","type":"rem","url":"https://cadmus.eui.eu/bitstream/handle/1814/74686/MPM2022-Denmark-DA.pdf?sequence=3&isAllowed=y","version":"Published Version"}],"org":[{"affno":"1","key":"dmjx danish school of media and journalism","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-DMJX","l3nl":"DMJX","l3nn":"DMJX Danish School of Media and Journalism","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DMJX Danish School of Media and Journalism","namevar":["Danmarks Medie- og Journalisthøjskole, Prorektors område - Uddannelser og viden, MPL og TVM, Medieproduktion og ledelse"],"nora_code":"DI-UC-DMJX","used":1}],"person":[{"affno":"","corresponding":null,"first":"Christiern","key":"santosrasmussenpau","last":"Santos Rasmussen","name":"Santos Rasmussen, Christiern","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kristian","key":"ahmpau","last":"Ahm","locid":"ab77187f-f93f-4a4d-bcb8-10cf8d8043f1","name":"Ahm, Kristian Redhead","name_org":"Ahm, Kristian","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Anders Theis","key":"bollmannpau","last":"Bollmann","name":"Bollmann, Anders Theis","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.2871/158124","pages":"32","place":"San Domenico di Fiesole","publisher":"European University Institute (EUI)","status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All University Colleges","DI-ALL","DI-UC","DI-UC-ALL","DMJX","University Colleges"],"PST":["Published"]},"sid":["dmjx-47787e89-249a-40e8-aff2-92e8121f381a"],"src":["DMJX Danish School of Media and Journalism"],"title":"Monitorering af mediepluralisme i den digitale tidsalder : anvendelse af medie pluralisme minitor i den Europæiske Union, Albanien, Montenegro, Den Nordmakedonske Republik, Serbien og Tyrkiet i året 2021. Landerapport: Danmark","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-303807","year":"2022","yearsub":"2022"}
{"abstract":"In this paper, we present an analysis of the conservation of currents in a full-F electromagnetic gyro-kinetic model in the long-wavelength limit. This equation corresponds to what is usually called the 'vorticity equation', which is not strictly correct as it cannot be formulated as the curl of a velocity equation. In the paper, we will therefore use the term 'current conservation equation' instead. Our results are relevant to reduced plasma descriptions like gyro-kinetic, drift-kinetic, gyro-fluid and drift-fluid models for tokamaks and stellarators. The equation describes the change of the polarization charge density (often called 'vorticity') in terms of the polarization stress due to the E x B flow, external sources and three currents: the parallel current, the curvature current and a current related to the magnetic field fluctuations. We compare this equation with previous drift- and gyro-fluid equations and find general agreement, except in the vorticity source terms where previous drift-fluid models fail to capture the heating and density sources. We discuss the role of currents in the dynamics of diamagnetic and E x B flow shear. The possible connection between these currents with phenomena observed in experiments that influence the radial electric field in the edge of tokamak plasmas, like resonant magnetic perturbations, and different magnetic field configurations and shapes, is presented.","author_count":7,"contributors":["Gerru, R.","Wiesenberger, M.","Held, M.","Nielsen, Anders Henry","Naulin, Volker","Rasmussen, Jens Juul","Järleblad, H."],"cuid":["S01-000.00-359043"],"filters":{"added":"2022-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Gerru, R."],"country":["Norway"],"glorg":["All Global Affiliations","University of Tromsø – The Arctic University of Norway"],"keyword":["Gyro fluid","L H transition","Reduced model","Shear","Transport barrier","Vorticity"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"conservation of currents in reduced full f electromagnetic kinetic and fluid models","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/274656571/Conservation_of_currents_in_reduced_full_F_electromagnetic_kinetic_and_fluid_models_3.pdf","version":"Authors Final Version"},"id":"S01-000.00-359043","identifier":[{"id":"85127548419","type":"scopus"},{"id":"000771732000001","type":"wos"}],"ids":["dtu-b6540d23-d220-4cff-88eb-006fb4294ddf"],"keyword":["Conservation of currents","Edge current","Gyro-fluid","L-H transition","Radial electric field","Reduced model","Shear","Transport barrier","Vorticity"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-DB312A52B473B5FA5A83EA6D6BB9005B"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/274656571/Conservation_of_currents_in_reduced_full_F_electromagnetic_kinetic_and_fluid_models_3.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Physics","Technical University of Denmark, Department of Physics, Plasma Physics and Fusion Energy"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"no","key":"university of tromsø the arctic university of norway","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"University of Tromsø – The Arctic University of Norway","used":1}],"person":[{"affno":"1","corresponding":null,"first":"R.","key":"gerrúpau","last":"Gerrú","locid":"ffc17642-8855-475c-8901-2fe42df5812a","name":"Gerru, R.","name_org":"Gerrú, R.","orcid":"0000-0002-1884-4354","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"M.","key":"wiesenbergerpau","last":"Wiesenberger","locid":"8c5c1c55-1300-4a61-8eb1-1e0a49eabe9e","name":"Wiesenberger, M.","orcid":"0000-0002-5921-0163","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"M.","key":"heldpau","last":"Held","name":"Held, M.","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"A. H.","key":"nielsenpau","last":"Nielsen","locid":"1d9aa958-9d84-4a3b-8300-f6fe9b0be73e","name":"Nielsen, Anders Henry","name_org":"Nielsen, A. H.","orcid":"0000-0003-3642-3905","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"V.","key":"naulinpau","last":"Naulin","locid":"68cb67c0-c64d-4fef-a301-67ab58d8ace6","name":"Naulin, Volker","name_org":"Naulin, V.","orcid":"0000-0001-5452-9215","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"J. J.","key":"rasmussenpau","last":"Rasmussen","locid":"125b9658-f84c-4e0e-859e-5899413288ee","name":"Rasmussen, Jens Juul","name_org":"Rasmussen, J. J.","orcid":"0000-0002-3543-690X","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"H.","key":"jarlebladpau","last":"Jarleblad","locid":"3cc727c4-b29c-41c1-83f0-57566c02c4e5","name":"Järleblad, H.","name_org":"Jarleblad, H.","orcid":"0000-0003-1126-686X","rank":7,"rolecode":"pau"}],"pub":{"doi":"10.1088/1361-6587/ac55f6","issn":["07413335","13616587"],"issn_org":["07413335"],"issue":"5","journal":"Plasma Physics and Controlled Fusion","paperid":"054005","publisher":"IOP Publishing","status":"p","title":"Plasma Physics and Controlled Fusion","volume":"64"},"review":"