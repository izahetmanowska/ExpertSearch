","Nordic","OECD"],"name":"North Denmark Region","namevar":["Aalborg University Hospital"],"nora_code":"DI-HO-NDR","used":1},{"affno":"7","country":"gb","key":"queen mary university of london","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Queen Mary University of London","used":1}],"person":[{"affno":"1 2","first":"Anders","key":"holtpau","last":"Holt","locid":"7b64b1ed-698a-4d01-8987-02e878b5674c","name":"Holt, Anders","rank":1,"rolecode":"pau"},{"affno":"1","first":"Paul","key":"blanchepau","last":"Blanche","locid":"92ff477f-3b2c-4873-a4f5-dbe701671e1c","name":"Blanche, Paul","orcid":"0000-0003-1415-7976","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Bochra","key":"zareinipau","last":"Zareini","name":"Zareini, Bochra","rank":3,"rolecode":"pau"},{"affno":"1 2","first":"Peter Vibe","key":"rasmussenpau","last":"Rasmussen","locid":"ca186b96-3318-42e7-8fe1-34aa087a51b0","name":"Rasmussen, Peter Vibe","rank":4,"rolecode":"pau"},{"affno":"1 2","first":"Jarl Emanuel","key":"strangepau","last":"Strange","locid":"8abc6f65-e1b6-4c15-9876-3985f814fe09","name":"Strange, Jarl Emanuel","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Deepthi","key":"rajanpau","last":"Rajan","name":"Rajan, Deepthi","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mads Hashiba","key":"jensenpau","last":"Jensen","name":"Jensen, Mads Hashiba","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mohammed","key":"elsheikhpau","last":"El-Sheikh","name":"El-Sheikh, Mohammed","rank":8,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Anne-Marie","key":"schjerningpau","last":"Schjerning","name":"Schjerning, Anne-Marie","rank":9,"rolecode":"pau"},{"affno":"1 2","first":"Morten","key":"schoupau","last":"Schou","locid":"48fa6ec9-1941-4566-b931-14b0cc8cbae3","name":"Schou, Morten","rank":10,"rolecode":"pau"},{"affno":"1 2 4","first":"Gunnar","key":"gislasonpau","last":"Gislason","locid":"c0f678a6-eb13-49