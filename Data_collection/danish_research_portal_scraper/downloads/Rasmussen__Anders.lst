ndergaardpau","last":"Søndergaard","locid":"ed027e07-2df4-474c-b76a-b0ced3210d88","name":"Søndergaard, Jens","orcid":"0000-0001-7680-9920","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jakob","key":"tougaardpau","last":"Tougaard","locid":"edd6deab-ccc4-4f22-b130-f9ec24fd6a48","name":"Tougaard, Jakob","orcid":"0000-0002-4422-7800","rank":13,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Susse","key":"wegebergpau","last":"Wegeberg","locid":"05370847-e1d3-4253-b818-046251260ff5","name":"Wegeberg, Susse","rank":14,"rolecode":"pau"}],"pub":{"isbn":["978 87 7124 790 9"],"pages":"132","place":"Århus","publisher":"Aarhus Universitetsforlag","series":"Miljøbiblioteket","status":"p"},"review":"Undetermined","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-3abb15c2-5a7b-419f-b481-3f8a59d43bab"],"src":["AU Aarhus University"],"title":"Miljø og råstoffer i Grønland","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-162827","year":"2018","yearsub":"2018"}
{"abstract":"Objective: Neurotoxicity is the most frequent dose-limiting side effect of the anti-cancer agent oxaliplatin, but the mechanisms are not well understood. This study used nerve excitability testing to investigate the pathophysiology of the acute neurotoxicity. Methods: Questionnaires, quantitative sensory tests, nerve conduction studies and nerve excitability testing were undertaken in 12 patients with high-risk colorectal cancer treated with adjuvant oxaliplatin and in 16 sex- and age-matched healthy controls. Examinations were performed twice for patients: once within 3 days after oxaliplatin treatment (post-infusion examination) and once shortly before the following treatment (recovery examination). Results: The most frequent post-infusion symptoms were tingling paresthesias and cold allodynia. The most prominent nerve excitability change was decreased superexcitability of motor axons which correlated with the average intensity of abnormal sensations (Spearman Rho = 0.80, p <.01). The motor nerve excitability changes were well modeled by a slowing of sodium channel inactivation, and were proportional to dose/m 2 with a half-life of about 10d. Conclusions: Oxaliplatin induces reversible slowing of sodium channel inactivation in motor axons, and these changes are closely related to the reversible cold allodynia. However, further studies are required due to small sample size in this study. Significance: Nerve excitability data provide an index of sodium channel dysfunction: an objective biomarker of acute oxaliplatin neurotoxicity.","author_count":8,"contributors":["Rasmussen, Rikke Heide","Bostock, Hugh","Ventzel, Lise","Grafe, Peter","Bergmans, Joseph","Fuglsang-Frederiksen, Anders","Finnerup, Nanna Brix","Tankisi, Hatice"],"cuid":["S01-000.00-186874"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Belgium","Germany"],"glorg":["All Global Affiliations","Ludwig Maximilian University","Universite Catholique de Louvain"],"keyword":["Chemotherapy","Nerve excitability testing","Neuropathy","Oxaliplatin toxicity","Quantitative sensory tests","Sodium channel dysfunction"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"axonal excitability changes and acute symptoms of oxaliplatin treatment in vivo evidence for slowed sodium channel inactivation","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85037612805","version":"Other Version"},"id":"S01-000.00-186874","identifier":[{"id":"85037612805","type":"scopus"}],"ids":["au-64c2f822-b833-46c2-9433-03eadb8e3c8e"],"keyword":["Chemotherapy","Nerve excitability testing","Neuropathy","Oxaliplatin toxicity","Quantitative sensory tests","Sodium channel dysfunction"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-21FA6F0707D9869713038709815FEF83"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Clinical Neurophysiology"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"de","key":"ludwig maximilian university","loc":["Germany","Europe, EU","OECD"],"name":"Ludwig Maximilian University","used":1},{"affno":"3","country":"be","key":"universite catholique de louvain","loc":["Belgium","Europe, EU","OECD"],"name":"Universite Catholique de Louvain","used":1}],"person":[{"affno":"1","corres