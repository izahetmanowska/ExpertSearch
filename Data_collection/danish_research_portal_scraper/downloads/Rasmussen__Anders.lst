{"author_count":7,"contributors":["Elgaard, Anders Fyhn","Kiel Rasmussen, Peter Frimand","Dinesen, Pia Thisted","Riahi, Sam","Struijk, Johannes","Lundbye-Christensen, Søren","Larsen, Jacob Moesgaard"],"cuid":["S01-000.00-762452"],"filters":{"added":"2024-11","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"pacemaker performance after external electrical cardioversion with different shock pad positions an experimental study","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85205962657&partnerID=8YFLogxK","version":"Other Version"},"funding_acknowledgement":["We thank Biomedical Research Laboratory for the collaboration and Clinical Professor Benedict Kj\\u00E6rgaard for invaluable help. This work was financed by Department of Cardiology, Aalborg University Hospital, Denmark, and supported by the A.P. Moeller Foundation (Fonden til L\\u00E6gevidenskabens Fremme), Hede Nielsens Foundation, and Fabrikant Karl G. Andersen Foundation. All authors attest they meet the current ICMJE criteria for authorship."],"id":"S01-000.00-762452","identifier":[{"id":"85205962657","type":"scopus"},{"id":"39326512","type":"pmid"}],"ids":["aau-b5f50c22-4456-4bff-bf60-6cb987f728b6"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-7A693741A904D2E4D498CA5E43C779B1"],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine,