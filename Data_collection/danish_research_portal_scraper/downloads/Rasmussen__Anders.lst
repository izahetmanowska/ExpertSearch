f Regional Health Research, IRS - Lillebælt Hospital, Research Unit of Organ and Plastic Surgery (Vejle)"],"nora_code":"DI-U-SDU","used":1},{"affno":"8","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Lillebaelt University Hospital"],"nora_code":"DI-HO-SDR","used":1}],"person":[{"affno":"1 2 3","corresponding":null,"first":"Mette Bach","key":"larsenpau","last":"Larsen","locid":"40b0a541-1654-4488-a108-499a4097e34a","name":"Larsen, Mette Bach","rank":1,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"first":"Ellen Margrethe","key":"mikkelsenpau","last":"Mikkelsen","locid":"e387d95d-f84c-4da7-974f-c02b7e6246de","name":"Mikkelsen, Ellen M.","name_org":"Mikkelsen, Ellen Margrethe","rank":2,"rolecode":"pau"},{"affno":"2 4","first":"Morten","key":"rasmussenpau","last":"Rasmussen","locid":"8610dd32-d855-4667-8cc2-3269d594ce27","name":"Rasmussen, Morten","rank":3,"rolecode":"pau"},{"affno":"2 4","first":"Lennart","key":"friishansenpau","last":"Friis-Hansen","locid":"1939eea3-df47-4b07-9a8b-b5bc1d73c8ec","name":"Friis-Hansen, Lennart","rank":4,"rolecode":"pau"},{"affno":"5 6 3","corresponding":null,"first":"Anders Uth","key":"ovesenpau","last":"Ovesen","locid":"e9036e68-4f6c-40d2-aa7c-f3222bae0fe7","name":"Ovesen, Anders Uth","rank":5,"rolecode":"pau"},{"affno":"7 8","corresponding":null,"country":"dk","first":"Hans Bjarke","key":"rahrpau","last":"Rahr","locid":"941e7830-92a2-42c8-a6d4-93a9fa3235e4","name":"Rahr, Hans B","name_org":"Rahr, Hans Bjarke","orcid":"0000-0002-4571-7852","rank":6,"rolecode":"pau"},{"affno":"1 2 3","corresponding":null,"country":"dk","first":"Berit","key":"andersenpau","last":"Andersen","locid":"4f64dc11-e5ca-4037-bbad-8ca533d841e4","name":"Andersen, Berit","orcid":"0000-0003-4074-6504","rank":7,"rolecode":"pau"}],"pmid":["2872109