{"abstract":"Biografi over Carl F. C. Clausen, ledende politiinspektør under den hændelse på Københavns Fælled den 5. maj 1872, der senere har fået betegnelsen Slaget på Fælleden.","author_count":3,"contributors":["Rasmussen, Anders Holm"],"cuid":["S01-000.00-730352"],"filters":{"added":"2024-05","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Det Humanistiske Fakultet"],"level":"pop","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"und","rtype":["clu"],"sorti":"carl f c clausen","src":["ku"],"src-code":["DI-U-KU"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-730352","ids":["ku-0909865b-a5e9-4d87-8440-67cdf703e8bf"],"keyword":["Carl F. C. Clausen","Det Humanistiske Fakultet","Slaget på Fælleden"],"lang":"Danish","level":"Popular","mra":["Humanities"],"noi":["Local-1-1-576A37B75D0127C664AFBC42D6657510"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Humanities, SAXO-Institute - Archaeology, Ethnology, Greek & Latin, History"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Anders Holm","key":"rasmussenpau","last":"Rasmussen","locid":"0382398f-ba6a-4367-a3e8-a54da1aa6fd8","name":"Rasmussen, Anders Holm","rank":1,"rolecode":"pau"},{"affno":"","first":"Jes Fabricius","key":"møllerpedh","last":"Møller","name":"Møller, Jes Fabricius","rank":2,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Kristoffer","key":"schmidtpedh","last":"Schmidt","name":"Schmidt, Kristoffer","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9788787462013"],"pages":"51-59","place":"København",