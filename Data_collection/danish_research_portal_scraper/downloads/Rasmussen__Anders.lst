Kåre Gotschalck","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mads Heilskov","key":"rasmussenpau","last":"Rasmussen","locid":"3285e14f-ef19-480d-97ff-c95d6a90b354","name":"Rasmussen, Mads Heilskov","orcid":"0000-0001-5723-6303","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Claus Lindbjerg","key":"andersenpau","last":"Andersen","locid":"f97421ce-9c23-4c51-9fcd-be0843ed0c0f","name":"Andersen, Claus Lindbjerg","orcid":"0000-0002-7406-2103","rank":9,"rolecode":"pau"}],"pmid":["31638937"],"pub":{"doi":"10.1186/s12885-019-6227-7","issn":["14712407"],"issue":"1","journal":"BMC Cancer","paperid":"971","publisher":"BioMed Central","status":"p","title":"BMC Cancer","volume":"19"},"review":"Peer Reviewed","scoID":["2-s2.0-85073725074"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities"],"PST":["Published"]},"sid":["au-f3e93904-c643-44c8-bc69-ad6cd99580a2"],"src":["AU Aarhus University"],"title":"Validation of computational determination of microsatellite status using whole exome sequencing data from colorectal cancer patients","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-268455","year":"2019","yearsub":"2019"}
