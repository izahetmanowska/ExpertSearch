{"abstract":"Juridisk metode for revisorer er skrevet med det formål at give revisorer en metodebog målrettet de juridiske områder, der er en del af en revisors arbejdsområde i forbindelse med særligt erhvervs-juridiskrådgivning på det erhvervsretlige samt skatte- og afgiftsretlige område.","author_count":2,"contributors":["Larsen, Anders","Rasmussen, Rene Yssing"],"cuid":["S01-000.00-115564"],"filters":{"added":"2022-09","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Juridisk metode","Revisorer"],"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"nr","rtype":["clu"],"sorti":"juridisk metode for revisorer","src":["aau"],"src-code":["DI-U-AAU"],"type":"db","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.djoef-forlag.dk/book-info/juridisk-metode-revisorer","version":"Other Version"},"id":"S01-000.00-115564","ids":["aau-e14b5231-060d-4392-ba6a-ee9671d261cd"],"keyword":["juridisk metode","revisorer"],"lang":"Danish","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-99EA7A2879F9F8F127683DC0A67CC718"],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Social Sciences and Humanities","Aalborg University, The Faculty of Social Sciences and Humanities, Aalborg University Business School","Aalborg University, The Faculty of Social Sciences and Humanities, Aalborg University Business School, Accounting Research Group"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Anders","key":"larsenpau","last":"Larsen","locid":"8c9066bf-83e3-4bac-b587-9341d328d70c","name":"Larsen, 