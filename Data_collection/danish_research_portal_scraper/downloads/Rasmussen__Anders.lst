cine, Aalborg University Hospital, Klinik Hoved-Orto"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Jacob","key":"mortensenpau","last":"Mortensen","name":"Mortensen, Jacob","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andreas","key":"kappelpau","last":"Kappel","locid":"8c042227-bd3b-4e95-a0b2-fa2dfdd79328","name":"Kappel, Andreas","orcid":"0000-0001-8385-3567","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Lasse","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Lasse","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Svend Erik","key":"østgaardpau","last":"Østgaard","locid":"fece298f-499b-4e90-8963-050f1c95c807","name":"Østgaard, Svend Erik","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Anders","key":"odgaardpau","last":"Odgaard","name":"Odgaard, Anders","rank":5,"rolecode":"pau"}],"pub":{"pages":"95","publisher":"Dansk Ortopædisk Selskab","status":"p","subtitle":"DOS Bulletin","title":"Abstracts - Oktober 2020"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-cac9a5a1-7a83-4932-8082-615649683d70"],"src":["AAU Aalborg University"],"title":"The Rosenberg view can replace standardized coronal plane stress radiography in the diagnostic process for Uni-compartmental and Total knee replacements","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-108888","year":"2020","yearsub":"2020"}
{"abstract":"Background: Inpatient multidisciplinary rehabilitation (MDR) can improve health-related quality of life (HRQoL) in multiple sclerosis (MS) patients. However, the evidence of a long-term benefit is limited. Objectives: To investigate the long-term effectiveness of inpatient MDR on HRQoL in MS patients. Methods: We conducted a randomized controlled partial crossover trial with 427 MS patients. Results: Statistical significant long-term improvements in HRQoL were found in three of the six outcome measures at 12-month follow-up. Three in four suggested minimal clinically important differences (MCIDs) were unmet. Conclusion: These results indicate that the administration of inpatient MDR may lead to long-lasting improvements in HRQoL in MS patients.","author_count":7,"contributors":["Boesen, Finn","Nørgaard, Michael","Skjerbæk, Anders Guldhammer","Rasmussen, Peter Vestergaard","Petersen, Thor","Løvendahl, Brita","Trénel, Philipp"],"cuid":["S01-000.00-137514"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Nørgaard, Michael"],"keyword":["Health related quality of life","Long term","Multidisciplinary rehabilitation","Multiple sclerosis"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GTS","DI-HO","DI-U"],"level3":{"GTS":["DI-GTS-ALL","DI-GTS-DTCI"],"HO":["DI-HO-ALL","DI-HO-OTH"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-GTS-DTCI","DI-HO-OTH","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"can inpatient multidisciplinary rehabilitation improve health related quality of life in ms patients on the long term the danish ms hospitals rehabilitation study","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1177/1352458519884244","version":"Published Version"},"id":"S01-000.00-137514","identifier":[{"id":"85074827780","type":"scopus"},{"id":"PMC7720351","type":"pmcid"},{"id":"31687884","type":"pmid"}],"ids":["au-0e4bdec4-e6e7-4153-993c-81826fb2dd1d"],"keyword":["Health-related quality of life","long term","multidisciplinary rehabilitation","multiple sclerosis"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-BE9B55159C5B20CD3166ECCAD7BEBB4D"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1177/1352458519884244","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://pure.au.dk/ws/files/220335172/1352458519884244.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"dk","key":"other hospitals","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-OTH","l3nl":"Other Hospitals","l3nn":"Other Hospitals","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Hospitals","namevar":["The Danish MS Hospitals"],"nora_code":"DI-HO-OTH","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Neurology"],"nora_code":"DI-U-AU","used":1},{"affno":"3","country":"dk","key":"danish technological institute","l2":"DI-GTS","l2n":"GTS Institutes","l3":"DI-GTS-DTCI","l3nn":"Danish Technological Institute","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Danish Technological Institute","namevar":["Danish Technological Institute"],"nora_code":"DI-GTS-DTCI","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Finn","key":"boesenpau","last":"Boesen","name":"Boesen, Finn","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Michael","key":"nørgaardpau","last":"Nørg