le":"Other","rolecode":"oth"},{"affno":"5","corresponding":null,"first":"Mette","key":"mølvadgaardmetteoth","last":"Mølvadgaard","locid":"b745e58c-194a-40dd-98cf-f5c689fb900f","name":"Mølvadgaard, Mette","rank":55,"role":"Other","rolecode":"oth"}],"pmid":["34903718"],"pub":{"doi":"10.1038/s41467-021-27202-x","issn":["20411723"],"issue":"1","journal":"Nature Communications","paperid":"7251","publisher":"Nature Research","status":"p","title":"Nature Communications","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-85122774462"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Governmental Institutions","All Miscellaneous","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Governmental Institutions","Miscellaneous","Other Research","Technical University of Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-b7136dad-880b-4abe-a5bf-0b43cb824e11","dtu-b5be2aa7-5d47-4bb0-a882-b767365c8b1b","ku-a7e11899-065a-4578-8b1d-d3e4c487a37b","sdu-479104bc-ec55-4c2b-9976-8b9a0573c227"],"src":["AAU Aalborg University","DTU Technical University of Denmark","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Increased transmissibility of SARS-CoV-2 lineage B.1.1.7 by age and viral load","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-089.27-008834","year":"2021","yearsub":"2021"}
{"abstract":"The evaluation and management of severe asthma patients require collection of comprehensive information, which is often a challenge in a busy outpatient clinic. The Danish Severe Asthma Register (DSAR) was designed as an electronic patient record form that captures operational clinical data and provides a clinical overview of the severe asthma patient. DSAR is a nationwide register; all patients in Denmark who are treated with biologics for severe asthma are included, and data are as a minimum entered at start of biological treatment, after four and 12 months of treatment, and hereafter annually. Currently, there are data from 621 treatment courses with biologics included in DSAR, with 71% of patients treated with anti-IL-5 drugs and 29% with an anti-IgE drug. Patients enter Patient Reported Outcome Measures electronically on tablets when they arrive in the outpatient clinic and their answers are immediately available to the clinician during the consultation. Nurses and doctors enter clinical data into DSAR during the consultation. DSAR offers immediate access to well-presented longitudinal overview and automatically creates a journal output that can be copy-pasted into the hospital’s existing health record form. DSAR is also currently expanding with an app, to be used for monitoring of home-treatment. In addition to serving as an electronic patient record form, DSAR will also provide opportunities to monitor the real-life efficacy of biological treatment for severe asthma in Denmark, and it will be a valuable research platform that will aid in answering important research questions on severe asthma in the future.","author_count":16,"contributors":["Hansen, Susanne","Hilberg, Ole","Ulrik, Charlotte Suppli","Bodtger, Uffe","M. Rasmussen, Linda","Assing, Karin Dahl","Wimmer-Aune, Alexandra","B. Rasmussen, Kirsten","Bjerring, Niels","Christiansen, Anders","Schmid, Johannes","Krogh, Niels Steen","Porsbjerg, Celeste"],"cuid":["S04-099.28-007535"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"corresponding_author":["Porsbjerg, Celeste"],"keyword":["Biological treatment","Clinical decision making tool","Severe asthma","electronic patient record","real life efficacy","severe asthma research"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"the danish severe asthma register an electronic platform for severe asthma management and research","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1080/20018525.2020.1842117","version":"Published Version"},"funding_acknowledgement":["The Danish Severe Asthma Register is funded by grants from Glaxo Smith Kline, Novartis, AstraZeneca, Teva, and Sanofi. The authors would like to acknowledge Marcus Ross Christensen and Olivia Nielsson for entering the retrospective data; Pia H?iagaard-S?rensen for daily management of DSAR; secretaries, nurses, and doctors from the participating departments for taking active part in DSAR."],"id":"S04-099.28-007535","identifier":[{"id":"33209214","type":"pmid"},{"id":"85094957077","type":"scopus"},{"id":"PMC7646603","type":"pmcid"},{"id":"000583973300001","type":"wos"}],"ids":["aau-9b5bdeb1-1eee-4089-9b57-43b904e007b9","au-19fe072d-ee22-4cd9-b30a-68c7ee5408fd","ku-3d818365-2c88-4534-90a4-1aba73c497e5","sdu-0fd66323-d367-4a59-8c46-9d1eddd81986"],"keyword":["Severe asthma","biological treatment","clinical decision-making tool","electronic patient record","real-life efficacy","sever