{"abstract":"Formålet med artiklen er dels at give et overblik over arten af sportler, som præstinder og præster modtog for deres virke i de antikke græske kulter, dels en diskussion af disse sportlers økonomiske betydning for de enkelte præstinder og præster.","author_count":4,"contributors":["Rasmussen, Anders Holm"],"cuid":["S01-000.00-777481"],"filters":{"added":"2025-01","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the economy of priestly perquisites in ancient greek cult","src":["ku"],"src-code":["DI-U-KU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://curis.ku.dk/ws/files/414176458/11633_2813_PB.pdf","version":"Published Version"},"id":"S01-000.00-777481","identifier":[{"id":"105015083045","type":"scopus"}],"ids":["ku-3da3f6a0-814e-44e7-9fdf-007870032851"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-8424A3A8EFADA966A515ED0B96209741"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://tidsskrift.dk/classicaetmediaevalia/issue/view/11633","version":"Published Version"},{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://curis.ku.dk/ws/files/414176458/11633_2813_PB.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Humanities, SAXO-Institute - Archaeology, Ethnology, Greek & Latin, History"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Anders Holm","key":