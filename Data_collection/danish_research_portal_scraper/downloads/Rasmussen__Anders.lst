.0-84955188275"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Hospitals","Other Research","Region Zealand","Universities","University of Copenhagen","University of Southern Denmark","private practice - denmark (medical)"],"PST":["Published"]},"sid":["au-bff0470e-cbcf-413f-a3b3-47f8dade71c2","ku-647bf9b3-a229-436a-82e8-8eb05c1418d5","sdu-0ce1780f-bc10-4f13-a8d4-70c6d41d53aa"],"src":["AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Treatment of adult patients with schizophrenia and complex mental health needs - A national clinical guideline","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-089.10-026609","year":"2016","yearsub":"2016"}
{"abstract":"OBJECTIVE: Co-stimulatory T cell cytokines are important in the progression of RA. This study investigates the interplay between 4-1BB, a disintegrin and metalloprotease-17 (ADAM17) and galectin-9 (Gal-9) in RA. METHODS: Stimulated mononuclear cells from patients with chronic RA (n = 12) were co-incubated with tissue inhibitor of metalloproteinase, 4-1BB ligand and Gal-9. Plasma samples were examined for soluble 4-1BB (s4-1BB) in newly diagnosed, treatment-naïve patients with RA (n = 97). The 28-joint DAS with CRP (28DAS-CRP), total Sharp score, erosion score and joint space narrowing were used to evaluate treatment outcome serially over a 2-year period. RESULTS: RA CD4(+) and CD8(+) synovial T cells express high levels of 4-1BB. The addition of TNF-α to cultured synovial mononuclear cells increased shedding of 4-1BB. 4-1BB ligand only increased TNF-α shedding in combination with Gal-9. RNA interference-mediated knockdown of ADAM17 or the addition of an ADAM17 inhibitor reduced the 4-1BB shedding. Shedding of 4-1BB was not influenced by Gal-9. Plasma levels of s4-1BB were increased in early RA and correlated with the number of swollen joints at baseline. After 3 months of treatment, the plasma levels of s4-1BB were equal to those of the controls. Baseline plasma levels of s4-1BB were inversely correlated with DAS28-CRP after 2 years of treatment, but not with total Sharp score, erosion score or joint space narrowing. CONCLUSION: ADAM17 induces 4-1BB shedding in RA. Gal-9 is pivotal for the function of 4-1BB and induction of TNF-α. Furthermore, high plasma levels of s4-1BB were associated with the number of swollen joints, but also with a low DAS28-CRP after 2 years treatment in early RA.","author_count":13,"contributors":["Nielsen, Morten Aagaard","Andersen, Thomas","Etzerodt, Anders","Kragstrup, Tue Wenzel","Rasmussen, Tue Kruse","Stengaard-Pedersen, Kristian","Hetland, Merete Lund","Hørslev-Petersen, Kim","Junker, Peter","Østergaard, Mikkel","Hvid, Malene","Moestrup, Søren K","Deleuran, Bent"],"cuid":["S03-096.08-027886"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"keyword":["4 1BB","4 1BB Ligand","4 1BBL","ADAM17","Antirheumatic Agents","Arthritis Rheumatoid","Autoantibodies","CD8 Positive T Lymphocytes","Cells Cultured","DAS28","Disease Progression","Double Blind Method","Enzyme Linked Immunosorbent Assay","Galectin","Galectins","HEK293 Cells","Humans","Journal Article","Leukocytes Mononuclear","Longitudinal Studies","Methotrexate","Multicenter Study","Outcome","Randomized Controlled Trial","Rheumatoid arthritis","Synovial fluid","Synovium","T Lymphocytes","TACE","TNF","Tumor Necrosis Factor alpha"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"a disintegrin and metalloprotease 000000000017 and galectin 000000000009 are important regulators of local 000000000004 000000000001bb activity and disease outcome in rheumatoid arthritis","src":["au","ku","sdu"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84991045224","version":"Other Version"},"id":"S03-096.08-027886","identifier":[{"id":"84991045224","type":"scopus"},{"id":"27330157","type":"pmid"}],"ids":["au-d1cf8b72-5d2e-45ba-ae3e-86fd07eee764","ku-b0536a71-9eaa-4217-aa07-ffb97050dd0a","sdu-36e92765-8e54-43d6-99c7-7bb7e6aaa003"],"keyword":["4-1BB","4-1BB Ligand","4-1BBL","ADAM17","ADAM17 Protein","Antirheumatic Agents","Arthritis, Rheumatoid","Autoantibodies","CD8-Positive T-Lymphocytes","Cells, Cultured","DAS28","Disease Progression","Double-Blind Method","Enzyme-Linked Immunosorbent Assay","Galectins","HEK293 Cells","Humans","Journal Article","Leukocytes, Mononuclear","Longitudinal Studies","Matrix Metalloproteinase 17","Methotrexate","Multicenter Study","Randomized Controlled Trial","Synovial Fluid","T-Lymphocytes","TACE","TNF","Tumor Necrosis Factor-alpha","galectin","outcome","rheumatoid arthritis","synovium"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-6AC502C5EDEBA11882FBCED16F928B44"],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Biomedicine, Department of Biomedicine - Research and Education, Bartholin Building"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital","Glostrup Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"4","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namev