gion","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-bdcd4bf4-46c0-4806-8bf8-6ec62f1caa11"],"src":["SDU University of Southern Denmark"],"title":"Dansk lunge Cancer Register (DLCR) - Resume af Årsrappoprt 2018","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-627641","year":"2020","yearsub":"2020"}
{"abstract":"Background: Alcoholic liver disease (ALD) is a public health concern that is the cause of half of all cirrhosis-related deaths. Early detection of fibrosis, ideally in the precirrhotic stage, is a key strategy for improving ALD outcomes and for preventing progression to cirrhosis. Previous studies identified the blood-borne marker human microfibrillar-associated protein 4 (MFAP4) as a biomarker for detection of hepatitis C virus (HCV)-related fibrosis. Aim: To evaluate the diagnostic accuracy of MFAP4 to detect ALD-induced fibrosis. Method: We performed a prospective, liver biopsy-controlled study involving 266 patients with prior or current alcohol overuse. Patients were split into a training and a validation cohort. Results: MFAP4 was present in fibrotic hepatic tissue and serum MFAP4 levels increased with fibrosis grade. The area under the receiver operating characteristic curve (AUROC) for detection of cirrhosis was 0.91 (95% CI 0.85-0.96) in the training cohort and 0.91 (95% CI 0.79-1.00) in the validation cohort. For detection of advanced fibrosis, the AUROC was 0.88 (95% CI 0.81-0.94) in the training cohort and 0.92 (95% CI 0.83-1.00) in the validation cohort. The diagnostic accuracy did not differ between MFAP4 and the enhanced liver fibrosis (ELF) test or transient elastography (TE) in an intention-to-diagnose analysis. MFAP4 did not predict hepatic decompensation in a time-to-decompensation analysis in a subgroup of patients with cirrhosis. Conclusion: MFAP4 is a novel biomarker that can detect ALD-related fibrosis with high accuracy.","author_count":12,"contributors":["Stæhr Madsen, Bjørn","Thiele, Maja","Detlefsen, Sönke","Sørensen, Mia Dahl","Kjærgaard, Maria","Møller, Linda Maria Sevelsted","Rasmussen, Ditlev Nytoft","Schlosser, Anders","Holmskov, Uffe","Trebicka, Jonel","Sorensen, Grith Lykke","Krag, Aleksander"],"cuid":["S01-000.00-639164"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"corpau":["Galaxy Consortium"],"corresponding_author":["Stæhr Madsen, Bjørn"],"country":["Spain"],"glorg":["All Global Affiliations","Barcelona Institute of Science and Technology","European Foundation for the Study of Chronic Liver Failure"],"keyword":["Biomarker","Cirrhosis","Extracellular matrix protein","Liver biopsy","Non invasive testing"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"prediction of liver fibrosis severity in alcoholic liver disease by human microfibrillar associated protein 000000000004","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1111/liv.14491","version":"Published Version"},"id":"S01-000.00-639164","identifier":[{"id":"PMC7383987","type":"pmcid"},{"id":"32339377","type":"pmid"},{"id":"85084469647","type":"scopus"}],"ids":["sdu-e664d27c-beb4-4cb0-ac3c-ad33e88156d1"],"keyword":["biomarker","cirrhosis","extracellular matrix protein","liver biopsy","non-invasive testing"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-1F37B08FC83CDD9441939C04ACA7166B"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/170149412/liv.14491.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1111/liv.14491","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, FLASH - Centre for Liver Research (Odense)","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research Unit OPEN (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"es","key":"european foundation for the study of chronic liver failure","loc":["Spain","Europe, EU","OECD"],"name":"European Foundation for the Study of Chronic Liver Failure","used":1},{"affno":"3","country":"es","key":"barcelona institute of science and technology","loc":["Spain","Europe, EU","OECD"],"name":"Barcelona Institute of Science and Technology","used":1},{"affno":4,"key":"galaxy consortium","name":"Galaxy Consortium","role":"oau"}],"person":[{"affno":"1","corresponding":null,"first":"Bjørn Staehr","key":"madsenpau","last":"Madsen","locid":"8e118b7b-0ddc-46ae-a586-7f7286de5b3f","name":"Stæhr Madsen, Bjørn","name_org":"Madsen, Bjørn Staehr","orcid":"0000-0002-2846-3598","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Maja","key":"thielepau","last":"Thiele","locid":"b876b26d-ab19-4944-ad68-70d557cf0b56","name":"Thiele, Maja","orcid":"0000-0003-1854-1924","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sönke","key":"detlefsenpau","last":"Detlefsen","locid":"6bbd570e-0f99-4ee0-a239-7433591decbd","name":"Detlefsen, Sönke","orcid":"0000-0002-9466-2333","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mia Dahl","key":"sørensenpau","last":"Sørensen","locid":"3524a591-0bd0-4849-b735-4b916b84defb","name":"Sørensen, Mia Dahl","orcid":"0000-0002-0105-2940","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Maria","key":"kjaergaardpau","last":"Kjaergaard","locid":"14d11d78-16fb-489c-b729-77f420ed5bc1","name":"Kjærgaard, Maria","name_org":"Kjaergaard, Maria","orcid":"0000-0001-8452-1820","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Linda","key":"sevelstedmøll