5-999a-4384-8c41-23bfd95a6071","name":"Frei, Robert","orcid":"0000-0001-7708-9881","rank":9,"rolecode":"pau"},{"affno":"1","first":"Christoph","key":"kortechristophpau","last":"Korte","locid":"8be361f0-2fef-4576-b1cf-38b9fe3c8235","name":"Korte, Christoph","orcid":"0000-0001-5974-9516","rank":10,"rolecode":"pau"},{"affno":"1","first":"Arne Thorshøj","key":"nielsenarnethorshøjpau","last":"Nielsen","locid":"4cfac6f1-300e-4069-8cb5-fe41702bd81f","name":"Nielsen, Arne Thorshøj","rank":11,"rolecode":"pau"},{"affno":"4","first":"David A. T.","key":"harperdavidatpau","last":"Harper","name":"Harper, David A. T.","rank":12,"rolecode":"pau"}],"pmid":["26733399"],"pub":{"doi":"10.1038/srep18884","issn":["20452322"],"journal":"Scientific Reports","paperid":"18884","status":"p","title":"Scientific Reports","volume":"6"},"review":"Peer Reviewed","scoID":["2-s2.0-84953294146"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-a484f477-6e54-47e4-b4cf-aa7a935ed276"],"src":["KU University of Copenhagen"],"title":"Onset of main Phanerozoic marine radiation sparked by emerging Mid Ordovician icehouse","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-491727","year":"2016","yearsub":"2016"}
{"abstract":"Surgery for primary hyperparathyroidism (pHPT) has a high cure-rate and few complications. Preoperative localization procedures have permitted a dramatic shift from routine bilateral exploration to focused, minimally invasive procedures. At Odense University Hospital, Denmark, the introduction of focused surgery was combined with training of new surgeons. The objective of this study was to identify possible risk factors for treatment failure with special focus on surgical strategy and training of new surgeons. A 6-year prospective and consecutive series of 567 pHPT patients operated at Odense University hospital, Denmark, was analyzed. A shift in strategy was made in 2006 and at the same time new surgeons started training in parathyroid surgery. Biochemical-, clinical- and follow-up data were analyzed. Overall cure-rate was 90.7 %. Complication rates were 1.1 % for hemorrhage, 1.1 % for wound infection and 0.9 % for recurrent nerve paralysis. The only significant predictor of treatment failure at 6 months was histology of hyperplasia (OR 4.3). Neither the introduction of minimal invasive surgical strategy nor the training of new surgeons had a significant influence on the rate of treatment failures. Hyperplasia is a significant predictor of treatment failure in pHPT surgery. A shift towards systematic preoperative localization with focused surgery as well as training of new surgeons can be done without negative impact on treatment results. Identification of the hyperplasia and multigland patients in need of bilateral cervical exploration is crucial to avoid failures and raise cure rates.","author_count":3,"contributors":["Madsen, Anders Rørbæk","Rasmussen, Lars","Godballe, Christian"],"cuid":["S01-000.00-592898"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"risk factors for treatment failure in surgery for primary hyperparathyroidism the impact of change in surgical strategy and training procedures","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s00405-015-3678-6","version":"Other Version"},"id":"S01-000.00-592898","identifier":[{"id":"26044404","type":"pmid"},{"id":"84930532207","type":"scopus"}],"ids":["sdu-44ac0687-7704-4fdd-a011-def970be2c2c"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-E7E14CF4C0A3AA8F488BFC960C04C746"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s00405-015-3678-6","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Oto Rhino Laryngology (Odense)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anders Rørbæk","key":"madsenpau","last":"Madsen","locid":"686fd288-67ef-4a05-9e17-01d4cef47b86","name":"Madsen, Anders Rørbæk","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars","key":"rasmussenpau","last":"Rasmussen","locid":"9b0464c9-1f26-4fb8-a9e7-85f9155469b0","name":"Rasmussen, Lars","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Christian","key":"godballepau","last":"Godballe","locid":"ff9e9b81-947f-4b49-be93-3467ee6937e3","name":"Godballe, Christian","orcid":"0000-0001-7639-6337","rank":3,"rolecode":"pau"}],"pmid":["26044404"],"pub":{"doi":"10.1007/s00405-015-3678-6","issn":["09374477","09428992"],"issn_org":["09374477"],"issue":"6","journal":"European Archives of Oto-Rhino-Laryngology","pages":"1599-1605","publisher":"Springer Science+Business Media","status":"p","title":"European Archives of Oto-Rhino-Laryngology","volume":"273"},"review":"Peer Reviewed","scoID":["2-s2.0-84930532207"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-44ac0687-7704-4fdd-a011-def970be2c2c"],"src":["SDU University of Southern Denmark"],"title":"Risk factors for treatment failure in surgery for primary hyperparathyroidism : the impact of change in surgical strategy and training procedures","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-592898","year":"2016","yearsub":"2016"}
{"abstract":"Background In the 1990s outcomes in Danish lung cancer patients were poor compared with the other Nordic countries. The five-year survival was only about 5%, only 10% of patients were operated on and less than 60% received active surgical or oncologic treatment. This paper describes trends in mortality and survival of lung cancer in Denmark from 2000 to 2012. Methods The study population comprised 52 435 patients with a diagnosis of cancer of the trachea and the lung, primarily ascertained from the Danish Lung Cancer Register and grouped into three cohorts by year of diagnosis. The outcome measures covered the first year as well as the first full five-year period after diagnosis and comprised absolute mortality rate (per 100 patient years), absolute survival, and the relative survival. All outcomes were estimated for the overall patient population as well as after stratification by covariates. Results Overall, the mortality rates have declined significantly over time from 117 per 100 patient years to 88 for the one-year mortality and from 75 to 65 for the five-year mortality rates, respectively. With the exception of patients with advanced stage, declining mortality was observed for all strata by gender, comorbidity, stage and surgery status and was accompanied by corresponding improvements in both absolute and relative survival. Conclusions The mortality has been significantly declining and the prognosis correspondingly improving in lung cancer in Denmark since the turn of the millennium. As of today, survival after lung cancer in Denmark is probably in line with the international standard. Based on our results we recommend introducing mortality indicators based on all-cause mortality within the patient population in international benchmarking studies as comparisons based on cancer-specific mortality relative to the total general population may be misleading when interpreted in the context of outcomes and quality of care.","author_count":3,"contributors":["Jakobsen, Erik","Rasmussen, Torben Riis","Green, Anders"],"cuid":["S02-085.71-022389"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Adult","Aged","Aged 80 and over","Comorbidity","Denmark epidemiology","Female","Humans","Lung Neoplasms diagnosis","Male","Middle Aged","Registries","Survival Analysis","Survival Rate"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-SDR","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"mortality and survival of lung cancer in denmark results from the danish lung cancer group 000000002000 000000002012","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84964050285","version":"Other Version"},"id":"S02-085.71-022389","identifier":[{"id":"84964050285","type":"scopus"},{"id":"27056247","type":"pmid"}],"ids":["au-857cac96-62b7-4b87-a51b-22bfd64007d5","sdu-fad4c33e-6900-4108-b6f3-184276a76789"],"keyword":["Adult","Aged","Aged, 80 and over","Comorbidity","Denmark/epidemiology","Female","Humans","Lung Neoplasms/diagnosis","Male","Middle Aged","Registries","Survival Analysis","Survival Rate"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-5D1352954A538955616DDDC821127A3A"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research Unit OPEN (Odense)","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Cardiac, thoracic, and Vascular surgery (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["OPEN Open Patient data Explorative Network"],"nora_code":"DI-HO-SDR","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Respiratory Diseases and Allergy"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Erik","key":"jakobsenpau","last":"Jakobsen","locid":"02052281-ce08-42b0-a620-e444bed0ac71","name":"Jakobsen, Erik","orcid":"0000-0002-0052-7705","rank":1,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Torben Riis","key":"rasmussenpau","last":"Rasmussen","locid":"311942d4-5b0f-4c92-879f-8d32a246ebf6","name":"Rasmussen, Torben Riis","orcid":"0000-0002-7030-9260","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders","key":"greenpau","last":"Green","locid":"efdbf426-9cae-4f5c-8c23-56c94fc85853","name":"Green, Anders","orcid":"0000-0002-5059-3655","rank":3,"rolecode":"pau"}],"pmid":["27056247"],"pub":{"doi":"10.3109/0284186x.2016.1150608","issn":["0284186X","11001704"],"issn_org":["0284186X"],"issue":"Suppl. 2","journal":"Acta Oncologica","pages":"2-9","publisher":"Medical Journals Sweden AB","status":"p","title":"Acta Oncologica","volume":"55"},"review":"Peer Reviewed","scoID":["2-s2.0-84964050285"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-857cac96-62b7-4b87-a51b-22bfd64007d5","sdu-fad4c33e-6900-4108-b6f3-184276a76789"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Mortality and survival of lung cancer in Denmark: Results from the Danish Lung Cancer Group 2000-2012.","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-085.71-022389","year":"2016","yearsub":"2016"}
{"abstract":"Indvinding af skifergas har i de senere år påkaldt sig stigende interesse internationalt og i Danmark.På den baggrund har Miljø- og Fødevareministeriet bedt DTU, GEUS og DCE om at indgå en konsortieaftale om at udarbejde en videnskabelig udredning.Formålet med den videnskabelige udredning er at sætte international viden om indvinding af skifergas i relation til en dansk kontekst.I udredningen redegøres der for de regionale geologiske forhold i skifergasproduktion i Danmark, boring og effekt af boring og frakturering, og der foretages en analyse af de mulige påvirkninger af miljø og vandressourcer samt landskab og trafik.På den baggrund gives der indledningsvist en overordnet beskrivelse af skifergas, forventet anvendt teknologi i forbindelse med skifergasproduktion samt en beskrivelse af mulige miljøpåvirkninger og tilgængelige afværgeforanstaltninger.Den videnskabelige udredning indeholder også en screening af de risici og farer, der kunne være forbundet med skifergasindvinding i Danmark.","author_count":39,"contributors":["Nielsen, Niels Axel","Christensen, Thomas Højlund","Aagaard, Niels-Jørgen","Bach, Hanne","Larsen, Flemming","Britze, Peter","Molzen, Jan Eiersted","Hansen, Steffen Foss","Johnsen, Anders R.","Jensen, Poul Nordemann","Odgaard, Mads H","Bjerg, Poul Løgstrup","Fabricius, Ida Lykke","Jensen, Lotte Bjerregaard","Scheutz, Charlotte","Andersen, Henrik Rasmus","Kjeldsen, Peter","Hjorth, Rune","Baun, Anders","Kozin, Igor","Nikolajew, Maja Møller","Sørensen, Morten Kanne","Nielsen, Thomas Alexander Sick","Schovsbo, Niels","Kidmose, Jakob B.","Gravesen, Peter","Voss, Peter","Jakobsen, Rasmus","Pedersen, Stig Asbjørn Schack","Larsen, Tine B.","Dahl Jensen, Trine","Laier, Troels","Sanderson, Hans","Baattrup-Pedersen, Annette","Winding, Anne","Levin, Gregor","Jessen Rasmussen, Jes","Gustavson, Kim","Frederiksen, Pia"],"cuid":["S02-100.00-012182"],"filters":{"added":"2023-05","altsrc":["No Matches Found"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-ART"],"level3":{"ART":["DI-ART-AAA","DI-ART-ALL","DI-ART-RDKA"]},"level3all":["DI-ART-AAA","DI-ART-RDKA"]},"review":"pr","rtype":["clu"],"sorti":"videnskabelig udredning af international viden om skifergas relateret til en dansk kontekst dtu geus dce","src":["arka","arkc"],"src-code":["DI-ART-AAA","DI-ART-RDKA"],"type":"db","type-grp":["all","pub"]},"id":"S02-100.00-012182","ids":["arka-08db9cd2-ab75-4052-92d7-b4c7d73f2989","arkc-08db9cd2-ab75-4052-92d7-b4c7d73f2989"],"keyword":["Nej"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-2-9DB6F2AC1939103A1A0FA4A2D703ED01"],"org":[{"affno":"1","key":"aarhus school of architecture","l2":"DI-ART","l2n":"Artistic Higher Education Institutions","l3":"DI-ART-AAA","l3nn":"Aarhus School of Architecture","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Aarhus School of Architecture","namevar":["Aarhus School of Architecture"],"nora_code":"DI-ART-AAA","used":1},{"affno":"2","key":"royal danish academy architecture design conservation","l2":"DI-ART","l2n":"Artistic Higher Education Institutions","l3":"DI-ART-RDKA","l3nn":"Royal Danish Academy - Architecture, Design, Conservation","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Royal Danish Academy - Architecture, Design, Conservation","namevar":["The Royal Danish Academy of Fine Arts, Schools of Architecture, Design and Conservation, School of Architecture"],"nora_code":"DI-ART-RDKA","used":1}],"person":[{"affno":"","corresponding":null,"first":"Niels Axel","key":"nielsennielsaxelpau","last":"Nielsen","name":"Nielsen, Niels Axel","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Thomas Højlund","key":"christensenthomashøjlundpau","last":"Christensen","name":"Christensen, Thomas Højlund","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Niels-Jørgen","key":"aagaardnielsj