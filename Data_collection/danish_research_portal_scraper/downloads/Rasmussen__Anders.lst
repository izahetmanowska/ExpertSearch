-5156","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"J.","key":"madsenpau","last":"Madsen","name":"Madsen, J.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"V.","key":"naulinpau","last":"Naulin","locid":"68cb67c0-c64d-4fef-a301-67ab58d8ace6","name":"Naulin, Volker","name_org":"Naulin, V.","orcid":"0000-0001-5452-9215","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"A. H.","key":"nielsenpau","last":"Nielsen","locid":"1d9aa958-9d84-4a3b-8300-f6fe9b0be73e","name":"Nielsen, Anders Henry","name_org":"Nielsen, A. H.","orcid":"0000-0003-3642-3905","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"J.","key":"juulrasmussenpau","last":"Juul Rasmussen","locid":"125b9658-f84c-4e0e-859e-5899413288ee","name":"Rasmussen, Jens Juul","name_org":"Juul Rasmussen, J.","orcid":"0000-0002-3543-690X","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-992823ad-1afa-42c4-b920-6ab7257852ae"],"src":["DTU Technical University of Denmark"],"title":"The influence of blob intermittency on fuelling","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-350230","year":"2017","yearsub":"2018"}
{"abstract":"The impact of ion pressure dynamics on E x B mean flows is investigated. Using a simplified, two-dimensional, drift ordered fluid model in the thin-layer approximation, three stresses in addition to the Reynolds stress are shown to modify the E x B mean flow. These additional terms in the stress tensor all require ion pressure fluctuations. Quasi-linear analysis shows that these additional stresses are as important as the Reynolds stress and hence must be taken into account in analysis of transport barriers in which sheared E x B mean flows are key ingredients.","author_count":4,"contributors":["Madsen, Jens","Rasmussen, Jens Juul","Naulin, Volker","Nielsen, Anders Henry"],"cuid":["S01-000.00-375072"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"exb mean flows in finite ion temperature plasmas","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/136766780/Untitled.pdf","version":"Published Version"},"id":"S01-000.00-375072","identifier":[{"id":"85021165451","type":"scopus"}],"ids":["dtu-eba22e9c-79d6-4820-b773-35e829e36f2f"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-D38037BBDCC33C253345E0AC87EF9B5F"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/136766780/Untitled.pdf","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/136766777/pdf_archivePHPAENvol_24iss_6062309_1_am_2_.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"dtu tec