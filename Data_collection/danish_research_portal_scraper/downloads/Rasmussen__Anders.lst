 4 1","corresponding":null,"country":"dk","first":"Christian","key":"torppedersenpau","last":"Torp-Pedersen","locid":"5417d806-0578-4505-b3fe-68ae0359913e","name":"Torp-Pedersen, Christian","rank":9,"rolecode":"pau"},{"affno":"1 2 5","first":"Gunnar H.","key":"gislasonpau","last":"Gislason","locid":"c0f678a6-eb13-49a3-9485-8fae1e72e2a1","name":"Gislason, Gunnar","name_org":"Gislason, Gunnar H.","rank":10,"rolecode":"pau"},{"affno":"1 2","first":"Morten Lock","key":"hansenpau","last":"Hansen","locid":"870786a1-f42f-40fa-b820-1608236b578c","name":"Hansen, Morten Lock","rank":11,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Patricia","key":"mcgettiganpau","last":"McGettigan","name":"McGettigan, Patricia","rank":12,"rolecode":"pau"},{"affno":"1 2","first":"Morten","key":"lambertspau","last":"Lamberts","locid":"ced953f0-cd5e-4af3-8c41-7311decea61f","name":"Lamberts, Morten","rank":13,"rolecode":"pau"}],"pmid":["34861201"],"pub":{"doi":"10.1016/j.amjmed.2021.11.008","issn":["00029343","02105713"],"issn_org":["00029343"],"issue":"5","journal":"American Journal of Medicine","publisher":"Elsevier","status":"p","title":"American Journal of Medicine","title_org":"The American Journal of Medicine","volume":"135"},"review":"Peer Reviewed","scoID":["2-s2.0-85122514918"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Non-Profit Organisations","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Hospitals","Non-Profit Organisations","Region Zealand","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-e66a4763-d42e-47b3-9d67-18563d554755","ku-4ff1f933-5df1-497d-ba0a-9f881ddbf1e9"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"Bleeding Risk Following Systemic Fluconazole or Topical Azoles in Patients with Atrial Fibrillation on Apixaban, Rivaroxaban, or Dabigatran","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-011007","year":"2022","yearsub":"2022"}
{"abstract":"Currently, psychiatric diagnoses are, in contrast to most other medical fields, based on subjective symptoms and observable signs and call for new and improved diagnostics to provide the most optimal care. On the basis of a deep learning approach, we performed unsupervised patient stratification of 19,636 patients with depression [major depressive disorder (MDD)] and/or schizophrenia (SCZ) and 22,467 population controls from the iPSYCH2012 case cohort. We integrated data of disorder severity, history of mental disorders and disease comorbidities, genetics, and medical birth data. From this, we stratified the individuals in six and seven unique clusters for MDD and SCZ, respectively. When censoring data until diagnosis, we could predict MDD clusters with areas under the curve (AUCs) of 0.54 to 0.80 and SCZ clusters with AUCs of 0.71 to 0.86. Overall cases and controls could be predicted with an AUC of 0.81, illustrating the utility of data-driven subgrouping in psychiatry.","author_count":10,"contributors":["Allesøe, Rosa Lundbye","Nudel, Ron","Thompson, Wesley K.","Wang, Yunpeng","Nordentoft, Merete","Børglum, Anders D","Hougaard, David M.","Werge, Thomas","Rasmussen, Simon","Benros, Michael Eriksen"],"cuid":["S02-100.00-015299"],"filters":{"added":"2022-08","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["America, North","Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Benros, Michael Eriksen","Rasmussen, Simon"],"country":["Norway","United States"],"glorg":["All Global Affiliations","Oslo University Hospital","University of California at San Diego","University of Oslo"],"keyword":["Deep learning","Depression genetics","Depressive Disorder Major diagnosis","Humans","Registries","Schizophrenia diagnosis"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-NP","DI-OT","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP"],"NP":["DI-NP-ALL","DI-NP-LUND"],"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-NP-LUND","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"deep learning based integration of genetics with registry data for stratification of schizophrenia and depression","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85133215148","version":"Other Version"},"id":"S02-100.00-015299","identifier":[{"id":"PMC9242585","type":"pmcid"},{"id":"35767618","type":"pmid"},{"id":"85133215148","type":"scopus"}],"ids":["au-253dd6c0-d47f-418c-880c-d9a7c652c241","ku-755eb331-953d-4c62-843e-f4be6eacccf8"],"keyword":["Deep Learning","Depression/genetics","Depressive Disorder, Major/diagnosis","Humans","Registries","Schizophrenia/diagnosis"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-DE406D2F3A33585C24BD1C4B8511BA9E"],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Protein Research, Rasmussen Group"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Mental Health Services Glostrup"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","country":"dk","key":"lundbeck foundation","l2