ing":null,"first":"M. B.","key":"mollerpau","last":"Moller","locid":"edd876e8-0651-4c8f-8f0f-95f4519e1654","name":"Møller, Michael Boe","name_org":"Moller, M. B.","orcid":"0000-0003-2041-3630","rank":17,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Michael B","key":"møllerpau","last":"Møller","name":"Møller, Michael B","rank":17,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Richard","key":"samworthpau","last":"Samworth","name":"Samworth, Richard","rank":18,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Rajen","key":"shahpau","last":"Shah","name":"Shah, Rajen","rank":19,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Preben","key":"johansenpau","last":"Johansen","locid":"9322e821-9b26-4e37-a703-1e23e083d0c9","name":"Johansen, Preben","rank":20,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Tarec Christoffer","key":"elgalalypau","last":"El-Galaly","locid":"1d601b96-c71c-4a76-ac06-4d95e0a50a74","name":"El-Galaly, Tarec Christoffer","orcid":"0000-0002-4406-380X","rank":21,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Ken H","key":"youngpau","last":"Young","name":"Young, Ken H","rank":22,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Hans Erik","key":"johnsenpau","last":"Johnsen","locid":"534a42b8-2774-424e-a4de-384f478549ea","name":"Johnsen, Hans Erik","orcid":"0000-0001-8253-2913","rank":23,"rolecode":"pau"}],"pub":{"doi":"10.1182/blood.v124.21.2973.2973","issn":["00064971","15280020"],"issn_org":["00064971"],"issue":"21","journal":"Blood","publisher":"Elsevier","status":"p","title":"Blood","volume":"124"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-37338a2a-50ad-4802-9e10-613b3a01393c","sdu-11e6856e-67cc-4426-baa0-35b4567c53c4"],"src":["AAU Aalborg University","SDU University of Southern Denmark"],"title":"A Diffuse Large B-Cell Lymphoma Classification System That Associates Normal B-Cell Subset Phenotypes with Prognosis","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-081.61-002740","year":"2014","yearsub":"2014"}
{"abstract":"Arctic populations live in an environment characterized by extreme cold and the absence of plant foods for much of the year and are likely to have undergone genetic adaptations to these environmental conditions in the time they have been living there. Genome-wide selection scans based on genotype data from native Siberians have previously highlighted a 3 Mb chromosome 11 region containing 79 protein-coding genes as the strongest candidates for positive selection in Northeast Siberians. However, it was not possible to determine which of the genes might be driving the selection signal. Here, using whole-genome high-coverage sequence data, we identified the most likely causative variant as a nonsynonymous G>A transition (rs80356779; c.1436C>T [p.Pro479Leu] on the reverse strand) in CPT1A, a key regulator of mitochondrial long-chain fatty-acid oxidation. Remarkably, the derived allele is associated with hypoketotic hypoglycemia and high infant mortality yet occurs at high frequency in Canadian and Greenland Inuits and was also found at 68% frequency in our Northeast Siberian sample. We provide evidence of one of the strongest selective sweeps reported in humans; this sweep has driven this variant to high frequency in circum-Arctic populations within the last 6–23 ka despite associated deleterious consequences, possibly as a result of the selective advantage it originally provided to either a high-fat diet or a cold environment.","author_count":33,"contributors":["Clemente, Florian J.","Cardona, Alexia","Inchly, Charlotte E.","Peters, Benjamin M.","Jacobs, Guy","Pagani, Luca","Lawson, Daniel J.","Añtao, Tiago","Vicente, Mário","Mitt, Mario","DiGiorgio, Michael","Faltyskova, Zuzana","Xue, Yali","Ayub, Qasim","Szpak, Michal","Mägi, Reedik","Eriksson, Anders","Manica, Andrea","Raghavan, Maanasa","Rasmussen, Morten","Rasmussen, Simon","Willerslev, Eske","Vidal-Puig, Antonio","Tyler-Smith, Chris","Willems, Richard","Nielsen, Rasmus","Metspalu, Mait","Malyarchuk, Boris","Derenko, Miroslava","Kivisild, Toomas"],"cuid":["S02-088.59-035136"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","Europe, EU","Europe, Non-EU","OECD"],"country":["Estonia","United Kingdom","United States"],"glorg":["All Global Affiliations","Liverpool School of Tropical Medicine","University of Bristol","University of California at Berkeley","University of Cambridge","University of Southampton","University of Tartu"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"a selective sweep on a deleterious mutation in i cpt000000000001a i in arctic populations","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.ajhg.2014.09.016","version":"Other Version"},"id":"S02-088.59-035136","identifier":[{"id":"84920567005","type":"scopus"},{"id":"25449608","type":"pmid"},{"id":"PMC4225582","type":"pmcid"}],"ids":["dtu-6f232757-1e01-4f87-9605-1d2c604a242e","ku-bfe3e31c-9b13-4e56-b8f5-d218a88a9632"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-205839266A4A8EE3C4426CEFD0B3886B"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.sciencedirect.com/science/article/pii/S0002929714004224","version":"Other Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.ajhg.2014.09.016","version":"Other Version"}],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","country":"gb","key":"university of cambridge","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Cambridge","used":1},{"affno":"2","country":"us","key":"university of california a