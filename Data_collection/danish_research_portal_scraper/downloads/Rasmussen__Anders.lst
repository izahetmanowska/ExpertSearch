hbek","name_org":"Andersen, Iben R.","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Rene","key":"olesenpau","last":"Olesen","locid":"748a4f79-86dd-42a0-a7b3-838e8e060d4e","name":"Olesen, Rene K.","name_org":"Olesen, Rene","rank":2,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Anders K.","key":"boysenpau","last":"Boysen","locid":"304f79e0-6a7b-48a3-bbef-db956a9a25bb","name":"Boysen, Anders Kindberg","name_org":"Boysen, Anders K.","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Lars H","key":"jensenpau","last":"Jensen","locid":"5b427622-91b5-4f6e-b14f-2945da9dad8c","name":"Jensen, Lars Henrik","name_org":"Jensen, Lars H","orcid":"0000-0002-0020-1537","rank":4,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Frank V.","key":"mortensenpau","last":"Mortensen","locid":"0a97b206-1933-4250-9b71-bd2ea2fa707c","name":"Mortensen, Frank Viborg","name_org":"Mortensen, Frank V.","rank":5,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Dennis T.","key":"nielsenpau","last":"Nielsen","locid":"241dc0b5-b852-4b22-ad8f-22247039afa1","name":"Nielsen, Dennis Tønner","name_org":"Nielsen, Dennis T.","rank":6,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Finn","key":"rasmussenpau","last":"Rasmussen","locid":"1c4dadf5-d001-4c6c-9f23-347af298c53d","name":"Rasmussen, Finn","rank":7,"rolecode":"pau"}],"pmid":["30348001"],"pub":{"doi":"10.1177/0284185118806652","issn":["02841851","16000455"],"issn_org":["02841851"],"issue":"7","journal":"Acta Radiologica","pages":"836-845","publisher":"SAGE Publications Ltd","status":"p","title":"Acta Radiologica","volume":"60"},"review":"Peer Reviewed","scoID":["2-s2.0-85060551076"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["