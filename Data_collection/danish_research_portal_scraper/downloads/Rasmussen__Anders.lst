{"abstract":"Dabigatran may provide less protection against myocardial infarction than vitamin K antagonists (VKAs) in patients with atrial fibrillation. This may be particularly evident among 'switchers' to dabigatran from VKA, as a result of discontinuation effects.","author_count":7,"contributors":["Larsen, Torben Bjerregaard","Rasmussen, Lars Hvilsted","Gorst-Rasmussen, Anders","Skjøth, Flemming","Rosenzweig, Mary","Lane, Deirdre A.","Lip, Gregory Y H"],"cuid":["S01-000.00-100745"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Danish Health Authority"],"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"myocardial ischemic events in real world patients with atrial fibrillation treated with dabigatran or warfarin a nationwide cohort study","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-100745","identifier":[{"id":"84897883176","type":"scopus"},{"id":"24361757","type":"pmid"},{"id":"WOS:000333261000023","type":"wos"}],"ids":["aau-aea87520-cb42-4b2c-a011-4a82fac07a0c"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-F939334CB17D47F0405D983558353D5B"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Aalborg AF Study Group","Aalborg University, The Faculty of Medicine, Aa