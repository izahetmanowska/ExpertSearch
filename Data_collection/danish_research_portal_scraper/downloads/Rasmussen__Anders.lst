":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-92413efb-9bca-4423-b5b6-91fe0ec7aba8"],"src":["SDU University of Southern Denmark"],"title":"The effectiveness of instrumented gait analysis for interdisciplinary interventions in young children with cerebral palsy : A randomised controlled trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-615143","year":"2018","yearsub":"2018"}
{"abstract":"Background: Treatment of acute pain is of primary concern in emergency care, and health professionals have to constantly make choices between the available treatment options for their patients. Efficient treatment entails specific requirements to the applied analgesic agent; ease of administration, fast onset of pain relief, evidence of effect, acceptable balance between effects and side effects, favorable cost-effectiveness and accordance with users’ values and preferences. The GRADE Evidence to Decision framework entails these requirements, and represents a systematic and transparent system that health professionals can use to make well informed health care choices. Although all criteria within the GRADE framework are of equal importance in the decision making process, the criterion of values and preferences may have been overlooked in the process, possibly due to a lack of consensus on how to validly assess this concept. Thus, in this study we propose a new method to identify, organize and prioritize values and preferences associated with health care professionals’ choice of analgesia in emergency and pre-hospital settings for patients with acute trauma pain.","author_count":6,"contributors":["Rasmussen, Marianne Uggen","Nielsen, Kristina Tomra","Overgaard, Anders Føhrby","Christensen, Robin","Klokker, Louise","Wæhrens, Eva Ejlersen"],"cuid":["S01-000.00-650393"],"event":{"end":"2018-09-12","place":"Glascow , gb","start":"2018-09-08","title":"The European Emergency Medicine Congress (EUSEM)","year":"2018"},"filters":{"added":"2023-01","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["disease health science and nursing"],"level":"sci","oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-UC"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"UC":["DI-UC-ALL","DI-UC-UCN"]},"level3all":["DI-HO-CAP","DI-UC-UCN"]},"review":"pr","rtype":["clu"],"sorti":"choice of analgesia in emergency and pre hospital settings in patients with acute trauma pain a concept mapping study with focus on values and preferences","src":["ucn"],"src-code":["DI-UC-UCN"],"type":"dco","type-grp":["all","pub"]},"id":"S01-000.00-650393","ids":["ucn-21a61b2e-cccd-4585-a64d-dd76747a21e6"],"keyword":["disease, health science and nursing"],"lang":"English","level":"Scientific","noi":["Local-1-1-EE0C8136C993C87628A620AC4CF18B43"],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Parker Instituttet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ucn university college of northern denmark","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-UCN","l3nl":"University College of Northern Denmark","l3nn":"UCN University College of Northern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"UCN University College of Northern Denmark","namevar":["Professionshøjskolen UCN, UCN Direktion, UCN Velfærd, Ergoterapeutuddannelsen"],"nora_code":"DI-UC-UCN","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Marianne Uggen","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Marianne Uggen","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kristina Tomra","key":"nielsenpau","last":"Nielsen","locid":"2b848116-080f-4b20-bb1a-03255c905245","name":"Nielsen, Kristina Tomra","orcid":"0000-0002-4944-9453","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders Føhrby","key":"overgaardpau","last":"Overgaard","name":"Overgaard, Anders Føhrby","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Robin","key":"christensenpau","last":"Christensen","name":"Christensen, Robin","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Louise","key":"klokkerpau","last":"Klokker","name":"Klokker, Louise","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Eva Ejlersen","key":"wæhrenspau","last":"Wæhrens","name":"Wæhrens, Eva Ejlersen","rank":6,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Hospitals","All University Colleges","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-UC","DI-UC-ALL","Hospitals","University College of Northern Denmark","University Colleges"],"PST":["Published"]},"sid":["ucn-21a61b2e-cccd-4585-a64d-dd76747a21e6"],"src":["UCN University College of Northern Denmark"],"title":"Choice of analgesia in emergency and pre-hospital settings in patients with acute trauma pain- a concept mapping study with focus on values and preferences","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-650393","year":"2018","yearsub":"2018"}
