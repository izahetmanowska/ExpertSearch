-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-3351e4a5-b781-485b-95c1-3cd5164281c5"],"src":["SDU University of Southern Denmark"],"title":"Treating the actions of children as sensible : Investigating structures in interactions between children with disabilities and their parents","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-587922","year":"2011","yearsub":"2011"}
{"abstract":"What is life? How does nonliving materials become alive? How did the first living cells emerge on Earth? How can artificial living processes be useful for technology? These are the kinds of questions we seek to address by assembling minimal living systems from scratch.","author_count":4,"contributors":["Rasmussen, Steen","Albertsen, Anders N.","Pedersen, Pernille Lykke","Svaneborg, Carsten"],"cuid":["S01-000.00-597050"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","OECD"],"corresponding_author":["Rasmussen, Steen"],"country":["United States"],"glorg":["All Global Affiliations","Santa Fe Institute"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"constructing protocells a second origin of life","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/184015969/1095_Texto_del_art_culo_3763_1_10_20130718.pdf","version":"Published Version"},"id":"S01-000.00-597050","identifier":[{"id":"84862873228","type":"scopus"}],"ids":["sdu-531d81e7-227a-48a8-b7c7-8b0b73eeaac1"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-7A1FE926880FDC0C6AFDB2CC52CFAC3E"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"rem","url":"https://revistas.comillas.edu/index.php/pensamiento/article/view/1095","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/184015969/1095_Texto_del_art_culo_3763_1_10_20130718.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Souther