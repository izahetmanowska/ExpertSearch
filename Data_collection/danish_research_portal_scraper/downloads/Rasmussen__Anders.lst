{"author_count":2,"contributors":["Willert, Kristoffer Balslev","Rasmussen, Anders Moe"],"cuid":["S01-000.00-168710"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Mening","Naturalisme","Ontologi","Realisme"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"epilog markus gabriel og hans filosofiske udgangspunkt","src":["au"],"src-code":["DI-U-AU"],"type":"dbp","type-grp":["all","pub"]},"id":"S01-000.00-168710","ids":["au-45099b42-fb04-4982-a0a3-8a35ed329c99"],"keyword":["Mening","Naturalisme","Ontologi","Realisme"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-46BFA223CDEC976F68940F9FCFEAD21D"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, School of Culture and Society, School of Culture and Society - Philosophy and History of Ideas, Department of"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Kristoffer Balslev","key":"willertpau","last":"Willert","locid":"c9cf870d-ae2b-46c7-b406-85412379d1d8","name":"Willert, Kristoffer Balslev","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anders Moe","key":"rasmussenpau","last":"Rasmussen","locid":"e9773c7c-a46d-4591-b659-4151bea40a43","name":"Rasmussen, Anders Moe","rank":2,"rolecode":"pau"}],"pub":{"eisbn":["9788793041493"],"isbn":["9788793041486"],"pages":"219-231","place":"Aarhus","publisher":"Forlaget Philosophia","status":"p","title":"Hvorfor verden ikke findes","volume":"1"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-45099b42-fb04-4982-a0a3-8a35ed329c99"],"src":["AU Aarhus University"],"title":"Epilog: Markus Gabriel og hans filosofiske udgangspunkt","type":"Book Preface, Encycl. Entry","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-168710","year":"2018","yearsub":"2018"}
{"abstract":"Many resources have been spent to successfully improve the outcome and prognosis of lung cancer during the last decade. However, surprisingly few studies and real-life settings deal with smoking cessation as an integrated part of screening and treatment for lung cancer even though the evidence is compelling - these events offer a window of opportunity, as smokers are motivated to quit. Furthermore, the effect of smoking cessation with respect to survival, prognosis and quality of life equals the established treatment: surgery, chemotherapy and radiation.","author_count":3,"contributors":["Løkke, Anders","Christensen, Niels Lyhne","Rasmussen, Torben Riis"],"cuid":["S01-000.00-193394"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"smoking cessation and lung cancer treatment","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85055614108","version":"Other Version"},"id":"S01-000.00-193394","identifier":[{"id":"30375965","type":"pmid"},{"id":"85055614108","type":"scopus"}],"ids":["au-7034719e-d657-4547-b188-553462d59cef"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-CA30B45CF87F9E0F14514F483D73FA03"],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Respiratory Diseases and Allergy"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anders","key":"løkkepau","last":"Løkke","locid":"93e030be-623c-4143-ab57-fb097315970e","name":"Løkke, Anders","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Niels Lyhne","key":"christensenpau","last":"Christensen","locid":"602d74ce-1885-499c-90da-05dd61bb3148","name":"Christensen, Niels Lyhne","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Torben Riis","key":"rasmussenpau","last":"Rasmussen","locid":"311942d4-5b0f-4c92-879f-8d32a246ebf6","name":"Rasmussen, Torben Riis","orcid":"0000-0002-7030-9260","rank":3,"rolecode":"pau"}],"pmid":["30375965"],"pub":{"issn":["00415782","13994174"],"issn_org":["00415782"],"issue":"44","journal":"Ugeskrift for Læger","publisher":"Almindelige Danske Lægeforening","status":"p","title":"Ugeskrift for Læger","volume":"180"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-7034719e-d657-4547-b188-553462d59cef"],"src":["AU Aarhus University"],"title":"Smoking cessation and lung cancer treatment","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-193394","year":"2018","yearsub":"2018"}
{"abstract":"The prey choices of predators are determined, in part, by their hunting strategies. The sit-and-wait and the actively searching strategies seem designed for active and stationary prey, respectively. A supposedly intermediate strategy, the saltatory or sit-and-move strategy, combines sitting still, scanning for prey with frequent moves to new scanning sites. We tested the hypothesis that the spontaneous movements of predators, i.e. activity performed in constant conditions in the laboratory, reflect their hunting strategy. We compared the crab spider Xysticus cristatus (sit-and-wait), the sac spider Clubiona phragmitis (active hunting) and the wolf spider Pardosa amentata (sit-and-move). We used automatic video tracking throughout 6 h during both light and dark conditions to quantify movement parameters: time in movement/rest; total distance moved, maximal velocity; mean velocity during movement; number of stops, longest rest period; and turn rate and turn bias. Xysticus and Clubiona confirmed predictions, but Pardosa showed a combination of movement parameters that was not intermediate between the other two. We suggest the existence of a sit-and-wait/sit-and-move continuum with varying proportions of sitting and moving, characterized by scanning for prey from a resting position, whereas the active searching strategy is distinct owing to detection of prey while the predator is moving.","author_count":3,"contributors":["Baatrup, Erik","Rasmussen, Anders Overgaard","Toft, Søren"],"cuid":["S01-000.00-232114"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Arachnida","Hunting mode","Locomotion","Predation strategy"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"spontaneous movement behaviour in spiders araneae with different hunting strategies","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85055121498","version":"Other Version"},"id":"S01-000.00-232114","identifier":[{"id":"85055121498","type":"scopus"}],"ids":["au-b4271f1e-88a3-43e0-92e6-d323ea609448"],"keyword":["Arachnida","Hunting mode","Locomotion","Predation strategy","Prey searching"],"lang":"Danish","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-963F6652CE1453B620E32D48CFCB9FE3"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Biology, Department of Biology - Zoophysiology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Erik","key":"baatruppau","last":"Baatrup","locid":"89662914-e86f-4ef3-8f40-5b047092da49","name":"Baatrup, Erik","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders Overgaard","key":"rasmussenpau","last":"Rasmussen","locid":"5090d4ce-11da-49fd-aa27-db685e0c4c3d","name":"Rasmussen, Anders Overgaard","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren","key":"toftpau","last":"Toft","locid":"b9eacec2-544f-4d54-8ef8-63f2c0affe65","name":"Toft, Søren","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1093/biolinnean/bly099","issn":["00244066","10958312"],"issn_org":["00244066"],"issue":"1","journal":"Biological Journal of the Linnean Society","pages":"184-193","publisher":"Oxford University Press","status":"p","title":"Biological Journal of the Linnean Society","volume":"125"},"review":"Peer Reviewed","scoID":["2-s2.0-85055121498"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-b4271f1e-88a3-43e0-92e6-d323ea609448"],"src":["AU Aarhus University"],"title":"Spontaneous movement behaviour in spiders (Araneae) with different hunting strategies","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-232114","year":"2018","yearsub":"2018"}
{"abstract":"BACKGROUND: There is paucity of evidence regarding the optimal follow-up (FU) regimen for lung cancer. Consequently, FU is organized differently across countries. The Danish FU regimen has short FU intervals with a computed tomography (CT) scan of the chest and upper abdomen every three months in the early phase (first 2 years), then every six months in the late phase of FU (3rd, 5th year). Characterizing recurrences missed by the FU program in terms of site, tumor histology, department, and phase of FU, could improve the FU program. MATERIAL AND METHOD: A case-control study of curatively treated stage I lung cancer patients who attended the Danish FU-program and had recurrence identified through the follow-up program (controls, FU group) or outside FU program (cases, symptomatic group). RESULTS: Of 233 included patients with recurrence, the FU group constituted 85% (n = 197). Among the 15% (n = 36) in the symptomatic group, 53% had involvement of the central nervous system compared with 3% in the FU group. The unadjusted odds ratio (OR) for having an isolated brain recurrence (IBR) in the symptomatic group was 52.3 (95%CI: 15.1-181.4) as compared with the FU group. The OR for having a symptomatic recurrence in the early phase of FU was 2.5 (95%CI: 0.7-8.7) compared with the late phase. CONCLUSIONS: The FU program did not identify the majority of patients with IBR. Including cerebral imaging in the FU program may result in an earlier detection of brain metastases. These matters should be studied in a prospective setting.","author_count":6,"contributors":["Christensen, Niels Lyhne","Dalton, Susanne Oksbjerg","Mellemgaard, Anders","Christensen, Jane","Kejs, Anne Mette Tranberg","Rasmussen, Torben Riis"],"cuid":["S01-000.00-262915"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Aftercare methods","Aged","Aged 80 and over","Brain Neoplasms diagnostic imaging","Case Control Studies","Denmark","Female","Humans","Lung Neoplasms pathology","Male","Middle Aged","Neoplasm Recurrence Local pathology","Tomography X Ray Computed"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-NP","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-NP-CAN","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"assessing the pattern of recurrence in danish stage i lung cancer patients in relation to the follow up program are we failing to identify patients with cerebral recurrence","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85049969133","version":"Other Version"},"id":"S01-000.00-262915","identifier":[{"id":"30010453","type":"pmid"},{"id":"85049969133","type":"scopus"}],"ids":["au-ea0ec805-9223-4fde-92b7-995568bb295f"],"keyword":["Aftercare/methods","Aged","Aged, 80 and over","Brain Neoplasms/diagnostic imaging","Case-Control Studies","Denmark","Female","Humans","Lung Neoplasms/pathology","Male","Middle Aged","Neoplasm Recurrence, Local/pathology","Tomography, X-Ray Computed"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-8A0B23313EBDAFBAE580D9DD171B7CA6"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Respiratory Diseases and Allergy"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"dk","key":"dcrc danish cancer society research center","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-CAN","l3nn":"DCRC Danish Cancer Society Research Center","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DCRC Danish Cancer Society Research Center","namevar":["Danish Cancer Society"],"nora_code":"DI-NP-CAN","used":1},{"affno":"4","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Hospital of Bornholm"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"Niels Lyhne","key":"christensennielslyhnepau","last":"Christensen","locid":"602d74ce-1885-499c-90da-05dd61bb3148","name":"Christensen, Niels Lyhne","rank":1,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Susanne Oksbjerg","key":"daltonsusanneoksbjergpau","last":"Dalton","name":"Dalton, Susanne Oksbjerg","rank":2,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Anders","key":"mellemgaardanderspau","last":"Mellemgaard","name":"Mellemgaard, Anders","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jane","key":"christensenjanepau","last":"Christensen","name":"Christensen, Jane","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Anne Mette Tranberg","key":"kejsannemettetranbergpau","last":"Kejs","name":"Kejs, Anne Mette Tranberg","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Torben Riis","key":"rasmussentorbenriispau","last":"Rasmussen","locid":"311942d4-5b0f-4c92-879f-8d32a246ebf6","name":"Rasmussen, Torben Riis","orcid":"0000-0002-7030-9260","rank":6,"rolecode":"pau"}],"pmid":["30010453"],"pub":{"doi":"10.1080/0284186x.2018.1490028","issn":["0284186X","11001704"],"issn_org":["0284186X"],"issue":"11","journal":"Acta Oncologica","pages":"1556-1560","publisher":"Medical Journals Sweden AB","status":"p","title":"Acta Oncologica","volume":"57"},"review":"Peer Reviewed","scoID":["2-s2.0-85049969133"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Non-Profit Organisations","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Hospitals","Non-Profit Organisations","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-ea0ec805-9223-4fde-92b7-995568bb295f"],"src":["AU Aarhus University"],"title":"Assessing the pattern of recurrence in Danish stage I lung cancer patients in relation to the follow-up program : are we failing to identify patients with cerebral recurrence?","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-262915","year":"2018","yearsub":"2018"}
{"abstract":"The conditions in the edge and scrape-off layer (SOL) of magnetically confined plasmas determine the overall performance of the device, and it is of great importance to study and understand the mechanics that drive transport in those regions. If a significant amount of neutral molecules and atoms is present in the edge and SOL regions, those will influence the plasma parameters and thus the plasma confinement. In this paper, it is displayed how neutrals, described by a fluid model, introduce source terms in a plasma drift-fluid model due to inelastic collisions. The resulting source terms are included in a four-field drift fluid model, and it is shown how an increasing neutral particle density in the edge and SOL regions influences the plasma particle transport across the lastclosed-flux-surface. It is found that an appropriate gas puffing rate allows for the edge density in the simulation to be self-consistently maintained due to ionization of neutrals in the confined region.","author_count":6,"contributors":["Thrysøe, Alexander Simon","Magnussen, Michael Løiten","Madsen, Jacob","Naulin, Volker","Nielsen, Anders Henry","Rasmussen, Jens Juul"],"cuid":["S01-000.00-379708"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Thrysøe, Alexander Simon"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"plasma particle sources due to interactions with neutrals in a turbulent scrape off layer of a toroidally confined plasma","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/145891504/1.5019662.pdf","version":"Published Version"},"id":"S01-000.00-379708","identifier":[{"id":"85044184490","type":"scopus"}],"ids":["dtu-fb11d3fc-5b16-4574-96af-e0ce51fa89da"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-3A3E395B0CBBA37CCC7A3505F03E4E14"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/146183584/pdf_archivePHPAENvol_25iss_3032307_1_am.pdf","version":"Authors Final Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/145891504/1.5019662.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Physics","Technical University of Denmark, Department of Physics, Plasma Physics and Fusion Energy"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Alexander Simon","key":"thrysøepau","last":"Thrysøe","locid":"39b78f9b-adc1-4e59-9d7c-7072f09a73bc","name":"Thrysøe, Alexander Simon","orcid":"0000-0002-7761-5156","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"M.","key":"løitenpau","last":"Løiten","locid":"f8bc7853-fa1f-4fc4-b01d-f41fd475ab71","name":"Magnussen, Michael Løiten","name_org":"Løiten, M.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"J.","key":"madsenpau","last":"Madsen","locid":"68884645-e54a-4318-b8fa-a0779d38c5ba","name":"Madsen, Jacob","name_org":"Madsen, J.","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Volker","key":"naulinpau","last":"Naulin","locid":"68cb67c0-c64d-4fef-a301-67ab58d8ace6","name":"Naulin, Volker","orcid":"0000-0001-5452-9215","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"A. H.","key":"nielsenpau","last":"Nielsen","locid":"1d9aa958-9d84-4a3b-8300-f6fe9b0be73e","name":"Nielsen, Anders Henry","name_org":"Nielsen, A. H.","orcid":"0000-0003-3642-3905","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"J. Juul","key":"rasmussenpau","last":"Rasmussen","locid":"125b9658-f84c-4e0e-859e-5899413288ee","name":"Rasmussen, Jens Juul","name_org":"Rasmussen, J. Juul","orcid":"0000-0002-3543-690X","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1063/1.5019662","issn":["1070664X","10897674"],"issn_org":["1070664X"],"issue":"3","journal":"Physics of Plasmas","paperid":"032307","publisher":"American Institute of Physics","status":"p","title":"Physics of Plasmas","volume":"25"},"review":"Peer Reviewed","scoID":["2-s2.0-85044184490"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-fb11d3fc-5b16-4574-96af-e0ce51fa89da"],"src":["DTU Technical University of Denmark"],"title":"Plasma particle sources due to interactions with neutrals in a turbulent scrape-off layer of a toroidally confined plasma","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-379708","year":"2018","yearsub":"2018"}
{"author_count":3,"contributors":["Barnwell, Jeppe Lindquist","Nielsen, Jesper G.","Rasmussen, Anders Juhl"],"cuid":["S01-000.00-408964"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"bipersonerne peter seebergs romaner noveller og kortprosa","src":["ku"],"src-code":["DI-U-KU"],"type":"db","type-grp":["all","pub"]},"id":"S01-000.00-408964","ids":["ku-19fdeddb-3c61-43ad-8f92-3253aa4cfa20"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-CBCAFBFA3C469C79467D9BC0AE938A63"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Humanities, Department of Nordic Studies and Linguistics"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Jeppe Lindquist","key":"barnwellped","last":"Barnwell","locid":"50916516-bf5a-460e-94b1-77cf4f11c535","name":"Barnwell, Jeppe Lindquist","orcid":"0009-0001-8395-1818","rank":1,"role":"Editor","rolecode":"ped"},{"affno":"","first":"Jesper G.","key":"nielsenped","last":"Nielsen","name":"Nielsen, Jesper G.","rank":2,"role":"Editor","rolecode":"ped"},{"affno":"","first":"Anders Juhl","key":"rasmussenped","last":"Rasmussen","locid":"3e1188ff-4cc9-42e2-86b3-59515e62f1af","name":"Rasmussen, Anders Juhl","rank":3,"role":"Editor","rolecode":"ped"}],"pub":{"isbn":["9788702275667"],"pages":"299","place":"København","publisher":"Gyldendal","status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-19fdeddb-3c61-43ad-8f92-3253aa4cfa20"],"src":["KU University of Copenhagen"],"title":"Bipersonerne : Peter Seebergs romaner, noveller og kortprosa","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-408964","year":"2018","yearsub":"2019"}
{"abstract":"OBJECTIVE: Gonadotropins (luteinizing hormone (LH) and follicle-stimulating hormone (FSH)) are released from the pituitary gland and stimulate Leydig cells to produce testosterone and initiates spermatogenesis. Little is known about how and when the deterioration of semen quality occurs in patients with adult-onset gonadotropin insufficiency. DESIGN AND METHODS: A retrospective study comprising 20 testosterone-deficient men (median age, 29 years) with acquired pituitary disease who delivered semen for cryopreservation before initiation of testosterone therapy. Semen variables and hormone concentrations were compared to those of young healthy men (n = 340). RESULTS: Thirteen of 20 patients (65%) and 82% of controls had total sperm counts above 39 million and progressive motile spermatozoa above 32% (P = 0.05). For the individual semen variables, there were no significant differences in semen volume (median (intraquartile range) 3.0 (1.3-6.8) vs 3.2 (2.3-4.3) mL, P = 0.47), sperm concentration 41 (11-71) vs 43 (22-73) mill/mL (P = 0.56) or total sperm counts (P = 0.66). One patient had azoospermia. Patients vs controls had lower serum testosterone 5.4 (2.2-7.6) vs 19.7 (15.5-24.5) nmol/L (P = 0.001), calculated free testosterone (cfT) 145 (56-183) vs 464 (359-574) pmol/L (P < 0.001), LH 1.5 (1.1-2.1) vs 3.1 (2.3-4.0) U/L (P = 0.002) and inhibin b (P < 0.001). Levels of FSH were similar (P = 0.63). Testosterone/LH ratio and cfT/LH ratio were reduced in patients (both P < 0.001). CONCLUSIONS: Despite Leydig cell insufficiency in patients with acquired pituitary insufficiency, the majority presented with normal semen quality based on the determination of the number of progressively motile spermatozoa. In addition, the data suggest reduced LH bioactivity in patients with pituitary insufficiency.","author_count":4,"contributors":["Andreassen, Mikkel","Juul, Anders","Feldt-Rasmussen, Ulla","Jørgensen, Niels"],"cuid":["S01-000.00-413489"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"semen quality in patients with pituitary disease and adult onset hypogonadotropic hypogonadism","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1530/EC-18-0061","version":"Published Version"},"id":"S01-000.00-413489","identifier":[{"id":"85046424732","type":"scopus"},{"id":"29514896","type":"pmid"},{"id":"PMC5881434","type":"pmcid"}],"ids":["ku-218c5e85-f060-4df4-8ebf-0c40400d07ae"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-D9B57D6D9627CF3D566C976CE652113E"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1530/EC-18-0061","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://curis.ku.dk/ws/files/213962888/_20493614_Endocrine_Connections_Semen_quality_in_patients_with_pituitary_disease_and_adult_onset_hypogonadotropic_hypogonadism.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal Medicine: Endocrinology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Mikkel","key":"andreassenpau","last":"Andreassen","locid":"0a753366-9e9d-491d-85cc-cce24dd37af9","name":"Andreassen, Mikkel","rank":1,"rolecode":"pau"},{"affno":"1","first":"Anders","key":"juulpau","last":"Juul","locid":"f9b11983-c7c8-4111-b119-4de471572898","name":"Juul, Anders","orcid":"0000-0002-0534-4350","rank":2,"rolecode":"pau"},{"affno":"1","first":"Ulla","key":"feldtrasmussenpau","last":"Feldt-Rasmussen","locid":"b5898535-d448-4e2f-9f41-d5199873676b","name":"Feldt-Rasmussen, Ulla","rank":3,"rolecode":"pau"},{"affno":"1","first":"Niels","key":"jørgensenpau","last":"Jørgensen","locid":"c71c4fea-d27c-46d3-af5a-7f12196efb45","name":"Jørgensen, Niels","rank":4,"rolecode":"pau"}],"pmid":["29514896"],"pub":{"doi":"10.1530/ec-18-0061","issn":["20493614"],"issue":"4","journal":"Endocrine Connections","pages":"523-533","status":"p","title":"Endocrine Connections","volume":"7"},"review":"Peer Reviewed","scoID":["2-s2.0-85046424732"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-218c5e85-f060-4df4-8ebf-0c40400d07ae"],"src":["KU University of Copenhagen"],"title":"Semen quality in patients with pituitary disease and adult-onset hypogonadotropic hypogonadism","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-413489","year":"2018","yearsub":"2018"}
{"abstract":"Objective: Using an ad libitum buffet meal targeting direct behavior, the authors of the current study previously reported no effect of Roux-en-Y gastric bypass (RYGB) and sleeve gastrectomy (SG) surgery on food preferences 6 months after surgery. The current study investigated changes in food preferences at 18 months after surgery and whether changes in food preferences at 6 months predicted weight loss. Methods: Twenty food items separated into the following food categories were served at the buffet meal: high-fat, low-fat, sweet, savory, high-fat savory, high-fat sweet, low-fat savory, and low-fat sweet. Energy intake and intake from each of the food items were registered. Energy intake prior to the meal was standardized. Results: Thirty-nine subjects completed visits before surgery and 18 months following RYGB (n = 29) and SG (n = 10) surgery. Energy intake decreased 41% (4,470 ± 209 kJ vs. 2,618 ± 209 kJ, P < 0.001), but no change occurred in relative energy intake from any of the food categories (all P ≥ 0.23), energy density (P = 0.20), or macronutrient intake (all P ≥ 0.28). However, changes in high-fat food intake, protein intake, energy intake, and energy density at 6 months predicted weight loss at 18 months (P ≤ 0.02). Coclusions: RYGB surgery and SG surgery do not affect food preferences. However, changes in food preferences seem to be predictive of weight loss.","author_count":7,"contributors":["Nielsen, Mette Søndergaard","Rasmussen, Simone","Christensen, Bodil Just","Ritz, Christian","le Roux, Carel W","Schmidt, Julie Berg","Sjödin, Anders Mikael"],"cuid":["S01-000.00-426086"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","OECD"],"country":["Ireland","United Kingdom"],"glorg":["All Global Affiliations","Imperial College London","University College Dublin"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-SDR","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"bariatric surgery does not affect food preferences but individual changes in food preferences may predict weight loss","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-426086","identifier":[{"id":"85056422574","type":"scopus"},{"id":"30421858","type":"pmid"}],"ids":["ku-36e7da7b-eee3-4a73-9434-4a4ab2797a0b"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-7978F517754B0D6BC19CA0D060474B60"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Nutrition, Exercise and Sports, Obesity Research"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","used":1},{"affno":"3","country":"ie","key":"university college dublin","loc":["Ireland","Europe, EU","OECD"],"name":"University College Dublin","used":1},{"affno":"4","country":"gb","key":"imperial college london","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Imperial College London","used":1}],"person":[{"affno":"1 2","first":"Mette Søndergaard","key":"nielsenpau","last":"Nielsen","locid":"080ae329-1cd1-45c3-8531-7bfe74879f0b","name":"Nielsen, Mette Søndergaard","orcid":"0000-