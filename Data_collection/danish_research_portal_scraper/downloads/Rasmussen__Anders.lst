rst":"Filip Krag","key":"knoppau","last":"Knop","locid":"ce6eaad9-59f8-4ecf-8a1e-388a74734f6a","name":"Knop, Filip K.","name_org":"Knop, Filip Krag","rank":9,"rolecode":"pau"},{"affno":"1","first":"Arne","key":"astruppau","last":"Astrup","locid":"5d943631-c9fc-4b63-8aaa-263ba4248735","name":"Astrup, Arne","orcid":"0000-0001-8968-8996","rank":10,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Marianne Uggen","key":"rasmussenpau","last":"Rasmussen","locid":"8a268c3a-0ff3-4ed9-a6c4-0d18a8e540e2","name":"Rasmussen, Marianne Uggen","rank":11,"rolecode":"pau"},{"affno":"","first":"Cecilie Rodgaard","key":"bartholdypau","last":"Bartholdy","name":"Bartholdy, Cecilie Rodgaard","rank":12,"rolecode":"pau"},{"affno":"","first":"Cecilie","key":"daugaardpau","last":"Daugaard","name":"Daugaard, Cecilie","rank":13,"rolecode":"pau"},{"affno":"","first":"Else Marie","key":"bartelspau","last":"Bartels","name":"Bartels, Else Marie","rank":14,"rolecode":"pau"},{"affno":"","first":"Karen","key":"ellegaardpau","last":"Ellegaard","name":"Ellegaard, Karen","rank":15,"rolecode":"pau"},{"affno":"1 2","first":"Berit Lilienthal","key":"heitmannpau","last":"Heitmann","locid":"b644e477-0a57-40f2-b0a7-71e52f624356","name":"Heitmann, Berit Lilienthal","orcid":"0000-0002-6809-4504","rank":16,"rolecode":"pau"},{"affno":"1","first":"Lars Erik","key":"kristensenpau","last":"Kristensen","locid":"abb37858-fdb4-4151-a6d2-8b0d5b81141c","name":"Kristensen, Lars Erik","rank":17,"rolecode":"pau"}],"pub":{"doi":"10.1136/annrheumdis-2019-eular.1375","issn":["00034967","14682060"],"issn_org":["00034967"],"issue":"Suppl. 2","journal":"Annals of the Rheumatic Diseases","pages":"71-72","publisher":"Elsevier","status":"p","title":"Annals of the Rheumatic Diseases","volume":"78"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-3b151ace-0391-41d7-92a5-b3b01e1ac516","sdu-1091eecd-bea7-46c1-9ae0-9c70d675e607"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"EFFECT OF LIRAGLUTIDE ON BODY WEIGHT AND PAIN IN THE TREATMENT OF OVERWEIGHT AND KNEE OSTEOARTHRITIS: A RANDOMISED, DOUBLE-BLIND, PLACEBO-CONTROLLED STUDY","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-090.48-041623","year":"2019","yearsub":"2019"}
{"abstract":"Objectives: Electrocardiographic bundle branch block (BBB) is common but the prognostic implications in primary care are unclear. We sought to investigate the relationship between electrocardiographic BBB subtypes and the risk of cardiovascular (CV) outcomes in a primary care population free of major CV disease. Methods: Retrospective cohort study of primary care patients referred for electrocardiogram (ECG) recording between 2001 and 2011. Cox regression models were used to estimate hazard ratios (HR) as well as absolute risks of CV outcomes based on various BBB subtypes. Results: We included 202 268 individuals with a median follow-up period of 7.8 years (Inter-quartile range [IQR] 4.9-10.6). Left bundle branch block (LBBB) was associated with heart failure (HF) in both men (HR 3.96, 95% CI 3.30 to 4.76) and women (HR 2.51, 95% CI 2.15 to 2.94) and with CV death in men (HR 1.80, 95% CI 1.38 to 2.35). Right bundle branch block (RBBB) was associated with pacemaker implantation in both men (HR 3.26, 95% CI 2.74 to 3.89) and women (HR 3.69, 95% CI 2.91 to 4.67), HF in both sexes and weakly associated with CV death in men. Regarding LBBB, we found an increasing hazard of HF with increasing QRS-interval duration (HR 1.25, 95% CI 1.11 to 1.42 per 10 ms increase in men and HR 1.23, 95% CI 1.08 to 1.40 per 10 ms increase in women). Absolute 10-year risk predictions across age-specific and sex-specific subgroups revealed clinically relevant differences between having various BBB subtypes. Conclusions: Opportunistic findings of BBB subtypes in primary care patients without major CV disease should be considered warnings of future HF and pacemaker implantation.","author_count":16,"contributors":["Rasmussen, Peter Vibe","Skov, Morten Wagner","Ghouse, Jonas","Pietersen, Adrian","Hansen, Steen Møller","Torp-Pedersen, Christian","Køber, Lars","Haunsø, Stig","Olesen, Morten Salling","Svendsen, Jesper Hastrup","Melgaard, Jacob","Graff, Claus","Holst, Anders Gaardsdal","Nielsen, Jonas Bille"],"cuid":["S02-096.66-005329"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"keyword":["Electrocardiography","Heart failure","Pacemakers","cardiac risk factors and prevention"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-NOVO"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU"]},"level3all":["DI-PR-NOVO","DI-U-AAU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"clinical implications of electrocardiographic bundle branch block in primary care","src":["aau","ku"],"src-code":["DI-U-AAU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85066884739&partnerID=8YFLogxK","version":"Other Version"},"id":"S02-096.66-005329","identifier":[{"id":"31129608","type":"pmid"},{"id":"85066884739","type":"scopus"},{"id":"000477896100008","type":"wos"}],"ids":["aau-6de4704a-bf3f-4f4e-9c5a-46bf7ccce75c","ku-26b0ff3e-d78d-451f-abbf-e469099c7595"],"keyword":["cardiac risk factors and prevention","electrocardiography","heart failure","pacemakers"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-6EB051297C7AE46C66A3BBA2FA590277"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Forskning, Uddannelse og Innovation","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Unit of Epidemiology and Biostatistics"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal medicine: Cardiology"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"dk","key":"novo nordisk","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-NOVO","l3nl":"Novo Nordisk","l3nn":"Novo Nordisk","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Novo Nordisk","namevar":["Novo Nordisk"],"nora_code":"DI-PR-NOVO","used":1}],"person":[{"affno":"","corresponding":null,"first":"Peter Vibe","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Peter Vibe","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Morten Wagner","key":"skovpau","last":"Skov","name":"Skov, Morten Wagner","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jonas","key":"ghousepau","last":"Ghouse","name":"Ghouse, Jonas","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Adrian","key":"pietersenpau","last":"Pietersen","name":"Pietersen, Adrian","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Steen Møller","key":"hansenpau","last":"Hansen","locid":"9215b2eb-a8ac-4397-bf06-5696e108f951","name":"Hansen, Steen Møller","orcid":"0000-0002-9421-774X","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Christian","key":"torppedersenpau","last":"Torp-Pedersen","locid":"5417d806-0578-4505-b3fe-68ae0359913e","name":"Torp-Pedersen, Christian","rank":6,"rolecode":"pau"},{"affno":"2","first":"Lars","key":"koberpau","last":"Kober","locid":"e3f0c57c-605a-431a-9c63-2213c46621e6","name":"Køber, Lars","name_org":"Kober, Lars","rank":7,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Lars","key":"køberpau","last":"Køber","name":"Køber, Lars","rank":7,"rolecode":"pau"},{"affno":"2","first":"Stig","key":"haunsopau","last":"Haunso","locid":"2d7a08cf-874a-4f9e-8964-e9c473cecd38","name":"Haunsø, Stig","name_org":"Haunso, Stig","rank":8,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Stig","key":"haunsøpau","last":"Haunsø","name":"Haunsø, Stig","rank":8,"rolecode":"pau"},{"affno":"2","first":"Morten Salling","key":"olesenpau","last":"Olesen","locid":"60e76597-44c1-4838-bb63-9b8568adb06f","name":"Olesen, Morten S","name_org":"Olesen, Morten Salling","rank":9,"rolecode":"pau"},{"affno":"2","first":"Jesper Hastrup","key":"svendsenpau","last":"Svendsen","locid":"d80910cf-2f9c-457c-9e85-34b4b258bb81","name":"Svendsen, Jesper Hastrup","orcid":"0000-0001-8466-8515","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jacob","key":"melgaardpau","last":"Melgaard","locid":"ea0887c2-504c-4f99-811e-86c8b00dccbb","name":"Melgaard, Jacob","orcid":"0000-0002-4192-6358","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Claus","key":"graffpau","last":"Graff","locid":"2312aabc-cecb-4598-aede-4aa22cc2f298","name":"Graff, Claus","orcid":"0000-0001-9650-9781","rank":12,"rolecode":"pau"},{"affno":"3","first":"Anders Gaardsdal","key":"holstpau","last":"Holst","name":"Holst, Anders Gaardsdal","rank":13,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jonas Bille","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Jonas Bille","rank":14,"rolecode":"pau"}],"pmid":["31129608"],"pub":{"doi":"10.1136/heartjnl-2018-314295","issn":["13556037","1468201X"],"issn_org":["13556037"],"issue":"15","journal":"Heart","pages":"1160-1167","publisher":"BMJ Publishing Group","status":"p","title":"Heart","volume":"105"},"review":"Peer Reviewed","scoID":["2-s2.0-85066884739"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Novo Nordisk","Private Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-6de4704a-bf3f-4f4e-9c5a-46bf7ccce75c","ku-26b0ff3e-d78d-451f-abbf-e469099c7595"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"Clinical implications of electrocardiographic bundle branch block in primary care","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-096.66-005329","year":"2019","yearsub":"2019"}
{"abstract":"Purpose of Review: Bicycling as a mode of transportation can be an easy and inexpensive way of integrating health enhancing physical activity into everyday life. In the present paper, we summarize the evidence from studies on bicycling for transportation and recreation in relation to cardiovascular disease prevention. We also estimate the population impact of increasing bicycling as a mode of transportation. Recent Findings: The overall evidence from prospective cohort studies supports that bicycling for transportation or recreation is related to lower risk of development of fatal or non-fatal cardiovascular disease and premature mortality. The decreased risk of cardiovascular disease and all-cause mortality from regular bicycling is estimated to outweigh risk from additional exposure to air pollution during outdoor exercise. Also, based on experimental studies on the effect of bicycling to school or work, we report an average increase (summary effect) on cardiorespiratory fitness of 3.56 ml O2/min/kg (95% CI 2.79 to 4.32) compared with control. Extrapolating the size of this average difference, approximately equivalent to 1 MET, then a right shift in the fitness distribution among adults in the general population would lead to substantial reductions in cases of fatal and non-fatal cardiovascular disease and type 2 diabetes. Furthermore, we estimate a significant impact on cardiovascular mortality under plausible public health intervention scenarios increasing the percentage of the population bicycling to work. Summary: Bicycling remains an underutilized alternative to motorized transport in most countries, and promoting bicycling could be a viable approach in primordial and primary prevention of cardiovascular diseases.","author_count":6,"contributors":["Grøntved, Anders","Rasmussen, Martin Gillies","Blond, Kim","Østergaard, Lars","Andersen, Zorana Jovanovic","Møller, Niels Christian"],"cuid":["S02-100.00-041717"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Grøntved, Anders"],"keyword":["Bicycling","Cardiovascular","Commuting","Mortality","Physical activity","Prevention"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-ZEA"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-ZEA","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"bicycling for transportation and recreation in cardiovascular disease prevention","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85069000444","version":"Other Version"},"id":"S02-100.00-041717","identifier":[{"id":"000475602300002","type":"wos"},{"id":"85069000444","type":"scopus"}],"ids":["ku-3decbf15-89d5-43ca-97ec-2832cd1890bb","sdu-d39545ba-2b13-4aeb-8c7e-d6929427ecf8"],"keyword":["Bicycling","Cardiovascular","Commuting","Mortality","Physical activity","Prevention"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-ED63E09FC67BFB85B6F1240D231730D4"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics, RICH - Research In Childhood Health","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics, Research Unit of Exercise Epidemiology"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Bispebjerg and Frederiksberg Hospitals"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Section of Environmental Health"],"nora_code":"DI-U-KU","used":1},{"affno":"4","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Copenhagen University Hospital – Nykøbing F,"],"nora_code":"DI-HO-ZEA","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anders","key":"grøntvedpau","last":"Grøntved","locid":"393b1ca1-e658-437c-9ca3-73aea925ad58","name":"Grøntved, Anders","orcid":"0000-0003-1584-679X","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Martin Gillies","key":"rasmussenpau","last":"Rasmussen","locid":"8b86a1ef-e6c1-4de3-8300-e30d144bbf60","name":"Rasmussen, Martin Gillies Banke","name_org":"Rasmussen, Martin Gillies","orcid":"0000-0002-2114-2185","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kim","key":"blondpau","last":"Blond","name":"Blond, Kim","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars","key":"østergaardpau","last":"Østergaard","locid":"d5b18fd7-3521-4ec9-8043-98bc727031e7","name":"Østergaard, Lars","rank":4,"rolecode":"pau"},{"affno":"3 4","first":"Zorana Jovanovic","key":"andersenpau","last":"Andersen","locid":"8bffc514-d71e-40ba-b979-910dfb03ec5e","name":"Andersen, Zorana Jovanovic","orcid":"0000-0003-4138-9828","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Niels Christian","key":"møllerpau","last":"Møller","locid":"f453a8f3-668c-40a5-bcf2-d05243a89418","name":"Møller, Niels Christian","orcid":"0000-0001-5842-5595","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1007/s12170-019-0623-z","issn":["19329520","19329563"],"issn_org":["19329520"],"issue":"9","journal":"Current Cardiovascular Risk Reports","paperid":"26","publisher":"Current Medicine Group","status":"p","title":"Current Cardiovascular Risk Reports","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-85069000444"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region Zealand","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-3decbf15-89d5-43ca-97ec-2832cd1890bb","sdu-d39545ba-2b13-4aeb-8c7e-d6929427ecf8"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Bicycling for Transportation and Recreation in Cardiovascular Disease Prevention","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-041717","year":"2019","yearsub":"2019"}
{"abstract":"BACKGROUND: The mainstay treatment for hypoxaemia is oxygen therapy, which is given to the vast majority of adults admitted to the intensive care unit (ICU). The practice of oxygen administration has been liberal, which may result in hyperoxaemia. Some studies have indicated an association between hyperoxaemia and mortality, whilst other studies have not. The ideal target for supplemental oxygen for adults admitted to the ICU is uncertain. Despite a lack of robust evidence of effectiveness, oxygen administration is widely recommended in international clinical practice guidelines. The potential benefit of supplemental oxygen must be weighed against the potentially harmful effects of hyperoxaemia. OBJECTIVES: To assess the benefits and harms of higher versus lower fraction of inspired oxygen or targets of arterial oxygenation for adults admitted to the ICU. SEARCH METHODS: We identified trials through electronic searches of CENTRAL, MEDLINE, Embase, Science Citation Index Expanded, BIOSIS Previews, CINAHL, and LILACS. We searched for ongoing or unpublished trials in clinical trials registers. We also scanned the reference lists of included studies. We ran the searches in December 2018. SELECTION CRITERIA: We included randomized controlled trials (RCTs) that compared higher versus lower fraction of inspired oxygen or targets of arterial oxygenation for adults admitted to the ICU. We included trials irrespective of publication type, publication status, and language. We included trials with a difference between the intervention and control groups of a minimum 1 kPa in partial pressure of arterial oxygen (PaO2), minimum 10% in fraction of inspired oxygen (FiO2), or minimum 2% in arterial oxygen saturation of haemoglobin/non-invasive peripheral oxygen saturation (SaO2/SpO2). We excluded trials randomizing participants to hypoxaemia (FiO2 below 0.21, SaO2/SpO2 below 80%, and PaO2 below 6 kPa) and to hyperbaric oxygen. DATA COLLECTION AND ANALYSIS: Three review authors independently, and in pairs, screened the references retrieved in the literature searches and extracted data. Our primary outcomes were all-cause mortality, the proportion of participants with one or more serious adverse events, and quality of life. None of the trials reported the proportion of participants with one or more serious adverse events according to the International Conference on Harmonisation Good Clinical Practice (ICH-GCP) criteria. Nonetheless, most trials reported several serious adverse events. We therefore included an analysis of the effect of higher versus lower fraction of inspired oxygen, or targets using the highest reported proportion of participants with a serious adverse event in each trial. Our secondary outcomes were lung injury, acute myocardial infarction, stroke, and sepsis. None of the trials reported on lung injury as a composite outcome, however some trials reported on acute respiratory distress syndrome (ARDS) and pneumonia. We included an analysis of the effect of higher versus lower fraction of inspired oxygen or targets using the highest reported proportion of participants with ARDS or pneumonia in each trial. To assess the risk of systematic errors, we evaluated the risk of bias of the included trials. We used GRADE to assess the overall certainty of the evidence. MAIN RESULTS: We included 10 RCTs (1458 participants), seven of which reported relevant outcomes for this review (1285 participants). All included trials had an overall high risk of bias, whilst two trials had a low risk of bias for all domains except blinding of participants and personnel. Meta-analysis indicated harm from higher fraction of inspired oxygen or targets as compared with lower fraction or targets of arterial oxygenation regarding mortality at the time point closest to three months (risk ratio (RR) 1.18, 95% confidence interval (CI) 1.01 to 1.37; I2 = 0%; 4 trials; 1135 participants; very low-certainty evidence). Meta-analysis indicated harm from higher fraction of inspired oxygen or targets as compared with lower fraction or targets of arterial oxygenation regarding serious adverse events at the time point closest to three months (estimated highest proportion of specific serious adverse events in each trial RR 1.13, 95% CI 1.04 to 1.23; I2 = 0%; 1234 participants; 6 trials; very low-certainty evidence). These findings should be interpreted with caution given that they are based on very low-certainty evidence. None of the included trials reported any data on quality of life at any time point. Meta-analysis indicated no evidence of a difference between higher fraction of inspired oxygen or targets as compared with lower fraction or targets of arterial oxygenation on lung injury at the time point closest to three months (estimated highest reported proportion of lung injury RR 1.03, 95% CI 0.78 to 1.36; I2 = 0%; 1167 participants; 5 trials; very low-certainty evidence). None of the included trials reported any data on acute myocardial infarction or stroke, and only one trial reported data on the effects on sepsis. AUTHORS' CONCLUSIONS: We are very uncertain about the effects of higher versus lower fraction of inspired oxygen or targets of arterial oxygenation for adults admitted to the ICU on all-cause mortality, serious adverse events, and lung injuries at the time point closest to three months due to very low-certainty evidence. Our results indicate that oxygen supplementation with higher versus lower fractions or oxygenation targets may increase mortality. None of the trials reported the proportion of participants with one or more serious adverse events according to the ICH-GCP criteria, however we found that the trials reported an increase in the number of serious adverse events with higher fractions or oxygenation targets. The effects on quality of life, acute myocardial infarction, stroke, and sepsis are unknown due to insufficient data.","author_count":9,"contributors":["Barbateskovic, Marija","Schjørring, Olav Lilleholt","Russo Krauss, Sara","Jakobsen, Janus C","Meyhoff, Christian S","Dahl, Rikke M","Rasmussen, Bodil Steen","Perner, Anders","Wetterslev, Jørn"],"cuid":["S03-097.73-665762"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"corresponding_author":["Barbateskovic, Marija"],"keyword":["Humans","Intensive Care Units statistics numerical data","Intubation adverse effects","Oxygen Inhalation Therapy adverse effects","Pneumonia therapy","Randomized Controlled Trials as Topic"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-NDR","DI-HO-ZEA"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-NDR","DI-HO-ZEA","DI-U-AAU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"higher versus lower fraction of inspired oxygen or targets of arterial oxygenation for adults admitted to the intensive care unit","src":["aau","ku","sdu"],"src-code":["DI-U-AAU","DI-U-KU","DI-U-SDU"],"type":"djr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/161060488/Barbateskovic_et_al_2019_Cochrane_Database_of_Systematic_Reviews.pdf","version":"Published Version"},"id":"S03-097.73-665762","identifier":[{"id":"PMC6880382","type":"pmcid"},{"id":"31773728","type":"pmid"},{"id":"85075715882","type":"scopus"}],"ids":["aau-3a4d5127-5a9e-4b29-851e-cfd5f32a5658","ku-c77e24ec-84df-4d03-92bd-127c25621ed8","sdu-f7eed0fc-07b2-40a5-a87d-6b0a2f226c38"],"keyword":["Humans","Intensive Care Units/statistics & numerical data","Intubation/adverse effects","Oxygen Inhalation Therapy/adverse effects","Pneumonia/therapy","Randomized Controlled Trials as Topic","Respiratory Distress Syndrome, Adult/therapy"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-3-9-7463B201648592FDA472F1753