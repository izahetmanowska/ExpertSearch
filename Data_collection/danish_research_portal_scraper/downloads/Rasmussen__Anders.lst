":"1","corresponding":null,"first":"Mai","key":"stenbjergmaipau","last":"Stenbjerg","name":"Stenbjerg, Mai","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Anders Emil","key":"rasmussenandersemilpau","last":"Rasmussen","name":"Rasmussen, Anders Emil","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"John","key":"lundjohnpau","last":"Lund","locid":"804841b2-a380-4c22-981b-713fefc95362","name":"Lund, John","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Martin","key":"petersenmartinpau","last":"Petersen","locid":"54a9cf35-3f97-4623-9ae0-6b1f2ecfa1d2","name":"Petersen, Martin","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Thomas Randrup","key":"petersenthomasrandruppau","last":"Petersen","name":"Petersen, Thomas Randrup","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Stine","key":"schierupstinepau","last":"Schierup","locid":"beae1cc3-bc1b-4b76-b30d-df19f1523dc1","name":"Schierup, Stine","rank":6,"rolecode":"pau"},{"affno":"","first":"Kristian","key":"jensenkristianpedh","last":"Jensen","name":"Jensen, Kristian","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"edition":"1","isbn":["9788793251588"],"place":"Højbjerg","publisher":"Moesgård Museum","status":"p","title":"Kriger"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Miscellaneous","DI-ALL","DI-GV","DI-GV-ALL","DI-OT","DI-OT-ALL","Governmental Institutions","Miscellaneous","Other Research"],"PST":["Published"]},"sid":["kum-88d86456-cf57-41c0-ad54-f76f5e5cfaf9"],"src":["KUM Ministry of Culture - Archives, Museums, and Royal Library Denmark"],"title":"Kriger","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-801104","year":"2024","yearsub":"2024"}
{"abstract":"The aim of this Intensive Care Medicine Rapid Practice Guideline (ICM-RPG) was to provide evidence-based clinical guidance about the use of higher versus lower oxygenation targets for adult patients in the intensive care unit (ICU). The guideline panel comprised 27 international panelists, including content experts, ICU clinicians, methodologists, and patient representatives. We adhered to the methodology for trustworthy clinical practice guidelines, including the use of the Grading of Recommendations Assessment, Development, and Evaluation approach to assess the certainty of evidence, and used the Evidence-to-Decision framework to generate recommendations. A recently published updated systematic review and meta-analysis constituted the evidence base. Through teleconferences and web-based discussions, the panel provided input on the balance and magnitude of the desirable and undesirable effects, the certainty of evidence, patients' values and preferences, costs and resources, equity, feasibility, acceptability, and research priorities. The updated systematic review and meta-analysis included data from 17 randomized clinical trials with 10,248 participants. There was little to no difference between the use of higher versus lower oxygenation targets for all outcomes with available data, including all-cause mortality, serious adverse events, stroke, functional outcomes, cognition, and health-related quality of life (very low certainty of evidence). The panel felt that values and preferences, costs and resources, and equity favored the use of lower oxygenation targets. The ICM-RPG panel issued one conditional recommendation against the use of higher oxygenation targets: \"We suggest against the routine use of higher oxygenation targets in adult ICU patients (conditional recommendation, very low certainty of evidence). Remark: an oxygenation target of SpO2 88%-92% or PaO2 8 kPa/60 mmHg is relevant and safe for most adult ICU patients.\"","author_count":22,"contributors":["Møller, Morten Hylander","Granholm, Anders","Al Duhailib, Zainab","Alhazzani, Waleed","Belley-Cote, Emilie","Oczkowski, Simon","Vijayaraghavan, Bharath Kumar Tirupakuzhi","Sjövall, Fredrik","Butler, Ethan","Zampieri, Fernando G.","Mac Sweeney, Rob","Derde, Lennie P. G.","Ruzycki-Chadwick, Ally","Mer, Mervyn","Burns, Karen E. A.","Ergan, Begüm","Al-Fares, Abdulrahman","Sjoding, Michael W.","Valley, Thomas S.","Rasmussen, Bodil Steen","Schjørring, Olav Lilleholt","Prescott, Hallie C."],"cuid":["S02-081.33-724418"],"filters":{"added":"2024-03","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Africa","America, North","Asia, Middle East","Asia, South","Europe, EU","Europe, Non-EU","Nordic","OECD","Oceania"],"corresponding_author":["Møller, Morten Hylander"],"country":["Australia","Canada","India","Kuwait","Netherlands","Saudi Arabia","South Africa","Sweden","Turkey","United Kingdom","United States"],"glorg":["Al-Amiri Hospital","Alberta Health Services","Alfaisal University","All Global Affiliations","Apollo Hospitals","Apollo Hospitals Group","Charlotte Maxeke Johannesburg Academic Hospital","Department of Veterans Affairs","Dokuz Eylul University","GUIDE Group","Guidelines in Intensive Care Medicine, Development and Evaluation Group","Hamilton Health Sciences","King Faisal Specialist Hospital & Research Centre","King Faisal Specialist Hospital and Research Centre","King Saud University","Lund University","McMaster University","Ministry of Health, Kuwait","Population Health Research Institute","Royal North Shore Hospital","Royal Victoria Hospital","Royal Victoria Hospital Belfast","Skåne University Hospital","St. Joseph's Healthcare Hamilton","The George Institute for Global Health","Unity Health Toronto","University Medical Center Utrecht","University Medical Centre Utrecht","University of Alberta","University of Michigan, Ann Arbor","University of Sydney","University of Toronto","University of the Witwatersrand","Utrecht University","VA Center for Clinical Management Research"],"keyword":["Clinical practice guideline","ICM RPG","Intensive Care Medicine Rapid Practice Guideline","oxygenation target"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-AAU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"higher versus lower oxygenation targets in adult icu patients a rapid practice guideline","src":["aau","ku"],"src-code":["DI-U-AAU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85180730352&partnerID=8YFLogxK","version":"Other Version"},"funding_acknowledgement":["We are very grateful to the patient representatives Maria Høpner, Tine Piil Petersen, Michael Piil Petersen, and Kent Bering for being part of the guideline panel. We would also like to thank the first author of the Cochrane systematic review and meta-analysis for sharing data with us. This material is the result of work supported with resources and use of facilities at the Ann Arbor VA Medical Center. This manuscript does not represent the views of the Department of Veterans Affairs or the US Government. All co-authors declared their conflicts of interests (Supporting Information B)."],"id":"S02-081.33-724418","identifier":[{"id":"38140827","type":"pmid"},{"id":"85180730352","type":"scopus"}],"ids":["aau-fc01fdf7-b0fd-43d7-83b4-5e342577ef11","ku-7491a80a-88dc-4b97-b497-e196d7dc9ee0"],"keyword":["ICM-RPG","Intensive Care Medicine Rapid Practice Guideline","clinical practice guideline","oxygenation target"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-F3695FD5402D1BF85962873D7335AF75"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU",