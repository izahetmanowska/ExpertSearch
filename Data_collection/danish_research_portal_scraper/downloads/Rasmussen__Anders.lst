de":"pau"},{"affno":"1","first":"Christoffer","key":"clemmensenpau","last":"Clemmensen","locid":"cb6d6cab-88bf-4650-9bd9-7759c2dc0be6","name":"Clemmensen, Christoffer","orcid":"0000-0003-2456-9667","rank":22,"rolecode":"pau"}],"pmid":["38427737"],"pub":{"doi":"10.1126/sciadv.adg2636","issn":["23752548"],"issue":"9","journal":"Science Advances","paperid":"eadg2636","status":"p","title":"Science Advances","volume":"10"},"review":"Peer Reviewed","scoID":["2-s2.0-85186745286"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Gubra","Novo Nordisk","Private Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-dfce2447-cc09-4544-9a63-aa1a45df51a5"],"src":["KU University of Copenhagen"],"title":"Targeting postsynaptic glutamate receptor scaffolding proteins PSD-95 and PICK1 for obesity treatment","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-732628","year":"2024","yearsub":"2024"}
{"abstract":"Hypothalamic-pituitary-adrenal (HPA)-axis hyperactivity measured by the combined dexamethasone-CRH test (DEX-CRH test) has been found in patients with major depressive disorder (MDD), whereas hypoactivity has been found in patients with work-related stress. We aimed to investigate the DEX-CRH test as a biomarker to distinguish between MDD and work-related stress (exhaustion disorder - ED). We hypothesized that there would be lower cortisol and ACTH response in participants with ED compared to MDD and healthy controls (HC). Also, we explored if the cortisol response of those patients interacted with robust markers of oxidative stress. Thirty inpatients with MDD and 23 outpatients with ED were recruited. Plasma cortisol and ACTH were sampled during a DEX-CRH test. The main outcome measure, area under the curve (AUC) for cortisol and ACTH, was compa-red between MDD vs. ED participants and a historical HC group. Secondary markers of oxidative stress urinary 8-oxodG and 8-oxoGuo; quality of sleep and psychometrics were obtained. Cortisol concentrations were higher in MDD and ED participants compared to HC, and no differences in AUC cortisol and ACTH were found between ED vs. MDD. Compared to ED, MDD participants had higher stress symptom severity and a lower sense of well-being. No differences in oxidative stress markers or quality of sleep between the groups were found. The result indicates that the patients with ED, like patients with MDD, are non-suppressors in DEX-CRH test and not hypocortisolemic as suggested.","author_count":13,"contributors":["Rotvig, Ditte H.","Jorgensen, Anders","Jensen, Johan Høy","Hansen, Allan Rene","Eller, Nanna Hurwitz","Jonsson, Steffen H.","Knorr, Ulla","Klose, Marianne C.","Feldt-Rasmussen, Ulla","Menke, Andreas","Poulsen, Henrik Enghusen","Bauer, Jeanett","Jørgensen, Martin Balslev"],"cuid":["S01-000.00-748424"],"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","Ludwig Maximilian University of Munich","Medical Park Chiemseeblick","University of Würzburg"],"keyword":["Cortisol","HPA axis","Major depression","Oxidative stress","Work stress"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"can the dex crh test or markers of oxidative stress distinguish work related stress from major depressive disorder and normal controls","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1080/10253890.2024.2353781","version":"Published Version"},"id":"S01-000.00-748424","identifier":[{"id":"85194994141","type":"scopus"},{"id":"38823417","type":"pmid"}],"ids":["ku-7b448e90-b8f9-45d3-8f9b-0c4274a51703"],"keyword":["HPA axis","Work stress","cortisol","dexamethasone-CRH suppression test","major depression","oxidative stress"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-AE9E18CF4D809D095021E04186AB86EF"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1080/10253890.2024.2353781","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/394440613/Can_the_DEX_CRH_test_or_markers_of_oxidative_stress_distinguish_work_related_stress_from_major_depressive_disorder_and_normal_controls_.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Mental Health Services Glostrup"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Psychiatry"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"de","key":"ludwig maximilian university of munich","loc":["Germany","Europe, EU","OECD"],"name":"Ludwig Maximilian University of Munich","used":1},{"affno":"4","country":"de","key":"university of würzburg","loc":["Germany","Europe, EU","OECD"],"name":"University of Würzburg","used":1},{"affno":"5","country":"de","key":"medical park chiemseeblick","loc":["Germany","Europe, EU","OECD"],"name":"Medical Park Chiemseeblick","used":1}],"person":[{"affno":"1","first":"Ditte H.","key":"rotvigpau","last":"Rotvig","name":"Rotvig, Ditte H.","rank":1,"rolecode":"pau"},{"affno":"1 2","first":"Anders","key":"jorgensenpau","last":"Jorgensen","locid":"46015f76-041c-4177-aa3a-8bcfd13eda19","name":"Jorgensen, Anders","orcid":"0000-0001-6012-6965","rank":2,"rolecode":"pau"},{"affno":"1","first":"Johan Høy","key":"jensenpau","last":"Jensen","name":"Jensen, Johan Høy","rank":3,"rolecode":"pau"},{"affno":"1","first":"Allan Rene","key":"hansenpau","last":"Hansen","name":"Hansen, Allan Rene","rank":4,"rolecode":"pau"},{"affno":"1","first":"Nanna Hurwitz","key":"ellerpau","last":"Eller","name":"Eller, Nanna Hurwitz","rank":5,"rolecode":"pau"},{"affno":"1","first":"Steffen H.","key":"jonssonpau","last":"Jonsson","name":"Jonsson, Steffen H.","rank":6,"rolecode":"pau"},{"affno":"1 2","first":"Ulla","key":"knorrpau","last":"Knorr","locid":"2d26ad94-f204-40b3-8763-9445bf0071f6","name":"Knorr, Ulla","rank":7,"rolecode":"pau"},{"affno":"1","first":"Marianne C.","key":"klosepau","last":"Klose","name":"Klose, Marianne C.","rank":8,"rolecode":"pau"},{"affno":"1 2","first":"Ulla","key":"feldtrasmussenpau","last":"Feldt-Rasmussen","locid":"b5898535-d448-4e2f-9f41-d5199873676b","name":"Feldt-Rasmussen, Ulla","rank":9,"rolecode":"pau"},{"affno":"3 4 5","first":"Andreas","key":"menkepau","last":"Menke","name":"Menke, Andreas","rank":10,"rolecode":"pau"},{"affno":"1","first":"Henrik Enghusen","key":"poulsenpau","last":"Poulsen","name":"Poulsen, Henrik Enghusen","rank":11,"rolecode":"pau"},{"affno":"1","first":"Jeanett","key":"bauerpau","last":"Bauer","name":"Bauer, Jeanett","rank":12,"rolecode":"pau"},{"affno":"1 2","first":"Martin Balslev","key":"jørgensenpau","last":"Jørgensen","locid":"dfc70acd-d15d-44f9-891e-6a7646d1727d","name":"Jørgensen, Martin Balslev","rank":13,"rolecode":"pau"}],"pmid":["38823417"],"pub":{"doi":"10.1080/10253890.2024.2353781","issn":["10253890","16078888"],"issn_org":["10253890"],"issue":"1","journal":"Stress: The International Journal on the Biology of Stress","paperid":"2353781","status":"p","title":"Stress: The International Journal on the Biology of Stress","title_org":"Stress","volume":"27"},"review":"Peer Reviewed","scoID":["2-s2.0-85194994141"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-7b448e90-b8f9-45d3-8f9b-0c4274a51703"],"src":["KU University of Copenhagen"],"title":"Can the DEX/CRH test or markers of oxidative stress distinguish work-related stress from major depressive disorder and normal controls?","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-748424","year":"2024","yearsub":"2024"}
{"abstract":"Trauma is notoriously difficult to communicate, as it often defies understanding. It unfolds over time and cannot be told through linear narratives. Nevertheless, we show that narratives can become a medium through which experiences of trauma may be shared, alleviating the sense of alienation common to post-traumatic experience. Drawing from one of the authors’ lived experiences of cancer and her illness narrative, we focus on the question of whether traumatic events can be narrated, known, and shared. In conversation with one another, and building on phenomenological literature on trauma (Husserl, 1973, Walther, 1923), illness (Carel, 2021, 2016), and working with an autoethnographic approach to cancer (Pini, 2022; Pini and Maguire-Rosier, 2021; Pini and Pini, 2019) in this chapter we address the ways in which creative and expressive illness narratives—particularly the sharing of such experiences—can help patients heal or repair from trauma. We identify the moment of the cancer diagnosis as a traumatic event, as it constitutes the expulsion of the individual into an alienworld: the world of the sick. We demonstrate how a philosophical account of unification (Walther 1923) may help shed light on the complexities of traumatic experience and highlight the potential of embodied narratives to re-establish a sense of belonging through sharing trauma experiences. We present a case in which performance art serves not only as an act of creatively re-modelling the performer’s illness narrative, but as a means to communicate this experience. Sharing the experience of trauma and recovery contributes to a re-constitution of a sense of belonging. We highlight that the (re-)constitution of feelings of belonging is a dyadic process between the traumatized individual and others. An illness narrative needs to be heard, seen, or otherwise witnessed in order to fulfil its full healing potential. In this way, we hope to contribute to a better understanding of how a narrative approach can be fruitfully applied in clinical practice.","author_count":4,"contributors":["Pini, Sarah","Wilde, Lilian"],"cuid":["S01-000.00-750931"],"filters":{"added":"2024-08","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"corresponding_author":["Pini, Sarah"],"country":["Germany"],"glorg":["All Global Affiliations","IU International University of Applied Sciences"],"keyword":["Autoethnography","Embodiment","Illness narrative","Phenomenology of Illness","Trauma","Video ethnography"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"an embodied narrative perspective on transforming trauma and illness experience","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/260163734/Pini_S._Wilde_L._2024_Preprint_transforming_trauma_and_illness_experience.pdf","version":"Pre-print"},"id":"S01-000.00-750931","ids":["sdu-c62398ac-e77f-46c4-af00-942b25c67126"],"keyword":["Autoethnography","Embodiment","Illness Narrative","Phenomenology of Illness","Trauma","video ethnography"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-E21B5068438E19FFD06C1876DAADD8D0"],"oa_link":[{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/260163734/Pini_S._Wilde_L._2024_Preprint_transforming_trauma_and_illness_experience.pdf","version":"Pre-print"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics, Research Unit of Movement, Culture and Society"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"de","key":"iu international university of applied sciences","loc":["Germany","Europe, EU","OECD"],"name":"IU International University of Applied Sciences","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Sarah","key":"pinipau","last":"Pini","locid":"2e3e10df-7624-4831-8cba-bdb1aae7a26f","name":"Pini, Sarah","orcid":"0000-0002-3346-9564","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lilian","key":"wildepau","last":"Wilde","name":"Wilde, Lilian","rank":2,"rolecode":"pau"},{"affno":"","first":"Anders Juhl","key":"rasmussenpedh","last":"Rasmussen","name":"Rasmussen, Anders Juhl","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Morten","key":"sodemannpedh","last":"Sodemann","name":"Sodemann, Morten","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"edition":"1.","isbn":["9781648898457"],"pages":"15-26","place":"Malaga","publisher":"Vernon Press","status":"p","title":"Narrative Medicine: Trauma and Ethics"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-c62398ac-e77f-46c4-af00-942b25c67126"],"src":["SDU University of Southern Denmark"],"title":"An embodied narrative perspective on transforming trauma and illness experience","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-750931","year":"2024","yearsub":"2024"}
{"abstract":"BACKGROUND: An improved understanding of the current practice of standing frame use may have implications for supporting parents in managing standing frames. We aimed to investigate how parents of children with cerebral palsy perceive and manage standing frame use in home settings. METHODS: We conducted a mixed methods study with an explanatory sequential design, first collecting and analysing quantitative questionnaire data and then using these results to inform a qualitative follow-up phase to explain them. The questionnaire was answered by 103 parents of children with cerebral palsy across five countries, Denmark, Norway, Great Britain, Canada and the United States, and 12 Danish families participated in the subsequent interviews. A descriptive analysis was conducted using the questionnaire data. The qualitative data were analysed using a directed content analysis, enabling integration of the quantitative and qualitative data. RESULTS: The quantitative analysis showed that 89% of the parents felt confident with their child's standing frame, and 82% felt they had sufficient knowledge about how their child's standing frame could/should be used. However, the qualitative analysis showed that even when feeling confident, the parents experienced insecurity regarding whether their child was positioned correctly, and being responsible for positioning was challenging. CONCLUSION: Our study implies a need for providing educational materials to assist the parents in ensuring optimal positioning of their child in the standing frame to decrease insecurity. Additionally, our study suggests a need to provide more thorough information about the benefits of using a standing frame and ensure alignment of expectations in relation to the child's prognosis of functional independence.","author_count":5,"contributors":["Krarup, Laerke Hartvig","Holsgaard-Larsen, Anders","Rasmussen, Helle Mätzke","Kyed, Stine Østergaard","Pawlowski, Charlotte Skau"],"cuid":["S01-000.00-755401"],"filters":{"added":"2024-09","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Krarup, Laerke Hartvig"],"keyword":["Adolescent","Adult","Canada","Cerebral Palsy rehabilitation","Child","Child Preschool","Denmark","Female","Humans","Male","Parents psychology","Qualitative Research","Surveys and Questionnaires","United Kingdom"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-PR-OTH","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"how best to support parents in the management of standing frame usage in home settings a mixed methods study","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1111/cch.13310","version":"Published Version"},"id":"S01-000.00-755401","identifier":[{"id":"85199559180","type":"scopus"},{"id":"39056283","type":"pmid"}],"ids":["sdu-609104fb-07b9-4a06-8041-5b2e62e46b4b"],"keyword":["Adolescent","Adult","Canada","Cerebral Palsy/rehabilitation","Child","Child, Preschool","Denmark","Female","Humans","Male","Parents/psychology","Qualitative Research","Surveys and Questionnaires","United Kingdom"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-FB39F2F536A53E2B1DF52CA297292BEB"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/268560957/Child_-_2024_-_Krarup_-_How_best_to_support_parents_in_the_management_of_standing_frame_usage_in_home_settings_A_mixed.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1111/cch.13310","version":"Published Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Sout