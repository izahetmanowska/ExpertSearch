rnal":"Resuscitation","pages":"10-17","publisher":"Elsevier Ireland Ltd","status":"p","title":"Resuscitation","volume":"151"},"review":"Peer Reviewed","scoID":["2-s2.0-85083804474"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-412a492a-d6f4-4d5c-bd7a-444101184981","au-8903ca65-9eb0-4c37-ae4c-d6b37542de4e","ku-851d5f62-7cc1-4cd5-987f-fbbee13c3f0b"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen"],"title":"The influence of prolonged temperature management on acute kidney injury after out-of-hospital cardiac arrest : A post-hoc analysis of the TTH48 trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-100.00-003193","year":"2020","yearsub":"2020"}
{"abstract":"Transcriptional characterization and classification has potential to resolve the inter-tumor heterogeneity of colorectal cancer and improve patient management. Yet, robust transcriptional profiling is difficult using formalin-fixed, paraffin-embedded (FFPE) samples, which complicates testing in clinical and archival material. We present MethCORR, an approach that allows uniform molecular characterization and classification of fresh-frozen and FFPE samples. MethCORR identifies genome-wide correlations between RNA expression and DNA methylation in fresh-frozen samples. This information is used to infer gene expression information in FFPE samples from their methylation profiles. MethCORR is here applied to methylation profiles from 877 fresh-frozen/FFPE samples and comparative analysis identifies the same two subtypes in four independent cohorts. Furthermore, subtype-specific prognostic biomarkers that better predicts relapse-free survival (HR = 2.66, 95%CI [1.67–4.22], P value < 0.001 (log-rank test)) than UICC tumor, node, metastasis (TNM) staging and microsatellite instability status are identified and validated using DNA methylation-specific PCR. The MethCORR approach is general, and may be similarly successful for other cancer types.","author_count":14,"contributors":["Mattesen, Trine Block","Rasmussen, Mads Heilskov","Sandoval, Juan","Ongen, Halit","Árnadóttir, Sigrid Salling","Gladov, Josephine","Martinez-Cardus, Anna","Castro de Moura, Manuel","Madsen, Anders Husted","Laurberg, Søren","Dermitzakis, Emmanouil T.","Esteller, Manel","Andersen, Claus Lindbjerg","Bramsen, Jesper Bertram"],"cuid":["S01-000.00-191457"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","OECD"],"corresponding_author":["Andersen, Claus Lindbjerg"],"country":["Spain","Switzerland"],"glorg":["All Global Affiliations","Autonomous University of Barcelona","Carlos III Health Institute (ISCIII) (CIBER)","Hospital Clinic de Barcelona","ICREA","Josep Carreras Leukaemia Research Institute ","University of Geneva"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"methcorr modelling of methylomes from formalin fixed paraffin embedded tissue enables characterization and prognostication of colorectal cancer","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1038/s41467-020-16000-6","version":"Published Version"},"id":"S01-000.00-191457","identifier":[{"id":"32332866","type":"pmid"},{"id":"PMC7181739","type":"pmcid"},{"id":"85083865215","type":"scopus"}],"ids":["au-6cf195f0-37da-4e46-b2a1-765b9c1f588d"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-8E02EC5AC66589699A69D933A617E06D"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1038/s41467-020-16000-6","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Molecular Medicine (MOMA)"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1},{"affno":"3","country":"ch","key":"university of geneva","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"University of Geneva","used":1},{"affno":"4","country":"es","key":"hospital clinic de barcelona","loc":["Spain","Europe, EU","OECD"],"name":"Hospital Clinic de Barcelona","used":1},{"affno":"5","country":"es","key":"josep carreras leukaemia research institute","loc":["Spain","Europe, EU","OECD"],"name":"Josep Carreras Leukaemia Research Institute ","used":1},{"affno":"6","country":"es","key":"carlos iii health institute","loc":["Spain","Europe, EU","OECD"],"name":"Carlos III Health Institute (ISCIII) (CIBER)","used":1},{"affno":"7","country":"es","key":"icrea","loc":["Spain","Europe, EU","OECD"],"name":"ICREA","used":1},{"affno":"8","country":"es","key":"autonomous university of barcelona","loc":["Spain","Europe, EU","OECD"],"name":"Autonomous University of Barcelona","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Trine B.","key":"mattesenpau","last":"Mattesen","locid":"45683443-ce61-4d8f-b5c7-9cc9b8ec8c92","name":"Mattesen, Trine Block","name_org":"Mattesen, Trine B.","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mads H.","key":"rasmussenpau","last":"Rasmussen","locid":"3285e14f-ef19-480d-97ff-c95d6a90b354","name":"Rasmussen, Mads Heilskov","name_org":"Rasmussen, Mads H.","orcid":"0000-0001-5723-6303","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Juan","key":"sandovalpau","last":"Sandoval","name":"Sandoval, Juan","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Halit","key":"ongenpau","last":"Ongen","name":"Ongen, Halit","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sigrid S.","key":"árnadóttirpau","last":"Árnadóttir","locid":"4149becb-6615-4462-82e3-cec92e48a5e0","name":"Árnadóttir, Sigrid Salling","name_org":"Árnadóttir, Sigrid S.","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Josephine","key":"gladovpau","last":"Gladov","locid":"919b3ccb-d408-4fcd-9b02-61667cc