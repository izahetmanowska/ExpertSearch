5-45c0-8ad2-bb91a248ff22","name":"Etzerodt, Anders","orcid":"0000-0002-6757-2068","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jakob Skou","key":"pedersenpau","last":"Pedersen","locid":"9c14e87f-2dc3-4c08-a074-146337aff8a0","name":"Pedersen, Jakob Skou","orcid":"0000-0002-7236-4001","rank":11,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Russell W","key":"jenkinspau","last":"Jenkins","name":"Jenkins, Russell W","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren Egedal","key":"degnpau","last":"Degn","locid":"1cc496f2-e9c5-4751-b0b1-9669b1735925","name":"Degn, Søren Egedal","orcid":"0000-0001-5409-045X","rank":13,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren Kragh","key":"moestruppau","last":"Moestrup","locid":"84b91217-5ed8-4507-8a92-00c1815e2c81","name":"Moestrup, Søren Kragh","rank":14,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik","key":"schmidtpau","last":"Schmidt","locid":"834188a5-a600-41a5-a8a1-9e34c3837141","name":"Schmidt, Henrik","rank":15,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Torben","key":"steinichepau","last":"Steiniche","locid":"7e538367-420a-4384-ba76-033652a0ea41","name":"Steiniche, Torben","orcid":"0000-0001-5689-3555","rank":16,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mette","key":"madsenpau","last":"Madsen","locid":"685cefd4-2a9d-477f-8d83-beb7f5c54351","name":"Madsen, Mette","orcid":"0000-0001-7241-6505","rank":17,"rolecode":"pau"}],"pmid":["40913277"],"pub":{"doi":"10.1111/pcmr.70053","issn":["09069305","17551471"],"issn_org":["17551471"],"issue":"5","journal":"Pigment Cell & Melanoma Research","paperid":"e70053","publisher":"Wiley-Blackwell Publishing Ltd","status":"p","title":"Pigment Cell & Melanoma Research","volume":"38"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-3aed12b4-f3cc-410d-843c-dc2d6c9c0bd8"],"src":["AU Aarhus University"],"title":"LRP2 Expression in Melanoma Is Associated With a Transitory Cell State, Increased T Cell Infiltration, and Is Upregulated by IFNy Signaling","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-824881","year":"2025","yearsub":"2025"}
{"abstract":"Background In the Handling Oxygenation Targets in COVID-19 (HOT-COVID) trial, a Pao2 target of 60 mm Hg compared with 90 mm Hg resulted in more days alive without life support at 90 days in adults in the ICU with COVID-19 and hypoxemia. The trial was stopped after enrolling 726 of 780 planned patients because of slow recruitment. Herein, we present the preplanned Bayesian analysis of the HOT-COVID trial. Research Question What are the probabilities of any benefits and of clinically relevant benefits resulting from a Pao2 target of 60 mm Hg vs 90 mm Hg in adult patients with COVID-19 and hypoxemia in the ICU and does heterogeneity of treatment effects (HTE) exist according to selected baseline characteristics? Study Design and Methods We analyzed days alive without life support and 90-day mortality in the HOT-COVID intention-to-treat population (n = 697) using Bayesian general linear models to assess probabilities for benefit or harm, including clinically relevant benefits defined as > 1 day alive without life support and > 2 percentage points lower 90-day mortality. HTE was evaluated based on baseline Sequential Organ Failure Assessment scores, Pao2 to Fio2 ratio, norepinephrine doses, and lactate concentrations. Results The mean difference in days alive without life support was 5.7 days (95% credible interval, 0.2-11.2), with a 95.2% probability of clinically relevant benefit and a 98.0% probability of any benefit from the lower Pao2 target. The risk difference in 90-day mortality was –4.6 percentage points (95% credible interval, –11.8 to 2.6 percentage points), with a 76.5% probability of a clinically relevant benefit from the lower target. HTE analyses revealed potential interaction with baseline norepinephrine dose and lactate concentrations for both outcomes. Interpretation In patients with COVID-19 and hypoxemia in the ICU, we found a high probability for a clinically relevant benefit of targeting a Pao2 of 60 mm Hg vs 90 mm Hg on number of days alive without life support. Clinical Trial Registry ClinicalTrials.gov; No.: NCT04425031; URL: www.clinicaltrials.gov","author_count":7,"contributors":["Nielsen, Frederik Mølgaard","Lass Klitgaard, Thomas","Granholm, Anders","Lange, Theis","Perner, Anders","Schjørring, Olav Lilleholt","Rasmussen, Bodil Steen"],"cuid":["S02-092.02-793052"],"filters":{"added":"2024-11","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Nielsen, Frederik Mølgaard"],"keyword":["Bayesian analysis","Covid 19","Hypoxia","Oxygen Inhalation Therapy","Respiratory Insufficiency"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-NDR","DI-HO-OTH"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-HO-NDR","DI-HO-OTH","DI-U-AAU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"lower or higher oxygenation targets in patients with covid 000000000019 in the icu a secondary bayesian analysis of the handling oxygenation targets in covid 000000000019 trial","src":["aau","ku"],"src-code":["DI-U-AAU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.chest.2024.08.055","version":"Published Version"},"funding_acknowledgement":["Funded by the Danish Ministry of Higher Education and Science [Grant 0238-00004B]."],"id":"S02-092.02-793052","identifier":[{"id":"39303806","type":"pmid"},{"id":"85210146047","type":"scopus"}],"ids":["aau-d941d95e-db02-42f0-8593-38fc984ff9e4","ku-0d256d88-3204-43fd-84ed-3e8abe8f7c58"],"keyword":["Bayesian analysis","COVID-19","ICUs","hypoxia","oxygen inhalation therapy","respiratory insufficiency"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-ABEE5F67804CBC105306D1F2077F53FA"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/773235431/Nielsen_et_al._2025_._Lower_or_Higher_Oxygenation_Targets_in_Patients_With_COVID-19_in_the_ICU_-_A_Secondary_Bayesian_Analysis_of_the_Handling_Oxygenation_Targets_in_COVID-19_Trial.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.chest.2024.08.055","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/431121199/Fulltext.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Anaesthesiology and Intensive Care"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"other hospitals","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-OTH","l3nl":"Other Hospitals","l3nn":"Other Hospitals","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Hospitals","namevar":["Collaboration for Research in Intensive Care"],"nora_code":"DI-HO-OTH","used":1},{"affno":"3","country":"dk","key":"north denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-NDR","l3nl":"North Denmark Region","l3nn":"North Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"North Denmark Region","namevar":["Aalborg University Hospital"],"nora_code":"DI-HO-NDR","used":1},{"affno":"4","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Rigshospitalet, Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"5","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Department of Public Health"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1 2 3","corresponding":null,"first":"Frederik M,","key":"nielsenpau","last":"Nielsen","locid":"d7387610-1579-4bc0-892f-a8523e6579ba","name":"Nielsen, Frederik Mølgaard","name_org":"Nielsen, Frederik M,","rank":1,"rolecode":"pau"},{"affno":"1 2 3","corresponding":null,"first":"Thomas L.","key":"klitgaardpau","last":"Klitgaard","locid":"f3e0e4b8-0772-4f4f-8be2-b99763b3917c","name":"Lass Klitgaard, Thomas","name_org":"Klitgaard, Thomas L.","orcid":"0000-0002-8781-1206","rank":2,"rolecode":"pau"},{"affno":"2 4","corresponding":null,"first":"Anders","key":"granholmpau","last":"Granholm","name":"Granholm, Anders","rank":3,"rolecode":"pau"},{"affno":"5","first":"Theis","key":"langepau","last":"Lange","locid":"e4664578-01fc-4a93-8efd-1dbffb72cdd6","name":"Lange, Theis","orcid":"0000-0001-6807-8347","rank":4,"rolecode":"pau"},{"affno":"4 5","first":"Anders","key":"pernerpau","last":"Perner","locid":"8a389541-d529-4ee3-8364-66bfc85f77c9","name":"Perner, Anders","rank":5,"rolecode":"pau"},{"affno":"2 1 3","corresponding":null,"first":"Olav L.","key":"schjørringpau","last":"Schjørring","locid":"7dac619e-9b5c-46ac-9170-10ac13165da5","name":"Schjørring, Olav Lilleholt","name_org":"Schjørring, Olav L.","rank":6,"rolecode":"pau"},{"affno":"2 1 3","corresponding":null,"country":"dk","first":"Bodil S.","key":"rasmussenpau","last":"Rasmussen","locid":"3162c449-94c3-4d28-8dbb-c134d6eb76e1","name":"Rasmussen, Bodil Steen","name_org":"Rasmussen, Bodil S.","orcid":"0000-0003-2190-145X","rank":7,"rolecode":"pau"}],"pmid":["39303806"],"pub":{"doi":"10.1016/j.chest.2024.08.055","issn":["00123692","19313543"],"issn_org":["00123692"],"issue":"3","journal":"Chest","pages":"757-767","publisher":"Elsevier","status":"p","title":"Chest","volume":"167"},"review":"Peer Reviewed","scoID":["2-s2.0-85210146047"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Other Hospitals","Universities","University of Copenhagen","collaboration for research in intensive care"],"PST":["Published"]},"sid":["aau-d941d95e-db02-42f0-8593-38fc984ff9e4","ku-0d256d88-3204-43fd-84ed-3e8abe8f7c58"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"Lower or Higher Oxygenation Targets in Patients With COVID-19 in the ICU: A Secondary Bayesian Analysis of the Handling Oxygenation Targets in COVID-19 Trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-092.02-793052","year":"2025","yearsub":"2025"}
{"abstract":"Background: Subarachnoid haemorrhage (SAH) and intraventricular haemorrhage (IVH) are associated with poor patient outcomes. Intraventricular fibrinolysis is effective in clearing IVH and improving patient survival and neurological outcome. By similar rationale, cisternal irrigation has been proposed as a potential method to accelerate haematoma clearance in SAH. We aimed to provide a comprehensive review and meta-Analysis evaluating the effect of intraventricular and cisternal irrigation on clinical outcomes in patients with SAH and IVH. Methods: The Preferred Reporting Items for Systematic Reviews and Meta-Analyses guidelines were followed preparing this systematic review and study selection was performed by multiple investigators. We extracted ORs from the individual studies and aggregated these using a random effects model. The quality of evidence was evaluated using Grading of Recommendations, Assessment, Development and Evaluations assessment and ROBINS-I or RoB-2. Results: 24 articles were included. In SAH, we found that cisternal irrigation with fibrinolytic agents was associated with reduced mortality (OR: 0.68, 95% CI 0.46 to 1.00), higher probability of favourable functional outcome (OR: 1.80, 95% CI 1.30 to 2.51), and reduced risks of DCI (OR: 0.28, 95% CI 0.18 to 0.42) and cerebral vasospasm (OR: 0.28, 95% CI 0.18 to 0.42), compared with conventional therapy. Cisternal irrigation with vasodilatory agents was associated with lower mortality (OR: 0.32, 95% CI 0.13 to 0.79) and reduced risk of cerebral vasospasm (OR: 0.37, 95% CI 0.17 to 0.79). The evidence for irrigation therapy of IVH was sparse and insufficient to show any significant effect. Conclusion: In this study, we found that cisternal irrigation could improve the prognosis in patients with SAH compared with conventional therapy. There is no evidence to support cisternal irrigation treatment of IVH.","author_count":8,"contributors":["Lind, Allice N R","Krabbenhøft, Mathias Green","Valentin, Jan Brink","Haldrup, Mette","Dyrskog, Stig Eric","Rasmussen, Mads","Simonsen, Claus Ziegler","Korshoej, Anders Rosendal"],"cuid":["S02-095.24-741325"],"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Korshoej, Anders Rosendal"],"keyword":["Hemorrhage","Intracranial Aneurysm","Subarachnoid"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-HO-CDR","DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"cisternal and intraventricular irrigation in subarachnoid and intraventricular haemorrhage","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC 4.0","type":"doi","url":"https://doi.org/10.1136/svn-2023-003062","version":"Published Version"},"funding_acknowledgement":["ARK is supported by grants from the Danish Cancer Society (R304-A17698-B5570 and R295-A16770), the Lundbeck Foundation (R325-2019-1490) and the Independent Research Fund Denmark (903900307B) unrelated to this study. MR is supported by a grant from The Health Research Fund of Central Denmark Region unrelated to this study. CZS is supported by grants from The Health Research Fund of Central Region Denmark and the Novo Nordisk Foundation unrelated to this study."],"id":"S02-095.24-741325","identifier":[{"id":"PMC11877441","type":"pmcid"},{"id":"38782496","type":"pmid"},{"id":"85194933211","type":"scopus"}],"ids":["aau-32f46ade-368a-4dd9-b74c-5d547a7a8bc2","au-52bdbf97-8538-4ebe-a6b1-363c8029b047"],"keyword":["Hemorrhage","Intracranial Aneurysm","Subarachnoid"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-A7E6DEEEC67BD9028276A12CA6D64FEB"],"oa_link":[{"access":"oa","license":"CC BY-NC 4.0","type":"loc","url":"h