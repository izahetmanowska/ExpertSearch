{"author_count":3,"contributors":["Rasmussen, Anders Juhl"],"cuid":["S01-000.00-680563"],"filters":{"added":"2023-07","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Narrativ medicin"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"angst og psykose om tove ditlevsens sene forfatterskab","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://unipress.dk/udgivelser/a/angst-i-dansk-litteratur/","version":"Other Version"},"id":"S01-000.00-680563","ids":["sdu-a3c73c36-97f6-409d-a603-34223d043fdb"],"keyword":["Narrativ medicin"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-7F7901E6BB8A1D45937993C20D2B9162"],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Humanities, Department of Culture and Language"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anders Juhl","key":"rasmussenpau","last":"Rasmussen","locid":"6612df8e-d9f9-4004-b959-a9c30b0762a5","name":"Rasmussen, Anders Juhl","orcid":"0000-0001-7718-5208","rank":1,"rolecode":"pau"},{"affno":"","first":"Markus","key":"florischristensenpedh","last":"Floris Christensen","name":"Floris Christensen, Markus","rank":2,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Anders","key":"ehlersdampedh","last":"Ehlers Dam","name":"Ehlers Dam, Anders","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["978 87 7219 193 5"],"issue":"4","pages":"189-210","place":"Aarhus",