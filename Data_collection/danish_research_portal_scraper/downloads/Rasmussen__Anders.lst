k":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"B","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, B","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"L.","key":"tangpau","last":"Tang","name":"Tang, L.","rank":7,"rolecode":"pau"},{"affno":"2","first":"L","key":"adamsenpau","last":"Adamsen","locid":"e2dd2ae3-e721-4895-8f98-a857c3a88e6a","name":"Adamsen, Lis","name_org":"Adamsen, L","rank":8,"rolecode":"pau"},{"affno":"2 1","first":"M","key":"rørthpau","last":"Rørth","locid":"3495a8d7-73b7-40a5-a9de-ee95073dfe42","name":"Rørth, Mikael","name_org":"Rørth, M","rank":9,"rolecode":"pau"}],"pmid":["23704198"],"pub":{"doi":"10.1093/annonc/mdt185","issn":["09237534","11320109"],"issn_org":["09237534"],"issue":"9","journal":"Annals of Oncology","pages":"2267-2273","status":"p","title":"Annals of Oncology","title_org":"Annals of oncology : official journal of the European Society for Medical Oncology / ESMO","volume":"24"},"review":"Peer Reviewed","scoID":["2-s2.0-84883399161"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-e32a8510-a615-46ee-a85f-80fc507cc7b3","sdu-3d656356-70f6-4b1d-8a78-7ae4b7222f68"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Efficacy of multimodal exercise-based rehabilitation on physical activity, cardiorespiratory fitness, and patient-reported outcomes in cancer survivors : a randomized, controlled trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-091.60-046891","year":"2013","yearsub":"2013"}
{"abstract":"Abstract The majority of clear-cell renal cell carcinomas (ccRCC) show high and homogeneous expression levels of the tumor associated antigen (TAA) carbonic anhydrase IX (CAIX), and treatment with interleukin-2 (IL-2) based immunotherapy can lead to cure in patients with metastatic renal cell carcinoma (mRCC). However, the involvement of CAIX specific CD8+ T cells and/or NK cells in the tumor eradication is unknown. We investigated T cell and antibody reactivity against overlapping 15-mer CAIX-peptides as well as HLA haplotype frequency and NK cell cytotoxicity in 11 patients with no evidence of disease (NED) following treatment with IL-2 based immunotherapy, and thus potentially cured. Immune reactivity in these patients was compared with samples from patients with dramatic tumor response obtained immediately at the cessation of therapy, samples from patients that experienced progressive disease during treatment and samples from healthy controls. We observed more focused but only weak and not consistent CAIX specific T-cells in the late observation and early observation response groups compared with the healthy control group. An increased frequency of the class II alleles HLA-DRB4 01:01, HLA-DPB 01:01 and HLA-DPB 03:01 was noted in the NED patients. In contrast, NK cytotoxicity was low even in the late observation response group as compared with controls. In particular, a HLA-B*40:01 restricted CD8+ T cell response recognizing the CAIX- derived peptide SEEEGSLKL was identified. This may have interest in future cancer vaccines, but more studies are needed to elucidate the immunological mechanisms of action in potentially cured patients treated with an immunotherapeutic agent.","author_count":11,"contributors":["Rasmussen, Susanne","Donskov, Frede","Pedersen, Johannes W","Wandall, Hans H","Buus, Søren","Harndahl, Mikkel","Braendstrup, Peter","Claesson, Mogens H","Pedersen, Anders Elm"],"cuid":["S02-099.90-026256"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"keyword":["Adult","Aged","Antigens Neoplasm","Antineoplastic Agents","CD8 Positive T Lymphocytes","Carbonic Anhydrases","Carcinoma Renal Cell","Female","Follow Up Studies","Humans","Immunity Cellular","Immunotherapy","Interleukin 2","Kidney Neoplasms","Male","Middle Aged","Neoplasm Metastasis","Peptides","Retrospective Studies"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-UND"]},"level3all":["DI-U-AU","DI-U-KU","DI-U-UND"]},"review":"pr","rtype":["clu"],"sorti":"carbon anhydrase ix specific immune responses in patients with metastatic renal cell carcinoma potentially cured by interleukin 000000000002 based immunotherapy","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3109/08923973.2013.802802","version":"Other Version"},"id":"S02-099.90-026256","identifier":[{"id":"23802595","type":"pmid"},{"id":"84880321316","type":"scopus"}],"ids":["au-bae9313a-01c7-4d9e-a37d-0a9ac1205f4f","ku-70462ff6-c00b-4d7e-9e42-339002b01a83"],"keyword":["Adult","Aged","Antigens, Neoplasm","Antineoplastic Agents","CD8-Positive T-Lymphocytes","Carbonic Anhydrases","Carcinoma, Renal Cell","Female","Follow-Up Studies","HLA-DR beta-Chains","Humans","Immunity, Cellular","Immunotherapy","Interleukin-2","Kidney Neoplasms","Male","Middle Aged","Neoplasm Metastasis","Peptides","Retrospective Studies"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-6A0F29CDD6809F224600C2F0AE6C4FEB"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.ncbi.nlm.nih.gov/pubmed/23802595","version":"Other Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.3109/08923973.2013.802802","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yea