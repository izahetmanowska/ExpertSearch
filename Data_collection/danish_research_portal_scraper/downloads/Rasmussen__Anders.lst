"pau"},{"affno":"1","corresponding":null,"first":"Martin G.","key":"rasmussenpau","last":"Rasmussen","locid":"8b86a1ef-e6c1-4de3-8300-e30d144bbf60","name":"Rasmussen, Martin Gillies Banke","name_org":"Rasmussen, Martin G.","orcid":"0000-0002-2114-2185","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders","key":"grøntvedpau","last":"Grøntved","locid":"393b1ca1-e658-437c-9ca3-73aea925ad58","name":"Grøntved, Anders","orcid":"0000-0003-1584-679X","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.chbr.2021.100164","issn":["07475632","18737692"],"issn_org":["07475632"],"journal":"Computers in Human Behavior","paperid":"100164","publisher":"Elsevier Ltd","status":"p","title":"Computers in Human Behavior","volume":"5"},"review":"Peer Reviewed","scoID":["2-s2.0-85125679059"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","All University Colleges","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","Hospitals","UC SYD, University College South Denmark","UCL University College","Universities","University Colleges","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-fcdc5445-3e38-4e0f-9743-9ebe208be15d","ucl-138affe5-2026-49ac-97d2-80d82f388735","ucsyd-50e06df8-df2b-416f-8f28-89185dbd025d"],"src":["SDU University of Southern Denmark","UC SYD University College South Denmark","UCL University College"],"title":"Criterion validity of a research-based application for tracking screen time on android and iOS smartphones and tablets","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-091.93-794029","year":"2022","yearsub":"2022"}
{"abstract":"BACKGROUND: Mortality is often the primary outcome in randomised clinical trials (RCTs) conducted in critically ill patients. Due to increased awareness on survivors after critical illness and outcomes other than mortality, health-related quality of life (HRQoL) and days alive without life support (DAWOLS) or days alive and out of hospital (DAAOOH) are increasingly being used. DAWOLS and DAAOOH convey more information than mortality, are easier to collect than HRQoL, and are usually assessed at earlier time points, which may be preferable in some situations. However, the associations between DAWOLS-DAAOOH and HRQoL are uncertain. METHODS: We will assess associations between DAWOLS-DAAOOH at day 28 and 90 (independent variables/predictors) and HRQoL assessed using the EuroQol EQ-5D-5L questionnaire (EQ-VAS and EQ-5D-5L index values) at 6 or 12 months (dependent variables) in two RCTs: the COVID STEROID 2 RCT conducted in adult patients with COVID-19 and severe hypoxaemia and the Handling Oxygenation Targets in the Intensive Care Unit (HOT-ICU) RCT conducted in adult intensive care patients with acute hypoxaemic respiratory failure. We will describe associations using best-fitting fractional polynomial transformations separately in each dataset, with the resulting models presented and assessed in both datasets graphically and using measures of fit and prediction adequacy (i.e., internal performance and external validation). We will use multiple imputation if missingness exceeds 5%. DISCUSSION: The outlined study will provide important knowledge on the associations between DAWOLS-DAAOOH and HRQoL in adult critically ill patients, which may help researchers and clinical trialists prioritise and select outcomes in future RCTs conducted in this population.","author_count":13,"contributors":["Granholm, Anders","Schjørring, Olav Lilleholt","Jensen, Aksel Karl Georg","Kaas-Hansen, Benjamin Skov","Munch, Marie Warrer","Lass Klitgaard, Thomas","Crescioli, Elena","Kjær, Maj-Brit Nørregaard","Strøm, Thomas","Perner, Anders","Rasmussen, Bodil Steen","Møller, Morten Hylander"],"cuid":["S03-093.83-006095"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"corresponding_author":["Granholm, Anders"],"keyword":["Critical Illness","Critical care","Days alive and out of hospital","Days alive without life support","Health related quality of life","Randomised clinical trials","outcome selection"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-OTH","DI-HO-SDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU","DI-U-SDU","DI-U-UND"]},"level3all":["DI-HO-CAP","DI-HO-OTH","DI-HO-SDR","DI-U-AAU","DI-U-KU","DI-U-SDU","DI-U-UND"]},"review":"pr","rtype":["clu"],"sorti":"health related quality of life and days alive without life support or out of hospital protocol","src":["aau","ku","sdu"],"src-code":["DI-U-AAU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/532527206/Health_related_quality_of_life_and_days_alive_without_life_support_or_out_of_hospital_protocol.pdf","version":"Authors Final Version"},"funding_acknowledgement":["The Department of Intensive Care at Rigshospitalet has received funding for other research projects from the Novo Nordisk Foundation, Pfizer, Ferring and Fresenius Kabi, and conducts contract research for AM‐Pharma (the REVIVAL trial). This study will be conducted as part of the Intensive Care Platform Trial (INCEPT; www.incept.dk ) research programme. INCEPT has received funding by Sygeforsikringen “danmark”, Grosserer Jakob Ehrenreich og Hustru Grete Ehrenreichs Fond and Dagmar Marshalls Fond. The COVID STEROID 2 trial was funded by the Novo Nordisk Foundation and supported by Rigshospitalet; the HOT‐ICU trial was funded by the Innovation Fund Denmark, Aalborg University Hospital, the Regions of Denmark, the Obel Family Foundation, the Danish Society of Anaesthesiology and Intensive Care Medicine, and the Intensive Care Symposium Hindsgavl. None of the funders had any influence on any aspects of this study."],"id":"S03-093.83-006095","identifier":[{"id":"34811741","type":"pmid"},{"id":"85120475587","type":"scopus"}],"ids":["aau-7de4ab81-841d-4dec-a7e3-8dd9256617b5","ku-3599900c-d8c7-410a-bea7-5af640524463","sdu-fa03231a-12dd-4f8a-8968-cc05a9301a1d"],"keyword":["critical care","critical illness","days alive and out of hospital","days alive without life support","health-related quality of life","outcome selection","randomised clinical trials"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-01E958F800A7DFB2C149B882AE4623EA"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/532527206/Health_related_quality_of_life_and_days_alive_without_life_support_or_out_of_hospital_protocol.pdf","version":"Authors Final Version"},{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/195688416/aas.14001.pdf","version":"Authors Final Version"},{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/305528360/LINI_aas.14001.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"dk","key":"other hospitals","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-OTH","l3nl":"Other Hospitals","l3nn":"Other Hospitals","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Hospitals","namevar":["Collaboration for Research in Intensive Care"],"nora_code":"DI-HO-OTH","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Rigshospitale