Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Thomas L","key":"klitgaardpau","last":"Klitgaard","locid":"f3e0e4b8-0772-4f4f-8be2-b99763b3917c","name":"Lass Klitgaard, Thomas","name_org":"Klitgaard, Thomas L","orcid":"0000-0002-8781-1206","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Olav L","key":"schjørringpau","last":"Schjørring","locid":"7dac619e-9b5c-46ac-9170-10ac13165da5","name":"Schjørring, Olav Lilleholt","name_org":"Schjørring, Olav L","rank":2,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Frederik M","key":"nielsenpau","last":"Nielsen","locid":"d7387610-1579-4bc0-892f-a8523e6579ba","name":"Nielsen, Frederik Mølgaard","name_org":"Nielsen, Frederik M","rank":3,"rolecode":"pau"},{"affno":"3 2","first":"Christian S.","key":"meyhoffpau","last":"Meyhoff","locid":"4d112eed-e878-476d-8f1f-df10d39439b2","name":"Meyhoff, Christian S.","orcid":"0000-0002-4885-4609","rank":4,"rolecode":"pau"},{"affno":"2 3","first":"Anders","key":"pernerpau","last":"Perner","locid":"8a389541-d529-4ee3-8364-66bfc85f77c9","name":"Perner, Anders","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jørn","key":"wetterslevpau","last":"Wetterslev","name":"Wetterslev, Jørn","rank":6,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Bodil S","key":"rasmussenpau","last":"Rasmussen","locid":"3162c449-94c3-4d28-8dbb-c134d6eb76e1","name":"Rasmussen, Bodil Steen","name_org":"Rasmussen, Bodil S","orcid":"0000-0003-2190-145X","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Marija","key":"barbateskovicpau","last":"Barbateskovic","name":"Barbateskovic, Marija","rank":8,"rolecode":"pau"}],"pmid":["37700687"],"pub":{"doi":"10.1002/14651858.cd012631.pub3","issn":["13616137","1469493X"],"issn_org":["13616137"],"issue":"9","journal":"Cochrane Database of Systematic Reviews","paperid":"CD012631","publisher":"Wiley","status":"p","title":"Cochrane Database of Systematic Reviews","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-85171119358"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-5304ff8e-27fc-43cd-97cd-7fa9768e4df6","ku-4920eeec-e2d0-4ba5-b1ef-301a9e45e908"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"Higher versus lower fractions of inspired oxygen or targets of arterial oxygenation for adults admitted to the intensive care unit","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-087.23-741380","year":"2023","yearsub":"2023"}
{"abstract":"BACKGROUND: Postoperative pain after total hip arthroplasty (THA) may delay postoperative mobilization and discharge. Postoperative pain has been shown to be higher in pain catastrophisers and patients receiving opioids. A single dose of glucocorticoid reduces pain after THA, and an increased dose of glucocorticoids has been found to be effective in patients at high risk of postoperative pain after total knee arthroplasty (TKA), however, the ideal dose in THA remains unknown. OBJECTIVE: To evaluate the effect of a high dose (1 mg kg-1) vs. intermediate dose (0.3 mg kg-1) of dexamethasone on pain after THA. DESIGN: A randomized double-blind controlled study. SETTING: A two-centre study including two large arthroplasty sites in Denmark was conducted from February 2019 to August 2020. PATIENTS: A total of 160 patients undergoing THA by neuraxial block with multimodal analgesia, having a Pain Catastrophising Scale score >20 and/or preoperative opioid use were included. INTERVENTION: Patients were randomly assigned to receive dexamethasone 1 mg kg-1 or 0.3 mg kg-1 before THA. MAIN OUTCOME MEASURES: Primary outcome was percentage of patients experiencing moderate to severe pain (visual analogue scale, VAS > 30 mm on a 0 to 100 mm scale) on ambulating 24 h after surgery. Secondary outcomes included cumulated pain scores, C-reactive protein (CRP), opioid use, postoperative recovery scores, length of stay, complications, and re-admission within 30 and 90 days. RESULTS: No difference was found in percentage of VAS >30 mm 24 h after surgery in the 5-m walk test (VAS > 30/VAS ≤ 30%); 33/42 (44%) vs. 32/43 (43%), relative risk = 1.04 (95% confidence interval 0.72-1.51; P = 0.814) in 1 mg kg-1vs. 0.3 mg kg-1 respectively. No differences were found in CRP and opioid use between groups. Also, no intergroup differences were found in recovery scores, re-admissions, or complications. CONCLUSION: 1 mg kg-1vs. 0.3 mg kg-1 dexamethasone improved neither postoperative pain nor recovery in THA in a cohort of predicted high pain responders. TRIAL REGISTRATION: ClinicalTrials.gov ID-number NCT03763760 and EudraCT-number 2018-2636-25. CLINICAL TRIAL NUMBER: EudraCT-number 2018-2636-25, ClinicalTrials.gov ID-number NCT03763760 (URL: https://clinicaltrials.gov/ct2/show/NCT03763760).","author_count":10,"contributors":["Nielsen, Niklas I","Kehlet, Henrik","Gromov, Kirill","Troelsen, Anders","Husted, Henrik","Varnum, Claus","Kjærsgaard-Andersen, Per","Rasmussen, Lasse Enkebølle","Pleckaitiene, Lina","Foss, Nicolai B"],"cuid":["S02-088.46-742323"],"filters":{"added":"2023-11","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Nielsen, Niklas I"],"keyword":["Analgesics Opioid","Arthroplasty Replacement Hip adverse effects","Dexamethasone","Double Blind Method","Humans","Pain Postoperative diagnosis"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-SDR","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"high dose dexamethasone in high pain responders undergoing total hip arthroplasty a randomized controlled trial","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85170295101","version":"Other Version"},"id":"S02-088.46-742323","identifier":[{"id":"85170295101","type":"scopus"},{"id":"37166257","type":"pmid"}],"ids":["ku-6844cce5-43a7-47b2-9cbd-63a6d4fdd7d9","sdu-6a9f2bab-db00-4264-b5d1-5cc11d8b583c"],"keyword":["Analgesics, Opioid","Arthroplasty, Replacement, Hip/adverse effects","Dexamethasone","Double-Blind Method","Humans","Pain Management/adverse effects","Pain, Postoperative/diagnosis"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-E5F548E11E942BE63B5757F9F317B4BD"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Amager and Hvidovre"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Regional Health Research","SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Lillebælt Hospital, Research Unit of Orthopaedics (Vejle)"],"nora_code":"DI-U-SDU","used":1},{"affno":"4","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Lillebaelt University Hospital"],"nora_code":"DI-HO-SDR","used":1}],"person":[{"affno":"1 2","first":"Niklas I.","key":"nielsenpau","last":"Nielsen","locid":"7f5e02f9-db74-437d-a29e-60baae07f850","name":"Nielsen, Niklas","name_org":"Nielsen, Niklas I.","rank":1,"rolecode":"pau"},{"affno":"1 2","first":"Henrik","key":"kehletpau","last":"Kehlet","locid":"0a3c43a0-a0c5-4a91-85d6-6e80e16af8b5","name":"Kehlet, Henrik","orcid":"0000-0002-2209-1711","rank":2,"rolecode":"pau"},{"affno":"2 1","first":"Kirill","key":"gromovpau","last":"Gromov","locid":"efb84811-45bd-4724-97f5-e10d5b84525f","name":"Gromov, Kirill","rank":3,"rolecode":"pau"},{"affno":"2 1","first":"Anders","key":"troelsenpau","last":"Troelsen","locid":"49cb6bcf-2ff6-41af-a356-a2a09c2ce7ba","name":"Troelsen, Anders","orcid":"0000-0003-0132-8182","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Henrik","key":"hustedpau","last":"Husted","name":"Husted, Henrik","rank":5,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Claus","key":"varnumpau","last":"Varnum","locid":"0f639544-4ebc-467c-a15b-3c049a26f62f","name":"Varnum, Claus","orcid":"0000-0002-0625-5691","rank":6,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Per","key":"kjærsgaardandersenpau","last":"Kjærsgaard-Andersen","locid":"9d7006f6-37d8-43c1-a108-2705353942f6","name":"Kjærsgaard-Andersen, Per","orcid":"0000-0001-6845-4218","rank":7,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Lasse E","key":"rasmussenpau","last":"Rasmussen","locid":"ada7d12e-e6cc-4568-b072-91b059d28c72","name":"Rasmussen, Lasse Enkebølle","name_org":"Rasmussen, Lasse E","rank":8,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Lina","key":"pleckaitienepau","last":"Pleckaitiene","locid":"806dda50-3350-49fd-8060-2bf36188d853","name":"Pleckaitiene, Lina","rank":9,"rolecode":"pau"},{"affno":"2 1","first":"Nicolai B.","key":"fosspau","last":"Foss","locid":"dc8c28e3-27ee-4329-8985-2b176ab69b4b","name":"Foss, Nicolai Bang","name_org":"Foss, Nicolai B.","rank":10,"rolecode":"pau"}],"pmid":["37166257"],"pub":{"doi":"10.1097/eja.0000000000001853","issn":["02650215","09521941"],"issn_org":["02650215"],"issue":"10","journal":"European Journal of Anaesthesiology","pages":"737-746","publisher":"Lippincott Williams and Wilkins","status":"p","title":"European Journal of Anaesthesiology","volume":"40"},"review":"Peer Reviewed","scoID":["2-s2.0-85170295101"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-6844cce5-43a7-47b2-9cbd-63a6d4fdd7d9","sdu-6a9f2bab-db00-4264-b5d1-5cc11d8b583c"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"High dose dexamethasone in high pain responders undergoing total hip arthroplasty : A randomized controlled trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-088.46-742323","year":"2023","yearsub":"2023"}
{"abstract":"Pain after total knee arthroplasty (TKA) is a well-known clinical problem potentially delaying ambulation and recovery. Perioperative glucocorticoids reduce pain and facilitate early recovery, but the optimal timing and dose are still unknown. High pain catastrophizers have an increased risk of poorly controlled postoperative pain, and moderate to severe pain at 24 h is associated with a risk of pain relapse at 48 h. To evaluate the effect of a repeat moderate dose of glucocorticoids after TKA in high pain catastrophizers presenting with moderate to severe pain 24 h postoperatively, having received preoperative high-dose glucocorticoids. High pain catastrophizers (Pain Catastrophizing Scale > 20) undergoing TKA are screened 24 h postoperatively and are included if they experience moderate to severe pain (VAS > 30) during a 5 m walk test. The included patients will receive either oral 24 mg dexamethasone (n = 55) or placebo (n = 55) on the evening of Day 1 (~30–37 h) after surgery. In addition, patients receive a standard multimodal analgesic regimen, including paracetamol, celecoxib, local infiltration analgesia, and preoperative dexamethasone (1 mg/kg). Patients will fill out a pain diary for 7 days after surgery. The primary outcome is moderate to severe pain (VAS > 30) during a 5 m walk test on the morning of Day 2 after surgery. The secondary outcomes include cumulated pain at rest and during ambulation, cumulated use of rescue analgesics, quality of sleep, lethargy, dizziness, nausea, satisfaction with the analgesic regimen, length of stay, morbidity, mortality, and reasons for readmissions. Follow-up is at 8 and 30 days. The data from this study will provide evidence for the effect of a repeated dose of dexamethasone as an analgesic adjuvant in patients undergoing TKA with a high risk of postoperative pain.","author_count":10,"contributors":["Springborg, Anders H.","Varnum, Claus","Nielsen, Niklas I.","Rasmussen, Lasse Enkebølle","Kjærsgaard-Andersen, Per","Pleckaitiene, Lina","Gromov, Kirill","Troelsen, Anders","Kehlet, Henrik","Foss, Nicolai B."],"cuid":["S02-088.93-673189"],"filters":{"added":"2023-06","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Springborg, Anders H."],"keyword":["Analgesics Opioid","Analgesics therapeutic use","Arthroplasty Replacement Knee adverse effects","Dexamethasone","Dexamethasone therapeutic use","Double Blind Method","Glucocorticoids","Glucocorticoids therapeutic use","Humans","Pain Postoperative drug therapy","Pain catastrophizing scale","Postoperative pain","Protocol","Randomized Controlled Trial","Total knee arthroplasty","high pain responders"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-SDR","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"repeat dose steroid in high pain responders after total knee arthroplasty a study protocol","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/340548658/IKM_Acta_Anaesthesiol_Scand_2023_Springborg_Repeat_dose_steroid_in_high_pain_responders_after_total_knee_arthroplasty_A.pdf","version":"Authors Final Version"},"id":"S02-088.93-673189","identifier":[{"id":"36695403","type":"pmid"},{"id":"85147432376","type":"scopus"}],"ids":["ku-fc4c6dc3-d477-4c24-8b02-10f9bc6683fa","sdu-8e4e782b-5dba-41c9-b9b2-5eda2524d9df"],"keyword":["Analgesics, Opioid","Analgesics/therapeutic use","Arthroplasty, Replacement, Knee/adverse effects","Dexamethasone/therapeutic use","Double-Blind Method","Glucocorticoids/therapeutic use","Humans","Pain Catastrophizing Scale","Pain, Postoperative/drug therapy","dexamethasone","glucocorticoids","high pain responders","postoperative 