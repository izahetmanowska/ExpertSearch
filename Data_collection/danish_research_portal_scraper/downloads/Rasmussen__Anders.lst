{"abstract":"We use register data of 88,948 sick-listed workers in Denmark over the period 2008–2011 to investigate the effect of active labor market programs on the duration until returning to non-subsidized employment and the duration of this employment. To identify causal treatment effects, we exploit over-time variation in the use of active labor market programs in 98 job centers and time-to- event. We find that ordinary education and subsidized job training have significant positive employment effects. Subsidized job training has a large, positive effect on the transition into employment but no effect on the subsequent employment duration. In contrast, ordinary education has a positive effect on employment duration but no effect on the transition into employment. The latter effect is the result of two opposing effects, a large positive effect of having completed education and a large negative lock-in effect, with low re-employment chances during program participation.","author_count":7,"contributors":["Høgelund, Jan","Holm, Anders","Gørtz, Mette","Houlberg, Helle Sophie Bøje","Rasmussen, Kristin Storck"],"cuid":["S02-090.14-666965"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["America, North","OECD"],"country":["Canada"],"glorg":["All Global Affiliations","University of Western Ontario","Western University"],"keyword":["Active labor market programs","Effect evaluation","Employment","Faculty of Social Sciences","Hazard rate model","Return to work","Sick Leave"],"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-OT","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-VIVE","DI-GV-WORK"],"OT":["The Danish Working Environment Agency"],"U":["DI-U-ALL","DI-U-KU","DI-U-UND"]},"level3all":["DI-GV-VIVE","DI-GV-WORK","DI-U-KU","DI-U-UND"]},"review":"pr","rtype":["clu"],"sorti":"employment effects of active labor market measures for sick listed workers","src":["ku","vive"],"src-code":["DI-GV-VIVE","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85011685138","version":"Other Version"},"id":"S02-090.14-666965","identifier":[{"id":"28182999","type":"pmid"},{"id":"85011685138","type":"scopus"}],"ids":["ku-cbcab366-2cd5-402c-ab0c-326898682513","vive-eb73feef-d35f-49fe-b7a7-7932d77890d4"],"keyword":["Active labor market programs","Effect evaluation","Employment","Faculty of Social Sciences","Hazard rate model","Return to work","Sick leave","active labor market measure; effect evaluation; employment; hazard rate model; sick leave; return to work;"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-5-36198C9CC5A965529E1094FB25EA1021"],"oai":{"class":"Blocked","mra":["Social Science (SOC)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","country":"dk","key":"nfa national research centre for the working environment","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-WORK","l3nn":"NFA National Research Centre for the Working Environment","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"NFA National Research Centre for the Working Environment","namevar":["Arbejdstilsynet"],"nora_code":"DI-GV-WORK","used":1},{"affno":"2","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["The Danish Working Environment Agency"],"nora_code":"DI-OT","used":1},{"affno":"3","country":"ca","key":"university of western ontario","loc":["Canada","America, North","OECD"],"name":"University of Western Ontario","used":1},{"affno":"4","country":"ca","key":"western university","loc":["Canada","America, North","OECD"],"name":"Western University","used":1},{"affno":"5","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Social Sciences, Department of Economics"],"nora_code":"DI-U-KU","used":1},{"affno":"6","country":"dk","key":"unclear universities","l2":"DI-U","l2n":"Universities","l3":"DI-U-UND","l3nl":"Undetermined","l3nn":"Unclear Universities","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Unclear Universities","namevar":["Økonomisk Institut","Økonomisk Studienævn"],"nora_code":"DI-U-UND","used":1},{"affno":7,"key":"vive the danish center for social science research","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-VIVE","l3nn":"VIVE The Danish Center for Social Science Research","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"VIVE The Danish Center for Social Science Research","namevar":["The Danish National Institute for Social Research, Employment, Education and Social Inclusion"],"nora_code":"DI-GV-VIVE"}],"person":[{"affno":"1 2","corresponding":null,"first":"Jan","key":"høgelundpau","last":"Høgelund","name":"Høgelund, Jan","rank":1,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Anders","key":"holmpau","last":"Holm","name":"Holm, Anders","rank":2,"rolecode":"pau"},{"affno":"5 6","first":"Mette","key":"gørtzpau","last":"Gørtz","locid":"4a0123d6-f3e8-41fe-88c7-cf2226b8ecca","name":"Gørtz, Mette","orcid":"0000-0002-9346-0625","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Helle Sophie Bøje","key":"houlbergpau","last":"Houlberg","locid":"dab3d5fb-ec7c-4c16-896c-4d8030051454","name":"Houlberg, Helle Sophie Bøje","rank":4,"rolecode":"pau"},{"affno":"","first":"Kristin","key":"storckrasmussenpau","last":"Storck Rasmussen","name":"Storck Rasmussen, Kristin","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Kristin Storck","key":"rasmussenpau","last":"Rasmussen","locid":"7c508a0a-72a7-4ed2-963a-603c04127d7b","name":"Rasmussen, Kristin Storck","rank":5,"rolecode":"pau"},{"affno":"2","first":"Helle","key":"sofiebøjehoulbergpau","last":"Sofie Bøje Houlberg","name":"Sofie Bøje Houlberg, Helle","rank":5,"rolecode":"pau"}],"pmid":["28182999"],"pub":{"doi":"10.1016/j.jhealeco.2017.01.006","issn":["01676296"],"journal":"Journal of Health Economics","pages":"33-44","publisher":"Elsevier","status":"p","title":"Journal of Health Economics","title_org":"Journal of health Economics","volume":"52"},"review":"Peer Reviewed","scoID":["2-s2.0-85011685138"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Miscellaneous","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Governmental Institutions","Miscellaneous","Other Research","Undetermined","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-cbcab366-2cd5-402c-ab0c-326898682513","vive-eb73feef-d35f-49fe-b7a7-7932d77890d4"],"src":["KU University of Copenhagen","VIVE The Danish Center for Social Science Research"],"title":"Employment effects of active labor market measures for sick-listed workers","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-090.14-666965","year":"2017","yearsub":"2017"}
{"abstract":"Aim The aim of this study is to evaluate the extent of myocardial injury by cardiac biomarkers during prolonged targeted temperature management of 24 hours vs 48 hours after out-of-hospital cardiac arrest. Methods This randomized Scandinavian multicenter study compares the extent of myocardial injury quantified by area under the curve (AUC) of cardiac biomarkers during prolonged targeted temperature management at 33°C ± 1°C of 24 hours and 48 hours, respectively. Through a period of 2.5 years, 161 comatose out-of-hospital cardiac arrest patients were randomized to targeted temperature management for 24 hours (n = 77) or 48 hours (n = 84). The AUC was calculated using both high-sensitivity cardiac troponin T (hs-cTnT AUC) and creatine kinase-myocardial band (CK-MB AUC) that were based upon measurements of these biomarkers every 6 hours upon admission until 96 hours after reaching target temperature. Results The median hs-cTnT AUC of 33,827 ng/L/h (interquartile range [IQR] 11,366-117,690) of targeted temperature management at 24 hours did not differ significantly from that of 28,973 ng/L/h (IQR 10,656-163,655) at 48 hours. In contrast, the median CK-MB AUC of 1829 μg/L/h (IQR 800-6799) during targeted temperature management at 24 hours was significantly lower than that of 2428 μg/L/h (IQR 1163-10,906) within targeted temperature management at 48 hours, P <.05. Conclusion This study of comatose out-of-hospital cardiac arrest survivors showed no difference between the extents of myocardial injury estimated by hs-cTnT AUC of prolonged targeted temperature management of 48 hours vs 24 hours, although the CK-MB AUC was significantly higher during 48 hours vs 24 hours. Hence, it seems unlikely that the duration of targeted temperature management has a beneficial effect on the extent of myocardial injury after out-of-hospital cardiac arrest, and may even have a worsening effect.","author_count":9,"contributors":["Grejs, Anders Morten","Gjedsted, Jakob","Thygesen, Kristian","Lassen, Jens Flensted","Rasmussen, Bodil Steen","Jeppesen, Anni Nørgaard","Duez, Christophe","Søreide, Eldar","Kirkegaard, Hans"],"cuid":["S02-097.64-006914"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Body Temperature Regulation","CK MB","Heart Arrest","Out of hospital cardiac arrest","Targeted temperature management","Troponin T"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"the extent of myocardial injury during prolonged targeted temperature management after out of hospital cardiac arrest","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84994131510","version":"Other Version"},"id":"S02-097.64-006914","identifier":[{"id":"84994131510","type":"scopus"},{"id":"27477668","type":"pmid"},{"id":"000392621500025","type":"wos"}],"ids":["aau-8eaf2b89-472e-4468-9e08-8f8c6e61b726","au-3615261c-674b-4eb3-af2c-c08e3bbd5270"],"keyword":["Body temperature regulation","CK-MB","Heart arrest","Induced mild hypothermia","Out-of-hospital cardiac arrest","Targeted temperature management","Troponin T"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-B7F1EB2A84FA5AA0059A7FA9E9EDB0C5"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Anæstesiologisk afdeling, SKS","Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Research Center for Emergency Medicine"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Anæstesi og Intensiv [Klinik Akut]","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Akut","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Anders Morten","key":"grejspau","last":"Grejs","locid":"5566be9c-2b0c-484c-aab2-e82ede0fde19","name":"Grejs, Anders Morten","orcid":"0000-0002-8850-2982","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jakob","key":"gjedstedpau","last":"Gjedsted","locid":"0a2e31a3-575a-4fc3-adfb-16065463de5a","name":"Gjedsted, Jakob","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kristian","key":"thygesenpau","last":"Thygesen","locid":"8cd44585-4dec-4ca6-8f5e-644f63fba330","name":"Thygesen, Kristian","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jens Flensted","key":"lassenpau","last":"Lassen","name":"Lassen, Jens Flensted","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Bodil Steen","key":"rasmussenpau","last":"Rasmussen","locid":"3162c449-94c3-4d28-8dbb-c134d6eb76e1","name":"Rasmussen, Bodil Steen","orcid":"0000-0003-2190-145X","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anni Nørgaard","key":"jeppesenpau","last":"Jeppesen","locid":"dfd79e06-3eec-4851-9ca9-96ac6abcb7d1","name":"Jeppesen, Anni Nørgaard","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christophe Henri Valdemar","key":"duezpau","last":"Duez","locid":"c83d9eab-d5e9-4efd-9525-2f8a2c35c52b","name":"Duez, Christophe Henri Valdemar","orcid":"0000-0001-7560-9214","rank":7,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Eldar","key":"søreidepau","last":"Søreide","name":"Søreide, Eldar","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Hans","key":"kirkegaardpau","last":"Kirkegaard","locid":"911be177-8ade-45ff-93ef-6f631e537119","name":"Kirkegaard, Hans","rank":9,"rolecode":"pau"}],"pmid":["27477668"],"pub":{"doi":"10.1016/j.amjmed.2016.06.047","issn":["00029343","02105713"],"issn_org":["00029343"],"issue":"1","journal":"American Journal of Medicine","pages":"37-46","publisher":"Elsevier Inc.","status":"p","title":"American Journal of Medicine","title_org":"The American Journal of Medicine","volume":"130"},"review":"Peer Reviewed","scoID":["2-s2.0-84994131510"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-8eaf2b89-472e-4468-9e08-8f8c6e61b726","au-3615261c-674b-4eb3-af2c-c08e3bbd5270"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"The Extent of Myocardial Injury During Prolonged Targeted Temperature Management After Out-of-Hospital Cardiac Arrest","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-097.64-006914","year":"2017","yearsub":"2017"}
{"abstract":"BACKGROUND: Nearly one in 5 patients with ischemic stroke will invariably experience a second stroke within 5 years. Stroke risk stratification schemes based solely on clinical variables perform only modestly in non-atrial fibrillation (AF) patients and improvement of these schemes will enhance their clinical utility. Cerebral white matter hyperintensities are associated with an increased risk of incident ischemic stroke in the general population, whereas their association with the risk of ischemic stroke recurrence is more ambiguous. In a non-AF stroke cohort, we investigated the association between cerebral white matter hyperintensities and the risk of recurrent ischemic stroke, and we evaluated the predictive performance of the CHA2DS2VASc score and the Essen Stroke Risk Score (clinical scores) when augmented with information on white matter hyperintensities. METHODS: In a registry-based, observational cohort study, we included 832 patients (mean age 59.6 (SD 13.9); 42.0% females) with incident ischemic stroke and no AF. We assessed the severity of white matter hyperintensities using MRI. Hazard ratios stratified by the white matter hyperintensities score and adjusted for the components of the CHA2DS2VASc score were calculated based on the Cox proportional hazards analysis. Recalibrated clinical scores were calculated by adding one point to the score for the presence of moderate to severe white matter hyperintensities. The discriminatory performance of the scores was assessed with the C-statistic. RESULTS: White matter hyperintensities were significantly associated with the risk of recurrent ischemic stroke after adjusting for clinical risk factors. The hazard ratios ranged from 1.65 (95% CI 0.70-3.86) for mild changes to 5.28 (95% CI 1.98-14.07) for the most severe changes. C-statistics for the prediction of recurrent ischemic stroke were 0.59 (95% CI 0.51-0.65) for the CHA2DS2VASc score and 0.60 (95% CI 0.53-0.68) for the Essen Stroke Risk Score. The recalibrated clinical scores showed improved C-statistics: the recalibrated CHA2DS2VASc score 0.62 (95% CI 0.54-0.70; p = 0.024) and the recalibrated Essen Stroke Risk Score 0.63 (95% CI 0.56-0.71; p = 0.031). C-statistics of the white matter hyperintensities score were 0.62 (95% CI 0.52-0.68) to 0.65 (95% CI 0.58-0.73). CONCLUSIONS: An increasing burden of white matter hyperintensities was independently associated with recurrent ischemic stroke in a cohort of non-AF ischemic stroke patients. Recalibration of the CHA2DS2VASc score and the Essen Stroke Risk Score with one point for the presence of moderate to severe white matter hyperintensities led to improved discriminatory performance in ischemic stroke recurrence prediction. Risk scores based on white matter hyperintensities alone were at least as accurate as the established clinical risk scores in the prediction of ischemic stroke recurrence.","author_count":6,"contributors":["Andersen, Søren Due","Larsen, Torben Bjerregaard","Gorst-Rasmussen, Anders","Yavarian, Yousef","Lip, Gregory Y H","Bach, Flemming W"],"cuid":["S02-100.00-002142"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","City Hospital in Birmingham","University of Birmingham"],"keyword":["Ischemic stroke","Magnetic Resonance Imaging","Prognosis","Risk stratification","White matter hyperintensities"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-HO-CDR","DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"white matter hyperintensities improve ischemic stroke recurrence prediction","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84991821307","version":"Other Version"},"id":"S02-100.00-002142","identifier":[{"id":"27750251","type":"pmid"},{"id":"000394585600004","type":"wos"},{"id":"84991821307","type":"scopus"}],"ids":["aau-2aabc3c9-27d2-45fc-b257-9633b0303796","au-b832aadf-dc80-466c-b6e0-8fc0f05f850a"],"keyword":["Ischemic stroke","Magnetic resonance imaging","Prognosis","Risk stratification","White matter hyperintensities"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-3CF5DBE4F0EBF54F9999CDEA88A3F093"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Neurology","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Hoved-Orto","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine, Aalborg Thrombosis Research Unit"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"gb","key":"university of birmingham","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Birmingham","used":1},{"affno":"3","country":"gb","key":"city hospital in birmingham","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"City Hospital in Birmingham","used":1},{"affno":"4","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1},{"affno":"5","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Neurology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Søren Due","key":"andersenpau","last":"Andersen","locid":"2cedb454-848a-46cf-b759-b24b7ea59428","name":"Andersen, Søren Due","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Torben Bjerregaard","key":"larsenpau","last":"Larsen","locid":"a3c6747f-b9db-488b-8eb9-887d38742880","name":"Larsen, Torben Bjerregaard","orcid":"0000-0002-8485-8674","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders","key":"gorstrasmussenpau","last":"Gorst-Rasmussen","locid":"2aa85786-c0b1-42ec-93d4-eb7a75696409","name":"Gorst-Rasmussen, Anders","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yousef","key":"yavarianpau","last":"Yavarian","locid":"cbc591ff-b764-4cf8-8f30-04738eebda05","name":"Yavarian, Yousef","orcid":"0009-0002-0508-3231","rank":4,"rolecode":"pau"},{"affno":"1 2 3","corresponding":null,"country":"dk","first":"Gregory Y H","key":"lippau","last":"Lip","locid":"8fa30e84-7381-41b4-8037-afc032238a3d","name":"Lip, Gregory Y H","rank":5,"rolecode":"pau"},{"affno":"1 4 5","corresponding":null,"country":"dk","first":"Flemming W","key":"bachpau","last":"Bach","locid":"fac1afeb-8889-46a7-8c8a-da75196d8d74","name":"Bach, Flemming W","rank":6,"rolecode":"pau"}],"pmid":["27750251"],"pub":{"doi":"10.1159/000450962","issn":["10159770","14219786"],"issn_org":["10159770"],"issue":"1-2","journal":"Cerebrovascular Diseases","pages":"17-24","publisher":"S. Karger AG","status":