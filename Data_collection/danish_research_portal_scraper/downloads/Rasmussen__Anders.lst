{"abstract":"Hypopituitarism is associated with an increased mortality rate but the reasons underlying this have not been fully elucidated. The purpose of this study was to evaluate mortality and associated factors within a large GH-replaced population of hypopituitary patients.","author_count":11,"contributors":["Gaillard, Rolf C","Mattsson, Anders F","Akerblad, Ann-Charlotte","Bengtsson, Bengt-Åke","Cara, José","Feldt-Rasmussen, Ulla","Koltowska-Häggström, Maria","Monson, John P","Saller, Bernhard","Wilton, Patrick","Abs, Roger"],"cuid":["S01-000.00-442558"],"filters":{"added":"2022-04","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"overall and cause specific mortality in gh deficient adults on gh replacement","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1530/EJE-11-1028","version":"Other Version"},"id":"S01-000.00-442558","identifier":[{"id":"22457236","type":"pmid"},{"id":"84862729479","type":"scopus"}],"ids":["ku-5244191b-a606-42b1-a2fc-c3bbff19d97b"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-412D2290A68679529C0D10CAD455E2B5"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1530/EJE-11-1028","version":"Other Version"}],"org":[{"affno":1,"key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Section of Orthopaedics and Internal Medicine"],"nora_code":"DI-U-KU"}],"person":[{"affno":""