{"abstract":"Diets rich in n-3 long chain polyunsaturated fatty acids (LC-PUFA), but low in n-6 LC-PUFA and 18:1 trans-fatty acids (TFA), may lower the risk of overweight and obesity. These fatty acids have often been investigated individually. We explored associations between global patterns in adipose tissue fatty acids and changes in anthropometry.","author_count":7,"contributors":["Dahm, Christina Catherine","Gorst-Rasmussen, Anders","Jakobsen, Marianne Uhre","Schmidt, Erik Berg","Tjønneland, Anne","Sørensen, Thorkild I A","Overvad, Kim"],"cuid":["S01-000.00-446042"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-UND"]},"level3all":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-UND"]},"review":"pr","rtype":["clu"],"sorti":"adipose tissue fatty acid patterns and changes in anthropometry a cohort study","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1371/journal.pone.0022587","version":"Other Version"},"id":"S01-000.00-446042","identifier":[{"id":"79960626659","type":"scopus"},{"id":"21811635","type":"pmid"},{"id":"PMC3141072","type":"pmcid"}],"ids":["ku-57f8c3c3-8dc1-4be7-8185-fd308f904a7d"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-3-6-DBA88CFD0DA4904081308438A172DD6E"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1371/journal.pone.0022587","version":"Other Version"}],"org":[{"affno":"1","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country