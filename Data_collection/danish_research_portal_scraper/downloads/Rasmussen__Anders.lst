ocid":"3de90fc5-c918-4f97-867b-b5156da45264","name":"Jakobsen, Rasmus","rank":28,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Stig Asbjørn Schack","key":"pedersenstigasbjørnschackpau","last":"Pedersen","name":"Pedersen, Stig Asbjørn Schack","rank":29,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Tine B.","key":"larsentinebpau","last":"Larsen","name":"Larsen, Tine B.","rank":30,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Trine","key":"dahljensentrinepau","last":"Dahl Jensen","name":"Dahl Jensen, Trine","rank":31,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Troels","key":"laiertroelspau","last":"Laier","name":"Laier, Troels","rank":32,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Hans","key":"sandersonhanspau","last":"Sanderson","name":"Sanderson, Hans","rank":33,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Annette","key":"baattruppedersenannettepau","last":"Baattrup-Pedersen","name":"Baattrup-Pedersen, Annette","rank":34,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Anne","key":"windingannepau","last":"Winding","name":"Winding, Anne","rank":35,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Gregor","key":"levingregorpau","last":"Levin","name":"Levin, Gregor","rank":36,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jes","key":"jessenrasmussenjespau","last":"Jessen Rasmussen","name":"Jessen Rasmussen, Jes","rank":37,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Kim","key":"gustavsonkimpau","last":"Gustavson","name":"Gustavson, Kim","rank":38,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Pia","key":"frederiksenpiapau","last":"Frederiksen","name":"Frederiksen, Pia","rank":39,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Artistic Higher Education Institutions","All Danish Affiliations","Artistic Higher Education Institutions","DI-ALL","DI-ART","DI-ART-ALL"],"PST":["Published"]},