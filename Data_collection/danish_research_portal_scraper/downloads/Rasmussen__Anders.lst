],"name":"AU Aarhus University","namevar":["Institut for Kultur og Samfund - Antropologi og Etnografi, fag (Moesgård)"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","first":"Tim Flohr","key":"sørensenpau","last":"Sørensen","locid":"89cb27fb-ea96-4323-a9fd-e3e07ddae445","name":"Sørensen, Tim Flohr","orcid":"0000-0003-2473-6963","rank":1,"rolecode":"pau"},{"affno":"2","first":"Peter","key":"bjerregaardpau","last":"Bjerregaard","name":"Bjerregaard, Peter","rank":2,"rolecode":"pau"},{"affno":"3","first":"Anders Emil","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Anders Emil","rank":3,"rolecode":"pau"},{"affno":"","first":"Tim Flohr","key":"sørensenpedh","last":"Sørensen","name":"Sørensen, Tim Flohr","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Peter","key":"bjerregaardpedh","last":"Bjerregaard","name":"Bjerregaard, Peter","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Anders Emil","key":"rasmussenpedh","last":"Rasmussen","name":"Rasmussen, Anders Emil","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9781472441973"],"pages":"1-23","place":"London","publisher":"Routledge","series":"Studies in Death, Materiality and the Origin of Time","status":"p","title":"Materialities of Passing: Transformation, transition and transience"},"review":"Peer Reviewed","scoID":["2-s2.0-85062629965"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-6c23fd7e-ddbe-415e-aaac-1b7ce7feb2a9"],"src":["KU University of Copenhagen"],"title":"Introducing Materialities of Passing","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-458025","year":"2016","yearsub":"2016"}
{"abstract":"OBJECTIVE: Development of posttransplantation diabetes (PTDM) is characterized by reduced insulin secretion and sensitivity. We aimed to investigate whether hyperglucagonemia could play a role in PTDM and to examine the insulinotropic and glucagonostatic effects of the incretin hormone glucagon-like peptide 1 (GLP-1) during fasting and hyperglycemic conditions, respectively. RESEARCH DESIGN AND METHODS: Renal transplant recipients with (n = 12) and without (n = 12) PTDM underwent two separate experimental days with 3-h intravenous infusions of GLP-1 (0.8 pmol/kg/min) and saline, respectively. After 1 h of infusion, a 2-h hyperglycemic clamp (fasting plasma glucose + 5 mmol/L) was established. Five grams of arginine was given as an intravenous bolus 10 min before termination of the clamp. RESULTS: Fasting concentrations of glucagon (P = 0.92) and insulin (P = 0.23) were similar between the groups. In PTDM patients, glucose-induced glucagon suppression was significantly less pronounced (maximal suppression from baseline: 43 ± 12 vs. 65 ± 12%, P < 0.001), while first- and second-phase insulin secretion were significantly lower. The PTDM group also exhibited a significantly lower insulin response to arginine (P = 0.01) but similar glucagon and proinsulin responses compared with control subjects. In the preclamp phase, GLP-1 lowered fasting plasma glucose to the same extent in both groups but reduced glucagon only in PTDM patients. During hyperglycemic clamp, GLP-1 reduced glucagon concentrations and increased first- and second-phase insulin secretion in both groups. CONCLUSIONS: PTDM is characterized by reduced glucose-induced insulin secretion and attenuated glucagon suppression during a hyperglycemic clamp. Similar to the case in type 2 diabetes, GLP-1 infusion seems to improve (insulin) or even normalize (glucagon) these pathophysiological defects.","author_count":11,"contributors":["Halden, Thea A S","Egeland, Erlend J","Åsberg, Anders","Hartmann, Anders","Midtvedt, Karsten","Khiabani, Hassan Z","Holst, Jens Juul","Knop, Filip K.","Hornum, Mads","Feldt-Rasmussen, Bo","Jenssen, Trond"],"cuid":["S01-000.00-475533"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"glp 000000000001 restores altered insulin and glucagon secretion in posttransplantation diabetes","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-475533","identifier":[{"id":"84962074751","type":"scopus"},{"id":"26908914","type":"pmid"}],"ids":["ku-893d115c-af33-4271-8e36-c25d4b27ad50"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-33118D4E2E1A384FF078FF0A66894E9F"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Basic Metabolic Research, NNF Center for Basic Metabolic Research"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Thea A S","key":"haldenpau","last":"Halden","name":"Halden, Thea A S","rank":1,"rolecode":"pau"},{"affno":"","first":"Erlend J","key":"egelandpau","last":"Egeland","name":"Egeland, Erlend J","rank":2,"rolecode":"pau"},{"affno":"","first":"Anders","key":"åsbergpau","last":"Åsberg","name":"Åsberg, Anders","rank":3,"rolecode":"pau"},{"affno":"","first":"Anders","key":"hartmannpau","last":"Hartmann","name":"Hartmann, Anders","rank":4,"rolecode":"pau"},{"affno":"","first":"Karsten","key":"midtvedtpau","last":"Midtvedt","name":"Midtvedt, Karsten","rank":5,"rolecode":"pau"},{"affno":"","first":"Hassan Z","key":"khiabanipau","last":"Khiabani","name":"Khiabani, Hassan Z","rank":6,"rolecode":"pau"},{"affno":"1","first":"Jens J","key":"holstpau","last":"Holst","locid":"864b6401-9024-4773-9bdb-f4d4ca57dcad","name":"Holst, Jens Juul","name_org":"Holst, Jens J","orcid":"0000-0001-6853-3805","rank":7,"rolecode":"pau"},{"affno":"1","first":"Filip K","key":"knoppau","last":"Knop","locid":"ce6eaad9-59f8-4ecf-8a1e-388a74734f6a","name":"Knop, Filip K.","name_org":"Knop, Filip K","rank":8,"rolecode":"pau"},{"affno":"1","first":"Mads","key":"hornumpau","last":"Hornum","locid":"6e7135d6-13c5-4f40-a3da-e8adf896bc7d","name":"Hornum, Mads","rank":9,"rolecode":"pau"},{"affno":"1","first":"Bo","key":"feldtrasmussenpau","last":"Feldt-Rasmussen","locid":"cdd06e7b-83c5-4118-8808-eb4591586aac","name":"Feldt-Rasmussen, Bo","rank":10,"rolecode":"pau"},{"affno":"","first":"Trond","key":"jenssenpau","last":"Jenssen","name":"Jenssen, Trond","rank":11,"rolecode":"pau"}],"pmid":["26908914"],"pub":{"doi":"10.2337/dc15-2383","issn":["01495992"],"journal":"Diabetes Care","pages":"617-24","status":"p","title":"Diabetes Care","volume":"39"},"review":"Peer Reviewed","scoID":["2-s2.0-84962074751"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-893d115c-af33-4271-8e36-c25d4b27ad50"],"src":["KU University of Copenhagen"],"title":"GLP-1 Restores Altered Insulin and Glucagon Secretion in Posttransplantation Diabetes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-475533","year":"2016","yearsub":"2016"}
