rolecode":"pau"}],"pmid":["33636121"],"pub":{"doi":"10.1016/j.cub.2021.01.064","issn":["09609822","18790445"],"issn_org":["09609822"],"issue":"9","journal":"Current Biology","status":"p","title":"Current Biology","volume":"31"},"review":"Peer Reviewed","scoID":["2-s2.0-85105271860"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-b512c4f1-c54e-4bb9-bda4-b59284d9dd5e"],"src":["KU University of Copenhagen"],"title":"High genetic diversity and low differentiation reflect the ecological versatility of the African leopard","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-501590","year":"2021","yearsub":"2021"}
{"abstract":"Background Total thyroidectomy is a necessary surgical procedure in some cases of thyroid carcinomas (1) and an attractive method as alternative treatment of benign toxic and nontoxic multinodular goiters (2) and some cases of Graves’ disease (e.g., in young females of childbearing age with poorly controlled Graves’ disease or patients with Graves’ orbitopathy) (3,4). However, the risk of surgical complications is important, and the most serious ones in the long term, although rare, are permanent paralysis of the laryngeal nerve(s) and hypoparathyroidism (5,6). One important approach to preserve the function of parathyroid glands during thyroidectomy and to prevent postoperative hypocalcemia is assessment of parathyroid gland vascularity. Laser speckle contrast imaging (LSCI) has been shown to be accurate in detecting differences in parathyroid vascularity (7). The purpose of this surgeon-blinded prognostic study was to evaluate the relationship between intraoperative LSCI measurements and postoperative parathyroid outcomes of patients who undergo total thyroidectomy (8). Methods A total of 72 patients were included (58 total thyroidectomy alone, 10 total thyroidectomy with lymph node dissection, 4 completion thyroidectomy). An LSCI device was used to image all identified parathyroid glands, and a speckle contrast value was calculated as an average value for each patient; the data were grouped according to whether the patient had normal or low concentrations of serum parathyroid hormone (PTH) on postoperative day 1 (POD1). The surgeon's visual assessment of each parathyroid gland was recorded into categories: well vascularized, compromised, and devascularized (subsequently autotransplanted). Parathyroid LSCIs were grouped according to these classifications and assessed by one-way analysis of variance. Patients with POD1 PTH below the accepted normal range were evaluated up to 6 months postoperatively to assess for recovery within that period. Results A speckle contrast limit of 0.186 separated the normal parathyroid and hypoparathyroid groups with 87.5% sensitivity and 84.4% specificity: 7 of 8 patients with low PTH concentration on POD1 had an average parathyroid speckle contrast above this limit, while 54 of 64 patients with a normal postoperative PTH concentration had an average parathyroid speckle contrast below this limit. Taking this value as the threshold for adequate parathyroid perfusion, it was determined that only one vascularized gland was needed for normal postoperative parathyroid function: 64 of 69 patients (92.8%) with at least one vascularized gland (determined by LSCI) had normal postoperative PTH values, while all 3 patients (100%) with no vascularized glands had low postoperative PTH values. Overall, the rates of temporary and permanent hypoparathyroidism in this study were 8.3% and 1.4%, respectively. Conclusions LSCI is a promising technique for assessing parathyroid gland vascularity. It has the potential to help reduce the incidence of hypocalcemia after thyroidectomy by providing surgeons with additional information during surgery to aid in the preservation of parathyroid function.","author_count":4,"contributors":["Feldt-Rasmussen, Ulla","Lykke, Eva","Christensen, Anders","von Buchwald, Christian"],"cuid":["S01-000.00-509331"],"filters":{"added":"2022-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"surgical preservation of parathyroid function during total thyroidectomy can be improved by intraoperative imaging","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-509331","ids":["ku-c21e84f5-04d6-465d-951c-de547dcd6599"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-1EF4418644E2AF1281CC70AD0C76BC5D"],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal Medicine: Endocrinology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Ulla","key":"feldtrasmussenpau","last":"Feldt-Rasmussen","locid":"b5898535-d448-4e2f-9f41-d5199873676b","name":"Feldt-Rasmussen, Ulla","rank":1,"rolecode":"pau"},{"affno":"1","first":"Eva","key":"lykkepau","last":"Lykke","locid":"dfeb73f1-a704-4e43-8429-93aa7c6d1e1d","name":"Lykke, Eva","rank":2,"rolecode":"pau"},{"affno":"1","first":"Anders","key":"christensenpau","last":"Christensen","locid":"c4fc2962-72f2-4db6-a758-a762332e496f","name":"Christensen, Anders","rank":3,"rolecode":"pau"},{"affno":"1","first":"Christian","key":"vonbuchwaldpau","last":"von Buchwald","locid":"fc76b0d1-1263-48f7-a4d0-685e60bbc1b6","name":"von Buchwald, Christian","orcid":"0000-0001-6753-8129","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1089/ct.2021;33.456-458","issn":["23299711","2329972X"],"issn_org":["23299711"],"issue":"10","journal":"Clinical Thyroidology","pages":"456-458","status":"p","title":"Clinical Thyroidology","volume":"33"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-c21e84f5-04d6-465d-951c-de547dcd6599"],"src":["KU University of Copenhagen"],"title":"Surgical Preservation of Parathyroid Function During Total Thyroidectomy Can Be Improved by Intraoperative Imaging","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-509331","year":"2021","yearsub":"2021"}
{"abstract":"Understanding N budgets of tundra ecosystems is crucial for projecting future changes in plant community composition, greenhouse gas balances and soil N stocks. Winter warming can lead to higher tundra winter nitrogen (N) mineralization rates, while summer warming may increase both growing season N mineralization and plant N demand. The undulating tundra landscape is inter-connected through water and solute movement on top of and within near-surface soil, but the importance of lateral N fluxes for tundra N budgets is not well known. We studied the size of lateral N fluxes and the fate of lateral N input in the snowmelt period with a shallow thaw layer, and in the late growing season with a deeper thaw layer. We used 15N to trace inorganic lateral N movement in a Low-arctic mesic tundra heath slope in West Greenland and to quantify the fate of N in the receiving area. We found that half of the early-season lateral N input was retained by the receiving ecosystem, whereas half was transported downslope. Plants appear as poor utilizers of early-season N, indicating that higher winter N mineralization may influence plant growth and carbon (C) sequestration less than expected. Still, evergreen plants were better at utilizing early-season N, highlighting how changes in N availability may impact plant community composition. In contrast, later growing season lateral N input was deeper and offered an advantage to deeper-rooted deciduous plants. The measurements suggest that N input driven by future warming at the study site will have no significant impact on the overall N2O emissions. Our work underlines how tundra ecosystem N allocation, C budgets and plant community composition vary in their response to lateral N inputs, which may help us understand future responses in a warmer Arctic.","author_count":7,"contributors":["Rasmussen, Laura Helene","Zhang, Wenxin","Ambus, Per Lennart","Michelsen, Anders","Jansson, Per Erik","Kitzler, Barbara","Elberling, Bo"],"cuid":["S01-000.00-515663"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Austria"],"glorg":["All Global Affiliations","Natural Hazards and Landscape (BFW)"],"keyword":["Arctic tundra","Climate change","Nitrate","Solute transport","Winter N mineralization"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"nitrogen transport in a tundra landscape the effects of early and late growing season lateral n inputs on arctic soil and plant n pools and n sub 000000000002 sub o fluxes","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/305690750/Nitrogen_transport_in_a_tundra_landscape.pdf","version":"Authors Final Version"},"id":"S01-000.00-515663","identifier":[{"id":"85117256432","type":"scopus"}],"ids":["ku-cca66734-f6b3-416b-b30a-120f77e775ad"],"keyword":["Arctic tundra","Climate change","Nitrate","Solute transport","Winter N mineralization"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-6AFCB67F9681E0CE526587FACE193BD0"],"oa_link":[{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/305690750/Nitrogen_transport_in_a_tundra_landscape.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Geosciences and Natural Resource Management, Geography"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"at","key":"natural hazards and landscape","loc":["Austria","Europe, EU","OECD"],"name":"Natural Hazards and Landscape (BFW)","used":1}],"person":[{"affno":"1","first":"Laura H.","key":"rasmussenpau","last":"Rasmussen","locid":"1d17b04f-b957-4a10-977e-3e525b9e3a2d","name":"Rasmussen, Laura Helene","name_org":"Rasmussen, Laura H.","rank":1,"rolecode":"pau"},{"affno":"1","first":"Wenxin","key":"zhangpau","last":"Zhang","locid":"8e3bdbe2-5ccd-45d3-895b-05568ca1b2f6","name":"Zhang, Wenxin","rank":2,"rolecode":"pau"},{"affno":"1","first":"Per","key":"ambuspau","last":"Ambus","locid":"e3fc10b5-9fcd-494b-a3bc-dcfbede40f90","name":"Ambus, Per Lennart","name_org":"Ambus, Per","orcid":"0000-0001-7580-524X","rank":3,"rolecode":"pau"},{"affno":"1","first":"Anders","key":"michelsenpau","last":"Michelsen","locid":"5f62798d-50c6-41c3-8018-18babf5e5046","name":"Michelsen, Anders","orcid":"0000-0002-9541-8658","rank":4,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Per Erik","key":"janssonpau","last":"Jansson","locid":"30098fec-3ff2-415a-ac16-da5e491a362c","name":"Jansson, Per Erik","rank":5,"rolecode":"pau"},{"affno":"2","first":"Barbara","key":"kitzlerpau","last":"Kitzler","name":"Kitzler, Barbara","rank":6,"rolecode":"pau"},{"affno":"1","first":"Bo","key":"elberlingpau","last":"Elberling","locid":"e12e4d80-dea0-424d-82bf-4dc019f65547","name":"Elberling, Bo","orcid":"0000-0002-6023-885X","rank":7,"rolecode":"pau"}],"pub":{"doi":"10.1007/s10533-021-00855-y","issn":["01682563","1573515X"],"issn_org":["01682563"],"journal":"Biogeochemistry","pages":"69-84","status":"p","title":"Biogeochemistry","volume":"157"},"review":"Peer Reviewed","scoID":["2-s2.0-85117256432"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-cca66734-f6b3-416b-b30a-120f77e775ad"],"src":["KU University of Copenhagen"],"title":"Nitrogen transport in a tundra landscape : the effects of early and late growing season lateral N inputs on arctic soil and plant N pools and N<sub>2</sub>O fluxes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-515663","year":"2021","yearsub":"2021"}
{"abstract":"INTRODUCTION: Ovarian hyperstimulation syndrome (OHSS) is one of the major complications of assisted reproductive technology treatment. We assumed that it had declined in recent years owing to the options of new preventive strategies. The aim of the present study was to investigate the annual incidence of OHSS in Denmark in the course of a 17-year period. METHODS: This was a national register-based historical cohort study including all women with an OHSS diagnosis admitted to Danish hospitals between 2001 and 2017. Data included information on all OHSS diagnoses, duration of hospital stay, early pregnancy complications and other complications like thromboembolism and ovarian torsion. The annual number of initiated stimulated in vitro fertilisation (IVF)/intracytoplasmic sperm injection (ICSI) cycles was based on the annual reporting by the Danish Fertility Society. RESULTS: From 2001 to 2017, a total of 2,261 (1.2%) women with an OHSS admission were identified among 186,168 stimulated IVF/ICSI cycles. The annual incidence of OHSS varied from 0.9% to 1.2-1.4% with no overall change over time (p = 0.24. Early OHSS (defined as OHSS without a pregnancy in the cycle) was seen in 48.5% of the events, late OHSS (defined as OHSS with a pregnancy in the cycle) in 51.2% of cycles. Among all women with OHSS, 75% were hospitalised for more than 24 hours, with mean 4.3 and 6.2 days in hospital for early and late OHSS, respectively. CONCLUSIONS: The annual incidence of severe OHSS leading to a hospital admission remained stable for 17 years, which suggests that OHSS preventive actions like use of antagonist cycles, agonist triggering and freeze all should be better implemented in Denmark.","author_count":6,"contributors":["Tomás, Claudia","Colmorn, Lotte","Rasmussen, Steen Christian","Lidegaard, Øjvind","Pinborg, Anja","Andersen, Anders Nyboe"],"cuid":["S01-000.00-536941"],"filters":{"added":"2022-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Portugal"],"glorg":["All Global Affiliations","Hospital Garcia de Orta"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"annual incidence of severe ovarian hyperstimulation syndrome","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://curis.ku.dk/ws/files/304485404/a12190738_web.pdf","version":"Published Version"},"id":"S01-000.00-536941","identifier":[{"id":"85101401114","type":"scopus"},{"id":"33543701","type":"pmid"}],"ids":["ku-f07e03d5-79de-4542-bd72-498ceca62c4f"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-3F6088BAF767782765567ED31ED6C933"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://curis.ku.dk/ws/files/304485404/a12190738_web.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"rem","url":"https://ugeskriftet.dk/dmj/annual-incidence-severe-ovarian-hyperstimulation-syndrome","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"pt","key":"hospital garcia de orta","loc":["Portugal","Europe, EU","OECD"],"name":"Hospital Garcia de Orta","used":1}],"person":[{"affno":"1 2","first":"Claudia","key":"tomáspau","last":"Tomás","name":"Tomás, Claudia","rank":1,"rolecode":"pau"},{"affno":"1","first":"Lotte","key":"colmornpau","last":"Colmorn","name":"Colmorn, Lotte","rank":2,"rolecode":"pau"},{"affno":"1","first":"Steen","key":"rasmussenpau","last":"Rasmussen","locid":"7b6b1b2e-d5ef-46a6-9a39-731acdafc637","name":"Rasmussen, Steen Christian","name_org":"Rasmussen, Steen","rank":3,"rolecode":"pau"},{"affno":"1","first":"Øjvind","key":"lidegaardpau","last":"Lidegaard","locid":"477519a8-a5d9-4dcf-970a-e11c7e4f936f","name":"Lidegaard, Øjvind","rank":4,"rolecode":"pau"},{"affno":"1","first":"Anja","key":"pinborgpau","last":"Pinborg","locid":"28eb0e05-b8d4-4063-9350-54ae5d522ed4","name":"Pinborg, Anja","rank":5,"rolecode":"pau"},{"affno":"1","first":"Anders Nyboe","key":"andersenpau","last":"Andersen","locid":"4b63bd7a-c8eb-4de4-a751-6ed71ba80cb4","name":"Andersen, Anders Nyboe","rank":6,"rolecode":"pau"}],"pmid":["33543701"],"pub":{"issn":["09078916","22451919"],"issn_org":["22451919"],"issue":"2","journal":"Danish Medical Journal","paperid":"A12190738","status":"p","title":"Danish Medical Journal","volume":"68"},"review":"Peer Reviewed","scoID":["2-s2.0-85101401114"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-f07e03d5-79de-4542-bd72-498ceca62c4f"],"src":["KU University of Copenhagen"],"title":"Annual incidence of severe ovarian hyperstimulation syndrome","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-536941","year":"2021","yearsub":"2021"}
