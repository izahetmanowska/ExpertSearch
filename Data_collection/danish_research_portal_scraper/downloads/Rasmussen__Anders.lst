y","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-e1157807-0ce0-478f-b1fb-36f90ee0c2c1","au-9b3b3801-646f-4b0b-8b2d-af5a6ec8b5ef","sdu-95315af2-02df-454a-9970-41f2f20dbe4c"],"src":["AAU Aalborg University","AU Aarhus University","SDU University of Southern Denmark"],"title":"Dual-therapy CD34 antibody-covered sirolimus-eluting COMBO stents versus sirolimus-eluting Orsiro stents in patients treated with percutaneous coronary intervention : the three-year outcomes of the SORT OUT X randomised clinical trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-099.96-703873","year":"2023","yearsub":"2023"}
{"abstract":"Chemical dispersion is an oil spill response strategy where dispersants are sprayed onto the oil slick to enhance oil dispersion into the water. However, accidental application could expose seabirds to dispersants, thereby negatively affecting their plumage. To understand the possible impacts on seabirds, feathers from common eider (Somateria mollissima) and thick-billed murre (Uria lomvia) were exposed to different dosages of the dispersant Dasic Slickgone NS. For all exposure dosages the feathers increased in weight, and mostly for common eider. Analysing the feather microstructure, e.g., the Amalgamation Index, showed that larger damages were found on thick-billed murre than common eider. A no-sinking limit was established at 0.109 ml/m 2. Relating this value to desktop simulations of potential sea-surface dosages in real-life situations, and to published accounts of response operations, showed that the limit is likely to be exceeded. Thus, our results show that chemical dispersants in realistic dosages could impact seabirds.","author_count":9,"contributors":["Fritt-Rasmussen, Janne","Linnebjerg, Jannie Fries","Nordam, Tor","Riget, Frank Farsø","Kristensen, Paneeraq","Skancke, Jørgen","Wegeberg, Susse","Mosbech, Anders","Gustavson, Kim"],"cuid":["S01-000.00-275061"],"filters":{"added":"2023-03","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Fritt-Rasmussen, Janne"],"country":["Norway"],"glorg":["All Global Affiliations","Norwegian University of Science and Technology","SINTEF"],"keyword":["Common eider","Environmental effects","Oil spill response","Thick billed murre"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"effects of chemical dispersants on feathers from arctic seabirds","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.marpolbul.2023.114659","version":"Published Version"},"id":"S01-000.00-275061","identifier":[{"id":"36738727","type":"pmid"},{"id":"85147209267","type":"scopus"}],"ids":["au-ff5bb01a-26fb-49c7-824e-1c24e3fb71e9"],"keyword":["Amalgamation Index","Common eider","Environmental effects","Oil spill response","Thick-billed murre"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-9927BEC19CAFC0C0392FB2D725555F23"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.marpolbul.2023.114659","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.au.dk/ws/files/400819192/1-s2.0-S0025326X23000905-main.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, DCE - Danish Centre for Environment and Energy","Aarhus University, Technical Sciences, Department of Ecoscience, Department of Ecoscience - Arctic Environment"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"no","key":"sintef","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"SINTEF","used":1},{"affno":"3","country":"no","key":"norwegian university of science and technology","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"Norwegian University of Science and Technology","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Janne","key":"frittrasmussenpau","last":"Fritt-Rasmussen","locid":"ee0f4272-d879-4350-9617-affc0cc83535","name":"Fritt-Rasmussen, Janne","orcid":"0000-0002-6496-8032","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jannie Fries","key":"linnebjergpau","last":"Linnebjerg","locid":"04c42f5d-28c6-4a36-85a1-c580220951d1","name":"Linnebjerg, Jannie Fries","rank":2,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Tor","key":"nordampau","last":"Nordam","name":"Nordam, Tor","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Frank F","key":"rigétpau","last":"Rigét","locid":"17f6c904-057a-4571-86e8-956d9927ca1b","name":"Riget, Frank Farsø","name_org":"Rigét, Frank F","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Paneeraq","key":"kristensenpau","last":"Kristensen","locid":"8f332ec1-cf6d-4d68-9f3e-1cff9c4a4238","name":"Kristensen, Paneeraq","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jørgen","key":"skanckepau","last":"Skancke","name":"Skancke, Jørgen","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Susse","key":"wegebergpau","last":"Wegeberg","locid":"05370847-e1d3-4253-b818-046251260ff5","name":"Wegeberg, Susse","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anders","key":"mosbechpau","last":"Mosbech","locid":"0d8b3009-ff00-40a7-b738-abfa87e31ccf","name":"Mosbech, Anders","orcid":"0000-0002-7581-7037","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kim","key":"gustavsonpau","last":"Gustavson","locid":"1ebbd6c1-641f-40c9-a30f-7652da2113f9","name":"Gustavson, Kim","orcid":"0000-0001-8242-0276","rank":9,"rolecode":"pau"}],"pmid":["36738727"],"pub":{"doi":"10.1016/j.marpolbul.2023.114659","issn":["0025326X","18793363"],"issn_org":["0025326X"],"journal":"Marine Pollution Bulletin","paperid":"114659","publisher":"Elsevier Ltd","status":"p","title":"Marine Pollution Bulletin","volume":"188"},"review":"Peer Reviewed","scoID":["2-s2.0-85147209267"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-ff5bb01a-26fb-49c7-824e-1c24e3fb71e9"],"src":["AU Aarhus University"],"title":"Effects of chemical dispersants on feathers from Arctic seabirds","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-275061","year":"2023","yearsub":"2023"}
{"abstract":"Aging is associated with metabolic decline in skeletal muscle, which can be delayed by physical activity. Moreover, both lifelong and short-term exercise training have been shown to prevent age-associated fragmentation of the mitochondrial network in mouse skeletal muscle. However, whether lifelong endurance exercise training exerts the same effects in human skeletal muscle is still not clear. Therefore, the aim of the present study was to examine the effect of volume-dependent lifelong endurance exercise training on mitochondrial function and network connectivity in older human skeletal muscle. Skeletal muscle complex I+II-linked mitochondrial respiration per tissue mass was higher, but intrinsic complex I+II-linked mitochondrial respiration was lower in highly trained older subjects than in young untrained, older untrained, and older moderately trained subjects. Mitochondrial volume and connectivity were higher in highly trained older subjects than in untrained and moderately trained older subjects. Furthermore, the protein content of the ADP/ATP exchangers ANT1 + 2 and VDAC was higher and of the mitophagic marker parkin lower in skeletal muscle from the highly trained older subjects than from untrained and moderately trained older subjects. In contrast, H2O2 emission in skeletal muscle was not affected by either age or exercise training, but SOD2 protein content was higher in highly trained older subjects than in untrained and moderately trained older subjects. This suggests that healthy aging does not induce oxidative stress or mitochondrial network fragmentation in human skeletal muscle, but high-volume exercise training increases mitochondrial volume and network connectivity, thereby increasing oxidative capacity in older human skeletal muscle.","author_count":8,"contributors":["Jørgensen, Stine Ringholm","Gudiksen, Anders","Halling, Jens Frey","Qoqaj, Albina","Rasmussen, Philip Meizner","Prats Gavalda, Clara","Plomgaard, Peter","Pilegaard, Henriette"],"cuid":["S01-000.00-404502"],"filters":{"added":"2023-05","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Age","Autophagy","Biogenesis","Immobilization","In vivo","Mitochondria","Mitophagy","Mouse","PGC 1 alpha","Physical activity","Respirometry","Sensitivity","Skeletal muscle","Young","decreases"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"impact of aging and lifelong exercise training on mitochondrial function and network connectivity in human skeletal muscle","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-404502","identifier":[{"id":"000865111800001","type":"wos"},{"id":"35961318","type":"pmid"},{"id":"85149167423","type":"scopus"}],"ids":["ku-1296cf88-1108-41bd-b802-4aa8c7e5c8a7"],"keyword":["AGE","AUTOPHAGY","BIOGENESIS","DECREASES","IMMOBILIZATION","IN-VIVO","MOUSE","Mitochondria","Mitophagy","PGC-1-ALPHA","Physical activity","Respirometry","SENSITIVITY","Skeletal muscle","YOUNG"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-393833F7898878B4CBD96845A78E152E"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Biology, Cell Biology and Physiology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Stine","key":"ringholmpau","last":"Ringholm","locid":"e3e24567-4419-4742-9b22-1f3f20a6b1c1","name":"Jørgensen, Stine Ringholm","name_org":"Ringholm, Stine","rank":1,"rolecode":"pau"},{"affno":"1","first":"Anders","key":"gudiksenpau","last":"Gudiksen","locid":"c606f51e-8e40-4