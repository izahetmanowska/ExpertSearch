002-5230-9865","rank":12,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Alfonso","key":"builpau","last":"Buil","name":"Buil, Alfonso","rank":13,"rolecode":"pau"},{"affno":"8 2","first":"Thomas","key":"wergepau","last":"Werge","locid":"905c01bb-6319-4ce6-a38e-ceb5bf73d2f6","name":"Werge, Thomas","rank":14,"rolecode":"pau"},{"affno":"3 8","corresponding":null,"country":"dk","first":"Simon","key":"rasmussenpau","last":"Rasmussen","locid":"7dcb9d6e-8054-4bcf-a087-82517b291a32","name":"Rasmussen, Simon","orcid":"0000-0001-6323-9041","rank":15,"rolecode":"pau"},{"affno":"10 2","corresponding":null,"first":"Wesley K","key":"thompsonpau","last":"Thompson","name":"Thompson, Wesley K","rank":16,"rolecode":"pau"}],"pmid":["30976114"],"pub":{"doi":"10.1038/s41431-019-0402-9","issn":["10184813","14765438"],"issn_org":["10184813"],"issue":"9","journal":"European Journal of Human Genetics","pages":"1445-1455","publisher":"Springer Nature","status":"p","title":"European Journal of Human Genetics","volume":"27"},"review":"Peer Reviewed","scoID":["2-s2.0-85064242411"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Miscellaneous","All Non-Profit Organisations","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-NP","DI-NP-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Miscellaneous","Non-Profit Organisations","Other Research","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-377ef2b3-ec6b-4cb4-9371-32d9f5fec268","dtu-1662893c-2ba8-43f1-8fdd-87f9b03acb90","ku-db8baddb-ff4b-4bd4-8c30-08d615d28fc3"],"src":["AU Aarhus University","DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Immunity and mental illness : findings from a Danish population-based immunogenetic study of seven psychiatric and neurodevelopmental disorders","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-100.00-016700","year":"2019","yearsub":"2019"}
{"abstract":"Magnetic gears with integrated permanent magnet machines have been of increasing interest over the past years, and research on several demonstrators have been presented. Demonstrators rarely perform perfectly as intended, and not much effort is put into proposing redesigns to improve the demonstrator or future iterations of it. In this paper the design of an experimentally evaluated demonstrator will briefly be presented, and afterwards a theoretical method with regards to reduction of the 3 rd harmonic of the electromotive force will be presented, and also how this method will affect the slip torque, iron losses, inductance and cogging torque. It is found that the 3 rd harmonic of the electromotive force can be reduced by more than 90% by phase shifting the high speed magnets from the machine magnets with 75-{\\circ e}, with decrease in slip torque of 5.6 % and a decrease of 2.3 % in the 1- st harmonic of electromotive force. Additionally, there is seen a reduction in the rotational losses in the high speed yoke of more than 70%.","author_count":4,"contributors":["Kjær, Anders Byrdal","Korsgaard, Steffen","Nielsen, Simon Staal","Rasmussen, Peter Omand"],"cuid":["S01-000.00-064398"],"event":{"acronym":"IEMDC","end":"2019-05-15","place":"San Diego, us","start":"2019-05-12","title":"2019 IEEE International Electric Machines &amp; Drives Conference (IEMDC)","year":"2019"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Magnetic gears","Permanent magnet machines"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"reduction of third harmonic by redesign of magnetic circuit in a magnetically geared permanent magnet generator","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type