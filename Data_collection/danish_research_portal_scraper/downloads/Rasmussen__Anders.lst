Grønhøj, Mads","orcid":"0000-0002-1473-9872","rank":8,"rolecode":"pau"},{"affno":"2 4","corresponding":null,"first":"Frantz Rom","key":"poulsenpau","last":"Poulsen","locid":"b50645f6-f0c4-4356-9f63-d44290b0dfd9","name":"Poulsen, Frantz Rom","orcid":"0000-0001-5715-6901","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mojtaba","key":"nazaripau","last":"Nazari","locid":"43ed0188-69ac-4d3b-8847-2706a61df8b7","name":"Nazari, Mojtaba","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Naveed Ur","key":"rehmanpau","last":"Rehman","locid":"8c3547a5-d8d3-40c4-868b-a3c61f5e3009","name":"Rehman, Naveed Ur","orcid":"0000-0002-3700-5839","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Claus Ziegler","key":"simonsenpau","last":"Simonsen","locid":"ccf2fb52-6a4a-45b2-adb0-d6e83324879f","name":"Simonsen, Claus Ziegler","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anders Rosendal","key":"korshøjpau","last":"Korshøj","locid":"09d94078-676a-42ee-91c2-eb8ba8df356b","name":"Korshoej, Anders Rosendal","name_org":"Korshøj, Anders Rosendal","orcid":"0000-0003-4285-8171","rank":13,"rolecode":"pau"}],"pmid":["37815832"],"pub":{"doi":"10.1001/jamanetworkopen.2023.35247","issn":["25743805"],"issue":"10","journal":"JAMA network open","paperid":"e2335247","publisher":"American Medical Association","status":"p","title":"JAMA network open","title_org":"JAMA Network Open","volume":"6"},"review":"Peer Reviewed","scoID":["2-s2.0-85175660637"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-6456626c-9878-450a-afb6-2efb0c4cb685","sdu-019f11ef-b52b-4564-bb92-eb7062e67018"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Intraventricular Lavage vs External Ventricular Drainage for Intraventricular Hemorrhage : A Randomized Clinical Trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-704144","year":"2023","yearsub":"2023"}
{"abstract":"Background: Exposure to ambient air pollution has been linked to asthma, allergic rhinitis, and other inflammatory disorders, but little is known about the underlying mechanisms. Objective: We studied the potential mechanisms leading from prenatal ambient air pollution exposure to asthma and allergy in childhood. Methods: Long-term exposure to nitrogen dioxide (NO2) as well as to particulate matter with a diameter of ≤2.5 and ≤10 μm (PM2.5 and PM10) were modeled at the residence level from conception to 6 years of age in 700 Danish children followed clinically for development of asthma and allergy. Nasal mucosal immune mediators were assessed at age 4 weeks and 6 years, inflammatory markers in blood at 6 months, and nasal epithelial DNA methylation and gene expression at age 6 years. Results: Higher prenatal air pollution exposure with NO2, PM2.5, and PM10 was associated with an altered nasal mucosal immune profile at 4 weeks, conferring an increased odds ratio [95% confidence interval] of 2.68 [1.58, 4.62] for allergic sensitization and 2.63 [1.18, 5.81] for allergic rhinitis at age 6 years, and with an altered immune profile in blood at age 6 months conferring increased risk of asthma at age 6 years (1.80 [1.18, 2.76]). Prenatal exposure to ambient air pollution was not robustly associated with immune mediator, epithelial DNA methylation, or gene expression changes in nasal cells at age 6 years. Conclusion: Prenatal exposure to ambient air pollution was associated with early life immune perturbations conferring risk of allergic rhinitis and asthma. These findings suggest potential mechanisms of prenatal exposure to ambient air pollution on the developing immune system.","author_count":15,"contributors":["Tingskov Pedersen, Casper Emil","Eliasen, Anders Ulrik","Ketzel, Matthias","Brandt, Jørgen","Loft, Steffen","Frohn, Lise Marie","Khan, Jibran","Brix, Susanne","Rasmussen, Morten A.","Stokholm, Jakob","Morin, Andreanne","Ober, Carole","Bisgaard, Hans","Pedersen, Marie","Bønnelykke, Klaus"],"cuid":["S03-084.43-029039"],"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"continent":["America, North","OECD"],"corresponding_author":["Bønnelykke, Klaus"],"country":["United States"],"glorg":["All Global Affiliations","The University of Chicago"],"keyword":["Air pollution","Allergy","Asthma","Childhood","Environment","Epigenetic","Immune","Inflammation","Sensitization","Traffic","Urbanization"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-AU","DI-U-DTU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-AU","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"prenatal exposure to ambient air pollution is associated with early life immune perturbations","src":["au","dtu","ku"],"src-code":["DI-U-AU","DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.jaci.2022.08.020","version":"Published Version"},"id":"S03-084.43-029039","identifier":[{"id":"36075322","type":"pmid"},{"id":"85139040075","type":"scopus"}],"ids":["au-e1c4809a-d08d-4ab4-831f-e669b28ba91d","dtu-21ccc787-fa11-4505-b5f6-4cd33c9310c0","ku-66b85fe1-972f-4ddd-826e-fca731573bd4"],"keyword":["Air pollution","allergy","asthma","childhood","environment","epigenetic","immune","inflammation","sensitization","traffic","urbanization"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-6-068ED52A303CD8013AE3EB14920C6915"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.jaci.2022.08.020","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/331775458/Fulltext.pdf","version":"Published Version"},{"access":"oa","l