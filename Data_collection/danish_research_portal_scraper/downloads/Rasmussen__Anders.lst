ntry":"dk","first":"Ulla M.","key":"weinreichullamøllerpau","last":"Weinreich","locid":"dd46b672-1843-46f2-8fdd-a338cf5c6621","name":"Weinreich, Ulla Møller","name_org":"Weinreich, Ulla M.","orcid":"0000-0003-1975-3654","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Frederik M.","key":"nielsenfrederikmølgaardpau","last":"Nielsen","locid":"d7387610-1579-4bc0-892f-a8523e6579ba","name":"Nielsen, Frederik Mølgaard","name_org":"Nielsen, Frederik M.","rank":4,"rolecode":"pau"},{"affno":"3 4","first":"Anders","key":"perneranderspau","last":"Perner","locid":"8a389541-d529-4ee3-8364-66bfc85f77c9","name":"Perner, Anders","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Olav L.","key":"schjørringolavlilleholtpau","last":"Schjørring","locid":"7dac619e-9b5c-46ac-9170-10ac13165da5","name":"Schjørring, Olav Lilleholt","name_org":"Schjørring, Olav L.","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Bodil S.","key":"rasmussenbodilsteenpau","last":"Rasmussen","locid":"3162c449-94c3-4d28-8dbb-c134d6eb76e1","name":"Rasmussen, Bodil Steen","name_org":"Rasmussen, Bodil S.","orcid":"0000-0003-2190-145X","rank":7,"rolecode":"pau"}],"pmid":["38711834"],"pub":{"doi":"10.1016/j.bjao.2024.100281","issn":["27726096"],"journal":"BJA Open","paperid":"100281","publisher":"Elsevier","status":"p","title":"BJA Open","volume":"10"},"review":"Peer Reviewed","scoID":["2-s2.0-85191451287"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-0a713809-dff0-4563-b77f-f8669f6e2e93","ku-c08334ea-715f-4fdf-8da3-a0e86d5ee95e"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"Effects of a lower <i>versus </i>a higher oxygenation target in intensive care unit patients with chronic obstructive pulmonary disease and acute hypoxaemic respiratory failure : a subgroup analysis of a randomised clinical trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.81-741261","year":"2024","yearsub":"2024"}
{"abstract":"Background Standing frames are commonly used by healthcare professionals in their practice with children with cerebral palsy (CP) who do not have an independent standing function. A better understanding of healthcare professionals' attitudes and experiences with standing frames may impact practice and rehabilitation. Therefore, this study aimed to investigate the standing frame practice among healthcare professionals and expand their attitude and experience with the use of standing frames for children with CP. Methods This is an explanatory sequential mixed methods study. A cross-sectional survey was conducted, providing quantitative data on 210 healthcare professionals' use of standing frames. The quantitative data were descriptively analysed. Subsequently, the results from the survey were followed up with five focus group interviews of healthcare professionals (n = 14). The qualitative data were analysed using thematic analysis, enabling integration between the quantitative and qualitative data. Results When quantitative and qualitative data are integrated, expansion between the two datasets occurred. The quantitative dataset emphasised the use of GMFCS levels as a guideline for recommending standing frames, whereas the qualitative data showed that the healthcare professionals' recommendations were based on individual needs. Furthermore, the healthcare professionals expanded the quantitative data, showing that the healthcare professionals' considerations regarding age and dosage were based on clinical experience, and saw the standing frame as having many benefits. Conclusion The healthcare professionals had a child-centred approach, where the child's need for using a standing frame was assessed based on the functional level, stage of development, cognitive level and clinical assessment. All of these considerations showed that the use of standing frames for children with CP was individualised, thereby making it difficult to make unified descriptions.","author_count":7,"contributors":["Andersen, Michaela","Krarup, Laerke Hartvig","Rolving, Nanna","Holsgaard-Larsen, Anders","Pawlowski, Charlotte Skau","Rasmussen, Helle Mätzke","Hubeishy, Maja Husted"],"cuid":["S02-099.92-755992"],"filters":{"added":"2024-09","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Andersen, Michaela","Rolving, Nanna"],"keyword":["Cerebral palsy","Healthcare professionals"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-PR","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-CDR","DI-PR-OTH","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"healthcare professionals perspectives on the use of standing frames for children diagnosed with cerebral palsy an explanatory mixed methods study","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1111/cch.13320","version":"Published Version"},"id":"S02-099.92-755992","identifier":[{"id":"39143846","type":"pmid"},{"id":"85201318629","type":"scopus"}],"ids":["au-3541189c-08d6-4f0b-9309-5ac4299266fb","sdu-ccfbd046-29ff-4113-949d-a32a098c1fa1"],"keyword":["attitudes and experiences","cerebral palsy","healthcare professionals","standing frames"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-60A0C116641BA209E16EE8EA102659B3"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/268606507/Child_-_2024_-_Andersen_-_Healthcare_Professionals_Perspectives_on_the_Use_of_Standing_Frames_for_Children_Diagnosed_With.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.au.dk/ws/files/434506721/Child_-_2024_-_Andersen_-_Healthcare_Professionals_Perspectives_on_the_Use_of_Standing_Frames_for_Children_Diagnosed_With.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1111/cch.13320","version":"Published Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of orthopaedic surgery (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["R82 A/S"],"nora_code":"DI-PR-OTH","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Physiotherapy and Occupational Therapy","Aarhus University, Health, Department of Public Health, Department of Public Health - Sport Science"],"nora_code":"DI-U-AU","used":1},{"affno":"4","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Regionshospitalet Silkeborg"],"nora_code":"DI-HO-CDR","used":1}],"person":[{"affno":"","corresponding":null,"first":"Michaela","key":"andersenpau","last":"Andersen","name":"Andersen, Michaela","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Lærke","key":"kraruppau","last":"Krarup","locid":"0a46dc14-84ea-4778-8a2a-8922f607d611","name":"Krarup, Laerke Hartvig","name_org":"Krarup, Lærke","orcid":"0000-0003-4595-2649","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Nanna","key":"rolvingpau","last":"Rolving","locid":"0961714b-e933-4746-9e00-94c3f9b706b7","name":"Rolving, Nanna","orcid":"0000-0001-9195-7278","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders","key":"holsgaardlarsenpau","last":"Holsgaard-Larsen","locid":"3c1cf5a4-81b1-49f3-ad79-d086b74b1561","name":"Holsgaard-Larsen, Anders","orcid":"0000-0003-4106-6930","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Charlotte","key":"pawlowskipau","last":"Pawlowski","locid":"889b5a08-7360-484e-84ad-5baea5e669df","name":"Pawlowski, Charlotte Skau","name_org":"Pawlowski, Charlotte","orcid":"0000-0003-1407-613X","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Helle Mätzke","key":"rasmussenpau","last":"Rasmussen","locid":"fc740e3e-3a84-4904-bd04-4db023a123db","name":"Rasmussen, Helle Mätzke","orcid":"0000-0002-7522-8144","rank":6,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Maja Husted","key":"hubeishypau","last":"Hubeishy","locid":"3777230f-4fd3-44ff-a4f7-4db130ccc61c","name":"Christensen, Maja Husted","name_org":"Hubeishy, Maja Husted","rank":7,"rolecode":"pau"}],"pmid":["39143846"],"pub":{"doi":"10.1111/cch.13320","issn":["03051862","13652214"],"issn_org":["03051862"],"issue":"5","journal":"Child: Care, Health and Development","paperid":"e13320","publisher":"Wiley-Blackwell Publishing Ltd","status":"p","title":"Child: Care, Health and Development","volume":"50"},"review":"Peer Reviewed","scoID":["2-s2.0-85201318629"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Private Research","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Hospitals","Other Companies","Private Research","Region of Southern Denmark","Universities","University of Southern Denmark","r82 a/s"],"PST":["Published"]},"sid":["au-3541189c-08d6-4f0b-9309-5ac4299266fb","sdu-ccfbd046-29ff-4113-949d-a32a098c1fa1"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Healthcare Professionals' Perspectives on the Use of Standing Frames for Children Diagnosed With Cerebral Palsy: An Explanatory Mixed Methods Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.92-755992","year":"2024","yearsub":"2024"}
{"abstract":"Background: Piperacillin/tazobactam may be associated with less favourable outcomes than carbapenems in patients with severe bacterial infections, but the certainty of evidence is low. Methods: The Empirical Meropenem versus Piperacillin/Tazobactam for Adult Patients with Sepsis (EMPRESS) trial is an investigator-initiated, international, parallel-group, randomised, open-label, adaptive clinical trial with an integrated feasibility phase. We will randomise adult, critically ill patients with sepsis to empirical treatment with meropenem or piperacillin/tazobactam for up to 30 days. The primary outcome is 30-day all-cause mortality. The secondary outcomes are serious adverse reactions within 30 days; isolation precautions due to resistant bacteria within 30 days; days alive without life support and days alive and out of hospital within 30 and 90 days; 90- and 180-day all-cause mortality and 180-day health-related quality of life. EMPRESS will use Bayesian statistical models with weak to somewhat sceptical neutral priors. Adaptive analyses will be conducted after follow-up of the primary outcome for the first 400 participants concludes and after every 300 subsequent participants, with adaptive stopping for superiority/inferiority and practical equivalence (absolute risk difference <2.5%-points) and response-adaptive randomisation. The expected sample sizes in scenarios with no, small or large differences are 5189, 5859 and 2570 participants, with maximum 14,000 participants and ≥99% probability of conclusiveness across all scenarios. Conclusions: EMPRESS will compare the effects of empirical meropenem against piperacillin/tazobactam in adult, critically ill patients with sepsis. Due to the pragmatic, adaptive design with high probability of conclusiveness, the trial results are expected to directly inform clinical practice.","author_count":17,"contributors":["Granholm, Anders","Munch, Marie Warrer","Meier, Nick","Sjövall, Fredrik","Helleberg, Marie","Hertz, Frederik Boëtius","Kaas-Hansen, Benjamin Skov","Thorsen-Meyer, Hans Christian","Andersen, Lars W","Rasmussen, Bodil Steen","Andersen, Jakob Steen","Albertsen, Trine Lynge","Kjær, Maj Brit Nørregaard","Jensen, Aksel Karl Georg","Lange, Theis","Perner, Anders","Møller, Morten Hylander"],"cuid":["S03-092.86-751549"],"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"continent":["Europe, EU","Nordic","OECD"],"corresponding_author":["Granholm, Anders"],"country":["Sweden"],"glorg":["All Global Affiliations","Lund University","Skåne University Hospital"],"keyword":["Carbapenems","Meropenem","Piperacillin tazobactam","Randomised clinical trial","Sepsis","Septic shock","adaptive clinical trial","empirical antibiotics"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-OTH"],"OT":["Sundhedsministeriet"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-UND"]},"level3all":["DI-HO-CAP","DI-HO-OTH","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-UND"]},"review":"pr","rtype":["clu"],"sorti":"empirical meropenem versus piperacillin tazobactam for adult patients with sepsis empress trial protocol","src":["aau","au","ku"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1111/aas.14441","version":"Published Version"},"funding_acknowledgement":["The EMPRESS trial is funded by grants from the Independent Research Fund Denmark, the Research Council at Rigshospitalet, the Research Fund for Health Research of the Capital Region of Denmark, the Beckett Foundation, L\\u00E6ge Inger Goldmanns Fond and Grosserer Jakob Ehrenreich og Hustru Grete Ehrenreichs Fond. The trial uses infrastructure and methodology developed as part of the Intensive Care Platform Trial (INCEPT) programme ( www.incept.dk ), funded by the Novo Nordisk Foundation and Sygeforsikringen \\u2018danmark\\u2019 and supported by Grosserer Jakob Ehrenreich og Hustru Grete Ehrenreichs Fond, Dagmar Marshalls Fond and Savv\\u00E6rksejer Jeppe Juhl og hustru Ovita Juhls Mindelegat. The funding organisations have not been and will not be involved in the design, conduct, analyses or reporting of the trial nor will they have ownership of the data. The Department of Intensive Care at Rigshospitalet has received grants from the Novo Nordisk Foundation, Pfizer, and Sygeforsikringen \\u201Cdanmark\\u201D outside the submitted work. Marie Helleberg has participated in advisory boards for GlaxoSmithKline, AstraZeneca, Pfizer, Sobi, Roche, and MSD. Anders Perner has participated in advisory boards for Novartis. The remaining authors report no conflicts of interest."],"id":"S03-092.86-751549","identifier":[{"id":"38769040","type":"pmid"},{"id":"85193628392","type":"scopus"}],"ids":["aau-49ac7d67-9d72-4394-9511-eee5e3f92c7d","au-2642f91c-8b64-42c7-a7d9-a29bda207c9a","ku-bc776bf0-499d-4ca4-b716-dd7d17b2620c"],"keyword":["adaptive clinical trial","carbapenems","empirical antibiotics","meropenem","piperacillin/tazobactam","randomised clinical trial","sepsis","septic shock"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-7B02FA90660399A9BBA5903CBEB30A76"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1111/aas.14441","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/741570684/Granholm_et_al._2024_._Empirical_meropenem_versus_piperacillin-tazobactam_for_adult_patients_with_sepsis_EMPRESS_trial_-_Protocol.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/401975615/Acta_Anaesthesiol_Scand_2024_Granholm_Empirical_meropenem_versus_piperacillin_tazobactam_for_adult_patients_with.pdf","version":"Published V