nical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Biotechnology and Biomedicine","Technical University of Denmark, Department of Biotechnology and Biomedicine, Section for Microbial and Chemical Ecology","Technical University of Denmark, Department of Biotechnology and Biomedicine, Section for Microbial and Chemical Ecology, Metabolic Signaling and Regulation"],"nora_code":"DI-U-DTU","used":1},{"affno":"3","country":"fr","key":"cnrs","loc":["France","Europe, EU","OECD"],"name":"CNRS","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anders","key":"varmingpau","last":"Varming","name":"Varming, Anders","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kim Krighaar","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Kim Krighaar","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Mogens","key":"kilstruppau","last":"Kilstrup","locid":"f852c88c-c2dd-4c1c-bb1d-119775a3d7e7","name":"Kilstrup, Mogens","orcid":"0000-0002-3900-723X","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Karin","key":"hammerpau","last":"Hammer","locid":"9fcdb463-9cb0-4066-ab81-e81bcd8a22e0","name":"Hammer, Karin","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Malene Ringkjobing","key":"jensenpau","last":"Jensen","name":"Jensen, Malene Ringkjobing","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hanne","key":"ingmerpau","last":"Ingmer","name":"Ingmer, Hanne","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Leila","key":"loleggiopau","last":"Lo Leggio","name":"Lo Leggio, Leila","rank":7,"rolecode":"pau"}],"pub":{"doi":"10.1107/s2053273319094518","issn":["01087673"],"issue":"a2","journal":"Acta Crystallographica Section A: Foundations and Advances","publis