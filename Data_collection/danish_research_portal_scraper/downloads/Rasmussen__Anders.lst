pau","last":"Wetterslev","name":"Wetterslev, Jørn","rank":6,"rolecode":"pau"},{"affno":"3 4 2","first":"Anders","key":"pernerpau","last":"Perner","locid":"8a389541-d529-4ee3-8364-66bfc85f77c9","name":"Perner, Anders","rank":7,"rolecode":"pau"},{"affno":"1 2 3","corresponding":null,"country":"dk","first":"Bodil Steen","key":"rasmussenpau","last":"Rasmussen","locid":"3162c449-94c3-4d28-8dbb-c134d6eb76e1","name":"Rasmussen, Bodil Steen","orcid":"0000-0003-2190-145X","rank":8,"rolecode":"pau"}],"pmid":["34876227"],"pub":{"doi":"10.1186/s40560-021-00573-5","issn":["20520492"],"issue":"1","journal":"Journal of Intensive Care","paperid":"72","publisher":"Springer","status":"p","title":"Journal of Intensive Care","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-85120855626"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Other Hospitals","Universities","University of Copenhagen","collaboration for research in intensive care"],"PST":["Published"]},"sid":["aau-f17d05de-2909-419e-bc53-3e1e866e33e4","ku-7af385df-3204-429b-959a-e1e70ad83f7e"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"Letter the editor : serious methodological concerns about a recently published meta-analysis on oxygen therapy","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-095.92-011538","year":"2021","yearsub":"2021"}
{"abstract":"Background: Weight loss is critical for preventing and managing obesity-related diseases. There is a notable lack of valid and reliable means to manage patients with overweight/obesity and knee osteoarthritis (KOA). Objective: To determine the efficacy and safety of liraglutide in a 30 mg/d dosing in patients with overweight/obesity and KOA. Methods: The trial was designed as a randomized controlled trial including patients between the age of 18 and 74 y with KOA and a BMI ≥27 (measured in kg/m2).Patients underwent a pre-random assignment diet intervention (week -8 to 0). At week 0, patients having lost >5% of their body weight were randomly assigned to liraglutide 3 mg/d or placebo for 52 wk. The coprimary outcomes were changes in body weight and the Knee injury and Osteoarthritis Outcome Score (KOOS) pain subscale from week 0 to 52. Results: In total, 168 patients enrolled and 156 were randomly assigned to receive liraglutide or placebo. Patients experienced a significant reduction in body weight and KOOS pain during the pre-random assignment dietary intervention period (week -8 to 0). From week 0 to 52 there was a significant difference in body weight between the liraglutide and placebo group (mean changes: -2.8 and +1.2 kg, respectively; group difference, 3.9 kg; 95% CI: -6.9, -1.0; P = 0.008). There was, however, no group difference in KOOS pain (mean changes: 0.4 and -0.6 points, respectively; group difference, 0.9 points; 95% CI: -3.9, 5.7; P = 0.71). Treatment-emergent adverse events related to the gastrointestinal system were experienced by 50.2% and 39.2% of patients in the liraglutide and placebo groups, respectively. Conclusions: In patients with KOA and overweight/obesity liraglutide added after an 8-wk pre-random assignment diet induced a significant weight loss at >52 wk but did not reduce knee pain compared to placebo.  This trial was registered at clinicaltrials.gov as NCT02905864.","author_count":18,"contributors":["Gudbergsen, Henrik","Overgaard, Anders","Henriksen, Marius","Wæhrens, Eva Ejlersen","Bliddal, Henning","Christensen, Robin","Nielsen, Sabrina Mai","Boesen, Mikael","Knop, Filip K.","Astrup, Arne","Rasmussen, Marianne Uggen","Bartholdy, Cecilie","Daugaard, Cecilie Laubjerg","Ellegaard, Karen","Heitmann, Berit Lilienthal","Bartels, Else Marie","Danneskiold-Samsøe, Bente","Kristensen, Lars Erik"],"cuid":["S02-099.95-046498"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Gudbergsen, Henrik"],"keyword":["Diet","Faculty of Science","Intervention","Liraglutide","Obesity","Osteoarthritis"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"liraglutide after diet induced weight loss for pain and weight control in knee osteoarthritis a randomized controlled trial","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Kun læseadgang","type":"doi","url":"https://doi.org/10.1093/ajcn/nqaa328","version":"Published Version"},"id":"S02-099.95-046498","identifier":[{"id":"33471039","type":"pmid"},{"id":"85102222232","type":"scopus"}],"ids":["ku-d4ab1101-daad-49b9-9fd8-42b4bb2ef7ff","sdu-0751ea77-46bf-4380-878e-024b0b07c817"],"keyword":["Diet","Faculty of Science","Intervention","Liraglutide","Obesity","Osteoarthritis"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-A2C3FF6BD7D81C584F82C4B881187F74"],"oa_link":[{"access":"oa","license":"Kun læseadgang","type":"doi","url":"https://doi.org/10.1093/ajcn/nqaa328","version":"Published Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Bispebjerg and Frederiksberg"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal Medicine: Rheumatology"],"nora_code":"DI-U-KU","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Public Health, Research Unit of General Pratice","SDU, The Faculty of Health Sciences, Department of Public Health, User Perspectives and Community-based Interventions"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","first":"Henrik","key":"gudbergsenpau","last":"Gudbergsen","name":"Gudbergsen, Henrik","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders","key":"overgaardpau","last":"Overgaard","name":"Overgaard, Anders","rank":2,"rolecode":"pau"},{"affno":"2 1","first":"Marius","key":"henriksenpau","last":"Henriksen","locid":"0cadf7d6-9539-4ade-9bc4-98402453e742","name":"Henriksen, Marius","orcid":"0000-0003-1091-2962","rank":3,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"first":"Eva Ejlersen","key":"w