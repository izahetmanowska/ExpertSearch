{"abstract":"I artiklen beskrives det nye fund af otte nye sølvbægre på Fejø, som blev fundet samme sted ved Østerby, hvor der i 1872 blev fundet de fem Fejøbægre. Med det nye fund består fundet derfor nu af 13 sølvbægre.","author_count":2,"contributors":["Rasmussen, Anders","Høhling Søsted, Kasper"],"cuid":["S01-000.00-755092"],"filters":{"added":"2024-09","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Arkæologi","Depotfund","Lolland Falster","Metaldetektor","Vikingetid"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV"],"level3":{"GV":["DI-GV-ALL","DI-GV-KUM"]},"level3all":["DI-GV-KUM"]},"review":"nr","rtype":["clu"],"sorti":"fejøbægrene en hyldest til detektorfolket","src":["kum"],"src-code":["DI-GV-KUM"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-755092","ids":["kum-3ede0140-8efc-412d-8104-336a7db48fe6"],"keyword":["Arkæologi","Depotfund","Fejø","Lolland-Falster","Metaldetektor","vikingetid"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-6461867F1A333668BA91394055355592"],"org":[{"affno":"1","key":"kum ministry of culture archives museums and royal library denmark","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-KUM","l3nn":"KUM Ministry of Culture - Archives, Museums, and Royal Library Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KUM Ministry of Culture - Archives, Museums, and Royal Library Denmark","namevar":["Ministry of Culture Denmark, Museum Lolland-Falster"],"nora_code":"DI-GV-KUM","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Anders","key":"rasmussenpau","last":"Rasmussen","locid":"831558a0-727f-45a9-bbbb-8f8b30058802","name":"Rasmussen, Anders","orcid":"0000-0002-6769-9122","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kasper","key":"høhlingsøstedpau","last":"Høhling Søsted","locid":"48bdfb11-fd18-439