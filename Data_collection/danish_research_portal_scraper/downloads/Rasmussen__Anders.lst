{"author_count":3,"contributors":["Sørensen, Tim Flohr","Bjerregaard, Peter","Rasmussen, Anders Emil"],"cuid":["S02-091.43-691901"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"continent":["Europe, Non-EU","Nordic","OECD"],"country":["Norway"],"glorg":["All Global Affiliations","The Museum of Cultural History"],"keyword":["Afterlife","Anthropology","Archaeology","Architecture","Burial","Cemeteries","Commemoration","Death","Decay","Ethnography","Faculty of Humanities","Grief","Materiality","Memory","Museology","Passing","Philosophy","Photography","Sociology"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"materialities of passing transformation transition and transience","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"db","type-grp":["all","pub"]},"id":"S02-091.43-691901","ids":["au-0a0ee2e4-bb07-4f35-900a-d04fd0123433","ku-9c583f32-2268-4a17-a2ca-aeebfd7c3a22"],"keyword":["Afterlife","Anthropology","Archaeology","Architecture","Burial","Cemeteries","Commemoration","Death","Decay","Ethnography","Faculty of Humanities","Grief","Materiality","Memory","Museology","Passing","Philosophy","Photography","Sociology"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-2-615B3A69DE6C3F7252CA8427FAC59306"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Humanities, SAXO-Institute - Archaeology, Ethnology, Greek & Latin, History"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"m