cid":"4be12bf0-6f2f-4fc7-87b8-8c93d760e72f","name":"Savarimuthu, Thiusius Rajeeth","name_org":"Savarimuthu, T. R.","orcid":"0000-0002-2478-8694","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"C.","key":"slothpau","last":"Sloth","locid":"414bddc7-9d60-4431-981d-594ded3f2b30","name":"Sloth, Christoffer","name_org":"Sloth, C.","orcid":"0000-0002-3309-6278","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"L. C.","key":"sørensenpau","last":"Sørensen","locid":"c5344f74-7ae4-4d04-a050-6523f498d82a","name":"Sørensen, Lars Carøe","name_org":"Sørensen, L. C.","orcid":"0000-0003-4165-5719","rank":13,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"T. N.","key":"thulesenpau","last":"Thulesen","locid":"88d78bdd-443a-422d-b411-7c208a7eb52e","name":"Thulesen, Thomas Nicky","name_org":"Thulesen, T. N.","orcid":"0000-0001-9811-7351","rank":14,"rolecode":"pau"}],"pub":{"doi":"10.1080/01691864.2019.1686422","issn":["01691864","15685535"],"issn_org":["01691864"],"issue":"7-8","journal":"Advanced Robotics","pages":"422-438","publisher":"Taylor & Francis","status":"p","title":"Advanced Robotics","volume":"34"},"review":"Peer Reviewed","scoID":["2-s2.0-85074826108"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-2b0e495d-a04e-468a-80e1-996cbfacefb0"],"src":["SDU University of Southern Denmark"],"title":"Towards robot cell matrices for agile production–SDU Robotics' assembly cell at the WRC 2018","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-585526","year":"2020","yearsub":"2020"}
{"abstract":"Creative writing may help patients find new powers in the acts of making art and expanding horizons beyond illness, including addiction. The aim of the present pilot study was to introduce creative writing workshops to alcohol use disorder (AUD) patients and investigate self-perceived rehabilitating impact, improvement in quality of life, and executive functions. The study was conducted in a mixed methods design; primarily semi-structured group and individual interviews as well as participant observation, supplemented by a small evaluation questionnaire at baseline and follow-up at the end of exposure. The patients had experienced the workshop as having influenced their lives in a positive direction, impacted by doing creative writing, sharing and receiving feedback, and the community of the group. The patients perceived both advantages and disadvantages about discussing alcohol in the workshop. The patients experienced an increase in quality of life from the beginning to the end of the workshop. There could be a need for creative writing workshops as add-ons to ordinary AUD treatment. In such an offer, creative writing might function as a means to improve patient rehabilitation, quality of life, and executive functions.","author_count":4,"contributors":["Tarp, Kristine","Hellum, Rikke","Rasmussen, Anders Juhl","Nielsen, Anette Søgaard"],"cuid":["S01-000.00-637847"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Tarp, Kristine"],"keyword":["Alcohol use disorder","Creative writing","Mixed methods","Qualitative","Treatment"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"can creative writing as an add on to treatment for alcohol use disorder support rehabilitation","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1080/07347324.2019.1636736","version":"Published Version"},"id":"S01-000.00-637847","identifier":[{"id":"85068594267","type":"scopus"}],"ids":["sdu-e1a58c68-1bbb-46ae-9f34-0b5fa4977eba"],"keyword":["Alcohol use disorder","creative writing","mixed methods","qualitative","treatment"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-A6EE5AE271CF472C2271B9BF14D71331"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1080/07347324.2019.1636736","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/152208577/Can_Creative_Writing_as_an_Add_on_to_Treatment_for_Alcohol_Use_Disorder_Support_Rehabilitation.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Digital Psychiatry (Odense)","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, UCAR - Unit for Clinical Alcohol Research (Odense)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Kristine","key":"tarppau","last":"Tarp","locid":"c23a169e-85e0-45ce-8b84-0864d95c1931","name":"Tarp, Kristine","orcid":"0000-0003-0901-855X","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rikke","key":"hellumpau","last":"Hellum","locid":"6a885502-a150-45b6-aa52-a13ca5ce6d40","name":"Hellum, Rikke","orcid":"0000-0003-1587-7991","ran