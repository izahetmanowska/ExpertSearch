0029","name":"Rasmussen, Jesper","orcid":"0000-0002-3947-1518","rank":16,"rolecode":"pau"},{"affno":"9","corresponding":null,"country":"dk","first":"Mirko","key":"salewskimirkopau","last":"Salewski","locid":"38100e3a-6385-47d3-aa2d-6fc5608a8649","name":"Salewski, Mirko","orcid":"0000-0002-3699-679X","rank":17,"rolecode":"pau"},{"affno":"9","corresponding":null,"country":"dk","first":"Morten Stejner","key":"stejnerpedersenmortenpau","last":"Pedersen","locid":"5e16534e-b167-4a1f-a316-ea12e478d879","name":"Stejner Pedersen, Morten","name_org":"Pedersen, Morten Stejner","orcid":"0000-0003-1300-8135","rank":18,"rolecode":"pau"},{"affno":"9","corresponding":null,"country":"dk","first":"Laust Emil Hjerrild","key":"tophøjlaustemilhjerrildpau","last":"Tophøj","locid":"97568333-0da3-44e9-aab0-420816644463","name":"Tophøj, Laust Emil Hjerrild","rank":19,"rolecode":"pau"}],"pub":{"doi":"10.1088/0029-5515/55/10/104010","issn":["00295515","10185577"],"issn_org":["00295515"],"issue":"10","journal":"Nuclear Fusion","pages":"104010","publisher":"IOP Publishing","status":"p","title":"Nuclear Fusion","volume":"55"},"review":"Peer Reviewed","scoID":["2-s2.0-84944336824"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-bef17537-d68b-4713-a9e2-41d11aab8b29"],"src":["DTU Technical University of Denmark"],"title":"Recent ASDEX Upgrade research in support of ITER and DEMO","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-361630","year":"2015","yearsub":"2015"}
{"abstract":"BACKGROUND/AIMS: Altered expression of the integrin family of cell adhesion receptors has been associated with initiation, progression, and metastasis of solid tumors as well as in the development of chemoresistance. Here, we investigated the role of integrins, in particular integrin β1, in cell volume regulation and drug-induced apoptosis in adherent and non-adherent Ehrlich ascites cell lines. METHODS: Adhesion phenotypes were verified by colorimetric cell-adhesion-assay. Quantitative real-time PCR and western blot were used to compare expression levels of integrin subunits. Small interfering RNA was used to silence integrin β1 expression. Regulatory volume decrease (RVD) after cell swelling was studied with calcein-fluorescence-self-quenching and Coulter counter analysis. Taurine efflux was estimated with tracer technique. Caspase assay was used to determine apoptosis. RESULTS: We show that adherent cells have stronger fibronectin binding and a significantly increased expression of integrin α5, αv, and β1 at mRNA and protein level, compared to non-adherent cells. Knockdown of integrin β1 reduced RVD of the adherent but not of the non-adherent cells. Efflux of taurine was unaffected. In contrast to non-adherent, adherent cells exhibited chemoresistance to chemotherapeutic drugs (cisplatin and gemcitabine). However, knockdown of integrin β1 promoted cisplatin-induced caspase activity in adherent cells. CONCLUSION: Our data identifies integrin β1 as a part of the osmosensing machinery and regulator of cisplatin resistance in adherent Ehrlich cells. © 2015 S. Karger AG, Basel.","author_count":8,"contributors":["Sørensen, Belinda Halling","Rasmussen, Line Jee Hartmann","Broberg, Bjørn Sindballe","Klausen, Thomas Kjær","Sauter, Daniel Rafael Peter","Lambert, Ian Henry","Aspberg, Anders","Hoffmann, Else Kay"],"cuid":["S01-000.00-411763"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-PR","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"PR":["DI-PR-ALL","DI-PR-NOVO","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-PR-NOVO","DI-PR-OTH","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"integrin β sub 000000000001 sub osmosensing and chemoresistance in mouse ehrlich carcinoma cells","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1159/000374057","version":"Published Version"},"id":"S01-000.00-411763","identifier":[{"id":"84928752956","type":"scopus"},{"id":"25925201","type":"pmid"}],"ids":["ku-1ecd8dde-df62-47ab-b76e-5de802b161df"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-68193F44788CE79F42CB038F34586B64"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1159/000374057","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://curis.ku.dk/ws/files/155986369/Integrin_1_Osmosensing_and_Chemoresistance_in_Mouse_Ehrlich_Carcinoma_Cells.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Biology, Cell Biology and Physiology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Amager and Hvidovre"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","country":"dk","key":"novo nordisk","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-NOVO","l3nl":"Novo Nordisk","l3nn":"Novo Nordisk","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Novo Nordisk","namevar":["Novo Nordisk"],"nora_code":"DI-PR-NOVO","used":1},{"affno":"4","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["Dako"],"nora_code":"DI-PR-OTH","used":1}],"person":[{"affno":"1","first":"Belinda Halling","key":"sørensenpau","last":"Sørensen","locid":"f12bc31d-7fab-4136-9933-27b6c7d8baad","name":"Sørensen, Belinda Halling","rank":1,"rolecode":"pau"},{"affno":"2","first":"Line Jee Hartmann","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Line Jee Hartmann","rank":2,"rolecode":"pau"},{"affno":"3","first":"Bjørn Sindballe","key":"brobergpau","last":"Broberg","name":"Broberg, Bjørn Sindballe","rank":3,"rolecode":"pau"},{"affno":"4","first":"Thomas Kjær","key":"klausenpau","last":"Klausen","name":"Klausen, Thomas Kjær","rank":4,"rolecode":"pau"},{"affno":"1","first":"Daniel Rafael Peter","key":"sauterpau","last":"Sauter","locid":"0163a9dc-147e-45e6-a206-053b58a076ec","name":"Sauter, Daniel Rafael Peter","rank":5,"rolecode":"pau"},{"affno":"1","first":"Ian Henry","key":"lambertpau","last":"Lambert","locid":"a193c6b4-3bf9-4690-959f-e5329892929b","name":"Lambert, Ian Henry","orcid":"0000-0001-5936-7593","rank":6,"rolecode":"pau"},{"affno":"1","first":"Anders","key":"aspbergpau","last":"Aspberg","locid":"4b97b317-6de4-4f1d-8c81-1bfe7f6fe58d","name":"Aspberg, Anders","rank":7,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Else Kay","key":"hoffmannpau","last":"Hoffmann","locid":"1364111c-0cb8-4093-8f94-df6b33bae8a7","name":"Hoffmann, Else Kay","rank":8,"rolecode":"pau"}],"pmid":["25925201"],"pub":{"doi":"10.1159/000374057","issn":["10158987","14219778"],"issn_org":["10158987"],"issue":"1","journal":"Cellular Physiology and Biochemistry","pages":"111-132","status":"p","title":"Cellular Physiology and Biochemistry","volume":"36"},"review":"Peer Reviewed","scoID":["2-s2.0-84928752956"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Private Research","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Hospitals","Novo Nordisk","Other Companies","Private Research","Universities","University of Copenhagen","dako"],"PST":["Published"]},"sid":["ku-1ecd8dde-df62-47ab-b76e-5de802b161df"],"src":["KU University of Copenhagen"],"title":"Integrin β<sub>1</sub>, osmosensing, and chemoresistance in mouse ehrlich carcinoma cells","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-411763","year":"2015","yearsub":"2015"}
{"abstract":"BACKGROUND: Post-transcriptional RNA regulons ensure co-ordinated expression of monocistronic mRNAs encoding functionally related proteins. In this study, we employ a combination of RIP-seq and short- and long-wave individual-nucleotide resolution crosslinking and immunoprecipitation (iCLIP) technologies in Drosophila cells to identify transcripts associated with cytoplasmic ribonucleoproteins (RNPs) containing the RNA-binding protein Imp. RESULTS: We find extensive binding of Imp to 3'UTRs of transcripts that are involved in F-actin formation. A common denominator of the RNA-protein interface is the presence of multiple motifs with a central UA-rich element flanked by CA-rich elements. Experiments in single cells and intact flies reveal compromised actin cytoskeletal dynamics associated with low Imp levels. The former shows reduced F-actin formation and the latter exhibits abnormal neuronal patterning. This demonstrates a physiological significance of the defined RNA regulon. CONCLUSIONS: Our data imply that Drosophila Imp RNPs may function as cytoplasmic mRNA assemblages that encode proteins which participate in actin cytoskeletal remodeling. Thus, they may facilitate co-ordinated protein expression in sub-cytoplasmic locations such as growth cones.","author_count":8,"contributors":["Hansen, Heidi Theil","Rasmussen, Simon Horskjær","Adolph, Sidsel Kramshøj","Plass, Mireya","Krogh, Anders","Sanford, Jeremy","Nielsen, Finn Cilius","Christiansen, Jan"],"cuid":["S01-000.00-419717"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"i drosophila i imp iclip identifies an rna assemblage coordinating f actin formation","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s13059-015-0687-0","version":"Published Version"},"id":"S01-000.00-419717","identifier":[{"id":"26054396","type":"pmid"},{"id":"PMC4477473","type":"pmcid"},{"id":"84939182686","type":"scopus"}],"ids":["ku-2c179741-359f-4d18-9327-54cc851d72f8"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-8676B572A96556B99D18FB25A3953AF9"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/156030997/art_3A10.1186_2Fs13059_015_0687_0.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s13059-015-0687-0","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Biology, Computational and RNA Biology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Heidi Theil","key":"hansenpau","last":"Hansen","locid":"17ac5bda-6630-4360-a4a9-9faeefc07921","name":"Hansen, Heidi Theil","rank":1,"rolecode":"pau"},{"affno":"1","first":"Simon Horskjær","key":"rasmussenpau","last":"Rasmussen","locid":"1d3d8554-8895-4ff5-b6f2-8cd7aa419374","name":"Rasmussen, Simon Horskjær","rank":2,"rolecode":"pau"},{"affno":"1","first":"Sidsel Kramshøj","key":"adolphpau","last":"Adolph","locid":"15288cb8-e85b-46c3-a026-5c9ef14f57b9","name":"Adolph, Sidsel Kramshøj","rank":3,"rolecode":"pau"},{"affno":"1","first":"Mireya","key":"plasspau","last":"Plass","locid":"0910ed7c-2582-4dd4-ab89-7f14e6dcd7ed","name":"Plass, Mireya","rank":4,"rolecode":"pau"},{"affno":"1","first":"Anders","key":