":11,"rolecode":"pau"},{"affno":"6 1","corresponding":null,"first":"Daniel I. J.","key":"skoogpau","last":"Skoog","name":"Skoog, Daniel I. J.","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marianne S.","key":"torvangerpau","last":"Torvanger","name":"Torvanger, Marianne S.","rank":13,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kaj-Andreas","key":"hanevikpau","last":"Hanevik","name":"Hanevik, Kaj-Andreas","rank":14,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Sven Emil","key":"hinderakerpau","last":"Hinderaker","name":"Hinderaker, Sven Emil","rank":15,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Thorstein","key":"paulsenpau","last":"Paulsen","name":"Paulsen, Thorstein","rank":16,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Katrine","key":"eldegardpau","last":"Eldegard","name":"Eldegard, Katrine","rank":17,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Trond","key":"reitanpau","last":"Reitan","name":"Reitan, Trond","rank":18,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Graciela","key":"ruschpau","last":"Rusch","name":"Rusch, Graciela","rank":19,"rolecode":"pau"}],"pub":{"doi":"10.1111/ecog.07138","issn":["09067590","16000587"],"issn_org":["09067590"],"issue":"9","journal":"Ecography","paperid":"e07138","publisher":"Wiley-Blackwell Publishing Ltd","status":"p","title":"Ecography","volume":"2024"},"review":"Peer Reviewed","scoID":["2-s2.0-85197245889"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-a0494f57-17e9-4728-937f-e36f532b5014","ku-6d2c2d0c-59e7-462d-af85-f95a4f07655d"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Climatic conditions and landscape diversity predict plant–bee interactions and pollen deposition in bee-pollinated plants","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-098.18-756064","year":"2024","yearsub":"2024"}
{"abstract":"Introduction: Industrial workers with physically demanding work have increased risk of musculoskeletal pain. The present 12-week Goldilocks Work intervention aimed to organize work among industrial workers to comprise a ‘just right’ ergonomic balance of physical behaviors (i.e., sit, stand and active) intended to promote musculoskeletal health. The paper investigates the effectiveness of the intervention in reducing low back pain after work.  Methods: 83 workers across 28 workteams in a biotech organization were recruited. Workteams were randomly allocated to receive the intervention or work as usual (control). Intervention workteams implemented the Goldilocks Work planning tool to organize their work tasks towards a predefined ‘just right’ ergonomic balance (i.e., composition of 60% sitting, 30% standing, 10% active work and hourly task alternation). The primary outcome was low back pain intensity. Secondary outcomes were bodily pain, fatigue, physical exertion, productivity and energy after work measured in the survey, and composition and alternations of physical behaviors measured using wearable sensors.  Results: The intervention was delivered almost as planned, with good quality and high adherence among most workteams. However, the intervention did not change physical behaviors towards the intended ‘just right’ ergonomic balance. No significant reduction in low back pain (0.07, CI 95%: −0.68; 0.82), bodily pain (0.10, CI 95%: −0.57; 0.76), tiredness (−0.53, CI 95%: −1.24; 0.19), physical exertion (−0.18, CI 95%: −0.83; 0.48), or improvement in energy (0.39, CI 95%: −1.02; 0.23) or productivity (−0.03, CI 95%: −0.77; 0.72) were found.  Conclusion: This Goldilocks Work intervention did not promote musculoskeletal health among industrial workers and did not change physical behaviors as intended. Thus, more research is needed into implementation strategies to change physical behaviors during productive work towards an evidence-based ‘just right’ ergonomic balance.","author_count":7,"contributors":["Lerche, Anders Fritz","Erik Mathiassen, Svend","Lund Rasmussen, Charlotte","Straker, Leon","Holtermann, Andreas","Søgaard, Karen"],"cuid":["S02-098.35-769442"],"filters":{"added":"2024-11","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","Nordic","OECD","Oceania"],"corresponding_author":["Lerche, Anders Fritz"],"country":["Australia","Sweden"],"glorg":["All Global Affiliations","Curtin University","University of Gävle"],"keyword":["Industri","Interventioner","Muskelskeletbesvær","Sundhedsmiljø"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-WORK"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-GV-WORK","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"effectiveness of a goldilocks work intervention to promote musculoskeletal health among industrial workers a cluster randomized controlled trial","src":["nfa","sdu"],"src-code":["DI-GV-WORK","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.jsr.2024.05.006","version":"Published Version"},"id":"S02-098.35-769442","identifier":[{"id":"39251295","type":"pmid"},{"id":"85194088748","type":"scopus"}],"ids":["nfa-2c70f2b3-e01f-433f-b351-3314503343b3","sdu-e2026f2f-bf08-4c27-b881-a730f44e319c"],"keyword":["Industri","Interventioner","Muskelskeletbesvær","Sundhedsmiljø"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-6E461D24B75BDDE0106D46CD01CA52F8"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.jsr.2024.05.006","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/272196947/1-s2.0-S0022437524000598-main.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics, Research Unit of Physical Activity and Health in Working life"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"nfa national research centre for the working environment","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-WORK","l3nn":"NFA National Research Centre for the Working Environment","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"NFA National Research Centre for the Working Environment","namevar":["National Research Centre for the Working Environment"],"nora_code":"DI-GV-WORK","used":1},{"affno":"3","country":"se","key":"university of gävle","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"University of Gävle","used":1},{"affno":"4","country":"au","key":"curtin university","loc":["Australia","Oceania","OECD"],"name":"Curtin University","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Anders","key":"fritzlerchepau","last":"Fritz Lerche","locid":"8ca85f92-8c87-439e-86fc-e2ca9cd5bbcb","name":"Lerche, Anders Fritz","name_org":"Fritz Lerche, Anders","orcid":"0000-0002-3199-6571","rank":1,"rolecode":"pau"},{"affno":"2 1","corresponding":null,"first":"Anders Fritz","key":"lerchepau","last":"Lerche","name":"Lerche, Anders Fritz","rank":1,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Svend","key":"erikmathiassenpau","last":"Erik Mathiassen","name":"Erik Mathiassen, Svend","rank":2,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Charlotte","key":"lundrasmussenpau","last":"Lund Rasmussen","name":"Lund Rasmussen, Charlotte","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Leon","key":"strakerpau","last":"Straker","name":"Straker, Leon","rank":4,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Andreas","key":"holtermannpau","last":"Holtermann","locid":"f0d131d6-aefa-4dd3-a64e-2e237f273adf","name":"Holtermann, Andreas","orcid":"0000-0003-4825-5697","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Karen","key":"søgaardpau","last":"Søgaard","locid":"01571423-fcd0-4dbc-9112-e9b52d4a1131","name":"Søgaard, Karen","orcid":"0000-0003-3968-6364","rank":6,"rolecode":"pau"}],"pmid":["39251295"],"pub":{"doi":"10.1016/j.jsr.2024.05.006","issn":["00224375","18791247"],"issn_org":["00224375"],"journal":"Journal of Safety Research","pages":"392-401","publisher":"Elsevier Limited","status":"p","title":"Journal of Safety Research","volume":"90"},"review":"Peer Reviewed","scoID":["2-s2.0-85194088748"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["nfa-2c70f2b3-e01f-433f-b351-3314503343b3","sdu-e2026f2f-bf08-4c27-b881-a730f44e319c"],"src":["NFA National Research Centre for the Working Environment","SDU University of Southern Denmark"],"title":"Effectiveness of a Goldilocks work intervention to promote musculoskeletal health among industrial workers – A cluster randomized controlled trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-098.35-769442","year":"2024","yearsub":"2024"}
{"abstract":"Impalas are unusual among bovids because they have remained morphologically similar over millions of years—a phenomenon referred to as evolutionary stasis. Here, we sequenced 119 whole genomes from the two extant subspecies of impala, the common (Aepyceros melampus melampus) and black-faced (A. m. petersi) impala. We investigated the evolutionary forces working within the species to explore how they might be associated with its evolutionary stasis as a taxon. Despite being one of the most abundant bovid species, we found low genetic diversity overall, and a phylogeographic signal of spatial expansion from southern to eastern Africa. Contrary to expectations under a scenario of evolutionary stasis, we found pronounced genetic structure between and within the two subspecies with indications of ancient, but not recent, gene flow. Black-faced impala and eastern African common impala populations had more runs of homozygosity than common impala in southern Africa, and, using a proxy for genetic load, we found that natural selection is working less efficiently in these populations compared to the southern African populations. Together with the fossil record, our results are consistent with a fixed-optimum model of evolutionary stasis, in which impalas in the southern African core of the range are able to stay near their evolutionary fitness optimum as a generalist ecotone species, whereas eastern African impalas may struggle to do so due to the effects of genetic drift and reduced adaptation to the local habitat, leading to recurrent local extinction in eastern Africa and re-colonisation from the South.","author_count":20,"contributors":["Garcia-Erill, Genís","Wang, Xi","Rasmussen, Malthe S","Quinn, Liam","Khan, Anubhab","Bertola, Laura D","Santander, Cindy G","Balboa, Renzo F","Ogutu, Joseph O","Pečnerová, Patrícia","Hanghøj, Kristian","Kuja, Josiah","Nursyifa, Casia","Masembe, Charles","Muwanika, Vincent","Bibi, Faysal","Moltke, Ida","Siegismund, Hans R","Albrechtsen, Anders","Heller, Rasmus"],"cuid":["S02-099.11-767687"],"filters":{"added":"2025-01","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Africa","Europe, EU","OECD"],"corresponding_author":["Garcia-Erill, Genís","Heller, Rasmus"],"country":["Germany","Uganda"],"glorg":["All Global Affiliations","Makerere University","Museum für Naturkunde - Leibniz Institute for Evolution and Biodiversity Science","University of Hohenheim"],"keyword":["Phylogeography","Population genetics","Whole genome sequencing","evolutionary stasis","impala"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"extensive population structure highlights an apparent paradox of stasis in the impala i aepyceros melampus i","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1111/mec.17539","version":"Published Version"},"id":"S02-099.11-767687","identifier":[{"id":"85205938993","type":"scopus"},{"id":"39373069","type":"pmid"}],"ids":["au-96fb671d-757b-400d-a328-7625e6fccce6","ku-66d8a804-c25a-4ba9-8d15-f0c4c2073ddf"],"keyword":["evolutionary stasis","impala","phylogeography","population genetics","whole genome sequencing"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-791038E72DD936E6EC7950A4E45C392F"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/411365262/Molecular_Ecology_2024_Garcia_Erill_Extensive_Population_Structure_Highlights_an_Apparent_Paradox_of_Stasis_in_the.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1111/mec.17539","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Molecular Biology and Genetics, Department of Molecular Biology and Genetics - Bioinformatics Research Centre (BiRC)"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"de","key":"university of hohenheim","loc":["Germany","Europe, EU","OECD"],"name":"University of Hohenheim","used":1},{"affno":"4","country":"ug","key":"makerere university","loc":["Uganda","Africa"],"name":"Makerere University","used":1},{"affno":"5","country":"de","key":"museum für naturkunde leibniz institute for evolution and biodiversity science","loc":["Germany","Europe, EU","OECD"],"name":"Museum für Naturkunde - Leibniz Institute for Evolution and Biodiversity Science","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"Genís","key":"garciaerillpau","last":"Garcia-Erill","locid":"323466a0-0cd7-4f87-b1ca-9ea7e8265a0c","name":"Garcia-Erill, Genís","rank":1,"rolecode":"pau"},{"affno":"2","first":"Xi","key":"wangpau","last":"Wang","locid":"d0fc1120-7616-46cb-b5b4-ce21bf462b4d","name":"Wang, Xi","rank":2,"rolecode":"pau"},{"affno":"2","first":"Malthe S","key":"rasmussenpau","last":"Rasmussen","locid":"c78f599c-157c-4a9a-9e7a-ab1d876ab28c","name":"Rasmussen, Malthe Sebro","name_org":"Rasmussen, Malthe S","rank":3,"rolecode":"pau"},{"affno":"2","first":"Liam","key":"quinnpau","last":"Quinn","locid":"51f8bb78-3a6e-4579-9b13-a376374277dc","name":"Quinn, Liam