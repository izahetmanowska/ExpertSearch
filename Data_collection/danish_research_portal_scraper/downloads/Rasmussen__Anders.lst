{"abstract":"We demonstrate transmission of a 1.28-Tbaud Nyquist-OTDM signal over a record distance of 100 km with detection by time-domain optical Fourier transformation followed by FEC decoding, resulting in error-free performance for all tributaries.","author_count":12,"contributors":["Hu, Hao","Kong, Deming","Palushani, Evarist","Andersen, Jakob Dahl","Rasmussen, Anders","Sørensen, Brian Michael","Galili, Michael","Mulvad, Hans Christian Hansen","Larsen, Knud J.","Forchhammer, Søren","Jeppesen, Palle","Oxenløwe, Leif Katsuo"],"cuid":["S01-000.00-338106"],"event":{"end":"2013-06-14","place":"San Jose, us","start":"2013-06-09","title":"2013 Conference on Lasers and Electro-Optics","year":"2013"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Fiber optics communications","Nonlinear optical signal processing","Nonlinear optics four wave mixing"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"000000000001 000000000028 tbaud nyquist signal transmission using time domain optical fourier transformation based receiver","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1364/CLEO_SI.2013.CTh5D.5","version":"Other Version"},"id":"S01-000.00-338106","identifier":[{"id":"84887469793","type":"scopus"}],"ids":["dtu-70589de9-8b4c-4cf1-adf8-a6c783035b47"],"keyword":["Fiber optics communications","Nonlinear optical signal processing","Nonlinear optics, four-wave mixing"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-5F3881DC8FDD4480A877F0615BEBDD18"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1364/CLEO_SI.2013.CTh5D.5","version":"Other Version"}],"org":[{"affno":"1","key":"dtu technical unive