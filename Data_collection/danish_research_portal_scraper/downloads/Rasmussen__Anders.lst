","name":"Winstrup, Mai","orcid":"0000-0002-4794-4004","rank":3,"rolecode":"pau"}],"pub":{"issue":"1","journal":"PAGES Magazine","pages":"26-27","status":"p","title":"PAGES Magazine","volume":"22"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-2527f3c6-d0b6-41f0-9f87-c998c638260f"],"src":["KU University of Copenhagen"],"title":"State of the art of ice core annual layer dating","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-415608","year":"2014","yearsub":"2014"}
{"abstract":"Two open reading frames in the genome of Sulfolobus solfataricus (SSO2341 and SSO2424) were cloned and expressed in E. coli. The protein products were purified and their enzymatic activity characterized. Although SSO2341 was annotated as a gene (gpT-1) encoding a 6-oxopurine phosphoribosyltransferase (PRTase), the protein product turned out to be a PRTase highly specific for adenine and we suggest that the reading frame should be renamed apT. The other reading frame SSO2424 (gpT-2) proved to be a true 6-oxopurine PRTase active with hypoxanthine, xanthine and guanine as substrates, and we suggest that the gene should be renamed gpT. Both enzymes exhibited unusual profiles of activity versus pH. The adenine PRTase showed the highest activity at pH 7.5-8.5, but had a distinct peak of activity also at pH 4.5. The 6-oxo PRTase showed maximal activity with hypoxanthine and guanine around pH 4.5, while maximal activity with xanthine was observed at pH 7.5. We discuss likely reasons why SSO2341 in S. solfataricus and similar open reading frames in other Crenarchaeota could not be identified as genes encoding APRTase.","author_count":6,"contributors":["Hansen, Michael Riis","Jensen, Kristine Steen","Rasmussen, Mads Skytte","Christoffersen, Stig","Kadziola, Anders","Jensen, Kaj Frank"],"cuid":["S01-000.00-459415"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","Nordic","OECD"],"country":["Norway"],"glorg":["All Global Affiliations","University of Tromsø – The Arctic University of Norway"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"specificities and ph profiles of adenine and hypoxanthine guanine xanthine phosphoribosyltransferases nucleotide synthases of the thermoacidophile archaeon em sulfolobus solfataricus em","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s00792-013-0595-8","version":"Other Version"},"id":"S01-000.00-459415","identifier":[{"id":"84890569001","type":"scopus"},{"id":"24158498","type":"pmid"}],"ids":["ku-6e70077e-da68-4a10-bd47-b2b3761a70d5"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-96178C39944A526DE7D49EA8042F9418"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s00792-013-0595-8","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Biology, Biomolecular Sciences"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"no","key":"university of tromsø the arctic university of norway","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"University of Tromsø – The Arctic University of Norway","used":1}],"person":[{"affno":"1","first":"Michael Riis","key":"hansenmichaelriispau","last":"Hansen","locid":"27756a58-225d-413a-a719-471d125931b6","name":"Hansen, Michael Riis","orcid":"0000-0003-1684-8578","rank":1,"rolecode":"pau"},{"affno":"1","first":"Kristine Steen","key":"jensenkristinesteenpau","last":"Jensen","locid":"fcefd079-c1d1-4cb9-9056-56349b0dece9","name":"Jensen, Kristine Steen","rank":2,"rolecode":"pau"},{"affno":"2","first":"Mads Skytte","key":"rasmussenmadsskyttepau","last":"Rasmussen","name":"Rasmussen, Mads Skytte","rank":3,"rolecode":"pau"},{"affno":"1","first":"Stig","key":"christoffersenstigpau","last":"Christoffersen","locid":"b8ffb321-6fe4-4441-b5f2-5370460579e1","name":"Ch