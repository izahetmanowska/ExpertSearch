{"abstract":"Kapitlet søger at identificere den særlige form for institutionalisering af vidensproduktionen i socialt arbejde, der præger den aktuelle situation og diskuterer centrale dilemmaer knyttet til dette.","author_count":6,"contributors":["Rasmussen, Tove","Christensen, Anders Bøggild"],"cuid":["S01-000.00-657454"],"filters":{"added":"2023-08","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Sociologi"],"level":"pop","oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-UC"],"level3":{"UC":["DI-UC-ALL","DI-UC-VIA"]},"level3all":["DI-UC-VIA"]},"review":"und","rtype":["clu"],"sorti":"vidensproduktion og viden i socialt arbejde","src":["via"],"src-code":["DI-UC-VIA"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-657454","ids":["via-5b186f29-35d4-4274-8daa-300d4eb22e00"],"keyword":["sociologi"],"lang":"Danish","level":"Popular","noi":["Local-1-1-DEB36DA76307E4C59840E6EEEDF7313A"],"org":[{"affno":"1","key":"via university college","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-VIA","l3nl":"VIA University College","l3nn":"VIA University College","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"VIA University College","namevar":["VIA, Forskning og udvikling, Forsk.center Pædagogik og dannelse","VIA, Uddannelser, Social- og samfundsuddannelserne, Socialrådgiveruddannelsen Aarhus C"],"nora_code":"DI-UC-VIA","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Tove","key":"rasmussenpau","last":"Rasmussen","locid":"5b42d1f0-0ade-42de-b87e-72e91f26d0af","name":"Rasmussen, Tove","orcid":"0000-0002-6599-884X","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders Bøggild","key":"christensenpau","last":"Christensen","locid":"15d3eb85-8ffe-4c32-b970-43d444374d12","name":"Christensen, Anders Bøggild","rank":2,"rolecode":"pau"},{"affno":"","first":"Søren Peter","key":"olesenpedh","last":"Olesen","name":"Olesen, Søren Peter","rank":3,"role":"Editor of