no":"6","corresponding":null,"first":"Marie","key":"bækvadhansenpau","last":"Bækvad-Hansen","name":"Bækvad-Hansen, Marie","rank":5,"rolecode":"pau"},{"affno":"7","first":"Anders","key":"juulpau","last":"Juul","locid":"f9b11983-c7c8-4111-b119-4de471572898","name":"Juul, Anders","orcid":"0000-0002-0534-4350","rank":6,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Luise","key":"borchpau","last":"Borch","locid":"597937e0-c71d-483a-8b91-8300e9fc4a5f","name":"Borch, Luise","orcid":"0000-0003-1054-0601","rank":7,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Niels","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, Niels","rank":8,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Åse K.","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Åse K.","rank":9,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Marianne","key":"andersenpau","last":"Andersen","locid":"94aa4e0a-b026-469f-a635-4bad008d49d7","name":"Andersen, Marianne","orcid":"0000-0002-4603-9504","rank":10,"rolecode":"pau"},{"affno":"7","first":"Katharina M.","key":"mainpau","last":"Main","locid":"1770eebd-1659-4088-b44c-c9de22a4bb0b","name":"Main, Katharina M.","rank":11,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Dorte","key":"hansenpau","last":"Hansen","locid":"20f8509d-8af4-4a9b-81d6-d51820e52835","name":"Hansen, Dorte","orcid":"0000-0002-6598-9740","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Claus H.","key":"gravholtpau","last":"Gravholt","locid":"22ab3957-d834-426e-8ba5-3d45496b0d2a","name":"Gravholt, Claus Højbjerg","name_org":"Gravholt, Claus H.","rank":13,"rolecode":"pau"}],"pmid":["36891552"],"pub":{"doi":"10.1016/j.lanepe.2023.100598","issn":["26667762"],"journal":"The Lancet Regional Health - Europe","paperid":"100598","publisher":"Elsevier","status":"p","title":"The Lancet Regional Health - Europe","volume":"28"},"review":"Peer Reviewed","scoID":["2-s2.0-85149254529"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-e9603de4-fb75-46b6-879f-4d4fa4362910","ku-4c6d25ad-f9d6-4d71-a1d9-91cfd8bdc6ec","sdu-7261b5fd-fd01-484f-a332-f8c184f85d8a"],"src":["AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Epidemiology and diagnostic trends of congenital adrenal hyperplasia in Denmark : a retrospective, population-based study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-100.00-672820","year":"2023","yearsub":"2023"}
{"abstract":"The impact of left ventricle (LV) hypertrophy (LVH) regression on contractility-associated measures, the extent of residual cardiac dysfunction and prognostic implications after the initial remodeling process after transcatheter aortic valve replacement (TAVR) has not been investigated. We aimed to assess whether greater LV mass regression from pre-TAVR to 12-months after TAVR was associated with increased systolic function; and assess the prognostic value of residual LVH, systolic function and contractility-associated measures 12-months after TAVR. A total of 439 symptomatic patients were included and examined by echocardiography. LVH regression was assessed as percentage change in LV mass index (LVMi) from baseline to 12-months after TAVR. Midwall fractional shortening (mFS) and stress-corrected (SC-mFS) were used as contractility-associated measures. Primary outcome was all-cause mortality. SC-mFS increased from 0.94 (0.7) at baseline (BS) to 1.22 (0.7) (p < 0.05) 12-months after TAVR for patients with the most LVH regression, compared to patients with no LV regression (BS 1.06 (0.7) to 1.04 (0.5), NS). At 12-months after TAVR, multivariate analysis showed independent prognostic value of LVEF < 50% or GLS < 15% (HR 1.59, p = 0.049) and mFS < 14% (HR 1.99, p = 0.002) for future all cause death. LVH regression in AS after TAVR is associated with significant improvements of LV systolic function in contrast to patients without LV regression. Residual LVH and subsequent LV systolic dysfunction is substantial 12 months after TAVR and are associated with reduced survival. Impaired mFS and the combination of abnormal LVEF or GLS independently predicted all-cause mortality beyond 12 months after TAVR.","author_count":8,"contributors":["Pedersen, Anders Lehmann Dahl","Povlsen, Jonas Agerlund","Rasmussen, Vibeke Guldbrand","Frederiksen, Christian Alcaraz","Christiansen, Evald Høj","Terkelsen, Christian Juhl","Vase, Henrik","Poulsen, Steen Hvitfeldt"],"cuid":["S01-000.00-163704"],"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Pedersen, Anders Lehmann Dahl"],"keyword":["Aortic Valve Stenosis diagnostic imaging","Aortic Valve diagnostic imaging","Aortic stenosis","Contractility","Echocardiography","Humans","Hypertrophy Left Ventricular diagnostic imaging","Predictive Value of Tests","Prognosis","Severity of Illness Index","Transcatheter Aortic Valve Replacement adverse effects","Transcatheter aortic valve replacement","Treatment Outcome","Ventricular Function Left"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"prognostic implications of residual left ventricular hypertrophy and systolic dysfunction in aortic stenosis following transcatheter aortic valve replacement","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85134532772","version":"Other Version"},"id":"S01-000.00-163704","identifier":[{"id":"36598683","type":"pmid"},{"id":"85134532772","type":"scopus"}],"ids":["au-3c44105b-d9a7-4555-a929-a6fc00ad02e2"],"keyword":["Aortic Valve Stenosis/diagnostic imaging","Aortic Valve/diagnostic imaging","Aortic stenosis","Contractility","Echocardiography","Humans","Hypertrophy, Left Ventricular/diagnostic imaging","Predictive Value of Tests","Prognosis","Severity of Illness Index","Transcatheter Aortic Valve Replacement/adverse effects","Transcatheter aortic valve replacement","Treatment Outcome","Ventricular Function, Left"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-85F70653C8F985E05AACA5141C80800E"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Cardiological Medicine B"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Anders Lehmann Dahl","key":"pedersenpau","last":"Pedersen","locid":"7e7debe0-e391-4c37-9cbd-c136c98fc08a","name":"Pedersen, Anders Lehmann Dahl","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jonas Agerlund","key":"povlsenpau","last":"Povlsen","locid":"a8131022-196c-4691-b4d5-1b11d623a4ff","name":"Povlsen, Jonas Agerlund","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Vibeke Guldbrand","key":"rasmussenpau","last":"Rasmussen","locid":"060a99a8-79d9-4755-bd97-85fb1041e8cf","name":"Rasmussen, Vibeke Guldbrand","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Christian Alcaraz","key":"frederiksenpau","last":"Frederiksen","locid":"b2d59fc7-cf97-4468-8b89-6cd3c7773ce3","name":"Frederiksen, Christian Alcaraz","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Evald Høj","key":"christiansenpau","last":"Christiansen","locid":"06b04feb-3d2f-402d-b211-7ad5fd0387f1","name":"Christiansen, Evald Høj","orcid":"0000-0002-8740-4862","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Christian Juhl","key":"terkelsenpau","last":"Terkelsen","locid":"c0d7f995-6ff2-458e-996a-e9a0fccd663f","name":"Terkelsen, Christian Juhl","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik","key":"vasepau","last":"Vase","locid":"aac9f515-f357-49af-b2df-84200398112b","name":"Vase, Henrik","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Steen Hvitfeldt","key":"poulsenpau","last":"Poulsen","locid":"ec1d0fd4-f6ae-4071-907f-1448dfe832fe","name":"Poulsen, Steen Hvitfeldt","orcid":"0000-0002-9586-835X","rank":8,"rolecode":"pau"}],"pmid":["36598683"],"pub":{"doi":"10.1007/s10554-022-02688-8","issn":["15695794","18758312"],"issn_org":["15695794"],"issue":"1","journal":"The International Journal of Cardiovascular Imaging","pages":"13-22","publisher":"Springer Science and Business Media BV","publisher_org":"Springer Science and Business Media B.V.","status":"p","title":"The International Journal of Cardiovascular Imaging","title_org":"International Journal of Cardiovascular Imaging","volume":"39"},"review":"Peer Reviewed","scoID":["2-s2.0-85134532772"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-3c44105b-d9a7-4555-a929-a6fc00ad02e2"],"src":["AU Aarhus University"],"title":"Prognostic implications of residual left ventricular hypertrophy and systolic dysfunction in aortic stenosis following transcatheter aortic valve replacement","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-163704","year":"2023","yearsub":"2023"}
{"abstract":"Aim: To study the effect of naturalistic light, programmed to replicate the spectrum distribution of natural light from dusk to dawn, on agitation measured with a Cohen-Mansfield Agitation Inventory–inspired score of nursing home residents with dementia. Background: Though the effects of different types of light on the sleep-wake patterns of senior adults and people with dementia have been examined in several studies, the effects of naturalistic light systems, as a possible nonpharmacological intervention to improve sleep and reduce agitation, have yet to be extensively evaluated due to the relative novelty of the technology. Methods: The study was designed as a 6-month pilot study of a prospective interventional longitudinal cohort study, with five participants recruited from a single department of a Danish nursing home. The effect of naturalistic lighting on agitation-associated behaviors was recorded over a 3-day period pre- and postintervention. Results: An overall 71.2% reduction in the frequency of agitation-associated behaviors was recorded, with the frequency of some behaviors even reduced by 100%. Conclusions: This pilot study estimates that naturalistic lighting may be a promising nonpharmacological intervention to improve the overall agitation of nursing home residents with dementia, with a possible added benefit of an improved work environment for the staff. This study, therefore, finds indication for the performance of a randomized controlled trial with the same intervention and a larger cohort.","author_count":5,"contributors":["Saidane, Hafed Amin","Rasmussen, Thomas","Andersen, Knud","Iversen, Helle Klingenberg","West, Anders Sode"],"cuid":["S01-000.00-678932"],"filters":{"added":"2023-08","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Dementia","Experimental"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"OT":["The Administration of the Elderly and Disabled"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"an explorative investigation of the effect of naturalistic light on agitation associated behavior in nursing home residents with dementia a pilot study","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-678932","identifier":[{"id":"85145482292","type":"scopus"},{"id":"36573255","type":"pmid"}],"ids":["ku-b1744386-d650-42a3-a488-4f8d3a8c05f1"],"keyword":["dementia","environment of care","experimental","natural light"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-F0CE2A009F572423097727358A39117F"],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["The Administration of the Elderly and Disabled"],"nora_code":"DI-OT","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Neurology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Hafed Amin","key":"saidanepau","last":"Saidane","name":"Saidane, Hafed Amin","rank":1,"rolecode":"pau"},{"affno":"2","first":"Thomas","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Thomas","rank":2,"rolecode":"pau"},{"affno":"2","first":"Knud","key":"andersenpau","last":"Andersen","name":"Andersen, Knud","rank":3,"rolecode":"pau"},{"affno":"3","first":"Helle Klingenberg","key":"iversenpau","last":"Iversen","locid":"02552302-5333-48e0-acde-b9a821eab783","name":"Iversen, Helle Klingenberg","rank":4,"rolecode":"pau"},{"affno":"1","first":"Anders Sode","key":"westpau","last":"West","name":"West, Anders Sode","rank":5,"rolecode":"pau"}],"pmid":["36573255"],"pub":{"doi":"10.1177/19375867221146154","issn":["19375867","21675112"],"issn_org":["19375867"],"issue":"2","journal":"HERD: Health Environments Research & Design Journal","pages":"146-154","status":"p","title":"HERD: Health Environments Research & Design Journal","title_org":"Health Environments Research and Design Journal","volume":"16"},"review":"Peer Reviewed","scoID":["2-s2.0-85145482292"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-b1744386-d650-42a3-a488-4f8d3a8c05f1"],"src":["KU University of Copenhagen"],"title":"An Explorative Investigation of the Effect of Naturalistic Light on Agitation-Associated Behavior in Nursing Home Residents With Dementia : A Pilot Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-678932","year":"2023","yearsub":"2023"}
{"abstract":"This chapter takes as its point ofdeparture the mandatory course, Nar¬rative Medicine, introduced on the medical program of the University of Southern Denmark and uses it to discuss the importance of the humanities and art to medical education. The chapter starts by presenting two aims of narrative medicine as an academic field: physicians' empathy with their patients and physicians' improved self-care. The first part of the chapter de-scribes the hypotheses, methods and aims of narrative medicine. Methods of close reading and creative writing provide training for a sharpened recep¬tivity towards and understanding of what patients are trying to say about their illness. Against a background aim of increasing or maintaining the nar¬rative sensitivity of physicians, the chapter discusses a variety of studies in empathy research. The second part of the chapter focuses on the doctors' need for self-care. The opportunity to create a recreational space for reflec-tion can be found, for example, in Rita Charon's idea of keeping a \"parallel journal\" or through reading ofauthors like the physician Richard Selzer. The chapter's intention is to present humanist methods and art as essential parts ofmedical education and, more specifically, to promote an accep¬tance ofnarrative medicine as being more than an add-on to the medical student's \"evidence-based\" program.","author_count":5,"contributors":["Rasmussen, Anders Juhl","Sodemann, Morten"],"cuid":["S01-000.00-680026"],"filters":{"added":"2023-08","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Empati","Evidens","Narrativ medicin"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"prescribing stories before medicine narrative medicine in the teaching of medical students and physicians","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85180382675","version":"Other Version"},"id":"S01-000.00-680026","identifier":[{"id":"85180382675","type":"scopus"}],"ids":["sdu-0aaef22c-a2d3-4c85-b124-849e6bd0272f"],"keyword":["Narrativ medicin","empati","evidens"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-2-909B5011285EDDE4650F542CCD337AFB"],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Humanities, Department of Culture and Language"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anders Juhl","key":"rasmussenpau","last":"Rasmussen","locid":"6612df8e-d9f9-4004-b959-a9c30b0762a5","name":"Rasmussen, Anders Juhl","orcid":"0000-0001-7718-5208","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Morten","key":"sodemannpau","last":"Sodemann","locid":"e4e58879-7d72-4665-880c-38ad97d0ebe5","name":"Sodemann, Morten","orcid":"0000-0001-8992-2500","rank":2,"rolecode":"pau"},{"affno":"","first":"Anders","key":"juhlrasmussenpedh","last":"Juhl Rasmussen","name":"Juhl Rasmussen, Anders","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Anne-Marie","key":"maipedh","last":"Mai","name":"Mai, Anne-Marie","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Helle","key":"ploughansenpedh","last":"Ploug Hansen","name":"Ploug Hansen, Helle","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"eisbn":["9781839988172"],"isbn":["9871839988165"],"pages":"67-83","place":"London","publisher":"Anthem Press","status":"p","title":"Narrative medicine in education, practice, and interventions"},"review":"Peer Reviewed","scoID":["2-s2.0-85180382675"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-0aaef22c-a2d3-4c85-b124-849e6bd0272f"],"src":["SDU University of Southern Denmark"],"title":"Prescribing Stories before Medicine : Narrative Medicine in the Teaching of Medical Students and Physicians","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-680026","year":"2023","yearsub":"2023"}
{"abstract":"Creative writing is increasingly employed in healthcare, but knowledge of patients’ experiences and the benefits of creative writing is limited. This chapter presents findings from a qualitative evaluation of an intervention offering creative writing workshops to people with chronic illnesses in Denmark. The purpose was to assess how facilitated creative writing can benefit people in rehabilitation. Data were produced through an ethnographic fieldwork at four creative writing workshops, and the analysis was based on theories of agency. Under the theme “the participants’ experiences of performing creative writing and its benefits,” three subthemes were identified: 1) being guided by the pen, 2) providing food for thought, and 3) the written text as a medium. Participants experienced that their texts gained agency. The texts stimulated reflection and inspired meaningful conversations with relatives. The authors conclude that facilitated creative writing benefits participants’ rehabilitative efforts by instigating a process potentially leading to reconfigurations of the writer’s self.","author_count":6,"contributors":["Laursen, Sara Seerup","Rasmussen, Anders Juhl","Andersen, Tine Riis","Hansen, Helle Ploug"],"cuid":["S01-000.00-680448"],"filters":{"added":"2023-08","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","Nordic","OECD"],"country":["Norway"],"glorg":["All Global Affiliations","University of Stavanger"],"keyword":["Kreativ skrivning","Kronisk sygdom","Narrativ medicin"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Ukendt"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"it really just wrote itself facilitated creative writing for people with chronic illness","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85167745990","version":"Other Version"},"id":"S01-000.00-680448","identifier":[{"id":"85167745990","type":"scopus"}],"ids":["sdu-81ff98fc-d3ef-4254-bd64-917fda0c25b0"],"keyword":["Kreativ skrivning","Kronisk sygdom","Narrativ medicin"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-4-30028739E1ABC21CE738DFEB9A44CEA1"],"org":[{"affno":"1","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Ukendt"],"nora_code":"DI-OT","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Humanities, Department of Culture and Language"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","country":"no","key":"university of stavanger","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"University of Stavanger","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Sara Seerup","key":"laursenpau","last":"Laursen","name":"Laursen, Sara Seerup","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Anders Juhl","key":"rasmussenpau","last":"Rasmussen","locid":"6612df8e-d9f9-4004-b959-a9c30b0762a5","name":"Rasmussen, Anders Juhl","orcid":"0000-0001-7718-5208","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Tine Riis","key":"andersenpau","last":"Andersen","name":"Andersen, Tine Riis","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Helle Ploug","key":"hansenpau","last":"Hansen","locid":"aff3454d-836b-44db-9a85-391f83361116","name":"Hansen, Helle Ploug","orcid":"0000-0002-5075-8739","rank":4,"rolecode":"pau"},{"affno":"","first":"Teresa","key":"casalpedh","last":"Casal","name":"Casal, Teresa","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Maria","key":"dejesuscabralpedh","last":"de Jesus Cabral","name":"de Jesus Cabral, Maria","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.4018/978-1-6684-8064-9.ch007","eisbn":["9781668480656"],"isbn":["9781668480649"],"pages":"97-112","place":"Hershey","publisher":"IGI global","status":"p","title":"Global Perspectives on Probing Narratives in Healthcare"},"review":"Peer Reviewed","scoID":["2-s2.0-85167745990"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-81ff98fc-d3ef-4254-bd64-917fda0c25b0"],"src":["SDU University of Southern Denmark"],"title":"\"It Really Just Wrote Itself\" : Facilitated Creative Writing for People With Chronic Illness","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-680448","year":"2023","yearsub":"2023"}
{"abstract":"Alcoholic liver cirrhosis (ALC) is accompanied by sarcopenia. The aim of this study was to investigate the acute effects of balanced parenteral nutrition (PN) on skeletal muscle protein turnover in ALC. Eight male patients with ALC and seven age- and sex-matched healthy controls were studied for three hours of fasting followed by three hours of intravenous PN (SmofKabiven 1206 mL: Amino acid 38 g, carbohydrates 85 g, fat 34 g) 4 ml/kg/hour. We measured leg blood flow, sampled paired femoral arterio-venous concentrations and quadriceps muscle biopsies while providing a primed continuous infusion of [ring-2D5]-phenylalanine to quantify muscle protein synthesis and breakdown. Patients with ALC exhibited shorter 6-min walking distance (ALC: 487 ± 38 vs. controls: 722 ± 14 m, p<0.05), lower hand-grip strength (ALC: 34 ± 2 vs. controls: 52 ± 2 kg, p<0.05), and CT-verified leg muscle loss (ALC: 5922 ± 246 vs. controls: 8110 ± 345 mm2, p<0.05). Net leg muscle phenylalanine uptake changed from negative (muscle loss) during fasting to positive (muscle gain) in response to PN (ALC: -0.18 ± +0.01 vs. 0.24 ± 0.03 µmol/kg muscle*min-1; p <0.001 and controls: -0.15 ± 0.01 vs. 0.09 ± 0.01 µmol/kg muscle*min-1; p <0.001), but with higher net muscle phenylalanine uptake in ALC than controls (p <0.001). Insulin concentrations were substantially higher in ALC patients during PN. Our results suggest a higher net muscle phenylalanine uptake during a single infusion of PN in stable ALC patients with sarcopenia compared with healthy controls.","author_count":10,"contributors":["Iepsen, Ulrik Winning","Rinnov, Anders Rasmussen","Munch, Gregers Winding","Rugbjerg, Mette","Winding, Kamilla Munch","Lauridsen, Carsten","Berg, Ronan M.G.","Pedersen, Bente Klarlund","Gluud, Lise Lotte","van Hall, Gerrit"],"cuid":["S01-000.00-683778"],"filters":{"added":"2023-09","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of Glamorgan, Pontypridd, UK"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U","DI-UC"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"],"UC":["DI-UC-ALL","DI-UC-KP"]},"level3all":["DI-HO-CAP","DI-U-KU","DI-UC-KP"]},"review":"pr","rtype":["clu"],"sorti":"skeletal muscle protein turnover responses to parenteral nutrition in patients with alcoholic liver cirrhosis and sarcopenia","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/360394233/IKM_ajpgi.00242.2022.pdf","version":"Authors Final Version"},"id":"S01-000.00-683778","identifier":[{"id":"85166393444","type":"scopus"},{"id":"37339940","type":"pmid"}],"ids":["ku-260fb3aa-27d3-4b04-8f32-5fc74de3daac"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-3-5-C7FCFBC54DBD43995528527FFF7AD5AF"],"oa_link":[{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/360394233/IKM_ajpgi.00242.2022.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Bispebjerg and Frederiksberg","Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","country":"dk","key":"kp university college copenhagen","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-KP","l3nl":"KP","l3nn":"KP University College Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KP University College Copenhagen","namevar":["University College Copenhagen (KP)"],"nora_code":"DI-UC-KP","used":1},{"affno":"3","key":"ku university o