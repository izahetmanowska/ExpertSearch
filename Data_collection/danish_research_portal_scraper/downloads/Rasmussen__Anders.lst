responding":null,"country":"dk","first":"Lene Hjerrild","key":"iversenlenehjerrildpau","last":"Iversen","locid":"4d8ada79-98c2-49eb-ac2f-472b41434eff","name":"Iversen, Lene Hjerrild","orcid":"0000-0002-2336-2923","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren","key":"laurbergsørenpau","last":"Laurberg","locid":"fde493d2-685c-4530-8791-614babb5ff72","name":"Laurberg, Søren","rank":12,"rolecode":"pau"},{"affno":"","first":"Ib Jarle","key":"christensenibjarlepau","last":"Christensen","name":"Christensen, Ib Jarle","rank":13,"rolecode":"pau"},{"affno":"4","first":"Hans Jørgen","key":"nielsenhansjørgenpau","last":"Nielsen","locid":"87f9baf4-e29c-4104-be23-daf6d94d7124","name":"Nielsen, Hans Jørgen","rank":14,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Claus Lindbjerg","key":"andersenclauslindbjergpau","last":"Andersen","locid":"f97421ce-9c23-4c51-9fcd-be0843ed0c0f","name":"Andersen, Claus Lindbjerg","orcid":"0000-0002-7406-2103","rank":15,"rolecode":"pau"}],"pmid":["31727158"],"pub":{"doi":"10.1186/s13148-019-0757-3","issn":["18687075","18687083"],"issn_org":["18687075"],"issue":"1","journal":"Clinical Epigenetics","paperid":"158","publisher":"BioMed Central","status":"p","title":"Clinical Epigenetics","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-85075113935"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Private Research","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Hospitals","Other Companies","Private Research","Universities","University of Copenhagen","exiqon a/s"],"PST":["Published"]},"sid":["au-63a47a30-d814-4bc9-8061-b532c2b844b8","ku-706a6d5e-f1d8-4346-a357-868154759428"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Novel DNA methylation biomarkers show high sensitivity and specificity for blood-based detection of colorectal cancer- A clinical biomarker discovery and validation study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.81-019907","year":"2019","yearsub":"2019"}
{"abstract":"For improved prevention of health issues among blue-collar workers, there is a need for an overview of the physical activity at work and leisure using technical long-term measurements in blue-collar sectors investigation of differences between the sectors. Thus, the objective of this paper was to provide an overview and investigate differences in physical activities and body postures at work and leisure among blue-collar sectors. The Dphacto cohort consists of 1087 workers from manufacturing, transportation and cleaning sectors (901 blue-collar and 186 white-collar workers) in Denmark. Eligible workers provided physical activity and heart rate measurements over several days with follow-up on health-related outcomes by self-report and registers. Considerable differences in sitting, standing, time on feet (walking, shuffling and standing combined) and forward bending of the back were found between work and leisure, and between the sectors. This overview of physical activity at work and leisure can be useful for better prevention of work-related health issues among blue-collar workers.","author_count":15,"contributors":["Jørgensen, Marie Birk","Gupta, Nidhi","Korshøj, Mette","Lagersted-Olsen, Julie","Villumsen, Morten","Mortensen, Ole Steen","Skotte, Jørgen","Søgaard, Karen","Madeleine, Pascal","Samani, Afshin","Ørberg, Anders","Rasmussen, Charlotte Lund","Holtermann, Andreas"],"cuid":["S04-099.11-767030"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"continent":["Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Jørgensen, Marie Birk"],"country":["Norway"],"glorg":["All Global Affiliations","Norwegian University of Science and Technology"],"keyword":["Actigraph","Actiheart","Body posture","Electrocardiography","Heart Rate","Heart rate reserve","Musculoskeletal pain","Occupational health","Physical work demand","Physical workload","Work environment"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-OT","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-WORK"],"HO":["DI-HO-ALL","DI-HO-CDR","DI-HO-OTH"],"OT":["Department of Forensic Medicine, University of Copenhagen, Copenhagen, Denmark."],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-GV-WORK","DI-HO-CDR","DI-HO-OTH","DI-U-AAU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"the dphacto cohort an overview of technically measured physical activity at work and leisure in blue collar sectors for practitioners and researchers","src":["aau","ku","nfa","sdu"],"src-code":["DI-GV-WORK","DI-U-AAU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85060485011","version":"Other Version"},"funding_acknowledgement":["The work was partly supported by a grant from the Danish government (Satspulje)."],"id":"S04-099.11-767030","identifier":[{"id":"000462104400005","type":"wos"},{"id":"85060485011","type":"scopus"},{"id":"30832776","type":"pmid"}],"ids":["aau-cd48fa86-362f-48ff-9c20-8fd6e3e9296a","ku-39d72519-2ade-4a2f-9023-1be3c924a30b","nfa-66af2052-7c9c-4feb-8db7-3d72832df259","sdu-9fbbf722-60fc-413c-a9c7-4041e90fbb63"],"keyword":["Actigraph","Actiheart","Body posture","Electrocardiography","Heart rate","Heart rate reserve","Musculoskeletal pain","Occupational health","Physical work demand","Physical workload","Work environment"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-7-EACE5C431E5A29A0520FE590FB4CAC4B"],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Kø