:"1","corresponding":null,"first":"Jes Sloth","key":"mathiesenjesslothpau","last":"Mathiesen","locid":"f5ae2edf-6f26-4543-9ffd-bd2cab0d98f8","name":"Mathiesen, Jes Sloth","orcid":"0000-0002-9770-3188","rank":20,"rolecode":"pau"}],"pmid":["39941743"],"pub":{"doi":"10.3390/cancers17030374","issn":["20726694"],"issue":"3","journal":"Cancers","paperid":"374","publisher":"Multidisciplinary Digital Publishing Institute (MDPI)","status":"p","title":"Cancers","volume":"17"},"review":"Peer Reviewed","scoID":["2-s2.0-85218016260"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-9f3310ba-c256-4494-8627-c8a3c76f3979","au-69f519d9-0645-406f-a605-03938d8e0153","ku-8350074f-2f54-48ec-9d51-db1a6f30a6cf","sdu-cadfad33-d4a9-4f18-a63b-cdad2d7af595"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"<i>RET </i>C611Y Germline Variant in Multiple Endocrine Neoplasia Type 2A in Denmark 1930–2021 : A Nationwide Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-099.83-803781","year":"2025","yearsub":"2025"}
{"abstract":"Drug depot technologies that release chemotherapeutics locally in cancerous tissues present an intriguing strategy. This study aimed to assess the feasibility, delivery capacity, and therapeutic efficacy of a thin needle injectable doxorubicin-loaded carbohydrate-ester-based (CarboCell) depot technology. CarboCell was evaluated in three experimental setups: (A) In non-tumorous mice, release kinetics were evaluated 24 h and 48 h after a subcutaneous depot injection. (B) In mice with syngeneic CT 26 colorectal cancer, efficacy was evaluated based on tumour growth control and survival. This was done by two intratumoral injections of 50 µl CarboCell containing 1 mg/mL or 4 mg/mL doxorubicin at 5 days intervals. (C) In ten female pigs, local and distant release of doxorubicin from a 2 mg/mL doxorubicin CarboCell (2 or 4 mL) injected into tibial metaphysis was evaluated using microdialysis in nine tissue compartments. (A) Subcutaneous CarboCell depots demonstrated a sustained release of doxorubicin with (mean ± SEM) 36 ± 13% and 48 ± 20% of the loaded dose being released at 24 h and 48 h time points, respectively. (B) Intratumoral injection effectively controlled tumour growth and markedly extended the median survival time compared to the control group. (C) Doxorubicin peak drug concentrations in the metaphysis were > 0.3 µg/mL and could be quantified at least 10 mm from the application site. The systemic spill-over was minimal. Doxorubicin-loaded CarboCell proved easily administrable, maintaining antitumoral activity, good metaphyseal distribution and providing much higher local concentrations in metaphyseal bone providing high local concentrations in metaphyseal bone with a good distribution and limited systemic exposure.","author_count":11,"contributors":["Jørgensen, Andrea René","Hansen, Anders Elias","Henriksen, Jonas Rosager","Stilling, Maiken","Rasmussen, Hans Christian","Lilleøre, Johanne Gade","Hvistendahl, Magnus A.","Slater, Josefine","Serrano-Chávez, Elizabeth","Hansen, Jakob","Bue, Mats"],"cuid":["S01-000.00-807608"],"filters":{"added":"2025-06","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"corresponding_author":["Jørgensen, Andrea René"],"keyword":["Cancer treatment","CarboCell","Doxorubicin","Microdialysis"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-DTU"]},"level3all":["DI-U-AU","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"injectable sustained local release doxorubicin depot technology a promising adjuvant to systemic treatment","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s13346-025-01841-9","version":"Published Version"},"id":"S01-000.00-807608","identifier":[{"id":"105001865059","type":"scopus"},{"id":"40178754","type":"pmid"}],"ids":["au-d73d93b8-6b99-4815-a583-00b844ad4f06"],"keyword":["Cancer treatment","CarboCell","Doxorubicin","Drug depot technology","Local concentration","Microdialysis"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-533DE688D43FEFD95D5637007CCCC2AE"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s13346-025-01841-9","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Orthopaedic surgery"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark (DTU)"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Andrea René","key":"jørgensenandrearenépau","last":"Jørgensen","locid":"105e5e1d-0600-4cd5-94cb-68291474afab","name":"Jørgensen, Andrea René","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Anders Elias","key":"hansenanderseliaspau","last":"Hansen","name":"Hansen, Anders Elias","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jonas Rosager","key":"henriksenjonasrosagerpau","last":"Henriksen","name":"Henriksen, Jonas Rosager","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Maiken","key":"stillingmaikenpau","last":"Stilling","locid":"bb005d3f-27c9-4157-8101-db5059373d32","name":"Stilling, Maiken","orcid":"0000-0002-4530-2075","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Hans Christian","key":"rasmussenhanschristianpau","last":"Rasmussen","locid":"93f47ffc-0862-4e2e-9efc-e048c9fd95d1","name":"Rasmussen, Hans Christian","orcid":"0000-0001-9101-9302","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Johanne Gade","key":"lilleørejohannegadepau","last":"Lilleøre","locid":"d7d315be-9bd0-4b10-b99f-7f6b7bd6d07b","name":"Lilleøre, Johanne Gade","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Magnus Andreas","key":"hvistendahlmagnusapau","last":"Hvistendahl","locid":"e0fdf994-206b-4961-bc05-9c84d1ff3557","name":"Hvistendahl, Magnus A.","name_org":"Hvistendahl, Magnus Andreas","orcid":"0000-0002-4086-0238","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Josefine","key":"slaterjosefinepau","last":"Slater","locid":"bcfa9867-e753-418a-9656-4fff369aec59","name":"Slater, Josefine","orcid":"0000-0002-3589-2278","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Elizabeth","key":"serranochávezelizabethpau","last":"Serrano-Chávez","name":"Serrano-Chávez, Elizabeth","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jakob","key":"hansenjakobpau","last":"Hansen","locid":"57b7eb60-d040-4937-a05a-d34bc65de5bf","name":"Hansen, Jakob","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mats","key":"buematspau","last":"Bue","locid":"2a35a61c-3bf9-4bf7-9569-73178247b08c","name":"Bue, Mats","orcid":"0000-0001-7215-8323","rank":11,"rolecode":"pau"}],"pmid":["40178754"],"pub":{"doi":"10.1007/s13346-025-01841-9","issn":["2190393X","21903948"],"issn_org":["2190393X"],"journal":"Drug Delivery and Translational Research","publisher":"Springer Publishing Company","status":"e","title":"Drug Delivery and Translational Research"},"review":"Peer Reviewed","scoID":["2-s2.0-105001865059"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["E-Published (ahead of print)"]},"sid":["au-d73d93b8-6b99-4815-a583-00b844ad4f06"],"src":["AU Aarhus University"],"title":"Injectable sustained local release doxorubicin depot technology– a promising adjuvant to systemic treatment?","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-807608","year":"2025","yearsub":"2025"}
{"abstract":"This systematic review examines educational strategies in clinician-performed abdominal point-of-care ultrasound (POCUS), a critical skill with increasing relevance in medical care. Analyzing 28 studies, we highlight the strategies as well as advantages and disadvantages of various theoretical and practical components, including, for example, e-learning and simulation in training programs. The findings emphasize the necessity of blending various educational methods to enhance effectiveness and adaptability in training environments. Ultimately, robust training frameworks are essential to maximize diagnostic accuracy and improve patient outcomes in abdominal POCUS.","author_count":6,"contributors":["Sveinsson, Birkir Örn","Thorsteinsdottir, Olof Kristin","Browne, Alexander G P","Rasmussen, Benjamin Schnack","Nielsen, Anders Bo","Pietersen, Pia Iben"],"cuid":["S01-000.00-812135"],"filters":{"added":"2025-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Pietersen, Pia Iben"],"keyword":["Abdomen diagnostic imaging","Clinical Competence","Humans","Point of Care Systems","Ultrasonography methods"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-SDR","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"abdominal pocus education for clinicians a systematic review of teaching methods for point of care abdominal ultrasonography","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1002/jcu.23876","version":"Published Version"},"id":"S01-000.00-812135","identifier":[{"id":"86000435148","type":"scopus"},{"id":"39475458","type":"pmid"},{"id":"PMC11907227","type":"pmcid"}],"ids":["sdu-26dc12f7-9551-4526-8fe6-f28d203821b4"],"keyword":["Abdomen/diagnostic imaging","Clinical Competence","Humans","Point-of-Care Systems","Ultrasonography/methods"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-5570C979B546F0A98DA0CBB3C50CCA5F"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/286826341/J_of_Clinical_Ultrasound_-_2024_-_Sveinsson_-_Abdominal_POCUS_Education_for_Clinicians_A_Systematic_Review_of_Teaching.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1002/jcu.23876","version":"Published Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Radiology (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Svendborg Sygehus"],"nora_code":"DI-HO-SDR","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Birkir Örn","key":"sveinssonpau","last":"Sveinsson","locid":"4bcc275f-1e34-48cc-89fe-f75f66141daf","name":"Sveinsson, Birkir Örn","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Olof Kristin","key":"thorsteinsdottirpau","last":"Thorsteinsdottir","locid":"bd70b218-52d6-4253-968a-4e382af1d95f","name":"Thorsteinsdottir, Olof Kristin","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Alexander G P","key":"brownepau","last":"Browne","name":"Browne, Alexander G P","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Benjamin S B","key":"rasmussenpau","last":"Rasmussen","locid":"1184a25b-a669-4b81-a271-62ac25d4255c","name":"Rasmussen, Benjamin Schnack","name_org":"Rasmussen, Benjamin S B","orcid":"0000-0002-7357-0755","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders Bo","key":"nielsenpau","last":"Nielsen","locid":"0d313d8b-895b-4348-a216-fa0d672d6b24","name":"Nielsen, Anders Bo","orcid":"0000-0003-0315-7823","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Pia Iben","key":"pietersenpau","last":"Pietersen","locid":"b5e80914-ad32-4216-9ec6-150de89d1839","name":"Pietersen, Pia Iben","orcid":"0000-0001-5718-3635","rank":6,"rolecode":"pau"}],"pmid":["39475458"],"pub":{"doi":"10.1002/jcu.23876","issn":["00912751","10970096"],"issn_org":["00912751"],"issue":"3","journal":"Journal of Clinical Ultrasound","pages":"547-561","publisher":"Wiley","status":"p","title":"Journal of Clinical Ultrasound","volume":"53"},"review":"Peer Reviewed","scoID":["2-s2.0-85208034391","2-s2.0-86000435148"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-26dc12f7-9551-4526-8fe6-f28d203821b4"],"src":["SDU University of Southern Denmark"],"title":"Abdominal POCUS Education for Clinicians : A Systematic Review of Teaching Methods for Point-of-Care Abdominal Ultrasonography","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-812135","year":"2025","yearsub":"2025"}
{"abstract":"Low density lipoprotein receptor-related protein 2 (LRP2) is a 600 kilodalton multi-ligand endocytic membrane receptor ex-pressed in several cell types during fetal development, including neuroepithelial cells, and in select absorptive epithelial cellsin the adult. In epithelial cancers, LRP2 expression is associated with a differentiated tumor cell state and better prognosis. Inprevious work, we found that while LRP2 is not expressed in benign naevi, it is frequently acquired in melanoma. However, themolecular drivers of LRP2 expression in melanoma and characteristics of LRP2- expressing melanoma have yet to be described.Here, we show that LRP2 expression is related to a transitory melanoma cell state defined by co-expression of melanocyte lineageand neural crest transcriptional programs. Further, we reveal that melanoma LRP2 expression is increased in T cell-inflamedtumors and is directly upregulated through interferon-gamma signaling. Correlation of melanoma LRP2 expression with clin-icopathological variables demonstrates that LRP2 expression is associated with low Breslow thickness and low clinical stage inprimary melanomas. Taken together, the present study describes the characteristics of LRP2- expressing melanoma and revealsinterferon-gamma signaling as a novel strong positive regulator of LRP2 expression in melanoma.","author_count":17,"contributors":["Rasmussen, Martin Qvist","Bønnelykke-Behrndtz, Marie Louise","Merrild, Camilla","Tvilling, Ida Kathrine Sneum","Christensen, Julie Nelly","Nielsen, Morten Muhlig","Georgsen, Jeanette Bæhr","Naumann, Nina","Gudbergsson, Johann Mar","Etzerodt, Anders","Pedersen, Jakob Skou","Jenkins, Russell W","Degn, Søren Egedal","Moestrup, Søren Kragh","Schmidt, Henrik","Steiniche, Torben","Madsen, Mette"],"cuid":["S01-000.00-824881"],"filters":{"added":"2025-10","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","OECD"],"corresponding_author":["Madsen, Mette"],"country":["United States"],"glorg":["All Global Affiliations","Broad Institute","Massachusetts General Hospital, Boston, Massachusetts, USA."],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"lrp000000000002 expression in melanoma is associated with a transitory cell state increased t cell infiltration and is upregulated by ifny signaling","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1111/pcmr.70053","version":"Published Version"},"id":"S01-000.00-824881","identifier":[{"id":"PMC12413508","type":"pmcid"},{"id":"40913277","type":"pmid"}],"ids":["au-3aed12b4-f3cc-410d-843c-dc2d6c9c0bd8"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-92554FEA5F0565F610333FC756F375A5"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1111/pcmr.70053","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Biomedicine, Department of Biomedicine - Research and Education, Bartholin Building"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"us","key":"massachusetts general hospital boston massachusetts usa","loc":["United States","America, North","OECD"],"name":"Massachusetts General Hospital, Boston, Massachusetts, USA.","used":1},{"affno":"3","country":"us","key":"broad institute","loc":["United States","America, North","OECD"],"name":"Broad Institute","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Martin Qvist","key":"rasmussenpau","l