f Clinical Medicine, Department of Clinical Medicine - Orthopaedic surgery"],"nora_code":"DI-U-AU","used":1},{"affno":"4","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1}],"person":[{"affno":"1","first":"Jeppe Vejlgaard","key":"rasmussenpau","last":"Rasmussen","locid":"deb4067f-df03-43e6-9d12-9afc8a664d9b","name":"Rasmussen, Jeppe V.","name_org":"Rasmussen, Jeppe Vejlgaard","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Anders","key":"elgalalypau","last":"El-Galaly","locid":"b8cf486c-49b7-4004-a80f-a13b9e63b41b","name":"El-Galaly, Anders","orcid":"0000-0001-8093-8266","rank":2,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"country":"dk","first":"Theis Muncholm","key":"thillemannpau","last":"Thillemann","locid":"1d931fc7-3227-4039-9753-f57097786b83","name":"Thillemann, Theis Muncholm","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Steen Lund","key":"jensenpau","last":"Jensen","locid":"89ff8a6e-dcbe-4a2f-af40-2f1dafe20c50","name":"Jensen, Steen Lund","rank":4,"rolecode":"pau"}],"pmid":["33654435"],"pub":{"doi":"10.2147/clep.s291972","issn":["11791349"],"journal":"Clinical Epidemiology","pages":"141-148","publisher":"Dove Medical Press Ltd","publisher_org":"Dove Medical Press Ltd.","status":"p","title":"Clinical Epidemiology","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-85102194517"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-0fe143f5-bbac-46ac-a474-895d83083f56","au-756295b8-dad3-4b65-92e5-6aae1ecebf2b","ku-50c05b7c-db54-41a0-91ec-9b10170e735e"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen"],"title":"High Completeness and Accurate Reporting of Key Variables Make Data from the Danish Shoulder Arthroplasty Registry a Valuable Source of Information","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-097.61-000819","year":"2021","yearsub":"2021"}
{"abstract":"Many industries have benefited from modularisation; while in the architecture, engineering and construction (AEC) industry, the concept of modularisation is associated with dimensional coordination. This has added to an already extensive list of challenges due to market size and the concept of economies of scale in AEC industry, to name but a few. Moreover, there is a myth that the AEC industry is bound to stay associated with build-to-order or made-to-order approach caused the AEC industry to restrict modularisation to the component level. This changes the balance in favour of what this paper calls a bottom-up approach. On the other hand, a valid alternative strategy – referred to in this study as top-down strategy – remains very much underexploited. The clients, therefore, do not have a neutral means by which they can assess which strategy is in their best interest. Likewise, if a construction company plans to make a strategic move towards the principles of modularisation and off-site manufacturing, they do not have clear decision support tool. This study investigates these two main modularisation strategies in the AEC industry to provide some examples of successful cases regarding how, when and where such strategy have been applied by different construction companies in different cases. The collected and collated empirical data and the results from the interviews will help clients and companies to analyse their own cases and make operational decisions on how, when and where to best utilise the bottom-up and top-down modularisation techniques while considering the pros and cons of such decisions.","author_count":9,"contributors":["Shafiee, Sara","Piroozfar, Poorang","Hvam, Lars","Farr, Eric R.P.","Huang, George Q.","Pan, Wei","Kudsk, Anders","Rasmussen, Jeppe Bredahl","Korell, Manuel"],"cuid":["S01-000.00-351424"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Asia, East","Europe, EU","Europe, Non-EU","Nordic","OECD"],"country":["Hong Kong","Sweden","United Kingdom","United States"],"glorg":["All Global Affiliations","Lund Institute of Technology","NONAMES Design Research and Studies","The University of Hong Kong","University of Brighton"],"keyword":["Architecture","Modularisation"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Concepts and Innovation"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"modularisation strategies in the aec industry a comparative analysis","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/207662132/Modularisation_Strategies_in_the_AEC_Industry_author_published_version.pdf","version":"Authors Final Version"},"id":"S01-000.00-351424","identifier":[{"id":"85081354070","type":"scopus"}],"ids":["dtu-9d29322d-469e-4775-b808-637d2b9b5355"],"keyword":["Architecture","Bottom‐up modularisation","Engineering and construction (AEC)","Industrialised building systems","Modularisation","Top‐down modularisation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-12F5885CF09EEB107BB55DC663C2D5C4"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/207662132/Modularisation_Strategies_in_the_AEC_Industry_author_published_version.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Mechanical Engineering","Technical University of Denmark, Department of Mechanical Engineering, Engineering Design and Product Development"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"gb","key":"university of brighton","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Brighton","used":1},{"affno":"3","country":"us","key":"nonames design research and studies","loc":["United States","America, North","OECD"],"name":"NONAMES Design Research and Studies","used":1},{"affno":"4","country":"hk","key":"the university of hong kong","loc":["Hong Kong","Asia, East"],"name":"The University of Hong Kong","used":1},{"affno":"5","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Concepts and Innovation"],"nora_code":"DI-OT","used":1},{"affno":"6","country":"se","key":"lund institute of technology","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Lund Institute of Technology","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Sara","key":"shafieepau","last":"Shafiee","locid":"76628cde-f929-46be-9175-c75a32932cea","name":"Shafiee, Sara","orcid":"0000-0001-9433-5060","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Poorang","key":"piroozfarpau","last":"Piroozfar","name":"Piroozfar, Poorang","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars","key":"hvampau","last":"Hvam","locid":"40379baf-979d-4b21-934f-45232e5c41c6","name":"Hvam, Lars","orcid":"0000-0002-7617-2971","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Eric R.P.","key":"farrpau","last":"Farr","name":"Farr, Eric R.P.","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"George Q.","key":"huangpau","last":"Huang","name":"Huang, George Q.","rank":5,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Wei","key":"panpau","last":"Pan","name":"Pan, Wei","rank":6,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Anders","key":"kudskpau","last":"Kudsk","name":"Kudsk, Anders","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jeppe Bredahl","key":"rasmussenpau","last":"Rasmussen","locid":"7a36a9ec-d9bc-4b60-867b-dd245501d935","name":"Rasmussen, Jeppe Bredahl","orcid":"0000-0001-7241-3638","rank":8,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Manuel","key":"korellpau","last":"Korell","name":"Korell, Manuel","rank":9,"rolecode":"pau"}],"pub":{"doi":"10.1080/17452007.2020.1735291","issn":["17452007","17527589"],"issn_org":["17452007"],"issue":"4","journal":"Architectural Engineering and Design Management","pages":"270-292","publisher":"Taylor and Francis Ltd.","status":"p","title":"Architectural Engineering and Design Management","volume":"16"},"review":"Peer Reviewed","scoID":["2-s2.0-85081354070"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-9d29322d-469e-4775-b808-637d2b9b5355"],"src":["DTU Technical University of Denmark"],"title":"Modularisation strategies in the AEC industry: a comparative analysis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-351424","year":"2020","yearsub":"2020"}
{"abstract":"In the paper, we investigate numerically the influence of dry friction yaw damping on the dynamics of a railway vehicle with four wheel sets. The speed of the vehicle is the control parameter. The stick/slip mechanism is considered. The first bifurcation points are found. The results demonstrate the influence of the stick/slip on the dynamics of the vehicle. For speeds above the critical speed, it is found that the symmetry of the dynamical problem is broken and erratic - possibly chaotic - motions appear. The paper ends with an investigation of the sensitivity of the results to different solvers from Matlab. It is found that ODE15s needs the largest computation time and it is more accurate than ODE45 with the same tolerances. ODE45 is satisfactory. It is fast, accurate and shows the same erratic features as ODE15s does. Dry friction damping is still used in almost all freight wagons in the world due to the low cost of the elements.","author_count":4,"contributors":["True, Hans","Christiansen, Anders H.","Knutz, Susanne E.","Rasmussen, Lene B."],"cuid":["S01-000.00-352816"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["True, Hans"],"keyword":["Bifurcations","Railway vehicle dynamics"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"on the dynamics of a four axle railway vehicle with dry friction yaw damping","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85096484054","version":"Other Version"},"id":"S01-000.00-352816","identifier":[{"id":"85096484054","type":"scopus"}],"ids":["dtu-a1acc95c-c457-47e2-8c16-0b53260ace95"],"keyword":["Bifurcations","Non-smooth dynamics","Railway vehicle dynamics"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-5-063C169CCA1A4E95849F178CBA554402"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Applied Mathematics and Computer Science"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Hans","key":"truepau","last":"True","locid":"3363005c-cc53-4122-92bb-b5568aff7168","name":"True, Hans","orcid":"0000-0003-2870-3376","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders H.","key":"christiansenpau","last":"Christiansen","name":"Christiansen, Anders H.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Susanne E.","key":"knutzpau","last":"Knutz","name":"Knutz, Susanne E.","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lene B.","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Lene B.","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1504/ijhvs.2020.111261","issn":["17415152","1744232X"],"issn_org":["1744232X"],"issue":"5","journal":"International Journal of Heavy Vehicle Systems","pages":"600-621","publisher":"Inderscience Publishers","status":"p","title":"International Journal of Heavy Vehicle Systems","volume":"27"},"review":"Peer Reviewed","scoID":["2-s2.0-85096484054"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-a1acc95c-c457-47e2-8c16-0b53260ace95"],"src":["DTU Technical University of Denmark"],"title":"On the dynamics of a four-axle railway vehicle with dry friction yaw damping","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-352816","year":"2020","yearsub":"2020"}
{"abstract":"This contribution aims to improve existing scalings of the L-mode power decay length λqomp, especially for plasma configurations with strike points at the ITER-relevant location - closed vertical divertor targets. We propose 13 new λqomp scalings based on data from the tokamaks JET, EAST, MAST, Alcator C-mod and COMPASS, and validate them against the output of the 2D turbulence code HESEL. The analysis covers 500 divertor heat flux profiles (obtained by probes or IR cameras), measured in L-mode discharges with varying 12 global plasma parameters (all well predictable). We find that the two previously published scalings (Eich 2013 J. Nucl. Mat. 438 S72) and (Scarabosio 2013 J. Nucl. Mat. 438 S426), which were based on outer target data from AUG and JET, describe the JET, C-mod and COMPASS profiles well. This holds not only at the outer horizontal and vertical targets, but surprisingly also at the inner vertical targets. In contrast, EAST, HESEL and especially MAST data are poorly described by these two scalings. We therefore derive 13 new scalings, which account for 85-92 % of the measured λqomp variability across all five tokamaks. Although each of the scalings is based on a different parameter combination, their predictions for the ITER and COMPASS-Upgrade tokamaks are very similar. Just before the L-H transition in the ITER baseline scenario, the presented scalings predict values λqomp = 3.0 ± 0.5 mm. For the COMPASS-Upgrade tokamak, all the scalings predict λqomp = 2.1 ± 0.5 mm with a single exception of the scaling based on the stored plasma energy which predicts only 1.2 mm for both tokamaks. We encourage the reader to use as many of these scalings as possible, depending on available data. In attached plasma and using significant assumptions, our results imply steady-state surface-perpendicular heat flux around 10 MW/m2 for ITER, and 20 MW/m2 for COMPASS-Upgrade.","author_count":25,"contributors":["Horacek, J.","Adamek, J.","Komm, M.","Seidl, J.","Vondracek, P.","Jardin, A.","Guillemaut, Ch.","Elmore, S.","Thornton, A.","Jirakova, K.","Jaulmes, F.","Deng, G.","Gao, X.","Wang, L.","Ding, R.","Brunner, D.","Labombard, B.","Olsen, Jeppe Miki Busk","Rasmussen, Jens Juul","Nielsen, Anders Henry","Naulin, Volker","Ezzat, M.","Camacho, K. M.","Hron, M.","Matthews, G. F."],"cuid":["S01-000.00-357981"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Africa","America, North","Asia, East","Europe, EU","Europe, Non-EU","OECD"],"corresponding_author":["Horacek, J."],"country":["China","Czechia","Egypt","France","Poland","Portugal","United Kingdom","United States"],"glorg":["All Global Affiliations","Chinese Academy of Sciences","Czech Academy of Sciences","Mansoura University","Massachusetts Institute of Technology","Polish Academy of Sciences","United Kingdom Atomic Energy Authority","University of Lisbon","Université de Lorraine"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"scaling of l mode heat flux for iter and compass u divertors based on five tokamaks","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1088/1741-4326/ab7e47","version":"Published Version"},"id":"S01-000.00-357981","identifier":[{"id":"85085610465","type":"scopus"},{"id":"000535881300001","type":"wos"}],"ids":["dtu-b2bf8e7b-826c-41c8-98cb-f450439e7ba2"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-CE12292BBE50C613C71F4924818B04F9"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/235160128/Horacek_2020_Nucl._Fusion_60_066016.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1088/1741-4326/ab7e47","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"cz","key":"czech academy of sciences","loc":["Czechia","Europe, EU","OECD"],"name":"Czech Academy of Sciences","used":1},{"affno":"2","country":"pl","key":"polish academy of sciences","loc":["Poland","Europe, EU","OECD"],"name":"Polish Academy of Sciences","used":1},{"affno":"3","country":"pt","key":"university of lisbon","loc":["Portugal","Europe, EU","OECD"],"name":"University of Lisbon","used":1},{"affno":"4","country":"gb","key":"united kingdom atomic energy authority","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"United Kingdom Atomic Energy Authority","used":1},{"affno":"5","country":"cn","key":"chinese academy of sciences","loc":["China","Asia, East"],"name":"Chinese Academy of Sciences","used":1},{"affno":"6","country":"us","key":"massachusetts institute of technology","loc":["United States","America, North","OECD"],"name":"Massachusetts Institute of Technology","used":1},{"affno":"7","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Physics","Technical University of Denmark, Department of Physics, Plasma Physics and Fusion Energy"],"nora_code":"DI-U-DTU","used":1},{"affno":"8","country":"eg","key":"mansoura university","loc":["Egypt","Africa"],"name":"Mansoura University","used":1},{"affno":"9","country":"fr","key":"université de lorraine","loc":["France","Europe, EU","OECD"],"name":"Université de Lorraine","used":1}],"person":[{"affno":"1","corresponding":null,"first":"J.","key":"horacekpau","last":"Horacek","name":"Horacek, J.","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"J.","key":"adamekpau","