"last":"Østergaard","locid":"d5b18fd7-3521-4ec9-8043-98bc727031e7","name":"Østergaard, Lars","rank":7,"rolecode":"pau"}],"pmid":["27403867"],"pub":{"doi":"10.1371/journal.pmed.1002076","issn":["15491277","15491676"],"issn_org":["15491277"],"issue":"7","journal":"PLoS Medicine","paperid":"e1002076","publisher":"Public Library of Science","status":"p","title":"PLoS Medicine","title_org":"P L o S Medicine (Online)","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-84980332348"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-e02ad517-bc6d-4916-a231-afb99bea5eda","au-41002c2e-c4e7-4bbf-a289-86dd12f4993e","sdu-fbbabe19-4453-48cd-9c7a-df1395a3176e"],"src":["AAU Aalborg University","AU Aarhus University","SDU University of Southern Denmark"],"title":"Associations between Recreational and Commuter Cycling, Changes in Cycling, and Type 2 Diabetes Risk : A Cohort Study of Danish Men and Women","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-090.74-010702","year":"2016","yearsub":"2016"}
{"abstract":"BACKGROUND AND AIM: The bone-related peptide osteoprotegerin has been linked to vascular calcification and peripheral vascular disease. We investigated the association between osteoprotegerin and development of foot complications in persons with type 1 diabetes. MATERIALS AND METHODS: Prospective observational study of 573 persons with type 1 diabetes, 225 women; age [mean±SD] 42.3±10.3years. Plasma osteoprotegerin was measured by ELISA. RESULTS: Median (IQR) osteoprotegerin was 2.80(2.35-3.63)μg/L and follow-up time (median (range)) was 12.7(0.1-15.6)years. Endpoints included: new foot ulceration (n=153), Charcot foot (n=14), vascular surgery/amputation (n=53), loss of foot pulse (n=57), and peripheral neuropathy (n=99). In unadjusted analyses, higher osteoprotegerin was associated with development of all endpoints (p≤0.026). Higher osteoprotegerin remained associated with development of foot ulcer, and the combination of vascular surgery/amputation, loss of foot pulse and neuropathy (p≤0.001) in a sex and age adjusted model. After further adjustment (nephropathy status, smoking, HbA1c, systolic blood pressure, serum cholesterol, high sensitivity C-reactive protein, eGFR, and presence of neuropathy and/or claudication and/or foot ulcer at baseline), higher osteoprotegerin remained associated with development of foot ulcer (HR (95% CI) per doubling: 1.75 (1.04-2.97); p=0.037). CONCLUSION: Higher osteoprotegerin levels were associated with development of foot ulcer, even after comprehensive adjustment.","author_count":10,"contributors":["Zobel, Emilie H","von Scholten, Bernt J","Lajer, Maria","Jorsal, Anders","Tarnow, Lise","Rasmussen, Lars M.","Holstein, Per","Parving, Hans-Henrik","Hansen, T W","Rossing, P"],"cuid":["S03-100.00-024329"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"keyword":["Amputation","Charcot foot","Diabetic complications","Foot ulcer","Journal Article","Osteoprotegerin","Type 1 diabetes"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-STENO"],"OT":["Steno Diabetes Centre, Gentofte, Denmark."],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-STENO","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"high osteoprotegerin is associated with development of foot ulcer in type 000000000001 diabetes","src":["au","ku","sdu"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84994300069","version":"Other Version"},"id":"S03-100.00-024329","identifier":[{"id":"27469295","type":"pmid"},{"id":"84994300069","type":"scopus"}],"ids":["au-9f437942-413b-440b-b668-ce78bd3bdfe5","ku-f1010d37-1d6f-4c93-8af7-e5f071e8ee09","sdu-f9cb62dd-2924-4c1f-8190-203fccf78fcd"],"keyword":["Amputation","Charcot foot","Diabetic complications","Foot ulcer","Journal Article","Osteoprotegerin","Type 1 diabetes"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-D4DB01D16503369E7736DAD4056ADD6A"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","country":"dk","key":"steno diabetes centers","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-STENO","l3nn":"Steno Diabetes Centers","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Steno Diabetes Centers","namevar":["Steno Diabetes Center Copenhagen"],"nora_code":"DI-HO-STENO","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Steno Diabetes Centre, Gentofte, Denmark."],"nora_code":"DI-OT","used":1},{"affno":"3","key":"au aarhus university","l2"