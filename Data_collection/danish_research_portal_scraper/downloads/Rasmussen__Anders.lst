rg":"Rasmussen, Charlotte D. N.","orcid":"0000-0002-1769-717X","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Andreas","key":"holtermannpau","last":"Holtermann","locid":"fd559bce-74b0-4973-a2d9-dd622af8b0c8","name":"Holtermann, Andreas","orcid":"0000-0003-4825-5697","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Marie B.","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, Marie B.","rank":9,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Sebastiano","key":"bagnaraped","last":"Bagnara","name":"Bagnara, Sebastiano","rank":10,"role":"Editor","rolecode":"ped"},{"affno":"","corresponding":null,"first":"Riccardo","key":"tartagliaped","last":"Tartaglia","name":"Tartaglia, Riccardo","rank":11,"role":"Editor","rolecode":"ped"},{"affno":"","corresponding":null,"first":"Sara","key":"albolinoped","last":"Albolino","name":"Albolino, Sara","rank":12,"role":"Editor","rolecode":"ped"},{"affno":"","corresponding":null,"first":"Thomas","key":"alexanderped","last":"Alexander","name":"Alexander, Thomas","rank":13,"role":"Editor","rolecode":"ped"},{"affno":"","corresponding":null,"first":"Yushi","key":"fujitaped","last":"Fujita","name":"Fujita, Yushi","rank":14,"role":"Editor","rolecode":"ped"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Miscellaneous","DI-ALL","DI-GV","DI-GV-ALL","DI-OT","DI-OT-ALL","Governmental Institutions","Miscellaneous","Other Research"],"PST":["Published"]},"sid":["nfa-38a7899d-2e36-4fc8-90c3-93ea0319f9c0"],"src":["NFA National Research Centre for the Working Environment"],"title":"Juvenile workers or pocketmoney precariat? – The process and effect of establishing health and safety committees for juvenile workers in Danish retail sector","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-780362","year":"2019","yearsub":"2019"}
{"abstract":"Vaccines against classical swine fever have proven very effective in protecting pigs from this deadly disease. However, little is known about how vaccination impacts the selective pressures acting on the classical swine fever virus (CSFV). Here we use high-throughput sequencing of viral genomes to investigate evolutionary changes in virus populations following the challenge of naïve and vaccinated pigs with the highly virulent CSFV strain \"Koslov\". The challenge inoculum contained an ensemble of closely related viral sequences, with three major haplotypes being present, termed A, B, and C. After the challenge, the viral haplotype A was preferentially located within the tonsils of naïve animals but was highly prevalent in the sera of all vaccinated animals. We find that the viral population structure in naïve pigs after infection is very similar to that in the original inoculum. In contrast, the viral population in vaccinated pigs, which only underwent transient low-level viremia, displayed several distinct changes including the emergence of 16 unique non-synonymous single nucleotide polymorphisms (SNPs) that were not detectable in the challenge inoculum. Further analysis showed a significant loss of heterogeneity and an increasing positive selection acting on the virus populations in the vaccinated pigs. We conclude that vaccination imposes a strong selective pressure on viruses that subsequently replicate within the vaccinated animal.","author_count":9,"contributors":["Fahnøe, Ulrik","Pedersen, Anders Gorm","Johnston, Camille Melissa","Orton, Richard J","Höper, Dirk","Beer, Martin","Bukh, Jens","Belsham, Graham","Rasmussen, Thomas Bruun"],"cuid":["S02-100.00-033784"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","Europe, Non-EU","OECD"],"corresponding_author":["Fahnøe, Ulrik"],"country":["Germany","United Kingdom"],"glorg":["All Global Affiliations","Friedrich-Loeer-Institut","Friedrich-Loeffler-Institute","University of Glasgow"],"keyword":["CSFV","Classical swine fever virus","Deep sequencing","Vaccination","Virulence","Virus evolution"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"virus adaptation and selection following challenge of animals vaccinated against classical swine fever virus","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/v11100932","version":"Published Version"},"id":"S02-100.00-033784","identifier":[{"id":"PMC6833067","type":"pmcid"},{"id":"31658773","type":"pmid"},{"id":"85074240212","type":"scopus"}],"ids":["dtu-35c3c0c7-edc4-46be-9dd9-ee909613f35e","ku-ff315bfa-ae92-4809-ad0e-6efd6f906ec5"],"keyword":["CSFV","Classical swine fever virus","Deep sequencing","Haplotype selection","Vaccination","Viral populations","Virulence","Virus evolution"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-BE750AA03D2C7C8B5E8C872D2954B3B5"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/196880638/viruses_11_00932_v3.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/v11100932","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/230148690/viruses_11_00932_v3.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Veterinary Institute"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Immunology and Microbiology, Virology"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"gb","key":"university of glasgow","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Glasgow","used":1},{"affno":"4","country":"de","key":"friedrich loeffler institute","loc":["Germany","Europe, EU","OECD"],"name":"Friedrich-Loeffler-Institute","used":1},{"affno":"5","country":"de","key":"friedrich loeer institut","loc":["Germany","Europe, EU","OECD"],"name":"Friedrich-Loeer-Institut","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"Ulrik","key":"fahnøepau","last":"Fahnøe","locid":"409de6f2-ff5a-4623-8c2e-4bb18ee9c505","name":"Fahnøe, Ulrik","orcid":"0000-0002-2527-5751","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anders Gorm","key":"pedersenpau","last":"Pedersen","locid":"bb3513aa-fb20-46ef-ba14-9c150c929cf1","name":"Pedersen, Anders Gorm","orcid":"0000-0001-9650-8965","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Camille Melissa","key":"johnstonpau","last":"Johnston","locid":"d51c4d9b-078e-47d4-8681-35cca4ed3f62","name":"Johnston, Camille Melissa","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Richard J","key":"ortonpau","last":"Orton","name":"Orton, Richard J","rank":4,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"first":"Dirk","key":"höperpau","last":"Höper",