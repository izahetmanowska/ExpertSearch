-4f9e-8964-e9c473cecd38","name":"Haunsø, Stig","rank":13,"rolecode":"pau"},{"affno":"5","first":"Lars","key":"køberpau","last":"Køber","locid":"e3f0c57c-605a-431a-9c63-2213c46621e6","name":"Køber, Lars","rank":14,"rolecode":"pau"},{"affno":"5","country":"dk","first":"Thomas A","key":"gerdspau","last":"Gerds","locid":"b87ed711-194a-48dc-b83a-3c7aad18a00d","name":"Gerds, Thomas Alexander","name_org":"Gerds, Thomas A","orcid":"0000-0002-5955-816X","rank":15,"rolecode":"pau"},{"affno":"5","first":"Klaus F","key":"kofoedpau","last":"Kofoed","locid":"ec141562-c77f-498d-af6e-db9e08a4e895","name":"Kofoed, Klaus Fuglsang","name_org":"Kofoed, Klaus F","rank":16,"rolecode":"pau"},{"affno":"5","first":"Jesper H","key":"svendsenpau","last":"Svendsen","locid":"d80910cf-2f9c-457c-9e85-34b4b258bb81","name":"Svendsen, Jesper Hastrup","name_org":"Svendsen, Jesper H","orcid":"0000-0001-8466-8515","rank":17,"rolecode":"pau"},{"affno":"1","first":"Anders G","key":"holstpau","last":"Holst","name":"Holst, Anders G","rank":18,"rolecode":"pau"},{"affno":"1 6","first":"Jonas B","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Jonas B","rank":19,"rolecode":"pau"}],"pmid":["29848496"],"pub":{"doi":"10.1161/jaha.117.008247","issn":["20479980"],"issue":"11","journal":"Journal of the American Heart Association","paperid":"e008247","publisher":"American Heart Association Inc.","status":"p","title":"Journal of the American Heart Association","volume":"7"},"review":"Peer Reviewed","scoID":["2-s2.0-85047999051"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Other Hospitals","Universities","University of Copenhagen","copenhagen general practitioners' laboratory"],"PST":["Published"]},"sid":["aau-355e4ce2-48d7-4edd-a32c-6969eca59bba","ku-41b68f87-fc3c-410d-8337-f4749088194c"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"Risk Prediction of Atrial Fibrillation Based on Electrocardiographic Interatrial Block","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-002663","year":"2018","yearsub":"2018"}
{"abstract":"Background: The nitric oxide system could play an important role in the pathophysiology related to necrotizing soft tissue infection (NSTI). Accordingly, we investigated the association between plasma nitrite level at admission and the presence of septic shock in patients with NSTI. We also evaluated the association between nitrite, asymmetric dimethylarginine (ADMA), l-arginine, l-arginine/ADMA ratio, and outcome. Methods: We analyzed plasma from 141 NSTI patients taken upon hospital admission. The severity of NSTI was assessed by the presence of septic shock, Simplified Acute Physiology Score (SAPS) II, Sepsis-Related Organ Failure Assessment (SOFA) score, use of renal replacement therapy (RRT), amputation, and 28-day mortality. Results: No difference in nitrite levels was found between patients with and without septic shock (median 0.82 μmol/L [interquartile range (IQR) 0.41-1.21] vs. 0.87 μmol/L (0.62-1.24), P = 0.25). ADMA level was higher in patients in need of RRT (0.64 μmol/L (IQR 0.47-0.90) vs. (0.52 μmol/L (0.34-0.70), P = 0.028), and ADMA levels correlated positively with SAPS II (rho = 0.32, P = 0.0002) and SOFA scores (rho = 0.22, P = 0.01). In a logistic regression analysis, an l-arginine/ADMA ratio below 101.59 was independently associated with 28-day mortality, odds ratio 6.03 (95% confidence interval, 1.41-25.84), P = 0.016. None of the other analyses indicated differences in the NO system based on differences in disease severity. Conclusions: In patients with NSTI, we found no difference in baseline nitrite levels according to septic shock. High baseline ADMA level was associated with the use of RRT and patients with a low baseline l-arginine/ADMA ratio were at higher risk of dying within 28 days after hospital admission.","author_count":10,"contributors":["Hansen, Marco Bo","Rasmussen, Lars Simon","Garred, Peter","Pilely, Katrine","Wahl, Anna Mygind","Perner, Anders","Madsen, Martin Bruun","Hedegaard, Elise Røge","Simonsen, Ulf","Hyldegaard, Ole"],"cuid":["S02-100.00-016462"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Journal Article"],"level":"sci","mra":["med","soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"associations of plasma nitrite l arginine and asymmetric dimethylarginine with morbidity and mortality in patients with necrotizing soft tissue infections","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1097/SHK.0000000000000975","version":"Published Version"},"id":"S02-100.00-016462","identifier":[{"id":"85046666829","type":"scopus"},{"id":"28863028","type":"pmid"}],"ids":["au-348cbf93-822f-49ef-b33a-3eda2dae2311","ku-39615b02-a01c-41e9-a9af-246d55484f79"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Medical Science","Social Science"],"noi":["Global-Local-2-5-68F7BA259882D9201F4597261CB3E43A"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC5929495/pdf/shk-49-667.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/213326684/Associations_of_Plasma_Nitrite_L_Arginine_and.8.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1097/SHK.0000000000000975","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Anaesthesiology","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Kardiologisk afdeling, Aalborg Sygehus"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"","first":"Marco B","key":"hansenpau","last":"Hansen","name":"Hansen, Marco B","rank":1,"rolecode":"pau"},{"affno":"1","first":"Lars S","key":"rasmussenpau","last":"Rasmussen","locid":"37e36b99-34dd-471f-b09b-d93e72940ec0","name":"Rasmussen, Lars S","rank":2,"rolecode":"pau"},{"affno":"1","first":"Peter","key":"garredpau","last":"Garred","locid":"854d72a7-c955-43b5-b455-b7ea1f9bcb1e","name":"Garred, Peter","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Katrine","key":"pilelypau","last":"Pilely","name":"Pilely, Katrine","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Anna Mygind","key":"wahlpau","last":"Wahl","name":"Wahl, Anna Mygind","rank":5,"rolecode":"pau"},{"affno":"1","first":"Anders","key":"pernerpau","last":"Perner","locid":"8a389541-d529-4ee3-8364-66bfc85f77c9","name":"Perner, Anders","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Martin Bruun","key":"madsenpau","last":"Madsen","locid":"ddd3a71a-7d2e-4397-8b38-b1bf8a912cb9","name":"Madsen, Martin Bruun","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Elise Røge","key":"hedegaardpau","last":"Hedegaard","locid":"57dc18cf-33cb-4e44-bd2a-cdb8346917f5","name":"Hedegaard, Elise Røge","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Ulf","key":"simonsenpau","last":"Simonsen","locid":"eed8d0f5-bdc4-462e-9638-d2e314b2363c","name":"Simonsen, Ulf","rank":9,"rolecode":"pau"},{"affno":"1","first":"Ole","key":"hyldegaardpau","last":"Hyldegaard","locid":"b3f6c355-9c6b-4db3-84c2-870d09643475","name":"Hyldegaard, Ole","rank":10,"rolecode":"pau"}],"pmid":["28863028"],"pub":{"doi":"10.1097/shk.0000000000000975","issn":["10732322","15400514"],"issn_org":["10732322"],"issue":"6","journal":"Shock","pages":"667-674","publisher":"Lippincott Williams and Wilkins","status":"p","title":"Shock","volume":"49"},"review":"Peer Reviewed","scoID":["2-s2.0-85046666829"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-348cbf93-822f-49ef-b33a-3eda2dae2311","ku-39615b02-a01c-41e9-a9af-246d55484f79"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Associations of Plasma Nitrite, L-Arginine and Asymmetric Dimethylarginine With Morbidity and Mortality in Patients With Necrotizing Soft Tissue Infections","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-016462","year":"2018","yearsub":"2018"}
{"abstract":"BACKGROUND: The risk of coronary heart disease associated with intake of individual trans fatty acids (TFAs) is not clear. Adipose tissue content of TFAs is a biomarker of TFA intake and metabolism. OBJECTIVE: We investigated the rate of myocardial infarction (MI) associated with the adipose tissue content of total 18:1t, isomers of 18:1t (18:1 Δ6-10t and 18:1 Δ11t) and 18:2 Δ9c, 11t. METHODS: A case-cohort study, nested within the Danish Diet, Cancer and Health cohort (n = 57,053), was conducted, which included a random sample (n = 3156) of the total cohort and all incident MI cases (n = 2148) during follow-up (14 years). Information on MI cases was obtained by linkage with nationwide registers and validated. Adipose tissue was taken from the participants buttocks and the fatty acid composition was determined by gas chromatography. RESULTS: Women with higher adipose tissue content of total 18:1t had a 57% higher MI rate (quintiles 5 versus 1, hazard ratio, 1.57; 95% confidence interval, 1.12-2.20; P-trend = 0.011) and women with higher content of 18:1 Δ6-10t had a 76% higher MI rate (quintiles 5 versus 1, hazard ratio, 1.76; 95% confidence interval, 1.23-2.51; P-trend = 0.002). No association between 18:1 Δ11t content and MI rate was observed. In men, no associations between adipose tissue content of total 18:1t and 18:1 Δ6-10t and MI rate were observed. However, men with higher content of 18:1 Δ11t had a 48% higher MI rate (quintiles 5 versus 1, hazard ratio, 1.48; 95% confidence interval, 1.17-1.86; P-trend = 0.003). Adipose tissue content of 18:2 Δ9c, 11t was not associated with MI rate in women or men. CONCLUSIONS: Adipose tissue content of 18:2 Δ9c, 11t was not associated with MI rate in women or men, whereas higher contents of isomers of 18:1t were associated with higher MI rates but the associations for individual 18:1t isomers differed, however, in women and men.","author_count":9,"contributors":["Jakobsen, Marianne Uhre","Gorst-Rasmussen, Ande