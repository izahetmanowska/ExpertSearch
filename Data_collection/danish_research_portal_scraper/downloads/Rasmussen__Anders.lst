,{"affno":"4","corresponding":null,"first":"Iain Robert Louis","key":"keaniainrobertlouispau","last":"Kean","name":"Kean, Iain Robert Louis","rank":9,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Øystein","key":"angenøysteinpau","last":"Angen","name":"Angen, Øystein","rank":10,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Mark A.","key":"holmesmarkapau","last":"Holmes","name":"Holmes, Mark A.","rank":11,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Karl","key":"pedersenkarlpau","last":"Pedersen","name":"Pedersen, Karl","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars","key":"jelsbaklarspau","last":"Jelsbak","locid":"0f152051-d6ff-4b86-b98f-2ce118ee9ee1","name":"Jelsbak, Lars","orcid":"0000-0002-5759-9769","rank":13,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anders","key":"folkessonanderspau","last":"Folkesson","locid":"5a1c007c-1a52-43ec-93c5-b41be27e2e58","name":"Folkesson, Anders","orcid":"0000-0002-2175-830X","rank":14,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Anders Rhod","key":"larsenandersrhodpau","last":"Larsen","name":"Larsen, Anders Rhod","rank":15,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mikael Lenz","key":"strubemikaellenzpau","last":"Strube","locid":"483fbd14-adb8-4df6-b879-bcbb35737f51","name":"Strube, Mikael Lenz","orcid":"0000-0003-0905-5705","rank":16,"rolecode":"pau"}],"pmid":["37605221"],"pub":{"doi":"10.1186/s42523-023-00258-4","issn":["25244671"],"journal":"Animal Microbiome","paperid":"39","publisher":"BioMed Central","status":"p","title":"Animal Microbiome","volume":"5"},"review":"Peer Reviewed","scoID":["2-s2.0-85168482114"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-cd5f7b11-1657-429d-8a9d-49eb890c3b86","ku-e3ad09b0-1d24-419d-b1e8-50c830826254"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"The effects of antibiotic use on the dynamics of the microbiome and resistome in pigs","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-686157","year":"2023","yearsub":"2023"}
{"abstract":"Objective: Circulating tumor DNA (ctDNA) is a candidate biomarker of cancer with practice-changing potential in the detection of both early and residual disease. Disease stage and tumor size affect the probability of ctDNA detection, whereas little is known about the influence of other tumor characteristics on ctDNA detection. This study investigates the impact of tumor cell whole-genome doubling (WGD) on the detection of ctDNA in plasma collected preoperatively from newly diagnosed colorectal cancer (CRC) patients. Methods: WGD was estimated from copy numbers derived from whole-exome sequencing (WES) data of matched tumor and normal DNA from 833 Danish CRC patients. To explore if tumor WGD status impacts ctDNA detection, we applied tumor-informed ctDNA analysis to preoperative plasma samples from all patients. Results: Patients with WGD+ tumors had 53% increased odds of being ctDNA positive (OR = 1.53, 95%CI: 1.12–2.09). After stratification for UICC stage, the association persisted for Stage I (OR = 2.44, 95%CI: 1.22–5.03) and Stage II (OR = 1.76, 95%CI: 1.11–2.81) but not for Stage III (OR = 0.83, 95%CI: 0.44–1.53) patients. Conclusion: The presence of WGD significantly increases the probability of detecting ctDNA, particularly for early-stage disease. In patients with more advanced disease, the benefit of WGD on ctDNA detection is less pronounced, consistent with increased DNA shedding from these tumors, making ctDNA detection less dependent on the amount of ctDNA released per tumor cell.","author_count":21,"contributors":["Kabel, Jonas","Henriksen, Tenna Vesterman","Demuth, Christina","Frydendahl, Amanda","Rasmussen, Mads Heilskov","Nors, Jesper","Birkbak, Nicolai J.","Madsen, Anders Husted","Løve, Uffe S.","Andersen, Per Vadgaard","Kolbro, Thomas","Monti, Alessio","Thorlacius-Ussing, Ole","Gögenur, Mikail","Kildsig, Jeppe","Schlesinger, Nis Hallundbæk","Bondeven, Peter","Iversen, Lene Hjerrild","Gotschalck, Kåre Andersson","Andersen, Claus Lindbjerg"],"cuid":["S03-100.00-009596"],"filters":{"added":"2023-04","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"corresponding_author":["Andersen, Claus Lindbjerg"],"keyword":["Cancer diagnostics","Colorectal cancer","Whole genome doubling","circulating tumor DNA"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"impact of whole genome doubling on detection of circulating tumor dna in colorectal cancer","src":["aau","au","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/cancers15041136","version":"Published Version"},"funding_acknowledgement":["Innovation fund Denmark (9068-00046B), The Danish Cancer Society (R133-A8520-00-S41, R146-A9466-16-S2, R231-A13845, and R257-A14700), NEYE foundation, Novo Nordisk Fonden (NNF17OC0025052 and NNF22OC0074415), Sygeforsikringen “Danmark” (2020-0412)."],"id":"S03-100.00-009596","identifier":[{"id":"PMC9954709","type":"pmcid"},{"id":"85149124416","type":"scopus"},{"id":"36831479","type":"pmid"}],"ids":["aau-c7ed6353-a650-4e0c-a7ec-77553611873f","au-24214b80-a50f-4ee2-a093-785cfc7df904","sdu-ed42a6ea-0fa5-4b41-af35-a1aed4b8ead5"],"keyword":["cancer diagnostics","circulating tumor DNA","colorectal cancer","whole genome doubling"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-2F37E9CD91ED51010FD4BBCEC1ABF364"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/223690787/cancers_15_01136.pdf","version":"Pu