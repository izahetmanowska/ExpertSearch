s Gyrup","name_org":"Nielsen, Claus G.","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andrei","key":"ciubotariupau","last":"Ciubotariu","locid":"3f1f30ab-eb66-497c-94de-1166d13444f1","name":"Ciubotariu, Andrei","rank":4,"rolecode":"pau"},{"affno":"2","first":"Anders","key":"pernerpau","last":"Perner","locid":"8a389541-d529-4ee3-8364-66bfc85f77c9","name":"Perner, Anders","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jørn","key":"wetterslevpau","last":"Wetterslev","name":"Wetterslev, Jørn","rank":6,"rolecode":"pau"},{"affno":"2","first":"Theis","key":"langepau","last":"Lange","locid":"e4664578-01fc-4a93-8efd-1dbffb72cdd6","name":"Lange, Theis","orcid":"0000-0001-6807-8347","rank":7,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"country":"dk","first":"Bodil S.","key":"rasmussenpau","last":"Rasmussen","locid":"3162c449-94c3-4d28-8dbb-c134d6eb76e1","name":"Rasmussen, Bodil Steen","name_org":"Rasmussen, Bodil S.","orcid":"0000-0003-2190-145X","rank":8,"rolecode":"pau"}],"pmid":["32753102"],"pub":{"doi":"10.1016/j.bja.2019.12.039","issn":["00070912","14716771"],"issn_org":["00070912"],"issue":"4","journal":"British Journal of Anaesthesia","pages":"420-429","publisher":"Elsevier","status":"p","title":"British Journal of Anaesthesia","volume":"124"},"review":"Peer Reviewed","scoID":["2-s2.0-85079038879"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-b82d70a7-2e01-4fb8-afdc-995cd7f74cce","ku-ee6f0a1c-3bce-4299-bdc9-84b81ab24660"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"Arterial oxygen tensions in mechanically ventilated ICU patients and mortality: : a retrospective, multicentre, observational cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-095.96-008882","year":"2020","yearsub":"2020"}
{"abstract":"Temperate bacteriophages can enter one of two life cycles following infection of a sensitive host: the lysogenic or the lytic life cycle. The choice between the two alternative life cycles is dependent upon a tight regulation of promoters and their cognate regulatory proteins within the phage genome. We investigated the genetic switch of TP901-1, a bacteriophage of Lactococcus lactis, controlled by the CI repressor and the modulator of repression (MOR) antirepressor and their interactions with DNA. We determined the solution structure of MOR, and we solved the crystal structure of MOR in complex with the N-terminal domain of CI, revealing the structural basis of MOR inhibition of CI binding to the DNA operator sites. 15N NMR Carr–Purcell–Meiboom–Gill (CPMG) relaxation dispersion and rotating frame R1ρ measurements demonstrate that MOR displays molecular recognition dynamics on two different time scales involving a repacking of aromatic residues at the interface with CI. Mutations in the CI:MOR binding interface impair complex formation in vitro, and when introduced in vivo, the bacteriophage switch is unable to choose the lytic life cycle showing that the CI:MOR complex is essential for proper functioning of the genetic switch. On the basis of sequence alignments, we show that the structural features of the MOR:CI complex are likely conserved among a larger family of bacteriophages from human pathogens implicated in transfer of antibiotic resistance.","author_count":11,"contributors":["Rasmussen, Kim Krighaar","Palencia, Andrés","Varming, Anders K.","El-Wali, Habiba","Erba, Elisabetta Boeri","Blackledge, Martin","Hammer, Karin","Herrmann, Torsten","Kilstrup, Mogens","Leggio, Leila Lo","Jensen, Malene Ringkjøbing"],"cuid":["S02-100.00-034194"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD"],"corresponding_author":["Leggio, Leila Lo"],"country":["France"],"glorg":["All Global Affiliations","CNRS","University of Grenoble Alpes","Université Grenoble Alpes"],"keyword":["Genetic switch","NMR","Protein dynamics","Temperate bacteriophage","X ray crystallography"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"revealing the mechanism of repressor inactivation during switching of a temperate bacteriophage","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1073/pnas.2005218117","version":"Published Version"},"id":"S02-100.00-034194","identifier":[{"id":"PMC7456139","type":"pmcid"},{"id":"32788352","type":"pmid"},{"id":"000572978200007","type":"wos"},{"id":"85090075405","type":"scopus"}],"ids":["dtu-473d4342-f711-482c-9823-383be2f0f20b","ku-43ece3b1-03be-4408-9dbc-5031be8508fe"],"keyword":["Genetic switch","NMR","Protein dynamics","Temperate bacteriophage","X-ray crystallography"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-EF042486342950A86CFA48576D100CB8"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/260410357/Revealing_the_mechanism_of_repressor_inactivation_during_switching_of_a_temperate_bacteriophage.pdf","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/236196279/20576.full.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1073/pnas.2005218117","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"fr","key":"université grenoble alpes","loc":["France","Europe, EU","OECD"],"name":"Université Grenoble Alpes","used":1},{"affno":"2","country":"fr","key":"university of grenoble alpes","loc":["France","Europe, EU","OECD"],"name":"University of Grenoble Alpes","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Chemistry, Department of Chemistry"],"nora_code":"DI-U-KU","used":1},{"affno":"4","country":"fr","key":"cnrs","loc":["France","Europe, EU","OECD"],"name":"CNRS","used":1},{"affno":"5","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Biotechnology and Biomedicine","Technical University of Denmark, Department of Biotechnology and Biomedicine, Section for Microbial and Chemical Ecology","Technical University of Denmark, Department of Biotechnology and Biomedicine, Section for Microbial and Chemical Ecology, Metabolic Signaling and Regulation"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"","first":"Kim Krighaar","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Kim Krighaar","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Andrés","key":"palenciapau","last":"Palencia","name":"Palencia, Andrés","rank":2,"rolecode":"pau"},{"affno":"3","first":"Anders K.","key":"varmingpau","last":"Varming","locid":"6e74f1ad-2605-40bb-a45e-7d34896e6f35","name":"Varming, Anders Kokkenborg","name_org":"Varming, Anders K.","orcid":"0000-0001-6865-990X","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Habiba","key":"elwalipau","last":"El-Wali","name":"El-Wali, Habiba","rank":4,"rolecode":"pau"},{"affno":"4 2","corresponding":null,"first":"Elisabetta Boeri","key":"erbapau","last":"Erba","name":"Erba, Elisabetta Boeri","rank":5,"rolecode":"pau"},{"affno":"4 2","corresponding":null,"first":"Martin","key":"blackledgepau","last":"Blackledge","name":"Blackledge, Martin","rank":6,"rolecode":"pau"},{"affno":"5","corresponding":null,"country":"dk","first":"Karin","key":"hammerpau","last":"Hammer","locid":"9fcdb463-9cb0-4066-ab81-e81bcd8a22e0","name":"Hammer, Karin","rank":7,"rolecode":"pau"},{"affno":"4 2","corresponding":null,"first":"Torsten","key":"herrmannpau","last":"Herrmann","name":"Herrmann, Torsten","rank":8,"rolecode":"pau"},{"affno":"5","corresponding":null,"country":"dk","first":"Mogens","key":"kilstruppau","last":"Kilstrup","locid":"f852c88c-c2dd-4c1c-bb1d-119775a3d7e7","name":"Kilstrup, Mogens","orcid":"0000-0002-3900-723X","rank":9,"rolecode":"pau"},{"affno":"3","first":"Leila Lo","key":"leggiopau","last":"Leggio","locid":"9b2c31e6-b95b-4a32-a86f-6c3c0d53fd03","name":"Lo Leggio, Leila","name_org":"Leggio, Leila Lo","orcid":"0000-0002-5135-0882","rank":10,"rolecode":"pau"},{"affno":"","first":"Malene Ringkjøbing","key":"jensenpau","last":"Jensen","name":"Jensen, Malene Ringkjøbing","rank":11,"rolecode":"pau"}],"pmid":["32788352"],"pub":{"doi":"10.1073/pnas.2005218117","issn":["00278424","10916490"],"issn_org":["00278424"],"issue":"34","journal":"Proceedings of the National Academy of Sciences of the United States of America","pages":"20576-20585","publisher":"National Academy of Sciences","status":"p","title":"Proceedings of the National Academy of Sciences of the United States of America","volume":"117"},"review":"Peer Reviewed","scoID":["2-s2.0-85090075405"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-473d4342-f711-482c-9823-383be2f0f20b","ku-43ece3b1-03be-4408-9dbc-5031be8508fe"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Revealing the mechanism of repressor inactivation during switching of a temperate bacteriophage","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-034194","year":"2020","yearsub":"2020"}
{"abstract":"Objectives: Recurrent tuberculosis (TB) is defined by more than one TB episode per patient and is caused by reinfection with a new M. tuberculosis (Mtb) strain or relapse with the previous strain. In Denmark, a major TB outbreak caused by one specific Mtb genotype “DKC2” is ongoing. Of the 892 patients infected with DKC2 between 1992 and 2014, 32 had recurrent TB with 67 TB episodes in total. Methods: The 32 cases were evaluated in terms of number of single-nucleotide polymorphism (SNP) differences and time between episodes derived from whole-genome sequencing data. Results: For four TB cases, the subsequent episodes could be confirmed as relapse and for one case as reinfection. Eight cases with SNP differences <6, theoretically indicating relapse, could be classified as likely reinfections based on phylogenetic analysis in combination with geographical data. Subsequent TB episodes for the remaining 19 cases could not be classified as relapse or reinfection even though they all had a SNP difference of <6 SNPs. Conclusions: In newer studies, investigating recurrent TB with the use of WGS, the number of SNPs has been used to distinguish between relapse and reinfection. The algorithm proposed for this is not valid in the Danish TB outbreak setting as our findings challenge the interpretation of few SNP differences as representing relapse. However, when including phylogenetic analysis and geographical data in the analysis, classification of 13 of the 32 cases were possible.","author_count":6,"contributors":["Folkvardsen, Dorte Bek","Norman, Anders","Rasmussen, Erik Michael","Lillebaek, Troels","Jelsbak, Lars","Andersen, Åse Bengård"],"cuid":["S02-100.00-037131"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Folkvardsen, Dorte Bek"],"keyword":["Network","Recurrence","Reinfection","Relapse","Tuberculosis","WGS"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-DTU","DI-U-SDU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-U-DTU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"recurrent tuberculosis in patients infected with the predominant mycobacterium tuberculosis outbreak strain in denmark new insights gained through whole genome sequencing","src":["dtu","sdu"],"src-code":["DI-U-DTU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/269658335/PIIS1201971222000959.pdf","version":"Authors Final Version"},"funding_acknowledgement":["This study was approved by the Danish Data Protection Agency (Jnr. 2012-54-0100). In accordance with Danish law, observational studies performed in Denmark do not need approval from the Medical Ethics Committee or written consent from subjects. All analyses are presented anonymously. This work was supported by the Novo Nordisk Foundation [grant number NNF7651 ] and the Lundbeck Foundation [grant number R151-2013-14628 ]. The funders had no role in study design, data collection and interpretation, or the decision to submit the work for publication."],"id":"S02-100.00-037131","identifier":[{"id":"31918042","type":"pmid"},{"id":"85077660370","type":"scopus"}],"ids":["dtu-c955d57e-bd93-427f-9022-e28f64ca1ff3","sdu-93b5e8ad-37ac-4591-ae41-02c7d46b4031"],"keyword":["Network","Recurrence","Reinfection","Relapse","Tuberculosis","WGS"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-416D459106C43775DBFE8327F858F803"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/269658335/PIIS1201971222000959.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"dk","key":"ssi statens serum institut","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-SSI","l3nn":"SSI Statens Serum Institut","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SSI Statens Serum Institut","namevar":["Statens Serum Institut"],"nora_code":"DI-GV-SSI","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Biotechnology and Biomedicine"],"nora_code":"DI-U-DTU","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Infectious Diseases (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"4","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Dorte Bek","key":"folkvardsenpau","last":"Folkvardsen","name":"Folkvardsen, Dorte Bek","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Anders","key":"normanpau","last":"Norman","locid":"01abb082-e735-40c1-ae3b-0cfac5bfe1f4","name":"Norman, Anders","orcid":"0000-0002-1282-394X","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Erik Michael","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Erik Michael","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Troels","key":"lillebaekpau","last":"Lillebaek","name":"Lillebaek, Troels","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Lars","key":"jelsbakpau","last":"Jelsbak","locid":"0f152051-d6ff-4b86-b98f-2ce118ee9ee1","name":"Jelsbak, Lars","orcid":"0000-0002-5759-9769","rank":5,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Åse Bengård","key":"andersenpau","last":"Andersen","locid":"a8872eef-ddea-4708-acdb-b238eaef934c","name":"Andersen, Åse Bengård","rank":6,"rolecode":"pau"}],"pmid":["31918042"],"pub":{"doi":"10.1016/j.meegid.2020.104169","issn":["15671348","15677257"],"issn_org":["15671348"],"journal":"Infection, Genetics and Evolution","paperid":"104169","publisher":"Elsevier","status":"p","title":"Infection, Genetics and Evolution","volume":"80"},"review":"Peer Reviewed","scoID":["2-s2.0-85077660370"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Technical University of Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["dtu-c955d57e-bd93-427f-9022-e28f64ca1ff3","sdu-93b5e8ad-37ac-4591-ae41-02c7d46b4031"],"src":["DTU Technical University of Denmark","SDU University of Southern Denmark"],"title":"Recurrent tuberculosis in patients infected with the predominant Mycobacterium tuberculosis outbreak strain in Denmark. New insights gained through whole genome sequencing","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-037131","year":"2020","yearsub":"2020"}
{"abstract":"Background: In patients with septic shock, mortality is high, and survivors experience long-term physical, mental and social impairments. The ongoing Conservative vs Liberal Approach to fluid therapy of Septic Shock in Intensive Care (CLASSIC) trial assesses the benefits and harms of a restrictive vs standard-care intravenous (IV) fluid therapy. The hypothesis is that IV fluid restriction improves patient-important long-term outcomes. Aim: To assess the predefined patient-important long-term outcomes in patients randomised into the CLASSIC trial. Methods: In this pre-planned follow-up study of the CLASSIC trial, we will assess all-cause mortality, health-related quality of life (HRQoL) and cognitive function 1 year after randomisation in the two intervention groups. The 1-year mortality will be collected from electronic patient records or central national registries in most participating countries. We will contact survivors and assess EuroQol 5-Dimension, -5-Level (EQ-5D-5L) and EuroQol-Visual Analogue Scale and Montreal Cognitive Assessment 5-minute protocol score. We will analyse mortality by logistic regression and use general linear models to assess HRQoL and cognitive function. Discussion: With this pre-planned follow-up study of the CLASSIC trial, we will provide patient-important data on long-term survival, HRQoL and cognitive function of restrictive vs standard-care IV fluid therapy in patients with septic shock.","author_count":32,"contributors":["Kjaer, Maj-Brit Nørregaard","Meyhoff, Tine Sylvest","Madsen, Martin Bruun","Hjortrup, Peter Buhl","Møller, Morten Hylander","Egerod, Ingrid","Wetterslev, Jørn","Lange, Theis","Cronhjort, Maria","Laake, Jon Henrik","Jakob, Stephan M","Nalos, Marek","Pettilä, Ville","van der Horst, Iwan C C","Ostermann, Marlies","Mouncey, Paul","Cecconi, Maurizio","Ferrer, Ricard","L N G Malbrain, Manu","Ahlstedt, Christian","Hoffmann, Søren","Bestle, Morten H","Gyldensted, Louise","Nebrich, Lars","Russell, Lene","Vang, Marianne","Sølling, Christoffer","Brøchner, Anne Craveiro","Rasmussen, Bodil Steen","Perner, Anders"],"cuid":["S03-098.68-002669"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD","Oceania"],"corresponding_author":["Kjær, Maj Brit N."],"country":["Australia","Belgium","Czechia","Finland","Italy","Netherlands","Norway","Spain","Sweden","Switzerland","United Kingdom"],"glorg":["All Global Affiliations","Czech Academy of Sciences","Free University of Brussels","Guy's and St Thomas' NHS Foundation Trust","Helsinki University Hospital","Hospital Universitari Vall d'Hebron, Barcelona, Spain.","Humanitas Research Hospital","Intensive Care National Audit & Research Centre (ICNARC)","Karolinska Institute","Karolinska Institutet","Karolinska University Hospital","Maastricht University","Maastricht University Medical Center+","Maastricht University Medical Centre+","Oslo University Hospital","University Hospital Bern","University Hospital Brussel","University Hospital Brussels","University Hospital of Bern","University Hospitals Brussels (UZB)","University of Bern","University of Helsinki","University of Melbourne","University of Oslo","University of Pisa","Vall d'Hebron University Hospital","Vrije Universiteit Brussel"],"keyword":["Cognitive function","Follow up","HRQoL","IV fluid therapy","patient important outcomes","randomised clincial trial"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-OTH","DI-HO-SDR","DI-HO-ZEA"],"OT":["Medical Intensive Care Unit, Interni klinika, Fakultni Nemocnice, Plzen, Czech Republic."],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU","DI-U-UND"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-OTH","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU",