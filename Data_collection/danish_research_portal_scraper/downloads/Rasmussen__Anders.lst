isco W.","key":"cruzfranciscowpau","last":"Cruz","name":"Cruz, Francisco W.","rank":24,"rolecode":"pau"},{"affno":"","first":"H.","key":"chenghpau","last":"Cheng","name":"Cheng, H.","rank":25,"rolecode":"pau"}],"pmid":["36195764"],"pub":{"doi":"10.1038/s41467-022-33583-4","issn":["20411723"],"issue":"1","journal":"Nature Communications","paperid":"5867","status":"p","title":"Nature Communications","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-85139365482"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-9efb49df-e3f6-4330-821b-850a44e796dd"],"src":["KU University of Copenhagen"],"title":"Coupled atmosphere-ice-ocean dynamics during Heinrich Stadial 2","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-488454","year":"2022","yearsub":"2022"}
{"abstract":"Introduction: Shortened erythrocyte life span and erythropoietin-stimulating agents may affect hemoglobin A1c (HbA1c) levels in patients receiving peritoneal dialysis (PD). We compared HbA1c with interstitial glucose measured by continuous glucose monitoring (CGM) in patients with type 2 diabetes receiving PD. Methods: Fourteen days of CGM (Ipro2, Medtronic) were performed in 23 patients with type 2 diabetes receiving PD and in 23 controls with type 2 diabetes and an estimated glomerular filtration rate over 60 mL/min/1.73 m2. Patients were matched on gender and age (±5 years). HbA1c (mmol/mol), its derived estimate of mean plasma glucose (eMPGA1c) (mmol/L), and fructosamine (µmol/L) were measured at the end of the CGM period and compared with the mean sensor glucose (mmol/L) from CGM. Results: In the PD group, mean sensor glucose was 0.98 (95% con­fidence interval (CI): 0.43–1.54) mmol/L higher than the eMPGA1c compared with the control group (p = 0.002) where glucose levels were nearly identical (−0.05 (95% CI: −0.35–0.25) mmol/L). A significant association was found between fructosamine and mean sensor glucose using linear regression with no difference between slopes (p = 0.89) or y-intercepts (p = 0.28). Discussion/Conclusion: HbA1c underestimates mean plasma glucose levels in patients with type 2 diabetes receiving PD. However, the clinical significance of this finding is undetermined. Fructosamine seems to more accurately reflect glycemic status. CGM or fructosamine could complement HbA1c to increase the accuracy of glycemic monitoring in the PD population.","author_count":13,"contributors":["Bomholt, Tobias","Feldt-Rasmussen, Bo","Butt, Rizwan","Borg, Rikke","Sarwary, Mir Hassan","Elung-Jensen, Thomas","Almdal, Thomas","Knop, Filip K.","Nørgaard, Kirsten","Ranjan, Ajenthen G.","Larsson, Anders","Rix, Marianne","Hornum, Mads"],"cuid":["S01-000.00-520976"],"filters":{"added":"2022-08","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Sweden"],"glorg":["All Global Affiliations","Uppsala University"],"keyword":["Continuous glucose monitoring","Diabetic nephropathy","Fructosamine","Hemoglobin A1c","Peritoneal dialysis"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"OT":["Steno Diabetes Centre, Gentofte, Denmark."],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"hemoglobin a000000000001c and fructosamine evaluated in patients with type 000000000002 diabetes receiving peritoneal dialysis using long term continuous glucose monitoring","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-520976","identifier":[{"id":"85119345333","type":"scopus"},{"id":"000716425600001","type":"wos"},{"id":"34731864","type":"pmid"}],"ids":["ku-d57d46b5-4cff-46f1-a571-c41cdab103ea"],"keyword":["Continuous glucose monitoring","Diabetic nephropathy","Fructosamine","Hemoglobin A1c","Peritoneal dialysis"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-7CFF80550409943A6EDBD9B5649AE6D3"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital – North Zealand"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Steno Diabetes Centre, Gentofte, Denmark."],"nora_code":"DI-OT","used":1},{"affno":"4","country":"se","key":"uppsala university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Uppsala University","used":1}],"person":[{"affno":"1","first":"Tobias","key":"bomholtpau","last":"Bomholt","locid":"00f4e3a0-ae66-4b1e-9ecb-26b698195aaf","name":"Bomholt, Tobias","rank":1,"rolecode":"pau"},{"affno":"1","first":"Bo","key":"feldtrasmussenpau","last":"Feldt-Rasmussen","locid":"cdd06e7b-83c5-4118-8808-eb4591586aac","name":"Feldt-Rasmussen, Bo","rank":2,"rolecode":"pau"},{"affno":"1","first":"Rizwan","key":"buttpau","last":"Butt","locid":"61bd3d39-b799-4f49-bcda-ac9ef095d057","name":"Butt, Rizwan","rank":3,"rolecode":"pau"},{"affno":"1","first":"Rikke","key":"borgpau","last":"Borg","locid":"19f3b871-b1fc-4653-aee0-be709d2a16c9","name":"Borg, Rikke","orcid":"0000-0002-2283-3578","rank":4,"rolecode":"pau"},{"affno":"2","first":"Mir Hassan","key":"sarwarypau","last":"Sarwary","name":"Sarwary, Mir Hassan","rank":5,"rolecode":"pau"},{"affno":"2","first":"Thomas","key":"elungjensenpau","last":"Elung-Jensen","name":"Elung-Jensen, Thomas","rank":6,"rolecode":"pau"},{"affno":"2 1","first":"Thomas","key":"almdalpau","last":"Almdal","locid":"cae595b0-e059-48f9-b1e4-153595fd7455","name":"Almdal, Thomas","rank":7,"rolecode":"pau"},{"affno":"1 3","first":"Filip K.","key":"knoppau","last":"Knop","locid":"ce6eaad9-59f8-4ecf-8a1e-388a74734f6a","name":"Knop, Filip K.","rank":8,"rolecode":"pau"},{"affno":"1 3","first":"Kirsten","key":"nørgaardpau","last":"Nørgaard","locid":"771b216e-eeb8-449e-8cde-2cdd59ae6dbc","name":"Nørgaard, Kirsten","rank":9,"rolecode":"pau"},{"affno":"3","first":"Ajenthen G.","key":"ranjanpau","last":"Ranjan","name":"Ranjan, Ajenthen G.","rank":10,"rolecode":"pau"},{"affno":"4","first":"Anders","key":"larssonpau","last":"Larsson","name":"Larsson, Anders","rank":11,"rolecode":"pau"},{"affno":"2","first":"Marianne","key":"rixpau","last":"Rix","name":"Rix, Marianne","rank":12,"rolecode":"pau"},{"affno":"1","first":"Mads","key":"hornumpau","last":"Hornum","locid":"6e7135d6-13c5-4f40-a3da-e8adf896bc7d","name":"Hornum, Mads","rank":13,"rolecode":"pau"}],"pmid":["34731864"],"pub":{"doi":"10.1159/000519493","issn":["16602110","16608151"],"issn_org":["16608151"],"issue":"2","journal":"Nephron","pages":"146-152","status":"p","title":"Nephron","volume":"146"},"review":"Peer Reviewed","scoID":["2-s2.0-85119345333"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-d57d46b5-4cff-46f1-a571-c41cdab103ea"],"src":["KU University of Copenhagen"],"title":"Hemoglobin A1c and Fructosamine Evaluated in Patients with Type 2 Diabetes Receiving Peritoneal Dialysis Using Long-Term Continuous Glucose Monitoring","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-520976","year":"2022","yearsub":"2022"}
{"abstract":"Projektet Fællesskab med nydanskere - et skridt på vejen til beskæftigelse var et treårigt forsknings- og udviklingsprojekt målrettet flygtningefamilier fra Syrien, og blev gennemført i perioden 2018 – 2021. Projektet havde til hensigt at styrke familieskabet og forbedre flygtningefamiliers livsmestring gennem øget trivsel og handlekompetence og dermed skabe bedre forudsætninger for at gennemføre en uddannelse eller opnå beskæftigelse gennem job eller iværksætteri.","author_count":16,"contributors":["Nielsen, Nina Odgaard","Storm, Helle","Rafn, Anne Vollen","Petersen, Birthe","Kjærsgaard, Hanne","Rasmussen, Henrik Gerner","Rafn, Jan","Lindahl, Marianne Pia","Andersen, Signe","Præstegaard, Jeanette","Helqvist, Rebecca Stephanie","Pedersen, Anders","Hemmingsen, Henriette","Loman, Jette","Mathiesen, Rikke Hinsby","Sønderskov, Anne Juul"],"cuid":["S01-000.00-555588"],"filters":{"added":"2023-02","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Integration","Livskvalitet","Sundhed","Trivsel"],"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-UC"],"level3":{"OT":["Næstved Kommune"],"UC":["DI-UC-AB","DI-UC-ALL"]},"level3all":["DI-UC-AB"]},"review":"nr","rtype":["clu"],"sorti":"fællesskab med nydanskere et skridt på vejen til beskæftigelse","src":["pha"],"src-code":["DI-UC-AB"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://ucviden.pha.dk/ws/files/89183880/F_llesskab_med_nydanskere_Afsluttende_projektrapport_SIKRET.pdf","version":"Published Version"},"id":"S01-000.00-555588","ids":["pha-ddeaba9b-c0ee-4f1d-b8c5-bff6b0b68b0b"],"keyword":["Integration","livskvalitet","sundhed","trivsel"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-12DAAC8624D4CFCDEF960F1899BE9424"],"oa_link":[{"access":"oa","type":"loc","url":"https://ucviden.pha.dk/ws/files/89183880/F_llesskab_med_nydanskere_Afslutt