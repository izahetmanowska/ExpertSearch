 of Denmark, Department of Environmental and Resource Engineering, Circularity & Environmental Impact"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"L. M.","key":"skjoldingpau","last":"Skjolding","locid":"0f7dbfa4-64f2-449a-bb3e-f9d14d60b2ca","name":"Skjolding, Lars Michael","name_org":"Skjolding, L. M.","orcid":"0000-0002-3280-1836","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ann Flemming","key":"nielsenpau","last":"Nielsen","locid":"7865ecb3-ce06-4f08-b8d1-8f500d445f36","name":"Nielsen, Ann Flemming","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"T. F.","key":"poulsenpau","last":"Poulsen","name":"Poulsen, T. F.","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"S. B.","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, S. B.","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anders","key":"baunpau","last":"Baun","locid":"f3cdf4a9-bfc7-4e0e-bf46-df0da8134f0d","name":"Baun, Anders","orcid":"0000-0003-1396-408X","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-e5fce96d-2584-4a29-baf2-c517db6aa98c"],"src":["DTU Technical University of Denmark"],"title":"Merits of the MERIT project : Potential for Zero Harmful Discharges to Sea Through Toxicity Identification Evaluation of Produced Water Samples from The North Sea","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-712307","year":"2023","yearsub":"2023"}
{"abstract":"Aims: Little is known about the influence of parents’ screen media habits and attitudes towards screen media on children’s screen use. We investigated associations of parental screen use, their smartphone addiction and screen media attitudes, with children’s recreational screen use. Methods: This study was based on a population-based cross-sectional survey sent between May 2019 and November 2020 to a random sample of 6820 Danish parent–child dyads who answered questions regarding their screen media habits. Children were 6–11 years of age and had to reside with the parent. Multivariable adjusted regression analyses were conducted (in October 2021) separately for screen media use on weekdays and weekend days. Results: The analyses included 5437 parents (41.0 years, 67.6% girls) and 5437 children (8.9 years, 48.2% girls). The adjusted relative odds of excessive amounts of screen use of children (>3 hours/weekday and >4 hours/weekend day) was 5.8 (95% confidence interval (CI) 4.6; 7.3) on weekdays and 7.2 (95% CI 5.9; 8.8) on weekend days comparing the fourth and first quartile of parental screen use. Children of parents in the fourth quartile of parental screen use had 2.1 (95% CI 1.7; 2.5) and 2.5 (95% CI 2.2; 3.0) greater odds of screen use before bedtime on all week and weekend days, respectively. Children of parents who had a positive attitude towards their child’s screen use or were at high risk of smartphone addiction had significantly higher screen use and more frequent problematic screen use. Conclusions: Parent’s screen media habits and attitudes were strongly associated with their children’s recreational screen use.","author_count":7,"contributors":["Sørensen, Sarah Overgaard","Gejl, Anne Kær","Pedersen, Jesper","Rasmussen, Martin Gillies Banke","Olesen, Line Grønholt","Kristensen, Peter Lund","Grøntved, Anders"],"cuid":["S01-000.00-713903"],"filters":{"added":"2024-02","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Grøntved, Anders"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"recreational screen media use among danish children aged 000000000006 000000000011 years influence of parental screen media habits and attitudes","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/213945299/Accepted_manuscript.pdf","version":"Authors Final Version"},"id":"S01-000.00-713903","identifier":[{"id":"85132268945","type":"scopus"},{"id":"35708326","type":"pmid"}],"ids":["sdu-43fe1eab-1e12-4428-882b-c1042185407b"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-3C56D43FA0D2D9B9BA891D073567CD90"],"oa_link":[{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/213945299/Accepted_manuscript.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics, Research Unit of Exercise Epidemiology"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Sarah Overgaard","key":"sørensenpau","last":"Sørensen","locid":"ee7fa7d0-8bb4-4eca-a31d-26ce06940514","name":"Sørensen, Sarah Overgaard","orcid":"0000-0002-3953-3387","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anne Kær","key":"gejlpau","last":"Gejl","locid":"275fae7f-a794-4f46-b268-8a68caf1c8ab","name":"Gejl, Anne Kær","orcid":"0000-0001-6781-2263","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper","key":"pedersenpau","last":"Pedersen","locid":"f321394d-8abe-49b2-ab02-1b528e734f63","name":"Pedersen, Jesper","orcid":"0000-0002-9475-0341","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Martin","key":"rasmussenpau","last":"Rasmussen","locid":"8b86a1ef-e6c1-4de3-8300-e30d144bbf60","name":"Rasmussen, Martin Gillies Banke","name_org":"Rasmussen, Martin","orcid":"0000-0002-2114-2185","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Line Grønholt","key":"olesenpau","last":"Olesen","locid":"e9ad7180-8cce-4e88-9707-18dedc4c73e0","name":"Olesen, Line Grønholt","orcid":"0000-0002-6588-8878","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter Lund","key":"kristensenpau","last":"Kristensen","locid":"751d26de-66d4-4ef9-8183-880c48c96dc7","name":"Kristensen, Peter Lund","orcid":"0000-0002-5666-9614","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders","key":"grøntvedpau","last":"Grøntved","locid":"393b1ca1-e658-437c-9ca3-73aea925ad58","name":"Grøntved, Anders","orcid":"0000-0003-1584-679X","rank":7,"rolecode":"pau"}],"pmid":["35708326"],"pub":{"doi":"10.1177/14034948221103463","issn":["14034948","16511905"],"issn_org":["14034948"],"issue":"8","journal":"Scandinavian Journal of Public Health","pages":"1173-1181","publisher":"SAGE Publications","status":"p","title":"Scandinavian Journal of Public Health","volume":"51"},"review":"Peer Reviewed","scoID":["2-s2.0-85132268945"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-43fe1eab-1e12-4428-882b-c1042185407b"],"src":["SDU University of Southern Denmark"],"title":"Recreational screen media use among Danish children aged 6–11 years: influence of parental screen media habits and attitudes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-713903","year":"2023","yearsub":"2023"}
{"abstract":"We present a dynamic algorithm for maintaining the connected and 2-edge-connected components in an undirected graph subject to edge deletions. The algorithm is Monte-Carlo randomized and processes any sequence of edge deletions in O(m + npoly log n) total time. Interspersed with the deletions, it can answer queries whether any two given vertices currently belong to the same (2-edge-)connected component in constant time. Our result is based on a general Monte-Carlo randomized reduction from decremental c-edge-connectivity to a variant of fully-dynamic c-edge-connectivity on a sparse graph. For non-sparse graphs with Ω(npoly log n) edges, our connectivity and 2-edge-connectivity algorithms handle all deletions in optimal linear total time, using existing algorithms for the respective fully-dynamic problems. This improves upon an O(mlog(n2/m) + npoly log n)-time algorithm of Thorup [J.Alg. 1999], which runs in linear time only for graphs with Ω(n2) edges. Our constant amortized cost for edge deletions in decremental connectivity in non-sparse graphs should be contrasted with an Ω(log n/log log n) worst-case time lower bound in the decremental setting [Alstrup, Husfeldt, and Rauhe FOCS’98] as well as an Ω(log n) amortized time lower-bound in the fully-dynamic setting [Patrascu and Demaine STOC’04].","author_count":9,"contributors":["Aamand, Anders","Karczmarz, Adam","Łącki, Jakub","Parotsidis, Nikos","Rasmussen, Peter Michael Reichstein","Thorup, Mikkel"],"cuid":["S01-000.00-719402"],"event":{"end":"2023-07-14","place":"Paderborn, de","start":"2023-07-10","title":"50th International Colloquium on Automata, Languages, and Programming, ICALP 2023","year":"2023"},"filters":{"added":"2024-03","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Europe, EU","OECD"],"country":["Poland","United States"],"glorg":["All Global Affiliations","Google","IDEAS NCBR","Massachusetts Institute of Technology","University of Warsaw"],"keyword":["Dynamic connectivity"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"optimal decremental connectivity in non sparse graphs","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.4230/LIPIcs.ICALP.2023.6","version":"Published Version"},"id":"S01-000.00-719402","identifier":[{"id":"85162769409","type":"scopus"}],"ids":["ku-17d951d4-5397-4ea8-80d8-313299712e3e"],"keyword":["decremental connectivity","dynamic connectivity"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-839EB11F52604B409B406C09C810EBAE"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.4230/LIPIcs.ICALP.2023.6","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/382560862/Optimal_Decremental_Connectivity.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"us","key":"massachusetts institute of technology","loc":["United States","America, North","OECD"],"name":"Massachusetts Institute of Technology","used":1},{"affno":"2","country":"pl","key":"university of warsaw","loc":["Poland","Europe, EU","OECD"],"name":"University of Warsaw","used":1},{"affno":"3","country":"pl","key":"ideas ncbr","loc":["Poland","Europe, EU","OECD"],"name":"IDEAS NCBR","used":1},{"affno":"4","country":"us","key":"google","loc":["United States","America, North","OECD"],"name":"Google","used":1},{"affno":"5","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Scien