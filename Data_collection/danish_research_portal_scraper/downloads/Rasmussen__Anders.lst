r, Kurt H.","orcid":"0000-0002-8871-5179","rank":62,"rolecode":"pau"},{"affno":"9 23 24 25","corresponding":null,"first":"Richard","key":"durbinrichardpau","last":"Durbin","name":"Durbin, Richard","rank":63,"rolecode":"pau"},{"affno":"1 17 3","first":"Rasmus","key":"nielsenrasmuspau","last":"Nielsen","locid":"68905e51-280a-4c0b-bc94-469bb52de9b6","name":"Nielsen, Rasmus","orcid":"0000-0003-0513-6591","rank":64,"rolecode":"pau"},{"affno":"15","corresponding":null,"first":"Olivier","key":"delaneauolivierpau","last":"Delaneau","name":"Delaneau, Olivier","rank":65,"rolecode":"pau"},{"affno":"8 1","first":"Thomas","key":"wergethomaspau","last":"Werge","locid":"905c01bb-6319-4ce6-a38e-ceb5bf73d2f6","name":"Werge, Thomas","rank":66,"rolecode":"pau"},{"affno":"1 7 3 26","first":"Kristian","key":"kristiansenkristianpau","last":"Kristiansen","locid":"6d10c961-d4c9-45dc-9f7b-d872efe06c48","name":"Kristiansen, Kristian","rank":67,"rolecode":"pau"},{"affno":"1 9 27 3 28 29","first":"Eske","key":"willersleveskepau","last":"Willerslev","locid":"21d2e042-0513-44fe-8acd-56b0d00a603e","name":"Willerslev, Eske","orcid":"0000-0002-7081-6748","rank":68,"rolecode":"pau"}],"pmid":["38200294"],"pub":{"doi":"10.1038/s41586-023-06862-3","issn":["00280836","14764687"],"issn_org":["14764687"],"issue":"7994","journal":"Nature","pages":"329-337","publisher":"Nature Research","status":"p","title":"Nature","volume":"625"},"review":"Peer Reviewed","scoID":["2-s2.0-85181852344"],"sdg":["15. Life on Land","All UN SDG Classification"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Miscellaneous","All Non-Profit Organisations","All Private Research","All Universities","Capital Region of Denmark","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-NP","DI-NP-ALL","DI-OT","DI-OT-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Miscellaneous","Non-Profit Organisations","Other Companies","Other Research","Private Research","Region Zealand","Technical University of Denmark","Universities","University of Copenhagen","smv company (denmark)"],"PST":["Published"]},"sid":["au-36e20316-953f-4b7e-8bf8-7d9b68312937","dtu-51f0d451-d77c-4b97-a324-cf22ebf8cf7f","ku-a31b4a17-dfc3-4b86-bc27-997244bc73ab","kum-f9506713-be49-427d-b3e5-d6d262522f75"],"src":["AU Aarhus University","DTU Technical University of Denmark","KU University of Copenhagen","KUM Ministry of Culture - Archives, Museums, and Royal Library Denmark"],"title":"100 ancient genomes show repeated population turnovers in Neolithic Denmark","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-095.15-793206","year":"2024","yearsub":"2024"}
{"abstract":"Purpose: We assessed long-term outcomes in acutely admitted adult patients with delirium treated in intensive care unit (ICU) with haloperidol versus placebo. Methods: We conducted pre-planned analyses of 1-year outcomes in the Agents Intervening against Delirium in the ICU (AID-ICU) trial, including mortality and health-related quality of life (HRQoL) assessed by Euroqol (EQ) 5-dimension 5-level questionnaire (EQ-5D-5L) index values and EQ visual analogue scale (EQ VAS) (deceased patients were assigned the numeric value zero). Outcomes were analysed using logistic and linear regressions with bootstrapping and G-computation, all with adjustment for the stratification variables (site and delirium motor subtype) and multiple imputations for missing HRQoL values. Results: At 1-year follow-up, we obtained vital status for 96.2% and HRQoL data for 83.3% of the 1000 randomised patients. One-year mortality was 224/501 (44.7%) in the haloperidol group versus 251/486 (51.6%) in the placebo group, with an adjusted absolute risk difference of − 6.4%-points (95% confidence interval [CI] − 12.8%-points to − 0.2%-points; P = 0.045). These results were largely consistent across the secondary analyses. For HRQoL, the adjusted mean differences were 0.04 (95% CI − 0.03 to 0.11; P = 0.091) for EQ-5D-5L-5L index values, and 3.3 (95% CI − 9.3 to 17.5; P = 0.142) for EQ VAS. Conclusions: In acutely admitted adult ICU patients with delirium, haloperidol treatment reduced mortality at 1-year follow-up, but did not statistically significantly improve HRQoL.","author_count":26,"contributors":["Mortensen, Camilla Bekker","Andersen-Ranberg, Nina Christine","Poulsen, Lone Musaeus","Granholm, Anders","Rasmussen, Bodil Steen","Kjær, Maj Brit Nørregaard","Lange, Theis","Ebdrup, Bjørn H.","Collet, Marie Oxenbøll","Andreasen, Anne Sofie","Bestle, Morten H.","Uslu, Bülent","Pedersen, Helle Scharling","Nielsen, Louise Gramstrup","Hästbacka, Johanna","Jensen, Troels Bek","Damgaard, Kjeld","Sommer, Trine","Morgen, Matthew","Dey, Nilanjan","Citerio, Guiseppe","Estrup, Stine","Egerod, Ingrid","Samuelson, Karin","Perner, Anders","Mathiesen, Ole"],"cuid":["S04-095.92-724259"],"filters":{"added":"2024-02","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Mortensen, Camilla Bekker"],"country":["Finland","Italy","Sweden","United Kingdom"],"glorg":["All Global Affiliations","Cardiff University","Helsinki University Hospital","Lund University","Tampere University","Tampere University Hospital","University Hospital Wales","University Hospital of Wales","University of Helsinki","University of Milan - Bicocca","University of Milano Bicocca"],"keyword":["Adult","Delirium","Delirium drug therapy","Haloperidol therapeutic use","Health related quality of life","Hospitalization","Humans","ICU","Intensive Care Units","Long term outcomes","Mortality","Quality of Life","Treatment"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-OTH","DI-HO-SDR","DI-HO-ZEA"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU","DI-U-UND"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-OTH","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU","DI-U-UND"]},"review":"pr","rtype":["clu"],"sorti":"long term outcomes with haloperidol versus placebo in acutely admitted adult icu patients with delirium","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1007/s00134-023-07282-7","version":"Published Version"},"funding_acknowledgement":["AG, MBNK, MOC and AP are affiliated with the Department of Intensive Care at Rigshospitalet, which has received funding for other projects from The Novo Nordisk Foundation, Pfizer, and Fresenius Kabi, Sygeforsikringen “danmark”. AP has received an honorarium from Novartis for the participation in an advisory board. AP is on DSMB for The Mega-Rox trial, UK-Rox trial, Bone Zone trial. BSR are affiliated with the Department of Anaesthesia and Intensive Care, Aalborg University Hospital, Aalborg, Denmark, which has received funding for other project from Novo Nordisk Foundation, Danish Ministry of Education and Science and Beckett Foundation. MHB are affiliated with the Department of Anaesthesia and Intensive Care at Copenhagen University Hospital – North Zealand, which has received funding for other research projects from The Novo Nordisk Foundation, Sygeforsikringen “danmark”, Toyota Foundation, A.P. Moeller Foundation, Frimodt-Heineke Foundation, Svend Andersen Foundation, Ehrenreich Foundation, and Olga Bryde Nielsen Foundation, and has conducted contract research for AM-Pharma (the REVIVAL trial) and Inotrem (ASTONISH trial). MHB has received an honorarium from AM-Pharma for participation in an advisory board. TL is a member of DSMB for Novo Nordisk and Leo Pharma study. BE is part of the Advisory Board of Eli Lilly Denmark A/S, Janssen-Cilag, Lundbeck Pharma A/S, and Takeda Pharmaceutical Company Ltd; and has received lecture fees from Bristol-Myers Squibb, Boehringer Ingelheim, Otsuka Pharma Scandinavia AB, Eli Lilly Company, and Lundbeck Pharma A/S. JH has received funding from Paulo foundation, Finska Läkaresällskapet, NordForsk and Tor och Kirsti Johanssons Hjärt och Cancerstiftelse. GC has received istituational research grants from Neuroptics and Integra and is a board member at Neuroptics, Integra, Biogen, Invex Therapeutics and Idorsia. All other authors have no conflicts to disclose. Open access funding provided by Lund University. The AID-ICU trial is funded by The Innovation Fund Denmark, Zealand Region Research Fund, Foght Foundation, Hindsgavl Intensive Care Symposium, and the Regions of Denmark Medical Research Fund. The funders had no influence on trial design, conduct, or report. This research was supported by Innovationsfonden (Grant 4108-00011B)."],"id":"S04-095.92-724259","identifier":[{"id":"38170227","type":"pmid"},{"id":"85181235598","type":"scopus"},{"id":"PMC10811094","type":"pmcid"}],"ids":["aau-9410a21e-4879-4681-a535-8c311fcff681","au-095ba0bc-4cd6-48dd-a49c-04cc1506a342","ku-cb4ab328-91d9-4adb-86a0-9e0f075c250f","sdu-f323383b-180a-45b6-a420-f443676d45ed"],"keyword":["Adult","Delirium","Delirium/drug therapy","Haloperidol/therapeutic use","Health-related quality of life","Hospitalization","Humans","ICU","Intensive Care Units","Long-term outcomes","Mortality","Quality of Life","Treatment"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-7-F461E02EDBFF703C9A6808FEAED357F7"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1007/s00134-023-07282-7","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/254158852/s00134-023-07282-7.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/645141227/Mortensen_et_al._2024_._Long-term_outcomes_with_haloperidol_versus_placebo_in_acutely_admitted_adult_ICU_patients_with_delirium.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/380197120/s00134_023_07282_7.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Copenhagen University Hospital - Næstved, Slagelse and Ringsted"],"nora_code":"DI-HO-ZEA","used":1},{"affno":"2","country":"se","key":"lund univer