ublication","rolecode":"pedh"},{"affno":"","first":"Anne-Marie","key":"maipedh","last":"Mai","name":"Mai, Anne-Marie","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Helle","key":"ploughansenpedh","last":"Ploug Hansen","name":"Ploug Hansen, Helle","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9788712063865"],"pages":"117-131","place":"København","publisher":"Gad","status":"p","title":"Narrativ medicin i uddannelse og praksis"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-8ea248fc-f12d-4d9c-8747-0be189a4d7d7"],"src":["SDU University of Southern Denmark"],"title":"E-mail-konsultation i almen praksis. Refleksiv skrivning og samskabte narrativer","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-614083","year":"2021","yearsub":"2021"}
{"abstract":"Objective Salivary cortisol and cortisone are used as biomarkers of physiological stress. Careful sampling of saliva for profiling of awakening response and the diurnal slope can be challenging in free-living environments, and validated sampling protocols are lacking. Therefore, we investigated (1) the level of compliance to a three-day home-based salivary sampling protocol, and (2) the within subject day-to-day variability of cortisol and cortisone outcomes and the required measuring days to obtain high reproducibility. Results Nineteen healthy adults (mean age: 42, 50% females) participated. Participants collected in total 434 salivary samples out of 456 scheduled (four samples per day over three consecutive days at two time points). We found high level of compliance to the proposed free-living salivary sampling protocol with 18 (95%) and 16 (84%) participants being compliant to numbers and timing of samples, respectively. The area under the curve for the morning salivary samples and peak-to-bed slope had moderate reproducibility for cortisol and cortisone (intraclass correlation coefficient: 0.51–0.68, and mean coefficient of variation: 14.7%-75.3%). Three-to-four measuring days were required for high reproducibility of the area under the curve for the morning salivary samples and peak-to-bed slope using this free-living salivary sampling protocol. Trial registration Clinical trial registered with www.clinicaltrials.gov (NCT03788525).","author_count":5,"contributors":["Sørensen, Sarah Overgaard","Pedersen, Jesper","Rasmussen, Martin Gillies Banke","Kristensen, Peter Lund","Grøntved, Anders"],"cuid":["S01-000.00-618096"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Sørensen, Sarah Overgaard"],"keyword":["Adult","Circadian rhythm","Cortisol","Cortisone","Feasibility","Feasibility Studies","Female","Humans","Hydrocortisone","Male","Physiological stress","Reproducibility of Results","Saliva"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"feasibility of home based sampling of salivary cortisol and cortisone in healthy adults","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s13104-021-05820-4","version":"Published Version"},"id":"S01-000.00-618096","identifier":[{"id":"34727972","type":"pmid"},{"id":"PMC8561883","type":"pmcid"},{"id":"85118687078","type":"scopus"}],"ids":["sdu-9cba593f-3660-4168-a7e4-4a30013da3aa"],"keyword":["Adult","Circadian Rhythm","Cortisol","Cortisone","Feasibility","Feasibility Studies","Female","Humans","Hydrocortisone","Male","Physiological stress","Reproducibility of Results","Saliva"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-B07733551D473E185BFBEF9E98A21956"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s13104-021-05820-4","version":"Published Version"},{"access":"oa","license":"CC0","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/193962957/s13104_021_05820_4.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics, RICH - Research In Childhood Health","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics, Research Unit of Exercise Epidemiology"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Sarah Overgaard","key":"sørensenpau","last":"Sørensen","locid":"ee7fa7d0-8bb4-4eca-a31d-26ce06940514","name":"Sørensen, Sarah Overgaard","orcid":"0000-0002-3953-3387","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper","key":"pedersenpau","last":"Pedersen","locid":"f321394d-8abe-49b2-ab02-1b528e734f63","name":"Pedersen, Jesper","orcid":"0000-0002-9475-0341","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Martin G.","key":"rasmussenpau","last":"Rasmussen","locid":"8b86a1ef-e6c1-4de3-8300-e30d144bbf60","name":"Rasmussen, Martin Gillies Banke","name_org":"Rasmussen, Martin G.","orcid":"0000-0002-2114-2185","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter L.","key":"kristensenpau","last":"Kristensen","locid":"751d26de-66d4-4ef9-8183-880c48c96dc7","name":"Kristensen, Peter Lund","name_org":"Kristensen, Peter L.","orcid":"0000-0002-5666-9614","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders","key":"grøntvedpau","last":"Grøntved","locid":"393b1ca1-e658-437c-9ca3-73aea925ad58","name":"Grøntved, Anders","orcid":"0000-0003-1584-679X","rank":5,"rolecode":"pau"}],"pmid":["34727972"],"pub":{"doi":"10.1186/s13104-021-05820-4","issn":["17560500"],"journal":"BMC Research Notes","paperid":"406","publisher":"BioMed Central","status":"p","title":"BMC Research Notes","volume":"14"},"review":"Peer Reviewed","scoID":["2-s2.0-85118687078"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-9cba593f-3660-4168-a7e4-4a30013da3aa"],"src":["SDU University of Southern Denmark"],"title":"Feasibility of home-based sampling of salivary cortisol and cortisone in healthy adults","typ