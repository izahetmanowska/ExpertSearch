":"2","first":"Christian","key":"gluudchristianpau","last":"Gluud","name":"Gluud, Christian","rank":43,"rolecode":"pau"},{"affno":"1","first":"Theis","key":"langetheispau","last":"Lange","locid":"e4664578-01fc-4a93-8efd-1dbffb72cdd6","name":"Lange, Theis","orcid":"0000-0001-6807-8347","rank":44,"rolecode":"pau"},{"affno":"1","first":"Anders","key":"perneranderspau","last":"Perner","locid":"8a389541-d529-4ee3-8364-66bfc85f77c9","name":"Perner, Anders","rank":45,"rolecode":"pau"}],"pmid":["33583034"],"pub":{"doi":"10.1111/aas.13795","issn":["00015172"],"issue":"6","journal":"Acta Anaesthesiologica Scandinavica","pages":"834-845","publisher":"Blackwell Munksgaard","status":"p","title":"Acta Anaesthesiologica Scandinavica","volume":"65"},"review":"Peer Reviewed","scoID":["2-s2.0-85102303150"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Other Hospitals","Region Zealand","Region of Southern Denmark","Undetermined","Universities","University of Copenhagen","University of Southern Denmark","collaboration for research in intensive care"],"PST":["Published"]},"sid":["aau-f56079a6-1144-4e96-bb6d-3599f9a58410","ku-b8b71a97-1402-430c-86af-fe4f5cd0dab7","sdu-72a194ea-dfaf-4c09-8dfc-b4b78502a241"],"src":["AAU Aalborg University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Higher vs lower doses of dexamethasone in patients with COVID-19 and severe hypoxia (COVID STEROID 2) trial : Protocol and statistical analysis plan","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-091.28-011730","year":"2021","yearsub":"2021"}
{"abstract":"Purpose: The Danish Shoulder Arthroplasty Registry (DSR) is a nationwide database provid-ing data for research and health care monitoring. The aim of this study was to validate the DSR by (1) assessing registration completeness, (2) comparing key variables with information from medical records, (3) assessing the number and proportion of missing data for key variables. Materials and Methods: The completeness of registration in the DSR from 2006–2015 was assessed for primary arthroplasties by comparing the number of arthroplasties reported to the DSR with the number of arthroplasties recorded by the Danish National Patient Register which is an administrative database used by the Danish healthcare authorities to monitor all hospitalizations including shoulder arthroplasty surgery. Positive predictive values (PPV) were used to estimate the accuracy of the reporting in a randomly selected population. Information retrieved from medical records were used as gold standard. The number of missing values for each variable was evaluated to depict if these registrations were missing at random. Results: The completeness of reporting was 94.4. The PPV for the three major indications: osteoarthritis, fracture and rotator cuff arthropathy was 92%, 97%, and 94%, respectively. PPV was high for resurfacing arthroplasty (93%) and reverse shoulder arthroplasty (93%), but low for total shoulder arthroplasty (79%) and hemiarthroplasty (83%). The proportion of missing data in DSR was less than 1% for age, gender, previous surgery, indication and arthroplasty type and these can be regarded as missing at random. Conclusion: The study showed that data from the DSR are sufficiently valid to be used for research and quality monitoring. Lower PPV’s for total shoulder arthroplasty and hemiar-throplasty are possibly related to inadequate definitions and mutually nonexclusive items in the reporting form. Regular validation is necessary since the data reported to the registry continuously evolve because of changes in clinical practice.","author_count":4,"contributors":["Rasmussen, Jeppe Vejlgaard","El-Galaly, Anders","Thillemann, Theis Muncholm","Jensen, Steen Lund"],"cuid":["S03-097.61-000819"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":3,"corresponding_author":["Rasmussen, Jeppe Vejlgaard","Rasnnussen, Jeppe Vejlgaard"],"keyword":["Accuracy","Arthroplasty","Completeness","Positive predictive value","Registry","Shoulder"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-HO-CDR","DI-U-AAU","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"high completeness and accurate reporting of key variables make data from the danish shoulder arthroplasty registry a valuable source of information","src":["aau","au","ku"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.2147/CLEP.S291972","version":"Published Version"},"id":"S03-097.61-000819","identifier":[{"id":"000629497700001","type":"wos"},{"id":"PMC7910149","type":"pmcid"},{"id":"33654435","type":"pmid"},{"id":"85102194517","type":"scopus"}],"ids":["aau-0fe143f5-bbac-46ac-a474-895d83083f56","au-756295b8-dad3-4b65-92e5-6aae1ecebf2b","ku-50c05b7c-db54-41a0-91ec-9b10170e735e"],"keyword":["Accuracy","Arthroplasty","Completeness","Positive predictive value","Registry","Shoulder"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-9F356FBE092669975E90E9735E3558D8"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://curis.ku.dk/ws/files/259053386/clep_291972_high_completeness_and_accurate_reporting_of_key_variables_ma.pdf","version":"Published Version"},{"access":"oa","license"