t":"Brøchner","name":"Brøchner, Anne C.","rank":28,"rolecode":"pau"}],"pmid":["39749940"],"pub":{"doi":"10.1111/aas.14571","issn":["00015172"],"issue":"2","journal":"Acta Anaesthesiologica Scandinavica","paperid":"e14571","publisher":"Blackwell Munksgaard","status":"p","title":"Acta Anaesthesiologica Scandinavica","volume":"69"},"review":"Peer Reviewed","scoID":["2-s2.0-85214083314"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Region Zealand","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-a02894a7-caca-4762-84a4-805e881258a5","au-e061b348-927a-4073-817b-76be9824677d"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Invasive mechanical ventilation strategies, adjuvants treatments and adverse events among ICU patients with COVID-19 in Denmark","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-792978","year":"2025","yearsub":"2025"}
{"abstract":"OBJECTIVES: Compare home health care (HHC) with self-governing and conventional team structure regarding self-reported low back pain (LBP) and work-related factors. METHODS: A natural experiment was assessed using a cross-sectional design. Primary outcome was LBP intensity; secondary outcomes included LBP duration and work limitations as well as intensity, duration and work limitations of neck/shoulder pain, stress, productivity, influence at work, meaning at work, sickness absence, interpersonal collaboration, and variation in physical behaviour. Home health care (HHC) workers in the self-governing teams were surveyed about their appraisal of the self-governing structure. Data were collected through a questionnaire, except for physical behaviour, which was obtained via accelerometry. Differences between groups were analyzed using t-tests. RESULTS: From 10 HHC-teams across four municipalities, 125 HHC-workers completed the questionnaire (self-governing n = 60; conventional n = 65). LBP intensity was similar among HHC-workers in the two team structures (self-governing = 4.1; conventional = 4.0, 0-10 scale). Self-governing teams experienced significantly higher levels of (i) meaning at work (5.8 points, 0-100 scale), (ii) improved collaboration with manager (7.5 points, 0-100 scale) and (iii) improved collaboration with needs assessors (11.9 points, 0-100 scale) compared to conventional teams. No significant differences were found in the other outcomes. CONCLUSIONS: The higher scores for self-governing teams in meaning at work, collaboration with manager and collaboration with needs assessors are positive. The lack of a lower report in LBP and neck/shoulder pain calls for more focused efforts to enhance HHC-workers' health in addition to the reorganization into the self-governing structure.","author_count":4,"contributors":["Schmidt, Kathrine Greby","Downs Tuck, Laura Grace","Nielsen, Anders Bruun","Rasmussen, Charlotte Diana Nørregaard"],"cuid":["S02-100.00-804598"],"filters":{"added":"2025-06","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"corresponding_author":["Schmidt, Kathrine Greby"],"keyword":["Adult","Cross Sectional Studies","Efficiency","Female","Hjemmepleje","Home Health Aides psychology","Home health care","Humans","LBP","Low Back Pain epidemiology","Male","Middle Aged","Muskelskeletbesvær","Natural experiment","Neck Pain epidemiology","Occupational Diseases epidemiology","Self governing teams","Shoulder Pain epidemiology","Sick Leave statistics numerical data","Sosu","Surveys and Questionnaires"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-WORK"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-GV-WORK","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"low back pain and work related factors among home health care workers with self governing or conventional team structure a natural experiment with a cross sectional design","src":["nfa","sdu"],"src-code":["DI-GV-WORK","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s00420-025-02134-x","version":"Published Version"},"id":"S02-100.00-804598","identifier":[{"id":"40095088","type":"pmid"},{"id":"PMC11972207","type":"pmcid"},{"id":"105000437386","type":"scopus"}],"ids":["nfa-68470ede-eb61-4f0f-8eee-7f6b1f6a4971","sdu-16c85e1b-e3bb-4bee-acd5-ecafb3b9174f"],"keyword":["Adult","Cross-Sectional Studies","Efficiency","Female","Hjemmepleje","Home Health Aides/psychology","Home health care","Humans","LBP","Low Back Pain/epidemiology","Male","Middle Aged","Muskelskeletbesvær","Natural experiment","Neck Pain/epidemiology","Occupational Diseases/epidemiology","Self-governing teams","Shoulder Pain/epidemiology","Sick Leave/statistics & numerical data","Sosu","Surveys and Questionnaires"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-76BB1DA9749896FF6B9D0AEFF48FEF46"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s00420-025-02134-x","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/288869288/s00420-025-02134-x_1_.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"nfa national research centre for the working environment","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-WORK","l3nn":"NFA National Research Centre for the Working Environment","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"NFA National Research Centre for the Working Environment","namevar":["The National Research Centre for the Working Environment","The National Research Centre for the Working Environment, Directors, Musculoskeletal Disorders and Physical Workload"],"nora_code":"DI-GV-WORK","used":1},{"affno":"2","country":"dk","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["University of Southern Denmark"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Kathrine Greby","key":"schmidtpau","last":"Schmidt","locid":"fe5a3b12-fb63-489c-845f-6c39c5e3d62f","name":"Schmidt, Kathrine Greby","orcid":"0000-0001-8400-8349","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Laura Grace","key":"downstuckpau","last":"Downs Tuck","name":"Downs Tuck, Laura Grace","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders Bruun","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Anders Bruun","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Charlotte Diana Nørregaard","key":"rasmussenpau","last":"Rasmussen","locid":"180d2a5d-fe8e-4956-b192-48aed7083301","name":"Rasmussen, Charlotte Diana Nørregaard","orcid":"0000-0002-1769-717X","rank":4,"rolecode":"pau"}],"pmid":["40095088"],"pub":{"doi":"10.1007/s00420-025-02134-x","issn":["03400131","14315777"],"issn_org":["03400131"],"issue":"3","journal":"International Archives of Occupational and Environmental Health","pages":"331-341","publisher":"Springer Science+Business Media","status":"p","title":"International Archives of Occupational and Environmental Health","volume":"98"},"review":"Peer Reviewed","scoID":["2-s2.0-105000437386"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["nfa-68470ede-eb61-4f0f-8eee-7f6b1f6a4971","sdu-16c85e1b-e3bb-4bee-acd5-ecafb3b9174f"],"src":["NFA National Research Centre for the Working Environment","SDU University of Southern Denmark"],"title":"Low back pain and work-related factors among home health care workers with self-governing or conventional team structure - a natural experiment with a cross-sectional design","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-804598","year":"2025","yearsub":"2025"}
{"abstract":"Introduction Alcohol use disorder (AUD) is a massive burden for the individual, relatives and society. Despite this, the treatment gap is wide compared with other mental health disorders. Treatment options are sparse, with only three Food and Drug Administration (FDA)-approved pharmacotherapies. Glucagon-like peptide-1 (GLP-1) receptor agonists have shown promising effects in reducing alcohol consumption in preclinical experiments, and clinical trials are in high demand to investigate these potentially beneficial effects in patients diagnosed with AUD. Methods and analysis The effects of the once-weekly GLP-1 receptor agonist semaglutide will be investigated in a 26-week, randomised, placebo-controlled, double-blinded clinical trial. 108 patients diagnosed with AUD and comorbid obesity (body mass index (BMI)≥30 kg/m 2)) will be randomised to treatment with either semaglutide or placebo in combination with cognitive behavioural therapy. A subgroup of the patients will have structural, functional and neurochemical brain imaging performed at baseline and after 26 weeks of treatment. The primary endpoint is the reduction in heavy drinking days, defined as days with excess consumption of 48/60 g of alcohol per day (women and men, respectively). Secondary endpoints include changes from baseline to week 26 in alcohol consumption, smoking status, quality of life, fibrosis-4 score, plasma concentration of phosphatidylethanol, brain gamma-aminobutyric acid (GABA) levels, alcohol cue reactivity, functional connectivity and white matter tract integrity. Status Recruitment started in June 2023. Ethics and dissemination The study is approved by the Ethics Committee of the Capital Region of Denmark, the Danish Board of Health and the Danish Data Protection Agency. All patients will sign the written consent form before being included in the trial. Results will be disseminated through peer-reviewed publications and conference presentations. After the results are published, all de-identified data will be available in the Mendeley database. Trial registration number NCT05895643.","author_count":15,"contributors":["Klausen, Mette Kruse","Kuzey, Tugba","Pedersen, Julie Niemann","Justesen, Signe Keller","Rasmussen, Line","Knorr, Ulla","Mason, Graeme","Ekstrøm, Claus Thorn","Holst, Jens Juul","Koob, George","Benveniste, Helene","Volkow, Nora D.","Knudsen, Gitte Moos","Vilsbøll, Tina","Fink-Jensen, Anders"],"cuid":["S01-000.00-790337"],"filters":{"added":"2025-02","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","National Institutes of Health","Yale University"],"keyword":["Clinical trial","Ethanol","Functional magnetic resonance imaging","Patients","Randomised controlled trial","Substance misuse"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"OT":["Steno Diabetes Centre, Gentofte, Denmark."],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"does semaglutide reduce alcohol intake in danish patients with alcohol use disorder and comorbid obesity trial protocol of a randomised double blinded placebo controlled clinical trial the semalco trial","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1136/bmjopen-2024-086454","version":"Published Version"},"id":"S01-000.00-790337","identifier":[{"id":"39779270","type":"pmid"},{"id":"85214849887","type":"scopus"},{"id":"PMC11749217","type":"pmcid"}],"ids":["ku-5a75f326-01dd-4735-90ac-963c615abf54"],"keyword":["Clinical Trial","Ethanol","Functional Magnetic Resonance Imaging","Patients","Randomised Controlled Trial","Substance misuse"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-F123D2228E7C1ECB6ED203A5A970A13D"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1136/bmjopen-2024-086454","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/420885822/e086454.full.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Mental Health Services Glostrup"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Psychiatry"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"us","key":"yale university","loc":["United States","America, North","OECD"],"name":"Yale University","used":1},{"affno":"4","country":"us","key":"national institutes of health","loc":["United States","America, North","OECD"],"name":"National Institutes of Health","used":1},{"affno":"5","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Steno Diabetes Centre, Gentofte, Denmark."],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","first":"Mette Kruse","key":"klausenpau","last":"Klausen","name":"Klausen, Mette Kruse","rank":1,"rolecode":"pau"},{"affno":"1","first":"Tugba","key":"kuzeypau","last":"Kuzey","name":"Kuzey, Tugba","rank":2,"rolecode":"pau"},{"affno":"1","first":"Julie Niemann","key":"pedersenpau","last":"Pedersen","name":"Pedersen, Julie Niemann","rank":3,"rolecode":"pau"},{"affno":"1","first":"Signe Keller","key":"justesenpau","last":"Justesen","name":"Justesen, Signe Keller","rank":4,"rolecode":"pau"},{"affno":"1","first":"Line","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Line","rank":5,"rolecode":"pau"},{"affno":"1 2","first":"Ulla B.","key":"knorrpau","last":"Knorr","locid":"2d26ad94-f204-40b3-8763-9445bf0071f6","name":"Knorr, Ulla","name_org":"Knorr, Ulla B.","rank":6,"rolecode":"pau"},{"affno":"3","first":"Graeme","key":"masonpau","last":"Mason","name":"Mason, Graeme","rank":7,"rolecode":"pau"},{"affno":"2","first":"Claus Thorn","key":"ekstrømpau","last":"Ekstrøm","locid":"561f3c43-6e7c-4749-ade5-ad5feee6a77f","name":"Ekstrøm, Claus Thorn","orcid":"0000-0003-1191-373X","rank":8,"rolecode":"pau"},{"affno":"2","first":"Jens Juul","key":"holstpau","last":"Holst","locid":"864b6401-9024-4773-9bdb-f4d4ca57dcad","name":"Holst, Jens Juul","orcid":"0000-0001-6853-3805","rank":9,"rolecode":"pau"},{"affno":"4","first":"George","key":"koobpau","last":"Koob","name":"Koob, George","rank":10,"rolecode":"pau"},{"affno":"3","first":"Helene","key":"benvenistepau","last":"Benveniste","name":"Benveniste, Helene","rank":11,"rolecode":"pau"},{"affno":"4","first":"Nora D.","key":"volkowpau","last":"Volkow","name":"Volkow, Nora D.","rank":12,"rolecode":"pau"},{"affno":"2","first":"Gitte M.","key":"knudsenpau","last":"Knudsen","locid":"f02aee9e-69cf-491a-9765-ff062f734db8","name":"Knudsen, Gitte Moos","name_org":"Knudsen, Gitte M.","orcid":"0000-0003-1508-6866","rank":13,"rolecode":"pau"},{"affno":"1 5","first":"Tina","key":"vilsbøllpau","last":"Vilsbøll","name":"Vilsbøll, Tina","rank":14,"rolecode":"pau"},{"affno":"1 2","first":"Anders","key":"finkjensenpau","last":"Fink-Jensen","locid":"8ba4e682-1c5c-4989-b27c-a279403cbbeb","name":"Fink-Jensen, Anders","rank":15,"rolecode":"pau"}],"pmid":["39779270"],"pub":{"doi":"10.1136/bmjopen-2024-086454","issn":["20446055"],"issue":"1","journal":"BMJ Open","paperid":"e086454","status":"p","title":"BMJ Open","volume":"15"},"review":"Peer Reviewed","scoID":["2-s2.0-85214849887"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-5a75f326-01dd-4735-90ac-963c615abf54"],"src":["KU University of Copenhagen"],"title":"Does semaglutide reduce alcohol intake in Danish patients with alcohol use disorder and comorbid obesity? Trial protocol of a randomised, double-blinded, placebo-controlled clinical trial (the SEMALCO trial)","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-790337","year":"2025","yearsub":"2025"}
{"abstract":"The idea for this project originated within the Arctic Council’s Protection of the Arctic Marine Environment (PAME) Working Group, where a concern was raised about the disposal of tailings from onshore mining operations onto the seafloor. This led to a broader reflection on the impacts of mining operations on the marine environment. Many Arctic governments support the development of a mineral extraction industry, provided it operates in an environmentally responsible manner and considers socio-economic impacts to local communities. However, the environmental impact of existing and future mining operations is often debated. This report summarizes the results of the multi-year Existing Waste Management Practices and Pollution Control for Marine and Coastal Mining project, developed under the auspices of the Protection of the Arctic Marine Environment (PAME) Working Group.","author_count":12,"contributors":["Mosbech, Anders","Fritt-Rasmussen, Janne","Johansen, Kasper Lambert","Copley, Maureen","Chunyk, Libby","Petrevic, Filip","Marty, Gwen","Blockley, David","Nieminen, Soile","Haugland Strand, Siri Anne","Kjønigsen, Kari","Thurston, Dennis"],"cuid":["S01-000.00-816878"],"filters":{"added":"2025-08","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Europe, Non-EU","Nordic","OECD"],"country":["Greenland","Norway","United States"],"glorg":["All Global Affiliations","Bureau of Ocean Energy Management","Greenland Institute of Natural Resources","Norwegian Environmental Agency"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"arctic mining environmental issues mitigation and pollution control for marine and coastal mining","src":["au"],"src-code":["DI-U-AU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://hdl.handle.net/11374/3355","version":"Published Version"},"id":"S01-000.00-816878","ids":["au-ea058380-1605-4827-9484-ea13d2844894"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-C9F1C440DB6A96D1305BFA8C5F3118FA"],"oa_link":[{"access":"oa","type":"rem","url":"https://hdl.handle.net/11374/3355","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Arctic Research Centre, Arctic Research Centre - Arctic Research Centre, Roskilde","Aarhus University, Technical Sciences, Department of Ecoscience, Department of Ecoscience - Arctic Environment"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"gl","key":"greenland institute of natural resources","loc":["Greenland","Nordic"],"name":"Greenland Institute of Natural Resources","used":1},{"affno":"3","country":"no","key":"norwegian environmental agency","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"Norwegian Environmental Agency","used":1},{"affno":"4","country":"us","key":"bureau of ocean energy management","loc":["United States","America, North","OECD"],"name":"Bureau of Ocean Energy Management","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Anders","key":"mosbechpau","last":"Mosbech","locid":"0d8b3009-ff00-40a7-b738-abfa87e31ccf","name":"Mosbech, Anders","orcid":"0000-0002-7581-7037","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Janne","key":"frittrasmussenpau","last":"Fritt-Rasmussen","locid":"ee0f4272-d879-4350-9617-affc0cc83535","name":"Fritt-Rasmussen, Janne","orcid":"0000-0002-6496-8032","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kasper Lambert","key":"johansenpau","last":"Johansen","locid":"2350f010-0c80-4de7-a007-31e878d76732","name":"Johansen, Kasper Lambert","orcid":"0000-0003-0111-9516","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Maureen","key":"copleypau","last":"Copley","name":"Copley, Maureen","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Libby","key":"chunykpau","last":"Chunyk","name":"Chunyk, Libby","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Filip","key":"petrevicpau","last":"Petrevic","name":"Petrevic, Filip","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Gwen","key":"martypau","last":"Marty","name":"Marty, Gwen","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"David","key":"blockleypau","last":"Blockley","name":"Blockley, David","rank":8,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Soile","key":"nieminenpau","last":"Nieminen","name":"Nieminen, Soile","rank":9,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Siri Anne","key":"hauglandstrandpau","last":"Haugland Strand","name":"Haugland Strand, Siri Anne","rank":10,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Kari","key":"kjønigsenpau","last":"Kjønigsen","name":"Kjønigsen, Kari","rank":11,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Dennis","key":"thurstonpau","last":"Thurston","name":"Thurston, Dennis","rank":12,"rolecode":"pau"}],"pub":{"pages":"42","publisher":"Arctic Council","status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-ea058380-1605-4827-9484-ea13d2844894"],"src":["AU Aarhus University"],"title":"Arctic Mining : Environmental issues, mitigation and pollution control for marine and coastal mining","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-816878","year":"2025","yearsub":"2025"}
{"abstract":"Objective: Somapacitan is a long-acting GH approved for once-weekly treatment of GH deficiency (GHD). This study aims to evaluate the efficacy and tolerability of somapacitan after 3 years of treatment and 2 years after switch from daily GH in children with GHD. Design: Randomized, multi-national, open-labelled, active-controlled parallel-group phase 3 trial, with a 52-week main phase and 3-year safety extension (NCT03811535). Methods: Treatment-naive children with GHD were randomized (2:1) to continuous somapacitan (0.16 mg/kg/week; soma/soma group) or daily GH (Norditropin®; 0.034 mg/kg/day) followed by somapacitan (0.16 mg/kg/week; switch group). Results: Of 200 participants, 188 completed 3 years of treatment. Sustained growth was observed in both groups. At week 156, mean (SD) height velocity (HV) between weeks 104 and 156 was 7.4 (1.5) cm/year in the soma/soma group and 7.8 (1.4) cm/year in the switch group. At week 156, the soma/soma and switch groups had reached a mean (SD) height SD score (HSDS) of -0.95 (0.98) and -1.08 (0.93), respectively, and were approaching the mean mid-parental HSDS of -0.74 (for both groups). Mean total insulin-like growth factor I (IGF-I) SDS during year 3 was similar between groups and within normal range (-2.0 to +2.0). Bioactive IGF-I and bioactive IGF-I to IGF-I ratio were similar between groups. Somapacitan was well tolerated, with low proportions reporting injection-site reactions. Conclusions: Sustained efficacy and tolerability were observed for continuous somapacitan treatment for 3 years, and for 2 years after the switching from daily GH treatment. HSDS in both groups was approaching mean mid-parental HSDS.","author_count":11,"contributors":["Miller, Bradley S.","Blair, Joanne C.","Rasmussen, Michael Højby","Frystyk, Jan","Lemminger, Anders Krogh","Maniatis, Aristides","Mori, Jun","Böttcher, Volker","Kim, Ho Seong","Polak, Michel","Horikawa, Reiko"],"cuid":["S01-000.00-821404"],"filters":{"added":"2025-08","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Asia, East","Europe, EU","Europe, Non-EU","OECD"],"corresponding_author":["Miller, Bradley S."],"country":["France","Japan","South Korea","United Kingdom","United States"],"glorg":["Alder Hey Children's NHS Foundation Trust","All Global Affiliations","National Center for Child Health and Development","Necker Enfants Malades Hospital","Osaka City General Hospital","Rocky Mountain Pediatric Endocrinology","Severance Hospital","University of Minnesota"],"keyword":["Growth hormone","Growth hormone deficiency","Growth hormone replacement therapy","long acting growth hormone","somapacitan"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-PR","DI-U"],"level3":{"OT":["MVZ Endokrinologikum Frankfurt am Main"],"PR":["DI-PR-ALL","DI-PR-NOVO"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-PR-NOVO","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"efficacy safety and insulin like growth factor i of weekly somapacitan in children with growth hormone deficiency 000000000003 year results from real000000000004","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1093/ejendo/lvaf096","version":"Published Version"},"id":"S01-000.00-821404","identifier":[{"id":"105005777910","type":"scopus"},{"id":"40400262","type":"pmid"}],"ids":["sdu-7da345ae-7ae6-4a2d-ae9f-ca2b6868aab6"],"keyword":["growth hormone","growth hormone deficiency","growth hormone replacement therapy","long-acting growth hormone","somapacitan"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-7BDB28CFCAEAA0C7D36FB93A5EDCC7CC"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/291083251/lvaf096.pdf","version":"Published Version"},{"access":"oa","license":"C