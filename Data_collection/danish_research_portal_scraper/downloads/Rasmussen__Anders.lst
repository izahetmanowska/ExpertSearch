n Energy"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"R.","key":"gerrúpau","last":"Gerrú","locid":"ffc17642-8855-475c-8901-2fe42df5812a","name":"Gerru, R.","name_org":"Gerrú, R.","orcid":"0000-0002-1884-4354","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"M.","key":"wiesenbergerpau","last":"Wiesenberger","locid":"8c5c1c55-1300-4a61-8eb1-1e0a49eabe9e","name":"Wiesenberger, M.","orcid":"0000-0002-5921-0163","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"A. H.","key":"nielsenpau","last":"Nielsen","locid":"1d9aa958-9d84-4a3b-8300-f6fe9b0be73e","name":"Nielsen, Anders Henry","name_org":"Nielsen, A. H.","orcid":"0000-0003-3642-3905","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"V.","key":"naulinpau","last":"Naulin","locid":"68cb67c0-c64d-4fef-a301-67ab58d8ace6","name":"Naulin, Volker","name_org":"Naulin, V.","orcid":"0000-0001-5452-9215","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"J. Juul","key":"rasmussenpau","last":"Rasmussen","locid":"125b9658-f84c-4e0e-859e-5899413288ee","name":"Rasmussen, Jens Juul","name_org":"Rasmussen, J. Juul","orcid":"0000-0002-3543-690X","rank":5,"rolecode":"pau"}],"pub":{"eisbn":["9781713837046"],"pages":"912-915","publisher":"European Physical Society (EPS)","status":"p","title":"47th EPS Conference on Plasma Physics, EPS 2021"},"review":"Peer Reviewed","scoID":["2-s2.0-85119700080"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-46294996-9d12-4fb2-8bcb-98edeb6f2e14"],"src":["DTU Technical University of Denmark"],"title":"Vorticity equation in full-F electromagnetic gyrofluid model and currents’ role in E × B and diamagnetic momentum","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-325452","year":"2021","yearsub":"2021"}
{"abstract":"Dynamic tomography has become an important technique to study fluid flow processes in porous media. The use of laboratory X-ray tomography instruments is, however, limited by their low X-ray brilliance. The prolonged exposure times, in turn, greatly limit temporal resolution. We have developed a tomographic reconstruction algorithm that maintains high image quality, despite reducing the exposure time and the number of projections significantly. Our approach, based on the Simultaneous Iterative Reconstruction Technique, mitigates the problem of few and noisy exposures by utilising a high-quality scan of the system before the dynamic process is started. We use the high-quality scan to initialise the first time step of the dynamic reconstruction. We further constrain regions of the dynamic reconstruction with a segmentation of the static system. We test the performance of the algorithm by reconstructing the dynamics of fluid separation in a multiphase system. The algorithm is compared quantitatively and qualitatively with several other reconstruction algorithms and we show that it can maintain high image quality using only a fraction of the normally required number of projections and with a substantially larger noise level. By robustly allowing fewer projections and shorter exposure, our algorithm enables the study of faster flow processes using laboratory tomography instrumentation but it can also be used to improve the reconstruction quality of dynamic synchrotron experiments.","author_count":5,"contributors":["Rasmussen, Peter Winkel","Sørensen, Henning Osholm","Bruns, Stefan","Dahl, Anders Bjorholm","Christensen, Anders Nymark"],"cuid":["S01-000.00-372644"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"corresponding_author":["Rasmussen, Peter Winkel"],"country":["Germany"],"glorg":["All Global Affiliations","Helmholtz-Zentrum Hereon"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"improved dynamic imaging of multiphase flow by constrained tomographic reconstruction","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1038/s41598-021-91776-1","version":"Published Version"},"funding_acknowledgement":["We would like to thank the Danish Hydrocarbon Research and Technology Centre for financial support and the Danish Agency for Science, Technology, and Innovation for funding the instrument center DanScatt. We thank the Japan Synchrotron Radiation Research Institute for the allotment of beam time on beamline BL47XU of SPring-8 (Proposal 2016A1459) and N. Bovet and D. Müter for assisting at the experiment. We are grateful to P. C. Hansen for discussions related to the NCP stopping rule. We also thank the Center for Quantification of Imaging Data from MAX IV (QIM) funded by the Capital Region of Denmark."],"id":"S01-000.00-372644","identifier":[{"id":"PMC8203785","type":"pmcid"},{"id":"34127711","type":"pmid"},{"id":"85107927023","type":"scopus"}],"ids":["dtu-e3bb1e5b-647b-4716-b9bb-8475d344b517"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-9A36A2B20E5729BE5CAEFD22DBC7B7B6"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1038/s41598-021-91776-1","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/258688374/616c000f52c95a86c239fb8e.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Applied Mathematics and Computer Science","Technical University of Denmark, Department of Applied Mathematics and Computer Science, Visual Computing"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"de","key":"helmholtz zentrum hereon","loc":["Germany","Europe, EU","OECD"],"name":"Helmholtz-Zentrum Hereon","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Peter Winkel","key":"rasmussenpau","last":"Rasmussen","locid":"89913c01-b575-4d5d-b4b6-8da181afb384","name":"Rasmussen, Peter Winkel","orcid":"0000-0002-0823-0316","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henning Osholm","key":"sørensenpau","last":"Sørensen","locid":"04ff82b1-ff20-4053-bfbc-a0909cdb5430","name":"Sørensen, Henning Osholm","orcid":"0000-0002-7004-547X","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Stefan","key":"brunspau","last":"Bruns","name":"Bruns, Stefan","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anders Bjorholm","key":"dahlpau","last":"Dahl","locid":"c2bad3c8-b172-481b-bb99-d3c2bc4004ef","name":"Dahl, Anders Bjorholm","orcid":"0000-0002-0068-8170","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anders Nymark","key":"christensenpau","last":"Christensen","locid":"ad9ef4bc-d943-459d-b52f-a11c61a9ab0d","name":"Christensen, Anders Nymark","orcid":"0000-0002-3668-3128","rank":5,"rolecode":"pau"}],"pmid":["34127711"],"pub":{"doi":"10.1038/s41598-021-91776-1","issn":["20452322"],"issue":"1","journal":"Scientific Reports","paperid":"12501","publisher":"Nature Publishing Group","status":"p","title":"Scientific Reports","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-85107927023"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Te