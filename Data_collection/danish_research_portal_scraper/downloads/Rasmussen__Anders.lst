lecode":"pau"},{"affno":"","corresponding":null,"first":"E","key":"bramonpau","last":"Bramon","name":"Bramon, E","rank":49,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"E","key":"vassospau","last":"Vassos","name":"Vassos, E","rank":50,"rolecode":"pau"}],"pmid":["20048749"],"pub":{"doi":"10.1038/mp.2009.149","issn":["13594184","14765578"],"issn_org":["13594184"],"issue":"1","journal":"Molecular Psychiatry","pages":"59-66","publisher":"Springer Nature","status":"p","title":"Molecular Psychiatry","volume":"16"},"review":"Peer Reviewed","scoID":["2-s2.0-84947649726"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-c0b388f9-9f83-42c4-ace6-fc1471cc05e4","ku-5c45b73e-fa34-444c-8d3b-f8ed9f670ae4"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Expanding the range of ZNF804A variants conferring risk of psychosis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-092.38-026658","year":"2011","yearsub":2011}
{"abstract":"Mutation in the p53 gene based on single amino acid substitutions is a frequent event in human cancer. Accumulated mutant p53 protein is released to antigen presenting cells of the immune system and anti-p53 immune responses even against wt p53 is induced and observed in a number of human cancer patients. Detection of antibodies against wt p53 protein has been used as a diagnostic and prognostic marker and discovery of new T-cell epitopes has enabled design of cancer vaccination protocols with promising results. Here, we identified wt p53-specific antibodies in various cancer patients and identified a broad range of responses against wt p53 protein and 15-mer peptides using a novel print array technology. Likewise, using bioinformatic tools in silico, we identified CD8 T-cell specificity or reactivity against HLA-A*02:01 binding peptides wt p53(65-73), wt p53(187-197), and wt p53(264-272) in breast cancer patients and against HLA-A*01:01 binding peptide wt p53(226-234) and HLA-B*07:02 binding peptide wt p53(74-82) in renal cell cancer and breast cancer patients, respectively. Finally, we analyzed antibody and T-cell responses against wt p53 15-mer peptides in patients with metastatic renal cell carcinoma who were alive with no evidence of disease after a follow-up period of minimum 5 years after treatment with IL-2 ± IFN-α ± histamine containing immunotherapy to identify novel epitopes for use in immunotherapy and for potential response biomarkers. However, none of the wt p53 reactivity observed justified use of 15-mer or was related to survival in this rare patient population.","author_count":13,"contributors":["Pedersen, Anders Elm","Stryhn, Anette","Justesen, Sune","Harndahl, Mikkel","Rasmussen, Susanne","Donskov, Frede","Claesson, Mogens H","Pedersen, Johannes W","Wandall, Hans H","Svane, Inge Marie","Buus, Søren"],"cuid":["S02-099.90-017608"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"keyword":["Amino Acid Sequence","Antibodies","Antineoplastic Combined Chemotherapy Protocols","Biomarkers Pharmacological","Breast Neoplasms","CD8 Positive T Lymphocytes","Cancer Vaccines","Carcinoma","Cell Line Tumor","Epitope Mapping","Epitopes T Lymphocyte","Female","HLA A Antigens","Humans","Kidney Neoplasms","Molecular Sequence Data","Mutation","Neoplasm Metastasis","Peptide Fragments","Prognosis","Tumor Suppressor Protein p53"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"wildtype p000000000053 specific antibody and t cell responses in cancer patients","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1097/CJI.0b013e3182281381","version":"Other Version"},"id":"S02-099.90-017608","identifier":[{"id":"21989411","type":"pmid"},{"id":"80055006331","type":"scopus"}],"ids":["au-44021980-26e3-4610-9e17-dc64e3174c24","ku-7c07aac5-ec45-4603-b883-2b4ee10ba4de"],"keyword":["Amino Acid Sequence","Antibodies","Antineoplastic Combined Chemotherapy Protocols","Biomarkers, Pharmacological","Breast Neoplasms","CD8-Positive T-Lymphocytes","Cancer Vaccines","Carcinoma","Cell Line, Tumor","Epitope Mapping","Epitopes, T-Lymphocyte","Female","HLA-A Antigens","Humans","Immunotherapy, Active","Kidney Neoplasms","Molecular Sequence Data","Mutation","Neoplasm Metastasis","Peptide Fragments","Prognosis","Tumor Suppressor Protein p53"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-0A93BB1F657B733E18252AB9D212D996"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1097/CJI.0b013e3182281381","version":"Other Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"U