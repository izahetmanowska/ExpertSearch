ebastian","rank":20,"rolecode":"pau"},{"affno":"2 8","first":"Rikke Malene H.g.","key":"jepsenrikkemalenehgpau","last":"Jepsen","locid":"4ad4916b-991b-47d0-a49e-7554270f5a6f","name":"Jepsen, Rikke Malene H. G.","name_org":"Jepsen, Rikke Malene H.g.","rank":21,"rolecode":"pau"},{"affno":"9 10","corresponding":null,"first":"Tobias","key":"kurthtobiaspau","last":"Kurth","name":"Kurth, Tobias","rank":22,"rolecode":"pau"},{"affno":"11 12","corresponding":null,"first":"Michael","key":"donninomichaelpau","last":"Donnino","name":"Donnino, Michael","rank":23,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Hans","key":"kirkegaardhanspau","last":"Kirkegaard","locid":"911be177-8ade-45ff-93ef-6f631e537119","name":"Kirkegaard, Hans","rank":24,"rolecode":"pau"},{"affno":"1 7","corresponding":null,"country":"dk","first":"Asger","key":"granfeldtasgerpau","last":"Granfeldt","locid":"e7d1ea85-4e47-46da-acaa-a557deb14511","name":"Granfeldt, Asger","rank":25,"rolecode":"pau"}],"pmid":["34223347"],"pub":{"doi":"10.1016/j.resplu.2021.100081","issn":["26665204"],"journal":"Resuscitation Plus","paperid":"100081","publisher":"Elsevier","status":"p","title":"Resuscitation Plus","title_org":"Resuscitation plus","volume":"5"},"review":"Peer Reviewed","scoID":["2-s2.0-85122530256"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Hospitals","Other Research","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark","prehospital emergency medical services"],"PST":["Published"]},"sid":["aau-86448937-49fb-43b8-82c6-560ebe01666d","au-eb157390-7fd5-44a5-bdc3-7692f3f9c74b","ku-cf2dec7d-ccf2-490a-9be4-f2fbd94b43cb","sdu-cf28a07b-17d4-47e7-99e5-6806f01bdaea"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Vasopressin and methylprednisolone for in-hospital cardiac arrest - Protocol for a randomized, double-blind, placebo-controlled trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-099.22-006490","year":"2021","yearsub":"2021"}
{"abstract":"Background and purpose — The incidence of knee replacements (KRs) has increased in the past decades. Previous studies have forecast a continuous and almost exponential rise in the use of KRs, but this rise must cease at some point. We estimated when and at what incidence the use of KRs will plateau in Denmark. Patients and methods — We retrieved 138,223 primary KRs conducted from 1997 to 2019 from the Danish Knee Arthroplasty Registry. Censuses from 1997 to 2019 as well as population projections from 2020 through 2050 were collected from Statistics Denmark. We applied logistic and Gompertz regression analysis to the data to estimate the future incidence until 2050 with root mean squared error (RMSE) as a quantitative measurement of the models’ fit. Results — The Danish incidence of KRs from 1997 to 2009 increased by more than 300%, but has stalled since 2009. Logistic and Gompertz regression had an RMSE of 14 and 15 indicating that these models fitted the data well. Logistic and Gompertz regressions estimated that the maximum incidence will be reached in 2030 at 250 (95% prediction interval [PI]) 159–316) KRs per 105 or in 2035 at 260 (PI 182–336) KRs per 105, respectively. Interpretation — The Danish incidence of KRs seems set to plateau within the coming decades. Countries experiencing a current exponential rise at a lower incidence may benefit from this study’s projection when forecasting their future demand for KRs.","author_count":5,"contributors":["Daugberg, Louise","Jakobsen, Thomas","Nielsen, Poul Torben","Rasmussen, Mathias Bæk","El-Galaly, Anders"],"cuid":["S01-000.00-067088"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Daugberg, Louise"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"a proj