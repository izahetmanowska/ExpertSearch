,"locid":"32aaf9c5-5cf0-4e7b-86d8-a534fa4a9ae9","name":"Grønbæk, Henning","orcid":"0000-0001-8998-7910","rank":19,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Stephen","key":"hamiltonstephenpau","last":"Hamilton","name":"Hamilton, Stephen","rank":19,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Gerda Elisabeth","key":"villadsengerdaelisabethpau","last":"Villadsen","locid":"6e593826-d87d-47db-8aa1-92e03dc390a9","name":"Villadsen, Gerda Elisabeth","rank":20,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Mette","key":"kjærmettepau","last":"Kjær","name":"Kjær, Mette","rank":20,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Gerda","key":"villadsengerdapau","last":"Villadsen","name":"Villadsen, Gerda","rank":22,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Anders Kindberg","key":"boysenanderskindbergpau","last":"Boysen","locid":"304f79e0-6a7b-48a3-bbef-db956a9a25bb","name":"Boysen, Anders Kindberg","rank":23,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Annika","key":"loftannikapau","last":"Loft","name":"Loft, Annika","rank":23,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Lotte","key":"schultzlottepau","last":"Schultz","name":"Schultz, Lotte","rank":24,"rolecode":"pau"}],"pub":{"pages":"72","repno":"Kliniske Retningslinjer/Kræft","series":"Kliniske Retningslinjer/Kræft","status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-33bb68aa-6cfd-4b21-8ffa-6f6cd6b84aaf","au-3d6961b3-6c99-4a26-bda5-8af2fda6d50e"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Udredning og behandling af Cholan