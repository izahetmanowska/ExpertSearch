{"abstract":"Anders Juhl Rasmussen interviews Dr Rishi Goyal, Director of Medicine, Literature and Society and Associate Professor of Medicine at Columbia University Medical Centre, and an attending physician in the Emergency Department at Columbia University. Goyal is currently a Visiting Professor at the University of Southern Denmark in Odense, and Rasmussen gives some observations from a recent teaching session at Odense University Hospital before interviewing Goyal on the subject of narrative medicine.","author_count":1,"contributors":["Rasmussen, Anders Juhl"],"cuid":["S01-000.00-604477"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"what does it mean to listen and how can it be learned","src":["sdu"],"src-code":["DI-U-SDU"],"type":"doi","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://blogs.bmj.com/medical-humanities/2017/04/04/long-read-what-does-it-mean-to-listen-and-how-can-it-be-learned/","version":"Authors Final Version"},"id":"S01-000.00-604477","ids":["sdu-6d64fede-662a-438d-b047-4cceb7b49b2c"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-69D94F8F916FA7D9F4C90F8774F051A6"],"oa_link":[{"access":"oa","type":"rem","url":"http://blogs.bmj.com/medical-humanities/2017/04/04/long-read-what-does-it-mean-to-listen-and-how-can-it-be-learned/","version":"Authors Final Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Humanities, Department for the Study of Culture","SDU, Faculty of Humanities, Department of Culture and Language, Cultural Studies","SDU, Faculty of Humanities, Department of Culture and Language, Uses of Literature"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anders Juhl","key":"rasmussenpau","last":"Rasmussen","locid":"6612df8e-d9f9-4004-b959-a9c30b0762a5","name":"Rasmussen, Anders Juhl","orcid":"0000-0001-7718-5208","rank":1,"rolecode":"pau"}],"pub":{"status":"X"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Undefined"]},"sid":["sdu-6d64fede-662a-438d-b047-4cceb7b49b2c"],"src":["SDU University of Southern Denmark"],"title":"What does it mean to listen, and how can it be learned?","type":"Other-Internet Publication","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-604477","year":"2017","yearsub":"2017"}
