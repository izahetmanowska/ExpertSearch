b2-ab02-1b528e734f63","name":"Pedersen, Jesper","orcid":"0000-0002-9475-0341","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders","key":"grøntvedpau","last":"Grøntved","locid":"393b1ca1-e658-437c-9ca3-73aea925ad58","name":"Grøntved, Anders","orcid":"0000-0003-1584-679X","rank":7,"rolecode":"pau"}],"pmid":["32397984"],"pub":{"doi":"10.1186/s12889-020-08810-6","issn":["14712458"],"issue":"664","journal":"BMC Public Health","pages":"1-12","publisher":"BioMed Central","status":"p","title":"BMC Public Health","volume":"20"},"review":"Peer Reviewed","scoID":["2-s2.0-85084625428"],"search":{"DAF":["All Danish Affiliations","All Universities","All University Colleges","DI-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","UC SYD, University College South Denmark","UCL University College","Universities","University Colleges","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-8c02fa4b-84d2-4c71-9e4f-c5724428c113","ucl-a8c821aa-6548-402b-82c8-f9503b9b76cf","ucsyd-e0b585df-2a8f-48a0-92ba-320fe4d3335a"],"src":["SDU University of Southern Denmark","UC SYD University College South Denmark","UCL University College"],"title":"The development of a questionnaire to assess leisure time screen-based media use and its proximal correlates in children (SCREENS-Q)","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-095.95-049221","year":"2020","yearsub":"2020"}
{"abstract":"BACKGROUND: Microsatellite instability (MSI), resulting from a defective mismatch repair system, occurs in approximately 15% of sporadic colorectal cancers (CRC). Since MSI is associated with a poor response to 5-fluorouracile based chemotherapy and is a positive predictive marker of immunotherapy, it is routine practice to evaluate the MSI status of resected tumors in CRC patients. MSIsensor is a novel computational tool for determining MSI status using Next Generation Sequencing. However, it is not widely used in the clinic and has not been independently validated in exome data from CRC. To facilitate clinical implementation of computational determination of MSI status, we compared MSIsensor to current gold standard methods for MSI testing. METHODS: MSI status was determined for 130 CRC patients (UICC stage I-IV) using immunohistochemistry, PCR based microsatellite stability testing and by applying MSIsensor to exome sequenced tumors and paired germline DNA. Furthermore, we investigated correlation between MSI status, mutational load and mutational signatures. RESULTS: Eighteen out of 130 (13.8%) patients were microsatellite instable. We found a 100% agreement between MSIsensor and gold standard methods for MSI testing. All MSI tumors were hypermutated. In addition, two microsatellite stable (MSS) tumors were hypermutated, which was explained by a dominant POLE signature and pathogenic POLE mutations (p.Pro286Arg and p.Ser459Phe). CONCLUSION: MSIsensor is a robust tool, which can be used to determine MSI status of tumor samples from exome sequenced CRC patients.","author_count":9,"contributors":["Frydendahl, Amanda","Kassentoft, Christine Gaasdal","Knudsen, Michael","Laursen, Maria Bach","Madsen, Anders Husted","Iversen, Lene Hjerrild","Sunesen, Kåre Gotschalck","Rasmussen, Mads Heilskov","Andersen, Claus Lindbjerg"],"cuid":["S01-000.00-268455"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Colorectal cancer","DNA Mismatch Repair","DNA mismatch repair deficiency","Exome sequencing","Immunotherapy","Lynch syndrome","MSI","MSS","Microsatellite Instability","Mutational processes","Performance","Predictor","Signatures","TUMORS"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-HO-CDR","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"validation of computational determination of microsatellite status using whole exome sequencing data from colorectal cancer patients","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12885-019-6227-7","version":"Published Version"},"id":"S01-000.00-268455","identifier":[{"id":"PMC6802299","type":"pmcid"},{"id":"000491487100002","type":"wos"},{"id":"31638937","type":"pmid"},{"id":"85073725074","type":"scopus"}],"ids":["au-f3e93904-c643-44c8-bc69-ad6cd99580a2"],"keyword":["Colorectal cancer","DNA MISMATCH REPAIR","DNA mismatch repair deficiency","Exome sequencing","IMMUNOTHERAPY","INSTABILITY DETECTION","LYNCH-SYNDROME","MSI","MSIsensor","MSS","MUTATIONAL PROCESSES","Microsatellite instability","PERFORMANCE","POLE","POLYMERASE-EPSILON","PREDICTOR","SIGNATURES","TUMORS"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-B6F117CCF4A628DEA6E607851EBB98CE"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12885-019-6227-7","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aar