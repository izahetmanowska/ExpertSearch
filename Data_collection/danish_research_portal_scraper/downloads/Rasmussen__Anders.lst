{"author_count":7,"contributors":["Jensen, Poul Nordemann","Rasmussen, Jes","Baattrup-Pedersen, Annette"],"cuid":["S01-000.00-230757"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"com","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"nr","rtype":["clu"],"sorti":"effekt af vandindvinding på overfladevandsområder og grundvandsafhængig natur","src":["au"],"src-code":["DI-U-AU"],"type":"dra","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://naturstyrelsen.dk/media/180800/videnskabelig-udredning-af-international-viden-om-skifergas-relateret-til-en-dansk-kontekst.pdf","version":"Published Version"},"id":"S01-000.00-230757","ids":["au-b1c1686f-e613-4564-814b-3fff0eadcc3c"],"lang":"Danish","level":"Commissioned","mra":["Science/Technology"],"noi":["Local-1-1-0A795C531CAB74F432EAD66B2A122BF9"],"oa_link":[{"access":"oa","type":"rem","url":"http://naturstyrelsen.dk/media/180800/videnskabelig-udredning-af-international-viden-om-skifergas-relateret-til-en-dansk-kontekst.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, DCE - Danish Centre for Environment and Energy, DCE - Danish Centre for Environment and Energy"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Poul Nordemann","key":"jensenpau","last":"Jensen","locid":"4ec7bd9a-b980-471c-b5de-2ad8f6665452","name":"Jensen, Poul Nordemann","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jes","key":"rasmussenpau","last":"Rasmussen","locid":"1f62ae59-0b9d-4a1e-84c3-25bb14747f25","name":"Rasmussen, Jes","orcid":"0000-0002-5932-3125","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Annette","key":"baattruppedersenpau","last":"Baattrup-Pedersen","locid":"e4f5886d-70a8-4174-a224-b21d0dfc8689","name":"Baattrup-Pedersen, Annette","orcid":"0000-0002-3118-344X","rank":3,"rolecode":"pau"},{"affno":"","first":"Steffen Foss","key":"hansenpedh","last":"Hansen","name":"Hansen, Steffen Foss","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Anders","key":"johansenpedh","last":"Johansen","name":"Johansen, Anders","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Poul Nordemann","key":"jensenpedh","last":"Jensen","name":"Jensen, Poul Nordemann","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Mads H.","key":"odgaardpedh","last":"Odgaard","name":"Odgaard, Mads H.","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"pages":"64","publisher":"DTU","status":"p","title":"Videnskabelig udredning af international viden om skifergas relateret til en dansk kontekst"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-b1c1686f-e613-4564-814b-3fff0eadcc3c"],"src":["AU Aarhus University"],"title":"Effekt af vandindvinding på overfladevandsområder og grundvandsafhængig natur","type":"Report Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-230757","year":"2016","yearsub":"2016"}
{"abstract":"The genome of Mycobacterium tuberculosis (Mtb) of latently infected individuals may hold the key to understanding the processes that lead to reactivation and progression to clinical disease. We report here analysis of pairs of Mtb isolates from putative prolonged latent TB cases. We identified two confirmed cases, and used whole genome sequencing to investigate the mutational processes that occur over decades in latent Mtb. We found an estimated mutation rate between 0.2 and 0.3 over 33 years, suggesting that latent Mtb accumulates mutations at rates similar to observations from cases of active disease.","author_count":7,"contributors":["Lillebaek, Troels","Norman, Anders","Rasmussen, Erik Michael","Marvig, Rasmus Lykke","Bek Folkvardsen, Dorte","Bengaard Andersen, Åse","Jelsbak, Lars"],"cuid":["S01-000.00-315021"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Genome sequencing","Latent infection","Mutation Rate","Pathogen evolution","Within host evolution"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"substantial molecular evolution and mutation rates in prolonged latent i mycobacterium tuberculosis i infection in humans","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/124107978/1_s2.0_S1438422116301102_main.pdf","version":"Authors Final Version"},"id":"S01-000.00-315021","identifier":[{"id":"27296510","type":"pmid"},{"id":"84994831663","type":"scopus"}],"ids":["dtu-231a96a1-0888-4b1a-823d-1e3e2d219022"],"keyword":["Genome sequencing","Latent infection","Mutation rate","Pathogen evolution","Within-host evolution"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-C083D6104EB7B69D7D8EC1BC13A25A1B"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/124107978/1_s2.0_S1438422116301102_main.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","country":"dk","key":"ssi statens serum institut","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-SSI","l3nn":"SSI Statens Serum Institut","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SSI Statens Serum Institut","namevar":["Statens Serum Institut"],"nora_code":"DI-GV-SSI","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Systems Biology","Technical University of Denmark, Department of Systems Biology, Infection Microbiology"],"nora_code":"DI-U-DTU","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Troels","key":"lillebaekpau","last":"Lillebaek","name":"Lillebaek, Troels","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Anders","key":"normanpau","last":"Norman","locid":"01abb082-e735-40c1-ae3b-0cfac5bfe1f4","name":"Norman, Anders","orcid":"0000-0002-1282-394X","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Erik Michael","key":"rasmussenpau","last":"