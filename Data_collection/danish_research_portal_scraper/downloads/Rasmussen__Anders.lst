asmussen, Jens Juul","name_org":"Juul Rasmussen, Jens","orcid":"0000-0002-3543-690X","rank":15,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Anders Henry","key":"nielsenandershenrypau","last":"Nielsen","locid":"1d9aa958-9d84-4a3b-8300-f6fe9b0be73e","name":"Nielsen, Anders Henry","orcid":"0000-0003-3642-3905","rank":16,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Chijin","key":"xiaochijinpau","last":"Xiao","name":"Xiao, Chijin","rank":17,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Xiang","key":"gaoxiangpau","last":"Gao","name":"Gao, Xiang","rank":18,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Liqun","key":"huliqunpau","last":"Hu","name":"Hu, Liqun","rank":19,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sizheng","key":"zhusizhengpau","last":"Zhu","name":"Zhu, Sizheng","rank":20,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Zhenwei","key":"wuzhenweipau","last":"Wu","name":"Wu, Zhenwei","rank":21,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jinping","key":"qianjinpingpau","last":"Qian","name":"Qian, Jinping","rank":22,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Xianzu","key":"gongxianzupau","last":"Gong","name":"Gong, Xianzu","rank":23,"rolecode":"pau"}],"pub":{"doi":"10.1088/1009-0630/13/4/03","issn":["10090630"],"issue":"4","journal":"Plasma Science and Technology","pages":"397-404","publisher":"IOP Publishing","status":"p","title":"Plasma Science and Technology","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-80052700335"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-2890aaad-f216-41f4-8d3d-cf8094826ba9"],"src":["DTU Technical University of Denmark"],"title":"A Dip Structure in the Intrinsic Toroidal Rotation Near the Edge of the Ohmic Plasmas in EAST","type":"Journal Article","url":"https://local.forskning