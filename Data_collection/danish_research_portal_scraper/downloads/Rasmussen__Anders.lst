ocid":"5b08ed69-ad64-469f-a5b3-3407bf3c4b04","name":"Agerbo, Esben","orcid":"0000-0002-2849-524X","rank":23,"rolecode":"pau"},{"affno":"10","corresponding":null,"first":"Cilla","key":"söderhallcillapau","last":"Söderhall","name":"Söderhall, Cilla","rank":24,"rolecode":"pau"},{"affno":"11","corresponding":null,"first":"Matthew C","key":"altmanmatthewcpau","last":"Altman","name":"Altman, Matthew C","rank":25,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anna H.","key":"thysenannahammerichpau","last":"Thysen","locid":"e6276c87-6ec3-4627-9e10-51580ff87bf0","name":"Thysen, Anna Hammerich","name_org":"Thysen, Anna H.","orcid":"0000-0002-2914-1099","rank":26,"rolecode":"pau"},{"affno":"4 12 5","corresponding":null,"first":"Chris G","key":"mckennanchrisgpau","last":"McKennan","name":"McKennan, Chris G","rank":27,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Susanne","key":"brixsusannepau","last":"Brix","locid":"12242cd2-44c7-42a3-b384-79b7d898f7a1","name":"Brix, Susanne","orcid":"0000-0001-8951-6705","rank":28,"rolecode":"pau"},{"affno":"13","corresponding":null,"first":"James E","key":"gernjamesepau","last":"Gern","name":"Gern, James E","rank":29,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"first":"Carole","key":"obercarolepau","last":"Ober","name":"Ober, Carole","rank":30,"rolecode":"pau"},{"affno":"3 14","first":"Tarunveer S.","key":"ahluwaliatarunveersinghpau","last":"Ahluwalia","locid":"38718fb3-d6ba-4c59-a608-83871971c074","name":"Ahluwalia, Tarun Veer Singh","name_org":"Ahluwalia, Tarunveer S.","rank":31,"rolecode":"pau"},{"affno":"15","corresponding":null,"first":"Tarunveer S.","key":"ahluwaliatarunveerspau","last":"Ahluwalia","name":"Ahluwalia, Tarunveer S.","rank":31,"rolecode":"pau"},{"affno":"3 2","first":"Hans","key":"bisgaardhanspau","last":"Bisgaard","locid":"6ee3c769-8284-4a60-a3aa-1282019f8e80","name":"Bisgaard, Hans","orcid":"0000-0003-4131-7592","rank":32,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anders G.","key":"pedersenandersgormpau","last":"Pedersen","locid":"bb3513aa-fb20-46ef-ba14-9c150c929cf1","name":"Pedersen, Anders Gorm","name_org":"Pedersen, Anders G.","orcid":"0000-0001-9650-8965","rank":33,"rolecode":"pau"},{"affno":"3 2","first":"Klaus","key":"bønnelykkeklauspau","last":"Bønnelykke","locid":"c36b6936-2cc4-41b1-b7c5-a97978afe417","name":"Bønnelykke, Klaus","rank":34,"rolecode":"pau"}],"pmid":["35381269"],"pub":{"doi":"10.1016/j.jaci.2022.03.019","issn":["00916749","10858725"],"issn_org":["00916749"],"issue":"3","journal":"Journal of Allergy and Clinical Immunology","pages":"622-630","publisher":"Elsevier Inc.","status":"p","title":"Journal of Allergy and Clinical Immunology","volume":"150"},"review":"Peer Reviewed","scoID":["2-s2.0-85130353932"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Miscellaneous","All Non-Profit Organisations","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-NP","DI-NP-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Miscellaneous","Non-Profit Organisations","Other Research","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-d1aa9a78-15d5-46f8-8089-1e3c7abfeefb","dtu-a6248a89-bf8b-4046-b108-ca93d976195a","ku-19457530-215f-4221-9dfe-dc62d6ef831c"],"src":["AU Aarhus University","DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Genome-wide study of early and severe childhood asthma identifies interaction between <i>CDHR3 </i>and <i>GSDMB</i>","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-087.58-027873","year":"2022","yearsub":"2022"}
{"abstract":"Background: Primary intraventricular hemorrhage (IVH) or IVH secondary to intracerebral (ICH) and subarachnoid hemorrhage (SAH) are known to have a very poor prognosis, with an expected mortality between 50 and 80% (Hinson et al. Current Neurology and Neuroscience Reports 10:73–82, 2010). Clearance of IVH might improve patient outcome. Methods: The study is designed as an investigator-initiated, comparative, prospective, multi-center, 1:1 randomized phase 2 trial evaluating the efficacy and safety of active irrigation in external ventricular drainage (intervention arm—IRRAflow) compared to passive external ventricular drainage (control arm—EVD). The trial will enroll 58 patients with primary or secondary IVH. Major eligibility criteria include age ≥18 years of age, IVH documented on head CT or MRI scan (Graeb score ≥3), need of cerebrospinal fluid drainage, deterioration of consciousness or medical sedation at the time of enrollment, and indication for active treatment evaluated by the treating physicians. Exclusion criteria included patients with fixed and dilated pupils and pregnant or nursing women. The primary endpoint of the study is catheter occlusion evaluated by time to first observed occlusion from VC placement. Secondary endpoints include clearance of ventricular blood as measured by head CT scan, rates of catheter-related infection and shunt dependency, length of intensive care unit stay, functional status—Extended Glascow Outcome Scale (eGOS) and modified Rankin scale (mRS) at discharge to rehabilitation and 90 days—and mortality rates at 30 days and 90 days. Discussion: With no standardized treatment for IVH and a poor prognosis, new treatments are needed. IVH patients often need CSF drainage to treat hydrocephalus and to decrease ICP. Standard treatment with passive external ventricular drainage is related to an increased risk of infections which is found in up to 22% of treated cases. The passive VC is known to have a risk of occlusion and is seen in 19–47% of the cases. We hypothesize that the use of active fluid change using the IRRAflow system will be safe and feasible and will reduce the occlusion and infection rates in patients with IVH. Trial registration: ClicalTrials.gov NCT05204849. Registered 15 December 2021.","author_count":11,"contributors":["Haldrup, Mette","Mohamad, Niwar","Rasmussen, Mads","Thorup, Line","Dyrskog, Stig Eric","Simonsen, Claus Ziegler","Miscov, Rares","Bjarkam, Carsten Reidies","Grønhøj, Mads","Poulsen, Frantz Rom","Korshoej, Anders Rosendal"],"cuid":["S03-098.98-665810"],"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"corresponding_author":["Bjarkam, Carsten Reidies","Haldrup, Mette"],"keyword":["Adolescent","Aspiration","Cerebral Hemorrhage diagnostic imaging","Cerebral Ventricles diagnostic imaging","Clinical Trials Phase II as Topic","Drainage adverse effects","External ventricular drainage","Feasibility Studies","Female","Humans","Hydrocephalus diagnostic imaging","IRRAflow","Intraventricular hemorrhage","Irrigation","Multicenter Studies as Topic","Prospective Studies","Randomized Controlled Trials as Topic","Treatment Outcome"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-U-AAU","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"study protocol for active study safety and feasibility evaluation of external ventricular drainage with active fluid exchange in intraventricular hemorrhage a phase 000000000002 multi center randomized controlled trial","src":["aau","au","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1186/s13063-022-07043-9","version":"Published Version"},"funding_acknowledgement":["The ACTIVE study is funded by Aarhus University, Aarhus University Hospital and IRRAS. The trial protocol was designed by sponsor-investigator Aarhus University Hospital. The funding bodies have peer reviewed the trial protocol but have had no role in the design of the study, analysis, and interpretation of the data nor in the writing of this or future manuscript."],"id":"S03-098.98-665810","identifier":[{"id":"36581996","type":"pmid"},{"id":"85145129335","type":"scopus"},{"id":"PMC9798588","type":"pmcid"}],"ids":["aau-585df232-4e37-43c3-9eb0-1e1c67646121","au-d6e85eb5-2284-41b9-9796-9cb5b25ad7b6","sdu-52457d1c-513a-4b69-b5d4-1d2affbbcab0"],"keyword":["Adolescent","Aspiration","Cerebral Hemorrhage/diagnostic imaging","Cerebral Ventricles/diagnostic imaging","Clinical Trials, Phase II as Topic","Drainage/adverse effects","External ventricular drainage","Feasibility Studies","Female","Humans","Hydrocephalus/diagnostic imaging","IRRAflow","Intraventricular hemorrhage","Irrigation","Multicenter Studies as Topic","Prospective Studies","Randomized Controlled Trials as Topic","Treatment Outcome"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-549F0852C13FD18FC57DF139526EF9DA"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/218276228/s13063_022_07043_9.pdf","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/514418345/Haldrup_et_al._2022_._Study_protocol_for_ACTIVE_study_safety_and_feasibility_evaluation_of_external_ventricular_drainage_with_ACTIVE_fluid_exchange_in_intraventricular_hemorrhage_a_phase_2_multi_center_randomized_control.pdf","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1186/s13063-022-07043-9","version":"Published Version"}],"oai":{"class":"Realised","mra":["Med