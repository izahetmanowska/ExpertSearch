ia","loc":["Australia","Oceania","OECD"],"name":"School of Allied Health, Curtin University, Perth, Australia.","used":1},{"affno":"7","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Unit for Epidemiology, Biostatistics and Biodemography, Department of Public Health, University of Southern Denmark, Odense, Denmark; Department of Clinical Research, University of Southern Denmark, Odense, Denmark; Department of Geriatric Medicine, Odense University Hospital, Odense, Denmark."],"nora_code":"DI-HO-SDR","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Anders Fritz","key":"lerchepau","last":"Lerche","locid":"8ca85f92-8c87-439e-86fc-e2ca9cd5bbcb","name":"Lerche, Anders Fritz","orcid":"0000-0002-3199-6571","rank":1,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Svend Erik","key":"mathiassenpau","last":"Mathiassen","name":"Mathiassen, Svend Erik","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Charlotte Lund","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Charlotte Lund","rank":3,"rolecode":"pau"},{"affno":"5 6","corresponding":null,"first":"Leon","key":"strakerpau","last":"Straker","name":"Straker, Leon","rank":4,"rolecode":"pau"},{"affno":"1 7","corresponding":null,"first":"Karen","key":"søgaardpau","last":"Søgaard","locid":"01571423-fcd0-4dbc-9112-e9b52d4a1131","name":"Søgaard, Karen","orcid":"0000-0003-3968-6364","rank":5,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Andreas","key":"holtermannpau","last":"Holtermann","locid":"f0d131d6-aefa-4dd3-a64e-2e237f273adf","name":"Holtermann, Andreas","orcid":"0000-0003-4825-5697","rank":6,"rolecode":"pau"}],"pmid":["33925078"],"pub":{"doi":"10.3390/ijerph18094707","issn":["16604601","16617827"],"issn_org":["16617827"],"issue":"9","journal":"International Journal of Environmental Research and Public Health","paperid":"4707","publisher":"Multidisciplinary Digital Publishing Institute (MDPI)","status":"p","title":"International Journal of Environmental Research and Public Health","volume":"18"},"review":"Peer Reviewed","scoID":["2-s2.0-85104774856"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Hospitals","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["nfa-c097310c-2d4f-4f5a-b1d0-a0839e696b33","sdu-b9eea129-e275-4e2f-812a-73ca0d30404c"],"src":["NFA National Research Centre for the Working Environment","SDU University of Southern Denmark"],"title":"Development and implementation of 'just right' physical behavior in industrial work based on the Goldilocks Work Principle-A feasibility study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.46-769577","year":"2021","yearsub":"2021"}
{"abstract":"BACKGROUND: The challenges imposed by ageing populations will confront health care systems in the years to come. Hospital owners are concerned about the increasing number of acute admissions of older citizens and preventive measures such as integrated care models have been introduced in primary care. Yet, acute admission can be appropriate and lifesaving, but may also in itself lead to adverse health outcome, such as patient anxiety, functional loss and hospital-acquired infections. Timely identification of older citizens at increased risk of acute admission is therefore needed. We present the protocol for the PATINA study, which aims at assessing the effect of the 'PATINA algorithm and decision support tool', designed to alert community nurses of older citizens showing subtle signs of declining health and at increased risk of acute admission. This paper describes the methods, design and intervention of the study. METHODS: We use a stepped-wedge cluster randomized controlled trial (SW-RCT). The PATINA algorithm and decision support tool will be implemented in 20 individual area home care teams across three Danish municipalities (Kerteminde, Odense and Svendborg). The study population includes all home care receiving community-dwelling citizens aged 65 years and above (around 6500 citizens). An algorithm based on home care use triggers an alert based on relative increase in home care use. Community nurses will use the decision support tool to systematically assess health related changes for citizens with increased risk of acute hospital admission. The primary outcome is acute admission. Secondary outcomes are readmissions, preventable admissions, death, and costs of health care utilization. Barriers and facilitators for community nurse's acceptance and use of the algorithm will be explored too. DISCUSSION: This 'PATINA algorithm and decision support tool' is expected to positively influence the care for older community-dwelling citizens, by improving nurses' awareness of citizens at increased risk, and by supporting their clinical decision-making. This may increase preventive measures in primary care and reduce use of secondary health care. Further, the study will increase our knowledge of barriers and facilitators to implementing algorithms and decision support in a community care setup. TRIAL REGISTRATION: ClinicalTrials.gov , identifier: NCT04398797 . Registered 13 May 2020.","author_count":8,"contributors":["Fournaise, Anders","Lauridsen, Jørgen T.","Bech, Mickael","Wiil, Uffe K.","Rasmussen, Jesper B.","Kidholm, Kristian","Espersen, Kurt","Andersen-Ranberg, Karen"],"cuid":["S02-099.94-049239"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Vestergaard Fournaise, Anders"],"keyword":["Acute admission","Algorithm","Community dwelling","Decision support","Geriatrics","Home care","Older people"],"level":"sci","mra":["med","soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-VIVE"],"HO":["DI-HO-ALL","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-GV-VIVE","DI-HO-SDR","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"prevention of acute admission algorithm patina study protocol of a stepped wedge randomized controlled trial","src":["sdu","vive"],"src-code":["DI-GV-VIVE","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12877-021-02092-2","version":"Published Version"},"funding_acknowledgement":["The authors would like to acknowledge Marie Birkemose (University of Southern Denmark) for her assistance and input during the development and preparation of the PATINA algorithm. Finally, the authors also acknowledge David Hass from OPEN, Odense University Hospital, Region of Southern Denmark for assistance in developing the data management setup for the project. Results will be disseminated in open access peer-reviewed journals in accordance with the Vancouver guidelines for co-authorship. Further, results will be presented and discussed at national and international conferences. AF and KAR conceived the research idea and drafted the protocol. AF, JBR, KAR and UKW developed the algorithm and decision support tool. As project manager AF is responsible for the practical implementation of the PATINA algorithm, data collection and analysis. AF prepared this manuscript and MB, JTL, JBR, UKW, KK, KE and KAR provided constructive feedback on the draft protocol and manuscript. JTL and AF performed the power calculation and developed the statistical method. All authors have read and approved the manuscript."],"id":"S02-099.94-049239","identifier":[{"id":"33639833","type":"pmid"},{"id":"PMC7912968","type":"pmcid"},{"id":"85101941495","type":"scopus"}],"ids":["sdu-8fb8c5d7-f86e-4b03-9a4c-041c23729c42","vive-1043a11c-36b1-4865-8415-9340dba0acc1"],"keyword":["Acute admission","Algorithm","Community-dwelling","Decision support","Geriatrics","Home care","Older people","Steppedwedge cluster randomized controlled trial"],"lang":"English","level":"Scientific","mra":["Medical Science","Social Science"],"noi":["Global-Local-2-5-037D9D081692E83E9A53F5186B6CCF94"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12877-021-02092-2","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/180269506/s12877_021_02092_2.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Geriatrics (Odense)","SDU, The Faculty of Health Sciences, Department of Public Health, Epidemiology, Biostatistics and Biodemography"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Region of Southern Denmark"],"nora_code":"DI-HO-SDR","used":1},{"affno":"3","key":"vive the danish center for social science research","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-VIVE","l3nn":"VIVE The Danish Center for Social Science Research","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"VIVE The Danish Center for Social Science Research","namevar":["VIVE - The Danish Center for Social Science Research"],"nora_code":"DI-GV-VIVE","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"Anders","key":"fournaisepau","last":"Fournaise","locid":"cd663620-c2f5-4863-bf21-3bb492636190","name":"Vestergaard Fournaise, Anders","name_org":"Fournaise, Anders","orcid":"0000-0002-4754-7500","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jørgen T.","key":"lauridsenpau","last":"Lauridsen","locid":"9282b638-e2b9-44ce-a6f5-d8fa8cfdf674","name":"Lauridsen, Jørgen Trankjær","name_org":"Lauridsen, Jørgen T.","orcid":"0000-0001-9889-6236","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Mickael","key":"bechpau","last":"Bech","locid":"09cd926c-2d57-4d2e-9e9c-3f13923dce8a","name":"Bech, Mickael","orcid":"0000-0003-3084-2068","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Uffe K.","key":"wiilpau","last":"Wiil","locid":"3c3acba0-f147-4923-8d16-48599c4bf797","name":"Wiil, Uffe Kock","name_org":"Wiil, Uffe K.","orcid":"0000-0001-6898-4083","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper B.","key":"rasmussenpau","last":"Rasmussen","locid":"df5352e5-271e-4bd1-bcf1-457da7207e94","name":"Rasmussen, Jesper B.","rank":5,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Kristian","key":"kidholmpau","last":"Kidholm","locid":"38a02804-c94a-4706-b5a4-de0795e5970e","name":"Kidholm, Kristian","orcid":"0000-0003-1037-6514","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kurt","key":"espersenpau","last":"Espersen","name":"Espersen, Kurt","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Karen","key":"andersenranbergpau","last":"Andersen-Ranberg","locid":"e8672dd9-3141-462f-a2b4-fa2245d83526","name":"Andersen-Ranberg, Karen","orcid":"0000-0003-1970-7076","rank":8,"rolecode":"pau"}],"pmid":["33639833"],"pub":{"doi":"10.1186/s12877-021-02092-2","issn":["14712318"],"issue":"1","journal":"BMC Geriatrics","paperid":"146","publisher":"BioMed Central","status":"p","title":"BMC Geriatrics","volume":"21"},"review":"Peer Reviewed","scoID":["2-s2.0-85101941495"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Hospitals","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-8fb8c5d7-f86e-4b03-9a4c-041c23729c42","vive-1043a11c-36b1-4865-8415-9340dba0acc1"],"src":["SDU University of Southern Denmark","VIVE The Danish Center for Social Science Research"],"title":"Prevention of AcuTe admIssioN algorithm (PATINA): study protocol of a stepped wedge randomized controlled trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.94-049239","year":"2021","yearsub":"2021"}
{"abstract":"Natural history museum collections worldwide represent a tremendous resource of information on past and present biodiversity. Fish, reptiles, amphibians and many invertebrate collections have often been preserved in ethanol for decades or centuries and our knowledge on the genomic and metagenomic research potential of such material is limited. Here, we use ancient DNA protocols, combined with shotgun sequencing to test the molecular preservation in liver, skin and bone tissue from five old (1842 to 1964) museum specimens of the common garter snake (Thamnophis sirtalis). When mapping reads to a T. sirtalis reference genome, we find that the DNA molecules are highly damaged with short average sequence lengths (38-64 bp) and high C-T deamination, ranging from 9% to 21% at the first position. Despite this, the samples displayed relatively high endogenous DNA content, ranging from 26% to 56%, revealing that genome-scale analyses are indeed possible from all specimens and tissues included here. Of the three tested types of tissue, bone shows marginally but significantly higher DNA quality in these metrics. Though at least one of the snakes had been exposed to formalin, neither the concentration nor the quality of the obtained DNA was affected. Lastly, we demonstrate that these specimens display a diverse and tissue-specific microbial genetic profile, thus offering authentic metagenomic data despite being submerged in ethanol for many years. Our results emphasize that historical museum collections continue to offer an invaluable source of information in the era of genomics.","author_count":7,"contributors":["Zacho, Claus M.","Bager, Martina A.","Margaryan, Ashot","Gravlund, Peter","Galatius, Anders","Rasmussen, Arne R.","Allentoft, Morten E."],"cuid":["S03-093.02-666043"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"continent":["OECD","Oceania"],"corresponding_author":["Allentoft, Morten E."],"country":["Australia"],"glorg":["All Global Affiliations","Curtin University","Curtin University, School of Molecular and Life Sciences, Trace and Environmental DNA (TrEnD) Laboratory"],"level":"sci","mra":["hum","med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-ART","DI-OT","DI-U"],"level3":{"ART":["DI-ART-ALL","DI-ART-RDKA"],"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-ART-RDKA","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"uncovering the genomic and metagenomic research potential in old ethanol preserved snakes","src":["arkc","au","ku"],"src-code":["DI-ART-RDKA","DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"doi","url":"https://doi.org/10.1371/journal.pone.0256353","version":"Published Version"},"id":"S03-093.02-666043","identifier":[{"id":"000687421200022","type":"wos"},{"id":"34424926","type":"pmid"},{"id":"85113382318","type":"scopus"},{"id":"PMC8382189","type":"pmcid"}],"ids":["arkc-9d0962e0-d2a8-47c1-b783-4c7a69ff87e3","au-7745eece-8078-4693-8fe2-00b460c14a7d","ku-2b72fb87-e236-46c7-8afd-ed09afe7fe72"],"keyword":["No"],"lang":"English","level":"Scientific","mra":["Humanities","Medical Science","Science/Technology"],"noi":["Global-Local-2-6-1375E4EF6C30A108F9CFD17C0744B044"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"doi","url":"https://doi.org/10.1371/journal.pone.0256353","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/279385952/Uncovering_the_genomic_and_metagenomic_research_potential_in_old_ethanol_preserved_snakes.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Globe Institute, Section for Geogenetics"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Ecoscience, Department of Ecoscience - Marine Mammal Research 1"],"nora_code":"DI-U-AU","used":1},{"affno":"4","key":"royal danish academy architecture design conservation","l2":"DI-ART","l2n":"Artistic Higher Education Institutions","l3":"DI-ART-RDKA","l3nn":"Royal Danish Academy - Architecture, Design, Conservation","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Royal Danish Academy - Architecture, Design, Conservation","namevar":["Royal Danish Academy - Architecture, Design, Conservation","Royal Danish Academy - Architecture, Design, Conservation, Royal Danish Academy - Conservation, Institute of Conservation"],"nora_code":"DI-ART-RDKA","used":1}],"person":[{"affno":"1","first":"Claus M.","key":"zachopau","last":"Zacho","locid":"7e653286-8cf1-474f-9392-b54d82911adc","name":"Zacho, Claus M.","rank":1,"rolecode":"pau"},{"affno":"1","first":"Martina A.","key":"bagerpau","last":"Bager","locid":"80bb76a3-325a-4828-b840-ed366823b01d","name":"Bager, Martina Abenhus","name_org":"Bager, Martina A.","rank":2,"rolecode":"pau"},{"affno":"1","first":"Ashot","key":"margaryanpau","last":"Margaryan","locid":"e461743f-817c-41f7-9141-81940a9aa49b","name":"Margaryan, Ashot","orcid":"0000-0002-2576-2429","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Peter","key":"gravlundpau","last":"Gravlund","name":"Gravlund, Peter","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Anders","key":"galatiuspau","last":"Galatius","locid":"34804171-9f60-4314-a4f4-70df2c4fe2bf","name":"Galatius, Anders","rank":5,"rolecode":"pau"},{"affno":"4 2","corresponding":null,"country":"dk","first":"Arne Redsted","key":"rasmussenpau","last":"Rasmussen","locid":"242dafc1-ebc5-4ad0-bcd9-e8b2aea28bde","name":"Redsted Rasmussen, Arne","name_org":"Rasmussen, Arne Redsted","orcid":"0000-0001-5454-4423","rank":6,"rolecode":"pau"},{"affno":"1","first":"Morten E.","key":"allentoftpau","last":"Allentoft","locid":"ff98a169-a9d1-4497-8694-c2e6e9e0ab5b","name":"Allentoft, Morten E.","rank":7,"rolecode":"pau"}],"pmid":["34424926"],"pub":{"doi":"10.1371/journal.pone.0256353","issn":["19326203"],"issue":"8","journal":"PLOS ONE","paperid":"e0256353","publisher":"Public Library of Science","status":"p","title":"PLOS ONE","volume":"16"},"review":"Peer Reviewed","scoID":["2-s2.0-85113382318"],"search":{"DAF":["Aarhus University","All Artistic Higher Education Institutions","All Danish Affiliations","All Miscellaneous","All Universities","Artistic Higher Education Institutions","DI-ALL","DI-ART","DI-ART-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["arkc-9d0962e0-d2a8-47c1-b783-4c7a69ff87e3","au-7745eece-8078-4693-8fe2-00b460c14a7d","ku-2b72fb87-e236-46c7-8afd-ed09afe7fe72"],"src":["AU Aarhus University","KU University of Copenhagen","Royal Danish Academy - Architecture, Design, Conservation"],"title":"Uncovering the genomic and metagenomic research potential in old ethanol-preserved snakes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-093.02-666043","year":"2021","yearsub":"2021"}
{"abstract":"Context: Aggressive pituitary tumors (APTs) are characterized by unusually rapid growth and lack of response to standard treatment. About 1% to 2% develop metastases being classified as pituitary carcinomas (PCs). For unknown reasons, the corticotroph tumors are overrepresented among APTs and PCs. Mutations in the alpha thalassemia/mental retardation syndrome X-linked (ATRX) gene, regulating chromatin remodeling and telomere maintenance, have been implicated in the development of several cancer types, including neuroendocrine tumors. Objective: To study ATRX protein expression and mutational status of the ATRX gene in APTs and PCs. Design: We investigated ATRX protein expression by using immunohistochemistry in 30 APTs and 18 PCs, mostly of Pit-1 and T-Pit cell lineage. In tumors lacking ATRX immunolabeling, mutational status of the ATRX gene was explored. Results: Nine of the 48 tumors (19%) demonstrated lack of ATRX immunolabelling with a higher proportion in patients with PCs (5/18; 28%) than in those with APTs (4/30;13%). Lack of ATRX was most common in the corticotroph tumors, 7/22 (32%), versus tumors of the Pit-1 lineage, 2/24 (8%). Loss-of-function ATRX mutations were found in all 9 ATRX immunonegative cases: nonsense mutations (n = 4), frameshift deletions (n = 4), and large deletions affecting 22-28 of the 36 exons (n = 3). More than 1 ATRX gene defect was identified in 2 PCs. Conclusion: ATRX mutations occur in a subset of APTs and are more common in corticotroph tumors. The findings provide a rationale for performing ATRX immunohistochemistry to identify patients at risk of developing aggressive and potentially metastatic pituitary tumors.","author_count":29,"contributors":["Casar-Borota, Olivera","Boldt, Henning Bünsow","Engström, Britt Edén","Andersen, Marianne Skovsager","Baussart, Bertrand","Bengtsson, Daniel","Berinder, Katarina","Ekman, Bertil","Feldt-Rasmussen, Ulla","Höybye, Charlotte","Jørgensen, Jens Otto Lunde","Kolnes, Anders Jensen","Korbonits, Márta","Rasmussen, Åse Krogh","Lindsay, John R","Loughrey, Paul Benjamin","Maiter, Dominique","Manojlovic-Gacic, Emilija","Pahnke, Jens","Poliani, Pietro Luigi","Popovic, Vera","Ragnarsson, Oskar","Schalin-Jäntti, Camilla","Scheie, David","Tóth, Miklós","Villa, Chiara","Wirenfeldt, Martin","Kunicki, Jacek","Burman, Pia"],"cuid":["S03-094.29-022438"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"continent":["America, North","Europe, EU","Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Casar-Borota, Olivera"],"country":["Belgium","Canada","Czechia","Finland","France","Germany","Hungary","Italy","Latvia","Norway","Poland","Serbia","Sweden","United Kingdom"],"glorg":["All Global Affiliations","Belfast Health and Social Care Trust","Catholic University of Louvain","Department of Medical Genetics, University Children's Hospital, Belgrade, Serbia.","Foch Hospital","Helsinki University Hospital","Hospital Foch","Karolinska Institute","Karolinska Institute and SciLifeLab","Karolinska Institutet","Linköping University","Lund University","Maria Sklodowska-Curie Institute of Oncology","Maria Sklodowska-Curie National Research Institute of Oncology Gliwice Branch","Oslo University Hospital","Queen Mary University of London","Queen's University Kingston","Royal Observatory of Belgium","Royal Victoria Hospital Barrie","Sahlgrenska University Hospital","Semmelweis University","The University Hospital Brno","University of Belgrade","University of Brescia","University of Gothenburg","University of Helsinki","University of Latvia","University of Lübeck","University of Oslo","Uppsala University","Uppsala University Children's Hospital"],"keyword":["Cushing s disease","Pituitary adenoma","Pituitary carcinoma"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-H