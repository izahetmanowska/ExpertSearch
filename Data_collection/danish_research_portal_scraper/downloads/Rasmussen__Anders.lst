":"møllerpau","last":"Møller","locid":"9463b017-3c43-470d-b95b-cf3cba8a27d4","name":"Møller, Morten Hylander","rank":21,"rolecode":"pau"},{"affno":"2","first":"Anders","key":"granholmpau","last":"Granholm","name":"Granholm, Anders","rank":22,"rolecode":"pau"}],"pmid":["37873986"],"pub":{"issn":["00415782","13994174"],"issn_org":["00415782"],"issue":"41","journal":"Ugeskrift for Læger","status":"p","title":"Ugeskrift for Læger","title_org":"Ugeskrift for Laeger","volume":"185"},"review":"Peer Reviewed","scoID":["2-s2.0-85175661699","2-s2.0-85190853419"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","North Denmark Region","Other Research","Region of Southern Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-90c012c9-7721-48f9-8862-7ab35689bf21"],"src":["KU University of Copenhagen"],"title":"Platform trials : Platformsforsøg","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-721115","year":"2023","yearsub":"2023"}
{"abstract":"What does the situation for humanitarian workand intervention in Jordan look like from insidethe NGO sector? Do we supply demand-based or donor-based solutions to the current situation? And what are the most likely scenarios for the coming years in terms of changing the status quo? In this interview, Martin Fernando Jakobsen, CEO of Turning Tables, an NGO with long and significant experience working in Jordan, gives his reading of the current state of affairs. A key point Jakobsen makes is that there exists a discrepancy between the short-termism of funding schemes and the long-term prospects of actually effecting change. He highlights the importance of getting the target group involved in articulating their needs – not just through NGO interviews but through peer-to-peer research. He also remarks on the need to design exit strategies, such as business plans for each project, in order to make a difference in the longer term.","author_count":7,"contributors":["Bandak, Andreas","Holst, Birgitte Stampe"],"cuid":["S01-000.00-721232"],"filters":{"added":"2024-02","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"nr","rtype":["clu"],"sorti":"tackling the structural barriers for successful ngo involvement in jordan interview with martin fernando jakobsen","src":["ku"],"src-code":["DI-U-KU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://curis.ku.dk/ws/files/376204492/Viable_Futures_Articulations_EN_Final.pdf","version":"Published Version"},"id":"S01-000.00-721232","ids":["ku-99d5a161-1338-4ab6-a72b-df6e62b1add0"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-6DD3647DD09CAA90DE41F5E83AF4BC66"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://curis.ku.dk/ws/files/376204492/Viable_Futures_Articulations_EN_Final.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Humanities, Department of Cross-Cultural and Regional Studies"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Andreas","key":"bandakpau","last":"Bandak","locid":"e358540c-8467-40d4-ae35-b9b52bddfa3a","name":"Bandak, Andreas","rank":1,"rolecode":"pau"},{"affno":"1","first":"Birgitte Stampe","key":"holstpau","last":"Holst","locid":"3cc4e77d-f94f-4945-9a73-405a828afaa5","name":"Holst, Birgitte Stampe","rank":2,"rolecode":"pau"},{"affno":"","first":"Andreas","key":"bandakpedh","last":"Bandak","name":"Bandak, Andreas","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Birgitte","key":"stampeholstpedh","last":"Stampe Holst","name":"Stampe Holst, Birgitte","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Anders","key":"hastruppedh","last":"Hastrup","name":"Hastrup, Anders","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Nick","key":"soltanipedh","last":"Soltani","name":"Soltani, Nick","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Hannah","key":"arndalrasmussenpedh","last":"Arndal Rasmussen","name":"Arndal Rasmussen, Hannah","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"pages":"37-44","publisher":"Københavns Universitet, Humanistisk Fakultet","status":"p","subtitle":"Syrian Articulations of the Protracted Crisis in Jordan","title":"Viable Futures"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-99d5a161-1338-4ab6-a72b-df6e62b1add0"],"src":["KU University of Copenhagen"],"title":"Tackling the structural barriers for successful NGO involvement in Jordan : Interview with Martin Fernando Jakobsen","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-721232","year":"2023","yearsub":"2023"}
{"abstract":"Background Staphylococcus aureus may worsen already established atopic dermatitis (AD), but its primary role in the aetiopathogenesis and severity of AD is unclear. Objectives To compare the prevalence of S. aureus colonization in early infancy in children who developed AD during the first 2 years of life with children who did not. Methods In this prospective birth cohort study, which included 450 infants, we analysed bacterial swabs collected from cheek skin at 0 and 2 months of age. The development of AD, and its severity, was diagnosed by a physician and monitored prospectively for 2 years. Information on parental atopy, filaggrin gene mutation status and use of antibiotics and emollients was included in the analyses. Results At birth, the occurrence of S. aureus colonization was similar in infants who developed subsequent AD and those who did not. At 2 months of age, S. aureus colonization was more common in children who later developed AD (adjusted hazard ratio 1.97, 95% confidence interval 1.21-3.19; P = 0.006). No association was found between S. aureus colonization and AD severity or age at onset. Conclusions It remains unknown whether colonization with S. aureus may directly increase the risk of AD, or whether it should be considered as secondary to skin barrier impairment or a skewed immune activity, but according to our findings, S. aureus colonization is more commonly increased at 2 months of age in children who later developed AD.","author_count":17,"contributors":["Rinnov, Maria Rasmussen","Gerner, Trine","Halling, Anne Sofie","Liljendahl, Mie Sylow","Ravn, Nina Haarup","Knudgaard, Mette Hjorslev","Trautner, Simon","Skov, Lone","Thomsen, Simon Francis","Egeberg, Alexander","Jakasa, Ivone","Kezic, Sanja","Petersen, Andreas","Larsen, Anders Rhod","Dam-Nielsen, Casper","Jarløv, Jens Otto","Thyssen, Jacob P."],"cuid":["S01-000.00-722338"],"filters":{"added":"2024-02","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Croatia","Netherlands"],"glorg":["All Global Affiliations","University of Amsterdam","University of Zagreb"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the association between staphylococcus aureus colonization on cheek skin at 000000000002 months and subsequent atopic dermatitis in a prospective birth cohort","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-722338","identifier":[{"id":"85178164093","type":"scopus"},{"id":"37480337","type":"pmid"}],"ids":["ku-eee13303-adec-4b7c-a92a-23d8b10853d1"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-4F67C6C3330C046D854F3C7B5EC12550"],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Dermatovenerology"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"hr","key":"university of zagreb","loc":["Croatia","Europe, EU"],"name":"Uni