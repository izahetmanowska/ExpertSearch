me":"Wetterslev, Jørn","rank":21,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Olav Lilleholt","key":"schjørringpau","last":"Schjørring","locid":"7dac619e-9b5c-46ac-9170-10ac13165da5","name":"Schjørring, Olav Lilleholt","rank":22,"rolecode":"pau"}],"pmid":["34425016"],"pub":{"doi":"10.1111/aas.13977","issn":["00015172"],"issue":"1","journal":"Acta Anaesthesiologica Scandinavica","pages":"76-84","publisher":"Blackwell Munksgaard","status":"p","title":"Acta Anaesthesiologica Scandinavica","volume":"66"},"review":"Peer Reviewed","scoID":["2-s2.0-85115101315"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","North Denmark Region","Other Research","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-c6ea92a6-51e6-47ca-9d09-b517114d0ca4","au-853ef52e-68a8-47ba-9144-6b344d83ead7","ku-2e8e7195-60f7-4f22-8cc8-7b217d8d001f","sdu-5eb26aae-ba52-44ac-a570-25f3f70559dd"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Oxygenation targets in ICU patients with COVID-19 : A post hoc subgroup analysis of the HOT-ICU trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-089.96-665954","year":"2022","yearsub":"2022"}
{"abstract":"Background: ICU admission due to COVID-19 may result in cognitive and physical impairment. We investigated the long-term cognitive and physical status of Danish ICU patients with COVID-19. Methods: We included all patients with COVID-19 admitted to Danish ICUs between March 10 and May 19, 2020. Patients were the contacted prospectively at 6 and 12 months for follow-up. Our primary outcomes were cognitive function and frailty at 6 and 12 months after ICU admission, estimated by the Mini Montreal Cognitive Assessment, and the Clinical Frailty Scale. Secondary outcomes were 6- and 12-month mortality, health-related quality of life (HRQoL) assessed by EQ-5D-5L, functional status (Barthel activities of daily living and Lawton–Brody instrumental activities of daily living), and fatigue (Fatigue Assessment Scale). The study had no information on pre-ICU admission status for the participants. Results: A total of 326 patients were included. The 6- and 12-month mortality was 37% and 38%, respectively. Among the 204 six-month survivors, 105 (51%) participated in the 6-month follow-up; among the 202 twelve-month survivors, 95 (47%) participated in the 12-month follow-up. At 6 months, cognitive scores indicated impairment for 26% (95% confidence interval [CI], 11.4–12.4) and at 12 months for 17% (95% CI, 12.0–12.8) of participants. Frailty was indicated in 20% (95% CI, 3.4–3.9) at 6 months, and for 18% (95% CI, 3.3–3.8) at 12 months. Fatigue was reported by 52% at 6 months, and by 47% at 12 months. For HRQoL, moderate, severe, or extreme health problems were reported by 28% at 6 months, and by 25% at 12 months. Conclusion: Long-term cognitive, functional impairment was found in up to one in four of patients surviving intensive care for COVID-19. Fatigue was present in nearly half the survivors at both 6 and 12 months. However, pre-ICU admission status of the patients was unknown.","author_count":34,"contributors":["Weihe, Sarah","Mortensen, Camilla B.","Haase, Nicolai","Andersen, Lars P. K.","Mohr, Thomas","Siegel, Hanna","Ibsen, Michael","Jørgensen, Vibeke R. L.","Buck, David L.","Pedersen, Helle B. S.","Pedersen, Henrik P.","Iversen, Susanne","Ribergaard, Niels-Erik","Rasmussen, Bodil Steen","Winding, Robert","Espelund, Ulrick S.","Bundgaard, Helle","Sølling, Christoffer G.","Christensen, Steffen","Garcia, Ricardo S.","Brøchner, Anne C.","Michelsen, Jens","Michagin, George","Kirkegaard, Lynge","Perner, Anders","Mathiesen, Ole","Poulsen, Lone M."],"cuid":["S04-095.83-011791"],"filters":{"added":"2022-08","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"continent":["OECD","Oceania"],"corresponding_author":["Weihe, Sarah"],"country":["New Zealand"],"glorg":["All Global Affiliations","Palmerston North Hospital"],"keyword":["Activities of Daily Living psychology","COVID 19 therapy","Cognition","Cognitive","Covid 19","Denmark epidemiology","Fatigue","Fatigue epidemiology","Follow up","Frailty","Frailty epidemiology","Functional","Functional status","Humans","Intensive Care Units","Intensive care","Prospective Studies","Quality of Life"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-OTH","DI-HO-SDR","DI-HO-ZEA"],"OT":["Unspecified organisation"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-OTH","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"long term cognitive and functional status in danish icu patients with covid 000000000019","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC9350352/pdf/AAS-66-978.pdf","version":"Published Version"},"id":"S04-095