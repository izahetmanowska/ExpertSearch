sity, The Faculty of Medicine, Aalborg University Hospital, Klinik Hjerte-Lunge","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine, Aalborg Thrombosis Research Unit"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"gb","key":"city hospital university of birmingham centre for cardiovascular sciences birmingham","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"City Hospital, University of Birmingham Centre for Cardiovascular Sciences, Birmingham","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Line","key":"melgaardpau","last":"Melgaard","locid":"88687b9c-5b56-4584-a89a-89fdeca4fd54","name":"Melgaard, Line","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders","key":"gorstrasmussenpau","last":"Gorst-Rasmussen","locid":"2aa85786-c0b1-42ec-93d4-eb7a75696409","name":"Gorst-Rasmussen, Anders","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Gregory Y.H.","key":"lippau","last":"Lip","name":"Lip, Gregory Y.H.","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Torben Bjerregaard","key":"larsenpau","last":"Larsen","locid":"a3c6747f-b9db-488b-8eb9-887d38742880","name":"Larsen, Torben Bjerregaard","orcid":"0000-0002-8485-8674","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1002/ejhf.277","issn":["13889842","18790844"],"issn_org":["13889842"],"issue":"Suppl 1","journal":"European Journal of Heart Failure","pages":"70","paperid":"P321","publisher":"Wiley","status":"p","title":"European Journal of Heart Failure","title_org":"European Journal of Heart Failure. Supplements","volume":"17"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-19c57141-0eae-49f9-b21e-22f91b7e226b"],"src":["AAU Aalborg University"],"title":"Diabetes as a risk factor of stroke and death in heart failure patients in sinus rhythm : A nationwide cohort study","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-057602","year":"2015","yearsub":"2015"}
{"abstract":"BACKGROUND: Tourniquet use in total knee arthroplasty (TKA) surgery is applied to minimize blood loss thereby creating better overview of the surgical field. This induces ischemia in the skeletal muscle resulting in reperfusion injury. Our aim was to investigate the in vivo metabolic changes in the skeletal muscle during TKA surgery using microdialysis (MD). METHODS: Seventy patients were randomly allocated to tourniquet group (n = 35) or non-tourniquet group (n = 35). Prior to surgery, catheters were inserted in the operated leg and non-operated leg. Interstitial dialysate was collected before and after surgery and at 20 min intervals during a 5 h reperfusion period. Main variables were ischemic metabolites: glucose, pyruvate, lactate and glycerol and L/P ratio. RESULTS: Significant difference in all metabolites was detected between the two groups, caused by tourniquet application. Tourniquet induced ischemia resulted in decreased levels of glucose and pyruvate to 54 and 60 % respectively, compared to baseline. Simultaneously, accumulation of lactate to 116 % and glycerol to 190 % was observed. L/P ratio was elevated indicating ischemia. In the non-tourniquet group the metabolite changes were less profound and normalized within 60 min. CONCLUSIONS: Microdialysis revealed that performing TKA with tourniquet is associated with increased ischemia. This affects all metabolites but the changes are normalized after 5 h.","author_count":6,"contributors":["Ejaz, Ashir","Laursen, Anders Christian","Kappel, Andreas","Jakobsen, Thomas","Nielsen, Poul Torben","Rasmussen, Sten"],"cuid":["S01-000.00-065318"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"tourniquet induced ischemia and changes in metabolism during tka a randomized study using microdialysis","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1186/s12891-015-0784-y","version":"Published Version"},"id":"S01-000.00-065318","identifier":[{"id":"84946059392","type":"scopus"},{"id":"26510621","type":"pmid"},{"id":"WOS:000364545800001","type":"wos"}],"ids":["aau-34a5b405-8778-4e84-87c8-06347ee80b14"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-A6A667E9FA44DAF04CDD570A64CC6DF2"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1186/s12891-015-0784-y","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Orthopaedic Surgery","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Hoved-Orto","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Ashir","key":"ejazpau","last":"Ejaz","locid":"d14dcef2-26f0-4374-b32b-9f078e895d48","name":"Ejaz, Ashir","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders C","key":"laursenpau","last":"Laursen","locid":"becbdeb4-e247-4a3d-9aa2-0be9086e449c","name":"Laursen, Anders Christian","name_org":"Laursen, Anders C","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Andreas","key":"kappelpau","last":"