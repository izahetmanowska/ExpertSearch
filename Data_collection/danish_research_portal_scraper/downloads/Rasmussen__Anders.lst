hmidt, Erik Berg","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders","key":"gorstrasmussenpau","last":"Gorst-Rasmussen","locid":"52580a62-0604-4221-b4da-578ec2f5ec35","name":"Gorst-Rasmussen, Anders","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jakob","key":"steggerpau","last":"Stegger","locid":"0bd80c84-0c2f-4e85-8d92-5b77ed68a738","name":"Stegger, Jakob","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kim","key":"overvadpau","last":"Overvad","locid":"83738c57-45d4-41e0-b807-ad0f6dec597c","name":"Overvad, Kim","orcid":"0000-0001-6429-7921","rank":5,"rolecode":"pau"}],"pub":{"issn":["11032855"],"issue":"21 supl.","journal":"Cirkulation","publisher":"Ohlson & Winnfors AB","status":"p","title":"Cirkulation","volume":"126"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-a6434dcd-076f-4793-9c9c-0988906af44b"],"src":["AU Aarhus University"],"title":"A high adipose tissue arachidonic acid content is associated with a higher risk of myocardial infarction : a danish case cohort study","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-224089","year":"2012","yearsub":"2012"}
{"abstract":"In the Home Care Crew Scheduling Problem a staff of home carers has to be assigned a number of visits to patients’ homes, such that the overall service level is maximised. The problem is a generalisation of the vehicle routing problem with time windows. Required travel time between visits and time windows of the visits must be respected. The challenge when assigning visits to home carers lies in the existence of soft preference constraints and in temporal dependencies between the start times of visits.We model the problem as a set partitioning problem with side constraints and develop an exact branch-and-price solution algorithm, as this method has previously given solid results for classical vehicle routing problems. Temporal dependencies are modelled as generalised precedence constraints and enforced through the branching. We introduce a novel visit clustering approach based on the soft preference constraints. The algorithm is tested both on real-life problem instances and on generated test instances inspired by realistic settings. The use of the specialised branching scheme on real-life problems is novel. The visit clustering decreases run times significantly, and only gives a loss of quality for few instances. Furthermore, the visit clustering allows us to find solutions to larger problem instances, which cannot be solved to optimality.","author_count":4,"contributors":["Rasmussen, Matias Sevel","Justesen, Tor Fog","Dohn, Anders Høeg","Larsen, Jesper"],"cuid":["S01-000.00-304963"],"event":{"end":"2009-07-08","place":"Bonn, de","start":"2009-07-05","title":"23rd European Conference on Operational Research","year":"2009"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Branch and price","Crew scheduling","Home care","Set partitioning","Vehicle routing"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"the home care crew scheduling problem preference based visit clustering and temporal dependencies","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.ejor.2011.10.048","version":"Other Version"},"id":"S01-000.00-304963","identifier":[{"id":"84857921846","type":"scopus"}],"ids":["dtu-017bd21d-34cf-4958-9b32-ad18224ba715"],"keyword":["Branch-and-price","Crew scheduling","Generalised precedence constraints","Home care","Set partitioning","Vehicle routing"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-FC6F992E29D8C77BB8F82E8DA928F331"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.ejor.2011.10.048","version":"Other Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Management Engineering"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Matias Sevel","key":"rasmussenpau","last":"Rasmussen","locid":"fae6c0fe-1ce6-46e6-b271-b6609f9c42d5","name":"Rasmussen, Matias Sevel","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Tor Fog","key":"justesenpau","last":"Justesen","locid":"823aee25-b2db-48aa-a0aa-96a6d384ba2c","name":"Justesen, Tor Fog","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders Høeg","key":"dohnpau","last":"Dohn","locid":"7047c488-612a-498d-a5c1-ec880769c499","name":"Dohn, Anders Høeg","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper","key":"larsenpau","last":"Larsen","locid":"d1af4d26-e92b-414c-b534-25b2b607a0d9","name":"Larsen, Jesper","orcid":"0000-0002-9119-3586","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.ejor.2011.10.048","issn":["03772217","18726860"],"issn_org":["03772217"],"issue":"3","journal":"European Journal of Operational Research","pages":"598-610","publisher":"Elsevier","status":"p","title":"European Journal of Operational Research","volume":"219"},"review":"Peer Reviewed","scoID":["2-s2.0-84857921846"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-017bd21d-34cf-4958-9b32-ad18224ba715"],"src":["DTU Technical University of Denmark"],"title":"The Home Care Crew Scheduling Problem: Preference-based visit clustering and temporal dependencies","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-304963","year":"2012","yearsub":"2012"}
