001-9650-9781","rank":5,"rolecode":"pau"},{"affno":"1","first":"Morten S.","key":"olesenpau","last":"Olesen","name":"Olesen, Morten S.","rank":6,"rolecode":"pau"},{"affno":"3","first":"Adrian","key":"pietersenpau","last":"Pietersen","name":"Pietersen, Adrian","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Christian","key":"torppedersenpau","last":"Torp-Pedersen","locid":"5417d806-0578-4505-b3fe-68ae0359913e","name":"Torp-Pedersen, Christian","rank":8,"rolecode":"pau"},{"affno":"4","first":"Stig","key":"haunsøpau","last":"Haunsø","locid":"2d7a08cf-874a-4f9e-8964-e9c473cecd38","name":"Haunsø, Stig","rank":9,"rolecode":"pau"},{"affno":"4","first":"Lars","key":"køberpau","last":"Køber","locid":"e3f0c57c-605a-431a-9c63-2213c46621e6","name":"Køber, Lars","rank":10,"rolecode":"pau"},{"affno":"4","first":"Jesper H.","key":"svendsenpau","last":"Svendsen","locid":"d80910cf-2f9c-457c-9e85-34b4b258bb81","name":"Svendsen, Jesper Hastrup","name_org":"Svendsen, Jesper H.","orcid":"0000-0001-8466-8515","rank":11,"rolecode":"pau"},{"affno":"1","first":"Anders G.","key":"holstpau","last":"Holst","name":"Holst, Anders G.","rank":12,"rolecode":"pau"},{"affno":"1","first":"Jonas B.","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Jonas B.","rank":13,"rolecode":"pau"}],"pmid":["28576781"],"pub":{"doi":"10.1161/circep.116.004778","issn":["19413084","19413149"],"issn_org":["19413149"],"issue":"6","journal":"Circulation: Arrhythmia and Electrophysiology","paperid":"e004778","publisher":"Lippincott Williams and Wilkins","status":"p","title":"Circulation: Arrhythmia and Electrophysiology","title_org":"Circulation. Arrhythmia and Electrophysiology","volume":"10"},"review":"Peer Reviewed","scoID":["2-s2.0-85021065225"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Other Hospitals","Universities","University of Copenhagen","copenhagen general practitioners' laboratory"],"PST":["Published"]},"sid":["aau-1f541a73-44c6-494b-b799-681e8326c938","ku-c14f3d8f-98c4-4b3d-9ab5-2e7101eac489"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"Electrocardiographic Preexcitation and Risk of Cardiovascular Morbidity and Mortality : Results from the Copenhagen ECG Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.94-001584","year":"2017","yearsub":"2017"}
{"abstract":"Ingestion of eggs (ova) of the porcine nematode parasite Trichuris suis (TSO) may reduce the severity of autoimmune disorders, however the development of TSO treatment as a useful therapy for autoimmune diseases is hampered by a lack of knowledge on the development of the parasite and the nature of the local immune responses in humans. Here, we used colonoscopy to investigate the development of T. suis and related mucosal and systemic immune responses during TSO treatment in an intestinally healthy male volunteer. TSO treatment induced T. suis-specific serum antibodies, a transient blood eosinophilia, and increases in IFNγ(+) and IL4(+) cells within the circulating CD4(+) T-cell population. Increased expression of genes encoding cytokines (IL4, IL10, IL17 and TGF-β), and transcription factors (FOXP3, GATA3 and RORC) were apparent in the ascending and transverse colon (the predilection site of the worms), whereas only limited changes in gene expression were observed proximally (ileum) and distally (descending colon) to the infected tissue. We further show that T. suis is able to colonise the human colon, with a number of worms developing to a similar size and morphology observed in the natural pig host, and a small number of unembryonated eggs were passed in the faeces, indicating patent infection. Notably, the volunteer experienced a substantial improvement in psoriasis during the course of TSO treatment. Thus, TSO treatment induced a mixed Th1/Th2/T regulatory response at the local site of infection, which was also reflected to some extent in the peripheral circulation. These results, together with the first definitive observations that T. suis can mature to adult size and reproduce in humans, shed new light on the interaction between the human immune system and probiotic helminth treatment, which should facilitate further development of this novel therapeutic option.","author_count":9,"contributors":["Williams, Andrew R","Dige, Anders","Rasmussen, Tue Kruse","Hvas, Christian Lodberg","Dahlerup, Jens Frederik","Iversen, Lars","Stensvold, C Rune","Agnholt, Jørgen","Nejsum, Peter"],"cuid":["S02-099.94-025155"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Inflammation","Journal Article","Parasite","Trichuris suis"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-GV-SSI","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"immune responses and parasitological observations induced during probiotic treatment with medicinal i trichuris suis i ova in a healthy volunteer","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85020432600","version":"Other Version"},"id":"S02-099.94-025155","identifier":[{"id":"85020432600","type":"scopus"},{"id":"28602842","type":"pmid"}],"ids":["au-ab2efa97-4e5c-45d9-85cd-63cccbfe06e1","ku-36aaf950-cd68-47a6-a136-7faff874dd40"],"keyword":["Helminth therapy","Inflammation","Journal Article","Parasite","Trichuris suis"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-3002B1390D03090F947D3CFF830C20DE"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary and Animal Sciences, Parasitology and Aquatic Pathobiology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Hepatology and Gastroenterology"],"nora_code":"DI-U-AU","used":1},{"affno":"3","country":"dk","key":"ssi statens serum institut","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-SSI","l3nn":"SSI Statens Serum Institut","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SSI Statens Serum Institut","namevar":["Statens Serum Institut"],"nora_code":"DI-GV-SSI","used":1}],"person":[{"affno":"1","first":"Andrew R.","key":"williamspau","last":"Williams","locid":"393f749c-84d9-4245-84f2-1fee6f8d3ead","name":"Williams, Andrew R.","orcid":"0000-0002-8231-282X","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Anders","key":"digepau","last":"Dige","locid":"c5b7ed9d-4c85-4d70-b215-6b023bdc20f5","name":"Dige, Anders","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Tue Kruse","key":"rasmussenpau","last":"Rasmussen","locid":"0b1018e8-2ad6-4f8d-8413-5c10a8db586d","name":"Rasmussen, Tue Kruse","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Christian L","key":"hvaspau","last":"Hvas","locid":"7b1fa10a-007b-4f40-92f4-6e602982860e","name":"Hvas, Christian Lodberg","name_org":"Hvas, Christian L","orcid":"0000-0001-7973-7184","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jens F","key":"dahleruppau","last":"Dahlerup","locid":"0f52b503-fe76-4e51-939a-7a24f226f420","name":"Dahlerup, Jens Frederik","name_org":"Dahlerup, Jens F","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Lars","key":"iversenpau","last":"Iversen","locid":"0ee9531c-28fa-41bc-8eb4-64d8ae7f0fb1","name":"Iversen, Lars","orcid":"0000-0003-1816-4508","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"C Rune","key":"stensvoldpau","last":"Stensvold","name":"Stensvold, C Rune","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jørgen","key":"agnholtpau","last":"Agnholt","locid":"66d6b88f-b5c0-4c2e-b073-056cd18dc1ea","name":"Agnholt, Jørgen","orcid":"0009-0006-4776-0121","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Peter","key":"nejsumpau","last":"Nejsum","locid":"ee468e32-0a8b-4cd3-9473-60335cf27df9","name":"Nejsum, Peter","orcid":"0000-0002-6673-8505","rank":9,"rolecode":"pau"}],"pmid":["28602842"],"pub":{"doi":"10.1016/j.imlet.2017.06.002","issn":["01652478","18790542"],"issn_org":["01652478"],"journal":"Immunology Letters","pages":"32-37","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"p","title":"Immunology Letters","volume":"188"},"review":"Peer Reviewed","scoID":["2-s2.0-85020432600"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-ab2efa97-4e5c-45d9-85cd-63cccbfe06e1","ku-36aaf950-cd68-47a6-a136-7faff874dd40"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Immune responses and parasitological observations induced during probiotic treatment with medicinal Trichuris suis ova in a healthy volunteer","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.94-025155","year":"2017","yearsub":"2017"}
{"abstract":"Most Staphylococcus aureus isolates can cause invasive disease given the right circumstances, but it is unknown if some isolates are more likely to cause severe infections than others. S. aureus bloodstream isolates from 120 patients with definite infective endocarditis and 121 with S. aureus bacteraemia without infective endocarditis underwent whole-genome sequencing. Genome-wide association analysis was performed using a variety of bioinformatics approaches including SNP analysis, accessory genome analysis and k-mer based analysis. Core and accessory genome analyses found no association with either of the two clinical groups. In this study, the genome sequences of S. aureus bloodstream isolates did not discriminate between bacteraemia and infective endocarditis. Based on our study and the current literature, it is not convincing that a specific S. aureus genotype is clearly associated to infective endocarditis in patients with S. aureus bacteraemia.","author_count":24,"contributors":["Lilje, Berit","Rasmussen, Rasmus Vedby","Dahl, Anders","Stegger, Marc","Skov, Robert Leo","Fowler, Vance G","Ng, Kim Lee","Kiil, Kristoffer","Larsen, Anders Rhod","Petersen, Andreas","Johansen, Helle Krogh","Schønheyder, Henrik Carl","Arpi, Magnus","Rosenvinge, Flemming S","Korup, Eva","Høst, Ulla","Hassager, Christian","Gill, Sabine Ute Alice","Hansen, Thomas Fritz","Johannesen, Thor Bech","Smit, Jesper","Søgaard, Peter","Skytt Andersen, Paal","Bruun, Niels Eske"],"cuid":["S02-100.00-009199"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Duke University Medical Center","Translational Genomics North"],"keyword":["Journal Article"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-NDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-HO-NDR","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"whole genome sequencing of bloodstream staphylococcus aureus isolates does not distinguish bacteraemia from endocarditis","src":["aau","sdu"],"src-code":["DI-U-AAU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1099/mgen.0.000138","version":"Published Version"},"id":"S02-100.00-009199","identifier":[{"id":"29208121","type":"pmid"},{"id":"PMC5729915","type":"pmcid"},{"id":"85058279262","type":"scopus"},{"id":"000431155700002","type":"wos"}],"ids":["aau-bea56647-f66e-409c-9de1-d84762b81dfa","sdu-0421c805-04d4-4529-8f7e-71f21a3fda55"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-422B030F010AF8C8C6B48930E55F82B8"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1099/mgen.0.000138","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/266899079/mgen000138.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/129592975/Whole_genome_sequencing_of_bloodstream_Staphylococcus_aureus_isolates_does_not_distinguish_bacteraemia_from_endocarditis.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","country":"dk","key":"ssi statens serum institut","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-SSI","l3nn":"SSI Statens Serum Institut","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SSI Statens Serum Institut","namevar":["Statens Serum Institut"],"nora_code":"DI-GV-SSI","used":1},{"affno":"2","country":"dk","ke