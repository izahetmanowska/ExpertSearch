l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Agrologica"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","first":"Philipp Matthias","key":"steffanpau","last":"Steffan","locid":"ba016d6c-38a3-43d8-9b76-60b1a73dac84","name":"Steffan, Philipp Matthias","rank":1,"rolecode":"pau"},{"affno":"1","first":"Anna Maria","key":"torppau","last":"Torp","locid":"48b42851-8540-4054-81c4-4ee820ea115f","name":"Torp, Anna Maria","orcid":"0000-0001-8199-1480","rank":2,"rolecode":"pau"},{"affno":"2","first":"Anders","key":"borgenpau","last":"Borgen","name":"Borgen, Anders","rank":3,"rolecode":"pau"},{"affno":"1","first":"Gunter Martin","key":"backespau","last":"Backes","locid":"a409a9d9-62d6-42ec-8410-ef0146f970fd","name":"Backes, Gunter Martin","rank":4,"rolecode":"pau"},{"affno":"1","first":"Søren Kjærsgaard","key":"rasmussenpau","last":"Rasmussen","locid":"95b8db6a-2621-49dc-bf1f-dbba5884b8da","name":"Rasmussen, Søren Kjærsgaard","orcid":"0000-0001-6169-2504","rank":5,"rolecode":"pau"}],"pmid":["28238022"],"pub":{"doi":"10.1007/s00122-017-2868-6","issn":["00405752","14322242"],"issn_org":["00405752"],"issue":"5","journal":"Theoretical and Applied Genetics","pages":"1031-1040","status":"p","title":"Theoretical and Applied Genetics","volume":"130"},"review":"Peer Reviewed","scoID":["2-s2.0-85013817631"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-55106c55-227e-432d-9281-e6527b09579a"],"src":["KU University of Copenhagen"],"title":"Mapping of common bunt resistance gene <i>Bt9</i> in wheat","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-444288","year":"2017","yearsub":"2017"}
{"abstract":"BACKGROUND: Roux-en-Y gastric bypass (RYGB) and sleeve gastrectomy (SG) lead to a reduction in energy intake. It is uncertain whether this reduction is simply due to eating smaller portions or if surgery changes food preferences towards less energy-dense food. Previous results rely on verbal reports, which may be prone to recall bias and underestimation of especially unhealthy foods. METHODS: Using an ad libitum buffet meal targeting direct behavior, we investigated if RYGB and SG surgery leads to changes in food preferences. In addition, we assessed food preferences by a picture display test to explore differences between a method relying on verbal report and a method assessing direct behavior. RESULTS: Forty-one subjects (BMI 45.0 ± 6.8 kg/m(2)) completed a visit pre- and 6 months post-RYGB (n = 31) and SG (n = 10). Mean BMI decreased with 11.7 ± 0.6 kg/m(2) and total energy intake at the buffet meal with 54% (4491 ± 208 kJ vs. 2083 ± 208 kJ, P < 0.001), respectively. However, relative energy intake from the following food categories: high-fat, low-fat, sweet, savory, high-fat-savory, high-fat-sweet, low-fat-savory, and low-fat-sweet, as well as energy density did not change following surgery (all P ≥ 0.18). In contrast, the picture display test showed that food from the low-fat-savory group was chosen more often post-surgery (34 ± 8% vs. 65 ± 9%, P = 0.02). CONCLUSION: The reduction in energy intake after RYGB and SG surgery and the subsequent weight loss seems to be primarily related to a reduction in portion sizes and not by changes in food preferences towards less energy-dense foods. These results underline the necessity of investigating eating behavior by targeting direct behavior.","author_count":9,"contributors":["Nielsen, Mette Søndergaard","Christensen, Bodil Just","Ritz, Christian","Rasmussen, Simone","Hansen, Thea Toft","Bredie, Wender","le Roux, Carel W","Sjödin, Anders Mikael","Schmidt, Julie Berg"],"cuid":["S01-000.00-497977"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Ireland"],"glorg":["All Global Affiliations","University College Dublin"],"keyword":["Journal Article"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"roux en y gastric bypass and sleeve gastrectomy does not affect food preferences when assessed by an ad libitum buffet meal","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-497977","identifier":[{"id":"28411313","type":"pmid"},{"id":"85017478744","type":"scopus"}],"ids":["ku-af0a5984-0ca7-4ce9-8f2f-d9b702a3f7b9"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-63ECAFF71A90D84DC74F1BC60E63EF87"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Nutrition, Exercise and Sports, Obesity Research"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"ie","key":"university college dublin","loc":["Ireland","Europe, EU","OECD"],"name":"University College Dublin","used":1}],"person":[{"affno":"1","first":"Mette Søndergaard","key":"nielsenpau","last":"Nielsen","locid":"080ae329-1cd1-45c3-8531-7bfe74879f0b","name":"Nielsen, Mette Søndergaard","orcid":"0000-0001-7354-4648","rank":1,"rolecode":"pau"},{"affno":"1","first":"Bodil Just","key":"christensenpau","last":"Christensen","locid":"610aa898-48ea-4ebe-86ff-4664cf197551","name":"Christensen, Bodil Just","orcid":"0000-0003-4529-8253","rank":2,"rolecode":"pau"},{"affno":"1","first":"Christian","key":"ritzpau","last":"Ritz","locid":"c881424f-d529-443e-b60e-bc2edb674ede","name":"Ritz, Christian","orcid":"0000-0002-5095-0624","rank":3,"rolecode":"pau"},{"affno":"1","first":"Simone","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Simone","rank":4,"rolecode":"pau"},{"affno":"1","first":"Thea Toft","key":"hansenpau","last":"Hansen","locid":"169219d3-884a-49d3-8a5e-b0876fcf1554","name":"Hansen, Thea Toft","orcid":"0000-0002-0324-4698","rank":5,"rolecode":"pau"},{"affno":"1","first":"Wender","key":"brediepau","last":"Bredie","locid":"1992f1d6-32fd-41e0-91e0-03436e2f7851","name":"Bredie, Wender","orcid":"0000-0001-5145-4131","rank":6,"rolecode":"pau"},{"affno":"2","first":"Carel W","key":"lerouxpau","last":"le Roux","name":"le Roux, Carel W","rank":7,"rolecode":"pau"},{"affno":"1","first":"Anders Mikael","key":"sjödinpau","last":"Sjödin","locid":"24ea7b85-2a13-44ec-93f5-fb419b0ab4fd","name":"Sjödin, Anders Mikael","orcid":"0000-0002-6451-3847","rank":8,"rolecode":"pau"},{"affno":"1","first":"Julie Berg","key":"schmidtpau","last":"Schmidt","locid":"bfd32cb7-28ed-49e9-bc8e-4f9746043c12","name":"Schmidt, Julie Berg","orcid":"0000-0002-0299-7874","rank":9,"rolecode":"pau"}],"pmid":["28411313"],"pub":{"doi":"10.1007/s11695-017-2678-6","issn":["09608923","17080428"],"issn_org":["09608923"],"issue":"10","journal":"Obesity Surgery","pages":"2599-2605","status":"p","title":"Obesity Surgery","volume":"27"},"review":"Peer Reviewed","scoID":["2-s2.0-85017478744"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-af0a5984-0ca7-4ce9-8f2f-d9b702a3f7b9"],"src":["KU University of Copenhagen"],"title":"Roux-En-Y gastric bypass and sleeve gastrectomy does not affect food preferences when assessed by an ad libitum buffet meal","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-497977","year":"2017","yearsub":"2017"}
{"abstract":"Purpose: We assessed the effects of early goal-directed nutrition (EGDN) vs. standard nutritional care in adult intensive care unit (ICU) patients. Methods: We randomised acutely admitted, mechanically ventilated ICU patients expected to stay longer than 3 days in the ICU. In the EGDN group we estimated nutritional requirements by indirect calorimetry and 24-h urinary urea aiming at covering 100% of requirements from the first full trial day using enteral and parenteral nutrition. In the standard of care group we aimed at providing 25 kcal/kg/day by enteral nutrition. If this was not met by day 7, patients were supplemented with parenteral nutrition. The primary outcome was physical component summary (PCS) score of SF-36 at 6 months. We performed multiple imputation for data of the non-responders. Results: We randomised 203 patients and included 199 in the intention-to-treat analyses; baseline variables were reasonably balanced between the two groups. The EGDN group had less negative energy (p < 0.001) and protein (p < 0.001) balances in the ICU as compared to the standard of care group. The PCS score at 6 months did not differ between the two groups (mean difference 0.0, 95% CI −5.9 to 5.8, p = 0.99); neither did mortality, rates of organ failures, serious adverse reactions or infections in the ICU, length of ICU or hospital stay, or days alive without life support at 90 days. Conclusions: EGDN did not appear to affect physical quality of life at 6 months or other important outcomes as compared to standard nutrition care in acutely admitted, mechanically ventilated, adult ICU patients. Clinicaltrials.gov identifier no. NCT01372176.","author_count":13,"contributors":["Allingstrup, Matilde Jo","Kondrup, Jens","Wiis, Jørgen","Claudius, Casper","Pedersen, Ulf Gøttrup","Hein-Rasmussen, Rikke","Bjerregaard, Mads Rye","Steensen, Morten","Jensen, Tom Hartvig","Lange, Theis","Madsen, Martin Bruun","Møller, Morten Hylander","Perner, Anders"],"cuid":["S01-000.00-512425"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Clinical outcome","Critical care","Indirect calorimetry","Nutrition","Protein","Quality of Life"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"early goal directed nutrition versus standard of care in adult intensive care patients the single centre randomised outcome assessor blinded eat icu trial","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-512425","identifier":[{"id":"000412567400009","type":"wos"},{"id":"85029671501","type":"scopus"},{"id":"28936712","type":"pmid"}],"ids":["ku-c76073b2-6b59-49cf-86ae-bc2bc65e1c04"],"keyword":["Clinical outcome","Critical care","Indirect calorimetry","Nutrition","Protein","Quality of life"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-B85BE1060F642151620DAD60AFB4E44B"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Section of Biostatistics"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Matilde Jo","key":"allingstruppau","last":"Allingstrup","name":"Allingstrup, Matilde Jo","rank":1,"rolecode":"pau"},{"affno":"1","first":"Jens","key":"kondruppau","last":"Kondrup","name":"Kondrup, Jens","rank":2,"rolecode":"pau"},{"affno":"1","first":"Jørgen","key":"wiispau","last":"Wiis","name":"Wiis, Jørgen","rank":3,"rolecode":"pau"},{"affno":"1","first":"Casper","key":"claudiuspau","last":"Claudius","name":"Claudius, Casper","rank":4,"rolecode":"pau"},{"affno":"1","first":"Ulf Gøttrup","key":"pedersenpau","last":"Pedersen","name":"Pedersen, Ulf Gøttrup","rank":5,"rolecode":"pau"},{"affno":"1","first":"Rikke","key":"heinrasmussenpau","last":"Hein-Rasmussen","name":"Hein-Rasmussen, Rikke","rank":6,"rolecode":"pau"},{"affno":"","first":"Mads Rye","key":"bjerregaardpau","last":"Bjerregaard","name":"Bjerregaard, Mads Rye","rank":7,"rolecode":"pau"},{"affno":"1","first":"Morten","key":"steensenpau","last":"Steensen","name":"Steensen, Morten","rank":8,"rolecode":"pau"},{"affno":"1","first":"Tom Hartvig","key":"jensenpau","last":"Jensen","name":"Jensen, Tom Hartvig","rank":9,"rolecode":"pau"},{"affno":"2","first":"Theis","key":"langepau","last":"Lange","locid":"e4664578-01fc-4a93-8efd-1dbffb72cdd6","name":"Lange, Theis","orcid":"0000-0001-6807-8347","rank":10,"rolecode":"pau"},{"affno":"","first":"Martin Bruun","key":"madsenpau","last":"Madsen","name":"Madsen, Martin Bruun","rank":11,"rolecode":"pau"},{"affno":"2","first":"Morten Hylander","key":"møllerpau","last":"Møller","locid":"9463b017-3c43-470d-b95b-cf3cba8a27d4","name":"Møller, Morten Hylander","rank":12,"rolecode":"pau"},{"affno":"2","first":"Anders","key":"pernerpau","last":"Perner","locid":"8a389541-d529-4ee3-8364-66bfc85f77c9","name":"Perner, Anders","rank":13,"rolecode":"pau"}],"pmid":["28936712"],"pub":{"doi":"10.1007/s00134-017-4880-3","issn":["03424642","09351701"],"issn_org":["03424642"],"issue":"11","journal":"Intensive Care Medicine","pages":"1637-1647","status":"p","title":"Intensive Care Medicine","volume":"43"},"review":"Peer Reviewed","scoID":["2-s2.0-85029671501"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-c76073b2-6b59-49cf-86ae-bc2bc65e1c04"],"src":["KU University of Copenhagen"],"title":"Early goal-directed nutrition versus standard of care in adult intensive care patients : the single-centre, randomised, outcome assessor-blinded EAT-ICU trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-512425","year":"2017","yearsub":"2017"}
{"abstract":"Background and aim: Normal articulation before school start is a main objective in cleft palate treatment. The aim was to investigate if differences exist in consonant proficiency at age 5 years between children with unilateral cleft lip and palate (UCLP) randomised to different surgical protocols for primary palatal repair. A secondary aim was to estimate burden of care in terms of received additional secondary surgeries and speech therapy. Design: Three parallel group, randomised clinical trials were undertaken as an international multicentre study by 10 cleft teams in five countries: Denmark, Finland, Norway, Sweden, and the UK. Methods: Three different surgical protocols for primary palatal repair were tested against a common procedure in the total cohort of 448 children born with non-syndromic UCLP. Speech audio- and video-recordings of 391 children (136 girls and 255 boys) were available and transcribed phonetically. The main outcome measure was Percent Consonants Correct (PCC) from blinded assessments. Results: In Trial 1, arm A showed statistically significant higher PCC scores (82%) than arm B (78%) (p = .045). No significant differences were found between prevalences in Trial 2, A: 79%, C: 82%; or Trial 3, A: 80%, D: 85%. Across all trials, girls achieved better PCC scores, excluding s-errors, than boys (91.0% and 87.5%, respectively) (p = .01). Conclusions: PCC scores were higher in arm A than B in Trial 1, whereas no differences were found between arms in Trials 2 or 3. The burden of care in terms of secondary pharyngeal surgeries, number of fistulae, and speech therapy visits differed. Trial registration: ISRCTN29932826. Keywords: Primary palatal repair, unilateral cleft lip and palate, consonant proficiency, cleft speech characteristics, randomised clinical trial","author_count":28,"contributors":["Willadsen, Elisabeth","Persson, Christina","Lohmander, Anette","Lundeborg, Inger","Alaluusua, Suvi","Aukner, Ragnhild","Bau, Anja","Boers, Maria","Bowden, Melanie","Davies, Julie","Emborg, Berit","Havstam, Christina","Henningsson, Gunilla","Holmefjord, Anders","Hölttä, Elina","Kisling-Møller, Mia","Kjøll, Lillian","Lundberg, Maria","McAleer, Eilish","Nyberg, Jill","Paaso, Marjukka","Pedersen, Nina Helen","Rasmussen, Therese","Reisæter, Sigvor","Søgaard Andersen, Helene","Schöps, Antje","Tørdal, Inger-Beate","Semb, Gunvor"],"cuid":["S01-000.00-544406"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Sweden"],"glorg":["All Global Affiliations","Karolinska Institutet","Linköping University","University of Gothenburg"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the scandcleft randomised controlled trials speech outcomes in 000000000005 year olds with uclp consonant proficiency and errors","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-544406","ids":["ku-fcf28e3a-8537-4399-8e5d-a45a82be1da7"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-4AC4BAB6663729499D56FB2EF8ACD98C"],"oai":{"class":"Unused","mra":["Humanities (HUM)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Humanities, Department of Nordic Studies and Linguistics"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"se","key":"university of gothenburg","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"University of Gothenburg","used":1},{"affno":"3","country":"se","key":"karolinska institutet