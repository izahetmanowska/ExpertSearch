{"abstract":"I bidraget beskrives hulbæltet fra Rødbyhavn på Lolland. Via analyser af topografiske forhold samt arkæologiske kilder gives der et bud på forsvarsværkets strategiske betydning i det lokale jernaldermiljø.","author_count":5,"contributors":["Rasmussen, Anders","Høhling Søsted, Kasper","Westen, Brian"],"cuid":["S01-000.00-749666"],"filters":{"added":"2024-08","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Arkæologi","Hulbælte","Jernalder"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV"],"level3":{"GV":["DI-GV-ALL","DI-GV-KUM"]},"level3all":["DI-GV-KUM"]},"review":"pr","rtype":["clu"],"sorti":"strandholm","src":["kum"],"src-code":["DI-GV-KUM"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-749666","ids":["kum-61fa14ad-0272-4735-8251-cb935ce9fa34"],"keyword":["Hulbælte","Syltholm","arkæologi","jernalder"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-FD4218F8DE47F56013DC854C2BCFA51F"],"org":[{"affno":"1","key":"kum ministry of culture archives museums and royal library denmark","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-KUM","l3nn":"KUM Ministry of Culture - Archives, Museums, and Royal Library Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KUM Ministry of Culture - Archives, Museums, and Royal Library Denmark","namevar":["Ministry of Culture Denmark, Museum Lolland-Falster"],"nora_code":"DI-GV-KUM","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Anders","key":"rasmussenpau","last":"Rasmussen","locid":"831558a0-727f-45a9-bbbb-8f8b30058802","name":"Rasmussen, Anders","orcid":"0000-0002-6769-9122","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kasper","key":"høhlingsøstedpau","last":"Høhling Søsted","locid":"48bdfb11-fd18-4391-bebf-3cbe83827d8b","name":"Høhling Søsted, Kasper","orcid":"0000-0003-3115-9199","ra