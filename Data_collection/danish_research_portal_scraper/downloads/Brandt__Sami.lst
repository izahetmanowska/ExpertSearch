d83-4d11-ad65-3e183ca401f2","name":"Nielsen, Mads","orcid":"0000-0003-1535-068X","rank":2,"rolecode":"pau"},{"affno":"2","first":"Sami S.","key":"brandtpau","last":"Brandt","name":"Brandt, Sami S.","rank":3,"rolecode":"pau"},{"affno":"","first":"Bjoern","key":"menzepedh","last":"Menze","name":"Menze, Bjoern","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Georg","key":"langspedh","last":"Langs","name":"Langs, Georg","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Zhuowen","key":"tupedh","last":"Tu","name":"Tu, Zhuowen","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Antonio","key":"criminisipedh","last":"Criminisi","name":"Criminisi, Antonio","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-642-18421-5_1","eisbn":["9783642184215"],"isbn":["9783642184208"],"issn":["03029743"],"pages":"1-10","publisher":"Springer","series":"Lecture notes in computer science","status":"p","subtitle":"International MICCAI Workshop, MCV 2010, Beijing, China, September 20, 2010, Revised Selected Papers","title":"Medical Computer Vision. Recognition Techniques and Applications in Medical Imaging"},"review":"Peer Reviewed","scoID":["2-s2.0-79951597009"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Other Companies","Private Research","Universities","University of Copenhagen","synarc imaging technol. a/s (biz)"],"PST":["Published"]},"sid":["ku-33971000-4135-4016-bdfc-d05e7c7d40d1"],"src":["KU University of Copenhagen"],"title":"Conditional point distribution models","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-424116","year":"2011","yearsub":"2012"}
{"abstract":"We have developed a breast coordinate system that is based on breast anatomy to register female breasts into a common coordinate frame in 2D mediolateral (ML) or mediolateral oblique (MLO) view mammograms. The breasts are registered according to the location of the pectoral muscle and the nipple and the shape of the breast boundary because these are the most robust features independent of the breast size and shape. On the basis of these landmarks, we have constructed a nonlinear mapping between the parameter frame and the breast region in the mammogram. This mapping makes it possible to identify the corresponding positions and orientations among all of the ML or MLO mammograms, which facilitates an implicit use of the registration, i.e., no explicit image warping is needed. We additionally show how the coordinate transform can be used to extract Gaussian derivative features so that the feature positions and orientations are registered and extracted without non-linearly deforming the images. We use the proposed breast coordinate transform in a cross-sectional breast cancer risk assessment study of 490 women, in which we attempt to learn breast cancer risk factors from mammograms that were taken prior to when the breast cancer became visible to a radiologist. The coordinate system provides both the relative position and orientation information on the breast region from which the features are derived. In addition, the coordinate system can be used in temporal studies to pin-point anatomically equivalent locations between the mammograms of each woman and among the mammograms of all of the women in the study. The results of the cross-sectional study show that the classification into cancer and control groups can be improved by using the new coordinate system, compared to other systems evaluated. Comparisons were performed using the area-under-the-receiveroperating- characteristic-curve (AUC) score. In general, the new coordinate system makes an accurate anatomical registration of breasts possible, which suggests its wide applicability wherever 2D mammogram registration is required.","author_count":4,"contributors":["Brandt, Sami","Karemore, Gopal","Karssemeijer, Nico","Nielsen, Mads"],"cuid":["S01-000.00-500091"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Netherlands"],"glorg":["All Global Affiliations","Radboud University Nijmegen"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-PR-OTH","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"an anatomically oriented breast coordinate system for mammogram analysis","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-500091","identifier":[{"id":"80053522318","type":"scopus"},{"id":"21609879","type":"pmid"}],"ids":["ku-b2a2a989-1495-453d-88f6-ca02ebd2ed78"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-6335332CE2518C227902E825D85FD06C"],"org":[{"affno":"1","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["Synarc Imaging Technol. A/S (Biz)"],"nora_code":"DI-PR-OTH","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Protein Research, Protein Imaging Platform","Københavns Universitet, Faculty of Science, Department of Computer Science"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"nl","key":"radboud university nijmegen","loc":["Netherlands","Europe, EU","OECD"],"name":"Radboud University Nijmegen","used":1}],"person":[{"affno":"1","first":"Sami","key":"brandtpau","last":"Brandt","name":"Brandt, Sami","rank":1,"rolecode":"pau"},{"affno":"1 2","country":"dk","first":"Gopal","key":"karemorepau","last":"Karemore","locid":"18dfab69-e5f5-4046-9acf-396fa0227572","name":"Karemore, Gopal","orcid":"0000-0002-7285-0624","rank":2,"rolecode":"pau"},{"affno":"3","first":"Nico","key":"karssemeijerpau","last":"Karssemeijer","name":"Karssemeijer, Nico","rank":3,"rolecode":"pau"},{"affno":"1 2","first":"Mads","key":"nielsenpau","last":"Nielsen","locid":"52f8d6fb-fd83-4d11-ad65-3e183ca401f2","name":"Nielsen, Mads","orcid":"0000-0003-1535-068X","rank":4,"rolecode":"pau"}],"pmid":["21609879"],"pub":{"doi":"10.1109/tmi.2011.2155082","issn":["02780062","1558254X"],"issn_org":["02780062"],"issue":"10","journal":"IEEE Transactions on Medical Imaging","pages":"1841-1851","status":"p","title":"IEEE Transactions on Medical Imaging","title_org":"I E E E Transactions on Medical Imaging","volume":"30"},"review":"Peer Reviewed","scoID":["2-s2.0-80053522318"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Other Companies","Private Research","Universities","University of Copenhagen","synarc imaging technol. a/s (biz)"],"PST":["Published"]},"sid":["ku-b2a2a989-1495-453d-88f6-ca02ebd2ed78"],"src":["KU University of Copenhagen"],"title":"An anatomically oriented breast coordinate system for mammogram analysis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-500091","year":"2011","yearsub":"2011"}
{"abstract":"Purpose: Textural characteristics of the breast tissue structure on mammogram have been shown to improve breast cancer risk assessment in several large studies. Currently, however, the texture is not used to assess risk in standard clinical procedures or involved in general breast cancer risk assessment tools such as Wolfe Patterns (Wolfe et al 1997), Tabar Patterns (Tabar et al 1982), radiologist’s categorical scorings Breast Imaging Report and Data System® (BIRADS) (ACR 2003), and computer-assisted planimetric measures of area percentage dense tissue (Byng et al 1994). Moreover, these tools rely on a radiologist’s assessment of mammographic appearance that makes it more vulnerable to false negative rate due to observational oversights and varying experience. In addition, these tools are not fully automatic that reduces the workflow efficiency in large screening studies. In this work, we have investigated a fully automatic and robust risk assessment tool that can take not just the density but also the texture and heterogeneity of the breast tissue into account. By the use of computerized pattern recognition and machine learning techniques, the local texture may be scored for disposition of breast cancer development. We additionally evaluate to which degree the local texture can be recognized to distinguish high risk patients and whether the derived information increases the power of categorical and/or planimetric density scoring. Materials and Methods Our cross-sectional case-control study (Otten et al, 2005) includes mammograms (MLO view) of 245 patients diagnosed with breast cancer in the subsequent 2-4 years (123 interval and 122 screen detected cancers) and 250 matched controls. We use the state-of-the-art anatomical breast coordinate system (Brandt et al, submitted) where every pixel location is represented by geodesic distance from nipple and parametric angle, instead of x and y in traditional Cartesian coordinate system within a breast coordinate system, thus locale tissue orientation is compared more accurately (G. Karemore et al, 2010). For every pixel, a collection of multi-scale Gaussian derivative features are extracted in addition to the anatomical locations. Textural information is captured by the Gaussian derivatives and they are used for scoring the mammograms. The scoring includes feature extraction, feature selection, classification and committee learning, as described in detail by Brandt et al (submitted) and Raundahl et al (2008). Result: The performance of the proposed imaging marker was compared with various radiologist assisted scoring by area under ROC curve as shown in Table 1 and Fig. 1. Our proposed BC measure showed the maximum area under the ROC curve of 0.64, which is statistically significant and different than other methods (P<0.001, De Long test). Conclusion: The proposed fully automatic framework is reproducible and more indicative of breast cancer risk than radiologist’s or computerized density scoring and is also independent from breast density. In future, further validation on other studies should show its general applicability and usefulness in clinical practice. Clinical trials validation in further studies may improve its general applicability and development. Keywords: Breast cancer, Imaging marker, Automatic risk scoring.","author_count":4,"contributors":["Karemore, Gopal","Brandt, Sami","Karssemeijer, N","Nielsen, Mads"],"cuid":["S01-000.00-527672"],"event":{"end":"2011-03-07","place":"Wien, at","start":"2011-03-03","title":"European Congress of Radiology","year":"2011"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Netherlands"],"glorg":["All Global Affiliations","Nijmegen Institute of Radiology"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-NBIO"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-PR-NBIO","DI-U-KU"]},"review":"nr","rtype":["clu"],"sorti":"automatic breast cancer risk assessment from digital mammograms","src":["ku"],"src-code":["DI-U-KU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://ebookbrowse.com/gdoc.php?id=426289303&url=f9efd5acd98aeac93b4a77ad040ed1da","version":"Other Version"},"id":"S01-000.00-527672","ids":["ku-e0ac34cc-7e67-4739-9a22-72376285e159"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-3E15BE9FB662842145E60943CA22C4D3"],"oa_link":[{"access":"oa","type":"rem","url":"http://ebookbrowse.com/gdoc.php?id=426289303&url=f9efd5acd98aeac93b4a77ad040ed1da","version":"Other Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"nordic bioscience","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-NBIO","l3nl":"Nordic Bioscience","l3nn":"Nordic Bioscience","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Nordic Bioscience","namevar":["Nordic Bioscience"],"nora_code":"DI-PR-NBIO","used":1},{"affno":"3","country":"nl","key":"nijmegen institute of radiology","loc":["Netherlands","Europe, EU","OECD"],"name":"Nijmegen Institute of Radiology","used":1}],"person":[{"affno":"1","country":"dk","first":"Gopal Raghunath","key":"karemorepau","last":"Karemore","locid":"18dfab69-e5f5-4046-9acf-396fa0227572","name":"Karemore, Gopal","name_org":"Karemore, Gopal Raghunath","orcid":"0000-0002-7285-0624","rank":1,"rolecode":"pau"},{"affno":"2","first":"Sami","key":"brandtpau","last":"Brandt","name":"Brandt, Sami","rank":2,"rolecode":"pau"},{"affno":"3","first":"N","key":"karssemeijerpau","last":"Karssemeijer","name":"Karssemeijer, N","rank":3,"rolecode":"pau"},{"affno":"1","first":"Mads","key":"nielsenpau","last":"Nielsen","locid":"52f8d6fb-fd83-4d11-ad65-3e183ca401f2","name":"Nielsen, Mads","orcid":"0000-0003-1535-068X","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Nordic Bioscience","Private Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-e0ac34cc-7e67-4739-9a22-72376285e159"],"src":["KU University of Copenhagen"],"title":"Automatic breast cancer risk assessment from digital mammograms","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-527672","year":"2011","yearsub":"2012"}
