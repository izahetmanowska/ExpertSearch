815","rank":1,"rolecode":"pau"},{"affno":"1","first":"Katrine Hommelhoff","key":"jensenpau","last":"Jensen","locid":"379a4286-880b-4b99-8477-03f060d742a5","name":"Jensen, Katrine Hommelhoff","rank":2,"rolecode":"pau"},{"affno":"1","first":"Francois Bernard","key":"lauzepau","last":"Lauze","locid":"c35bebfd-2867-480d-8bd6-832d9aacbb8a","name":"Lauze, Francois Bernard","orcid":"0000-0003-2503-6475","rank":3,"rolecode":"pau"},{"affno":"","first":"Kyoung Mu","key":"leepedh","last":"Lee","name":"Lee, Kyoung Mu","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Yasuyuki","key":"matsushitapedh","last":"Matsushita","name":"Matsushita, Yasuyuki","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"James M.","key":"rehgpedh","last":"Rehg","name":"Rehg, James M.","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Zhanyi","key":"hupedh","last":"Hu","name":"Hu, Zhanyi","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-642-37447-0_18","eisbn":["9783642374470"],"isbn":["9783642374463"],"issn":["03029743"],"pages":"231-242","publisher":"Springer","series":"Lecture notes in computer science","status":"p","subtitle":"11th Asian Conference on Computer Vision, Daejeon, Korea, November 5-9, 2012, Revised Selected Papers, Part IV","title":"Computer Vision – ACCV 2012"},"review":"Peer Reviewed","scoID":["2-s2.0-84875909788"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-6e94c416-4aaa-4525-9e0b-c5b42cf0d4a9"],"src":["KU University of Copenhagen"],"title":"Bayesian epipolar geometry estimation from tomographic projections","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-459507","year":"2013","yearsub":"2013"}
{"abstract":"This paper proposes a prioritized matching approach for finding corresponding points in multiple calibrated images for multi-view stereo reconstruction. The approach takes a sparse set of seed matches between pairs of views as input and then propagates the seeds to neighboring regions by using a prioritized matching method which expands the most promising seeds first. The output of the method is a three-dimensional point cloud. Unlike previous correspondence growing approaches our method allows to use the best-first matching principle in the generic multi-view stereo setting with arbitrary number of input images. Our experiments show that matching the most promising seeds first provides very robust point cloud reconstructions efficiently with just a single expansion step. A comparison to the current state-of-the-art shows that our method produces reconstructions of similar quality but significantly faster.","author_count":5,"contributors":["Ylimaki, Markus","Kannala, Juho","Holappa, Jukka","Heikkilä, Janne","Brandt, Sami Sebastian"],"cuid":["S01-000.00-424279"],"event":{"acronym":"ICPR","end":"2012-11-15","place":"Tsukuba Science City, jp","start":"2012-11-11","title":"21st International Conference on Pattern Recognition","year":"2012"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Accuracy","Calibration","Cameras","Computer vision","Educational institutions","Image reconstruction","Robustness","Stereo image processing","Surface reconstruction","image matching"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"robust and accurate multi view reconstruction by prioritized matching","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://ieeexplore.ieee.org/xpl/freeabs_all.jsp?arnumber=6460716&abstractAccess=no&userType=inst","version":"Other Version"},"id":"S01-000.00-424279","identifier":[{"id":"84874572142","type":"scopus"}],"ids":["ku-33dbab30-3c1d-44a2-bae8-f31e41325374"],"keyword":["Accuracy","Cameras","Educational institutions","Robustness","Surface reconstruction","best-first matching principle","calibration","computer vision","generic multiview stereo setting","image matching","image reconstruction","multiple calibrated images","multiview stereo reconstruction","point cloud reconstructions","prioritized matching approach","seed match sparse set","stereo image processing","three-dimensional point cloud"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-6660CC01EE76CAFEAC64369066109860"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science","Københavns Universitet, Faculty of Science, Department of Computer Science, The Image Section"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Markus","key":"ylimakipau","last":"Ylimaki","name":"Ylimaki, Markus","rank":1,"rolecode":"pau"},{"affno":"","first":"Juho","key":"kannalapau","last":"Kannala","name":"Kannala, Juho","rank":2,"rolecode":"pau"},{"affno":"","first":"Jukka","key":"holappapau","last":"Holappa","name":"Holappa, Jukka","rank":3,"rolecode":"pau"},{"affno":"","first":"Janne","key":"heikkiläpau","last":"Heikkilä","name":"Heikkilä, Janne","rank":4,"rolecode":"pau"},{"affno":"1","first":"Sami Sebastian","key":"brandtpau","last":"Brandt","locid":"16b4d290-9775-4705-8e06-382641f16444","name":"Brandt, Sami Sebastian","orcid":"0000-0003-2141-9815","rank":5,"rolecode":"pau"}],"pub":{"isbn":["9781467322164"],"pages":"2673-2676","publisher":"IEEE","status":"p","title":"2012 21st International Conference on Pattern Recognition (ICPR)"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-33dbab30-3c1d-44a2-bae8-f31e41325374"],"src":["KU University of Copenhagen"],"title":"Robust and accurate multi-view reconstruction by prioritized matching","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-424279","year":"2012","yearsub":"2012"}
{"abstract":"We present a fully automated framework for scoring a patients risk of cardiovascular disease (CVD) and mortality from a standard lateral radiograph of the lumbar aorta. The framework segments abdominal aortic calcifications for computing a CVD risk score and performs a survival analysis to validate the score. Since the aorta is invisible on X-ray images, its position is reasoned from (1) the shape and location of the lumbar vertebrae and (2) the location, shape, and orientation of potential calcifications. The proposed framework follows the principle of Bayesian inference, which has several advantages in the complex task of segmenting aortic calcifications. Bayesian modeling allows us to compute CVD risk scores conditioned on the seen calcifications by formulating distributions, dependencies, and constraints on the unknown parameters. We evaluate the framework on two datasets consisting of 351 and 462 standard lumbar radiographs, respectively. Promising results indicate that the framework has potential applications in diagnosis, treatment planning, and the study of drug effects related to CVD.","author_count":7,"contributors":["Petersen, Peter Kersten","Ganz, Melanie","Mysling, Peter","Nielsen, Mads","Erleben, Lene Lillemark","Crimi, Alessandro","Brandt, Sami Sebastian"],"cuid":["S01-000.00-530761"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-NBIO","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-PR-NBIO","DI-PR-OTH","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"a bayesian framework for automated cardiovascular risk scoring on standard lumbar radiographs","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-530761","identifier":[{"id":"84857991479","type":"scopus"}],"ids":["ku-e5f49105-2450-4f78-bf48-a00fd297cfcc"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-9C197366538EA22FED7DCF1FD70691D4"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"nordic bioscience","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-NBIO","l3nl":"Nordic Bioscience","l3nn":"Nordic Bioscience","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Nordic Bioscience","namevar":["Nordic Bioscience"],"nora_code":"DI-PR-NBIO","used":1},{"affno":"3","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["Synarc Imaging Technol. A/S (Biz)"],"nora_code":"DI-PR-OTH","used":1}],"person":[{"affno":"1","country":"dk","first":"Peter Kersten","key":"petersenpau","last":"Petersen","locid":"23b8fde0-51e9-43d6-b89c-40300ada67a7","name":"Petersen, Peter Kersten","rank":1,"rolecode":"pau"},{"affno":"1","first":"Melanie","key":"ganzpau","last":"Ganz","locid":"a0225c8e-a6e9-4116-a301-a65b1d7a7b5b","name":"Ganz, Melanie","orcid":"0000-0002-9120-8098","rank":2,"rolecode":"pau"},{"affno":"1","first":"Peter","key":"myslingpau","last":"Mysling","locid":"f07749fa-c5e6-45f7-9d3c-485d27b2788c","name":"Mysling, Peter","rank":3,"rolecode":"pau"},{"affno":"1 2 3","first":"Mads","key":"nielsenpau","last":"Nielsen","locid":"52f8d6fb-fd83-4d11-ad65-3e183ca401f2","name":"Nielsen, Mads","orcid":"0000-0003-1535-068X","rank":4,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Lene Lillemark","key":"erlebenpau","last":"Erleben","locid":"0e3ad371-b61c-4c7c-b26c-605c583bbb40","name":"Erleben, Lene Lillemark","rank":5,"rolecode":"pau"},{"affno":"1","first":"Alessandro","key":"crimipau","last":"Crimi","locid":"da1d3a06-e1ca-491f-a5d5-c5942cdb337d","name":"Crimi, Alessandro","rank":6,"rolecode":"pau"},{"affno":"2 3","first":"Sami Sebastian","key":"brandtpau","last":"Brandt","name":"Brandt, Sami Sebastian","rank":7,"rolecode":"pau"}],"pub":{"doi":"10.1109/tmi.2011.2174646","issn":["02780062","1558254X"],"issn_org":["02780062"],"issue":"3","journal":"IEEE Transactions on Medical Imaging","pages":"663-676","status":"p","title":"IEEE Transactions on Medical Imaging","title_org":"I E E E Transactions on Medical Imaging","volume":"31"},"review":"Peer Reviewed","scoID":["2-s2.0-84857991479"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Nordic Bioscience","Other Companies","Private Research","Universities","University of Copenhagen","synarc imaging technol. a/s (biz)"],"PST":["Published"]},"sid":["ku-e5f49105-2450-4f78-bf48-a00fd297cfcc"],"src":["KU University of Copenhagen"],"title":"A Bayesian framework for automated cardiovascular risk scoring on standard lumbar radiographs","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-530761","year":"2012","yearsub":"2011"}
{"abstract":"We present a method for prediction of atherosclerotic growth based on a training set of 229 2D manually annotated baseline and corresponding follow-up calcifications from lateral X-ray images over an 8 year period. The prediction uses affine shape analysis based on singular value decomposition where non-rigid shapes are modeled as projections of rigid high-dimensional shapes. The SVD prediction was compared to growth based on dilation and predictive conditional PCA. The SVD model yields the largest Jaccard score indicating that the SVD model captures the most of the growth. We also found that small circular shapes grow the most which is likely due to the higher growth potential in smaller calcifications. Furthermore, we are able to predict the biological risk factors better by a joint shape and biology model that suggests a relationship between the shapes and the risk factors.","author_count":2,"contributors":["Erleben, Lene Lillemark","Brandt, Sami Sebastian"],"cuid":["S01-000.00-467212"],"event":{"end":"2011-04-02","place":"Chicago, us","start":"2011-03-30","title":"8th IEEE International Symposium on Biomedical Imaging","year":"2011"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-PR-OTH","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"prediction of growth based on shape analysis of atherosclerotic calcifications from lateral x ray images","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-467212","identifier":[{"id":"80055038193","type":"scopus"}],"ids":["ku-7b35b6d8-5e2e-40b2-a8ac-a000a48fb5c4"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-42E8FB8DBBDCDEA085B7593C892E1151"],"org":[{"affno":"1","key