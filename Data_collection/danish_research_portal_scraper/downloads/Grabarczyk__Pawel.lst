shed"]},"sid":["itu-735f2cd1-042b-47c8-9234-27e71b6d264e"],"src":["ITU IT University of Copenhagen"],"title":"Strategies for Unlocking Content in Nintendo Franchises","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382973","year":"2019","yearsub":"2019"}
{"abstract":"This book presents a new approach to semantics based on Kazimierz Ajdukiewicz’s Directival Theory of Meaning (DTM), which in effect reduces semantics of the analysed language to the combination of its syntax and pragmatics. The author argues that the DTM was forgotten because for many years philosophers didn’t have conceptual tools to appreciate its innovative nature, and that the theory was far ahead of its time. The book shows how a redesigned and modernised version of the DTM can deliver a new solution to the problem of defining linguistic meaning and that the theory can be understood as a new type of functional role semantics. The defining feature of the DTM is that it presents meaning as a product of constraints on the usage of words. According to the DTM meaning is not use, but the avoidance of misuse. Readers will see how the DTM was shelved for reasons that we don’t find so dramatic anymore, and how it contains enough original ideas and solutions to warrant developing it into a full-blown contemporary account. It is shown how many of the underlying ideas of the theory have been embraced later by philosophers and treated simply as brute facts about natural languages or even as new philosophical discoveries. Philosophers of language and researchers with an interest in how languages and the mind work will find this book a fascinating read.","author_count":1,"contributors":["Grabarczyk, Pawel"],"cuid":["S01-000.00-383847"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"keyword":["Contemporary Philosophy of Language","Directival Theory of Meaning","Functional Role Semantics","Innovative Linguistic Theory","Kazimierz Ajdukiewicz","Language Misuse","Linguistic Meaning Constraints","Philosophical Semantics","Semantics","Syntax and Pragmatics"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"directival theory of meaning from syntax and pragmatics to narrow linguistic content","src":["itu"],"src-code":["DI-U-ITU"],"type":"db","type-grp":["all","pub"]},"id":"S01-000.00-383847","ids":["itu-b0ddf0b9-ae8c-4db1-84ae-89894e8125b9"],"keyword":["Contemporary Philosophy of Language","Directival Theory of Meaning","Functional Role Semantics","Innovative Linguistic Theory","Kazimierz Ajdukiewicz","Language Misuse","Linguistic Meaning Constraints","Philosophical Semantics","Semantics","Syntax and Pragmatics"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-424CC192607DCC00DACE94A2D0E1A151"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Play, Culture, and AI, Games Research Group"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Pawel","key":"grabarczykpau","last":"Grabarczyk","locid":"42147e05-f94c-471d-a889-c57a01e4bdd0","name":"Grabarczyk, Pawel","orcid":"0000-0002-1268-7474","rank":1,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-030-18783-5","edition":"1","eisbn":["9783030187835"],"isbn":["9783030187811"],"issn":["01666991"],"pages":"238","publisher":"Springer","series":"Synthese Library","status":"p","volume":"409"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-b0ddf0b9-ae8c-4db1-84ae-89894e8125b9"],"src":["ITU IT University of Copenhagen"],"title":"Directival Theory of Meaning : From Syntax and Pragmatics to Narrow Linguistic Content","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383847","year":"2019","yearsub":"2019"}
{"abstract":"In this paper we investigate the phenomenon colloquially known as “loot boxes”. Loot boxes became a hot topic towards the end of 2017 when several legislative bodies proposed that they were essentially gambling mechanisms and should therefore be legislated as such. We argue that the term “loot box” and the phenomena it covers are not sufficiently precise for academic use, and instead introduce the notion of “random reward mechanisms” (RRMs). We offer a categorization of RRMs, which distinguishes between RRMs that are either “isolated” from real-world economies or “embedded” in them. This distinction will be useful in discussions about loot boxes in general, but specifically when it comes to the question of whether or not they represent instances of gambling. We argue that all classes of RRMs have gambling-like features, and may be problematic in different ways, but that only one class can be considered to be genuine gambling.","author_count":2,"contributors":["Nielsen, Rune Kristian Lundedal","Grabarczyk, Pawel"],"cuid":["S01-000.00-677296"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Addiction","Classification","Gambling","In game purchases","Internet gaming disorder","Loot boxes","Microtransactions","Taxonomy","disorder gaming","loot crates","random reward mechanisms"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"are loot boxes gambling random reward mechanisms in video games","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://pure.itu.dk/ws/files/84838627/Nielsen_Grabarczyk_2019_._Are_Loot_Boxes_Gambling_Random_reward_mechanisms_in_video_games.pdf","version":"Published Version"},"id":"S01-000.00-677296","ids":["itu-01077f79-d860-4c26-aacc-28635fadd2db"],"keyword":["addiction","classification","disorder gaming","gambling","in-game purchases","internet gaming disorder","loot boxes","loot crates","microtransactions","random reward mechanisms","taxonomy"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-6865E7412D32D461DFA6270DA1032240"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://pure.itu.dk/ws/files/84838627/Nielsen_Grabarczyk_2019_._Are_Loot_Boxes_Gambling_Random_reward_mechanisms_in_video_games.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Digital Play","IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Rune Kristian Lundedal","key":"nielsenpau","last":"Nielsen","locid":"80784458-06f6-4eff-b0c8-df982ffa9835","name":"Nielsen, Rune Kristian Lundedal","orcid":"0000-0002-7209-9041","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Pawel","key":"grabarczykpau","last":"Grabarczyk","locid":"42147e05-f94c-471d-a889-c57a01e4bdd0","name":"Grabarczyk, Pawel","orcid":"0000-0002-1268-7474","rank":2,"rolecode":"pau"}],"pub":{"issn":["23289422"],"journal":"Transactions of the Digital Games Research Association","pages":"171-207","paperid":"6","status":"p","title":"Transactions of the Digital Games Research Association","volume":"4"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-01077f79-d860-4c26-aacc-28635fadd2db"],"src":["ITU IT University of Copenhagen"],"title":"Are Loot Boxes Gambling? : Random Reward Mechanisms in Video Games","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-677296","year":"2019","yearsub":"2019"}
{"abstract":"The paper is a polemic with Daniel Dennett’s account of memes presented in his latest book From Bacteria to Bach and Back: The Evolution of Minds. This latest attempt at explaining the idea of memes ties it to the recent advances in Artificial Intelligence and tries to show how the mechanism of meme transmission affected the birth of human intelligence (which Dennett calls “comprehension”). I argue that even though the new version of the theory is not without its merits, it comes with two fatal flaws. First of all, even though on the surface Dennett talks only about words, gestures signs etc., he seems to smuggle in an additional notion of linguistic meaning which remains unexplained. Second of all, he does not provide identity conditions for memes which makes the whole idea of their transmission completely vague.","author_count":1,"contributors":["Grabarczyk, Pawel"],"cuid":["S01-000.00-383382"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"keyword":["Artificial intelligence","Comprehension","Dennett","Meaning","Memes"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"can memes explain comprehension","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.26913/avant.2019.03.29","version":"Published Version"},"id":"S01-000.00-383382","identifier":[{"id":"85079881606","type":"scopus"}],"ids":["itu-8f79a697-69a7-4a09-b3e5-c64b9536e10d"],"keyword":["Dennett","artificial intelligence","comprehension","meaning","memes"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-C9AD2843DC855881833F68E968A0486E"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.26913/avant.2019.03.29","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://pure.itu.dk/ws/files/85540803/4.23_P_Grabarczyk_Can_memes_explain.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Play, Culture, and AI, Games Research Group"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Pawel","key":"grabarczykpau","last":"Grabarczyk","locid":"42147e05-f94c-471d-a889-c57a01e4bdd0","name":"Grabarczyk, Pawel","orcid":"0000-0002-1268-7474","rank":1,"rolecode":"pau"}],"pub":{"doi":"10.26913/avant.2019.03.29","issn":["20826710","2082758X"],"issn_org":["20826710"],"issue":"3","journal":"Avant: The Journal of the Philosophical-Interdisciplinary Vanguard","publisher":"The Centre for Philosophical Research","status":"p","title":"Avant: The Journal of the Philosophical-Interdisciplinary Vanguard","title_org":"AVANT. Trends in Interdisciplinary Studies","volume":"X"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-8f79a697-69a7-4a09-b3e5-c64b9536e10d"],"src":["ITU IT University of Copenhagen"],"title":"Can memes explain comprehension?","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383382","year":"2019","yearsub":"2019"}
{"abstract":"The notion of a “game port” appears in both: the popular discourse surrounding video games as well as the academic discourse. As pointed out in the literature, it is notoriously vague and often overlaps with other similar concepts, such as “conversion”. We show that the main reason for the murkiness of the notion of a “game port” is its close connection to the marketing narrative which changed during history. We argue, that despite the problematic nature of the concept of a “game port” it is indispensable in context such as game analysis and game preservation. For this reason, we propose a formal classification of different game versions suitable for future use in these selected contexts.","author_count":2,"contributors":["Grabarczyk, Pawel","Aarseth, Espen J."],"cuid":["S01-000.00-382658"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["adaption clone conversion port remaster reskin version"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"port or conversion an ontological framework for classifying game versions","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"http://www.digra.org/wp-content/uploads/digital-library/DiGRA_2019_paper_189.pdf","version":"Published Version"},"id":"S01-000.00-382658","ids":["itu-5cbd4a88-810f-4d15-968e-c22fc4ac9c7a"],"keyword":["adaption, clone, conversion, port, remaster, reskin, version"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-0E4373DACE3D5322213788086B20DE20"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"http://www.digra.org/wp-content/uploads/digital-library/DiGRA_2019_paper_189.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Pawel","key":"grabarczykpau","last":"Grabarczyk","locid":"42147e05-f94c-471d-a889-c57a01e4bdd0","name":"Grabarczyk, Pawel","orcid":"0000-0002-1268-7474","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Espen J.","key":"aarsethpau","last":"Aarseth","name":"Aarseth, Espen J.","rank":2,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-5cbd4a88-810f-4d15-968e-c22fc4ac9c7a"],"src":["ITU IT University of Copenhagen"],"title":"Port or conversion? An ontological framework for classifying game versions","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382658","year":"2018","yearsub":"2019"}
{"abstract":"The subfield of game ontology has seen many models and structural hierarchies, but few that actively build on each other, or even attempt comparisons. This paper introduces a meta-model, which in addition to being an ontological model of its own, also offers a method for comparison between competing or isolated models and concepts. It does so by treating games as mechanisms (Craver 2007) with multiple levels of description, and differentiates between four main layers of the game-mechanism. In the first part of the paper we present the model in detail. In the second part of the paper we show applications of the model - we present how some of the existing approaches to game ontology can be compared within it and how it can be used to describe two case examples: the ancient Egyptian funeral game Senet and the difference between game mechanics and game rules.","author_count":2,"contributors":["Grabarczyk, Pawel","Aarseth, Espen J."],"cuid":["S01-000.00-382824"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Game ontologies","Methodology","Ontology","games classification"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"an ontological meta model for games research","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85540747/4.19_An_Ontological_Meta_Model_for_Game_Resea.pdf","version":"Published Version"},"id":"S01-000.00-382824","ids":["itu-677cb5c1-54ca-4e16-a59d-94bd61e268dc"],"keyword":["Game ontologies","games classification","methodology","ontology"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-2958A8FC09255BE1E1939AB131B6E764"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85540747/4.19_An_Ontological_Meta_Model_for_Game_Resea.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Pawel","key":"grabarczykpau","last":"Grabarczyk","locid":"42147e05-f94c-471d-a889-c57a01e4bdd0","name":"Grabarczyk, Pawel","orcid":"0000-0002-1268-7474","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Espen J.","key":"aarsethpau","last":"Aarseth","name":"Aarseth, Espen J.","rank":2,"rolecode":"pau"}],"pub":{"issn":["23429666"],"journal":"Proceedings of the Digital Games Research Association","publisher":"Digital Games Research Association","status":"p","title":"Proceedings of the Digital Games Research Association","title_org":"Proceedings of the Digital Games Research Association (DiGRA)"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-677cb5c1-54ca-4e16-a59d-94bd61e268dc"],"src":["ITU IT University of Copenhagen"],"title":"An Ontological Meta-Model for Games Research","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382824","year":"2018","yearsub":"2018"}
{"abstract":"In this paper I try to look at two opposite ways that randomness is employed and, more importantly, evaluated in computer games. It seems fascinating that the same mathematical and statistical phenomenon could lay at the roots of some of the most acclaimed and despised design principles of contemporary games. On the face of it, this may not seem to be paradoxical at all as it could be argued to be true of many other objects and processes. After all, the same knife could be used to prepare a meal and to hurt people. What makes the case of randomness interesting however is that this connection between its heralded and criticized sides is never examined and that they are often treated as completely separate phenomena. One initial clarification that may be needed is that the paper does not cover instances in which randomness has been used only during production of the game. In other words – I am interested only in cases where random values and patterns appear during the game execution. To see this difference, think of any game which contains a map generated in random or partially random manner via some additional development tools, but where the game itself uses the map as a fixed asset. To use a concrete example, compare Just Cause 2 and Minecraft. The former contains a fixed map which has been (at least partially) procedurally generated by the developers (Blomberg 2013), the latter contains a map which is generated by the game itself, whenever it is started anew.","author_count":1,"contributors":["Grabarczyk, Pawel"],"cuid":["S01-000.00-381275"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"keyword":["Computer games","Design principles","Game Execution","Procedural Generation","Randomness"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"from rogue to lootboxes two faces of randomness in computer games","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85683598/4.21_Grabarczyk_From_rogue_to_lootboxes.pdf","version":"Published Version"},"id":"S01-000.00-381275","ids":["itu-0188e4c8-9b41-47cf-a479-beface5dd1fb"],"keyword":["Computer Games","Design Principles","Game Execution","Procedural Generation","Randomness"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-FCA6946F976341BE3854A1E2327FE234"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85683598/4.21_Grabarczyk_From_rogue_to_lootboxes.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Play, Culture, and AI, Games Research Group"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Pawel","key":"grabarczykpau","last":"Grabarczyk","locid":"42147e05-f94c-471d-a889-c57a01e4bdd0","name":"Grabarczyk, Pawel","orcid":"0000-0002-1268-7474","rank":1,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-0188e4c8-9b41-47cf-a479-beface5dd1fb"],"src":["ITU IT University of Copenhagen"],"title":"From Rogue to lootboxes: two faces of randomness in computer games","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381275","year":"2018","yearsub":"2019"}
{"abstract":"In this paper we investigate the phenomenon colloquially known as “loot boxes” or “loot crates”. Loot boxes became a hot topic towards the end of 2017 when several legislative bodies proposed that they were essentially gambling mechanisms and should therefore be legislated as such. We argue that the term “loot box” and the phenomena it covers are not sufficiently precise for academic use and instead introduce the notion of “random reward mechanisms” (RRMs). We offer a categorization of RRMs, which distinguishes between RRMs that are either “isolated” from real world economies or “embedded” in them. This distinction will be useful in discussions about loot boxes in general, but specifically when it comes to the question of whether or not they represent instances of gambling. We argue that all classes of RRMs have gambling-like features, but that only one class can be considered to be genuine gambling.","author_count":2,"contributors":["Nielsen, Rune Kristian Lundedal","Grabarczyk, Pawel"],"cuid":["S01-000.00-677334"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Addiction","Classification","Gambling","Gaming","Internet gaming disorder","Loot boxes","Taxonomy","loot crates","random reward mechanisms"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"are loot boxes gambling random reward mechanisms in video games","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83333144/DIGRA_2018_Are_loot_boxes_gambling_pre_print_21.05.2018.pdf","version":"Other Version"},"id":"S01-000.00-677334","ids":["itu-c42f7b9f-2c56-49a7-b3b0-d8eeb6f942f9"],"keyword":["Internet gaming disorder","addiction","classification","gambling","gaming","loot boxes","loot crates","random reward mechanisms","taxonomy"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-40E0411F52B7E0B0FF54D88A03FA483B"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83333144/DIGRA_2018_Are_loot_boxes_gambling_pre_print_21.05.2018.pdf","version":"Other Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Rune Kristian Lundedal","key":"nielsenpau","last":"Nielsen","locid":"80784458-06f6-4eff-b0c8-df982ffa9835","name":"Nielsen, Rune Kristian Lundedal","orcid":"0000-0002-7209-9041","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Pawel","key":"grabarczykpau","last":"Grabarczyk","locid":"42147e05-f94c-471d-a889-c57a01e4bdd0","name":"Grabarczyk, Pawel","orcid":"0000-0002-1268-7474","rank":2,"rolecode":"pau"}],"pub":{"publisher":"Digital Games Research Association","status":"p","subtitle":"The Game is the Message","title":"DiGRA '18 - Proceedings of the 2018 DiGRA International Conference"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-c42f7b9f-2c56-49a7-b3b0-d8eeb6f942f9"],"src":["ITU IT University of Copenhagen"],"title":"Are Loot Boxes Gambling? : Random reward mechanisms in video games","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-677334","year":"2018","yearsub":"2018"}
