niversities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-80709eb5-835a-486b-9dad-cd93fc116abc"],"src":["ITU IT University of Copenhagen"],"title":"Localizing Digitalization: New State Spaces and Local Resistances.","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-754077","year":"2018","yearsub":"2018"}
{"abstract":"Digital citizenship is becoming increasingly normalized within advanced democratic states. As society and governmental institutions become reliant on digital technologies, citizens are expected to be and act digitally. This article examines the governance of digital citizens through a case study of digitalization efforts in Denmark. Drawing on multiple forms of data, the article showcases how digital citizens are governed through a combination of discursive, legal and institutional means. The article highlights the political, but also institutional work that goes into making citizens digital. Providing this case study, the article contributes to current critical perspectives on the digital citizen as a new political figure. It adds new insights into digital citizenship by connecting this figure to wider processes of neoliberalization and state restructuring, pushing for a more pronounced focus on governmental practices.","author_count":2,"contributors":["Schou, Jannick","Hjelholt, Morten"],"cuid":["S01-000.00-384852"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Denmark","Digital Citizenship","Digitalization","Governance","Politics"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"digital citizenship and neoliberalization governing digital citizens in denmark","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83102405/accepted_manu_schouhjelholt.pdf","version":"Authors Final Version"},"id":"S01-000.00-384852","identifier":[{"id":"85047396606","type":"scopus"}],"ids":["itu-f3ac05ed-43f0-488b-81a5-2204474aac9a"],"keyword":["Denmark","Digital citizenship","digitalization","governance","politics"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-C6A579445583C1C685ED750C34421AC0"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83102405/accepted_manu_schouhjelholt.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Technologies in Practice, Technologies in Practice"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jannick","key":"schoupau","last":"Schou","name":"Schou, Jannick","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Morten","key":"hjelholtpau","last":"Hjelholt","locid":"10e4fc8e-556f-4104-b744-409caedc2276","name":"Hjelholt, Morten","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1080/13621025.2018.1477920","issn":["13621025","14693593"],"issn_org":["13621025"],"issue":"5","journal":"Citizenship Studies","pages":"507-522","publisher":"Routledge","status":"p","title":"Citizenship Studies"},"review":"Peer Reviewed","scoID":["2-s2.0-85047396606"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-f3ac05ed-43f0-488b-81a5-2204474aac9a"],"src":["ITU IT University of Copenhagen"],"title":"Digital citizenship and neoliberalization: governing digital citizens in Denmark","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384852","year":"2018","yearsub":"2018"}
{"author_count":2,"contributors":["Schou, Jannick","Hjelholt, Morten"],"cuid":["S01-000.00-754074"],"filters":{"added":"2024-09","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"cultural political economy","src":["itu"],"src-code":["DI-U-ITU"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-754074","ids":["itu-66cf6f1e-a670-47eb-8175-6fb1797868e1"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-EF8EF8D2B74D8ADB3E0D9DA6A5090546"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Digital Design, Design Research Section","IT University of Copenhagen, Digital Design, Digital Societies and Participation Section"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Jannick","key":"schoupau","last":"Schou","name":"Schou, Jannick","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Morten","key":"hjelholtpau","last":"Hjelholt","locid":"10e4fc8e-556f-4104-b744-409caedc2276","name":"Hjelholt, Morten","rank":2,"rolecode":"pau"}],"pub":{"pages":"21-37","publisher":"Palgrave Macmillan","status":"p","title":"Digitalization and Public Sector Transformations"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-66cf6f1e-a670-47eb-8175-6fb1797868e1"],"src":["ITU IT University of Copenhagen"],"title":"Cultural Political Economy","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-754074","year":"2018","yearsub":"2018"}
{"abstract":"This book provides a study of governmental digitalization, an increasingly important area of policymaking within advanced capitalist states. It dives into a case study of digitalization efforts in Denmark, fusing a national policy study with local institutional analysis. Denmark is often framed as an international forerunner in terms of digitalizing its public sector and thus provides a particularly instructive setting for understanding this new political instrument. Advancing a cultural political economic approach, Schou and Hjelholt argue that digitalization is far from a quick technological fix. Instead, this area must be located against wider transformations within the political economy of capitalist states. Doing so, the book excavates the political roots of digitalization and reveals its institutional consequences. It shows how new relations are being formed between the state and its citizens. Digitalization and Public Sector Transformations pushes for a renewed approach to governmental digitalization and will be of interest to scholars working in the intersections of critical political economy, state theory and policy studies.","author_count":2,"contributors":["Schou, Jannick","Hjelholt, Morten"],"cuid":["S01-000.00-383397"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Cultural Political Economy","Denmark","Digitalization","Policy","Public sector","State transformation"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"digitalization and public sector transformations","src":["itu"],"src-code":["DI-U-ITU"],"type":"db","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.palgrave.com/gp/book/9783319762906","version":"Other Version"},"id":"S01-000.00-383397","identifier":[{"id":"85048908117","type":"scopus"}],"ids":["itu-90d83859-3d29-4e2e-b0ab-90e65c94d423"],"keyword":["Cultural Political Economy","Denmark","Digitalization","Policy","Public sector","State transformation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-B051670AD458B10477370FA01CF2D6E6"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Technologies in Practice, Technologies in Practice"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jannick","key":"schoupau","last":"Schou","name":"Schou, Jannick","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Morten","key":"hjelholtpau","last":"Hjelholt","locid":"10e4fc8e-556f-4104-b744-409caedc2276","name":"Hjelholt, Morten","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-319-76291-3","eisbn":["9783319762913"],"isbn":["9783319762906"],"pages":"122","publisher":"Palgrave Macmillan","status":"p"},"review":"Peer Reviewed","scoID":["2-s2.0-85048908117"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-90d83859-3d29-4e2e-b0ab-90e65c94d423"],"src":["ITU IT University of Copenhagen"],"title":"Digitalization and Public Sector Transformations","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383397","year":"2018","yearsub":"2018"}
{"abstract":"This paper provides a historical analysis of the different moral economies that have accompanied the digitalization of the Danish welfare state, one of the leading nations worldwide in terms of ICT adoption. Adopting Fassin's (2005) use of the term moral economy, understood as \"the economy of the moral values and norms of a given group in a given moment\" (p. 365), we show how the digitalization of the Danish state has implied the invocation of particular normative claims as to the function, shape, and purpose of data-driven governance. Relying on archival research of policies, strategies and public statements, the paper shows how the moral economy has changed significantly from the 1970s and up until the present. In the 1970-1980s, digitalization was mainly conceived as a way of improving the internal efficiency in the public sector. From the 1990s, digitalization was awarded a much more prominent position, being seen as a way of renewing democracy by ensuring participation, transparency and inclusion of citizens. However, from 2001, economic efficiency, growth, and competitiveness have become the dominating moral claims attached to digitalization, replacing previous ideals with neoliberal beliefs. Digitalization has come to equal economic prosperity, and through the implementation of coercive laws, forcing citizens to adopt data-driven systems, new disciplinary practices have also emerged. The paper contributes with new insights into the moral and normative dimensions of data-driven governance, showing how data-driven governance is imminently a political project. Analysing the different moral economies emerging over time, the paper opens up a room for critical reflection on the contingent decision that have shaped and continues to steer digitalization.","author_count":2,"contributors":["Schou, Jannick","Hjelholt, Morten"],"cuid":["S01-000.00-383856"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Danish welfare state","Data Driven Governance","Digitalization","Moral economy","Normative Claims"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"the moral economy of the digital welfare state fostering efficiency and nurturing neoliberalism","src":["itu"],"src-code":["DI-U-ITU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82025510/DataPower_2017_Program.pdf","version":"Published Version"},"id":"S01-000.00-383856","ids":["itu-b1599c14-8a0e-405f-be6a-ae40f9db01d9"],"keyword":["Danish Welfare State","Data-Driven Governance","Digitalization","Moral Economy","Normative Claims"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-03EAA1A9ECD9F3D5D74230CAD7CA7E66"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82025510/DataPower_2017_Program.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Technologies in Practice, Technologies in Practice"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jannick","key":"schoupau","last":"Schou","name":"Schou, Jannick","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Morten","key":"hjelholtpau","last":"Hjelholt","locid":"10e4fc8e-556f-4104-b744-409caedc2276","name":"Hjelholt, Morten","rank":2,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-b1599c14-8a0e-405f-be6a-ae40f9db01d9"],"src":["ITU IT University of Copenhagen"],"title":"The moral economy of the digital welfare state: fostering efficiency and nurturing neoliberalism","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383856","year":"2017","yearsub":"2017"}
