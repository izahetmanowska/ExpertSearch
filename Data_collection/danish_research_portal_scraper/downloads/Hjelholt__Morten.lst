rsity of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-a78f2d1d-6ca5-456e-a0f0-153d1c3f43ed"],"src":["ITU IT University of Copenhagen"],"title":"Årsberetning for Det Centrale Handicapråd","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-754084","year":"2017","yearsub":"2017"}
{"abstract":"As governments worldwide become increasingly reliant on digital technologies and e-government, ‘digital citizenship’ has become an important topic for research and policy-makers alike. While often described as the contemporary ‘ideal’ of citizenship, research has tended to downplay the normative dimensions of digital citizenship. Counter to such depoliticized approaches, this article argues that the digital citizen is a deeply political figure. Through a discourse-theoretical analysis of Danish governmental digitalization strategies from 2002 to 2015, the article shows how these have relied on a very particular image of the digital citizen. More specifically, we showcase how this figure has reproduced neoliberal conceptions of subjectivity, concerned with efficiency, productivity, individualization and collective responsibilization. By shedding light on these novel links between neoliberal and digital citizenship, the article challenges current views on digitalization. The article foregrounds how digitalization serves to reproduce and recast already-existing political rationalities and must be considered in relation to neoliberal hegemony.","author_count":2,"contributors":["Schou, Jannick","Hjelholt, Morten"],"cuid":["S01-000.00-383050"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Citizenship","Denmark","Digitalization","Discourses","E government","Neoliberalism"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"digitalizing the welfare state citizenship discourses in danish digitalization strategies from 000000002002 to 000000002015","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/81979435/Post_Print_CriticalPolicyStudies.pdf","version":"Authors Final Version"},"id":"S01-000.00-383050","identifier":[{"id":"85019767424","type":"scopus"}],"ids":["itu-78c3cd35-68bb-4254-ba3b-8b1238a001df"],"keyword":["Citizenship","Denmark","digitalization","discourses","e-government","neoliberalism"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-5909A363C99659213A918F68B17ECBC6"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/81979435/Post_Print_CriticalPolicyStudies.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Technologies in Practice, Technologies in Practice"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jannick","key":"schoupau","last":"Schou","name":"Schou, Jannick","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Morten","key":"hjelholtpau","last":"Hjelholt","locid":"10e4fc8e-556f-4104-b744-409caedc2276","name":"Hjelholt, Morten","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1080/19460171.2017.1333441","issn":["19460171","1946018X"],"issn_org":["19460171"],"issue":"1","journal":"Critical Policy Studies","pages":"3-22","publisher":"Routledge","status":"p","title":"Critical Policy Studies","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-85019767424"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-78c3cd35-68bb-4254-ba3b-8b1238a001df"],"src":["ITU IT University of Copenhagen"],"title":"Digitalizing the welfare state: citizenship discourses in Danish digitalization strategies from 2002 to 2015","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383050","year":"2017","yearsub":"2017"}
