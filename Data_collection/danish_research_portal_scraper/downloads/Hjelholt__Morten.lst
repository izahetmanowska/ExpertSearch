rch?modus=sin&s=LOI:S02-099.50-029664","year":"2023","yearsub":"2023"}
{"author_count":1,"contributors":["Hjelholt, Morten"],"cuid":["S01-000.00-754070"],"filters":{"added":"2024-09","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"digital social capital the impact of digitalization in nordic welfare states","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-754070","ids":["itu-4da07e67-bdde-4f9f-9200-91798eaa21ff"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-A6989C8C285CBC07B845ABBEC2F32716"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Digital Design, Design Research Section","IT University of Copenhagen, Digital Design, Digital Societies and Participation Section"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Morten","key":"hjelholtpau","last":"Hjelholt","locid":"10e4fc8e-556f-4104-b744-409caedc2276","name":"Hjelholt, Morten","rank":1,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-4da07e67-bdde-4f9f-9200-91798eaa21ff"],"src":["ITU IT University of Copenhagen"],"title":"Digital social capital - The impact of digitalization in Nordic welfare states","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-754070","year":"2023","yearsub":"2023"}
{"abstract":"Purpose: Anticholinergic (AC) drugs are associated with various determinantal outcomes. Data regarding the effect of AC drugs on mortality among geriatric hip fracture patients are limited and inconsistent. Methods: Using Danish health registries, we identified 31,443 patients aged ≥65 years undergoing hip fracture surgery. AC burden was assessed 90 days before surgery by the Anticholinergic Cognitive Burden (ACB) score and number of AC drugs. Logistic and Cox regression producing odds ratios (OR) and hazard ratios (HR) for 30- and 365- day mortality, adjusting for age, sex, and comorbidities were computed. Results: AC drugs were redeemed by 42% of patients. The 30-day mortality increased from 7% for patients with ACB score of 0 to 16% for patients with ACB score of ≥5, corresponding to an adjusted OR 2.5 (CI: 2.0-3.1). The equivalent adjusted HR for 365-mortality was 1.9 (CI: 1.6-2.1). Using count of AC drugs as exposure we found a stepwise increase in ORs and HRs with increased number of AC drugs; Compared to non-users, adjusted ORs for 30-days mortality were 1.6 (CI: 1.4-1.7), 1.9 (CI: 1.7-2.1), and 2.3 (CI: 1.9-2.7) for users of 1, 2 and 3+ AC drugs. HRs for 365-day mortality were 1.4 (CI: 1.3-1.5), 1.6 (CI: 1.5-1.7) and 1.8 (CI: 1.7-2.0). Conclusion: Use of AC drugs was associated with increased 30-day and 365-day mortality among older adults with hip fracture. Simply counting the number of AC drugs may be a clinically relevant and easy AC risk assessment tool. Continued effort to reduce AC drug-use is relevant.","author_count":5,"contributors":["Birkmose, Anne Line Lund","Kristensen, Pia Kjær","Madsen, Morten","Pedersen, Alma Bečić","Hjelholt, Thomas Johannesson"],"cuid":["S02-097.67-723997"],"filters":{"added":"2023-07","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"corresponding_author":["Hjelholt, Thomas Johannesson"],"keyword":["Cholinergic Antagonists","Cumulative anticholinergic burden","Hip Fractures","Mortality","Older adults"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR","DI-HO-NDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-HO-CDR","DI-HO-NDR","DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"association of anticholinergic drug use with postoperative mortality among patients with hip fracture a nationwide cohort study","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.archger.2023.105017","version":"Published Version"},"id":"S02-097.67-723997","identifier":[{"id":"37116258","type":"pmid"},{"id":"85153373364","type":"scopus"}],"ids":["aau-01603d5a-fdc3-4183-950f-27b0b47b0472","au-9aaff92a-6a1b-4a3d-9ff6-d0b221566cda"],"keyword":["Cholinergic antagonists","Cumulative anticholinergic burden","Hip fractures","Mortality","Older adults"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-0B47AC05937A5AC54B11F5D9884D7393"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/551309222/1-s2.0-S0167494323000961-main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.archger.2023.105017","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.au.dk/ws/files/384476820/1-s2.0-S0167494323000961-main.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Neurology"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1},{"affno":"3","country":"dk","key":"north denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-NDR","l3nl":"North Denmark Region","l3nn":"North Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"North Denmark Region","namevar":["Aalborg University Hospital"],"nora_code":"DI-HO-NDR","used":1},{"affno":"4","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Clinical Epidemiology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1 2 3","corresponding":null,"first":"Anne Line Lund","key":"birkmosepau","last":"Birkmose","locid":"63342247-39ca-4f58-8142-3abd3d3fb718","name":"Birkmose, Anne Line Lund","rank":1,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Pia Kjær","key":"kristensenpau","last":"Kristensen","locid":"2e3de633-91bd-49d2-a141-cf7ac3f09190","name":"Kristensen, Pia Kjær","orcid":"0000-0001-5473-9386","rank":2,"rolecode":"pau"},{"affno":"4 2","corresponding":null,"country":"dk","first":"Morten","key":"madsenpau","last":"Madsen","locid":"7cd50d58-614a-4e57-8bf5-7dfb8ea22d56","name":"Madsen, Morten","orcid":"0000-0002-6036-8240","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Alma Bečić","key":"pedersenpau","last":"Pedersen","locid":"797cacd6-5e68-4aac-a0fa-db74425f732b","name":"Pedersen, Alma Becic","name_org":"Pedersen, Alma Bečić","orcid":"0000-0002-3288-9401","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Thomas Johannesson","key":"hjelholtpau","last":"Hjelholt","locid":"e22aa9dd-c881-4afe-a9cb-55a9f34bc851","name":"Hjelholt, Thomas Johannesson","orcid":"0000-0003-0112-5801","rank":5,"rolecode":"pau"}],"pmid":["37116258"],"pub":{"doi":"10.1016/j.archger.2023.105017","issn":["01674943","09247947"],"issn_org":["09247947"],"journal":"Archives of Gerontology and Geriatrics","pages":"105017","paperid":"105017","publisher":"Elsevier Ireland Ltd","publisher_org":"Elsevier Ireland Ltd.","status":"p","title":"Archives of Gerontology and Geriatrics","volume":"113"},"review":"Peer Reviewed","scoID":["2-s2.0-85153373364"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Universities"],"PST":["Published"]},"sid":["aau-01603d5a-fdc3-4183-950f-27b0b47b0472","au-9aaff92a-6a1b-4a3d-9ff6-d0b221566cda"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Association of anticholinergic drug use with postoperative mortality among patients with hip fracture. A nationwide cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-097.67-723997","year":"2023","yearsub":"2023"}
{"abstract":"BACKGROUND AND PURPOSE: Patients with hip fractures often have comorbidities, but detailed data on comorbidity and its impact on prognosis are lacking. We described the current trends in the prevalence of comorbidity and the magnitude of the associated mortality. PATIENTS AND METHODS: From the Danish Multidisciplinary Hip Fracture Registry we included 31,443 hip fracture patients (diagnosed in 2014-2018). We calculated the prevalence of individual diseases and comorbidity measured with the Charlson Comorbidity Index (CCI), the Elixhauser Index, and the Rx-Risk Index. We calculated sex and age-adjusted odds ratios (aORs) for 30-day mortality and hazard ratios (aHRS) for one-year mortality with 95% confidence intervals (CI). RESULTS: The most common diseases identified with the CCI were cerebrovascular diseases (18%), malignancies (17%), chronic pulmonary disease (14%), and dementia (11%). Using the Elixhauser Index, hypertension (37%), cardiac arrhythmias (21%), and fluid and electrolyte disorders (15%) were most prevalent, while ischemic heart disease (42%), hypertension (39%), and use of antiplatelets (37%) were most prevalent when using the Rx-Risk Index. Using the Rx-Risk Index, only 28% of patients had no comorbidity compared to 38% for CCI and 44% for the Elixhauser Index, and the prevalence was stable through the years. Compared to patients with no comorbidity, patients with very severe comorbidity had an aORs for 30-day mortality of 2.6 (CI: 2.4-2.9) using CCI, 2.6 (CI: 2.4-3.1) using the Elixhauser Index, and 3.1 (CI: 2.7-3.4) using the Rx-Risk Index. INTERPRETATION: More than 50% of the patients with hip fractures have moderate to very severe comorbidity, with considerable variation between indices. The prevalence of individual diseases varies considerably. All indices had comparable dose-response associations with mortality. These results are relevant for clinicians to amend prevention and target care, and for researchers to decide which comorbidity measure to use depending on the research question.","author_count":4,"contributors":["Kristensen, Pia Kjær","Hjelholt, Thomas Johannesson","Madsen, Morten","Pedersen, Alma Becic"],"cuid":["S01-000.00-682244"],"filters":{"added":"2023-09","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Kristensen, Pia Kjær"],"keyword":["Charlson Comorbidity Index","Comorbidity","Elixhauser Index","Hip fracture","Mortality"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"current trends in comorbidity prevalence and associated mortality in a population based cohort of hip fracture patients in denmark","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.2147/CLEP.S410055","version":"Published Version"},"id":"S01-000.00-682244","identifier":[{"id":"85165867927","type":"scopus"},{"id":"PMC10362880","type":"pmcid"},{"id":"37483261","type":"pmid"}],"ids":["au-206c302d-583e-4ae3-9c64-349b11e434af"],"keyword":["Charlson Comorbidity Index","Elixhauser Index","Rx-Risk","comorbidity","hip fracture","mortality"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-07726D40888B0469672030227BD17758"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.2147/CLEP.S410055","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Orthopaedic surgery"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Pia Kjær","key":"kristensenpau","last":"Kristensen","locid":"2e3de633-91bd-49d2-a141-cf7ac3f09190","name":"Kristensen, Pia Kjær","orcid":"0000-0001-5473-9386","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thomas Johannesson","key":"hjelholtpau","last":"Hjelholt","locid":"e22aa9dd-c881-4afe-a9cb-55a9f34bc851","name":"Hjelholt, Thomas Johannesson","orcid":"0000-0003-0112-5801","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Morten","key":"madsenpau","last":"Madsen","locid":"7cd50d58-614a-4e57-8bf5-7dfb8ea22d56","name":"Madsen, Morten","orcid":"0000-0002-6036-8240","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Alma B","key":"pedersenpau","last":"Pedersen","locid":"797cacd6-5e68-4aac-a0fa-db74425f732b","name":"Pedersen, Alma Becic","name_org":"Pedersen, Alma B","orcid":"0000-0002-3288-9401","rank":4,"rolecode":"pau"}],"pmid":["37483261"],"pub":{"doi":"10.2147/clep.s410055","issn":["11791349"],"journal":"Clinical Epidemiology","pages":"839-853","publisher":"Dove Medical Press Ltd","status":"p","title":"Clinical Epidemiology","title_org":"Clinical epidemiology","volume":"15"},"review":"Peer Reviewed","scoID":["2-s2.0-85165867927"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-206c302d-583e-4ae3-9c64-349b11e434af"],"src":["AU Aarhus University"],"title":"Current Trends in Comorbidity Prevalence and Associated Mortality in a Population-Based Cohort of Hip Fracture Patients in Denmark","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-682244","year":"2023","yearsub":"2023"}
{"abstract":"The digital transformation of welfare states is often celebrated for its potential to enhance service efficiency and accessibility. However, this shift carries significant, yet underexplored, social, and economic costs that disproportionately affect both local and global communities. This research seeks to uncover the hidden costs of digitalization in welfare states, illustrating how these changes can exacerbate existing inequalities and foster new forms of exclusion. Focusing primarily on the impact within the welfare states themselves, the analysis reveals how vulnerable populations may experience decreased access to crucial services due to digital barriers. Furthermore, the paper extends the analysis globally, demonstrating how the digitalization processes rely on, and sometimes exploit, international labor and resources, echoing the dynamics of externalization described by Stephan Lessenich in his critique of Western prosperity. By integrating theories of digital exclusion with global inequality frameworks, this research contributes to a more comprehensive understanding of the socio-economic repercussions of digital welfare practices and calls for a critical reevaluation of how these technologies are implemented.","author_count":1,"contributors":["Hjelholt, Morten"],"cuid":["S01-000.00-754081"],"filters":{"added":"2024-09","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"digitalizing at the expense of others the hidden costs of digital welfare","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/106145356/ISSJ-22-001.pdf","version":"Published Version"},"id":"S01-000.00-754081","ids":["itu-9ca467ed-0dd8-4a85-a7db-3c9783a2c006"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-BFEA76C7292588FF4E89552932DE9515"],"oa_link":[{"access":"oa","type":"rem","url":"https://innovatesci-publishers.com/index.php/ISSJ/article/view/74","version":"Published Version"},{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/106145356/ISSJ-22-001.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Digital Design, Design Research Section","IT University of Copenhagen, Digital Design, Digital Societies and Participation Section"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Morten","key":"hjelholtpau","last":"Hjelholt","locid":"10e4fc8e-556f-4104-b744-409caedc2276","name":"Hjelholt, Morten","rank":1,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-9ca467ed-0dd8-4a85-a7db-3c9783a2c006"],"src":["ITU IT University of Copenhagen"],"title":"Digitalizing at the Expense of Others: The Hidden Costs of Digital Welfare.","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-754081","year":"2022","yearsub":"2022"}
{"abstract":"Objectives: We examined whether the comorbidity burden of patients with hip fracture was associated with quality of in-hospital care reflected by fulfillment of process performance measures. Design: Population-based cohort study using prospectively collected data from the Danish Multidisciplinary Hip Fracture Registry (DMHFR). Setting and Participants: Patients aged 65 years or older with an incident hip fracture from 2014 to 2018 registered in the DMHFR (n = 31,443). Methods: Comorbidity was measured using the Charlson Comorbidity Index based on hospital diagnoses. Quality of in-hospital care was defined as fulfillment of eligible process performance measures, including preoperative optimization, early surgery, early mobilization, pain assessment, basic mobility, nutritional risk, need for anti-osteoporotic medication, fall prevention, and a post-discharge rehabilitation program, reflecting guideline-recommended in-hospital care. The outcomes were (1) an all-or-none composite measure defined as fulfillment of all relevant process performance measures, and (2) fulfillment of the individual process performance measures. Using binary regression, we calculated relative risk (RR) for the association between comorbidity level and outcomes. Results: The overall proportion of patients with hip fracture who fulfilled the all-or-none measure was 31%. Among patients with no comorbidity, 34% fulfilled the all-or-none measure versus 29% among patients with high comorbidity (Charlson ≥ 3). This corresponds to a 15% lower chance (RR = 0.85, 95% confidence interval 0.81–0.89). Increasing comorbidity was also associated with lower fulfillment of the individual process performance measures. The largest difference was seen for preoperative optimization, early surgery, and early mobilization, where patients with high comorbidity had 6% to 11% lower chance of fulfillment of these process performance measures compared with patients without comorbidity. Conclusion and Implications: Increasing level of comorbidity was associated with lower quality of in-hospital care among patients with hip fracture. Our results highlight the need for tailored clinical initiatives to ensure that comorbid patients also benefit from the positive progress in hip fracture care in recent years.","author_count":6,"contributors":["Schrøder, Christine Krogsgaard","Hjelholt, Thomas Johannesson","Møller, Henrik","Madsen, Morten","Pedersen, Alma Becic","Kristensen, Pia Kjær"],"cuid":["S01-000.00-131301"],"filters":{"added":"2022-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Schrøder, Christine Krogsgaard"],"keyword":["Comorbidity","Hip fracture","Older people","Quality of care"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-OTH"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-HO-OTH","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"comorbidity and quality of in hospital care for hip fracture patients","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.jamda.2022.01.078","version":"Published Version"},"id":"S01-000.00-131301","identifier":[{"id":"35247357","type":"pmid"},{"id":"85127187691","type":"scopus"}],"ids":["au-03931d9b-5884-4a3c-bb3b-d7130bad8bde"],"keyword":["Hip fracture","comorbidity","older people","quality of care"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-FAB0698CFAB21311E5BA0D1A44386885"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.au.dk/ws/files/340326357/Comorbidity_and_Quality_of_In-Hospital_Care_for_Hip_Fracture_Patients.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.jamda.2022.01.078","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Orthopaedic surgery"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"other hospitals","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-OTH","l3nl":"Other Hospitals","l3nn":"Other Hospitals","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Hospitals","namevar":["Regionernes Kliniske Kvalitetsudviklingsprogram"],"nora_code":"DI-HO-OTH","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Christine K.","key":"schrøderpau","last":"Schrøder","locid":"d37df0bc-c88f-4d4e-bb19-7f0f3bb05349","name":"Schrøder, Christine Krogsgaard","name_org":"Schrøder, Christine K.","orcid":"0000-0001-6022-256X","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thomas J.","key":"hjelholtpau","last":"Hjelholt","locid":"e22aa9dd-c881-4afe-a9cb-55a9f34bc851","name":"Hjelholt, Thomas Johannesson","name_org":"Hjelholt, Thomas J.","orcid":"0000-0003-0112-5801","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Henrik","key":"møllerpau","last":"Møller","name":"Møller, Henrik","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Morten","key":"madsenpau","last":"Madsen","locid":"7cd50d58-614a-4e57-8bf5-7dfb8ea22d56","name":"Madsen, Morten","orcid":"0000-0002-6036-8240","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Alma B.","key":"pedersenpau","last":"Pedersen","locid":"797cacd6-5e68-4aac-a0fa-db74425f732b","name":"Pedersen, Alma Becic","name_org":"Pedersen, Alma B.","orcid":"0000-0002-3288-9401","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Pia K.","key":"kristensenpau","last":"Kristensen","locid":"2e3de633-91bd-49d2-a141-cf7ac3f09190","name":"Kristensen, Pia Kjær","name_org":"Kristensen, Pia K.","orcid":"0000-0001-5473-9386","rank":6,"rolecode":"pau"}],"pmid":["35247357"],"pub":{"doi":"10.1016/j.jamda.2022.01.078","issn":["15258610","15389375"],"issn_org":["15258610"],"issue":"4","journal":"Journal of the American Medical Directors Association","publisher":"Elsevier Inc.","status":"p","title":"Journal of the American Medical Directors Association","volume":"23"},"review":"Peer Reviewed","scoID":["2-s2.0-85127187691"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Other Hospitals","Universities","regionernes kliniske kvalitetsudviklingsprogram"],"PST":["Published"]},"sid":["au-03931d9b-5884-4a3c-bb3b-d7130bad8bde"],"src":["AU Aarhus University"],"title":"Comorbidity and Quality of In-Hospital Care for Hip Fracture Patients","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-131301","year":"2022","yearsub":"2022"}
{"abstract":"Background: Patients with active acromegaly exhibit insulin resistance despite a lean phenotype whereas controlled disease improves insulin sensitivity and increases fat mass. The mechanisms underlying this paradox remain elusive, but growth hormone (GH)-induced lipolysis plays a central role. The aim of the study was to investigative the molecular mechanisms of insulin resistance dissociated from obesity in patients with acromegaly. Methods: In a prospective study, twenty-one patients with newly diagnosed acromegaly were studied at diagnosis and after disease control obtained by either surgery alone (n=10) or somatostatin analogue (SA) treatment (n=11) with assessment of body composition (DXA scan), whole body and tissue-specific insulin sensitivity and GH and insulin signalling in adipose tissue and skeletal muscle. Findings: Disease control of acromegaly significantly reduced lean body mass (p<0.001) and increased fat mass (p<0.001). At diagnosis, GH signalling (pSTAT5) was constitutively activated in fat and enhanced expression of GH-regulated genes (CISH and IGF-I) were detected in muscle and fat. Insulin sensitivity in skeletal muscle, liver and adipose tissue increased after disease control regardless of treatment modality. This was associated with enhanced insulin signalling in both muscle and fat including downregulation of phosphatase and tensin homolog (PTEN) together with reduced signalling of GH and lipolytic activators in fat. Interpretation: In conclusion, the study support that uncontrolled lipolysis is a major feature of insulin resistance in active acromegaly, and is characterized by upregulation of PTEN and suppression of insulin signalling in both muscle and fat. Funding: This work was supported by a grant from the Independent Research Fund, Denmark (7016-00303A) and from the Alfred Benzon Foundation, Denmark.","author_count":9,"contributors":["Arlien-Søborg, Mai C.","Dal, Jakob","Madsen, Michael Alle","Høgild, Morten Lyng","Hjelholt, Astrid Johannesson","Pedersen, Steen B.","Møller, Niels","Jessen, Niels","Jørgensen, Jens O.L."],"cuid":["S02-100.00-003747"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Arlien-Søborg, Mai C.","Arlien-Søborg, Mai Christiansen"],"keyword":["Acromegaly","Growth hormone","Insulin Resistance","Insulin signalling","Lipolysis"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR","DI-HO-STENO"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-HO-CDR","DI-HO-STENO","DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"reversible insulin resistance in muscle and fat unrelated to the metabolic syndrome in patients with acromegaly","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.ebiom.2021.103763","version":"Published Version"},"id":"S02-100.00-003747","identifier":[{"id":"PMC8688588","type":"pmcid"},{"id":"34929488","type":"pmid"},{"id":"85121230508","type":"scopus"}],"ids":["aau-4cb19475-17d4-4085-9b54-f332eb5d7189","au-3d8abe68-ac42-4c13-bd65-8a67866e992e"],"keyword":["Acromegaly","Growth hormone","Insulin resistance","Insulin signalling","Lipolysis"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-24ED0BD04CC7CD567A37B58FA9B0B9D4"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.ebiom.2021.103763","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/457941244/Arlien_S_borg_et_al._2022_._Reversible_insulin_resistance_in_muscle_and_fat_unrelated_to_the_metabolic_syndrome_in_patients_with_acromegaly.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Endocrinology and Internal Medicine","Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Medical Research Laboratory"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1},{"affno":"3","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Medicin og Akut","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Steno Diabetes Center North Denmark","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, The Department of Endocrinology","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-AAU","used":1},{"affno":"4","country":"dk","key":"steno diabetes centers","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-STENO","l3nn":"Steno Diabetes Centers","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Steno Diabetes Centers","namevar":["Steno Diabetes Centers"],"nora_code":"DI-HO-STENO","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"Mai C","key":"arliensøborgpau","last":"Arlien-Søborg","locid":"008fd532-bc75-466c-883a-45acf52cb7c1","name":"Arlien-Søborg, Mai Christiansen","name_org":"Arlien-Søborg, Mai C","rank":1,"rolecode":"pau"},{"affno":"2 3 1","corresponding":null,"first":"Jakob","key":"dalpau","last":"Dal","locid":"2e86cdf8-de5b-4bcf-b705-d5ac5f184cf2","name":"Dal, Jakob","orcid":"0000-0002-0610-7867","rank":2,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Michael Alle","key":"madsenpau","last":"Madsen","locid":"e14de478-8675-42c9-ac79-cacf6da61050","name":"Madsen, Michael Alle","rank":3,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Morten Lyng","key":"høgildpau","last":"Høgild","locid":"d188742e-e315-4edc-9d28-9172dd82bb18","name":"Høgild, Morten Lyng","rank":4,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Astrid Johannesson","key":"hjelholtpau","last":"Hjelholt","locid":"7c969e96-fa50-4878-a9fe-bea51d76ec75","name":"Hjelholt, Astrid Johannesson","orcid":"0000-0002-3114-4176","rank":5,"rolecode":"pau"},{"affno":"1 4","corresponding":null,"country":"dk","first":"Steen B","key":"pedersenpau","last":"Pedersen","locid":"6fbce58b-23e6-41fa-b756-0b9558645564","name":"Pedersen, Steen Bønløkke","name_org":"Pedersen, Steen B","orcid":"0000-0002-7838-8063","rank":6,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Niels","key":"møllerpau","last":"Møller","locid":"2e0d8e2a-2da1-4d55-b2da-0a25c0375b1e","name":"Møller, Niels","orcid":"0000-0001-5627-7322","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Niels","key":"jessenpau","last":"Jessen","locid":"f0d20e5e-d5b5-44da-980e-3e052af18b46","name":"Jessen, Niels","orcid":"0000-0001-5613-7274","rank":8,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Jens O L","key":"jørgensenpau","last":"Jørgensen","locid":"303ebe86-6861-4b19-b4d7-6bda0526b27e","name":"Jørgensen, Jens Otto Lunde","name_org":"Jørgensen, Jens O L","orcid":"0000-0001-7408-1526","rank":9,"rolecode":"pau"}],"pmid":["34929488"],"pub":{"doi":"10.1016/j.ebiom.2021.103763","issn":["23523964"],"journal":"EBioMedicine","paperid":"103763","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"p","title":"EBioMedicine","volume":"75"},"review":"Peer Reviewed","scoID":["2-s2.0-85121230508"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities"],"PST":["Published"]},"sid":["aau-4cb19475-17d4-4085-9b54-f332eb5d7189","au-3d8abe68-ac42-4c13-bd65-8a67866e992e"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Reversible insulin resistance in muscle and fat unrelated to the metabolic syndrome in patients with acromegaly","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-003747","year":"2022","yearsub":"2022"}
{"abstract":"Objective: Comorbidity has an important role in risk prediction and risk adjustment modelling in observational studies. However, it is unknown which comorbidity index is most accurate to predict mortality in hip fracture patients. We aimed to evaluate the prediction ability, including discrimination and calibration of Charlson comorbidity index (CCI), Elixhauser comorbidity index (ECI) and Rx-risk index for 30 day-and 1 year mortality in a population-based cohort of hip fracture surgery patients. Methods: Using the Danish Multidisciplinary Hip Fracture Registry in the period 2014–2018, 31,443 patients were included. CCI and ECI were based on discharge diagnoses, while Rx-Risk index was based on pharmacy dispensings. We used logistic regression to assess discrimination of the different indices, individually and in combinations, by calculating c-statistics and the contrast in c-statistic to a base model including only age and gender with 95% confidence intervals (CI). Results: The study cohort were primarily female (69%) and older than 85 years (42%). The 30-day mortality was 10.1% and the 1-year mortality was 26.6%. Age and gender alone had a good discrimination ability for 30-day and 1-year mortality (c-statistic=0.70, CI: 0.69– 0.71 and c-statistic=0.68, CI: 0.67 −0.69, respectively). By adding indices individually to the base model, Rx-risk index had the best 30-day and 1-year mortality discrimination ability (c-statistic=0.73, CI: 0.72–0.74 and 0.71 CI: 0.71–0.72, respectively). By adding combination of indices to the base model, a combination of CCI and the Rx-risk index had a 30-day and 1-year mortality discrimination ability of c-statistic=0.74, CI: 0.73–0.75 and c-statistic=0.73, CI: 0.73–0.74, respectively. Calibration of indices was similar. Conclusion: The highest discrimination ability was achieved by combining CCI and Rx-risk index in addition to age and gender. However, age and gender alone had a fair mortality discrimination ability.","author_count":5,"contributors":["Vesterager, Jeppe Damgren","Madsen, Morten","Hjelholt, Thomas Johannesson","Kristensen, Pia Kjær","Pedersen, Alma Becic"],"cuid":["S01-000.00-157099"],"filters":{"added":"2022-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Pedersen, Alma Becic"],"keyword":["Calibration","Charlson Comorbidity Index","Discrimination","Elixhauser Index","Multimorbidity"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"prediction ability of charlson elixhauser and rx risk comorbidity indices for mortality in patients with hip fracture a danish population based cohort study from 000000002014 000000002018","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.2147/CLEP.S346745","version":"Published Version"},"id":"S01-000.00-157099","identifier":[{"id":"35299726","type":"pmid"},{"id":"85126733310","type":"scopus"},{"id":"PMC8922332","type":"pmcid"}],"ids":["au-309886dd-94fe-438f-b55a-8a9bb97833d3"],"keyword":["Calibration","Charlson comorbidity index","Discrimination","Elixhauser index","Multimorbidity","Rx-risk index"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-357F182892FB2F589AC0B0FB5790C864"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.2147/CLEP.S346745","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Clinical Epidemiology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jeppe Damgren","key":"vesteragerpau","last":"Vesterager","locid":"313a9fe1-17e1-49b2-ade6-3852617de231","name":"Vesterager, Jeppe Damgren","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Morten","key":"madsenpau","last":"Madsen","locid":"7cd50d58-614a-4e57-8bf5-7dfb8ea22d56","name":"Madsen, Morten","orcid":"0000-0002-6036-8240","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thomas Johannesson","key":"hjelholtpau","last":"Hjelholt","locid":"e22aa9dd-c881-4afe-a9cb-55a9f34bc851","name":"Hjelholt, Thomas Johannesson","orcid":"0000-0003-0112-5801","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Pia Kjær","key":"kristensenpau","last":"Kristensen","locid":"2e3de633-91bd-49d2-a141-cf7ac3f09190","name":"Kristensen, Pia Kjær","orcid":"0000-0001-5473-9386","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Alma Becic","key":"pedersenpau","last":"Pedersen","locid":"797cacd6-5e68-4aac-a0fa-db74425f732b","name":"Pedersen, Alma Becic","orcid":"0000-0002-3288-9401","rank":5,"rolecode":"pau"}],"pmid":["35299726"],"pub":{"doi":"10.2147/clep.s346745","issn":["11791349"],"journal":"Clinical Epidemiology","pages":"275-287","publisher":"Dove Medical Press Ltd","status":"p","title":"Clinical Epidemiology","volume":"14"},"review":"Peer Reviewed","scoID":["2-s2.0-85126733310"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-309886dd-94fe-438f-b55a-8a9bb97833d3"],"src":["AU Aarhus University"],"title":"Prediction Ability of Charlson, Elixhauser, and Rx-Risk Comorbidity Indices for Mortality in Patients with Hip Fracture. A Danish Population-Based Cohort Study from 2014 – 2018","ty