Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-009f2bef-234b-4c34-995b-65615f1e61a0"],"src":["ITU IT University of Copenhagen"],"title":"The Historical Shaping of Public Service Television and Digitalization.","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381256","year":"2015","yearsub":"2015"}
{"abstract":"In this paper the concept of performative action is introduced to address how individuals can engage in IT adoption processes. The study investigates how local government employees adopt and localize ideas from a Danish National IT initiative called eDay3. Particularly the actions of a project manager are highlighted to portray how individuals can engage with historically produced discourses making them performative. The case study presented spans a two-year time period and demonstrates a double loop adoption process. First, a localization-process as discourse is used to support the specificity and variance of the specific local government. Second, a feedback loop re-attaching the localized project to the national reform program in order to maintain and protect the newly formed local practices. The study concludes that individuals actively struggle for social positions in IT adoption processes. Through the use of performative actions the positions are never stable and firm but constantly enacted and changed in discursive practices.","author_count":1,"contributors":["Hjelholt, Morten"],"cuid":["S01-000.00-382168"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"keyword":["Discourse localization","Double loop adoption process","IT adoption","Local government","National IT initiatives","Performative action"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"performative actions in e adoption processes strategic efforts in a local government","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.igi-global.com/journals/abstract-announcement/118529","version":"Other Version"},"id":"S01-000.00-382168","ids":["itu-3cf225db-e194-4670-bc8b-f1dbef083f32"],"keyword":["Discourse localization","Double loop adoption process","IT adoption","Local government","National IT initiatives","Performative action"],"lang":"Danish","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-4FA4E889E8F8BDA7D332175290CD1C55"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","The Department, Culture and Games","The Department, Digital Society and Communication"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Morten","key":"hjelholtpau","last":"Hjelholt","locid":"10e4fc8e-556f-4104-b744-409caedc2276","name":"Hjelholt, Morten","rank":1,"rolecode":"pau"}],"pub":{"doi":"10.4018/ijea.2015070103","issn":["19379633","19379641"],"issn_org":["19379633"],"issue":"2","journal":"International Journal of E-Adoption","publisher":"Idea Group Publishing","status":"p","title":"International Journal of E-Adoption","volume":"7"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-3cf225db-e194-4670-bc8b-f1dbef083f32"],"src":["ITU IT University of Copenhagen"],"title":"Performative Actions in E-Adoption Processes: Strategic Efforts in a Local Government","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382168","year":"2015","yearsub":"2015"}
