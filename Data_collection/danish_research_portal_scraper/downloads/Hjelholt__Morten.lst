y, The Faculty of Medicine, Aalborg University Hospital, The Department of Endocrinology","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Mai Christiansen","key":"arliensøborgpau","last":"Arlien-Søborg","name":"Arlien-Søborg, Mai Christiansen","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jakob","key":"dalpau","last":"Dal","locid":"2e86cdf8-de5b-4bcf-b705-d5ac5f184cf2","name":"Dal, Jakob","orcid":"0000-0002-0610-7867","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Michael","key":"madsenpau","last":"Madsen","name":"Madsen, Michael","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Morten","key":"høgildpau","last":"Høgild","name":"Høgild, Morten","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Astrid","key":"hjelholtpau","last":"Hjelholt","name":"Hjelholt, Astrid","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Niels","key":"jessenpau","last":"Jessen","name":"Jessen, Niels","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Niels","key":"møllerpau","last":"Møller","name":"Møller, Niels","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens Otto Lunde","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, Jens Otto Lunde","rank":8,"rolecode":"pau"}],"pub":{"doi":"10.1530/endoabs.63.oc3.4777","issn":["14703947","14796848"],"issn_org":["14703947"],"journal":"Endocrine Abstracts","paperid":"OC3.4","publisher":"BioScientifica Ltd.","status":"p","title":"Endocrine Abstracts","volume":"63"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities"],"PST":["Published"]},"sid":["aau-07262f6f-8712-45f4-94dd-f1fdd2639469"],"src":["AAU Aalborg University"],"title":"Restoration of basal glucose turnover after disease control in acromegaly depends on treatment modality : a prospective, investigator-initiated trial","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-814194","year":"2019","yearsub":"2019"}
{"abstract":"Over the past decades, advanced capitalist states have increasingly used digital technologies to deliver state services and restructure public sector institutions. This practice has had profound institutional as well as political consequences. So far, however, little research has been conducted that examines the forms of statehood and governance to which the use of digital technologies gives rise. To fill this research gap, this paper examines governmental digitalization through the lens of political economies of state rescaling. In doing so, it engages with the production of state spatiality, ultimately advancing the concept of digital state spaces, which links scholarship on state restructuring with work in digital geography. Drawing on several years of empirical research, the paper demonstrates the connection between these fields with an in-depth case study of digitalization efforts in Denmark, a country that is often cited as an example of a highly digitalized European state. It traces how national policy efforts have created new digital state spaces in Denmark and examines the local consequences these state interventions have had. Taken together, these conceptual and empirical insights contribute to a more nuanced understanding of governmental digitalization as a regulatory instrument implicated in the production of new spaces of governance.","author_count":2,"contributors":["Schou, Jannick","Hjelholt, Morten"],"cuid":["S01-000.00-381936"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Digitalisation","Governance","Political economy","State space","Technology"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"digital state spaces state rescaling and advanced digitalization","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83490826/Pre_print.pdf","version":"Pre-print"},"id":"S01-000.00-381936","identifier":[{"id":"85055698896","type":"scopus"}],"ids":["itu-2d6862ae-afc0-4656-97ce-f7c096eb8e38"],"keyword":["digitalisation","governance","political economy","state space","technology"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-A322CCBCF8B352C56DF62A5E508EA94C"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83490826/Pre_print.pdf","version":"Pre-print"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Technologies in Practice, Technologies in Practice"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jannick","key":"schoupau","last":"Schou","name":"Schou, Jannick","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Morten","key":"hjelholtpau","last":"Hjelholt","locid":"10e4fc8e-556f-4104-b744-409caedc2276","name":"Hjelholt, Morten","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1080/21622671.2018.1532809","issn":["21622671","2162268X"],"issn_org":["21622671"],"journal":"Territory, Politics, Governance","pages":"1-17","publisher":"Routledge","status":"p","title":"Territory, Politics, Governance"},"review":"Peer Reviewed","scoID":["2-s2.0-85055698896"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-2d6862ae-afc0-4656-97ce-f7c096eb8e38"],"src":["ITU IT University of Copenhagen"],"title":"Digital state spaces: state rescaling and advanced digitalization","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381936","year":"2018","yearsub":"2018"}
