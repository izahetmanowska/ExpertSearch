{"author_count":5,"contributors":["Hjelholt, Morten","Kickbusch, Jari","Rasmussen, Jon Dag"],"cuid":["S01-000.00-097237"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["ældre mennesker"],"level":"pop","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-AAU","DI-U-ITU"]},"review":"und","rtype":["clu"],"sorti":"jeg har set ældre mennesker som har overdraget deres nemid til bartenderen interview","src":["aau"],"src-code":["DI-U-AAU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.cdr-forlag.dk/alle/undervisning/det-skal-du-ordne-pa-nettet-om-digitalt-udsatte-aeldre.html","version":"Other Version"},"id":"S01-000.00-097237","ids":["aau-a2d81f32-ce49-4381-9711-db9331a334f9"],"keyword":["Digital udsathed","Ældre mennesker"],"lang":"Danish","level":"Popular","mra":["Science/Technology"],"noi":["Local-1-1-3E982EDCF7BDDB807CF5582C3842A23F"],"org":[{"affno":"1","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment, Division of Town, Housing and Property","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment, Universal Design Research Group"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Morten","key":"hjelholtpau","last":"Hjelholt","name":"Hjelholt, Morten","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jari","key":"kickbuschpau","last":"Kickbusch","name":"Kickbusch, Jari","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jon Dag","key":"rasmussenped","last":"Rasmussen","locid":"ed14200c-4598-48f4-aaee-9dfe5347c5a5","name":"Rasmussen, Jon Dag","orcid":"0000-0002-5168-1761","rank":3,"role":"Editor","rolecode":"ped"},{"affno":"","first":"Morten","key":"hjelholtpedh","last":"Hjelholt","name":"Hjelholt, Morten","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Jari","key":"kichbuschpedh","last":"Kichbusch","name":"Kichbusch, Jari","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9788778415462"],"pages":"71-74","publisher":"CDR Forlag","status":"p","title":"Det skal du ordne på nettet - om digitalt udsatte ældre"},"review":"Undetermined","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["aau-a2d81f32-ce49-4381-9711-db9331a334f9"],"src":["AAU Aalborg University"],"title":"\"Jeg har set ældre mennesker, som har overdraget deres NemID til bartenderen\" (Interview)","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-097237","year":"2021","yearsub":"2021"}
{"abstract":"Dét skal du ordne på nettet - om digitalt udsatte ældre sætter fokus på en gruppe af medborgere, hvis stemmer er blevet overdøvet af begejstringen over, at Danmark er digitale verdensmestre.Med udgangspunkt i dansk og international forskning, beskriver bogens forfattere lektor ved IT-Universitetet,Morten Hjelholt, og forskningskommunikatør, Jari Kickbusch, krydsfeltet mellem digitalisering og udsatte ældre. Bogen består desuden af en række interviews med de udsatte ældre, deres it-hjælpere samt forskellige eksperter på området, deriblandt journalisten Anders Kjærulff og professor Vincent Hendrix. Bogen er skrevet i en letfordøjelig tone og er velegnet som både debat- og undervisningsbog.","author_count":2,"contributors":["Hjelholt, Morten","Kickbusch, Jari"],"cuid":["S01-000.00-382742"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Digital velfærd","Udsatte ældre"],"level":"pop","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"und","rtype":["clu"],"sorti":"dét skal du ordne på nettet om digitalt udsatte ældre","src":["itu"],"src-code":["DI-U-ITU"],"type":"db","type-grp":["all","pub"]},"id":"S01-000.00-382742","ids":["itu-624d92f6-c5ba-4d45-b7c4-a174ad7a976d"],"keyword":["Digital velfærd","Udsatte ældre"],"lang":"Danish","level":"Popular","mra":["Science/Technology"],"noi":["Local-1-1-F76BB4CFCAAE4BFEAE2FEE2EA1B51242"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Morten","key":"hjelholtpau","last":"Hjelholt","locid":"10e4fc8e-556f-4104-b744-409caedc2276","name":"Hjelholt, Morten","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jari","key":"kickbuschpau","last":"Kickbusch","name":"Kickbusch, Jari","rank":2,"rolecode":"pau"}],"pub":{"pages":"109","publisher":"CDR Forlag","publisher_org":"CDR forlag","status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-624d92f6-c5ba-4d45-b7c4-a174ad7a976d"],"src":["ITU IT University of Copenhagen"],"title":"Dét skal du ordne på nettet : Om digitalt udsatte ældre","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382742","year":"2021","yearsub":"2021"}
