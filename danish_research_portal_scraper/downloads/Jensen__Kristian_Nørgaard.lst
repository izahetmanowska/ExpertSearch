"first":"Ida Elisabeth","key":"berggreenpau","last":"Berggreen","locid":"18e3a7e8-7426-45ac-a7f1-b24fbfbaaa38","name":"Berggreen, Ida Elisabeth","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jan Værum","key":"nørgaardpau","last":"Nørgaard","locid":"c19af48d-12e9-41fe-bb23-5435a0ff19a7","name":"Nørgaard, Jan Værum","orcid":"0000-0002-0580-0184","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kim","key":"jensenpau","last":"Jensen","locid":"3ebc4172-e9ed-4669-80ab-f70554d856f8","name":"Jensen, Kim","orcid":"0000-0003-0261-3831","rank":4,"rolecode":"pau"}],"pub":{"pages":"23","repno":"Rådgivningsrapport fra DCA - Nationalt Center for Fødevarer og Jordbrug","series":"Rådgivningsrapport fra DCA - Nationalt Center for Fødevarer og Jordbrug","status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-55fe8f4b-7242-4ce9-ac11-37d45c5693bd"],"src":["AU Aarhus University"],"title":"Feeding experiments with insects and assessment of feed related risks from kitchen- and food waste: Risks associated with meat and fish","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-815761","year":"2025","yearsub":"2025"}
{"abstract":"Tumor-associated macrophages (TAMs) play crucial roles in development and progression of malignant diseases. Notably, CD163 + TAMs likely perform specific pro-tumorigenic functions, suggesting that this subset may serve as both prognostic biomarkers and targets for future anti-cancer therapy. We conducted a scoping review to map the current knowledge on the prognostic role of CD163 + TAMs in the five most lethal cancers worldwide: Lung, colorectal, gastric, liver, and breast cancer. For all cancer types, most studies showed that high tumoral presence of CD163 + cells was associated with poor patient outcome, and this association was more frequently observed when CD163 + cells were measured at the tumor periphery compared to more central parts of the tumor. These results support that CD163 + TAMs represent a biomarker of poor patient outcome across a variety of solid tumors, and highlight the relevance of further investigations of CD163 + TAMs as targets of future immunotherapies.","author_count":7,"contributors":["Mathiesen, Henriette","Juul-Madsen, Kristian","Tramm, Trine","Vorup-Jensen, Thomas","Møller, Holger Jon","Etzerodt, Anders","Andersen, Morten Nørgaard"],"cuid":["S01-000.00-787536"],"filters":{"added":"2025-02","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["CD163","Cancer","Tumor associated macrophage"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"prognostic value of cd000000000163 macrophages in solid tumor malignancies a scoping review","src":["au"],"src-code":["DI-U-AU"],"type":"djr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.imlet.2025.106970","version":"Published Version"},"id":"S01-000.00-787536","identifier":[{"id":"85216020739","type":"scopus"},{"id":"39778658","type":"pmid"}],"ids":["au-8af0d349-2cec-422b-9a31-e7795fe95d46"],"keyword":["CD163","Cancer","Patient prognosis","Solid tumor malignancy","Targeted immunotherapy","Tumor-associated macrophage"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-87F6C73F094EA70201EF7811F09446F7"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.imlet.2025.106970","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Haematology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Henriette","key":"mathiesenpau","last":"Mathiesen","locid":"b27e3870-954a-4c89-ab08-2e805fb5ba6f","name":"Mathiesen, Henriette","orcid":"0009-0008-2679-7376","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kristian","key":"juulmadsenpau","last":"Juul-Madsen","locid":"e1f1360b-467e-4b44-b1c1-d5c6a0da4acf","name":"Juul-Madsen, Kristian","orcid":"0000-0002-5309-5221","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Trine","key":"trammpau","last":"Tramm","locid":"d2fcf42a-8798-4ae4-b95a-00f5cd1f739a","name":"Tramm, Trine","orcid":"0000-0003-3894-4552","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thomas","key":"vorupjensenpau","last":"Vorup-Jensen","locid":"77b03498-95a4-453b-81a8-e2c05fa0ca0c","name":"Vorup-Jensen, Thomas","orcid":"0000-0002-4140-6563","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Holger Jon","key":"møllerpau","last":"Møller","locid":"b08dc9ce-d595-49c6-833a-4ec9b4223a05","name":"Møller, Holger Jon","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anders","key":"etzerodtpau","last":"Etzerodt","locid":"c0b60588-6275-45c0-8ad2-bb91a248ff22","name":"Etzerodt, Anders","orcid":"0000-0002-6757-2068","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Morten Nørgaard","key":"andersenpau","last":"Andersen","locid":"5820fa2e-0f0e-4429-badc-9e264f102231","name":"Andersen, Morten Nørgaard","orcid":"0000-0003-0820-7789","rank":7,"rolecode":"pau"}],"pmid":["39778658"],"pub":{"doi":"10.1016/j.imlet.2025.106970","issn":["01652478","18790542"],"issn_org":["01652478"],"journal":"Immunology Letters","pages":"106970","paperid":"106970","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"p","title":"Immunology Letters","volume":"272"},"review":"Peer Reviewed","scoID":["2-s2.0-85216020739"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-8af0d349-2cec-422b-9a31-e7795fe95d46"],"src":["AU Aarhus University"],"title":"Prognostic value of CD163+ macrophages in solid tumor malignancies : A scoping review.","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-787536","year":"2025","yearsub":"2025"}
{"abstract":"Large-scale datasets are foundational for research and development in natural language processing. However, current approaches face three key challenges: (1) reliance on ambiguously licensed sources restricting use, sharing, and derivative works; (2) static dataset releases that prevent community contributions and diminish longevity; and (3) quality assurance processes restricted to publishing teams rather than leveraging community expertise. To address these limitations, we introduce two contributions: the Dynaword approach and Danish Dynaword. The Dynaword approach is a framework for creating large-scale, open datasets that can be continuously updated through community collaboration. Danish Dynaword is a concrete implementation that validates this approach and demonstrates its potential. Danish Dynaword contains over four times as many tokens as comparable releases, is exclusively openly licensed, and has received multiple contributions across industry and research. The repository includes light-weight tests to ensure data formatting, quality, and documentation, establishing a sustainable framework for ongoing community contributions and dataset evolution.","author_count":19,"contributors":["Enevoldsen, Kenneth","Jensen, Kristian Nørgaard","Kostkan, Jan","Szabó, Balázs","Kardos, Márton","Vad, Kirsten","Heinsen, Johan","Núñez, Andrea Blasi","Barmina, Gianluca","Nielsen, Jacob","Larsen, Rasmus","Vahlstrup, Peter","Dalum, Per Møldrup","Elliott, Desmond","Galke, Lukas","Schneider-Kamp, Peter","Nielbo, Kristoffer"],"cuid":["S02-094.55-822345"],"filters":{"added":"2025-10","altsrc":["No Matches Found"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Enevoldsen, Kenneth"],"keyword":["Low resource","Multilingual NLP","Natural Language Processing"],"level":"sci","mra":["hum","soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GTS","DI-U"],"level3":{"GTS":["DI-GTS-ALL","DI-GTS-ALX"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-GTS-ALX","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"und","rtype":["clu"],"sorti":"dynaword from one shot to continuously developed datasets","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dpr","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-SA","type":"rem","url":"https://arxiv.org/abs/2508.02271","version":"Authors Final Version"},"id":"S02-094.55-822345","ids":["aau-6c685239-843b-47bf-b7f4-7a78aae67929","au-47cf988c-8818-4e17-84e3-1eafee10a415"],"keyword":["Low resource","Multilingual NLP","natural language processing"],"lang":"English","level":"Scientific","mra":["Humanities","Social Science"],"noi":["Local-1-2-3A5316EAAD18F5657EEE2091C982BE01"],"oa_link":[{"access":"oa","license":"CC BY-SA","type":"rem","url":"https://arxiv.org/abs/2508.02271","version":"Authors Final Version"},{"access":"oa","license":"CC BY-SA 4.0","type":"doi","url":"https://doi.org/10.48550/arXiv.2508.02271","version":"Pre-print"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, School of Culture and Society, School of Culture and Society - Center for Humanities Computing"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"alexandra institute","l2":"DI-GTS","l2n":"GTS Institutes","l3":"DI-GTS-ALX","l3nn":"Alexandra Institute","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Alexandra Institute","namevar":["Alexandra Institute"],"nora_code":"DI-GTS-ALX","used":1},{"affno":"3","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty o