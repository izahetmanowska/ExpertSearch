graphy","pages":"583-592","publisher":"Elsevier Inc.","status":"p","title":"Journal of Cardiovascular Computed Tomography","volume":"18"},"review":"Peer Reviewed","scoID":["2-s2.0-85205732324"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-fe7fefbb-c621-46b4-ad0b-15c372e31243","sdu-21199bc1-6056-4a6b-9888-8afc634a34f9"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Interscan reproducibility of computed tomography derived coronary plaque volume measurements","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-768031","year":"2024","yearsub":"2024"}
{"abstract":"Combining modern technologies like large-language models (LLMs), speech-to-text, and text-to-speech can enhance immersion in virtual reality (VR) environments. However, challenges exist in effectively implementing LLMs and educating users. This paper explores implementing LLM-powered virtual social actors and facilitating user communication. We developed a murder mystery game where users interact with LLM-based non-playable characters (NPCs) through interrogation, clue-gathering, and exploration. Two versions were tested: one using speech recognition and another with traditional dialog boxes. While both provided similar social presence, users felt more immersed with speech recognition but found it overwhelming, while the dialog version was more challenging. Slow NPC response times were a source of frustration, highlighting the need for faster generation or better masking for a seamless experience.","author_count":7,"contributors":["Christiansen, Frederik Roland","Hollensberg, Linus Nørgaard","Jensen, Nikoline Bach Fleng","Julsgaard, Kristian","Nyborg Jespersen, Kristian","Nikolov, Ivan Adriyanov"],"cuid":["S01-000.00-762148"],"event":{"end":"2024-10-11","place":"Trier, de","start":"2024-10-09","title":"VRST '24","year":"2024"},"filters":{"added":"2024-11","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["NPC","Presence","Social actors","Speech recognition","VR"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"exploring presence in interactions with llm driven npcs a comparative study of speech recognition and dialogue options","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1145/3641825.3687716","version":"Published Version"},"id":"S01-000.00-762148","identifier":[{"id":"85212512351","type":"scopus"}],"ids":["aau-23879fa8-7b5b-4966-8a29-aa924bdb6cf1"],"keyword":["Immersive systems","Large Language Models (LLM)","NPC","Presence","Social Actors","Speech Recognition","VR"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-CCE93C8B1E0A9FE2778052D48C1BDF23"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/747035191/Exploring_Presence_in_Interactions_with_LLM_Driven_NPCs_A_Comparative_Study_of_Speech_Recognition_and_Dialogue_Options.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1145/3641825.3687716","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Technical Faculty of IT and Design","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Frederik Roland","key":"christiansenpau","last":"Christiansen","locid":"72eb8ea9-4cdb-4dd2-8f04-90a74e0ec607","name":"Christiansen, Frederik Roland","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Linus Nørgaard","key":"hollensbergpau","last":"Hollensberg","locid":"eda90284-a3d4-4caf-840e-82a5a3e00fd1","name":"Hollensberg, Linus Nørgaard","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Nikoline Bach Fleng","key":"jensenpau","last":"Jensen","locid":"58bc156a-c478-47f8-9eca-436ae7b8f2c9","name":"Jensen, Nikoline Bach Fleng","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kristian","key":"julsgaardpau","last":"Julsgaard","locid":"08931e35-fbf2-4c97-9d74-c7a20dd1a2bb","name":"Julsgaard, Kristian","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kristian","key":"nyborgjespersenpau","last":"Nyborg Jespersen","locid":"73efdecd-58c7-434b-a4a4-8ea050767871","name":"Nyborg Jespersen, Kristian","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ivan Adriyanov","key":"nikolovpau","last":"Nikolov","locid":"b323c042-3db1-43fa-ab2d-516c92908135","name":"Nikolov, Ivan Adriyanov","orcid":"0000-0002-4952-8848","rank":6,"rolecode":"pau"},{"affno":"","first":"Stephen N.","key":"spencerpedh","last":"Spencer","name":"Spencer, Stephen N.","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1145/3641825.3687716","eisbn":["9798400705359"],"pages":"1-11","publisher":"Association for Computing Machinery (ACM)","status":"p","subtitle":"Proceedings of the 30th ACM Symposium on Virtual Reality Software and Technology","title":"VRST '24"},"review":"Peer Reviewed","scoID":["2-s2.0-85212512351"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-23879fa8-7b5b-4966-8a29-aa924bdb6cf1"],"src":["AAU Aalborg University"],"title":"Exploring Presence in Interactions with LLM-Driven NPCs: A Comparative Study of Speech Recognition and Dialogue Options","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-762148","year":"2024","yearsub":"2024"}
{"abstract":"The coronary vascular volume to left ventricular mass (V/M) ratio assessed by coronary computed tomography angiography (CCTA) is a promising new parameter to investigate the relation of coronary vasculature to the myocardium supplied. It is hypothesized that hypertension decreases the ratio between coronary volume and myocardial mass by way of myocardial hypertrophy, which could explain the detected abnormal myocardial perfusion reserve reported in patients with hypertension. Individuals enrolled in the multicenter ADVANCE (Assessing Diagnostic Value of Noninvasive FFRCT in Coronary Care) registry who underwent clinically indicated CCTA for analysis of suspected coronary artery disease with known hypertension status were included in current analysis. The V/M ratio was calculated from CCTA by segmenting the coronary artery luminal volume and left ventricular myocardial mass. In total, 2,378 subjects were included in this study, of whom 1,346 (56%) had hypertension. Left ventricular myocardial mass and coronary volume were higher in subjects with hypertension than normotensive patients (122.7 ± 32.8 g vs 120.0 ± 30.5 g, p = 0.039, and 3,105.0 ± 992.0 mm 3 vs 2,965.6 ± 943.7 mm 3, p <0.001, respectively). Subsequently, the V/M ratio was higher in patients with hypertension than those without (26.0 ± 7.6 mm 3/g vs 25.3 ± 7.3 mm 3/g, p = 0.024). After correcting for potential confounding factors, the coronary volume and ventricular mass remained higher in patients with hypertension (least square) mean difference estimate: 196.3 (95% confidence intervals [CI] 119.9 to 272.7) mm 3, p <0.001, and 5.60 (95% CI 3.42 to 7.78) g, p <0.001, respectively), but the V/M ratio was not significantly different (least square mean difference estimate: 0.48 (95% CI −0.12 to 1.08) mm 3/g, p = 0.116). In conclusion, our findings do not support the hypothesis that the abnormal perfusion reserve would be caused by reduced V/M ratio in patients with hypertension.","author_count":28,"contributors":["van Rosendael, Sophie E","van Rosendael, Alexander R","Kuneman, Jurrien H","Patel, Manesh R","Nørgaard, Bjarne Linde","Fairbairn, Timothy A","Nieman, Koen","Akasaka, Takashi","Berman, Daniel S","Koweek, Lynne M Hurwitz","Pontone, Gianluca","Kawasaki, Tomohiro","Sand, Niels Peter Rønnow","Jensen, Jesper Møller","Amano, Tetsuya","Poon, Michael","Øvrehus, Kristian A","Sonck, Jeroen","Rabbat, Mark G","Rogers, Campbell","Matsuo, Hitoshi","Leipsic, Jonathon A","Marsan, Nina Ajmone","Jukema, J Wouter","Bax, Jeroen J","Saraste, Antti","Knuuti, Juhani"],"cuid":["S02-099.46-672586"],"filters":{"added":"2023-07","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","Asia, East","Asia, Middle East","Europe, EU","Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Knuuti, Juhani"],"country":["Belgium","Canada","Finland","Italy","Japan","Netherlands","Qatar","Taiwan","United Kingdom","United States"],"glorg":["Aichi Medical University","All Global Affiliations","Cardiovascular Center Aalst","Cardiovascular Center of Aalst","Cedars-Sinai Comprehensive Cancer Center","Cedars-Sinai Medical Center","Duke Clinical Research Institute","Duke University","Erasmus University Medical Centre","Gifu Heart Center","Heartflow Inc.","ICIN-Netherlands Heart Institute","IRCCS Centro Cardiologico Monzino","IRCCS Centro Cardiologico S.P.A. Fondazione Monzino - Milano","Leiden University","Liverpool Hope University","Loyola University","Loyola University Chicago","Northwell Health","Northwell Health System","Qatar Cardiovascular Research Center","Shin Koga Hospital","St. Paul's Hospital","St. Paul's Hospital Taoyuan","Stanford University","Turku University Hospital","University of Liverpool","University of Turku","Wakayama Medical University"],"keyword":["Computed Tomography Angiography","Coronary Angiography methods","Coronary Artery Disease diagnosis","Coronary Stenosis","Coronary Vessels diagnostic imaging","Fractional Flow Reserve Myocardial","Humans","Hypertension","Predictive Value of Tests"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-CDR","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"coronary volume to left ventricular mass ratio in patients with hypertension","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.amjcard.2023.04.025","version":"Published Version"},"funding_acknowledgement":["Funding: none."],"id":"S02-099.46-672586","identifier":[{"id":"85159379930","type":"scopus"},{"id":"37198076","type":"pmid"}],"ids":["au-26e75f0b-8baa-4fea-a1f4-3c4a436d3d5d","sdu-1162c9d7-3002-434d-90cf-82e7fb0291e3"],"keyword":["Computed Tomography Angiography","Coronary Angiography/methods","Coronary Artery Disease/diagnosis","Coronary Stenosis","Coronary Vessels/diagnostic imaging","Fractional Flow Reserve, Myocardial","Humans","Hypertension","Predictive Value of Tests"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-E5C68A56E244D9FA2109973F9563AF27"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.au.dk/ws/files/414133767/1-s2.0-S0002914923002412-main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.amjcard.2023.04.025","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/233928415/Open_Access_Version.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"nl","key":"leiden university","loc":["Netherlands","Europe, EU","OECD"],"name":"Leiden University","used":1},{"affno":"2","country":"us","key":"duke university","loc":["United States","Ame