en, Jess","orcid":"0000-0002-9976-9981","rank":11,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"country":"dk","first":"Anders H","key":"riispau","last":"Riis","locid":"44ece42d-9441-4088-96a5-05102310f933","name":"Riis, Anders H","orcid":"0000-0002-6684-4068","rank":12,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"country":"dk","first":"Ina Trolle","key":"andersenpau","last":"Andersen","locid":"44e5a828-24b1-4b05-9134-7dfb490435a1","name":"Andersen, Ina Trolle","orcid":"0000-0002-8140-1548","rank":13,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Hans E","key":"bøtkerpau","last":"Bøtker","locid":"09b03c00-11a8-4f72-800f-181f26155750","name":"Bøtker, Hans Erik","name_org":"Bøtker, Hans E","orcid":"0000-0001-6358-8962","rank":14,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Bjarne L","key":"nørgaardpau","last":"Nørgaard","locid":"6bcdb292-78dc-4e8b-9fea-814d6a6852c9","name":"Nørgaard, Bjarne Linde","name_org":"Nørgaard, Bjarne L","orcid":"0000-0002-4758-7203","rank":15,"rolecode":"pau"}],"pmid":["34274285"],"pub":{"doi":"10.1016/j.jcmg.2021.05.022","issn":["18767591","1936878X"],"issn_org":["1936878X"],"issue":"12","journal":"JACC: Cardiovascular Imaging","pages":"2400-2410","publisher":"Elsevier Inc.","status":"p","title":"JACC: Cardiovascular Imaging","volume":"14"},"review":"Peer Reviewed","scoID":["2-s2.0-85119511119"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-af694a87-a05a-4131-a0d0-03b970bafea1","sdu-c42acee4-eb4d-46d8-a199-b218bd8ca76e"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Reduction of Myocardial Infarction and All-Cause Mortality Associated to Statins in Patients Without Obstructive CAD","type":"Journal Article","url":"https://