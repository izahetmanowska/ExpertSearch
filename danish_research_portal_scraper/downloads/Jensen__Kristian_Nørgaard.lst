":"1","corresponding":null,"country":"dk","first":"Sara Nørgaard","key":"sørensensaranørgaardpau","last":"Sørensen","locid":"1c9842d3-875f-49e3-84a0-d9895fa754fd","name":"Sørensen, Sara Nørgaard","orcid":"0000-0003-3673-9483","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Amalie Thit","key":"jensenamaliethitpau","last":"Jensen","locid":"eda884b6-1125-477c-9da9-5fe7e2d962af","name":"Jensen, Amalie Thit","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars Michael","key":"skjoldinglarsmichaelpau","last":"Skjolding","locid":"0f7dbfa4-64f2-449a-bb3e-f9d14d60b2ca","name":"Skjolding, Lars Michael","orcid":"0000-0002-3280-1836","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Carsten","key":"køblercarstenpau","last":"Købler","locid":"0fd5e4a0-7092-4082-b36a-23358881355d","name":"Købler, Carsten","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kristian","key":"mølhavekristianpau","last":"Mølhave","locid":"745c31cd-5de7-4dd8-909e-d0f5de0fed5c","name":"Mølhave, Kristian","orcid":"0000-0002-6493-2750","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders","key":"baunanderspau","last":"Baun","locid":"f3cdf4a9-bfc7-4e0e-bf46-df0da8134f0d","name":"Baun, Anders","orcid":"0000-0003-1396-408X","rank":7,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-ef31025f-e9c2-48d6-a593-448f04e29c58"],"src":["DTU Technical University of Denmark"],"title":"Localization and analysis of engineered nanoparticles in Daphnia Magna","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-376124","year":"2014","yearsub":"2014"}
{"abstract":"Lys(B29)(N(e)¿-carboxyheptadecanoyl) des(B30) human insulin is an insulin analogue belonging to a class of analogues designed to form soluble depots in subcutis by self-association, aiming at a protracted action. On the basis of small angle X-ray scattering (SAXS) supplemented by a range of biophysical and structural methods (field flow fractionation, dynamic and multiangle light scattering, circular dichroism, size exclusion chromatography, and crystallography), we propose a mechanism for the self-association expected to occur upon subcutaneous injection of this insulin analogue. SAXS data provide evidence of the in solution structure of the self-associated oligomer, which is a long straight rod composed of \"tense\" state insulin hexamers (T(6)-hexamers) as the smallest repeating unit. The smallest oligomer building block in the process is a T(6)T(6)-dihexamer. This tense dihexamer is formed by the allosteric change of the initial equilibrium between a proposed \"relaxed\" state R(6)-hexamer and an R(3)T(3)T(3)R(3)-dihexamer. The allosteric change from relaxed to tense is triggered by removal of phenol, mimicking subcutaneous injection. The data hence provide the first unequivocal evidence of the mechanism of self-association for this type of insulin analogue.","author_count":8,"contributors":["Jensen, Malene Hillerup","Wahlund, Per-Olof","Toft, Katrine Nørgaard","Jacobsen, Jes Kristian","Steensgaard, Dorte Bjerre","van de Weert, Marco","Havelund, Svend","Vestergaard, Bente"],"cuid":["S01-000.00-496252"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-NOVO"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-PR-NOVO","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"small angle x ray scattering based elucidation of the self association mechanism of human insulin analogue lys b000000000029 n e carboxyheptadecanoyl des b000000000030","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1021/bi3008615","version":"Other Version"},"id":"S01-000.00-496252","identifier":[{"id":"23256662","type":"pmid"},{"id":"84872572711","type":"scopus"}],"ids":["ku-ac2039c4-0700-4e7f-9fd3-0061fe967c4d"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-ED20D0A0E8F51020EA9B7F31DBA009DE"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1021/bi3008615","version":"Other Version"}],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Pharmaceutical Sciences, Department of Drug Design and Pharmacology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"novo nordisk","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-NOVO","l3nl":"Novo Nordisk","l3nn":"Novo Nordisk","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Novo Nordisk","namevar":["Novo Nordisk"],"nora_code":"DI-PR-NOVO","used":1}],"person":[{"affno":"1","first":"Malene Hillerup","key":"jensenpau","last":"Jensen","locid":"437c1750-456a-4294-b9f4-b028e948c01a","name":"Jensen, Malene Hillerup","rank":1,"rolecode":"pau"},{"affno":"2","first":"Per-Olof","key":"wahlundpau","last":"Wahlund","name":"Wahlund, Per-Olof","rank":2,"rolecode":"pau"},{"affno":"1","first":"Katrine Nørgaard","key":"toftpau","last":"Toft","locid":"d69ab080-645b-4f55-ae16-44170b653c54","name":"Toft, Katrine Nørgaard","rank":3,"rolecode":"pau"},{"affno":"2","first":"Jes Kristian","key":"jacobsenpau","last":"Jacobsen","name":"Jacobsen, Jes Kristian","rank":4,"rolecode":"pau"},{"affno":"2","first":"Dorte Bjerre","key":"steensgaardpau","last":"Steensgaard","name":"Steensgaard, Dorte Bjerre","rank":5,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Marco","key":"vandeweertpau","last":"van de Weert","locid":"9e065089-d8db-402d-8817-9424ff2209d9","name":"van de Weert, Marco","orcid":"0000-0002-8530-6441","rank":6,"rolecode":"pau"},{"affno":"2","first":"Svend","key":"havelundpau","last":"Havelund","name":"Havelund, Svend","rank":7,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Bente","key":"vestergaardpau","last":"Vestergaard","locid":"05366427-ef50-4565-95a4-2526dfcb4e44","name":"Vestergaard, Bente","orcid":"0000-0001-8011-6414","rank":8,"rolecode":"pau"}],"pmid":["23256662"],"pub":{"doi":"10.1021/bi3008615","issn":["00062960","15204995"],"issn_org":["00062960"],"issue":"2","journal":"Biochemistry","pages":"282-94","status":"p","title":"Biochemistry","volume":"52"},"review":"Peer Reviewed","scoID":["2-s2.0-84872572711"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Novo Nordisk","Private Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-ac2039c4-0700-4e7f-9fd3-0061fe967c4d"],"src":["KU University of Copenhagen"],"title":"Small angle X-ray scattering-based elucidation of the self-association mechanism of human insulin analogue lys(B29)(N(e)¿-carboxyheptadecanoyl) des(B30)","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-496252","year":"2013","yearsub":"2013"}
{"abstract":"BACKGROUND: Depression is associated with coronary artery disease, and atherosclerosis seems to play a central role in this relation. In several studies, multislice computed tomography (CT) has been applied for detection and quantification of coronary artery calcification (CAC) in relation to depression. To our knowledge, only one previous study has investigated the relation between CAC and depression in an unselected population. METHODS: A total of 617 persons were randomly selected from the background population. The participants underwent CT of the heart and were screened for depression by use of the Major Depression Inventory questionnaire. Quantification of CAC was performed using the Agatston method. The Mann-Whitney U test, Spearman's correlational analysis, and logistic regression were used to assess the association between depression and CAC. RESULTS: The median Agatston score was not significantly different in subjects with depression than in those without depression (p = 0.783), and depression scores did not correlate significantly with Agatston scores (r = 0.023; 95% CI: -0.056-0.102; p = 0.573). This was also the case when correlational analyses were stratified by sex or age. Furthermore, after the exclusion of an outlier, no significant association between CAC and depression was found in either the unadjusted or adjusted logistic regression model, OR = 1.00 (95% CI: 0.88-1.14; p = 0.994) and OR = 1.04 (95% CI: 0.92-1.18; p = 0.529), respectively. CONCLUSIONS: Depression was not associated with CAC in an unselected middle-aged population, although a trend-level association was found in men (p = 0.086).","author_count":10,"contributors":["Devantier, Torben Albert","Nørgaard, Bjarne Linde","Sand, Niels Peter","Mols, Rikke Elmose","Foldager, Leslie","Diederichsen, Axel Cosmus Pyndt","Thomsen, Kristian Korsgaard","Jensen, Jesper Møller","Videbech, Poul"],"cuid":["S02-097.66-025654"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-CDR","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"lack of correlation between depression and coronary artery calcification in a non selected danish population","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.psym.2013.01.005","version":"Other Version"},"id":"S02-097.66-025654","identifier":[{"id":"84883776819","type":"scopus"},{"id":"23414849","type":"pmid"}],"ids":["au-b20c4381-6de4-4e73-b775-24b8f7853cc0","sdu-8df41ddd-80d9-40ab-9a4d-9a5f1bcda7b2"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-2C1DF49A708EDCF11EB9CFB0EAF3D39F"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.psym.2013.01.005","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Translational Neuropsychiatry Unit"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Esbjerg and Grindsted Hospital","SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Esbjerg and Grindsted Hospital, Research Unit of Cardiology (Esbjerg)"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1},{"affno":"4","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Torben Albert","key":"devantierpau","last":"Devantier","locid":"fcbc07d6-413f-4a92-b6fb-67763df08ced","name":"Devantier, Torben Albert","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Bjarne Linde","key":"nørgaardpau","last":"Nørgaard","locid":"6bcdb292-78dc-4e8b-9fea-814d6a6852c9","name":"Nørgaard, Bjarne Linde","orcid":"0000-0002-4758-7203","rank":2,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Niels Peter","key":"sandpau","last":"Sand","locid":"167f1566-1eb7-495f-be19-63a30a43aff1","name":"Sand, Niels Peter","rank":3,"rolecode":"pau"},{"affno":"1 4","corresponding":null,"country":"dk","first":"Rikke Elmose","key":"molspau","last":"Mols","locid":"3e2aef4e-9f9f-433c-91c5-e30cee4aa5dc","name":"Mols, Rikke Elmose","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Leslie","key":"foldagerpau","last":"Foldager","locid":"a815b9b5-4778-40b7-9686-3020f664195f","name":"Foldager, Leslie","orcid":"0000-0002-2639-826X","rank":5,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Axel Cosmus Pyndt","key":"diederichsenpau","last":"Diederichsen","locid":"d84be6bc-52bf-4710-9f66-0209cfab4f54","name":"Diederichsen, Axel Cosmus Pyndt","orcid":"0000-0002-1285-4826","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kristian","key":"korsgaardthomsenpau","last":"Korsgaard Thomsen","locid":"f50535e0-4eea-4d38-945e-d828b0b0aa99","name":"Thomsen, Kristian Korsgaard","name_org":"Korsgaard Thomsen, Kristian","orcid":"0000-0001-8909-3634","rank":7,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Kristian Korsgaard","key":"thomsenpau","last":"Thomsen","name":"Thomsen, Kristian Korsgaard","rank":7,"rolecode":"pau"},{"affno":"1 4","corresponding":null,"first":"Jesper Møller","key":"jensenpau","last":"Jensen","locid":"a5cb9465-6652-4dda-806d-a8f33c29ff82","name":"Jensen, Jesper Møller","rank":8,"rolecode":"pau"},{"affno":"1 4","corresponding":null,"first":"Poul","key":"videbechpau","last":"Videbech","locid":"5133ad1e-4d6c-49f3-9d2d-86c4cd33870a","name":"Videbech, Poul","rank":9,"rolecode":"pau"}],"pmid":["23414849"],"pub":{"doi":"10.1016/j.psym.2013.01.005","issn":["00333182","15457206"],"issn_org":["00333182"],"issue":"5","journal":"Psychosomatics","pages":"458-465","publisher":"American Psychiatric Publishing Inc.","status":"p","title":"Psychosomatics","volume":"54"},"review":"Peer Reviewed","scoID":["2-s2.0-84883776819"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-b20c4381-6de4-4e73-b775-24b8f7853cc0","sdu-8df41ddd-80d9-40ab-9a4d-9a5f1bcda7b2"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Lack of Correlation Between Depression and Coronary Artery Calcification in a Non-Selected Danish Population","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-097.66-025654","year":"2013","yearsub":"2013"}
{"abstract":"Aims: Understanding the determinants of social and coping inequalities in subclinical cardiovascular disease is an important prerequisite in developing and implementing preventive strategies. The aim of this study was to investigate the association between social factors and coping status, respectively, and subclinical coronary artery disease (CAD) in middle-aged Danes. Methods: This is a DanRisk screening substudy, thus including healthy Danish males and females aged 50 or 60 years. Social measures included grade of education, employment and co-habiting status. The coping status was estimated by the general self-efficacy (GES) scale. Coronary artery calcification (CAC) was assessed by computed tomography using the Agatston score (AS). Conventional clinical risk factors included sex, family history of CAD, BMI > 25, smoking, hypercholesterolaemia and hypertension. Results: In 568 individuals the prevalence of subjects with CAC was 267 (45%). Independent predictors of CAC in males were age (OR = 1.10, 95% CI = 1.04-1.16, p <0.001), smoking (OR = 1.75, 95% CI = 1.03-2.99, p = 0.038), and low co-habiting status (OR = 3.66, 95% CI = 1.19-11.25, p = 0.023). Independent predictors in females were age (OR = 1.67, 95% CI = 1.02-1.12, p = 0.006), and smoking (OR = 1.71, 95% CI = 1.06-2.78, p = 0.029). Higher AS was associated to lower employment level in females (p = 0.001) but not in males (p = 0.833). Conclusions: Social factors are associated to the prevalence and severity of CAC in asymptomatic middle-aged individuals with gender differences. The relative value of gender specific social versus conventional clinical risk factors in the risk assessment of subclinical CAC in middle-aged individuals needs further investigation in future prospective studies.","author_count":6,"contributors":["Mols, Rikke Elmose","Sand, Niels Peter","Jensen, Jesper Møller","Thomsen, Kristian","Diederichsen, Axel C P","Nørgaard, Bjarne Linde"],"cuid":["S02-100.00-027593"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Computed tomography","Coronary artery calcification","Coronary artery disease","Social factors"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR","DI-HO-SDR"],"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-CDR","DI-HO-SDR","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"social factors and coping status in asymptomatic middle aged danes association to coronary artery calcification","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1177/1403494813492032","version":"Other Version"},"id":"S02-100.00-027593","identifier":[{"id":"84885945004","type":"scopus"},{"id":"23740863","type":"pmid"}],"ids":["au-cdb50cf5-e1c0-4358-82d9-1339c564c2d5","sdu-ca276066-1757-489d-a40f-53c27c53f2d9"],"keyword":["Computed tomography","coping status","coronary artery calcification","coronary artery disease","social factors"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-879C259AD5C0DD5452F102ADF065B886"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1177/1403494813492032","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Esbjerg and Grindsted Hospital","SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Esbjerg and Grindsted Hospital, Research Unit of Cardiology (Esbjerg)"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1},{"affno":"4","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Cardiological Medicine B"],"nora_code":"DI-U-AU","used":1},{"affno":"5","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Sydvest Sygehus"],"nora_code":"DI-HO-SDR","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Rikke Elmose","key":"molspau","last":"Mols","name":"Mols, Rikke Elmose","rank":1,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Niels Peter","key":"sandpau","last":"Sand","locid":"167f1566-1eb7-495f-be19-63a30a43aff1","name":"Sand, Niels Peter","rank":2,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Jesper Møller","key":"jensenpau","last":"Jensen","locid":"a5cb9465-6652-4dda-806d-a8f33c29ff82","name":"Jensen, Jesper Møller","rank":3,"r