niversity Press","status":"p","title":"European Heart Journal","volume":"38"},"review":"Peer Reviewed","scoID":["2-s2.0-85016229579"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","North Denmark Region","Other Research","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-19feee68-9443-4c55-b465-07b0cd65ee1d","au-4367a92d-ce1d-47bd-9fe0-ced9b5886df3","sdu-31c8e5c6-cde2-4caa-9d59-cc09ce09180d"],"src":["AAU Aalborg University","AU Aarhus University","SDU University of Southern Denmark"],"title":"Prognostic assessment of stable coronary artery disease as determined by coronary computed tomography angiography : a Danish multicentre cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-098.87-001329","year":"2017","yearsub":"2017"}
{"abstract":"BACKGROUND: Congenital heart disease, primarily involving the left-sided structures, is often seen in patients with Turner Syndrome. Moreover, a few case reports have indicated that coronary anomalies may be more prevalent in Turner Syndrome than in the normal population. We therefore set out to systematically investigate coronary arterial anatomy by computed tomographic coronary angiography (coronary CTA) in Turner Syndrome patients. METHODS: Fifty consecutive women with Turner Syndrome (mean age 47 years [17-71]) underwent coronary CTA. Patients were compared with 25 gender-matched controls. RESULTS: Coronary anomaly was more frequent in patients with Turner Syndrome than in healthy controls [20% vs. 4% (p = 0.043)]. Nine out of ten abnormal cases had an anomalous left coronary artery anatomy (absent left main trunk, n = 7; circumflex artery originating from the right aortic sinus, n = 2). One case had a tubular origin of the right coronary artery above the aortic sinus. There was no correlation between the presence of coronary arterial anomalies and karyotype, bicuspid aortic valve, or other congenital heart defects. CONCLUSION: Coronary anomalies are highly prevalent in Turner Syndrome. The left coronary artery is predominantly affected, with an absent left main coronary artery being the most common anomaly. No hemodynamically relevant coronary anomalies were found.","author_count":10,"contributors":["Viuff, Mette Hansen","Trolle, Christian","Wen, Jan","Jensen, Jesper M","Nørgaard, Bjarne Linde","Gutmark, Ephraim J","Gutmark-Little, Iris","Mortensen, Kristian H","Gravholt, Claus Højbjerg","Andersen, Niels H"],"cuid":["S01-000.00-203407"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Europe, Non-EU","OECD"],"country":["United Kingdom","United States"],"glorg":["All Global Affiliations","Cincinnati Children's Hospital Medical Center","Great Ormond Street Hospital for Children NHS Foundation Trust"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"coronary artery anomalies in turner syndrome","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84994302294","version":"Other Version"},"id":"S01-000.00-203407","identifier":[{"id":"27522573","type":"pmid"},{"id":"84994302294","type":"scopus"}],"ids":["au-81966f6e-1bb4-4c9a-9eae-0399838eeba8"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-7B846073AA2F42475C18785BE2DCBB81"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Endocrinology and Internal Medicine"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1},{"affno":"3","country":"us","key":"cincinnati children s hospital medical center","loc":["United States","America, North","OECD"],"name":"Cincinnati Children's Hospital Medical Center","used":1},{"affno":"4","country":"gb","key":"great ormond street hospital for children nhs foundation trust","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Great Ormond Street Hospital for Children NHS Foundation Trust","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Mette H","key":"viuffpau","last":"Viuff","locid":"900a5fa0-b274-4b1e-9ba6-a04c8bdf6920","name":"Viuff, Mette Hansen","name_org":"Viuff, Mette H","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Christian","key":"trollepau","last":"Trolle","locid":"eecc7a92-66dc-4db3-a412-2746d28f75d0","name":"Trolle, Christian","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jan","key":"wenpau","last":"Wen","locid":"ba179afc-407e-4cc0-96d0-14cf49fd5a4d","name":"Wen, Jan","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper M","key":"jensenpau","last":"Jensen","locid":"82e05414-3b0f-44ed-96e1-0bae51ffdebb","name":"Jensen, Jesper M","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Bjarne L","key":"nørgaardpau","last":"Nørgaard","locid":"6bcdb292-78dc-4e8b-9fea-814d6a6852c9","name":"Nørgaard, Bjarne Linde","name_org":"Nørgaard, Bjarne L","orcid":"0000-0002-4758-7203","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ephraim J","key":"gutmarkpau","last":"Gutmark","name":"Gutmark, Ephraim J","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Iris","key":"gutmarklittlepau","last":"Gutmark-Little","name":"Gutmark-Little, Iris","rank":7,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Kristian H","key":"mortensenpau","last":"Mortensen","name":"Mortensen, Kristian H","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Claus Højbjerg","key":"gravholtpau","last":"Gravholt","locid":"22ab3957-d834-426e-8ba5-3d45496b0d2a","name":"Gravholt, Claus Højbjerg","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Niels H","key":"andersenpau","last":"Andersen","locid":"d27fd26b-7e15-4bde-a1c3-61ffaf370f05","name":"Andersen, Niels H","rank":10,"rolecode":"pau"}],"pmid":["27522573"],"pub":{"doi":"10.1016/j.jcct.2016.08.004","issn":["1876861X","19345925"],"issn_org":["19345925"],"issue":"6","journal":"Journal of Cardiovascular Computed Tomography","pages":"480-484","publisher":"Elsevier Inc.","status":"p","title":"Journal of Cardiovascular Computed Tomography","volume":"10"},"review":"Peer Reviewed","scoID":["2-s2.0-84994302294"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-81966f6e-1bb4-4c9a-9eae-0399838eeba8"],"src":["AU Aarhus University"],"title":"Coronary artery anomalies in Turner Syndrome","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-203407","year":"2016","yearsub":"2016"}
{"abstract":"AIMS: Coronary plaque characteristics are associated with ischaemia. Differences in plaque volumes and composition may explain the discordance between coronary stenosis severity and ischaemia. We evaluated the association between coronary stenosis severity, plaque characteristics, coronary computed tomography angiography (CTA)-derived fractional flow reserve (FFRCT), and lesion-specific ischaemia identified by FFR in a substudy of the NXT trial (Analysis of Coronary Blood Flow Using CT Angiography: Next Steps). METHODS AND RESULTS: Coronary CTA stenosis, plaque volumes, FFRCT, and FFR were assessed in 484 vessels from 254 patients. Stenosis >50% was considered obstructive. Plaque volumes (non-calcified plaque [NCP], low-density NCP [LD-NCP], and calcified plaque [CP]) were quantified using semi-automated software. Optimal thresholds of quantitative plaque variables were defined by area under the receiver-operating characteristics curve (AUC) analysis. Ischaemia was defined by FFR or FFRCT ≤0.80. Plaque volumes were inversely related to FFR irrespective of stenosis severity. Relative risk (95% confidence interval) for prediction of ischaemia for stenosis >50%, NCP ≥185 mm(3), LD-NCP ≥30 mm(3), CP ≥9 mm(3), and FFRCT ≤0.80 were 5.0 (3.0-8.3), 3.7 (2.4-5.6), 4.6 (2.9-7.4), 1.4 (1.0-2.0), and 13.6 (8.4-21.9), respectively. Low-density NCP predicted ischaemia independent of other plaque characteristics. Low-density NCP and FFRCT yielded diagnostic improvement over stenosis assessment with AUCs increasing from 0.71 by stenosis >50% to 0.79 and 0.90 when adding LD-NCP ≥30 mm(3) and LD-NCP ≥30 mm(3) + FFRCT ≤0.80, respectively. CONCLUSION: Stenosis severity, plaque characteristics, and FFRCT predict lesion-specific ischaemia. Plaque assessment and FFRCT provide improved discrimination of ischaemia compared with stenosis assessment alone.","author_count":16,"contributors":["Gaur, Sara","Øvrehus, Kristian A","Dey, Damini","Leipsic, Jonathon","Bøtker, Hans Erik","Jensen, Jesper Møller","Narula, Jagat","Ahmadi, Amir","Achenbach, Stephan","Ko, Brian S","Christiansen, Evald Høj","Kaltoft, Anne Kjer","Berman, Daniel S","Bezerra, Hiram","Lassen, Jens Flensted","Nørgaard, Bjarne Linde"],"cuid":["S01-000.00-135668"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Computational fluid dynamics","Computed Tomography Angiography","Coronary plaque","Fractional flow reserve","Ischaemia"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"coronary plaque quantification and fractional flow reserve by coronary computed tomography angiography identify ischaemia causing lesions","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84965156655","version":"Other Version"},"id":"S01-000.00-135668","identifier":[{"id":"84965156655","type":"scopus"},{"id":"26763790","type":"pmid"},{"id":"PMC4830909","type":"pmcid"}],"ids":["au-0b318a45-b245-4b6f-9e42-61d1325c051c"],"keyword":["Computational fluid dynamics","Computed tomography angiography","Coronary plaque","Fractional flow reserve","Ischaemia"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-E99CFCB4581D8CF55D4ABED52ABEE910"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Cardiological Medicine B"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Sara","key":"gaurpau","last":"Gaur","locid":"6330bb47-6e95-4cd6-8c84-70769abd0122","name":"Gaur, Sara","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kristian Altern","key":"øvrehuspau","last":"Øvrehus","locid":"3a9366a8-3e88-4426-95a9-c26f820f6650","name":"Øvrehus, Kristian A","name_org":"Øvrehus, Kristian Altern","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Damini","key":"deypau","last":"Dey","name":"Dey, Damini","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jonathon","key":"leipsicpau","last":"Leipsic","name":"Leipsic, Jonathon","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Hans Erik","key":"bøtkerpau","last":"Bøtker","locid":"09b03c00-11a8-4f72-800f-181f26155750","name":"Bøtker, Hans Erik","orcid":"0000-0001-6358-8962","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper Møller","key":"jensenpau","last":"Jensen","locid":"a5cb9465-6652-4dda-806d-a8f33c29ff82","name":"Jensen, Jesper Møller","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jagat","key":"narulapau","last":"Narula","name":"Narula, Jagat","rank":7,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Amir","key":"ahmadipau","last":"Ahmadi","name":"Ahmadi, Amir","rank":8,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Stephan","key":"achenbachpau","last":"Achenbach","name":"Achenbach, Stephan","rank":9,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Brian S","key":"kopau","last":"Ko","name":"Ko, Brian S","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Evald Høj","key":"christiansenpau","last":"Christiansen","locid":"06b04feb-3d2f-402d-b211-7ad5fd0387f1","name":"Christiansen, Evald Høj","orcid":"0000-0002-8740-4862","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anne Kjer","key":"kaltoftpau","last":"Kaltoft","locid":"924d4830-fac7-46ac-bc3b-5017a862adce","name":"Kaltoft, Anne Kjer","rank":12,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Daniel S","key":"bermanpau","last":"Berman","name":"Berman, Daniel S","rank":13,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Hiram","key":"bezerrapau","last":"Bezerra","name":"Bezerra, Hiram","rank":14,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens Flensted","key":"lassenpau","last":"Lassen","locid":"569ae3f1-67b8-4b02-9b3f-6469767f33e3","name":"Lassen, Jens Flensted","rank":15,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Bjarne Linde","key":"nørgaardpau","last":"Nørgaard","locid":"6bcdb292-78dc-4e8b-9fea-814d6a6852c9","name":"Nørgaard, Bjarne Linde","orcid":"0000-0002-4758-7203","rank":16,"rolecode":"pau"}],"pmid":["26763790"],"pub":{"doi":"10.1093/eurheartj/ehv690","issn":["0195668X","15229645"],"issn_org":["0195668X"],"issue":"15","journal":"European Heart Journal","pages":"1220-1227","publisher":"Oxford University Press","status":"p","title":"European Heart Journal","volume":"37"},"review":"Peer Reviewed","scoID":["2-s2.0-84965156655"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-0b318a45-b245-4b6f-9e42-61d1325c051c"],"src":["AU Aarhus University"],"title":"Coronary plaque quantification and fractional flow reserve by coronary computed tomography angiography identify ischaemia-causing lesions","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-135668","year":"2016","yearsub":"2016"}
{"abstract":"Introduction: Absence of coronary artery disease (CAD) by coronary computed tomography angiography (CTA) is associated with a favorable clinical outcome. However, whether outcomes for patients without obstructive CAD are comparable to prognosis in the general population is unknown. We therefore compared the sex- and agerelated risk of myocardial infarction (MI) or all-cause mortality in patients without or with non-obstructive CAD with that of the general population. Methods: Consecutive patients without known coronary artery disease (CAD) and with chest pain who underwent coronary CTA (>64-detector row) between January 2007 and December 2012 in the 10 centers participating in the Western Denmark Cardiac Computed Tomography Registry were included. Patients were followed for a median (interquartile range [IQR]) period of 2.6 (1.7-3.5) years. During follow-up, MI and death were registered. Coronary CTA results were defined as normal (no luminal stenosis) or non-obstructive CAD (1%-49% luminal stenosis). Each patient was matched by sex, age, and municipality with 10 persons from the general population. Cox regression was used to compute hazard ratios (HRs) with 95% confidence intervals (CIs) as measures of the relative risk of the endpoints, adjusting for age, diabetes, use of lipid-lowering or antihypertensive medications, and comorbidity as assessed by the Charlson Comorbidity index. Results: The study cohort comprised 14,271 patients (median age [IQR]: 57 [49-65]; 58.9% women) and a general population comparison cohort of 142,698 persons. More men than women had non-obstructive CAD (40.5% vs. 30.1%) and more women than men were without CAD (69.9% vs. 59.5%). Women 65 years with no or non-obstructive CAD had lower mortality risks than the general population [HR: 0.37 (95% CI, 0.21-0.67) and HR: 0.48 (0.29-0.78), respectively], but no difference was present regarding the risk of MI. Men without or with CAD did not differ in risk of MI or death, regardless of age, when compared to the general population. Conclusion: Women 65 years without or with non-obstructive CAD have a lower mortality risk than women from the general population. When compared to the general population, men without or with CAD did not, irrespective of age, differ regarding the risk of MI or death.","author_count":10,"contributors":["Nielsen, L.","Botker, H. E.","Sorensen, H.","Schmidt, M.","Pedersen, L.","Sand, Niels Peter","Jensen, J.","Øvrehus, Kristian Altern","Hald, F.","Norgaard, B."],"cuid":["S01-000.00-614909"],"event":{"end":"2015-07-19","place":"Las Vegas, Nevada, us","start":"2015-07-16","title":"10th Annual Scientific Meeting of the Society of Cardiovascular Computed Tomography","year":"2015"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-CDR","DI-HO-SDR","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"coronary computed tomography angiography in symptomatic patients without obstructive coronary artery disease sex and age related differences in prognosis","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://doi.org/10.1016/j.jcct.2015.05.006","version":"Other Version"},"id":"S01-000.00-614909","ids":["sdu-91805107-c2d3-4533-b769-9a70bfa596f3"],"keyword":["*computer assisted tomography *patient *prognosis *human *coronary artery disease *angiography *society female population risk male death mortality stenosis follow up register comorbidity Denmark diabetes mellitus thorax pain risk factor confidence interval hazard ratio proportional hazards model heart infarction drug therapy Charlson Comorbidity Index antihypertensive agent lipid"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-32DC86132ACB4866D87A9340D907CDEE"],"org":[{"affno":"1","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Esbjerg and Grindsted Hospital","SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Esbjerg and Grindsted Hospital, Research Unit of Cardiology (Esbjerg)"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Sygehus Lillebælt"],"nora_code":"DI-HO-SDR","used":1}],"person":[{"affno":"1","corresponding":null,"first":"L.","key":"nielsenpau","last":"Nielsen","name":"Nielsen, L.","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"H. E.","key":"botkerpau","last":"Botker","name":"Botker, H. E.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"H.","key":"sorensenpau","last":"Sorensen","name":"Sorensen, H.","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"M.","key":"schmidtpau","last":"Schmidt","name":"Schmidt, M.","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"L.","key":"pedersenpau","last":"Pedersen","name":"Pedersen, L.","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"N. P.","key":"sandpau","last":"Sand","locid":"167f1566-1eb7-495f-be19-63a30a43aff1","name":"Sand, Niels Peter","name_org":"Sand, N. P.","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"J.","key":"jensenpau","last":"Jensen","name":"Jensen, J.","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"K.","key":"ovrehuspau","last":"Ovrehus","locid":"aec90a0e-8351-489e-8ab9-7b0829c8f1a6","name":"Øvrehus, Kristian Altern","name_org":"Ovrehus, K.","orcid":"0000-0003-2454-5446","rank":8,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"F.","key":"haldpau","last":"Hald","name":"Hald, F.","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"B.","key":"norgaardpau","last":"Norgaard","name":"Norgaard, B.","rank":10,"rolecode":"pau"}],"pub":{"issn":["1876861X","19345925"],"issn_org":["19345925"],"issue":"4 (Supplement)","journal":"Journal of Cardiovascular Computed Tomography","paperid":"98","publisher":"Elsevier","status":"p","title":"Journal of Cardiovascular Computed Tomography","volume":"9"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-91805107-c2d3-4533-b769-9a70bfa596f3"],"src":["SDU University of Southern Denmark"],"title":"Coronary computed tomography angiography in symptomatic patients without obstructive coronary artery disease : Sex-and age-related differences in prognosis","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-614909","year":"2015","yearsub":"2015"}
{"abstract":"Introduction: Coronary CT angiography (CTA) detects non-obstructive coronary artery disease (CAD) that may not be recognized by functional testing, but the prognostic impact is not well understood. This study aimed to compare the risk of myocardial infarction (MI) and all-cause mortality in patients without or with non-obstructive and obstructive CAD assessed by coronary CTA. Methods: Consecutive patients without known coronary artery disease (CAD) and with chest pain who underwent coronary CTA (>64-detector row) between January 2007 and December 2012 in the 10 centers participating in the Western Denmark Cardiac Computed Tomography Registry were included. The endpoints were 3-year MI or all-cause mortality. The coronary CTA result was defined as normal (0% luminal stenosis), non-obstructive CAD (1%-49% luminal stenosis) or obstructive CAD (>50% luminal stenosis; 1-vessel, 2-vessel, or 3-vessel/left main [LM]). The severity of non-obstructive CAD was assessed by the Agatston score (Ag) and categorized as zero, low (Ag, 1-99), moderate (Ag, 100-399), or high (Ag, >400). Cox regression was used to compute hazard ratios (HRs) with 95% confidence intervals (CIs) as measures of the relative risk for the occurrence of endpoints, adjusting for age, sex, conventional cardiac risk factors, comorbidity as assessed by the Charlson Comorbidity Index, and concurrent cardiovascular medical treatment. Results: Among 16,891 patients, 9,368 patients (55.4%) did not have CAD, 4,774 patients (28.3%) had non-obstructive CAD, and 2,749 patients (16.3%) had obstructive CAD. A total of 125 patients developed a MI and 148 patients died, respectively. In patients with non-obstructive CAD, no events occurred in patients with Ag=0, whereas those with moderate (HR: 1.70, 95% CI: 1.34-2.14) or high (HR: 4.35, 95% CI: 3.35-5.65) Ag levels had an increased risk of subsequent MI when compared to patients without CAD. In addition, the risk of MI was increased among patients with 1-, 2-, and 3- vessel/LM obstructive disease with HRs of 4.31 (95% CI: 3.70-5.02), 4.55 (95% CI: 3.72-5.56), and 6.07 (95% CI: 4.76-7.74), respectively. We found no significant differences in mortality risk for patients with non-obstructive CAD with Ag=0, a low or moderate Ag, and 1- or 2- vessel CAD when compared to patients without CAD, whereas mortality was associated with the presence of non-obstructive CAD with high Ag (HR: 2.96, 95% CI: 2.47-3.55) and 3-vessel/LM CAD (HR: 2.83, 95% CI: 2.32-3.45), respectively. Conclusion: In patients with non-obstructive CAD, Ag >400 was associated with an increased three-year risk of MI, similar to the risk in patients with 1- or 2-vessel obstructive CAD. Moreover, in patients with non-obstructive CAD and high Ag, mortality was comparable to the risk in patients with 3- vessel/LM obstructive CAD.","author_count":10,"contributors":["Nielsen, L.","Bøtker, H. E.","Sorensen, H.","Schmidt, M.","Pedersen, L.","Sand, Niels Peter","Jensen, J.","Øvrehus, Kristian Altern","Hald, F.","Norgaard, B."],"cuid":["S01-000.00-581767"],"event":{"end":"2015-07-19","place":"Las Vegas, Nevada, us","start":"2015-07-16","title":"10th Annual Scientific Meeting of the Society of Cardiovascular Computed Tomography","year":"2015"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-CDR","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"non obstructive coronary artery disease assessed by coronary computed tomography angiography prognostic implications","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://doi.org/10.1016/j.jcct.2015.05.006","version":"Other Version"},"id":"S01-000.00-581767","ids":["sdu-1dde82c2-309e-42a8-a672-be1a5e547144"],"keyword":["*computer assisted tomography *angiography *society *coronary artery disease human patient risk mortality stenosis risk factor heart infarction computed tomographic angiography Agatston score Denmark thorax pain register comorbidity confidence interval proportional hazards model hazard ratio Charlson Comorbidity Index therapy silver"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-F06D8CC7872447E59276E92DFED25E07"],"org":[{"affno":"1","country":"dk","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["University of Southern Denmark"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1}],"person":[{"affno":"1","corresponding":null,"first":"L.","key":"nielsenpau","last":"Nielsen","name":"Nielsen, L.","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"H. E.","key":"bøtkerpau","last":"Bøtker","name":"Bøtker, H. E.","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"H.","key":"sorensenpau","last":"Sorensen","name":"Sorensen, H.","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"M.","key":"schmidtpau","last":"Schmidt","name":"Schmidt, M.","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"L.","key":"pedersenpau","last":"Pedersen","name":"Pedersen, L.","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"N. P.","key":"sandpau","last":"Sand","locid":"167f1566-1eb7-495f-be19-63a30a43aff1","name"