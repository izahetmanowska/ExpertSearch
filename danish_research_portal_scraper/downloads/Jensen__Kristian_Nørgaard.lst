0a","name":"Winther, Lars","orcid":"0000-0002-6939-0903","rank":3,"rolecode":"pau"},{"affno":"","first":"Gertrud","key":"jørgensenpedh","last":"Jørgensen","name":"Jørgensen, Gertrud","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Lars","key":"wintherpedh","last":"Winther","name":"Winther, Lars","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Ellen Højgaard","key":"jensenpedh","last":"Jensen","name":"Jensen, Ellen Højgaard","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Michael","key":"nørgaardpedh","last":"Nørgaard","name":"Nørgaard, Michael","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Kamilla Stener","key":"møllerpedh","last":"Møller","name":"Møller, Kamilla Stener","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Sara","key":"folvigpedh","last":"Folvig","name":"Folvig, Sara","rank":9,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"eisbn":["9788790413408"],"isbn":["9788790413408"],"pages":"15-21","status":"p","title":"Gentænk byen"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-e59672c2-8580-4fd9-9bd6-bf5b29459a26"],"src":["KU University of Copenhagen"],"title":"Metroens København : Geografisk omstrukturering og ulige bymæssig beskæftigelsesvækst","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-530535","year":"2020","yearsub":"2020"}
{"abstract":"Global warming occurs at elevated rates in the Arctic. Continued warming is predicted to cause ecosystem-wide cascading effects as boreal species expand into the region. However, current species distribution and knowledge of drivers affecting community structure are largely unknown, and little is therefore known about the resilience of Arctic marine ecosystems to environmental change. The West Greenland coast is north-south orientated, which provides an ideal setting to study the impact of climate change on ecosystem dynamics and species distribution. We used this coastline to investigated latitudinal changes in the rocky intertidal ecosystem along 12° of latitude, from the subarctic to High Arctic (60–72°N). Using 320 cleared quadrats we quantified patterns in rocky intertidal assemblage composition, biomass and coverage in six regions. We related the level and variation in assemblage composition, biomass and coverage to multiple latitudinal-scale environmental drivers. We show that across all latitudes, the intertidal assemblage is dominated by a core of stress-tolerant foundation species, and we describe the effects of the investigated environmental drivers, and demonstrate that although mean biomasses decreased >50% from south to north, local biomass in excess of 10 000 g ww m-2 is found even in north Greenland, demonstrating the patchiness of this habitat. The results furthermore show that the effect of small-scale variation in environmental characteristics may be of same magnitude as large-scale variation. Hence, using the latitudinal gradient in a space-for-time substitution, our results suggest that while climate modification may lead to an overall increase in the intertidal biomass in north Greenland, it is unlikely to drive dramatic functional changes in ecosystem structure in the near future. Our dataset provides an important baseline for future studies to verify these predictions for Greenland’s intertidal zone.","author_count":10,"contributors":["Thyrring, Jakob","Blicher, Martin E.","Krause-Jensen, Dorte","Høgslund, Signe","Olesen, Birgit","Wiktor Jr., Jozef","Mouritsen, Kim Nørgaard","Peck, Lloyd S","Wegeberg, Susse","Sejr, Mikael Kristian"],"cuid":["S01-000.00-247201"],"event":{"end":"2020-12-10","place":"Online","start":"2020-12-07","title":"Arctic Change 2020","year":"2020"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Europe, Non-EU","Nordic","OECD"],"country":["Greenland","United Kingdom","United States"],"glorg":["All Global Affiliations","British Antarctic Survey","Greenland Institute of Natural Resources","University of California at Berkeley"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"nr","rtype":["clu"],"sorti":"latitudinal patterns in intertidal ecosystem structure in west greenland suggest resilience to climate change","src":["au"],"src-code":["DI-U-AU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-247201","ids":["au-ce39b259-1b90-4530-9ad0-95f2ceb1bf8a"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-FE7B58E8A98C4394C81D8BD13625FAF8"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Arctic Research Centre","Aarhus University, Technical Sciences, Department of Ecoscience, Department of Ecoscience - Marine Ecology"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"us","key":"university of california at berkeley","loc":["United States","America, North","OECD"],"name":"University of California at Berkeley","used":1},{"affno":"3","country":"gl","key":"greenland institute of natural resources","loc":["Greenland","Nordic"],"name":"Greenland Institute of Natural Resources","used":1},{"affno":"4","country":"gb","key":"british antarctic survey","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"British Antarctic Survey","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"Jakob","key":"thyrringpau","last":"Thyrring","locid":"85aae02b-373b-47d4-9fdb-5afb22b7d85c","name":"Thyrring, Jakob","orcid":"0000-0002-1029-3105","rank":1,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Martin E.","key":"blicherpau","last":"Blicher","name":"Blicher, Martin E.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Dorte","key":"krausejensenpau","last":"Krause-Jensen","locid":"f866cf43-1206-44ac-98aa-dd2f160cc85c","name":"Krause-Jensen, Dorte","orcid":"0000-0001-9792-256X","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Signe","key":"høgslundpau","last":"Høgslund","locid":"a16b561b-3a9e-45a8-b2df-b298312e4ab1","name":"Høgslund, Signe","orcid":"0000-0001-5926-8464","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Birgit","key":"olesenpau","last":"Olesen","locid":"adb70a49-eced-4c10-ac96-9fcffe90e6b3","name":"Olesen, Birgit","orcid":"0000-0002-8864-6716","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jozef","key":"wiktorjrpau","last":"Wiktor Jr.","name":"Wiktor Jr., Jozef","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kim Nørgaard","key":"mouritsenpau","last":"Mouritsen","locid":"8b86816b-2691-4a1c-9bf8-bd1bd7a646fd","name":"Mouritsen, Kim Nørgaard","orcid":"0000-0003-3564-8328","rank":7,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Lloyd S","key":"peckpau","last":"Peck","name":"Peck, Lloyd S","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Susse","key":"wegebergpau","last":"Wegeberg","locid":"05370847-e1d3-4253-b818-046251260ff5","name":"Wegeberg, Susse","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mikael Kristian","key":"sejrpau","last":"Sejr","locid":"6c688ffc-6794-4482-b9b9-131b3dbf4206","name":"Sejr, Mikael Kristian","orcid":"0000-0001-8370-5791","rank":10,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-ce39b259-1b90-4530-9ad0-95f2ceb1bf8a"],"src":["AU Aarhus University"],"title":"Latitudinal patterns in intertidal ecosystem structure in West Greenland suggest resilience to climate change","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-247201","year":"2020","yearsub":"2020"}
{"abstract":"This paper describes our system to assess humour intensity in edited news headlines as part of a participation in the 7th task of SemEval-2020 on “Humor, Emphasis and Sentiment”. Various factors need to be accounted for in order to assess the funniness of an edited headline. We propose an architecture that uses hand-crafted features, knowledge bases and a language model to understand humour, and combines them in a regression model. Our system outperforms two baselines. In general, automatic humour assessment remains a difficult task.","author_count":5,"contributors":["Jensen, Kristian Nørgaard","Filrup Rasmussen, Nicolaj","Wang, Thai","Placenti, Marco","Plank, Barbara"],"cuid":["S01-000.00-382419"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Regression model","SemEval 2020","automatic humour detection","edited news headlines","humour intensity assessment"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"buhscitu at semeval 000000002020 task 000000000007 assessing humour in edited news headlines using hand crafted features and online knowledge bases","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/85236663/Final_SemEval2020_Task7.pdf","version":"Authors Final Version"},"id":"S01-000.00-382419","ids":["itu-4cecc8ae-b3db-4a37-b01e-dbb700caec50"],"keyword":["SemEval-2020","automatic humour detection","edited news headlines","humour intensity assessment","regression model"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-94ACF425A8FE547EC8F311E1DE30CB3A"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/85236663/Final_SemEval2020_Task7.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NLPnorth"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Kristian Nørgaard","key":"jensenpau","last":"Jensen","locid":"04344edd-2f02-45d5-ad45-baffe4c08898","name":"Jensen, Kristian Nørgaard","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Nicolaj","key":"filruprasmussenpau","last":"Filrup Rasmussen","name":"Filrup Rasmussen, Nicolaj","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Thai","key":"wangpau","last":"Wang","name":"Wang, Thai","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Marco","key":"placentipau","last":"Placenti","name":"Placenti, Marco","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":5,"rolecode":"pau"}],"pub":{"publisher":"Association for Computational Linguistics","status":"p","title":"SemEval"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-4cecc8ae-b3db-4a37-b01e-dbb700caec50"],"src":["ITU IT University of Copenhagen"],"title":"Buhscitu at SemEvaL-2020 Task 7: Assessing Humour in Edited News Headlines using Hand-Crafted Features and Online Knowledge Bases","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382419","year":"2020","yearsub":"2020"}
{"abstract":"OBJECTIVES: The 1-year data from the international ADVANCE (Assessing Diagnostic Value of Non-invasive FFRCT in Coronary Care) Registry of patients undergoing coronary computed tomography angiography (CTA) was used to evaluate the relationship of fractional flow reserve derived from coronary CTA (FFRCT) with downstream care and clinical outcomes. BACKGROUND: Guidelines for management of chest pain using noninvasive imaging pathways are based on short- to intermediate-term outcomes. METHODS: Patients (N = 5,083) evaluated for clinically suspected coronary artery disease and in whom atherosclerosis was identified by coronary CTA were prospectively enrolled at 38 international sites from July 15, 2015, to October 20, 2017. Demographics, symptom status, coronary CTA and FFRCT findings and resultant site-based treatment plans, and clinical outcomes through 1 year were recorded and adjudicated by a blinded core laboratory. Major adverse cardiac events (MACE), death, myocardial infarction (MI), and acute coronary syndrome leading to urgent revascularization were captured. RESULTS: At 1 year, 449 patients did not have follow-up data. Revascularization occurred in 1,208 (38.40%) patients with an FFRCT ≤0.80 and in 89 (5.60%) with an FFRCT >0.80 (relative risk [RR]: 6.87; 95% confidence interval [CI]: 5.59 to 8.45; p < 0.001). MACE occurred in 55 patients, 43 events occurred in patients with an FFRCT ≤0.80 and 12 occurred in those with an FFRCT >0.80 (RR: 1.81; 95% CI: 0.96 to 3.43; p = 0.06). Time to first event (all-cause death or MI) occurred in 38 (1.20%) patients with an FFRCT ≤0.80 compared with 10 (0.60%) patients with an FFRCT >0.80 (RR: 1.92; 95% CI: 0.96 to 3.85; p = 0.06). Time to first event (cardiovascular death or MI) occurred cardiovascular death or MI occurred more in patients with an FFRCT ≤0.80 compared with patients with an FFRCT >0.80 (25 [0.80%] vs. 3 [0.20%]; RR: 4.22; 95% CI: 1.28 to 13.95; p = 0.01). CONCLUSIONS: The 1-year outcomes from the ADVANCE FFRCT Registry show low rates of events in all patients, with less revascularization and a trend toward lower MACE and significantly lower cardiovascular death or MI in patients with a negative FFRCT compared with patients with abnormal FFRCT values. (Assessing Diagnostic Value of Non-invasive FFRCT in Coronary Wave [ADVANCE]; NCT02499679).","author_count":23,"contributors":["Patel, Manesh R","Nørgaard, Bjarne Linde","Fairbairn, Timothy A","Nieman, Koen","Akasaka, Takashi","Berman, Daniel S","Raff, Gilbert L","Hurwitz Koweek, Lynne M","Pontone, Gianluca","Kawasaki, Tomohiro","Sand, Niels Peter Rønnow","Jensen, Jesper Møller","Amano, Tetsuya","Poon, Michael","Øvrehus, Kristian A","Sonck, Jeroen","Rabbat, Mark G","Mullen, Sarah","De Bruyne, Bernard","Rogers, Campbell","Matsuo, Hitoshi","Bax, Jeroen J","Leipsic, Jonathon"],"cuid":["S02-100.00-018766"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","Asia, East","Europe, EU","Europe, Non-EU","OECD"],"corresponding_author":["Patel, Manesh R"],"country":["Belgium","Canada","Italy","Japan","Netherlands","United Kingdom","United States"],"glorg":["Aichi Medical University","All Global Affiliations","Cardiovascular Center Aalst","Cardiovascular Center Aalst, OLV Clinic, Aalst, Belgium","Cedars-Sinai Medical Center","Duke University","Duke University School of Medicin","Gifu Heart Center","Heartflow Inc.","IRCCS Centro Cardiologico S.P.A. Fondazione Monzino - Milano","Leiden University","Leiden University Medical Center","Liverpool Heart and Chest Hospital NHS Foundation Trust","Loyola University","Loyola University Chicago","Northwell Health","Shin Koga Hospital","Shin Koga Hospital, Fukuoka, Japan.","St. Paul's Hospital","Stanford University","University of California at Berkeley","University of Liverpool","University of Milan","University of Naples Federico II","Wakayama Medical University"],"keyword":["Clinical outcomes","Clinical practice","Coronary computed tomography angiography","FFR","Fractional flow reserve","Major adverse cardiac events"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"OT":["Division of Nuclear Imaging, Department of Imaging, Cedars-Sinai Heart Institute, Los Angeles, California."],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-CDR","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"000000000001 year impact on medical practice and clinical outcomes of ffrct the advance registry","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.jcmg.2019.03.003","version":"Published Version"},"id":"S02-100.00-018766","identifier":[{"id":"31005540","type":"pmid"},{"id":"85076857169","type":"scopus"}],"ids":["au-53908497-3a2f-4577-a70f-aae70c1b70c2","sdu-9454ea2e-f21c-420e-bd05-e556b4d13f42"],"keyword":["FFR","clinical outcomes","clinical practice","coronary computed tomography angiography","fractional flow reserve","major adverse cardiac events"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-BD4F1F761841EFCC65EE7D0E2CF17FD6"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://pure.au.dk/ws/files/220347706/1_s2.0_S1936878X1930227X_main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.jcmg.2019.03.003","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/159111593/1_s2.0_S1936878X1930227X_main.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"us","key":"duke university","loc