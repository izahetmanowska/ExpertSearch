nker","locid":"6264f415-f938-426e-97fe-34dd6a53301a","name":"Junker, Anders","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kristian","key":"korsgaardthomsenpau","last":"Korsgaard Thomsen","locid":"f50535e0-4eea-4d38-945e-d828b0b0aa99","name":"Thomsen, Kristian Korsgaard","name_org":"Korsgaard Thomsen, Kristian","orcid":"0000-0001-8909-3634","rank":7,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"A.","key":"roholdpau","last":"Rohold","name":"Rohold, A.","rank":8,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Søren","key":"hesspau","last":"Hess","name":"Hess, Søren","rank":9,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Bjarne Linde","key":"nørgaardpau","last":"Nørgaard","name":"Nørgaard, Bjarne Linde","rank":10,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Pia Veldt","key":"larsenpau","last":"Larsen","locid":"d6c16700-b7c7-4172-a8df-3e726624dc36","name":"Larsen, Pia Veldt","orcid":"0000-0002-8730-3703","rank":11,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Niels Peter","key":"rønnowsandpau","last":"Rønnow Sand","locid":"167f1566-1eb7-495f-be19-63a30a43aff1","name":"Sand, Niels Peter","name_org":"Rønnow Sand, Niels Peter","rank":12,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-eec117f6-1efe-4eb6-8e7d-245cb8020ba9"],"src":["SDU University of Southern Denmark"],"title":"Prediction of standard of care guided coronary revascularisation by FFR CT is preserved across a broad range of coronary calcification","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-641591","year":"2017","yearsub":"2017"}
{"abstract":"BACKGROUND: Population studies report increased cardiovascular mortality in patients with cirrhosis. Coronary artery disease may be a trait of end-stage liver disease, but whether it is frequent or extensive in cirrhosis in general is unknown. Thus, we aimed to assess the prevalence and extent of coronary artery disease in unselected cirrhosis patients. MATERIALS AND METHODS: Using coronary computed tomography angiography, we investigated 52 patients from all Child-Pugh classes and aetiologies of cirrhosis without known cardiac disease for presence and severity of coronary artery disease in a cross-sectional design. Persons referred with new-onset chest pain served as controls. RESULTS: The prevalence of coronary artery disease was not significantly different between cirrhosis patients and controls (77% vs. 65%, P=0·19). However, cirrhosis patients had a markedly higher coronary artery calcification (Agatston) score than controls (120 [interquartile range, 0-345] vs. 5 [interquartile range, 0-86] HU, P=0·001). Likewise, patients with cirrhosis had a higher prevalence of extensive (≥5 coronary segments involved; 45% vs. 18%, P=0·01) and multivessel coronary disease (≥2 vessels involved; 75% vs. 53%, P=0·02). Furthermore, the total plaque volume whether noncalcified or calcified was higher in cirrhosis (117 [interquartile range, 0-310] vs. 36 [interquartile range, 0-148] mm(3) , P=0·02). CONCLUSION: Coronary artery disease is equally prevalent in patients with cirrhosis and subjects with new-onset chest pain, but cirrhosis patients have more extensive and severe disease including several coronary high-risk features associated with myocardial ischaemia and a poor clinical outcome. The potential of preventive measures for coronary artery disease in cirrhosis needs attention.","author_count":10,"contributors":["Kazankov, Konstantin","Munk, Kim","Øvrehus, Kristian Altern","Jensen, Jesper Møller","Siggaard, Cecilie Brøckner","Grønbæk, Henning","Nørgaard, Bjarne Linde","Vilstrup, Hendrik"],"cuid":["S02-093.11-016051"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Atherosclerosis","Journal Article","Liver disease","Plaque","coronary CT angiography"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-CDR","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"high burden of coronary atherosclerosis in patients with cirrhosis","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85024368761","version":"Other Version"},"id":"S02-093.11-016051","identifier":[{"id":"28657113","type":"pmid"},{"id":"85024368761","type":"scopus"}],"ids":["au-2f729ae6-3921-4957-a833-cbd696db3a00","sdu-98c110d1-d41b-4615-887b-e228ab343b03"],"keyword":["Atherosclerosis","Journal Article","coronary CT angiography","liver disease","plaque"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-BAA330DB161B316E29C11CC592DBE2C2"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Hepatology and Gastroenterology"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Cardiology (Odense)","SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Lillebælt Hospital, Research Unit of Cardiology (Kolding)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"Konstantin","key":"kazankovpau","last":"Kazankov","locid":"2541c95c-8f7c-43d9-a5a2-17b616d69e9a","name":"Kazankov, Konstantin","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Kim","key":"munkpau","last":"Munk","locid":"8eeb2188-f5fb-4f11-bd38-8e3d5c7750da","name":"Munk, Kim","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Kristian Altern","key":"ovrehuspau","last":"Ovrehus","locid":"aec90a0e-8351-489e-8ab9-7b0829c8f1a6","name":"Øvrehus, Kristian Altern","name_org":"Ovrehus, Kristian Altern","orcid":"0000-0003-2454-5446","rank":3,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Jesper Møller","key":"jensenpau","last":"Jensen","locid":"a5cb9465-6652-4dda-806d-a8f33c29ff82","name":"Jensen, Jesper Møller","rank":4,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Cecilie Brøckner","key":"siggaardpau","last":"Siggaard","locid":"2a2e949d-d6b8-43d1-a35a-6c85220145fe","name":"Siggaard, Cecilie Brøckner","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henning","key":"grønbaekpau","last":"Grønbaek","locid":"32aaf9c5-5cf0-4e7b-86d8-a534fa4a9ae9","name":"Grønbæk, Henning","name_org":"Grønbaek, Henning","orcid":"0000-0001-8998-7910","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Henning","key":"gronbaekpau","last":"Gronbaek","name":"Gronbaek, Henning","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Bjarne Linde","key":"nørgaardpau","last":"Nørgaard","locid":"6bcdb292-78dc-4e8b-9fea-814d6a6852c9","name":"Nørgaard, Bjarne Linde","orcid":"0000-0002-4758-7203","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Bjarne Linde","key":"norgaardpau","last":"Norgaard","name":"Norgaard, Bjarne Linde","rank":7,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Hendrik","key":"vilstruppau","last":"Vilstrup","locid":"9e1905f3-3094-4aea-bbde-7178733bf6cb","name":"Vilstrup, Hendrik","rank":8,"rolecode":"pau"}],"pmid":["28657113"],"pub":{"doi":"10.1111/eci.12777","issn":["00142972","0960135X"],"issn_org":["00142972"],"issue":"8","journal":"European Journal of Clinical Investigation","pages":"565-573","publisher":"John Wiley & Sons Inc.","status":"p","title":"European Journal of Clinical Investigation","volume":"47"},"review":"Peer Reviewed","scoID":["2-s2.0-85024368761"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-2f729ae6-3921-4957-a833-cbd696db3a00","sdu-98c110d1-d41b-4615-887b-e228ab343b03"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"High burden of coronary atherosclerosis in patients with cirrhosis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-093.11-016051","year":"2017","yearsub":"2017"}
{"abstract":"AIMS: To examine the 3.5 year prognosis of stable coronary artery disease (CAD) as assessed by coronary computed tomography angiography (CCTA) in real-world clinical practice, overall and within subgroups of patients according to age, sex, and comorbidity. METHODS AND RESULTS: This cohort study included 16,949 patients (median age 57 years; 57% women) with new-onset symptoms suggestive of CAD, who underwent CCTA between January 2008 and December 2012. The endpoint was a composite of late coronary revascularization procedure >90 days after CCTA, myocardial infarction, and all-cause death. The Kaplan-Meier estimator was used to compute 91 day to 3.5 year risk according to the CAD severity. Comparisons between patients with and without CAD were based on Cox-regression adjusted for age, sex, comorbidity, cardiovascular risk factors, concomitant cardiac medications, and post-CCTA treatment within 90 days. The composite endpoint occurred in 486 patients. Risk of the composite endpoint was 1.5% for patients without CAD, 6.8% for obstructive CAD, and 15% for three-vessel/left main disease. Compared with patients without CAD, higher relative risk of the composite endpoint was observed for non-obstructive CAD [hazard ratio (HR): 1.28; 95% confidence interval (CI): 1.01-1.63], obstructive one-vessel CAD (HR: 1.83; 95% CI: 1.37-2.44), two-vessel CAD (HR: 2.97; 95% CI: 2.09-4.22), and three-vessel/left main CAD (HR: 4.41; 95% CI :2.90-6.69). The results were consistent in strata of age, sex, and comorbidity. CONCLUSION: Coronary artery disease determined by CCTA in real-world practice predicts the 3.5 year composite risk of late revascularization, myocardial infarction, and all-cause death across different groups of age, sex, or comorbidity burden.","author_count":23,"contributors":["Nielsen, Lene H","Bøtker, Hans Erik","Sørensen, Henrik T","Schmidt, Morten","Pedersen, Lars","Sand, Niels Peter","Jensen, Jesper M","Steffensen, Flemming H","Tilsted, Hans-Henrik","Bøttcher, Morten","Diederichsen, Axel","Lambrechtsen, Jess","Kristensen, Lone D","Øvrehus, Kristian A","Mickley, Hans","Munkholm, Henrik","Gøtzsche, Ole","Husain, Majed","Knudsen, Lars L","Nørgaard, Bjarne L"],"cuid":["S03-098.87-001329"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"keyword":["Comorbidity","Coronary atherosclerosis","Coronary computed tomography angiography","Journal Article","Prognosis","Stable angina"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR"],"OT":["Department of Cardiology, Lillebaelt Hospital-Vejle, Kabbeltoft 25, DK-7100 Vejle, Denmark lenehuche@gmail.com."],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-U-AAU","DI-U-AU","DI-U-SDU","Department of Cardiology, Lillebaelt Hospital-Vejle, Kabbeltoft 25, DK-7100 Vejle, Denmark lenehuche@gmail.com."]},"review":"pr","rtype":["clu"],"sorti":"prognostic assessment of stable coronary artery disease as determined by coronary computed tomography angiography a danish multicentre cohort study","src":["aau","au","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85016229579","version":"Other Version"},"id":"S03-098.87-001329","identifier":[{"id":"85016229579","type":"scopus"},{"id":"27941018","type":"pmid"},{"id":"000396778000004","type":"wos"}],"ids":["aau-19feee68-9443-4c55-b465-07b0cd65ee1d","au-4367a92d-ce1d-47bd-9fe0-ced9b5886df3","sdu-31c8e5c6-cde2-4caa-9d59-cc09ce09180d"],"keyword":["Comorbidity","Coronary atherosclerosis","Coronary computed tomography angiography","Journal Article","Prognosis","Stable angina"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-11