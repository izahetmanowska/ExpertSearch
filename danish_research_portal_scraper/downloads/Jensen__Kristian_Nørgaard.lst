ensen, Jesper Møller","name_org":"Jensen, Jesper M","rank":5,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Bjarne L","key":"nørgaardpau","last":"Nørgaard","locid":"6bcdb292-78dc-4e8b-9fea-814d6a6852c9","name":"Nørgaard, Bjarne Linde","name_org":"Nørgaard, Bjarne L","orcid":"0000-0002-4758-7203","rank":6,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Lidia R.","key":"bonspau","last":"Bons","name":"Bons, Lidia R.","rank":7,"rolecode":"pau"},{"affno":"5 6","corresponding":null,"first":"Anthonie L.","key":"duijnhouwerpau","last":"Duijnhouwer","name":"Duijnhouwer, Anthonie L.","rank":8,"rolecode":"pau"},{"affno":"7 8","corresponding":null,"first":"Damini","key":"deypau","last":"Dey","name":"Dey, Damini","rank":9,"rolecode":"pau"},{"affno":"9 10","corresponding":null,"first":"Kristian H.","key":"mortensenpau","last":"Mortensen","name":"Mortensen, Kristian H.","rank":10,"rolecode":"pau"},{"affno":"11","corresponding":null,"first":"Niels H.","key":"andersenpau","last":"Andersen","locid":"2ad49cf0-816e-43f4-991a-a0d3369f437e","name":"Andersen, Niels Holmark","name_org":"Andersen, Niels H.","orcid":"0000-0002-5394-3016","rank":11,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Jolien W.","key":"rooshesselinkpau","last":"Roos-Hesselink","name":"Roos-Hesselink, Jolien W.","rank":12,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Claus H","key":"gravholtpau","last":"Gravholt","locid":"22ab3957-d834-426e-8ba5-3d45496b0d2a","name":"Gravholt, Claus Højbjerg","name_org":"Gravholt, Claus H","rank":13,"rolecode":"pau"}],"pmid":["32613319"],"pub":{"doi":"10.1007/s00380-020-01660-7","issn":["09108327","0935736X"],"issn_org":["09108327"],"issue":"1","journal":"Heart and Vessels","pages":"14-23","publisher":"Springer","status":"p","title":"Heart and Vessels","volume":"36"},"review":"Peer Reviewed","scoID":["2-s2.0-85087317925"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Ho