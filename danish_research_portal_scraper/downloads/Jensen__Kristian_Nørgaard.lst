","name":"Nieman, Koen","rank":16,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Erik","key":"parnerpau","last":"Parner","locid":"e20f05d3-5aaf-498a-a0f5-81e42dffcf41","name":"Parner, Erik Thorlund","name_org":"Parner, Erik","orcid":"0000-0003-3661-1922","rank":17,"rolecode":"pau"},{"affno":"10 11","corresponding":null,"first":"Jonathon","key":"leipsicpau","last":"Leipsic","name":"Leipsic, Jonathon","rank":18,"rolecode":"pau"},{"affno":"7 18","first":"Jawdat","key":"abdullapau","last":"Abdulla","locid":"90506a0f-e2cc-4235-9ccb-b04de2df199e","name":"Abdulla, Jawdat","rank":19,"rolecode":"pau"}],"pmid":["34686567"],"pub":{"doi":"10.1136/heartjnl-2021-319773","issn":["13556037","1468201X"],"issn_org":["13556037"],"issue":"3","journal":"Heart","pages":"194-202","paperid":"heartjnl-2021-319773","publisher":"BMJ Publishing Group","status":"p","title":"Heart","volume":"108"},"review":"Peer Reviewed","scoID":["2-s2.0-85123399646"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-4a080aba-e20b-4f12-a666-a6b866a4741d","ku-c0758b7a-2eb6-45c6-a86f-1ba321264dae","sdu-444499a7-ff60-4cea-93e6-f0f59071557f"],"src":["AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Prognostic value of coronary computed tomography angiographic derived fractional flow reserve : a systematic review and meta-analysis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-092.98-018041","year":"2022","yearsub":"2022"}
{"abstract":"Skill Classification (SC) is the task of classifying job competences from job postings. This work is the first in SC applied to Danish job vacancy data. We release the first Danish job posting dataset: *Kompetencer* (\\_en\\_: competences), annotated for nested spans of competences. To improve upon coarse-grained annotations, we make use of The European Skills, Competences, Qualifications and Occupations (ESCO; le Vrang et al., (2014)) taxonomy API to obtain fine-grained labels via distant supervision. We study two setups: The zero-shot and few-shot classification setting. We fine-tune English-based models and RemBERT (Chung et al., 2020) and compare them to in-language Danish models. Our results show RemBERT significantly outperforms all other models in both the zero-shot and the few-shot setting.","author_count":3,"contributors":["Zhang, Mike","Jensen, Kristian Nørgaard","Plank, Barbara"],"cuid":["S01-000.00-381930"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Danish Job Data","Distant supervision","Job postings","Machine learning models","Skill Classification"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"kompetencer fine grained skill classification in danish job postings via distant supervision and transfer learning","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.48550/arXiv.2205.01381","version":"Published Version"},"id":"S01-000.00-381930","identifier":[{"id":"85139590521","type":"scopus"}],"ids":["itu-2d1c959e-fb6d-4574-8703-4580d6589c9d"],"keyword":["Danish Job Data","Distant Supervision","Job Postings","Machine Learning Models","Skill Classification"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-896E81E2C7007B336F68C2BF631BEEE7"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.48550/arXiv.2205.01381","version":"Published Version"},{"access":"oa","type":"rem","url":"http://www.lrec-conf.org/proceedings/lrec2022/pdf/2022.lrec-1.46.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, NLPnorth"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Mike","key":"zhangpau","last":"Zhang","locid":"78a992d3-b8eb-4fd6-8a5e-18c464d0b254","name":"Zhang, Mike","orcid":"0000-0003-1218-5201","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kristian Nørgaard","key":"jensenpau","last":"Jensen","locid":"04344edd-2f02-45d5-ad45-baffe4c08898","name":"Jensen, Kristian Nørgaard","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Barbara","key":"plankpau","last":"Plank","locid":"f073ebac-704d-4236-9206-d1d2ef2be9c3","name":"Plank, Barbara","orcid":"0000-0002-4394-1965","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.48550/arxiv.2205.01381","pages":"436-447","publisher":"European Language Resources Association","status":"p","title":"13th International Conference on Language Resources and Evaluation"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-2d1c959e-fb6d-4574-8703-4580d6589c9d"],"src":["ITU IT University of Copenhagen"],"title":"Kompetencer: Fine-grained Skill Classification in Danish Job Postings via Distant Supervision and Transfer Learning","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381930","year":"2022","yearsub":"2022"}
{"abstract":"The long-term cardiovascular risk for patients examined with coronary computed tomography angiography (CCTA) to rule out coronary heart disease compared with population controls remains unexplored. A nationwide register-based study including first-time CCTA-examined patients between 2007 and 2017 in Denmark alive 180 days post-CCTA was conducted. We evaluated 5-year outcomes of myocardial infarction (MI) or revascularization and all-cause mortality in 3 distinct CCTA-groups: (1) no post-CCTA preventive pharmacotherapy use (cholesterol-lowering drugs, antiplatelets, or anticoagulants); (2) post-CCTA preventive pharmacotherapy use; and (3) revascularization or MI within 180 days post-CCTA. For each patient group, population controls were matched on age, gender, and calendar year. Absolute risks standardized to the age, gender, selected co-morbidity, and anti-anginal pharmacotherapy distributions of the specific CCTA-examined patients and respective controls were obtained from multivariable Cox regression. Of 110,599 CCTA-examined patients, (1) 48,231 patients were not prescribed preventive pharmacotherapy 180 days post-CCTA; (2) 42,798 patients were prescribed preventive pharmacotherapy within 180 days post-CCTA; and (3) 19,570 patients were diagnosed with MI or revascularized within 180 days post-CCTA. For patient groups 1 to 3 versus respective controls, 5-year MI or revascularization risks were <0.1% versus 2.0%, <0.1% versus 3.8%, and 19.0% versus 2.5%, all p<0.001. Five-year all-cause mortality were 2.8% versus 4.2%, 5.5% versus 8.8%, and 6.7% versus 8.5%, all p <0.001. In conclusion, the 5-year MI or revascularization risk can be considered very low for CCTA-examined patients without ischemic events within 180 days post-CCTA. Conversely, CCTA-examined patients with MI or revascularization events within 180 days post-CCTA have significantly elevated 5-year MI or revascularization risk.","author_count":18,"contributors":["Kragholm, Kristian","Rasmussen, Jeppe Grøndahl","Søndergaard, Marc Meller","Zaremba, Tomas","Tayal, Bhupendar","Lindgren, Filip Lyng","Sejersen, Holger Marquard","Mortensen, Martin Bødtker","Nørgaard, Bjarne Linde","Jensen, Jesper Møller","Bøtker, Hans Erik","Byrne, Christina","Køber, Lars","Torp-Pedersen, Christian","Andersen, Niels Holmark","Søgaard, Peter","Mamas, Mamas","Freeman, Phillip"],"cuid":["S03-100.00-666024"],"filters":{"added":"2022-07","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"continent":["Europe, Non-EU","OECD"],"corresponding_author":["Kragholm, Kristian"],"country":["United Kingdom"],"glorg":["All Global Affiliations","Keele University"],"keyword":["Computed Tomography Angiography","Coronary Angiography methods","Coronary Artery Disease diagnostic imaging","Denmark epidemiology","Follow Up Studies","Humans","Myocardial Infarction epidemiology","Myocardial Revascularization"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-U-AAU","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"five year outcomes after coronary computed tomography angiography from 000000000110 000000000599 patients in a danish nationwide register based follow up study","src":["aau","au","ku"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.amjcard.2022.04.035","version":"Published Version"},"id":"S03-100.00-666024","identifier":[{"id":"35606174","type":"pmid"},{"id":"85130456996","type":"scopus"}],"ids":["aau-f63bf89a-331a-4518-81e7-60c00803854c","au-8fb1b3dc-75e7-4098-b23b-29ceabfa2134","ku-8ecf6ef0-b52b-4522-ae70-3f1b1cc631c6"],"keyword":["Computed Tomography Angiography","Coronary Angiograp