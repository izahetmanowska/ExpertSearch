","rank":15,"rolecode":"pau"},{"affno":"10","corresponding":null,"first":"Jagat","key":"narulapau","last":"Narula","name":"Narula, Jagat","rank":16,"rolecode":"pau"},{"affno":"10","corresponding":null,"first":"Amir","key":"ahmadipau","last":"Ahmadi","name":"Ahmadi, Amir","rank":17,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kristian A","key":"øvrehuspau","last":"Øvrehus","locid":"3a9366a8-3e88-4426-95a9-c26f820f6650","name":"Øvrehus, Kristian A","rank":18,"rolecode":"pau"},{"affno":"11","corresponding":null,"first":"Fred","key":"stgoarpau","last":"St Goar","name":"St Goar, Fred","rank":19,"rolecode":"pau"},{"affno":"12","corresponding":null,"first":"Bernard","key":"debruynepau","last":"De Bruyne","name":"De Bruyne, Bernard","rank":20,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Bjarne L","key":"nørgaardpau","last":"Nørgaard","locid":"6bcdb292-78dc-4e8b-9fea-814d6a6852c9","name":"Nørgaard, Bjarne Linde","name_org":"Nørgaard, Bjarne L","orcid":"0000-0002-4758-7203","rank":21,"rolecode":"pau"}],"pmid":["28789941"],"pub":{"doi":"10.1016/j.jcct.2017.08.001","issn":["1876861X","19345925"],"issn_org":["19345925"],"issue":"6","journal":"Journal of Cardiovascular Computed Tomography","pages":"429-436","publisher":"Elsevier Inc.","status":"p","title":"Journal of Cardiovascular Computed Tomography","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-85026777884"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-8ae000be-7fcc-4015-a630-c242ef07ac2c"],"src":["AU Aarhus University"],"title":"Effect of the ratio of coronary arterial lumen volume to left ventricle myocardial mass derived from coronary CT angiography on fractional flow reserve","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-208576","year":"2017","yearsub":"2017"}
{"abstract":"Objectives: Arterial stiffness and subclinical coronary atherosclerosis may yield valuable information on cardiovascular risk. We aimed to characterize coronary atherosclerosis in asymptomatic patients with type 2 diabetes and healthy controls and to investigate the association between baseline arterial stiffness and coronary plaque volumes after 5-year follow-up. Methods: Data from 45 patients and 61 matched controls were available for coronary plaque assessment. For analysis including carotid-femoral pulse wave velocity (PWV), 43 patients and 55 controls were available. At follow-up, mean (SD) age of participants was 63±10 years, and mean diabetes duration (SD) in the patient group was 7.8±1.4 years. Arterial stiffness (PWV) was assessed by tonometry at both visits. Total, calcified, noncalcified, low-density noncalcified coronary plaques volumes and other plaque characteristics were assessed by coronary computed tomography angiography at follow-up. Results: Despite of similar or better blood pressure and plasma lipid control, patients had, compared with controls, a higher number of plaques with spotty calcifications (P<0.01) and remodeling index more than 1.1 (P<0.05), larger calcified plaque volumes [patients vs. controls: 11 (0-65) vs. 3 (0-30)ml (P=0.03)] and higher PWV [patients vs. controls at baseline: 9.1±2.2 vs. 7.9±1.4 m/s (P<0.01), at follow-up: 9.3±2.3 vs. 8.4±1.8 m/s (P=0.02)]. Baseline PWV was associated with volumes of all plaque types in crude analysis (P<0.01) and with lowdensity noncalcified plaque volume in analysis adjusted for age, sex, diabetes and blood pressure (P=0.01). Conclusion: Coronary plaques with unfavorable characteristics are more prevalent in well controlled asymptomatic patients with type 2 diabetes compared with healthy controls and independently associated with arterial stiffness.","author_count":8,"contributors":["Funck, Kristian Løkke","Laugesen, Esben","Øvrehus, Kristian","Jensen, Jesper Møller","Nørgaard, Bjarne L","Dey, Damini","Hansen, Troels Krarup","Poulsen, Per Løgstrup"],"cuid":["S01-000.00-232784"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Journal Article"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"increased high risk coronary plaque burden is associated with arterial stiffness in patients with type 000000000002 diabetes without clinical signs of coronary artery disease a computed tomography angiography study","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85018242668","version":"Other Version"},"id":"S01-000.00-232784","identifier":[{"id":"85018242668","type":"scopus"},{"id":"28441695","type":"pmid"}],"ids":["au-b55e1db7-30a6-494f-a246-28efea9119c2"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-66F24CB4CBD9ABD332D90E9A9449671B"],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Endocrinology and Internal Medicine"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Kristian L","key":"funckpau","last":"Funck","locid":"805d1abf-4bb5-4d90-a7ce-e169162ed033","name":"Funck, Kristian Løkke","name_org":"Funck, Kristian L","orcid":"0000-0003-0213-5550","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"cou