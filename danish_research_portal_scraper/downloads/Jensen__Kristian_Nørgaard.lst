rehus, Kristian Altern","name_org":"Øvrehus, Kristian","orcid":"0000-0003-2454-5446","rank":14,"rolecode":"pau"},{"affno":"19 20","corresponding":null,"first":"Jeroen","key":"sonckpau","last":"Sonck","name":"Sonck, Jeroen","rank":15,"rolecode":"pau"},{"affno":"19 21","corresponding":null,"first":"Mark","key":"rabbatpau","last":"Rabbat","name":"Rabbat, Mark","rank":16,"rolecode":"pau"},{"affno":"22","corresponding":null,"first":"Sarah","key":"mullenpau","last":"Mullen","name":"Mullen, Sarah","rank":17,"rolecode":"pau"},{"affno":"23","corresponding":null,"first":"Bernard","key":"debruynepau","last":"De Bruyne","name":"De Bruyne, Bernard","rank":18,"rolecode":"pau"},{"affno":"22","corresponding":null,"first":"Campbell","key":"rogerspau","last":"Rogers","name":"Rogers, Campbell","rank":19,"rolecode":"pau"},{"affno":"24","corresponding":null,"first":"Hitoshi","key":"matsuopau","last":"Matsuo","name":"Matsuo, Hitoshi","rank":20,"rolecode":"pau"},{"affno":"25","corresponding":null,"first":"Jeroen J","key":"baxpau","last":"Bax","name":"Bax, Jeroen J","rank":21,"rolecode":"pau"},{"affno":"26 27","corresponding":null,"first":"Jonathon","key":"leipsicpau","last":"Leipsic","name":"Leipsic, Jonathon","rank":22,"rolecode":"pau"},{"affno":"11 12","corresponding":null,"first":"Manesh R","key":"patelpau","last":"Patel","name":"Patel, Manesh R","rank":23,"rolecode":"pau"}],"pmid":["30165613"],"pub":{"doi":"10.1093/eurheartj/ehy530","issn":["0195668X","15229645"],"issn_org":["0195668X"],"issue":"41","journal":"European Heart Journal","pages":"3701-3711","publisher":"Oxford University Press","status":"p","title":"European Heart Journal","volume":"39"},"review":"Peer Reviewed","scoID":["2-s2.0-85055566647"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-36df8351-036d-47b5-b6f1-848b2c4eff63","sdu-548a45d7-47ee-45f9-986e-66139aae6c67"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Real-world clinical utility and impact on clinical decision-making of coronary computed tomography angiography-derived fractional flow reserve : Lessons from the ADVANCE Registry","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.95-016643","year":"2018","yearsub":"2018"}
{"abstract":"Aims To assess the use of downstream coronary angiography (ICA) and short-term safety of frontline coronary CT angiography (CTA) with selective CT-derived fractional flow reserve (FFR CT) testing in stable patients with typical angina pectoris. Methods Between 1 January 2016 and 30 June 2016 all patients (N = 774) referred to non-emergent ICA or coronary CTA and results at Aarhus University Hospital on a suspicion of CAD had frontline CTA performed. Downstream testing and treatment within 3 months and adverse events >_90 days were registered. Patients were divided into two groups according to the presence of typical angina pectoris, which according to local practice would have resulted in referral to ICA, (low-intermediate-risk, n = 593 [76%]; high-risk, n = 181 [24%]) with mean pre-test probability of CAD of 31 ± 16% and 67 ± 16%, respectively. Coronary CTA was performed in 745 (96%) patients in whom FFR CT was prescribed in 212 (28%) patients. In the high- vs. low-intermediate-risk group, ICA was cancelled in 75% vs. 91%. Coronary revascularization was performed more frequently in high-risk than in low-intermediate-risk patients, 76% vs. 52% (P = 0.03). Mean follow-up time was 157 ± 50 days. Serious clinical events occurred in four patients, but not in any patients with cancelled ICA by coronary CTA with selective FFR CT testing. Conclusion Frontline coronary CTA with selective FFR CT testing in stable patients with typical angina pectoris in real-world practice is associated with a high rate of safe cancellation of planned ICAs.","author_count":17,"contributors":["Jensen, Jesper Møller","Bøtker, Hans Erik","Mathiassen, Ole N","Grove, Erik Lerkevang","Øvrehus, Kristian A","Bech Pedersen, Kamilla","Terkelsen, Christian Juhl","Christiansen, Evald Høj","Maeng, Michael","Leipsic, Jonathon","Kaltoft, Anne","Jakobsen, Lars","Sørensen, Jacob Thorsted","Thim, Troels","Kristensen, Steen Dalby","Krusell, Lars Romer","Nørgaard, Bjarne Linde"],"cuid":["S01-000.00-153787"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","University of California at Berkeley"],"keyword":["Accuracy","Aged","Angina Pectoris diagnostic imaging","Artery disease","Asymptomatic Diseases","CT angiography","Cause of Death","Cohort Studies","Computed Tomography Angiography methods","Coronary Angiography methods","Diagnostic performance","Diagnostic testing","Disease Progression","Female","Follow Up Studies","Fractional Flow Reserve Myocardial physiology","Fractional flow reserve","Heart","Hospitals University","Humans","Male","Middle Aged","Multicenter","Outcomes","Prospective Studies","Risk Assessment","STENOSES","Severity of Illness Index","Stable angina","Survival Rate","coronary CT angiography"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"computed tomography derived fractional flow reserve testing in stable patients with typical angina pectoris influence on downstream rate of invasive coronary angiography","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85051044378","version":"Other Version"},"id":"S01-000.00-153787","identifier":[{"id":"28444153","type":"pmid"},{"id":"PMC5915944","type":"pmcid"},{"id":"85051044378","type":"scopus"}],"ids":["au-2abf0f10-4871-4b6b-8809-703962a3d1a7"],"keyword":["ACCURACY","ARTERY-DISEASE","Aged","Angina Pectoris/diagnostic imaging","Asymptomatic Diseases","CT ANGIOGRAPHY","Cause of Death","Cohort Studies","Computed Tomography Angiography/methods","Coronary Angiography/methods","DIAGNOSTIC PERFORMANCE","Disease Progression","Female","Follow-Up Studies","Fractional Flow Reserve, Myocardial/physiology","HEART","Hospitals, University","Humans","MULTICENTER","Male","Middle Aged","NXT TRIAL","OUTCOMES","Prospective Studies","Risk Assessment","STENOSES","Severity of Illness Index","Survival Rate","coronary ct angiography","diagnostic testing","fractional flow reserve","stable angina"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-942382F754385555CC0A831C1484EDED"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Cardiological Medicine B"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"us","key":"university of california at berkeley","loc":["United States","America, North","OECD"],"name":"University of California at Berkeley","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jesper","key":"møllerjensenpau","last":"Møller Jensen","locid":"a5cb9465-6652-4dda-806d-a8f33c29ff82","name":"Jensen, Jesper Møller","name_org":"Møller Jensen, Jesper","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Hans","key":"erikbøtkerpau","last":"Erik Bøtker","locid":"09b03c00-11a8-4f72-800f-181f26155750","name":"Bøtker, Hans Erik","name_org":"Erik Bøtker, Hans","orcid":"0000-0001-6358-8962","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ole","key":"norlingmathiassenpau","last":"Norling Mathiassen","locid":"b7950044-53a9-4198-add9-381ba27f96f0","name":"Mathiassen, Ole N","name_org":"Norling Mathiassen, Ole","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Erik","key":"grovepau","last":"Grove","locid":"f527f99e-8eed-433e-923e-afc0686a