ed","name_org":"Thorsted Sørensen, Jacob","rank":13,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Troels","key":"thimpau","last":"Thim","locid":"1d4a89fa-3b3a-498e-8507-d387d518e83c","name":"Thim, Troels","rank":14,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Steen","key":"dalbykristensenpau","last":"Dalby Kristensen","locid":"6d64271d-8a2c-41ea-891d-e85555bbd47a","name":"Kristensen, Steen Dalby","name_org":"Dalby Kristensen, Steen","rank":15,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars","key":"romerkrusellpau","last":"Romer Krusell","locid":"660b49df-f279-4bc2-8ff9-50fe259b2d33","name":"Krusell, Lars Romer","name_org":"Romer Krusell, Lars","rank":16,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Bjarne","key":"lindenørgaardpau","last":"Linde Nørgaard","locid":"6bcdb292-78dc-4e8b-9fea-814d6a6852c9","name":"Nørgaard, Bjarne Linde","name_org":"Linde Nørgaard, Bjarne","orcid":"0000-0002-4758-7203","rank":17,"rolecode":"pau"}],"pmid":["28444153"],"pub":{"doi":"10.1093/ehjci/jex068","issn":["15252167","15322114"],"issn_org":["15252167"],"issue":"4","journal":"European Heart Journal Cardiovascular Imaging","pages":"405-414","publisher":"Oxford University Press","status":"p","title":"European Heart Journal Cardiovascular Imaging","volume":"19"},"review":"Peer Reviewed","scoID":["2-s2.0-85051044378"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-2abf0f10-4871-4b6b-8809-703962a3d1a7"],"src":["AU Aarhus University"],"title":"Computed tomography derived fractional flow reserve testing in stable patients with typical angina pectoris : influence on downstream rate of invasive coronary angiography","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-153787","year":"2018","yearsub":"2017"}
{"abstract":"OBJECTIVES: The aims of the present study were: 1) to investigate the contribution of the extent of luminal stenosis and other lesion composition-related factors in predicting invasive fractional flow reserve (FFR); and 2) to explore the distribution of various combinations of morphological characteristics and the severity of stenosis among lesions demonstrating normal and abnormal FFR. BACKGROUND: In patients with stable ischemic heart disease, FFR-guided revascularization, as compared with medical therapy alone, is reported to improve outcomes. Because morphological characteristics are the basis of plaque rupture and acute coronary events, a relationship between FFR and lesion characteristics may exist. METHODS: This is a subanalysis of NXT (HeartFlowNXT: HeartFlow Analysis of Coronary Blood Flow Using Coronary CT Angiography), a prospective, multicenter study of 254 patients (age 64 ± 10 years, 64% male) with suspected stable ischemic heart disease; coronary computed tomography angiography including plaque morphology assessment, invasive angiography, and FFR were obtained for 383 lesions. Ischemia was defined by invasive FFR ≤0.80. Computed tomography angiography-defined morphological characteristics of plaques and their vascular location were used in univariate and multivariate analyses to examine their predictive value for invasive FFR. The distribution of various combinations of plaque morphological characteristics and the severity of stenosis among lesions demonstrating normal and abnormal FFR were examined. RESULTS: The percentage of luminal stenosis, low-attenuation plaque (LAP) or necrotic core volume, left anterior descending coronary artery territory, and the presence of multiple lesions per vessel were the predictors of FFR. When grouped on the basis of degree of luminal stenosis, FFR-negative lesions had consistently smaller LAP volumes compared with FFR-positive lesions. The distribution of plaque characteristics in lesions with normal and abnormal FFR demonstrated that whereas FFR-negative lesions excluded likelihood of stenotic plaques with moderate to high LAP volumes, only one-third of FFR-positive lesions demonstrated obstructive plaques with moderate to high LAP volumes. CONCLUSIONS: In addition to the severity of luminal stenosis, necrotic core volume is an independent predictor of FFR. The distribution of plaque characteristics among lesions with varying luminal stenosis and normal and abnormal FFR may explain the outcomes associated with FFR-guided therapy.","author_count":14,"contributors":["Ahmadi, Amir","Leipsic, Jonathon","Øvrehus, Kristian A","Gaur, Sara","Bagiella, Emilia","Ko, Brian","Dey, Damini","LaRocca, Gina","Jensen, Jesper Møller","Bøtker, Hans Erik","Achenbach, Stephan","De Bruyne, Bernard","Nørgaard, Bjarne L","Narula, Jagat"],"cuid":["S01-000.00-221060"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Europe, EU","OECD","Oceania"],"country":["Australia","Belgium","Canada","Germany","United States"],"glorg":["All Global Affiliations","Cardiovascular Center Aalst","Friedrich-Alexander University Erlangen-Nürnberg","Icahn School of Medicine at Mount Sinai","Mayo Clinic Rochester, MN","Monash University","St. Pauls Hospital"],"keyword":["Journal Article"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"lesion specific and vessel related determinants of fractional flow reserve beyond coronary artery stenosis","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85039993390","version":"Other Version"},"id":"S01-000.00-221060","identifier":[{"id":"29311033","type":"pmid"},{"id":"85039993390","type":"scopus"}],"ids":["au-a0f8ce02-7436-4843-8f06-257633fe70aa"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-CD1DA59FA0C5B99BB87FC6A232B68214"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","country":"us","key":"icahn school of medicine at mount sinai","loc":["United States","America, North","OECD"],"name":"Icahn School of Medicine at Mount Sinai","used":1},{"affno":"2","country":"ca","key":"st pauls hospital","loc":["Canada","America, North","OECD"],"name":"St. Pauls Hospital","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Cardiological Medicine B"],"nora_code":"DI-U-AU","used":1},{"affno":"4","country":"au","key":"monash university","loc":["Australia","Oceania","OECD"],"name":"Monash University","used":1},{"affno":"5","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1},{"affno":"6","country":"de","key":"friedrich alexander university erlangen nürnberg","loc":["Germany","Europe, EU","OECD"],"name":"Friedrich-Alexander University Erlangen-Nürnberg","used":1},{"affno":"7","country":"be","key":"cardiovascular center aalst","loc":["Belgium","Europe, EU","OECD"],"name":"Cardiovascular Center Aalst","used":1},{"affno":"8","country":"us","key":"mayo clinic rochester mn","loc":["United States","America, North","OECD"],"name":"Mayo Clinic Rochester, MN","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Amir","key"