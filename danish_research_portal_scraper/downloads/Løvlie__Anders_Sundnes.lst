I, Media, Art & Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Dimitrios","key":"darzentaspau","last":"Darzentas","name":"Darzentas, Dimitrios","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jocelyn","key":"spencepau","last":"Spence","name":"Spence, Jocelyn","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Edgar","key":"bodiajpau","last":"Bodiaj","name":"Bodiaj, Edgar","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Emily-Clare","key":"thornpau","last":"Thorn","name":"Thorn, Emily-Clare","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"William","key":"prestonpau","last":"Preston","name":"Preston, William","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Boriana","key":"kolevapau","last":"Koleva","name":"Koleva, Boriana","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Martin","key":"flinthampau","last":"Flintham","name":"Flintham, Martin","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Steve","key":"benfordpau","last":"Benford","name":"Benford, Steve","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Anders Sundnes","key":"løvliepau","last":"Løvlie","locid":"22ec9269-2fff-4dbf-a9c7-5037559a15ee","name":"Løvlie, Anders Sundnes","orcid":"0000-0003-0484-4668","rank":9,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Tim","key":"wraypau","last":"Wray","name":"Wray, Tim","rank":10,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Petros","key":"ioannidispau","last":"Ioannidis","name":"Ioannidis, Petros","rank":11,"rolecode":"pau"}],"pub":{"publisher":"The European Commission","status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-4c1af62f-c582-42f5-bbb9-fd2e6c5304fe"],"src":["ITU IT University of Copenhagen"],"title":"GIFT Project Deliverable D6.3 Design of the Final Toolbox","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382408","year":"2020","yearsub":"2021"}
{"abstract":"This paper presents the GIFT smartphone app, an artist-led Research through Design project benefitting from a three-day in-the-wild deployment. The app takes as its premise the generative potential of combining the contexts of gifting and museum visits. Visitors explore the museum, searching for objects that would most appeal to the gift-receiver they have in mind, then photographing those objects and adding audio messages for their receivers describing the motivation for their choices. This paper charts the designers' key aim of creating a new frame of mind using voice, and the most striking findings discovered during in-the-wild deployment in a museum -- 'seeing with new eyes' and fostering personal connections. We discuss empathy, motivation, and bottom-up personalisation in the productive space revealed by this combination of contexts. We suggest that this work reveals opportunities for designers of gifting services as well as those working in cultural heritage.","author_count":13,"contributors":["Spence, Jocelyn","Bedwell, Benjamin","Coleman, Michelle","Benford, Steve","Koleva, Boriana","Adams, Matt","Row Farr, Ju","Tandavanitj, Nick","Løvlie, Anders Sundnes"],"cuid":["S01-000.00-382305"],"event":{"acronym":"CHI","title":"ACM Conference on Human Factors in Computing Systems"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","Blast Theory","University of Nottingham"],"keyword":["Cultural heritage","Gifting","Museums","Personalization","Voice"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"seeing with new eyes designing for in the wild museum gifting","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84115165/paper005.pdf","version":"Published Version"},"id":"S01-000.00-382305","identifier":[{"id":"85067624444","type":"scopus"}],"ids":["itu-45b717e5-9f70-4554-b123-915116d3ffb4"],"keyword":["cultural heritage","gifting","museums","personalization","voice"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-1FB42AF67602EE4940ECF55D5A7D58AD"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84115165/paper005.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"gb","key":"university of nottingham","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Nottingham","used":1},{"affno":"2","country":"gb","key":"blast theory","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Blast Theory","used":1},{"affno":"3","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Data Science, Audio-Visual Computing","IT University of Copenhagen, Digital Design","IT University of Copenhagen, Play, Culture, and AI, Media, Art & Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jocelyn","key":"spencepau","last":"Spence","name":"Spence, Jocelyn","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Benjamin","key":"bedwellpau","last":"Bedwell","name":"Bedwell, Benjamin","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Michelle","key":"colemanpau","last":"Coleman","name":"Coleman, Michelle","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Steve","key":"benfordpau","last":"Benford","name":"Benford, Steve","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Boriana","key":"kolevapau","last":"Koleva","name":"Koleva, Boriana","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Matt","key":"adamspau","last":"Adams","name":"Adams, Matt","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ju","key":"rowfarrpau","last":"Row Farr","name":"Row Farr, Ju","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Nick","key":"tandavanitjpau","last":"Tandavanitj","name":"Tandavanitj, Nick","rank":8,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Anders Sundnes","key":"løvliepau","last":"Løvlie","locid":"22ec9269-2fff-4dbf-a9c7-5037559a15ee","name":"Løvlie, Anders Sundnes","orcid":"0000-0003-0484-4668","rank":9,"rolecode":"pau"},{"affno":"","first":"Stephen","key":"brewsterpedh","last":"Brewster","name":"Brewster, Stephen","rank":10,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Geraldine","key":"fitzpatrickpedh","last":"Fitzpatrick","name":"Fitzpatrick, Geraldine","rank":11,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Anna","key":"coxpedh","last":"Cox","name":"Cox, Anna","rank":12,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Vassilis","key":"kostakospedh","last":"Kostakos","name":"Kostakos, Vassilis","rank":13,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1145/3290605.3300235","eisbn":["9781450359702"],"publisher":"Association for Computing Machinery","status":"p","title":"Proceedings of the 2019 CHI Conference on Human Factors in Computing Systems, CHI 2019, Glasgow, Scotland, UK, May 04-09, 2019"},"review":"Peer Reviewed","scoID":["2-s2.0-85067624444"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-45b717e5-9f70-4554-b123-915116d3ffb4"],"src":["ITU IT University of Copenhagen"],"title":"Seeing with New Eyes : Designing for In-the-Wild Museum Gifting","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382305","year":"2019","yearsub":"2019"}
{"abstract":"GIFT is an ongoing EU-funded research project developing hybrid visitor experiences: mixed reality designs that complement, challenge, or overlay physical visits with digital content. Through design exploration of two concepts focusing on gifting and play, the project has developed a design framework and toolbox aimed at helping museums create deeper and more meaningful experiences by giving visitors the tools to tell their own stories. This framework is now being made freely available as an “open beta” for museum professionals and other users. The project is highly cross-disciplinary, combining human-computer interaction research, artist-led exploration, technology explorations, and experience design in collaboration with museums. Furthermore, the project gathers 10 prominent museums from Europe and the U.S. in an action research project that both serves to ground the framework in the needs of museums while also facilitating the museum partners’ need to become “digital-ready,” understanding and capitalising on digital technology.","author_count":10,"contributors":["Løvlie, Anders Sundnes","Benford, Steve","Spence, Jocelyn","Wray, Tim","Mortensen, Christian Hviid","Olesen, Anne Rørbæk","Rogberg, Linda","Bedwell, Benjamin","Darzentas, Dimitrios","Waern, Annika"],"cuid":["S01-000.00-384225"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD"],"country":["Sweden","United Kingdom"],"glorg":["All Global Affiliations","University of Nottingham","Uppsala University"],"keyword":["Experience Design","Gifting","Hybrid Experiences","Play","artist led research"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"nr","rtype":["clu"],"sorti":"the gift framework give visitors the tools to tell their own stories","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://mw19.mwconf.org/paper/the-gift-framework-give-visitors-the-tools-to-tell-their-own-stories/","version":"Published Version"},"id":"S01-000.00-384225","ids":["itu-c9fcf3d7-2076-4c73-ac05-95d98a122e7d"],"keyword":["artist-led research","experience design","gifting","hybrid experiences","play"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-C60AB10199AC8E09E36F002CB578FB38"],"oa_link":[{"access":"oa","type":"rem","url":"https://mw19.mwconf.org/paper/the-gift-framework-give-visitors-the-tools-to-tell-their-own-stories/","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Data Science, Audio-Visual Computing","IT University of Copenhagen, Digital Design","IT University of Copenhagen, Play, Culture, and AI, Media, Art & Design"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"gb","key":"university of nottingham","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Nottingham","used":1},{"affno":"3","country":"se","key":"uppsala university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Uppsala University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anders Sundnes","key":"løvliepau","last":"Løvlie","locid":"22ec9269-2fff-4dbf-a9c7-5037559a15ee","name":"Løvlie, Anders Sundnes","orcid":"0000-0003-0484-4668","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Steve","key":"benfordpau","last":"Benford","name":"Benford, Steve","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jocelyn","key":"spencepau","last":"Spence","name":"Spence, Jocelyn","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Tim","key":"wraypau","last":"Wray","name":"Wray, Tim","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christian Hviid","key":"mortensenpau","last":"Mortensen","name":"Mortensen, Christian Hviid","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anne Rørbæk","key":"olesenpau","last":"Olesen","name":"Olesen, Anne Rørbæk","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Linda","key":"rogbergpau","last":"Rogberg","name":"Rogberg, Linda","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Benjamin","key":"bedwellpau","last":"Bedwell","name":"Bedwell, Benjamin","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Dimitrios","key":"darzentaspau","last":"Darzentas","name":"Darzentas, Dimitrios","rank":9,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Annika","key":"waernpau","last":"Waern","name":"Waern, Annika","rank":10,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-c9fcf3d7-2076-4c73-ac05-95d98a122e7d"],"src":["ITU IT University of Copenhagen"],"title":"The GIFT framework: Give visitors the tools to tell their own stories","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384225","year":"2019","yearsub":"2019"}
{"abstract":"Audio-based locative media (Tuters and Varnelis, 2006), sometimes known as \"audio walks\" (Cardiff and Miller, 1991), \"placed sound\" (Behrendt, 2012), or \"situated sound\" (Fagerjord, 2011) can be used to offer educational material outside the museum—effectively creating audio guide-like experiences in public spaces. However, such experiences raise concerns that have long been discussed in relation to mobile devices in museums: that they may take too much of the user's attention, resulting in visitors focusing only on their mobile screens (Woodruff et al., 2001; vom Lehn and Heath, 2003; Wessel and Mayr, 2007; Løvlie, 2011; Behrendt, 2015). While this is a long-standing concern in the museum world, it also matches current trends in interface design suggesting that \"the best interface is no interface\" (Krishna, 2015). This paper presents a research-through-design exploration (Zimmerman, Forlizzi, and Evenson, 2007) of this problem through the development of an audio walk conveying the history of the 1970’s squatter movement in Copenhagen. User tests demonstrate that the absence of a visual interface allows users to ignore their mobile screens and navigate simply using the audio while observing their surroundings. Some users report great pleasure from this experience: \"The feeling of only listening, instead of looking at pictures, and then looking at reality, I really liked it—it was wonderful!\" However, the experience also relies on the user's ability to imagine the past and to understand the differences between the contemporary urban environment and the historical period in which the events unfold.","author_count":3,"contributors":["Pedersen, Tilde","Terte, Edith","Løvlie, Anders Sundnes"],"cuid":["S01-000.00-381368"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Audio based locative media","Audio walks","Historical audio narration","Mobile interface design","User experience"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"designing a no interface audio walk","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://mw19.mwconf.org/paper/designing-a-no-interface-audio-walk/","version":"Published Version"},"id":"S01-000.00-381368","ids":["itu-071d5a5b-ef6f-4d2c-b580-207d505b85f5"],"keyword":["Audio walks","Audio-based locative media","Historical audio narration","Mobile interface design","User experience"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-A8FAF352A788DBE060E3F66816F345AD"],"oa_link":[{"access":"oa","type":"rem","url":"https://mw19.mwconf.org/paper/designing-a-no-interface-audio-walk/","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Data Science, Audio-Visual Computing","IT University of Copenhagen, Digital Design","IT University of Copenhagen, Play, Culture, and AI, Media, Art & Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Tilde","key":"pedersenpau","last":"Pedersen","name":"Pedersen, Tilde","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Edith","key":"tertepau","last":"Terte","name":"Terte, Edith","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders Sundnes","key":"løvliepau","last":"Løvlie","locid":"22ec9269-2fff-4dbf-a9c7-5037559a15ee","name":"Løvlie, Anders Sundnes","orcid":"0000-0003-0484-4668","rank":3,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-071d5a5b-ef6f-4d2c-b580-207d505b85f5"],"src":["ITU IT University of Copenhagen"],"title":"Designing a “No Interface” Audio Walk","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381368","year":"2019","yearsub":"2019"}
{"abstract":"This paper uses the military propaganda game America's Army to understand how computer game maps can be used to serve a rhetorical purpose. I argue that the game maps speak primarily through omissions, simplifications and differentiating features that highlight the relationship between similar games, rather than the relation between game and reality. Through a study of user-generated maps, I conclude that the rhetoric of America's Army can be identified also in the players' own creations, indicating some degree of success for the propaganda purpose of the game.","author_count":1,"contributors":["Løvlie, Anders Sundnes"],"cuid":["S01-000.00-384171"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"keyword":["America s Army","Game maps","Rhetoric","User generated content"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"speaking through omission game maps as spatial rhetoric","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84554860/game_maps_as_spatial_rhetoric_postprint.pdf","version":"Authors Final Version"},"id":"S01-000.00-384171","ids":["itu-c6182588-c6c8-4408-89d2-17baaa06a56c"],"keyword":["America's Army","Game Maps","Rhetoric","User-Generated Content"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-176AFC3E84BD8D3B33587F0A0B3EF5D9"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84554860/game_maps_as_spatial_rhetoric_postprint.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Data Science, Audio-Visual Computing","IT University of Copenhagen, Digital Design","IT University of Copenhagen, Play, Culture, and AI, Media, Art & Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anders Sundnes","key":"løvliepau","last":"Løvlie","locid":"22ec9269-2fff-4dbf-a9c7-5037559a15ee","name":"Løvlie, Anders Sundnes","orcid":"0000-0003-0484-4668","rank":1,"rolecode":"pau"}],"pub":{"issn":["08696365","23099968"],"issn_org":["08696365"],"issue":"158","journal":"Novoe Literaturnoe Obozrenie","pages":"267-282","publisher":"Novoe Literaturnoe Obozrenie","status":"p","title":"Novoe Literaturnoe Obozrenie"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-c6182588-c6c8-4408-89d2-17baaa06a56c"],"src":["ITU IT University of Copenhagen"],"title":"Speaking Through Omission: Game Maps as Spatial Rhetoric","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384171","year":"2019","yearsub":"2019"}
{"author_count":3,"contributors":["Løvlie, Anders Sundnes","Pichlmair, Martin","Brin, Sarah"],"cuid":["S01-000.00-381783"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"nr","rtype":["clu"],"sorti":"gift project deliverable d000000000004 000000000001 evaluation strategy and change process report","src":["itu"],"src-code":["DI-U-ITU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85640047/GIFT_D4.1_Evaluation_Strategy_and_Change_Process_Report.pdf","version":"Published Version"},"id":"S01-000.00-381783","ids":["itu-2245631e-b585-48c5-a863-0eb90e991662"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-E16CCDBD970C300BE11C1DA54DA10704"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85640047/GIFT_D4.1_Evaluation_Strategy_and_Change_Process_Report.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Data Science, Audio-Visual Computing","IT University of Copenhagen, Digital Design","IT University of Copenhagen, Play, Culture, and AI, Media, Art & Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anders Sundnes","key":"løvliepau","last":"Løvlie","locid":"22ec9269-2fff-4dbf-a9c7-5037559a15ee","name":"Løvlie, Anders Sundnes","orcid":"0000-0003-0484-4668","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Martin","key":"pichlmairpau","last":"Pichlmair","locid":"ddcdfda8-c5ea-4e67-b0ea-21ba86966197","name":"Pichlmair, Martin","orcid":"0000-0001-8828-9723","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sarah","key":"brinpau","last":"Brin","name":"Brin, Sarah","rank":3,"rolecode":"pau"}],"pub":{"publisher":"The European Commission","status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-2245631e-b585-48c5-a863-0eb90e991662"],"src":["ITU IT University of Copenhagen"],"title":"GIFT Project Deliverable D4.1 Evaluation Strategy and Change Process Report","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381783","year":"2018"}
{"abstract":"The GIFT project develops new approaches to creating hybrid physical-digital visitor experiences in museums. Through design exploration of two concepts focusing on gifting and playful appropriation, the project charts how museums can create a deeper and more meaningful experience by giving visitors the tools to tell their own stories. The project is highly cross-disciplinary combining HCI research, artist-led exploration, technology explorations, and experience design in collaboration with museums. Furthermore, the project gathers 10 prominent museums from Europe and the US in an action research project that both serves to ground the prototypes and framework in the needs of museums, while also facilitating the museum sector's need to become 'digital-ready', understanding and capitalising on digital technology. As the project has progressed through half of its duration, we report on initial findings and how these have shaped our direction of progress.","author_count":12,"contributors":["Back, Jon","Bedwell, Benjamin","Benford, Steve","Eklund, Lina","Løvlie, Anders Sundnes","Preston, William","Rajkowska, Paulina","Ryding, Karin","Spence, Jocelyn","Thorn, Emily-Clare","Waern, Annika","Wray, Tim"],"cuid":["S01-000.00-382350"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD"],"country":["Sweden","United Kingdom"],"glorg":["All Global Affiliations","University of Nottingham","Uppsala University"],"keyword":["Experience Design","Gifting","Hybrid Experiences","Play"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"gift hybrid museum experiences through gifting and play","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83651087/paper4.pdf","version":"Published Version"},"id":"S01-000.00-382350","identifier":[{"id":"85062393446","type":"scopus"}],"ids":["itu-489cd169-736e-4a7d-9d6b-861e0da52d07"],"keyword":["experience design","gifting","hybrid experiences","play"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-5EC1C4D6B1FCE2F1E43F6A1E26CEA90F"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83651087/paper4.pdf","version":"Published Version"},{"access":"oa","type":"rem","url":"http://ceur-ws.org/Vol-2235/paper4.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","country":"se","key":"uppsala university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Uppsala University","used":1},{"affno":"2","country":"gb","key":"university of nottingham","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Nottingham","used":1},{"affno":"3","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Digital Play","IT University of Copenhagen, Data Science, Audio-Visual Computing","IT University of Copenhagen, Digital Design","IT University of Copenhagen, Play, Culture, and AI, Media, Art & Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jon","key":"backpau","last":"Back","name":"Back, Jon","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Benjamin","key":"bedwellpau","last":"Bedwell","name":"Bedwell, Benjamin","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Steve","key":"benfordpau","last":"Benford","name":"Benford, Steve","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lina","key":"eklundpau","last":"Eklund","name":"Eklund, Lina","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Anders Sundnes","key":"løvliepau","last":"Løvlie","locid":"22ec9269-2fff-4dbf-a9c7-5037559a15ee","name":"Løvlie, Anders Sundnes","orcid":"0000-0003-0484-4668","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"William","key":"prestonpau","last":"Preston","name":"Preston, William","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Paulina","key":"rajkowskapau","last":"Rajkowska","name":"Rajkowska, Paulina","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Karin","key":"rydingpau","last":"Ryding","name":"Ryding, Karin","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jocelyn","key":"spencepau","last":"Spence","name":"Spence, Jocelyn","rank":9,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Emily-Clare","key":"thornpau","last":"Thorn","name":"Thorn, Emily-Clare","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Annika","key":"waernpau","last":"Waern","name":"Waern, Annika","rank":11,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Tim","key":"wraypau","last":"Wray","name":"Wray, Tim","rank":12,"rolecode":"pau"}],"pub":{"issn":["16130073"],"journal":"CEUR Workshop Proceedings","pages":"31-40","paperid":"4","publisher":"CEUR Workshop Proceedings","status":"p","title":"CEUR Workshop Proceedings","volume":"2235"},"review":"Peer Reviewed","scoID":["2-s2.0-85062393446"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-489cd169-736e-4a7d-9d6b-861e0da52d07"],"src":["ITU IT University of Copenhagen"],"title":"GIFT : Hybrid Museum Experiences through Gifting and Play","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382350","year":"2018","yearsub":"2018"}
{"abstract":"The increasing spread of smartphones gives new opportunities for museums dealing with ideologically contested collections. In this paper we explore how playful interactions and user comments can be used to encourage critical engagement with museum collections. This is done through a research through design experiment at the Museum of Yugoslavia, which houses the grave of the former communist leader Josep Tito. Building on earlier work by Mary Flanagan and Andrea Witcomb, we present a playful design that utilizes Artcodes to connect the physical museum exhibits with a digital experience of modernist monuments erected at various sites around the former territory of Yugoslavia during the socialist era. The design has been tested through two iterations on museum visitors and a group of experts on digital museum communication, leading to suggestions for future critical designs centered on playful intervention and poetic provocations.","author_count":2,"contributors":["Ryding, Karin","Løvlie, Anders Sundnes"],"cuid":["S01-000.00-382802"],"event":{"end":"2018-04-21","place":"Vancouver, ca","start":"2018-04-18","title":"Museums and the Web 2018","year":"2018"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Digital Museum Communication","Ideologically Contested Collections","Museums","Playful Interactions","Smartphones"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"monuments for a departed future designing for critical engagement with an ideologically contested museum collection","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://mw18.mwconf.org/paper/monuments-for-a-departed-future-designing-for-critical-engagement-with-an-ideologically-contested-museum-collection/","version":"Published Version"},"id":"S01-000.00-382802","ids":["itu-663ea0dc-0076-490e-abe2-4a7d084da4f7"],"keyword":["Digital Museum Communication","Ideologically Contested Collections","Museums","Playful Interactions","Smartphones"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-B8A9C21CB685B7F1B95C35D4EBD9CF31"],"oa_link":[{"access":"oa","type":"rem","url":"https://mw18.mwconf.org/paper/monuments-for-a-departed-future-designing-for-critical-engagement-with-an-ideologically-contested-museum-collection/","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Digital Play","IT University of Copenhagen, Digital Design","IT University of Copenhagen, Human-Computer Interaction and Design, Affective Interactions & Relations Lab","IT University of Copenhagen, Play, Culture, and AI, Media, Art & Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Karin","key":"rydingpau","last":"Ryding","name":"Ryding, Karin","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders Sundnes","key":"løvliepau","last":"Løvlie","locid":"22ec9269-2fff-4dbf-a9c7-5037559a15ee","name":"Løvlie, Anders Sundnes","orcid":"0000-0003-0484-4668","rank":2,"rolecode":"pau"}],"pub":{"isbn":["9780998847405"],"place":"Silver Spring, MD","publisher":"Museums and the Web","status":"p","subtitle":"Selected Papers and Proceedings from an International Conference","title":"MW18: Museums and the Web 2018"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-663ea0dc-0076-490e-abe2-4a7d084da4f7"],"src":["ITU IT University of Copenhagen"],"title":"Monuments For A Departed Future : Designing For Critical Engagement With An Ideologically Contested Museum Collection","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382802","year":"2018","yearsub":"2018"}
{"abstract":"This paper presents Word by Word—a mobile game that allows visitors to personalize and share their experience by allowing them to construct and continue each other's stories based on the objects that they observe within the museum. The objective of the game’s concept and development is to contribute to the ongoing body of work in how mobile games could be used to support meaningful social experiences within museums. Through the use of humor, the game encourages visitors to socialize within the museum and provide unique personal interpretations of the artworks. Through a process of iterative design, our research provides insights into which mobile interface design factors could inhibit or enhance a collaborative storytelling experience, and how a mobile game could be used to support a meaningful social museum experience by encouraging visitors to construct their own personal interpretations of the artworks.","author_count":5,"contributors":["Ingimundardottir, Elin","Stanciauskaite, Greta","Sachse, Kristoffer Kjul","Wray, Tim","Løvlie, Anders Sundnes"],"cuid":["S01-000.00-382829"],"event":{"end":"2018-04-21","place":"Vancouver, ca","start":"2018-04-18","title":"Museums and the Web 2018","year":"2018"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Collaborative Storytelling","Iterative design","Mobile Game Design","Museum Social Experience","Personal Interpretation"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Tax office of Denmark"],"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"word by word a mobile game to encourage collaborative storytelling within the museum","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://mw18.mwconf.org/paper/word-by-word-a-mobile-game-to-encourage-collaborative-storytelling-within-the-museum/","version":"Published Version"},"id":"S01-000.00-382829","ids":["itu-68143207-93cf-4968-b4d4-536994c1c540"],"keyword":["Collaborative Storytelling","Iterative Design","Mobile Game Design","Museum Social Experience","Personal Interpretation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-E608C2EB7F8ED4D0146F885CEA4EF634"],"oa_link":[{"access":"oa","type":"rem","url":"https://mw18.mwconf.org/paper/word-by-word-a-mobile-game-to-encourage-collaborative-storytelling-within-the-museum/","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Tax office of Denmark"],"nora_code":"DI-OT","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Play, Culture, and AI, Media, Art & Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Elin","key":"ingimundardottirpau","last":"Ingimundardottir","name":"Ingimundardottir, Elin","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Greta","key":"stanciauskaitepau","last":"Stanciauskaite","name":"Stanciauskaite, Greta","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Kristoffer Kjul","key":"sachsepau","last":"Sachse","name":"Sachse, Kristoffer Kjul","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Tim","key":"wraypau","last":"Wray","name":"Wray, Tim","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Anders Sundnes","key":"løvliepau","last":"Løvlie","locid":"22ec9269-2fff-4dbf-a9c7-5037559a15ee","name":"Løvlie, Anders Sundnes","orcid":"0000-0003-0484-4668","rank":5,"rolecode":"pau"}],"pub":{"isbn":["9780998847405"],"place":"Silver Spring, MD","publisher":"Museums and the Web","status":"p","title":"MW18: Museums and the Web 2018"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["itu-68143207-93cf-4968-b4d4-536994c1c540"],"src":["ITU IT University of Copenhagen"],"title":"Word By Word: A Mobile Game To Encourage Collaborative Storytelling Within The Museum","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382829","year":"2018","yearsub":"2018"}
{"abstract":"Based on a survey among contributors to the online comments sections of four Norwegian newspapers, we investigate the following research question: How do contributors describe their experiences of repercussions from writing comments on newspaper websites? Employing quantitative and qualitative analyses, we explore the influence of four variables: gender, anonymity, attitudes toward editorial policies and issue controversy. We find no influence from gender. However, regarding attitudes we find that the experience of repercussions is particularly prevalent among those who oppose strict editorial control with regard to reader comments, as well as among respondents who write comments on a radical right-wing website. Studying free-form answers which describe incidents of repercussions experienced by the respondents we find no sign of gender differences, but rather a strong dominance of statements related to issue controversies, and particularly regarding immigration and Islam.","author_count":3,"contributors":["Løvlie, Anders Sundnes","Ihlebæk, Karoline Andrea","Larsson, Anders Olof"],"cuid":["S01-000.00-381366"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, Non-EU","Nordic","OECD"],"country":["Norway"],"glorg":["All Global Affiliations","University of Oslo","Westerdals Oslo School of Arts"],"keyword":["Audience Participation","Harassment","Journalism","Online comments","User experience","repercussions"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"friends call me racist experiences of repercussions from writing comments on newspaper websites","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://pure.itu.dk/ws/files/83188433/Repercussions_accepted_version_subm.pdf","version":"Authors Final Version"},"id":"S01-000.00-381366","identifier":[{"id":"85048869326","type":"scopus"}],"ids":["itu-0700101d-74a8-4b90-a4b3-51cdd626923f"],"keyword":["audience participation","harassment","journalism","online comments","repercussions","user experience"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-228426C42C74E5B17EE405A917B57218"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://pure.itu.dk/ws/files/83188433/Repercussions_accepted_version_subm.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Data Science, Audio-Visual Computing","IT University of Copenhagen, Digital Design","IT University of Copenhagen, Play, Culture, and AI, Media, Art & Design"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"no","key":"university of oslo","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"University of Oslo","used":1},{"affno":"3","country":"no","key":"westerdals oslo school of arts","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"Westerdals Oslo School of Arts","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anders Sundnes","key":"løvliepau","last":"Løvlie","locid":"22ec9269-2fff-4dbf-a9c7-5037559a15ee","name":"Løvlie, Anders Sundnes","orcid":"0000-0003-0484-4668","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Karoline Andrea","key":"ihlebækpau","last":"Ihlebæk","name":"Ihlebæk, Karoline Andrea","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Anders Olof","key":"larssonpau","last":"Larsson","name":"Larsson, Anders Olof","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1177/1464884918781794","issn":["14648849","17413001"],"issn_org":["14648849"],"journal":"Journalism","publisher":"Sage Publishing","status":"p","title":"Journalism"},"review":"Peer Reviewed","scoID":["2-s2.0-85048869326"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-0700101d-74a8-4b90-a4b3-51cdd626923f"],"src":["ITU IT University of Copenhagen"],"title":"‘Friends call me racist’: Experiences of repercussions from writing comments on newspaper websites","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381366","year":"2018","yearsub":"2018"}
