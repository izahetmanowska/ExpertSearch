{"author_count":2,"contributors":["Manikas, Konstantinos","Kontogiorgos, Dimosthenis"],"cuid":["S01-000.00-504786"],"event":{"end":"2015-09-11","place":"Dubrovnik/Cavtat, hr","start":"2015-09-07","title":"European Conference on Software Architecture Workshops 2015","year":"2015"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"characterizing software activity the influence of software to ecosystem health","src":["ku"],"src-code":["DI-U-KU"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-504786","identifier":[{"id":"84958544163","type":"scopus"}],"ids":["ku-ba847caa-626a-4b96-9d47-35e94935d40d"],"keyword":["ecosystem health, graph analysis, software activity, software ecosystems"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-992A2DD851FE2718692DE59472ACE96B"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Department of Computer Science","Københavns Universitet, Faculty of Science, Department of Computer Science, The HCC Section"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Konstantinos","key":"manikaspau","last":"Manikas","locid":"749e6138-99be-4563-b6ef-a375c5f9ffa6","name":"Manikas, Konstantinos","orcid":"0000-0001-8531-898X","rank":1,"rolecode":"pau"},{"affno":"1","first":"Dimosthenis","key":"kontogiorgospau","last":"Kontogiorgos","locid":"a5aa7a7d-1768-4428-b540-23a3ab96e422","name":"Kontogiorgos, Dimosthenis","orcid":"0000-0002-8874-6629","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1145/2797433.2797481","isbn":["9781450333931"],"publisher":"Association for Computing Machinery","status":"p","subtitle":"ECSAW '15","title":"Proceedings of the 2015 European Conference on Software Architecture Workshops"},"review":"Peer Reviewed","scoID":["2-s2.0-84958544163"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-ba847caa-626a-4b96-9d47-35e94935d40d"],"src":["KU University of Copenhagen"],"title":"Characterizing software activity : the influence of software to ecosystem health","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-504786","year":"2015","yearsub":"2015"}
{"abstract":"In this position paper we propose means of measuring programming expertise on novice and expert programmers. Our approach is to measure the cognitive load of programmers while they assess Java/Python code in accordance with their experience in programming. Our hypothesis is that expert programmers encounter smaller pupillary dilation within programming problem solving tasks. We aim to evaluate our hypothesis using the EMIP Distributed Data Collection in order to confirm or reject our approach.","author_count":2,"contributors":["Kontogiorgos, Dimosthenis","Manikas, Konstantinos"],"cuid":["S01-000.00-543673"],"event":{"end":"2015-11-24","place":"Joensuu, fi","start":"2015-11-22","title":"EYE MOVEMENTS IN PROGRAMMING: MODELS TO DATA","year":"2015"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"towards identifying programming expertise with the use of physiological measures","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/162989797/emip2015.pdf","version":"Published Version"},"id":"S01-000.00-543673","ids":["ku-fbad9c2b-c539-42e0-96ae-84e2b28d85fc"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-1A6F70765B6F388A462A2F42BE49DBDE"],"oa_link":[{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/162989797/emip2015.pdf","version":"Published Version"},{"access":"oa","type":"rem","url":"http://urn.fi/URN:ISBN:978-952-61-2040-9","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, The HCC Section"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Dimosthenis","key":"kontogiorgospau","last":"Kontogiorgos","locid":"a5aa7a7d-1768-4428-b540-23a3ab96e422","name":"Kontogiorgos, Dimosthenis","orcid":"0000-0002-8874-6629","rank":1,"rolecode":"pau"},{"affno":"1","first":"Konstantinos","key":"manikaspau","last":"Manikas","locid":"749e6138-99be-4563-b6ef-a375c5f9ffa6","name":"Manikas, Konstantinos","orcid":"0000-0001-8531-898X","rank":2,"rolecode":"pau"}],"pub":{"pages":"10-11","publisher":"University of Eastern Finland","status":"p","subtitle":"proceedings of the third international workshop","title":"Eye movements in programming: models to data"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-fbad9c2b-c539-42e0-96ae-84e2b28d85fc"],"src":["KU University of Copenhagen"],"title":"Towards identifying programming expertise with the use of physiological measures","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-543673","year":"2015","yearsub":"2015"}
{"abstract":"Making the right decisions is an essential part of software ecosystem governance. Decisions related to the governance of a software ecosystem can influence the health of the ecosystem and can result in fostering the success or greatly contributing to the failure of the ecosystem. However, very few studies touch upon the decision making of software ecosystem governance. In this paper, we propose decomposing software ecosystem governance into three activities: input or data collection, decision making, and applying actions. We focus on the decision making activity of software ecosystem governance and review related literature consisted of software ecosystem governance, organizational decision making, and IT governance. Based on the identified studies, we propose a framework for defining the decision making strategies in the governance of software ecosystems. We identify five decision areas for software ecosystem governance and four archetypes describing the way decisions are taken for each decision area. We explain this matrix-based framework by providing examples from existing software ecosystems.","author_count":3,"contributors":["Manikas, Konstantinos","Wnuk, Krzysztof","Shollo, Arisa"],"cuid":["S01-000.00-402476"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Sweden"],"glorg":["All Global Affiliations","Lund University"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS","DI-U-KU"]},"level3all":["DI-U-CBS","DI-U-KU"]},"review":"nr","rtype":["clu"],"sorti":"defining decision making strategies in software ecosystem governance","src":["ku"],"src-code":["DI-U-KU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/168290723/Decision_Making.pdf","version":"Published Version"},"id":"S01-000.00-402476","ids":["ku-0f319fe6-a4a3-4da2-83cc-cdba5bc2fce6"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-D6C4FBD2E59785DE1C93D9B5F4AB9744"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.diku.dk/forskning/Publikationer/tekniske_rapporter/2015/Decision-Making.pdf","version":"Published Version"},{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/168290723/Decision_Making.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Department of Computer Science","Københavns Universitet, Faculty of Science, Department of Computer Science, The HCC Section"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"se","key":"lund university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Lund University","used":1},{"affno":"3","country":"dk","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School"],"nora_code":"DI-U-CBS","used":1}],"person":[{"affno":"1","first":"Konstantinos","key":"manikaspau","last":"Manikas","locid":"749e6138-99be-4563-b6ef-a375c5f9ffa6","name":"Manikas, Konstantinos","orcid":"0000-0001-8531-898X","rank":1,"rolecode":"pau"},{"affno":"2","first":"Krzysztof","key":"wnukpau","last":"Wnuk","name":"Wnuk, Krzysztof","rank":2,"rolecode":"pau"},{"affno":"3","first":"Arisa","key":"shollopau","last":"Shollo","name":"Shollo, Arisa","rank":3,"rolecode":"pau"}],"pub":{"issn":["01078283"],"pages":"6","publisher":"Department of Computer Science, University of Copenhagen","repno":"Koebenhavns Universitet. Datalogisk Institut. Rapport","series":"Koebenhavns Universitet. Datalogisk Institut. Rapport","status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-0f319fe6-a4a3-4da2-83cc-cdba5bc2fce6"],"src":["KU University of Copenhagen"],"title":"Defining decision making strategies in software ecosystem governance","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-402476","year":"2015","yearsub":"2015"}
{"abstract":"As in many western countries, Denmark's demographic changes and the organizational and financial changes of the Danish healthcare are challenging the levels of provided healthcare and point towards the establishment of telemedicine as means of patient support, diagnosis, and treatment. However, telemedical solutions, despite the benefits they provide, are faced with a number of challenges that inhibit their adoption, development, and implementation. In this project, we examine the approach of a software ecosystem as means of addressing these issues. A software ecosystem can be roughly explained as the software development and distribution by a set of actors dependent on each other and the ecosystem. We commence on the hypothesis that the establishment of a software ecosystem on the telemedicine services of Denmark would address these issues and investigate how a software ecosystem can foster the development, implementation, and use of telemedicine services. We initially expand the theory of software ecosystems by contributing to the definition and understanding of software ecosystems, providing means of analyzing existing and designing new ecosystems, and defining and measuring the qualities of software ecosystems. We use these contributions to design a software ecosystem in the telemedicine services of Denmark with (i) a common platform that supports and promotes development from different actors, (ii) high software interaction, (iii) strong social network of actors, (iv) robust business structures, supporting actor involvement in the ecosystem, and (v) proper orchestration and governance of the ecosystem to promote and support the changes and the health of the ecosystem. Our work contributes to Net4Care, a platform to serve as the common platform in the software ecosystem under establishment. In addition, it contributes by providing input and guidelines on the role and activity of 4S organization, an organization to serve as an orchestrator in the ecosystem with the aim of managing the platform, supporting actor and software interactions, and promoting the ecosystem health. This thesis documents the groundwork towards addressing the challenges faced by telemedical technologies today and establishing telemedicine as a means of patient diagnosis and treatment. Furthermore, it serves as an empirical example of designing a software ecosystem.","author_count":1,"contributors":["Manikas, Konstantinos"],"cuid":["S01-000.00-465602"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"und","rtype":["clu"],"sorti":"analyzing modelling and designing software ecosystems towards the danish telemedicine software ecosystem","src":["ku"],"src-code":["DI-U-KU"],"type":"do","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://soeg.kb.dk/permalink/45KBDK_KGL/1pioq0f/alma99121963757805763","version":"Other Version"},"id":"S01-000.00-465602","ids":["ku-788f9e5f-b586-482b-ba36-0eaa8cbc177b"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-942AB0F6215031D2C394A15E867AEA3A"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Department of Computer Science","Københavns Universitet, Faculty of Science, Department of Computer Science, The HCC Section"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Konstantinos","key":"manikaspau","last":"Manikas","locid":"749e6138-99be-4563-b6ef-a375c5f9ffa6","name":"Manikas, Konstantinos","orcid":"0000-0001-8531-898X","rank":1,"rolecode":"pau"}],"pub":{"pages":"160","publisher":"Department of Computer Science, Faculty of Science, University of Copenhagen","status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-788f9e5f-b586-482b-ba36-0eaa8cbc177b"],"src":["KU University of Copenhagen"],"title":"Analyzing, Modelling, and Designing Software Ecosystems : Towards the Danish Telemedicine Software Ecosystem","type":"Other","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-465602","year":"2015","yearsub":"2015"}
{"abstract":"Classical software engineering has been traditionally dominated by stand-alone development organizations and collaborations be- tween contractors, integrators and suppliers. The notion of software ecosystems has been established as a new kind of software engineer- ing paradigm in the last decade. In its essence it proposes participative engineering across independent development organizations. This short paper reviews the current state-of-the-art and presents a typification of successful software ecosystems. We further discuss key characteristic of the ecosystem types and present a set of example cases. The characterization reviews and consolidates existing research and discusses variations within the key building block of a software ecosystem. It further enables sharpening the borders of what an ecosystem is (and what not) and how the individual types can be differentiated. Thus, this paper contributes to widening the understanding of software ecosystems.","author_count":5,"contributors":["Knodel, Jens","Manikas, Konstantinos"],"cuid":["S01-000.00-494332"],"event":{"acronym":"ICSOB","end":"2015-06-12","place":"Braga, pt","start":"2015-06-10","title":"6th International Conference on Software Business","year":"2015"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Faculty of Science","Software Engineering","Software ecosystems"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"towards a typification of software ecosystems","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-494332","identifier":[{"id":"84937400084","type":"scopus"}],"ids":["ku-a8e9be6e-813c-41be-901c-e81e8364724e"],"keyword":["Faculty of Science","ecosystem taxonomy","ecosystem types","software ecosystems","software engineering"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-FE52172BEA508199CC8D094C1A1E0089"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Department of Computer Science","Københavns Universitet, Faculty of Science, Department of Computer Science, The HCC Section"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Jens","key":"knodelpau","last":"Knodel","name":"Knodel, Jens","rank":1,"rolecode":"pau"},{"affno":"1","first":"Konstantinos","key":"manikaspau","last":"Manikas","locid":"749e6138-99be-4563-b6ef-a375c5f9ffa6","name":"Manikas, Konstantinos","orcid":"0000-0001-8531-898X","rank":2,"rolecode":"pau"},{"affno":"","first":"João M.","key":"fernandespedh","last":"Fernandes","name":"Fernandes, João M.","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Ricardo J.","key":"machadopedh","last":"Machado","name":"Machado, Ricardo J.","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Krzysztof","key":"wnukpedh","last":"Wnuk","name":"Wnuk, Krzysztof","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-319-19593-3_5","eisbn":["9783319195933"],"isbn":["9783319195926"],"issn":["18651348"],"pages":"60-65","publisher":"Springer","series":"Lecture Notes in Business Information Processing","status":"p","subtitle":"6th International Conference, ICSOB 2015, Braga, Portugal, June 10-12, 2015, Proceedings","title":"Software Business"},"review":"Peer Reviewed","scoID":["2-s2.0-84937400084"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-a8e9be6e-813c-41be-901c-e81e8364724e"],"src":["KU University of Copenhagen"],"title":"Towards a typification of software ecosystems","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-494332","year":"2015","yearsub":"2015"}
{"author_count":4,"contributors":["Syeed, M. M. Mahbubul","Hansen, Klaus Marius","Hammouda, Imed","Manikas, Konstantinos"],"cuid":["S01-000.00-450801"],"event":{"end":"2014-08-29","place":"Berlin, de","start":"2014-08-27","title":"International Symposium on Open Collaboration","year":"2014"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Finland","Sweden"],"glorg":["All Global Affiliations","Tampere University","University of Gothenburg"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"socio technical congruence in the ruby ecosystem","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-450801","identifier":[{"id":"84908637579","type":"scopus"}],"ids":["ku-5fd23f56-eacf-431e-aad7-6e1141e91007"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-DD965E780450B7BA75E040F58A3D3F39"],"org":[{"affno":"1","country":"fi","key":"tampere university","loc":["Finland","Europe, EU","Nordic","OECD"],"name":"Tampere University","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Department of Computer Science","Københavns Universitet, Faculty of Science, Department of Computer Science, The HCC Section"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"se","key":"university of gothenburg","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"University of Gothenburg","used":1}],"person":[{"affno":"1","first":"M. M. Mahbubul","key":"syeedpau","last":"Syeed","name":"Syeed, M. M. Mahbubul","rank":1,"rolecode":"pau"},{"affno":"2","first":"Klaus Marius","key":"hansenpau","last":"Hansen","locid":"d3f28440-9ea6-4c08-8622-11d418946f08","name":"Hansen, Klaus Marius","rank":2,"rolecode":"pau"},{"affno":"3","first":"Imed","key":"hammoudapau","last":"Hammouda","name":"Hammouda, Imed","rank":3,"rolecode":"pau"},{"affno":"2","first":"Konstantinos","key":"manikaspau","last":"Manikas","locid":"749e6138-99be-4563-b6ef-a375c5f9ffa6","name":"Manikas, Konstantinos","orcid":"0000-0001-8531-898X","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1145/2641580.2641586","isbn":["9781450330169"],"publisher":"Association for Computing Machinery","status":"p","title":"OpenSym '14. Proceedings of The International Symposium on Open Collaboration"},"review":"Peer Reviewed","scoID":["2-s2.0-84908637579"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-5fd23f56-eacf-431e-aad7-6e1141e91007"],"src":["KU University of Copenhagen"],"title":"Socio-technical congruence in the Ruby ecosystem","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-450801","year":"2014","yearsub":"2014"}
{"abstract":"Ecosystem governance becomes gradually more relevant for a set of companies or actors characterized by symbiotic relations evolved on the top of a technological platform, i.e. a software ecosystem. In this study, we focus on the governance of a hardware-dependent software ecosystem. More specifically, we evaluate the governance model applied by Axis, a network video and surveillance camera producer, that is the platform owner and orchestrator of the Application Development Partner (ADP) software ecosystem. We conduct an exploratory case study collecting data from observations and interviews and apply the governance model for prevention and improvement of the software ecosystem health proposed by Jansen and Cusumano. Our results reveal that although the governance actions do not address the majority of their governance model, the ADP ecosystem is considered a growing ecosystem providing opportunities for its actors. This can be explained by the fact that Axis, as the orchestrator and the platform owner, does not address the productivity and robustness of the ecosystem adequately, but has a network of vendors and resellers to support it and some of the governance activities (e.g. communication) are achieved by non-formal means. The current governance model does not take into consideration.","author_count":8,"contributors":["Wnuk, Krzysztof","Manikas, Konstantinos","Runeson, Per","Lantz, Matilda","Weijden, Oskar","Munir, Hussan"],"cuid":["S01-000.00-407268"],"event":{"acronym":"ICSOB","end":"2014-06-18","place":"Pafos, cy","start":"2014-06-16","title":"The International Conference on Software Business","year":"2014"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Sweden"],"glorg":["All Global Affiliations","Lund University"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"evaluating the governance model of hardware dependent software ecosystems a case study of the axis ecosystem","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-407268","identifier":[{"id":"84904550958","type":"scopus"}],"ids":["ku-1732d10e-df7c-4a0c-bc29-de485a67e134"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-8EAABF7C28FC986A7C46DBD6BBF71AE9"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","country":"se","key":"lund university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Lund University","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Department of Computer Science","Københavns Universitet, Faculty of Science, Department of Computer Science, The HCC Section"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Krzysztof","key":"wnukpau","last":"Wnuk","name":"Wnuk, Krzysztof","rank":1,"rolecode":"pau"},{"affno":"2","first":"Konstantinos","key":"manikaspau","last":"Manikas","locid":"749e6138-99be-4563-b6ef-a375c5f9ffa6","name":"Manikas, Konstantinos","orcid":"0000-0001-8531-898X","rank":2,"rolecode":"pau"},{"affno":"1","first":"Per","key":"runesonpau","last":"Runeson","name":"Runeson, Per","rank":3,"rolecode":"pau"},{"affno":"1","first":"Matilda","key":"lantzpau","last":"Lantz","name":"Lantz, Matilda","rank":4,"rolecode":"pau"},{"affno":"1","first":"Oskar","key":"weijdenpau","last":"Weijden","name":"Weijden, Oskar","rank":5,"rolecode":"pau"},{"affno":"1","first":"Hussan","key":"munirpau","last":"Munir","name":"Munir, Hussan","rank":6,"rolecode":"pau"},{"affno":"","first":"Casper","key":"lasseniuspedh","last":"Lassenius","name":"Lassenius, Casper","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Kari","key":"smolanderpedh","last":"Smolander","name":"Smolander, Kari","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-319-08738-2_15","eisbn":["9783319087382"],"isbn":["9783319087375"],"issn":["18651348"],"pages":"212-226","publisher":"Springer","series":"Lecture Notes in Business Information Processing","status":"p","subtitle":"5th International Conference, ICSOB 2014, Paphos, Cyprus, June 16-18, 2014. Proceedings","title":"Software business. Towards continuous value delivery"},"review":"Peer Reviewed","scoID":["2-s2.0-84904550958"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-1732d10e-df7c-4a0c-bc29-de485a67e134"],"src":["KU University of Copenhagen"],"title":"Evaluating the governance model of hardware-dependent software ecosystems - a case study of the axis ecosystem","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-407268","year":"2014","yearsub":"2014"}
{"abstract":"The introduction of the `app store' concept has challenged the way software is distributed and marketed: developers have easier access to customers, while customers have easy access to innovative applications. Apps today are increasingly focusing on more \"mission-critical\" areas like healthcare with the Apple AppStore counting more than 40,000 apps under the category \"health & fitness\". This rapid development of healthcare apps increases the necessity of governance as, currently, healthcare apps are not thoroughly governed. The U.S. Food and Drug Administration and the European Commission only have policies for apps that are medical devices.In this paper, we approach the problem of how to govern healthcare and medical apps by addressing the risks the use of these apps pose, while at the same time inviting for development of new apps. To do so we (i) analyze four cases of healthcare app governance/regulation, (ii) propose the analysis of the app governance from three perspectives: aim, impact, and revenues, (iii) apply the proposed analysis in the app of the healthcare domain, and (iv) identify the governing actors and propose governance policies.","author_count":4,"contributors":["Manikas, Konstantinos","Hansen, Klaus Marius","Kyng, Morten"],"cuid":["S02-099.60-018847"],"event":{"end":"2014-08-29","place":"Vienna, at","start":"2014-08-25","title":"European Conference on Software Architecture Workshops","year":"2014"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GTS","DI-U"],"level3":{"GTS":["DI-GTS-ALL","DI-GTS-ALX"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-UND"]},"level3all":["DI-GTS-ALX","DI-U-AU","DI-U-KU","DI-U-UND"]},"review":"pr","rtype":["clu"],"sorti":"governance mechanisms for healthcare apps","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1145/2642803.2642813","version":"Other Version"},"id":"S02-099.60-018847","identifier":[{"id":"84907419513","type":"scopus"}],"ids":["au-54e04ffc-908a-46d9-bebd-9078f411d526","ku-1889bc79-5ba9-4307-838c-61ee0be4b682"],"keyword":["app risks","app risks, app store governance, healthcare apps","app store governance","healthcare apps"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-21410FB63B0F285DEBC19FB24215CE5F"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1145/2642803.2642813","version":"Other Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Department of Computer Science","Københavns Universitet, Faculty of Science, Department of Computer Science, The HCC Section"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Computer Science"],"nora_code":"DI-U-AU","used":1},{"affno":"3","key":"alexandra institute","l2":"DI-GTS","l2n":"GTS Institutes","l3":"DI-GTS-ALX","l3nn":"Alexandra Institute","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Alexandra Institute","namevar":["Alexandra Instituttet A/S"],"nora_code":"DI-GTS-ALX","used":1},{"affno":"4","country":"dk","key":"unclear universities","l2":"DI-U","l2n":"Universities","l3":"DI-U-UND","l3nl":"Undetermined","l3nn":"Unclear Universities","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Unclear Universities","namevar":["Institut for Datalogi"],"nora_code":"DI-U-UND","used":1}],"person":[{"affno":"1","first":"Konstantinos","key":"manikaspau","last":"Manikas","locid":"749e6138-99be-4563-b6ef-a375c5f9ffa6","name":"Manikas, Konstantinos","orcid":"0000-0001-8531-898X","rank":1,"rolecode":"pau"},{"affno":"1","first":"Klaus Marius","key":"hansenpau","last":"Hansen","locid":"d3f28440-9ea6-4c08-8622-11d418946f08","name":"Hansen, Klaus Marius","rank":2,"rolecode":"pau"},{"affno":"2 3 4","corresponding":null,"country":"dk","first":"Morten","key":"kyngpau","last":"Kyng","locid":"f0486b10-a937-4cd9-aa99-168060eea4fc","name":"Kyng, Morten","rank":3,"rolecode":"pau"},{"affno":"","first":"Uwe","key":"zdunpedh","last":"Zdun","name":"Zdun, Uwe","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1145/2642803.2642813","isbn":["9781450327787"],"publisher":"Association for Computing Machinery","status":"p","title":"Proceedings of the 2014 European Conference on Software Architecture Workshops, ECSAW '14"},"review":"Peer Reviewed","scoID":["2-s2.0-84907419513"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All GTS Institutes","All Universities","DI-ALL","DI-GTS","DI-GTS-ALL","DI-U","DI-U-ALL","GTS Institutes","Undetermined","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-54e04ffc-908a-46d9-bebd-9078f411d526","ku-1889bc79-5ba9-4307-838c-61ee0be4b682"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Governance mechanisms for healthcare apps","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.60-018847","year":"2014","yearsub":"2014"}
{"abstract":"Context Telemedicine, the provision of health care at a distance, is arguably an effective way of increasing access to, reducing cost of, and improving quality of care. However, the deployment of telemedicine is faced with standards that are hard to use, application-specific data models, and application stove-pipes that inhibit the adoption of telemedical solutions. To which extent can a software ecosystem approach to telemedicine alleviate this? Objective In this article, we define the concept of software ecosystem architecture as the structure(s) of a software ecosystem comprising elements, relations among them, and properties of both. Our objective is to show how this concept can be used i) in the analysis of existing software ecosystems and ii) in the design of new software ecosystems. Method We performed a mixed-method study that consisted of a case study and an experiment. For i), we performed a descriptive, revelatory case study of the Danish telemedicine ecosystem and for ii), we experimentally designed, implemented, and evaluated the architecture of 4S. Results We contribute in three areas. First, we define the software ecosystem architecture concept that captures organization, business, and software aspects of software ecosystems. Secondly, we apply this concept in our case study and demonstrate that it is a viable concept for software ecosystem analysis. Finally, based on our experiments, we discuss the practice of software engineering for software ecosystems drawn from experience in creating and evolving the 4S telemedicine ecosystem. Conclusion The concept of software ecosystem architecture can be used analytically and constructively in respectively the analysis and design of software ecosystems.","author_count":4,"contributors":["Christensen, Henrik Bærbak","Hansen, Klaus Marius","Kyng, Morten","Manikas, Konstantinos"],"cuid":["S02-100.00-019808"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"analysis and design of software ecosystem architectures towards the 000000000004s telemedicine ecosystem","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-SA","type":"doi","url":"https://doi.org/10.1016/j.infsof.2014.05.002","version":"Published Version"},"id":"S02-100.00-019808","identifier":[{"id":"84905483485","type":"scopus"}],"ids":["au-628c24ab-ee12-40b8-a6e6-b7a03d5852d9","ku-46d8c6ed-460c-404e-944f-d13a7602d6d7"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-33E5E603A1D32A41B91A343F10BD6867"],"oa_link":[{"access":"oa","license":"CC BY-NC-SA","type":"doi","url":"https://doi.org/10.1016/j.infsof.2014.05.002","version":"Published Version"},{"access":"oa","license":"CC BY-NC-SA","type":"loc","url":"https://curis.ku.dk/ws/files/168933882/Christensen_2014_Analysis_and_design.pdf","version":"Published Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Computer Science"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Department of Computer Science","Københavns Universitet, Faculty of Science, Department of Computer Science, The HCC Section"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Henrik Bærbak","key":"christensenpau","last":"Christensen","locid":"4f747aba-32e8-4492-841f-1f9130be6909","name":"Christensen, Henrik Bærbak","orcid":"0000-0002-1645-1901","rank":1,"rolecode":"pau"},{"affno":"2","first":"Klaus Marius","key":"hansenpau","last":"Hansen","locid":"d3f28440-9ea6-4c08-8622-11d418946f08","name":"Hansen, Klaus Marius","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Morten","key":"kyngpau","last":"Kyng","locid":"f0486b10-a937-4cd9-aa99-168060eea4fc","name":"Kyng, Morten","rank":3,"rolecode":"pau"},{"affno":"2","first":"Konstantinos","key":"manikaspau","last":"Manikas","locid":"749e6138-99be-4563-b6ef-a375c5f9ffa6","name":"Manikas, Konstantinos","orcid":"0000-0001-8531-898X","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.infsof.2014.05.002","issn":["09505849","18736025"],"issn_org":["09505849"],"issue":"11","journal":"Information and Software Technology","pages":"1476-1492","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"p","title":"Information and Software Technology","volume":"56"},"review":"Peer Reviewed","scoID":["2-s2.0-84905483485"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-628c24ab-ee12-40b8-a6e6-b7a03d5852d9","ku-46d8c6ed-460c-404e-944f-d13a7602d6d7"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Analysis and design of software ecosystem architectures – Towards the 4S telemedicine ecosystem","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-019808","year":"2014","yearsub":"2014"}
{"abstract":"The use of telemedicine is arguably beneficial even in densely populated areas in reducing cost and increasing efficiency of healthcare. However, the implementation of telemedicine solutions in the healthcare system of Denmark has been perceived as being faced with implementation and interoperability issues, silo solutions, and lack of guidelines and standards. In this paper, we characterise the ecosystem evolved around the telemedicine services in Denmark and study the actors involved in this ecosystem. We establish a method for this study, where we define two actor roles and ways of characterizing actor contributions, and apply the method to the largest healthcare region of Denmark. Our findings reveal an ecosystem that is relatively closed to new actors, where the actors tend to be related to single telemedicine applications, the applications have low connectivity, and the most influential actors of the ecosystem can be characterised as both being beneficial and inhibitory to the ecosystem prosperity.","author_count":2,"contributors":["Manikas, Konstantinos","Hansen, Klaus Marius"],"cuid":["S01-000.00-455098"],"event":{"acronym":"MEDES","end":"2013-10-31","place":"Luxembourg, lu","start":"2013-10-28","title":"Fifth International Conference on Management of Emergent Digital EcoSystems","year":"2013"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"characterizing the danish telemedicine ecosystem making sense of actor relationships","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-455098","identifier":[{"id":"84892660927","type":"scopus"}],"ids":["ku-674aa72d-aa42-4bc3-80e1-aaa28a8546f3"],"keyword":["ecosystem actor analysis, software ecosystem, telemedicine ecosystem"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-27D19D87AA7C71CF86E91E5018A96F40"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Department of Computer Science","Københavns Universitet, Faculty of Science, Department of Computer Science, The HCC Section"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Konstantinos","key":"manikaspau","last":"Manikas","locid":"749e6138-99be-4563-b6ef-a375c5f9ffa6","name":"Manikas, Konstantinos","orcid":"0000-0001-8531-898X","rank":1,"rolecode":"pau"},{"affno":"1","first":"Klaus Marius","key":"hansenpau","last":"Hansen","locid":"d3f28440-9ea6-4c08-8622-11d418946f08","name":"Hansen, Klaus Marius","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1145/2536146.2536156","isbn":["9781450320047"],"pages":"211-218","publisher":"Association for Computing Machinery","status":"p","subtitle":"MEDES '13","title":"Proceedings of the Fifth International Conference on Management of Emergent Digital EcoSystems"},"review":"Peer Reviewed","scoID":["2-s2.0-84892660927"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-674aa72d-aa42-4bc3-80e1-aaa28a8546f3"],"src":["KU University of Copenhagen"],"title":"Characterizing the Danish telemedicine ecosystem : making sense of actor relationships","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-455098","year":"2013","yearsub":"2014"}
{"abstract":"The health of a software ecosystem is an indication of how well the ecosystem is functioning. The measurement of health can point to issues that need to be addressed in the ecosystem and areas for the ecosystem to improve. However, the software ecosystem field lacks an applicable way to measure and evaluate health. In this work, we review the literature related to the concept of software ecosystem health and the literature that inspired the software ecosystem health literature (a total of 23 papers) and (i) identify that the main source of inspiration is the health of business ecosystems while also influenced by theories from natural ecosystems and open source, (ii) identify two areas where software ecosystems differ from business and natural ecosystems, and (iii) propose a conceptual framework for defining and measuring the health of software ecosystems.","author_count":6,"contributors":["Manikas, Konstantinos","Hansen, Klaus Marius"],"cuid":["S01-000.00-509105"],"event":{"end":"2013-06-14","place":"Potsdam, de","start":"2013-06-11","title":"5th Workshop on Software Ecosystems (IWSECO)","year":"2013"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Ecosystem health","Faculty of Science","Software ecosystems"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"reviewing the health of software ecosystems a conceptual framework proposal","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/169410195/software_ecosystems.pdf","version":"Authors Final Version"},"id":"S01-000.00-509105","ids":["ku-c1c4d11c-53c8-4822-a385-fdbdb16137fe"],"keyword":["Faculty of Science","ecosystem health","software ecosystem health measurement","software ecosystems","software ecosystme health framework"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-2E2AC80671AC506056545CF850D163A1"],"oa_link":[{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/169410195/software_ecosystems.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Department of Computer Science","Københavns Universitet, Faculty of Science, Department of Computer Science, The HCC Section"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Konstantinos","key":"manikaspau","last":"Manikas","locid":"749e6138-99be-4563-b6ef-a375c5f9ffa6","name":"Manikas, Konstantinos","orcid":"0000-0001-8531-898X","rank":1,"rolecode":"pau"},{"affno":"1","first":"Klaus Marius","key":"hansenpau","last":"Hansen","locid":"d3f28440-9ea6-4c08-8622-11d418946f08","name":"Hansen, Klaus Marius","rank":2,"rolecode":"pau"},{"affno":"","first":"Carina F.","key":"alvespedh","last":"Alves","name":"Alves, Carina F.","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Geir K.","key":"hanssenpedh","last":"Hanssen","name":"Hanssen, Geir K.","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Jan","key":"boschpedh","last":"Bosch","name":"Bosch, Jan","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Slinger","key":"jansenpedh","last":"Jansen","name":"Jansen, Slinger","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"issn":["16130073"],"pages":"33-44","series":"CEUR Workshop Proceedings","status":"p","title":"Proceedings of 5th International Workshop on Software Ecosystems (IWSECO 2013)"},"review":"Peer Reviewed","scoID":["2-s2.0-84923699491"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-c1c4d11c-53c8-4822-a385-fdbdb16137fe"],"src":["KU University of Copenhagen"],"title":"Reviewing the health of software ecosystems – a conceptual framework proposal.","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-509105","year":"2013","yearsub":"2013"}
{"abstract":"\"Software ecosystems'' are gaining importance in commercial software development; the iPhone iOS and Salesforce.com ecosystems are examples of this. In contrast to traditional forms of software reuse, such as common platforms or product lines, software ecosystems have a heterogeneous set of actors sharing and collaborating over one or more technological platforms and business model(s) that serve the actors. However, little research has investigated the properties of actual software ecosystems. In this paper, we present an exploratory study of software ecosystems using the formalizations and metrics of the \"network ecology'' approach to the analysis of natural ecosystems. In doing so, we mine the Maven central Java repository and analyze two OSGi ecosystems: Apache Felix and Eclipse Equinox. In particular, we define the concept of an ecosystem ``neighborhood'', apply network ecology metrics to these neighborhoods (including a keystone index that identifies the importance of elements in the ecosystem), and compare the ecosystems.","author_count":2,"contributors":["Hansen, Klaus Marius","Manikas, Konstantinos"],"cuid":["S01-000.00-496703"],"event":{"acronym":"SEKE","end":"2013-06-29","place":"Boston, us","start":"2013-06-27","title":"The 25th International Conference on Software Engineering and Knowledge Engineering (SEKE)","year":"2013"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Dependency graphs","Faculty of Science","Software ecosystems","network ecology"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"towards a network ecology of software ecosystems an analysis of two osgi ecosystems","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.ksi.edu/seke/Proceedings/seke/SEKE2013_Proceedings.pdf","version":"Other Version"},"id":"S01-000.00-496703","identifier":[{"id":"84923685619","type":"scopus"}],"ids":["ku-acdf0c05-97d9-475f-bd79-8ae6e93378d5"],"keyword":["Faculty of Science","dependency graphs","dependency structure","network ecology","software ecosystems"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-D7F5BBA06FCBD65B717DD4313F9CE88A"],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science, Department of Computer Science","Københavns Universitet, Faculty of Science, Department of Computer Science, The HCC Section"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Klaus Marius","key":"hansenpau","last":"Hansen","locid":"d3f28440-9ea6-4c08-8622-11d418946f08","name":"Hansen, Klaus Marius","rank":1,"rolecode":"pau"},{"affno":"1","first":"Konstantinos","key":"manikaspau","last":"Manikas","locid":"749e6138-99be-4563-b6ef-a375c5f9ffa6","name":"Manikas, Konstantinos","orcid":"0000-0001-8531-898X","rank":2,"rolecode":"pau"}],"pub":{"isbn":["9781891706332"],"issn":["23259000"],"pages":"326-331","publisher":"Knowledge Systems Institute Graduate School","series":"Proceedings of the International Conference on Software Engineering and Knowledge Engineering","status":"p","subtitle":"proceedings","title":"The 25<sup>th</sup> International Conference on Software Engineering &amp; Knowledge Engineering SEKE 2013"},"review":"Peer Reviewed","scoID":["2-s2.0-84923685619"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-acdf0c05-97d9-475f-bd79-8ae6e93378d5"],"src":["KU University of Copenhagen"],"title":"Towards a network ecology of software ecosystems : an analysis of two OSGi ecosystems","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-496703","year":"2013","yearsub":"2013"}
{"abstract":"A software ecosystem is the interaction of a set of actors on top of a common technological platform that results in a number of software solutions or services. Arguably, software ecosystems are gaining importance with the advent of, e.g., the Google Android, Apache, and Salesforce.com ecosystems. However, there exists no systematic overview of the research done on software ecosystems from a software engineering perspective. We performed a systematic literature review of software ecosystem research, analyzing 90 papers on the subject taken from a gross collection of 420. Our main conclusions are that while research on software ecosystems is increasing (a) there is little consensus on what constitutes a software ecosystem, (b) few analytical models of software ecosystems exist, and (c) little research is done in the context of real-world ecosystems. This work provides an overview of the field, while identifying areas for future research.","author_count":2,"contributors":["Manikas, Konstantinos","Hansen, Klaus Marius"],"cuid":["S01-000.00-513101"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Faculty of Science","Software ecosystems","Systematic literature review"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"software ecosystems a systematic literature review","src":["ku"],"src-code":["DI-U-KU"],"type":"djr","type-grp":["all","pub"]},"id":"S01-000.00-513101","identifier":[{"id":"84875249659","type":"scopus"}],"ids":["ku-c86c02e7-4370-45e6-afb1-23b9e114d2cc"],"keyword":["Faculty of Science","Software ecosystem","Software ecosystems","Systematic literature review"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-4108391D07DB951FCA3DAC234011F1CF"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Computer Science","Københavns Universitet, Faculty of Science, Department of Computer Science, The HCC Section"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","country":"dk","first":"Konstantinos","key":"manikaspau","last":"Manikas","locid":"749e6138-99be-4563-b6ef-a375c5f9ffa6","name":"Manikas, Konstantinos","orcid":"0000-0001-8531-898X","rank":1,"rolecode":"pau"},{"affno":"1","first":"Klaus Marius","key":"hansenpau","last":"Hansen","locid":"d3f28440-9ea6-4c08-8622-11d418946f08","name":"Hansen, Klaus Marius","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.jss.2012.12.026","issn":["01641212","18731228"],"issn_org":["01641212"],"issue":"5","journal":"Journal of Systems and Software","pages":"1294-1306","status":"p","title":"Journal of Systems and Software","volume":"86"},"review":"Peer Reviewed","scoID":["2-s2.0-84875249659"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-c86c02e7-4370-45e6-afb1-23b9e114d2cc"],"src":["KU University of Copenhagen"],"title":"Software ecosystems – a systematic literature review","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-513101","year":"2013","yearsub":"2013"}
