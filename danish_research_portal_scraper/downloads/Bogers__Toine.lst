{"abstract":"The Social Book Search (SBS) Lab investigates book search in scenarios where users search with more than just a query, and look for more than objective metadata. Real-world information needs are generally complex, yet almost all research focuses instead on either relatively simple search based on queries or recommendation based on profiles. The goal is to research and develop techniques to support users in complex book search tasks. The SBS Lab has two tracks. The aim of the Suggestion Track is to develop test collections for evaluating ranking effectiveness of book retrieval and recommender systems. The aim of the Interactive Track is to develop user interfaces that support users through each stage during complex search tasks and to investigate how users exploit professional metadata and user-generated content.","author_count":17,"contributors":["Koolen, Marijn","Bogers, Toine","Gäde, Maria","Hall, Mark","Huurdeman, Hugo","Kamps, Jaap","Skov, Mette","Toms, Elaine","Walsh, David"],"cuid":["S02-081.13-715680"],"event":{"acronym":"CLEF","end":"2015-09-11","place":"Toulouse, fr","start":"2015-09-08","title":"CLEF 2015","year":"2015"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","Europe, Non-EU","OECD"],"country":["Germany","Netherlands","United Kingdom"],"glorg":["All Global Affiliations","Edge Hill University","Humboldt University of Berlin","University of Amsterdam","University of Sheffield"],"keyword":["Evaluation","Information retrieval","Search engines"],"level":"sci","mra":["hum","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"overview of the clef 000000002015 social book search lab","src":["aau","itu"],"src-code":["DI-U-AAU","DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/222975969/kool_over15.pdf","version":"Published Version"},"id":"S02-081.13-715680","identifier":[{"id":"84945931058","type":"scopus"},{"id":"WOS:000364677800054","type":"wos"}],"ids":["aau-67e39b99-b3bb-4bae-b238-d3dbe5308bde","itu-e8a95a58-5147-44fb-be16-c3858f95c009"],"keyword":["evaluation","information retrieval","search engines"],"lang":"English","level":"Scientific","mra":["Humanities","Science/Technology"],"noi":["Global-Local-2-5-3EF301D8007DC74DFB22B385E812C121"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/222975969/kool_over15.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Humanities (HUM)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","country":"nl","key":"university of amsterdam","loc":["Netherlands","Europe, EU","OECD"],"name":"University of Amsterdam","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Humanities","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Communication and Information Studies (CIS)"],"nora_code":"DI-U-AAU","used":1},{"affno":"3","country":"de","key":"humboldt university of berlin","loc":["Germany","Europe, EU","OECD"],"name":"Humboldt University of Berlin","used":1},{"affno":"4","country":"gb","key":"edge hill university","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Edge Hill University","used":1},{"affno":"5","country":"gb","key":"university of sheffield","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Sheffield","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Marijn",