niversity of Skövde","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Casper","key":"petersenped","last":"Petersen","name":"Petersen, Casper","rank":1,"role":"Editor","rolecode":"ped"},{"affno":"2","corresponding":null,"country":"dk","first":"Toine","key":"bogersped","last":"Bogers","locid":"c39fa087-a00a-425e-9e0f-7fa301dbe554","name":"Bogers, Toine","orcid":"0000-0003-0716-676X","rank":2,"role":"Editor","rolecode":"ped"},{"affno":"3","corresponding":null,"first":"Marijn","key":"koolenped","last":"Koolen","name":"Koolen, Marijn","rank":3,"role":"Editor","rolecode":"ped"},{"affno":"4","corresponding":null,"first":"Bamshad","key":"mobasherped","last":"Mobasher","name":"Mobasher, Bamshad","rank":4,"role":"Editor","rolecode":"ped"},{"affno":"5","corresponding":null,"first":"Alan","key":"saidped","last":"Said","name":"Said, Alan","rank":5,"role":"Editor","rolecode":"ped"}],"pub":{"pages":"37","status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Other Companies","Private Research","Universities","sampension"],"PST":["Published"]},"sid":["aau-2efec396-bf46-451c-96d7-519b52ad5f13"],"src":["AAU Aalborg University"],"title":"ComplexRec 2018 : Proceedings of Second Workshop on Recommendation in Complex Scenarios","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-063678","year":"2018","yearsub":"2018"}
{"abstract":"Interactive IR studies are commonly conducted by assigning participants simulated work tasks situations (SWTS), predetermined textual descriptions of an information need and its context to motivate participants to perform realistic searches of the IR system in question. Despite their popularity, research has shown that formulating realistic and engaging SWTSs remains challenging. In this paper, we propose using the analyses of large samples of complex real-world search requests—with the specific case of book search—to inject realism into SWTSs by taking different relevance aspects and their relative frequencies into account when formulating them. This should make it easier for researchers to design realistic SWTSs in the future.","author_count":2,"contributors":["Borlund, Pia","Bogers, Toine"],"cuid":["S01-000.00-066774"],"event":{"end":"2018-11-14","place":"Vancouver, ca","start":"2018-11-10","title":"ASIST 2018: 81st Annual Meeting of the Association for Information Science and Technology","year":"2018"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, Non-EU","Nordic","OECD"],"country":["Norway"],"glorg":["All Global Affiliations","Oslo Metropolitan University"],"keyword":["Information science"],"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"injecting realism into simulated work tasks a case study of the book domain","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/291836354/20180629.camera_ready.pdf","version":"Authors Final Version"},"id":"S01-000.00-066774","identifier":[{"id":"85064499739","type":"scopus"}],"ids":["aau-39a6f87d-3730-40c8-943e-b27a645a2f3a"],"keyword":["information science"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-36E9317069122FF3EE0418A5D0B3960F"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/291836354/20180629.camera_ready.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Humanities (HUM)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","country":"no","key":"oslo metropolitan university","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"Oslo Metropolitan University","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Humanities","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Science and Information Studies","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Science, Policy and Information Studies"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Pia","key":"borlundpau","last":"Borlund","name":"Borlund, Pia","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Toine","key":"bogerspau","last":"Bogers","locid":"c39fa087-a00a-425e-9e0f-7fa301dbe554","name":"Bogers, Toine","orcid":"0000-0003-0716-676X","rank":2,"rolecode":"pau"}],"pub":{"eisbn":["9780578414256"],"issn":["00447870"],"pages":"759-761","place":"Vancouver, Canada","publisher":"Association for Information Science and Technology","series":"American Society for Information Science & Technology. Annual Meeting Proceedings","status":"p","title":"Proceedings of the 81st Annual Meeting of the Association for Information Science and Technology (ASIST 2018)"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-39a6f87d-3730-40c8-943e-b27a645a2f3a"],"src":["AAU Aalborg University"],"title":"Injecting Realism into Simulated Work Tasks : A Case Study of the Book Domain","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-066774","year":"2018","yearsub":"2018"}
{"abstract":"In recent decades, information retrieval research has slowly expanded its focus to address the wealth of complex search requests present in our work and leisure environments. A better understanding of such complex needs could aid in the design of more effective, domain-specific search engines. In this paper we take a first step towards such domain-specific understanding. We present an analysis of a random sample of 1000+ complex book and movie search requests posted in the LibraryThing and Internet Movie Database forums. A coding scheme was developed that captures the 29 different relevance aspects expressed in these requests. We find that while the identified relevance aspects are remarkably similar for complex book and movie requests, their relative occurrence does vary considerably from domain to domain.","author_count":9,"contributors":["Bogers, Toine","Gäde, Maria","Koolen, Marijn","Petras, Vivien","Skov, Mette"],"cuid":["S01-000.00-082282"],"event":{"acronym":"iConference","end":"2018-03-28","place":"Sheffield, gb","start":"2018-03-25","title":"iConference 2018","year":"2018"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany","Netherlands"],"glorg":["All Global Affiliations","Humboldt University of Berlin","Royal Netherlands Academy of Arts and Sciences"],"keyword":["Book search","Information need categorization","Movie search","Query analysis","Relevance aspects"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"what was this movie about this chick a comparative study of relevance aspects in book and movie discovery","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85044407777&partnerID=8YFLogxK","version":"Other Version"},"id":"S01-000.00-082282","identifier":[{"id":"85044407777","type":"scopus"}],"ids":["aau-6ec395fc-6c79-4184-8c38-9a7fc4edaf1d"],"keyword":["Book search","Information need categorization","Movie search","Query analysis","Relevance aspects"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-4-7BB2B7D7014E05B472EC889E53CE5BF5"],"oai":{"class":"Unused","mra":["Humanities (HUM)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Humanities","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Science and Information Studies","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Science, Policy and Information Studies"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"de","key":"humboldt university of berlin","loc":["Germany","Europe, EU","OECD"],"name":"Humboldt University of Berlin","used":1},{"affno":"3","country":"nl","key":"royal netherlands academy of arts and sciences","loc":["Netherlands","Europe, EU","OECD"],"name":"Royal Netherlands Academy of Arts and Sciences","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Toine","key":"bogerspau","last":"Bogers","locid":"c39fa087-a00a-425e-9e0f-7fa301dbe554","name":"Bogers, Toine","orcid":"0000-0003-0716-676X","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Maria","key":"gädepau","last":"Gäde","name":"Gäde, Maria","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first