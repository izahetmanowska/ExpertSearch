{"author_count":5,"contributors":["Lops, Pasquale","Jannach, Dietmar","Musto, Cataldo","Bogers, Toine","Koolen, Marijn"],"cuid":["S01-000.00-089294"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"corresponding_author":["Lops, Pasquale"],"country":["Austria","Italy","Netherlands"],"glorg":["All Global Affiliations","Royal Netherlands Academy of Arts and Sciences","University of Bari","University of Klagenfurt"],"keyword":["Recommender systems","content based filtering","content based recommendation","content based recommender systems"],"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"trends in content based recommendation preface to the special issue on recommender systems based on rich item descriptions","src":["aau"],"src-code":["DI-U-AAU"],"type":"dje","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s11257-019-09231-w","version":"Published Version"},"id":"S01-000.00-089294","identifier":[{"id":"85062776843","type":"scopus"}],"ids":["aau-86c63725-f33f-4228-ab4e-e5d57347249c"],"keyword":["content-based filtering","content-based recommendation","content-based recommender systems","recommender systems"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-4-0C273CF92F9FE3BCAAA4D5132AF032A2"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s11257-019-09231-w","version":"Published Version"}],"oai":{"class":"Unused","mra":["Humanities (HUM)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","country":"it","key":"university of bari","loc":["Italy","Europe, EU","OECD"],"name":"University of Bari","used":1},{"affno":"2","country":"at","key":"university of klagenfurt","loc":["Austria","Europe, EU","OECD"],"name":"University of Klagenfurt","used":1},{"affno":"3","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Humanities","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Science and Information Studies","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Science, Policy and Information Studies"],"nora_code":"DI-U-AAU","used":1},{"affno":"4","country":"nl","key":"royal netherlands academy of arts and sciences","loc":["Netherlands","Europe, EU","OECD"],"name":"Royal Netherlands Academy of Arts and Sciences","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Pasquale","key":"lopspau","last":"Lops","name":"Lops, Pasquale","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Dietmar","key":"jannachpau","last":"Jannach","name":"Jannach, Dietmar","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Cataldo","key":"mustopau","last":"Musto","name":"Musto, Cataldo","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Toine","key":"bogerspau","last":"Bogers","locid":"c39fa087-a00a-425e-9e0f-7fa301dbe554","name":"Bogers, Toine","orcid":"0000-0003-0716-676X","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Marijn","key":"koolenpau","last":"Koolen","name":"Koolen, Marijn","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1007/s11257-019-09231-w","issn":["09241868","15731391"],"issn_org":["09241868"],"issue":"2","journal":"User Modeling and User-Adapted Interaction","pages":"239-249","publisher":"Springer","status":"p","title":"User Modeling and User-Adapted Interaction","volume":"29"},"review":"Peer Reviewed","scoID":["2-s2.0-85062776843"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-86c63725-f33f-4228-ab4e-e5d57347249c"],"src":["AAU Aalborg University"],"title":"Trends in content-based recommendation : Preface to the special issue on Recommender systems based on rich item descriptions","type":"Editorial","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-089294","year":"2019","yearsub":"2019"}
{"abstract":"Intelligent personal assistants (IPA), such as Siri, Google Assistant, Alexa, and Cortana, are rapidly becoming a popular way of interacting with our smart devices. As a result, there has been a wealth of research on all aspects of IPAs in recent years, such as studies of usage of and user satisfaction with IPAs. However, the overwhelming majority of these studies have focused on English as the interaction language. In this paper, we investigate the usage and perceived usability of IPAs in Denmark. We conduct a questionnaire with 357 Danish-speaking respondents that sheds light on how IPAs are used in Denmark. We find they are only used regularly by 19.9% of respondents and that most people do not find IPAs to be reliable. We also conduct a usability study of Siri and find that Siri suffers from several issues when used in Danish: poor voice recognition, unnatural dialogue responses, and an inability to support mixed-language speech recognition. Our findings shed light on both the current state of usage and adoption of IPAs in Denmark as well as the usability of its most popular IPA in a foreign-language setting.","author_count":11,"contributors":["Bogers, Toine","Al-Basri, Ammar Ali Abdelrahim","Ostermann Rytlig, Claes","Bak Møller, Mads Emil","Juhl Rasmussen, Mette","Bates Michelsen, Nikita Katrine","Gerling Jørgensen, Sara"],"cuid":["S02-082.14-715788"],"event":{"acronym":"iConference","end":"2019-04-03","place":"Washington, us","start":"2019-03-31","title":"14th International Conference on Information in Contemporary Society, iConference 2019","year":"2019"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Bogers, Toine"],"keyword":["IPA","Information behavior","Intelligent Personal Assistants","Siri","Usability"],"level":"sci","mra":["hum","sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"a study of usage and usability of intelligent personal assistants in denmark","src":["aau","itu"],"src-code":["DI-U-AAU","DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85064058193&partnerID=8YFLogxK","version":"Other Version"},"id":"S02-082.14-715788","identifier":[{"id":"85064058193","type":"scopus"}],"ids":["aau-d7cef94e-eabc-4400-be7d-ac157180b6b6","itu-7e5e8ea4-9d1c-434f-ae7c-0076d2943cf8"],"keyword":["IPA","Information behavior","Intelligent Personal Assistants","Siri","Usability"],"lang":"English","level":"Scientific","mra":["Humanities","Science/Technology"],"noi":["Global-Local-2-5-1507EE96781E368886360C9CB35C022F"],"oai":{"class":"Unused","mra":["Humanities (HUM)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Humanities","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Science, Policy and Information Studies"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Toine","key":"bogerspau","last":"Bogers","locid":"c39fa087-a00a-425e-9e0f-7fa301dbe554","name":"Bogers, Toine","orcid":"0000-0003-0716-676X","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ammar Ali Abdelrahim","key":"albasripau","last":"Al-Basri","locid":"cb5037b6-c718-41c3-b4a9-2dfbf552ccda","name":"Al-Basri, Ammar Ali Abdelrahim","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"