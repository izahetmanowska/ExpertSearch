{"abstract":"This paper presents an overview of the BIIRRR 2019 workshop at CHIIR 2019, which had the explicit aim of understanding and promoting re-use of resources for interactive IR experimentation.","author_count":9,"contributors":["Bogers, Toine","Dodson, Samuel","Freund, Luanne","Gäde, Maria","Hall, Mark","Koolen, Marijn","Petras, Vivien","Pharo, Nils","Skov, Mette"],"cuid":["S01-000.00-109851"],"event":{"end":"2019-03-14","place":"Glasgow, gb","start":"2019-03-14","title":"2019 CHIIR Workshop on Barriers to Interactive IR Resources Re-use, BIIRRR 2019","year":"2019"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Europe, EU","Europe, Non-EU","Nordic","OECD"],"country":["Canada","Germany","Netherlands","Norway"],"glorg":["All Global Affiliations","Humboldt University of Berlin","Martin Luther University Halle-Wittenberg","Oslo Metropolitan University","Royal Netherlands Academy of Arts and Sciences","University of British Columbia"],"keyword":["IIR","Re use","Research Design"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"nr","rtype":["clu"],"sorti":"overview of the chiir 000000002019 workshop on barriers to interactive ir resources re use biirrr 000000002019","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85063429497&partnerID=8YFLogxK","version":"Other Version"},"id":"S01-000.00-109851","identifier":[{"id":"85063429497","type":"scopus"}],"ids":["aau-cdf43f5a-a677-4dc9-bd7d-f448fba72f83"],"keyword":["IIR","Re-use","Research design"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-2-38D5E3A6A251481982F0B25FF16E41DA"],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"