ee519ad3-4a03-41b6-b504-7d7271a5b39a"],"src":["AAU Aalborg University"],"title":"RSLIS/AAU at CHiC 2013","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-771313","year":"2013","yearsub":"2013"}
{"abstract":"The Cultural Heritage in CLEF 2013 lab comprised three tasks: multilingual ad-hoc retrieval and semantic enrichment in 13 languages (Dutch, English, German, Greek, Finnish, French, Hungarian, Italian, Norwegian, Polish, Slovenian, Spanish, and Swedish), Polish ad-hoc retrieval and the interactive task, which studied user behavior via log analysis and questionnaires. For the multilingual and Polish sub-tasks, more than 170,000 documents were assessed for relevance on a tertiary scale. The multilingual task had 7 participants submitting 30 multilingual and 41 monolingual runs. The Polish task comprised 3 participating groups submitting manual and automatic runs. The interactive task had 4 participating research groups and 208 user participants in the study. For the multilingual task, results show that more participants are necessary in order to provide comparative analyses. The interactive task created a rich data set comprising of questionnaire of log data. Further analysis of the data is planned in the future.","author_count":9,"contributors":["Petras, Vivien","Bogers, Toine","Toms, Elaine","Hall, Mark","Savoy, Jacques","Malak, Piotr","Pawłowski, Adam","Ferro, Nicola","Masiero, Ivano"],"cuid":["S02-093.88-715602"],"event":{"end":"2013-09-26","place":"Valencia, es","start":"2013-09-23","title":"4th International Conference of the CLEF Initiative, CLEF 2013","year":"2013"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","Europe, Non-EU","OECD"],"country":["Germany","Italy","Poland","Switzerland","United Kingdom"],"glorg":["All Global Affiliations","Humboldt University of Berlin","University of Neuchatel","University of Neuchâtel","University of Padova","University of Padua","University of Sheffield","University of Wrocław"],"keyword":["Ad hoc retrieval","Cultural heritage","Europeana","Interactive","Multilingual retrieval","Polish","Semantic enrichment","User behavior"],"level":"sci","mra":["hum","sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-AAU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"cultural heritage in clef chic 000000002013","src":["aau","itu"],"src-code":["DI-U-AAU","DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=84886422761&partnerID=8YFLogxK","version":"Other Version"},"id":"S02-093.88-715602","identifier":[{"id":"84886422761","type":"scopus"}],"ids":["aau-1fcb3a96-6e96-48f2-82d3-e1b2963dea16","itu-046a5f88-64b2-4d65-b8cd-d1c476fc92a8"],"keyword":["Europeana","Polish","ad-hoc retrieval","cultural heritage","interactive","multilingual retrieval","semantic enrichment","user behavior"],"lang":"English","level":"Scientific","mra":["Humanities","Science/Technology"],"noi":["Global-Local-2-5-E21F5755E0C0DC5A09394FD91F318C29"],"org":[{"affno":"1","country":"de","key":"humboldt university of berlin","loc":["Germany","Europe, EU","OECD"],"name":"Humboldt University of Berlin","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Humanities","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Communication and Information Studies (CIS)","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Science, Policy and Information Studies"],"nora_code":"DI-U-AAU","used":1},{"affno":"3","country":"gb","key":"university of sheffield","loc":["United Kingdom","Europ