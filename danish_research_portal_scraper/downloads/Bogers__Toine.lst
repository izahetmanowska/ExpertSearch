ank":16,"rolecode":"pau"},{"affno":"","first":"Evangelos","key":"kanoulaspedh","last":"Kanoulas","name":"Kanoulas, Evangelos","rank":17,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Mihai","key":"lupupedh","last":"Lupu","name":"Lupu, Mihai","rank":18,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Paul","key":"cloughpedh","last":"Clough","name":"Clough, Paul","rank":19,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Mark","key":"sandersonpedh","last":"Sanderson","name":"Sanderson, Mark","rank":20,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Mark","key":"hallpedh","last":"Hall","name":"Hall, Mark","rank":21,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Allan","key":"hanburypedh","last":"Hanbury","name":"Hanbury, Allan","rank":22,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Elaine","key":"tomspedh","last":"Toms","name":"Toms, Elaine","rank":23,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-319-11382-1_19","isbn":["9783319113814"],"issn":["03029743"],"pages":"212-228","place":"Germany","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","title":"Information Access Evaluation. Multilinguality, Multimodality, and Interaction"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","ITU IT University of Copenhagen"],"PST":["Published"]},"sid":["itu-43589efa-1308-4f9d-b213-5b8bb0993a39"],"src":["ITU IT University of Copenhagen"],"title":"Overview of INEX 2014","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-718846","year":"2014","yearsub":"2014"}
{"abstract":"While content-based recommendation has been applied successfully in many different domains, it has not seen the same level of attention as collaborative filtering techniques have. In recent years, competitions like the Netflix Prize, CAMRA, and the Yahoo! Music KDD Cup 2011 have spurred on advances in collaborative filtering and how to utilize ratings and usage data. However, there are many domains where content and metadata play a key role, either in addition to or instead of ratings and implicit usage data. For some domains, such as movies the relationship between content and usage data has seen thorough investigation already, but for many other domains, such as books, news, scientific articles, and Web pages we do not know if and how these data sources should be combined to provided the best recommendation performance. The CBRecSys 2014 workshop aims to address this by providing a dedicated venue for papers dedicated to all aspects of content-based recommendation. We issued a Call for Papers asking for submissions of novel research papers (both long and short) addressing recommendation in do- mains where textual content is abundant (e.g., books, news, scientific articles, jobs, educational resources, Web pages, etc.) as well as dedicated comparisons of content-based techniques with collaborative filtering in different domains. Other relevant topics included opinion mining for text/book recommendation, semantic recommendation, content-based recommendation to allevi- ate cold-start problems, as well as serendipity, diversity and cross-domain recommendation.","author_count":3,"contributors":["Bogers, Toine","Koolen, Marijn","Cantádor, Ivan"],"cuid":["S01-000.00-053387"],"event":{"end":"2014-10-06","place":"Foster City, CA, us","start":"2014-10-06","title":"CBRecSys 2014","year":"2014"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Netherlands","Spain"],"glorg":["All Global Affiliations","Universidad Autónoma de Madrid","University of Amsterdam"],"keyword":["Context","Recommender systems","Semantics","User generated content","content based recommendation","implicit feedback","text reviews"],"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"workshop proceedings cbrecsys 000000002014 workshop on new trends in content based recommender systems","src":["aau"],"src-code":["DI-U-AAU"],"type":"db","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/206345400/cbrecsys2014_proceedings.pdf","version":"Published Version"},"id":"S01-000.00-053387","ids":["aau-0b782059-d825-4d0c-8ef4-70e4b5451b91"],"keyword":["content-based recommendation","context","implicit feedback","recommender systems","semantics","text reviews","user-generated content"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-CCD5FAD9E1CA1EB4E17F176C2CBB1A35"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/206345400/cbrecsys2014_proceedings.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Humanities","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Communication and Information Studies (CIS)"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"nl","key":"university of amsterdam","loc":["Netherlands","Europe, EU","OECD"],"name":"University of Amsterda