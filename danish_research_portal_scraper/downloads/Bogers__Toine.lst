{"abstract":"Users looking for books online are confronted with both professional meta-data and user-generated content. The goal of the Interactive Social Book Search Track was to investigate how users used these two sources of information, when looking for books in a leisure context. To this end, participants recruited by seven teams performed two main tasks and one optional task using a user-interface that supports multiple search stages.","author_count":12,"contributors":["Gäde, Maria","Hall, Mark","Huurdeman, Hugo","Kamps, Jaap","Koolen, Marijn","Skov, Mette","Bogers, Toine","Walsh, David"],"cuid":["S01-000.00-108078"],"event":{"acronym":"CLEF","end":"2016-09-08","place":"Évora, pt","start":"2016-09-05","title":"Conference and Labs of the Evaluation forum","year":"2016"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","OECD"],"country":["Germany","Netherlands","United Kingdom"],"glorg":["All Global Affiliations","Edge Hill University","Humboldt University of Berlin","University of Amsterdam"],"keyword":["Book search","Information retrieval","Interactive IR"],"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"overview of the sbs 000000002016 interactive track","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/281622425/16091024.pdf","version":"Published Version"},"id":"S01-000.00-108078","identifier":[{"id":"85017022594","type":"scopus"}],"ids":["aau-c7f9c9e7-dfae-407e-8531-70fb3fcae9ec"],"keyword":["Interactive IR","book search","information retrieval"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-2-FFDD39F598F404B389C6AF003D175337"],"oa_link":[{"access":"oa","type":"r