Humanities, Department of Communication and Psychology","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Science and Information Studies","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Science, Policy and Information Studies"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Marijn","key":"koolenpau","last":"Koolen","name":"Koolen, Marijn","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jaap","key":"kampspau","last":"Kamps","name":"Kamps, Jaap","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Toine","key":"bogerspau","last":"Bogers","locid":"c39fa087-a00a-425e-9e0f-7fa301dbe554","name":"Bogers, Toine","orcid":"0000-0003-0716-676X","rank":3,"rolecode":"pau"}],"pub":{"issn":["16130073"],"journal":"CEUR Workshop Proceedings","publisher":"CEUR-WS","status":"p","title":"CEUR Workshop Proceedings","volume":"1798"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-338711e0-bffc-42af-a683-00c521b72400"],"src":["AAU Aalborg University"],"title":"Preface","type":"Editorial","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-064996","year":"2017","yearsub":"2017"}
{"abstract":"There is broad consensus in the field of IR that search is complex in many use cases and applications, both on the Web and in domain specific collections, and both professionally and in our daily life. Yet our understanding of complex search tasks, in comparison to simple look up tasks, is fragmented at best. The workshop addresses many open research questions: What are the obvious use cases and applications of complex search? What are essential features of work tasks and search tasks to take into account? And how do these evolve over time? With a multitude of information, varying from introductory to specialized, and from authoritative to speculative or opinionated, when to show what sources of information? How does the information seeking process evolve and what are relevant differences between different stages? With complex task and search process management, blending searching, browsing, and recommendations, and supporting exploratory search to sensemaking and analytics, UI and UX design pose an overconstrained challenge. How do we evaluate and compare approaches? Which measures should be taken into account? Supporting complex search tasks requires new collaborations across the fields of CHI and IR, and the proposed workshop will bring together a diverse group of researchers to work together on one of the greatest challenges of our field.","author_count":6,"contributors":["Koolen, Marijn","Kamps, Jaap","Bogers, Toine","Belkin, Nicholas J.","Kelly, Diane","Yilmaz, Emine"],"cuid":["S01-000.00-096866"],"event":{"end":"2017-03-11","place":"Oslo, no","start":"2017-03-11","title":"Second Workshop on Supporting Complex Search Tasks","year":"2017"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Europe, EU","Europe, Non-EU","OECD"],"country":["Netherlands","United Kingdom","United States"],"glorg":["All Global Affiliations","Royal Netherlands Academy of Arts and Sciences","Rutgers - The State University of New Jersey, New Brunswick","University College London","University of Amsterdam","University of Tennessee, Knoxville"],"keyword":["Information access","Information interaction","Interactive information retrieval","Interfaces","Search Tasks"],"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"current research in supporting complex search tasks","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/268465286/overview.pdf","version":"Published Version"},"id":"S01-000.00-096866","identifier":[{"id":"85019648521","type":"scopus"}],"ids":["aau-a19af2ae-a56b-4d1e-bc9b-b5faf3bb0271"],"keyword":["Information access","Information interaction","Interactive information retrieval","Interfaces","Search processes","Search tasks"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-2-BE04F86A2BA1E108C380C26BBFA1CAF4"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/268465286/overview.pdf","version":"Published Version"},{"access":"oa","type":"rem","url":"http://ceur-ws.org/Vol-1798/overview.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Humanities (HUM)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","country":"nl","key":"royal netherlands academy of arts and sciences","loc":["Netherlands","Europe, EU","OECD"],"name":"Royal Netherlands Academy of Arts and Sciences","used":1},{"affno":"2","country":"nl","key":"university of amsterdam","loc":["Netherlands","Europe, EU","OECD"],"name":"University of Amsterdam","used":1},{"affno":"3","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Humanities","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Science and Information Studies","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Science, Policy and Information Studies"],"nora_code":"DI-U-AAU","used":1},{"affno":"4","country":"us","key":"rutgers the state university of new jersey new brunswick","loc":["United States","America, North","OECD"],"name":"Rutgers - The State University of New Jersey, New Brunswick","used":1},{"affno":"5","country":"us","key":"university of tennessee knoxville","loc":["United States","America, North","OECD"],"name":"University of Tennessee, Knoxville","used":1},{"affno":"6","country":"gb","key":"university college london","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University College London","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Marijn","key":"koolenpau","last":"Koolen","name":"Koolen, Marijn","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jaap","key":"kampspau","last":"Kamps","name":"Kamps, Jaap","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Toine","key":"bogerspau","last":"Bogers","locid":"c39fa087-a00a-425e-9e0f-7fa301dbe554","name":"Bogers, Toine","orcid":"0000-0003-0716-676X","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Nicholas J.","key":"belkinpau","last":"Belkin","name":"Belkin, Nicholas J.","rank":4,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Diane","key":"kellypau","last":"Kelly","name":"Kelly, Diane","rank":5,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Emine","key":"yilmazpau","last":"Yilmaz","name":"Yilmaz, Emine","rank":6,"rolecode":"p