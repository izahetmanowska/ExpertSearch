{"author_count":4,"contributors":["Lamas, David","Buitelaar, Paul","Larsen, Birger","Bogers, Toine"],"cuid":["S01-000.00-066001"],"event":{"end":"2014-11-12","place":"Copenhagen, dk","start":"2014-11-10","title":"7th Information Retrieval Facility Conference, IRFC 2014","year":"2014"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Lamas, David"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"preface","src":["aau"],"src-code":["DI-U-AAU"],"type":"dje","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=84910011418&partnerID=8YFLogxK","version":"Other Version"},"id":"S01-000.00-066001","identifier":[{"id":"84910011418","type":"scopus"}],"ids":["aau-36e64340-8711-468f-8ab1-eed4ebbcbdfc"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-D0316EAADCEE3C98CC9ED2D8A3F66EE8"],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Humanities","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Communication and Information Studies (CIS)"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"","corresponding":null,"first":"David","key":"lamaspau","last":"Lamas","name":"Lamas, David","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Paul","key":"buitelaarpau","last":"Buitelaar","name":"Buitelaar, Paul","rank":2,"rolecode":"p