,"key":"mustopau","last":"Musto","name":"Musto, Cataldo","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Pasquale","key":"lopspau","last":"Lops","name":"Lops, Pasquale","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Giovanni","key":"semeraropau","last":"Semeraro","name":"Semeraro, Giovanni","rank":5,"rolecode":"pau"}],"pub":{"issn":["01635840","15580229"],"issn_org":["01635840"],"issue":"1","journal":"SIGIR Forum","pages":"45-51","publisher":"Association for Computing Machinery (ACM)","status":"p","title":"SIGIR Forum","volume":"51"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-26d96be9-20c8-4c43-ac41-ad08226ef962"],"src":["AAU Aalborg University"],"title":"Report on RecSys 2016 Workshop on New Trends in Content-Based Recommender Systems","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-061322","year":"2017","yearsub":"2017"}
{"abstract":"Recommendation algorithms for ratings prediction and item ranking have steadily matured during the past decade. However, these state-of-the-art algorithms are typically applied in relatively straightforward scenarios. In reality, recommendation is often a more complex problem: it is usually just a single step in the user's more complex background need. These background needs can often place a variety of constraints on which recommendations are interesting to the user and when they are appropriate. However, relatively little research has been done on these complex recommendation scenarios. The ComplexRec 2017 workshop addressed this by providing an interactive venue for discussing approaches to recommendation in complex scenarios that have no simple one-size-fits-all-solution.","author_count":5,"contributors":["Bogers, Toine","Koolen, Marijn","Mobasher, Bamshad","Said, Alan","Tuzhilin, Alexander"],"cuid":["S01-000.00-075539"],"event":{"acronym":"RecSys","end":"2017-08-31","place":"Como, it","start":"2017-08-27","title":"RecSys 2017: 11th ACM Conference on Recommender Systems","year":"2017"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","Europe, EU","Nordic","OECD"],"country":["Netherlands","Sweden","United States"],"glorg":["All Global Affiliations","DePaul University","New York University","University of Amsterdam","University of Skövde"],"keyword":["Complex recommendation"],"level":"pop","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"und","rtype":["clu"],"sorti":"workshop on recommendation in complex scenarios complexrec 000000002017","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/266483257/complexrec2017_overview.pdf","version":"Authors Final 