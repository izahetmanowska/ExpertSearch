d Humanities, Department of Communication and Psychology, Science, Policy and Information Studies"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"de","key":"humboldt university of berlin","loc":["Germany","Europe, EU","OECD"],"name":"Humboldt University of Berlin","used":1},{"affno":"3","country":"ca","key":"university of british columbia","loc":["Canada","America, North","OECD"],"name":"University of British Columbia","used":1},{"affno":"4","country":"de","key":"martin luther university halle wittenberg","loc":["Germany","Europe, EU","OECD"],"name":"Martin Luther University Halle-Wittenberg","used":1},{"affno":"5","country":"nl","key":"royal netherlands academy of arts and sciences","loc":["Netherlands","Europe, EU","OECD"],"name":"Royal Netherlands Academy of Arts and Sciences","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Toine","key":"bogerspau","last":"Bogers","locid":"c39fa087-a00a-425e-9e0f-7fa301dbe554","name":"Bogers, Toine","orcid":"0000-0003-0716-676X","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Maria","key":"gädepau","last":"Gäde","name":"Gäde, Maria","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Luanne","key":"freundpau","last":"Freund","name":"Freund, Luanne","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Mark","key":"hallpau","last":"Hall","name":"Hall, Mark","rank":4,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Marijn","key":"koolenpau","last":"Koolen","name":"Koolen, Marijn","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Vivien","key":"petraspau","last":"Petras","name":"Petras, Vivien","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mette","key":"skovpau","last":"Skov","locid":"1fefa70a-ff67-4c75-8b7a-021837757980","name":"Skov, Mette","orcid":"0000-0002-8821-0314","rank":7,"rolecode":"pau"}],"pub":{"doi":"10.1145/3176349.3176901","eisbn":["9781450349253"],"pages":"382-385","place":"New York","publisher":"Association for Computing Machinery (ACM)","status":"p","title":"CHIIR '18 Proceedings of the 2018 Conference on Human Information Interaction &amp; Retrieval"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-d058c988-8be7-4d69-8593-f0d15a9e12df"],"src":["AAU Aalborg University"],"title":"Workshop on Barriers to Interactive IR Resources Re-use","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-110536","year":"2018","yearsub":"2018"}
{"abstract":"Current-generation recommendation algorithms are often focused on generic ratings prediction and item ranking tasks based on a user’s past preferences. However, many scenarios are more complex with specific criteria and constraints on which items are relevant. This paper focuses on a particular type of complex recommendation needs: Narrative-Driven Recommendation (NDR), where users describe their needs in short narratives, often with one or more example items that fit that need, against a background of historical preferences that may not be spelled out in the narrative, but do play a role in their considerations. We show that such complex needs are common on the Web, yet current-generation systems offer limited to no support for these needs. We focus on narrative-driven book recommendation in the context of LibraryThing (LT) users posting recommendation requests in the discussion forums. We provide an analysis of these needs in terms of their structure, the relevance aspects they cover, and what types of data and algorithms fits these aspects. Subsequently, we propose several new algorithms that take advantage of these narratives and example items as well as hybrid systems, most of which significantly outperform classic collaborative filtering. We show that NDR is indeed a complex scenario that requires further study. Our findings have consequences for system design and development not only in the book domain, but also in other domains where users express focused recommendation needs, such as movies, television, games and music.","author_count":2,"contributors":["Bogers, Toine","Koolen, Marijn"],"cuid":["S01-000.00-116878"],"event":{"end":"2018-11-23","place":"Leiden, nl","start":"2018-11-23","title":"DIR 2018: 17th Dutch-Belgian Information Retrieval Workshop","year":"2018"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Netherlands"],"glorg":["All Global Affiliations","Royal Netherlands Academy of Arts and Sciences"],"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"narrative driven recommendation as complex task","src":["aau"],"src-code":["DI-U-AAU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://arxiv.org/abs/1812.04265","version":"Published Version"},"id":"S01-000.00-116878","ids":["aau-e5e3b451-e873-4c74-ad38-e85ae73064e6"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-BFA9FFF1056553EA42DA49FCAC5CEEC3"],"oa_link":[{"access":"oa","type":"rem","url":"https://arxiv.org/abs/1812.04265","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Humanities","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Science and Information Studies","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Science, Policy and Information Studies"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"nl","key":"royal netherlands academy of arts and sciences","loc":["Netherlands","Europe, EU","OECD"],"name":"Royal Netherlands Academy of Arts and Sciences","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Antonius Marinus","key":"bogerspau","last":"Bogers","locid":"c39fa087-a00a-425e-9e0f-7fa301dbe554","name":"Bogers, Toine","name_org":"Bogers, Antonius Marinus","orcid":"0000-0003-0716-676X","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Marijn","key":"koolenpau","last":"Koolen","name":"Koolen, Marijn","rank":2,"rolecode":"pau"}],"pub":{"pages":"21","status":"p","subtitle":"DIR 2018","title":"Proceedings of the 17th Dutch-Belgian Information Retrieval Workshop"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-e5e3b451-e873-4c74-ad38-e85ae73064e6"],"src":["AAU Aalborg University"],"title":"Narrative-Driven Recommendation as Complex Task","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-116878","year":"2018","yearsub":"2018"}
{"abstract":"Current-generation recommendation algorithms are often focused on generic ratings prediction and item ranking tasks based on a user's past preferences. However, many recommendations are more complex with specific criteria and constraints on which items are relevant. This paper focuses on a particular type of complex recommendation needs: narrative-driven recommendation, where users describe their needs in short narratives, often with one or more example items that fit that need, against a background of historical preferences that may not be spelled out in the narrative, but do play a role in their considerations. Previous work has shown that numerous examples of such complex needs exist on the Web, yet current-generation systems offer limited to no support for these needs. In this paer, we focus on narrative-driven book recommendation in the context of LibraryThing users posting recommendation requests in the discussion forums. We propose several new algorithms that take advantage of these narratives and example items as well as hybrid systems, the majority of which significantly outperform classic collaborative filtering. We show that narrative-driven recommendation is indeed a complex scenario that requires further study. Our findings have consequences for system design and development not only in the book domain, but also in other domains where users express focused recommendation needs, such as movies, television, games, and music.","author_count":2,"contributors":["Bogers, Toine","Koolen, Marijn"],"cuid":["S01-000.00-119381"],"event":{"end":"2018-10-07","place":"Vancouver, ca","start":"2018-10-07","title":"Knowledge-aware and Conversational Recommender Systems Workshop","year":"2018"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Netherlands"],"glorg":["All Global Affiliations","Royal Netherlands Academy of Arts and Sciences"],"keyword":["Book r