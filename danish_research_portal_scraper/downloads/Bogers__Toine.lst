sities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Humanities","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Communication and Information Studies (CIS)"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"David","key":"lamaspau","last":"Lamas","name":"Lamas, David","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Paul","key":"buitelaarpau","last":"Buitelaar","name":"Buitelaar, Paul","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Birger","key":"larsenpau","last":"Larsen","locid":"9cb12135-a825-43ba-87e2-b71651b91939","name":"Larsen, Birger","orcid":"0000-0002-3622-2698","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Toine","key":"bogerspau","last":"Bogers","locid":"c39fa087-a00a-425e-9e0f-7fa301dbe554","name":"Bogers, Toine","orcid":"0000-0003-0716-676X","rank":4,"rolecode":"pau"},{"affno":"","first":"David","key":"lamaspedh","last":"Lamas","name":"Lamas, David","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Paul","key":"buitelaarpedh","last":"Buitelaar","name":"Buitelaar, Paul","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-319-12979-2","eisbn":["9783319129792"],"isbn":["9783319129785"],"issn":["03029743"],"publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","subtitle":"7th Information Retrieval Facility Conference, IRFC 2014, Copenhagen, Denmark, November 10-12, 2014, Proceedings","title":"Multidisciplinary Information Retrieval"},"review":"No Review","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-068cd58e-eebd-40f1-927b-21f7381dfe6f"],"src":["AAU Aalborg University"],"title":"Preface","type":"Book Preface, Encycl. Entry","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-051932","year":"2014","yearsub":"2014"}
{"abstract":"In just a little over half a century, the field of information retrieval has experienced spectacular growth and success, with IR applications such as search engines becoming a billion-dollar industry in the past decades. Recommender systems have seen an even more meteoric rise to success with wide-scale application by companies like Amazon, Facebook, and Netflix. But are search and recommendation really two different fields of research that address different problems with different sets of algorithms in papers published at distinct conferences? In my talk, I want to argue that search and recommendation are more similar than they have been treated in the past decade. By looking more closely at the tasks and problems that search and recommendation try to solve, at the algorithms used to solve these problems and at the way their performance is evaluated, I want to show that there is no clear black and white division between the two. Instead, search and recommendation are part of a much more fluid continuum of methods and techniques for information access.","author_count":1,"contributors":["Bogers, Toine"],"cuid":["S01-000.00-069422"],"event":{"end":"2014-03-04","place":"Berlin, de","start":"2014-03-04","title":"MindTheGap 2014","year":"2014"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"keyword":["Information filtering","Information retrieval","Recommendation","SEARCH"],"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"nr","rtype":["clu"],"sorti":"search and recommendation birds of a feather","src":["aau"],"src-code":["DI-U-AAU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/206427737/abstract.pdf","version":"Authors Final Version"},"id":"S01-000.00-069422","identifier":[{"id":"84921775664","type":"scopus"}],"ids":["aau-42f6bd80-cd53-4290-b2e0-7021d024dee9"],"keyword":["information filtering","information retrieval","recommendation","search"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-23B29CE75EFFA9462179AA3581115B95"],"oa_link":[{"access":"oa","type":"rem","url":"http://ceur-ws.org/Vol-1131/","version":"Other Version"},{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/206427737/abstract.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Humanities","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Communication and Information Studies (CIS)"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Toine","key":"bogerspau","last":"Bogers","locid":"c39fa087-a00a-425e-9e0f-7fa301dbe554","name":"Bogers, Toine","orcid":"0000-0003-0716-676X","rank":1,"rolecode":"pau"}],"pub":{"pages":"5","publisher":"CEUR-WS","status":"p","title":"Proceedings of the MindTheGap 2014 workshop","volume":"1131"},"review":"No Review","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-42f6bd80-cd53-4290-b2e0-7021d024dee9"],"src":["AAU Aalborg University"],"title":"Search and Recommendation : Birds of a Feather?","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-069422","year":"2014","yearsub":"2014"}
{"abstract":"Social news sites allow their users to submit and vote on online news stories, thereby bypassing the authority and power of traditional newspaper editors. In this paper we explore what motivates users of social news sites, such as Reddit, to participate in this collaborative editorial process. We present a tiered framework of motivational factors for participating on social news sites, based on a comprehensive literature review, drawn from fields like social media research, sociology, (social) psychology, and behavioral economics. We then validate this framework through a survey deployed on Reddit and use the results of this survey to focus the motivational framework for the social news domain. We find that the recreational value of the information posted to Reddit, along with the powerful possibilities for customization appear to be the most powerful incentives for using Reddit. Perhaps surprisingly, the social aspect of social news sites is not a motivating factor for the majority of Reddit users. Influencing the placement and reception of news stories in their niche communities of interest is what draws people to sites such as Reddit.","author_count":2,"contributors":["Bogers, Toine","Nordenhoff Wernersen, Rasmus"],"cuid":["S01-000.00-098613"],"event":{"acronym":"iConference","end":"2014-03-07","place":"Berlin, de","start":"2014-03-04","title":"iConference 2014","year":"2014"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Incentives","Motivation","Quantitative analysis","Reddit","Social media","Social news","User participation"],"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["The Administrative Library, Copenhagen, Denmark"],"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"how social are social news sites exploring the motivations for using reddit com","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/206342711/iconf2014_social_news_motivation.camera_ready.pdf","version":"Published Version"},"id":"S01-000.00-098613","ids":["aau-a7751ba3-0d81-473a-9909-d4d1feaac383"],"keyword":["Reddit","incentives","motivation","quantitative analysis","social media","social news","user participation"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-564FB714A3088D99258B516DC6CA2A4C"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.ideals.illinois.edu/handle/2142/47295","version":"Other Version"},{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/206342711/iconf2014_social_news_motivation.camera_ready.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Humanities","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Communication and Information Studies (CIS)"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["The Administrative Library, Copenhagen, Denmark"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Toine","key":"bogerspau","last":"Bogers","locid":"c39fa087-a00a-425e-9e0f-7fa301dbe554","name":"Bogers, Toine","orcid":"0000-0003-0716-676X","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Rasmus","key":"nordenhoffwernersenpau","last":"Nordenhoff Wernersen","name":"Nordenhoff Wernersen, Rasmus","rank":2,"rolecode":"pau"}],"pub":{"pages":"329-344","place":"IDEALS","publisher":"iSchools","status":"p","title":"Proceedings of the iConference 2014"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["aau-a7751ba3-0d81-473a-9909-d4d1feaac383"],"src":["AAU Aalborg University"],"title":"How 'Social' are Social News Sites? Exploring the Motivations for Using Reddit.com","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-098613","year":"2014","yearsub":"2014"}
