ology, Human-centered AI","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Science and Information Studies","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Science, Policy and Information Studies"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"nl","key":"randstad nederland","loc":["Netherlands","Europe, EU","OECD"],"name":"Randstad Nederland","used":1},{"affno":"3","country":"be","key":"ku leuven","loc":["Belgium","Europe, EU","OECD"],"name":"KU Leuven","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Toine","key":"bogerspau","last":"Bogers","locid":"c39fa087-a00a-425e-9e0f-7fa301dbe554","name":"Bogers, Toine","orcid":"0000-0003-0716-676X","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"David","key":"grauspau","last":"Graus","name":"Graus, David","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mesut","key":"kayapau","last":"Kaya","locid":"3fa53166-7b51-4879-9492-255eac2a2793","name":"Kaya, Mesut","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Francisco","key":"gutiérrezpau","last":"Gutiérrez","name":"Gutiérrez, Francisco","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Katrien","key":"verbertpau","last":"Verbert","name":"Verbert, Katrien","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1145/3460231.3470935","eisbn":["9781450384582"],"pages":"799-802","publisher":"Association for Computing Machinery (ACM)","series":"RecSys 2021 - 15th ACM Conference on Recommender Systems","status":"p","title":"RecSys 2021 - 15th ACM Conference on Recommender Systems"},"review":"No Review","scoID":["2-s2.0-85115613759"],"sdg":["8. Decent Work and Economic Growth","All UN SDG Classification"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]