,"noi":["Global-Local-2-4-DCD1843FD41461DD9C7B54D36F485047"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/bmjresp-2022-001268","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://curis.ku.dk/ws/files/314956183/e001268.full.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal medicine: infection medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","first":"Zitta Barrella","key":"harboepau","last":"Harboe","locid":"2b596a33-5659-4236-b5ea-c0991866af44","name":"Harboe, Zitta Barrella","orcid":"0000-0001-5552-0095","rank":1,"rolecode":"pau"},{"affno":"1","first":"Sebastian Rask","key":"hammpau","last":"Hamm","locid":"fda23bba-aa98-4ad7-979d-f28d0045abde","name":"Hamm, Sebastian Rask","rank":2,"rolecode":"pau"},{"affno":"1","first":"Laura","key":"pérezalóspau","last":"Pérez-Alós","locid":"d2298b3a-c2a2-4ee7-9acf-81c70030dc5a","name":"Pérez-Alós, Laura","rank":3,"rolecode":"pau"},{"affno":"2","first":"Pradeesh","key":"sivapalanpau","last":"Sivapalan","n