nk":20,"rolecode":"pau"}],"pmid":["34129731"],"pub":{"doi":"10.1111/apa.15985","issn":["08035253","08035326"],"issn_org":["08035253"],"issue":"9","journal":"Acta Paediatrica","pages":"2581-2583","status":"p","title":"Acta Paediatrica","title_org":"Acta Paediatrica, International Journal of Paediatrics","volume":"110"},"review":"Peer Reviewed","scoID":["2-s2.0-85108859187"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-32adcb52-8fe5-4f79-99af-3e919b1cb549","au-4f29dc2c-d66e-460f-b76b-1ed5a03ae69c","ku-a3435e2d-26ae-447a-a441-e988ca3e4910","sdu-53ce5d01-7857-478b-b694-9e08cb301d62"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Multisystem inflammatory syndrome in children occurred in one of four thousand children with severe acute respiratory syndrome coronavirus 2","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-092.83-002521","year":"2021","yearsub":"2021"}
{"abstract":"BACKGROUND In patients admitted to the hospital owing to suspected acute coronary syndrome and where the first electrocardiogram (ECG) is non-diagnostic of ST-elevated myocardial infarction (STEMI), international guidelines recommend that sequential ECGs are performed to identify new or intermittent ST-deviations. Continued monitoring for ST-segment alterations is rarely performed, in contrast to the continued monitoring for arrhythmias. Continued monitoring for ST-segment alteration may detect intermittent ST-segment elevations not captured by routine 12-lead ECGs. We present a case in which continued ST-segment monitoring revealed intermittent ST-segment elevations and led to expedited coronary angiography and revascularization. CASE REPORT A 66-year-old woman was admitted to a regional hospital in Denmark with intermittent retrosternal chest pain and dyspnea. Her risk profile included a family history of cardiovascular disease, hypercholesterolemia, active smoking, and obesity. The results of 3 sets of high-sensitivity cardiac troponins and sequential 12-lead ECG measurements were normal. Because of clinical suspicion of unstable angina, the patient remained admitted. Continued rhythm and ST-segment monitoring was initiated. During continued ST-segment monitoring, asymptomatic intermittent ST-elevations in the inferior leads were detected. The patient was referred for an acute coronary angiography at the nearest cardiac center. Coronary catheterization showed right coronary artery stenosis, and complete revascularization was obtained by percutaneous coronary intervention with stent implantation. CONCLUSIONS Continued ST-segment monitoring can detect intermittent ST-segment elevations and thereby substantiate the need for acute coronary angiography.","author_count":3,"contributors":["Caap, Philip","Jensen, Jens Christian Herman","Schmidt, Morten"],"cuid":["S01-000.00-191170"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["12 lead electrocardiogram","Acute coronary syndrome","Angina pectoris","EASI","Electrocardiography","Management","Myocardial Infarction","Myocardial Ischemia","Task force"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"a 000000000066 year old woman with intermittent chest pain and dyspnea who underwent continued st segment monitoring to identify occult st segment elevation that expedited coronary angiography and revascularization","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.12659/AJCR.929736","version":"Published Version"},"id":"S01-000.00-191170","identifier":[{"id":"85102715396","type":"scopus"},{"id":"PMC7990123","type":"pmcid"},{"id":"33741889","type":"pmid"},{"id":"000634286800001","type":"wos"}],"ids":["au-6c71d971-2f1a-4dfd-8afe-a38256bb7d00"],"keyword":["12-LEAD ELECTROCARDIOGRAM","Acute coronary syndrome","Angina pectoris","EASI","Electrocardiography","MANAGEMENT","MYOCARDIAL-INFARCTION","Myocardial ischemia","TASK-FORCE"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-33EB4AEA518CA500A55805AB32B8427B"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.12659/AJCR.929736","version":"Published Version"},{"access":"oa","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC7990123/pdf/amjcaserep-22-e929736.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Anaesthesiology and Operation, Intensive care","Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Medicinsk afdeling, RHG"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Philip","key":"caappau","last":"Caap","locid":"b298deda-67b6-4628-8aa1-3a964c67bccb","name":"Caap, Philip","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens Christian Herman","key":"jensenpau","last":"Jensen","locid":"1a03cf09-db27-4e2c-bd05-64019399ec9a","name":"Jensen, Jens Christian Herman","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Morten","key":"schmidtpau","last":"Schmidt","locid":"21e3a3e6-e25e-48cf-b243-b8f43dca3bb8","name":"Schmidt, Morten","orcid":"0000-0002-4935-4059","rank":3,"rolecode":"pau"}],"pmid":["33741889"],"pub":{"doi":"10.12659/ajcr.929736","issn":["19415923"],"journal":"American Journal of Case Reports","paperid":"e929736","publisher":"International Scientific Information, Inc.","status":"p","title":"American Journal of Case Reports","volume":"22"},"review":"Peer Reviewed","scoID":["2-s2.0-85102715396"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-6c71d971-2f1a-4dfd-8afe-a38256bb7d00"],"src":["AU Aarhus University"],"title":"A 66-Year-Old Woman with Intermittent Chest Pain and Dyspnea Who Underwent Continued ST-Segment Monitoring to Identify Occult ST-Segment Elevation that Expedited Coronary Angiography and Revascularization","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-191170","year":"2021","yearsub":"2021"}
{"abstract":"Background: Inhaled nitric oxide (iNO) effectively reduces right ventricular afterload when administered in the immediate phase of acute pulmonary embolism (PE) in preclinical animal models. In a porcine model of intermediate-risk PE, we aimed to investigate whether iNO has pulmonary vasodilator efficacy both in the immediate and prolonged phase of acute PE. Methods: Anesthetized pigs (n = 18) were randomized into three subgroups. An acute PE iNO-group (n = 6) received iNO at 40 ppm at one, three, six, nine and 12 hours after onset of PE. Vehicle animals (n = 6) received PE, but no active treatment. A third group of sham animals (n = 6) received neither PE nor treatment. Animals were evaluated using intravascular pressures, respiratory parameters, biochemistry and intracardiac pressure-volume measurements. Results: The administration of PE increased mean pulmonary artery pressure (mPAP) (vehicle vs sham; 33.3 vs 17.7 mmHg, p < 0.0001), pulmonary vascular resistance (vehicle vs sham; 847.5 vs 82.0 dynes, p < 0.0001) and right ventricular arterial elastance (vehicle vs sham; 1.2 vs 0.2 mmHg/ml, p < 0.0001). Significant mPAP reduction by iNO was preserved at 12 hours after the onset of acute PE (vehicle vs iNO; 0.5 vs-3.5 mmHg, p < 0.0001). However, this response was attenuated over time (p = 0.0313). iNO did not affect the systemic circulation. Conclusions: INO is a safe and effective pulmonary vasodilator both in the immediate and prolonged phase of acute PE in an in-vivo porcine model of intermediate-risk PE.","author_count":6,"contributors":["Kramer, Anders","Mortensen, Christian Schmidt","Schultz, Jacob Gammelgaard","Lyhne, Mads Dam","Andersen, Asger","Nielsen-Kudsk, Jens Erik"],"cuid":["S01-000.00-193280"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Inhaled nitric oxide","Pulmonary embolism","Time","Vasodilation"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"inhaled nitric oxide has pulmonary vasodilator efficacy both in the immediate and prolonged phase of acute pulmonary embolism","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85098087102","version":"Other Version"},"id":"S01-000.00-193280","identifier":[{"id":"33609138","type":"pmid"},{"id":"85098087102","type":"scopus"},{"id":"32662283","type":"pmid"}],"ids":["au-7004f6a5-3cd3-4170-a7ee-bb366bf8b2bd"],"keyword":["Pulmonary embolism","inhaled nitric oxide","time","vasodilation"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-5B8C71124B2CA8C819B7F3298B439579"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Cardiological Medicine B"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Anders","key":"kramerpau","last":"Kramer","locid":"be3123b5-5f55-4c8a-930c-f0f39cbc2981","name":"Kramer, Anders","orcid":"0000-0002-5546-8693","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christian Schmidt","key":"mortensenpau","last":"Mortensen","locid":"e206a965-77bd-46fd-b3d4-5cd99f2d6b7c","name":"Mortensen, Christian Schmidt","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jacob Gammelgaard","key":"schultzpau","last":"Schultz","locid":"9825d55c-97ee-4bab-a003-801dcd6d6df8","name":"Schultz, Jacob Gammelgaard","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mads Dam","key":"lyhnepau","last":"Lyhne","locid":"2bc2ac75-93d9-4c4c-b3cc-c6e80f5c7325","name":"Lyhne, Mads Dam","orcid":"0000-0001-5279-260X","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Asger","key":"andersenpau","last":"Andersen","locid":"a87aec57-562e-4950-b4cf-6741aae86cf1","name":"Andersen, Asger","orcid":"0000-0002-9102-3130","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens Erik","key":"nielsenkudskpau","last":"Nielsen-Kudsk","locid":"8629b763-e23e-41d9-ac4f-61579d19565e","name":"Nielsen-Kudsk, Jens Erik","rank":6,"rolecode":"pau"}],"pmid":["32662283","33609138"],"pub":{"doi":"10.1177/2048872620918713","issn":["20488726","20488734"],"issn_org":["20488726"],"issue":"3","journal":"European Heart Journal: Acute Cardiovascular Care","pages":"265-272","publisher":"Oxford University Press","status":"p","title":"European Heart Journal: Acute Cardiovascular Care","volume":"10"},"review":"Peer Reviewed","scoID":["2-s2.0-85098087102"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-7004f6a5-3cd3-4170-a7ee-bb366bf8b2bd"],"src":["AU Aarhus University"],"title":"Inhaled nitric oxide has pulmonary vasodilator efficacy both in the immediate and prolonged phase of acute pulmonary embolism","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-193280","year":"2021","yearsub":"2021"}
{"abstract":"Aims To evaluate factors influencing the length of stay in patients undergoing percutaneous left atrial appendage occlusion (LAAO). Methods and results Patient characteristics, procedural data and the occurrence of serious adverse events were analyzed from the AmplatzerTM AmuletTM Occluder Observational Study. Patients were divided into three groups: same day (S, 0day, n = 60, 5.6%) early (E, 1day, n = 526, 48.9%), regular (R, 2-3days, n = 338, 31.4%) and late (L, ≥4days, n = 152, 14.1%) discharge and followed up for 60 days. Procedure and device related SAE during the in-hospital stay (S: 0.0% vs. E: 1.0% vs. R: 2.1% vs. L: 23%, p<0.0001) were a major trigger for a prolonged in-hospital stay. Of the 37 subjects in the late discharge group with an SAE prior to discharge, cardiac or bleeding complications were the most common underlying conditions, occurring in 26 subjects. Multinomial logistic analysis only identified HAS-BLED score as an independent influencing factor (p = 0.04) for a late discharge. After 60 days, mortality tended to be greatest in the late discharge group (S: 0.0% vs. E: 1.0% vs. R: 1.2% vs. L: 3.3%, p = 0.1066). Conclusion Over half of the subjects receiving an Amplatzer Amulet occluder were discharged within 1 day of the implant procedure. Serious adverse events were a major trigger for a late discharge after LAAO. Increased HAS-BLED score was associated with a prolonged in-hospital stay.","author_count":13,"contributors":["Piayda, Kerstin","Afzal, Shazia","Nielsen-Kudsk, Jens Erik","Schmidt, Boris","Mazzone, Patrizio","Berti, Sergio","Fischer, Sven","Lund, Juha","Montorfano, Matteo","Hildick-Smith, David","Gage, Ryan","Zhao, Hong","Zeus, Tobias"],"cuid":["S01-000.00-266608"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Europe, EU","Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Zeus, Tobias"],"country":["Finland","Germany","Italy","United Kingdom","United States"],"glorg":["Abbott Laboratories","All Global Affiliations","Gabriele Monasterio Foundation","Harzklinikum Dorothea Christiane Erxleben GmbH","Heinrich Heine University Düsseldorf","Markus-Krankenhaus Frankfurt","University of Sussex","University of Turku","Vita-Salute San Raffaele University"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"length of stay following percutaneous left atrial appendage occlusion data from the prospective multicenter amplatzer amulet occluder observational study","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pone.0255721","version":"Published Version"},"id":"S01-000.00-266608","identifier":[{"id":"34375347","type":"pmid"},{"id":"PMC8354446","type":"pmcid"},{"id":"85112326822","type":"scopus"}],"ids":["au-f08a19e7-b11d-4307-a170-642f1de79114"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-A376E859F16DD72B28D9EF5F14A60456"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pone.0255721","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"de","key":"heinrich heine university düsseldorf","loc":["Germany","Europe, EU","OECD"],"name":"Heinrich Heine University Düsseldorf","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Cardiological Medicine B"],"nora_code":"DI-U-AU","used":1},{"affno":"3","country":"de","key":"markus krankenhaus frankfurt","loc":["Germany","Europe, EU","OECD"],"name":"Markus-Krankenhaus Frankfurt","used":1},{"affno":"4","country":"it","key":"vita salute san raffaele university","loc":["Italy","Europe, EU","OECD"],"name":"Vita-Salute San Raffaele University","used":1},{"affno":"5","country":"it","key":"gabriele monasterio foundation","loc":["Italy","Europe, EU","OECD"],"name":"Gabriele Monasterio Foundation","used":1},{"affno":"6","country":"de","key":"harzklinikum dorothea christiane erxleben gmbh","loc":["Germany","Europe, EU","OECD"],"name":"Harzklinikum Dorothea Christiane Erxleben GmbH","used":1},{"affno":"7","country":"fi","key":"university of turku","loc":["Finland","Europe, EU","Nordic","OECD"],"name":"University of Turku","used":1},{"affno":"8","country":"gb","key":"university of sussex","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Sussex","used":1},{"affno":"9","country":"us","key":"abbott laboratories","loc":["United States","America, North","OECD"],"name":"Abbott Laboratories","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Kerstin","key":"piaydapau","last":"Piayda","name":"Piayda, Kerstin","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Shazia","key":"afzalpau","last":"Afzal","name":"Afzal, Shazia","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jens Erik","key":"nielsenkudskpau","last":"Nielsen-Kudsk","locid":"8629b763-e23e-41d9-ac4f-61579d19565e","name":"Nielsen-Kudsk, Jens Erik","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Boris","key":"schmidtpau","last":"Schmidt","name":"Schmidt, Boris","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Patrizio","key":"mazzonepau","last":"Mazzone","name":"Mazzone, Patrizio","rank":5,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Sergio","key":"bertipau","last":"Berti","name":"