rsity of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"4","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Oto Rhino Laryngology (Odense)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Shno","key":"koiekpau","last":"Koiek","name":"Koiek, Shno","rank":1,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Jens Bo","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Jens Bo","rank":2,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Christian","key":"brandtpau","last":"Brandt","locid":"56b163ed-e27f-4e13-a788-cf338713f137","name":"Brandt, Christian","orcid":"0000-0003-0672-9487","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Jesper Hvass","key":"schmidtpau","last":"Schmidt","locid":"db84fc4e-28da-45af-a608-13ce8f4ec719","name":"Schmidt, Jesper Hvass","orcid":"0000-0001-7683-1407","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Tobias","key":"neherpau","last":"Neher","locid":"64d1ab37-25d0-4a4b-94d9-59d868d830db","name":"Neher, Tobias","orcid":"0000-0002-1107-9274","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Technical University of Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-a08037dc-55e0-4714-bc90-5298432ca1d9"],"src":["SDU University of Southern Denmark"],"title":"Characterizing the binaural hearing abilities of school-age children with a history of middle-ear-diseases.","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-691248","year":"2019","yearsub":"2019"}
{"abstract":"Dark fermentation, also known as acidogenesis, involves the transformation of a wide range of organic substrates into a mixture of products, e.g., acetic acid, butyric acid, and hydrogen. This bioprocess occurs in the absence of oxygen and light. The ability to synthesize hydrogen, by dark fermentation, has raised its scientific attention. Hydrogen is a nonpolluting energy carrier molecule. However, for energy generation, there are a variety of other sustainable, and less expensive, alternatives to biohydrogen energy, e.g., solar, wind, tide, hydroelectric, biomass incineration, or nuclear fission. Nevertheless, dark fermentation appears as an important sustainable process in another area: the synthesis of valuable chemicals, i.e., an alternative to petrochemical refinery. Currently, acetic acid, butyric acid, and hydrogen are mostly produced by petrochemical reforming, and they serve as precursors of ubiquitous petrochemical-derived products. Hence, the future of dark fermentation relies as a core bioprocess in the biorefinery concept. The present article aims to present and discuss the current and future status of dark fermentation in the biorefinery concept. The first half of the article presents the metabolic pathways, product yields and its technological importance, microorganisms responsible for mixed dark fermentation, and operational parameters, e.g., substrates, pH, temperature, and headspace composition, which affect dark fermentation. The minimal selling price of dark fermentation products is also presented in this section. The second half discusses the perspectives and future of dark fermentation as a core bioprocess. The relationship of dark fermentation with other (bio)processes, e.g., liquid fuels and fine chemicals, algae cultivation, biomethane-biohythane-biosyngas production, and syngas fermentation, is then explored.","author_count":6,"contributors":["Bastidas-Oyanedel, Juan-Rodrigo","Bonk, Fabian","Thomsen, Mette Hedegaard","Schmidt, Jens Ejbye"],"cuid":["S02-083.33-009045"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Asia, Middle East","Europe, EU","OECD"],"corresponding_author":["Bastidas Oyanedel, Juan-Rodrigo"],"country":["Germany","United Arab Emirates"],"glorg":["All Global Affiliations","Helmholtz Centre for Environmental Research – UFZ","Khalifa University","Khalifa University of Science and Technology","UFZ-Helmholtz Centre for Environmental Research Leipzig"],"keyword":["Acidogenesis","Biohydrogen","Bioprocesses","Biorefinery","Dark fermentation","Economics","Revenues"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-AAU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"the future perspectives of dark fermentation moving from only biohydrogen to biochemicals","src":["aau","sdu"],"src-code":["DI-U-AAU","DI-U-SDU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-3-030-10961-5_15","version":"Published Version"},"id":"S02-083.33-009045","identifier":[{"id":"85134997005","type":"scopus"}],"ids":["aau-bb80f020-d2ac-419c-b354-2b4d129bba04","sdu-ce4d66d3-0683-4f58-a6e9-7364bfe14bbc"],"keyword":["Acidogenesis","Biohydrogen","Bioprocesses","Biorefinery","Dark fermentation","Economics","Revenues"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-EAC69EA401DA392D414D174DB8BC3EE0"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-3-030-10961-5_15","version":"Published Version"}],"org":[{"affno":"1","country":"ae","key":"khalifa university of science and technology","loc":["United Arab Emirates","Asia, Middle East"],"name":"Khalifa University of Science and Technology","used":1},{"affno":"2","country":"ae","key":"khalifa university","loc":["United Arab Emirates","Asia, Middle East"],"name":"Khalifa University","used":1},{"affno":"3","country":"de","key":"ufz helmholtz centre for environmental research leipzig","loc":["Germany","Europe, EU","OECD"],"name":"UFZ-Helmholtz Centre for Environmental Research Leipzig","used":1},{"affno":"4","country":"de","key":"helmholtz centre for environmental research ufz","loc":["Germany","Europe, EU","OECD"],"name":"Helmholtz Centre for Environmental Research – UFZ","used":1},{"affno":"5","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, AAU Energy","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Esbjerg Energy Section"],"nora_code":"DI-U-AAU","used":1},{"affno":"6","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Engineering, Department of Green Technology (IGT)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Juan-Rodrigo","key":"bastidasoyanedelpau","last":"Bastidas-Oyanedel","name":"Bastidas-Oyanedel, Juan-Rodrigo","rank":1,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Fabian","key":"bonkpau","last":"Bonk","name":"Bonk, Fabian","rank":2,"rolecode":"pau"},{"affno":"5","corresponding":null,"country":"dk","first":"Mette Hedegaard","key":"thomsenpau","last":"Thomsen","locid":"29912cd6-8a9e-4022-b66a-6fb13430130a","name":"Thomsen, Mette Hedegaard","orcid":"0000-0001-6805-7247","rank":3,"rolecode":"pau"},{"affno":"5 6","corresponding":null,"country":"dk",