key":"mollerpau","last":"Moller","locid":"5e4d3cb6-b0a0-4541-aea1-30e73f7c10b8","name":"Møller, Jacob Eifer","name_org":"Moller, Jacob Eifer","orcid":"0000-0003-2873-5845","rank":14,"rolecode":"pau"}],"pmid":["38782543"],"pub":{"doi":"10.1136/openhrt-2023-002512","issn":["20533624","2398595X"],"issn_org":["2398595X"],"issue":"1","journal":"Open Heart","paperid":"e002512","publisher":"BMJ","status":"p","title":"Open Heart","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-85195036305"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-c49e3ce8-e862-478b-9a64-f707bfb9ade6"],"src":["SDU University of Southern Denmark"],"title":"Association between speckle tracking echocardiography and pressure-volume loops during cardiogenic shock development","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-750924","year":"2024","yearsub":"2024"}
{"abstract":"Acute pulmonary embolism (PE) is a potentially life-threatening condition that causes abrupt obstruction of the pulmonary arteries, leading to acute right heart failure. Novel diagnostic methods and catheter-directed therapies are being developed rapidly, and there is an obvious need for a realistic PE animal model that can be used for pathophysiological evaluation and preclinical testing. This protocol introduces a porcine model employing large autologous pulmonary emboli. Instrumentations are performed with minimally invasive techniques, creating a close-chest model that enables the investigation of various treatment options with high reproducibility. Three hours after drawing blood to create autologous emboli ex vivo, the induction of PE caused an immediate increase in the mean pulmonary arterial pressure (17 ± 3 mmHg to 33 ± 6 mmHg, p < 0.0001) and heart rate (50 ± 9 beats·min-1 to 63 ± 6 beats·min-1, p < 0.0003) accompanied by a decreased cardiac output (5.0 ± 0.8 L/min to 4.5 ± 0.9 L/min, p < 0.037) compared to baseline. The CT pulmonary angiography revealed multiple emboli, and the pulmonary obstruction percentage was increased compared to baseline (0% [0-0] to 57.1% [38.8-63.3], p < 0.0001). In the acute phase, the phenotype is comparable to intermediate-risk PE. The model represents a realistic and well-characterized phenotype of intermediate-risk PE and creates an opportunity to test novel diagnostic methods, interventional and pharmaceutical treatments, and hands-on training for healthcare workers in interventional procedures.","author_count":11,"contributors":["Dragsbaek, Simone Juel","Hansen, Jacob Valentin","Merit, Victor Tang","Lyhne, Mads Dam","Kirk, Mathilde Emilie","Kramer, Anders","Poulsen, Mette Wørmer","Mortensen, Christian Schmidt","Nielsen-Kudsk, Jens Erik","Andersen, Asger","Schultz, Jacob Gammelgaard"],"cuid":["S01-000.00-763561"],"filters":{"added":"2024-11","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"a porcine model of acute autologous pulmonary embolism","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85204756719","version":"Other Version"},"id":"S01-000.00-763561","identifier":[{"id":"85204756719","type":"scopus"},{"id":"39311571","type":"pmid"}],"ids":["au-c26fd5e0-4ca5-4db3-a981-cb17d075da85"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-83A3EBB46F282F15CAEB3238AD04A979"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Cardiological Medicine B"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Simone Juel","key":"dragsbaekpau","last":"Dragsbaek","locid":"9c395385-9047-41cb-9a96-a1cdc538fdcf","name":"Dragsbaek, Simone Juel","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jacob Valentin","key":"hansenpau","last":"Hansen","locid":"31e33719-b4f4-428d-8342-33c42a4c78c2","name":"Hansen, Jacob Valentin","orcid":"0000-0002-7017-575X","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Victor Tang","key":"meritpau","last":"Merit","locid":"833d7bef-e03e-487e-95bd-bb0acc2a2bd0","name":"Merit, Victor Tang","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mads Dam","key":"lyhnepau","last":"Lyhne","locid":"2bc2ac75-93d9-4c4c-b3cc-c6e80f5c7325","name":"Lyhne, Mads Dam","orcid":"0000-0001-5279-260X","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mathilde Emilie","key":"kirkpau","last":"Kirk","locid":"98d2736a-c80e-48cd-b4ae-593424040fdc","name":"Kirk, Mathilde Emilie","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anders Dahl","key":"kramerpau","last":"Kramer","locid":"be3123b5-5f55-4c8a-930c-f0f39cbc2981","name":"Kramer, Anders","name_org":"Kramer, Anders Dahl","orcid":"0000-0002-5546-8693","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mette Wørmer","key":"poulsenpau","last":"Poulsen","locid":"399ca143-b3ab-4fea-b78e-6ec1bf588a9e","name":"Poulsen, Mette Wørmer","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christian Schmidt","key":"mortensenpau","last":"Mortensen","locid":"e206a965-77bd-46fd-b3d4-5cd99f2d6b7c","name":"Mortensen, Christian Schmidt","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens Erik","key":"nielsenkudskpau","last":"Nielsen-Kudsk","locid":"8629b763-e23e-41d9-ac4f-61579d19565e","name":"Nielsen-Kudsk, Jens Erik","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Asger","key":"andersenpau","last":"Andersen","locid":"a87aec57-562e-4950-b4cf-6741aae86cf1","name":"Andersen, Asger","orcid":"0000-0002-9102-3130","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jacob Gammelgaard","key":"schultzpau","last":"Schultz","locid":"9825d55c-97ee-4bab-a003-801dcd6d6df8","name":"Schultz, Jacob Gammelgaard","rank":11,"rolecode":"pau"}],"pmid":["39311571"],"pub":{"doi":"10.3791/67177","issn":["1940087X"],"issue":"211","journal":"Journal of Visualized Experiments","paperid":"e67177","publisher":"MyJoVE Corporation","status":"p","title":"Journal of Visualized Experiments","volume":"2024"},"review":"Peer Reviewed","scoID":["2-s2.0-85204756719"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-c26fd5e0-4ca5-4db3-a981-cb17d075da85"],"src":["AU Aarhus University"],"title":"A Porcine Model of Acute Autologous Pulmonary Embolism","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-763561","year":"2024","yearsub":"2024"}
{"abstract":"PURPOSE: Both vestibular neuronitis (VN) and Meniere's disease (MD) have great impact on quality of life and are associated with a significant number of sick leave days absent from work. The aim was to assess labor market participation rate one year after hospital diagnosis of VN and MD and the use of rehabilitation measures. STUDY DESIGN: Nationwide register-based cohort study including patients with VN (n = 1,341) and MD (n = 843) and control persons matched in 1:5 with a VN cohort control (n = 6,683) and MD cohort control (n = 4,209). RESULTS: Compared to control persons, VN patients were more likely to be single, have higher income, and a higher Charlson comorbidity index score. MD patients had a higher level of education and a higher Charlson index compared to control persons. One year after patients were diagnosed with VN, no significant difference in labor market participation was observed (p = 0.88). However, MD patients had a 10.4% reduced probability of possessing a full-time job one year after diagnosis compared to matched control persons (58.1 ± 0.5% vs. 68.5 ± 0.5%, p < 0.001). Both VN and MD patients consulted otorhinolaryngologists, general practitioners, and physiotherapists more than control persons both before and after the initial diagnosis (p < 0.01). In addition, MD patients also consulted psychologists more frequently before and after diagnosis of the disease (p < 0.01). CONCLUSION: Intrahospital diagnosed MD increases the risk of leaving the labor market in opposition to VN. Both MD and VN are associated with significant expenses to the Danish health care system from the use of public rehabilitation measures and medical consultations.","author_count":6,"contributors":["Tønnesen, Emil Severin","Nielsen, Jesper Bo","Rose Olsen, Kim","Wanscher, Jens Højberg","Schmidt, Jesper Hvass","Sørensen, Jesper Roed"],"cuid":["S01-000.00-783391"],"filters":{"added":"2025-01","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Sørensen, Jesper Roed"],"keyword":["Adult","Aged","Case Control Studies","Cohort Studies","Denmark","Dizziness","Employment statistics numerical data","Female","Humans","Labor market","Male","Meniere s disease","Middle Aged","Quality of Life","Register based","Registries","Rehabilitation","Sick Leave statistics numerical data","Vestibular Neuronitis"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-SDR","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"labor market effects of rehabilitation for patients diagnosed with dizziness a danish nationwide register based cohort study","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s00405-024-08871-y","version":"Published Version"},"id":"S01-000.00-783391","identifier":[{"id":"85200422978","type":"scopus"},{"id":"PMC11564300","type":"pmcid"},{"id":"39098958","type":"pmid"}],"ids":["sdu-889456b8-bf92-4c0e-bcc6-cb387361118d"],"keyword":["Adult","Aged","Case-Control Studies","Cohort Studies","Denmark","Dizziness","Dizziness/rehabilitation","Employment/statistics & numerical data","Female","Humans","Labor market","Male","Meniere Disease/rehabilitation","Meniere’s disease","Middle Aged","Quality of Life","Registerø-based","Registries","Rehabilitation","Sick Leave/statistics & numerical data","Vestibular Neuronitis/rehabilitation","Vestibular neuronitis"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-87398221D9B6E7BDBD4C191A33C62B9C"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s00405-024-08871-y","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/277567217/s00405-024-08871-y.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Public Health","SDU, The Faculty of Health Sciences, Department of Public Health, Research Unit of General Pratice"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Emil Severin","key":"tønnesenpau","last":"Tønnesen","name":"Tønnesen, Emil Severin","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jesper Bo","key":"nielsenpau","last":"Nielsen","locid":"75938cc2-43d6-4c8d-a506-6b1c0472a382","name":"Nielsen, Jesper Bo","orcid":"0000-0002-5764-5462","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kim","key":"rosepau","last":"Rose","locid":"529d9463-bb6c-4c8a-9114-eb7c45358642","name":"Rose Olsen, Kim","name_org":"Rose, Kim","orcid":"0000-0002-0473-4736","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jens Højberg","key":"wanscherpau","last":"Wanscher","locid":"33130a0a-a7b5-4e60-b090-5a6e43f3396a","name":"Wanscher, Jens Højberg","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jesper Hvass","key":"schmidtpau","last":"Schmidt","locid":"db84fc4e-28da-45af-a608-13ce8f4ec719","name":"Schmidt, Jesper Hvass","orcid":"0000-0001-7683-1407","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jesper Roed","k