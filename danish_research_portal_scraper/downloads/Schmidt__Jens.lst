iversities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-6101342b-fc83-47a0-8aeb-8d2ea36c4775"],"src":["AU Aarhus University"],"title":"ThingShare : Ad-Hoc Digital Copies of Physical Objects for Sharing Things in Video Meetings","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-184718","year":"2023","yearsub":"2023"}
{"abstract":"Formålet med denne publikation er at fremlægge en række anbefalinger til, hvordan man kan fremme et Danmark med mere fysisk bevægelse. Det er en central vision for Danmark i Bevægelse, at resultaterne omsættes til handling i form af politikker, strategier og aktiviteter i kommuner og organisationer. Anbefalingerne er først og fremmest udledt af de mange resultater fra de forskellige undersøgelser i Danmark i Bevægelse. Anbefalingerne er imidlertid også inspireret af anden forskning, samt af erfaringer og ideer fra møder med kommuner og organisationer, hvor resultaterne fra Danmark i Bevægelse er fremlagt. Endelig har brugerfølgegruppen i Danmark i Bevægelse, som bestod af repræsentanter fra kommuner, organisationer og offentlige myndigheder, også bidraget til at nuancere og kvalificere anbefalingerne. For hver anbefaling redegøres der for de resultater fra Danmark i Bevægelse, som anbefalingen bygger på. Rapporten omfatter 11 anbefalinger.","author_count":8,"contributors":["Ibsen, Bjarne","Høyer-Kruse, Jens","Elmose-Østerlund, Karsten","Christiansen, Lars Breum","Bredahl, Thomas Viskum Gjelstrup","Dalgas, Birgitte Westerskov","Engell, Zakarias","Schmidt, Eva Berthelsen"],"cuid":["S01-000.00-623224"],"filters":{"added":"2023-04","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Ibsen, Bjarne"],"keyword":["Anbefalinger"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"nr","rtype":["clu"],"sorti":"hvordan fremmer vi voksnes fysiske bevægelse anbefalinger fra danmark i bevægelse","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/222474163/anbefalinger_fra_danmark_i_bevaegelse_.pdf","version":"Published Version"},"id":"S01-000.00-623224","ids":["sdu-ae9e1ab9-a1af-40d2-8207-78c1102eb886"],"keyword":["Anbefalinger","Danmark i Bevægelse","voksnes fysiske bevægelse"],"lang":"Danish","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-78C79A9FB19A92CF0ECF7A3604C3CAD5"],"oa_link":[{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/222474163/anbefalinger_fra_danmark_i_bevaegelse_.pdf","version":"Published Version"},{"access":"oa","type":"rem","url":"https://www.sdu.dk/da/forskning/danmark_i_bevaegelse/publikationer","version":"Published Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics, Centre for Sports, Health and Civil Society","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics, Research Unit of Active Living"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Bjarne","key":"ibsenpau","last":"Ibsen","locid":"f75f735a-cd43-46c6-93ab-e5ec963bca43","name":"Ibsen, Bjarne","orcid":"0000-0003-4326-4252","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens","key":"høyerkrusepau","last":"Høyer-Kruse","locid":"5e059f63-1830-43ac-a9a2-7c0233032d2a","name":"Høyer-Kruse, Jens","orcid":"0000-0002-0150-613X","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Karsten","key":"elmoseøsterlundpau","last":"Elmose-Østerlund","locid":"21e04e19-3e2d-4803-afb0-05afa8a16c93","name":"Elmose-Østerlund, Karsten","orcid":"0000-0002-9335-5585","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars Bre