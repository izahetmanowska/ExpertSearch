University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Ophthalmology"],"nora_code":"DI-U-AAU","used":1},{"affno":"10","country":"dk","key":"north denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-NDR","l3nl":"North Denmark Region","l3nn":"North Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"North Denmark Region","namevar":["Aalborg University Hospital"],"nora_code":"DI-HO-NDR","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jakob","key":"grauslundpau","last":"Grauslund","locid":"72447336-2d4c-44a2-b4a5-f99df775a980","name":"Grauslund, Jakob","orcid":"0000-0001-5019-0736","rank":1,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Nis","key":"andersenpau","last":"Andersen","name":"Andersen, Nis","rank":2,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Jens","key":"andresenpau","last":"Andresen","name":"Andresen, Jens","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Toke","key":"bekpau","last":"Bek","name":"Bek, Toke","rank":4,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Sara","key":"brandipau","last":"Brandi","name":"Brandi, Sara","rank":5,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Javad","key":"hajaripau","last":"Hajari","name":"Hajari, Javad","rank":6,"rolecode":"pau"},{"affno":"6 4","corresponding":null,"first":"Søren Tang","key":"knudsenpau","last":"Knudsen","name":"Knudsen, Søren Tang","rank":7,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Caroline Schmidt","key":"laugesenpau","last":"Laugesen","name":"Laugesen, Caroline Schmidt","rank":8,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Caroline","key":"schmidtlaugesenpau","last":"Schmidt Laugesen","name":"Schmidt Laugesen, Caroline","rank":8,"rolecode":"pau"},{"affn