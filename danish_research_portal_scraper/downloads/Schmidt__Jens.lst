pau","last":"Kolko","locid":"424f93ba-9964-4960-bd22-d30bdb0fb45f","name":"Kolko, Miriam","orcid":"0000-0001-8697-0734","rank":15,"rolecode":"pau"},{"affno":"11 12","corresponding":null,"first":"Katja Christina","key":"schielkepau","last":"Schielke","locid":"060067d2-7693-4ac9-9977-d4a06bfe24a9","name":"Schielke, Katja Christina","rank":16,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Katrine Hass","key":"rubinpau","last":"Rubin","locid":"90ded8f7-7d96-472a-8305-1bdb7bf0d345","name":"Rubin, Katrine Hass","orcid":"0000-0001-5045-536X","rank":17,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders Højslet","key":"vestergaardpau","last":"Vestergaard","locid":"aea6d7ae-1e29-4ade-8d02-a4d5e689e5c3","name":"Vestergaard, Anders Højslet","orcid":"0000-0003-1687-4899","rank":18,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jakob","key":"grauslundpau","last":"Grauslund","locid":"72447336-2d4c-44a2-b4a5-f99df775a980","name":"Grauslund, Jakob","orcid":"0000-0001-5019-0736","rank":19,"rolecode":"pau"}],"pmid":["36514165"],"pub":{"doi":"10.1111/aos.15300","issn":["1755375X","17553768"],"issn_org":["1755375X"],"issue":"4","journal":"Acta Ophthalmologica","pages":"384-391","publisher":"Wiley","status":"p","title":"Acta Ophthalmologica","title_org":"Acta Ophthamologica","volume":"101"},"review":"Peer Reviewed","scoID":["2-s2.0-85144128949"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","North Denmark Region","Other Hospitals","Other Research","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark","organization of danish ophthalmologists"],"PST":["Published"]},"sid":["aau-3f82727b-34ec-4aa8-98a5-45318a09dcd1","ku-8e4f2cb1-e2cc-4e5a-a964-250f8b45f1f6","sdu-3e00e62a-660a-4fe4-ae73-a959a0688c0a"],"src":["AAU Aalborg University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Bidirectional 5-year risks of diabetic retinopathy, glaucoma and/or ocular hypertension : Results from a national screening programme","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-094.14-672292","year":"2023","yearsub":"2023"}
{"abstract":"Purpose: The Danish Registry of Diabetic Retinopathy includes information from >200 000 patients who attends diabetic retinopathy (DR) screening in Denmark. Screening of patients with uncomplicated type 2 diabetes is often performed by practicing ophthalmologists, while patients with type 1 and complicated type 2 diabetes attends screening at hospitals. We performed a clinical reliability study of retinal images from Danish screening facilities to explore the inter-grader agreement between the primary screening ophthalmologist and a blinded, certified grader. Methods: Invitations to participate were sent to screening facilities across Denmark. The primary grader uploaded fundus photographs with information on estimated level of DR (International Clinical Diabetic Retinopathy scale as 0 [no DR], 1–3 [mild, moderate or severe nonproliferative DR {NPDR}], or 4 [proliferative DR {PDR}]), region of screening, image style, and screening facility. Images were then regraded by a blinded, certified, secondary grader. Weighted kappa analysis was performed to evaluate agreement. Results: Fundus photographs from 230 patients (458 eyes) were received from practicing ophthalmologists (52.6%) and hospital-based grading centres (47.4%) from all Danish regions. Reported levels of DR by the primary graders were 66.8%, 12.2%, 13.1%, 1.3% and 5.5% for DR levels 0–4. The overall agreement between primary and secondary graders was 93% (κ = 0.83). Based on screening facility agreement was 96% (κ = 0.89) and 90% (κ = 0.76) for practicing ophthalmologists and hospital-based graders. Conclusion: In this nationwide study, we observed a high overall inter-grader agreement and based on this, it is reasonable to assume that reported DR gradings in the screening programme in Denmark, accurately reflect the truth.","author_count":16,"contributors":["Thykjær, Anne Suhr","Andresen, Jens","Andersen, Nis","Bek, Toke","Heegaard, Steffen","Hajari, Javad","Schmidt Laugesen, Caroline","Möller, Sören","Pedersen, Frederik Nørregaard","Kawasaki, Ryo","Højlund, Kurt","Rubin, Katrine Hass","Stokholm, Lonny","Peto, Tunde","Grauslund, Jakob"],"cuid":["S03-099.17-715887"],"filters":{"added":"2023-06","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"continent":["Asia, East","Europe, Non-EU","OECD"],"corresponding_author":["Suhr Thykjær, Anne","Thykjær, Anne Suhr"],"country":["Japan","United Kingdom"],"glorg":["All Global Affiliations","Osaka University","Queen's University Belfast","University of Osaka"],"keyword":["Denmark epidemiology","Diabetes Mellitus Type 2 complications","Diabetic Retinopathy diagnosis","Diabetic retinopathy","Humans","Interrater agreement","Mass Screening methods","Photography methods","Reliability","Reproducibility of Results","Screening"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-OTH","DI-HO-ZEA"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-OTH","DI-HO-ZEA","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"inter grader reliability in the danish screening programme for diabetic retinopathy","src":["au","ku","sdu"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1111/aos.15667","version":"Published Version"},"id":"S03-099.17-715887","identifier":[{"id":"37066883","type":"pmid"},{"id":"85153227524","type":"scopus"}],"ids":["au-1df8b825-7d5d-447c-b8f6-f707b6b77db3","ku-8f578f59-f49f-41b2-9c6a-e09dbaf3a3eb","sdu-36e638ee-1efe-4397-8b45-efe4d13e4367"],"keyword":["Denmark/epidemiology","Diabetes Mellitus, Type 2/complications","Diabetic Retinopathy/diagnosis","Humans","Mass Screening/methods","Photography/methods","Reproducibility of Results","diabetic retinopathy","interrater a