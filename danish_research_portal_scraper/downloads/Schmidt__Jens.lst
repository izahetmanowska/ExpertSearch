","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-77941f01-cba3-400e-82f7-23d1b234805b"],"src":["AU Aarhus University"],"title":"Major Adverse Cardiac Events Associated With Discontinuation Of Clopidogrel Treatment Within The First Year After Coronary Stent Implantation In Western Denmark. J Am Coll Cardiol. 2012;60(17_S)","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-197727","year":"2012","yearsub":"2012"}
{"abstract":"BACKGROUND: Deep brain stimulation (DBS) in the ventral tuberal hypothalamus (VTH) is currently under investigation for the treatment of severe obesity. Stimulation impact on a number of closely related hypothalamic neural systems could potentially influence normal hypothalamic function and thereby generate adverse side effects. OBJECTIVE: To assess the feasibility and safety of VTH DBS in a non-primate large animal model. METHODS: In the VTH of 6 Göttingen minipigs, quadropolar leads were implanted bilaterally (n = 2) or unilaterally (n = 4), using optimized MRI sequences allowing identification of major diencephalic landmarks. Heart rate, weight, behavior and nighttime locomotor activity were recorded throughout the study period. Two of the unilaterally implanted minipigs were examined with [15O]H2O positron emission tomography (PET) scans performed in DBS-off and DBS-on mode. RESULTS: VTH DBS elicited an amplitude-dependent increase in heart rate and transient aggressive behavior. PET demonstrated that VTH DBS caused a global increase in cerebral blood flow velocities and decreased mean transit time. CONCLUSIONS: VTH DBS results in behavioral and physiological changes, which may derive from activation of closely related limbic and autonomic networks. Caution and further studies of longer length should be requested before this procedure is used more widely in humans.","author_count":5,"contributors":["Ettrup, Kåre Schmidt Ettrup","Sørensen, Jens Christian Hedemann","Rodell, Anders","Alstrup, Aage Kristian Olsen","Bjarkam, Carsten Reidies"],"cuid":["S01-000.00-233663"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Aggression","Animals","Autonomic nervous system","Cerebrovascular Circulation","Deep brain stimulation","Feasibility Studies","Female","Heart Rate","Hypothalamus","Limbic System","Models Animal","Models Neurological","Nerve Net","Pilot Projects","Swine","Swine Miniature"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"hypothalamic deep brain stimulation influences autonomic and limbic circuitry involved in the regulation of aggression and cardiocerebrovascular control in the göttingen minipig","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84863745558","version":"Other Version"},"id":"S01-000.00-233663","identifier":[{"id":"22797692","type":"pmid"},{"id":"84863745558","type":"scopus"}],"ids":["au-b6d99812-08f3-4797-9326-754e3c26c341"],"keyword":["Aggression","Animals","Autonomic Nervous System","Cerebrovascular Circulation","Deep Brain Stimulation","Feasibility Studies","Female","Heart Rate","Hypothalamus","Limbic System","Models, Animal","Models, Neurological","Nerve Net","Pilot Projects","Swine","Swine, Miniature"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-63EBF77FA65BD7CF87784264512B5E16"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus University, Faculty of Health Sciences, Department of Anatomy"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"K S","key":"ettruppau","last":"Ettrup","locid":"8863b0b7-8c38-42cd-be8d-4544230a3d4e","name":"Ettrup, Kåre Schmidt Ettrup","name_org":"Ettrup, K S","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"J C","key":"sørensenpau","last":"Sørensen","locid":"f442e934-3b4d-4fc2-91dc-93621be94d60","name":"Sørensen, Jens Christian Hedemann","name_org":"Sørensen, J C","orcid":"0000-0001-5139-7405","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"A","key":"rodellpau","last":"Rodell","locid":"8393d270-02cc-401d-9662-5e1698e8ac45","name":"Rodell, Anders","name_org":"Rodell, A","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"A K O","key":"alstruppau","last":"Alstrup","locid":"fa66f5b8-0468-4e85-b570-969776c5ebde","name":"Alstrup, Aage Kristian Olsen","name_org":"Alstrup, A K O","orcid":"0000-0002-0084-9122","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"C R","key":"bjarkampau","last":"Bjarkam","locid":"a1770adc-a79f-434a-98bc-02e64ffd13cd","name":"Bjarkam, Carsten Reidies","name_org":"Bjarkam, C R","rank":5,"rolecode":"pau"}],"pmid":["22797692"],"pub":{"doi":"10.1159/000338087","issn":["10116125","14230372"],"issn_org":["10116125"],"issue":"5","journal":"Stereotactic and Functional Neurosurgery","pages":"281-91","publisher":"S. Karger AG","status":"p","title":"Stereotactic and Functional Neurosurgery","volume":"90"},"review":"Peer Reviewed","scoID":["2-s2.0-84863745558"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-b6d99812-08f3-4797-9326-754e3c26c341"],"src":["AU Aarhus University"],"title":"Hypothalamic deep brain stimulation influences autonomic and limbic circuitry involved in the regulation of aggression and cardiocerebrovascular control in the Göttingen minipig","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-233663","year":"2012","yearsub":"2012"}
{"abstract":"Epidemiologic studies often rely on drug dispensation records to measure medication intake. We aimed to estimate correspondence between general practitioner (GP)-reported treatment and timing of prescription dispensation. From seven GPs in northern Denmark, we obtained 317 prescription records for 286 patients treated with ten commonly prescribed medication types for chronic diseases. We linked the GP-reported information to the regional prescription database to retrieve patients' prescription records both prospectively and retrospectively in relation to the GP-reported date of treatment (index date, August 20, 2008 for all patients). We computed overall and medication-specific correspondence between GP-reported treatment and the timing of dispensation. We computed correspondence based on both exact medication and therapeutic subgroup agreement. The correspondence for dispensation within ±90 days of GP-reported treatment was 0.81 (95% confidence interval = 0.76-0.85) with variation by medication type, ranging from 0.55 for ACE-inhibitors to 1.00 for oral glucose-lowering agents. The correspondence was greater when analyzed within therapeutic groups than when analyzed for exact medications within these groups.","author_count":6,"contributors":["Schmidt, Sigrun Alba Johannesdottir","Mægbæk, Merete Lund","Hansen, Jens Georg","Lash, Timothy L","Pedersen, Lars","Ehrenstein, Vera"],"cuid":["S01-000.00-255786"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"correspondence between general practitionerreported medication use and timing of prescription dispensation","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.2147/CLEP.S26958","version":"Other Version"},"id":"S01-000.00-255786","identifier":[{"id":"PMC3266865","type":"pmcid"},{"id":"84856796221","type":"scopus"},{"id":"22291479","type":"pmid"}],"ids":["au-dd8ccbbc-30b6-4d32-8996-fc56ee49bd34"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-C9FADB04538B1F2FC39E4B4CBC05047D"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.2147/CLEP.S26958","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus University, Faculty of Health Sciences, Klinisk Epidemiologisk Afdeling, Aalborg"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Sigrun Alba","key":"johannesdottirpau","last":"Johannesdottir","locid":"d713674c-cc15-4444-b31c-c477238cdc29","name":"Schmidt, Sigrun Alba Johannesdottir","name_org":"Johannesdottir, Sigrun Alba","orcid":"0000-0001-5527-0698","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Merete Lund","key":"mægbækpau","last":"Mægbæk","name":"Mægbæk, Merete Lund","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens Georg","key":"hansenpau","last":"Hansen","locid":"6fd57fe0-8362-46f6-9707-29e4d9f96382","name":"Hansen, Jens Georg","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Timothy L","key":"lashpau","last":"Lash","locid":"bcfc3bc1-2d69-4413-8fad-149684c745f1","name":"Lash, Timothy L","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars","key":"pedersenpau","last":"Pedersen","locid":"a0fdd247-3fb1-4c38-a1b2-f37d89f8f5c9","name":"Pedersen, Lars","orcid":"0000-0002-9341-3888","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Vera","key