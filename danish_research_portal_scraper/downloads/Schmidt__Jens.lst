":"2 3","corresponding":null,"first":"Frederikke Noerregaard","key":"jakobsenpau","last":"Jakobsen","locid":"2d1bc428-aa57-43f7-a1ab-3347a6c90fdb","name":"Jakobsen, Frederikke Noerregaard","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Troels Hoejsgaard","key":"joergensenpau","last":"Joergensen","name":"Joergensen, Troels Hoejsgaard","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Michael Rahbek","key":"schmidtpau","last":"Schmidt","name":"Schmidt, Michael Rahbek","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Morten","key":"smeruppau","last":"Smerup","name":"Smerup, Morten","rank":9,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Jens Brock","key":"johansenpau","last":"Johansen","locid":"e57328b2-dec3-44f9-803f-e9579340a1f5","name":"Johansen, Jens Brock","orcid":"0000-0001-7157-7948","rank":10,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"country":"dk","first":"Sam","key":"riahipau","last":"Riahi","locid":"9e5489d8-981a-469c-bd84-20b2e24832de","name":"Riahi, Sam","orcid":"0000-0003-1849-9463","rank":11,"rolecode":"pau"},{"affno":"6 7","corresponding":null,"first":"Lars","key":"sondergaardpau","last":"Sondergaard","name":"Sondergaard, Lars","rank":12,"rolecode":"pau"},{"affno":"8 9","corresponding":null,"country":"dk","first":"Jens Cosedis","key":"nielsenpau","last":"Nielsen","locid":"cc1c8be7-f54a-4722-8077-aa358f9b090a","name":"Nielsen, Jens Cosedis","orcid":"0000-0001-9414-1653","rank":13,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Berit Thornvig","key":"philbertpau","last":"Philbert","name":"Philbert, Berit Thornvig","rank":14,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christian","key":"jonspau","last":"Jons","name":"Jons, Christian","rank":15,"rolecode":"pau"}],"pmid":["40157438"],"pub":{"doi":"10.1016/j.hrthm.2025.03.1986","issn":["15475271","15563871"],"issn_org":["15475271"],"issue":"8","journal":"Heart Rhythm","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"p","title":"Heart Rhythm","volume":"22"},"review":"Peer Reviewed","scoID":["2-s2.0-105003467561"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-0f35c18d-6328-4c12-acdf-4ae7ec3783bb","au-780977f8-8fc6-45cf-b9f6-057179151f55","sdu-d67cf159-6266-46ca-8772-a2bd62bd41ed"],"src":["AAU Aalborg University","AU Aarhus University","SDU University of Southern Denmark"],"title":"Device-related complications in a national pediatric cardiac implantable electronic device cohort stratified after age and implantation technique","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-099.91-822235","year":"2025","yearsub":"2025"}
{"abstract":"Background: The Amulet IDE trial (AMPLATZER Amulet Left Atrial Appendage Occluder [LAAO] Investigational Device Exemption [IDE] Trial) evaluated the safety and effectiveness of the Amulet occluder (Abbott) in patients with nonvalvular atrial fibrillation. The Amulet IDE trial is the largest randomized LAAO trial, comparing the Amulet occluder with the Watchman 2.5 device (Boston Scientific). Objectives: This analysis presents the 5-year results from the trial comparing the 2 devices head to head. Methods: Patients enrolled in the Amulet IDE trial were at a high risk of stroke or systemic embolism defined as a CHADS2 score ≥2 or CHA2DS2-VASc score ≥3. Oral anticoagulation (OAC) use and key clinical outcomes are presented through 5 years. Results: A total of 1,878 patients were randomized, with 1,833 undergoing a device implantation attempt (n = 917, Amulet occluder; and n = 916, Watchman device). A significantly higher percentage of patients were free of OAC in the Amulet occluder group at each follow-up visit, with 94.0% and 90.9% free of OAC at the last 5-year follow-up visit in the Amulet and Watchman device groups, respectively (P = 0.009). The 5-year clinical outcomes were similar between the Amulet and Watchman devices, including the composite of ischemic stroke or systemic embolism (7.4% vs 7.1%; P = 0.851), the composite of stroke, systemic embolism, or cardiovascular death (20.3% vs 20.7%; P = 0.666), major bleeding (20.1% vs 20.0%; P = 0.882), cardiovascular (CV) death (14.3% vs 15.4%; P = 0.429), and all-cause death (28.7% vs 31.1%; P = 0.217). Annualized ischemic stroke rates at 5 years were low and the same for Amulet (1.6%/y) and Watchman (1.6%/y) devices. Strokes in patients with the Amulet occluder were less severe (n = 38, nondisabling; n = 11, disabling; n = 11, fatal; n = 12, unknown) than strokes in patients with the Watchman device (n = 19, nondisabling; n = 22, disabling; n = 17, fatal; n = 10, unknown). Moreover, device factors (device-related thrombus or peridevice leak ≥3 mm) preceded stroke events and CV deaths more frequently in patients with the Watchman device (n = 63) compared with patients with the Amulet occluder (n = 31). Conclusions: The 5-year outcomes from the largest randomized LAAO clinical trial demonstrated the long-term safety and effectiveness of the Amulet occluder and Watchman 2.5 devices. The dual-seal Amulet occluder reduces atrial fibrillation–related thromboembolic events while eliminating the need for long-term OAC.","author_count":16,"contributors":["Lakkireddy, Dhanunjaya","Ellis, Christopher R","Thaler, David","Swarup, Vijendra","Gambhir, Alok","Hermiller, James","Nielsen-Kudsk, Jens Erik","Worthley, Stephen","Nair, Devi","Schmidt, Boris","Horton, Rodney","Gupta, Nigel","Anderson, Jordan A","Zhao, Hong","Alkhouli, Mohamad","Windecker, Stephan"],"cuid":["S01-000.00-772784"],"filters":{"added":"2025-01","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Europe, Non-EU","OECD","Oceania"],"country":["Australia","Switzerland","United States"],"glorg":["Abbott Structural Heart","All Global Affiliations","HCA Midwest Health","Macquarie University Hospital","Mayo Clinic Rochester, MN","Private medical Practice - USA","St. David's Medical Center","St. Vincent Medical Group","Tufts University","University of Bern","Vanderbilt University"],"keyword":["Amulet","Atrial fibrillation","Left atrial appendage occlusion","Stroke","Watchman"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"000000000005 year results from the amplatzer amulet left atrial appendage occluder randomized controlled trial","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85211022388","version":"Other Version"},"id":"S01-000.00-772784","identifier":[{"id":"85211022388","type":"scopus"},{"id":"39570242","type":"pmid"}],"ids":["au-78513bd7-dce8-4e2e-8f8e-d19a6e6c9fb3"],"keyword":["Amulet","Watchman","atrial fibrillation","left atrial appendage occlusion","stroke"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-6C49999283FC1F8FA6C99EB84D2807B1"],"org":[{"affno":"1","country":"us","key":"hca midwest health","loc":["United States","America, North","OECD"],"name":"HCA Midwest Health","used":1},{"affno":"2","country":"us","key":"vanderbilt university","loc":["United States","America, North","OECD"],"name":"Vanderbilt University","used":1},{"affno":"3","country":"us","key":"tufts university","loc":["United States","America, North","OECD"],"name":"Tufts University","used":1},{"affno":"4","country":"us","key":"st vincent medical group","loc":["United States","America, North","OECD"],"name":"St. Vincent Medical Group","used":1},{"affno":"5","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Cardiological Medicine B"],"nora_code":"DI-U-AU","used":1},{"affno":"6","country":"au","key":"macquarie university hospital","loc":["Australia","Oceania","OECD"],"name":"Macquarie University Hospital","used":1},{"affno":"7","country":"us","key":"private medical practice usa","loc":["United States","America, North","OECD"],"name":"Private medical Practice - USA","used":1},{"affno":"8","country":"us","key":"st david s medical center","loc":["United States","America, North","OECD"],"name":"St. David's Medical Center","used":1},{"affno":"9","country":"us","key":"abbott structural heart","loc":["United States","America, North","OECD"],"name":"Abbott 