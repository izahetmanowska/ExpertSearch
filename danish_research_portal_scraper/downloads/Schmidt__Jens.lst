2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper Hvass","key":"schmidtpau","last":"Schmidt","locid":"db84fc4e-28da-45af-a608-13ce8f4ec719","name":"Schmidt, Jesper Hvass","orcid":"0000-0001-7683-1407","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christian","key":"faberpau","last":"Faber","locid":"41aa4a5b-b537-43a3-942c-8beeae29c5c6","name":"Faber, Christian Emil","name_org":"Faber, Christian","orcid":"0000-0002-5078-6481","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1017/s0022215116006010","issn":["00222151","17485460"],"issn_org":["00222151"],"issue":"S3","journal":"The Journal of Laryngology and Otology","paperid":"IP105","publisher":"Cambridge University Press","status":"p","title":"The Journal of Laryngology and Otology","volume":"130"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-f9de6568-4269-4358-8d0d-9420faf34535"],"src":["SDU University of Southern Denmark"],"title":"Vestibular findings after cochlear implant surgery measured by video head impulse test (vHIT) : A double blinded, randomised clinical trial","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-644743","year":"2016","yearsub":"2016"}
{"abstract":"The presence of bone particles, and hence the calcium content, is a key quality parameter for mechanically separated poultry meat (MSM). A method for fast at-line monitoring of the calcium content in MSM during production is therefore requested by the industry. Laser-induced breakdown spectroscopy (LIBS) is an interesting technique in this regard because it is fast and potentially enables direct detection of minerals in a sample with minimal sample preparation. Nine commercial MSM samples, representing the common range of calcium contents in MSM, a hand-deboned sample and minced poultry meat were measured by LIBS using sample preparation suitable for an industrial at-line monitoring setting. In the spectra obtained, emission lines from sodium, potassium and calcium were identified. Using inductively coupled plasma optical emission spectrometry (ICP-OES) as the reference method, and partial least squares regression (PLS) as calibration model, including three calcium lines adjusted by potassium, it was possible to separate samples according to three calcium levels with LIBS. Very low (<20 mg/100 g Ca), intermediate (20-90 mg/100 g Ca), and high (>90 mg/100 g Ca).","author_count":4,"contributors":["Schmidt Andersen, Maj-Britt","Frydenvang, Jens","Henckel, Poul","Rinnan, Åmund"],"cuid":["S02-100.00-019353"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Poultry","Process monitoring","laser induced breakdown spectroscopy LIBS"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the potential of laser induced breakdown spectroscopy for industrial at line monitoring of calcium content in comminuted poultry meat","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84954132357","version":"Other Version"},"id":"S02-100.00-019353","identifier":[{"id":"84954132357","type":"scopus"}],"ids":["au-5bd003f5-0e82-472b-b520-39352058e458","ku-9af3a381-d291-4301-aee6-195c5cb2c164"],"keyword":["Laser-induced breakdown spectroscopy (LIBS)","Mechanically separated meat (MSM)","Poultry","Process monitoring"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-4F4648AF3303D1CD407D9E2F976C880E"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Food Science, Food Analytics and Biotechnology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Food Science, Department of Food Science - Differentiated & Biofunctional Foods"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","first":"Maj-Britt Schmidt","key":"andersenpau","last":"Andersen","locid":"00a608c1-daed-416c-b726-b0e26c2c2158","name":"Andersen, Maj-Britt Schmidt","orcid":"0000-0002-4936-9306","rank":1,"rolecode":"pau"},{"affno":"1","first":"Jens","key":"frydenvangpau","last":"Frydenvang","locid":"133c00bf-5214-4309-9c86-e211d48b5097","name":"Frydenvang, Jens","orcid":"0000-0001-9294-1227","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Poul","key":"henckelpau","last":"Henckel","locid":"4c9dde82-b0bf-42b4-9355-30bbdb2c3ce6","name":"Henckel, Poul","rank":3,"rolecode":"pau"},{"affno":"1","first":"Åsmund","key":"rinnanpau","last":"Rinnan","locid":"dabc01b5-a8ad-49b8-8971-5a27722e4f7d","name":"Rinnan, Åsmund","orcid":"0000-0002-7754-7720","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.foodcont.2016.01.001","issn":["09567135","18737129"],"issn_org":["09567135"],"journal":"Food Control","pages":"226-233","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"p","title":"Food Control","volume":"64"},"review":"Peer Reviewed","scoID":["2-s2.0-84954132357"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-5bd003f5-0e82-472b-b520-39352058e458","ku-9af3a381-d291-4301-aee6-195c5cb2c164"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"The potential of laser-induced breakdown spectroscopy for industrial at-line monitoring of calcium content in comminuted poultry meat","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-019353","year":"2016","yearsub":"2016"}
{"abstract":"BACKGROUND: The prevalence of depression is 4- to 5-fold higher in heart failure patients than in the general population. We examined the influence of depression on all-cause mortality in patients with heart failure. METHODS AND RESULTS: Using Danish medical registries, this nationwide population-based cohort study included all patients with a first-time hospitalization for heart failure (1995-2014). All-cause mortality risks and 19-year mortality rate ratios were estimated based on Cox regression analysis, adjusting for age, sex, time period, comorbidity, and socioeconomic status. The analysis included 9636 patients with and 194 887 patients without a diagnosis of depression. Compared with patients without a history of depression, those with depression had higher 1-year (36% versus 33%) and 5-year (68% versus 63%) mortality risks. Overall, the adjusted mortality rate ratio was 1.03 (95% CI 1.01-1.06). Compared with no depression, the adjusted mortality rate ratios for mild, moderate, and severe depression, as defined by diagnostic codes, were 1.06 (95% CI 1.00-1.13), 1.03 (95% CI 0.99-1.08), and 1.02 (95% CI 0.96-1.09), respectively. In a subcohort of patients, the mortality rate ratios were modified by left ventricular ejection fraction, with adjusted mortality rate ratios of 1.17 (95% CI, 1.05-1.31) for ≤35%, 0.98 (95% CI 0.81-1.18) for 36% to 49%, and 0.96 (95% CI 0.74-1.25) for ≥50%. Results were consistent after adjustment for alcohol abuse and smoking. CONCLUSIONS: A history of depression was an adverse prognostic factor for all-cause mortality in heart failure patients with left ventricular ejection fraction ≤35% but not for other heart failure patients.","author_count":8,"contributors":["Adelborg, Kasper","Schmidt, Morten","Sundbøll, Jens","Pedersen, Lars","Videbech, Poul","Bøtker, Hans Erik","Egstrup, Kenneth","Sørensen, Henrik Toft"],"cuid":["S03-097.37-030745"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"keyword":["Cohort study","Depression","Heart failure","Journal Article","Mortality"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"mortality risk among heart failure patients with depression a nationwide population based cohort study","src":["au","ku","sdu"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1161/JAHA.116.004137","version":"Published Version"},"id":"S03-097.37-030745","identifier":[{"id":"27604456","type":"pmid"},{"id":"85030982291","type":"scopus"},{"id":"PMC5079053","type":"pmcid"}],"ids":["au-fb7a4df8-51d9-4ace-8b10-791ebf32846a","ku-39d58bbf-1ebb-431d-9cea-8cb6b9bf1e42","sdu-f4502c35-ae8e-4ecf-a0a1-706553d3a82f"],"keyword":["Cohort study","Depression","Heart failure","Journal Article","Mortality"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-A9DFD77C6C47994A1D964212A798BD1E"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://curis.ku.dk/ws/files/180789910/e004137.full_1_.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/123509613/Mortality_Risk_Among_Heart_Failure_Patients_With_Depression.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC5079053/pdf/JAH3-5-e004137.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1161/JAHA.116.004137","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University (AU)"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1},{"affno":"3","country":"dk","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["University of Southern Denmark"],"nora_code":"DI-U-SDU","used":1},{"affno":"4","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"5","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Mental Health Services CPH"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Kasper","key":"adelborgpau","last":"Adelborg","name":"Adelborg, Kasper","rank":1,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Morten","key":"schmidtpau","last":"Schmidt","name":"Schmidt, Morten","rank":2,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Jens","key":"sundbøllpau","last":"Sundbøll","name":"Sundbøll, Jens","rank":3,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Lars","key":"pedersenpau","last":"Pedersen","name":"Pedersen, Lars","rank":4,"rolecode":"pau"},{"affno":"4 5","first":"Poul","key":"videbechpau","last":"Videbech","locid":"30ef0c08-97c7-48b1-b034-d9fb316f6bd8","name":"Videbech, Poul","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Hans Erik","key":"bøtkerpau","last":"Bøtker","name":"Bøtker, Hans Erik","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Kenneth","key":"egstruppau","last":"Egstrup","locid":"12389a61-a119-4ff8-ba31-4b0accb0bbc5","name":"Egstrup, Kenneth","orcid":"0000-0002-6214-8751","rank":7,"rolecode":"pau"},{"affno":"2","first":"Henrik Toft","key":"sørensenpau","last":"Sørensen","name":"Sørensen, Henrik Toft","orcid":"0000-0003-4299-7040","rank":8,"rolecode":"pau"}],"pmid":["27604456"],"pub":{"doi":"10.1161/jaha.116.004137","issn":["20479980"],"issue":"9","journal":"Journal of the American Heart Association","paperid":"e004137","publisher":"American Heart Association Inc.","status":"p","title":"Journal of the American Heart Association","volume":"5"},"review":"Peer Reviewed","scoID":["2-s2.0-85030982291"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-fb7a4df8-51d9-4ace-8b10-791ebf32846a","ku-39d58bbf-1ebb-431d-9cea-8cb6b9bf1e42","sdu-f4502c35-ae8e-4ecf-a0a1-706553d3a82f"],"src":["AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Mortality Risk Among Heart Failure Patients With Depression : A Nationwide Population-Based Cohort Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-097.37-030745","year":"2016","yearsub":"2016"}
{"abstract":"To examine the effect on serum lipase activity and protein concentration of intravenous infusions of glucagon-like peptide-1 (GLP-1) and peptide YY (PYY3-36) and of an ad libitum meal in healthy overweight men. Twenty-five healthy, male subjects participated in this randomized, double-blinded, placebo-controlled 4-arm crossover study (Body Mass Index (BMI): 29 ± 3 kg/m(2), age: 33 ± 9 years). On separate days, the subjects received a 150-min intravenous infusion of either (1) 0.8 pmol/kg/min PYY3-36, (2) 1.0 pmol/kg/min GLP-1, (3) 1 + 2, or (4) placebo. Samples were collected throughout the infusion and after intake of an ad libitum meal for measurement of serum lipase. Serum lipase levels measured by enzyme-linked immunosorbent assay (ELISA) following mono-infusions of GLP-1 and PYY3-36 were comparable to serum lipase levels following placebo (P = 0.054 and P = 0.873, respectively). Following the co-infusion of GLP-1 and PYY3-36, serum lipase levels measured by ELISA decreased over time compared to placebo (P = 0.012). However, the between-group difference was not consistent when each time point was analyzed separately. On the placebo day, serum lipase levels measured by ELISA after an ad libitum meal rose slightly compared to the preprandial values (P = 0.003). There was strong correlation between serum lipase levels measured by ELISA and LIPC Lipase colorimetric assay (COBAS) (0.94 < r; <0.0001). Infusions of GLP-1 and PYY3-36, separately or in combination, did not increase serum lipase. However, a small increase in serum lipase may occur in response to a meal.","author_count":8,"contributors":["Schmidt, Julie Berg","Sjödin, Anders Mikael","Stevner, Lene Susanne","Ritz, Christian","Michaelsen, Natasha B","Thomsen, Anne B","Holst, Jens Juul","Astrup, Arne"],"cuid":["S01-000.00-423737"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-NOVO"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-PR-NOVO","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"serum lipase activity and concentration during intravenous infusions of glp 000000000001 and pyy sub 000000000003 000000000036 sub and after ad libitum meal ingestion in overweight men","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/166241639/Schmidt_et_al_Physiological_Reports_2016_Vol_4_18_e12980.pdf","version":"Published Version"},"id":"S01-000.00-423737","identifier":[{"id":"27670407","type":"pmid"},{"id":"PMC5037923","type":"pmcid"},{"id":"84992217953","type":"scopus"}],"ids":["ku-32edcc47-8fc0-4a37-8159-25268edbe740"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-8A0F8E4FA70E269842944D89AF479C1D"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/166241639/Schmidt_et_al_Physiological_Reports_2016_Vol_4_18_e12980.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Nutrition, Exercise and Sports, Obesity Research"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"novo nordisk","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-NOVO","l3nl":"Novo Nordisk","l3nn":"Novo Nordisk","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Novo Nordisk","namevar":["Novo Nordisk"],"nora_code":"DI-PR-NOVO","used":1}],"person":[{"affno":"1","first":"Julie Berg","key":"schmidtpau","last":"Schmidt","locid":"bfd32cb7-28ed-49e9-bc8e-4f9746043c12","name":"Schmidt, Julie Berg","orcid":"0000-0002-0299-7874","rank":1,"rolecode":"pau"},{"affno":"1","first":"Anders Mikael","key":"sjödinpau","last":"Sjödin","locid":"24ea7b85-2a13-44ec-93f5-fb419b0ab4fd","name":"Sjödin, Anders Mikael","orcid":"0000-0002-6451-3847","rank":2,"rolecode":"pau"},{"affno":"1","first":"Lene Susanne","key":"stevnerpau","last":"Stevner","locid":"23f7fda5-70ec-4987-9bbb-09e19dbdddeb","name":"Stevner, Lene Susanne","rank":3,"rolecode":"pau"},{"affno":"1","first":"Christian","key":"ritzpau","last":"Ritz","locid":"c881424f-d529-443e-b60e-bc2edb674ede","name":"Ritz, Christian","orcid":"0000-0002-5095-0624","rank":4,"rolecode":"pau"},{"affno":"2","first":"Natasha B","key":"michaelsenpau","last":"Michaelsen","name":"Michaelsen, Natasha B","rank":5,"rolecode":"pau"},{"affno":"2","first":"Anne B","key":"thomsenpau","last":"Thomsen","name":"Thomsen, Anne B","rank":6,"rolecode":"pau"},{"affno":"1","first":"Jens Juul","key":"holstpau","last":"Holst","locid":"864b6401-9024-4773-9bdb-f4d4ca57dcad","name":"Holst, Jens Juul","orcid":"0000-0001-6853-3805","rank":7,"rolecode":"pau"},{"affno":"1","first":"Arne","key":"astruppau","last":"Astrup","locid":"5d943631-c9fc-4b63-8aaa-263ba4248735","name":"Astrup, Arne","orcid":"0000-0001-8968-8996","rank":8,"rolecode":"pau"}],"pmid":["27670407"],"pub":{"doi":"10.14814/phy2.12980","issn":["2051817X"],"issue":"18","journal":"Physiological Reports","paperid":"e12980","status":"p","title":"Physiological Reports","volume":"4"},"review":"Peer Reviewed","scoID":["2-s2.0-84992217953"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Novo Nordisk","Private Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-32edcc47-8fc0-4a37-8159-25268edbe740"],"src":["KU University of Copenhagen"],"title":"Serum lipase activity and concentration during intravenous infusions of GLP-1 and PYY<sub>3-36</sub> and after ad libitum meal ingestion in overweight men","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-423737","year":"2016","yearsub":"2016"}
{"abstract":"Co-stimulation is an integral part of T cell signaling involved in almost all facets of T cell biology. While much is known about co-stimulation in differentiation and function of conventional αβ T cells, less is known about how co-stimulation affects the development and programming of γδ T cells. In this study, we have investigated the role of inducible T cell co-stimulator (ICOS) on the development of γδ T cells. We show that ICOS is expressed by a population of immature Vγ2+CD45RBlow γδ T cells predisposed to interleukin-17 (IL-17) production. We found that treatment with ICOS specific antibodies drastically reduces fetal development of IL-17-producing γδ T cells by agonistic actions, and that ICOS deficient mice have a significant increase in the population of IL-17-producing Vγ2+ γδ T cells in the thymus, spleen, lymph nodes and skin and exhibit exacerbated sensitization responses to 2,4-dinitrofluorobenzene. In conclusion, this study demonstrates that development of IL-17-producing Vγ2+ γδ T cells is reduced by ICOS signaling in the thymus.","author_count":5,"contributors":["Buus, Terkild B.","Schmidt, Jonas Damgård","Bonefeld, Charlotte Menné","Geisler, Carsten","Lauritsen, Jens Peter Holst"],"cuid":["S01-000.00-428900"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Development","ICOS","Immune response","Immunity","Interleukin 17","T cell","Thymus"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"development of interleukin 000000000017 producing vγ000000000002 sup sup γδ t cells is reduced by icos signaling in the thymus","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.18632/oncotarget.8464","version":"Published Version"},"id":"S01-000.00-428900","identifier":[{"id":"PMC4991387","type":"pmcid"},{"id":"84964747492","type":"scopus"},{"id":"27235509","type":"pmid"}],"ids":["ku-3b6b4bba-bfe7-43ea-8985-22ebe73d9778"],"keyword":["Development","ICOS","Immune response","Immunity","Immunology and Microbiology Section","Interleukin-17","Thymus","γδ T cell"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-2EE8480F93DE5C8EE4E8F5AA25B02B4E"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.18632/oncotarget.8464","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/168886825/8464_128539_4_PB.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Immunology and Microbiology, Department of Immunology and Microbiology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Terkild Brink","key":"buuspau","last":"Buus","locid":"fc3e6d64-0746-44e4-a72f-bf657ae640a8","name":"Buus, Terkild B.","name_org":"Buus, Terkild Brink","orcid":"0000-0001-7180-6384","rank":1,"rolecode":"pau"},{"affno":"1","first":"Jonas Damgård","key":"schmidtpau","last":"Schmidt","locid":"ed2d02bb-ee93-4334-ac75-6c2769aabaaa","name":"Schmidt, Jonas Damgård","rank":2,"rolecode":"pau"},{"affno":"1","first":"Charlotte Menné","key":"bonefeldpau","last":"Bonefeld","locid":"984200fd-eadd-4a8b-a9f0-92d4158657a8","name":"Bonefeld, Charlotte Menné","orcid":"0000-0002-0523-6229","rank":3,"rolecode":"pau"},{"affno":"1","first":"Carsten","key":"geislerpau","last":"Geisler","locid":"bf718810-8d55-4a0d-b416-e1a555472d41","name":"Geisler, Carsten","orcid":"0000-0002-8472-0771","rank":4,"rolecode":"pau"},{"affno":"1","first":"Jens Peter Holst","key":"lauritsenpau","last":"Lauritsen","locid":"c8cea1b6-70df-4dc3-a276-1fbedd6ced0b","name":"Lauritsen, Jens Peter Holst","rank":5,"rolecode":"pau"}],"pmid":["27235509"],"pub":{"doi":"10.18632/oncotarget.8464","issn":["19492553"],"issue":"15","journal":"OncoTarget","pages":"19341-19354","status":"p","title":"OncoTarget","volume":"7"},"review":"Peer Reviewed","scoID":["2-s2.0-84964747492"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-3b6b4bba-bfe7-43ea-8985-22ebe73d9778"],"src":["KU University of Copenhagen"],"title":"Development of interleukin-17-producing Vγ2<sup>+</sup> γδ T cells is reduced by ICOS signaling in the thymus","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-428900","year":"2016","yearsub":"2016"}
{"abstract":"Objectives: Increased energy expenditure (EE) has been proposed an important mechanism for weight loss following Roux-en-Y gastric bypass (RYGB). However, this has never been investigated in a controlled setting independent of changes in energy balance. Likewise, only few studies have investigated the effect of RYGB on glycaemic control per se. Here, we investigated the effect of RYGB on EE, appetite, glycaemic control, and specific signalling molecules compared to a control group in comparable negative energy balance. Subjects/Methods:  Obese normal glucose tolerant participants were randomized to receive RYGB after 8 (n=14) or 12 weeks (n=14). The protocol included a visit at week 0 and three visits (week 7, 11 and 78) where 24 h EE, appetite and blood parameters were assessed. Participants followed a low-calorie diet from week 0-11, with those operated at week 12 serving as a control group for those operated at week 8. Results: Compared to controls, RYGB operated participants had lower body composition-adjusted 24 h EE and basal EE three weeks postoperatively (both P<0.05) but EE parameters at week 78 were not different from pre-operative values (week 7). Surgery changed the postprandial response of GLP-1, PYY, ghrelin, CCK, FGF-19 and bile acids (all P<0.05). Particularly, increases in GLP-1, PYY and decreases in ghrelin were associated with decreased appetite. None of HOMA-IR, Matsuda Index, the Insulinogenic Index, the Disposition Index and fasting hepatic insulin clearance were different between the groups, but RYGB operated had lower fasting glucose (P<0.05) and the postprandial glucose profile was shifted to the left (P<0.01). Conclusion: Our data do not support that EE is increased after RYGB. More likely, RYGB promotes weight loss by reducing appetite, partly mediated by changes in gastrointestinal hormone secretion. Furthermore, we found that the early changes in glycaemic control after RYGB is to a large extent mediated by caloric restriction.","author_count":14,"contributors":["Schmidt, Julie Berg","Pedersen, Susie Dawn","Gregersen, Nikolaj Ture","Nielsen, Lone Vestergaard","Nielsen, Mette Søndergaard","Ritz, Christian","Madsbad, Sten","Worm, Dorte","Hansen, Dorte Lindqvist","Clausen, T R","Rehfeld, Jens F.","Astrup, Arne","Holst, Jens Juul","Sjödin, Anders Mikael"],"cuid":["S01-000.00-438223"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-NOVO"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-PR-NOVO","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"effects of rygb on energy expenditure appetite and glycemic control a randomized controlled clinical trial","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-438223","identifier":[{"id":"84957844598","type":"scopus"},{"id":"26303352","type":"pmid"}],"ids":["ku-4b0c37e8-45fb-49d9-8144-20fd5d8c178e"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-07BF97FBF366F27A63FAFB00F2DD2F55"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Nutrition, Exercise and Sports, Obesity Research"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"novo nordisk","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-NOVO","l3nl":"Novo Nordisk","l3nn":"Novo Nordisk","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Novo Nordisk","namevar":["Novo Nordisk"],"nora_code":"DI-PR-NOVO","used":1}],"p