o":"3","corresponding":null,"first":"Nanna L.J.","key":"udesenpau","last":"Udesen","locid":"f71f56f5-4f36-4de5-a7ae-e5e51f101a83","name":"Udesen, Nanna Louise Junker","name_org":"Udesen, Nanna L.J.","orcid":"0000-0003-1542-3260","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Louise","key":"lindepau","last":"Linde","locid":"4fc23628-00d4-466a-9e6e-269e23160481","name":"Linde, Louise","orcid":"0000-0002-7757-2571","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Ann","key":"bankepau","last":"Banke","locid":"0d350637-c6ce-4cf8-82ba-e965da703690","name":"Banke, Ann","orcid":"0000-0002-1036-580X","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Amalie L.","key":"povlsenpau","last":"Povlsen","locid":"085efe15-36a1-434b-9b9e-b4341cd84a0d","name":"Povlsen, Amalie Ling","name_org":"Povlsen, Amalie L.","orcid":"0000-0001-6044-8841","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jeppe P.","key":"larsenpau","last":"Larsen","locid":"9c1f7b9d-9e43-45ec-aa4d-310cdce6686a","name":"Larsen, Jeppe P.","rank":7,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Christian","key":"hassagerpau","last":"Hassager","name":"Hassager, Christian","rank":8,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Lisette O.","key":"jensenpau","last":"Jensen","locid":"b78c452e-5a69-41fe-ba49-0096c84d1d4d","name":"Jensen, Lisette Okkels","name_org":"Jensen, Lisette O.","orcid":"0000-0002-4838-2429","rank":9,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jens F.","key":"lassenpau","last":"Lassen","locid":"2af194b2-635f-4b62-84c2-26bd7dc3263b","name":"Lassen, Jens Flensted","name_org":"Lassen, Jens F.","orcid":"0000-0001-7972-9192","rank":10,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Henrik","key":"schmidtpau","last":"Schmidt","locid":"9789920f-4b31-4f28-8211-97afced9d61e","name":"Schmidt, Henrik","rank":11,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Hanne B.","key":"ravnpau","last":"Ravn","locid":"25de7650-3dc1-4594-b758-9c36f6de6306","name":"Ravn, Hanne Berg","name_org":"Ravn, Hanne B.","orcid":"0000-0003-4702-5195","rank":12,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Peter M.H.","key":"heegaardpau","last":"Heegaard","locid":"f15c1dfb-4275-4369-9b2b-2af936d2e0e6","name":"Heegaard, Peter M. H.","name_org":"Heegaard, Peter M.H.","orcid":"0000-0003-4506-4932","rank":13,"rolecode":"pau"},{"affno":"3 2","corresponding":null,"first":"Jacob E.","key":"møllerpau","last":"Møller","locid":"5e4d3cb6-b0a0-4541-aea1-30e73f7c10b8","name":"Møller, Jacob Eifer","name_org":"Møller, Jacob E.","orcid":"0000-0003-2873-5845","rank":14,"rolecode":"pau"}],"pmid":["38647741"],"pub":{"doi":"10.1186/s40635-024-00625-8","issn":["2197425X"],"issue":"1","journal":"Intensive Care Medicine Experimental","paperid":"39","publisher":"Springer Nature","status":"p","title":"Intensive Care Medicine Experimental","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-85191053969"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Technical University of Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["dtu-7be470cb-5537-487c-809c-a5428bf8bef9","sdu-58d98f09-8d5c-4099-a4e4-7b81d162b074"],"src":["DTU Technical University of Denmark","SDU University of Southern Denmark"],"title":"Immediate inflammatory response to mechanical circulatory support in a porcine model of severe cardiogenic shock","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-735397","year":"2024","yearsub":"2024"}
{"abstract":"AIMS: The decisions about placing an ICD in a child are more difficult than in an adult due to longer expected lifespan and the complication risk. Young patients gain the most years from ICDs, despite higher risk of device-related complications. The secondary prevention ICD indication is clear, and device is implanted regardless of potential complications. For primary prevention, risk of sudden cardiac death and complications need to be evaluated. We aimed to compare outcomes for primary and secondary prevention ICDs. METHODS AND RESULTS: Retrospective nationwide cohort study including paediatric patients identified from the Danish ICD registry with ICD implanted at an age ≤ 15 from 1982-21. Demographics, complications (composite of device-related infections or lead-failure requiring re-operation, mortality because of arrhythmia, or unknown cause), and mortality were retrieved from medical charts. Endpoint was appropriate therapy (shock or anti-tachycardia pacing for ventricular tachycardia or fibrillation). Of 72 receiving an ICD, the majority had channelopathies (n = 34) or structural heart diseases (n = 28). ICDs were implanted in 23 patients for primary prevention and 49 for secondary prevention, at median ages of 13.8 and 11.6 years (P-value 0.01), respectively. Median follow-up was 9.0 (interquartile ranges: 4.7-13.5) years. The 10-year cumulative incidence of first appropriate therapy was 70%, with complication and inappropriate therapy rates at 41% and 15%, respectively. No difference was observed between prevention groups for all outcomes. Six patients died during follow-up. CONCLUSION: In children, two-thirds are secondary prevention ICDs. Children have higher appropriate therapy and complication rates than adults, while the inappropriate therapy rate was low.","author_count":17,"contributors":["Thuraiaiyah, Jani","Philbert, Berit Thornvig","Jensen, Annette Schophuus","Xing, Lucas Yixi","Joergensen, Troels Hoejsgaard","Lim, Chee Woon","Jakobsen, Frederikke Noerregaard","Bække, Pernille Steen","Schmidt, Michael Rahbek","Idorn, Lars","Holdgaard Smerup, Morten","Johansen, Jens Brock","Riahi, Sam","Nielsen, Jens Cosedis","De Backer, Ole","Sondergaard, Lars","Jons, Christian"],"cuid":["S02-100.00-761828"],"filters":{"added":"2024-11","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","OECD"],"corresponding_author":["Thuraiaiyah, Jani"],"country":["United States"],"glorg":["Abbott Laboratories","All Global Affiliations"],"keyword":["Appropriate therapy","Congenital heart disease","Implantable cardioverter defibrillator","Paediatric cardiology","Sudden cardiac death"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-NDR","DI-HO-SDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-NDR","DI-HO-SDR","DI-U-AAU","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"implantable cardioverter defibrillator therapy in paediatric patients for primary vs secondary prevention","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1093/europace/euae245","version":"Published Version"},"id":"S02-100.00-761828","identifier":[{"id":"85205335271","type":"scopus"},{"id":"39345160","type":"pmid"},{"id":"PMC11440178","type":"pmcid"}],"ids":["au-bd720ad0-5506-4059-b1a8-1c2a478595ea","sdu-a58964b2-5608-4dba-916c-ea13c5e36f18"],"keyword":["Appropriate therapy","Congenital heart disease","Implantable cardioverter defibrillator","Paediatric cardiology","Sudden cardiac death"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-3-6-8FC4D1C8979D43227ED6BEB6778CC566"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws