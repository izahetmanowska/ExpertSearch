o":"","first":"Hongxin","key":"zhuhongxinpau","last":"Zhu","name":"Zhu, Hongxin","rank":2454,"rolecode":"pau"},{"affno":"","first":"Hua","key":"zhuhuapau","last":"Zhu","name":"Zhu, Hua","rank":2455,"rolecode":"pau"},{"affno":"","first":"Wei-Guo","key":"zhuweiguopau","last":"Zhu","name":"Zhu, Wei-Guo","rank":2456,"rolecode":"pau"},{"affno":"","first":"Wenhua","key":"zhuwenhuapau","last":"Zhu","name":"Zhu, Wenhua","rank":2457,"rolecode":"pau"},{"affno":"","first":"Xiao-Feng","key":"zhuxiaofengpau","last":"Zhu","name":"Zhu, Xiao-Feng","rank":2458,"rolecode":"pau"},{"affno":"","first":"Yuhua","key":"zhuyuhuapau","last":"Zhu","name":"Zhu, Yuhua","rank":2459,"rolecode":"pau"},{"affno":"","first":"Shi-Mei","key":"zhuangshimeipau","last":"Zhuang","name":"Zhuang, Shi-Mei","rank":2460,"rolecode":"pau"},{"affno":"","first":"Xiaohong","key":"zhuangxiaohongpau","last":"Zhuang","name":"Zhuang, Xiaohong","rank":2461,"rolecode":"pau"},{"affno":"","first":"Elio","key":"ziparoeliopau","last":"Ziparo","name":"Ziparo, Elio","rank":2462,"rolecode":"pau"},{"affno":"","first":"Christos E","key":"zoischristosepau","last":"Zois","name":"Zois, Christos E","rank":2463,"rolecode":"pau"},{"affno":"","first":"Teresa","key":"zoladekteresapau","last":"Zoladek","name":"Zoladek, Teresa","rank":2464,"rolecode":"pau"},{"affno":"","first":"Wei-Xing","key":"zongweixingpau","last":"Zong","name":"Zong, Wei-Xing","rank":2465,"rolecode":"pau"},{"affno":"","first":"Antonio","key":"zorzanoantoniopau","last":"Zorzano","name":"Zorzano, Antonio","rank":2466,"rolecode":"pau"},{"affno":"","first":"Susu M","key":"zughaiersusumpau","last":"Zughaier","name":"Zughaier, Susu M","rank":2467,"rolecode":"pau"}],"pmid":["26799652"],"pub":{"doi":"10.1080/15548627.2015.1100356","issn":["15548627","15548635"],"issn_org":["15548627"],"issue":"1","journal":"Autophagy","pages":"1-222","status":"p","title":"Autophagy","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-85013763791"],"search":{"DAF":["All Danish Affiliations"