r":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, AAU Energy"],"nora_code":"DI-U-AAU","used":1},{"affno":"4","country":"us","key":"massachusetts institute of technology","loc":["United States","America, North","OECD"],"name":"Massachusetts Institute of Technology","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Ana I.","key":"torrespau","last":"Torres","name":"Torres, Ana I.","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Muhammad T.","key":"ashrafpau","last":"Ashraf","name":"Ashraf, Muhammad T.","rank":2,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"country":"dk","first":"Tanmay","key":"chaturvedipau","last":"Chaturvedi","locid":"b3f5d7f0-b816-4c27-9382-1169eb40768c","name":"Chaturvedi, Tanmay","orcid":"0000-0003-1966-8898","rank":3,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Jens Ejbye","key":"schmidtpau","last":"Schmidt","locid":"f3b10fc3-ff7d-440d-9ee8-921079f6e769","name":"Schmidt, Jens Ejbye","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"George","key":"stephanopoulospau","last":"Stephanopoulos","name":"Stephanopoulos, George","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-319-56457-9_8","eisbn":["9783319564579"],"isbn":["9783319564562"],"pages":"207-235","publisher":"Springer","status":"p","subtitle":"Production of Bioethanol and High Added-Value Compounds of Second and Third Generation Biomass","title":"Hydrothermal Processing in Biorefineries"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-01f0e0d7-2d5b-4c31-b534-12f56d762194"],"src":["AAU Aalborg University"],"title":"Hydrothermal pretreatment : Process modeling and economic assessment within the framework of biorefinery processes","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-050578","year":"2017","yearsub":"2017"}
{"abstract":"Remote ischemic conditioning (RIC) protects against acute ischemia-reperfusion injury and may also have beneficial effects in patients with stable cardiovascular disease. We investigated the effect of long-term RIC treatment in patients with chronic ischaemic heart failure (CIHF). In a parallel group study, 22 patients with compensated CIHF and 21 matched control subjects without heart failure or ischemic heart disease were evaluated by cardiac magnetic resonance imaging, cardiopulmonary exercise testing, skeletal muscle function testing, blood pressure measurement and blood sampling before and after 28 ± 4 days of once daily RIC treatment. RIC was conducted as four cycles of 5 min upper arm ischemia followed by 5 min of reperfusion. RIC did not affect left ventricular ejection fraction (LVEF) or global longitudinal strain (GLS) in patients with CIHF (p = 0.63 and p = 0.11) or matched controls (p = 0.32 and p = 0.20). RIC improved GLS in the subgroup of patients with CIHF and with NT-proBNP plasma levels above the geometric mean of 372 ng/l (p = 0.04). RIC did not affect peak workload or oxygen uptake in either patients with CIHF (p = 0.26 and p = 0.59) or matched controls (p = 0.61 and p = 0.10). However, RIC improved skeletal muscle power in both groups (p = 0.02 for both). In patients with CIHF, RIC lowered systolic blood pressure (p < 0.01) and reduced NT-proBNP plasma levels (p = 0.02). Our findings suggest that long-term RIC treatment does not improve LVEF but increases skeletal muscle function and reduces blood pressure and NT-proBNP in patients with compensated CIHF. This should be investigated in a randomized sham-controlled trial.","author_count":10,"contributors":["Pryds, Kasper","Nielsen, Bent Roni Ranghøj","Jorsal, Anders","Hansen, Mona Sahlholdt","Ringgaard, Steffen","Refsgaard, Jens","Kim, Won Yong","Petersen, Annemette Krintel","Bøtker, Hans Erik","Schmidt, Michael Rahbek"],"cuid":["S01-000.00-196039"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Journal Article"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"effect of long term remote ischemic conditioning in patients with chronic ischemic heart failure","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85032353557","version":"Other Version"},"id":"S01-000.00-196039","identifier":[{"id":"85032353557","type":"scopus"},{"id":"29071437","type":"pmid"}],"ids":["au-74d6d03a-129e-410d-af6c-1f0eab31edbc"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-68132FEB23349308F8AFDE8690B04D41"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Cardiological Medicine B","Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Tilknyttede Klinisk Medicin"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Kasper","key":"prydspau","last":"Pryds","locid":"e8f8ad41-ec4a-4b07-851f-b898f7ead8c5","name":"Pryds, Kasper","orcid":"0000-0003-0182-8718","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Roni Ranghøj","key":"nielsenpau","last":"Nielsen","locid":"896f4a21-d29c-4ad9-b0ef-4e7f8616c234","name":"Nielsen, Bent Roni Ranghøj","name_org":"Nielsen, Roni Ranghøj","orcid":"0000-0001-9228-3869","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders","key":"jorsalpau","last":"Jorsal","locid":"16e0eff8-d885-41bc-afb7-89c374f7c0c9","name":"Jorsal, Anders","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mona Sahlholdt","key":"hansenpau","last":"Hansen","locid":"91632441-7b3e-4b76-8b89-cce9d0245eee","name":"Hansen, Mona Sahlholdt","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Steffen","key":"ringgaardpau","last":"Ringgaard","locid":"56699a63-018d-4902-b5f7-9816f8b7e4fc","name":"Ringgaard, Steffen","orcid":"0000-0001-5353-7379","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens","key":"refsgaardpau","last":"Refsgaard","locid":"bef61e81-bb73-450c-a731-ec33a8e2a7e4","name":"Refsgaard, Jens","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Won Yong","key":"kimpau","last":"Kim","locid":"5124a60e-0d6b-4fce-947f-75ec72c482e6","name":"Kim, Won Yong","orcid":"0000-0003-1302-1671","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Annemette Krintel","key":"petersenpau","last":"Petersen","locid":"b1474048-1fcb-4a5c-8e50-0be83e708b63","name":"Petersen, Annemette Krintel","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Hans Erik","key":"bøtkerpau","last":"Bøtker","locid":"09b03c00-11a8-4f72-800f-181f26155750","name":"Bøtker, Hans Erik","orcid":"0000-0001-6358-8962","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Michael Rahbek","key":"schmidtpau","last":"Schmidt","locid":"b426fa5b-d8ea-4975-821c-43c67d717749","name":"Schmidt, Michael Rahbek","rank":10,"rolecode":"pau"}],"pmid":["29071437"],"pub":{"doi":"10.1007/s00395-017-0658-6","issn":["03008428","14330946"],"issn_org":["03008428"],"issue":"67","journal":"Basic Research in Cardiology","paperid":"67","publisher":"Springer Science and Business Media Deutschland GmbH","status":"p","title":"Basic Research in Cardiology","volume":"112"},"review":"Peer Reviewed","scoID":["2-s2.0-85032353557"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-74d6d03a-129e-410d-af6c-1f0eab31edbc"],"src":["AU Aarhus University"],"title":"Effect of long-term remote ischemic conditioning in patients with chronic ischemic heart failure","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-196039","year":"2017","yearsub":"2017"}
{"abstract":"Glucagon-like peptide 1 (GLP-1) is a small incretin hormone stimulated by food intake, resulting in an amplification of the insulin response. Though interesting as a drug candidate for the treatment of type 2 diabetes mellitus, its short plasma half-life of less than 3 minutes limits its clinical use. A strategy to extend the half-life of GLP-1 utilizes the long half-life of human serum albumin (HSA) by combining the two via chemical conjugation or genetic fusion. HSA has a plasma half-life of around 21 days owing to its interaction with the neonatal Fc receptor (FcRn) expressed in endothelial cells of blood vessels, which rescues circulating HSA from lysosomal degradation. We have conjugated GLP-1 to C34 of native sequence recombinant HSA (rHSA) and two rHSA variants; one with increased and one with decreased binding affinity to hFcRn. We have investigated the impact of conjugation on FcRn binding affinities, GLP-1 potency and pharmacokinetics, combined with the solution structure of the rHSA variants and GLP-1 albumin conjugates. The solution structures, determined by small angle X-ray scattering, show the GLP-1 pointing away from the surface of rHSA. Combining the solution structures with the available structural information on the FcRn and GLP-1 receptor (GLP-1R) obtained from X-ray crystallography, we can explain the observed in-vitro and in-vivo behaviour. We conclude that the conjugation of GLP-1 to rHSA does not affect the interaction between rHSA and FcRn, while the observed decrease in the potency of GLP-1 can be explained by a steric hindrance of GLP-1 binding to its receptor.","author_count":7,"contributors":["Bukrinski, Jens T.","Sønderby, Pernille","Antunes, Filipa","Andersen, Birgitte","Schmidt, Esben G. W.","Peters, Güenther H. J.","Harris, Pernille"],"cuid":["S01-000.00-347476"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["Albumedix Ltd.","All Global Affiliations"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-NOSI"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-PR-NOSI","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"glucagon like peptide 000000000001 conjugated to recombinant human serum albumin variants with modified neonatal fc receptor binding properties impact on molecular structure and half life","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/134791681/untitled.pdf","version":"Authors Final Version"},"id":"S01-000.00-347476","identifier":[{"id":"28799326","type":"pmid"},{"id":"85029393285","type":"scopus"}],"ids":["dtu-8fcde65f-26b5-4795-9f21-a58f651bfd0d"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-134C214F8F81AD98536B3A1D818A6F26"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/134791681/untitled.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","country":"dk","key":"novonesis","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-NOSI","l3nn":"Novonesis","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Novonesis","namevar":["Novozymes A/S"],"nora_code":"DI-PR-NOSI","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Chemistry","Technical University of Denmark, Department of Chemistry, X-ray Crystallography"],"nora_code":"DI-U-DTU","used":1},{"affno":"3","country":"gb","key":"albumedix ltd","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Albumedix Ltd.","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jens T.","key":"bukrinskipau","last":"Bukrinski","name":"Bukrinski, Jens T.","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Pernille","key":"sønderbypau","last":"Sønderby","locid":"aa1f8707-9e0f-4d55-b7df-41d8f44dbc10","name":"Sønderby, Pernille","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Filipa","key":"antunespau","last":"Antunes","name":"Antunes, Filipa","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Birgitte","key":"andersenpau","last":"Andersen","name":"Andersen, Birgitte","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Esben G. W.","key":"schmidtpau","last":"Schmidt","name":"Schmidt, Esben G. W.","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Güenther H. J.","key":"peterspau","last":"Peters","name":"Peters, Güenther H. J.","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Pernille","key":"harrispau","last":"Harris","locid":"2abfaf3f-4086-487a-be1b-00fa7f5f6805","name":"Harris, Pernille","orcid":"0000-0002-6806-4903","rank":7,"rolecode":"pau"}],"pmid":["28799326"],"pub":{"doi":"10.1021/acs.biochem.7b00492","issn":["00062960","15204995"],"issn_org":["00062960"],"issue":"36","journal":"Biochemistry","pages":"4860-4870","publisher":"American Chemical Society","status":"p","title":"Biochemistry","volume":"56"},"review":"Peer Reviewed","scoID":["2-s2.0-85029393285"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Private Research","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-8fcde65f-26b5-4795-9f21-a58f651bfd0d"],"src":["DTU Technical University of Denmark"],"title":"Glucagon-like Peptide 1 Conjugated to Recombinant Human Serum Albumin Variants with Modified Neonatal Fc Receptor Binding Properties. Impact on Molecular Structure and Half-Life","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-347476","year":"2017","yearsub":"2017"}
{"abstract":"The aim of the present study was to assess the effects of a high carbohydrate diet (HCD) vs a low carbohydrate diet (LCD) on glycaemic variables and cardiovascular risk markers in patients with type 1 diabetes. Ten patients (4 women, insulin pump-treated, median ± standard deviation [s.d.] age 48 ± 10 years, glycated haemoglobin [HbA1c] 53 ± 6 mmol/mol [7.0% ± 0.6%]) followed an isocaloric HCD (≥250 g/d) for 1 week and an isocaloric LCD (≤50 g/d) for 1 week in random order. After each week, we downloaded pump and sensor data and collected fasting blood and urine samples. Diet adherence was high (225 ± 30 vs 47 ± 10 g carbohydrates/d; P < .0001). Mean sensor glucose levels were similar in the two diets (7.3 ± 1.1 vs 7.4 ± 0.6 mmol/L; P = .99). The LCD resulted in more time with glucose values in the range of 3.9 to 10.0 mmol/L (83% ± 9% vs 72% ± 11%; P = .02), less time with values ≤3.9 mmol/L (3.3% ± 2.8% vs 8.0% ± 6.3%; P = .03), and less glucose variability (s.d. 1.9 ± 0.4 vs 2.6 ± 0.4 mmol/L; P = .02) than the HCD. Cardiovascular markers were unaffected, while fasting glucagon, ketone and free fatty acid levels were higher at end of the LCD week than the HCD week. In conclusion, the LCD resulted in more time in euglycaemia, less time in hypoglycaemia and less glucose variability than the HCD, without altering mean glucose levels.","author_count":6,"contributors":["Ranjan, Ajenthen","Schmidt, Signe","Damm-Frydenberg, Camilla","Holst, Jens Juul","Madsbad, Sten","Nørgaard, Kirsten"],"cuid":["S01-000.00-446302"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"short term effects of a low carbohydrate diet on glycaemic variables and cardiovascular risk markers in patients with type 000000000001 diabetes a randomized open label crossover trial","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-446302","identifier":[{"id":"85022328302","type":"scopus"},{"id":"28345762","type":"pmid"}],"ids":["ku-585de7a7-cf19-4e61-b017-f0ec84b0b1ed"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-59D1E2DB64E0093CF4AB527E999068B7"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Amager and Hvidovre"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Basic Metabolic Research, NNF Center for Basic Metabolic Research"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Ajenthen","key":"ranjanpau","last":"Ranjan","name":"Ranjan, Ajenthen","rank":1,"rolecode":"pau"},{"affno":"1","first":"Signe","key":"schmidtpau","last":"Schmidt","name":"Schmidt, Signe","rank":2,"rolecode":"pau"},{"affno":"1","first":"Camilla","key":"dammfrydenbergpau","last":"Damm-Frydenberg","name":"Damm-Frydenberg, Camilla","rank":3,"rolecode":"pau"},{"affno":"2","first":"Jens Juul","key":"holstpau","last":"Holst","locid":"864b6401-9024-4773-9bdb-f4d4ca57dcad","name":"Holst, Jens Juul","orcid":"0000-0001-6853-3805","rank":4,"rolecode":"pau"},{"affno":"2","first":"Sten","key":"madsbadpau","last":"Madsbad","locid":"1018c708-245a-4057-9263-074578042385","name":"Madsbad, Sten","rank":5,"rolecode":"pau"},{"affno":"2","first":"Kirsten","key":"nørgaardpau","last":"Nørgaard","locid":"771b216e-eeb8-449e-8cde-2cdd59ae6dbc","name":"Nørgaard, Kirsten","rank":6,"rolecode":"pau"}],"pmid":["28345762"],"pub":{"doi":"10.1111/dom.12953","issn":["14628902","14631326"],"issn_org":["14628902"],"issue":"10","journal":"Diabetes, Obesity and Metabolism","pages":"1479-1484","status":"p","title":"Diabetes, Obesity and Metabolism","volume":"19"},"review":"Peer Reviewed","scoID":["2-s2.0-85022328302"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-585de7a7-cf19-4e61-b017-f0ec84b0b1ed"],"src":["KU University of Copenhagen"],"title":"Short-term effects of a low carbohydrate diet on glycaemic variables and cardiovascular risk markers in patients with type 1 diabetes : A randomized open-label crossover trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-446302","year":"2017","yearsub":"2017"}
