iversity","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University"],"nora_code":"DI-U-AU","used":1},{"affno":"4","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Søren","key":"darlingpau","last":"Darling","locid":"4becbb62-4dd1-40d0-9f5f-240bd9f09e0c","name":"Darling, Søren","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens Christian","key":"schmidtpau","last":"schmidt","locid":"7bbc3b09-ec10-4192-9f44-1b59188ce04b","name":"Schmidt, Jens Christian","name_org":"schmidt, Jens Christian","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Stine","key":"fiskerpau","last":"Fisker","locid":"cb813e68-013f-4e2e-ab81-56058ae6652b","name":"Fisker, Stine","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lene","key":"dybdahlpau","last":"Dybdahl","name":"Dybdahl, Lene","rank":4,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Lars","key":"wiuffandersenpau","last":"Wiuff Andersen","name":"Wiuff Andersen, Lars","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Stine","key":"zwislerpau","last":"Zwisler","locid":"82df97d7-0642-4901-adf5-51f0c6fa1afd","name":"Zwisler, Stine T.","name_org":"Zwisler, Stine","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.resuscitation.2020.08.078","issn":["03009572","18731570"],"issn_org":["03009572"],"issue":"Suppl. 1","journal":"Resuscitation","paperid":"PT11","publisher":"Elsevier","status":"p","title":"Resuscitation","volume":"155"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL",