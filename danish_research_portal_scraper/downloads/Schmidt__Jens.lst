ll,"first":"T. A.","key":"wijkamptapau","last":"Wijkamp","name":"Wijkamp, T. A.","rank":235,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"D.","key":"wünderlichdpau","last":"Wünderlich","name":"Wünderlich, D.","rank":236,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"C.","key":"wüthrichcpau","last":"Wüthrich","name":"Wüthrich, C.","rank":237,"rolecode":"pau"},{"affno":"8","corresponding":null,"first":"V.","key":"yanovskiyvpau","last":"Yanovskiy","name":"Yanovskiy, V.","rank":238,"rolecode":"pau"},{"affno":"27","corresponding":null,"first":"J.","key":"zebrowskijpau","last":"Zebrowski","name":"Zebrowski, J.","rank":239,"rolecode":"pau"}],"pub":{"doi":"10.1088/1741-4326/ac369b","issn":["00295515","10185577"],"issn_org":["00295515"],"issue":"4","journal":"Nuclear Fusion","paperid":"042018","publisher":"IOP Publishing","status":"p","title":"Nuclear Fusion","volume":"62"},"review":"Peer Reviewed","scoID":["2-s2.0-85126321813"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-b8349d19-8384-49b0-b9f8-97a3d198256e"],"src":["DTU Technical University of Denmark"],"title":"Overview of the TCV tokamak experimental programme","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-359631","year":"2022","yearsub":"2022"}
{"abstract":"Physical activity (PA) has shown to mitigate many of the common side effects of cancer treatments. The promotion of PA by health care professionals (HCPs) can facilitate the adoption of PA by patients with cancer. Drawing on an empirical ethics of care approach, this article explores how the delivery of PA recommendations is done within clinical cancer care. Based on 175 observations of consultations between doctors, nurses and patients and interviews with 27 doctors and nurses, we show how delivering PA recommendations was related to four care practices: “adjusting information to match the patient’s needs and situation,” “managing current and anticipated treatment-induced side effects,” “using visual aids and quantifiable data,” and “maintaining a good relationship between the patient and the HCP.” Drawing on these findings, we discuss strategies to strengthen the delivery of PA recommendations in clinical cancer care.","author_count":5,"contributors":["Ladefoged Kopp Schmidt, Mette","Østergren, Peter Busch","Cormie, Prue","Sønksen, Jens","Midtgaard, Julie"],"cuid":["S01-000.00-398890"],"filters":{"added":"2022-11","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["OECD","Oceania"],"country":["Australia"],"glorg":["All Global Affiliations","Peter Maccallum Cancer Centre","University of Melbourne"],"keyword":["Cancer","Clinical practice","Interviews","Observations","Physical activity recommendations"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"delivering physical activity recommendations in daily clinical cancer care an observational interview study in prostate cancer out patient clinics using an empirical ethics of care approach","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-398890","identifier":[{"id":"85132630478","type":"scopus"},{"id":"35523233","type":"pmid"}],"ids":["ku-0906da6a-ce5b-4d56-a50f-8acd6c518aa9"],"keyword":["cancer","clinical practice","health care professional-patient encounter","interviews","observations","physical activity recommendations"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-650FAB33F7649D998115DF822A7EF13A"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"au","key":"peter maccallum cancer centre","loc":["Australia","Oceania","OECD"],"name":"Peter Maccallum Cancer Centre","used":1},{"affno":"3","country":"au","key":"university of melbourne","loc":["Australia","Oceania","OECD"],"name":"University of Melbourne","used":1}],"person":[{"affno":"1","first":"Mette","key":"ladefogedkoppschmidtpau","last":"Ladefoged Kopp Schmidt","locid":"16098819-0d63-47ce-bed8-cbc48b5b55c4","name":"Ladefoged Kopp Schmidt, Mette","rank":1,"rolecode":"pau"},{"affno":"1","first":"Peter","key":"østergrenpau","last":"Østergren","locid":"27fc1e9b-5aa1-46e7-b217-73fb0c5e80e7","name":"Østergren, Peter Busch","name_org":"Østergren, Peter","rank":2,"rolecode":"pau"},{"affno":"2 3","first":"Prue","key":"cormiepau","last":"Cormie","name":"Cormie, Prue","rank":3,"rolecode":"pau"},{"affno":"1","first":"Jens","key":"sønksenpau","last":"Sønksen","locid":"feaefc17-e926-4892-9f0a-983e08461edf","name":"Sønksen, Jens","rank":4,"rolecode":"pau"},{"affno":"1","first":"Julie","key":"midtgaardpau","last":"Midtgaard","locid":"9f64fbe5-60e9-49c3-bb06-7ec73d018a77","name":"Midtgaard, Julie","orcid":"0000-0003-2381-2127","rank":5,"rolecode":"pau"}],"pmid":["35523233"],"pub":{"doi":"10.1177/10497323221085108","issn":["10497323","15527557"],"issn_org":["10497323"],"issue":"7","journal":"Qualitative Health Research","pages":"1086-1098","status":"p","title":"Qualitative Health Research","volume":"32"},"review":"Peer Reviewed","scoID":["2-s2.0-85132630478"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-0906da6a-ce5b-4d56-a50f-8acd6c518aa9"],"src":["KU University of Copenhagen"],"title":"Delivering Physical Activity Recommendations in Daily Clinical Cancer Care : An Observational Interview Study in Prostate Cancer Out-Patient Clinics Using an Empirical Ethics of Care Approach","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-398890","year":"2022","yearsub":"2022"}
{"abstract":"Biological methanation is the production of CH4 from CO2 and H2. While this approach to carbon capture utilization have been widely researched in the recent years, there is a gap in the technology. The gap is towards the flexibility in biomethanation, utilizing biological trickling filters (BTF). With the current intermittent energy system, electricity is not a given surplus energy which will interfere with a continuous operation of biomethanation and will result in periods of operational downtime. This study investigated the effect of temperature and H2 supply during downtimes, to optimize the time needed to regain initial performance. Short (6 h), medium (24 h) and long (72 h) downtimes were investigated with combinations of three different temperatures and three different flow rates. The results from these 27 experiments showed that with the optimized parameters, it would take 60 min to reach 98.4% CH4 in the product gas for a short downtime, whereas longer downtimes needed 180 min to reach 91.0% CH4. With these results, the flexibility of biomethanation in BTFs have been proven feasible. This study shows that biomethanation in BTFs can be integrated into any intermittent energy system and thereby is a feasible Power-2-X technology.","author_count":5,"contributors":["Jønson, Brian Dahl","Mortensen, Lars Ole Lykke","Schmidt, Jens Ejbye","Jeppesen, Martin","Bastidas-Oyanedel, Juan Rodrigo"],"cuid":["S01-000.00-573886"],"filters":{"added":"2022-09","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Schmidt, Jens Ejbye"],"keyword":["Biofuel","Biological methanation","Biomethanation","Energy systems","Intermittent feeding","Power to gas","Trickle bed reactors"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Nature Energy A/S, Odense, Denmark"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"flexibility as the key to stability optimization of temperature and gas feed during downtime towards effective integration of biomethanation in an intermittent energy system","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/en15165827","version":"Published Version"},"funding_acknowledgement":["This research was supported by the project “eFuel—Electrofuel from a bio-trickling filter”, which is a Energiteknologisk Udviklings- og Demonstrationsprogram (EUDP) project [Project ID 64018-0559]."],"id":"S01-000.00-573886","identifier":[{"id":"85137723468","type":"scopus"}],"ids":["sdu-0251a3b9-288f-4d08-ae8c-866ab9a3e5e5"],"keyword":["biofuel","biological methanation","biomethanation","energy systems","intermittent feeding","power-to-gas","trickle bed reactors"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-0A9BA42C54673D7FFE3FF5319DA7E5E8"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/205241858/energies_15_05827.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/en15165827","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Engineering, Department of Green Technology (IGT)","SDU, The Faculty of Engineering, Department of Green Technology (IGT), SDU Biotechnology"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other