e":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics, Research Unit of Sport and Health Sciences"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"4","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"May-Britt","key":"skoradalpau","last":"Skoradal","name":"Skoradal, May-Britt","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Thomas Rostgaard","key":"andersenpau","last":"Andersen","locid":"c2dce20a-35a3-4e4e-a473-dfc848b56859","name":"Andersen, Thomas Rostgaard","orcid":"0000-0002-0315-0202","rank":2,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Magni","key":"mohrpau","last":"Mohr","locid":"37cc2c61-38d7-4481-a0a6-5dc859d17113","name":"Mohr, Magni","orcid":"0000-0002-1749-8533","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jakob Friis","key":"schmidtpau","last":"Schmidt","name":"Schmidt, Jakob Friis","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Jens","key":"bangsbopau","last":"Bangsbo","name":"Bangsbo, Jens","rank":5,"rolecode":"pau"},{"affno":"","first":"Søren","key":"bennikepedh","last":"Bennike","name":"Bennike, Søren","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Thomas","key":"rostgaardandersenpedh","last":"Rostgaard Andersen","name":"Rostgaard Andersen, Thomas","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Peter","key":"krustruppedh","last":"Krustrup","name":"Krustrup, Peter","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"pages":"20-23","publisher":"Dansk Boldspil-Union","status":"p","subtitle":"En hvidbog med fokus på 10 udvalgte lidelser og risikotilstande","title":"Fodbold som forebyggelse og behandling"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-de26dc48-68a8-486a-b79e-fa6a33260e98"],"src":["SDU University of Southern Denmark"],"title":"Type-2 diabetes","type":"Report Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-766325","year":"2024","yearsub":"2024"}
{"abstract":"A significant proportion of patients who suffer from atrial fibrillation and are in need of thromboembolic protection are not treated with oral anticoagulation or discontinue this treatment shortly after its initiation. This undertreatment has not improved sufficiently despite the availability of direct oral anticoagulants which are associated with less major bleeding than vitamin K antagonists. Multiple reasons account for this, including bleeding events or ischaemic strokes whilst on anticoagulation, a serious risk of bleeding events, poor treatment compliance despite best educational attempts or aversion to drug therapy. An alternative interventional therapy, which is not associated with long-term bleeding and is as effective as vitamin K anticoagulation, was introduced over 20 years ago. Because of significant improvements in procedural safety over the years left atrial appendage closure, predominantly achieved using a catheter-based, device implantation approach, is increasingly favoured for the prevention of thromboembolic events in patients who cannot achieve effective anticoagulation. This management strategy is well-known to the interventional cardiologist/electrophysiologist but is not more widely appreciated within cardiology or internal medicine. This article introduces the devices and briefly explains the implantation technique. The indications and device follow-up are more comprehensively described. Almost all physicians who care for adult patients will have many with atrial fibrillation. This practical guide, written within guideline/guidance boundaries, is aimed at those non-implanting physicians who may need to refer patients for consideration of this new therapy, which is becoming increasingly popular.","author_count":26,"contributors":["Potpara, Tatjana","Grygier, Marek","Haeusler, Karl Georg","Nielsen-Kudsk, Jens Erik","Berti, Sergio","Genovesi, Simonetta","Marijon, Eloi","Boveda, Serge","Tzikas, Apostolos","Boriani, Giuseppe","Boersma, Lucas V. A.","Tondo, Claudio","De Potter, Tom","Lip, Gregory Y H","Schnabel, Renate B.","Bauersachs, Rupert","Senzolo, Marco","Basile, Carlo","Bianchi, Stefano","Osmancik, Pavel","Schmidt, Boris","Landmesser, Ulf","Doehner, Wolfram","Hindricks, Gerhard","Kovac, Jan","Camm, A. John"],"cuid":["S02-084.12-724394"],"filters":{"added":"2024-05","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","Europe, Non-EU","OECD"],"corresponding_author":["Camm, A. John"],"country":["Belgium","Czechia","France","Germany","Greece","Italy","Netherlands","Poland","Serbia","United Kingdom"],"glorg":["Agaplesion Markus Krankenhaus","All Global Affiliations","Amsterdam UMC","Aristotle University of Thessaloniki","Assistance publique – Hôpitaux de Paris","Athens Medical Group","Azienda Ospedaliera di Padova","Azienda USL Toscana Nord-Ovest","Cardioangiologisches Centrum Bethanien","Cardiovascular Center Aalst","Charité – Universitätsmedizin Berlin","Charles University","Clinical Center of Serbia","Clinique Pasteur Toulouse","Deutsches Herzzentrum Berlin","European Renal Association","Gabriele Monasterio Foundation","German Centre for Cardiovascular Research","Glenfield Hospital","Hopital Europeen Georges-Pompidou","Hôpital européen Georges Pompidou","IRCCS Centro Cardiologico S.P.A. Fondazione Monzino - Milano","IRCCS Istituto Auxologico Italiano - Milano","Ippokrateio General Hospital","Italian Society of Nephrology","Liverpool Centre for Cardiovascular Science","Liverpool Heart and Chest Hospital NHS Foundation Trust","Liverpool John Moores University","National Institute for Health and Care Research","OLV Hospital Aalst","Ospedale Del Cuore","Ospedale Generale Regionale \"F. Miulli\"","St. Antonius Ziekenhuis","St. George's University of London","University Hospital Kralovske","University Hospital of Modena","University Medical Center Hamburg-Eppendorf","University of Belgrade","University of Hamburg","University o