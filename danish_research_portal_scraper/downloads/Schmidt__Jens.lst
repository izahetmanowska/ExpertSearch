de":"pau"},{"affno":"","first":"K. B.","key":"schmidtpau","last":"Schmidt","name":"Schmidt, K. B.","rank":18,"rolecode":"pau"},{"affno":"","first":"B A","key":"tuckerpau","last":"Tucker","name":"Tucker, B A","rank":19,"rolecode":"pau"},{"affno":"","first":"A.","key":"vonderlindenpau","last":"von der Linden","name":"von der Linden, A.","rank":20,"rolecode":"pau"},{"affno":"","first":"Benjamin J.","key":"weinerpau","last":"Weiner","name":"Weiner, Benjamin J.","rank":21,"rolecode":"pau"},{"affno":"","first":"A.","key":"zitrinpau","last":"Zitrin","name":"Zitrin, A.","rank":22,"rolecode":"pau"}],"pub":{"doi":"10.3847/2041-8205/819/1/l8","issn":["20418205","20418213"],"issn_org":["20418205"],"issue":"1","journal":"Astrophysical Journal Letters","paperid":"L8","status":"p","title":"Astrophysical Journal Letters","title_org":"The Astrophysical Journal Letters","volume":"819"},"review":"Peer Reviewed","scoID":["2-s2.0-84960120673"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-4f6aaf62-74ec-4d4e-aef2-9f70ba80568e"],"src":["KU University of Copenhagen"],"title":"DEJA VU ALL OVER AGAIN : THE REAPPEARANCE OF SUPERNOVA REFSDAL","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-440849","year":"2016","yearsub":"2016"}
{"abstract":"AIM: To investigate the dose-response relationship of subcutaneous glucagon administration on plasma glucose and on counterregulatory hormone responses during subcutaneous insulin induced mild hypoglycaemia in patients with type 1 diabetes treated with insulin pumps. MATERIALS AND METHODS: Eight insulin pump treated patients completed a blinded, randomized, placebo-controlled study. Hypoglycaemia was induced in the fasting state by a subcutaneous insulin bolus and when plasma glucose reached 3.4 mmol/l (95%CI 3.2-3.5), a subcutaneous bolus of either 100, 200, 300 µg glucagon or saline was administered. Plasma glucose, counterregulatory hormones, haemodynamic parameters and side effects were measured throughout each study day. Peak plasma glucose was the primary endpoint. RESULTS: Plasma glucose increased significantly by 2.3(1.7-3.0), 4.2(3.5-4.8) and 5.0(4.3-5.6) mmol/l to 6.1(4.9-7.4), 7.9(6.4-9.3) and 8.7(7.8-9.5) vs 3.6(3.4-3.9) mmol/l, p < 0.001 after the three different glucagon doses as compared with saline, and the increase was neither correlated with weight nor insulin levels. Area under plasma glucose curve, peak plasma glucose, time to peak and duration of plasma glucose above baseline were significantly enhanced with increasing glucagon doses; however, not significantly different between 200 and 300 µg glucagon. Free fatty acids and heart rates were significantly lower initially after glucagon compared with saline injection. Other haemodynamic parameters, counterregulatory hormones and side effects did not differ between interventions. CONCLUSIONS: A subcutaneous low-dose glucagon bolus effectively restores plasma glucose after insulin overdosing. Further research is needed to investigate whether low-dose glucagon may be an alternative treatment to oral carbohydrate intake for mild hypoglycaemia in patients with type 1 diabetes.","author_count":5,"contributors":["Ranjan, Ajenthen","Schmidt, S","Madsbad, Sten","Holst, Jens Juul","Nørgaard, K"],"cuid":["S01-000.00-479636"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"effects of subcutaneous low dose glucagon on insulin induced mild hypoglycaemia in patients with insulin pump treated type 000000000001 diabetes","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-479636","identifier":[{"id":"84959920256","type":"scopus"},{"id":"26743775","type":"pmid"}],"ids":["ku-90402025-19a5-4b4d-9693-54890ccc1952"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-620441C15076817C0D72F0440DC15F09"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Ajenthen","key":"ranjanpau","last":"Ranjan","name":"Ranjan, Ajenthen","rank":1,"rolecode":"pau"},{"affno":"","first":"S","key":"schmidtpau","last":"Schmidt","name":"Schmidt, S","rank":2,"rolecode":"pau"},{"affno":"1","first":"Sten","key":"madsbadpau","last":"Madsbad","locid":"1018c708-245a-4057-9263-074578042385","name":"Madsbad, Sten","rank":3,"rolecode":"pau"},{"affno":"1","first":"Jens Juul","key":"holstpau","last":"Holst","locid":"864b6401-9024-4773-9bdb-f4d4ca57dcad","name":"Holst, Jens Juul","orcid":"0000-0001-6853-3805","rank":4,"rolecode":"pau"},{"affno":"","first":"K","key":"nørgaardpau","last":"Nørgaard","name":"Nørgaard, K","rank":5,"rolecode":"pau"}],"pmid":["26743775"],"pub":{"doi":"10.1111/dom.12627","issn":["14628902","14631326"],"issn_org":["14631326"],"issue":"4","journal":"Diabetes, Obesity and Metabolism","pages":"410-418","status":"p","title":"Diabetes, Obesity and Metabolism","title_org":"Diabetes, Obesity and Metabolism Online","volume":"18"},"review":"Peer Reviewed","scoID":["2-s2.0-84959920256"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-90402025-19a5-4b4d-9693-54890ccc1952"],"src":["KU University of Copenhagen"],"title":"Effects of subcutaneous, low-dose glucagon on insulin-induced mild hypoglycaemia in patients with insulin pump treated type 1 diabetes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-479636","year":"2016","yearsub":"2016"}
{"abstract":"OBJECTIVE: The role of peptide YY3-36 (PYY3-36), glucagon-like peptide-1 (GLP-1), and glucose homoeostasis in symptom development in functional dyspepsia (FD) is unclear. The aim was to investigate postprandial changes in plasma PYY3-36, GLP-1, glucose and insulin, and the relationship between PYY3-36, GLP-1, dyspeptic symptoms, and satiety measurements. MATERIALS AND METHODS: Thirty-six patients with functional dyspepsia and 18 healthy controls consumed a liquid meal at two occasions. Firstly, a fixed amount of 250 mL (300 kcal) was consumed and gastric emptying was assessed using the paracetamol method. Secondly, participants drank 75 mL (90 kcal) per five min until maximal satiety. PYY3-36, GLP-1, glucose, and insulin concentrations were assessed. Satiety measures and dyspeptic symptoms were registered using visual analogue scales. RESULTS: Gastric emptying, glucose, PYY3-36, and GLP-1 concentrations were similar in patients and controls. Patients with epigastric pain syndrome had higher postprandial insulin levels. Patients reported more satiety, nausea, and pain. Area under the curve (AUC) for GLP-1 correlated positively to nausea in patients and negatively to nausea in controls during a single meal. AUC for PYY3-36 correlated similarly to sensation of fullness in the two groups; however, the correlation was negative for the single meal and positive for the satiety test. CONCLUSIONS: In epigastric pain syndrome, postprandial insulin secretion seems to be increased. Neither GLP-1 nor PYY3-36 secretion is altered in functional dyspepsia, but postprandial GLP-1 secretion seems to correlate with nausea and PYY3-36 to the sensation of fullness, and therefore, these hormones might be involved in symptom generation.","author_count":4,"contributors":["Witte, Anne-Barbara","Hilsted, Linda","Holst, Jens Juul","Schmidt, Peter Thelin"],"cuid":["S01-000.00-540567"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"peptide yy000000000003 000000000036 and glucagon like peptide 000000000001 in functional dyspepsia secretion and role in symptom generation","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-540567","identifier":[{"id":"26503455","type":"pmid"},{"id":"84955203882","type":"scopus"}],"ids":["ku-f67cf0ca-328b-40b7-bc9f-1e547451b311"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-E3E0321D5D5B0AF4F2B1BE0084D96F9D"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Biomedical Sciences, Teaching"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Anne-Barbara","key":"wittepau","last":"Witte","name":"Witte, Anne-Barbara","rank":1,"rolecode":"pau"},{"affno":"1","first":"Linda","key":"hilstedpau","last":"Hilsted","locid":"b51cc15d-e5af-476e-b0bd-12b56481f0bd","name":"Hilsted, Linda","rank":2,"rolecode":"pau"},{"affno":"1","first":"Jens Juul","key":"holstpau","last":"Holst","locid":"864b6401-9024-4773-9bdb-f4d4ca57dcad","name":"Holst, Jens Juul","orcid":"0000-0001-6853-3805","rank":3,"rolecode":"pau"},{"affno":"","first":"Peter Thelin","key":"schmidtpau","last":"Schmidt","name":"Schmidt, Peter Thelin","rank":4,"rolecode":"pau"}],"pmid":["26503455"],"pub":{"doi":"10.3109/00365521.2015.1101780","issn":["00365521","15027708"],"issn_org":["00365521"],"issue":"4","journal":"Scandinavian Journal of Gastroenterology","pages":"400-409","status":"p","title":"Scandinavian Journal of Gastroenterology","volume":"51"},"review":"Peer Reviewed","scoID":["2-s2.0-84955203882"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-f67cf0ca-328b-40b7-bc9f-1e547451b311"],"src":["KU University of Copenhagen"],"title":"Peptide YY3-36 and glucagon-like peptide-1 in functional dyspepsia. Secretion and role in symptom generation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-540567","year":"2016","yearsub":"2016"}
{"abstract":"Aim The Arctic has experienced marked climatic differences between glacial and interglacial periods and is now subject to a rapidly warming climate. Knowledge of the effects of historical processes on current patterns of diversity may aid predictions of the responses of vegetation to future climate change. We aim to test whether plant species and genetic diversity patterns are correlated with time since deglaciation at regional and local scales. We also investigate whether species richness is correlated with genetic diversity in vascular plants. Location Circumarctic. Methods We investigated species richness of the vascular plant flora of 21 floristic provinces and examined local species richness in 6215 vegetation plots distributed across the Arctic. We assessed levels of genetic diversity inferred from amplified fragment length polymorphism variation across populations of 23 common Arctic species. Correlations between diversity measures and landscape age (time since deglaciation) as well as variables characterizing current climate were analysed using spatially explicit simultaneous autoregressive models. Results Regional species richness of vascular plants and genetic diversity were correlated with each other, and both showed a positive relationship with landscape age. Plot species richness showed differing responses for vascular plants, bryophytes and lichens. At this finer scale, the richness of vascular plants was not significantly related to landscape age, which had a small effect size compared to the models of bryophyte and lichen richness. Main conclusion Our study suggests that imprints of past glaciations in Arctic vegetation diversity patterns at the regional scale are still detectable today. Since Arctic vegetation is still limited by post-glacial migration lag, it will most probably also exhibit lags in response to current and future climate change. Our results also suggest that local species richness at the plot scale is more determined by local habitat factors","author_count":31,"contributors":["Stewart, Lærke","Alsos, Inger G.","Bay, Christian","Breen, Amy L.","Brochmann, Christian","Boulanger-Lapointe, Noémie","Broennimann, Olivier","Bültmann, Helga","Bøcher, Peder Klith","Damgaard, Christian","Daniëls, Fred J.A.","Ehrich, Dorothee","Eidesen, Pernille Bronken","Guisan, Antoine","Jónsdóttir, Ingibjörg Svala","Lenoir, Jonathan","le Roux, Peter C.","Lévesque, Esther","Luoto, Miska","Nabe-Nielsen, Jacob","Schönswetter, Peter","Tribsch, Andreas","Tveraabak, Liv Unn","Virtanen, Risto","Walker, Donald A.","Westergaard, Kristine B.","Yoccoz, Nigel G.","Svenning, Jens Christian","Wisz, Mary","Schmidt, Niels Martin","Pellissier, Loïc"],"cuid":["S01-000.00-234923"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["AFLP","Age","Arctic","Arctic plants","Bryophyte","Bryophytes","Climate","Climate change","Diversity","Future","Genetic diversity","Glaciation history","Habitat","LENGTH","Landscape","Lichen","Lichens","MODEL","MODELS","Migration","PLANT","Patterns","Plants","Population","Populations","Prediction","Responses","Richness","SCALE","SIZE","Species richness","Variation","Vascular plant","Vascular plants","Vegetation","Warming"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"the regional species richness and genetic diversity of arctic vegetation reflect both past glaciations and current climate","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84956653582","version":"Other Version"},"id":"S01-000.00-234923","identifier":[{"id":"84956653582","type":"scopus"}],"ids":["au-b9077254-2ce7-405c-985e-6d991a958a9e"],"keyword":["AFLP","Arctic plants","Bryophytes","FUTURE","