ournal":"Journal of Neuroscience","pages":"1467-1480","publisher":"Society for Neuroscience","status":"p","title":"Journal of Neuroscience","volume":"32"},"review":"Peer Reviewed","scoID":["2-s2.0-84863011338"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-bb31233b-4214-44a8-ba1e-ddc40122b1e3"],"src":["AU Aarhus University"],"title":"Retromer Binds the FANSHY Sorting Motif in SorLA to Regulate Amyloid Precursor Protein Sorting and Processing","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-236223","year":"2012","yearsub":"2012"}
{"abstract":"The addition of a biorefinery to an organic farm was investigated, where ethanol was produced from germinated rye grains and whey, and the effluent was separated into two streams: the protein-rich solid fraction, to be used as animal feed, and the liquid fraction, which can be co-digested with clover grass silage to produce biogas. A method for ethanol production from rye was applied by utilizing inherent amylase activity from germination of the seed. Biogas potential of ethanol fermentation effluent was measured through anaerobic digestion trials. The effluent from the trials was assumed to serve as natural fertilizer. A technoeconomic analysis was also performed; total capital investment was estimated to be approximately 4 M USD. Setting a methane selling price according to available incentives for “green electricity” (0.72 USD/m3) led to a minimum ethanol selling price of 1.89 USD/L (project lifetime 25 yr, at a discount rate 10%).","author_count":7,"contributors":["Oleskowicz-Popiel, Piotr","Kádár, Zsófia","Heiske, Stefan","Klein-Marcuschamer, Daniel","Simmons, Blake A.","Blanch, Harvey W.","Schmidt, Jens Ejbye"],"cuid":["S01-000.00-355537"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Joint Bioenergy Institute"],"keyword":["Bioethanol","Biogas","Organic farming","Process model","Technoeconomic analysis"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"co production of ethanol biogas protein fodder and natural fertilizer in organic farming evaluation of a concept for a farm scale biorefinery","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.biortech.2011.11.060","version":"Other Version"},"id":"S01-000.00-355537","identifier":[{"id":"22154299","type":"pmid"},{"id":"84655176342","type":"scopus"}],"ids":["dtu-aa9c43e3-d209-4ccf-89b9-10502cce5b26"],"keyword":["Bioethanol","Biogas","Organic farming","Process model","Technoeconomic analysis"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-2F03E66F8D91928F6293EBF41E308A1F"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.biortech.2011.11.060","version":"Other Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Risø National Laboratory for Sustainable Energy","Technical University of Denmark, Risø National Laboratory for Sustainable Energy, Biosystems Division","Technical University of Denmark, Risø National Laboratory for Sustainable Energy, Biosystems Division, Bioenergy and Biomass"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"us","key":"joint bioenergy institute","loc":["United States","America, North","OECD"],"name":"Joint Bioenergy Institute","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Piotr","key":"oleskowiczpopielpau","last":"Oleskowicz-Popiel","locid":"f20fe170-864a-46ab-ab59-6472bc7e9a54","name":"Oleskowicz-Popiel, Piotr","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Zsófia","key":"kádárpau","last":"Kádár","locid":"77632fb2-eb08-43a2-b320-3d9133ba2a88","name":"Kádár, Zsófia","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Stefan","key":"heiskepau","last":"Heiske","locid":"8aa98f76-9a58-4767-a4e0-9889b628d0ef","name":"Heiske, Stefan","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Dan