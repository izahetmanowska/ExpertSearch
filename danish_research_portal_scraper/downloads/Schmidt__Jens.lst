t":"Anderson","name":"Anderson, Jordan A","rank":13,"rolecode":"pau"},{"affno":"12","corresponding":null,"first":"Ryan","key":"gagepau","last":"Gage","name":"Gage, Ryan","rank":14,"rolecode":"pau"},{"affno":"13","corresponding":null,"first":"Mohamad","key":"alkhoulipau","last":"Alkhouli","name":"Alkhouli, Mohamad","rank":15,"rolecode":"pau"},{"affno":"14","corresponding":null,"first":"Stephan","key":"windeckerpau","last":"Windecker","name":"Windecker, Stephan","rank":16,"rolecode":"pau"}],"pmid":["37587599"],"pub":{"doi":"10.1016/j.jcin.2023.06.022","issn":["18767605","19368798"],"issn_org":["19368798"],"issue":"15","journal":"JACC: Cardiovascular Interventions","pages":"1902-1913","publisher":"Elsevier Inc.","status":"p","title":"JACC: Cardiovascular Interventions","title_org":"JACC. Cardiovascular interventions","volume":"16"},"review":"Peer Reviewed","scoID":["2-s2.0-85166968806"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-0848cba3-10fc-4840-b614-9dae894ef97a"],"src":["AU Aarhus University"],"title":"3-Year Outcomes From the Amplatzer Amulet Left Atrial Appendage Occluder Randomized Controlled Trial (Amulet IDE)","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-682161","year":"2023","yearsub":"2023"}
{"abstract":"BACKGROUND: Atrial fibrillation is the most common cardiac arrhythmia and a major global health burden. Updated trends in the epidemiology of atrial fibrillation or flutter (AF) are needed. METHODS: Using the Danish Heart Statistics, we investigated nationwide trends 2009-2018 in incidence rate and prevalence of AF according to age as well as age-standardized incidence rate (ASIR) and prevalence (ASP) of AF according to sex, ethnicity, educational level, and area of residence. Comparing year 2018 to 2009, we calculated stratum-specific ASIR ratios (ASIRR) and changes in ASP. RESULTS: During 2009-2015 the ASIR for AF increased for both men and women, followed by a decline from 2015-2018. Overall, this resulted in a 9% increase among men (ASIRR: 1.09, 95% CI: 1.06-1.12), but no change among women (ASIRR: 1.00, 95% CI: 0.97-1.04). The ASP increased by 29% among men and 26% among women. An increase in ASIR was observed in all ethnic groups except men of Far Eastern ethnicity. Lower educational level was associated with greater increases in both ASIR and ASP. ASIR and ASP differed slightly between the Danish regions but increased in all of them. CONCLUSIONS: During 2009-2018 the incidence and prevalence of AF in Denmark increased although the increase in incidence was transient among women. Factors associated with higher incidence were male sex, higher age, Danish and Western ethnicity as well as Middle Eastern/North African ethnicity among women, and lower educational level. Within Denmark, we observed only minor regional differences in AF incidence and prevalence.","author_count":4,"contributors":["Brodersen, Katrine D.","Heide-Jørgensen, Uffe","Nielsen, Jens Cosedis","Schmidt, Morten"],"cuid":["S01-000.00-682882"],"filters":{"added":"2023-09","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Brodersen, Katrine D."],"keyword":["Atrial fibrillation","Atrial flutter","Incidence","Prevalence"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"ten year trends in incidence and prevalence of atrial fibrillation and flutter in denmark according to demographics ethnicity educational level and area of residence 000000002009 000000002018","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85178105324","version":"Other Version"},"id":"S01-000.00-682882","identifier":[{"id":"85178105324","type":"scopus"},{"id":"37389567","type":"pmid"}],"ids":["au-eb116121-35b2-4cd3-a5a0-e338de8f1b6c"],"keyword":["Atrial fibrillation","Atrial flutter","Incidence","Prevalence"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-C25819EE4EA0F631B1376068F8A89FC6"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Clinical Epidemiology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Katrine D","key":"brodersenpau","last":"Brodersen","locid":"ba6d8e8d-3d3c-4d21-992d-af620b2ac123","name":"Brodersen, Katrine D.","name_org":"Brodersen, Katrine D","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Uffe","key":"heidejørgensenpau","last":"Heide-Jørgensen","locid":"479434ec-1af2-40c1-aa15-f8cffb811e2d","name":"Heide-Jørgensen, Uffe","orcid":"0000-0002-8407-4618","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens C","key":"nielsenpau","last":"Nielsen","locid":"cc1c8be7-f54a-4722-8077-aa358f9b090a","name":"Nielsen, Jens Cosedis","name_org":"Nielsen, Jens C","orcid":"0000-0001-9414-1653","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Morten","key":"schmidtpau","last":"Schmidt","locid":"21e3a3e6-e25e-48cf-b243-b8f43dca3bb8","name":"Schmidt, Morten","orcid":"0000-0002-4935-4059","rank":4,"rolecode":"pau"}],"pmid":["37389567"],"pub":{"doi":"10.23736/s2724-5683.23.06299-3","issn":["27245683","27245772"],"issn_org":["27245683"],"issue":"6","journal":"Minerva Cardiology and Angiology","pages":"681-691","publisher":"Edizioni Minerva Medica S.p.A.","status":"p","title":"Minerva Cardiology and Angiology","volume":"71"},"review":"Peer Reviewed","scoID":["2-s2.0-85178105324"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-eb116121-35b2-4cd3-a5a0-e338de8f1b6c"],"src":["AU Aarhus University"],"title":"Ten-year trends in incidence and prevalence of atrial fibrillation and flutter in Denmark according to demographics, ethnicity, educational level, and area of residence (2009-2018)","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-682882","year":"2023","yearsub":"2023"}
{"abstract":"This paper shows how causes and mechanisms behind past information technology (IT) project failures can be used for systematic risk mitigation in new IT projects. This is significant because successful IT projects are needed to realise the benefit potential of digitalisation, whereas failed IT projects overspend resources and underdeliver benefits. In this paper we a) identify factors and causes that lead to IT project failure, b) analyse the consistency over time of the identified factors and causes, c) expose mechanisms of failure by analysing failure factors, causes, and common features of IT projects, and d) show how this knowledge can be used in IT project risk evaluations. The paper uses hermeneutic literature review, statistical analysis of failure factors in the literature, content analysis of the reviewed literature, and process tracing.","author_count":1,"contributors":["Schmidt, Jens"],"cuid":["S01-000.00-695243"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"keyword":["Information technology","Project Risk","Project failure","Project management"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"mitigating risk of failure in information technology projects causes and mechanisms","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.plas.2023.100097","version":"Published Version"},"id":"S01-000.00-695243","identifier":[{"id":"85170414623","type":"scopus"}],"ids":["itu-4c11a491-bc5a-4348-8983-8aa7203784f5"],"keyword":["Information Technology","Project Management","Project Risk","project failure"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-10D5805B56B597A2F6CA9E21B782B5DD"],"oa_link":[{"access":"oa","type":"rem","url":"https://authors.elsevier.com/sd/article/S2666-7215(23)00018-2","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.plas.2023.100097","version":"Published Version"},{"access":"oa","type":"rem","url":"https://www.sciencedirect.com/science/article/pii/S2666721523000182/pdfft?md5=1b6b135a71b96e8a237e85c45d986e08&pid=1-s2.0-S2666721523000182-main.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Danish Institute for IT Program Management","IT University of Copenhagen, Research Centre for Government IT"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jens","key":"schmidtpau","last":"Schmidt","locid":"e0edf6ca-5a14-41d8-81cc-77fd67f03ee5","name":"Schmidt, Jens","orcid":"0000-0002-2500-0467","rank":1,"rolecode":"pau"}],"pub":{},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"]},"sid":["itu-4c11a491-bc5a-4348-8983-8aa7203784f5"],"src":["ITU IT University of Copenhagen"],"title":"Mitigating risk of failure in information technology projects: Causes and mechanisms","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-695243","year":"2023","yearsub":"2023"}
{"abstract":"BACKGROUND: The Danish head and neck cancer fast-track program is a national standardized pathway aiming to reduce waiting time and improve survival for patients suspected of cancer in the head and neck (HNC). Until now, the frequency of missed cancer in the fast-track program has not been addressed. A missed cancer leads to treatment delay and may cause disease progression and worsening of prognosis. The study objective was to estimate the frequency of patients with missed cancers in the Danish HNC fast-track program and to evaluate the accuracy of the program. MATERIALS AND METHODS: Patients who were rejected from the HNC fast-track program because cancer was not found between 1 July 2012 and 31 December 2018 at Odense University Hospital, Denmark were included and followed for three years. Patients were categorized into groups depending on the diagnostic evaluation. Group 1 included patients evaluated with standard clinical work-up without imaging and biopsy. Group 2 included patients evaluated with imaging and/or biopsy in addition to the standard clinical work-up. The local cancer database and electronic patient records were reviewed to determine if a missed cancer had occurred within the follow-up period. RESULTS: A total of 8345 HNC fast-track courses were initiated during the study period. 1499 were patients suspected of recurrent cancer and were excluded leaving 6846 patients to be assessed for eligibility. Of these, 3752 patients were rejected because cancer was not found. Ten patients were subsequently diagnosed with cancer within the follow-up period resulting in an overall frequency of 0.15%. For group 1 and 2, the frequency was 0.04% and 0.10%, respectively. The sensitivity of the fast-track program was 99.67% and the negative predictive value was 99.73%. CONCLUSION: The frequency of missed cancer in a tertiary HNC center following the Danish fast track program is low.","author_count":6,"contributors":["Schmidt, Ida Grunske","Korsholm, Malene","Johansen, Jørgen","Sørensen, Jens Ahm","Godballe, Christian","Bjørndal, Kristine"],"cuid":["S01-000.00-697160"],"filters":{"added":"2023-11","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Schmidt, Ida Grunske"],"keyword":["Denmark epidemiology","Head and Neck Neoplasms diagnosis","Humans","Neoplasm Recurrence Local"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"missed cancer in the danish head and neck cancer fast track program results from a tertiary cancer center","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/236511505/Accpeted_Manuscript.pdf","version":"Authors Final Version"},"id":"S01-000.00-697160","identifier":[{"id":"37493617","type":"pmid"},{"id":"85166000517","type":"scopus"}],"ids":["sdu-7369a388-2e8e-45d1-a236-59a27af51518"],"keyword":["Denmark/epidemiology","Head and Neck Neoplasms/diagnosis","Humans","Neoplasm Recurrence, Local"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-266F95DF434354057B616663D1910D70"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/236511505/Accpeted_Manuscript.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Oto Rhino Laryngology (Odense)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Ida Grunske","key":"schmidtpau","last":"Schmidt","locid":"fa93b6a1-3808-4953-bd83-57762c96b279","name":"Schmidt, Ida Grunske","orcid":"0000-0003-1490-0432","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Malene","key":"korsholmpau","last":"Korsholm","locid":"df3120e4-0ac0-49e8-9742-de81ff60b8b6","name":"Korsholm, Malene","orcid":"0000-0002-9273-556X","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jørgen","key":"johansenpau","last":"Johansen","locid":"7b9ef019-61d4-4b88-8109-5745bf524ada","name":"Johansen, Jørgen","orcid":"0000-0003-3911-3929","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens Ahm","key":"sørensenpau","last":"Sørensen","locid":"267cd59a-3918-47db-8d23-54015d770b6c","name":"Sørensen, Jens Ahm","orcid":"0000-0003-4903-0094","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christian","key":"godballepau","last":"Godballe","locid":"ff9e9b81-947f-4b49-be93-3467ee6937e3","name":"Godballe, Christian","orcid":"0000-0001-7639-6337","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kristine","key":"bjørndalpau","last":"Bjørndal","locid":"3f3f0a57-b46d-4012-8152-eabdc6fbc914","name":"Bjørndal, Kristine","orcid":"0000-0003-3840-7861","rank":6,"rolecode":"pau"}],"pmid":["37493617"],"pub":{"doi":"10.1080/0284186x.2023.2238552","issn":["0284186X","11001704"],"issn_org":["0284186X"],"issue":"8","journal":"Acta Oncologica","pages":"836-841","publisher":"Medical Journals Sweden AB","status":"p","title":"Acta Oncologica","volume":"62"},"review":"Peer Reviewed","scoID":["2-s2.0-85166000517"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-7369a388-2e8e-45d1-a236-59a27af51518"],"src":["SDU University of Southern Denmark"],"title":"Missed cancer in the Danish head and neck cancer fast-track program : results from a tertiary cancer center","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-697160","year":"2023","yearsub":"2023"}
{"abstract":"A physiological feedback system exists between hepatocytes and the alpha cells, termed the liver-alpha cell axis and refers to the relationship between amino acid-stimulated glucagon secretion and glucagon-stimulated amino acid catabolism. Several reports indicate that non-alcoholic fatty liver disease (NAFLD) disrupts the liver-alpha cell axis, because of impaired glucagon receptor signaling (glucagon resistance). However, no experimental test exists to assess glucagon resistance in humans. The objective was to develop an experimental test to determine glucagon sensitivity with respect to amino acid and glucose metabolism in humans. The proposed glucagon sensitivity test (comprising two elements: 1) i.v. injection of 0.2 mg glucagon and 2) infusion of mixed amino acids 331 mg/hour/kg) is based on nine pilot studies which are presented. Calculation of a proposed glucagon sensitivity index with respect to amino acid catabolism is also described. Secondly, we describe a complete study protocol (GLUSENTIC) according to which the glucagon sensitivity test will be applied in a cross-sectional study currently taking place. 65 participants including 20 individuals with a BMI 18.6–25 kg/m2, 30 individuals with a BMI ≥ 25–40 kg/m2, and 15 individuals with type 1 diabetes with a BMI between 18.6 and 40 kg/m2 will be included. Participants will be grouped according to their degree of hepatic steatosis measured by whole-liver magnetic resonance imaging (MRI). The primary outcome measure will be differences in the glucagon sensitivity index between individuals with and without hepatic steatosis. Developing a glucagon sensitivity test and index may provide insight into the physiological and pathophysiological mechanism of glucagon action and glucagon-based therapies.","author_count":21,"contributors":["Kjeldsen, Sasha A.S.","Richter, Michael M.","Jensen, Nicole J.","Nilsson, Malin S.D.","Heinz, Niklas","Nybing, Janus D.","Linden, Frederik H.","Høgh-Schmidt, Erik","Boesen, Mikael","Madsbad, Sten","Vilstrup, Hendrik","Schiødt, Frank Vinholt","Møller, Andreas","Nørgaard, Kirsten","Schmidt, Signe","Rashu, Elias B.","Gluud, Lise Lotte","Haugaard, Steen Bendix","Holst, Jens Juul","Rungby, Jørgen","Wewer Albrechtsen, Nicolai J"],"cuid":["S02-100.00-021183"],"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Wewer Albrechtsen, Nicolai J."],"keyword":["Amino acids","Glucagon","Metabolism","NAFLD","Study protocol","The liver alpha cell axis","Type 1 diabetes"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-STENO"],"OT":["Steno Diabetes Centre, Gentofte, Denmark."],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-HO-STENO","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"development of a glucagon sensitivity test in humans pilot data and the glusentic study protocol","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.peptides.2022.170938","version":"Published Version"},"id":"S02-100.00-021183","identifier":[{"id":"000920274000001","type":"wos"},{"id":"85145843295","type":"scopus"},{"id":"36596314","type":"pmid"}],"ids":["au-747b7db4-ffca-402a-9e23-693d4956b3dc","ku-252e691e-fad6-44fe-9e23-6053a6a806b1"],"keyword":["Amino acids","Glucagon","Metabolism","NAFLD","Study protocol","The liver-alpha cell axis","Type 1 diabetes"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-FBBA0EE351360BCF6895A074307EA0B2"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://pure.au.dk/ws/files/407760210/1-s2.0-S0196978122002042-main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":