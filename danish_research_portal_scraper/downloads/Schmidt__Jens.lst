],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Roskilde University","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-6af2a742-d454-4240-b465-e5a750113604","ruc-acda460a-c0ea-48ce-b206-4928d60ebef0","sdu-bd0d626c-c06a-45f3-9dd8-485d8db53c67"],"src":["KU University of Copenhagen","RUC Roskilde University","SDU University of Southern Denmark"],"title":"Integrative Genomics Outlines a Biphasic Glucose Response and a ChREBP-RORγ Axis Regulating Proliferation in β Cells","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-097.28-043190","year":"2016","yearsub":"2016"}
{"abstract":"OBJECTIVE: Renal transplant recipients (RTR) suffer high rates of bone loss and increased risk of fracture. Marine n-3 polyunsaturated fatty acids (n-3 PUFA), found mainly in fish and seafood, may have beneficial effects on bone and are positively associated with bone mineral density (BMD) in healthy elderly. The aim of this study was to investigate if this association prevails despite the more complex causes of bone loss in RTR. DESIGN, SUBJECTS, AND METHODS: A total of 701 RTR were included in a cross-sectional analysis. BMD of lumbar spine, proximal femur, and distal forearm were measured by dual energy x-ray absorptiometry scan, and blood samples were drawn in the fasting state for measurement of plasma fatty acid composition 10 weeks posttransplant. Multiple linear regression analysis was used to assess the association between plasma marine n-3 PUFA levels and BMD. RESULTS: Mean age was 52.2 years, and two-thirds were men. Based on femoral neck T-scores, 26% of patients were osteoporotic and 52% osteopenic. Z-scores increased significantly across quartiles of marine n-3 PUFA levels, and marine n-3 PUFA was a positive predictor of BMD at total hip and lumbar spine after multivariate adjustment. No association was found between n-6 PUFA content and BMD. CONCLUSIONS: Plasma marine n-3 PUFA levels were positively associated with BMD at the hip and lumbar spine 10 weeks posttransplant.","author_count":9,"contributors":["Jørgensen, Hanne Skou","Eide, Ivar Anders","Hartmann, Anders","Åsberg, Anders","Christensen, Jeppe Hagstrup","Schmidt, Erik Berg","Godang, Kristin","Bollerslev, Jens","Svensson, My"],"cuid":["S01-000.00-072155"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","Nordic","OECD"],"country":["Norway"],"glorg":["Akershus University Hospital","All Global Affiliations"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-HO-CDR","DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"plasma n 000000000003 polyunsaturated fatty acids and bone mineral density in renal transplant recipients","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-072155","identifier":[{"id":"84954305580","type":"scopus"},{"id":"26776249","type":"pmid"},{"id":"000377983600012","type":"wos"}],"ids":["aau-4c3e8ae4-9b81-4841-a4ef-b4cd84cece41"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-1DEB247B17E41A62B00DFFA63A7E7194"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Medicin","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Nyremedicin (Nefrologi) [Klinik Medicin]"],"nora_code":"DI-U-AAU","used":1},{"affno":"3","country":"no","key":"akershus university hospital","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"Akershus University Hospital","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Hanne Skou","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, Hanne Skou","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Ivar Anders","key":"eidepau","last":"Eide","name":"Eide, Ivar Anders","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Anders","key":"hartmannpau","last":"Hartmann","name":"Hartmann, Anders","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Anders","key":"åsbergpau","last":"Åsberg","name":"Åsberg, Anders","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jeppe Hagstrup","key":"christensenpau","last":"Christensen","locid":"8b0514a3-d3aa-4fa6-acd2-2d32e219593f","name":"Christensen, Jeppe Hagstrup","orcid":"0000-0003-1208-833X","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Erik Berg","key":"schmidtpau","last":"Schmidt","locid":"3eff6ccc-90b4-48ee-b121-8df4865f0342","name":"Schmidt, Erik Berg","orcid":"0000-0002-0623-5666","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Kristin","key":"godangpau","last":"Godang","name":"Godang, Kristin","rank":7,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jens","key":"bollerslevpau","last":"Bollerslev","name":"Bollerslev, Jens","rank":8,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"My","key":"svenssonpau","last":"Svensson","name":"Svensson, My","rank":9,"rolecode":"pau"}],"pmid":["26776249"],"pub":{"doi":"10.1053/j.jrn.2015.11.007","issn":["10512276","15328503"],"issn_org":["10512276"],"issue":"3","journal":"Journal of Renal Nutrition","pages":"196-203","publisher":"WB  Saunders","publisher_org":"W.B. Saunders","status":"p","title":"Journal of Renal Nutrition","volume":"26"},"review":"Peer Reviewed","scoID":["2-s2.0-84954305580"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities"],"PST":["Published"]},"sid":["aau-4c3e8ae4-9b81-4841-a4ef-b4cd84cece41"],"src":["AAU Aalborg University"],"title":"Plasma n-3 Polyunsaturated Fatty Acids and Bone Mineral Density in Renal Transplant Recipients","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-072155","year":"2016","yearsub":"2016"}
{"abstract":"Objective Antithrombotic drugs are widely used in the prevention and treatment of cardiovascular diseases; yet, nationwide long-term usage trends remain unexplored. We examined long-term trends in the use of antithrombotic drugs in Denmark. Methods Using nationwide prescription data, we obtained information on primary care use of antiplatelet drugs, vitamin K antagonists (VKA), non-vitamin K antagonist oral anticoagulants (NOAC), heparins and fondaparinux during 1999-2014. Results During the 16-year period, the use of antithrombotic drugs per 1000 inhabitants/day increased from 64 to 96 defined daily doses (DDD), and the prevalence proportion of users doubled from 5.1% to 9.6% of the Danish population. From 1999 to 2014, there was an increased use of both antiplatelet drugs (from 60 to 79 DDD per 1000 inhabitants/day) and VKA (from 4 to 9 DDD per 1000 inhabitants/day). NOAC was marketed in 2008 and had an abrupt rise in use to 8 DDD per 1000 inhabitants/day in 2014. The use of heparins and fondaparinux increased slightly during the study period (from 0 to 0.6 DDD per 1000 inhabitants/ day). Hospital use of antithrombotic drugs also increased during the study period, but constituted a minor part of the total use (4 DDD per 1000 inhabitants/day in 2014). Conclusions Considerable changes have occurred in the use of antithrombotic drugs during the past 16 years, including the introduction of several new and increasingly used treatment modalities such as NOAC. The trends in use of individual drugs correlate well with the publication of landmark studies.","author_count":5,"contributors":["Adelborg, Kasper","Grove, Erik Lerkevang","Sundbøll, Jens","Laursen, Maja","Schmidt, Morten"],"cuid":["S01-000.00-182545"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Adelborg, Kasper"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Danish Health Authority"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"sixteen year nationwide trends in antithrombotic drug use in denmark and its correlation with landmark studies","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84978795784","version":"Other Version"},"id":"S01-000.00-182545","identifier":[{"id":"27406838","type":"pmid"},{"id":"84978795784","type":"scopus"}],"ids":["au-5d3e7d3a-27e1-414f-87a4-933aa7821f50"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-274189B6170CE14A66BE076A95944326"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Clinical Epidemiology","Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Cardiological Medicine B"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Danish Health Authority"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Kasper","key":"adelborgpau","last":"Adelborg","locid":"2744cdbf-8516-46f6-ad71-f99fee1afaa0","name":"Adelborg, Kasper","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Erik Lerkevang","key":"grovepau","last":"Grove","locid":"f527f99e-8eed-433e-923e-afc0686af8b7","name":"Grove, Erik Lerkevang","orcid":"0000-0002-1466-0865","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens","key":"sundbøllpau","last":"Sundbøll","locid":"47396c7b-4f59-4aef-9cb1-0c63a6a8bbe2","name":"Sundbøll, Jens","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Maja","key":"laursenpau","last":"Laursen","name":"Laursen, Maja","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Morten","key":"schmidtpau","last":"Schmidt","locid":"21e3a3e6-e25e-48cf-b243-b8f43dca3bb8","name":"Schmidt, Morten","orcid":"0000-0002-4935-4059","rank":5,"rolecode":"pau"}],"pmid":["27406838"],"pub":{"doi":"10.1136/heartjnl-2016-309402","issn":["13556037","1468201X"],"issn_org":["13556037"],"issue":"23","journal":"Heart","pages":"1883-1889","publisher":"BMJ Publishing Group","status":"p","title":"Heart","volume":"102"},"review":"Peer Reviewed","scoID":["2-s2.0-84978795784"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-5d3e7d3a-27e1-414f-87a4-933aa7821f50"],"src":["AU Aarhus University"],"title":"Sixteen-year nationwide trends in antithrombotic drug use in Denmark and its correlation with landmark studies","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-182545","year":"2016","yearsub":"2016"}
{"abstract":"OBJECTIVE: Danish medical registries are widely used for cardiovascular research, but little is known about the data quality of cardiac interventions. We computed positive predictive values (PPVs) of codes for cardiac examinations, procedures and surgeries registered in the Danish National Patient Registry during 2010-2012. DESIGN: Population-based validation study. SETTING: We randomly sampled patients from 1 university hospital and 2 regional hospitals in the Central Denmark Region. PARTICIPANTS: 1239 patients undergoing different cardiac interventions. MAIN OUTCOME MEASURE: PPVs with medical record review as reference standard. RESULTS: A total of 1233 medical records (99% of the total sample) were available for review. PPVs ranged from 83% to 100%. For examinations, the PPV was overall 98%, reflecting PPVs of 97% for echocardiography, 97% for right heart catheterisation and 100% for coronary angiogram. For procedures, the PPV was 98% overall, with PPVs of 98% for thrombolysis, 92% for cardioversion, 100% for radiofrequency ablation, 98% for percutaneous coronary intervention, and 100% for both cardiac pacemakers and implantable cardiac defibrillators. For cardiac surgery, the overall PPVs was 99%, encompassing PPVs of 100% for mitral valve surgery, 99% for aortic valve surgery, 98% for coronary artery bypass graft surgery, and 100% for heart transplantation. The accuracy of coding was consistent within age, sex, and calendar year categories, and the agreement between independent reviewers was high (99%). CONCLUSIONS: Cardiac examinations, procedures and surgeries have high PPVs in the Danish National Patient Registry.","author_count":7,"contributors":["Adelborg, Kasper","Sundbøll, Jens","Munch, Troels","Frøslev, Trine","Sørensen, Henrik Toft","Bøtker, Hans Erik","Schmidt, Morten"],"cuid":["S01-000.00-220122"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"positive predictive value of cardiac examination procedure and surgery codes in the danish national patient registry a population based validation study","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85006049388","version":"Other Version"},"id":"S01-000.00-220122","identifier":[{"id":"85006049388","type":"scopus"},{"id":"27940630","type":"pmid"},{"id":"PMC5168662","type":"pmcid"}],"ids":["au-9f64fdb0-592c-468d-886a-c5a7ce7ec1a1"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-DABC56162DC2A7C549047B266E05649A"],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Clinical Epidemiology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Kasper","key":"adelborgpau","last":"Adelborg","locid":"2744cdbf-8516-46f6-ad71-f99fee1afaa0","name":"Adelborg, Kasper","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens","key":"sundbøllpau","last":"Sundbøll","locid":"47396c7b-4f59-4aef-9cb1-0c63a6a8bbe2","name":"Sundbøll, Jens","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Troels","key":"munchpau","last":"Munch","locid":"be4c9cfd-2716-42a4-8ee8-a71396043009","name":"Munch, Troels","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Trine","key":"frøslevpau","last":"Frøslev","locid":"796f4ce4-c427-483a-a529-89ba3e66e284","name":"Frøslev, Trine","orcid":"0000-0003-1594-9959","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik Toft","key":"sørensenpau","last":"Sørensen","locid":"4d49d93a-4913-4223-ba59-272e717a845d","name":"Sørensen, Henrik Toft","orcid":"0000-0003-4299-7040","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Hans Erik","key":"bøtkerpau","last":"Bøtker","locid":"09b03c00-11a8-4f72-800f-181f26155750","name":"Bøtker, Hans Erik","orcid":"0000-0001-6358-8962","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Morten","key":"schmidtpau","last":"Schmidt","locid":"21e3a3e6-e25e-48cf-b243-b8f43dca3bb8","name":"Schmidt, Morten","orcid":"0000-0002-4935-4059","rank":7,"rolecode":"pau"}],"pmid":["27940630"],"pub":{"doi":"10.1136/bmjopen-2016-012817","issn":["20446055"],"issue":"12","journal":"BMJ Open","paperid":"e012817","publisher":"BMJ Publishing Group","status":"p","title":"BMJ Open","volume":"6"},"review":"Peer Reviewed","scoID":["2-s2.0-85006049388"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-9f64fdb0-592c-468d-886a-c5a7ce7ec1a1"],"src":["AU Aarhus University"],"title":"Positive predictive value of cardiac examination, procedure and surgery codes in the Danish National Patient Registry : a population-based validation study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-220122","year":"2016","yearsub":"2016"}
{"abstract":"BACKGROUND AND PURPOSE: Improved survival after myocardial infarction (MI) has increased the number of patients at risk of post-MI stroke. We examined risks of ischemic stroke, intracerebral hemorrhage (ICH), and subarachnoid hemorrhage (SAH) in patients with MI compared with the general population. METHODS: We conducted a nationwide population-based cohort study using Danish medical registries. During 1980 to 2009, we identified all patients with a first-time inpatient diagnosis of MI and formed a sex- and age-matched comparison cohort. We computed cumulative stroke risks and adjusted stroke rate ratios with 95% confidence intervals (CIs). RESULTS: We identified 258 806 patients with an MI and 1 244 773 individuals from the general population. For patients with MI, the cumulative stroke risks after 1 to 30 years were 12.6% for ischemic stroke, 1.2% for ICH, and 0.24% for SAH. During the first 30 days after MI, the adjusted stroke rate ratio was 30-fold increased for ischemic stroke (31.9; 95% CI, 28.4-35.8), 20-fold for ICH (21.8; 95% CI, 16.6-28.5), and 15-fold for SAH (16.6; 95% CI, 8.7-32.0). The adjusted stroke rate ratio remained increased during 31 to 365 days (3-fold for ischemic stroke, 2-fold for ICH, and 1.5-fold for SAH). During the ensuing 1 to 30 years, the risks remained increased for ischemic stroke (1.6; 95% CI, 1.6-1.6) but decreased to near unity for ICH (1.1; 95% CI, 1.0-1.2) and SAH (1.1; 95% CI, 0.94-1.2). CONCLUSIONS: MI was a risk factor for all stroke subtypes during the first year of follow-up, but only for ischemic stroke thereafter.","author_count":7,"contributors":["Sundbøll, Jens","Horváth-Puhó, Erzsébet","Schmidt, Morten","Pedersen, Lars","Henderson, Victor W","Bøtker, Hans Erik","Sørensen, Henrik Toft"],"cuid":["S01-000.00-274671"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Myocardial Infarction","Risk factor","Stroke","Subarachnoid hemorrhage"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"long term risk of stroke in myocardial infarction survivors thirty year population based cohort study","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84974815620","version":"Other Version"},"id":"S01-000.00-274671","identifier":[{"id":"27301935","type":"pmid"},{"id":"84974815620","type":"scopus"}],"ids":["au-feb41f2f-c133-4077-9235-20af5cfa9fce"],"keyword":["myocardial infarction","risk factor","stroke","subarachnoid hemorrhage"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-7869838A804150C099245D7E93BC3CBA"],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Clinical Epidemiology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jens","key":"sundbøllpau","last":"Sundbøll","locid":"47396c7b-4f59-4aef-9cb1-0c63a6a8bbe2","name":"Sundbøll, Jens","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Erzsébet","key":"horváthpuhópau","last":"Horváth-Puhó","locid":"20f5c6bd-6ac1-4edb-a393-f34d60db546c","name":"Horváth-Puhó, Erzsébet","orcid":"0000-0002-3594-2212","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Morten","key":"schmidtpau","last":"Schmidt","locid":"21e3a3e6-e25e-48cf-b243-b8f43dca3bb8","name":"Schmidt, Morten","orcid":"0000-0002-4935-4059","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars","key":"pedersenpau","last":"Pedersen","locid":"a0fdd247-3fb1-4c38-a1b2-f37d89f8f5c9","name":"Pedersen, Lars","orcid":"0000-0002-9341-3888","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Victor W","key":"hendersonpau","last":"Henderson","locid":"a6c3676e-d457-47df-8395-54e559a6c4c6","name":"Henderson, Victor W","orcid":"0000-0003-1198-9240","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Hans Erik","key":"bøtkerpau","last":"Bøtker","locid":"09b03c00-11a8-4f72-800f-181f26155750","name":"Bøtker, Hans Erik","orcid":"0000-0001-6358-8962","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik Toft","key":"sørensenpau","last":"Sørensen","locid":"4d49d93a-4913-4223-ba59-272e717a845d","name":"Sørensen, Henrik Toft","orcid":"0000-0003-4299-7040","rank":7,"rolecode":"pau"}],"pmid":["27301935"],"pub":{"doi":"10.1161/strokeaha.116.013321","issn":["00392499","15244628"],"issn_org":["00392499"],"issue":"7","journal":"Stroke","pages":"1727-33","publisher":"Wolters Kluwer Health","status":"p","title":"Stroke","volume":"47"},"review":"Peer Reviewed","scoID":["2-s2.0-84974815620"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-feb41f2f-c133-4077-9235-20af5cfa9fce"],"src":["AU Aarhus University"],"title":"Long-Term Risk of Stroke in Myocardial Infarction Survivors : Thirty-Year Population-Based Cohort Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-274671","year":"2016","yearsub":"2016"}
{"abstract":"In an effort to understand recent results showing differences between the power conversion efficiencies of lead halide (CH3NH3PbI3-xClx) solar cells on glass versus flexible substrates, this study investigates the influence that substrate and processing methods have on morphological and crystallographic development. Using our in situ slot-die micro roll-to-roll coater setup, we measured small and wide angle X-ray scattering in grazing incidence while the material dried, enabling us to follow the crystallization from just after the deposition and up to 25 minutes later. The data showed differing crystallographic developments between the substrates, especially seen through the behaviour of a crystalline precursor which survived longer on the flexible substrates than on glass. Additionally, the common degradation product PbI2 was absent on the thickest flexible substrate. This leads us to conjecture that the flexible substrates absorb part of the solvent, thereby delaying evaporation and changing the solvent environment around the perovskite. As a further test, we produced solar cells with the same substrates and confirmed that the ones made on flexible substrates performed worse than those made on glass, but that when including an ITO layer in the stack it seemed to act as a buffer, whereby the solar cell performance was improved.","author_count":9,"contributors":["Rossander, Lea Hildebrandt","Larsen-Olsen, Thue Trofod","Dam, Henrik Friis","Schmidt, Thomas Mikael","Corazza, Michael","Norrman, Kion","Rajkovic, Ivan","Andreasen, Jens Wenzel","Krebs, Frederik C"],"cuid":["S01-000.00-307722"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["Switzerland"],"glorg":["All Global Affiliations","Paul Scherrer Institute"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"i in situ i x ray scattering of perovskite solar cell active layers roll to roll coated on flexible substrates","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84978998654","version":"Other Version"},"id":"S01-000.00-307722","identifier":[{"id":"84978998654","type":"scopus"}],"ids":["dtu-0a5bb7f5-fb05-44fe-a7db-3f0a3c2c4a2c"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-DBE991CC37ED27FF8029261E01CC117F"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Energy Conversion and Storage","Technical University of Denmark, Department of Energy Conversion and Storage, Functional organic materials"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"ch","key":"paul scherrer institute","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"Paul Scherrer Institute","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Lea Hildebrandt","key":"rossanderpau","last":"Rossander","locid":"8d6d03ca-8be3-4599-ba6c-2715e2652876","name":"Rossander, Lea Hildebrandt","orcid":"0000-0003-1628-9104","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thue T.","key":"larsenolsenpau","last":"Larsen-Olsen","locid":"e03ae801-6940-4a24-b4a7-b23383928558","name":"Larsen-Olsen, Thue Trofod","name_org":"Larsen-Olsen, Thue T.","orcid":"0000-0001-5373-898X","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik Friis","key":"dampau","last":"Dam","locid":"1765cec1-6a56-4ea5-9e7f-5dc2db4436d6","name":"Dam, Henrik Friis","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Thomas Mikael","key":"schmidtpau","last":"Schmidt","locid":"56855374-d6cb-48d0-96d1-fba082e679f8","name":"Schmidt, Thomas Mikael","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Michael","key":"corazzapau","last":"Corazza","locid":"42ba8ec2-b08a-42da-8a63-cd7c5c44e1b1","name":"Corazza, Michael","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kion","key":"norrmanpau","last":"Norrman","locid":"3552d84a-7edf-4903-8e52-175fabe4e109","name":"Norrman, Kion","orcid":"0000-0001-9355-7569","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ivan","key":"rajkovicpau","last":"Rajkovic","name":"Rajkovic, Ivan","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens Wenzel","key":"andreasenpau","last":"Andreasen","locid":"c838d5f7-f708-47d2-a9f4-c4c12e5c7c2d","name":"Andreasen, Jens Wenzel","orcid":"0000-0002-3145-0229","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Frederik C","key":"krebspau","last":"Krebs","locid":"abb371a8-55a5-4346-af79-437546c2e627","name":"Krebs, Frederik C","orcid":"0000-0003-1148-4314","rank":9,"rolecode":"pau"}],"pub":{"doi":"10.1039/c6ce00382f","issn":["14668033"],"issue":"27","journal":"CrystEngComm","pages":"5083-5088","publisher":"Royal Society of Chemistry","status":"p","title":"CrystEngComm","volume":"18"},"review":"Peer Reviewed","scoID":["2-s2.0-84978998654"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-0a5bb7f5-fb05-44fe-a7db-3f0a3c2c4a2c"],"src":["DTU Technical University of Denmark"],"title":"<i>In situ</i> X-ray scattering of perovskite solar cell active layers roll-to-roll coated on flexible substrates","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-307722","year":"2016","yearsub":"2016"}
{"abstract":"Vitamin C deficiency globally affects several hundred million people and has been associated with increased morbidity and mortality in numerous studies. In this study, bioavailability of the oxidized form of vitamin C (l-dehydroascorbic acid or DHA)-commonly found in vitamin C containing food products prone to oxidation-was studied. Our aim was to compare tissue accumulation of vitamin C in guinea pigs receiving different oral doses of either ascorbate or DHA. In all tissues tested (plasma, liver, spleen, lung, adrenal glands, kidney, muscle, heart, and brain), only sporadic differences in vitamin C accumulation from ascorbate or DHA were observed except for the lowest dose of DHA (0.25mg/ml in the drinking water), where approximately half of the tissues had slightly yet significantly less vitamin C accumulation than from the ascorbate source. As these results contradicted data from rats, we continued to explore the ability to recycle DHA in blood, liver and intestine in guinea pigs, rats and mice. These investigations revealed that guinea pigs have similar recycling capacity in red blood cells as observed in humans, while rats and mice do not have near the same ability to reduce DHA in erythrocytes. In liver and intestinal homogenates, guinea pigs also showed a significantly higher ability to recycle DHA compared to rats and mice. These data demonstrate that DHA in guinea pigs-as in humans-is almost as effective as ascorbate as vitamin C source when it comes to taking up and storing vitamin C and further suggest that the guinea pig is superior to other rodents in modeling human vitamin C homeostasis.","author_count":3,"contributors":["Frikke-Schmidt, Henriette Rønne","Tveden-Nyborg, Pernille","Lykkesfeldt, Jens"],"cuid":["S01-000.00-409847"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Bioavailability","Faculty of Health and Medical Sciences","Guinea pig","Human","Mouse","Rat","Vitamin C"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"sub l sub dehydroascorbic acid can substitute sub l sub ascorbic acid as dietary vitamin c source in guinea pigs","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.redox.2015.11.003","version":"Published Version"},"id":"S01-000.00-409847","identifier":[{"id":"PMC4683385","type":"pmcid"},{"id":"84947767028","type":"scopus"},{"id":"26609560","type":"pmid"}],"ids":["ku-1b84d36f-6ad3-47bf-b3f9-a1655a18103b"],"keyword":["Ascorbate recycling","Bioavailability","Faculty of Health and Medical Sciences","Guinea pig","Human","Mouse","Rat","Vitamin C"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-2A0EB4CB7876E470D117522965F94CC6"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.redox.2015.11.003","version":"Published Version"},{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/153042660/L_dehydroascorbic_acid_can_substitute_L_ascorbic_acid_as_dietary_vitamin_C_source_in_guinea_pigs.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary and Animal Sciences, Preclinical Disease Biology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Henriette Rønne","key":"frikkeschmidtpau","last":"Frikke-Schmidt","locid":"4156ba3e-a9e7-4de4-84ca-fa74dd2fdf15","name":"Frikke-Schmidt, Henriette Rønne","rank":1,"rolecode":"pau"},{"affno":"1","first":"Pernille","key":"tvedennyborgpau","last":"Tveden-Nyborg","locid":"ff6db5e0-5e76-4cbd-9fa8-1b5a25009e7a","name":"Tveden-Nyborg, Pernille","orcid":"0000-0002-5574-5742","rank":2,"rolecode":"pau"},{"affno":"1","first":"Jens","key":"lykkesfeldtpau","last":"Lykkesfeldt","locid":"6e71ebed-c114-42ab-9ae9-6333f14bf8ad","name":"Lykkesfeldt, Jens","orcid":"0000-0002-6514-8407","rank":3,"rolecode":"pau"}],"pmid":["26609560"],"pub":{"doi":"10.1016/j.redox.2015.11.003","issn":["22132317"],"journal":"Redox Biology","pages":"8-13","status":"p","title":"Redox Biology","volume":"7"},"review":"Peer Reviewed","scoID":["2-s2.0-84947767028"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-1b84d36f-6ad3-47bf-b3f9-a1655a18103b"],"src":["KU University of Copenhagen"],"title":"<sub>L</sub>-dehydroascorbic acid can substitute <sub>L</sub>-ascorbic acid as dietary vitamin C source in guinea pigs","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-409847","year":"2016","yearsub":"2016"}
{"abstract":"The vHIT (video head impulse test) investigates the vestibular function in two ways: a VOR (vestibulo-ocular reflex) gain value and a head impulse diagram. From the diagram covert and overt saccades can be detected. Evaluation of the vestibular function based on vHIT depends on both parameters. There is a lack of knowledge regarding the reliability of the two parameters. The objective was to investigate the reliability of vHIT by comparing gain values between examiners on the same subjects, and to see how differences affected the occurrence of saccades. SUBJECTS: 25 subjects who had undergone cochlear implant (CI) surgery. Subjects were tested using the vHIT by two of four different examiners. Two judges interpreted the occurrence of saccades in the diagram. MAIN OUTCOME MEASURES: VOR gain values and the occurrence of saccades in the diagram. Differences in gain values between examiners varied from 0.2 to 0.58 with an average of 0.14 (95 % CI 0.12-0.16) on the right ear and 0.17 (95 % CI 0.15-0.19) on the left ear. Occurrences of saccades in the same patient were reproduced in 93 % of the cases by all examiners. Kappa's coefficient on the occurrence of saccades was 0.83. Interclass correlation coefficient (ICC) of the gain values between examiners ranged from 0.62 to 0.70. Differences in gain values amongst examiners did not seem to affect the occurrence of saccades in the same patient. The occurrence of saccades, therefore, seems to be more reliable than the gain value in the evaluation of the vestibular function. Interpretation of vHIT results should, therefore, first depend on the occurrence of saccades and second on the gain value.","author_count":4,"contributors":["Hviid Korsager, Leise Elisabeth","Schmidt, Jesper Hvass","Faber, Christian Emil","Wanscher, Jens Højberg"],"cuid":["S01-000.00-633806"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Adult","Aged","Aged 80 and over","Cochlear Implantation","Female","Humans","Male","Middle Aged","Observer Variation","Reproducibility of Results","Saccades physiology","Vestibule Labyrinth"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"reliability and comparison of gain values with occurrence of saccades in the eyeseecam video head impulse test vhit","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/134914504/Reliability_and_comparison_of_gain_values_with.pdf","version":"Authors Final Version"},"id":"S01-000.00-633806","identifier":[{"id":"27371332","type":"pmid"},{"id":"84976486354","type":"scopus"}],"ids":["sdu-d39b529a-db56-4ebc-8286-2e1c64c8fe86"],"keyword":["Adult","Aged","Aged, 80 and over","Cochlear Implantation","Female","Head Impulse Test/methods","Humans","Male","Middle Aged","Observer Variation","Reflex, Vestibulo-Ocular/physiology","Reproducibility of Results","Saccades/physiology","Vestibule, Labyrinth"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-4F35C8A80B78D3AEBC35171699BED6B4"],"oa_link":[{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/134914504/Reliability_and_comparison_of_gain_values_with.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Oto Rhino Laryngology (Odense)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Leise Elisabeth","key":"hviidkorsagerpau","last":"Hviid Korsager","locid":"04fd1226-1580-4e42-997d-319eec9c8286","name":"Hviid Korsager, Leise Elisabeth","orcid":"0000-0001-6906-4756","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper Hvass","key":"schmidtpau","last":"Schmidt","locid":"db84fc4e-28da-45af-a608-13ce8f4ec719","name":"Schmidt, Jesper Hvass","orcid":"0000-0001-7683-1407","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christian","key":"faberpau","last":"Faber","locid":"41aa4a5b-b537-43a3-942c-8beeae29c5c6","name":"Faber, Christian Emil","name_org":"Faber, Christian","orcid":"0000-0002-5078-6481","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens Højberg","key":"wanscherpau","last":"Wanscher","locid":"33130a0a-a7b5-4e60-b090-5a6e43f3396a","name":"Wanscher, Jens Højberg","rank":4,"rolecode":"pau"}],"pmid":["27371332"],"pub":{"doi":"10.1007/s00405-016-4183-2","issn":["09374477","09428992"],"issn_org":["09374477"],"issue":"12","journal":"European Archives of Oto-Rhino-Laryngology","pages":"4273-4279","publisher":"Springer Science+Business Media","status":"p","title":"European Archives of Oto-Rhino-Laryngology","volume":"273"},"review":"Peer Reviewed","scoID":["2-s2.0-84976486354"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-d39b529a-db56-4ebc-8286-2e1c64c8fe86"],"src":["SDU University of Southern Denmark"],"title":"Reliability and comparison of gain values with occurrence of saccades in the EyeSeeCam video head impulse test (vHIT)","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-633806","year":"2016","yearsub":"2016"}
{"abstract":"AIMS: This document aims to describe a standardised methodology for performing left atrial appendage occlusion (LAAO) using the AMPLATZER Amulet device, and to provide useful tips and tricks for operators with different levels of experience. METHODS AND RESULTS: Physicians who are experts in LAAO and had personal clinical experience with the AMPLATZER Amulet device were asked to contribute in the preparation of this consensus document. Twenty-seven physicians (20 interventional cardiologists and 7 electrophysiologists) from 14 different countries reviewed the manuscript. A step-by-step approach, simulating a real case, was followed. Starting with patient selection and planning, related cardiac imaging is discussed, followed by vascular access - transseptal puncture optimisation. Then, angiographic calibration/sizing and the required fluoroscopy views are explained and a device sizing strategy is proposed. Device preparation and de-airing is briefly described, followed by sheath exchange, device deployment steps, evaluation of device stability and decision for final release. The way to recapture and change a device is then shown, together with some additional tips on how to deal with challenging anatomies like \"chicken wing\" left atrial appendage. Finally, for operators who are switching from AMPLATZER Cardiac Plug to Amulet, the main differences between the two devices with respect to implantation technique are presented. CONCLUSIONS: In conclusion, this document reflects a consensus approach by expert implanters on the steps of LAAO technique and best practices for implantation of the AMPLATZER Amulet device, along with some practical tips to minimise the complication rate.","author_count":27,"contributors":["Tzikas, Apostolos","Gafoor, Sameer","Meerkin, David","Freixa, Xavier","Cruz-Gonzalez, Ignacio","Lewalter, Thorsten","Saw, Jacqueline","Berti, Sergio","Nielsen-Kudsk, Jens Erik","Ibrahim, Reda","Lakkireddy, Dhanunjaya","Paul, Vincent","Arzamendi, Dabit","Nietlispach, Fabian","Worthley, Stephen G","Hildick-Smith, David","Thambo, Jean Benoit","Tondo, Claudio","Aminian, Adel","Kalarus, Zbigniew","Schmidt, Boris","Sondergaard, Lars","Kefer, Joelle","Meier, Bernhard","Park, Jai-Wun","Sievert, Horst","Omran, Heyder"],"cuid":["S02-091.07-014668"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"keyword":["Atrial Appendage","Atrial fibrillation","Cardiac Catheterization","Consensus","Echocardiography Transesophageal","Equipment Design","Fluoroscopy","Humans","Journal Article","LAA closure","Prevention","Punctures","Septal Occluder Device","Stroke","Technique","Treatment Outcome"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"left atrial appendage occlusion with the amplatzer amulet device an expert consensus step by step approach","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.pcronline.com/eurointervention/97th_issue/volume-11/number-13/292/left-atrial-appendage-occlusion-with-the-amplatzer-amulet-device-an-expert-consensus-step-by-step-approach.html","version":"Other Version"},"id":"S02-091.07-014668","identifier":[{"id":"27107315","type":"pmid"},{"id":"84964913543","type":"scopus"}],"ids":["au-1c751580-911d-4522-bb55-a493dd39783e","ku-b0d2a5a2-3c35-45fe-8a3d-a359c1bb5a51"],"keyword":["Atrial Appendage","Atrial Fibrillation","Cardiac Catheterization","Consensus","Echocardiography, Transesophageal","Equipment Design","Fluoroscopy","Humans","Journal Article","LAA closure","Prevention","Punctures","Septal Occluder Device","Stroke","Technique","Treatment Outcome"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-28349F2D5D