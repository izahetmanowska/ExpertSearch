ecode":"pau"},{"affno":"1","first":"Arne","key":"astruppau","last":"Astrup","locid":"5d943631-c9fc-4b63-8aaa-263ba4248735","name":"Astrup, Arne","orcid":"0000-0001-8968-8996","rank":12,"rolecode":"pau"},{"affno":"1","first":"Jens Juul","key":"holstpau","last":"Holst","locid":"864b6401-9024-4773-9bdb-f4d4ca57dcad","name":"Holst, Jens Juul","orcid":"0000-0001-6853-3805","rank":13,"rolecode":"pau"},{"affno":"1","first":"Anders Mikael","key":"sjödinpau","last":"Sjödin","locid":"24ea7b85-2a13-44ec-93f5-fb419b0ab4fd","name":"Sjödin, Anders Mikael","orcid":"0000-0002-6451-3847","rank":14,"rolecode":"pau"}],"pmid":["26303352"],"pub":{"doi":"10.1038/ijo.2015.162","issn":["03070565","14765497"],"issn_org":["03070565"],"issue":"2","journal":"International Journal of Obesity","pages":"281-290","status":"p","title":"International Journal of Obesity","volume":"40"},"review":"Peer Reviewed","scoID":["2-s2.0-84957844598"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Novo Nordisk","Private Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-4b0c37e8-45fb-49d9-8144-20fd5d8c178e"],"src":["KU University of Copenhagen"],"title":"Effects of RYGB on energy expenditure, appetite and glycemic control : a randomized controlled clinical trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-438223","year":"2016","yearsub":"2016"}
{"abstract":"We have acquired Hubble Space Telescope (HST) and Very Large Telescope near-infrared spectra and images of supernova (SN) Refsdal after its discovery as an Einstein cross in Fall 2014. The HST light curve of SN Refsdal matches the distinctive, slowly rising light curves of SN 1987A-like supernovae (SNe), and we find strong evidence for a broad H-alpha P-Cygni profile in the HST grism spectrum at the redshift (z = 1.49) of the spiral host galaxy. SNe IIn, powered by circumstellar interaction, could provide a good match to the light curve of SN Refsdal, but the spectrum of a SN IIn would not show broad and strong H-alpha absorption. From the grism spectrum, we measure an H-alpha expansion velocity consistent with those of SN 1987A-like SNe at a similar phase. The luminosity, evolution, and Gaussian profile of the H-alpha emission of the WFC3 and X-shooter spectra, separated by ~2.5 months in the rest frame, provide additional evidence that supports the SN 1987A-like classification. In comparison with other examples of SN 1987A-like SNe, SN Refsdal has a blue B-V color and a high luminosity for the assumed range of potential magnifications. If SN Refsdal can be modeled as a scaled version of SN 1987A, we estimate it would have an ejecta mass of 20+-5 solar masses. The evolution of the light curve at late times will provide additional evidence about the potential existence of any substantial circumstellar material (CSM). Using MOSFIRE and X-shooter spectra, we estimate a subsolar host-galaxy metallicity (8.3+-0.1 dex and","author_count":22,"contributors":["Kelly, P. L.","Brammer, G.","Selsing, J.","Foley, R. J.","Hjorth, Jens","Rodney, S. A.","Christensen, L.","Strolger, L. -G.","Filippenko, A. V.","Treu, T.","Steidel, C. C.","Strom, A.","Riess, A. G.","Zitrin, A.","Schmidt, K. B.","Bradac, M.","Jha, S. W.","Graham, M. L.","McCully, C.","Graur, O.","Weiner, B. J.","Silverman, J. M."],"cuid":["S01-000.00-533811"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["astro ph CO","astro ph GA","astro ph SR"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"sn refsdal classification as a luminous and blue sn 000000001987a like type ii supernova","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-533811","identifier":[{"id":"84994520475","type":"scopus"}],"ids":["ku-eb15367c-440b-414b-a7cd-0bdbf5534307"],"keyword":["astro-ph.CO","astro-ph.GA","astro-ph.SR"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-C285E27B4A2F28D00464BE4C72370281"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Niels Bohr Institute, DARK"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"P. L.","key":"kellypau","last":"Kelly","name":"Kelly, P. L.","rank":1,"rolecode":"pau"},{"affno":"","first":"G.","key":"brammerpau","last":"Brammer","name":"Brammer, G.","rank":2,"rolecode":"pau"},{"affno":"1","first":"J.","key":"selsingpau","last":"Selsing","locid":"a03701c7-2505-45c4-b618-ba069f73cded","name":"Selsing, J.","orcid":"0000-0001-9058-3892","rank":3,"rolecode":"pau"},{"affno":"","first":"R. J.","key":"foleypau","last":"Foley","name":"Foley, R. J.","rank":4,"rolecode":"pau"},{"affno":"1","first":"J.","key":"hjorthpau","last":"Hjorth","locid":"053be362-0815-46b3-9f59-c099f9c6922c","name":"Hjorth, Jens","name_org":"Hjorth, J.","orcid":"0000-0002-4571-2306","rank":5,"role