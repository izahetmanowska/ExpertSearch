avid J","key":"brooksdavidjpau","last":"Brooks","locid":"3ea60c0d-a602-4a6f-a037-7477fddb7c50","name":"Brooks, David J","orcid":"0000-0003-2602-2518","rank":21,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thomas","key":"vorupjensenthomaspau","last":"Vorup-Jensen","locid":"77b03498-95a4-453b-81a8-e2c05fa0ca0c","name":"Vorup-Jensen, Thomas","orcid":"0000-0002-4140-6563","rank":22,"rolecode":"pau"}],"pmid":["38336934"],"pub":{"doi":"10.1038/s41467-024-45627-y","issn":["20411723"],"issue":"1","journal":"Nature Communications","paperid":"1224","publisher":"Nature Research","status":"p","title":"Nature Communications","volume":"15"},"review":"Peer Reviewed","scoID":["2-s2.0-85184720923"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-b5519e3f-a90c-446b-a3c6-e34875c060aa","sdu-af61a252-984a-4041-83e3-c53bd9942836"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Amyloid-β aggregates activate peripheral monocytes in mild cognitive impairment","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-724810","year":"2024","yearsub":"2024"}
{"abstract":"Background: Extracorporeal cardiopulmonary resuscitation (ECPR) for selected refractory out-of-hospital cardiac arrest (OHCA) is increasingly used. Detailed knowledge of health-related quality of life (HRQoL) and long-term cognitive function is limited. HRQoL and cognitive function were assessed in ECPR-survivors and OHCA-survivors with prehospital return of spontaneous circulation after standard advanced cardiac life support (sACLS). Methods: Fifteen ECPR-survivors and 22 age-matched sACLS-survivors agreed to participate in this follow-up study. Participants were examined with echocardiography, 6-minute walk test, and neuropsychological testing, and answered HRQoL (EQ-5D-5L and Short Form 36 (SF-36)), and mental health questionnaires. Results: Most patients were male (73 % and 82 %) and median age at follow-up was similar between groups (55 years and 60 years). Low flow time was significantly longer for ECPR-survivors (86 min vs. 15 min) and lactate levels were significantly higher (14.1 mmol/l vs. 3.9 mmol/l). No between-group difference was found in physical function nor in cognitive function with scores corresponding to the 23rd worst percentile of the general population. SACLS-survivors had HRQoL on level with the Danish general population while ECPR-survivors scored lower in both EQ-5D-5L (index score 0.73 vs. 0.86, p = 0.03, visual analog scale: 70 vs. 84, p = 0.04) and in multiple SF-36 health domains (role physical, bodily pain, general health, and mental health). Conclusions: Despite substantially longer low flow times with thrice as high lactate levels, ECPR-survivors were similar in cognitive and physical function compared to sACLS-survivors. Nonetheless, ECPR-survivors reported lower HRQoL overall and related to mental health, pain management, and the perception of limitations in physical role.","author_count":13,"contributors":["Gregers, Emilie","Linde, Louise","Kunkel, Joakim Bo","Wiberg, Sebastian","Møller-Sørensen, Peter Hasse","Smerup, Morten","Borregaard, Britt","Schmidt, Henrik","Lassen, Jens Flensted","Møller, Jacob Eifer","Hassager, Christian","Søholm, Helle","Kjaergaard, Jesper"],"cuid":["S02-100.00-725196"],"filters":{"added":"2024-05","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Gregers, Emilie"],"keyword":["Cognitive function","Extracorporeal cardiopulmonary resuscitation","Health related quality of life","Out of hospital cardiac arrest"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-SDR","DI-HO-ZEA"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-SDR","DI-HO-ZEA","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"health related quality of life and cognitive function after out of hospital cardiac arrest a comparison of prehospital return of spontaneous circulation and refractory arrest managed with extracorporeal cardiopulmonary resuscitation","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.resuscitation.2024.110151","version":"Published Version"},"funding_acknowledgement":["This project was supported by the common foundation of Rigshospitalet and Odense University Hospital (grant number 83-A3759), The Danish Heart Foundation (grant number 2020-9587) and by the Beckett Foundation (grant number 23-2-10125). JK has a research grant from Novo Nordisk Foundation (NNF22OC0079649) outside the submitted work. HS has a research grant from Novo Nordisk Foundation outside the submitted work. CH has a research grant from Novo Nordisk Foundation, Lundbeck Foundation and The Danish Heart Foundation outside the submitted work. JEM has a research grant from Novo Nordisk Foundation, Abiomed and The Danish Heart Foundation outside the submitted work. None of the other authors have anything to declare."],"id":"S02-100.00-725196","identifier":[{"id":"38401709","type":"pmid"},{"id":"85186623820","type":"scopus"}],"ids":["ku-71a5af23-a0d6-47d9-b3fa-d422758c2642","sdu-a8d9276a-4e51-48fb-a82e-eadb04776bd8"],"keyword":["Cognitive function","Extracorporeal cardiopulmonary resuscitation","Health-related quality of life","Out-of-hospital cardiac arrest"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-0F85C62E4BE5B9226D1BA528C7F5DAA4"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.resuscitation.2024.110151","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/256877555/PIIS0300957224000443.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/385695257/1_s2.0_S0300957224000443_main.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Cardiology (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University