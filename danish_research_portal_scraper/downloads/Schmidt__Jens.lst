{"author_count":5,"contributors":["Kjerkegaard, Stefan","Ringgaard, Dan"],"cuid":["S01-000.00-175031"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Karl Ove Knausgaard","Postkritik"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"hvordan forfattere læser et bidrag til postkritikken med læsninger i karl ove knausgårds min kamp og christina hesselholdts selskabet","src":["au"],"src-code":["DI-U-AU"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-175031","ids":["au-502ac03b-1711-4229-bc45-b8672ec5bc40"],"keyword":["Christina Hesselholdt","Karl Ove Knausgaard","postkritik"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-B4758464E83E6146646C691C34AEB4C7"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, School of Communication and Culture, School of Communication and Culture - Scandinavian Studies"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Stefan","key":"kjerkegaardpau","last":"Kjerkegaard","locid":"e6c02551-bd69-4826-8b4a-6dfdf4980530","name":"Kjerkegaard, Stefan","orcid":"0000-0003-4895-5431","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Dan","key":"ringgaardpau","last":"Ringgaard","locid":"abf3d347-c1bf-44fd-a004-e1506a35e7e9","name":"Ringgaard, Dan","orcid":"0000-0002-3265-9884","rank":2,"rolecode":"pau"},{"affno":"","first":"Jens Lohfert","key":"jørgensenpedh","last":"Jørgensen","name":"Jørgensen, Jens Lohfert","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Louise","key":"mønsterpedh","last":"Mønster","name":"Mønster, Louise","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Michael Kallesøe","key":"schmidtpedh","last":"Schmidt","name":"Schmidt, Michael Kallesøe","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9788793358706"],"pages":"65-81","place":"Hellerup","publisher":"Forlaget Spring","status":"p","title":"En ny kritik"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-502ac03b-1711-4229-bc45-b8672ec5bc40"],"src":["AU Aarhus University"],"title":"Hvordan forfattere læser : et bidrag til postkritikken med læsninger i Karl Ove Knausgårds Min kamp og Christina Hesselholdts Selskabet","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-175031","year":"2019","yearsub":"2019"}
{"abstract":"Denmark has a large network of population-based medical databases, which routinely collect high-quality data as a by-product of health care provision. The Danish medical databases include administrative, health, and clinical quality databases. Understanding the full research potential of these data sources requires insight into the underlying health care system. This review describes key elements of the Danish health care system from planning and delivery to record generation. First, it presents the history of the health care system, its overall organization and financing. Second, it details delivery of primary, hospital, psychiatric, and elderly care. Third, the path from a health care contact to a database record is followed. Finally, an overview of the available data sources is presented. This review discusses the data quality of each type of medical database and describes the relative technical ease and cost-effectiveness of exact individual-level linkage among them. It is shown, from an epidemiological point of view, how Denmark's population represents an open dynamic cohort with complete long-term follow-up, censored only at emigration or death. It is concluded that Denmark's constellation of universal health care, long-standing routine registration of most health and life events, and the possibility of exact individual-level data linkage provides unlimited possibilities for epidemiological research.","author_count":7,"contributors":["Schmidt, Morten","Schmidt, Sigrun Alba Johannesdottir","Adelborg, Kasper","Sundbøll, Jens","Laugesen, Kristina","Ehrenstein, Vera","Sørensen, Henrik Toft"],"cuid":["S01-000.00-220557"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"the danish health care system and epidemiological research from health care contacts to database records","src":["au"],"src-code":["DI-U-AU"],"type":"djr","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.2147/CLEP.S179083","version":"Published Version"},"id":"S01-000.00-220557","identifier":[{"id":"PMC6634267","type":"pmcid"},{"id":"31372058","type":"pmid"},{"id":"85071375987","type":"scopus"}],"ids":["au-a0186b9e-ab07-437d-92d9-6ba2130895eb"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-9060633294930E283AE503CA107C8761"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.2147/CLEP.S179083","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Clinical Epidemiology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Morten","key":"schmidtmortenpau","last":"Schmidt","locid":"21e3a3e6-e25e-48cf-b243-b8f43dca3bb8","name":"Schmidt, Morten","orcid":"0000-0002-4935-4059","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sigrun Alba Johannesdottir","key":"schmidtsigrunalbajohannesdottirpau","last":"Schmidt","locid":"d713674c-cc15-4444-b31c-c477238cdc29","name":"Schmidt, Sigrun Alba Johannesdottir","orcid":"0000-0001-5527-0698","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kasper","key":"adelborgkasperpau","last":"Adelborg","locid":"2744cdbf-8516-46f6-ad71-f99fee1afaa0","name":"Adelborg, Kasper","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens","key":"sundbølljenspau","last":"Sundbøll","locid":"47396c7b-4f59-4aef-9cb1-0c63a6a8bbe2","name":"Sundbøll, Jens","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kristina","key":"laugesenkristinapau","last":"Laugesen","locid":"ab62af11-21a5-4b44-a8ec-6c6d2afc742d","name":"Laugesen, Kristina","orcid":"0000-0001-7971-8223","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Vera","key":"ehrensteinverapau","last":"Ehrenstein","locid":"dba7d235-8119-40e4-99bc-6aeeec3c3f6b","name":"Ehrenstein, Vera","orcid":"0000-0002-3415-3254","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik Toft","key":"sørensenhenriktoftpau","last":"Sørensen","locid":"4d49d93a-4913-4223-ba59-272e717a845d","name":"Sørensen, Henrik Toft","orcid":"0000-0003-4299-7040","rank":7,"rolecode":"pau"}],"pmid":["31372058"],"pub":{"doi":"10.2147/clep.s179083","issn":["11791349"],"journal":"Clinical Epidemiology","pages":"563-591","publisher":"Dove Medical Press Ltd","status":"p","title":"Clinical Epidemiology","title_org":"Clinical epidemiology","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-85071375987"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-a0186b9e-ab07-437d-92d9-6ba2130895eb"],"src":["AU Aarhus University"],"title":"The Danish health care system and epidemiological research: from health care contacts to database records","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-220557","year":"2019","yearsub":"2019"}
{"abstract":"Danish university colleges are currently making a transition from institutions with primary focuson education to institutions that incorporate applied research as well. As part of this change, university college programs are now required by legislation to provide research-based education. This article discusses various understandings of the term “research-based education” and provides a visual model to promote a clearer understanding of the various approaches that can be utilized to achieve research-based education. The approaches described in this article are intentionally pragmatic in nature as opposed to idealized, extolled and conceptual statements of intentions. The model is embedded in the context of a bachelordegree program for engineering and an engineering research program at a Danish university college. By utilizing this explicit case, it is intended that the model will provide greater practical value. The article concludes that multiple channels for providing research-based engineering education are available. The “right” choice or choices for an institution must be identified through a prioritization procedure. The final selection of approaches to provide research-based education depends on the organizational structure of the educational institution, the teaching/research staff identity and the student body. In addition, the selection of approaches depends on how many students are touched, the profoundness of the learning experience and the ease of implementation","author_count":8,"contributors":["Ramsay, Loren Mark","Schmidt, Leila Kæmsgaard Pagh"],"cuid":["S01-000.00-655993"],"event":{"end":"2019-12-27","place":"Aarhus, dk","start":"2019-06-25","title":"Proceedings of the 15th International CDIO Conference","year":"2019"},"filters":{"added":"2023-01","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Research based education","learning educational science and teaching"],"level":"sci","oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-UC"],"level3":{"UC":["DI-UC-ALL","DI-UC-VIA"]},"level3all":["DI-UC-VIA"]},"review":"pr","rtype":["clu"],"sorti":"a model for research education interaction at a danish university college","src":["via"],"src-code":["DI-UC-VIA"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.7146/aul.347","version":"Published Version"},"id":"S01-000.00-655993","identifier":[{"id":"85107193808","type":"scopus"}],"ids":["via-279acc60-3221-422f-8c4f-27dfeb7b71c1"],"keyword":["CDIO competences","learning, educational science and teaching","research-based education","teachning-research nexus"],"lang":"English","level":"Scientific","noi":["Global-Local-2-2-67737602DCF169729111FC931AAFB073"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.7146/aul.347","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://ucviden.via.dk/ws/files/67966370/347_Bogmanuskript_1103_1_10_20191105.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"via university college","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-VIA","l3nl":"VIA University College","l3nn":"VIA University College","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"VIA University College","namevar":["VIA, Forskning og udvikling, Forsk.center byggeri, klima, vandtek. og digi."],"nora_code":"DI-UC-VIA","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Loren Mark","key":"ramsaypau","last":"Ramsay","locid":"005da3af-6e10-4c15-9a55-17dcb10df48b","name":"Ramsay, Loren Mark","orcid":"0000-0003-4867-7654","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Leila Kæmsgaard Pagh","key":"schmidtpau","last":"Schmidt","locid":"59ef79de-0fd5-44d0-b86c-839f3c2d4b49","name":"Schmidt, Leila Kæmsgaard Pagh","rank":2,"rolecode":"pau"},{"affno":"","first":"Jens","key":"bennedsenpedh","last":"Bennedsen","name":"Bennedsen, Jens","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Aage","key":"birkkjærlauritsenpedh","last":"Birkkjær Lauritsen","name":"Birkkjær Lauritsen, Aage","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Kristina","key":"edströmpedh","last":"Edström","name":"Edström, Kristina","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Natha","key":"kuptasthienpedh","last":"Kuptasthien","name":"Kuptasthien, Natha","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Janne","key":"roslöfpedh","last":"Roslöf","name":"Roslöf, Janne","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Robert","key":"songerpedh","last":"Songer","name":"Songer, Robert","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.7146/aul.347","eisbn":["9788775074594"],"pages":"613-623","publisher":"Aarhus Universitet","series":"Proceedings of the International CDIO Conference","status":"p","title":"The 15th International CDIO Conference Proceedings"},"review":"Peer Reviewed","scoID":["2-s2.0-85107193808"],"search":{"DAF":["All Danish Affiliations","All University Colleges","DI-ALL","DI-UC","DI-UC-ALL","University Colleges","VIA University College"],"PST":["Published"]},"sid":["via-279acc60-3221-422f-8c4f-27dfeb7b71c1"],"src":["VIA University College"],"title":"A Model for Research/Education-Interaction at a Danish University College","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-655993","year":"2019","yearsub":"2019"}
{"abstract":"Manchet: Mentalisering handler blandt andet om at kunne forestille sig og beskrive andres og egne tanker og følelser. VIVEs midtvejsevaluering af to mentaliseringsbaserede programmer på 14 anbringelsessteder ser på opstartsfasen og viser blandt andet, at medarbejderne generelt synes, at programmerne er brugbare, og at de er kommet godt i gang med at anvende dem. Baggrund: Mentalisering er en del af den menneskelige forestillingsevne, der involverer evnen til at forestille sig mentale tilstande hos sig selv og andre, som kan forklare handlinger og adfærd. Det er en fundamental menneskelig evne, som er essentiel, i forhold til at vi kan opbygge og indgå i sociale sammenhænge. Denne midtvejsevaluering er den første publikation i projektet Styrkelse af børn og unges mentaliseringsevne, handlekraft og sociale færdigheder. Evalueringen undersøger blandt andet implementeringen af to mentaliseringsbaserede programmer på 14 anbringelsessteder for børn og unge og ser på deres mentaliseringsevne ved baseline. De to programmer er Robusthedsprogrammet, som leveres af Komitéen for Sundhedsoplysning, og Mentaliseringsguiden, som leveres af Center for Mentalisering. Potentiale for udbredelse af programmer til at styrke mentaliseringsevnen Formålet med projektet er at styrke anbragte børn og unges mentaliseringsevne ved at implementere og afprøve de to mentaliseringsbaserede programmer. Midtvejsevalueringen giver viden til anbringelsessteder og kommuner, som overvejer at implementere programmerne. Resultater: Der er en række implementeringsudfordringer, som går igen for de anbringelsessteder, der implementerer Mentaliseringsguiden, og dem, der implementerer Robusthedsprogrammet. Mentalisering bliver genopfrisket Medarbejdere på anbringelsessteder, der arbejder med at implementere de to programmer, fortæller enstemmigt, at mentaliseringsbegrebet og mentaliseringsteori ikke er nyt for dem. Dog har undervisningen og arbejdet med programmet genopfrisket denne tankegang. Derudover fortæller de, at sproget fra programmerne er gledet ind i dagligdagssproget, så de nu har et fælles udgangspunkt for at arbejde med mentalisering. De anbringelsessteder, som er kommet længst med at implementere programmerne, er de steder, som bevidst har udvalgt og prioriteret, hvilke begreber eller øvelser de ville arbejde med. De er begyndt i det små med enkle begreber, som efterhånden er udvidet med flere begreber og øvelser. Implementeringsforhindringer identificeres og løses Medarbejderne oplever, at de identificerer implementeringsforhindringer og finder på nye løsninger, som passer til deres organisation og de børn og unge, de arbejder med. Men anbringelsesstederne er også udfordret af kompetencetab, når de uddannede medarbejdere skifter job, og når vikarer kommer ind. I forhold til de unges mentaliseringsevne ved baseline er resultaterne blandede. De unges evne til at forestille sig og beskrive indre følelser ligger under det alderssvarende niveau, mens deres evne til at forestille sig og beskrive tanker og følelser ud fra andres ansigtsudtryk ligger på et alderssvarende niveau. Metode: Evalueringen følger medarbejdere og unge på 14 døgninstitutioner, som søgte og blev tildelt midler af Socialstyrelsen til at afprøve ét af programmerne, Robusthedsprogrammet (3 anbringelsessteder) og Mentaliseringsguiden (11 anbringelsessteder). Derudover følger vi unge fra 7 sammenlignelige anbringelsessteder, som ikke implementerer programmerne. I løbet af projektet indsamler vi kvantitative og kvalitative data fra medarbejderne og kvalitative data fra de unge.","author_count":4,"contributors":["Scavenius Sonne-Schmidt, Christoffer","Kaspersen, Steffen","Hansen, Steen Juul","Hardy Sørensen, Jens"],"cuid":["S01-000.00-665655"],"filters":{"added":"2022-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Mentalisering"],"level":"com","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-VIVE"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-GV-VIVE","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"opstart af to mentaliseringsbaserede programmer midtvejsevaluering af styrkelse af børn og unges mentaliseringsevne handlekraft og sociale færdigheder","src":["vive"],"src-code":["DI-GV-VIVE"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.vive.dk/ws/files/3594962/301141_Opstart_af_to_mentaliseringsbaserede_programmer_TG_final.pdf","version":"Published Version"},"id":"S01-000.00-665655","ids":["vive-fec525c8-da5c-4a76-99aa-9d481fe78321"],"keyword":["Mentalisering"],"lang":"Danish","level":"Commissioned","mra":["Social Science"],"noi":["Local-1-1-7C7E40CFD3E8F0300C27FCF61BABDEF1"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.vive.dk/ws/files/3594962/301141_Opstart_af_to_mentaliseringsbaserede_programmer_TG_final.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"vive the danish center for social science research","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-VIVE","l3nn":"VIVE The Danish Center for Social Science Research","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"VIVE The Danish Center for Social Science Research","namevar":["VIVE - The Danish Center for Social Science Research, VIVE Social Policy"],"nora_code":"DI-GV-VIVE","used":1},{"affno":"2","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus Universitet"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Christoffer","key":"scaveniuspau","last":"Scavenius","locid":"a8969db7-fc1b-4f37-a4b7-3a5fcdedb1c1","name":"Scavenius Sonne-Schmidt, Christoffer","name_org":"Scavenius, Christoffer","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Steffen","key":"kaspersenpau","last":"Kaspersen","name":"Kaspersen, Steffen","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Steen Juul","key":"hansenpau","last":"Hansen","name":"Hansen, Steen Juul","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jens","key":"hardysørensenpau","last":"Hardy Sørensen","name":"Hardy Sørensen, Jens","rank":4,"rolecode":"pau"}],"pub":{"pages":"69","publisher":"VIVE - Det Nationale Forsknings- og Analysecenter for Velfærd","repno":"VIVE Rapport","series":"VIVE Rapport","status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Universities"],"PST":["Published"]},"sid":["vive-fec525c8-da5c-4a76-99aa-9d481fe78321"],"src":["VIVE The Danish Center for Social Science Research"],"title":"Opstart af to mentaliseringsbaserede programmer : Midtvejsevaluering af ’Styrkelse af børn og unges mentaliseringsevne, handlekraft og sociale færdigheder’","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-665655","year":"2019","yearsub":"2019"}
{"abstract":"Implementing microalgae biorefinery in arid environments requires utilization of strains that can grow at high temperatures (above 28 °C) and salinity levels (above 30 ppt). In this study, we investigate the newly isolated seawater strain, Synechococcus, native to the United Arab Emirates, and evaluate its value as a perspective organism for cultivation (for fuel and bio-products) in regions with freshwater scarcity. The strain displayed tolerance to a wide range of temperature (22–37 °C) and salinity (20–41 ppt), with maximum biomass concentration of 0.72 g L−1 and a maximum growth rate of 82 mg L−1 d−1 at 25 °C and 33 ppt salinity. Lipids accumulation reached up to 26% of dry weight in nitrogen-depleted conditions (with 1.8 mM of nitrates addition to the media), whereas protein content exceeded 50% dry weight. In this study, harvesting is investigated using three chemical agents: Ferric chloride, sodium hydroxide, and chitosan. Cell disruption is analyzed for four distinct treatments: Enzymatic, alkaline, ultrasonic, and hydrothermal. Among tested methods, flocculation with sodium hydroxide and ultrasonication were found to be the most efficient techniques for harvesting and cell disruption, respectively. The growth characteristics of the local strain and the potential to derive protein and lipids from it makes it a promising biomass in a biorefinery context.","author_count":4,"contributors":["Bochenski, Tomasz","Chaturvedi, Tanmay","Thomsen, Mette Hedegaard","Schmidt, Jens Ejbye"],"cuid":["S02-099.92-006122"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"continent":["Asia, Middle East"],"corresponding_author":["Chaturvedi, Tanmay"],"country":["United Arab Emirates"],"glorg":["All Global Affiliations","Khalifa University","Khalifa University of Science and Technology"],"keyword":["Biorefinery","Cell disruption","Microalgae"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-AAU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"evaluation of marine synechococcus for an algal biorefinery in arid regions","src":["aau","sdu"],"src-code":["DI-U-AAU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/en12122233","version":"Published Version"},"funding_acknowledgement":["Funding: This work was funded by the Cooperative Agreement between the Masdar Institute of Science and Technology (Masdar Institute), Abu Dhabi, UAE and the Massachusetts Institute of Technology (MIT), Cambridge, MA, USA. Reference BIOREFINERY 02/MI/MI/CP/11/07633/GEN/G/00 for work under the Second Five Year Agreement."],"id":"S02-099.92-006122","identifier":[{"id":"85067312048","type":"scopus"}],"ids":["aau-7e5bb156-5dba-42bb-8dbd-d1dbfba6f69a","sdu-375c31e2-fbba-463a-b600-619a3642593c"],"keyword":["Biorefinery","Cell disruption","Microalgae"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-5B1D94ECE90E0CD12CC9E2FCB5F856BF"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/315359062/energies_12_02233.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/en12122233","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/155906046/Open_Access_Version.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","country":"ae","key":"khalifa university of science and technology","loc":["United Arab Emirates","Asia, Middle East"],"name":"Khalifa University of Science and Technology","used":1},{"affno":"2","country":"ae","key":"khalifa university","loc":["United Arab Emirates","Asia, Middle East"],"name":"Khalifa University","used":1},{"affno":"3","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, AAU Energy","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Esbjerg Energy Section"],"nora_code":"DI-U-AAU","used":1},{"affno":"4","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Engineering, Department of Green Technology (IGT)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Tomasz","key":"bochenskipau","last":"Bochenski","name":"Bochenski, Tomasz","rank":1,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Tanmay","key":"chaturvedipau","last":"Chaturvedi","locid":"b3f5d7f0-b816-4c27-9382-1169eb40768c","name":"Chaturvedi, Tanmay","orcid":"0000-0003-1966-8898","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Mette Hedegaard","key":"thomsenpau","last":"Thomsen","locid":"29912cd6-8a9e-4022-b66a-6fb13430130a","name":"Thomsen, Mette Hedegaard","orcid":"0000-0001-6805-7247","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Jens Ejbye","key":"schmidtpau","last":"Schmidt","locid":"14ca7f5b-030e-46a8-8aef-a09f6fa018f5","name":"Schmidt, Jens Ejbye","orcid":"0000-0001-6067-5032","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.3390/en12122233","issn":["19961073"],"issue":"12","journal":"Energies","paperid":"2233","publisher":"MDPI AG","publi