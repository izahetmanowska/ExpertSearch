:"jensenpau","last":"Jensen","locid":"90debd3e-8e04-4f72-a4eb-05d4905b158a","name":"Jensen, Annette Bruun","orcid":"0000-0002-2044-2274","rank":19,"rolecode":"pau"},{"affno":"2","first":"Antoine","key":"lecocqpau","last":"Lecocq","locid":"7cbea140-f71f-402c-ad26-b13f16fe6d8e","name":"Lecocq, Antoine","orcid":"0000-0002-8013-0221","rank":20,"rolecode":"pau"},{"affno":"","first":"Andrew Gordon","key":"howepau","last":"Howe","locid":"ea2fa9c9-f259-4223-9d49-fce411103cf2","name":"Howe, Andrew Gordon","orcid":"0000-0002-7460-5227","rank":21,"rolecode":"pau"},{"affno":"2","first":"Mette","key":"termansenpau","last":"Termansen","locid":"48b59095-1afe-4154-a774-d4087885a61a","name":"Termansen, Mette","orcid":"0000-0003-4875-2810","rank":22,"rolecode":"pau"}],"pub":{"issn":["09071814"],"newspaper":"Politiken","pages":"5-6","publisher":"JP/Politikens Hus AS","publisher_org":"JP/Politikens Hus A/S","status":"p","title":"Politiken"},"review":"Undetermined","search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-2d4abf6a-c846-455c-8ffa-9e36e532b877","ku-e1cf92f2-b1e1-4039-8789-41b04eb4db36"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Vi må redde bierne - mens tid er","type":"Newspaper Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.10-015914","year":"2019","yearsub":"2019"}
{"abstract":"The nutritional quality of rapeseed press cakes (RPCs) in piglet feed is closely linked to its digestibility and the content of glucosinolates. This study investigates the significance of intact glucosinolate (glc) levels and degree of glc transformations on piglets performance. Four different RPCs were made from a low glc (11 µmol/g seed DM) containing B. napus L. seed variety Lioness (RPC-LW, RPC-LXW, RPC-LC, RPC-LCD). RPC made from the variety Excalibur containing the upper level of glc (24 µmol/g seed DM) of double rapeseed and produced at higher and prolonged temperature (RPC-UXW) served as negative control, while soya bean protein concentrate served as positive control. Piglets (8 kg) were fed ad libitum diets balanced for RPC protein content, with RPC inclusion of 84–98 g/kg (day 0–14) and 151–178 g/kg (day 15–50). Glc transformation was reduced from 42% to 24% (7.3–4.2 µmol/g RPC) when the temperature input was lowered in the warm pressing of oil, while the glc loss was less pronounced (17%) when cold pressing was applied. The following feed pelleting process further reduced Glc concentration from 11% to 40% in warm-pressed RPCs and 54 to 85% in cold-pressed RPCs. The RPC products replaced soya bean protein without any negative effects on performance, except for piglets served cold-pressed RPC, which had a reduction in average daily weight gain (ADG) (5%–7%, p < 0.05, Day 15–50). RPC in the feed led to increased liver weight in all piglets (p = 0.026). This may point at long-term effects from feeding with RPC. Intestinal absorption of intact glcs was proven by their detection in urine. In conclusion, warm-pressed RPC can be used as feed for piglet, while the presence of active myrosinase may have a negative effect on performance and cakes should either be included in lower amounts than used in the present study (18%) or include myrosinase inactivation before use.","author_count":8,"contributors":["Frandsen, Heidi Blok","Jensen, Søren Krogh","Maribo, Hanne","Markedal, Keld Ejdrup","Schmidt, Flemming","Sørensen, Hilmer","Sørensen, Susanne","Sørensen, Jens Christian"],"cuid":["S03-100.00-022347"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"corresponding_author":["Frandsen, Heidi Blok"],"keyword":["Amino acids","Digestive tract","Glucosinolates","Growing pigs","Growth performance","Organ weight","Performance","Piglets","Plasma","Protein","expeller extraction","organ weights","rapeseed pressed cakes","weaned pigs"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-PR","DI-U"],"level3":{"OT":["Unspecified organisation"],"PR":["DI-PR-AAF","DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-RUC"]},"level3all":["DI-PR-AAF","DI-PR-OTH","DI-U-AU","DI-U-KU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"piglet performance and physiological effects linked to reduced glucosinolate transformations in feed products based on rapeseed pressed cakes","src":["au","ku","ruc"],"src-code":["DI-U-AU","DI-U-KU","DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85061244084","version":"Other Version"},"id":"S03-100.00-022347","identifier":[{"id":"85061244084","type":"scopus"},{"id":"000468318300012","type":"wos"},{"id":"30734371","type":"pmid"}],"ids":["au-84e08312-848f-4f2f-819e-f3eff23b607e","ku-e82c5233-8c49-4ba8-b256-5993bf00da90","ruc-b3d2f5da-b4e2-4f15-8163-330d603ee4bc"],"keyword":["AMINO-ACIDS","DIET NUTRIENT DIGESTIBILITY","DIGESTIVE-TRACT","EXTRACTED CANOLA-MEAL","GROWING PIGS","GROWTH-PERFORMANCE","ORGAN WEIGHTS","PLASMA","PROTEIN","WEANED PIGS","expeller extraction","glucosinolates","organ weight","performance","piglets","rapeseed pressed cakes"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-6-34B6803D15212F8DAF885B25250E315C"],"o