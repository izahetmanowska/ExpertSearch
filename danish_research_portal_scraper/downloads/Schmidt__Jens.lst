{"abstract":"Det virker samfundsøkonomisk helt gak, at man først investerer skattekroner i at uddanne mennesker til vigtige jobs i den offentlige sektor, hvorefter man ansætter uuddannet arbejdskraft i stillingerne i stedet for at interessere sig for bevæggrundene bag de professionelles valg, skriver seks forskere fra landets professionshøjskoler.","author_count":6,"contributors":["Vaaben, Nana","Iskov, Thomas","Ellebæk, Jens Jakob","Gylling, Martin","Schmidt, Christina Haandbæk","Kirkegaard, Preben Olund"],"cuid":["S02-095.99-823109"],"filters":{"added":"2025-08","altsrc":["No Matches Found"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"level":"pop","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-UC"],"level3":{"UC":["DI-UC-AB","DI-UC-ALL","DI-UC-KP","DI-UC-UCL","DI-UC-UCN","DI-UC-UCS","DI-UC-VIA"]},"level3all":["DI-UC-AB","DI-UC-KP","DI-UC-UCL","DI-UC-UCN","DI-UC-UCS","DI-UC-VIA"]},"review":"und","rtype":["clu"],"sorti":"kronik forskere velfærdsmedarbejdere forlader det offentlige vi skal samarbejde for at finde løsningerne","src":["ucl","ucsyd"],"src-code":["DI-UC-UCL","DI-UC-UCS"],"type":"doo","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://www.altinget.dk/forskning/artikel/forskere-velfaerdsmedarbejdere-forlader-det-offentlige-vi-skal-samarbejde-for-at-finde-loesningerne","version":"Published Version"},"id":"S02-095.99-823109","ids":["ucl-cdc30f6c-a525-4071-ac66-fe961ac78178","ucsyd-1609f4f8-3d22-4c7f-b22e-b17aa872dda7"],"lang":"Danish","level":"Popular","mra":["Humanities"],"noi":["Local-1-2-70B0AD4292FAECE8D7694A7DA6471BAD"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.altinget.dk/forskning/artikel/forskere-velfaerdsmedarbejdere-forlader-det-offentlige-vi-skal-samarbejde-for-at-finde-loesningerne","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"kp university college copenhagen","l2":"DI-UC","l2n":"University Colleges","l3":"