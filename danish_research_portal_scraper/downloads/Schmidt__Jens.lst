n Denmark","dansk oftalmologisk selskab","organization of danish ophthalmologists"],"PST":["Published"]},"sid":["aau-a3b7b6c1-4d99-4428-8a65-6e165818fa61","au-07aa435d-4f76-4ee4-a09a-21674abf652c","ku-2c46480d-2ece-4329-bd0d-da697485c6ce","sdu-3476b94b-a32a-45c5-9098-14a8a9977619"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Reply : Is automated screening for DR indeed not yet ready as stated by Grauslund et al?","type":"Journal Comment","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-098.55-007908","year":"2020","yearsub":"2020"}
{"abstract":"Bio-based plastics, produced from natural and renewable sources, have been found to be good replacers to petroleum-based plastics. However, economic analyses have not been carried out for most of them, specifically those from whey. In this study, a techno-economic assessment of the industrial-scale production of plastics from whey protein is carried out considering two different scenarios: (1) low-cost dairy waste whey (DWP) and (2) purchased whey protein concentrate (WPC), as feedstocks, using SuperPro Designer software. Key economic indicators such as operating cost, capital investment, annual revenue, payback time, and return-on-investment (ROI), were analyzed. Sensitivity analyses of different parameters were performed to account for market fluctuations and other uncertainties, using Scenario 2 as the base case. Results showed that both scenarios have the capacity of producing over 3200 metric tons/year (t/yr) (or 5.5 t/batch) of plastic. With the unit selling price of plastic set at $7,000/t, both the scenarios showed profitable outcomes with the plant’s payback time of 3.7 and 2.4 years, and ROI of 27.1% and 42.2%, for Scenario 1 and Scenario 2, respectively. Sensitivity analyses showed that the unit plastic selling price was the most sensitive parameter, followed by the amount of feedstock WPC, and the number of batches.","author_count":6,"contributors":["Chalermthai, Bushra","Ashraf, Muhammad Tahir","Bastidas-Oyanedel, Juan Rodrigo","Olsen, Bradley","Schmidt, Jens Ejbye","Taher, Hanifa"],"cuid":["S01-000.00-611195"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Asia, Middle East","OECD"],"country":["United Arab Emirates","United States"],"glorg":["All Global Affiliations","Khalifa University","Massachusetts Institute of Technology"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"techno economic assessment of whey protein based plastic production from a co polymerization process","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/polym12040847","version":"Published Version"},"id":"S01-000.00-611195","identifier":[{"id":"32272627","type":"pmid"},{"id":"85086639298","type":"scopus"},{"id":"PMC7240497","type":"pmcid"}],"ids":["sdu-84a34f91-8e52-405c-8b7d-c5d6c22c6b44"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-0F7D0E3DB47046CD2269084FE4E72216"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/polym12040847","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/170342265/polymers_12_00847_v2_1_.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"ae","key":"khalifa university","loc":["United Arab Emirates","Asia, Middle East"],"name":"Khalifa University","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Engineering, Department of Green Technology (IGT)"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","country":"us","key":"massachusetts institute of technology","loc":["United States","America, North","OECD"],"name":"Massachusetts Institute of Technology","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Bushra","key":"chalermthaipau","last":"Chalermthai","name":"Chalermthai, Bushra","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Muhammad Tahir","key":"ashrafpau","last":"Ashraf","locid":"c15b128f-8f64-4d40-9e4f-79bdd23143a7","name":"Ashraf, Muhammad Tahir","orcid":"0000-0003-3101-3421","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Juan-Rodrigo","key":"bastidasoyanedelpau","last":"Bastidas Oyanedel","locid":"840da3ca-81a6-461d-a027-5716b944217e","name":"Bastidas-Oyanedel, Juan Rodrigo","name_org":"Bastidas Oyanedel, Juan-Rodrigo","orcid":"0000-0002-2418-441X","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Bradley","key":"olsenpau","last":"Olsen","name":"Olsen, Bradley","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jens Ejbye","key":"schmidtpau","last":"Schmidt","locid":"14ca7f5b-030e-46a8-8aef-a09f6fa018f5","name":"Schmidt, Jens Ejbye","orcid":"0000-0001-6067-5032","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hanifa","key":"taherpau","last":"Taher","name":"Taher, Hanifa","rank":6,"rolecode":"pau"}],"pmid":["32272627"],"pub":{"doi":"10.3390/polym12040847","issn":["20734360"],"issue":"4","journal":"Polymers","paperid":"847","publisher":"MDPI","status":"p","title":"Polymers","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-85086639298"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-84a34f91-8e52-405c-8b7d-c5d6c22c6b44"],"src":["SDU University of Southern Denmark"],"title":"Techno-Economic Assessment of Whey Protein-Based Plastic Production from a Co-Polymerization Process","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-611195","year":"2020","yearsub":"2020"}
{"abstract":"The prevailing trends in global energy consumption and the rapid depletion of fossil fuel present an urgent need for alternative fuels, particularly from renewable sources of biomass. In this study, date palm tree mixture wastes (DTM) and date seed (DS) biomass were used as starting materials in the production of bio-oil by pyrolysis. The yields of the pyrolysis oils from DTM and DS were optimized by tuning the experimental parameters. The DS provided a maximum yield of 68 wt% obtained from 30 min of pyrolysis with a biomass loading of 200 g, fluidizing gas flow rate of 10 mL min−1, and at a temperature of 500 °C. In addition, we evaluated the impact of the aging process of the obtained pyrolysis oils. The produced pyrolysis oils (freshly made) were aged for 15 and 30 days at room temperature under closed conditions. All the feedstock biomass were subjected to proximate and ultimate analysis. The TG-DTA results indicated that both biomasses were richer in cellulose and hemicellulose contents than in lignin content. The FT-IR and GC/MS analyses of the fresh and aged oil samples demonstrated the outstanding characteristics of the DS derived bio-oil for use as a bio-fuel. The variation in the chemical composition of the fresh and aged pyrolysis oils are completely described and presented elaborately. This study demonstrates the significance of and a new functionality for the date palm industry to process date palm wastes, particularly the DS as a rich biomass source for the production of bio-fuel.","author_count":9,"contributors":["Bharath, G.","Hai, Abdul","Rambabu, K.","Banat, Fawzi","Jayaraman, Raja","Taher, Hanifa","Bastidas-Oyanedel, Juan Rodrigo","Ashraf, Muhammad Tahir","Schmidt, Jens Ejbye"],"cuid":["S01-000.00-611652"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, Middle East"],"corresponding_author":["Banat, Fawzi"],"country":["United Arab Emirates"],"glorg":["All Global Affiliations","Khalifa University"],"keyword":["Biofuels","Biomass","Date palm","Pyrolysis oil","Renewable energy"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"systematic production and characterization of pyrolysis oil from date tree wastes for bio fuel applications","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85080079537","version":"Other Version"},"funding_acknowledgement":["This publication is based upon work supported by the Khalifa University of Science and Technology under Award No. CIRA-2018- 27."],"id":"S01-000.00-611652","identifier":[{"id":"85080079537","type":"scopus"}],"ids":["sdu-862a70f6-37b9-4d74-96d5-49999be3c318"],"keyword":["Biofuels","Biomass","Date palm","Pyrolysis-oil","Renewable energy"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-9598B7799D9ED55FD27F5177C699000D"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"ae","key":"khalifa university","loc":["United Arab Emirates","Asia, Middle East"],"name":"Khalifa University","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Engineering, Department of Green Technology (IGT)","SDU, The Faculty of Engineering, Department of Green Technology (IGT), SDU Biotechnology"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"G.","key":"bharathpau","last":"Bharath","name":"Bharath, G.","rank":1