","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Engineering, Department of Green Technology (IGT)"],"nora_code":"DI-U-SDU","used":1},{"affno":"8","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Politechnika Poznanska"],"nora_code":"DI-OT","used":1},{"affno":"9","country":"pl","key":"gdańsk university of technology","loc":["Poland","Europe, EU","OECD"],"name":"Gdańsk University of Technology","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Anil Kumar","key":"singhpau","last":"Singh","name":"Singh, Anil Kumar","rank":1,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Hafiz M.N.","key":"iqbalpau","last":"Iqbal","name":"Iqbal, Hafiz M.N.","rank":2,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Nunzio","key":"cardullopau","last":"Cardullo","name":"Cardullo, Nunzio","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Vera","key":"muccillipau","last":"Muccilli","name":"Muccilli, Vera","rank":4,"rolecode":"pau"},{"affno":"5 6","corresponding":null,"first":"Jesús","key":"fernándezlucaspau","last":"Fernández-Lucas","name":"Fernández-Lucas, Jesús","rank":5,"rolecode":"pau"},{"affno":"7","corresponding":null,"country":"dk","first":"Jens Ejbye","key":"schmidtpau","last":"Schmidt","locid":"14ca7f5b-030e-46a8-8aef-a09f6fa018f5","name":"Schmidt, Jens Ejbye","orcid":"0000-0001-6067-5032","rank":6,"rolecode":"pau"},{"affno":"8","corresponding":null,"first":"Teofil","key":"jesionowskipau","last":"Jesionowski","name":"Jesionowski, Teofil","rank":7,"rolecode":"pau"},{"affno":"8 9","corresponding":null,"first":"Muhammad","key":"bilalpau","last":"Bilal","name":"Bilal, Muhammad","rank":8,"rolecode":"pau"}],"pmid":["37217044"],"pub":{"doi":"10.1016/j.ijbiomac.2023.124968","issn":["01418130","18790003"],"issn_org":["01418130"],"issue":"Pt 3","journal":"International Journal of Biological Macromolecules","paperid":"124968","publisher":"Elsevier","status":"p","title":"International Journal of Biological Macromolecules","volume":"242"},"review":"Peer Reviewed","scoID":["2-s2.0-85161299062"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-aeb1a04e-7d1f-44a7-96cb-4453599edf6a"],"src":["SDU University of Southern Denmark"],"title":"Structural insights, biocatalytic characteristics, and application prospects of lignin-modifying enzymes for sustainable biotechnology","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-680603","year":"2023","yearsub":"2023"}
{"abstract":"Cellular heterogeneity represents a major challenge for regenerative treatment using freshly isolated Adipose Derived Regenerative Cells (ADRCs). Emerging data suggest superior efficacy of ADRCs as compared to the ex vivo expanded and more homogeneous ADRCs (= ASCs) for indications involving (micro)vascular deficiency, however, it remains unknown which ADRC cell subtypes account for the improvement. Surprisingly, we found regarding erectile dysfunction (ED) that the number of injected CD31+ ADRCs correlated positively with erectile function 12 months after one bolus of autologous ADRCs. Comprehensive in vitro and ex vivo analyses confirmed superior pro-angiogenic and paracrine effects of human CD31+ enriched ADRCs compared to the corresponding CD31− and parent ADRCs. When CD31+, CD31− and ADRCs were co-cultured in aortic ring- and corpus cavernous tube formation assays, the CD31+ ADRCs induced significantly higher tube development. This effect was corroborated using conditioned medium (CM), while quantitative mass spectrometric analysis suggested that this is likely explained by secretory pro-angiogenic proteins including DKK3, ANGPT2, ANAX2 and VIM, all enriched in CD31+ ADRC CM. Single-cell RNA sequencing showed that transcripts of the upregulated and secreted proteins were present in 9 endothelial ADRC subsets including endothelial progenitor cells in the heterogenous non-cultured ADRCs. Our data suggest that the vascular benefit of using ADRCs in regenerative medicine is dictated by CD31+ ADRCs.","author_count":15,"contributors":["Dhumale, Pratibha","Nielsen, Jakob Vennike","Hansen, Anne Cathrine Schmidt","Burton, Mark","Beck, Hans Christian","Jørgensen, Mads Gustaf","Toyserkani, Navid Mohamadpour","Haahr, Martha Kirstine","Hansen, Sabrina Toft","Lund, Lars","Thomassen, Mads","Sørensen, Jens Ahm","Andersen, Ditte Caroline","Jensen, Charlotte Harken","Sheikh, Søren Paludan"],"cuid":["S01-000.00-691150"],"filters":{"added":"2023-10","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"corresponding_author":["Sheikh, Søren Paludan"],"keyword":["Biological Assay","Biological Transport","Body Fluids","Culture Media Conditioned","Humans","Male"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-SDR","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"cd000000000031 defines a subpopulation of human adipose derived regenerative cells with potent angiogenic effects","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41598-023-41535-1","version":"Published Version"},"funding_acknowledgement":["We thank Tina Kjærgaard Andersen, Tonja Lyngse Jørgensen, Yuan Li and Christina Fenger (Amplexa, Odense, DK) for excellent technical assistance. This study was supported by a Grand Solutions grant from Innovation Foundation Denmark (Grant IFD 7051)."],"id":"S01-000.00-691150","identifier":[{"id":"37658225","type":"pmid"},{"id":"PMC10474028","type":"pmcid"},{"id":"85169669665","type":"scopus"}],"ids":["sdu-7a67629f-34d2-4b46-ae21-ac1c754338f0"],"keyword":["Acoustic Maculae","Angiogenic Proteins","Biological Assay","Biological Transport","Body Fluids","Culture Media, Conditioned","Humans","Male"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-874A4BCCCC33C74085A6ECBBF68EB180"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/240041123/s41598_023_41535_1.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41598-023-41535-1","version":"Published Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of S