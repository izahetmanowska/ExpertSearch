rst":"Anne Margrethe","key":"wagnerpau","last":"Wagner","locid":"dc8549e3-5e92-4125-bc5c-e4a437e311dc","name":"Wagner, Anne Margrethe","orcid":"0000-0001-7637-1826","rank":5,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Kamilla Pernille Johansen","key":"nørtoftpau","last":"Nørtoft","name":"Nørtoft, Kamilla Pernille Johansen","rank":6,"rolecode":"pau"},{"affno":"2","first":"Bettina","key":"lammpau","last":"Lamm","locid":"5e6b43bb-7cac-425d-8221-826c1e94974e","name":"Lamm, Bettina","orcid":"0000-0002-8942-690X","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"René","key":"kuralpau","last":"Kural","locid":"b1c4572f-48fa-4d47-8038-90720e3c072d","name":"Kural, René","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jasper","key":"schipperijnpau","last":"Schipperijn","locid":"164cb44f-53ef-4f1a-9605-8112d837fcca","name":"Schipperijn, Jasper","orcid":"0000-0002-6558-7610","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens","key":"troelsenpau","last":"Troelsen","locid":"b35581eb-1482-4559-a4dd-49ec75e4c8a9","name":"Troelsen, Jens","orcid":"0000-0001-8105-0349","rank":10,"rolecode":"pau"}],"pmid":["28526028"],"pub":{"doi":"10.1186/s12889-017-4423-4","issn":["14712458"],"issue":"481","journal":"BMC Public Health","paperid":"17:48","publisher":"BioMed Central","status":"p","title":"BMC Public Health","volume":"17"},"review":"Peer Reviewed","scoID":["2-s2.0-85019849946"],"search":{"DAF":["Aarhus University","All Artistic Higher Education Institutions","All Danish Affiliations","All Universities","Artistic Higher Education Institutions","DI-ALL","DI-ART","DI-ART-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["arkc-5bdda6f0-00c0-4d5c-9352-597bc2b2ff03","ku-0bd0cb87-a1d6-4bf3-b09e-45d572a4036c","ku-53c4991a-1967-41b7-b4d8-e4025f0e0aed","sdu-17864071-25bb-4959-9cdd-f21d29c6d8a9"],"src":["KU University of Copenhagen","Royal Danish Academy - Architecture, Design, Conservation","SDU University of Southern Denmark"],"title":"Move the Neighbourhood : Study design of a community-based participatory public open space intervention in a Danish deprived neighbourhood to promote active living","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-092.73-012404","year":"2017","yearsub":"2017"}
{"abstract":"Recent trends in use of antihypertensive drugs are unknown. From Danish nationwide prescription data, we obtained information on primary care use of angiotensin-converting enzyme inhibitors, angiotensin II receptor blockers, beta blockers, diuretics, aldosterone receptor antagonists, and calcium channel blockers. During 1999 to 2015, the use of antihypertensive drugs per 1,000 inhabitants/day increased from 184 to 379 defined daily doses (DDD), corresponding to a rise in the prevalence proportion of users from ≈20% to ≈35%. From 1999 to 2015, a notable increase was observed for angiotensin-converting enzyme inhibitors (from 29 to 105 DDD per 1,000 inhabitants/day ≈260%) and angiotensin II receptor blockers (from 13 to 73 DDD per 1,000 inhabitants/day ≈520%). For diuretics the use remained stable, with a slight decrease (from 89 to 81 DDD per 1,000 inhabitants/day ≈−10%). The use of aldosterone receptor antagonists increased until 2007 and remained unchanged at around 3.5 DDD per 1,000 inhabitants/day thereafter (average change ≈65%). The use of beta blockers doubled during the study period (from 17 to 34 DDD per 1,000 inhabitants/day ≈100%), entirely driven by increasing use of metoprolol. Similar trends were observed for calcium channel blockers (from 34 to 82 DDD per 1,000 inhabitants/day ≈140%), where amlodipine drove the overall increase. In conclusion, antihypertensive drug use has increased remarkably during the past 2 decades.","author_count":5,"contributors":["Sundbøll, Jens","Adelborg, Kasper","Mansfield, Kathryn E.","Tomlinson, Laurie A.","Schmidt, Morten"],"cuid":["S01-000.00-147359"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"corresponding_author":["Sundbøll, Jens"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of London"],"keyword":["Arterial hypertension","Blood Pressure","CONVERTING ENZYME INHIBITORS","Cardiovascular events","Chronic heart failure","High risk patients","Randomized Controlled Trial","Systolic function","VENTRICULAR EJECTION FRACTION","candesartan"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"seventeen year nationwide trends in antihypertensive drug use in denmark","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85031704425","version":"Other Version"},"id":"S01-000.00-147359","identifier":[{"id":"000418623600013","type":"wos"},{"id":"85031704425","type":"scopus"},{"id":"29054274","type":"pmid"}],"ids":["au-1f79488b-36ff-408c-bebb-b4b82ff607f2"],"keyword":["ARTERIAL-HYPERTENSION","BLOOD-PRESSURE","CANDESARTAN","CARDIOVASCULAR EVENTS","CHRONIC HEART-FAILURE","CONVERTING-ENZYME INHIBITORS","HIGH-RISK PATIENTS","RANDOMIZED CONTROLLED-TRIAL","SYSTOLIC FUNCTION","VENTRICULAR EJECTION FRACTION"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-B31821486859795D48973F22C4E4BA25"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Clinical Epidemiology","Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Cardiological Medicine B"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"gb","key":"university of london","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of London","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jens","key":"sundbollpau","last":"Sundboll","locid":"47396c7b-4f59-4aef-9cb1-0c63a6a8bbe2","name":"Sundbøll, Jens","name_org":"Sundboll, Jens","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kasper","key":"adelborgpau","last":"Adelborg","locid":"2744cdbf-8516-46f6-ad71-f99fee1afaa0","name":"Adelborg, Kasper","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kathryn E.","key":"mansfieldpau","last":"Mansfield","name":"Mansfield, Kathryn E.","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Laurie A.","key":"tomlinsonpau","last":"Tomlinson","name":"Tomlinson, Laurie A.","rank":4,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Morten","key":"schmidtpau","last":"Schmidt","locid":"21e3a3e6-e25e-48cf-b243-b8f43dca3bb8","name":"Schmidt, Morten","orcid":"0000-0002-4935-4059","rank":5,"rolecode":"pau"}],"pmid":["29054274"],"pub":{"doi":"10.1016/j.amjcard.2017.08.042","issn":["00029149","18791913"],"issn_org":["00029149"],"issue":"12","journal":"American Journal of Cardiology","pages":"2193-2200","publisher":"Elsevier Inc.","status":"p","title":"American Journal of Cardiology","volume":"120"},"review":"Peer Reviewed","scoID":["2-s2.0-85031704425"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-1f79488b-36ff-408c-bebb-b4b82ff607f2"],"src":["AU Aarhus University"],"title":"Seventeen-Year Nationwide Trends in Antihypertensive Drug Use in Denmark","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-147359","year":"2017","yearsub":"2017"}
{"abstract":"INTRODUCTION: Remote ischaemic conditioning (RIC) protects against ischaemia-reperfusion injury through cellular protective pathways, but may also modulate haemostasis. We aimed to investigate the effect of long-term RIC on platelet function and fibrinolysis in patients with chronic ischaemic heart failure (CIHF). MATERIAL AND METHODS: In a prospective, outcome-assessor blinded, paired study, 16 patients with CIHF and 21 age- and gender-matched controls without ischaemic heart disease (IHD) were treated with RIC once daily for 28±4days. RIC was performed as four cycles of 5min upper arm ischaemia and reperfusion. We evaluated collagen and arachidonic acid induced platelet aggregation (Multiplate® Analyzer), platelet turnover (Sysmex® XE-5000), platelet activation (plasma soluble-platelet-selectin) and fibrinolysis (clot lysis time, tissue plasminogen activator (t-PA) and plasminogen activator inhibitor-1 (PAI-1)). We compared blood samples assessed at baseline and following long-term RIC. RESULTS: Long-term RIC did not affect platelet aggregation, turnover or activation or PAI-1 in any study groups. Long-term RIC did not affect fibrin clot lysis time in patients with CIHF but reduced fibrin clot lysis time in matched controls without IHD (median: 773s (interquartile range: 689-936) vs. 658s (618-823), p=0.03). t-PA was increased following long-term RIC in CIHF patients (2.5 (1.7-3.4) vs. 2.9 (1.8-4.0), p=0.03) and in matched controls without IHD (1.5 (1.3-1.9) vs. 1.6 (1.4-2.3), p=0.03). CONCLUSIONS: While long-term RIC did not affect collagen or arachidonic acid induced platelet aggregation, platelet turnover or sP-selectin, fibrinolysis was increased although most consistently in matched controls without IHD. This finding suggests that RIC may stimulate fibrinolysis potentially reducing the risk of thrombosis.","author_count":10,"contributors":["Pryds, Kasper","Kristiansen, Jacobina","Neergaard-Petersen, Søs","Nielsen, Bent Roni Ranghøj","Schmidt, Michael Rahbek","Refsgaard, Jens","Kristensen, Steen Dalby","Bøtker, Hans Erik","Hvas, Anne-Mette","Grove, Erik Lerkevang"],"cuid":["S01-000.00-181470"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Activation","Acute myocardial infarction","Association","Chronic heart failure","Coagulation","Fibrinolysis","Haemostasis","Injury","Ischemic heart disease","Microcirculation","Platelet function","Reactivity","Remote ischemic conditioning"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"effect of long term remote ischaemic conditioning on platelet function and fibrinolysis in patients with chronic ischaemic heart failure","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85015262385","version":"Other Version"},"id":"S01-000.00-181470","identifier":[{"id":"000402491200007","type":"wos"},{"id":"28319824","type":"pmid"},{"id":"85015262385","type":"scopus"}],"ids":["au-5b76c260-8b22-4639-a5d5-68fbd48dab61"],"keyword":["ACTIVATION","ACUTE MYOCARDIAL-INFARCTION","ASSOCIATION","COAGULATION","Chronic heart failure","Fibrinolysis","Haemostasis","INJURY","Ischemic heart disease","MICROCIRCULATION","Platelet function","REACTIVITY","Remote ischemic conditioning"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-6B80EC834F9D11889EA69791CCDB7745"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Cardiological Medicine B"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Kasper","key":"prydspau","last":"Pryds","locid":"e8f8ad41-ec4a-4b07-851f-b898f7ead8c5","name":"Pryds, Kasper","orcid":"0000-0003-0182-8718","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jacobina","key":"kristiansenpau","last":"Kristiansen","locid":"2e2d63df-45ab-4f5e-af77-18de44c68887","name":"Kristiansen, Jacobina","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søs","key":"neergaardpetersenpau","last":"Neergaard-Petersen","locid":"7c75329a-0cef-4da3-959b-2bf6b326aaf5","name":"Neergaard-Petersen, Søs","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Bent Roni Ranghøj","key":"nielsenpau","last":"Nielsen","locid":"896f4a21-d29c-4ad9-b0ef-4e7f8616c234","name":"Nielsen, Bent Roni Ranghøj","orcid":"0000-0001-9228-3869","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Michael R","key":"schmidtpau","last":"Schmidt","locid":"b426fa5b-d8ea-4975-821c-43c67d717749","name":"Schmidt, Michael Rahbek","name_org":"Schmidt, Michael R","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens","key":"refsgaardpau","last":"Refsgaard","locid":"bef61e81-bb73-450c-a731-ec33a8e2a7e4","name":"Refsgaard, Jens","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Steen D","key":"kristensenpau","last":"Kristensen","locid":"6d64271d-8a2c-41ea-891d-e85555bbd47a","name":"Kristensen, Steen Dalby","name_org":"Kristensen, Steen D","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Hans Erik","key":"bøtkerpau","last":"Bøtker","locid":"09b03c00-11a8-4f72-800f-181f26155750","name":"Bøtker, Hans Erik","orcid":"0000-0001-6358-8962","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk",