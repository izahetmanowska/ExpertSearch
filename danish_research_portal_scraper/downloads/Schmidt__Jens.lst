4131","rank":8,"rolecode":"pau"},{"affno":"1 4","first":"Nicolai Jacob Wewer","key":"albrechtsenpau","last":"Albrechtsen","locid":"0d59b767-fdca-42a0-b879-70fb0ec55651","name":"Wewer Albrechtsen, Nicolai J","name_org":"Albrechtsen, Nicolai Jacob Wewer","orcid":"0000-0003-4230-5753","rank":9,"rolecode":"pau"},{"affno":"1","first":"Jens Juul","key":"holstpau","last":"Holst","locid":"864b6401-9024-4773-9bdb-f4d4ca57dcad","name":"Holst, Jens Juul","orcid":"0000-0001-6853-3805","rank":10,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Anja","key":"hilbertpau","last":"Hilbert","name":"Hilbert, Anja","rank":11,"rolecode":"pau"},{"affno":"6 7","corresponding":null,"first":"Carel W.","key":"lerouxpau","last":"le Roux","name":"le Roux, Carel W.","rank":12,"rolecode":"pau"},{"affno":"1","first":"Anders","key":"sjödinpau","last":"Sjödin","locid":"24ea7b85-2a13-44ec-93f5-fb419b0ab4fd","name":"Sjödin, Anders Mikael","name_org":"Sjödin, Anders","orcid":"0000-0002-6451-3847","rank":13,"rolecode":"pau"}],"pmid":["33786744"],"pub":{"doi":"10.1007/s11695-021-05374-1","issn":["09608923","17080428"],"issn_org":["09608923"],"journal":"Obesity Surgery","pages":"3514-3524","publisher":"Springer New York","status":"p","title":"Obesity Surgery","volume":"31"},"review":"Peer Reviewed","scoID":["2-s2.0-85103420226"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-7a927137-230f-4756-8b1e-902863d97e90","ku-5b4481f7-66e9-4055-9201-f444e64612ec"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Factors Associated with Favorable Changes in Food Preferences After Bariatric Surgery","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.67-035407","year":"2021