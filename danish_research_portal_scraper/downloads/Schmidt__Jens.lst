l":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Risø National Laboratory for Sustainable Energy","Technical University of Denmark, Risø National Laboratory for Sustainable Energy, Wind Energy Division","Technical University of Denmark, Risø National Laboratory for Sustainable Energy, Wind Energy Division, Wind Energy Systems"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"no","key":"university of bergen","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"University of Bergen","used":1},{"affno":"3","country":"dk","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University"],"nora_code":"DI-U-AAU","used":1},{"affno":"4","country":"dk","key":"force technology","l2":"DI-GTS","l2n":"GTS Institutes","l3":"DI-GTS-FORC","l3nn":"FORCE Technology","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"FORCE Technology","namevar":["DELTA - a Part of FORCE Technology"],"nora_code":"DI-GTS-FORC","used":1},{"affno":"5","country":"de","key":"eberhard karls universität tübingen","loc":["Germany","Europe, EU","OECD"],"name":"Eberhard-Karls-Universität Tübingen","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Gregor","key":"giebelpau","last":"Giebel","locid":"ad536576-e887-46af-8caa-7e88343efb7d","name":"Giebel, Gregor","orcid":"0000-0002-4453-8756","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Uwe","key":"schmidtpaulsenpau","last":"Schmidt Paulsen","locid":"1ca05d05-ae00-49ee-8355-7f76690a269e","name":"Schmidt Paulsen, Uwe","orcid":"0000-0002-8991-5658","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Joachim","key":"reu