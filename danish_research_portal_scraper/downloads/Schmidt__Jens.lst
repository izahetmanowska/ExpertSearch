","locid":"133c00bf-5214-4309-9c86-e211d48b5097","name":"Frydenvang, Jens","orcid":"0000-0001-9294-1227","rank":12,"rolecode":"pau"},{"affno":"9","first":"R.","key":"gellertpau","last":"Gellert","name":"Gellert, R.","rank":13,"rolecode":"pau"},{"affno":"10","first":"J. A.","key":"grantpau","last":"Grant","name":"Grant, J. A.","rank":14,"rolecode":"pau"},{"affno":"11","first":"S.","key":"guptapau","last":"Gupta","name":"Gupta, S.","rank":15,"rolecode":"pau"},{"affno":"12","first":"K. E.","key":"herkenhoffpau","last":"Herkenhoff","name":"Herkenhoff, K. E.","rank":16,"rolecode":"pau"},{"affno":"13","first":"D. W.","key":"mingpau","last":"Ming","name":"Ming, D. W.","rank":17,"rolecode":"pau"},{"affno":"13","first":"E. B.","key":"rampepau","last":"Rampe","name":"Rampe, E. B.","rank":18,"rolecode":"pau"},{"affno":"14","first":"M. E.","key":"schmidtpau","last":"Schmidt","name":"Schmidt, M. E.","rank":19,"rolecode":"pau"},{"affno":"1","first":"K. L.","key":"siebachpau","last":"Siebach","name":"Siebach, K. L.","rank":20,"rolecode":"pau"},{"affno":"2","first":"K.","key":"stackmorganpau","last":"Stack-morgan","name":"Stack-morgan, K.","rank":21,"rolecode":"pau"},{"affno":"15","first":"D. Y.","key":"sumnerpau","last":"Sumner","name":"Sumner, D. Y.","rank":22,"rolecode":"pau"},{"affno":"16","first":"R. C.","key":"wienspau","last":"Wiens","name":"Wiens, R. C.","rank":23,"rolecode":"pau"}],"pmid":["28572336"],"pub":{"doi":"10.1126/science.aah6849","issn":["00368075","10959203"],"issn_org":["00368075"],"issue":"6341","journal":"Science","paperid":"eaah6849","status":"p","title":"Science","volume":"356"},"review":"Peer Reviewed","scoID":["2-s2.0-85020239552"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-780a757d-2438-44f4-baea-4e80c14291be"],"src":["KU University of Copenhagen"],"title":"Redox stratification of an ancient lake in Gale crater, Mars","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-465285","year":"2017","yearsub":"2017"}
{"abstract":"Loss of vestibular function is a common side effect to cochlear implant (CI) surgery. We present a patient who experienced balance problems and showed a reduced vestibulo-ocular reflex (VOR) gain (0.47 ± 0.10) combined with saccades in the horizontal semicircular canals demonstrated by the video head impulse test the day after CI surgery. One month after the operation VOR gain was normal (0.95 ± 0.05) and neither balance problems nor saccades occurred. Our findings indicate that vestibular dysfunction after CI surgery can be reversible, and VOR gain can return to normal.","author_count":4,"contributors":["Hviid Korsager, Leise Elisabeth","Schmidt, Jesper Hvass","Faber, Christian Emil","Wanscher, Jens Højberg"],"cuid":["S01-000.00-574151"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"forbigående tab af balancefunktionen efter cochlear implantation","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85025441838","version":"Other Version"},"id":"S01-000.00-574151","identifier":[{"id":"28115052","type":"pmid"},{"id":"85025441838","type":"scopus"}],"ids":["sdu-0345aa0a-2cf7-4ad3-9bfd-7084d52d9699"],"lang":"Danish","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-2-9DBD88DD4CC5F9E46EC8EED5C90572DA"],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Oto Rhino Laryngology (Odense)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Leise Elisabeth","key":"hviidkorsagerpau","last":"Hviid Korsager","locid":"04fd1226-1580-4e42-997d-319eec9c8286","name":"Hviid Korsager, Leise Elisabeth","orcid":"0000-0001-6906-4756","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper","key":"schmidtpau","last":"Schmidt","locid":"db84fc4e-28da-45af-a608-13ce8f4ec719","name":"Schmidt, Jesper Hvass","name_org":"Schmidt, Jesper","orcid":"0000-0001-7683-1407","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christian","key":"faberpau","last":"Faber","locid":"41aa4a5b-b537-43a3-942c-8beeae29c5c6","name":"Faber, Christian Emil","name_org":"Faber, Christian","orcid":"0000-0002-5078-6481","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens","key":"wanscherpau","last":"Wanscher","locid":"33130a0a-a7b5-4e60-b090-5a6e43f3396a","name":"Wanscher, Jens Højberg","name_org":"Wanscher, Jens","rank":4,"rolecode":"pau"}],"pmid":["28115052"],"pub":{"issn":["00415782","13994174"],"issn_org":["00415782"],"issue":"3","journal":"Ugeskrift for Læger","pages":"254-255","paperid":"V07160503","publisher":"Lægeforeningen","status":"p","title":"Ugeskrift for Læger","volume":"179"},"review":"Peer Reviewed","scoID":["2-s2.0-85025441838"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-0345aa0a-2cf7-4ad3-9bfd-7084d52d9699"],"src":["SDU University of Southern Denmark"],"title":"Forbigående tab af balancefunktionen efter cochlear implantation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-574151","year":"2017","yearsub":"2017"}
{"abstract":"Refixation saccades with normal gain value occur more frequently with increasing age. The phenomenon has also been observed in different vestibular disorders. In this case, we present a young male with normal gain value and refixation saccades tested with the video head impulse test (vHIT) the day after his cochlear implantation. One month after surgery, refixation saccades were no longer present. This suggests that refixation saccades can occur as a result of temporary pathology such as surgery. Refixation saccades with normal gain values might reflect a partial deficit in the vestibulo-ocular reflex. However, this partial deficit is in conflict with the current way of interpreting vHIT results in which the vestibular function is classified as either normal or pathological based only on the gain value. Refixation saccades, which are evident signs of vestibulopathy, are not considered in the evaluation. A new way of interpreting the vHIT based on the saccades must be considered.","author_count":4,"contributors":["Hviid Korsager, Leise Elisabeth","Faber, Christian Emil","Schmidt, Jesper Hvass","Wanscher, Jens Højberg"],"cuid":["S01-000.00-596115"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Hviid Korsager, Leise Elisabeth"],"keyword":["Cochlear implant","Vestibular function","Vestibulo ocular reflex","Video head impulse test"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"refixation saccades with normal gain values a diagnostic problem in the video head impulse test a case report","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fneur.2017.00081","version":"Published Version"},"id":"S01-000.00-596115","identifier":[{"id":"28352247","type":"pmid"},{"id":"85016142305","type":"scopus"},{"id":"PMC5348540","type":"pmcid"}],"ids":["sdu-4fddda17-f441-4fef-bd2b-c63b3e02bf93"],"keyword":["Cochlear implant","Refixation saccades","Vestibular function","Vestibulo-ocular reflex","Video head impulse test"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-5AF165F088B8AAA221EE8173F02BAB2F"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fneur.2017.00081","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/124323067/Refixation_saccades_with_normal_gain_values.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Oto Rhino Laryngology (Odense)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Leise Elisabeth Hviid","key":"korsagerpau","last":"Korsager","locid":"04fd1226-1580-4e42-997d-319eec9c8286","name":"Hviid Korsager, Leise Elisabeth","name_org":"Korsager, Leise Elisabeth Hviid","orcid":"0000-0001-6906-4756","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christian Emil","key":"faberpau","last":"Faber","locid":"41aa4a5b-b537-43a3-942c-8beeae29c5c6","name":"Faber, Christian Emil","orcid":"0000-0002-5078-6481","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper Hvass","key":"schmidtpau","last":"Schmidt","locid":"db84fc4e-28da-45af-a608-13ce8f4ec719","name":"Schmidt, Jesper Hvass","orcid":"0000-0001-7683-1407","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens Højberg","key":"wanscherpau","last":"Wanscher","locid":"33130a0a-a7b5-4e60-b090-5a6e43f3396a","name":"Wanscher, Jens Højberg","rank":4,"rolecode":"pau"}],"pmid":["28352247"],"pub":{"doi":"10.3389/fneur.2017.00081","issn":["16642295"],"issue":"MAR","journal":"Frontiers in Neurology","paperid":"81","publisher":"Frontiers Research Foundation","status":"p","title":"Frontiers in Neurology","volume":"8"},"review":"Peer Reviewed","scoID":["2-s2.0-85016142305"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-4fddda17-f441-4fef-bd2b-c63b3e02bf93"],"src":["SDU University of Southern Denmark"],"title":"Refixation saccades with normal gain values : A diagnostic problem in the video head impulse test: A case report","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-596115","year":"2017","yearsub":"2017"}
{"abstract":"BACKGROUND: A limited amount of research has examined the effect of changing public open spaces on active living. This abstract presents the study protocol of an intervention study designed in an interdisciplinary collaboration built on principles of Community-Based Participatory Research (CBPR) to develop urban installations highly tailored to promote active living among children (10-13-years-old) and seniors (>60-years-old) in a deprived neighbourhood in Copenhagen. METHODS: The study builds on a quasi-experimental study design including two sub-studies: 1) a children study and 2) a senior study. During spring 2017 the interventions will be developed, designed and implemented in collaboration with local children and seniors, respectively, using different co-design tools and methods. We will evaluate the effect of the interventions on children’s and senior’s use of the new-built urban installations using accelerometers in combination wit GPS and the System for Observing Play and Recreation in Communities (SOPARC). A process evaluation based on elements from the re-aim model will be conducted with focus groups consisting of the various stakeholders in the two sub-studies. The process evaluation will be used to gain knowledge of the intervention processes. DISCUSSION: The study presents new methods and approaches in the field of public open space interventions through interdisciplinary collaboration, participatory co-design approach and combination of measurements. Using both effect and process evaluations the study will provide unique insights in the role and importance of the interdisciplinary collaboration, participatory processes, tailoring changes in public open space to local needs and wishes. These results can be used to guide urban renewal projects in deprived neighbourhoods in the future.","author_count":10,"contributors":["Pawlowski, Charlotte Skau","Winge, Laura","Carroll, Sidse","Schmidt, Tanja Bettina","Wagner, Anne Margrethe","Nørtoft, Kamilla Pernille Johansen","Lamm, Bettina","Kural, René","Schipperijn, Jasper","Troelsen, Jens"],"cuid":["S02-088.46-012480"],"event":{"end":"2017-06-10","place":"Victoria, ca","start":"2017-06-07","title":"16th Annual Meeting of the International Society of Behavioral Nutrition and Physical Activity","year":"2017"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med","soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-ART","DI-U"],"level3":{"ART":["DI-ART-ALL","DI-ART-RDKA"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-ART-RDKA","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"move the neighborhood study design of a community based participatory public open space intervention","src":["arkc","sdu"],"src-code":["DI-ART-RDKA","DI-U-SDU"],"type":"dco","type-grp":["all","pub"]},"id":"S02-088.46-012480","ids":["arkc-d72ec515-823e-4751-83f0-83757b7130c1","sdu-73ac2287-14b8-4442-878a-79791ccf7069"],"keyword":["No"],"lang":"English","level":"Scientific","mra":["Medical Science","Social Science"],"noi":["Local-1-2-169F033D2991CF71CED54C2F83106880"],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics, Research Unit of Active Living"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"3","key":"royal danish academy architecture design conservation","l2":"DI-ART","l2n":"Artistic Higher Education Institutions","l3":"DI-ART-RDKA","l3nn":"Royal Danish Academy - Architecture, Design, Conservation","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Royal Danish Academy - Architecture, Design, Conservation","namevar":["Royal Danish Academy - Architecture, Design, Conservation, Royal Danish Academy - Architecture, Institute of Architecture, Urbanism and Landscape","The Royal Danish Academy of Fine Arts, Schools of Architecture, Design and Conservation"],"nora_code":"DI-ART-RDKA","used":1},{"affno":"4","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Charlotte Skau","key":"pawlowskipau","last":"Pawlowski","locid":"889b5a08-7360-484e-84ad-5baea5e669df","name":"Pawlowski, Charlotte Skau","orcid":"0000-0003-1407-613X","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Laura","key":"wingepau","last":"Winge","name":"Winge, Laura","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Sidse","key":"carrollpau","last":"Carroll","locid":"9365a1a1-aaef-4b10-8535-260b41056755","name":"Carroll, Sidse","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Tanja Bettina","key":"schmidtpau","last":"Schmidt","locid":"b1fba9ea-1959-49a9-be0a-9a4b9cd6ba1a","name":"Schmidt, Tanja Bettina","orcid":"0000-0003-2476-8711","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Anne Margrethe","key":"wagnerpau","last":"Wagner","name":"Wagner, Anne Margrethe","rank":5,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Kamilla Pernille Johansen","key":"nørtoftpau","last":"Nørtoft","name":"Nørtoft, Kamilla Pernille Johansen","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Bettina","key":"lammpau","last":"Lamm","name":"Lamm, Bettina","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"René","key":"kuralpau","last":"Kural","locid":"b1c4572f-48fa-4d47-8038-90720e3c072d","name":"Kural, René","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jasper","key":"schipperijnpau","last":"Schipperijn","locid":"164cb44f-53ef-4f1a-9605-8112d837fcca","name":"Schipperijn, Jasper","orcid":"0000-0002-6558-7610","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens","key":"troelsenpau","last":"Troelsen","locid":"b35581eb-1482-4559-a4dd-49ec75e4c8a9","name":"Troelsen, Jens","orcid":"0000-0001-8105-0349","rank":10,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Artistic Higher Education Institutions","All Danish Affiliations","All Universities","Artistic Higher Education Institutions","DI-ALL","DI-ART","DI-ART-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["arkc-d72ec515-823e-4751-83f0-83757b7130c1","sdu-73ac2287-14b8-4442-878a-79791ccf7069"],"src":["Royal Danish Academy - Architecture, Design, Conservation","SDU University of Southern Denmark"],"title":"Move the Neighborhood : Study design of a community-based participatory public open space intervention","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-088.46-012480","year":"2017","yearsub":"2017"}
{"abstract":"Context: Short-term glucocorticoid exposure increases serum insulinlike growth factor I (IGF-I) concentrations but antagonizes IGF-I tissue signaling. The underlying mechanisms remain unknown. Objective: To identify at which levels glucocorticoid inhibits IGF-I signaling. Design and Methods: Nineteen healthy males received prednisolone (37.5 mg/d) and placebo for 5 days in a randomized, double-blinded, placebo-controlled crossover study. Serum was collected on days 1, 3, and 5, and abdominal skin suction blister fluid (SBF; ~interstitial fluid) was taken on day 5 (n = 9) together with muscle biopsy specimens (n = 19). The ability of serum and SBF to activate the IGF-I receptor (IGF-IR) (bioactive IGF) and its downstream signaling proteins was assessed using IGF-IR-transfected cells. Results: Prednisolone increased IGF-I concentrations and bioactive IGF in serum (P#0.001) but not in SBF, which, compared with serum, contained less bioactive IGF (~28%) after prednisolone (P,0.05). This observation was unexplained by SBF concentrations of IGFs and IGF-binding proteins (IGFBPs) 1 to 4. However, following prednisolone treatment, SBF contained less IGFBP-4 fragments (P , 0.05) generated by pregnancy-associated plasma protein A (PAPP-A). Concomitantly, prednisolone increased SBF levels of stanniocalcin 2 (STC2) (P = 0.02) compared with serum. STC2 blocks PAPPA from cleaving IGFBP-4. Finally, prednisolone suppressed post-IGF-IR signaling pathways at the level of insulin receptor substrate 1 (P,0.05) but did not change skeletal muscle IGF-IR, IGF-I, or STC2 messenger RNA. Conclusion: Prednisolone increased IGF-I concentrations and IGF bioactivity in serum but not in tissue fluid. The latter may relate to a STC2-mediated inhibition of PAPP-A in tissue fluids. Furthermore, prednisolone induced post-IGF-IR resistance. Thus, glucocorticoid may exert distinct, compartment-specific effects on IGF action.","author_count":12,"contributors":["Ramshanker, Nilani","Aagaard, Maiken","Hjortebjerg, Rikke","Voss, Thomas Schmidt","Møller, Niels","Jørgensen, Jens Otto Lunde","Jessen, Niels","Bjerring, Peter","Magnusson, Nils E","Bjerre, Mette","Oxvig, Claus","Frystyk, Jan"],"cuid":["S02-098.85-024785"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"keyword":["Adult","Blood Chemical Analysis","Cross Over Studies","Double Blind Method","Extracellular Fluid metabolism","Humans","Insulin Like Growth Factor I metabolism","Insulin Like Growth Factor II metabolism","Journal Article","Male","Placebos","Signal Transduction drug effects","Young Adult"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-OTH"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-OTH","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"effects of prednisolone on serum and tissue fluid igf i receptor activation and post receptor signaling in humans","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85037991605","version":"Other Version"},"id":"S02-098.85-024785","identifier":[{"id":"85037991605","type":"scopus"},{"id":"28945869","type":"pmid"}],"ids":["au-a5a8588d-d1dc-4191-93f7-3f6ec97e9260","sdu-f15ee515-f53a-4de8-9f59-111da47c1a0d"],"keyword":["Adult","Blood Chemical Analysis","Cross-Over Studies","Double-Blind Method","Extracellular Fluid/metabolism","Humans","Insulin-Like Growth Factor Binding Proteins/blood","Insulin-Like Growth Factor I/metabolism","Insulin-Like Growth Factor II/metabolism","Journal Article","Male","Muscles/drug effects","Placebos","Prednisolone/pharmacology","Receptor, IGF Type 1/blood","Signal Transduction/drug effects","Young Adult"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-121C240E89407DF89808FA85492B79E7"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Medical Research Laboratory"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"other hospitals","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-OTH","l3nl":"Other Hospitals","l3nn":"Other Hospitals","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Hospitals","namevar":["Mølholm Private Hospital"],"nora_code":"DI-HO-OTH","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Endocrinology (Odense)","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of SDCO - Steno Diabetes Center Odense"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Nilani","key":"ramshankerpau","last":"Ramshanker","locid":"13be0eb8-64de-4dbe-82c8-32ac137997d6","name":"Ramshanker, Nilani","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Maiken","key":"aagaardpau","last":"Aagaard","locid":"e333a5de-8449-47b2-88d5-28135633a674","name":"Aagaard, Maiken","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rikke","key":"hjortebjergpau","last":"Hjortebjerg","locid":"d7f05783-92a6-4c22-9d46-9bd0128122b4","name":"Hjortebjerg, Rikke","rank":3,"rolecode":"pau"},{"affno"