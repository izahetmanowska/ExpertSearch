OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research"],"nora_code":"DI-U-SDU","used":1},{"affno":"4","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Braintrust Consult, Odense, Denmark"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Marco","key":"doniapau","last":"Donia","name":"Donia, Marco","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Eva","key":"ellebækpau","last":"Ellebæk","name":"Ellebæk, Eva","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Trine Heide","key":"øllegaardpau","last":"Øllegaard","name":"Øllegaard, Trine Heide","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lone","key":"duvalpau","last":"Duval","name":"Duval, Lone","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jens","key":"bullaabypau","last":"Bull Aaby","locid":"24b24789-abea-41ca-af4c-c95ea8b962ad","name":"Aaby, Jens Bull","name_org":"Bull Aaby, Jens","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Lise","key":"højbergpau","last":"Højberg","locid":"1374d702-4d1a-42df-a467-a1c7ce0e3800","name":"Hoejberg, Lise","name_org":"Højberg, Lise","rank":6,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Ulrich Heide","key":"køhlerpau","last":"Køhler","name":"Køhler, Ulrich Heide","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"H.","key":"schmidtpau","last":"Schmidt","name":"Schmidt, H.","rank":8,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Lars","key":"bastholtpau","last":"Bastholt","locid":"8228749a-ec51-42aa-91a1-c0ec476093bb","name":"Bastholt, Lars","orcid":"0000-0001-5478-9826","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Inge Marie","key":"svanepau","last":"Svane","name":"Svane, Inge Marie","rank":10,"rolecode":"pau"}],"pub":{"doi":"10.1093/annonc/mdy486.013","issn":["09237534","11320109"],"issn_org":["09237534"],"issue":"Suppl. 10","journal":"Annals of Oncology","publisher":"Elsevier","status":"p","title":"Annals of Oncology","volume":"29"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-082e5767-4549-4731-a7df-95f689388f41"],"src":["SDU University of Southern Denmark"],"title":"The real-world impact of cancer immunotherapy on the survival of patients with metastatic melanoma","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-575532","year":"2018","yearsub":"2018"}
{"abstract":"INTRODUCTION: The rotating 6-hydroxydopamine (6-OHDA) rat model has long been important when developing new treatment strategies for Parkinson's disease (PD). Similar non-human primate models have been developed for translational research purposes as large animal models are required by regulatory bodies as an intermediate \"phase 0\" trial step. However, experimental research in non-human primates encounters several economical and regulatory issues, which may be avoided by the alternative use of pigs as a large animal model for experimental brain research. OBJECTIVE: The primary aim of this study was to examine if unilateral injections of 6-OHDA into the Göttingen minipig nigrostriatal pathway would lead to dopaminergic imbalance and rotational behavior similar to the 6-OHDA unilateral symptomatic model of PD created in other species. The secondary aim was to attempt to verify the rotational behavior as a parkinsonian symptom using subthalamic deep brain stimulation (STN-DBS) to minimize the elicited rotational pattern. MATERIALS AND METHODS: Using an MRI-based stereotactic procedure, ten female Göttingen minipigs were injected unilaterally with 6-OHDA in the nigrostriatal pathway. Postoperatively, an MRI was performed, and the animals were injected with amphetamine and apomorphine and observed for rotational behavior. After a survival period of three months the brains were removed and immunohistochemically stained for tyrosine hydroxylase (TH). One week before sacrifice two animals had DBS electrodes unilaterally implanted in the subthalamic nucleus and various stimulation protocols were conducted during amphetamine challenge. RESULTS: As expected most animals rotated towards the side of the lesion when given amphetamine (3.5-4.0 mg/kg), whereas the predicted opposite response to apomorphine were much harder to reproduce. T1- and T2-weighted postoperative MRI could demonstrate the size and the location of the 6-OHDA injection. Postmortem TH-staining of the final two animals receiving a medial and a lateral injection of 25 μL of 6-OHDA (8 μg/μL, injection rate 5 μL/min) into the diencephalic nigrostriatal pathway showed a prominent unilateral decrease in TH-staining of the substantia nigra pars compacta, the ventral tegmental area and the nigrostriatal pathway on the lesioned side. These two animals displayed spontaneous rotational behavior toward the lesioned side for the first 2-3 days postoperatively, and this behavior could later on be reelicited by amphetamine and attenuated by ipsilateral STN-DBS. CONCLUSION: Female Göttingen minipigs are susceptible to unilateral dopaminergic degeneration when properly injected unilaterally with sufficient amounts of 6-OHDA in the nigrostriatal pathway. The location of the 6-OHDA injections and thus the accuracy of the employed stereotaxy can be verified in vivo using MRI postoperatively. The injected minipigs display unilateral parkinsonism with a well-defined rotational response to amphetamine that may be ameliated by STN-DBS performed on the lesioned side. The response to apomorphine was, however, not consistent, illustrating that further work on this promising non-primate large animal model is needed, before it is fully similar to the established 6-OHDA models in other species.","author_count":5,"contributors":["Christensen, Anette Bro","Sørensen, Jens Christian Hedemann","Ettrup, Kåre Schmidt","Orlowski, Dariusz","Bjarkam, Carsten Reidies"],"cuid":["S02-100.00-011338"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["6 hydroxydopamine","Amphetamine","Apomorphine","Dopamine","Göttingen minipig","Parkinson s disease"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-NDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-HO-NDR","DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"pirouetting pigs a large non primate animal model based on unilateral 000000000006 hydroxydopamine lesioning of the nigrostriatal pathway","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85042876153&partnerID=8YFLogxK","version":"Other Version"},"id":"S02-100.00-011338","identifier":[{"id":"29462643","type":"pmid"},{"id":"85042876153","type":"scopus"}],"ids":["aau-ed74ae0b-bec5-4d53-aa0f-5b6b085079a1","au-ccd5bc16-c0cf-4716-b824-16120a8e0cab"],"keyword":["6-hydroxydopamine","Amphetamine","Apomorphine","Dopamine","Göttingen minipig","Parkinson's disease"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-0CD49E8B56A04C3C17BB80EEB653F2CE"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Anaesthesiology and Intensive Care","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Anæstesi, Børn, Kredsløb og Kvinder","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Neurosurgery"],"nora_code":"DI-U-AU","used":1},{"affno":"3","country":"dk","key":"north denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-NDR","l3nl":"North Denmark Region","l3nn":"North Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"North Denmark Region","namevar":["Aalborg University Hospital"],"nora_code":"DI-HO-NDR","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anette Bro","key":"christensenpau","last":"Christensen","locid":"dce30978-02c1-4ec3-a92f-85ac79bfe0a3","name":"Christensen, Anette Bro","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jens Christian Hedemann","key":"sørensenpau","last":"Sørensen","locid":"f442e934-3b4d-4fc2-91dc-93621be94d60","name":"Sørensen, Jens Christian Hedemann","orcid":"0000-0001-5139-7405","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kåre Schmidt","key":"ettruppau","last":"Ettrup","locid":"2bdb42e7-d104-4bd2-9d0d-718e033a883d","name":"Ettrup, Kåre Schmidt","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Dariusz","key":"orlowskipau","last":"Orlowski","locid":"d6cdf54a-52e1-4496-9785-da0ef112b26c","name":"Orlowski, Dariusz","orcid":"0000-0002-9542-402X","rank":4,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"country":"dk","first":"Carsten Reidies","key":"bjarkampau","last":"Bjarkam","locid":"a05346d7-147b-4c78-8bc5-1f6c771af2c6","name":"Bjarkam, Carsten Reidies","orcid":"0000-0002-0164-9595","rank":5,"rolecode":"pau"}],"pmid":["29462643"],"pub":{"doi":"10.1016/j.brainresbull.2018.02.010","issn":["03619230","18732747"],"issn_org":["03619230"],"journal":"Brain Research Bulletin","pages":"167-173","publisher":"Elsevier Inc.","status":"p","title":"Brain Research Bulletin","volume":"139"},"review":"Peer Reviewed","scoID":["2-s2.0-85042876153"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Universities"],"PST":["Published"]},"sid":["aau-ed74ae0b-bec5-4d53-aa0f-5b6b085079a1","au-ccd5bc16-c0cf-4716-b824-16120a8e0cab"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Pirouetting pigs : A large non-primate animal model based on unilateral 6-hydroxydopamine lesioning of the nigrostriatal pathway","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-011338","year":"2018","yearsub":"2018"}
{"abstract":"PURPOSE: Diabetic retinopathy (DR) is among the leading causes of visual loss in the working-age population. It is generally accepted that screening of DR is cost-effective and can detect DR before it becomes sight-threatening to allow timely treatment. METHODS: A group of retinal specialists was formed by the Danish Ophthalmological Society with the aim to formulate contemporary evidence-based guidelines for screening of DR in order to implement these in the Danish screening system. RESULTS: We hereby present evidence for DR-screening regarding (1) classification of DR, (2) examination techniques, (3) screening intervals and (4) automated screening. It is our recommendation that the International Clinical Retinopathy Disease Severity Scale should be used to classify DR. As a minimum, mydriatic two-field disc- and macular-centred images are required. In the case of suspected clinically significant diabetic macular oedema, supplementary optical coherence tomography can increase the diagnostic accuracy. There is solid evidence to support a flexible, individualized screening regimen. In particular, it is possible to prolong screening intervals to 24-48 months for patients with no or mild nonproliferative diabetic retinopathy (NPDR), but it is also possible to use extended intervals of 12-24 months for patients with moderate NPDR given that these are well-regulated regarding glycaemic control (HbA1c ≤ 53 mmol/mol) and blood pressure (≤130/80 mmHg). Automated screening of DR is encouraging but is not ready for implementation at present. CONCLUSION: Danish evidenced-based guidelines for screening of DR support high-quality imaging and allow flexible, individualized screening intervals with a potential for extension to patients with low risk of DR progression.","author_count":11,"contributors":["Grauslund, Jakob","Andersen, Nis","Andresen, Jens","Flesner, Per","Haamann, Per","Heegaard, Steffen","Larsen, Michael","Laugesen, Caroline Schmidt","Schielke, Katja Christina","Skov, Jesper","Bek, Toke"],"cuid":["S04-100.00-011677"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"keyword":["Denmark epidemiology","Diabetic Retinopathy epidemiology","Diabetic retinopathy","Evidence","Guideline","Humans","Mass Screening standards","Morbidity trends","Ophthalmology","Practice Guidelines as Topic","Proliferative diabetic retinopathy","Screening","Societies Medical","clinically significant diabetic macular oedema"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-OTH","DI-HO-SDR","DI-HO-ZEA"],"OT":["Unspecified organisation"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-OTH","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"evidence based danish guidelines for screening of diabetic retinopathy","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/156010658/Evidence_based_Danish_guidelines_for_screening_of_diabetic_retinopathy.pdf","version":"Authors Final Version"},"id":"S04-100.00-011677","identifier":[{"id":"000451694500001","type":"wos"},{"id":"85054855212","type":"scopus"},{"id":"30311394","type":"pmid"}],"ids":["aau-f4350202-bb68-4df1-a8d8-60e04d11d195","au-8233361c-9707-4475-9ca8-c283df9e213c","ku-5bda1499-9e4c-410e-9537-64c8fcbef149","sdu-3f0eac3e-a3dc-49a7-b813-29c3644d8405"],"keyword":["Denmark/epidemiology","Diabetic Retinopathy/epidemiology","Humans","Mass Screening/standards","Morbidity/trends","Ophthalmology","Practice Guidelines as Topic","Societies, Medical","clinically significant diabetic macular oedema","diabetic retinop