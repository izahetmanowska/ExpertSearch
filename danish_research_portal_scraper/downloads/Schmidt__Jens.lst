o":"1","corresponding":null,"country":"dk","first":"Birte","key":"boeltpau","last":"Boelt","locid":"f856feb6-10e1-4936-a4e5-0ccee7073cc5","name":"Boelt, Birte","orcid":"0000-0003-4277-0196","rank":18,"rolecode":"pau"},{"affno":"2","first":"Annette Bruun","key":"jensenpau","last":"Jensen","locid":"90debd3e-8e04-4f72-a4eb-05d4905b158a","name":"Jensen, Annette Bruun","orcid":"0000-0002-2044-2274","rank":19,"rolecode":"pau"},{"affno":"2","first":"Antoine","key":"lecocqpau","last":"Lecocq","locid":"7cbea140-f71f-402c-ad26-b13f16fe6d8e","name":"Lecocq, Antoine","orcid":"0000-0002-8013-0221","rank":20,"rolecode":"pau"},{"affno":"","first":"Andrew Gordon","key":"howepau","last":"Howe","locid":"ea2fa9c9-f259-4223-9d49-fce411103cf2","name":"Howe, Andrew Gordon","orcid":"0000-0002-7460-5227","rank":21,"rolecode":"pau"},{"affno":"2","first":"Mette","key":"termansenpau","last":"Termansen","locid":"48b59095-1afe-4154-a774-d4087885a61a","name":"Termansen, Mette","orcid":"0000-0003-4875-2810","rank":22,"rolecode":"pau"}],"pub":{"issn":["13992309"],"issue":"4","journal":"Aktuel Naturvidenskab","pages":"2","status":"p","title":"Aktuel Naturvidenskab","volume":"2019"},"review":"Undetermined","search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-c8b9032b-c987-4617-9d59-bc1e51d99ba8","ku-0dbd7bdd-e904-4c5e-8569-897f9446c64e"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"En fælles front for alle bier","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-089.13-027217","year":"2019","yearsub":"2019"}
{"abstract":"BACKGROUND: Glucocorticoid (GC) excess increases lipolysis, circulating free fatty acid concentrations and lipid oxidation rates in humans. In vitro and animal studies have shown that GCs increase adipocyte ATGL and HSL mRNA contents and HSL phosphorylations, but the effects of GC on in vivo lipase signaling in humans are uncertain. Our study was designed to test how GC administration affects ATGL and HSL related signals in human adipose tissue. MATERIAL AND METHODS: Nine healthy young men underwent 5 days administration of 37.5 mg prednisolone/d in a randomized, double-blinded, placebo-controlled crossover design. At the end of each 5 d period the subjects were studied after an overnight fast for 6.5 h including a basal period and a 2½ h hyperinsulinemic euglycemic clamp. Adipose tissue biopsies were sampled from the abdominal subcutaneous adipose tissue at the end of the basal period and the clamp. RESULTS: GC treatment increased serum FFA concentrations and comparative gene identification-58 (CGI-58) mRNA - an ATGL activator - and decreased G0/G1 switch 2 gene (G0S2) mRNA - an ATGL inhibitor - in adipose tissue biopsies. In addition, pro-lipolytic ser563 HSL phosphorylations and protein kinase A (PKA) phosphorylation of PLIN1 (Perilipin-1) increased. The transcripts of ANGPTL4 (Angiopoietin-like 4) mRNA - a regulator of circulating triglycerides - were elevated by GC; as were CIDE (Cell-death Inducing DNA fragmentation factor-α-like Effector)-A and CIDE-C mRNA transcripts indicative of concurrent stimulation of lipolysis and lipogenesis. Finally GCs reduced insulin receptor phosphorylation, and Akt protein levels. CONCLUSIONS: High dose GC administration to humans leads to pro-lipolytic alterations of CGI-58, G0S2 and ANGPTL4 mRNA transcripts, increases PKA signaling to lipolysis and inhibits the insulin signal in adipose tissue. The increased CIDE-A and CIDE-C mRNA levels suggest concomitant stimulation of lipolysis and lipid storage.","author_count":8,"contributors":["Ramshanker, Nilani","Jessen, Niels","Voss, Thomas Schmidt","Pedersen, Steen Bønløkke","Jørgensen, Jens Otto Lunde","Nielsen, Thomas Svava","Frystyk, Jan","Møller, Niels"],"cuid":["S02-091.18-029811"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Adipose tissue","Glucocorticoid","Insulin Resistance","Lipolysis"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"effects of short term prednisolone treatment on indices of lipolysis and lipase signaling in abdominal adipose tissue in healthy humans","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85068502860","version":"Other Version"},"id":"S02-091.18-029811","identifier":[{"id":"85068502860","type":"scopus"},{"id":"31260678","type":"pmid"}],"ids":["au-ec6b3fc7-d9b4-41f3-95fe-eae4a4b6e136","ku-d24dd574-02ba-447f-b428-7e6ba81104af"],"keyword":["Adipose tissue","Glucocorticoid","Insulin resistance","Lipolysis","cAMP/PKA pathway"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-205694B2B4AB2AB11FE89416D7A2652D"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Medical Research Laboratory"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Basic Metabolic Research, Integrative Metabolism and Environmental Influences","Københavns Universitet, Faculty of Health and Medical Sciences, Novo Nordisk Foundation Center for Basic Metabolic Research, Treebak Group"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Nilani","key":"ramshankerpau","last":"Ramshanker","locid":"13be0eb8-64de-4dbe-82c8-32ac137997d6","name":"Ramshanker, Nilani","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Niels","key":"jessenpau","last":"Jessen","locid":"f0d20e5e-d5b5-44da-980e-3e052af18b46","name":"Jessen, Niels","orcid":"0000-0001-5613-7274","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thomas Schmidt","key":"vosspau","last":"Voss","locid":"cec29a7a-aafc-4df3-9431-0e5895d745d2","name":"Voss, Thomas Schmidt","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Steen Bønløkke","key":"pedersenpau","last":"Pedersen","locid":"6fbce58b-23e6-41fa-b756-0b9558645564","name":"Pedersen, Steen Bønløkke","orcid":"0000-0002-7838-8063","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens Otto Lunde","key":"jørgensenpau","last":"Jørgensen","locid":"303ebe86-6861-4b19-b4d7-6bda0526b27e","name":"Jørgensen, Jens Otto Lunde","orcid":"0000-0001-7408-1526","rank":5,"rolecode":"pau"},{"affno":"2","first":"Thomas Svava","key":"nielsenpau","last":"Nielsen","locid":"a579c623-8238-41b9-92fd-0d670a5cac39","name":"Nielsen, Thomas Svava","orcid":"0000-0002-9457-8000","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jan","key":"frystykpau","last":"Frystyk","locid":"e3650a02-322d-46c8-9d0e-d467831ea56a","name":"Frystyk, Jan","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Niels","key":"møllerpau","last":"Møller","locid":"2e0d8e2a-2da1-4d55-b2da-0a25c0375b1e","name":"Møller, Niels","orcid":"0000-0001-5627-7322","rank":8,"rolecode":"pau"}],"pmid":["31260678"],"pub":{"doi":"10.1016/j.metabol.2019.06.013","issn":["00260495","15328600"],"issn_org":["00260495"],"journal":"Metabolism","pages":"1-10","publisher":"WB  Saunders","publisher_org":"W.B. Saunders","status":"p","title":"Metabolism","volume":"99"},"review":"Peer Reviewed","scoID":["2-s2.0-85068502860"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-ec6b3fc7-d9b4-41f3-95fe-eae4a4b6e136","ku-d24dd574-02ba-447f-b428-7e6ba81104af"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Effects of short-term prednisolone treatment on indices of lipolysis and lipase signaling in abdominal adipose tissue in healthy humans","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-091.18-029811","year":"2019","yearsub":"2019"}
{"abstract":"Seawater-based pretreatment of lignocellulosic biomass is an innovative process at research stage. With respect to process optimization, factors affecting seawater-based pretreatment of lignocellulosic date palm residues were studied for the first time in this paper. Pretreatment temperature (180–210 °C), salinity of seawater (0–50 ppt), and catalysts (H2SO4, Na2CO3, and NaOH) were investigated. The results showed that pretreatment temperature exerted the largest influence on seawater-based pretreatment in terms of the enzymatic digestibility and fermentability of pretreated solids and the inhibition of pretreatment liquids to Saccharomyces cerevisiae. Salinity showed the least impact to seawater-based pretreatment, which widens the application spectrum of saline water sources such as brines discharged in desalination plant. Sulfuric acid was the most effective catalyst for seawater-based pretreatment compared with Na2CO3 and NaOH.","author_count":9,"contributors":["Fang, Chuanji","Thomsen, Mette Hedegaard","Frankær, Christian Grundahl","Bastidas-Oyanedel, Juan-Rodrigo","Brudecki, Grzegorz Przemyslaw","Schmidt, Jens Ejbye"],"cuid":["S02-096.53-000227"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Asia, Middle East"],"country":["United Arab Emirates"],"glorg":["All Global Affiliations","Khalifa University","Khalifa University of Science and Technology"],"keyword":["Biorefinery","Date palm residues","Lignocellulosic biomass","Pretreatment","Seawater"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-DTU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-U-AAU","DI-U-DTU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"factors affecting seawater based pretreatment of lignocellulosic date palm residues","src":["aau","sdu"],"src-code":["DI-U-AAU","DI-U-SDU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85067017131","version":"Other Version"},"id":"S02-096.53-000227","identifier":[{"id":"85067017131","type":"scopus"}],"ids":["aau-0467c532-e09b-48e5-bc81-91c4f5f5f9f5","sdu-9ec37e4d-0fab-4479-be5b-c3bdd3e52dfe"],"keyword":["Biorefinery","Date palm residues","Lignocellulosic biomass","Pretreatment","Seawater"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-7AC61A9B4A23393357811C23F3FFBFCC"],"org":[{"affno":"1","country":"ae","key":"khalifa university of science and technology","loc":["United Arab Emirates","Asia, Middle East"],"name":"Khalifa University of Science and Technology","used":1},{"affno":"2","country":"ae","key":"khalifa university","loc":["United Arab Emirates","Asia, Middle East"],"name":"Khalifa University","used":1},{"affno":"3","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, AAU Energy","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Esbjerg Energy Section"],"nora_code":"DI-U-AAU","used":1},{"affno":"4","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"5","country":"dk","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","O