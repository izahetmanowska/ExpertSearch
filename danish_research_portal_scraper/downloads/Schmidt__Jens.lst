 Loldrup","rank":7,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Emil Loldrup","key":"fosbølemilloldruppau","last":"Fosbøl","name":"Fosbøl, Emil Loldrup","rank":7,"rolecode":"pau"},{"affno":"8 5","first":"Morten","key":"schoumortenpau","last":"Schou","locid":"48fa6ec9-1941-4566-b931-14b0cc8cbae3","name":"Schou, Morten","rank":8,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"country":"dk","first":"Peter","key":"søgaardpeterpau","last":"Søgaard","locid":"30606c01-a86b-4eee-90ef-b4268fedaee9","name":"Søgaard, Peter","rank":9,"rolecode":"pau"},{"affno":"8 5","first":"Gunnar","key":"gislasongunnarpau","last":"Gislason","locid":"c0f678a6-eb13-49a3-9485-8fae1e72e2a1","name":"Gislason, Gunnar","rank":10,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Christian","key":"torppedersenchristianpau","last":"Torp-Pedersen","name":"Torp-Pedersen, Christian","rank":11,"rolecode":"pau"},{"affno":"5 8","first":"Lars","key":"køberlarspau","last":"Køber","locid":"e3f0c57c-605a-431a-9c63-2213c46621e6","name":"Køber, Lars","rank":12,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"country":"dk","first":"Kristian","key":"kragholmkristianpau","last":"Kragholm","locid":"052ee38b-92bc-47d4-a37d-13fa99e39ddb","name":"Kragholm, Kristian","orcid":"0000-0001-9629-8670","rank":13,"rolecode":"pau"}],"pmid":["37619873"],"pub":{"doi":"10.1016/j.ijcard.2023.131283","issn":["01675273","18741754"],"issn_org":["01675273"],"journal":"International Journal of Cardiology","paperid":"131283","publisher":"Elsevier Ireland Ltd","status":"p","title":"International Journal of Cardiology","volume":"392"},"review":"Peer Reviewed","scoID":["2-s2.0-85169513129"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","North Denmark Region","Other R