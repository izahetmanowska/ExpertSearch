6","corresponding":null,"first":"Ryo","key":"kawasakipau","last":"Kawasaki","name":"Kawasaki, Ryo","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sören","key":"möllerpau","last":"Möller","locid":"905018dc-c6c4-4a79-b50d-d0c08618e77a","name":"Möller, Sören","orcid":"0000-0003-0858-4269","rank":13,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Katja Christina","key":"schielkepau","last":"Schielke","name":"Schielke, Katja Christina","rank":14,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lonny","key":"stokholmpau","last":"Stokholm","locid":"ab6bde17-94c0-482d-bb34-495daa518640","name":"Stokholm, Lonny","orcid":"0000-0002-9727-6649","rank":15,"rolecode":"pau"}],"pub":{"issn":["01460404","02730189"],"issn_org":["15525783"],"issue":"7","journal":"Investigative Ophthalmology & Visual Science","paperid":"812","status":"p","title":"Investigative Ophthalmology & Visual Science","volume":"67"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Other Hospitals","Region Zealand","Universities","University of Southern Denmark","lægeforeningen"],"PST":["Published"]},"sid":["sdu-0c59cb1b-f75c-4516-8442-fd05944b3481"],"src":["SDU University of Southern Denmark"],"title":"Presence and development of diabetic retinopathy in the Danish Registry of Diabetic Retinopathy","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-801626","year":"2022","yearsub":"2022"}
{"abstract":"Background and purpose — Despite increased attention to and acceptance of fast-track procedures, there is a lack of studies concerning discharge on the day of surgery (DOS) following total knee arthroplasty (SD-TKA). We evaluated the feasibility of SD-TKA, and compared safety and patient-reported outcomes (PROs) between patients undergoing SD-TKA and patients undergoing standard TKA. Patients and methods — A SD-TKA group (n = 101) was matched 1:1 to a standard TKA group (n = 101) on age, sex, and ASA score. Feasibility (being discharged on DOS), safety (unplanned contacts and complications evaluated by telephone calls (2 weeks), outpatient visits (2 weeks), and readmission (90 days)) were assessed. Further, Oxford Knee Score (OKS) and Visual Analogue Scale (VAS) (pain at rest and activity) were reported (90 days). Results — 89 of 101 SD-TKA patients were discharged on DOS. The number of telephone calls (≤ 83) and outpatient visits (12) were similar in the 2 groups. The number of read-missions was ≤ 3 in both groups, and only 1 of the readmis-sions was related to TKA surgery. No differences were found at 90-day follow-up in terms of OKS (34 in both groups) or VAS (rest: SD-TKA = 7 and standard TKA = 8; activity: SD-TKA = 17 and standard TKA = 15). Interpretation — SD-TKA is feasible in a selected group of patients, and safety and PROs are comparable to patients undergoing standard TKA.","author_count":10,"contributors":["Schmidt, Anne Mette","Garval, Mette","Gromov, Kirill","Holm, Carsten","Larsen, Jens Rolighed","Runge, Charlotte","Vase, Morten","Mikkelsen, Lone Ramer","Mortensen, Louise","Skou, Søren T."],"cuid":["S03-099.56-016318"],"filters":{"added":"2022-07","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"corresponding_author":["Schmidt, Anne Mette"],"keyword":["Arthroplasty Replacement Knee adverse effects","Cohort Studies","Feasibility Studies","Humans","Patient Discharge","Patient Reported Outcome Measures"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"feasibility safety and patient reported outcomes 000000000090 days after same day total knee arthroplasty a matched cohort study","src":["au","ku","sdu"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.2340/17453674.2022.2807","version":"Published Version"},"id":"S03-099.56-016318","identifier":[{"id":"85131225779","type":"scopus"},{"id":"35642499","type":"pmid"}],"ids":["au-32d9a6b4-6dc5-411a-a375-763b5fc641de","ku-8e05f75a-a4a9-48a3-a791-dd16f038ae15","sdu-78acfc6b-93b5-437c-a9a9-1552f6ce869e"],"keyword":["Arthroplasty, Replacement, Knee/adverse effects","Cohort Studies","Feasibility Studies","Humans","Patient Discharge","Patient Reported Outcome Measures"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-5F3CE5B0EAC64B29BD6215E1050CCFED"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://curis.ku.dk/ws/files/325710493/16140_SCHMIDT_D.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.2340/17453674.2022.2807","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/202980273/document_2_.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus Un