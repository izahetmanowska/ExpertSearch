3-d1e0-4e2b-b81a-ec68717308d8","dtu-47e3a2c0-9bc1-403a-ab99-3e797d54b180"],"src":["AU Aarhus University","DTU Technical University of Denmark"],"title":"Consequences of field N2O emissions for the environmental sustainability of plant-based biofuels produced within an organic farming system","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-098.12-023184","year":"2012","yearsub":2012}
{"abstract":"Lucerne (Medicago sativa) has many qualities associated with sustainable agriculture such as nitrogen fixation and high biomass yield. Therefore, there is interest in whether lucerne is a suitable biomass substrate for bioethanol production, and if hydrothermal pretreatment (HTT) of lucerne improves enzymatic convertibility, providing sufficient enzymatic conversion of carbohydrate to simple sugars for ethanol production. The HTT process was optimised for lucerne hay, and the pretreated biomass was assessed by carbohydrate analysis, inhibitor characterisation of liquid phases, and by simultaneous saccharification and fermentation (SSF) of the whole slurry with Cellubrix enzymes and Saccharomyces cerevisiae yeast. The optimal HTT conditions were 205 degrees C for 5 minutes, resulting in pentose recovery of 81%, and an enzymatic convertibility of glucan to monomeric glucose of 74%, facilitating a conversion of 6.2% w/w of untreated material into bioethanol in SSF, which is equivalent to 1,100 litre ethanol per hectare per year.","author_count":3,"contributors":["Thomsen, Sune Tjalfe","Jensen, Morten","Schmidt, Jens Ejbye"],"cuid":["S02-099.77-033901"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Alfalfa","Bioethanol","Biomass","Cellulose","Chemical composition","Dilute acid pretreatment","Enzymatic hydrolysis","Ethanol production","Fermentation","Lucerne","Materials","Pretreatment","Steam explosion","Sugarcane bagasse","Wheat straw"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"production of 000000000002 sup nd sup generation bioethanol from lucerne optimization of hydrothermal pretreatment","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/10262319/Production_of_2nd_generation.pdf","version":"Published Version"},"id":"S02-099.77-033901","identifier":[{"id":"84863816879","type":"scopus"}],"ids":["dtu-3aa643d4-e9e7-4859-b83d-8845fc24716e","ku-a76c3f30-805c-4b67-b1d9-99a72e5979c9"],"keyword":["ALFALFA","Bioethanol","Biomass","CELLULOSE","Chemical composition","DILUTE-ACID PRETREATMENT","ENZYMATIC-HYDROLYSIS","ETHANOL-PRODUCTION","FERMENTATION","Lucerne","MATERIALS","Pretreatment","STEAM EXPLOSION","SUGARCANE BAGASSE","WET OXIDATION PRETREATMENT","WHEAT-STRAW"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-2-426343CA2CB4636BFEFC7B60F7C5D72D"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/10262319/Production_of_2nd_generation.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Chemical and Biochemical Engineering","Technical University of Denmark, Department of Chemical and Biochemical Engineering, Center for BioProcess Engineering"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Neuroscience","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Neuroscience, Neuropharm and Genetics"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"d