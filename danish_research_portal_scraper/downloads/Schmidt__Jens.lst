y":"madsbadstenpau","last":"Madsbad","locid":"1018c708-245a-4057-9263-074578042385","name":"Madsbad, Sten","rank":9,"rolecode":"pau"},{"affno":"3","first":"T R C","key":"clausentrcpau","last":"Clausen","name":"Clausen, T R C","rank":10,"rolecode":"pau"},{"affno":"1","first":"Christian","key":"ritzchristianpau","last":"Ritz","locid":"c881424f-d529-443e-b60e-bc2edb674ede","name":"Ritz, Christian","orcid":"0000-0002-5095-0624","rank":11,"rolecode":"pau"},{"affno":"1","first":"Arne","key":"astruparnepau","last":"Astrup","locid":"5d943631-c9fc-4b63-8aaa-263ba4248735","name":"Astrup, Arne","orcid":"0000-0001-8968-8996","rank":12,"rolecode":"pau"},{"affno":"1","first":"Anders Mikael","key":"sjödinandersmikaelpau","last":"Sjödin","locid":"24ea7b85-2a13-44ec-93f5-fb419b0ab4fd","name":"Sjödin, Anders Mikael","orcid":"0000-0002-6451-3847","rank":13,"rolecode":"pau"}],"pub":{"issn":["16624025","16624033"],"issn_org":["16624025"],"issue":"suppl. 1","journal":"Obesity Facts","pages":"28","status":"p","title":"Obesity Facts","volume":"6"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Hospitals","All Private Research","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Hospitals","Novo Nordisk","Private Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-b8bf5f42-1754-4949-9ffc-3133f9086e28"],"src":["KU University of Copenhagen"],"title":"The effect of Roux-en-Y gastric bypass surgery on energy expenditure and appetite: a randomized human study including “pair fed” control subjects","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-503723","year":"2013","yearsub":"2013"}
{"abstract":"Aging is thought to be associated with decreased vascular function partly due to oxidative stress. Resveratrol is a polyphenol, which, in animal studies has been shown to decrease atherosclerosis, improve cardiovascular health and physical capacity, in part through its effects on Sirtuin 1 signaling and through an improved antioxidant capacity. We tested the hypothesis that resveratrol supplementation enhances training-induced improvements in cardiovascular health parameters in aged men. Twenty-seven healthy physically inactive aged men (age: 65 ± 1 years; BMI: 25.4 ± 0.7 kg/m2; MAP: 95.8 ± 2.2 mmHg; maximal oxygen uptake: 2488 ± 72 ml O2 min-1) were randomized into 8 weeks of either daily intake of either 250 mg trans resveratrol (n = 14) or of placebo (n = 13) concomitant with high-intensity exercise training. Exercise training lead to a 45% greater (P <0.05) increase in maximal oxygen uptake in the placebo group than in the resveratrol group and to a decrease in MAP in the placebo group only (-4.8 ± 1.7 mmHg; P <0.05). The interstitial level of vasodilator prostacyclin was lower in the resveratrol than in the placebo group after training (980 ± 90 versus 1174 ± 121 pg ml-1; P <0.02) and muscle TBX synthase was higher in the resveratrol group after training (P <0.05). Resveratrol administration also abolished the positive effects of exercise on LDL, TC/HDL ratio and triglycerides concentrations in blood (P <0.05). Resveratrol did not potentiate the effect of exercise training on atherosclerosis marker VCAM-1. Sirtuin 1 protein levels were not affected by resveratrol supplementation. These findings indicate that, whereas exercise training effectively improves several cardiovascular health parameters in aged men, concomitant resveratrol supplementation blunts most of these effects.","author_count":11,"contributors":["Gliemann, Lasse","Schmidt, Jakob Friis","Olesen, Jesper","Biensø, Rasmus Sjørup","Peronard, Sebastian Louis","Grandjean, Simon Udsen","Mortensen, Stefan Peter","Nyberg, Michael Permin","Bangsbo, Jens","Pilegaard, Henriette","Hellsten, Ylva"],"cuid":["S01-000.00-536783"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"resveratrol blunts the positive effects of exercise training on cardiovascular health in aged men","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1113/jphysiol.2013.258061","version":"Other Version"},"id":"S01-000.00-536783","identifier":[{"id":"84885405201","type":"scopus"},{"id":"PMC3810808","type":"pmcid"},{"id":"23878368","type":"pmid"}],"ids":["ku-f035ef6c-e115-4ed3-afff-f9cab7f5107d"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-FB8F3BAD191F259BFFFAD0246A676539"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1113/jphysiol.2013.258061","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Nutrition, Exercise and Sports, PhD"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","first":"Lasse Gliemann","key":"hybholtpau","last":"Hybholt","locid":"20155bf6-30de-4f27-b1d4-e5eb07d3ad7a","name":"Gliemann, Lasse","name_org":"Hybholt, Lasse Gliemann","orcid":"0000-0002-0382-2523","rank":1,"rolecode":"pau"},{"affno":"1","first":"Jakob Friis","key":"schmidtpau","last":"Schmidt","locid":"74b58d72-77a1-4d66-aaaa-c36189cbf0b6","name":"Schmidt, Jakob Friis","rank":2,"rolecode":"pau"},{"affno":"1","first":"Jesper","key":"olesenpau","last":"Olesen","locid":"eaf9b770-cd72-45dd-9ca8-e0e4ecc19c11","name":"Olesen, Jesper","rank":3,"rolecode":"pau"},{"affno":"1","first":"Rasmus Sjørup","key":"biensøpau","last":"Biensø","locid":"c6f3c9d2-fa70-4da8-bafc-c37d0334c653","name":"Biensø, Rasmus Sjørup","rank":4,"rolecode":"pau"},{"affno":"1","first":"Sebastian Louis","key":"peronardpau","last":"Peronard","name":"Peronard, Sebastian Louis","rank":5,"rolecode":"pau"},{"affno":"1","first":"Simon Udsen","key":"grandjeanpau","last":"Grandjean","name":"Grandjean, Simon Udsen","rank":6,"rolecode":"pau"},{"affno":"2","first":"Stefan Peter","key":"mortensenpau","last":"Mortensen","name":"Mortensen, Stefan Peter","rank":7,"rolecode":"pau"},{"affno":"1","first":"Michael Permin","key":"nybergpau","last":"Nyberg","locid":"3a44876c-6484-4899-ade6-7e80d0483f3d","name":"Nyberg, Michael Permin","orcid":"0000-0002-3937-4697","rank":8,"rolecode":"pau"},{"affno":"1","first":"Jens","key":"bangsbopau","last":"Bangsbo","locid":"24839560-f889-42a6-9b73-97b69f101548","name":"Bangsbo, Jens","orcid":"0000-0003-1305-9274","rank":9,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Henriette","key":"pilegaardpau","last":"Pilegaard","locid":"bca00b25-e11a-407d-936f-6982a39ef1d8","name":"Pilegaard, Henriette","orcid":"0000-0002-1071-0327","rank":10,"rolecode":"pau"},{"affno":"1","first":"Ylva","key":"hellstenpau","last":"Hellsten","locid":"902a8d03-73c1-41fa-a0a3-7f250470e2f0","name":"Hellsten, Ylva","orcid":"0000-0002-2435-9558","rank":11,"rolecode":"pau"}],"pmid":["23878368"],"pub":{"doi":"10.1113/jphysiol.2013.258061","issn":["00223751","14697793"],"issn_org":["00223751"],"issue":"20","journal":"Journal of Physiology","pages":"5047-5059","status":"p","title":"Journal of Physiology","volume":"591"},"review":"Peer Reviewed","scoID":["2-s2.0-84885405201"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-f035ef6c-e115-4ed3-afff-f9cab7f5107d"],"src":["KU University of Copenhagen"],"title":"Resveratrol blunts the positive effects of exercise training on cardiovascular health in aged men","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-536783","year":"2013","yearsub":"2013"}
{"abstract":"A pattern of genital injury that separates trauma seen in sexual assault cases from trauma seen following consensual sexual intercourse has been a matter of debate. This study aimed at clarifying the question by eliminating as many confounders as possible in a prospective, case-control setup. A total of 98 controls and 39 cases were examined using the naked eye, the colposcope and toluidine blue dye followed by colposcopy. The overall frequency of having at least one lesion was strikingly similar in the two groups, but cases had significantly more abrasions, a trend towards more haematomas and a higher frequency of multiple lesions. Cases had a higher frequency of lesions in locations other than the 6 o'clock position. Our data suggests that cases have larger, more complex lesions. In conclusion, this study has confirmed the existence of different patterns of genital lesions. Background data for detection of genital lesions using the three most commonly used techniques is provided. These results will aid in the interpretation of findings seen when examining sexual assault victims.","author_count":4,"contributors":["Astrup, Birgitte Schmidt","Ravn, Pernille","Thomsen, Jørgen Lange","Lauritsen, Jens"],"cuid":["S01-000.00-579621"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"patterned genital injury in cases of rape a case control study","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.jflm.2013.03.003","version":"Other Version"},"id":"S01-000.00-579621","identifier":[{"id":"84878953236","type":"scopus"},{"id":"23756527","type":"pmid"}],"ids":["sdu-16647f0f-2410-4c73-a6aa-27d12483c198"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-14CA6F048A916B1D37283D44F3801DCA"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.jflm.2013.03.003","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Forensic Medicine"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Birgitte Schmidt","key":"astruppau","last":"Astrup","locid":"7f6334d2-e0ea-473e-adbb-e1246c3db81a","name":"Astrup, Birgitte Schmidt","orcid":"0000-0003-4266-9290","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Pernille","key":"ravnpau","last":"Ravn","locid":"b86a181f-31f7-452e-9900-74267c1011d3","name":"Ravn, Pernille","orcid":"0000-0001-8752-1121","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jørgen Lange","key":"thomsenpau","last":"Thomsen","locid":"02c01238-a1bb-411b-97e9-54415fc12c59","name":"Thomsen, Jørgen Lange","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens","key":"lauritsenpau","last":"Lauritsen","locid":"4c460020-fd7b-478a-ad2d-183a6808842a","name":"Lauritsen, Jens","orcid":"0000-0001-9281-8990","rank":4,"rolecode":"pau"}],"pmid":["23756527"],"pub":{"doi":"10.1016/j.jflm.2013.03.003","issn":["1752928X","18787487"],"issn_org":["1752928X"],"issue":"5","journal":"Journal of Forensic and Legal Medicine","pages":"525-529","publisher":"Churchill Livingstone","status":"p","title":"Journal of Forensic and Legal Medicine","volume":"20"},"review":"Peer Reviewed","scoID":["2-s2.0-84878953236"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-16647f0f-2410-4c73-a6aa-27d12483c198"],"src":["SDU University of Southern Denmark"],"title":"Patterned genital injury in cases of rape - A case-control study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-579621","year":"2013","yearsub":"2013"}
{"abstract":"Background: National and international strategies to increase physical activity e MPhasize environmental and policy changes that can have widespread and long-lasting impact. Evidence from multiple countries using comparable methods is required to strengthen the evidence base for such initiatives. Because some environment and policy changes could have generalizable effects and others may depend on each country's context, only international studies using comparable methods can identify the relevant differences. Methods: Currently 12 countries are participating in the International Physical Activity and the Environment Network (IPEN) study. The IPEN Adult study design involves recruiting adult participants from neighborhoods with wide variations in environmental walkability attributes and socioeconomic status (SES). Results: Eleven of twelve countries are providing accelerometer data and 11 are providing GIS data. Current projections indicate that 14,119 participants will provide survey data on built environments and physical activity and 7145 are likely to provide objective data on both the independent and dependent variables. Though studies are highly comparable, some adaptations are required based on the local context. Conclusions: This study was designed to inform evidencebased international and country-specific physical activity policies and interventions to help prevent obesity and other chronic diseases that are high in developed countries and growing rapidly in developing countries.","author_count":31,"contributors":["Kerr, Jacqueline","Sallis, James F","Owen, Neville","De Bourdeaudhuij, Ilse","Cerin, Ester","Sugiyama, Takemi","Reis, Rodrigo","Sarmiento, Olga","Frömel, Karel","Mitás, Josef","Troelsen, Jens","Christiansen, Lars Breum","Macfarlane, Duncan","Salvo, Deborah","Schofield, Grant","Badland, Hannah","Guillen-Grima, Francisco","Aguinaga-Ontoso, Ines","Davey, Rachel","Bauman, Adrian","Saelens, Brian","Riddoch, Chris","Ainsworth, Barbara","Pratt, Michael","Schmidt, Tom","Frank, Lawrence","Adams, Marc","Conway, Terry","Cain, Kelli","Van Dyck, Delfien","Bracy, Nicole"],"cuid":["S01-000.00-587628"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Accelerometry","Adult","Environment Design","Female","Global","Health Policy","Humans","International Cooperation","Male","Motor Activity","Pooled analyses","Urban","Walkability","Walking","Walking statistics numerical data"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"advancing science and policy through a coordinated international study of physical activity and built environments ipen adult methods","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://www.ncbi.nlm.nih.gov/pubmed/22975776","version":"Other Version"},"id":"S01-000.00-587628","identifier":[{"id":"22975776","type":"pmid"},{"id":"84878003741","type":"scopus"}],"ids":["sdu-32595bec-7dee-4194-87b0-47ad43ebbce5"],"keyword":["Accelerometry","Adult","Environment Design","Female","Global","Health Policy","Humans","International Cooperation","Male","Motor Activity","Pooled analyses","Urban","Walkability","Walking","Walking/statistics & numerical data"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-2-328B861ACB13BA18FC2C8E2B25918BF1"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.ncbi.nlm.nih.gov/pubmed/22975776","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nor