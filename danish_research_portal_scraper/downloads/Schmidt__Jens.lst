 Denmark"],"PST":["Published"]},"sid":["aau-7f8f2ebf-5dd0-4199-8cd5-8d9c9b07a2ee","ku-da3627e3-ec90-445d-ae5c-dfb5921694b9","sdu-b207b107-8ac4-4a5f-b707-bc4f359a99a7"],"src":["AAU Aalborg University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Structural and functional cardiac adaptations to 6 months of football training in untrained hypertensive men","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-100.00-006179","year":"2014","yearsub":"2014"}
{"abstract":"Patients with atrial fibrillation (AF) are at an increased risk of ischaemic stroke. The efficacy of stroke prevention with vitamin K antagonists in these patients has been well established. However, associated bleeding risks may offset the therapeutic benefits in patients with risk factors for bleeding. Despite improvements achieved by novel oral anticoagulants, bleeding remains a clinically relevant problem, especially gastrointestinal bleeding. Percutaneous occlusion of the left atrial appendage (LAA) may be considered as an alternative stroke prevention therapy in AF patients with a high bleeding risk. This paper explores patient groups in whom oral anticoagulation may be challenging and percutaneous LAA occlusion (LAAO) has a potentially better risk-benefit balance. The current status of LAAO and future directions are reviewed, and particular challenges for LAA occlusion requiring further clinical data are discussed. This article is a summary of the Third Global Summit on LAA occlusion, 15 March 2013, Barcelona, Spain.","author_count":8,"contributors":["Lewalter, T","Kanagaratnam, P","Schmidt, B","Rosenqvist, M","Nielsen-Kudsk, Jens Erik","Ibrahim, R","Albers, B A","Camm, A J"],"cuid":["S01-000.00-179042"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","Isar Kliniken"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"ischaemic stroke prevention in patients with atrial fibrillation and high bleeding risk opportunities and challenges for percutaneous left atrial appendage occlusion","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1093/europace/euu069","version":"Other Version"},"id":"S01-000.00-179042","identifier":[{"id":"24798956","type":"pmid"},{"id":"84900296833","type":"scopus"}],"ids":["au-572ad6c5-bacb-48ba-ae82-42bb9af38dd9"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-E03BD53C8E6FDC864EBA1D0A6EAC006F"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1093/europace/euu069","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","country":"de","key":"isar kliniken","loc":["Germany","Europe, EU","OECD"],"name":"Isar Kliniken","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Cardiological Medicine B"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"T","key":"lewalterpau","last":"Lewalter","name":"Lewalter, T","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"P","key":"kanagaratnampau","last":"Kanagaratnam","name":"Kanagaratnam, P","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"B","key":"schmidtpau","last":"Schmidt","locid":"be471172-79bd-4a8e-a764-6ed653f010bb","name":"Schmidt, B","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"M","key":"rosenqvistpau","last":"Rosenqvist","name":"Rosenqvist, M","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"J E","key":"nielsenkudskpau","last":"Nielsen-Kudsk","locid":"8629b763-e23e-41d9-ac4f-61579d19565e","name":"Nielsen-Kudsk, Jens Erik","name_org":"Nielsen-Kudsk, J E","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"R","key":"ibrahimpau","last":"Ibrahim","name":"Ibrahim, R","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"B A","key":"alberspau","last":"Albers","name":"Albers, B A","rank":7,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"A J","key":"cammpau","last":"Camm","name":"Camm, A J","rank":8,"rolecode":"pau"}],"pmid":["24798956"],"pub":{"doi":"10.1093/europace/euu069","issn":["10995129","10996044"],"issn_org":["10995129"],"issue":"5","journal":"Europace","pages":"626-30","publisher":"Oxford University Press","status":"p","title":"Europace","volume":"16"},"review":"Peer Reviewed","scoID":["2-s2.0-84900296833"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-572ad6c5-bacb-48ba-ae82-42bb9af38dd9"],"src":["AU Aarhus University"],"title":"Ischaemic stroke prevention in patients with atrial fibrillation and high bleeding risk : opportunities and challenges for percutaneous left atrial appendage occlusion","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-179042","year":"2014","yearsub":"2014"}
{"abstract":"The aim of this study was to compare the effect of mesophilic anaerobic digestion with aerobic storage on the survival of selected indigenous microorganisms and microbial groups in blackwater, including the effect of addition of Greenlandic Halibut and shrimp offal. The methane yield of the different substrate mixtures was determined in batch experiments to study possible correlation between methanogenic activity in the anaerobic digesters and reduction of indigenous microorganisms in the blackwater. By the end of the experiments a recovery study was conducted to determine possible injury of the microorganisms. In both anaerobic and aerobic samples, survival of Escherichia coli was better in the presence of Greenlandic Halibut offal when compared to samples containing blackwater only and blackwater and shrimp offal, possibly due to more available carbon in the samples containing Greenlandic Halibut offal. Reduction of faecal streptococci was large under both anaerobic and aerobic conditions, and the results indicated a complete removal of faecal streptococci in the anaerobic samples containing blackwater and a mixture of blackwater and shrimp offal after 17 and 31 days, respectively. Amoxicillin resistant bacteria were reduced in the anaerobic samples in the beginning of the study but increased towards the end of it. The opposite pattern was observed in the aerobic samples, with a growth in the beginning followed by a reduction. During the anaerobic digestion tetracycline resistant bacteria showed the least reduction in the mixture of blackwater and shrimp offal, which had the lowest methane yield while the highest reduction was observed in the mixture of blackwater and Greenlandic Halibut, where the highest methane yield was measured Reduction of coliphages was larger under anaerobic conditions. Addition of fish offal had no effect on survival of coliphages. The results of the recovery study indicated that a fraction of the E. coli in the aerobic blackwater sample and of the faecal streptococci in both the anaerobic and aerobic samples containing blackwater and Greenlandic Halibut were injured only, and thus able to resuscitate during recovery.The use of anaerobic digestion in the Arctic is limited to substrate types like those tested in this study because of absence of agriculture. The results indicate that anaerobic digestion of wastewater could benefit from the addition of fish offal, with respect to both microbial reduction and energy production.","author_count":6,"contributors":["Gunnarsdottir, Ragnhildur","Heiske, Stefan","Jensen, Pernille Erland","Schmidt, Jens Ejbye","Villumsen, Arne","Jenssen, Petter Deinboll"],"cuid":["S02-100.00-038233"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Asia, Middle East","Europe, Non-EU","Nordic","OECD"],"country":["Norway","United Arab Emirates"],"glorg":["All Global Affiliations","Masdar Institute of Science and Technology","Norwegian University of Life Sciences"],"keyword":["Anaerobic digestion","Arctic","Fish offal","Indigenous microorganisms","Resistance","Wastewater"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-SDU"]},"level3all":["DI-U-DTU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"effect of anaerobiosis on indigenous microorganisms in blackwater with fish offal as co substrate","src":["dtu","sdu"],"src-code":["DI-U-DTU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.watres.2014.05.038","version":"Other Version"},"id":"S02-100.00-038233","identifier":[{"id":"24971812","type":"pmid"},{"id":"84902994845","type":"scopus"}],"ids":["dtu-ff217a9e-af85-4f86-af07-87b46d5d0730","sdu-6fcfed41-941f-494d-aa7f-3fbb3988882a"],"keyword":["Anaerobic digestion","Arctic","Fish offal","Indigenous microorganisms","Resistance","Wastewater"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-9C46D18631EF6B44B63906A193292304"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.watres.2014.05.038","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Civil Engineering"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Engineering, Department of Green Technology (IGT)"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","country":"ae","key":"masdar institute of science and technology","loc":["United Arab Emirates","Asia, Middle East"],"name":"Masdar Institute of Science and Technology","used":1},{"affno":"4","country":"no","key":"norwegian university of life sciences","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"Norwegian University of Life Sciences","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Ragnhildur","key":"gunnarsdottirpau","last":"Gunnarsdottir","locid":"d2e18d68-c633-48d8-8ab0-7cbd4ecd7c9c","name":"Gunnarsdottir, Ragnhildur","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Stefan","key":"heiskepau","last":"Heiske","locid":"8aa98f76-9a58-4767-a4e0-9889b628d0ef","name":"Heiske, Stefan","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Pernille Erland","key":"jensenpau","last":"Jensen","locid":"c21f7bd4-85f5-420a-b31b-51a5c58bc254","name":"Jensen, Pernille Erland","orcid":"0000-0003-4718-1630","rank":3,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"country":"dk","first":"Jens Ejbye","key":"schmidtpau","last":"Schmidt","locid":"14ca7f5b-030e-46a8-8aef-a09f6fa018f5","name":"Schmidt, Jens Ejbye","orcid":"0000-0001-6067-5032","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Arne","key":"villumsenpau","last":"Villumsen","locid":"6ed7d396-fcc9-4741-b4e3-3627dc5fcd3a","name":"Villumsen, Arne","rank":5,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Petter Deinboll","key":"jenssenpau","last":"Jenssen","name":"Jenssen, Petter Deinboll","rank":6,"rolecode":"pau"}],"pmid":["24971812"],"pub":{"doi":"10.1016/j.watres.2014.05.038","issn":["00431354","18792448"],"issn_org":["00431354"],"journal":"Water Research","pages":"1-9","publisher":"Elsevier","status":"p","title":"Water Research","volume":"63"},"review":"Peer Reviewed","scoID":["2-s2.0-84902994845"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["dtu-ff217a9e-af85-4f86-af07-87b46d5d0730","sdu-6fcfed41-941f-494d-aa7f-3fbb3988882a"],"src":["DTU Technical University of Denmark","SDU University of Southern Denmark"],"title":"Effect of anaerobiosis on indigenous microorganisms in blackwater with fish offal as co-substrate","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-038233","year":"2014","yearsub":"2014"}
{"abstract":"[Open Access] The effects of 16 weeks of football or strength training on performance and functional ability were investigated in 26 (68.2 +/- 3.2 years) untrained men randomized into a football (FG; n = 9), a strength training (ST; n = 9), or a control group (CO; n = 8). FG and ST trained 1.6 +/- 0.1 and 1.5 +/- 0.1 times per week, respectively, with higher (P <0.05) average heart rate (HR) ( approximately 140 vs 100 bpm) and time >90%HRmax (17 vs 0%) in FG than ST, and lower (P <0.05) peak blood lactate in FG than ST (7.2 +/- 0.9 vs 10.5 +/- 0.6 mmol/L). After the intervention period (IP), VO(2) max (15%; P <0.001), cycle time to exhaustion (7%; P <0.05), and Yo-Yo Intermittent Endurance Level 1 performance (43%; P <0.01) were improved in FG, but unchanged in ST and CO. HR during walking was 12% and 10% lower (P <0.05) in FG and ST, respectively, after IP. After IP, HR and blood lactate during jogging were 7% (P <0.05) and 30% lower (P <0.001) in FG, but unchanged in ST and CO. Sit-to-stand performance was improved (P <0.01) by 29% in FG and 26% in ST, but not in CO. In conclusion, football and strength training for old men improves functional ability and physiological response to submaximal exercise, while football additionally elevates maximal aerobic fitness and exhaustive exercise performance","author_count":21,"contributors":["Rostgaard Andersen, Thomas","Schmidt, Jakob Friis","Nielsen, Jens Jung","Randers, Morten Bredsgaard","Sundstrup, Emil","Jakobsen, Marcus Due","Andersen, Lars Louis","Suetta, Charlotte Arneboe","Aagaard, Per","Bangsbo, Jens","Krustrup, Peter"],"cuid":["S03-089.50-769319"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of Exeter"],"keyword":["Blood lactate","CMJ","FFA","Maximal oxygen uptake","Sit to stand","Training intensity"],"level":"sci","mra":["med","sci","soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-WORK"],"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-GV-WORK","DI-HO-CAP","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"effect of football or strength training on functional ability and physical performance in untrained old men","src":["ku","nfa","sdu"],"src-code":["DI-GV-WORK","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://nfa.elsevierpure.com/ws/files/7135255/Andersen_TR_Scand_J_Med_Sci_Sports_2014.pdf","version":"Published Version"},"id":"S03-089.50-769319","identifier":[{"id":"84902660784","type":"scopus"},{"id":"24903323","type":"pmid"}],"ids":["ku-ea8f9695-a8f2-4c44-b703-baae600f6989","nfa-0ca094bf-6c14-4baa-b76d-b9aeafeeb6d5","sdu-fac4a1d7-9abd-4d4c-af44-fd178570f5de"],"keyword":["Blood lactate","CMJ","FFA","Maximal oxygen uptake","Sit-to-stand","Training intensity","Yo-Yo IE1 performance"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology","Social Science"],"noi":["Global-Local-2-6-49CC6C4A50B602BD1A0C12290977391D"],"oa_link":[{"access":"oa","type":"loc","url":"https://nfa.elsevierpure.com/ws/files/7135255/Andersen_TR_Scand_J_Med_Sci_Sports_2014.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1111/sms.12245","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Nutrition, Exercise and Sports, The August Krogh Section for Hu