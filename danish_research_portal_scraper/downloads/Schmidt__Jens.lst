1,"role":"Other","rolecode":"oth"}],"pmid":["31500849"],"pub":{"doi":"10.1016/s0140-6736(19)32039-2","issn":["00995355","01406736"],"issn_org":["01406736"],"issue":"10207","journal":"The Lancet","pages":"1415-1424","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"p","title":"The Lancet","title_org":"Lancet","volume":"394"},"review":"Peer Reviewed","scoID":["2-s2.0-85073227920"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Private Research","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","North Denmark Region","Other Companies","Other Hospitals","Other Research","Private Research","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark","falck denmark a/s","prehospital emergency medical services"],"PST":["Published"]},"sid":["aau-ed133af5-7f72-486c-aa0c-7721db6c1c46","au-2b0942d7-438a-4e27-89b5-e6153ef06aaa","ku-cd695891-ab15-4352-b8c5-f7c98dbf6fde","sdu-d4d64753-33c4-4e83-90bc-eb15fd2820ee"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Effect of remote ischaemic conditioning on clinical outcomes in patients with acute myocardial infarction (CONDI-2/ERIC-PPCI) : a single-blind randomised controlled trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-097.86-011319","year":"2019","yearsub":"2019"}
{"abstract":"Artiklen belyser stationen som et privilegeret udtryk for modernitetens toning af tid og rum, dens kronotop (’tid-sted’), med udgangspunkt i to kanoniserede modernistiske digte: Johannes V. Jensens ”Paa Memphis Station” (1906) og Ezra Pounds ”In a Station of the Metro” (1913). Tilgangen kombinerer en nærlæsning i nykritikkens spor med en litterær og idéhistorisk kontekstualisering under inddragelse af teoretikere som Adorno, Jameson, Schwartz, Waugh, Bachtin og Holquist. Som et knudepunkt for mange forskellige linjer fremstår stationen i disse epokegørende digte som ’det moderne sublime’ i billeder, der sammensmelter sansning og abstraktion i en ’strukturel mimesis’. Mødet med stationen udløser en vision af det moderne i et eksplosivt sammenstød mellem byrealisme, myte og kosmisk natur.","author_count":4,"contributors":["Gemzøe, Anker"],"cuid":["S01-000.00-116125"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Ezra Pound","Johannes V Jensen","Kronotop","Litteratur og filosofi","Modernisme"],"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"på stationen sansning og abstraktion med henblik på stationen som modernistisk kronotop","src":["aau"],"src-code":["DI-U-AAU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.forlagetspring.dk/collections/nyeste-udgivelser/products/en-ny-kritik","version":"Other Version"},"id":"S01-000.00-116125","ids":["aau-e354b0b3-b7db-4fde-9d0b-f796763bacb6"],"keyword":["Ezra Pound","Johannes V. Jensen","Kronotop","Litteratur og filosofi","Modernisme"],"lang":"Danish","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-064A0868C61A7AAAFAB62FF45471ADD8"],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Humanities","Aalborg University, The Faculty of Humanities, Department of Culture and Global Studies (CL)","Aalborg University, The Faculty of Humanities, Department of Culture and Global Studies (CL), IRGiC - The Interdisciplinary Research Group in Culture (CGS)","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Kaj Munk Forskningscentret"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Anker","key":"gemzøepau","last":"Gemzøe","locid":"bd38e977-3fb4-4d98-98ab-ace3ec661251","name":"Gemzøe, Anker","orcid":"0000-0003-4798-5647","rank":1,"rolecode":"pau"},{"affno":"","first":"Jens Lohfert","key":"jørgensenpedh","last":"Jørgensen","name":"Jørgensen, Jens Lohfert","rank":2,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Louise","key":"mønsterpedh","last":"Mønster","name":"Mønster, Louise","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Michael Kallesøe","key":"schmidtpedh","last":"Schmidt","name":"Schmidt, Michael Kallesøe","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9788793358706"],"pages":"117-137","place":"København","publisher":"Forlaget Spring","status":"p","title":"En ny kritik"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-e354b0b3-b7db-4fde-9d0b-f796763bacb6"],"src":["AAU Aalborg University"],"title":"På stationen : Sansning og abstraktion med henblik på stationen som modernistisk kronotop","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-116125","year":"2019","yearsub":"2019"}
{"abstract":"BACKGROUND: TLR9 agonists are being developed as immunotherapy against malignancies and infections. TLR9 is primarily expressed in B cells and plasmacytoid dendritic cells (pDCs). TLR9 signalling may be critically important for B cell activity in lymph nodes but little is known about the in vivo impact of TLR9 agonism on human lymph node B cells. As a pre-defined sub-study within our clinical trial investigating TLR9 agonist MGN1703 (lefitolimod) treatment in the context of developing HIV cure strategies (NCT02443935), we assessed TLR9 agonist-mediated effects in lymph nodes. METHODS: Participants received MGN1703 for 24 weeks concurrent with antiretroviral therapy. Seven participants completed the sub-study including lymph node resection at baseline and after 24 weeks of treatment. A variety of tissue-based immunologic and virologic parameters were assessed. FINDINGS: MGN1703 dosing increased B cell differentiation; activated pDCs, NK cells, and T cells; and induced a robust interferon response in lymph nodes. Expression of Activation-Induced cytidine Deaminase, an essential regulator of B cell diversification and somatic hypermutation, was highly elevated. During MGN1703 treatment IgG production increased and antibody glycosylation patterns were changed. INTERPRETATION: Our data present novel evidence that the TLR9 agonist MGN1703 modulates human lymph node B cells in vivo. These findings warrant further considerations in the development of TLR9 agonists as immunotherapy against cancers and infectious diseases. FUND: This work was supported by Aarhus University Research Foundation, the Danish Council for Independent Research and the NovoNordisk Foundation. Mologen AG provided study drug free of charge.","author_count":27,"contributors":["Schleimann, Mariane Høgsbjerg","Kobberø, Maria-Louise","Vibholm, Line K.","Kjær, Kathrine","Giron, Leila B","Busman-Sahay, Kathleen","Chan, Chi Ngai","Nekorchuk, Michael","Schmidt, Manuel","Wittig, Burghardt","Damsgaard, Tine Engberg","Ahlburg, Peter","Hellfritzsch, Michel Bach","Zuwala, Kaja","Rothemejer, Frederik Holm","Olesen, Rikke","Schommers, Phillipp","Klein, Florian","Dweep, Harsh","Kossenkov, Andrew","Nyengaard, Jens Randel","Estes, Jacob D","Abdel-Mohsen, Mohamed","Østergaard, Lars Jørgen","Tolstrup, Martin","Søgaard, Ole Schmeltz","Denton, Paul W"],"cuid":["S01-000.00-149496"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Europe, EU","OECD"],"country":["Germany","United States"],"glorg":["All Global Affiliations","Oregon Health Oregon Health & Science University Science University","University Hospital Cologne","Wistar Institute"],"keyword":["B cell differentiation","HIV cure","TLR9 agonist"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"tlr000000000009 agonist mgn000000001703 enhances b cell differentiation and function in lymph nodes","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.ebiom.2019.07.005","version":"Published Version"},"id":"S01-000.00-149496","identifier":[{"id":"85068449043","type":"scopus"},{"id":"PMC6642412","type":"pmcid"},{"id":"000475860000036","type":"wos"},{"id":"31300344","type":"pmid"}],"ids":["au-231ab365-4f08-4dc7-9903-9985f43b5415"],"keyword":["Antibody glycosylation","B cell differentiation","B cell follicle","HIV cure","TLR9 agonist"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-EB8E598F145555E91661C193920ECFB2"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.ebiom.2019.07.005","version":"Published Version"}],"oai":{"class":"Realised"