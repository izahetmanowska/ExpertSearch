affno":"1","corresponding":null,"country":"dk","first":"Claus Ziegler","key":"simonsenpau","last":"Simonsen","locid":"ccf2fb52-6a4a-45b2-adb0-d6e83324879f","name":"Simonsen, Claus Ziegler","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens Erik","key":"nielsenkudskpau","last":"Nielsen-Kudsk","locid":"8629b763-e23e-41d9-ac4f-61579d19565e","name":"Nielsen-Kudsk, Jens Erik","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Morten","key":"schmidtpau","last":"Schmidt","locid":"21e3a3e6-e25e-48cf-b243-b8f43dca3bb8","name":"Schmidt, Morten","orcid":"0000-0002-4935-4059","rank":5,"rolecode":"pau"}],"pmid":["39880554"],"pub":{"doi":"10.1016/j.jacc.2024.11.036","issn":["07351097","15583597"],"issn_org":["07351097"],"issue":"4","journal":"Journal of the American College of Cardiology","publisher":"Elsevier Inc.","status":"p","title":"Journal of the American College of Cardiology","volume":"85"},"review":"Peer Reviewed","scoID":["2-s2.0-85215255681"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-9ef5ea78-6935-4cc6-b3ae-37f7812f3fec"],"src":["AU Aarhus University"],"title":"Reply: Recurrent Ischemic Stroke After PFO Closure: : Unconsidered Low RoPE Score and Thrombophilia","type":"Journal Comment","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-796742","year":"2025","yearsub":"2025"}
{"abstract":"Background Intranasal vaccines against respiratory viruses are desired due to ease of administration and potential to protect against virus infection of the upper respiratory tract. Methods We tested a cationic liposomal adjuvant delivering the TLR3 agonist Poly (I:C) (CAF®09b) for intranasal administration, by formulating this with SARS-CoV-2 spike trimeric protein and assessing airway mucosal immune responses in mice. The vaccine was further evaluated in SARS-CoV-2 virus challenge models, using mice expressing the human ACE2 receptor and Syrian hamsters. Findings The intranasal vaccine elicited both serum neutralising antibody responses and IgA responses in the upper respiratory tract. Uniquely, it also elicited high-magnitude CD4 and CD8 T cell responses in the lung parenchyma and nasal-associated lymphoid tissue. In contrast, parenteral administration of the same vaccine, or the mRNA-1273 (Spikevax®) vaccine, led to systemic antibody responses and vaccine-induced CD4 T cells were mainly found in circulation. The intranasal vaccine protected against homologous SARS-CoV-2 (Wuhan-Hu-1) challenge in K18-hACE2 mice, preventing weight loss and virus infection in the upper and lower airways. In Syrian hamsters, the vaccine prevented weight loss and significantly reduced virus load after challenge with the homologous strain and Omicron BA.5. Interpretation This study demonstrates that intranasal subunit vaccines containing TLR3-stimulating cationic liposomes effectively induce airway IgA and T cell responses, which could be utilised in future viral pandemics.","author_count":22,"contributors":["Wørzner, Katharina","Schmidt, Signe Tandrup","Zimmermann, Julie","Tami, Ahmad","Polacek, Charlotta","Fernandez-Antunez, Carlota","Hartmann, Katrine Top","Jensen, Rune Fledelius","Hansen, Julia Sid","Illigen, Kristin","Isling, Louise Krag","Erbs, Gitte","Jungersen, Gregers","Rosenkrands, Ida","Offersgaard, Anna","Gottwein, Judith Margarete","Holmbeck, Kenn","Jensen, Henrik Elvang","Ramirez, Santseharay","Follmann, Frank","Bukh, Jens","Pedersen, Gabriel K."],"cuid":["S01-000.00-799308"],"filters":{"added":"2025-04","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"intranasal recombinant protein subunit vaccine targeting tlr000000000003 induces respiratory tract iga and cd000000000008 t cell responses and protects against respiratory virus infection","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.ebiom.2025.105615","version":"Published Version"},"id":"S01-000.00-799308","identifier":[{"id":"39983329","type":"pmid"},{"id":"PMC11893338","type":"pmcid"},{"id":"85218132235","type":"scopus"}],"ids":["ku-3e5d1614-f21c-4d2c-bc5e-1a67d9baeb61"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-B2429B69A44F3C0367151E2A97543347"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/428924371/Intranasal_recombinant.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.ebiom.2025.105615","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"ssi statens serum institut","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-SSI","l3nn":"SSI Statens Serum Institut","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SSI Statens Serum Institut","namevar":["Statens Serum Institut"],"nora_code":"DI-GV-SSI","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Immunology and Microbiology, Virology"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Amager and Hvidovre"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","first":"Katharina","key":"wørznerkatharinapau","last":"Wørzner","name":"Wørzner, Katharina","rank":1,"rolecode":"pau"},{"affno":"1","first":"Signe Tandrup","key":"schmidtsignetandruppau","last":"Schmidt","name":"Schmidt, Signe Tandrup","rank":2,"rolecode":"pau"},{"affno":"1","first":"Julie","key":"zimmermannjuliepau","last":"Zimmermann","name":"Zimmermann, Julie","rank":3,"rolecode":"pau"},{"affno":"1","first":"Ahmad","key":"tamiahmadpau","last":"Tami","name":"Tami, Ahmad","rank":4,"rolecode":"pau"},{"affno":"1","first":"Charlotta","key":"polacekcharlottapau","last":"Polacek","name":"Polacek, Charlotta","rank":5,"rolecode":"pau"},{"affno":"2 3","first":"Carlota","key":"fernandezantunezcarlotapau","last":"Fernandez Antunez","locid":"e181d8b5-a5c0-4346-8817-3c02d8c8a7bd","name":"Fernandez-Antunez, Carlota","name_org":"Fernandez Antunez, Carlota","rank":6,"rolecode":"pau"},{"affno":"2","first":"Katrine Top","key":"hartmannkatrinetoppau","last":"Hartmann","locid":"24872909-edcd-41d3-ac0e-6d89e6fef67b","name":"Hartmann, Katrine Top","rank":7,"rolecode":"pau"},{"affno":"1","first":"Rune Fledelius","key":"jensenrunefledeliuspau","last":"Jensen","name":"Jensen, Rune Fledelius","rank":8,"rolecode":"pau"},{"affno":"1","first":"Julia Sid","key":"hansenjuliasidpau","last":"Hansen","name":"Hansen, Julia Sid","ra