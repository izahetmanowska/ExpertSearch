ame":"Gabriele Monasterio Foundation","used":1},{"affno":"7","country":"de","key":"harzklinikum dorothea christiane erxleben gmbh","loc":["Germany","Europe, EU","OECD"],"name":"Harzklinikum Dorothea Christiane Erxleben GmbH","used":1},{"affno":"8","country":"fi","key":"university of turku","loc":["Finland","Europe, EU","Nordic","OECD"],"name":"University of Turku","used":1},{"affno":"9","country":"hk","key":"university of hong kong","loc":["Hong Kong","Asia, East"],"name":"University of Hong Kong","used":1},{"affno":"10","country":"es","key":"hospital clinic de barcelona","loc":["Spain","Europe, EU","OECD"],"name":"Hospital Clinic de Barcelona","used":1},{"affno":"11","country":"us","key":"abbott structural heart","loc":["United States","America, North","OECD"],"name":"Abbott Structural Heart","used":1},{"affno":"12","country":"de","key":"university of duisburg essen","loc":["Germany","Europe, EU","OECD"],"name":"University of Duisburg-Essen","used":1},{"affno":"13","country":"de","key":"markus krankenhaus frankfurt","loc":["Germany","Europe, EU","OECD"],"name":"Markus-Krankenhaus Frankfurt","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Adel","key":"aminianpau","last":"Aminian","name":"Aminian, Adel","rank":1,"rolecode":"pau"},{"affno":"2","first":"Ole","key":"debackerpau","last":"De Backer","locid":"ef003f2e-017a-423c-b9a8-2333a85370f1","name":"De Backer, Ole","rank":2,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"country":"dk","first":"Jens Erik","key":"nielsenkudskpau","last":"Nielsen-Kudsk","locid":"8629b763-e23e-41d9-ac4f-61579d19565e","name":"Nielsen-Kudsk, Jens Erik","rank":3,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Patrizio","key":"mazzonepau","last":"Mazzone","name":"Mazzone, Patrizio","rank":4,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Sergio","key":"bertipau","last":"Berti","name":"Berti, Sergio","rank":5,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Sven","key":"fischerpau","