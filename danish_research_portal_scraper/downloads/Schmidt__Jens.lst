":"Borregaard, Britt","orcid":"0000-0003-2702-0231","rank":7,"rolecode":"pau"},{"affno":"2 4","corresponding":null,"first":"Henrik","key":"schmidtpau","last":"Schmidt","locid":"9789920f-4b31-4f28-8211-97afced9d61e","name":"Schmidt, Henrik","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jens Flensted","key":"lassenpau","last":"Lassen","locid":"2af194b2-635f-4b62-84c2-26bd7dc3263b","name":"Lassen, Jens Flensted","orcid":"0000-0001-7972-9192","rank":9,"rolecode":"pau"},{"affno":"1 2 3","first":"Jacob Eifer","key":"møllerpau","last":"Møller","locid":"64f4cb89-c3c2-42b2-9547-209a806e4fd3","name":"Møller, Jacob Eifer","orcid":"0000-0003-2873-5845","rank":10,"rolecode":"pau"},{"affno":"1 3","first":"Christian","key":"hassagerpau","last":"Hassager","locid":"49196e5d-0f61-44b2-a6b9-cd6c5f8f3bc2","name":"Hassager, Christian","orcid":"0000-0002-1199-0981","rank":11,"rolecode":"pau"},{"affno":"3 5 1","first":"Helle","key":"søholmpau","last":"Søholm","name":"Søholm, Helle","rank":12,"rolecode":"pau"},{"affno":"1 3","first":"Jesper","key":"kjærgaardpau","last":"Kjærgaard","locid":"10ffadd9-ed9c-4251-954a-a2c12ce83aca","name":"Kjaergaard, Jesper","name_org":"Kjærgaard, Jesper","rank":13,"rolecode":"pau"}],"pmid":["38401709"],"pub":{"doi":"10.1016/j.resuscitation.2024.110151","issn":["03009572","18731570"],"issn_org":["03009572"],"journal":"Resuscitation","paperid":"110151","publisher":"Elsevier","status":"p","title":"Resuscitation","volume":"197"},"review":"Peer Reviewed","scoID":["2-s2.0-85186623820"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-71a5af23-a0d6-47d9-b3fa-d422758c2642","sdu-a8d9276a-4e51-48fb-a82e-eadb04776bd8"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Health-related quality of life and cognitive function after out-of-hospital cardiac arrest; a comparison of prehospital return-of-spontaneous circulation and refractory arrest managed with extracorporeal cardiopulmonary resuscitation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-725196","year":"2024","yearsub":"2024"}
{"abstract":"Background: In selected cases of cardiogenic shock, veno-arterial extracorporeal membrane oxygenation (V-A ECMO) is combined with trans valvular micro axial flow pumps (ECMELLA). Observational studies indicate that ECMELLA may reduce mortality but exposing the patient to two advanced mechanical support devices may affect the early inflammatory response. We aimed to explore inflammatory biomarkers in a porcine cardiogenic shock model managed with V-A ECMO or ECMELLA. Methods: Fourteen landrace pigs had acute myocardial infarction-induced cardiogenic shock with minimal arterial pulsatility by microsphere embolization and were afterwards managed 1:1 with either V-A ECMO or ECMELLA for 4 h. Serial blood samples were drawn hourly and analyzed for serum concentrations of interleukin 6 (IL-6), IL-8, tumor necrosis factor alpha, and serum amyloid A (SAA). Results: An increase in IL-6, IL-8, and SAA levels was observed during the experiment for both groups. At 2–4 h of support, IL-6 levels were higher in ECMELLA compared to V-A ECMO animals (difference: 1416 pg/ml, 1278 pg/ml, and 1030 pg/ml). SAA levels were higher in ECMELLA animals after 3 and 4 h of support (difference: 401 ng/ml and 524 ng/ml) and a significant treatment-by-time effect of ECMELLA on SAA was identified (p = 0.04). No statistical significant between-group differences were observed in carotid artery blood flow, urine output, and lactate levels. Conclusions: Left ventricular unloading with Impella during V-A ECMO resulted in a more extensive inflammatory reaction despite similar end-organ perfusion.","author_count":14,"contributors":["Gregers, Emilie","Frederiksen, Peter H.","Udesen, Nanna L.J.","Linde, Louise","Banke, Ann","Povlsen, Amalie L.","Larsen, Jeppe P.","Hassager, Christian","Jensen, Lisette O.","Lassen, Jens F.","Schmidt, Henrik","Ravn, Hanne B.","Heegaard, Peter M. H.","Møller, Jacob E."],"cuid":["S02-100.00-735397"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Gregers, Emilie"],"keyword":["Acute myocardial infarction","Cardiogenic shock","ECMELLA","ECMO","Unloading of the left ventricle","Venoarterial extracorporeal membrane oxygenation"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-DTU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"immediate inflammatory response to mechanical circulatory support in a porcine model of severe cardiogenic shock","src":["dtu","sdu"],"src-code":["DI-U-DTU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s40635-024-00625-8","version":"Published Version"},"id":"S02-100.00-735397","identifier":[{"id":"38647741","type":"pmid"},{"id":"85191053969","type":"scopus"},{"id":"PMC11035503","type":"pmcid"}],"ids":["dtu-7be470cb-5537-487c-809c-a5428bf8bef9","sdu-58d98f09-8d5c-4099-a4e4-7b81d162b074"],"keyword":["Acute myocardial infarction","Cardiogenic shock","ECMELLA","ECMO","Unloading of the left ventricle","Venoarterial extracorporeal membrane oxygenation"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-27CF737E96C0241E419EF06BCBD5AEB9"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s40635-024-00625-8","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/360251386/66284ef557bd3d98bcd5a76b.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"K