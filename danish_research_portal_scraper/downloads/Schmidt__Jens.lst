H, Research unit of Cardiology (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"4","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","used":1}],"person":[{"affno":"1 2","first":"Jesper","key":"kjaergaardpau","last":"Kjaergaard","locid":"10ffadd9-ed9c-4251-954a-a2c12ce83aca","name":"Kjaergaard, Jesper","rank":1,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Jacob E.","key":"møllerpau","last":"Møller","locid":"5e4d3cb6-b0a0-4541-aea1-30e73f7c10b8","name":"Møller, Jacob Eifer","name_org":"Møller, Jacob E.","orcid":"0000-0003-2873-5845","rank":2,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Henrik","key":"schmidtpau","last":"Schmidt","locid":"9789920f-4b31-4f28-8211-97afced9d61e","name":"Schmidt, Henrik","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Johannes","key":"grandpau","last":"Grand","name":"Grand, Johannes","rank":4,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Simon","key":"mølstrømpau","last":"Mølstrøm","locid":"197d79e9-dd07-401b-90f8-1c26dc359db2","name":"Mølstrøm, Simon","orcid":"0000-0002-2778-8075","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Britt","key":"borregaardpau","last":"Borregaard","locid":"ca3a0f85-e4e4-42dc-98f0-a7ddfe619020","name":"Borregaard, Britt","orcid":"0000-0003-2702-0231","rank":6,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Søren","key":"venøpau","last":"Venø","locid":"f006f0e3-3074-4c22-97ad-860dfe95c0fa","name":"Venø, Søren","rank":7,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Laura","key":"sarkisianpau","last":"Sarkisian","locid":"472392ba-c3e3-4a00-ae8e-9a24b7706ab3","name":"Sarkisian, Laura","rank":8,"rolecode":"pau"},{"affno":