key":"goltermannppu","last":"Goltermann","locid":"c5c0abe9-e221-4cac-96aa-2d7cd40039d9","name":"Goltermann, Per","orcid":"0000-0001-6821-3115","rank":1,"role":"Publisher","rolecode":"ppu"},{"affno":"1","corresponding":null,"first":"Lisbeth M.","key":"ottosenppu","last":"Ottosen","locid":"653cfe69-d98d-42ec-b241-5409bbfc951c","name":"Ottosen, Lisbeth M.","orcid":"0000-0001-7756-382X","rank":2,"role":"Publisher","rolecode":"ppu"},{"affno":"1","corresponding":null,"first":"Jens Henrik","key":"nielsenppu","last":"Nielsen","locid":"1153cf58-bb0e-42da-a4d0-1ea0dd13b752","name":"Nielsen, Jens Henrik","orcid":"0000-0003-0705-9382","rank":3,"role":"Publisher","rolecode":"ppu"},{"affno":"1","corresponding":null,"first":"Jacob Wittrup","key":"schmidtppu","last":"Schmidt","locid":"2a187e49-ed7b-44eb-a0d4-f9d00cc245ce","name":"Schmidt, Jacob Wittrup","orcid":"0000-0003-0603-4546","rank":4,"role":"Publisher","rolecode":"ppu"},{"affno":"1","corresponding":null,"first":"Pernille Erland","key":"jensenppu","last":"Jensen","locid":"c21f7bd4-85f5-420a-b31b-51a5c58bc254","name":"Jensen, Pernille Erland","orcid":"0000-0003-4718-1630","rank":5,"role":"Publisher","rolecode":"ppu"},{"affno":"1","corresponding":null,"first":"John Forbes","key":"olesenppu","last":"Olesen","locid":"79903110-6d3f-4368-8626-5c1ce73e6d0a","name":"Olesen, John Forbes","orcid":"0000-0001-6695-7719","rank":6,"role":"Publisher","rolecode":"ppu"},{"affno":"1","corresponding":null,"first":"Gunvor","key":"kirkelundppu","last":"Kirkelund","locid":"1e194ea4-a3c9-40a7-8ef4-6608b09b559f","name":"Kirkelund, Gunvor Marie","name_org":"Kirkelund, Gunvor","orcid":"0000-0002-5834-7029","rank":7,"role":"Publisher","rolecode":"ppu"}],"pub":{"status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-03387eaa-140b-47eb-9686-b0fe9bcadce2"],"src":["DTU Technical University of Denmark"],"title":"Project families: How to improve learning in thesis work and increase impact on research","type":"Non-Textual Item","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-305543","year":"2018","yearsub":"2018"}
{"abstract":"This paper describes the development of a new concept for organizing thesis work and supervision with the purpose of improving civil engineer students learning within the general key competences and increase their contribution to research and development, by using the student, supervisor and technicians resources in a more efficient way. This concept organizes the traditional thesis works with 1 or 2 students collaborating at a project and a report into project families. A project family consists of a number of project students focusing on a common problem, where the students works supplement each other, share the supervisor team, test facilities, data and project room, while still being independent. The paper presents results for 104 students thesis works and documents significant improvements in learning and in contributions to research and thus a better and more efficient use of the students resources and of the university resources.","author_count":7,"contributors":["Goltermann, Per","Ottosen, Lisbeth M.","Nielsen, Jens Henrik","Schmidt, Jacob Wittrup","Jensen, Pernille Erland","Kirkelund, Gunvor Marie","Olesen, John Forbes"],"cuid":["S01-000.00-347382"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Experiments","Learning","Research","Resources"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"nr","rtype":["clu"],"sorti":"project families how to improve learning in thesis works and increase impact on research","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/160560988/Project_Families_at_DTU_Byg_report_402.pdf","version":"Published Version"},"id":"S01-000.00-347382","ids":["dtu-8f7c07bb-1a64-4a36-8dcf-255903cc5616"],"keyword":["Experiments","Learning","Research","Resources"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-28D891195D31B6471CBDD1FD3C32AC0F"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/160560988/Project_Families_at_DTU_Byg_report_402.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Civil Engineering","Technical University of Denmark, Department of Civil Engineering, Structures and Safety"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"P.","key":"goltermannpau","last":"Goltermann","locid":"c5c0abe9-e221-4cac-96aa-2d7cd40039d9","name":"Goltermann, Per","name_org":"Goltermann, P.","orcid":"0000-0001-6821-3115","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"L.M.","key":"ottosenpau","last":"Ottosen","locid":"653cfe69-d98d-42ec-b241-5409bbfc951c","name":"Ottosen, Lisbeth M.","name_org":"Ottosen, L.M.","orcid":"0000-0001-7756-382X","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"J.H.","key":"nielsenpau","last":"Nielsen","locid":"1153cf58-bb0e-42da-a4d0-1ea0dd13b752","name":"Nielsen, Jens Henrik","name_org":"Nielsen, J.H.","orcid":"0000-0003-0705-9382","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"J.W.","key":"schmidtpau","last":"Schmidt","locid":"2a187e49-ed7b-44eb-a0d4-f9d00cc245ce","name":"Schmidt, Jacob Wittrup","name_org":"Schmidt, J.W.","orcid":"0000-0003-0603-4546","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"P.E.","key":"jensenpau","last":"Jensen","locid":"c21f7bd4-85f5-420a-b31b-51a5c58bc254","name":"Jensen, Pernille Erland","name_org":"Jensen, P.E.","orcid":"0000-0003-4718-1630","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"G.","key":"kirkelundpau","last":"Kirkelund","locid":"1e194ea4-a3c9-40a7-8ef4-6608b09b559f","name":"Kirkelund, Gunvor Marie","name_org":"Kirkelund, G.","orcid":"0000-0002-5834-7029","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"J.F.","key":"olesenpau","last":"Olesen","locid":"79903110-6d3f-4368-8626-5c1ce73e6d0a","name":"Olesen, John Forbes","name_org":"Olesen, J.F.","orcid":"0000-0001-6695-7719","rank":7,"rolecode":"pau"}],"pub":{"issn":["16012917"],"issue":"R-402","pages":"22","publisher":"Technical University of Denmark, Department of Civil Engineering","repno":"B Y G D T U. Rapport, R-402","series":"BYGDTU  Rapport","status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-8f7c07bb-1a64-4a36-8dcf-255903cc5616"],"src":["DTU Technical University of Denmark"],"title":"Project families: How to improve learning in thesis works and increase impact on research","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-347382","year":"2018","yearsub":"2018"}
{"abstract":"OBJECTIVE: This study investigated whether preceding ethanol intake impairs glucose response to low-dose glucagon in individuals with type 1 diabetes. RESEARCH DESIGN AND METHODS: This was a randomized, crossover, placebo-controlled study in 12 insulin pump-treated individuals (median [interquartile range] age, 37 [31-51] years; HbA1c, 57 [51-59] mmol/mol or 7.3% [6.8-7.5]; and BMI, 23.922-25] kg/m2). During two overnight study visits, a 6 p.m. dinner (1 g carbohydrates/kg) was served with diet drink (placebo) or diet drink and ethanol (0.8 g/kg). After 8-9 h, ethanol was estimated to be metabolized, and a subcutaneous (s.c.) insulin bolus was given to induce mild hypoglycemia. When plasma glucose (PG) was ≤3.9 mmol/L, 100 µg glucagon was given s.c., followed by another s.c. 100 µg glucagon 2 h later. Primary end point was incremental peak PG induced by the first glucagon bolus. RESULTS: Ethanol was undetectable before insulin administration at both visits. The insulin doses (mean ± SEM: 2.5 ± 0.4 vs. 2.7 ± 0.4 IU) to induce hypoglycemia (3.7 ± 0.1 vs. 3.9 ± 0.1 mmol/L) did not differ and caused similar insulin levels (28.3 ± 4.6 vs. 26.1 ± 4.0 mU/L) before glucagon administration on ethanol and placebo visits (all,P> 0.05). The first glucagon bolus tended to cause lower incremental peak PG (2.0 ± 0.5 vs. 2.9 ± 0.3 mmol/L,P= 0.06), lower incremental area under the curve (87 ± 40 vs. 191 ± 37 mmol/L × min,P= 0.08), and lower 2-h PG level (3.6 ± 1.0 vs. 4.8 ± 0.4 mmol/L,P= 0.05) after ethanol compared with placebo. The second glucagon bolus had similar responses between visits, but PG remained 1.8 ± 0.7 mmol/L lower after ethanol compared with placebo. CONCLUSIONS: The ability of low-dose glucagon to treat mild hypoglycemia persisted with preceding ethanol intake, although it tended to be attenuated.","author_count":8,"contributors":["Ranjan, Ajenthen","Nørgaard, Kirsten","Tetzschner, Rikke","Steineck, Isabelle Isa Kristin","Clausen, Trine Ryberg","Holst, Jens Juul","Madsbad, Sten","Schmidt, Signe"],"cuid":["S01-000.00-414494"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"effects of preceding ethanol intake on glucose response to low dose glucagon in individuals with type 000000000001 diabetes a randomized placebo controlled crossover study","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-414494","identifier":[{"id":"85042930573","type":"scopus"},{"id":"29358493","type":"pmid"}],"ids":["ku-2343ae9b-7b37-4e98-bf64-1e8693528550"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-06299177FD93AF9575531E11E62AE59B"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal Medicine: Endocrinology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Ajenthen","key":"ranjanpau","last":"Ranjan","name":"Ranjan, Ajenthen","rank":1,"rolecode":"pau"},{"affno":"1","first":"Kirsten","key":"nørgaardpau","last":"Nørgaard","locid":"771b216e-eeb8-449e-8cde-2cdd59ae6dbc","name":"Nørgaard, Kirsten","rank":2,"rolecode":"pau"},{"affno":"","first":"Rikke","key":"tetzschnerpau","last":"Tetzschner","name":"Tetzschner, Rikke","rank":3,"rolecode":"pau"},{"affno":"","first":"Isabelle Isa Kristin","key":"steineckpau","last":"Steineck","name":"Steineck, Isabelle Isa Kristin","rank":4,"rolecode":"pau"},{"affno":"","first":"Trine Ryberg","key":"clausenpau","last":"Clausen","name":"Clausen, Trine Ryberg","rank":5,"rolecode":"pau"},{"affno":"1","first":"Jens Juul","key":"holstpau","last":"Holst","locid":"864b6401-9024-4773-9bdb-f4d4ca57dcad","name":"Holst, Jens Juul","orcid":"0000-0001-6853-3805","rank":6,"rolecode":"pau"},{"affno":"1","first":"Sten","key":"madsbadpau","last":"Madsbad","locid":"1018c708-245a-4057-9263-074578042385","name":"Madsbad, Sten","rank":7,"rolecode":"pau"},{"affno":"","first":"Signe","key":"schmidtpau","last":"Schmidt","name":"Schmidt, Signe","rank":8,"rolecode":"pau"}],"pmid":["29358493"],"pub":{"doi":"10.2337/dc17-1458","issn":["01495992"],"issue":"4","journal":"Diabetes Care","pages":"797-806","status":"p","title":"Diabetes Care","volume":"41"},"review":"Peer Reviewed","scoID":["2-s2.0-85042930573"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-2343ae9b-7b37-4e98-bf64-1e8693528550"],"src":["KU University of Copenhagen"],"title":"Effects of Preceding Ethanol Intake on Glucose Response to Low-Dose Glucagon in Individuals With Type 1 Diabetes : A Randomized, Placebo-Controlled, Crossover Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-414494","year":"2018","yearsub":"2018"}
