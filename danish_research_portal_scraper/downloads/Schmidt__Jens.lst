/s43856-024-00474-2","issn":["2730664X"],"issue":"1","journal":"Communications Medicine","paperid":"50","publisher":"Springer Nature","status":"p","title":"Communications Medicine","title_org":"Communications medicine","volume":"4"},"review":"Peer Reviewed","scoID":["2-s2.0-85193919225"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Non-Profit Organisations","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Non-Profit Organisations","North Denmark Region","Region Zealand","Region of Southern Denmark","Technical University of Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-eedbbbdb-2ddb-4efc-aa01-45d63d27afd9","au-e77de264-03b9-4b9e-b4ba-d40332a162ce","dtu-e1290a66-a0c1-422e-a8f0-7e10956f43ec","ku-ae1e6301-3e7e-4eb4-ad37-44bb6d4cc7b5","sdu-2b569f8d-6b73-4b04-94dc-211ee4522119"],"src":["AAU Aalborg University","AU Aarhus University","DTU Technical University of Denmark","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Lifestyle and demographic associations with 47 inflammatory and vascular stress biomarkers in 9876 blood donors","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S05-099.76-741600","year":"2024","yearsub":"2024"}
{"abstract":"Hand injuries are common, and due to the complex functions of the hand, soft tissue defects present a surgical challenge in reconstruction. Hand defects exposing deeper structures warrant reconstruction with local flaps, but in Denmark, reconstruction surgery of the hand is routinely managed within the orthopaedic specialty alone with no plastic surgical involvement. This review aims at describing the most common local flaps of the hand and forearm and encourage to stronger collaboration between hand- and plastic surgeons in Denmark.","author_count":7,"contributors":["Welling, Harald","Vesterholm, Kiran Singapuri","Toyserkani, Navid","Vedel, Jens Christian","Bigdeli, Amir K.","Gvozdenovic, Robert","Schmidt, Volker Jürgen"],"cuid":["S01-000.00-730974"],"filters":{"added":"2024-05","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","OECD"],"country":["Germany","Switzerland"],"glorg":["All Global Affiliations","BG Klinik, Ludwigshafen","Rekonstruktionsskirurgi, Sankt Gallen"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-ZEA"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-HO-ZEA","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"hånden og underarmens lokale lapper","src":["ku"],"src-code":["DI-U-KU"],"type":"djr","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.61409/V05230324","version":"Published Version"},"id":"S01-000.00-730974","identifier":[{"id":"85184679992","type":"scopus"},{"id":"38327197","type":"pmid"}],"ids":["ku-440327f0-4c3a-4aac-8d2c-5e75534cb8cb"],"lang":"Danish","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-B34B2AFB7BAE324C0F24E8B8D4FFAA60"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/383929658/Fulltext.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.61409/V05230324","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Zealand University Hospital - Roskilde"],"nora_code":"DI-HO-ZEA","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Herlev and Gentofte"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","country":"de","key":"bg klinik ludwigshafen","loc":["Germany","Europe, EU","OECD"],"name":"BG Klinik, Ludwigshafen","used":1},{"affno":"4","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Orthopaedic Surgery"],"nora_code":"DI-U-KU","used":1},{"affno":"5","country":"ch","key":"rekonstruktionsskirurgi sankt gallen","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"Rekonstruktionsskirurgi, Sankt Gallen","used":1}],"person":[{"affno":"1","first":"Harald","key":"wellingpau","last":"Welling","name":"Welling, Harald","rank":1,"rolecode":"pau"},{"affno":"2","first":"Kiran Singapuri","key":"vesterholmpau","last":"Vesterholm","name":"Vesterholm, Kiran Singapuri","rank":2,"rolecode":"pau"},{"affno":"1","first":"N