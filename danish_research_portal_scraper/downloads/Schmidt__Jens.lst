ng":null,"first":"Boris","key":"schmidtpau","last":"Schmidt","name":"Schmidt, Boris","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Patrizio","key":"mazzonepau","last":"Mazzone","name":"Mazzone, Patrizio","rank":4,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Sven","key":"fischerpau","last":"Fischer","name":"Fischer, Sven","rank":5,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Juha","key":"lundpau","last":"Lund","name":"Lund, Juha","rank":6,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Matteo","key":"montorfanopau","last":"Montorfano","name":"Montorfano, Matteo","rank":7,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Ryan","key":"gagepau","last":"Gage","name":"Gage, Ryan","rank":8,"rolecode":"pau"},{"affno":"8","corresponding":null,"first":"Simon Cheung Chi","key":"lampau","last":"Lam","name":"Lam, Simon Cheung Chi","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sergio","key":"bertipau","last":"Berti","name":"Berti, Sergio","rank":10,"rolecode":"pau"}],"pmid":["34381870"],"pub":{"doi":"10.1016/j.ijcha.2021.100848","issn":["23529067"],"journal":"IJC Heart and Vasculature","paperid":"100848","publisher":"Elsevier Ireland Ltd","status":"p","title":"IJC Heart and Vasculature","title_org":"IJC Heart & Vasculature","volume":"35"},"review":"Peer Reviewed","scoID":["2-s2.0-85111208910"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-dd622928-3172-4a73-92d3-5fd16668a901"],"src":["AU Aarhus University"],"title":"Gender difference in left atrial appendage occlusion outcomes : Results from the Amplatzer™ Amulet™ Observational Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-255686","year":"2021","yearsub":"2021"}
{"abstract":"Identifying determinants of low-dose glucagon efficacy is important to optimise its utilization for prevention and treatment of hypoglycaemia in individuals with type 1 diabetes. The study objective was to investigate whether the preceding glucose decline rate affects glucose response to low-dose glucagon administration. Ten adults with insulin pump-treated type 1 diabetes were included in this randomized, single-blind, two-way crossover study. Using a hyperinsulinaemic clamp technique, plasma glucose levels were reduced with either a rapid or slow decline rate while maintaining fixed insulin levels. When the plasma glucose level reached 3.9 mmoL/L, insulin and glucose infusions were discontinued and 150 mu g subcutaneous glucagon was administered, followed by 120 minutes of plasma glucose monitoring. The positive incremental area under the glucose curve after administration of low-dose glucagon did not differ between the rapid-decline and slow-decline visits (mean +/- SEM: 220 +/- 49 vs. 174 +/- 31 mmoL/L x min; P = 0.21). Similarly, no differences in total area under the glucose curve, peak plasma glucose, incremental peak plasma glucose, time-to-peak plasma glucose or end plasma glucose were observed. Thus, preceding glucose decline rate did not significantly affect the glucose response to low-dose glucagon.","author_count":5,"contributors":["Laugesen, Christian","Schmidt, Signe","Holst, Jens Juul","Nørgaard, Kirsten","Ranjan, Ajenthen G."],"cuid":["S01-000.00-528046"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Glucagon","Hypoglycaemia","Pharmacodynamics","Type 1 diabetes"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the effect of preceding glucose decline rate on low dose glucagon efficacy in individuals with type 000000000001 diabetes a randomized crossover trial","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-528046","identifier":[{"id":"33336888","type":"pmid"},{"id":"000605180000001","type":"wos"},{"id":"85099040468","type":"scopus"}],"ids":["ku-e141a71e-4de3-4123-9dc9-7e8a0e19cc02"],"keyword":["INDUCED MILD HYPOGLYCEMIA","glucagon","hypoglycaemia","pharmacodynamics","type 1 diabetes"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-DBE61DED530252ABAE6F67D844E185A1"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Christian","key":"laugesenpau","last":"Laugesen","locid":"b6519bb2-934e-4303-9b5c-41daf35937a4","name":"Laugesen, Christian","rank":1,"rolecode":"pau"},{"affno":"","first":"Signe","key":"schmidtpau","last":"Schmidt","name":"Schmidt, Signe","rank":2,"rolecode":"pau"},{"affno":"1","first":"Jens Juul","key":"holstpau","last":"Holst","locid":"864b6401-9024-4773-9bdb-f4d4ca57dcad","name":"Holst, Jens Juul","orcid":"0000-0001-6853-3805","rank":3,"rolecode":"pau"},{"affno":"1","first":"Kirsten","key":"nørgaardpau","last":"Nørgaard","locid":"771b216e-eeb8-449e-8cde-2cdd59ae6dbc","name":"Nørgaard, Kirsten","rank":4,"rolecode":"pau"},{"affno":"","first":"Ajenthen G.","key":"ranjanpau","last":"Ranjan","name":"Ranjan, Ajenthen G.","rank":5,"rolecode":"pau"}],"pmid":["33336888"],"pub":{"doi":"10.1111/dom.14301","issn":["14628902","14631326"],"issn_org":["14628902"],"issue":"4","journal":"D