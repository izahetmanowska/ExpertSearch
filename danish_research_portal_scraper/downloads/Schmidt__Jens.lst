6","rank":5,"rolecode":"pau"},{"affno":"10 11","corresponding":null,"first":"Caroline Schmidt","key":"laugesenpau","last":"Laugesen","name":"Laugesen, Caroline Schmidt","rank":6,"rolecode":"pau"},{"affno":"4 1 10","first":"Henrik","key":"lundandersenpau","last":"Lund-Andersen","locid":"5277856f-b771-4658-bb2f-b292ec78ee6f","name":"Lund-Andersen, Henrik","rank":7,"rolecode":"pau"},{"affno":"4 1","first":"Charlotte","key":"cerqueirapau","last":"Cerqueira","locid":"7e964b90-554b-4d92-8ebc-83e1fe686130","name":"Cerqueira, Charlotte","rank":8,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Jens","key":"andresenpau","last":"Andresen","name":"Andresen, Jens","rank":9,"rolecode":"pau"}],"pmid":["27822108"],"pub":{"doi":"10.2147/clep.s99507","issn":["11791349"],"journal":"Clinical Epidemiology","pages":"613-619","publisher":"Dove Medical Press Ltd","publisher_org":"Dove Medical Press Ltd.","status":"p","title":"Clinical Epidemiology","volume":"8"},"review":"Peer Reviewed","scoID":["2-s2.0-84995655293"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","North Denmark Region","Other Hospitals","Other Research","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark","dansk oftalmologisk selskab","organization of danish ophthalmologists"],"PST":["Published"]},"sid":["aau-bcbb0053-36fd-44c4-a286-5873591e945c","au-5982dbba-e4af-4707-9c40-7feab328b148","ku-49f86403-3177-42a8-8562-a7ae8635ed81","sdu-6f408808-ca64-45cf-9f0d-44bda340cd98"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"The Danish Registry of Diabetic Retinopathy","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-098.52-009103","year":"2016","yearsub":"2016"}
{"abstract":"Context: Ghrelin has glucoregulatory and orexigenic actions, but its role in acute hypoglycemia remains uncertain. Objective: To investigate circulating levels of acylghrelin (AG) and unacylated ghrelin (UAG) in response to hyperinsulinemia and to hypoglycemia. Design: A randomized, single blind, placebo controlled crossover study including three study days. Setting: The study was performed at a university hospital clinical research center. Patients and interventions: Nine healthy men completed three study days: I) saline control (CTR), II) hyperinsulinaemic euglycemia (HE) (bolus insulin 0.1 IE/kg i.v. and glucose 20% i.v. for 105 minutes, plasma glucose ≈ 5 m¬mol/l), and III) hyperinsulinaemic hypoglycemia (HH) (bolus insulin 0.1 IE/kg i.v.). Results: HH and HE suppressed AG concentrations at t=45-60 min as compared to CTR (P<0.05). At t=90 min a rebound increase in AG was observed in response to HH as compared to both HE and CTR (P<0.05). UAG also decreased during HH and HE at t=45 min (P<0.05), whereas the AG-to-UAG ratio remained unaffected. Conclusions: This study demonstrates that AG and UAG are directly suppressed by hyperinsulinemia and that AG concentrations increase after a latency of ≈ 1 h in response to hypoglycemia, suggesting a potential counterregulatory role of AG.","author_count":8,"contributors":["Lauritzen, Esben Stistrup","Voss, Thomas Schmidt","Kampmann, Ulla","Mengel, Annette","Vendelbo, Mikkel","Jørgensen, Jens Otto Lunde","Møller, Niels","Vestergaard, Esben Thyssen"],"cuid":["S01-000.00-217398"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"circulating acylghrelin levels are suppressed by insulin and increase in response to hypoglycemia in healthy adult volunteers","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1530/EJE-14-0880","version":"Other Version"},"id":"S01-000.00-217398","identifier":[{"id":"25599708","type":"pmid"},{"id":"84927590622","type":"scopus"}],"ids":["au-9a906688-03b7-424b-958b-e95beed8181d"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-0DA5EC812B5EA31BF7D6107054FDBFE6"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1530/EJE-14-0880","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Medical Research Laboratory"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Esben Stistrup","key":"lauritzenpau","last":"Lauritzen","locid":"f03d34af-ce5e-4193-912a-f5f3c0e0921d","name":"Lauritzen, Esben Stistrup","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thomas","key":"vosspau","last":"Voss","locid":"cec29a7a-aafc-4df3-9431-0e5895d745d2","name":"Voss, Thomas Schmidt","name_org":"Voss, Thomas","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ulla Kampmann","key":"opstruppau","last":"Opstrup","locid":"26c25195-6d9d-4899-9737-e1c0b09bec29","name":"Kampmann, Ulla","name_org":"Opstrup, Ulla Kampmann","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Annette","key":"mengelpau","last":"Mengel","locid":"6a085c62-4174-425f-b20d-fa64550fdc32","name":"Mengel, Annette","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mikkel Holm","key":"vendelbopau","last":"Vendelbo","locid":"f2e9a2a2-57fc-433f-b9fb-726b15b1cdc4","name":"Vendelbo, Mikkel","name_org":"Vendelbo, Mikkel Holm","orcid":"0000-0003-0431-2522","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens Otto Lunde","key":"jørgensenpau","last":"Jørgensen","locid":"303ebe86-6861-4b19-b4d7-6bda0526b27e","name":"Jørgensen, Jens Otto Lunde","orcid":"0000-0001-7408-1526","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Niels","key":"møllerpau","last":"Møller","locid":"2e0d8e2a-2da1-4d55-b2da-0a25c0375b1e","name":"Møller, Niels","orcid":"0000-0001-5627-7322","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Esben Thyssen","key":"vestergaardpau","last":"Vestergaard","locid":"2cbff962-cbb0-43fa-8fc3-648dc685070a","name":"Vestergaard, Esben Thyssen","orcid":"0000-0003-4263-1815","rank":8,"rolecode":"pau"}],"pmid":["25599708"],"pub":{"doi":"10.1530/eje-14-0880","issn":["08044643","1479683X"],"issn_org":["08044643"],"issue":"4","journal":"European Journal of Endocrinology","pages":"357-62","publisher":"Oxford University Press","status":"p","title":"European Journal of Endocrinology","title_org":"European journal of endocrinology / European Federation of Endocrine Societies","volume":"172"},"review":"Peer Reviewed","scoID":["2-s2.0-84927590622"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-9a906688-03b7-424b-958b-e95beed8181d"],"src":["AU Aarhus University"],"title":"Circulating acylghrelin levels are suppressed by insulin and increase in response to hypoglycemia in healthy adult volunteers","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-217398","year":"2015","yearsub":"2015"}
{"abstract":"Impacts of climate change on marine ecosystems have become increasingly apparent during the past decades. In consequence, it is necessary to study how these alterations can affect the habitat and population dynamics of key organisms. Here we used a video plankton recorder (VPR) to investigate the effect of climate-induced habitat changes on the copepod Pseudocalanus acuspes, a key species in the Baltic Sea. The VPR allowed the observation of reproducing copepod females, identified by attached egg sacs, usually lost during traditional net sampling. We compared the small-scale distribution of our target species during non-inflow and inflow periods. Our study showed a large increase in the availability of suitable habitat after the inflow event due to improved oxygen and salinity conditions. Furthermore, increased copepod abundance and a deeper and wider vertical distribution was apparent. Applying a new approach to estimate in situ egg production rates from VPR-derived images revealed no changes. However, we observed increased offspring survival with improved hydrographic conditions pointing toward the importance of salinity and oxygen for the population dynamics of Baltic P. acuspes. Our observations illustrate the strong impact that climate change can have on the habitat of key marine ecosystem species, important for overall ecosystem dynamics.","author_count":10,"contributors":["Möller, Klas O.","Schmidt, Jörn O.","St. John, Michael","Temming, Axel","Diekmann, Rabea","Peters, Janna","Floeter, Jens","Sell, Anne F.","Herrmann, Jens-Peter","Möllmann, Christian"],"cuid":["S01-000.00-380879"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","Johann Heinrich von Thunen Institute","Kiel University","University of Hamburg"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"effects of climate induced habitat changes on a key zooplankton species","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1093/plankt/fbv033","version":"Other Version"},"id":"S01-000.00-380879","identifier":[{"id":"84939612306","type":"scopus"}],"ids":["dtu-fee5c027-50da-42ab-b4a4-f1582c9abef9"],"keyword":["FEATURED ARTICLE"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-67A9602A8E1BAB0E81E01741836F1383"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1093/plankt/fbv033","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","country":"de","key":"university of hamburg","loc":["Germany","Europe, EU","OECD"],"name":"University of Hamburg","used":1},{"affno":"2","country":"de","key":"kiel university","loc":["Germany","Europe, EU","OECD"],"name":"Kiel University","used":1},{"affno":"3","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Institute of Aquatic Resources","Technical University of Denmark, National Institute of Aquatic Resources, Section for Marine Ecology and Oceanography"],"nora_code":"DI-U-DTU","used":1},{"affno":"4","country":"de","key":"johann heinrich von thunen institute","loc":["Germany","Europe, EU","OECD"],"name":"Johann Heinrich von Thunen Institute","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Klas O.","key":"möllerpau","last":"Möller","name":"Möller, Klas O.","rank":1,"rolecode":"pau"},{"affno":"2","