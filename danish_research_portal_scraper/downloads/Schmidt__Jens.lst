{"author_count":22,"contributors":["Kelly, P. L.","Rodney, Steven A.","Treu, T.","Strolger, L-G.","Foley, R. J.","Jha, S. W.","Selsing, J.","Brammer, G.","Bradac, M.","Cenko, S. Bradley","Graur, O.","Filippenko, Alexei V.","Hjorth, Jens","McCully, C.","Molino, A.","Nonino, M.","Riess, A. G.","Schmidt, K. B.","Tucker, B A","von der Linden, A.","Weiner, Benjamin J.","Zitrin, A."],"cuid":["S01-000.00-440849"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Galaxies clusters general","Gravitational lensing strong","Supernovae general","supernovae individual SN Refsdal"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"deja vu all over again the reappearance of supernova refsdal","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-440849","identifier":[{"id":"84960120673","type":"scopus"},{"id":"000371044200008","type":"wos"}],"ids":["ku-4f6aaf62-74ec-4d4e-aef2-9f70ba80568e"],"keyword":["galaxies: clusters: general","galaxies: individual (MACS J1149.5+2223)","gravitational lensing: strong","supernovae: general","supernovae: individual (SN Refsdal)"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-BCDB0DB9FCEB11E7D9585965024B8080"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Niels Bohr Institute, DARK"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"P. L.","key":"kellypau","last