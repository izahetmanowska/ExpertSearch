ealth Sciences, Department of Psychology","SDU, The Faculty of Health Sciences, Department of Psychology, The National Center of Psychotraumatology"],"nora_code":"DI-U-SDU","used":1},{"affno":"4","country":"ca","key":"samuel lunenfeld research institute mount sinai hospital toronto","loc":["Canada","America, North","OECD"],"name":"Samuel Lunenfeld Research Institute, Mount Sinai Hospital, Toronto","used":1},{"affno":"5","country":"ca","key":"university of toronto","loc":["Canada","America, North","OECD"],"name":"University of Toronto","used":1},{"affno":"6","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1}],"person":[{"affno":"1","corresponding":null,"first":"A.","key":"tuborghpau","last":"Tuborgh","locid":"f019f6a6-ef3a-403d-b9f8-60d62215cafc","name":"Tuborgh, Astrid","name_org":"Tuborgh, A.","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"S. W.","key":"svendsenpau","last":"Svendsen","locid":"1de9ffe9-dbf8-4bbd-8708-35bce0da950f","name":"Svendsen, Susanne Wulff","name_org":"Svendsen, S. W.","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"A.","key":"elklitpau","last":"Elklit","locid":"d90151d4-a374-4c6d-b7ff-42a930c5a468","name":"Elklit, Ask","name_org":"Elklit, A.","orcid":"0000-0002-8469-7372","rank":3,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"first":"J.","key":"hunterpau","last":"Hunter","name":"Hunter, J.","rank":4,"rolecode":"pau"},{"affno":"1 2 6","corresponding":null,"first":"J. S.","key":"jensenpau","last":"Jensen","locid":"f77754dc-4ec3-47ff-8227-808446a30644","name":"Jensen, Jens Søndergaard","name_org":"Jensen, J. S.","rank":5,"rolecode":"pau"},{"affno":"1 6","corresponding":null,"first":"A.","key":"schröderpau","last":"Schröder","locid":"200c6dd9-43cd-41da-8c27-ce8adb073e24","name":"Schröder, Andreas","name_org":"Schröder, A.","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"J. F.","key":"nielsenpau","last":"Nielsen","locid":"3fb25b9f-381b-44a6-a8dd-26eacf839d37","name":"Nielsen, Jørgen Feldbæk","name_org":"Nielsen, J. F.","orcid":"0000-0001-5339-171X","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"M. M.","key":"thastumpau","last":"Thastum","locid":"c3813500-c313-4961-a854-ad2dba72d7d9","name":"Thastum, Mille","name_org":"Thastum, M. M.","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"E. T.","key":"næssschmidtpau","last":"Næss-Schmidt","locid":"c1a1a6b6-deb0-4e07-8cc0-f7d3beeaca85","name":"Næss-Schmidt, Erhard Trillingsgaard","name_org":"Næss-Schmidt, E. T.","orcid":"0000-0002-2539-0362","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"C. U.","key":"raskpau","last":"Rask","locid":"1e308742-df61-47da-83ce-53d8a7c774c3","name":"Rask, Charlotte Ulrikka","name_org":"Rask, C. U.","orcid":"0000-0002-7426-0353","rank":10,"rolecode":"pau"}],"pmid":["34509710"],"pub":{"doi":"10.1016/j.jpsychores.2021.110603","issn":["00223999","18791360"],"issn_org":["00223999"],"issue":"110603","journal":"Journal of Psychosomatic Research","paperid":"110603","publisher":"Elsevier","status":"p","title":"Journal of Psychosomatic Research","volume":"150"},"review":"Peer Reviewed","scoID":["2-s2.0-85114678172"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-bf4f313f-46d1-4661-b619-2a8eecc08f4f","ku-215fe6f2-5c59-41f2-a581-4466e298c9e2","sdu-7925ce42-e246-4ec1-8281-715b26be9762"],"src":["AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Attachment and symptom reporting in adolescents and young adults after a concussion","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-100.00-026559","year":"2021","yearsub":"2021"}
{"abstract":"BACKGROUND: β-lactoglobulin (BLG) stimulates muscle protein synthesis and β-hydroxybutyrate (BHB) inhibits muscle breakdown. Whether combining the 2 can additively attenuate disease-induced muscle loss is unknown. OBJECTIVE: Based on previous observations of anticatabolic effects of protein and ketone bodies during inflammation, and using a novel model combining ongoing systemic inflammation, fasting, and immobilization, we tested whether the anticatabolic muscle response to oral amino acids is altered compared with control conditions, as well as whether coadministration of oral BHB and BLG further improves the muscle anabolic response. Muscle net balance (NBphe) was the primary outcome and intramyocellular signals were assessed. METHODS: In a randomized crossover design, 8 young men underwent either preconditioning with LPS (prestudy day: 1 ng/kg, study day: 0.5 ng/kg) combined with a 36-h fast and bed rest to mimic catabolic inflammatory disease (CAT) or an overnight fast (control [CTR]) prior to isocaloric nutritional interventions on 3 occasions separated by ∼6 wk (range 42 to 83 d). RESULTS: NBphe increased similarly upon all conditions (interaction P = 0.65). From comparable baseline rates, both Rdphe [muscle synthesis, median ratio (95% CI): 0.44 (0.23, 0.86) P = 0.017] and Raphe [muscle breakdown, median ratio (95% CI): 0.46 (0.27, 0.78) P = 0.005] decreased following BHB + BLG compared with BLG. BLG increased Rdphe more under CAT conditions compared with CTR (interaction P = 0.02). CAT increased inflammation, energy expenditure, and lipid oxidation and decreased Rdphe and anabolic signaling [mammalian target of rapamycin (mTOR) and eukaryotic translation initiation factor 4E-binding protein 1 (4EPB1) phosphorylation]. CONCLUSION: In contrast to our initial hypothesis, NBphe increased similarly following BLG during CAT and CTR conditions; CAT however, specifically stimulated the BLG-mediated increase in protein synthesis, whereas BHB coadministration did not affect NBphe, but distinctly dampened the BLG-induced increase in muscle amino acid fluxes thereby liberating circulating amino acids for anabolic actions elsewhere.","author_count":8,"contributors":["Mose, Maike","Brodersen, Katrine","Rittig, Nikolaj","Schmidt, J","Jessen, Nicolai","Mikkelsen, U R","Jørgensen, Jens Otto Lunde","Møller, Niels"],"cuid":["S01-000.00-227838"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Dairy protein","Endotoxemia","Fasting","Immobilization","Metabolism","Skeletal muscle","muscle signaling","β Hydroxybutyrate"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-ARLA"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-PR-ARLA","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"anabolic effects of oral leucine rich protein with and without β hydroxybutyrate on muscle protein metabolism in a novel clinical model of systemic inflammation a randomized crossover trial","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1093/ajcn/nqab148","version":"Published Version"},"id":"S01-000.00-227838","identifier":[{"id":"85116957181","type":"scopus"},{"id":"34081111","type":"pmid"}],"ids":["au-acc72f4f-6486-47a3-89d8-24170e17797b"],"keyword":["dairy protein","endotoxemia","fasting","immobilization","metabolism","muscle signaling","skeletal muscle","β-hydroxybutyrate"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-F53527D462C6BFB1CFF141F50D272AA4"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1093/ajcn/nqab148","version":"Published Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Endocrinology and Internal Medicine"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"arla foods","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-ARLA","l3nl":"Arla Foods","l3nn":"Arla Foods","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Arla Foods","namevar":["Arla Foods"],"nora_code":"DI-PR-ARLA","used":1}],"person":[{"affno":"1","corresponding":null,"first":"M","key":"mosepau","last":"Mose","locid":"f083dcfd-61ef-4f1d-885a-f858c035ffae","name":"Mose, Maike","name_org":"Mose, M","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"K","key":"brodersenpau","last":"Brodersen","locid":"322ef169-fde2-49c9-94b3-837f1e105291","name":"Brodersen, Katrine","name_org":"Brodersen, K","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"N","key":"rittigpau","last":"Rittig","locid":"7a9d4a8a-626a-4c30-bf6e-b466d53df686","name":"Rittig, Nikolaj","name_org":"Rittig, N","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"J","key":"schmidtpau","last":"Schmidt","name":"Schmidt, J","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"N","key":"jessenpau","last":"Jessen","locid":"ee850b0d-e5da-4aae-98ba-5e1e7c039f8c","name":"Jessen, Nicolai","name_org":"Jessen, N","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"U R","key":"mikkelsenpau","last":"Mikkelsen","name":"Mikkelsen, U R","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"J O L","key":"jørgensenpau","last":"Jørgensen","locid":"303ebe86-6861-4b19-b4d7-6bda0526b27e","name":"Jørgensen, Jens Otto Lunde","name_org":"Jørgensen, J O L","orcid":"0000-0001-7408-1526","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"N","key":"møllerpau","last":"Møller","locid":"2e0d8e2a-2da1-4d55-b2da-0a25c0375b1e","name":"Møller, Niels","name_org":"Møller, N","orcid":"0000-0001-5627-7322","rank":8,"rolecode":"pau"}],"pmid":["34081111"],"pub":{"doi":"10.1093/ajcn/nqab148","issn":["00029165","19383207"],"issn_org":["00029165"],"issue":"3","journal":"American Journal of Clinical Nutrition","pages":"1159-1172","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"p","title":"American Journal of Clinical Nutrition","title_org":"The American Journal of Clinical Nutrition","volume":"114"},"review":"Peer Reviewed","scoID":["2-s2.0-85116957181"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Private Research","All Universities","Arla Foods","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Private Research","Universities"],"PST":["Published"]},"sid":["au-acc72f4f-6486-47a3-89d8-24170e17797b"],"src":["AU Aarhus University"],"title":"Anabolic effects of oral leucine-rich protein with and without β-hydroxybutyrate on muscle protein metabolism in a novel clinical model of systemic inflammation-a randomized crossover trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-227838","year":"2021","yearsub":"2021"}
{"abstract":"During the transition from a healthy state to cardiometabolic disease, patients become heavily medicated, which leads to an increasingly aberrant gut microbiome and serum metabolome, and complicates biomarker discovery1–5. Here, through integrated multi-omics analyses of 2,173 European residents from the MetaCardis cohort, we show that the explanatory power of drugs for the variability in both host and gut microbiome features exceeds that of disease. We quantify inferred effects of single medications, their combinations as well as additive effects, and show that the latter shift the metabolome and microbiome towards a healthier state, exemplified in synergistic reduction in serum atherogenic lipoproteins by statins combined with aspirin, or enrichment of intestinal Roseburia by diuretic agents combined with beta-blockers. Several antibiotics exhibit a quantitative relationship between the number of courses prescribed and progression towards a microbiome state that is associated with the severity of cardiometabolic disease. We also report a relationship between cardiometabolic drug dosage, improvement in clinical markers and microbiome composition, supporting direct drug effects. Taken together, our computational framework and resulting resources enable the disentanglement of the effects of drugs and disease on host and microbiome features in multimedicated individuals. Furthermore, the robust signatures identified using our framework provide new hypotheses for drug–host–microbiome interactions in cardiometabolic disease.","author_count":43,"contributors":["Forslund, Sofia K.","Chakaroun, Rima","Zimmermann-Kogadeeva, Maria","Markó, Lajos","Aron-Wisnewsky, Judith","Nielsen, Trine","Moitinho-Silva, Lucas","Schmidt, Thomas S.B.","Falony, Gwen","Vieira-Silva, Sara","Adriouch, Solia","Alves, Renato J.","Assmann, Karen","Bastard, Jean Philippe","Birkner, Till","Caesar, Robert","Chilloux, Julien","Coelho, Luis Pedro","Fezeu, Leopold","Galleron, Nathalie","Helft, Gerard","Isnard, Richard","Ji, Boyang","Kuhn, Michael","Le Chatelier, Emmanuelle","Myridakis, Antonis","Olsson, Lisa","Pons, Nicolas","Prifti, Edi","Quinquis, Benoit","Roume, Hugo","Lewinter, Christian","Søndertoft, Nadja B.","Pedersen, Helle Krogh","Hansen, Tue Haldor","Hartmann, Bolette","Holst, Jens Juul","Hornbak, Malene","Jørgensen, Niklas Rye","Justesen, Johanne Marie","Hansen, Torben","Krarup, Nikolaj Thure","Svendstrup, Mathilde"],"cuid":["S01-000.00-437857"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Asia, East","Europe, EU","Europe, Non-EU","Nordic","OECD"],"corpau":["The MetaCardis Consortium*"],"country":["Belgium","China","France","Germany","Sweden","United Kingdom"],"glorg":["All Global Affiliations","Berlin Institute of Health","Chalmers University of Technology","Charité – Universitätsmedizin Berlin","Department of Environment Science and Engineering, Fudan University","European Molecular Biology Laboratory","German Centre for Cardiovascular Research","Hôpital Tenon","Imperial College London","Institute of Cardiometabolism and Nutrition","KU Leuven","Leipzig University","MOE Key Laboratory of Computational Neuroscience and Brain-Inspired Intelligence","Max Delbrück Center for Molecular Medicine in the Helmholtz Association","Paris-Saclay University","Sorbonne University","University of Gothenburg","Université Sorbonne Paris Nord","and MOE Frontiers Center for Brain Science"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"combinatorial additive and dose dependent drug microbiome associations","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-437857","identifier":[{"id":"000728552800005","type":"wos"},{"id":"3488048