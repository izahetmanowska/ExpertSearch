 H.","rank":31,"rolecode":"pau"},{"affno":"19","first":"T.","key":"treupau","last":"Treu","name":"Treu, T.","rank":32,"rolecode":"pau"},{"affno":"20","first":"B. J.","key":"weinerpau","last":"Weiner","name":"Weiner, B. J.","rank":33,"rolecode":"pau"},{"affno":"","first":"L. L. R.","key":"williamspau","last":"Williams","name":"Williams, L. L. R.","rank":34,"rolecode":"pau"},{"affno":"21","first":"A.","key":"zitrinpau","last":"Zitrin","name":"Zitrin, A.","rank":35,"rolecode":"pau"}],"pub":{"doi":"10.1038/s41550-018-0405-4","issn":["23973366"],"issue":"4","journal":"Nature Astronomy","pages":"324-333","status":"p","title":"Nature Astronomy","volume":"2"},"review":"Peer Reviewed","scoID":["2-s2.0-85045188740"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-d331f1e3-fb01-43d6-b0ab-8777fa94c1de"],"src":["KU University of Copenhagen"],"title":"Two peculiar fast transients in a strongly lensed host galaxy","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-519614","year":"2018","yearsub":"2018"}
{"abstract":"Background: Remote ischaemic preconditioning (RIPC) has been suggested as a means of protecting vital organs from reperfusion injury during major vascular surgery. This study was designed to determine whether RIPC could reduce the incidence of perioperative myocardial infarction (MI) during open surgery for ruptured abdominal aortic aneurysm (AAA). Secondary aims were to see if RIPC could reduce 30-day mortality, multiple organ failure, acute intestinal ischaemia, acute kidney injury and ischaemic stroke. Methods: This randomized, non-blinded clinical trial was undertaken at three vascular surgery centres in Denmark. Patients who had open surgery for ruptured AAA were randomized to intervention with RIPC or control in a 1:1 ratio. Postoperative complications and deaths were registered, and ECG and blood samples were obtained daily during the hospital stay. Results: Of 200 patients randomized, 142 (72 RIPC, 70 controls) were included. There was no difference in rates of perioperative MI between the RIPC and control groups (36 versus 43 per cent respectively), or in rates of organ Failure. However, in the per-protocol analysis 30-day mortality was significantly reduced in the RIPC group (odds ratio 0.46, 95 per cent c.i. 0.22 to 0.99; P=0.048). Conclusion: RIPC did not reduce the incidence of perioperative MI in patients undergoing open surgery for ruptured AAA.","author_count":8,"contributors":["Pedersen, T. F.","Budtz-Lilly, J.","Petersen, C. N.","Hyldgaard, J.","Schmidt, Jens-Ove","Kroijer, R.","Gronholdt, M-L","Eldrup, N."],"cuid":["S01-000.00-607430"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR","DI-HO-NDR"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-CDR","DI-HO-NDR","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"randomized clinical trial of remote ischaemic preconditioning versus no preconditioning in the prevention of perioperative myocardial infarction during open surgery for ruptured abdominal aortic aneurysm","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1002/bjs5.55","version":"Published Version"},"id":"S01-000.00-607430","identifier":[{"id":"PMC5989967","type":"pmcid"},{"id":"29951634","type":"pmid"}],"ids":["sdu-77645aed-041b-4052-8beb-f623facfb87c"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-3-5-68863CE164B64D4B6652B45B3EA89D12"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1002/bjs5.55","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/146506340/Pedersen_et_al_2018_BJS_Open.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1},{"affno":"2","country":"dk","key":"north denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-NDR","l3nl":"North Denmark Region","l3nn":"North Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"North Denmark Region","namevar":["Aalborg University Hospital"],"nora_code":"DI-HO-NDR","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Lillebælt Hospital, Research Unit of Vascular Surgery (Kolding)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"T. F.","key":"pedersenpau","last":"Pedersen","name":"Pedersen, T. F.","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"J.","key":"budtzlillypau","last":"Budtz-Lilly","name":"Budtz-Lilly, J.","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"C. N.","key":"petersenpau","last":"Petersen","name":"Petersen, C. N.","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"J.","key":"hyldgaardpau","last":"Hyldgaard","name":"Hyldgaard, J.","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"J-O","key":"schmidtpau","last":"Schmidt","locid":"8939f183-b866-46c8-aff8-748037bd1fe9","name":"Schmidt, Jens-Ove","name_org":"Schmidt, J-O","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"R.","key":"kroijerpau","last":"Kroijer","name":"Kroijer, R.","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"M-L","key":"gronholdtpau","last":"Gronholdt","name":"Gronholdt, M-L","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"N.","key":"eldruppau","last":"Eldrup","name":"Eldrup, N.","rank":8,"rolecode":"pau"}],"pmid":["29951634"],"pub":{"doi":"10.1002/bjs5.55","issn":["00071323","13557688"],"issn_org":["00071323"],"issue":"3","journal":"British Journal of Surgery","pages":"112-118","publisher":"Oxford University Press","status":"p","title":"British Journal of Surgery","volume":"2"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-77645aed-041b-4052-8beb-f623facfb87c"],"src":["SDU University of Southern Denmark"],"title":"Randomized clinical trial of remote ischaemic preconditioning versus no preconditioning in the prevention of perioperative myocardial infarction during open surgery for ruptured abdominal aortic aneurysm","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-607430","year":"2018","yearsub":"2018"}
{"abstract":"Toll-like receptor 9 (TLR9) agonists are being developed for treatment of colorectal and other cancers, yet the impact of these drugs on human intestines remains unknown. This, together with the fact that there are additional potential indications for TLR9 agonist therapy (e.g., autoimmune and infectious diseases), led us to investigate the impact of MGN1703 (Lefitolimod) on intestinal homeostasis and viral persistence in HIV-positive individuals. Colonic sigmoid biopsies were collected (baseline and week four) from 11 HIV+ individuals on suppressive antiretroviral therapy, who received MGN1703 (60 mg s.c.) twice weekly for 4 weeks in a single-arm, phase 1b/2a study. Within sigmoid mucosa, global transcriptomic analyses revealed 248 modulated genes (false discovery rate<0.05) including many type I interferon (IFN)-stimulated genes. MGN1703 increased the frequencies of cells exhibiting MX1 (P=0.001) and ISG15 (P=0.014) protein expression. No changes were observed in neutrophil infiltration (myeloperoxidase; P=0.97). No systematic effect on fecal microbiota structure was observed (analysis of similarity Global R=-0.105; P=0.929). TLR9 expression at baseline was inversely proportional to the change in integrated HIV DNA during MGN1703 treatment (P=0.020). In conclusion, MGN1703 induced a potent type I IFN response, without a concomitant general inflammatory response, in the intestines.Mucosal Immunology advance online publication, 02 August 2017; doi:10.1038/mi.2017.59.","author_count":24,"contributors":["Krarup, Astrid R","Abdel-Mohsen, M","Schleimann, Mariane Høgsbjerg","Vibholm, Line K.","Engen, P A","Dige, Anders","Wittig, B","Schmidt, M","Green, S J","Naqib, A","Keshavarzian, A","Deng, X","Olesen, Rikke","Petersen, A M","Benfield, T","Østergaard, Lars Jørgen","Rasmussen, Thomas A","Agnholt, J","Nyengaard, Jens Randel","Landay, A","Søgaard, Ole Schmeltz","Pillai, S K","Tolstrup, Martin","Denton, Paul W"],"cuid":["S02-100.00-023268"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","Europe, EU","OECD"],"country":["Germany","United States"],"glorg":["All Global Affiliations","Free University of Berlin","Rush University","University of California at San Francisco","University of Chicago","Wistar Institute"],"keyword":["Journal Article"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR"],"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the tlr000000000009 agonist mgn000000001703 triggers a potent type i interferon response in the sigmoid colon","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"http://europepmc.org/Copyright","type":"rem","url":"http://europepmc.org/backend/ptpmcrender.fcgi?accid=PMC5796873&blobtype=pdf","version":"Authors Final Version"},"id":"S02-100.00-023268","identifier":[{"id":"28766555","type":"pmid"},{"id":"85046098289","type":"scopus"},{"id":"PMC5796873","type":"pmcid"}],"ids":["au-913564ab-6f1f-42d1-a78e-d0dcddbd7179","ku-f9478202-b414-4435-b1b3-d52c58cad2d2"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-36B6F5E771F556AE1D2F3F6693C218C4"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC5796873/pdf/nihms880398.pdf","version":"Pre-print"},{"access":"oa","license":"http://europepmc.org/Copyright","type":"rem","url":"http://europepmc.org/backend/ptpmcrender.fcgi?accid=PMC5796873&blobtype=pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"au aarhus university"