003-1054-0601","rank":18,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Nadja Hawwa","key":"vissingpau","last":"Vissing","name":"Vissing, Nadja Hawwa","rank":19,"rolecode":"pau"},{"affno":"6 5","first":"Kjeld","key":"schmiegelowpau","last":"Schmiegelow","locid":"6ce2f948-244d-4f19-82aa-f08a71289674","name":"Schmiegelow, Kjeld","rank":20,"rolecode":"pau"},{"affno":"6 5","first":"Ulrikka","key":"nygaardpau","last":"Nygaard","locid":"43b2e239-ddc1-4676-a8db-0a0f23906813","name":"Nygaard, Ulrikka","rank":21,"rolecode":"pau"}],"pmid":["33956760"],"pub":{"doi":"10.1097/inf.0000000000003127","issn":["08913668","10733175"],"issn_org":["08913668"],"issue":"6","journal":"Pediatric Infectious Disease Journal","publisher":"Lippincott Williams and Wilkins","status":"p","title":"Pediatric Infectious Disease Journal","title_org":"The Pediatric Infectious Disease Journal","volume":"40"},"review":"Peer Reviewed","scoID":["2-s2.0-85105488661"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","North Denmark Region","Other Research","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-d723f50e-af1b-4d60-84fd-afe9dbc6ae1d","au-09d4ac23-d559-422b-bfc7-4718b8d9601a","ku-a2dfa168-3830-454a-ab36-657ed8d9ef67","sdu-804c8f60-d3c3-4e1d-89da-5532bfb996f3"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"The Need for Hospitalization due to SARS-CoV-2 in Children : A Population-based Estimate","type":"Journal Comment","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-095.71-010285","year":"2021","yearsub":"2021"}
{"abstract":"Objectives: The aim of this study was to evaluate the impact of CHA2DS2-VASc and HAS-BLED scores on ischemic and bleeding events of patients enrolled in the Amplatzer Amulet Observational Study. Background: Baseline CHA2DS2-VASc and HAS-BLED scores have been validated in atrial fibrillation patients to guide about anticoagulation but not in patients treated by left atrial appendage occlusion (LAAO). Methods: Subjects were stratified according to CHA2DS2-VASc and HAS-BLED scores. Clinical outcomes were collected through 2 years and adjudicated by an independent committee. Results: Subjects were considered at low (n = 156), moderate (n = 715), and high (n = 215) risk for ischemic stroke, corresponding to CHA2DS2-VASc scores of <3, 3 to 5, and ≥6, respectively. The annual rates of ischemic stroke were 1.1%, 2.0%, and 3.5%, respectively. When compared with the predicted rate, LAAO reduced the risk of ischemic stroke by 56%, 69%, and 68%. Device-related thrombus occurred in 0.7%, 1.5%, and 3.0% of subjects at low, moderate, and high risk for ischemic stroke, respectively. The HAS-BLED score was ≤3 in 629 subjects and >3 in 456 subjects, respectively. Non-peri-procedural major bleeding was reduced by 11% and 9% compared with predicted rates in the low and high bleeding risk groups, respectively. Conclusions: LAAO with the Amplatzer Amulet reduced the risk of ischemic stroke compared with the predicted rate, with a greater magnitude among patients at high thromboembolic risk without increasing the bleeding risk. (Amplatzer™Amulet™ Post-Market Study [Amulet™PMS]; NCT02447081)","author_count":16,"contributors":["Tarantini, Giuseppe","D'Amico, Gianpiero","Schmidt, Boris","Mazzone, Patrizio","Berti, Sergio","Fischer, Sven","Lund, Juha","Montorfano, Matteo","Della Bella, Paolo","Lam, Simon Cheung Chi","Cruz-Gonzalez, Ignacio","Gage, Ryan","Zhao, Hong","Omran, Heyder","Odenstedt, Jacob","Nielsen-Kudsk, Jens Erik"],"cuid":["S01-000.00-146586"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Asia, East","Europe, EU","Nordic","OECD"],"corresponding_author":["Tarantini, Giuseppe"],"country":["Finland","Germany","Hong Kong","Italy","Spain","Sweden","United States"],"glorg":["Abbott Laboratories","All Global Affiliations","Gabriele Monasterio Foundation","Harzklinikum Dorothea Christiane Erxleben GmbH","IRCCS San Raffaele Scientific Institute","Markus-Krankenhaus Frankfurt","St. Marien Hospital","Universidad de Salamanca","University of Gothenburg","University of Hong Kong","University of Padova","University of Turku"],"keyword":["Atrial fibrillation","Left atrial appendage closure"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"the impact of cha sub 000000000002 sub ds sub 000000000002 sub vasc and has bled scores on clinical outcomes in the amplatzer amulet study","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85090720345","version":"Other Version"},"id":"S01-000.00-146586","identifier":[{"id":"85090720345","type":"scopus"},{"id":"32972570","type":"pmid"}],"ids":["au-1e1c1d49-7445-46a2-bae8-5bfff28bdc77"],"keyword":["Amplatzer Amulet occluder","atrial fibrillation","left atrial appendage closure"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-8DFF136C7485162A5DF6A4B7316FEA4C"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"it","key":"university of padova","loc":["Italy","Europe, EU","OECD"],"name":"University of Padova","used":1},{"affno":"2","country":"de","key":"markus krankenhaus frankfurt","loc":["Germany","Europe, EU","OECD"],"name":"Markus-Krankenhaus 