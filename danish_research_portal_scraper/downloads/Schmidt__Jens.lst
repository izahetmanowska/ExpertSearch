senpau","last":"Olesen","locid":"eaf9b770-cd72-45dd-9ca8-e0e4ecc19c11","name":"Olesen, Jesper","rank":2,"rolecode":"pau"},{"affno":"1","first":"Rasmus Sjørup","key":"biensøpau","last":"Biensø","locid":"c6f3c9d2-fa70-4da8-bafc-c37d0334c653","name":"Biensø, Rasmus Sjørup","rank":3,"rolecode":"pau"},{"affno":"","first":"Stefan Peter","key":"mortensenpau","last":"Mortensen","locid":"73b0cad1-9702-4029-a03f-07483c561f78","name":"Mortensen, Stefan Peter","rank":4,"rolecode":"pau"},{"affno":"","first":"Michael Permin","key":"nybergpau","last":"Nyberg","locid":"3a44876c-6484-4899-ade6-7e80d0483f3d","name":"Nyberg, Michael Permin","orcid":"0000-0002-3937-4697","rank":5,"rolecode":"pau"},{"affno":"1","first":"Jakob Friis","key":"schmidtpau","last":"Schmidt","locid":"74b58d72-77a1-4d66-aaaa-c36189cbf0b6","name":"Schmidt, Jakob Friis","rank":6,"rolecode":"pau"},{"affno":"1","first":"Jens","key":"bangsbopau","last":"Bangsbo","locid":"24839560-f889-42a6-9b73-97b69f101548","name":"Bangsbo, Jens","orcid":"0000-0003-1305-9274","rank":7,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Henriette","key":"pilegaardpau","last":"Pilegaard","locid":"bca00b25-e11a-407d-936f-6982a39ef1d8","name":"Pilegaard, Henriette","orcid":"0000-0002-1071-0327","rank":8,"rolecode":"pau"},{"affno":"1","first":"Ylva","key":"hellstenpau","last":"Hellsten","locid":"902a8d03-73c1-41fa-a0a3-7f250470e2f0","name":"Hellsten, Ylva","orcid":"0000-0002-2435-9558","rank":9,"rolecode":"pau"}],"pmid":["24488075"],"pub":{"doi":"10.1113/jphysiol.2013.269696","issn":["00223751","14697793"],"issn_org":["00223751"],"issue":"3","journal":"Journal of Physiology","pages":"553","status":"p","title":"Journal of Physiology","volume":"592"},"review":"No Review","scoID":["2-s2.0-84893420162"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-f847e7a3-b971-47c8-8067-8ab6e4edde39"],"src":["KU University of Copenhagen"],"title":"Reply from Lasse Gliemann, Jesper Olesen, Rasmus Sjørup Biensø, Stefan Peter Mortensen, Michael Nyberg, Jens Bangsbo, Henriette Pilegaard and Ylva Hellsten","type":"Journal Comment","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-541662","year":"2014","yearsub":"2014"}
{"abstract":"The study examined the effects of 1 year of football or strength training on cardiovascular function in 65- to 75-year-old men. Twenty-six untrained men (age: 68.2 ± 3.2 years) were randomized to football training (FTG; n = 9), strength training (STG; n = 9), or control (CG; n = 8). In FTG, left ventricular (LV) internal diastolic diameter, end-diastolic volume, and mass index were 8%, 21%, and 18% higher (P < 0.01), respectively, after 12 months, with no changes in STG and CG. After 12 months, LV ejection fraction was increased (P < 0.05) by 8% and 5% in FTG and STG, respectively, and systolic longitudinal two-dimensional strain by 8% and 6%, whereas right ventricular systolic function improved (P < 0.05) by 22% in FTG, but not in STG and CG. In FTG, LV diastolic mitral inflow (E/A) ratio and peak early diastolic velocity (E') improved (P < 0.05) by 25% and 12%, respectively, after 12 months, with no changes in STG and CG. In FTG, maximum oxygen uptake was 16% and 18% higher (P < 0.001) after 4 and 12 months, respectively, and resting heart rate was 6 and 8 beats per minute lower (P < 0.001), respectively, with no changes in STG and CG. In conclusion, football training elicited superior cardiovascular effects compared with strength training in elderly untrained men.","author_count":7,"contributors":["Schmidt, Jakob Friis","Hansen, Peter Riis","Rostgaard Andersen, Thomas","Andersen, L J","Hornstrup, Therese","Krustrup, Peter","Bangsbo, Jens"],"cuid":["S02-098.37-045770"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of Exeter"],"keyword":["Adaptation Physiological","Aged","Comparative Study","Heart Rate","Heart Ventricles","Humans","Journal Article","Male","Oxygen Consumption","Randomized Controlled Trial","Research Support Non U S Gov t","Resistance Training","Soccer","Ultrasonography Doppler Pulsed","Ventricular Function Left"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"cardiovascular adaptations to 000000000004 and 000000000012 months of football or strength training in 000000000065 to 000000000075 year old untrained men","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1111/sms.12217","version":"Other Version"},"id":"S02-098.37-045770","identifier":[{"id":"84902662651","type":"scopus"},{"id":"24902992","type":"pmid"}],"ids":["ku-bcd5c7a5-9e3b-4c83-b742-596a400b37d3","sdu-06b4240c-21f9-4d1f-9d82-316ce811006e"],"keyword":["Adaptation, Physiological","Aged","Comparative Study","Heart Rate","Heart Ventricles","Humans","Journal Article","Male","Oxygen Consumption","Randomized Controlled Trial","Research Support, Non-U.S. Gov't","Resistance Training","Soccer","Ultrasonography, Doppler, Pulsed","Ventricular Function, Left"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-0BAD6DCAB7921FBCA7415BE4B4B0D0D1"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1111/sms.12217","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"gb","key":"university of exeter","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Exeter","used":1},{"affno":4,"key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics"],"nora_code":"DI-U-SDU"}],"person":[{"affno":"1","first":"Jakob Friis","key":"schmidtjakobfriispau","last":"Schmidt","name":"Schmidt, Jakob Friis","rank":1,"rolecode":"pau"},{"affno":"1 2","first":"Peter Riis","key":"hansenpeterriispau","last":"Hansen","locid":"9ab3e639-a02a-4ab7-9bde-d1d64cc7ecae","name":"Hansen, Peter Riis","orcid":"0000-0002-9056-535X","rank":2,"rolecode":"pau"},{"affno":"2","first":"Thomas","key":"rostgaardandersenthomaspau","last":"Rostgaard Andersen","locid":"8f0fc396-7917-4d99-ba5d-33ddf19e9566","name":"Rostgaard Andersen, Thomas","rank":3,"rolecode":"pau"},{"affno":"1","first":"L J","key":"andersenljpau","last":"Andersen","name":"Andersen, L J","rank":4,"rolecode":"pau"},{"affno":"2","first":"Therese","key":"hornstruptheresepau","last":"Hornstrup","locid":"a44d0bc0-e622-481b-ba67-4527d7ad6519","name":"Hornstrup, Therese","orcid":"0000-0001-6937-958X","rank":5,"rolecode":"pau"},{"affno":"2 3","first":"Peter","key":"krustruppeterpau","last":"Krustrup","locid":"9b334221-94f3-4a68-a2de-ee9f419704d8","name":"Krustrup, Peter","orcid":"0000-0001-9843-7320","rank":6,"rolecode":"pau"},{"affno":"2","first":"Jens","key":"bangsbojenspau","last":"Bangsbo","locid":"24839560-f889-42a6-9b73-97b69f101548","name":"Bangsbo, Jens","orcid":"0000-0003-1305-9274","rank":7,"rolecode":"pau"}],"pmid":["24902992"],"pub":{"doi":"10.1111/sms.12217","issn":["09057188","16000838"],"issn_org":["09057188"],"issue":"Suppl 1","journal":"Scandinavian Journal of Medicine & Science in Sports","pages":"86-97","publisher":"Wiley","status":"p","title":"Scandinavian Journal of Medicine & Science in Sports","volume":"24"},"review":"Peer Reviewed","scoID":["2-s2.0-84902662651"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-bcd5c7a5-9e3b-4c83-b742-596a400b37d3","sdu-06b4240c-21f9-4d1f-9d82-316ce811006e"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Cardiovascular adaptations to 4 and 12 months of football or strength training in 65- to 75-year-old untrained men","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-098.37-045770","year":"2014","yearsub":"2014"}
{"abstract":"The aeroelastic FLEX 5 code and a semi-advanced rigid multibody model has been utilized for simulating drivetrain forces and moments in a real 500 kW wind turbine. Experimental validation is carried out with results based on known physical properties of the blades, tower, hub, gearbox, shaft and nacelle, etc. The multibody model consists of eight bodies, from rotor to generator, where most joints are made using simple constraints. Semi-advanced gear constraints are used for obtaining (worst-case) gear tooth reaction forces in the first stage of the planetary gearbox. This constraint is useful for not only transferring torque but also for calculating the gear tooth and internal body reaction forces. The method is appropriate for predicting gear tooth stresses without considering all the complexity of gear tooth geometries. This means that, e.g. gear tooth load-sharing and load-distribution among multiple planetary gears are not taken into account. Finite Element Method (FEM) calculations show that when the wind turbine runs close to the maximum wind speed, the maximum gear tooth stress is in the range of 500–700 MPa, which is considered to be realistic using a “worst-case” method. The presented method is based on a comprehensive description of the aerodynamic input, including inflow turbulence and shear, as well as various modifications for yaw, dynamic stall and dynamic inflow. Forces and torque from the aeroelastic and industryaccepted code FLEX 5 are used as input to the multibody program, where the gear constraint is formulated such that the maximum tooth forces are included directly in the solution. Copyright © 2013 John Wiley & Sons, Ltd.","author_count":4,"contributors":["Jørgensen, Martin Felix","Pedersen, Niels Leergaard","Sørensen, Jens Nørkær","Schmidt Paulsen, Uwe"],"cuid":["S01-000.00-339784"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Drivetrain","FEM","Multibody","Wind energy"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"rigid matlab drivetrain model of a 000000000500 kw wind turbine for predicting maximum gear tooth stresses in a planetary gearbox using multibody gear constraints","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1002/we.1660","version":"Other Version"},"id":"S01-000.00-339784","identifier":[{"id":"84908545679","type":"scopus"}],"ids":["dtu-75e2d1c8-b6d8-49ca-aedf-6b0a23d9e29a"],"keyword":["Drivetrain","FEM","Multibody","Planetary gearbox","Tooth stresses","Wind Energy"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-7B4EF8FF216095AEF2897700A6BA76CB"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1002/we.1660","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Mechanical Engineering","Technical University of Denmark, Department of Mechanical Engineering, Solid Mechanics"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Martin Felix","key":"jørgensenpau","last":"Jørgensen","locid":"03ea6b95-3a21-48bb-bf7f-821027cd6d5d","name":"Jørgensen, Martin Felix","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Niels Leergaard","key":"pedersenpau","last":"Pedersen","locid":"e21a6065-e719-4ef8-ad66-a777acae6885","name":"Pedersen, Niels Leergaard","orcid":"0000-0002-4659-5623","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens Nørkær","key":"sørensenpau","last":"Sørensen","locid":"cb5cdeac-3157-4130-a990-29da0ed7be90","name":"Sørensen, Jens Nørkær","orcid":"0000-0002-1974-2675","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Uwe","key":"schmidtpaulsenpau","last":"Schmidt Paulsen","locid":"1ca05d05-ae00-49ee-8355-7f76690a269e","name":"Schmidt Paulsen, Uwe","orcid":"0000-0002-8991-5658","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1002/we.1660","issn":["10954244","10991824"],"issn_org":["10954244"],"journal":"Wind Energy","pages":"1659-1676","publisher":"John Wiley and Sons Ltd","status":"p","title":"Wind Energy","volume":"17"},"review":"Peer Reviewed","scoID":["2-s2.0-84908545679"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-75e2d1c8-b6d8-49ca-aedf-6b0a23d9e29a"],"src":["DTU Technical University of Denmark"],"title":"Rigid MATLAB drivetrain model of a 500 kW wind turbine for predicting maximum gear tooth stresses in a planetary gearbox using multibody gear constraints","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-339784","year":"2014","yearsub":"2014"}
{"abstract":"The effects of regular football training on glycemic control, body composition, and peak oxygen uptake (VO2 peak) were investigated in men with type 2 diabetes mellitus (T2DM). Twenty-one middle-aged men (49.8 ± 1.7 years ± SEM) with T2DM were divided into a football training group (FG; n = 12) and an inactive control group (CG; n = 9) during a 24-week intervention period (IP). During a 1-h football training session, the distance covered was 4.7 ± 0.2 km, mean heart rate (HR) was 83 ± 2% of HRmax, and blood lactate levels increased (P < 0.001) from 2.1 ± 0.3 to 8.2 ± 1.3 mmol/L. In FG, VO2 peak was 11% higher (P < 0.01), and total fat mass and android fat mass were 1.7 kg and 12.8% lower (P < 0.001), respectively, after IP. After IP, the reduction in plasma glucose was greater (P = 0.02) in FG than the increase in CG, and in FG, GLUT-4 tended to be higher (P = 0.072) after IP. For glycosylated hemoglobin (HbA1), an overall time effect (P < 0.01) was detected after 24 weeks. After IP, the number of capillaries around type I fibers was 7% higher (P < 0.05) in FG and 5% lower (P < 0.05) in CG. Thus, in men with T2DM, regular football training improves VO2 peak, reduces fat mass, and may positively influence glycemic control.","author_count":10,"contributors":["Rostgaard Andersen, Thomas","Schmidt, Jakob Friis","Thomassen, Martin","Hornstrup, Therese","Frandsen, U","Randers, Morten Bredsgaard","Hansen, Peter Riis","Krustrup, Peter","Bangsbo, Jens"],"cuid":["S02-097.57-046397"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of Exeter"],"keyword":["FGF 21","Health","High intensity training","Oxidative capacity","Soccer","Team sport"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"a preliminary study effects of football training on glucose control body composition and performance in men with type 000000000002 diabetes","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1111/sms.12259","version":"Other Version"},"id":"S02-097.57-046397","identifier":[{"id":"84902662921","type":"scopus"},{"id":"24903461","type":"pmid"}],"ids":["ku-d1426814-3731-4edb-a25d-63dcacce8f2d","sdu-564d9559-2549-429f-9ded-ca036001dc91"],"keyword":["FGF-21","Health","High-intensity training","Oxidative capacity","Soccer","Soccer high-intensity training oxidative capacity health team sport FGF-21 GLYCEMIC CONTROL CARDIORESPIRATORY FITNESS CARDIOVASCULAR-DISEASE INSULIN SENSITIVITY SKELETAL-MUSCLE PHYSICAL INACTIVITY SOCCER PLAYERS EXERCISE MELLITUS METAANALYSIS","Team sport"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-12C499E4AC0CABC7FA20677BD66716C7"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1111/sms.12259","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Nutrition, Exercise and Sports, The August Krogh Section for Human Physiology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics, Research Unit of Muscle Physiology and Biomechanics"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"4","country":"gb","key":"university of exeter","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Exeter","used":1}],"person":[{"affno":"1","first":"Thomas","key":"rostgaardandersenpau","last":"Rostgaard Andersen","locid":"8f0fc396-7917-4d99-ba5d-33ddf19e9566","name":"Rostgaard Andersen, Thomas","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"T. R.","key":"andersenpau","last":"Andersen","locid":"c2dce20a-35a3-4e4e-a473-dfc848b56859","name":"Andersen, Thomas Rostgaard","name_org":"Andersen, T. R.","orcid":"0000-0002-0315-0202","rank":1,"rolecode":"pau"},{"affno":"1","first":"Jakob Friis","key":"schmidtpau","last":"Schmidt","locid":"74b58d72-77a1-4d66-aaaa-c36189cbf0b6","name":"Schmidt, Jakob Friis","rank":2,"rolecode":"pau"},{"affno":"1","first":"Martin","key":"thomassenpau","last":"Thomassen","locid":"20bc3fb3-0877-4809-b3bf-0c7eed381b89","name":"Thomassen, Martin","orcid":"0000-0001-7503-6815","rank":3,"rolecode":"pau"},{"affno":"1","first":"Therese","key":"hornstruppau","last":"Hornstrup","locid":"a44d0bc0-e622-481b-ba67-4527d7ad6519","name":"Hornstrup, Therese","orcid":"0000-0001-6937-958X","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"U.","key":"frandsenpau","last":"Frandsen","locid":"cfa419b9-9116-4553-8bb9-363a443f07f2","name":"Frandsen, Ulrik","name_org":"Frandsen, U.","rank":5,"rolecode":"pau"},{"affno":"1","first":"Morten Bredsgaard","key":"randerspau","last":"Randers","locid":"5f16a5dd-f231-48c6-bddd-cd4ec6b20ea4","name":"Randers, Morten Bredsgaard","orcid":"0000-0002-0192-8981","rank":6,"rolecode":"pau"},{"affno":"1 3","first":"Peter Riis","key":"hansenpau","last":"Hansen","locid":"9ab3e639-a02a-4ab7-9bde-d1d64cc7ecae","name":"Hansen, Peter Riis","orcid":"0000-0002-9056-535X","rank":7,"rolecode":"pau"},{"affno":"1 4","first":"Peter","key":"krustruppau","last":"Krustrup","locid":"9b334221-94f3-4a68-a2de-ee9f419704d8","name":"Krustrup, Peter","orcid":"0000-0001-9843-7320","rank":8,"rolecode":"pau"},{"affno":"1","first":"Jens","key":"bangsbopau","last":"Bangsbo","locid":"24839560-f889-42a6-9b73-97b69f101548","name":"Bangsbo, Jens","orcid":"0000-0003-1305-9274","rank":9,"rolecode":"pau"}],"pmid":["24903461"],"pub":{"doi":"10.1111/sms.12259","issn":["09057188","16000838"],"issn_org":["09057188"],"issue":"SUPPL.1","journal":"Scandinavian Journal of Medicine & Science in Sports","pages":"43-56","publisher":"Wiley","status":"p","title":"Scandinavian Journal of Medicine & Science in Sports","volume":"24"},"review":"Peer Reviewed","scoID":["2-s2.0-84902662921"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-d1426814-3731-4edb-a25d-63dcacce8f2d","sdu-564d9559-2549-429f-9ded-ca036001dc91"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"A preliminary study : Effects of football training on glucose control, body composition, and performance in men with type 2 diabetes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-097.57-046397","year":"2014","yearsub":"2014"}
{"abstract":"BACKGROUND: The impact of adherence to the recommended duration of dual antiplatelet therapy after first generation drug-eluting stent implantation is difficult to assess in real-world settings and limited data are available. METHODS: We followed 4,154 patients treated with coronary drug-eluting stents in Western Denmark for 1 year and obtained data on redeemed clopidogrel prescriptions and major adverse cardiovascular events (MACE, i.e., cardiac death, myocardial infarction, or stent thrombosis) from medical databases. RESULTS: Discontinuation of clopidogrel within the first 3 months after stent implantation was associated with a significantly increased rate of MACE at 1-year follow-up (hazard ratio (HR) 2.06; 95% confidence interval (CI): 1.08-3.93). Discontinuation 3-6 months (HR 1.29; 95% CI: 0.70-2.41) and 6-12 months (HR 1.29; 95% CI: 0.54-3.07) after stent implantation were associated with smaller, not statistically significant, increases in MACE rates. Among patients who discontinued clopidogrel, MACE rates were highest within the first 2 months after discontinuation. CONCLUSIONS: Discontinuation of clopidogrel was associated with an increased rate of MACE among patients treated with drug-eluting stents. The increase was statistically significant within the first 3 months after drug-eluting stent implantation but not after 3 to 12 months.","author_count":15,"contributors":["Thim, Troels","Johansen, Martin Berg","Chisholm, Gro Egholm","Schmidt, Morten","Kaltoft, Anne","Sørensen, Henrik Toft","Thuesen, Leif","Kristensen, Steen Dalby","Bøtker, Hans Erik","Krusell, Lars Romer","Lassen, Jens Flensted","Thayssen, Per","Jensen, Lisette Okkels","Tilsted, Hans-Henrik","Maeng, Michael"],"cuid":["S03-100.00-005973"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"keyword":["Clopidogrel","Drug eluting stent","Dual antiplatelet therapy","Percutaneous Coronary Intervention"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-CDR","DI-U-AAU","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"clopidogrel discontinuation within the first year after coronary drug eluting stent implantation an observational study","src":["aau","au","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/1471-2261-14-100","version":"Published Version"},"id":"S03-100.00-005973","identifier":[{"id":"WOS:000340630300002","type":"wos"},{"id":"25125079","type":"pmid"},{"id":"84908075532","type":"scopus"},{"id":"PMC4135343","type":"pmcid"}],"ids":["aau-7af05a7c-1e9d-4f7c-b81d-997ad84c268e","au-d76b7761-8263-4a7a-901e-c43ff821f4e6","sdu-765c7173-c923-4ea4-bed5-def15d9917f9"],"keyword":["Clopidogrel","Drug-eluting stent","Dual antiplatelet therapy","Percutaneous coronary intervention"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-09642C6B73F7B68540F52BDDAB2A253B"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/191811745/1471_2261_14_100.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/1471-2261-14-100","version":"Published Version"},{"access":"oa","type":"rem","url":"http://www.ncbi.nlm.nih.gov/pmc/articles/PMC4135343/","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Departmen