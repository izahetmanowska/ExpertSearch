corresponding":null,"country":"dk","first":"Andreas Nørgaard","key":"gludpau","last":"Glud","locid":"7c293aba-b85e-4919-ac45-c7fe82208804","name":"Glud, Andreas Nørgaard","orcid":"0000-0003-3339-6120","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Dariusz","key":"orlowskipau","last":"Orlowski","locid":"d6cdf54a-52e1-4496-9785-da0ef112b26c","name":"Orlowski, Dariusz","orcid":"0000-0002-9542-402X","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"J","key":"jakobsenpau","last":"Jakobsen","name":"Jakobsen, J","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Michael","key":"pedersenpau","last":"Pedersen","locid":"871199c4-33bb-4fac-95ef-9a2266f30695","name":"Pedersen, Michael","orcid":"0000-0002-1146-0382","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Kåre Schmidt Ettrup","key":"ettruppau","last":"Ettrup","locid":"8863b0b7-8c38-42cd-be8d-4544230a3d4e","name":"Ettrup, Kåre Schmidt Ettrup","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mark J.","key":"westpau","last":"West","locid":"7d364661-a2c8-49fd-b9fe-a66a2c2aa0da","name":"West, Mark J.","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Dirk","key":"benderpau","last":"Bender","locid":"8dc9c132-74d9-4440-97e8-c6b77d48785b","name":"Bender, Dirk","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Carsten","key":"bjarkampau","last":"Bjarkam","name":"Bjarkam, Carsten","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens Christian Hedemann","key":"sørensenpau","last":"Sørensen","locid":"f442e934-3b4d-4fc2-91dc-93621be94d60","name":"Sørensen, Jens Christian Hedemann","orcid":"0000-0001-5139-7405","rank":10,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-1a34227a-e2c3-4005-b281-5228432d3c5c"],"src":["AU Aarhus University"],"title":"The anatomy and neurohistology of the minipig pituitary","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-144361","year":"2016","yearsub":"2016"}
{"abstract":"BACKGROUND & AIMS: Acute liver failure (ALF) often results in cardiovascular instability, renal failure, brain oedema and death either due to irreversible shock, cerebral herniation or development of multiple organ failure. High-volume plasma exchange (HVP), defined as exchange of 8-12 or 15% of ideal body weight with fresh frozen plasma in case series improves systemic, cerebral and splanchnic parameters. METHODS: In this prospective, randomised, controlled, multicentre trial we randomly assigned 182 patients with ALF to receive either standard medical therapy (SMT; 90 patients) or SMT plus HVP for three days (92 patients). The baseline characteristics of the groups were similar. The primary endpoint was liver transplantation-free survival during hospital stay. Secondary-endpoints included survival after liver transplantation with or without HVP with intention-to-treat analysis. A proof-of-principle study evaluating the effect of HVP on the immune cell function was also undertaken. RESULTS: For the entire patient population, overall hospital survival was 58.7% for patients treated with HVP vs. 47.8% for the control group (hazard ratio (HR), with stratification for liver transplantation: 0.56; 95% confidence interval (CI), 0.36-0.86; p=0.0083). HVP prior to transplantation did not improve survival compared with patients who received SMT alone (CI 0.37 to 3.98; p=0.75). The incidence of severe adverse events was similar in the two groups. Systemic inflammatory response syndrome (SIRS) and sequential organ failure assessment (SOFA) scores fell in the treated group compared to control group, over the study period (p<0.001). CONCLUSIONS: Treatment with HVP improves outcome in patients with ALF by increasing liver transplant-free survival. This is attributable to attenuation of innate immune activation and amelioration of multi-organ dysfunction.","author_count":18,"contributors":["Larsen, Fin Stolze","Schmidt, Lars","Bernsmeier, Christine","Rasmussen, Allan","Isoniemi, Helena","Patel, Vishal C","Triantafyllou, Evangelos","Bernal, William","Auzinger, Georg","Shawcross, Debbie","Eefsen, Martin","Bjerring, Peter Nissen","Clemmesen, Jens Otto","Hockerstedt, Krister","Frederiksen, Hans-Jørgen","Hansen, Bent Adel","Antoniades, Charalambos G","Wendon, Julia"],"cuid":["S01-000.00-414498"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Adult","Cytokines","Female","Humans","Journal Article","Liver Failure Acute","Male","Middle Aged","Multicenter Study","Plasma Exchange","Prospective Studies","Randomized Controlled Trial","Research Support Non U S Gov t"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"high volume plasma exchange in patients with acute liver failure an open randomised controlled trial","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-414498","identifier":[{"id":"84949513189","type":"scopus"},{"id":"26325537","type":"pmid"}],"ids":["ku-2344d8b3-1c73-405d-9def-4469e76cb227"],"keyword":["Adult","Cytokines","Female","Humans","Journal Article","Liver Failure, Acute","Male","Middle Aged","Multicenter Study","Plasma Exchange","Prospective Studies","Randomized Controlled Trial","Research Support, Non-U.S. Gov't"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-B355B5709701DA2699DCDF51E4B3A27E"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Fin Stolze","key":"larsenpau","last":"Larsen","name":"Larsen, Fin Stolze","rank":1,"rolecode":"pau"},{"affno":"1","first":"Lars Ebbe","key":"schmidtpau","last":"Schmidt","locid":"74fdd194-683b-414f-9d1a-d036c2cac84e","name":"Schmidt, Lars","name_org":"Schmidt, Lars Ebbe","rank":2,"rolecode":"pau"},{"affno":"","first":"Christine","key":"bernsmeierpau","last":"Bernsmeier","name":"Bernsmeier, Christine","rank":3,"rolecode":"pau"},{"affno":"","first":"Allan","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Allan","rank":4,"rolecode":"pau"},{"affno":"","first":"Helena","key":"isoniemipau","last":"Isoniemi","name":"Isoniemi, Helena","rank":5,"rolecode":"pau"},{"affno":"","first":"Vishal C","key":"patelpau","last":"Patel","name":"Patel, Vishal C","rank":6,"rolecode":"pau"},{"affno":"","first":"Evangelos","key":"triantafylloupau","last":"Triantafyllou","name":"Triantafyllou, Evangelos","rank":7,"rolecode":"pau"},{"affno":"","first":"William","key":"bernalpau","last":"Bernal","name":"Bernal, William","rank":8,"rolecode":"pau"},{"affno":"","first":"Georg","key":"auzingerpau","last":"Auzinger","name":"Auzinger, Georg","rank":9,"rolecode":"pau"},{"affno":"","first":"Debbie","key":"shawcrosspau","last":"Shawcross","name":"Shawcross, Debbie","rank":10,"rolecode":"pau"},{"affno":"","first":"Martin","key":"eefsenpau","last":"Eefsen","name":"Eefsen, Martin","rank":11,"rolecode":"pau"},{"affno":"","first":"Peter Nissen","key":"bjerringpau","last":"Bjerring","name":"Bjerring, Peter Nissen","rank":12,"rolecode":"pau"},{"affno":"","first":"Jens Otto","key":"clemmesenpau","last":"Clemmesen","name":"Clemmesen, Jens Otto","rank":13,"rolecode":"pau"},{"affno":"","first":"Krister","key":"hockerstedtpau","last":"Hockerstedt","name":"Hockerstedt, Krister","rank":14,"rolecode":"pau"},{"affno":"","first":"Hans-Jørgen","key":"frederiksenpau","last":"Fre