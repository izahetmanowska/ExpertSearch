ng":null,"first":"David","key":"thalerpau","last":"Thaler","name":"Thaler, David","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Sajjad A","key":"sabirpau","last":"Sabir","name":"Sabir, Sajjad A","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Alok","key":"gambhirpau","last":"Gambhir","name":"Gambhir, Alok","rank":6,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Ulf","key":"landmesserpau","last":"Landmesser","name":"Landmesser, Ulf","rank":7,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Neeraj","key":"shahpau","last":"Shah","name":"Shah, Neeraj","rank":8,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"William","key":"graypau","last":"Gray","name":"Gray, William","rank":9,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Vijendra","key":"swaruppau","last":"Swarup","name":"Swarup, Vijendra","rank":10,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"D Scott","key":"limpau","last":"Lim","name":"Lim, D Scott","rank":11,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Konstantinos","key":"koulogiannispau","last":"Koulogiannis","name":"Koulogiannis, Konstantinos","rank":12,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Jordan A","key":"andersonpau","last":"Anderson","name":"Anderson, Jordan A","rank":13,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Ryan","key":"gagepau","last":"Gage","name":"Gage, Ryan","rank":14,"rolecode":"pau"},{"affno":"8","corresponding":null,"first":"Dhanunjaya","key":"lakkireddypau","last":"Lakkireddy","name":"Lakkireddy, Dhanunjaya","rank":15,"rolecode":"pau"}],"pmid":["36697204"],"pub":{"doi":"10.1016/j.jacep.2022.07.014","issn":["2405500X"],"issue":"1","journal":"JACC: Clinical Electrophysiology","pages":"96-107","publisher":"Elsevier Inc.","status":"p","title":"JACC: Clinical Electrophysiology","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-85146131609"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-d84cd444-0a6b-4196-aeb4-bcd6af261a50"],"src":["AU Aarhus University"],"title":"Incidence, Predictors, and Clinical Outcomes of Device-Related Thrombus in the Amulet IDE Trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-252838","year":"2023","yearsub":"2023"}
{"abstract":"We analyze the role and effect of ecosystem leadership understood as the exercise of effort towards others with the purpose of establishing and maintaining an ecosystem around a focal systemic innovation. While there has been much attention to the firms that sponsor ecosystems in the ecosystem literature, ecosystem leaders are usually characterized in an atheoretical manner, and the emphasis is on, leadership in existing ecosystems, thus neglecting the role leadership might play in ecosystem emergence. We clarify and provide theoretical grounding for the important role of leadership in emerging and maturing ecosystems. Building on transaction cost economics, we conceptualize an ecosystem as a governance structure that enables and sustains coordination and cooperation among multiple economic agents towards a focal innovative value proposition. Our basic argument is that the emergence of such an ecosystems is hampered by coordination and cooperation problems which markets and the price system cannot solve by itself. Resolving these problems requires assistance, and such assistance is what we call ecosystem leadership. To further characterize the exercise of leadership we use Teece's tripartite dynamic capabilities scheme. Leadership enables ecosystem emergence through three externally-oriented dynamic capabilities: facilitating the formation of a shared vision (sensing), inducing others to make ecosystem-specific investments (seizing) and engaging in ad hoc problem solving to create and maintain stability (reconfiguring/transforming). The latter capability in particular often continues to be important in a mature ecosystem. We provide a characterization of these capabilities and argue that the ecosystem leader role in a mature ecosystem likely stems from having successfully exercised these capabilities and that their exercise also puts the leader in a prime position for value capture. We discuss implications of our arguments for ecosystem theories, for managers and for policy makers","author_count":3,"contributors":["Foss, Nicolai J.","Schmidt, Jens","Teece, David J."],"cuid":["S01-000.00-299548"],"filters":{"added":"2022-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","Europe, EU","Nordic","OECD"],"corresponding_author":["Foss, Nicolai J."],"country":["Finland","United States"],"glorg":["Aalto University","All Global Affiliations","University of California, Berkeley"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"pr","rtype":["clu"],"sorti":"ecosystem leadership as a dynamic capability","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.lrp.2022.102270","version":"Published Version"},"id":"S01-000.00-299548","identifier":[{"id":"85140973197","type":"scopus"}],"ids":["cbs-fcbb6d5a-d816-4d67-8f77-4aea963782fe"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-4-719AD11C303FA90C1077BB076966B58F"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.lrp.2022.102270","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://research-api.cbs.dk/ws/files/87321860/foss_nicolai_j_et_al_ecosystem_leadership_as_a_dynamic_capability_publishersversion.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Social Science (SOC)"],"yearPub":"2023","yearSub":"2022"},"org":[{"affno":"1","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Strategy and Innovation"],"nora_code":"DI-U-CBS","used":1},{"affno":"2","country":"fi","key":"aalto university","loc":["Finland","Europe, EU","Nordic","OECD"],"name":"Aalto University","used":1},{"affno":"3","country":"us","key":"university of california berkeley","loc":["United States","America, North","OECD"],"name":"University of California, Berkeley","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Nicolai J.","key":"fosspau","last":"Foss","locid":"7f0ced62-e3e8-4d60-ac5d-48a57edef7ca","name":"Foss, Nicolai J.","orcid":"0000-0003-2049-8347","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jens","key":"schmidtpau","last":"Schmidt","name":"Schmidt, Jens","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"David J.","key":"teecepau","last":"Teece","name":"Teece, David J.","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.lrp.2022.102270","issn":["00246301","18731872"],"issn_org":["00246301"],"issue":"1","journal":"Long Range Planning","paperid":"102270","publisher":"Elsevier","status":"p","title":"Long Range Planning","volume":"56"},"review":"Peer Reviewed","scoID":["2-s2.0-85140973197"],"search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["cbs-fcbb6d5a-d816-4d67-8f77-4aea963782fe"],"src":["CBS Copenhagen Business School"],"title":"Ecosystem Leadership as a Dynamic Capability","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-299548","year":"2023","yearsub":"2022"}
{"abstract":"AIMS: The voltage-gated potassium channel K v 11.1 is important for repolarising the membrane potential in excitable cells such as myocytes, pancreatic α- and β-cells. Moxifloxacin blocks the K v 11.1 channel and increases the risk of hypoglycaemia in patients with diabetes. We investigated glucose regulation and secretion of glucoregulatory hormones in young people with and without moxifloxacin a drug known to block the K v 11.1 channel. MATERIAL AND METHODS: The effect of moxifloxacin (800 mg/day for four days) or placebo on glucose regulation was assessed in a randomised, double-blind, crossover study of young men and women (age 20-40 years and BMI 18.5-27.5 kg/m 2 ) without chronic disease, using 6-hour oral glucose tolerance tests (OGTT) and continuous glucose monitoring (CGM). RESULTS: Thirty-eight participants completed the study. Moxifloxacin prolonged the QTcF-interval and increased heart rate. Hypoglycaemia was more frequently observed with moxifloxacin, both during the eight days of CGM and during the OGTT. Hypoglycaemia questionnaire scores were higher after intake of moxifloxacin. Moxifloxacin reduced early plasma-glucose response (AUC 0-30min ) by 7% (95%CI: -9% to -4%, p<0.01), and overall insulin response (AUC 0-360min ) decreased by 18% (95%CI: -24% to -11%, p<0.01) and plasma glucagon increased by 17% (95%CI: 4% to 33%, p=0.03). Insulin sensitivity calculated as Matsuda index increased by 11%, and MISI, an index of muscle insulin sensitivity, increased by 34%. CONCLUSIONS: In young men and women, moxifloxacin a drug known to block the K v 11.1 channel increased QT interval, decreased glucose levels, and was associated with increased muscle insulin sensitivity and more frequent episodes of hypoglycaemia. This article is protected by copyright. All rights reserved.","author_count":12,"contributors":["Juhl, Christian Rimer","Burgdorf, Josephine","Knudsen, Cecilie","Lubberding, Anniek Frederike","Veedfald, Simon","Isaksen, Jonas L.","Hartmann, Bolette","Frikke-Schmidt, Ruth","Mandrup-Poulsen, Thomas","Holst, Jens Juul","Kanters, Jørgen K.","Torekov, Signe Sørensen"],"cuid":["S01-000.00-432493"],"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"a randomised double blind crossover study of the effect of the fluoroquinolone moxifloxacin on glucose levels and insulin sensitivity in young men and women","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1111/dom.14851","version":"Published Version"},"id":"S01-000.00-432493","identifier":[{"id":"PMC10087839","type":"pmcid"},{"id":"85137852402","type":"scopus"},{"id":"36054143","type":"pmid"}],"ids":["ku-4155e42f-fc8f-4026-8968-77e54cdba82a"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-6DF01DF676AC568BEB403A043A5E9599"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://curis.ku.dk/ws/files/329427442/Diabetes_Obesity_Metabolism_2022_Juhl_A_randomized_double_blind_crossover_study_of_the_effect_of_the.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1111/dom.14851","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Biomedical Sciences, Endocrinology and Metabolism"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Christian R","key":"juhlpau","last":"Juhl","locid":"18d8e8fd-21c1-4352-a747-6c0cc9087510","name":"Juhl, Christian Rimer","name_org":"Juhl, Christian R","orcid":"0000-0003-3024-4017","rank":1,"rolecode":"pau"},{"affno":"1","first":"Josephine","key":"burgdorfpau","last":"Burgdorf","name":"Burgdorf, Josephine","rank":2,"rolecode":"pau"},{"affno":"1","first":"Cecilie","key":"knudsenpau","last":"Knudsen","name":"Knudsen, Cecilie","rank":3,"rolecode":"pau"},{"affno":"1","first":"Anniek F","key":"lubberdingpau","last":"Lubberding","locid":"1e6eede6-d706-4e3a-903b-fb86d5374d13","name":"Lubberding, Anniek Frederike","name_org":"Lubberding, Anniek F","orcid":"0000-0002-6691-8581","rank":4,"rolecode":"pau"},{"affno":"1","first":"Simon","key":"veedfaldpau","last":"Veedfald","locid":"b6633087-c392-4c8b-814e-abeeb5865b71","name":"Veedfald, Simon","rank":5,"rolecode":"pau"},{"affno":"1","first":"Jonas L","key":"isaksenpau","last":"Isaksen","locid":"46a93bd5-94a8-4b64-b64f-e7cffd686aa7","name":"Isaksen, Jonas L.","name_org":"Isaksen, Jonas L","orcid":"0000-0003-3227-1131","rank":6,"rolecode":"pau"},{"affno":"1","first":"Bolette","key":"hartmannpau","last":"Hartmann","locid":"eb04fc6b-068a-4d5b-a106-1b7be3f7e12b","name":"Hartmann, Bolette","orcid":"0000-0001-8509-2036","rank":7,"rolecode":"pau"},{"affno":"1","first":"Ruth","key":"frikkeschmidtpau","last":"Frikke-Schmidt","locid":"bce2c3b4-6e08-46c7-96c6-7e385b0ec8b3","name":"Frikke-Schmidt, Ruth","rank":8,"rolecode":"pau"},{"affno":"1","first":"Thomas","key":"mandruppoulsenpau","last":"Mandrup-Poulsen","locid":"3d24585d-c2e8-4656-b1a6-3aa703263d73","name":"Mandrup-Poulsen, Thomas","rank":9,"rolecode":"pau"},{"affno":"1","first":"Jens J","key":"holstpau","last":"Holst","locid":"864b6401-9024-4773-9bdb-f4d4ca57dcad","name":"Holst, Jens Juul","name_org":"Holst, Jens J","orcid":"0000-0001-6853-3805","rank":10,"rolecode":"pau"},{"affno":"1","first":"Jørgen K","key":"kanterspau","last":"Kanters","locid":"f544654f-76ab-44f6-a780-d0a011eb7341","name":"Kanters, Jørgen K.","name_org":"Kanters, Jørgen K","orcid":"0000-0002-3267-4910","rank":11,"rolecode":"pau"},{"affno":"1","first":"Signe S","key":"torekovpau","last":"Torekov","locid":"c1d71a61-ee09-4c29-ae48-7520707a73be","name":"Torekov, Signe Sørensen","name_org":"Torekov, Signe S","orcid":"0000-0001-6779-0252","rank":12,"rolecode":"pau"}],"pmid":["36054143"],"pub":{"doi":"10.1111/dom.14851","issn":["14628902","14631326"],"issn_org":["14628902"],"issue":"1","journal":"Diabetes, Obesity and Metabolism","pages":"98-109","status":"p","title":"Diabetes, Obesity and Metabolism","volume":"25"},"review":"Peer Reviewed","scoID":["2-s2.0-85137852402"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-4155e42f-fc8f-4026-8968-77e54cdba82a"],"src":["KU University of Copenhagen"],"title":"A randomised, double-blind, crossover study of the effect of the fluoroquinolone moxifloxacin on glucose levels and insulin sensitivity in young men and women","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-432493","year":"2023","yearsub":"2023"}
{"abstract":"Pulmonary embolism is a risk factor for chronic thromboembolic pulmonary hypertension (CTEPH), but the prognostic impact of CTEPH on venous thromboembolism (VTE) mortality remains unclear. We examined the impact of CTEPH and other pulmonary hypertension (PH) subtypes on long-term mortality after VTE. We conducted a nationwide, population-based cohort study of all adult Danish patients alive 2 years after incident VTE without previous PH from 1995 to 2020 (n = 129,040). We used inverse probability of treatment weights in a Cox model to calculate standardized mortality rate ratios (SMRs) of the association between receiving a first-time PH diagnosis ≤2 years after incident VTE and mortality (all-cause, cardiovascular, and cancer). We grouped PH as PH associated with left-sided cardiac disease (group II), PH associated with lung diseases and/or hypoxia (group III), CTEPH (group IV), and unclassified (remaining patients). Total follow-up was 858,954 years. The SMR associated with PH overall was 1.99 (95% confidence interval 1.75 to 2.27) for all-cause, 2.48 (1.90 to 3.23) for cardiovascular, and 0.84 (0.60 to 1.17) for cancer mortality. The SMR for all-cause mortality was 2.62 (1.77 to 3.88) for group II, 3.98 (2.85 to 5.56) for group III, 1.88 (1.11 to 3.20) for group IV, and 1.73 (1.47 to 2.04) for unclassified PH. The cardiovascular mortality rate was increased approximately threefold for groups II and III but was not increased for group IV. Only group III was associated with increased cancer mortality. In conclusion, PH diagnosed ≤2 years after incident VTE was associated with an overall twofold increased long-term mortality driven by cardiovascular causes.","author_count":8,"contributors":["Bonnesen, Kasper","Klok, Frederikus A","Andersen, Mads Jønsson","Andersen, Asger","Nielsen-Kudsk, Jens Erik","Mellemkjær, Søren","Sørensen, Henrik Toft","Schmidt, Morten"],"cuid":["S01-000.00-675782"],"filters":{"added":"2023-07","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"corresponding_author":["Bonnesen, Kasper"],"country":["Netherlands"],"glorg":["All Global Affiliations","Leiden University"],"keyword":["Adult","Cohort Studies","Humans","Neoplasms complications","Prognosis","Risk Factors","Venous Thromboembolism epidemiology"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"long term prognostic impact of pulmonary hypertension after venous thromboembolism","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.amjcard.2023.04.023","version":"Published Version"},"id":"S01-000.00-675782","identifier":[{"id":"85162140449","type":"scopus"},{"id":"37202325","type":"pmid"}],"ids":["au-d476b440-11ea-4a0f-bc22-cd7050f2cdbf"],"keyword":["Adult","Cohort Studies","Humans","Hypertension, Pulmonary/etiology","Neoplasms/complications","Prognosis","Pulmonary Embolism/complications","Risk Factors","Venous Thromboembolism/epidemiology"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-C7ED9EFBD8B73B787C4395CB88E5B5A7"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.amjcard.2023.04.023","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.au.dk/ws/files/384477196/1-s2.0-S0002914923002369-main.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Clinical Epidemiology"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"nl","key":"leiden university","loc":["Netherlands","Europe, EU","OECD"],"name":"Leiden University","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Kasper","key":"bonnesenkasperpau","last":"Bonnesen","locid":"08f71580-e725-41b2-9592-48981f741350","name":"Bonnesen, Kasper","orcid":"0000-0002-8626-2372","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Frederikus A","key":"klokfrederikusapau","last":"Klok","name":"Klok, Frederikus A","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mads J","key":"andersenmadsjønssonpau","last":"Andersen","locid":"19d72cda-3d6c-4f48-9d4b-6fe5dee888ba","name":"Andersen, Mads Jønsson","name_org":"Andersen, Mads J","orcid":"0000-0002-9320-8227","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Asger","key":"andersenasgerpau","last":"Andersen","locid":"a87aec57-562e-4950-b4cf-6741aae86cf1","name":"Andersen, Asger","orcid":"0000-0002-9102-3130","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens E","key":"nielsenkudskjenserikpau","last":"Nielsen-Kudsk","locid":"8629b763-e23e-41d9-ac4f-61579d19565e","name":"Nielsen-Kudsk, Jens Erik","name_org":"Nielsen-Kudsk, Jens E","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren","key":"mellemkjærsørenpau","last":"Mellemkjær","locid":"ce0064d1-3a0f-481d-8375-fd1d65bdd7dc","name":"Mellemkjær, Søren","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik Toft","key":"sørensenhenriktoftpau","last":"Sørensen","locid":"4d49d93a-4913-4223-ba59-272e717a845d","name":"Sørensen, Henrik Toft","orcid":"0000-0003-4299-7040","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Morten","key":"schmidtmortenpau","last":"Schmidt","locid":"21e3a3e6-e25e-48cf-b243-b8f43dca3bb8","name":"Schmidt, Morten","orc