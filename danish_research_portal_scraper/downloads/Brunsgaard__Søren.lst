1-401f-9c39-ebcc28014310","name":"Ziegler, Dorthe Schøler","orcid":"0000-0002-1458-3636","rank":34,"role":"Other","rolecode":"oth"},{"affno":"8","corresponding":null,"first":"Rikke Krüger","key":"jensenrikkekrügeroth","last":"Jensen","locid":"eecce337-d01b-43fa-aa22-b5860839c9d8","name":"Jensen, Rikke Krüger","orcid":"0000-0001-7528-3234","rank":35,"role":"Other","rolecode":"oth"},{"affno":"8","corresponding":null,"first":"Kristina Boe","key":"dissingkristinaboeoth","last":"Dissing","locid":"53b8d7b7-481f-45b9-8810-fe48573511ea","name":"Dissing, Kristina Boe","orcid":"0000-0003-0589-0121","rank":36,"role":"Other","rolecode":"oth"}],"pmid":["32366319"],"pub":{"doi":"10.1186/s12998-020-00312-x","issn":["2045709X"],"issn_org":["17461340"],"issue":"1","journal":"Chiropractic & Manual Therapies","paperid":"21","publisher":"BioMed Central","status":"p","title":"Chiropractic & Manual Therapies","volume":"28"},"review":"Peer Reviewed","scoID":["2-s2.0-85084276540"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Hospitals","Other Research","Universities","University of Southern Denmark","nordic institute of chiropractic and clinical biomechanics"],"PST":["Published"]},"sid":["au-454815d3-fb67-47af-8ec8-9231f81d0bd2","sdu-a553efce-959f-4fc8-b68a-a89fe82fdcb0"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"A united statement of the global chiropractic research community against the pseudoscientific claim that chiropractic care boosts immunity","type":"Journal Comment","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-086.46-017690","year":"2020","yearsub":"2020"}
{"abstract":"The present study was undertaken to determine the prevalence of endplate junction failure in a smaller cohort of Danish patients with lumbar disk herniation and compare this to the previously published data from India. Consecutive patients seen in a large regional hospital spine-care unit, with a clinical presentation suggesting a lumbar disk herniation with concomitant radiculopathy and confirmatory recent MRI were included. Additional imaging by CT was performed as part of the study and these were analyzed with specific attention to endplate junction failures. For ethical reasons, the number of participants was kept to a minimum and a total of 26 patients were included. The prevalence (n = 5) of endplate junction failure was found to be statistically significantly lower than that previously reported. Our findings do not echo those previously reported in an Indian population: Endplate junction failure was indeed observed, but at a significantly lower rate. We discuss potential reasons for the difference in findings with due attention to the weaknesses of the current study.","author_count":5,"contributors":["O'Neill, Søren","Fidelman, Jonas Morten","Haarup, Linne Steinar","Lund, Christian","Konner, Mikkel Brunsgaard"],"cuid":["S01-000.00-608704"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["O'Neill, Søren"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Spinecenter Djursland"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"low prevalence of end plate junction failure in danish patients with lumbar disc herniation","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41598-020-74690-w","version":"Published Version"},"id":"S01-000.00-608704","identifier":[{"id":"33077840","type":"pmid"},{"id":"PMC7573575","type":"pmcid"},{"id":"85092773650","type":"scopus"}],"ids":["sdu-7c01440b-2290-4d9b-a88b-656756b30abc"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-8DCC5E7C4EF17DDE34CB1F393807E8FC"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41598-020-74690-w","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/174221841/Open_Access_Version.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Sygehus Lillebælt, Forskningsenhed for Rygmedicin (Kolding)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Spinecenter Djursland"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Søren Francis Dyhrberg","key":"oneillpau","last":"O’Neill","locid":"1c5c1a7a-8e16-41c8-887f-d489cc82a998","name":"O'Neill, Søren","name_org":"O’Neill, Søren Francis Dyhrberg","orcid":"0000-0002-8064-7001","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jonas Morten","key":"fidelmanpau","last":"Fidelman","locid":"b843bdbd-e6a9-4634-bcd5-5f2b2deeb09f","name":"Fidelman, Jonas Morten","rank":2,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Linne Steinar","key":"haaruppau","last":"Haarup","locid":"2b0e7f74-885d-46b1-b959-7520a6452534","name":"Haarup, Linne Steinar","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christian","key":"lundpau","last":"Lund","locid":"53c039f3-38af-4ab0-b173-2e465bcc3fb5","name":"Lund, Christian","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mikkel Brunsgaard","key":"konnerpau","last":"Konner","locid":"97456b3b-e074-4ba6-bda5-fcbdb502ae42","name":"Konner, Mikkel Brunsgaard","rank":5,"rolecode":"pau"}],"pmid":["33077840"],"pub":{"doi":"10.1038/s41598-020-74690-w","issn":["20452322"],"journal":"Scientific Reports","paperid":"17652","publisher":"Nature Publishing Group","status":"p","title":"Scientific Reports","volume":"10"},"review":"Peer Reviewed","scoID":["2-s2.0-85092773650"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-7c01440b-2290-4d9b-a88b-656756b30abc"],"src":["SDU University of Southern Denmark"],"title":"Low prevalence of end plate junction failure in danish patients with lumbar disc herniation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-608704","year":"2020","yearsub":"2020"}
{"abstract":"The feeding of medicinal zinc oxide (ZnO) to weaner piglets will be phased out after 2022 in Europe, leaving pig producers without options to manage post-weaning disorders. This study assessed whether rapeseed meal, fermented alone (FRM) or co-fermented with a single (Ascophylum nodosum; FRMA), or two (A. nodossum and Saccharina latissima; FRMAS) brown macroalagae species, could improve weaner piglet performance and stimulate intestinal development as well as maturation of gut microbiota in the absence of in-feed zinc. Weaned piglets (n = 1240) were fed, during 28–85 days of age, a basal diet with no additives (negative control; NC), 2500 ppm in-feed ZnO (positive control; PC), FRM, FRMA or FRMAS. Piglets fed FRM and FRMA had a similar or numerically improved, respectively, production performance compared to PC piglets. Jejunal villus development was stimulated over NC in PC, FRM and FRMAS (gender-specific). FRM enhanced colon mucosal development and reduced signs of intestinal inflammation. All fermented feeds and PC induced similar changes in the composition and diversity of colon microbiota compared to NC. In conclusion, piglet performance, intestinal development and health indicators were sustained or numerically improved when in-feed zinc was replaced by FRM. Keywords: jejunal villus development; gut barrier function; colon microbiota; Ascophyllum nodossum; Saccharina latissima","author_count":10,"contributors":["Satessa, Gizaw Dabessa","Tamez-Hidalgo, Paulina","Hui, Yan","Cieplak, Tomasz Maciej","Krych, Lukasz","Kjærulff, Søren","Brunsgaard, Grete","S. Nielsen, Dennis","Nielsen, Mette Olaf"],"cuid":["S02-095.75-023744"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Ascophyllum nodossum","Brown seaweed","Colon microbiota","Growth performance","Immune functions","Intestinal morphology","Laminarin","Meal","Microbiota","Nutrient digestibility","Pigs","Saccharina latissima","gut barrier function"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-PR","DI-U"],"level3":{"OT":["Unspecified organisation"],"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-PR-OTH","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"impact of dietary supplementation of i lactic acid bacteria i fermented rapeseed with or without macroalgae on performance and health of piglets following omission of medicinal zinc from weaner diets","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/ani10010137","version":"Published Version"},"id":"S02-095.75-023744","identifier":[{"id":"31952154","type":"pmid"},{"id":"85079006407","type":"scopus"},{"id":"PMC7023219","type":"pmcid"},{"id":"000515364400137","type":"wos"}],"ids":["au-980dc9e2-d342-47df-aade-d9f5294b2a25","ku-1b794486-1e84-4209-bce7-d114b29e192c"],"keyword":["Ascophyllum nodossum","BROWN SEAWEED","GROWTH-PERFORMANCE","IMMUNE FUNCTIONS","INTESTINAL MORPHOLOGY","LAMINARIN","MEAL","MICROBIOTA","NUTRIENT DIGESTIBILITY","PIGS","SEAWEED ASCOPHYLLUM-NODOSUM","Saccharin latissima","Saccharina latissima","colon microbiota","gut barrier function","jejunal villus development"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-3A7BD44CD0E2B91560AB5B594239158B"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/235403304/Impact_of_Dietary_Supplementation_of_Lactic_Acid_Bacteria_Fermented_Rapeseed_with_or_without_Macroalgae_on_Performance_and_Health_of_Piglets_Following_Omission_of_Medicinal_Zinc_from_Weaner_Diets.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/ani10010137","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medici