ocid":"35229b19-b2da-4765-a846-e8e726738e9d","name":"Nim, Casper","orcid":"0000-0001-5845-2622","rank":11,"rolecode":"pau"}],"pmid":["39754067"],"pub":{"doi":"10.1186/s12874-024-02449-2","issn":["14712288"],"issue":"1","journal":"BMC Medical Research Methodology","paperid":"2","publisher":"BioMed Central Ltd.","status":"p","title":"BMC Medical Research Methodology","volume":"25"},"review":"Peer Reviewed","scoID":["2-s2.0-85213959206"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","All University Colleges","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","Hospitals","Miscellaneous","North Denmark Region","Other Research","Region of Southern Denmark","Universities","University College of Northern Denmark","University Colleges","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-63379a19-f804-497f-98ab-01cbdef99e64","sdu-2572b013-1e9f-42a9-8176-e995a148032d","ucn-c7892f93-e2f0-41a0-9f74-d3e9d0479e0a"],"src":["AAU Aalborg University","SDU University of Southern Denmark","UCN University College of Northern Denmark"],"title":"Development of a standardized patient-reported clinical questionnaire for children with spinal pain","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-100.00-792889","year":"2025","yearsub":"2025"}
{"abstract":"OBJECTIVE: We describe the experiences and lessons learned from establishing a 5-year postgraduate hospital-based residency program for chiropractors in Denmark. The program was established with the aim of qualifying those chiropractors to undertake common and several specialized functions in relation to musculoskeletal disorders, at the highest professional level, within the particular conditions of a hospital setting. METHODS: We provide an overall description of this unique program, examples of specific educational goals, and the process used to develop the program. RESULTS: Three pilot programs were conducted between 2009 and 2016. The internship program and educational goals were revised extensively during this period. Between revisions and semistructured interviews with key medical officers following the pilot program, the program was well received and considered appropriate for further qualifying chiropractors for specialized, hospital-based practice. CONCLUSION: The structure and content of the program will likely require further improvements in years to come, but currently forms the basis of the first regular 5-year, postgraduate in-hospital residency program for chiropractors in Denmark and perhaps elsewhere.","author_count":4,"contributors":["O'Neill, Søren","Konner, Mikkel Brunsgaard","Fejer, Rene","Vesterager, Susanne V"],"cuid":["S01-000.00-574133"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["O'Neill, Søren"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Klinik aktiv sundhed, Korsør"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"establishing a residency program for a chiropractic specialty in a public hospital system experiences from denmark","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"doi","url":"https://doi.org/10.7899/JCE-18-6","version":"Published Version"},"id":"S01-000.00-574133","identifier":[{"id":"PMC7682646","type":"pmcid"},{"id":"85096699541","type":"scopus"},{"id":"31039054","type":"pmid"}],"ids":["sdu-033a2a54-18ae-4436-b557-1a5c274fc964"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-536668AB1DA7F8A29137B3ADE195DF5A"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"doi","url":"https://doi.org/10.7899/JCE-18-6","version":"Published Version"},{"access":"oa","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC7682646/pdf/i1042-5055-34-2-164.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Lillebælt Hospital","SDU, The Faculty of Health Sciences, Department of Regional Health Research, Spine Center of Southern Denmark"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Klinik aktiv sundhed, Korsør"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Søren F D","key":"oneillpau","last":"O'Neill","locid":"1c5c1a7a-8e16-41c8-887f-d489cc82a998","name":"O'Neill, Søren","name_org":"O'Neill, Søren F D","orcid":"0000-0002-8064-7001","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mikkel B","key":"konnerpau","last":"Konner","locid":"97456b3b-e074-4ba6-bda5-fcbdb502ae42","name":"Konner, Mikkel Brunsgaard","name_org":"Konner, Mikkel B","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Rene","key":"fejerpau","last":"Fejer","name":"Fejer, Rene","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Susanne V","key":"vesteragerpau","last":"Vesterager","locid":"91092274-0c1e-448c-9295-60d7b287080f","name":"Vesterager, Susanne V","rank":4,"rolecode":"pau"}],"pmid":["31039054"],"pub":{"doi":"10.7899/jce-18-6","issn":["10425055"],"issue":"2","journal":"The Journal of Chiropractic Education","pages":"164-171","publisher":"Allen Press Inc.","status":"p","title":"The Journal of Chiropractic Education","volume":"34"},"review":"Peer Reviewed","scoID":["2-s2.0-85096699541"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-033a2a54-18ae-4436-b557-1a5c274fc964"],"src":["SDU University of Southern Denmark"],"title":"Establishing a residency program for a chiropractic specialty in a public hospital system : Experiences from Denmark","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-574133","year":"2020","yearsub":"2020"}
{"abstract":"Background: In the midst of the coronavirus pandemic, the International Chiropractors Association (ICA) posted reports claiming that chiropractic care can impact the immune system. These claims clash with recommendations from the World Health Organization and World Federation of Chiropractic. We discuss the scientific validity of the claims made in these ICA reports. Main body: We reviewed the two reports posted by the ICA on their website on March 20 and March 28, 2020. We explored the method used to develop the claim that chiropractic adjustments impact the immune system and discuss the scientific merit of that claim. We provide a response to the ICA reports and explain why this claim lacks scientific credibility and is dangerous to the public. More than 150 researchers from 11 countries reviewed and endorsed our response. Conclusion: In their reports, the ICA provided no valid clinical scientific evidence that chiropractic care can impact the immune system. We call on regulatory authorities and professional leaders to take robust political and regulatory action against those claiming that chiropractic adjustments have a clinical impact on the immune system.","author_count":36,"contributors":["Côté, Pierre","Bussières, André","Cassidy, J. David","Hartvigsen, Jan","Kawchuk, Greg N.","Leboeuf-Yde, Charlotte","Mior, Silvano","Schneider, Michael","Arnbak, Bodil","Brinch Filtenborg, Johanne","Konner, Mikkel Brunsgaard","Christensen, Henrik Wulff","Clausen, Stine","Doktor, Klaus","Field, Jonathan","Harsted, Steen","Evans, Roni","Hartvigsen, Lisbeth","Hesby, Bue Bonderup","Hestbæk, Lise","Jensen, Tue Secher","Johansson, Melker S","Kongsted, Alice","Lauridsen, Henrik Hein","Nielsen, Anne Mølgaard","Myburgh, Corrie","Nim, Casper","O'Neill, Søren","Øverås, Cecilie K.","Poulsen, Erik","Stochkendahl, Mette Jensen","Uhrenholt, Lars","Young, James J.","Ziegler, Dorthe Schøler","Jensen, Rikke Krüger","Dissing, Kristina Boe"],"cuid":["S02-086.46-017690"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","Europe, Non-EU","OECD"],"corpau":["140 Signatories","and more than 140 signatories"],"corresponding_author":["Côté, Pierre"],"country":["Canada","United Kingdom","United States"],"glorg":["All Global Affiliations","Canadian Memorial Chiropractic College","McGill University","Ontario Tech University","Samuel Lunenfeld Research Institute, Mount Sinai Hospital, Toronto","University of Alberta","University of Ontario Institute of Technology","University of Pittsburgh","University of Quebec","University of Southampton","University of Toronto","Université du Québec à Trois-Rivières"],"keyword":["Chiropractic","Coronavirus","Immunity","Pseudoscience","Spinal manipulation"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-OTH"],"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-OTH","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"a united statement of the global chiropractic research community against the pseudoscientific claim that chiropractic care boosts immunity","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"djc","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12998-020-00312-x","version":"Published Version"},"id":"S02-086.46-017690","identifier":[{"id":"32366319","type":"pmid"},{"id":"85084276540","type":"scopus"},{"id":"PMC7197358","type":"pmcid"}],"ids":["au-454815d3-fb67-47af-8ec8-9231f81d0bd2","sdu-a553efce-959f-4fc8-b68a-a89fe82fdcb0"],"keyword":["Chiropractic","Coronavirus","Immunity","Pseudoscience","Spinal manipulation"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-1BD30D3657C803956DA2499