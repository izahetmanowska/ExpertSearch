nk":10,"rolecode":"pau"},{"affno":"1","first":"Rosanna Catherine","key":"hennessypau","last":"Hennessy","locid":"04bc8ab2-b475-47c6-9a47-c7d1394344b3","name":"Hennessy, Rosanna Catherine","orcid":"0000-0002-2359-8565","rank":11,"rolecode":"pau"},{"affno":"1","first":"Mette Haubjerg","key":"nicolaisenpau","last":"Nicolaisen","locid":"58de527a-4c42-47cb-9ea0-c65675eca755","name":"Nicolaisen, Mette Haubjerg","orcid":"0000-0002-0983-2466","rank":12,"rolecode":"pau"},{"affno":"1","first":"Lars Hestbjerg","key":"hansenpau","last":"Hansen","locid":"2e041f09-bf9d-434a-b82a-d6e2763bb262","name":"Hansen, Lars H.","name_org":"Hansen, Lars Hestbjerg","orcid":"0000-0003-0027-1524","rank":13,"rolecode":"pau"},{"affno":"1","first":"Witold","key":"kotpau","last":"Kot","locid":"89d6e892-d0a3-40c3-a7f5-7052029eeb1b","name":"Kot, Witold","orcid":"0000-0002-0188-4587","rank":14,"rolecode":"pau"}],"pmid":["36786922"],"pub":{"doi":"10.1007/s00705-023-05706-9","issn":["03048608","14328798"],"issn_org":["03048608"],"issue":"3","journal":"Archives of Virology","status":"p","title":"Archives of Virology","volume":"168"},"review":"Peer Reviewed","scoID":["2-s2.0-85148076204"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-0eb952e4-b955-4e7a-aef6-cf6d34657c6d"],"src":["KU University of Copenhagen"],"title":"Four novel <i>Curtobacterium</i> phages isolated from environmental samples","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-402177","year":"2023","yearsub":"2023"}
{"abstract":"Despite the ecological significance of viral communities, phages remain insufficiently studied. Current genomic databases lack high-quality phage genome sequences linked to specific bacteria. Bacteria of the genus Erwinia are known to colonize the phyllosphere of plants, both as commensals and as pathogens. We isolated three Erwinia billingiae phages-Zoomie, Pecta, and Snitter-from organic household waste. Based on sequence similarity to their closest relatives, we propose that they represent three new genera: \"Pectavirus\" within the family Zobellviridae, \"Snittervirus\" in the subfamily Tempevirinae, family Drexlerviridae, and \"Zoomievirus\" within the family Autographiviridae, which, together with the genus Limelightvirus, may constitute a new subfamily.","author_count":12,"contributors":["Alanin, Katrine Wacenius Skov","Olsen, Nikoline S.","Djurhuus, Amaru Miranda","Carstens, Alexander Byth","Nielsen, Tue Kjærgaard","Wagner, Natalia","Lametsch, Rene","Bak, Frederik","Hennessy, Rosanna Catherine","Nicolaisen, Mette Haubjerg","Kot, Witold","Hansen, Lars H."],"cuid":["S01-000.00-542696"],"filters":{"added":"2023-03","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","Max Rubner Institut"],"keyword":["Bacteriophages genetics","Genome Viral"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"three novel i erwinia billingiae i phages isolated from organic waste represent three new genera","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://curis.ku.dk/ws/files/408639011/Three_novel_Erwinia_billingiae.pdf","version":"Pre-print"},"id":"S01-000.00-542696","id