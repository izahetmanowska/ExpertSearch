["AU Aarhus University","SDU University of Southern Denmark"],"title":"Phase II trial of erlotinib and bevacizumab in patients with advanced upper gastrointestinal cancers","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-080.42-672164","year":"2012","yearsub":"2012"}
{"abstract":"Safety-critical Java (SCJ) avoids garbage collection and uses a scope based memory model. This memory model is based on a restricted version of RTSJ [2] style scopes. The scopes form a clear hierarchy with different lifetimes. Therefore, references between objects in different scopes are only al- lowed from objects allocated in scopes with a shorter lifetime to objects allocated in scopes with a longer lifetime. To ensure memory safety, programmers are required to either manually annotate the application with complex annotations, rely on a runtime test of each reference assignment, or statically analyze all reference assignments and avoid run- time checks when all assignments are proven to be correct. A violation of the assignment rule at runtime leads to an unchecked exception. For safety-critical code that needs to be certified, runtime exceptions must be avoided and the absence of illegal reference assignments needs to be proven. In this paper we present a static program analysis tool that automates the proof that no illegal assignments occur.","author_count":3,"contributors":["Dalsgaard, Andreas Engelbredt","Hansen, Rene Rydhof","Schoeberl, Martin"],"cuid":["S02-091.35-008657"],"event":{"acronym":"JTRES","end":"2012-10-26","place":"Copenhagen, dk","start":"2012-10-24","title":"10th International Workshop on Java Technologies for Real-time and Embedded Systems (JTRES 2012)","year":"2012"},"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-AAU","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"private memory allocation analysis for safety critical java","src":["aau","dtu"],"src-code":["DI-U-AAU","DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1145/2388936.2388939","version":"Other Version"},"id":"S02-091.35-008657","identifier":[{"id":"84870274850","type":"scopus"},{"id":"WOS:000312606900002","type":"wos"}],"ids":["aau-b3b381cb-778e-4f48-bbb7-15ec37c73cff","dtu-45462bb7-38ec-43a8-a1cf-b9625a893ea9"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-5D146120EA93DA9A5C329F908036444D"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1145/2388936.2388939","version":"Other Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (TECH)","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science, Distributed Systems and Semantics"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Informatics and Mathematical Modeling","Technical University of Denmark, Department of Informatics and Mathematical Modeling, Embedded Systems Engineering"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Andreas Engelbredt","key":"dalsgaardpau","last":"Dalsgaard","locid":"ac5f11f8-d287-4682-9629-f10456f4fd92","name":"Dalsgaard, Andreas Engelbredt","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rene Rydhof","key":"hansenpau","last":"Hansen","locid":"d92ec90d-a8b7-4c01-acbe-ebab21f3f0c3","name":"Hansen, Rene Rydhof","orcid":"0000-0002-5688-6432","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Martin","key":"schoeberlpau","last":"Schoeberl","locid":"63dcfd1c-cc7f-4e1b-8fdc-1d421f8fdb36","name":"Schoeberl, Martin","orcid":"0000-0003-2366-382X","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1145/2388936.2388939","isbn":["9781450316880"],"issn":["2154056X"],"pages":"9-17","publisher":"Association for Computing Machinery (ACM)","series":"Proceedings of the International Workshop of Java Technologies for Real-Time and Embedded Systems","status":"p","title":"JTRES '12 Proceedings of the 10th International Workshop on Java Technologies for Real-time and Embedded Systems"},"review":"Peer Reviewed","scoID":["2-s2.0-84870274850"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["aau-b3b381cb-778e-4f48-bbb7-15ec37c73cff","dtu-45462bb7-38ec-43a8-a1cf-b9625a893ea9"],"src":["AAU Aalborg University","DTU Technical University of Denmark"],"title":"Private Memory Allocation Analysis for Safety-Critical Java","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-091.35-008657","year":"2012","yearsub":"2012"}
{"abstract":"Bariatric surgery is currently considered the most effective treatment of severe obesity, but considerable individual variations in weight loss results have been reported. We therefore conducted a systematic review and meta-analysis of studies investigating the effect of psychotherapeutic interventions and support groups on weight loss following bariatric surgery. A literature search was conducted in the databases PubMed and PsycINFO, identifying nine eligible studies reporting results of the effect of psychotherapeutic interventions and support groups on weight loss following bariatric surgery. The results revealed a statistically significant overall effect of both psychotherapeutic interventions and support groups on weight loss (pooled effect size correlation (ESr) = 0.18; p ","author_count":5,"contributors":["Beck, Nina N.","Johannsen, Maja","Støvring, René K.","Mehlsen, Mimi Yung","Zachariae, Robert"],"cuid":["S02-091.70-028000"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med","soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"do postoperative psychotherapeutic interventions and support groups influence weight loss following bariatric surgery a systematic review and meta analysis of randomized and nonrandomized trials","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s11695-012-0739-4","version":"Other Version"},"id":"S02-091.70-028000","identifier":[{"id":"84868210751","type":"scopus"},{"id":"22930073","type":"pmid"}],"ids":["au-d3aa3081-d858-4c08-b414-21e4532d2ab5","sdu-c90fbd9d-4cf8-4aea-a145-07bda943c5bb"],"lang":"English","level":"Scientific","mra":["Medical Science","Social Science"],"noi":["Global-Local-2-5-81F1838D9D80C4BDA28073B52DCD695D"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s11695-012-0739-4","version":"Other Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Psychology","SDU, The Faculty of Health Sciences, Department of Psychology, The National Center of Psychotraumatology"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus BSS, Department of Psychology and Behavioural Sciences"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Nina","key":"beckhansenpau","last":"Beck Hansen","locid":"9e8ddeb7-5e9f-4dd2-bff8-ea0b98c03257","name":"Beck Hansen, Nina","orcid":"0000-0002-2962-3311","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Maja","key":"johannsenpau","last":"Johannsen","locid":"49fab8f3-5922-4b89-aac3-353b64befcf4","name":"Johannsen, Maja","orcid":"0000-0002-7849-7534","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"René K","key":"støvingpau","last":"Støving","locid":"4aab81f6-352f-4c74-82a2-23589beb9fd5","name":"Støving, René Klinkby","name_org":"Støving, René K","orcid":"0000-0002-4255-5544","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Mimi Yung","key":"mehlsenpau","last":"Mehlsen","locid":"4d75aa04-7410-4597-9d07-685c5ab6cd30","name":"Mehlsen, Mimi Yung","orcid":"0000-0001-5820-8937","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Robert","key":"zachariaepau","last":"Zachariae","locid":"63001d62-2865-45ba-a837-b5199293907c","name":"Zachariae, Robert","orcid":"0000-0001-9076-3068","rank":5,"rolecode":"pau"}],"pmid":["22930073"],"pub":{"doi":"10.1007/s11695-012-0739-4","issn":["09608923","17080428"],"issn_org":["09608923"],"issue":"11","journal":"Obesity Surgery","pages":"1790-1797","publisher":"Springer","status":"p","title":"Obesity Surgery","volume":"22"},"review":"Peer Reviewed","scoID":["2-s2.0-84868210751"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-d3aa3081-d858-4c08-b414-21e4532d2ab5","sdu-c90fbd9d-4cf8-4aea-a145-07bda943c5bb"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Do Postoperative Psychotherapeutic Interventions and Support Groups Influence Weight Loss Following Bariatric Surgery? A Systematic Review and Meta-analysis of Randomized and Nonrandomized Trials","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-091.70-028000","year":"2012","yearsub":"2012"}
{"abstract":"In this paper we describe the THAPS vulnerability scanner for PHP web applications. THAPS is based on symbolic execution of PHP with specialised support for scanning extensions and plug-ins of larger application frameworks. We further show how THAPS can integrate the results of dynamic analyses, generated by a customised web crawler, into the static analysis. This enables analysis of often used advanced dynamic features such as dynamic code load and reflection. To the best of our knowledge, THAPS is the first tool to apply this approach and the first tool with specific support for analysis of plug-ins. In order to verify our approach, we have scanned 375 WordPress plug-ins and a commercial (monolithic) web application, resulting in 68 and 28 confirmed vulnerabilities respectively.","author_count":4,"contributors":["Jensen, Torben","Pedersen, Heine","Olesen, Mads Chr.","Hansen, Rene Rydhof"],"cuid":["S01-000.00-068784"],"event":{"acronym":"NordSec","end":"2012-11-02","place":"Karslkrona, se","start":"2012-10-31","title":"17th Nordic Conference, NordSec 2012","year":"2012"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"thaps automated vulnerability scanning of php applications","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-3-642-34210-3_3","version":"Other Version"},"id":"S01-000.00-068784","identifier":[{"id":"84868368035","type":"scopus"}],"ids":["aau-40bfa06e-b70d-46e6-8284-f949f775251e"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-96686E343ACD5DBC0F1EE17BEA11848C"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-3-642-34210-3_3","version":"Other Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (TECH)","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Torben","key":"jensenpau","last":"Jensen","locid":"211a387f-3843-47b3-9a79-62eaf941fde7","name":"Jensen, Torben","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Heine","key":"pedersenpau","last":"Pedersen","locid":"4e5f03f7-0456-4cc9-90c1-1959dcb7ef1b","name":"Pedersen, Heine","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mads Chr.","key":"olesenpau","last":"Olesen","locid":"c2e63d48-efc8-4e23-9dbf-509a20de7dc3","name":"Olesen, Mads Chr.","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rene Rydhof","key":"hansenpau","last":"Hansen","locid":"d92ec90d-a8b7-4c01-acbe-ebab21f3f0c3","name":"Hansen, Rene Rydhof","orcid":"0000-0002-5688-6432","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-642-34210-3_3","eisbn":["9783642342103"],"isbn":["9783642342097"],"issn":["03029743"],"pages":"31-46","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","title":"Proceedings of the 17th Nordic Conference on Secure IT-Systems (NordSec 2012)","volume":"7617"},"review":"Peer Reviewed","scoID":["2-s2.0-84868368035"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-40bfa06e-b70d-46e6-8284-f949f775251e"],"src":["AAU Aalborg University"],"title":"THAPS : Automated Vulnerability Scanning of PHP Applications","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-068784","year":"2012","yearsub":"2012"}
{"abstract":"Timing anomalies make worst-case execution time analysis much harder, because the analysis will have to consider all local choices. It has been widely recognised that certain hardware features are timing anomalous, while others are not. However, defining formally what a timing anomaly is, has been difficult. We examine previous definitions of timing anomalies, and identify examples where they do not align with common observations. We then provide a definition for consistently slower hardware traces that can be used to define timing anomalies and aligns with common observations.","author_count":4,"contributors":["Cassez, Franck","Hansen, Rene Rydhof","Olesen, Mads Chr."],"cuid":["S01-000.00-117198"],"event":{"acronym":"WCET","end":"2012-07-10","place":"Pisa, it","start":"2012-07-10","title":"International Workshop on Worst-Case Execution Time Analysis","year":"2012"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["OECD","Oceania"],"country":["Australia"],"glorg":["All Global Affiliations","National ICT Australia"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"what is a timing anomaly","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/72450128/p001_cassez.pdf","version":"Published Version"},"id":"S01-000.00-117198","identifier":[{"id":"84880086637","type":"scopus"}],"ids":["aau-e7127ce5-1cfe-46d1-b6fe-c3ff890fc419"],"lang":"Danish","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-BFB06603BEA9BB2A1296761FC0EC74FD"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.4230/OASIcs.WCET.2012.1","version":"Other Version"},{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/72450128/p001_cassez.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"au","key":"national ict australia","loc":["Australia","Oceania","OECD"],"name":"National ICT Australia","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (TECH)","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science, Distributed Systems and Semantics"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Franck","key":"cassezpau","last":"Cassez","name":"Cassez, Franck","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Rene Rydhof","key":"hansenpau","last":"Hansen","locid":"d92ec90d-a8b7-4c01-acbe-ebab21f3f0c3","name":"Hansen, Rene Rydhof","orcid":"0000-0002-5688-6432","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Mads Chr.","key":"olesenpau","last":"Olesen","locid":"c2e63d48-efc8-4e23-9dbf-509a20de7dc3","name":"Olesen, Mads Chr.","rank":3,"rolecode":"pau"},{"affno":"","first":"Tullio","key":"vardanegapedh","last":"Vardanega","name":"Vardanega, Tullio","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.4230/oasics.wcet.2012.1","eisbn":["9783939897415"],"issn":["21906807"],"pages":"1-12","place":"Dagstuhl, Germany","publisher":"Schloss Dagstuhl - Leibniz-Zentrum für Informatik","publisher_org":"Schloss Dagstuhl. Leibniz-Zentrum für Informatik","series":"OpenAccess Series in Informatics","status":"p","title":"Proceedings of the 12th International Workshop on Worst-Case Execution-Time Analysis","volume":"23"},"review":"Peer Reviewed","scoID":["2-s2.0-84880086637"],"se