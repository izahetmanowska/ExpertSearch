5108-5847","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Elly Møller","key":"hansenpau","last":"Hansen","locid":"5c906936-1ec6-4847-8322-c5643841a25a","name":"Hansen, Elly Møller","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders Krogh","key":"mortensenpau","last":"Mortensen","locid":"22840a8d-e830-4b65-91b1-665adaa6bddc","name":"Mortensen, Anders Krogh","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rene","key":"larsenpau","last":"Larsen","locid":"ba891826-c0f2-41e5-a001-1841bc2cf2b5","name":"Larsen, Rene","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jørgen E","key":"olesenpau","last":"Olesen","locid":"d3bcf85c-a32d-4169-8f78-b2bf7fe78102","name":"Olesen, Jørgen E","orcid":"0000-0002-6639-1273","rank":6,"rolecode":"pau"}],"pub":{"pages":"21","publisher":"DCA - Nationalt Center for Fødevarer og Jordbrug","repno":"Rådgivningsrapport fra DCA - Nationalt Center for Fødevarer og Jordbrug","series":"Rådgivningsrapport fra DCA - Nationalt Center for Fødevarer og Jordbrug","status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-244b80d8-e139-4e20-9cfa-5dfc00c0e4e1"],"src":["AU Aarhus University"],"title":"Endelig rapport i pilotprojekt om biomasse","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-150163","year":"2022","yearsub":"2022"}
{"abstract":"Background: Despite improvement in treatment strategies of atrial fibrillation (AF), a considerable number of patients still experience recurrence of atrial tachyarrhythmia (ATA) following catheter ablation (CA). This study aimed to investigate the prognostic value of left atrial (LA) deformation analysis in a large group of patients undergoing CA for AF. Methods: This study included 678 patients with AF. Echocardiography including two-dimensional speckle tracking echocardiography (2DSTE) was performed in all patients prior to CA. Logistic regression analysis was used to assess the association between ATA recurrence and LA strain during reservoir phase (LASr), LA strain during contraction phase (LASct), and LA strain during conduit phase (LAScd). Results: During one-year follow-up, 274 (40%) experienced ATA recurrence. Median age of the included study population was 63.2 years (IQR: 55.5, 69.5) and 485 (72%) were male. Patients with recurrence had lower LASr (22.6% vs. 25.1%, p = 0.001) and LASct (10.7% vs. 12.4%, p < 0.001). No difference in LAScd was observed. After adjusting for potential clinical and echocardiographic confounders LASr (OR = 1.04, CI95% [1.01; 1.07], p = 0.015, per 1% decrease) and LASct (OR = 1.06, CI95% [1.02; 1.11], p = 0.007, per 1% decrease) remained independent predictors of recurrence. However, in patients with a normal-sized LA (LA volume index<34 mL/m2), only LASct remained an independent predictor of recurrence (OR = 1.07, CI95% [1.01; 1.12], p = 0.012, per 1% decrease). Conclusion: In patients undergoing CA for AF, LA deformation analysis by 2DSTE could be of use in risk stratification in clinical practice regarding ATA recurrence, even in patients with a normal-sized LA.","author_count":12,"contributors":["Nielsen, Anne Bjerg","Skaarup, Kristoffer Grundtvig","Djernæs, Kasper","Hauser, Raphael","San José Estépar, Raúl","Sørensen, Samuel Kiil","Ruwald, Martin Huth","Hansen, Morten Lock","Worck, René Husted","Johannessen, Arne","Hansen, Jim","Biering-Sørensen, Tor"],"cuid":["S01-000.00-485399"],"filters":{"added":"2022-08","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Harvard University"],"keyword":["Atrial fibrillation","Catheter ablation","Left atrial strain","Speckle tracking echocardiography"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"left atrial contractile strain predicts recurrence of atrial tachyarrhythmia after catheter ablation","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.ijcard.2022.04.056","version":"Published Version"},"id":"S01-000.00-485399","identifier":[{"id":"85129703175","type":"scopus"},{"id":"35469934","type":"pmid"}],"ids":["ku-99d49550-3d27-4616-a390-35c75e1b2e3a"],"keyword":["Atrial fibrillation","Catheter ablation","Left atrial strain","Speckle tracking echocardiography"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-D60BE43A40EF9A306E10198048E1D0CC"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.ijcard.2022.04.056","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/311123328/Left_atrial_contractile_strain_predicts_recurrence_of_atrial.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","country":"us","key":"harvard university","loc":["United States","America, North","OECD"],"name":"Harvard University","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal medicine: Cardiology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Anne Bjerg","key":"nielsenannebjergpau","last":"Nielsen","name":"Nielsen, Anne Bjerg","rank":1,"rolecode":"pau"},{"affno":"1","first":"Kristoffer Grundtvig","key":"skaarupkristoffergrundtvigpau","last":"Skaarup","name":"Skaarup, Kristoffer Grundtvig","rank":2,"rolecode":"pau"},{"affno":"1","first":"Kasper","key":"djernæskasperpau","last":"Djernæs","name":"Djernæs, Kasper","rank":3,"rolecode":"pau"},{"affno":"1","first":"Raphael","key":"hauserraphaelpau","last":"Hauser","name":"Hauser, Raphael","rank":4,"rolecode":"pau"},{"affno":"2","first":"Raúl","key":"sanjoséestéparraúlpau","last":"San José Estépar","name":"San José Estépar, Raúl","rank":5,"rolecode":"pau"},{"affno":"1","first":"Samuel Kiil","key":"sørensensamuelkiilpau","last":"Sørensen","name":"Sørensen, Samuel Kiil","rank":6,"rolecode":"pau"},{"affno":"1","first":"Martin Huth","key":"ruwaldmartinhuthpau","last":"Ruwald","name":"Ruwald, Martin Huth","rank":7,"rolecode":"pau"},{"affno":"3","first":"Morten Lock","key":"hansenmortenlockpau","last":"Hansen","locid":"870786a1-f42f-40fa-b820-1608236b578c","name":"Hansen, Morten Lock","rank":8,"rolecode":"pau"},{"affno":"1","first":"René Husted","key":"worckrenéhustedpau","last":"Worck","name":"Worck, René Husted","rank":9,"rolecode":"pau"},{"affno":"1","first":"Arne","key":"johannessenarnepau","last":"Johannessen","name":"Johannessen, Arne","rank":10,"rolecode":"pau"},{"affno":"1","first":"Jim","key":"hansenjimpau","last":"Hansen","name":"Hansen, Jim","rank":11,"rolecode":"pau"},{"affno":"1 3","first":"Tor","key":"bieringsørensentorpau","last":"Biering-Sørensen","locid":"2a25298f-30d3-4b37-b20b-646684a29fd8","name":"Biering-Sørensen, Tor","rank":12,"rolecode":"pau"}],"pmid":["35469934"],"pub":{"doi":"10.1016/j.ijcard.2022.04.056","issn":["01675273","18741754"],"issn_org":["01675273"],"journal":"International Journal of Cardiology","pages":"51-57","status":"p","title":"International Journal of Cardiology","volume":"358"},"review":"Peer Reviewed","scoID":["2-s2.0-85129703175"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-99d49550-3d27-4616-a390-35c75e1b2e3a"],"src":["KU University of Copenhagen"],"title":"Left atrial contractile strain predicts recurrence of atrial tachyarrhythmia after catheter ablation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-485399","year":"2022","yearsub":"2022"}
{"abstract":"Some serovars of Salmonella can cause life-threatening diarrhoeal diseases and bacteriemia. The emergence of multidrug-resistant strains has led to a need for alternative treatments such as phage therapy, which requires available, well-described, diverse, and suitable phages. Phage akira was found to lyse 19 out of 32 Salmonella enterica serovars and farm isolates tested, although plaque formation was observed with only two S. Enteritidis and one S. Typhimurium strain. Phage akira encodes anti-defence genes against type 1 R-M systems, is distinct (<65% nucleotide sequence identity) from related phages and has siphovirus morphology. We propose that akira represents a new genus in the class Caudoviricetes.","author_count":5,"contributors":["Olsen, Nikoline S.","Lametsch, Rene","Wagner, Natalia","Hansen, Lars H.","Kot, Witold"],"cuid":["S01-000.00-505926"],"filters":{"added":"2022-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","Max Rubner Institut"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"salmonella phage akira infecting selected i salmonella enterica i enteritidis and typhimurium strains represents a new lineage of bacteriophages","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-505926","identifier":[{"id":"85132984043","type":"scopus"},{"id":"000817879400002","type":"wos"},{"id":"35764845","type":"pmid"}],"ids":["ku-bc7609c3-a105-4355-a381-4fe4bdf2cecd"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-38682FFC400CBED85100DE77AF130C19"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Plant and Environmental Sciences, Microbial Ecology and Biotechnology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"de","key":"max rubner institut","loc":["Germany","Europe, EU","OECD"],"name":"Max Rubner Institut","used":1}],"person":[{"affno":"1","first":"Nikoline S.","key":"olsenpau","last":"Olsen","locid":"76391bd6-fd82-4a5a-a95b-7815175b6fb0","name":"Olsen, Nikoline S.","rank":1,"rolecode":"pau"},{"affno":"1","first":"René","key":"lametschpau","last":"Lametsch","locid":"70bd350a-6869-4a4a-b9bc-56a756376784","name":"Lametsch, Rene","name_org":"Lametsch, René","orcid":"0000-0002-4189-806X","rank":2,"rolecode":"pau"},{"affno":"2","first":"Natalia","key":"wagnerpau","last":"Wagner","name":"Wagner, Natalia","rank":3,"rolecode":"pau"},{"affno":"1","first":"Lars Hestbjerg","key":"hansenpau","last":"Hansen","locid":"2e041f09-bf9d-434a-b82a-d6e2763bb262","name":"Hansen, Lars H.","name_org":"Hansen, Lars Hestbjerg","orcid":"0000-0003-0027-1524","rank":4,"rolecode":"pau"},{"affno":"1","first":"Witold","key":"kotpau","last":"Kot","locid":"89d6e892-d0a3-40c3-a7f5-7052029eeb1b","name":"Kot, Witold","orcid":"0000-0002-0188-4587","rank":5,"rolecode":"pau"}],"pmid":["35764845"],"pub":{"doi":"10.1007/s00705-022-05477-9","issn":["03048608","14328798"],"issn_org":["03048608"],"journal":"Archives of Virology","pages":"2049-2056","status":"p","title":"Archives of Virology","volume":"167"},"review":"Peer Reviewed","scoID":["2-s2.0-85132984043"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-bc7609c3-a105-4355-a381-4fe4bdf2cecd"],"src":["KU University of Copenhagen"],"title":"Salmonella phage akira, infecting selected <i>Salmonella enterica</i> Enteritidis and Typhimurium strains, represents a new lineage of bacteriophages","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-505926","year":"2022","yearsub":"2022"}
{"abstract":"Exercise addiction describes a pattern of excessive and obsessive exercise and is associated with hypoleptinemia and low testosterone that may have adverse skeletal effects. We used a validated questionnaire to identify males with high and low risk of exercise addiction. In a cross-sectional design, males (aged 21-49 years) with high (n = 20, exercise addictive) and low risk (n = 20, exercise controls) of exercise addiction had examinations of bone mass, bone microarchitecture, and estimated bone strength performed using dual-energy x-ray absorptiometry of the hip and spine and high-resolution peripheral quantitative computed tomography of the distal radius and tibia. Findings were compared between the groups and to a population-based sample of healthy men aged 20-80 years (n = 236). We found similar hip and spine bone mineral density in exercise addictive and controls. Cortical and trabecular bone microarchitecture and estimated bone strength in radius and tibia did not differ significantly between the groups. Multiple regression analyses adjusting for age, body weight, free testosterone, and hours of weekly training did not alter findings. Also, bone indices from both groups were within 95% prediction bands derived from the population-based sample for the vast majority of indices. Neither group had no associations between circulating leptin or free testosterone and bone outcomes. In conclusion, in a study on younger males, we found no associations between high risk of exercise addiction and various indices of bone mass and bone quality indicative of altered skeletal health.","author_count":4,"contributors":["Hansen, Stinus","Lichtenstein, Mia Beck","Johansen, Karen Krogh","Støving, René Klinkby"],"cuid":["S01-000.00-621032"],"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Hansen, Stinus"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"normal bone mineral density and bone microarchitecture in adult males with high and low risk of exercise addiction","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fspor.2022.1021442","version":"Published Version"},"id":"S01-000.00-621032","identifier":[{"id":"36451934","type":"pmid"},{"id":"85148359228","type":"scopus"},{"id":"PMC9701746","type":"pmcid"}],"ids":["sdu-a7082eff-e6c5-4adf-98b3-600fd1e8ddb1"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-C3536976E8DEBE8B08F999F599CFB657"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/215298392/fspor_04_1021442.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fspor.2022.1021442","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Regional Health Research","SDU, The Faculty of Health Sciences, Department of Regional Health Research, Hospital South West Jutland","SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Esbjerg and Grindsted Hospital, Research Unit of Endocrinology (Esbjerg)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Stinus Gadegaard","key":"hansenpau","last":"Hansen","locid":"55fbaeae-64f0-4d31-b356-1ca840e82ed8","name":"Hansen, Stinus","name_org":"Hansen, Stinus Gadegaard","orcid":"0000-0001-9486-0316","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mia Beck","key":"lichtensteinpau","last":"Lichtenstein","locid":"2b24df11-a1e7-4a80-8355-6f2f633eaca6","name":"Lichtenstein, Mia Beck","orcid":"0000-0002-7885-9187","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Karen Krogh","key":"johansenpau","last":"Johansen","locid":"aeb73b54-3d3a-49ed-875b-126744207d1e","name":"Johansen, Karen Krogh","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rene Klinkby","key":"støvingpau","last":"Støving","locid":"4aab81f6-352f-4c74-82a2-23589beb9fd5","name":"Støving, René Klinkby","name_org":"Støving, Rene Klinkby","orcid":"0000-0002-4255-5544","rank":4,"rolecode":"pau"}],"pmid":["36451934"],"pub":{"doi":"10.3389/fspor.2022.1021442","issn":["26249367"],"journal":"Frontiers in Sports and Active Living","paperid":"1021442","publisher":"Frontiers Media","status":"p","title":"Frontiers in Sports and Active Living","volume":"4"},"review":"Peer Reviewed","scoID":["2-s2.0-85148359228"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-a7082eff-e6c5-4adf-98b3-600fd1e8ddb1"],"src":["SDU University of Southern Denmark"],"title":"Normal bone mineral density and bone microarchitecture in adult males with high and low risk of exercise addiction","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-621032","year":"2022","yearsub":"2022"}
{"abstract":"Objective: Growth differentiation factor (GDF)-15 is implicated in regulation of metabolism and circulating GDF15 increases in response to exercise. The source and regulation of the exercise-induced increase in GDF15 is, however not known. Method: Plasma GDF15 was measured by ELISA under the following conditions: 1) Arterial-to-hepatic venous differences sampled before, during, and after exercise in healthy male subjects (n=10); 2) exogenous glucagon infusion compared to saline infusion in resting healthy subjects (n=10); 3) an acute exercise bout with and without a pancreatic clamp (n=6); 4) healthy subjects for 36 hours (n=17), and 5) patients with anorexia nervosa (n=25) were compared to healthy age-matched subjects (n=25). Tissue GDF15 mRNA content was determined in mice in response to exhaustive exercise (n=16). Results: The splanchnic bed released GDF15 to the circulation during exercise and increasing the glucagon-to-insulin ratio in resting humans led to a 2.7-fold (P<0.05) increase in circulating GDF15. Conversely, inhibiting the exercise-induced increase in the glucagon-to-insulin ratio blunted the exercise-induced increase in circulating GDF15. Fasting for 36 hours did not affect circulating GDF15, whereas resting patients with anorexia nervosa displayed elevated plasma concentrations (1.4-fold, P<0.05) compared to controls. In mice, exercise increased GDF15 mRNA contents in liver, muscle, and adipose tissue. Conclusion: In humans, GDF15 is a “hepatokine” which increases during exercise and is at least in part regulated by the glucagon-to-insulin ratio. Moreover, chronic energy deprivation is associated with elevated plasma GDF15, which supports that GDF15 is implicated in metabolic signalling in humans.","author_count":10,"contributors":["Plomgaard, Peter","Hansen, Jakob S.","Townsend, Logan K.","Gudiksen, Anders","Secher, Niels H.","Clemmesen, Jens O.","Støving, Rene K.","Goetze, Jens P.","Wright, David C.","Pilegaard, Henriette"],"cuid":["S02-100.00-040316"],"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["America, North","OECD"],"corresponding_author":["Plomgaard, Peter"],"country":["Canada"],"glorg":["All Global Affiliations","University of British Columbia","University of British Columbia (UBC)","University of Guelph"],"keyword":["Animals","Anorexia nervosa","Appetite","Fasting","Glucagon metabolism","Growth Differentiation Factor 15 metabolism","Humans","Insulin Resistance","Insulin metabolism","Liver","Male","Mice","Pancreas metabolism","Pancreatic Hormones","RNA Messenger","splanchnic bed"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"gdf000000000015 is an exercise induced hepatokine regulated by glucagon and insulin in humans","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fendo.2022.1037948","version":"Published Version"},"funding_acknowledgement":["The Centre for Physical Activity Research (CFAS) is supported by TrygFonden (grants ID 101390 and ID 20045). During the study period, the Centre of Inflammation and Metabolism (CIM) was supported by a grant from the Danish National Research Foundation (DNRF55). This study was further supported by a grant from the Augustinus Foundation. LT was supported by the Natural Sciences and Engineering Research Council of Canada. DW is a Tier II Canada Research Chair. Animal work was supported by the Discovery Grant from the Natural Sciences and Engineering Research Council of Canada. Danish Ministry of Culture for Sports Research and Danish Council for Independent Research."],"id":"S02-100.00-040316","identifier":[{"id":"36545337","type":"pmid"},{"id":"PMC9760804","type":"pmcid"},{"id":"85144230751","type":"scopus"}],"ids":["ku-1282145e-a62e-42a1-ac32-c3f7ca29e8e2","sdu-100d0f68-a0ae-4573-a83b-c2dfaa3db7cb"],"keyword":["Animals","Glucagon/metabolism","Growth Differentiation Factor 15/metabolism","Humans","Insulin/metabolism","Male","Mice","Pancreas/metabolism","Pancreatic Hormones","RNA, Messenger","anorexia nervosa","appetite","fasting","insulin resistance","liver","splanchnic bed"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-C99798253E805BCBC0E1F01F0949DBC6"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fendo.2022.1037948","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/330395217/fendo_13_1037948.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/216988158/Open_Access_Version.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Clinical Biochemistry","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","country":"ca","key":"university of guelph","loc":["Canada","America, North","OECD"],"name":"University of Guelph","used":1},{"affno":"4","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Endocrinology (Odense)","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Psychiatry (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"5","country":"ca","key":"university of british columbia","loc":["Canada","America, North","OECD"],"name":"University of British Columbia","used":1}],"person":[{"affno":"1","first":"Peter","key":"plomgaardpau","last":"Plomgaard","locid":"876d799c-45f9-4296-8dc4-455c10728a8a","name":"Plomgaard, Peter","rank":1,"rolecode":"pau"},{"affno":"2","first":"Jakob S.","key":"hansenpau","last":"Hansen","name":"Hansen, Jakob S.","rank":2,"rolecode":"pau"},{"affno":"3","first":"Logan K.","key":"townsendpau","last":"Townsend","name":"Townsend, Logan K.","rank":3,"rolecode":"pau"},{"affno":"1","first":"Anders","key":"gudiksenpau","last":"Gudiksen","locid":"c606f51e-8e40-4c33-a459-45f96c93b102","name":"Gudiksen, Anders","rank":4,"rolecode":"pau"},{"affno":"1 2","first":"Niels H.","key":"secherpau","last":"Secher","locid":"fc54cecb-0c67-47bd-b27f-1e0127af0e4d","name":"Secher, Niels H.","rank":5,"rolecode":"pau"},{"affno":"2","first":"Jens O.","key":"clemmesenpau","last":"Clemmesen","name":"Clemmesen, Jens O.","rank":6,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Rene K.","key":"støvingpau","last":"Støving","locid":"4aab81f6-352f-4c74-82a2-23589beb9fd5","name":"Støving, René Klinkby","name_org":"Støving, Rene K.","orcid":"0000-0002-4255-5544","rank":7,"rolecode":"pau"},{"affno":"1","first":"Jens P.","key":"goetzepau","last":"Goetze","locid":"980bceaf-dbf3-4f7a-a8d7-0a8e81b638b2","name":"Goetze, Jens P.","orcid":"0000-0001-6356-3829","rank":8,"rolecode":"pau"},{"affno":"3 5","first":"David C.","key":"wrightpau","last":"Wright","name":"Wright, David C.","rank":9,"rolecode":"pau"},{"affno":"1","first":"Henriette","key":"pilegaardpau","last":"Pilegaard","locid":"bca00b25-e11a-407d-936f-6982a39ef1d8","name":"Pilegaard, Henriette","orcid":"0000-0002-1071-0327","rank":10,"rolecode":"pau"}],"pmid":["36545337"],"pub":{"doi":"10.3389/fendo.2022.1037948","issn":["16642392"],"journal":"Frontiers in Endocrinology","paperid":"1037948","publisher":"Frontiers Media","status":"p","title":"Frontiers in Endocrinology","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-85144230751"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-1282145e-a62e-42a1-ac32-c3f7ca29e8e2","sdu-100d0f68-a0ae-4573-a83b-c2dfaa3db7cb"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"GDF15 is an exercise-induced hepatokine regulated by glucagon and insulin in humans","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-040316","year":"2022","yearsub":"2022"}
{"abstract":"INTRODUCTION. Glioblastoma is the most frequent primary brain tumour in adults. In Denmark, the treatment of glioblastoma is centralised to four neurosurgical and oncological departments located in four of the five Danish administrative regions. The aim of this study was to examine the regional and socioeconomic variation in survival after a diagnosis of glioblastoma in Denmark. METHODS. We included 1,731 patients with histologically confirmed glioblastoma from 2013 to 2018 registered in the Danish Neuro-oncology Registry. The data sources were the Danish National Registries. The exposure was region of residence at diagnosis and household income in the year before diagnosis. Follow-up was initiated at diagnosis and concluded at death or end-of-follow-up on 15 July 2019. Cox regression was used to examine overall mortality by exposure. RESULTS. With adjustment for age, sex, year of diagnosis and comorbidity, mortality rates of glioblastoma patients varied significantly between regions and were lowest in the Region of Southern Denmark and highest in the Capital Region (hazard ratio = 0.79; 95% confidence interval: 0.68-0.91, compared with the Capital Region). Further adjustment for surgical resection attenuated the regional differences in mortality. Income was not a predictor of survival. CONCLUSIONS. We found significant regional variation in survival after a diagnosis of glioblastoma. Differences in treatment patterns between regions may explain part of this mortality variation. Household income and education level did not explain the regional differences.","author_count":8,"contributors":["Engberg, Henriette","Steding-Jessen, Marianne","Øster, Inge","Jensen, Jens Winther","Hansen, Steinbjørn","Laursen, Rene Johannes","Lukacova, Slávka","Møller, Henrik"],"cuid":["S03-100.00-004003"],"filters":{"added":"2022-04","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"corresponding_author":["Engberg, Henriette"],"keyword":["Adult","Denmark epidemiology","Educational Status","Glioblastoma therapy","Humans","Proportional Hazards Models","Registries"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR","DI-HO-OTH"],"OT":["Regionernes Kliniske Kvalitetsudviklingsprogram (RKKP)"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-CDR","DI-HO-OTH","DI-U-AAU","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"regional and socio economic variation in survival after glioblastoma in denmark 000000002013 000000002018","src":["aau","au","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/464111555/Engberg_et_al._2022_._Regional_and_socio_economic_variation_in_survival_after_glioblastoma_in_Denmark_2013_2018.pdf","version":"Published Version"},"id":"S03-100.00-004003","identifier":[{"id":"85124752519","type":"scopus"},{"id":"35244015","type":"pmid"}],"ids":["aau-51e7f41b-39c9-4ca7-ac11-1b57ad56240c","au-1834213e-fd97-475e-b47d-ccb5254699cb","sdu-99ef3fe5-fdbd-4b1e-90e4-78d5b3aff60c"],"keyword":["Adult","Denmark/epidemiology","Educational Status","Glioblastoma/therapy","Humans","Proportional Hazards Models","Registries"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-0037475198BBFB62F101F3B31F257936"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://pure.au.dk/ws/files/346086331/Regional_and_socio-economic_variation_in_survival_after_glioblastoma_in_Denmark_2013-2018.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/464111555/Engberg_et_al._2022_._Regional_and_socio_economic_variation_in_survival_after_glioblastoma_in_Denmark_2013_2018.pdf","version":"Published Version"},{"a