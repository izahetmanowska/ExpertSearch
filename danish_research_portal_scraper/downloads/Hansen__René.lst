{"author_count":4,"contributors":["Hansen, Anne Sofie","Rask, Charlotte Ulrikka","Christensen, Jakob","Nielsen, René Ernst"],"cuid":["S01-000.00-070832"],"event":{"end":"2018-07-27","place":"Prague, cz","start":"2018-07-23","title":"IACAPAP 2018","year":"2018"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"baseline characteristics and outcome of pediatric onset psychogenic non epileptic seizures","src":["aau"],"src-code":["DI-U-AAU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-070832","ids":["aau-47afb2e9-8add-4f5b-8539-c552096b9ee4"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-0BB4AEE6C8B056D7E77F941C1BF841E8"],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Psychiatry","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anne Sofie","key":"hansenpau","last":"Hansen","locid":"1a4148c3-ca6e-4d92-ac08-e981652a4177","name":"Hansen, Anne Sofie","orcid":"0000-0001-6101-2150","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Charlotte Ulrikka","key":"raskpau","last":"Rask","name":"Rask, Charlotte Ulrikka","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jakob","key":"christensenpau","last":"Christensen","name":"Christensen, Jakob","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"René Ernst","key":"nielsenpau","last":"Nielsen","locid":"689bbd5c-f16d-4316-9717-29e68172bb57","name":"Nielsen, René Ernst","orcid":"0000-0002-7982-6352","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-47afb2e9-8add-4f5b-8539-c552096b9ee4"],"src":["AAU Aalborg University"],"title":"Baseline characteristics and outcome of pediatric-onset psychogenic non-epileptic seizures","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-070832","year":"2018","yearsub":"2018"}
{"abstract":"OBJECTIVE: Intestinal inflammation is frequent in patients with spondyloarthritis (SpA). Here, we test the validity of faecal calprotectin as a marker of intestinal inflammation in SpA patients and evaluate the response of adalimumab in patients with and without intestinal lesions. METHOD: Patients were included on the basis of active SpA with a Bath Ankylosing Spondylitis Disease Activity Index ≥ 4. After a 4 week non-steroidal anti-inflammatory drug washout period, patients were divided into two groups based on faecal calprotectin level (> 100 mg/kg, n = 15, and < 50 mg/kg, n = 15). Adalimumab 40 mg every other week was initiated. Patients with calprotectin >100 mg/kg received an additional 40 mg of adalimumab at baseline. Patients were followed with clinical examination at weeks 12, 20, and 52; magnetic resonance imaging (MRI) at weeks 0, 20, and 52; and endoscopy at weeks 0 and 20. RESULTS: The groups were similar with regard to clinical disease activity measures at baseline. Faecal calprotectin above 100 mg/kg accurately identified patients with intestinal inflammation. Twelve of the 15 patients with elevated calprotectin had bowel lesions, compared to only one patient in the control group. On MRI, the group with elevated calprotectin had more inflammation in the sacroiliac joints. Finally, the group with intestinal inflammation had a better clinical response to adalimumab, as evaluated by the Ankylosing Spondylitis Disease Activity Score. CONCLUSION: Elevated faecal calprotectin accurately identified SpA patients with bowel inflammation and more inflammation on MRI. Elevated faecal calprotectin at baseline may predict a better treatment response.","author_count":6,"contributors":["Østgård, René Drage","Deleuran, Bent","Dam, M Y","Hansen, Ib Tønder","Jurik, Anne Grethe","Glerup, Henning"],"cuid":["S01-000.00-142168"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Journal Article"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"faecal calprotectin detects subclinical bowel inflammation and may predict treatment response in spondyloarthritis","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85021278090","version":"Other Version"},"id":"S01-000.00-142168","identifier":[{"id":"28649913","type":"pmid"},{"id":"85021278090","type":"scopus"}],"ids":["au-1631d3ae-76a7-4d94-81bd-2a379e89d667"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-96B05822B6F25A8296FC1B46659A69B6"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Biomedicine, Department of Biomedicine - Forskning og uddannelse, Syd","Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Diagnostisk Center, Universitetsklinik for Innovative Patientforløb, Silkeborg","Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Section for Rheumatology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"R D","key":"østgårdpau","last":"Østgård","locid":"55d0f083-27c9-4d6b-95d4-92ec4d785e87","name":"Østgård, René Drage","name_org":"Østgård, R D","orcid":"0000-0001-6124-8972","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"B W","key":"deleuranpau","last":"Deleuran","locid":"19a552f3-2968-480d-ab4a-22a0d1c95712","name":"Deleuran, Bent","name_org":"Deleuran, B W","orcid":"0000-0002-7079-1587","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"M Y","key":"dampau","last":"Dam","name":"Dam, M Y","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"I T","key":"hansenpau","last":"Hansen","locid":"81d0b2cc-7b1e-46a1-a233-5ac2e412721b","name":"Hansen, Ib Tønder","name_org":"Hansen, I T","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"A G","key":"jurikpau","last":"Jurik","locid":"7c41cb37-5d88-416b-afd6-8c4f9d5501a0","name":"Jurik, Anne Grethe","name_org":"Jurik, A G","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"H","key":"gleruppau","last":"Glerup","locid":"5c6385d4-e86e-4fb3-ac98-453db3752099","name":"Glerup, Henning","name_org":"Glerup, H","rank":6,"rolecode":"pau"}],"pmid":["28649913"],"pub":{"doi":"10.1080/03009742.2017.1299216","issn":["03009742","15027732"],"issn_org":["03009742"],"issue":"1","journal":"Scandinavian Journal of Rheumatology","pages":"48-55","publisher":"Informa Healthcare","status":"p","title":"Scandinavian Journal of Rheumatology","volume":"47"},"review":"Peer Reviewed","scoID":["2-s2.0-85021278090"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-1631d3ae-76a7-4d94-81bd-2a379e89d667"],"src":["AU Aarhus University"],"title":"Faecal calprotectin detects subclinical bowel inflammation and may predict treatment response in spondyloarthritis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-142168","year":"2018","yearsub":"2018"}
{"abstract":"A high-entropy alloy (HEA) of HfNbTiVZr was synthesized using an arc furnace followed by ball milling. The hydrogen absorption mechanism was studied by in situ X-ray diffraction at different temperatures and by in situ and ex situ neutron diffraction experiments. The body centered cubic (BCC) metal phase undergoes a phase transformation to a body centered tetragonal (BCT) hydride phase with hydrogen occupying both tetrahedral and octahedral interstitial sites in the structure. Hydrogen cycling of the alloy at 500 °C is stable. The large lattice strain in the HEA seems favorable for absorption in both octahedral and tetrahedral sites. HEAs therefore have potential as hydrogen storage materials because of favorable absorption in all interstitial sites within the structure.","author_count":12,"contributors":["Karlsson, Dennis","Ek, Gustav","Cedervall, Johan","Zlotea, Claudia","Møller, Kasper Trans","Hansen, Thomas Christian","Bednarčík, Jozef","Paskevicius, Mark","Sørby, Magnus Helgerud","Jensen, Torben René","Jansson, Ulf","Sahlberg, Martin"],"cuid":["S01-000.00-150834"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Karlsson, Dennis"],"country":["France","Germany","Norway","Sweden"],"glorg":["All Global Affiliations","Helmholtz Association of German Research Centres","Institut Laue-Langevin","Institute for Energy Technology","Universite Paris XII","Uppsala University"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"structure and hydrogenation properties of a hfnbtivzr high entropy alloy","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85042235958","version":"Other Version"},"id":"S01-000.00-150834","identifier":[{"id":"85042235958","type":"scopus"},{"id":"29389120","type":"pmid"}],"ids":["au-257b13f0-a32e-4e21-a2e6-302e938a47ff"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-26D57D5B9E57EBB790C348EE10B60586"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","country":"se","key":"uppsala university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Uppsala University","used":1},{"affno":"2","country":"fr","key":"universite paris xii","loc":["France","Europe, EU","OECD"],"name":"Universite Paris XII","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Chemistry, Department of Chemistry - Centre for Materials Crystallography (CMC)","Aarhus University, Natural Sciences, Interdisciplinary Nanoscience Center, Interdisciplinary Nanoscience Center - INANO-Kemi, Langelandsgade"],"nora_code":"DI-U-AU","used":1},{"affno":"4","country":"fr","key":"institut laue langevin","loc":["France","Europe, EU","OECD"],"name":"Institut Laue-Langevin","used":1},{"affno":"5","country":"de","key":"helmholtz association of german research centres","loc":["Germany","Europe, EU","OECD"],"name":"Helmholtz Association of German Research Centres","used":1},{"affno":"6","country":"no","key":"institute for energy technology","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"Institute for Energy Technology","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Dennis","key":"karlssonpau","last":"Karlsson","name":"Karlsson, Dennis","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Gustav","key":"ekpau","last":"Ek","name":"Ek, Gustav","rank":2