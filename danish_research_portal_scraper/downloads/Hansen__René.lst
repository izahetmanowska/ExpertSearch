-AAU","used":1},{"affno":"2","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anne Sofie","key":"hansenpau","last":"Hansen","locid":"1a4148c3-ca6e-4d92-ac08-e981652a4177","name":"Hansen, Anne Sofie","orcid":"0000-0001-6101-2150","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Charlotte Ulrikka","key":"raskpau","last":"Rask","name":"Rask, Charlotte Ulrikka","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jakob","key":"christensenpau","last":"Christensen","name":"Christensen, Jakob","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"René Ernst","key":"nielsenpau","last":"Nielsen","locid":"689bbd5c-f16d-4316-9717-29e68172bb57","name":"Nielsen, René Ernst","orcid":"0000-0002-7982-6352","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities"],"PST":["Published"]},"sid":["aau-a7608526-733e-42a4-b832-b94631a5e0b6"],"src":["AAU Aalborg University"],"title":"Psychogenic non-epileptic seizures in children and adolescents - a Danish nationwide cohort study","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-098588","year":"2017","yearsub":"2017"}
{"abstract":"Silver compounds share a rich history in technical applications including photography, catalysis, photocatalysis, cloud seeding and as antimicrobial agents. Here we present a class of silver compounds (Ag2B10H10 and Ag2B12H12) that are semiconductors with a bandgap at 2.3 eV in the green visible light spectrum. The silver boranes have extremely high ion conductivity and dynamic-anion facilitated Ag+ migration is suggested based on the structural model. The ion conductivity is enhanced more than two orders of magnitude at room temperature (up to 3.2 mS cm(-1)) by substitution with AgI to form new compounds. Furthermore, the closo-boranes show extremely fast silver nano-filament growth when excited by electrons during transmission electron microscope investigations. Ag nano-filaments can also be reabsorbed back into Ag2B12H12. These interesting properties demonstrate the multifunctionality of silver closo-boranes and open up avenues in a wide range of fields including photocatalysis, solid state ionics and nano-wire production.","author_count":5,"contributors":["Paskevicius, Mark","R. S. Hansen, Bjarne","Jørgensen, Mathias","Richter, Bo","Jensen, Torben René"],"cuid":["S01-000.00-146171"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["OECD","Oceania"],"corresponding_author":["Paskevicius, Mark"],"country":["Australia"],"glorg":["All Global Affiliations","Curtin University"],"keyword":["Chemistry","Crystal structures","DODECABORATE","Decomposition","LI2B12H12","LIBH4","Lithium","SODIUM SUPERIONIC CONDUCTION","Solid electrolytes","Stability"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"multifunctionality of silver closo boranes","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/ncomms15136","version":"Published Version"},"id":"S01-000.00-146171","identifier":[{"id":"000400065400001","type":"wos"},{"id":"PMC5414069","type":"pmcid"},{"id":"85021762101","type":"scopus"},{"id":"28443627","type":"pmid"}],"ids":["au-1d6cef55-7151-44c9-831c-dc3cf66b8ecc"],"keyword":["CHEMISTRY","CRYSTAL-STRUCTURES","DECOMPOSITION","DODECABORATE","LI2B12H12","LIBH4","LITHIUM","SODIUM SUPERIONIC CONDUCTION","SOLID ELECTROLYTES","STABILITY"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-2E7AC861615A41FF023E76F97470CD89"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/ncomms15136","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Chemistry","Aarhus University, Natural Sciences, Interdisciplinary Nanoscience Center, Interdisciplinary Nanoscience Center - INANO-Kemi, Langelandsgade"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"au","key":"curtin university","loc":["Australia","Oceania","OECD"],"name":"Curtin University","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Mark","key":"paskeviciuspau","last":"Paskevicius","locid":"e26eea7d-e55a-4989-80de-dfafd2146511","name":"Paskevicius, Mark","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Bjarne R. S.","key":"hansenpau","last":"Hansen","locid":"95e2932e-526e-4795-b38a-7ab221f891ae","name":"R. S. Hansen, Bjarne","name_org":"Hansen, Bjarne R. S.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mathias","key":"jorgensenpau","last":"Jor