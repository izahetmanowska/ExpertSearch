{"abstract":"To investigate the risk of developing psychiatric disorders in individuals born prematurely (born before 37 weeks of gestation).","author_count":5,"contributors":["Mathiasen, René","Hansen, Bo Mølholm","Forman, Julie Lyng","Kessing, Lars Vedel","Greisen, Gorm"],"cuid":["S01-000.00-393679"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the risk of psychiatric disorders in individuals born prematurely in denmark from 000000001974 to 000000001996","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1111/j.1651-2227.2011.02136.x","version":"Other Version"},"id":"S01-000.00-393679","identifier":[{"id":"79953802420","type":"scopus"},{"id":"21244484","type":"pmid"}],"ids":["ku-0057a514-d9f2-4024-a5e8-1c980ca74855"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-665FD5EB5A92A1E5B87EC570818FEEBF"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1111/j.1651-2227.2011.02136.x","version":"Other Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Section of Biostatistics"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"René","key":"mathiasenpau","last":"Mathiasen","locid":"20973b1c-9489-4d6c-b32f-584a790fab80","name":"Mathiasen, René","rank":1,"rolecode":"pau"},{"affno":"","first":"Bo Mølholm","key":"hansenpau","last":"Hansen