g":null,"country":"dk","first":"Torben R.","key":"jensenpau","last":"Jensen","locid":"e0750478-df89-45bf-aa48-b6a86de93fa0","name":"Jensen, Torben René","name_org":"Jensen, Torben R.","orcid":"0000-0002-4278-3221","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Janez","key":"dolinsekpau","last":"Dolinsek","name":"Dolinsek, Janez","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1021/acs.jpcc.8b04605","issn":["19327447","19327455"],"issn_org":["19327447"],"issue":"30","journal":"Journal of Physical Chemistry C","pages":"17073-17079","publisher":"American Chemical Society","status":"p","title":"Journal of Physical Chemistry C","volume":"122"},"review":"Peer Reviewed","scoID":["2-s2.0-85049679474"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-d224e862-7f85-4a3f-90df-091b82e8b90c"],"src":["AU Aarhus University"],"title":"Reorientational Motions and Ionic Conductivity in (NH<sub>4</sub>)<sub>2</sub>B<sub>10</sub>H<sub>10</sub> and (NH<sub>4</sub>)<sub>2</sub>B<sub>12</sub>H<sub>12</sub>","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-249398","year":"2018","yearsub":"2018"}
{"abstract":"There is a growing market for the use of hydrolysates from animal side-streams for production of high-protein supplements. However, there can be issues with development of off-flavors, either due to the raw material in question or due to the hydrolysis process itself. This study examined the development of volatile compounds during hydrolysis of hemoglobin. Briefly, porcine hemoglobin was hydrolyzed by 0.5% papain for up to 5 h, and the development of volatile compounds was analyzed via gas chromatography-mass spectrometry. The results showed that there was significant development of a number of volatile compounds with time, e.g., certain Maillard reaction and lipid oxidation products, which are likely candidates for the aroma development during hydrolysis. Furthermore, it was shown that development of a number of the volatiles was due to the hydrolysis process, as these compounds were not found in a control without enzyme.","author_count":5,"contributors":["Bak, Kathrine Holmgaard","Petersen, Mikael Agerlin","Lametsch, Rene","Hansen, Erik T.","Ruiz Carrascal, Jorge"],"cuid":["S01-000.00-408253"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Aroma","Enzymatic hydrolysis","Enzyme","Hemoglobin","Hydrolysis","Papain","Volatile compounds"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-PR-OTH","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"development of volatile compounds during hydrolysis of porcine hemoglobin with papain","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/molecules23020357","version":"Published Version"},"id":"S01-000.00-408253","identifier":[{"id":"85041931697","type":"scopus"},{"id":"PMC6017756","type":"pmcid"},{"id":"29419737","type":"pmid"}],"ids":["ku-18c8c00e-1c17-47c3-ab74-dcfdf5c8a3f9"],"keyword":["aroma","enzymatic hydrolysis","enzyme","hemoglobin","hydrolysis","papain","volatile compounds"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-11BC90319A272309FCC28E3F6405C5F2"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/191187276/Development_of_Volatile_Compounds_during_Hydrolysis_of_Porcine_Hemoglobin_with_Papain.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/molecules23020357","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Food Science, Design and Consumer Behavior"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["Danish Crown Ingredients"],"nora_code":"DI-PR-OTH","used":1}],"person":[{"affno":"1","first":"Kathrine Holmgaard","key":"bakpau","last":"Bak","locid":"29b470d6-d1a3-4cd1-845f-2f503701fba7","name":"Bak, Kathrine Holmgaard","rank":1,"rolecode":"pau"},{"affno":"1","first":"Mikael Agerlin","key":"petersenpau","last":"Petersen","locid":"9f4065a7-ea41-4357-b2ca-73903fd418c0","name":"Petersen, Mikael Agerlin","orcid":"0000-0002-4106-7696","rank":2,"rolecode":"pau"},{"affno":"1","first":"Rene","key":"lametschpau","last":"Lametsch","locid":"70bd350a-6869-4a4a-b9bc-56a756376784","name":"Lametsch, Rene","orcid":"0000-0002-4189-806X","rank":3,"rolecode":"pau"},{"affno":"2","first":"Erik T.","key":"hansenpau","last":"Hansen","name":"Hansen, Erik T.","rank":4,"rolecode":"pau"},{"affno":"1","first":"Jorge","key":"ruizcarrascalpau","last":"Ruiz Carrascal","locid":"655f62cc-8d9b-42fd-9710-4f2e3bbc8774","name":"Ruiz Carrascal, Jorge","orcid":"0000-0001-7905-3153","rank":5,"rolecode":"pau"}],"pmid":["29419737"],"pub":{"doi":"10.3390/molecules23020357","issn":["14203049","14315157"],"issn_org":["14203049"],"issue":"2","journal":"Molecules","paperid":"357","status":"p","title":"Molecules","volume":"23"},"review":"Peer Reviewed","scoID":["2-s2.0-85041931697"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Other Companies","Private Research","Universities","University of Copenhagen","danish crown ingredients"],"PST":["Published"]},"sid":["ku-18c8c00e-1c17-47c3-ab74-dcfdf5c8a3f9"],"src":["KU University of Copenhagen"],"title":"Development of Volatile Compounds during Hydrolysis of Porcine Hemoglobin with Papain","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-408253","year":"2018","yearsub":"2018"}
{"abstract":"Designing teaching in an era of educational technology calls for new models for designing learning opportunities. The 7Cs framework developed by Professor Gráinne Conole and her colleagues provides a tool for discussing learning designs for online learning environments. In this paper, we introduce the 7Cs framework put forward by Conole and colleagues and discuss it in relation to the concept of personalized learning paths and 'schooling' as a discourse. The article is mainly theoretical, but as empirical support for our theoretical arguments, we discuss examples from a MOOC developed for the teacher education program at University College Absalon, Denmark. On this background, we propose a number of revisions for the 7Cs framework in order to adapt it for designing MOOCs that are used in blended contexts.","author_count":5,"contributors":["Buch, Bettina","Christiansen, René Boyer","Hansen, Dorrit","Petersen, Anne Kristine","Sørensen, Randi Skovbjerg"],"cuid":["S01-000.00-554924"],"filters":{"added":"2023-07","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Blended learning","Education","Educational technology","Innovative teaching"],"level":"sci","oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-UC"],"level3":{"UC":["DI-UC-AB","DI-UC-ALL"]},"level3all":["DI-UC-AB"]},"review":"pr","rtype":["clu"],"sorti":"using the 000000000007cs framework for designing moocs in blended contexts new perspectives and ideas","src":["pha"],"src-code":["DI-UC-AB"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.13189/ujer.2018.060309","version":"Published Version"},"id":"S01-000.00-554924","identifier":[{"id":"85061626347","type":"scopus"}],"ids":["pha-a6a01a9c-2d70-4ecc-bedd-4d9e056b3461"],"keyword":["blended learning","education","educational Technology","innovative teaching"],"lang":"English","level":"Scientific","noi":["Global-Local-2-3-BDD1BDB9ED722294A2215DDE9C421FDD"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.13189/ujer.2018.060309","version":"Published Version"}],"org":[{"affno":"1","key":"university college absalon","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-AB","l3nl":"University College Absalon","l3nn":"University College Absalon","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"University College Absalon","namevar":["Professionshøjskolen Absalon, Direktionen - Slagelse, Pædagogik og Ledelsesområdet, Absalon - Forskningsprogram for Fagdidaktik","Professionshøjskolen Absalon, Direktionen - Slagelse, Pædagogik og Ledelsesområdet, Læreruddannelsen - Roskilde"],"nora_code":"DI-UC-AB","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Bettina","key":"buchpau","last":"Buch","locid":"ffe5c49c-02ac-4ed2-91d7-6c9600b09f2a","name":"Buch, Bettina","orcid":"0000-0001-5496-1243","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"René Boyer","key":"christiansenpau","last":"Christiansen","locid":"42204c79-a17b-4152-bd0f-e5dfbbf302d5","name":"Christiansen, René Boyer","orcid":"0000-0002-2962-7320","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Dorrit","key":"hansenpau","last":"Hansen","locid":"392c5883-80e4-4cc6-a7f9-7382e2b31d81","name":"Hansen, Dorrit","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anne Kristine","key":"petersenpau","last":"Petersen","locid":"f5e451f8-6385-46fb-8e71-45f37a1f7d8c","name":"Petersen, Anne Kristine","orcid":"0000-0002-3109-0227","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Randi Skovbjerg","key":"sørensenpau","last":"Sørensen","locid":"0e776e0c-4caf-46fd-b597-f1ae0df93bfd","name":"Sørensen, Randi Skovbjerg","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.13189/ujer.2018.060309","issn":["23323205"],"issue":"3","journal":"Universal Journal of Educational Research","pages":"421-429","publisher":"Horizon Research Publishing","status":"p","title":"Universal Journal of Educational Research","volume":"6"},"review":"Peer Reviewed","scoID":["2-s2.0-85061626347"],"search":{"DAF":["All Danish Affiliations","All University Colleges","DI-ALL","DI-UC","DI-UC-ALL","University College Absalon","University Colleges"],"PST":["Published"]},"sid":["pha-a6a01a9c-2d70-4ecc-bedd-4d9e056b3461"],"src":["AB University College Absalon"],"title":"Using the 7Cs Framework for Designing MOOCs in Blended Contexts : New Perspectives and Ideas","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-554924","year":"2018","yearsub":"2018"}
