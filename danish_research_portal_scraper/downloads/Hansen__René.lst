affno":"","first":"Jørgen","key":"eriksenpedh","last":"Eriksen","name":"Eriksen, Jørgen","rank":14,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Ingrid K.","key":"thomsenpedh","last":"Thomsen","name":"Thomsen, Ingrid K.","rank":15,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Carl Christian","key":"hoffmannpedh","last":"Hoffmann","name":"Hoffmann, Carl Christian","rank":16,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Berit","key":"haslerpedh","last":"Hasler","name":"Hasler, Berit","rank":17,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Brian H.","key":"jacobsenpedh","last":"Jacobsen","name":"Jacobsen, Brian H.","rank":18,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"eisbn":["9788793998216"],"isbn":["9788793998209"],"issn":["22451684"],"issue":"174","pages":"127-137","publisher":"DCA - Nationalt Center for Fødevarer og Jordbrug","series":"DCA rapport","status":"p","title":"Virkemidler til reduktion af kvælstofbelastningen af vandmiljøet"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Undetermined","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-13dff0ed-47f7-463f-a2b7-ba5ba7092f00"],"src":["KU University of Copenhagen"],"title":"Afgrøder med stort kvælstofoptag","type":"Report Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-405267","year":"2020","yearsub":"2020"}
{"abstract":"BACKGROUND: Pediatric onset psychogenic nonepileptic seizures (PNES) is a highly disabling disorder and potentially misdiagnosed as epilepsy. Still, knowledge regarding PNES in children and adolescents is limited and data on both incidence and characteristics are scarce. This study investigated the incidence rate (IR) and clinical characteristics of pediatric onset PNES, including possible differences when having comorbid epilepsy. METHODS: A population-based study of children and adolescents aged 5-17 years with an incident diagnosis of PNES in the Danish healthcare registries between 1996 and 2014. In total, 386 children and adolescents were included after assessment of diagnostic validity using medical record data. RESULTS: The IR increased during the study period with the maximum IR observed in 2014 (7.4 per 100,000 person-years). A history of both neurologic and psychiatric problems as well as negative life events was identified. Comorbid epilepsy was confirmed for 55 cases (14.2%) and was associated with intellectual disabilities, school support and prolonged delay in PNES diagnosis. CONCLUSIONS: PNES are increasingly diagnosed in children and adolescents, and the clinical profile of both neurologic and psychiatric health problems underscores the need for collaborative pediatric and mental healthcare. These findings provide important information for future healthcare planning in this area. IMPACT: This nationwide study is the first to report population-based incidence rates of pediatric onset PNES documenting markedly increasing incidence rates between 1996 and 2014. A history of both neurologic and psychiatric problems as well as negative life events was identified for pediatric onset PNES. Comorbid epileptic seizures were associated with intellectual disabilities, school support and prolonged delay in PNES diagnosis. The clinical profile of both neurologic and psychiatric health problems underscores the need for collaborative pediatric and mental healthcare. The increasing number of children and adolescents diagnosed with PNES is important information for future healthcare planning in this area.","author_count":6,"contributors":["Hansen, Anne Sofie","Rask, Charlotte U","Rodrigo-Domingo, Maria","Pristed, Sofie Gry","Christensen, Jakob","Nielsen, René Ernst"],"cuid":["S02-099.94-001939"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Hansen, Anne S.","Hansen, Anne Sofie"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"incidence rates and characteristics of pediatric onset psychogenic nonepileptic seizures","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85084503134&partnerID=8YFLogxK","version":"Other Version"},"id":"S02-099.94-001939","identifier":[{"id":"85084503134","type":"scopus"},{"id":"32392575","type":"pmid"}],"ids":["aau-2678ceb6-a8be-4064-bbec-f2111e8a5076","au-ce581afd-3551-452c-84e8-c9f23ed27012"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-BA071D179EDC70C39A0C7743CFBED537"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Psychiatry","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Psychiatric Hospital for Children and Adolescents"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anne S","key":"hansenpau","last":"Hansen","locid":"1a4148c3-ca6e-4d92-ac08-e981652a4177","name":"Hansen, Anne Sofie","name_org":"Hansen, Anne S","orcid":"0000-0001-6101-2150","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Charlotte U.","key":"raskpau","last":"Rask","locid":"1e308742-df61-47da-83ce-53d8a7c774c3","name":"Rask, Charlotte Ulrikka","name_org":"Rask, Charlotte U.","orcid":"0000-0002-7426-0353","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Maria","key":"rodrigodomingopau","last":"Rodrigo-Domingo","locid":"fff908cd-728d-480b-9534-0cd7176b7dfc","name":"Rodrigo-Domingo, Maria","orcid":"0000-0001-7661-7195","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sofie G","key":"pristedpau","last":"Pristed","locid":"871611e1-8aa7-4e05-b1b2-c8cf77cad0c8","name":"Pristed, Sofie Gry","name_org":"Pristed, Sofie G","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jakob","key":"christensenpau","last":"Christensen","locid":"e0bc29a0-3d22-4fa2-82f8-4d99059132c9","name":"Christensen, Jakob","orcid":"0000-0002-9385-6435","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"René E","key":"nielsenpau","last":"Nielsen","locid":"689bbd5c-f16d-4316-9717-29e68172bb57","name":"Nielsen, René Ernst","name_org":"Nielsen, René E","orcid":"0000-0002-7982-6352","rank":6,"rolecode":"pau"}],"pmid":["3239257