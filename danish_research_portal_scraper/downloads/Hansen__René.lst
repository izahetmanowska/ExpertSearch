":["2-s2.0-85159733390"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","North Denmark Region","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-6e9b98f3-0bba-46e0-bf06-9e0b9d0a2e57","au-ed776b4e-a0d5-462e-b0d2-bf8b74142668","ku-fa2ee81c-3c45-495c-953a-3f6ba73f0c8c","sdu-873fb545-8cee-4ab7-96d9-e66726cc9e60"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Population-Based Characterization of Menstrual Migraine and Proposed Diagnostic Criteria","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-099.97-685672","year":"2023","yearsub":"2023"}
{"abstract":"Background and purpose: Understanding migraine in a sex-specific manner is crucial for improving clinical care, diagnosis and therapy for both females and males. Here, data on sex differences are provided in the presentation of migraine in a large European-based population cohort, which is representative of the general population. Methods: A population-based study of 62,672 Danish blood donors (both present and previous donors), of whom 12,658 had migraine, was performed. All participants completed a 105-item diagnostic migraine questionnaire sent via an electronic mailing system (e-Boks) between May 2020 and August 2020. The questionnaire allowed for correct diagnosis of migraine according to the International Classification of Headache Disorders, third edition. Results: The migraine questionnaire was in-cohort validated and had a positive predictive value of 97% for any migraine, a specificity of 93% and a sensitivity of 93%. There were 9184 females (mean age 45.1 years) and 3434 males (mean age 48.0 years). The 3-month prevalence of migraine without aura was 11% in females and 3.59% in males. The 3-month prevalence of migraine with aura was 1.72% in females and 1.58% in males. In females, the age-related 3-month prevalence of migraine without aura increased markedly during childbearing age. In males, migraine both with and without aura showed less age variation. Females had a higher frequency of migraine attacks (odds ratio [OR] 1.22) but a lower frequency of non-migraine headaches (OR = 0.35). Females also had a greater intensity of pain, more unilateral and pulsatile pain, and exacerbation by physical activity (OR = 1.40–1.49) as well as more associated symptoms (OR = 1.26–1.98). Females carried 79% of the total migraine disease burden, which was almost exclusively driven by migraine without aura (77%), whilst there was no sex difference in the disease burden of migraine with aura. Conclusion: Females have more severe disease, resulting in a much higher migraine disease burden than indicated by prevalence alone.","author_count":22,"contributors":["Chalmer, Mona Ameri","Kogelman, Lisette J. A.","Callesen, Ida","Christensen, Charlotte Grønvold","Techlo, Tanya Ramdal","Møller, Peter L.","Davidsson, Olafur B.","Olofsson, Isa A.","Schwinn, Michael","Mikkelsen, Susan","Dinh, Khoa Manh","Nielsen, Kaspar René","Topholm, Mie","Erikstrup, Christian","Ostrowski, Sisse Rye","Pedersen, Ole Birger","Hjalgrim, Henrik","Banasik, Karina","Burgdorf, Kristoffer S.","Nyegaard, Mette","Olesen, Jes","Hansen, Thomas Folkmann"],"cuid":["S04-100.00-672477"],"filters":{"added":"2023-04","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"corpau":["DBDS Genomic Consortium","Danish Blood Donor Study Genomic Consortium"],"corresponding_author":["Chalmer, Mona Ameri","Hansen, Thomas Folkmann"],"keyword":["BURDEN","Blood Donors","Female","Headache epidemiology","Humans","Male","Middle Aged","Migraine","Migraine with Aura diagnosis","Migraine without Aura","Population based study","Sex Characteristics","Sex differences","Surveys and Questionnaires","sex stratification"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"sex differences in clinical characteristics of migraine and its burden a population based study","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1111/ene.15778","version":"Published Version"},"funding_acknowledgement":["The authors would like to thank the Danish blood donors for their valuable participation in the Danish Blood Donor Study as well as the staff at the blood centers for making this study possible. Professor Timothy Steiner, Gyda Bjornsdottir, PhD, Hreinn Stefansson, PhD, Thorgeir Thorgeirsson, PhD, and Professor Kári Stefánsson are thanked for their valuable inputs. The study was financed by a grant from Candys Foundation, the CEHEAD program (J.O.) and the Research Funding Pool at Rigshospitalet (M.A.C.). The funding sources had no role in study design, data collection and analysis, decision to publish, or preparation of the manuscript.","The study was financed by a grant from Candys Foundation, the CEHEAD program (J.O.) and the Research Funding Pool at Rigshospitalet (M.A.C.). The funding sources had no role in study design, data collection and analysis, decision to publish, or preparation of the manuscript."],"id":"S04-100.00-672477","identifier":[{"id":"36905094","type":"pmid"},{"id":"85151278558","type":"scopus"}],"ids":["aau-e2ca207e-4996-437f-abf7-2b98fdba2537","au-4a9ed09e-521e-482b-8dcf-4a0218333030","ku-e0c58376-97fe-4450-94de-c4123b547baa","sdu-dc805be2-8d21-4cc1-bc4e-0454503f5ff0"],"keyword":["Female","Headache/epidemiology","Humans","Male","Middle Aged","Migraine with Aura/diagnosis","Migraine without Aura","Sex Characteristics","Surveys and Questionnaires","blood donors","burden","migraine","population-based study","sex differences","sex stratification"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-7-E46FCDC57278DACB161718E5CF4F0243"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/226830976/Euro_J_of_Neurology_2023_Chalmer_Sex_differences_in_clinical_characteristics_of_migraine_and_its_burden_a.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://pure.au.dk/ws/files/409599751/Euro_J_of_Neuro