nsortiumdbdsgeneticpau","last":"Consortium","name":"Consortium, DBDS Genetic","rank":123,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"GO","key":"consortiumgopau","last":"Consortium","name":"Consortium, GO","rank":124,"rolecode":"pau"}],"pmid":["35110524"],"pub":{"doi":"10.1038/s41467-022-28167-1","issn":["20411723"],"issue":"1","journal":"Nature Communications","paperid":"634","publisher":"Nature Research","status":"p","title":"Nature Communications","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-85123973763"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","Copenhagen Business School","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Miscellaneous","North Denmark Region","Other Research","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-86401b0b-2d10-4752-bd1b-3d51017076c7","au-6e0a5bcb-c7bc-48aa-913b-01b274f585bc","cbs-ae4806d4-a6a2-4d8f-8c78-03f1e1c259c2","ku-4b29a6a8-c6d9-4e38-8f68-132404f9b4be","sdu-65096e92-ed3b-4b83-97ac-bc15d45f5b8a"],"src":["AAU Aalborg University","AU Aarhus University","CBS Copenhagen Business School","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Rare <i>SLC13A1</i> Variants Associate with Intervertebral Disc Disorder Highlighting Role of Sulfate in Disc Pathology","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S05-094.89-006486","year":"2022","yearsub":"2022"}
{"abstract":"Global warming has pronounced effects on tundra vegetation, and rising mean temperatures increase plant growth potential across the Arctic biome. Herbivores may counteract the warming impacts by reducing plant growth, but the strength of this effect may depend on prevailing regional climatic conditions. To study how ungulates interact with temperature to influence growth of tundra shrubs across the Arctic tundra biome, we assembled dendroecological data from 20 sites, comprising 1153 individual shrubs and 223 63 annual growth rings. Evidence for ungulates suppressing shrub radial growth was only observed at intermediate summer temperatures (6.5 °C-9 °C), and even at these temperatures the effect was not strong. Multiple factors, including forage preferences and landscape use by the ungulates, and favourable climatic conditions enabling effective compensatory growth of shrubs, may weaken the effects of ungulates on shrubs, possibly explaining the weakness of observed ungulate effects. Earlier local studies have shown that ungulates may counteract the impacts of warming on tundra shrub growth, but we demonstrate that ungulates' potential to suppress shrub radial growth is not always evident, and may be limited to certain climatic conditions.","author_count":41,"contributors":["Vuorinen, Katariina E.M.","Austrheim, Gunnar","Tremblay, Jean Pierre","Myers-Smith, Isla H.","Hortman, Hans I.","Frank, Peter","Barrio, Isabel C.","Dalerum, Fredrik","Björkman, Mats P.","Björk, Robert G.","Ehrich, Dorothee","Sokolov, Aleksandr","Sokolova, Natalya","Ropars, Pascale","Boudreau, Stéphane","Normand, Signe","Prendin, Angela Luisa","Schmidt, Niels Martin","Pacheco-Solana, Arturo","Post, Eric","John, Christian","Kerby, Jeffrey T.","Sullivan, Patrick F.","Moullec, Mathilde Le","Hansen, Brage B.","Van Der Wal, Rene","Pedersen, Åshild O.","Sandal, Lisa","Gough, Laura","Young, Amanda","Li, Bingxi","Magnússon, Rúna I.","Sass-Klaassen, Ute","Buchwal, Agata","Welker, Jeffrey","Grogan, Paul","Andruko, Rhett","Morrissette-Boileau, Clara","Volkovitskiy, Alexander","Terekhina, Alexandra","Speed, James D.M."],"cuid":["S01-000.00-218959"],"filters":{"added":"2022-05","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Africa","America, North","Europe, EU","Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Vuorinen, Katariina E.M."],"country":["Canada","Finland","Iceland","Netherlands","Norway","Poland","Russia","South Africa","Spain","Sweden","United Kingdom","United States"],"glorg":["Adam Mickiewicz University","Agricultural University of Iceland","All Global Affiliations","Columbia University","Consejo Superior de Investigaciones Científicas (CSIC)","Norwegian Institute for Nature Research","Norwegian Polar Institute","Norwegian University of Science and Technology","Queen's University Kingston","RAS - Institute of Plant and Animal Ecology, Ural Branch","Stockholm University","Swedish University of Agricultural Sciences","UiT The Arctic University of Norway","Universite Laval","Universite du Quebec a Rimouski","University System of Maryland","University of Alaska Anchorage","University of Alaska Fairbanks","University of California at Davis","University of Edinburgh","University of Gothenburg","University of Oulu","University of Pretoria","University of the Arctic","Wageningen University & Research"],"keyword":["Arctic","Browsing","Climate change","Dendroecology","Herbivory","Shrub","Tundra"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"growth rings show limited evidence for ungulates potential to suppress shrubs across the arctic","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1088/1