{"abstract":"Der er ikke enighed om principperne bag plejen af trakeostomerede patienter, når de er i risiko for dysfagi og silent aspiration. Uenigheden har ført til udarbejdelse af en klinisk retningslinje med evidensbaserede anbefalinger.","author_count":3,"contributors":["Christensen, Dorthe Wiinholdt","Richard, René","Rydahl Hansen, Susan"],"cuid":["S01-000.00-149766"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Aspiration","Dysphagia","Tracheotomy"],"level":"pop","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-HO-CAP","DI-U-AU"]},"review":"und","rtype":["clu"],"sorti":"sygepleje til trakeostomerede patienter","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-149766","ids":["au-239e5251-307d-4ea9-815d-a8f2ff1449cd"],"keyword":["aspiration","cuff","dysphagia","swallowing problems","tracheotomy"],"lang":"Danish","level":"Popular","mra":["Medical Science"],"noi":["Local-1-1-041E779853C9BF6895AAA5F08DB64519"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Public Health, Department of Public Health - Department of Science in Nursing"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Capitol Region of Denmark"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"","corresponding":null,"first":"Dorthe Wiinholdt","key":"