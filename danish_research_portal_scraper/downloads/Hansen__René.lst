"pau"},{"affno":"2 1","first":"Thomas Folkmann","key":"hansenthomasfolkmannpau","last":"Hansen","locid":"269f0fae-73d8-4f22-9963-a1306b7465f1","name":"Hansen, Thomas Folkmann","orcid":"0000-0001-6703-7762","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mona Ameri","key":"chalmermonaameripau","last":"Chalmer","name":"Chalmer, Mona Ameri","rank":11,"rolecode":"pau"}],"pmid":["35589944"],"pub":{"doi":"10.1038/s41598-022-12545-2","issn":["20452322"],"issue":"1","journal":"Scientific Reports","paperid":"8487","publisher":"Nature Publishing Group","status":"p","title":"Scientific Reports","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-85130342552"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-b2b77ae0-4d27-4923-85c3-59bb628ced3a","au-5182d29a-91cd-48a9-98d2-b3309d8de159","ku-59065303-efb6-460c-8e34-86a273789ef4","sdu-b7bb7f6a-20ce-4530-9c2e-aeb205ebe637"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Low adherence to the guideline for the acute treatment of migraine","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-100.00-008608","year":"2022","yearsub":"2022"}
{"abstract":"Many security-related properties—such as non-interference—cannot be captured by traditional trace-based specification formalisms such as LTL. The reason is that they relate the events of two (or more) traces of the system, and LTL can only reason on one execution at a time. A number of hyper-property extensions of LTL have been proposed in the past few years, and case studies showing their ability to express interesting properties have also been shown. However, there has been less attention to hyper-properties for quantitative (timed) systems as well as very little work on developing a practically useful tool. Instead existing work focused on using ad-hoc implementations. In this paper we present a probabilistic hyper-property logic HPSTL for stochastic hybrid and timed systems and we show how to integrate the logic into existing statistical model checking tools. To show the feasibility of our approach we integrate the technique into a prototype implementation inside Uppaal SMC and apply it to the analysis of three side-channel attack examples. To our knowledge this is the first full implementation of a hyper logic inside a fully-fledged modelling environment.","author_count":7,"contributors":["Arora, Shiraj","Hansen, Rene Rydhof","Larsen, Kim Guldstrand","Legay, Axel","Poulsen, Danny Bøgsted"],"cuid":["S01-000.00-060367"],"event":{"end":"2022-05-21","start":"2022-05-21","title":"28th International Symposium on Model Checking of Software","year":"2022"},"filters":{"added":"2022-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Belgium"],"glorg":["All Global Affiliations","Université catholique de Louvain"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"statistical model checking for probabilistic hyperproperties of real valued signals","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85137063577&partnerID=8YFLogxK","version":"Other Version"},"id":"S01-000.00-060367","identifier":[{"id":"85137063577","type":"scopus"}],"ids":["aau-237fe852-502c-427e-8f44-bfe710ad134b"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-E7277D56386EA82842FD862DD765331A"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Technical Faculty of IT and Design","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science, Distributed, Embedded and Intelligent Systems"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"be","key":"université catholique de louvain","loc":["Belgium","Europe, EU","OECD"],"name":"Université catholique de Louvain","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Shiraj","key":"arorapau","last":"Arora","locid":"5d5128ab-9720-4e41-aeaf-4c6ff38fd494","name":"Arora, Shiraj","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"René Rydhof","key":"hansenpau","last":"Hansen","locid":"d92ec90d-a8b7-4c01-acbe-ebab21f3f0c3","name":"Hansen, Rene Rydhof","name_org":"Hansen, René Rydhof","orcid":"0000-0002-5688-6432","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kim Guldstrand","key":"larsenpau","last":"Larsen","locid":"27dbc400-17ea-4672-9343-63093ad486c9","name":"Larsen, Kim Guldstrand","orcid":"0000-0002-5953-3384","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Axel","key":"legaypau","last":"Legay","name":"Legay, Axel","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Danny Bøgsted","key":"poulsenpau","last":"Poulsen","locid":"dfb3337d-6acd-49e8-a38c-d819a6efca6c","name":"Poulsen, Danny Bøgsted","orcid":"0000-0001-9623-0748","rank":5,"rolecode":"pau"},{"affno":"","first":"Owolabi","key":"legunsenpedh","last":"Legunsen","name":"Legunsen, Owolabi","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Grigore","key":"rosupedh","last":"Rosu","name":"Rosu, Grigore","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-031-15077-7_4","eisbn":["9783031150777"],"isbn":["9783031150760"],"issn":["03029743"],"pages":"61-78","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","subtitle":"28th International Symposium, SPIN 2022, Proceedings","title":"Model Checking Software, SPIN 2022"},"review":"Peer Reviewed","scoID":["2-s2.0-85137063577"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-237fe852-502c-427e-8f44-bfe710ad134b"],"src":["AAU Aalborg University"],"title":"Statistical Model Checking for Probabilistic Hyperproperties of Real-Valued Signals","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-060367","year":"2022","yearsub":"2022"}
