":"jensenpau","last":"Jensen","locid":"3f3d527c-4262-4298-ac4c-11759ce3e13a","name":"Jensen, Louise Krobak","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"David Thore","key":"gravesenpau","last":"Gravesen","locid":"7be2c72b-0522-4bfc-b281-0c327c09bcf0","name":"Gravesen, David Thore","orcid":"0000-0002-4951-0699","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Joachim","key":"meierpau","last":"Meier","name":"Meier, Joachim","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"René","key":"hedegaardpau","last":"Hedegaard","name":"Hedegaard, René","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anne","key":"nguyenquypau","last":"Nguyen-Quy","locid":"0cbd90d3-72ef-425f-9e2c-b109e9863b21","name":"Nguyen-Quy, Anne","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anette Kirkegaard","key":"aebeloepau","last":"Aebeloe","locid":"ca19a023-cd3d-4e9a-bdfe-5a6ee46249a3","name":"Aebeloe, Anette Kirkegaard","rank":8,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Niels Christian","key":"dybdahlbilenbergpau","last":"Dybdahl Bilenberg","name":"Dybdahl Bilenberg, Niels Christian","rank":9,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jonas","key":"begtruphansenpau","last":"Begtrup-Hansen","name":"Begtrup-Hansen, Jonas","rank":10,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Simon Høgholm","key":"westesenpau","last":"Westesen","name":"Westesen, Simon Høgholm","rank":11,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Theresa","key":"bergandersenpau","last":"Berg Andersen","name":"Berg Andersen, Theresa","rank":12,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Eva","key":"borchhorstmejnertzpau","last":"Borchhorst Mejnertz","name":"Borchhorst Mejnertz, Eva","rank":13,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Mette","key":"elbækhansenpau","last":"Elbæk Hansen","name":"Elbæk Hansen, Mette","rank":14,"rolecode":"pau"}],"pub":{"publisher":"VIA University College","status":"p"},"review":"Undetermined","search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","All University Colleges","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","Miscellaneous","Other Research","Universities","University Colleges","VIA University College"],"PST":["Published"]},"sid":["via-925a05d9-3ba9-403a-bc8e-8b530e25b37f"],"src":["VIA University College"],"title":"PETERgogikum: afsnit 46: Folkemødet for Klubområdet 3 (2025)","type":"Non-Textual Item","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-822107","year":"2025","yearsub":"2025"}
{"abstract":"Tuberculosis (TB) remains a global health problem with an enormous treatment burden and poor treatment adherence, contributing to the emergence of drug resistance. This study investigated the potential of formulating a highly concentrated long-acting injectable (LAI) formulation with bedaquiline fumarate, which could potentially be used as a novel long-term treatment strategy against TB and the prevention of drug resistance. Using wet media milling, micro- and nanosuspensions of bedaquiline fumarate were prepared and evaluated to determine a suitable stabilizer, drug loading capacity, short- and long-term particle size stability, and pharmacokinetic behavior in rats. The stability study revealed a relatively small, but continuous particle size growth over a six-month period when stabilized with 4 % (w/v) polysorbate 20, most pronounced at 40 °C storage. The bedaquiline fumarate salt exhibited superior drug loading capacity compared to the free base form of the compound. When the free base was used in the suspension a viscous paste was obtained at concentrations of 300 mg in 1 mL milling media, whereas the suspensions containing the fumarate salt remained an easy flowing liquid at concentrations as high as 969.5 mg in 1 mL milling media (equivalent to 800 mg free base). Female Spraque-Dawley rats were injected intramuscular with 0.1 mL of one of three formulations, which were identical in composition but differed in particle size distribution. The formulations had mean particle sizes (D50 value) of 0.391 µm, 3.15 µm, 7.80 µm. Particle size displayed a central role in the initial drug release kinetics with smaller particle size profiles yielding higher plasma concentrations. Prolonged plasma concentrations were observed for all three formulations over the 3-months in vivo study. A relatively high sustained plasma concentration of bedaquiline was observed in the animals at the termination of the study suggesting that the prolonged effect continued beyond the investigated three-month period. These data supported the feasibility of LAI bedaquiline formulations as a treatment option for three months with the potential for an even longer duration. However, further studies are needed to optimize the formulations physical stability.","author_count":3,"contributors":["Hansen, Mads Fahnøe","Zulbeari, Nadina","Holm, René"],"cuid":["S01-000.00-831565"],"filters":{"added":"2025-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Holm, René"],"keyword":["In vivo","Pharmacokinetics","Tuberculosis treatment"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"development of highly concentrated bedaquiline suspensions for usage as long acting injectable formulations","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.ijpharm.2025.126103","version":"Published Version"},"id":"S01-000.00-831565","identifier":[{"id":"105014527626","type":"scopus"},{"id":"40850505","type":"pmid"}],"ids":["sdu-e0382f62-0d75-4baf-bc6c-7dd7178f41a9"],"keyword":["In vivo","Long-acting injectables (LAI)","Micro- or nanosuspension","Pharmacokinetics","Tuberculosis treatment"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-D4AFE8B26180A7346892F795A9313AC2"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.ijpharm.2025.126103","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/295440919/1-s2.0-S0378517325009408-main.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Science, Department of Physics, Chemistry and Pharmacy"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Mads Fahnøe","key":"hansenpau","last":"Hansen","locid":"340092d3-8420-4108-8355-112842c16d3c","name":"Hansen, Mads Fahnøe","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Nadina","key":"zulbearipau","last":"Zulbeari","locid":"8e968584-2e62-4bc3-808b-e946a595354d","name":"Zulbeari, Nadina","orcid":"0009-0005-3609-5042","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"René","key":"holmpau","last":"Holm","locid":"2b25cebf-dae4-4529-b115-f80b158ab957","name":"Holm, René","orcid":"0000-0003-4894-7765","rank":3,"rolecode":"pau"}],"pmid":["40850505"],"pub":{"doi":"10.1016/j.ijpharm.2025.126103","issn":["03785173","18733476"],"issn_org":["03785173"],"journal":"International Journal of Pharmaceutics","paperid":"126103","publisher":"Elsevier","status":"p","title":"International Journal of Pharmaceutics","volume":"684"},"review":"Peer Reviewed","scoID":["2-s2.0-105014527626"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-e0382f62-0d75-4baf-bc6c-7dd7178f41a9"],"src":["SDU University of Southern Denmark"],"title":"Development of highly concentrated bedaquiline suspensions for usage as long-acting injectable formulations","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-831565","year":"2025","yearsub":"2025"}
{"abstract":"Good establishment of cover crops early after harvest of the main crop is challenging and requires optimized sowing time to maximize ecosystem services in Northwestern Europe. We quantified the abilities of three cover crop species, fodder radish (Raphanus sativus), oats (Avena sativa), and phacelia (Phacelia tanacetifolia) to (i) take up nitrogen (N), reduce nitrate leaching when sown at four sowing times from 10 Aug to 7 Sep at two sandy loam sites in Denmark (Foulum and Flakkebjerg) during two percolation periods of 2022–23 and 2023–24, and (ii) provide carbon (C) input to the soil at two sowing times at Flakkebjerg in 2023. N uptake and nitrate leaching reduction declined with delayed sowing time. The decline followed different patterns for N uptake and nitrate leaching reduction and varied depending on interactions between species, percolation period, and site. Each day of delayed sowing from 10 Aug to 7 Sep decreased the ability of cover crops to reduce nitrate leaching by 0.5 kg N ha⁻¹ day⁻¹ at Flakkebjerg and 1.2 kg N ha⁻¹ day⁻¹ at Foulum. Overall, fodder radish and phacelia more efficiently reduced leaching at the early sowing times, while fodder radish was most effective at the later sowing times. At Flakkebjerg in 2023, fodder radish accumulated more C than oats and phacelia when sown on 10 Aug. Delaying sowing to 30 Aug reduced total C input from all cover crops by 60 %. These findings can potentially be used for enhancing environmental and climate benefits of cover crops in sustainable cropping system design.","author_count":8,"contributors":["Kumar, Uttam","Engedal, Tine","Hansen, Veronika","Gislum, René","Munkholm, Lars Juhl","Thomsen, Ingrid Kaag","Ugilt Larsen, Søren","Hansen, Elly Møller"],"cuid":["S02-088.00-822740"],"filters":{"added":"2025-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Kumar, Uttam"],"keyword":["Catch crop","Growth characteristics","Percolation period","Soil organic carbon","Sowing time","Sustainability"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"late sowing of cover crops reduces potential for nitrate leaching reduction and carbon inputs","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.agee.2025.109858","version":"Published Version"},"id":"S02-088.00-822740","identifier":[{"id":"105010522319","type":"scopus"}],"ids":["au-d5fd901f-3574-443e-ab15-068310519022","ku-8abd1a1d-cb91-4e79-abe1-c37f9c520de6"],"keyword":["Catch crop","Growth characteristics","Percolation period","Soil organic carbon","Sowing time","Sustainability"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-34C340A7F0335B0732A1C8C4E4975F05"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/459713815/1-s2.0-S0167880925003901-main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.agee.2025.109858","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Agroecology, Department of Agroecology - Soil Fertility"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Plant and Environmental Sciences, Section for Plant and Soil Sciences"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Uttam","key":"kumaruttampau","last":"Kumar","locid":"3f06f9cb-248b-4a42-b2a5-885cbf16399a","name":"Kumar, Uttam","rank":1,"rolecode":"pau"},{"affno":"2","first":"Tine","key":"engedaltinepau","last":"Engedal","locid":"9a8fe5ad-aec7-4563-b512-828b39f86446","name":"Engedal, Tine","orcid":"0000-0002-8641-2078","rank":2,"rolecode":"pau"},{"affno":"2","first":"Veronika","key":"hansenveronikapau","last":"Hansen","locid":"b3169f13-31e3-4030-904e-c63eb05d1762","name":"Hansen, Veronika","orcid":"0000-0003-0090-0984","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"René","key":"gislumrenépau","last":"Gislum","locid":"cad294b9-9707-4ac9-9596-aaae83673a95","name":"Gislum, René","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars J.","key":"munkholmlarsjuhlpau","last":"Munkholm","locid":"26e39f15-e023-4f6f-8cd8-9fed2a266f71","name":"Munkholm, Lars Juhl","name_org":"Munkholm, Lars J.","orcid":"0000-0002-4506-9488","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ingrid K.","key":"thomseningridkaagpau","last":"Thomsen","locid":"d8cdf50c-86be-4cbc-bed1-575a8bdce5da","name":"Thomsen, Ingrid Kaag","name_org":"Thomsen, Ingrid K.","orcid":"0000-0002-5108-5847","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren Ugilt","key":"ugiltlarsensørenpau","last":"Larsen","locid":"6e72b743-5e26-4bcf-880a-16f77e1fc2a8","name":"Ugilt Larsen, Søren","name_org":"Larsen, Søren Ugilt","orcid":"0000-0002-1802-9106","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Elly Møller","key":"hansenellymøllerpau","last":"Hansen","locid":"5c906936-1ec6-4847-8322-c5643841a25a","name":"Hansen, Elly Møller","rank":8,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.agee.2025.109858","issn":["01678809","18732305"],"issn_org":["01678809"],"journal":"Agriculture, Ecosystems & Environment","paperid":"109858","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"p","title":"Agriculture, Ecosystems & Environment","title_org":"Agriculture, Ecosystems and Environment","volume":"393"},"review":"Peer Reviewed","scoID":["2-s2.0-105010522319"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-d5fd901f-3574-443e-ab15-068310519022","ku-8abd1a1d-cb91-4e79-abe1-c37f9c520de6"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Late sowing of cover crops reduces potential for nitrate leaching reduction and carbon inputs","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-088.00-822740","year":"2025","yearsub":"2025"}
{"abstract":"INTRODUCTION AND AIM: Despite global advances in lung cancer treatment, challenges persist in symptom management and supportive care, particularly as the incidence of early-stage diagnoses rises. Patients with non-small cell lung cancer (NSCLC) face symptom burdens compounded by physical, psychological and social factors, alongside the concealment of early-stage symptoms. Research on symptom management in patients with NSCLC remains limited, with a lack of studies exploring patient experiences and clinical management strategies. Moreover, attention to late effects highlights the need for personalised care interventions to address long-term outcomes. The SCAPAS-LungCancer study aims to bridge these gaps by enhancing our understanding of NSCLC symptomatology, late effects and quality of life. The study seeks to identify patients with multiple symptoms and late effects, offering insights for future personalised care interventions to improve patient outcomes and overall well-being. METHODS AND ANALYSIS: The study employs a multiple-methods approach encompassing qualitative and quantitative investigations to comprehensively explore symptomatology, patient experiences and treatment outcomes in patients with NSCLC undergoing surgical treatment. A prospective, longitudinal, observational and exploratory design is adopted. A longitudinal qualitative study, including individual interviews and ethnographic fieldwork, will be conducted to explore patients' experiences and interactions with clinicians on symptoms and late effects. Additionally, consecutive newly diagnosed patients with NSCLC scheduled for surgery will be recruited in a prospective questionnaire study using patient-reported outcomes. Eligible patients will complete self-reported measures assessing physical and psychosocial symptom burden and late effects, quality of life, social support and unmet needs at baseline and multiple follow-up points post-surgery over a 2-year period. Socio-demographic and medical characteristics are also collected. ETHICS AND DISSEMINATION: The study is approved by the Danish Data Protection Agency (journal no: 2022-737) and conducted in accordance with Danish Ethics Research Committee guidelines and the Helsinki II Declaration. Participants will provide written informed consent. The results will be reported in peer-reviewed journals.","author_count":18,"contributors":["Missel, Malene","Langballe, Rikke","Quist, Morten","Donsel, Pernille Orloff","Bidstrup, Pernille E","Huang, Lin","Borregaard, Britt","Stenger, Michael","Andersen, Pernille Brasch","Christensen, Thomas Decker","Corvinius, Camilla","Moons, Johnny","Fehlmann, Florian","Saghir, Zaigham","Dai, Wei","Hansen, Lisbeth Søbæk","Petersen, Rene Horsleben","Schoenau, Mai Nanna"],"cuid":["S02-100.00-804151"],"filters":{"added":"2025-06","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Asia, East","Europe, EU","Europe, Non-EU","OECD"],"corresponding_author":["Missel, Malene"],"country":["Belgium","China","Switzerland"],"glorg":["All Global Affiliations","Sichuan Cancer Hospital and Institute","Universitair Ziekenhuis Leuven","University Children's Hospital Zurich","University of Leuven","University of Zurich"],"keyword":["Carcinoma Non Small Cell Lung surgery","Hospitals","Humans","Longitudinal Studies","Lung Neoplasms surgery","Male","Multicenter Studies as Topic","Nursing Care","Nursing research","Observational Studies as Topic","Person centered care","Prospective Studies","Qualitative Research","Quality of Life","Research Design","Thoracic surgery"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-NP","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR"],"NP":["DI-NP-ALL","DI-NP-CAN"],"OT":["Patient Organization for Lung Cancer"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-NP-CAN","DI-U-AU","DI