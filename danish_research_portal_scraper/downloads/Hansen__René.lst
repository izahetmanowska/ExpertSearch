002-4177-3267","rank":17,"rolecode":"pau"},{"affno":"6 4 5","first":"Kirsten","key":"grønbækpau","last":"Grønbæk","locid":"82ff4ce1-979f-44c9-b095-72c4a3dca507","name":"Grønbæk, Kirsten","rank":18,"rolecode":"pau"},{"affno":"6 2","first":"Ole Birger","key":"pedersenpau","last":"Pedersen","locid":"0d43956a-6e43-42d7-8b29-4505d03ea5c8","name":"Pedersen, Ole Birger","orcid":"0000-0003-2312-5976","rank":19,"rolecode":"pau"}],"pmid":["32541886"],"pub":{"doi":"10.1038/s41598-020-66062-1","issn":["20452322"],"issue":"1","journal":"Scientific Reports","paperid":"9637","publisher":"Nature Publishing Group","status":"p","title":"Scientific Reports","volume":"10"},"review":"Peer Reviewed","scoID":["2-s2.0-85086433900"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Universities","All University Colleges","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","Governmental Institutions","Hospitals","North Denmark Region","Region Zealand","Roskilde University","Universities","University College Absalon","University Colleges","University of Copenhagen"],"PST":["Published"]},"sid":["aau-55e8cf93-3d86-4d7f-b9e0-55de534c0431","au-2d8c7e75-c3ea-48cb-8e76-2308321a54e5","ku-5a0d1e34-c8da-4798-86ef-855860bd8dc6","pha-eb97adb2-0af4-490f-a7ca-c5632122b2b2","ruc-1c7a6535-d14a-4196-9490-a0e5eb39daf3"],"src":["AAU Aalborg University","AB University College Absalon","AU Aarhus University","KU University of Copenhagen","RUC Roskilde University"],"title":"The value of circulating microRNAs for early diagnosis of B-cell lymphoma : A case-control study on historical samples","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S05-099.84-004196","year":"2020","yearsub":"2020"}
{"abstract":"Reduction of bitter taste in protein hydrolysates is a challenging task. The aim of this study was to apply a simple two-step approach to prepare low bitter hydrolysates and investigate the influence of peptide modifications on taste characteristics. Protein hydrolysates were prepared from porcine muscle and plasma through simultaneous hydrolysis using endo- and exo-peptidases combined with peptide glycation by glucosamine (GlcN). Spectroscopic analysis and quantification of major alpha-dicarbonyl compounds (α-DCs) indicated the relatively low extent of Maillard reaction in GlcN-glycated protein hydrolysates. Thermal degradation of high MW peptides (>10 kDa) might play a major role in Maillard reaction, reflected by the formation of more Maillard reacted peptides (1–5 kDa), especially in plasma samples. Sensory evaluation indicated that glycation by GlcN can alter taste profiles of protein hydrolysates, which may be attributed to the formation of Maillard reacted peptides and peptide modifications revealed by LC–MS/MS analysis.","author_count":8,"contributors":["Fu, Yu","Liu, Jing","Zhang, Wei","Wæhrens, Sandra Stolzenbach","Tøstesen, Marie","Hansen, Erik T.","Bredie, Wender","Lametsch, Rene"],"cuid":["S01-000.00-492918"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Bitterness","Exopeptidase","Glucosamine","Maillard reaction","Protein hydrolysates","α Dicarbonyl compounds"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-PR-OTH","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"exopeptidase treatment combined with maillard reaction modification of protein hydrolysates derived from porcine muscle and plasma structure taste relationship","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-492918","identifier":[{"id":"31610331","type":"pmid"},{"id":"85073028178","type":"scopus"}],"ids":["ku-a692ca25-b026-4d8d-a7d6-ba4ffd8583fd"],"keyword":["Bitterness","Exopeptidase","Glucosamine","Maillard reaction","Protein hydrolysates","α-Dicarbonyl compounds"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-860B7A9835CCCEE838DADC36F06C04B3"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Food Science, Ingredient and Dairy Technology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["DAT-Schaub A/S (Biz)"],"nora_code":"DI-PR-OTH","used":1}],"person":[{"affno":"1","first":"Yu","key":"fupau","last":"Fu","locid":"78b8496f-a99e-4885-8d91-27ea518fcc42","name":"Fu, Yu","rank":1,"rolecode":"pau"},{"affno":"1","first":"Jing","key":"liupau","last":"Liu","locid":"ae40fa4a-047e-4bc5-ac67-796eff10ba11","name":"Liu, Jing","rank":2,"rolecode":"pau"},{"affno":"1","first":"Wei","key":"zhangpau","last":"Zhang","locid":"e79fbf3f-9c89-44fc-a156-602c59e9a847","name":"Zhang, Wei","rank":3,"rolecode":"pau"},{"affno":"1","first":"Sandra S.","key":"wæhrenspau","last":"Wæhrens","locid":"b3ea701c-6d2a-4795-b315-3592d1291a5c","name":"Wæhrens, Sandra Stolzenbach","name_org":"Wæhrens, Sandra S.","orcid":"0000-0003-4717-9135","rank":4,"rolecode":"pau"},{"affno":"2","first":"Marie","key":"tøstesenpau","last":"Tøstesen","name":"Tøstesen, Marie","rank":5,"rolecode":"pau"},{"affno":"2","first":"Erik T.","key":"hansenpau","last":"Hansen","name":"Hansen, Erik T.","rank":6,"rolecode":"pau"},{"affno":"1","first":"Wender L. P.","key":"brediepau","last":"Bredie","locid":"1992f1d6-32fd-41e0-91e0-03436e2f7851","name":"Bredie, Wender","name_org":"Bredie, Wender L. P.","orcid":"0000-0001-5145-4131","rank":7,"rolecode":"pau"},{"affno":"1","first":"Rene","key":"lametschpau","last":"Lametsch","locid":"70bd350a-6869-4a4a-b9bc-56a756376784","name":"Lametsch, Rene","orcid":"0000-0002-4189-806X","rank":8,"rolecode":"pau"}],"pmid":["31610331"],"pub":{"doi":"10.1016/j.foodchem.2019.125613","issn":["03088146","18737072"],"issn_org":["03088146"],"journal":"Food Chemistry","paperid":"125613","status":"p","title":"Food Chemistry","volume":"306"},"review":"Peer Reviewed","scoID":["2-s2.0-85073028178"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Other Companies","Private Research","Universities","University of Copenhagen","dat-schaub a/s (biz)"],"PST":["Published"]},"sid":["ku-a692ca25-b026-4d8d-a7d6-ba4ffd8583fd"],"src":["KU University of Copenhagen"],"title":"Exopeptidase treatment combined with Maillard reaction modification of protein hydrolysates derived from porcine muscle and plasma : structure–taste relationship","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-492918","year":"2020","yearsub":"2020"}
{"abstract":"For release of parenteral drug products, bacterial endotoxin testing is one of a panel of necessary tests. In order to ensure the validity of such tests, various controls are performed, including demonstration of compendial method suitability or method qualification. In addition to compendial suitability testing, quality control (QC) sample hold-time studies are requested by authorities like the Food and Drug Administration (FDA) as described in “Guidance for Industry: Pyrogen and Endotoxins Testing.” It is requested to be determine whether the ability to detect endotoxins can be affected by storage and handling of the sample to be tested. To accomplish these studies, endotoxin is introduced or spiked into the undiluted product and held for a certain period of time in process-representative containers. This time period reflects procedural maximum QC sample hold time from sampling until analysis. Inadequate detection of endotoxin can be caused by adsorption of endotoxin to container surfaces or molecular masking effects, in which the binding sites on the endotoxin molecules are prevented from triggering the enzymatic cascade necessary in the assay, are obscured. The endotoxin may form macromolecular structures, such as sheets or blebs, or the binding sites may otherwise be rendered unavailable due to the sample matrix composition. In either case, the endotoxin assay may yield falsely low results if and when masking occurs. In this work, the QC sample hold times of different in-process controls within the production process of a biopharmaceutical product were analyzed. One out of eight different samples showed a strong masking of endotoxin. Analysis of the sample composition revealed that either kifunensine, mycophenolic acid (MPA), or lauryl-N, N-dimethylamine oxide (LDAO) was responsible for masking. Further analysis clearly identified LDAO as the root cause for masking. A novel one-step mechanism for LDAO-induced endotoxin masking is proposed. The principle is similar to an already-proposed two-step mechanism for endotoxin masking, but the LDAO case combines these two steps: the disturbance of the salt bridges and hydrophobic interactions with LPS in one molecule. These molecular interactions occur quickly when both endotoxin and LDAO are present in the same matrix. Thus, depending on the masking agents, low endotoxin recovery (LER) can occur regardless of the QC sample hold duration.","author_count":6,"contributors":["Ørving, René Bech","Carpenter, Bill","Roth, Steffen","Reich, Johannes","Kallipolitis, Birgitte H.","Hansen, Jacob Sonne"],"cuid":["S01-000.00-581038"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","OECD"],"corresponding_author":["Hansen, Jacob Sonne"],"country":["United States"],"glorg":["All Global Affiliations","Biogen Inc."],"keyword":["Endotoxin","LAL","LPS","Ler","Masking"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["FUJIFILM Diosynth Biotechnologies"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"bacterial endotoxin testing fast endotoxin masking kinetics in the presence of lauryldimethylamine oxide","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/microorganisms8111728","version":"Published Version"},"id":"S01-000.00-581038","identifier":[{"id":"33158205","type":"pmid"},{"id":"85095734032","type":"scopus"},{"id":"PMC7694283","type":"pmcid"}],"ids":["sdu-1b592222-73b0-445c-8730-e4958c314661"],"keyword":["Endotoxin","LAL","LDAO","LER","LPS","Lauryldimethylamine oxide","Limulus amoebocyte lysate","Low endotoxin recovery","Masking"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-4DF7CEB80FE4F946F65B2C66B5CE5100"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/174898951/microorganisms_08_01728_v4.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/microorganisms8111728","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["FUJIFILM Diosynth Biotechnologies"],"nora_code":"DI-OT","used":1},{"affno":"2","country":"us","key":"biogen inc","loc":["United States","America, North","OECD"],"name":"Biogen Inc.","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Science, Department of Biochemistry and Molecular Biology"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"René Bech","key":"ørvingpau","last":"Ørving","name":"Ørving, René Bech","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Bill","key":"carpenterpau","last":"Carpenter","name":"Carpenter, Bill","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Steffen","key":"rothpau","last":"Roth","name":"Roth, Steffen","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Johannes","key":"reichpau","last":"Reich","name":"Reich, Johannes","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Birgitte H.","key":"kallipolitispau","last":"Kallipolitis","locid":"642f37f4-0a2d-459b-8092-0f1b21bebb6d","name":"Kallipolitis, Birgitte H.","orcid":"0000-0003-1233-9776","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jacob Sonne","key":"hansenpau","last":"Hansen","name":"Hansen, Jacob Sonne","rank":6,"rolecode":"pau"}],"pmid":["33158205"],"pub":{"doi":"10.3390/microorganisms8111728","issn":["20762607"],"issue":"11","journal":"Microorganisms","pages":"12","paperid":"1728","publisher":"MDPI","status":"p","title":"Microorganisms","volume":"8"},"review":"Peer Reviewed","scoID":["2-s2.0-85095734032"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-1b592222-73b0-445c-8730-e4958c314661"],"src":["SDU University of Southern Denmark"],"title":"Bacterial Endotoxin Testing-Fast Endotoxin Masking Kinetics in the Presence of Lauryldimethylamine Oxide","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-581038","year":"2020","yearsub":"2020"}
{"abstract":"The perspective that the human body is not only an object in the world, but a lived body with feelings and sensations that creates meaning in interaction with the world is emerging in interaction design. Utilising movement as a part of the design process is a new discipline in the field of design. Movement-based design methods (MbDM's) are techniques, procedures or tools that contain movement to stimulate experience, understanding, or creativity within the design process. MbDM can be situated, enacted, context specific or, but not limited to, the use of somaesthetics to gain insights in designing services and products. Although differences exist between these movement-based approaches, they share the commonality of conceptualising physical movement as a material in the design process. Utilising MbDM in a design process can be a daunting task, and with no existing overview of MbDM the development of a practical tool which provides an overview of existing MbDM's and supports the planning of design activities. The aim of this paper is to present a typology of movement-based design methods to be used as a practical tool for designers and facilitators. Through an overarching constructive design research approach, we first did a search in literature and identified seven articles and 23 MbDM. With a phenomenological hermeneutic analysis and critical discussion, we created a typology for mapping identified MbDMs. The 'movement-based design method'-typology consists of two dimensions: 1) seven submediums that stimulate, form or catalyse movement and 2) the type of design stage for which the movement will gain insights. By displaying the 23 identified MbDMs in the typology, a structured overview gives a practical tool for design professionals, practitioners, and educators to plan a design process with movement. By using the typology as a guide, the designer gets an overview of available methods in different mediums and design stages.","author_count":5,"contributors":["Andersen, Rasmus Vestergaard","Lekbo, Søren","Hansen, René Engelhardt","Elbæk, Lars"],"cuid":["S01-000.00-604084"],"event":{"acronym":"ECGBL","end":"2020-09-25","place":"Virtual, Online","start":"2020-09-24","title":"14th European Conference on Game Based Learning, ECGBL 2020","year":"2020"},"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Design","Embodied design methods","Embodiment","Typology"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"movement based design methods a typology for designers","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85096717905","version":"Other Version"},"id":"S01-000.00-604084","identifier":[{"id":"85096717905","type":"scopus"}],"ids":["sdu-6c03b0b7-c807-4fbe-916f-eccc377e1ab2"],"keyword":["Design","Embodied Design Methods","Embodiment","Movement-based interaction design","Typology"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-3-3-5A3B65A62C0C81586EFE60A9064EBE11"],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics, Research Unit of Psychology of Sport, Excellence and Health"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Rasmus Vestergaard","key":"andersenpau","last":"Andersen",