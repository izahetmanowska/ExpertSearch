","name":"Lichtenstein, Mia Beck","orcid":"0000-0002-7885-9187","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Nina","key":"beckhansenpau","last":"Beck Hansen","locid":"9e8ddeb7-5e9f-4dd2-bff8-ea0b98c03257","name":"Beck Hansen, Nina","orcid":"0000-0002-2962-3311","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Niels","key":"bilenbergpau","last":"Bilenberg","locid":"c865af0f-affd-44a4-b9fa-39c26141d3e2","name":"Bilenberg, Niels","orcid":"0000-0002-5838-556X","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"René Klinkby","key":"støvingpau","last":"Støving","locid":"4aab81f6-352f-4c74-82a2-23589beb9fd5","name":"Støving, René Klinkby","orcid":"0000-0002-4255-5544","rank":6,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-73ba3f23-1ce3-4513-b486-d5de69613106"],"src":["SDU University of Southern Denmark"],"title":"Quality of life in eating disorders","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-606323","year":"2013","yearsub":"2013"}
{"abstract":"Safety-Critical Java is designed to be used for safety-critical and hard real-time systems. To ensure predictable behaviour garbage collection has been replaced by a scope based memory model. This model currently requires bounds on memory usage of scopes to be specified by developers. These bounds have to be strict worst-case memory bounds to ensure correct behaviour of these systems. Currently, common methods are measurement based or by careful inspection of the applications Java bytecode. Not only is this a cumbersome approach it is also potentially unsafe. In this paper we present a worst-case memory consumption tool for Safety-Critical Java and evaluate it on existing usecases and a new usecase building on the Cubesat Space Protocol.","author_count":4,"contributors":["Andersen, Jeppe Lunde","Todberg, Mikkel","Dalsgaard, Andreas Engelbredt","Hansen, Rene Rydhof"],"cuid":["S01-000.00-099301"],"event":{"acronym":"JTRES","end":"2013-10-10","place":"Karlsruhe, de","start":"2013-10-09","title":"The 11th International Workshop on Java Technologies for Real-Time and Embedded Systems","year":"2013"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"worst case memory consumption analysis for scj","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1145/2512989.2513000","version":"Other Version"},"id":"S01-000.00-099301","identifier":[{"id":"84887351231","type":"scopus"}],"ids":["aau-a9c9b94a-ee57-45e9-9f04-9433f3fa0168"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-30E7E29F19C973F9D850480C68665457"],"oa_link":[{"access":"oa","type":"rem","url":"http://dl.acm.org/