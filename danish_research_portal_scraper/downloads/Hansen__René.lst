ffno":"5","corresponding":null,"first":"Roald","key":"bahrpau","last":"Bahr","name":"Bahr, Roald","rank":12,"rolecode":"pau"},{"affno":"1 2","first":"Michael","key":"kjærpau","last":"Kjær","locid":"7937b8ab-7820-4d25-982f-1d2f58b033a3","name":"Kjaer, Michael","name_org":"Kjær, Michael","rank":13,"rolecode":"pau"},{"affno":"1 2","first":"Christian","key":"couppépau","last":"Couppé","locid":"cad96e2a-ff10-4b12-a6a7-276468235915","name":"Couppé, Christian","rank":14,"rolecode":"pau"}],"pmid":["39358891"],"pub":{"doi":"10.1111/sms.14732","issn":["09057188","16000838"],"issn_org":["09057188"],"issue":"10","journal":"Scandinavian Journal of Medicine & Science in Sports","paperid":"e14732","status":"p","title":"Scandinavian Journal of Medicine & Science in Sports","title_org":"Scandinavian Journal of Medicine and Science in Sports","volume":"34"},"review":"Peer Reviewed","scoID":["2-s2.0-85205527926"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","All University Colleges","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","Hospitals","Miscellaneous","Other Research","Universities","University College Absalon","University Colleges","University of Copenhagen"],"PST":["Published"]},"sid":["ku-c0b8c695-c778-4ad3-9301-1d51e9b15cdc","pha-3f900ba9-ab25-432d-aad4-aa546f1cceca"],"src":["AB University College Absalon","KU University of Copenhagen"],"title":"Clinical and Imaging Outcomes Over 12 Weeks in Elite Athletes With Early-Stage Tendinopathy","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.70-769198","year":"2024","yearsub":"2024"}
{"abstract":"Introduction The use of routine postoperative chest drains after video-assisted thoracoscopic surgery (VATS) of the lung is a practice based on tradition with the aim of draining fluid and air. However, new evidence suggests that chest drains can be avoided in selected cases. With this randomised controlled trial, we wish to establish the efficacy and safety of avoiding postoperative chest drains compared with routine postoperative chest drains. Methods and analysis This is a two-centre randomised controlled trial without allocation concealment, but where randomisation occurs after the end of procedure leaving operative personnel blinded during surgery. The sample size is calculated to show a difference in pain measurements using the Numeric Rating Scale under different circumstances and at different time points to show superiority of the intervention. The trial is pragmatic by design to reflect the daily clinical scenario and with the aim of increasing the external validity of the results. Ethics and dissemination Approval by the local ethics committees has been obtained for both sites. The study was registered with ClinicalTrials.gov (NCT05358158) prior to inclusion. The results of the trial will be disseminated by publication in an international journal and presentation at major international thoracic surgical meetings. Article summary This is a randomised controlled trial estimating the effects of avoiding a chest drain after VATS wedge resection of the lung on pain, total morphine use, quality of life and complications.","author_count":7,"contributors":["Holbek, Bo Laksáfoss","Huang, Lin","Christensen, Thomas Decker","Bendixen, Morten","Hansen, Henrik Jessen","Kehlet, Henrik","Petersen, Rene Horsleben"],"cuid":["S02-099.79-724637"],"filters":{"added":"2024-05","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"efficacy of avoiding chest drains after video assisted thoracoscopic surgery wedge resection protocol for a randomised controlled trial","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/bmjopen-2023-080573","version":"Published Version"},"id":"S02-099.79-724637","identifier":[{"id":"PMC10882330","type":"pmcid"},{"id":"85185770590","type":"scopus"},{"id":"38382951","type":"pmid"}],"ids":["au-5ce72a16-4090-47de-81c6-00dab62e207d","ku-47c6a9ad-2aaf-454d-a8a7-320e2bb496ac"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-164D1A6B854073CEFD33BA32047A62BE"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/bmjopen-2023-080573","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://curis.ku.dk/ws/files/384867084/e080573.full.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["National Hospital of Denmark"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Cardiothoracic and Vascular Surgery"],"nora_code":"DI-U-AU","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Surgery"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Bo Laksáfoss","key":"holbekpau","last":"Holbek","name":"Holbek, Bo Laksáfoss","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lin","key":"huangpau","last":"Huang","name":"Huang, Lin","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Thomas Decker","key":"christensenpau","last":"Christensen","locid":"2009faa4-0e51-4b44-8dbf-680fe78b786b","name":"Christensen, Thomas Decker","orcid":"0000-0001-6509-8510","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Morten","key":"bendixenpau","last":"Bendixen","locid":"c9369334-4c11-45bf-95b8-84880f93f381","name":"Bendixen, Morten","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik Jessen","key":"hansenpau","last":"Hansen","name":"Hansen, Henrik Jessen","rank":5,"rolecode":"pau"},{"affno":"1 3","first":"Henrik","key":"kehletpau","last":"Kehlet","locid":"0a3c43a0-a0c5-4a91-85d6-6e80e16af8b5","name":"Kehlet, Henrik","orcid":"0000-0002-2209-1711","rank":6,"rolecode":"pau"},{"affno":"1 3","first":"Rene Horsleben","key":"petersenpau","last":"Petersen","locid":"aa18983b-8811-4b3a-a7bd-b439cc52d3e3","name":"Petersen, René Horsleben","name_org":"Petersen, Rene Horsleben","orcid":"0000-0002-3586-1869","rank":7,"rolecode":"pau"}],"pmid":["38382951"],"pub":{"doi":"10.1136/bmjopen-2023-080573","issn":["20446055"],"issue":"2","journal":"BMJ Open","paperid":"e080573","publisher":"BMJ Publishing Group","status":"p","title":"BMJ Open","volume":"14"},"review":"Peer Reviewed","scoID":["2-s2.0-85185770590"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-5ce72a16-4090-47de-81c6-00dab62e207d","ku-47c6a9ad-2aaf-454d-a8a7-320e2bb496ac"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Efficacy of avoiding chest drains after video-assisted thoracoscopic surgery wedge resection : protocol for a randomised controlled trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.79-724637","year":"2024","yearsub":"2024"}
{"abstract":"AIMS/HYPOTHESIS: Anorexia Nervosa (AN) is a severe psychiatric disorder of an unknown etiology with a crude mortality rate of about 5 % per decade, making it one of the deadliest of all psychiatric illnesses. AN is broadly classified into two main subtypes, restricting and binge/purging disorder. Despite extensive research efforts during several decades, the underlying pathophysiology of AN remains poorly understood. In this study, we aimed to identify novel protein biomarkers for AN by performing a proteomics analysis of fasting plasma samples from 78 females with AN (57 restrictive and 21 binge/purge type) and 70 healthy controls. METHODS: Using state-of-the-art mass spectrometry-based proteomics technology in conjunction with an advanced bioinformatics pipeline, we quantify >500 plasma proteins. RESULTS: Differential expression analysis and correlation of proteomics data with clinical variables led to identification of a panel of novel protein biomarkers with potential pathophysiological significance for AN. Our findings demonstrate evidence of a humoral immune system response, altered lipid metabolism and potential alteration of plasma cells in AN patients. Additionally, we stratified AN patients based on the quantified proteins and suggest a potential autoimmune nature in the restrictive subtype of AN. CONCLUSIONS/INTERPRETATION: In summary, on top of biomarkers of AN subtypes, this study provides a comprehensive map of plasma proteins that constitute a resource for further studies of the pathophysiology of AN.","author_count":9,"contributors":["Samodova, Diana","Hoel, August","Hansen, Tue Haldor","Clausen, Loa","Telléus, Gry Kjærsdam","Marti, Hans-Peter","Pedersen, Oluf","Støving, Rene Klinkby","Deshmukh, Atul Shahaji"],"cuid":["S04-093.68-724163"],"filters":{"added":"2024-02","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":4,"continent":["Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Deshmukh, Atul Shahaji","Støving, Rene Klinkby"],"country":["Norway"],"glorg":["All Global Affiliations","Haukeland University Hospital","University of Bergen"],"keyword":["Anorexia nervosa","Coagulation","Immunoglobulin","Lipoprotein","Proteomics","Subtype"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-SDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-SDR","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"plasma proteome profiling reveals metabolic and immunologic differences between anorexia nervosa subtypes","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.metabol.2023.155760","version":"Published Version"},"funding_acknowledgement":["This work was supported by Novo Nordisk Foundation Center for Basic Metabolic Research at the University of Copenhagen [grant number NNF14CC0001 ] and European Foundation for the Study of Diabetes (EFSD) [grant number NNF19SA058976 ]."],"id":"S04-093.68-724163","identifier":[{"id":"85180311452","type":"scopus"},{"id":"38104923","type":"pmid"}],"ids":["aau-5ded36fc-293f-452c-bc55-7ec3759d8002","au-84504f65-4e4c-460a-9e1a-138fbd7ee925","ku-274a2ec8-2733-4639-a0dd-edc966dd0e5f","sdu-16fa74e1-622b-4320-8fd5-62314d9688e0"],"keyword":["Anorexia Nervosa","Coagulation","Immunoglobulin","Lipoprotein","Proteomics","Subtype"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-7-2E2066A1C7336B8F653C3F43121B0674"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/254584018/1-s2.0-S0026049523003645-main.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.metabol.2023.155760","version