{"author_count":6,"contributors":["Ruwald, Martin H.","Johannessen, Arne","Hansen, Morten Lock","Haugdal, Martin","Worck, Rene","Hansen, Jim"],"cuid":["S01-000.00-749120"],"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"utility of high density 000000000003d bipolar voltage map after pulmonary vein isolation by pulsed field ablation","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-749120","identifier":[{"id":"36752456","type":"pmid"},{"id":"85147716129","type":"scopus"}],"ids":["ku-c8913028-929a-4cdf-9320-57d098d77b21"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-45627DEC1EE47E302D53825C82135C0B"],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Herlev and Gentofte"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal medicine: Cardiology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Martin H.","key":"ruwaldmartinhpau","last":"Ruwald","name":"Ruwald, Martin H.","rank":1,"rolecode":"pau"},{"affno":"1","first":"Arne","key":"johannessenarnepau","last":"Johannessen","name":"Johannessen, Arne","rank":2,"rolecode":"pau"},{"affno":"1 2","first":"Morten Lock","key":"hansenmortenlockpau","last":"Hansen","locid":"870786a1-f42f-40fa-b820-1608236b578c","name":"Hansen, Morten Lock","rank":3,"rolecode":"pau"},{"affno":"1","first":"Martin","key":"haugdalmartinpau","last":"Haugdal","name":"Haugdal, Martin","rank":4,"rolecode":"pau"},{"affno":"1","first":"Rene","key":"worckrenepau","last":"Worck","name":"Worck, Rene","rank":5,"rolecode":"pau"},{"affno":"1","first":"Jim","key":"hansenjimpau","last":"Hansen","name":"Hansen, Jim","rank":6,"rolecode":"pau"}],"pmid":["36752456"],"pub":{"doi":"10.1016/j.jacep.2022.11.030","issn":["2405500X"],"issue":"4","journal":"JACC: Clinical Electrophysiology","pages":"588-590","status":"p","title":"JACC: Clinical Electrophysiology","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-85147716129"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-c8913028-929a-4cdf-9320-57d098d77b21"],"src":["KU University of Copenhagen"],"title":"Utility of High-Density 3D-Bipolar Voltage Map After Pulmonary Vein Isolation by Pulsed-Field Ablation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-749120","year":"2023","yearsub":"2023"}
{"abstract":"AIMS: Overweight is associated with increased risk of atrial fibrillation (AF), but the impact of overweight and AF recurrence after ablation is less clear. Despite this, an increasing number of AF ablations are carried out in overweight patients. We investigated the impact of body mass index (BMI) on AF recurrence rates after ablation. METHODS AND RESULTS: Through Danish nationwide registers, all patients undergoing first-time AF ablation between 2010 and 2018 were identified. Exposure of interest was BMI. The primary outcome was recurrent AF, defined from either any usage of antiarrhythmic medication, AF hospitalization, cardioversion, or re-ablation. A total of 9188 patients were included. Median age and interquartile range was 64 (60-75) in the normal-weight group and 60 (53-66) in the morbidly obese. There was an increase in comorbidity burden with increasing BMI, including a higher prevalence of heart failure, chronic obstructive pulmonary disease, diabetes, and hypertension. At 1- and 5-year follow ups, recurrence rates of AF increased incrementally by BMI categories. The hazard ratios and 95% confidence intervals of recurrent AF after ablation were 1.15 (1.07-1.23), 1.18 (1.09-1.28), and 1.26 (1.13-1.41) in overweight, obese, and morbidly obese, respectively, compared with normal-weight patients. Procedure duration and X-ray dose exposure also increased with increasing BMI. CONCLUSION: Following AF ablation, recurrence rates of AF increased incrementally with increasing BMI. Therefore, aggressive weight management pre ablation in overweight patients could potentially provide substantial benefits and improve short- and long-term outcomes after ablation.","author_count":14,"contributors":["Tonnesen, Jacob","Pallisgaard, Jannik","Ruwald, Martin H.","Rasmussen, Peter Vibe","Johannessen, Arne","Hansen, Jim","Worck, Rene Husted","Zorner, Christopher R.","Riis-Vestergaard, Lise","Middelfart, Charlotte","Gislason, Gunnar","Hansen, Morten Lock"],"cuid":["S02-096.69-686266"],"filters":{"added":"2023-04","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Tonnesen, Jacob"],"keyword":["Ablation","Atrial Fibrillation diagnosis","Atrial fibrillation","Body Mass Index","Catheter Ablation adverse effects","Cohort Studies","Denmark epidemiology","Humans","Obesity Morbid complications","Overweight etiology","Recurrence","Recurrence of atrial fibrillation","Risk Factors","Treatment Outcome"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-NP","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"NP":["DI-NP-ALL","DI-NP-HJER"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-NP-HJER","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"short and long term risk of atrial fibrillation recurrence after first time ablation according to body mass index a nationwide danish cohort study","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1093/europace/euac225","version":"Published Version"},"id":"S02-096.69-686266","identifier":[{"id":"36480430","type":"pmid"},{"id":"85148306943","type":"scopus"},{"id":"PMC9935003","type":"pmcid"}],"ids":["ku-656b5bba-9c8f-4c9e-9847-7f39b0099b02","sdu-9b25e7cd-a0e0-41e9-9d36-e93601aa914f"],"keyword":["Ablation","Atrial Fibrillation/diagnosis","Atrial fibrillation","Body mass index","Catheter Ablation/adverse effects","Cohort Studies","Denmark/epidemiology","Humans","Obesity, Morbid/complications","Overweight/etiology","Recurrence","Recurrence of atrial fibrillation","Risk Factors","Treatment Outcome"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-5765C463605A7DA954FBAA23B219E42A"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://curis.ku.dk/ws/files/366507784/euac225.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/222804233/euac225.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1093/europace/euac225","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Herlev and Gentofte"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, National Institute of Public Health"],"nora_code":"DI-U-SDU","used":1},{"affno":"4","country":"dk","key":"danish heart foundation","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-HJER","l3nn":"Danish Heart Foundation","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Danish Heart Foundation","namevar":["Hjerteforeningen"],"nora_code":"DI-NP-HJER","used":1}],"person":[{"affno":"1 2","first":"Jacob","key":"tønnesenjacobpau","last":"Tønnesen","locid":"fd9c3644-6d05-427b-bbcc-4b4ecbc79f11","name":"Tønnesen, Jacob","rank":1,"rolec