tmannpau","last":"Rottmann","locid":"16e7c8cc-cee3-43aa-8651-e2a1414f2426","name":"Rottmann, Nina","orcid":"0000-0002-7262-6788","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"René dePont","key":"christensenpau","last":"Christensen","locid":"3f33c4f0-abcb-42c6-85af-2d24bcf025ff","name":"Christensen, René dePont","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-01e2672b-9178-448d-ad6c-1fbdafaf9675"],"src":["SDU University of Southern Denmark"],"title":"Shared understanding of the woman’s well-being in couples coping with breast cancer : Couple congruence and association with sociodemographic factors and depressive symptoms.","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-573787","year":"2018","yearsub":"2018"}
{"abstract":"Protein degradation, rheological properties, sensory properties and the aroma profile of soft brined cheese made from camel milk using two levels of coagulant (camel chymosin) [55 and 85 International Milk Clotting Units (IMCU) L−1] and two levels of brine (2% or 5% NaCl, w/w) were investigated over a ripening period of 60 d. Casein degradation in soft brined camel milk cheese significantly (p <0.05) increased during ripening and with increase of coagulant level. Young's modulus and stress at fracture significantly (p <0.05) increased with increasing level of salt in moisture in the cheese during ripening. However, cheese made with 85 IMCU L−1 coagulant resulted in softening of cheese texture and higher salt uptake. Using descriptive sensory analysis, the experimental cheeses were described as salty, sour and firm. The volatile aroma compounds formed in soft ripened camel milk cheese are affected by ripening time, and coagulant and NaCl levels.","author_count":8,"contributors":["Hailu, Yonas","Hansen, Egon Bech","Seifu, Eyassu","Eshetu, Mitiku","Petersen, Mikael Agerlin","Lametsch, Rene","Rattray, Fergal","Ipsen, Richard"],"cuid":["S02-095.24-032896"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Africa"],"corresponding_author":["Hailu, Yonas"],"country":["Botswana","Ethiopia"],"glorg":["All Global Affiliations","Botswana College of Agriculture","Haramaya University","University of Botswana"],"keyword":["Aroma compounds","Camel chymosin","Chemical Operations","Chlorine compounds","Coagulation","Descriptive sensory analysis","Elastic moduli","Materials science","Odors","Protein degradation","Rheological property","Sensory analysis","Sensory properties","Sodium Chloride","Volatile aroma compounds"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"rheological and sensory properties and aroma compounds formed during ripening of soft brined cheese made from camel milk","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/145165159/ansa_1_s2.0_S0958694618300311_main.pdf","version":"Authors Final Version"},"id":"S02-095.24-032896","identifier":[{"id":"85042903087","type":"scopus"}],"ids":["dtu-0d7fd310-82eb-498a-9bb4-df3c133ebdff","ku-b6ed3a9d-2daf-478a-afda-af0044d1dbf6"],"keyword":["Aroma compounds","Camel chymosin","Chemical Operations","Chlorine compounds","Coagulation","Descriptive sensory analysis","Elastic moduli","Materials Science","Odors","Protein degradation","Rheological property","Ripening periods","Sensory analysis","Sensory properties","Sodium chloride","Volatile aroma compounds"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-0A6BCBBD4760E538A833671F5F7B4048"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/145165159/ansa_1_s2.0_S0958694618300311_main.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Food Science, Ingredient and Dairy Technology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Food Institute","Technical University of Denmark, National Food Institute, Research Group for Gut Microbiology and Immunology"],"nora_code":"DI-U-DTU","used":1},{"affno":"3","country":"bw","key":"university of botswana","loc":["Botswana","Africa"],"name":"University of Botswana","used":1},{"affno":"4","country":"bw","key":"botswana college of agriculture","loc":["Botswana","Africa"],"name":"Botswana College of Agriculture","used":1},{"affno":"5","country":"et","key":"haramaya university","loc":["Ethiopia","Africa"],"name":"Haramaya University","used":1}],"person":[{"affno":"1","first":"Yonas Hailu","key":"alemupau","last":"Alemu","locid":"fb276559-b291-478e-a18a-4da4cf05bd11","name":"Alemu, Yonas Hailu","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Egon Bech","key":"hansenpau","last":"Hansen","locid":"32db061a-9661-42a0-964c-84f1cd4aed29","name":"Hansen, Egon Bech","orcid":"0000-0002-3795-6706","rank":2,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Eyassu","key":"seifupau","last":"Seifu","name":"Seifu, Eyassu","rank":3,"rolecode":"pau"},{"affno":"1","first":"Mikael Agerlin","key":"petersenpau","last":"Petersen","locid":"9f4065a7-ea41-4357-b2ca-73903fd418c0","name":"Petersen, Mikael Agerlin","orcid":"0000-0002-4106-7696","rank":4,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Mitiku","key":"eshetupau","last":"Eshetu","name":"Eshetu, Mitiku","rank":4,"rolecode":"pau"},{"affno":"1","first":"Rene","key":"lametschpau","last":"Lametsch","locid":"70bd350a-6869-4a4a-b9bc-56a756376784","name":"Lametsch, Rene","orcid":"0000-0002-4189-806X","rank":5,"rolecode":"pau"},{"affno":"1","first":"Fergal Patrick","key":"rattraypau","last":"Rattray","locid":"5b244471-7a83-4ec9-baae-0101a19006d4","name":"Rattray, Fergal Patrick","orcid":"0000-0002-1987-7967","rank":6,"rolecode":"pau"},{"affno":"1","first":"Richard","key":"ipsenpau","last":"Ipsen","locid":"475595e7-f9c8-4d9a-a030-911cd731929c","name":"Ipsen, Richard","orcid":"0000-0003-2658-414X","rank":7,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.idairyj.2018.01.007","issn":["09586946","18790143"],"issn_org":["09586946"],"journal":"International Dairy Journal","pages":"122-130","publisher":"Elsevier","status":"p","title":"International Dairy Journal","volume":"81"},"review":"Peer Reviewed","scoID":["2-s2.0-85042903087"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-0d7fd310-82eb-498a-9bb4-df3c133ebdff","ku-b6ed3a9d-2daf-478a-afda-af0044d1dbf6"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Rheological and sensory properties and aroma compounds formed during ripening of soft brined cheese made from camel milk","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-095.24-032896","year":"2018","yearsub":"2018"}
{"abstract":"Background: Competence in video-assisted thoracoscopic surgery lobectomy has previously been established on the basis of numbers of procedures performed, but this approach does not ensure competence. Specific assessment tools, such as the newly developed video-assisted thoracoscopic surgery lobectomy assessment tool, allow for structured and objective assessment of competence. Our aim was to provide validity evidence for the video-assisted thoracoscopic surgery lobectomy assessment tool. Methods: Video recordings of 60 video-assisted thoracoscopic surgery lobectomies performed by 18 thoracic surgeons were rated using the video-assisted thoracoscopic surgery lobectomy assessment tool. All 4 centers of thoracic surgery in Denmark participated in the study. Two video-assisted thoracoscopic surgery experts rated the videos. They were blinded to surgeon and center. Results: The total internal consistency reliability Cronbach's alpha was 0.93. Inter-rater reliability between the 2 raters was Pearson's r = 0.71 (P <.001). The mean video-assisted thoracoscopic surgery lobectomy assessment tool scores for the 10 procedures performed by beginners were 22.1 (standard deviation [SD], 8.6) for the 28 procedures performed by the intermediate surgeons, 31.2 (SD, 4.4), and for the 20 procedures performed by experts 35.9 (SD, 2.9) (P <.001). Bonferroni post hoc tests showed that experts were significantly better than intermediates (P <.008) and beginners (P <.001). Intermediates’ mean scores were significantly better than beginners (P <.001). The pass/fail standard calculated using the contrasting group's method was 31 points. One of the beginners passed, and 2 experts failed the test. Conclusions: Validity evidence was provided for a newly developed assessment tool for video-assisted thoracoscopic surgery lobectomy (video-assisted thoracoscopic surgery lobectomy assessment tool) in a clinical setting. The discriminatory ability among expert surgeons, intermediate surgeons, and beginners proved highly significant. The video-assisted thoracoscopic surgery lobectomy assessment tool could be an important aid in the future training and certification of thoracic surgeons.","author_count":6,"contributors":["Petersen, René Horsleben","Gjeraa, Kirsten","Jensen, Katrine","Møller, Lars Borgbjerg","Hansen, Henrik Jessen","Konge, Lars"],"cuid":["S02-099.95-009422"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Assessment tool","Education","Learning","Lobectomy","VATS","Video assisted thoracoscopic surgery"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"OT":["Copenhagen Academy for Medical Education and Simulation (CAMES), University of Copenhagen and Capital Region of Denmark, Copenhagen, Denmark."],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-AAU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"assessment of competence in video assisted thoracoscopic surgery lobectomy a danish nationwide study","src":["aau","ku"],"src-code":["DI-U-AAU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/295088319/Assessment_of_competence_in_Video_Assisted_Thora_2018_The_Journal_of_Thoraci.pdf","version":"Authors Final Version"},"id":"S02-099.95-009422","identifier":[{"id":"29773444","type":"pmid"},{"id":"85047088534","type":"scopus"}],"ids":["aau-c3f6b8d2-fc20-40e6-9727-d4e57e4846a4","ku-130fdbca-1abd-44de-9bab-601755d79226"],"keyword":["VATS","assessment tool","education","learning","lobectomy","video-assisted thoracoscopic surgery"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-08419F417E735DD4E937033546F1FE53"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/295088319/Assessment_of_competence_in_Video_Assisted_Thora_2018_The_Journal_of_Thoraci.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Cardiothoracic Surgery","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Rigshospitalet, Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Copenhagen Academy for Medical Education and Simulation (CAMES), University of Copenhagen and Capital Region of Denmark, Copenhagen, Denmark."],"nora_code":"DI-OT","used":1},{"affno":"4","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Anæstesi, B