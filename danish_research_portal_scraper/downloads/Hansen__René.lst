e":"Rasmussen, Torben Valdbjørn","rank":16,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Niels-Jørgen","key":"aagaardnielsjørgenpau","last":"Aagaard","locid":"8849ede5-0d46-45c4-b8fe-2e4f06f65e3e","name":"Aagaard, Niels-Jørgen","orcid":"0000-0002-3230-5533","rank":17,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Birgit","key":"rasmussenbirgitpau","last":"Rasmussen","name":"Rasmussen, Birgit","rank":18,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kjeld","key":"johnsenkjeldpau","last":"Johnsen","name":"Johnsen, Kjeld","rank":19,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Niels Christian","key":"bergsøenielschristianpau","last":"Bergsøe","name":"Bergsøe, Niels Christian","rank":20,"rolecode":"pau"}],"pub":{"eisbn":["9788756318723"],"isbn":["9788756318709"],"publisher":"Statens Byggeforskningsinstitut","status":"p"},"review":"No Review","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-f46fe2bb-d39c-4f02-bf2c-b19347f27a27"],"src":["DTU Technical University of Denmark"],"title":"Anvisning om Bygningsreglement 2018","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-789490","year":"2018","yearsub":"2018"}
{"abstract":"BACKGROUND: Additional prognostic markers are needed for better treatment stratification of stage II colon cancer (CC). We investigated the prognostic value of tumor-infiltrating lymphocytes (TILs) in a true population-based cohort of patients with stage II CC. MATERIAL AND METHODS: A total of 573 patients were included. Tumor blocks representing the deepest invasive part of the primary tumor were used for analysis. CD3+ and CD8+ TILs at the invasive front were evaluated by immunohistochemistry on whole tumor sections. The invasive area was manually outlined, and Visiopharm Integrator System software was used for quantification. Data were dichotomized for comparison with clinical data. The prognostic value was investigated in Cox proportional-hazard models for recurrence-free survival (RFS) and overall survival (OS). RESULTS: Low CD3+ or CD8+ TILs were significantly associated with poor RFS and OS (P = .0021 and P ≤ .0009, respectively, log-rank test). In multiple Cox regression analysis, low CD3+ and CD8+ TILs were associated with reduced RFS with hazard ratio (HR) = 1.386 (95% CI 1.039-1.850), P = .026, and HR = 1.394 (95% CI 1.029-1.890), P = .032, respectively, independent of age, T-stage, localization, perforation, and microsatellite instability (MSI). In the subgroups of patients with low CD3+ or CD8+ TILs, there was no difference in survival between patients with MSI and microsatellite-stable tumors, (P = .821 and P = .907, respectively). CONCLUSION: Low CD3+ and CD8+ TILs in the invasive area are both related to inferior prognosis of stage II CC, and we recommend either of these parameters to be considered as additional high-risk factor.","author_count":7,"contributors":["Eriksen, Ann C","Sørensen, Flemming Brandt","Lindebjerg, Jan","Hager, Henrik","dePont Christensen, René","Kjær-Frifeldt, Sanne","Hansen, Torben F"],"cuid":["S02-087.69-028277"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Eriksen, Ann Christina"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR","DI-HO-OTH","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-CDR","DI-HO-OTH","DI-HO-SDR","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"the prognostic value of tumor infiltrating lymphocytes in stage ii colon cancer a nationwide population based study","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.tranon.2018.03.008","version":"Published Version"},"id":"S02-087.69-028277","identifier":[{"id":"29940413","type":"pmid"},{"id":"PMC6039294","type":"pmcid"},{"id":"85048868222","type":"scopus"}],"ids":["au-d74f4797-dac0-45c5-b139-82ffc0b38876","sdu-5aba9a79-c037-4ecb-8408-cde422b939db"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-4F8B0C87C63CD9B39917F30410C2D166"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/141683560/The_Prognostic_Value_of_Tumor_Infiltrating_lymphocytes_in_Stage_II_Colon_Cancer._A_Nationwide_Population_Based_Study.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.tranon.2018.03.008","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Regional Health Research","SDU, The