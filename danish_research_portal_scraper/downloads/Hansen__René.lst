sen, Ole Birger","orcid":"0000-0003-2312-5976","rank":16,"rolecode":"pau"},{"affno":"8 1 10","first":"Henrik","key":"hjalgrimpau","last":"Hjalgrim","locid":"ae40e66a-f263-444f-877f-838370aec64a","name":"Hjalgrim, Henrik","rank":17,"rolecode":"pau"},{"affno":"8","first":"Karina","key":"banasikpau","last":"Banasik","locid":"aa036e1f-a1ec-4d22-b444-e4f9c0406cdc","name":"Banasik, Karina","orcid":"0000-0003-2489-2499","rank":18,"rolecode":"pau"},{"affno":"8","first":"Kristoffer S.","key":"burgdorfpau","last":"Burgdorf","locid":"20eca921-0d38-4a10-be04-ca296da84982","name":"Burgdorf, Kristoffer Sølvsten","name_org":"Burgdorf, Kristoffer S.","orcid":"0000-0001-5814-6844","rank":19,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"country":"dk","first":"Mette","key":"nyegaardpau","last":"Nyegaard","locid":"c048a688-cd64-40ca-a277-53f16360f7a1","name":"Nyegaard, Mette","orcid":"0000-0003-4973-8543","rank":20,"rolecode":"pau"},{"affno":"8 1","first":"Jes","key":"olesenpau","last":"Olesen","locid":"c5fe564b-1354-4d3c-8173-9778df35d33f","name":"Olesen, Jes","rank":21,"rolecode":"pau"},{"affno":"8","first":"Thomas Folkmann","key":"hansenpau","last":"Hansen","locid":"269f0fae-73d8-4f22-9963-a1306b7465f1","name":"Hansen, Thomas Folkmann","orcid":"0000-0001-6703-7762","rank":22,"rolecode":"pau"}],"pmid":["36905094"],"pub":{"doi":"10.1111/ene.15778","issn":["13515101","14681331"],"issn_org":["13515101"],"issue":"6","journal":"European Journal of Neurology","pages":"1774-1784","publisher":"Wiley-Blackwell Publishing Ltd","status":"p","title":"European Journal of Neurology","volume":"30"},"review":"Peer Reviewed","scoID":["2-s2.0-85151278558"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","North Denmark Region","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-e2ca207e-4996-437f-abf7-2b98fdba2537","au-4a9ed09e-521e-482b-8dcf-4a0218333030","ku-e0c58376-97fe-4450-94de-c4123b547baa","sdu-dc805be2-8d21-4cc1-bc4e-0454503f5ff0"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Sex differences in clinical characteristics of migraine and its burden: A population-based study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-100.00-672477","year":"2023","yearsub":"2023"}
{"abstract":"BACKGROUND: Accurate blood type data are essential for blood bank management, but due to costs, few of 43 blood group systems are routinely determined in Danish blood banks. However, a more comprehensive dataset of blood types is useful in scenarios such as rare blood type allocation. We aimed to investigate the viability and accuracy of predicting blood types by leveraging an existing dataset of imputed genotypes for two cohorts of approximately 90,000 each (Danish Blood Donor Study and Copenhagen Biobank) and present a more comprehensive overview of blood types for our Danish donor cohort. STUDY DESIGN AND METHODS: Blood types were predicted from genome array data using known variant determinants. Prediction accuracy was confirmed by comparing with preexisting serological blood types. The Vel blood group was used to test the viability of using genetic prediction to narrow down the list of candidate donors with rare blood types. RESULTS: Predicted phenotypes showed a high balanced accuracy >99.5% in most cases: A, B, C/c, Coa /Cob , Doa /Dob , E/e, Jka /Jkb , Kna /Knb , Kpa /Kpb , M/N, S/s, Sda , Se, and Yta /Ytb , while some performed slightly worse: Fya /Fyb , K/k, Lua /Lub , and Vel ~99%-98% and CW and P1 ~96%. Genetic prediction identified 70 potential Vel negatives in our cohort, 64 of whom were confirmed correct using polymerase chain reaction (negative predictive value: 91.5%). DISCUSSION: High genetic prediction accuracy in most blood groups demonstrated the viability of generating blood types using preexisting genotype data at no cost and successfully narrowed the pool of potential individuals with the rare Vel-negative phenotype from 180,000 to 70.","author_count":26,"contributors":["Moslemi, Camous","Sækmose, Susanne G.","Larsen, Rune","Bay, Jakob T.","Brodersen, Thorsten","Didriksen, Maria","Hjalgrim, Henrik","Banasik, Karina","Nielsen, Kaspar René","Bruun, Mie T.","Dowsett, Joseph","Dinh, Khoa M.","Mikkelsen, Susan","Mikkelsen, Christina","Hansen, Thomas F.","Ullum, Henrik","Erikstrup, Christian","Brunak, Søren","Krogfelt, Karen Angeliki","Storry, Jill R.","Ostrowski, Sisse R.","Olsson, Martin L.","Pedersen, Ole B."],"cuid":["S05-099.93-715668"],"filters":{"added":"2023-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":"5+","continent":["Europe, EU","Nordic","OECD"],"corresponding_author":["Moslemi, Camous"],"country":["Sweden"],"glorg":["All Global Affiliations","Lund University","Office for Medical Services","Region Skåne"],"keyword":["ABO","Blood groups","Danish blood type rates","Danish population","Denmark","Diego","Dombrock","Duffy","Kell","Kidd","Knops","Lewis","Lutheran","MNS","P1PK","Rh","Secretor","Vel","Yt","blood group systems","donor blood typing","erythrocyte antigens","genetic blood typing"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-NP","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA"],"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-RUC","DI-U-SDU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA","DI-NP-CAN","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-RUC","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"genetic prediction of 000000000033 blood group phenotypes using an existing genotype dataset","src":["aau","au","ku","ruc","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-RUC","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1111/trf.17575","version":"Published Version"},"funding_acknowledgement":["The authors thank the Danish Blood Donor Study for making data available for the research performed in this publication and Novo Nordisk Foundation for their grants (nnf17oc0027594 and nnf14cc0001) that funded major parts of the infrastructure for DBDS and CHB. We also thank Bloddonorernes forskningsfond and A.P. Møller Fonden for awarding this project research grants of 64931 DKK and 45000 DKK, respectively."],"id":"S05-099.93-715668","identifier":[{"id":"85175740684","type":"scopus"},{"id":"37921035","type":"pmid"}],"ids":["aau-5877af24-7f63-4a94-9bda-1d9e306a89e5","au-d31acf3a-bd94-4379-8bfc-73ddb781f267","ku-272f130c-39f3-49a3-8e78-7dc4c35c8b99","ruc-1ea63b49-19de-439e-bf03-8897c822297b","sdu-74686168-0a3f-483e-945e-173e99c9e7ab"],"keyword":["ABO","Danish blood type rates","Danish population","Denmark","Diego","Dombrock","Duffy","Kell","Kidd","Knops","Lewis","Lutheran","MNS","P1PK","Rh","Vel","Yt","blood group systems","blood groups","donor blood typing","erythrocyte antigens","genetic blood typing","secretor"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-8-BAD0BB6AC25D697E272D62D2A9A0E842"],"oa_link":[{"access":"oa","license":"CC BY-NC 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/626089757/Moslemi_et_al._2023_._Genetic_prediction_of_33_blood_group_phenotypes_using_an_existing_genotype_dataset.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/251166539/Transfusion_-_2023_-_Moslemi_-_Genetic_prediction_of_33_blood_group_phenotypes_using_an_existing_genotype_dataset.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://pure.au.dk/ws/files/400683489/Transfusion_-_2023_-_Moslemi_-_Genetic_prediction_of_33_blood_group_phenotypes_using_an_existing_genotype_dataset.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/98403383/Transfusion_-_2023_-_Moslemi_-_Genetic_prediction_of_33_blood_group_phenotypes_using_an_existing_genotype_dataset.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"doi","u