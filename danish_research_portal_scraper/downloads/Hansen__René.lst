","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Clinical Immunology","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Diagnostik"],"nora_code":"DI-U-AAU","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"","corresponding":null,"first":"Isa A.","key":"olofssonpau","last":"Olofsson","name":"Olofsson, Isa A.","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Christian","key":"erikstruppau","last":"Erikstrup","name":"Erikstrup, Christian","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Erik","key":"sorensenpau","last":"Sorensen","name":"Sorensen, Erik","rank":3,"rolecode":"pau"},{"affno":"","first":"Erik","key":"sørensenpau","last":"Sørensen","name":"Sørensen, Erik","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Helene M.","key":"paaruppau","last":"Paarup","name":"Paarup, Helene M.","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Henriette P.","key":"mathiasenpau","last":"Mathiasen","name":"Mathiasen, Henriette P.","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Henrik","key":"hjalmgrimpau","last":"Hjalmgrim","name":"Hjalmgrim, Henrik","rank":6,"rolecode":"pau"},{"affno":"1","first":"Karina","key":"banasikpau","last":"Banasik","locid":"aa036e1f-a1ec-4d22-b444-e4f9c0406cdc","name":"Banasik, Karina","orcid":"0000-0003-2489-2499","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kaspar R.","key":"nielsenpau","last":"Nielsen","locid":"bc41abea-4b3e-473b-b7a6-8d2c7515f572","name":"Nielsen, Kaspar René","name_org":"Nielsen, Kaspar R.","rank":8,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Kristoffer S.","key":"burgdorfpau","last":"Burgdorf","name":"Burgdorf, Kristoffer S.","rank":9,"rolecode":"pau"},{"affno":"1","first":"Ole B. V.","key":"pedersenpau","last":"Pedersen","locid":"0d43956a-6e43-42d7-8b29-4505d03ea5c8","name":"Pedersen, Ole Birger","name_org":"Pedersen, Ole B. V.","orcid":"0000-0003-2312-5976","rank":10,"rolecode":"pau"},{"affno":"1","first":"Henrik","key":"ullumpau","last":"Ullum","locid":"ef594d49-5aeb-4d32-80b4-4bfc281b5cbb","name":"Ullum, Henrik","orcid":"0000-0001-7306-9058","rank":11,"rolecode":"pau"},{"affno":"1","first":"Jes","key":"olesenpau","last":"Olesen","locid":"c5fe564b-1354-4d3c-8173-9778df35d33f","name":"Olesen, Jes","rank":12,"rolecode":"pau"},{"affno":"3","first":"Thomas F.","key":"hansenpau","last":"Hansen","name":"Hansen, Thomas F.","rank":13,"rolecode":"pau"}],"pub":{"doi":"10.1177/0333102419859835","issn":["03331024","08001952"],"issn_org":["03331024"],"issue":"Suppl. 1","journal":"Cephalalgia","pages":"88-89","paperid":"IHC-PO-045","publisher":"SAGE Publications","status":"p","title":"Cephalalgia","volume":"39"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-707edc4a-fe6c-497b-8ef1-480703b4df41","ku-7534f2a0-c72e-4186-b32b-e0c27a67ffb3"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"Persons who have never had a headache : Socio-demographic characteristics","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-086.70-672352","year":"2019","yearsub":"2019"}
{"abstract":"Cloud and distributed storage applications require processing of large fragments of data. This poses memory, delay, and processing speed challenges for systems using erasure codes to reduce the cost of storage and/or increase the reliability of the system. To address these, this paper proposes and deploys designs that exploit current multi-threading capabilities of microprocessors to accelerate the encoding and decoding process of erasure codes, focusing on the case of Random Linear Network Coding (RLNC). More specifically, we propose a strategy for parallel computation based on splitting symbols into significantly smaller fragments and reordering data to speed up computation and decreasing the potential for thread blocking. We implement the strategy in C++ and carry out benchmark experiments and compare them with the single threaded state-of-the-art block RLNC encoders. We show a reduction of processing time by a factor of three by using our strategies for files of 32 MB or more as well as reducing memory usage drastically in the system. We also show that our approach provides a better scaling than the single-threaded option when increasing the number of fragments that a file is broken into. In other words, distributed storage systems can split files or data into a larger number of fragments without experiencing a speed penalty.","author_count":3,"contributors":["Nielsen, Lars","Hansen, Rene Rydhof","Lucani, Daniel E."],"cuid":["S02-087.30-008921"],"event":{"acronym":"EW","end":"2019-05-04","place":"Aarhus, dk","start":"2019-05-02","title":"25th European Wireless Conference 2019: Wireless Futures in the Era of Network Programmability, EW 2019","year":"2019"},"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"a multi threaded approach to encoding with random linear network coding","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85074448970&partnerID=8YFLogxK","version":"Other Version"},"funding_acknowledgement":["To use the experiments and the multi-threaded encoding scheme a license for the RLNC Software library Kodo is required. The license can be request from http://steinwurf.com/ license.html ACKNOWLEDGEMENT This research is supported partly by by the SCALE-IoT project granted by the Danish Council for Independent Research (Grant No. DFF 7026-00042B), the AUFF Starting Grant Project AUFF-2017-FLS-7-1, and Aarhus University’s DIGIT Centre."],"id":"S02-087.30-008921","identifier":[{"id":"85074448970","type":"scopus"}],"ids":["aau-b9191255-4431-491e-82dc-e6eb42843c0d","au-3438737b-3485-46cc-b2ce-c625cd92fd3e"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-4FC3679E0572D81381464CF1A438F9CD"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Engineering, Department of Engineering - Network Computing, Communications and Storage"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Technical Faculty of IT and Design","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science, Distributed, Embedded and Intelligent Systems"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lars","key":"nielsenpau","last":"Nielsen","locid":"d27cc3f7-1c6b-466d-a2ac-bf9df08a2072","name":"Nielsen, Lars","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"René Rydhof","key":"hansenpau","last":"Hansen","locid":"d92ec90d-a8b7-4c01-acbe-ebab21f3f0c3","name":"Hansen, Rene Rydhof","name_org":"Hansen, René Rydhof","orcid":"0000-0002-5688-6432","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Daniel Enrique","key":"lucanirötterpau","last":"Lucani Rötter","locid":"c4e78b1e-4dd6-460f-9c44-1a44771ce01a","name":"Lucani Rötter, Daniel Enrique","rank":3,"rolecode":"pau"}],"pub":{"eisbn":["9783800749492"],"isbn":["9783800749485"],"pages":"25-31","publisher":"VDE Verlag GMBH","publisher_org":"VDE Verlag GmbH","status":"p","title":"European Wireless 2019 Conference, EW 2019"},"review":"Peer Reviewed","scoID":["2-s2.0-85074448970"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-b9191255-4431-491e-82dc-e6eb42843c0d","au-3438737b-3485-46cc-b2ce-c625cd92fd3e"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"A Multi-Threaded Approach to Encoding with Random Linear Network Coding","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-087.30-008921","year":"2019","yearsub":2020}
{"abstract":"The hydrogen absorption properties of metal closo-borate/metal hydride composites, M2B10H10-8MH and M2B12H12-10MH, M = Li or Na, are studied under high hydrogen pressures to understand the formation mechanism of metal borohydrides. The hydrogen storage properties of the composites have been investigated by in situ synchrotron radiation powder X-ray diffraction at p(H2) = 400 bar and by ex situ hydrogen absorption measurements at p(H2) = 526 to 998 bar. The in situ experiments reveal the formation of crystalline intermediates before metal borohydrides (MBH4) are formed. On the contrary, the M2B12H12-10MH (M = Li and Na) systems show no formation of the metal borohydride at T = 400 °C and p(H2) = 537 to 970 bar. 11B MAS NMR of the M2B10H10-8MH composites reveal that the molar ratio of LiBH4 or NaBH4 and the remaining B species is 1:0.63 and 1:0.21, respectively. Solution and solid-state 11B NMR spectra reveal new intermediates with a B:H ratio close to 1:1. Our results indicate that the M2B10H10 (M = Li, Na) salts display a higher reactivity towards hydrogen in the presence of metal hydrides compared to the corresponding [B12H12]2- composites, which represents an important step towards understanding the factors that determine the stability and reversibility of high hydrogen capacity metal borohydrides for hydrogen storage.","author_count":10,"contributors":["Jensen, Steffen","Paskevicius, Mark","R. S. Hansen, Bjarne","Jakobsen, Anders S.","Møller, Kasper Trans","White, James L.","Allendorf, Mark D.","Stavila, Vitalie","Skibsted, Jørgen","Jensen, Torben René"],"cuid":["S01-000.00-178594"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","OECD"],"corresponding_author":["Stavila, Vitalie"],"country":["United States"],"glorg":["All Global Affiliations","Sandia National Laboratories CA"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"hydrogenation properties of lithium and sodium hydride closo borate b sub 000000000010 sub h sub 000000000010 sub sup 000000000002 sup and b sub 000000000012 sub h sub 000000000012 sub sup 000000000002 sup composites","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.au.dk/ws/files/165626435/c7cp07776a.pdf","version":"Published Version"},"id":"S01-000.00-178594","identifier":[{"id":"85048725337","type":"scopus"},{"id":"29863201","type":"pmid"}],"ids":["au-565b5899-8487-443f-984c-dc460785e71a"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-26D43A9351258DED68F090BBFCE5371A"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.au.dk/ws/files/165626435/c7cp07776a.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Chemistry, Department of Chemistry - Centre for Materials Crystallography (CMC)","Aarhus University, Natural Sciences, Interdisciplinary Nanoscience Center, Interdisciplinary Nanoscience Center - INANO-Kemi, Langelandsgade"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"us","key":"sandia national laboratories ca","loc":["United States","America, North","OECD"],"name":"Sandia National Laboratories CA","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Steffen R.H.","key":"jensensteffenpau","last":"Jensen","locid":"73583d16-c295-437a-bcec-09389ce2898c","name":"Jensen, Steffen","name_org":"Jensen, Steffen R.H.","rank