lshampau","last":"Belsham","locid":"72bf708e-8dd0-4270-b384-13f0ba640905","name":"Belsham, Graham","name_org":"Belsham, Graham J.","orcid":"0000-0003-1187-4873","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Thomas Bruun","key":"rasmussenpau","last":"Rasmussen","locid":"ac10aec0-1a8a-4f66-a5c6-2275ddf1726e","name":"Rasmussen, Thomas Bruun","orcid":"0000-0002-4241-1559","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anette","key":"bøtnerpau","last":"Bøtner","locid":"70ad6406-3b8c-4e50-95f5-b0f448fc69ea","name":"Bøtner, Anette","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rene","key":"bødkerpau","last":"Bødker","locid":"8fbaa7cf-7196-4a15-91d1-0cfac6858305","name":"Bødker, Rene","rank":9,"rolecode":"pau"}],"pmid":["29877056"],"pub":{"doi":"10.1111/tbed.12918","issn":["18651674","18651682"],"issn_org":["18651674"],"issue":"5","journal":"Transboundary and Emerging Diseases","pages":"1152-1157","publisher":"Wiley-Blackwell","status":"p","title":"Transboundary and Emerging Diseases","volume":"65"},"review":"Peer Reviewed","scoID":["2-s2.0-85048995608"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-de1bed08-8e06-4fcf-b164-ebf105eebd7b"],"src":["DTU Technical University of Denmark"],"title":"Infection of pigs with African swine fever virus via ingestion of stable flies (Stomoxys calcitrans )","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-370994","year":"2018","yearsub":"2018"}
{"abstract":"The purpose of this article is twofold. First, we wish to present the ‘team sport on prescription’ intervention and second, we wish to draw attention to the importance of managing and preparing the instructors running the intervention. Unorthodoxly, this article is structured as an interview with a practitioner answering three questions, to which we have included expert commentary to provide an explicit link to the theory of ‘street-level bureaucracy’ (Lipsky, 1980) and thereby connect to the field of public administration. A main purpose of the intervention was to study how a new way of organizing municipally initiated health enhancing ‘exercise on prescription’ influenced citizens referred by a general practitioner or a hospital. All traditional activities were replaced with team sports activities. For one year, all exercise equipment was removed from the location and the employees had to perform they their role as instructors. In the article, we conclude and exemplify how crucial the initial phase of managing and preparing the instructors is due to their extremely important position. In fact, the whole intervention is likely to stand or fall on the work of the instructors.","author_count":4,"contributors":["Bennike, Søren","Andersen, Rene","Hansen, Henriette Folkmann","Ottesen, Laila"],"cuid":["S01-000.00-423832"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"nr","rtype":["clu"],"sorti":"the management and preparation of street ministers of health are essential an interview with a practitioner on the process of preparing instructors who are about to implement team sport on prescription in a danish municipally organised prevention centre","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://curis.ku.dk/ws/files/197475394/Bennike_et_al_Idrottsforum_org_2018_30_05_2018.pdf","version":"Published Version"},"id":"S01-000.00-423832","ids":["ku-3314a67d-3f85-4565-8e66-db0ea75fc957"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-3A17ACBF4FFC7889727A85549E350BF3"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://curis.ku.dk/ws/files/197475394/Bennike_et_al_Idrottsforum_org_2018_30_05_2018.pdf","version":"Published Version"},{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://idrottsforum.org/bennikeetal180530/","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Nutrition, Exercise and Sports, Sport, Individual & Society"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Søren","key":"bennikepau","last":"Bennike","locid":"4c4dc15c-932e-4b7c-85e7-70e39be273c2","name":"Bennike, Søren","orcid":"0000-0002-1919-7515","rank":1,"rolecode":"pau"},{"affno":"1","first":"Rene","key":"andersenpau","last":"Andersen","locid":"673298d8-c9a1-4f20-80d3-6bd7eff5150f","name":"Andersen, Rene","rank":2,"rolecode":"pau"},{"affno":"1","first":"Henriette Folkmann","key":"hansenpau","last":"Hansen","locid":"9f6e3e8a-3b84-4651-8355-d6f23e879947","name":"Hansen, Henriette Folkmann","orcid":"0000-0002-7111-5361","rank":3,"rolecode":"pau"},{"affno":"1","first":"Laila","key":"ottesenpau","last":"Ottesen","locid":"d6aad9ac-17a2-4149-9e21-a6d8a4c40765","name":"Ottesen, Laila","orcid":"0000-0001-5086-9968","rank":4,"rolecode":"pau"}],"pub":{"issn":["16527224"],"journal":"idrottsforum.org","pages":"1-11","status":"p","title":"idrottsforum.org"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-3314a67d-3f85-4565-8e66-db0ea75fc957"],"src":["KU University of Copenhagen"],"title":"The management and preparation of ‘street ministers of health’ are essential : An interview with a practitioner on the process of preparing instructors who are about to implement team sport on prescription in a Danish municipally organised prevention centre","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-423832","year":"2018","yearsub":"2018"}
{"abstract":"Working-class adult men are prone to lifestyle diseases and premature death due to unhealthy lifestyle and illjudged health behavior. Previous research indicates that gender-specific interventions and social interaction are important motivators, but the need for novel approaches to encourage this target group remains. This paper presents an evaluation of a health promoting gamified web-platform for working-class adult men called “The Real Men Gang”. The platform utilizes gamification to encourage users to gather in teams to cooperate and compete. Gamification has shown a potential to motivate users toward target behavior by the application of game elements such as rewards and leader boards. Recent studies have focused on how game elements encourage cooperation and competition, but there is a need for empirical studies on how gamification can encourage social interaction and regular physical activity. Thus, the aim of this article is to understand how the gamified elements designed to encourage cooperation and competition have encouraged adult male users to engage in physical activity. The research design is based on a mixed-methods approach using quantitative and qualitative data. User-data is analyzed to assess the usage of the gamified elements, and interviews provide qualitative insights. The results show a general low usage and retention rate for the gamified elements. The elements which encourage cooperation between team members was mostly used, while the competitive aspects appear to be less motivating. Based on the findings we can conclude that the target users prefer the game elements designed for cooperation, while competition has mixed results. Design implications is suggested based on the findings of the study.","author_count":3,"contributors":["Hansen, René Engelhardt","Elbæk, Lars"],"cuid":["S01-000.00-578958"],"event":{"acronym":"ECGBL","end":"2018-10-05","place":"Sophia Antipolis, fr","start":"2018-10-04","title":"12th European Conference on Games Based Learning","year":"2018"},"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Adult men","Competition","Cooperation","Gamification","Men s health","Social gamification"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"health promotion for adult men through cooperative and competitive gamification features","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85058960531","version":"Other Version"},"id":"S01-000.00-578958","identifier":[{"id":"85058960531","type":"scopus"}],"ids":["sdu-141e3347-6cd3-4be0-ac12-8b70705046fd"],"keyword":["adult men","competition","cooperation","gamification","men’s health","social gamification"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-2-98333835FA6FCCE361A9F9471EFAC657"],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics, Research Unit of Psychology of Sport, Excellence and Health"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"René Engelhardt","key":"hansenpau","last":"Hansen","locid":"2d887e76-ae82-4a8d-962e-5e927394748e","name":"Hansen, René Engelhardt","orcid":"0000-0002-3145-4940","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars","key":"elbækpau","last":"Elbæk","locid":"38df74af-ed72-4c38-8044-5a47490810ba","name":"Elbæk, Lars","orcid":"0000-0002-2771-7293","rank":2,"rolecode":"pau"},{"affno":"","first":"Melanie","key":"ciussipedh","last":"Ciussi","name":"Ciussi, Melanie","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"eisbn":["9781912764006"],"isbn":["9781911218999"],"pages":"194-201","place":"Academic Conferences and publishing limited.","status":"p","title":"Proceedings of the 12th European Conference on Game-Based Learning, ECGBL 2018","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-85058960531"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-141e3347-6cd3-4be0-ac12-8b70705046fd"],"src":["SDU University of Southern Denmark"],"title":"Health Promotion for Adult Men Through Cooperative and Competitive Gamification Features","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-578958","year":"2018","yearsub":"2018"}
{"abstract":"In this paper, we present a performance study of the impact of generation and symbol sizes on latency for encoding with Random Linear Network Coding (RLNC). This analysis is important for low latency applications of RLNC as well as data storage applications that use large blocks of data, where the encoding process can be parallelized based on system requirements to reduce data access time within the system. Using a counting argument, we focus on predicting the effect of changes of generation (number of original packets) and symbol size (number of bytes per data packet) configurations on the encoding latency on full vector and on-the-fly algorithms. We show that the encoding latency doubles when either the generation size or the symbol size double and confirm this via extensive simulations. Although we show that the theoretical speed gain of on-the-fly over full vector is two, our measurements show a more moderate gain between 1.4 and 1.7, depending on the configuration used.","author_count":3,"contributors":["Nielsen, Lars","Hansen, Rene Rydhof","Lucani, Daniel E."],"cuid":["S01-000.00-686990"],"event":{"acronym":"EW","end":"2018-05-04","place":"Catania, it","start":"2018-05-02","title":"24th European Wireless Conference 2018: Wireless Futures in the Era of Network Programmability, EW 2018","year":"2018"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Data encoding","Performance benchmark","RLNC"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"latency performance of encoding with random linear network coding","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85050019638&partnerID=8YFLogxK","version":"Other Version"},"funding_acknowledgement":["This work was partially financed by the Aarhus Universitets Forskningsfond Starting Grant Project AUFF-2017-FLS-7-1 and the DIGIT Centre."],"id":"S01-000.00-686990","identifier":[{"id":"85050019638","type":"scopus"}],"ids":["aau-af5d7444-f8a2-489a-83f2-7d1e1e574d3f"],"keyword":["Data encoding","Performance benchmark","RLNC"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-3-C5C5BDAE64DD430C951F5B8625370848"],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Technical Faculty of IT and Design","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science, Distributed, Embedded and Intelligent Systems"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Lars","key":"nielsenpau","last":"Nielsen","locid":"17e524b1-d7a2-4af3-8470-407adf7a78a3","name":"Nielsen, Lars","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"René Rydhof","key":"hansenpau","last":"Hansen","locid":"d92ec90d-a8b7-4c01-acbe-ebab21f3f0c3","name":"Hansen, Rene Rydhof","name_org":"Hansen, René Rydhof","orcid":"0000-0002-5688-6432","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Daniel E.","key":"lucanipau","last":"Lucani","name":"Lucani, Daniel E.","rank":3,"role