{"abstract":"The presence of subclinical levels of psychosis in the general population may imply that schizophrenia is the extreme expression of more or less continuously distributed traits in the population. In a previous study, we identified five quantitative measures of schizophrenia (positive, negative, disorganisation, mania, and depression scores). The aim of this study is to examine the association between a direct measure of genetic risk of schizophrenia and the five quantitative measures of psychosis. Estimates of the log of the odds ratios of case/control allelic association tests were obtained from the Psychiatric GWAS Consortium (PGC) (minus our sample) which included genome-wide genotype data of 8,690 schizophrenia cases and 11,831 controls. These data were used to calculate genetic risk scores in 314 schizophrenia cases and 148 controls from the Netherlands for whom genotype data and quantitative symptom scores were available. The genetic risk score of schizophrenia was significantly associated with case-control status (p","author_count":14,"contributors":["Derks, Eske M","Vorstman, Jacob A S","Ripke, Stephan","Kahn, Rene S","Ophoff, Roel A","Hansen, Thomas","Olsen, Line","Jakobsen, Klaus Damgaard","Schmock, Henriette","Skjødt, Celina","Rosengren, Anders","Høffding, Louise.K.Enggaard","Thygesen, Johan Hilge","Werge, Thomas"],"cuid":["S01-000.00-445584"],"filters":{"added":"2022-04","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"corpau":["Schizophrenia Psychiatric Genomic Consortium"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"investigation of the genetic association between quantitative measures of psychosis and schizophrenia a polygenic risk score analysis","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1371/journal.pone.0037852","version":"Other Version"},"id":"S01-000.00-445584","identifier":[{"id":"84862667477","type":"scopus"},{"id":"PMC3382234","type":"pmcid"},{"id":"22761660","type":"pmid"}],"ids":["ku-5742e7c4-f929-4eb0-affc-fb179edf5a94"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-2-1091CEEB694DE6A2A4AEDC7D7147ECF6"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1371/journal.pone.0037852","version":"Other Version"}],"org":[{"affno":1,"key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Graduate School of Health and Medical Sciences"],"nora_code":"DI-U-KU"},{"affno":2,"key":"schizophrenia psychiatric genomic consortium","name":"Schizophrenia Psychiatric Genomic Consortium","role":"oau"}],"person":[{"affno":"","first":"Eske M","key":"derkspau","last":"Derks","name":"Derks, Eske M","rank":1,"rolecode":"pau"},{"affno":"","first":"Jacob A S","key":"vorstmanpau","last":"Vorstman","name":"Vorstman, Jacob A S","rank":2,"rolecode":"pau"},{"affno":"","first":"Stephan","key":"ripkepau","last":"Ripke","name":"Ripke, Stephan","rank":3,"rolecode":"pau"},{"affno":"","first":"Rene S","key":"kahnpau","last":"Kahn","name":"Kahn, Rene S","rank":4,"rolecode":"pau"},{"affno":"","first":"Roel A","key":"ophoffpau","last":"Ophoff","name":"Ophoff, Roel A","rank":5,"rolecode":"pau"},{"affno":"","first":"Thomas","key":"hansenpau","last":"Hansen","name":"Hansen, Thomas","rank":6,"rolecode":"pau"},{"affno":"","first":"Line","key":"olsenpau","last":"Olsen","name":"Olsen, Line","rank":7,"rolecode":"pau"},{"affno":"","first":"Klaus Damgaard","key":"jakobsenpau","last":"Jakobsen","name":"Jakobsen, Klaus Damgaard","rank":8,"rolecode"