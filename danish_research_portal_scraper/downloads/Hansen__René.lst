:1}],"person":[{"affno":"1","corresponding":null,"first":"Mads","key":"frostpau","last":"Frost","name":"Frost, Mads","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Gabriela","key":"marcupau","last":"Marcu","locid":"dbf46bed-0956-47c4-95e9-d850c6f897d5","name":"Marcu, Gabriela","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"René","key":"hansenpau","last":"Hansen","locid":"14396cd2-ae59-4ac5-8569-e0305c3a775b","name":"Hansen, René","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Károly","key":"szántopau","last":"Szánto","locid":"55750491-d4d3-47d4-a473-7a2252edb685","name":"Szánto, Károly","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jakob","key":"bardrampau","last":"Bardram","name":"Bardram, Jakob","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-8a882ba4-5d4f-433c-9ebd-5564952a7e44"],"src":["ITU IT University of Copenhagen"],"title":"The MONARCA self-assessment system: Persuasive personal monitoring for bipolar patients","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383293","year":"2011","yearsub":"2011"}
{"abstract":"Correct mechanical function of tendons is essential to human physiology and therefore the mechanical properties of tendon have been a subject of research for many decades now. However, one of the most fundamental questions remains unanswered: How is load transmitted through the tendon? It has been suggested that the proteoglycan-associated glycosaminoglycans (GAGs) found on the surface of the collagen fibrils may be an important transmitter of load, but existing results are ambiguous and have not investigated human tendons. We have used a small-scale mechanical testing system to measure the mechanical properties of fascicles from human patellar tendon at two different deformation rates before and after removal of GAGs by treatment with chondroitinase ABC. Efficiency of enzyme treatment was quantified using dimethylmethylene blue assay. Removal of at least 79% of the GAGs did not significantly change the tendon modulus, relative energy dissipation, peak stress, or peak strain. The effect of deformation rate was not modulated by the treatment either, indicating no effect on viscosity. These results suggest that GAGs cannot be considered mediators of tensile force transmission in the human patellar tendon, and as such, force transmission must either take place through other matrix components or the fibrils must be mechanically continuous at least to the tested length of 7 mm.","author_count":5,"contributors":["Svensson, René B","Hassenkam, Tue","Hansen, Philip","Kjaer, Michael","Magnusson, S. Peter"],"cuid":["S01-000.00-519535"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"tensile force transmission in human patellar tendon fascicles is not mediated by glycosaminoglycans","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3109/03008207.2010.551569","version":"Other Version"},"id":"S01-000.00-519535","identifier":[{"id":"80052742678","type":"scopus"}],"ids":["ku-d30c9d23-cad9-4c4b-81d9-0d6ee26b311e"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-868E00F2F1B5C23DC7CF68149FFABFD8"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.3109/03008207.2010.551569","version":"Other Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Chemistry","Københavns Universitet, Faculty of Science, Department of Chemistry, Department of Chemistry"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"René B","key":"svenssonpau","last":"Svensson","name":"Svensson, René B","rank":1,"rolecode":"pau"},{"affno":"1","first":"Tue","key":"hassenkampau","last":"Hassenkam","locid":"bbbe3967-1193-44fc-a0dd-b6e29f3cfd35","name":"Hassenkam, Tue","orcid":"0000-0002-2184-3360","rank":2,"rolecode":"pau"},{"affno":"","first":"Philip","key":"hansenpau","last":"Hansen","name":"Hansen, Philip","rank":3,"rolecode":"pau"},{"affno":"1","first":"Michael","key":"kjaerpau","last":"Kjaer","locid":"7937b8ab-7820-4d25-982f-1d2f58b033a3","name":"Kjaer, Michael","rank":4,"rolecode":"pau"},{"affno":"","first":"Stig P","key":"magnussonpau","last":"Magnusson","locid":"6f430caa-ac01-4dfe-9a62-e3a49afba21a","name":"Magnusson, S. Peter","name_org":"Magnusson, Stig P","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.3109/03008207.2010.551569","issn":["03008207","10267433"],"issn_org":["03008207"],"issue":"5","journal":"Connective Tissue Research","pages":"415-21","status":"p","title":"Connective Tissue Research","volume":"52"},"review":"Peer Reviewed","scoID":["2-s2.0-80052742678"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-d30c9d23-cad9-4c4b-81d9-0d6ee26b311e"],"src":["KU University of Copenhagen"],"title":"Tensile force transmission in human patellar tendon fascicles is not mediated by glycosaminoglycans","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-519535","year":"2011","yearsub":"2011"}
{"abstract":"OBJECTIVE: Hypokalemia is a potentially life-threatening electrolyte disturbance in anorexia nervosa and is most frequently caused by purging behavior. We report a case of severe hypokalemia in anorexia nervosa induced by daily ingestion of approximately 20 g of licorice. METHODS: To confirm the diagnosis of licorice-induced pseudohyperaldosteronism, a re-exposure trial was performed. RESULTS: Cessation of the licorice intake normalized plasma potassium, renin, and aldosterone levels and the urine cortisol/cortisone ratio. Re-exposure confirmed the diagnosis. The pronounced response to a relatively low daily dose of licorice suggests high glycyrrhizin sensitivity. CONCLUSION: Patients with anorexia nervosa not only have decreased food intake but also selective and sometimes bizarre eating habits that, in association with increased sensitivity to glycyrrhizin, may cause severe hypokalemia.","author_count":7,"contributors":["Støving, René Klinkby","Lingqvist, Linnéa E","Bonde, Rasmus K","Andries, Alin","Hansen, Marianne H","Andersen, Marianne","Hørder, Kirsten"],"cuid":["S01-000.00-587600"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"is glycyrrhizin sensitivity increased in anorexia nervosa and should licorice be avoided case report and review of the literature","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.nut.2010.06.006","version":"Other Version"},"id":"S01-000.00-587600","identifier":[{"id":"79959198990","type":"scopus"},{"id":"20739148","type":"pmid"}],"ids":["sdu-324437a2-e02d-4399-9143-da1ca453f9b5"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-2-0161979E19F352E21D15B7DA39EB597A"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.nut.2010.06.006","version":"Other Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences","SDU, The Faculty of Health Sciences, Department of Clinical Research","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Endocrinology (Odense)","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, Research Unit of Child and Adolescent Psychiatry (Southern Denmark)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"René K","key":"støvingpau","last":"Støving","locid":"4aab81f6-352f-4c74-82a2-23589beb9fd5","name":"Støving, René Klinkby","name_org":"Støving, René K","orcid":"0000-0002-4255-5544","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Linnéa E","key":"lingqvistpau","last":"Lingqvist","name":"Lingqvist, Linnéa E","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Rasmus K","key":"bondepau","last":"Bonde","locid":"113eb63f-3b3b-45b3-a4ce-36ab7abcb80d","name":"Bonde, Rasmus K","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Alin","key":"andriespau","last":"Andries","locid":"1fbe13df-7f4d-4e58-851f-5583ac98816a","name":"Andries, Alin","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Marianne H","key":"hansenpau","last":"Hansen","name":"Hansen, Marianne H","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Marianne","key":"andersenpau","last":"Andersen","locid":"94aa4e0a-b026-469f-a635-4bad008d49d7","name":"Andersen, Marianne","orcid":"0000-0002-4603-9504","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kirsten","key":"hørderpau","last":"Hørder","locid":"10971f9a-9644-480d-8f75-cad219c26729","name":"Hørder, Kirsten","rank":7,"rolecode":"pau"}],"pmid":["20739148"],"pub":{"doi":"10.1016/j.nut.2010.06.006","issn":["08999007","18731244"],"issn_org":["08999007"],"issue":"7-8","journal":"Nutrition","pages":"855-858","publisher":"Elsevier","status":"p","title":"Nutrition","volume":"27"},"review":"Peer Reviewed","scoID":["2-s2.0-79959198990"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-324437a2-e02d-4399-9143-da1ca453f9b5"],"src":["SDU University of Southern Denmark"],"title":"Is glycyrrhizin sensitivity increased in anorexia nervosa and should licorice be avoided? Case report and review of the literature","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-587600","year":"2011","yearsub":"2010"}
{"abstract":"En lang række Intelligente Transportsystemer udvikles i disse år til at hjælpe den enkelte bilist med at køre mere sikkert. En central del er omkring trafiksikkerhed, og som en del af det nordjyske ITS Platform projekt udvikles en risikolog, der beskriver hvor risikobetonet den enkelte deltagende bilists kørselsadfærd er. Den giver feedback til bilisten, hvis der foretages risikobetonet kørsel i form af for høje hastigheder, kraftige decelerationer samt kraftige accelerationer i kørselsretningen samt sideværts. Den afledte af accelerationen, kaldet rykket beskriver risikobetonet adfærd bedre end accelerationen. Der er en god sammenhæng mellem antallet af kraftige ryk i kørselsretningen og kørselsadfærden, mens der ikke kan konstateres en klar sammenhæng mellem sideværts ryk og kørselsadfærden. Datagrundlaget for disse resultater er ikke stort, og grænseværdier for de ryk, der skal resultere i feedback i forbindelse med risikolog dokumenteres løbende i takt med, at data fra deltagerne i ITS Platform bliver indsamlet.","author_count":4,"contributors":["Agerholm, Niels","Rasmussen, Niels Kaare Hjaltelin","Hansen, René Ramskov Lund","Lahrmann, Harry"],"cuid":["S01-000.00-101492"],"event":{"end":"2011-08-23","place":"Aalborg, dk","start":"2011-08-22","title":"Trafikdage","year":"2011"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"udviklingen af algoritmer til at beskrive sikker kørsel på basis af data fra kørende biler","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/58274949/Paper_risikolog_TD2011_final1.pdf","version":"Pre-print"},"id":"S01-000.00-101492","ids":["aau-b13f048f-79f1-4ce2-b412-af5652ebe7bc"],"lang":"Danish","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-FC82EA72718D659AF2FF457F01EC3A04"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/58274949/Paper_risikolog_TD2011_final1.pdf","version":"Pre-print"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (TECH)","Aalborg University, The Faculty of Engineering and Science, Department of Civil Engineering, Intelligent Transport Systems Research Group","Aalborg University, The Faculty of Engineering and Science, Department of Civil Engineering, Road Modelling Research Group","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment, Division of Civil and Environmental Engineering","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment, Division of Transportation Engineering","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment, Traffic Research Group","Aalborg University, The Technical Faculty of IT and Design, Department of Sustainability and Planning","Aalborg University, The Technical Faculty of IT and Design, Department of Sustainability and Planning, Traffic Research Group (Planning)"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Niels","key":"agerholmpau","last":"Agerholm","locid":"c993205c-88f7-4c10-a037-25cada9afa9c","name":"Agerholm, Niels","orcid":"0000-0002-7731-6500","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Niels Kaare Hjaltelin","key":"rasmussenpau","last":"Rasmussen","locid":"298fbaf3-1349-4f77-8fea-f2ca2e738e14","name":"Rasmussen, Niels Kaare Hjaltelin","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"René Ramskov Lund","key":"hansenpau","last":"Hansen","locid":"449c4f61-94b3-44ce-8634-73df74a283f2","name":"Hansen, René Ramskov Lund","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Harry","key":"lahrmannpau","last":"Lahrmann","locid":"7e1bc853-b677-467c-87ae-54b08116b7e4","name":"Lahrmann, Harry","orcid":"0000-0001-6339-4586","rank":4,"rolecode":"pau"}],"pub":{"issn":["16039696"],"journal":"Artikler fra Trafikdage på Aalborg Universitet","pages":"1-11","publisher":"Aalborg Universitet. Trafikforskningsgruppen","status":"p","title":"Artikler fra Trafikdage på Aalborg Universitet"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-b13f048f-79f1-4ce2-b412-af5652ebe7bc"],"src":["AAU Aalborg University"],"title":"Udviklingen af algoritmer til at beskrive sikker kørsel på basis af data fra kørende biler","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-101492","year":"2011","yearsub":"2011"}
{"author_count":5,"contributors":["Simonsen, Kim Pilkjær","Larsen, René","Scharff, Mikkel","Botfeldt, Knud Bo","Kofod-Hansen, Elisabeth"],"cuid":["S01-000.00-128582"],"filters":{"added":"2023-01","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Autencitet","Authenticity","Chemistry","Kemi","Vinland Map","Vinlandskortet"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-ART"],"level3":{"ART":["DI-ART-ALL","DI-ART-RDKA"]},"level3all":["DI-ART-RDKA"]},"review":"nr","rtype":["clu"],"sorti":"konservatoren og kemi i vinlandskortet","src":["arkc"],"src-code":["DI-ART-RDKA"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://www.danskkemi-online.dk/files/DAK9-2011-s12-15.pdf","version":"Published Version"},"id":"S01-000.00-128582","ids":["arkc-e8dcc16a-16ae-41e7-a002-5414f696379b"],"keyword":["Nej","Vinland Map","Vinlandskortet","autencitet","authenticity","carbondatering","chemistry","kemi"],"lang":"Danish","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-549D71BF1F565F874E13AA43A873433C"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.danskkemi-online.dk/files/DAK9-2011-s12-15.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"royal danish academy architecture design conservation","l2":"DI-ART","l2n":"Artistic Higher Education Institutions","l3":"DI-ART-RDKA","l3nn":"Royal Danish Academy - Architecture, Design, Conservation","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Royal Danish Academy - Architecture, Design, Conservation","namevar":["The Royal Danish Academy of Fine Arts, Schools of Architecture, Design and Conservation, School of Conservation, Research Lab"],"nora_code":"DI-ART-RDKA","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Kim","key":"pilkjærsimonsenpau","last":"Pilkjær Simonsen","locid":"d67eb122-9849-4cf6-893f-f8198d9ebc64","name":"Simonsen, Kim Pilkjær