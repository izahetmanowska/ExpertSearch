Hoved-Orto"],"nora_code":"DI-U-AAU","used":1},{"affno":"6","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus University, Faculty of Health Sciences, The Department of Neurosurgery"],"nora_code":"DI-U-AU","used":1},{"affno":"7","country":"dk","key":"north denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-NDR","l3nl":"North Denmark Region","l3nn":"North Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"North Denmark Region","namevar":["Aalborg University Hospital"],"nora_code":"DI-HO-NDR","used":1},{"affno":"8","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1},{"affno":"9","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Steinbjørn","key":"hansenpau","last":"Hansen","locid":"83278fe8-4bec-48ef-b43e-22417e8f4623","name":"Hansen, Steinbjørn","orcid":"0000-0001-5651-6493","rank":1,"rolecode":"pau"},{"affno":"2 3 4","corresponding":null,"first":"Birthe Krogh","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Birthe Krogh","rank":2,"rolecode":"pau"},{"affno":"5 6 7","corresponding":null,"first":"René Johannes","key":"laursenpau","last":"Laursen","locid":"0ab2e1c6-3018-44ee-b207-a30494b52f5b","name":"Laursen, Rene Johannes","name_org":"Laursen, René Johannes","rank":3,"rolecode":"pau"},{"affno":"2 3 4","corresponding":null,"first":"Michael","key":"kosteljanetzpau","last":"Kosteljanetz","name":"Kosteljanetz, Michael","rank":4,"rolecode":"pau"},{"affno":"6 8","corresponding":null,"first":"Henrik","key":"schultzpau","last":"Schultz","locid":"d960f07d-b246-4eb1-ac8b-61d395f98d55","name":"Schultz, Henrik","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Bente Mertz","key":"nørgårdpau","last":"Nørgård","locid":"3d41d6fb-8f1c-4899-9ebd-b72f88e3935d","name":"Nørgård, Bente Mertz","orcid":"0000-0002-9514-3033","rank":6,"rolecode":"pau"},{"affno":"1 9","corresponding":null,"first":"Rikke","key":"guldbergpau","last":"Guldberg","locid":"971944ff-2c6b-4abc-9bb0-d914d8e42778","name":"Sørensen, Rikke Guldberg","name_org":"Guldberg, Rikke","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kim Oren","key":"gradelpau","last":"Gradel","locid":"1d28d7bc-60bb-46f5-8143-bc6508387a8f","name":"Gradel, Kim Oren","orcid":"0000-0002-5611-2031","rank":8,"rolecode":"pau"}],"pmid":["29754199"],"pub":{"doi":"10.1007/s11060-018-2892-7","issn":["0167594X","15737373"],"issn_org":["0167594X"],"issue":"2","journal":"Journal of Neuro-Oncology","pages":"479-489","publisher":"Springer Science+Business Media","status":"p","title":"Journal of Neuro-Oncology","volume":"139"},"review":"Peer Reviewed","scoID":["2-s2.0-85046801320"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","North Denmark Region","Other Research","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-d941610a-0c4b-497d-9e41-7b116a80ea4b","au-c722e408-82d5-40c1-beee-53fe55cb25d0","sdu-3b27bf0a-4235-4021-84df-1c8d1d3da78f"],"src":["AAU Aalborg University","AU Aarhus University","SDU University of Southern Denmark"],"title":"Treatment and survival of glioblastoma patients in Denmark : The Danish Neuro-Oncology Registry 2009-2014","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-100.00-010373","year":"2018","yearsub":"2018"}
{"abstract":"BACKGROUND: Migraine and Attention Deficit and Hyperactivity Disorder (ADHD) have been found to be associated in child and adolescent cohorts; however, the association has not been assessed in adults or otherwise healthy population. Assessing the comorbidity between ADHD and migraine may clarify the etiopathology of both diseases. Thus, the objective is to assess whether migraine (with and without visual disturbances) and ADHD are comorbid disorders. METHODS: Participants from the Danish Blood Donor Study (N = 26,456, age 18-65, 46% female) were assessed for migraine and ADHD using the ASRS ver 1.1 clinically validated questionnaire and self-reported migraine in a cross-sectional study. Logistic regression was used to examine the comorbidity between migraine and ADHD, and their associated endophenotypes. RESULTS: Migraine was strongly associated with ADHD (OR = 1.8, 95% CI = 1.5-2.1), (238/6152 vs 690/19,376). There was a significant interaction between age and gender, with comorbidity increasing with age and female sex. Post-hoc analysis showed that migraine with visual disturbance was generally associated with a marginally higher risk of ADHD and this was independent of ADHD endophenotypes. CONCLUSION: Migraine and ADHD were demonstrated to be comorbid disorders; the association with ADHD was most prominent for participants with migraine with visual disturbances. Future studies will elucidate which genetic and environmental factors contribute to migraine-ADHD comorbidity.","author_count":13,"contributors":["Hansen, Thomas Folkmann","Hoeffding, Louise K","Kogelman, Lisette","Haspang, Thilde Marie","Ullum, Henrik","Sørensen, Erik","Erikstrup, Christian","Pedersen, Ole Birger","Nielsen, Kaspar René","Hjalgrim, Henrik","Paarup, Helene M","Werge, Thomas","Burgdorf, Kristoffer"],"cuid":["S04-100.00-007190"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"keyword":["Adolescent","Adult","Aged","Attention Deficit Disorder with Hyperactivity epidemiology","Attention deficiency and hyperactivity disorder","Comorbidity","Cross Sectional Studies","Female","Humans","Logistic Models","Male","Middle Aged","Migraine","Migraine Disorders epidemiology","Self Report","Surveys and Questionnaires","Young Adult"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-NP","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-ZEA"],"NP":["DI-NP-ALL","DI-NP-LUND"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-ZEA","DI-NP-LUND","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"comorbidity of migraine with adhd in adults","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12883-018-1149-6","version":"Published Version"},"id":"S04-100.00-007190","identifier":[{"id":"PMC6190553","type":"pmcid"},{"id":"85054892001","type":"scopus"},{"id":"30322380","type":"pmid"}],"ids":["aau-94954d24-1cec-4685-8442-13898751ae3c","au-1966eef5-c5bf-45a9-9633-cb3b6b937745","ku-35d804cd-1e2c-4e71-9d14-7877891d47e1","sdu-d1f81049-cd2b-467e-857c-eb41f8432ae0"],"keyword":["Adolescent","Adult","Aged","Attention Deficit Disorder with Hyperactivity/epidemiology","Attention deficiency and hyperactivity disorder","Comorbidity","Cross-Sectional Studies","Female","Humans","Logistic Models","Male","Middle Aged","Migraine","Migraine Disorders/epidemiology","Self Report","Surveys and Questionnaires","Young Adult"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-7-E4831A45BC108ED7484941958DD10BD1"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://do