affno":"1","corresponding":null,"first":"Bjarne","key":"rshansenpau","last":"R. S. Hansen","locid":"95e2932e-526e-4795-b38a-7ab221f891ae","name":"R. S. Hansen, Bjarne","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Claudio","key":"pistiddapau","last":"Pistidda","name":"Pistidda, Claudio","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Martin","key":"dornheimpau","last":"Dornheim","name":"Dornheim, Martin","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Torben René","key":"jensenpau","last":"Jensen","locid":"e0750478-df89-45bf-aa48-b6a86de93fa0","name":"Jensen, Torben René","orcid":"0000-0002-4278-3221","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Anna-Lisa","key":"chaudharypau","last":"Chaudhary","name":"Chaudhary, Anna-Lisa","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-d326221e-7873-493f-aacf-74adfec066d9"],"src":["AU Aarhus University"],"title":"Ammoniation of M<sub>X</sub>B<sub>12</sub>H<sub>12</sub> (M<sub>X</sub> = Li<sub>2</sub>, Na<sub>2</sub>, Ca)","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-249930","year":"2015","yearsub":"2015"}
{"abstract":"2,6-dichlorobenzamide (BAM) is a recalcitrant groundwater micropollutant that poses a major problem for drinking water production in European countries. Aminobacter sp. MSH1 and related strains have the unique ability to mineralize BAM at micropollutant concentrations but no information exists on the genetics of BAM biodegradation. An amidase-BbdA-converting BAM to 2,6-dichlorobenzoic acid (DCBA) was purified from Aminobacter sp. MSH1. Heterologous expression of the corresponding bbdA gene and its absence in MSH1 mutants defective in BAM degradation, confirmed its BAM degrading function. BbdA shows low amino acid sequence identity with reported amidases and is encoded by an IncP1-β plasmid (pBAM1, 40.6 kb) that lacks several genes for conjugation. BbdA has a remarkably low KM for BAM (0.71 μM) and also shows activity against benzamide and ortho-chlorobenzamide (OBAM). Differential proteomics and transcriptional reporter analysis suggest the constitutive expression of bbdA in MSH1. Also in other BAM mineralizing Aminobacter sp. strains, bbdA and pBAM1 appear to be involved in BAM degradation. BbdA's high affinity for BAM and its constitutive expression are of interest for using strain MSH1 in treatment of groundwater containing micropollutant concentrations of BAM for drinking water production.","author_count":9,"contributors":["T'Syen, Jeroen","Tassoni, Raffaella","Hansen, Lars H.","Sørensen, Søren Johannes","Leroy, Baptiste","Sekhar, Aswini","Wattiez, Ruddy","De Mot, René","Springael, Dirk"],"cuid":["S01-000.00-420985"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"identification of the amidase bbda that initiates biodegradation of the groundwater micropollutant 000000000002 000000000006 dichlorobenzamide bam in i aminobacter i sp msh000000000001","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-420985","identifier":[{"id":"26308673","type":"pmid"},{"id":"84943429236","type":"scopus"}],"ids":["ku-2e38f5f2-5309-4a3c-abcd-5707a8096816"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-0C50726D283BFB29F3814ECEB9E7FF8C"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Biology, Microbiology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Jeroen","key":"tsyenpau","last":"T'Syen","name":"T'Syen, Jeroen","rank":1,"rolecode":"pau"},{"affno":"","first":"Raffaella","key":"tassonipau","last":"Tassoni","name":"Tassoni, Raffaella","rank":2,"rolecode":"pau"},{"affno":"1","first":"Lars H.","key":"hansenpau","last":"Hansen","locid":"2e041f09-bf9d-434a-b82a-d6e2763bb262","name":"Hansen, Lars H.","orcid":"0000-0003-0027-1524","rank":3,"rolecode":"pau"},{"affno":"1","first":"Søren Johannes","key":"sørensenpau","last":"Sørensen","locid":"1a8a144e-52fd-4508-b364-6e3ea6cfaa8a","name":"Sørensen, Søren Johannes","orcid":"0000-0001-6227-9906","rank":4,"rolecode":"pau"},{"affno":"","first":"Baptiste","key":"leroypau","last":"Leroy","name":"Leroy, Baptiste","rank":5,"rolecode":"pau"},{"affno":"","first":"Aswini","key":"sekharpau","last":"Sekhar","name":"Sekhar, Aswini","rank":6,"rolecode":"pau"},{"affno":"","first":"Ruddy","key":"wattiezpau","last":"Wattiez","name":"Wattiez, Ruddy","rank":7,"rolecode":"pau"},{"affno":"","first":"René","key":"demotpau","last":"De Mot","name":"De Mot, René","rank":8,"rolecode":"pau"},{"affno":"","first":"Dirk","key":"springaelpau","last":"Springael","name":"Springael, Dirk","rank":9,"rolecode":"pau"}],"pmid":["26308673"],"pub":{"doi":"10.1021/acs.est.5b02309","issn":["0013936X","15205851"],"issn_org":["0013936X"],"issue":"19","journal":"Environmental Science & Technology","pages":"11703-11713","status":"p","title":"Environmental Science & Technology","title_org":"Environmental Science & Technology (Washington)","volume":"49"},"review":"Peer Reviewed","scoID":["2-s2.0-84943429236"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-2e38f5f2-5309-4a3c-abcd-5707a8096816"],"src":["KU University of Copenhagen"],"title":"Identification of the amidase BbdA that initiates biodegradation of the groundwater micropollutant 2,6-dichlorobenzamide (BAM) in <i>Aminobacter</i> sp. MSH1","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-420985","year":"2015","yearsub":"2015"}
{"abstract":"INTRODUCTION: Preterm birth is associated with increased risk of asthma-like symptoms and purchase of prescription asthma medication in childhood. We investigated whether this association persists into adulthood and whether it is affected by accounting for neonatal respiratory morbidity (acute respiratory disease and bronchopulmonary dysplasia). METHODS: A national cohort of all infants born in Denmark in the period 1980-2009 was included in this register study. Data on purchase of asthma medication (combination of inhaled β-2 agonists and other drugs for obstructive airway disease) in 2010-2011 were obtained from the Danish National Prescription Registry. Associations between gestational age (GA), neonatal respiratory morbidity and a cross-sectional evaluation of asthma medication purchase were explored by multivariate logistic regressions. RESULTS: A full dataset was obtained on 1,790,241 individuals, 84.6% of all infants born in the period. Odds-ratios (95% CI) for the association between GA and purchase of asthma medication during infancy were: 3.86 (2.46-6.04) in GA 23-27 weeks, 2.37 (1.84-3.04) in GA 28-31 weeks and 1.59 (1.43-1.77) in GA 32-36 weeks compared to term infants with GA 37-42 weeks. Associations weakened in older age groups and became insignificant in young adults born extremely and very preterm with odds-ratios: 1.41 (0.63-3.19) and 1.15 (0.83-1.60) in GA 23-27 and 28-31 respectively. When adjusting for neonatal respiratory morbidity, the associations weakened but persisted both in childhood and adolescence. CONCLUSION: There was a strong dose-response association between gestational age and the purchase of prescription asthma medication in infancy and childhood. This association weakened during adolescence and was mostly non-significant in young adulthood. The increased risk of prescription asthma medication purchase in ex-preterm children could only partly be explained by neonatal respiratory morbidity.","author_count":6,"contributors":["Damgaard, Anne Louise","Hansen, Bo Moelholm","Mathiasen, Rene","Buchvald, Frederik","Lange, Theis","Greisen, Gorm"],"cuid":["S01-000.00-459428"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"prematurity and prescription asthma medication from childhood to young adulthood a danish national cohort study","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pone.0117253","version":"Published Version"},"id":"S01-000.00-459428","identifier":[{"id":"25651521","type":"pmid"},{"id":"PMC4317188","type":"pmcid"},{"id":"84922375584","type":"scopus"}],"ids":["ku-6e757ceb-9681-4918-9480-1fa04292c300"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-091663B9303B20448C3EE9DCF63FA72E"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pone.0117253","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Section of Biostatistics"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Anne Louise","key":"damgaardpau","last":"Damgaard","name":"Damgaard, Anne Louise","rank":1,"rolecode":"pau"},{"affno":"","first":"Bo Moelholm","key":"hansenpau","last":"Hansen","name":"Hansen, Bo Moelholm","rank":2,"rolecode":"pau"},{"affno":"","first":"Rene","key":"mathiasenpau","last":"Mathiasen","name":"Mathiasen, Rene","rank":3,"rolecode":"pau"},{"affno":"","first":"Frederik","key":"buchvaldpau","last":"Buchvald","name":"Buchvald, Frederik","rank":4,"rolecode":"pau"},{"affno":"1","first":"Theis","key":"langepau","last":"Lange","locid":"e4664578-01fc-4a93-8efd-1dbffb72cdd6","name":"Lange, Theis","orcid":"0000-0001-6807-8347","rank":5,"rolecode":"pau"},{"affno":"1","first":"Gorm","key":"greisenpau","last":"Greisen","locid":"2f78041e-9c90-4d24-9aec-7fa1e1791031","name":"Greisen, Gorm","rank":6,"rolecode":"pau"}],"pmid":["25651521"],"pub":{"doi":"10.1371/journal.pone.0117253","issn":["19326203"],"issue":"2","journal":"PLOS ONE","pages":"1-17","paperid":"e0117253","status":"p","title":"PLOS ONE","volume":"10"},"review":"Peer Reviewed","scoID":["2-s2.0-84922375584"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-6e757ceb-9681-4918-9480-1fa04292c300"],"src":["KU University of Copenhagen"],"title":"Prematurity and prescription asthma medication from childhood to young adulthood : a danish national cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-459428","year":"2015","yearsub":"2015"}
