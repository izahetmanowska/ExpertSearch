nrik Jessen","rank":2,"rolecode":"pau"},{"affno":"1","first":"Henrik","key":"kehletpau","last":"Kehlet","locid":"0a3c43a0-a0c5-4a91-85d6-6e80e16af8b5","name":"Kehlet, Henrik","orcid":"0000-0002-2209-1711","rank":3,"rolecode":"pau"},{"affno":"1 2","first":"René Horsleben","key":"petersenpau","last":"Petersen","locid":"aa18983b-8811-4b3a-a7bd-b439cc52d3e3","name":"Petersen, René Horsleben","orcid":"0000-0002-3586-1869","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.21037/amj.2017.07.07","issn":["15326497","25200518"],"issn_org":["25200518"],"journal":"AEM Medical Journal","paperid":"94","status":"p","title":"AEM Medical Journal","volume":"2"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-755ae9c7-1323-4126-ad26-f7e1a7c74e68"],"src":["KU University of Copenhagen"],"title":"Improving evidence for video-assisted thoracoscopic surgery lobectomy","type":"Other","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-463605","year":"2017","yearsub":"2017"}
{"abstract":"In curriculum research, it is common to distinguish between three different curricula levels, namely the intended curriculum, the implemented curriculum and the attained curriculum. The distinctions have later been applied in educational design research to differentiate between different representations of design. Discussing findings from a study on MOOCs developed using a design-based approach, the paper explores how the three notions can be used as an analytical framework for designing, implementing and evaluating interventions in an educational context. The paper argues that the concept of the intended, implemented and attained designs may serve as a means to better understand the process of designing new educational formats and to anticipate unwanted discrepancies between the intended idea and the solution that is actually implemented. We argue that such unwanted differences between intended and implemented designs are often caused by a lack of consensus as to what constitutes the core idea of an intended design and we hence proceed to discuss the need for finding meaningful ways for educational designers to communicate their intended designs to those who are to implement them.","author_count":5,"contributors":["Christiansen, René Boyer","Petersen, Anne Kristine","Sørensen, Randi Skovbjerg","Hansen, Dorrit","Buch, Bettina"],"cuid":["S01-000.00-555090"],"filters":{"added":"2023-07","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-UC"],"level3":{"UC":["DI-UC-AB","DI-UC-ALL"]},"level3all":["DI-UC-AB"]},"review":"pr","rtype":["clu"],"sorti":"designing for teaching and learning in moocs intended and implemented designs","src":["pha"],"src-code":["DI-UC-AB"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-555090","ids":["pha-b370278a-0d0f-4c3b-9fce-d8cc26d8b4a8"],"lang":"English","level":"Scientific","noi":["Local-1-1-58BD9FA81EFC0DC113B426AB558397C1"],"org":[{"affno":"1","key":"university college absalon","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-AB","l3nl":"University College Absalon","l3nn":"University College Absalon","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"University College Absalon","namevar":["Professionshøjskolen Absalon, Direktionen - Slagelse, Pædagogik og Ledelsesområdet, Læreruddannelsen - Roskilde"],"nora_code":"DI-UC-AB","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"René Boyer","key":"christiansenpau","last":"Christiansen","locid":"42204c79-a17b-4152-bd0f-e5dfbbf302d5","name":"Christiansen, René Boyer","orcid":"0000-0002-2962-7320","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anne Kristine","key":"petersenpau","last":"Petersen","locid":"f5e451f8-6385-46fb-8e71-45f37a1f7d8c","name":"Petersen, Anne Kristine","orcid":"0000-0002-3109-0227","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Randi Skovbjerg","key":"sørensenpau","last":"Sørensen","locid":"0e776e0c-4caf-46fd-b597-f1ae0df93bfd","name":"Sørensen, Randi Skovbjerg","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Dorrit","key":"hansenpau","last":"Hansen","locid":"392c5883-80e4-4cc6-a7f9-7382e2b31d81","name":"Hansen, Dorrit","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Bettina","key":"buchpau","last":"Buch","locid":"ffe5c49c-02ac-4ed2-91d7-6c9600b09f2a","name":"Buch, Bettina","orcid":"0000-0001-5496-1243","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All University Colleges","DI-ALL","DI-UC","DI-UC-ALL","University College Absalon","University Colleges"],"PST":["Published"]},"sid":["pha-b370278a-0d0f-4c3b-9fce-d8cc26d8b4a8"],"src":["AB University College Absalon"],"title":"Designing for teaching and learning in MOOCs : - Intended and implemented designs.","type":"Conference Abstract","url":"https:/