{"author_count":2,"contributors":["Hansen, Bjarke Mørkøre Stigel","Rosfort, René"],"cuid":["S01-000.00-731673"],"filters":{"added":"2024-05","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"arne grøn thinking with kierkegaard existential philosophy phenomenology and ethics","src":["ku"],"src-code":["DI-U-KU"],"type":"db","type-grp":["all","pub"]},"id":"S01-000.00-731673","ids":["ku-82d2002c-2dc6-4a1a-a57b-3f0cc5eed6db"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-851C6860E51E9C01634651C204EA8C21"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Theology, The Søren Kierkegaard Research Centre"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1 2","country":"dk","first":"Bjarke Mørkøre Stigel","key":"hansenped","last":"Hansen","locid":"2afd8110-8f1e-433f-afa0-b44bb51395d2","name":"Hansen, Bjarke Mørkøre Stigel","rank":1,"role":"Editor","rolecode":"ped"},{"affno":"1","first":"René","key":"rosfortped","last":"Rosfort","locid":"0068997b-08c9-4fd5-b4b7-89a0c17c248e","name":"Rosfort, René","orcid":"0000-0002-9766-9741","rank":2,"role":"Editor","rolecode":"ped"}],"pub":{"doi":"10.1515/9783110793895","isbn":["9783110793574"]