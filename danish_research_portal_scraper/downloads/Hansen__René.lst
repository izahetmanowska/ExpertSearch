":"e3f0c57c-605a-431a-9c63-2213c46621e6","name":"Køber, Lars","rank":11,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Scott D","key":"solomonscottdpau","last":"Solomon","name":"Solomon, Scott D","rank":12,"rolecode":"pau"},{"affno":"5","corresponding":null,"country":"dk","first":"Christian","key":"torppedersenchristianpau","last":"Torp-Pedersen","locid":"5417d806-0578-4505-b3fe-68ae0359913e","name":"Torp-Pedersen, Christian","rank":13,"rolecode":"pau"},{"affno":"4","first":"Tor","key":"bieringsørensentorpau","last":"Biering-Sørensen","locid":"2a25298f-30d3-4b37-b20b-646684a29fd8","name":"Biering-Sørensen, Tor","rank":14,"rolecode":"pau"}],"pmid":["31595294"],"pub":{"doi":"10.1093/europace/euz264","issn":["10995129","10996044"],"issn_org":["10995129"],"issue":"1","journal":"Europace","pages":"74-83","publisher":"Oxford University Press","status":"p","title":"Europace","volume":"22"},"review":"Peer Reviewed","scoID":["2-s2.0-85077666526"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-f81588e7-285d-4f2e-88d4-4f8b044a701a","ku-81df3a4d-ebec-4b05-bf3e-547baf24c692"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"Catheter ablation for atrial fibrillation is associated with lower incidence of heart failure and death","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-011846","year":"2020","yearsub":"2020"}
{"abstract":"INTRODUCTION: Headache is an extremely prevalent disorder with a lifetime prevalence of 90-99%. However, a small fraction of people never experiences a headache. Research on people without headache could uncover protective factors in headache, but to our knowledge no study on headache-free individuals has been published. We aim to estimate the prevalence of headache-free individuals among Danish blood donors, and to describe the socio-demographics and health factors of headache-free participants. MATERIALS AND METHODS: In all, 38,557 healthy volunteers were recruited as part of the Danish Blood Donor Study. Headache-free participants were identified based on the question \"Have you ever experienced a headache of any kind?\". Utilising the Danish registries and self-reported questionnaires, we analysed socio-demographic and lifestyle factors using logistic regression adjusted for age and sex. RESULTS: The prevalence of headache-free individuals was 4.1% (n = 1362) with a female-male ratio of 1:2.2. To be headache free was significantly associated with an employment status as a student, a low level of income and a regular alcohol consumption. DISCUSSION: The prevalence of headache-free individuals was comparable to population-wide studies of headache. To be headache free was not associated with a high socio-economic status. Further studies on people without headache will hopefully reveal protective factors in headache, and this novel approach might be useful in other very prevalent disorders.","author_count":14,"contributors":["Olofsson, Isa Amalie","Kogelman, Lisette","Rasmussen, Andreas","Erikstrup, Christian","Sørensen, Erik","Paarup, Helene M","Hjalmgrim, Henrik","Banasik, Karina","Nielsen, Kaspar René","Burgdorf, Kristoffer Soelvsten","Pedersen, Ole Birger Vesterager","Ullum, Henrik","Olesen, Jes","Hansen, Thomas Folkmann"],"cuid":["S04-100.00-007073"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"corresponding_author":["Hansen, Thomas Folkmann"],"keyword":["Adolescent","Adolescents","Adult","Blood Donors","Case Control Studies","Cohort","Denmark epidemiology","Diseases","Epidemiology","Female","Headache","Headache epidemiology","Humans","Life Style","Male","Middle Aged","Migraine","Pain","Prevalence","Protective Factors","Registries","Risk Factors","Selection","Socioeconomic status","Surveys and Questionnaires","Tension type headache","countries"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-OT","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA"],"OT":["Department of Epidemiological Research"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"prevalence and socio demographic characteristics of persons who have never had a headache among healthy voluntary blood donors a population based study","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/290407794/Olofsson_et_al_Prevalence_and_socio_demographic_characteristics_of_persons_who_have_never_had_a_headache_among_healthy_voluntary_blood_donors_accepted_version_.pdf","version":"Authors Final Version"},"id":"S04-100.00-007073","identifier":[{"id":"32312100","type":"pmid"},{"id":"000527753100001","type":"wos"},{"id":"85083661773","type":"scopus"}],"ids":["aau-91b3e87d-2e46-4ecf-a8be-ecc8887b7fa1","au-33cec592-f8be-4c62-81b2-cf86a852d0b7","ku-00d4d7c1-e2c5-4afa-ada4-74cde2d330c8","sdu-47bce8a0-c1cc-4299-bfd1-ffce078a0dd5"],"keyword":["ADOLESCENTS","Adolescent","Adult","COHORT","COUNTRIES","Case-Control Studies","DI