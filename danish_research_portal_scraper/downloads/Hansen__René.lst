René J","rank":3,"rolecode":"pau"},{"affno":"3 2","corresponding":null,"first":"Michael","key":"kosteljanetzpau","last":"Kosteljanetz","name":"Kosteljanetz, Michael","rank":4,"rolecode":"pau"},{"affno":"7 8","corresponding":null,"first":"Henrik","key":"schultzpau","last":"Schultz","locid":"d960f07d-b246-4eb1-ac8b-61d395f98d55","name":"Schultz, Henrik","rank":5,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Bente Mertz","key":"nørgårdpau","last":"Nørgård","locid":"3d41d6fb-8f1c-4899-9ebd-b72f88e3935d","name":"Nørgård, Bente Mertz","orcid":"0000-0002-9514-3033","rank":6,"rolecode":"pau"},{"affno":"4 9","corresponding":null,"first":"Rikke","key":"guldbergpau","last":"Guldberg","locid":"971944ff-2c6b-4abc-9bb0-d914d8e42778","name":"Sørensen, Rikke Guldberg","name_org":"Guldberg, Rikke","rank":7,"rolecode":"pau"},{"affno":"4 9","corresponding":null,"first":"Kim Oren","key":"gradelpau","last":"Gradel","locid":"1d28d7bc-60bb-46f5-8143-bc6508387a8f","name":"Gradel, Kim Oren","orcid":"0000-0002-5611-2031","rank":8,"rolecode":"pau"}],"pmid":["28861666"],"pub":{"doi":"10.1007/s11060-017-2607-5","issn":["0167594X","15737373"],"issn_org":["0167594X"],"issue":"3","journal":"Journal of Neuro-Oncology","pages":"571-579","publisher":"Springer Science+Business Media","status":"p","title":"Journal of Neuro-Oncology","volume":"135"},"review":"Peer Reviewed","scoID":["2-s2.0-85028775705"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","North Denmark Region","Other Research","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-e3ea629f-a22a-47bd-827e-2d2b0498cfbb","au-5c1f093e-5479-4142-9acc-c306a147f319","sdu-3eaf4eee-d61b-4144-9a3a-7c9080f45cf9"],"src":["AAU Aalborg University","AU Aarhus University","SDU University of Southern Denmark"],"title":"Epidemiology of glioma : clinical characteristics, symptoms, and predictors of glioma patients grade I-IV in the the Danish Neuro-Oncology Registry","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-098.67-010900","year":"2017","yearsub":"2017"}
{"abstract":"PURPOSE: Epilepsy surgery is performed based on the assumption that medical refractory epilepsy will continue. Rarely seizure freedom occurs before surgery is performed, while the patient is being evaluated as an epilepsy surgery candidate. The aim of this study was to describe the number of children withdrawn from an epilepsy surgery programme due to unexpected seizure improvement. METHODS: We retrospectively studied 173 children under 18 years with medical refractory epilepsy referred for epilepsy surgery between 1996 and 2010. Medical records were reviewed in 2012 and 2015. RESULTS: At the first evaluation point in 2012, 13 patients were withdrawn from the epilepsy surgery programme due to unexpected marked improvement. In 2015, 6 of them were still seizure free. They had unexpected seizure freedom due to change in AED treatment (n=3) or after a febrile episode (n=3). The mean number of years they had had seizures was 3.4 years (range 0.6-6.2 years) and the number of seizures at inclusion was 209 per month (range 6-750 per month). The duration of follow-up was 6.6 years after inclusion into the epilepsy surgery programme (range 4.0-13.0 years). The aetiology of the epilepsy for these patients was heterotopia (n=1), focal cortical dysplasia (n=3), infarction (n=1) and unknown, with normal MRI (n=1). They all had an IQ in the normal range. Two of the remaining 7 children were operated later. CONCLUSION: Unexpected seizure control may occur during epilepsy surgery evaluation.","author_count":3,"contributors":["Hoei-Hansen, Christina E","Mathiasen, René","Uldall, Peter"],"cuid":["S01-000.00-420964"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Adolescent","Anticonvulsants adverse effects","Child","Child Preschool","Drug Resistant Epilepsy diagnostic imaging","Female","Humans","Male","Neuroimaging","Preoperative Period","Retrospective Studies","Seizures diagnostic imaging"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"unexpected marked seizure improvement in paediatric epilepsy surgery candidates","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-420964","identifier":[{"id":"85002083587","type":"scopus"},{"id":"27940351","type":"pmid"}],"ids":["ku-2e2d61ab-01ac-4c7b-bc4e-72f1945e9c30"],"keyword":["Adolescent","Anticonvulsants/adverse effects","Child","Child, Preschool","Drug Resistant Epilepsy/diagnostic imaging","Female","Humans","Male","Neuroimaging","Preoperative Period","Retrospective Studies","Seizures/diagnostic imaging"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-51F45A1A2D6201B86B45DD109DDB508E"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Christina E","key":"hoeihansenpau","last":"Hoei-Hansen","name":"Hoei-Hansen, Christina E","rank":1,"rolecode":"pau"},{"affno":"","first":"René","key":"mathiasenpau","last":"Mathiasen","name":"Mathiasen, René","rank":2,"rolecode":"pau"},{"affno":"1","first":"Peter","key":"uldallpau","last":"Uldall","locid":"f65ba59d-28a4-4c8a-9f83-9809a983951b","name":"Uldall, Peter","rank":3,"rolecode":"pau"}],"pmid":["27940351"],"pub":{"doi":"10.1016/j.seizure.2016.11.020","issn":["10591311","15322688"],"issn_org":["10591311"],"journal":"Seizure","pages":"70-73","sta