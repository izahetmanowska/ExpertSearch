{"abstract":"Recommendations for antibiotic treatment of acute otitis media (AOM) have changed over the years, and today many experts recommend initial observation. However, antibiotic prescribing should be considered in children aged","author_count":7,"contributors":["Hansen, Malene Plejdrup","Jarbøl, Dorte Ejg","Gahrn-Hansen, Bente","Christensen, René dePont","Munck, Anders","Ellegaard Trankjær Ryborg, Christina","Bjerrum, Lars"],"cuid":["S01-000.00-591792"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Adolescent","Adult","Anti Bacterial Agents","Argentina","Child","Child Preschool","Europe","Female","General practice","Humans","Infant","Male","Middle Aged","Otitis media","Physician s Practice Patterns","Prospective Studies","Quality Assurance Health Care","Registries"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"treatment of acute otitis media in general practice quality variations across countries","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1093/fampra/cmr042","version":"Other Version"},"id":"S01-000.00-591792","identifier":[{"id":"21817089","type":"pmid"},{"id":"84856140636","type":"scopus"}],"ids":["sdu-40c9e6d0-2b37-4cb7-ba6c-1698efccfe10"],"keyword":["Adolescent","Adult","Anti-Bacterial Agents","Argentina","Child","Child, Preschool","Europe","Female","General Practice","Humans","Infant","Male","Middle Aged","Otitis Media","Physician's Practice Patterns","Prospective Studies","Quality Assurance, Health Care","Registries"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-26D85BA8389E96E07F3410BA2A3D3843"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1093/fampra/cmr042"