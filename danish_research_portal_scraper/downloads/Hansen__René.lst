olecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Mads Peter","key":"karlsenpau","last":"Karlsen","locid":"b9d8e839-6435-45a8-b2af-440a8a65aa53","name":"Karlsen, Mads Peter","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"René","key":"rosfortpau","last":"Rosfort","name":"Rosfort, René","rank":3,"rolecode":"pau"},{"affno":"","first":"Bjarke Mørkøre","key":"stigelhansenpedh","last":"Stigel Hansen","name":"Stigel Hansen, Bjarke Mørkøre","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Mads Peter","key":"karlsenpedh","last":"Karlsen","name":"Karlsen, Mads Peter","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"René","key":"rosfortpedh","last":"Rosfort","name":"Rosfort, René","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9788741005218"],"pages":"7-8","place":"Frederiksberg","publisher":"Eksistensen Akademisk","status":"p","subtitle":"Eksistentiel hermeneutik. Bind 1","title":"Filosofiske essays af Arne Grøn"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["cbs-2cb2433c-8d8b-448d-8197-4cf39935d7c5"],"src":["CBS Copenhagen Business School"],"title":"Forord","type":"Book Preface, Encycl. Entry","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-279610","year":"2019","yearsub":"2019"}
{"abstract":"The objective of this study was to investigate the impact of endo- and exo-peptidase treatment on certain structural characteristics of peptides and volatile compounds of porcine hemoglobin and whole blood hydrolysates. Porcine hemoglobin and whole blood were hydrolyzed by endo- and exo-peptidases. The presence of exopeptidases reduced the bitterness and altered the volatile profiles of protein hydrolysates. Exopeptidase treatment can release terminal amino acids from peptides, which in turn may contribute to formation of volatile compounds by Maillard reactions. In contrast, endopeptidases conferred a slightly bitter taste and different volatile profiles. For hemoglobin hydrolysates, principal component analysis revealed that proteases were categorized into three groups based on endo- or exo-peptidase activity. Whole blood is a more complex raw material, yet the proteases were still categorized in a similar fashion. This work contributes to understanding structural characteristics responsible for taste and volatile profiles of protein hydrolysates.","author_count":10,"contributors":["Fu, Yu","Bak, Kathrine Holmgaard","Liu, Jing","De Gobba, Cristian","Tøstesen, Marie","Hansen, Erik T.","Petersen, Mikael Agerlin","Ruiz Carrascal, Jorge","Bredie, Wender","Lametsch, Rene"],"cuid":["S01-000.00-398585"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Blood","Exopeptidase","Hemoglobin","Protein hydrolysates","Taste","Volatile compounds"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-PR-OTH","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"protein hydrolysates of porcine hemoglobin and blood peptide characteristics in relation to taste attributes and formation of volatile compounds","src":["ku"],"src-code":["DI-U-KU"],"type":"dja