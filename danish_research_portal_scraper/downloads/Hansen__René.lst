:"sveinssonolafurapau","last":"Sveinsson","name":"Sveinsson, Olafur A","rank":56,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Sisse R","key":"ostrowskisisserpau","last":"Ostrowski","name":"Ostrowski, Sisse R","rank":57,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hilma","key":"holmhilmapau","last":"Holm","name":"Holm, Hilma","rank":58,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Daniel F.","key":"gudbjartssondanielfpau","last":"Gudbjartsson","name":"Gudbjartsson, Daniel F.","rank":59,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Gudmar","key":"thorleifssongudmarpau","last":"Thorleifsson","name":"Thorleifsson, Gudmar","rank":60,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Patrick","key":"sulempatrickpau","last":"Sulem","name":"Sulem, Patrick","rank":61,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hreinn","key":"stefanssonhreinnpau","last":"Stefansson","name":"Stefansson, Hreinn","rank":62,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thorgeir E","key":"thorgeirssonthorgeirepau","last":"Thorgeirsson","name":"Thorgeirsson, Thorgeir E","rank":63,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Thomas F","key":"hansenthomasfpau","last":"Hansen","name":"Hansen, Thomas F","rank":64,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kari","key":"stefanssonkaripau","last":"Stefansson","name":"Stefansson, Kari","rank":65,"rolecode":"pau"},{"affno":"24","corresponding":null,"country":"dk","first":"Mette","key":"nyegaardmetteoth","last":"Nyegaard","locid":"c048a688-cd64-40ca-a277-53f16360f7a1","name":"Nyegaard, Mette","orcid":"0000-0003-4973-8543","rank":66,"role":"Other","rolecode":"oth"},{"affno":"24","corresponding":null,"country":"dk","first":"Palle Duun","key":"rohdepalleduunoth","last":"Rohde","locid":"fb6ff2cf-6e9c-4d3f-a461-8a834cc0b141","name":"Rohde, Palle Duun","orcid":"0000-0003-4347-8656","rank":67,"role":"Other","rolecode":"oth"}],"pmid":["37884687"],"pub":{"doi":"10.1038/s41588-023-01538-0","issn":["10614036","15461718"],"issn_org":["10614036"],"issue":"11","journal":"Nature Genetics","pages":"1843-1853","publisher":"Nature Research","status":"p","title":"Nature Genetics","volume":"55"},"review":"Peer Reviewed","scoID":["2-s2.0-85174915851"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","North Denmark Region","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-3dde059d-6010-49c8-851f-2dcba23c2bf6","au-da5cf8e1-d180-42d9-a439-9252daeb6322","ku-2951c4b0-8c4a-44fb-8d66-15c4fba70b29","sdu-92efa4eb-7bca-42cd-ab04-976273bcfee0"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Rare variants with large effects provide functional insights into the pathology of migraine subtypes, with and without aura","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-096.28-715639","year":"2023","yearsub":"2023"}
{"abstract":"OBJECTIVES: Osteoarthritis is a common and severe, multifactorial disease with a well-established genetic component. However, little is known about how genetics affect disease progression, and thereby the need for joint placement. Therefore, we aimed to investigate whether the genetic associations of knee and hip osteoarthritis differ between patients treated with joint replacement and patients without joint replacement. METHODS: We included knee and hip osteoarthritis cases along with healthy controls, altogether counting >700 000 individuals. The cases were divided into two groups based on joint replacement status (surgical vs non-surgical) and included in four genome-wide association meta-analyses: surgical knee osteoarthritis (N = 22 525), non-surgical knee osteoarthritis (N = 38 626), surgical hip osteoarthritis (N = 20 221) and non-surgical hip osteoarthritis (N = 17 847). In addition, we tested for genetic correlation between the osteoarthritis groups and the pain phenotypes intervertebral disc disorder, dorsalgia, fibromyalgia, migraine and joint pain. RESULTS: We identified 52 sequence variants associated with knee osteoarthritis (surgical: 17, non-surgical: 3) or hip osteoarthritis (surgical: 34, non-surgical: 1). For the surgical phenotypes, we identified 10 novel variants, including genes involved in autophagy (rs2447606 in ATG7) and mechanotransduction (rs202127176 in PIEZO1). One variant, rs13107325 in SLC39A8, associated more strongly with non-surgical knee osteoarthritis than surgical knee osteoarthritis. For all other variants, significance and effect sizes were higher for the surgical phenotypes. In contrast, genetic correlations with pain phenotypes tended to be stronger in the non-surgical groups. CONCLUSIONS: Our results indicate differences in genetic associations between knee and hip osteoarthritis depending on joint replacement status.","author_count":23,"contributors":["Henkel, Cecilie","Styrkársdóttir, Unnur","Thorleifsson, Gudmar","Stefánsdóttir, Lilja","Björnsdóttir, Gyda","Banasik, Karina","Brunak, Søren","Erikstrup, Christian","Dinh, Khoa Manh","Hansen, Thomas Folkmann","Nielsen, Kaspar René","Bruun, Mie Topholm","Dowsett, Joseph","Brodersen, Thorsten","Thorgeirsson, Thorgeir E","Gromov, Kirill","Boesen, Mikael Ploug","Ullum, Henrik","Ostrowski, Sisse Rye","Pedersen, Ole Birger","Stefánsson, Kári","Troelsen, Anders","Nyegaard, Mette"],"cuid":["S04-099.63-003030"],"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"continent":["Europe, Non-EU","Nordic","OECD"],"corpau":["DBDS Genomic Consortium","Danish Blood Donor Study Genomic Consortium"],"corresponding_author":["Henkel, Cecilie"],"country":["Iceland"],"glorg":["All Global Affiliations","deCODE Genetics"],"keyword":["Arthroplasty Replacement Hip","Arthroplasty Replacement Knee","Genome Wide Association Study","Humans","Ion channels","Knee Joint surgery","Mechanotransduction Cellular","Orthopedic Procedures","Osteoarthritis","Osteoarthritis Hip genetics","Osteoarthritis Knee","Pain","Polymorphism Genetic"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-OT","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA"],"OT":["Greater Copenhagen Health Science Partners"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"genome wide association meta analysis of knee and hip osteoarthritis uncovers genetic differences between patients treated with joint replacement and patients without joint replacement","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","typ