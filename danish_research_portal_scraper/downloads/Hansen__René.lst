pau"},{"affno":"1 2","first":"Kjeld","key":"schmiegelowpau","last":"Schmiegelow","locid":"6ce2f948-244d-4f19-82aa-f08a71289674","name":"Schmiegelow, Kjeld","rank":14,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"René","key":"mathiasenpau","last":"Mathiasen","name":"Mathiasen, René","rank":15,"rolecode":"pau"},{"affno":"1 2","first":"Karin","key":"wadtpau","last":"Wadt","locid":"f0aafc9d-1182-4952-871c-91446d121a5b","name":"Wadt, Karin","rank":16,"rolecode":"pau"}],"pmid":["35902210"],"pub":{"doi":"10.1093/neuonc/noac187","issn":["15228517","15235866"],"issn_org":["15228517"],"issue":"4","journal":"Neuro-Oncology","pages":"761-773","paperid":"noac187","publisher":"Oxford University Press","status":"p","title":"Neuro-Oncology","volume":"25"},"review":"Peer Reviewed","scoID":["2-s2.0-85160264797"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-3344e068-fbd3-49b8-b092-52eaa61a7572","au-a48fb786-b53f-4a3f-845c-c8c46eb17355","ku-08475c4c-673a-4fbf-add1-10cdf35bb5e8","sdu-dd384395-8432-42fc-8fae-13025a461a93"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Genetic predisposition and evolutionary traces of pediatric cancer risk : A prospective 5-year population-based genome sequencing study of children with CNS tumors","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-099.53-681219","year":"2023","yearsub":"2023"}
{"abstract":"Hidradenitis suppurativa (HS) is a chronic inflammatory skin disease associated with psychiatric comorbidity. Attention deficit hyperactivity disorder (ADHD) is a mental disorder associated with systemic and skin inflammation such as psoriasis and atopic dermatitis. Whether HS symptoms are associated with ADHD symptoms remains unexplored. Thus, the aim of this study was to explore the possible association between HS and ADHD. Participants in the Danish Blood Donor Study (DBDS) were included in this cross-sectional study during 2015–2017. The participants provided questionnaire data on screening items of HS, ADHD symptoms (ASRS-score), and depressive symptoms, smoking and body mass index (BMI). A logistic regression with HS symptoms as a binary outcome predicted by ADHD adjusted for age, sex, smoking, BMI, and depression was conducted to investigate the association between HS and ADHD. A total of 52,909 Danish blood donors were included in the study. Of these were 1004/52,909 (1.9%) considered participants with HS. Of the participants with HS, 74/996 (7.4%) screened positive of ADHD symptoms, while only 1786/51,129 (3.5%) of the participants without HS screened positive of ADHD. Adjusted for confounders, ADHD was positively associated with HS, odds ratio 1.85 (95% confidence interval: 1.43–2.37). Psychiatric comorbidity of HS is not limited to depression and anxiety. This study shows a positive association between HS and ADHD. Further research on the biological mechanisms behind this association is warranted.","author_count":16,"contributors":["Lindsø Andersen, Pernille","Villumsen, Bente","Saunte, Ditte Marie Lindhardt","Burgdorf, Kristoffer Sølvsten","Didriksen, Maria","Ostrowski, Sisse Rye","Thørner, Lise Wegner","Erikstrup, Christian","Dinh, Khoa Manh","Nielsen, Kaspar René","Brodersen, Thorsten","Bruun, Mie Topholm","Banasik, Karina","Hansen, Thomas Folkmann","Pedersen, Ole Birger","Jemec, Gregor Borut"],"cuid":["S04-100.00-681314"],"filters":{"added":"2023-05","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"corresponding_author":["Lindsø Andersen, Pernille"],"keyword":["ADHD","Acne inversa","Epidemiology","Hidradenitis suppurativa","Psychiatry"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA"],"OT":["Patientforeningen HS Danmark"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"symptoms of attention deficit hyperactivity disorder are associated with hidradenitis suppurativa in danish blood donors","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85149259313","version":"Other Version"},"funding_acknowledgement":["The Danish Blood Donor Study is funded by: The Danish Council for Independent Research—Medical Sciences (grant number: 09–069412); The Danish Administrative Regions ( http://www.regioner.dk ); The Danish Bio- and Genome Bank ( http://www.regioner.dk/rbgben ). None of the funders had any influence on study design, data collection and analysis, decision to publish, or preparation of this manuscript."],"id":"S04-100.00-681314","identifier":[{"id":"36867221","type":"pmid"},{"id":"85149259313","type":"scopus"},{"id":"000943358700002","type":"wos"}],"ids":["aau-e3ea7b73-c620-4687-8255-b9cbe5a472f5","au-83653372-a3e3-4d40-8416-f59f186a3efd","ku-6b19bedd-e720-4d50-9028-2ffaa1124674","sdu-eb64f9da-d1a7-4c2d-b29a-cbe11cfeef30"],"keyword":["ADHD","Acne inversa","Epidemiology","Hidradenitis suppurativa","Psychiatry"],"lang":"English","level":"Scientific","mra":["Medical Science"],