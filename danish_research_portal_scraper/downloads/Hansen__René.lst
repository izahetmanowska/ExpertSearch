d8cdf50c-86be-4cbc-bed1-575a8bdce5da","name":"Thomsen, Ingrid Kaag","orcid":"0000-0002-5108-5847","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Iris Vogeler","key":"croninpau","last":"Cronin","locid":"4f2cab3c-2b5f-46e2-bb9a-82c82fd3631c","name":"Vogeler, Iris","name_org":"Cronin, Iris Vogeler","orcid":"0000-0003-2512-7668","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"René","key":"gislumpau","last":"Gislum","locid":"cad294b9-9707-4ac9-9596-aaae83673a95","name":"Gislum, René","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rene","key":"larsenpau","last":"Larsen","locid":"ba891826-c0f2-41e5-a001-1841bc2cf2b5","name":"Larsen, Rene","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders Krogh","key":"mortensenpau","last":"Mortensen","locid":"22840a8d-e830-4b65-91b1-665adaa6bddc","name":"Mortensen, Anders Krogh","rank":6,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-7a5acbfa-3563-4d74-af46-107d3a8d1aa6"],"src":["AU Aarhus University"],"title":"Opdatere trappemodel om dækningsgrad af efterafgrøder ved kontrol i forhold til etableringstidspunkt","type":"Memorandum/Exposition","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-668318","year":"2023","yearsub":"2023"}
{"abstract":"Implant-associated osteomyelitis is one of the most feared complications following orthopedic surgery. Although the risk is low, sufficient antibiotic protection of the implant surface is important. The aim of this study was to assess steady-state piperacillin concentrations in the proximity of an orthopedic implant. Time above the minimal inhibitory concentration (fT>MIC) was evaluated for MIC of 8 (low target) and 16 μg/mL (high target). Six female pigs received an intravenous bolus infusion of 4 g/0.5 g piperacillin/tazobactam over 30 min every 6 h. Steady state was assumed achieved in the third dosing interval (12–18 h). Microdialysis catheters were placed in a cannulated screw in the proximal tibial cancellous bone, in cancellous bone next to the screw, and in cancellous bone on the contralateral tibia. Dialysates were collected from time 12 to 18 h and plasma samples were collected as reference. For the low piperacillin target (8 µg/mL), comparable mean fT>MIC across all the investigated compartments (mean range: 54–74%) was found. For the high target (16 µg/mL), fT>MIC was shorter inside the cannulated screw (mean: 16%) than in the cancellous bone next to the screw and plasma (mean range: 49–54%), and similar between the two cancellous bone compartments. To reach more aggressive piperacillin fT>MIC targets in relation to the implant, alternative dosing regimens such as continuous infusion may be considered.","author_count":9,"contributors":["Lilleøre, Johanne Gade","Jørgensen, Andrea René","Knudsen, Martin Bruun","Hanberg, Pelle","Öbrink-Hansen, Kristina","Tøstesen, Sara Kousgaard","Søballe, Kjeld","Stilling, Maiken","Bue, Mats"],"cuid":["S01-000.00-668646"],"filters":{"added":"2023-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Lilleøre, Johanne Gade"],"keyword":["Implants","Microdialysis","Osteomyelitis","Piperacillin","Steady state"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"steady state piperacillin concentrations in the proximity of an orthopedic implant a microdialysis porcine study","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/antibiotics12030615","version":"Published Version"},"id":"S01-000.00-668646","identifier":[{"id":"PMC10045023","type":"pmcid"},{"id":"36978481","type":"pmid"},{"id":"85151700242","type":"scopus"}],"ids":["au-c127f7e4-6cf0-44c4-8c24-531b4ae23c3b"],"keyword":["implants","microdialysis","osteomyelitis","piperacillin","steady state","tazobactam"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-0F8280695987D82B25B5EC5B198E5154"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/antibiotics12030615","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Orthopaedic surgery"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Johanne Gade","key":"lilleørepau","last":"Lilleøre","locid":"d7d315be-9bd0-4b10-b99f-7f6b7bd6d07b","name":"Lilleøre, Johanne Gade","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Andrea René","key":"jørgensenpau","last":"Jørgensen","locid":"105e5e1d-0600-4cd5-94cb-68291474afab","name":"Jørgensen, Andrea René","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Martin Bruun","key":"knudsenpau","last":"Knudsen","locid":"2ea83f79-a875-4f1c-b1ff-12dc504ed698","name":"Knudsen, Martin Bruun","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Pelle","key":"hanbergpau","last":"Hanberg","locid":"242cb61c-bb82-4d48-9af7-8c84a17ab00e","name":"Hanberg, Pelle","orcid":"0000-0002-6845-1874","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kristina","key":"öbrinkhansenpau","last":"Öbrink-Hansen","locid":"ad46bc19-97e8-4c7c-aab9-c4e569877dad","name":"Öbrink-Hansen, Kristina","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sara Kousgaard","key":"tøstesenpau","last":"Tøstesen","locid":"fe641f6e-6c0d-4bcc-a6d7-862158d0831c","name":"Tøstesen, Sara Kousgaard","orcid":"0000-0002-2960-2342","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kjeld","key":"søballepau","last":"Søballe","locid":"288247bb-1768-4f37-a538-18727fed269b","name":"Søballe, Kjeld","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Maiken","key":"stillingpau","last":"Stilling","locid":"bb005d3f-27c9-4157-8101-db5059373d32","name":"Stilling, Maiken","orcid":"0000-0002-4530-2075","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mats","key":"buepau","last":"Bue","locid":"2a35a61c-3bf9-4bf7-9569-73178247b08c","name":"Bue, Mats","orcid":"0000-0001-7215-8323","rank":9,"rolecode":"pau"}],"pmid":["36978481"],"pub":{"doi":"10.3390/antibiotics12030615","issn":["20796382"],"issue":"3","journal":"Antibiotics","paperid":"615","publisher":"Multidisciplinary Digital Publishing Institute (MDPI)","status":"p","title":"Antibiotics","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-85151700242"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-c127f7e4-6cf0-44c4-8c24-531b4ae23c3b"],"src":["AU Aarhus University"],"title":"Steady-State Piperacillin Concentrations in the Proximity of an Orthopedic Implant : A Microdialysis Porcine Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-668646","year":"2023","yearsub":"2023"}
{"abstract":"Background: Pulsed field ablation (PFA) is a novel method of cardiac ablation demonstrated in early pre-clinical and clinical settings. The aim of this study was to report the safety and clinical efficacy of pulmonary vein isolation (PVI) with PFA for real-world atrial fibrillation (AF) patients. Methods: All-comer AF patients (n = 121, 59% paroxysmal) were prospectively included and underwent PFA with 100% high-density voltage maps performed after PVI. Clinical outcomes were gathered by chart review. Results: PVI was achieved with PFA-only in 119 (98%) of the cases. During the implementation phase the mean procedure and fluoroscopy time was reduced from 85 ± 34 to 72 ± 18 min (p = 0.044) and 22 ± 9 to 16 ± 4 (p = 0.034). We observed one phrenic nerve palsy with only partial remission at follow-up. Other adverse events were numerically comparable to standard PVI procedures. Over a mean follow-up of 308 ± 87 days, a total of 22/121 (18.2%) cases experienced clinically significant recurrence or initiation of anti-arrhythmic drugs with Kaplan–Meier event-free estimate at 365 days of 80% (88% for paroxysmal versus 69% for persistent). In five of eight re-do procedures, gaps were primarily located at the right pulmonary veins. Conclusions: PFA was a highly efficient method to achieve PVI with reductions in procedure time and fluoroscopy over the implementation period. The procedural data and clinical recurrence rates from initial trials were confirmed in real-life non-selected AF patients. More data is needed to establish lesion durability and limitations of PFA.","author_count":6,"contributors":["Ruwald, Martin H.","Johannessen, Arne","Hansen, Morten Lock","Haugdal, Martin","Worck, Rene","Hansen, Jim"],"cuid":["S01-000.00-702240"],"filters":{"added":"2023-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Atrial fibrillation","Electrophysiology","High density","Mapping","Pulsed field ablation","Recurrence rate","Safety"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"pulsed field ablation in real world atrial fibrillation patients clinical recurrence operator learning curve and re do procedural findings","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-702240","identifier":[{"id":"85147709857","type":"scopus"},{"id":"36753029","type":"pmid"}],"ids":["ku-bdbfe7a6-db57-4e0b-a6a2-25b4ec5cee94"],"keyword":["Atrial fibrillation","Electrophysiology","High density","Mapping","Pulsed field ablation","Recurrence rate","Safety"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-6C5DB00A337B5D0A1D5C5D1A66B5E092"],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Herlev and Gentofte"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal medicine: Cardiology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Martin H.","key":"ruwaldmartinhpau","last":"Ruwald","name":"Ruwald, Martin H.","rank":1,"rolecode":"pau"},{"affno":"1","first":"Arne","key":"johannessenarnepau","last":"Johannessen","name":"Johannessen, Arne","rank":2,"rolecode":"pau"},{"affno":"2","first":"Morten Lock","key":"hansenmortenlockpau","last":"Hansen","locid":"870786a1-f42f-40fa-b820-1608236b578c","name":"Hansen, Morten Lock","rank":3,"rolecode":"pau"},{"affno":"1","first":"Martin","key":"haugdalmartinpau","last":"Haugdal","name":"Haugdal, Martin","rank":4,"rolecode":"pau"},{"affno":"1","first":"Rene","key":"worckrenepau","last":"Worck","name":"Worck, Rene","rank":5,"rolecode":"pau"},{"affno":"1","first":"Jim","key":"hansenjimpau","last":"Hansen","name":"Hansen, Jim","rank":6,"rolecode":"pau"}],"pmid":["36753029"],"pub":{"doi":"10.1007/s10840-023-01495-y","issn":["1383875X","15728595"],"issn_org":["1383875X"],"issue":"8","journal":"Journal of Interventional Cardiac Electrophysiology","pages":"1837-1848","status":"p","title":"Journal of Interventional Cardiac Electrophysiology","volume":"66"},"review":"Peer Reviewed","scoID":["2-s2.0-85147709857"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-bdbfe7a6-db57-4e0b-a6a2-25b4ec5cee94"],"src":["KU University of Copenhagen"],"title":"Pulsed field ablation in real-world atrial fibrillation patients : clinical recurrence, operator learning curve and re-do procedural findings","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-702240","year":"2023","yearsub":"2023"}
{"abstract":"Pulsed field electroporation (PFE) has earned substantial attention owing to its unique, non–thermal tissue–preferential mechanism for cardiac ablation of arrhythmias and is used increasingly for pulmonary vein isolation.1, 2, 3 Recently, a pulsed electrical field delivery system consisting of a proprietary generator coupled to specified ablation catheters and 3D electroanatomical mapping systems obtained CE approval for pulmonary vein isolation in patients with paroxysmal atrial fibrillation based on results of the ECLIPSE trial.4 The utility of this system for mapping and ablation in human ventricular myocardium in the clinical setting of ventricular arrhythmias was recently reported in case form.5 In this case we present the first successful use of PFE for focal endocardial ablation of premature contractions from the left ventricle following extensive unsuccessful attempts at radiofrequency ablation (RFA) in the same procedure. Thus, in a direct intraprocedural comparison, focal PFE was superior to RFA, indicating a promising role for this ablation modality in the future treatment of ventricular arrhythmias.","author_count":6,"contributors":["Hansen, Jim","Haugdal, Martin A.","Johannessen, Arne","Hansen, Morten Lock","Worck, Rene","Ruwald, Martin H."],"cuid":["S01-000.00-720023"],"filters":{"added":"2024-02","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["3D mapping","Electrogram","Electroporation","Premature ventricular contractions","Pulsed field ablation","Ventricular arrhythmia"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"focal pulsed field electroporation of left ventricular premature contractions after failed radiofrequency ablation","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.hrcr.2023.05.019","version":"Published Version"},"id":"S01-000.00-720023","identifier":[{"id":"85163371334","type":"scopus"},{"id":"37614400","type":"pmid"},{"id":"PMC10444564","type":"pmcid"}],"ids":["ku-42f798e4-0040-4fbc-9f8c-cd7be4bb8a88"],"keyword":["3D mapping","Electrogram","Electroporation","Premature ventricular contractions","Pulsed field ablation","Ventricular arrhythmia"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-B521B48E9F83F5A0C893CCEE1894F62A"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/374566593/1_s2.0_S2214027123001318_main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.hrcr.2023.05.019","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Herlev and Gentofte"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal medicine: Cardiology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Jim","key":"hansenjimpau","last":"Hansen","name":"Hansen, Jim","rank":1,"rolecode":"pau"},{"affno":"1","first":"Martin A.","key":"haugdalmartinapau","last":"Haugdal","name":"Haugdal, Martin A.","rank":2,"rolecode":"pau"},{"affno":"1","first":"Arne","key":"johannessenarnepau","last":"Johannessen","name":"Johannessen, Arne","rank":3,"rolecode":"pau"},{"affno":"2","first":"Morten Lock","key":"hansenmortenlockpau","last":"Hansen","locid":"870786a1-f42f-40fa-b820-1608236b578c","name":"Hansen, Morten Lock","rank":4,"rolecode":"pau"},{"affno":"1","first":"Rene","key":"worckrenepau","last":"Worck","name":"Worck, Rene","rank":5,"rolecode":"pau"},{"affno":"1","first":"Martin H.","key":"ruwaldmartinhpau","last":"Ruwald","name":"Ruwald, Martin H.","rank":6,"rolecode":"pau"}],"pmid":["37614400"],"pub":{"doi":"10.1016/j.hrcr.2023.05.019","issn":["22140271"],"issue":"8","journal":"HeartRhythm Case Reports","status":"p","title":"HeartRhythm Case Reports","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-85163371334"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-42f798e4-0040-4fbc-9f8c-cd7be4bb8a88"],"src":["KU University of Copenhagen"],"title":"Focal pulsed field electroporation of left ventricular premature contractions after failed radiofrequency ablation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-720023","year":"2023","yearsub":"2023"}
{"abstract":"OBJECTIVES: To identify and prioritize technical procedures for simulation-based training to be integrated into the thoracic surgical curriculum. METHODS: A 3-round Delphi survey was conducted from February 2022 to June 2022 among 34 key opinion leaders in thoracic surgery from 14 countries worldwide. The 1st round was a brainstorming phase to identify technical procedures that a newly qualified thoracic surgeon should be able to perform. All the suggested procedures were categorized, qualitatively analysed and sent to the 2nd round. The second round investigated: the frequency of the identified procedure at each institution, the number of thoracic surgeons that should be able to perform these procedures, the degree of risk to the patient if the procedure is performed by a non-competent thoracic surgeon and the feasibility of simulation-based education. In the 3rd round, elimination and re-ranking of the procedures from the 2nd round were performed. RESULTS: Response rates in the 3 iterative rounds were 80% (28 out of 34), 89% (25 out of 28) and 100% (25 out of 25) in the 1st, 2nd and 3rd round, respectively. Seventeen technical procedures were included for simulation-based training in the final prioritized list. The top 5 procedures were Video-Assisted Thoracoscopic Surgery (VATS) lobectomy, VATS segmentectomy, VATS mediastinal lymph node dissection, diagnostic flexible bronchoscopy and robotic-assisted thoracic surgery port placement, robotic-assisted thoracic surgery docking and undocking. CONCLUSIONS: The prioritized list of procedures represents a consensus of key thoracic surgeons worldwide. These procedures are suitable for simulation-based training and should be integrated in the thoracic surgical curriculum.","author_count":10,"contributors":["Haidari, Tamim Ahmad","Nayahangan, Leizl Joy","Bjerrum, Flemming","Hansen, Henrik Jessen","Konge, Lars","Massard, Gilbert","Batirel, Hasan Fevzi","Novoa, Nuria Maria","Milton, Richard Stephen","Petersen, René Horsleben"],"cuid":["S03-091.72-704336"],"filters":{"added":"2023-07","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"continent":["Asia, Middle East","Europe, EU","Europe, Non-EU","OECD"],"corpau":["Delphi","participants Delphi"],"corresponding_author":["Petersen, René Horsleben"],"country":["Luxembourg","Spain","Turkey","United Kingdom"],"glorg":["All Global Affiliations","Biruni Universitesi","Biruni University","Hospital Clínico Universitario de Salamanca","Leeds Teaching Hospitals NHS Trust","Les Hôpitaux Robert Schuman","St James’s University Hospital","University Hospital of Salamanca","University of Luxembourg"],"keyword":["Consensus","Core curriculum","Delphi Technique","Education","Humans","Needs Assessment","Simulation Training","Thoracic Surgery Video Assisted","Thoracic surgery"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"consensus on technical procedures for simulation based training in thoracic surgery an international needs assessment","src":["au","ku","sdu"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85159245149","version":"Other Version"},"id":"S03-091.72-704336","identifier":[{"id":"85159245149","type":"scopus"},{"id":"36808223","type":"pmid"}],"ids":["au-d6bce9e3-e4ff-46f0-996d-fc9872e98153","ku-122c527c-7b14-416c-95d4-4955869c10cd","sdu-5500bd41-5dc2-4e97-b77a-6c683bd85d30"],"keyword":["Consensus","Core curriculum","Delphi Technique","Education","Humans","Needs assessment","Simulation training","Thoracic Surgery","Thoracic Surgery, Video-Assisted"],"lang":"English","level":