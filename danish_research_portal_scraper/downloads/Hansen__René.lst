inssonsunepau","last":"Thorsteinsson","locid":"831fbf16-0dba-4594-b98f-b52bcb84874c","name":"Thorsteinsson, Sune","orcid":"0000-0002-8942-3784","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren Stentoft","key":"hansensørenstentoftpau","last":"Hansen","locid":"019e2883-3fbb-4a0d-9013-d7ccdd8ff6ed","name":"Hansen, Søren Stentoft","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper","key":"wolffjesperpau","last":"Wolff","locid":"f9f1640e-7452-4ef0-a23f-7f92bdfa5931","name":"Wolff, Jesper","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christian","key":"bakchristianpau","last":"Bak","locid":"229105fd-32e3-4406-aa69-606edcf0788e","name":"Bak, Christian","orcid":"0000-0001-9060-151X","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Witold Robert","key":"skrzypinskiwitoldrobertpau","last":"Skrzypinski","locid":"7a87d09c-dc64-4945-80c6-28fab05fc31d","name":"Skrzypinski, Witold Robert","orcid":"0000-0002-6299-2717","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christina","key":"bellerchristinapau","last":"Beller","locid":"ffa0bb51-bdfe-4375-ba9a-fd0a91054b9a","name":"Beller, Christina","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Carsten Weber","key":"kockcarstenweberpau","last":"Kock","locid":"a70bed96-4912-4f68-a34b-ce75bdef44c3","name":"Kock, Carsten Weber","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Bogi Bech","key":"jensenbogibechpau","last":"Jensen","locid":"c3884a25-2fc0-4582-a073-bfd062fff208","name":"Jensen, Bogi Bech","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jakob Wagner","key":"sødahljakobwagnerpau","last":"Sødahl","name":"Sødahl, Jakob Wagner","rank":13,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Fabian","key":"bühlerfabianpau","last":"Bühler","name":"Bühler, Fabian","rank":14,"rolecode":"