16360f7a1","name":"Nyegaard, Mette","orcid":"0000-0003-4973-8543","rank":30,"role":"Other","rolecode":"oth"},{"affno":"5","corresponding":null,"first":"Daniel F.","key":"gudbjartssondanielfpau","last":"Gudbjartsson","name":"Gudbjartsson, Daniel F.","rank":34,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Hreinn","key":"stefanssonhreinnpau","last":"Stefansson","name":"Stefansson, Hreinn","rank":36,"rolecode":"pau"},{"affno":"5 7","corresponding":null,"first":"Kari","key":"stefanssonkaripau","last":"Stefansson","name":"Stefansson, Kari","rank":37,"rolecode":"pau"}],"pmid":["34079037"],"pub":{"doi":"10.1038/s42003-021-02144-8","issn":["23993642"],"journal":"Communications Biology","pages":"655","paperid":"655","publisher":"Nature Publishing Group","status":"p","title":"Communications Biology","volume":"4"},"review":"Peer Reviewed","scoID":["2-s2.0-85113872153"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Non-Profit Organisations","All Universities","Capital Region of Denmark","Central Denmark Region","Copenhagen Business School","DI-ALL","DI-HO","DI-HO-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Hospitals","Non-Profit Organisations","North Denmark Region","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-b2efa0ac-88e6-429a-afeb-56a407fd08b7","au-e1c8c355-b7c3-4d98-8cf9-eaf7a5592e9e","cbs-3c5d4644-5aa3-4f46-93e4-8d7ba0d9556d","ku-83386a4b-46a8-436c-b10c-f948615123ca","sdu-2ca7a072-77ae-4c33-838d-406fde0ce7eb"],"src":["AAU Aalborg University","AU Aarhus University","CBS Copenhagen Business School","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Eleven Genomic Loci Affect Plasma Levels of Chronic Inflammation Marker Soluble Urokinase-type Plasminogen Activator Receptor","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S05-098.59-008622","year":"2021","yearsub":"2021"}
{"abstract":"Background: Neonates and infants are susceptible to hypoxaemia in the perioperative period. The aim of this study was to analyse interventions related to anaesthesia tracheal intubations in this European cohort and identify their clinical consequences. Methods: We performed a secondary analysis of tracheal intubations of the European multicentre observational trial (NEonate and Children audiT of Anaesthesia pRactice IN Europe [NECTARINE]) in neonates and small infants with difficult tracheal intubation. The primary endpoint was the incidence of difficult intubation and the related complications. The secondary endpoints were the risk factors for severe hypoxaemia attributed to difficult airway management, and 30 and 90 day outcomes. Results: Tracheal intubation was planned in 4683 procedures. Difficult tracheal intubation, defined as two failed attempts of direct laryngoscopy, occurred in 266 children (271 procedures) with an incidence (95% confidence interval [CI]) of 5.8% (95% CI, 5.1e6.5). Bradycardia occurred in 8% of the cases with difficult intubation, whereas a significant decrease in oxygen saturation (SpO2<90% for 60 s) was reported in 40%. No associated risk factors could be identified among comorbidities, surgical, or anaesthesia management. Using propensity scoring to adjust for confounders, difficult anaesthesia tracheal intubation did not lead to an increase in 30 and 90 day morbidity or mortality. Conclusions: The results of the present study demonstrate a high incidence of difficult tracheal intubation in children less than 60 weeks post-conceptual age commonly resulting in severe hypoxaemia. Reassuringly, the morbidity and mortality at 30 and 90 days was not increased by the occurrence of a difficult intubation event. Clinical trial registration: NCT02350348.","author_count":45,"contributors":["Disma, Nicola","Virag, Katalin","Riva, Thomas","Kaufmann, Jost","Kaufmann, Jost","Engelhardt, Thomas","Habre, Walid","Breschan, Christian","Likar, Rudolf","Platzer, Manuela","Edelman, Isole","Eger, Johanes","Heschl, Stefan","Messerer, Brigitte","Vittinghof, Maria","Kroess, Ruth","Stichlberger, Martina","Kahn, David","Pirotte, Thierry","Pregardien, Caroline","Veyckemans, Francis","Stevens, France","Berghmans, Johan","Bauters, Annemie","De Baerdemaeker, Luc","De Hert, Stefan","Lapage, Koen","Parashchanka, Aliaksandra","Van Limmen, Jurgen","Wyffels, Piet","Lauweryns, Julie","Najafi, Nadia","Vundelinckx, Joris","Butković, Diana","Sorić, Ivana Kerovec","Kralik, Sandra","Markić, Ana","Azman, Josip","Markic, Josko","Pupacic, Daniela","Frelich, Michal","Reimer, Petr","Urbanec, René","Afshari, Arash","Ellekvist, Marguerite"],"cuid":["S02-087.33-041613"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","Europe, EU","Europe, Non-EU","OECD"],"corpau":["NECTARINE Group of the European Society of Anaesthesiology Clinical Trial Network"],"corresponding_author":["Disma, Nicola"],"country":["Austria","Belgium","Canada","Croatia","Czechia","Germany","Hungary","Italy","Switzerland"],"glorg":["All Global Affiliations","Children's Hospital Cologne","East Limburg Hospital","Faculty Hospital Ostrava","Ghent University","Giannina Gaslini Institute","Grand Hôpital de Charleroi","IRCCS Istituto Giannina Gaslini - Genova","KU Leuven","Klinikum Klagenfurt","McGill University","Medical University of Graz","Queen Paola Children's Hospital","University Children's Hospital Bern","University Hospital Center","University Hospital Centre Rijeka","University of Bern","University of Geneva","University of Innsbruck","University of Szeged","University of Zagreb","Université catholique de Louvain","Vrije Universiteit Brussel","Witten/Herdecke University"],"keyword":["Airways","Anaesthesia","Infants","Morbidity","Mortality","Neonates","Paediatric","difficult intubation"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"le