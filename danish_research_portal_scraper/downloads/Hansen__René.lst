st":"Hansen","locid":"07d01beb-26c3-43d2-ba33-678dbbc74b85","name":"Hansen, Nicolaj","orcid":"0000-0002-4448-8891","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"P. L.","key":"langenpau","last":"Langen","locid":"072498b2-75d4-4138-ae38-b4f7911999c3","name":"Langen, Peter L.","name_org":"Langen, P. L.","orcid":"0000-0003-2185-012X","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Peter","key":"llangenpau","last":"L. Langen","name":"L. Langen, Peter","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Fredrik","key":"bobergpau","last":"Boberg","name":"Boberg, Fredrik","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rene","key":"forsbergpau","last":"Forsberg","locid":"be93c88f-cc39-43d8-bf6f-ff4787c55c23","name":"Forsberg, René","name_org":"Forsberg, Rene","orcid":"0000-0002-7288-9545","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sebastian","key":"bsimonsenpau","last":"B. Simonsen","locid":"d088b945-224e-4fd3-a871-022cc71c5cb1","name":"Simonsen, Sebastian Bjerregaard","name_org":"B. Simonsen, Sebastian","orcid":"0000-0001-9569-1294","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Peter","key":"thejllpau","last":"Thejll","name":"Thejll, Peter","rank":6,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"first":"B.","key":"vandecruxpau","last":"Vandecrux","name":"Vandecrux, B.","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Ruth","key":"mottrampau","last":"Mottram","name":"Mottram, Ruth","rank":8,"rolecode":"pau"}],"pub":{"doi":"10.5194/tc-15-4315-2021","issn":["19940416","19940424"],"issn_org":["19940424"],"issue":"9","journal":"The Cryosphere","pages":"4315-4333","publisher":"Copernicus Publications","status":"p","title":"The Cryosphere","volume":"15"},"review":"Peer Reviewed","scoID":["2-s2.0-85114700927"],"sdg":["13. Climate Action","All UN SDG Classification"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["au-0bad94cd-4bd9-4874-a3a0-460ea2fccbf1","dtu-1ffda4cd-be7b-466e-a1ff-3aa77a4bf098"],"src":["AU Aarhus University","DTU Technical University of Denmark"],"title":"Downscaled surface mass balance in Antarctica : impacts of subsurface processes and large-scale atmospheric circulation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-082.58-013448","year":"2021","yearsub":"2021"}
{"abstract":"OBJECTIVES: To investigate how individuals with a history of affective disorder use and perceive their use of social media and online dating. METHODS: A questionnaire focusing on affective disorders and the use of social media and online dating was handed out to outpatients from unipolar depression and bipolar disorder clinics and general practice patients with or without a history of affective disorders (latter as controls). The association between affective disorders and use of social media and online dating was analysed using linear/logistic regression. RESULTS: A total of 194 individuals with a history of unipolar depression, 124 individuals with a history of bipolar disorder and 196 controls were included in the analysis. Having a history of unipolar depression or bipolar disorder was not associated with the time spent on social media compared with controls. Using the controls as reference, having a history bipolar disorder was associated with use of online dating (adjusted odds ratio: 2.2 (95% CI: 1.3; 3.7)). The use of social media and online dating had a mood-congruent pattern with decreased and more passive use during depressive episodes, and increased and more active use during hypomanic/manic episodes. Among the respondents with a history of affective disorder, 51% reported that social media use had an aggravating effect on symptoms during mood episodes, while 10% reported a beneficial effect. For online dating, the equivalent proportions were 49% (aggravation) and 20% (benefit), respectively. CONCLUSION: The use of social media and online dating seems related to symptom deterioration among individuals with affective disorder.","author_count":7,"contributors":["Rydahl, K.F.K.","Brund, R.B.K.","Medici, C.R.","Hansen, V.","Straarup, K.M.N.","Straszek, Sune Puggaard Vogt","Østergaard, S.D."],"cuid":["S02-100.00-010963"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Anxiety","Bipolar disorder","Depression","Depressive Disorder","IMPACT","Major","Mood Disorders","Psychoeducation","Questionnaires","Social media","Surveys","Surveys and Questionnaires","Symptoms","Therapy","Usage","Validation"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-HO-CDR","DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"use of social media and online dating among individuals with a history of affective disorder","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/386572122/Rydahl_et_al_2020_Use_of_social_media_and_online_dating_among_individuals_with_a_history_of_affective_disorder.pdf","version":"Authors Final Version"},"id":"S02-100.00-010963","identifier":[{"id":"33054870","type":"pmid"},{"id":"000671200300005","type":"wos"},{"id":"85093939283","type":"scopus"}],"ids":["aau-e533871b-4f64-4cc6-8b9c-9d37dd7b8975","au-8a58c4e1-ffc2-409f-a6ea-d08ae0a64b8e"],"keyword":["ANXIETY","Bipolar disorder","DEPRESSION","Depressive disorder","FACEBOOK USE","IMPACT","Major","Mood disorders","PSYCHOEDUCATION","Questionnaires","SYMPTOMS","Social media","Surveys","THERAPY","USAGE","VALIDATION","surveys and questionnaires"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-6E562819C2A222D5AB697C6312B8F1D2"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"rem","url":"https://www.medrxiv.org/content/10.1101/2020.05.20.20102707v2.full.pdf","version":"Pre-print"},{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/386572122/Rydahl_et_al_2020_Use_of_social_media_and_online_dating_among_individuals_with_a_history_of_affective_disorder.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Affective Disorders"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1},{"affno":"3","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Psychiatry","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Klara F K","key":"rydahlpau","last":"Rydahl","locid":"96012a37-38ef-4638-b21e-733b1fbfaff5","name":"Rydahl, Klara F K","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"René B K","key":"brundpau","last":"Brund","locid":"29dfe380-bb0c-425f-ae29-92cb228d8d87","name":"Brund, René B K","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Clara R","key":"medicipau","last":"Medici","locid":"2f4eaca4-4b3d-4328-ae00-8d24dd17f931","name":"Medici, Clara R","rank":3,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Vibeke","key":"hansenpau","last":"Hansen","locid":"926dd6cd-dbf1-48a9-8364-96d2d9d0e68a","name":"Sejer Hansen, Vibeke","name_org":"Hansen, Vibeke","rank":4,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Krista N","key":"straaruppau","last":"Straarup","locid":"4003cd15-1cf9-481f-b230-fcc41f440e08","name":"Straarup, Krista Nielsen","name_org":"Straarup, Krista N","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"S.P.V.","key":"straszekpau","last":"Straszek","locid":"38828936-2c32-4dd7-bbe1-79ed0f749202","name":"Straszek, Sune Puggaard Vogt","name_org":"Straszek, S.P.V.","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren D","key":"østergaardpau","last":"Østergaard","locid":"96ff5c6c-20cf-4531-aaee-d10e4efd6292","name":"Østergaard, Søren Dinesen","name_org":"Østergaard, Søren D","orcid":"0000-0002-8032-6208","rank":7,"rolecode":"pau"}],"pmid":["33054870"],"pub":{"doi":"10.1017/neu.2020.36","issn":["09242708","16015215"],"issn_org":["09242708"],"issue":"2","journal":"Acta Neuropsychiatrica","pages":"92-103","publisher":"Cambridge University Press","status":"p","title":"Acta Neuropsychiatrica","volume":"33"},"review":"Peer Reviewed","scoID":["2-s2.0-85093939283"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities"],"PST":["Published"]},"sid":["aau-e533871b-4f64-4cc6-8b9c-9d37dd7b8975","au-8a58c4e1-ffc2-409f-a6ea-d08ae0a64b8e"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Use of social media and online dating among individuals with a history of affective disorder","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-010963","year":"2021","yearsub":"2021"}
{"abstract":"Bell’s palsy is the most common cause of unilateral facial paralysis and is defined as an idiopathic and acute inability to control movements of the facial muscles on the affected side. While the pathogenesis remains unknown, previous studies have implicated post-viral inflammation and resulting compression of the facial nerve. Reported heritability estimates of 4–14% suggest a genetic component in the etiology and an autosomal dominant inheritance has been proposed. Here, we report findings from a meta-analysis of genome-wide association studies uncovering the first unequivocal association with Bell’s palsy (rs9357446-A; P = 6.79 × 10−23, OR = 1.23; Ncases = 4714, Ncontrols = 1,011,520). The variant also confers risk of intervertebral disc disorders (P = 2.99 × 10−11, OR = 1.04) suggesting a common pathogenesis in part or a true pleiotropy.","author_count":36,"contributors":["Skuladottir, Astros Th","Bjornsdottir, Gyda","Thorleifsson, Gudmar","Walters, G. Bragi","Nawaz, Muhammad Sulaman","Moore, Kristjan Helgi Swerford","Olason, Pall I.","Thorgeirsson, Thorgeir E.","Sigurpalsdottir, Brynja","Sveinbjornsson, Gardar","Eggertsson, Hannes P.","Magnusson, Sigurdur H.","Oddsson, Asmundur","Bjornsdottir, Anna","Vikingsson, Arnor","Sveinsson, Olafur A.","Hrafnsdottir, Maria G.","Sigurdardottir, Gudrun R.","Halldorsson, Bjarni V.","Hansen, Thomas Folkmann","Paarup, Helene","Erikstrup, Christian","Nielsen, Kaspar René","Klokker, Mads","Bruun, Mie Topholm","Sorensen, Erik","Banasik, Karina","Burgdorf, Kristoffer S.","Pedersen, Ole Birger","Ullum, Henrik","Jonsdottir, Ingileif","Stefansson, Hreinn","Stefansson, Kari"],"cuid":["S04-099.71-005628"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"continent":["Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Skuladottir, Astros Th"],"country":["Iceland"],"glorg":["All Global Affiliations","Icelandic Medical Center (Læknasetrið)","Laeknasetrid","Laeknasetrid Clinic","Landspitali University Hospital","Reykjavik University","Reykjavík University","The National University Hospital of Iceland","University of Iceland","deCODE Genetics"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA"],"OT":["Unspecified organisation"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"a meta analysis uncovers the first sequence variant conferring risk of bell s palsy","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41598-021-82736-w","version":"Published Version"},"funding_acknowledgement":["We thank all participants in this study for their valuable contribution to research. We further thank our colleagues who contributed to the data collection, phenotypic characterization of clinical samples, genotyping and analysis of the whole-genome association data. This research has been conducted using the UK Biobank Resource under Application Number 24898. We want to acknowledge the participants and investigators of the FinnGen study. The financial support from the European Commission to the NeuroPain project (FP7#HEALTH-2013-602891-2) and painFACT project (H2020-2020-848099), and the National Institutes of Health (R01DE022905) is acknowledged."],"id":"S04-099.71-005628","identifier":[{"id":"85101028953","type":"scopus"},{"id":"33602968","type":"pmid"},{"id":"PMC7893061","type":"pmcid"}],"ids":["aau-74160301-07d8-45b3-9782-7afa993b997a","au-bb0f8e26-2678-4e85-98a0-a9085e46ea2e","ku-27117702-be39-497c-b753-67d36669db74","sdu-e95e5a2d-91cd-465