ull,"first":"Beatriz","key":"guerrapau","last":"Guerra","name":"Guerra, Beatriz","rank":12,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Pierre-Alexandre","key":"beloeilpau","last":"Beloeil","name":"Beloeil, Pierre-Alexandre","rank":13,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Maria","key":"hoffmannpau","last":"Hoffmann","name":"Hoffmann, Maria","rank":14,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"René S.","key":"hendriksenpau","last":"Hendriksen","locid":"d0695f89-50d1-4626-b4b2-0ea8773ccb3c","name":"Hendriksen, Rene S.","name_org":"Hendriksen, René S.","orcid":"0000-0003-2934-8214","rank":15,"rolecode":"pau"}],"pmid":["34392339"],"pub":{"doi":"10.1093/jac/dkab285","issn":["03057453","14602091"],"issn_org":["03057453"],"issue":"11","journal":"Journal of Antimicrobial Chemotherapy","pages":"3063-3065","paperid":"dkab285","publisher":"Oxford University Press","status":"p","title":"Journal of Antimicrobial Chemotherapy","volume":"76"},"review":"Peer Reviewed","scoID":["2-s2.0-85119049046"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-6c3281a3-e100-464c-bfa1-32958d690cf9"],"src":["DTU Technical University of Denmark"],"title":"Co-localization of carbapenem (<i>bla</i><sub>OXA-162</sub>) and colistin (<i>mcr-1</i>) resistance genes on a transferable IncHI2 plasmid in <i>Escherichia coli</i> of chicken origin","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-336892","year":"2021","yearsub":"2021"}
{"abstract":"OBJECTIVE: Knowledge regarding psychiatric disorders in children and adolescents with psychogenic nonepileptic seizures (PNES) is limited. This study outlines the spectrum and risk of psychiatric disorders in childhood-onset PNES. METHODS: We performed a nationwide matched cohort study of children and adolescents with PNES 5 to 17 years of age at the time of diagnosis between January 1, 1996, and December 31, 2014. Two matched comparison groups were included: children and adolescents with epilepsy (ES) and children and adolescents without PNES or epilepsy, called healthy controls (HC). Outcomes were prevalent psychiatric disorders before index (i.e., date of diagnosis or corresponding date for HC) and incident psychiatric disorders 2 years after index. Relative risks (RRs) were calculated and adjusted for potential confounders. RESULTS: We included 384 children and adolescents with validated PNES, 1,152 with ES, and 1,920 HC. Among the cases of PNES, 153 (39.8%) had prevalent psychiatric disorders and 150 (39.1%) had incident psychiatric disorders. Compared to the ES and HC groups, children and adolescents with PNES had elevated risks of both prevalent psychiatric disorders (adjusted RR PNES/ES 1.87, 95% confidence interval [CI] 1.59-2.21, adjusted RR PNES/HC 5.54, 95% CI 4.50-6.81) and incident psychiatric disorders (adjusted RR PNES/ES 2.33, 95% CI 1.92-2.83, adjusted RR PNES/HC 8.37, 95% CI 6.31-11.11). A wide spectrum of specific psychiatric disorders displayed elevated RRs. CONCLUSIONS: Children and adolescents with PNES are at higher risk of a wide range of psychiatric disorders compared to children and adolescents with ES and HC. A careful psychiatric evaluation is warranted to optimize and individualize treatment.","author_count":6,"contributors":["Hansen, Anne Sofie","Rask, Charlotte Ulrikka","Christensen, Ann-Eva","Rodrigo-Domingo, Maria","Christensen, Jakob","Nielsen, René Ernst"],"cuid":["S02-099.55-009665"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"psychiatric disorders in children and adolescents with psychogenic nonepileptic seizures","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85113717442","version":"Other Version"},"id":"S02-099.55-009665","identifier":[{"id":"34031196","type":"pmid"},{"id":"85113717442","type":"scopus"}],"ids":["aau-c96cb68f-17e3-4217-9190-5df518113e8b","au-a57b3559-9e08-4b6f-994b-cfd017877a35"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-0C7D039E644648A11F24AB2B0AAB62F9"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Psychiatry","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Psychiatric Hospital for Children and Adolescents"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anne Sofie","key":"hansenannesofiepau","last":"Hansen","locid":"1a4148c3-ca6e-4d92-ac08-e981652a4177","name":"Hansen, Anne Sofie","orcid":"0000-0001-6101-2150","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Charlotte Ulrikka","key":"raskcharlotteulrikkapau","last":"Rask","locid":"1e308742-df61-47da-83ce-53d8a7c774c3","name":"Rask, Charlotte Ulrikka","orcid":"0000-0002-7426-0353","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ann-Eva","key":"christensenannevapau","last":"Christensen","locid":"6b85a6be-dd8d-4396-ba07-8786573bae99","name":"Christensen, Ann-Eva","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Maria","key":"rodrigodomingomariapau","last":"Rodrigo-Domingo","locid":"fff908cd-728d-480b-9534-0cd7176b7dfc","name":"Rodrigo-Domingo, Maria","orcid":"0000-0001-7661-7195","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jakob","key":"christensenjakobpau","last":"Christensen","locid":"e0bc29a0-3d22-4fa2-82f8-4d99059132c9","name":"Christensen, Jakob","orcid":"0000-0002-9385-6435","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"René Ernst","key":"nielsenrenéernstpau","last":"Nielsen","locid":"689bbd5c-f16d-4316-9717-29e68172bb57","name":"Nielsen, René Ernst","orcid":"0000-0002-7982-6352","rank":6,"rolecode":"pau"}],"pmid":["34031196"],"pub":{"doi":"10.1212/wnl.0000000000012270","issn":["00283878","1526632X"],"issn_org":["00283878"],"issue":"5","journal":"Neurology","publisher":"Lippincott Williams and Wilkins","status":"p","title":"Neurology","volume":"97"},"review":"Peer Reviewed","scoID":["2-s2.0-85113717442"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities"],"PST":["Published"]},"sid":["aau-c96cb68f-17e3-4217-9190-5df518113e8b","au-a57b3559-9e08-4b6f-994b-cfd017877a35"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Psychiatric Disorders in Children and Adolescents With Psychogenic Nonepileptic Seizures","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.55-009665","year":"2021","yearsub":"2021"}
{"abstract":"INTRODUCTION: Central nervous system (CNS) tumors constitute the most common form of solid neoplasms in children, but knowledge on genetic predisposition is sparse. In particular, whether susceptibility attributable to common variants is shared across CNS tumor types in children has not been investigated. The purpose of this study was to explore potential common genetic risk variants exhibiting pleiotropic effects across pediatric CNS tumors. We also investigated whether such susceptibility differs between early and late onset of disease. METHOD: A Danish nationwide genome-wide association study (GWAS) of 1,097 consecutive patients (< 15 years of age) with CNS tumors and a cohort of 4,745 population-based controls. RESULTS: For both the overall cohort and patients diagnosed after the age of four, the strongest association was rs12064625 which maps to PAPPA2 at 1q25.2 (p = 3.400 × 10-7 and 9.668 × 10-8, respectively). PAPPA2 regulates local bioavailability of insulin-like growth factor I (IGF-I). IGF-I is fundamental to CNS development and is involved in tumorigenesis across a wide range of different cancers. For the younger children, the strongest association was provided by rs11036373 mapping to LRRC4C at 11p12 (p = 7.620 × 10-7), which encoded protein acts as an axon guidance molecule during CNS development and has not formerly been associated with brain tumors. DISCUSSION: This GWAS indicates shared susceptibility attributable to common variants across pediatric CNS tumor types. Variations in genetic loci with roles in CNS development appear to be involved, possibly via altered IGF-I related pathways.","author_count":14,"contributors":["Foss-Skiftesvik, Jon","Hagen, Christian Munch","Mathiasen, René","Adamsen, Dea","Bækvad-Hansen, Marie","Børglum, Anders D","Nordentoft, Merete","Werge, Thomas","Christiansen, Michael","Schmiegelow, Kjeld","Juhler, Marianne","Mortensen, Preben Bo","Hougaard, David Michael","Bybjerg-Grauholm, Jonas"],"cuid":["S02-100.00-021779"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Foss-Skiftesvik, Jon"],"keyword":["Brain tumor","Childhood","Common variants","GWAS","Germline","Single nucleotide polymorphism"],"level":"sci","mra":["hum","med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-NP","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP"],"NP":["DI-NP-ALL","DI-NP-LUND"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-NP-LUND","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"genome wide association study across pediatric central nervous system tumors implicates shared predisposition and points to 000000000001q000000000025 000000000002 i pappa000000000002 i and 000000000011p000000000012 i lrrc000000000004c i as novel candidate susceptibility loci","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85096434312","version":"Other Version"},"id":"S02-100.00-021779","identifier":[{"id":"85096434312","type":"scopus"},{"id":"33226468","type":"pmid"},{"id":"000591953600003","type":"wos"}],"ids":["au-7d076fe3-94f4-402c-ae08-97cb7216c18c","ku-7efb2c59-671c-40d1-b0ee-c6ab79f82052"],"keyword":["Brain tumor","Childhood","Common variants","GWAS","Germline","Single nucleotide polymorphism"],"lang":"English","level":"Scientific","mra":["Humanities","Medical Science"],"noi":["Global-Local-2-5-13E7F0FC27F214381813B862271A566D"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Capitol Region of Denmark"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","country":"dk","key":"ssi statens serum institut","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-SSI","l3nn":"SSI Statens Serum Institut","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SSI Statens Serum Institut","namevar":["Statens Serum Institut"],"nora_code":"DI-GV-SSI","used":1},{"affno":"4","country":"dk","key":"lundbeck foundation","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-LUND","l3nn":"Lundbeck Foundation","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Lundbeck Foundation","namevar":["iPSYCH -The Lundbeck Foundation Initiative for Integrative Psychiatric Research"],"nora_code":"DI-NP-LUND","used":1},{"affno":"5","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Biomedicine, Department of Biomedicine - Forskning og uddannelse, Skou-bygningen"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1 2 3","first":"Jon","key":"fossskiftesvikpau","last":"Foss-Skiftesvik","locid":"fb927ee5-74d4-4afd-9934-16f954cb05d3","name":"Foss-Skiftesvik, Jon","rank":1,"rolecode":"pau"},{"affno":"1","first":"Christian Munch","key":"hagenpau","last":"Hagen","locid":"85c38725-795f-4032-a5c5-ca205026eeac","name":"Hagen, Christian M","name_org":"Hagen, Christian Munch","rank":2,"rolecode":"pau"},{"affno":"","first