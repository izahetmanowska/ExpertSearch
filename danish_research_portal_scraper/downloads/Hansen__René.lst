y":"odonovanmichaelcpau","last":"O'Donovan","name":"O'Donovan, Michael C","rank":315,"rolecode":"pau"}],"pmid":["27792727"],"pub":{"doi":"10.1371/journal.pgen.1006343","issn":["15537390","15537404"],"issn_org":["15537390"],"issue":"10","journal":"PLoS Genetics","paperid":"e1006343","publisher":"Public Library of Science","status":"p","title":"PLoS Genetics","title_org":"P L o S Genetics","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-84994314495"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Non-Profit Organisations","All Universities","DI-ALL","DI-NP","DI-NP-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Non-Profit Organisations","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-5e402a9b-771f-459f-84f5-6832d2865916","ku-7730682e-6ab1-409e-96eb-51c7fdf2d1fe"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"No Reliable Association between Runs of Homozygosity and Schizophrenia in a Well-Powered Replication Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-087.25-666264","year":"2016","yearsub":2017}
{"abstract":"Manually identifying possible attacks on an organisation is a complex undertaking; many different factors must be considered, and the resulting attack scenarios can be complex and hard to maintain as the organisation changes. System models provide a systematic representation of organisations that helps in structuring attack identification and can integrate physical, virtual, and social components. These models form a solid basis for guiding the manual identification of attack scenarios. Their main benefit, however, is in the analytic generation of attacks. In this work we present a systematic approach to transforming graphical system models to graphical attack models in the form of attack trees. Based on an asset in the model, our transformations result in an attack tree that represents attacks by all possible actors in the model, after which the actor in question has obtained the asset.","author_count":5,"contributors":["Ivanova, Marieta Georgieva","Probst, Christian W.","Hansen, Rene Rydhof","Kammüller, Florian"],"cuid":["S02-087.55-007520"],"event":{"end":"2015-07-13","place":"Verona, it","start":"2015-07-13","title":"The Second International Workshop on Graphical Models for Security","year":"2015"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"continent":["Europe, Non-EU","OECD"],"corresponding_author":["Probst, Christian W."],"country":["United Kingdom"],"glorg":["All Global Affiliations","Middlesex University"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-AAU","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"transforming graphical system models to graphical attack models","src":["aau","dtu"],"src-code":["DI-U-AAU","DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/127220821/GramSec2015_Ivanova_et_al.pdf","version":"Authors Final Version"},"id":"S02-087.55-007520","identifier":[{"id":"85007591749","type":"scopus"},{"id":"000374048400006","type":"wos"}],"ids":["aau-9af28ae7-8367-462f-8706-2cdec5c36524","dtu-1d14c870-0a0a-46eb-885c-d4f395a75c44"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-264161ED97C489CC421CB94B3134C2B4"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/127220821/GramSec2015_Ivanova_et_al.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Applied Mathematics and Computer Science","Technical University of Denmark, Department of Applied Mathematics and Computer Science, Formal Methods"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (TECH)","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science, Distributed Systems and Semantics"],"nora_code":"DI-U-AAU","used":1},{"affno":"3","country":"gb","key":"middlesex university","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Middlesex University","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Marieta Georgieva","key":"ivanovapau","last":"Ivanova","locid":"c74400a7-13c0-4665-acae-fa6a428ddff3","name":"Ivanova, Marieta Georgieva","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Christian W.","key":"probstpau","last":"Probst","locid":"6f0f045b-6369-4416-a241-c59d9214b6b4","name":"Probst, Christian W.","orcid":"0000-0002-4947-355X","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"René Rydhof","key":"hansenpau","last":"Hansen","locid":"d92ec90d-a8b7-4c01-acbe-ebab21f3f0c3","name":"Hansen, Rene Rydhof","name_org":"Hansen, René Rydhof","orcid":"0000-0002-5688-6432","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Florian","key":"kammüllerpau","last":"Kammüller","name":"Kammüller, Florian","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Florian","key":"kammullerpau","last":"Kammüller","name":"Kammüller, Florian","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-319-29968-6_6","eisbn":["9783319299686"],"isbn":["9783319299679"],"issn":["03029743"],"pages":"82-96","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","subtitle":"GraMSec 2015","title":"Graphical Models for Security"},"review":"Peer Reviewed","scoID":["2-s2.0-85007591749"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["aau-9af28ae7-8367-462f-8706-2cdec5c36524","dtu-1d14c870-0a0a-46eb-885c-d4f395a75c44"],"src":["AAU Aalborg University","DTU Technical University of Denmark"],"title":"Transforming Graphical System Models to Graphical Attack Models","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-087.55-007520","year":"2016","yearsub":"2016"}
{"abstract":"OBJECTIVES: Lung cancer is the most common cause of cancer-related deaths worldwide. Survival is highly dependent on surgery. Video-assisted thoracoscopic surgery (VATS) is increasingly chosen over open thoracotomy (OT) because of the possible benefits of the minimally invasive approach. Consequently, our aim was to compare the 30-day morbidity and mortality for lung cancer patients operated by VATS lobectomy or lobectomy by OT. METHOD: Data were obtained from prospective national and regional databases, including patients who underwent lobectomy for lung cancer in the eastern part of Denmark from 1 January 2005 to 31 December 2011. All patients operated before 2009 were re-staged according to the latest International Association for the Study of Lung Cancer lung cancer classification. Patient characteristics, comorbidities, pathology and operative data were assessed using an independent samples t-test, Pearson's χ(2), Fisher's exact test and Mann-Whitney test. Morbidity was assessed using multinomial logistic regression adjusted for gender, age, cancer stage, forced expiratory volume in 1 s (FEV1), year of surgery and Charlson comorbidity score. RESULTS: In total, 1379 patients underwent lobectomy, 785 patients via VATS and 594 patients via thoracotomy. The two groups were similar in gender and FEV1. The patients operated by VATS were older (P < 0.001), and had a lower Charlson comorbidity score (P = 0.034), higher frequency of adenocarcinomas (P < 0.001) and lower cancer stage (P < 0.001). Among the VATS patients, 285 (36.3%) and among the thoracotomy patients, 288 (48.5%) had minor complications (P < 0.001); and 157 (20.0%) VATS patients and 212 (35.7%) thoracotomy patients had major complications (P < 0.001). The 30-day mortality rate was 1% in the VATS group and 1.5% in the thoracotomy group (P = 0.47). Multinomial logistic regression analysis showed that the prevalence of both minor [odds ratio (OR) = 1.51; 95% confidence interval (Cl) = 1.18-1.96] and major complications (OR = 1.91, 95% Cl = 1.44-2.53) was significantly higher for patients who underwent lobectomy via thoracotomy compared with VATS. CONCLUSION: Patients undergoing lobectomy via VATS were less likely to have at least one minor complication within the first 30 postoperative days and less likely to have at least one major complication, compared with patients operated by thoracotomy. These findings remained after adjusting for gender, age, FEV1, cancer stage, year of surgery and Charlson comorbidity score.","author_count":6,"contributors":["Laursen, Lykke Østergaard","Petersen, René Horsleben","Hansen, Henrik Jessen","Jensen, Tina Kold","Ravn, Jesper","Konge, Lars"],"cuid":["S02-088.24-044672"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Complications","Lung cancer","Morbidity","Thoracotomy","Video assisted thoracoscopic surgery"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"video assisted thoracoscopic surgery lobectomy for lung cancer is associated with a lower 000000000030 day morbidity compared with lobectomy by thoracotomy","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1093/ejcts/ezv205","version":"Published Version"},"id":"S02-088.24-044672","identifier":[{"id":"26088592","type":"pmid"},{"id":"84962783659","type":"scopus"}],"ids":["ku-99fc61d7-3aea-463c-9a4a-247f8d951189","sdu-32d558b4-ddca-4dd2-b441-ee5f9a0ba78e"],"keyword":["Complications","Lung cancer","Morbidity","Thoracotomy","Video-assisted thoracoscopic surgery"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-4F9BDD7D7314E73B00676F3E66116F67"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1093/ejcts/ezv205","version":"Published Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Public Health, Environmental Medicine"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Section of Surgery and Internal Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Lykke Østergaard","key":"laursenpau","last":"Laursen","name":"Laursen, Lykke Østergaard","rank":1,"rolecode":"pau"},{"affno":"1","first":"René Horsleben","key":"petersenpau","last":"Petersen","name":"Petersen, René Horsleben","rank":2,"rolecode":"pau"},{"affno":"","first":"Henrik Jessen","key":"hansenpau","last":"Hansen","name":"Hansen, Henrik Jessen","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Tina Kold","key":"jensenpau","last":"Jensen","locid":"50e57e0b-3ce7-4b7d-9d24-125d84b7a62d","name":"Jensen, Tina Kold","orcid":"0000-0003-2311-5778","rank":4,"rolecode":"pau"},{"affno":"","first":"Jesper","key":"ravnpau","last":"Ravn","name":"Ravn, Jesper","rank":5,"rolecode":"pau"},{"affno":"3","first":"Lars","key":"kongepau","last":"Konge","locid":"e1c287e3-4cd2-43d2-887d-f2f77fd5daf8","name":"Konge, Lars","orcid":"0000-0002-1258-5822","rank":6,"rolecode":"pau"}],"pmid":["26088592"],"pub":{"doi":"10.1093/ejcts/ezv205","issn":["10107940","1873734X"],"issn_org":["1873734X"],"issue":"3","journal":"European Journal of Cardio-Thoracic Surgery","pages":"870-875","publisher":"Oxford University Press","status":"p","title":"European Journal of Cardio-Thoracic Surgery","volume":"49"},"review":"Peer Reviewed","scoID":["2-s2.0-84962783659"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-99fc61d7-3aea-463c-9a4a-247f8d951189","sdu-32d558b4-ddca-4dd2-b441-ee5f9a0ba78e"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Video-assisted thoracoscopic surgery lobectomy for lung cancer is associated with a lower 30-day morbidity compared with lobectomy by thoracotomy","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-088.24-044672","year":"2016","yearsub":"2016"}
{"author_count":3,"contributors":["Olesen, Mads Chr.","Hansen, Rene Rydhof","Larsen, Kim Guldstrand"],"cuid":["S01-000.00-089602"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"an automata based approach to trace partitioned abstract interpretation","src":["aau"],"src-code":["DI-U-AAU"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-089602","identifier":[{"id":"84955279902","type":"scopus"},{"id":"000381922800005","type":"wos"}],"ids":["aau-87d8ae8c-01d0-4d21-96b3-652dc65fdb75"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-DFE7C31155BA685BD6AEF6144D26B3AA"],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (TECH)","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Mads Chr.","key":"olesenpau","last":"Olesen","locid":"c2e63d48-efc8-4e23-9dbf-509a20de7dc3","name":"Olesen, Mads Chr.","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rene Rydhof","key":"hansenpau","last":"Hansen","locid":"d92ec90d-a8b7-4c01-acbe-ebab21f3f0c3","name":"Hansen, Rene Rydhof","orcid":"0000-0002-5688-6432","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kim Guldstrand","key":"larsenpau","last":"Larsen","locid":"27dbc400-17ea-4672-9343-63093ad486c9","name":"Larsen, Kim Guldstrand","orcid":"0000-0002-5953-3384","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-319-27810-0_5","eisbn":["9783319278100"],"isbn":["9783319278094"],"issn":["03029743"],"pages":"88-110","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","subtitle":"Essays Dedicated to Hanne Riis Nielson and Flemming Nielson on the Occasion of Their 60th Birthdays","title":"Semantics, Logics and Calculi"},"review":"Peer Reviewed","scoID":["2-s2.0-84955279902"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-87d8ae8c-01d0-4d21-96b3-652dc65fdb75"],"src":["AAU Aalborg University"],"title":"An Automata-Based Approach to Trace Partitioned Abstract Interpretation","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-089602","year":"2016","yearsub":"2016"}
{"abstract":"OBJECTIVE: Chest drains are used routinely after wedge resection by video-assisted thoracoscopic surgery (VATS), although this practice is based largely on tradition rather than evidence. Chest drains may furthermore cause pain, infections, and prolonged length of stay. The aim of this prospective observational study was to assess the feasibility of avoiding chest drains following VATS wedge resection for pulmonary nodules. METHODS: Between 1 February and 25 August 2015 166 consecutive patients planned for VATS wedge resection of pulmonary nodules were screened for inclusion using the following criteria: Forced expiratory volume in 1 s (FEV1) ≥60 % of expected, FEV1/forced vital capacity ≥70 %, tumour diameter ≤2 cm, distance from tumour to visceral pleura ≤3 cm, ≤2 separate wedges, no air leak on an intraoperative air leakage test and absence of severe adhesions, bullous/emphysematous disease, pleural effusion and coagulopathy. Chest X-rays were done twice on the day of surgery. 30-day complications were compiled from patient records. RESULTS: 49 patients underwent 51 unilateral VATS wedge resections without using a post-operative chest drain. No patient required reinsertion of a chest drain. 30 (59 %) patients had a pneumothorax of mean size 12 ± 12 mm on supine 8-h post-operative X-ray for which the majority resolved spontaneously within 2-week control. There were no complications on 30-day follow-up. Median length of stay was 1 day. CONCLUSIONS: The results support that VATS wedge resection for pulmonary nodules without a post-operative chest drain may be safe in a selected group of patients.","author_count":4,"contributors":["Holbek, Bo Laksafoss","Hansen, Henrik Jessen","Kehlet, Henrik","Petersen, René Horsleben"],"cuid":["S01-000.00-538013"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Adult","Aged","Chest Tubes","Feasibility Studies","Female","Forced Expiratory Volume","Humans","Journal Article","Lung Neoplasms","Male","Middle Aged","Multiple Pulmonary Nodules","Observational Study","Patient Selection","Pneumonectomy","Pneumothorax","Postoperative Care","Prospective Studies","Radiography Thoracic","Thoracic Surgery Video Assisted","Vital Capacity"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"thoracoscopic pulmonary wedge resection without post operative chest drain an observational study","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-538013","identifier":[{"id":"27510705","type":"pmid"},{"id":"84981287330","type":"scopus"}],"ids":["ku-f24833b0-3944-4063-a9fa-6a5a5e0c8709"],"keyword":["Adult","Aged","Chest Tubes","Feasibility Studies","Female","Forced Expiratory Volume","Humans","Journal Article","Lung Neoplasms","Male","Middle Aged","Multiple Pulmonary Nodules","Observational Study","Patient Selection","Pneumonectomy","Pneumothorax","Postoperative Care","Prospective Studies","Radiography, Thoracic","Thoracic Surgery, Video-Assisted","Vital Capacity"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-954135FC39D33C9B607D6C6FCB27263E"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"","first":"Bo Laksafoss","key":"holbekpau","last":"Holbek","name":"Holbek, Bo Laksafoss","rank":1,"rolecode":"pau"},{"affno":"","first":"Henrik Jessen","key":"hansenpau","last":"Hansen","name":"Hansen, Henrik Jessen","rank":2,"rolecode":"pau"},{"affno":"1","first":"Henrik","key":"kehletpau","last":"Kehlet","locid":"0a3c43a0-a0c5-4a91-85d6-6e80e16af8b5","name":"Kehlet, Henrik","orcid":"0000-0002-2209-1711","rank":3,"rolecode":"pau"},{"affno":"2","first":"René Horsleben","key":"petersenpau","last":"Petersen","name":"Petersen, René Horsleben","rank":4,"rolecode":"pau"}],"pmid":["27510705"],"pub":{"doi":"10.1007/s11748-016-0692-6","issn":["18632092","18636705"],"issn_org":["18636705"],"issue":"10","journal":"General Thoracic and Cardiovascular Surgery","pages":"612-7","status":"p","title":"General Thoracic and Cardiovascular Surgery","volume":"64"},"review":"Peer Reviewed","scoID":["2-s2.0-84981287330"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-f24833b0-3944-4063-a9fa-6a5a5e0c8709"],"src":["KU University of Copenhagen"],"title":"Thoracoscopic pulmonary wedge resection without post-operative chest drain : an observational study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-538013","year":"2016","yearsub":"2016"}
{"abstract":"Objectives The majority of antibiotics are prescribed from general practice. The use of broad-spectrum antibiotics increases the risk of development of bacteria resistant to antibiotic treatment. In spite of guidelines aiming to minimize the use of broad-spectrum antibiotics we see an increase in the use of these agents. The overall aim of the project is to explore factors influencing the decision process and the prescribing behaviour of the GPs when prescribing antibiotics. We will study the impact of microbiological testing on the choice of antibiotic. Furthermore the project will explore how the GPs’ prescribing behaviour is influenced by selected factors. Method The study consists of a register-based study and a questionnaire study. The register-based study is based on data from the Register of Medicinal Product Statistics (prescribed antibiotics), Statistics Denmark (socio-demographic data) and the Danish Microbiology Database (performed microbiological testing). We will assess and quantify the use of microbiological testing prior to antibiotic prescription. Furthermore we will investigate associations between GP characteristics, use of microbiological investigations and description patterns. A questionnaire comprising a discrete choice experiment will allow us to investigate the relative importance of selected factors (e.g. microbiological diagnostics, point-of-care tests, patients' expectations) in the management of infectious diseases. Results This PhD project is scheduled to be carried out in 2016-2019. The hypotheses and anticipated perspectives will be discussed at the conference. Conclusion This project will contribute with solid knowledge on diagnostic approaches for management of infections in Danish general practice. The results will create a base for targeted interventions aiming to optimize diagnostic approaches to infectious diseases benefitting the individual patient and society as a whole.","author_count":5,"contributors":["Sydenham, Rikke Vognbjerg","Pedersen, Line Bjørnskov","Plejdrup Hansen, Malene","Christensen, René dePont","Jarbøl, Dorte Ejg"],"cuid":["S01-000.00-583415"],"event":{"end":"2016-10-01","place":"Oxford, gb","start":"2016-09-29","title":"General Practice Research on Infections Network Meeting","year":"2016"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["General practice","Infection"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-U-KU","DI-U-SDU"]},"review":"nr","rtype":["clu"],"sorti":"prescribing antibiotics in general practice the use of microbiological testing and other factors influencing decision making and prescribing behaviour","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-583415","ids":["sdu-23b21e0f-629e-40bb-a981-23d31cb873b3"],"keyword":["General Practice","Infection"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-EACFC24BCE6E409523A94265D666FDC7"],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Public Health, Research Unit of General Pratice"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Rikke Vognbjerg","key":"sydenhampau","last":"Sydenham","locid":"601c30ba-8898-484a-951c-2cf206ea67d5","name":"Sydenham, Rikke Vognbjerg","orcid":"0000-0001-8717-414X","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Line Bjørnskov","key":"pedersenpau","last":"Pedersen","locid":"b2346680-b60a-41e8-9332-304171fab9be","name":"Pedersen, Line Bjørnskov","orcid":"0000-0001-6804-2045","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Malene","key":"plejdruphansenpau","last":"Plejdrup Hansen","name":"Plejdrup Hansen, Malene","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"René dePont","key":"christensenpau","last":"Christensen","locid":"3f33c4f0-abcb-42c6-85af-2d24bcf025ff","name":"Christensen, René dePont","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Dorte Ejg","key":"jarbølpau","last":"Jarbøl","locid":"42ad7b79-3390-486b-840a-94cadacfeaef","name":"Jarbøl, Dorte Ejg","orcid":"0000-0002-3241-4190","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-23b21e0f-629e-40bb-a981-23d31cb873b3"],"src":["SDU University of Southern Denmark"],"title":"Prescribing antibiotics in general practice: : The use of microbiological testing and other factors influencing decision-making and prescribing behaviour","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-583415","year":"2016","yearsub":"2016"}
{"abstract":"BACKGROUND: Ultrasonography of the testis is a well-established diagnostic tool in detection of testicular microlithiasis (TML). Operator-dependent diagnostic variation related to skill, knowledge, and operator consistency are factors that influence detection of TML. PURPOSE: To determine inter- and intraobserver agreement for detection of TML using ultrasonography for a group of physicians with no or limited experience compared to a group of experience senior radiologists. MATERIAL AND METHODS: Between May and September 2014 a total of six observers evaluated 34 patients scrotal ultrasonography recorded from September to December 2013. The observers were blinded to patient history and previous ultrasonography. Three of the observers had no or limited experience with detection of TML, and three of the observers had more than 15 years of experience. Each observer reviewed all the scrotal ultrasonography recordings twice with a time interval of 3 months. RESULTS: The inter-observer agreement showed substantial agreement and up to almost perfect agreement (κ = 0.86). Both the experienced and less experienced observers had a higher agreement in detecting and grading TML in their second reading. CONCLUSION: The ultrasonography grading system of TML in this study showed to be reproducible, with an inter- and intraobserver agreement ranging between substantial agreement and up to almost perfect agreement with many years of experience not necessarily being essential.","author_count":9,"contributors":["Pedersen, Malene Roland","Graumann, Ole","Hørlyck, Arne","Duus, Louise Aarup","Jørgensen, Mette Marie B","Vagn-Hansen, Chris","Holst, René","Rafaelsen, Søren Rafael"],"cuid":["S02-083.77-029985"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Calculi","Interobserver variability","Microlithiasis","Observer Variation","Observer performance","Testicular Diseases","Testicular cancer","Testicular microlithiasis","Testis","Ultrasound"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"inter and intraobserver agreement in detection of testicular microlithiasis with ultrasonography","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84978759495","version":"Other Version"},"id":"S02-083.77-029985","identifier":[{"id":"84978759495","type":"scopus"},{"id":"26419255","type":"pmid"}],"ids":["au-ef07cfcb-388b-4641-af4e-83500b8a65be","sdu-8e4d3099-9f74-4151-8815-424ced91a017"],"keyword":["Calculi","Observer performance","Observer variation","Testicular diseases","Testicular microlithiasis","interobserver variability","microlithiasis","testicular cancer","testis","ultrasound"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-2DF2BE203E16EDDB966E807AF25C5361"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Regional Health Research","SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Lillebælt Hospital","SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Lillebælt Hospital, Research Unit of Radiology (Vejle)","SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Lillebælt Hospital, Research Unit of Urology (Vejle)"],"nora_code":"DI-U-SDU",