{"abstract":"The serotonin syndrome has been described only in rare instances for electroconvulsive therapy combined with an antidepressant medication. We describe a case of serotonin toxicity induced by electroconvulsive therapy in combination with fluoxetine.","author_count":3,"contributors":["Klysner, René","Bendsen, Birgitte Bjerg","Hansen, Maja Soon"],"cuid":["S01-000.00-427562"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"transient serotonin toxicity evoked by combination of electroconvulsive therapy and fluoxetine","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1155/2014/162502","version":"Other Version"},"id":"S01-000.00-427562","identifier":[{"id":"24982810","type":"pmid"},{"id":"PMC4058578","type":"pmcid"}],"ids":["ku-3958c6bd-536c-4b47-b5f1-0612ae2075d4"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-DEF7EDBFE1EC902C63427265C5FDA175"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1155/2014/162502","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"René","key":"klysnerpau","last":"Klysner","locid":"950bc6a5-9daa-49fd-86d8-879892ce7cc8","name":"Klysner, René","rank":1,"rolecode":"pau"},{"affno":"1","first":"Birgitte","key":"bjergbendsenpau","last":"Bjerg Bendsen","locid":"657f4964-2e77-4446-ac59-c61a8c22ad78","name":"Bendsen, Birgitte Bjerg","name_org":"Bjerg Bendsen, Birgitte","rank":2,"rolecode":"pau"},{"affno":"","first":"Maja Soon","key":"hansenpau","last":"Hansen","name":"Hansen, Maja Soon","rank":3,"rolecode":"pau"}],"pmid":["24982810"],"pub":{"doi":"10.1155/2014/162502","issn":["2090682X","20906838"],"issn_org":["2090682X"],"journal":"Case Reports in Psychiatry","pages":"1-3","paperid":"162502","status":"p","title":"Case Reports in Psychiatry","volume":"2014"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-3958c6bd-536c-4b47-b5f1-0612ae2075d4"],"src":["KU University of Copenhagen"],"title":"Transient Serotonin Toxicity Evoked by Combination of Electroconvulsive Therapy and Fluoxetine","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-427562","year":"2014","yearsub":"2014"}
