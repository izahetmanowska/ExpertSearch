ichal","key":"frelichmichalpau","last":"Frelich","name":"Frelich, Michal","rank":41,"rolecode":"pau"},{"affno":"25","first":"Petr","key":"reimerpetrpau","last":"Reimer","name":"Reimer, Petr","rank":42,"rolecode":"pau"},{"affno":"25","first":"René","key":"urbanecrenépau","last":"Urbanec","name":"Urbanec, René","rank":43,"rolecode":"pau"},{"affno":"26","first":"Arash","key":"afshariarashpau","last":"Afshari","locid":"9c54dedc-02ce-45c0-81f9-9927febcd9d3","name":"Afshari, Arash","rank":44,"rolecode":"pau"},{"affno":"26","first":"Marguerite","key":"ellekvistmargueritepau","last":"Ellekvist","locid":"a72225f0-a46d-4ac8-8851-75f7596b0d34","name":"Ellekvist, Marguerite","rank":45,"rolecode":"pau"}],"pmid":["33812665","34119312"],"pub":{"doi":"10.1016/j.bja.2021.02.021","issn":["00070912","14716771"],"issn_org":["00070912"],"issue":"6","journal":"British Journal of Anaesthesia","pages":"1173-1181","publisher":"Elsevier","status":"p","title":"British Journal of Anaesthesia","volume":"126"},"review":"Peer Reviewed","scoID":["2-s2.0-85104493267"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-3ae50b95-c7ae-4321-b0e4-0dce70302356","sdu-4f646f14-512a-4057-aa4b-31f6061d504c"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Difficult tracheal intubation in neonates and infants. NEonate and Children audiT of Anaesthesia pRactice IN Europe (NECTARINE) : a prospective European multicentre observational study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-087.33-041613","year":"2021","yearsub":"2021"}
{"abstract":"INTRODUCTION: Scheduled routine visits in patients with rheumatoid arthritis (RA) may be in a stable period without active disease. Consequently, there is a demand for developing outpatient control procedures which cater to the needs of the individual patient. OBJECTIVE: This study aims to compare a patient-controlled outpatient follow-up system, Open Outpatient Clinic Programme (OOCP), with traditional scheduled routine follow-up (TSRF) regarding patient satisfaction and disease activity markers in RA patients. METHOD: In a 2-year randomized controlled trial, RA patients were allocated to OOCP or TSRF. OOCP patients had no scheduled appointments but were allowed acute appointments with their rheumatologist and had access to nurse-led consultations and a telephone helpline. Appointments for the TSRF group were scheduled according to routine procedures (clinical parameters: DAS-28, C-reactive protein, VAS pain, tender and swollen joint count, HAQ-DI and radiographs; psychological parameters: VAS patient satisfaction and EQ-5D). RESULTS: Of 282 patients, 239 completed the study (OOCP/TSRF characteristics: age 61.4 ± 10.5/60.9 ± 12.2 years, females 77/74%, ACPA positive 66/65%). At years 1 and 2, OCCP had fewer visits (year 2: 2.6 ± 1.6 vs. 3.5 ± 2; p < 0.0005) but more phone calls (year 2: 0.7 ± 1.4 vs. 0.1 ± 0.3; p < 0.0005) compared to TSRF. OOCP was comparable to TSRF regarding clinical and psychological outcome measures, and no radiographic progression was observed. CONCLUSIONS: OOCP was associated with significantly fewer visits but with more phone calls to the nurse and was comparable with TSGentofte University HospitalRF regarding clinical, psychological and radiographic outcomes. Thus, the organization of outpatient care according to OOCP may be applied to strengthen patient-centred care in patients with RA. ClinicalTrials.gov Identifier (July 20, 2020): NCT04476875 Key points • In a patient-controlled outpatient follow-up system, RA patients had significantly fewer visits compared to traditional follow-up. • The patient-controlled follow-up system was comparable with traditional follow-up regarding clinical, psychological and radiographic outcomes. • Organization of outpatient care according to a patient-controlled follow-up system may be applied to strengthen patient-centred care in patients with RA.","author_count":6,"contributors":["Poggenborg, René Panduro","Madsen, Ole Rintek","Sweeney, Anne-Marie Tetsche","Dreyer, Lene","Bukh, Gunhild","Hansen, Annette"],"cuid":["S02-099.89-011973"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Poggenborg, René Panduro"],"keyword":["Outpatient follow up on demand","Rheumatoid arthritis"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-AAU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"patient controlled outpatient follow up on demand for patients with rheumatoid arthritis a 000000000002 year randomized controlled trial","src":["aau","ku"],"src-code":["DI-U-AAU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC7936865/","version":"Published Version"},"funding_acknowledgement":["The study was solely funded by the Region the Municipality of Greater Copenhagen the Quality Fund (Region Hovedstaden, Kvalitetspuljen)."],"id":"S02-099.89-011973","identifier":[{"id":"PMC7936865","type":"pmcid"},{"id":"33677724","type":"pmid"},{"id":"85102084596","type":"scopus"}],"ids":["aau-fb54ec6d-bfa1-49b2-bc3f-69a056bea70e","ku-41652372-ee92-432a-b46f-f88569900bec"],"keyword":["Outpatient follow-up on demand","Rheumatoid arthritis"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-DEF1748B573116994DD494890C58377F"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC7936865/","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal Medicine: Rheumatology"],"nora_code":"DI-U-KU","used":1},{"affno":"3","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Rheumatology","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Medicin og Akut"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"René Panduro","key":"poggenborgpau","last":"Poggenborg","name":"Poggenborg, René Panduro","rank":1,"rolecode":"pau"},{"affn