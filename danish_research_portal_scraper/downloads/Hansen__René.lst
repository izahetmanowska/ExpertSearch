{"abstract":"Formålet med forsøget er at undersøge, om et høj kvalitets farvekamera sammen med kunstig intelligens kan anvendes til automatisk genkendelse af bladsygdomme i sukkerroer.","author_count":3,"contributors":["Mortensen, Anders Krogh","Hansen, Anne Lisbet","Gislum, René"],"cuid":["S01-000.00-264556"],"filters":{"added":"2023-04","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-PR-OTH","DI-U-AU"]},"review":"nr","rtype":["clu"],"sorti":"kamera og kunstig intelligens til vurdering af sygdomstryk i sukkerroer","src":["au"],"src-code":["DI-U-AU"],"type":"dra","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://www.nordicbeet.nu/wp-content/uploads/2023/02/nbr_aarsberetning_2022.pdf","version":"Published Version"},"id":"S01-000.00-264556","ids":["au-ece8b721-f3fe-497b-a532-c7f2ed9b0cfd"],"lang":"Danish","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-1A1034A2466C2B3F5D344739E7B0571D"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://www.nordicbeet.nu/wp-content/uploads/2023/02/nbr_aarsberetning_2022.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Electrical and Computer Engineering, Department of Electrical and Computer Engineering - Signal Processing and Machine learning"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"O