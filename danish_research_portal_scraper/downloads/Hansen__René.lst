Lene Jung","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mette Frimodt","key":"hansenpau","last":"Hansen","locid":"d9760e43-a896-495b-a589-991c240ef36b","name":"Hansen, Mette Frimodt","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Andreas","key":"petersenpau","last":"Petersen","name":"Petersen, Andreas","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Louise","key":"lohsepau","last":"Lohse","locid":"d7e79179-8a8b-4e2d-a093-5eef7fe4cfc7","name":"Lohse, Louise","orcid":"0000-0002-6769-5447","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kirstine Klitgaard","key":"schoupau","last":"Schou","locid":"2436a58e-fb11-41dd-9799-5e91010a3b8e","name":"Schou, Kirstine Klitgaard","rank":6,"rolecode":"pau"}],"pub":{"issn":["16003837"],"pages":"24-25","place":"Søborg","publisher":"National Food Institute, Technical University of Denmark","series":"Annual Report on Zoonoses in Denmark","status":"p","title":"Annual Report on Zoonoses in Denmark 2017"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-1b06fa0b-c542-4cbd-8e45-415aecc2176c"],"src":["DTU Technical University of Denmark"],"title":"Vectorborne zoonoses","type":"Report Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-312671","year":"2018","yearsub":"2018"}
{"abstract":"Background Specific assessment tools can accelerate trainees’ learning through structured feedback and ensure that trainees attain the knowledge and skills required to practice as competent, independent surgeons (competency-based surgical education). The objective was to develop an assessment tool for video-assisted thoracoscopic surgery (VATS) lobectomy by achieving consensus within an international group of VATS experts. Method The Delphi method was used as a structured process for collecting and distilling knowledge from a group of internationally recognized VATS experts. Opinions were obtained in an iterative process involving answering repeated rounds of questionnaires. Responses to one round were summarized and integrated into the next round of questionnaires until consensus was reached. Results Thirty-one VATS experts were included and four Delphi rounds were conducted. The response rate for each round were 68.9% (31/45), 100% (31/31), 96.8% (30/31), and 93.3% (28/30) for the final round where consensus was reached. The first Delphi round contained 44 items and the final VATS lobectomy Assessment Tool (VATSAT) comprised eight items with rating anchors: (1) localization of tumor and other pathological tissue, (2) dissection of the hilum and veins, (3) dissection of the arteries, (4) dissection of the bronchus, (5) dissection of lymph nodes, (6) retrieval of lobe in bag, (7) respect for tissue and structures, and (8) technical skills in general. Conclusion A novel and dedicated assessment tool for VATS lobectomy was developed based on VATS experts’ consensus. The VATSAT can support the learning of VATS lobectomy by providing structured feedback and help supervisors make the important decision of when trainees have acquired VATS lobectomy competencies for independent performance.","author_count":6,"contributors":["Jensen, Katrine","Petersen, René Horsleben","Hansen, Henrik Jessen","Walker, William","Pedersen, Jesper Johannes Holst","Konge, Lars"],"cuid":["S01-000.00-467736"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","Royal Infirmary of Edinburgh"],"keyword":["Assessment tool","Competency Based Education","Lobectomy","VATS","Video assisted thoracoscopic surgery"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"a novel assessment tool for evaluating competence in video assisted thoracoscopic surgery lobectomy","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-467736","identifier":[{"id":"29603007","type":"pmid"},{"id":"000444140200016","type":"wos"},{"id":"85044609302","type":"scopus"}],"ids":["ku-7c04f029-691c-4f53-9a0f-4a95eda08f1e"],"keyword":["Assessment tool","Competency-based education","Lobectomy","Thoracic surgical training","VATS","video-assisted thoracoscopic surgery"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-7241AEA5DD505E0A82385E7CFBE47DF1"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Cardiothoracic Surgery","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"gb","key":"royal infirmary of edinburgh","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Royal Infirmary of Edinburgh","used":1}],"person":[{"affno":"1","first":"Katrine","key":"jensenpau","last":"Jensen","name":"Jensen, Katrine","rank":1,"rolecode":"pau"},{"affno":"2","first":"Rene Horsleben","key":"petersenpau","last":"Petersen","locid":"aa18983b-8811-4b3a-a7bd-b439cc52d3e3","name":"Petersen, René Horsleben","name_org":"Petersen, Rene Horsleben","orcid":"0000-0002-3586-1869","rank":2,"rolecode":"pau"},{"affno":"1","first":"Henrik Jessen","key":"hansenpau","last":"Hansen","name":"Hansen, Henrik Jessen","rank":3,"rolecode":"pau"},{"affno":"3","first":"William","key":"walkerpau","last":"Walker","name":"Walker, William","rank":4,"rolecode":"pau"},{"affno":"2","first":"Jesper Holst","key":"pedersenpau","last":"Pedersen","locid":"f87d965e-c646-421c-8804-666d39c7028b","name":"Pedersen, Jesper Johannes Holst","name_org":"Pedersen, Jesper Holst","rank":5,"rolecode":"pau"},{"affno":"2","first":"Lars","key":"kongepau","last":"Konge","locid":"e1c287e3-4cd2-43d2-887d-f2f77fd5daf8","name":"Konge, Lars","orcid":"0000-0002-1258-5822","rank":6,"rolecode":"pau"}],"pmid":["29603007"],"pub":{"doi":"10.1007/s00464-018-6162-8","issn":["09302794","14322218"],"issn_org":["09302794"],"issue":"10","journal":"Surgical Endoscopy","pages":"4173-4182","status":"p","title":"Surgical Endoscopy","volume":"32"},"review":"Peer Reviewed","scoID":["2-s2.0-85044609302"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-7c04f029-691c-4f53-9a0f-4a95eda08f1e"],"src":["KU University of Copenhagen"],"title":"A novel assessment tool for evaluating competence in video-assisted thoracoscopic surgery lobectomy","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-467736","year":"2018","yearsub":"2018"}
