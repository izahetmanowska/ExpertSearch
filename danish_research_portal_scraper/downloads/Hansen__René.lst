"OECD"],"name":"GEUS Geological Survey of Denmark and Greenland","namevar":["Geological Survey of Denmark and Greenland"],"nora_code":"DI-GV-GEUS","used":1}],"person":[{"affno":"1","first":"Frederik","key":"clausonkaaspau","last":"Clauson-Kaas","locid":"309e1e9c-0ac3-432f-b88d-8531210e9b48","name":"Clauson-Kaas, Frederik","orcid":"0000-0002-4859-0148","rank":1,"rolecode":"pau"},{"affno":"2","first":"Pia H.","key":"jensenpau","last":"Jensen","name":"Jensen, Pia H.","rank":2,"rolecode":"pau"},{"affno":"2","first":"Ole Stig","key":"jacobsenpau","last":"Jacobsen","name":"Jacobsen, Ole Stig","rank":3,"rolecode":"pau"},{"affno":"2","first":"René K.","key":"juhlerpau","last":"Juhler","name":"Juhler, René K.","rank":4,"rolecode":"pau"},{"affno":"1","first":"Hans Chr. Bruun","key":"hansenpau","last":"Hansen","locid":"9b553aa7-aebe-452e-b36f-b21edcff4e70","name":"Hansen, Hans Chr. Bruun","orcid":"0000-0002-8617-2393","rank":5,"rolecode":"pau"}],"pmid":["24464773"],"pub":{"doi":"10.1002/etc.2533","issn":["07307268","15528618"],"issn_org":["07307268"],"issue":"5","journal":"Environmental Toxicology and Chemistry","pages":"1030-1034","status":"p","title":"Environmental Toxicology and Chemistry","volume":"33"},"review":"Peer Reviewed","scoID":["2-s2.0-84898833848"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-70341684-01d7-4d11-a23e-f60954fc708e"],"src":["KU University of Copenhagen"],"title":"The naturally occuring carcinogen ptaquiloside is present in groundwater below bracken vegetation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-460480","year":"2014","yearsub":"2014"}
{"abstract":"Vigabatrin is an antiepileptic drug substance mainly used in pediatric treatment of infantile spasms. The main source of nutrition for infants is breast milk and/or infant formula. Our hypothesis was that infant formula may affect the intestinal absorption of vigabatrin. The aim was therefore to investigate the potential effect of coadministration of infant formula with vigabatrin on the oral absorption in vitro and in vivo. The effect of vigabatrin given with an infant formula on the oral uptake and transepithelial transport was investigated in vitro in Caco-2 cells. In vivo effects of infant formula and selected amino acids on the pharmacokinetic profile of vigabatrin was investigated after oral coadministration to male Sprague–Dawley rats using acetaminophen as a marker for gastric emptying. The presence of infant formula significantly reduced the uptake rate and permeability of vigabatrin in Caco-2 cells. Oral coadministration of vigabatrin and infant formula significantly reduced Cmax and prolonged tmax of vigabatrin absorption. Ligands for the proton-coupled amino acid transporter PAT1, sarcosine, and proline/l-tryptophan had similar effects on the pharmacokinetic profile of vigabatrin. The infant formula decreased the rate of gastric emptying. Here we provide experimental evidence for an in vivo role of PAT1 in the intestinal absorption of vigabatrin. The effect of infant formula on the oral absorption of vigabatrin was found to be due to delayed gastric emptying, however, it seems reasonable that infant formula may also directly affect the intestinal absorption rate of vigabatrin possibly via PAT1.","author_count":0,"contributors":[],"cuid":["S01-000.00-499261"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corpau":["Martha Kampp Nøhr , Zia I. Thale , Birger Brodin , Steen H. Hansen , Rene Holm & Carsten Uhd Nielsen"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"intestinal absorption of the antiepileptic drug substance vigabatrin is altered by infant formula in vitro and in vivo","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1002/prp2.36","version":"Other Version"},"id":"S01-000.00-499261","identifier":[{"id":"25505585","type":"pmid"},{"id":"84905177480","type":"scopus"},{"id":"PMC4184708","type":"pmcid"}],"ids":["ku-b12bd5bc-742f-42ce-a663-cea5785f511e"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-938CEB2AF9F54C15AD9D9A71BF823A64"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1002/prp2.36","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":1,"key":"martha kampp nøhr zia i thale birger brodin steen h hansen rene holm carsten uhd nielsen","name":"Martha Kampp Nøhr , Zia I. Thale , Birger Brodin , Steen H. Hansen , Rene Holm & Carsten Uhd Nielsen","role":"oau"},{"affno":2,"key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Pharmacy, Pharmaceutical Design and Drug Delivery"],"nora_code":"DI-U-KU"}],"person":[],"pmid":["25505585"],"pub":{"doi":"10.1002/prp2.36","issn":["20521707"],"issue":"2","journal":"Pharmacology Research & Perspectives","pages":"1-11","paperid":"E00036","status":"p","title":"Pharmacology Research & Perspectives","volume":"2"},"review":"Peer Reviewed","scoID":["2-s2.0-84905177480"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-b12bd5bc-742f-42ce-a663-cea5785f511e"],"src":["KU University of Copenhagen"],"title":"Intestinal absorption of the antiepileptic drug substance vigabatrin is altered by infant formula in vitro and in vivo.","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-499261","year":"2014","yearsub":"2014"}
{"abstract":"INTRODUCTION: This study explored whether health-related quality of life (HRQOL) changes following Roux-en-Y gastric bypass surgery were associated with identifiable socio-demographic or clinical characteristics, and it examined the impact on health outcomes of changes in the Danish criteria for bariatric surgery. MATERIAL AND METHODS: Participants (n = 55) completed the Short Form Health Survey v2 (SF-36) before and 22 ± 4.2 months after surgery. Information on socio-demographics, body mass index (BMI), co-morbidity and satisfaction with surgery were collected through patient questionnaires and hospital records. RESULTS: There was overall improvement on all SF-36 subscales and in the mean physical score (PCS) and mean mental score (MCS) (p = 0.001). A total of five patients had lower PCS and 13 patients had lower MCS after surgery, but we identified no particular characteristics associated with this poorer outcome. Co-morbidity and preoperative PCS/MCS showed a strong correlation with change in PCS/MCS score. CONCLUSION: Gastric bypass had a positive overall effect on HRQOL, but further investigation of individual variations is needed. We found no significant differences in HRQOL outcome between those patients who would be accepted for bariatric surgery under the current Danish criteria for bariatric surgery and those patients who only fulfilled the criteria for bariatric surgery before 2011. FUNDING: not relevant. TRIAL REGISTRATION: ClinicalTrials.gov: NCT02032199.","author_count":3,"contributors":["Beck Hansen, Nina","Gudex, Claire","Støving, René Klinkby"],"cuid":["S01-000.00-631494"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"improvement in health related quality of life following roux en y gastric bypass","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84905455209","version":"Other Version"},"id":"S01-000.00-631494","identifier":[{"id":"25123120","type":"pmid"},{"id":"84905455209","type":"scopus"}],"ids":["sdu-cb56b35e-8d06-477a-8185-c636700592ac"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-A66B5EA59F555D7BA8454BC2B95017AC"],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","country":"dk","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Psychology","SDU, The Faculty of Health Sciences, Department of Psychology, The National Center of Psychotraumatology","University of Southern Denmark"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Nina Beck","key":"hansenpau","last":"Hansen","locid":"9e8ddeb7-5e9f-4dd2-bff8-ea0b98c03257","name":"Beck Hansen, Nina","name_org":"Hansen, Nina Beck","orcid":"0000-0002-2962-3311","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Claire","key":"gudexpau","last":"Gudex","locid":"f3926977-0fd9-4dc0-9456-8baf5c4ffafe","name":"Gudex, Claire","orcid":"0000-0003-3881-9890","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"René Klinkby","key":"støvingpau","last":"Støving","locid":"4aab81f6-352f-4c74-82a2-23589beb9fd5","name":"Støving, René Klinkby","orcid":"0000-0002-4255-5544","rank":3,"rolecode":"pau"}],"pmid":["25123120"],"pub":{"issn":["09078916","22451919"],"issn_org":["22451919"],"issue":"7","journal":"Danish Medical Journal","publisher":"Lægeforeningen","status":"p","title":"Danish Medical Journal","volume":"61"},"review":"Peer Reviewed","scoID":["2-s2.0-84905455209"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-cb56b35e-8d06-477a-8185-c636700592ac"],"src":["SDU University of Southern Denmark"],"title":"Improvement in health-related quality of life following Roux-en-Y gastric bypass","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-631494","year":"2014","yearsub":"2014"}
{"abstract":"Identifying provenance of data provides insights to the origin of data and intermediate results, and has recently gained increased interest due to data-centric applications. In this work we extend a data-centric system view with actors handling the data and policies restricting actions. This extension is based on provenance analysis performed on system models. System models have been introduced to model and analyse spatial and organisational aspects of organisations, to identify, e.g., potential insider threats. Both the models and analyses are naturally modular; models can be combined to bigger models, and the analyses adapt accordingly. Our approach extends provenance both with the origin of data, the actors and processes involved in the handling of data, and policies applied while doing so. The model and corresponding analyses are based on a formal model of spatial and organisational aspects, and static analyses of permissible actions in the models. While currently applied to organisational models, our approach can also be extended to work flows, thus targeting a more traditional model of provenance.","author_count":2,"contributors":["Probst, Christian W.","Hansen, Rene Rydhof"],"cuid":["S02-089.31-010265"],"event":{"end":"2014-06-13","place":"Cologne, de","start":"2014-06-12","title":"6th USENIX Workshop on the Theory and Practice of Provenance (TaPP '14)","year":"2014"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-AAU","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"model based abstraction of data provenance","src":["aau","dtu"],"src-code":["DI-U-AAU","DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/101144607/tapp14_paper_probst.pdf","version":"Published Version"},"funding_acknowledgement":["Part of the research leading to these results has received funding from the European Union Seventh Framework Programme (FP7/2007-2013) under grant agreement no. 318003 (TRESPASS). This publication reflects only the authors’ views and the Union is not liable for any use that may be made of the information contained herein."],"id":"S02-089.31-010265","identifier":[{"id":"85094892193","type":"scopus"}],"ids":["aau-d6b23b97-ef22-4c14-b073-31409833f142","dtu-d8a3c3df-6327-418c-a7b4-65d7157bf0e2"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-2-BDD73FCC68ED31E6169DF12085E5B205"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.usenix.org/conference/tapp2014/agenda/presentation/probst","version":"Other Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/101144607/tapp14_paper_probst.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Applied Mathematics and Computer Science","Technical University of Denmark, Department of Applied Mathematics and Computer Science, Language-Based Technology"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University","Aalborg University, The Faculty of Engineering and Science (TECH)","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science, Distributed Systems and Semantics"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Christian W.","key":"probstpau","last":"Probst","locid":"6f0f045b-6369-4416-a241-c59d9214b6b4","name":"Probst, Christian W.","orcid":"0000-0002-4947-355X","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"René Rydhof","key":"hansenpau","last":"Hansen","locid":"d92ec90d-a8b7-4c01-acbe-ebab21f3f0c3","name":"Hansen, Rene Rydhof","name_org":"Hansen, René Rydhof","orcid":"0000-0002-5688-6432","rank":2,"rolecode":"pau"}],"pub":{"publisher":"USENIX - The Advanced Computing Systems Association","status":"p","title":"Proceedings of the 6th USENIX Workshop on the Theory and Practice of Provenance (TaPP '14)"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["aau-d6b23b97-ef22-4c14-b073-31409833f142","dtu-d8a3c3df-6327-418c-a7b4-65d7157bf0e2"],"src":["AAU Aalborg University","DTU Technical University of Denmark"],"title":"Model-based Abstraction of Data Provenance","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-089.31-010265","year":"2014","yearsub":"2014"}
{"abstract":"The Certifiable Java for Embedded Systems (CJ4ES) project aimed to develop a prototype development environment and platform for safety-critical software for embedded applications. There are three core constituents: A profile of the Java programming language that is tailored for safety-critical applications, a predictable Java processor built with FPGA technology, and an Eclipse based application development environment that binds the profile and the platform together and provides analyses that help to provide evidence that can be used as part of a safety case. This paper summarizes key contributions within these areas during the three-year project period. In the conclusion the overall result of the project is assessed.","author_count":9,"contributors":["Schoeberl, Martin","Dalsgaard, Andreas Engelbredt","Hansen, Rene Rydhof","Korsholm, Stephan E.","Ravn, Anders Peter","Rivas, Juan Ricardo Rios","Strøm, Tórur Biskopstø","Søndergaard, Hans"],"cuid":["S02-098.22-001562"],"event":{"acronym":"JTRES","end":"2014-10-14","place":"Niagara Falls, NY, us","start":"2014-10-13","title":"12th International Workshop on Java Technologies for Real-Time and Embedded Systems","year":"2014"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Safety critical Java"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U","DI-UC"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-DTU"],"UC":["DI-UC-ALL","DI-UC-VIA"]},"level3all":["DI-U-AAU","DI-U-DTU","DI-UC-VIA"]},"review":"pr","rtype":["clu"],"sorti":"certifiable java for embedded systems","src":["aau","dtu"],"src-code":["DI-U-AAU","DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1145/2661020.2661025","version":"Other Version"},"id":"S02-098.22-001562","identifier":[{"id":"84937794867","type":"scopus"}],"ids":["aau-1efac5a6-bed9-4a41