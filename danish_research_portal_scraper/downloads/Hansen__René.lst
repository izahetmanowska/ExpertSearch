,"rank":12,"rolecode":"pau"},{"affno":"3","first":"Leila","key":"loleggiopau","last":"Lo Leggio","locid":"9b2c31e6-b95b-4a32-a86f-6c3c0d53fd03","name":"Lo Leggio, Leila","orcid":"0000-0002-5135-0882","rank":13,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Birte","key":"svenssonpau","last":"Svensson","locid":"1298d4cc-fb16-4b64-a4b3-dfdf516d472c","name":"Svensson, Birte","orcid":"0000-0002-2993-8196","rank":14,"rolecode":"pau"}],"pub":{"doi":"10.3109/10242422.2012.674717","issn":["10242422","10292446"],"issn_org":["10242422"],"issue":"3","journal":"Biocatalysis and Biotransformation","pages":"316-325","publisher":"Taylor and Francis Ltd.","status":"p","title":"Biocatalysis and Biotransformation","volume":"30"},"review":"Peer Reviewed","scoID":["2-s2.0-84861750735"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-75d3256b-5926-4ad1-9d89-ca1b111796eb","ku-5b4d1f02-c7c7-47a0-aa8c-244e7dcde57e"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Raffinose family oligosaccharide utilisation by probiotic bacteria: insight into substrate recognition, molecular architecture and diversity of GH36 alpha-galactosidases","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-098.33-035289","year":"2012","yearsub":"2012"}
{"abstract":"Lobectomies done by video-assisted thoracic surgery (VATS) result in fewer complications and less pain and save total costs compared with the traditional approach. However, the majority of procedures are still performed via open thoracotomies, because VATS lobectomy is considered difficult to learn, requiring experience in open surgery, and causing complications in the initial phase of the learning curve. The aim of this study was to describe a training model appreciating patient safety during training and to explore the initial learning curve for a trainee rather inexperienced in open surgery.","author_count":4,"contributors":["Konge, Lars","Petersen, René Horsleben","Hansen, Henrik Jessen","Ringsted, Charlotte"],"cuid":["S02-098.72-045490"],"filters":{"added":"2022-04","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"no extensive experience in open procedures is needed to learn lobectomy by video assisted thoracic surgery","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1093/icvts/ivs405","version":"Other Version"},"id":"S02-098.72-045490","identifier":[{"id":"84870159561","type":"scopus"},{"id":"PMC3501313","type":"pmcid"},{"id":"22968956","type":"pmid"}],"ids":["ku-b3832417-a2c6-4d96-aca9-d1a4f1f5f9e0","ku-d9049b0f-931b-4a0c-8560-b481ab473201"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-A78398C39365FAD11BC40668AA9C8E68"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1093/icvts/ivs405","version":"Other Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Lars","key":"kongepau","last":"Konge","locid":"e1c287e3-4cd2-43d2-887d-f2f77fd5daf8","name":"Konge, Lars","orcid":"0000-0002-1258-5822","rank":1,"rolecode":"pau"},{"affno":"1","first":"R. H.","key":"petersenpau","last":"Petersen","locid":"aa18983b-8811-4b3a-a7bd-b439cc52d3e3","name":"Petersen, René Horsleben","name_org":"Petersen, R. H.","orcid":"0000-0002-3586-1869","rank":2,"rolecode":"pau"},{"affno":"1","first":"H. J.","key":"hansenpau","last":"Hansen","locid":"b356d6b1-e9df-41d2-8001-e4fa6cc000e3","name":"Hansen, Henrik Jessen","name_org":"Hansen, H. J.","rank":3,"rolecode":"pau"},{"affno":"1","country":"dk","first":"C.","key":"ringstedpau","last":"Ringsted","locid":"aad0b8e6-2821-409d-9ed2-33b6ffded4d2","name":"Ringsted, Charlotte","name_org":"Ringsted, C.","rank":4,"rolecode":"pau"}],"pmid":["22968956"],"pub":{"doi":"10.1093/icvts/ivs405","issn":["15699285","15699293"],"issn_org":["15699293"],"issue":"6","journal":"Interactive Cardiovascular and Thoracic Surgery","pages":"961-965","status":"p","title":"Interactive Cardiovascular and Thoracic Surgery","volume":"15"},"review":"Peer Reviewed","scoID":["2-s2.0-84870159561"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-b3832417-a2c6-4d96-aca9-d1a4f1f5f9e0","ku-d9049b0f-931b-4a0c-8560-b481ab473201"],"src":["KU University of Copenhagen"],"title":"No extensive experience in open procedures is needed to learn lobectomy by video-assisted thoracic surgery","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-098.72-045490","year":"2012","yearsub":"2012"}
{"abstract":"Tendons are strong hierarchical structures, but how tensile forces are transmitted between different levels remains incompletely understood. Collagen fibrils are thought to be primary determinants of whole tendon properties, and therefore we hypothesized that the whole human patellar tendon and its distinct collagen fibrils would display similar mechanical properties. Human patellar tendons (n=5) were mechanically tested in vivo by ultrasonography. Biopsies were obtained from each tendon and individual collagen fibrils were dissected and tested mechanically by atomic force microscopy. The Young's modulus was 2.0±0.5 GPa and the toe region reached 3.3±1.9% strain in whole patellar tendons. Based on dry cross-sectional area the Young's modulus of isolated collagen fibrils was 2.8±0.3 GPa and the toe region reached 0.86±0.08% strain. The measured fibril modulus was insufficient to account for the modulus of the tendon in vivo when fibril content in the tendon was accounted for. Thus, our original hypothesis was not supported, although the in vitro fibril modulus corresponded well with reported in vitro tendon values. This correspondence together with the fibril modulus not being greater than that of tendon supports that fibrillar rather than interfibrillar properties govern sub-failure tendon response, making the fibrillar level a meaningful target of intervention. The lower modulus found in vitro suggests a possible adverse effect of removing the tissue from its natural environment. In addition to the primary work comparing the two hierarchical levels, we also verified the existence of viscoelastic behavior in isolated human collagen fibrils.","author_count":9,"contributors":["Svensson, Rene B.","Hansen, Philip","Hassenkam, Tue","Haraldsson, Bjarki T.","Aagaard, Per","Kovanen, Vuokko","Krogsgaard, Michael Rindom","Kjaer, Michael","Magnusson, S. Peter"],"cuid":["S02-100.00-046249"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","Nordic","OECD"],"country":["Finland"],"glorg":["All Global Affiliations","University of Jyväskylä"],"keyword":["Atomic force microscopy","Collagen","Modulus"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"mechanical properties of human patellar tendon at the hierarchical levels of tendon and fibril","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1152/japplphysiol.01172.2011","version":"Other Version"},"id":"S02-100.00-046249","identifier":[{"id":"22114175","type":"pmid"},{"id":"000300408300013","type":"wos"},{"id":"84856910100","type":"scopus"}],"ids":["ku-cbff6cdf-3063-4caa-b0d3-956a48eee432","sdu-0e1d2da6-e52a-4b1f-8932-c79a01444f97"],"keyword":["atomic force microscopy","collagen","fibril dimensions","modulus","toe region"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-CC6A7FAD65954C4D21D35AC92AF6B8C9"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1152/japplphysiol.01172.2011","version":"Other Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Center for Healthy Ageing","Københavns Universitet, Faculty of Science, Department of Chemistry, Nano-Science Center"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Science, Department of Biochemistry and Molecular Biology"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","country":"fi","key":"university of jyväskylä","loc":["Finland","Europe, EU","Nordic","OECD"],"name":"University of Jyväskylä","used":1}],"person":[{"affno":"1 2","first":"Rene B.","key":"svenssonpau","last":"Svensson","locid":"fe236d1a-ef32-4a22-8125-31211110d8c8","name":"Svensson, Rene B.","rank":1,"rolecode":"pau"},{"affno":"1","first":"Philip","key":"hansenpau","last":"Hansen","name":"Hansen, Philip","rank":2,"rolecode":"pau"},{"affno":"1","first":"Tue","key":"hassenkampau","last":"Hassenkam","locid":"bbbe3967-1193-44fc-a0dd-b6e29f3cfd35","name":"Hassenkam, Tue","orcid":"0000-0002-2184-3360","rank":3,"rolecode":"pau"},{"affno":"","first":"Bjarki T.","key":"haraldssonpau","last":"Haraldsson","locid":"08c7a329-2fd0-4121-abf7-62b9de5c9af3","name":"Haraldsson, Bjarki T.","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Per","key":"aagaardpau","last":"Aagaard","locid":"8452f86e-3c45-4ecb-9e11-54c72d45d669","name":"Aagaard, Per","orcid":"0000-0002-9773-7361","rank":5,"rolecode":"pau"},{"affno":"3","first":"Vuokko","key":"kovanenpau","last":"Kovanen","name":"Kovanen, Vuokko","rank":6,"rolecode":"pau"},{"affno":"1","first":"Michael","key":"krogsgaardpau","last":"Krogsgaard","locid":"f704dca0-ca86-405a-a7f2-cce1f75f6b8f","name":"Krogsgaard, Michael Rindom","name_org":"Krogsgaard, Michael","rank":7,"rolecode":"pau"},{"affno":"1","first":"Michael","key":"kjaerpau","last":"Kjaer","locid":"7937b8ab-7820-4d25-982f-1d2f58b033a3","name":"Kjaer, Michael","rank":8,"rolecode":"pau"},{"affno":"1","first":"S. Peter","key":"magnussonpau","last":"Magnusson","locid":"6f430caa-ac01-4dfe-9a62-e3a49afba21a","name":"Magnusson, S. Peter","rank":9,"rolecode":"pau"}],"pmid":["22114175"],"pub":{"doi":"10.1152/japplphysiol.01172.2011","issn":["15221601","87507587"],"issn_org":["87507587"],"issue":"3","journal":"Journal of Applied Physiology","pages":"419-426","publisher":"American Physiological Society","status":"p","title":"Journal of Applied Physiology","volume":"112"},"review":"Peer Reviewed","scoID":["2-s2.0-84856910100"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-cbff6cdf-3063-4caa-b0d3-956a48eee432","sdu-0e1d2da6-e52a-4b1f-8932-c79a01444f97"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Mechanical Properties of Human Patellar Tendon at the Hierarchical levels of Tendon and Fibril","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-046249","year":"2012","yearsub":"2012"}
{"abstract":"Indoor Positioning has been an active research area in the last decade, but so far, commercial Indoor Positioning Systems (IPSs) have been sparse. The main obstacle towards widely available IPSs has been the lack of appropriate, low cost technologies, that enable indoor positioning. While Wi-Fi infrastructures are ubiquitous, consumer-oriented Wi-Fi enabled mobile phones have been missing. Conversely, while Bluetooth technology is present in the vast majority of consumer mobile phones, Bluetooth infrastructures have been missing. Bluetooth infrastructures have typically been installed as part of complete hardware/software IPSs that often incur a substantial hardware cost. Furthermore, Bluetooth has low power consumption compared to Wi-Fi devices, which promotes longer battery life-time on mobile phones. In this paper, we present a Bluetooth IPS based entirely on commodity-grade products. The positioning accuracy is evaluated by using the so-called location fingerprinting technique which is well-known from Wi-Fi positioning literature. The results show that 2 meters median accuracy is achievable - a result that compares favourably to results for Wi-Fi based systems.","author_count":5,"contributors":["Frost, Christian","Jensen, Casper Svenning","Luckow, Kasper Søe","Thomsen, Bent","Hansen, Rene"],"cuid":["S01-000.00-075553"],"event":{"acronym":"MobiLight","end":"2011-05-11","place":"Bilbao, es","start":"2011-05-09","title":"Third International ICST Conference, MOBILIGHT 2011","year":"2011"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Bluetooth","Indoor Positioning"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"bluetooth indoor positioning system using fingerprinting","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-3-642-29479-2_11","version":"Other Version"},"id":"S01-000.00-075553","identifier":[{"id":"84869596660","type":"scopus"}],"ids":["aau-57e2c200-ac7e-479d-bb4d-10196c65b7c9"],"keyword":["Bluetooth","Indoor positioning"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-8DF9A1238F61D7000B0FD57BC78EF295"],"oa_link":[{"access":"oa","type":"rem","url":"http://dx.doi.org/10.1007/978-3-642-29479-2_11","version":"Other Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-3-642-29479-2_11","version":"Other Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (TECH)","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Christian","key":"frostpau","last":"Frost","locid":"9ff9ad15-4e49-46c2-9889-6079841d00b0","name":"Frost, Christian","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Casper Svenning","key":"jensenpau","last":"Jensen","locid":"bbac3545-2009-4f04-9c45-65b26220d43e","name":"Jensen, Casper Svenning","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kasper Søe","key":"luckowpau","last":"Luckow","locid":"f79d6df8-3c3a-4c1c-ace8-f27d6bfb0906","name":"Luckow, Kasper Søe","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Bent","key":"thomsenpau","last":"Thomsen","locid":"e47d25c8-df5c-453f-bcd7-0921f9915911","name":"Thomsen, Bent","orcid":"0000-0002-5853-7973","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rene","key":"hansenpau","last":"Hansen","locid":"518e959f-9db2-4aed-9576-c6a716b5ed48","name":"Hansen, Rene","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-642-29479-2_11","eisbn":["9783642294792"],"isbn":["9783642294785"],"issn":["18678211"],"pages":"136-150","publisher":"Springer","series":"Lecture Notes of the Institute for Computer Sciences, Social Informatics and Telecommunications Engineering","status":"p","subtitle":"Third International ICST Conference, MOBILIGHT 2011, Bilbao, Spain, May 9-10, 2011, Revised Selected Papers","title":"Mobile Lightweight Wireless Systems","volume":"81"},"review":"Peer Reviewed","scoID":["2-s2.0-84869596660"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-57e2c200-ac7e-479d-bb4d-10196c65b7c9"],"src":["AAU Aalborg University"],"title":"Bluetooth Indoor Positioning System using Fingerprinting","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-075553","year":"2012","yearsub":"2012"}
{"abstract":"Despite its estimated high heritability, the genetic architecture leading to differences in cognitive performance remains poorly understood. Different cortical regions play important roles in normal cognitive functioning and impairment. Recently, we reported on sets of regionally enriched genes in three different cortical areas (frontomedial, temporal and occipital cortices) of the adult rat brain. It has been suggested that genes preferentially, or specifically, expressed in one region or organ reflect functional specialisation. Employing a gene-based approach to the analysis, we used the regionally enriched cortical genes to mine a genome-wide association study (GWAS) of the Norwegian Cognitive NeuroGenetics (NCNG) sample of healthy adults for association to nine psychometric tests measures. In addition, we explored GWAS data sets for the serious psychiatric disorders schizophrenia (SCZ) (n¿=¿3 samples) and bipolar affective disorder (BP) (n¿=¿3 samples), to which cognitive impairment is linked.","author_count":22,"contributors":["Ersland, Kari M","Christoforou, Andrea","Stansberg, Christine","Espeseth, Thomas","Mattheisen, Manuel","Mattingsdal, Morten","Hardarson, Gudmundur A","Hansen, Thomas","Fernandes, Carla P D","Giddaluru, Sudheer","Breuer, René","Strohmaier, Jana","Djurovic, Srdjan","Nöthen, Markus M","Rietschel, Marcella","Lundervold, Astri J","Werge, Thomas","Cichon, Sven","Andreassen, Ole A","Reinvang, Ivar","Steen, Vidar M","Le Hellard, Stephanie"],"cuid":["S01-000.00-463885"],"filters":{"added":"2022-04","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"gene based analysis of regionally enriched cortical genes in gwas data sets of cognitive traits and psychiatric disorders","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1371/journal.pone.0031687","version":"Other Version"},"id":"S01-000.00-463885","identifier":[{"id":"84857480986","type":"scopus"}],"ids":["ku-75cafbd3-01c0-43cd-8f46-2414ca861381"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-CE257DBFE8817D5ADC6E2515380393E9"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1371/journal.pone.0031687","version":"Other Version"}],"org":[{"affno":1,"key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Section of Neurology, Psychiatry and Sensory Sciences"],"nora_code":"DI-U-KU"}],"person":[{"affno":"","first":"Kari M","key":"erslandpau","last":"Ersland","name":"Ersland, Kari M","rank":1,"rolecode":"pau"},{"affno":"","first":"Andrea","key":"christoforoupau","last":"Christoforou","name":"Christoforou, Andrea","rank":2,"rolecode":"pau"},{"affno":"","first":"Christine","key":"stansbergpau","last":"Stansberg","name":"Stansberg, Christine","rank":3,"rolecode":"pau"},{"affno":"","first":"Thomas","key":"espesethpau","last":"Espeseth","name":"Espeseth, Thomas","rank":4,"rolecode":"pau"},{"affno":"","first":"Manuel","key":"mattheisenpau","last":"Mattheisen","name":"Mattheisen, Manuel","rank":5,"rolecode":"pau"},{"affno":"","first":"Morten","key":"mattingsdalpau","last":"Mattingsdal","name":"Mattingsdal, Morten","rank":6,"rolecode":"pau"},{"affno":"","first":"Gudmundur A","key":"hardarsonpau","last":"Hardarson","name":"Hardarson, Gudmundur A","rank":7,"rolecode":"pau"},{"affno":"","first":"Thomas","key":"hansenpau","last":"Hansen","name":"Hansen, Thomas","rank":8,"rolecode":"pau"},{"affno":"",