id":"0000-0001-6551-6647","rank":20,"rolecode":"pau"}],"pmid":["33900050"],"pub":{"doi":"10.1002/clt2.12013","issn":["20457022"],"issue":"1","journal":"Clinical and Translational Allergy","paperid":"e12013","publisher":"John Wiley & Sons Inc.","status":"p","title":"Clinical and Translational Allergy","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-85104888834"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Miscellaneous","North Denmark Region","Other Hospitals","Other Research","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark","danish clinical registries (rkkp)","regionernes kliniske kvalitetsudviklingsprogram"],"PST":["Published"]},"sid":["aau-fb54cd4f-d23c-4adc-89e6-7ffc3b41c5e2","au-330451bf-e322-4a6e-9e68-26125b6f36f1","ku-5883f97a-a04c-4380-abf6-e35841b3b44d","sdu-1afbd080-db19-458c-83c8-6196ef286f9c"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Combinations of self-reported rhinitis, conjunctivitis, and asthma predicts IgE sensitization in more than 25,000 Danes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-099.96-011972","year":"2021","yearsub":"2021"}
{"abstract":"The everyday lives of Danish inhabitants have been affected by the COVID-19 pandemic, e.g., by social distancing, which was employed by the government in March 2020 to prevent the spread of SARS-CoV-2. Moreover, the pandemic has entailed economic consequences for many people. This study aims to assess changes in physical and mental health-related quality of life (MCS, PCS), in stress levels, and quality of sleep during the COVID-19 pandemic and to identify factors that impact such changes, using a prospective national cohort study including 26,453 participants from the Danish Blood Donor Study who answered a health questionnaire before the pandemic and during the pandemic. Descriptive statistics, multivariable linear and multinomial logistic regression analyses were applied. A worsening of MCS and quality of sleep was found, and an overall decrease in stress levels was observed. PCS was decreased in men and slightly increased in women. The extent of health changes was mainly affected by changes in job situation, type of job, previous use of anti-depressive medication and the participants' level of personal stamina. Thus, living under the unusual circumstances that persisted during the COVID-19 pandemic has had a negative impact on the health of the general population. This may, in time, constitute a public health problem.","author_count":15,"contributors":["Didriksen, Maria","Werge, Thomas","Nissen, Janna","Schwinn, Michael","Sørensen, Erik","Nielsen, Kaspar René","Bruun, Mie T","Banasik, Karina","Hansen, Thomas F","Erikstrup, Christian","Ostrowski, Sisse R","Jennum, Poul J","Hjalgrim, Henrik","Ullum, Henrik","Pedersen, Ole B"],"cuid":["S04-100.00-000137"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"corresponding_author":["Didriksen, Maria"],"keyword":["Adult","Cohort Studies","Covid 19","Cross Sectional Studies","Denmark epidemiology","Epidemiology","Female","Humans","Male","Mental health","Pandemic","Pandemics","Prospective Studies","Public health","Quality of Life","SARS CoV 2","Sleep","Social isolation","Validation"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-NP","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA"],"NP":["DI-NP-ALL","DI-NP-LUND"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA","DI-NP-LUND","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"impact of covid 000000000019 pandemic on sleep quality stress level and health related quality of life a large prospective cohort study on adult danes","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/ijerph18147610","version":"Published Version"},"id":"S04-100.00-000137","identifier":[{"id":"PMC8307688","type":"pmcid"},{"id":"34300061","type":"pmid"},{"id":"85112483671","type":"scopus"},{"id":"000679281500001","type":"wos"}],"ids":["aau-029c0cb1-2b9a-42e1-867a-32c6500cbbd3","au-3245144f-29f1-4b03-b84c-7fb17ee0df61","ku-9c34ce07-6fd6-4d67-b332-7d6f31052c0f","sdu-83df39ad-2a5d-452a-8615-8a09831246c9"],"keyword":["Adult","COVID-19","Cohort Studies","Cross-Sectional Studies","Denmark/epidemiology","Female","Humans","Male","Pandemics","Prospective Studies","Quality of Life","SARS-CoV-2","SOCIAL-ISOLATION","Sleep","VALIDATION","epidemiology","mental health","pandemic","public health"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-7-C133FBB18D6D9EE54005508F6BD209B9"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/445017000/Didriksen_et_al._2021_._Impact_of_COVI