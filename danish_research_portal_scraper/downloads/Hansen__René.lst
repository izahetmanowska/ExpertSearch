4f3dc56c386","name":"Søndergaard, Jens","orcid":"0000-0002-1629-1864","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Janus Laust","key":"thomsenpau","last":"Thomsen","locid":"109619c5-41c7-4049-897f-5d6f92e4fe12","name":"Thomsen, Janus Laust","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Dorte","key":"gilsåhansenpau","last":"Gilså Hansen","locid":"a2826791-eb97-4bca-8af7-448b0940e6e5","name":"Hansen, Dorte Gilså","name_org":"Gilså Hansen, Dorte","orcid":"0000-0002-5946-9968","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-3dbac4ff-7f49-4849-8a47-4f19aeadb106"],"src":["SDU University of Southern Denmark"],"title":"Udvikling og validering af et webbaseret spørgeskema til behovsvurdering blandt kræftpatienter i almen praksis","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-590937","year":"2013","yearsub":"2013"}
{"abstract":"Background:This study investigated the clinical importance of linked angiogenetic biomarkers to chemotherapy, combined with the anti-vascular endothelial growth factor A (anti-VEGF-A), as a first-line treatment in patients with metastatic colorectal cancer (mCRC).Methods:A total of 230 patients from a randomised phase III study were included. The primary microRNA-126 (pri-miRNA-126) A24G single-nucleotide polymorphism and the mature miRNA-126 were analysed by PCR using genomic DNA (full blood) and formalin-fixed paraffin-embedded tissue sections, respectively. The epidermal growth factor-like domain 7 (EGFL7) protein was visualised and quantified using immunohistochemistry.Results:High tumour expression of miRNA-126 was significantly related to a longer progression-free survival. The independent prognostic value of miRNA-126 was confirmed using a Cox regression analysis (hazard ratio=0.49, 95% confidence interval=0.29-0.84, P=0.009). Although not significant, a relationship between EGFL7 expression and response rates is suggested, with EGFL7 expression at the invasive front being lower in responding patients than in the non-responders (P=0.063).Conclusion:The results validate the previous findings on the prognostic value of miRNA-126 in mCRC and may suggest a relationship between treatment efficacy and EGFL7 expression. As miRNA-126 may target VEGF-A as well as EGFL7, the results may provide predictive information in relation to next-generation anti-angiogenetics.","author_count":6,"contributors":["Hansen, Torben Frøstrup","Christensen, René dePont","Andersen, Rikke Fredslund","Sørensen, Flemming Brandt","Johnsson, A","Jakobsen, Anders"],"cuid":["S01-000.00-638926"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"microrna 000000000126 and epidermal growth factor like domain 000000000007 an angiogenic couple of importance in metastatic colorectal cancer results from the nordic act trial","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1038/bjc.2013.448","version":"Other Version"},"id":"S01-000.00-638926","identifier":[{"id":"84883742865","type":"scopus"},{"id":"PMC3778299","type":"pmcid"},{"id":"23922111","type":"pmid"}],"ids":["sdu-e5815454-22b8-4d8b-92f8-9ff9a682a657"],"keyword":["angiogenesis; chemotherapy; colorectal neoplasms; epidermal growth factor-like domain 7; microRNA; predictive biomarkers"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-25FC96AD64EA999215C6AD065699FF7B"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1038/bjc.2013.448","version":"Other Version"}],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Lillebælt Hospital, Research Unit of Oncology (Vejle)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"T F","key":"hansenpau","last":"Hansen","locid":"72d28643-c440-4bbd-ad2b-eef0903a9438","name":"Hansen, Torben Frøstrup","name_org":"Hansen, T F","orcid":"0000-0001-7476-671X","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"René dePont","key":"christensenpau","last":"Christensen","locid":"3f33c4f0-abcb-42c6-85af-2d24bcf025ff","name":"Christensen, René dePont","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"R F","key":"andersenpau","last":"Andersen","locid":"e82f9773-7004-444a-8176-b55f6342dd3d","name":"Andersen, Rikke Fredslund","name_org":"Andersen, R F","orcid":"0000-0002-5894-7745","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"F B","key":"sørensenpau","last":"Sørensen","locid":"ac3af930-9550-4d18-9269-4dc0a6d649e5","name":"Sørensen, Flemming Brandt","name_org":"Sørensen, F B","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"A","key":"johnssonpau","last":"Johnsson","name":"Johnsson, A","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"A","key":"jakobsenpau","last":"Jakobsen","locid":"6c772581-e8fe-48bc-a932-1d1c5122c25a","name":"Jakobsen, Anders","name_org":"Jakobsen, A","orcid":"0000-0003-2110-2615","rank":6,"rolecode":"pau"}],"pmid":["23922111"],"pub":{"doi":"10.1038/bjc.2013.448","issn":["00070920","15321827"],"issn_org":["00070920"],"issue":"5","journal":"British Journal of Cancer","pages":"1243-1251","publisher":"Springer","status":"p","title":"British Journal of Cancer","volume":"109"},"review":"Peer Reviewed","scoID":["2-s2.0-84883742865"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-e5815454-22b8-4d8b-92f8-9ff9a682a657"],"src":["SDU University of Southern Denmark"],"title":"MicroRNA-126 and epidermal growth factor-like domain 7-an angiogenic couple of importance in metastatic colorectal cancer. Results from the Nordic ACT trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-638926","year":"2013","yearsub":"2013"}
{"abstract":"Rapportens primære målgruppe er studerende ved de finansielle uddannelser, og forudsætter et vist kendskab til makroøkonomi og statistik. Den vil kunne læses af studerende på 3. semester på både finansøkonom- og finansbachelor-uddannelserne. I rapporten diskuteres og opdateres Cantor og Packers model for forudsigelse/forståelse af landes credit ratings vha. makroøkonomiske størrelser. Den anvendte model er lineær regression.","author_count":3,"contributors":["Jensen, Anders Bønnelykke","Thomsen, Rene Østergaard","Hansen, Kenneth"],"cuid":["S01-000.00-650111"],"filters":{"added":"2023-01","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["økonomi"],"level":"sci","oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-UC"],"level3":{"UC":["DI-UC-ALL","DI-UC-UCN"]},"level3all":["DI-UC-UCN"]},"review":"nr","rtype":["clu"],"sorti":"et studie af credit ratings for lande","src":["ucn"],"src-code":["DI-UC-UCN"],"type":"db","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://ucviden.ucn.dk/ws/files/21602513/Credit_Ratings_for_lande.pdf","version":"Pre-print"},"id":"S01-000.00-650111","ids":["ucn-075f6c1d-7e92-4667-b53c-bd776a9fc278"],"keyword":["økonomi"],"lang":"Danish","level":"Scientific","noi":["Local-1-1-314B95B570D77AD8E42E4A6BEBA05C7B"],"oa_link":[{"access":"oa","type":"loc","url":"https://ucviden.ucn.dk/ws/files/21602513/Credit_Ratings_for_lande.pdf","version":"Pre-print"}],"org":[{"affno":"1","key":"ucn university college of northern denmark","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-UCN","l3nl":"University College of Northern Denmark","l3nn":"UCN University College of Northern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"UCN University College of Northern Denmark","namevar":["Professionshøjskolen UCN, UCN Direktion, UCN Erhverv, Finansuddannelserne"],"nora_code":"DI-UC-UCN","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anders Bønnelykke","key":"jensenpau","last":"Jensen","locid":"90122e66-090a-4871-8e38-4a4139fe6d07","name":"Jensen, Anders Bønnelykke","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rene Østergaard","key":"thomsenpau","last":"Thomsen","locid":"3a725eae-16d1-4166-ab98-fa441e982018","name":"Thomsen, Rene Østergaard","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kenneth","key":"hansenpau","last":"Hansen","locid":"195835eb-c131-4786-8d6b-00928d62e749","name":"Hansen, Kenneth","orcid":"0000-0003-2626-1105","rank":3,"rolecode":"pau"}],"pub":{"pages":"23","publisher":"UCN","status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All University Colleges","DI-ALL","DI-UC","DI-UC-ALL","University College of Northern Denmark","University Colleges"],"PST":["Published"]},"sid":["ucn-075f6c1d-7e92-4667-b53c-bd776a9fc278"],"src":["UCN University College of Northern Denmark"],"title":"Et studie af credit ratings for lande","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-650111","year":"2013","yearsub":"2013"}
{"abstract":"[Open access]Purpose. This study investigates the acute and longitudinal effects of resistance training on occupational muscle activity in office workers with chronic pain. Methods. 30 female office workers with chronic neck and shoulder pain participated for 10 weeks in high-intensity elastic resistance training for 2 minutes per day () or in control receiving weekly email-based information on general health (). Electromyography (EMG) from the splenius and upper trapezius was recorded during a normal workday. Results. Adherence to training and control interventions were 86% and 89%, respectively. Compared with control, training increased isometric muscle strength 6% () and decreased neck/shoulder pain intensity by 40% (). The frequency of periods with complete motor unit relaxation (EMG gaps) decreased acutely in the hours after training. By contrast, at 10-week follow-up, training increased average duration of EMG gaps by 71%, EMG gap frequency by 296% and percentage time below 0.5%, and 1.0% EMGmax by 578% and 242%, respectively, during the workday in m. splenius. Conclusion. While resistance training acutely generates a more tense muscle activity pattern, the longitudinal changes are beneficial in terms of longer and more frequent periods of complete muscular relaxation and reduced pain.","author_count":8,"contributors":["Lidegaard, Mark","Jensen, René Bøge","Andersen, Christoffer Højnicke","Zebis, Mette Kreutzfeldt","Colado, J.C.","Wang, Y.","Heilskov-Hansen, T.","Andersen, Lars Louis"],"cuid":["S01-000.00-781368"],"filters":{"added":"2025-01","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV"],"level3":{"GV":["DI-GV-ALL","DI-GV-WORK"]},"level3all":["DI-GV-WORK"]},"review":"pr","rtype":["clu"],"sorti":"effect of brief daily resistance training on occupational neck shoulder muscle activity in office workers with chronic pain randomized controlled trial","src":["nfa"],"src-code":["DI-GV-WORK"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org//10.1155/2013/262386","version":"Published Version"},"id":"S01-000.00-781368","identifier":[{"id":"84896090928","type":"scopus"}],"ids":["nfa-a074aeca-3a24-4394-b009-fce0ae0b6dd9"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-4-8823BC3DCE688218132B3778E38FFD6B"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org//10.1155/2013/262386","version":"Published Version"}],"org":[{"affno":1,"key":"nfa national research centre for the working environment","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-WORK","l3nl":"NFA National Research Centre for the Working Environment","l3nn":"NFA National Research Centre for the Working Environment","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"NFA National Research Centre for the Working Environment","namevar":["NFA National Research Centre for the Working Environment"],"nora_code":"DI-GV-WORK"}],"person":[{"affno":"","corresponding":null,"first":"Mark","key":"lidegaardmarkpau","last":"Lidegaard","name":"Lidegaard, Mark","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"René Bøge","key":"jensenrenébøgepau","last":"Jensen","locid":"d23ac0a1-72f7-4f10-bd00-9855984ee2b6","name":"Jensen, René Bøge","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Christoffer Højnicke","key":"andersenchristofferhøjnickepau","last":"Andersen","locid":"65677024-5362-4e70-8ae0-baa7aac0d978","name":"Andersen, Christoffer Højnicke","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Mette Kreutzfeldt","key":"zebismettekreutzfeldtpau","last":"Zebis","locid":"4f62cfed-254d-4f65-b1a4-a54223fcaf88","name":"Zebis, Mette Kreutzfeldt","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"J.C.","key":"coladojcpau","last":"Colado","name":"Colado, J.C.","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Y.","key":"wangypau","last":"Wang","name":"Wang, Y.","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"T.","key":"heilskovhansentpau","last":"Heilskov-Hansen","name":"Heilskov-Hansen, T.","rank":7,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Lars Louis","key":"andersenlarslouispau","last":"Andersen","locid":"7918e862-7513-454a-874b-3fdb31af5e48","name":"Andersen, Lars Louis","orcid":"0000-0003-2777-8085","rank":8,"rolecode":"pau"}],"pub":{"doi":"10.1155/2013/262386","issn":["23146133","23146141"],"issn_org":["23146133"],"journal":"BioMed Research International","pages":"262386","publisher":"John Wiley and Sons Ltd","status":"p","title":"BioMed Research International","volume":"2013"},"review":"Peer Reviewed","scoID":["2-s2.0-84896090928"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","DI-ALL","DI-GV","DI-GV-ALL","NFA National Research Centre for the Working Environment"],"PST":["Published"]},"sid":["nfa-a074aeca-3a24-4394-b009-fce0ae0b6dd9"],"src":["NFA National Research Centre for the Working Environment"],"title":"Effect of brief daily resistance training on occupational neck/shoulder muscle activity in office workers with chronic pain: randomized controlled trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-781368","year":"2013","yearsub":"2013"}
