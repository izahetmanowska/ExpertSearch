e":"pau"},{"affno":"2","corresponding":null,"first":"Hreinn","key":"stefánssonhreinnpau","last":"Stefánsson","name":"Stefánsson, Hreinn","rank":51,"rolecode":"pau"},{"affno":"15","corresponding":null,"first":"Susanne","key":"sækmosesusannepau","last":"Sækmose","name":"Sækmose, Susanne","rank":52,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Erik","key":"sørensenerikpau","last":"Sørensen","name":"Sørensen, Erik","rank":53,"rolecode":"pau"},{"affno":"19","corresponding":null,"first":"Henrik","key":"ullumhenrikpau","last":"Ullum","name":"Ullum, Henrik","rank":54,"rolecode":"pau"},{"affno":"20","corresponding":null,"first":"Thomas","key":"wergethomaspau","last":"Werge","name":"Werge, Thomas","rank":55,"rolecode":"pau"}],"pmid":["36125206"],"pub":{"doi":"10.1093/eurjpc/zwac219","issn":["20474873","20474881"],"issn_org":["20474873"],"issue":"18","journal":"European Journal of Preventive Cardiology","pages":"2374-2385","paperid":"zwac219","publisher":"Oxford University Press","status":"p","title":"European Journal of Preventive Cardiology","volume":"29"},"review":"Peer Reviewed","scoID":["2-s2.0-85154045599"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Miscellaneous","All Non-Profit Organisations","All Universities","Capital Region of Denmark","Central Denmark Region","Copenhagen Business School","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-NP","DI-NP-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Miscellaneous","Non-Profit Organisations","North Denmark Region","Other Research","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-fab75f68-cc19-446e-b6bb-a13e625da796","au-6ba7ddb1-b4a5-423c-9f98-107bd8082294","cbs-27d43745-b3ff-45e9-b7bf-ec7b7292ec17","ku-3f7e3ca1-359b-4fdc-b589-4a4283d58a99","sdu-98127bc3-6654-475e-9a29-64ea51ab5eb8"],"src":["AAU Aalborg University","AU Aarhus University","CBS Copenhagen Business School","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Cholesterol Not Particle Concentration Mediates the Atherogenic Risk Conferred by Apolipoprotein B Particles : A Mendelian Randomization Analysis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S05-097.04-011944","year":"2022","yearsub":"2022"}
{"abstract":"Efficient development of new solid-state electrolytes based on closo-borates, an emerging class of ion conductors, relies on a thorough understanding of these materials, including their crystal structures and derived trends thereof. Here we present the syntheses and crystal structures of the first anhydrous decahydro-closo-decaborates of divalent cations (Sr2+ and Mn2+), expanding the library of available closo-borate compounds. The structures of the two compounds are highly dissimilar, displaying a distorted bcc- or helical anion sublattice, as well as a tetrahedral or trigonal coordination environment of the cation in SrB10H10 and MnB10H10, respectively. Crystal structures of two hydrates of the compounds were also solved, SrB10H10∙4H2O and MnB10H10∙6H2O, and the (di)hydrogen bond network was investigated based on their structures optimized by density functional theory. The characterization of these new compounds, as well as the insight provided by comparing with previously reported closo-borates, are useful for designing new materials with high ionic conductivity or other desirable properties by revealing which compounds are likely to have compatible crystal structures, e.g. for aliovalent substitution.","author_count":5,"contributors":["Jørgensen, Mathias","Lee, Young Su","Paskevicius, Mark","R. S. Hansen, Bjarne","Jensen, Torben René"],"cuid":["S01-000.00-170350"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Asia, East","OECD","Oceania"],"corresponding_author":["Jensen, Torben René"],"country":["Australia","South Korea"],"glorg":["All Global Affiliations","Curtin University","Korea Institute of Science and Technology"],"keyword":["Boranes","Crystal engineering","Crystal structure determination","DODECABORATE","Metals","Powder X ray diffraction","Stability"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"synthesis and crystal structures of decahydro i closo i decaborates of the divalent cations of strontium and manganese","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85103779408","version":"Other Version"},"id":"S01-000.00-170350","identifier":[{"id":"85103779408","type":"scopus"},{"id":"000644702700039","type":"wos"}],"ids":["au-47f1f761-b2d1-4fe7-9ecf-6b1344038ecb"],"keyword":["BORANES","Crystal engineering","Crystal structure determination","DODECABORATE","METALS","Metal closo-borates","Powder X-ray diffraction","STABILITY"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-AB8979872E7B637475B8082203D2DF63"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Chemistry","Aarhus University, Natural Sciences, Interdisciplinary Nanoscience Center"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"kr","key":"korea institute of science and technology","loc":["South Korea","Asia, East","OECD"],"name":"Korea Institute of Science and Technology","used":1},{"affno":"3","country":"au","key":"curtin university","loc":["Australia","Oceania","OECD"],"name":"Curtin University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Mathias","key":"jørgensenpau","last":"Jørgensen","locid":"32e93198-01d2-4718-84d6-d305f21bff00","name":"Jørgensen, Mathias","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Young Su","key":"leepau","last":"Lee","name":"Lee, Young Su","rank":2,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"first":"Mark","key":"paskeviciuspau","last":"Paskevicius","locid":"e26eea7d-e55a-4989-80de-dfafd2146511","name":"Paskevicius, Mark","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Bjarne R.S.","key":"hansenpau","last":"Hansen","locid":"95e2932e-526e-4795-b38a-7ab221f891ae","name":"R. S. Hansen, Bjarne","name_org":"Hansen, Bjarne R.S.","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Torben R.","key":"jensenpau","last":"Jensen","locid":"e0750478-df89-45bf-aa48-b6a86de93fa0","name":"Jensen, Torben René","name_org":"Jensen, Torben R.","orcid":"0000-0002-4278-3221","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.jssc.2021.122133","issn":["00224596","1095726X"],"issn_org":["00224596"],"journal":"Journal of Solid State Chemistry","paperid":"122133","publisher":"Academic Press Inc.","status":"p","title":"Journal of Solid State Chemistry","volume":"298"},"review":"Peer Reviewed","scoID":["2-s2.0-85103779408"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-47f1f761-b2d1-4fe7-9ecf-6b1344038ecb"],"src":["AU Aarhus University"],"title":"Synthesis and crystal structures of decahydro-<i>closo</i>-decaborates of the divalent cations of strontium and manganese","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-170350","year":"2021","yearsub":"2021"}
{"abstract":"Background: Nonsteroidal anti-inflammatory drugs (NSAIDs) are commonly used in the treatment of Achilles tendinopathy, but whether they have any additive clinical effect on physical rehabilitation in the early phase of tendinopathy remains unknown. Purpose/Hypothesis: To investigate whether an initial short-term NSAID treatment added to a physical rehabilitation program in the early phase of Achilles tendinopathy would have an additive effect. We hypothesized that the combination of NSAID and rehabilitation would be superior to rehabilitation alone. Study Design: Randomized controlled trial; Level of evidence, 1. Methods: A total of 69 patients with early phase Achilles tendinopathy (lasting <3 months) were randomly assigned to either a naproxen group (7 days of treatment; 500 mg twice daily; n = 34) or a placebo group (7 days of placebo treatment; n = 35). Both groups received an identical 12-week physical rehabilitation program. The clinical outcome of the study was evaluated using the Victorian Institute of Sports Assessment–Achilles (VISA-A) questionnaire and a numerical rating scale (NRS), and the physiological outcome was evaluated using ultrasonography, magnetic resonance imaging (MRI), and ultra-short time to echo T2* mapping MRI (UTE T2* MRI). Follow-up was performed at 1 week, 3 months, and 1 year. Time effects are presented as mean difference ± SEM. Results: No significant differences were found between the 2 treatment groups for any of the outcome measures at any time point (P >.05). For the VISA-A score, a significant time effect was observed between baseline and 3-month follow-up (14.9 ± 2.3; P <.0001), and at 1-year follow-up, additional improvements were observed (6.1 ± 2.3; P <.01). Furthermore, the change in VISA-A score between baseline and 3-month follow-up was greater in patients with very short symptom duration (<1 month) at baseline compared with patients who had longer symptom duration (>2 months) (interaction between groups, 11.7 ± 4.2; P <.01). Despite clinical improvements, total weekly physical activity remained lower compared with preinjury levels at 3 months (–2.7 ± 0.5 h/wk; P <.0001) and 1 year (–3.0 ± 0.5 h/wk; P <.0001). At baseline, ultrasonography showed increased thickness (0.12 ± 0.03 cm; P <.0001) and vascularity (0.3 ± 0.1 cm2; P <.005) on the tendinopathic side compared with the contralateral side, but no changes over time were observed for ultrasonography, MRI, or UTE T2* MRI results. Conclusion: Clinical symptoms in early tendinopathy improved with physical rehabilitation, but this improvement was not augmented with the addition of NSAID treatment. Furthermore, this clinical recovery occurred in the absence of any measurable structural alterations. Finally, clinical improvements after a physical rehabilitation program were greater in patients with very short symptom duration compared with patients who had longer symptom duration. Registration: NCT03401177 (ClinicalTrials.gov identifier) and BFH-2016-019 (Danish Data Protection Agency)","author_count":9,"contributors":["Malmgaard-Clausen, Nikolaj M.","Jørgensen, Oscar H.","Hoeffner, Rikke","Andersen, Peter E.B.","Svensson, Rene B.","Hansen, Philip","Nybing, Janus D.","Magnusson, S. Peter","Kjaer, Michael"],"cuid":["S01-000.00-542699"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Achilles tendon","Clinical research","Imaging","Magnetic resonance","NSAID","physical therapy rehabilitation"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"no additive clinical or physiological effects of short term anti inflammatory treatment to physical rehabilitation in the early phase of human achilles tendinopathy a randomized controlled trial","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-542699","identifier":[{"id":"85102514062","type":"scopus"},{"id":"33719579","type":"pmid"}],"ids":["ku-fa1a01c2-4635-41cc-a7a6-be0f4e579cb2"],"keyword":["Achilles tendon","NSAID","clinical research","diagnostic ultrasonography","imaging","magnetic resonance","physical therapy/rehabilitation"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-E3AC842760C91D4A4742278F06A5A42C"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Center for Healthy Ageing"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Bispebjerg and Frederiksberg"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","first":"Nikolaj M.","key":"malmgaardclausenpau","last":"Malmgaard-Clausen","locid":"839d7576-e09c-4bf6-acfc-0b7ccc0bd358","name":"Malmgaard-Clausen, Nikolaj M.","rank":1,"rolecode":"pau"},{"affno":"2","first":"Oscar H.","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, Oscar H.","rank":2,"rolecode":"pau"},{"affno":"1","first":"Rikke","key":"høffnerpau","last":"Høffner","locid":"324e02c5-665e-4479-af4e-adceafb55774","name":"Hoeffner, Rikke","name_org":"Høffner, Rikke","rank":3,"rolecode":"pau"},{"affno":"","first":"Peter E.B.","key":"andersenpau","last":"Andersen","name":"Andersen, Peter E.B.","rank":4,"rolecode":"pau"},{"affno":"1","first":"Rene B.","key":"svenssonpau","last":"Svensson","locid":"fe236d1a-ef32-4a22-8125-31211110d8c8","name":"Svensson, Rene B.","rank":5,"rolecode":"pau"},{"affno":"","first":"Philip","key":"hansenpau","last":"Hansen","name":"Hansen, Philip","rank":6,"rolecode":"pau"},{"affno":"","first":"Janus D.","key":"nybingpau","last":"Nybing","name":"Nybing, Janus D.","rank":7,"rolecode":"pau"},{"affno":"1","first":"S. Peter","key":"magnussonpau","last":"Magnusson","locid":"6f430caa-ac01-4dfe-9a62-e3a49afba21a","name":"Magnusson, S. Peter","rank":8,"rolecode":"pau"},{"affno":"1","first":"Michael","key":"kjærpau","last":"Kjær","locid":"7937b8ab-7820-4d25-982f-1d2f58b033a3","name":"Kjaer, Michael","name_org":"Kjær, Michael","rank":9,"rolecode":"pau"}],"pmid":["33719579"],"pub":{"doi":"10.1177/0363546521991903","issn":["03635465","15523365"],"issn_org":["03635465"],"issue":"7","journal":"American Journal of Sports Medicine","pages":"1711-1720","status":"p","title":"American Journal of Sports Medicine","volume":"49"},"review":"Peer Reviewed","scoID":["2-s2.0-85102514062"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-fa1a01c2-4635-41cc-a7a6-be0f4e579cb2"],"src":["KU University of Copenhagen"],"title":"No Additive Clinical or Physiological Effects of Short-term Anti-inflammatory Treatment to Physical Rehabilitation in the Early Phase of Human Achilles Tendinopathy : A Randomized Controlled Trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-542699","year":"2021","yearsub":"2021"}
{"abstract":"We present the discovery of a highly irradiated and moderately inflated ultrahot Jupiter, TOI-1431b/MASCARA-5 b (HD 201033b), first detected by NASA's Transiting Exoplanet Survey Satellite mission (TESS) and the Multi-site All-Sky Camera (MASCARA). The signal was established to be of planetary origin through radial velocity measurements obtained using SONG, SOPHIE, FIES, NRES, and EXPRES, which show a reflex motion of K = 294.1 1.1 m s-1. A joint analysis of the TESS and ground-based photometry and radial velocity measurements reveals that TOI-1431b has a mass of M p = 3.12 0.18 M J (990 60 M ⊕), an inflated radius of R p = 1.49 0.05 R J (16.7 0.6 R ⊕), and an orbital period of P = 2.650237 0.000003 days. Analysis of the spectral energy distribution of the host star reveals that the planet orbits a bright (V = 8.049 mag) and young ({0.29-0.19+0.32 Gyr) Am type star with R eff=7690-250+400 K, resulting in a highly irradiated planet with an incident flux of F =7.24-0.64+0.68 × 109 erg s-1 cm-2 (5300-470+500 S) and an equilibrium temperature of T eq = 2370 70 K. TESS photometry also reveals a secondary eclipse with a depth of 127-5+4 ppm as well as the full phase curve of the planet's thermal emission in the red-optical. This has allowed us to measure the dayside and nightside temperature of its atmosphere as T day = 3004 64 K and T night = 2583 63 K, the second hottest measured nightside temperature. The planet's low day/night temperature contrast (∼420 K) suggests very efficient heat transport between the dayside and nightside hemispheres. Given the host star brightness and estimated secondary eclipse depth of ∼1000 ppm in the K band, the secondary eclipse is potentially detectable at near-IR wavelengths with ground-based facilities, and the planet is ideal for intensive atmospheric characterization through transmission and emission spectroscopy from space missions such as the James Webb Space Telescope and the Atmospheric Remote-sensing Infrared Exoplanet Large-survey.","author_count":79,"contributors":["Addison, Brett C.","Knudstrup, Emil","Wong, Ian","Hebrard, Guillaume","Dorval, Patrick","Snellen, Ignas","Albrecht, Simon","Bello-Arufe, Aaron","Almenara, Jose-Manuel","Boisse, Isabelle","Bonfils, Xavier","Dalal, Shweta","Demangeon, Olivier D. S.","Hoyer, Sergio","Kiefer, Flavien","Santos, N. C.","Nowak, Grzegorz","Luque, Rafael","Stangret, Monika","Palle, Enric","Tronsgaard, Rene","Antoci, Victoria","Buchhave, Lars A.","Gunther, Maximilian N.","Daylan, Tansu","Murgas, Felipe","Parviainen, Hannu","Esparza-Borges, Emma","Crouzet, Nicolas","Narita, Norio","Fukui, Akihiko","Kawauchi, Kiyoe","Watanabe, Noriharu","Rabus, Markus","Johnson, Marshall C.","Otten, Gilles P. P. L.","Talens, Geert Jan","Cabot, Samuel H. C.","Fischer, Debra A.","Grundahl, F.","Andersen, Mads Fredslund","Jessen-Hansen, J.","Palle, Pere","Shporer, Avi","Ciardi, David R.","Clark, Jake T.","Wittenmyer, Robert A.","Wright, Duncan J.","Horner, Jonathan","Collins, Karen A.","Jensen, Eric L. N.","Kielkopf, John F.","Schwarz, Richard P.","Srdoc, Gregor","Yilmaz, Mesut","Senavci, Hakan Volkan","Diamond, Brendan","Harbeck, Daniel","Komacek, Thaddeus D.","Smith, Jeffrey C.","Wang, Songhu","Eastman, Jason D.","Stassun, Keivan G.","Latham, David W.","Vanderspek, Roland","Seager, Sara","Winn, Joshua N.","Jenkins, Jon M.","Louie, Dana R.","Bouma, Luke G.","Twicken, Joseph D.","Levine, Alan M.","McLean, Brian"],"cuid":["S02-097.02-025558"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"51-200 contributors","class":"merged","cluster_size":2,"continent":["America, North","Asia, East","Asia, Middle East","Europe, EU","OECD","Oceania"],"corresponding_author":["Addison, Brett C."],"country":["Australia","Canada","France","Japan","Netherlands","Portugal","Spain","Taiwan","Turkey","United States"],"glorg":["Academia Sinica Taiwan","Aix-Marseille Université","All Global Affiliations","Ames Research Center","Ankara University","California Institu