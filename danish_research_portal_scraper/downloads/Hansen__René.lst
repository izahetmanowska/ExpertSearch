null,"country":"dk","first":"Elly Møller","key":"hansenpau","last":"Hansen","locid":"5c906936-1ec6-4847-8322-c5643841a25a","name":"Hansen, Elly Møller","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jørgen E","key":"olesenpau","last":"Olesen","locid":"d3bcf85c-a32d-4169-8f78-b2bf7fe78102","name":"Olesen, Jørgen E","orcid":"0000-0002-6639-1273","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-af545a9c-3eb5-46c4-a879-d991d5fcc1df"],"src":["AU Aarhus University"],"title":"Fastsættelse af NDVI-krav i pilotprojektet om biomasse","type":"Memorandum/Exposition","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-229337","year":"2019","yearsub":"2019"}
{"abstract":"Fully sequenced IncI1 plasmids obtained from CTX-M-1-producing Escherichia coli of human and animal origin were compared. Twelve E. coli isolates sharing identical ESBL genes and plasmid multilocus STs sequenced on Illumina and MinION platforms were obtained from the Danish antimicrobial resistance surveillance programme, DANMAP. After de novo assembly, the sequences of plasmids harbouring blaCTX-M-1 were manually curated and ORFs annotated. Within-group comparisons were performed separately for the IncI1 ST3 plasmid type and the IncI1 ST7 plasmid type. The IncI1 ST3 plasmid group was obtained from 10 E. coli isolates (2 from patients with bloodstream infections, 6 from food and 2 from animals). The IncI1 ST7 plasmids originated from E. coli isolates obtained from a patient with bloodstream infection and from a pig. Sequences of IncI1 ST3 and IncI1 ST7 plasmids harbouring blaCTX-M-1 with determined origin were retrieved from GenBank and used for comparison within the respective group. The 10 IncI1 ST3 blaCTX-M-1 plasmids were highly similar in structure and organization with only minor plasmid rearrangements and differences in the variable region. The IncI1 ST7 blaCTX-M-1 plasmids also showed high similarity in structure and organization. The high level of similarity was also observed when including plasmids from E. coli of animal origin from Australia, Switzerland, the Netherlands and France. This study shows broad spread of a very successful CTX-M-1-producing IncI1 type plasmid among E. coli of both human and animal origin.","author_count":11,"contributors":["Valcek, Adam","Roer, Louise","Overballe-Petersen, Søren","Hansen, Frank","Bortolaia, Valeria","Leekitcharoenphon, Pimlapas","Korsgaard, Helle Bisgaard","Seyfarth, Anne Mette","Hendriksen, Rene S.","Hasman, Henrik","Hammerum, Anette Marie"],"cuid":["S01-000.00-331857"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"corresponding_author":["Hammerum, Anette Marie"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-GV-SSI","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"inci000000000001 st000000000003 and inci000000000001 st000000000007 plasmids from ctx m 000000000001 producing escherichia coli obtained from patients with bloodstream infections are closely related to plasmids from e coli of animal origin","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85070118443","version":"Other Version"},"id":"S01-000.00-331857","identifier":[{"id":"31089683","type":"pmid"},{"id":"85070118443","type":"scopus"}],"ids":["dtu-5bd68fa6-c078-4643-b391-dfce2a169b2e"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-26EA6C16636EE5B1B4E330F55E5AC3AE"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","country":"dk","key":"ssi statens serum institut","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-SSI","l3nn":"SSI Statens Serum Institut","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SSI Statens Serum Institut","namevar":["Statens Serum Institut"],"nora_code":"DI-GV-SSI","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Food Institute","Technical University of Denmark, National Food Institute, Research Group for Genomic Epidemiology"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Adam","key":"valcekpau","last":"Valcek","name":"Valcek, Adam","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Louise","key":"roerpau","last":"Roer","name":"Roer, Louise","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren","key":"overballepetersenpau","last":"Overballe-Petersen","name":"Overballe-Petersen, Søren","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Frank","key":"hansenpau","last":"Hansen","name":"Hansen, Frank","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Valeria","key":"bortolaiapau","last":"Bortolaia","locid":"8b1160d2-649f-4663-8512-010214af6ab4","name":"Bortolaia, Valeria","orcid":"0000-0001-6559-7344","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Pimlapas","key":"leekitcharoenphonpau","last":"Leekitcharoenphon","locid":"432b3315-1807-49ee-a83f-d4ea2a9219d1","name":"Leekitcharoenphon, Pimlapas","orcid":"0000-0002-5674-0142","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Helle Bisgaard","key":"korsgaardpau","last":"Korsgaard","locid":"bd6d48e5-2d2c-4c29-ba33-467ef364767f","name":"Korsgaard, Helle Bisgaard","orcid":"0000-0001-9257-9889","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Anne Mette","key":"seyfarthpau","last":"Seyfarth","locid":"1e478afd-afd1-4256-abb2-3aed9340635b","name":"Seyfarth, Anne Mette","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Rene S.","key":"hendriksenpau","last":"Hendriksen","locid":"d0695f89-50d1-4626-b4b2-0ea8773ccb3c","name":"Hendriksen, Rene S.","orcid":"0000-0003-2934-8214","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik","key":"hasmanpau","last":"Hasman","name":"Hasman, Henrik","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anette Marie","key":"hammerumpau","last":"Hammerum","name":"Hammerum, Anette Marie","rank":11,"rolecode":"pau"}],"pmid":["31089683"],"pub":{"doi":"10.1093/jac/dkz199","issn":["03057453","14602091"],"issn_org":["03057453"],"issue":"8","journal":"Journal of Antimicrobial Chemotherapy","pages":"2171-2175","publisher":"Oxford University Press","status":"p","title":"Journal of Antimicrobial Chemotherapy","volume":"74"},"review":"Peer Reviewed","scoID":["2-s2.0-85070118443"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-5bd68fa6-c078-4643-b391-dfce2a169b2e"],"src":["DTU Technical University of Denmark"],"title":"IncI1 ST3 and IncI1 ST7 plasmids from CTX-M-1-producing Escherichia coli obtained from patients with bloodstream infections are closely related to plasmids from E. coli of animal origin","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-331857","year":"2019","yearsub":"2019"}
{"abstract":"During its lifecycle, the generalist Ixodes ricinus takes up three blood meals from a wide selection of vertebrate hosts, some of which are reservoirs for multiple vector-associated pathogens. Since I. ricinus also readily bites humans, pets, and livestock, these hosts are at risk of becoming infected with more than one tick-borne pathogen. Multiple tick-borne infections are a public health concern, since they may increase diversity and duration of symptoms and complicate differential diagnosis and therapy. We used an existing Fluidigm real-time PCR chip to identify the minimum risk of exposure to infected/co-infected ticks in Denmark. We screened 509 nymphs and 504 adult female I. ricinus ticks for 17 different vector-associated pathogenic agents. The questing ticks were collected by flagging during the same season in two consecutive years in Grib forest in the capital region of Copenhagen. Overall, 19.1% of the nymphs and 52.2% of the adult female ticks harbored at least one zoonotic pathogen. The main agents were Borrelia spp., Anaplasma phagocytophilum and Rickettsia helvetica, while Candidatus Neoehrlichia mikurensis and Babesia venatorum both were present in less than 1% of the ticks. In 3.5% of the nymphs and 12.3% of adults we found more than one tick-borne pathogen. Of these, 15% were potentially triple or quadruple infections. Whereas mixed infections with Borrelia were equally distributed among both life stages, the adult ticks hosted 84.5% of the co-infections with different species of tick-borne pathogens, chiefly involving Borrelia species in combination with either R. helvetica or A. phagocytophilum. Statistical analyses indicated non-random co-occurrence of Borrelia spielmanii/Borrelia garinii in both life stages and B. garinii/Borrelia afzelii and B. garinii/Borrelia valaisiana in the nymphs. Although the overall prevalence of ticks hosting more than one infection only constituted 7.9% at the particular site investigated in this study, our results still underline that co-infections should be considered in diagnosis and treatment of tick-borne diseases in northern Europe.","author_count":5,"contributors":["Schou, Kirstine Klitgaard","Kjær, Lene Jung","Isbrand, Anastasia","Hansen, Mette Frimodt","Bødker, Rene"],"cuid":["S01-000.00-371656"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Schou, Kirstine Klitgaard"],"keyword":["Borrelia","Co infections","Ixodes ricinus","Rickettsia"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"multiple infections in questing nymphs and adult female ixodes ricinus ticks collected in a recreational forest in denmark","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.ttbdis.2019.05.016","version":"Published Version"},"id":"S01-000.00-371656","identifier":[{"id":"85066460368","type":"scopus"},{"id":"31176664","type":"pmid"}],"ids":["dtu-e05a6e9a-d111-47cd-bda4-2b12442558d5"],"keyword":["Anaplasma","Borrelia","Co-infections","Ixodes ricinus","Mixed infections","Rickettsia"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-B8D8B0E39EF7B60A2025A183D178456F"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.ttbdis.2019.05.016","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/186301093/1_s2.0_S1877959X18302309_main.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Veterinary Institute"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Kirstine","key":"klitgaardschoupau","last":"Klitgaard Schou","locid":"2436a58e-fb11-41dd-9799-5e91010a3b8e","name":"Schou, Kirstine Klitgaard","name_org":"Klitgaard Schou, Kirstine","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lene Jung","key":"kjærpau","last":"Kjær","locid":"f090e293-1ca3-4f1d-89e6-36ea0990c4b3","name":"Kjær, Lene Jung","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anastasia","key":"isbrandpau","last":"Isbrand","locid":"3e45bb93-7bc6-4e4b-a744-699ceea76bfe","name":"Isbrand, Anastasia","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mette Frimodt","key":"hansenpau","last":"Hansen","locid":"d9760e43-a896-495b-a589-991c240ef36b","name":"Hansen, Mette Frimodt","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rene","key":"bødkerpau","last":"Bødker","locid":"8fbaa7cf-7196-4a15-91d1-0cfac6858305","name":"Bødker, Rene","rank":5,"rolecode":"pau"}],"pmid":["31176664"],"pub":{"doi":"10.1016/j.ttbdis.2019.05.016","issn":["1877959X","18779603"],"issn_org":["1877959X"],"issue":"5","journal":"Ticks and Tick-borne Diseases","pages":"1060-1065","publisher":"Elsevier","status":"p","title":"Ticks and Tick-borne Diseases","volume":"10"},"review":"Peer Reviewed","scoID":["2-s2.0-85066460368"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-e05a6e9a-d111-47cd-bda4-2b12442558d5"],"src":["DTU Technical University of Denmark"],"title":"Multiple infections in questing nymphs and adult female Ixodes ricinus ticks collected in a recreational forest in Denmark","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-371656","year":"2019","yearsub":"2019"}
