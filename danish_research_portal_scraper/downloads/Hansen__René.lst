t":"Stilling","locid":"bb005d3f-27c9-4157-8101-db5059373d32","name":"Stilling, Maiken","orcid":"0000-0002-4530-2075","rank":10,"rolecode":"pau"}],"pmid":["40123034"],"pub":{"doi":"10.1007/s00280-025-04768-7","issn":["03445704","09439404"],"issn_org":["03445704"],"issue":"1","journal":"Cancer Chemotherapy and Pharmacology","paperid":"47","publisher":"Springer Science and Business Media Deutschland GmbH","status":"p","title":"Cancer Chemotherapy and Pharmacology","volume":"95"},"review":"Peer Reviewed","scoID":["2-s2.0-105000776211"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-2679ef86-157c-46f8-8227-60962ccae9ab"],"src":["AU Aarhus University"],"title":"Effect of repeated bolus and continuous doxorubicin administration on bone and soft tissue concentrations– a randomized study evaluated in a tumour-free porcine model","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-806051","year":"2025","yearsub":"2025"}
{"abstract":"Det er maj og blevet tid til Folkemødet for Klubområdet – et tilbagevendende initiativ stablet på benene af gode folk fra VIA University College, BUPL, Ungdomsringen, Klubberne i Viborg og Ung i Aarhus. PETERgogikum er for tredje gang til stede – det er jo næsten efterhånden en tradition. Vi er her for at tage temperaturen på Klubområdet og ungefeltet derude i det ganske danske. Derfor får du, som lytter i denne omgang et sammenklippet potpourri at det bedste fra Folkemødet for Klubområdet, når det løber af stablen her fra VIA University College i hjertet af Aarhus. Det bliver både helt enormt fagligt, menings- og holdningsbåret og ikke mindst politisk hist og her.","author_count":14,"contributors":["Frostholm, Peter Hornbæk","Harbo, Lotte Junker","Jensen, Louise Krobak","Gravesen, David Thore","Meier, Joachim","Hedegaard, René","Nguyen-Quy, Anne","Aebeloe, Anette Kirkegaard","Dybdahl Bilenberg, Niels Christian","Begtrup-Hansen, Jonas","Westesen, Simon Høgholm","Berg Andersen, Theresa","Borchhorst Mejnertz, Eva","Elbæk Hansen, Mette"],"cuid":["S01-000.00-822107"],"filters":{"added":"2025-08","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Læring pædagogik og undervisning","klub","klubpædagog","klubpædagogik"],"level":"pop","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U","DI-UC"],"level3":{"OT":["Viborg Kommune"],"U":["DI-U-ALL","DI-U-AU"],"UC":["DI-UC-ALL","DI-UC-VIA"]},"level3all":["DI-U-AU","DI-UC-VIA"]},"review":"und","rtype":["clu"],"sorti":"petergogikum afsnit 000000000046 folkemødet for klubområdet 000000000003 000000002025","src":["via"],"src-code":["DI-UC-VIA"],"type":"dnt","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://petergogikum.buzzsprout.com/1386490/episodes/17115962-petergogikum-46-folkemodet-for-klubomradet-3-2025","version":"Other Version"},"id":"S01-000.00-822107","ids":["via-925a05d9-3ba9-403a-bc8e-8b530e