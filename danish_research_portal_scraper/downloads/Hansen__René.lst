{"author_count":5,"contributors":["R. S. Hansen, Bjarne","Paskevicius, Mark","Li, Haiwen","Akiba, Etsua","Jensen, Torben René"],"cuid":["S01-000.00-175783"],"event":{"end":"2016-01-13","place":"Aarhus, dk","start":"2016-01-13","title":"iNANO annual meeting 2016","year":"2016"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Asia, East","OECD"],"country":["Japan"],"glorg":["All Global Affiliations","Kyushu University"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"nr","rtype":["clu"],"sorti":"metal closo boranes as solid state electrolytes","src":["au"],"src-code":["DI-U-AU"],"type":"dco","type-grp":["all","pub"]},"id":"S01-000.00-175783","ids":["au-5174817d-fba4-4198-befd-63a7f2c62897"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-FAAC684C450CAB5C19F7BCECC950174C"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Chemistry","Aarhus University, Natural Sciences, Department of Chemistry, Department of Chemistry - Centre for Energy Materials (CEM)","Aarhus University, Natural Sciences, Department of Chemistry, Department of Chemistry - Centre for Materials Crystallography (CMC)"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"jp","key":"kyushu university","loc":["Japan","Asia, East","OECD"],"name":"Kyushu University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Bjarne","key":"rshansenpau","last":"R. S. Hansen","locid":"95e2932e-526e-4795-b38a-7ab221f891ae","name":"R. S. Hansen, Bjarne","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"fi