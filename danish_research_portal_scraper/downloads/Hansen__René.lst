,"rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"René dePont","key":"christensenpau","last":"Christensen","locid":"eaf57073-fb2d-437f-8536-46617b662ea5","name":"Christensen, René dePont","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Rikke Fredslund","key":"andersenpau","last":"Andersen","name":"Andersen, Rikke Fredslund","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Karen-Lise Garm","key":"spindlerpau","last":"Spindler","locid":"44550b92-1db9-45d9-97ed-e0dfc3d89e50","name":"Spindler, Karen-Lise Garm","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Flemming Brandt","key":"sørensenpau","last":"Sørensen","locid":"db856600-d106-4b0a-83f1-d7245f5249bd","name":"Sørensen, Flemming Brandt","orcid":"0000-0002-5446-1035","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Anders","key":"johnssonpau","last":"Johnsson","name":"Johnsson, Anders","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders","key":"jakobsenpau","last":"Jakobsen","locid":"28d7a13b-6526-4741-810c-41555dfc2cb7","name":"Jakobsen, Anders","rank":7,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-73eda7b6-64ad-4b0c-a744-20cba810e0b9"],"src":["AU Aarhus University"],"title":"The relationship between microRNA-126 and maintenance therapy with bevacizumab after chemotherapy plus bevacizumab as first-line treatment for patients with metastatic colorectal cancer: Results of the phase III Nordic ACT trial NCT00598156 translational study","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-195505","year":"2012","yearsub":"2012"}
{"abstract":"INTRODUCTION: The objective of this study is to report the impact of computed tomography (CT) screening on the use of Video-Assisted Thoracic Surgery (VATS) in a randomized screening trial. METHODS: The Danish Lung Cancer Screening Trial is a randomized clinically controlled trial of 4104 smokers and previous smokers who were randomized to either screening with five annual low-dose CT scans or no screening in Copenhagen from 2004 to 2006. The major end point is the effect of CT screening on lung cancer mortality and treatment options. All diagnostic and treatment interventions in both groups were monitored prospectively until 1 to 3 years after the last screening round. RESULTS: By February 1, 2011 68 cases of lung cancer were detected in the screening group. Furthermore, seven patients with a benign nodule underwent surgical treatment because of suspicion of malignancy (12%). Fifty-one of the 68 lung cancer patients were eligible for surgical treatment. Eight patients had open thoracotomy. Of the operations for lung cancer, 84% were performed by VATS in the CT-screened arm, significantly higher than the control arm (p < 0.05). Thirty-six patients had a VATS lobectomy. One patient had a VATS segmentectomy, and four patients had a VATS wedge resection. The seven benign nodules were all treated with VATS. CONCLUSIONS: CT screening seems to facilitate the use of VATS in the treatment of lung cancer with an 84% rate in our data. Furthermore, all benign nodules could be removed by VATS. In our view, a basic requirement for a surgical institution to be involved in lung cancer CT screening is a dedicated VATS program.","author_count":4,"contributors":["Petersen, René Horsleben","Hansen, Henrik Jessen","Dirksen, Asger","Pedersen, Jesper Holst"],"cuid":["S01-000.00-481543"],"filters":{"added":"2022-04","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Aged","Belgium epidemiology","Early Detection of Cancer methods","Female","Follow Up Studies","Humans","Lung Neoplasms diagnosis","Male","Middle Aged","Morbidity trends","Pneumonectomy methods","Prospective Studies","Reproducibility of Results","Survival Rate trends","Thoracic Surgery Video Assisted methods","Time Factors","Tomography X Ray Computed"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"lung cancer screening and video assisted thoracic surgery","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-481543","identifier":[{"id":"22588154","type":"pmid"}],"ids":["ku-93747a50-792a-4e84-97ca-b45faf9b881e"],"keyword":["Aged","Belgium/epidemiology","Early Detection of Cancer/methods","Female","Follow-Up Studies","Humans","Lung Neoplasms/diagnosis","Male","Middle Aged","Morbidity/trends","Pneumonectomy/methods","Prospective Studies","Reproducibility of Results","Survival Rate/trends","Thoracic Surgery, Video-Assisted/methods","Time Factors","Tomography, X-Ray Computed"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-4-6-FEF6A9FBEFF4049AD3A89767D1CEC57B"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"René Horsleben","key":"petersenpau","last":"Petersen","locid":"aa18983b-8811-4b3a-a7bd-b439cc52d3e3","name":"Petersen, René Horsleben","orcid":"0000-0002-3586-1869","rank":1,"rolecode":"pau"},{"affno":"1","first":"Henrik Jessen","key":"hansenpau","last":"Hansen","locid":"b356d6b1-e9df-41d2-8001-e4fa6cc000e3","name":"Hansen, Henrik Jessen","rank":2,"rolecode":"pau"},{"affno":"1","first":"Asger","key":"dirksenpau","last":"Dirksen","locid":"2556e6b6-124a-4507-b427-0636d8cfdcbf","name":"Dirksen, Asger","rank":3,"rolecode":"pau"},{"affno":"1","first":"Jesper Holst","key":"pedersenpau","last":"Pedersen","locid":"7d2d605f-0dc9-4fcc-b897-27a85f5faae2","name":"Pedersen, Jesper Holst","rank":4,"rolecode":"pau"}],"pmid":["22588154"],"pub":{"doi":"10.1097/jto.0b013e31824fe942","issn":["15560864","15561380"],"issn_org":["15560864"],"issue":"6","journal":"Journal of Thoracic Oncology","pages":"1026-31","status":"p","title":"Journal of Thoracic Oncology","volume":"7"},"review":"Peer Reviewed","scoID":["2-s2.0-84861316780"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-93747a50-792a-4e84-97ca-b45faf9b881e"],"src":["KU University of Copenhagen"],"title":"Lung cancer screening and video-assisted thoracic surgery","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-481543","year":"2012","yearsub":"2012"}
{"abstract":"BACKGROUND: As we move toward competency-based education in medicine, we have lagged in developing competency-based evaluation methods. In the era of minimally invasive surgery, there is a need for a reliable and valid tool dedicated to measure competence in video-assisted thoracoscopic surgery. The purpose of this study is to create such an assessment tool, and to explore its reliability and validity. METHODS: An expert group of physicians created an assessment tool consisting of 10 items rated on a five-point rating scale. The following factors were included: economy and confidence of movement, respect for tissue, precision of operative technique, creation and placement of ports, localization of pathologic tissue, use of staplers, retrieval of tissue in bag and placement of chest tube. Fifty consecutive thoracoscopic wedge resections were recorded and assessed blindly and independently by two experts using the tool. RESULTS: Four residents, four fellows and five consultants performed 1-10 (median 4) operations each. The fellows performed significantly better than the residents (P = 0.03; effect size, ES = 0.72). The consultants scored 11% higher than the fellows, but this difference was not significant (P = 0.10, ES = 0.64). The inter-rater reliability was acceptable (Cronbach's alpha 0.71). CONCLUSIONS: This tool for assessing performance in thoracoscopy is reliable and valid. It can provide unbiased feedback to trainees, and can be used to evaluate new teaching curricula, i.e. simulation-based training. Furthermore, it has potential to aid in certification of new thoracic surgeons.","author_count":5,"contributors":["Konge, Lars","Lehnert, Per","Hansen, Henrik Jessen","Petersen, René Horsleben","Ringsted, Charlotte"],"cuid":["S01-000.00-671159"],"filters":{"added":"2022-04","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"reliable and valid assessment of performance in thoracoscopy","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-671159","identifier":[{"id":"22179467","type":"pmid"},{"id":"84863990146","type":"scopus"}],"ids":["ku-ecd2a101-b6ca-412d-a602-b51c08dbcdb5"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-BDB93F17C1B26F18AC577E4DB70FE6B8"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Lars","key":"kongepau","last":"Konge","locid":"e1c287e3-4cd2-43d2-887d-f2f77fd5daf8","name":"Konge, Lars","orcid":"0000-0002-1258-5822","rank":1,"rolecode":"pau"},{"affno":"1","first":"Per","key":"lehnertpau","last":"Lehnert","locid":"5e943ff4-2a6e-4efb-9cf7-0330dbb01734","name":"Lehnert, Per","rank":2,"rolecode":"pau"},{"affno":"1","first":"Henrik Jessen","key":"hansenpau","last":"Hansen","locid":"b356d6b1-e9df-41d2-8001-e4fa6cc000e3","name":"Hansen, Henrik Jessen","rank":3,"rolecode":"pau"},{"affno":"1","first":"René Horsleben","key":"petersenpau","last":"Petersen","locid":"aa18983b-8811-4b3a-a7bd-b439cc52d3e3","name":"Petersen, René Horsleben","orcid":"0000-0002-3586-1869","rank":4,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Charlotte","key":"ringstedpau","last":"Ringsted","locid":"aad0b8e6-2821-409d-9ed2-33b6ffded4d2","name":"Ringsted, Charlotte","rank":5,"rolecode":"pau"}],"pmid":["22179467"],"pub":{"doi":"10.1007/s00464-011-2081-7","issn":["09302794","14322218"],"issn_org":["09302794"],"issue":"6","journal":"Surgical Endoscopy","pages":"1624-1628","status":"p","title":"Surgical Endoscopy","volume":"26"},"review":"Peer Reviewed","scoID":["2-s2.0-84863990146"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-ecd2a101-b6ca-412d-a602-b51c08dbcdb5"],"src":["KU University of Copenhagen"],"title":"Reliable and valid assessment of performance in thoracoscopy","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-671159","year":"2012","yearsub":"2012"}
{"abstract":"Abstract Background. Patients with upper gastrointestinal cancers have a poor prognosis and only few treatment options. The epidermal growth factor receptor (EGFR) and vascular endothelial growth factor (VEGF) are valid targets in many solid tumours, and they have synergistic effects in preclinical studies. Methods. In this multi-center phase II trial patients with chemoresistant, metastatic upper gastrointestinal cancer were treated with erlotinib (150 mg daily) and bevacizumab (10 mg/kg every two weeks). Primary endpoint was overall response rate (ORR). Secondary endpoints were progression free survival (PFS), overall survival (OS), toxicity and biomarker correlates. Plasma samples were analysed for EGFR and angiogenesis related markers using quantitative immunoassays. Results. One hundred and two patients were enrolled in the trial between June 2006 and October 2007. The most common toxicities were skin reaction, diarrhoea, and fatigue. ORR was 6%, median PFS was 2.2 months, and OS 4.3 months. Low concentration of urokinase plasminogen activator receptor (uPAR) domain I was correlated to longer PFS and OS. Discussion. The combination of erlotinib and bevacizumab is well tolerated, however, with low clinical activity in patients with chemoresistant UGI cancer. Some patients do benefit from the therapy, and uPAR forms are potential biomarkers in these patients.","author_count":12,"contributors":["Rohrberg, Kristoffer S","Olesen, René K","Pfeiffer, Per","Ladekarl, Morten","Pappot, Helle","Christensen, Ib J","Høyer-Hansen, Gunilla","Sørensen, Morten","Skov, Birgit G","Buysschaert, Ian","Carmeliet, Peter","Lassen, Ulrik"],"cuid":["S02-080.42-672164"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"keyword":["Adult","Aged","Angiogenesis Inhibitors","Antibodies Monoclonal Humanized","Carcinoma","Disease Free Survival","Dose Response Relationship Drug","Drug Resistance Neoplasm","Drug Therapy Combination","Female","Follow Up Studies","Gastrointestinal Neoplasms","Humans","Male","Middle Aged","Prospective Studies","Quinazolines","Receptor Epidermal Growth Factor","Survival Analysis","Treatment Outcome"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-CDR","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"phase ii trial of erlotinib and bevacizumab in patients with advanced upper gastrointestinal cancers","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3109/0284186X.2011.619568","version":"Other Version"},"id":"S02-080.42-672164","identifier":[{"id":"84856462139","type":"scopus"},{"id":"22017239","type":"pmid"}],"ids":["au-d95e5cfa-6327-4deb-a468-c10ace279a8b","sdu-5307d1be-e559-4bae-8042-9a86a49b1193"],"keyword":["Adult","Aged","Angiogenesis Inhibitors","Antibodies, Monoclonal, Humanized","Carcinoma","Disease-Free Survival","Dose-Response Relationship, Drug","Drug Resistance, Neoplasm","Drug Therapy, Combination","Female","Follow-Up Studies","Gastrointestinal Neoplasms","Humans","Male","Middle Aged","Prospective Studies","Quinazolines","Receptor, Epidermal Growth Factor","Survival Analysis","Treatment Outcome"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-3-6-986E25C2A9679D2DEDDB4B3FDDD76E4D"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.3109/0284186X.2011.619568","version":"Other Version"}],"org":[{"affno":"1","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1}