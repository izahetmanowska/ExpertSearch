e"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Søren Valgreen","key":"knudsenpau","last":"Knudsen","locid":"d59094b5-44a6-4398-9acf-f3f530e0504b","name":"Knudsen, Søren Valgreen","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"René Børge Korsgaard","key":"brundpau","last":"Brund","locid":"b2374431-6b1e-4efe-9345-01733ef94596","name":"Brund, René Børge Korsgaard","orcid":"0000-0002-7246-4811","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Signe Gitte","key":"hansenpau","last":"Hansen","locid":"57addda8-4f72-4b3e-b625-6455e9b65bdb","name":"Hansen, Signe Gitte","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Signe","key":"heuckendorffpau","last":"Heuckendorff","locid":"75999b0a-df86-4d41-8117-c07534083755","name":"Heuckendorff, Signe","orcid":"0000-0002-4074-064X","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kirsten","key":"fonagerpau","last":"Fonager","locid":"3afdf3d3-bf7d-451e-ac62-2d7a846eb9e8","name":"Fonager, Kirsten","orcid":"0000-0001-9641-992X","rank":5,"rolecode":"pau"}],"pub":{"pages":"18","publisher":"Aalborg Universitetshospital","status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-425dc070-2a97-4fbe-b1c9-e2b55f037e34"],"src":["AAU Aalborg University"],"title":"Mønstre i rehabiliteringsteamenes anbefalinger af indsatser indenfor social- og sundhedsforvaltningerne : En undersøgelse af rehabiliteringsteamsmøder i Region Nordjylland i perioden 01.09.2024 til 31.12.2024","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-804906","year":"2025","yearsub":"2025"}
{"abstract":"Objectives Approximately half of individuals with suspected PMR initiate prednisolone before rheumatological evaluation, but it is unknown if prednisolone reduces the ability to diagnose PMR. This study evaluated the clinical assessment of a PMR diagnosis before and after prednisolone initiation and after short-term prednisolone discontinuation. Methods Data from a prospective cohort of treatment-naïve patients with PMR (n = 66) and non-PMR (n = 27) were used to create case report forms (CRFs). All patients were assessed at baseline and patients with PMR were reassessed after 8 weeks of prednisolone treatment (n = 57) and after short-term prednisolone discontinuation at week 10 (n = 48). In total, 198 CRFs were created containing patient demographics, current symptoms, physical examination and blood test results. Six rheumatologists, blinded to diagnosis, prednisolone treatment and visit timing, assessed each CRF, rating the probability of a PMR diagnosis from 0 to 10 and classifying them as PMR or non-PMR. Results At baseline, CRF assessors effectively distinguished PMR from non-PMR, demonstrating median probabilities of PMR of 7.8 and 2.8, respectively, and a sensitivity/specificity of 85.9%/82.7% for the PMR diagnosis. After prednisolone initiation, the median probability of PMR was 1.0 and sensitivity was 3.5%, followed by a median probability of PMR of 2.3 and a sensitivity of 25% after short-term prednisolone discontinuation. Conclusion This study shows that clinically assessing PMR becomes challenging after prednisolone initiation, and that short-term prednisolone discontinuation does not improve clinical assessment to pre-treatment levels. Consequently, the study supports recommendations of deferring prednisolone initiation until after specialist evaluation in individuals suspected of having PMR.","author_count":15,"contributors":["Våben, Christoffer","Nielsen, Andreas Wiggers","Nielsen, Marc K","Moll, Line Thorndal","Mørk, Christoffer","Dalgaard, Emil Barner","Rasmussen, Tue Kruse","Østgård, René Drage","Hansen, Ib Tønder","Nielsen, Berit Dalsgaard","Sørensen, Christian Møbjerg","Blegvad-Nissen, Jesper","Kjær, Søren Geill","Hauge, Ellen Margrethe","Keller, Kresten Krarup"],"cuid":["S01-000.00-807061"],"filters":{"added":"2025-06","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Diagnostic accuracy","Glucocorticoids","Polymyalgia rheumatica","Prednisolone"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"the effect of prednisolone initiation and short term discontinuation on the clinical assessment of polymyalgia rheumatica","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/105012482538","version":"Other Version"},"id":"S01-000.00-807061","identifier":[{"id":"105012482538","type":"scopus"},{"id":"40131424","type":"pmid"}],"ids":["au-981cf1b1-8fe3-4a18-936b-740fb4fd02e9"],"keyword":["diagnostic accuracy","diagnostic taper","glucocorticoids","polymyalgia rheumatica","prednisolone"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-60F894F202579D199090F3B9DE24988D"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Section for Rheumatology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Christoffer S","key":"våbenchristofferpau","last":"Våben","locid":"d0eeb26e-f0e5-4c8c-ae7c-b0d846bc03ec","name":"Våben, Christoffer","name_org":"Våben, Christoffer S","orcid":"0000-0003-2704-4081","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Andreas W","key":"nielsenandreaswiggerspau","last":"Nielsen","locid":"dc3ce48a-c47a-46ef-beac-360aec95aacc","name":"Nielsen, Andreas Wiggers","name_org":"Nielsen, Andreas W","orcid":"0000-0001-8180-6871","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Marc K","key":"nielsenmarckpau","last":"Nielsen","name":"Nielsen, Marc K","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Line T","key":"molllinethorndalpau","last":"Moll","locid":"1ef45a8e-4b1c-4271-9c6e-5ea93e0f8ac8","name":"Moll, Line Thorndal","name_org":"Moll, Line T","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Christoffer","key":"mørkchristofferpau","last":"Mørk","name":"Mørk, Christoffer","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Emil B","key":"dalgaardemilbarnerpau","last":"Dalgaard","locid":"d433cfa3-ddda-4ee0-b783-82d95b62029f","name":"Dalgaard, Emil Barner","name_org":"Dalgaard, Emil B","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Tue K","key":"rasmussentuekrusepau","last":"Rasmussen","locid":"0b1018e8-2ad6-4f8d-8413-5c10a8db586d","name":"Rasmussen, Tue Kruse","name_org":"Rasmussen, Tue K","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"René D","key":"østgårdrenédragepau","last":"Østgård","locid":"55d0f083-27c9-4d6b-95d4-92ec4d785e87","name":"Østgård, René Drage","name_org":"Østgård, René D","orcid":"0000-0001-6124-8972","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ib T","key":"hansenibtønderpau","last":"Hansen","locid":"81d0b2cc-7b1e-46a1-a233-5ac2e412721b","name":"Hansen, Ib Tønder","name_org":"Hansen, Ib T","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Berit D","key":"nielsenberitdalsgaardpau","last":"Nielsen","locid":"d039e19c-8101-423b-a89a-414f0f95f793","name":"Nielsen, Berit Dalsgaard","name_org":"Nielsen, Berit D","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christian M","key":"sørensenchristianmøbjergpau","last":"Sørensen","locid":"5b9d2f3e-1fac-4e1c-a295-2d5bddba8362","name":"Sørensen, Christian Møbjerg","name_org":"Sørensen, Christian M","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper","key":"blegvadnissenjesperpau","last":"Blegvad-Nissen","locid":"8b75f4b8-75e5-48e7-bf81-e65a57a2160d","name":"Blegvad-Nissen, Jesper","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren G","key":"kjærsørengeillpau","last":"Kjær","locid":"5076f30c-8b9f-4765-b494-a263c944e96b","name":"Kjær, Søren Geill","name_org":"Kjær, Søren G","rank":13,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ellen-Margrethe","key":"haugeellenmargrethepau","last":"Hauge","locid":"6e0e979f-48d6-40bd-89ec-a2502b1cefd4","name":"Hauge, Ellen Margrethe","name_org":"Hauge, Ellen-Margrethe","rank":14,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kresten K","key":"kellerkrestenkraruppau","last":"Keller","locid":"a13c7405-9555-41cf-9bc3-311bb925bb9c","name":"Keller, Kresten Krarup","name_org":"Keller, Kresten K","orcid":"0000-0003-2474-3389","rank":15,"rolecode":"pau"}],"pmid":["40131424"],"pub":{"doi":"10.1093/rheumatology/keaf170","issn":["14620324","14620332"],"issn_org":["14620324"],"issue":"8","journal":"Rheumatology","pages":"4756-4760","publisher":"Oxford University Press","status":"p","title":"Rheumatology","volume":"64"},"review":"Peer Reviewed","scoID":["2-s2.0-105012482538"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-981cf1b1-8fe3-4a18-936b-740fb4fd02e9"],"src":["AU Aarhus University"],"title":"The effect of prednisolone initiation and short-term discontinuation on the clinical assessment of polymyalgia rheumatica","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-807061","year":"2025","yearsub":"2025"}
{"abstract":"Drug depot technologies that release chemotherapeutics locally in cancerous tissues present an intriguing strategy. This study aimed to assess the feasibility, delivery capacity, and therapeutic efficacy of a thin needle injectable doxorubicin-loaded carbohydrate-ester-based (CarboCell) depot technology. CarboCell was evaluated in three experimental setups: (A) In non-tumorous mice, release kinetics were evaluated 24 h and 48 h after a subcutaneous depot injection. (B) In mice with syngeneic CT 26 colorectal cancer, efficacy was evaluated based on tumour growth control and survival. This was done by two intratumoral injections of 50 µl CarboCell containing 1 mg/mL or 4 mg/mL doxorubicin at 5 days intervals. (C) In ten female pigs, local and distant release of doxorubicin from a 2 mg/mL doxorubicin CarboCell (2 or 4 mL) injected into tibial metaphysis was evaluated using microdialysis in nine tissue compartments. (A) Subcutaneous CarboCell depots demonstrated a sustained release of doxorubicin with (mean ± SEM) 36 ± 13% and 48 ± 20% of the loaded dose being released at 24 h and 48 h time points, respectively. (B) Intratumoral injection effectively controlled tumour growth and markedly extended the median survival time compared to the control group. (C) Doxorubicin peak drug concentrations in the metaphysis were > 0.3 µg/mL and could be quantified at least 10 mm from the application site. The systemic spill-over was minimal. Doxorubicin-loaded CarboCell proved easily administrable, maintaining antitumoral activity, good metaphyseal distribution and providing much higher local concentrations in metaphyseal bone providing high local concentrations in metaphyseal bone with a good distribution and limited systemic exposure.","author_count":11,"contributors":["Jørgensen, Andrea René","Hansen, Anders Elias","Henriksen, Jonas Rosager","Stilling, Maiken","Rasmussen, Hans Christian","Lilleøre, Johanne Gade","Hvistendahl, Magnus A.","Slater, Josefine","Serrano-Chávez, Elizabeth","Hansen, Jakob","Bue, Mats"],"cuid":["S01-000.00-807608"],"filters":{"added":"2025-06","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"corresponding_author":["Jørgensen, Andrea René"],"keyword":["Cancer treatment","CarboCell","Doxorubicin","Microdialysis"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-DTU"]},"level3all":["DI-U-AU","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"injectable sustained local release doxorubicin depot technology a promising adjuvant to systemic treatment","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s13346-025-01841-9","version":"Published Version"},"id":"S01-000.00-807608","identifier":[{"id":"105001865059","type":"scopus"},{"id":"40178754","type":"pmid"}],"ids":["au-d73d93b8-6b99-4815-a583-00b844ad4f06"],"keyword":["Cancer treatment","CarboCell","Doxorubicin","Drug depot technology","Local concentration","Microdialysis"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-533DE688D43FEFD95D5637007CCCC2AE"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s13346-025-01841-9","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Orthopaedic surgery"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark (DTU)"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Andrea René","key":"jørgensenandrearenépau","last":"Jørgensen","locid":"105e5e1d-0600-4cd5-94cb-68291474afab","name":"Jørgensen, Andrea René","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Anders Elias","key":"hansenanderseliaspau","last":"Hansen","name":"Hansen, Anders Elias","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jonas Rosager","key":"henriksenjonasrosagerpau","last":"Henriksen","name":"Henriksen, Jonas Rosager","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Maiken","key":"stillingmaikenpau","last":"Stilling","locid":"bb005d3f-27c9-4157-8101-db5059373d32","name":"Stilling, Maiken","orcid":"0000-0002-4530-2075","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Hans Christian","key":"rasmussenhanschristianpau","last":"Rasmussen","locid":"93f47ffc-0862-4e2e-9efc-e048c9fd95d1","name":"Rasmussen, Hans Christian","orcid":"0000-0001-9101-9302","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Johanne Gade","key":"lilleørejohannegadepau","last":"Lilleøre","locid":"d7d315be-9bd0-4b10-b99f-7f6b7bd6d07b","name":"Lilleøre, Johanne Gade","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Magnus Andreas","key":"hvistendahlmagnusapau","last":"Hvistendahl","locid":"e0fdf994-206b-4961-bc05-9c84d1ff3557","name":"Hvistendahl, Magnus A.","name_org":"Hvistendahl, Magnus Andreas","orcid":"0000-0002-4086-0238","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Josefine","key":"slaterjosefinepau","last":"Slater","locid":"bcfa9867-e753-418a-9656-4fff369aec59","name":"Slater, Josefine","orcid":"0000-0002-3589-2278","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Elizabeth","key":"serranochávezelizabethpau","last":"Serrano-Chávez","name":"Serrano-Chávez, Elizabeth","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jakob","key":"hansenjakobpau","last":"Hansen","locid":"57b7eb60-d040-4937-a05a-d34bc65de5bf","name":"Hansen, Jakob","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mats","key":"buematspau","last":"Bue","locid":"2a35a61c-3bf9-4bf7-9569-73178247b08c","name":"Bue, Mats","orcid":"0000-0001-7215-8323","rank":11,"rolecode":"pau"}],"pmid":["40178754"],"pub":{"doi":"10.1007/s13346-025-01841-9","issn":["2190393X","21903948"],"issn_org":["2190393X"],"journal":"Drug Delivery and Translational Research","publisher":"Springer Publishing Company","status":"e","title":"Drug Delivery and Translational Research"},"review":"Peer Reviewed","scoID":["2-s2.0-105001865059"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["E-Published (ahead of print)"]},"sid":["au-d73d93b8-6b99-4815-a583-00b844ad4f06"],"src":["AU Aarhus University"],"title":"Injectable sustained local release doxorubicin depot technology– a promising adjuvant to systemic treatment?","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-807608","year":"2025","yearsub":"2025"}
{"abstract":"Pectus excavatum or funnel chest is the most prevalent chest wall deformity. Surgical correction is the treatment of choice which is predominantly performed on children and adolescents, often with significant surgical complication rates. While correction is primarily pursued for aesthetic reasons, proponents argue that correction of the inward deformity alleviates compression of the heart, consequently enhancing cardiorespiratory fitness. This systematic review and meta-analysis aims to assess whether surgical correction of pectus excavatum yields improvements in cardiorespiratory fitness, quantified as maximal oxygen uptake (O2max). A search of PubMed, Scopus, and Embase was conducted for studies evaluating the changes in O2max/O2peak following surgical correction of pectus excavatum. Systematic qualitative evaluation of the included studies utilized the Risk of Bias in Non-randomized Studies of Interventions tool. Quantitative assessment of intervention effect sizes was executed using a random-effects model, supplemented by meta-regression. Among the 1,598 screened studies, 15 non-randomized studies were included. Systematic qualitative assessment revealed serious or critical risk of bias in all included studies. Quantitative assessment identified systematic errors in outcome measurements in several studies. Following surgical correction, we found no statistically or clinically significant improvement in O2max/O2peak. Our findings highlight a lack of high-quality studies in this field of research. Our analysis could not demonstrate any significant physiological impacts resulting from PE correction. Future studies should adopt randomized controlled trial designs and implement rigorous testing protocols for O2max/O2peak. The outcome of this study should prompt a restrained and cautious approach in communicating enhancement of physiological effects arising from surgical correction of pectus excavatum.","author_count":11,"contributors":["Media, Ara Shwan","Juhl-Olesen, Peter","Christensen, Thomas Decker","Katballe, Niels","Vad, Henrik","Petersen, René Horsleben","Wiggers, Henrik","Hansen, Stefan Nygaard","Farup, Jean","Overgaard, Kristian","de Paoli, Frank Vincenzo"],"cuid":["S01-000.00-826299"],"filters":{"added":"2025-10","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["CPET","Cardiopulmonary fitness","Exercise Tolerance","Pectus excavatum","Physical capacity"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-HO-CAP","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"cardiorespiratory fitness after correction of pectus excavatum a systematic review with meta analysis","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1038/s41598-025-08038-7","version":"Published Version"},"id":"S01-000.00-826299","identifier":[{"id":"40683912","type":"pmid"},{"id":"105011265024","type":"scopus"},{"id":"PMC12276308","type":"pmcid"}],"ids":["au-c2075a24-729a-4fd6-b9ef-1b122a25d8c5"],"keyword":["CPET","Cardiopulmonary fitness","Exercise tolerance","Omax","Pectus excavatum","Physical capacity"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-6A6417A15D5FC739365302FCCF7CB25F"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1038/s41598-025-08038-7","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Biomedicine","Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Cardiothoracic and Vascular Surgery"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["National Hospital of Denmark"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Ara S","key":"mediapau","last":"Media","locid":"f7a65c7f-57d2-44dd-a108-f926e1911764","name":"Media, Ara Shwan","name_org":"Media, Ara S","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Peter","key":"juhlolesenpau","last":"Juhl-Olesen","name":"Juhl-Olesen, Peter","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Thomas Decker","key":"christensenpau","last":"Christensen","locid":"2009faa4-0e51-4b44-8dbf-680fe78b786b","name":"Christensen, Thomas Decker","orcid":"0000-0001-6509-8510","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Niels","key":"katballepau","last":"Katballe","locid":"a249e809-7e7b-4a5a-aac9-c08624d9c041","name":"Katballe, Niels","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Henrik","key":"vadpau","last":"Vad","name":"Vad, Henrik","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"René Horsleben","key":"petersenpau","last":"Petersen","name":"Petersen, René Horsleben","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik","key":"wiggerspau","last":"Wiggers","locid":"aef6a13e-8c07-474c-a4f6-bc35236a6eda","name":"Wiggers, Henrik","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Stefan Nygaard","key":"hansenpau","last":"Hansen","locid":"a38407c0-cdaa-4842-9da9-13376cd9c6d5","name":"Hansen, Stefan Nygaard","orcid":"0000-0002-0877-556X","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jean","key":"faruppau","last":"Farup","locid":"aefa43d5-0af4-4832-b044-cf0222187d42","name":"Farup, Jean","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kristian","key":"overgaardpau","last":"Overgaard","locid":"6dba2a9a-30ed-4a17-8f1d-3919c5bcb5db","name":"Overgaard, Kristian","orcid":"0000-0002-3204-509X","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Frank Vincenzo","key":"depaolipau","last":"de Paoli","locid":"6da516f9-f223-4aae-a586-8d7b4f1d976e","name":"de Paoli, Frank Vincenzo","orcid":"0000-0002-2174-2295","rank":11,"rolecode":"pau"}],"pmid":["40683912"],"pub":{"doi":"10.1038/s41598-025-08038-7","issn":["20452322"],"issue":"1","journal":"Scientific Reports","pages":"1-20","paperid":"26282","publisher":"Nature Publishing Group","status":"p","title":"Scientific Reports","volume":"15"},"review":"Peer Reviewed","scoID":["2-s2.0-105011265024"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities"],"PST":["Published"]},"sid":["au-c2075a24-729a-4fd6-b9ef-1b122a25d8c5"],"src":["AU Aarhus University"],"title":"Cardiorespiratory fitness after correction of pectus excavatum : a systematic review with meta-analysis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-826299","year":"2025","yearsub":"2025"}
{"abstract":"Simulation-based analysis estimating both the energy requirement of the entire carbon capture process and the purity of the recovered CO 2 is scarce. The purity of the captured CO 2 is crucial as it must meet a specification before transportation, preventing phase change and damage to the transportation system. This study conducted 31,104 simulations of a monoethanolamine carbon capture plant treating measured flue gas from an existing cement production plant. After capture, the CO 2 is treated through a deoxygenation unit followed by a compression train to fulfill specific quality specifications. Based on the sensitivity analysis, the energy consumption of the post-treatment process decreased with increased purity downstream. Despite this, the total energy consumption was not affected. Moreover, after the two-step purification the CO 2 stream was able to successfully fulfill the specification for NO x, O 2, NH 3, Ar, CO, SO 2. However, failing to meet the H 2O concentration requirements of both considered specifications and the N 2 concentration specified for ship transport. Thus, increasing the post-treatment energy cost or standard adjustments is required for future applications.","author_count":5,"contributors":["Simonsen, Kenneth René","Hansen, Dennis Severin","Nielsen, Rudi P.","Andreasen, Anders","Pedersen, Simon"],"cuid":["S01-000.00-795344"],"filters":{"added":"2025-04","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["CO2 capture","CO2 impurities","Process simulation"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"energy requirement analysis on carbon capture plants satisfying impurity specifications","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/770306768/Energy_Requirement_Analysis_on_Carbon_Capture_Plants_Satisfying_Impurity_Specifications.pdf","version":"Published Version"},"id":"S01-000.00-795344","identifier":[{"id":"86000537882","type":"scopus"}],"ids":["aau-f3e499ee-b740-40a4-a835-5cc4d2a646de"],"keyword":["CO2 capture","CO2 impurities","Energy requirment analysis","Process simulation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-DB30D2D58DD82DC38A36487706062089"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/770306768/Energy_Requirement_Analysis_on_Carbon_Capture_Plants_Satisfying_Impurity_Specifications.pdf","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1016/j.jclepro.2025.145129","version":"Authors Final Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, AAU Energy","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Esbjerg Energy Section"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Kenneth René","key":"simonsenpau","last":"Simonsen","locid":"18f6d31b-80a4-4605-bd2a-548205326536","name":"Simonsen, Kenneth René","orcid":"0000-0001-6542-2085","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Dennis Severin","key":"hansenpau","last":"Hansen","locid":"3ef0fc7c-ea22-40da-ab21-a2a2e8e46c65","name":"Hansen, Dennis Severin","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rudi P.","key":"nielsenpau","last":"Nielsen","locid":"dc11a998-930b-4e73-90b9-6f2af8291e4d","name":"Nielsen, Rudi P.","orcid":"0000-0001-8820-1445","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Anders","key":"andreasenpau","last":"Andreasen","name":"Andreasen, Anders","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Simon","key":"pedersenpau","last":"Pedersen","locid":"b784e2a8-004f-4040-80ad-fc67161cee9f","name":"Pedersen, Simon","orcid":"0000-0002-2928-7813","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.jclepro.2025.145129","issn":["09596526"],"journal":"Journal of Cleaner Production","paperid":"145129","publisher":"Elsevier","status":"p","title":"Journal of Cleaner Production","volume":"499"},"review":"Peer Reviewed","scoID":["2-s2.0-86000537882"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-f3e499ee-b740-40a4-a835-5cc4d2a646de"],"src":["AAU Aalborg University"],"title":"Energy Requirement Analysis on Carbon Capture Plants Satisfying Impurity Specifications","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-795344","year":"2025","yearsub":"2025"}
{"abstract":"Purpose: The aim of this study was to evaluate plasma and bone- and soft-tissue concentrations of doxorubicin following two administrations of either bolus or continuous infusion administered at a three-week interval. The achievement of adequate concentration at target sites is believed to be positively correlated to effect, and it has been suggested that concentrations are affected by the number of administrations. Methods: Eighteen female pigs were included in the study and randomized into two groups of nine receiving either a bolus or continuous infusion. The animals received a dosage of 2 mg/kg on day 1 and on day 22. From day 1 to 10, doxorubicin concentrations, as well as kidney and liver function, were monitored with plasma samples (total concentrations). On day 22, doxorubicin was measured in plasma samples (total concentration) and microdialysates (unbound concentrations) from subcutaneous tissue, muscle, synovial fluid of the knee joint, cancellous bone, and intravenously. Results: On day 22, the pharmacokinetic profiles were comparable between the two groups except for plasma AUC0 − 12 h, which was higher after continuous infusion, and intravenous Cmax, which was higher after bolus infusion. Bone- and soft tissue concentrations were below 0.10 µg/mL. Except for mean plasma (total) concentration at the 6 h timepoint on day 1 and 22 in the continuous group, which was higher after the first administration (p = 0.037), no differences in plasma concentrations were found between the two administrations. Conclusion: Low mean tissue doxorubicin concentrations and similar pharmacokinetic profiles were found between the bolus and continuous infusion groups. Thus, similar anti-neoplastic efficacy is to be expected with both administration types.","author_count":10,"contributors":["Jørgensen, Andrea René","Bue, Mats","Hanberg, Pelle","Harlev, Christina","Petersen, Elisabeth Krogsgaard","Rasmussen, Hans Christian","Hansen, Jakob","Baad-Hansen, Thomas","Safwat, Akmal","Stilling, Maiken"],"cuid":["S01-000.00-806051"],"filters":{"added":"2025-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Jørgensen, Andrea René"],"keyword":["Doxorubicin","Microdialysis","Tissue concentration"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"effect of repeated bolus and continuous doxorubicin administration on bone and soft tissue concentrations a randomized study evaluated in a tumour free porcine model","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s00280-025-04768-7","version":"Published Version"},"id":"S01-000.00-806051","identifier":[{"id":"40123034","type":"pmid"},{"id":"105000776211","type":"scopus"},{"id":"PMC11930866","type":"pmcid"}],"ids":["au-2679ef86-157c-46f8-8227-60962ccae9ab"],"keyword":["Doxorubicin","Microdialysis","Repeated administration","Tissue concentration"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-6BA16867C16C9207F924C04CD0FAC97F"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s00280-025-04768-7","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Orthopaedic surgery"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Andrea René","key":"jørgensenandrearenépau","last":"Jørgensen","locid":"105e5e1d-0600-4cd5-94cb-68291474afab","name"