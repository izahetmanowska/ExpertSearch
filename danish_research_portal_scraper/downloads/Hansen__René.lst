rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mark","key":"paskeviciusmarkpau","last":"Paskevicius","locid":"e26eea7d-e55a-4989-80de-dfafd2146511","name":"Paskevicius, Mark","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Torben René","key":"jensentorbenrenépau","last":"Jensen","locid":"e0750478-df89-45bf-aa48-b6a86de93fa0","name":"Jensen, Torben René","orcid":"0000-0002-4278-3221","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-8c364929-51b5-4d20-b9c9-001251991707"],"src":["AU Aarhus University"],"title":"Formation of MBH<sub>4</sub> from M<sub>2</sub>B<sub>10</sub>H<sub>10</sub>-MH composites (M = Li and Na)","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-209319","year":"2016","yearsub":"2016"}
{"abstract":"We have analysed high-resolution spectra of 328 stars and derived Mg abundances using non-local thermodynamic equilibrium (NLTE) spectral line formation calculations and plane-parallel model stellar atmospheres derived from the mean stratification of 3D hydrodynamical surface convection simulations of late-type stars. The distribution of Mg abundances in the Galactic disk is analysed from the perspective of Galactic chemical evolution. We find that the trend of [Mg/Fe] shows a mild decline with decreasing metallicity below [Fe/H]~-1.2 and that a significant fraction of low-metallicity stars have [Mg/Fe] ratios close to solar even at [Fe/H] ~ -2. This is at variance with results of classical abundance analyses based on local thermodynamic equilibrium (LTE) and 1D model stellar atmospheres, which argue for a constant elevated [Mg/Fe] in metal-poor stars of the Galactic thick disk and halo.","author_count":8,"contributors":["Bergemann, Maria","Collet, Remo","Schönrich, Ralph","Andrae, Rene","Kovalev, Mikhail","Ruchti, Gregory","Hansen, Camilla J.","Magic, Zazralt"],"cuid":["S01-000.00-247339"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Astrophysics Solar and Stellar Astrophysics"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"und","rtype":["clu"],"sorti":"non local thermodynamic equilibrium stellar spectroscopy with 000000000001d and 000000000003d models ii chemical properties of the galactic metal poor disk and the halo","src":["au"],"src-code":["DI-U-AU"],"type":"dpr","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://adsabs.harvard.edu/abs/2016arXiv161207363B","version":"Other Version"},"id":"S01-000.00-247339","ids":["au-ce8200d8-6d13-4771-bcb5-e569646c9e4f"],"keyword":["Astrophysics - Solar and Stellar Astrophysics"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-6EA17E3A4F3673B4F172317287C81ACA"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Physics and Astronomy"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Maria","key":"bergemannpau","last":"Bergemann","name":"Bergemann, Maria","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Remo","key":"colletpau","last":"Collet","locid":"32d7d42f-26b8-4a76-80ae-db025ab3aae4","name":"Collet, Remo","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Ralph","key":"schönrichpau","last":"Schönrich","name":"Schönrich, Ralph","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Rene","key":"andraepau","last":"Andrae","name":"Andrae, Rene","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Mikhail","key":"kovalevpau","last":"Kovalev","name":"Kovalev, Mikhail","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Gregory","key":"ruchtipau","last":"Ruchti","name":"Ruchti, Gregory","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Camilla J.","key":"hansenpau","last":"Hansen","name":"Hansen, Camilla J.","rank":7,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Zazralt","key":"magicpau","last":"Magic","name":"Magic, Zazralt","rank":8,"rolecode":"pau"}],"pub":{"publisher":"arXiv","publisher_org":"ArXiv","status":"p"},"review":"Undetermined","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-ce8200d8-6d13-4771-bcb5-e569646c9e4f"],"src":["AU Aarhus University"],"title":"Non-local thermodynamic equilibrium stellar spectroscopy with 1D and 3D models - II. Chemical properties of the Galactic metal-poor disk and the halo","type":"Preprint","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-247339","year":"2016","yearsub":"2016"}
