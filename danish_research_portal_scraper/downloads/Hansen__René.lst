University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Plant and Environmental Sciences, Microbial Ecology and Biotechnology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Diana R.","key":"alvespau","last":"Alves","name":"Alves, Diana R.","rank":1,"rolecode":"pau"},{"affno":"","first":"Jonathan","key":"nzakizwanayopau","last":"Nzakizwanayo","name":"Nzakizwanayo, Jonathan","rank":2,"rolecode":"pau"},{"affno":"","first":"Cinzia","key":"dedipau","last":"Dedi","name":"Dedi, Cinzia","rank":3,"rolecode":"pau"},{"affno":"","first":"Chara","key":"olympioupau","last":"Olympiou","name":"Olympiou, Chara","rank":4,"rolecode":"pau"},{"affno":"","first":"Aurélie","key":"haninpau","last":"Hanin","name":"Hanin, Aurélie","rank":5,"rolecode":"pau"},{"affno":"1","first":"Witold","key":"kotpau","last":"Kot","locid":"89d6e892-d0a3-40c3-a7f5-7052029eeb1b","name":"Kot, Witold","orcid":"0000-0002-0188-4587","rank":6,"rolecode":"pau"},{"affno":"1","first":"Lars","key":"hansenpau","last":"Hansen","locid":"2e041f09-bf9d-434a-b82a-d6e2763bb262","name":"Hansen, Lars H.","name_org":"Hansen, Lars","orcid":"0000-0003-0027-1524","rank":7,"rolecode":"pau"},{"affno":"1","first":"Rene","key":"lametschpau","last":"Lametsch","locid":"70bd350a-6869-4a4a-b9bc-56a756376784","name":"Lametsch, Rene","orcid":"0000-0002-4189-806X","rank":8,"rolecode":"pau"},{"affno":"","first":"Cormac G. M.","key":"gahanpau","last":"Gahan","name":"Gahan, Cormac G. M.","rank":9,"rolecode":"pau"},{"affno":"","first":"Pascale","key":"schellenbergerpau","last":"Schellenberger","name":"Schellenberger, Pascale","rank":10,"rolecode":"pau"},{"affno":"","first":"Lesley A.","key":"ogilviepau","last":"Ogilvie","name":"Ogilvie, Lesley A.","rank":11,"rolecode":"pau"},{"affno":"","first":"Brian V.","key":"jonespau","last":"Jones","name":"Jones, Brian V.","rank":12,"rolecode":"pau"}],"pmid":["31447809"],"pub":{"doi":"10.3389/fmicb.2019.01783","issn":["1664302X"],"journal":"Frontiers in Microbiology","pages":"1-14","paperid":"1783","status":"p","title":"Frontiers in Microbiology","volume":"10"},"review":"Peer Reviewed","scoID":["2-s2.0-85086998177"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-74557645-4fee-480f-bd62-5fb9fd4ce901"],"src":["KU University of Copenhagen"],"title":"Genomic and Ecogenomic Characterization of <i>Proteus mirabilis</i> Bacteriophages","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-462994","year":"2019","yearsub":"2019"}
{"abstract":"There is a need for biomarkers to improve the clinical benefit from systemic treatment of colorectal cancer. We designed a prospective, clinical study where patients receiving regorafenib as last-line treatment had sequential blood samples drawn. Effect and toxicity was monitored. The primary clinical endpoint was progression free survival (PFS). Cell-free circulating tumor (ct) DNA was measured as either the fraction with Neuropeptide Y (NPY) methylated DNA or KRAS/NRAS/BRAF mutated ctDNA. One hundred patients were included from three Danish centers. Among 95 patients who received regorafenib for at least two weeks, the median PFS was 2.1 months (95% confidence interval (CI) 1.8-3.3) and the median overall survival (OS) was 5.2 months (95% CI 4.3-6.5). Grade 3-4 toxicities were reported 51 times, most frequently hypertension, hand-food syndrome, and skin rash. In the biomarker population of 91 patients, 49 could be monitored using mutated DNA and 90 using methylated DNA. There was a strong correlation between mutated and methylated DNA. The median survival for patients with a level of methylated ctDNA above the median was 4.3 months compared to 7.6 months with ctDNA below the median, p < 0.001. The median time from increasing methylated ctDNA to disease progression was 1.64 months (range 0.46-8.38 months). In conclusion, NPY methylated ctDNA was a universal liquid biopsy marker in colorectal cancer patients treated with regorafenib. High baseline levels correlated with short survival and changes during treatment may predict early effect and later progression. We suggest plasma NPY methylation analysis as an easy and universally applicable method for longitudinal monitoring of ctDNA in metastatic colorectal cancer patients.","author_count":11,"contributors":["Jensen, Lars Henrik","Olesen, René","Petersen, Lone Noergaard","Boysen, Anders Kindberg","Andersen, Rikke Fredslund","Lindebjerg, Jan","Nottelmann, Lise","Brenner Thomsen, Caroline Emilie","Havelund, Birgitte Mayland","Jakobsen, Anders","Hansen, Torben Frøstrup"],"cuid":["S01-000.00-579231"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-SDR","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"npy gene methylation as a universal longitudinal plasma marker for evaluating the clinical benefit from last line treatment with regorafenib in metastatic colorectal cancer","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/cancers11111649","version":"Published Version"},"id":"S01-000.00-579231","identifier":[{"id":"31731482","type":"pmid"},{"id":"PMC6896074","type":"pmcid"}],"ids":["sdu-150fed39-e05d-4bb1-bfc5-3e90df737e35"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-FD52FEA9FA653977689E5202EED8EE06"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/156479905/NPY_Gene_Methylation_as_a_Universal.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/cancers11111649","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Lillebælt Hospital, Research Unit of Oncology (Vejle)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Danish Colorectal Cancer Center South"],"nora_code":"DI-HO-SDR","used":1},{"affno":"3","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1},{"affno":"4","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Lars Henrik","key":"jensenpau","last":"Jensen","locid":"5b427622-91b5-4f6e-b14f-2945da9dad8c","name":"Jensen, Lars Henrik","orcid":"0000-0002-0020-1537","rank":1,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"René","key":"olesenpau","last":"Olesen","name":"Olesen, René","rank":2,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Lone Noergaard","key":"petersenpau","last":"Petersen","name":"Petersen, Lone Noergaard","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Anders Kindberg","key":"boysenpau","last":"Boysen","name":"Boysen, Anders Kindberg","rank":4,"rolecode":"pau"},{"affno":"2 1","corresponding":null,"first":"Rikke Fredslund","key":"andersenpau","last":"Andersen","locid":"e82f9773-7004-444a-8176-b55f6342dd3d","name":"Andersen, Rikke Fredslund","orcid":"0000-0002-5894-7745","rank":5,"rolecode":"pau"},{"affno":"2 1","corresponding":null,"first":"Jan","key":"lindebjergpau","last":"Lindebjerg","locid":"5de10dbb-de45-4c38-8ed2-35bd614d5459","name":"Lindebjerg, Jan","orcid":"0000-0002-2055-4241","rank":6,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Lise","key":"nottelmannpau","last":"Nottelmann","locid":"f0c1f163-d014-4875-80d5-cefc162a4405","name":"Nottelmann, Lise","rank":7,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Caroline Emilie Brenner","key":"thomsenpau","last":"Thomsen","locid":"c143b96b-a005-42c3-a4cd-025abf3db0db","name":"Brenner Thomsen, Caroline Emilie","name_org":"Thomsen, Caroline Emilie Brenner","rank":8,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Birgitte Mayland","key":"havelundpau","last":"Havelund","locid":"0bf72073-d22b-4e35-b01a-533270939409","name":"Havelund, Birgitte Mayland","rank":9,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Anders","key":"jakobsenpau","last":"Jakobsen","locid":"6c772581-e8fe-48bc-a932-1d1c5122c25a","name":"Jakobsen, Anders","orcid":"0000-0003-2110-2615","rank":10,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Torben Frøstrup","key":"hansenpau","last":"Hansen","locid":"72d28643-c440-4bbd-ad2b-eef0903a9438","name":"Hansen, Torben Frøstrup","orcid":"0000-0001-7476-671X","rank":11,"rolecode":"pau"}],"pmid":["31731482"],"pub":{"doi":"10.3390/cancers11111649","issn":["20726694"],"issue":"11","journal":"Cancers","paperid":"1649","publisher":"MDPI","status":"p","title":"Cancers","volume":"11"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-150fed39-e05d-4bb1-bfc5-3e90df737e35"],"src":["SDU University of Southern Denmark"],"title":"NPY Gene Methylation as a Universal, Longitudinal Plasma Marker for Evaluating the Clinical Benefit from Last-Line Treatment with Regorafenib in Metastatic Colorectal Cancer","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-579231","year":"2019","yearsub":"2019"}
{"abstract":"The tfd genes mediating degradation of the herbicide 2,4-dichlorophenoxyacetic acid (2,4-D) differ in composition and organization in bacterial isolates from different geographical origin and are carried by different types of mobile genetic elements (MGE). It is not known whether such global diversity of 2,4-D-catabolic MGE and their tfd gene cargo is reflected in the diversity at field scale. The genomic context of the 2,4-D catabolic genes of 2,4-D-degrading isolates from two rice fields with a 2,4-D application history, located in two distant provinces of the Vietnam Mekong delta, was compared. All isolates were β-proteobacteria, were unique for each rice field and carried the catabolic genes on MGE and especially plasmids. Most plasmids were IncP-1β plasmids and carried tfd clusters highly similar to those of the IncP-1β plasmid pJP4, typified by two chlorophenol catabolic gene modules (tfd-I and tfd-II). IncP-1β plasmids from the same field showed small deletions and/or insertions in accessory metabolic genes. One plasmid belonged to an unclassified plasmid group and carries a copy of both tfdA and tfd-II identical to those in the IncP-1β plasmids. Our results indicate intra-field evolution and inter-field exchange of 2,4-D-catabolic IncP-1β plasmids as well as the exchange of tfd genes between different plasmids within a confined local environment.","author_count":10,"contributors":["Thi Phi Oanh Nguyen, no-firstname","Hansen, Martin Asser","Hansen, Lars Hestbjerg","Horemans, Benjamin","Sorensen, Soren Johannes","De Mot, Rene","Springael, Dirk"],"cuid":["S02-094.25-023537"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Asia, South","Europe, EU","OECD"],"corresponding_author":["Springael, Dirk"],"country":["Belgium","Vietnam"],"glorg":["All Global Affiliations","Can Tho University","KU Leuven"],"keyword":["Adaptation","Bacteria","Metabolism","Organization","Soil","Transposon","nucleotide sequence"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"intra and inter field diversity of 000000000002 000000000004 dichlorophenoxyacetic acid degradative plasmids and their i tfd i catabolic genes in rice fields of the mekong delta in vietnam","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85056611261","version":"Other Version"},"id":"S02-094.25-023537","identifier":[{"id":"30380047","type":"pmid"},{"id":"85056611261","type":"scopus"},{"id":"000453664200013","type":"wos"}],"ids":["au-9514d911-9c8e-47fb-92a5-4e7f5be9af3f","ku-55f07db5-db24-4fcb-bd53-962a41481967"],"keyword":["2,4-D biodegradation","ADAPTATION","BACTERIA","CHLOROPHENOL","HOST-RANGE PLASMIDS","METABOLISM","NUCLEOTIDE-SEQUENCE","ORGANIZATION","PJP4","SOIL","TRANSPOSON","catabolic plasmid","local evolution","plasmid diversity","tfd genes"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-6FCF27E07282A3ED0DF772EBB180CBEC"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","country":"vn","key":"can tho university","loc":["Vietnam","Asia, South"],"name":"Can Tho University","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Biology, Microbiology"],"nora_code":"DI-U-KU","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Environmental Science, Department of Environmental Science - Environmental Microbiology"],"nora_code":"DI-U-AU","used":1},{"affno":"4","country":"be","key":"ku leuven","loc":["Belgium","Europe, EU","OECD"],"name":"KU Leuven","used":1}],"person":[{"affno":"1","corresponding":null,"first":"no-firstname","key":"thiphioanhnguyennofirstnamepau","last":"Thi Phi Oanh Nguyen","name":"Thi Phi Oanh Nguyen, no-firstname","rank":1,"rolecode":"pau"},{"affno":"","first":"Thi Phi Oanh","key":"nguyenthiphioanhpau","last":"Nguyen","name":"Nguyen, Thi Phi Oanh","rank":1,"rolecode":"pau"},{"affno":"2","first":"Martin Asser","key":"hansenmartinasserpau","last":"Hansen","locid":"550a9763-39ed-4b8d-ae50-2a9170b215dc","name":"Hansen, Martin Asser","rank":2,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Lars Hestbjerg","key":"hansenlarshestbjergpau","last":"Hansen","locid":"f1afca6a-5a5a-4fec-b0f5-cc7bbb39a088","name":"Hansen, Lars Hestbjerg","rank":3,"rolecode":"pau"},{"affno":"2","first":"Lars Hestbjerg","key":"hansenlarshpau","last":"Hansen","locid":"2e041f09-bf9d-434a-b82a-d6e2763bb262","name":"Hansen, Lars H.","name_org":"Hansen, Lars Hestbjerg","orcid":"0000-0003-0027-1524","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Benjamin","key":"horemansbenjaminpau","last":"Horemans","name":"Horemans, Benjamin","rank":4,"rolecode":"pau"},{"affno":"2","first":"Søren Johannes","key":"sørensensørenjohannespau","last":"Sørensen","locid":"1a8a144e-52fd-4508-b364-6e3ea6cfaa8a","name":"Sørensen, Søren Johannes","orcid":"0000-0001-6227-9906","rank":5,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Rene","key":"demotrenepau","last":"De Mot","name":"De Mot, Rene","rank":6,"rolecode":"pau"},{"affno":"","first":"René","key":"demotrenépau","last":"De Mot","name":"De Mot, Re