outhern Denmark"],"title":"The Prognostic Value of Tumor-Infiltrating lymphocytes in Stage II Colon Cancer. A Nationwide Population-Based Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-087.69-028277","year":"2018","yearsub":"2018"}
{"abstract":"I denne artikel er fokus rettet mod at belyse, hvorledes der kan arbejdes med praksisnær skoleudvikling på en skole med et værdigrundlag, der lægger vægt på, at alle medarbejdere er aktører i den forbindelse samt at det sikres, at skolens drift og udvikling er to sider af samme sag. Pædagogisk læringscenter har fungeret som udviklingsenhed og vejledningsfunktion. En særlig fokus er tillige rettet mod at belyse, hvorledes en praksisnær metode kan understøtte denne udvikling. Artiklen udspringer af Gasværksvejens Skoles deltagelse i udviklingsprojektet ”Pædagogisk Læringscenter som strategisk udviklingsenhed og vejledningsfunktion”. Projektet indgår i udviklingspuljen ”Lokal udvikling og etablering af praksisnær viden om den nye folkeskole”, som er financieret af ”Ministeriet for Børn, Undervisning og Ligestilling”.","author_count":5,"contributors":["Christensen, Ole","Risager Hansen, Marianne","Ørum, René","funch, Lisbet","madsen, inge"],"cuid":["S01-000.00-391981"],"filters":{"added":"2023-02","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["PLC","Skoler fag og institutioner","pædagogisk læringscenter"],"level":"pop","oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-UC"],"level3":{"OT":["Gasværksvejens Skole"],"UC":["DI-UC-ALL","DI-UC-KP"]},"level3all":["DI-UC-KP"]},"review":"und","rtype":["clu"],"sorti":"lokal skoleudvikling fra udviklingsprojekt til hverdagspraksis","src":["kp"],"src-code":["DI-UC-KP"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://backend.folkeskolen.dk/~/1/8/praksisnaer-skoleudvikling---final---20170620.docx","version":"Published Version"},"id":"S01-000.00-391981","ids":["kp-d27c4da6-128d-4124-a814-a6b884de3370"],"keyword":["PLC","Skoler, fag og institutioner","pædagogisk læringscenter"],"lang":"Danish","level":"Popular","noi":["Local-1-1-94B3EAB6973E5A0EE14B99845EF30FCA"],"oa_link":[{"access":"oa","type":"rem","url":"https://backend.folkeskolen.dk/~/1/8/praksisnaer-skoleudvikling---final---20170620.docx","version":"Published Version"}],"org":[{"affno":"1","key":"kp university college copenhagen","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-KP","l3nl":"KP","l3nn":"KP University College Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KP University College Copenhagen","namevar":["Københavns Professionshøjskole, Københavns Professionshøjskole, Københavns Professionshøjskole - Campus Carlsberg, København, Videreuddannelsen (ophørt)"],"nora_code":"DI-UC-KP","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Gasværksvejens Skole"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Ole","key":"christensenpau","last":"Christensen","locid":"184c8ca2-6d9c-4e1e-b6d9-ec0685348416","name":"Christensen, Ole","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Marianne","key":"risagerhansenpau","last":"Risager Hansen","name":"Risager Hansen, Marianne","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"René","key":"ørumpau","last":"Ørum","name":"Ørum, René","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lisbet","key":"funchpau","last":"funch","name":"funch, Lisbet","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"inge","key":"madsenpau","last":"madsen","name":"madsen, inge","rank":5,"rolecode":"pau"}],"pub":{"issn":["00155837"],"journal":"Folkeskolen","publisher":"Danmarks Lærerforening","status":"p","title":"Folkeskolen"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Miscellaneous","All University Colleges","DI-ALL","DI-OT","DI-OT-ALL","DI-UC","DI-UC-ALL","KP","Miscellaneous","Other Research","University Colleges"],"PST":["Published"]},"sid"