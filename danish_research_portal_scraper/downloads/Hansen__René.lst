ensørenopau","last":"Petersen","locid":"9ea8da1c-a327-4dc9-9ed9-29a56cfa2f5d","name":"Petersen, Søren O","orcid":"0000-0001-7524-6695","rank":38,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Tenna","key":"riistennapau","last":"Riis","locid":"63e9c033-4056-4f18-8c91-44244963ef37","name":"Riis, Tenna","orcid":"0000-0003-2501-4444","rank":39,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Uffe","key":"jørgensenuffepau","last":"Jørgensen","locid":"efa7e924-c197-4060-8904-110cf0a30837","name":"Jørgensen, Uffe","rank":40,"rolecode":"pau"}],"pub":{"isbn":["9788793998209"],"issn":["22451684"],"issue":"174","pages":"454","place":"Aarhus","publisher":"DCA - Nationalt Center for Fødevarer og Jordbrug","repno":"DCA rapport, No. 174","series":"DCA rapport","status":"p","volume":"174"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-156987a9-11ba-4f43-ab95-47782b0f25fc"],"src":["AU Aarhus University"],"title":"Virkemidler til reduktion af kvælstofbelastningen af vandmiljøet","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-141740","year":"2020","yearsub":"2020"}
{"abstract":"The quest for simple ligands that enable multi-electron metal-ligand redox chemistry is driven by a desire to replace noble metals in catalysis and to discover novel chemical reactivity. The vast majority of simple ligand systems display electrochemical potentials impractical for catalytic cycles, illustrating the importance of creating new strategies towards energetically aligned ligand frontier and transition metal d orbitals. We herein demonstrate the ability to chemically control the redox-activity of the ubiquitous acetylacetonate (acac) ligand. By employing the ligand field of high-spin Cr(ii) as a switch, we were able to chemically tailor the occurrence of metal-ligand redox events via simple coordination or decoordination of the labile auxiliary ligands. The mechanism of ligand field actuation can be viewed as a destabilization of the dz2 orbital relative to the π∗ LUMO of acac, which proffers a generalizable strategy to synthetically engineer redox-activity with seemingly redox-inactive ligands. This journal is","author_count":7,"contributors":["Vinum, Morten Gotthold","Voigt, Laura","Hansen, Steen H.","Bell, Colby","Clark, Kensha Marie","Larsen, René Wugt","Pedersen, Kasper Steen"],"cuid":["S01-000.00-314062"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","OECD"],"corresponding_author":["Pedersen, Kasper Steen"],"country":["United States"],"glorg":["All Global Affiliations","University of Memphis"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"ligand field actuated redox activity of acetylacetonate","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1039/d0sc01836h","version":"Published Version"},"funding_acknowledgement":["Cyclic voltammetry of 1–4 was performed in dichloromethane. These experiments revealed only irreversible processes, which for 2–4, likely result from dynamic exchange of the respective pyridine ligands. This interpretation is supported by UV-vis spectroscopy and 1H-NMR spectroscopy. When pyr-idinic solutions of 3 are titrated with dichloromethane, a drastic decrease in intensity of the charge transfer transitions, which is K.S.P. thanks the VILLUM Foundation for a VILLUM Young Investigator grant (15374), and the Carlsberg Foundation (CF-17-0637), the Brdr. Hartmann's Foundation and the Torkil Holm foundation for research infrastructure grants. Assoc. Prof. T. J. Sørensen, Assoc. Prof. M. Pittelkow, Prof. J. Bendix (University of Copenhagen), Assoc. Prof. J. Overgaard, Dr B. Richter (Aarhus University), and Mr Ph. Charlie Johansen (Technical University of Denmark) are thanked for experimental assistance and helpful discussions."],"id":"S01-000.00-314062","identifier":[{"id":"PMC8163028","type":"pmcid"},{"id":"34094180","type":"pmid"},{"id":"85090160705","type":"scopus"}],"ids":["dtu-1fdb6fe7-edf0-45d1-9171-54216f8ef22d"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-6FB89306971C97631EE1B7D386906EE1"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/220287445/d0sc01836h.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1039/d0sc01836h","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Chemistry"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"us","key":"university of memphis","loc":["United States","America, North","OECD"],"name":"University of Memphis","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Morten Gotthold","key":"vinumpau","last":"Vinum","locid":"0ea042ae-979e-47d4-99a8-e678be99a9e5","name":"Vinum, Morten Gotthold","orcid":"0000-0003-3913-5458","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Laura","key":"voigtpau","last":"Voigt","locid":"d3b1ff0b-57ce-44ad-b081-fb5128d04eaa","name":"Voigt, Laura","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Steen H.","key":"hansenpau","last":"Hansen","name":"Hansen, Steen H.","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Colby","key":"bellpau","last":"Bell","name":"Bell, Colby","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kensha Marie","key":"clarkpau","last":"Clark","name":"Clark, Kensha Marie","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"René Wugt","key":"larsenpau","last":"Larsen","locid":"2da565e0-823b-49be-919a-1a0c8702dcf8","name":"Larsen, René Wugt","orcid":"0000-0003-2983-6795","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kasper Steen","key":"pedersenpau","last":"Pedersen","locid":"380dfdc8-c64b-4a34-9aa2-d86d7f9a1bb7","name":"Pedersen, Kasper Steen","orcid":"0000-0002-4381-4544","rank":7,"rolecode":"pau"}],"pmid":["34094180"],"pub":{"doi":"10.1039/d0sc01836h","issn":["20416520","20416539"],"issn_org":["20416520"],"issue":"31","journal":"Chemical Science","pages":"8267-8272","publisher":"Royal Society of Chemistry","status":"p","title":"Chemical Science","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-85090160705"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-1fdb6fe7-edf0-45d1-9171-54216f8ef22d"],"src":["DTU Technical University of Denmark"],"title":"Ligand field-actuated redox-activity of acetylacetonate","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-314062","year":"2020","yearsub":"2020"}
{"abstract":"We develop an approach to security of adaptive agents that is based on respecting the local security policies of agents rather than imposing a global security policy on all agents. In short, an agent can be assured, that it will not be able to observe any violation of its own security policy due to the changing presence of other agents in its environment. The development is performed for a version of Dijkstra’s Guarded Commands with relocation primitives, channel based communication, and explicit non-determinism. At the technical level a type system enforces local security policies whereas a reference monitor ensures that relocation is permissible with local security of all agents.","author_count":3,"contributors":["Nielson, Flemming","Hansen, René Rydhof","Nielson, Hanne Riis"],"cuid":["S01-000.00-342816"],"event":{"end":"2020-10-30","place":"Virtual event - POSTPONED TO 2021!, gr","start":"2020-10-20","title":"International Symposium On Leveraging Applications of Formal Methods, Verification and Validation 2020","year":"2020"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-AAU","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"adaptive security policies","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/238027779/2020_Adaptive_Security_Policies.pdf","version":"Authors Final Version"},"id":"S01-000.00-342816","identifier":[{"id":"85096527479","type":"scopus"}],"ids":["dtu-8015476b-6bd7-4650-87f3-ac22bab59715"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-5-E4BDCE877DCBFA672F9566930F60B415"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/238027779/2020_Adaptive_Security_Policies.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Applied Mathematics and Computer Science","Technical University of Denmark, Department of Applied Mathematics and Computer Science, Formal Methods"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Flemming","key":"nielsonflemmingpau","last":"Nielson","locid":"f63ba194-185f-465d-9b2b-1f6ff489bc3d","name":"Nielson, Flemming","orcid":"0000-0001-7362-6176","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"René Rydhof","key":"hansenrenérydhofpau","last":"Hansen","name":"Hansen, René Rydhof","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Hanne Riis","key":"nielsonhanneriispau","last":"Nielson","locid":"44a7d08e-b083-4419-a466-8f4392a7112f","name":"Nielson, Hanne Riis","orcid":"0000-0002-2484-5580","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-030-61470-6_17","isbn":["9783030614690"],"issn":["03029743"],"pages":"280-294","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","title":"Engineering Principles"},"review":"Peer Reviewed","scoID":["2-s2.0-85096527479"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-8015476b-6bd7-4650-87f3-ac22bab59715"],"src":["DTU Technical University of Denmark"],"title":"Adaptive Security Policies","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-342816","year":"2020","yearsub":"2020"}
{"abstract":"MicroRNAs are small regulatory RNAs that are deregulated in a wide variety of human cancers, including different types of B-cell lymphoma. Nevertheless, the feasibility of circulating microRNA for early diagnosis of B-cell lymphoma has not been established. To address the possibility of detecting specific circulating microRNAs years before a B-cell lymphoma is diagnosed, we studied the plasma expression of microRNA first in pre-treatment samples from patients with diffuse large B-cell lymphoma and subsequently in repository samples from blood donors who later developed B-cell lymphomas. In addition, we studied the microRNA expression in the diagnostic lymphoma biopsy. The most strongly induced (miR-326) and suppressed (miR-375) plasma microRNA at diagnosis, when compared with healthy blood donors, were also substantially up- or down-regulated in plasma repository samples taken from several months to up to two years before the blood donors were diagnosed with B-cell lymphoma. Importantly, at these time points the donors had no signs of disease and felt healthy enough to donate blood. In conclusion, this first study of plasma microRNA profiles from apparently healthy individuals, taken several years before B-cell lymphoma diagnosis, suggests that plasma microRNA profiles may be predictive of lymphoma development.","author_count":20,"contributors":["Jørgensen, Steffen","Paulsen, Isabella Worlewenut","Hansen, Jakob Werner","Tholstrup, Dorte","Hother, Christoffer","Sørensen, Erik","Petersen, Mikkel Steen","Nielsen, Kaspar René","Rostgaard, Klaus","Larsen, Margit Anita Hørup","Brown, Peter de Nully","Ralfkiær, Elisabeth","Homburg, Keld Mikkelsen","Hjalgrim, Henrik","Erikstrup, Christian","Ullum, Henrik","Troelsen, Jesper","Grønbæk, Kirsten","Pedersen, Ole Birger"],"cuid":["S05-099.84-004196"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":"5+","corresponding_author":["Pedersen, Ole Birger"],"level":"sci","mra":["hum","med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U","DI-UC"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-KEN","DI-HO-NDR","DI-HO-ZEA"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-RUC"],"UC":["DI-UC-AB","DI-UC-ALL"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-HO-CDR","DI-HO-KEN","DI-HO-NDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-RUC","DI-UC-AB"]},"review":"pr","rtype":["clu"],"sorti":"the value of circulating micrornas for early diagnosis of b cell lymphoma a case control study on historical samples","src":["aau","au","ku","pha","ruc"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-RUC","DI-UC-AB"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41598-020-66062-1","version":"Published Version"},"funding_acknowledgement":["Establishing DBDS has been funded by Danish Regions and The Danish National research Foundation. The microRNA analyses were funded by both the Regional and Local Region Zealand Health and Medical Scientific Research Foundations and also Einar Willumsens Mindefond."],"id":"S05-099.84-004196","identifier":[{"id":"32541886","type":"pmid"},{"id":"PMC7295742","type":"pmcid"},{"id":"85086433900","type":"scopus"}],"ids":["aau-55e8cf93-3d86-4d7f-b9e0-55de534c0431","au-2d8c7e75-c3ea-48cb-8e76-2308321a54e5","ku-5a0d1e34-c8da-4798-86ef-855860bd8dc6","pha-eb97adb2-0af4-490f-a7ca-c5632122b2b2","ruc-1c7a6535-d14a-4196-9490-a0e5eb39daf3"],"lang":"English","level":"Scientific","mra":["Humanities","Medical Science","Science/Technology"],"noi":["Global-Local-2-8-AD711CA0FD9C3BDC5D7F6EC4CFEFE713"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/258894582/s41598_020_66062_1.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://ucviden.pha.dk/ws/files/79344042/The_value_of_circulating.pdf","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/348914290/J_rgensen_et_al._2020_The_value_of_circulating_microRNAs_for_early_diagnosis_of_B_cell_lymphoma.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41598-020-66062-1","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/73786635/s41598_020_66062_1.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of Science and Environment"],"nora_code":"DI-U-RUC","used":1},{"affno":"2","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Næstved, Slagelse, Ringsted Hospitals"],"nora_code":"DI-HO-ZEA","used":1},{"affno":"3","country":"dk","key":"university college absalon","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-AB","l3nl":"University College Absalon","l3nn":"University College Absalon","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"University College Absalon","namevar":["University College Absalon"],"nora_code":"DI-UC-AB","used":1},{"affno":"4","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Rigshospitalet, Copenhagen University Hospital"],"nora_code":