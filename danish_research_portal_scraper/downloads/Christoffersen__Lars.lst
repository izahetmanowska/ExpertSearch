","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-b005bc60-6ade-4672-93d9-dee0d329a220","ku-47e9a807-0532-4900-b742-54d6720a666a"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Site-specific O-glycosylation of members of the low-density lipoprotein receptor superfamily enhances ligand interactions","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.81-025487","year":"2018","yearsub":"2018"}
{"abstract":"Background and aims: Plasma apolipoprotein M (APOM) is bound to HDL-particles and has anti-atherogenic effects. The present study explored whether plasma APOM is reduced in patients with chronic kidney disease (CKD), and associated with cardiovascular disease (CVD). In addition, we tested the hypothesis that the excretion of APOM into the urine is increased in patients with kidney disease. Methods: Plasma samples were collected from a cohort of patients with CKD stages 1 to 5D (N = 409) and controls (N = 35). Urine was collected from 47 subjects. Plasma APOM was measured with sandwich ELISA and urine APOM with competitive ELISA. Results: Plasma APOM levels were reduced in patients with CKD stages 3-5D as compared to patients with CKD stages 1 + 2 and controls (p < 0.01). CKD patients with known CVD displayed even further reduction in plasma APOM levels than CKD patients without known CVD (p < 0.001). Fast-phase liquid chromatography showed that plasma APOM was primarily associated with HDL-cholesterol (HDL-C) across CKD stages. Accordingly, when plasma APOM values were corrected for HDL-C, a significant difference only persisted between patients with CKD stage 3 and stages 1 + 2 (p < 0.05), and the difference between CKD patients with and without known CVD disappeared. Urine APOM/creatinine ratio was not significantly increased in patients with kidney disease. Conclusions: The results show that the difference in plasma APOM levels observed between patients with mild and advanced CKD may mainly be due to differences in plasma HDL-C. Whether APOM plays a role in human uremic atherogenesis warrants further experimental studies.","author_count":9,"contributors":["Sørensen, Ida MH","Bertelsen, Marianne","Freese, Ellen","Lindhard, Kristine","Ullum, Henrik","Feldt-Rasmussen, Bo","Nielsen, Lars Bo","Christoffersen, Christina","Bro, Susanne"],"cuid":["S01-000.00-461802"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Cardiovascular risk","Chronic kidney disease","HDL cholesterol","LDL cholesterol"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"apolipoprotein m in patients with chronic kidney disease","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-461802","identifier":[{"id":"29980057","type":"pmid"},{"id":"85049320575","type":"scopus"}],"ids":["ku-72698dbb-a07a-456b-b442-db7b0b3a1431"],"keyword":["Cardiovascular risk","Chronic kidney disease","HDL cholesterol","LDL-cholesterol","Plasma apolipoprotein M","Urine apolipoprotein M sphingosine-1-phosphate"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-10BA26CD87A4363E0D2F6FB4A68E80B8"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Clinical immunology","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Ida MH","key":"sørensenpau","last":"Sørensen","name":"Sørensen, Ida MH","rank":1,"rolecode":"pau"},{"affno":"","first":"Marianne","key":"bertelsenpau","last":"Bertelsen","name":"Bertelsen, Marianne","rank":2,"rolecode":"pau"},{"affno":"","first":"Ellen","key":"freesepau","last":"Freese","name":"Freese, Ellen","rank":3,"rolecode":"pau"},{"affno":"","first":"Kristine","key":"lindhardpau","last":"Lindhard","name":"Lindhard, Kristine","rank":4,"rolecode":"pau"},{"affno":"1","first":"Henrik","key":"ullumpau","last":"Ullum","locid":"ef594d49-5aeb-4d32-80b4-4bfc281b5cbb","name":"Ullum, Henrik","orcid":"0000-0001-7306-9058","rank":5,"rolecode":"pau"},{"affno":"1","first":"Bo","key":"feldtrasmussenpau","last":"Feldt-Rasmussen","locid":"cdd06e7b-83c5-4118-8808-eb4591586aac","name":"Feldt-Rasmussen, Bo","rank":6,"rolecode":"pau"},{"affno":"1","first":"Lars Bo","key":"nielsenpau","last":"Nielsen","locid":"313d9ac1-283c-452d-af72-ab35e031b7aa","name":"Nielsen, Lars Bo","rank":7,"rolecode":"pau"},{"affno":"1","first":"Christina","key":"christoffersenpau","last":"Christoffersen","locid":"7f6ac9b3-a8ee-401d-8c45-dc0bf731314a","name":"Christoffersen, Christina","rank":8,"rolecode":"pau"},{"affno":"","first":"Susanne","key":"bropau","last":"Bro","name":"Bro, Susanne","rank":9,"rolecode":"pau"}],"pmid":["29980057"],"pub":{"doi":"10.1016/j.atherosclerosis.2018.06.815","issn":["00219150","15675688"],"issn_org":["00219150"],"journal":"Atherosclerosis","pages":"304-311","status":"p","title":"Atherosclerosis","volume":"275"},"review":"Peer Reviewed","scoID":["2-s2.0-85049320575"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-72698dbb-a07a-456b-b442-db7b0b3a1431"],"src":["KU University of Copenhagen"],"title":"Apolipoprotein M in patients with chronic kidney disease","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-461802","year":"2018","yearsub":"2018"}
{"abstract":"Background: Old age is not a risk factor per se when it comes to low well-being. In most old people well-being is as high as, or higher than, it was earlier in life, despite age-related stressors. However, when these stressors cause loss of independence and a permanent need for help, it could be a different matter. Objectives: This study attempted to answer the following questions: How large a proportion of home care recipients had well-being levels indicating stress and risk of depression? Did the overall level of subjective well-being change during a one-year period? How did subjective well-being in elderly home care recipients compare to the national Danish average? Sample: 759 home care recipients 65 years or older in The Municipality of Aarhus, Denmark, all answered the WHO-5 Well-being Index as part of a yearly survey on the satisfaction with home care services provided by the municipality. All participants answered the questionnaire twice (in 2016 and 2017), either by telephone interview or by internet. Measures: The WHO-5 Well-being Index is a brief self-report inventory with five items. The overall result ranges from 0 to 100 with 0 being the lowest possible level of well-being and 100 being the optimal level. Scores of 50 and above are considered normal well-being by the Danish National Board of Health. Scores of 35 or lower indicate severe stress and a great risk of depression. Analyses: Descriptive statistics and Repeated measures ANOVA with WHO-5 score as within subject factor, and gender and data collection method as between subject factors. Results: 18% of the participants in 2016 had a WHO-5 score of 35 or lower, in 2017 it was 25%. Another 19% in 2016 and 16% in 2017 had a WHO-5 score below 50. Repeated measures ANOVA showed a significant small drop in overall well-being over a one-year period. There was a small significant interaction between WHO-5 and both gender and data collection method. Estimated marginal means were 56.9 in 2016 and 54.3 in 2017. The grand mean for both measure points was 55.6 (SD = .9) on WHO-5, which is considerably lower than the national Danish average which is 70. Discussion: Implications of the results were discussed in terms of the need for interventions aimed at improving well-being in home dwelling elderly people in need of care.","author_count":4,"contributors":["Larsen, Lars","Povlsen, Thomas Kaalby","Mortensen, Steen Lee","Christoffersen, Morten"],"cuid":["S01-000.00-145794"],"event":{"end":"2018-08-10","place":"Toronto, ca","start":"2018-08-08","title":"IFA 14th Global Conference on Ageing","year":"2018"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Århus Kommune"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"a one year longitudinal study of subjective well being in elderly home care recipients","src":["au"],"src-code":["DI-U-AU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://www.ifa-abstracts.com/a-one-year-longitudinal-study-of-subjective-well-being-in-elderly-home-care-recipients/","version":"Other Version"},"id":"S01-000.00-145794","ids":["au-1cbe0c36-9f5a-4793-9f64-946bc76830f5"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-B802BE2A60EA8BCC6E3474ACB9020C74"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.ifa-abstracts.com/a-one-year-longitudinal-study-of-subjective-well-being-in-elderly-home-care-recipients/","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus BSS, Department of Psychology and Behavioural Sciences"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Århus Kommune"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Lars","key":"larsenpau","last":"Larsen","locid":"7bd13f67-d81b-40d2-a742-8115e7100ecb","name":"Larsen, Lars","orcid":"0000-0003-1603-0311","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Thomas Kaalby","key":"povlsenpau","last":"Povlsen","name":"Povlsen, Thomas Kaalby","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Steen Lee","key":"mortensenpau","last":"Mortensen","name":"Mortensen, Steen Lee","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Morten","key":"christoffersenpau","last":"Christoffersen","locid":"cc69f65a-9162-4ebe-8585-b2b3ac5f762d","name":"Christoffersen, Morten","orcid":"0000-0002-9423-4654","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-1cbe0c36-9f5a-4793-9f64-946bc76830f5"],"src":["AU Aarhus University"],"title":"A one-year longitudinal study of subjective well-being in elderly home care recipients","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-145794","year":"2018","yearsub":"2018"}
{"abstract":"Apolipoprotein E (APOE) mediates hepatic uptake of lipoproteins through the low-density lipoprotein receptor and low-density receptor-related protein 1. Defects or deficiency of APOE causes familial dysbetalipoproteinemia in humans characterized by accumulations of VLDL, IDL, and chylomicron remnants as well as a higher risk of atherosclerotic disease. APOE is also involved in controlling smooth muscle cell proliferation and migration, reverse cholesterol transport and inflammation.","author_count":26,"contributors":["Shim, Jeong Tangkjær","Poulsen, Christian Bo","Hagensen, Mette K","Larsen, Torben","Heegaard, P.M.H.","Christoffersen, Christina","Bolund, Lars","Schmidt, Mette","Liu, Ying","Li, Juan","Li, Rong","Callesen, Henrik","Bentzon, Jacob Fog","Sørensen, Charlotte Brandt"],"cuid":["S03-096.12-028086"],"event":{"end":"2017-08-17","place":"Tahoe, us","start":"2017-08-13","title":"UC Davis Transgenic Animal Research Conference XI","year":"2017"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","Nanjing Agricultural University"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-DTU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-AU","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"apolipoprotein e deficiency increases remnant lipoproteins and accelerates progressive atherosclerosis in yucatan minipigs","src":["au","dtu","ku"],"src-code":["DI-U-AU","DI-U-DTU","DI-U-KU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s11248-018-0086-x","version":"Published Version"},"id":"S03-096.12-028086","identifier":[{"id":"85060034642","type":"scopus"},{