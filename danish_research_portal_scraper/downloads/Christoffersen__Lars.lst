scellaneous","Other Research","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-606d5c8d-bbc7-498d-9c96-029de42ee531","sdu-d837c5c9-ebd2-4660-a694-d8ec42790692"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Estrangement Between Older Parents and Adult Children : Associations with Mental Health","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-813652","year":"2025","yearsub":"2025"}
{"abstract":"Som psykologer anerkender vi bekymringer om det nye tilbud for børn og unge i mistrivsel. Dog er initiativet ikke ment som en erstatning for eksisterende støtte, men som en komplementær indsats.","author_count":2,"contributors":["Christoffersen, Morten","Larsen, Lars"],"cuid":["S01-000.00-753372"],"filters":{"added":"2024-09","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"pop","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"und","rtype":["clu"],"sorti":"børn og unge i mistrivsel har også ret til behandling med dokumenteret effekt","src":["au"],"src-code":["DI-U-AU"],"type":"dna","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.information.dk/debat/2024/07/boern-unge-mistrivsel-ogsaa-ret-behandling-dokumenteret-effekt?fbclid=IwY2xjawEU9FtleHRuA2FlbQIxMQABHY5KN0l1BfZCtt6T4Qhw5sG_3RFM5PkldCDWKaj2_ranam0q0GeRlgdRPg_aem_6Zd7fNZcz2Eui1fZeKBdaw","version":"Other Version"},"id":"S01-000.00-753372","ids":["au-ea20fe83-4441-4014-a20a-2121b7d40a90"],"lang":"Danish","level":"Popular","mra":["Social Science"],"noi":["Local-1-1-3D2072A123FE41AA9C20BA4BE47FB1F8"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus BSS, Department of Psychology and Behavioural Sciences"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Morten","key":"christoffersenpau","last":"Christoffersen","locid":"cc69f65a-9162-4ebe-8585-b2b3ac5f762d","name":"Christoffersen, Morten","orcid":"0000-0002-9423-4654","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars","key":"larsenpau","last":"Larsen","locid":"7bd13f67-d81b-40d2-a742-8115e7100ecb","name":"Larsen, Lars","orcid":"0000-0003-1603-0311","rank":2,"rolecode":"pau"}],"pub":{"issn":["16022572"],"newspaper":"Information","publisher":"Dagbladet Information","status":"p","title":"Information"},"review":"Undetermined","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-ea20fe83-4441-4014-a20a-2121b7d40a90"],"src":["AU Aarhus University"],"title":"Børn og unge i mistrivsel har også ret til behandling med dokumenteret effekt","type":"Newspaper Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-753372","year":"2024","yearsub":"2024"}
{"abstract":"Aim: Apolipoprotein M (apoM) is mainly expressed in liver and in proximal tubular epithelial cells in the kidney. In plasma, apoM associates with HDL particles via a retained signal peptide and carries sphingosine-1-phosphate (S1P), a small bioactive lipid. ApoM is undetectable in urine from healthy individuals but lack of megalin receptors in proximal tubuli cells induces loss of apoM into the urine. Besides this, very little is known about kidney-derived apoM. The aim of this study was to address the role of apoM in kidney biology and in acute kidney injury. Methods: A novel kidney-specific human apoM transgenic mouse model (RPTEC-hapoMTG) was generated and subjected to either cisplatin or ischemia/reperfusion injury. Further, a stable transfection of HK-2 cells overexpressing human apoM (HK-2-hapoMTG) was developed to study the pattern of apoM secretion in proximal tubuli cells. Results: Human apoM was present in plasma from RPTEC-hapoMTG mice (mean 0.18 μM), with a significant increase in plasma S1P levels. In vitro apoM was secreted to both the apical (urine) and basolateral (blood) compartment from proximal tubular epithelial cells. However, no differences in kidney injury score was seen between RPTEC-hapoMTG and wild type (WT) mice upon kidney injury. Further, gene expression of inflammatory markers (i.e., IL6, MCP-1) was similar upon ischemia/reperfusion injury. Conclusion: Our study suggests that kidney-derived apoM is secreted to plasma, supporting a role for apoM in sequestering molecules from excretion in urine. However, overexpression of human apoM in the kidney did not protect against acute kidney injury.","author_count":7,"contributors":["Bisgaard, Line S.","Christensen, Pernille M.","Oh, Jeongah","Torta, Federico","Füchtbauer, Ernst Martin","Nielsen, Lars Bo","Christoffersen, Christina"],"cuid":["S01-000.00-732313"],"filters":{"added":"2024-05","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, South"],"country":["Singapore"],"glorg":["All Global Affiliations","National University of Singapore"],"keyword":["Apolipoprotein","Cell culture","Kidney","Transwell","apolipoprotein M"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"kidney derived apolipoprotein m and its role in acute kidney injury","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fphar.2024.1328259","version":"Published Version"},"id":"S01-000.00-732313","identifier":[{"id":"38313311","type":"pmid"},{"id":"PMC10834784","type":"pmcid"},{"id":"85183736186","type":"scopus"}],"ids":["ku-c2164c0d-ebd8-4ec6-8421-ed9d8df0e5fc"],"keyword":["HK-2 cell","acute kidney injury (AKI)","apolipoprotein","apolipoprotein M","cell culture","kidney","transwell"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-22ADD0D9311A1A955081AD8B0993984E"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fphar.2024.1328259","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/384423891/Kidney.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Biomedical Sciences, Physiology of circulation, kidney and lung"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","country":"sg","key":"national university of singapore","loc":["Singapore","Asia, South"],"name":"National University of Singapore","used":1},{"affno":"4","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1 2","first":"Line S.","key":"bisgaardpau","last":"Bisgaard","locid":"c48b305c-876a-4495-b193-fd110718aeb3","name":"Bisgaard, Line S.","rank":1,"rolecode":"pau"},{"affno":"2 1","first":"Pernille M.","key":"christensenpau","last":"Christensen","name":"Christensen, Pernille M.","rank":2,"rolecode":"pau"},{"affno":"3","first":"Jeongah","key":"ohpau","last":"Oh","name":"Oh, Jeongah","rank":3,"rolecode":"pau"},{"affno":"3 4","first":"Federico","key":"tortapau","last":"Torta","name":"Torta, Federico","rank":4,"rolecode":"pau"},{"affno":"4","first":"Ernst Martin","key":"füchtbauerpau","last":"Füchtbauer","name":"Füchtbauer, Ernst Martin","rank":5,"rolecode":"pau"},{"affno":"4","first":"Lars Bo","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Lars Bo","rank":6,"rolecode":"pau"},{"affno":"1 2","first":"Christina","key":"christoffersenpau","last":"Christoffersen","locid":"7f6ac9b3-a8ee-401d-8c45-dc0bf731314a","name":"Christoffersen, Christina","rank":7,"rolecode":"pau"}],"pmid":["38313311"],"pub":{"doi":"10.3389/fphar.2024.1328259","issn":["16639812"],"journal":"Frontiers in Pharmacology","paperid":"1328259","status":"p","title":"Frontiers in Pharmacology","volume":"15"},"review":"Peer Reviewed","scoID":["2-s2.0-85183736186"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-c2164c0d-ebd8-4ec6-8421-ed9d8df0e5fc"],"src":["KU University of Copenhagen"],"title":"Kidney derived apolipoprotein M and its role in acute kidney injury","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-732313","year":"2024","yearsub":"2024"}
{"abstract":"Psychotherapy can be a highly beneficial form of treatment, which has also had success among older people. However, it is increasingly recognized by psychologists that psychotherapy can have adverse side effects. This longitudinal study investigates the impact of practice on the adverse effects of psychotherapy with elderly individuals. It follows a team of psychologists through the first 100 clients in their professional careers to explore whether increased practice leads to fewer adverse effects for their clients. The psychologists routinely monitor the effects of their work using various psychometric outcome measures and receive weekly supervision. The clients, primarily elderly individuals above the age of 65, receive psychotherapy to improve their overall well-being, which is measured using the WHO-5 Well-being Index. A binomial regression analysis is conducted, by defining adverse effects as no positive change in well-being during the course of therapy. Subsequent regression analyses include an exploration of any change in standard deviations, reflecting whether psychologists become more reliable with experience. Results suggests that psychologists do not improve with experience. The results are discussed in terms of potential strategies to reduce adverse effects in psychotherapy, with measurement-based treatment highlighted as a promising approach.","author_count":2,"contributors":["Larsen, Lars","Christoffersen, Morten"],"cuid":["S01-000.00-757922"],"event":{"end":"2025-01-07","place":"Oahu, um","start":"2025-01-04","title":"the 23rd Annual Hawaii International Conference on Education","year":"2025"},"filters":{"added":"2024-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Larsen, Lars"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"do no harm the impact of experience on reducing adverse effects of psychotherapy in older clients","src":["au"],"src-code":["DI-U-AU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","license":"https://hiceducation.org/wp-content/uploads/2024/12/2025-Final-Program.pdf","type":"rem","url":"https://hiceducation.org/wp-content/uploads/2024/12/2025-Final-Program.pdf","version":"Published Version"},"id":"S01-000.00-757922","ids":["au-5106d387-d2f9-4002-bd34-ac505cd1c6b8"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-9B483D2C8C8A137894AD2848E5499683"],"oa_link":[{"access":"oa","license":"https://hiceducation.org/wp-content/uploads/2024/12/2025-Final-Program.pdf","type":"rem","url":"https://hiceducation.org/wp-content/uploads/2024/12/2025-Final-Program.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus BSS, Department of Psychology and Behavioural Sciences"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Lars","key":"larsenpau","last":"Larsen","locid":"7bd13f67-d81b-40d2-a742-8115e7100ecb","name":"Larsen, Lars","orcid":"0000-0003-1603-0311","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Morten","key":"christoffersenpau","last":"Christoffersen","locid":"cc69f65a-9162-4ebe-8585-b2b3ac5f762d","name":"Christoffersen, Morten","orcid":"0000-0002-9423-4654","rank":2,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-5106d387-d2f9-4002-bd34-ac505cd1c6b8"],"src":["AU Aarhus University"],"title":"Do No Harm: : The Impact of Experience on Reducing Adverse Effects of Psychotherapy in Older Clients","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-757922","year":"2024","yearsub":"2024"}
