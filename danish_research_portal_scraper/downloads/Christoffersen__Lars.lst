of Copenhagen"],"title":"Overskridelseserfaringer","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-490940","year":"2021","yearsub":"2021"}
{"abstract":"The present article reports a study conducted to develop and validate a Danish translation of the Purpose in Life test-Short Form (PIL-SF) and examine age effects on this eudemonic measure. The study examined the reliability, unidimensionality, and construct validity of the Danish PIL-SF using a large and representative sample (N = 4,849). The results indicated that the Danish PIL-SF is a reliable and valid measure of meaning and purpose in life, positively associated with but distinct from hedonic well-being. The high degree of similarity between the measurement properties of the Danish PIL-SF, as compared with the English-language PIL-SF, supports the validity of the Danish translation. Furthermore, the unidimensional structure of the Danish measure replicates the structure of the English-language PIL-SF. Given its large and representative sample, the present study provides the current best estimate of a normative population value for the PIL-SF. Also, the present study is the first to our knowledge to explore potential relationships between age and the PIL-SF, and a small positive effect of age on the Danish PIL-SF was found. Limitations and suggestions for further research are discussed.","author_count":3,"contributors":["Vedel, Anna","Christoffersen, Morten","Larsen, Lars"],"cuid":["S01-000.00-178272"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Vedel, Anna"],"keyword":["Denmark","FIT INDEXES","Happiness","Humans","Language","Meaning","Positive psychology","Psychometrics","Quality of Life","Reproducibility of Results","Surveys and Questionnaires","Test translation","Well being"],"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Århus Kommune"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"the danish purpose in life test short form pil sf validation and age effects","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85115254940","version":"Other Version"},"id":"S01-000.00-178272","identifier":[{"id":"85115254940","type":"scopus"},{"id":"000697509800001","type":"wos"},{"id":"34547114","type":"pmid"}],"ids":["au-55d2bfaf-eb8b-4112-8547-2ca3e3f8968f"],"keyword":["Denmark","FIT INDEXES","HAPPINESS","Humans","Language","POSITIVE PSYCHOLOGY","Psychometrics","Quality of Life","Reproducibility of Results","Surveys and Questionnaires","eudemonic","meaning","purpose in life","test translation","well-being"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-4-3D7880FA026EA146D693762878A090BE"],"oai":{"class":"Unused","mra":["Social Science (SOC)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus BSS, Department of Psychology and Behavioural Sciences"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Århus Kommune"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Anna","key":"pacakvedelpau","last":"Pacak-Vedel","locid":"717ee2a9-75d4-4f25-987d-96999aad6fee","name":"Vedel, Anna","name_org":"Pacak-Vedel, Anna","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Morten","key":"christoffersenpau","last":"Christoffersen","name":"Christoffersen, Morten","rank":2,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Lars","key":"larsenpau","last":"Larsen","locid":"7bd13f67-d81b-40d2-a742-8115e7100ecb","name":"Larsen, Lars","orcid":"0000-0003-1603-0311","rank":3,"rolecode":"pau"}],"pmid":["34547114"],"pub":{"doi":"10.1111/sjop.12776","issn":["00365564","14679450"],"issn_org":["00365564"],"issue":"6","journal":"Scandinavian Journal of Psychology","pages":"833-838","publisher":"Wiley-Blackwell Publishing Ltd","status":"p","title":"Scandinavian Journal of Psychology","volume":"62"},"review":"Peer Reviewed","scoID":["2-s2.0-85115254940"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-55d2bfaf-eb8b-4112-8547-2ca3e3f8968f"],"src":["AU Aarhus University"],"title":"The Danish Purpose in Life test-Short Form (PIL-SF): : validation and age effects","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-178272","year":"2021","yearsub":"2021"}
