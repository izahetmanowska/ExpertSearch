name":"Gordts, Philip L S M","rank":1,"rolecode":"pau"},{"affno":"","first":"Alexander","key":"barteltpau","last":"Bartelt","name":"Bartelt, Alexander","rank":2,"rolecode":"pau"},{"affno":"","first":"Stefan K","key":"nilssonpau","last":"Nilsson","name":"Nilsson, Stefan K","rank":3,"rolecode":"pau"},{"affno":"","first":"Wim","key":"annaertpau","last":"Annaert","name":"Annaert, Wim","rank":4,"rolecode":"pau"},{"affno":"1","first":"Christina","key":"christoffersenpau","last":"Christoffersen","locid":"7f6ac9b3-a8ee-401d-8c45-dc0bf731314a","name":"Christoffersen, Christina","rank":5,"rolecode":"pau"},{"affno":"1","first":"Lars Bo","key":"nielsenpau","last":"Nielsen","locid":"313d9ac1-283c-452d-af72-ab35e031b7aa","name":"Nielsen, Lars Bo","rank":6,"rolecode":"pau"},{"affno":"","first":"Joerg","key":"heerenpau","last":"Heeren","name":"Heeren, Joerg","rank":7,"rolecode":"pau"},{"affno":"","first":"Anton J M","key":"roebroekpau","last":"Roebroek","name":"Roebroek, Anton J M","rank":8,"rolecode":"pau"}],"pmid":["22701627"],"pub":{"doi":"10.1371/journal.pone.0038330","issn":["19326203"],"issue":"6","journal":"PLOS ONE","status":"p","title":"PLOS ONE","title_org":"P L o S One","volume":"7"},"review":"Peer Reviewed","scoID":["2-s2.0-84862023929"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-5aefbfd8-386e-4640-886c-9f66e33d6ba8"],"src":["KU University of Copenhagen"],"title":"Impaired LDL Receptor-Related Protein 1 Translocation Correlates with Improved Dyslipidemia and Atherosclerosis in apoE-Deficient Mice","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-447841","year":"2012","yearsub":"2012"}
{"abstract":"The present paper surveys the input parameters in hospital design and describes them formally as building attributes in preparation for facilitating planning and designing of hospitals with the aim of a more optimal design process. The overview of the hospital functionalities, bonds, logistics and needs is based on an approach of understanding the complexity of the hospital functionalities based on capacities, qualities and times beforehand specific department or units are described. This approach attempts to create an overview of the hospital functionalities respecting capacities, qualities and times and defining the building attributed on this basis as detailed specifications.","author_count":3,"contributors":["Holst, Malene Kirstine","Kirkegaard, Poul Henning","Christoffersen, Lars D."],"cuid":["S01-000.00-058850"],"event":{"end":"2012-04-17","place":"Tromsø-Bergen, no","start":"2012-04-13","title":"Congress of the International Federation of Hospital Engineering","year":"2012"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Hospital design","Layout Design","Organization and logistics","Quantification of Aesthetics"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-PR-OTH","DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"on hospital design identifying building attributes of hospital design","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/70159863/On_Hospital_Design_Identifying_Building_Attributes_of_Hospital_Design.pdf","version":"Authors Final Version"},"id":"S01-000.00-058850","ids":["aau-1e1f3450-4a63-422d-b8b7-a607f96e06f7"],"keyword":["Hospital Design","Layout Design","Organization and logistics","Quantification of Aesthetics"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-6CAE4A9DAB98E575F9DACA025AD31B1C"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/70159863/On_Hospital_Design_Identifying_Building_Attributes_of_Hospital_Design.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (ENG)","Aalborg University, The Faculty of Engineering and Science, Department of Civil Engineering","Aalborg University, The Faculty of Engineering and Science, Department of Civil Engineering, Division for Structures, Materials and Geotechnics (CIVIL)"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["Alectia A/S"],"nora_code":"DI-PR-OTH","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Malene Kirstine","key":"holstpau","last":"Holst","locid":"f137880d-c097-491e-941d-769a59729a05","name":"Holst, Malene Kirstine","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Poul Henning","key":"kirkegaardpau","last":"Kirkegaard","locid":"08b0497e-7b30-4340-b1cd-df434dfc470e","name":"Kirkegaard, Poul Henning","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lars D.","key":"christoffersenpau","last":"Christoffersen","name":"Christoffersen, Lars D.","rank":3,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U