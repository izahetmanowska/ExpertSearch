{"author_count":8,"contributors":["Blom, Lars","Skovgaard, Kerstin","Ludvigsen, T.P.","Kirk, R.K.","Christoffersen, Berit Østergaard","Pedersen, Hanne Dahl","Heegaard, Peter M. H.","Olsen, Lisbeth Høier"],"cuid":["S01-000.00-331687"],"event":{"end":"2015-03-25","place":"Glasgow, gb","start":"2015-03-22","title":"83<sup>rd</sup> European Atherosclerosis Society Congress<br/>","year":"2015"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"vascular gene expression in diet induced atherosclerotic göttingen minipigs","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-331687","ids":["dtu-5b3b8e89-ecd7-4d68-89cd-16f841a153bb"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-4F164710FB2F275E4D15AE9DFE0F0842"],"org":[{"affno":"1","country":"dk","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lars","key":"blompau","last":"Blom","name":"Blom, Lars","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kerstin","key":"skovgaardpau","last":"Skovgaard","locid":"2c3c3868-b5a3-457b-8b97-9645ad03e405","name":"Skovgaard, Kerstin","orcid":"0000-0001-5663-4879","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"T.P.","key":"ludvigsenpau","last":"Ludvigsen","name":"Ludvigsen, T.P.","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"R.K.","key":"kirkpau","last":"Kirk","name":"Kirk, R.K.","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Berit Østergaard","key":"christoffersenpau","last":"Christoffersen","name":"Christoffersen, Berit Østergaard","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Hanne Dahl","key":"pedersenpau","last":"Pedersen","name":"Pedersen, Hanne Dahl","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter M. H.","key":"heegaardpau","last":"Heegaard","locid":"f15c1dfb-4275-4369-9b2b-2af936d2e0e6","name":"Heegaard, Peter M. H.","orcid":"0000-0003-4506-4932","rank":7,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Lisbeth Høier","key":"olsenpau","last":"Olsen","name":"Olsen, Lisbeth Høier","rank":8,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-5b3b8e89-ecd7-4d68-89cd-16f841a153bb"],"src":["DTU Technical University of Denmark"],"title":"Vascular gene expression in diet-induced atherosclerotic göttingen minipigs","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-331687","year":"2015","yearsub":"2015"}
{"abstract":"Rationale: Plasma cholesterol lowering is beneficial in patients with atherosclerosis. However, it is unknown how it affects entry and degradation of low-density lipoprotein (LDL) particles in the lesioned arterial wall. Objective: We studied the effect of lipid-lowering therapy on LDL permeability and degradation of LDL particles in atherosclerotic aortas of mice by measuring the accumulation of iodinated LDL particles in the arterial wall. Methods and Results: Cholesterol-fed, LDL receptor–deficient mice were treated with either an anti-Apob antisense oligonucleotide or a mismatch control antisense oligonucleotide once a week for 1 or 4 weeks before injection with preparations of iodinated LDL particles. The anti-Apob antisense oligonucleotide reduced plasma cholesterol by ≈90%. The aortic LDL permeability and degradation rates of newly entered LDL particles were reduced by ≈50% and ≈85% already after 1 week of treatment despite an unchanged pool size of aortic iodinated LDL particles. In contrast, the size, foam cell content, and aortic pool size of iodinated LDL particles of aortic atherosclerotic plaques were not reduced until after 4 weeks of treatment with the anti-Apob antisense oligonucleotide. Conclusions: Improved endothelial barrier function toward the entry of plasma LDL particles and diminished aortic degradation of the newly entered LDL particles precede plaque regression.","author_count":4,"contributors":["Bartels, Emil D.","Christoffersen, Christina","Lindholm, Marie W.","Nielsen, Lars Bo"],"cuid":["S01-000.00-463693"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"altered metabolism of ldl in the arterial wall precedes atherosclerosis regression","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-463693","identifier":[{"id":"84946489875","type":"scopus"},{"id":"26358193","type":"pmid"}],"ids":["ku-757c59f8-c952-41ee-8684-42f0c1337d99"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-7A87BDC10C8D7028AF88FC494E0653F0"],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Biomedical Sciences, Physiology of circulation, kidney and lung"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Emil D.","key":"bartelspau","last":"Bartels","locid":"93bf9a38-d3f8-45fd-8c88-ab365982b098","name":"Bartels, Emil D.","rank":1,"rolecode":"pau"},{"affno":"1","first":"Christina","key":"christoffersenpau","last":"Christoffersen","locid":"7f6ac9b3-a8ee-401d-8c45-dc0bf731314a","name":"Christoffersen, Christina","rank":2,"rolecode":"pau"},{"affno":"","first":"Marie W.","key":"lindholmpau","last":"Lindholm","name":"Lindholm, Marie W.","rank":3,"rolecode":"pau"},{"affno":"1","first":"Lars B","key":"nielsenpau","last":"Nielsen","locid":"313d9ac1-283c-452d-af72-ab35e031b7aa","name":"Nielsen, Lars Bo","name_org":"Nielsen, Lars B","rank":4,"rolecode":"pau"}],"pmid":["26358193"],"pub":{"doi":"10.1161/circresaha.115.307182","issn":["00097330"],"journal":"Circulation Research","pages":"933-942","status":"p","title":"Circulation Research","volume":"117"},"review":"Peer Reviewed","scoID":["2-s2.0-84946489875"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-757c59f8-c952-41ee-8684-42f0c1337d99"],"src":["KU University of Copenhagen"],"title":"Altered Metabolism of LDL in the Arterial Wall Precedes Atherosclerosis Regression","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-463693","year":"2015","yearsub":"2015"}
{"author_count":3,"contributors":["Qvortrup, Lars"],"cuid":["S01-000.00-104071"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Hotel Pro Forma","Performanceteater","Teater"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"trancendensteater","src":["aau"],"src-code":["DI-U-AAU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://da.unipress.dk/udgivelser/s/sk%C3%B8nhedens-hotel/","version":"Other Version"},"id":"S01-000.00-104071","ids":["aau-ba15a0a8-eebd-430e-ad98-0303adb92886"],"keyword":["Hotel Pro Forma","performanceteater","teater"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-B75530EF0ADE6A28884F90E2B274A545"],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Humanities, Department of Learning and Philosophy","Aalborg University, The Faculty of Humanities, Department of Learning and Philosophy, LSP - Laboratorium for forskningsbaseret skoleudvikling og pædagogisk praksis (Learning)","Aalborg University, The Faculty of Social Sciences"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Lars","key":"qvortruppau","last":"Qvortrup","locid":"1891c010-cc48-4f7c-928c-35255e5d7595","name":"Qvortrup, Lars","orcid":"0000-0002-2112-4809","rank":1,"rolecode":"pau"},{"affno":"","first":"Erik Exe","key":"christoffersenpedh","last":"Christoffersen","name":"Christoffersen, Erik Exe","rank":2,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Kathrine","key":"winkelhornpedh","last":"Winkelhorn","name":"Winkelhorn, Kathrine","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"edition":"1","isbn":["9788771243277"],"pages":"91-107","place":"Aarhus","publisher":"Aarhus Universitetsforlag","status":"p","subtitle":"Hotel Pro Forma: Et laboratorium for scenekunst","title":"Skønhedens Hotel"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-ba15a0a8-eebd-430e-ad98-0303adb92886"],"src":["AAU Aalborg University"],"title":"Trancendensteater","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-104071","year":"2015","yearsub":"2015"}
{"abstract":"PURPOSE: This review will address recent findings on apolipoprotein M (apoM) and its ligand sphingosine-1-phosphate (S1P) in lipid metabolism and inflammatory diseases. RECENT FINDINGS: ApoM's likely role(s) in health and disease has become more diverse after the discovery that apoM functions as a chaperone for S1P. Hence, apoM has recently been implicated in lipid metabolism, diabetes and rheumatoid arthritis through in-vivo, in-vitro and genetic association studies. It remains to be established to which degree such associations with apoM can be attributed to its ability to bind S1P. SUMMARY: The apoM/S1P axis and its implications in atherosclerosis and lipid metabolism have been thoroughly studied. Owing to the discovery of the apoM/S1P axis, the scope of apoM research has broadened. ApoM and S1P have been implicated in lipid metabolism, that is by modulating HDL particles. Also, the importance in regulating endothelial function is being investigated. Furthermore, both apoM and S1P have been linked to diabetes and glucose and insulin metabolism. Finally, genetic variations in the apoM gene are associated with lipid disturbances, diabetes and rheumatoid arthritis. These findings suggest not only diverse effects of apoM, but also the important question of whether apoM mainly acts as a S1P carrier, if apoM carries other substances with biological effects as well, or whether the apoM protein has effects on its own.","author_count":4,"contributors":["Borup, Anna","Christensen, Pernille Meyer","Nielsen, Lars Bo","Christoffersen, Christina"],"cuid":["S01-000.00-537731"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"apolipoprotein m in lipid metabolism and cardiometabolic diseases","src":["ku"],"src-code":["DI-U-KU"],"type":"djr","type-grp":["all","pub"]},"id":"S01-000.00-537731","identifier":[{"id":"84920815241","type":"scopus"},{"id":"25551802","type":"pmid"}],"ids":["ku-f1d5e339-9bc5-4da4-80c3-656178c8c6f1"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-C24CBFE64F59294712E0FDB60EC78E4B"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Biomedical Sciences, Physiology of circulation, kidney and lung"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Anna","key":"boruppau","last":"Borup","name":"Borup, Anna","rank":1,"rolecode":"pau"},{"affno":"1","first":"Pernille Meyer","key":"christensenpau","last":"Christensen","locid":"2a1d9e57-75ed-4b17-bb4a-dc4b68d06f8d","name":"Christensen, Pernille Meyer","rank":2,"rolecode":"pau"},{"affno":"1","first":"Lars B.","key":"nielsenpau","last":"Nielsen","locid":"313d9ac1-283c-452d-af72-ab35e031b7aa","name":"Nielsen, Lars Bo","name_org":"Nielsen, Lars B.","rank":3,"rolecode":"pau"},{"affno":"1","first":"Christina","key":"christoffersenpau","last":"Christoffersen","locid":"7f6ac9b3-a8ee-401d-8c45-dc0bf731314a","name":"Christoffersen, Christina","rank":4,"rolecode":"pau"}],"pmid":["25551802"],"pub":{"doi":"10.1097/mol.0000000000000142","issn":["09579672","1080823X"],"issn_org":["09579672"],"issue":"1","journal":"Current Opinion in Lipidology","pages":"48-55","status":"p","title":"Current Opinion in Lipidology","volume":"26"},"review":"Peer Reviewed","scoID":["2-s2.0-84920815241"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-f1d5e339-9bc5-4da4-80c3-656178c8c6f1"],"src":["KU University of Copenhagen"],"title":"Apolipoprotein M in lipid metabolism and cardiometabolic diseases","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-537731","year":"2015","yearsub":"2015"}
