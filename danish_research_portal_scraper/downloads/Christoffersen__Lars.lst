"Miscellaneous","namevar":["Ensomme Gamles Værn","Ensomme Gamles Vørn (EGV)"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Andreas Tranberg","key":"nikolajsenpau","last":"Nikolajsen","locid":"2749a464-8bce-43a0-8da5-5c8a849fdd4d","name":"Nikolajsen, Andreas Tranberg","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars","key":"larsenpau","last":"Larsen","locid":"7bd13f67-d81b-40d2-a742-8115e7100ecb","name":"Larsen, Lars","orcid":"0000-0003-1603-0311","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Morten","key":"christoffersenpau","last":"Christoffersen","locid":"cc69f65a-9162-4ebe-8585-b2b3ac5f762d","name":"Christoffersen, Morten","orcid":"0000-0002-9423-4654","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Bjørn Evald","key":"holsteinpau","last":"Holstein","name":"Holstein, Bjørn Evald","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Christine","key":"swanepau","last":"Swane","name":"Swane, Christine","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-6eed1bbb-1670-44a0-9bf0-04abf57ac7c9"],"src":["AU Aarhus University"],"title":"Intergenerational estrangement in older age","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-708038","year":"2024","yearsub":"2024"}
{"abstract":"Aims: This systematic review and meta-Analysis sought (i) to provide an overview of the incidence of delirium following open cardiac surgery and (ii) to investigate how incidences of delirium are associated with different assessment tools. Methods and results: A systematic search of studies investigating delirium following open cardiac surgery was conducted in Medline (Ovid), EMBASE, PsycINFO, CiNAHL, and the Cochrane Database. Only studies with patients diagnosed or screened with a validated tool were included. Studies published from 2005-2021 were included in the meta-Analysis. Of 7126 individual studies retrieved, 106 met the inclusion criteria for the meta-Analysis, hereof 31% of high quality. The weighted pooled incidence of delirium following open cardiac surgery across all studies was 23% (95% CI 20-26%), however we found a considerable heterogeneity (I2 = 99%), which could not be explained by subgroups or further sensitivity analyses. The most commonly applied screening tool for delirium is CAM/CAM-ICU. The lowest estimates of delirium were found by applying the Delirium Observation Scale (incidence 14%, 95% CI 8-20%), and the highest estimates in studies using 'other' screening tools (Organic Brain Symptom Scale, Delirium Symptom Interview) with a pooled incidence of 43% (95% CI 19-66%), however, only two studies applied these. Conclusion: Delirium following open cardiac surgery remains a complication with a high incidence of overall 23%, when applying a validated tool for screening or diagnosis. Nevertheless, this systematic review and meta-Analyses highlight the significant inconsistency in current evidence regarding assessment tools and regimens. Registration: Prospero CRD42020215519.","author_count":10,"contributors":["Petersson, Nadja Buch","Hansen, Malene Haugaard","Hjelmborg, Jacob","Instenes, Irene","Christoffersen, Anne Sofie","Kristensen, Katrine Lawaetz","Schmidt, Henrik","Riber, Lars","Norekvål, Tone Merete","Borregaard, Britt"],"cuid":["S02-098.19-785556"],"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Petersson, Nadja Buch"],"country":["Norway"],"glorg":["All Global Affiliations","Haukeland University Hospital","University of Bergen"],"keyword":["Cardiac Surgical Procedures adverse effects","Cardiac surgery","Cardiovascular Diseases","Delirium","Humans","Incidence","Postoperative Complications epidemiology"],"level":"sci","mra":["hum","med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U","DI-UC"],"level3":{"HO":["DI-HO-ALL","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-SDU"],"UC":["DI-UC-ALL","DI-UC-UCL"]},"level3all":["DI-HO-SDR","DI-U-SDU","DI-UC-UCL"]},"review":"pr","rtype":["clu"],"sorti":"incidence and assessment of delirium following open cardiac surgery a systematic review and meta analysis","src":["sdu","ucl"],"src-code":["DI-U-SDU","DI-UC-UCL"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1093/eurjcn/zvae066","version":"Published Version"},"id":"S02-098.19-785556","identifier":[{"id":"85212405060","type":"scopus"},{"id":"38695330","type":"pmid"}],"ids":["sdu-4fc28744-5fe6-4665-b489-3ac44ab6576e","ucl-82282292-1a8a-4321-864a-1e1b68e81fa4"],"keyword":["Cardiac Surgical Procedures/adverse effects","Cardiac surgery","Delirium","Delirium/epidemiology","Humans","Incidence","Postoperative Complications/epidemiology","Screening & diagnose","Validated assessment tools","cardiovascular diseases"],"lang":"English","level":"Scientific","mra":["Humanities","Medical Science"],"noi":["Global-Local-2-5-6A72F013BF57BDC1A723A9203FF4D2F6"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1093/eurjcn/zvae066","version":"Published Version"},{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/263100071/zvae066.pdf","version":"Authors Fi