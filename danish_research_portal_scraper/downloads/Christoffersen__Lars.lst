name":"Callesen, H.","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jacob Fog","key":"bentzonjacobfogpau","last":"Bentzon","locid":"b19cdb97-a953-43ff-ad51-19d0a680caed","name":"Bentzon, Jacob Fog","orcid":"0000-0002-3020-5002","rank":13,"rolecode":"pau"},{"affno":"","first":"J. F.","key":"bentzonjfpau","last":"Bentzon","name":"Bentzon, J. F.","rank":13,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Charlotte Brandt","key":"sørensencharlottebrandtpau","last":"Sørensen","locid":"14bfd3d1-a9b2-4bc5-823b-233432e43cf3","name":"Sørensen, Charlotte Brandt","orcid":"0000-0002-4469-8696","rank":14,"rolecode":"pau"},{"affno":"","first":"C. B.","key":"sorensencbpau","last":"Sorensen","name":"Sorensen, C. B.","rank":14,"rolecode":"pau"}],"pmid":["30128618"],"pub":{"doi":"10.1007/s11248-018-0086-x","issn":["09628819","15739368"],"issn_org":["09628819"],"issue":"5","journal":"Transgenic Research","pages":"484-484","publisher":"Springer Science and Business Media Deutschland GmbH","status":"p","title":"Transgenic Research","volume":"27"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-d511d42a-c927-4216-be81-db1bec21261c","dtu-5dd5f24e-9eaf-4270-be0a-5e58b2b64849","ku-277ab5d1-0d76-4dd0-8523-d1975da98d2d"],"src":["AU Aarhus University","DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Apolipoprotein E deficiency increases remnant lipoproteins and accelerates progressive atherosclerosis in Yucatan minipigs","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-096.12-028086","year":"2018","yearsub":"2018"}
{"abstract":"Sphingosine-1-phosphate (S1P) is a bioactive lipid implicated in e.g. angiogenesis, lymphocyte trafficking, and endothelial barrier function. Erythrocytes are a main source of plasma S1P together with platelets and endothelial cells. Apolipoprotein M (apoM) in HDL carries 70% of plasma S1P, whereas 30% is carried by albumin. The current aim was to investigate the role of apoM in export of S1P from human erythrocytes. Erythrocytes exported S1P more efficiently to HDL than to albumin, particularly when apoM was present in HDL. In contrast, export of sphingosine to HDL was unaffected by the presence of apoM. The specific ability of apoM to promote export of S1P was independent of apoM being bound in HDL particles. Treatment with MK-571, an inhibitor of the ABCC1 transporter, effectively reduced export of S1P from human erythrocytes to apoM, whereas the export was unaffected by inhibitors of ABCB1 or ATPase. Thus, ABCC1 could be involved in export of S1P from erythrocytes to apoM.","author_count":5,"contributors":["Christensen, Pernille Meyer","Bosteen, Markus Høybye","Hajny, Stefan","Nielsen, Lars Bo","Christoffersen, Christina"],"cuid":["S01-000.00-393902"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"apolipoprotein m mediates sphingosine 000000000001 phosphate efflux from erythrocytes","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41598-017-15043-y","version":"Published Version"},"id":"S01-000.00-393902","identifier":[{"id":"000414641300001","type":"wos"},{"id":"85033398369","type":"scopus"},{"id":"PMC5678177","type":"pmcid"},{"id":"29118354","type":"pmid"}],"ids":["ku-00be677a-0141-4059-a58f-a3c5f92fd3d9"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-8EA82DB6FE0A52516D081AE584846AEB"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41598-017-15043-y","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/192721207/s41598_017_15043_y.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Biomedical Sciences, Physiology of circulation, kidney and lung"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Pernille M.","key":"christensenpau","last":"Christensen","locid":"2a1d9e57-75ed-4b17-bb4a-dc4b68d06f8d","name":"Christensen, Pernille Meyer","name_org":"Christensen, Pernille M.","rank":1,"rolecode":"pau"},{"affno":"1","first":"Markus H.","key":"bosteenpau","last":"Bosteen","locid":"9230f6f3-c9a1-48a4-bd1c-a00e5469c72c","name":"Bosteen, Markus Høybye","name_org":"Bosteen, Markus H.","rank":2,"rolecode":"pau"},{"affno":"1","first":"Stefan","key":"hajnypau","last":"Hajny","locid":"ef875bee-127b-4174-bd30-ae63a72d91d0","name":"Hajny, Stefan","rank":3,"rolecode":"pau"},{"affno":"1","first":"Lars B.","key":"nielsenpau","last":"Nielsen","locid":"313d9ac1-283c-452d-af72-ab35e031b7aa","name":"Nielsen, Lars Bo","name_org":"Nielsen, Lars B.","rank":4,"rolecode":"pau"},{"affno":"1","first":"Christina","key":"christoffersenpau","last":"Christoffersen","locid":"7f6ac9b3-a8ee-401d-8c45-dc0bf731314a","name":"Christoffersen, Christina","rank":5,"rolecode":"pau"}],"pmid":["29118354"],"pub":{"doi":"10.1038/s41598-017-15043-y","issn":["20452322"],"journal":"Scientific Reports","paperid":"14983","status":"p","title":"Scientific Reports","volume":"7"},"review":"Peer Reviewed","scoID":["2-s2.0-85033398369"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-00be677a-0141-4059-a58f-a3c5f92fd3d9"],"src":["KU University of Copenhagen"],"title":"Apolipoprotein M mediates sphingosine-1-phosphate efflux from erythrocytes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-393902","year":"2017","yearsub":"2017"}
{"abstract":"BACKGROUND AND AIMS: Chronic kidney disease is characterized by uremia and causes premature death, partly due to accelerated atherosclerosis. Apolipoprotein (apo) M is a plasma carrier protein for the lipid sphingosine-1-phosphate (S1P). The Apom-S1P complex associates with HDL, and may contribute to its anti-atherosclerotic effects. The role of Apom/S1P in atherosclerosis is presently controversial and has not been explored in a uremic setting. We aimed to explore whether plasma concentrations of Apom/S1P are altered by uremia and whether Apom overexpression or deficiency affects classical and uremic atherosclerosis. METHODS: Mild to moderate uremia was induced by subtotal nephrectomy (NX) in 86-92 Apoe-deficient mice that were either Apom-wild type, Apom-deficient, or overexpressed Apom (∼10 fold). The effects of uremia on plasma Apom/S1P and atherosclerosis were evaluated and compared to non-nephrectomized controls. RESULTS: Uremia increased plasma Apom by ∼25%, but not S1P. Plasma S1P was elevated by ∼300% in mice overexpressing Apom, and decreased by ∼25% in Apom-deficient mice. Apom overexpression augmented aortic root atherosclerosis and plasma cholesterol. In contrast, aortic arch atherosclerosis was unaffected by the Apom genotype. There was no effect of Apom-deficiency or Apom overexpression on uremic atherosclerosis. CONCLUSIONS: This study highlights the complexity of Apom/S1P in atherosclerosis and challenges the notion that the Apom/S1P complex is anti-atherogenic, at least in Apoe-deficient mice.","author_count":8,"contributors":["Bosteen, Markus Høybye","Madsen Svarrer, Eva Martha","Bisgaard, Line S.","Martinussen, Torben","Madsen, Marie","Nielsen, Lars Bo","Christoffersen, Christina","Pedersen, Tanja Xenia"],"cuid":["S01-000.00-483663"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"effects of apolipoprotein m in uremic atherosclerosis","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-483663","identifier":[{"id":"85028546875","type":"scopus"},{"id":"28866363","type":"pmid"}],"ids":["ku-96f8e997-63b5-49cc-abc6-242486419db3"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-59335842202736D601C318E1F6152C3A"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Biomedical Sciences, Physiology of circulation, kidney and lung"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","first":"Markus Høybye","key":"bosteenpau","last":"Bosteen","locid":"9230f6f3-c9a1-48a4-bd1c-a00e5469c72c","name":"Bosteen, Markus Høybye","rank":1,"rolecode":"pau"},{"affno":"2","first":"Eva Martha","key":"madsensvarrerpau","last":"Madsen Svarrer","name":"Madsen Svarrer, Eva Martha","rank":2,"rolecode":"pau"},{"affno":"1","first":"Line Stattau","key":"bisgaardpau","last":"Bisgaard","locid":"c48b305c-876a-4495-b193-fd110718aeb3","name":"Bisgaard, Line S.","name_org":"Bisgaard, Line Stattau","rank":3,"rolecode":"pau"},{"affno":"1","first":"Torben","key":"martinussenpau","last":"Martinussen","locid":"be649dfe-556d-49ca-9354-0507dbdaf7b5","name":"Martinussen, Torben","rank":4,"rolecode":"pau"},{"affno":"1","first":"Marie","key":"madsenpau","last":"Madsen","locid":"2552b6c8-6b3a-41c7-aec6-bb2be67d1bf1","name":"Madsen, Marie","rank":5,"rolecode":"pau"},{"affno":"1","first":"Lars Bo","key":"nielsenpau","last":"Nielsen","locid":"313d9ac1-283c-452d-af72-ab35e031b7aa","name":"Nielsen, Lars Bo","rank":6,"rolecode":"pau"},{"affno":"1","first":"Christina","key":"christoffersenpau","last":"Christoffersen","locid":"7f6ac9b3-a8ee-401d-8c45-dc0bf731314a","name":"Christoffersen, Christina","rank":7,"rolecode":"pau"},{"affno":"1","first":"Tanja Xenia","key":"pedersenpau","last":"Pedersen","locid":"78b12e4c-f5b0-433c-adae-ee24837bb372","name":"Pedersen, Tanja Xenia","rank":8,"rolecode":"pau"}],"pmid":["28866363"],"pub":{"doi":"10.1016/j.atherosclerosis.2017.08.005","issn":["00219150","15675688"],"issn_org":["00219150"],"journal":"Atherosclerosis","pages":"93-101","status":"p","title":"Atherosclerosis","volume":"265"},"review":"Peer Reviewed","scoID":["2-s2.0-85028546875"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-96f8e997-63b5-49cc-abc6-242486419db3"],"src":["KU University of Copenhagen"],"title":"Effects of apolipoprotein M in uremic atherosclerosis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-483663","year":"2017","yearsub":"2017"}
{"abstract":"Summary: Deficiency of apolipoprotein E (APOE) causes familial dysbetalipoproteinemia in humans resulting in a higher risk of atherosclerotic disease. In mice, APOE deficiency results in a severe atherosclerosis phenotype, but it is unknown to what extent this is unique to mice. In this study, APOE was targeted in Yucatan minipigs. APOE−/− minipigs displayed increased plasma cholesterol and accumulation of apolipoprotein B-48–containing chylomicron remnants on low-fat diet, which was significantly accentuated upon feeding a high-fat, high-cholesterol diet. APOE−/− minipigs displayed accelerated progressive atherosclerosis but not xanthoma formation. This indicates that remnant lipoproteinemia does not induce early lesions but is atherogenic in pre-existing atherosclerosis.","author_count":14,"contributors":["Shim, Jeong Tangkjær","Poulsen, Christian Bo","Hagensen, Mette K","Larsen, Torben","Heegaard, Peter M H","Christoffersen, Christina","Bolund, Lars","Schmidt, Mette","Liu, Ying","Li, Juan","Li, Rong","Callesen, Henrik","Bentzon, Jacob Fog","Sørensen, Charlotte Brandt"],"cuid":["S03-088.14-666129"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","Nanjing Agricultural University"],"keyword":["Apolipoprotein E","Atherosclerosis","Pig","Remnant cholesterol dysbetalipoproteinemia"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-AU","DI-U-DTU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-AU","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"apolipoprotein e deficiency increases remnant lipoproteins and accelerates progressive atherosclerosis but not xanthoma formation in gene modified minipigs","src":["au","dtu","ku"],"src-code":["DI-U-AU","DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.jacbts.2017.06.004","version":"Published Version"},"id":"S03-088.14-666129","identifier":[{"id":"85042148702","type":"scopus"},{"id":"PMC6058916","type":"pmcid"},{"id":"30062172","type":"pmid"}],"ids":["au-26f6d550-083e-470e-bc41-ac22fd927e38","dtu-f6640060-bc9d-450c-95a2-24901023646a","ku-90709418-18fb-4095-a438-4df8d102d6b5"],"keyword":["apolipoprotein E","atherosclerosis","pig","remnant cholesterol dysbetalipoproteinemia"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-6-E291E930820EDF2905DDD4B53374226B"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/192815019/1_s2.0_S2452302X17301444_main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.jacbts.2017.06.004","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/139329962/befo_1_s2.0_S2452302X17301444_main_oa.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://pure.au.dk/ws/files/120916817/1_s2.0_S2452302X17301444_main.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Cardiological Medicine B"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of De