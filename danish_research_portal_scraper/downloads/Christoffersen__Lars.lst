ey":"kassempau","last":"Kassem","locid":"1f5eec94-7307-4a11-ac12-00973bba7c01","name":"Kassem, Maher M.","rank":1,"rolecode":"pau"},{"affno":"1","first":"Lars B.","key":"christoffersenpau","last":"Christoffersen","name":"Christoffersen, Lars B.","rank":2,"rolecode":"pau"},{"affno":"","first":"Andrea","key":"cavallipau","last":"Cavalli","name":"Cavalli, Andrea","rank":3,"rolecode":"pau"},{"affno":"1","first":"Kresten","key":"lindorfflarsenpau","last":"Lindorff-Larsen","locid":"be20a4d8-92c4-44b9-9dfb-b6ad6471a58c","name":"Lindorff-Larsen, Kresten","orcid":"0000-0002-4750-6039","rank":4,"rolecode":"pau"}],"pmid":["30042380"],"pub":{"doi":"10.1038/s41598-018-29357-y","issn":["20452322"],"journal":"Scientific Reports","paperid":"11112","status":"p","title":"Scientific Reports","volume":"8"},"review":"Peer Reviewed","scoID":["2-s2.0-85050600409"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-e50f1cdc-e0ad-4348-aa36-dc1f79ed2025"],"src":["KU University of Copenhagen"],"title":"Enhancing coevolution-based contact prediction by imposing structural self-consistency of the contacts","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-530214","year":"2018","yearsub":"2018"}
{"abstract":"The low-density lipoprotein receptor (LDLR) and related proteins are important for the transport of diverse biomolecules across cell membranes and barriers. Their functions are especially relevant for cholesterol homeostasis and diseases, including neurodegenerative and kidney disorders. Members of the LDLR-related protein family share LDLR class A (LA) repeats providing binding properties for lipoproteins and other biomolecules. We previously demonstrated that short linker regions between these LA repeats contain conserved O-glycan-sites. Moreover, we found that O-glycan modifications at these sites are selectively controlled by the GalNAc-transferase isoform, GalNAc-T11. However, the effects of GalNAc-T11-mediated O-glycosylation on LDLR and related receptors localization and function are unknown. Here, we characterized O-glycosylation of LDLR-related proteins and identified conserved O-glycosylation sites in the LA linker regions of VLDLR, LRP1, and LRP2 (Megalin) from both cell lines and rat organs. Using a panel of gene-edited isogenic cell line models, we demonstrate that GalNAc-T11-mediated LDLR and VLDLR O-glycosylation is not required for transport and cell surface expression and stability of these receptors, but markedly enhances LDL and VLDL binding and uptake. Direct ELISA-based binding assays with truncated LDLR constructs revealed that O-glycosylation increased affinity for LDL by approximately 5-fold. The molecular basis for this observation is currently unknown, but these findings open up new avenues for exploring the roles of LDLR-related proteins in disease.","author_count":21,"contributors":["Wang, Shengjun","Mao, Yang","Narimatsu, Yoshiki","Ye, Zilu","Tian, Weihua","Goth, Christoffer K","Lira-Navarrete, Erandi","Pedersen, Nis Borbye","Benito-Vicente, Asier","Martin, Cesar","Uribe, Kepa B","Hurtado-Guerrero, Ramon","Christoffersen, Christina","Seidah, Nabil G","Nielsen, Rikke","Christensen, Erik Ilsø","Hansen, Lars","Bennett, Eric P","Vakhrushev, Sergey Y","Schjoldager, Katrine T","Clausen, Henrik"],"cuid":["S02-099.81-025487"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","Europe, EU","OECD"],"country":["Canada","Spain"],"glorg":["All Global Affiliations","McGill University","University of Zaragoza","University of the Basque Country"],"keyword":["Animals","CHO Cells","Cell Membrane metabolism","Cricetulus","Drosophila","Glycosylation","HEK293 Cells","Hep G2 Cells","Humans","Ligands","Lipoproteins metabolism","Low Density Lipoprotein Receptor Related Protein 2 metabolism","Polysaccharides metabolism","Protein Binding","Protein Transport","Rats","Recombinant Proteins metabolism"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"site specific o glycosylation of members of the low density lipoprotein receptor superfamily enhances ligand interactions","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"http://europepmc.org/Copyright","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC5949982/pdf/zbc7408.pdf","version":"Published Version"},"id":"S02-099.81-025487","identifier":[{"id":"PMC5949982","type":"pmcid"},{"id":"85046943651","type":"scopus"},{"id":"29559555","type":"pmid"}],"ids":["au-b005bc60-6ade-4672-93d9-dee0d329a220","ku-47e9a807-0532-4900-b742-54d6720a666a"],"keyword":["Acetylgalactosamine/metabolism","Animals","CHO Cells","Cell Membrane/metabolism","Cricetulus","Drosophila","Glycosylation","HEK293 Cells","Hep G2 Cells","Humans","Ligands","Lipoproteins/metabolism","Low Density Lipoprotein Receptor-Related Protein-1/metabolism","Low Density Lipoprotein Receptor-Related Protein-2/metabolism","Polysaccharides/metabolism","Protein Binding","Protein Transport","Rats","Receptors, LDL/metabolism","Recombinant Proteins/metabolism"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-ACE0D5585D8CB2CA8D07E37A66138DE3"],"oa_link":[{"access":"oa","license":"http://europepmc.org/Copyright","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC5949982/pdf/zbc7408.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Cellular and Molecular Medicine, Glycomics Program"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"es","key":"university of the basque country","loc":["Spain","Europe, EU","OECD"],"name":"University of the Basque Country","used":1},{"affno":"3","country":"es","key":"university of zaragoza","loc":["Spain","Europe, EU","OECD"],"name":"University of Zaragoza","used":1},{"affno":"4","country":"ca","key":"mcgill university","loc":["Canada","America, North","OECD"],"name":"McGill University","used":1},{"affno":"5","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Biomedicine, Department of Biomedicine - Forskning og uddannelse, Syd"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","first":"Shengjun","key":"wangpau","last":"Wang","locid":"826fa6be-c9c6-4905-b7fe-7f425e474401","name":"Wang, Shengjun","rank":1,"rolecode":"pau"},{"affno":"1","first":"Yang","key":"maopau","last":"Mao","locid":"d9dc26d0-d85