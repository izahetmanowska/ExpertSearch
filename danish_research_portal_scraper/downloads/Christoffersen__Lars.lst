{"abstract":"Der er alt for lidt viden om, hvilke indsatser mod mistrivsel blandt ældre der virker. For at sikre kvaliteten bør vi stræbe efter repræsentativ feedback.","author_count":2,"contributors":["Larsen, Lars","Christoffersen, Morten"],"cuid":["S01-000.00-728112"],"filters":{"added":"2024-05","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Larsen, Lars"],"level":"pop","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"und","rtype":["clu"],"sorti":"indsatsen mod mistrivsel blandt ældre mangler evidens","src":["au"],"src-code":["DI-U-AU"],"type":"doi","type-grp":["all","pub"]},"ft":{"access":"oa","text":"Undefined","type":"url","url":"https://seniormonitor.dk/nyheder/art9826696/Indsatsen-mod-mistrivsel-blandt-%C3%A6ldre-mangler-evidens","version":"Other Version"},"id":"S01-000.00-728112","ids":["au-a6994ec6-f404-4818-a56a-638a94a93921"],"lang":"Danish","level":"Popular","mra":["Social Science"],"noi":["Local-1-1-39393834F5B8CDEB528154C4B8AB7473"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus BSS, Department of Psychology and Behavioural Sciences"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Lars","key":"larsenpau","last":"Larsen","locid":"7bd13f67-d81b-40d2-a742-8115e7100ecb","name":"Larsen, Lars","orcid":"0000-0003-1603-0311","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Morten","key":"christoffersenpau","last":"Christoffersen","locid":"cc69f65a-9162-4ebe-8585-b2b3ac5f762d","name":"Christoffersen, Morten","orcid":"0000-0002-9423-4654","rank":2,"rolecode":"pau"}],"pub":{"