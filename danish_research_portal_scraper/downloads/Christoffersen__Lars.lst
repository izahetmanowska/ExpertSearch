{"author_count":4,"contributors":["Bartels, Emil D.","Bisgaard, Line S.","Christoffersen, Christina","Nielsen, Lars Bo"],"cuid":["S01-000.00-439567"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"effect of atrial natriuretic peptide on lipolysis in the mouse heart","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1097/XCE.0000000000000029","version":"Other Version"},"id":"S01-000.00-439567","identifier":[{"id":"84954359747","type":"scopus"}],"ids":["ku-4d61140a-ae76-45b5-ba00-d64eca22cdd9"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-657C065EAD2D3B8A9777D1B2ED694E0A"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1097/XCE.0000000000000029","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Emil Daniel","key":"bartelspau","last":"Bartels","locid":"93bf9a38-d3f8-45fd-8c88-ab365982b098","name":"Bartels, Emil D.","name_org":"Bartels, Emil Daniel","rank":1,"rolecode":"pau"},{"affno":"1","first":"Line Stattau","key":"bisgaardpau","last":"Bisgaard","locid":"c48b305c-876a-4495-b193-fd110718aeb3","name":"Bisgaard, Line S.","name_org":"Bisgaard, Line Stattau","rank":2,"rolec