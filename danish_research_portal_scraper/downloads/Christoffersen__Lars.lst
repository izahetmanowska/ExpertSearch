ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Biology, Freshwater Biology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Lars Holst","key":"hansenlarsholstpau","last":"Hansen","locid":"0e7caaad-fc9e-4d11-8a52-1f7b66d25a3f","name":"Hansen, Lars Holst","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jannik","key":"hansenjannikpau","last":"Hansen","locid":"79118b63-252c-4b06-9ebf-87443212e7b3","name":"Hansen, Jannik","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Palle Smedegaard","key":"nielsenpallesmedegaardpau","last":"Nielsen","locid":"60e8ea46-e250-4d8d-958c-5ad5baecac5e","name":"Nielsen, Palle Smedegaard","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jakob","key":"humaidanjakobpau","last":"Humaidan","locid":"7bb75272-3b5b-4338-8c0a-1101d1dc3994","name":"Humaidan, Jakob","rank":4,"rolecode":"pau"},{"affno":"2","first":"Kirsten Seestern","key":"christoffersenkirstenseesternpau","last":"Christoffersen","locid":"d383ac29-2ae6-403f-a208-2a49d496724e","name":"Christoffersen, Kirsten Seestern","orcid":"0000-0002-3324-1017","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Niels Martin","key":"schmidtnielsmartinpau","last":"Schmidt","locid":"b91704ca-e126-4c35-af20-95b2269d230a","name":"Schmidt, Niels Martin","orcid":"0000-0002-4166-6218","rank":6,"rolecode":"pau"},{"affno":"","first":"Lillian Magelund","key":"jensenlillianmagelundpedh","last":"Jensen","name":"Jensen, Lillian Magelund","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Torben Røjle","key":"christensentorbenrøjlepedh","last":"Christensen","name":"Christensen, Torben Røjle","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Niels Martin","key":"schmidtnielsmartinpedh","last":"Schmidt","name":"Schmidt, Niels Martin","rank":9,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"eisbn":["9788793129221"],"isbn":["9788793129221"],"pages":"39-65","publisher":"Aarhus University, DCE - Danish Centre for Environment and Energy","publisher_org":"Aarhus University, DCE – Danish Centre for Environment and Energy","status":"p","subtitle":"19<sup>th</sup> Annual Report 2013","title":"Zackenberg Ecological Research Operations"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-8c41dd3d-56bf-4675-9464-7e3ad9564aa5","ku-adac3c09-15fa-409b-8cd3-987dc4626166"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Zackenberg Basic : The BioBasis programme","type":"Report Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-091.28-022892","year":"2014","yearsub":"2014"}
{"abstract":"Obesity is an increasing problem worldwide leading to cardiovascular morbidity. Only limited information exists on the transcriptional regulation of arterial K+ and Ca2+ channels in obesity. We quantified, by real-time PCR, mRNA expression of K+ channels and L-type Ca2+ channels (LTCC) in small mesenteric (MA), middle cerebral (MCA), and left coronary arteries (LCA) of lean vs. obese rats and minipigs. Male Sprague Dawley rats were fed a high-fat (FAT; N=5), high-fructose (FRUC; N=7), high-fat/high-fructose (FAT/FRUC; N=7) or standard diet (STD; N=7-11) for 28 Weeks. FAT and FAT/FRUC became obese, whereas FRUC and STD were lean. Systolic blood pressure (SBP) averaged over 14 weeks was increased (P<0.001) in FRUC and FAT/FRUC but not in FAT. Kir, Kv1.2, Kv1.5, and Kv7.4 channels were up-regulated in FAT, whereas SKca and IKca channels were down-regulated in FAT/FRUC (P<0.05). There were no transcriptional changes in FRUC. Castrated male Göttingen minipigs with or without diabetes were fed a diet rich in fat, cholesterol and fructose (OB+DIAB; N=3 vs. OB; N=2, respectively) or a standard diet (STD; N=3) for 22-45 weeks. Body weight, total body fat content and plasma triglyceride levels were increased in OB and OB+DIAB. BKca, IKca, SKca and/or LTCC mRNA was up-regulated in LCA from OB and OB+DIAB (n.s.). Expression of BKca mRNA was increased, whereas IKca mRNA decreased in MCA from OB (n.s.). SKca mRNA was decreased in MA from OB (n.s.). Diet-induced obesity in rats and minipigs lead to complex changes in K+ and Ca2+ channel gene expression, which, in rats, did not seem to be linked with changes in SBP. These transcriptional changes may lead to disturbances in microvascular flow patterns in obesity.","author_count":8,"contributors":["Jensen, Lars Jørn","Salomonsson, Max","Sørensen, Charlotte Mehlin","von Holstein-Rathlou, Niels-Henrik","Pedersen, Henrik Duelund","Christoffersen, Berit Ø.","Olsen, Lisbeth Høier","Ludvigsen, Trine Pagh"],"cuid":["S01-000.00-469607"],"event":{"end":"2014-04-30","place":"San Diego, us","start":"2014-04-26","title":"Experimental Biology","year":"2014"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Arteries","Calcium Channels","Faculty of Health and Medical Sciences","Gene expression","Metabolic syndrome","Obesity","Pig","Potassium Channels","Rat"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-NOVO"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-PR-NOVO","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"potassium and calcium channel gene expression in small arteries in porcine and rat models of diet induced obesity poster","src":["ku"],"src-code":["DI-U-KU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-469607","ids":["ku-7f38bc03-3592-4d9d-9c4b-b8b3458bd492"],"keyword":["Arteries","Calcium Channels","Faculty of Health and Medical Sciences","Gene expression","Obesity","Pig","Potassium Channels","Rat","metabolic syndrome"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-D42FAB5797D481B75D6B2CAE80B7C25D"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary Clinical Sciences, IKVH Fysiologi og ernæring samt pelsdyrfarmen","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary Clinical Sciences, Physiology and Nutrition"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"novo nordisk","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-NOVO","l3nl":"Novo Nordisk","l3nn":"Novo Nordisk","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Novo Nordisk","namevar":["Novo Nordisk"],"nora_code":"DI-PR-NOVO","used":1}],"person":[{"affno":"1","country":"dk","first":"Lars Jørn","key":"jensenpau","last":"Jensen","locid":"8de80477-3346-487d-bf10-bfc8e7890e42","name":"Jensen, Lars Jørn","orcid":"0000-0003-4559-7456","rank":1,"rolecode":"pau"},{"affno":"1","first":"Max","key":"salomonssonpau","last":"Salomonsson","locid":"6345866b-4d40-4659-8017-9d8d90e674af","name":"Salomonsson, Max","rank":2,"rolecode":"pau"},{"affno":"1","first":"Charlotte Mehlin","key":"sørensenpau","last":"Sørensen","locid":"0ceca69d-e5cd-43dc-9995-305ac5855c4f","name":"Sørensen, Charlotte Mehlin","orcid":"0000-0002-9984-3125","rank":3,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Niels-Henrik","key":"vonholsteinrathloupau","last":"von Holstein-Rathlou","locid":"6476af94-cb91-43db-bc71-5f81cd3d5827","name":"von Holstein-Rathlou, Niels-Henrik","rank":4,"rolecode":"pau"},{"affno":"2","first":"Henrik Duelund","key":"pedersenpau","last":"Pedersen","name":"Pedersen, Henrik Duelund","rank":5,"rolecode":"pau"},{"affno":"2","first":"Berit Ø.","key":"christoffersenpau","last":"Christoffersen","name":"Christoffersen, Berit Ø.","rank":6,"rolecode":"pau"},{"affno":"1","first":"Lisbeth Høier","key":"olsenpau","last":"Olsen","locid":"a30ce7a9-ef18-475f-a860-819856d64d5a","name":"Olsen, Lisbeth Høier","rank":7,"rolecode":"pau"},{"affno":"1","first":"Trine Pagh","key":"ludvigsenpau","last":"Ludvigsen","locid":"5128ee0a-dc88-4267-af6f-99a0d6ec8011","name":"Ludvigsen, Trine Pagh","rank":8,"rolecode":"pau"}],"pub":{"doi":"10.1096/fj.1530-6860","issn":["08926638","15306860"],"issn_org":["08926638"],"issue":"Supplement 1","journal":"FASEB Journal","paperid":"676.4","status":"p","title":"FASEB Journal","title_org":"FASEB journal : official publication of the Federation of American Societies for Experimental Biology","volume":"28"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Novo Nordisk","Private Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-7f38bc03-3592-4d9d-9c4b-b8b3458bd492"],"src":["KU University of Copenhagen"],"title":"Potassium and calcium channel gene expression in small arteries in porcine and rat models of diet-induced obesity (Poster)","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-469607","year":"2014","yearsub":"2014"}
{"abstract":"INTRODUCTION: Uncomplicated urinary tract infection (uUTI) is a common reason for seeing a GP. In Denmark, it is debated if sulfamethizole or pivmecillinam should be recommended for empirical treatment of uUTIs. We evaluated sulfamethizole and pivmecillinam use in the five Danish regions from 2007 to 2011 and explored if the choice of antibiotic in primary care was in accordance with the regional recommendations for uUTI. MATERIAL AND METHODS: Regional drug use data on pivmecillinam and sulfamethizole from 2007 to 2011 were retrieved from the Registry of Medicinal Product Statistics. Regional recommendations from the same period were identified. We calculated differences in consumption based on defined daily doses per 1,000 inhabitants per day (DID) of pivmecillinam and sulfamethizole between the five regions, and intraregional developments. RESULTS: Four regions had recommendations on uUTI in 2011. From 2007 to 2009, sulfamethizole was the only antibiotic recommended. Pivmecillinam was recommended along with sulfametizole in one of four regions from 2010, which increased to two regions in 2011. During the five-year period, sulfamethizole consumption decreased in all regions. The absolute decrease ranged from 0.4 to 0.6 DID. Pivmecillinam consumption increased steadily; the absolute increase ranged from 1.5 to 2.5 DID. During the whole period, the total pivmecillinam consumption was higher than the total sulfamethizole consumption. CONCLUSION: Pivmecillinam dominated the treatment of uUTIs, whereas sulfamethizole prevailed in the regional recommendations, which suggests a lack of adherence to regional recommendations.","author_count":3,"contributors":["Christoffersen, Thea","Bjerrum, Lars","Nielsen, Anni Brit Sternhagen"],"cuid":["S01-000.00-515722"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Denmark","Faculty of Health and Medical Sciences","General Practitioners","Guidelines","Regional differences","Urinary tract infections"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"general practitioners do not systematically adhere to regional recommendations on treatment of uncomplicated urinary tract infections","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://www.danmedj.dk/portal/pls/portal/!PORTAL.wwpob_page.show?_docname=10545214.PDF","version":"Other Version"},"id":"S01-000.00-515722","identifier":[{"id":"84897471317","type":"scopus"}],"ids":["ku-ccbd67a6-6920-419c-bbda-f2f793814d6d"],"keyword":["Denmark","Faculty of Health and Medical Sciences","General Practitioners","Guidelines","Urinary Tract Infections","regional differences"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-B25D0FD5C2BC5C6D3E1103F3F5E41A64"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.danmedj.dk/portal/pls/portal/!PORTAL.wwpob_page.show?_docname=10545214.PDF","version":"Other Version"}],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Thea","key":"christoffersenpau","last":"Christoffersen","name":"Christoffersen, Thea","rank":1,"rolecode":"pau"},{"affno":"1","first":"Lars","key":"bjerrumpau","last":"Bjerrum","locid":"9af66257-2db2-4b59-9393-347dc5b208b5","name":"Bjerrum, Lars","orcid":"0000-0003-0969-0063","rank":2,"rolecode":"pau"},{"affno":"1","first":"Anni Brit Sternhagen","key":"nielsenpau","last":"Nielsen","locid":"4c1b4dc2-3038-414c-8984-1315bad69dbd","name":"Nielsen, Anni Brit Sternhagen","rank":3,"rolecode":"pau"}],"pub":{"issn":["00415782","13994174"],"issue":"4","journal":"Ugeskrift for Læger","pages":"1-5","paperid":"A4814","status":"p","title":"Ugeskrift for Læger","title_org":"Danish Medical Journal","volume":"61"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-ccbd67a6-6920-419c-bbda-f2f793814d6d"],"src":["KU University of Copenhagen"],"title":"General practitioners do not systematically adhere to regional recommendations on treatment of uncomplicated urinary tract infections","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-515722","year":"2014","yearsub":"2014"}
{"abstract":"The high arctic is undergoing a faster change in climate than most other regions of the planet, with already observed ecological consequences. Combined with the characteristics of high-arctic ecosystems, such as low species redundancy, high seasonality and weather extremes, shifts in individual species performance and phenology may lead to altered interaction dynamics through trophic mismatch and cascades. An ecosystem approach is therefore desirable in the attempt to understand the multidimensional impacts of climate. Here, we present ecosystem-wide trend analyses of a long-term dataset on terrestrial and limnic biota with focus on the distribution of observed trends and associated variation across the ecosystem. We used 114 time series drawn from 11 abiotic variables, 19 terrestrial and 7 limnic biotic species/taxa and compared temporal trends, changes and abrupt shifts in the variation within and across the two biota. A total of 36 % of the time series analysed showed a significant trend during the study period with a higher frequency of trends occurring within performance variables. Overall, the changes tended to be negative, indicating advances in phenology but reduced species performance. General system variance was also higher in the limnic biota than in the terrestrial biota, both exhibiting increasing variance up through the trophic system. Overall, our results suggest that multiple biotic responses to the climatic changes in this high-arctic ecosystem are not synchronised across trophic levels and may differ qualitatively and quantitatively between terrestrial and limnic biota.","author_count":6,"contributors":["Mortensen, Lars O.","Jeppesen, Erik","Schmidt, Niels Martin","Christoffersen, K.S.","Tamstorf, Mikkel P.","Forchhammer, Mads C."],"cuid":["S02-097.06-029314"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Arctic ecosystems","Greenland","Temporal trends","Temporal variance","Trophic interactions","Zackenberg"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Institut for Bioscience - Sø-økologi"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-UND"]},"level3all":["DI-U-AU","DI-U-KU","DI-U-UND","Institut for Bioscience - Sø-økologi"]},"review":"pr","rtype":["clu"],"sorti":"temporal trends and variability in a high arctic ecosystem in greenland multidimensional analyses of limnic and terrestrial ecosystems","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s00300-014-1501-2","version":"Other Version"},"id":"S02-097.06-029314","identifier":[{"id":"84956718422","type":"scopus"},{"id":"000341378000002","type":"wos"},{"id":"84897363058","type":"scopus"}],"ids":["au-e5baa414-21c8-48b6-b767-c63e7be0e8e9","ku-00d226b7-d828-4d96-b7df-6154622b70de"],"keyword":["Arctic ecosystems","Greenland","Zackenberg","temporal trends","temporal variance","trophic interactions"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-6817E38BADFF770D3778FE4CDBA16E67"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s00300-014-1501-2","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Ecoscience, Department of Ecoscience - Arctic Ecosystem Ecology"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Institut for Bioscience - Sø-økologi"],"nora_code":"DI-OT","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Biology, Freshwater Biology"],"nora_code":"DI-U-KU","used":1},{"affno":"4","country":"dk","key":"unclear universities","l2":"DI-U","l2n":"Universities","l3":"DI-U-UND","l3nl":"Undetermined","l3nn":"Unclear Universities","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Unclear Universities","namevar":["Afdeling for Arktisk Miljø"],"nora_code":"DI-U-UND","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lars O.","key":"mortensenpau","last":"Mortensen","locid":"3b3a2615-35e3-49fc-aea5-0ad8dc7ed2f1","name":"Mortensen, Lars O.","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Erik","key":"jeppesenpau","last":"Jeppesen","locid":"22bb5d6e-a9ae-4f70-81da-df1c57e71163","name":"Jeppesen, Erik","rank":2,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Niels Martin","key":"schmidtpau","last":"Schmidt","locid":"b91704ca-e126-4c35-af20-95b2269d230a","name":"Schmidt, Niels Martin","orcid":"0000-0002-4166-6218","rank":3,"rolecode":"pau"},{"affno":"3","first":"Kirsten Seestern","key":"christoffersenpau","last":"Christoffersen","locid":"d383ac29-2ae6-403f-a208-2a49d496724e","name":"Christoffersen, Kirsten Seestern","orcid":"0000-0002-3324-1017","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mikkel P.","key":"tamstorfpau","last":"Tamstorf","locid":"3115cc60-a12c-476f-95dc-b1de476188a5","name":"Tamstorf, Mikkel P.","orcid":"0000-0002-2811-331X","rank":5,"rolecode":"pau"},{"affno":"1 4","corresponding":null,"