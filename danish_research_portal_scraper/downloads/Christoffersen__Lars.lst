{"author_count":5,"contributors":["Bisgaard, Line S.","Christensen, Pernille M.","Fuchtbauer, Ernst-Martin","Nielsen, Lars Bo","Christoffersen, Christina"],"cuid":["S01-000.00-427584"],"event":{"end":"2021-06-08","start":"2021-06-05","title":"58th Congress of the European-Renal-Association (ERA)-European-Dialysis-and-Transplant-Association (EDTA)","year":"2021"},"filters":{"added":"2022-03","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"nr","rtype":["clu"],"sorti":"kidney derived apom and its role in acute kidney injury","src":["ku"],"src-code":["DI-U-KU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-427584","identifier":[{"id":"000713465600184","type":"wos"}],"ids":["ku-39625674-2184-42d7-8685-8171bd4c91bd"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-F379D1228BCD57B3A0BB972569447171"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Biomedical Sciences, Physiology of circulation, kidney and lung"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Line Stattau","key":"bisgaardpau","last":"Bisgaard","locid":"c48b305c-876a-4495-b193-fd110718aeb3","name":"Bisgaard, Line S.","name_org":"Bisgaard, Line Stattau","rank":1,"rolecode":"pau"},{"affno":"","first":"Pernille M.","key":"christensenpau","last":"Christensen","name":"Christensen, Pernille M.","rank":2,"rolecode":"pau"},{"affno":"","first":"Ernst-Martin","key":"fuchtbauerpau","last":"Fuchtbauer","name":"Fuchtbauer, Ernst-Martin","rank"