nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Morten","key":"christoffersenpau","last":"Christoffersen","locid":"cc69f65a-9162-4ebe-8585-b2b3ac5f762d","name":"Christoffersen, Morten","orcid":"0000-0002-9423-4654","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars","key":"larsenpau","last":"Larsen","locid":"7bd13f67-d81b-40d2-a742-8115e7100ecb","name":"Larsen, Lars","orcid":"0000-0003-1603-0311","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Anna","key":"pacakvedelpau","last":"Pacak-Vedel","locid":"d8fd51ea-997c-44e6-a354-19753b7fc7ff","name":"Pacak-Vedel, Anna","orcid":"0000-0001-6789-8992","rank":3,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["In Press","Published"]},"sid":["aau-0431305e-f14c-401f-abb3-5f215ae4846d","au-c6b2ec8c-7d3e-4aca-b2eb-efffacc66784"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Individual differences in deprivation patterns using open access data","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-096.15-822223","year":"2025","yearsub":"2025"}
{"abstract":"Parent-child relationships are among the most important social connections throughout life. Estrangement from one or more children has been shown to evoke feelings of sorrow for parents as they move closer to the end of life. Yet family estrangement in older age has not garnered much attention in the scientific literature, and associations with mental health remain unresolved. The purpose of the present study was to examine the association between mental health and estrangement from adult children for older parents on dimensions of well-being, sense of purpose, depression, and loneliness. Survey data were collected from older parents (aged 75+) with estrangement to at least one child (n = 75) and a corresponding comparison group of older parents (n = 196). Data included measurements of well-being (WHO-5), sense of purpose (PIL-SF), depressive symptoms (CMDQ), and loneliness (UCLA-3). Statistical analyses using multiple linear regression were conducted for each measurement to test for associations with intergenerational estrangement. Intergenerational estrangement was found to be statistically significantly associated with poorer mental health scores on all four measurements. The study is the first to document multiple, specific, negative psychological and social associations with intergenerational estrangement for older parents. The study argues for the potential benefits of family work in efforts to promote mental health in older age.","author_count":5,"contributors":["Nikolajsen, Andreas Tranberg","Larsen, Lars","Christoffersen, Morten","Holstein, Bjørn E.","Swane, Christine"],"cuid":["S02-100.00-813652"],"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"corresponding_author":["Nikolajsen, Andreas","Nikolajsen, Andreas Tranberg"],"keyword":["Aging","Depression","Family conflict","Loneliness","Mental health","Parent child relationship","Well being","intergenerational estrangement","sense of purpose"],"level":"sci","mra":["med","soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Ensomme Gamles Vørn (EGV)"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"estrangement between older parents and adult children associations with mental health","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Kun læseadgang","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/290236133/EstrangementMain_document.pdf","version":"Authors Final Version"},"id":"S02-100.00-813652","identifier":[{"id":"105002028304","type":"scopus"}],"ids":["au-606d5c8d-bbc7-498d-9c96-029de42ee531","sdu-d837c5c9-ebd2-4660-a694-d8ec42790692"],"keyword":["Family conflict","aging","depression","intergenerational estrangement","loneliness","mental health","parent-child relationship","sense of purpose","well-being"],"lang":"English","level":"Scientific","mra":["Medical Science","Social Science"],"noi":["Global-Local-2-5-0818164E68268AD8B841B182EA982F74"],"oa_link":[{"access":"oa","license":"Kun læseadgang","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/290236133/EstrangementMain_document.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus BSS, Department of Psychology and Behavioural Sciences"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Ensomme Gamles Vørn (EGV)"],"nora_code":"DI-OT","used":1},{"affno":"3","k