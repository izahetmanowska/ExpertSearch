{"author_count":3,"contributors":["Boll, Karen"],"cuid":["S01-000.00-281747"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"pr","rtype":["clu"],"sorti":"decentring regulation tax fraud and the cleaning sector","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-281747","ids":["cbs-430f4c05-5805-4c80-8e42-6bdd94aa3bf4"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-2-12B2EFD4D4E36BD550C8F407E2DB7491"],"org":[{"affno":"1","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Organization"],"nora_code":"DI-U-CBS","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Karen","key":"bollpau","last":"Boll","locid":"ea9574f1-23ef-4b7a-956c-dafe20986b54","name":"Boll, Karen","orcid":"0000-0001-9497-4372","rank":1,"rolecode":"pau"},{"affno":"","first":"R. A. W.","key":"rhodespedh","last":"Rhodes","name":"Rhodes, R. A. W.","rank":2,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Mark","key":"bevirpedh","last":"Bevir","name":"Bevir, Mark","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"eisbn":["9781315712949"],"isbn":["9781138889354"],"pages":"179-197","place":"Abingdon","publisher":"Routledge","series":"Routledge Studies in Governance and Public Policy","status":"p","subtitle":"Ruling, Rationalities and Resistance","title":"Rethinking Governance"},"review":"Peer Reviewed","scoID":["2-s2.0-84978456476"],"search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["cbs-430f4c05-5805-4c80-8e42-6bdd94aa3bf4"],"src":["CBS Copenhagen Business School"],"title":"Decentring Regulation : Tax Fraud and the Cleaning Sector","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-281747","year":"2016","yearsub":"2016"}
{"abstract":"This paper investigates the Swedish tax authority’s (Skatteverkets) compliance initiative called Preventing Financial Crime. In Sweden tax evasion related to organised moon-lighting is defined as a major risk to the revenue collection and to the legitimacy of Skatteverket. The traditional approach to abating such tax evasion has been reformed and a new mix-method approach adopted. This approach combines a proactive strategy—Preventing Financial Crime—with a reactive inspection strategy. During one a month of intensive fieldwork in Sweden, I studied the daily work in Preventing Financial Crime. Based on this, the paper shows that the Swedish tax officials seek to motivate large construction contractors and municipalities to take preventive measures in relation to their sub-contractors to avoid and abate tax evasion. The paper shows the challenges in engaging and involving these external stakeholders in the preventive work as there is no legal base to support the preventive measures. All the preventive work must be organised on a voluntary basis. This requires exceptional persuasive abilities on the side of the tax officials as they need to get their agenda on top of the external partners’ agenda. The analysis has implications for how tax authorities (and other state authorities) reform their coercive regulation. If they decide to pursue a voluntary based approach where the actions of external partners play a central role, then the analysis helps to show some of the implied challenges and potentials.","author_count":1,"contributors":["Boll, Karen"],"cuid":["S01-000.00-279497"],"event":{"end":"2016-08-26","place":"Bristol , gb","start":"2016-08-24","title":"The 11th Annual Ethnography Symposium","year":"2016"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"nr","rtype":["clu"],"sorti":"preventing financial crime entrepreneurial regulation in action","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-279497","ids":["cbs-2b90b419-4b60-4099-84b0-f4c066b4c2cb"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-95D55F0C0197CCC1A090EB8B1C152560"],"org":[{"affno":"1","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Organization"],"nora_code":"DI-U-CBS","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Karen","key":"bollpau","last":"Boll","locid":"ea9574f1-23ef-4b7a-956c-dafe20986b54","name":"Boll, Karen","orcid":"0000-0001-9497-4372","rank":1,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["cbs-2b90b419-4b60-4099-84b0-f4c066b4c2cb"],"src":["CBS Copenhagen Business School"],"title":"Preventing Financial Crime : ‘Entrepreneurial’ Regulation in Action?","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-279497","year":"2016","yearsub":"2016"}
{"abstract":"This article shows a new form of regulation within a tax administration where tax administrators abate tax evasion by nudging and motivating consumers to only purchase services from tax compliant businesses. This indirectly closes or forces tax evading businesses to change their practices, because their customer bases decline to commercially non-viable levels. The analysis is framed by public governance literature and argues that the regulation is an example of collaborative or interactive governance, because the tax administrators do not regulate non-compliance directly, but activate external stakeholders, i.e. the consumers, in the regulatory craft. The study is based on a qualitative methodology and draws on a unique case of regulation in the cleaning sector. This sector is at high risk of tax evasion and human exploitation of vulnerable workers operating in the informal economy. The article has implications for how tax practitioners think about collaborative and interactive regulatory initiatives. While the tax administration in the study sees the approach as effective, the analysis shows that there are a number of caveats in relation to regularity, public listing, costs and revenue focus. The article thus links a concrete case of new regulation in tax administration to broader theoretical discussions of collaboration and interactive governance within public administration, and the article problematizes this regulation. This provides a vantage point from which constructive dialogue about new regulatory practice can emerge.","author_count":1,"contributors":["Boll, Karen"],"cuid":["S01-000.00-287888"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"pr","rtype":["clu"],"sorti":"collaborative tax regulation can consumers be engaged as partners in the regulatory craft","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://research-api.cbs.dk/ws/files/46434568/karen_boll_collaborative_tax_regulation_publishersversion.pdf","version":"Published Version"},"id":"S01-000.00-287888","ids":["cbs-831fcfc9-afda-4381-80e5-b9f4ac1089d9"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-9C22B9A04D1D527CB215A54655A155C2"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"http://jota.website/article/view/104/72","version":"Published Version"},{"access":"oa","type":"loc","url":"https://research-api.cbs.dk/ws/files/46434568/karen_boll_collaborative_tax_regulation_publishersversion.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Organization"],"nora_code":"DI-U-CBS","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Karen","key":"bollpau","last":"Boll","locid":"ea9574f1-23ef-4b7a-956c-dafe20986b54","name":"Boll, Karen","orcid":"0000-0001-9497-4372","rank":1,"rolecode":"pau"}],"pub":{"issn":["2059190X"],"issue":"2","journal":"Journal of Tax Administration","pages":"4-23","publisher":"Tax Administration Research Centre, University of Exeter Business School, United Kingdom","status":"p","title":"Journal of Tax Administration","volume":"2"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["cbs-831fcfc9-afda-4381-80e5-b9f4ac1089d9"],"src":["CBS Copenhagen Business School"],"title":"Collaborative Tax Regulation : Can Consumers be Engaged as Partners in the Regulatory Craft?","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-287888","year":"2016","yearsub":"2016"}
{"abstract":"This article discusses proactive public disclosure of taxpayer information and how this may form a new strategy for securing tax compliance by tax administrators. It reports a case study from the Danish Customs and Tax Administration in which consumers of services–over a short period of time–were informed about businesses’ lack of value-added tax (VAT) registration. Our approach to the case is twofold: First, the article lays out a legal analysis of the disclosure practice, and second, the article presents an organizational analysis of why the practice was initiated. The analyses show that using proactive public disclosure is compatible with the Duty of Confidentiality, but incompatible with Good Public Governance. Furthermore, the analyses show that there are a number of strong organizational rationales for using proactive public disclosure, despite its apparent incompatibility with Good Public Governance. The article is innovative in that it combines a legal and organizational approach to analyse a new regulatory strategy within tax administration.","author_count":2,"contributors":["Boll, Karen","Tell, Michael"],"cuid":["S01-000.00-285001"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Organization","Public disclosure","Public law","Tax administration","Tax compliance"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"pr","rtype":["clu"],"sorti":"proactive public disclosure a new regulatory strategy for creating tax compliance","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1515/ntaxj-2015-0009","version":"Published Version"},"id":"S01-000.00-285001","ids":["cbs-6457a82c-81a5-4727-9168-7e8ba60dc88a"],"keyword":["Organization","Public disclosure","Public law","Tax administration","Tax compliance"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-3-4E45F675B2525FB76169CB983DFACF13"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1515/ntaxj-2015-0009","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://research-api.cbs.dk/ws/files/44451364/karen_boll_proactive_public_disclosure_publishersversion.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Social Science (SOC)"],"yearPub":"2015","yearSub":"2016"},"org":[{"affno":"1","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Organization"],"nora_code":"DI-U-CBS","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Karen","key":"bollpau","last":"Boll","locid":"ea9574f1-23ef-4b7a-956c-dafe20986b54","name":"Boll, Karen","orcid":"0000-0001-9497-4372","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Michael","key":"tellpau","last":"Tell","locid":"beec3714-a522-4f4e-bc4a-c6f006cf8453","name":"Tell, Michael","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1515/ntaxj-2015-0009","issn":["22461809"],"issue":"2","journal":"Nordic Tax Journal","pages":"36-46","publisher":"De Gruyter","status":"p","title":"Nordic Tax Journal","volume":"2015"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["cbs-6457a82c-81a5-4727-9168-7e8ba60dc88a"],"src":["CBS Copenhagen Business School"],"title":"Proactive Public Disclosure : A New Regulatory Strategy for Creating Tax Compliance?","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-285001","year":"2015","yearsub":"2016"}
{"abstract":"Guest editorial.","author_count":2,"contributors":["Boll, Karen","Rhodes, Roderick A. W."],"cuid":["S01-000.00-294845"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of Southampton"],"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"pr","rtype":["clu"],"sorti":"excursions in administrative ethnography","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dje","type-grp":["all","pub"]},"id":"S01-000.00-294845","ids":["cbs-cc6a74f5-2386-4300-8c3f-6bb02a14a76b"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-2-912736F6986C47C9C1234EED4712293F"],"org":[{"affno":"1","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Organization"],"nora_code":"DI-U-CBS","used":1},{"affno":"2","country":"gb","key":"university of southampton","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Southampton","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Karen","key":"bollpau","last":"Boll","locid":"ea9574f1-23ef-4b7a-956c-dafe20986b54","name":"Boll, Karen","orcid":"0000-0001-9497-4372","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Roderick A. W.","key":"rhodespau","last":"Rhodes","name":"Rhodes, Roderick A. W.","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1108/joe-05-2015-0013","issn":["20466749"],"issue":"2","journal":"Journal of Organizational Ethnography","publisher":"Emerald Group Publishing","status":"p","title":"Journal of Organizational Ethnography","volume":"4"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["cbs-cc6a74f5-2386-4300-8c3f-6bb02a14a76b"],"src":["CBS Copenhagen Business School"],"title":"Excursions in Administrative Ethnography","type":"Editorial","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-294845","year":"2015","yearsub":"2015"}
{"abstract":"Purpose – The purpose of this paper is to analyse everyday reasoning in public administration. This is done by focusing on front line tax inspectors’ decisions about tax evasion. Design/methodology/approach – The paper presents ethnography of bureaucracy and field audits. The material stems from fieldwork conducted in the Central Customs and Tax Administration. Findings – The paper shows that the tax inspectors reason about tax evasion in a casuistic manner. They pay attention to similar cases and to particular circumstances of the individual cases. In deciding on tax evasion, the inspectors do not just administer the laws; they also enact a policy of fair-mindedness. Doing this they are constrained by time and man-powers, but also enabled by various organizational devices. Research limitations/implications – The tax inspectors that the author followed were carefully chosen and acted in accordance with procedures. The ethnography should be understood in relation to this set-up. Originality/value – The originality of the paper is that it shows that ethnography can open the territory of everyday reasoning in public administration. Also, it shows the discretionary room that any front line tax inspector navigates in. This is significant as revenue collection often is described as formal and dominated by a legal steering in which rules are univocal.","author_count":1,"contributors":["Boll, Karen"],"cuid":["S01-000.00-298379"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"1 contributor","cluster_size":1,"keyword":["Discretion","Ethnography","Professional ethics","Public administration","Tax evasion"],"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"pr","rtype":["clu"],"sorti":"deciding on tax evasion front line discretion and constraints","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-298379","identifier":[{"id":"84958525509","type":"scopus"}],"ids":["cbs-f0fe0cc3-9e28-425b-94e3-dcdff70a87db"],"keyword":["Discretion","Ethnography","Everyday reasoning","Professional ethics","Public administration","Tax evasion"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-4-C68375D9E3B2CBEF360F587116D9A9BD"],"oai":{"class":"Unused","mra":["Social Science (SOC)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Organization"],"nora_code":"DI-U-CBS","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Karen","key":"bollpau","last":"Boll","locid":"ea9574f1-23ef-4b7a-956c-dafe20986b54","name":"Boll, Karen","orcid":"0000-0001-9497-4372","rank":1,"rolecode":"pau"}],"pub":{"doi":"10.1108/joe-07-2014-0018","issn":["20466749"],"issue":"2","journal":"Journal of Organizational Ethnography","pages":"193-207","publisher":"Emerald Group Publishing","status":"p","title":"Journal of Organizational Ethnography","volume":"4"},"review":"Peer Reviewed","scoID":["2-s2.0-84958525509"],"search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["cbs-f0fe0cc3-9e28-425b-94e3-dcdff70a87db"],"src":["CBS Copenhagen Business School"],"title":"Deciding on Tax Evasion : Front Line Discretion and Constraints","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-298379","year":"2015","yearsub":"2015"}
{"abstract":"Within the public sector, many institutions are either steered by governance by targets or result-based governance. The former sets up quantitative internal production targets, while the latter advocates that production is planned according to outcomes which are defined as institution-produced effects on individuals or businesses in society; effects which are often produced by ‘nudging’ the citizenry in a certain direction. With point of departure in these two governance-systems, the paper explores a case of controversial inspection of businesses’ negative VAT accounts and it describes the performance measure that guides the inspectors’ inspection (or nudging) of the businesses. The analysis shows that although a result-based governance system is advocated on a strategic level, performance measures which are not ‘result-based’ are developed and used in the daily coordination of work. The paper explores how and why this state of affairs appears and problematizes the widespread use of result-based governance and nudging-techniques by public sector institutions.","author_count":1,"contributors":["Boll, Karen"],"cuid":["S01-000.00-287887"],"event":{"end":"2014-07-19","place":"Yokohama, jp","start":"2014-07-13","title":"XVIII ISA World Congress of Sociology 2014","year":"2014"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"pr","rtype":["clu"],"sorti":"result based public governance challenges in developing and using daily performance measures","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-287887","ids":["cbs-831d6e48-b221-4d9f-b29b-1df4c0e24097"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-3C1182BEA49B74FD0E699FB1EF8B2768"],"org":[{"affno":"1","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Organization"],"nora_code":"DI-U-CBS","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Karen","key":"bollpau","last":"Boll","locid":"ea9574f1-23ef-4b7a-956c-dafe20986b54","name":"Boll, Karen","orcid":"0000-0001-9497-4372","rank":1,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["cbs-831d6e48-b221-4d9f-b29b-1df4c0e24097"],"src":["CBS Copenhagen Business School"],"title":"Result-Based Public Governance : Challenges in Developing and Using Daily Performance Measures","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-287887","year":"2014","yearsub":"2014"}
{"abstract":"The empirical focus of this article is a ten-month ethnography of a tax audit process led by the Danish Tax and Customs Administration. The tax audit concerns a number of shady car dealings from which taxable income is not reported. This article focuses on the process whereby the tax administration succeeds in making some of these car dealings visible. This article draws inspiration from interpretative tax studies that consider taxation as an organisational, institutional, social and cultural phenomenon. Complementing those studies’ approaches, the present study draws both on Latour’s concept of the oligopticon and on Foucault’s notion of the panopticon. The analysis shows that tax inspectors produce oligoptic and panoptic visions when they account for taxpayers’ economic activities and that tax inspectors’ visions are received differently by the represented taxpayers. Some taxpayers fall out of sight, whereas others are highly visible and are interrogated in detail. Using the concepts of the oligopticon and the panopticon to analyse the tax audit process is significant for interpretative tax and accounting studies, because this theoretical approach represents an original method of conceptualising taxation in practice and the work implied in tax administration. Furthermore, due to its detailed ethnography of the tax audit process, this study makes a significant methodological contribution.","author_count":1,"contributors":["Boll, Karen"],"cuid":["S01-000.00-290884"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"1 contributor","cluster_size":1,"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"pr","rtype":["clu"],"sorti":"shady car dealings and taxing work practices an ethnography of a tax audit process","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-290884","identifier":[{"id":"84895901879","type":"scopus"}],"ids":["cbs-a2858ccb-bd58-46b0-a43f-b237abb6a6d5"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-4-7B3B5498C2FEAD235369CA08923D48B9"],"oai":{"class":"Unused","mra":["Social Science (SOC)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Organization"],"nora_code":"DI-U-CBS","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Karen","key":"bollpau","last":"Boll","locid":"ea9574f1-23ef-4b7a-956c-dafe20986b54","name":"Boll, Karen","orcid":"0000-0001-9497-4372","rank":1,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.aos.2013.12.004","issn":["03613682","18736289"],"issn_org":["03613682"],"issue":"1","journal":"Accounting, Organizations and Society","pages":"1-19","publisher":"Elsevier","status":"p","title":"Accounting, Organizations and Society","volume":"39"},"review":"Peer Reviewed","scoID":["2-s2.0-84895901879"],"search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["cbs-a2858ccb-bd58-46b0-a43f-b237abb6a6d5"],"src":["CBS Copenhagen Business School"],"title":"Shady Car Dealings and Taxing Work Practices : An Ethnography of a Tax Audit Process","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-290884","year":"2014","yearsub":"2014"}
{"abstract":"Tax compliance denotes the act of reporting and paying taxes in accordance with the tax laws. Current social science scholarship on tax compliance can almost entirely be divided into behavioural psychology analyses and critical tax studies. This article, which presents two cases of how tax compliance is constructed, challenges the explanatory reaches of today's social science approaches, arguing that an alternative approach to understanding tax compliance is worthwhile exploring. This other choice of approach, inspired by actor–network theory (ANT), adopts a more practice-oriented focus that studies tax compliance where it takes place as well as what it is made of. Consequently, this article argues that tax compliance is a socio-material assemblage and that complying is a distributed action. The article concludes by highlighting how an ANT approach contributes to the further theoretical development of social science studies of taxation.","author_count":1,"contributors":["Boll, Karen"],"cuid":["S01-000.00-292995"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"1 contributor","cluster_size":1,"keyword":["Accountability","Actor network theory","Public sector","Tax compliance"],"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"pr","rtype":["clu"],"sorti":"mapping tax compliance assemblages distributed action and practices a new way of doing tax research","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-292995","identifier":[{"id":"84902273503","type":"scopus"}],"ids":["cbs-b96aabad-4f1b-4172-a4c8-833ecc7ea038"],"keyword":["Accountability","Actor–network theory","Public sector","Tax compliance"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-4-86D59EBF1DBCA7C63A3C974791A631F2"],"oai":{"class":"Unused","mra":["Social Science (SOC)"],"yearPub":"2014","yearSub":"2013"},"org":[{"affno":"1","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Organization"],"nora_code":"DI-U-CBS","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Karen","key":"bollpau","last":"Boll","locid":"ea9574f1-23ef-4b7a-956c-dafe20986b54","name":"Boll, Karen","orcid":"0000-0001-9497-4372","rank":1,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.cpa.2013.03.002","issn":["10452354","10959955"],"issn_org":["10452354"],"issue":"4-5","journal":"Critical Perspectives on Accounting","pages":"293-303","publisher":"Academic Press","status":"p","title":"Critical Perspectives on Accounting","volume":"25"},"review":"Peer Reviewed","scoID":["2-s2.0-84902273503"],"search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["cbs-b96aabad-4f1b-4172-a4c8-833ecc7ea038"],"src":["CBS Copenhagen Business School"],"title":"Mapping Tax Compliance : Assemblages, Distributed Action and Practices: A New Way of Doing Tax Research","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-292995","year":"2014","yearsub":"2013"}
{"author_count":2,"contributors":["Boll, Karen","Oats, Lynne"],"cuid":["S01-000.00-295445"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of Exeter"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"nr","rtype":["clu"],"sorti":"measuring outcomes a review of academic literature","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dw","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://research-api.cbs.dk/ws/files/58812409/TARC_Measuring_Outcomes_Discussion_Paper.pdf","version":"Published Version"},"id":"S01-000.00-295445","ids":["cbs-d2dc8867-c4d3-4df9-8144-4949f2b0b72a"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-E38024ED4C52867442BEAFF3C93273D9"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://research-api.cbs.dk/ws/files/58812409/TARC_Measuring_Outcomes_Discussion_Paper.pdf","version":"Published Version"},{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"http://tarc.exeter.ac.uk/media/universityofexeter/businessschool/documents/centres/tarc/publications/discussionpapers/TARC_Measuring_Outcomes_Discussion_Paper_(1).pdf","version":"Published Version"}],"org":[{"affno":"1","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Organization"],"nora_code":"DI-U-CBS","used":1},{"affno":"2","country":"gb","key":"university of exeter","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Exeter","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Karen","key":"bollpau","last":"Boll","locid":"ea9574f1-23ef-4b7a-956c-dafe20986b54","name":"Boll, Karen","orcid":"0000-0001-9497-4372","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lynne","key":"oatspau","last":"Oats","name":"Oats, Lynne","rank":2,"rolecode":"pau"}],"pub":{"issue":"007/14","pages":"13","place":"Exeter","publisher":"Tax Administration Research Centre, University of Exeter Business School, United Kingdom","series":"TARC Discussion Paper","status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["cbs-d2dc8867-c4d3-4df9-8144-4949f2b0b72a"],"src":["CBS Copenhagen Business School"],"title":"Measuring Outcomes : A Review of Academic Literature","type":"Working Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-295445","year":"2014","yearsub":"2014"}
{"abstract":"This article investigates a segmentation model used by the Danish Tax and Customs Administration to classify businesses’ motivational postures. The article uses two different conceptualisations of performativity to analyse what the model’s segmentations do: Hacking’s notion of making up people and MacKenzie’s idea of performativity. Based on these two approaches, the article demonstrates that the segmentation model represents and performs the businesses as it makes up certain new ways to be a business and as the businesses can be seen as moving targets. Inspired by MacKenzie the argument is that the segmentation model embodies cleverness in that it simultaneously alters what it represents and then represents this altered reality to confirm the accuracy of its own model of the businesses’ postures. Despite the cleverness of the model, it also has a blind spot. The model assumes a world wherein everything around it is in motion and can be shaped, however, it sees itself as stable. This assumption turns out to be problematic as the tax administration questions the model’s ability to produce valid comparisons. The article presents a detailed analysis of the model’s performativity, providing an example of a performativity study whose methodology differs from the methodological criteria set up by MacKenzie.","author_count":1,"contributors":["Boll, Karen"],"cuid":["S01-000.00-296115"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"1 contributor","cluster_size":1,"keyword":["MODEL","Performativity","Segmentation","Tax administration"],"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"pr","rtype":["clu"],"sorti":"representing and performing businesses a segmentation model in action","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-296115","identifier":[{"id":"84897028092","type":"scopus"}],"ids":["cbs-da02f597-2ec4-4cba-a2aa-ac9d9fa638a6"],"keyword":["Model","Performativity","Representing","Segmentation","Tax administration"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-3-6D05DE0C61F9396C582251DE02BA1AC1"],"oai":{"class":"Unused","mra":["Social Science (SOC)"],"yearPub":"2014","yearSub":"2013"},"org":[{"affno":"1","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Organization"],"nora_code":"DI-U-CBS","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Karen","key":"bollpau","last":"Boll","locid":"ea9574f1-23ef-4b7a-956c-dafe20986b54","name":"Boll, Karen","orcid":"0000-0001-9497-4372","rank":1,"rolecode":"pau"}],"pub":{"doi":"10.1080/17530350.2012.741530","issn":["17530350","17530369"],"issn_org":["17530350"],"issue":"2","journal":"Journal of Cultural Economy","pages":"226-244","publisher":"Taylor and Francis Ltd.","status":"p","title":"Journal of Cultural Economy","volume":"7"},"review":"Peer Reviewed","scoID":["2-s2.0-84897028092"],"search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["cbs-da02f597-2ec4-4cba-a2aa-ac9d9fa638a6"],"src":["CBS Copenhagen Business School"],"title":"Representing and Performing Businesses : A Segmentation Model in Action","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-296115","year":"2014","yearsub":"2013"}
{"abstract":"This paper analyses the way regulatory agencies strategically use public ‘rhetoric’ and ‘management of appearance’ to strengthen their regulation. It reports a comparative study of the Securities and Exchange Commission (SEC) which is the US federal securities regulator and the Danish Tax and Customs Administration (SKAT) which is the national tax regulator in Denmark. SEC operates in a US context where the agency fights to get trust, while SKAT operates in a context where high trust in public agencies is a basic condition. We argue, however, that despite the radically different institutional environment, these two agencies apply strategies that appear to be strikingly similar, and these similarities are worth investigating not despite, but exactly because of the differing political and social environment. We track recent shifts in organizational practice at these two agencies and argue that both engage reflectively in image promotion which serves two purposes: establishing and maintaining legitimacy in a particular social and political environment and producing compliance. Further, we argue that this regulation is a form of ‘post-bureaucratic’ regulation in which compliance is achieved by skilled management of public appearance.","author_count":2,"contributors":["Boll, Karen","Györy, Csaba"],"cuid":["S01-000.00-285618"],"event":{"end":"2014-12-02","place":"Oslo, no","start":"2014-12-01","title":"The Second Workshop on the Analysis of Bureaucracy in Society","year":"2014"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","Max Planck Institute, Ludwig-Maximilians University. Munich"],"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"pr","rtype":["clu"],"sorti":"regulation as rhetoric a post bureaucratic strategy for regulation","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-285618","ids":["cbs-6a8ef405-a5fe-4593-aeda-a6f3d5c068ac"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-387E44BBF670FB9F64AA2EA092EB3B5D"],"org":[{"affno":"1","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Organization"],"nora_code":"DI-U-CBS","used":1},{"affno":"2","country":"de","key":"max planck institute ludwig maximilians university munich","loc":["Germany","Europe, EU","OECD"],"name":"Max Planck Institute, Ludwig-Maximilians University. Munich","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Karen","key":"bollpau","last":"Boll","locid":"ea9574f1-23ef-4b7a-956c-dafe20986b54","name":"Boll, Karen","orcid":"0000-0001-9497-4372","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Csaba","key":"györypau","last":"Györy","name":"Györy, Csaba","rank":2,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["cbs-6a8ef405-a5fe-4593-aeda-a6f3d5c068ac"],"src":["CBS Copenhagen Business School"],"title":"Regulation as Rhetoric : A Post-Bureaucratic Strategy for Regulation","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-285618","year":"2014","yearsub":"2014"}
