":"Waltman","name":"Waltman, Ludo","rank":12,"rolecode":"pau"},{"affno":"7","first":"Dashun","key":"wangpau","last":"Wang","name":"Wang, Dashun","rank":13,"rolecode":"pau"},{"affno":"8 11 12","first":"Albert László","key":"barabásipau","last":"Barabási","name":"Barabási, Albert László","rank":14,"rolecode":"pau"}],"pmid":["29496846"],"pub":{"doi":"10.1126/science.aao0185","issn":["00368075","10959203"],"issn_org":["00368075"],"issue":"6379","journal":"Science","paperid":"eaao0185","status":"p","title":"Science","volume":"359"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-656112e6-171d-4f96-a6d9-9a7620e0d88c"],"src":["KU University of Copenhagen"],"title":"Science of science","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-701772","year":"2018","yearsub":"2018"}
{"abstract":"Experience plays a critical role in crafting high-impact scientific work. This is particularly evident in top multidisciplinary journals, where a scientist is unlikely to appear as senior author if he or she has not previously published within the same journal. Here, we develop a quantitative understanding of author order by quantifying this \"chaperone effect,\" capturing how scientists transition into senior status within a particular publication venue. We illustrate that the chaperone effect has a different magnitude for journals in different branches of science, being more pronounced in medical and biological sciences and weaker in natural sciences. Finally, we show that in the case of high-impact venues, the chaperone effect has significant implications, specifically resulting in a higher average impact relative to papers authored by new principal investigators (PIs). Our findings shed light on the role played by experience in publishing within specific scientific journals, on the paths toward acquiring the necessary experience and expertise, and on the skills required to publish in prestigious venues.","author_count":7,"contributors":["Sekara, Vedran","Deville, Pierre","Ahnert, Sebastian E","Barabási, Albert-László","Sinatra, Roberta","Lehmann, Sune"],"cuid":["S02-089.97-034332"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["America, North","Europe, EU","Europe, Non-EU","OECD"],"corresponding_author":["Lehmann, Sune"],"country":["Belgium","United Kingdom","United States"],"glorg":["All Global Affiliations","Northeastern University","University of Cambridge","Université catholique de Louvain"],"keyword":["Mentorship","Science of science","Scientific careers"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the chaperone effect in scientific publishing","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1073/pnas.1800471115","version":"Published Version"},"id":"S02-089.97-034332","identifier":[{"id":"PMC6294962","type":"pmcid"},{"id":"85058376093","type":"scopus"},{"id":"000452866000049","type":"wos"},{"id":"30530676","type":"pmid"}],"ids":["dtu-4db7f7ba-5fe8-4069-91e2-1328f1282787","ku-406890f0-174b-4178-82e1-15ed2be4f50c"],"keyword":["mentorship","science of science","scientific careers"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-CE33F1896333DE713BE078194B91938F"],"oa_link":[{"access":"oa","license":"http://europepmc.org/Copyright","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC6294962/pdf/pnas.201800471.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1073/pnas.1800471115","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/163150694/12603.full.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Applied Mathematics and Computer Science","Technical University of Denmark, Department of Applied Mathematics and Computer Science, Cognitive Systems"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"be","key":"université catholique de louvain","loc":["Belgium","Europe, EU","OECD"],"name":"Université catholique de Louvain","used":1},{"affno":"3","country":"gb","key":"university of cambridge","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Cambridge","used":1},{"affno":"4","country":"us","key":"northeastern university","loc":["United States","America, North","OECD"],"name":"Northeastern University","used":1},{"affno":"5","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Niels Bohr Institute, Biocomplexity"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Vedran","key":"sekarapau","last":"Sekara","locid":"2a6bd001-485b-4d3e-8210-d3ce9420c177","name":"Sekara, Vedran","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Pierre","key":"devillepau","last":"Deville","name":"Deville, Pierre","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Sebastian E","key":"ahnertpau","last":"Ahnert","name":"Ahnert, Sebastian E","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Albert-László","key":"barabásipau","last":"Barabási","name":"Barabási, Albert-László","rank":4,"rolecode":"pau"},{"affno":"","first":"Albert-Laszlo","key":"barabasipau","last":"Barabasi","name":"Barabasi, Albert-Laszlo","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Roberta","key":"sinatrapau","last":"Sinatra","name":"Sinatra, Roberta","rank":5,"rolecode":"pau"},{"affno":"1 5","corresponding":null,"country":"dk","first":"Sune","key":"lehmannpau","last":"Lehmann","locid":"9049a0bd-7e6f-4f06-80f6-88ac447289e7","name":"Lehmann, Sune","orcid":"0000-0001-6099-2345","rank":6,"rolecode":"pau"}],"pmid":["30530676"],"pub":{"doi":"10.1073/pnas.1800471115","issn":["00278424","10916490"],"issn_org":["00278424"],"issue":"50","journal":"Proceedings of the National Academy of Sciences of the United States of America","pages":"12603-12607","status":"p","title":"Proceedings of the National Academy of Sciences of the United States of America","title_org":"Proceedings of the National Academy of Sciences USA (PNAS)","volume":"115"},"review":"Peer Reviewed","scoID":["2-s2.0-85058376093"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-4db7f7ba-5fe8-4069-91e2-1328f1282787","ku-406890f0-174b-4178-82e1-15ed2be4f50c"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"The chaperone effect in scientific publishing","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-089.97-034332","year":"2018","yearsub":"2018"}
{"abstract":"The desire to predict discoveries - to have some idea, in advance, of what will be discovered, by whom, when, and where - pervades nearly all aspects of modern science, from individual scientists to publishers, from funding agencies to hiring committees. In this Essay, we survey the emerging and interdisciplinary field of the \"science of science\" and what it teaches us about the predictability of scientific discovery. We then discuss future opportunities for improving predictions derived from the science of science and its potential impact, positive and negative, on the scientific community.","author_count":3,"contributors":["Clauset, Aaron","Larremore, Daniel B.","Sinatra, Roberta"],"cuid":["S01-000.00-701874"],"filters":{"added":"2023-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Santa Fe Institute","University of Colorado Boulder"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"data driven predictions in the science of science","src":["ku"],"src-code":["DI-U-KU"],"type":"djr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1126/science.aal4217","version":"Published Version"},"id":"S01-000.00-701874","identifier":[{"id":"28154048","type":"pmid"},{"id":"85011324273","type":"scopus"}],"ids":["ku-7691e160-6b12-4622-a3da-a6f73d81588d"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-399BBE555ABFCDBE285DF5714E78DBD8"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1126/science.aal4217","version":"Published Version"}],"org":[{"affno":"1","country":"us","key":"university of colorado boulder","loc":["United States","America, North","OECD"],"name":"University of Colorado Boulder","used":1},{"affno":"2","country":"us","key":"santa fe institute","loc":["United States","America, North","OECD"],"name":"Santa Fe Institute","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Social Sciences, Faculty of Social Sciences, shared expenditure, Social Data Science"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1 2","first":"Aaron","key":"clausetpau","last":"Clauset","name":"Clauset, Aaron","rank":1,"rolecode":"pau"},{"affno":"2","first":"Daniel B.","key":"larremorepau","last":"Larremore","name":"Larremore, Daniel B.","rank":2,"rolecode":"pau"},{"affno":"3","first":"Roberta","key":"sinatrapau","last":"Sinatra","locid":"df859e44-cb2b-41f8-b85b-cfd243c37ab2","name":"Sinatra, Roberta","orcid":"0000-0002-7558-1028","rank":3,"rolecode":"pau"}],"pmid":["28154048"],"pub":{"doi":"10.1126/science.aal4217","issn":["00368075","10959203"],"issn_org":["00368075"],"issue":"6324","journal":"Science","pages":"477-480","status":"p","title":"Science","volume":"355"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-7691e160-6b12-4622-a3da-a6f73d81588d"],"src":["KU University of Copenhagen"],"title":"Data-driven predictions in the science of science","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-701874","year":"2017","yearsub":"2017"}
{"abstract":"Despite the frequent use of numerous quantitative indicators to gauge the professional impact of a scientist, little is known about how scientific impact emerges and evolves in time. Here, we quantify the changes in impact and productivity throughout a career in science, finding that impact, as measured by influential publications, is distributed randomly within a scientist's sequence of publications. This random-impact rule allows us to formulate a stochastic model that uncouples the effects of productivity, individual ability, and luck and unveils the existence of universal patterns governing the emergence of scientific success.The model assigns a unique individual parameter Q to each scientist, which is stable during a career, and it accurately predicts the evolution of a scientist's impact, from the h-index to cumulative citations, and independent recognitions, such as prizes.","author_count":5,"contributors":["Sinatra, Roberta","Wang, Dashun","Deville, Pierre","Song, Chaoming","Barabási, Albert László"],"cuid":["S01-000.00-702401"],"filters":{"added":"2023-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","Europe, EU","OECD"],"country":["Austria","Belgium","United States"],"glorg":["All Global Affiliations","Central European University","Dana-Farber Cancer Institute","Harvard University","Northeastern University","Northwestern University","University of Miami","Université catholique de Louvain"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"quantifying the evolution of individual scientific impact","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1126/science.aaf5239","version":"Published Version"},"id":"S01-000.00-702401","identifier":[{"id":"84995389872","type":"scopus"}],"ids":["ku-d93104f8-29e3-4349-a553-53eca8d8389f"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-FE88C64F1F80BCEFAE60B52D639BC37E"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1126/science.aaf5239","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Social Sciences, Faculty of Social Sciences, shared expenditure, Social Data Science"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"us","key":"northwestern university","loc":["United States","America, North","OECD"],"name":"Northwestern University","used":1},{"affno":"3","country":"us","key":"northeastern university","loc":["United States","America, North","OECD"],"name":"Northeastern University","used":1},{"affno":"4","country":"be","key":"université catholique de louvain","loc":["Belgium","Europe, EU","OECD"],"name":"Université catholique de Louvain","used":1},{"affno":"5","country":"us","key":"university of miami","loc":["United States","America, North","OECD"],"name":"University of Miami","used":1},{"affno":"6","country":"us","key":"harvard university","loc":["United States","America, North","OECD"],"name":"Harvard University","used":1},{"affno":"7","country":"at","key":"central european university","loc":["Austria","Europe, EU","OECD"],"name":"Central European University","used":1},{"affno":"8","country":"us","key":"dana farber cancer institute","loc":["United States","America, North","OECD"],"name":"Dana-Farber Cancer Institute","used":1}],"person":[{"affno":"1","first":"Roberta","key":"sinatrapau","last":"Sinatra","locid":"df859e44-cb2b-41f8-b85b-cfd243c37ab2","name":"Sinatra, Roberta","orcid":"0000-0002-7558-1028","rank":1,"role