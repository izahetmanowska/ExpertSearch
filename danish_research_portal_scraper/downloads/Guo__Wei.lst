 11","corresponding":null,"first":"Yutao","key":"guopau","last":"Guo","name":"Guo, Yutao","rank":8,"rolecode":"pau"},{"affno":"12","corresponding":null,"first":"Ken","key":"okumurapau","last":"Okumura","name":"Okumura, Ken","rank":9,"rolecode":"pau"},{"affno":"3 5 6 7 8 10 11 13","corresponding":null,"country":"dk","first":"Gregory Y.H.","key":"lippau","last":"Lip","locid":"8fa30e84-7381-41b4-8037-afc032238a3d","name":"Lip, Gregory Y H","name_org":"Lip, Gregory Y.H.","rank":10,"rolecode":"pau"}],"pmid":["36624790"],"pub":{"doi":"10.1016/j.jacasi.2022.06.004","issn":["27723747"],"issue":"5","journal":"JACC: Asia","pages":"519-537","publisher":"Elsevier","status":"p","title":"JACC: Asia","volume":"2"},"review":"Peer Reviewed","scoID":["2-s2.0-85139688548"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-b16a1794-f879-4b09-9bb0-33aa2e2b1d4c"],"src":["AAU Aalborg University"],"title":"Stroke Prevention in Atrial Fibrillation : A Scientific Statement of JACC: Asia (Part 2)","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-101547","year":"2022","yearsub":"2022"}
{"abstract":"The consensus of the Asia Pacific Heart Rhythm Society (APHRS) on stroke prevention in atrial fibrillation (AF) has been published in 2017 which provided useful clinical guidance for cardiologists, neurologists, geriatricians, and general practitioners in the Asia-Pacific region. In these years, many important new data regarding stroke prevention in AF were reported. The practice guidelines subcommittee members comprehensively reviewed updated information on stroke prevention in AF, and summarized them in this 2021 focused update of the 2017 consensus guidelines of the APHRS on stroke prevention in AF. We highlighted and focused on several issues, including the importance of the AF Better Care pathway, the advantages of non-vitamin K antagonist oral anticoagulants (NOACs) for Asians, the considerations of use of NOACs for Asian AF patients with single one stroke risk factor beyond gender, the role of lifestyle factors on stroke risk, the use of oral anticoagulants during the \"coronavirus disease 2019\" pandemic, etc. We fully realize that there are gaps, unaddressed questions, and many areas of uncertainty and debate in the current knowledge of AF, and the physician's decision remains the most important factor in the management of AF.","author_count":11,"contributors":["Chao, Tze-Fan","Joung, Boyoung","Takahashi, Yoshihide","Lim, Toon Wei","Choi, Eue-Keun","Chan, Yi-Hsin","Guo, Yutao","Sriratanasathavorn, Charn","Oh, Seil","Okumura, Ken","Lip, Gregory Y H"],"cuid":["S01-000.00-105258"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Asia, East","Asia, South","Europe, Non-EU","OECD"],"corresponding_author":["Chao, Tze-Fan"],"country":["China","Japan","Singapore","South Korea","Taiwan","Thailand","United Kingdom"],"glorg":["All Global Affiliations","Chang Gung Memorial Hospital","Chang Gung University","Liverpool Heart and Chest Hospital NHS Foundation Trust","Mahidol University","National University Hospital, Singapore","National Yang Ming Chiao Tung University","PLA General Hospital","Saiseikai Kumamoto Hospital","Seoul National University Hospital","Tokyo Medical and Dental University","University of Liverpool","Veterans General Hospital-Taipei","Yonsei University"],"keyword":["APHRS","Atrial fibrillation","Consensus guidelines","Stroke prevention","executive summary"],"level":"pop","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"und","rtype":["clu"],"sorti":"000000002021 focused update consensus guidelines of the asia pacific heart rhythm society on stroke prevention in atrial fibrillation executive summary","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND 4.0","type":"doi","url":"https://doi.org/10.1055/s-0041-1739411","version":"Published Version"},"id":"S01-000.00-105258","identifier":[{"id":"34773920","type":"pmid"},{"id":"85119591417","type":"scopus"}],"ids":["aau-be6e53c5-138e-422f-aa1d-ec7cd5ca9bef"],"keyword":["APHRS","atrial fibrillation","consensus guidelines","executive summary","stroke prevention"],"lang":"English","level":"Popular","mra":["Medical Science"],"noi":["Global-Local-2-4-97EDDE18B1389C8FAC80CB6190EA65EF"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND 4.0","type":"doi","url":"https://doi.org/10.1055/s-0041-1739411","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/462373849/Chao_et_al._2022_._2021_Focused_Update_Consensus_Guidelines_of_the_Asia_Pacific_Heart_Rhythm_Society_on_Stroke_Prevention_in_Atrial_Fibrillation_Executive_Summary.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"tw","key":"veterans general hospital taipei","loc":["Taiwan","Asia, East"],"name":"Veterans General Hospital-Taipei","used":1},{"affno":"2","country":"t