{"author_count":5,"contributors":["Wei, Wei","Feng, Fengqin","Pérez, Bianca","Dong, Mingdong","Guo, Zheng"],"cuid":["S01-000.00-136878"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","Zhejiang University"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"biocatalytic synthesis of ultra long chain fatty acid sugar alcohol monoesters","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84935860080","version":"Other Version"},"id":"S01-000.00-136878","identifier":[{"id":"84935860080","type":"scopus"}],"ids":["au-0d331f47-ed3b-4b2e-ab4d-985170fc8a36"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-2851828352B6BA99FA3D1295D0C1070E"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Engineering, Department of Engineering - Biological and Chemical Engineering, Gustav Wieds Vej"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"cn","key":"zhejiang university","loc":["China","Asia, East"],"name":"Zhejiang University","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Wei","key":"weipau","last":"Wei","locid":"eba1f296-6e64-4865-9eb0-8f10c76bc212","name":"Wei, Wei","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Fengqin","key":"fengpau","last":"Feng","name":"Feng, Fengqin","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Bianca","key":"perézpau","last":"Peréz","locid":"53fb7df0-13cb-4efd-a0eb-aa03e8db8f9c","name":"Pérez, Bianca","name_org":"Peréz, Bianca","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mingdong","key":"dongpau","last":"Dong","locid":"b54afe28-ba86-4353-9f09-6618abd83284","name":"Dong, Mingdong","orcid":"0000-0002-2025-2171","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Zheng","key":"guopau","last":"Guo","locid":"67372258-2bc9-4585-98c9-1b93c60d0ca9","name":"Guo, Zheng","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1039/c5gc00695c","issn":["14639262","14639270"],"issn_org":["14639262"],"journal":"Green Chemistry","publisher":"Royal Society of Chemistry","status":"p","title":"Green Chemistry","volume":"17"},"review":"Peer Reviewed","scoID":["2-s2.0-84935860080"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-0d331f47-ed3b-4b2e-ab4d-985170fc8a36"],"src":["AU Aarhus University"],"title":"Biocatalytic synthesis of ultra-long-chain fatty acid sugar alcohol monoesters","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-136878","year":"2015","yearsub":"2015"}
{"abstract":"Paternal age has been associated with offspring congenital heart defects (CHDs), which might be caused by increased mutations in the germ cell line because of cumulated cell replications. Empirical evidences, however, remain inconclusive. Furthermore, it is unknown whether all subtypes of CHDs are affected by paternal age. We aimed to explore the relationship between paternal age and the risk of offspring CHDs and its five common subtypes using national register data in Denmark. A total of 1 893 899 singletons born in Denmark from 1977 to 2008 were included in this national-based cohort study. Cox's proportion hazards model with robust sandwich estimate option was used to estimate the hazards ratio (95% confidence interval) for the associations between paternal age and all CHDs, as well as subtypes of CHDs (patent ductus arteriosus (PDA), ventricular septal defect (VSD), atrial septal defect (ASD), tetralogy of fallot (TOF) and coarctation of the aorta (CoA)). We did not observe an overall association between paternal age and offspring CHDs. However, compared to the paternal age of 25-29 years, paternal age of older than 45 years was associated with a 69% increased risk of PDA (HR45+ = 1.69, 95%CI:1.17-2.43). We observed similar results when subanalyses were restricted to children born to mothers of 27-30 years old. After taking into consideration of maternal age, our data suggested that advanced paternal age was associated with an increased prevalence of one subtype of offspring congenital heart defects (CHDs), namely patent ductus arteriosus (PDA).","author_count":5,"contributors":["Su, Xiu Juan","Yuan, Wei","Huang, Guo Ying","Olsen, Jørn","Li, Jiong"],"cuid":["S01-000.00-165822"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"paternal age and offspring congenital heart defects a national cohort study","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1371/journal.pone.0121030","version":"Other Version"},"id":"S01-000.00-165822","identifier":[{"id":"25806788","type":"pmid"},{"id":"PMC4373953","type":"pmcid"},{"id":"84925989470","type":"scopus"}],"ids":["au-400d3fdc-beb1-4ff1-a1f3-85d8266b3039"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-34EE2A0D6AE6AB9F9BD35434828D5D35"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1371/journal.pone.0121030","version":"Other Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Chemistry"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Xiu Juan","key":"supau","last":"Su","name":"Su, Xiu Juan","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Wei","key":"yuanpau","last":"Yuan","locid":"86b09a4c-8b42-413c-8b87-a12b84bc2add","name":"Yuan, Wei","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Guo Ying","key":"huangpau","last":"Huang","name":"Huang, Guo Ying","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jørn","key":"olsenpau","last":"Olsen","locid":"48e09bb0-9b9d-40c8-ab2c-ff256ae11f0f","name":"Olsen, Jørn","orcid":"0000-0001-7462-5140","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jiong","key":"lipau","last":"Li","locid":"304b9c99-9102-4963-8342-05aae67a5685","name":"Li, Jiong","orcid":"0000-0003-1125-026X","rank":5,"rolecode":"pau"}],"pmid":["25806788"],"pub":{"doi":"10.1371/journal.pone.0121030","issn":["19326203"],"issue":"3","journal":"PLOS ONE","publisher":"Public Library of Science","status":"p","title":"PLOS ONE","volume":"10"},"review":"Peer Reviewed","scoID":["2-s2.0-84925989470"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-400d3fdc-beb1-4ff1-a1f3-85d8266b3039"],"src":["AU Aarhus University"],"title":"Paternal age and offspring congenital heart defects : a national cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-165822","year":"2015","yearsub":"2015"}
{"abstract":"Sulfonated polyimides are among the most interesting proton exchange membrane materials with high proton conductivity and good mechanical characteristics. As a major challenge the hydrolytic instability of the polymer backbone is addressed by introducing basic moieties in the polymer main chain. A series of sulfonated copolyimides (SPI) are prepared via random copolymerizatio of 1,4,5,8-naphthalenetetracarboxylic dianhydride (NTDA) with a new diamine monomer with pendant benzimidazole groups, 2,2'-bis(4-(1H-benzo[d]imidazol-2-yl)phenoxy)benzidine (BIPOB), and a sulfonated diamine monomer 4,4'-bis(4-aminophenoxy)biphenyl-3,3'-disulfonic acid (BAPBDS) at different diamine molar ratios (BAPBDS/BIPOB, 4/1, 6/1, 9/1 and 12/1). With ion exchange capacities in the range of 1.60-2.24 meq g(-1), transparent and ductile membranes are obtained by solution casting. The incorporation of benzimiclazole pendant groups significantly improves the hydrolytic stability as well as the radical oxidative stability of the membranes. In addition, the SPI membranes exhibit high proton conductivities of 0.1 S cm(-1) in the fully hydrated state at 60 degrees C and high elastic modulus and tensile strength. Preliminary fuel cell tests demonstrate the technical feasibility and stability of the materials. (C) 2015 Elsevier B.V. All rights reserved.","author_count":6,"contributors":["Li, Wei","Guo, Xiaoxia","Aili, David","Fernandez, Santiago Martin","Li, Qingfeng","Fang, Jianhua"],"cuid":["S01-000.00-319564"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","Shanghai Jiao Tong University"],"keyword":["ACID","Amines","Engineering","Fuel cells","Hydrolytic stability","Ion exchange","Ion exchange capacity","Ion exchange membranes","Mechanical characteristics","Mechanical properties","Membranes","Monomers","Oxidation resistance","Polybenzimidazole","Polyelectrolytes","Polyimides","Polymer","Polymer electrolyte membrane","Proton conductivity","Proton exchange membrane fuel cell","Proton exchange membrane fuel cells PEMFC","Proton exchange membranes","Stability","Tensile strength","Transport","Water stability","hydrolytic degradation"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"sulfonated copolyimide membranes derived from a novel diamine monomer with pendant benzimidazole groups for fuel cells","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.memsci.2015.01.048","version":"Other Version"},"id":"S01-000.00-319564","identifier":[{"id":"84923306068","type":"scopus"}],"ids":["dtu-326fd152-ed9f-42a5-aafa-426529b92c5b"],"keyword":["ACID","Amines","CONDUCTING MEMBRANES","ENGINEERING,","Fuel cells","HYDROLYTIC DEGRADATION","High elastic modulus","Hydrolytic stability","Ion exchange","Ion exchange capacity","Ion exchange membranes","Mechanical characteristics","Mechanical properties","Membranes","Monomers","Oxidation resistance","POLYBENZIMIDAZOLE","POLYELECTROLYTES","POLYIMIDE MEMBRANES","POLYMER","POLYMER ELECTROLYTE MEMBRANE","PROTON-EXCHANGE MEMBRANES","Polyimides","Proton conductivity","Proton exchange membrane fuel cell","Proton exchange membrane fuel cells (PEMFC)","Radical oxidative stability","Stability","Sulfonated copolyimide","Sulfonated polyimide","Sulfonated polyimides","TRANSPORT","Tensile strength","WATER STABILITY"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-2620EA6990FFEB74A38F5116087CB38A"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.memsci.2015.01.048","version":"Other Version"}],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2015","year