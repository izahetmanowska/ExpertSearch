of Science, Niels Bohr Institute, Physics of Ice, Climate and Earth"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Marie","key":"bouchetpau","last":"Bouchet","name":"Bouchet, Marie","rank":1,"rolecode":"pau"},{"affno":"","first":"Amaëlle","key":"landaispau","last":"Landais","name":"Landais, Amaëlle","rank":2,"rolecode":"pau"},{"affno":"","first":"Antoine","key":"grisartpau","last":"Grisart","name":"Grisart, Antoine","rank":3,"rolecode":"pau"},{"affno":"","first":"Frédéric","key":"parreninpau","last":"Parrenin","name":"Parrenin, Frédéric","rank":4,"rolecode":"pau"},{"affno":"","first":"Frédéric","key":"priépau","last":"Prié","name":"Prié, Frédéric","rank":5,"rolecode":"pau"},{"affno":"","first":"Roxanne","key":"jacobpau","last":"Jacob","name":"Jacob, Roxanne","rank":6,"rolecode":"pau"},{"affno":"","first":"Elise","key":"fourrépau","last":"Fourré","name":"Fourré, Elise","rank":7,"rolecode":"pau"},{"affno":"","first":"Emilie","key":"capronpau","last":"Capron","name":"Capron, Emilie","rank":8,"rolecode":"pau"},{"affno":"","first":"Dominique","key":"raynaudpau","last":"Raynaud","name":"Raynaud, Dominique","rank":9,"rolecode":"pau"},{"affno":"","first":"Vladimir Ya","key":"lipenkovpau","last":"Lipenkov","name":"Lipenkov, Vladimir Ya","rank":10,"rolecode":"pau"},{"affno":"","first":"Marie-france","key":"loutrepau","last":"Loutre","name":"Loutre, Marie-france","rank":11,"rolecode":"pau"},{"affno":"","first":"Thomas","key":"extierpau","last":"Extier","name":"Extier, Thomas","rank":12,"rolecode":"pau"},{"affno":"1","first":"Anders","key":"svenssonpau","last":"Svensson","locid":"e0501b84-a817-417e-9c70-9601c6b26cb8","name":"Svensson, Anders","orcid":"0000-0002-4364-6085","rank":13,"rolecode":"pau"},{"affno":"","first":"Etienne","key":"legrainpau","last":"Legrain","name":"Legrain, Etienne","rank":14,"rolecode":"pau"},{"affno":"","first":"Patricia","key":"martineriepau","last":"Martinerie","name":"Martinerie, Patricia","rank":15,"rolecode":"pau"},{"affno":"","