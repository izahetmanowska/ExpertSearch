041-1739411","issn":["03406245","03447618"],"issn_org":["03406245"],"issue":"1","journal":"Thrombosis and Haemostasis","pages":"20-47","publisher":"Georg Thieme Verlag","status":"p","title":"Thrombosis and Haemostasis","volume":"122"},"review":"Undetermined","scoID":["2-s2.0-85119591417"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-be6e53c5-138e-422f-aa1d-ec7cd5ca9bef"],"src":["AAU Aalborg University"],"title":"2021 Focused Update Consensus Guidelines of the Asia Pacific Heart Rhythm Society on Stroke Prevention in Atrial Fibrillation : Executive Summary","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-105258","year":"2022","yearsub":"2022"}
{"abstract":"BACKGROUND: Left atrial thrombus (LAT) often complicates with atrial fibrillation (AF). The evidence whether fibrin D-dimer levels could be used as a predictive biomarker for LAT is contradictory. This study firstly investigated the relationship between 'normal range' D-dimer and prevalent LAT. Second, we explored factors contributing to normal D-dimer levels in the presence of LAT. METHODS: We studied 244 AF patients with LAT (mean age: 59.9 years, SD:11.7; 53.3% female): of these, 103 (42.2%) had normal D-dimer, 25 (10.2%) had atrial thrombus exclusion score (ATE score) of 0 19 (16.7%) males had CHA2DS2-VASc score of 0, 21(16.2%) females had CHA2DS2-VASc score of 1 and 16 had overlapped ATE score of 0 and CHA2DS2-VASc score of 0 (N = 8 if male) or CHA2DS2-VASc score of 1(N = 8 if female). Using multivariate binary analysis, larger left atrial diameter (LAD; adjusted OR: 1.06, 1.03-1.10, p = 0.001) were associated with increased D-dimer. Patients with high body mass index (BMI), hypertension history and previous anticoagulation were more likely to show normal range D-dimer levels in the presence of LAT. CONCLUSIONS: A high prevalence (42.2%) of 'normal range' D-dimer levels was found in AF patients with LAT, especially in those with hypertension, high BMI and prior anticoagulation. D-dimer levels of those patients with larger LAD were more likely to be increased.","author_count":9,"contributors":["Bai, Ying","Luo, Si-Qing","Liu, Si-Tong","Gong, Ling","Zhong, Peng","Wang, Zhen-Zhou","Lip, Gregory Y H","Zou, Yi-Xi","Guo, Wei-Hua"],"cuid":["S01-000.00-105745"],"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East","Europe, Non-EU","OECD"],"corresponding_author":["Zou, Yi-Xi"],"country":["China","United Kingdom"],"glorg":["All Global Affiliations","Beijing Anzhen Hospital","Beijing Tongren Hospital","Beijing University of Chinese Medicine","Capital Medical University","China-Japan Friendship Hospital","Dongzhimen Hospital of Beijing University of Chinese Medicine","Liverpool Heart and Chest Hospital NHS Foundation Trust","Liverpool John Moores University","Peking University People's Hospital","University of Liverpool"],"keyword":["Anticoagulants","Atrial fibrillation","D dimer","Female","Fibrin","Heart Diseases","Humans","Hypertension complications","Left atrial thrombus","Male","Middle Aged","Predictive Value of Tests","Risk Assessment","Risk Factors","Stroke etiology","Thrombosis complications"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"clinical features associated with normal range fibrin d dimer levels in atrial fibrillation patients with left atrial thrombus","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC 4.0","type":"doi","url":"https://doi.org/10.1177/10760296221133380","version":"Published Version"},"id":"S01-000.00-105745","identifier":[{"id":"36523145","type":"pmid"},{"id":"PMC9768829","type":"pmcid"},{"id":"85144220154","type":"scopus"}],"ids":["aau-c01472cd-81f2-43a7-bdac-777d38d7b23f"],"keyword":["Anticoagulants","Atrial Fibrillation","Echocardiography, Transesophageal/adverse effects","Female","Fibrin","Heart Diseases","Humans","Hypertension/complications","Male","Middle Aged","Predictive Value of Tests","Risk Assessment","Risk Factors","Stroke/etiology","Thrombosis/complications","d-dimer","left atrial diameter","left atrial thrombus"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-5FF705050F084E849B1883A8C7CA227F"],"oa_link":[{"access":"oa","license":"CC BY-NC 4.0","type":"doi","url":"https://doi.org/10.1177/10760296221133380","version":"Published Version"},{"access":"oa","license":"CC BY-NC 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/510604552/Bai_et_al._2022_._Clinical_Features_Associated_with_Normal_Range_Fibrin_D_Dimer_Levels_in_Atrial_Fibrillation_Patients_with_Left_Atrial_Thrombu.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"cn","key":"capital medical university","loc":["China","Asia, East"],"name":"Capital Medical University","used":1},{"affno":"2","country":"cn","key":"beijing tongren hospital","loc":["China","Asia, East"],"name":"Beijing Tongren Hospital","used":1},{"affno":"3","country":"cn","key":"beijing university of chinese medicine","loc":["China","Asia, East"],"name":"Beijing University of Chinese Medicine","used":1},{"affno":"4","country":"cn","key":"dongzhimen hospital of beijing university of chinese medicine","loc":["China","Asia, East"],"name":"Dongzhimen Hospital of Beijing University of Chinese Medicine","used":1},{"affno":"5","country":"cn","key":"china japan friendship hospital","loc":["China","Asia, East"],"name":"China-Japan Friendship Hospital","used":1},{"affno":"6","country":"cn","key":"peking university people s hospital","loc":["China","Asia, East"],"name":"Peking University People's Hospital","used":1},{"affno":"7","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-AAU","used":1},{"affno":"8","country":"gb","key":"university of liverpool","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Liverpool","used":1},{"affno":"9","country":"gb","key":"liverpool john moores university","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Liverpool John Moores University","used":1},{"affno":"10","country":"gb","key":"liverpool heart and chest hospital nhs foundation trust","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Liverpool Heart and Chest Hospital NHS Foundation Trust","used":1},{"affno":"11","country":"cn","key":"beijing anzhen hospital","loc":["China","Asia, East"],"name":"Beijing Anzhen Hospital","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Ying","key":"baipau","last":"Bai","name":"Bai, Ying","rank":1,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Si-Qing","key":"luopau","last":"Luo","name":"Luo, Si-Qing","rank":2,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Si-Tong","key":"liupau","last":"Liu","name":"Liu, Si-Tong","rank":3,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Ling","key":"gongpau","last":"Gong","name":"Gong, Ling","rank":4,"rolecode":"pau"},{"affno":"1 5","corresponding":null,"first":"Peng","key":"zhongpau","last":"Zhong","name":"Zhong, Peng","rank":5,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Zhen-Zhou","key":"wangpau","last":"Wang","name":"Wang, Zhen-Zhou","rank":6,"rolecode":"pau"},{"affno":"7 8 9 10","corresponding":null,"country":"dk","first":"Gregory YH","key":"lippau","last":"Lip","locid":"8fa30e84-7381-41b4-8037-afc032238a3d","name":"Lip, Gregory Y H","name_org":"Lip, Gregory YH","rank":7,"rolecode":"pau"},{"affno":"1 11","corresponding":null,"first":"Yi-Xi","key":"zoupau","last":"Zou","name":"Zou, Yi-Xi","rank":8,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Wei-Hua","key":"guopau","last":"Guo","name":"Guo, Wei-Hua","rank":9,"rolecode":"pau"}],"pmid":["36523145"],"pub":{"doi":"10.1177/10760296221133380","issn":["10760296","19382723"],"issn_org":["10760296"],"journal":"Clinical and Applied Thrombosis/Hemostasis","pages":"10760296221133380","publisher":"SAGE Publications","status":"p","title":"Clinical and Applied Thrombosis/Hemostasis","volume":"28"},"review":"Peer Reviewed","scoID":["2-s2.0-85144220154"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-c01472cd-81f2-43a7-bdac-777d38d7b23f"],"src":["AAU Aalborg University"],"title":"Clinical Features Associated with 'Normal Range' Fibrin D-Dimer Levels in Atrial Fibrillation Patients with Left Atrial Thrombus","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-105745","year":"2022","yearsub":"2022"}
{"abstract":"Importance: Calcium-release deficiency syndrome (CRDS), which is caused by loss-of-function variants in cardiac ryanodine receptor 2 (RyR2), is an emerging cause of ventricular fibrillation. However, the lack of complex polymorphic/bidirectional ventricular tachyarrhythmias during exercise stress testing (EST) may distinguish it from catecholaminergic polymorphic ventricular tachycardia (CPVT). Recently, in the first clinical series describing the condition, mouse and human studies showed that the long-burst, long-pause, short-coupled ventricular extra stimulus (LBLPS) electrophysiology protocol reliably induced CRDS ventricular arrhythmias. Data from larger populations with CRDS and its associated spectrum of disease are lacking. Objective: To further insight into CRDS through international collaboration. Design, Setting, and Participants: In this multicenter observational cohort study, probands with unexplained life-threatening arrhythmic events and an ultrarare RyR2 variant were identified. Variants were expressed in HEK293 cells and subjected to caffeine stimulation to determine their functional impact. Data were collected from September 1, 2012, to March 6, 2021, and analyzed from August 9, 2015, to March 6, 2021. Main Outcomes and Measures: The functional association of RyR2 variants found in putative cases of CRDS and the associated clinical phenotype(s). Results: Of 10 RyR2 variants found in 10 probands, 6 were loss-of-function, consistent with CRDS (p.E4451del, p.F4499C, p.V4606E, p.R4608Q, p.R4608W, and p.Q2275H) (in 4 [67%] male and 2 [33%] female probands; median age at presentation, 22 [IQR, 8-34] years). In 5 probands with a documented trigger, 3 were catecholamine driven. During EST, 3 probands with CRDS had no arrhythmias, 1 had a monomorphic couplet, and 2 could not undergo EST (deceased). Relatives of the decedents carrying the RyR2 variant did not have EST results consistent with CPVT. After screening 3 families, 13 relatives were diagnosed with CRDS, including 3 with previous arrhythmic events (23%). None had complex ventricular tachyarrhythmias during EST. Among the 19 confirmed cases with CRDS, 10 had at least 1 life-threatening event at presentation and/or during a median follow-up of 7 (IQR, 6-18) years. Two of the 3 device-detected ventricular fibrillation episodes were induced by a spontaneous LBLPS-like sequence. β-Blockers were used in 16 of 17 surviving patients (94%). Three of 16 individuals who were reportedly adherent to β-blocker therapy (19%) had breakthrough events. Conclusions and Relevance: The results of this study suggest that calcium-release deficiency syndrome due to RyR2 loss-of-function variants mechanistically and phenotypically differs from CPVT. Ventricular fibrillation may be precipitated by a spontaneous LBLPS-like sequence of ectopy; however, CRDS remains difficult to recognize clinically. These data highlight the need for better diagnostic tools and treatments for this emerging condition.","author_count":24,"contributors":["Roston, Thomas M","Wei, Jinhong","Guo, Wenting","Li, Yanhui","Zhong, Xiaowei","Wang, Ruiwu","Estillore, John Paul","Peltenburg, Puck J","Noguer, Ferran Rosés I","Till, Jan","Eckhardt, Lee L","Orland, Kate M","Hamilton, Robert","LaPage, Martin J","Krahn, Andrew D","Tadros, Rafik","Vinocur, Jeffrey M","Kallas, Dania","Franciosi, Sonia","Roberts, Jason D","Wilde, Arthur A M","Jensen, Henrik Kjærulf","Sanatani, Shubhayan","Chen, S R Wayne"],"cuid":["S01-000.00-213088"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Europe, EU","Europe, Non-EU","OECD"],"country":["Canada","Netherlands","United Kingdom","United States"],"glorg":["All Global Affiliations","Royal Brompton and Harefield NHS Foundation Trust","Samuel Lunenfeld Research Institute, Mount Sinai Hospital, Toronto","The Hospital for Sick Children","University of Amsterdam","University of Calgary","University of California at Berkeley","University of Michigan","University of Montreal","University of Wisconsin-Madison","Western University","Yale University"],"keyword":["EXPERT CONSENSUS STATEMENT","Fibrillation","GENE","Identification","Mutations","Polymorphic ventricular tachycardia","Spectrum"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"clinical and functional characterization of ryanodine receptor 000000000002 variants implicated in calcium release deficiency syndrome","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC8567190/?report=printable","version":"Published Version"},"id":"S01-000.00-213088","identifier":[{"id":"85118967134","type":"scopus"},{"id":"PMC8567190","type":"pmcid"},{"id":"34730774","type":"pmid"},{"id":"000714700300003","type":"wos"}],"ids":["au-9303e5ee-b3e5-4663-9250-3b025022a4bd"],"keyword":["EXPERT CONSENSUS STATEMENT","FIBRILLATION","GENE","IDENTIFICATION","MUTATIONS","POINTES","POLYMORPHIC VENTRICULAR-TACHYCARDIA","SPECTRUM"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-3D018C23784B5F38868C5169C2A28B1E"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC8567190/?report=printable","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"us","key":"university of california at berkeley","loc":["United States","America, North","OECD"],"name":"University of California at Berkeley","used":1},{"affno":"2","country":"ca","key":"university of calgary","loc":["Canada","America, North","OECD"],"name":"University of Calgary","used":1},{"affno":"3","country":"nl","key":"university of amsterdam","loc":