{"author_count":6,"contributors":["Zhang, Haijun","Deng, Wei","Wang, Xiangfei","Wang, Shen-guo","Ge, Junbo","Toft, Egon"],"cuid":["S01-000.00-098215"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"solely abluminal drug release from coronary stents could possibly improve reendothelialization","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-098215","identifier":[{"id":"000386799900001","type":"wos"},{"id":"84986916613","type":"scopus"}],"ids":["aau-a6224236-cd2e-4c6e-935e-5a37cc273f8c"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-8913FD60E0E0F0DE2C2903F04651B087"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Center for Sensory-Motor Interaction"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Haijun","key":"zhanghaijunpau","last":"Zhang","locid":"fc55809a-389e-4351-ae30-77433cd63adc","name":"Zhang, Haijun","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Wei","key":"dengweipau","last":"Deng","name":"Deng, Wei","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Xiangfei","key":"wangxiangfeipau","last":"Wang","name":"Wang, Xiangfei","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Shenguo","key":"wangshenguopau","last":"Wang","locid":"79aca400-9da4-435b-8fea-895d3f8ac66e","name":"Wang, Shen-guo","name_org":"Wang, Shenguo","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Junbo","key":"gejunbopau","last":"Ge","name":"Ge, Junbo","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Egon","key":"toftegonpau","last":"Toft","locid":"f82c9f05-794b-4506-b684-d5d56e98a6a0","name":"Toft, Egon","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1002/ccd.25335","issn":["15221946","1522726X"],"issn_org":["15221946"],"issue":"3","journal":"Catheterization and Cardiovascular Interventions","publisher":"Wiley","status":"p","title":"Catheterization and Cardiovascular Interventions","volume":"88"},"review":"Peer Reviewed","scoID":["2-s2.0-84986916613"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-a6224236-cd2e-4c6e-935e-5a37cc273f8c"],"src":["AAU Aalborg University"],"title":"Solely abluminal drug release from coronary stents could possibly improve reendothelialization","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-098215","year":"2016","yearsub":"2016"}
{"abstract":"BACKGROUND: The biodegradable polymer drug-eluting stents (DES) were developed to improve vascular healing. However, further data and longer-term follow-up are needed to confirm safety and efficacy of these stents. This randomized clinical trial aimed to compare safety and efficacy of 2 sirolimus-eluting stents (SES): Cordimax-a novel abluminal biodegradable polymer SES and Cypher Select-a durable polymer SES, at 9 months angiographic and 5-year clinical follow-up. METHODS: We randomized 402 patients with coronary artery disease to percutaneous coronary intervention with Cordimax (n = 202) or Cypher select (n = 200). Angiographic follow-up was performed at 9 months after the index procedure and clinical follow-up annually up to 5 years. The primary endpoint was angiographic in-stent late luminal loss (LLL). Secondary endpoints included angiographic restenosis rate, target vessel revascularization (TVR), and major adverse cardiac events (MACEs; defined as cardiac death, myocardial infarction, or TVR) at 5-year follow-up. RESULTS: Cordimax was noninferior to Cypher select for in-stent LLL (0.25 ± 0.47 vs 0.18 ± 0.49 mm; P = 0.587) and in-stent mean diameter stenosis (22.19 ± 12.21% vs 19.89 ± 10.79%; P = 0.064) at 9 months angiographic follow-up. The MACE rates were not different at 1 year (5.9% vs 4.0%, P = 0.376); however, MACE rates from 2 to 5 years were lower in the Cordimax group (6.8% vs 13.1%; P = 0.039). CONCLUSION: Abluminal biodegradable polymer SES is noninferior to durable polymer SES at 9-month angiographic and 1-year clinical follow-up. However, MACE rates from 2 to 5 years were less in the abluminal biodegradable polymer group.","author_count":6,"contributors":["Zhang, Haijun","Wang, Xiangfei","Deng, Wei","Wang, Shen-guo","Ge, Junbo","Toft, Egon"],"cuid":["S01-000.00-111112"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Journal Article"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"randomized clinical trial comparing abluminal biodegradable polymer sirolimus eluting stents with durable polymer sirolimus eluting stents nine months angiographic and 000000000005 year clinical outcomes","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/243555472/Randomized_clinical_trial_comparing_abluminal.13.pdf","version":"Published Version"},"id":"S01-000.00-111112","identifier":[{"id":"PMC5044893","type":"pmcid"},{"id":"84991711588","type":"scopus"},{"id":"27661023","type":"pmid"},{"id":"000385539300013","type":"wos"}],"ids":["aau-d252f2a1-97dd-4c28-bdf6-f91377986b61"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-32A9B498DD95CE40C85826005E503C6D"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/243555472/Randomized_clinical_trial_comparing_abluminal.13.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2017"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Center for Sensory-Motor Interaction"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Haijun","key":"zhanghaijunpau","last":"Zhang","locid":"fc55809a-389e-4351-ae30-77433cd63adc","name":"Zhang, Haijun","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Xiangfei","key":"wangxiangfeipau","last":"Wang","name":"Wang, Xiangfei","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Wei","key":"dengweipau","last":"Deng","name":"Deng, Wei","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Shen-guo","key":"wangshenguopau","last":"Wang","locid":"79aca400-9da4-435b-8fea-895d3f8ac66e","name":"Wang, Shen-guo","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Junbo","key":"gejunbopau","last":"Ge","name":"Ge, Junbo","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Egon","key":"toftegonpau","last":"Toft","locid":"f82c9f05-794b-4506-b684-d5d56e98a6a0","name":"Toft, Egon","rank":6,"rolecode":"pau"}],"pmid":["27661023"],"pub":{"doi":"10.1097/md.0000000000004820","issn":["00257974","15365964"],"issn_org":["00257974"],"issue":"38","journal":"Medicine","paperid":"e4820","publisher":"Lippincott Williams and Wilkins Ltd.","status":"p","title":"Medicine","volume":"95"},"review":"Peer Reviewed","scoID":["2-s2.0-84991711588"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-d252f2a1-97dd-4c28-bdf6-f91377986b61"],"src":["AAU Aalborg University"],"title":"Randomized clinical trial comparing abluminal biodegradable polymer sirolimus-eluting stents with durable polymer sirolimus-eluting stents : nine months angiographic and 5-year clinical outcomes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-111112","year":"2016","yearsub":"2017"}
{"abstract":"A thermoresponsive graft copolymer polyhydroxyalkanoate-g-poly(N-isopropylacrylamide) or short as PHA-g-PNIPAm, was successfully synthesized via a three-step reaction. First, PNIPAm oligomer with a trithiocarbonate-based chain transfer agent (CTA), short as PNIPAm-CTA, with designed polymerization degree was synthesized via reversible addition–fragmentation chain transfer (RAFT) polymerization. Subsequently, the PNIPAm-CTA was treated with n-butylamine for aminolysis in order to obtain a pendant thiol group at the end of the chain (PNIPAm-SH). Finally, the PNIPAm-SH was grafted onto unsaturated P(3HDD-co-3H10U), a random copolymer of 3-hydroxydodecanoate (3HDD) and 3-hydroxy-10-undecylenate (3H10U), via a thiol–ene click reaction. Enhanced hydrophilicity and thermoresponsive property of the resulted PHA-g-PNIPAm were confirmed by water contact angle studies. The biocompatibility of PHA-g-PNIPAm was comparable to poly-3-hydroxybutyrate (PHB). The graft copolymer PHA-g-PNIPAm based on biopolyester PHA could be a promising material for biomedical applications.","author_count":5,"contributors":["Ma, Yi-Ming","Wei, Dai-Xu","Yao, Hui","Wu, Linping","Chen, Guo-Qiang"],"cuid":["S01-000.00-425896"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"synthesis characterization and application of thermoresponsive polyhydroxyalkanoate graft poly n isopropylacrylamide","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-425896","identifier":[{"id":"84981185389","type":"scopus"},{"id":"27350125","type":"pmid"},{"id":"000381231600019","type":"wos"}],"ids":["ku-369d0151-e511-445f-acb5-9f0e556ab26d"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-15351773CA8EF4800D48DF4D8855425A"],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Pharmacy, Nanomedicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Yi-Ming","key":"mapau","last":"Ma","name":"Ma, Yi-Ming","rank":1,"rolecode":"pau"},{"affno":"","first":"Dai-Xu","key":"weipau","last":"Wei","name":"Wei, Dai-Xu","rank":2,"rolecode":"pau"},{"affno":"","first":"Hui","key":"yaopau","last":"Yao","name":"Yao, Hui","rank":3,"rolecode":"pau"},{"affno":"1","first":"Linping","key":"wupau","last":"Wu","locid":"a348b6be-c0ce-42d9-a803-f3a9371a72c4","name":"Wu, Linping","rank":4,"rolecode":"pau"},{"affno":"","first":"Guo-Qiang","key":"chenpau","last":"Chen","name":"Chen, Guo-Qiang","rank":5,"rolecode":"pau"}],"pmid":["27350125"],"pub":{"doi":"10.1021/acs.biomac.6b00724","issn":["15257797","15264602"],"issn_org":["15257797"],"issue":"8","journal":"Biomacromolecules","pages":"2680-2690","status":"p","title":"Biomacromolecules","volume":"17"},"review":"Peer Reviewed","scoID":["2-s2.0-84981185389"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-369d0151-e511-445f-acb5-9f0e556ab26d"],"src":["KU University of Copenhagen"],"title":"Synthesis, Characterization and Application of Thermoresponsive Polyhydroxyalkanoate-graft-Poly(N-isopropylacrylamide)","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-425896","year":"2016","yearsub":"2016"}
{"abstract":"BACKGROUND: In addition to lowering low density lipoprotein cholesterol (LDL-C), statin therapy also raises high density lipoprotein cholesterol (HDL-C) levels. Inter-individual variation in HDL-C response to statins may be partially explained by genetic variation. METHODS AND RESULTS: We performed a meta-analysis of genome-wide association studies (GWAS) to identify variants with an effect on statin-induced high density lipoprotein cholesterol (HDL-C) changes. The 123 most promising signals with p<1×10(-4) from the 16 769 statin-treated participants in the first analysis stage were followed up in an independent group of 10 951 statin-treated individuals, providing a total sample size of 27 720 individuals. The only associations of genome-wide significance (p<5×10(-8)) were between minor alleles at the CETP locus and greater HDL-C response to statin treatment. CONCLUSIONS: Based on results from this study that included a relatively large sample size, we suggest that CETP may be the only detectable locus with common genetic variants that influence HDL-C response to statins substantially in individuals of European descent. Although CETP is known to be associated with HDL-C, we provide evidence that this pharmacogenetic effect is independent of its association with baseline HDL-C levels.","author_count":88,"contributors":["Postmus, Iris","Warren, Helen R","Trompet, Stella","Arsenault, Benoit J","Avery, Christy L","Bis, Joshua C","Chasman, Daniel I","de Keyser, Catherine E","Deshmukh, Harshal A","Evans, Daniel S","Feng, QiPing","Li, Xiaohui","Smit, Roelof A J","Smith, Albert V","Sun, Fangui","Taylor, Kent D","Arnold, Alice M","Barnes, Michael R","Barratt, Bryan J","Betteridge, John","Boekholdt, S Matthijs","Boerwinkle, Eric","Buckley, Brendan M","Chen, Y-D Ida","de Craen, Anton J M","Cummings, Steven R","Denny, Joshua C","Dubé, Marie Pierre","Durrington, Paul N","Eiriksdottir, Gudny","Ford, Ian","Guo, Xiuqing","Harris, Tamara B","Heckbert, Susan R","Hofman, Albert","Hovingh, G Kees","Kastelein, John J P","Launer, Leonore J","Liu, Ching-Ti","Liu, Yongmei","Lumley, Thomas","McKeigue, Paul M","Munroe, Patricia B","Neil, Andrew","Nickerson, Deborah A","Nyberg, Fredrik","O'Brien, Eoin","O'Donnell, Christopher J","Post, Wendy","Poulter, Neil","Vasan, Ramachandran S","Rice, Kenneth","Rich, Stephen S","Rivadeneira, Fernando","Sattar, Naveed","Sever, Peter","Shaw-Hawkins, Sue","Shields, Denis C","Slagboom, P Eline","Smith, Nicholas L","Smith, Joshua D","Sotoodehnia, Nona","Stanton, Alice","Stott, David J","Stricker, Bruno H","Stürmer, Til","Uitterlinden, André G","Wei, Wei-Qi","Westendorp, Rudi G J","Whitsel, Eric A","Wiggins, Kerri L","Wilke, Russell A","Ballantyne, Christie M","Colhoun, Helen M","Cupples, L Adrienne","Franco, Oscar H","Gudnason, Vilmundur","Hitman, Graham","Palmer, Colin N A","Psaty, Bruce M","Ridker, Paul M","Stafford, Jeanette M","Stein, Charles M","Tardif, Jean-Claude","Caulfield, Mark J","Jukema, J Wouter","Rotter, Jerome I","Krauss, Ronald M"],"cuid":["S01-000.00-531347"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"51-200 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD"],"country":["Iceland","Netherlands"],"glorg":["All Global Affiliations","Erasmus University Rotterdam","University of Iceland"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"meta analysis of genome wide association studies of hdl cholesterol response to statins","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-531347","identifier":[{"id":"PMC5309131","type":"pmcid"},{"id":"27587472","type":"pmid"},{"id":"84984996454","type":"scopus"}],"ids":["ku-e6ed0d70-5b1e-40f3-a582-e2a287f26b50"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-