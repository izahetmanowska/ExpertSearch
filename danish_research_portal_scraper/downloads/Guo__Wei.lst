":"pau"},{"affno":"","corresponding":null,"first":"L.","key":"marongiulpau","last":"Marongiu","name":"Marongiu, L.","rank":2008,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"A.","key":"melisapau","last":"Melis","name":"Melis, A.","rank":2009,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"G.","key":"melisgpau","last":"Melis","name":"Melis, G.","rank":2010,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Carlo","key":"migonicarlopau","last":"Migoni","name":"Migoni, Carlo","rank":2011,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Sabrina","key":"miliasabrinapau","last":"Milia","name":"Milia, Sabrina","rank":2012,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Alessandro","key":"navarrinialessandropau","last":"Navarrini","name":"Navarrini, Alessandro","rank":2013,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"A.","key":"orlatiapau","last":"Orlati","name":"Orlati, A.","rank":2014,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"P.","key":"ortuppau","last":"Ortu","name":"Ortu, P.","rank":2015,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"S.","key":"palmasspau","last":"Palmas","name":"Palmas, S.","rank":2016,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"A.","key":"pellizzoniapau","last":"Pellizzoni","name":"Pellizzoni, A.","rank":2017,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"D.","key":"perrodindpau","last":"Perrodin","name":"Perrodin, D.","rank":2018,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"T.","key":"pisanutpau","last":"Pisanu","name":"Pisanu, T.","rank":2019,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"S.","key":"poppispau","last":"Poppi","name":"Poppi, S.","rank":2020,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"S.","key":"righinispau","last":"Righini","name":"Righini, S.","rank":2021,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"A.","key":"sabaapau","last":"Saba","name":"Sab