"key":"gaochenggepau","last":"Gao","name":"Gao, Chengge","rank":21,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Xun","key":"xuxunpau","last":"Xu","name":"Xu, Xun","rank":22,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Huanming","key":"yanghuanmingpau","last":"Yang","name":"Yang, Huanming","rank":23,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Jian","key":"wangjianpau","last":"Wang","name":"Wang, Jian","rank":24,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Yonghui","key":"dangyonghuipau","last":"Dang","name":"Dang, Yonghui","rank":25,"rolecode":"pau"},{"affno":"3 6","first":"Lise","key":"madsenlisepau","last":"Madsen","locid":"194bda7c-3b62-451f-b9b3-6742361fe601","name":"Madsen, Lise","rank":26,"rolecode":"pau"},{"affno":"7","corresponding":null,"country":"dk","first":"Susanne","key":"brixsusannepau","last":"Brix","locid":"12242cd2-44c7-42a3-b384-79b7d898f7a1","name":"Brix, Susanne","orcid":"0000-0001-8951-6705","rank":27,"rolecode":"pau"},{"affno":"3 6","first":"Karsten","key":"kristiansenkarstenpau","last":"Kristiansen","locid":"941041b1-1b8f-4be5-9a65-5e98f662c07e","name":"Kristiansen, Karsten","orcid":"0000-0002-6024-0917","rank":28,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Huijue","key":"jiahuijuepau","last":"Jia","name":"Jia, Huijue","rank":29,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Xiancang","key":"maxiancangpau","last":"Ma","name":"Ma, Xiancang","rank":30,"rolecode":"pau"}],"pmid":["32235826"],"pub":{"doi":"10.1038/s41467-020-15457-9","issn":["20411723"],"issue":"1","journal":"Nature Communications","paperid":"1612","publisher":"Nature Research","status":"p","title":"Nature Communications","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-85082791457"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid"