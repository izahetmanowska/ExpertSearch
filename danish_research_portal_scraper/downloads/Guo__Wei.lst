pau","last":"Fang","name":"Fang, Xianhong","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hongtao","key":"liaopau","last":"Liao","name":"Liao, Hongtao","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yang","key":"liupau","last":"Liu","name":"Liu, Yang","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Wei","key":"weipau","last":"Wei","name":"Wei, Wei","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lu","key":"fupau","last":"Fu","name":"Fu, Lu","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Shulin","key":"wupau","last":"Wu","name":"Wu, Shulin","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yumei","key":"xuepau","last":"Xue","name":"Xue, Yumei","rank":12,"rolecode":"pau"},{"affno":"2 3 4 5","corresponding":null,"country":"dk","first":"Gregory Y H","key":"lippau","last":"Lip","locid":"8fa30e84-7381-41b4-8037-afc032238a3d","name":"Lip, Gregory Y H","rank":13,"rolecode":"pau"}],"pmid":["30174278"],"pub":{"doi":"10.1016/j.ebiom.2018.08.034","issn":["23523964"],"journal":"EBioMedicine","pages":"40-45","publisher":"Elsevier","status":"p","title":"EBioMedicine","volume":"35"},"review":"Peer Reviewed","scoID":["2-s2.0-85052615695"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["aau-59700c9f-5b11-4079-acb8-85ac58ce8064"],"src":["AAU Aalborg University"],"title":"A U-shaped relationship of body mass index on atrial fibrillation recurrence post ablation : A report from the Guangzhou atrial fibrillation ablation registry","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-075985","year":"2018","yearsub":"2018"}
{"abstract":"High-utility itemset mining (HUIM) is an extension of traditional association-rule mining that can find profitable itemsets for decision-making. It faces, however, a limitation since the utility of an itemset increases along with the size of it. High-average utility itemset mining (HAUIM) provides a fair measure to find the average-utility of an itemset, which is more reasonable to design the sales strategies for making the efficient decision. Traditional algorithms of HAUIM mostly focus on mining high average-utility itemsets (HAUIs) from the static database. When the database size is changed, for example, transaction insertion/deletion, the discovered information is required to be updated, thus the updated database is necessary to be re-scanned for identifying the set of HAUIs in the batch manner. In this paper, we present an updating algorithm called FUP-HAUIMD to maintain the discovered HAUIs with transaction deletion. When some transactions in the database are deleted, the designed FUP-HAUIMD algorithm can easily update the discovered HAUIs without scanning the database all the time. The designed FUP-HAUIMD algorithm divides the itemsets into four cases based on the modified fast updated (MFUP) concept. The average-utility (AU)-list structure is further utilized to keep the necessary ramification for later mining progress. Experiments are then conducted to compare the designed FUP-HAUIMD algorithm with the state-of-the-art baseline algorithm running on the batch mode, and the developed approach shows better performance in terms of runtime, number of examined patterns, and scalability.","author_count":5,"contributors":["Lin, Jerry Chun Wei","Shao, Yina","Fournier-Viger, Philippe","Djenouri, Youcef","Guo, Xiangmin"],"cuid":["S01-000.00-643236"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Asia, East","Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Lin, Jerry Chun Wei"],"country":["China","Norway"],"glorg":["All Global Affiliations","Harbin Institute of Technology","Western Norway University of Applied Sciences"],"keyword":["Dynamic database","High average utility mining"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"maintenance algorithm for high average utility itemsets with transaction deletion","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85045673783","version":"Other Version"},"id":"S01-000.00-643236","identifier":[{"id":"85045673783","type":"scopus"}],"ids":["sdu-f4a26601-be81-4c73-8482-2baaada29d3d"],"keyword":["Dynamic database","High average-utility mining","MFUP","Transaction deletion"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-8B3431BE02B76E53F3A54569D4563792"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","country":"cn","key":"harbin institute of technology","loc":["China","Asia, East"],"name":"Harbin Institute of Technology","used":1},{"affno":"2","country":"no","key":"western norway university of applied sciences","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"Western Norway University of Applied Sciences","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Science, Department of Mathematics and Computer Science","SDU, Faculty of Science, Department of Mathematics and Computer Science, Computer Science"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Jerry Chun Wei","key":"linpau","last":"Lin","name":"Lin, Jerry Chun Wei","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yina","key":"shaopau","last":"Shao","name":"Shao, Yina","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Philippe","key":"fourniervigerpau","last":"Fournier-Viger","name":"Fournier-Viger, Philippe","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Youcef","key":"djenouripau","last":"Djenouri","locid":"6139fff5-0e0a-491a-adbb-6fddd9c577f5","name":"Djenouri, Youcef","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Xiangmin","key":"guopau","last":"Guo","name":"Guo, Xiangmin","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1007/s10489-018-1180-8","issn":["0924669X","15737497"],"issn_org":["0924669X"],"issue":"10","journal":"Applied Intelligence","pages":"3691-3706","publisher":"Springer","status":"p","title":"Applied Intelligence","volume":"48"},"review":"Peer Reviewed","scoID":["2-s2.0-85045673783"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-f4a26601-be81-4c73-8482-2baaada29d3d"],"src":["SDU University of Southern Denmark"],"title":"Maintenance algorithm for high average-utility itemsets with transaction deletion","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-643236","year":"2018","yearsub":"2018"}
{"abstract":"We aggregated coding variant data for 81,412 type 2 diabetes cases and 370,832 controls of diverse ancestry, identifying 40 coding variant association signals (P < 2.2 × 10-7); of these, 16 map outside known risk-associated loci. We make two important observations. First, only five of these signals are driven by low-frequency variants: even for these, effect sizes are modest (odds ratio ≤1.29). Second, when we used large-scale genome-wide association data to fine-map the associated variants in their regional context, accounting for the global enrichment of complex trait associations in coding sequence, compelling evidence for coding variant causality was obtained for only 16 signals. At 13 others, the associated coding variants clearly represent 'false leads' with potential to generate erroneous mechanistic inference. Coding variant associations offer a direct route to biological insight for complex diseases and identification of validated therapeutic targets; however, appropriate mechanistic inference requires careful specification of their causal contribution to disease predisposition.","author_count":233,"contributors":["Mahajan, Anubha","Wessel, Jennifer","Willems, Sara M","Zhao, Wei","Robertson, Neil R","Chu, Audrey Y","Gan, Wei","Kitajima, Hidetoshi","Taliun, Daniel","Rayner, N William","Guo, Xiuqing","Lu, Yingchang","Li, Man","Jensen, Richard A","Hu, Yao","Huo, Shaofeng","Lohman, Kurt K","Zhang, Weihua","Cook, James P","Prins, Bram Peter","Flannick, Jason","Grarup, Niels","Trubetskoy, Vassily Vladimirovich","Kravic, Jasmina","Kim, Young Jin","Rybin, Denis V","Yaghootkar, Hanieh","Müller-Nurasyid, Martina","Meidtner, Karina","Li-Gao, Ruifang","Varga, Tibor V","Marten, Jonathan","Li, Jin","Smith, Albert Vernon","An, Ping","Ligthart, Symen","Gustafsson, Stefan","Malerba, Giovanni","Demirkan, Ayse","Tajes, Juan Fernandez","Steinthorsdottir, Valgerdur","Wuttke, Matthias","Lecoeur, Cécile","Preuss, Michael","Bielak, Lawrence F","Graff, Marielisa","Highland, Heather M","Justice, Anne E","Liu, Dajiang J.","Marouli, Eirini","Peloso, Gina Marie","Warren, Helen R.","Afaq, Saima","Afzal, Shoaib","Ahlqvist, Emma","Almgren, Peter","Amin, Najaf","Bang, Lia B.","Bertoni, Alain G.","Bombieri, Cristina","Bork-Jensen, Jette","Brandslund, Ivan","Brody, Jennifer A","Burtt, Noël P.","Canouil, Mickaël","Chen, Yii-Der Ida","Cho, Yoon Shin","Christensen, Cramer","Eastwood, Sophie V.","Eckardt, Kai-Uwe","Fischer, Krista","Gambaro, Giovanni","Giedraitis, Vilmantas","Grove, Megan L","de Haan, Hugoline G","Hackinger, Sophie","Hai, Yang","Han, Sohee","Tybjærg-Hansen, Anne","Hivert, Marie-France","Isomaa, Bo","Jäger, Susanne","Jørgensen, Marit E","Jørgensen, Torben","Käräjämäki, Annemari","Kim, Bong-Jo","Kim, Sung Soo","Koistinen, Heikki A","Kovacs, Peter","Kriebel, Jennifer","Kronenberg, Florian","Läll, Kristi","Lange, Leslie A","Lee, Jung-Jin","Lehne, Benjamin","Li, Huaixing","Lin, Keng-Hung","Linneberg, Allan","Liu, Ching-Ti","Liu, Jun","Loh, Marie","Mägi, Reedik","Mamakou, Vasiliki","McKean-Cowdin, Roberta","Nadkarni, Girish","Neville, Matt","Nielsen, Sune F","Ntalla, Ioanna","Peyser, Patricia A","Rathmann, Wolfgang","Rice, Kenneth","Rich, Stephen S","Rode, Line","Rolandsson, Olov","Schönherr, Sebastian","Selvin, Elizabeth","Small, Kerrin S","Stančáková, Alena","Surendran, Praveen","Taylor, Kent D","Teslovich, Tanya M","Thorand, Barbara","Thorleifsson, Gudmar","Tin, Adrienne","Tönjes, Anke","Varbo, Anette","Witte, Daniel R","Wood, Andrew R","Yajnik, Pranav","Yao, Jie","Yengo, Loïc","Young, Robin","Amouyel, Philippe","Boeing, Heiner","Boerwinkle, Eric","Bottinger, Erwin P","Chowdhury, Rajiv","Collins, Francis S","Dedoussis, George","Dehghan, Abbas","Deloukas, Panos","Ferrario, Marco M","Ferrieres, Jean","Florez, Jose C.","Frossard, Philippe","Gudnason, Vilmundur","Harris, Tamara B","Heckbert, Susan R","Howson, Joanna M M","Ingelsson, Martin","Kathiresan, Sekar","Kee, Frank","Kuusisto, Johanna","Langenberg, Claudia","Launer, Lenore J",