"],"issue":"4","journal":"PLOS ONE","paperid":"e0123081","status":"p","title":"PLOS ONE","title_org":"P L o S One","volume":"10"},"review":"Peer Reviewed","scoID":["2-s2.0-84928603784"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-d66c7a4d-e597-43be-a313-b306afa56429"],"src":["KU University of Copenhagen"],"title":"Identifying human genome-wide CNV, LOH and UPD by targeted sequencing of selected regions","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-521551","year":"2015","yearsub":"2015"}
{"abstract":"In order to solve the problem of the leakage current in non-isolated photovoltaic (PV) systems, a novel six-switch topology and control strategy are proposed in this paper. The inductor-bypass strategy solves the common-mode voltage limitation of the conventional six-switch topology in case of unmatched inductances. And the stray capacitor voltage of the non-isolated photovoltaic system is free of high frequency ripples. Theoretical analysis and simulation are carried out to verify the proposed topology and its control strategy. Results indicate that the leakage current suppression can be achieved with the proposed solution.","author_count":4,"contributors":["Wei, Baoze","Guo, Xiaoqiang","Guerrero, Josep M.","Savaghebi, Mehdi"],"cuid":["S01-000.00-057973"],"event":{"end":"2015-09-04","place":"Guarda, pt","start":"2015-09-01","title":"IEEE 10th International Symposium on Diagnostics for Electrical Machines, Power Electronics and Drives","year":"2015"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","Yanshan University"],"keyword":["Common mode voltage","Grid connected inverter","Leakage current","Non isolated","Photovoltaic power generation"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"leakage current suppression with a novel six switch photovoltaic grid connected inverter","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/210191675/Baoze_Paper.pdf","version":"Pre-print"},"id":"S01-000.00-057973","identifier":[{"id":"84959273331","type":"scopus"}],"ids":["aau-1b0cf183-c605-40b9-85e0-e41ed1049b7d"],"keyword":["Common-mode voltage","Grid-connected inverter","Leakage current","Non-isolated","Photovoltaic power generation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-958CD2F2CCAB39BCC077C21BB7385168"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/210191675/Baoze_Paper.pdf","version":"Pre-print"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (ENG)","Aalborg University, The Faculty of Engineering and Science, AAU Energy","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Power Electronic Systems"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"cn","key":"yanshan university","loc":["China","Asia, East"],"name":"Yanshan University","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Baoze","key":"weipau","last":"Wei","locid":"c1d10e1a-3851-4908-acbf-fe7172fa3a2d","name":"Wei, Baoze","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Xiaoqiang","key":"guopau","last":"Guo","name":"Guo, Xiaoqiang","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Josep M.","key":"guerreropau","last":"Guerrero","locid":"07d2eed6-2177-4f61-b812-a08c55b2e8af","name":"Guerrero, Josep M.","orcid":"0000-0001-5236-4592","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mehdi","key":"savaghebipau","last":"Savaghebi","locid":"7b715a35-2954-4210-b5d1-05e7e074af95","name":"Savaghebi, Mehdi","orcid":"0000-0001-6188-0265","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1109/demped.2015.7303664","isbn":["9781479977437"],"pages":"22-26","publisher":"IEEE Press","status":"p","title":"Proceedings of the 2015 IEEE 10th International Symposium on Diagnostics for Electrical Machines, Power Electronics and Drives (SDEMPED)"},"review":"Peer Reviewed","scoID":["2-s2.0-84959273331"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-1b0cf183-c605-40b9-85e0-e41ed1049b7d"],"src":["AAU Aalborg University"],"title":"Leakage Current Suppression with A Novel Six-Switch Photovoltaic Grid-Connected Inverter","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-057973","year":"2015","yearsub":"2015"}
