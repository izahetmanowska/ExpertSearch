irst":"Qi","key":"zhouqipau","last":"Zhou","name":"Zhou, Qi","rank":16,"rolecode":"pau"}],"pmid":["33406261"],"pub":{"doi":"10.1093/gigascience/giaa142","issn":["2047217X"],"issue":"1","journal":"GigaScience","paperid":"giaa142","status":"p","title":"GigaScience","volume":"10"},"review":"Peer Reviewed","scoID":["2-s2.0-85100230777"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-26e20b5e-3f00-4c47-8e9c-83a6334a12ec"],"src":["KU University of Copenhagen"],"title":"A new duck genome reveals conserved and convergently evolved chromosome architectures of birds and mammals","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-416714","year":"2021","yearsub":"2021"}
{"abstract":"Sulfide precipitation method has been widely used in the removal of arsenic and heavy metals from copper smelting waste acid. Nevertheless, tiny metal sulfide particles are generated during the process, making it difficult to achieve solid-liquid separation as well as solid-solid separation. This study designed an innovative gravitational field-flow fractionation (GFFF) tank to effectively separate fine sulfide precipitate particles of different heavy metals, relying on the difference in particle sizes. To achieve better tank performance, the effects of process conditions on the size variation of precipitate particles produced in metal sulfide precipitation process (Cu(Ⅱ), Zn(Ⅱ), or As(Ⅲ)) were firstly investigated. The results show that supersaturation level, sulfide to metal molar ratio, and pH have significant effects on the precipitate particle size, while reaction time affects slightly. The optimum conditions were identified to achieve the greatest possible differences in particle sizes of the three metal sulfide precipitates. To further analyze its performance, a 3D model of the GFFF tank was built, with the fluid flow field and precipitate particle movement simulated under the optimum conditions. The simulation results demonstrate that the designed GFFF tank can realize efficient separation of fine metal sulfide precipitates for the recovery of valuable metals.","author_count":9,"contributors":["Zeng, Weizhi","Guo, Wenxiang","Li, Bo","Xiao, Ruiyang","Hu, Hui","Yan, Yang","Wu, Lin","Wei, Zongsu","Chai, Liyuan"],"cuid":["S01-000.00-196298"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East"],"corresponding_author":["Xiao, Ruiyang"],"country":["China","Hong Kong"],"glorg":["All Global Affiliations","Central South University","Hong Kong University of Science and Technology"],"keyword":["Size variation"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"experimental and simulation studies of metal sulfide precipitates separation in copper smelting waste acid using a gravitation field flow fractionation method","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85085546715","version":"Other Version"},"id":"S01-000.00-196298","identifier":[{"id":"85085546715","type":"scopus"}],"ids":["au-75394645-cdda-47ba-ab79-dde9ee2a3b98"],"keyword":["Copper smelting waste acid","Fluid flow field","Gravitational field-flow fractionation","Metal sulfide precipitates","Particle movement","Size variation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-36E99F9437C13A3C3DD36B4DA465BB75"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"cn","key":"central south university","loc":["China","Asia, East"],"name":"Central South University","used":1},{"affno":"2","country":"hk","key":"hong kong university of science and technology","loc":["Hong Kong","Asia, East"],"name":"Hong Kong University of Science and Technology","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Engineering, Department of Engineering - Biological and Chemical Engineering, Hangøvej"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Weizhi","key":"zengpau","last":"Zeng","name":"Zeng, Weizhi","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Wenxiang","key":"guopau","last":"Guo","name":"Guo, Wenxiang","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Bo","key":"lipau","last":"Li","name":"Li, Bo","rank":3,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Ruiyang","key":"xiaopau","last":"Xiao","name":"Xiao, Ruiyang","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hui","key":"hupau","last":"Hu","name":"Hu, Hui","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yang","key":"yanpau","last":"Yan","name":"Yan, Yang","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lin","key":"wupau","last":"Wu","name":"Wu, Lin","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Zongsu","key":"weipau","last":"Wei","locid":"e187efc6-abcf-468f-92b6-f27824e33e91","name":"Wei, Zongsu","orcid":"0000-0001-8747-2251","rank":8,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Liyuan","key":"chaipau","last":"Chai","name":"Chai, Liyuan","rank":9,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.jwpe.2020.101330","issn":["22147144"],"journal":"Journal of Water Process Engineering","paperid":"101330","publisher":"Elsevier Ltd","status":"p","title":"Journal of Water Process Engineering","volume":"36"},"review":"Peer Reviewed","scoID":["2-s2.0-85085546715"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-75394645-cdda-47ba-ab79-dde9ee2a3b98"],"src":["AU Aarhus University"],"title":"Experimental and simulation studies of metal sulfide precipitates separation in copper smelting waste acid using a gravitation field-flow fractionation method","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-196298","year":"2020","yearsub":"2020"}
{"abstract":"This study conducted batch and continuous tests to reveal the feasibility of corn stover biochar on improving anaerobic digestion of primary sludge (PS). Dosing biochar (1.82, 2.55 and 3.06 g/g Total Solids (TS)) in digester improved methane content increasing from 67.5% to 81.3–87.3% and enhanced methane production by 8.6–17.8%. Model analysis indicated that biochar accelerated PS hydrolysis and enhanced methane potential of PS. The mechanistic studies showed that biochar enhanced process stability provided by strong buffering capacity and alleviated NH3 inhibition. In continuous test over 116 days, the volatile solids (VS) destruction in the biochar-dosed digester increased by 14.9%, resulting in a 14% reduction in the volume of digestate for disposal. Biochar changed microbial community in an expected direction for anaerobic digestion. This work suggests that biochar technology would apply to co-digestion of WAS and PS to maximize the energy recovery and sludge reduction from the two sludge streams.","author_count":9,"contributors":["Wei, Wei","Guo, Wenshan","Ngo, Huu Hao","Mannina, Giorgio","Wang, Dongbo","Chen, Xueming","Liu, Yiwen","Peng, Lai","Ni, Bing-Jie"],"cuid":["S01-000.00-316852"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East","Europe, EU","OECD","Oceania"],"corresponding_author":["Ni, Bing-Jie"],"country":["Australia","China","Italy"],"glorg":["All Global Affiliations","University of Palermo","University of Technology Sydney","Wuhan University"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"enhanced high quality biomethane production from anaerobic digestion of primary sludge by corn stover biochar","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/256273267/Manuscript_2_.pdf","version":"Authors Final Version"},"id":"S01-000.00-316852","identifier":[{"id":"32182472","type":"pmid"},{"id":"85081652890","type":"scopus"}],"ids":["dtu-294a68cd-932e-4aa6-8945-812e0035ce0b"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-E0F7686113D43227C7BCFBAD174E7206"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/256273267/Manuscript_2_.pdf","version":"Authors Final Version"}],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"au","key":"university of technology sydney","loc":["Australia","Oceania","OECD"],"name":"University of Technology Sydney","used":1},{"affno":"2","country":"it","key":"university of palermo","loc":["Italy","Europe, EU","OECD"],"name":"University of Palermo","used":1},{"affno":"3","country":"cn","key":"wuhan university","loc":["China","Asia, East"],"name":"Wuhan University","used":1},{"affno":"4","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Chemical and Biochemical Engineering","Technical University of Denmark, Department of Chemical and Biochemical Engineering, PROSYS - Process and Systems Engineering Centre"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Wei","key":"weipau","last":"Wei","name":"Wei, Wei","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Wenshan","key":"guopau","last":"Guo","name":"Guo, Wenshan","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Huu Hao","key":"ngopau","last":"Ngo","name":"Ngo, Huu Hao","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Giorgio","key":"manninapau","last":"Mannina","name":"Mannina, Giorgio","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Dongbo","key":"wangpau","last":"Wang","name":"Wang, Dongbo","rank":5,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Xueming","key":"chenpau","last":"Chen","locid":"1de9a180-d9df-4b60-8971-61b3e32d0e76","name":"Chen, Xueming","orcid":"0000-0003-4009-9810","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yiwen","key":"liupau","last":"Liu","name":"Liu, Yiwen","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Lai","key":"pengpau","last":"Peng","name":"Peng, Lai","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Bing-Jie","key":"nipau","last":"Ni","name":"Ni, Bing-Jie","rank":9,"rolecode":"pau"}],"pmid":["32182472"],"pub":{"doi":"10.1016/j.biortech.2020.123159","issn":["09608524","18732976"],"issn_org":["09608524"],"journal":"Bioresource Technology","paperid":"123159","publisher":"Elsevier","status":"p","title":"Bioresource Technology","volume":"306"},"review":"Peer Reviewed","scoID":["2-s2.0-85081652890"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-294a68cd-932e-4aa6-8945-812e0035ce0b"],"src":["DTU Technical University of Denmark"],"title":"Enhanced high-quality biomethane production from anaerobic digestion of primary sludge by corn stover biochar","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-316852","year":"2020","yearsub":"2020"}
{"abstract":"Results from the Collaborative Computational Project in Wave Structure Interaction (CCP-WSI) Blind Test Series 3 are presented. Participants, with numerical methods, ranging from low-fidelity linear models to high-fidelity Navier-Stokes (NS) solvers, simulate the interaction between focused waves and floating structures without prior access to the physical data. The waves are crest-focused NewWaves with various crest heights. Two structures are considered: a hemispherical-bottomed buoy and a truncated cylinder with a moon-pool; both are taut-moored with one linear spring mooring. To assess the predictive capability of each method, numerical results for heave, surge, pitch and mooring load are compared against corresponding physical data. In general, the NS solvers appear to predict the behaviour of the structures better than the linearised methods but there is considerable variation in the results (even between similar methods). Recommendations are made for future comparative studies and development of numerical modelling standards.","author_count":30,"contributors":["Ransley, Edward","Yan, Shiqiang","Brown, Scott","Hann, Martyn","Windt, Christian","Schmitt, Pal","Davidson, Josh","Musiedlak, Pierre Henri","Wang, Jinghua","Wang, Junxian","Ma, Qingwei","Xie, Zhihua","Zhang, Ningbo","Zheng, Xing","Giorgi, Giuseppe","Chen, Hao","Lin, Zaibin","Qian, Ling","Ma, Zhihua","Bai, Wei","Chen, Guo-Qiang","Zang, Jun","Ding, Haoyu","Cheng, Lin","Zheng, Jinhai","Gu, Hanbin","Gong, Xiwu","Liu, Zhenghao","Bingham, Harry B.","Greaves, Deborah"],"cuid":["S01-000.00-362994"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Asia, East","Europe, EU","Europe, Non-EU","OECD"],"country":["China","Hungary","Ireland","Italy","United Kingdom"],"glorg":["All Global Affiliations","Budapest University of Technology and Economics","Cardiff University","Harbin Engineering University","Hohai University","Manchester Metropolitan University","Maynooth University","Polytechnic University of Turin","Queen's University Belfast","Shanghai Jiao Tong University","University of Bath","University of London","University of Plymouth","Zhejiang Gongshang University","Zhejiang Ocean University"],"keyword":["CFD","Code comparison","Cylinder","Hybrid codes","Linear Potential Theory","Numerical validation","PIC","Pitch","Surge","Wave energy convertor"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"a blind comparative study of focused wave interactions with floating structures ccp wsi blind test series 000000000003","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85081623074","version":"Other Version"},"id":"S01-000.00-362994","identifier":[{"id":"85081623074","type":"scopus"}],"ids":["dtu-c36b729c-042d-44b7-8353-fb3f78ee543a"],"keyword":["CFD","Code comparison","Cylinder","Heave","Hybrid codes","Linear potential theory","Moonpool","Mooring load","Nonlinear Froude-Krylov","Numerical validation","PIC","Pitch","Surge","Wave energy convertor"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-D52035D07542CBB8BB97AB0B87F21C83"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"gb","key":"university of plymouth","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Plymouth","used":1},{"affno":"2","country":"gb","key":"university of london","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of London","used":1},{"affno":"3","country":"ie","key":"maynooth university","loc":["Ireland","Europe, EU","OECD"],"name":"Maynooth University","used":1},{"affno":"4","country":"gb","