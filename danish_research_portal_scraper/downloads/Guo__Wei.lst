":"0000-0001-5719-203X","rank":71,"role":"Other","rolecode":"oth"},{"affno":"72","corresponding":null,"first":"Malene Møller","key":"jørgensenoth","last":"Jørgensen","locid":"8838d38e-52f3-42a8-83fd-e3e6342d235c","name":"Jørgensen, Malene Møller","orcid":"0000-0003-1381-3863","rank":72,"role":"Other","rolecode":"oth"},{"affno":"72","corresponding":null,"first":"Maiken","key":"mellergaardoth","last":"Mellergaard","locid":"ba98915c-bd5d-4479-a18e-3c88e5e4e342","name":"Mellergaard, Maiken","orcid":"0000-0001-5854-1086","rank":73,"role":"Other","rolecode":"oth"},{"affno":"74","corresponding":null,"first":"Clotilde","key":"thérypau","last":"Théry","name":"Théry, Clotilde","rank":74,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Kenneth W.","key":"witwerpau","last":"Witwer","name":"Witwer, Kenneth W.","rank":75,"rolecode":"pau"}],"pmid":["38326288"],"pub":{"doi":"10.1002/jev2.12404","issn":["20013078"],"issue":"2","journal":"Journal of Extracellular Vesicles","paperid":"e12404","publisher":"Co-Action Publishing","status":"p","title":"Journal of Extracellular Vesicles","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-85183359756"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","North Denmark Region","Other Research","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-3b384905-e20f-432f-95fd-f2b1e722eec1","au-614fa203-1d82-4191-8dce-12b6b715e4c7","ku-fa9f2555-28a5-4037-a1e9-57e7edf56fd1","sdu-0a9d5704-a076-461f-924a-1e2a8ab2a716"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Minimal information for studies of extracellular vesicles (MISEV2023): From basic to advanced approaches","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-089.33-724098","year":"2024","yearsub":"2024"}
{"abstract":"The proliferation of small-bodied fishes in lakes is often accompanied by deterioration of water quality and ecosystem function. However, the potential impacts of different types of small-bodied fish species (e.g., obligate zooplanktivores and omnivores) on subtropical lake ecosystems in particular have been overlooked mainly due to their small size, shorter life spans and lower economic value. Therefore, we conducted a mesocosm experiment to elucidate how plankton communities and water quality respond to different types of small-bodied fishes, including a common zooplanktivorous fish (thin sharpbelly Toxabramis swinhonis) and other small-bodied omnivorous fishes (bitterling Acheilognathus macropterus, crucian carp Carassius auratus and sharpbelly Hemiculter leucisculus). During the experiment, the mean weekly total nitrogen (TN), total phosphorus (TP), chemical oxygen demand (CODMn), turbidity, chlorophyll-a (Chl.α) and trophic level index (TLI) values were generally higher in treatments where fish were present compared to treatments where fish were absent, but responses varied. At the end of the experiment, phytoplankton abundance and biomass and the relative abundance and biomass of cyanophyta were higher while the abundance and biomass of large-bodied zooplankton were lower in the fish-present treatments. Moreover, the mean weekly TP, CODMn, Chl.α and TLI values were generally higher in treatments with the obligate zooplanktivore, thin sharpbelly, when compared to treatments with omnivorous fishes. Also, the ratio of zooplankton to phytoplankton biomass was the lowest, and the ratio of Chl.α to TP was the highest in treatments with thin sharpbelly. Collectively, these general findings indicate that an overabundance of small-bodied fishes can have adverse effects on water quality and plankton communities and that small-bodied zooplanktivorous fishes likely induce stronger top-down effects on plankton and water quality than omnivorous fishes. Our results emphasise that small-bodied fishes should be monitored and controlled if overabundant when managing or restoring shallow subtropical lakes. From the perspective of environmental protection, the combined stocking of different piscivorous fish species that feed in different habitat types could be a way forward to control small-bodied fishes with different feeding habits, but more research is needed to assess the feasibility of this approach.","author_count":9,"contributors":["Guo, Chao","Li, Shiqi","Ke, Jie","Liao, Chuansong","Hansen, Adam G.","Jeppesen, Erik","Zhang, Tanglin","Li, Wei","Liu, Jiashou"],"cuid":["S01-000.00-161398"],"filters":{"added":"2023-04","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Asia, East","Asia, Middle East","OECD"],"corresponding_author":["Li, Wei"],"country":["China","Turkey","United States"],"glorg":["All Global Affiliations","CAS - Institute of Hydrobiology","Colorado Parks and Wildlife","Middle East Technical University","Sino-Danish Centre for Education and Research","University of Chinese Academy of Sciences"],"keyword":["Ecological restoration","Lake management","Shallow lakes","Top down effects"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"the feeding habits of small bodied fishes mediate the strength of top down effects on plankton and water quality in shallow subtropical lakes","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85147999909","version":"Other Version"},"id":"S01-000.00-161398","identifier":[{"id":"85147999909","type":"scopus"},{"id":"36801569","type":"pmid"}],"ids":["au-382e038e-abe5-4826-8fe4-f82ffd4d2340"],"keyword":["Ecological restoration","Lake management","Shallow lakes","Small-bodied fishes","Top-down effects"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-43198A60270A33A8383FCF635A451092"],"org":[{"affno":"1","country":"cn","key":"cas institute of hydrobiology","loc":["China","Asia, East"],"name":"CAS - Institute of Hydrobiology","used":1},{"affno":"2","country":"cn","key":"university of chinese academy of sciences","loc":["China","Asia, East"],"name":"University of Chinese Academy of Sciences","used":1},{"affno":"3","country":"us","key":"colorado parks and wildlife","loc":["United States","America, North","OECD"],"name":"Colorado Parks and Wildlife","used":1},{"affno":"4","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Ecoscience, Department of Ecoscience - Freshwater Ecology","Aarhus University, Technical Sciences, WATEC, Centre for Water Technology, WATEC, Centre for Water Technology - WATEC Aarhus University Centre for Water Technology, C.F. Møllers Allé 3"],"nora_code":"DI-U-AU","used":1},{"affno":"5","country":"cn","key":"sino danish centre for education and research","loc":["China","Asia, East"],"name":"Sino-Danish Centre for Education and Research","used":1},{"affno":"6","country":"tr","key":"middle east technical university","loc":["Turkey","Asia, Middle East","OECD"],"name":"Middle East Technical University","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Chao","key":"guochaopau","last":"Guo","name":"Guo, Chao","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Shiqi","key":"lishiqipau","last":"Li","name":"Li, Shiqi","rank":2,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Jie","key":"kejiepau","last":"Ke","name":"Ke, Jie","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Chuansong","key":"liaochuansongpau","last":"Liao","name":"Liao, Chuansong","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Adam G.","key":"hansenadamgpau","last":"Hansen","name":"Hansen, Adam G.","rank":5,"rolecode":"pau"},{"affno":"4 5 6","corresponding":null,"country":"dk","first":"Erik","key":"jeppesenerikpau","last":"Jeppesen","locid":"22bb5d6e-a9ae-4f70-81da-df1c57e71163","name":"Jeppesen, Erik","rank":6,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Tanglin","key":"zhangtanglinpau","last":"Zhang","name":"Zhang, Tanglin","rank":7,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Wei","key":"liweipau","last":"Li","name":"Li, Wei","rank":8,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Jiashou","key":"liujiashoupau","last":"Liu","name":"Liu, Jiashou","rank":9,"rolecode":"pau"}],"pmid":["36801569"],"pub":{"doi":"10.1016/j.watres.2023.119705","issn":["00431354","18792448"],"issn_org":["00431354"],"journal":"Water Research","paperid":"119705","publisher":"Elsevier Ltd","status":"p","title":"Water Research","volume":"233"},"review":"Peer Reviewed","scoID":["2-s2.0-85147999909"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-382e038e-abe5-4826-8fe4-f82ffd4d2340"],"src":["AU Aarhus University"],"title":"The feeding habits of small-bodied fishes mediate the strength of top-down effects on plankton and water quality in shallow subtropical lakes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-161398","year":"2023","yearsub":"2023"}
{"abstract":"Groundwater nitrate pollution is a severe environmental problem causing global concern. Among others, autotrophic denitrification on polarized electrodes is one of the energy-efficient and sustainable solutions. However, the poor nitrogen-removal rate severely hinders the application of this process. Herein, biofilms consisted of the symbiotic growth of Geobacter and denitrifying bacteria with interspecies electron transfer ability were formed on carbon paper electrodes through periodic polarity inversion. The biofilm with an inversion period of 12h obtained the highest cathode current density (2.19 A/m2 on average), and the total nitrogen removal rate reached 4.98 g/m2Ca/d, which was an order of magnitude higher than that of the control cathode (current density 0.13 A/m2, total nitrogen removal rate 0.52 g/m2Ca/d). The excellent performance of the biofilms was attributed to the symbiotic interactions between Geobacter and denitrifying bacteria, in which Geobacter transferred electrons from the electrodes to the denitrifying bacteria for denitrification via cytochrome c-like species. Such an electron transfer process was further verified by suppressing current generation and denitrification through dosing either electron transfer inhibitors or denitrifying inhibitors. This work reveals a new extracellular electron transfer mechanism underlying the autotrophic denitrification on the cathode electrode and provides an insight into the development of efficient biocathodes for treating nitrate pollution in groundwater.","author_count":8,"contributors":["Guo, Wei","Ying, Xian-Bin","Zhao, Nan-Nan","Yu, Sheng-Song","Zhang, Xu","Feng, Hua-Jun","Zhang, Yifeng","Yu, Han-Qing"],"cuid":["S01-000.00-339269"],"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Asia, East","OECD"],"corresponding_author":["Feng, Hua-Jun","Zhang, Yifeng"],"country":["China","United States"],"glorg":["All Global Affiliations","Rice University","University of Science and Technology of China","Zhejiang Gongshang University"],"keyword":["Autotrophic denitrification","Bioelectrode","Geobacter","Interspecies electron transfer"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"interspecies electron transfer between i geobacter i and denitrifying bacteria for nitrogen removal in bioelectrochemical system","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/291447861/Interspecies_electron_transfer_between_Geobacter_and_denitrifying_bacteria_for_nitrogen_removal_in_bioelectrochemical_system_Elsevier_Enhanced_Reader.pdf","version":"Authors Final Version"},"id":"S01-000.00-339269","identifier":[{"id":"85144460034","type":"scopus"}],"ids":["dtu-744cbfba-a620-426d-9bc1-2286e4778370"],"keyword":["Autotrophic denitrification","Bioelectrode","Electron transfer pathway","Geobacter","Interspecies electron transfer"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-E9461EB2E7A6C71EC902328267C9D238"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/291447861/Interspecies_electron_transfer_between_Geobacter_and_denitrifying_bacteria_for_nitrogen_removal_in_bioelectrochemical_system_Elsevier_Enhanced_Reader.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","country":"cn","key":"zhejiang gongshang university","loc":["China","Asia, East"],"name":"Zhejiang Gongshang University","used":1},{"affno":"2","country":"cn","key":"university of science and technology of china","loc":["China","Asia, East"],"name":"University of Science and Technology of China","used":1},{"affno":"3","country":"us","key":"rice university","loc":["United States","America, North","OECD"],"name":"Rice University","used":1},{"affno":"4","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Environmental and Resource Engineering","Technical University of Denmark, Department of Environmental and Resource Engineering, Water Technology & Processes"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Wei","key":"guoweipau","last":"Guo","name":"Guo, Wei","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Xian-Bin","key":"yingxianbinpau","last":"Ying","name":"Ying, Xian-Bin","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Nan-Nan","key":"zhaonannanpau","last":"Zhao","name":"Zhao, Nan-Nan","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Sheng-Song","key":"yushengsongpau","last":"Yu","name":"Yu, Sheng-Song","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Xu","key":"zhangxupau","last":"Zhang","name":"Zhang, Xu","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hua-Jun","key":"fenghuajunpau","last":"Feng","name":"Feng, Hua-Jun","rank":6,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Yi-Feng","key":"zhangyifengpau","last":"Zhang","locid":"ce49a7e7-7f82-427b-babf-27d0549e1f8f","name":"Zhang, Yifeng","name_org":"Zhang, Yi-Feng","orcid":"0000-0002-2832-2277","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Han-Qing","key":"yuhanqingpau","last":"Yu","name":"Yu, Han-Qing","rank":8,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.cej.2022.139821","issn":["13858947","18733212"],"issn_org":["13858947"],"journal":"Chemical Engineering Journal","paperi