{"abstract":"I report work on mid-infrared super-continuum generation in chalcogenide fibers and waveguides pumped by 320fsec pulses at 21MHz in the 3-4.6µm range. Average powers of ≈20mW were produced with spectral coverage from <2µm to >11µm.","author_count":19,"contributors":["Luther-Davies, Barry","Yu, Yi","Zhang, Bin","Gai, Xin","Zhai, Chengcheng","Qi, Sisheng","Guo, Wei","Yang, Zhiyong","Wang, Rongping","Choi, Duk-Yong","Madden, Steve","Møller, Uffe Visbech","Kubat, Irnis","Petersen, Christian Rosenberg","Brilland, Laurent","Méchin, David","Caillaud, Celine","Troles, Johann","Bang, Ole"],"cuid":["S01-000.00-330383"],"event":{"end":"2015-07-31","place":"Kauai, us","start":"2015-07-26","title":"Nonlinear Optics 2015","year":"2015"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Asia, East","Europe, EU","OECD","Oceania"],"country":["Australia","China","France"],"glorg":["All Global Affiliations","Australian National University","Jiangsu Normal University","Université de Rennes"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"mid infrared supercontinuum generation from chalcogenide glass waveguides and fibers","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1364/NLO.2015.NTu1A.4","version":"Other Version"},"id":"S01-000.00-330383","identifier":[{"id":"84945952755","type":"scopus"}],"ids":["dtu-56d62de7-4239-4d16-988b-a33374ee5932"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-7DEC317B775DDA2F7E800F243894C730"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1364/NLO.2015.NTu1A.4","version":"Other Version"}],"org":[{"affno":"1","country":"au","key":"australian national univers