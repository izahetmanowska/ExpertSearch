orresponding":null,"first":"Peihong","key":"zhangpeihongpau","last":"Zhang","name":"Zhang, Peihong","rank":18,"rolecode":"pau"}],"pub":{"doi":"10.1103/physrevb.102.140101","issn":["1550235X","24699950"],"issn_org":["24699950"],"issue":"14","journal":"Physical Review B","paperid":"140101","publisher":"American Physical Society","status":"p","title":"Physical Review B","volume":"102"},"review":"Peer Reviewed","scoID":["2-s2.0-85094599362"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-166cc373-a061-4f31-a511-7c8b536e96e5"],"src":["DTU Technical University of Denmark"],"title":"Isosymmetric phase transitions, ultrahigh ductility, and topological nodal lines in α- A g2 S","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-311327","year":"2020","yearsub":"2020"}
{"abstract":"Three-phase PWM rectifiers are adopted extensively in industry because of their excellent properties and potential advantages. However, while the IGBT has an open-circuit fault, the system does not crash suddenly, the performance will be reduced for instance voltages fluctuation and current harmonics. A fault diagnosis method based on deep feedforward network with transient synthetic features is proposed to reduce the dependence on the fault mathematical models in this paper, which mainly uses the transient phase current to train the deep feedforward network classifier. Firstly, the features of fault phase current are analyzed in this paper. Secondly, the historical fault data after feature synthesis is employed to train the deep feedforward network classifier, and the average fault diagnosis accuracy can reach 97.85% for transient synthetic fault data, the classifier trained by the transient synthetic features obtained more than 1% gain in performance compared with original transient features. Finally, the online fault diagnosis experiments show that the method can accurately locate the fault IGBTs, and the final diagnosis result is determined by multiple groups results, which has the ability to increase the accuracy and reliability of the diagnosis results.","author_count":6,"contributors":["Kou, Lei","Liu, Chuang","Cai, Guo-wei","Zhang, Zhe","Zhou, Jia-ning","Wang, Xue-mei"],"cuid":["S01-000.00-329425"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","Northeast Electric Power University"],"keyword":["Deep Feedforward Network","Fault diagnosis","Open circuit fault in IGBT","three phase PWM rectifier"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"fault diagnosis for three phase pwm rectifier based on deep feedforward network with transient synthetic features","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/222640371/Fault_diagnosis_for_three_phase_PWM_rectifier_based_on_deep_feedforward_network_with_transient_synthetic_features_post_print.pdf","version":"Authors Final Version"},"id":"S01-000.00-329425","identifier":[{"id":"31987580","type":"pmid"},{"id":"85078347031","type":"scopus"}],"ids":["dtu-539dbc7e-bdd2-4ee0-b6ef-23cc5d660eca"],"keyword":["Deep feedforward network","Fault diagnosis","Open-circuit fault in IGBT","Three-phase PWM rectifier","Transient synthetic features"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-CBB74EB2D3502F6630A368BEB349EAF2"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/222640371/Fault_diagnosis_for_three_phase_PWM_rectifier_based_on_deep_feedforward_network_with_transient_synthetic_features_post_print.pdf","version":"Authors Final Version"}],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"cn","key":"northeast electric power university","loc":["China","Asia, East"],"name":"Northeast Electric Power University","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Electrical Engineering","Technical University of Denmark, Department of Electrical Engineering, Electronics"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lei","key":"koupau","last":"Kou","name":"Kou, Lei","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Chuang","key":"liupau","last":"Liu","name":"Liu, Chuang","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Guo-wei","key":"caipau","last":"Cai","name":"Cai, Guo-wei","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Zhe","key":"zhangpau","last":"Zhang","locid":"eebd7cda-144d-4f72-a6a7-2e8339aec75e","name":"Zhang, Zhe","orcid":"0000-0001-8407-3167","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jia-ning","key":"zhoupau","last":"Zhou","name":"Zhou, Jia-ning","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Xue-mei","key":"wangpau","last":"Wang","name":"Wang, Xue-mei","rank":6,"rolecode":"pau"}],"pmid":["31987580"],"pub":{"doi":"10.1016/j.isatra.2020.01.023","issn":["00190578"],"journal":"ISA Transactions","pages":"399-407","publisher":"Elsevier","status":"p","title":"ISA Transactions","volume":"101"},"review":"Peer Reviewed","scoID":["2-s2.0-85078347031"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-539dbc7e-bdd2-4ee0-b6ef-23cc5d660eca"],"src":["DTU Technical University of Denmark"],"title":"Fault diagnosis for three-phase PWM rectifier based on deep feedforward network with transient synthetic features","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-329425","year":"2020","yearsub":"2020"}
{"abstract":"MOTIVATION: T and B cell receptors (TCRs and BCRs) play a pivotal role in the adaptive immune system by recognizing an enormous variety of external and internal antigens. Understanding these receptors is critical for exploring the process of immunoreaction and exploiting potential applications in immunotherapy and antibody drug design. Although a large number of samples have had their TCR and BCR repertoires sequenced using high-throughput sequencing in recent years, very few databases have been constructed to store these kinds of data. To resolve this issue, we developed a database. RESULTS: We developed a database, the Pan Immune Repertoire Database (PIRD), located in China National GeneBank (CNGBdb), to collect and store annotated TCR and BCR sequencing data, including from Homo sapiens and other species. In addition to data storage, PIRD also provides functions of data visualization and interactive online analysis. Additionally, a manually curated database of TCRs and BCRs targeting known antigens (TBAdb) was also deposited in PIRD. AVAILABILITY AND IMPLEMENTATION: PIRD can be freely accessed at https://db.cngb.org/pird.","author_count":24,"contributors":["Zhang, Wei","Wang, Longlong","Liu, Ke","Wei, Xiaofeng","Yang, Kai","Du, Wensi","Wang, Shiyu","Guo, Nannan","Ma, Chuanchuan","Luo, Lihua","Wu, Jinghua","Lin, Liya","Yang, Fan","Gao, Fei","Wang, Xie","Li, Tao","Zhang, Ruifang","Saksena, Nitin K.","Yang, Huanming","Wang, Jian","Fang, Lin","Hou, Yong","Xu, Xun","Liu, Xiao"],"cuid":["S01-000.00-486343"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","BGI"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"pird pan immune repertoire database","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"rem","url":"https://www.biorxiv.org/content/biorxiv/early/2019/08/06/399493.full.pdf","version":"Pre-print"},"id":"S01-000.00-486343","identifier":[{"id":"31373607","type":"pmid"},{"id":"85079077505","type":"scopus"}],"ids":["ku-9b657681-e81d-40cd-a175-f8466b243895"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-9E5A19320C3BC75CAC6AE34DCA5867F1"],"oa_link":[{"access":"oa","license":"CC BY","type":"rem","url":"https://www.biorxiv.org/content/biorxiv/early/2019/08/06/399493.full.pdf","version":"Pre-print"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"cn","key":"bgi","loc":["China","Asia, East"],"name":"BGI","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Biology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Wei","key":"zhangweipau","last":"Zhang","name":"Zhang, Wei","rank":1,"rolecode":"pau"},{"affno":"1","first":"Longlong","key":"wanglonglongpau","last":"Wang","name":"Wang, Longlong","rank":2,"rolecode":"pau"},{"affno":"1","first":"Ke","key":"liukepau","last":"Liu","name":"Liu, Ke","rank":3,"rolecode":"pau"},{"affno":"1","first":"Xiaofeng","key":"weixiaofengpau","last":"Wei","name":"Wei, Xiaofeng","rank":4,"rolecode":"pau"},{"affno":"1","first":"Kai","key":"yangkaipau","last":"Yang","name":"Yang, Kai","rank":5,"rolecode":"pau"},{"affno":"1","first":"Wensi","key":"duwensipau","last":"Du","name":"Du, Wensi","rank":6,"rolecode":"pau"},{"affno":"1","first":"Shiyu","key":"wangshiyupau","last":"Wang","name":"Wang, Shiyu","rank":7,"rol