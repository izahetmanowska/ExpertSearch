ocal.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-375163","year":"2023","yearsub":"2023"}
{"abstract":"Anthropogenic nitrogen (N) input has led to elevated levels of nitrate nitrogen (NO3−-N) in the groundwater. However, insights into the responses of the microbial community and its N metabolic functionality to elevated NO3−-N in suburban groundwater are still limited. Here, we explored the microbial taxonomy, N metabolic attributes, and their responses to NO3−-N pollution in groundwaters from Chaobai River catchment (CR) and Huai River catchment (HR) in Beijing, China. Results showed that average NO3−-N and NH4+-N concentrations in CR groundwater were 1.7 and 3.0 folds of those in HR. NO3−-N was the dominant nitrogen specie both in HR and CR groundwater (over 80 %). Significantly different structures and compositions of the microbial communities and N cycling gene profiles were found between CR groundwater and HR groundwater (p < 0.05), with CR groundwater harboring significantly lower microbial richness and abundance of N metabolic genes. However, denitrification was the dominant microbial N cycling process in both CR and HR groundwater. Strong associations among NO3−-N, NH4+-N, microbial taxonomic, and N functional attributes were found (p < 0.05), suggesting denitrifiers and Candidatus_Brocadia might serve as potential featured biomarkers for the elevated NO3−-N and NH4+-N concentration in groundwater. Path analysis further revealed the significant effect of NO3−-N on the overall microbial N functionality and microbial denitrification (p < 0.05). Collectively, our results provide field evidence that elevated levels of NO3−-N and NH4+-N under different hydrogeologic conditions had a significant effect on the microbial taxonomic and N functional attributes in groundwater, with potential implications for improving sustainable N management and risk assessment of groundwater.","author_count":11,"contributors":["Zhang, Ling-Zhi","He, Wei","Huang, Fu-Yi","He, Wei","Zhou, Pengpeng","Chen, Cuibai","Rensing, Christopher","Brandt, Kristian Koefoed","He, Jiangtao","Liu, Fei","Zhao, Yi","Guo, Huaming"],"cuid":["S01-000.00-473472"],"filters":{"added":"2023-05","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","Beijing Municipal Research Institute of Eco-Environmental Protection","China University of Geosciences, Beijing","Chinese Academy of Sciences","Fujian Agriculture and Forestry University","Sino-Danish Center for education and research"],"keyword":["Ammonium","Denitrification","Groundwater","Nitrate"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"response of microbial taxonomic and nitrogen functional attributes to elevated nitrate in suburban groundwater","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-473472","identifier":[{"id":"36868285","type":"pmid"},{"id":"000951620500001","type":"wos"},{"id":"85149938080","type":"scopus"}],"ids":["ku-85ca6a18-c7f9-45f4-b633-5bdcc58a062d"],"keyword":["Ammonium","Denitrification","Groundwater","Microbial nitrogen cycling","Nitrate"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-134BAB97409D7E59B4F58EB5376E7409"],"org":[{"affno":"1","country":"cn","key":"china university of geosciences beijing","loc":["China","Asia, East"],"name":"China University of Geosciences, Beijing","used":1},{"affno":"2","country":"cn","key":"beijing municipal research institute of eco environmental protection","loc":["China","Asia, East"],"name":"Beijing Municipal Research Institute of Eco-Environmental Protection","used":1},{"affno":"3","country":"cn","key":"chinese academy of sciences","loc":["China","Asia, East"],"name":"Chinese Academy of Sciences","used":1},{"affno":"4","country":"cn","key":"fujian agriculture and forestry university","loc":["China","Asia, East"],"name":"Fujian Agriculture and Forestry University","used":1},{"affno":"5","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Plant and Environmental Sciences, Microbial Ecology and Biotechnology"],"nora_code":"DI-U-KU","used":1},{"affno":"6","country":"cn","key":"sino danish center for education and research","loc":["China","Asia, East"],"name":"Sino-Danish Center for education and research","used":1}],"person":[{"affno":"1","first":"Ling-Zhi","key":"zhanglingzhipau","last":"Zhang","name":"Zhang, Ling-Zhi","rank":1,"rolecode":"pau"},{"affno":"2 1","first":"Wei","key":"heweipau","last":"He","name":"He, Wei","rank":2,"rolecode":"pau"},{"affno":"3","first":"Fu-Yi","key":"huangfuyipau","last":"Huang","name":"Huang, Fu-Yi","rank":3,"rolecode":"pau"},{"affno":"1","first":"Pengpeng","key":"zhoupengpengpau","last":"Zhou","name":"Zhou, Pengpeng","rank":5,"rolecode":"pau"},{"affno":"1","first":"Cuibai","key":"chencuibaipau","last":"Chen","name":"Chen, Cuibai","rank":6,"rolecode":"pau"},{"affno":"4","first":"Christopher","key":"rensingchristopherpau","last":"Rensing","name":"Rensing, Christopher","rank":7,"rolecode":"pau"},{"affno":"5 6","first":"Kristian Koefoed","key":"brandtkristiankoefoedpau","last":"Brandt","locid":"c196f0ea-2378-4bc3-bf49-2e64410cbabf","name":"Brandt, Kristian Koefoed","orcid":"0000-0001-7886-9708","rank":8,"rolecode":"pau"},{"affno":"1","first":"Jiangtao","key":"hejiangtaopau","last":"He","name":"He, Jiangtao","rank":9,"rolecode":"pau"},{"affno":"1","first":"Fei","key":"liufeipau","last":"Liu","name":"Liu, Fei","rank":10,"rolecode":"pau"},{"affno":"1","first":"Yi","key":"zhaoyipau","last":"Zhao","name":"Zhao, Yi","rank":11,"rolecode":"pau"},{"affno":"1","first":"Huaming","key":"guohuamingpau","last":"Guo","name":"Guo, Huaming","rank":12,"rolecode":"pau"}],"pmid":["36868285"],"pub":{"doi":"10.1016/j.scitotenv.2023.162524","issn":["00489697","18791026"],"issn_org":["00489697"],"journal":"Science of the Total Environment","paperid":"162524","status":"p","title":"Science of the Total Environment","volume":"874"},"review":"Peer Reviewed","scoID":["2-s2.0-85149938080"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-85ca6a18-c7f9-45f4-b633-5bdcc58a062d"],"src":["KU University of Copenhagen"],"title":"Response of microbial taxonomic and nitrogen functional attributes to elevated nitrate in suburban groundwater","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-473472","year":"2023","yearsub":"2023"}
{"abstract":"Background With advances in massive parallel sequencing (MPS) technology, whole-genome sequencing (WGS) has gradually evolved into the first-tier diagnostic test for genetic disorders. However, deployment practice and pipeline testing for clinical WGS are lacking. Methods In this study, we introduced a whole WGS pipeline for genetic disorders, which included the entire process from obtaining a sample to clinical reporting. All samples that underwent WGS were constructed using polymerase chain reaction (PCR)-free library preparation protocols and sequenced on the MGISEQ-2000 platform. Bioinformatics pipelines were developed for the simultaneous detection of various types of variants, including single nucleotide variants (SNVs), insertions and deletions (indels), copy number variants (CNVs) and balanced rearrangements, mitochondrial (MT) variants, and other complex variants such as repeat expansion, pseudogenes and absence of heterozygosity (AOH). A semiautomatic pipeline was developed for the interpretation of potential SNVs and CNVs. Forty-five samples (including 14 positive commercially available samples, 23 laboratory-held positive cell lines and 8 clinical cases) with known variants were used to validate the whole pipeline. Results In this study, a whole WGS pipeline for genetic disorders was developed and optimized. Forty-five samples with known variants (6 with SNVs and Indels, 3 with MT variants, 5 with aneuploidies, 1 with triploidy, 23 with CNVs, 5 with balanced rearrangements, 2 with repeat expansions, 1 with AOHs, and 1 with exon 7-8 deletion of SMN1 gene) validated the effectiveness of our pipeline. Conclusions This study has been piloted in test development, optimization, and validation of the WGS pipeline for genetic disorders. A set of best practices were recommended using our pipeline, along with a dataset of positive samples for benchmarking.","author_count":19,"contributors":["Yang, Ziying","Yang, Xu","Sun, Yan","Wang, Yaoshen","Song, Lijie","Qiao, Zhihong","Fang, Zhonghai","Wang, Zhonghua","Liu, Lipei","Chen, Yunmei","Yan, Saiying","Guo, Xueqin","Zhang, Junqing","Fan, Chunna","Liu, Fengxia","Peng, Zhiyu","Peng, Huanhuan","Sun, Jun","Chen, Wei"],"cuid":["S01-000.00-669280"],"filters":{"added":"2023-06","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Asia, East"],"corresponding_author":["Chen, Wei","Sun, Jun"],"country":["China"],"glorg":["All Global Affiliations","BGI Group","Pu’er People’s Hospital","University of Chinese Academy of Sciences"],"keyword":["Clinical diagnosis","Genetic disorders","Whole genome sequencing"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"test development optimization and validation of a wgs pipeline for genetic disorders","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12920-023-01495-x","version":"Published Version"},"id":"S01-000.00-669280","identifier":[{"id":"85151805855","type":"scopus"},{"id":"PMC10077614","type":"pmcid"},{"id":"37020281","type":"pmid"}],"ids":["dtu-5de3a7d1-8df7-4f82-9495-fc10940943e7"],"keyword":["Bioinformatics pipelines","Clinical diagnosis","Genetic disorders","Whole genome sequencing"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-B5F7C8169D4990D9B2EF53C8FFB66856"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/318108982/s12920_023_01495_x.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s12920-023-01495-x","version":"Published Version"}],"org":[{"affno":"1","country":"cn","key":"university of chinese academy of sciences","loc":["China","Asia, East"],"name":"University of Chinese Academy of Sciences","used":1},{"affno":"2","country":"cn","key":"pu er people s hospital","loc":["China","Asia, East"],"name":"Pu’er People’s Hospital","used":1},{"affno":"3","country":"cn","key":"bgi group","loc":["China","Asia, East"],"name":"BGI Group","used":1},{"affno":"4","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Biotechnology and Biomedicine","Technical University of Denmark, Department of Biotechnology and Biomedicine, Section for Microbial and Chemical Ecology","Technical University of Denmark, Department of Biotechnology and Biomedicine, Section for Microbial and Chemical Ecology, Bacterial Interactions and Evolution"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Ziying","key":"yangziyingpau","last":"Yang","name":"Yang, Ziying","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Xu","key":"yangxupau","last":"Yang","name":"Yang, Xu","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Yan","key":"sunyanpau","last":"Sun","name":"Sun, Yan","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Yaoshen","key":"wangyaoshenpau","last":"Wang","name":"Wang, Yaoshen","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Lijie","key":"songlijiepau","last":"Song","locid":"f7e5c93a-492f-45b2-992d-e1c2d5c6423b","name":"Song, Lijie","orcid":"0000-0002-0168-3937","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Zhihong","key":"qiaozhihongpau","last":"Qiao","name":"Qiao, Zhihong","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Zhonghai","key":"fangzhonghaipau","last":"Fang","name":"Fang, Zhonghai","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Zhonghua","key":"wangzhonghuapau","last":"Wang","name":"Wang, Zhonghua","rank":8,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Lipei","key":"liulipeipau","last":"Liu","name":"Liu, Lipei","rank":9,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Yunmei","key":"chenyunmeipau","last":"Chen","name":"Chen, Yunmei","rank":10,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Saiying","key":"yansaiyingpau","last":"Yan","name":"Yan, Saiying","rank":11,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Xueqin","key":"guoxueqinpau","last":"Guo","name":"Guo, Xueqin","rank":12,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Junqing","key":"zhangjunqingpau","last":"Zhang","name":"Zhang, Junqing","rank":13,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Chunna","key":"fanchunnapau","last":"Fan","name":"Fan, Chunna","rank":14,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Fengxia","key":"liufengxiapau","last":"Liu","name":"Liu, Fengxia","rank":15,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Zhiyu","key":"pengzhiyupau","last":"Peng","name":"Peng, Zhiyu","rank":16,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Huanhuan","key":"penghuanhuanpau","last":"Peng","name":"Peng, Huanhuan","rank":17,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jun","key":"sunjunpau","last":"Sun","name":"Sun, Jun","rank":18,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Wei","key":"chenweipau","last":"Chen","name":"Chen, Wei","rank":19,"rolecode":"pau"}],"pmid":["37020281"],"pub":{"doi":"10.1186/s12920-023-01495-x","issn":["17558794"],"journal":"BMC Medical Genomics","paperid":"74","publisher":"BioMed Central Ltd.","status":"p","title":"BMC Medical Genomics","volume":"16"},"review":"Peer Reviewed","scoID":["2-s2.0-85151805855"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-5de3a7d1-8df7-4f82-9495-fc10940943e7"],"src":["DTU Technical University of Denmark"],"title":"Test development, optimization and validation of a WGS pipeline for genetic disorders","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-669280","year":"2023","yearsub":"2023"}
{"abstract":"Early-life gut microbial colonization and development exert a profound impact on the health and metabolism of the host throughout the life span. The transmission of microbes from the mother to the offspring affects the succession and establishment of the early-life rumen microbiome in newborns, but the contributions of different maternal sites to the rumen microbial establishment remain unclear. In the present study, samples from different dam sites (namely, oral, rumen fluid, milk, and teat skin) and rumen fluid of yak calves were collected at 6 time points between d 7 and 180 postpartum to determine the contributions of the different maternal sites to the establishment of the bacterial and archaeal communities in the rumen during early life. Our analysis demonstrated that the dam's microbial communities clustered according to the sites, and the calves' rumen microbiota resembled that of the dam consistently regardless of fluctuations at d 7 and 14. The dam's rumen microbiota was the major source of the calves' rumen bacteria (7.9%) and archaea (49.7%) compared with the other sites, whereas the potential sources of the calf rumen microbiota from other sites varied according to the age. The contribution of dam's rumen bacteria increased with age from 0.36% at d 7 to 14.8% at d 180, whereas the contribution of the milk microbiota showed the opposite trend, with its contribution reduced from 2.7% at d 7 to 0.2% at d 180. Maternal oral archaea were the main sources of the calves' rumen archaea at d 14 (50.4%), but maternal rumen archaea became the main source gradually and reached 66.2% at d 180. These findings demonstrated the potential microbial transfer from the dam to the offspring that could influence the rumen microbiota colonization and establishment in yak calves raised under grazing regimens, providing the basis for future microbiota manipulation strategies during their early life.","author_count":8,"contributors":["Guo, Wei","Bi, Sisi","Wang, Weiwei","Zhou, Mi","Alves Neves, Andre Luis","Degen, Abraham Allan","Guan, LeLuo","Long, Ruijin Long"],"cuid":["S01-000.00-678259"],"filters":{"added":"2023-08","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Asia, East","Asia, Middle East","OECD"],"country":["Canada","China","Israel"],"glorg":["All Global Affiliations","Ben-Gurion University of the Negev","Guizhou University","Lanzhou University","University of Alberta"],"keyword":["Rumen microbiota"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"maternal rumen and milk microbiota shapes the establishment of early life rumen microbiota in grazing yak calves","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3168/jds.2022-22655","version":"Published Version"},"id":"S01-000.00-678259","identifier":[{"id":"85147210253","type":"scopus"},{"id":"36710176","type":"pmid"}],"ids":["ku-6107a1b2-d6bf-4d39-bd99-867b0ae22859"],"keyword":["maternal microbial sources","rumen microbiota","source tracker","yak calves"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-B5A5217CB847A17EC28D5E404F2E6616"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3168/jds.2022-22655","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/358112121/1_s2.0_S002203022300036X_main.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"cn","key":"lanzhou university","loc":["China","Asia, East"],"name":"Lanzhou University","used":1},{"affno":"2","country":"cn","key":"guizhou university","loc":["China","Asia, East"],"name":"Guizhou University","used":1},{"affno":"3","country":"ca","key":"university of alberta","loc":["Canada","America, North","OECD"],"name":"University of Alberta","used":1},{"affno":"4","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary and Animal Sciences, Production, Nutrition and Health"],"nora_code":"DI-U-KU","used":1},{"affno":"5","country":"il","key":"ben gurion university of the negev","loc":["Israel","Asia, Middle East","OECD"],"name":"Ben-Gurion University of the Negev","used":1}],"person":[{"affno":"1 2 3","first":"Wei","key":"guopau","last":"Guo","name":"Guo, Wei","rank":1,"rolecode":"pau"},{"affno":"1","first":"Sisi","key":"bipau","last":"Bi","name":"Bi, Sisi","rank":2,"rolecode":"pau"},{"affno":"2","first":"Weiwei","key":"wangpau","last":"Wang","name":"Wang, Weiwei","rank":3,"rolecode":"pau"},{"affno":"3","first":"Mi","key":"zhoupau","last":"Zhou","name":"Zhou, Mi","rank":4,"rolecode":"pau"},{"affno":"4","first":"Andre Luis Alves","key":"nevespau","last":"Neves","locid":"381f5fae-b9b0-439f-b5e2-85888508aabe","name":"Alves Neves, Andre Luis","name_org":"Neves, Andre Luis Alves","orcid":"0000-0002-2617-6210","rank":5,"rolecode":"pau"},{"affno":"5","first":"Abraham Allan","key":"degenpau","last":"Degen","name":"Degen, Abraham Allan","rank":6,"rolecode":"pau"},{"affno":"3","first":"LeLuo","key":"guanpau","last":"Guan","name":"Guan, LeLuo","rank":7,"rolecode":"pau"},{"affno":"1","first":"Ruijin Long","key":"longpau","last":"Long","name":"Long, Ruijin Long","rank":8,"rolecode":"pau"}],"pmid":["36710176"],"pub":{"doi":"10.3168/jds.2022-22655","issn":["00220302","15253198"],"issn_org":["00220302"],"issue":"3","journal":"Journal of Dairy Science","pages":"2054-2070","status":"p","title":"Journal of Dairy Science","volume":"106"},"review":"Peer Reviewed","scoID":["2-s2.0-85147210253"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-6107a1b2-d6bf-4d39-bd99-867b0ae22859"],"src":["KU University of Copenhagen"],"title":"Maternal rumen and milk microbiota shapes the establishment of early-life rumen microbiota in grazing yak calves","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-678259","year":"2023","yearsub":"2023"}
{"abstract":"Background Low-pass genome sequencing (LP GS) is an alternative to chromosomal microarray analysis (CMA). However, validations of LP GS as a prenatal diagnostic test for amniotic fluid are rare. Moreover, sequencing depth of LP GS in prenatal diagnosis has not been evaluated.Objective The diagnostic performance of LP GS was compared with CMA using 375 amniotic fluid samples. Then, sequencing depth was evaluated by downsampling. Results CMA and LP GS had the same diagnostic yield (8.3%, 31/375). LP GS showed all copy number variations (CNVs) detected by CMA and six additional variant of uncertain significance CNVs (>100 kb) in samples with negative CMA results; CNV size influenced LP GS detection sensitivity. CNV detection was greatly influenced by sequencing depth when the CNV size was small or the CNV was located in the azoospermia factor c (AZFc) region of the Y chromosome. Large CNVs were less affected by sequencing depth and more stably detected. There were 155 CNVs detected by LP GS with at least a 50% reciprocal overlap with CNVs detected by CMA. With 25 M uniquely aligned high-quality reads (UAHRs), the detection sensitivity for the 155 CNVs was 99.14%. LP GS using samples with 25 M UAHRs showed the same performance as LP GS using total UAHRs. Considering the detection sensitivity, cost and interpretation workload, 25 M UAHRs are optimal for detecting most aneuploidies and microdeletions/microduplications. Conclusion LP GS is a promising, robust alternative to CMA in clinical settings. A total of 25 M UAHRs are sufficient for detecting aneuploidies and most microdeletions/microduplications.","author_count":26,"contributors":["Qian, Yeqing","Sun, Yan","Guo, Xueqin","Song, Lijie","Sun, Yixi","Gao, Xiaoyang","Liu, Bei","Xu, Yuqing","Chen, Na","Chen, Min","Luo, Yuqin","Qiao, Zhihong","Fan, Linlin","Man, Jianfen","Zhang, Kang","Wang, Xiaoli","Rong, Tingting","Wang, Zhonghua","Liu, Fengxia","Zhao, Jing","Wei, Xiaoming","Chen, Minfeng","Peng, Zhiyu","Peng, Huanhuan","Sun, Jun","Dong, Minyue"],"cuid":["S01-000.00-695193"],"filters":{"added":"2023-11","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Asia, East"],"corresponding_author":["Dong, Minyue","Sun, Jun"],"country":["China"],"glorg":["All Global Affiliations","BGI Group","Zhejiang University"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"validation and depth evaluation of low pass genome sequencing in prenatal diagnosis using 000000000387 amniotic fluid samples","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85159222787","version":"Other Version"},"id":"S01-000.00-695193","identifier":[{"id":"000969533600001","type":"wos"},{"id":"37012053","type":"pmid"},{"id":"85159222787","type":"scopus"}],"ids":["dtu-f6203458-e10e-411b-94e5-cabaa47899d6"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-47D60334B6B154C50DECA0D25D6D157B"],"org":[{"affno":"1","country":"cn","key":"zhejiang university","loc":["China","Asia, East"],"name":"Zhejiang University","used":1},{"affno":"2","country":"cn","key":"bgi group","loc":["China","Asia, East"],"name":"BGI Group","used":1},{"affno":"3","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Biotechnology and Biomedicine","Technical University of Denmark, Department of Biotechnology and Biomedicine, Section for Microbial and Chemical Ecology","Technical University of Denmark, Department of Biotechnology and Biomedicine, Section for Microbial and Chemical Ecology, Bacterial Interactions and Evolution"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Yeqing","key":"qianyeqingpau","last":"Qian","name":"Qian, Yeqing","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Yan","key":"sunyanpau","last":"Sun","name":"Sun, Yan","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Xueqin","key":"guoxueqinpau","last":"Guo","name":"Guo, Xueqin","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Lijie","key":"songlijiepau","last":"Song","locid":"f7e5c93a-492f-45b2-992d-e1c2d5c6423b","name":"Song, Lijie","orcid":"0000-0002-0168-3937","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yixi","key":"sunyixipau","last":"Sun","name":"Sun, Yixi","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Xiaoyang","key":"gaoxiaoyangpau","last":"Gao","name":"Gao, Xiaoyang","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Bei","key":"liubeipau","last":"Liu","name":"Liu, Bei","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yuqing","key":"xuyuqingpau","last":"Xu","name":"Xu, Yuqing","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Na","key":"chennapau","last":"Chen","name":"Chen, Na","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Min","key":"chenminpau","last":"Chen","name":"Chen, Min","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yuqin","key":"luoyuqinpau","last":"Luo","name":"Luo, Yuqin","rank":11,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Zhihong","key":"qiaozhihongpau","last":"Qiao","name":"Qiao, Zhihong","rank":12,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Linlin","key":"fanlinlinpau","last":"Fan","name":"Fan, Linlin","rank":13,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jianfen","