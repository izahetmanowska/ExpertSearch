s Liberation Army","used":1},{"affno":"10","country":"th","key":"siriraj hospital","loc":["Thailand","Asia, South"],"name":"Siriraj Hospital","used":1},{"affno":"11","country":"jp","key":"saiseikai kumamoto hospital","loc":["Japan","Asia, East","OECD"],"name":"Saiseikai Kumamoto Hospital","used":1},{"affno":"12","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine, Aalborg Thrombosis Research Unit"],"nora_code":"DI-U-AAU","used":1},{"affno":"13","country":"gb","key":"liverpool heart and chest hospital nhs foundation trust","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Liverpool Heart and Chest Hospital NHS Foundation Trust","used":1},{"affno":"14","country":"gb","key":"university of liverpool","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Liverpool","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Tze Fan","key":"chaopau","last":"Chao","name":"Chao, Tze Fan","rank":1,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Boyoung","key":"joungpau","last":"Joung","name":"Joung, Boyoung","rank":2,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Yoshihide","key":"takahashipau","last":"Takahashi","name":"Takahashi, Yoshihide","rank":3,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Toon Wei","key":"limpau","last":"Lim","name":"Lim, Toon Wei","rank":4,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Eue Keun","key":"choipau","last":"Choi","name":"Choi, Eue Keun","rank":5,"rolecode":"pau"},{"affno":"7 8","corresponding":null,"first":"Yi Hsin","key":"chanpau","last":"Chan","name":"Chan, Yi Hsin","rank":6,"rolecode":"pau"},{"affno":"9","corresponding":null,"first":"Yutao","key":"guopau","last":"Guo","name":"Guo, Yutao","rank":7,"rolecode":"pau"},{"affno":"10","corresponding":null,"first":"Charn","key":"sriratanasathavornpau","last":"Sriratanasathavorn","name":"Sriratanasathavorn, Charn","rank":8,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Seil","key":"ohpau","last":"Oh","name":"Oh, Seil","rank":9,"rolecode":"pau"},{"affno":"11","corresponding":null,"first":"Ken","key":"okumurapau","last":"Okumura","name":"Okumura, Ken","rank":10,"rolecode":"pau"},{"affno":"12 13 14","corresponding":null,"country":"dk","first":"Gregory Y.H.","key":"lippau","last":"Lip","locid":"8fa30e84-7381-41b4-8037-afc032238a3d","name":"Lip, Gregory Y H","name_org":"Lip, Gregory Y.H.","rank":11,"rolecode":"pau"}],"pmid":["34887945"],"pub":{"doi":"10.1002/joa3.12652","issn":["18804276"],"issue":"6","journal":"Journal of Arrhythmia","pages":"1389-1426","publisher":"Wiley-Blackwell","status":"p","title":"Journal of Arrhythmia","volume":"37"},"review":"Peer Reviewed","scoID":["2-s2.0-85119258572"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-327491d0-d203-4221-977d-c7eb5067e4db"],"src":["AAU Aalborg University"],"title":"2021 Focused update of the 2017 consensus guidelines of the Asia Pacific Heart Rhythm Society (APHRS) on stroke prevention in atrial fibrillation","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-064665","year":"2021","yearsub":"2021"}
{"abstract":"The production of fine particles from extremely high supersaturation has challenged the application of sulfide precipitation in treating heavy metal wastewater due to the difficulty of solid-liquid separation. To this end, a gas-liquid sulfide precipitation reactor for the removal of Cu2+ was designed by controlling the mass transfer and supersaturation levels during sulfidation processes. Particularly, a computational fluid dynamics (CFD) model of the reactor, integrating sulfidation reaction kinetics with two-phase flow hydrodynamics, was first built, followed by examining the effects of H2S(g) bubble diameter and flow rate. Based on the CFD simulation, the rate-limiting step of the gas-liquid sulfide precipitation reaction is the gas-liquid mass transfer process. Either reducing H2S(g) bubble diameter or increasing H2S(g) flow rate can result in the control of reaction rate and supersaturation level in the system. In order to validate the CFD simulations, we measured Cu2+ concentrations during the sulfidation process with the batch experiments. The agreement between computational and experimental results indicated that our mechanistic model can provide a protocol for the design and optimization of the reaction system, allowing one to visualize the time-dependent reaction process and evaluate the performance of a reactor.","author_count":6,"contributors":["Zeng, Weizhi","Guo, Wenxiang","Li, Bo","Wei, Zongsu","Dionysiou, Dionysios D.","Xiao, Ruiyang"],"cuid":["S01-000.00-203825"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Asia, East","OECD"],"corresponding_author":["Xiao, Ruiyang"],"country":["China","Hong Kong","United States"],"glorg":["All Global Affiliations","Central South University","Hong Kong University of Science and Technology","University of Cincinnati"],"keyword":["CFD","Gas liquid mass transfer","Heavy metal wastewater"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"kinetics and mechanistic aspects of removal of heavy metal through gas liquid sulfide precipitation a computational and experimental study","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85098946629","version":"Other Version"},"id":"S01-000.00-203825","identifier":[{"id":"85098946629","type":"scopus"},{"id":"33418520","type":"pmid"}],"ids":["au-8260ada8-ad11-4e6e-af57-00e3c49c4dcb"],"keyword":["CFD","Gas-liquid mass transfer","Heavy metal wastewater","Sulfide precipitation","Supersaturation level"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-01A4A9B56FABFB15D9C4591A6E8A91CB"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"cn","key":"central south university","loc":["China","Asia, East"],"name":"Central South University","used":1},{"affno":"2","country":"hk","key":"hong kong university of science and technology","loc":["Hong Kong","Asia, East"],"name":"Hong Kong University of Science and Technology","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, WATEC, Centre for Water Technology, WATEC, Centre for Water Technology - WATEC Aarhus University Centre for Water Technology, Hangøvej"],"nora_code":"DI-U-AU","used":1},{"affno":"4","country":"us","key":"university of cincinnati","loc":["United States","America, North","OECD"],"name":"University of Cincinnati","used":1},{"affno":