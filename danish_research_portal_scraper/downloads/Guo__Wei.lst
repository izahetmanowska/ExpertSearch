ng","name":"Wang, Xiangdong","rank":14,"rolecode":"pau"},{"affno":"1 2","first":"Xun","key":"xuxunpau","last":"Xu","name":"Xu, Xun","rank":15,"rolecode":"pau"},{"affno":"1 6 8","first":"Chuanyu","key":"liuchuanyupau","last":"Liu","name":"Liu, Chuanyu","rank":16,"rolecode":"pau"},{"affno":"1","first":"Xin","key":"jinxinpau","last":"Jin","name":"Jin, Xin","rank":17,"rolecode":"pau"}],"pmid":["40734184"],"pub":{"doi":"10.1186/s13059-025-03697-1","issn":["14747596","1474760X"],"issn_org":["14747596"],"journal":"Genome Biology","paperid":"230","status":"p","title":"Genome Biology","volume":"26"},"review":"Peer Reviewed","scoID":["2-s2.0-105011985542"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-d7184aac-5738-44b1-8607-1348540dbb3b"],"src":["KU University of Copenhagen"],"title":"SpaSEG : unsupervised deep learning for multi-task analysis of spatially resolved transcriptomics","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-829988","year":"2025","yearsub":"2025"}
{"abstract":"Per- and polyfluoroalkyl substances (PFAS) have recently attracted much attention from the public and scientific community due to their undesirable effects to humans, animals and potential for bioaccumulation. Finding possible biological methods for removal and degradation is a critical step to develop environmentally benign approaches to manage their environmental fate, especially in contaminated water bodies. In this study, we demonstrate that perfluorooctanoic acid (PFOA), a model PFAS, can be effectively degraded by enzyme catalyzed oxidative humification reactions (ECOHRs), using 1-hydroxybenzotriazole (HBT) as reaction mediator and laccase from Agaricus bisporus in a continuous reaction at room temperature. Fluoride ions were detected in the reaction samples, indicating the overall defluorination of initial PFOA was up to 95 % in high-concentration enzyme treatment after 55 days. Correspondingly, a significant decrease of the PFOA concentration was observed in respect to the enzyme treatment. Liquid chromatograph-mass spectrometry (LC-MS) analysis also revealed shorter carbon-chain perfluorocarboxylic acids, partially fluorinated shorter-chain alcohols and aldehydes as degradation products. These partially fluorinated compounds have resulted from PFOA degradation via a combination of decarboxylation, free radical reactions, reductive defluorination, rearrangement, and coupling processes. These findings prove that PFOA is degraded and transformed during humification, suggesting that the laccase-catalyzed reactions can potentially be used for the bioremediation of PFOA and other PFAS in aqueous environments.","author_count":6,"contributors":["Mekureyaw, Mengistu Fentahun","Junker, A","Bai, Lu","Petersen, Amalie Elfving","Wei, Zongsu","Guo, Zheng"],"cuid":["S02-100.00-822781"],"filters":{"added":"2025-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Guo, Zheng","Wei, Zongsu"],"keyword":["Biodegradation","Defluorination","Laccase","Mediator","Perfluorooctanoic acid"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-DTU"]},"level3all":["DI-U-AU","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"biodegradation of perfluorooctanoic acid pfoa by laccase from i agaricus bisporus i via oxidative decarboxylation","src":["au","dtu"],"src-code":["DI-U-AU","DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1016/j.hazadv.2025.100837","version":"Published Version"},"funding_acknowledgement":["This work was supported by the project from Novo Nordisk Foundation (grant no NNF16OC0064799)."],"id":"S02-100.00-822781","identifier":[{"id":"105011870139","type":"scopus"}],"ids":["au-fe2c8b48-fe08-4200-b717-fc6e0cfb4014","dtu-aae63d11-2581-4fde-a3fc-f5c9506911be"],"keyword":["Biodegradation","Defluorination","Laccase","Mediator","Perfluorooctanoic acid"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-C6D5E760076AEB5213210A18FD99251A"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/408973882/1-s2.0-S2772416625002487-main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1016/j.hazadv.2025.100837","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Biological and Chemical Engineering, Department of Biological and Chemical Engineering - Industrial Biotechnology - Gustav Wieds Vej 10D"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Environmental and Resource Engineering","Technical University of Denmark, Department of Environmental and Resource Engineering, Water Technology & Processes"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"Mengistu Fentahun","key":"mekureyawpau","last":"Mekureyaw","locid":"c88f3a9f-b718-4bd5-82ba-60efa8f32c2c","name":"Mekureyaw, Mengistu Fentahun","orcid":"0000-0001-6280-0212","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"A","key":"junkerpau","last":"Junker","locid":"3a65a648-be0f-4d19-9dc5-d15aa6e62858","name":"Junker, A","orcid":"0000-0002-5712-7075","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lu","key":"baipau","last":"Bai","locid":"98807f94-3f22-46b7-b302-901f47b0b0e4","name":"Bai, Lu","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Amalie Elfving","key":"petersenpau","last":"Petersen","locid":"e6c27e67-c52d-48ed-a6f9-81e1e47234d0","name":"Petersen, Amalie Elfving","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Zongsu","key":"weipau","last":"Wei","locid":"e187efc6-abcf-468f-92b6-f27824e33e91","name":"Wei, Zongsu","orcid":"0000-0001-8747-2251","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Zheng","key":"guopau","last":"Guo","locid":"67372258-2bc9-4585-98c9-1b93c60d0ca9","name":"Guo, Zheng","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.hazadv.2025.100837","issn":["27724166"],"journal":"Journal of Hazardous Materials Advances","pages":"1-11","paperid":"100837","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"p","title