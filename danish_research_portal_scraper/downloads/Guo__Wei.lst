tral","status":"p","title":"Genome Biology","volume":"23"},"review":"Peer Reviewed","scoID":["2-s2.0-85144774123"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-e7bba477-7adc-4e31-9042-ab6d9ff0d9a2","sdu-a82d0232-3b4d-4e7e-82db-1ed5ae20d9e7"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Implicating genes, pleiotropy, and sexual dimorphism at blood lipid loci through multi-ancestry meta-analysis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-047005","year":"2022","yearsub":"2022"}
{"abstract":"Transformerless inverters, most of which are H-bridge inverters, have been widely used and studied in grid-connected power systems in the last decades. However, the H-bridge inverter is affected by the low- and high-frequency common-mode voltage between the input and output terminals, resulting in a large common-mode leakage current. An alternative solution is to connect the ground of the input terminal to the output load or grid, that is, the dual-grounded inverter. In this case, the low- and high-frequency common-mode voltages can be mitigated or eliminated. As a matter of fact, scholars have made several research results on dual-grounded inverters. However, as of now, there is still no literature that comprehensively and systematically summarizes these research results. To fill this gap, this article classifies different types of dual-grounded inverters from the perspective of topology for the first time, and compares and summarizes their advantages and disadvantages. More than 60 works of literature have been reviewed to identify the practical implementation challenges and research opportunities in the application of dual-grounded inverters.","author_count":8,"contributors":["Guo, Xiaoqiang","Zhang, Han","Tang, Wei","Lu, Zhigang","Hua, Changchun","Siwakoti, Yam P.","Malinowski, Mariusz","Blaabjerg, Frede"],"cuid":["S01-000.00-120306"],"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East","Europe, EU","OECD","Oceania"],"country":["Australia","China","Poland"],"glorg":["All Global Affiliations","Hunan University","University of Technology Sydney","Warsaw University of Technology","Yanshan University"],"keyword":["Common mode voltage","Leakage current","Transformerless inverter","dual grounded inverter"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"overview of recent advanced topologies for transformerless dual grounded inverters","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/645106102/Overview_of_Recent_Advanced_Topologies_for_Transformerless_Dual-Grounded_Inverters.pdf","version":"Authors Final Version"},"id":"S01-000.00-120306","identifier":[{"id":"85129667483","type":"scopus"}],"ids":["aau-f1a799c2-b3f9-42d5-a72d-7aaa1cbcf40a"],"keyword":["Common-mode voltage","dual-grounded inverter","leakage current","transformerless inverter"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-FE415C1A9CCE551B5317AE62452E182A"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/645106102/Overview_of_Recent_Advanced_Topologies_for_Transformerless_Dual-Grounded_Inverters.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"cn","key":"yanshan university","loc":["China","Asia, East"],"name":"Yanshan University","used":1},{"affno":"2","country":"cn","key":"hunan university","loc":["China","Asia, East"],"name":"Hunan University","used":1},{"affno":"3","country":"au","key":"university of technology sydney","loc":["Australia","Oceania","OECD"],"name":"University of Technology Sydney","used":1},{"affno":"4","country":"pl","key":"warsaw university of technology","loc":["Poland","Europe, EU","OECD"],"name":"Warsaw University of Technology","used":1},{"affno":"5","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, AAU Energy","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Applied Power Electronic Systems","Aalborg University, The Faculty of Engineering and Science, AAU Energy, E-Mobility and Drives","Aalborg University, The Faculty of Engineering and Science, AAU Energy, EMI/EMC in Power Electronics","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Electric Power Systems and Microgrids","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Photovoltaic Systems","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Power Electronic Control, Reliability and System Optimization","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Wind Power Systems"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Xiaoqiang","key":"guopau","last":"Guo","name":"Guo, Xiaoqiang","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Han","key":"zhangpau","last":"Zhang","name":"Zhang, Han","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Wei","key":"tangpau","last":"Tang","name":"Tang, Wei","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Zhigang","key":"lupau","last":"Lu","name":"Lu, Zhigang","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Changchun","key":"huapau","last":"Hua","name":"Hua, Changchun","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Yam P.","key":"siwakotipau","last":"Siwakoti","name":"Siwakoti, Yam P.","rank":6,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Mariusz","key":"malinowskipau","last":"Malinowski","name":"Malinowski, Mariusz","rank":7,"rolecode":"pau"},{"affno":"5","corresponding":null,"country":"dk","first":"Frede","key":"blaabjergpau","last":"Blaabjerg","locid":"22b09e36-1f7b-4d33-90bf-918730e1d09a","name":"Blaabjerg, Frede","orcid":"0000-0001-8311-7412","rank":8,"rolecode"