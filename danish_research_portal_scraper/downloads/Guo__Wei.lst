lepau","last":"Bochud","name":"Bochud, Murielle","rank":45,"rolecode":"pau"},{"affno":"","first":"Devin","key":"absherdevinpau","last":"Absher","name":"Absher, Devin","rank":46,"rolecode":"pau"},{"affno":"","first":"Linda S","key":"adairlindaspau","last":"Adair","name":"Adair, Linda S","rank":47,"rolecode":"pau"},{"affno":"","first":"Najaf","key":"aminnajafpau","last":"Amin","name":"Amin, Najaf","rank":48,"rolecode":"pau"},{"affno":"3","first":"Inger","key":"njølstadingerpau","last":"Njølstad","name":"Njølstad, Inger","rank":49,"rolecode":"pau"},{"affno":"4","first":"Peter E H","key":"schwarzpeterehpau","last":"Schwarz","name":"Schwarz, Peter E H","rank":50,"rolecode":"pau"}],"pmid":["27618452"],"pub":{"doi":"10.1038/ng.3667","issn":["10614036","15461718"],"issn_org":["10614036"],"issue":"10","journal":"Nature Genetics","pages":"1171-1184","status":"p","title":"Nature Genetics","volume":"48"},"review":"Peer Reviewed","scoID":["2-s2.0-84987625495"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-bad5956f-828d-4ad3-b536-c74344c97768"],"src":["KU University of Copenhagen"],"title":"The genetics of blood pressure regulation and its target organs from association studies in 342,415 individuals","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-504973","year":"2016","yearsub":"2016"}
{"abstract":"Polyhydroxyalkanoates (PHA) are a family of diverse biopolyesters produced by many bacteria grown on sustainable bio-resources such as glucose or fatty acids. A PHA copolymer P(3HDD-co-3H9D) consisting of 3-hydroxydodecanoate (3HDD) and 3-hydroxy-9-decenoate (3H9D) was synthesized by the engineered bacterium Pseudomonas entomophila. The PHA was used to generate a comb-like temperature-responsive graft polymer P(3HDD-co-3H9D)-g-poly(2-dimethylamino-ethylmethacrylate), abbreviated as (PHA-g-PDMAEMA), via a three-step reaction developed for this study. Uniform “side chain” PDMAEMA oligomers were first prepared via reversible addition–fragmentation chain transfer (RAFT) polymerization. Each PDMAEMA oligomer was subsequently added with a thiol group at the end of the chain via aminolysis. Thiol PDMAEMA was then grafted onto unsaturated P(3HDD-co-3H9D), with a tunable grafting density from 2.5 to 10 mol%. Graft copolymer PHA-g-PDMAEMA showed enhanced thermal stability, biocompatibility and controllable hydrophilicity compared with non-grafted P(3HDD-co-3H9D). The grafted material presented an obvious tendency of increasing protein adsorptions over the lower critical solution temperature (LCST 47.5 °C) on PHA-g-PDMAEMA with an increasing percentage of DMAEMA in the copolymers. At a temperature below LCST, PHA-g-PDMAEMA presented poor protein absorption in contrast to P(3HDD-co-3H9D). The temperature-responsive properties of the comb-like graft polymer PHA-g-PDMAEMA can be manipulated toward controllable protein adsorption for biomedical usages.","author_count":8,"contributors":["Yao, Hui","Wei, Daixu","Che, Xuemei","Cai, Longwei","Tao, Lei","Liu, Lei","Wu, Linping","Chen, Guo-Qiang"],"cuid":["S01-000.00-537085"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"comb like temperature responsive polyhydroxyalkanoate graft poly 000000000002 dimethylamino ethylmethacrylate for controllable protein adsorption","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-537085","identifier":[{"id":"84989253846","type":"scopus"},{"id":"000385568900007","type":"wos"}],"ids":["ku-f0c19266-0641-4e65-8d50-a87a690f7409"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-3AF970A04EAF00ACD9CDBC0EC3CFBA3B"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Pharmacy, Nanomedicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Hui","key":"yaopau","last":"Yao","name":"Yao, Hui","rank":1,"rolecode":"pau"},{"affno":"","first":"Daixu","key":"weipau","last":"Wei","name":"Wei, Daixu","rank":2,"rolecode":"pau"},{"affno":"","first":"Xuemei","key":"chepau","last":"Che","name":"Che, Xuemei","rank":3,"rolecode":"pau"},{"affno":"","first":"Longwei","key":"caipau","last":"Cai","name":"Cai, Longwei","rank":4,"rolecode":"pau"},{"affno":"","first":"Lei","key":"taopau","last":"Tao","name":"Tao, Lei","rank":5,"rolecode":"pau"},{"affno":"","first":"Lei","key":"liupau","last":"Liu","name":"Liu, Lei","rank":6,"rolecode":"pau"},{"affno":"1","first":"Linping","key":"wupau","last":"Wu","locid":"a348b6be-c0ce-42d9-a803-f3a9371a72c4","name":"Wu, Linping","rank":7,"rolecode":"pau"},{"affno":"","first":"Guo-Qiang","key":"chenpau","last":"Chen","name":"Chen, Guo-Qiang","rank":8,"rolecode":"pau"}],"pub":{"doi":"10.1039/c6py01235c","issn":["17599954","17599962"],"issn_org":["17599954"],"issue":"38","journal":"Polymer Chemistry","pages":"5957-5965","status":"p","title":"Polymer Chemistry","volume":"7"},"review":"Peer Reviewed","scoID":["2-s2.0-84989253846"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-f0c19266-0641-4e65-8d50-a87a690f7409"],"src":["KU University of Copenhagen"],"title":"Comb-like temperature-responsive polyhydroxyalkanoate-graft-poly(2-dimethylamino-ethylmethacrylate) for controllable protein adsorption","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-537085","year":"2016","yearsub":"2016"}
{"abstract":"This paper describes a theoretical with experiment study on a control strategy for the parallel operation of threephase voltage source inverters (VSI), to be applied to uninterruptible power systems (UPS). A circulating current suppression strategy for parallel VSIs is proposed in this paper based on circulating current control loops used to modify the reference currents by compensating the error currents among parallel inverters. Both of the cross and zero-sequence circulating currents are considered. The proposed method is coordinated together with droop and virtual impedance control. In this paper, droop control is used to generate the reference voltage of each inverter, and the virtual impedance is used to fix the output impedance of the inverters. In addition, a secondary control is used in order to recover the voltage deviation caused by the virtual impedance. And the auxiliary current control loop is added to acquire a better average current sharing performance among parallel VSIs, which can effectively suppress both of the cross and zero-sequence circulating currents. Experimental results are presented in order to verify the effectiveness of the proposed control strategy.","author_count":4,"contributors":["Wei, Baoze","Guerrero, Josep M.","Vasquez, Juan C.","Guo, Xiaoqiang"],"cuid":["S01-000.00-057565"],"event":{"end":"2016-09-22","place":"Milwaukee, WI, us","start":"2016-09-18","title":"8th Annual IEEE Energy Conversion Congress &amp; Exposition","year":"2016"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","Yanshan University"],"keyword":["Common DC and AC buses","Cross circulating current","Parallel connected","Uninterruptible power system","Voltage source inverter","Zero sequence"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"a circulating current suppression method for parallel connected voltage source inverters vsi with common dc and ac buses","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/244530726/ECCE2016_A_Circulating_Current_Suppression_Method_for_Parallel_Connected.._.pdf","version":"Pre-print"},"id":"S01-000.00-057565","identifier":[{"id":"85015397978","type":"scopus"}],"ids":["aau-19a82d1d-ccc1-4a0b-bd37-b52affe602ea"],"keyword":["Common DC and AC buses","Cross circulating current","Parallel connected","Uninterruptible power system","Voltage source inverter","Zero-sequence"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-5DC34373143393EB9596310CA06AFEEA"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/244530726/ECCE2016_A_Circulating_Current_Suppression_Method_for_Parallel_Connected.._.pdf","version":"Pre-print"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (ENG)","Aalborg University, The Faculty of Engineering and Science, AAU Energy","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Power Electronic Systems"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"cn","key":"yanshan university","loc":["China","Asia, East"],"name":"Yanshan University","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Baoze","key":"weipau","last":"Wei","locid":"c1d10e1a-3851-4908-acbf-fe7172fa3a2d","name":"Wei, Baoze","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Josep M.","key":"guerr