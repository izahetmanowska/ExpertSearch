rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jirong","key":"longjirongpau","last":"Long","name":"Long, Jirong","rank":144,"rolecode":"pau"}],"pmid":["30054336"],"pub":{"doi":"10.1158/0008-5472.can-18-0951","issn":["00085472","05766656"],"issn_org":["00085472"],"issue":"18","journal":"Cancer Research","pages":"5419-5430","publisher":"American Association for Cancer Research Inc.","status":"p","title":"Cancer Research","volume":"78"},"review":"Peer Reviewed","scoID":["2-s2.0-85053297183"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Non-Profit Organisations","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-NP","DI-NP-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Non-Profit Organisations","Other Research","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-aa6361e4-26db-4f50-b003-40c95a79f137","sdu-e7580747-9544-4bff-afa8-39ef71f3abb9"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"A Transcriptome-Wide Association Study Among 97,898 Women to Identify Candidate Susceptibility Genes for Epithelial Ovarian Cancer Risk","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-098.96-045197","year":"2018","yearsub":"2018"}
{"abstract":"Silver nanoparticles (AgNPs) are widely used in health and consumer products that routinely contact skin. However, the biological effects and possible mechanisms of AgNPs on skin remain unclear. Gap junctional intercellular communication (GJIC) plays a critical role in multicellular organisms to maintain tissue homeostasis. The aim of this study is to examine if non-coated AgNPs affect GJIC in human keratinocytes (HaCaT cells), and to identify the possible molecular mechanisms responsible for the effects. GJIC, connexin (Cx)43 protein and mRNA expression, and the effect of siRNA-mediated knockdown of Cx43 on GJIC were assessed. HaCaT cells exposed to non-coated AgNPs at different doses after a 24 hour exposure. To explore further the underlying mechanism, reactive oxygen species and mitogen-activated protein kinase pathway were evaluated after 2, 6, 12 and 24 hours. Our results revealed that non-coated AgNP exposure at subcytotoxic doses increase GJIC partially via Cx43 upregulation. Reactive oxygen species and extracellular signal-regulated kinase and activation of c-Jun N-terminal kinase were involved in the AgNP-induced upregulation of Cx43. This study provides new insight into the potential mechanism of AgNP biological activity.","author_count":9,"contributors":["Qin, Yu","Han, Limin","Yang, Di","Wei, Hongying","Liu, Yue","Xu, Junhui","Autrup, Herman","Deng, Furong","Guo, Xinbiao"],"cuid":["S01-000.00-240989"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","Peking University"],"keyword":["Connexin43","Journal Article","MAP kinases","Reactive oxygen species","Silver nanoparticles"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"silver nanoparticles increase connexin000000000043 mediated gap junctional intercellular communication in hacat cells through activation of reactive oxygen species and mitogen activated protein kinase signal pathway","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85042105901","version":"Other Version"},"id":"S01-000.00-240989","identifier":[{"id":"85042105901","type":"scopus"},{"id":"29235124","type":"pmid"}],"ids":["au-c3ac7ffc-a425-4372-8d74-444eebead804"],"keyword":["Connexin43","Journal Article","MAP kinases","gap junctional intercellular communication","reactive oxygen species","silver nanoparticles"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-A15F43E7DE4621BC6EB102C14E00C438"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","country":"cn","key":"peking university","loc":["China","Asia, East"],"name":"Peking University","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Public Health, Department of Public Health - Institute of Environmental and Occupational Medicine"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Yu","key":"qinpau","last":"Qin","name":"Qin, Yu","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Limin","key":"hanpau","last":"Han","name":"Han, Limin","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Di","key":"yangpau","last":"Yang","name":"Yang, Di","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hongying","key":"weipau","last":"Wei","name":"Wei, Hongying","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yue","key":"liupau","last":"Liu","name":"Liu, Yue","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Junhui","key":"xupau","last":"Xu","name":"Xu, Junhui","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Herman","key":"autruppau","last":"Autrup","locid":"f70ba888-183f-4569-b1a5-33e77fc42292","name":"Autrup, Herman","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Furong","key":"dengpau","last":"Deng","name":"Deng, Furong","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Xinbiao","key":"guopau","last":"Guo","name":"Guo, Xinbiao","rank":9,"rolecode":"pau"}],"pmid":["29235124"],"pub":{"doi":"10.1002/jat.3563","issn":["0260437X","10991263"],"issn_org":["0260437X"],"issue":"4","journal":"Journal of Applied Toxicology","pages":"564-574","publisher":"John Wiley and Sons Ltd","status":"p","title":"Journal of Applied Toxicology","title_org":"Journal of applied toxicology : JAT","volume":"38"},"review":"Peer Reviewed","scoID":["2-s2.0-85042105901"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-c3ac7ffc-a425-4372-8d74-444eebead804"],"src":["AU Aarhus University"],"title":"Silver nanoparticles increase connexin43-mediated gap junctional intercellular communication in HaCaT cells through activation of reactive oxygen species and mitogen-activated protein kinase signal pathway","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-240989","year":"2018","yearsub":"2018"}
{"abstract":"In the past few years, fluorine atom has been widely introduced into organic semiconductor (OS) materials to improve the photovoltaic performance of polymer solar cells (PSCs). In contrast, chlorine atom is rarely concerned, although it is also a halogen element and is more easily introduced into OS materials. Herein, we designed and synthesized a new D-A-type two-dimension (2D)-conjugated polymer, PM7, containing a chlorinated-thienyl benzodithiophene (BDT-2Cl) donor unit and a benzodithiophene-4,8-dione acceptor unit. Compared to the control polymer PBDB-T without chlorine substitution, PM7 shows lower HOMO energy level, higher absorption coefficient, enhanced crystallinity and higher carrier mobility. Moreover, the toluene-processed PSCs based on PM7 as donor and small molecule n-OS IT-4F as acceptor achieved a high power conversion efficiency (PCE) of 13.1% with high open-circuit voltage (Voc) of 0.88 V, short-circuit current density (Jsc) of 20.9 mA cm−2 and fill factor (FF) of 71.1%, while the PBDB-T:IT-4F-based PSC only exhibited a low PCE of 5.8% with low Voc of 0.67 V, Jsc of 15.0 mA cm−2 and FF of 57.6%. The PCE of 13.1% is among the highest values reported for the PSCs to date. These results indicate that the chlorine substitution is a simple and effective strategy to design high-performance conjugated polymer photovoltaic materials.","author_count":10,"contributors":["Fan, Qunping","Zhu, Qinglian","Xu, Zhuo","Su, Wenyan","Chen, Juan","Wu, Jingnan","Guo, Xia","Ma, Wei","Zhang, Maojie","Li, Yongfang"],"cuid":["S01-000.00-080858"],"filters":{"added":"2023-03","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East"],"corresponding_author":["Zhang, Maojie"],"country":["China"],"glorg":["All Global Affiliations","CAS - Institute of Chemistry","Laboratory of Advanced Optoelectronic Materials","Soochow University","State Key Laboratory for Mechanical Behavior of Materials","Xi'an Jiaotong University"],"keyword":["Benzodithiophene","Polymer solar cells","Power conversion efficiency"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"chlorine substituted 000000000002d conjugated polymer for high performance polymer solar cells with 000000000013 000000000001 efficiency via toluene processing","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.nanoen.2018.04.002","version":"Published Version"},"funding_acknowledgement":["This work was supported by National Natural Science Foundation of China (NSFC) (Nos. 51503135, 51573120, 21504066, 21534003 and 91633301 ), Ministry of science and technology (No. 2016YFA0200700 ), Jiangsu Provincial Natural Science Foundation (Grant No. BK20150332 ). X-ray data was acquired at beamlines 7.3.3 at the Advanced Light Source, which is supported by the Director, Office of Science, Office of Basic Energy Sciences, of the U.S. Department of Energy under Contract No. DE-AC02–05CH11231 . The authors thank Chenhui Zhu at beamline 7.3.3 for assistance with data acquisition. This work was supported by National Natural Science Foundation of China (NSFC) (Nos. 51503135, 51573120, 21504066, 21534003 and 91633301), Ministry of science and technology (No. 2016YFA0200700), Jiangsu Provincial Natural Science Foundation (Grant No. BK20150332). X-ray data was acquired at beamlines 7.3.3 at the Advanced Light Source, which is supported by the Director, Office of Science, Office of Basic Energy Sciences, of the U.S. Department of Energy under Contract No. DE-AC02–05CH11231. The authors thank Chenhui Zhu at beamline 7.3.3 for assistance with data acquisition."],"id":"S01-000.00-080858","identifier":[{"id":"85045626000","type":"scopus"}],"ids":["aau-6a08bb74-b31a-4370-b95f-f3106a63c783"],"keyword":["Benzodithiophene","Chlorine substituted conjugated polymers","Polymer solar cells","Power conversion efficiency"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-7431B66E4B2A674A5E56984E9B8EBC22"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.nanoen.2018.04.002","version":"Published Version"}],"org":[{"affno":"1","country":"cn","key":"soochow university","loc":["China","Asia, East"],"name":"Soochow University","used":1},{"affno":"2","country":"cn","key":"xi an jiaotong university","loc":["China","Asia, East"],"name":"Xi'an Jiaotong University","used":1},{"affno":"3","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience, Section for Chemical Science and Engineering"],"nora_code":"DI-U-AAU","used":1},{"affno":"4","country":"cn","key":"laboratory of advanced optoelectronic materials","loc":["China","Asia, East"],"name":"Laboratory of Advanced Optoelectronic Materials","used":1},{"affno":"5","country":"cn","key":"state key laboratory for mechanical behavior of materials","loc":["China","Asia, East"],"name":"State Key Laboratory for Mechanical Behavior of Materials","used":1},{"affno":"6","country":"cn","key":"cas institute of chemistry","loc":["China","Asia, East"],"name":"CAS - Institute of Chemistry","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Qunping","key":"fanpau","last":"Fan","name":"Fan, Qunping","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Qinglian","key":"zhupau","last":"Zhu","name":"Zhu, Qinglian","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Zhuo","key":"xupau","last":"Xu","name":"Xu, Zhuo","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Wenyan","key":"supau","last":"Su","name":"Su, Wenyan","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Juan","key":"chenpau","last":"Chen","name":"Chen, Juan","rank":5,"rolecode":"pau"},{"affno":"1 3 4","corresponding":null,"first":"Jingnan","key":"wupau","last":"Wu","locid":"c3e02bd9-644a-4b9c-8642-009163715fed","name":"Wu, Jingnan","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Xia","key":"guopau","last":"Guo","name":"Guo, Xia","rank":7,"rolecode":"pau"},{"affno":"2 3 5","corresponding":null,"first":"Wei","key":"mapau","last":"Ma","locid":"c3e2e20e-bde3-419c-8365-c78787bf6dad","name":"Ma, Wei","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Maojie","key":"zhangpau","last":"Zhang","name":"Zhang, Maojie","rank":9,"rolecode":"pau"},{"affno":"1 6","corresponding":null,"first":"Yongfang","key":"lipau","last":"Li","name":"Li, Yongfang","rank":10,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.nanoen.2018.04.002","issn":["22112855","22113282"],"issn_org":["22112855"],"journal":"Nano Energy","pages":"413-420","publisher":"Elsevier","status":"p","title":"Nano Energy","volume":"48"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-6a08bb74-b31a-4370-b95f-f3106a63c783"],"src":["AAU Aalborg University"],"title":"Chlorine substituted 2D-conjugated polymer for high-performance polymer solar cells with 13.1% efficiency via toluene processing","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-080858","year":"2018","yearsub":"2018"}
{"abstract":"Reclaimed water (RW) is an alternative water resource that has been utilized all over the world, but its environmental effects are not fully understood. Soil biodiversity is an important indicator of soil tolerance and resilience. In the present study, the impact of RW irrigation on the microbial community diversity and chemical properties of topsoil was investigated by monitoring nitrogen (N) rates. Tomato plants were grown on plots which had been irrigated with reclaimed water for 5 years with varying levels of N fertilization (N270, 270 kg ha−1; N216, 216 kg ha−1; N189, 189 kg ha−1; and N135, 135 kg ha−1). Soil bacterial community composition was analyzed by PCR amplification of the 16S rDNA gene and Illumina MiSeq high-throughput sequencing technology of a total of 770,066 quality sequences. The results showed that long-term RW irrigation altered the bacterial composition of soil in an N-dependent manner. RW irrigation increased the abundances of Gemmatimonadetes, Actinobacteria, Firmicutes, and Nitrospirae in soils. The Chao, ACE, and H indices revealed no significant difference under RW irrigation with varying levels of N fertilization. The tomato yield and partial factor productivity from applied N for RN216 increased significantly under RW irrigation with reducing N fertilization. RW irrigation increased the yield of tomato and the abundance of functional microorganisms, which eventually improved the practice of irrigating with reclaimed municipal wastewater. Meanwhile, the potential environmental and health risks of long-term RW irrigation warrant further investigation.","author_count":7,"contributors":["Wei, Guo","Qi, Xuebin","Xiao, Yatao","Li, Ping","Andersen, Mathias Neumann","Zhang, Yan","Zhao, Zhijuan"],"cuid":["S01-000.00-137253"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East"],"country":["China"],"glorg":["All Global Affiliations","China Agricultural University","Chinese Academy of Agricultural Sciences","Chinese Academy of Sciences"],"keyword":["Bacterial diversity","High throughput sequencing","Nitrogen fertilization","reclaimed water"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"effects of reclaimed water irrigation on microbial diversity and composition of soil with reducing nitrogen fertilization","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/w10040365","version":"Published Version"},"id":"S01-000.00-137253","identifier":[{"id":"85044379490","type":"scopus"}],"ids":["au-0dd367ec-5a82-4e31-a12f-095b2bf6ee58"],"keyword":["bacterial diversity","high throughput sequencing","mibrobial community","nitrogen fertilization","reclaimed water"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-02A0283457CEC65F61BF3DFBE465EBE4"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/w10040365","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.au.dk/ws/files/139198277/water_10_00365.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","country":"cn","key":"chinese academy of agricultural sciences","loc":["China","Asia, East"],"name":"Chinese Academy of Agricultural Sciences","used":1},{"affno":"2","country":"cn","key":"chinese academy of sciences","loc":["China","Asia, East"],"name":"Chinese Academy of Sciences","used":1},{"affno":"3","country":"cn","key":"china agricultural university","loc":["China","Asia, East"],"name":"China Agricultural University","used":1},{"affno":"4","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1},{"affno":"5","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Agroecology, Department of Agroecology - Climate and Water"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Guo","key":"weipau","last":"Wei","name":"Wei, Guo","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Xuebin","key":"qipau","last":"Qi","name":"Qi, Xuebin","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yatao","key":"xiaopau","last":"Xiao","name":"Xiao, Yatao","rank":3,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Ping","key":"lipau","last":"Li","name":"Li, Ping","rank":4,"rolecode":"pau"},{"affno":"5","corresponding":null,"country":"dk","first":"Mathias Neumann","key":"andersenpau","last":"Andersen","locid":"10eb9048-1aa0-4bd2-8809-35269cd68730","name":"Andersen, Mathias Neumann","orcid":"0000-0003-3845-4465","rank":5,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Yan","key":"zhangpau","last":"Zhang","name":"Zhang, Yan","rank":6,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Zhijuan","key":"zhaopau","last":"Zhao","name":"Zhao, Zhijuan","rank":7,"rolecode":"pau"}],"pub":{"doi":"10.3390/w10040365","issn":["20734441"],"issue":"4","journal":"Water","pages":"1-16","paperid":"365","publisher":"Multidisciplinary Digital Publishing Institute (MDPI)","status":"p","title":"Water","volume":"10"},"review":"Peer Reviewed","scoID":["2-s2.0-85044379490"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-0dd367ec-5a82-4e31-a12f-095b2bf6ee58"],"src":["AU Aarhus University"],"title":"Effects of reclaimed water irrigation on microbial diversity and composition of soil with reducing nitrogen fertilization","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-137253","year":"2018","yearsub":"2018"}
{"abstract":"Aortic valve stenosis (AS) is the most common valvular heart disease, and valve replacement is the only definitive treatment. Here we report a large genome-wide association (GWA) study of 2,457 Icelandic AS cases and 349,342 controls with a follow-up in up to 4,850 cases and 451,731 controls of European ancestry. We identify two new AS loci, on chromosome 1p21 near PALMD (rs7543130; odds ratio (OR) = 1.20, P = 1.2 x 10(-22)) and on chromosome 2q22 in TEX41 (rs1830321; OR = 1.15, P = 1.8 x 10(-13)). Rs7543130 also associates with bicuspid aortic valve (BAV) (OR = 1.28, P = 6.6 x 10(-10)) and aortic root diameter (P = 1.30 x 10(-8)), and rs1830321 associates with BAV (OR = 1.12, P = 5.3 x 10(-3)) and coronary artery disease (OR = 1.05, P = 9.3 x 10(-5)). The results implicate both cardiac developmental abnormalities and atherosclerosis-like processes in the pathogenesis of AS. We show that several pathways are shared by CAD and AS. Causal analysis suggests that the shared risk factors of Lp(a) and non-high-density lipoprotein cholesterol contribute substantially to the frequent co-occurence of these diseases.","author_count":46,"contributors":["Helgadottir, Anna","Thorleifsson, Gudmar","Gretarsdottir, Solveig","Stefansson, Olafur A.","Tragante, Vinicius","Thorolfsdottir, Rosa B.","Jonsdottir, Ingileif","Bjornsson, Thorsteinn","Steinthorsdottir, Valgerdur","Verweij, Niek","Nielsen, Jonas B.","Zhou, Wei","Folkersen, Lasse","Martinsson, Andreas","Heydarpour, Mahyar","Prakash, Siddharth","Oskarsson, Gylfi","Gudbjartsson, Tomas","Geirsson, Arnar","Olafsson, Isleifur","Sigurdsson, Emil L.","Almgren, Peter","Melander, Olle","Franco-Cereceda, Anders","Hamsten, Anders","Fritsche, Lars","Lin, Maoxuan","Yang, Bo","Hornsby, Whitney","Guo, Dongchuan","Brummett, Chad M.","Abecasis, Goncalo","Mathis, Michael","Milewicz, Dianna","Body, Simon C.","Eriksson, Per","Willer, Cristen J.","Hveem, Kristian","Newton-Cheh, Christopher","Smith, J. Gustav","Danielsen, Ragnar","Thorgeirsson, Gudmundur","Thorsteinsdottir, Unnur","Gudbjartsson, Daniel F.","Holm, Hilma","Stefansson, Kari"],"cuid":["S01-000.00-304962"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Europe, EU","Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Helgadottir, Anna"],"country":["Iceland","Netherlands","United States"],"glorg":["All Global Affiliations","Amgen Incorporated","University of Groningen","University of Iceland","University of Michigan, Ann Arbor"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"genome wide analysis yields new loci associating with aortic valve stenosis","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1038/s41467-018-03252-6","version":"Published Version"},"id":"S01-000.00-304962","identifier":[{"id":"29511194","type":"pmid"},{"id":"85043290754","type":"scopus"},{"id":"PMC5840367","type":"pmcid"}],"ids":["dtu-0178db4b-2311-40e5-a5bc-0f28d9232cfb"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-B6E67052EE60EA2B8D38886585D3F71A"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/146419494/s41467_018_03252_6.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1038/s41467-018-03252-6","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","country":"us","key":"amgen incorporated","loc":["United States","America, North","OECD"],"name":"Amgen Incorporated","used":1},{"affno":"2","country":"nl","key":"university of groningen","loc":["Netherlands","Europe, EU","OECD"],"name":"University of Gr