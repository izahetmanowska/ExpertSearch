["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-0acc6d2d-0668-4d4e-8d3b-c5a27933bb27"],"src":["AU Aarhus University"],"title":"Long-term humoral and cellular immunity after primary SARS-CoV-2 infection : a 20-month longitudinal study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-706691","year":"2023","yearsub":"2023"}
{"abstract":"Cannabinoids are important therapeutical molecules for human ailments, cancer treatment, and SARS-CoV-2. The central cannabinoid, cannabigerolic acid (CBGA), is generated from geranyl pyrophosphate and olivetolic acid by Cannabis sativa prenyltransferase (CsPT4). Despite efforts to engineer microorganisms such as Saccharomyces cerevisiae (S. cerevisiae) for CBGA production, their titers remain suboptimal because of the low conversion of hexanoate into olivetolic acid and the limited activity and stability of the CsPT4. To address the low hexanoate conversion, we eliminated hexanoate consumption by the beta-oxidation pathway and reduced its incorporation into fatty acids. To address CsPT4 limitations, we expanded the endoplasmic reticulum and fused an auxiliary protein to CsPT4. Consequently, the engineered S. cerevisiae chassis showed a marked improvement of 78.64-fold in CBGA production, reaching a titer of 510.32 ± 10.70 mg l−1 from glucose and hexanoate.","author_count":7,"contributors":["Zhang, Yunfeng","Guo, Jiulong","Gao, PeiZhen","Yan, Wei","Shen, Junfeng","Luo, Xiaozhou","Keasling, Jay D."],"cuid":["S01-000.00-712065"],"filters":{"added":"2024-02","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East"],"corresponding_author":["Keasling, Jay D.","Luo, Xiaozhou"],"country":["China"],"glorg":["All Global Affiliations","Shenzhen Institute of Advanced Technology","Synceres Biosciences (Shenzhen) Co., Ltd."],"keyword":["Cannabinoid","Fatty acid synthesis","Saccharomyces cerevisiae","Terpenoid"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"development of an efficient yeast platform for cannabigerolic acid biosynthesis","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85175266477","version":"Other Version"},"funding_acknowledgement":["We thank Zhimin Long and Yang Wang for Acyl-CoA compounds quantification. This study was partially supported by National Key R&D Program of China ( 2018YFA0903200 ), National Natural Science Foundation of China ( 32001079 ), Guangdong Basic and Applied Basic Research Foundation ( 2021B1515020049 and 2019A1515110549 ), Shenzhen Science and Technology Program ( JCYJ20190807154003687 and ZDSYS20210623091810032 ), Shenzhen Institute of Synthetic Biology Scientific Research Program ( ZTXM20203001 ), SIAT Innovation Program for Excellent Young Researchers ( 2013** )."],"id":"S01-000.00-712065","identifier":[{"id":"37890610","type":"pmid"},{"id":"85175266477","type":"scopus"}],"ids":["dtu-c5b81d20-6c1f-47cb-9637-aa954eafed07"],"keyword":["Cannabinoid","Fatty acid synthesis","Prenyltransferas","Saccharomyces cerevisiae","Terpenoid"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-33DC11DAAC503D00F2EDACADBF50138C"],"org":[{"affno":"1","country":"cn","key":"shenzhen institute of advanced technology","loc":["China","Asia, East"],"name":"Shenzhen Institute of Advanced Technology","used":1},{"affno":"2","country":"cn","key":"synceres biosciences co ltd","loc":["China","Asia, East"],"name":"Synceres Biosciences (Shenzhen) Co., Ltd.","used":1},{"affno":"3","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Novo Nordisk Foundation Center for Biosustainability","Technical University of Denmark, Novo Nordisk Foundation Center for Biosustainability, Yeast Natural Products"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Yunfeng","key":"zhangpau","last":"Zhang","name":"Zhang, Yunfeng","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jiulong","key":"guopau","last":"Guo","name":"Guo, Jiulong","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"PeiZhen","key":"gaopau","last":"Gao","name":"Gao, PeiZhen","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Wei","key":"yanpau","last":"Yan","name":"Yan, Wei","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Junfeng","key":"shenpau","last":"Shen","name":"Shen, Junfeng","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Xiaozhou","key":"luopau","last":"Luo","name":"Luo, Xiaozhou","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Jay D.","key":"keaslingpau","last":"Keasling","locid":"4f3be9f5-dd00-46fe-9d54-d7af2735014c","name":"Keasling, Jay D.","rank":7,"rolecode":"pau"}],"pmid":["37890610"],"pub":{"doi":"10.1016/j.ymben.2023.10.004","issn":["10967176","10967184"],"issn_org":["10967176"],"journal":"Metabolic Engineering","pages":"232-240","publisher":"Academic Press","status":"p","title":"Metabolic Engineering","volume":"80"},"review":"Peer Reviewed","scoID":["2-s2.0-85175266477"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-c5b81d20-6c1f-47cb-9637-aa954eafed07"],"src":["DTU Technical University of Denmark"],"title":"Development of an efficient yeast platform for cannabigerolic acid biosynthesis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-712065","year":"2023","yearsub":"2023"}
{"abstract":"Feedforward blade pitch control is one of the most promising lidar-assisted control strategies due to its significant improvement in rotor speed regulation and fatigue load reduction. A high-quality preview of the rotor-effective wind speed is a key element of control benefits. In this work, a single-beam lidar is simulated in the spinner of a bottom-fixed IEA 15 MW wind turbine. Both continuous-wave (CW) and pulsed lidar systems are considered. The single-beam lidar can rotate with the wind turbine rotor and scan the inflow with a circular pattern, which mimics a multiple-beam nacelle lidar at a lower cost. Also, the spinner-based lidar has an unimpeded view of the inflow without intermittent blockage from the rotating blade. The focus distance and the cone angle of the spinner-based single-beam lidar are optimized for the best wind preview quality based on a rotor-effective wind speed coherence model. Then, the control benefits of using the optimized spinner-based lidar are evaluated for an above-rated wind speed in OpenFAST with an embedded lidar simulator and virtual four-dimensional Mann turbulence fields considering the wind evolution. Results are compared against those using a single-beam nacelle-based lidar. We found that the optimum scanning configurations of both CW and pulsed spinner-based single-beam lidars lead to a lidar scan radius of 0.6 of the rotor radius. Also, results show that a single-beam lidar mounted in the spinner provides many more control benefits (i.e. better rotor speed regulations and higher reductions in the damage equivalent loads on the tower base and blade roots) than the one based on the nacelle. The spinner-based single-beam lidar has a similar performance to a four-beam nacelle lidar when used for feedforward control.","author_count":4,"contributors":["Fu, Wei","Guo, Feng","Schlipf, David","Peña, Alfredo"],"cuid":["S01-000.00-718510"],"filters":{"added":"2024-03","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"corresponding_author":["Fu, Wei"],"country":["Germany"],"glorg":["All Global Affiliations","Flensburg University of Applied Sciences"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"feedforward pitch control for a 000000000015 mw wind turbine using a spinner mounted single beam lidar","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.5194/wes-8-1893-2023","version":"Published Version"},"id":"S01-000.00-718510","identifier":[{"id":"85183012476","type":"scopus"}],"ids":["dtu-3d7f28a6-6418-462d-8a15-ff932ecccc23"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-4679579497BE6492B065F6671A70B6A7"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.5194/wes-8-1893-2023","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/351251767/wes-8-1893-2023.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Wind and Energy Systems","Technical University of Denmark, Department of Wind and Energy Systems, Wind Energy Systems Division","Technical University of Denmark, Department of Wind and Energy Systems, Wind Energy Systems Division, Meteorology and Remote Sensing"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"de","key":"flensburg university of applied sciences","loc":["Ge