school of medicine at mount sinai","loc":["United States","America, North","OECD"],"name":"Icahn School of Medicine at Mount Sinai","used":1}],"person":[{"affno":"","first":"Heming","key":"wanghemingpau","last":"Wang","name":"Wang, Heming","rank":1,"rolecode":"pau"},{"affno":"","first":"Raymond","key":"noordamraymondpau","last":"Noordam","name":"Noordam, Raymond","rank":2,"rolecode":"pau"},{"affno":"","first":"Brian E","key":"cadebrianepau","last":"Cade","name":"Cade, Brian E","rank":3,"rolecode":"pau"},{"affno":"","first":"Karen","key":"schwanderkarenpau","last":"Schwander","name":"Schwander, Karen","rank":4,"rolecode":"pau"},{"affno":"","first":"Thomas W","key":"winklerthomaswpau","last":"Winkler","name":"Winkler, Thomas W","rank":5,"rolecode":"pau"},{"affno":"","first":"Jiwon","key":"leejiwonpau","last":"Lee","name":"Lee, Jiwon","rank":6,"rolecode":"pau"},{"affno":"","first":"Yun Ju","key":"sungyunjupau","last":"Sung","name":"Sung, Yun Ju","rank":7,"rolecode":"pau"},{"affno":"","first":"Amy R","key":"bentleyamyrpau","last":"Bentley","name":"Bentley, Amy R","rank":8,"rolecode":"pau"},{"affno":"","first":"Alisa K","key":"manningalisakpau","last":"Manning","name":"Manning, Alisa K","rank":9,"rolecode":"pau"},{"affno":"","first":"Hugues","key":"aschardhuguespau","last":"Aschard","name":"Aschard, Hugues","rank":10,"rolecode":"pau"},{"affno":"1 2","first":"Tuomas O","key":"kilpeläinentuomasopau","last":"Kilpeläinen","locid":"912c755f-c8d9-46a3-ba45-182d4e36768a","name":"Kilpeläinen, Tuomas O","orcid":"0000-0002-8349-3028","rank":11,"rolecode":"pau"},{"affno":"","first":"Marjan","key":"ilkovmarjanpau","last":"Ilkov","name":"Ilkov, Marjan","rank":12,"rolecode":"pau"},{"affno":"","first":"Michael R","key":"brownmichaelrpau","last":"Brown","name":"Brown, Michael R","rank":13,"rolecode":"pau"},{"affno":"","first":"Andrea R","key":"horimotoandrearpau","last":"Horimoto","name":"Horimoto, Andrea R","rank":14,"rolecode":"pau"},{"affno":"","first":"Melissa","key":"richardmelissa