","name":"Wu, Lang","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jifeng","key":"wangpau","last":"Wang","name":"Wang, Jifeng","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Qiuyin","key":"caipau","last":"Cai","name":"Cai, Qiuyin","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Taylor B","key":"cavazospau","last":"Cavazos","name":"Cavazos, Taylor B","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Nima C","key":"emamipau","last":"Emami","name":"Emami, Nima C","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jirong","key":"longpau","last":"Long","name":"Long, Jirong","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Xiao-Ou","key":"shupau","last":"Shu","name":"Shu, Xiao-Ou","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Yingchang","key":"lupau","last":"Lu","name":"Lu, Yingchang","rank":8,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Xingyi","key":"guopau","last":"Guo","name":"Guo, Xingyi","rank":9,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Joshua A","key":"bauerpau","last":"Bauer","name":"Bauer, Joshua A","rank":10,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Bogdan","key":"pasaniucpau","last":"Pasaniuc","name":"Pasaniuc, Bogdan","rank":11,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Kathryn L","key":"penneypau","last":"Penney","name":"Penney, Kathryn L","rank":12,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Matthew L","key":"freedmanpau","last":"Freedman","name":"Freedman, Matthew L","rank":13,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Zsofia","key":"kotejaraipau","last":"Kote-Jarai","name":"Kote-Jarai, Zsofia","rank":14,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"John S","key":"wittepau","last":"Witte","name":"Witte, John S","rank":15,"rolecode":"pau"},{"affno":"8","corresponding":null,"first":"Christopher A","key":"haimanpau","last":"Haiman","name":"Haiman, Christopher A","rank":16,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Rosalind A","key":"eelespau","last":"Eeles","name":"Eeles, Rosalind A","rank":17,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Wei","key":"zhengpau","last":"Zheng","name":"Zheng, Wei","rank":18,"rolecode":"pau"}],"pmid":["31101764"],"pub":{"doi":"10.1158/0008-5472.can-18-3536","issn":["00085472","05766656"],"issn_org":["00085472"],"issue":"13","journal":"Cancer Research","pages":"3192-3204","publisher":"American Association for Cancer Research Inc.","status":"p","title":"Cancer Research","volume":"79"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-6860e8e5-dd9a-4ca7-9e9c-7a1127ca7765"],"src":["AU Aarhus University"],"title":"Identification of Novel Susceptibility Loci and Genes for Prostate Cancer Risk : A Transcriptome-Wide Association Study in Over 140,000 European Descendants","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-188959","year":"2019","yearsub":"2019"}
{"abstract":"In this work, a model framework was constructed to assess and predict nitrous oxide (N2O) production, substrate and microbe interactions in an anammox biofilm bioreactor. The anammox kinetics were extended by including kinetics of autotrophic soluble microbial products (SMP) formation, which consisted of utilization-associated products (UAP) and biomass-associated products (BAP). Heterotrophic bacteria growing on UAP, BAP and decay released substance (SS) were modelled to perform four-step sequential reductions from nitrate to dinitrogen gas. N2O was modelled as an intermidiate of heterotrophic denitrification via three pathways with UAP, BAP and SS as the electron donors. The developed model framework was evaluated using long-term operational data from an anammox biofilm reactor and satisfactorily reproduced effluent nitrogen and SMP as well as N2O emission factors under different operational conditions. The modeling results revealed that N2O was mainly produced with UAP as the electron donor while BAP and SS play minor roles. Heterotrophic denitrifiers growing on UAP would significantly contribute to N2O emission from anammox biofilm reactor even though heterotrophs only account for a relatively small fraction of active biomass in the anammox biofilm. Comprehensive simulations were conducted to investigate the effects of N loading rate and biofilm thickness, which indicated that maintaining a low N loading rate and a thick biofilm thickness were essential for high total nitrogen removal efficiency and low N2O emission.","author_count":10,"contributors":["Peng, Lai","Ngo, Huu Hao","Song, Shaoxian","Xu, Yifeng","Guo, Wenshan","Liu, Yiwen","Wei, Wei","Chen, Xueming","Wang, Dongbo","Ni, Bing-Jie"],"cuid":["S01-000.00-355684"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, East","OECD","Oceania"],"corresponding_author":["Ni, Bing-Jie"],"country":["Australia","China"],"glorg":["All Global Affiliations","Hunan University","University of Technology Sydney","Wuhan University of Technology"],"keyword":["Model framework","Nitrous oxide","Soluble microbial products"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"heterotrophic denitrifiers growing on soluble microbial products contribute to nitrous oxide production in anammox biofilm model evaluation","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85064888487","version":"Other Version"},"id":"S01-000.00-355684","identifier":[{"id":"85064888487","type":"scopus"},{"id":"31054395","type":"pmid"}],"ids":["dtu-ab2275c6-e03c-45c5-a097-f47309d883d7"],"keyword":["Anammox biofilm","Biofilm thickness","Model framework","Nitrogen loading rate","Nitrous oxide","Soluble microbial products"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-A00D428517363C890881DDFFD04DB8BC"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","country":"cn","key":"wuhan university of technology","loc":["China","Asia, East"],"name":"Wuhan University of Technology","used":1},{"affno":"2","country":"au","key":"university of technology sydney","loc":["Australia","Oceania","OECD"],"name":"University of Technology Sydney","used":1},{"affno":"3","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Chemical and Biochemical Engineering","Technical University of Denmark, Department of Chemical and Biochemical Engineering, PROSYS - Process and Systems Engineering Centre"],"nora_code":"DI-U-DTU","used":1},{"affno":"4","country":"cn","key":"hunan university","loc":["China","Asia, East"],"name":"Hunan University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lai","key":"pengpau","last":"Peng","name":"Peng, Lai","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Huu Hao","key":"ngopau","last":"Ngo","name":"Ngo, Huu Hao","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Shaoxian","key":"songpau","last":"Song","name":"Song, Shaoxian","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Yifeng","key":"xupau","last":"Xu","name":"Xu, Yifeng","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Wenshan","key":"guopau","last":"Guo","name":"Guo, Wenshan","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Yiwen","key":"liupau","last":"Liu","name":"Liu, Yiwen","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Wei","key":"weipau","last":"Wei","name":"Wei, Wei","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Xueming","key":"chenpau","last":"Chen","locid":"1de9a180-d9df-4b60-8971-61b3e32d0e76","name":"Chen, Xueming","orcid":"0000-0003-4009-9810","rank":8,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Dongbo","key":"wangpau","last":"Wang","name":"Wang, Dongbo","rank":9,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Bing-Jie","key":"nipau","last":"Ni","name":"Ni, Bing-Jie","rank":10,"rolecode":"pau"}],"pmid":["31054395"],"pub":{"doi":"10.1016/j.jenvman.2019.04.084","issn":["03014797","10958630"],"issn_org":["03014797"],"journal":"Journal of Environmental Management","pages":"309-314","publisher":"Academic Press","status":"p","title":"Journal of Environmental Management","volume":"242"},"review":"Peer Reviewed","scoID":["2-s2.0-85064888487"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-ab2275c6-e03c-45c5-a097-f47309d883d7"],"src":["DTU Technical University of Denmark"],"title":"Heterotrophic denitrifiers growing on soluble microbial products contribute to nitrous oxide production in anammox biofilm: Model evaluation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-355684","year":"2019","yearsub":"2019"}
{"abstract":"BACKGROUND: Obesity or overweight is related to worse outcomes in patients with atrial fibrillation (AF) following catheter ablation (CA). The role of being underweight in relation to recurrent arrhythmias post AF ablation is less certain. We conducted a retrospective study to investigate the association of body mass index (BMI) with arrhythmia outcomes in AF patients undergoing CA. METHODS: In a cohort of 1410 AF patients (mean age 57.2 ± 11.6 years; 68% male) undergoing single CA, the association between BMI and AF ablation outcome was analyzed using BMI as a continuous variable and by four BMI categories (<18.5 kg/m2, 18.5-24 kg/m2, 25-29 kg/m2, and ≥ 30 kg/m2). RESULT: We observed a positive association between a cut off value of BMI and risk of AF recurrence post AF ablation. BMI ≥26.36 kg/m2 was related to more AF recurrence (c-statistic 0.55, 95%CI 0.51-0.58; P < 0.01) with 50% increased risk of AF recurrence (HR 1.50, 95% CI 1.22-1.86; P < 0.01). Recurrence rates in the four BMI categories were 33.3%, 23.2%, 27.2 and 41.8%, respectively (P < 0.01). Kaplan-Meier analysis showed that BMI categories of <18.5 kg/m2 and ≥ 30 kg/m2 were all associated with more AF recurrence (P = 0.01). Both underweight (HR 1.85, 95%CI 1.12-3.08; P = 0.02) and obesity (HR 1.78, 95%CI 1.17-2.72; P = 0.01) significantly increased the risk of AF recurrence in a Cox proportional hazard model. CONCLUSION: BMI had good predictive value for AF ablation outcomes with a cut off value of ≥26.36 kg/m2. Apart from being obese/overweight, being underweight might also be a risk factor for AF recurrence post ablation.","author_count":13,"contributors":["Deng, Hai","Shantsila, Alena","Guo, Pi","Potpara, Tatjana S","Zhan, Xianzhang","Fang, Xianhong","Liao, Hongtao","Liu, Yang","Wei, Wei","Fu, Lu","Wu, Shulin","Xue, Yumei","Lip, Gregory Y H"],"cuid":["S01-000.00-075985"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","Liverpool Heart and Chest Hospital NHS Foundation Trust","University of Birmingham","University of Liverpool"],"keyword":["Atrial fibrillation","Body Mass Index","Catheter ablation","Obesity","Underweight"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Guangdong Cardiovascular Institute, Guangdong General Hospital, Guangdong Academy of Medical Science, Guangzhou, China."],"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"a u shaped relationship of body mass index on atrial fibrillation recurrence post ablation a report from the guangzhou atrial fibrillation ablation registry","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND 4.0","type":"doi","url":"https://doi.org/10.1016/j.ebiom.2018.08.034","version":"Published Version"},"id":"S01-000.00-075985","identifier":[{"id":"000445436400017","type":"wos"},{"id":"30174278","type":"pmid"},{"id":"85052615695","type":"scopus"}],"ids":["aau-59700c9f-5b11-4079-acb8-85ac58ce8064"],"keyword":["Atrial fibrillation","Body mass index","Catheter ablation","Obesity","Underweight"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-8E5F34471C1CB9BF4E090F4542681326"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND 4.0","type":"doi","url":"https://doi.org/10.1016/j.ebiom.2018.08.034","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/288469908/PIIS2352396418303281.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark