t":"Weiqiang","key":"yangweiqiangpau","last":"Yang","name":"Yang, Weiqiang","rank":91,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.astropartphys.2021.102607","issn":["09276505","18732852"],"issn_org":["09276505"],"journal":"Astroparticle Physics","paperid":"102607","publisher":"Elsevier","status":"p","title":"Astroparticle Physics","volume":"131"},"review":"Peer Reviewed","scoID":["2-s2.0-85109330537"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-6f4d872a-c10d-451a-ac00-13f84f9f839d","sdu-1e374ef7-36d1-4f2b-91d4-e0cf206c2593"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Snowmass2021-Letter of interest cosmology intertwined IV : The age of the universe and its curvature","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-098.29-043330","year":"2021","yearsub":"2021"}
{"abstract":"A choreography gives a description of how endpoints in a concurrent systems should exchange messages during its execution. In this paper, we informally introduce a choreographic language for describing security protocols and a property language for expressing non-trivial security properties of such protocols. We motivate this work using the envelope protocol [2] as an example, which ensures auditable transfers by means of a TPM, that guarantees that the issuer of a message always learns whether such message has been opened or not. We then take an implementation of the TPM formulated as an API and discuss how such implementation and the usage of the TPM in the protocol can be related. Finally, we illustrate how the protocol and property descriptions can be translated into multiset rewrite rules and metric first order logic respectively, in order to check if auditable transfer holds.","author_count":9,"contributors":["Bruni, Alessandro","Carbone, Marco","Giustolisi, Rosario","Mödersheim, Sebastian Alexander","Schürmann, Carsten"],"cuid":["S01-000.00-310372"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Choreography","Security protocols","Verification"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-ITU"]},"level3all":["DI-U-DTU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"security protocols as choreographies","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/265046987/Bruni2021_Chapter_SecurityProtocolsAsChoreograph.pdf","version":"Published Version"},"id":"S01-000.00-310372","identifier":[{"id":"85119665514","type":"scopus"}],"ids":["dtu-13355403-b681-442d-9e5e-d2239d8a164e"],"keyword":["Choreography","Security protocols","Verification"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-0EA9D1A4E0EF8BC005FCFD2FF0A70B10"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/265046987/Bruni2021_Chapter_SecurityProtocolsAsChoreograph.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Applied Mathematics and Computer Science","Technical University of Denmark, Department of Applied Mathematics and Computer Science, Formal Methods"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Alessandro","key":"brunipau","last":"Bruni","name":"Bruni, Alessandro","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marco","key":"carbonepau","last":"Carbone","name":"Carbone, Marco","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rosario","key":"giustolisipau","last":"Giustolisi","name":"Giustolisi, Rosario","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Sebastian Alexander","key":"mödersheimpau","last":"Mödersheim","locid":"21eb3855-68a7-4647-a3a0-8526af03169f","name":"Mödersheim, Sebastian Alexander","orcid":"0000-0002-6901-8319","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Carsten","key":"schürmannpau","last":"Schürmann","name":"Schürmann, Carsten","rank":5,"rolecode":"pau"},{"affno":"","first":"Daniel","key":"doughertypedh","last":"Dougherty","name":"Dougherty, Daniel","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"José","key":"meseguerpedh","last":"Meseguer","name":"Meseguer, José","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Sebastian Alexander","key":"mödersheimpedh","last":"Mödersheim","name":"Mödersheim, Sebastian Alexander","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Paul","key":"rowepedh","last":"Rowe","name":"Rowe, Paul","rank":9,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-030-91631-2_5","isbn":["9783030916305"],"issn":["03029743"],"pages":"98-111","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","subtitle":"Essays Dedicated to Joshua Guttman on the Occasion of his 66.66th Birthday","title":"Protocols, Strands, and Logic"},"review":"Peer Reviewed","scoID":["2-s2.0-85119665514"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-13355403-b681-442d-9e5e-d2239d8a164e"],"src":["DTU Technical University of Denmark"],"title":"Security Protocols as Choreographies","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-310372","year":"2021","yearsub":"2021"}
{"abstract":"Constrained IoT devices are becoming ubiquitous in society and there is a need for secure communication protocols that respect the constraints under which these devices operate. EDHOC is an authenticated key establishment protocol for constrained IoT devices, currently being standardized by the Internet Engineering Task Force (IETF). A rudimentary version of EDHOC with only two key establishment methods was formally analyzed in 2018. Since then, the protocol has evolved significantly and several new key establishment methods have been added. In this paper, we present a formal analysis of all EDHOC methods in an enhanced symbolic Dolev-Yao model using the Tamarin tool. We show that not all methods satisfy the authentication notion injective of agreement, but that they all do satisfy a notion of implicit authentication, as well as Perfect Forward Secrecy (PFS) of the session key material. We identify other weaknesses to which we propose improvements. For example, a party may intend to establish a session key with a certain peer, but end up establishing it with another, trusted but compromised, peer. We communicated our findings and proposals to the IETF, which has incorporated some of these in newer versions of the standard.","author_count":3,"contributors":["Normann, Karl","Sundararajan, Vaishnavi","Bruni, Alessandro"],"cuid":["S01-000.00-718828"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Sweden"],"glorg":["All Global Affiliations","Ericsson","KTH Royal Institute of Technology"],"keyword":["Authenticated key establishment","Constrained IoT devices","EDHOC","IETF standardization","Implicit authentication","Injective agreement","Perfect Forward Secrecy PFS","Secure communication protocols","Symbolic dolev yao model","Tamarin tool"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"nr","rtype":["clu"],"sorti":"formal analysis of edhoc key establishment for constrained iot devices","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.48550/arXiv.2007.11427","version":"Published Version"},"id":"S01-000.00-718828","ids":["itu-14189d3d-cc6a-4e76-a30c-252ea9728f7f"],"keyword":["Authenticated key establishment","Constrained IoT devices","EDHOC","IETF standardization","Implicit authentication","Injective agreement","Perfect Forward Secrecy (PFS)","Secure communication protocols","Symbolic Dolev-Yao model","Tamarin tool"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-4-7-E6B14D60AF227AABA2A2A5FE9DD72891"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.48550/arXiv.2007.11427","version":"Published Version"}],"org":[{"affno":"1","country":"se","key":"kth royal institute of technology","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"KTH Royal Institute of Technology","used":1},{"affno":"2","country":"se","key":"ericsson","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Ericsson","used":1},{"affno":"3","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Information Security and Trust","IT University of Copenhagen, Computer Science","IT University of Copenhagen, Theoretical Computer Science, Programming Logic and Semantics"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Karl","key":"normannpau","last":"Normann","name":"Normann, Karl","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Vaishnavi","key":"sundararajanpau","last":"Sundararajan","name":"Sundararajan, Vaishnavi","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Alessandro","key":"brunipau","last":"Bruni","locid":"5c50bbc9-ed3d-417f-ba4d-e484eaf536b3","name":"Bruni, Alessandro","orcid":"0000-0003-2946-9462","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.48550/arxiv.2007.11427","eisbn":["9789897585241"],"status":"p","title":"Formal Analysis of EDHOC Key Establishment for Constrained IoT Devices"},"review":"No Review","scoID":["2-s2.0-85111848646"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-14189d3d-cc6a-4e76-a30c-252ea9728f7f"],"src":["ITU IT University of Copenhagen"],"title":"Formal Analysis of EDHOC Key Establishment for Constrained IoT Devices","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-718828","year":"2021","yearsub":"2021"}
{"abstract":"The current cosmological probes have provided a fantastic confirmation of the standard A Cold Dark Matter cosmological model, which has been constrained with unprecedented accuracy. However, with the increase of the experimental sensitivity, a few statistically significant tensions between different independent cosmological datasets emerged. While these tensions can be in part the result of systematic errors, the persistence after several years of accurate analysis strongly hints at cracks in the standard cosmological scenario and the need for new physics. In this Letter of Interest we will focus on the 4.4 sigma - tension between the Planck estimate of the Hubble constant H-0 and the SH0ES collaboration measurements. After showing the H-0 evaluations made from different teams using different methods and geometric calibrations, we will list a few interesting models of new physics that could solve this tension and discuss how the next decade's experiments will be crucial. (C) 2021 Elsevier B.V. All rights reserved.","author_count":101,"contributors":["Di Valentino, Eleonora","Anchordoqui, Luis A.","Akarsu, Ozgur","Ali-Haimoud, Yacine","Amendola, Luca","Arendse, Nikki","Asgari, Marika","Ballardini, Mario","Basilakos, Spyros","Battistelli, Elia","Benetti, Micol","Birrer, Simon","Bouchet, Francois R.","Bruni, Marco","Calabrese, Erminia","Camarena, David","Capozziello, Salvatore","Chen, Angela","Chluba, Jens","Chudaykin, Anton","Colgain, Eoin O.","Cyr-Racine, Francis-Yan","de Bernardis, Paolo","Perez, Javier de Cruz","Delabrouille, Jacques","Dunkley, Jo","Escamilla-Rivera, Celia","Ferte, Agnes","Finelli, Fabio","Freedman, Wendy","Frusciante, Noemi","Giusarma, Elena","Gomez-Valent, Adria","Guy, Julien","Handley, Will","Harrison, Ian","Hart, Luke","Heavens, Alan","Hildebrandt, Hendrik","Holz, Daniel","Huterer, Dragan","Ivanov, Mikhail M.","Joudaki, Shahab","Kamionkowski, Marc","Karwal, Tanvi","Knox, Lloyd","Kumar, Suresh","Lamagna, Luca","Lesgourgues, Julien",