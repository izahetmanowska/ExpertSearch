I-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-5858439f-d412-4c8f-a441-be42b07b0f77","ku-4a07dea8-bbe8-40f1-b9e3-ef2a9c0608a8"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Potential genetic modifiers of disease risk and age at onset in patients with frontotemporal lobar degeneration and GRN mutations : a genome-wide association study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-019089","year":"2018","yearsub":"2018"}
{"abstract":"Selene is a novel voting protocol that supports individual verifiability, Vote-Privacy and Receipt-Freeness. The scheme provides tracker numbers that allow voters to retrieve their votes from a public bulletin board and a commitment scheme that allows them to hide their vote from a potential coercer. So far, however, Selene was never stud- ied formally. The Selene protocol was neither completely formalized, nor were the correctness proofs for Vote-Privacy and Receipt-Freeness. In this paper, we give a formal model for a simplified version of Selene in the symbolic model, along with a machine-checked proof of Vote-Privacy and Receipt-Freeness. All proofs are checked with the Tamarin theorem prover.","author_count":3,"contributors":["Bruni, Alessandro","Drewsen, Eva","Schürmann, Carsten"],"cuid":["S01-000.00-382630"],"event":{"acronym":"E-VOTE-ID","title":"International Joint Conference on Electronic Voting"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Formal verification","Receipt Freeness","Selene voting protocol","Vote Privacy","individual verifiability"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"towards a mechanized proof of selene receipt freeness and vote privacy","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83008086/selene.pdf","version":"Authors Final Version"},"id":"S01-000.00-382630","identifier":[{"id":"85032468251","type":"scopus"}],"ids":["itu-5b7ee4de-0c82-4005-9522-049ba1a27075"],"keyword":["Receipt-Freeness","Selene voting protocol","Vote-Privacy","formal verification","individual verifiability"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-F549A330BD92FB15ED08504DA35B0856"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83008086/selene.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Theoretical Computer Science, Programming Logic and Semantics"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Alessandro","key":"brunipau","last":"Bruni","locid":"5c50bbc9-ed3d-417f-ba4d-e484eaf536b3","name":"Bruni, Alessandro","orcid":"0000-0003-2946-9462","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Eva","key":"drewsenpau","last":"Drewsen","name":"Drewsen, Eva","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Carsten","key":"schürmannpau","last":"Schürmann","locid":"1313519f-2074-41d6-8b79-589648e37211","name":"Schürmann, Carsten","orcid":"0000-0003-4793-0099","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-319-68687-5_7","isbn":["9783319686868"],"issn":["03029743"],"pages":"110-126","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","title":"Electronic Voting - Second International Joint Conference, E-Vote-ID 2017, Bregenz, Austria, October 24-27, 2017, Proceedings"},"review":"Peer Reviewed","scoID":["2-s2.0-85032468251"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-5b7ee4de-0c82-4005-9522-049ba1a27075"],"src":["ITU IT University of Copenhagen"],"title":"Towards a Mechanized Proof of Selene Receipt-Freeness and Vote-Privacy","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382630","year":"2017","yearsub":"2017"}
{"abstract":"A recent trend in the construction of security protocols such as voting and certificate management systems is to make principals accountable for their actions. Whenever some principals deviate from the protocol’s prescription and cause the failure of a goal of the system, accountability ensures that the system can detect the misbehaving parties who caused that failure. Accountability is an intuitively stronger property than verifiability as the latter only rests on the possibility of detecting the failure of a goal. A plethora of accountability and verifiability definitions have been proposed in the literature. Those definitions are either very specific to the protocols in question, hence not applicable in other scenarios, or too general and widely applicable but requiring complicated and hard to follow manual proofs. In this paper, we advance formal definitions of verifiability and accountability that are amenable to automated verification. Our definitions are general enough to be applied to different classes of protocols and different automated security verification tools. Furthermore, we point out formally the relation between verifiability and accountability. We validate our definitions with the automatic verification of three protocols: a secure exam protocol, Google’s Certificate Transparency, and an improved version of Bingo Voting. We find through automated verification that all three protocols satisfy verifiability while only the first two protocols meet accountability.","author_count":3,"contributors":["Bruni, Alessandro","Giustolisi, Rosario","Schürmann, Carsten"],"cuid":["S01-000.00-384358"],"event":{"acronym":"ISC","title":"Information Security Conference"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Accountability","Automated verification","Security protocols","Verifiability","formal definitions"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"automated analysis of accountability","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82496614/accountability.pdf","version":"Authors Final Version"},"id":"S01-000.00-384358","identifier":[{"id":"85035149203","type":"scopus"}],"ids":["itu-d23d44bf-7740-4c1c-a790-ad0d4230aa9a"],"keyword":["accountability","automated verification","formal definitions","security protocols","verifiability"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-1AEA50D1EA387434004FA8715C772E56"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82496614/accountability.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Theoretical Computer Science, Programming Logic and Semantics"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Alessandro","key":"brunipau","last":"Bruni","locid":"5c50bbc9-ed3d-417f-ba4d-e484eaf536b3","name":"Bruni, Alessandro","orcid":"0000-0003-2946-9462","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rosario","key":"giustolisipau","last":"Giustolisi","locid":"62db65c9-470c-472f-b039-6c4a704ef170","name":"Giustolisi, Rosario","orcid":"0000-0002-2917-9601","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Carsten","key":"schürmannpau","last":"Schürmann","locid":"1313519f-2074-41d6-8b79-589648e37211","name":"Schürmann, Carsten","orcid":"0000-0003-4793-0099","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-319-69659-1_23","eisbn":["9783319696591"],"isbn":["9783319696584"],"issn":["03029743"],"pages":"417-434","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","title":"Information Security - 20th International Conference, {ISC} 2017, Ho Chi Minh City, Vietnam, November 22-24, 2017, Proceedings"},"review":"Peer Reviewed","scoID":["2-s2.0-85035149203"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-d23d44bf-7740-4c1c-a790-ad0d4230aa9a"],"src":["ITU IT University of Copenhagen"],"title":"Automated Analysis of Accountability","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384358","year":"2017","yearsub":"2017"}
{"abstract":"Trusted input techniques can profoundly enhance a variety of scenarios like online banking, electronic voting, Virtual Private Networks, and even commands to a server or Industrial Control System. To protect the system from malware of the sender’s computer, input needs to be reliably authenticated. Previous research in this field is based on fixed assumptions about trustworthy components and is, thus, too rigid for this use case. We present Smart-Guard, a method to protect user input into a system even if the attacker controls – to us unknown – parts of the underlying system. Our approach ensures integrity of user input even when up to two of three devices are compromised; confidentiality holds for one malicious device. In this way, Smart-Guard has flexible trust assumptions, and does not require any particular part of the system to be trusted. To prove our claims, we formally verified our protocol using the state-of-the-art protocol verifier ProVerif. Additionally, we define a new class of techniques, malware tolerance, which operate securely even when the system is infected with malware.","author_count":3,"contributors":["Denzel, Michael","Bruni, Alessandro","Ryan, Mark"],"cuid":["S01-000.00-384398"],"event":{"acronym":"UIC","end":"2016-07-21","place":"Toulouse, fr","start":"2016-07-18","title":"The 13th IEEE International Conference on Advanced and Trusted Computing","year":"2016"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of Birmingham"],"keyword":["Malware Tolerance","Online Security","System Authentication","Trusted Input Techniques","User Input Integrity"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"smart guard defending user input from malware","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85013156185","version":"Other Version"},"id":"S01-000.00-384398","identifier":[{"id":"85013156185","type":"scopus"}],"ids":["itu-d4932e05-cd88-41d7-8a41-4384d20dfe88"],"keyword":["Malware Tolerance","Online Security","System Authentication","Trusted Input Techniques","User Input Integrity"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-9C03BA47BF9E72955FCFB6194FDE947A"],"org":[{"affno":"1","country":"gb","key":"university of birmingham","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Birmingham","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Theoretical Computer Science, Programming Logic and Semantics"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Michael","key":"denzelpau","last":"Denzel","name":"Denzel, Michael","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Alessandro","key":"brunipau","last":"Bruni","locid":"5c50bbc9-ed3d-417f-ba4d-e484eaf536b3","name":"Bruni, Alessandro","orcid":"0000-0003-2946-9462","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mark","key":"ryanpau","last":"Ryan","name":"Ryan, Mark","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1109/uic-atc-scalcom-cbdcom-iop-smartworld.2016.0089","isbn":["9781509027705"],"pages":"502-509","publisher":"IEEE","status":"p","title":"2016 Intl IEEE Conferences on Ubiquitous Intelligence &amp; Computing, Advanced and Trusted Computing, Scalable Computing and Communications, Cloud and Big Data Computing, Internet of People, and Smart World Congress (UIC/ATC/ScalCom/CBDCom/IoP/SmartWorld)"},"review":"Peer Reviewed","scoID":["2-s2.0-85013156185"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-d4932e05-cd88-41d7-8a41-4384d20dfe88"],"src":["ITU IT University of Copenhagen"],"title":"Smart-Guard: Defending User Input from Malware","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384398","year":"2016","yearsub":"2016"}
{"abstract":"Abstraction based approaches like ProVerif are very efficient in protocol verification, but have a limitation in dealing with stateful protocols. A number of extensions have been proposed to allow for a limited amount of state information while not destroying the advantages of the abstraction method. However, the extensions proposed so far can only deal with a finite amount of state information. This can in many cases make it impossible to formulate a verification problem for an unbounded number of agents (and one has to rather specify a fixed set of agents). Our work shows how to overcome this limitation by abstracting state into countable families of sets. We can then formalize a problem with unbounded agents, where each agent maintains its own set of keys. Still, our method does not loose the benefits of the abstraction approach, in particular, it translates a verification problem to a set of first-order Horn clauses that can then be efficiently verified with tools like ProVerif.","author_count":4,"contributors":["Mödersheim, Sebastian Alexander","Bruni, Alessandro"],"cuid":["S02-083.73-036995"],"event":{"acronym":"POST","end":"2016-04-08","place":"Eindhoven, nl","start":"2016-04-02","title":"5th International Conference on Principles of Security and Trust","year":"2016"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["First order Horn clauses","ProVerif","Protocol verification","Stateful protocols","Unbounded agents"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-ITU"]},"level3all":["DI-U-DTU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"aif ω set based protocol abstraction with countable families","src":["dtu","itu"],"src-code":["DI-U-DTU","DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82351862/16_post_aif_omega.pdf","version":"Pre-print"},"id":"S02-083.73-036995","identifier":[{"id":"84962473546","type":"scopus"}],"ids":["dtu-c24c58c8-359f-495f-9fe0-210a2da2bf11","itu-4f436fe2-0c8b-4adb-9127-3f5c00cf76ea"],"keyword":["First-order Horn clauses","ProVerif","Protocol verification","Stateful protocols","Unbounded agents"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-46F8FDFB60DEAF979C7A98AE74358ADA"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82351862/16_post_aif_omega.pdf","version":"Pre-print"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Applied Mathematics and Computer Science"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Theoretical Computer Science, Programming Logic and Semantics"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Sebastian Alexander","key":"mödersheimpau","last":"Mödersheim","locid":"21eb3855-68a7-4647-a3a0-8526af03169f","name":"Mödersheim, Sebastian Alexander","orcid":"0000-0002-6901-8319","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Alessandro","key":"brunipau","last":"Bruni","locid":"5c50bbc9-ed3d-417f-ba4d-e484eaf536b3","name":"Bruni, Alessandro","orcid":"0000-0003-2946-9462","rank":2,"rolecode":"pau"},{"affno":"","first":"Frank","key":"piessenspedh","last":"Piessens","name":"Piessens, Frank","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Luca","key":"viganòpedh","last":"Viganò","name":"Viganò, Luca","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-662-49635-0_12","eisbn":["9783662496350"],"isbn":["9783662496343"],"issn":["03029743","16113349"],"issn_org":["03029743"],"journal":"Lecture Notes in Computer Science","pages":"233-253","paperid":"12","publisher":"Springer","status":"p","title":"Lecture Notes in Computer Science","volume":"9635"},"review":"Peer Reviewed","scoID":["2-s2.0-84962473546"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-c24c58c8-359f-495f-9fe0-210a2da2bf11","itu-4f436fe2-0c8b-4adb-9127-3f5c00cf76ea"],"src":["DTU Technical University of Denmark","ITU IT University of Copenhagen"],"title":"AIF-ω: Set-Based Protocol Abstraction with Countable Families","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-083.73-036995","year":"2016","yearsub":"2016"}
{"abstract":"Embedded real-time systems have been adopted in a wide range of safety-critical applications—including automotive, avionics, and train control systems—where the focus has long been on safety (i.e., protecting the external world from the potential damage caused by the system) rather than security (i.e., protecting the system from the external world). With increased connectivity of these systems to external networks the attack surface has grown, and consequently there is a need for securing the system from external attacks. Introducing security protocols in safety critical systems requires careful considerations on the available resources, especially in meeting real-time and resource constraints, as well as cost and reliability requirements. For this reason many proposed security protocols in this domain have peculiar features, not present in traditional security literature. In this thesis we tackle the problem of analysing security protocols in safety critical embedded systems from multiple perspectives, extending current state-of-the-art analysis techniques where the combination of safety and security hinders our efforts. Examples of protocols in automotive control systems will follow throughout the thesis. We initially take a combined perspective of the safety and security features, by giving a security analysis and a schedulability analysis of the embedded protocols, with intertwined considerations. Then we approach the problem of the expressiveness of the tools used in the analysis, extending saturation-based techniques for formal protocol verification in the symbolic model. Such techniques gain much of their efficiency by coalescing all reachable states into a single set of facts. However, distinguishing different states is a requirement for modelling the protocols that we consider. Our effort in this direction is to extend saturation-based techniques so that enough state information can be modelled and analysed. Finally, we present a methodology for proving the same security properties in the computational model, by means of typing protocol implementations.","author_count":1,"contributors":["Bruni, Alessandro"],"cuid":["S01-000.00-369509"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"und","rtype":["clu"],"sorti":"analysis of security protocols in embedded systems","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dtp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/126069109/phd389_Bruni_A.pdf","version":"Published Version"},"id":"S01-000.00-369509","ids":["dtu-d926bd84-8310-42e0-a233-05cd8283f8b5"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-D989C13BCADD4A107D78FE13C4E6BC7B"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/126069109/phd389_Bruni_A.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Applied Mathematics and Computer Science","Technical University of Denmark, Department of Applied Mathematics and Computer Science, Language-Based Technology"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Alessandro","key":"brunipau","last":"Bruni","locid":"04d6e2ab-ca4c-408b-be86-a5ce7a5467db","name":"Bruni, Alessandro","rank":1,"rolecode":"pau"}],"pub":{"issn":["09093192"],"issue":"389","pages":"155","place":"Kgs. Lyngby","publisher":"Technical University of Denmark","series":"DTU Compute PHD","status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-d926bd84-8310-42e0-a233-05cd8283f8b5"],"src":["DTU Technical University of Denmark"],"title":"Analysis of Security Protocols in Embedded Systems","type":"Thesis PhD","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-369509","year":"2016","yearsub":"2016"}
{"abstract":"In this paper we propose a logical foundation of processes and their focused normal forms. We use a linear meta-language based on substructural operational semantics to describe focused forms of processes, and compare them to standard π-calculus processes with their respective operational semantics. The overall goal of this research is to understand how to reason about processes, multiparty communication and global types, and how to mechanize properties such as deadlock freeness and liveness. We are also interested in establishing the limitations of this approach.","author_count":4,"contributors":["Bock, Peter Brottveit","Murawska, Agata","Bruni, Alessandro","Schürmann, Carsten"],"cuid":["S01-000.00-381460"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Deadlock freeness and liveness","Focused normal forms","Linear meta language","Logical foundations of processes","Substructural operational semantics"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"und","rtype":["clu"],"sorti":"representing session types","src":["itu"],"src-code":["DI-U-ITU"],"type":"doi","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://www.semanticscholar.org/paper/Representing-Session-Types-Bock-Bruni/3504a09d57adb7b7844e419f29ab4b2cb633c1ff","version":"Published Version"},"id":"S01-000.00-381460","ids":["itu-0d096f4a-7074-4091-88f2-2bed4ed4a216"],"keyword":["Deadlock freeness and liveness","Focused normal forms","Linear meta-language","Logical foundations of processes","Substructural operational semantics"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-14A561EA885F3DE32C112CDD67E5454D"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.semanticscholar.org/paper/Representing-Session-Types-Bock-Bruni/3504a09d57adb7b7844e419f29ab4b2cb633c1ff","version":"Published Version"},{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82468059/bock_etal.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Theoretical Computer Science, Programming Logic and Semantics"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Peter Brottveit","key":"bockpau","last":"Bock","name":"Bock, Peter Brottveit","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Agata","key":"murawskapau","last":"Murawska","name":"Murawska, Agata","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Alessandro","key":"brunipau","last":"Bruni","locid":"5c50bbc9-ed3d-417f-ba4d-e484eaf536b3","name":"Bruni, Alessandro","orcid":"0000-0003-2946-9462","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Carsten","key":"schürmannpau","last":"Schürmann","locid":"1313519f-2074-41d6-8b79-589648e37211","name":"Schürmann, Carsten","orcid":"0000-0003-4793-0099","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-0d096f4a-7074-4091-88f2-2bed4ed4a216"],"src":["ITU IT University of Copenhagen"],"title":"Representing Session Types","type":"Other-Internet Publication","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381460","year":"2016","yearsub":"2016"}
{"abstract":"Communication protocols often rely on stateful mechanisms to ensure certain security properties. For example, counters and timestamps can be used to ensure authentication, or the security of communication can depend on whether a particular key is registered to a server or it has been revoked. ProVerif, like other state of the art tools for protocol analysis, achieves good performance by converting a formal protocol specification into a set of Horn clauses, that represent a monotonically growing set of facts that a Dolev-Yao attacker can derive from the system. Since this set of facts is not state-dependent, the category of protocols of our interest cannot be precisely analysed by such tools, as they would report false attacks due to the over-approximation. In this paper we present Set-π, an extension of the Applied π-calculus that includes primitives for handling databases of objects, and propose a translation from Set-π into Horn clauses that employs the set-membership abstraction to capture the non-monotonicity of the state. Furthermore, we give a characterisation of authentication properties in terms of the set properties in the language, and prove the correctness of our approach. Finally we showcase our method with three examples, a simple authentication protocol based on counters, a key registration protocol, and a model of the Yubikey security device.","author_count":4,"contributors":["Bruni, Alessandro","Mödersheim, Sebastian Alexander","Nielson, Flemming","Nielson, Hanne Riis"],"cuid":["S01-000.00-340187"],"event":{"acronym":"CSF","end":"2015-07-17","place":"Verona, it","start":"2015-07-13","title":"2015 IEEE 28th Computer Security Foundations Symposium","year":"2015"},"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"set pi set membership pi calculus","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/120567254/extended.pdf","version":"Authors Final Version"},"id":"S01-000.00-340187","identifier":[{"id":"84961341796","type":"scopus"}],"ids":["dtu-774a6d8e-9a93-432a-a0fd-f6f75c2a11ce"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-22C259B1F4B4B29C69145029DC4B7F85"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/120567254/extended.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Applied Mathematics and Computer Science","Technical University of Denmark, Department of Applied Mathematics and Computer Science, Language-Based Technology"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Alessandro","key":"brunialessandropau","last":"Bruni","locid":"04d6e2ab-ca4c-408b-be86-a5ce7a5467db","name":"Bruni, Alessandro","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sebastian Alexander","key":"mödersheimsebastianalexanderpau","last":"Mödersheim","locid":"21eb3855-68a7-4647-a3a0-8526af03169f","name":"Mödersheim, Sebastian Alexander","orcid":"0000-0002-6901-8319","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Flemming","key":"nielsonflemmingpau","last":"Nielson","locid":"f63ba194-185f-465d-9b2b-1f6ff489bc3d","name":"Nielson, Flemming","orcid":"0000-0001-7362-6176","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Hanne Riis","key":"nielsonhanneriispau","last":"Nielson","locid":"44a7d08e-b083-4419-a466-8f4392a7112f","name":"Nielson, Hanne Riis","orcid":"0000-0002-2484-5580","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1109/csf.2015.20","isbn":["9781467375382"],"issn":["19401434"],"pages":"185-198","publisher":"IEEE","series":"IEEE Computer Security Foundations Symposium. Proceedings","status":"p","title":"Proceedings of the 28th IEEE Computer Security Foundations Symposium (CSF 2015)"},"review":"Peer Reviewed","scoID":["2-s2.0-84961341796"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-774a6d8e-9a93-432a-a0fd-f6f75c2a11ce"],"src":["DTU Technical University of Denmark"],"title":"Set-Pi: Set Membership pi-Calculus","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-340187","year":"2015","yearsub":"2015"}
{"abstract":"BACKGROUND: Frontotemporal dementia (FTD) is a complex disorder characterised by a broad range of clinical manifestations, differential pathological signatures, and genetic variability. Mutations in three genes-MAPT, GRN, and C9orf72-have been associated with FTD. We sought to identify novel genetic risk loci associated with the disorder. METHODS: We did a two-stage genome-wide association study on clinical FTD, analysing samples from 3526 patients with FTD and 9402 healthy controls. To reduce genetic heterogeneity, all participants were of European ancestry. In the discovery phase (samples from 2154 patients with FTD and 4308 controls), we did separate association analyses for each FTD subtype (behavioural variant FTD, semantic dementia, progressive non-fluent aphasia, and FTD overlapping with motor neuron disease [FTD-MND]), followed by a meta-analysis of the entire dataset. We carried forward replication of the novel suggestive loci in an independent sample series (samples from 1372 patients and 5094 controls) and then did joint phase and brain expression and methylation quantitative trait loci analyses for the associated (p<5 × 10(-8)) single-nucleotide polymorphisms. FINDINGS: We identified novel associations exceeding the genome-wide significance threshold (p<5 × 10(-8)). Combined (joint) analyses of discovery and replication phases showed genome-wide significant association at 6p21.3, HLA locus (immune system), for rs9268877 (p=1·05 × 10(-8); odds ratio=1·204 [95% CI 1·11-1·30]), rs9268856 (p=5·51 × 10(-9); 0·809 [0·76-0·86]) and rs1980493 (p value=1·57 × 10(-8), 0·775 [0·69-0·86]) in the entire cohort. We also identified a potential novel locus at 11q14, encompassing RAB38/CTSC (the transcripts of which are related to lysosomal biology), for the behavioural FTD subtype for which joint analyses showed suggestive association for rs302668 (p=2·44 × 10(-7); 0·814 [0·71-0·92]). Analysis of expression and methylation quantitative trait loci data suggested that these loci might affect expression and methylation in cis. INTERPRETATION: Our findings suggest that immune system processes (link to 6p21.3) and possibly lysosomal and autophagy pathways (link to 11q14) are potentially involved in FTD. Our findings need to be replicated to better define the association of the newly identified loci with disease and to shed light on the pathomechanisms contributing to FTD. FUNDING: The National Institute of Neurological Disorders and Stroke and National Institute on Aging, the Wellcome/MRC Centre on Parkinson's disease, Alzheimer's Research UK, and Texas Tech University Health Sciences Center.","author_count":158,"contributors":["Ferrari, Raffaele","Hernandez, Dena G","Nalls, Michael A","Rohrer, Jonathan D","Ramasamy, Adaikalavan","Kwok, John B J","Dobson-Stone, Carol","Brooks, William S","Schofield, Peter R","Halliday, Glenda M","Hodges, John R","Piguet, Olivier","Bartley, Lauren","Thompson, Elizabeth","Haan, Eric","Hernández, Isabel","Ruiz, Agustín","Boada, Mercè","Borroni, Barbara","Padovani, Alessandro","Cruchaga, Carlos","Cairns, Nigel J","Benussi, Luisa","Binetti, Giuliano","Ghidoni, Roberta","Forloni, Gianluigi","Galimberti, Daniela","Fenoglio, Chiara","Serpente, Maria","Scarpini, Elio","Clarimón, Jordi","Lleó, Alberto","Blesa, Rafael","Waldö, Maria Landqvist","Nilsson, Karin","Nilsson, Christer","Mackenzie, Ian R A","Hsiung, Ging-Yuek R","Mann, David M A","Grafman, Jordan","Morris, Christopher M","Attems, Johannes","Griffiths, Timothy D","McKeith, Ian G","Thomas, Alan J","Pietrini, P","Huey, Edward D","Wassermann, Eric M","Baborie, Atik","Jaros, Evelyn","Tierney, Michael C","Pastor, Pau","Razquin, Cristina","Ortega-Cubero, Sara","Alonso, Elena","Perneczky, Robert","Diehl-Schmid, Janine","Alexopoulos, Panagiotis","Kurz, Alexander","Rainero, Innocenzo","Rubino, Elisa","Pinessi, Lorenzo","Rogaeva, Ekaterina","St George-Hyslop, Peter","Rossi, Giacomina","Tagliavini, Fabrizio","Giaccone, Giorgio","Rowe, James B","Schlachetzki, Johannes C M","Uphill, James","Collinge, John","Mead, Simon","Danek, Adrian","Van Deerlin, Vivianna M","Grossman, Murray","Trojanowski, John Q","van der Zee, Julie","Deschamps, William","Van Langenhove, Tim","Cruts, Marc","Van Broeckhoven, Christine","Cappa, Stefano F","Le Ber, Isabelle","Hannequin, Didier","Golfier, Véronique","Vercelletto, Martine","Brice, Alexis","Nacmias, Benedetta","Sorbi, Sandro","Bagnoli, Silvia","Piaceri, Irene","Nielsen, Jørgen Erik","Hjermind, Lena Elisabeth","Riemenschneider, Matthias","Mayhaus, Manuel","Ibach, Bernd","Gasparoni, Gilles","Pichler, Sabrina","Gu, Wei","Rossor, Martin N","Fox, Nick C","Warren, Jason D","Spillantini, Maria Grazia","Morris, Huw R","Rizzu, Patrizia","Heutink, Peter","Snowden, Julie S","Rollinson, Sara","Richardson, Anna","Gerhard, Alexander","Bruni, Amalia C","Maletta, Raffaele","Frangipane, Francesca","Cupidi, Chiara","Bernardi, Livia","Anfossi, Maria","Gallo, Maura","Conidi, Maria Elena","Smirne, Nicoletta","Rademakers, Rosa","Baker, Matt","Dickson, Dennis W","Graff-Radford, Neill R","Petersen, Ronald C","Knopman, David","Josephs, Keith A","Boeve, Bradley F","Parisi, Joseph E","Seeley, William W","Miller, Bruce L","Karydas, Anna M","Rosen, Howard","van Swieten, John C","Dopper, Elise G P","Seelaar, Harro","Pijnenburg, Yolande A L","Scheltens, Philip","Logroscino, Giancarlo","Capozzo, Rosa","Novelli, Valeria","Puca, Annibale A","Franceschi, Massimo","Postiglione, Alfredo","Milan, Graziella","Sorrentino, Paolo","Kristiansen, Mark","Chiang, Huei-Hsin","Graff, Caroline","Pasquier, Florence","Rollin, Adeline","Deramecourt, Vincent","Lebert, Florence","Kapogiannis, Dimitrios","Ferrucci, Luigi","Pickering-Brown, Stuart","Singleton, Andrew B","Hardy, John","Momeni, Parastoo"],"cuid":["S01-000.00-523004"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"51-200 contributors","cluster_size":1,"continent":["America, North","Europe, EU","Europe, Non-EU","Nordic","OECD","Oceania"],"country":["Au