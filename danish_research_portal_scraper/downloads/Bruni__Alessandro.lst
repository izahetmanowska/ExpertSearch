{"author_count":4,"contributors":["Bruni, Alessandro","Mödersheim, Sebastian Alexander","Nielson, Flemming","Nielson, Hanne Riis"],"cuid":["S01-000.00-363656"],"event":{"acronym":"NordSec","end":"2014-10-17","place":"Tromsø, no","start":"2014-10-15","title":"19th Nordic Conference on Secure IT Systems (NordSec 2014)","year":"2014"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"verification of stateful protocols set based abstractions in the applied pi calculus","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-363656","ids":["dtu-c5e02c32-701d-4df3-9e9f-ecdacaf1fe90"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-66A663FD0DDD0DA94231A066EE1954EE"],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Applied Mathematics and Computer Science","Technical University of Denmark, Department of Applied Mathematics and Computer Science, Language-Based Technology"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Alessandro","key":"brunialessandropau","last":"Bruni","locid":"04d6e2ab-ca4c-408b-be86-a5ce7a5467db","name":"Bruni, Alessandro","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sebastian Alexander","key":"mödersheimsebastianalexanderpau","last":"Mödersheim","locid":"21eb3855-68a7-4647-a3a0-8526af03169f","name":"Mödersheim, Sebastian Alexander","orcid":"0000-0002-6901-8319","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Flemming","key":"nielsonflemmingpau","last":"Nielson","locid":"f63ba194-185f-465d-9b2b-1f6ff489bc3d","name":"Nielson, Flemming","orcid":"0000-0001-7362-6176","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Hanne Riis","key":"nielsonhanneriispau","last":"Nielson","locid":"44a7d08e-b083-4419-a466-8f4392a7112f","name":"Nielson, Hanne Riis","orcid":"0000-0002-2484-5580","rank":4,"rolecode":"pau"}],"pub":{"isbn":["9783319115986"],"issn":["03029743"],"issue":"8788","pages":"281-282","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","title":"Proceedings of the 19th Nordic Conference on Secure IT Systems, NordSec 2014"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-c5e02c32-701d-4df3-9e9f-ecdacaf1fe90"],"src":["DTU Technical University of Denmark"],"title":"Verification of Stateful Protocols - Set-Based Abstractions in the Applied Pi-Calculus","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-363656","year":"2014","yearsub":"2014"}
{"abstract":"The development of quantitative security analyses that consider both active attackers and reactive defenders is a main challenge in the design of trustworthy Cyber-Physical Systems. We propose a game-theoretic approach where it is natural to model attacker’s and defender’s actions explicitly, associating costs to attacks and countermeasures. Cost considerations enable to contrast different strategies on the basis of their effectiveness and efficiency, paving the way to a multi-objective notion of optimality. Moreover, the framework allows expressing the probabilistic nature of the environment and of the attack detection process. Finally, a solver is presented to compute strategies and their costs, resorting to a recent combination of strategy iteration with linear programming.","author_count":3,"contributors":["Vigo, Roberto","Bruni, Alessandro","Yuksel, Ender"],"cuid":["S01-000.00-347193"],"event":{"acronym":"NordSec","end":"2013-10-21","place":"Ilulissat, gl","start":"2013-10-18","title":"18th Nordic Conference on Secure IT Systems (NordSec 2013)","year":"2013"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"security games for cyber physical systems","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-3-642-41488-6_2","version":"Other Version"},"id":"S01-000.00-347193","identifier":[{"id":"84890864072","type":"scopus"}],"ids":["dtu-8edec13e-2d8d-460a-948f-867a9c728528"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-3EFBE45C7039B1A4FA5771B95F7A5DF3"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-3-642-41488-6_2","versi