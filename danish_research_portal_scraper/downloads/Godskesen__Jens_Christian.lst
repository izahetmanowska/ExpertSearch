{"author_count":3,"contributors":["Song, Lei","Zhang, Lijun","Godskesen, Jens Christian"],"cuid":["S01-000.00-383039"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","Max Planck Institute for Informatics"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"bisimulations and logical characterizations on continuous time markov decision processes","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-3-642-54013-4","version":"Other Version"},"id":"S01-000.00-383039","identifier":[{"id":"84893341585","type":"scopus"}],"ids":["itu-77dc186b-9611-44ef-ace9-6281e948e0d3"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-E0F8F977977E4DAD32AA2E831AEFE049"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-3-642-54013-4","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","country":"de","key":"max planck institute for informatics","loc":["Germany","Europe, EU","OECD"],"name":"Max Planck Institute for Informatics","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Executive Management","The Department"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lei","key":"songpau","last":"Song","name":"Song, Lei","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Lijun","key":"zhangpau","last":"Zhang","name":"Zhang, Lijun","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jens Christian","key":"godskesenpau","last":"Godskesen","locid":"37d49222-56d7-4c65-8d52-3638544511cf","name":"Godskesen, Jens Christian","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-642-54013-4","issn":["03029743","16113349"],"issn_org":["03029743"],"journal":"Lecture Notes in Computer Science","pages":"98-117","publisher":"Springer","status":"p","title":"Lecture Notes in Computer Science","volume":"8318"},"review":"Peer Reviewed","scoID":["2-s2.0-84958533280"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-77dc186b-9611-44ef-ace9-6281e948e0d3"],"src":["ITU IT University of Copenhagen"],"title":"Bisimulations and Logical Characterizations on Continuous-Time Markov Decision Processes","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383039","year":"2014","yearsub":"2014"}
{"abstract":"Probabilistic automata (PA) have been successfully applied in the formal verification of concurrent and stochastic systems. Efficient model checking algorithms have been studied, where the most often used logics for expressing properties are based on PCTL and its extension PCTL*. Various behavioral equivalences are proposed for PAs, as a powerful tool for abstraction and compositional minimization for PAs. Unfortunately, the behavioral equivalences are well-known to be strictly stronger than the logical equivalences induced by PCTL or PCTL*. This paper introduces novel notions of strong bisimulation relations, which characterizes PCTL and PCTL* exactly. We also extend weak bisimulations characterizing PCTL and PCTL* without next operator, respectively. Thus, our paper bridges the gap between logical and behavioral equivalences in this setting.","author_count":3,"contributors":["Song, Lei","Zhang, Lijun","Godskesen, Jens Christian"],"cuid":["S01-000.00-383861"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Bisimulation","Logic Characterization","PCTL","Probabilistic Automata"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-ITU"]},"level3all":["DI-U-DTU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"bisimulation meet pctl equivalences for probabilistic automata journal version","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/34921450/pctl.pdf","version":"Authors Final Version"},"id":"S01-000.00-383861","ids":["itu-b1d96155-b491-4126-a0f3-396faa048150"],"keyword":["Bisimulation","Logic Characterization","PCTL","Probabilistic Automata"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-B2576221A171383DED898DD64A4A467C"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/34921450/pctl.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["The Department, Theoretical Computer Science"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"dk","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lei","key":"songpau","last":"Song","name":"Song, Lei","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lijun","key":"zhangpau","last":"Zhang","name":"Zhang, Lijun","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens Christian","key":"godskesenpau","last":"Godskesen","locid":"37d49222-56d7-4c65-8d52-3638544511cf","name":"Godskesen, Jens Christian","rank":3,"rolecode":"pau"}],"pub":{"issn":["18605974"],"issue":"2","journal":"Logical Methods in Computer Science","publisher":"International Federation for Computational Logic","status":"p","title":"Logical Methods in Computer Science","volume":"9"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["itu-b1d96155-b491-4126-a0f3-396faa048150"],"src":["ITU IT University of Copenhagen"],"title":"Bisimulation Meet PCTL Equivalences for Probabilistic Automata (Journal Version)","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383861","year":"2013","yearsub":"2013"}
{"abstract":"Abstraction refinement techniques in probabilistic model checking are prominent approaches to the verification of very large or infinite-state probabilistic concurrent systems. At the core of the refinement step lies the implicit or explicit analysis of a counterexample. This paper proposes an abstraction refinement approach for the probabilistic computation tree logic (PCTL), which is based on incrementally computing a sequence of may- and must-quotient automata. These are induced by depth-bounded bisimulation equivalences of increasing depth. The approach is both sound and complete, since the equivalences converge to the genuine PCTL equivalence. Experimental results with a prototype implementation show the effectiveness of the approach.","author_count":3,"contributors":["Godskesen, Jens Christian","Song, Lei","Zhang, Lijun"],"cuid":["S01-000.00-384994"],"event":{"acronym":"ACSD","end":"2013-07-10","place":"Barcelona, es","start":"2013-07-08","title":"13th International Conference on Application of Concurrency to System Design","year":"2013"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Abstraction Refinement","Bisimulation Equivalences","Counterexample Analysis","PCTL","Probabilistic Model Checking"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-ITU"]},"level3all":["DI-U-DTU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"incremental bisimulation abstraction refinement","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1109/ACSD.2013.5","version":"Other Version"},"id":"S01-000.00-384994","identifier":[{"id":"84885646005","type":"scopus"}],"ids":["itu-fdbca93f-1b1c-49f9-8983-b9e2c5b848ca"],"keyword":["Abstraction Refinement","Bisimulation Equivalences","Counterexample Analysis","PCTL","Probabilistic Model Checking"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-9394A59DC140AE340A15F8B9A306632B"],"oa_link":[{"access":"oa","type":"rem","url":"http://ieeexplore.ieee.org/xpl/login.jsp?tp=&arnumber=6598336&url=http%3A%2F%2Fieeexplore.ieee.org%2Fxpls%2Fabs_all.jsp%3Farnumber%3D6598336","version":"Other Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1109/ACSD.2013.5","version":"Other Version"}],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Executive Management","The Department"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"dk","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jens Christian","key":"godskesenpau","last":"Godskesen","locid":"37d49222-56d7-4c65-8d52-3638544511cf","name":"Godskesen, Jens Christian","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Lei","key":"songpau","last":"Song","name":"Song, Lei","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lijun","key":"zhangpau","last":"Zhang","name":"Zhang, Lijun","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1109/acsd.2013.5","issn":["15504808","23748567"],"issn_org":["15504808"],"journal":"Proceedings of the International Conference on Application of Concurrency to System Design","pages":"11-20","publisher":"IEEE","status":"p","title":"Proceedings of the International Conference on Application of Concurrency to System Design"},"review":"Peer Reviewed","scoID":["2-s2.0-84885646005"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["itu-fdbca93f-1b1c-49f9-8983-b9e2c5b848ca"],"src":["ITU IT University of Copenhagen"],"title":"Incremental Bisimulation Abstraction Refinement","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384994","year":"2013","yearsub":"2013"}
{"abstract":"We introduce a continuous time stochastic broadcast calculus for mobile and wireless networks. The mobility between nodes in a network is modeled by a stochastic mobility function which allows to change part of a network topology depending on an exponentially distributed delay and a network topology constraint. We allow continuous time stochastic behavior of processes running at network nodes, e.g. in order to be able to model randomized protocols. The introduction of group broadcast and an operator to help avoid flooding allows us to define a novel notion of broadcast abstraction. Finally, we define a weak bisimulation congruence and apply our theory on an example of a leader election protocol.","author_count":2,"contributors":["Song, Lei","Godskesen, Jens Christian"],"cuid":["S01-000.00-382701"],"event":{"end":"2012-09-28","place":"Amsterdam, nl","start":"2012-09-26","title":"IFIP Theoretical Computer Science 2012","year":"2012"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Broadcast Abstraction","Mobility","Stochastic Calculus"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"broadcast abstraction in a stochastic calculus for mobile networks","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/37561702/TCS.pdf","version":"Published Version"},"id":"S01-000.00-382701","identifier":[{"id":"84866898863","type":"scopus"}],"ids":["itu-5f140d48-3e51-4015-af2a-4520249dfbc7"],"keyword":["Broadcast Abstraction","Mobility","Stochastic Calculus"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-873C251CC5FD43C5D46CCA0CFFAA7C00"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/37561702/TCS.pdf","version":"Published Version"},{"access":"oa","type":"rem","url":"http://www.springer.com/computer/theoretical+computer+science/book/978-3-642-33474-0","version":"Other Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["The Department, Theoretical Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lei","key":"songpau","last":"Song","name":"Song, Lei","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens Christian","key":"godskesenpau","last":"Godskesen","locid":"37d49222-56d7-4c65-8d52-3638544511cf","name":"Godskesen, Jens Christian","rank":2,"rolecode":"pau"}],"pub":{"isbn":["9783642334740"],"issn":["03029743"],"pages":"342-356","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","subtitle":"Proceedings of the 7th IFIP TC 1/WG 2.2 International Conference, TCS 2012, Amsterdam, The Netherlands, September 26-28, 2012","title":"Theoretical Computer Science","volume":"4604"},"review":"Peer Reviewed","scoID":["2-s2.0-84866898863"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-5f140d48-3e51-4015-af2a-4520249dfbc7"],"src":["ITU IT University of Copenhagen"],"title":"Broadcast Abstraction in a Stochastic Calculus for Mobile Networks","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382701","year":"2012","yearsub":"2012"}
