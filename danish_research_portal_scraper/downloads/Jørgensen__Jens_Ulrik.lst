{"author_count":12,"contributors":["Andreasen, Christine Rode","Andersen, A.","Haqelqvist, P. G.","Abelin, K.","Lauritsen, J. V.","Jorgensen, P. G.","Engberg, S.","Faber, Jens","Holst, Jens Juul","Pedersen-Bjergaard, Ulrik","Knop, Filip K.","Vilsbøll, Tina"],"cuid":["S01-000.00-530838"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the impact of acute fluctuations in plasma glucose on echocardiographic derived measures of systolic function in patients with type 000000000001 diabetes","src":["ku"],"src-code":["DI-U-KU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"doi","url":"https://doi.org/10.1007/s00125-021-05519-y","version":"Published Version"},"id":"S01-000.00-530838","identifier":[{"id":"000696550100260","type":"wos"},{"id":"PMC8408311","type":"pmcid"},{"id":"34468792","type":"pmid"}],"ids":["ku-e61823a1-f928-4676-baab-57ad27c7e328"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-EB8F020169D2EDA6D7E3A85C55C7373C"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"doi","url":"https://doi.org/10.1007/s00125-021-05519-y","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"C. R.","key":"andreasenpau","last":"Andreasen","locid":"2ec29052-bf76-48ff-82ac-b48b70c87c53","name":"Andreasen, Christine Rode","name_org":"Andreasen, C. R.","rank":1,"rolecode":"pau"},{"affno":"","first":"A.","key":"andersenpau","last":"Andersen","name":"Andersen, A.","rank":2,"rolecode":"pau"},{"affno":"","first":"P. G.","key":"haqelqvistpau","last":"Haqelqvist","name":"Haqelqvist, P. G.","rank":3,"rolecode":"pau"},{"affno":"","first":"K.","key":"abelinpau","last":"Abelin","name":"Abelin, K.","rank":4,"rolecode":"pau"},{"affno":"","first":"J. V.","key":"lauritsenpau","last":"Lauritsen","name":"Lauritsen, J. V.","rank":5,"rolecode":"pau"},{"affno":"","first":"P. G.","key":"jorgensenpau","last":"Jorgensen","name":"Jorgensen, P. G.","rank":6,"rolecode":"pau"},{"affno":"","first":"S.","key":"engbergpau","last":"Engberg","name":"Engberg, S.","rank":7,"rolecode":"pau"},{"affno":"1","first":"J.","key":"faberpau","last":"Faber","locid":"42925e6e-5e0c-475f-aca8-13159f10abc7","name":"Faber, Jens","name_org":"Faber, J.","rank":8,"rolecode":"pau"},{"affno":"1","first":"J. J.","key":"holstpau","last":"Holst","locid":"864b6401-9024-4773-9bdb-f4d4ca57dcad","name":"Holst, Jens Juul","name_org":"Holst, J. J.","orcid":"0000-0001-6853-3805","rank":9,"rolecode":"pau"},{"affno":"1","first":"U.","key":"pedersenbjergaardpau","last":"Pedersen-Bjergaard","locid":"3337607d-37ca-406d-81de-725da3b21dda","name":"Pedersen-Bjergaard, Ulrik","name_org":"Pedersen-Bjergaard, U.","rank":10,"rolecode":"pau"},{"affno":"1","first":"Filip Krag","key":"knoppau","last":"Knop","locid":"ce6eaad9-59f8-4ecf-8a1e-388a74734f6a","name":"Knop, Filip K.","name_org":"Knop, Filip Krag","rank":11,"rolecode":"pau"},{"affno":"1","first":"T.","key":"vilsbollpau","last":"Vilsboll","locid":"76773372-af8c-45a0-9447-a509cbf6d466","name":"Vilsbøll, Tina","name_org":"Vilsboll, T.","orcid":"0000-0002-0456-6787","rank":12,"rolecode":"pau"}],"pmid":["34468792"],"pub":{"doi":"10.1007/s00125-021-05519-y","issn":["0012186X","14320428"],"issn_org":["0012186X"],"issue":"SUPPL 1","journal":"Diabetologia","pages":"135-136","status":"p","title":"Diabetologia","volume":"64"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-e61823a1-f928-4676-baab-57ad27c7e328"],"src":["KU University of Copenhagen"],"title":"The impact of acute fluctuations in plasma glucose on echocardiographic derived measures of systolic function in patients with type 1 diabetes","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-530838","year":"2021","yearsub":"2021"}
{"abstract":"BACKGROUND: Most data on intensive care unit (ICU) patients with COVID-19 originate in selected populations from stressed healthcare systems with shorter term follow-up. We present characteristics, interventions and longer term outcomes of the entire, unselected cohort of all ICU patients with COVID-19 in Denmark where the ICU capacity was not exceeded. METHODS: We identified all patients with SARS-CoV-2 admitted to any Danish ICU from 10 March to 19 May 2020 and registered demographics, chronic comorbidities, use of organ support, length of stay, and vital status from patient files. Risk factors for death were analyzed using adjusted Cox regression analysis. RESULTS: There were 323 ICU patients with confirmed COVID-19. Median age was 68 years, 74% were men, 50% had hypertension, 21% diabetes, and 20% chronic pulmonary disease; 29% had no chronic comorbidity. Invasive mechanical ventilation was used in 82%, vasopressors in 83%, renal replacement therapy in 26%, and extra corporeal membrane oxygenation in 8%. ICU stay was median 13 days (IQR 6-22) and hospital stay 19 days (11-30). Median follow-up was 79 days. At end of follow-up, 118 had died (37%), 15 (4%) were still in hospital hereof 4 in ICU as of 16 June 2020. Risk factors for mortality included male gender, age, chronic pulmonary disease, active cancer, and number of co-morbidities. CONCLUSIONS: In this nationwide, population-based cohort of ICU patients with COVID-19, longer term survival was high despite high age and substantial use of organ support. Male gender, age, and chronic co-morbidities, in particular chronic pulmonary disease, were associated with increased risk of death.","author_count":37,"contributors":["Haase, Nicolai","Plovsing, Ronni","Christensen, Steffen","Poulsen, Lone Musaeus","Brøchner, Anne Craveiro","Rasmussen, Bodil Steen","Helleberg, Marie","Jensen, Jens Ulrik Staehr","Andersen, Lars Peter Kloster","Siegel, Hanna","Ibsen, Michael","Jørgensen, Vibeke","Winding, Robert","Iversen, Susanne","Pedersen, Henrik Planck","Madsen, Jacob","Sølling, Christoffer","Garcia, Ricardo Sanchez","Michelsen, Jens","Mohr, Thomas","Mannering, Anne","Espelund, Ulrick Skipper","Bundgaard, Helle","Kirkegaard, Lynge","Smitt, Margit","Buck, David Levarett","Ribergaard, Niels-Erik","Pedersen, Helle Scharling","Christensen, Birgitte Viebaek","Perner, Anders"],"cuid":["S04-095.62-001992"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"corresponding_author":["Haase, Nicolai"],"keyword":["Comorbidities","Covid 19","Intensive care","Mortality","SARS CoV 2"],"level":"sci","mra":["med","soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA"],"OT":["Unspecified organisation"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"characteristics interventions and longer term outcomes of covid 000000000019 icu patients in denmark a nationwide observational study","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://curis.ku.dk/ws/files/331779186/Characteristics_interventions_and_longer_term_outcomes_2_19.pdf","version":"Authors Final Version"},"funding_acknowledgement":["The study was partly done within the framework of the COVID STEROID trial ( ClinicalTrials.gov Identifier NCT04348305), which is funded by the Novo Nordisk Foundation and supported by Pfizer. None of the authors declared any other conflicts of interest."],"id":"S04-095.62-001992","identifier":[{"id":"85091854105","type":"scopus"},{"id":"32929715","type":"pmid"},{"id":"000574646300001