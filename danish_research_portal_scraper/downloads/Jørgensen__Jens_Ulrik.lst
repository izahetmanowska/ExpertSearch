ECD"],"name":"Miscellaneous","namevar":["Regionernes Kliniske Kvalitetsudviklingsprogram (RKKP)"],"nora_code":"DI-OT","used":1},{"affno":"6","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Cardiology","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Anæstesi, Børn, Kredsløb og Kvinder"],"nora_code":"DI-U-AAU","used":1},{"affno":"7","country":"dk","key":"ssi statens serum institut","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-SSI","l3nn":"SSI Statens Serum Institut","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SSI Statens Serum Institut","namevar":["Statens Serum Institut"],"nora_code":"DI-GV-SSI","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Thomas","key":"olsenpau","last":"Olsen","name":"Olsen, Thomas","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Ulrik Stenz","key":"justesenpau","last":"Justesen","name":"Justesen, Ulrik Stenz","rank":2,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Jens Cosedis","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Jens Cosedis","rank":3,"rolecode":"pau"},{"affno":"1 5","corresponding":null,"first":"Ole Dan","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, Ole Dan","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Niels Christian Foldager","key":"sandgaardpau","last":"Sandgaard","name":"Sandgaard, Niels Christian Foldager","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christen","key":"ravnpau","last":"Ravn","name":"Ravn, Christen","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Christian","key":"gerdespau","last":"Gerdes","name":"Gerdes, Christian","rank":7,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Anna Margrethe","key":"thøgersenpau","last":"Thøgersen","locid":"040c49e1-e9f1-4e74-8cd0-4a9ef9fb7006","name":"Thøgersen, Anna Margrethe","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sabine","key":"gillpau","last":"Gill","name":"Gill, Sabine","rank":9,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Kurt","key":"fuurstedpau","last":"Fuursted","name":"Fuursted, Kurt","rank":10,"rolecode":"pau"},{"affno":"1 2 5","corresponding":null,"first":"Jens Brock","key":"johansenpau","last":"Johansen","name":"Johansen, Jens Brock","rank":11,"rolecode":"pau"}],"pmid":["35124230"],"pub":{"doi":"10.1016/j.hrthm.2022.01.039","issn":["00365521","15027708"],"issn_org":["00365521"],"issue":"6","journal":"Scandinavian Journal of Gastroenterology","pages":"901-908","publisher":"Taylor & Francis","status":"p","title":"Scandinavian Journal of Gastroenterology","volume":"19"},"review":"Peer Reviewed","scoID":["2-s2.0-85125932103"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Miscellaneous","All Universities","Central Denmark Region","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Miscellaneous","Other Research","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-596d0cad-a673-4013-a6c0-12bede8e25fd"],"src":["AAU Aalborg University"],"title":"Microbiological Diagnosis in Cardiac Implantable Electronic Device Infections Detected by Sonication and Next-Generation Sequencing","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-075978","year":"2022","yearsub":"2022"}
{"abstract":"AIM: To investigate echocardiographic changes during acute hypoglycaemia followed by recovery to hyperglycaemia or euglycaemia in patients with type 1 diabetes. MATERIALS AND METHODS: In a randomized crossover study, 24 patients with type 1 diabetes took part in two experimental study days, consisting of a hyperinsulinaemic-euglycaemic phase (5.0-8.0 mmol/L) for 45 minutes followed by a hyperinsulinemic-hypoglycaemic phase (2.5 mmol/L) for 60 minutes, and a recovery phase in either hyperglycaemia (20 mmol/L) or euglycaemia (5.0-8.0 mmol/L) for 60 minutes. Cardiac function was evaluated with echocardiography during each phase. RESULTS: Acute hypoglycaemia increased all markers of left ventricular (LV) systolic function, including LV ejection fraction (LVEF), global longitudinal strain (GLS), GLS rate and peak systolic velocity of mitral annular longitudinal movement (s'; P < 0.001 for all). During the recovery phases, all markers of LV systolic function were increased during hyperglycaemia (P < 0.01 for all), and LVEF and GLS remained increased during euglycaemia (P = 0.0116 and P = 0.0092, respectively). The increment in LVEF during the recovery phase was greater during hyperglycaemia than euglycaemia (P = 0.0046). CONCLUSIONS: Hypoglycaemia, recent hypoglycaemia, and overcorrection of hypoglycaemia to rebound hyperglycaemia increased LV systolic function in type 1 diabetes and may imply consideration of plasma glucose when evaluating LV function in patients with type 1 diabetes. An increase in LV systolic function may cause increased strain on the heart and partly explain the link between hypoglycaemia, high glycaemic variability and cardiovascular disease.","author_count":11,"contributors":["Andreasen, Christine R.","Andersen, Andreas","Hagelqvist, Per G.","Lauritsen, Julius V","Jørgensen, Peter G.","Engberg, Susanne","Faber, Jens","Hartmann, Bolette","Pedersen-Bjergaard, Ulrik","Knop, Filip K.","Vilsbøll, Tina"],"cuid":["S01-000.00-498213"],"filters":{"added":"2022-11","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"OT":["Steno Diabetes Centre, Gentofte, Denmark."],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"hypoglycaemia and rebound hyperglycaemia increase left ventricular systolic function in patients with type 000000000001 diabetes","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://curis.ku.dk/ws/files/329417361/IKM_Diabetes_Obesity_Metabolism_2022_Andreasen_Hypoglycaemia_and_rebound_hyperglycaemia_increase_left_ventricular.pdf","version":"Authors Final Version"},"id":"S01-000.00-498213","identifier":[{"id":"85134970404","type":"scopus"},{"id":"35670658","type":"pmid"}],"ids":["ku-af711754-43ed-481f-81a6-5edb7c124c3f"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-24CAAF5938A4D58E6B9ACE2DAD194102"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://curis.ku.dk/ws/files/329417361/IKM_Diabetes_Obesity_Metabolism_2022_Andreasen_Hypoglycaemia_and_rebound_hyperglycaemia_increase_left_ventricular.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Steno Diabetes Centre, Gentofte, Denmark."],"nora_code":"DI-OT","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal Medicine: Endocrinology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Christine R.","key":"andreasenpau","last":"Andreasen","name":"Andreasen, Christine R.","rank":1,"rolecode":"pau"},{"affno":"1","first":"Andreas","key":"andersenpau","last":"Andersen","name":"Andersen, Andreas","rank":2,"rolecode":"pau"},{"affno":"1","first":"Per G.","key":"hagelqvistpau","last":"Hagelqvist","name":"Hagelqvist, Per G.","rank":3,"rolecode":"pau"},{"affno":"1","first":"Julius V","key":"lauritsenpau","last":"Lauritsen","name":"Lauritsen, Julius V","rank":4,"rolecode":"pau"},{"affno":"2","first":"Peter G.","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, Peter G.","rank":5,"rolecode":"pau"},{"affno":"1","first":"Susanne","key":"engbergpau","last":"Engberg","name":"Engberg, Susanne","rank":6,"rolecode":"pau"},{"affno":"3","first":"Jens","key":"faberpau","last":"Faber","locid":"42925e6e-5e0c-475f-aca8-13159f10abc7","name":"Faber, Jens","rank":7,"rolecode":"pau"},{"affno":"3","first":"Bolette","key":"hartmannpau","last":"Hartmann","locid":"eb04fc6b-068a-4d5b-a106-1b7be3f7e12b","name":"Hartmann, Bolette","orcid":"0000-0001-8509-2036","rank":8,"rolecode":"pau"},{"affno":"3","first":"Ulrik","key":"pedersenbjergaardpau","last":"Pedersen-Bjergaard","locid":"3337607d-37ca-406d-81de-725da3b21dda","name":"Pedersen-Bjergaard, Ulrik","rank":9,"rolecode":"pau"},{"affno":"3","first":"Filip K","key":"knoppau","last":"Knop","locid":"ce6eaad9-59f8-4ecf-8a1e-388a74734f6a","name":"Knop, Filip K.","name_org":"Knop, Filip K","rank":10,"rolecode":"pau"},{"affno":"3","first":"Tina","key":"vilsbøllpau","last":"Vilsbøll","locid":"76773372-af8c-45a0-9447-a509cbf6d466","name":"Vilsbøll, Tina","orcid":"0000-0002-0456-6787","rank":11,"rolecode":"pau"}],"pmid":["35670658"],"pub":{"doi":"10.1111/dom.14790","issn":["14628902","14631326"],"issn_org":["14628902"],"issue":"10","journal":"Diabetes, Obesity and Metabolism","pages":"2027-2037","status":"p","title":"Diabetes, Obesity and Metabolism","volume":"24"},"review":"Peer Reviewed","scoID":["2-s2.0-85134970404"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-af711754-43ed-481f-81a6-5edb7c124c3f"],"src":["KU University of Copenhagen"],"title":"Hypoglycaemia and rebound hyperglycaemia increase left ventricular systolic function in patients with type 1 diabetes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-498213","year":"2022","yearsub":"2022"}
{"abstract":"Background Single-nucleotide polymorphisms (SNPs) of the glucocorticoid receptor (GR) gene NR3C1 have been associated with an altered sensitivity to glucocorticoids, and thus may alter the therapeutic effects of glucocorticoids. We investigated the prevalence of adrenal suppression after treatment with glucocorticoids and evaluated whether GR SNPs were associated with altered risks of adrenal suppression and metabolic disorders in patients with chronic obstructive pulmonary disease (COPD). Methods In an observational prospective cohort study, we recruited 78 patients with severe COPD receiving 5 days glucocorticoid treatment for an exacerbation of COPD. In total, 55% of these patients were also receiving regular inhaled corticosteroids (ICS). Adrenal function was evaluated with a corticotropin test 30 days after the exacerbation. Patients were genotyped for Bcl1, N363S, ER22/23EK, and 9 beta SNPs. Results The prevalence of adrenal suppression (corticotropin-stimulated plasma-cortisol 0.05). Carriers of the high-sensitivity GR gene haplotype exhibited a steeper decline in stimulated P-cortisol with increased ICS dose (slope, -1.35 vs. 0.94; p = 0.17), compared to the group with low-sensitivity or wild-type haplotypes, respectively. Conclusions In total, 5% of patients exhibited insufficient adrenal function. The Bcl1 and N363S polymorphisms did not seem to increase the risk of glucocorticoid suppression or metabolic disorders in adults treated with glucocorticoids for COPD exacerbations.","author_count":15,"contributors":["Sivapalan, Pradeesh","Borresen, Stina Willemoes","Ekloef, Josefin","Klose, Marianne","Holm, Freja S.","Feldt-Rasmussen, Ulla","Rossing, Maria","Jørgensen, Niklas Rye","Marvig, Rasmus L.","Saeed, Mohamad Isam","Wilcke, Torgny","Seersholm, Niels","Mathioudakis, Alexander G.","Vestbo, Jorgen","Jensen, Jens Ulrik Stæhr"],"cuid":["S01-000.00-521816"],"filters":{"added":"2022-09","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of Manchester"],"keyword":["Asthma","BETA","Expression","In vivo","Inhaled corticosteroids","Sensitivity"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"adrenal suppression in patients with chronic obstructive pulmonary disease treated with glucocorticoids role of specific glucocorticoid receptor polymorphisms","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-ND","type":"doi","url":"https://doi.org/10.1371/journal.pone.0262898","version":"Published Version"},"id":"S01-000.00-521816","identifier":[{"id":"85124173370","type":"scopus"},{"id":"35120172","type":"pmid"},{"id":"000789273600015","type":"wos"},{"id":"PMC8815987","type":"pmcid"}],"ids":["ku-d6d989de-e247-495a-be47-59bcebcb05ff"],"keyword":["ASTHMA","BCLI POLYMORPHISM","BETA","EXPRESSION","GENETIC ASSOCIATIONS","IN-VIVO","INHALED CORTICOSTEROIDS","SENSITIVITY"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-A91C1A66CFC051C21321252FB1DA6DA4"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/315852511/journal.pone.0262898.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-ND","type":"doi","url":"https://doi.org/10.1371/journal.pone.0262898","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty o