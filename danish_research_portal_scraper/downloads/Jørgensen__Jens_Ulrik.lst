"rank":38,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Henning","key":"kelbækhenningpau","last":"Kelbæk","name":"Kelbæk, Henning","rank":39,"rolecode":"pau"},{"affno":"1","first":"Lars V.","key":"køberlarspau","last":"Køber","locid":"e3f0c57c-605a-431a-9c63-2213c46621e6","name":"Køber, Lars","name_org":"Køber, Lars V.","rank":40,"rolecode":"pau"}],"pmid":["33632478"],"pub":{"doi":"10.1016/j.jacc.2020.12.037","issn":["07351097","15583597"],"issn_org":["07351097"],"issue":"8","journal":"Journal of the American College of Cardiology","pages":"1044-1052","publisher":"Elsevier","status":"p","title":"Journal of the American College of Cardiology","volume":"77"},"review":"Peer Reviewed","scoID":["2-s2.0-85101040952"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region Zealand","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-f0400315-d16a-485f-a2ed-08ef0613f7e3","sdu-6061b4a7-30ad-408f-a803-5fa4f1c48163"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Prognostic Value of Coronary CT Angiography in Patients With Non–ST-Segment Elevation Acute Coronary Syndromes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-047273","year":"2021","yearsub":"2021"}
{"abstract":"The feedback-loops of the modern architectural design practice are broken, as architects rarely get to experience and learn about life in their buildings in a systematic way. Through novel survey and annotation methods, this project aims to develop tools and methodologies that assist architects in getting insights into the built environment. This paper describes the initial development of a framework for surveying and annotating occupant behaviour within architecture, called \"Behavioural Situations\". Using object recognition on embedded devices, it is possible to build an understanding of occupant behaviour, by coupling behavioural signifiers and their relations as nodes and edges in a graph representation.","author_count":3,"contributors":["Jørgensen, Jens Ulrik","Tamke, Martin","Poulsgaard, Kare Stokholm"],"cuid":["S01-000.00-127263"],"event":{"acronym":"eCAADe","title":"Education and research in Computer Aided Architectural Design in Europe"},"filters":{"added":"2023-01","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Computer vision","Occupant behaviour"],"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-ART","DI-OT"],"level3":{"ART":["DI-ART-ALL","DI-ART-RDKA"],"OT":["3XN Architects"]},"level3all":["DI-ART-RDKA"]},"review":"pr","rtype":["clu"],"sorti":"occupancy informed introducing a method or flexible behavioural mapping in architecture using machine vision","src":["arkc"],"src-code":["DI-ART-RDKA"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://papers.cumincad.org/cgi-bin/works/paper/ecaade2020_367","version":"Published Version"},"id":"S01-000.00-127263","ids":["arkc-7ba21784-850d-4802-af9a-03094374bf62"],"keyword":["Behaviour sensing","Computer-vision","No","Occupant behaviour"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-7DCDFBFD90EE53FA13AA72DD9B4F98E6"],"oa_link":[{"access":"oa","type":"rem","url":"http://papers.cumincad.org/cgi-bin/works/paper/ecaade2020_367","version":"Published Version"},{"access":"oa","type":"rem","url":"http://papers.cumincad.org/data/works/att/ecaade2020_367.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"royal danish academy architecture design conservation","l2":"DI-ART","l2n":"Artistic Higher Education Institutions","l3":"DI-ART-RDKA","l3nn":"Royal Danish Academy - Architecture, Design, Conservation","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Royal Danish Academy - Architecture, Design, Conservation","namevar":["Royal Danish Academy - Architecture, Design, Conservation","Royal Danish Academy - Architecture, Design, Conservation, Royal Danish Academy - Architecture, Institute of Architecture and Technology","Royal Danish Academy - Architecture, Design, Conservation, Royal Danish Academy - Architecture, Institute of Architecture and Technology, CITA - Centre for Information Technology and Architecture","Royal Danish Academy - Architecture, Design, Conservation, Royal Danish Academy - PhD School"],"nora_code":"DI-ART-RDKA","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["3XN Architects"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jens Ulrik","key":"jørgensenpau","last":"Jørgensen","locid":"b9ff6d25-9d86-4621-b5c7-ac3dba0cc077","name":"Jørgensen, Jens Ulrik","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Martin","key":"tamkepau","last":"Tamke","locid":"61f3f409-d89f-46e5-8fa2-7fd49c10cc06","name":"Tamke, Martin","orcid":"0000-0003-1209-4967","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kare Stokholm","key":"poulsgaardpau","last":"Poulsgaard","name":"Poulsgaard, Kare Stokholm","rank":3,"rolecode":"pau"}],"pub":{"pages":"251-258","status":"p","subtitle":"Proceedings of the 38th eCAADe Conference - Volume 2, TU Berlin, Berlin, Germany, 16-18 September 2020,","title":"Anthropologic: Architecture and Fabrication in the cognitive age"},"review":"Peer Reviewed","search":{"DAF":["All Artistic Higher Education Institutions","All Danish Affiliations","All Miscellaneous","Artistic Higher Education Institutions","DI-ALL","DI-ART","DI-ART-ALL","DI-OT","DI-OT-ALL","Miscellaneous","Other Research"],"PST":["Published"]},"sid":["arkc-7ba21784-850d-4802-af9a-03094374bf62"],"src":["Royal Danish Academy - Architecture, Design, Conservation"],"title":"Occupancy-informed : Introducing a method or flexible behavioural mapping in architecture using machine vision","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-127263","year":"2020","yearsub":"2021"}
{"abstract":"BACKGROUND: In patients with non-ST-segment elevation acute coronary syndrome (NSTEACS), coronary pathology may range from structurally normal vessels to severe coronary artery disease. OBJECTIVES: The purpose of this study was to test if coronary computed tomography angiography (CTA) may be used to exclude coronary artery stenosis ≥50% in patients with NSTEACS. METHODS: The VERDICT (Very Early Versus Deferred Invasive Evaluation Using Computerized Tomography in Patients With Acute Coronary Syndromes) trial (NCT02061891) evaluated the outcome of patients with confirmed NSTEACS randomized 1:1 to very early (within 12 h) or standard (48 to 72 h) invasive coronary angiography (ICA). As an observational component of the trial, a clinically blinded coronary CTA was conducted prior to ICA in both groups. The primary endpoint was the ability of coronary CTA to rule out coronary artery stenosis (≥50% stenosis) in the entire population, expressed as the negative predictive value (NPV), using ICA as the reference standard. RESULTS: Coronary CTA was conducted in 1,023 patients-very early, 2.5 h (interquartile range [IQR]: 1.8 to 4.2 h), n = 583; and standard, 59.9 h (IQR: 38.9 to 86.7 h); n = 440 after the diagnosis of NSTEACS was made. A coronary stenosis ≥50% was found by coronary CTA in 68.9% and by ICA in 67.4% of the patients. Per-patient NPV of coronary CTA was 90.9% (95% confidence interval [CI]: 86.8% to 94.1%) and the positive predictive value, sensitivity, and specificity were 87.9% (95% CI: 85.3% to 90.1%), 96.5% (95% CI: 94.9% to 97.8%) and 72.4% (95% CI: 67.2% to 77.1%), respectively. NPV was not influenced by patient characteristics or clinical risk profile and was similar in the very early and the standard strategy group. CONCLUSIONS: Coronary CTA has a high diagnostic accuracy to rule out clinically significant coronary artery disease in patients with NSTEACS.","author_count":40,"contributors":["Linde, Jesper J","Kelbæk, Henning","Hansen, Thomas Fritz","Sigvardsen, Per E","Torp-Pedersen, Christian Tobias","Bech, Jan","Heitmann, Merete","Nielsen, Olav Wendelboe","Høfsten, Dan E.","Kühl, Jørgen T","Raymond, Ilan E","Kristiansen, Ole P","Svendsen, Ida H","Vall-Lamora, Maria H D","Kragelund, Charlotte","de Knegt, Martina","Hove, Jens Dahlgaard","Jørgensen, Tem","Fornitz, Gitte Gleerup","Steffensen, Rolf","Jurlander, Birgit","Abdulla, Jawdat","Lyngbæk, Stig","Elming, Hanne","Therkelsen, Susette Krohn","Jørgensen, Erik","Kløvgaard, Lene","Bang, Lia Evi","Hansen, Peter Riis","Helqvist, Steffen","Galatius, Søren","Pedersen, Frants","Abildgaard, Ulrik","Clemmensen, Peter","Saunamäki, Kari","Holmvang, Lene","Engstrøm, Thomas","Gislason, Gunnar","Køber, Lars","Kofoed, Klaus Fuglsang"],"cuid":["S01-000.00-441180"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Acute Coronary Syndrome diagnostic imaging","Aged","Computed Tomography Angiography","Coronary Angiography","Coronary Stenosis diagnostic imaging","Female","Humans","Male","Middle Aged","Predictive Value of Tests","Prospective Studies"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"coronary ct angiography in patients with non st segment elevation acute coronary syndrome","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Andet","type":"doi","url":"https://doi.org/10.1016/j.jacc.2019.12.012","version":"Published Version"},"id":"S01-000.00-441180","identifier":[{"id":"85078263838","type":"scopus"},{"id":"32029126","type":"pmid"}],"ids":["ku-4ff1457b-9469-47a8-860d-9e9e407bb061"],"keyword":["Acute Coronary Syndrome/diagnostic imaging","Aged","Computed Tomography Angiography","Coronary Angiography","Coronary Stenosis/diagnostic imaging","Female","Humans","Male","Middle Aged","Predictive Value of Tests","Prospective Studies"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-8C736280345297DBBF686A023FC4B3F4"],"oa_link":[{"access":"oa","license":"Andet","type":"doi","url":"https://doi.org/10.1016/j.jacc.2019.12.012","version":"Published Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal medicine: Cardiology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Jesper J","key":"lindejesperjpau","last":"Linde","name":"Linde, Jesper J","rank":1,"rolecode":"pau"},{"affno":"","first":"Henning","key":"kelbækhenningpau","last":"Kelbæk","name":"Kelbæk, Henning","rank":2,"rolecode":"pau"},{"affno":"","first":"Thomas Fritz","key":"hansenthomasfritzpau","last":"Hansen","name":"Hansen, Thomas Fritz","rank":3,"rolecode":"pau"},{"affno":"","first":"Per E","key":"sigvardsenperepau","last":"Sigvardsen","name":"Sigvardsen, Per E","rank":4,"rolecode":"pau"},{"affno":"1","first":"Christian Tobias","key":"torppedersenchristiantobiaspau","last":"Torp-Pedersen","name":"