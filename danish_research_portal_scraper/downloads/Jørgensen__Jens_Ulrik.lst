ck","key":"johansenpau","last":"Johansen","locid":"e57328b2-dec3-44f9-803f-e9579340a1f5","name":"Johansen, Jens Brock","orcid":"0000-0001-7157-7948","rank":11,"rolecode":"pau"}],"pmid":["35124230"],"pub":{"doi":"10.1016/j.hrthm.2022.01.039","issn":["15475271","15563871"],"issn_org":["15475271"],"issue":"6","journal":"Heart Rhythm","pages":"901-908","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"p","title":"Heart Rhythm","volume":"19"},"review":"Peer Reviewed","scoID":["2-s2.0-85125932103"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Miscellaneous","All Universities","Central Denmark Region","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Miscellaneous","North Denmark Region","Other Research","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-13f49424-1c05-428b-be77-ad3d4e5da468","sdu-011613c1-e930-41f7-b63b-460d982f1103"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Microbiological Diagnosis in Cardiac Implantable Electronic Device Infections Detected by Sonication and Next-Generation Sequencing","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-098.86-014039","year":"2022","yearsub":"2022"}
{"abstract":"The effects of dexamethasone (DXM) treatment on pulmonary immunity in COVID-19 associated acute respiratory distress syndrome (CARDS) remain insufficiently understood. We performed transcriptomic RNA-seq analysis of bronchoalveolar lavage fluid from 20 mechanically ventilated patients: 12 with CARDS (DXM+ or DXM-) and 8 non-COVID-19 critically ill controls. CARDS (+DXM) was characterized by upregulation of genes related to B-cell and complement pathway activation, antigen presentation, phagocytosis and FC-gamma receptor signalling. Most ISGs were upregulated in CARDS, particularly in CARDS (-DXM). In conclusion, DXM treatment was not associated with regulation of pro-inflammatory pathways in CARDS but with regulation of other local immune responses.","author_count":9,"contributors":["Fahnøe, Ulrik","Ronit, Andreas","Berg, Ronan M.G.","Jørgensen, Sofie E","Mogensen, Trine H","Underwood, Alexander P.","Scheel, Troels K H","Bukh, Jens","Plovsing, Ronni R"],"cuid":["S01-000.00-471079"],"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"a distinct dexamethasone dependent gene expression profile in the lungs of covid 000000000019 patients","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"https://www.ncbi.nlm.nih.gov/pmc/about/copyright/","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC9213855/pdf/jiac218.pdf","version":"Published Version"},"id":"S01-000.00-471079","identifier":[{"id":"35639922","type":"pmid"},{"id":"PMC9213855","type":"pmcid"},{"id":"85138626207","type":"scopus"}],"ids":["ku-81ba7e3a-613d-41a0-8f0d-19e1b0c18e30"],"lang":"English",