ank":35,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Nicolai","key":"haasenicolaipau","last":"Haase","name":"Haase, Nicolai","rank":36,"rolecode":"pau"}],"pmid":["37288935"],"pub":{"doi":"10.1111/aas.14290","issn":["00015172"],"issue":"9","journal":"Acta Anaesthesiologica Scandinavica","pages":"1239-1248","publisher":"Blackwell Munksgaard","status":"p","title":"Acta Anaesthesiologica Scandinavica","volume":"67"},"review":"Peer Reviewed","scoID":["2-s2.0-85161547094"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","North Denmark Region","Other Research","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-dc1aa9f2-6f50-4853-83ad-28bb1d1c9220","au-7d1ff590-4fb4-45a0-9d19-615bdb53efcd","ku-4e400344-3f4a-4a48-a016-1486b7f1e790","sdu-4aef73d2-4d94-41fb-87da-3b3d33084801"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Long-term outcomes in COVID-19 patients admitted to intensive care in Denmark : A nationwide observational study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-096.25-715795","year":"2023","yearsub":"2023"}
{"abstract":"Background To compare the intrinsic virulence of the severe acute respiratory syndrome coronavirus 2 (SARS-CoV-2) omicron variant with the delta variant in hospitalized adults with coronavirus disease 2019 (COVID-19). Methods All adults hospitalized in the Capital Region of Copenhagen with a positive reverse transcription polymerase chain reaction test for SARS-CoV-2 and an available variant determination from 1 September 2021 to 11 February 2022. Data from health registries and patient files were used. Omicron and Delta patients were matched (1:1) by age, sex, comorbidities, and vaccination status. We calculated crude and adjusted hazard ratios (aHRs) for severe hypoxemia and mortality at 30 and 60 days. Results 1,043 patients were included. Patients with Omicron were older, had more comorbidities, were frailer, and more often had three vaccine doses than those with Delta. Fewer patients with Omicron developed severe hypoxemia than those with Delta (aHR, 0.55; 95% confidence interval, 0.38 0.78). Omicron patients exhibited decreased aHR for 30- day mortality compared to Delta (aHR, 0.61; 0.39 0.95). Omicron patients who had received three vaccine doses had lower mortality compared to Delta patients who received three doses (aHR, 0.31;0.16 0.59), but not among those who received two or 0 1 doses (aHR, 0.86; 0.41 1.84 and 0.94; 0.49 1.81 respectively). Similar findings were observed for mortality at 60 days. Similar outcomes were obtained in the analyses of 316 individually matched patients. Conclusions Among adults hospitalized with COVID-19, those with Omicron had less severe hypoxemia and nearly 40% higher 30- and 60-day survival, as compared with those with Delta, mainly driven by a larger proportion of Omicron patients vaccinated with three doses of an mRNA vaccine.","author_count":75,"contributors":["Harboe, Zitta Barrella","Roed, Casper","Holler, Jon Gitz","Khan, Fahim Iqbal","Abdulrahman, Aya Nihad Abdulrahman","Mulverstedt, Stefan Lundby","Lindgaard-Jensen, Betina","Bertelsen, Barbara Bonnesen","Søborg, Christian","Nielsen, Thyge Lynghøj","Hansen, Line Vinum","Lindegaard, Birgitte","Browatzki, Andrea","Eiberg, Mads","Bernhard, Peter Haahr","Pedersen, Emilie Marie Juelstorp","Egelund, Gertrud Baunbaek","Dungu, Arnold Matovu","Sejdic, Adin","Mathiesen, Inger Hee Mabuza","Jespersen, Naja Z.","Petersen, Pelle Trier","Nielsen, Lars","Jepsen, Micha Phill Grønholm","Pedersen, Thomas Ingemann","Eriksson, Robert","Seitz-Rasmussen, Hans Eric Sebastian","Bestle, Morten H.","Andersen, Henrik","Skram, Ulrik","Skøtt, Mads Rømer","Altaraihi, Sarah","Sivapalan, Pradeesh","Jensen, Jens Ulrik Stæhr","Bagge, Kristian","Jørgensen, Kristina Melbardis","Knudsen, Maja Johanne Søndergaard","Leineweber, Thomas","Schneider, Uffe Vest","Ahlstrom, Magnus Glindvad","Rytter, Sofie","Le Dous, Nina","Ravn, Pernille","Reiter, Nanna","Podlekareva, Daria","Knudsen, Andreas","Johnsen, Stine","Kristensen, Lars Erik","Leding, Cæcilie","Hertz, Bastian Bryan","Benfield, Thomas","Kirk, Ole","Holler, Jon Gitz","Ostrowski, Sisse Rye","Sigurdsson, Sigurdur Thor","Perner, Anders","Kirkby, Nikolai","Pedersen, Martin Schou","Van Wijhe, Maarten","Simonsen, Lone","Bager, Peter Michael","Krause, Tyra Grove","Voldstedlund, Marianne","Christiansen, Lasse Engbo","Stegger, Marc","Cohen, Arieh","Fonager, Jannik","Fomsgaard, Anders","Legarth, Rebecca","Rasmussen, Morten","Gubbels, Sophie","Wohlfahrt, Jan","Lillebaek, Troels","Johannesen, Caroline Klint","Van Wijhe, Maarten","Fischer, Thea K."],"cuid":["S02-086.58-742420"],"filters":{"added":"2023-08","altsrc":["Global Data"],"author_count":"51-200 contributors","class":"merged","cluster_size":2,"corpau":["COVID-19 Omicron Delta study group"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU","DI-U-RUC"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-U-KU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"clinical progression disease severity and mortality among adults hospitalized with covid 000000000019 caused by the omicron and delta sars cov 000000000002 variants a population based matched cohort study","src":["ku","ruc"],"src-code":["DI-U-KU","DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pone.0282806","version":"Published Version"},"id":"S02-086.58-742420","identifier":[{"id":"PMC10138229","type":"pmcid"},{"id":"37104488","type":"pmid"},{"id":"85158948700","type":"scopus"}],"ids":["ku-f15c5a11-3719-4dc4-9e54-6e1892aab635","ruc-a8ced22d-908a-46c8-adff-f814792d3054"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-4-FCD31B13C89B559BFBD6ABDEA9FD949C"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/359238893/journal.pone.0282806_1_.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pone.0282806","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/97415831/journal.pone.0282806.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of Science and Environment"],"nora_code":"DI-U-RUC","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital – North Zeala