{"abstract":"This STS Encounters special issue is a collection of articles that has been developed from conference papers presented at the bi-yearly Danish Association for Science and Technology studies (DASTS) conference in 2022. The conference was held at the Department of Digital Design and Information studies, Aarhus University and hosted by the STS center at Aarhus University on June 2-3. 2022. The theme of the conference was: 'Living with Ruptures: Repair, Maintenance, and (Re)Construction'.","author_count":4,"contributors":["Danholt, Peter","Kirkegaard, Julia Kirch","Ostrowski, Kasper","Papazu, Irina"],"cuid":["S03-083.97-813696"],"filters":{"added":"2023-11","altsrc":["No Matches Found"],"author_count":"2-5 contributors","class":"merged","cluster_size":3,"level":"sci","mra":["hum","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-DTU","DI-U-ITU"]},"level3all":["DI-U-AU","DI-U-DTU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"introduction dasts 000000002022 special issue","src":["au","dtu","itu"],"src-code":["DI-U-AU","DI-U-DTU","DI-U-ITU"],"type":"dje","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-SA","type":"doi","url":"https://doi.org/10.7146/stse.v15i2.140170","version":"Published Version"},"id":"S03-083.97-813696","ids":["au-76169626-05f1-42c8-a83b-fafce4f9ac47","dtu-c8d57a76-ed66-45be-beaa-8b9f236d8a47","itu-d746aa30-c4c3-46c0-bc8e-7300ada4ca9a"],"lang":"English","level":"Scientific","mra":["Humanities","Science/Technology"],"noi":["Global-Local-2-4-A95F6CC0D4D1982BF4FF1CC2122D625B"],"oa_link":[{"access":"oa","license":"CC BY-NC-SA","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/347747582/15_2_Special_Issue_Editorial_6.pdf","version":"Published Version"},{"access":"oa","type":"rem","url":"https://tidsskrift.dk/encounters/article/view/140170/184148","version":"Other Version"},{"access":"oa","license":"CC BY-NC-SA","type":"doi","url":"https://doi.org/10.7146/stse.v15i2.140170","version":"Published Version"},{"access":"oa","type":"rem","url":"https://tidsskrift.dk/encounters/article/download/140170/184148/304529","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, School of Communication and Culture, School of Communication and Culture - Department of Digital Design and Information Studies"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Center for Climate IT","IT University of Copenhagen, Center for Digital Welfare","IT University of Copenhagen, Technologies in Practice, Technologies in Practice"],"nora_code":"DI-U-ITU","used":1},{"affno":"3","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Wind and Energy Systems","Technical University of Denmark, Department of Wind and Energy Systems, Wind Energy Systems Division","Technical University of Denmark, Department of Wind and Energy Systems, Wind Energy Systems Division, Society, Market and Policy"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Peter","key":"danholtpau","last":"Danholt","locid":"eea95706-fae9-4f57-a925-428067bf259d","name":"Danholt, Peter","orcid":"0000-0002-4330-1239","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Irina","key":"papazupau","last":"Papazu","locid":"6ec63914-1f4e-4708-8830-1b054c2ee03a","name":"Papazu, Irina","orcid":"0000-0002-4178-3676","rank":1,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Julia","key":"kirchkirkegaardpau","last":"Kirch Kirkegaard","locid":"ec1397f0-2533-4cdd-8999-baa910fcc4e0","name":"Kirkegaard, Julia Kirch","name_org":"Kirch Kirkegaard, Julia","orcid":"0000-0001-9340-7202","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kasper","key":"ostrowskipau","last":"Ostrowski","locid":"b95333df-ff75-4a64-8234-219206080cfa","name":"Ostrowski, Kasper","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.7146/stse.v15i2.140170","issn":["19044372"],"issue":"2","journal":"STS Encounters","status":"p","title":"STS Encounters","title_org":"STS Encounters - DASTS working paper series","volume":"15"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["au-76169626-05f1-42c8-a83b-fafce4f9ac47","dtu-c8d57a76-ed66-45be-beaa-8b9f236d8a47","itu-d746aa30-c4c3-46c0-bc8e-7300ada4ca9a"],"src":["AU Aarhus University","DTU Technical University of Denmark","ITU IT University of Copenhagen"],"title":"Introduction DASTS 2022 special issue","type":"Editorial","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-083.97-813696","year":"2023","yearsub":"2023"}
{"author_count":3,"contributors":["Birkbak, Andreas"],"cuid":["S01-000.00-058967"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"use yourself kick yourself learning from a newspaper how not to do good public debate","src":["aau"],"src-code":["DI-U-AAU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-SA 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/470612222/2022_Use_yourself_Kick_yourself.pdf","version":"Published Version"},"id":"S01-000.00-058967","ids":["aau-1e927c50-124f-4ccb-b957-cd9d66a15c2c"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-ADBF353EFEA77F07B3B3BAB302B0C8C3"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.matteringpress.org/books/democratic-situations/read/4-o-use-yourself-kick-yourself-learning-from-a-newspaper-how-not-to-do-good-public-debate","version":"Published Version"},{"access":"oa","license":"CC BY-NC-SA 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/470612222/2022_Use_yourself_Kick_yourself.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Social Sciences and Humanities","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Culture and Learning","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Culture and Learning, The Techno-Anthropology Lab"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Andreas","key":"birkbakpau","last":"Birkbak","locid":"269bb408-d628-47f8-8539-d0c4b97a9aad","name":"Birkbak, Andreas","orcid":"0000-0001-9283-1677","rank":1,"rolecode":"pau"},{"affno":"","first":"Andreas","key":"birkbakpedh","last":"Birkbak","name":"Birkbak, Andreas","rank":2,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Irina","key":"papazupedh","last":"Papazu","name":"Papazu, Irina","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"eisbn":["9781912729319 (html)","9781912729128 (pdf)","9781912729135 (epub)"],"isbn":["9781912729302 (pbk)"],"pages":"80-100","place":"Manchester, UK","publisher":"Mattering Press","status":"p","title":"Democratic Situations"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-1e927c50-124f-4ccb-b957-cd9d66a15c2c"],"src":["AAU Aalborg University"],"title":"Use yourself, kick yourself! Learning from a newspaper how (not) to do good public debate","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-058967","year":"2022","yearsub":"2022"}
{"abstract":"This study sets out to understand the governance consequences of the ’agile transformation’ of the Danish state. The agile transformation builds on a set of values and routines from software engineering that advocates for change in the project management of digital public service provision. An ‘agile’ public sector promises to deliver not just more thoroughly digitalized public services, but also better digitalization by enhancing the speed, flexibility and innovative capabilities of IT project management in the public sector agencies tasked with building new IT systems. However, such an agile transformation is not easily accomplished, and its implications for the welfare state remain unclear. In this chapter, we problematize the Danish state’s attempted agile transformation from four perspectives: governance, sourcing, citizenship, and legacy and maintenance. From a governance perspective, the high velocity of day-to-day decisions built into the agile framework can lead to a decoupling between decision-making and accountability in public service delivery. But when agile approaches replace bureaucratic procedures originally put in place to ensure the accountability and legality of governmental operations, what are the consequences? Further, as the distribution of knowledge between the state and private consultancies has become increasingly interlaced through agile-based public-private collaborations, the state has attempted a shift from outsourcing to insourcing (‘hjemtagning’) of IT development. At the same time, the state’s collaboration with private actors has perhaps never been more intense, and it remains unclear how the much-needed IT expertise of the private sector interplays with the state’s growing ambitions of building new systems in-house. As regards citizenship and citizens’ trust in the state, the trial-and-error-based agile approach to service delivery may put a strain on the relationship between citizens and the welfare state by introducing “unfinished” minimal viable products (MVP) in the place of the fully operational IT systems citizens have learned to expect. Moreover, agile-based public services are often built upon an established base of legacy technology, which also impacts agile temporalities. Maintenance of pre-agile components cannot be easily contained in a sprint-based formula. And what happens after agile-based public services go beyond beta, or even face retirement? Does the responsibility for forming the strategy for the entire life-span of a product lie with the state or the vendor, and how can this responsibility be shared?","author_count":4,"contributors":["Papazu, Irina","Wang, Cancan","Perriam, Jessamy","Marttila, Sanna-Maria"],"cuid":["S01-000.00-382477"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Agile transformation","Citizenship Trust","Governance of IT","Legacy Systems Maintenance","Public private collaboration"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"nr","rtype":["clu"],"sorti":"outsourcing response ability the agile transformation of the danish public sector","src":["itu"],"src-code":["DI-U-ITU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-382477","ids":["itu-50c37dad-469b-472d-9502-743b84168544"],"keyword":["Agile Transformation","Citizenship Trust","Governance of IT","Legacy Systems Maintenance","Public-Private Collaboration"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-9DC78AFE17C082427B34F702ADA7329A"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Center for Digital Welfare","IT University of Copenhagen, Technologies in Practice, Technologies in Practice"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Irina","key":"papazupau","last":"Papazu","locid":"6ec63914-1f4e-4708-8830-1b054c2ee03a","name":"Papazu, Irina","orcid":"0000-0002-4178-3676","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Cancan","key":"wangpau","last":"Wang","locid":"605b59ab-91b4-4f8e-bb12-df68ce0491c5","name":"Wang, Cancan","orcid":"0000-0002-9065-6884","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jessamy","key":"perriampau","last":"Perriam","locid":"4ca57c3b-1d1f-4ecf-87b0-fe690510c887","name":"Perriam, Jessamy","orcid":"0000-0002-6362-8634","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sanna-Maria","key":"marttilapau","last":"Marttila","locid":"528393a3-e784-47a8-85be-c81d44c393bd","name":"Marttila, Sanna-Maria","orcid":"0000-0003-3793-5021","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-50c37dad-469b-472d-9502-743b84168544"],"src":["ITU IT University of Copenhagen"],"title":"Outsourcing response-ability : The agile transformation of the Danish public sector","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382477","year":"2022","yearsub":"2022"}
{"author_count":3,"contributors":["Papazu, Irina","Birkbak, Andreas","Blok, Anders"],"cuid":["S01-000.00-382618"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"democratic situations event s report an intervention by anders blok","src":["itu"],"src-code":["DI-U-ITU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://www.easst.net/article/democratic-situations-events-report-an-intervention-by-anders-blok/","version":"Published Version"},"id":"S01-000.00-382618","ids":["itu-5af46b63-e575-44b3-b9a8-9fbef2bac442"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-CFE1444AEF243335D56FB178DBA3CC0F"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.easst.net/article/democratic-situations-events-report-an-intervention-by-anders-blok/","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Center for Digital Welfare","IT University of Copenhagen, Technologies in Practice, Technologies in Practice"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Irina","key":"papazupau","last":"Papazu","locid":"6ec63914-1f4e-4708-8830-1b054c2ee03a","name":"Papazu, Irina","orcid":"0000-0002-4178-3676","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Andreas","key":"birkbakpau","last":"Birkbak","name":"Birkbak, Andreas","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Anders","key":"blokpau","last":"Blok","name":"Blok, Anders","rank":3,"rolecode":"pau"}],"pub":{"place":"EASST Review","publisher":"EASST","status":"p","volume":"42"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["itu-5af46b63-e575-44b3-b9a8-9fbef2bac442"],"src":["ITU IT University of Copenhagen"],"title":"Democratic Situations event(s) report: An intervention by Anders Blok","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382618","year":"2022","yearsub":"2022"}
{"abstract":"The general electoral campaign in 2019 saw a unifying culmination of the climate activist movement in Denmark, assembling everything from green think tanks, school children and direct-action protest groups, succeeded in conglomerating a forceful public that was later congratulated by the newly elected PM for turning climate into the paramount political issue of the Danish 2019 election. The government has since signed the “most ambitious Climate Act in the world”, including the public engagement initiative of the Climate Citizen Assembly, a group of randomly selected citizens mandated to give recommendations for the parliament’s green politics, and a series of “Climate Partnerships”, cooperative collaborations developing frameworks for businesses to engage in the green transition. Despite these efforts, the climate movement, alongside several scientific experts, has expressed dissatisfaction with the government’s politics on the green agenda, while the government itself maintains that it is upholding an ambitious climate politics. This paper is based on nine months of mixed-methods research, using the digital tools Hyphe, Gephi and CorText to map the relations between different public Danish actors (informal civil society groups, NGO’s, businesses etc.) and their “matters of concern” (cf. Latour 2004) in the controversy of the Danish green transition. Inspired by literature on counter-mapping data science (Dalton and Stallmann 2018), the study introduces an interventionist methodological experiment in using network maps made with digital methods tools as props for material participation (Marres & Lezeaun 2011) in a workshop setting. As such, the paper seeks to explore how critical discussions of network maps can become a ‘prototype for mobilization’ (cf. Jimenéz 2014) for mapped subjects and entities to collectively evaluate and re-invent both their position in a controversy and their means, methods, and tactics for obtaining public impact. This methodological experiment is framed through a discussion of the experience of participation (Kelty 2018) and ethical attunement and world-building among activists (Zigon 2018), and argues for the potentials for collaborative methods and interventionist use of digital cartography in the field of controversy mapping in relation to the green transition.","author_count":2,"contributors":["Papazu, Irina","Veng, Adam"],"cuid":["S01-000.00-384232"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Citizen engagement","Climate Activism","Danish Green Transition","Digital Methods","Network Mapping"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"nr","rtype":["clu"],"sorti":"controversy mapping and the care for climate commons re assembling the danish climate movement by counter mapping digital network maps","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-384232","ids":["itu-ca473937-65f4-4e42-8da7-ca39cec7fb81"],"keyword":["Citizen Engagement","Climate Activism","Danish Green Transition","Digital Methods","Network Mapping"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-1722F57114DBD83EE49D421E546A0D52"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Center for Climate IT","IT University of Copenhagen, Center for Digital Welfare","IT University of Copenhagen, Technologies in Practice, Technologies in Practice"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Irina","key":"papazupau","last":"Papazu","locid":"6ec63914-1f4e-4708-8830-1b054c2ee03a","name":"Papazu, Irina","orcid":"0000-0002-4178-3676","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Adam","key":"vengpau","last":"Veng","name":"Veng, Adam","rank":2,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-ca473937-65f4-4e42-8da7-ca39cec7fb81"],"src":["ITU IT University of Copenhagen"],"title":"Controversy Mapping and the Care for Climate Commons : Re-assembling the Danish Climate Movement by Counter-Mapping Digital Network Maps","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384232","year":"2022","yearsub":"2022"}
{"abstract":"The ‘digital citizen’ is a central figure in policy developments and contemporary digitalization efforts in Denmark. Critical discourse analyses of policy reports and strategies have shown the underlying assumptions and expectations of the Danish citizen as being digital ‘by default’, and have illustrated how the citizen has been cast as a neoliberal subject, self-sufficient and capable of navigating the digital universe of the public sector. However, in a report on digital inclusion published by KL and the Agency for Digitisation in April last year, less capable figures of the citizen appear, as the report states that a large proportion of the Danish population will in fact always be ‘digitally marginalized’. This report, we argue, disrupts the dominant imaginaries of frictionless public digitalization, and creates new conditions of possibility for public governance, making digital inclusion a central concern for the state. In this paper, we consider the implications of this report in terms of the spaces of action it opens for a small unit within the Agency for Digitisation: The Inclusion Office. In a departure from the critical, mostly discourse study-based literature on public sector digitalization and its political implications, we seek to acknowledge and understand the efforts made by actors within the state to re-invent their politics vis-à-vis the digitally marginalized citizens. Based on interviews and participant-observation at three conferences where the Office figured centrally, we describe the forms of politics (Gomart & Hajer 2003) practiced by the employees and managers of the Office in relation to digital inclusion. By identifying three such forms of politics – understanding the non-digital citizen, networking with the citizen organizations, and acting on concrete requests from the citizens – we ask how digital inclusion efforts shape public governance in the enactment of the digital state: what form(s) of politics are practiced? Are such practices good? And what capacities to act are distributed and how? In pursuing these questions, we engage in a more generative form of critique, suspending judgement about how the digital ought to be entangled with citizenship and public governance and, instead, we attempt to trace how institutional actors represent and shape the digital state in practice. Keywords: Citizens’ mediated identities and agencies; digital citizenship; digital democracy; democratic institutions; ethnography","author_count":3,"contributors":["Papazu, Irina","Simonsen, Thorben","Tatjana Reime, Lara"],"cuid":["S01-000.00-383485"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Digital Citizenship","Digital Inclusion","Neoliberal subjectivity","Public Sector Digitalization","Public governance"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"the inclusion office how the danish digital state knows listens to and acts on its citizens problems","src":["itu"],"src-code":["DI-U-ITU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-383485","ids":["itu-973aa5ea-3125-4de6-bd0a-c12402f55d4e"],"keyword":["Digital Citizenship","Digital Inclusion","Neoliberal Subjectivity","Public Governance","Public Sector Digitalization"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-5E19E831D665AB9DD9E09BCEC5DE9D46"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Center for Digital Welfare","IT University of Copenhagen, Technologies in Practice, Technologies in Practice"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Irina","key":"papazupau","last":"Papazu","locid":"6ec63914-1f4e-4708-8830-1b054c2ee03a","name":"Papazu, Irina","orcid":"0000-0002-4178-3676","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thorben","key":"simonsenpau","last":"Simonsen","name":"Simonsen, Thorben","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lara","key":"tatjanareimepau","last":"Tatjana Reime","locid":"0baaf9f8-3126-4cb1-b22f-b9fceabb8b54","name":"Tatjana Reime, Lara","orcid":"0000-0002-7475-2147","rank":3,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-973aa5ea-3125-4de6-bd0a-c12402f55d4e"],"src":["ITU IT University of Copenhagen"],"title":"The inclusion office : How the Danish digital state knows, listens to, and acts on its citizens’ problems","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383485","year":"2022","yearsub":"2022"}
{"abstract":"Democratic Situations challenges researchers and students in Science & Technology Studies and related fields to treat democracy as an empirical phenomenon. This means leaving behind off-the-shelf theoretical notions of democracy that may have travelled into STS unexamined. The alternative strategy pursued in this volume is to pay as much analytical attention to the study of democratic politics as STS has previously offered to familiar topics of science and technology. This timely collection of empirical stories and conceptual inventions leads the way by showing how the making and doing of democracy can be placed at the centre of relational research. The book turns the well-known sites of contemporary Euro-American participatory democracy, such as elections, bureaucracies, public debate and citizen participation, into fluctuating democratic situations where supposedly untouchable democratic ideals are shaped, contested and warped in practice. The fact that Euro-American participatory democracy is often upheld as an ideal for the rest of the world makes it all the more important to study how it is a situated, distributed, material, emergent, heterogenous, fragile and at times faltering figure and project. Through situated analyses, the authors demonstrate that democracy cannot be reduced to theoretical ideals and schemes of conflict, institutions, or deliberation. Instead, the volume offers an urgently needed empirically driven renewal of our understanding of democratic politics in a time when conventional ideas increasingly fail to capture current events such as Brexit, Trump and Covid19. The twelve chapters are organised into three sections. The first part, entitled Interfaces of technodemocracy, focuses on how democratic politics is co-shaped by its interfaces with more or less rigid institutions and bureaucracies. The second section, Technosciences, democracy and situated enactments of participation, emphasises the relationships between science and public participation. The third part called Reconfigurations of democratic politics with new nonhuman actors focuses on the role of material objects, especially new digital technologies, in democratic politics.","author_count":2,"contributors":["Birkbak, Andreas","Papazu, Irina Maria Clara Hansen"],"cuid":["S02-100.00-000925"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["hum","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-AAU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"democratic situations","src":["aau","itu"],"src-code":["DI-U-AAU","DI-U-ITU"],"type":"db","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-SA 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/470611959/2022_Democratic_Situations.pdf","version":"Published Version"},"id":"S02-100.00-000925","ids":["aau-11b8ab8c-d173-415d-9876-57f03a31db7b","itu-1b91d044-7f3b-477f-9ff6-47cc31d916ec"],"lang":"English","level":"Scientific","mra":["Humanities","Science/Technology"],"noi":["Local-1-2-C2E72FBBB09A14900AAC453CC19A5DA1"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.matteringpress.org/books/democratic-situations","version":"Published Version"},{"access":"oa","type":"rem","url":"https://www.matteringpress.org/wp-content/uploads/2022/05/Democratic-Situations-ePDF-v1-2.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-SA 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/470611959/2022_Democratic_Situations.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Social Sciences and Humanities","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Culture and Learning","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Culture and Learning, The Techno-Anthropology Lab"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Technologies in Practice, Technologies in Practice"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Andreas","key":"birkbakped","last":"Birkbak","locid":"269bb408-d628-47f8-8539-d0c4b97a9aad","name":"Birkbak, Andreas","orcid":"0000-0001-9283-1677","rank":1,"role":"Editor","rolecode":"ped"},{"affno":"2","corresponding":null,"first":"Irina","key":"papazupau","last":"Papazu","locid":"6ec63914-1f4e-4708-8830-1b054c2ee03a","name":"Papazu, Irina","orcid":"0000-0002-4178-3676","rank":1,"rolecode":"pau"}],"pub":{"eisbn":["9781912729319 (html)","9781912729128 (pdf)","9781912729135 (epub)"],"isbn":["9781912729302 (pbk)"],"pages":"274","place":"Manchester, UK","publisher":"Mattering Press","status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["aau-11b8ab8c-d173-415d-9876-57f03a31db7b","itu-1b91d044-7f3b-477f-9ff6-47cc31d916ec"],"src":["AAU Aalborg University","ITU IT University of Copenhagen"],"title":"Democratic Situations","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-000925","year":"2022","yearsub":"2022"}
