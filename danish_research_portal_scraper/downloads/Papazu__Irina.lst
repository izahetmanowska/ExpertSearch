6","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Thorben","key":"simonsenpau","last":"Simonsen","name":"Simonsen, Thorben","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lara","key":"reimepau","last":"Reime","locid":"0baaf9f8-3126-4cb1-b22f-b9fceabb8b54","name":"Tatjana Reime, Lara","name_org":"Reime, Lara","orcid":"0000-0002-7475-2147","rank":3,"rolecode":"pau"},{"affno":"","first":"Jessamy","key":"perriampedh","last":"Perriam","name":"Perriam, Jessamy","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Katrine","key":"meldgaardkjærpedh","last":"Meldgaard Kjær","name":"Meldgaard Kjær, Katrine","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1515/9783110787641","eisbn":["9783110787641"],"isbn":["9783110787603"],"pages":"75-93","publisher":"De Gruyter","status":"p","subtitle":"Intersections, Implications and Interventions","title":"Digitalization in Practice"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-21c45f0c-dfc1-40f3-8443-c1b7d4c34d64"],"src":["ITU IT University of Copenhagen"],"title":"The digital state overflowing its boundaries : Considering the case of digital inclusion in Denmark","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-776378","year":"2024","yearsub":"2024"}
{"abstract":"Danmark anses for at være en af de mest digitaliserede velfærdsstater i verden (OECD 2023) med en omfattende offentlig digital infrastruktur, der ideelt set sikrer borgerne gnidningsløs interaktion med de offentlige myndigheder. Talrige statslige og fællesoffentlige digitaliseringsstrategier har flyttet mødet mellem borgere og myndigheder til digitale kontaktflader, der skal gøre kommunikationen lettere og mere tilgængelig og brugervenlig (f.eks. Regeringen, KL, Danske Regioner 2022, 2016). I takt med at det fysiske møde mellem borger og stat er blevet erstattet af digital kontakt, forventes borgerne at anskaffe den teknologi, som kan understøtte kontakten. Der ligger heri en implicit magtanvendelse fra myndighedernes side, da borgerne forventes at sørge for, at det tekniske udstyr, der muliggør digital selvbetjening, findes i hjemmet.","author_count":4,"contributors":["Papazu, Irina","Pors, Anja","Skaarup, Søren","Winthereik, Brit Ross"],"cuid":["S01-000.00-747139"],"filters":{"added":"2024-08","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U","DI-UC"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-ITU"],"UC":["DI-UC-ALL","DI-UC-KP"]},"level3all":["DI-U-DTU","DI-U-ITU","DI-UC-KP"]},"review":"nr","rtype":["clu"],"sorti":"digitalt hjælpearbejde fordringer og udfordringer i borgernes adgang til velfærd magtudredningen 000000000002 000000000000","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/361546027/Essay_af_Papazu_et_al..pdf","version":"Published Version"},"id":"S01-000.00-747139","ids":["dtu-eb16e6d5-ef3a-43a6-86c5-6689c453a8e0"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-81384A8B88E6BA975B36E0CFB4346C0B"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.or