rina","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"eisbn":["http://doi.org/10.28938/9781912729302"],"isbn":["9781912729302"],"pages":"186-207","publisher":"Mattering Press","status":"p","title":"Democratic Situations"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-4a08716c-d885-48ce-92bc-afe7886fb092"],"src":["ITU IT University of Copenhagen"],"title":"The dark side of care? Wayward participants in Samsø's renewable energy transition","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382371","year":"2022","yearsub":"2022"}
{"abstract":"In recent years, there has been a growing interest in data-informing welfare work in the public sector. While data has been used as management information for decades, the focus is now on that data must be used to support and develop the level of operations close to citizens, and that managers must exercise professional leadership with data as a focal point. On a practical level, however, the ambitions appear quite unconcrete, and despite ambitions to inform the welfare task with data, it remains unclear how data can support the professional task solution. The purpose of the article is to investigate how professionals use data in practice, and what types of data professionals demand in the meeting with the citizen. For this purpose, we examine the work with diabetes rehabilitation in a municipal health center. The case is based on interviews with managers and employees about the use and perceptions of data in contact with diabetes patients. We find in the analysis that the work with diabetes rehabilitation is based on a close relationship with the citizen, where data on results and effects are not immediately supportive of the task solution. On the other hand, employees find other ways to collect and process data to support the work at the civic level of operations. The case study contributes to concretizing the current discussion about data-informed management with insights from the work with data at the citizen-related operating level.","author_count":4,"contributors":["Borch Rasmussen, Niels","Jagd Hermansen, Jonathan","Papazu, Irina","Rasmussen, Kasper Friis"],"cuid":["S01-000.00-382914"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Data informed management","Diabetes rehabilitation","Municipal health services","Professional leadership","Welfare work"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U","DI-UC"],"level3":{"U":["DI-U-ALL","DI-U-ITU"],"UC":["DI-UC-ALL","DI-UC-KP"]},"level3all":["DI-U-ITU","DI-UC-KP"]},"review":"pr","rtype":["clu"],"sorti":"fra data som ledelsesinformation til datainformeret ledelse indsigter fra det borgernære driftsniveau","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/102674618/FRA_DATA_SOM_LEDELSESINFORMATION_TIL_DATAINFORMERET_LEDELSE_vol3_0.pdf","version":"Published Version"},"id":"S01-000.00-382914","ids":["itu-6e8fcc1d-b19b-4ee3-be16-08cb6fb70b75"],"keyword":["Data-informed management","Diabetes rehabilitation","Municipal health services","Professional leadership","Welfare work"],"lang":"Danish","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-F7EA3956F5A5989221DF59179257373A"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.lederliv.dk/artikel/fra-data-som-ledelsesinformation-til-datainformeret-ledelse","version":"Published Version"},{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/102674618/FRA_DATA_SOM_LEDELSESINFORMATION_TIL_DATAINFORMERET_LEDELSE_vol3_0.pdf","version":"Published Version"},{"access":"oa","type":"rem","url":"https://www.lederliv.dk/sites/default/files/FRA_DATA_SOM_LEDELSESINFORMATION_TIL_DATAINFORMERET%20LEDELSE_vol3_0.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"dk","key":"kp university college copenhagen","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-KP","l3nl":"KP","l3nn":"KP University College Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KP University College Copenhagen","namevar":["University College Copenhagen"],"nora_code":"DI-UC-KP","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Center for Digital Welfare","IT University of Copenhagen, Technologies in Practice, Technologies in Practice"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Niels","key":"borchrasmussenpau","last":"Borch Rasmussen","name":"Borch Rasmussen, Niels","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jonathan","key":"jagdhermansenpau","last":"Jagd Hermansen","name":"Jagd Hermansen, Jonathan","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Irina","key":"papazupau","last":"Papazu","locid":"6ec63914-1f4e-4708-8830-1b054c2ee03a","name":"Papazu, Irina","orcid":"0000-0002-4178-3676","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kasper Friis","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Kasper Friis","rank":4,"rolecode":"pau"}],"pub":{"issn":["24460532"],"journal":"Lederliv","status":"p","title":"Lederliv","volume":"3"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","All University Colleges","DI-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","IT University of Copenhagen","KP","Universities","University Colleges"],"PST":["Published"]},"sid":["itu-6e8fcc1d-b19b-4ee3-be16-08cb6fb70b75"],"src":["ITU IT University of Copenhagen"],"title":"Fra data som ledelsesinformation til datainformeret ledelse : Indsigter fra det borgernære driftsniveau","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382914","year":"2022","yearsub":"2022"}
{"abstract":"Democratic Situations is the name of an edited volume published by Mattering Press in May 2022. As the editors of the book, we (Irina and Andreas) would like to take this opportunity to report on two events associated with its publication: An open panel at EASST 2022 in Madrid in July and a book launch event at the TANTLab in Copenhagen in June.","author_count":3,"contributors":["Birkbak, Andreas","Blok, Anders","Papazu, Irina"],"cuid":["S01-000.00-094093"],"filters":{"added":"2023-02","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"pop","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-U-AAU","DI-U-ITU","DI-U-KU"]},"review":"und","rtype":["clu"],"sorti":"democratic situations event s report an intervention by anders blok","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://www.easst.net/article/democratic-situations-events-report-an-intervention-by-anders-blok/","version":"Published Version"},"id":"S01-000.00-094093","ids":["aau-97fdcd38-d047-430f-917b-9c70ee6b1da4"],"lang":"English","level":"Popular","mra":["Humanities"],"noi":["Local-1-1-871A20722CE41C210A64020B5AF0554D"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.easst.net/article/democratic-situations-events-report-an-intervention-by-anders-blok/","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Social Sciences and Humanities","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Culture and Learning","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Culture and Learning, The Techno-Anthropology Lab"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Andreas","key":"birkbakpau","last":"Birkbak","locid":"269bb408-d628-47f8-8539-d0c4b97a9aad","name":"Birkbak, Andreas","orcid":"0000-0001-9283-1677","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Anders","key":"blokpau","last":"Blok","name":"Blok, Anders","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Irina","key":"papazupau","last":"Papazu","name":"Papazu, Irina","rank":3,"rolecode":"pau"}],"pub":{"issn":["13845160"],"issue":"2","journal":"EASST Review","publisher":"University of Amsterdam, Department of Science","status":"p","title":"EASST Review","volume":"42"},"review":"Undetermined","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-97fdcd38-d047-430f-917b-9c70ee6b1da4"],"src":["AAU Aalborg University"],"title":"Democratic Situations event(s) report : An intervention by Anders Blok","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-094093","year"