"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1},{"affno":"3","country":"dk","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University"],"nora_code":"DI-U-RUC","used":1},{"affno":"4","country":"no","key":"university of oslo","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"University of Oslo","used":1}],"person":[{"affno":"1","first":"Lars","key":"tønderpau","last":"Tønder","locid":"38f09c77-29e7-4235-a01c-cf675a020b4a","name":"Tønder, Lars","orcid":"0000-0003-3755-7462","rank":1,"rolecode":"pau"},{"affno":"2","first":"Irina","key":"papazupau","last":"Papazu","name":"Papazu, Irina","rank":2,"rolecode":"pau"},{"affno":"3","first":"Anton","key":"graularsenpau","last":"Grau Larsen","name":"Grau Larsen, Anton","rank":3,"rolecode":"pau"},{"affno":"4","first":"Catrine","key":"holstpau","last":"Holst","name":"Holst, Catrine","rank":4,"rolecode":"pau"}],"pub":{"pages":"25","status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Roskilde University","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-dff169e5-d925-4303-a18c-d128574c981d"],"src":["KU University of Copenhagen"],"title":"Demokratisk impact: model og forslag til videre undersøgelser","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-779278","year":"2024","yearsub":"2024"}
{"abstract":"Denmark is considered one of the world’s most digitalized states, with pervasive public and private digital infrastructures in place to ensure seamless interactions between citizens and authorities. Digital interfaces are increasingly replacing physical locations, arguably to make contact and communication between citizens and authorities easier and more accessible. Since 2014, it has been mandatory for all Danish citizens to communicate with the state through the digital infrastructure ‘Digital Post’. With the pervasiveness of digitalization efforts and the sustained demand that citizens be(come)‘digital by default’, new forms of public governance and statecraft are also emerging, and with them new problems. As the state digitalizes its core functions and services, already disadvantaged citizens may experience further marginalization as national digitalization agendas reproduce and recast existing lines of social stratification as well as produce new forms of digital exclusion. Researchers have suggested concepts like ‘digital in-’or ‘exclusion’ or ‘socio-digital inequalities’ to move away from a dichotomous understanding of problems of digital inclusion as an either-or question of access, toward an appreciation of the multifaceted life situations and challenges that affect how citizens fare in digital society.","author_count":5,"contributors":["Papazu, Irina","Simonsen, Thorben Peter Høj","Reime, Lara Tatjana"],"cuid":["S01-000.00-784711"],"filters":{"added":"2024-08","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Communication","Danmark","Denmark","Digital Inclusion","Digital Inklusion","Digital Post","Digitalisering","Digitalization","Kommunikation","Marginalisering","Marginalization","Public governance","Statecraft"],"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-VIVE"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-GV-VIVE","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the digital state overflowing its boundaries considering the case of digital inclusion in denmark","src":["vive"],"src-code":["DI-GV-VIVE"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-784711","ids":["vive-8e160585-8622-47e5-a112-efb16566ba54"],"keyword":["Danmark","Denmark","Digital post","Marginalization","communication","digital inclusion","digital inklusion","digitalisering","digitalization","kommunikation","marginalisering","public governance","statecraft"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-2-484C97E39FA1172C2017D0C56947ED69"],"org":[{"affno":"1","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"vive the danish center for social science research","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-VIVE","l3nn":"VIVE The Danish Center for Social Science Research","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"VIVE The Danish Center for Social Science Research","namevar":["VIVE - The Danish Center for Social Science Research, VIVE Health"],"nora_code":"DI-GV-VIVE","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Irina","key":"papazupau","last":"Papazu","name":"Papazu, Irina","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Thorben Peter Høj","key":"simonsenpau","last":"Simonsen","locid":"1618214d-1884-49b5-9682-c8f989e31146","name":"Simonsen, Thorben Peter Høj","orcid":"0000-0002-4697-9010","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lara Tatjana","key":"reimepau","last":"Reime","name":"Reime, Lara Tatjana","rank":3,"rolecode":"pau"},{"affno":"","first":"Katrine","key":"meldgaardkjærpedh","last":"Meldgaard Kjær","name":"Meldgaard Kjær, Katrine","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Jessamy","key":"perriampedh","last":"Perriam","name":"Perriam, Jessamy","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1515/9783110787641-005","edition":"1","eisbn":["9783110787641"],"isbn":["978311078760"],"pages":"75-93","publisher":"Walter de Gruyter GmbH","series":"De Gruyter Contemporary Social Sciences","status":"p","title":"Digitalization in Practice: Intersections, Implications and Interventions"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["vive-8e160585-8622-47e5-a112-efb16566ba54"],"src":["VIVE The Danish Center for Social Science Research"],"title":"The digital state overflowing its boundaries: considering the case of digital inclusion in Denmark","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-784711","year":"2024","yearsub":"2024"}
{"abstract":"This article analyses the making of a public demonstration project with the aid of online and offline ethnographic methods, also known as assemblage ethnography. The object of demonstration is Samsø, a small tourism and farming island that was appointed Denmark’s Renewable Energy Island and embarked on a ten-year experiment to become energy self-sufficient. Through demonstrations of this achievement to national and international audiences, Samsø came to exemplify the practical doability of sustainability initiatives. I ask how the island managed to become this flexible and widely known examplar capable of traversing multiple geographic and thematic zones ‘across scales, sites, and practices’ (Wahlberg 2021). The study suggests that while Web-based activities played a role, a promotional project like the Renewable Energy Island is as dependent as ever on socio-material practices such as travelling, participating in projects and giving presentations. Drawing on Science and Technology Studies literatures on public demonstrations and quali-quantative network analysis, the study combines ethnographic fieldwork with digital network mapping to analyse four manifestations of Samsø in various networks. I argue that such assemblage ethnography is essential if we are to grasp how movements on and off the Web are co-implicated in the establishment of exemplars such as the Renewable Energy Island. In the face of imminent climate crisis and our apparent inability to implement large-scale solutions, it is more relevant than ever that we study the ‘small’ and local cases such as Samsø and what makes them able to escape their local conditions and travel far and wide, perhaps leading the way to a more sustainable future.","author_count":1,"contributors":["Papazu, Irina"],"cuid":["S01-000.00-747240"],"filters":{"added":"2024-08","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"keyword":["Assemblage ethnography","Climate change","Public demonstrations","Quali quantitative methods","Renewable energy island"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"demonstrating doability the networking practices of a danish renewable energy island","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"rem","url":"https://tidsskrift.dk/encounters/article/view/145207/188423","version":"Published Version"},"id":"S01-000.00-747240","ids":["itu-7d4db7e7-8589-4418-bd6d-b4eceb30ded4"],"keyword":["Assemblage ethnography","Climate Change","Public demonstrations","Quali-quantitative methods","Renewable energy island"],"lang":"Danish","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-AB1F060DD991ACA2B7BBDA04B3F628A2"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"rem","url":"https://tidsskrift.dk/encounters/article/view/145207/188423","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Center for Climate IT","IT University of Copenhagen, Center for Digital Welfare","IT University of Copenhagen, Technologies in Practice, Technologies in Practice"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Irina","key":"papazupau","last":"Papazu","locid":"6ec63914-1f4e-4708-8830-1b054c2ee03a","name":"Papazu, Irina","orcid":"0000-0002-4178-3676","rank":1,"rolecode":"pau"}],"pub":{"issn":["19044372"],"issue":"2","journal":"STS Encounters","pages":"1-24","publisher":"Danish Association for Science and Technology Studies","status":"p","title":"STS Encounters","volume":"16"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-7d4db7e7-8589-4418-bd6d-b4eceb30ded4"],"src":["ITU IT University of Copenhagen"],"title":"Demonstrating Doability : The Networking Practices of a Danish Renewable Energy Island","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-747240","year":"2024","yearsub":"2024"}
