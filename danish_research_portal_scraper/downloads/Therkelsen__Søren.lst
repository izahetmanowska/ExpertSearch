responding":null,"country":"dk","first":"Søren","key":"wandahlpau","last":"Wandahl","locid":"26a61cee-fb66-475b-9505-6e741352b7e6","name":"Wandahl, Søren","orcid":"0000-0001-8708-6035","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Cristina Toca","key":"perezpau","last":"Perez","locid":"4ad4f466-ee62-45af-bd3d-3bbadc185fd7","name":"Perez, Cristina Toca","orcid":"0000-0002-4182-1492","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Stephanie","key":"sallingpau","last":"Salling","locid":"d0d5d6a4-75fc-4e33-bc26-93ffb6887c76","name":"Salling, Stephanie Therkelsen","name_org":"Salling, Stephanie","orcid":"0000-0001-7088-6458","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jon","key":"lerchepau","last":"Lerche","locid":"29f82376-38f8-4434-8faa-b5fefd6b2cb9","name":"Lerche, Jon","orcid":"0000-0001-7076-9630","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.24928/2022/0127","pages":"247-258","publisher":"IGLC","status":"p","title":"Proc. 30th Annual Conference of the International Group for Lean Construction (IGLC)"},"review":"Peer Reviewed","scoID":["2-s2.0-85158855568"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-d63df8d7-93be-467a-bff4-93721b8eee18"],"src":["AU Aarhus University"],"title":"Robustness of Work Sampling for Measuring Time Waste","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-251692","year":"2022","yearsub":"2022"}
{"abstract":"Construction can be considered a socio-technical system, which is challenging to model due to the many agents interacting either in a managed way or autonomously. Therefore, cause and effect models are hard to validate, and a traditional correlation approach is insufficient. In this study, the method of robustness testing was applied to test the effect stability when assumptions of a model are changed. The research objective is to apply robustness testing on WS data to assess the robustness and validity of the WS method. An actual refurbishment project was the case for this study, where data was acquired through nine days of continuous WS application. Time-series data were grouped into Direct Work (DW), Indirect Work, and Waste Work. Several different robustness tests were applied. It can be concluded that the WS method is robust, i.e., the effect (DW) is stable even if the assumptions are changed severely. Deleting 90% of the sample does, for instance, almost not change the effect. Likewise, if errors are infused into the sample, the effect is stable. Also, if certain structural parts are excluded from the sample, e.g., observations during morning startup, etc., the effect is still stable.","author_count":4,"contributors":["Wandahl, Søren","Perez, Cristina Toca","Salling, Stephanie Therkelsen","Lerche, Jon"],"cuid":["S01-000.00-699493"],"event":{"end":"2022-07-31","place":"Edmonton, ca","start":"2022-07-25","title":"30th Annual Conference of the International Group for Lean Construction, IGLC 2022","year":"2022"},"filters":{"added":"2023-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Robustness","Trust","Value stream","Waste","Work sampling"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"robustness of work sampling for measuring time waste","src":["au"],"src-code":["DI-U-AU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.24928/2022/0127","version":"Published Version"},"funding_acknowledgement":["This work was supported by the Independt Research Fund Denmark (grant no. 0217-00020B). The authors are also grateful for the construction company that opened its door for this study."],"id":"S01-000.00-699493","identifier":[{"id":"85158855568","type":"scopus"}],"ids":["au-46527b6b-aae5-4b5c-8cd0-7e95324ebfe8"],"keyword":["Robustness","Trust","Value stream","Waste","Work Sampling"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-48B40237D59F378FBC18E1751489FDA8"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.24928/2022/0127","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Civil and Architectural Engineering, Department of Civil and Architectural Engineering - Design and Construction"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Søren","key":"wandahlpau","last":"Wandahl","locid":"26a61cee-fb66-475b-9505-6e741352b7e6","name":"Wandahl, Søren","orcid":"0000-0001-8708-6035","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Cristina Toca","key":"pérezpau","last":"Pérez","locid":"4ad4f466-ee62-45af-bd3d-3bbadc185fd7","name":"Perez, Cristina Toca","name_org":"Pérez, Cristina Toca","orcid":"0000-0002-4182-1492","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Stephanie","key":"sallingpau","last":"Salling","locid":"d0d5d6a4-75fc-4e33-bc26-93ffb6887c76","name":"Salling, Stephanie Therkelsen","name_org":"Salling, Stephanie","orcid":"0000-0001-7088-6458","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jon","key":"lerchepau","last":"Lerche","locid":"29f82376-38f8-4434-8faa-b5fefd6b2cb9","name":"Lerche, Jon","orcid":"0000-0001-7076-9630","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-46527b6b-aae5-4b5c-8cd0-7e95324ebfe8"],"src":["AU Aarhus University"],"title":"ROBUSTNESS OF WORK SAMPLING FOR MEASURING TIME WASTE","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-699493","year":"2022","yearsub":"2022"}
{"abstract":"To reduce embodied emissions and waste in renovation projects, new resource efficient and low waste construction processes are needed. One possible solution to reduce waste at the construction can be made-to-order (MTO) customisation of standard products that are delivered in the right size and quantity. A key construction process in renovation projects is the installation of gypsum for partition wall construction. Today, gypsum boards are cut to the right size at the construction site, resulting in 15-30% of waste. In several countries, pilots for delivering MTO gypsum boards in the right length for the building dimension have shown significant potential to reduce waste and increase productivity. This study aims to help the material manufacturer Saint-Gobain Denmark explore innovation opportunities from MTO gypsum boards for the Danish market. Work sampling at a renovation project is conducted to identify the activities of the current installation process and potential time savings from MTO. Interviews are used to identify actors and their roles in the current value chain for partition wall construction in Denmark and possible scenarios to offer MTO. Results show that a rise in the production time from 31% to 36% could be achieved by avoiding measuring and cutting of boards at the construction side. Two value chain scenarios for delivering MTO in the Danish market are presented. Based on the results, potential drivers and barriers for MTO in the Danish market are discussed.","author_count":5,"contributors":["Nussholz, Julia","Perez, Cristina Toca","Salling, Stephanie Therkelsen","Jørgensen, Michael Søgaard","Wandahl, Søren"],"cuid":["S02-094.12-685593"],"event":{"end":"2022-11-13","place":"Delft, nl","start":"2022-11-11","title":"SBE 2022 Delft Conference on Innovations for the Urban Energy Transition: Preparing for the European Renovation Wave","year":"2022"},"filters":{"added":"2022-11","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"corresponding_author":["Nussholz, Julia"],"keyword":["Business models","Circular economy","Prefabrication","Renovation","Resource efficiency"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"innovation opportunities from made to order gypsum boards in renovation projects a case study in denmark","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 3.0","type":"doi","url":"https://doi.org/10.1088/1755-1315/1085/1/012057","version":"Published Version"},"funding_acknowledgement":["This research received funding from Realdania and the Danish Innovation Fund. The lead author would like to thank Martha Goriatcheff-Madsen and Elisabeth Heimdal Wærsted for their help to collect data."],"id":"S02-094.12-685593","identifier":[{"id":"85140051309","type":"scopus"}],"ids":["aau-24d9d68e-8110-4ba4-a188-331ec9da8197","au-83cef324-394f-4faa-8c18-4012b3822851"],"keyword":["business models","circular economy","prefabrication","renovation","resource efficiency"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-108843D73E1FC82566091E59EE5C5FF4"],"oa_link":[{"access":"oa","license":"CC BY","type":"rem","url":"https://iopscience.iop.org/article/10.1088/1755-1315/1085/1/012057/pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.au.dk/ws/files/339712613/Nussholz_2022_IOP_Conf._Ser._Earth_Environ._Sci._1085_012057_1_.pdf","version":"Published Version"},{"access":"oa","license":"CC BY 3.0","type":"doi","url":"https://doi.org/10.1088/1755-1315/1085/1/012057","version":"Published Version"},{"access":"oa","license":"CC BY 3.0","type":"loc","url":"https://vbn.aau.dk/ws/files/626922638/Nussholz_2022_IOP_Conf._Ser._Earth_Environ._Sci._1085_012057.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Technical Faculty of IT and Design","Aalborg University, The Technical Faculty of IT and Design, Department of Sustainability and Planning","Aalborg University, The Technical Faculty of IT and Design, Department of Sustainability and Planning, SUSTAINABLE DESIGN AND TRANSITION"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Civil and Architectural Engineering, Department of Civil and Architectural Engineering - Design and Construction"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Julia","key":"nussholzpau","last":"Nussholz","locid":"92e5f787-48c5-4be9-88eb-b12e033e37a3","name":"Nussholz, Julia","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Cristina Toca","key":"perezpau","last":"Perez","locid":"4ad4f466-ee62-45af-bd3d-3bbadc185fd7","name":"Perez, Cristina Toca","orcid":"0000-0002-4182-1492","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Stephanie","key":"sallingpau","last":"Salling","locid":"d0d5d6a4-75fc-4e33-bc26-93ffb6887c76","name":"Salling, Stephanie Therkelsen","name_org":"Salling, Stephanie","orcid":"0000-0001-7088-6458","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Michael","key":"søg