y":"dk","first":"Cristina Toca","key":"perezpau","last":"Perez","locid":"4ad4f466-ee62-45af-bd3d-3bbadc185fd7","name":"Perez, Cristina Toca","orcid":"0000-0002-4182-1492","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Stephanie Therkelsen","key":"sallingpau","last":"Salling","locid":"d0d5d6a4-75fc-4e33-bc26-93ffb6887c76","name":"Salling, Stephanie Therkelsen","orcid":"0000-0001-7088-6458","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Cecilie H.","key":"hhansenpau","last":"H. Hansen","name":"H. Hansen, Cecilie H.","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Magnus","key":"knielsenpau","last":"K. Nielsen","name":"K. Nielsen, Magnus","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Tom","key":"nissenpau","last":"Nissen","name":"Nissen, Tom","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.24928/2023/0183","pages":"1255-1266","status":"p","title":"Proceedings of the 31st Annual Conference of the International Group for Lean Construction (IGLC31)"},"review":"Peer Reviewed","scoID":["2-s2.0-105005932998"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-fa502e6f-fcd2-46ce-8930-9cdb53af3b5f"],"src":["AU Aarhus University"],"title":"Daily Huddles’ Effect on Crew Productivity","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-676016","year":"2023","yearsub":"2023"}
{"abstract":"In this work, a hydraulic state of the art injection molding machine is retrofitted with a dual pump drive. The dual pump drive is an electro-hydraulic speed-variable drive, with focus on high bandwidth control through secondary control principles. Secondary control is based on providing the torque references for the electric machines directly, instead of a speed reference. The pressure control loop is based on decoupling of the piston load pressure and sum pressure enabling the possibility to utilize two SISO controllers. The application is the injection cylinder of an industrial injection molding machine, retrofitted with the designed dual pump drive. Experimental results for the proposed secondary control structure are presented and difficulties of implementation are documented, and a large gap between the theoretical achievable bandwidth and the experimental achievable bandwidth is shown. Three possible reasons for this gap are identified, namely amplification of high frequency components from e.g. signal noise on sensors, the use of axial piston pumps which induce pressure pulsations and the influence of the discrete sample time of the digital controller hardware. Lastly future work within the field is considered, including possible methods to minimize the influence of the identified issues.","author_count":6,"contributors":["Hertz, Rasmus Aagaard","Therkelsen, Ole","Kristianen, Søren","Christensen, Jesper Kjærsgaard","Helver, Christian-Emil","Schmidt, Lasse"],"cuid":["S01-000.00-705250"],"event":{"end":"2023-10-18","place":"Sarasota, Florida, us","start":"2023-10-16","title":"2023 ASME/BATH Symposium on Fluid Power and Motion Control","year":"2023"},"filters":{"added":"2024-02","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Secondary control","electro hydraulic variable speed drive"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-LEGO"],"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-PR-LEGO","DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"practical implementation of secondary control principles in an electro hydraulic speed variable drive applied to an injection moulding machine","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1115/FPMC2023-111868","version":"Published Version"},"funding_acknowledgement":["This work is funded by LEGO System A/S."],"id":"S01-000.00-705250","identifier":[{"id":"85179620160","type":"scopus"}],"ids":["aau-59d434e5-633b-42bd-9228-9b53075af0ef"],"keyword":["electro-hydraulic variable-speed drive","secondary control"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-18C373CE852389E47FA8C07EA0592F4A"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1115/FPMC2023-111868","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/656863028/v001t01a056-fpmc2023-111868.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"lego","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-LEGO","l3nn":"LEGO","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"LEGO","namevar":["LEGO Systems AS"],"nora_code":"DI-PR-LEGO","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, AAU Energy"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Rasmus Aagaard","key":"hertzpau","last":"Hertz","name":"Hertz, Rasmus Aagaard","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ole","key":"therkelsenpau","last":"Therkelsen","name":"Therkelsen, Ole","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren","key":"kristianenpau","last":"Kristianen","name":"Kristianen, Søren","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper Kjærsgaard","key":"christensenpau","last":"Christensen","name":"Christensen, Jesper Kjærsgaard","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Christian-Emil","key":"helverpau","last":"Helver","locid":"fce7cdf3-c1d9-4657-b517-9fdc7120c376","name":"Helver, Christian-Emil","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Lasse","key":"schmidtpau","last":"Schmidt","locid":"34edf04c-3e18-4b9e-bf37-12d58bf242f3","name":"Schmidt, Lasse","orcid":"0000-0002-8002-1287","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1115/fpmc2023-111868","eisbn":["9780791887431"],"pages":"1-9","publisher":"The American Society of Mechanical Engineers (ASME)","status":"p","title":"Proceedings of ASME/BATH 2023 Symposium on Fluid Power and Motion Control, FPMC 2023"},"review":"Peer Reviewed","scoID":["2-s2.0-85179620160"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Private Research","Universities"],"PST":["Published"]},"sid":["aau-59d434e5-633b-42bd-9228-9b53075af0ef"],"src":["AAU Aalborg University"],"title":"Practical Implementation of Secondary Control Principles in an Electro-Hydraulic Speed-Variable Drive Applied to an Injection Moulding Machine","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-705250","year":"2023","yearsub":"2023"}
{"abstract":"The repeatability of injection moulding machines has been a focus point since the 1970's. An important part of the moulding process, when utilizing secondary over point, is the switchover between the velocity and pressure-controlled phase. Minimizing the transients in the response increases the moulding quality. A novel switchover method is presented in this paper, based on a hydraulic injection moulding machine. Controlling the flow into each of the injection cylinder chambers combined with a cascaded control structure makes it possible to execute a fully controlled switchover with a single parameter related to the permissible time duration of the pressure settling period. The controllers are implemented on an industrial state of the art injection moulding machine, and the results show good agreement with theory. The response time and transients are minimized. It is further experimentally verified that it is possible to tune the desired switchover duration. The method furthermore simplifies the task for the moulding machine operator, when setting up a new mould, as it is possible to control the dynamics of the switchover with a single parameter.","author_count":7,"contributors":["Hertz, Rasmus A.","Christensen, Jesper K.","Therkelsen, Ole","Kristiansen, Søren","Helver, Christian-Emil","Hansson, Frederik Agervig","Schmidt, Lasse"],"cuid":["S01-000.00-757283"],"event":{"end":"2023-03-30","place":"Denver, us","start":"2023-03-27","title":"2023 SPE Annual Technical Conference and Exhibition, ANTEC 2023","year":"2023"},"filters":{"added":"2024-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-LEGO"],"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-PR-LEGO","DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"a novel approach to control switchover between injection and holding phase for a hydraulic injection moulding machine","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85179623671&partnerID=8YFLogxK","version":"Other Version"},"id":"S01-000.00-757283","identifier":[{"id":"85179623671","type":"scopus"}],"ids":["aau-c9d2affa-adff-4466-8cd3-c2349a097ddd"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-2C0720CDDBE096F113945229277BB771"],"org":[{"affno":"1","country":"dk","key":"lego","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-LEGO","l3nn":"LEGO","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"LEGO","namevar":["LEGO Systems AS"],"nora_code":"DI-PR-LEGO","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, AAU Energy"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Rasmus A.","key":"hertzpau","last":"Hertz","name":"Hertz, Rasmus A.","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper K.","key":"christensenpau","last":"Christensen","name":"Christensen, Jesper K.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ole","key":"therkelsenpau","last":"Therkelsen","name":"Therkelsen, Ole","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren","key":"kristiansenpau","last":"Kristiansen","name":"Kristiansen, Søren","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Christian Emil","key":"helverpau","last":"Helver","locid":"fce7cdf3-c1d9-4657-b517-9fdc7120c376","name":"Helver, Christian-Emil","name_org":"Helver, Christian Emil","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Frederik A.","key":"hanssonpau","last":"Hansson","locid":"bfb7300e-2961-4c79-a9ae-a9c8ead929dc","name":"Hansson, Frederik Agervig","name_org":"Hansson, Frederik A.","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Lasse","key":"schmidtpau","last":"Schmidt","locid":"34edf04c-3e18-4b9e-bf37-12d58bf242f3","name":"Schmidt, Lasse","orcid":"0000-0002-8002-1287","rank":7,"rolecode":"pau"}],"pub":{"eisbn":["9781713893523"],"issn":["07375921"],"publisher":"Society of Plastics Engineers","series":"Annual Technical Conference - ANTEC, Conference Proceedings","status":"p","title":"SPE ANTEC 2023 - Conference Proceeding"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Private Research","Universities"],"PST":["Published"]},"sid":["aau-c9d2affa-adff-4466-8cd3-c2349a097ddd"],"src":["AAU Aalborg University"],"title":"A Novel Approach to Control Switchover Between Injection and Holding Phase for a Hydraulic Injection Moulding Machine","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-757283","year":"2023","yearsub":"2023"}
{"abstract":"Cytochrome P450 oxidoreductase (POR) is an essential redox partner for steroid and drug-metabolizing cytochromes P450 located in the endoplasmic reticulum. Mutations in POR lead to metabolic disorders, including congenital adrenal hyperplasia, and affect the metabolism of steroids, drugs, and xenobiotics. In this study, we examined approximately 450 missense variants of the POR gene listed in the Genome Aggregation Database (gnomAD) using eleven different in silico prediction tools. We found that 64 novel variants were consistently predicted to be disease-causing by most tools. To validate our findings, we conducted a population analysis and selected two variations in POR for further investigation. The human POR wild type and the R268W and L577P variants were expressed in bacteria and subjected to enzyme kinetic assays using a model substrate. We also examined the activities of several cytochrome P450 proteins in the presence of POR (WT or variants) by combining P450 and reductase proteins in liposomes. We observed a decrease in enzymatic activities (ranging from 35% to 85%) of key drug-metabolizing enzymes, supported by POR variants R288W and L577P compared to WT-POR. These results validate our approach of curating a vast amount of data from genome projects and provide an updated and reliable reference for diagnosing POR deficiency.","author_count":3,"contributors":["Rojas Velazquez, Maria Natalia","Therkelsen, Søren","Pandey, Amit V."],"cuid":["S01-000.00-747472"],"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["Switzerland"],"glorg":["All Global Affiliations","University Children’s Hospital Bern","University of Bern"],"keyword":["Bioinformatics","CAH","Drug metabolism","POR","SNV","Steroid hormones","gnomAD"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"exploring novel variants of the cytochrome p000000000450 reductase gene por from the genome aggregation database by integrating bioinformatic tools and functional assays","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3390/biom13121728","version":"Published Version"},"id":"S01-000.00-747472","identifier":[{"id":"38136599","type":"pmid"},{"id":"PMC10741880","type":"pmcid"},{"id":"85180444080","type":"scopus"}],"ids":["ku-122666fe-909c-45a3-8526-66c2cba60680"],"keyword":["CAH","POR","SNV","bioinformatics","cytochrome P450 oxidoreductase","drug metabolism","gnomAD","steroid hormones"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-023D20A045B0DE1AC1909675FB3B7104"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.3390/biom13121728","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/395868260/biomolecules_13_01728_v2.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"ch","key":"university children s hospital bern","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"University Children’s Hospital Bern","used":1},{"affno":"2","country":"ch","key":"university of bern","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"University of Bern","used":1},{"affno":"3","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1 2","first":"Maria Natalia","key":"rojasvelazquezpau","last":"Rojas Velazquez","name":"Rojas Velazquez, Maria Natalia","rank":1,"rolecode":"pau"},{"affno":"1 2 3","first":"Søren","key":"therkelsenpau","last":"Therkelsen","name":"Therkelsen, Søren","rank":2,"rolecode":"pau"},{"affno":"1 2","first":"Amit V.","key":"pandeypau","last":"Pandey","name":"Pandey, Amit V.","rank":3,"rolecode":"pau"}],"pmid":["38136599"],"pub":{"doi":"10.3390/biom13121728","issn":["2218273X"],"issue":"12","journal":"Biomolecules","paperid":"1728","status":"p","title":"Biomolecules","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-85180444080"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-122666fe-909c-45a3-8526-66c2cba60680"],"src":["KU University of Copenhagen"],"title":"Exploring Novel Variants of the Cytochrome P450 Reductase Gene (POR) from the Genome Aggregation Database by Integrating Bioinformatic Tools and Functional Assays","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-747472","year":"2023","yearsub":"2023"}
{"abstract":"This study addresses the lack of procedures for automatically measuring the share of time that construction workers spend on value-adding activities as a way to automate the work sampling technique. While previous studies aimed to automate this technique by focusing on activity recognition using sensors or video-based technologies, this research is concerned with identifying workers’ locations on job sites using location-based sensors embedded in smartwatches. For this, the authors conducted a case study, which aims to measure the share of time workers spent in different outdoor workspaces. The study was carried out on a renovation project and involved five steps: (1) clarifying the workspace categories (production, preparation, and transportation); (2) data collection of carpenters’ locations using geographic data points collected by smartwatches during 7 days; (3) data extraction and data aggregation; (4) data cleaning; and (5) data analysis using a Python script to automatize the classification of the data points into workspaces. The main contribution is a visual tool to visualize workers’ positions on the job site in 2D. This information can be useful to indicate how many hours per day they spend in different workspaces and to understand the nature of a given construction activity.","author_count":3,"contributors":["Perez, Cristina Toca","Salling, Stephanie Therkelsen","Wandahl, Søren"],"cuid":["S01-000.00-675552"],"event":{"end":"2023-07-02","place":"Lille, fr","start":"2023-06-26","title":"31st annual conference of the International Group for Lean Construction","year":"2023"},"filters":{"added":"2023-08","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Perez, Cristina Toca","Salling, Stephanie Therkelsen","Wandahl, Søren"],"keyword":["Digitization","Smartwatches","Visual management","Work flow","Workspaces"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"measuring time spent in value adding workspaces using smartwatches","src":["au"],"src-code":["DI-U-AU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/105005933455","version":"Other Version"},"id":"S01-000.00-675552","identifier":[{"id":"105005933455","type":"scopus"}],"ids":["au-b2a53ab7-40e3-41a5-b61d-40badd4d3f77"],"keyword":["Work flow","digitization","smartwatches","visual management","workspaces"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-B92278416BB73FC70FC9E214CF88CEC6"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Civil and Architectural Engineering, Department of Civil and Architectural Engineering - Design and Construction"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Cristina Toca","key":"perezpau","last":"Perez","locid":"4ad4f466-ee62-45af-bd3d-3bbadc185fd7","name":"Perez, Cristina Toca","orcid":"0000-0002-4182-1492","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Stephanie Therkelsen","key":"sallingpau","last":"Salling","locid":"d0d5d6a4-75fc-4e33-bc26-93ffb6887c76","name":"Salling, Stephanie Therkelsen","orcid":"0000-0001-7088-6458","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren","key":"wandahlpau","last":"Wandahl","locid":"26a61cee-fb66-475b-9505-6e741352b7e6","name":"Wandahl, Søren","orcid":"0000-0001-8708-6035","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.24928/2023/0101","pages":"1440-1450","status":"p","title":"Proceedings of the 31st Annual Conference of the International Group for Lean Construction (IGLC31)"},"review":"Peer Reviewed","scoID":["2-s2.0-105005933455"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-b2a53ab7-40e3-41a5-b61d-40badd4d3f77"],"src":["AU Aarhus University"],"title":"MEASURING TIME SPENT IN VALUE-ADDING WORKSPACES USING SMARTWATCHES","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-675552","year":"2023","yearsub":"2023"}
{"abstract":"This study reports on the synthesis and evaluation of novel compounds replacing the nitrogen-containing heterocyclic ring on the chemical backbone structure of cytochrome P450 17α-hydroxylase/12,20-lyase (CYP17A1) inhibitors with a phenyl bearing a sulfur-based substituent. Initial screening revealed compounds with marked inhibition of CYP17A1 activity. The selectivity of compounds was thereafter determined against cytochrome P450 21-hydroxylase, cytochrome P450 3A4, and cytochrome P450 oxidoreductase. Additionally, the compounds showed weak inhibitory activity against aldo-keto reductase 1C3 (AKR1C3). The compounds’ impact on steroid hormone levels was also assessed, with some notable modulatory effects observed. This work paves the way for developing more potent dual inhibitors specifically targeting CYP17A1 and AKR1C3.","author_count":17,"contributors":["Wróbel, Tomasz M.","Sharma, Katyayani","Mannella, Iole","Oliaro-Bosso, Simonetta","Nieckarz, Patrycja","Du Toit, Therina","Voegel, Clarissa Daniela","Rojas Velazquez, Maria Natalia","Yakubu, Jibira","Matveeva, Anna","Therkelsen, Søren","Jørgensen, Flemming Steen","Pandey, Amit V.","Pippione, Agnese C.","Lolli, Marco L.","Boschi, Donatella","Björkling, Fredrik"],"cuid":["S01-000.00-702311"],"filters":{"added":"2023-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","OECD"],"country":["Italy","Poland","Switzerland"],"glorg":["All Global Affiliations","Medical University of Lublin","University Children’s Hospital Bern","University Hospital Bern","University of Bern","University of Turin"],"keyword":["CYP17A1","Enzyme inhibition","Prostate cancer"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"exploring the potential of sulfur moieties in compounds inhibiting steroidogenesis","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3390/biom13091349","version":"Published Version"},"id":"S01-000.00-702311","identifier":[{"id":"85172765608","type":"scopus"},{"id":"PMC10526780","type":"pmcid"},{"id":"37759751","type":"pmid"}],"ids":["ku-c9c0cd48-04e1-49ff-af3a-e822d0074064"],"keyword":["AKR1C3","CYP17A1","enzyme inhibition","prostate cancer"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-07B73ACBA82BBC24125028BEE3CD948A"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/370476537/biomolecules_13_01349.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.3390/biom13091349","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Drug Design and Pharmacology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"pl","key":"medical university of lublin","loc":["Poland","Europe, EU","OECD"],"name":"Medical University of Lublin","used":1},{"affno":"3","country":"ch","key":"university children s hospital bern","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"University Children’s Hospital Bern","used":1},{"affno":"4","country":"ch","key":"university of bern","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"University of Bern","used":1},{"affno":"5","country":"it","key":"university of turin","loc":["Italy","Europe, EU","OECD"],"name":"University of Turin","used":1},{"affno":"6","country":"ch","key":"university hospital bern","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"University Hospital Bern","used":1}],"person":[{"affno":"1 2","first":"Tomasz M.","key":"wróbelpau","last":"Wróbel","locid":"5d7b91fa-6532-45b2-9aa0-896fe4f8b1e4","name":"Wróbel, Tomasz M.","rank":1,"rolecode":"pau"},{"affno":"3 4","first":"Katyayani","key":"sharmapau","last":"Sharma","name":"Sharma, Katyayani","rank":2,"rolecode":"pau"},{"affno":"5","first":"Iole","key":"mannellapau","last":"Mannella","name":"Mannella, Iole","rank":3,"rolecode":"pau"},{"affno":"5","first":"Simonetta","key":"oliarobossopau","last":"Oliaro-Bosso","name":"Oliaro-Bosso, Simonetta","rank":4,"rolecode":"pau"},{"affno":"2","first":"Patrycja","key":"nieckarzpau","last":"Nieckarz","name":"Nieckarz, Patrycja","rank":5,"rolecode":"pau"},{"affno":"3 4","first":"Therina","key":"dutoitpau","last":"Du Toit","name":"Du Toit, Therina","rank":6,"rolecode":"pau"},{"affno":"4 6","first":"Clarissa Daniela","key":"voegelpau","last":"Voegel","name":"Voegel, Clarissa Daniela","rank":7,"rolecode":"pau"},{"affno":"3 4","first":"Maria Natalia","key":"rojasvelazquezpau","last":"Rojas Velazquez","name":"Rojas Velazquez, Maria Natalia","rank":8,"rolecode":"pau"},{"affno":"3 4","first":"Jibira","key":"yakubupau","last":"Yakubu","name":"Yakubu, Jibira","rank":9,"rolecode":"pau"},{"affno":"3 4","first":"Anna","key":"matveevapau","last":"Matveeva","name":"Matveeva, Anna","rank":10,"rolecode":"pau"},{"affno":"1","first":"Søren","key":"therkelsenpau","last":"Therkelsen","name":"Therkelsen, Søren","rank":11,"rolecode":"pau"},{"affno":"1","first":"Flemming Steen","key":"jørgensenpau","last":"Jørgensen","locid":"e72229e9-f4bb-420b-a77c-aeca5b750eaa","name":"Jørgensen, Flemming Steen","orcid":"0000-0001-8040-2998","rank":12,"rolecode":"pau"},{"affno":"3 4","first":"Amit V.","key":"pandeypau","last":"Pandey","name":"Pandey, Amit V.","rank":13,"rolecode":"pau"},{"affno":"5","first":"Agnese C.","key":"pippionepau","last":"Pippione","name":"Pippione, Agnese C.","rank":14,"rolecode":"pau"},{"affno":"5","first":"Marco L.","key":"lollipau","last":"Lolli","name":"Lolli, Marco L.","rank":15,"rolecode":"pau"},{"affno":"5","first":"Donatella","key":"boschipau","last":"Boschi","name":"Boschi, Donatella","rank":16,"rolecode":"pau"},{"affno":"1","first":"Fredrik","key":"björklingpau","last":"Björkling","locid":"5072bbbf-15eb-408b-92ed-8d9e8e5c89c4","name":"Björkling, Fredrik","orcid":"0000-0001-7018-8334","rank":17,"rolecode":"pau"}],"pmid":["37759751"],"pub":{"doi":"10.3390/biom13091349","issn":["2218273X"],"issue":"9","journal":"Biomolecules","paperid":"1349","status":"p","title":"Biomolecules","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-85172765608"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-c9c0cd48-04e1-49ff-af3a-e822d0074064"],"src":["KU University of Copenhagen"],"title":"Exploring the Potential of Sulfur Moieties in Compounds Inhibiting Steroidogenesis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-702311","year":"2023","yearsub":"2023"}
{"abstract":"In running production the measurement of process and material properties in-line, is a requirement to design and implement effective process control in injection moulding. This work presents a structured thorough analysis and review of the research concerned with in-line measurements of selected processes and material properties on the injection moulding machines. This review sets the current state of art within a range of process and material properties, and identifies areas for future research. The process and material property measurements reviewed are; Viscosity, Melt temperature, pvT and Melt density. It is identified that the largest research effort has been placed on the measurement of viscosity and melt temperature, whereas pvT and melt density measurement are less developed. Finally, gaps within the literature are identified and the proposal of a direction within the field is stated.","author_count":5,"contributors":["Hertz, Rasmus Aagaard","Christensen, Jesper Kjærsgaard","Kristiansen, Søren","Therkelsen, Ole","Schmidt, Lasse"],"cuid":["S01-000.00-064073"],"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Injection moulding","Melt Temperature","PVT","Viscosity"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-LEGO"],"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-PR-LEGO","DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"in line process and material property measurement in injection moulding a theoretical review","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1080/21693277.2022.2148136","version":"Published Version"},"id":"S01-000.00-064073","identifier":[{"id":"85143255596","type":"scopus"}],"ids":["aau-3076e537-f84e-46d4-95e6-dc77e8366610"],"keyword":["Injection moulding","Melt Density","Melt Temperature","Viscosity","pvT"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-82AECD65B6BFE8C1796D1F41311F504D"],"oa_link":[{"access":"oa","license":"CC BY-NC 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/515390977/In_line_Process_and_Material_Property_Measurement_in_Injection_Moulding_a_Theoretical_Review.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1080/21693277.2022.2148136","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"dk","key":"lego","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-LEGO","l3nn":"LEGO","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"LEGO","namevar":["LEGO Systems AS"],"nora_code":"DI-PR-LEGO","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, AAU Energy","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Applied Power Electronic Systems","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Fluid Power","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Mechatronic Systems"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Rasmus Aagaard","key":"hertzpau","last":"Hertz","name":"Hertz, Rasmus Aagaard","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper Kjærsgaard","key":"christensenpau","last":"Christensen","name":"Christensen, Jesper Kjærsgaard","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren","key":"kristiansenpau","last":"Kristiansen","name":"Kristiansen, Søren","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ole","key":"therkelsenpau","last":"Therkelsen","name":"Therkelsen, Ole","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Lasse","key":"schmidtpau","last":"Schmidt","locid":"34edf04c-3e18-4b9e-bf37-12d58bf242f3","name":"Schmidt, Lasse","orcid":"0000-0002-8002-1287","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1080/21693277.2022.2148136","issn":["21693277"],"issue":"1","journal":"Production & Manufacturing Research","pages":"938-963","publisher":"Taylor & Francis","status":"p","title":"Production & Manufacturing Research","volume":"10"},"review":"Peer Reviewed","scoID":["2-s2.0-85143255596"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Private Research","Universities"],"PST":["Published"]},"sid":["aau-3076e537-f84e-46d4-95e6-dc77e8366610"],"src":["AAU Aalborg University"],"title":"In-line Process and Material Property Measurement in Injection Moulding - a Theoretical Review","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-064073","year":"2022","yearsub":"2022"}
{"abstract":"This study is part of an ongoing research project aiming to develop a method for understanding workers’ efficiency (workers’ time spent in value-adding activities) by measuring new indexes, such as workers’ travelled distances and workers’ locations collected by smartwatches. To achieve the objective of the study, a Design Science Research (DSR) strategy was adopted. The first cycle consists of understanding which types of information smartwatches can collect and how this data can be employed for measuring workers’ efficiency. This paper reports a case study as part of the first Cycle of the DSR. The object studied were the activities carried out by a carpenter trade in a housing renovation project. The authors used the geographic coordinates obtained by smartwatches worn by the carpenter trade connected to two Global Navigations Satellite Systems. The primary contribution of this research consists of proposing a set of five guidelines for the application of smartwatches, using data gathered from the case study. The guidelines are: (1) adopt a stratified sampling approach for selecting the workers involved according to their tasks conducted; (2) set up the smartwatches considering workers’ physical features; (3) carefully consider the job site location for delivering the smartwatch to workers; (4) establish assumptions for the data cleaning process regarding construction project features and the study’s goal; and (5) use individual participant data in the analysis according to each participant’s characteristics and role.","author_count":3,"contributors":["Perez, Cristina Toca","Salling, Stephanie Therkelsen","Wandahl, Søren"],"cuid":["S01-000.00-244204"],"filters":{"added":"2022-09","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Perez, Cristina Toca"],"keyword":["Construction site","Smartwatch"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"five guidelines for adopting smartwatches in construction a novel approach for understanding workers efficiency based on travelled distances and locations","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/su14148875","version":"Published Version"},"id":"S01-000.00-244204","identifier":[{"id":"85136430972","type":"scopus"},{"id":"000832214900001","type":"wos"}],"ids":["au-c91be29d-5019-444d-a155-174aa90e9b04"],"keyword":["construction site","smartwatch","transportation activities","travelled distance"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-49439953B6CC7967A07059DBD4144662"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.au.dk/ws/files/276136234/sustainability_14_08875.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/su14148875","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Civil and Architectural Engineering, Department of Civil and Architectural Engineering - Design and Construction"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Cristina Toca","key":"perezpau","last":"Perez","locid":"4ad4f466-ee62-45af-bd3d-3bbadc185fd7","name":"Perez, Cristina Toca","orcid":"0000-0002-4182-1492","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Stephanie","key":"sallingpau","last":"Salling","locid":"d0d5d6a4-75fc-4e33-bc26-93ffb6887c76","name":"Salling, Stephanie Therkelsen","name_org":"Salling, Stephanie","orcid":"0000-0001-7088-6458","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren","key":"wandahlpau","last":"Wandahl","locid":"26a61cee-fb66-475b-9505-6e741352b7e6","name":"Wandahl, Søren","orcid":"0000-0001-8708-6035","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.3390/su14148875","issn":["20711050"],"issue":"14","journal":"Sustainability","paperid":"8875","publisher":"Multidisciplinary Digital Publishing Institute (MDPI)","status":"p","title":"Sustainability","volume":"14"},"review":"Peer Reviewed","scoID":["2-s2.0-85136430972"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-c91be29d-5019-444d-a155-174aa90e9b04"],"src":["AU Aarhus University"],"title":"Five Guidelines for Adopting Smartwatches in Construction : A Novel Approach for Understanding Workers’ Efficiency Based on Travelled Distances and Locations","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-244204","year":"2022","yearsub":"2022"}
{"author_count":3,"contributors":["Salling, Stephanie Therkelsen","Perez, Cristina Toca","Wandahl, Søren"],"cuid":["S01-000.00-200027"],"event":{"end":"2022-07-31","place":"Edmonton, ca","start":"2022-07-25","title":"IGLC 2022 - 30th Annual Conference of the International Group for Lean Construction","year":"2022"},"filters":{"added":"2022-09","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Perez, Cristina Toca","Salling, Stephanie Therkelsen","Wandahl, Søren"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"breakdown work sampling","src":["au"],"src-code":["DI-U-AU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.24928/2022/0125","version":"Published Version"},"id":"S01-000.00-200027","identifier":[{"id":"85159239289","type":"scopus"}],"ids":["au-7b9347e6-df5d-472d-bd14-3ba599f70ccf"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-4DE73F76133531ECB92BB9C590F43985"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.au.dk/ws/files/276135702/Salling_et_al._2022_Breakdown_Work_Sampling.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.24928/2022/0125","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Civil and Architectural Engineering, Department of Civil and Architectural Engineering - Design and Construction"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Stephanie","key":"sallingpau","last":"Salling","locid":"d0d5d6a4-75fc-4e33-bc26-93ffb6887c76","name":"Salling, Stephanie Therkelsen","name_org":"Salling, Stephanie","orcid":"0000-0001-7088-6458","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Cristina Toca","key":"perezpau","last":"Perez","locid":"4ad4f466-ee62-45af-bd3d-3bbadc185fd7","name":"Perez, Cristina Toca","orcid":"0000-0002-4182-1492","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren","key":"wandahlpau","last":"Wandahl","locid":"26a61cee-fb66-475b-9505-6e741352b7e6","name":"Wandahl, Søren","orcid":"0000-0001-8708-6035","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.24928/2022/0125","pages":"223-234","publisher":"IGLC","status":"p","title":"Proceedings of the 30th Annual Conference of the International Group for Lean Construction (IGLC)"},"review":"Peer Reviewed","scoID":["2-s2.0-85159239289"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-7b9347e6-df5d-472d-bd14-3ba599f70ccf"],"src":["AU Aarhus University"],"title":"Breakdown Work Sampling","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-200027","year":"2022","yearsub":"2022"}
{"abstract":"Construction production processes are, in general, improved by removing non-value-adding activities. This includes reducing workers' movements (walking) for transportation, inspections, etc. This research analyses the relationship between construction workers' travelled distance and time spent on Direct Work (DW) at a construction site. An exploratory case study of the tasks performed by the carpenter trade was conducted.. Several sources of evidence, tools, and techniques were adopted: (a) direct observation to characterize the main activities; (b) Work Sampling (WS) technique to estimate the distribution of work time spent on different activities; (c) smartwatches to collect the data on construction workers' travelled distance on the site during workhours; and (d) questionnaire application to collect workers' perception of using the smartwatches. The relationship between distance travelled by workers and the time spent on DW was tested using linear regression analysis. The results indicate DW is indirectly correlated to how much workers walk on the construction site (R=0.445). This study presents a pioneering use of data gathered from smartwatches as a tool for collecting workers' travelled distance. The use of smartwatches has the potential implication to automate the data collection to estimate the time spent on DW based on travelled distances.","author_count":3,"contributors":["Perez, Cristina Toca","Salling, Stephanie Therkelsen","Wandahl, Søren"],"cuid":["S01-000.00-254801"],"event":{"end":"2022-06-30","place":"Melbourne, au","start":"2022-06-27","title":"International Council for Research and Innovation in Building and Construction World Building Congress 2022, WBC 2022","year":"2022"},"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"using smartwatches to understand the relationship between construction workers travelled distance and time spent on direct work","src":["au"],"src-code":["DI-U-AU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1088/1755-1315/1101/8/082009","version":"Published Version"},"id":"S01-000.00-254801","identifier":[{"id":"85144213640","type":"scopus"}],"ids":["au-dbcdff27-b974-4774-b932-78b75fc763e1"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-B902290A962B742C0243D3146C57191A"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.au.dk/ws/files/333849242/P_rez_2022_IOP_Conf._Ser._Earth_Environ._Sci._1101_082009.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1088/1755-1315/1101/8/082009","version":"Published Version"},{"access":"oa","license":"CC BY","type":"rem","url":"https://iopscience.iop.org/article/10.1088/1755-1315/1101/8/082009/pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Civil and Architectural Engineering, Department of Civil and Architectural Engineering - Design and Construction"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Cristina Toca","key":"perezpau","last":"Perez","locid":"4ad4f466-ee62-45af-bd3d-3bbadc185fd7","name":"Perez, Cristina Toca","orcid":"0000-0002-4182-1492","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Stephanie","key":"sallingpau","last":"Salling","locid":"d0d5d6a4-75fc-4e33-bc26-93ffb6887c76","name":"Salling, Stephanie Therkelsen","name_org":"Salling, Stephanie","orcid":"0000-0001-7088-6458","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren","key":"wandahlpau","last":"Wandahl","locid":"26a61cee-fb66-475b-9505-6e741352b7e6","name":"Wandahl, Søren","orcid":"0000-0001-8708-6035","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1088/1755-1315/1101/8/082009","issn":["17551307","17551315"],"issn_org":["17551307"],"issue":"8","journal":"IOP Conference Series: Earth and Environmental Science","paperid":"082009","publisher":"Institute of Physics","status":"p","title":"IOP Conference Series: Earth and Environmental Science","title_org":"I O P Conference Series: Earth and Environmental Science","volume":"1101"},"review":"Peer Reviewed","scoID":["2-s2.0-85144213640"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-dbcdff27-b974-4774-b932-78b75fc763e1"],"src":["AU Aarhus University"],"title":"Using smartwatches to understand the relationship between construction workers’ travelled distance and time spent on direct work","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-254801","year":"2022","yearsub":"2022"}
{"abstract":"AIMS: The aim of this study was to evaluate the risk of stroke and bleeding among patients with atrial fibrillation (AF) treated with direct oral anticoagulants (DOACs) despite anaemia at treatment initiation time. METHODS AND RESULTS: All Danish patients (N = 41 321) diagnosed with incident AF, having a baseline haemoglobin (Hb), and subsequently initiated DOAC therapy between 2012 and 2019 were identified through administrative registry databases. Patients with anaemia were subdivided according to the World Health Organization classification of anaemia and evaluated regarding risk of stroke and composite bleeding endpoint [hospitalization due to urogenital, gastrointestinal (GI), or intracranial bleeding or epistaxis]. Standardized absolute 1-year risks of stroke and composite bleeding endpoint were calculated using multivariable Cox regression analyses. The standardized absolute 1-year risk difference for composite bleeding increased by 0.96% [95% confidence interval (CI) 0.38-1.54] for patients with moderate/severe anaemia compared with patients with no anaemia. This risk was mainly driven by an increase in standardized absolute 1-year risk for serious GI bleeding, which increased by 0.41% (95% CI 0.19-0.63). No significant difference in standardized absolute 1-year bleeding risk was observed among patients with mild anaemia compared with patients with no anaemia 0.36% (95% CI -0.10 to 0.82). No significant difference in standardized absolute 1-year risk of stroke was observed among patients with mild anaemia, -0.16% (95% CI -0.13 to 0.15), and moderate/severe anaemia, -0.47% (95% CI -0.16 to 0.19), compared with patients with no anaemia. CONCLUSION: For AF patients receiving DOACs, moderate/severe anaemia is a risk factor for serious GI bleeding, while stroke risk is the same regardless of whether anaemia was present at baseline or not.","author_count":8,"contributors":["Al-Hussainy, Nour","Kragholm, Kristian","Lundbye-Christensen, Søren","Torp-Pedersen, Christian","Pareek, Manan","Therkelsen, Susette Krohn","Lip, Gregory Y H","Riahi, Sam"],"cuid":["S02-086.36-007476"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, Non-EU","OECD"],"corresponding_author":["Al-Hussainy, Nour"],"country":["United Kingdom"],"glorg":["All Global Affiliations","Liverpool Heart and Chest Hospital NHS Foundation Trust","University of Liverpool"],"keyword":["Anaemia","Anemia complications","Anticoagulants adverse effects","Antithrombotic therapy","Atrial Fibrillation complications","Atrial fibrillation","Bleeding complications","Cohort Studies","Dabigatran","Denmark epidemiology","Gastrointestinal bleeding","Hemorrhage chemically induced","Humans","Metaanalysis","Mortality","Risk","Rivaroxaban","Stroke","Stroke epidemiology","Thromboembolic events","Warfarin"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-NDR","DI-HO-ZEA"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-HO-NDR","DI-HO-ZEA","DI-U-AAU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"safety and efficacy of direct oral anticoagulants in patients with anaemia and atrial fibrillation an observational nation wide danish cohort study","src":["aau","ku"],"src-code":["DI-U-AAU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S02-086.36-007476","identifier":[{"id":"85129627711","type":"scopus"},{"id":"000769679600001","type":"wos"},{"id":"34931662","type":"pmid"}],"ids":["aau-99ed1afc-9926-4b7e-838e-0b8bac03431f","ku-ca78260f-2538-4a2d-8ba3-cb795449e260"],"keyword":["ANTITHROMBOTIC THERAPY","Anaemia","Anemia/complications","Anticoagulants/adverse effects","Atrial Fibrillation/complications","Atrial fibrillation","BLEEDING COMPLICATIONS","Cohort Studies","DABIGATRAN","Denmark/epidemiology","Direct oral anticoagulants (DOACs)","Gastrointestinal bleeding","Hemorrhage/chemically induced","Humans","METAANALYSIS","MORTALITY","RISK","RIVAROXABAN","Stroke","Stroke/epidemiology","THROMBOEMBOLIC EVENTS","WARFARIN"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-E27A3222A1F84AEBD4E46F3DDCEC9A74"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Regional Hospitals Zealand"],"nora_code":"DI-HO-ZEA","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Cardiology","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Forskning, Uddannelse og Innovation","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Anæstesi, Børn, Kredsløb og Kvinder","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Unit of Epidemiology and Biostatistics"],"nora_code":"DI-U-AAU","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"4","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"Univers