nattan G T","key":"martinezribonpau","last":"Martinez Ribon","locid":"14be8d8b-10ff-44be-865c-795e00a3edf7","name":"Martinez Ribon, Jhonattan G T","orcid":"0000-0001-6715-4440","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Cristina Toca","key":"perezpau","last":"Perez","locid":"4ad4f466-ee62-45af-bd3d-3bbadc185fd7","name":"Perez, Cristina Toca","orcid":"0000-0002-4182-1492","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren","key":"wandahlpau","last":"Wandahl","locid":"26a61cee-fb66-475b-9505-6e741352b7e6","name":"Wandahl, Søren","orcid":"0000-0001-8708-6035","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Stephanie Therkelsen","key":"sallingpau","last":"Salling","locid":"d0d5d6a4-75fc-4e33-bc26-93ffb6887c76","name":"Salling, Stephanie Therkelsen","orcid":"0000-0001-7088-6458","rank":4,"rolecode":"pau"}],"pub":{"publisher":"CIB","status":"p","title":"Proceedings of the 41st International Conference of CIB W78"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-68d40025-6a17-4d59-b12b-ebfec3cf8470"],"src":["AU Aarhus University"],"title":"Evaluating the feasibility of smartwatches for allocating workers' time into workspaces on jobsites","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-772617","year":"2024","yearsub":"2024"}
{"abstract":"The construction industry is labor-intensive, where project performance relies on a successful collaboration between construction workers between workers and managers. Hence, knowledge about workers' job satisfaction is highly valuable for improving the efficiency of the construction industry. For that reason, a survey was conducted to understand construction workers' perceptions of factors that influence job satisfaction. The questionnaire included 12 demographic questions and 27 questions. Data was collected in 2023, and almost 3400 workers answered the questionnaire. Several relevant insights surfaced during the data analysis. Among others, the more the workers are engaged and involved in planning, the higher the performance and job satisfaction. The more digital tools are used, the better performance and job satisfaction. However, workers find that digital tools are used too little. The younger workforce is more troubled than the older.","author_count":3,"contributors":["Wandahl, Søren","Perez, Cristina Toca","Salling, Stephanie Therkelsen"],"cuid":["S01-000.00-758279"],"event":{"end":"2024-05-31","place":"Trondheim, no","start":"2024-05-29","title":"12th Nordic Conference on Construction Economics and Organisation","year":"2024"},"filters":{"added":"2024-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Wandahl, Søren"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"construction workers perception of project management work environment and health amp safety","src":["au"],"src-code":["DI-U-AU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1088/1755-1315/1389/1/012039","version":"Published Version"},"id":"S01-000.00-758279","identifier":[{"id":"85203688206","type":"scopus"}],"ids":["au-994d5663-e3bc-4d69-acda-ca217dae954e"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-001DAFFCCC50BCEC4B68DB0A5449BBA8"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1088/1755-1315/1389/1/012039","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Civil and Architectural Engineering, Department of Civil and Architectural Engineering - Design and Construction"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Søren","key":"wandahlpau","last":"Wandahl","locid":"26a61cee-fb66-475b-9505-6e741352b7e6","name":"Wandahl, Søren","orcid":"0000-0001-8708-6035","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Cristina Toca","key":"perezpau","last":"Perez","locid":"4ad4f466-ee62-45af-bd3d-3bbadc185fd7","name":"Perez, Cristina Toca","orcid":"0000-0002-4182-1492","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Stephanie Therkelsen","key":"sallingpau","last":"Salling","locid":"d0d5d6a4-75fc-4e33-bc26-93ffb6887c76","name":"Salling, Stephanie Therkelsen","orcid":"0000-0001-7088-6458","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1088/1755-1315/1389/1/012039","edition":"1","issn":["17551307"],"series":"IOP Conference Series: Earth and Environmental Science","status":"p","title":"12th Nordic Conference on Construction Economics and Organisation","volume":"1389"},"review":"Peer Reviewed","scoID":["2-s2.0-85203688206"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-994d5663-e3bc-4d69-acda-ca217dae954e"],"src":["AU Aarhus University"],"title":"Construction Workers’ Perception of Project Management, Work Environment, and Health &amp; Safety","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-758279","year":"2024","yearsub":"2024"}
{"abstract":"Endocrine-disrupting chemicals (EDCs) may impact the development of prostate cancer (PCa) by altering the steroid metabolism. Although their exact mechanism of action in controlling tumor growth is not known, EDCs may inhibit steroidogenic enzymes such as CYP17A1 or CYP19A1 which are involved in the production of androgens or estrogens. High levels of circulating androgens are linked to PCa in men and Polycystic Ovary Syndrome (PCOS) in women. Essential oils or their metabolites, like lavender oil and tea tree oil, have been reported to act as potential EDCs and contribute towards sex steroid imbalance in cases of prepubertal gynecomastia in boys and premature thelarche in girls due to the exposure to lavender-based fragrances. We screened a range of EO components to determine their effects on CYP17A1 and CYP19A1. Computational docking was performed to predict the binding of essential oils with CYP17A1 and CYP19A1. Functional assays were performed using the radiolabeled substrates or Liquid Chromatography–High-Resolution Mass Spectrometry and cell viability assays were carried out in LNCaP cells. Many of the tested compounds bind close to the active site of CYP17A1, and (+)-Cedrol had the best binding with CYP17A1 and CYP19A1. Eucalyptol, Dihydro-β-Ionone, and (−)-α-pinene showed 20% to 40% inhibition of dehydroepiandrosterone production; and some compounds also effected CYP19A1. Extensive use of these essential oils in various beauty and hygiene products is common, but only limited knowledge about their potential detrimental side effects exists. Our results suggest that prolonged exposure to some of these essential oils may result in steroid imbalances. On the other hand, due to their effect on lowering androgen output and ability to bind at the active site of steroidogenic cytochrome P450s, these compounds may provide design ideas for novel compounds against hyperandrogenic disorders such as PCa and PCOS.","author_count":8,"contributors":["Sharma, Katyayani","Lanzilotto, Angelo","Yakubu, Jibira","Therkelsen, Søren","Vöegel, Clarissa Daniela","Du Toit, Therina","Jørgensen, Flemming Steen","Pandey, Amit V."],"cuid":["S01-000.00-731033"],"filters":{"added":"2024-05","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["Switzerland"],"glorg":["All Global Affiliations","University Children’s Hospital Bern","University Hospital Bern","University of Bern"],"keyword":["Anti cancer drugs","CYP17A1","DHEA","EDCs","Prostate cancer","Steroidogenesis"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"effect of essential oil components on the activity of steroidogenic cytochrome p000000000450","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3390/biom14020203","version":"Published Version"},"id":"S01-000.00-731033","identifier":[{"id":"38397440","type":"pmid"},{"id":"85185947843","type":"scopus"},{"id":"PMC10887332","type":"pmcid"}],"ids":["ku-4a1e24ee-d2b9-41b7-bbba-a0ceed3c8765"],"keyword":["CYP17A1","DHEA","EDCs","anti-cancer drugs","prostate cancer","steroidogenesis"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-F3406695088A4AA8059983D92D581070"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.3390/biom14020203","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/384876761/biomolecules_14_00203.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"ch","key":"university children s hospital bern","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"University Children’s Hospital Bern","used":1},{"affno":"2","country":"ch","key":"university of bern","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"University of Bern","used":1},{"affno":"3","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"4","country":"ch","key":"university hospital bern","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"University Hospital Bern","used":1}],"person":[{"affno":"1 2","first":"Katyayani","key":"sharmapau","last":"Sharma","name":"Sharma, Katyayani","rank":1,"rolecode":"pau"},{"affno":"1 2","first":"Angelo","key":"lanzilottopau","last":"Lanzilotto","name":"Lanzilotto, Angelo","rank":2,"rolecode":"pau"},{"affno":"1 2","first":"Jibira","key":"yakubupau","last":"Yakubu","name":"Yakubu, Jibira","rank":3,"rolecode":"pau"},{"affno":"1 2 3","first":"Søren","key":"therkelsenpau","last":"Therkelsen","name":"Therkelsen, Søren","rank":4,"rolecode":"pau"},{"affno":"2 4","first":"Clarissa Daniela","key":"vöegelpau","last":"Vöegel","name":"Vöegel, Clarissa Daniela","rank":5,"rolecode":"pau"},{"affno":"1 2 4","first":"Therina","key":"dutoitpau","last":"Du Toit","name":"Du Toit, Therina","rank":6,"rolecode":"pau"},{"affno":"3","first":"Flemming Steen","key":"jørgensenpau","last":"Jørgensen","locid":"e72229e9-f4bb-420b-a77c-aeca5b750eaa","name":"Jørgensen, Flemming Steen","orcid":"0000-0001-8040-2998","rank":7,"rolecode":"pau"},{"affno":"1 2","first":"Amit V.","key":"pandeypau","last":"Pandey","name":"Pandey, Amit V.","rank":8,"rolecode":"pau"}],"pmid":["38397440"],"pub":{"doi":"10.3390/biom14020203","issn":["2218273X"],"issue":"2","journal":"Biomolecules","paperid":"203","status":"p","title":"Biomolecules","volume":"14"},"review":"Peer Reviewed","scoID":["2-s2.0-85185947843"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-4a1e24ee-d2b9-41b7-bbba-a0ceed3c8765"],"src":["KU University of Copenhagen"],"title":"Effect of Essential Oil Components on the Activity of Steroidogenic Cytochrome P450","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-731033","year":"2024","yearsub":"2024"}
{"abstract":"In this work an industrial hydraulic injection moulding machine, is retrofitted with a electro-hydraulic variable-speed drive. The focus is placed on the injection cylinder, where the design of the hydraulic system is realized with standard components. The design is based on two permanent magnet synchronous motors connected to two fixed displacement pumps, allowing the control of the injection cylinder without the need for valves in the flow path, removing the dynamic influence of a valve and reducing throttle losses. The controller structure is designed from a model-based approach, where the electric motors and associated drives are operated in speed control modes. A sum and load pressure decoupling control structure is proposed, enabling the use of SISO control design for the pressure level and the load pressure separately. For the latter, a cascaded hydraulic drive controller structure is proposed, where the inner loop consists of a pressure controller, and the second and third loop consists of a velocity and position controller respectively. A method to smoothly switch from velocity to pressure control is furthermore proposed. Experimental results comparing injection cycles of an industrial injection moulding machine and the retrofitted injection drive and proposed control are presented.","author_count":6,"contributors":["Hertz, Rasmus Aagaard","Therkelsen, Ole","Kristiansen, Søren","Christensen, Jesper Kjærsgaard","Hansson, Frederik Agervig","Schmidt, Lasse"],"cuid":["S01-000.00-705167"],"filters":{"added":"2024-02","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Injection moulding","electro hydraulic variable speed drive"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-LEGO"],"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-PR-LEGO","DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"control of hydraulic injection moulding machine with electro hydraulic variable speed drive","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1115/FPMC2023-111497","version":"Published Version"},"funding_acknowledgement":["This work is funded by LEGO System A/S."],"id":"S01-000.00-705167","identifier":[{"id":"85179629413","type":"scopus"}],"ids":["aau-4e2b3ed9-9d88-4260-a890-450b46e3309b"],"keyword":["electro-hydraulic variable-speed drive","injection moulding","motion and pressure control","reference switchover"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-D7D8E062D3AC47BA60B9EFA80E611D0F"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1115/FPMC2023-111497","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/650497463/v001t01a026-fpmc2023-111497.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"lego","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-LEGO","l3nn":"LEGO","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"LEGO","namevar":["LEGO Systems AS"],"nora_code":"DI-PR-LEGO","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, AAU Energy"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Rasmus Aagaard","key":"hertzpau","last":"Hertz","name":"Hertz, Rasmus Aagaard","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ole","key":"therkelsenpau","last":"Therkelsen","name":"Therkelsen, Ole","rank":2,"rolecode":"pau"},{"affn