"key":"kühljørgentpau","last":"Kühl","name":"Kühl, Jørgen T.","rank":13,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Ilan E.","key":"raymondilanepau","last":"Raymond","name":"Raymond, Ilan E.","rank":14,"rolecode":"pau"},{"affno":"","first":"Ole P.","key":"kristiansenoleppau","last":"Kristiansen","name":"Kristiansen, Ole P.","rank":15,"rolecode":"pau"},{"affno":"2","first":"Ida H.","key":"svendsenidahpau","last":"Svendsen","name":"Svendsen, Ida H.","rank":16,"rolecode":"pau"},{"affno":"2","first":"M. H.","key":"domínguezvalllamoramhpau","last":"Domínguez Vall-Lamora","name":"Domínguez Vall-Lamora, M. H.","rank":17,"rolecode":"pau"},{"affno":"","first":"Charlotte","key":"kragelundcharlottepau","last":"Kragelund","name":"Kragelund, Charlotte","rank":18,"rolecode":"pau"},{"affno":"1","first":"Jens D.","key":"hovejensdahlgaardpau","last":"Hove","locid":"4ecfb416-ea53-418e-a6c3-ace7647318ea","name":"Hove, Jens Dahlgaard","name_org":"Hove, Jens D.","orcid":"0000-0002-5600-5623","rank":19,"rolecode":"pau"},{"affno":"1","first":"Tem","key":"jørgensentempau","last":"Jørgensen","locid":"85b44ee9-850d-4f16-8fab-2887e84794c7","name":"Jørgensen, Tem","rank":20,"rolecode":"pau"},{"affno":"1","first":"Gitte G.","key":"fornitzgittegleeruppau","last":"Fornitz","locid":"3aa56288-fe37-4d66-888e-f8d25ffdb830","name":"Fornitz, Gitte Gleerup","name_org":"Fornitz, Gitte G.","rank":21,"rolecode":"pau"},{"affno":"","first":"Rolf","key":"steffensenrolfpau","last":"Steffensen","name":"Steffensen, Rolf","rank":22,"rolecode":"pau"},{"affno":"","first":"Birgit","key":"jurlanderbirgitpau","last":"Jurlander","name":"Jurlander, Birgit","rank":23,"rolecode":"pau"},{"affno":"1","first":"Jawdat","key":"abdullajawdatpau","last":"Abdulla","locid":"90506a0f-e2cc-4235-9ccb-b04de2df199e","name":"Abdulla, Jawdat","rank":24,"rolecode":"pau"},{"affno":"2","first":"Stig","key":"lyngbækstigpau","last":"Lyngbæk","name":"Lyngbæk, Stig","rank":25,"rolecode":"pau"},{"affno":"3","first":"Hanne","key":"elminghannepau","last":"Elming","name":"Elming, Hanne","rank":26,"rolecode":"pau"},{"affno":"1","first":"Susette K.","key":"therkelsensusettekrohnpau","last":"Therkelsen","locid":"c2062c87-b4a0-456e-bc7c-87e44623e2b7","name":"Therkelsen, Susette Krohn","name_org":"Therkelsen, Susette K.","rank":27,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Susette K.","key":"therkelsensusettekpau","last":"Therkelsen","name":"Therkelsen, Susette K.","rank":27,"rolecode":"pau"},{"affno":"","first":"Erik","key":"jørgensenerikpau","last":"Jørgensen","name":"Jørgensen, Erik","rank":28,"rolecode":"pau"},{"affno":"2","first":"Lene","key":"kløvgaardlenepau","last":"Kløvgaard","name":"Kløvgaard, Lene","rank":29,"rolecode":"pau"},{"affno":"","first":"Lia E.","key":"bangliaepau","last":"Bang","name":"Bang, Lia E.","rank":30,"rolecode":"pau"},{"affno":"","first":"Steffen","key":"helqviststeffenpau","last":"Helqvist","name":"Helqvist, Steffen","rank":31,"rolecode":"pau"},{"affno":"","first":"Søren","key":"galatiussørenpau","last":"Galatius","name":"Galatius, Søren","rank":32,"rolecode":"pau"},{"affno":"2","first":"Frants","key":"pedersenfrantspau","last":"Pedersen","name":"Pedersen, Frants","rank":33,"rolecode":"pau"},{"affno":"","first":"Ulrik","key":"abildgaardulrikpau","last":"Abildgaard","name":"Abildgaard, Ulrik","rank":34,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"first":"Peter","key":"clemmensenpeterpau","last":"Clemmensen","locid":"9d67c649-c4b7-40c7-b55d-2498e86dacb7","name":"Clemmensen, Peter","rank":35,"rolecode":"pau"},{"affno":"2","first":"Kari","key":"saunamäkikaripau","last":"Saunamäki","name":"Saunamäki, Kari","rank":36,"rolecode":"pau"},{"affno":"1","first":"Lene","key":"holmvanglenepau","last":"Holmvang","locid":"54b8ef01-f8ed-4c49-a126-2109e2fd351f","name":"Holmvang, Lene","rank":37,"rolecode":"pau"},{"affno":"1","first":"Gunnar","key":"gislasongunnarpau","last":"Gislason","locid":"c0f678a6-eb13-49a3-9485-8fae1e72e2a1","name":"Gislason, Gunnar","rank":38,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Henning","key":"kelbækhenningpau","last":"Kelbæk","name":"Kelbæk, Henning","rank":39,"rolecode":"pau"},{"affno":"1","first":"Lars V.","key":"køberlarspau","last":"Køber","locid":"e3f0c57c-605a-431a-9c63-2213c46621e6","name":"Køber, Lars","name_org":"Køber, Lars V.","rank":40,"rolecode":"pau"}],"pmid":["33632478"],"pub":{"doi":"10.1016/j.jacc.2020.12.037","issn":["07351097","15583597"],"issn_org":["07351097"],"issue":"8","journal":"Journal of the American College of Cardiology","pages":"1044-1052","publisher":"Elsevier","status":"p","title":"Journal of the American College of Cardiology","volume":"77"},"review":"Peer Reviewed","scoID":["2-s2.0-85101040952"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region Zealand","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-f0400315-d16a-485f-a2ed-08ef0613f7e3","sdu-6061b4a7-30ad-408f-a803-5fa4f1c48163"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Prognostic Value of Coronary CT Angiography in Patients With Non–ST-Segment Elevation Acute Coronary Syndromes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-047273","year":"2021","yearsub":"2021"}
{"abstract":"BACKGROUND: In patients with non-ST-segment elevation acute coronary syndrome (NSTEACS), coronary pathology may range from structurally normal vessels to severe coronary artery disease. OBJECTIVES: The purpose of this study was to test if coronary computed tomography angiography (CTA) may be used to exclude coronary artery stenosis ≥50% in patients with NSTEACS. METHODS: The VERDICT (Very Early Versus Deferred Invasive Evaluation Using Computerized Tomography in Patients With Acute Coronary Syndromes) trial (NCT02061891) evaluated the outcome of patients with confirmed NSTEACS randomized 1:1 to very early (within 12 h) or standard (48 to 72 h) invasive coronary angiography (ICA). As an observational component of the trial, a clinically blinded coronary CTA was conducted prior to ICA in both groups. The primary endpoint was the ability of coronary CTA to rule out coronary artery stenosis (≥50% stenosis) in the entire population, expressed as the negative predictive value (NPV), using ICA as the reference standard. RESULTS: Coronary CTA was conducted in 1,023 patients-very early, 2.5 h (interquartile range [IQR]: 1.8 to 4.2 h), n = 583; and standard, 59.9 h (IQR: 38.9 to 86.7 h); n = 440 after the diagnosis of NSTEACS was made. A coronary stenosis ≥50% was found by coronary CTA in 68.9% and by ICA in 67.4% of the patients. Per-patient NPV of coronary CTA was 90.9% (95% confidence interval [CI]: 86.8% to 94.1%) and the positive predictive value, sensitivity, and specificity were 87.9% (95% CI: 85.3% to 90.1%), 96.5% (95% CI: 94.9% to 97.8%) and 72.4% (95% CI: 67.2% to 77.1%), respectively. NPV was not influenced by patient characteristics or clinical risk profile and was similar in the very early and the standard strategy group. CONCLUSIONS: Coronary CTA has a high diagnostic accuracy to rule out clinically significant coronary artery disease in patients with NSTEACS.","author_count":40,"contributors":["Linde, Jesper J","Kelbæk, Henning","Hansen, Thomas Fritz","Sigvardsen, Per E","Torp-Pedersen, Christian Tobias","Bech, Jan","Heitmann, Merete","Nielsen, Olav Wendelboe","Høfsten, Dan E.","Kühl, Jørgen T","Raymond, Ilan E","Kristiansen, Ole P","Svendsen, Ida H","Vall-Lamora, Maria H D","Kragelund, Charlotte","de Knegt, Martina","Hove, Jens Dahlgaard","Jørgensen, Tem","Fornitz, Gitte Gleerup","Steffensen, Rolf","Jurlander, Birgit","Abdulla, Jawdat","Lyngbæk, Stig","Elming, Hanne","Therkelsen, Susette Krohn","Jørgensen, Erik","Kløvgaard, Lene","Bang, Lia Evi","Hansen, Peter Riis","Helqvist, Steffen","Galatius, Søren","Pedersen, Frants","Abildgaard, Ulrik","Clemmensen, Peter","Saunamäki, Kari","Holmvang, Lene","Engstrøm, Thomas","Gislason, Gunnar","Køber, Lars","Kofoed, Klaus Fuglsang"],"cuid":["S01-000.00-441180"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Acute Coronary Syndrome diagnostic imaging","Aged","Computed Tomography Angiography","Coronary Angiography","Coronary Stenosis diagnostic imaging","Female","Humans","Male","Middle Aged","Predictive Value of Tests","Prospective Studies"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"coronary ct angiography in patients with non st segment elevation acute coronary syndrome","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Andet","type":"doi","url":"https://doi.org/10.1016/j.jacc.2019.12.012","version":"Published Version"},"id":"S01-000.00-441180","identifier":[{"id":"85078263838","type":"scopus"},{"id":"32029126","type":"pmid"}],"ids":["ku-4ff1457b-9469-47a8-860d-9e9e407bb061"],"keyword":["Acute Coronary Syndrome/diagnostic imaging","Aged","Computed Tomography Angiography","Coronary Angiography","Coronary Stenosis/diagnostic