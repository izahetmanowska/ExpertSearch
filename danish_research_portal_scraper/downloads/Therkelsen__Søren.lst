au"},{"affno":"1","corresponding":null,"country":"dk","first":"Cristina Toca","key":"perezpau","last":"Perez","locid":"4ad4f466-ee62-45af-bd3d-3bbadc185fd7","name":"Perez, Cristina Toca","orcid":"0000-0002-4182-1492","rank":3,"rolecode":"pau"}],"pub":{"pages":"89","status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-8a380607-0216-4918-9c57-090c0be8c00c"],"src":["AU Aarhus University"],"title":"Effektiv Byggeproduktion. Case: Bartholin","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-758194","year":"2023","yearsub":"2023"}
{"abstract":"Introduction: A high risk of gastrointestinal bleeding has been reported with the use of some direct oral anticoagulants (DOACs). This risk may be of particular concern in individuals with associated anaemia. The aim of this study is to investigate potential differences in the risks of gastrointestinal bleeding and stroke among the four available DOACs in patients with atrial fibrillation (AF) and moderate or severe anaemia. Materials and methods: All Danish patients diagnosed with incident AF who had a baseline haemoglobin measurement and subsequently initiated DOAC therapy between 2012 and 2021 were identified through administrative registries. Only patients with moderate or severe anaemia (N = 7269) were included and evaluated regarding the risk of hospitalization for gastrointestinal bleeding and stroke. Standardized absolute 1-year risks of stroke and gastrointestinal bleeding were calculated from multivariable Cox regression analyses. DOACs were compared pairwise RESULTS: Compared with apixaban, both dabigatran and rivaroxaban were associated with a significantly increased risk of gastrointestinal bleeding with standardized 1-year risk ratios of 1.73 (95 % confidence interval [CI], 1.10-2.35) and 1.56 (95 % CI, 1.18-1.93), respectively, while no significant difference was seen in the comparison of apixaban with edoxaban 1.32 (95 % CI, 0.41-2.32). No significant differences in gastrointestinal bleeding were observed with pairwise comparisons of dabigatran, rivaroxaban and edoxaban. Finally, no significant difference in stroke risk among the four DOACs was observed. Conclusion: In AF patients with moderate or severe anaemia, apixaban was associated with a significantly lower risk of gastrointestinal bleeding than dabigatran and rivaroxaban. No significant difference in stroke risk was observed across all four available DOACs.","author_count":8,"contributors":["Al-Hussainy, Nour Shaker Mouhammad Radha","Kragholm, Kristian","Lundbye-Christensen, Søren","Torp-Pedersen, Christian","Pareek, Manan","Therkelsen, Susette Krohn","Lip, Gregory Y H","Riahi, Sam"],"cuid":["S02-100.00-697718"],"filters":{"added":"2023-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, Non-EU","OECD"],"corresponding_author":["Al-Hussainy, Nour Shaker Mouhammad Radha"],"country":["United Kingdom"],"glorg":["All Global Affiliations","Liverpool Heart and Chest Hospital NHS Foundation Trust","Liverpool John Moores University","University of Liverpool"],"keyword":["Anaemia","Atrial fibrillation","Direct oral anticoagulants","Gastrointestinal bleeding","Stroke"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-NDR","DI-HO-ZEA"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-HO-NDR","DI-HO-ZEA","DI-U-AAU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"gastrointestinal bleeding with direct oral anticoagulants in patients with atrial fibrillation and anaemia","src":["aau","ku"],"src-code":["DI-U-AAU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.thromres.2023.10.013","version":"Published Version"},"id":"S02-100.00-697718","identifier":[{"id":"85175811444","type":"scopus"},{"id":"37939578","type":"pmid"}],"ids":["aau-61b12177-3091-454c-9439-9d536145e35f","ku-df69f9b1-5549-4542-83b9-c7812b4865c7"],"keyword":["Anaemia","Atrial fibrillation","Direct oral anticoagulants","Gastrointestinal bleeding","Stroke"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-FC99CB596FF23654BB3F162ABCD9890F"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.thromres.2023.10.013","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/37346741