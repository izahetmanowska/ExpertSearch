24,"rolecode":"pau"}],"pmid":["39887674"],"pub":{"doi":"10.1111/aas.14578","issn":["00015172"],"issue":"3","journal":"Acta Anaesthesiologica Scandinavica","paperid":"e14578","publisher":"Blackwell Munksgaard","status":"p","title":"Acta Anaesthesiologica Scandinavica","volume":"69"},"review":"Peer Reviewed","scoID":["2-s2.0-85216650191"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","North Denmark Region","Other Hospitals","Other Research","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark","capio privathospital"],"PST":["Published"]},"sid":["aau-05d84a4f-dd81-4eb8-bf1f-4cc4824e5104","ku-7cf01493-e179-4b5e-b23e-813a53320dfd","sdu-925b5685-305a-4bd6-bb63-2ab6a0fe008b"],"src":["AAU Aalborg University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"The adverse effects with ibuprofen after major orthopedic surgeries: A protocol for the PERISAFE randomized clinical trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-086.04-792763","year":"2025","yearsub":"2025"}
{"abstract":"A 1D model describing the dynamics of an injection moulding machine and the injection process is presented. The model describes an injection cylinder actuated by a dual-pump electro–hydraulic speed-variable drive and the filling, holding and cooling phases of the injection moulding process utilising amorphous polymers. The model is suggested as the foundation for the design of model-based pressure controllers of, e.g., the nozzle pressure. The focus is on using material, mould and machine properties to construct the model, making it possible to analyse and design the dynamic system prior to manufacturing hardware or conducting experiments. Both the presented model and the developed controller show good agreement with experimental results. The proposed method is general in nature and enables the design, analysis and evaluation of the machine, material and mould dynamics for controller design based solely on the physical properties of the system.","author_count":6,"contributors":["Hertz, Rasmus Aagaard","Therkelsen, Ole","Kristianen, Søren","Christensen, Jesper Kjærsgaard","Hansson, Frederik Agervig","Schmidt, Lasse"],"cuid":["S01-000.00-743424"],"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Controller design","Dynamic modelling","Experimental validation","Injection moulding","Process control"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-LEGO","DI-PR-OTH"],"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-PR-LEGO","DI-PR-OTH","DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"development and validation of a 000000000001d dynamic model of an injection moulding process and design of a model based nozzle pressure controller","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.3390/polym16101432","version":"Published Version"},"funding_acknowledgement":["This work is funded by LEGO System A/S."],"id":"S01-000.00-743424","identifier":[{"id":"85194244495","type":"scopus"}],"ids":["aau-f64ead7f-7acc-4b60-82f1-73f6718ab5ba"],"keyword":["controller design","dynamic modelling","experimental validation","injection moulding","nozzle pressure control","process control"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-7A790CA45FAEF5E903A43279768FDA0A"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.3390/polym16101432","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/721913552/polymers-16-01432.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"lego","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-LEGO","l3nn":"LEGO","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"LEGO","namevar":["LEGO Systems AS"],"nora_code":"DI-PR-LEGO","used":1},{"affno":"2","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["NGIN A/S"],"nora_code":"DI-PR-OTH","used":1},{"affno":"3","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, AAU Energy","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Fluid Power","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Mechatronic Systems"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Rasmus Aagaard","key":"hertzpau","last":"Hertz","name":"Hertz, Rasmus Aagaard","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ole","key":"therkelsenpau","last":"Therkelsen","name":"Therkelsen, Ole","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren","key":"kristianenpau","last":"Kristianen","name":"Kristianen, Søren","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper Kjærsgaard","key":"christensenpau","last":"Christensen","name":"Christensen, Jesper Kjærsgaard","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Frederik Agervig","key":"hanssonpau","last":"Hansson","name":"Hansson, Frederik Agervig","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Lasse","key":"schmidtpau","last":"Schmidt","locid":"34edf04c-3e18-4b9e-bf37-12d58bf242f3","name":"Schmidt, Lasse","orcid":"0000-0002-8002-1287","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.3390/polym16101432","issn":["20734360"],"issue":"10","journal":"Polymers","pages":"1-21","paperid":"1432","publisher":"MDPI AG","publisher_org":"M D P I AG","status":"p","title":"Polymers","volume":"16"},"review":"Peer Reviewed","scoID":["2-s2.0-85194244495"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Other Companies","Private Research","Universities","ngin a/s"],"PST":["Published"]},"sid":["aau-f64ead7f-7acc-4b60-82f1-73f6718ab5ba"],"src":["AAU Aalborg University"],"title":"Development and Validation of a 1D Dynamic Model of an Injection Moulding Process and Design of a Model-Based Nozzle Pressure Controller","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-743424","year":"2024","yearsub":"2024"}
{"abstract":"The low cost and precise tolerances of plastic injection moulded products are a major reason for the popularity of the manufacturing method. The tolerances are greatly influenced by the equipment, raw material and moulding process. One challenge is the raw material variation. This paper presents a production process using cycle based feedback of cycle mass, for control of part properties in the presence of material variation from dual sourcing. The part properties considered are part mass and outer dimensions. The process uses direct cycle mass feedback without additional process measurements in the proposed controller structure. The designed controller structure is tested in a multi-cavity mould while using raw materials from multiple vendors, encompassing five different grades. The results show a total decrease in part mass variance of approximately 50% and a decrease of length and width variance of approximately 40% compared to a moulding process with fixed settings.","author_count":6,"contributors":["Hertz, Rasmus Aagaard","Therkelsen, Ole","Kristiansen, Søren","Christensen, Jesper Kjærsgaard","Hansson, Frederik Agervig","Schmidt, Lasse"],"cuid":["S01-000.00-742893"],"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Injection moulding","Part mass","Quality control"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-LEGO","DI-PR-OTH"],"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-PR-LEGO","DI-PR-OTH","DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"cycle based control of injection moulding process in presence of material dual sourcing using mass feedback","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.3390/polym16131808","version":"Published Version"},"funding_acknowledgement":["This work is funded by LEGO System A/S."],"id":"S01-000.00-742893","identifier":[{"id":"85198409327","type":"scopus"},{"id":"39000663","type":"pmid"}],"ids":["aau-6cf229cf-3caf-4542-bbf7-29910e6bca35"],"keyword":["EWMA control","cycle mass feedback","d-EWMA control","injection moulding","material dual sourcing","material variation","part mass","part parameter control","quality control"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-67B790DA951B689E29AE0946436AD77B"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.3390/polym16131808","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/721904128/polymers-16-01808.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"lego","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-LEGO","l3nn":"LEGO","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"LEGO","namevar":["LEGO Systems AS"],"nora_code":"DI-PR-LEGO","used":1},{"affno":"2","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["NGIN A/S"],"nora_code":"DI-PR-OTH","used":1},{"affno":"3","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, AAU Energy","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Fluid Power","Aalborg University, The Faculty of Engineering and Science, AAU Energy, Mechatronic Systems"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Rasmus Aagaard","key":"hertzpau","last":"Hertz","name":"Hertz, Rasmus Aagaard","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ole","key":"therkelsenpau","last":"Therkelsen","name":"Therkelsen, Ole","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren","key":"kristiansenpau","last":"Kristiansen","name":"Kristiansen, Søren","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper Kjærsgaard","key":"christensenpau","last":"Christensen","name":"Christensen, Jesper Kjærsgaard","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Frederik Agervig","key":"hanssonpau","last":"Hansson","name":"Hansson, Frederik Agervig","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Lasse","key":"schmidtpau","last":"Schmidt","locid":"34edf04c-3e18-4b9e-bf37-12d58bf242f3","name":"Schmidt, Lasse","orcid":"0000-0002-8002-1287","rank":6,"rolecode":"pau"}],"pmid":["39000663"],"pub":{"doi":"10.3390/polym16131808","issn":["20734360"],"issue":"13","journal":"Polymers","pages":"1-17","paperid":"1808","publisher":"MDPI AG","publisher_org":"M D P I AG","status":"p","title":"Polymers","volume":"16"},"review":"Peer Reviewed","scoID":["2-s2.0-85198409327"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Other Companies","Private Research","Universities","ngin a/s"],"PST":["Published"]},"sid":["aau-6cf229cf-3caf-4542-bbf7-29910e6bca35"],"src":["AAU Aalborg University"],"title":"Cycle-Based Control of Injection Moulding Process in Presence of Material Dual Sourcing Using Mass Feedback","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-742893","year":"2024","yearsub":"2024"}
{"abstract":"This study is part of an ongoing research project that aims to understand workers' job satisfaction in the construction industry. For that, a survey was applied among construction workers in Denmark. This paper aims to identify the impact of Lean Construction on job satisfaction. Data from 2176 responses were analysed using framework analysis, shorting the answers into three categories: Lean knowledge; Lean application; and Lean operation, even though they declared not knowing Lean. The study investigated the impact of the different levels of Lean familiarity on job satisfaction within five aspects: Project progress; Management-employee relationship; Employee work monitoring; Workload; and Workflow. Findings indicate that only 15% of respondents have some knowledge of Lean concepts, with only 8% confirming its application. The strongest correlation (R=0.557) was found between the Lean practice of “organization attempt to keep workers informed” and the job satisfaction factor of “manager-worker relationship”. Allowing the workers to evolve and improve presented, also, a strong correlation with job satisfaction. The study highlights that Lean practices that lead or require Respect for People are the aspects that impact the most on job satisfaction. The results emphasize that implementing Lean principles effectively matters more than merely being familiar with them.","author_count":6,"contributors":["Perez, Cristina Toca","Madushanka, Malik","Loyola, Lorenzo","Ergul, Melisa","Salling, Stephanie Therkelsen","Wandahl, Søren"],"cuid":["S01-000.00-758413"],"event":{"end":"2024-07-05","place":"Auckland, nz","start":"2024-07-01","title":"32nd Annual Conference of the International Group for Lean Construction (IGLC32)","year":"2024"},"filters":{"added":"2024-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Communication","Job satisfaction","Survey"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"nr","rtype":["clu"],"sorti":"the impact of lean knowledge and lean operation on construction workers job satisfaction","src":["au"],"src-code":["DI-U-AU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Andet","type":"loc","url":"https://pure.au.dk/ws/files/400964785/Perez_et_al._2024_-_The_Impact_of_Lean_Knowledge_and_Lean_Operation_on_Construction_Workers_Job_Satisfaction.pdf","version":"Published Version"},"id":"S01-000.00-758413","identifier":[{"id":"105006451009","type":"scopus"}],"ids":["au-b648890e-b9fd-424b-827b-26cf73628e00"],"keyword":["Communication","Job satisfaction","Respect for people","Survey"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-3D35068BF7E5F6F360AA8F1355468DFD"],"oa_link":[{"access":"oa","license":"Andet","type":"loc","url":"https://pure.au.dk/ws/files/400964785/Perez_et_al._2024_-_The_Impact_of_Lean_Knowledge_and_Lean_Operation_on_Construction_Workers_Job_Satisfaction.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Civil and Architectural Engineering, Department of Civil and Architectural Engineering - Design and Construction"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Cristina Toca","key":"perezpau","last":"Perez","locid":"4ad4f466-ee62-45af-bd3d-3bbadc185fd7","name":"Perez, Cristina Toca","orcid":"0000-0002-4182-1492","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Malik","key":"madushankapau","last":"Madushanka","name":"Madushanka, Malik","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Lorenzo","key":"loyolapau","last":"Loyola","name":"Loyola, Lorenzo","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Melisa","key":"ergulpau","last":"Ergul","name":"Ergul, Melisa","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Stephanie Therkelsen","key":"sallingpau","last":"Salling","locid":"d0d5d6a4-75fc-4e33-bc26-93ffb6887c76","name":"Salling, Stephanie Therkelsen","orcid":"0000-0001-7088-6458","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren","key":"wandahlpau","last":"Wandahl","locid":"26a61cee-fb66-475b-9505-6e741352b7e6","name":"Wandahl, Søren","orcid":"0000-0001-8708-6035","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.24928/2024/0188","pages":"1195-1206","status":"p","title":"IGLC 32 - Auckland, New Zealand 2024","volume":"32"},"review":"No Review","scoID":["2-s2.0-105006451009"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-b648890e-b9fd-424b-827b-26cf73628e00"],"src":["AU Aarhus University"],"title":"The impact of Lean Knowledge and Lean Operation on construction workers’ job satisfaction.","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-758413","year":"2024","yearsub":"2024"}
