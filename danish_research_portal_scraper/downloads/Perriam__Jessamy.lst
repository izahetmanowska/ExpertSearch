dh"}],"pub":{"doi":"10.1515/9783110787641","eisbn":["9783110787641"],"isbn":["9783110787603"],"pages":"9-29","publisher":"De Gruyter","status":"p","subtitle":"Intersections, Implications and Interventions","title":"Digitalization in Practice"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-b41be476-62b8-4f21-9e5c-4c4ed33199b4"],"src":["ITU IT University of Copenhagen"],"title":"Between bureaucracy and agility: the quiet transformation of the Danish digital state","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-747258","year":"2024","yearsub":"2024"}
{"abstract":"China’s data governance has recently caught international attention with its newly launched National Data Bureau. As China appears as a powerful data state on the global stage, its data governance presents a puzzling picture of interests between economic development, national security, and social justice, each demanding a different form of control, raising questions on the approach of Chinese state in the data domain. This chapter provides an account of China as a data state through its recent policies, regulations and their implementations. We argue that China’s data state is not a monolithic top-down machine of control. Rather it is dynamic across contexts, with deliberate efforts to embrace different forms of data politics, that is contentious politics and institutional politics. This chapter serves as an exploratory effort of constructing a potential typology of data state by identifying two data logics (i.e., data as strategic assets and data as commons) that drive the building of China as a data state. We propose three future research directions to further this line of research by calling for a holistic perspective on China as a data state, comparison studies between China and other states’ practices in the data domain, and more in-depth investigation into the relationship between state, public sector and tech giants.","author_count":4,"contributors":["Wang, Cancan","Liu, Chunrong"],"cuid":["S01-000.00-764507"],"filters":{"added":"2024-11","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Asia, East","Europe, Non-EU","Nordic","OECD"],"country":["China","Norway"],"glorg":["All Global Affiliations","Fudan University","University of Oslo"],"keyword":["China","Data governance","Digitalization"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"one data state two data logics unfolding china s data governance","src":["itu"],"src-code":["DI-U-ITU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/106632860/Chapter_Data_Logics_PreEdit.pdf","version":"Authors Final Version"},"id":"S01-000.00-764507","ids":["itu-82c33291-32eb-4204-845e-1748c1708ae6"],"keyword":["China","Data governance","Data logics","Digitalization"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-B1619EB07C83A4BA7F88C12157C0A49F"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/106632860/Chapter_Data_Logics_PreEdit.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Center for Climate IT","IT University of Copenhagen, Center for Digital Welfare","IT University of Copenhagen, Digitalization, Democracy, and Governance, REFLACT"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"cn","key":"fudan university","loc":["China","Asia, East"],"name":"Fudan University","used":1},{"affno":"3","country":"no","key":"university of oslo","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"University of Oslo","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Cancan","key":"wangpau","last":"Wang","locid":"605b59ab-91b4-4f8e-bb12-df68ce0491c5","name":"Wang, Cancan","orcid":"0000-0002-9065-6884","rank":1,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Chunrong","key":"liupau","last":"Liu","name":"Liu, Chunrong","rank":2,"rolecode":"pau"},{"affno":"","first":"Jessamy","key":"perriampedh","last":"Perriam","name":"Perriam, Jessamy","rank":3,"role":"Editor of Ho