,"name":"Joosten, Max","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Josien P.W.","key":"pluimpau","last":"Pluim","name":"Pluim, Josien P.W.","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Veronika","key":"cheplyginapau","last":"Cheplygina","locid":"1c4bfd79-4336-4b17-a672-9acb465f15c0","name":"Cheplygina, Veronika","orcid":"0000-0003-0176-9324","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.59275/j.melba.2021-geb9","issn":["2766905X"],"journal":"The Journal of Machine Learning for Biomedical Imaging","status":"p","title":"The Journal of Machine Learning for Biomedical Imaging","title_org":"Machine Learning for Biomedical Imaging","volume":"1"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-d487e591-f08e-44cb-8458-c1dde623c40e"],"src":["ITU IT University of Copenhagen"],"title":"ENHANCE (ENriching Health data by ANnotations of Crowd and Experts): A case study for skin lesion classification","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384395","year":"2021","yearsub":"2021"}
