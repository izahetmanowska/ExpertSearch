093-5806","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Eric","key":"vanwykpau","last":"Van Wyk","name":"Van Wyk, Eric","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.scico.2013.09.009","issn":["01676423","18727964"],"issn_org":["01676423"],"journal":"Science of Computer Programming","pages":"1","publisher":"Elsevier","status":"p","title":"Science of Computer Programming","volume":"87"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-c61b2c18-a23d-41ce-8a85-a0d15a7f4e89"],"src":["ITU IT University of Copenhagen"],"title":"Preface to the Special Section on Language Descriptions, Tools, and Applications (LDTA 2011)","type":"Editorial","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384172","year":"2014","yearsub":"2014"}
{"abstract":"Feature-sensitive verification is a recent field that pursues the effective analysis of the exponential number of variants of a program family. Today researchers lack examples of concrete bugs induced by variability, and occurring in real large-scale software. Such a collection of bugs is a requirement for goal-oriented research, serving to evaluate tool implementations of feature-sensitive analyses by testing them on real bugs. We present a qualitative study of 40 variability bugs collected from bug-fixing commits to the Linux kernel repository. We investigate each of the 40 bugs, recording the outcome of our analysis into a database. In addition, we provide self-contained simplified C99 versions of the bugs, facilitating understanding and tool evaluation. Our study provides insights about the nature and occurrence of variability bugs in a large C software system, and shows in what ways variability affects and increases the complexity of software bugs.","author_count":3,"contributors":["Abal Rivas, Iago","Brabrand, Claus","Wasowski, Andrzej"],"cuid":["S01-000.00-381478"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Bug Analysis","Feature Sensitive Verification","Linux kernel","Software Complexity","Variability Bugs"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"nr","rtype":["clu"],"sorti":"000000000040 variability bugs in the linux kernel a qualitative study","src":["itu"],"src-code":["DI-U-ITU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/74775263/ITU_TR_2014_180.pdf","version":"Pre-print"},"id":"S01-000.00-381478","ids":["itu-0e49901a-4f89-4a2e-a2bd-be21da8efe97"],"keyword":["Bug Analysis","Feature-Sensitive Verification","Linux Kernel","Software Complexity","Variability Bugs"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-721811C6D70301D37671B4EE30CB2591"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/74775263/ITU_TR_2014_180.pdf","version":"Pre-print"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["The Department, Software & Systems"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Iago","key":"abalrivaspau","last":"Abal Rivas","name":"Abal Rivas, Iago","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Claus","key":"brabrandpau","last":"Brabrand","locid":"47a94200-3abe-4354-b5e3-c8ef6f1ba1f2","name":"Brabrand, Claus","orcid":"0000-0001-5093-5806","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":3,"rolecode":"pau"}],"pub":{"issn":["16006100"],"issue":"TR-2014-180","pages":"20","place":"Copenhagen","publisher":"IT-Universitetet i København","repno":"IT University Technical Report Series, TR-2014-180","series":"IT University Technical Report Series","status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-0e49901a-4f89-4a2e-a2bd-be21da8efe97"],"src":["ITU IT University of Copenhagen"],"title":"40 Variability Bugs in the Linux Kernel : A Qualitative Study","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381478","year":"2014","yearsub":"2014"}
{"abstract":"Software product lines (SPLs) developed using annotative approaches such as conditional compilation come with an inherent risk of constructing erroneous products. For this reason, it is essential to be able to analyze such SPLs. However, as dataflow analysis techniques are not able to deal with SPLs, developers must generate and analyze all valid products individually, which is expensive for non-trivial SPLs. In this paper, we demonstrate how to take any standard intraprocedural dataflow analysis and automatically turn it into a feature-sensitive dataflow analysis in five different ways where the last is a combination of the other four. All analyses are capable of analyzing all valid products of an SPL without having to generate all of them explicitly. We have implemented all analyses using SOOT's intraprocedural dataflow analysis framework and experimentally evaluated four of them according to their performance and memory characteristics on five qualitatively different SPLs. On our benchmarks, the combined analysis strategy is up to almost eight times faster than the brute-force approach.","author_count":8,"contributors":["Brabrand, Claus","Ribeiro, Márcio","Tolêdo, Társis","Winther, Johnni","Borba, Paulo"],"cuid":["S01-000.00-185717"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, South"],"corresponding_author":["Brabrand, Claus"],"country":["Brazil"],"glorg":["All Global Affiliations","Universidade Federal de Pernambuco"],"keyword":["Dataflow analysis","Software product lines"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-ITU"]},"level3all":["DI-U-AU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"intraprocedural dataflow analysis for software product lines","src":["au"],"src-code":["DI-U-AU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-3-642-36964-3_3","version":"Other Version"},"id":"S01-000.00-185717","identifier":[{"id":"84875101500","type":"scopus"}],"ids":["au-62c50454-1f42-4c39-b0b0-582fbbc6efa8"],"keyword":["Dataflow Analysis","Software Product Lines"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-1D1A1A87D0D2ABA270C5E068BECB8CE9"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-3-642-36964-3_3","version":"Other Version"},{"access":"oa","type":"rem","url":"http://www.scopus.com/inward/record.url?scp=84875101500&partnerID=8YFLogxK","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"br","key":"universidade federal de pernambuco","loc":["Brazil","America, South"],"name":"Universidade Federal de Pernambuco","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Computer Science"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Claus","key":"brabrandpau","last":"Brabrand","name":"Brabrand, Claus","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Márcio","key":"ribeiropau","last":"Ribeiro","name":"Ribeiro, Márcio","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Társis","key":"tolêdopau","last":"Tolêdo","name":"Tolêdo, Társis","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Johnni","key":"wintherpau","last":"Winther","locid":"29cd4031-0d0b-4180-a591-ef8473a9758a","name":"Winther, Johnni","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Paulo","key":"borbapau","last":"Borba","name":"Borba, Paulo","rank":5,"rolecode":"pau"},{"affno":"","first":"Gary T.","key":"leavenspedh","last":"Leavens","name":"Leavens, Gary T.","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Shigeru","key":"chibapedh","last":"Chiba","name":"Chiba, Shigeru","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Éric","key":"tanterpedh","last":"Tanter","name":"Tanter, Éric","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-642-36964-3_3","eisbn":["9783642369643"],"isbn":["9783642369636"],"issn":["03029743"],"pages":"73-108","publisher":"Springer VS","series":"Lecture Notes in Computer Science","status":"p","title":"Transactions on Aspect-Oriented Software Development X"},"review":"Peer Reviewed","scoID":["2-s2.0-84875101500"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["au-62c50454-1f42-4c39-b0b0-582fbbc6efa8"],"src":["AU Aarhus University"],"title":"Intraprocedural dataflow analysis for software product lines","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-185717","year":"2013","yearsub":"2013"}
{"abstract":"We propose an algebra of languages and transformations as a means of compositional syntactic language extension. The algebra provides a layer of high-level abstractions built on top of languages (captured by context-free grammars) and transformations (captured by constructive catamorphisms). The algebra is self-contained in that any term of the algebra specifying a transformation can be reduced to a constant catamorphism, before the transfor- mation is run. Thus, the algebra comes “for free” without sacrificing the strong safety and efficiency properties of constructive catamorphisms. The entire algebra as presented in the paper is implemented as the Banana Algebra Tool which may be used to syntactically extend languages in an incremental and modular fashion via algebraic composition of previously defined languages and transformations. We demonstrate and evaluate the tool via several kinds of extensions.","author_count":3,"contributors":["Andersen, Jacob","Brabrand, Claus","Christiansen, David Raymond"],"cuid":["S02-100.00-012882"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Languages transformation syntactic extension macros context free grammars catamorphisms bananas algebra"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GTS","DI-U"],"level3":{"GTS":["DI-GTS-ALL","DI-GTS-ALX"],"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-GTS-ALX","DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"banana algebra compositional syntactic language extension","src":["au","itu"],"src-code":["DI-U-AU","DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.scico.2012.11.004","version":"Published Version"},"id":"S02-100.00-012882","identifier":[{"id":"84880309849","type":"scopus"}],"ids":["au-03e9683f-37ec-4368-b9b8-119513dba420","itu-12fb5b76-6621-4330-82f7-7a7fab961435"],"keyword":["Languages; transformation; syntactic extension; macros; context-free grammars; catamorphisms; bananas; algebra."],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-1D8157F1882D3FEFE30F22C2A9864870"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.scico.2012.11.004","version":"Other Version"},{"access":"oa","type":"rem","url":"http://www.sciencedirect.com/science/article/pii/S0167642312002110","version":"Published Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"alexandra institute","l2":"DI-GTS","l2n":"GTS Institutes","l3":"DI-GTS-ALX","l3nn":"Alexandra Institute","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Alexandra Institute","namevar":["Alexandra Instituttet A/S"],"nora_code":"DI-GTS-ALX","used":1},{"affno":"2","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"3","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","The Department, Software & Systems","The Department, Theoretical Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"Jacob","key":"andersenpau","last":"Andersen","locid":"6a2eb103-1f3b-49e2-b413-aec23fffdd7e","name":"Andersen, Jacob","rank":1,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Claus","key":"brabrandpau","last":"Brabrand","locid":"47a94200-3abe-4354-b5e3-c8ef6f1ba1f2","name":"Brabrand, Claus","orcid":"0000-0001-5093-5806","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"David Raymond","key":"christiansenpau","last":"Christiansen","name":"Christiansen, David Raymond","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.scico.2012.11.004","issn":["01676423","18727964"],"issn_org":["01676423"],"issue":"10","journal":"Science of Computer Programming","pages":"1845-1870","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"p","title":"Science of Computer Programming","volume":"78"},"review":"Peer Reviewed","scoID":["2-s2.0-84880309849"],"search":{"DAF":["All Danish Affiliations","All GTS Institutes","All Universities","DI-ALL","DI-GTS","DI-GTS-ALL","DI-U","DI-U-ALL","GTS Institutes","IT University of Copenhagen","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-03e9683f-37ec-4368-b9b8-119513dba420","itu-12fb5b76-6621-4330-82f7-7a7fab961435"],"src":["AU Aarhus University","ITU IT University of Copenhagen"],"title":"Banana Algebra: Compositional Syntactic Language Extension","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-012882","year":"2013","yearsub":"2013"}
{"abstract":"Software product lines (SPLs) developed using annotative approaches such as conditional compilation come with an inherent risk of constructing erroneous products. For this reason, it is essential to be able to analyze such SPLs. However, as dataﬂow analysis techniques are not able to deal with SPLs, developers must generate and analyze all valid products individually, which is expensive for non-trivial SPLs. In this paper, we demonstrate how to take any standard intraprocedural dataﬂow analysis and automatically turn it into a feature-sensitive dataﬂow analysis in ﬁve diﬀerent ways where the last is a combination of the other four. All analyses are capable of analyzing all valid products of an SPL without having to generate all of them explicitly. We have implemented all analyses using SOOT’s intraprocedural dataﬂow analysis framework and experimentally evaluated four of them according to their performance and memory characteristics on ﬁve qualitatively diﬀerent SPLs. On our benchmarks, the combined analysis strategy is up to almost eight times faster than the brute-force approach.","author_count":5,"contributors":["Brabrand, Claus","Ribeiro, Márcio","Tolêdo, Társis","Winther, Johnni","Borba, Paulo"],"cuid":["S01-000.00-381684"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, South"],"country":["Brazil"],"glorg":["All Global Affiliations","Federal University of Pernambuco"],"keyword":["Dataﬂow Analysis","Software product lines"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-KU"]},"level3all":["DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"intraprocedural dataflow analysis for software product lines","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84875101500","version":"Other Version"},"id":"S01-000.00-381684","identifier":[{"id":"84875101500","type":"scopus"}],"ids":["itu-1bd6e7a8-eef1-4947-8da6-479114ca7b56"],"keyword":["Dataﬂow Analysis","Software Product Lines"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-5-C964807F7DAD8640A4A3ECDF6C16FD9D"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","The Department, Software & Systems","The Department, Theoretical Computer Science"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"br","key":"federal university of pernambuco","loc":["Brazil","America, South"],"name":"Federal University of Pernambuco","used":1},{"affno":"3","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Claus","key":"brabrandpau","last":"Brabrand","locid":"47a94200-3abe-4354-b5e3-c8ef6f1ba1f2","name":"Brabrand, Claus","orcid":"0000-0001-5093-5806","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Márcio","key":"ribeiropau","last":"Ribeiro","name":"Ribeiro, Márcio","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Társis","key":"tolêdopau","last":"Tolêdo","name":"Tolêdo, Társis","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Johnni","key":"wintherpau","last":"Winther","name":"Winther, Johnni","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Paulo","key":"borbapau","last":"Borba","name":"Borba, Paulo","rank":5,"rolecode":"pau"}],"pub":{"isbn":["9781450310925"],"issn":["00000038"],"pages":"13-24","publisher":"Association for Computing Machinery","series":"Transactions on Aspect-Oriented Software Development","status":"p","title":"AOSD '12 Proceedings of the 11th annual international conference on Aspect-oriented Software Development"},"review":"Peer Reviewed","scoID":["2-s2.0-84860443937"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["itu-1bd6e7a8-eef1-4947-8da6-479114ca7b56"],"src":["ITU IT University of Copenhagen"],"title":"Intraprocedural Dataflow Analysis for Software Product Lines","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381684","year":"2013","yearsub":"2013"}
{"abstract":"A software product line (SPL) encodes a potentially large variety of software products as variants of some common code base. Up until now, re-using traditional static analyses for SPLs was virtually intractable, as it required programmers to generate and analyze all products individually. In this work, however, we show how an important class of existing inter-procedural static analyses can be transparently lifted to SPLs. Without requiring programmers to change a single line of code, our approach SPLLIFT automatically converts any analysis formulated for traditional programs within the popular IFDS framework for inter-procedural, ﬁnite, distributive, subset problems to an SPL-aware analysis formulated in the IDE framework, a well-known extension to IFDS. Using a full implementation based on Heros, Soot, CIDE and JavaBDD, we show that with SPLLIFT one can reuse IFDS-based analyses without changing a single line of code. Through experiments using three static analyses applied to four Java-based product lines, we were able to show that our approach produces correct results and outperforms the traditional approach by several orders of magnitude.","author_count":6,"contributors":["Bodden, Eric","Tolêdo, Társis","Ribeiro, Márcio","Brabrand, Claus","Borba, Paulo","Mezini, Mira"],"cuid":["S01-000.00-381418"],"event":{"end":"2013-06-22","place":"Seattle, WA, us","start":"2013-06-16","title":"ACM SIGPLAN Conference on Programming language design and implementation","year":"2013"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, South","Europe, EU","OECD"],"country":["Brazil","Germany"],"glorg":["All Global Affiliations","Darmstadt University of Technology","Federal University of Pernambuco"],"keyword":["Context sensitive","Software product lines","inter procedural static analysis","ﬂow sensitive"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"spl sup lift sup statically analyzing software product lines in minutes instead of years","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1145/2491956.2491976","version":"Other Version"},"id":"S01-000.00-381418","identifier":[{"id":"84883087403","type":"scopus"}],"ids":["itu-0ac25813-c16d-492f-871f-12b685e52a79"],"keyword":["Software product lines","context sensitive","inter-procedural static analysis","ﬂow sensitive"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-D0CF9C6B7BB3F554EA3B2E5016362906"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1145/2491956.2491976","version":"Other Version"}],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","country":"de","key":"darmstadt university of technology","loc":["Germany","Europe, EU","OECD"],"name":"Darmstadt University of Technology","used":1},{"affno":"2","country":"br","key":"federal university of pernambuco","loc":["Brazil","America, South"],"name":"Federal University of Pernambuco","used":1},{"affno":"3","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","The Department, Software & Systems","The Department, Theoretical Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Eric","key":"boddenpau","last":"Bodden","name":"Bodden, Eric","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Társis","key":"tolêdopau","last":"Tolêdo","name":"Tolêdo, Társis","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Márcio","key":"ribeiropau","last":"Ribeiro","name":"Ribeiro, Márcio","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Claus","key":"brabrandpau","last":"Brabrand","locid":"47a94200-3abe-4354-b5e3-c8ef6f1ba1f2","name":"Brabrand, Claus","orcid":"0000-0001-5093-5806","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Paulo","key":"borbapau","last":"Borba","name":"Borba, Paulo","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mira","key":"mezinipau","last":"Mezini","name":"Mezini, Mira","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1145/2491956.2491976","issn":["15232867"],"issue":"6","journal":"ACM / SIGPLAN Notices","pages":"355-364","publisher":"Association for Computing Machinery","status":"p","title":"ACM / SIGPLAN Notices","title_org":"A C M / S I G P L A N Notices","volume":"48"},"review":"Peer Reviewed","scoID":["2-s2.0-84883087403"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-0ac25813-c16d-492f-871f-12b685e52a79"],"src":["ITU IT University of Copenhagen"],"title":"SPL<sup>LIFT</sup>: Statically Analyzing Software Product Lines in Minutes instead of Years","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381418","year":"2013","yearsub":"2013"}
{"author_count":4,"contributors":["Brabrand, Claus","Ribeiro, Marcio","Toledo, Tarsis","Borba, Paulo"],"cuid":["S01-000.00-381975"],"event":{"end":"2012-03-30","place":"Potsdam, de","start":"2012-03-25","title":"AOSD 2012","year":"2012"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, South"],"country":["Brazil"],"glorg":["All Global Affiliations","Federal University of Pernambuco"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"intraprocedural dataflow analysis for software product lines","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1145/2162049.2162052","version":"Other Version"},"id":"S01-000.00-381975","identifier":[{"id":"84860443937","type":"scopus"}],"ids":["itu-3013ac17-0126-4618-8cad-0ef89903bd8f"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-5-C964807F7DAD8640A4A3ECDF6C16FD9D"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1145/2162049.2162052","version":"Other Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","The Department, Software & Systems","The Department, Theoretical Computer Science"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"br","key":"federal university of pernambuco","loc":["Brazil","America, South"],"name":"Federal University of Pernambuco","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Claus","key":"brabrandpau","last":"Brabrand","locid":"47a94200-3abe-4354-b5e3-c8ef6f1ba1f2","name":"Brabrand, Claus","orcid":"0000-0001-5093-5806","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Marcio","key":"ribeiropau","last":"Ribeiro","name":"Ribeiro, Marcio","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Tarsis","key":"toledopau","last":"Toledo","name":"Toledo, Tarsis","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Paulo","key":"borbapau","last":"Borba","name":"Borba, Paulo","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1145/2162049.2162052","isbn":["9781450310925"],"pages":"13-24","publisher":"Association for Computing Machinery","series":"AOSD - Proceedings of the annual international conference on Aspect-oriented Software Development","status":"p","title":"AOSD '12 Proceedings of the 11th annual international conference on Aspect-oriented Software"},"review":"Peer Reviewed","scoID":["2-s2.0-84860443937"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-3013ac17-0126-4618-8cad-0ef89903bd8f"],"src":["ITU IT University of Copenhagen"],"title":"Intraprocedural Dataflow Analysis for Software Product Lines","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381975","year":"2012","yearsub":"2013"}
{"abstract":"When maintaining a feature in preprocessor-based Software Product Lines (SPLs), developers are susceptible to introduce problems into other features. This is possible because features eventually share elements (like variables and methods) with the maintained one. This scenario might be even worse when hiding features by using techniques like Virtual Separation of Concerns (VSoC), since developers cannot see the feature dependencies and, consequently, they become unaware of them. Emergent Interfaces was proposed to minimize this problem by capturing feature dependencies and then providing information about other features that can be impacted during a maintenance task. In this paper, we present Emergo, a tool capable of computing emergent interfaces between the feature we are maintaining and the others. Emergo relies on feature-sensitive dataflow analyses in the sense it takes features and the SPL feature model into consideration when computing the interfaces.","author_count":5,"contributors":["Ribeiro, Márcio","Tolêdo, Társis","Winther, Johnni","Brabrand, Claus","Borba, Paulo"],"cuid":["S02-091.25-024871"],"event":{"acronym":"AOSD","end":"2012-03-30","place":"Potsdam, de","start":"2012-03-25","title":"Annual International Conference on Aspect-oriented Software Development Companion","year":"2012"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"continent":["America, South"],"country":["Brazil"],"glorg":["All Global Affiliations","Federal University of Pernambuco","Universidade Federal de Pernambuco"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-ITU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-ITU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"emergo a tool for improving maintainability of preprocessor based product lines","src":["au","itu"],"src-code":["DI-U-AU","DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1145/2162110.2162128","version":"Other Version"},"id":"S02-091.25-024871","identifier":[{"id":"84860442262","type":"scopus"}],"ids":["au-a700b9f4-dc31-4896-a56a-a2b8c34f10eb","itu-6b599828-16ff-479e-b866-27a36f8bbe08"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-4893C3D59569DC408044CDAF9CA90313"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1145/2162110.2162128","version":"Other Version"}],"org":[{"affno":"1","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1},{"affno":"2","country":"br","key":"federal university of pernambuco","loc":["Brazil","America, South"],"name":"Federal University of Pernambuco","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Natural Sciences, Department of Computer Science"],"nora_code":"DI-U-AU","used":1},{"affno":"4","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"5","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","The Department, Software & Systems","The Department, Theoretical Computer Science"],"nora_code":"DI-U-ITU","used":1},{"affno":"6","country":"br","key":"universidade federal de pernambuco","loc":["Brazil","America, South"],"name":"Universidade Federal de Pernambuco","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Márcio","key":"ribeiropau","last":"Ribeiro","name":"Ribeiro, Márcio","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Társis","key":"tolêdopau","last":"Tolêdo","name":"Tolêdo, Társis","rank":2,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Johnni","key":"wintherpau","last":"Winther","locid":"29cd4031-0d0b-4180-a591-ef8473a9758a","name":"Winther, Johnni","rank":3,"rolecode":"pau"},{"affno":"5 4","corresponding":null,"first":"Claus","key":"brabrandpau","last":"Brabrand","locid":"47a94200-3abe-4354-b5e3-c8ef6f1ba1f2","name":"Brabrand, Claus","orcid":"0000-0001-5093-5806","rank":4,"rolecode":"pau"},{"affno":"6 2","corresponding":null,"first":"Paulo","key":"borbapau","last":"Borba","name":"Borba, Paulo","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1145/2162110.2162128","isbn":["9781450312226"],"pages":"23-26","publisher":"Association for Computing Machinery","status":"p","title":"Proceedings of the 11th annual international conference on Aspect-oriented Software Development Companion, AOSD Companion '12"},"review":"Peer Reviewed","scoID":["2-s2.0-84860442262"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-a700b9f4-dc31-4896-a56a-a2b8c34f10eb","itu-6b599828-16ff-479e-b866-27a36f8bbe08"],"src":["AU Aarhus University","ITU IT University of Copenhagen"],"title":"Emergo: a Tool for Improving Maintainability of Preprocessor-based Product Lines","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-091.25-024871","year":"2012","yearsub":"2012"}
{"abstract":"We present WebSelF, a framework for web scraping which models the process of web scraping and decomposes it into four conceptually independent, reusable, and composable constituents. We have validated our framework through a full parameterized implementation that is flexible enough to capture previous work on web scraping. We conducted an experiment that evaluated several qualitatively different web scraping constituents (including previous work and combinations hereof) on about 11,000 HTML pages on daily versions of 17 web sites over a period of more than one year. Our framework solves three concrete problems with current web scraping and our experimental results indicate that composition of previous and our new techniques achieve a higher degree of accuracy, precision and specificity than existing techniques alone.","author_count":4,"contributors":["Thomsen, Jakob Grauenkjær","Ernst, Erik","Brabrand, Claus","Schwartzbach, Michael I."],"cuid":["S01-000.00-205976"],"event":{"acronym":"ICWE","end":"2012-07-27","place":"Berlin, de","start":"2012-07-23","title":"International Conference on Web Engineering","year":"2012"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"webself a web scraping framework","src":["au"],"src-code":["DI-U-AU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-3-642-31753-8_28","version":"Other Version"},"id":"S01-000.00-205976","identifier":[{"id":"84865127006","type":"scopus"}],"ids":["au-8645d782-2da8-4f7c-b22d-e0a8957a1af0"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-5-142FCE4FF31D3B4EBCDD1453B4836FC0"],"oa_link":[{"