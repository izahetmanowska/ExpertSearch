-3257-46ca-acaf-43f24daa2d9c","ku-7d23a890-0788-4544-82ca-8eee1b486ac2","pha-1ece496b-5553-45ed-ab66-35b571035841","ucn-5588f35f-9dbb-42a6-b56d-2d86b4196ddc","ucsyd-dda2e28e-5c79-416c-b55c-20372560a625","via-e0517321-5031-416b-8762-7b08f124360b"],"src":["AB University College Absalon","AU Aarhus University","KP University College Copenhagen","KU University of Copenhagen","UC SYD University College South Denmark","UCN University College of Northern Denmark","VIA University College"],"title":"Anbefalinger til indførsel af teknologiforståelse i uddannelse af lærere og andet pædagogisk personale : Slutleverance i 3. spor af forsøgsprogrammet for teknologiforståelse i folkeskolens obligatoriske undervisning","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S07-094.02-742101","year":"2022","yearsub":"2022"}
{"abstract":"There is a strong need for a more equal gender balance within the computing field. In 1998, Richard A. Lippa [29] uncovered a relationship between gender and preference within the People–Things spectrum, with women preferring People-oriented activities to a higher degree than men. The aim of this paper is twofold. First of all, we wish to determine if a similar relation can be established in the particular context of computing educational activities. Second of all, we wish to see if Lippa’s findings can be extrapolated to contemporary high-school students. To do that, we designed and conducted an experiment involving around 500 Danish high-school students who have been asked to choose between a People-themed version vs an isomorphic Things-themed version of four activities representative for computing education. The results show that the odds of a woman preferring a task involving People is 2.7 times higher than those of a man. The odds of a student without prior programming experience preferring a task involving People is 1.4 times higher than those of a student with programming experience. If we compare women without programming experience to men with programming experience the effect is even more pronounced; indeed, the combined effect is 3.8 (2.7 × 1.4). Our study implies a recommendation for computing educators to, whenever possible, favor educational activities involving People over Things. This makes educational activities appeal more to female students (and to students without programming experience), while not making a difference for male students (or students with programming experience). Since the experiment measured only the appeal of tasks (the users were not expected to perform them) the results we obtained can be useful for recruitment processes where the overall image and appeal of material makes a difference.","author_count":5,"contributors":["Christensen, Ingrid Maria","Høegh Marcher, Melissa","Grabarczyk, Pawel","Graversen, Therese","Brabrand, Claus"],"cuid":["S01-000.00-383725"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Computing education","Gender Balance in Computing","High school students","People Things Spectrum","Preference and Programming Experience"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"computing educational activities involving people rather than things appeal more to women recruitment perspective","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86567026/ICER_2021_Recruitment_1_.pdf","version":"Other Version"},"id":"S01-000.00-383725","identifier":[{"id":"85113627549","type":"scopus"}],"ids":["itu-a8d8e430-fda3-4b6d-ab6a-4fbab8b40b3a"],"keyword":["Computing Education","Gender Balance in Computing","High-school Students","People–Things Spectrum","Preference and Programming Experience"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-AC61CE49D6E2518FF9B8594A90ED65FE"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86567026/ICER_2021_Recruitment_1_.pdf","version":"Other Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Play, Culture, and AI, Games Research Group"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Ingrid Maria","key":"christensenpau","last":"Christensen","name":"Christensen, Ingrid Maria","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Melissa","key":"høeghmarcherpau","last":"Høegh Marcher","name":"Høegh Marcher, Melissa","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Pawel","key":"grabarczykpau","last":"Grabarczyk","locid":"42147e05-f94c-471d-a889-c57a01e4bdd0","name":"Grabarczyk, Pawel","orcid":"0000-0002-1268-7474","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Therese","key":"graversenpau","last":"Graversen","locid":"1578b20c-b5d0-466f-b114-2582529ddc53","name":"Graversen, Therese","orcid":"0000-0002-2323-8965","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Claus","key":"brabrandpau","last":"Brabrand","locid":"47a94200-3abe-4354-b5e3-c8ef6f1ba1f2","name":"Brabrand, Claus","orcid":"0000-0001-5093-5806","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1145/3446871.3469758","eisbn":["9781450383264"],"pages":"127-144","publisher":"Association for Computing Machinery","status":"p","title":"Proceedings of the 17th ACM Conference on International Computing Education Research (ICER 2021)"},"review":"Peer Reviewed","scoID":["2-s2.0-85113627549"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-a8d8e430-fda3-4b6d-ab6a-4fbab8b40b3a"],"src":["ITU IT University of Copenhagen"],"title":"Computing Educational Activities Involving People Rather Than Things Appeal More to Women (Recruitment Perspective)","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383725","year":"2021","yearsub":"2021"}
{"abstract":"Computational Thinking (CT) is a highly contentious subject with many diverging meanings and definitions. This study presents a pre- liminary literature review of 71 peer-reviewed articles on CT. The papers indicate the existence of five main aspects that have histori- cally been used in association with its definition: Algorithm, Ab- straction, Modelling, Simulation, and Implementation. Based on this preliminary literature study, semi-structured interviews with eight CT scholars are conducted, in order to evaluate these aspects and to identify qualitatively different perspectives on CT, which integrate the mentioned aspects in different ways. From the interviews, three different perspectives emerged, focusing on: Rea- soning, Simplification, and Automation. Furthermore, the goal of having computationally educated citizens is extrapolated from the interviews, indicating an additional perspective (+1) titled Empowerment, which appears as embedded within all the previ- ous three perspectives. This paper proposes to put these three (+1) perspectives in dialogue, in an effort to support researchers and practitioners working with CT across different fields.","author_count":4,"contributors":["Nicolajsen, Sebastian Mateos","Pischetola, Magda","Grabarczyk, Pawel","Brabrand, Claus"],"cuid":["S01-000.00-383552"],"event":{"acronym":"Koli Calling","title":"Koli Calling International Conference on Computing Education Research"},"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Computational thinking","Computing education","Literature review"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"three 000000000001 perspectives on computational thinking","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1145/3488042.3490024","version":"Published Version"},"id":"S01-000.00-383552","identifier":[{"id":"85119849040","type":"scopus"}],"ids":["itu-9c54ca66-aa59-4ef2-983b-0a86b35b1d02"],"keyword":["Computational thinking","computing education","literature review"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-72A4A53E3DBC3B7EA8F31BA68A9AA3EC"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86349354/kolicalling21_37.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1145/3488042.3490024","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Computing Education Research","IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Sebastian Mateos","key":"nicolajsenpau","last":"Nicolajsen","name":"Nicolajsen, Sebastian Mateos","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Magda","key":"pischetolapau","last":"Pischetola","name":"Pischetola, Magda","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Pawel","key":"grabarczykpau","last":"Grabarczyk","locid":"42147e05-f94c-471d-a889-c57a01e4bdd0","name":"Grabarczyk, Pawel","orcid":"0000-0002-1268-7474","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Claus","key":"brabrandpau","last":"Brabrand","locid":"47a94200-3abe-4354-b5e3-c8ef6f1ba1f2","name":"Brabrand, Claus","orcid":"0000-0001-5093-5806","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1145/3488042.3490024","pages":"21-37","place":"November 18–21, 2021, Joensuu, Finland","publisher":"Association for Computing Machinery","status":"p","subtitle":"November 18–21, 2021, Joensuu, Finland","title":"21st Koli Calling International Conference on Computing Education Research (Koli Calling ’21)"},"review":"Peer Reviewed","scoID":["2-s2.0-85119849040"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-9c54ca66-aa59-4ef2-983b-0a86b35b1d02"],"src":["ITU IT University of Copenhagen"],"title":"Three +1 Perspectives on Computational Thinking","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383552","year":"2021","yearsub":"2021"}
{"abstract":"Prior research on recruitment of women to computing has established that computing tasks involving People rather than Things have been perceived as much more appealing by female high-school students (potentially recruitable as university computing students). This paper changes the focus from prospective to current university students and presents the results of a new experiment that advances and moves beyond earlier research in two crucial respects. First of all, the participants of the experiment are N=152 university students, who already study computing, rather than general high-school students. Second of all, the choice between a People-themed versus an isomorphic Things-themed version of an educational task now pertains to real (in fact, mandatory) assignments that the students had to perform, rather than hypothetical tasks. The change of experimental context, design, and methodology allows us to complement previous findings related to recruitment with suggestions significant for computing educational activities. The overall findings of the new experiment are consistent with that of the previous one. We find that, also at university, there is a visible preference for choosing People themed over Things themed computing tasks amongst women. The results also expose considerable variation between tasks in the effect of gender observed. At the same time, male students, in general, seem to be either indifferent to the themes or to slightly prefer People versions. This suggests that educators should consider favoring People themed assignments over ones involving Things.","author_count":5,"contributors":["Marcher, Melissa Høegh","Christensen, Ingrid Maria","Grabarczyk, Pawel","Graversen, Therese","Brabrand, Claus"],"cuid":["S01-000.00-695242"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Computing education","Educational methodology","Gender preferences","Student engagement","Task selection"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"computing educational activities involving people rather than things appeal more to women cs000000000001 appeal perspective","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://www.itu.dk/people/brabrand/ICER2021-retention.pdf","version":"Published Version"},"id":"S01-000.00-695242","identifier":[{"id":"85113674797","type":"scopus"}],"ids":["itu-4874b4cb-d20c-4dd6-ad55-ca99cfaed687"],"keyword":["- Computing education","- Educational methodology","- Gender preferences","- Student engagement","- Task selection"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-5B68F3787E8224E3ACDE9C394B2126D4"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://www.itu.dk/people/brabrand/ICER2021-retention.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Melissa Høegh","key":"marcherpau","last":"Marcher","locid":"2f4daeb6-5872-4c86-8f2d-5c5ffc3dd5fa","name":"Marcher, Melissa Høegh","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Ingrid Maria","key":"christensenpau","last":"Christensen","name":"Christensen, Ingrid Maria","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Pawel","key":"grabarczykpau","last":"Grabarczyk","locid":"42147e05-f94c-471d-a889-c57a01e4bdd0","name":"Grabarczyk, Pawel","orcid":"0000-0002-1268-7474","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Therese","key":"graversenpau","last":"Graversen","locid":"1578b20c-b5d0-466f-b114-2582529ddc53","name":"Graversen, Therese","orcid":"0000-0002-2323-8965","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Claus","key":"brabrandpau","last":"Brabrand","locid":"47a94200-3abe-4354-b5e3-c8ef6f1ba1f2","name":"Brabrand, Claus","orcid":"0000-0001-5093-5806","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1145/3446871.3469761","eisbn":["9781450383264"],"pages":"145-156","publisher":"Association for Computing Machinery","status":"p","title":"Proceedings of the 17th ACM Conference on International Computing Education Research (ICER 2021)"},"review":"Peer Reviewed","scoID":["2-s2.0-85113674797"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-4874b4cb-d20c-4dd6-ad55-ca99cfaed687"],"src":["ITU IT University of Copenhagen"],"title":"Computing Educational Activities Involving People Rather Than Things Appeal More to Women (CS1 Appeal Perspective)","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-695242","year":"2021","yearsub":"2021"}
{"abstract":"Academic reading, a form of active reading, often involves interaction with the text. Highlighting and annotating are some of the most common strategies of interacting with academic texts, yet we have limited understanding of exactly how such interactions affect reading comprehension in digital versus analog reading environments. In this paper, we present an exploratory study, comparing how university students (n = 50) interact with a digital and a physical text, focusing on highlights and annotations. We compare reading time, interaction with, and subsequent memory of the texts. We make nine observations about reading time, highlighting and annotation frequency and memory scores between paper and laptop. We find that students annotate significantly less on laptop than on paper, but that neither highlighting nor annotations influence subsequent memory of the text in either condition. Our broader contribution is to augment understanding of how different interaction features aid academic reading in a natural environment.","author_count":3,"contributors":["Inie, Nanna","Barkhuus, Louise","Brabrand, Claus"],"cuid":["S01-000.00-384207"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Academic reading","Active reading support","Digital reading","Text annotation"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"interacting with academic readings a comparison of paper and laptop","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://pure.itu.dk/ws/files/86600745/1_s2.0_S2590291121001224_main.pdf","version":"Published Version"},"id":"S01-000.00-384207","identifier":[{"id":"85136957631","type":"scopus"}],"ids":["itu-c8877010-89b2-41dd-8f9f-b07f03b2724e"],"keyword":["Academic reading","Active reading support","Digital reading","Text annotation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-67BB47A184955140C2A61F8369D2C963"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://pure.itu.dk/ws/files/86600745/1_s2.0_S2590291121001224_main.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Center for Computing Education Research","IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Nanna","key":"iniepau","last":"Inie","locid":"e23e8096-59cb-4ef6-af48-ce9d806fd1eb","name":"Inie, Nanna","orcid":"0000-0002-5375-9542","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Louise","key":"barkhuuspau","last":"Barkhuus","locid":"831421c0-027f-4a25-b795-ee2fce0c8d2a","name":"Barkhuus, Louise","orcid":"0000-0003-1306-249X","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Claus","key":"brabrandpau","last":"Brabrand","locid":"47a94200-3abe-4354-b5e3-c8ef6f1ba1f2","name":"Brabrand, Claus","orcid":"0000-0001-5093-5806","rank":3,"rolecode":"pau"}],"pub":{"issn":["25902911"],"journal":"Social Sciences & Humanities Open","paperid":"100226","publisher":"Elsevier","status":"p","title":"Social Sciences & Humanities Open"},"review":"Peer Reviewed","scoID":["2-s2.0-85136957631"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-c8877010-89b2-41dd-8f9f-b07f03b2724e"],"src":["ITU IT University of Copenhagen"],"title":"Interacting with academic readings — A comparison of paper and laptop","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384207","year":"2021","yearsub":"2021"}
{"abstract":"Many software systems are today variational: they are built as program families or Software Product Lines. They can produce a potentially huge number of related programs, known as products or variants, by selecting suitable configuration options (features) at compile time. Many such program families are safety critical, yet the appropriate tools only rarely are able to analyze them effeciently. Researchers have addressed this problem by designing specialized variability-aware static (dataflow) analyses, which allow analyzing all variants of the family, simultaneously, in a single run without generating any of the variants explicitly. They are also known as lifted or family-based analyses. They take as input the common code base, which encodes all variants of a program family, and produce precise analysis results corresponding to all variants. These analyses scale much better than “brute force” approach, where all individual variants are analyzed in isolation, one-by-one, using off-the-shelf single-program analyzers. Nevertheless, the computational cost of lifted analyses still greatly depends on the number of features and variants (which is often huge). For families with a large number of features and variants, the lifted analyses may be too costly or even infeasible. In order to speed up lifted analyses and make them computationally cheaper, variability abstractions which simplify variability away from program families and lifted analyses have been introduced. However, the space of possible variability abstractions is still intractably large to search naively, with most abstractions being either too imprecise or too costly. We introduce here a method to efficiently find suitable variability abstractions from a large space of possible abstractions for a lifted static analysis. The main idea is to use a pre-analysis to estimate the impact of variability-specific parts of the program family on the analysis’s precision. The pre-analysis is fully variability-aware while it aggressively abstracts the other semantics aspects. Then we use the pre-analysis results to find out when and where the subsequent abstract lifted analysis should turn off or on its variability-awareness. The abstraction constructed in this way is effective in discarding variability-specific program details that are irrelevant for showing the analysis’s ultimate goal. We formalize this approach and we illustrate its effectiveness on several Java case studies. The evaluation shows that our approach which consists of running a pre-analysis followed by a subsequent abstract lifted analysis achieves competitive the precision-speed tradeoff compared to the standard lifted analysis.","author_count":3,"contributors":["Dimovski, Aleksandar","Brabrand, Claus","Wasowski, Andrzej"],"cuid":["S01-000.00-384378"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Abstract Interpretation","Lifted Static Analysis","Program Families","Variability Abstractions"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"finding suitable variability abstractions for lifted analysis","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84784353/2019_fac_dimovski_brabrand_wasowski_finding.pdf","version":"Authors Final Version"},"id":"S01-000.00-384378","identifier":[{"id":"85062970585","type":"scopus"}],"ids":["itu-d3a90bab-4c76-4d90-a4e2-131f28722ba0"],"keyword":["Abstract Interpretation","Lifted Static Analysis","Program Families","Variability Abstractions"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-3ABB488464E21ABBD28F5933772E9765"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84784353/2019_fac_dimovski_brabrand_wasowski_finding.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Quality Research"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Aleksandar","key":"dimovskipau","last":"Dimovski","name":"Dimovski, Aleksandar","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Claus","key":"brabrandpau","last":"Brabrand","locid":"47a94200-3abe-4354-b5e3-c8ef6f1ba1f2","name":"Brabrand, Claus","orcid":"0000-0001-5093-5806","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1007/s00165-019-00479-y","issn":["09345043","1433299X"],"issn_org":["09345043"],"issue":"2","journal":"Formal Aspects of Computing","pages":"231-259","publisher":"Springer","status":"p","title":"Formal Aspects of Computing","volume":"31"},"review":"Peer Reviewed","scoID":["2-s2.0-85062970585"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-d3a90bab-4c76-4d90-a4e2-131f28722ba0"],"src":["ITU IT University of Copenhagen"],"title":"Finding suitable variability abstractions for lifted analysis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384378","year":"2019","yearsub":"2019"}
{"abstract":"Variability-sensitive verification pursues effective analysis of the exponentially many variants in number of features of a program family. Several variability-aware techniques have been proposed, but researchers still lack examples of concrete bugs induced by variability, occurring in real large-scale systems. A collection of real world bugs is needed to evaluate tool implementations of variability-sensitive analyses by testing them on real bugs. We present a qualitative study of 98 diverse variability bugs collected from bug-fixing commits in the Apache, BusyBox, Linux kernel and Marlin repositories. We analyze each of the bugs, and record the results in a database. For each bug, we create a self-contained simplified C99 version and a simplified patch, in order to help researchers who are not experts on these subject studies to understand them, so that they can use it for evaluation of their tools. In addition, we provide single-function versions of the bugs, which are useful for evaluating intra-procedural analyses. A Web-based User Interface for the database allows to conveniently browse and visualize the collection of bugs. Our study provides insights into the nature and occurrence of variability bugs in four highly-configurable systems implemented in C, and shows in what ways variability affects and increases the complexity of software bugs. Software bugs appear across different kinds of components, features, and bug categories. Variability affects complexity of bugs by feature interactions, that may span multiple subsystems; through hidden configuration dependent definitions of functions, variables, and types; extending the bug locations from code to also feature models and code mappings, and to modeling languages in which these are expressed. We also find many bugs that are caused by disabling a feature (negative feature interaction), which leads us to suggest the one-disabled strategy for configuration sampling.","author_count":6,"contributors":["Abal, Iago","Melo, Jean","Stanciulescu, Stefan","Brabrand, Claus","Ribeiro, Márcio","Wasowski, Andrzej"],"cuid":["S01-000.00-383455"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, South"],"country":["Brazil"],"glorg":["All Global Affiliations","Federal University of Alagoas"],"keyword":["APACHE","BusyBox","Feature interactions","Linux","Marlin","Program Families","Software Variability","Software bugs","Software product lines"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"variability bugs in highly configurable systems a qualitative analysis","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82396661/main.pdf","version":"Authors Final Version"},"id":"S01-000.00-383455","identifier":[{"id":"85042483857","type":"scopus"}],"ids":["itu-94da0acc-af5a-44ab-abae-f23e1b33987d"],"keyword":["Apache","BusyBox","Feature interactions","Linux","Marlin","Program Families","Software Product Lines","Software Variability","Software bugs"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-938F0A4127E80A7FDB1A8E0FB1DF7416"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82396661/main.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["The Department, Software & Systems"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"br","key":"federal university of alagoas","loc":["Brazil","America, South"],"name":"Federal University of Alagoas","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Iago","key":"abalpau","last":"Abal","name":"Abal, Iago","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jean","key":"melopau","last":"Melo","name":"Melo, Jean","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Stefan","key":"stanciulescupau","last":"Stanciulescu","name":"Stanciulescu, Stefan","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Claus","key":"brabrandpau","last":"Brabrand","locid":"47a94200-3abe-4354-b5e3-c8ef6f1ba1f2","name":"Brabrand, Claus","orcid":"0000-0001-5093-5806","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Márcio","key":"ribeiropau","last":"Ribeiro","name":"Ribeiro, Márcio","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1145/3149119","issn":["1049331X","15577392"],"issn_org":["1049331X"],"issue":"3","journal":"ACM Transactions on Software Engineering and Methodology","pages":"1-34","paperid":"10","publisher":"Association for Computing Machinery","status":"p","title":"ACM Transactions on Software Engineering and Methodology","volume":"26"},"review":"Peer Reviewed","scoID":["2-s2.0-85042483857"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-94da0acc-af5a-44ab-abae-f23e1b33987d"],"src":["ITU IT University of Copenhagen"],"title":"Variability Bugs in Highly Configurable Systems: A Qualitative Analysis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383455","year":"2018","yearsub":"2018"}
{"abstract":"Family-based (lifted) static analysis for “highly configurable programs” (program families) is capable of analyzing all variants at once without generating any of them explicitly. It takes as input only the common code base, which encodes all variants of a program family, and produces precise analysis results corresponding to all variants. However, the computational cost of the lifted analysis still depends inherently on the number of variants, which is in the worst case exponential in the number of statically configurable options (features). For a large number of features, the lifted analysis may be too costly or even infeasible. In this work, we introduce variability abstractions defined as Galois connections, which simplify variability away from program families based on -s. Then, we use abstract interpretation as a formal method for the calculational-based derivation of abstracted lifted analyses, which are sound by construction. Our approach for abstracting lifted analysis is orthogonal to the particular program analysis chosen as a client. While a single program analysis operates on program states and depends on language-specific constructs, the lifted analysis assumes that a single program analysis already exists and lifts its results to all variants of the analyzed program family. Variability abstractions aim to reduce this variability-specific component of the lifted analysis, which handles variability and -s. Furthermore, given the “orthogonality” of variability abstractions to the rest of the analysis (its language-specific component), we can implement abstractions as a preprocessor. In particular, given an abstraction we define a syntactic transformation, which translates any program family into an abstracted version of it, such that the analysis of the abstracted program family coincides with the corresponding abstracted analysis of the original program family. We have implemented the proposed approach, and we evaluate its practicality on three Java benchmarks. The evaluation shows that abstractions yield significant performance gains, especially for families with higher variability.","author_count":3,"contributors":["Dimovski, Aleksandar","Brabrand, Claus","Wasowski, Andrzej"],"cuid":["S01-000.00-381403"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Abstract Interpretation","Program Families","Static analysis"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"variability abstractions for lifted analyses","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83301107/2018_scp_aleksandar_variability_abstractions.pdf","version":"Pre-print"},"id":"S01-000.00-381403","identifier":[{"id":"85045948663","type":"scopus"}],"ids":["itu-09e50a2b-5a8f-4715-8b49-f135adba9dab"],"keyword":["Abstract interpretation","Program families","Static analysis"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-B4D77BB1ADD9602B7F86B174D2C74C18"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83301107/2018_scp_aleksandar_variability_abstractions.pdf","version":"Pre-print"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Software Engineering, Software Quality Research"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Aleksandar","key":"dimovskipau","last":"Dimovski","name":"Dimovski, Aleksandar","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Claus","key":"brabrandpau","last":"Brabrand","locid":"47a94200-3abe-4354-b5e3-c8ef6f1ba1f2","name":"Brabrand, Claus","orcid":"0000-0001-5093-5806","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.scico.2017.12.012","issn":["01676423","18727964"],"issn_org":["01676423"],"journal":"Science of Computer Programming","pages":"1-27","publisher":"Elsevier","status":"p","title":"Science of Computer Programming","volume":"159"},"review":"Peer Reviewed","scoID":["2-s2.0-85045948663"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-09e50a2b-5a8f-4715-8b49-f135adba9dab"],"src":["ITU IT University of Copenhagen"],"title":"Variability abstractions for lifted analyses","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381403","year":"2018","yearsub":"2018"}
{"abstract":"Software projects tend to suffer from conceptually simple resource manipulation bugs, such as accessing a de-allocated memory region, or acquiring a non-reentrant lock twice. Static code scanners are used extensively to remove these bugs from projects like the Linux kernel. Yet, when the manipulation of the resource spans multiple functions, efficiently finding these bugs is a challenge. We present a shape-and-effect inference system for C, that enables efficient and scalable inter-procedural reasoning about resource manipulation. The inference system is used to build a program abstraction: a control-flow graph decorated with alias relationships and observable effects. Bugs are found by model checking this control-flow graph, matching undesirable sequences of operations. We evaluate a prototype implementation of our approach (EBA) and run it on a collection of historical double-lock bugs from the Linux kernel. Our results show that our tool is more effective at finding bugs than similar code-scanning tools. EBA analyzes the drivers/ directory of Linux (nine thousand files) in less than thirty minutes, and uncovers a handful previously unknown double-lock bugs in various drivers.","author_count":3,"contributors":["Abal, Iago","Brabrand, Claus","Wasowski, Andrzej"],"cuid":["S01-000.00-382176"],"event":{"acronym":"VMCAI","end":"2017-01-17","place":"Paris, fr","start":"2017-01-15","title":"18th International Conference on Verification, Model Checking, and Abstract Interpretation","year":"2017"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Bug finding","C","Double lock","Linux","Model checking","Type and effects","Type inference"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"effective bug finding in c programs with shape and effect abstractions","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83026635/2017_vmcai_iago_eba.pdf","version":"Authors Final Version"},"id":"S01-000.00-382176","identifier":[{"id":"85010702759","type":"scopus"}],"ids":["itu-3d3d590d-89b7-4776-847b-8da1ca104c45"],"keyword":["Bug finding","C","Double lock","Linux","Model checking","Type and effects","Type inference"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-68C29DC95C45867017B69C4268D5A1E4"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/83026635/2017_vmcai_iago_eba.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["The Department, Software & Systems"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Iago","key":"abalpau","last":"Abal","name":"Abal, Iago","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Claus","key":"brabrandpau","last":"Brabrand","locid":"47a94200-3abe-4354-b5e3-c8ef6f1ba1f2","name":"Brabrand, Claus","orcid":"0000-0001-5093-5806","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-319-52234-0_3","eisbn":["9783319522340"],"isbn":["9783319522333"],"issn":["03029743"],"pages":"34-54","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","subtitle":"18th International Conference, VMCAI 2017, Paris, France, January 15–17, 2017, Proceedings","title":"Verification, Model Checking, and Abstract Interpretation"},"review":"Peer Reviewed","scoID":["2-s2.0-85010702759"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-3d3d590d-89b7-4776-847b-8da1ca104c45"],"src":["ITU IT University of Copenhagen"],"title":"Effective Bug Finding in C Programs with Shape and Effect Abstractions","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382176","year":"2017","yearsub":"2017"}
{"abstract":"Context. Variability-intensive programs (program families) appear in many application areas and for many reasons today. Different family members, called variants, are derived by switching statically configurable options (features) on and off, while reuse of the common code is maximized. Inquiry. Verification of program families is challenging since the number of variants is exponential in the number of features. Existing single-program analysis and verification tools cannot be applied directly to program families, and designing and implementing the corresponding variability-aware versions is tedious and laborious. Approach. In this work, we propose a range of variability-related transformations for translating program families into single programs by replacing compile-time variability with run-time variability (non-determinism). The obtained transformed programs can be subsequently analyzed using the conventional off- the-shelf single-program analysis tools such as type checkers, symbolic executors, model checkers, and static analyzers. Knowledge. Our variability-related transformations are outcome-preserving, which means that the relation between the outcomes in the transformed single program and the union of outcomes of all variants derived from the original program family is equality. Grounding. We show our transformation rules and their correctness with respect to a minimal core imperative language IMP. Then, we discuss our experience of implementing and using the transformations for efficient and effective analysis and verification of real-world C program families. Importance. We report some interesting variability-related bugs that we discovered using various state-of-the-art single-program C verification tools, such as Frama-C, Clang, LLBMC.","author_count":5,"contributors":["Iosif-Lazar, Alexandru Florin","Melo, Jean","Dimovski, Aleksandar","Brabrand, Claus","Wasowski, Andrzej"],"cuid":["S01-000.00-383302"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["ProgramFamilies","StaticAnalysis","Variability related Transformations","Verification"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"effective analysis of c programs by rewriting variability","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.22152/programming-journal.org/2017/1/1","version":"Published Version"},"id":"S01-000.00-383302","identifier":[{"id":"85075675896","type":"scopus"}],"ids":["itu-8b16b6f1-b726-4270-9384-db65d8d417b0"],"keyword":["ProgramFamilies","StaticAnalysis","Variability-related Transformations","Verification"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-C3ED90CB366CDAE31904197B4595F4B5"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/81944039/1701.08114.pdf","version":"Authors Final Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.22152/programming-journal.org/2017/1/1","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Alexandru Florin","key":"iosiflazarpau","last":"Iosif-Lazar","name":"Iosif-Lazar, Alexandru Florin","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jean","key":"melopau","last":"Melo","name":"Melo, Jean","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Aleksandar","key":"dimovskipau","last":"Dimovski","name":"Dimovski, Aleksandar","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Claus","key":"brabrandpau","last":"Brabrand","locid":"47a94200-3abe-4354-b5e3-c8ef6f1ba1f2","name":"Brabrand, Claus","orcid":"0000-0001-5093-5806","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.22152/programming-journal.org/2017/1/1","issn":["24737321"],"issue":"1","journal":"The Art, Science, and Engineering of Programming","pages":"1-25","paperid":"1","status":"p","title":"The Art, Science, and Engineering of Programming","volume":"1"},"review":"Peer Reviewed","scoID":["2-s2.0-85075675896"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-8b16b6f1-b726-4270-9384-db65d8d417b0"],"src":["ITU IT University of Copenhagen"],"title":"Effective Analysis of C Programs by Rewriting Variability","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383302","year":"2017","yearsub":"2017"}
{"abstract":"Preprocessor directives (#ifdefs) are often used to implement compile-time variability, despite the critique that they increase complexity, hamper maintainability, and impair code comprehensibility. Previous studies have shown that the time of bug finding increases linearly with variability. However, little is known about the cognitive process of debugging programs with variability. We carry out an experiment to understand how developers debug programs with variability. We ask developers to debug programs with and without variability, while recording their eye movements using an eye tracker. The results indicate that debugging time increases for code fragments containing variability. Interestingly, debugging time also seems to increase for code fragments without variability in the proximity of fragments that do contain variability. The presence of variability correlates with increase in the number of gaze transitions between definitions and usages for fields and methods. Variability also appears to prolong the \"initial scan\" of the entire program that most developers initiate debugging with.","author_count":5,"contributors":["Melo, Jean","Batista Narcizo, Fabricio","Hansen, Dan Witzner","Brabrand, Claus","Wasowski, Andrzej"],"cuid":["S01-000.00-383662"],"event":{"acronym":"ICPC","end":"2017-05-23","place":"Buenos Aires, ar","start":"2017-05-22","title":"2017 IEEE/ACM 25th International Conference on Program Comprehension","year":"2017"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Cognition","Complexity theory","Computer bugs","Debugging","Eye Tracker","Eye movements","Eye tracking","Games","Gaze tracking","Highly Configurable Systems","Human factors","Open source software","Preprocessor Directives","Preprocessors","Program compilers","Software maintenance","Tools","Tracking","Variability","code comprehensibility","code fragments","cognitive process","compile time variability","debugging time","gaze transitions","program debugging","software maintainability"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"variability through the eyes of the programmer","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82174194/20170329_camera_ready_icpc.pdf","version":"Authors Final Version"},"id":"S01-000.00-383662","identifier":[{"id":"85025177144","type":"scopus"}],"ids":["itu-a4084045-d9f6-4428-8d56-e1e4ca6ddadf"],"keyword":["Complexity theory","Computer bugs","Debugging","Eye Tracking","Games","Highly-Configurable Systems","Open source software","Preprocessors","Tools","Tracking","Variability","code comprehensibility","code fragments","cognition","cognitive process","compile-time variability","debugging time","eye movements","eye tracker","gaze tracking","gaze transitions","human factors","preprocessor directives","program compilers","program debugging","software maintainability","software maintenance"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-336C9BE4F825B6A3EEB144DB50E54B16"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82174194/20170329_camera_ready_icpc.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Software Engineering, Software Quality Research"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jean","key":"melopau","last":"Melo","name":"Melo, Jean","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Fabricio","key":"batistanarcizopau","last":"Batista Narcizo","name":"Batista Narcizo, Fabricio","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Dan Witzner","key":"hansenpau","last":"Hansen","locid":"5ad9c220-e37f-443a-8a31-fc4abf365db5","name":"Hansen, Dan Witzner","orcid":"0000-0002-6780-4471","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Claus","key":"brabrandpau","last":"Brabrand","locid":"47a94200-3abe-4354-b5e3-c8ef6f1ba1f2","name":"Brabrand, Claus","orcid":"0000-0001-5093-5806","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1109/icpc.2017.34","eisbn":["9781538605356"],"pages":"34-44","publisher":"IEEE","status":"p","title":"2017 IEEE/ACM 25th International Conference on Program Comprehension (ICPC)"},"review":"Peer Reviewed","scoID":["2-s2.0-85025177144"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-a4084045-d9f6-4428-8d56-e1e4ca6ddadf"],"src":["ITU IT University of Copenhagen"],"title":"Variability through the Eyes of the Programmer","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383662","year":"2017","yearsub":"2017"}
{"abstract":"For program families (Software Product Lines), specially designed variability-aware static (dataflow) analyses allow analyzing all variants (products) of the family, simultaneously, in a single run without generating any of the variants explicitly. They are also known as lifted or family-based analyses. The variability-aware analyses may be too costly or even infeasible for families with a large number of variants. In order to make them computationally cheaper, we can apply variability abstractions which aim to tame the combinatorial explosion of the number of variants (configurations) and reduce it to something more tractable. % by manipulating the configuration space of the family. However, the number of possible abstractions is still intractably large to search naively, with most abstractions being too imprecise or too costly. In this work, we propose a technique to efficiently find suitable variability abstractions from a large family of abstractions for a variability-aware static analysis. The idea is to use a pre-analysis to estimate the impact of variability-specific parts of the program family on the analysis's precision. Then we use the pre-analysis results to find out when and where the analysis should turn off or on its variability-awareness. We demonstrate the practicality of this approach on several Java benchmarks.","author_count":7,"contributors":["Dimovski, Aleksandar","Brabrand, Claus","Wasowski, Andrzej"],"cuid":["S01-000.00-384065"],"event":{"acronym":"FM","end":"2016-11-11","place":"Limassol, cy","start":"2016-11-09","title":"International Symposium on Formal Methods","year":"2016"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Abstract Interpretation","Program Families","Static Program Analysis"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"finding suitable variability abstractions for family based analysis","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82370273/fm16.pdf","version":"Authors Final Version"},"id":"S01-000.00-384065","identifier":[{"id":"84996538884","type":"scopus"}],"ids":["itu-bf6a130f-a86a-4c5f-aa52-ff23c9fc302c"],"keyword":["Abstract Interpretation","Program Families","Static Program Analysis"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-C2D1B817140319B69B64E9393AB59738"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82370273/fm16.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","The Department, Software & Systems"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Aleksandar","key":"dimovskipau","last":"Dimovski","name":"Dimovski, Aleksandar","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Claus","key":"brabrandpau","last":"Brabrand","locid":"47a94200-3abe-4354-b5e3-c8ef6f1ba1f2","name":"Brabrand, Claus","orcid":"0000-0001-5093-5806","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":3,"rolecode":"pau"},{"affno":"","first":"John S.","key":"fitzgeraldpedh","last":"Fitzgerald","name":"Fitzgerald, John S.","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Constance L.","key":"heitmeyerpedh","last":"Heitmeyer","name":"Heitmeyer, Constance L.","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Stefania","key":"gnesipedh","last":"Gnesi","name":"Gnesi, Stefania","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Anna","key":"philippoupedh","last":"Philippou","name":"Philippou, Anna","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-319-48989-6_14","eisbn":["9783319489896"],"isbn":["9783319489889"],"issn":["03029743"],"pages":"217-234","place":"Limassol, Cyprus, November 9-11, 2016","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","subtitle":"21st International Symposium, Limassol, Cyprus, November 9-11, 2016, Proceedings","title":"FM 2016: Formal Methods"},"review":"Peer Reviewed","scoID":["2-s2.0-84996538884"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-bf6a130f-a86a-4c5f-aa52-ff23c9fc302c"],"src":["ITU IT University of Copenhagen"],"title":"Finding Suitable Variability Abstractions for Family-Based Analysis","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384065","year":"2016","yearsub":"2016"}
{"abstract":"Many software systems are variational: they can be configured to meet diverse sets of requirements. They can produce a (potentially huge) number of related systems, known as products or variants, by systematically reusing common parts. For variational models (variational systems or families of related systems), specialized family-based model checking algorithms allow efficient verification of multiple variants, simultaneously, in a single run. These algorithms, implemented in a tool Snip, scale much better than ``the brute force'' approach, where all individual systems are verified using a single-system model checker, one-by-one. Nevertheless, their computational cost still greatly depends on the number of features and variants. For variational models with a large number of features and variants, the family-based model checking may be too costly or even infeasible. In this work, we address two key problems of family-based model checking. First, we improve scalability by introducing abstractions that simplify variability. Second, we reduce the burden of maintaining specialized family-based model checkers, by showing how the presented variability abstractions can be used to model check variational models using the standard version of (single-system) Spin. The variability abstractions are first defined as Galois connections on semantic domains. We then show how to use them for defining abstract family-based model checking, where a variability model is replaced with an abstract version of it, which preserves the satisfaction of LTL properties. Moreover, given an abstraction, we define a syntactic source-to-source transformation on high-level modelling languages that describe variational models, such that the model checking of the transformed high-level variational model coincides with the abstract model checking of the concrete high-level variational model. This allows the use of Spin with all its accumulated optimizations for efficient verification of variational models without any knowledge about variability. We have implemented the transformations in a prototype tool, and we illustrate the practicality of this method on several case studies.","author_count":4,"contributors":["Dimovski, Aleksandar","Al-Sibahi, Ahmad Salim","Brabrand, Claus","Wasowski, Andrzej"],"cuid":["S01-000.00-382939"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Abstract Interpretation","Family Based Model Checking","Feature Transition System"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"efficient family based model checking via variability abstractions","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82367741/STTT16_main.pdf","version":"Authors Final Version"},"id":"S01-000.00-382939","identifier":[{"id":"84969988089","type":"scopus"}],"ids":["itu-70588a4a-8f3a-476a-9c6f-45566468b1df"],"keyword":["Abstract Interpretation","Family-Based Model Checking","Feature Transition System"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-085CFCC20E5E29A1FDD869C7FDA3F2DC"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82367741/STTT16_main.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Aleksandar","key":"dimovskipau","last":"Dimovski","name":"Dimovski, Aleksandar","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ahmad Salim","key":"alsibahipau","last":"Al-Sibahi","name":"Al-Sibahi, Ahmad Salim","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Claus","key":"brabrandpau","last":"Brabrand","locid":"47a94200-3abe-4354-b5e3-c8ef6f1ba1f2","name":"Brabrand, Claus","orcid":"0000-0001-5093-5806","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1007/s10009-016-0425-2","issn":["14332779","14332787"],"issn_org":["14332779"],"issue":"5","journal":"International Journal on Software Tools for Technology Transfer","pages":"585-603","publisher":"Springer","status":"p","title":"International Journal on Software Tools for Technology Transfer","volume":"19"},"review":"Peer Reviewed","scoID":["2-s2.0-84969988089"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-70588a4a-8f3a-476a-9c6f-45566468b1df"],"src":["ITU IT University of Copenhagen"],"title":"Efficient family-based model checking via variability abstractions","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382939","year":"2016","yearsub":"2016"}
{"abstract":"Software projects embrace variability to increase adaptability and to lower cost; however, others blame variability for increasing complexity and making reasoning about programs more difficult. We carry out a controlled experiment to quantify the impact of variability on debugging of preprocessor-based programs. We measure speed and precision for bug finding tasks defined at three different degrees of variability on several subject programs derived from real systems. The results show that the speed of bug finding decreases linearly with the number of features, while effectiveness of finding bugs is relatively independent of the degree of variability. Still, identifying the set of configurations in which the bug manifests itself is difficult already for a low number of features. Surprisingly, identifying the exact set of affected configurations appears to be harder than finding the bug in the first place. The difficulty in reasoning about several configurations is a likely reason why the variability bugs are actually introduced in configurable programs. We hope that the detailed findings presented here will inspire the creation of programmer support tools addressing the challenges faced by developers when reasoning about configurations, contributing to more effective debugging and, ultimately, fewer bugs in highly-configurable systems.","author_count":3,"contributors":["Melo, Jean","Brabrand, Claus","Wasowski, Andrzej"],"cuid":["S01-000.00-381836"],"event":{"acronym":"ICSE","title":"International Conference on Software Engineering"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Bug finding strategies","Configuration complexity","Debugging performance","Preprocessor based programs","Variability Management"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"how does the degree of variability affect bug finding","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://itu.dk/people/jeam/variability-experiment/","version":"Other Version"},"id":"S01-000.00-381836","identifier":[{"id":"84971432042","type":"scopus"}],"ids":["itu-25affa62-4c95-4325-9b07-8173a2733515"],"keyword":["Bug finding strategies","Configuration complexity","Debugging performance","Preprocessor-based programs","Variability management"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-9E89416AFFEF2325836AB2BC6B140C35"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["The Department, Software & Systems"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jean","key":"melopau","last":"Melo","name":"Melo, Jean","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Claus","key":"brabrandpau","last":"Brabrand","locid":"47a94200-3abe-4354-b5e3-c8ef6f1ba1f2","name":"Brabrand, Claus","orcid":"0000-0001-5093-5806","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1145/2884781.2884831","isbn":["9781450339001"],"pages":"679-690","publisher":"Association for Computing Machinery","status":"p","title":"ICSE '16 Proceedings of the 38th International Conference on Software Engineering"},"review":"Peer Reviewed","scoID":["2-s2.0-84971432042"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-25affa62-4c95-4325-9b07-8173a2733515"],"src":["ITU IT University of Copenhagen"],"title":"How Does the Degree of Variability Affect Bug-Finding?","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381836","year":"2016","yearsub":"2016"}
{"abstract":"Family-based (lifted) data-flow analysis for Software Product Lines (SPLs) is capable of analyzing all valid products (variants) without generating any of them explicitly. It takes as input only the common code base, which encodes all variants of a SPL, and produces analysis results corresponding to all variants. However, the computational cost of the lifted analysis still depends inherently on the number of variants (which is exponential in the number of features, in the worst case). For a large number of features, the lifted analysis may be too costly or even infeasible. In this paper, we introduce variability abstractions defined as Galois connections and use abstract interpretation as a formal method for the calculational-based derivation of approximate (abstracted) lifted analyses of SPL programs, which are sound by construction. Moreover, given an abstraction we define a syntactic transformation that translates any SPL program into an abstracted version of it, such that the analysis of the abstracted SPL coincides with the corresponding abstracted analysis of the original SPL. We implement the transformation in a tool, that works on Object-Oriented Java program families, and evaluate the practicality of this approach on three Java SPL benchmarks.","author_count":4,"contributors":["Dimovski, Aleksandar","Brabrand, Claus","Wasowski, Andrzej"],"cuid":["S01-000.00-383452"],"event":{"acronym":"ECOOP","end":"2015-07-10","place":"Prague, cz","start":"2015-07-05","title":"The European Conference on Object-Oriented Programming","year":"2015"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Abstract Interpretation","Family Based Program Analysis","Software product lines"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"variability abstractions trading precision for speed in family based analyses","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.4230/LIPIcs.ECOOP.2015.247","version":"Published Version"},"id":"S01-000.00-383452","identifier":[{"id":"84958695209","type":"scopus"}],"ids":["itu-947bc26b-212e-4b9a-a54d-955ce339c09c"],"keyword":["Abstract Interpretation","Family-Based Program Analysis","Software Product Lines"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-A28EA02794FFB3B957460D19C764F435"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.4230/LIPIcs.ECOOP.2015.247","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/81821948/15_Variability_Abstractions_Trading_Precision_for_Speed_in_Family_Based_Analyses.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","The Department, Software & Systems"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Aleksandar","key":"dimovskipau","last":"Dimovski","name":"Dimovski, Aleksandar","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Claus","key":"brabrandpau","last":"Brabrand","locid":"47a94200-3abe-4354-b5e3-c8ef6f1ba1f2","name":"Brabrand, Claus","orcid":"0000-0001-5093-5806","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":3,"rolecode":"pau"},{"affno":"","first":"John Tang","key":"boylandpedh","last":"Boyland","name":"Boyland, John Tang","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.4230/lipics.ecoop.2015.247","isbn":["9783939897866"],"issn":["18688969"],"pages":"247-270","publisher":"Schloss Dagstuhl - Leibniz-Zentrum fuer Informatik GmbH","series":"Leibniz International Proceedings in Informatics","status":"p","subtitle":"Leibniz International Proceedings in Informatics","title":"29th European Conference on Object-Oriented Programming (ECOOP’15)"},"review":"Peer Reviewed","scoID":["2-s2.0-84958695209"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-947bc26b-212e-4b9a-a54d-955ce339c09c"],"src":["ITU IT University of Copenhagen"],"title":"Variability Abstractions: Trading Precision for Speed in Family-Based Analyses","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383452","year":"2015","yearsub":"2015"}
{"abstract":"In order to get insight into challenges with quality in highly-configurable software, we analyze one of the largest open source projects, the Linux kernel, and quantify basic properties of configuration-related warnings. We automatically analyze more than 20 thousand valid and distinct random configurations, in a computation that lasted more than a month. We count and classify a total of 400,000 warnings to get an insight in the distribution of warning types, and the location of the warnings. We run both on a stable and unstable version of the Linux kernel. The results show that Linux contains a significant amount of configuration-dependent warnings, including many that appear harmful. In fact, it appears that there are no configuration-independent warnings in the kernel at all, adding to our knowledge about relevance of family based analyses.","author_count":4,"contributors":["Melo, Jean","Flesborg, Elvis","Brabrand, Claus","Wasowski, Andrzej"],"cuid":["S01-000.00-381746"],"event":{"acronym":"VaMoS","end":"2016-01-29","place":"Salvador, Bahia, br","start":"2016-01-27","title":"International Workshop on Variability Modelling of Software-intensive Systems","year":"2016"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Highly Configurable Software","Linux kernel","configuration related warnings","random configurations","software quality analysis"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"a quantitative analysis of variability warnings in linux","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84961163946","version":"Other Version"},"id":"S01-000.00-381746","identifier":[{"id":"84961163946","type":"scopus"}],"ids":["itu-20107090-c831-4439-8ed3-5d30eebfb137"],"keyword":["Linux kernel","configuration-related warnings","highly-configurable software","random configurations","software quality analysis"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-1DF0BF502095D1D23D21252AAECB4C8F"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["The Department, Software & Systems"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jean","key":"melopau","last":"Melo","name":"Melo, Jean","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Elvis","key":"flesborgpau","last":"Flesborg","name":"Flesborg, Elvis","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Claus","key":"brabrandpau","last":"Brabrand","locid":"47a94200-3abe-4354-b5e3-c8ef6f1ba1f2","name":"Brabrand, Claus","orcid":"0000-0001-5093-5806","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1145/2866614.2866615","isbn":["9781450340199"],"pages":"3-8","publisher":"Association for Computing Machinery","status":"p","title":"VaMoS '16 Proceedings of the Tenth International Workshop on Variability Modelling of Software-intensive Systems"},"review":"Peer Reviewed","scoID":["2-s2.0-84961163946"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-20107090-c831-4439-8ed3-5d30eebfb137"],"src":["ITU IT University of Copenhagen"],"title":"A Quantitative Analysis of Variability Warnings in Linux","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381746","year":"2015","yearsub":"2015"}
{"abstract":"A recent line of work lifts particular verification and analysis methods to Software Product Lines (SPL). In an effort to generalize such case-by-case approaches, we develop a systematic methodology for lifting single-program analyses to SPLs using abstract interpretation. Abstract interpretation is a classical framework for deriving static analyses in a compositional, step-by-step manner. We show how to take an analysis expressed as an abstract interpretation and lift each of the abstract interpretation steps to a family of programs (SPL). This includes schemes for lifting domain types, and combinators for lifting analyses and Galois connections. We prove that for analyses developed using our method, the soundness of lifting follows by construction. The resulting variational abstract interpretation is a conceptual framework for understanding, deriving, and validating static analyses for SPLs. Then we show how to derive the corresponding variational dataflow equations for an example static analysis, a constant propagation analysis. We also describe how to approximate variability by applying variability-aware abstractions to SPL analysis. Finally, we discuss how to efficiently implement our method and present some evaluation results.","author_count":4,"contributors":["Midtgaard, Jan","Dimovski, Aleksandar S.","Brabrand, Claus","Wasowski, Andrzej"],"cuid":["S01-000.00-379748"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Abstract Interpretation","Abstract interpretations","Abstracting","Computer software","Conceptual frameworks","Data flow analysis","Model checking","Software Product Line","Software Variability","Software product lines","Static analysis","Systematic methodology","Verification"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-ITU"]},"level3all":["DI-U-DTU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"systematic derivation of correct variability aware program analyses","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.scico.2015.04.005","version":"Other Version"},"id":"S01-000.00-379748","identifier":[{"id":"84929707895","type":"scopus"}],"ids":["dtu-fb315c7a-b5a1-46e2-895b-a7185b01b77e"],"keyword":["Abstract interpretation","Abstract interpretations","Abstracting","Computer software","Conceptual frameworks","Constant propagation","Data flow analysis","Model checking","Software Product Line","Software Product Lines","Software variabilities","Software variability","Static analysis","Systematic methodology","Verification","Verification and analysis"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-8286305E254E33FBE735D286993E7826"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.scico.2015.04.005","version":"Other Version"}],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Applied Mathematics and Computer Science","Technical University of Denmark, Department of Applied Mathematics and Computer Science, Language-Based Technology"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jan","key":"midtgaardpau","last":"Midtgaard","locid":"de4e2cef-a764-4b37-b15a-b81de9f5a357","name":"Midtgaard, Jan","orcid":"0000-0002-6506-5468","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Aleksandar S.","key":"dimovskipau","last":"Dimovski","name":"Dimovski, Aleksandar S.","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Claus","key":"brabrandpau","last":"Brabrand","name":"Brabrand, Claus","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","name":"Wasowski, Andrzej","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.scico.2015.04.005","issn":["01676423","18727964"],"issn_org":["01676423"],"journal":"Science of Computer Programming","pages":"145-170","publisher":"Elsevier","status":"p","title":"Science of Computer Programming","volume":"105"},"review":"Peer Reviewed","scoID":["2-s2.0-84929707895"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-fb315c7a-b5a1-46e2-895b-a7185b01b77e"],"src":["DTU Technical University of Denmark"],"title":"Systematic derivation of correct variability-aware program analyses","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-379748","year":"2015","yearsub":"2015"}
{"author_count":4,"contributors":["Dimovski, Aleksandar","Al-Sibahi, Ahmad Salim","Brabrand, Claus","Wasowski, Andrzej"],"cuid":["S01-000.00-381552"],"event":{"end":"2015-07-21","place":"Nashville, TN, us","start":"2015-07-21","title":"2nd Software Product Line Analysis Tools Workshop","year":"2015"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"nr","rtype":["clu"],"sorti":"family based model checking using off the shelf model checkers","src":["itu"],"src-code":["DI-U-ITU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-381552","ids":["itu-130048e9-4472-4aa3-8049-192dc82c0374"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-801490C2B2EEC13DD279587286CC40D2"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","The Department, Software & Systems"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Aleksandar","key":"dimovskipau","last":"Dimovski","name":"Dimovski, Aleksandar","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ahmad Salim","key":"alsibahipau","last":"Al-Sibahi","name":"Al-Sibahi, Ahmad Salim","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Claus","key":"brabrandpau","last":"Brabrand","locid":"47a94200-3abe-4354-b5e3-c8ef6f1ba1f2","name":"Brabrand, Claus","orcid":"0000-0001-5093-5806","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-130048e9-4472-4aa3-8049-192dc82c0374"],"src":["ITU IT University of Copenhagen"],"title":"Family-Based Model Checking using Off-the-Shelf Model Checkers","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381552","year":"2015","yearsub":"2015"}
{"abstract":"Many software systems are variational: they can be configured to meet diverse sets of requirements. Variability is found in both communication protocols and discrete controllers of embedded systems. In these areas, model checking is an important verification technique. For variational models (systems with variability), specialized family-based model checking algorithms allow efficient verification of multiple variants, simultaneously. These algorithms scale much better than ``brute force'' verification of individual systems, one-by-one. Nevertheless, they can deal with only very small variational models. We address two key problems of family-based model checking. First, we improve scalability by introducing abstractions that simplify variability. Second, we reduce the burden of maintaining specialized family-based model checkers, by showing how the presented variability abstractions can be used to model-check variational models using the standard version of (single system) SPIN. The abstractions are first defined as Galois connections on semantic domains. We then show how to translate them into syntactic source-to-source transformations on variational models. This allows the use of SPIN with all its accumulated optimizations for efficient verification of variational models without any knowledge about variability. We demonstrate the practicality of this method on several examples using both the SNIP (family based) and SPIN (single system) model checkers.","author_count":6,"contributors":["Dimovski, Aleksandar","Al-Sibahi, Ahmad Salim","Brabrand, Claus","Wasowski, Andrzej"],"cuid":["S01-000.00-384700"],"event":{"acronym":"SPIN","end":"2015-08-26","place":"Stellenbosch, za","start":"2015-08-24","title":"22nd International SPIN Symposium on Model Checking of Software","year":"2015"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Family Based Abstract Model Checking","Model Checkers","Variability Abstractions"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"family based model checking without a family based model checker","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/81821925/dimovski_spin15.pdf","version":"Authors Final Version"},"id":"S01-000.00-384700","identifier":[{"id":"84945924168","type":"scopus"}],"ids":["itu-e8d276b3-fd2b-427d-8079-e9ec01c7cf7a"],"keyword":["Family-Based Abstract Model Checking","Model Checkers","Variability Abstractions"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-73FC14EC791DC2298ABB574AC8C3AA2B"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/81821925/dimovski_spin15.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","The Department, Software & Systems"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Aleksandar","key":"dimovskipau","last":"Dimovski","name":"Dimovski, Aleksandar","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ahmad Salim","key":"alsibahipau","last":"Al-Sibahi","name":"Al-Sibahi, Ahmad Salim","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Claus","key":"brabrandpau","last":"Brabrand","locid":"47a94200-3abe-4354-b5e3-c8ef6f1ba1f2","name":"Brabrand, Claus","orcid":"0000-0001-5093-5806","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":4,"rolecode":"pau"},{"affno":"","first":"B.","key":"fischerpedh","last":"Fischer","name":"Fischer, B.","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"J.","key":"geldenhuyspedh","last":"Geldenhuys","name":"Geldenhuys, J.","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-319-23404-5_18","isbn":["9783319234038"],"issn":["03029743"],"pages":"282-299","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","subtitle":"22nd International Symposium, SPIN 2015, Stellenbosch, South Africa, August 24-26, 2015, Proceedings","title":"Model Checking Software","volume":"9232"},"review":"Peer Reviewed","scoID":["2-s2.0-84945924168"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-e8d276b3-fd2b-427d-8079-e9ec01c7cf7a"],"src":["ITU IT University of Copenhagen"],"title":"Family-Based Model Checking Without a Family-Based Model Checker","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384700","year":"2015","yearsub":"2015"}
{"abstract":"Feature-sensitive verification pursues effective analysis of the exponentially many variants of a program family. However, researchers lack examples of concrete bugs induced by variability, occurring in real large-scale systems. Such a collection of bugs is a requirement for goal-oriented research, serving to evaluate tool implementations of feature-sensitive analyses by testing them on real bugs. We present a qualitative study of 42 variability bugs collected from bug-fixing commits to the Linux kernel repository. We analyze each of the bugs, and record the results in a database. In addition, we provide self-contained simplified C99 versions of the bugs, facilitating understanding and tool evaluation. Our study provides insights into the nature and occurrence of variability bugs in a large C software system, and shows in what ways variability affects and increases the complexity of software bugs.","author_count":3,"contributors":["Abal, Iago","Brabrand, Claus","Wasowski, Andrzej"],"cuid":["S01-000.00-382385"],"event":{"acronym":"ASE","end":"2014-09-19","place":"Västerås, se","start":"2014-09-15","title":"IEEE/ACM International Conference on Automated Software Engineering","year":"2014"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Bugs","Feature interactions","Linux","Software Variability"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"000000000042 variability bugs in the linux kernel a qualitative study","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84908635167","version":"Other Version"},"id":"S01-000.00-382385","identifier":[{"id":"84908635167","type":"scopus"}],"ids":["itu-4aea84e9-050f-4dfb-a0e8-25f12437ee00"],"keyword":["Bugs","Feature interactions","Linux","Software Variability"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-13347C8E6B68CA181E0B239DC5B8CCDF"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["The Department, Software & Systems"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Iago","key":"abalpau","last":"Abal","name":"Abal, Iago","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Claus","key":"brabrandpau","last":"Brabrand","locid":"47a94200-3abe-4354-b5e3-c8ef6f1ba1f2","name":"Brabrand, Claus","orcid":"0000-0001-5093-5806","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andrzej","key":"wasowskipau","last":"Wasowski","locid":"a39b94ff-e1b6-4b96-8404-486167a9123d","name":"Wasowski, Andrzej","orcid":"0000-0003-0532-2685","rank":3,"rolecode":"pau"}],"pub":{"isbn":["9781450330138"],"pages":"421-432","publisher":"Association for Computing Machinery","status":"p","title":"ASE '14 Proceedings of the 29th ACM/IEEE international conference on Automated software engineering"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-4aea84e9-050f-4dfb-a0e8-25f12437ee00"],"src":["ITU IT University of Copenhagen"],"title":"42 Variability Bugs in the Linux Kernel : A Qualitative Study","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382385","year":"2014","yearsub":"2014"}
