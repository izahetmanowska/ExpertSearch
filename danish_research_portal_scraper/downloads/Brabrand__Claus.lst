h Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-8645d782-2da8-4f7c-b22d-e0a8957a1af0"],"src":["AU Aarhus University"],"title":"WebSelF : A Web Scraping Framework","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-205976","year":"2012","yearsub":"2012"}
{"abstract":"We present, WebSelF, a framework for web scraping which models the process of web scraping and decomposes it into four conceptually independent, reusable, and composable constituents. We have validated our framework through a full parameterized implementation that is flexible enough to capture previous work on web scraping. We have experimentally evaluated our framework and implementation in an experiment that evaluated several qualitatively different web scraping constituents (including previous work and combinations hereof) on about 11,000 HTML pages on daily versions of 17 web sites over a period of more than one year. Our framework solves three concrete problems with current web scraping and our experimental results indicate that com- position of previous and our new techniques achieve a higher degree of accuracy, precision and specificity than existing techniques alone.","author_count":4,"contributors":["Thomsen, Jakob","Ernst, Erik","Brabrand, Claus","Schwartzbach, Michael"],"cuid":["S01-000.00-383012"],"event":{"end":"2012-07-27","place":"Berlin, de","start":"2012-07-23","title":"International Conference on Web Engineering","year":"2012"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Accuracy and precision in data collection","Experimental evaluation","HTML data extraction","Parameterized implementation","Web scraping framework"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-AAU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"webself a web scraping framework","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84865127006","version":"Other Version"},"id":"S01-000.00-383012","identifier":[{"id":"84865127006","type":"scopus"}],"ids":["itu-766a6f63-7a57-4efd-a958-63db2e7f95df"],"keyword":["Accuracy and precision in data collection","Experimental evaluation","HTML data extraction","Parameterized implementation","Web scraping framework"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-5-142FCE4FF31D3B4EBCDD1453B4836FC0"],"org":[{"affno":"1","country":"dk","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","The Department, Software & Systems","The Department, Theoretical Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jakob","key":"thomsenpau","last":"Thomsen","name":"Thomsen, Jakob","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Erik","key":"ernstpau","last":"Ernst","name":"Ernst, Erik","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Claus","key":"brabrandpau","last":"Brabrand","locid":"47a94200-3abe-4354-b5e3-c8ef6f1ba1f2","name":"Brabrand, Claus","orcid":"0000-0001-5093-5806","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Michael","key":"schwartzbachpau","last":"Schwartzbach","name":"Schwartzbach, Michael","rank":4,"rolecode":"pau"}],"pub":{"isbn":["9783642317521"],"pages":"347-361","publisher":"Springer","status":"p","title":"ICWE'12 Proceedings of the 12th international conference on Web Engineering","volume":"7387"},"review":"Peer Reviewed","scoID":["2-s2.0-84865127006"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-766a6f63-7a57-4efd-a958-63db2e7f95df"],"src":["ITU IT University of Copenhagen"],"title":"WebSelF: A Web Scraping Framework","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383012","year":"2012","yearsub":"2012"}
{"abstract":"During Software Product Line (SPL) maintenance tasks, Virtual Separation of Concerns (VSoC) allows the programmer to focus on one feature and hide the others. However, since features depend on each other through variables and control-flow, feature modularization is compromised since the maintenance of one feature may break another. In this context, emergent interfaces can capture dependencies between the feature we are maintaining and the others, making developers aware of dependencies. To better understand the impact of feature dependencies during SPL maintenance, we have investigated the following two questions: how often methods with preprocessor directives contain feature dependencies? How feature dependencies impact maintenance effort when using VSoC and emergent interfaces? Answering the former is important for assessing how often we may face feature dependency problems. Answering the latter is important to better understand to what extent emergent interfaces complement VSoC during maintenance tasks. To answer them, we analyze 43 SPLs of different domains, size, and languages. The data we collect from them complement previous work on preprocessor usage.","author_count":6,"contributors":["Ribeiro, Márcio","Queiroz, Felipe","Borba, Paulo","Tolêdo, Társis","Brabrand, Claus","Soares, Sérgio"],"cuid":["S01-000.00-384316"],"event":{"end":"2011-10-23","place":"Portland, us","start":"2011-10-22","title":"Generative Programming and Component Engineering (GPCE 2011)","year":"2011"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, South"],"country":["Brazil"],"glorg":["All Global Affiliations","Federal University of Pernambuco"],"keyword":["Emergent Interfaces","Feature Dependencies","Preprocessor Directives","Software Product Line Maintenance","Virtual Separation of Concerns"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"on the impact of feature dependencies when maintaining preprocessor based software product lines","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/81455135810","version":"Other Version"},"id":"S01-000.00-384316","identifier":[{"id":"81455135810","type":"scopus"}],"ids":["itu-cfcb1f06-9950-4ff2-beee-a358923dbafd"],"keyword":["Emergent Interfaces","Feature Dependencies","Preprocessor Directives","Software Product Line Maintenance","Virtual Separation of Concerns"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-96F6AD46A66852796AA1E0200D31F1C9"],"org":[{"affno":"1","country":"br","key":"federal university of pernambuco","loc":["Brazil","America, South"],"name":"Federal University of Pernambuco","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Márcio","key":"ribeiropau","last":"Ribeiro","name":"Ribeiro, Márcio","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Felipe","key":"queirozpau","last":"Queiroz","name":"Queiroz, Felipe","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Paulo","key":"borbapau","last":"Borba","name":"Borba, Paulo","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Társis","key":"tolêdopau","last":"Tolêdo","name":"Tolêdo, Társis","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Claus","key":"brabrandpau","last":"Brabrand","locid":"47a94200-3abe-4354-b5e3-c8ef6f1ba1f2","name":"Brabrand, Claus","orcid":"0000-0001-5093-5806","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sérgio","key":"soarespau","last":"Soares","name":"Soares, Sérgio","rank":6,"rolecode":"pau"}],"pub":{"isbn":["9781450306898"],"publisher":"Association for Computing Machinery","status":"p","title":"GPCE '11 Proceedings of the 10th ACM international conference on Generative programming and component engineering"},"review":"Peer Reviewed","scoID":["2-s2.0-81455135810"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-cfcb1f06-9950-4ff2-beee-a358923dbafd"],"src":["ITU IT University of Copenhagen"],"title":"On the Impact of Feature Dependencies when Maintaining Preprocessor-based Software Product Lines","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384316","year":"2011","yearsub":"2011"}
{"abstract":"This volume contains the proceedings of the Eleventh Workshop on Language Descriptions, Tools and Applications (LDTA 2011), held in Saarbrücken, Germany on March 26 & 27, 2011. LDTA is a two-day satellite event of ETAPS (European Joint Conferences on Theory and Practice of Software) and organized in cooperation with ACM SIGPLAN. LDTA is an application and tool-oriented workshop focused on grammarware---software based on grammars in some form. Grammarware applications are typically language processing applications and traditional examples include parsers, program analyzers, optimizers and translators. A primary focus of LDTA is grammarware that is generated from high-level grammar-centric specifications and thus submissions on parser generation, attribute grammar systems, term/graph rewriting systems, and other grammar-related meta-programming tools, techniques, and formalisms were encouraged. For 2011, 25 papers were submitted, of which two were tool demonstration papers. A program committee of 20 with the help of 7 additional reviewers provided three reviews for each paper. An electronic PC meeting was held using EasyChair to discuss the papers and from those submitted 9 full papers and two tool demonstration papers were selected. In addition to these 11 papers the proceedings includes the paper \"Getting a Grip on Tasks that Coordinate Tasks\" by Rinus Plasmeijer of Radboud University Nijmegen in The Netherlands. This paper accompanied his invited talk at the workshop. This year LDTA also puts theory, as well as techniques and tools, to the test in a new way in the form of the LDTA Tool Challenge. Tool developers were invited to participate in the Challenge by developing solutions to a range of language processing tasks over a simple but evolving set of imperative programming languages. Tool challenge participants presented highlights of their solution during special sessions of the workshop and will contribute to a joint paper on the Tool Challenge and proposed solutions to be co-authored by all participants after the workshop.","author_count":2,"contributors":["Brabrand, Claus","Van Wyk, Eric"],"cuid":["S01-000.00-384793"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Saint Mary's University of Minnesota"],"keyword":["Attribute grammar systems","ETAPS","Grammarware","LDTA 2011","Language processing","Meta programming","Parser generation","Term rewriting systems","Tool Challenge","Tool demonstration"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"nr","rtype":["clu"],"sorti":"proceedings of the of the eleventh workshop on language descriptions tools and applications ldta 000000002011","src":["itu"],"src-code":["DI-U-ITU"],"type":"db","type-grp":["all","pub"]},"id":"S01-000.00-384793","ids":["itu-ef7bf2c8-3f2e-437a-88e0-c95b6790856b"],"keyword":["Attribute grammar systems","ETAPS","Grammarware","LDTA 2011","Language processing","Meta-programming","Parser generation","Term rewriting systems","Tool Challenge","Tool demonstration"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-44735D03CC75A6897B2E7524B0098151"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"us","key":"saint mary s university of minnesota","loc":["United States","America, North","OECD"],"name":"Saint Mary's University of Minnesota","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Claus","key":"brabrandped","last":"Brabrand","locid":"47a94200-3abe-4354-b5e3-c8ef6f1ba1f2","name":"Brabrand, Claus","orcid":"0000-0001-5093-5806","rank":1,"role":"Editor","rolecode":"ped"},{"affno":"2","corresponding":null,"first":"Eric","key":"vanwykped","last":"Van Wyk","name":"Van Wyk, Eric","rank":2,"role":"Editor","rolecode":"ped"}],"pub":{"eisbn":["9781450306652"],"publisher":"Association for Computing Machinery","status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-ef7bf2c8-3f2e-437a-88e0-c95b6790856b"],"src":["ITU IT University of Copenhagen"],"title":"Proceedings of the of the Eleventh Workshop on Language Descriptions, Tools and Applications (LDTA 2011)","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384793","year":"2011","yearsub":"2011"}
