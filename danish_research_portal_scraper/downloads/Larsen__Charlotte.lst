orben Broe","key":"knudsenpau","last":"Knudsen","locid":"a1db0b56-d161-4c02-8778-cf79ff302952","name":"Knudsen, Torben Broe","rank":14,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Brit","key":"gronielsenpau","last":"Gro-Nielsen","locid":"792c591e-bdc8-41d6-a278-f12cfa918816","name":"Gro-Nielsen, Brit","rank":15,"rolecode":"pau"}],"pub":{"isbn":["9788771457070"],"pages":"96","place":"Aalborg","publisher":"UCN Forlag","status":"p","volume":"9"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All University Colleges","DI-ALL","DI-UC","DI-UC-ALL","University College of Northern Denmark","University Colleges"],"PST":["Published"]},"sid":["ucn-ec286097-c713-459d-aed1-dafc1493044b"],"src":["UCN University College of Northern Denmark"],"title":"Just DUIT : status og perspektiver fra et igangværende forsknings- og udviklingsprojekt i UCN","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-652556","year":"2014","yearsub":"2014"}
{"abstract":"Summary: Real-time quantitative polymerase chain reaction (qPCR) has been extensively validated for the detection of minimal residual disease (MRD) in acute myeloid leukaemia (AML). Meanwhile, multicolour flow cytometry (MFC) has received less attention because the so-called leukaemia-associated immunophenotypes (LAIPs) are generally of lower sensitivity and specificity, and prone to change during therapy. To improve MRD assessment by MFC, we here evaluate the combination of human Myeloid Inhibitory C-type Lectin (hMICL, also termed C-type lectin domain family 12, member A, CLEC12A) and CD 123 (also termed interleukin-3 receptor alpha, IL3RA) in combination with CD34 and CD117 (KIT), as an MRD assay in pre-clinical and clinical testing in 69 AML patients. Spiking experiments revealed that the assay could detect MRD down to 10 -4 in normal bone marrow with sensitivities equalling those of validated qPCR assays. Moreover, it provided at least one MFC MRD marker in 62/69 patients (90%). High levels of hMICL/CD123 LAIPs at the post-induction time-point were a strong prognostic marker for relapse in patients in haematological complete remission (P < 0·001). Finally, in post induction samples, hMICL/CD123 LAIPs were strongly correlated (r = 0·676, P = 0·0008) to applied qPCR targets. We conclude the hMICL/CD123-based MFC assay is a promising MRD tool in AML.","author_count":8,"contributors":["Roug, Anne Stidsholt","Larsen, Hanne Baekgaard","Nederby, Line","Just, Tom","Brown, Gordon","Nyvold, Charlotte Guldborg","Ommen, Hans Beier","Hokland, Peter"],"cuid":["S02-098.42-030464"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Acute myeloid leukaemia","Flow Cytometry","Minimal residual disease","Quantitative polymerase chain reaction"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"hmicl and cd000000000123 in combination with a cd000000000045 cd000000000034 cd000000000117 backbone a universal marker combination for the detection of minimal residual disease in acute myeloid leukaemia","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1111/bjh.12614","version":"Other Version"},"id":"S02-098.42-030464","identifier":[{"id":"84891624172","type":"scopus"},{"id":"24152218","type":"pmid"}],"ids":["au-f6cead7d-3999-4ba7-a93b-6e52f44c958a","sdu-00e2189f-1fa0-4271-b13d-d693c1e0ba1f"],"keyword":["Acute myeloid leukaemia","Flow cytometry","Leukaemia-associated immunophenotype","Minimal residual disease","Quantitative polymerase chain reaction"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-6EE6E095D9C5FC8F1EAAABA54E76349F"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1111/bjh.12614","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Haematology","Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - xx"],"nora_code":"DI-U-AU","used":1},{"affno":2,"key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Haematology (Odense)"],"nora_code":"DI-U-SDU"}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Anne Stidsholt","key":"rougpau","last":"Roug","locid":"10b253fc-6c0d-4bbb-8fe0-b199ed6c5531","name":"Roug, Anne Stidsholt","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Hanne Ø","key":"larsenpau","last":"Larsen","locid":"255638b3-b8b1-478a-b132-d212003864c6","name":"Larsen, Hanne Baekgaard","name_org":"Larsen, Hanne Ø","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Line","key":"nederbypau","last":"Nederby","locid":"3eac632b-3b1a-4aeb-bf22-bd5c9696def2","name":"Nederby, Line","orcid":"0000-0002-0101-328X","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Tom","key":"justpau","last":"Just","name":"Just, Tom","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Gordon","key":"brownpau","last":"Brown","name":"Brown, Gordon","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Charlotte G","key":"nyvoldpau","last":"Nyvold","locid":"ff577c47-d55d-436b-bdd9-1ed87d6538ba","name":"Nyvold, Charlotte Guldborg","name_org":"Nyvold, Charlotte G","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Hans B","key":"ommenpau","last":"Ommen","locid":"fb2798a4-102f-4576-b17c-987e7106ec71","name":"Ommen, Hans Beier","name_org":"Ommen, Hans B","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter","key":"hoklandpau","last":"Hokland","locid":"aeccec22-6cff-49a0-8e57-528866ef5aff","name":"Hokland, Peter","orcid":"0000-0002-1177-9756","rank":8,"rolecode":"pau"}],"pmid":["24152218"],"pub":{"doi":"10.1111/bjh.12614","issn":["00071048"],"issue":"2","journal":"British Journal of Haematology","pages":"212-222","publisher":"John Wiley & Sons Inc.","status":"p","title":"British Journal of Haematology","volume":"164"},"review":"Peer Reviewed","scoID":["2-s2.0-84891624172"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-f6cead7d-3999-4ba7-a93b-6e52f44c958a","sdu-00e2189f-1fa0-4271-b13d-d693c1e0ba1f"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"hMICL and CD123 in combination with a CD45/CD34/CD117 backbone - a universal marker combination for the detection of minimal residual disease in acute myeloid leukaemia","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-098.42-030464","year":"2014","yearsub":"2014"}
{"abstract":"PURPOSE: Lichtenstein hernia repair is a common surgical procedure and one of the first procedures performed by a surgical trainee. However, formal assessment tools developed for this procedure are few and sparsely validated. The aim of this study was to determine the reliability and validity of an assessment tool designed to measure surgical skills in Lichtenstein hernia repair. METHODS: Key issues were identified through a focus group interview. On this basis, an assessment tool with eight items was designed. Ten surgeons and surgical trainees were video recorded while performing Lichtenstein hernia repair, (four experts, three intermediates, and three novices). The videos were blindly and individually assessed by three raters (surgical consultants) using the assessment tool. Based on these assessments, validity and reliability were explored. RESULTS: The internal consistency of the items was high (Cronbach's alpha = 0.97). The inter-rater reliability was very good with an intra-class correlation coefficient (ICC) = 0.93. Generalizability analysis showed a coefficient above 0.8 even with one rater. The coefficient improved to 0.92 if three raters were used. One-way analysis of variance found a significant difference between the three groups which indicates construct validity, p < 0.001. CONCLUSIONS: Lichtenstein hernia repair skills can be assessed blindly by a single rater in a reliable and valid fashion with the new procedure-specific assessment tool. We recommend this tool for future assessment of trainees performing Lichtenstein hernia repair to ensure that the objectives of competency-based surgical training are met.","author_count":6,"contributors":["Carlsen, C G","Lindorff-Larsen, Karen","Funch-Jensen, Peter","Lund, Lars","Charles, Peder","Konge, Lars"],"cuid":["S04-091.66-010859"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":4,"keyword":["Assessment","Clinical Competence","Hernia Inguinal","Hernia Inguinal surgery","Herniorrhaphy","Humans","Reproducibility of Results","Surgical training","Validation"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-SDR"],"OT":["Health"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU","DI-U-UND"]},"level3all":["DI-HO-SDR","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU","DI-U-UND"]},"review":"pr","rtype":["clu"],"sorti":"reliable and valid assessment of lichtenstein hernia repair skills","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s10029-013-1196-2","version":"Other Version"},"id":"S04-091.66-010859","identifier":[{"id":"84905086752","type":"scopus"},{"id":"24297744","type":"pmid"},{"id":"WOS:000339876400014","type":"wos"}],"ids":["aau-e358df23-0fd7-4e84-8610-414bfd4a53e3","au-774cdc08-688f-4a0e-8abe-cde774055c75","ku-7322b590-afab-44c5-ace2-589f086ea509","sdu-86b145e9-c1fc-4d6d-9779-04bcf9970f3e"],"keyword":["Assessment","Clinical Competence","Hernia, Inguinal","Hernia, Inguinal/surgery","Herniorrhaphy","Herniorrhaphy/standards","Humans","Lichtenstein hernia repair","Reproducibility of Results","Surgical training","Validation"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-7-76F3F3869F60083B2A3E88CD0EF7CC9E"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s10029-013-1196-2","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, HE Centre, HE Centre - Cen