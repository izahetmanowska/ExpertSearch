mer","locid":"c09abc63-c16b-40b2-bfaa-9befb36359c2","name":"Flummer, Christine","rank":3,"rolecode":"pau"},{"affno":"2 4","corresponding":null,"first":"Niels","key":"oksbjergpau","last":"Oksbjerg","locid":"096ec8bd-cf5e-4c67-9266-c53433f4b0bd","name":"Oksbjerg, Niels","rank":4,"rolecode":"pau"},{"affno":"1","first":"Christian Fink","key":"hansenpau","last":"Hansen","locid":"ef8ae189-429f-4359-9423-4608b7504810","name":"Hansen, Christian Fink","rank":5,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Peter Kappel","key":"theilpau","last":"Theil","locid":"1869a922-3d79-4a49-8eac-148b15f19bfb","name":"Theil, Peter Kappel","rank":6,"rolecode":"pau"}],"pmid":["24085405"],"pub":{"doi":"10.2527/jas.2013-6824","issn":["00218812","15253163"],"issn_org":["00218812"],"issue":"12","journal":"Journal of Animal Science","pages":"5605-5613","publisher":"Oxford University Press","status":"p","title":"Journal of Animal Science","volume":"91"},"review":"Peer Reviewed","scoID":["2-s2.0-84888169924"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Undetermined","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-eac0a70a-0a45-4c81-865b-eba47814d8a6","ku-a66cbb6a-6c5d-4d4d-a4f8-e3a6aa5adb63"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Intrauterine Growth restricted piglets defined by their head shape ingest insufficient amounts of colostrum","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-092.86-029685","year":"2013","yearsub":"2013"}
{"abstract":"OBJECTIVE: To investigate the impact of instructor feedback versus no instructor feedback when training a complex operational task on a laparoscopic virtual reality simulator. BACKGROUND: Simulators are now widely accepted as a training tool, but there is insufficient knowledge about how much feedback is necessary, which is useful for sustainable implementation. METHODS: A randomized trial complying with CONSORT Statement. All participants had to reach a predefined proficiency level for a complex operational task on a virtual reality simulator. The intervention group received standardized instructor feedback a maximum of 3 times. The control group did not receive instructor feedback. Participants were senior medical students without prior laparoscopic experience (n = 99). Outcome measures were time, repetitions, and performance score to reach a predefined proficiency level. Furthermore, influence of sex and perception of own surgical skills were examined. RESULTS: Time (in minutes) and repetitions were reduced in the intervention group (162 vs 342 minutes; P < 0.005) and (29 vs 65 repetitions; P < 0.005). The control group achieved a higher performance score than the intervention group (57% vs 49%; P = 0.004). Men used less time (in minutes) than women (P = 0.037), but no sex difference was observed for repetitions (P = 0.20). Participants in the intervention group had higher self-perception regarding surgical skills after the trial (P = 0.011). CONCLUSIONS: Instructor feedback increases the efficiency when training a complex operational task on a virtual reality simulator; time and repetitions used to achieve a predefined proficiency level were significantly reduced in the group that received instructor feedback compared with the control group. Trial registration number: NCT01497782.","author_count":11,"contributors":["Strandbygaard, Jeanett","Bjerrum, Flemming","Maagaard, Mathilde","Winkel, Per","Larsen, Christian Rifbjerg","Ringsted, Charlotte","Gluud, Christian","Grantcharov, Teodor","Ottesen, Bent","Sorensen, Jette Led"],"cuid":["S02-097.67-021062"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","OECD"],"corresponding_author":["Strandbygaard, Jeanett"],"country":["Canada"],"glorg":["All Global Affiliations","Samuel Lunenfeld Research Institute, Mount Sinai Hospital, Toronto"],"keyword":["Feedback","Laparoscopy","Training","Virtual reality simulation"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"instructor feedback versus no instructor feedback on performance in a laparoscopic virtual reality simulator a randomized trial","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1097/SLA.0b013e31827eee6e","version":"Other Version"},"id":"S02-097.67-021062","identifier":[{"id":"84876284133","type":"scopus"},{"id":"23295321","type":"pmid"}],"ids":["au-72cc98d0-3818-43da-bd5d-cb821f41c02e","ku-dde1cb49-a3d7-41b3-b871-150cba6bc843"],"keyword":["feedback","laparoscopy","predefined proficiency level","training","virtual reality simulation"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-F3358046B4B536B9D6A3AE1663AE2A72"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.scopus.com/inward/record.url?scp=84876284133&partnerID=8YFLogxK","version":"Other Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1097/SLA.0b013e31827eee6e","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Section of Surgery and Internal Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"ca","key":"samuel lunenfeld research institute mount sinai hospital toronto","loc":["Canada","America, North","OECD"],"name":"Samuel Lunenfeld Research Institute, Mount Sinai Hospital, Toronto","used":1},{"affno":4,"key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Dentistry and Oral Health, Department of Dentistry and Oral Health - Section for Maxillofacial Surgery and Oral Pathology"],"nora_code":"DI-U-AU"}],"person":[{"affno":"1","corresponding":null,"first":"Jeanett","key":"strandbygaardpau","last":"Strandbygaard","name":"Strandbygaard, Jeanett","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Flemming","key":"bjerrumpau","last":"Bjerrum","name":"Bjerrum, Flemming","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mathilde","key":"maagaardpau","last":"Maagaard","name":"Maagaard, Mathilde","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Per","key":"winkelpau","last":"Winkel","name":"Winkel, Per","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christian Rifbjerg","key":"larsenpau","last":"Larsen","name":"Larsen, Christian Rifbjerg","rank":5,"ro