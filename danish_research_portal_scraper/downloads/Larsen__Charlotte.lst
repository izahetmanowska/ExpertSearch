"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Environmental Engineering","Technical University of Denmark, Department of Environmental Engineering, Residual Resource Engineering"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Lotte","key":"fjelstedpau","last":"Fjelsted","locid":"66fc8252-3482-4d08-99ce-6f5ee964650f","name":"Fjelsted, Lotte","orcid":"0000-0002-2878-798X","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders G.","key":"christensenpau","last":"Christensen","name":"Christensen, Anders G.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens E.","key":"larsenpau","last":"Larsen","name":"Larsen, Jens E.","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Peter","key":"kjeldsenpau","last":"Kjeldsen","locid":"49899b92-45e7-485d-88cb-faf95e4ac0d7","name":"Kjeldsen, Peter","orcid":"0000-0003-2738-9960","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Charlotte","key":"scheutzpau","last":"Scheutz","locid":"48fe2850-fdc6-4282-9b97-ac5773419e5c","name":"Scheutz, Charlotte","orcid":"0000-0003-2218-5934","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","NIRAS A/S","Private Research","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-a1e9b093-ba58-4d24-8093-543a4f448acb"],"src":["DTU Technical University of Denmark"],"title":"Closing the methane mass balance for an old danish landfill","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-352885","year":"2019","yearsub":"2019"}
{"abstract":"Introduction The safety of cosmetics containing hydrolysed wheat proteins has been questioned, due to reports of food allergy to wheat hydrolysates and breakage of oral tolerance to wheat after cosmetic usage. Rationale Skin sensitising capacity of 5 commercial wheat products with different physicochemical characteristics were evaluated on skin with various barrier-defects and inflammatory conditions, in either wheat tolerant or naïve rats. We hypothesised that several factors influence the skin sensitising capacity of wheat products. Methods Brown Norway rats bred on a wheat-free diet (naïve rats), or a conventional chow (wheat-tolerant rats), were sensitised by skin-application of unmodified wheat, enzyme hydrolysed or, one of three acid hydrolysed wheat products on either intact, slightly damaged, or skin with experimental irritant dermatitis or atopic dermatitis. Sensitising capacity of wheat products was evaluated by specific IgE and in vivo elicitation tests. Results Sensitising capacity of the 5 wheat products was dependent on the product’s physicochemical characteristics, both in naïve and tolerant rats. Whereas all 5 products could sensitise naive animals only the acid hydrolysed products could sensitise wheat-tolerant rats. Thus, acid hydrolysed wheat could break oral tolerance. The skin condition heavily influenced the sensitising capacity of the products, which was enhanced by skin damage and inflammation. Conclusions This study demonstrate that skin sensitisation can be driven by commercially available wheat-derived products, and is dependent on the specific physicochemical features of the product and the physical and inflammatory condition of the exposed skin. Addition of food-derived proteins to cosmetics should be carefully evaluated due to the risk of sensitisation.","author_count":5,"contributors":["Bøgh, Katrine Lindholm","Ballegaard, Anne-Sofie Ravn","Larsen, Jeppe Madura","Maryniak, Natalia Zofia","Madsen, Charlotte Bernhard"],"cuid":["S01-000.00-361350"],"event":{"end":"2019-01-28","place":"Honolulu, us","start":"2019-01-27","title":"AAAI-19 WORKSHOP ON AFFECTIVE CONTENT ANALYSIS &amp; CL-AFF HAPPINESS SHARED TASK","year":"2019"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"oral tolerance skin inflammation and physicochemical characteristics of wheat derived products influence cutaneous sensitisation to wheat","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-361350","ids":["dtu-be121329-f23d-494d-83fb-9971dc16d502"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-54E541C18E71FA2B00ED0F4954BFF271"],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Food Institute","Technical University of Denmark, National Food Institute, Research Group for Food Allergy"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Katrine Lindholm","key":"bøghpau","last":"Bøgh","locid":"69dcdef2-7e2a-4c8c-966b-dd14c90e6419","name":"Bøgh, Katrine Lindholm","orcid":"0000-0002-5266-0372","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anne-Sofie","key":"ravnballegaardpau","last":"Ravn Ballegaard","locid":"6e19ac48-6dd5-40c9-a7de-6705b99346bf","name":"Ballegaard, Anne-Sofie Ravn","name_org":"Ravn Ballegaard, Anne-Sofie","orcid":"0000-0001-9925-5983","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jeppe","key":"maduralarsenpau","last":"Madura Larsen","locid":"fe5aeb36-c03b-49e1-9e39-31127e951953","name":"Larsen, Jeppe Madura","name_org":"Madura Larsen, Jeppe","orcid":"0000-0003-1492-0708","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Natalia Zofia","key":"maryniakpau","last":"Maryniak","locid":"3c1e2408-fa55-4277-bd35-3811b4619bc2","name":"Maryniak, Natalia Zofia","orcid":"0000-0003-1121-4285","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Charlotte Bernhard","key":"madsenpau","last":"Madsen","locid":"5def08bb-cc87-455f-9c7e-5b0d7877a338","name":"Madsen, Charlotte Bernhard","orcid":"0000-0002-9086-7120","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.jaci.2018.12.983","issn":["00916749","10858725"],"issn_org":["00916749"],"issue":"Suppl. 2","journal":"Journal of Allergy and Clinical Immunology","paperid":"AB434","publisher":"Elsevier","status":"p","title":"Journal of Allergy and Clinical Immunology","volume":"143"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-be121329-f23d-494d-83fb-9971dc16d502"],"src":["DTU Technical University of Denmark"],"title":"Oral Tolerance, Skin Inflammation and Physicochemical Characteristics of Wheat-Derived Products Influence Cutaneous Sensitisation to Wheat","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-361350","year":"2019","yearsub":"2019"}
{"author_count":11,"contributors":["Hansen, Birgitte","Christiansen, Anders Vest","Dalgaard, Tommy","Jørgensen, Flemming","Iversen, Bo V.","Larsen, Jakob Juul","Kjærgaard, Charlotte","Jacobsen, Brian H.","Auken, Esben","Højberg, Anker Lajer","Schaper, Stefan"],"cuid":["S01-000.00-441777"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-PR","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-GEUS"],"HO":["DI-HO-ALL","DI-HO-CDR"],"PR":["DI-PR-ALL","DI-PR-SEGES"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-GV-GEUS","DI-HO-CDR","DI-PR-SEGES","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"danish review on advances in assessing n retention in the subsurface in relation to future targeted n regulation of agriculture","src":["ku"],"src-code":["DI-U-KU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://vandmodel.dk/media/6746/d26_synthesis_report_mapfield.pdf","version":"Published Version"},"id":"S01-000.00-441777","ids":["ku-50f67f0b-b6ed-4427-a5fa-4189980e3a89"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-A9431915202D43DE64BE4F7C0435017B"],"oa_link":[{"access":"oa","type":"rem","url":"https://vandmodel.dk/media/6746/d26_synthesis_report_mapfield.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"geus geological survey of denmark and greenland","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-GEUS","l3nn":"GEUS Geological Survey of Denmark and Greenland","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"GEUS Geological Survey of Denmark and Greenland","namevar":["Geological Survey of Denmark and Greenland"],"nora_code":"DI-GV-GEUS","used":1},{"affno":"2","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"A