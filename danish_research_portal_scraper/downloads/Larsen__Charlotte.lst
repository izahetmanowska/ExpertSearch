Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Bispebjerg and Frederiksberg Hospitals"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Charlotte Raadkjær","key":"lykkegaardpau","last":"Lykkegaard","locid":"79c38dcf-9047-47c0-8129-a1dbc84ff382","name":"Lykkegaard, Charlotte Raadkjær","orcid":"0000-0002-6559-2807","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Helene Støttrup","key":"andersenpau","last":"Andersen","locid":"e73bebd7-7ff7-4692-9457-ddac75cde83b","name":"Andersen, Helene Støttrup","orcid":"0009-0006-0237-9271","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sonja","key":"wehbergpau","last":"Wehberg","locid":"2a11b516-c573-4a93-88f1-4a86a858b664","name":"Wehberg, Sonja","orcid":"0000-0003-1503-2649","rank":3,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"country":"dk","first":"Sinead","key":"holdenpau","last":"Holden","locid":"8cd76341-9177-4b45-b939-3c487530e766","name":"Holden, Sinead","rank":4,"rolecode":"pau"},{"affno":"1 4","corresponding":null,"first":"Frans Boch","key":"waldorffpau","last":"Waldorff","locid":"fe7333f7-ac6d-4ad4-84b7-fdf7b5bf6d22","name":"Waldorff, Frans Boch","orcid":"0000-0002-7859-633X","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens","key":"søndergaardpau","last":"Søndergaard","locid":"4829db0c-8486-4ad1-8e6b-d4f3dc56c386","name":"Søndergaard, Jens","orcid":"0000-0002-1629-1864","rank":6,"rolecode":"pau"},{"affno":"5","corresponding":null,"country":"dk","first":"Lisbeth Runge","key":"larsenpau","last":"Larsen","locid":"5e6862b3-bad8-4a63-aebf-424468603937","name":"Larsen, Lisbeth Runge","rank":7,"rolecode":"pau"},{"affno":"1 6","corresponding":null,"first":"Heidi","key":"klakkpau","last":"Klakk","locid":"962412f0-020a-41bf-9b4b-47f926964062","name":"Klakk, Heidi","orcid":"0000-0002-9299-4334","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Niels","key":"wedderkopppau","last":"Wedderkopp","locid":"bcfae344-0a75-458d-8ba2-4198ee915d40","name":"Wedderkopp, Niels","orcid":"0000-0002-9660-6618","rank":9,"rolecode":"pau"}],"pmid":["36914739"],"pub":{"doi":"10.1038/s41598-023-31344-x","issn":["20452322"],"issue":"1","journal":"Scientific Reports","paperid":"4133","publisher":"Nature Publishing Group","status":"p","title":"Scientific Reports","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-85150095261"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","All University Colleges","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","Hospitals","UCL University College","Universities","University Colleges","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-27651e23-2d4d-4993-8b0b-fdb0310369da","ku-14ac6b53-3216-4fec-8cf3-297f96f838ab","sdu-2e43c00a-8381-44f3-9a20-4236099a568b","ucl-f5baf897-12c5-4655-b72d-2fe048a1ca1e"],"src":["AAU Aalborg University","KU University of Copenhagen","SDU University of Southern Denmark","UCL University College"],"title":"The association between childhood motor performance and developmental trajectories of sport participation over 5 years in Danish students aged 6-16-year-old","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-094.54-672260","year":"2023","yearsub":"2023"}
{"abstract":"Tilbage i 2005 gennemførte Trafikforskningsgruppen sammen med Odense Kommune et projekt, hvor vi testede den sikkerhedsmæssige effekt af kørelys på cykel. Vi testede den sikkerhedsmæssige effekt på en, på det tidspunkt, nyudviklet magnetlygte, som konstant blinkede. Testen var tilrettelagt som et lodtrækningsstudie, hvor 4.000 cyklister fra Odense deltog – 2.000 fik monteret lygten, og 2.000 var kontrolgruppe. Testen viste signifikante resultater, idet testgruppen havde 47 % færre flerpartsulykker med personskade end kontrolgruppen. Lygterne var udviklet og stillet til rådighed af firmaet Reelight. I 2017 henvendte Jochum Kirsebom fra Reelight (www.reelight.dk) sig til Trafikforskningsgruppen med henblik på at gentage forsøget fra 2005, men nu med en ny generation af kørelys, der lyser langt kraftigere end 2005-lygterne. Efter en periode, hvor projektet blev planlagt, og der blev skaffet finansiering til Trafikforskningsgruppens deltagelse i projektet, blev projektet igangsat i 2020. Lygterne blev også denne gang stillet til rådighed af Reelight, og igen blev projektet planlagt i tæt samarbejde med Odense Kommune, mens deltagelse denne gang ikke blev begrænset til indbyggere i Odense. Trafikforskningsgruppen vil gerne takke Troels Andersen og Tanja Bruntse Andersen, begge fra Odense Kommune, for hjælpen med planlægningen af projektet. Vi vil også gerne takke Reelight for at stille lygterne til rådighed, men også for at respektere den armslænge, der nødvendigvis har måttet være mellem producenten af lygten og dem, der evaluerer lygten. Endelig vil vi gerne takke A.P. Møller Fonden og Det Nissenske Familiefond for økonomisk støtte til projektet, uden hvilken projektet ikke ville have været muligt.","author_count":8,"contributors":["Lahrmann, Harry","Christensen, Michelle Cederstrøm","Tallaksen, Anders Brogaard","Tønning, Charlotte","Larsen, Mette Kathrine","Madsen, Tanja Kidholm Osmann","Rasmussen, Line Røjkjær","Olesen, Anne Vingaard"],"cuid":["S01-000.00-064044"],"filters":{"added":"2023-03","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Sikkerhed","Trafik","Ulykker"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"nr","rtype":["clu"],"sorti":"projekt cykelliv en undersøgelse af den sikkerhedsmæssige effekt af kørelys på cykler","src":["aau"],"src-code":["DI-U-AAU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://vbn.aau.dk/ws/files/515256123/Projekt_Cykelliv.pdf","version":"Published Version"},"id":"S01-000.00-064044","ids":["aau-30579b3a-3e03-4da7-8c0a-f7b5c2ed684f"],"keyword":["Cykellygter","Sikkerhed","Trafik","Ulykker"],"lang":"Danish","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-3537B659CF4413586DC0BEA0CE7A477B"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://vbn.aau.dk/ws/files/515256123/Projekt_Cykelliv.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment, Division of Civil and Environmental Engineering","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment, Traffic Research Group","Aalborg University, The Technical Faculty of IT and Design, Department of Computer Science, CITS"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Harry","key":"lahrmannpau","last":"Lahrmann","locid":"7e1bc853-b677-467c-87ae-54b08116b7e4","name":"Lahrmann, Harry","orcid":"0000-0001-6339-4586","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Michelle Cederstrøm","key":"christensenpau","last":"Christensen","locid":"ee6729ff-07b6-45cb-b75e-b462106ba574","name":"Christensen, Michelle Cederstrøm","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anders Brogaard","key":"tallaksenpau","last":"Tallaksen","locid":"db5117b0-e079-499a-9e09-2738abc003f6","name":"Tallaksen, Anders Brogaard","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Charlotte","key":"tønningpau","last":"Tønning","locid":"f1d118d0-05c0-4c0e-b005-3038109659a4","name":"Tønning, Charlotte","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mette Kathrine","key":"larsenpau","last":"Larsen","locid":"148d7797-8067-4e4a-8c4e-88c0abcc9934","name":"Larsen, Mette Kathrine","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Tanja Kidholm Osmann","key":"madsenpau","last":"Madsen","locid":"e7bda905-fb0a-4545-9140-cad6d9b45c73","name":"Madsen, Tanja Kidholm Osmann","orcid":"0000-0002-0513-752X","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Line Røjkjær","key":"rasmussenpau","last":"Rasmussen","locid":"b172f930-ea77-4806-a3d9-edbbe7fb8df7","name":"Rasmussen, Line Røjkjær","orcid":"0000-0002-4533-8748","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anne Vingaard","key":"olesenpau","last":"Olesen","locid":"2452b28f-e318-4c14-947b-42e0dd07d1a3","name":"Olesen, Anne Vingaard","orcid":"0000-0002-1503-8269","rank":8,"rolecode":"pau"}],"pub":{"issn":["25973118"],"issue":"02","pages":"30","place":"Aalborg","publisher":"Institut for Byggeri, By og Miljø (BUILD), Aalborg Universitet","repno":"BUILD Rapport, No. 02","series":"BUILD Rapport","status":"p"},"review":"No Review","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-30579b3a-3e03-4da7-8c0a-f7b5c2ed684f"],"src":["AAU Aalborg University"],"title":"Projekt Cykelliv : en undersøgelse af den sikkerhedsmæssige effekt af kørelys på cykler","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-064044","year":"2023","yearsub":"2023"}
{"abstract":"Algoritmer gennemsyrer vores dagligdag og blander sig i vores relationer. Algoritmer er ikke neutrale, men er desig-net til at få bestemte ting og praksisser til at ske. Algoritmer fremkalder følelser, og små designgreb på sociale medier har en betydning for vores samvær og selvopfattelse. Den-ne artikel handler om algoritmer, og hvad det vil sige at vokse op med sociale medier som en integreret del af hver-dagslivet. Hvordan forstår børn og unge de algoritmer og designgreb, der rammesætter deres oplevelser på sociale medier som TikTok, Snapchat og Instagram? Artiklen præ-senterer begrebet ’algorithmic literacy’ og kommer med bud på 10 vigtige vidensområder for børn og unge – og alle os andre.","author_count":1,"contributors":["Larsen, Malene Charlotte"],"cuid":["S01-000.00-079743"],"filters":{"added":"2023-03","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"sociale medier og algoritmer i hverdagen at vokse op med platformenes rammesætning af det sociale liv","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://kvan.dk/vare/kvan-125-online/","version":"Other Version"},"id":"S01-000.00-079743","ids":["aau-663bd03e-6049-48b5-8598-7df76a64b099"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-6268A32B2E23D93D17DD79B448F29905"],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Social Sciences and Humanities","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Digital Media in Everyday Life","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Exploring Methods for Participation and Dialogue in Communication Research","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Mediated Communication"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Malene Charlotte","key":"larsenpau","last":"Larsen","locid":"cc0033d3-6794-4e0c-b451-939e05f9a1ee","name":"Larsen, Malene Charlotte","orcid":"0000-0003-4821-5855","rank":1,"rolecode":"pau"}],"pub":{"issn":["01074016"],"journal":"Kvan - et tidsskrift for læreruddannelsen og folkeskolen","pages":"69-82","status":"p","title":"Kvan - et tidsskrift for læreruddannelsen og folkeskolen","volume":"125"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-663bd03e-6049-48b5-8598-7df76a64b099"],"src":["AAU Aalborg University"],"title":"Sociale medier og algoritmer i hverdagen – at vokse op med platformenes rammesætning af det sociale liv","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-079743","year":"2023","yearsub":"2023"}
{"abstract":"Evidence regarding cancer risk after borderline ovarian tumors (BOTs) is limited. We conducted a nationwide cohort study examining the incidence of nonovarian cancers in women with serous or mucinous BOTs compared with the general female population with up to 41 years of follow-up. Through the nationwide Pathology Registry, we identified nearly 5000 women with BOTs (2506 serous and 2493 mucinous) in Denmark, 1978 to 2018. We computed standardized incidence ratios (SIRs) with 95% confidence intervals (CIs) as relative risk estimates of specific nonovarian cancers. Compared with general female population rates, women with serous BOTs had increased rates of particularly malignant melanoma (SIR = 1.9; 95% CI: 1.3-2.6), thyroid cancer (SIR = 3.0; 95% CI: 1.4-5.4) and myeloid leukemia (SIR = 3.2; 95% CI: 1.5-5.8), and women with mucinous BOTs had elevated rates of lung cancer (SIR = 1.7; 95% CI: 1.3-2.1), pancreatic cancer (SIR = 1.9; 95% CI: 1.2-2.9) and myeloid leukemia (SIR = 2.3; 95% CI: 0.9-4.7). We found no convincing association with neither breast nor colorectal cancer in women with BOTs. This is the first large nationwide study showing that women with specific types of BOTs have increased risks of several nonovarian cancers, likely due to some shared risk factors or genetic characteristics.","author_count":7,"contributors":["Hannibal, Charlotte G.","Baandrup, Louise","Hertzum-Larsen, Rasmus","Vang, Russell","Kurman, Robert J.","Frederiksen, Kirsten","Kjaer, Susanne K."],"cuid":["S01-000.00-445369"],"filters":{"added":"2023-03","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Johns Hopkins University"],"keyword":["Borderline ovarian tumors","Cancer risk","Cohort study","Nationwide"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-NP","DI-U"],"level3":{"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-NP-CAN","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"risk of nonovarian cancer in a nationwide based study of nearly 000000005000 women with borderline ovarian tumors in denmark","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1002/ijc.34354","version":"Published Version"},"id":"S01-000.00-445369","identifier":[{"id":"PMC10099848","type":"pmcid"},{"id":"36366853","type":"pmid"},{"id":"85142665612","type":"scopus"}],"ids":["ku-56e31d34-87c7-482a-9394-d0d319063573"],"keyword":["borderline ovarian tumors","cancer risk","cohort study","nationwide","standardized incidence ratios"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-745E73F239C0B83C8D7DAD477AC2AABC"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/335694263/Intl_Journal_of_Cancer_2022_Hannibal_Risk_of_nonovarian_cancer_in_a_nationwide_based_study_of_nearly_5000_women_with.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1002/ijc.34354","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"dcrc danish cancer society research center","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-CAN","l3nn":"DCRC Danish Cancer Society Research Center","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DCRC Danish Cancer Society Research Center","namevar":["Danish Cancer Society"],"nora_code":"DI-NP-CAN","used":1},{"affno":"2","country":"us","key":"johns hopkins university","loc":["United States","America, North","OECD"],"name":"Johns Hopkins University","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Obstetrics and Gynaecology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Charlotte G.","key":"hannibalpau","last":"Hannibal","name":"Hannibal, Charlotte G.","rank":1,"rolecode":"pau"},{"affno":"1","first":"Louise","key":"baandruppau","last":"Baandrup","name":"Baandrup, Louise","rank":2,"rolecode":"pau"},{"affno":"1","first":"Rasmus","key":"hertzumlarsenpau","last":"Hertzum-Larsen","name":"Hertzum-Larsen, Rasmus","rank":3,"rolecode":"pau"},{"affno":"2","first":"Russell","key":"vangpau","last":"Vang","name":"Vang, Russell","rank":4,"rolecode":"pau"},{"affno":"2","first":"Robert J.","key":"kurmanpau","last":"Kurman","name":"Kurman, Robert J.","rank":5,"rolecode":"pau"},{"affno":"1","first":"Kirsten","key":"frederiksenpau","last":"Frederiksen","name":"Frederiksen, Kirsten","rank":6,"rolecode":"pau"},{"affno":"3","first":"Susanne Krüger","key":"kjaerpau","last":"Kjaer","locid":"1c671dbc-6a27-49fd-ba11-6d26a9a07047","name":"Kjaer, Susanne K.","name_org":"Kjaer, Susanne Krüger","rank":7,"rolecode":"pau"}],"pmid":["36366853"],"pub":{"doi":"10.1002/ijc.34354","issn":["00207136"],"issue":"7","journal":"International Journal of Cancer","pages":"1370-1377","status":"p","title":"International Journal of Cancer","volume":"152"},"review":"Peer Reviewed","scoID":["2-s2.0-85142665612"],"search":{"DAF":["All Danish Affiliations","All Non-Profit Organisations","All Universities","DI-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Non-Profit Organisations","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-56e31d34-87c7-482a-9394-d0d319063573"],"src":["KU University of Copenhagen"],"title":"Risk of nonovarian cancer in a nationwide-based study of nearly 5000 women with borderline ovarian tumors in Denmark","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-445369","year":"2023","yearsub":"2023"}
{"abstract":"The purpose was to analyse the association of muscular strength, muscle pain and reduced mobility in daily life with mental wellbeing among older Inuit men and women in Greenland. Data (N = 846) was collected as part of a countrywide cross-sectional health survey in 2018. Hand grip strength and 30-seconds chair stand test were measured according to established protocols. Mobility in daily life was assessed by five questions about the ability to perform specific activities of daily living. Mental wellbeing was assessed by questions about self-rated health, life satisfaction and Goldberg's General Health Questionnaire. In binary multivariate logistic regression models adjusted for age and social position, muscular strength (OR 0.87-0.94) and muscle pain (OR 1.53-1.79) were associated with reduced mobility. In fully adjusted models, muscle pain (OR 0.68-0.83) and reduced mobility (OR 0.51-0.55) but were associated with mental wellbeing. Chair stand score was associated with life satisfaction (OR 1.05). With an increasingly sedentary lifestyle, increasing prevalence of obesity and increasing life expectancy the health consequences of musculoskeletal dysfunction are expected to grow. Prevention and clinical handling of poor mental health among older adults need to consider reduced muscle strength, muscle pain and reduced mobility as important determinants.","author_count":6,"contributors":["Bjerregaard, Peter","Ottendahl, Charlotte Brandstrup","Jensen, Tenna","Nørtoft, Kamilla","Jørgensen, Marit Eika","Larsen, Christina Viskum Lytken"],"cuid":["S01-000.00-640079"],"filters":{"added":"2023-05","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Nordic"],"corresponding_author":["Bjerregaard, Peter"],"country":["Greenland"],"glorg":["All Global Affiliations","Grønlands Universitet","Steno Diabetes Center Greenland"],"keyword":["Greenland","Inuit","Mental wellbeing","Muscle pain","Muscular strength","Older adults"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-STENO"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-STENO","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"muscular strength mobility in daily life and mental wellbeing among older adult inuit in greenland the greenland population health survey 000000002018","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1080/22423982.2023.2184751","version":"Published Version"},"id":"S01-000.00-640079","identifier":[{"id":"PMC10013347","type":"pmcid"},{"id":"36880125","type":"pmid"},{"id":"85149999482","type":"scopus"}],"ids":["sdu-e9889f69-6747-42e5-869e-6d34a06e336d"],"keyword":["Greenland","Inuit","mental wellbeing","mobility in daily life","muscle pain","muscular strength","older adults"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-D821E96AF5F94674EC1965373782A85B"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/224290024/Muscular_strength_mobility_in_daily_life_and_mental_wellbeing_among_older_adult_Inuit_in_Greenland_The_Greenland_population_health_survey_2018.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1080/22423982.2023.2184751","version":"Published Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, National Institute of Public Health","SDU, The Faculty of Health Sciences, National Institute of Public Health, Center for Public health in Greenland"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"gl","key":"grønlands universitet","loc":["Greenland","Nordic"],"name":"Grønlands Universitet","used":1},{"affno":"3","country":"gl","key":"steno diabetes center greenland","loc":["Greenland","Nordic"],"name":"Steno Diabetes Center Greenland","used":1},{"affno":"4","country":"dk","key":"steno diabetes centers","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-STENO","l3nn":"Steno Diabetes Centers","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Steno Diabetes Centers","namevar":["Steno Diabetes Center Copenhagen"],"nora_code":"DI-HO-STENO","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Peter","key":"bjerregaardpau","last":"Bjerregaard","locid":"ef4a2fa7-9735-4b1e-a4fa-b1272def2cfc","name":"Bjerregaard, Peter","orcid":"0000-0001-7153-8447","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Charlotte Brandstrup","key":"ottendahlpau","last":"Ottendahl","locid":"9e2ae085-ebf8-4688-b8cf-c257c5458aca","name":"Ottendahl, Charlotte Brandstrup","orcid":"0000-0002-9285-3099","rank":2,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Tenna","key":"jensenpau","last":"Jensen","locid":"2b6f42ea-feb9-44c4-97df-d05adc089674","name":"Jensen, Tenna","orcid":"0000-0001-9020-0089","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kamilla","key":"nørtoftpau","last":"Nørtoft","locid":"c1aa80db-2ce7-4551-8ed7-f53a1daf2a2c","name":"Nørtoft, Kamilla","orcid":"0000-0002-8081-4789","rank":4,"rolecode":"pau"},{"affno":"1 2 3 4","corresponding":null,"first":"Marit Eika","key":"jørgensenpau","last":"Jørgensen","locid":"5a2309e5-48cd-4773-9887-7b0255811460","name":"Jørgensen, Marit Eika","orcid":"0000-0001-8356-5565","rank":5,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Christina Viskum Lytken","key":"larsenpau","last":"Larsen","locid":"3ee738b1-09d1-4886-9ddf-67ca132997fe","name":"Larsen, Christina Viskum Lytken","orcid":"0000-0002-6245-4222","rank":6,"rolecode":"pau"}],"pmid":["36880125"],"pub":{"doi":"10.1080/22423982.2023.2184751","issn":["12399736","22423982"],"issn_org":["12399736"],"issue":"1","journal":"International Journal of Circumpolar Health","paperid":"2184751","publisher":"Taylor & Francis","status":"p","title":"International Journal of Circumpolar Health","volume":"82"},"review":"Peer Reviewed","scoID":["2-s2.0-85149999482"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-e9889f69-6747-42e5-869e-6d34a06e336d"],"src":["SDU University of Southern Denmark"],"title":"Muscular strength, mobility in daily life and mental wellbeing among older adult Inuit in Greenland. The Greenland population health survey 2018","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-640079","year":"2023","yearsub":"2023"}
{"abstract":"Background: The early epidemiology of the 2022 monkeypox epidemic in non-endemic countries differs substantially from the epidemiology previously reported from endemic countries. We aimed to describe the epidemiological and clinical characteristics among individuals with confirmed cases of monkeypox infection. Methods: We descriptively analysed data for patients with confirmed monkeypox who were included in the GeoSentinel global clinical-care-based surveillance system between May 1 and July 1 2022, across 71 clinical sites in 29 countries. Data collected included demographics, travel history including mass gathering attendance, smallpox vaccination history, social history, sexual history, monkeypox exposure history, medical history, clinical presentation, physical examination, testing results, treatment, and outcomes. We did descriptive analyses of epidemiology and subanalyses of patients with and without HIV, patients with CD4 counts of less than 500 cells per mm3 or 500 cells per mm3 and higher, patients with one sexual partner or ten or more sexual partners, and patients with or without a previous smallpox vaccination. Findings: 226 cases were reported at 18 sites in 15 countries. Of 211 men for whom data were available, 208 (99%) were gay, bisexual, or men who have sex with men (MSM) with a median age of 37 years (range 18–68; IQR 32–43). Of 209 patients for whom HIV status was known, 92 (44%) men had HIV infection with a median CD4 count of 713 cells per mm3 (range 36–1659; IQR 500–885). Of 219 patients for whom data were available, 216 (99%) reported sexual or close intimate contact in the 21 days before symptom onset; MSM reported a median of three partners (IQR 1–8). Of 195 patients for whom data were available, 78 (40%) reported close contact with someone who had confirmed monkeypox. Overall, 30 (13%) of 226 patients were admitted to hospital; 16 (53%) of whom had severe illness, defined as hospital admission for clinical care rather than infection control. No deaths were reported. Compared with patients without HIV, patients with HIV were more likely to have diarrhoea (p=0·002), perianal rash or lesions (p=0·03), and a higher rash burden (median rash burden score 9 [IQR 6–21] for patients with HIV vs median rash burden score 6 [IQR 3–14] for patients without HIV; p<0·0001), but no differences were identified in the proportion of men who had severe illness by HIV status. Interpretation: Clinical manifestations of monkeypox infection differed by HIV status. Recommendations should be expanded to include pre-exposure monkeypox vaccination of groups at high risk of infection who plan to engage in sexual or close intimate contact. Funding: US Centers for Disease Control and Prevention, International Society of Travel Medicine.","author_count":29,"contributors":["Angelo, Kristina M.","Smith, Teresa","Camprubí-Ferrer, Daniel","Balerdi-Sarasola, Leire","Díaz Menéndez, Marta","Servera-Negre, Guillermo","Barkati, Sapha","Duvignaud, Alexandre","Huber, Kristina L.B.","Chakravarti, Arpita","Bottieau, Emmanuel","Greenaway, Christina","Grobusch, Martin P.","Mendes Pedro, Diogo","Asgeirsson, Hilmir","Popescu, Corneliu Petru","Martin, Charlotte","Licitra, Carmelo","de Frey, Albie","Schwartz, Eli","Beadsworth, Michael","Lloveras, Susana","Larsen, Carsten Schade","Guagliardo, Sarah Anne J.","Whitehill, Florence","Huits, Ralph","Hamer, Davidson H.","Kozarsky, Phyllis","Libman, Michael"],"cuid":["S01-000.00-667990"],"filters":{"added":"2023-06","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Africa","America, North","Asia, Middle East","Europe, EU","Europe, Non-EU","Nordic","OECD"],"corpau":["GeoSentinel Network Collaborators"],"corresponding_author":["Angelo, Kristina M."],"country":["Belgium","Canada","France","Germany","Israel","Italy","Netherlands","Portugal","Romania","South Africa","Spain","Sweden","United Kingdom","United States"],"glorg":["All Global Affiliations","Amsterdam UMC","Barcelona Institute for Global Health","Boston University","CHU de Bordeaux","Carol Davila University of Medicine and Pharmacy","Emory University","IRCCS Ospedale Sacro Cuore Don Calabria","Institute of Tropical Medicine Antwerp","Karolinska Institutet","Liverpool School of Tropical Medicine","Ludwig Maximilian University","McGill University","Orlando Regional Medical Center","Sheba Medical Center at Tel Hashomer","Spitalul de Boli Infectioase Si Tropicale, Dr. Vitor Babeş","Tel Aviv University","U.S. Centers for Disease Control and Prevention","United States Department of Energy","Universidad Autónoma de Madrid","University of Amsterdam","University of Lisbon","University of Montreal","University of the Witwatersrand","Université Libre de Bruxelles"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"epidemiological and clinical characteristics of patients with monkeypox in the geosentinel network a cross sectional study","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://pmc.ncbi.nlm.nih.gov/articles/PMC9546520/pdf/main.pdf","version":"Published Version"},"id":"S01-000.00-667990","identifier":[{"id":"PMC9546520","type":"pmcid"},{"id":"85141343419","type":"scopus"},{"id":"36216018","type":"pmid"}],"ids":["au-31bee6c5-7550-46a7-a901-9a765c6c6922"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-A2A02249559AFB540EFFF89086945094"],"oa_link":[{"access":"oa","type":"rem","url":"https://pmc.ncbi.nlm.nih.gov/articles/PMC9546520/pdf/main.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"us","key":"u s centers for disease control and prevention","loc":["United States","America, North","OECD"],"name":"U.S. Centers for Disease Control an