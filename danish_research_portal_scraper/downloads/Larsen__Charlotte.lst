cil","namevar":["Danish Agriculture and Food Council"],"nora_code":"DI-PR-AAF","used":1}],"person":[{"affno":"1","corresponding":null,"first":"S.S.","key":"jakobsenpau","last":"Jakobsen","name":"Jakobsen, S.S.","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Charlotte Kristiane","key":"hjulsagerpau","last":"Hjulsager","locid":"6c1511ef-8211-4653-8c81-cd55b7f63f64","name":"Hjulsager, Charlotte Kristiane","orcid":"0000-0001-7557-8876","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"C.S.","key":"christensenpau","last":"Christensen","name":"Christensen, C.S.","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter","key":"lindpau","last":"Lind","locid":"c9f6ac37-55ba-40db-804f-a90505a96532","name":"Lind, Peter","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"H.","key":"bakpau","last":"Bak","name":"Bak, H.","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars Erik","key":"larsenpau","last":"Larsen","locid":"09c2a33d-b353-44de-a850-f3c7dec879cb","name":"Larsen, Lars Erik","orcid":"0000-0003-0730-5555","rank":6,"rolecode":"pau"}],"pub":{"status":"p","title":"Proceedings of the 23rd IPVS Congress"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Danish Agriculture & Food Council","Private Research","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-db95baa8-0fe1-4cd1-8721-33d1357b0498"],"src":["DTU Technical University of Denmark"],"title":"Respiratory disease in finishers – comparisons of diagnostic tools","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-370266","year":"2014","yearsub":"2014"}
{"abstract":"Many bulk ships have multiple tanks and can thereby carry multiple inhomogeneous products at a time. A major challenge when operating such ships is how to best allocate cargoes to available tanks while taking tank capacity, safety restrictions, ship stability and strength as well as other operational constraints into account. The complexity of the allocation problem varies with the number of tanks and the number and type of dierent products transported at the same time, and the problem of nding a feasible solution has been shown to be NP-Complete. The Tank Allocation Problem (TAP) as described above is an operational planning problem but it also arises as a subproblem in tactical planning when routing bulk ship eets. For each considered route, the TAP must be solved to assess route feasibility with respect to stowage. If the routing problem is solved in a way that requires assessment of numerous routes, as for instance in column generation and local search based methods, the solution time for the entire procedure will only be acceptable if the TAP can be solved eciently. We consider the TAP from a tactical perspective where the main objective is to quickly assess feasibility of a given ship route. We have developed a randomised heuristic for eciently nding feasible allocations and computational results show that it can solve 99% of the considered instances within 0.5 seconds and all of them if allowed longer time. The heuristic is designed to work as an ecient subproblem solver and in such a setting with running times below e.g. 5 seconds, the heuristic clearly outperforms an earlier method by consistently solving more instances and eectively cutting 84% of the average running time. Furthermore, we have combined our heuristic with a modied version of the earlier method to derive a hybrid method that can eciently solve all instances. Compared to the earlier method, this hybrid method cuts 93% of the average running times and consistently solves more instances than the other method within any given time limit.","author_count":3,"contributors":["Vilhelmsen, Charlotte","Larsen, Jesper","Lusby, Richard Martin"],"cuid":["S01-000.00-380116"],"event":{"end":"2014-03-07","place":"Lisbon, pt","start":"2014-03-04","title":"3rd International Symposium on Combinatorial Optimization","year":"2014"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"a heuristic and hybrid method for the tank allocation problem in maritime bulk shipping","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/89617392/prod11395127544356.ISCO2014_Abstract.pdf","version":"Authors Final Version"},"id":"S01-000.00-380116","ids":["dtu-fc835730-054c-4b73-86ee-85afcc2421b3"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-AD6075429C85860109C3609C2BE1BF44"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/89617392/prod11395127544356.ISCO2014_Abstract.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Management Engineering","Technical University of Denmark, Department of Management Engineering, Management Science"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Charlotte","key":"vilhelmsenpau","last":"Vilhelmsen","locid":"6ceebc69-a38c-4b56-90