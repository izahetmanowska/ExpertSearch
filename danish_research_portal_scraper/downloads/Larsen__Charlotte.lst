name":"Thomsen, Annika","rank":7,"rolecode":"pau"},{"affno":"5","corresponding":null,"country":"dk","first":"Peter","key":"povlsenpau","last":"Povlsen","locid":"784c6e25-60fd-4e92-b942-d2cd7f6d042e","name":"Povlsen, Peter","orcid":"0000-0002-1159-2035","rank":8,"rolecode":"pau"},{"affno":"5","corresponding":null,"country":"dk","first":"Hanne Lyngholm","key":"larsenpau","last":"Larsen","locid":"806cdba3-0da2-4ea7-a73c-e64bc45ce26b","name":"Larsen, Hanne Lyngholm","rank":9,"rolecode":"pau"},{"affno":"6","corresponding":null,"country":"dk","first":"Anne Cathrine","key":"linderpau","last":"Linder","locid":"8dfaf4cb-a938-40d3-9af6-85971ae82b79","name":"Linder, Anne Cathrine","orcid":"0000-0002-6556-7847","rank":10,"rolecode":"pau"},{"affno":"5","corresponding":null,"country":"dk","first":"Sussie","key":"paghpau","last":"Pagh","locid":"ebf3bb90-5d85-4380-8a86-1f5ff811c011","name":"Pagh, Sussie","orcid":"0000-0002-1574-3638","rank":11,"rolecode":"pau"}],"pmid":["37370458"],"pub":{"doi":"10.3390/ani13121948","issn":["20762615"],"issue":"12","journal":"Animals","pages":"1-8","paperid":"1948","publisher":"Multidisciplinary Digital Publishing Institute (MDPI)","status":"p","title":"Animals","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-85163891036"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Technical University of Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-e1961916-c39a-40ac-8e0c-1119f01b25d7","au-aac1a794-32ef-452e-92f1-52b19122d949","dtu-6a4f6f82-80dc-4dab-b24c-91084e7f3e9a","sdu-a8bb73e3-ddab-4c1d-bf3e-a8aec5ee7790"],"src":["AAU Aalborg University","AU Aarhus University","DTU Technical University of Denmark","SDU University of Southern Denmark"],"title":"The Self-Stranding Behavior of a Killer Whale (<i>Orcinus orca</i>) in Inner Danish Waters and Considerations concerning Human Interference in Live Strandings","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-094.54-681311","year":"2023","yearsub":"2023"}
{"abstract":"The “11 for Health in Denmark” in-school educational football program has shown to have numerous positive physiological and psychological effects in 10- to 12-year-old schoolchildren. A key part of the successful application of the program, however, has not yet been examined, namely the motivational processes underlying participation and behavioral changes. This study examined such motivational processes (i.e., autonomous motivation, beliefs, and intentions) using the trans-contextual model (TCM) and investigated if the 11 for Health in Denmark program increased intentions to participate in physical activity (PA) outside of school in 10- to 12-year-old schoolchildren. Using a web-based questionnaire, Danish-speaking schoolchildren (N = 276 [boys, 50.4%]; Mage = 10.44, SD = 0.35) from three schools and seven classes completed TCM-based questionnaires at three time-points (weeks 0, 1, and 5) while participating in the 11 for Health in Denmark program. Single-indicator structural equation modeling was performed to examine goodness-of-fit and parameter estimates. A path analysis using maximum likelihood estimation was used to test the direct and indirect effects of the TCM model. The results partly supported a mediation sequence, as we found significant direct effects in eight of 13 motivational variables (β = −0.25–0.83, p < 0.05), indirect effects in one of nine variables (β = 0.15, p < 0.01), but no effects with regard to PA behavior. Findings provide evidence for a motivational link between Danish-speaking schoolchildren's autonomous and controlled motivation from in school to out of school, and may inform future interventions promoting motivation and participation in out of school PA.","author_count":13,"contributors":["Madsen, Esben Elholm","Krustrup, Peter","Hansen, Tina","Aggestrup, Charlotte Sandager","Ntoumanis, Nikos","Larsen, Carsten Hvid","Pfeffer, Kristina","Ivarsson, Andreas","Ryom, Knud","Larsen, Malte Nejst","Madsen, Mads","Madsen, Jeppe Elholm","Elbe, Anne Marie"],"cuid":["S04-100.00-666489"],"filters":{"added":"2022-11","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"continent":["Europe, EU","Nordic","OECD"],"corresponding_author":["Madsen, Esben Elholm"],"country":["Germany","Sweden"],"glorg":["All Global Affiliations","Halmstad University","Leipzig University"],"keyword":["Child","Exercise","Football","Humans","Physical activity","Schools","Self determination theory","Soccer","Theory of planned behavior","trans contextual model"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U","DI-UC"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"],"UC":["DI-UC-ALL","DI-UC-KP"]},"level3all":["DI-HO-CAP","DI-U-AU","DI-U-KU","DI-U-SDU","DI-UC-KP"]},"review":"pr","rtype":["clu"],"sorti":"motivational predictors of children s involvement in out of school activities an application of a football program","src":["au","kp","ku","sdu"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU","DI-UC-KP"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1111/sms.14236","version":"Published Version"},"funding_acknowledgement":["We would like to thank the schoolchildren for participating in the study and the teachers for supporting it. We would like to thank Professor Jiri Dvorak for the support and help in developing the original FIFA 11 for Health program. We would also like to thank DBU for our excellent collaboration when preparing, designing, and implementing the 11 for Health in Denmark concept for the schoolchildren, teachers and additional stakeholders. This study was supported by the Nordea-Foundation (Nordea-fonden), DBU and Aase and Ejnar Danielsens Foundation."],"id":"S04-100.00-666489","identifier":[{"id":"85138554038","type":"scopus"},{"id":"36111371","type":"pmid"},{"id":"PMC10087348","type":"pmcid"}],"ids":["au-c8233326-1070-4329-b60c-0cd7f5d15735","kp-28676bd9-4b0d-4ae3-9b38-671a2c3912ed","ku-5429a496-2a15-4ce3-86de-5b26df0f1a05","sdu-e298e68b-6d63-411c-96f3-a51dc6b309fd"],"keyword":["Child","Exercise","Humans","Schools","Soccer","football","physical activity","self-determination theory","theory of planned behavior","trans-contextual model"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-7-9379DDEFCF551BBC6702513185DEF805"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/216892575/Scandinavian_Med_Sci_Sports_2022_Madsen_Motivational_predictors_of_children_s_involvement_in_out_of_school_activities_1_.pdf","version":"Published Version"},{"access":"oa","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC10087348/pdf/SMS-33-72.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1111/sms.14236","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/360065395/Scandinavian_Med_Sci_Sports_2022_Madsen_Motivational_predictors_of_children_s_involvement_in_out_of_school_activities.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"kp university college copenhagen","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-KP","l3nl":"KP","l3nn":"KP University College Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KP University College Copenhagen","namevar":["Københavns Professionshøjskole, Rektors område, Fakultet for sundhedsuddannelser - Dekan, Ergoterapeutuddannelsen"],"nora_code":"DI-UC-KP","used":1},{"affno":"2","country":"de","key":"leipzig university","loc":["Germany","Europe, EU","OECD"],"name":"Leipzig University","used":1},{"affno":"3","country":"dk","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU