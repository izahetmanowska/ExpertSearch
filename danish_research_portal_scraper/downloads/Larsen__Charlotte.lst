4","name":"Olesen, Ingelise","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christina Viskum","key":"larsenpau","last":"Larsen","locid":"3ee738b1-09d1-4886-9ddf-67ca132997fe","name":"Larsen, Christina Viskum Lytken","name_org":"Larsen, Christina Viskum","orcid":"0000-0002-6245-4222","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Charlotte Brandstrup","key":"ottendahlpau","last":"Ottendahl","locid":"9e2ae085-ebf8-4688-b8cf-c257c5458aca","name":"Ottendahl, Charlotte Brandstrup","orcid":"0000-0002-9285-3099","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sofie Emma","key":"rubinpau","last":"Rubin","locid":"22c51d73-2438-4e96-bff7-1bd8bc36df25","name":"Rubin, Sofie Emma","orcid":"0009-0005-2281-2741","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peter","key":"bjerregaardpau","last":"Bjerregaard","locid":"ef4a2fa7-9735-4b1e-a4fa-b1272def2cfc","name":"Bjerregaard, Peter","orcid":"0000-0001-7153-8447","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Tenna","key":"jensenpau","last":"Jensen","locid":"2b6f42ea-feb9-44c4-97df-d05adc089674","name":"Jensen, Tenna","orcid":"0000-0001-9020-0089","rank":6,"rolecode":"pau"}],"pub":{"pages":"59","publisher":"Syddansk Universitet. Statens Institut for Folkesundhed","status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-3f0ae89a-b7bf-4deb-912d-001e57534c5a"],"src":["SDU University of Southern Denmark"],"title":"Muligheder og begrænsninger for fødselsbetjeningen set i et udviklingsperspektiv : En undersøgelse af familier og fagpersoners syn på adgang til fødesteder i Grønland","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-702946","year":"2023","yearsub":"2023"}
{"abstract":"A key component of super-resolution ultrasound imaging (SRI) is the detection and tracking of scatterers. These scatterers can be microbubbles (MBs) in SRI, or erythrocytes in SUper Resolution ultrasound imaging using Erythrocytes (SURE). To ensure the reliability of MBs tracking in SRI, the MBs must be sparse. However, the sparse distribution of the MBs necessitates several minutes of acquisition. In contrast, there are large numbers of erythrocytes in SURE. Increasing the number of scatterers can reduce the acquisition time, however tracking uncorrelated and high-density scatterers is quite challenging. It is hypothesized that recursive Synthetic Aperture (SA) imaging will increase the detecting and tracking abilities of the high-density and non-separable scatterers. The hypothesis was verified using a hydrogel 3D-printed micro-flow phantom and a Sprague-Dawley rat kidney. The results show that using recursive SA imaging provides better detection and tracking of high-density and non-separable targets, as well as a smoother and more parabolic velocity profile than conventional SA imaging.","author_count":6,"contributors":["Amin Naji, Mostafa","Taghavi, Iman","Larsen, Niels Bent","Thomsen, Erik Vilain","Sørensen, Charlotte Mehlin","Jensen, Jørgen Arendt"],"cuid":["S02-087.99-716205"],"event":{"end":"2023-09-08","place":"Montreal, ca","start":"2023-09-03","title":"2023 IEEE International Ultrasonics Symposium, IUS 2023","year":"2023"},"filters":{"added":"2024-02","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Recursive Imaging","Super resolution imaging","Synthetic aperture","Ultrasound imaging"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"recursive imaging for tracking high density scatterers in super resolution imaging","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85178570253","version":"Other Version"},"id":"S02-087.99-716205","identifier":[{"id":"85178570253","type":"scopus"}],"ids":["dtu-15a2835b-eca8-4fab-8cd2-a3a0b170e131","ku-b85df0ae-bda3-4975-9c07-27acf8c1ede6"],"keyword":["High Density Scatterers","Recursive Imaging","Super Resolution Imaging","Synthetic Aperture","Ultrasound Imaging"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-181A0250CD7E09B727F52D574C982390"],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Health Technology","Technical University of Denmark, Department of Health Technology, UltraSound and Biomechanics","Technical University of Denmark, Department of Health Technology, UltraSound and Biomechanics, Center for Fast Ultrasound Imaging"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Biomedical Sciences, Renal and Vascular Research"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Mostafa","key":"aminnajipau","last":"Amin-Naji","locid":"b0ff2be6-b55b-41ca-b7c7-d207debe2654","name":"Amin Naji, Mostafa","name_org":"Amin-Naji, Mostafa","orcid":"0000-0001-8515-5607","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Iman","key":"taghavipau","last":"Taghavi","locid":"70860894-0180-4faf-a270-c7e761b81abc","name":"Taghavi, Iman","orcid":"0000-0002-2551-074X","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Niels Bent","key":"larsenpau","last":"Larsen","locid":"7a727b09-e209-47ab-80f7-9df731c2178f","name":"Larsen, Niels Bent","orcid":"0000-0001-6506-3991","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Erik Vilain","key":"thomsenpau","last":"Thomsen","locid":"822fe159-0932-4e5e-aeb6-b8b7f8421ab0","name":"Thomsen, Erik Vilain","orcid":"0000-0002-2772-926X","rank":4,"rolecode":"pau"},{"affno":"2","first":"Charlotte Mehlin","key":"sørensenpau","last":"Sørensen","locid":"0ceca69d-e5cd-43dc-9995-305ac5855c4f","name":"Sørensen, Charlotte Mehlin","orcid":"0000-0002-9984-3125","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jorgen Arendt","key":"jensenpau","last":"Jensen","locid":"e197c9fc-743f-4736-8d06-3825897e0989","name":"Jensen, Jørgen Arendt","name_org":"Jensen, Jorgen Arendt","orcid":"0000-0002-7896-3136","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1109/ius51837.2023.10306650","eisbn":["9798350346459"],"isbn":["9798350346466"],"issn":["19485719"],"place":"Montreal, QC, Canada","publisher":"IEEE Computer Society Press","series":"IEEE International Ultrasonics Symposium, IUS","status":"p","title":"2023 IEEE International Ultrasonics Symposium (IUS)"},"review":"Peer Reviewed","scoID":["2-s2.0-85178570253"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-15a2835b-eca8-4fab-8cd2-a3a0b170e131","ku-b85df0ae-bda3-4975-9c07-27acf8c1ede6"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Recursive Imaging for Tracking High Density Scatterers in Super-Resolution Imaging","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-087.99-716205","year":"2023","yearsub":"2023"}
{"abstract":"INTRODUCTION: Overall caecum intubation rate(oCIR) and overall polyp detection rate(oPDR) have been proposed as performance indicators, but varying complexity in case mix among endoscopists may potentially affect validity. The study aims to explore the effect of adjusting for case mix on individual endoscopist performance by calculating case mix-adjusted performance estimates (cmCIR and cmPDR) and comparing them to overall performance estimates (oCIR and oPDR). The study also provides an R program for case mix analysis. METHODS: Logistic regression associated endoscopist, colonoscopy indication, patient age and patient gender with the binary outcomes of cecum intubation and polyp detection. Case mix-adjusted performance indicators were calculated for each endoscopist based on logistic regression and bootstraps. Endoscopists were ranked from best to worst by overall and case mix-adjusted performance estimates, and differences were evaluated using percentage points(pp) and rank changes. RESULTS: The dataset consisted of 7376 colonoscopies performed by 47 endoscopists. The maximum rank change for an endoscopist comparing oCIR and cmCIR was eight positions, interquartile range (IQR 1-3). The maximum change in CIR was 1.95 percentage point (pp) (IQR 0.27-0.86). The maximum rank change in the oPDR versus cmPDR analysis was 17 positions (IQR 1.5-8.5). The maximum change in PDR was 11.21 pp (IQR 2.05-6.70). Three endoscopists improved their performance from significantly inferior to within the 95% confidence interval (CI) range of performance targets using case mix-adjusted estimates. CONCLUSIONS: The majority of endoscopists were unaffected by adjustment for case mix, but a few unfortunate endoscopists had an unfavourable case mix that could invite incorrect suspicion of inferior performance.","author_count":6,"contributors":["Pedersen, Lasse","Bernstein, Inge","Lindorff-Larsen, Karen","Carlsen, Charlotte","Gerds, Thomas","Torp-Pedersen, Christian"],"cuid":["S02-100.00-697837"],"filters":{"added":"2023-04","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Pedersen, Lasse"],"keyword":["Adenoma detection rate","Colonoscopy","Performance monitoring","cecum intubation rate","polyp detection rate"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-U-AAU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"colonoscopy performance monitoring do we need to adjust for case mix","src":["aau","ku"],"src-code":["DI-U-AAU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85147752219&partnerID=8YFLogxK","version":"Other Version"},"id":"S02-100.00-697837","identifier":[{"id":"85147752219","type":"scopus"},{"id":"36756743","type":"pmid"}],"ids":["aau-f825ba5d-37a5-41a3-92fe-bf06b935e4e2","ku-8be0112a-105a-4d92-bc5b-1810289087ba"],"keyword":["Colonoscopy","adenoma detection rate","cecum intubation rate","performance monitoring","polyp detection rate"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-0EB850FCAF5F57F64BF6BF344A15C1E1"],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Gastrointestinal Surgery"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","country":"dk","key":"north denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-NDR","l3nl":"North Denmark Region","l3nn":"North Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"North Denmark Region","namevar":["Aalborg University Hospital"],"nora_code":"DI-HO-NDR","used":1},{"affno":"3","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1},{"affno":"4","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Section of Biostatistics"],"nora_code":"DI-U-KU","used":1},{"affno":"5","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Lasse","key":"pedersenpau","last":"Pedersen","locid":"2637b3fb-b84f-4ef6-8976-39b51dae9d40","name":"Pedersen, Lasse","orcid":"0000-0002-3299-1561","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Inge","key":"bernsteinpau","last":"Bernstein","locid":"fc5f604f-944f-4a7b-a98b-f5db5141174b","name":"Bernstein, Inge","rank":2,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Karen","key":"lindorfflarsenpau","last":"Lindorff-Larsen","locid":"44148857-c2e8-4814-86a8-28c2b1951a63","name":"Lindorff-Larsen, Karen","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Charlotte","key":"carlsenpau","last":"Carlsen","name":"Carlsen, Charlotte","rank":4,"rolecode":"pau"},{"affno":"4 5","country":"dk","first":"Thomas","key":"gerdspau","last":"Gerds","locid":"b87ed711-194a-48dc-b83a-3c7aad18a00d","name":"Gerds, Thomas Alexander","name_org":"Gerds, Thomas","orcid":"0000-0002-5955-816X","rank":5,"rolecode":"pau"},{"affno":"5 1 2","corresponding":null,"country":"dk","first":"Christian","key":"torppedersenpau","last":"Torp-Pedersen","locid":"5417d806-0578-4505-b3fe-68ae0359913e","name":"Torp-Pedersen, Christian","rank":6,"rolecode":"pau"}],"pmid":["36756743"],"pub":{"doi":"10.1080/00365521.2023.2175182","issn":["00365521","15027708"],"issn_org":["00365521"],"issue":"8","journal":"Scandinavian Journal of Gastroenterology","pages":"937-944","publisher":"Taylor & Francis","status":"p","title":"Scandinavian Journal of Gastroenterology","volume":"58"},"review":"Peer Reviewed","scoID":["2-s2.0-85147752219"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-f825ba5d-37a5-41a3-92fe-bf06b935e4e2","ku-8be0112a-105a-4d92-bc5b-1810289087ba"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"Colonoscopy performance monitoring : do we need to adjust for case mix?","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-697837","year":"2023","yearsub":"2023"}
{"abstract":"Background: This study explores expectations for telepresence robots as a tool to reduce absence in education as school absence negatively influences children's academic advancement and psychosocial wellbeing.  Design: A qualitative semi-structured interview study.  Method and population: Using convenience sampling, we interviewed 11 children aged 8–17 years with cancer (n = 4), neuromuscular diseases (n = 3) or anxiety (n = 4) who had a high level of school absence (more than 15 days’ absence in a school year), and who had recently encountered a telepresence robot; and eight of their teachers. A thematical analysis and a deductive approach based on the theory of Technological frames were used.  Results: The children's and teachers' expectations of how telepresence robots could support them in reducing their school absence were identified and structured in three categories and five main themes: 1) Nature of technology: a) Learning, b) Sociality, c) Additional supportive resources; 2) Technology strategy: a) Flexible school day; 3) Technology in use: a) New workflows.  Conclusion: This study indicates that implementation requires additional resources from teachers. Children with disease-related school absence and their teachers expect telepresence robots to reconnect the children socially, by maintaining or creating new friendships, and academically, by fostering inclusion and reducing absence.","author_count":9,"contributors":["Weibel, Mette","Skoubo, Sofie","Handberg, Charlotte","Bertel, Lykke Brogaard","Steinrud, Nonni Camilla","Schmiegelow, Kjeld","Hallström, Inger Kristensson","Larsen, Hanne Baekgaard"],"cuid":["S03-093.35-685807"],"filters":{"added":"2023-05","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"continent":["Europe, EU","Nordic","OECD"],"corresponding_author":["Larsen, Hanne Baekgaard"],"country":["Sweden"],"glorg":["All Global Affiliations","Lund University"],"keyword":["Children","Disability","Education","School","School absenteeism","Telepresence robots"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-OTH"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-HO-OTH","DI-U-AAU","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"telepresence robots to reduce school absenteeism among children with cancer neuromuscular diseases or anxiety the expectations of children and teachers a qualitative study in denmark","src":["aau","au","ku"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.chbr.2023.100280","version":"Published Version"},"funding_acknowledgement":["This work is part of Childhood Oncology Network Targeting Research, Organization & Life expectancy (CONTROL) and supported by Danish Cancer Society [ R-257-A14720 ] and the Danish Childhood Cancer Foundation [ 2019–5934 ]. This work is part of the Interregional Childhood Oncology Precision Medicine Exploration (ICOPE), a cross-Oresund collaboration between the University Hospital of Copenhagen, Rigshospitalet; Lund University; Region Skåne; and the Technical University of Denmark (DTU), supported by the European Regional Development Fund. Further, we thank the Danish Cancer Society [ R-260-A15147-19-S3 ], the Danish Childhood Cancer Foundation [ 2020–6808 ], Toyota-Fonden Denmark [ KJ/BG-9773 H ], Dagmar Marshall Fonden [ 5,000,020 ], Lundbeck Fonden [ A7971 ], and the Disabled People's organizations Denmark [ 6–2021 ] for supporting this project. We are grateful to all the children and teachers who participated in this study and to project nurse Cathrine Hem Rørth (Rigshospitalet, Denmark) and Mia Kristina Hansen (The National Association for Mental Illness) for including children in the project. Further, we thank Carol Bang-Christensen for providing language help and proof reading the article. This work is part of the Interregional Childhood Oncology Precision Medicine Exploration (ICOPE), a cross-Oresund collaboration between the University Hospital of Copenhagen, Rigshospitalet; Lund University; Region Skåne; and the Technical University of Denmark (DTU), supported by the European Regional Development Fund. This work is part of Childhood Oncology Network Targeting Research, Organization & Life expectancy (CONTROL) and supported by Danish Cancer Society [R-257-A14720] and the Danish Childhood Cancer Foundation [2019–5934]. Further, we thank the Danish Cancer Society [R-260-A15147-19-S3], the Danish Childhood Cancer Foundation [2020–6808], Toyota-Fonden Denmark [KJ/BG-9773 H], Dagmar Marshall Fonden [5,000,020], Lundbeck Fonden [A7971], and the Disabled People's organizations Denmark [6–2021] for supporting this project."],"id":"S03-093.35-685807","identifier":[{"id":"85151429209","type":"scopus"}],"ids":["aau-ff94a929-cdad-40ef-9c0c-967d01e76a9e","au-d424ca5c-d23d-4f55-9214-374d58f3dee6","ku-b234538a-f273-4791-adaa-7e24a8d0f85c"],"keyword":["Children","Disability","Education","School","School absenteeism","Telepresence robots"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-6-406C8D212112E261B99B45378B0C1923"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.chbr.2023.100280","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/536319546/1_s2.0_S2451958823000131_main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/363440487/1_s2.0_S2451958823000131_main.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l