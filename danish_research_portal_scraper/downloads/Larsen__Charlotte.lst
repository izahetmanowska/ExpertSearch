6c0e024180c"],"src":["RUC Roskilde University"],"title":"Forvaltninger af det musikalske repertorie","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-558975","year":"2018","yearsub":"2018"}
{"abstract":"Formålet med dette projekt er at: • synliggøre hvordan pædagogerne selv beskriver og begrunder forældresamarbejdet • belyse forældresamarbejdets forskellige fremtrædelsesformer som det ser ud i praksis, så det faglige indhold og praksisformer synliggøres som en fagligt begrundet pædagogisk opgave • sprogliggøre forældresamarbejdet i dets forskellige former som en pædagogisk praksis, så det bliver muligt at gøre det til genstand for systematisk udvikling Denne rapport belyser tre forskellige pædagogiske ”forholdemåder” i pædagogernes praksis med forældresamarbejdet: 1) Et særligt pædagogisk perspektiv 2) Tillidsskabende relationer 3) Den professionelle dømmekraft. Rapporten peger desuden på relevante udviklingsperspektiver på lovgivningsniveau, kommunalt niveau, ledelses- og medarbejderniveau med henblik på en yderligere professionalisering af forældresamarbejdet. Afslutningsvist peges på nogle pædagogiske potentialer i samarbejdet og på behovet for en yderligere belysning af, hvordan viden og erfaringer i denne praksis kan bringes i spil af pædagoger på fritids- og klubområdet i forhold til aktuelle lovgivningsinitiativer fx ”En sammenhængende kommunal ungeindsats.”","author_count":4,"contributors":["Nielsen, Ole Steen","Madsen, Bent Lund","Overgaard Larsen, Doris","Brøndsted, Charlotte"],"cuid":["S01-000.00-654814"],"filters":{"added":"2023-01","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Børn og unge","Forældresamarbejde"],"level":"sci","oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-UC"],"level3":{"OT":["Bent Madsen; inklusionsakademiet"],"UC":["DI-UC-ALL","DI-UC-UCS"]},"level3all":["DI-UC-UCS"]},"review":"nr","rtype":["clu"],"sorti":"forældresamarbejde i fritids og klubtilbud en upåagtet praksis med oversete potentialer","src":["ucsyd"],"src-code":["DI-UC-UCS"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://ucviden.ucsyd.dk/ws/files/61270300/2018.11.22_RAPPORTEN_Final_22.11.18_.pdf","version":"Published Version"},"id":"S01-000.00-654814","ids":["ucsyd-fc4343b2-02da-47de-be1d-c3701978de20"],"keyword":["Børn og unge","forældresamarbejde","upåagtet - udvidet"],"lang":"Danish","level":"Scientific","noi":["Local-1-1-0E4EC30A3D5F56649E8316667A30230F"],"oa_link":[{"access":"oa","type":"loc","url":"https://ucviden.ucsyd.dk/ws/files/61270300/2018.11.22_RAPPORTEN_Final_22.11.18_.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"uc syd university college south denmark","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-UCS","l3nl":"UC SYD, University College South Denmark","l3nn":"UC SYD University College South Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"UC SYD University College South Denmark","namevar":["UC SYD, Samfund og sundhed, Efter- og videreuddannelsen"],"nora_code":"DI-UC-UCS","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Bent Madsen; inklusionsakademiet"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Ole Steen","key":"nielsenpau","last":"Nielsen","locid":"e2d4c505-ac65-4d9b-bc67-87c9840e9ed3","name":"Nielsen, Ole Steen","orcid":"0000-0002-4565-5882","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Bent Lund","key":"madsenpau","last":"Madsen","name":"Madsen, Bent Lund","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Doris Overgaard","key":"larsenpau","last":"Larsen","locid":"81cb3d78-4b9d-4045-8f07-1acc5948e257","name":"Overgaard Larsen, Doris","name_org":"Larsen, Doris Overgaard","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Charlotte","key":"brøndstedpau","last":"Brøndsted","name":"Brøndsted, Charlotte","rank":4,"rolecode":"pau"}],"pub":{"pages":"61","status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Miscellaneous","All University Colleges","DI-ALL","DI-OT","DI-OT-ALL","DI-UC","DI-UC-ALL","Miscellaneous","Other Research","UC SYD, University College South Denmark","University Colleges"],"PST":["Published"]},"sid":["ucsyd-fc4343b2-02da-47de-be1d-c3701978de20"],"src":["UC SYD University College South Denmark"],"title":"Forældresamarbejde i fritids- og klubtilbud : en upåagtet praksis med oversete potentialer","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-654814","year":"2018","yearsub":"2018"}
{"abstract":"I den danske musikvidenskabelige forskningslitteratur udgør analyser af nutidige danske musikinstitutioner et meget lille område. Musikskoler, spillesteder, forenings- liv, koncerthuse, medier, konservatorier og højskoler er steder, hvor musik praktise- res, og som indrammer mange menneskers møder med musik.","author_count":2,"contributors":["Lindelof, Anja Mølle","Larsen, Charlotte Rørdam"],"cuid":["S02-100.00-023500"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Kulturpolitik","Musikvidenskab","musikliv"],"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-RUC"]},"level3all":["DI-U-AU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"de usynlige institutioner fraværet af nutidige musikinstitutioner i dansk musikvidenskab","src":["au","ruc"],"src-code":["DI-U-AU","DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/63938213/dmo_saernummer_2018_musikkens_institutioner_01.pdf","version":"Published Version"},"id":"S02-100.00-023500","ids":["au-94a4146b-63f9-4324-8670-2faa38c6b9b1","ruc-7d1f29ce-29dc-456d-86da-9bcb27cdf9b5"],"keyword":["kulturpolitik","musikinstitutioner","musikliv","musikvidenskab"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-2-C451402E9E60018E6DFCBDE8DC345107"],"oa_link":[{"access":"oa","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/63938213/dmo_saernummer_2018_musikkens_institutioner_01.pdf","version":"Published Version"},{"access":"oa","type":"rem","url":"http://www.danishmusicologyonline.dk/arkiv/arkiv_dmo/dmo_saernummer_2018/Dansk_Musikforskning_Online_Saernummer_2018_Musikkens_institutioner.pdf","version":"Other Version"}],"oai":{"class":"Realised","mra":["Humanities (HUM)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1",