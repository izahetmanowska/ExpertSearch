rolecode":"pedh"},{"affno":"","first":"Jarmo","key":"valajapedh","last":"Valaja","name":"Valaja, Jarmo","rank":10,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Jaakko","key":"mononenpedh","last":"Mononen","name":"Mononen, Jaakko","rank":11,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Tarja","key":"sironenpedh","last":"Sironen","name":"Sironen, Tarja","rank":12,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Olli","key":"vapalahtipedh","last":"Vapalahti","name":"Vapalahti, Olli","rank":13,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"issn":["24456292"],"issue":"3/4","pages":"85-87","place":"Helsinki, Finland","publisher":"Libris","series":"Scientifur","status":"p","title":"Proceedings of the XIth International Scientific Congress in Fur Animal Production"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Other Companies","Private Research","Technical University of Denmark","Universities","kopenhagen fur"],"PST":["Published"]},"sid":["dtu-c974ca82-da65-4885-9b78-4281f50d8006"],"src":["DTU Technical University of Denmark"],"title":"Outbreaks of Aleutian mink disease in farmed mink (Neovison vison) in Denmark: molecular characterization by partial NS1 gene sequencing","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-364729","year":"2016","yearsub":"2016"}
{"abstract":"Objective : Quantitatively assess 3D spatially detailed soft-tissue facial asymmetry in children who had undergone craniofacial reconstruction for Unicoronal Synostosis (UCS), and compare the facial asymmetry to control patients. It was hypothesized that there would be no significant differences in the facial asymmetry between the groups. Design : Clinical, retrospective follow-up study. Methodological study. Setting : Primary care center. Patients/Participants : Twenty-two children with UCS were selected after review of records. Inclusion criteria: isolated UCS; surgically treated for UCS within the first 19 months of life, without secondary reconstruction; and DNA analysis for the Muenke mutation. An age- and sex-matched control group was employed. Interventions : The UCS group had undergone bilateral craniotomy of the frontal bone with unilateral supraorbital rim advancement. Main Outcome Measure(s) : Using 3D surface scanning, a detailed map of 3D asymmetry presenting the amount of asymmetry in the sagittal, vertical, and transverse directions was calculated for six facial subregions. Results : The facial asymmetry in the UCS group was significantly larger than in the control group for all regions, to the largest extent in the sagittal direction (level of significance: 5%). The regions with the most pronounced asymmetry were cheeks (mean: 5.45 mm; SD: 1.83 mm), forehead (mean: 5.00 mm; SD: 1.57 mm), and eyes (mean: 4.26 mm; SD: 1.44 mm). Conclusions : Ninety percent of the UCS patients in the study had significant facial asymmetry throughout the facial area. The study demonstrates a methodology of facial asymmetry quantification well suited for soft-tissue surgical outcome evaluations and long-term follow-up studies in patients with craniofacial anomalies.","author_count":7,"contributors":["Öwall, Birgitta Louise Charlotte","Darvann, Tron Andre","Larsen, P","Dahlgaard Hove, Hanne","Hermann, Nuno Vibe","Bøgeskov, Lars","Kreiborg, Sven"],"cuid":["S01-000.00-401379"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"facial asymmetry in children with unicoronal synostosis who have undergone craniofacial reconstruction in infancy","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-401379","identifier":[{"id":"26418148","type":"pmid"},{"id":"84979703606","type":"scopus"}],"ids":["ku-0d58f005-c75d-485b-8909-29d84d9e736b"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-AAF4D45C48390C0ACDB2CD63EA11626B"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Odontology, Section 05 - Community Dentistry"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Birgitta Louise Charlotte","key":"öwallpau","last":"Öwall","locid":"5d4b8594-db07-46ab-b50f-bff7a63dc797","name":"Öwall, Birgitta Louise Charlotte","rank":1,"rolecode":"pau"},{"affno":"1","first":"Tron Andre","key":"darvannpau","last":"Darvann","locid":"e6441aa5-e58c-42aa-a019-155b70e99415","name":"Darvann, Tron Andre","rank":2,"rolecode":"pau"},{"affno":"1","first":"P","key":"larsenpau","last":"Larsen","name":"Larsen, P","rank":3,"rolecode":"pau"},{"affno":"","first":"Hanne","key":"dahlgaardhovepau","last":"Dahlgaard Hove","name":"Dahlgaard Hove, Hanne","rank":4,"rolecode":"pau"},{"affno":"1","first":"Nuno Vibe","key":"hermannpau","last":"Hermann","locid":"33295e42-e0f1-470f-a5b2-89588c7767cf","name":"Hermann, Nuno Vibe","orcid":"0000-0002-8079-8571","rank":5,"rolecode":"pau"},{"affno":"","first":"Lars","key":"bøgeskovpau","last":"Bøgeskov","name":"Bøgeskov, Lars","rank":6,"rolecode":"pau"},{"affno":"1","first":"Sven","key":"kreiborgpau","last":"Kreiborg","locid":"d496d728-62c1-4162-854c-83f5f0fc5438","name":"Kreiborg, Sven","rank":7,"rolecode":"pau"}],"pmid":["26418148"],"pub":{"doi":"10.1597/15-089","issn":["10556656","15451569"],"issn_org":["10556656"],"issue":"4","journal":"Cleft Palate - Craniofacial Journal","pages":"385-393","paperid":"53","status":"p","title":"Cleft Palate - Craniofacial Journal","volume":"53"},"review":"Peer Reviewed","scoID":["2-s2.0-84979703606"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-0d58f005-c75d-485b-8909-29d84d9e736b"],"src":["KU University of Copenhagen"],"title":"Facial asymmetry in children with unicoronal synostosis who have undergone craniofacial reconstruction in infancy.","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-401379","year":"2016","yearsub":"2016"}
{"abstract":"Background The improved survival after breast cancer has prompted knowledge on the effect of a breast cancer diagnosis on health-related quality of life (HQoL). This study compared changes in HQoL among women from before to after breast cancer diagnosis with longitudinal changes among women who remained breast cancer-free. Material and methods The Danish Diet, Cancer and Health study included 57 053 cancer-free persons aged 50-64 years at baseline (1993-1997). We used data from first follow-up (1999-2002) and second follow-up (2010-2012) on HQoL [Medical Outcomes Survey, short form (SF-36)] obtained from 542 women aged 64-82 years with primary breast cancer (stages I-III) and a randomly matched sample of 729 women who remained breast cancer-free. Linear regression models were used to estimate the differences in changes in HQoL between women with and without breast cancer; the analyses were repeated with stratification according to age, comorbidity, partner support and time since diagnosis. Results Women with breast cancer reported significantly larger decreases in HQoL from before to after diagnosis than those who remained breast cancer-free (physical component summary, -2.0; 95% CI -2.8; -1.2, mental component summary, -1.5, 95% CI -2.3; -0.6). This association was significantly modified by comorbidity and time since diagnosis. Conclusions Women with breast cancer reported significantly larger HQoL declines than breast cancer-free women. Breast cancer diagnosis seems to have the greatest impact on HQoL closest to diagnosis and in women with comorbidity indicating that this group should be offered timely and appropriate follow-up care to prevent HQoL declines.","author_count":10,"contributors":["Karlsen, Randi V","Frederiksen, Kirsten","Larsen, Matilde B","von Heymann-Horan, Annika Berglind","Appel, Charlotte W","Christensen, Jane","Tjønneland, Anne","Ross, Lone","Johansen, Christoffer","Bidstrup, Pernille E"],"cuid":["S01-000.00-475561"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Aged","Aged 80 and over","Breast Neoplasms","Comorbidity","Comparative Study","Denmark","Female","Follow Up Studies","Health Surveys","Humans","Middle Aged","Prospective Studies","Quality of Life","Social Support"],"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-NP","DI-U"],"level3":{"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-NP-CAN","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the impact of a breast cancer diagnosis on health related quality of life a prospective comparison among middle aged to elderly women with and without breast cancer","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-475561","identifier":[{"id":"26942569","type":"pmid"},{"id":"84975260923","type":"scopus"}],"ids":["ku-894a2c2b-705d-4da4-8e30-5c69132935be"],"keyword":["Aged","Aged, 80 and over","Breast Neoplasms","Comorbidity","Comparative Study","Denmark","Female","Follow-Up Studies","Health Surveys","Humans","Middle Aged","Prospective Studies","Quality of Life","Social Support"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-4-63323B006DCA50085B6F134CFF75163E"],"oai":{"class":"Unused","mra":["Social Science (SOC)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Social Sciences, Department of Psychology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"dcrc danish cancer society research center","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-CAN","l3nn":"DCRC Danish Cancer Society Research Cent