{"abstract":"A case of human infection with influenza A(H1N1)pdm09 virus containing a nonstructural gene highly similar to Eurasian avian-like H1Nx swine influenza virus was detected in Denmark in January 2021. We describe the clinical case and report testing results of the genetic and antigenic characterizations of the virus.","author_count":11,"contributors":["Nissen, Jakob N.","George, Sophie","Hjulsager, Charlotte K.","Krog, Jesper S.","Nielsen, Xiaohui C.","Madsen, Tina V.","Andersen, Klara M.","Krause, Tyra G.","Vestergaard, Lasse S.","Larsen, Lars Erik","Trebbien, Ramona"],"cuid":["S01-000.00-470703"],"filters":{"added":"2022-11","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-ZEA"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-GV-SSI","DI-HO-ZEA","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"reassortant influenza a h000000000001n000000000001 pdm000000000009 virus in elderly woman denmark january 000000002021","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3201/eid2712.211361","version":"Published Version"},"id":"S01-000.00-470703","identifier":[{"id":"85120333077","type":"scopus"},{"id":"PMC8632190","type":"pmcid"},{"id":"34808097","type":"pmid"}],"ids":["ku-81157a8b-6ca4-4f75-b4e3-096c33dd5440"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-537E0AE4428872C766190ECEBF2B5B94"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.3201/eid2712.211361","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"dk","key":"ssi statens serum institut","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-SS