affno":"1","corresponding":null,"first":"Anne Konring","key":"larsenpau","last":"Larsen","name":"Larsen, Anne Konring","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lau Caspar","key":"thygesenpau","last":"Thygesen","locid":"1932f287-552d-4539-8153-b2fc204a703b","name":"Thygesen, Lau Caspar","orcid":"0000-0001-8375-5211","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Mia Nyvang","key":"stillingpau","last":"Stilling","locid":"162878c4-22b9-48df-ac98-b821e80a456f","name":"Stilling, Mia Nyvang","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Charlotte Nørregaard","key":"rasmussenpau","last":"Rasmussen","locid":"180d2a5d-fe8e-4956-b192-48aed7083301","name":"Rasmussen, Charlotte Diana Nørregaard","name_org":"Rasmussen, Charlotte Nørregaard","orcid":"0000-0002-1769-717X","rank":4,"rolecode":"pau"},{"affno":"4 5","first":"Richard H.","key":"osbornepau","last":"Osborne","locid":"591fb1b7-c517-49c3-b6db-251efd629bdc","name":"Osborne, Richard H.","orcid":"0000-0002-9081-2699","rank":5,"rolecode":"pau"},{"affno":"6 1","corresponding":null,"first":"Marie Birk","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, Marie Birk","rank":6,"rolecode":"pau"}],"pmid":["39190392"],"pub":{"doi":"10.1097/jom.0000000000003211","issn":["10762752","15365948"],"issn_org":["10762752"],"issue":"11","journal":"Journal of Occupational and Environmental Medicine","publisher":"Lippincott Williams & Wilkins","publisher_org":"Lippincott, Williams & Wilkins","status":"p","title":"Journal of Occupational and Environmental Medicine","volume":"66"},"review":"Peer Reviewed","scoID":["2-s2.0-85202700314"],"search":{"DAF":["All Business Academies","All Danish Affiliations","All Governmental Institutions","All Miscellaneous","All Universities","Business Academies","DI-ALL","DI-BA","DI-BA-ALL","DI-GV","DI-GV-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Governmental Institutions","Miscellaneous","Other Research","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-05b77d61-14e6-4dfb-bb02-a1710e35be0d","nfa-50854eee-b613-46d7-9ce5-698bc4011c04","sdu-b587f308-0323-4abf-bc08-3d2b3fb6a4ae"],"src":["KU University of Copenhagen","NFA National Research Centre for the Working Environment","SDU University of Southern Denmark"],"title":"An Occupational Health Literacy Intervention in Nursing Homes Improved Organizational Health Literacy—A Quasi-Experimental Stepped Wedge Cluster Trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-097.71-768610","year":"2024","yearsub":"2024"}
{"abstract":"The white-beaked dolphin (Lagenorhynchus albirostris) is the second most frequently stranded cetacean species along the Danish coastline. The northern North Sea, the Skagerrak, the Kattegat and the Danish straits are part of the species distributional range. Here, we present eight incidents of breeding activity for the white-beaked dolphin in the inner Danish waters, reviewed from yearly reports made by the National Contingency Plan concerning strandings of marine mammals in Denmark from 2009 to 2023, Danish Wildlife Diseases Surveillance reports from 2014 to 2023 and the citizen science database Naturbasen in the period 2002 to 2023. Three pregnant females, three lactating females and one calf were found stranded in the inner Danish waters. Besides this, there have been live sightings of a female with a newborn calf. We conclude that the white-beaked dolphin is breeding in the inner Danish waters.","author_count":12,"contributors":["Alstrup, Aage Kristian Olsen","Kinze, Carl Chr.","Kristensen, Natacha Mia","Jensen, Trine Hammer","Thøstesen, Charlotte Bie","Larsen, Hanne Lyngholm","Ankersen Sønnichsen, Karen","Kyhn, Line Anker","Holm, Thomas Eske","Sigsgaard, Jens Jørgen","Pagh, Sussie"],"cuid":["S03-098.83-822389"],"filters":{"added":"2024-02","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Alstrup, Aage Kristian Olsen"],"keyword":["Cetacean","Danish waters","Delphinidae","Odontoceti","Reproduction","Strandings"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Department for Clinical Medicine"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"further evidence for breeding white beaked dolphin lagenorhynchus albirostris in inner danish waters","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3390/coasts4020013","version":"Published Version"},"id":"S03-098.83-822389","identifier":[{"id":"105011938154","type":"scopus"}],"ids":["aau-919dcc03-a4b8-4df7-98f1-47a338557254","aau-cf67d3b6-690c-4fa4-970c-91a15c55dfc7","au-8b99d4ba-67b4-4b21-b05e-8f808c26c0f3"],"keyword":["Danish waters","Delphinidae","Odontoceti","cetacean","reproduction","strandings"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-6-3A3E6F04A188E7AFF1CD81FAF13F59AE"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/763534795/coasts-04-00013.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.3390/coasts4020013","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Nuclear Medicine"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience"],"nora_code":"DI-U-AAU","used":1},{"affno":"3","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Department for Clinical Medicine"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1 2 3","corresponding":null,"country":"dk","first":"Aage Kristian Olsen","key":"alstruppau","last":"Alstrup","locid":"fa66f5b8-0468-4e85-b570-969776c5ebde","name":"Alstrup, Aage Kristian Olsen","orcid":"0000-0002-0084-9122","rank":1,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Carl Chr.","key":"kinzepau","last":"Kinze","name":"Kinze, Carl Chr.","rank":2,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Natacha Mia","key":"kristensenpau","last":"Kristensen","name":"Kristensen, Natacha Mia","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Trine Hammer","key":"jensenpau","last":"Jensen","locid":"ba730a1d-cca4-4f6b-9f9e-8cf67f00a53a","name":"Jensen, Trine Hammer","orcid":"0000-0001-9048-5280","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Charlotte Bie","key":"thøstesenpau","last":"Thøstesen","name":"Thøstesen, Charlotte Bie","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Charlotte","key":"biethøstesenpau","last":"Bie Thøstesen","name":"Bie Thøstesen, Charlotte","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Hanne Lyngholm","key":"larsenpau","last":"Larsen","locid":"806cdba3-0da2-4ea7-a73c-e64bc45ce26b","name":"Larsen, Hanne Lyngholm","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Karen Ankersen","key":"sønnichsenpau","last":"Sønnichsen","name":"Sønnichsen, Karen Ankersen","rank":7,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Line Anker","key":"kyhnpau","last":"Kyhn","name":"Kyhn, Line Anker","rank":8,"rolecode":"pau"},{"affno":"1 2 3","corresponding":null,"country":"dk","first":"Thomas Eske","key":"holmpau","last":"Holm","locid":"60b1e0c7-90fe-438c-9241-684997feb0b0","name":"Holm, Thomas Eske","orcid":"0000-0002-9654-2722","rank":9,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jens Jørgen","key":"sigsgaardpau","last":"Sigsgaard","locid":"a616c3ad-bfc4-4ec2-8d9f-3ce6f7304158","name":"Sigsgaard, Jens Jørgen","rank":10,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Sussie","key":"paghpau","last":"Pagh","locid":"ebf3bb90-5d85-4380-8a86-1f5ff811c011","name":"Pagh, Sussie","orcid":"0000-0002-1574-3638","rank":11,"rolecode":"pau"}],"pub":{"doi":"10.3390/coasts4020013","issn":["2673964X"],"issue":"2","journal":"Coasts","pages":"226-234","publisher":"Multidisciplinary Digital Publishing Institute","status":"p","title":"Coasts","volume":"4"},"review":"Peer Reviewed","scoID":["2-s2.0-105011938154"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Private Research","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","NIRAS A/S","Other Research","Private Research","Universities"],"PST":["Published"]},"sid":["aau-919dcc03-a4b8-4df7-98f1-47a338557254","aau-cf67d3b6-690c-4fa4-970c-91a15c55dfc7","au-8b99d4ba-67b4-4b21-b05e-8f808c26c0f3"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Further Evidence for Breeding White-Beaked Dolphin (Lagenorhynchus albirostris) in Inner Danish Waters","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-098.83-822389","year":"2024","yearsub":"2024"}
{"abstract":"Children with attention-deficit/hyperactivity disorder (ADHD) can be more stress-vulnerable, and thereby, it has been suggested, prone to develop functional somatic symptoms (FSS) compared to their peers. In this paper, using data from 160 children aged 3–7 years with ADHD from the D’SNAPP study, a randomized controlled trial testing a parent training intervention, we addressed a number of questions about the role of FSS in ADHD. First, are FSS levels higher in an ADHD sample than in the children of the general population. Second, do FSS levels predict psychopathology and health-related quality of life (HRQoL) in ADHD samples. Third, does FSS levels moderate the effect of parent training on ADHD symptoms. We found that preschoolers with ADHD experienced more severe FSS than a general population-based sample (18.80% vs. 2.11%). Severe FSS were associated with increased psychopathology and impaired daily function and lower HRQoL. Level of baseline FSS did not moderate the effect of parent training on ADHD. FSS in preschool children with ADHD is associated with impaired daily functioning, but further research is warranted to determine the clinical impact of FSS in children with ADHD.","author_count":7,"contributors":["Larsen, Liva Bundgaard","Daley, David","Lange, Anne-Mette","Sonuga-Barke, Edmund","Thomsen, Per Hove","Jensen, Jens Søndergaard","Rask, Charlotte Ulrikka"],"cuid":["S01-000.00-157770"],"filters":{"added":"2022-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"corresponding_author":["Larsen, Liva Bundgaard"],"country":["United Kingdom"],"glorg":["All Global Affiliations","King's College London","University of Nottingham"],"keyword":["ADHD","Functional somatic symptoms","Health related quality of life","Parent training","Preschool"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"functional somatic symptoms in preschool attention deficit hyperactivity disorder a secondary analysis of data from a randomized controlled trial of parent training","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85132734485","version":"Other Version"},"id":"S01-000.00-157770","identifier":[{"id":"35748937","type":"pmid"},{"id":"85132734485","type":"scopus"}],"ids":["au-31b69ae1-c16a-40fe-8e25-89f01d40fdd7"],"keyword":["ADHD","Functional somatic symptoms","Health-related quality of life","Parent training","Preschool"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-F527A0C9CB83B8A012A947487138DD83"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Psychiatric Hospital for Children and Adolescents"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"gb","key":"university of nottingham","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Nottingham","used":1},{"affno":"3","country":"gb","key":"king s college london","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"King's College London","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Liva Bundgaard","key":"larsenpau","last":"Larsen","locid":"0c4ca7f9-3402-4160-982d-f989af13ac19","name":"Larsen, Liva Bundgaard","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"David","key":"daleypau","last":"Daley","name":"Daley, David","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anne Mette","key":"langepau","last":"Lange","locid":"0147d1c4-3628-4420-8e6f-c6930a62e3c3","name":"Lange, Anne-Mette","name_org":"Lange, Anne Mette","rank":3,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"first":"Edmund","key":"sonugabarkepau","last":"Sonuga-Barke","locid":"13861cd6-4d8c-4387-b72b-c3e8e0921700","name":"Sonuga-Barke, Edmund","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Per Hove","key":"thomsenpau","last":"Thomsen","locid":"47bb4a18-534a-4e17-b016-4f42a4e97316","name":"Thomsen, Per Hove","orcid":"0000-0002-4529-4431","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens Søndergaard","key":"jensenpau","last":"Jensen","locid":"f77754dc-4ec3-47ff-8227-808446a30644","name":"Jensen, Jens Søndergaard","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Charlotte Ulrikka","key":"raskpau","last":"Rask","locid":"1e308742-df61-47da-83ce-53d8a7c774c3","name":"Rask, Charlotte Ulrikka","orcid":"0000-0002-7426-0353","rank":7,"rolecode":"pau"}],"pmid":["35748937"],"pub":{"doi":"10.1007/s00787-022-02025-3","issn":["10188827","14335719"],"issn_org":["10188827"],"issue":"10","journal":"European Child & Adolescent Psychiatry","pages":"1979-1988","publisher":"Springer Science and Business Media Deutschland GmbH","status":"p","title":"European Child & Adolescent Psychiatry","title_org":"European Child and Adolescent Psychiatry","volume":"32"},"review":"Peer Reviewed","scoID":["2-s2.0-85132734485"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-31b69ae1-c16a-40fe-8e25-89f01d40fdd7"],"src":["AU Aarhus University"],"title":"Functional somatic symptoms in preschool attention-deficit/hyperactivity disorder : a secondary analysis of data from a randomized controlled trial of parent training","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-157770","year":"2023","yearsub":"2023"}
{"abstract":"Background & Aims: Histological assessment of liver biopsies is the gold standard for diagnosis of non-alcoholic steatohepatitis (NASH), the progressive form of non-alcoholic fatty liver disease (NAFLD), despite its well-established limitations. Therefore, non-invasive biomarkers that can offer an integrated view of the liver are needed to improve diagnosis and reduce sampling bias. Hepatic stellate cells (HSCs) are central in the development of hepatic fibrosis, a hallmark of NASH. Secreted HSC-specific proteins may, therefore, reflect disease state in the NASH liver and serve as non-invasive diagnostic biomarkers. Methods: We performed RNA-sequencing on liver biopsies from a histologically characterised cohort of obese patients (n = 30, BMI >35 kg/m2) to identify and evaluate HSC-specific genes encoding secreted proteins. Bioinformatics was used to identify potential biomarkers and their expression at single-cell resolution. We validated our findings using single-molecule fluorescence in situ hybridisation (smFISH) and ELISA to detect mRNA in liver tissue and protein levels in plasma, respectively. Results: Hepatic expression of SPARC-related modular calcium-binding protein 2 (SMOC2) was increased in NASH compared to no-NAFLD (p.adj <0.001). Single-cell RNA-sequencing data indicated that SMOC2 was primarily expressed by HSCs, which was validated using smFISH. Finally, plasma SMOC2 was elevated in NASH compared to no-NAFLD (p <0.001), with a predictive accuracy of AUROC 0.88. Conclusions: Increased SMOC2 in plasma appears to reflect HSC activation, a key cellular event associated with NASH progression, and may serve as a non-invasive biomarker of NASH. Impact and implications: Non-alcoholic fatty liver disease (NAFLD) and its progressive form, non-alcoholic steatohepatitis (NASH), are the most common forms of chronic liver diseases. Currently, liver biopsies are the gold standard for diagnosing NAFLD. Blood-based biomarkers to complement liver biopsies for diagnosis of NAFLD are required. We found that activated hepatic stellate cells, a cell type central to NAFLD pathogenesis, upregulate expression of the secreted protein SPARC-related modular calcium-binding protein 2 (SMOC2). SMOC2 was elevated in blood samples from patients with NASH and may hold promise as a blood-based biomarker for the diagnosis of NAFLD.","author_count":18,"contributors":["Larsen, Frederik Tibert","Hansen, Daniel","Terkelsen, Mike Krogh","Bendixen, Sofie Marchsteiner","Avolio, Fabio","Wernberg, Charlotte","Lauridsen, Mette Munk","Grønkjær, Lea Ladegaard","Jacobsen, Birgitte G.","Gammelmark, Ellen","Mandrup, Susanne","Caterino, Tina Di","Siersbæk, Majken","Chandran, Vineesh Indira","Graversen, Jonas Heilskov","Krag, Aleksander","Grøntved, Lars","Ravnskjaer, Kim"],"cuid":["S01-000.00-624265"],"filters":{"added":"2023-03","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"corresponding_author":["Ravnskjaer, Kim"],"keyword":["Hepatic stellate cells","NAFLD","NASH","Non invasive biomarker","SMOC2","Transcriptomics"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-SDR","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"stellate cell expression of sparc related modular calcium binding protein 000000000002 is associated with human non alcoholic fatty liver disease severity","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.jhepr.2022.100615","version":"Published Version"},"funding_acknowledgement":["This work was supported by the Danish National Research Foundation (grant DNRF141) to Center for Functional Genomics and Tissue Plasticity (ATLAS), and a Fellowship (D.H.) from the Danish Diabetes Academy , which is funded by the Novo Nordisk Foundation , grant number NNF17SA0031406. This work was supported by the Danish National Research Foundation (grant DNRF141) to Center for Functional Genomics and Tissue Plasticity (ATLAS), and a Fellowship (D.H.) from the Danish Diabetes Academy, which is funded by the Novo Nordisk Foundation, grant number NNF17SA0031406.We thank Tenna P. Mortensen, Maibrith Wishoff, and Signe Marie Andersen for expert technical assistance. We thank Casimiro Gerarduzzi (affiliation) for valuable intellectual input. Bioimaging was performed at DaMBIC, a bioimaging research core facility at University of Southern Denmark (SDU), established by an equipment grant from the Danish Agency for Science, Technology and Innovation and internal funding from SDU. We thank Tenna P. Mortensen, Maibrith Wishoff, and Signe Marie Andersen for expert technical assistance. We thank Casimiro Gerarduzzi (affiliation) for valuable intellectual input. Bioimaging was performed at DaMBIC, a bioimaging research core facility at University of Southern Denmark (SDU), established by an equipment grant from the Danish Agency for Science, Technology and Innovation and internal funding from SDU."],"id":"S01-000.00-624265","identifier":[{"id":"85145738472","type":"scopus"},{"id":"36687468","type":"pmid"},{"id":"PMC9850195","type":"pmcid"}],"ids":["sdu-b2397690-3aff-414e-8918-fd340c99885b"],"keyword":["NAFLD","NASH","SMOC2","hepatic stellate cells","non-invasive biomarker","transcriptomics"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-5FF58E2895925EFF04C5C42E6DB27157"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/219700988/1_s2.0_S2589555922001872_main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.jhepr.2022.100615","version":"Published Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Science, Department of Biochemistry and Molecular Biology","SDU, Faculty of Science, Department of Biochemistry and Molecular Biology, ATLAS - Center for Functional Genomics and Tissue Plasticity","SDU, Faculty of Science, Department of Biochemistry and Molecular Biology, Functional Genomics & Metabolism"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Frederik T.","key":"larsenpau","last":"Larsen","locid":"573a5630-624e-4290-9671-1428c6985a29","name":"Larsen, Frederik Tibert","name_org":"Larsen, Frederik T.","orcid":"0000-0001-8243-0845","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Daniel","key":"hansenpau","last":"Hansen","locid":"2bfa777e-ead5-428f-8192-a824523c3378","name":"Hansen, Daniel","orcid":"0000-0002-6409-2675","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mike K.","key":"terkelsenpau","last":"Terkelsen","locid":"90bb746f-730a-4ae1-9001-1ff65f21bb00","name":"Terkelsen, Mike Krogh","name_org":"Terkelsen, Mike K.","orcid":"0000-0002-5478-7895","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sofie M.","key":"bendixenpau","last":"Bendixen","locid":"cf0a7f61-1f94-4e99-9239-cfaec0fbb083","name":"Bendixen, Sofie Marchsteiner","name_org":"Bendixen, Sofie M.","orcid":"0000-0001-9510-941X","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Fabio","key":"avoliopau","last":"Avolio","l