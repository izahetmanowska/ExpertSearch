:"36158d7c-a1ce-4b85-a240-93c6218ea6be","name":"Jacobsen, Charlotte","orcid":"0000-0003-3540-9669","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Paolo","key":"marcatilipau","last":"Marcatili","locid":"ae6af6bd-a96a-4fff-af5c-d90ef4446e8c","name":"Marcatili, Paolo","orcid":"0000-0003-2615-5695","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Simon","key":"gregersenecherspau","last":"Gregersen Echers","locid":"f2999755-6e9b-47c7-b5a4-4f61348ff61c","name":"Gregersen Echers, Simon","orcid":"0000-0001-9349-3235","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Michael T.","key":"overgaardpau","last":"Overgaard","locid":"8bd43772-17bb-45d3-9190-b230a7038933","name":"Overgaard, Michael Toft","name_org":"Overgaard, Michael T.","orcid":"0000-0002-1423-2481","rank":5,"rolecode":"pau"},{"affno":"3","first":"Mogens L.","key":"andersenpau","last":"Andersen","locid":"cb1b131f-69dc-46eb-bb7a-5d0161d84ab5","name":"Andersen, Mogens Larsen","name_org":"Andersen, Mogens L.","orcid":"0000-0003-4694-486X","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ann-Dorit Moltke","key":"sørensenpau","last":"Sørensen","locid":"dd7b7dae-3650-43cb-850c-ac4189bf0125","name":"Sørensen, Ann-Dorit Moltke","orcid":"0000-0001-9349-1221","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Egon Bech","key":"hansenpau","last":"Hansen","locid":"32db061a-9661-42a0-964c-84f1cd4aed29","name":"Hansen, Egon Bech","orcid":"0000-0002-3795-6706","rank":8,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.foodhyd.2019.105529","issn":["0268005X","18737137"],"issn_org":["0268005X"],"journal":"Food Hydrocolloids","paperid":"105529","publisher":"Elsevier","status":"p","title":"Food Hydrocolloids","volume":"101"},"review":"Peer Reviewed","scoID":["2-s2.0-85075265809"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-f2f5d709-c971-4418-8a8e-8b99918dbf22","dtu-ff390620-6596-4d6e-8676-b29abc9e8df3","ku-86dbb005-864a-4ae5-ad87-8d275d58d0f0"],"src":["AAU Aalborg University","DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Emulsifying peptides from potato protein predicted by bioinformatics : Stabilization of fish oil-in-water emulsions","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-098.64-011606","year":"2020","yearsub":"2020"}
{"abstract":"Background The 'physical activity paradox' advocates that leisure physical activity (PA) promotes health while high occupational PA impairs health. However, this paradox can be explained by methodological limitations of the previous studies-self-reported PA measures, insufficient adjustment for socioeconomic confounding or not addressing the compositional nature of PA. Therefore, this study investigated if we still observe the PA paradox in relation to long-term sick absence (LTSA) after adjusting for the abovementioned limitations. Methods Time spent on moderate-to-vigorous physical activity (MVPA) and remaining physical behaviors (sedentary behavior, standing, light PA and time in bed) at work and in leisure was measured for 929 workers using thigh accelerometry and expressed as isometric log-ratios (ilrs). LTSA was register-based first event of >= 6 consecutive weeks of sickness absence during 4-year follow-up. The association betweenilrsand LTSA was analyzed using a Cox proportional hazards model adjusted for remaining physical behaviors and potential confounders, then separately adjusting for and stratifying by education and type of work. Results During the follow-up, 21% of the workers experienced LTSA. In leisure, more relative MVPA time was negatively associated with LTSA (20% lower risk with 20 min more MVPA,p = 0.02). At work, more relative MVPA time was positively associated with LTSA (15% higher risk with 20 min more MVPA,p = 0.02). Results remained unchanged when further adjusted for or stratified by education and type of work. Conclusion These findings provide further support to the 'PA paradox'.","author_count":9,"contributors":["Gupta, Nidhi","Dencker-Larsen, Sofie","Rasmussen, Charlotte Lund","McGregor, Duncan","Rasmussen, Charlotte Diana Nørregaard","Thorsen, Sannie Vester","Jørgensen, Marie Birk","Chastin, Sebastien","Holtermann, Andreas"],"cuid":["S03-099.24-768773"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"continent":["Europe, EU","Europe, Non-EU","OECD"],"corresponding_author":["Gupta, Nidhi"],"country":["Belgium","United Kingdom"],"glorg":["All Global Affiliations","Biomathematics and Statistics Scotland","Ghent University","Glasgow Caledonian University","The James Hutton Institute"],"keyword":["Accelerometers","All cause mortality","Fysisk aktivitet","Health","Leisure time","MARKER","Occupational health","Physical activity","Predictor","Prospective cohort","Register based sickness absence","Risk","Sedentary Behavior","Sick Leave","Time use epidemiology","Work"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-OT","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-WORK"],"OT":["Biomathematics and Statistics Scotland, Edinburgh, United Kingdom."],"U":["DI-U-ALL","DI-U-CBS","DI-U-KU","DI-U-SDU"]},"level3all":["DI-GV-WORK","DI-U-CBS","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"the physical activity paradox revisited a prospective study on compositional accelerometer data and long term sickness absence","src":["ku","nfa","sdu"],"src-code":["DI-GV-WORK","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1186/s12966-020-00988-7","version":"Published Version"},"id":"S03-099.24-768773","identifier":[{"id":"32690043","type":"pmid"},{"id":"PMC7370435","type":"pmcid"},{"id":"000552416200001","type":"wos"},{"id":"85088352025","type":"scopus"}],"ids":["ku-3ddfd6f6-8318-41b1-9ea0-51c5be57cffe","nfa-ebe4e1f1-93cf-482a-8a38-7827f708d871","sdu-c58ea28b-e527-4717-bda6-8df060539426"],"keyword":["ALL-CAUSE MORTALITY","Accelerometers","FUTURE DISABILITY PENSION","Fysisk aktivitet","HEALTH","LEISURE-TIME","MARKER","Occupational health","PREDICTOR","PROSPECTIVE COHORT","Physical activity","RISK","Register-based sickness absence","Sedentary behavior","Sick leave","Time-use epidemiology","WORK"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-E0F3DDD873E7BCA6D9F86A4CA1F27B6E"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/171638848/s12966_020_00988_7.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1186/s12966-020-00988-7","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/246634547/The_physical_activity_paradox_revisited.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"nfa national research centre for the working environment","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-WORK","l3nn":"NFA National Research Centre for the Working Environment","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"NFA National Research Centre for the Working Environment","namevar":["The National Research Centre for the Working Environment","The National Research Centre for the Working Environment, Directors, Musculoskeletal Disorders and Physical Workload"],"nora_code":"DI-GV-WORK","used":1},{"affno":"2","country":"dk","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School"],"nora_code":"DI-U-CBS","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Section of Social Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"