{"abstract":"Polycyclic aromatic polyketides represent an important group of Natural Products (NPs) exhibiting a broad variety of antimicrobial and cytotoxic activities.","author_count":8,"contributors":["Subko, Karolina","Wolff, Peter B.","Theobald, Sebastian","Frisvad, Jens Christian","Gotfredsen, Charlotte Held","Andersen, Mikael Rørdam","Mortensen, Uffe Hasbro","Larsen, Thomas Ostenfeld"],"cuid":["S01-000.00-364340"],"event":{"end":"2018-07-25","place":"Lexington, us","start":"2018-07-21","title":"The American Society of Pharmacognosy Annual Meeting 2018","year":"2018"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"genomics driven discovery and engineering of fungal polycyclic polyketides","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/163087696/2018_Program_and_Abstract_Book.pdf","version":"Published Version"},"id":"S01-000.00-364340","ids":["dtu-c8219c15-c1ca-4b9f-83bf-004cce15802b"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-D0756D6B5C836523A90510D6213CA981"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/163087696/2018_Program_and_Abstract_Book.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Biotechnology and Biomedicine","Technical University of Denmark, Department of Biotechnology and Biomedicine, Section for Microbial and Chemical Ecology","Technical University of Denmark, Department of Biotechnology and Biomedicine, Section for Microbial and Chemical Ecology, Natural Product Discovery"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Karolina","key":"subkopau","last":"Subko","locid":"94462002-5b2a-42f2-b5d2-66c8c06db4e6","name":"Subko, Karolina","orcid":"0000-0002-9993-8386","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peter B.","key":"wolffpau","last":"Wolff","locid":"df7eba21-df08-438a-a488-8456b01a0ee7","name":"Wolff, Peter B.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sebastian","key":"theobaldpau","last":"Theobald","locid":"64b77a64-2264-4ae5-bac9-83f59e47e9a1","name":"Theobald, Sebastian","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens C.","key":"frisvadpau","last":"Frisvad","locid":"b2d4f948-9e1c-4f8c-9c02-05588bfa21b9","name":"Frisvad, Jens Christian","name_org":"Frisvad, Jens C.","orcid":"0000-0002-0573-4340","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Charlotte H.","key":"gotfredsenpau","last":"Gotfredsen","locid":"1cf4df84-2d0e-4693-bf47-e9932e3bf0e3","name":"Gotfredsen, Charlotte Held","name_org":"Gotfredsen, Charlotte H.","orcid":"0000-0002-7386-119X","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mikael R.","key":"andersenpau","last":"Andersen","locid":"2b65dbe3-5af3-4d59-84ef-d999b36e5376","name":"Andersen, Mikael Rørdam","name_org":"Andersen, Mikael R.","orcid":"0000-0003-4794-6808","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Uffe H.","key":"mortensenpau","last":"Mortensen","locid":"dec3038b-f004-4c96-84a1-52825e1c0ce8","name":"Mortensen, Uffe Hasbro","name_org":"Mortensen, Uffe H.","orcid":"0000-0002-7794-7273","rank":7,"rolecode":"pau"},{"affno":"1","corre