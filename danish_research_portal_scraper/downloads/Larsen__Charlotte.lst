3d-b353-44de-a850-f3c7dec879cb","name":"Larsen, Lars Erik","orcid":"0000-0003-0730-5555","rank":8,"rolecode":"pau"},{"affno":"9","corresponding":null,"first":"Marina","key":"moninipau","last":"Monini","name":"Monini, Marina","rank":9,"rolecode":"pau"},{"affno":"11","corresponding":null,"first":"Mateja","key":"poljšakprijateljpau","last":"Poljšak-Prijatelj","name":"Poljšak-Prijatelj, Mateja","rank":10,"rolecode":"pau"},{"affno":"8","corresponding":null,"first":"Pierre","key":"pothierpau","last":"Pothier","name":"Pothier, Pierre","rank":11,"rolecode":"pau"},{"affno":"9","corresponding":null,"first":"Franco M.","key":"ruggeripau","last":"Ruggeri","name":"Ruggeri, Franco M.","rank":12,"rolecode":"pau"},{"affno":"12","corresponding":null,"first":"Andrej","key":"steyerpau","last":"Steyer","name":"Steyer, Andrej","rank":13,"rolecode":"pau"},{"affno":"13","corresponding":null,"first":"Marion","key":"koopmanspau","last":"Koopmans","name":"Koopmans, Marion","rank":14,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Blenda","key":"böttigerpau","last":"Böttiger","name":"Böttiger, Blenda","rank":15,"rolecode":"pau"}],"pmid":["22079216"],"pub":{"doi":"10.1016/j.vetmic.2011.10.027","issn":["03781135","18732542"],"issn_org":["03781135"],"issue":"3-4","journal":"Veterinary Microbiology","pages":"238-245","publisher":"Elsevier","status":"p","title":"Veterinary Microbiology","volume":"156"},"review":"Peer Reviewed","scoID":["2-s2.0-84858745969"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-f99a8026-5dbe-42cd-839f-d8a706dcfd5f","ku-b6f6f868-2533-4312-bc2c-4e1e11a9a64a"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Diversity and zoonotic potential of rotaviruses in swine and cattle across Europe.","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.93-038123","year":"2012","yearsub":"2012"}
{"abstract":"Internettet er i dag blevet essentielt for mange forskere; både som forskningsobjekt, dataindsamlings-værktøj, kommunikationsplatform, samlingssted eller publiceringskanal. I dette kapitel skal vi se på, hvad der sker, når dataindsamlingen går online, og vi studerer internetbaserede praksisser. Kapitlet vil først introducere til ’virtuel etnografi’, som er en central metodisk tilgang inden for internetforskningen, og som anvendes af mange forskere til at observere og dokumentere social adfærd på internettet. Derefter diskuteres nogle af de udfordringer, man generelt står overfor, når man ønsker at udføre kvalitative internetstudier. Kapitlet tager udgangspunkt i fem centrale problematikker, som forfatterens selv har været i berøring med i forbindelse med sin egen forskning i danske unges brug af sociale netværkssider (SNS’er) som Facebook og Arto.","author_count":3,"contributors":["Larsen, Malene Charlotte"],"cuid":["S01-000.00-096402"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"når dataindsamlingen går online udfordringer for den kvalitative internetforsker","src":["aau"],"src-code":["DI-U-AAU"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-096402","ids":["aau-9ff450e7-c429-4b28-9060-fd87d628dc5e"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-05703C55970045A5C2856ECF2D70A436"],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Humanities","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Centre for Discourse Studies","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, E-learning lab","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, InDiMedia (Centre for Interactive Digital Media & Experience Design)"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Malene Charlotte","key":"larsenpau","last":"Larsen","locid":"cc0033d3-6794-4e0c-b451-939e05f9a1ee","name":"Larsen, Malene Charlotte","orcid":"0000-0003-4821-5855","rank":1,"rolecode":"pau"},{"affno":"","first":"Michael","key":"hviidjacobsenpedh","last":"Hviid Jacobsen","name":"Hviid Jacobsen, Michael","rank":2,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Sune","key":"qvotrupjensenpedh","last":"Qvotrup Jensen","name":"Qvotrup Jensen, Sune","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9788741252094"],"pages":"233-269","place":"København","publisher":"Hans Reitzels Forlag","status":"p","title":"Kvalitative udfordringer"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-9ff450e7-c429-4b28-9060-fd87d628dc5e"],"src":["AAU Aalborg University"],"title":"Når dataindsamlingen går online : Udfordringer for den kvalitative internetforsker","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-096402","year":"2012","yearsub":"2012"}
