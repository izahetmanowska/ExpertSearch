rusantipau","last":"Charusanti","locid":"e5edf515-a516-43a0-afa5-fe4a24ca42eb","name":"Charusanti, Pep","orcid":"0000-0003-0009-6615","rank":14,"rolecode":"pau"}],"pmid":["36040247"],"pub":{"doi":"10.1021/acschembio.2c00480","issn":["15548929","15548937"],"issn_org":["15548929"],"issue":"9","journal":"ACS chemical biology","pages":"2411-2417","publisher":"American Chemical Society","status":"p","title":"ACS chemical biology","volume":"17"},"review":"Peer Reviewed","scoID":["2-s2.0-85138068817"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-d37e9c18-0a7d-4009-8a82-dda7e33402da"],"src":["DTU Technical University of Denmark"],"title":"Identification of the Biosynthetic Gene Cluster for Pyracrimycin A, an Antibiotic Produced by <i>Streptomyces</i> sp.","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-367760","year":"2022","yearsub":"2022"}
{"abstract":"Background: Along with an expanding global swine production, the commercial housing and management of swine herds, provide an optimal environment for constant circulation of swine influenza virus (swIAV), thereby challenging farmers and veterinarian in determining optimal control measures. The aim of this study was to investigate the role of gilts in the swIAV transmission dynamics, and to evaluate the impact of different control measures such as quarantine and gilt vaccination. Methods: The study was conducted as a cross-sectional study in ten Danish sow herds, including five swIAV vaccinated and five unvaccinated herds. Blood- and nasal swab samples of gilts, first parity sows and their piglets were collected at different stages in the production system (quarantine in/out, mating, gestation and farrowing) and analyzed for the presence of swIAV and swIAV antibodies. Associations between the detection of swIAV, seroprevalence, antibody levels, sow and gilt vaccination strategy and quarantine biosecurity were thereafter investigated to identify possible risk factors for swIAV introductions and persistence within the herds. Results: Nine of the ten herds of the study had swIAV circulation and swIAV was detected in the quarantine, mating- and farrowing unit. The prevalence of seropositive gilts and first parity sows was significantly higher in the vaccinated herds, but swIAV was still present in nasal swabs from both gilts, first parity sows and piglets in these herds. Quarantine gilt vaccination and all-in/all-out management resulted in a significant reduction of swIAV positive gilts at the end of the quarantine period. Conclusion: The results underline that herd vaccination and/or quarantine facilities are crucial to avoid swIAV introductions into sow herds.","author_count":6,"contributors":["Ryt-Hansen, Pia","Nielsen, Henriette Guldberg","Sørensen, Simon Smed","Larsen, Inge","Kristensen, Charlotte Sonne","Larsen, Lars Erik"],"cuid":["S01-000.00-477398"],"filters":{"added":"2022-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Biosecurity","Enzootic infections","Gilts","Management","Quarantine","Swine influenza A virus","Vaccination"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the role of gilts in transmission dynamics of swine influenza virus and impacts of vaccination strategies and quarantine management","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s40813-022-00261-2","version":"Published Version"},"id":"S01-000.00-477398","identifier":[{"id":"85129591610","type":"scopus"},{"id":"35513878","type":"pmid"},{"id":"PMC9069814","type":"pmcid"}],"ids":["ku-8c648ce6-912e-492f-b38a-a232990b8f4a"],"keyword":["Biosecurity","Enzootic infections","Gilts","Management","Quarantine","Swine influenza A virus","Vaccination"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-A555DC7B910D61C5AD6FD3DDAAC9230F"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s40813-022-00261-2","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/307014426/s40813_022_00261_2.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary and Animal Sciences, Veterinary Clinical Microbiology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Pia","key":"rythansenpiapau","last":"Ryt-Hansen","locid":"3bc2c20c-771a-4d73-9424-e1173143a632","name":"Ryt-Hansen, Pia","rank":1,"rolecode":"pau"},{"affno":"1","first":"Henriette Guldberg","key":"nielsenhenrietteguldbergpau","last":"Nielsen","name":"Nielsen, Henriette Guldberg","rank":2,"rolecode":"pau"},{"affno":"1","first":"Simon Smed","key":"sørensensimonsmedpau","last":"Sørensen","name":"Sørensen, Simon Smed","rank":3,"rolecode":"pau"},{"affno":"1","first":"Inge","key":"larseningepau","last":"Larsen","locid":"82b09bf9-73d5-4c71-a3c1-01e66b0e9ebe","name":"Larsen, Inge","orcid":"0000-0003-4575-2241","rank":4,"rolecode":"pau"},{"affno":"","first":"Charlotte Sonne","key":"kristensencharlottesonnepau","last":"Kristensen","name":"Kristensen, Charlotte Sonne","rank":5,"rolecode":"pau"},{"affno":"1","first":"Lars Erik","key":"larsenlarserikpau","last":"Larsen","locid":"135a9407-d29c-4508-8f79-978f5b295a15","name":"Larsen, Lars Erik","orcid":"0000-0003-0730-5555","rank":6,"rolecode":"pau"}],"pmid":["35513878"],"pub":{"doi":"10.1186/s40813-022-00261-2","issn":["20555660"],"issue":"1","journal":"Porcine Health Management","paperid":"19","status":"p","title":"Porcine Health Management","volume":"8"},"review":"Peer Reviewed","scoID":["2-s2.0-85129591610"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-8c648ce6-912e-492f-b38a-a232990b8f4a"],"src":["KU University of Copenhagen"],"title":"The role of gilts in transmission dynamics of swine influenza virus and impacts of vaccination strategies and quarantine management","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-477398","year":"2022","yearsub":"2022"}
{"abstract":"High pathogenicity avian influenza viruses clade 2.3.4.4 H5 have spread among wild birds worldwide during recent years causing annual die-offs among wild birds and outbreaks in poultry in multiple European countries. The outbreaks significantly impact the poultry and game bird sectors. Infected game birds may act as a bridging species potentially enabling spread of virus into commercial and backyard premises. In this study, the pathogenesis and transmission of a HPAIV clade 2.3.4.4b H5N6 virus was investigated in pheasants and chickens. Efficient virus transmission was detected between pheasants over multiple rounds of naïve pheasant introductions and onwards to chickens. Mortality of up to 100% was observed for both infected pheasants and chickens. Intra-species transmission from chicken to chicken was less efficient. The study confirmed that clade 2.3.4.4b H5N6 HPAIV is highly virulent in pheasants and emphasises the role of pheasants as a bridging host for the infection of commercial poultry.","author_count":12,"contributors":["Liang, Yuan","Hjulsager, Charlotte K.","Seekings, Amanda H.","Warren, Caroline J.","Lean, Fabian Z.X.","Núñez, Alejandro","James, Joe","Thomas, Saumya S.","Banyard, Ashley C.","Slomka, Marek J.","Brown, Ian H.","Larsen, Lars Erik"],"cuid":["S01-000.00-501821"],"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","Animal and Plant Health Agency"],"keyword":["Avian","Chicken","Epidemic","Influenza","Pathogenesis","Pheasant","Transmission"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-GV-SSI","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"pathogenesis and infection dynamics of high pathogenicity avian influenza v