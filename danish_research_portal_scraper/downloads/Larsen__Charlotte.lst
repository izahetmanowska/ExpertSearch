"},{"affno":"19","corresponding":null,"first":"Arja","key":"viinanenpau","last":"Viinanen","name":"Viinanen, Arja","rank":18,"rolecode":"pau"},{"affno":"20 21","corresponding":null,"first":"Dora","key":"ludviksdottirpau","last":"Ludviksdottir","name":"Ludviksdottir, Dora","rank":19,"rolecode":"pau"},{"affno":"22","corresponding":null,"first":"Paula","key":"kauppipau","last":"Kauppi","name":"Kauppi, Paula","rank":20,"rolecode":"pau"},{"affno":"9","first":"Asger","key":"sverrildpau","last":"Sverrild","locid":"c24edad8-f827-4baa-8771-bba2b50c0ccb","name":"Sverrild, Asger","rank":21,"rolecode":"pau"},{"affno":"10 23","corresponding":null,"first":"Sverre","key":"lehmannpau","last":"Lehmann","name":"Lehmann, Sverre","rank":22,"rolecode":"pau"},{"affno":"9","first":"Vibeke","key":"backerpau","last":"Backer","locid":"8ea3c13b-5a32-4002-b7bb-4621659a1827","name":"Backer, Vibeke","rank":23,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Valentyna","key":"yasinskapau","last":"Yasinska","name":"Yasinska, Valentyna","rank":24,"rolecode":"pau"},{"affno":"24 25","corresponding":null,"country":"dk","first":"Tina","key":"skjoldpau","last":"Skjold","locid":"105e0903-9b8a-4642-925b-895ff931accb","name":"Skjold, Tina","rank":25,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Jussi","key":"karjalainenpau","last":"Karjalainen","name":"Karjalainen, Jussi","rank":26,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Apostolos","key":"bossiospau","last":"Bossios","name":"Bossios, Apostolos","rank":27,"rolecode":"pau"},{"affno":"9","first":"Celeste","key":"porsbjergpau","last":"Porsbjerg","locid":"990b2125-b509-42b3-8fde-7014125da044","name":"Porsbjerg, Celeste","rank":28,"rolecode":"pau"}],"pmid":["37020835"],"pub":{"doi":"10.1183/23120541.00687-2022","issn":["23120541"],"issue":"2","journal":"ERJ Open Research","paperid":"00687-2022","publisher":"European Respiratory Society","status":"p","title":"ERJ Open Research","volume":"9"},"review":"Peer Reviewed"