d-82f3f2ddc9ba","name":"Christensen, Robin","orcid":"0000-0002-6600-0631","rank":9,"rolecode":"pau"},{"affno":"5 7","corresponding":null,"first":"Jens Steen","key":"nielsenjenssteenpau","last":"Nielsen","locid":"dbe41314-5802-4a25-853c-1dd6986e2d58","name":"Nielsen, Jens Steen","orcid":"0000-0003-3179-1186","rank":10,"rolecode":"pau"},{"affno":"7 4","corresponding":null,"first":"Allan Arthur","key":"vaagallanarthurpau","last":"Vaag","name":"Vaag, Allan Arthur","rank":11,"rolecode":"pau"},{"affno":"1 3","first":"Bente Klarlund","key":"pedersenbenteklarlundpau","last":"Pedersen","locid":"5d38d54e-e0d1-4397-98ca-6d8c9b78606d","name":"Pedersen, Bente Klarlund","rank":12,"rolecode":"pau"},{"affno":"3 1","first":"Henning","key":"langberghenningpau","last":"Langberg","locid":"aa9694cb-06fd-4f81-a6f7-c5862f8d3499","name":"Langberg, Henning","orcid":"0000-0001-8454-6534","rank":13,"rolecode":"pau"},{"affno":"1 5","corresponding":null,"first":"Mathias","key":"riedlarsenmathiaspau","last":"Ried-Larsen","locid":"4429747d-bba0-4bed-b4f0-b081efe5d5b8","name":"Ried-Larsen, Mathias","orcid":"0000-0002-8388-5291","rank":14,"rolecode":"pau"}],"pmid":["36170002"],"pub":{"doi":"10.2196/30602","issn":["22915222"],"issue":"9","journal":"JMIR mHealth and uHealth","paperid":"e30602","publisher":"JMIR Publications Inc.","publisher_org":"J M I R Publications, Inc.","status":"p","title":"JMIR mHealth and uHealth","volume":"10"},"review":"Peer Reviewed","scoID":["2-s2.0-85139375691"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-e1fddc48-afd1-4564-a48a-f85ceac08a06","ku-c6a17cd3-cdcc-43af-ad08-7f89d014c40b","sdu-32db67ae-1946-4202-87ee-c85397b9187e"],"src":["AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"The Effects of a Lifestyle Intervention Supported by the InterWalk Smartphone App on Increasing Physical Activity Among Persons With Type 2 Diabetes : Parallel-Group, Randomized Trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-099.89-029051","year":"2022","yearsub":"2022"}
{"abstract":"Introduction: Human non-live vaccines have been associated with detrimental non-specific effects (NSE), particularly in females. A large trial found 2-fold increased overall mortality in girls receiving a new malaria vaccine compared to the rabies vaccine used as a coontrol; a beneficial NSE of the rabies vaccine was proposed. Conversely, in dogs increased mortality was seen in females but not males following rabies vaccination of puppies born to immunized mothers. We investigated NSE of non-live rabies vaccine in piglets and the potential modifying effect of maternal priming with rabies vaccine. Methods: In a Danish herd of commercial rabies virus-free pigs, 575 pregnant sows (2–3 weeks before scheduled farrowing) and 5747 of their offspring (median 6-day-old) were allocated (1:1) to non-live rabies vaccine (Versiguard rabies vet) or no rabies vaccine. Outcomes were overall mortality and antibiotic treatment until departure from the nursery (approximately age 12 weeks/30 kgs). Results: Until weaning, overall offspring mortality was 2.2% (127 piglets died, rabies vaccine: n = 69; control: n = 58), the proportion ratio (PR) being 1.19 (95% confidence interval: 0.84–1.68). Until end of follow-up, mortality was 4.1% (233, rabies vaccine: n = 115; control = 118, PR: 0.97 (0.76–1.25)). Prior sow rabies vaccination did not affect piglet mortality. For mortality as well as risk of antibiotic treatment before weaning, there was indication of a beneficial effect of rabies vaccine in female piglets, but a negative effect in (castrated) male piglets from rabies-naïve sows. Prior sow vaccination significantly modified the vaccine effect estimate in female piglets toward a detrimental effect of rabies vaccine on treatment risk. These effects had waned by 12 weeks of age. Conclusion: The study did not support the hypothesized beneficial NSE of rabies vaccine. Although under-powered for subgroup analyses, the study indicated effect modification by sex and maternal vaccination. Results could be different in a herd with higher mortality and infectious burden.","author_count":8,"contributors":["Jensen, Kristoffer Jarlov","Tolstrup, Lola Kathe","Knobel, Darryn L.","Aaby, Peter","Jungersen, Gregers","Larsen, Lars Erik","Kristensen, Charlotte Sonne","Benn, Christine Stabell"],"cuid":["S03-099.95-033790"],"filters":{"added":"2022-04","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"continent":["Africa","America, Central"],"corresponding_author":["Jensen, Kristoffer Jarlov"],"country":["Ghana","Guinea-Bissau","South Africa","St Kitts and Nevis"],"glorg":["All Global Affiliations","Bandim Health Project","INDEPTH Network","National Institute of Public Health in Guinea-Bissau","Ross University School of Veterinary Medicine","Ross University School of Veterinary Medicine Saint Kitts and Nevis","University of Pretoria"],"keyword":["Animals","Anti Bacterial Agents","Denmark","Dogs","Female","Heterologous immunity","Male","Non specific effects","Pigs","Pregnancy","Rabies vaccine","Swine","Vaccination veterinary","Vaccine","Weaning"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-PR","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP"],"PR":["DI-PR-AAF","DI-PR-ALL","DI-PR-SEGES"],"U":["DI-U-ALL","DI-U-CBS","DI-U-DTU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-PR-AAF","DI-PR-SEGES","DI-U-CBS","DI-U-DTU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"non specific effects of maternal and offspring rabies vaccination on mortality and antibiotic use in a danish pig herd a randomized trial","src":["dtu","ku","sdu"],"src-code":["DI-U-DTU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/353942917/manus_rabies_1strev_2021_03_16_clean_2_27.pdf","version":"Authors Final Version"},"funding_acknowledgement":["The study was supported by Novo Nordisk Foundation (grant no. 12169 ) and Pig Levy Fund ( www.svineafgiftsfonden.dk ). The funders had no influence on any aspect of the work."],"id":"S03-099.95-033790","identifier":[{"id":"85103923563","type":"scopus"},{"id":"33840563","type":"pmid"}],"ids":["dtu-36106493-5c8e-4272-b23e-e3bfa76a6351","ku-30ca69b3-960f-49c0-a04c-6640390595e7","sdu-6bfca141-8c69-4bef-b2e6-f59e1f1a3516"],"keyword":["Animals","Anti-Bacterial Agents","Denmark","Dogs","Female","Heterologous immunity","Male","Non-specific effects","Pigs","Pregnancy","Rabies vaccine","Rabies/prevention & control","Swine","Vaccination/veterinary","Vaccine","Weaning"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-6-06109A8210A8298616A9067EB646F5C8"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/353942917/manus_rabies_1strev_2021_03_16_clean_2_27.pdf","version":"Authors Final Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/182730617/manus_rabies_1strev_2021_03_16_clean.pdf","version":"Authors Final Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/358654683/manus_rabies_1strev_2021_03_16_clean_2_27.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research Unit OPEN (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"ca