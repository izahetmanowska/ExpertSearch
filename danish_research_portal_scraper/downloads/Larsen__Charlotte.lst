B.","key":"liumpau","last":"Lium","name":"Lium, B.","rank":7,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-1f6bdc91-c658-485c-bdf0-396935d80718"],"src":["DTU Technical University of Denmark"],"title":"Pandemic H1N1 2009 virus in Norwegian pigs naïve to influenza A viruses","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-313936","year":"2011","yearsub":"2011"}
