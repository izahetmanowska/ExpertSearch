":16,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Anne","key":"nakanopau","last":"Nakano","name":"Nakano, Anne","rank":17,"rolecode":"pau"},{"affno":"1 9","corresponding":null,"first":"Henriette Knold","key":"rossaupau","last":"Rossau","locid":"8bafb9fa-54ed-4732-8c59-ccd9b20be7fb","name":"Rossau, Henriette Knold","orcid":"0000-0002-4263-3960","rank":18,"rolecode":"pau"}],"pub":{"pages":"49","place":"Aarhus","publisher":"Regionernes Kliniske Kvalitetsudviklings Program","status":"p","volume":"2"},"review":"Undetermined","search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","North Denmark Region","Other Research","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-ac25e018-bfc8-4bfb-87fb-2fa60661cbe1","sdu-eff449aa-84da-4225-b110-aab0fefbb0f9"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Dansk Hjerterehabiliteringsdatabase : Strukturelle forhold i 2015 samt opgørelse af patientgrundlag for – og kodeaktivitet i relation til rehabiliteringsydelser opgjort fra Landspatientregistret i 2014","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-098.12-045247","year":"2016","yearsub":"2016"}
{"abstract":"Aim: The aim of the Danish National Database for Obstructive Sleep Apnea (NDOSA) was to evaluate the clinical quality (diagnostic, treatment, and management) for obstructive sleep apnea and obesity hypoventilation syndrome in Denmark using a real-time national database reporting to the Danish National Patient Registry. Study population: All patients diagnosed with obstructive sleep apnea or obesity hypoventilation syndrome at public and private in- and out-hospital departments in Denmark were included. Main variables: The NDOSA contains information about baseline characteristics, comorbidity, diagnostic procedures conducted, treatment (continuous positive airway pressure and similar treatments, surgery, mandibular advancement devices, etc) complications, and treatment status. Descriptive data: Yearly report with indicators for diagnostic procedures, treatment, and follow-up comparing different departments was involved in the management of sleep apnea in Denmark for the purpose of quality improvement. Conclusion: The NDOSA has proven to be a real-time national database using diagnostic and treatment procedures reported to the Danish National Patient Registry.","author_count":5,"contributors":["Jennum, Poul","Larsen, Preben","Cerqueira, Charlotte","Schmidt, Thor","Tønnesen, Philip"],"cuid":["S02-100.00-047238"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Clinical registry","Journal Article","Obstructive sleep apnea","Quality of care"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"OT":["Registry Support Centre (East) - Clinical Quality Improvement and Health Informatics, Capital Region of Denmark, Copenhagen, Denmark."],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"the danish national database for obstructive sleep apnea","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.2147/CLEP.S101969","version":"Published Version"},"id":"S02-100.00-047238","identifier":[{"id":"27843344","type":"pmid"},{"id":"PMC5098514","type":"pmcid"},{"id":"84995587973","type":"scopus"}],"ids":["ku-ef22aa70-fa2b-4a7c-9e7e-c2ddf2bd581b","sdu-8ba6d0f3-db77-4a82-9b75-268a111671c6"],"keyword":["Clinical registry","Journal Article","Obesity hypoventilation syndrome","Obstructive sleep apnea","Quality of care"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-8FCCDEA5FB507E757C3FDEB52A331C7B"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.2147/CLEP.S101969","version":"Published Version"},{"access":"oa","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC5098514/pdf/clep-8-573.pdf","version":"Pre-print"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/129609666/The_Danish_National_Database_for_Obstructive_Sleep_Apnea.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Regional Health Research, Kolding Hospital"],"nora_code":"DI-U-SDU","used":1},{"affno":"4","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Registry Support Centre (East) - Clinical Quality Improvement and Health Informatics, Capital Region of Denmark, Copenhagen, Denmark."],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1 2","first":"Poul Jørgen","key":"jennumpau","last":"Jennum","locid":"09499315-7437-47b1-a859-6783b0dd67c1","name":"Jennum, Poul","name_org":"Jennum, Poul Jørgen","orcid":"0000-0001-6986-5254","rank":1,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Preben","key":"larsenpau","last":"Larsen","locid":"0f940985-b6e4-4e8e-b8a6-b087d636719a","name":"Larsen, Preben","rank":2,"rolecode":"pau"},{"affno":"1 2","first":"Charlotte","key":"cerqueirapau","last":"Cerqueira","locid":"7e964b90-554b-4d92-8ebc-83e1fe686130","name":"Cerqueira, Charlotte","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Thor","key":"schmidtpau","last":"Schmidt","name":"Schmidt, Thor","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Philip","key":"tønnesenpau","last":"Tønnesen","name":"Tønnesen, Philip","rank":5,"rolecode":"pau"}],"pmid":["27843344"],"pub":{"doi":"10.2147/clep.s101969","issn":["11791349"],"journal":"Clinical Epidemiology","pages":"573-576","publisher":"Dove Medical Press","status":"p","title":"Clinical Epidemiology","volume":"8"},"re