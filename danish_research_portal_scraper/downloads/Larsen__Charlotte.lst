f Ecoscience, Department of Ecoscience - Marine Diversity and Experimental Ecology"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Food Institute","Technical University of Denmark, National Food Institute, Research Group for Food Microbiology and Hygiene"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Martin Mørk","key":"larsenpau","last":"Larsen","locid":"d24cdbff-3543-4170-b95f-c315ce7477bb","name":"Larsen, Martin Mørk","orcid":"0000-0003-4331-8548","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Hans","key":"jakobsenpau","last":"Jakobsen","locid":"115e2890-be07-49a8-a340-d271dd22ac2b","name":"Jakobsen, Hans","orcid":"0000-0001-9590-2362","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Cordula","key":"gökepau","last":"Göke","locid":"203ca293-fd97-4b16-8eba-24b61d042e20","name":"Göke, Cordula","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Niels Bohse","key":"hendriksenpau","last":"Hendriksen","locid":"50fd9962-24ef-4560-9838-1bb6da39e607","name":"Hendriksen, Niels Bohse","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jonas","key":"koefoedrømerpau","last":"Koefoed Rømer","locid":"02a85068-d9f1-4a76-a2f6-b5751937ada4","name":"Koefoed Rømer, Jonas","orcid":"0000-0002-8895-2529","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Christian","key":"mohnpau","last":"Mohn","locid":"3249f637-7852-40ab-b6ac-1b8670bcd9c9","name":"Mohn, Christian","orcid":"0000-0002-4331-1365","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Louise","key":"feldpau","last":"Feld","locid":"6f3799a8-1a83-45f3-b06e-2e8769481bb5","name":"Feld, Louise","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Annette Nygaard","key":"jensenpau","last":"Jensen","locid":"45d88d2c-4bbc-4adf-8822-a0ddb19bbda6","name":"Jensen, Annette Nygaard","orcid":"0000-0001-9681-7258","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Anna Charlotte","key":"schultzpau","last":"Schultz","locid":"3a3d5130-acf6-4846-93e3-f3b891d83e60","name":"Schultz, Anna Charlotte","orcid":"0000-0003-1484-9120","rank":9,"rolecode":"pau"}],"pub":{"issn":["2244999X"],"issue":"126","pages":"106","publisher":"Aarhus Universitet & DTU Fødevareinstituttet","repno":"Aarhus Universitet. Nationalt Center for Miljo og Energi. Teknisk Rapport, No. 126","series":"Aarhus Universitet. Nationalt Center for Miljo og Energi. Teknisk Rapport","status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["au-6df1be82-af78-49e2-997b-4ea7aa73d66a","dtu-a1ab0a31-6765-404f-894f-61b4be1e9206"],"src":["AU Aarhus University","DTU Technical University of Denmark"],"title":"Sanitary survey rapport 8 : Kalø Vig og Jyllands østkyst (nordlig del)","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-088.29-020707","year":"2018","yearsub":"2018"}
{"abstract":"Integrated buffer zones (IBZs) represent a novel form of edge-of-field technology in Northwest Europe. Contrary to the common riparian buffer strips, IBZs collect tile drainage water from agricultural fields by combining a ditch-like pond (POND), where soil particles can settle, and a flow-through filter bed (FILTERBED) planted with Alnus glutinosa (L.), a European alder (black alder). The first experimental IBZ facility was constructed and thoroughly tested in Denmark for its capability to retain various nitrogen (N) and phosphorus (P) species within the first three years after construction. We calculated the water and nutrient budget for the total IBZ and for the two compartments, POND and FILTERBED, separately. Furthermore, a tracer experiment using sodium bromide was conducted in order to trace the water flow and estimate the hydraulic residence time in the FILTERBEDs. The monthly average removal efficiency amounted to 10-67% for total N and 31-69% for total P, with performance being highest during the warm season. Accordingly, we suggest that IBZs may be a valuable modification of dry buffer strips in order to mitigate the adverse impacts of high nutrient loading from agricultural fields on the aquatic environment.","author_count":12,"contributors":["Zak, Dominik Henrik","Kronvang, Brian","Carstensen, Mette Vodder","Hoffmann, Carl Christian","Kjeldgaard, Ane","Larsen, Soren E.","Audet, Joachim","Egemose, Sara","Jorgensen, Charlotte A.","Feuerbach, Peter","Gertz, Flemming","Jensen, Henning S."],"cuid":["S02-095.05-028051"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","Nordic","OECD"],"corresponding_author":["Zak, Dominik Henrik"],"country":["Germany","Sweden"],"glorg":["All Global Affiliations","Leibniz-Institute of Freshwater Ecology and Inland Fisheries","Swedish University of Agricultural Sciences"],"keyword":["Constructed wetlands","Denitrification","Eutrophication","Fresh Water","Harmful algal blooms","Nitrate","Organic carbon","Release","Riparian zones","Water quality"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-PR","DI-U"],"level3":{"OT":["Unspecified organisation"],"PR":["DI-PR-ALL","DI-PR-SEGES"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-PR-SEGES","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"nitrogen and phosphorus removal from agricultural runoff in integrated buffer zones","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/143271017/Nitrogen_and_phosphorus_removal_from_agricultural_runoff_in_integrated_buffer_zones.pdf","version":"Authors Final Version"},"id":"S02-095.05-028051","identifier":[{"id":"29733209","type":"pmid"},{"id":"85046711812","type":"scopus"},{"id":"000434892900046","type":"wos"}],"ids":["au-d48099bb-51b6-47ba-a489-c93c70613fff","sdu-75ceea45-1fab-41f5-9668-c24a5a2d89bd"],"keyword":["CONSTRUCTED WETLANDS","DENITRIFICATION","EUTROPHICATION","FRESH-WATER","HARMFUL ALGAL BLOOMS","NITRATE","ORGANIC-CARBON","RELEASE","RIPARIAN ZONES","WATER-QUALITY"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-618FFF145CB8E520A45423C705BDDB8F"],"oa_link":[{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/143271017/Nitrogen_and_phosphorus_removal_from_agricultural_runoff_in_integrated_buffer_zones.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Ecoscience, Department of Ecoscience - Catchment Science and Environmental Management"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Science, Department of Biology"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1},{"affno":"4","country":"dk","key":"seges innovation","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-SEGES","l3nn":"SEGES Innovation","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SEGES Innovation","namevar":["SEGES"],"nora_code":"DI-PR-SEGES","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Dominik","key":"zakpau","last":"Zak","locid":"cf9c5160-4e88-4f36-a663-8d9d45abc7df","name":"Zak, Dominik Henrik","name_org":"Zak, Dominik","orcid":"0000-0002-1229-5294","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Brian","key":"kronvangpau","last":"Kronvang","locid":"7766931c-a3c9-4a38-9d22-e4cc3a2f4607","name":"Kronvang, Brian","orcid":"0000-0003-1165-1354","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mette","key":"carstensenpau","last":"Carstensen","locid":"142356a9-6bec-4f9d-a05d-2e144e4a792e","name":"Carstensen, Mette Vodder","name_org":"Carstensen, Mette","orcid":"0000-0003-4882-9945","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Carl C.","key":"hoffmannpau","last":"Hoffmann","locid":"353a0760-7b7a-4348-9f47-7df140234554","name":"Hoffmann, Carl Christian","name_org":"Hoffmann, Carl C.","orcid":"0000-0002-1268-9162","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ane","key":"kjeldgaardpau","last":"Kjeldgaard","locid":"72d1ba2a-ac20-4b53-a21f-29ee8ebc13d9","name":"Kjeldgaard, Ane","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Soren E.","key":"larsenpau","last":"Larsen","locid":"8531f475-1508-4ff9-ad77-7827a3c45d3b","name":"Larsen, Soren E.","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Joachim","key":"audetpau","last":"Audet","locid":"51de9f19-0692-434b-b884-12147bf58637","name":"Audet, Joachim","orcid":"0000-0001-5839-8793","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Sara","key":"egemosepau","last":"Egemose","locid":"c84146e2-effe-4c3b-a5b6-896c8156829f","name":"Egemose, Sara","orcid":"0000-0001-7356-9095","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Charlotte Adam","key":"jørgensenpau","last":"Jørgensen","locid":"7c895f12-43cb-41c2-ad60-68f0373429cd","name":"Jørgensen, Charlotte Adam","rank":9,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Peter","key":"feuerbachpau","last":"Feuerbach","name":"Feuerbach, Peter","rank":10,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Flemming","key":"gertzpau","last":"Gertz","name":"Gertz, Flemming","rank":11,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Henning S.","key":"jensenpau","last":"Jensen","locid":"7c73eb31-0090-4970-a353-03c6b062abd3","name":"Jensen, Henning S.","orcid":"0000-0002-4321-7643","rank":12,"rolecode":"pau"}],"pmid":["29733209"],"pub":{"doi":"10.1021/acs.est.8b01036","issn":["0013936X","15205851"],"issn_org":["0013936X"],"issue":"11","journal":"Environmental Science & Technology","pages":"6508-6517","publisher":"American Chemical Society","status":"p","title":"Environmental Science & Technology","volume":"52"},"review":"Peer Reviewed","scoID":["2-s2.0-85046711812"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Private Research","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Private Research","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-d48099bb-51b6-47ba-a489-c93c70613fff","sdu-75ceea45-1fab-41f5-9668-c24a5a2d89bd"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Nitrogen and Phosphorus Removal from Agricultural Runoff in Integrated Buffer Zones","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-095.05-028051","year":"2018","yearsub":"2018"}
{"abstract":"Background Porcine circovirus type 2 (PCV2) diagnostics in live pigs often involves pooled serum and/or oral fluid samples for group-level determination of viral load by quantitative real-time polymerase chain reaction (qPCR). The purpose of the study was to compare the PCV2 viral load determined by qPCR of paired samples at the pen level of pools of sera (SP) from 4 to 5 pigs and the collective oral fluid (OF) from around 30 pigs corresponding to one rope put in the same pen. Pigs in pens of 2 finishing herds were sampled by cross-sectional (Herd 1) and cross-sectional with follow-up (Herd 2) study designs. In Herd 1, 50 sample pairs consisting of SP from 4 to 5 pigs and OF from around 23 pigs were collected. In Herd 2, 65 sample pairs consisting of 4 (SP) and around 30 (OF) pigs were collected 4 times at 3-week intervals. Results A higher proportion of PCV2-positive pens (86% vs. 80% and 100% vs. 91%) and higher viral loads (mean difference: 2.10 and 1.83 log(10) PCV2 copies per ml) were found in OF versus SP in both herds. The OF cut-off value corresponding to a positive SP (>3 log(10) PCV2 copies per ml) was estimated to 6.5 and 7.36 log(10) PCV2 copies per ml for Herds 1 and 2, respectively. Significant correlations between SP and OF results were found in Herd 1 (rho = 0.69) and the first sampling in Herd 2 (rho = 0.39), but not for the subsequent consecutive 3 samplings in Herd 2. Conclusions The proportion and viral loads of PCV2 positive pens were higher in collective OF (including up to 30 pigs) compared to SP (including 4–5 pigs) of the same pens. Also, OF seemed to detect the PCV2 infection earlier with OF values just below 6.5 (Herd 1) and 7.36 (Herd 2) log(10) being associated with a negative SP for the same pen. Nevertheless, a statistically significant correlation between SP and OF could not be found for all sampling time points, probably due to a high within-pen variation in individual pig viral load becoming very evident in SP of only four or five pigs. Consequently, the results imply that OF is well suited for detecting presence of PCV2 but less so for determining the specific viral load of pigs in a pen.","author_count":10,"contributors":["Nielsen, Gitte Blach","Nielsen, Jens Peter","Haugegaard, John","Leth, Sanne Christiansen","Larsen, Lars Erik","Kristensen, Charlotte Sonne","Pedersen, Ken Steen","Stege, Helle","Hjulsager, Charlotte K.","Houe, Hans"],"cuid":["S02-099.88-033942"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Nielsen, Gitte Blach"],"keyword":["Diagnostics","Finishers","Oral fluid","Pooling","Porcine circovirus type 2","Serum"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-PR","DI-U"],"level3":{"OT":["Porcus Veterinary Pig Practice"],"PR":["DI-PR-ALL","DI-PR-OTH","DI-PR-SEGES"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-PR-OTH","DI-PR-SEGES","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"comparison of serum pools and oral fluid samples for detection of porcine circovirus type 000000000002 by quantitative real time pcr in finisher pigs","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s40813-018-0079-4","version":"Published Version"},"id":"S02-099.88-033942","identifier":[{"id":"85051029711","type":"scopus"},{"id":"PMC5793352","type":"pmcid"},{"id":"29435356","type":"pmid"},{"id":"000427794700001","type":"wos"}],"ids":["dtu-3c761bb0-fd82-422b-8079-200d2374bdfd","ku-3a7f4272-53c2-46e3-81ba-3c4ca3f4cf44"],"keyword":["Diagnostics","Finishers","Oral fluid","Pooling","Porcine circovirus type 2","Serum"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-4-25D860F051D807F146C71F62B9221EA9"],"oa_link