ffno":"1","first":"Lasse S.","key":"vestergaardpau","last":"Vestergaard","name":"Vestergaard, Lasse S.","rank":9,"rolecode":"pau"},{"affno":"2","first":"Lars E.","key":"larsenpau","last":"Larsen","locid":"135a9407-d29c-4508-8f79-978f5b295a15","name":"Larsen, Lars Erik","name_org":"Larsen, Lars E.","orcid":"0000-0003-0730-5555","rank":10,"rolecode":"pau"},{"affno":"1","first":"Ramona","key":"trebbienpau","last":"Trebbien","name":"Trebbien, Ramona","rank":11,"rolecode":"pau"}],"pmid":["34808097"],"pub":{"doi":"10.3201/eid2712.211361","issn":["10806040","10806059"],"issn_org":["10806040"],"issue":"12","journal":"Emerging Infectious Diseases","pages":"3202-3205","status":"p","title":"Emerging Infectious Diseases","volume":"27"},"review":"Peer Reviewed","scoID":["2-s2.0-85120333077"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Hospitals","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Region Zealand","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-81157a8b-6ca4-4f75-b4e3-096c33dd5440"],"src":["KU University of Copenhagen"],"title":"Reassortant influenza A(H1N1)pdm09 virus in elderly woman, Denmark, January 2021","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-470703","year":"2021","yearsub":"2021"}
{"abstract":"Since late 2020, outbreaks of H5 highly pathogenic avian influenza (HPAI) viruses belonging to clade 2.3.4.4b have emerged in Europe. To investigate the evolutionary history of these viruses, we performed genetic characterization on the first HPAI viruses found in Denmark during the autumn of 2020. H5N8 viruses from 14 wild birds and poultry, as well as one H5N5 virus from a wild bird, were characterized by whole genome sequencing and phylogenetic analysis. The Danish H5N8 viruses were found to be genetically similar to each other and to contemporary European clade 2.3.4.4b H5N8 viruses, while the Danish H5N5 virus was shown to be a unique genotype from the H5N5 viruses that circulated at the same time in Russia, Germany, and Belgium. Genetic analyses of one of the H5N8 viruses revealed the presence of a substitution (PB2-M64T) that is highly conserved in human seasonal influenza A viruses. Our analyses showed that the late 2020 clade 2.3.4.4b HPAI H5N8 viruses were most likely new incursions introduced by migrating birds to overwintering sites in Europe, rather than the result of continued circulation of H5N8 viruses from previous introductions to Europe in 2016/2017 and early 2020.","author_count":7,"contributors":["Liang, Yuan","Nissen, Jakob N.","Krog, Jesper S.","Breum, Solvej","Trebbien, Ramona","Larsen, Lars Erik","Hjulsager, Charlotte K."],"cuid":["S01-000.00-478286"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Disease Outbreaks","Europe","Influenza A virus","Influenza in Birds","Phylogeny","Poultry","WILD"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-GV-SSI","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"novel clade 000000000002 000000000003 000000000004 000000000004b highly pathogenic avian influenza a h000000000005n000000000008 and h000000000005n000000000005 viruses in denmark 000000002020","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/v13050886","version":"Published Version"},"id":"S01-000.00-478286","identifier":[{"id":"PMC8151437","type":"pmcid"},{"id":"85107001035","type":"scopus"},{"id":"34065033","type":"pmid"}],"ids":["ku-8de66fcd-2b56-4835-8873-ded86c732bc6"],"keyword":["Disease outbreaks","Europe","H5N5 subtype","H5N8 subtype","Influenza A virus","Influenza in birds","Phylogeny","Poultry","Wild"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-3C665C02620FED7C242DE23C7B1CC904"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/v13050886","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/272124019/viruses_13_00886_v3.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary and Animal Sciences, Veterinary Clinical Microbiology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"ssi statens serum institut","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-SSI","l3nn":"SSI Statens Serum Institut","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SSI Statens Serum Institut","namevar":["Statens Serum Institut"],"nora_code":"DI-GV-SSI","used":1}],"person":[{"affno":"1","first":"Yuan","key":"liangpau","last":"Liang","locid":"15fec07b-8b15-410c-9db2-b2b7fda77736","name":"Liang, Yuan","rank":1,"rolecode":"pau"},{"affno":"2","first":"Jakob N.","key":"nissenpau","last":"Nissen","name":"Nissen, Jakob N.","rank":2,"rolecode":"pau"},{"affno":"2","first":"Jesper S.","key":"krogpau","last":"Krog","name":"Krog, Jesper S.","rank":3,"rolecode":"pau"},{"affno":"2","first":"Solvej","key":"breumpau","last":"Breum","name":"Breum, Solvej","rank":4,"rolecode":"pau"},{"affno":"2","first":"Ramona","key":"trebbienpau","last":"Trebbien","name":"Trebbien, Ramona","rank":5,"rolecode":"pau"},{"affno":"1","first":"Lars E.","key":"larsenpau","last":"Larsen","locid":"135a9407-d29c-4508-8f79-978f5b295a15","name":"Larsen, Lars Erik","name_org":"Larsen, Lars E.","orcid":"0000-0003-0730-5555","rank":6,"rolecode":"pau"},{"affno":"2","first":"Charlotte K.","key":"hjulsagerpau","last":"Hjulsager","name":"Hjulsager, Charlotte K.","rank":7,"rolecode":"pau"}],"pmid":["34065033"],"pub":{"doi":"10.3390/v13050886","issn":["19994915"],"issue":"5","journal":"Viruses","paperid":"886","status":"p","title":"Viruses","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-85107001035"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-8de66fcd-2b56-4835-8873-ded86c732bc6"],"src":["KU University of Copenhagen"],"title":"Novel clade 2.3.4.4b highly pathogenic avian influenza a h5n8 and h5n5 viruses in Denmark, 2020","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-478286","year":"2021","yearsub":"2021"}
{"abstract":"This article discusses theoretical challenges in conceptualising the dialectical relationship between historical conditions and the situated interplay between people in concrete everyday practice. The concept of conflict may help us move beyond tendencies within psychology to separate history and situated practice, structure and activity, and micro- and macroprocesses – and to regard social life as unambiguous or as governed through hegemony. Research on the everyday social life of schools describes societal conflicts about education and how school children deal with unequal conditions when handling the conflictuality of their everyday lives. Analyses of coordination and conflicts between various parties (e.g. children, parents, teachers and psychologists) elucidate connections between intersubjective efforts to make things work in everyday practice and historical struggles related to the school as a social institution. Concepts are required that enable understanding of these processes as historical and political, driven by intersubjectivity related to concrete dilemmas, connected to personal and collaborative conduct of everyday life – processes we term the politics of everyday life. From a social practice perspective, we discuss how to grasp the ways in which people constitute the conditions for each other in a situated interplay in which they deal with common problems and – through these activities – also produce history.","author_count":2,"contributors":["Højholt, Charlotte","Røn Larsen, Maja"],"cuid":["S01-000.00-558313"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Collaboration","Conduct of everyday life","Conflict","Corridor casework","Dialectics","Everyday politics","Inequality","Participation","School life","Social practice"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-RUC"]},"level3all":["DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"conflicts situated inequality and politics of everyday life","src":["ruc"],"src-code":["DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-558313","identifier":[{"id":"85102342380","type":"scopus"}],"ids":["ruc-229c82c0-e034-4d29-87d3-3f523c3432db"],"keyword":["Collaboration","Conduct of everyday life","Conflict","Corridor casework","Dialectics","Everyday politics","Inequality","Participation","School life","Social practice"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-4-E8D4B0406F54885384384FEE9918B819"],"oai":{"class":"Unused","mra":["Humanities (HUM)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of People and Technology","Roskilde University, Department of People and Technology, Subject, Technology and Social Practice"],"nora_code":"DI-U-RUC","used":1}],"person":[{"affno":"1","country":"dk","first":"Charlotte","key":"højholtpau","last":"Højholt","locid":"e1ae7eb0-773c-4cc6-84ac-4868fa79025a","name":"Højholt, Charlotte","orcid":"0000-0003-0601-0456","rank":1,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Maja","key":"rønlarsenpau","last":"Røn Larsen","locid":"43249523-b160-4888-8421-4a606d27561a","name":"Røn Larsen, Maja","orcid":"0000-0003-1413-6059","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1177/1354067x21989950","issn":["1354067X","14617056"],"issn_org":["1354067X"],"issue":"4","journal":"Culture & Psychology","pages":"591-611","status":"p","title":"Culture & Psychology","volume":"27"},"review":"Peer Reviewed","scoID":["2-s2.0-85102342380"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Roskilde University","Universities"],"PST":["Published"]},"sid":["ruc-229c82c0-e034-4d29-87d3-3f523c3432db"],"src":["RUC Roskilde University"],"title":"Conflicts, situated inequality and politics of everyday life","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-558313","year":"2021","yearsub":"2021"}
