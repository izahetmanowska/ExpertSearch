,{"affno":"1","corresponding":null,"country":"dk","first":"Peter","key":"hoklandpeterpau","last":"Hokland","locid":"aeccec22-6cff-49a0-8e57-528866ef5aff","name":"Hokland, Peter","orcid":"0000-0002-1177-9756","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Carsten S","key":"larsencarstenschadepau","last":"Larsen","locid":"2435cb82-03bd-498b-909d-1ef0e99443fe","name":"Larsen, Carsten Schade","name_org":"Larsen, Carsten S","rank":9,"rolecode":"pau"}],"pmid":["24499503"],"pub":{"doi":"10.1186/2052-1839-13-4","issn":["14712326","20521839"],"issn_org":["20521839"],"issue":"1","journal":"BMC Hematology","pages":"4","publisher":"BioMed Central Ltd.","publisher_org":"BioMed Central Ltd","status":"p","title":"BMC Hematology","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-84919345207"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-35e2a88e-2dfa-4eb6-b5df-33b8b8711aa2"],"src":["AU Aarhus University"],"title":"Common variable immunodeficiency unmasked by treatment of immune thrombocytopenic purpura with Rituximab","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-160124","year":"2013","yearsub":"2013"}
