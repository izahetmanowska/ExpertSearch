t":"Carl Christian","key":"hoffmannpau","last":"Hoffmann","locid":"353a0760-7b7a-4348-9f47-7df140234554","name":"Hoffmann, Carl Christian","orcid":"0000-0002-1268-9162","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Peter Mejlhede","key":"andersenpau","last":"Andersen","locid":"b701e373-3720-491d-8d91-4a3089836b0b","name":"Andersen, Peter Mejlhede","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Annette","key":"baattruppedersenpau","last":"Baattrup-Pedersen","locid":"e4f5886d-70a8-4174-a224-b21d0dfc8689","name":"Baattrup-Pedersen, Annette","orcid":"0000-0002-3118-344X","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jan R.","key":"johansenpau","last":"Johansen","name":"Johansen, Jan R.","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Erik","key":"larsenpau","last":"Larsen","locid":"fc89ca38-79d9-4781-a6b1-8394e722b334","name":"Larsen, Søren Erik","orcid":"0000-0001-8428-2065","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Charlotte","key":"kjærgaardpau","last":"Kjærgaard","locid":"b3be00f6-c690-4933-946a-9ab606926cdd","name":"Kjærgaard, Charlotte","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars","key":"elsgaardpau","last":"Elsgaard","locid":"61694e4f-57ee-44c7-8821-c3d2590ff4e0","name":"Elsgaard, Lars","orcid":"0000-0003-0058-7609","rank":8,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.soilbio.2013.10.011","issn":["00380717","18793428"],"issn_org":["00380717"],"journal":"Soil Biology & Biochemistry","pages":"291-299","publisher":"Elsevier Ltd","status":"p","title":"Soil Biology & Biochemistry","volume":"68"},"review":"Peer Reviewed","scoID":["2-s2.0-84901035153"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-f55ed70d-da5d-4d9e-a87f-6ae42afe7309"],"src":["AU Aarhus University"],"title":"Nitrous oxide fluxes in undisturbed riparian wetlands located in agricultural catchments: Emission, uptake and controlling factors","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-269249","year":"2014","yearsub":"2014"}
{"abstract":"Secondary metabolites in filamentous fungi constitute a rich source of bioactive molecules. We have deduced the genetic and biosynthetic pathway of the antibiotic yanuthone D from Aspergillus niger. Our analyses show that yanuthone D is a meroterpenoid derived from the polyketide 6-methylsalicylic acid (6-MSA). Yanuthone D formation depends on a cluster composed of ten genes including yanA and yanI, which encode a 6-MSA polyketide synthase and a previously undescribed O-mevalon transferase, respectively. In addition, several branching points in the pathway were discovered, revealing five yanuthones (F, G, H, I, and J). Furthermore, we have identified another compound (yanuthone X1) that defines a class of yanuthones that depend on several enzymatic activities encoded by genes in the yan cluster but that are not derived from 6-MSA.","author_count":9,"contributors":["Holm, Dorte Koefoed","Petersen, Lene Maj","Klitgaard, Andreas","Knudsen, Peter Boldsen","Jarczynska, Zofia Dorota","Nielsen, Kristian Fog","Gotfredsen, Charlotte Held","Larsen, Thomas Ostenfeld","Mortensen, Uffe Hasbro"],"cuid":["S01-000.00-307532"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"molecular and chemical characterization of the biosynthesis of the 000000000006 msa derived meroterpenoid yanuthone d in aspergillus niger","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/92014389/14000702.pdf","version":"Published Version"},"id":"S01-000.00-307532","identifier":[{"id":"24684908","type":"pmid"},{"id":"84899660194","type":"scopus"}],"ids":["dtu-09c4c6e6-aad1-4098-a088-abcfc1f08365"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-2A31541B6A3F47E7FB0CE779CB188263"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/92014389/14000702.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.chembiol.2014.01.013","version":"Other Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Systems Biology"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Dorte Koefoed","key":"holmpau","last":"Holm","locid":"aedc7b19-7dd8-4af4-a8cc-5a73f5783c91","name":"Holm, Dorte Koefoed","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lene Maj","key":"petersenpau","last":"Petersen","locid":"7a1c5a02-7eb8-40e3-a1ec-621fb3c37652","name":"Petersen, Lene Maj","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andreas","key":"klitgaardpau","last":"Klitgaard","locid":"8b3059db-d003-40fc-a4d1-4997854cc657","name":"Klitgaard, Andreas","orcid":"0000-0002-2533-570X","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter Boldsen","key":"knudsenpau","last":"Knudsen","locid":"991df7f2-a085-49ce-a926-da127ba3b28b","name":"Knudsen, Peter Boldsen","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Zofia Dorota","key":"jarczynskapau","last":"Jarczynska","locid":"813bfd50-3a65-4867-a113-149ff7951868","name":"Jarczynska, Zofia Dorota","orcid":"0000-0001-6959-3260","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kristian Fog","key":"nielsenpau","last":"Nielsen","locid":"d2067ee9-e48c-4cf4-ac8f-ee775d8aff5a","name":"Nielsen, Kristian Fog","orcid":"0000-0002-5848-0911","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Charlotte Held","key":"gotfredsenpau","last":"Gotfredsen","locid":"1cf4df84-2d0e-4693-bf47-e9932e3bf0e3","name":"Gotfredsen, Charlotte Held","orcid":"0000-0002-7386-119X","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thomas Ostenfeld","key":"larsenpau","last":"Larsen","locid":"bd958d52-71b6-4720-b30a-cc9305633b43","name":"Larsen, Thomas Ostenfeld","orcid":"0000-0002-3362-5707","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Uffe Hasbro","key":"mortensenpau","last":"Mortensen","locid":"dec3038b-f004-4c96-84a1-52825e1c0ce8","name":"Mortensen, Uffe Hasbro","orcid":"0000-0002-7794-7273","rank":9,"rolecode":"pau"}],"pmid":["24684908"],"pub":{"doi":"10.1016/j.chembiol.2014.01.013","issn":["10745521","18791301"],"issn_org":["10745521"],"issue":"4","journal":"Chemistry & Biology","pages":"519-529","publisher":"Elsevier","status":"p","title":"Chemistry & Biology","volume":"21"},"review":"Peer Reviewed","scoID":["2-s2.0-84899660194"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-09c4c6e6-aad1-4098-a088-abcfc1f08365"],"src":["DTU Technical University of Denmark"],"title":"Molecular and Chemical Characterization of the Biosynthesis of the 6-MSA-Derived Meroterpenoid Yanuthone D in Aspergillus niger.","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-307532","year":"2014","yearsub":"2014"}
{"abstract":"Investigation of the chemical profile of the industrially important black filamentous fungus Aspergillus aculeatus by UHPLC-DAD-HRMS and subsequent dereplication has led to the discovery of several novel compounds. Isolation and extensive 1D and 2D NMR spectroscopic analyses allowed for structural elucidation of a dioxomorpholine, a unique okaramine, an aflavinine and three novel structures of mixed biosynthetic origin, which we have named aculenes A-C. Moreover, known analogues of calbistrins, okaramines and secalonic acids were detected. All novel compounds were tested for antifungal activity against Candida albicans, however all showed only weak or no activity. Aspergillus aculeatus IBT 21030 was additionally shown to be capable of producing sclerotia. Examination of the sclerotia revealed a highly regulated production of metabolites in these morphological structures.","author_count":5,"contributors":["Petersen, Lene Maj","Hoeck, Casper","Frisvad, Jens Christian","Gotfredsen, Charlotte Held","Larsen, Thomas Ostenfeld"],"cuid":["S01-000.00-309272"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Acids","Aspergilli","Aspergillus","Aspergillus aculeatus","Chemistry","Dereplication","Enzymes","Natural products","Niger","Sclerotia","Secondary metabolism","Xylanases"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"dereplication guided discovery of secondary metabolites of mixed biosynthetic origin from i aspergillus aculeatus i","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/102121529/molecules_19_10898_v2.pdf","version":"Published Version"},"id":"S01-000.00-309272","identifier":[{"id":"25068785","type":"pmid"},{"i