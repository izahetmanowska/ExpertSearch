","Nordic","OECD"],"name":"Miscellaneous","namevar":["Danish Pig Production"],"nora_code":"DI-OT","used":1},{"affno":"3","country":"se","key":"swedish university of agricultural sciences","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Swedish University of Agricultural Sciences","used":1},{"affno":"4","country":"dk","key":"ssi statens serum institut","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-SSI","l3nn":"SSI Statens Serum Institut","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SSI Statens Serum Institut","namevar":["Statens Serum Institut"],"nora_code":"DI-GV-SSI","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Lars Erik","key":"larsenpau","last":"Larsen","locid":"09c2a33d-b353-44de-a850-f3c7dec879cb","name":"Larsen, Lars Erik","orcid":"0000-0003-0730-5555","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Nicole Bakkegård","key":"goeckepau","last":"Goecke","locid":"4d2ddf87-a082-462e-86c4-567264391d29","name":"Goecke, Nicole Bakkegård","orcid":"0000-0003-4948-9946","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"H.","key":"kongstedpau","last":"Kongsted","name":"Kongsted, H.","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mette","key":"boyepau","last":"Boye","locid":"7623efd8-b123-4433-90fd-a68d079888ff","name":"Boye, Mette","orcid":"0000-0003-3562-2312","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Charlotte Kristiane","key":"hjulsagerpau","last":"Hjulsager","locid":"6c1511ef-8211-4653-8c81-cd55b7f63f64","name":"Hjulsager, Charlotte Kristiane","orcid":"0000-0001-7557-8876","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"F.","key":"granbergpau","last":"Granberg","name":"Granberg, F.","rank":6,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"T.","key":"kølsenfischerpau","last":"Kølsen Fischer","name":"Kølsen Fischer, T.","rank":7,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"S.","key":"midgleypau","last":"Midgley","name":"Midgley, S.","rank":8,"rolecode":"pau"}],"pub":{"pages":"181-181","place":"Nantes, France","status":"p","title":"Proceedings of the 7th european symposium of porcine health management"},"review":"Peer Reviewed","sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Miscellaneous","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Governmental Institutions","Miscellaneous","Other Research","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-4f59b043-aede-49f0-8c36-1c551dd06aad"],"src":["DTU Technical University of Denmark"],"title":"New neonatal porcine diarrhoea syndrome in Danish pigs. Characterisation of viral findings in diseased and healthy control animals","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-328176","year":"2015","yearsub":"2015"}
{"abstract":"In early March 2014, unusual high numbers of wild bird Thick-billed Murre (Uria lomvia), order Charadriiformes, were found dead at the coast of South Greenland. To investigate the cause of death, 45 birds were submitted for diagnosis at the National Veterinary Institute, Technical University of Denmark. Five birds were randomly selected for diagnostic investigation and samples were taken from the cadavers (pooled oropharyngeal swabs, cloacal swabs, lung/trachea/heart tissues and liver/spleen/kidney tissues, and separate preparation of stomach from a single bird). Avian influenza virus (AIV) with subtype H11N2 was detected in all pools by RT-PCR. Virus was isolated from embryonated chicken-eggs by allantoic inoculation from all pools except the liver/spleen/kidney pool. Full-genome sequencing of AIV isolate revealed American lineage origin of genes. The remaining 40 birds were subsequently screened for AIV in oropharyngeal and cloacal swab specimens from each bird by RT-PCR. American lineage H11N2 AIV was detected in both oropharyngeal and cloacal swabs from one bird, and American lineage low pathogenic AIV with subtype H5N1 was detected in the cloacal swab from another bird. The sparse and mixed subtype occurrence of AIV together with an emaciated appearance of the birds, suggests that the Murre die-off may not have been caused by infection with AIV, but that the birds could have died from starvation. However, here we present the first characterization of AIVs from Greenland and our results supports the idea that wild birds in Greenland could be involved in the movement of AIV between North America and Europe.","author_count":5,"contributors":["Hjulsager, Charlotte Kristiane","Hartby, Christina Marie","Krog, Jesper Schak","Holm, Elisabeth","Larsen, Lars Erik"],"cuid":["S01-000.00-339493"],"event":{"end":"2015-04-15","place":"Athens, us","start":"2015-04-12","title":"9<sup>th</sup> International Symposium on Avian Influenza","year":"2015"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"detection of american lineage low pathogenic avian influenza viruses in uria lomvia in greenland","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/112139129/AI_lomvier_til_ORBIT.pdf","version":"Published Version"},"id":"S01-000.00-339493","ids":["dtu-74efecb5-7219-4487-9f43-3c356960acd6"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-EDEF674C479F4D0D91C3DD9633D36EB0"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/112139129/AI_lomvier_til_ORBIT.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Veterinary Institute"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Charlotte Kristiane","key":"hjulsagerpau","last":"Hjulsager","locid":"6c1511ef-8211-4653-8c81-cd55b7f63f64","name":"Hjulsager, Charlotte Kristiane","orcid":"0000-0001-7557-8876","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Christina Marie","key":"hartbypau","last":"Hartby","locid":"91d05451-70ef-459e-8781-4fa025583e88","name":"Hartby, Christina Marie","orcid":"0000-0003-2852-970X","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Schak","key":"krogpau","last":"Krog","locid":"1e238a71-3075-4303-91fe-3cedb620123d","name":"Krog, Jesper Schak","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Elisabeth","key":"holmpau","last":"Holm","locid":"07c945b3-4fe0-496a-9734-095800683729","name":"Holm, Elisabeth","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars Erik","key":"larsenpau","last":"Larsen","locid":"09c2a33d-b353-44de-a850-f3c7dec879cb","name":"Larsen, Lars Erik","orcid":"0000-0003-0730-5555","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-74efecb5-7219-4487-9f43-3c356960acd6"],"src":["DTU Technical University of Denmark"],"title":"Detection of American lineage low pathogenic avian influenza viruses in Uria lomvia in Greenland","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-339493","year":"2015","yearsub":"2015"}
{"abstract":"Endobronchial ultrasound-guided transbronchial needle aspiration (EBUS-TBNA) is very operator dependent and has a long learning curve. Simulation-based training might shorten the learning curve, and an assessment tool with solid validity evidence could ensure basic competency before unsupervised performance.A total of 16 respiratory physicians, without EBUS experience, were randomised to either virtual-reality simulator training or traditional apprenticeship training on patients, and then each physician performed EBUS-TBNA procedures on three patients. Three blinded, independent assessor assessed the video recordings of the procedures using a newly developed EBUS assessment tool (EBUSAT).The internal consistency was high (Cronbach's α=0.95); the generalisability coefficient was good (0.86), and the tool had discriminatory ability (p<0.001). Procedures performed by simulator-trained novices were rated higher than procedures performed by apprenticeship-trained novices: mean±sd are 24.2±7.9 points and 20.2±9.4 points, respectively; p=0.006. A pass/fail standard of 28.9 points was established using the contrasting groups method, resulting in 16 (67%) and 20 (83%) procedures performed by simulator-trained novices and apprenticeship-trained novices failing the test, respectively; p<0.001.The endobronchial ultrasound assessment tool could be used to provide reliable and valid assessment of competence in EBUS-TBNA, and act as an aid in certification. Virtual-reality simulator training was shown to be more effective than traditional apprenticeship training.","author_count":6,"contributors":["Konge, Lars","Clementsen, Paul Frost","Ringsted, Charlotte","Minddal, Valentina","Larsen, Klaus Richter","Annema, Jouke T"],"cuid":["S01-000.00-523576"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"simulator training for endobronchial ultrasound a randomised controlled trial","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-523576","identifier":[{"id":"84943230167","type":"scopus"},{"id":"26160875","type":"pmid"}],"ids":["ku-d9de79c4-1a64-4a4b-8b26-0bfe49d6161b"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-CC213C619EB1E68C11019EE18B458BE2"],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Lars","key":"kongepau","last":"Konge","locid":"e1c287e3-4cd2-43d2-887d-f2f77fd5daf8","name":"Konge, Lars","orcid":"0000-0002-1258-5822","rank":1,"rolecode":"pau"},{"affno":"","first":"Paul Frost","key":"clementsenpau","last":"Clementsen","name":"Clementsen, Paul Frost","rank":2,"rolecode":"pau"},{"affno":"","first":"Charlotte","key":"ringstedpau","last":"Ringsted","name":"Ringsted, Charlotte","rank":3,"rolecode":"pau"},{"affno":"","first":"Valentina","key":"minddalpau","last":"Minddal","name":"Minddal, Valentina","rank":4,"rolecode":"pau"},{"affno":"1","first":"Klaus Richter","key":"larsenpau","last":"Larsen","locid":"43fd2d53-9005-42a7-a130-ffa48b2b8d7b","name":"Larsen, Klaus Richter","rank":5,"rolecode":"pau"},{"affno":"","first":"Jouke T","key":"annemapau","last":"Annema","name":"Annema, Jouke T","rank":6,"rolecode":"pau"}],"pmid":["26160875"],"pub":{"doi":"10.1183/13993003.02352-2015","issn":["09031936","13993003"],"issn_org":["09031936"],"journal":"European Respiratory Journal","pages":"1140-49","status":"p","title":"European Respiratory Journal","volume":"46"},"review":"Peer Reviewed","scoID":["2-s2.0-84943230167"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-d9de79c4-1a64-4a4b-8b26-0bfe49d6161b"],"src":["KU University of Copenhagen"],"title":"Simulator training for endobronchial ultrasound : a randomised controlled trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-523576","year":"2015","yearsub":"2015"}
{"abstract":"The New Nordic Diet (NND) has induced weight loss in a 26-week controlled intervention. We aim to investigate whether high compliance and satisfaction can be maintained after the active intervention is discontinued thereby maintaining the health effects.","author_count":4,"contributors":["Poulsen, Sanne Kellebjerg","Crone, Charlotte","Astrup, Arne","Larsen, Thomas Meinert"],"cuid":["S01-000.00-525858"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"long term adherence to the new nordic diet and the effects on body weight anthropometry and blood pressure a 000000000012 month follow up study","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-525858","identifier":[{"id":"84896425042","type":"scopus"},{"id":"24664189","type":"pmid"}],"ids":["ku-ddba7857-73aa-4268-90f8-453abcc8ecb0"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-FDEC9D58269CC607333B44AD73C8E8DE"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Nutrition, Exercise and Sports, Obesity Research"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Sanne Kellebjerg","key":"poulsenpau","last":"Poulsen","locid":"789e64f3-7deb-45c2-8f4b-5b8695aee785","name":"Poulsen, Sanne Kellebjerg","orcid":"0000-0003-4897-3955","rank":1,"rolecode":"pau"},{"affno":"1","first":"Charlotte","key":"cronepau","last":"Crone","name":"Crone, Charlotte","rank":2,"rolecode":"pau"},{"affno":"1","first":"Arne","key":"astruppau","last":"Astrup","locid":"5d943631-c9fc-4b63-8aaa-263ba4248735","name":"Astrup, Arne","orcid":"0000-0001-8968-8996","rank":3,"rolecode":"pau"},{"affno":"1","first":"Thomas Meinert","key":"larsenpau","last":"Larsen","locid":"be620f10-2a0e-430c-94d1-5246c8ef122a","name":"Larsen, Thomas Meinert","orcid":"0000-0001-7621-3131","rank":4,"rolecode":"pau"}],"pmid":["24664189"],"pub":{"doi":"10.1007/s00394-014-0686-z","issn":["14366207","14366215"],"issn_org":["14366207"],"issue":"1","journal":"European Journal of Nutrition","pages":"67-76","status":"p","title":"European Journal of Nutrition","volume":"54"},"review":"Peer Reviewed","scoID":["2-s2.0-84896425042"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-ddba7857-73aa-4268-90f8-453abcc8ecb0"],"src":["KU University of Copenhagen"],"title":"Long-term adherence to the New Nordic Diet and the effects on body weight, anthropometry and blood pressure : a 12-month follow-up study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-525858","year":"2015","yearsub":"2015"}
{"abstract":"Introduction This research examine how employees in kindergarten, which are members of The National Association of Frie børnehaver og fritidshjem (FRIE), relate to paragraph 1 in the association regulations: “…activities in the national association has a social economic base and are supporting the social economic perspective in the related institutions, among members and partners.” FRIE is the largest umbrella organization of self-governed and private childcare-institutions in Denmark – 450 independent institutions are members. The association was founded in 1949 advocating a self-governed childcare model independent from municipalities and working to influence policies concerning childcare and education. According to the association-regulation FRIE provides administrative services to the institutions. Depending on the type of membership FRIE also support in educating employees, engaging greater parent involvement, independence from municipalities. Thus the organization may contribute to more democratic alternatives than 100% state-financed municipal institutions in the provision and governance of social services. Based on these statements FRIE may potentially contribute to meet the demographical, political and economic challenges in the 21st century welfare state in new ways (Pestoff). Research question: The study examines connections between the written statues in the regulations and the daily practice and articulation by employees in kindergartens and has a focus on user and staff participation and involvement of the local community. Empirical materials from a recent study of childcare in Denmark will be used to examine the research question. Methods and approach The research is based on a social constructionist perspective according to the textually oriented discourse analytic focus on how employees in three different kindergartens articulate and thereby construct understandings of their daily practice (Fairclough). The informants where selected by FRIE, based on the criteria that the kindergartens are pioneers in terms of promoting elements of social enterprise and social innovation in a daily basis. The interviews where all conducted in groups of minimum two members of staff in the kindergartens. The key concepts for developing the interview-guide and examining the research question are based upon literature on social enterprise (EMES) and social economy (Hulgård). The questions in the interview-guide are inspired primarily by research in democratic governance and social enterprises (Pestoff).   Significant findings Results from the study show that the informants’ descriptions of their daily practice do not define the kindergartens explicitly as social economic or as being part of a social economic field. Whereas the results show elements of social economy in varying forms and intensity according to a definition made by EMES: They work to promote a social purpose, they work directly with the users and are organizational independent, and the leader(-group) is visionary and idealistic. Furthermore the empirical material show presence of coproduction processes and participatory democracy (Pestoff) in strategically selected areas in the daily procedures such as user involvement and participation. Perspectives These findings suggest low incidence of meta-reflection related to social economy, social enterprise and social innovation, whereas the empirical material also shows awareness and articulation of skills and competences, theoretical methods and educational ideals. Conditions of possibility shown in the empirical data invites to a next step where researchers and staff cooperate (Moulaert) to exploit the potentials for change in both discursive and the social practice in the institutions (Fairclough). Change that might lead to processes of social innovation, explicate democratic participation and elements of social economy in the social practice of the institutions. The research is limited by the number of interviews conducted. Further data collection is required to determine if there is a pattern in daycare institutions organized in FRIE concerning social economics, social innovation, democratic participation and co-production. Keywords in the study are social enterprise, democratic participation, welfare-state-challenges.","author_count":2,"contributors":["Løvstad, Charlotte Vange","Nørgaard, Astrid Kidde Larsen"],"cuid":["S01-000.00-656686"],"event":{"end":"2015-07-03","place":"Helsinki, fi","start":"2015-06-30","title":"5th EMES International Research Conference on Social Enterprise, Helsinki 2015","year":"2015"},"filters":{"added":"2023-08","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Børnehaver","Co production","Demokrati","Innovation","Lokalsamfund","Samskabelse","Social enterprise","social work and social conditions"],"level":"sci","oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-UC"],"level3":{"UC":["DI-UC-ALL","DI-UC-VIA"]},"level3all":["DI-UC-VIA"]},"review":"nr","rtype":["clu"],"sorti":"social enterprise and social innovation in danish kindergartens","src":["via"],"src-code":["DI-UC-VIA"],"type":"dco","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://programme.exordo.com/5emesconf/delegates/presentation/111/","version":"Published Version"},"id":"S01-000.00-656686","ids":["via-3fcd6ebe-7d26-4619-bcfe-f4f7313348eb"],"keyword":["børnehaver","co-production","demokrati","innovation","lokalsamfund","samskabelse","social enterprise","social work and social conditions"],"lang":"English","level":"Scientific","noi":["Local-1-1-14169F283CA93DC6847385DCCE11DCF5"],"oa_link":[{"access":"oa","type":"rem","url":"http://programme.exordo.com/5emesconf/delegates/presentation/111/","version":"Published Version"}],"org":[{"affno":"1","key":"via university college","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-VIA","l3nl":"VIA University College","l3nn":"VIA University Col