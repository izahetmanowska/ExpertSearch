Christian","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Valgreen","key":"knudsenpau","last":"Knudsen","locid":"d59094b5-44a6-4398-9acf-f3f530e0504b","name":"Knudsen, Søren Valgreen","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Simon","key":"grøntvedpau","last":"Grøntved","locid":"500e11c2-1129-4fc3-b9e4-5a6e5c7e70cb","name":"Grøntved, Simon","orcid":"0000-0003-2172-705X","rank":3,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Agnete Lund","key":"sørensenpau","last":"Sørensen","locid":"b0a42617-1bb0-4796-9b1d-bb09cb3eabfa","name":"Sørensen, Agnete Lund","rank":4,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Karen Lyng","key":"larsenpau","last":"Larsen","locid":"37ed3052-8a63-4a90-8996-5c62f82920e3","name":"Lyng Larsen, Karen","name_org":"Larsen, Karen Lyng","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Charlotte Kaae","key":"schmidtpau","last":"Schmidt","name":"Schmidt, Charlotte Kaae","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Tilde","key":"jensenpau","last":"Jensen","name":"Jensen, Tilde","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jens Ravnholt","key":"pedersenpau","last":"Pedersen","name":"Pedersen, Jens Ravnholt","rank":8,"rolecode":"pau"},{"affno":"1 3 4 2","corresponding":null,"country":"dk","first":"Jan","key":"mainzpau","last":"Mainz","locid":"fadbea42-81be-48a2-afb2-c868f9dfa4f5","name":"Mainz, Jan","orcid":"0000-0003-0242-9233","rank":9,"rolecode":"pau"}],"pmid":["38870099"],"pub":{"doi":"10.1093/intqhc/mzae049","issn":["13534505","14643677"],"issn_org":["13534505"],"issue":"2","journal":"International Journal for Quality in Health Care","paperid":"mzae049","publisher":"Oxford University Press","status":"p","title":"International Journal for Quality in Health Care","volume":"36"},"review":"Peer Reviewed","scoID":["2-s2.0-85196137925"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-c28b8416-8d7b-4988-aac7-06d5e4ba120f","sdu-73890829-a7ca-4683-856a-2b8ecb921974"],"src":["AAU Aalborg University","SDU University of Southern Denmark"],"title":"Adverse events reporting during the COVID-19 pandemic in a Danish region: a retrospective analysis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-767000","year":"2024","yearsub":"2024"}
{"abstract":"BACKGROUND: Health and education are interrelated and influence social, economic and lifestyle perspectives. Children with chronic illnesses experience barriers in the educational system regarding school attendance and social isolation. Gaining knowledge of compulsory education and how children with chronic illnesses are supported is crucial for the implications of future education policy and legislation in Scandinavia. This study compares Scandinavian legislation frameworks on compulsory education, chronic illness and school absence to form the basis of future research on education for children with chronic illness. METHODS: The study uses a comparative approach to explore the support of children with chronic illnesses in compulsory education across Norway, Sweden and Denmark. The documents included are 3 education acts and 15 secondary documents, which are notes and guidelines for the education acts. The data were analysed using a manifest content analysis. FINDINGS: We found four categories and six subcategories: (1) school obligation and rights; (2) chronic illness; (3) school absence: (a) categorisation of absence; (b) registration of absence; and (c) sanction; and (4) education support: (a) Hospital school support; (b) Home instruction support; and (c) technological support. CONCLUSION: This study's findings demonstrate the similarities and differences in the Scandinavian compulsory education legislation and guidelines regarding chronic illness and school absence. We found similarities across the countries regarding chronic illness and school absence. Still, the findings showed differences in the systematic registration of school absence and requirements for attendance with compulsory education in Norway and Denmark compared with compulsory schooling in Sweden. This knowledge will inform and enlighten future discussions and decisions in education and public health. The results can contribute to awareness of the opportunities for educational support and perspectives about education for children with chronic illnesses. Future research focusing on the experience of children with chronic illness and educational support is needed.","author_count":4,"contributors":["Skoubo, Sofie","Handberg, Charlotte","Weibel, Mette","Larsen, Hanne Bækgaard"],"cuid":["S02-100.00-793439"],"filters":{"added":"2024-10","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"corresponding_author":["Skoubo, Sofie"],"keyword":["Children","Chronic illness","Comparative Study","Compulsory education","Document analysis","Scandinavian","School absence","Technology solutions","education legislation","educational support"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-OTH"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-HO-OTH","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"school absence legislation governing in norway sweden and denmark for children with chronic illness in compulsory education a comparative study","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1111/scs.13295","version":"Published Version"},"id":"S02-100.00-793439","identifier":[{"id":"85202152570","type":"scopus"},{"id":"39192539","type":"pmid"}],"ids":["au-cef95c31-c9c0-4e63-bec0-cabed5cf1c77","ku-ff6dd639-aedc-4c75-8ed2-ac2a4441ce86"],"keyword":["Scandinavian","children","chronic illness","comparative study","compulsory education","document analysis","education legislation","educational support","school absence","technology solutions"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-4ECF396366C4CA6B9FB3E7CC15E6AF90"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/424154049/Scandinavian_Caring_Sciences_2024_Skoubo_School_absence_legislation_governing_in_Norway_Sweden_and_Denmark_for.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1111/scs.13295","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Public Health"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"other hospitals","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-OTH","l3nl":"Other Hospitals","l3nn":"Other Hospitals","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Hospitals","namevar":["Danish Rehabilitation Centre for Neuromuscular Diseases"],"nora_code":"DI-HO-OTH","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"4","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, No speciality","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Paediatrics"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"Sofie","key":"skoubopau","last":"Skoubo","locid":"fde9853d-d0f4-42ab-bcbe-e0d99f5b5af3","name":"Skoubo, Sofie","orcid":"0000-0002-3086-2897","rank":1,"rolecode":"pau"},{"affno":"2 1","corresponding":null,"country":"dk","first":"Charlotte","key":"handbergpau","last":"Handberg","locid":"282bd838-2f69-4679-9331-15174eec2360","name":"Handberg, Charlotte","orcid":"0000-0002-1378-2449","rank":2,"rolecode":"pau"},{"affno":"3","first":"Mette","key":"weibelpau","last":"Weibel","name":"Weibel, Mette","rank":3,"rolecode":"pau"},{"affno":"3 4","first":"Hanne Bækgaard","key":"larsenpau","last":"Larsen","locid":"88b48e37-454f-41e8-a110-a385dce66a6e","name":"Larsen, Hanne Bækgaard","rank":4,"rolecode":"pau"}],"pmid":["39192539"],"pub":{"doi":"10.1111/scs.13295","issn":["02839318","14716712"],"issn_org":["02839318"],"issue":"4","journal":"Scandinavian Journal of Caring Sciences","pages":"936-947","publisher":"Wiley-Blackwell Publishing Ltd","status":"p","title":"Scandinavian Journal of Caring Sciences","volume":"38"},"review":"Peer Reviewed","scoID":["2-s2.0-85202152570"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Other Hospitals","Universities","University of Copenhagen","danish rehabilitation centre for neuromuscular diseases","the danish rehabilitation centre for neuromuscular diseases"],"PST":["Published"]},"sid":["au-cef95c31-c9c0-4e63-bec0-cabed5cf1c77","ku-ff6dd639-aedc-4c75-8ed2-ac2a4441ce86"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"School absence legislation governing in Norway, Sweden and Denmark for children with chronic illness in compulsory education : A comparative study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-793439","year":"2024","yearsub":"2024"}
{"abstract":"Purpose: Immune-related thyroid adverse events (irTAEs) occur frequently following immune checkpoint inhibitor (ICI) therapy. The purpose of this study is to provide knowledge about the incidence, clinical timeline characteristics, associated factors of irTAEs, and potential impact on treatment efficacy in patients with melanoma receiving adjuvant ICI therapy. Methods: A national multicenter retrospective cohort study of patients with resected stage III/IV melanoma treated with adjuvant PD-1 inhibitors between November 2018 and December 2020. Data were extracted from the Danish Metastatic Melanoma Database. The irTAEs were defined as two consecutive abnormal TSH values and subdivided into transient or persistent. Results: Of 454 patients, 99 developed an irTAE (21.8%), of these were 46 transient (46.5%) and 53 persistent (53.5%). Median time to transient and persistent irTAE was 55 and 44 days, respectively (p = 0.57). A hyperthyroid phase followed by hypothyroidism was seen in 73.6% of persistent irTAEs, whereas 87% of transient irTAEs developed an isolated hypo- or hyperthyroid phase. Multiple variable analysis demonstrated an association between irTAE and female sex (HR 2.45; 95% CI 1.63–3.70; p < 0.001), but no association with recurrence-free survival (HR 0.86; 95% CI 0.50–1.48; p = 0.587) or overall survival (HR 1.05; 95% CI 0.52–2.12, p = 0.891). Conclusions: IrTAE is a common side effect to PD-1 inhibitors primarily occurring within the first 3 months, with a high risk of persistency. Female sex is a strong predictive factor. IrTAE was not associated with improved clinical outcome.","author_count":18,"contributors":["Christensen, Stine K.","Winther, Mette L.","Laursen, Ida J.","Madsen, Freja S.","Brink, Carsten","Brix, Thomas H.","Ellebaek, Eva","Svane, Inge Marie","Hansen, Frederikke S.","Haslund, Charlotte Aaquist","Laursen, Olivia Kaas","Schmidt, Henrik","Larsen, Ida D.","Bastholt, Lars","Ruhlmann, Christina H."],"cuid":["S03-100.00-735067"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"corresponding_author":["Ruhlmann, Christina H."],"keyword":["Adjuvant","Adjuvants Immunologic","Adjuvants Pharmaceutic","Cohort Studies","Female","Humans","Hyperthyroidism","Immune Checkpoint Inhibitors adverse effects","Immune checkpoint inhibitors","Immune related adverse events","Immune related thyroiditis","Melanoma","Melanoma drug therapy","PD 1 inhibitor","Retrospective Studies","Skin Neoplasms drug therapy"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-U-AAU","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"frequency and characteristics of immune related thyroid adverse events in patients with resected stage iii iv melanoma treated with adjuvant pd 000000000001 inhibitors a national cohort study","src":["aau","au","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s00520-024-08445-y","version":"Published Version"},"id":"S03-100.00-735067","identifier":[{"id":"PMC11006760","type":"pmcid"},{"id":"38598052","type":"pmid"},{"id":"85189982233","type":"scopus"}],"ids":["aau-f477c554-297d-4521-8ad7-776c88ae4eab","au-4cda323f-769b-494d-a99e-c2ac7074e9c2","sdu-8ebc8933-86f4-423e-8121-59fb9085b7c0"],"keyword":["Adjuvant","Adjuvants, Immunologic","Adjuvants, Pharmaceutic","Cohort Studies","Female","Humans","Hyperthyroidism","Immune Checkpoint Inhibitors/adverse effects","Immune checkpoint inhibitors","Immune-related adverse events","Immune-related thyroiditis","Melanoma","Melanoma/drug therapy","PD-1 inhibitor","Retrospective Studies","Skin Neoplasms/drug therapy"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-C6C38E5776B8F23C60E84DBB7E92E6FA"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s00520-024-08445-y","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/259575802/s00520-024-08445-y.pdf","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/709792783/Christensen_et_al._2024_._Frequency_and_characteristics_of_immune-related_thyroid_adverse_events_in_patients_with_resected_stage_III-IV_melanoma_treated_with_adjuvant_PD-1_inhibitors_-_a_national_cohort_study.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["University of Southern Denmark"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"north denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-NDR","l3nl":"North Denmark Region","l3nn":"North Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"North Denmark Region","namevar":["Region Nordjylland"],"nora_code":"DI-HO-NDR","used":1},{"affno":"3","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Region Syddanmark"],"nora_code":"DI-HO-SDR","used":1},{"affno":"4","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe