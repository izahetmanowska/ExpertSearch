":"Ottosen, Christian","rank":5,"rolecode":"pau"},{"affno":"1 2","country":"dk","first":"Charlotte","key":"ringstedpau","last":"Ringsted","locid":"aad0b8e6-2821-409d-9ed2-33b6ffded4d2","name":"Ringsted, Charlotte","rank":6,"rolecode":"pau"},{"affno":"3","first":"Teodor","key":"grantcharovpau","last":"Grantcharov","name":"Grantcharov, Teodor","rank":7,"rolecode":"pau"},{"affno":"1","first":"Bent","key":"ottesenpau","last":"Ottesen","locid":"5cc91f75-7bf4-4789-a5de-71cbf232e8d5","name":"Ottesen, Bent","rank":8,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Jette Led","key":"sørensenpau","last":"Sørensen","locid":"84ce4092-8277-45c1-89d5-afedea9c65f0","name":"Sørensen, Jette Led","orcid":"0000-0002-7320-2784","rank":9,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jette Led","key":"sorensenpau","last":"Sorensen","name":"Sorensen, Jette Led","rank":9,"rolecode":"pau"}],"pmid":["23242486"],"pub":{"doi":"10.1007/s00464-012-2615-7","issn":["09302794","14322218"],"issn_org":["09302794"],"issue":"4","journal":"Surgical Endoscopy","pages":"1353-1359","publisher":"Springer","status":"p","title":"Surgical Endoscopy","volume":"27"},"review":"Peer Reviewed","scoID":["2-s2.0-84876291602"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-3212003e-cd07-433b-aa67-f56b4a12efa6","ku-3590bad4-22cd-46ce-8553-e7417013cc58"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Development and validation of a theoretical test in basic laparoscopy","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-093.80-016263","year":2013,"yearsub":2013}
{"abstract":"Quantitative polymerase chain reaction (qPCR) tests for detection and quantification of Lawsonia intracellularis in feces from pigs have been developed. The objective of the current study was to evaluate the diagnostic performance of a fecal qPCR test for detection of nursery pigs with L. intracellularis–associated proliferative enteropathy (PE) under field conditions. Furthermore, the diagnostic performance for different subpopulations of pigs was investigated, including pigs infected or noninfected with Porcine circovirus-2, Brachyspira pilosicoli, and Escherichia coli. The diagnostic performance was evaluated in terms of diagnostic sensitivity and specificity. Data from pigs originating from 20 herds with antibiotic treatment requiring diarrhea outbreaks from a prior study were reused. Before treatment, pigs were randomly selected for histopathological and immunohistochemical examination of intestinal segments and fecal quantification of L. intracellularis by qPCR. A total of 313 pigs (157 without diarrhea, 156 with diarrhea) were included in the statistical analysis, and 37 pigs (11.8%) were classified as PE positives (defined as proliferative histological lesions in combination with L. intracellularis demonstration by immunohistochemistry). Lawsonia intracellularis was detected by qPCR in feces from 91 pigs (29.1%). A nonparametric receiver operating characteristic (ROC) analysis provided an area under the ROC curve (0.93) and an optimal cutoff value of 4.8 log10 L. intracellularis bacteria/g feces. This cutoff provided a diagnostic sensitivity of 0.84 and diagnostic specificity of 0.93. The diagnostic sensitivity and specificity were significantly different between herds (P < 0.0001). Numerically, diagnostic sensitivity and specificity were different between subpopulations of pigs, but no significant differences were demonstrated.","author_count":9,"contributors":["Pedersen, Ken Steen","Stege, Helle","Jensen, Tim Kåre","Guedes, Roberto","Ståhl, Marie","Nielsen, Jens Peter","Hjulsager, Charlotte Kristiane","Larsen, Lars Erik","Angen, Øystein"],"cuid":["S02-100.00-033048"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["America, South"],"country":["Brazil"],"glorg":["All Global Affiliations","Universidade Federal de Minas Gerais"],"keyword":["Feces","Lawsonia intracellularis","Pigs","Quantitative polymerase chain reaction","Sensitivity","Specificity"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"diagnostic performance of fecal quantitative real time polymerase chain reaction for detection of em lawsonia intracellularis em associated proliferative enteropathy in nursery pigs","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1177/1040638713480499","version":"Other Version"},"id":"S02-100.00-033048","identifier":[{"id":"84878039041","type":"scopus"},{"id":"23536614","type":"pmid"}],"ids":["dtu-15338a35-86bd-49e6-aead-df8e19d80c94","ku-9b39b981-34b2-4a98-a320-5c4a55c84b30"],"keyword":["Feces","Lawsonia intracellularis","Pigs","Quantitative polymerase chain reaction","Sensitivity","Specificity"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-1B29F117A48372CACFEFA948F5AB7116"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1177/1040638713480499","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary and Animal Sciences, Section for Production and Health"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Veterinary Institute","Technical University of Denmark, National Veterinary Institute, Section for Bacteriology, Pathology and Parasitology"],"nora_code":"DI-U-DTU","used":1},{"affno":"3","country":"br","key":"universidade federal de minas gerais","loc":["Brazil","America, South"],"name":"Universidade Federal de Minas Gerais","used":1}],"person":[{"affno":"1","first":"Ken Steen","key":"pedersenpau","last":"Pedersen","locid":"e7e2a10f-e368-4635-9481-f23e58c80aa8","name":"Pedersen, Ken Steen","rank":1,"rolecode":"pau"},{"affno":"1","first":"Helle","key":"stegepau","last":"Stege","locid":"fcd35d18-c0ae-4328-95f3-f912e648c498","name":"Stege, Helle","orcid":"0000-0003-3033-4207","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Tim Kåre","key":"jensenpau","last":"Jensen","locid":"2b93571f-6d81-4827-b040-467f1dee1c12","name":"Jensen, Tim Kåre","orcid":"0000-0002-8048-4695","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Roberto","key":"guedespau","last":"Guedes","name":"Guedes, Roberto","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Marie","key":"ståhlpau","last":"Ståhl","locid":"08fe2834-3786-49f0-971b-b33bd7098652","name":"Ståhl, Marie","rank":5,"rolecode":"pau"},{"affno":"1","first":"Jens Peter","key":"nielsenpau","last":"Nielsen","locid":"e550301c-f89e-4a8b-bf34-e6fc3b76ff37","name":"Niels