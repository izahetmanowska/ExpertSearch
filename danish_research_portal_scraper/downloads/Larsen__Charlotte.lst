8","rank":3,"rolecode":"pau"},{"affno":"","first":"Sanne","key":"jensenpau","last":"Jensen","name":"Jensen, Sanne","rank":4,"rolecode":"pau"},{"affno":"","first":"Lisa","key":"hannapau","last":"Hanna","name":"Hanna, Lisa","rank":5,"rolecode":"pau"},{"affno":"","first":"Birgit Furstrand","key":"larsenpau","last":"Larsen","name":"Larsen, Birgit Furstrand","rank":6,"rolecode":"pau"},{"affno":"","first":"Charlotte Weiling","key":"appelpau","last":"Appel","name":"Appel, Charlotte Weiling","rank":7,"rolecode":"pau"}],"pmid":["34642903"],"pub":{"doi":"10.1007/s11136-021-02976-1","issn":["09629343"],"issue":"Supplement 1","journal":"Quality of Life Research","status":"p","title":"Quality of Life Research","volume":"30"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-88b6def6-f49b-4881-b75b-8ab925508aea"],"src":["KU University of Copenhagen"],"title":"Digital patient-reported outcomes and emotional distress","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-475204","year":"2021","yearsub":"2021"}
{"abstract":"This pilot prospective study reports the feasibility, management and cost of the use of a continuous glucose monitoring (CGM) system in critically ill adult horses and foals. We compared the glucose measurements obtained by the CGM device with blood glucose (BG) concentrations. Neonatal foals (0-2 weeks of age) and adult horses (> 1 year old) admitted in the period of March-May 2016 with clinical and laboratory parameters compatible with systemic inflammatory response syndrome (SIRS) were included. Glucose concentration was monitored every 4 hours on blood samples with a point-of-care (POC) glucometer and with a blood gas analyzer. A CGM system was also placed on six adults and four foals but recordings were successfully obtained only in four adults and one foal. Glucose concentrations corresponded fairly well between BG and CGM, however, there appeared to be a lag time for interstitial glucose levels. Fluctuations of glucose in the interstitial fluid did not always follow the same trend as BG. CGM identified peaks and drops that would have been missed with conventional glucose monitoring. The use of CGM system is feasible in ill horses and may provide clinically relevant information on glucose levels, but there are several challenges that need to be resolved for the system to gain more widespread usability.","author_count":8,"contributors":["Vitale, Valentina","Berg, Lise Charlotte","Larsen, Bettina Birch","Hannesdottir, Andrea","Thomsen, Preben Dybdahl","Laursen, Sigrid Hyldahl","Verwilghen, Denis","van Galen, Gaby"],"cuid":["S01-000.00-492920"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["OECD","Oceania"],"country":["Australia"],"glorg":["All Global Affiliations","University of Sydney"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"blood glucose and subcutaneous continuous glucose monitoring in critically ill horses a pilot study","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pone.0247561","version":"Published Version"},"id":"S01-000.00-492920","identifier":[{"id":"85102096421","type":"scopus"},{"id":"PMC7904136","type":"pmcid"},{"id":"33626099","type":"pmid"}],"ids":["ku-a693bc48-da59-4de2-af89-1c38b088ff15"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-A46709A62B10ED1A6A9EC171331323D4"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pone.0247561","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/259042663/journal.pone.0247561.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"au","key":"university of sydney","loc":["Australia","Oceania","OECD"],"name":"University of Sydney","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary Clinical Sciences, Section for Medicine and Surgery"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Valentina","key":"vitalepau","last":"Vitale","name":"Vitale, Valentina","rank":1,"rolecode":"pau"},{"affno":"2","first":"Lise C.","key":"bergpau","last":"Berg","locid":"b976bbb1-008d-469a-aa03-ab6237c2a97e","name":"Berg, Lise Charlotte","name_org":"Berg, Lise C.","orcid":"0000-0002-8752-2885","rank":2,"rolecode":"pau"},{"affno":"2","first":"Bettina Birch","key":"larsenpau","last":"Larsen","locid":"69b95cf6-c0d1-4d45-91a2-71becd80a06b","name":"Larsen, Bettina Birch","rank":3,"rolecode":"pau"},{"affno":"2","first":"Andrea","key":"hannesdottirpau","last":"Hannesdottir","locid":"b6c6297b-5f72-44c5-9662-49d7855768d6","name":"Hannesdottir, Andrea","rank":4,"rolecode":"pau"},{"affno":"2","first":"Preben Dybdahl","key":"thomsenpau","last":"Thomsen","locid":"fe7dd11e-cddb-4026-a5c9-7070a86e816a","name":"Thomsen, Preben Dybdahl","rank":5,"rolecode":"pau"},{"affno":"2","first":"Sigrid Hyldahl","key":"laursenpau","last":"Laursen","locid":"539409db-f0a5-4787-8fdd-f3cd4c527e5f","name":"Laursen, Sigrid Hyldahl","rank":6,"rolecode":"pau"},{"affno":"2","first":"Denis","key":"verwilghenpau","last":"Verwilghen","locid":"02e58cea-8008-4dab-a91e-785cef9c02bb","name":"Verwilghen, Denis","orcid":"0000-0002-4174-6007","rank":7,"rolecode":"pau"},{"affno":"2","first":"Gaby","key":"vangalenpau","last":"van Galen","locid":"a362759a-853d-4aa1-a261-abf75fba36d9","name":"van Galen, Gaby","orcid":"0000-0002-0689-7141","rank":8,"rolecode":"pau"}],"pmid":["33626099"],"pub":{"doi":"10.1371/journal.pone.0247561","issn":["19326203"],"issue":"2 February","journal":"PLOS ONE","paperid":"e0247561","status":"p","title":"PLOS ONE","title_org":"PLoS ONE","volume":"16"},"review":"Peer Reviewed","scoID":["2-s2.0-85102096421"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-a693bc48-da59-4de2-af89-1c38b088ff15"],"src":["KU University of Copenhagen"],"title":"Blood glucose and subcutaneous continuous glucose monitoring in critically ill horses : A pilot study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-492920","year":"2021","yearsub":"2021"}
{"abstract":"The aim of this study was to investigate the effect of two dietary treatments (liquid creep feed (LCF) and dry creep feed (DCF)) offered during the suckling period on feed disappearance, number of eaters, and intestinal enzymatic development at weaning in an on-farm study with 347 piglets. Piglets were allocated to either the DCF or LCF treatment from day 10 to day 24 postpartum for 9 h a day. Red ferric oxide (1%) was added to the diet to categorize piglets into eating categories (good eaters, moderate eaters, or non-eaters) via faecal swabs. At weaning, 40 piglets were sampled for intestinal enzymatic development. The LCF treatment increased the dry matter disappearance from day 10–18 (p < 0.001). The percentage of good eaters, moderate eaters and non-eaters did not differ between treatments (p >0.05). The DCF pigs displayed greater average daily gain (ADG) pre-weaning (p = 0.024), and a greater body weight (BW) at day 61 (p < 0.001). The activity of lactase, maltase and sucrase in the proximal part of the small intestine were greatest (p < 0.001) in the DCF pigs.","author_count":6,"contributors":["Byrgesen, Nanna","Madsen, Johannes Gulmann","Larsen, C.","Kjeldsen, Niels Jørgen","Cilieborg, Malene Skovsted","Williams, Charlotte Amdi"],"cuid":["S01-000.00-523336"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Enzyme activity","Feed intake"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-SEGES"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-PR-SEGES","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the effect of feeding liquid or dry creep feed on growth performance feed disappearance enzyme activity and number of eaters in suckling piglets","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/ani11113144","version":"Published Version"},"id":"S01-000.00-523336","identifier":[{"id":"34827876","type":"pmid"},{"id":"85118322701","type":"scopus"},{"id":"PMC8614247","type":"pmcid"}],"ids":["ku-d974e405-5585-48a8-86db-9084fdd89d21"],"keyword":["Dry creep feed","Eaters and non-eaters","Enzyme activity","Feed intake","Liquid creep feed"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-DE0ED5A6C15AAD7D34A40E15EA5073ED"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/ani11113144","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/284702064/animals_11_03144.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"seges innovation","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-SEGES","l3nn":"SEGES Innovation","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SEGES Innovation","namevar":["Danish Pig Research Centre, SEGES (Biz)"],"nora_code":"DI-PR-SEGES","used":1}],"person":[{"affno":"1","first":"Nanna","key":"byrgesenpau","last":"Byrgesen","name":"Byrgesen, Nanna","rank":1,"rolecode":"pau"},{"affno":"1","first":"Johannes Gulmann","key":"madsenpau","last":"Madsen","locid":"f4b4330e-ca58-4db7-90df-0220335d59f9","name":"Madsen, Johannes Gulmann","orcid":"0000-0001-7528-9521","rank":2,"rolecode":"pau"},{"affno":"1","first":"Christina","key":"larsenpau","last":"Larsen","locid":"694ee612-8562-4e50-9a0e-1918acd31784","name":"Larsen, C.","name_org":"Larsen, Christina","rank":3,"rolecode":"pau"},{"affno":"2","first":"Niels Jørgen","key":"kjeldsenpau","last":"Kjeldsen","name":"Kjeldsen, Niels Jørgen","rank":4,"rolecode":"pau"},{"affno":"1","first":"Malene Skovsted","key":"cilieborgpau","last":"Cilieborg","locid":"0c9ae422-2843-413f-a2d9-84f7246157e0","name":"Cilieborg, Malene Skovsted","rank":5,"rolecode":"pau"},{"affno":"1","first":"Charlotte","key":"amdipau","last":"Amdi","locid":"8057561d-85f5-4717-ba1e-18a709a9f121","name":"Williams, Charlotte Amdi","name_org":"Amdi, Charlotte","rank":6,"rolecode":"pau"}],"pmid":["34827876"],"pub":{"doi":"10.3390/ani11113144","issn":["20762615"],"issue":"11","journal":"Animals","paperid":"3144","status":"p","title":"Animals","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-85118322701"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Private Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-d974e405-5585-48a8-86db-9084fdd89d21"],"src":["KU University of Copenhagen"],"title":"The effect of feeding liquid or dry creep feed on growth performance, feed disappearance, enzyme activity and number of eaters in suckling piglets","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-523336","year":"2021","yearsub":"2021"}
