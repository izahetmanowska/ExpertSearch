,"first":"Elvira","key":"fischerpau","last":"Fischer","name":"Fischer, Elvira","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Michelle Rosgaard","key":"birknowpau","last":"Birknow","name":"Birknow, Michelle Rosgaard","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens Richardt Møllegaard","key":"jepsenpau","last":"Jepsen","name":"Jepsen, Jens Richardt Møllegaard","rank":6,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Charlotte","key":"olesenpau","last":"Olesen","name":"Olesen, Charlotte","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Flemming","key":"skovbypau","last":"Skovby","name":"Skovby, Flemming","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kerstin Jessica","key":"plessenpau","last":"Plessen","name":"Plessen, Kerstin Jessica","rank":9,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Morten","key":"møruppau","last":"Mørup","locid":"7ffdfaca-76bd-44ec-a98f-13fe4f033b71","name":"Mørup, Morten","orcid":"0000-0003-4985-4368","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ollie","key":"hulmepau","last":"Hulme","name":"Hulme, Ollie","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"William Frans Christiaan","key":"baarepau","last":"Baare","name":"Baare, William Frans Christiaan","rank":12,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Michael","key":"didriksenpau","last":"Didriksen","name":"Didriksen, Michael","rank":13,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hartwig Roman","key":"siebnerpau","last":"Siebner","name":"Siebner, Hartwig Roman","rank":14,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thomas","key":"wergepau","last":"Werge","name":"Werge, Thomas","rank":15,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Line","key":"olsenpau","last":"Olsen","name":"Olsen, Line","rank":16,"rolecode":"pau"}],"pmid":["26384214"],"pub":{"doi":"10.1186/s12888-015-0594-7","issn":["13594184","14765578"],"issn_org":["13594184"],"issue":"1","journal":"Molecular Psychiatry","pages":"1-12","paperid":"15:220","publisher":"Springer Nature","status":"p","title":"Molecular Psychiatry","volume":"15"},"review":"Peer Reviewed","scoID":["2-s2.0-84941644545"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Private Research","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Hospitals","Lundbeck Pharma","Private Research","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-5f0f1546-d521-4026-a67f-f257667b1b8a"],"src":["DTU Technical University of Denmark"],"title":"The Danish 22q11 research initiative","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-332880","year":"2015","yearsub":"2015"}
{"abstract":"BACKGROUND: Instructor feedback reduces the number of repetitions and time to reach proficiency during laparoscopic simulator training. The objective of this study was to examine the effect of instructor feedback on long-term skill retention. METHODS: A 6-month follow-up of a randomized trial. Participants were surgical novices (medical students). All participants (n = 99) initially practiced a laparoscopic salpingectomy on the LapSim virtual reality simulator to proficiency. The intervention group could request instructor feedback, whereas the control group could not. After 6 months, the participants (n = 65) practiced on the simulator until they reached proficiency again. The primary outcomes were the total time and the number of repetitions. RESULTS: Initially, the intervention group used significantly fewer repetitions (29 vs 65, p < 0.0005) and less total training time (162 vs 342min, p < 0.0005) than the control group to reach the proficiency level. At follow-up, both the groups used an equal number of repetitions (21 vs 20, p = 0.72) and time (83 vs 73min, p = 0.37) to reach the same proficiency level. CONCLUSIONS: Instructor feedback during proficiency-based laparoscopic simulator training does not affect the long-term retention of skills.","author_count":8,"contributors":["Bjerrum, Flemming","Maagaard, Mathilde","Sørensen, Jette Led","Rifbjerg Larsen, Christian","Ringsted, Charlotte","Winkel, Per","Ottesen, Bent","Strandbygaard, Jeanett"],"cuid":["S01-000.00-396751"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["Canada"],"glorg":["All Global Affiliations","University of Toronto"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"effect of instructor feedback on skills retention after laparoscopic simulator training follow up of a randomized trial","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-396751","identifier":[{"id":"84920714412","type":"scopus"},{"id":"25139606","type":"pmid"}],"ids":["ku-05777cdc-f36f-4b8a-8fc0-7724897c6498"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-310BA50B3B0C23A4A742776A1B817714"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Section of Gynaecology, Obstetrics and Paediatrics"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"ca","key":"university of toronto","loc":["Canada","America, North","OECD"],"name":"University of Toronto","used":1}],"person":[{"affno":"1","first":"Flemming","key":"bjerrumpau","last":"Bjerrum","name":"Bjerrum, Flemming","rank":1,"rolecode":"pau"},{"affno":"1","first":"Mathilde","key":"maagaardpau","last":"Maagaard","name":"Maagaard, Mathilde","rank":2,"rolecode":"pau"},{"affno":"2","first":"Jette Led","key":"sørensenpau","last":"Sørensen","locid":"84ce4092-8277-45c1-89d5-afedea9c65f0","name":"Sørensen, Jette Led","orcid":"0000-0002-7320-2784","rank":3,"rolecode":"pau"},{"affno":"1","first":"Christian","key":"rifbjerglarsenpau","last":"Rifbjerg Larsen","name":"Rifbjerg Larsen, Christian","rank":4,"rolecode":"pau"},{"affno":"3","first":"Charlotte","key":"ringstedpau","last":"Ringsted","name":"Ringsted, Charlotte","rank":5,"rolecode":"pau"},{"affno":"2","first":"Per","key":"winkelpau","last":"Winkel","name":"Winkel, Per","rank":6,"rolecode":"pau"},{"affno":"1 2","first":"Bent","key":"ottesenpau","last":"Ottesen","locid":"5cc91f75-7bf4-4789-a5de-71cbf232e8d5","name":"Ottesen, Bent","rank":7,"rolecode":"pau"},{"affno":"1","first":"Jeanett","key":"strandbygaardpau","last":"Strandbygaard","name":"Strandbygaard, Jeanett","rank":8,"rolecode":"pau"}],"pmid":["25139606"],"pub":{"doi":"10.1016/j.jsurg.2014.06.013","issn":["19317204"],"issue":"1","journal":"Journal of Surgical Education","pages":"53-60","status":"p","title":"Journal of Surgical Education","volume":"72"},"review":"Peer Reviewed","scoID":["2-s2.0-84920714412"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-05777cdc-f36f-4b8a-8fc0-7724897c6498"],"src":["KU University of Copenhagen"],"title":"Effect of Instructor Feedback on Skills Retention After Laparoscopic Simulator Training : Follow-Up of a Randomized Trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-396751","year":"2015","yearsub":"2015"}
{"abstract":"BACKGROUND: Neurodevelopmental brain disorders such as schizophrenia, autism and attention deficit hyperactivity disorder are complex disorders with heterogeneous etiologies. Schizophrenia and autism are difficult to treat and often cause major individual suffering largely owing to our limited understanding of the disease biology. Thus our understanding of the biological pathogenesis needs to be substantiated to enable development of more targeted treatment options with improved efficacy. Insights into the pre-morbid disease dynamics, the morbid condition and the underlying biological disease mechanisms may come from studies of subjects with homogenous etiologies. Breakthroughs in psychiatric genetics have shown that several genetic anomalies predispose for neurodevelopmental brain disorders. We have established a Danish research initiative to study the common microdeletion at chromosome 22q11.2, which is one of the genetic anomalies that confer high risk of schizophrenia, autism and attention deficit hyperactivity disorder. METHODS/DESIGN: The study applies a \"cause-to-outcome\" strategy to identify pre-morbid pathogenesis and underlying biological disease mechanisms of psychosis and secondarily the morbid condition of autism and attention deficit hyperactivity disorder. We use a population based epidemiological design to inform on disease prevalence, environmental risk factors and familial disposition for mental health disorders and a case control study design to map the functional effects across behavioral and neurophysiological traits of the 22q11 deletion in a recruited sample of Danish individuals. DISCUSSION: Identification of predictive pre-morbid clinical, cognitive, functional and structural brain alterations in 22q11 deletion carriers may alter current clinical practice from symptomatic therapy of manifest mental illness into early intervention strategies, which may also be applicable to at risk subjects without known etiology. Hopefully new insights into the biological disease mechanisms, which are mandatory for novel drug developments, can improve the outcome of the pharmacological interventions in psychiatry.","author_count":16,"contributors":["Schmock, Henriette","Vangkilde, Anders","Larsen, Kit Melissa","Fischer, Elvira","Birknow, Michelle Rosgaard","Jepsen, Jens Richardt Møllegaard","Olesen, Charlotte","Skovby, Flemming","Plessen, Kerstin J","Mørup, Morten","Hulme, Ollie","Baaré, William Frans Christiaan","Didriksen, Michael","Siebner, Hartwig Roman","Werge, Thomas","Olsen, Line"],"cuid":["S01-000.00-470661"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Attention Deficit Disorder with Hyperactivity","Autistic Disorder","Case Control Studies","Child","Child Health Services","Chromosome Aberrations","Chromosomes Human Pair 22","Denmark","Humans","Mental Health Services","Research Design","Schizophrenia"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the danish 000000000022q000000000011 research initiative","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1186/s12888-015-0594-7","version":"Published Version"},"id":"S01-000.00-470661","identifier":[{"id":"26384214","type":"pmid"},{"id":"PMC4574168","type":"pmcid"},{"id":"84941644545","type":"scopus"}],"ids":["ku-80ffa911-ea33-4117-8fc6-b5b3dea9c380"],"keyword":["Attention Deficit Disorder with Hyperactivity","Autistic Disorder","Case-Control Studies","Child","Child Health Services","Chromosome Aberrations","Chromosomes, Human, Pair 22","Denmark","Humans","Mental Health Services","Research Design","Schizophrenia"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-3-5-EC002C6196AEE738E9F866037CF