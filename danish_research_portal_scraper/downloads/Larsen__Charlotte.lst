ls","Miscellaneous","Other Research","Region Zealand","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-b76455a0-f513-4d55-8d91-a10efaa6705d","ku-d559b580-60d0-4703-b970-445dc44c1ebc","sdu-26e96943-d952-4585-8c6c-5b0701894dab"],"src":["AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Development of a PROM to measure patient-centredness in chronic care consultations in primary care","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-099.93-793404","year":"2025","yearsub":"2025"}
{"abstract":"The impact of different weaning strategies on the downstream circulation of PRRSV has not been widely described. It is, however, believed that mixing pigs of different age groups is increasing the risk of PRRSV circulation in the nursery section. In this study, pigs were sampled in three herds that performed “mixed at weaning (MIX)” and three herds that performed “all in/all out at weaning (AIAO)”. MIX included holding underweighted piglets back in containers for two weeks and then move them to nursery facilities with newly weaned piglets from subsequent batches. Oral fluid samples were collected from four batches of pigs in each herd, three times from weaning until 30 kg for each batch, and tested for PRRSV and PRRSV antibodies. Herds that performed MIX at weaning had an eightfold increase in risk of detecting PRRSV in oral fluids compared to herds with AIAO. In total, 41 oral fluid samples from eight batches in MIX herds and five oral fluid samples from two batches in AIAO herds tested positive for PRRSV. The PRRSV ELISA S/P ratio in oral fluid samples from weaners seem to decrease in most of the batches in the AIAO herds and to increase in most MIX herds. In addition to oral fluids, tongue tip samples were collected from dead pigs and tested for PRRSV. In 17 of 23 batches the results of the tongue tip samples correlated with the results of the oral fluid samples (κ = 0.44) indicating a good agreement between the two materials for sampling. Overall, the results of the study confirmed that the weaning strategy had a significant impact on the circulation of PRRSV post weaning.","author_count":4,"contributors":["Heiselberg, Pia R.","Kristensen, Charlotte Sonne","Kvisgaard, Lise Kirstine","Larsen, Lars Erik"],"cuid":["S01-000.00-810539"],"filters":{"added":"2025-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Management","PRRS","Virus detection","Weaners"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-PR","DI-U"],"level3":{"OT":["HyoVet I/S"],"PR":["DI-PR-ALL","DI-PR-SEGES"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-PR-SEGES","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"impact of weaning procedures on porcine reproductive and respiratory syndrome virus prrsv circulation in the nursery section","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1186/s12917-025-04623-0","version":"Published Version"},"id":"S01-000.00-810539","identifier":[{"id":"40133902","type":"pmid"},{"id":"PMC11938638","type":"pmcid"},{"id":"105001004459","type":"scopus"}],"ids":["ku-9e481288-e1a1-436f-acff-5cbe2c6006b1"],"keyword":["Management","Oral fluids","PRRS","Tongue samples","Virus detection","Weaners"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-A18DDBBAE516B315663F788618549126"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1186/s12917-025-04623-0","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/447853380/Impact_of_weaning_procedures_on_Porcine_Reproductive_and_Respiratory_Syndrome_Virus_PRRSV_circulation_in_the_nursery_section.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["HyoVet I/S"],"nora_code":"DI-OT","used":1},{"affno":"2","country":"dk","key":"seges innovation","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-SEGES","l3nn":"SEGES Innovation","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SEGES Innovation","namevar":["SEGES Innovation"],"nora_code":"DI-PR-SEGES","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary and Animal Sciences, Veterinary Clinical Microbiology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Pia R.","key":"heiselbergpau","last":"Heiselberg","name":"Heiselberg, Pia R.","rank":1,"rolecode":"pau"},{"affno":"2","first":"Charlotte Sonne","key":"kristensenpau","last":"Kristensen","name":"Kristensen, Charlotte Sonne","rank":2,"rolecode":"pau"},{"affno":"3","first":"Lise Kirstine","key":"kvisgaardpau","last":"Kvisgaard","locid":"06d93bdc-8ddd-4561-8778-a8ffa2b5bd51","name":"Kvisgaard, Lise Kirstine","rank":3,"rolecode":"pau"},{"affno":"3","first":"Lars Erik","key":"larsenpau","last":"Larsen","locid":"135a9407-d29c-4508-8f79-978f5b295a15","name":"Larsen, Lars Erik","orcid":"0000-0003-0730-5555","rank":4,"rolecode":"pau"}],"pmid":["40133902"],"pub":{"doi":"10.1186/s12917-025-04623-0","issn":["17466148"],"journal":"BMC Veterinary Research","paperid":"206","status":"p","title":"BMC Veterinary Research","volume":"21"},"review":"Peer Reviewed","scoID":["2-s2.0-105001004459"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Private Research","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Private Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-9e481288-e1a1-436f-acff-5cbe2c6006b1"],"src":["KU University of Copenhagen"],"title":"Impact of weaning procedures on Porcine Reproductive and Respiratory Syndrome Virus (PRRSV) circulation in the nursery section","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-810539","year":"2025","yearsub":"2025"}
{"abstract":"Background: With the provision of home infusion therapy in children with acute or long-term illness on the rise, eHealth technologies have the potential to bridge the transition between hospital and home. However, eHealth interventions intended to support parents in managing home infusion therapy are sparse. Gaining insight into the needs and experiences of parents and health care professionals is crucial to developing feasible and sustainable eHealth interventions that target their needs. This study describes the first phase of a research study designed to develop and evaluate an eHealth intervention to support home infusion therapy. Objective: This study aimed to identify the experiences and needs of parents and health care professionals during home infusion therapy and their preferences for digital features in a future eHealth intervention. Methods: A qualitative study was conducted at 3 pediatric departments at a university hospital in Denmark. We individually interviewed 17 parents of 14 children who had received home infusion therapy with a portable pump. In addition, 5 focus groups were conducted with 15 health care professionals. We conducted a qualitative content analysis of the data, which we collected from February to July 2020. Results: We identified 6 subthemes that we merged into 3 main themes: increasing safe self-management at home; adapting information and responsibility to individual changing needs; and requesting digital features to ensure skill level, safety, and quality of care. The analysis showed that parents and health care professionals had corresponding needs and preferences, for example, a need for a high sense of safety and easier ways to communicate during home infusion therapy. Both groups emphasized the need for digital features to improve problem-solving and communication as a supplement to existing care to promote a safe environment, self-management, and quality of care. A vital issue was that an eHealth intervention should be aligned with the workflow of health care professionals and comply with regulations regarding confidentiality in communication and data sharing. Conclusions: Our study highlights the needs that parents and health care professionals have for increased safety and easier access to communication when receiving and providing home infusion therapy. The findings will be used to help develop an eHealth intervention supporting home infusion therapy tailored to individual needs.","author_count":5,"contributors":["Hansson, Helena","Castor, Charlotte","Larsen, Hanne Bækgaard","Topperzer, Martha Krogh","Olesen, Mette Linnet"],"cuid":["S01-000.00-811362"],"filters":{"added":"2025-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["Sweden"],"glorg":["All Global Affiliations","Lund University"],"keyword":["Digital","Home care","Interventions","Intravenous infusion","Pediatrics","Qualitative Research","eHealth"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"development of an ehealth intervention in pediatric home infusion therapy interview study of needs and preferences of parents and health care professionals","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.2196/63260","version":"Published Version"},"id":"S01-000.00-811362","identifier":[{"id":"PMC11924966","type":"pmcid"},{"id":"40080093","type":"pmid"},{"id":"105001051635","type":"scopus"}],"ids":["ku-e982fd6a-2b83-4d26-adff-93bb40c36556"],"keyword":["digital","eHealth","home care","interventions","intravenous infusion","pediatrics","qualitative research"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-D9F40AAB1B72DD24646381CE4C4091EB"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.2196/63260","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/445903900/pediatrics-2025-1-e63260.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Paediatrics"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","country":"se","key":"lund university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Lund University","used":1}],"person":[{"affno":"1 2","first":"Helena","key":"hanssonpau","last":"Hansson","locid":"b9e04041-9e68-4a36-a738-a6deb1882728","name":"Hansson, Helena","rank":1,"rolecode":"pau"},{"affno":"3","first":"Charlotte","key":"castorpau","last":"Castor","name":"Castor, Charlotte","rank":2,"rolecode":"pau"},{"affno":"1 2","first":"Hanne Bækgaard","key":"larsenpau","last":"Larsen","locid":"88b48e37-454f-41e8-a110-a385dce66a6e","name":"Larsen, Hanne Bækgaard","rank":3,"rolecode":"pau"},{"affno":"2","first":"Martha Krogh","key":"topperzerpau","last":"Topperzer","name":"Topperzer, Martha Krogh","rank":4,"rolecode":"pau"},{"affno":"2","first":"Mette Linnet","key":"olesenpau","last":"Olesen","name":"Olesen, Mette Linnet","rank":5,"rolecode":"pau"}],"pmid":["40080093"],"pub":{"doi":"10.2196/63260","issn":["25616722"],"journal":"JMIR Pediatrics and Parenting","paperid":"e63260","status":"p","title":"JMIR Pediatrics and Parenting","volume":"8"},"review":"Peer Reviewed","scoID":["2-s2.0-105001051635"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-e982fd6a-2b83-4d26-adff-93bb40c36556"],"src":["KU University of Copenhagen"],"title":"Development of an eHealth Intervention in Pediatric Home Infusion Therapy : Interview Study of Needs and Preferences of Parents and Health Care Professionals","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-811362","year":"2025","yearsub":"2025"}
{"abstract":"Background: Osteoarthritis (OA) of the hip or knee is a widespread joint disease, often leading to replacement surgery. However, despite the high success rate of replacement surgery, some patients fail to experience the intended benefits. Given the importance of patient involvement, this trial aims to assess the effect of shared decision-making (SDM) on decisional quality for patients with severe OA. Specifically, it investigates whether an in-consult patient decision aid (PtDA) enhances decisional quality, involvement, and health outcomes for patients with severe hip or knee OA. Methods: This protocol outlines a pragmatic two-armed multicentre cluster-randomised controlled trial (C-RCT) involving 19 orthopaedic surgeons randomised 1:1, stratified by centre, to either continue standard consultations or SDM with a newly developed in-consult PtDA. This trial intends to recruit 615 patients diagnosed with severe OA in their hip or knee. Surveys measuring decisional quality and disease-specific and generic health outcomes will be sent out at multiple time points: one-week post-consultation and three and 12 months post-consultation or post-surgery. The primary outcome (decisional quality) will be measured using the Hip/Knee OA Decision Quality Instrument and assessed based on the percentage of patients who are well-informed and receive their preferred treatment. The secondary outcomes include patient involvement in the decision-making process and consultation durations. The tertiary outcomes include patients’ satisfaction, regret and health-related outcomes. Discussion: This study aims to contribute insights into the use of SDM facilitated by a PtDA and its impact on improving decisional quality for future patients with hip or knee OA. Trial registration: www.ClinicalTrials.gov (NCT05972525), Data of registration: 06.08.2023","author_count":6,"contributors":["Ahlmann Pedersen, Trine","Lindberg-Larsen, Martin","Myhre Jensen, Charlotte","Timm, Signe","Dahl Steffensen, Karina","Varnum, Claus"],"cuid":["S01-000.00-821192"],"filters":{"added":"2025-08","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Ahlmann Pedersen, Trine"],"keyword":["Cluster randomised trial","Osteoarthritis","Patient reported outcome","Shared decision making","Total hip replacement","Total knee replacement","Unicompartmental knee replacement"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"impact of an in consult patient decision aid on decisional quality involvement and health outcome for patients with severe hip or knee osteoarthritis a study protocol for a multicentre cluster randomised controlled trial pati study","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1186/s12891-025-08856-w","version":"Published Version"},"id":"S01-000.00-821192","identifier":[{"id":"40597226","type":"pmid"},{"id":"PMC12220521","type":"pmcid"},{"id":"105009881444","type":"scopus"}],"ids":["sdu-439b687c-2365-4265-82eb-f58b353c7175"],"keyword":["Cluster-randomised trial","Decisional quality","Osteoarthritis","Patient-reported outcome","Shared decision-making","Total hip replacement","Total knee replacement","Unicompartmental knee replacement"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-93F2A323BEB508BF4BE62436FE816031"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/292988623/s12891-025-08856-w.pdf","version":"Published Version"},{"access":"oa","type":"rem","url":"https://doi.org/10.21203/rs.3.rs-4354090/v1","version":"Pre-print"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1186/s12891-025-08856-w","version":"Published Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Regional Health Research","SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Lillebælt Hospital, Research Unit of Orthopaedics (Vejle)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Trine Ahlmann","key":"pedersenpau","last":"Pedersen","locid":"a24bf0e9-792a-4160-bc21-b7785ee036d2","name":"Ahlmann Pedersen, Trine","name_org":"Pedersen, Trine Ahlmann","orcid":"0000-0002-7054-2476","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Martin","key":"lindberglarsenpau","last":"Lindberg-Larsen","locid":"299608f9-db43-4744-984b-a7c428aca95b","name":"Lindberg-Larsen, Martin","orcid":"0000-0002-4483-677X","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Charlotte Myhre","key":"jensenpau","last":"Jensen","locid":"a084c1c8-fe75-45d5-93f8-3c37b71b732b","name":"Myhre Jensen, Charlotte","name_org":"Jensen, Charlotte Myhre","orcid":"0000-0002-7058-4641","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Signe","key":"timmpau","last":"Timm","locid":"0d8e2325-ac5f-4763-9ad8-c8431428e981","name":"Timm, Signe","orcid":"0000-0002-5862-7784","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Karina Dahl","key":"steffensenpau","last":"Steffensen","locid":"2ab8fd03-e60c-401e-aeff-4a5eb53fe025","name":"Dahl Steffensen, Karina","name_org":"Steffensen, Karina Dahl","orcid":"0000-0002-9217-3907","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Claus","key":"varnumpau","last":"Varnum","locid":"0f639544-4ebc-467c-a15b-3c049a26f62f","name":"Varnum, Claus","orcid":"0000-0002-0625-5691","rank":6,"rolecode":"pau"}],"pmid":["40597226"],"pub":{"doi":"10.1186/s12891-025-08856-w","issn":["14712474"],"journal":"BMC Musculoskeletal Disorders","paperid":"584","publisher":"BioMed Central","status":"p","title":"BMC Musculoskeletal Disorders","volume":"26"},"review":"Peer Reviewed","scoID":["2-s2.0-105009881444"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-439b687c-2365-4265-82eb-f58b353c7175"],"src":["SDU University of Southern Denmark"],"title":"Impact of an in-consult patient decision aid on decisional quality, involvement, and health outcome for patients with severe hip or knee osteoarthritis – a study protocol for a multicentre, cluster randomised controlled trial (PATI-study)","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-821192","year":"2025","yearsub":"2025"}
{"abstract":"Introduction: Formalin-fixed paraffin-embedded (FFPE) tumor biopsy is the current mainstay of genotyping, but is limited by its invasiveness and tumor heterogeneity. Plasma cell-free DNA (cfDNA) constitutes a minimally invasive alternative that may better capture tumor-derived profiles from circulating tumor DNA (ctDNA). This study compares the performance and genomic concordance of cfDNA and FFPE tumor DNA in aggressive non-Hodgkin large B-cell lymphoma. Methods: Paired diagnostic FFPE tissue and plasma samples from 15 patients were sequenced with a custom 53-gene panel. Results: Detection thresholds were empirically guided at 1% variant allele frequency (VAF) for cfDNA and 10% for unpaired FFPE DNA. The median number of cfDNA variants was 6 (interquartile range (IQR): 2–11) versus 63 (IQR: 15–250) in FFPE DNA at 1% VAF. Collectively, 102 somatic variants were shared between cfDNA and FFPE DNA with a median of 5 (range: 0–23). cfDNA showed a five-fold lower median VAF for shared variants than FFPE DNA (7% vs. 36%, p < 0.0001). Eighty percent of patients harbored at least one cfDNA variant. A maximum cfDNA recall rate of 83% was observed at FFPE DNA VAF > 50%. COSMIC database overlap was twice as high for cfDNA compared to FFPE DNA (22% vs. 11%) at 10% VAF. Conclusion: cfDNA has superior specificity for somatic mutation detection but lower sensitivity than FFPE DNA. Modest concordance was demonstrated between the two compartments. Our results support a complementary role of ctDNA in mutational profiling at a 1% VAF threshold in a pragmatic and clinically applicable setup.","author_count":8,"contributors":["Vimalathas, Gayaththri","Cédile, Oriane","Kjeldsen, Marie Louise Grube","Thomassen, Mads","Møller, Michael Boe","Nyvold, Charlotte Guldborg","Hansen, Marcus Høy","Larsen, Thomas Stauffer"],"cuid":["S01-000.00-821439"],"filters":{"added":"2025-08","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Vimalathas, Gayaththri"],"keyword":["B cell lymphoma","Cell free DNA","DNA sequence analysis","circulating tumor DNA"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"liquid biopsy for enhanced specificity in identifying somatic mutations in aggressive non hodgkin large b cell lymphoma a comparative study of cell free dna and formalin fixed paraffin embedded tissue","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1111/ijlh.14454","version":"Published Version"},"id":"S01-000.00-821439","identifier":[{"id":"40013464","type":"pmid"},{"id":"85219607667","type":"scopus"}],"ids":["sdu-88d626c7-638b-4154-866e-d598af1f6ca3"],"keyword":["B-cell lymphoma","DNA sequence analysis","cell-free DNA","circulating tumor DNA"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-CC42ADCAADC77659B9B7D1FE5D5F3216"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/292644788/Int_J_Lab_Hematology_-_2025_-_Vimalathas_-_Liquid_Biopsy_for_Enhanced_Specificity_in_Identifying_Somatic_Mutations_in.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1111/ijlh.14454","version":"Published Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research Unit OPEN (Odense)","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Haematology (Odense)","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Pathology (Odense)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Gayaththri","key":"vimalathaspau","last":"Vimalathas","locid":"ebe9802e-b5a4-44ea-bc20-0115d3e4996c","name":"Vimalathas, Gayaththri","orcid":"0000-0001-5507-9762","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Oriane","key":"cédilepau","last":"Cédile","locid":"b2e3be48-c899-40b9-b01d-2bd23278dcf1","name":"Cédile, Oriane","orcid":"0000-0002-6632-8039","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marie Louise Grube","key":"kjeldsenpau","last":"Kjeldsen","locid":"49fea94e-40bd-48e7-94ec-89317ee07ff4","name":"Kjeldsen, Marie Louise Grube","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mads","key":"thomassenpau","last":"Thomassen","locid":"428f2151-f2aa-4a5e-bdee-4184c0586467","name":"Thomassen, Mads","orcid":"0000-0003-0078-1217","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Michael Boe","key":"møllerpau","last":"Møller","locid":"edd876e8-0651-4c8f-8f0f-95f4519e1654","name":"Møller, Michael Boe","orcid":"0000-0003-2041-3630","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Charlotte Guldborg","key":"nyvoldpau","last":"Nyvold","locid":"ba584c2b-215e-421c-a6e6-c799c1b16b7c","name":"Nyvold, Charlotte Guldborg","orcid":"0000-0002-0411-7594","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marcus Høy","key":"hansenpau","last":"Hansen","locid":"066dac5b-cbf5-4b70-b136-3e5dd42e4bee","name":"Hansen, Marcus Høy","orcid":"0000-0003-3083-4850","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thomas Stauffer","key":"larsenpau","last":"Larsen","locid":"dd2de49b-c3d9-49cb-bb8d-e92119e0b2d1","name":"Larsen, Thomas Stauffer","orcid":"0000-0002-8418-6708","rank":8,"rolecode":"pau"}],"pmid":["40013464"],"pub":{"doi":"10.1111/ijlh.14454","issn":["17515521","1751553X"],"issn_org":["17515521"],"issue":"4","journal":"International Journal of Laboratory Hematology","pages":"669-679","publisher":"Wiley","status":"p","title":"International Journal of Laboratory Hematology","volume":"47"},"review":"Peer Reviewed","scoID":["2-s2.0-85219607667"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-88d626c7-638b-4154-866e-d598af1f6ca3"],"src":["SDU University of Southern Denmark"],"title":"Liquid Biopsy for Enhanced Specificity in Identifying Somatic Mutations in Aggressive Non-Hodgkin Large B-Cell Lymphoma : A Comparative Study of Cell-Free DNA and Formalin-Fixed Paraffin-Embedded Tissue","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-821439","year":"2025","yearsub":"2025"}
