ningsportal.dk/search?modus=sin&s=LOI:S01-000.00-311949","year":"2016","yearsub":"2016"}
{"abstract":"In bulk shipping, ships often have multiple tanks and carry multiple inhomogeneous products at a time. When operating such ships it is therefore a major challenge to decide how to best allocate cargoes to available tanks while taking into account tank capacity, safety restrictions, ship stability and strength as well as other operational constraints. The problem of finding a feasible solution to this tank allocation problem has been shown to be NP-Complete. We approach the problem on a tactical level where requirements for computation time are strict while solution quality is less important than simply finding a feasible solution. We have developed a heuristic that can efficiently find feasible cargo allocations. Computational results show that it can solve 99 % of the considered instances within 0.4 s and all of them if allowed longer time. We have also modified an optimality based method from the literature. The heuristic is much faster than this modified method on the vast majority of considered instances. However, the heuristic struggles on two instances which are relatively quickly solved by the modified optimality based method. These two methods therefore complement each other nicely and so, we have created a hybrid method that first runs the heuristic and if the heuristic fails to solve the problem, then runs the modified optimality based method on the parts of the problem that the heuristic did not solve. This hybrid method cuts between 90 and 94 % of the average running times compared to the other methods and consistently solves more instances than the other methods within any given time limit. In fact, this hybrid method is fast enough to be used in a tactical setting.","author_count":3,"contributors":["Vilhelmsen, Charlotte","Larsen, Jesper","Lusby, Richard Martin"],"cuid":["S01-000.00-317571"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Bulk shipping","Heuristic","Maritime transportation"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"a heuristic and hybrid method for the tank allocation problem in maritime bulk shipping","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/128527341/A_Heuristic_and_Hybrid_Method.pdf","version":"Authors Final Version"},"id":"S01-000.00-317571","identifier":[{"id":"84969779016","type":"scopus"}],"ids":["dtu-2bab0519-2eb0-4fac-a1a3-538aa58bcf7e"],"keyword":["Bulk shipping","Heuristic","Maritime transportation","Tank allocation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-2D3C21033897A2C4494C2604861CA777"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/128527341/A_Heuristic_and_Hybrid_Method.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Management Engineering","Technical University of Denmark, Department of Management Engineering, Management Science"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Charlotte","key":"vilhelmsenpau","last":"Vilhelmsen","locid":"6ceebc69-a38c-4b56-9070-23135aa491c6","name":"Vilhelmsen, Charlotte","orcid":"0000-0001-8260-6791","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper","key":"larsenpau","last":"Larsen","locid":"d1af4d26-e92b-414c-b534-25b2b607a0d9","name":"Larsen, Jesper","orcid":"0000-0002-9119-3586","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Richard Martin","key":"lusbypau","last":"Lusby","locid":"51599544-7991-404d-b9a7-ec2f5ad4824b","name":"Lusby, Richard Martin","orcid":"0000-0002-8652-6219","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1007/s10288-016-0319-x","issn":["16142411","16194500"],"issn_org":["16194500"],"issue":"4","journal":"4 OR","pages":"417-444","publisher":"Springer","status":"p","title":"4 OR","title_org":"4 O R","volume":"14"},"review":"Peer Reviewed","scoID":["2-s2.0-84969779016"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-2bab0519-2eb0-4fac-a1a3-538aa58bcf7e"],"src":["DTU Technical University of Denmark"],"title":"A heuristic and hybrid method for the tank allocation problem in maritime bulk shipping","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-317571","year":"2016","yearsub":"2016"}
{"abstract":"A new technology for pre-treating source-separated organic household waste prior to anaerobic digestion was assessed, and its performance was compared to existing alternative pre-treatment technologies. This pre-treatment technology is based on waste pulping with water, using a specially developed screw mechanism. The pre-treatment technology rejects more than 95% (wet weight) of non-biodegradable impurities in waste collected from households and generates biopulp ready for anaerobic digestion. Overall, 84-99% of biodegradable material (on a dry weight basis) in the waste was recovered in the biopulp. The biochemical methane potential for the biopulp was 469±7mL CH4/g ash-free mass. Moreover, all Danish and European Union requirements regarding the content of hazardous substances in biomass intended for land application were fulfilled. Compared to other pre-treatment alternatives, the screw-pulping technology showed higher biodegradable material recovery, lower electricity consumption and comparable water consumption. The higher material recovery achieved with the technology was associated with greater transfer of nutrients (N and P), carbon (total and biogenic) but also heavy metals (except Pb) to the produced biomass. The data generated in this study could be used for the environmental assessment of the technology and thus help in selecting the best pre-treatment technology for source separated organic household waste.","author_count":4,"contributors":["Naroznova, Irina","Møller, Jacob","Larsen, Bjarne","Scheutz, Charlotte"],"cuid":["S01-000.00-322183"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Anaerobic digestion","Biochemical methane potential","Biohazards","Carbon","Environmental technology","Hazardous substances","Hazards","Heavy metals","Lead","Mass balance","Metal recovery","Methane","Organic household wastes","Pre treatment","Recovery","Separation","Source separated organic household waste","Waste Management and Disposal","Waste treatment"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-PR-OTH","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"evaluation of a new pulping technology for pre treating source separated organic household waste prior to anaerobic digestion","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84957900580","version":"Other Version"},"id":"S01-000.00-322183","identifier":[{"id":"26868847","type":"pmid"},{"id":"84957900580","type":"scopus"}],"ids":["dtu-3b3b57eb-e863-4164-a380-2f64fbf69312"],"keyword":["Anaerobic digestion","Biochemical methane potential","Biohazards","Carbon","Environmental technology","Hazardous substances","Hazards","Heavy metals","Lead","Mass balance","Metal recovery","Methane","Organic household wastes","Pre-treatment","Recovery","Screws","Separation","Source-separated organic household waste","Waste Management and Disposal","Waste treatment"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-99F9864BE893BC65D6985286A0FAAD4B"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Environmental Engineering","Technical University of Denmark, Department of Environmental Engineering, Residual Resource Engineering"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["KomTek Miljø af 2012 A/S"],"nora_code":"DI-PR-OTH","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Irina","key":"naroznovapau","last":"Naroznova","locid":"e24a9d73-2e37-4a15-b742-995ce845e719","name":"Naroznova, Irina","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jacob","key":"møllerpau","last":"Møller","locid":"ba375b02-d34a-4a26-958d-59b8bd17fa42","name":"Møller, Jacob","orcid":"0000-0003-3475-1251","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Bjarne","key":"larsenpau","last":"Larsen","name":"Larsen, Bjarne","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Charlotte","key":"scheutzpau","last":"Scheutz","locid":"48fe2850-fdc6-4282-9b97-ac5773419e5c","name":"Scheutz, Charlotte","orcid":"0000-0003-2218-5934","rank":4,"rolecode":"pau"}],"pmid":["26868847"],"pub":{"doi":"10.1016/j.wasman.2016.01.042","issn":["0956053X","18792456"],"issn_org":["0956053X"],"journal":"Waste Management","pages":"65-74","publisher":"Elsevier","status":"p","title":"Waste Management","volume":"50"},"review":"Peer Reviewed","scoID":["2-s2.0-84957900580"],"sdg":["7. Affordable and Clean Energy","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Other Companies","Private Research","Technical University of Denmark","Universities","komtek miljø af 2012 a/s"],"PST":["Published"]},"sid":["dtu-3b3b57eb-e863-4164-a380-2f64fbf69312"],"src":["DTU Technical University of Denmark"],"title":"Evaluation of a new pulping technology for pre-treating source-separated organic household waste prior to anaerobic digestion","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=s