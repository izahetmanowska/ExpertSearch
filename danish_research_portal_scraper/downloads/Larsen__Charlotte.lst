00-0002-0278-3673","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Danielle Louise","key":"nøragerjohansenpau","last":"Nørager Johansen","locid":"a42269eb-2e09-475c-a91f-8c717282e436","name":"Johansen, Danielle Louise Nørager","name_org":"Nørager Johansen, Danielle Louise","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars Breum","key":"christiansenpau","last":"Christiansen","locid":"c168a51e-682a-42f8-8a57-fa705d9749e9","name":"Christiansen, Lars Breum","orcid":"0000-0002-5142-3623","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Camilla Marie","key":"larsenpau","last":"Larsen","locid":"0fdd3035-e7da-4ae3-9e99-f247aecd54e3","name":"Larsen, Camilla Marie","orcid":"0000-0003-4691-3609","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-9f776f1f-25b9-4d3f-a993-e99a8f62d619"],"src":["SDU University of Southern Denmark"],"title":"”God Start”: A 4-day family-centered, resource-oriented, and interdisciplinary program for families with 0-4-year-old children with cerebral palsy","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-618874","year":"2022","yearsub":"2022"}
{"abstract":"Baggrund: Patienter med kroniske smerter kan have behov for at arbejde med livsstilsforbedringer som en del af den tværfaglige rehabilitering. Tidligere studier har vist ergoterapiens potentiale i en livsstilsorienteret tilgang til smertebehandling, men der er behov for yderligere forskning i dansk kontekst. Formål: Som forberedelse til et randomiseret kontrolleret studie, blev den ergoterapeutiske intervention REVEAL(OT) [Redesign your EVEryday Activities and Lifestyle with Occupational Therapy] pilotafprøvet som et tillæg til det nuværende tværfaglige behandlingstilbud på et regionalt smertecenter i Region Sjælland. Metoder: Ambulante patienter med kroniske smerter (n=40) mellem 18 og 65 år (85% kvinder) henvist til Tværfagligt Smertecenter på Næstved sygehus deltog i undersøgelsen. Ergoterapeuter har samarbejdet med deltagerne omkring deres personlige mål i relation til daglige aktiviteter, regelmæssig bevægelse og spisevaner. Primære effektmål for studiet var prædefinerede progressionskriterier (ift. progression til det randomiserede studie) for rekruttering, accept af undersøgelsesprocedurer, retention, deltagelsesprocent, uønskede hændelser og planmæssig levering af programmet. Sekundære effektmål var helbredsrelateret livskvalitet, aktivitetsudførelse, aktivitetsbalance, kroppens antropometri og smertesensitisering. Tendenser blev monitoreret ved at sammenligne før- og eftermålingerne. Fokusgruppeinterviews med 8 patienter og 4 klinikere blev gennemført for en dybere indsigt i, hvordan REVEAL(OT) blev oplevet. Resultater: Foreløbige analyser af data fra deltagere (n=30) som har afsluttet programmet, demonstrerede acceptabelt-til-godt niveau i opfyldelsen af de primære effektmål, samt en tendens til signifikant forbedring i de sekundære mål: aktivitetsudførelse (1.76 [95% CI 1.22; 2.29]) og tilfredsheden med aktivitetsudførelsen (1.88 [95% CI 1.01; 2.75]). REVEAL(OT) medvirkede til øget accept af livet med kroniske smerter hos patienterne og deres empowerment for livsstilsændringer. Patienter og klinikere foreslog en række forbedringer i interventionen. Konklusioner: Pilotafprøvningen af det ergoterapeutiske program REVEAL(OT) har givet et indblik i, hvordan der kan arbejdes med daglige aktiviteter og livsstil som led i den tværfaglige smertebehandling. Et randomiseret studie skal afdække effekten af det ergoterapeutiske livsstilsorienterede program for kroniske smertepatienter.","author_count":8,"contributors":["Nielsen, Svetlana Solgaard","Skou, Søren Thorgaard","Larsen, Anette Enemark","Vægter, Henrik Bjarke","Polianskis, Romanes","Simonÿ, Charlotte","Søndergaard, Jens","Christensen, Jeanette Reffstrup"],"cuid":["S01-000.00-641716"],"event":{"end":"2022-06-02","place":"Nyborg, dk","start":"2022-06-01","title":"Ergo22: Styrket forskning - styrket praksis","year":"2022"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U","DI-UC"],"level3":{"HO":["DI-HO-ALL","DI-HO-ZEA"],"U":["DI-U-ALL","DI-U-SDU"],"UC":["DI-UC-ALL","DI-UC-KP"]},"level3all":["DI-HO-ZEA","DI-U-SDU","DI-UC-KP"]},"review":"pr","rtype":["clu"],"sorti":"ergoterapi i den tværfaglige behandling af kroniske smerter erfaringer fra en pilotafprøvning occupational therapy in multidisciplinary chronic pain treatment experiences from a feasibility study","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-641716","ids":["sdu-ef351d1f-ed95-43bf-bf28-09b4e5a38ad8"],"lang":"Danish","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-AE4978FAD2C9C3AE808B2F8AFE57A529"],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU Universi