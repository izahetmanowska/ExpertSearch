,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Sandra","key":"denerypapinipau","last":"Denery-Papini","name":"Denery-Papini, Sandra","rank":10,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Gabriel","key":"mazzucchellipau","last":"Mazzucchelli","name":"Mazzucchelli, Gabriel","rank":11,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Grégory","key":"bouchaudpau","last":"Bouchaud","name":"Bouchaud, Grégory","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Katrine Lindholm","key":"bøghpau","last":"Bøgh","locid":"69dcdef2-7e2a-4c8c-966b-dd14c90e6419","name":"Bøgh, Katrine Lindholm","orcid":"0000-0002-5266-0372","rank":13,"rolecode":"pau"}],"pmid":["34636481"],"pub":{"doi":"10.1002/mnfr.202100416","issn":["16134125","16134133"],"issn_org":["16134125"],"issue":"23","journal":"Molecular Nutrition & Food Research","paperid":"2100416","publisher":"Wiley","status":"p","title":"Molecular Nutrition & Food Research","title_org":"Molecular Nutrition and Food Research","volume":"65"},"review":"Peer Reviewed","scoID":["2-s2.0-85118218324"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-2654944e-ae45-4fb7-8039-cb45f062e692"],"src":["DTU Technical University of Denmark"],"title":"Acid Hydrolysis of Gluten Enhances the Skin Sensitising Potential and Drives Diversification of IgE Reactivity to Unmodified Gluten Proteins","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-315946","year":"2021","yearsub":"2021"}
{"abstract":"Asperphenamate is a small peptide natural product that has gained much interest due to its antitumor activity. In the recent years numerous bioactive synthetic asperphenamate analogues have been reported, whereas only a handful of natural analogues either of microbial or plant origin has been discovered. Herein we describe a UHPLC-HRMS/MS and amino acid supplement approach for discovery and design novel asperphenamate analogues. Chemical analysis of Penicillium astrolabium, a prolific producer of asperphenamate, revealed three previously described and two novel asperphenamate analogues produced in significant amounts, suggesting a potential for biosynthesis of further asperphenamate analogues by varying the amino acid availability. Subsequent growth on proteogenic and non-proteogenic amino acid enriched media, revealed a series of novel asperphenamate analogues, including single or double amino acid exchange, as well as benzoic acid exchange for nicotinic acid, with the latter observed from a natural source for the first time. In total, 22 new asperphenamate analogues were characterized by HRMS/MS, with one additionally confirmed by isolation and NMR structure elucidation. This study indicates an extraordinary nonribosomal peptide synthetase (NRPS) flexibility based on substrate availability, and therefore the potential for manipulating and designing novel peptide natural products in filamentous fungi.","author_count":11,"contributors":["Subko, Karolina","Wang, Xinhui","Nielsen, Frederik H.","Isbrandt, Thomas","Gotfredsen, Charlotte Held","Ramos, Carmen","Mackenzie, Thomas","Vicente, Francisca","Genilloud, Olga","Frisvad, Jens Christian","Larsen, Thomas Ostenfeld"],"cuid":["S01-000.00-320183"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"corresponding_author":["Larsen, Thomas Ostenfeld"],"country":["Spain"],"glorg":["All Global Affiliations","Fundación MEDINA"],"keyword":["Asperphenamate","Biological activity","Filamentous fungi","Mass spectrometry","Natural product discovery"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-NP","DI-U"],"level3":{"NP":["DI-NP-ALL","DI-NP-NOVO"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-NP-NOVO","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"mass spectrometry guided discovery and design of novel asperphenamate analogues from penicilium astrolabium reveals an extraordinary nrps flexibility","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fmicb.2020.618730","version":"Published Version"},"id":"S01-000.00-320183","identifier":[{"id":"85100220776","type":"scopus"},{"id":"PMC7843940","type":"pmcid"},{"id":"33519780","type":"pmid"}],"ids":["dtu-34679679-442b-4128-9144-51e6043a7561"],"keyword":["Amino acid incorporation","Asperphenamate","Biological activity","Filamentous fungi","Mass spectrometry","NRPS flexibility","Natural product discovery"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-494EC8701D8236E3BC1E2BC3CAA6F875"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/238806630/fmicb_11_618730.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/236954255/Author_s_Proof_TOL.pdf","version":"Other Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fmicb.2020.618730","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Biotechnology and Biomedicine","Technical University of Denmark, Department of Biotechnology and Biomedicine, Section for Microbial and Chemical Ecology, Natural Product Discovery"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"novo nordisk foundation","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-NOVO","l3nn":"Novo Nordisk Foundation","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Novo Nordisk Foundation","namevar":["Novo Nordisk Foundation"],"nora_code":"DI-NP-NOVO","used":1},{"affno":"3","country":"es","key":"fundación medina","loc":["Spain","Europe, EU","OECD"],"name":"Fundación MEDINA","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Karolina","key":"subkopau","last":"Subko","locid":"94462002-5b2a-42f2-b5d2-66c8c06db4e6","name":"Subko, Karolina","orcid":"0000-0002-9993-8386","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Xinhui","key":"wangpau","last":"Wang","locid":"d5bd1773-7ace-4d42-ad05-0d1d6f4d2298","name":"Wang, Xinhui","orcid":"0000-0003-0472-413X","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Frederik H.","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Frederik H.","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thomas Isbrandt","key":"petersenpau","last":"Petersen","locid":"0a0ca6df-f39c-4d4f-b7ce-d476ea20cc7d","name":"Isbrandt, Thomas","name_org":"Petersen, Thomas Isbrandt","orcid":"0000-0003-3938-0816","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Charlotte H.","key":"gotfredsenpau","last":"Gotfredsen","locid":"1cf4df84-2d0e-4693-bf47-e9932e3bf0e3","name":"Gotfredsen, Charlotte Held","name_org":"Gotfredsen, Charlotte H.","orcid":"0000-0002-7386-119X","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Carmen","key":"ramospau","last":"Ramos","name":"Ramos, Carmen","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Thomas","key":"mackenziepau","last":"Mackenzie","name":"Mackenzie, Thomas","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Francisca","key":"vicentepau","last":"Vicente","name":"Vicente, Francisca","rank":8,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Olga","key":"genilloudpau","last":"Genilloud","name":"Genilloud, Olga","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens C.","key":"frisvadpau","last":"Frisvad","locid":"b2d4f948-9e1c-4f8c-9c02-05588bfa21b9","name":"Frisvad, Jens Christian","name_org":"Frisvad, Jens C.","orcid":"0000-0002-0573-4340","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Thomas O.","key":"larsenpau","last":"Larsen","locid":"bd958d52-71b6-4720-b30a-cc9305633b43","name":"Larsen, Thomas Ostenfeld","name_org":"Larsen, Thomas O.","orcid":"0000-0002-3362-5707","rank":11,"rolecode":"pau"}],"pmid":["33519780"],"pub":{"doi":"10.3389/fmicb.2020.618730","issn":["1664302X"],"journal":"Frontiers in Microbiology","paperid":"618730","publisher":"Frontiers Media SA","publisher_org":"Frontiers Media S.A.","status":"p","title":"Frontiers in Microbiology","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-85100220776"],"search":{"DAF":["All Danish Affiliations","All Non-Profit Organisations","All Universities","DI-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Non-Profit Organisations","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-34679679-442b-4128-9144-51e6043a7561"],"src":["DTU Technical University of Denmark"],"title":"Mass Spectrometry guided discovery and design of novel Asperphenamate analogues from Penicilium astrolabium reveals an extraordinary NRPS flexibility","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-320183","year":"2021","yearsub":"2021"}
{"abstract":"The article presents the results of a study of the activities of educational psychologists working in Danish schools. The discovery is that the most valuable part of the work of school psychologists is done “in between times” and “in the corridor” — in the interval between scheduled meetings, testing and other tasks “according to job descriptions”. The researchers describe the specific types of psy-chologists' work in difficult school situations, the conditions of their professional activities and the di-lemmas that arise when solving professional problems. The authors note that creative, research and context-oriented work aimed at organizing cooperation between various parties is in conflict with the standardized work schedule, which occupies the bulk of the psychologist's working time, while real solutions to complex problems lie in informal communication, cooperation, studying social conditions and analyzing school problems. Choosing between what should and what is needed, the psycholo-gist finds himself in a situation of professionally significant choice and in a conflict situation with him-self, which leads to the need to constantly clarify his own situation and the conditions of his work.","author_count":2,"contributors":["Røn Larsen, Maja","Højholt, Charlotte"],"cuid":["S01-000.00-570392"],"filters":{"added":"2022-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Conflicts","Cooperation","School difficulties","Social conditions","Social practice"],"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-RUC"]},"level3all":["DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"в тени стремления к упорядоченности невидимая работа психологов по разрешению школьных трудностей","src":["ruc"],"src-code":["DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.17759/bppe.2021180403","version":"Published Version"},"id":"S01-000.00-570392","ids":["ruc-d68d57df-5a57-49c3-ba2d-fa16fadd350f"],"keyword":["activity of a school psychologist","conflicts","cooperation","school difficulties","social conditions","social practice","“corridor work”","“work between tasks”"],"lang":"Russian","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-3-622C2081BE48697AEEB85F788DB88FC2"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.17759/bppe.2021180403","version":"Published Version"}],"oai":{"class":"Blocked","mra":["Humanities (HUM)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of People and Technology"],"nora_code":"DI-U-RUC","used":1}],"person":[{"affno":"1","country":"dk","first":"Maja","key":"rønlarsenpau","last":"Røn Larsen","locid":"43249523-b160-4888-8421-4a606d27561a","name":"Røn Larsen, Maja","orcid":"0000-0003-1413-6059","rank":1,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Charlotte","key":"højholtpau","last":"Højholt","locid":"e1ae7eb0-773c-4cc6-84ac-4868fa79025a","name":"Højholt, Charlotte","orcid":"0000-0003-0601-0456","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.17759/bppe.2021180403","issn":["26583100"],"issue":"4","journal":"Bulletin of Psychological Practice in Education","pages":"30-44","status":"p","title":"Bulletin of Psychological Practice in Education","volume":"18"},"review":"Peer Reviewed","sdg":["10. Reduced Inequalities","4. Quality Education","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Roskilde University","Universities"],"PST":["Published"]},"sid":["ruc-d68d57df-5a57-49c3-ba2d-fa16fadd350f"],"s