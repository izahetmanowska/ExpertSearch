n":"University Colleges","l3":"DI-UC-KP","l3nl":"KP","l3nn":"KP University College Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KP University College Copenhagen","namevar":["University College Copenhagen"],"nora_code":"DI-UC-KP","used":1}],"person":[{"affno":"1 2 3","corresponding":null,"first":"Thomas","key":"heidenpau","last":"Heiden","locid":"ef67cd34-1331-466d-9de8-7c04131eee09","name":"Heiden, Thomas Roed","name_org":"Heiden, Thomas","orcid":"0009-0006-2378-2190","rank":1,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Helle","key":"bundgaardsvendsenppu","last":"Bundgaard Svendsen","name":"Bundgaard Svendsen, Helle","rank":2,"role":"Publisher","rolecode":"ppu"},{"affno":"5","corresponding":null,"first":"Charlotte","key":"christiansenpau","last":"Christiansen","name":"Christiansen, Charlotte","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Kirsten","key":"friisppu","last":"Friis","name":"Friis, Kirsten","rank":3,"role":"Publisher","rolecode":"ppu"},{"affno":"4","corresponding":null,"first":"Helle","key":"bonderuppau","last":"Bonderup","name":"Bonderup, Helle","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Helle","key":"bonderupppu","last":"Bonderup","name":"Bonderup, Helle","rank":4,"role":"Publisher","rolecode":"ppu"},{"affno":"4","corresponding":null,"first":"Helle","key":"svendsenpau","last":"Svendsen","name":"Svendsen, Helle","rank":4,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Kirsten Friis","key":"larsenpau","last":"Larsen","name":"Larsen, Kirsten Friis","rank":5,"rolecode":"pau"}],"pub":{"publisher":"Nationalt Videncenter for Læsning","status":"p"},"review":"Undetermined","search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","All University Colleges","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","KP","Miscellaneous","Other Research","UC SYD, University College South Denmark","UCL University College","Universities","University Colleges","VIA University College"],"PST":["Published"]},"sid":["au-c8f76fba-29f3-48d7-b21e-9122d7c43df2","ucl-c9d6ae07-ee18-49b5-896f-d6acc1f92958"],"src":["AU Aarhus University","UCL University College"],"title":"Giv dit ordblinde barn læsesucceser derhjemme","type":"Non-Textual Item","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-088.18-027244","year":"2022","yearsub":"2022"}
{"abstract":"Background: Symptoms and treatment of benign prostatic hyperplasia (BPH) or erectile dysfunction (ED) may lead to prostate cancer workup, and patterns of prescriptions before diagnosis may affect findings of pharmacoepidemiological studies. Usage of BPH and ED drugs after diagnosis may be related to prostate cancer treatment. We investigated differences in prescription rates of BPH and ED drugs among prostate cancer patients and cancer-free comparisons and between patients with localized and non-localized disease. Material and methods: A nationwide register-based study, including all Danish men aged 50–85 years diagnosed with prostate cancer during 1998–2015 and an age-matched comparison cohort without cancer. We calculated rates of new and total prescriptions in 1-month intervals from 3 years before to 3 years after cancer diagnosis for drugs used to treat BPH and ED, overall and stratified by clinical stage. Results: We identified 54,286 men with prostate cancer and a comparison cohort of 249,645 age-matched men. The new prescription rate for BPH drugs increased for men with prostate cancer in the year before diagnosis and peaked 1 month before diagnosis with an 18-fold higher rate. Men with prostate cancer had a higher total prescription rate of BPH drugs 3 years before diagnosis, notably among men with localized disease. Before diagnosis, the new prescription rates for ED drugs were similar among men with prostate cancer and comparisons. After diagnosis, men with prostate cancer had a 7-fold higher rate of new prescriptions for ED drugs. Among men with localized disease, the total prescription rate of ED drugs increased in the months following diagnosis. Conclusion: Differences in prescription rates suggest increased prostate cancer surveillance among men receiving BPH drugs, whereas the post-diagnostic increase in ED drugs among men with localized disease is compatible with the increased risk of ED following prostate cancer treatment.","author_count":8,"contributors":["Duun-Henriksen, Anne Katrine","Dehlendorff, Christian","Røder, Martin Andreas","Skriver, Charlotte","Pottegård, Anton","Friis, Søren","Brasso, Klaus","Larsen, Signe Benzon"],"cuid":["S02-088.24-047296"],"filters":{"added":"2022-11","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Larsen, Signe Benzon"],"keyword":["Benign prostatic hyperplasia","Cohort Studies","Erectile Dysfunction","Erectile Dysfunction diagnosis","Humans","Male","Pharmacoepidemiology","Prescriptions","Prostate cancer","Prostatic Neoplasms complications"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-NP","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-NP-CAN","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"prescription rates for drugs used in treatment of benign prostatic hyperplasia and erectile dysfunction before and after prostate cancer diagnosis","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85131527583","version":"Other Version"},"id":"S02-088.24-047296","identifier":[{"id":"85131527583","type":"scopus"},{"id":"35666094","type":"pmid"}],"ids":["ku-f0997b7e-9998-4052-9e7b-aa5213370c64","sdu-227e473c-7baa-4986-a20b-6d441e0992b3"],"keyword":["Cohort Studies","Erectile Dysfunction/diagnosis","Humans","Male","Prostate cancer","Prostatic Hyperplasia/complications","Prostatic Neoplasms/complications","benign prostatic hyperplasia","erectile dysfunction","pharmacoepidemiology","prescriptions"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-49DFA13FA28BB546F10593FE615EE7E5"],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"o