{"abstract":"I denne artikel undersøges begreberne transgredience (Bakhtin, 1990) og relationel identitetskonstruktion (Gergen, 1985, 1994, 2011) i forbindelse med et ledelsesudviklingsprogram for top-ledere.","author_count":3,"contributors":["Madsen, Charlotte Øland","Larsen, Mette Vinther","Svane, Marita Susanna"],"cuid":["S01-000.00-064211"],"event":{"end":"2015-01-02","place":"Roskilde, dk","start":"2014-12-01","title":"Ledelseskonference: Meningsskabelse, tillid og frihed – udfordringer i moderne ledelse","year":"2014"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"transgredience and relational identity construction in management development processes","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://www.det-danske-ledelsesakademi.dk/2014/papers2014/Transgredience%20and%20relational%20identity%20-%20Madsen,%20Larsen%20og%20Svane.pdf","version":"Other Version"},"id":"S01-000.00-064211","ids":["aau-30f8bfa9-8589-4d3e-a88f-b381645ba4e6"],"keyword":["Transgredience, identitetskonstruktion, diskurs, ledelsesudviklingsprocesser"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-43CFB39C32B9055B2168AE699522CBA2"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.det-danske-ledelsesakademi.dk/2014/papers2014/Transgredience%20and%20relational%20identity%20-%20Madsen,%20Larsen%20og%20Svane.pdf","version":"Other Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg Univers