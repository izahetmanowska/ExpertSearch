"pau"},{"affno":"1","corresponding":null,"first":"Vineesh Indira","key":"chandranpau","last":"Chandran","locid":"6ad1f8c6-d1a0-4c52-83f4-3c810ebbd0e5","name":"Chandran, Vineesh Indira","rank":14,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jonas H.","key":"graversenpau","last":"Graversen","locid":"f2e4d155-e883-4013-aff4-b8706bdfc8be","name":"Graversen, Jonas Heilskov","name_org":"Graversen, Jonas H.","orcid":"0000-0001-7119-2108","rank":15,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Aleksander","key":"kragpau","last":"Krag","locid":"0064696b-9c65-4990-ab96-3635d5a20e4b","name":"Krag, Aleksander","orcid":"0000-0002-9598-4932","rank":16,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars","key":"grøntvedpau","last":"Grøntved","locid":"7546e3da-0d6d-4210-a7b9-bb70cbf168e0","name":"Grøntved, Lars","orcid":"0000-0002-6735-8483","rank":17,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kim","key":"ravnskjaerpau","last":"Ravnskjaer","locid":"1842e135-4b37-4106-a274-f936925e391e","name":"Ravnskjaer, Kim","orcid":"0000-0002-5322-3887","rank":18,"rolecode":"pau"}],"pmid":["36687468"],"pub":{"doi":"10.1016/j.jhepr.2022.100615","issn":["25895559"],"issue":"2","journal":"JHEP Reports","paperid":"100615","publisher":"Elsevier","status":"p","title":"JHEP Reports","volume":"5"},"review":"Peer Reviewed","scoID":["2-s2.0-85145738472"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-b2397690-3aff-414e-8918-fd340c99885b"],"src":["SDU University of Southern Denmark"],"title":"Stellate cell expression of SPARC-related modular calcium-binding protein 2 is associated with human non-alcoholic fatty liver disease severity","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-624265","year":"2023","yearsub":"2023"}
{"abstract":"Objective: Gynecological examinations (GEs) are challenging for many women. Several recommendations and guidelines have emerged, partly based on common sense and clinicians' consensus. However, there is a lack of knowledge regarding women's opinions. Therefore, this study aimed to describe women's preferences and experiences in relation to GEs and investigate whether they are dependent on their socioeconomic status. Methods: In Denmark, GEs are typically performed by general practitioners or resident specialists in gynecology (RSGs) in gynecological hospital departments. This cross-sectional questionnaire and register study included approximately 3000 randomly selected patients who visited six RSGs from January 1, 2020, to March 1, 2021. The main outcome measurement involved women's preferences and experiences regarding GEs. Results: Overall, 37% of the women thought that a changing room was important, 20% preferred a garment to cover themselves, 18% preferred a separate examination room, and 13% thought that the presence of a chaperone was important. Compared with working and retired women, more women outside the workforce felt insufficiently informed, considered their experience with RSGs unprofessional, and found GEs painful. Conclusion: Our results support existing recommendations regarding GEs and the related environment, confirming that privacy and modesty are factors to take into consideration as they are of concern for a relatively large group of women. Thus, providers should focus on women outside the workforce, because this group appears to feel vulnerable in this environment.","author_count":4,"contributors":["Laschke, Alexander","Blaakær, Jan","Jensen, Charlotte Floridon","Larsen, Mette Bach"],"cuid":["S01-000.00-691283"],"filters":{"added":"2023-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Laschke, Alexander"],"keyword":["Attitudes","Consensus","Cross Sectional Studies","Denmark","Female","Gynecological Examination","Gynecology","Health care","Health knowledge","Humans","Outcome assessment","Patient Preference","Practice","Standard of Care","Women"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR","DI-HO-OTH"],"OT":["Gynækologisk Klinik Holbæk"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-CDR","DI-HO-OTH","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"danish women s preferences regarding gynecological examination support international recommendations a cross sectional study","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1002/ijgo.14828","version":"Published Version"},"id":"S01-000.00-691283","identifier":[{"id":"37158417","type":"pmid"},{"id":"85158868821","type":"scopus"}],"ids":["sdu-ac9a3f0a-ea58-4bc6-834e-919c69e3653c"],"keyword":["Consensus","Cross-Sectional Studies","Denmark","Female","Gynecology","Humans","attitudes","gynecological examination","health care","health knowledge","outcome assessment","patient preference","practice","standard of care","women"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-502AAD6E5886EC2558EC2A8D3A8D9C60"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/229945170/Intl_J_Gynecology_Obste_2023_Laschke_Danish_women_s_preferences_regarding_gynecological_examination_support.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1002/ijgo.14828","version":"Published Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"other hospitals","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-OTH","l3nl":"Other Hospitals","l3nn":"Other Hospitals","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Hospitals","namevar":["Speciallægeselskabet Alexander Laschke ApS"],"nora_code":"DI-HO-OTH","used":1},{"affno":"3","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Gynækologisk Klinik Holbæk"],"nora_code":"DI-OT","used":1},{"affno":"4","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Regionshospitalet Randers"],"nora_code":"DI-HO-CDR","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Alexander","key":"laschkepau","last":"Laschke","locid":"6b0a6a80-9955-4152-be22-f966da19e165","name":"Laschke, Alexander","orcid":"0000-0003-2348-6747","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jan","key":"blaakærpau","last":"Blaakær","locid":"1a4149d9-2f14-46a8-882f-702c626338f5","name":"Blaakær, Jan","orcid":"0000-0003-3726-0589","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Charlotte Floridon","key":"jensenpau","last":"Jensen","name":"Jensen, Charlotte Floridon","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Mette Bach","key":"larsenpau","last":"Larsen","name":"Larsen, Mette Bach","rank":4,"rolecode":"pau"}],"pmid":["37158417"],"pub":{"doi":"10.1002/ijgo.14828","issn":["00207292","09248447"],"issn_org":["00207292"],"issue":"3","journal":"International Journal of Gynecology & Obstetric