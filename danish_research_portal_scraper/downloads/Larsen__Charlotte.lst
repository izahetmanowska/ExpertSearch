{"author_count":4,"contributors":["Martiny, Karen","Christensen, Jens Peter","Larsen, Lars Erik","Hjulsager, Charlotte Kristiane"],"cuid":["S01-000.00-811308"],"filters":{"added":"2025-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-GV-SSI","DI-U-KU"]},"review":"nr","rtype":["clu"],"sorti":"udbrud af newcastle disease i danske duehold","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-811308","ids":["ku-e4c22c17-545f-4d25-9392-6651b5a4a774"],"lang":"Danish","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-89597AAE87FC012AAB446158C9DDF6D1"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary and Animal Sciences, Veterinary Clinical Microbiology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"ssi statens serum institut","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-SSI","l3nn":"SSI Statens Serum Institut","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SSI Statens Serum Institut","namevar":["Statens Serum Institut"],"nora_code":"DI-GV-SSI","used":1}],"person":[{"affno":"1","first":"Karen","key":"martinypau","last":"Martiny","locid":"2f168c92-c78b-43da-944e-872121b1cc06","name":"Martiny, Karen","orcid":"0000-0002-7948-1067","rank":1,"rolecode":"pau"},{"affno":"1","first":"Jens Peter","key":"christensenpau","last":"Christensen","locid":"939fd558-e675-4e66-9601-2a336ebfd5a9","name":"Christensen, Jens Peter","orcid":"0000-0002-6430-9010","rank":2,"rolecode":"pau"},{"affno":"1","first":"Lars","key":"larsenpau","last":"Larsen","locid":"135a9407-d29c-4508-8f79-978f5b295a15","name":"Larsen, Lars Erik","name_org":"Larsen, Lars","orcid":"0000-0003-0730-5555","rank":3,"rolecode":"pau"},{"affno":"2","first":"Charlotte Kristiane","key":"hjulsagerpau","last":"Hjulsager","name":"Hjulsager, Charlotte Kristiane","rank":4,"rolecode":"pau"}],"pub":{"issn":["01066854","19023715"],"issn_org":["01066854"],"journal":"Dansk Veterinærtidsskrift","pages":"48","status":"p","title":"Dansk Veterinærtidsskrift","volume":"08"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-e4c22c17-545f-4d25-9392-6651b5a4a774"],"src":["KU University of Copenhagen"],"title":"Udbrud af Newcastle disease i Danske duehold","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-811308","year":"2022","yearsub":"2022"}
{"abstract":"Purpose: The coronavirus disease 2019 (COVID-19) pandemic has a severe impact on the general population. During the pandemic, children may develop emotional and psychological symptoms, including increased worries about health and illness, known as health anxiety symptoms (HASs). We aimed to explore HAS in 7–9-year-old children from the Danish Odense Child Cohort (OCC) during the first COVID-19 lockdown period in Denmark, and to examine associations with potential risk factors. Material and methods: OCC is a cohort of children born between 2010 and 2012, which originally recruited 2874 of 6707 pregnancies (43%). Among the current OCC population of 2430 singleton children, 994 participated in this study (response rate 40%). Children and their parents filled out questionnaires about child HAS, family exposure to COVID-19 infection and parental HAS. Adjusted odds ratios (aORs) were calculated between high score child HAS (≥90th percentile) and covariates by use of logistic regression. Results: Most children (n = 686, 69%) reported few worries about their health. Children reporting high score HAS also had higher levels of internalizing symptoms at age 5; aOR 2.15 (1.20;3.85), p = .010, and higher levels of maternal and paternal HAS; aOR 2.40 (1.44;3.97), p = .001, and 2.00 (1.10;3.65), p = .023, whereas no association with child sex or familial exposure to COVID-19 was detected (n = 65, 6.5%). Conclusions: High score child HAS during the first lockdown period of the COVID-19 pandemic was not associated with family exposure to COVID-19 infection, but to being a more anxious child a priori and to HAS in parents.","author_count":8,"contributors":["Hulgaard, Ditte","Rask, Charlotte Ulrikka","Boye, Henriette","Larsen, Pia Veldt","Christesen, Henrik Thybo","Andersen, Marianne Skovsager","Jensen, Tina Kold","Bilenberg, Niels"],"cuid":["S02-087.93-012781"],"filters":{"added":"2022-09","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Hulgaard, Ditte","Hulgaard, Ditte Roth"],"keyword":["Anxiety epidemiology","COVID 19 epidemiology","Child","Child Preschool","Cohort Studies","Communicable Disease Control","Coronavirus","Covid 19","Denmark epidemiology","Family","Female","Health anxiety","Humans","Pregnancy"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-SDR","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"health anxiety symptoms in danish children during the first lockdown period of the covid 000000000019 pandemic an odense child cohort study","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85116355477","version":"Other Version"},"id":"S02-087.93-012781","identifier":[{"id":"85116355477","type":"scopus"},{"id":"34591725","type":"pmid"}],"ids":["au-0293cd0d-f2d6-443b-97be-d76edc53d490","sdu-3e79568b-8686-4b8b-8fe2-6a99e8da6d4d"],"keyword":["Anxiety/epidemiology","COVID-19","COVID-19/epidemiology","Child, Preschool","Cohort Studies","Communicable Disease Control","Denmark/epidemiology","Female","Humans","Pregnancy","child","coronavirus","family","health anxiety"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-874D45CE09E1D27AE812730AD7448D8F"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, Research Unit of Child and Adolescent Psychiatry (Southern Denmark)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Psychiatric Hospital for Children and Adolescents"],"nora_code":"DI-U-AU","used":1},{"affno":"3","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Region of Southern Denmark"],"nora_code":"DI-HO-SDR","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Ditte","key":"hulgaardpau","last":"Hulgaard","locid":"81c52a78-c0f9-4c82-ac1e-e3aa143962ec","name":"Hulgaard, Ditte Roth","name_org":"Hulgaard, Ditte","orcid":"0000-0002-5301-5295","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Charlotte Ulrikka","key":"raskpau","last":"Rask","locid":"1e308742-df61-47da-83ce-53d8a7c774c3","name":"Rask, Charlotte Ulrikka","orcid":"0000-0002-7426-0353","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henriette","key":"boyepau","last":"Boye","locid":"d2a9e83c-c23b-4f6c-97b9-5a0426ff4ce5","name":"Kyhl, Henriette Boye","name_org":"Boye, Henriette","orcid":"0000-0002-6290-2478","rank":3,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"first":"Pia Veldt","key":"larsenpau","last":"Larsen","locid":"d6c16700-b7c7-4172-a8df-3e726624dc36","name":"Larsen, Pia Veldt","orcid":"0000-0002-8730-3703","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik Thybo","key":"christesenpau","last":"Christesen","locid":"c8317e72-7a09-4c80-81e9-b69855b68e8f","name":"Christesen, Henrik Thybo","orcid":"0000-0001-5330-6853","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Marianne Skovsager","key":"andersenpau","last":"Andersen","locid":"94aa4e0a-b026-469f-a635-4bad008d49d7","name":"Andersen, Marianne","name_org":"Andersen, Marianne Skovsager","orcid":"0000-0002-4603-9504","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Tina Kold","key":"jensenpau","last":"Jensen","locid":"50e57e0b-3ce7-4b7d-9d24-125d84b7a62d","name":"Jensen, Tina Kold","orcid":"0000-0003-2311-5778","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Niels","key":"bilenbergpau","last":"Bilenberg","locid":"c865af0f-affd-44a4-b9fa-39c26141d3e2","name":"Bilenberg, Niels","orcid":"0000-0002-5838-556X","rank":8,"rolecode":"pau"}],"pmid":["34591725"],"pub":{"doi":"10.1080/08039488.2021.1970804","issn":["08039488","08039496"],"issn_org":["08039488"],"issue":"5","journal":"Nordic Journal of Psychiatry","pages":"330-337","publisher":"Taylor and Francis Ltd.","status":"p","title":"Nordic Journal of Psychiatry","volume":"76"},"review":"Peer Reviewed","scoID":["2-s2.0-85116355477"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-0293cd0d-f2d6-443b-97be-d76edc53d490","sdu-3e79568b-8686-4b8b-8fe2-6a99e8da6d4d"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Health anxiety symptoms in Danish children during the first lockdown period of the COVID-19 pandemic : an Odense Child Cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-087.93-012781","year":"2022","yearsub":"2022"}
{"abstract":"BACKGROUND: Avoidable appointments and increasing incidence of inflammatory bowel disease (IBD) call for alternative ways of organizing outpatient visits. In controlled studies, telemedicine including patient reported outcome (PRO) has shown to improve outcomes in IBD and reduce health care utilization. However, we lack studies of telemedicine implemented in everyday practice. We therefore described use of a PRO-based telemedicine follow-up (AmbuIBD) in a real-life setting and investigated the effect on outpatient visits and hospital admissions. METHODS: We conducted a cohort study including patients with IBD in an outpatient clinic at a Danish regional hospital August 2018. Data included extracts from the Patient Administration System and the AmbuFlex system between 2017 and August 2018, plus questionnaire data from clinicians. Descriptive statistics were used to describe use of AmbuIBD and differences between before and after results were tested with Wilcoxon's signed-rank test. RESULTS: Of 848 patients in outpatient care, 77% were included in AmbuIBD. Most patients were set to answer a PRO questionnaire once a year (n = 407, 62%), and 66% of 1913 answered questionnaires were handled with no further contact. AmbuIBD was well accepted by clinicians. Outpatient visits the year after AmbuIBD compared to the year before were reduced with 14% (p ≤ .001). The largest reduction was for patients with mild or no disease activity (45%, p ≤ .001). No difference was found for hospital admissions. CONCLUSIONS: AmbuIBD is feasible and well accepted when implemented in an outpatient clinic. More than half of patients are only followed by questionnaire, and we found a reduction in outpatient visits.","author_count":4,"contributors":["Appel, Charlotte Weiling","Pedersen, Sarah Christine","Nielsen, Amalie Søgaard","Larsen, Birgit Furstrand"],"cuid":["S02-098.00-022543"],"filters":{"added":"2022-07","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"continent":["OECD","Oceania"],"country":["Australia"],"glorg":["All Global Affiliations","Deakin University"],"keyword":["E health","Inflammatory bowel disease","Patient reported outcome measure","Telemedicine"],"level":"sci","mra":["hum","med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"telemedicine based on patient reported outcomes in management of patients with inflammatory bowel disease in a real life setting a before and after cohort study","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85125835014","version":"Other Version"},"id":"S02-098.00-022543","identifier":[{"id":"35195491","type":"pmid"},{"id":"85125835014","type":"scopus"},{"id":"000760096300001","type":"wos"}],"ids":["au-8793f7f2-b7b2-412b-9e69-66f01a273b3d","ku-5d96ba99-9ca8-4df0-b7b5-83fa1af45579"],"keyword":["Inflammatory bowel disease","e-health","optimized patient pathway","patient-reported outcome measure","telemedicine"],"lang":"English","level":"Scientific","mra":["Humanities","Medical Science"],"noi":["Global-Local-2-5-41556D1608524282D3512DDDD0FF57F0"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Diagnostisk Center, Universitetsklinik for Innovative Patientforløb, Silkeborg"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Section of Health Services Research"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"au","key":"deakin university","loc":["Australia","Oceania","OECD"],"name":"Deakin University","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Charlotte W","key":"appelpau","last":"Appel","locid":"0d1db098-5494-4dd5-ad41-6c2d6a36a9e4","name":"Appel, Charlotte Weiling","name_org":"Appel, Charlotte W","orcid":"0000-0003-0397-9739","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sarah Christine","key":"pedersenpau","last":"Pedersen","locid":"4578f89a-d4e5-4ca5-bba9-8176042c4e4c","name":"Pedersen, Sarah Christine","rank":2,"rolecode":"pau"},{"affno":"2 3","first":"Amalie Søgaard","key":"nielsenpau","last":"Nielsen","locid":"1e0e8e88-821d-4c48-a563-7afe883f8e9b","name":"Nielsen, Amalie Søgaard","orcid":"0000-0002-2884-3902","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Birgit Furstrand","key":"larsenpau","last":"Larsen","locid":"2d816040-cec1-44f7-ac67-adf16438df62","name":"Larsen, Birgit Furstrand","rank":4,"rolecode":"pau"}],"pmid":["35195491"],"pub":{"doi":"10.1080/00365521.2022.2041083","issn":["00365521","15027708"],"issn_org":["00365521"],"issue":"7","journal":"Scandinavian Journal of Gastroenterology","pages":"825-831","publisher":"Informa Healthcare","status":"p","title":"Scandinavian Journal of Gastroenterology","volume":"57"},"review":"Peer Reviewed","scoID":["2-s2.0-85125835014"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-8793f7f2-b7b2-412b-9e69-66f01a273b3d","ku-5d96ba99-9ca8-4df0-b7b5-83fa1af45579"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Telemedicine based on patient-reported outcomes in management of patients with inflammatory bowel disease in a real-life setting - a before and after cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-098.00-022543","year":"2022","yearsub":"2022"}
{"abstract":"Background and purpose — Despite increased attention to and acceptance of fast-track procedures, there is a lack of studies concerning discharge on the day of surgery (DOS) following total knee arthroplasty (SD-TKA). We evaluated the feasibility of SD-TKA, and compared safety and patient-reported outcomes (PROs) between patients undergoing SD-TKA and patients undergoing standard TKA. Patients and methods — A SD-TKA group (n = 101) was matched 1:1 to a standard TKA group (n = 101) on age, sex, and ASA score. Feasibility (being discharged on DOS), safety (unplanned contacts and complications evaluated by telephone calls (2 weeks), outpatient visits (2 weeks), and readmission (90 days)) were assessed. Further, Oxford Knee Score (OKS) and Visual Analogue Scale (VAS) (pain at rest and activity) were reported (90 days). Results — 89 of 101 SD-TKA patients were discharged on DOS. The number of telephone calls (≤ 83) and outpatient visits (12) were similar in the 2 groups. The number of read-missions was ≤ 3 in both groups, and only 1 of the readmis-sions was related to TKA surgery. No differences were found at 90-day follow-up in terms of OKS (34 in both groups) or VAS (rest: SD-TKA = 7 and standard TKA = 8; activity: SD-TKA = 17 and standard TKA = 15). Interpretation — SD-TKA is feasible in a selected group of patients, and safety and PROs are comparable to patients undergoing standard TKA.","author_count":10,"contributors":["Schmidt, Anne Mette","Garval, Mette","Gromov, Kirill","Holm, Carsten","Larsen, Jens Rolighed","Runge, Charlotte","Vase, Morten","Mikkelsen, Lone Ramer","Mortensen, Louise","Skou, Søren T."],"cuid":["S03-099.56-016318"],"filters":{"added":"2022-07","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"corresponding_author":["Schmidt, Anne Mette"],"keyword":["Arthroplasty Replacement Knee adverse effects","Cohort Studies","Feasibility Studies","Humans","Patient Discharge","Patient Reported Outcome Measures"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"feasibility safety and patient reported outcomes 000000000090 days after same day total knee arthroplasty a matched cohort study","src":["au","ku","sdu"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.2340/17453674.2022.2807","version":"Published Version"},"id":"S03-099.56-016318","identifier":[{"id":"85131225779","type":"scopus"},{"id":"35642499","type":"pmid"}],"ids":["au-32d9a6b4-6dc5-411a-a375-763b5fc641de","ku-8e05f75a-a4a9-48a3-a791-dd16f038ae15","sdu-78acfc6b-93b5-437c-a9a9-1552f6ce869e"],"keyword":["Arthroplasty, Replacement, Knee/adverse effects","Cohort Studies","Feasibility Studies","Humans","Patient Discharge","Patient Reported Outcome Measures"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-5F3CE5B0EAC64B29BD6215E1050CCFED"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://curis.ku.dk/ws/files/325710493/16140_SCHMIDT_D.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.2340/17453674.2022.2807","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/202980273/document_2_.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus Un