niversity of Denmark","namevar":["Technical University of Denmark, National Veterinary Institute","Technical University of Denmark, National Veterinary Institute, Division for Diagnostics & Scientific Advice, Virology"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"us","key":"st jude children s research hospital","loc":["United States","America, North","OECD"],"name":"St. Jude Children’s Research Hospital","used":1},{"affno":"3","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["Ceva Animal Health A/S"],"nora_code":"DI-PR-OTH","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Charlotte Kristiane","key":"hjulsagercharlottekristianepau","last":"Hjulsager","locid":"6c1511ef-8211-4653-8c81-cd55b7f63f64","name":"Hjulsager, Charlotte Kristiane","orcid":"0000-0001-7557-8876","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars Erik","key":"larsenlarserikpau","last":"Larsen","locid":"09c2a33d-b353-44de-a850-f3c7dec879cb","name":"Larsen, Lars Erik","orcid":"0000-0003-0730-5555","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper Schak","key":"krogjesperschakpau","last":"Krog","locid":"1e238a71-3075-4303-91fe-3cedb620123d","name":"Krog, Jesper Schak","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Malene Rask","key":"andersenmaleneraskpau","last":"Andersen","locid":"ce6a426a-d9ea-49f8-81c9-ecfaad79d315","name":"Andersen, Malene Rask","orcid":"0000-0001-7333-2653","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"John","key":"franksjohnpau","last":"Franks","name":"Franks, John","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Michael A.","key":"larsenmichaelapau","last":"Larsen","name":"Larsen, Michael A.","rank":6,"rolecode":"pau"},{"affno":"2","correspon