n":[{"affno":"1","corresponding":null,"country":"dk","first":"Charlotte Rørdam","key":"larsenped","last":"Larsen","locid":"4e604018-2471-4a68-a18b-0ae187425b3d","name":"Larsen, Charlotte Rørdam","orcid":"0000-0002-5465-0338","rank":1,"role":"Editor","rolecode":"ped"},{"affno":"2","corresponding":null,"first":"Morten","key":"michelsenped","last":"Michelsen","name":"Michelsen, Morten","rank":2,"role":"Editor","rolecode":"ped"},{"affno":"2","corresponding":null,"first":"Annemette","key":"kirkegaardped","last":"Kirkegaard","name":"Kirkegaard, Annemette","rank":3,"role":"Editor","rolecode":"ped"},{"affno":"1","corresponding":null,"country":"dk","first":"Henrik","key":"bødkerped","last":"Bødker","locid":"b3166ca8-1773-4f72-a9a8-b2b7bad228d8","name":"Bødker, Henrik","rank":4,"role":"Editor","rolecode":"ped"},{"affno":"","corresponding":null,"first":"Gestur","key":"gudmundssonped","last":"Gudmundsson","locid":"10e0bb2a-504a-442a-97e0-f476cd9308ba","name":"Gudmundsson, Gestur","rank":5,"role":"Editor","rolecode":"ped"},{"affno":"3","corresponding":null,"first":"Lisbeth Wegener","key":"ihlemannped","last":"Ihlemann","name":"Ihlemann, Lisbeth Wegener","rank":6,"role":"Editor","rolecode":"ped"}],"pub":{"isbn":["9788776746681"],"issn":["16025962"],"pages":"527","publisher":"Syddansk Universitetsforlag","series":"University of Southern Denmark Studies in History and Social Sciences","status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-dbee5432-f6fa-4714-abf6-d7c285ab48c1"],"src":["AU Aarhus University"],"title":"Rock i Danmark : Studier i populærmusik fra 1950'erne til årtusindskiftet","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-254862","year":"2013","yearsub":"2013"}
{"abstract":"Porcine Reproductive and Respiratory Syndrome (PRRS) caused by the PRRS virus (PRRSV) is considered one of the most devastating swine diseases worldwide. PRRS viruses are divided into two major genotypes, Type 1 and Type 2, with pronounced diversity between and within the genotypes. In Denmark more than 50% of the herds are infected with Type 1 and/or Type 2 PRRSV. The main objective of this study was to examine the genetic diversity and drift of Type 1 viruses in a population with limited introduction of new animals and semen. A total of 43 ORF5 and 42 ORF7 nucleotide sequences were obtained from viruses collected from 2003 to February 2013. Phylogenetic analysis of ORF5 nucleotide sequences showed that the Danish isolates formed two major clusters within the subtype 1. The nucleotide identity to the subtype 1 protogenotype Lelystad virus (LV) spanned 84.9–98.8% for ORF5 and 90.7–100% for ORF7. Among the Danish viruses the pairwise nucleotide identities in ORF5 and ORF7 were 81.2–100% and 88.9–100%, respectively. Sequencing of the complete genomes, including the 5′- and 3′-end nucleotides, of 8 Danish PRRSV Type 1 showed that the genome lengths differed from 14,876 to 15,098 nucleotides and the pairwise nucleotide identity among the Danish viruses was 86.5–97.3% and the identity to LV was 88.7–97.9%. The study strongly indicated that there have been at least two independent introductions of Type 1 PRRSV in Denmark and analysis of the full genomes revealed a significant drift in several regions of the virus.","author_count":5,"contributors":["Kvisgaard, Lise Kirstine","Hjulsager, Charlotte Kristiane","Kristensen, Charlotte","Lauritsen, Klara Tølbøl","Larsen, Lars Erik"],"cuid":["S01-000.00-311939"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Complete genome","NSP2","PRRSV"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-AAF","DI-PR-ALL"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-PR-AAF","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"genetic and antigenic characterization of complete genomes of type 000000000001 porcine reproductive and respiratory syndrome viruses prrsv isolated in denmark over a period of 000000000010 years","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/60426757/1_s2.0_S0168170213003560_main.pdf","version":"Published Version"},"id":"S01-000.00-311939","identifier":[{"id":"24153055","type":"pmid"},{"id":"84888199241","type":"scopus"}],"ids":["dtu-1876c62c-3de4-43cb-bb3b-7eca52c71d60"],"keyword":["Complete genome","Genotype 1/Type 1","NSP2","ORF5","PRRSV"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-86CF01B641EF23F565A2E0B2C158CE40"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/60426757/1_s2.0_S0168170213003560_main.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.virusres.2013.10.009","version":"Other Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Veterinary Institute","Technical University of Denmark, National Veterinary Institute, Section for Virology"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"danish agriculture food council","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-AAF","l3nl":"Danish Agriculture & Food Council","l3nn":"Danish Agriculture & Food Council","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Danish Agriculture & Food Council","namevar":["Danish Agriculture and Food Council"],"nora_code":"DI-PR-AAF","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Lise Kirstine","key":"kvisgaardpau","last":"Kvisgaard","locid":"58ce239f-6c30-44e0-ab54-f017a1821425","name":"Kvisgaard, Lise Kirstine","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Charlotte Kristiane","key":"hjulsagerpau","last":"Hjulsager","locid":"6c1511ef-8211-4653-8c81-cd55b7f63f64","name":"Hjulsager, Charlotte Kristiane","orcid":"0000-0001-7557-8876","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Charlotte","key":"kristensenpau","last":"Kristensen","name":"Kristensen, Charlotte","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Klara Tølbøll","key":"lauritsenpau","last":"Lauritsen","locid":"13169d33-175c-4684-abc2-3331fb5246c2","name":"Lauritsen, Klara Tølbøl","name_org":"Lauritsen, Klara Tølbøll","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars Erik","key":"larsenpau","last":"Larsen","locid":"09c2a33d-b353-44de-a850-f3c7dec879cb","name":"Larsen, Lars Erik","orcid":"0000-0003-0730-5555","rank":5,"rolecode":"pau"}],"pmid":["24153055"],"pub":{"doi":"10.1016/j.virusres.2013.10.009","issn":["01681702","09212590"],"issn_org":["01681702"],"issue":"2","journal":"Virus Research","pages":"197-205","publisher":"Elsevier","status":"p","title":"Virus Research","volume":"178"},"review":"Peer Reviewed","scoID":["2-s2.0-84888199241"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Danish Agriculture & Food Council","Private Research","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-1876c62c-3de4-43cb-bb3b-7eca52c71d60"],"src":["DTU Technical University of Denmark"],"title":"Genetic and antigenic characterization of complete genomes of Type 1 Porcine Reproductive and Respiratory Syndrome viruses (PRRSV) isolated in Denmark over a period of 10 years","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-311939","year":"2013","yearsub":"2013"}
{"abstract":"Aviær influenza (AI) virus indeholder 8 genom (RNA) segmenter, som koder for 13 proteiner. De mest variable proteiner er overflade glykoproteinerne hemagglutinin (HA) og neuraminidase (NA), der kodes af hhv. HA og NA genom segmenterne. HA og NA danner basis for subtypeklassificering af AI virus. Vilde vandfugle anses for at være den naturlige vært for AI virus, og i forbindelse med flere udbrud af højpatogen aviær influenza (HPAI) virus i fjerkræ er der fundet et tilsvarende lavpatogene aviær influenza (LPAI) virus i vilde vandfugle. AI virus kan spredes over lange afstande af vilde fugle, herunder potentielt også HPAI virus. Vilde fugle er derfor et oplagt mål for overvågning af AI virus, og Danmarks topologi med lange kyststrækninger og vadeområder er ideelle foder- og rastepladser for de mange vilde vandfugle, der trækker over Danmark eller overvintrer her.","author_count":5,"contributors":["Hjulsager, Charlotte Kristiane","Krog, Jesper Schak","Breum, Solvej Østergaard","Trebbien, Ramona","Larsen, Lars Erik"],"cuid":["S01-000.00-322484"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"com","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"nr","rtype":["clu"],"sorti":"molekylær karakterisering af influenzavirus fra vilde fugle i danmark i 000000002012","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dr","type-grp":["all","pub"]},"id":"S01-000.00-322484","ids":["dtu-3c26b112-f349-4af4-a420-90fbd190e1dc"],"lang":"English","level":"Commissioned","mra":["Science/Technology"],"noi":["Local-1-1-6FCC6E47EA23C1E19048E0F17BF203B4"],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Veterinary Institute"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Charlotte Kristiane","key":"hjulsagerpau","last":"Hjulsager","locid":"6c1511ef-8211-4653-8c81-cd55b7f63f64","name":"Hjulsager, Charlotte Kristiane","orcid":"0000-0001-7557-8876","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Schak","key":"krogpau","last":"Krog","locid":"1e238a71-3075-4303-91fe-3cedb620123d","name":"Krog, Jesper Schak","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Solvej Østergaard","key":"breumpau","last":"Breum","locid":"ef91abed-bcb7-4427-b534-982cec892366","name":"Breum, Solvej Østergaard","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ramona","key":"trebbienpau","last":"Trebbien","locid":"f5a78ced-77e8-4da1-950c-9c1992eac344","name":"Trebbien, Ramona","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars Erik","key":"larsenpau","last":"Larsen","locid":"09c2a33d-b353-44de-a850-f3c7dec879cb","name":"Larsen, Lars Erik","orcid":"0000-0003-0730-5555","rank":5,"rolecode":"pau"}],"pub":{"pages":"24","publisher":"National Veterinary Institute","status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-3c26b112-f349-4af4-a420-90fbd190e1dc"],"src":["DTU Technical University of Denmark"],"title":"Molekylær karakterisering af influenzavirus fra vilde fugle i Danmark i 2012","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-322484","year":"2013","yearsub":"2014"}
{"abstract":"Secondary metabolites are known to serve a wide range of specialized functions including communication, developmental control and defense. Genome sequencing of several fungal model species revealed that the majority of predicted secondary metabolite related genes are silent in laboratory strains, indicating that fungal secondary metabolites remain an underexplored resource of bioactive molecules. In this study, we combine heterologous expression of regulatory proteins in Aspergillus nidulans with systematic variation of growth conditions and observe induced synthesis of insect juvenile hormone-III and methyl farnesoate. Both compounds are sesquiterpenes belonging to the juvenile hormone class. Juvenile hormones regulate developmental and metabolic processes in insects and crustaceans, but have not previously been reported as fungal metabolites. We found that feeding by Drosophila melanogaster larvae induced synthesis of juvenile hormone in A. nidulans indicating a possible role of juvenile hormone biosynthesis in affecting fungal-insect antagonisms.","author_count":10,"contributors":["Nielsen, Morten Thrane","Klejnstrup, Marie Louise","Rohlfs, Marko","Anyaogu, Diana Chinyere","Hoof, Jakob Blæsbjerg","Gotfredsen, Charlotte Held","Andersen, Mikael Rørdam","Hansen, Bjarne Gram","Mortensen, Uffe Hasbro","Larsen, Thomas Ostenfeld"],"cuid":["S01-000.00-348492"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","University of Göttingen"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"em aspergillus nidulans em synthesize insect juvenile hormones upon expression of a heterologous regulatory protein and in response to grazing by em drosophila melanogaster em larvae","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/58394096/Aspergillus_nidulans_Synthesize.pdf","version":"Published Version"},"id":"S01-000.00-348492","identifier":[{"id":"23991191","type":"pmid"},{"id":"84883062002","type":"scopus"},{"id":"PMC3753258","type":"pmcid"}],"ids":["dtu-931f0fea-cf94-4e25-8fd7-15cc886a4a11"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-93A2E2C8E2FA6D21576497D44D160DF2"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/58394096/Aspergillus_nidulans_Synthesize.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1371/journal.pone.0073369","version":"Other Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Systems Biology"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"de","key":"university of göttingen","loc":["Germany","Europe, EU","OECD"],"name":"University of Göttingen","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Morten Thrane","key":"nielsenmortenthranepau","last":"Nielsen","locid":"bed32ea2-1208-4392-bbce-5784cefd2258","name":"Nielsen, Morten Thrane","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marie Louise","key":"klejnstrupmarielouisepau","last":"Klejnstrup","locid":"cee58d3a-0d8f-462a-b706-3a0ee9269f10","name":"Klejnstrup, Marie Louise","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Marko","key":"rohlfs