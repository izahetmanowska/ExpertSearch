{"author_count":9,"contributors":["Larsen, Martin Mørk","Feld, Louise","Jakobsen, Hans","Göke, Cordula","Hendriksen, Niels Bohse","Koefoed Rømer, Jonas","Mohn, Christian","Jensen, Annette Nygaard","Schultz, Anna Charlotte"],"cuid":["S02-095.67-013821"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["E coli","Fiskeri","Mikrobiologisk forurening","Muslinger","Sanitary survey","Toskallede bløddyr"],"level":"com","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-DTU"]},"level3all":["DI-U-AU","DI-U-DTU"]},"review":"nr","rtype":["clu"],"sorti":"sanitary survey rapport 000000000011 samsø bælt","src":["au","dtu"],"src-code":["DI-U-AU","DI-U-DTU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/196066263/TR153.pdf","version":"Published Version"},"id":"S02-095.67-013821","ids":["au-10e71d47-8c05-4620-b0b4-3f57d3c83686","dtu-8fbc8b7f-036b-4fdf-bb15-bccc9831ed70"],"keyword":["E. coli","Samsø Bælt","fiskeri","mikrobiologisk forurening","muslinger","sanitary survey","toskallede bløddyr"],"lang":"Danish","level":"Commissioned","mra":["Science/Technology"],"noi":["Local-1-2-F50A945266EA36F9E463CC248FE188E4"],"oa_link":[{"access":"oa","type":"rem","url":"https://dce2.au.dk/pub/TR153.pdf","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/196066263/TR153.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Ecoscience, Department of Ecoscience - Marine Diversity and Experimental Ecology"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Food Institute","Technical University of Denmark, National Food Institute, Research Group for Food Microbiology and Hygiene"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Martin Mørk","key":"larsenpau","last":"Larsen","locid":"d24cdbff-3543-4170-b95f-c315ce7477bb","name":"Larsen, Martin Mørk","orcid":"0000-0003-4331-8548","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Louise","key":"feldpau","last":"Feld","locid":"6f3799a8-1a83-45f3-b06e-2e8769481bb5","name":"Feld, Louise","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Hans","key":"jakobsenpau","last":"Jakobsen","locid":"115e2890-be07-49a8-a340-d271dd22ac2b","name":"Jakobsen, Hans","orcid":"0000-0001-9590-2362","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Cordula","key":"gökepau","last":"Göke","locid":"203ca293-fd97-4b16-8eba-24b61d042e20","name":"Göke, Cordula","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Niels Bohse","key":"hendriksenpau","last":"Hendriksen","locid":"50fd9962-24ef-4560-9838-1bb6da39e607","name":"Hendriksen, Niels Bohse","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jonas","key":"koefoedrømerpau","last":"Koefoed Rømer","locid":"02a85068-d9f1-4a76-a2f6-b5751937ada4","name":"Koefoed Rømer, Jonas","orcid":"0000-0002-8895-2529","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Christian","key":"mohnpau","last":"Mohn","locid":"3249f637-7852-40ab-b6ac-1b8670bcd9c9","name":"Mohn, Christian","orcid":"0000-0002-4331-1365","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Annette Nygaard","key":"jensenpau","last":"Jensen","locid":"45d88d2c-4bbc-4adf-8822-a0ddb19bbda6","name":"Jensen, Annette Nygaard","orcid":"0000-0001-9681-7258","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Anna Charlotte","key":"schultzpau","last":"Schultz","locid":"3a3d5130-acf6-4846-93e3-f3b891d83e60","name":"Schultz, Anna Charlotte","orcid":"0000-0003-1484-9120","rank":9,"rolecode":"pau"}],"pub":{"issn":["2244999X"],"issue":"153","pages":"90","publisher":"Aarhus Universitet, DCE - Nationalt Center for Miljø og Energi ©","publisher_org":"Aarhus Universitet, DCE – Nationalt Center for Miljø og Energi ©","repno":"Teknisk rapport fra DCE - Nationalt Center for Miljø og Energi. DCE Technical report, No. 153","series":"Teknisk rapport fra DCE - Nationalt Center for Miljø og Energi. DCE Technical report","status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["au-10e71d47-8c05-4620-b0b4-3f57d3c83686","dtu-8fbc8b7f-036b-4fdf-bb15-bccc9831ed70"],"src":["AU Aarhus University","DTU Technical University of Denmark"],"title":"Sanitary survey rapport 11: Samsø Bælt","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-095.67-013821","year":"2019","yearsub":"2019"}
{"abstract":"Background: Various physical work demands are shown to be associated with sickness absence. However, these studies have: (a) predominantly used self-reported data on physical work demands that have been shown to be inaccurate compared with technical measurements, (b) principally focused on various physical work demands in 'isolation', i.e. ignoring their co-dependency - compositional nature -, and (c) mainly used register data on long-term sickness absence. The present article describes the protocol of a study with the objective of investigating the association between technically measured compositional data on physical work demands and prospective long- and short-term register-based data on sickness absence. Methods: 'The technically measured compositional Physical wOrk DEmands and prospective association with register-based Sickness Absence study (PODESA)' comprises data from two Danish cohorts (NOMAD and DPhacto) primarily on blue-collar workers. In the PODESA cohort, data on 1108 workers were collected at baseline (between 2011 and 2014). The cohort data comprise, e.g., self-reported information on descriptives, lifestyle, workday, and health, as well as accelerometer-based measurements of physical work demands (physical activity, movements, and postures). These baseline measurements are linked with prospective register-based data on sickness absence for up to four years after baseline. The prospective association between physical work demands and sickness absence will be analysed using a Compositional Data Analysis approach. Discussion: PODESA provides a unique possibility of unravelling which combinations of physical work demands are associated with prospective sickness absence. PODESA employs technically measured information on physical work demands (taking into account the compositionality of physical work demand data) and prospective sickness absence data. The findings from PODESA can be used to develop strengthened preventive interventions for sickness absence. Results are expected in 2019-2021.","author_count":11,"contributors":["Dencker-Larsen, Sofie","Rasmussen, Charlotte Lund","Thorsen, Sannie Vester","Clays, Els","Lund, Thomas","Labriola, Merete","Mortensen, Ole Steen","Jørgensen, Marie Birk","Gupta, Nidhi","Rasmussen, Charlotte Diana Nørregaard","Holtermann, Andreas"],"cuid":["S04-090.68-767957"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"continent":["Europe, EU","OECD"],"corresponding_author":["Dencker-Larsen, Sofie"],"country":["Belgium"],"glorg":["All Global Affiliations","Department of Public Health, Ghent University, Belgium.","Ghent University"],"keyword":["Absenteeism","Accelerometers","Adult","Compositional data analysis CoDA","Denmark","Female","Humans","Male","Middle Aged","Occupational health","Occupations statistics numerical data","Physical activity at work","Prospective Studies","Self Report","Sick Leave","Sick Leave statistics numerical data","Time use epidemiology","Workplace statistics numerical data"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-WORK"],"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-ZEA"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-GV-WORK","DI-HO-CAP","DI-HO-ZEA","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"technically measured compositional physical work demands and prospective register based sickness absence podesa a study protocol","src":["au","ku","nfa","sdu"],"src-code":["DI-GV-WORK","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1186/s12889-019-6581-z","version":"Published Version"},"funding_acknowledgement":["The PODESA study is funded by the Danish Working Environment Research Fund (01-2015-09). The funders had no role in study design, data collection and analysis, decision to publish, or preparation of the manuscript."],"id":"S04-090.68-767957","identifier":[{"id":"000460524700002","type":"wos"},{"id":"PMC6398236","type":"pmcid"},{"id":"30832631","type":"pmid"},{"id":"85062412473","type":"scopus"}],"ids":["au-e7e3d469-3663-45ae-af7e-cacd02454554","ku-0292e608-9e81-461b-a651-48c5b675a96e","nfa-fb3d1ef6-c5f3-4761-a1a4-75965f69792a","sdu-e0202943-9ebd-46dc-8186-361ad65bfcaa"],"keyword":["Absenteeism","Accelerometers","Adult","Compositional data analysis (CoDA)","Denmark","Female","Humans","Male","Middle Aged","Occupational Health","Occupations/statistics & numerical data","Physical activity at work","Prospective Studies","Self Report","Sick Leave/statistics & numerical data","Sick-leave","Time-use epidemiology","Workplace/statistics & numerical data"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-7-CFCFE1C7481D82FBEB7A4D004435A819"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/146875962/s12889_019_6581_z.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/215130936/Technically_measured_compositional_physical_work_demands_and_prospective_register_based_sickness_absence_PODESA_.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1186/s12889-019-6581-z","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"nfa national research centre for the working environment","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-WORK","l3nn":"NFA National Research Centre for the Working Environment","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"NFA National Research Centre for the Working Environment","namevar":["The National Research Centre for the Working Environment","The National Research Centre for the Working