":"3","country":"us","key":"st jude children s research hospital","loc":["United States","America, North","OECD"],"name":"St. Jude Children’s Research Hospital","used":1}],"person":[{"affno":"1","first":"Charlotte","key":"kristensenpau","last":"Kristensen","locid":"39624808-4517-44fd-b288-2be379b5cf1a","name":"Kristensen, Charlotte","rank":1,"rolecode":"pau"},{"affno":"1","first":"Kasper","key":"pedersenpau","last":"Pedersen","locid":"2cf16ded-d875-4e57-84e3-534699092018","name":"Pedersen, Kasper","orcid":"0009-0002-0405-0489","rank":2,"rolecode":"pau"},{"affno":"1","first":"Denis","key":"selnihhinpau","last":"Selnihhin","locid":"66f56069-f723-48e6-850a-2d94fed44458","name":"Selnihhin, Denis","rank":3,"rolecode":"pau"},{"affno":"1","first":"Philipp P.","key":"petricpau","last":"Petric","locid":"b43373c6-2207-4302-8fa9-bd9c66877eba","name":"Petric, Philipp P.","rank":4,"rolecode":"pau"},{"affno":"2","first":"Ramona","key":"trebbienpau","last":"Trebbien","name":"Trebbien, Ramona","rank":5,"rolecode":"pau"},{"affno":"3","first":"Richard J.","key":"webbypau","last":"Webby","name":"Webby, Richard J.","rank":6,"rolecode":"pau"},{"affno":"1","first":"Lars Erik","key":"larsenpau","last":"Larsen","locid":"135a9407-d29c-4508-8f79-978f5b295a15","name":"Larsen, Lars Erik","orcid":"0000-0003-0730-5555","rank":7,"rolecode":"pau"},{"affno":"1","first":"Pia","key":"rythansenpau","last":"Ryt-Hansen","locid":"3bc2c20c-771a-4d73-9424-e1173143a632","name":"Ryt-Hansen, Pia","rank":8,"rolecode":"pau"},{"affno":"1","first":"Henrik Elvang","key":"jensenpau","last":"Jensen","locid":"20245e41-1eb4-4cfa-a2d6-e6851e101300","name":"Jensen, Henrik Elvang","orcid":"0000-0001-7277-7829","rank":9,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-da558c5a-d817-421b-a1c9-1a5365e6e081"],"src":["KU University of Copenhagen"],"title":"Influenza A virus receptors in the bovine and porcine mammary glands","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-830014","year":"2025","yearsub":"2025"}
{"abstract":"Background: Rubber accelerators found in rubber gloves may cause contact allergy and thus allergic contact dermatitis. Objectives: To investigate which doses of tetraethylthiuram disulfide (TETD) elicit allergic contact dermatitis by patch testing and in a repeated occluded application test simulating glove use. Patients and Methods: A multicentre study was conducted. Eight patients with contact allergy to TETD and eight controls comprised the study group. Doses of TETD 1% (400 μg/cm2), 0.33% (130 μg/cm2), 0.11% (44 μg/cm2), 0.037% (15 μg/cm2), 0.012% (4.9 μg/cm2), 0.0041% (1.6 μg/cm2) and pure vehicle (petrolatum) were used for the patch test. Doses of TETD 1% (39 μg/cm2), 0.33% (13 μg/cm2), 0.11% (4.3 μg/cm2) and pure vehicle (99:1 ethanol: water) were used for the repeated occluded application test. Results: Three patients (3/8) reacted to the lowest TETD dose of 0.0041% (1.6 μg/cm2) in the patch test. All patients reacted to all doses of TETD in the repeated occluded application test, none to the vehicle. The patch test dose of TETD that elicited allergic contact dermatitis in 10% of the patients (ED10) was estimated to be 0.75 μg/cm2. Conclusion: A content of 0.75 μg/cm2 TETD in rubber gloves may elicit allergic contact dermatitis. We suggest that future studies investigating contact allergy to rubber accelerators should base their methodology on the repeated occluded application test design presented in this study. Trial Registration: ClinicalTrial.gov identifier: NCT06042309.","author_count":7,"contributors":["Kursawe Larsen, Christoffer","Johansen, Jeanne D","Zachariae, Claus","Svedman, Cecilia","Bergendorff, Ola","Mortz, Charlotte G.","Schwensen, Jakob F.B."],"cuid":["S02-088.89-823012"],"filters":{"added":"2025-08","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","Nordic","OECD"],"corresponding_author":["Kursawe Larsen, Christoffer"],"country":["Sweden"],"glorg":["All Global Affiliations","Lund University","Skåne University Hospital"],"keyword":["Allergic contact dermatitis","Contact allergy","TETD","ZDEC","repeated occluded application test","rubber accelerator","tetraethylthiuram disulfide","zinc diethyldithiocarbamate"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"thresholds for contact allergy to a rubber accelerator tetd determined by serial dilution patch testing and a simulated glove use model","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1111/cod.14817","version":"Published Version"},"id":"S02-088.89-823012","identifier":[{"id":"40375756","type":"pmid"},{"id":"PMC12223932","type":"pmcid"},{"id":"105005222781","type":"scopus"}],"ids":["ku-a59099f7-b8d4-4ae0-9405-153fb1129aa9","sdu-f3562da6-a649-4c75-ace9-2ba0c7f7b942"],"keyword":["TETD","ZDEC","allergic contact dermatitis","contact allergy","repeated occluded application test","rubber accelerator","tetraethylthiuram disulfide","zinc diethyldithiocarbamate"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-EB559A2311D812825131668D2954C192"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/457146525/Contact_Dermatitis_-_2025_-_Kursawe_Larsen_-_Thresholds_for_Contact_Allergy_to_a_Rubber_Accelerator_TETD_Determined_by.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/295780854/Thresholds_for_Contact_Allergy_to_a_Rub...pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1111/cod.14817","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Herlev and Gentofte"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","country":"se","key":"lund university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Lund University","used":1},{"affno":"4","country":"se","key":"skåne university hospital","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Skåne University Hospital","used":1},{"affno":"5","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Dermatovenerology and allergy (Odense)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1 2","first":"Christoffer","key":"kursawelarsenpau","last":"Kursawe Larsen","name":"Kursawe Larsen, Christoffer","rank":1,"rolecode":"pau"},{"affno":"2 1","first":"Jeanne D.","key":"johansenpau","last":"Johansen","locid":"2caf86f2-1ce0-4314-835d-46bcfcf4e337","name":"Johansen, Jeanne D","name_org":"Johansen, Jeanne D.","rank":2,"rolecode":"pau"},{"affno":"2 1","first":"Claus","key":"zachariaepau","last":"Zachariae",