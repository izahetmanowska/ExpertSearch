","first":"Betina","key":"dybbroepau","last":"Dybbroe","locid":"4c2ac8a1-6760-4309-b823-59bff493de56","name":"Dybbroe, Betina","rank":3,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Mari","key":"holenpau","last":"Holen","locid":"f49069ca-ae6b-4b69-a8e9-a2179432aeae","name":"Holen, Mari","orcid":"0000-0002-9720-6608","rank":4,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Nicole","key":"thualagantpau","last":"Thualagant","locid":"fba2a225-fd0b-4d03-8c02-4dfc847d9ae7","name":"Thualagant, Nicole","orcid":"0000-0002-5197-8979","rank":5,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Iben Charlotte","key":"aamannpau","last":"Aamann","locid":"e9929153-ac32-4969-ba78-9a893db7adf4","name":"Aamann, Iben Charlotte","orcid":"0000-0001-7578-5568","rank":6,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Birgitta Nordenhof","key":"larsenpau","last":"Larsen","locid":"b5198dda-f67b-4ddd-9c33-33054c2c6b4f","name":"Larsen, Birgitta Nordenhof","rank":7,"rolecode":"pau"},{"affno":"","first":"Sine","key":"lehnchristiansenpedh","last":"Lehn-Christiansen","name":"Lehn-Christiansen, Sine","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Anne","key":"livengpedh","last":"Liveng","name":"Liveng, Anne","rank":9,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Betina","key":"dybbroepedh","last":"Dybbroe","name":"Dybbroe, Betina","rank":10,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Mari","key":"holenpedh","last":"Holen","name":"Holen, Mari","rank":11,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Nicole","key":"thualagantpedh","last":"Thualagant","name":"Thualagant, Nicole","rank":12,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Iben Charlotte","key":"aamannpedh","last":"Aamann","name":"Aamann, Iben Charlotte","rank":13,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Birgitta","key":"n