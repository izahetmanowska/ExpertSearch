9010","rank":2,"rolecode":"pau"},{"affno":"1","first":"Lars","key":"larsenpau","last":"Larsen","locid":"135a9407-d29c-4508-8f79-978f5b295a15","name":"Larsen, Lars Erik","name_org":"Larsen, Lars","orcid":"0000-0003-0730-5555","rank":3,"rolecode":"pau"},{"affno":"2","first":"Charlotte Kristiane","key":"hjulsagerpau","last":"Hjulsager","name":"Hjulsager, Charlotte Kristiane","rank":4,"rolecode":"pau"}],"pub":{"issn":["00459607"],"journal":"Dansk Erhvervsfjerkrae","pages":"46-48","status":"p","title":"Dansk Erhvervsfjerkrae","volume":"09"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-7d4f06a1-b445-42e0-a285-571cfbc875fe"],"src":["KU University of Copenhagen"],"title":"Udbrud af Newcastle disease i Danske duehold","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-810192","year":"2022","yearsub":"2022"}
{"abstract":"Background: Pneumococcal prime-boost vaccination is recommended for solid organ transplant recipients and candidates. The long-term durability of the antibody (AB) response is unknown. The same applies to a dose-dependent immune response. Methods: We studied the durability of the vaccine response after 18 months in kidney transplant recipients (KTRs) and patients on the kidney transplant waiting list (WLPs). Both groups received either a normal dose (ND) or a double dose (DD) of the 13-valent pneumococcal conjugate vaccine and the 23-valent pneumococcal polysaccharide vaccine. The average pneumococcal AB geometric mean concentration (GMC) was evaluated. A level ≥ 1 mg/L was considered protective against invasive pneumococcal disease (IPD). Results: Sixty WLPs and 70 KTRs were included. The proportion of participants protected declined from 52% to 33% in WLPs and from 29% to 16% in KTRs, with the previously significant dose-effect in WLPs no longer present (40% DD vs. 27% ND; p = 0.273). Average pneumococcal AB GMCs remained significantly above baseline levels (all groups p ≤ 0.001). Drug-induced immunosuppression diminished the vaccine dose-effect. Conclusions: At follow-up, the pneumococcal prime-boost vaccination still provided significantly elevated average pneumococcal AB GMCs in both populations. Though the proportion of participants protected against IPD in WLP-DD and WLP-ND were statistically comparable, a DD may still be recommended for WLPs (EudraCT: 2016-004123-23).","author_count":8,"contributors":["Larsen, Lykke","Bistrup, Claus","Sørensen, Søren Schwartz","Boesby, Lene","Jørgensen, Charlotte Sværke","Nielsen, Christian","Johansen, Isik Somuncu"],"cuid":["S02-097.86-042639"],"filters":{"added":"2022-09","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Larsen, Lykke"],"keyword":["Immunogenicity","Kidney transplant recipient"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-SDR","DI-HO-ZEA"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-HO-SDR","DI-HO-ZEA","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"durability of antibody response after primary pneumococcal double dose prime boost vaccination in adult kidney transplant recipients and candidates 000000000018 month follow up in a non blinded randomised clinical trial","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/vaccines10071091","version":"Published Version"},"id":"S02-097.86-042639","identifier":[{"id":"85137279818","type":"scopus"},{"id":"35891255","type":"pmid"},{"id":"PMC9323946","type":"pmcid"}],"ids":["ku-596a1948-8aba-460a-8ff7-cf5c5938828b","sdu-b7da5278-23af-46bb-b019-82b5017cf78c"],"keyword":["13-valent pneumococcal conjugate vaccine","23-valent pneumococcal polysaccharide","immunogenicity","kidney transplant recipient"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-E9120C2991EFAFBAB3C50A7D15D2A3E6"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/vaccines10071091","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/321822120/vaccines_10_01091_v2.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/205717795/vaccines_10_01091_v2.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Sou