GTS-DTCI","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anne-Charlotte","key":"johanssonpau","last":"Johansson","locid":"d3015f26-124b-4af0-ae58-aac640ebeec0","name":"Johansson, Anne-Charlotte Elisabeth Birgitta","name_org":"Johansson, Anne-Charlotte","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ren Bin","key":"yangpau","last":"Yang","name":"Yang, Ren Bin","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Bjarke Thomas","key":"dalsletpau","last":"Dalslet","locid":"8ce80c37-4519-406c-b250-5058a0b76e28","name":"Dalslet, Bjarke Thomas","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jackie Vincent","key":"larsenpau","last":"Larsen","locid":"1a230176-2f1e-4133-a820-8e549ac15d87","name":"Larsen, Jackie Vincent","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kaspar","key":"haumepau","last":"Haume","name":"Haume, Kaspar","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Leif H.","key":"christensenpau","last":"Christensen","name":"Christensen, Leif H.","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Erik Vilain","key":"thomsenpau","last":"Thomsen","locid":"822fe159-0932-4e5e-aeb6-b8b7f8421ab0","name":"Thomsen, Erik Vilain","orcid":"0000-0002-2772-926X","rank":7,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All GTS Institutes","All Universities","DI-ALL","DI-GTS","DI-GTS-ALL","DI-U","DI-U-ALL","GTS Institutes","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-9635f868-40b9-482b-a5a5-5ab2ac114e24"],"src":["DTU Technical University of Denmark"],"title":"Electrocatalytic Activity of Platinum Grown by Atomic Layer Deposition on Carbon Nanotubes for Si-Based DMFC Applications","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-349380","year":"2012","yearsub":"2012"}
{"abstract":"Influenza in mink (Neovison vison) is assumed to be rare, but several outbreaks have been described during recent years in Europe and the North America. In 2009, influenza A of the subtype H3N2 was detected in several Danish mink farms with respiratory symptoms. Full-genome sequencing showed that the virus was a human/swine reassortant, with the H and N gene most related to human H3N2 viruses circulating in 2005. The remaining 6 genes were most closely related to H1N2 influenza viruses circulating in Danish swine. This virus had not previously been described in swine, mink or humans. PCRs assays specifically targeting the new reassortant were developed and used to screen influenza positive samples from humans and swine in Denmark with negative results. Thus, there was no evidence that this virus had spread to humans or was circulating in Danish pigs. In 2010 and 2011, influenza virus was again diagnosed in diseased mink in a few farms. The genetic typing showed that the virus was similar to the pandemic H1N1 virus circulating in humans and swine. The H3N2 virus was not detected in 2010 and 2011. Taken together, these findings indicate that mink is highly susceptible for influenza A virus of human and swine origin and may therefore act as a potential host/reservoir for influenza A viruses.","author_count":14,"contributors":["Larsen, Lars Erik","Breum, Solvej Østergaard","Trebbien, Ramona","Bradstad, K.","Nielsen, L. P.","Chriél, Mariann","Jensen, Trine Hammer","Hjulsager, Charlotte Kristiane","Handberg, Kurt","Jørgensen, Poul Henrik","Harslund, Jakob le Fèvre","Rangstrup-Christensen, Lena","Petersen, B.","Hammer, Anne Sofie"],"cuid":["S01-000.00-356670"],"event":{"end":"2012-08-24","place":"Copenhagen, dk","start":"2012-08-21","title":"10th International Scientific Congress in fur animal production (IFASA 2012)","year":"2012"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-OT","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"OT":["Holstebro Veterinary Clinic"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-GV-SSI","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"outbreaks of influenza a virus in farmed mink neovison vison in denmark molecular characterization of the viruses","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3920/978-90-8686-760-8_21","version":"Other Version"},"id":"S01-000.00-356670","ids":["dtu-ae53a53b-f453-4a71-b217-9ed61c2f7ad3"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-C0A2A55EC24571AC816D46B0A7FE3426"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.3920/978-90-8686-760-8_21","version":"Other Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Veterinary Institute","Technical University of Denmark, National Veterinary Institute, Section for Virology"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"ssi statens serum institut","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-SSI","l3nn":"SSI Statens Serum Institut","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SSI Statens Serum Institut","namevar":["Statens Serum Institut"],"nora_code":"DI-GV-SSI","used":1},{"affno":"3","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Holstebro Veterinary Clinic"],"nora_code":"D