"affno":"1","corresponding":null,"first":"Jakob le Fèvre","key":"harslundpau","last":"Harslund","locid":"6263a80d-4976-4a84-a2c6-180de9d3a18b","name":"Harslund, Jakob le Fèvre","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lena","key":"rangstrupchristensenpau","last":"Rangstrup-Christensen","locid":"5f421c01-02a0-4cab-914c-999701851e2b","name":"Rangstrup-Christensen, Lena","rank":12,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"B.","key":"petersenpau","last":"Petersen","name":"Petersen, B.","rank":13,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anne Sofie","key":"hammerpau","last":"Hammer","locid":"78af063d-b05f-4a2b-b040-024f5c0cbcab","name":"Hammer, Anne Sofie","rank":14,"rolecode":"pau"}],"pub":{"doi":"10.3920/978-90-8686-760-8_21","eisbn":["9789086867608"],"pages":"153-156","publisher":"Wageningen Academic Publishers","status":"p","subtitle":"Scientifur volume 36 (3/4)","title":"Proceedings of the Xth International Scientific Congress in fur animal production"},"review":"Peer Reviewed","sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Miscellaneous","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Governmental Institutions","Miscellaneous","Other Research","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-ae53a53b-f453-4a71-b217-9ed61c2f7ad3"],"src":["DTU Technical University of Denmark"],"title":"Outbreaks of influenza A virus in farmed mink (Neovison vison) in Denmark: molecular characterization of the viruses","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-356670","year":"2012","yearsub":"2012"}
{"abstract":"With the aim of mapping the polyketome of A. nidulans we have made a library of strains, which individually overexpress PKS genes from an ectopic locus. A screen of this collection on different media demonstrated that AN6448 leads to production of 3-MOA. An inspection of the DNA sequence surrounding this gene uncovered a putative gene cluster including a gene, AN6446, with homology to transcription factors. Based on this observation, we decided to overexpress AN6446. A qRT-PCR analysis of this strain was used to delineate the borders of the gene cluster as well as to stimulate formation of cichorine and a number of new products, from the gene cluster. Subsequent deletion of all genes allowed several steps in the biosynthetic pathway in this cluster to be clarified.","author_count":10,"contributors":["Hoof, Jakob Blæsbjerg","Klejnstrup, Marie Louise","Khorsand-Jamal, Paiman","Holm, Dorte Koefoed","Nielsen, Michael Lynge","Boguta, Anna Monika","Rank, Christian","Gotfredsen, Charlotte Held","Larsen, Thomas Ostenfeld","Mortensen, Uffe Hasbro"],"cuid":["S01-000.00-363719"],"event":{"end":"2012-08-01","place":"New York, NY, us","start":"2012-07-28","title":"International Congress on Natural Products Research on Global Change, Natural Products and Human Health/8th Joint Meeting of AFERP, ASP, GA, PSE and SIF","year":"2012"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"characterization of the an000000006448 cluster in aspergillus nidulans","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1055/s-0032-1320546","version":"Other Version"},"id":"S01-000.00-363719","ids":["dtu-c610d3a3-be52-4679-a5f4-7655dc42ed65"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-FA7EE8304F5486915F3EF15811E7BA24"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1055/s-0032-1320546","version":"Other Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Systems Biology","Technical University of Denmark, Department of Systems Biology, Center for Microbial Biotechnology"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Jakob Blæsbjerg","key":"hoofjakobblæsbjergpau","last":"Nielsen","locid":"339ce5a8-3232-410d-9484-abbc0f5b81b3","name":"Hoof, Jakob Blæsbjerg","name_org":"Nielsen, Jakob Blæsbjerg","orcid":"0000-0002-7650-9300","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marie Louise","key":"klejnstrupmarielouisepau","last":"Klejnstrup","locid":"cee58d3a-0d8f-462a-b706-3a0ee9269f10","name":"Klejnstrup, Marie Louise","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Paiman","key":"khorsandjamalpaimanpau","last":"Khorsand-Jamal","locid":"44dc46fc-9cb2-4b17-a70c-9fd940e5ee73","name":"Khorsand-Jamal, Paiman","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Dorte Koefoed","key":"holmdortekoefoedpau","last":"Holm","locid":"aedc7b19-7dd8-4af4-a8cc-5a73f5783c91","name":"Holm, Dorte Koefoed","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Michael Lynge","key":"nielsenmichaellyngepau","last":"Nielsen","locid":"27cc27cc-9812-4aa4-bad7-82c5003012cf","name":"Nielsen, Michael Lynge","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anna Monika","key":"bogutaannamonikapau","last":"Kabat","locid":"b815eb93-a3eb-4504-9346-c0bcb558fbdc","name":"Boguta, Anna Monika","name_org":"Kabat, Anna Monika","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christian","key":"rankchristianpau","last":"Rank","locid":"a029c601-905d-45b9-bc98-4490dccfb4a2","name":"Rank, Christian","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Charlotte Held","key":"gotfredsencharlotteheldpau","last":"Gotfredsen","locid":"1cf4df84-2d0e-4693-bf47-e9932e3bf0e3","name":"Gotfredsen, Charlotte Held","orcid":"0000-0002-7386-119X","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"T. O.","key":"larsenthomasostenfeldpau","last":"Larsen","locid":"bd958d52-71b6-4720-b30a-cc9305633b43","name":"Larsen, Thomas Ostenfeld","name_org":"Larsen, T. O.","orcid":"0000-0002-3362-5707","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Uffe Hasbro","key":"mortensenuffehasbropau","last":"Mortensen","locid":"dec3038b-f004-4c96-84a1-52825e1c0ce8","name":"Mortensen, Uffe Hasbro","orcid":"0000-0002-7794-7273","rank":10,"rolecode":"pau"}],"pub":{"doi":"10.1055/s-0032-1320546","issn":["00320943","14390221"],"issn_org":["00320943"],"issue":"11","journal":"Planta Medica","pages":"1113-1113","publisher":"Georg Thieme Verlag","status":"p","title":"Planta Medica","volume":"78"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-c610d3a3-be52-4679-a5f4-7655dc42ed65"],"src":["DTU Technical University of Denmark"],"title":"Characterization of the AN6448 cluster in Aspergillus nidulans","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-363719","year":"2012","yearsub":"2012"}
{"abstract":"In 2011 a passive surveillance for influenza A virus was conducted in Danish swine. Tested samples were clinical samples from affected pigs submitted to the Danish National Veterinary Institute for swine influenza virus detection. In total 713 samples from 276 herds were analysed and about 24% of the samples were positive for swine influenza virus. All influenza positive samples were tested for the H1N1pdm09 virus by a real time RT-PCR assay specific for the pandemic HA gene and 26% of the samples were positive. Subtyping of 90 samples by sequencing revealed the presence of; i) H1N1 “avian like” viruses which have been circulating in Danish pigs since it was found for the first time in 1981. ii) H1N2 reassortant viruses which comprise HA from “avian like” H1N1 and NA from swine H3N2. The reassortant H1N2 virus was discovered in Danish pig for the first time in 2003 and is now well established in the Danish pig population. iii) H1N1pdm09 viruses which were found the first time in Danish pigs in January 2010. iv) Three new subtype variants comprising H1 “avian like” together with N2 “human like”, H1 pandemic with N2 “human like” and finally H1 pandemic with N2 from swine H3N2. The presence of N2 “human like” gene in Danish swine is new and genetic analysis indicate that it is most closely related to NA of human H3N2 viruses. In addition, full genome characterization of 40 viruses from the surveillance revealed the presence of additional new reassortments of which some have internal genes from the pandemic H1N1 virus. This study contribute significantly to our knowledge of the epidemiology of swine influenza A virus circulating in Danish swine and the potential role of swine in the emergence of novel reassortant viruses.","author_count":4,"contributors":["Breum, Solvej Østergaard","Hjulsager, Charlotte Kristiane","Trebbien, Ramona","Larsen, Lars Erik"],"cuid":["S01-000.00-363831"],"event":{"end":"2012-09-13","place":"Oxford, gb","start":"2012-09-11","title":"Influenza2012","year":"2012"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Reassortments","Swine influenza A virus"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"new influenza a virus reassortments have been found in danish swine in 000000002011","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-363831","ids":["dtu-c6672349-997e-44c4-933f-83335be95391"],"keyword":["Reassortments","Swine influenza A virus"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-77367041C3A00DF200454124C700B69E"],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Veterinary Institute","Technical University of Denmark, National Veterinary Institute, Section for Virology"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Solvej Østergaard","key":"breumpau","last":"Breum","locid":"ef91abed-bcb7-4427-b534-982cec892366","name":"Breum, Solvej Østergaard","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Charlotte Kristiane","key":"hjulsagerpau","last":"Hjulsager","locid":"6c1511ef-8211-4653-8c81-cd55b7f63f64","name":"Hjulsager, Charlotte Kristiane","orcid":"0000-0001-7557-8876","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ramona","key":"trebbienpau","last":"Trebbien","locid":"f5a78ced-77e8-4da1-950c-9c1992eac344","name":"Trebbien, Ramona","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars Erik","key":"larsenpau","last":"Larsen","locid":"09c2a33d-b353-44de-a850-f3c7dec879cb","name":"Larsen, Lars Erik","orcid":"0000-0003-0730-5555","rank":4,"rolecode":"pau"}],"pub":{"pages":"17-18","status":"p","subtitle":"Abstracts","title":"Influenza2012: One Influenza, One World under Podium"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-c6672349-997e-44c4-933f-83335be95391"],"src":["DTU Technical University of Denmark"],"title":"New influenza A virus reassortments have been found in Danish swine in 2011","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-363831","year":"2012","yearsub":"2012"}
{"abstract":"Introduction Real-time PCR tests have been developed to detect and quantify Porcine Circovirus type 2 (PCV2) and Lawsonia intracellularis in pigs’ faeces. Pooling of individual faecal samples is often used to reduce the costs of diagnostic testing. The objective of this study was to evaluate any change in the test sensitivity of PCV2 and L. intracellularis real-time PCR when individual faecal samples were pooled. Materials and Methods Forty eight faecal samples were collected from the rectum of individual pigs (>10 weeks) from four farms. Faecal samples were classified as diarrhoea +/- based on subjective assessment of consistency. Three individual samples were combined to make 16 pooled samples (8 diarrhoea; 8 non-diarrhoea). Individual and pooled samples were tested using real-time PCR tests specific for PCV2 and L. intracellularis. A positive result in any of the three individual samples was deemed “group positive”. Changes in test sensitivity after combining the three individual samples were evaluated. Results The sensitivity and specificity of the pooled faecal samples for L. intracellularis were 86.4% and 100%, respectively. The sensitivity and specificity of the pooled faecal samples for PCV2 were 97% and 100%, respectively. Conclusions These preliminary results suggest that three individual faecal samples may be pooled for PCV2 or L. intracellularis testing using real-time PCR with minimal loss of sensitivity. Under the conditions of this study, the sensitivity of pooling was reduced when quantities of L. intracellularis or PCV2 in individual samples were low.","author_count":10,"contributors":["Holyoake, Patricia K.","Hjulsager, Charlotte Kristiane","Larsen, Lars Erik","Pedersen, Ken S.","Johansen, Markku","Stege, Helle","Moore, Karen","Ståhl, Marie","Angen, Øystein","Nielsen, Jens Peter"],"cuid":["S01-000.00-364375"],"event":{"end":"2012-04-27","place":"Bruges, be","start":"2012-04-25","title":"4th European Symposium of Porcine Health Management","year":"2012"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["OECD","Oceania"],"country":["Australia"],"glorg":["All Global Affiliations","Department of Primary Industries, Queensland"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Danish Pig Production"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"you can pool faecal samples from individual pigs to test for porcine circovirus type 000000000002 and lawsonia intracellularis using real time pcrs","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/6484033/ESPHabstractpool12Dec11.pdf","version":"Pre-print"},"id":"S01-000.00-364375","ids":["dtu-c83c6ff6-1817-4f4b-a6e2-e0dfb07e6ee0"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-56B1E034FFE35FC9A1CC89E13266691A"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/6484033/ESPHabstractpool12Dec11.pdf","version":"Pre-print"}],"org":[{"affno":"1","country":"au","key":"department of primary industries queensland","loc":["Australia","Oceania","OECD"],"name":"Department of Primary Industries, Queensland","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Veterinary Institute","Technical University of Denmark, National Veterinary Institute, Division of Veterinary Diagnostics and Research","Technical University of Denmark, National Veterinary Institute, Division of Veterinary D