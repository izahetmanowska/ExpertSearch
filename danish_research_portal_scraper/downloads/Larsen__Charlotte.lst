Education"],"nora_code":"DI-U-AAU","used":1},{"affno":"3","country":"dk","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University"],"nora_code":"DI-U-RUC","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"Anja Hvidtfeldt","key":"stanekpau","last":"Stanek","locid":"ec09e7bb-72ab-4826-856b-dcf1b1f48d3a","name":"Stanek, Anja Hvidtfeldt","orcid":"0000-0002-2162-4619","rank":1,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Maja Røn","key":"larsenpau","last":"Larsen","name":"Larsen, Maja Røn","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Charlotte","key":"højholtpau","last":"Højholt","name":"Højholt, Charlotte","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Maja","key":"rønlarsenpau","last":"Røn Larsen","name":"Røn Larsen, Maja","rank":3,"rolecode":"pau"}],"pub":{"edition":"2. udgave, 2. oplag","isbn":["9788771184556"],"place":"Frederiksberg","publisher":"Frydenlund","status":"p"},"review":"No Review","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Roskilde University","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-461df70e-71f3-415d-a1f2-a145cd433b3e","sdu-aa57ba63-1179-4961-9c37-e5940d4cc308"],"src":["AAU Aalborg University","SDU University of Southern Denmark"],"title":"Børnefællesskaber - om de andre børns betydning : At arbejde med rummelighed og forældresamarbejde","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-092.50-822298","year":"2019","yearsub":"2019"}
{"abstract":"BACKGROUND AND OBJECTIVES: A substantial group of patients suffer from moderate to severe pain following elective total hip arthroplasty (THA). Due to the complex innervation of the hip, peripheral nerve block techniques can be challenging and are not widely used. Since the obturator nerve innervates both the anteromedial part of the joint capsule as well as intra-articular nociceptors, we hypothesized that an obturator nerve block (ONB) would decrease the opioid consumption after THA. METHODS: Sixty-two patients were randomized to receive ONB or placebo (PCB) after primary THA in spinal anesthesia. Primary outcome measure was opioid consumption during the first 12 postoperative hours. Secondary outcome measures included postoperative pain score, nausea score and ability to ambulate. RESULTS: Sixty patients were included in the analysis. Mean (SD) opioid consumption during the first 12 postoperative hours was 39.9 (22.3) mg peroral morphine equivalents (PME) in the ONB group and 40.5 (30.5) mg PME in the PCB group (p=0.93). No difference in level of pain or nausea was found between the groups. Paralysis of the hip adductor muscles in the ONB group reduced the control of the operated lower extremity compared with the PCB group (p=0.026). This did, however, not affect the subjects' ability to ambulate. CONCLUSIONS: A significant reduction in postoperative opioid consumption was not found for active versus PCB ONB after THA. TRIAL REGISTRATION NUMBER: NCT03064165 and 2017-000068-14.","author_count":9,"contributors":["Nielsen, Niels Dalsgaard","Runge, Charlotte","Clemmesen, Louise","Børglum, Jens","Mikkelsen, Lone Ramer","Larsen, Jens Rolighed","Nielsen, Thomas Dahl","Søballe, Kjeld","Bendtsen, Thomas Fichtner"],"cuid":["S02-099.93-016045"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Acute pain","Anatomy","CARE","Joint","Lower Extremity","Outcomes","Total knee arthroplasty"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-HO-CDR","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"an obturator nerve block does not alleviate postoperative pain after total hip arthroplasty a randomized clinical trial","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85067821144","version":"Other Version"},"id":"S02-099.93-016045","identifier":[{"id":"30679337","type":"pmid"},{"id":"000471156800006","type":"wos"},{"id":"85067821144","type":"scopus"}],"ids":["au-2f5b3275-04a5-4324-9243-3cfd234131f3","ku-83293319-5420-4b85-9cbb-88c824de2977"],"keyword":["ANATOMY","CARE","JOINT","OUTCOMES","TOTAL KNEE ARTHROPLASTY","acute pain","lower extremity","pain outcome measurement"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-681258AB8BCA538A8F7E7607833C564E"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Anaesthesiology and Operation, Intensive care","Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - University Clinic for Interdisciplinary Orthopaedic Pathways (UCOP)"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Regionshospitalet Silkeborg"],"nora_code":"DI-HO-CDR","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Anaesthesiology","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Niels Dalsgaard","key":"nielsennielsdalsgaardpau","last":"Nielsen","locid":"b84f99a8-73b7-49c6-b1da-3a1cd6288046","name":"Nielsen, Niels Dalsgaard","orcid":"0000-0002-5326-5729","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Charlotte","key":"rungecharlottepau","last":"Runge","locid":"eca83862-b388-4479-bc0b-c8a670ae52e9","name":"Runge, Charlotte","orcid":"0000-0001-9480-2490","rank":2,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Louise","key":"clemmesenlouisepau","last":"Clemmesen","locid":"ea2925c3-0124-4309-9571-f0667949af07","name":"Clemmesen, Louise","rank":3,"rolecode":"pau"},{"affno":"3","first":"Jens","key":"børglumjenspau","last":"Børglum","locid":"05892ca5-441c-4a91-9baf-aaa5619794ab","name":"Børglum, Jens","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lone Ramer","key":"mikkelsenloneramerpau","last":"Mikkelsen","locid":"940b3faf-11d1-4521-b24c-780c76c92701","name":"Mikkelsen, Lone Ramer","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens Rolighed","key":"larsenjensrolighedpau","last":"Larsen","locid":"485143af-239d-407f-96e4-f045733fa8c8","name":"Larsen, Jens Rolighed","orcid":"0000-0003-0694-0135","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Thomas Dahl","key":"nielsenthomasdahlpau","last":"Nielsen","locid":"aa09973e-37b0-478e-b063-52bba703e0da","name":"Nielsen, Thomas Dahl","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kjeld","key":"søballekjeldpau","last":"Søballe","locid":"288247bb-1768-4f37-a538-18727fed269b","name":"Søballe, Kjeld","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Thomas Fichtner","key":"bendtsenthomasfichtnerpau","last":"Bendtsen","locid":"089f9adf-ca15-47c2-bb41-1747197306b7","name":"Bendtsen, Thomas Fichtner","rank":9,"rolecode":"pau"}],"pmid":["30679337"],"pub":{"doi":"10.1136/rapm-2018-100104","issn":["10987339","15328651"],"issn_org":["10987339"],"issue":"4","journal":"Regional Anesthesia and Pain Medicine","pages":"466-471","publisher":"BMJ Publishing Group","status":"p","title":"Regional Anesthesia and Pain Medicine","volume":"44"},"review":"Peer Reviewed","scoID":["2-s2.0-85067821144"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-2f5b3275-04a5-4324-9243-3cfd234131f3","ku-83293319-5420-4b85-9cbb-88c824de2977"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"An Obturator Nerve Block does not Alleviate Postoperative Pain after Total Hip Arthroplasty : A Randomized Clinical Trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.93-016045","year":"2019","yearsub":"2019"}
{"abstract":"Insulin secretion from pancreatic beta-cells is dependent on zinc ions as essential components of insulin crystals, zinc transporters are thus involved in the insulin secretory process. Zip14 (SLC39a14) is a zinc importing protein that has an important role in glucose homeostasis. Zip14 knockout mice display hyperinsulinemia and impaired insulin secretion in high glucose conditions. Endocrine roles for Zip14 have been established in adipocytes and hepatocytes, but not yet confirmed in beta-cells. In this study, we investigated the role of Zip14 in the INS-1E beta-cell line. Zip14 mRNA was upregulated during high glucose stimulation and Zip14 silencing led to increased intracellular insulin content. Large-scale proteomics showed that Zip14 silencing down-regulated ribosomal mitochondrial proteins, many metal-binding proteins, and others involved in oxidative phosphorylation and insulin secretion. Furthermore, proliferation marker Mki67 was down-regulated in Zip14 siRNA-treated cells. In conclusion, Zip14 gene expression is glucose sensitive and silencing of Zip14 directly affects insulin processing in INS-1E beta-cells. A link between Zip14 and ribosomal mitochondrial proteins suggests altered mitochondrial RNA translation, which could disturb mitochondrial function and thereby insulin secretion. This highlights a role for Zip14 in beta-cell functioning and suggests Zip14 as a future pharmacological target in the treatment of beta-cell dysfunction.","author_count":10,"contributors":["Maxel, Trine","Smidt, Kamille","Petersen, Charlotte Christie","Honoré, Bent","Christensen, Anne Karina","Jeppesen, Per Bendix","Brock, Birgitte","Rungby, Jørgen","Palmfeldt, Johan","Larsen, Agnete"],"cuid":["S02-100.00-015178"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Association","DIABETIC PATIENTS","Identification","Liver","Metabolism","Mitochondrial DNA","Proliferation","Proteins","ZNT8"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-STENO"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-HO-STENO","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the zinc transporter zip000000000014 slc000000000039a000000000014 affects beta cell function proteomics gene expression and insulin secretion studies in ins 000000000001e cells","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41598-019-44954-1","version":"Published Version"},"id":"S02-100.00-015178","identifier":[{"id":"PMC6565745","type":"pmcid"},{"id":"000471219600005","type":"wos"},{"id":"85067351470","type":"scopus"},{"id":"31197210","type":"pmid"}],"ids":["au-237636eb-cd87-48cc-898f-b7bdd914acff","ku-385b1651-a5d2-4655-b244-32e707294372"],"keyword":["ASSOCIATION","DIABETIC-PATIENTS","IDENTIFICATION","IRON UPTAKE","LIVER","METABOLISM","MITOCHONDRIAL-DNA","PROLIFERATION","PROTEINS","ZNT8"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-E40EE065D21FD9E0921E9358C4AF4597"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/240633935/s41598_019_44954_1.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41598-019-44954-1","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University (AU)"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"ku university of