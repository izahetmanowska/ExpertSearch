{"author_count":12,"contributors":["Larsen, Bjarne F.","Werther, Inge","Magid, Jakob","Holdensen, Lars","Askegaard, Margrethe","Sørensen, Peter","Kyed, Sybile","Tersbøl, Michael","Sander Nielsen, Bruno","Scheutz, Charlotte","Olesen, Erik E.","Aagot Sckeri, Sune"],"cuid":["S01-000.00-333795"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"level":"com","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Brancheforeningen for Genanvendelse af Organiske Ressourcer til Jordbrugsformål"],"U":["DI-U-ALL","DI-U-AU","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-DTU","DI-U-KU"]},"review":"nr","rtype":["clu"],"sorti":"bedre adgang til næringsstoffer for økologer rapport fra arbejdsgruppen","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/128667229/Bedre_adgang_til_naeringsstoffer_for_oekologer_Rapport_fra_arbejdsgrup....pdf","version":"Published Version"},"id":"S01-000.00-333795","ids":["dtu-621af189-0db9-4c6b-b335-bad7d74185b4"],"lang":"Danish","level":"Commissioned","mra":["Science/Technology"],"noi":["Local-1-1-5486CBDEE6D6A4762C0D5E0EB6C6103A"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/128667229/Bedre_adgang_til_naeringsstoffer_for_oekologer_Rapport_fra_arbejdsgrup....pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University"],"nora_code":"DI-U-AU","used":1},{"affno":"3","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Environmental Engineering","Technical University of Denmark, Department of Environmental Engineering, Residual Resource Engineering"],"nora_code":"DI-U-DTU","used":1},{"affno":"4","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Brancheforeningen for Genanvendelse af Organiske Ressourcer til Jordbrugsformål"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"","corresponding":null,"first":"Bjarne F.","key":"larsenpau","last":"Larsen","name":"Larsen, Bjarne F.","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Inge","key":"wertherpau","last":"Werther","name":"Werther, Inge","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jakob","key":"magidpau","last":"Magid","name":"Magid, Jakob","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Lars","key":"holdensenpau","last":"Holdensen","name":"Holdensen, Lars","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Margrethe","key":"askegaardpau","last":"Askegaard","name":"Askegaard, Margrethe","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Peter","key":"sørensenpau","last":"Sørensen","name":"Sørensen, Peter","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Sybile","key":"kyedpau","last":"Kyed","name":"Kyed, Sybile","rank":7,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Michael","key":"tersbølpau","last":"Tersbøl","name":"Tersbøl, Michael","rank":8,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Bruno","key":"sandernielsenpau","last":"Sander Nielsen","name":"Sander Nielsen, Bruno","rank":9,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Charlotte","key":"scheutzpau","last":"Scheutz","locid":"48fe2850-fdc6-4282-9b97-ac5773419e5c","name":"Scheutz, Charlotte","orcid":"0000-0003-2218-5934","rank":10,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Erik E.","key":"olesenpau","last":"Olesen","name":"Olesen, Erik E.","rank":11,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Sune","key":"aagotsckeripau","last":"Aagot Sckeri","name":"Aagot Sckeri, Sune","rank":12,"rolecode":"pau"}],"pub":{"pages":"62","place":"København V","publisher":"Miljø- og Fødevareministeriet","status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-621af189-0db9-4c6b-b335-bad7d74185b4"],"src":["DTU Technical University of Denmark"],"title":"Bedre adgang til næringsstoffer for økologer Rapport fra arbejdsgruppen","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-333795","year":"2016","yearsub":"2017"}
{"abstract":"INTRODUCTION: Sexual assault is a public health issue with many potential short- and long-term consequences for the victims. We aimed to investigate somatic health of women before and after sexual assault. MATERIAL AND METHODS: We included 2501 women who attended the Centre for Victims of Sexual Assault in Copenhagen, and 10004 women without a known assault experience (controls). Somatic diagnoses were retrieved from the National Health Registry and number of visits to general practitioners from the Danish Health Insurance Registry. Somatic data were assessed during the five-year period before and after the assault. RESULTS: The incidence of several somatic disorders was found to be significantly higher for the exposed women than for controls, both before and after the assault. Rate ratios of main disorders before and after the assault were respectively: disease of circulatory and respiratory system: 3.2 (2.6-4.1) and 2.6 (2.1-3.2); epilepsy: 2.9 (2.2-3.8) and 4.1 (3.0-5.6) and disease of the liver: 3.5 (1.9-6.3) and 7.0 (4.4-11.1), respectively. The rate ratios of laparoscopic surgery: 1.5 (0.9-2.5) and 3.4 (2.3-5.0) and of cervical cancer: 0.8 (0.4-1.7) and 2.0 (1.4-3.0) increased significantly after sexual assault. Likewise, the number of visits to a general practitioner was significantly higher in exposed women both before and after the assault (16 vs. 10/year). Complications associated with childbirth were not statistically different between the groups. CONCLUSIONS: Our results suggest a higher somatic morbidity in women seen at a sexual assault center before as well as after the assault compared with controls.","author_count":4,"contributors":["Larsen, Mie-Louise","Hilden, Malene","Skovlund, Charlotte W","Lidegaard, Øjvind"],"cuid":["S01-000.00-478862"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Adolescent","Adult","Aged","Aged 80 and over","Case Control Studies","Child","Denmark","Female","Follow Up Studies","Humans","Journal Article","Middle Aged","Registries","Retrospective Studies","Sex Offenses","Women s health","Young Adult"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"somatic health of 000000002500 women examined at a sexual assault center over 000000000010 years","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-478862","identifier":[{"id":"84978100744","type":"scopus"},{"id":"27143091","type":"pmid"}],"ids":["ku-8ee31f1b-f86b-4c7a-b5d9-b52eb14d9f92"],"keyword":["Adolescent","Adult","Aged","Aged, 80 and over","Case-Control Studies","Child","Denmark","Female","Follow-Up Studies","Humans","Journal Article","Middle Aged","Registries","Retrospective Studies","Sex Offenses","Women's Health","Young Adult"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-E3166296391BAFC10A6193122B3E9DA2"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Mie-Louise","key":"larsenpau","last":"Larsen","name":"Larsen, Mie-Louise","rank":1,"rolecode":"pau"},{"affno":"","first":"Malene","key":"hildenpau","last":"Hilden","name":"Hilden, Malene","rank":2,"rolecode":"pau"},{"affno":"","first":"Charlotte W","key":"skovlundpau","last":"Skovlund","name":"Skovlund, Charlotte W","rank":3,"rolecode":"pau"},{"affno":"1","first":"Øjvind","key":"lidegaardpau","last":"Lidegaard","locid":"477519a8-a5d9-4dcf-970a-e11c7e4f936f","name":"Lidegaard, Øjvind","rank":4,"rolecode":"pau"}],"pmid":["27143091"],"pub":{"doi":"10.1111/aogs.12903","issn":["00016349"],"issue":"8","journal":"Acta Obstetricia et Gynecologica Scandinavica","pages":"872-8","status":"p","title":"Acta Obstetricia et Gynecologica Scandinavica","volume":"95"},"review":"Peer Reviewed","scoID":["2-s2.0-84978100744"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-8ee31f1b-f86b-4c7a-b5d9-b52eb14d9f92"],"src":["KU University of Copenhagen"],"title":"Somatic health of 2500 women examined at a sexual assault center over 10 years","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-478862","year":"2016","yearsub":"2016"}
{"abstract":"Sundhed larmer og opfordrer alle til livsstilsændringer. Risikoen for at få kræft larmer også. Hvis du ser TV, ved du, at du skal holde øje med tegn på kræft og gå til læge. Det er imidlertid en kompliceret opgave, fordi kræft opstår og udvikler sig i stilhed, psykosociale omstændigheder kan overdøve organismens tegn på kræft og symptomer, der nævnes i kampagnerne, er ikke altid symptomer på kræft. Kampagnerne larmer uden hensyn til modtagernes selvforståelse, livsfortællinger, følelser og psykosocialt angstforsvar.","author_count":8,"contributors":["Larsen, Birgitta Nordenhof"],"cuid":["S01-000.00-563412"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-RUC"]},"level3all":["DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"hold øje med kræft og gå til læge en kompliceret opgave","src":["ruc"],"src-code":["DI-U-RUC"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-563412","ids":["ruc-6f39b1cc-c01b-43f0-9526-f9225971b911"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-C86AFDDB07672407DFCD308F16A70ED7"],"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of People and Technology"],"nora_code":"DI-U-RUC","used":1}],"person":[{"affno":"1","country":"dk","first":"Birgitta Nordenhof","key":"larsenpau","last":"Larsen","locid":"b5198dda-f67b-4ddd-9c33-33054c2c6b4f","name":"Larsen, Birgitta Nordenhof","rank":1,"rolecode":"pau"},{"affno":"","first":"Sine","key":"lehnchristiansenpedh","last":"Lehn-Christiansen","name":"Lehn-Christiansen, Sine","rank":2,"role":"Editor of Host Publication","r