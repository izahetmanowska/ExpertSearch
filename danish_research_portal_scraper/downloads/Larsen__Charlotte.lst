me_org":"Nabe-Nielsen, K.","orcid":"0000-0002-4298-1420","rank":1,"rolecode":"pau"},{"affno":"1","first":"K. B.","key":"christensenpau","last":"Christensen","locid":"850a805f-c580-4858-822c-8e5c72ac780c","name":"Christensen, Karl Bang","name_org":"Christensen, K. B.","orcid":"0000-0003-4518-5187","rank":2,"rolecode":"pau"},{"affno":"","first":"N. V.","key":"fuglsangpau","last":"Fuglsang","name":"Fuglsang, N. V.","rank":3,"rolecode":"pau"},{"affno":"","first":"I.","key":"larsenpau","last":"Larsen","name":"Larsen, I.","rank":4,"rolecode":"pau"},{"affno":"1","first":"C. J.","key":"nilssonpau","last":"Nilsson","locid":"573fb3db-41df-4adf-86e6-e5b0c69a43ef","name":"Nilsson, Charlotte Juul","name_org":"Nilsson, C. J.","orcid":"0000-0002-3364-7412","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1093/eurpub/ckab164.014","issn":["11011262","1464360X"],"issn_org":["11011262"],"issue":"Supplement 3","journal":"European Journal of Public Health","pages":"9","status":"p","title":"European Journal of Public Health","volume":"31"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-6e8c445a-4a01-40e7-9b53-a6e7967a2ca9"],"src":["KU University of Copenhagen"],"title":"The effect of COVID-19 on schoolteachers' emotional reactions and mental health","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-459484","year":"2021","yearsub":"2021"}
{"abstract":"Objective: To examine the influence of socioeconomic status (SES) on long-term survival of non-localized ovarian cancer. Methods: All women in Denmark with a first diagnosis of non-localized epithelial ovarian cancer 1982–2007 were identified in the Cancer Registry and/or the Pathology Registry and followed up until December 2017. The survival probability was estimated after respectively 5 and 10 years, using so-called pseudo observations, and analyzed according to education, income, and marital status defined from nationwide registries. Results: The study cohort included 6486 women, and the estimated 5- and 10-year survival probabilities were 21.4% and 12.7%, respectively. Compared to women with short education, the 5-year survival probability was 7% higher for women with medium (relative survival probability = 1.07, 95% CI: 0.97, 1.19) and long education (relative survival probability = 1.07, 95% CI: 0.93, 1.24). Compared with married women, the 5-year survival probability for divorced women/widower was slightly lower (0.85, 95% CI: 0.69, 1.04) and for unmarried women slightly higher (1.08, 95% CI: 0.94, 1.23). Finally, the probability of being alive 5 years after diagnosis was 1.09 times higher (95% CI: 0.95, 1.24) for medium-income women and 1.23 times higher (95% CI: 1.08, 1.41) for high-income women compared with low-income women. Similar patterns were observed for 10-year survival. Conclusions: Non-localized ovarian cancer patients have a poor prognosis. Our data suggest that among Danish women with advanced ovarian cancer, higher personal income is associated with slightly higher probability of long-term survival, whereas education and marital status did not affect the probability of long-term survival.","author_count":5,"contributors":["Baandrup, Louise","Dehlendorff, Christian","Hertzum-Larsen, Rasmus","Hannibal, Charlotte Gerd","Kjaer, Susanne K."],"cuid":["S01-000.00-469088"],"filters":{"added":"2022-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Epithelial ovarian cancer","Long term survival","Socioeconomic status"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-NP","DI-U"],"level3":{"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-NP-CAN","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"prognostic impact of socioeconomic status on long term survival of non localized epithelial ovarian cancer the extreme study","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-469088","identifier":[{"id":"33583579","type":"pmid"},{"id":"85101016029","type":"scopus"}],"ids":["ku-7e51d0be-4cbe-425d-95d1-d8fcf4f824aa"],"keyword":["Epithelial ovarian cancer","Long-term survival","Non-localized","Socioeconomic status"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-B4522D0BE43D8E99411D5F62952F8A19"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"dk","key":"dcrc danish cancer society research center","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-CAN","l3nn":"DCRC Danish Cancer Society Research Center","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DCRC Danish Cancer Society Research Center","namevar":["Danish Cancer Society"],"nora_code":"DI-NP-CAN","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Obstetrics and Gynaecology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Louise","key":"baandruppau","last":"Baandrup","name":"Baandrup, Louise","rank":1,"rolecode":"pau"},{"affno":"1","first":"Christian","key":"dehlendorffpau","last":"Dehlendorff","name":"Dehlendorff, Christian","rank":2,"rolecode":"pau"},{"affno":"1","first":"Rasmus","key":"hertzumlarsenpau","last":"Hertzum-Larsen","name":"Hertzum-Larsen, Rasmus","rank":3,"rolecode":"pau"},{"affno":"1","first":"Charlotte Gerd","key":"hannibalpau","last":"Hannibal","name":"Hannibal, Charlotte Gerd","rank":4,"rolecode":"pau"},{"affno":"1 2","first":"Susanne K.","key":"kjaerpau","last":"Kjaer","locid":"1c671dbc-6a27-49fd-ba11-6d26a9a07047","name":"Kjaer, Susanne K.","rank":5,"rolecode":"pau"}],"pmid":["33583579"],"pub":{"doi":"10.1016/j.ygyno.2021.01.042","issn":["00908258","10956859"],"issn_org":["00908258"],"issue":"2","journal":"Gynecologic Oncology","pages":"458-462","status":"p","title":"Gynecologic Oncology","volume":"161"},"review":"Peer Reviewed","scoID":["2-s2.0-85101016029"],"search":{"DAF":["All Danish Affiliations","All Non-Profit Organisations","All Universities","DI-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Non-Profit Organisations","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-7e51d0be-4cbe-425d-95d1-d8fcf4f824aa"],"src":["KU University of Copenhagen"],"title":"Prognostic impact of socioeconomic status on long-term survival of non-localized epithelial ovarian cancer : The Extreme study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-469088","year":"2021","yearsub":"2021"}
{"abstract":"In recent years, there has been a considerable increase in the use of Modified Live PRRSV Vaccines (MLV) for mass vaccination in Denmark. The potential risks and negative impact of this strategy have been sparsely studied. The aim of this study was to investigate the impact of quarterly sow mass vaccination in two Danish sow herds. The study was performed as an observational prospective cohort of 120 sows in each of two commercial breeding herds in a paired design. Blood samples were taken from sows and oral fluid samples from nursery pigs (four to ten weeks old) before and after vaccination. The presence of PRRSV-1 RNA was measured by real time quantitative reverse transcription-polymerase chain reaction (RT-qPCR), and the level of PRRSV-1 specific antibodies was measured by two different serological assays. PRRS virus was not detected in the sow herds two days before and two weeks after vaccination, but the vaccine strain virus was detected in the nursery pigs. The prevalence of sows without antibodies towards PRRSV-1 went from 6–15% before vaccination to 1–4% after vaccination depending on the serological assay used, despite the fact that they had previously been repeatedly vaccinated. Four sows tested negative for antibodies in both assays after vaccination.","author_count":4,"contributors":["Pedersen, Kasper","Kristensen, Charlotte Sonne","Kvisgaard, Lise Kirstine","Larsen, Lars Erik"],"cuid":["S01-000.00-478067"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Immune response","Mass Vaccination","PRRSV"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-SEGES"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-PR-SEGES","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"impacts of quarterly sow mass vaccination with a porcine reproductive and respiratory syndrome virus type 000000000001 prrsv 000000000001 modified live vaccine in two herds","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/vaccines9101057","version":"Published Version"},"id":"S01-000.00-478067","identifier":[{"id":"PMC8537578","type":"pmcid"},{"id":"34696165","type":"pmid"},{"id":"85115988389","type":"scopus"}],"ids":["ku-8d8e22f2-4d23-4dc3-9c41-302c892752ed"],"keyword":["Immune response","Mass vaccination","PRRSV","Serological assay"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-8C59B7C59B969543ECD5D21239B4096F"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/vaccines9101057","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/281605192/vaccines_09_01057_v2.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"dk","key":"seges innovation","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-SEGES","l3nn":"SEGES Innovation","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SEGES Innovation","namevar":["Danish Pig Research Centre, SEGES (Biz)"],"nora_code":"DI-PR-SEGES","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary and Animal Sciences, Veterinary Clinical Microbiology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Kasper","key":"pedersenpau","last":"Pedersen","name":"Pedersen, Kasper","rank":1,"rolecode":"pau"},{"affno":"1","first":"Charlotte Sonne","key":"kristensenpau","last":"Kristensen","name":"Kristensen, Charlotte Sonne","rank":2,"rolecode":"pau"},{"affno":"2","first":"Lise Kirstine","key":"kvisgaardpau","last":"Kvisgaard","locid":"06d93bdc-8ddd-4561-8778-a8ffa2b5bd51","name":"Kvisgaard, Lise Kirstine","rank":3,"rolecode":"pau"},{"affno":"2","first":"Lars Erik","key":"larsenpau","last":"Larsen","locid":"135a9407-d29c-4508-8f79-978f5b295a15","name":"Larsen, Lars Erik","orcid":"0000-0003-0730-5555","rank":4,"rolecode":"pau"}],"pmid":["34696165"],"pub":{"doi":"10.3390/vaccines9101057","issn":["2076393X"],"issue":"10","journal":"Vaccines","paperid":"1057","status":"p","title":"Vaccines","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-85115988389"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Private Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-8d8e22f2-4d23-4dc3-9c41-302c892752ed"],"src":["KU University of Copenhagen"],"title":"Impacts of quarterly sow mass vaccination with a porcine reproductive and respiratory syndrome virus type 1 (Prrsv-1) modified live vaccine in two herds","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-478067","year":"2021","yearsub":"2021"}
{"abstract":"We investigated factors affecting avian influenza virus (AIV) detections in Danish wild birds using data from the passive and active AIV surveillance in wild birds from 2006-2020. We used this data and machine learning (ML) algorithms along with landscape and environmental variables to develop predictive models of AIV occurrence in Denmark. We furthermore assessed potential accessibility bias in the passive AIV surveillance data submitted by the public. The passive AIV surveillance data was biased regarding accessibility to areas compared to random locations within Denmark. ML models differed in their predictive power and were used to predict the risk of AIV presence throughout Denmark. Our results suggest that landscape variables may affect AIV presence and enabled us to create risk maps of AIV occurrence in Danish wild birds. This may aid future targeted surveillance efforts within Denmark.","author_count":7,"contributors":["Kjær, Lene Jung","Hjulsager, Charlotte","Larsen, Lars Erik","Boklund, Anette","Halasa, Tariq","Ward, Michael P.","Kirkeby, Carsten"],"cuid":["S01-000.00-506962"],"filters":{"added":"2023-04","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["OECD","Oceania"],"country":["Australia"],"glorg":["All Global Affiliations","University of Sydney"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-GV-SSI","DI-U-DTU","DI-U-KU"]},"review":"nr","rtype":["clu"],"sorti":"spatial patterns of avian influenza in wild birds from denmark 000000002006 000000002020","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-506962","ids":["ku-be31b5b3-6a67-4154-921a-9989240a1ead"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-59DE1715ACF89FF66606974B10CBD9BD"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary and Animal Sciences, Animal Welfare and Disease Control"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark"],"nora_code":"DI-U-DTU","used":1},{"affno":"3","country":"dk","key":"ssi statens serum institut","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-SSI","l3nn":"SSI Statens Serum Institut","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SSI Statens Serum Institut","namevar":["Statens Serum Institut"],"nora_code":"DI-GV-SSI","used":1},{"affno":"4","country":"au","key":"university of sydney","loc":["Australia","Oceania","OECD"],"name":"University of Sydney","used":1}],"person":[{"affno":"1","first":"Lene Jung","key":"kjærpau","last":"Kjær","locid":"b93ddd14-b340-4550-b3cf-eb9473b0d716","name":"Kjær, Lene Jung","orcid":"0000-0001-9659-4672","rank":1,"rolecode":"pau"},{"affno":"2 3","first":"Charlotte","key":"hjulsagerpau","last":"Hjulsager","name":"Hjulsager, Charlotte","rank":2,"rolecode":"pau"},{"affno":"1","first":"Lars","key":"larsenpau","last":"Larsen","locid":"135a9407-d29c-4508-8f79-978f5b295a15","name":"Larsen, Lars Erik","name_org":"Larsen, Lars","orcid":"0000-0003-0730-5555","rank":3,"rolecode":"pau"},{"affno":"1","first":"Anette","key":"boklundpau","last":"Boklund","locid":"b56cee2e-0320-4c3d-a360-6dc1f5b2ee67","name":"Boklund, Anette","orcid":"0000-0001-6359-3403","rank":4,"rolecode":"pau"},{"affno":"1","first":"Tariq","key":"halasapau","last":"Halasa","locid":"8eda71d3-00d4-4316-a46f-20be6613d7a7","name":"Halasa, Tariq","orcid":"0000-0003-1112-0254","rank":5,"rolecode":"pau"},{"affno":"4","first":"Michael P.","key":"wardpau","last":"Ward","name":"Ward, Michael P.","rank":6,"rolecode":"pau"},{"affno":"1","first":"Carsten","key":"kirkebypau","last":"Kirkeby","locid":"ea24c9a4-7aa6-40f3-9afb-0af19f1e962d","name":"Kirkeby, Carsten","orcid":"0000-0001-9292-5526","rank":7,"rolecode":"pau"}],"pub":{"eisbn":["9780948073601"],"publisher":"Society for Veterinary Epidemiology and Preventive Medicine","status":"p","subtitle":"Proceedings: Online, 24-26 March 2021","title":"Society for Veterinary Epidemiology and Preventive Medicine"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-be31b5b3-6a67-4154-921a-9989240a1ead"],"src":["KU University of Copenhagen"],"title":"Spatial patterns of avian influenza in wild birds from Denmark, 2006-2020","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-506962","year":"2021","yearsub":"2021"}
{"abstract":"Since the influenza pandemic in 2009, there has been an increased focus on swine influenza A virus (swIAV) surveillance. This paper describes the results of the surveillance of swIAV in Danish swine from 2011 to 2018. In total, 3800 submissions were received with a steady increase in swIAV positive submissions, reaching 56% in 2018. Full genome sequences were obtained from 129 swIAV positive samples. Altogether, 17 different circulating genotypes were identified including six novel reassortants harboring human seasonal IAV gene segments. The phylogenetic analysis revealed substantial genetic drift and also evidence of positive selection occurring mainly in antigenic sites of the hemagglutinin protein and confirmed the presence of a swine divergent cluster among the H lpdm09Nx (clade 1 A.3.3.2) viruses. The results provide essential data for the control of swIAV in pigs and emphasize the importance of contemporary surveillance for discovering novel swIAV strains posing a potential threat to the human population.","author_count":7,"contributors":["Ryt-Hansen, Pia","Krog, Jesper Schak","Breum, Solvej Østergaard","Hjulsager, Charlotte Kristiane","Pedersen, Anders Gorm","Trebbien, Ramona","Larsen, Lars Erik"],"cuid":["S01-000.00-522998"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-GV-SSI","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"co circulation of multiple influenza a reassortants in swine harboring genes from seasonal human and swine influenza viruses","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.7554/eLife.60940","version":"Published Version"},"id":"S01-000.00-522998","identifier":[{"id":"PMC8397370","type":"pmcid"},{"id":"34313225","type":"pmid"},{"id":"85111842611","type":"scopus"}],"ids":["ku-d8e5675c-bc64-4cc1-ae26-0412098b0225"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-9D138069868C5313815C807001DE5F6F"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.7554/eLife.60940","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/280181233/elife_60940_v2.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary and Animal Sciences, Veterinary Clinical Microbiology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"ssi statens serum institut","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-SSI","l3nn":"SSI Statens Serum Institut","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SSI Statens Serum Institut","namevar":["Statens Serum Institut"],"nora_code":"DI-GV-SSI","used":1},{"affno":"3","country":"dk","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","first":"Pia","key":"rythansenpau","last":"Ryt-Hansen","locid":"3bc2c20c-771a-4d73-9424-e1173143a632","name":"Ryt-Hansen, Pia","rank":1,"rolecode":"pau"},{"affno":"2","first":"Jesper Schak","key":"krogpau","last":"Krog","name":"Krog, Jesper Schak","rank":2,"rolecode":"pau"},{"affno":"2","first":"Solvej Østergaard","key":"breumpau","last":"Breum","name":"Breum, Solvej Østergaard","rank":3,"rolecode":"pau"},{"affno":"2","first":"Charlotte Kristiane","key":"hjulsagerpau","last":"Hjulsager","name":"Hjulsager, Charlotte Kristiane","rank":4,"rolecode":"pau"},{"affno":"3","first":"Anders Gorm","key":"pedersenpau","last":"Pedersen","name":"Pedersen, Anders Gorm","rank":5,"rolecode":"pau"},{"affno":"2","first":"Ramona","key":"trebbienpau","last":"Trebbien","name":"Trebbien, Ramona","rank":6,"rolecode":"pau"},{"affno":"1","first":"Lars Erik","key":"larsenpau","last":"Larsen","locid":"135a9407-d29c-4508-8f79-978f5b295a15","name":"Larsen, Lars Erik","orcid":"0000-0003-0730-5555","rank":7,"rolecode":"pau"}],"pmid":["34313225"],"pub":{"doi":"10.7554/elife.60940","issn":["2050084X"],"journal":"eLife","paperid":"e60940","status":"p","title":"eLife","volume":"10"},"review":"Peer Reviewed","scoID":["2-s2.0-85111842611"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-d8e5675c-bc64-4cc1-ae26-0412098b0225"],"src":["KU University of Copenhagen"],"title":"Co-circulation of multiple influenza a reassortants in swine harboring genes from seasonal human and swine influenza viruses","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-522998","year":"2021","yearsub":"2021"}
{"abstract":"Denne artikel vil på en gang gå ind i analyser af børns og unges forskellige betingelser for at deltage i hverdagslivets væsentlige fællesskaber – her tænkes på jævnaldrendes fællesskaber i og på tværs af skoler, institutioner og familie – og den vil analysere ulighed som knyttet netop til sociale situationer og adgang til fællesskabers ressourcer. Artiklen kommer derfor også til at præsentere teori om børn og unges ’livsførelse’, og om hvordan deres handlinger og måder at tage del ét sted – som fx klasseværelset – hænger sammen med deres betingelser for at få livet til at hænge sammen på tværs af steder og sammen med andre.","author_count":2,"contributors":["Højholt, Charlotte","Røn Larsen, Maja"],"cuid":["S01-000.00-562715"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-RUC"]},"level3all":["DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"fællesskaber og situeret ulighed om børns betingelser for indflydelse og udvikling af livsførelse","src":["ruc"],"src-code":["DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-562715","ids":["ruc-652427dd-34ac-4a63-93a7-cd9d2a74acab"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-1EF883E883A78198A8EA781CF461546B"],"oai":{"class":"Blocked","mra":["Humanities (HUM)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of People and Technology","Roskilde University, Department of People and Technology, Subject, Technology and Social Practice"],"nora_code":"DI-U-RUC","used":1}],"person":[{"affno":"1",