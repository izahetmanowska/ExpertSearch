ull,"country":"dk","first":"Elisabeth","key":"holmpau","last":"Holm","locid":"07c945b3-4fe0-496a-9734-095800683729","name":"Holm, Elisabeth","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Tim Kåre","key":"jensenpau","last":"Jensen","locid":"2b93571f-6d81-4827-b040-467f1dee1c12","name":"Jensen, Tim Kåre","orcid":"0000-0002-8048-4695","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Heidi","key":"enemarkpau","last":"Enemark","locid":"0e5ce9a6-44a2-4d11-9595-32d55ac94d84","name":"Enemark, Heidi L.","name_org":"Enemark, Heidi","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Charlotte Kristiane","key":"hjulsagerpau","last":"Hjulsager","locid":"6c1511ef-8211-4653-8c81-cd55b7f63f64","name":"Hjulsager, Charlotte Kristiane","orcid":"0000-0001-7557-8876","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anna Camilla","key":"birkegårdpau","last":"Birkegård","locid":"93c1a916-eb0a-4c7f-87bd-81e63890b8d6","name":"Birkegård, Anna Camilla","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Per Kantsø","key":"nielsenpau","last":"Nielsen","locid":"024a92e1-4499-4912-812a-9943d6fd8d83","name":"Nielsen, Per Kantsø","rank":9,"rolecode":"pau"}],"pub":{"pages":"24","status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-4338666f-4cff-4a83-b48a-3f85968c2f90"],"src":["DTU Technical University of Denmark"],"title":"Årsrapport for vildtsundhed 2013","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-324561","year":"2013","yearsub":"2014"}
{"abstract":"Danish farmed mink herds experienced a large outbreak of canine distemper virus in 2012. Full-length sequence analysis (1824 nucleotides) of the variable hemagglutinin (H) gene were performed on 27 viruses collected from mink and on 7 viruses collected from wild foxes. Results of the study showed that the farmed mink and wild fox population were infected by identical viruses which strongly indicate an epidemiological link between these populations. Accordingly, diseased and dead foxes were observed in some of the mink herds in connection to the outbreak. The Danish virus strain clustered phylogenetically with other European canine distemper viruses and showed the highest level of similarity (99.3 - 99.6 %) to viruses isolated from wild foxes in Germany. The fox should therefore be considered as an important wild life reservoir of canine distemper virus and may also contribute to the transmission of the virus between mink farms during outbreaks.","author_count":5,"contributors":["Trebbien, Ramona","Struve, T.","Hjulsager, Charlotte Kristiane","Chriél, Mariann","Larsen, Lars Erik"],"cuid":["S01-000.00-357914"],"event":{"end":"2013-08-30","place":"Reykjavik, is","start":"2013-08-28","title":"NJF Seminar 464 : Autumn Meeting in Fur Animal Research 2013","year":"2013"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-PR-OTH","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"genetic characterization of canine distemper virus involved in outbreaks in farmed mink in denmark 000000002012","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/56158499/prod21372762275840.CDV_Final_15042013_RamonaTrebbien.pdf","version":"Other Version"},"id":"S01-000.00-357914","ids":["dtu-b285bdb8-1c4a-44ec-adc4-03b7501453b5"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-41B4FC80B60D6341DD43CEC845B2A12E"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/56158499/prod21372762275840.CDV_Final_15042013_RamonaTrebbien.pdf","version":"Other Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Veterinary Institute","Technical University of Denmark, National Veterinary Institute, Section for Virology"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["Kopenhagen Fur"],"nora_code":"DI-PR-OTH","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Ramona","key":"trebbienpau","last":"Trebbien","locid":"f5a78ced-77e8-4da1-950c-9c1992eac344","name":"Trebbien, Ramona","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"T.","key":"struvepau","last":"Struve","name":"Struve, T.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Charlotte Kristiane","key":"hjulsagerpau","last":"Hjulsager","locid":"6c1511ef-8211-4653-8c81-cd55b7f63f64","name":"Hjulsager, Charlotte Kristiane","orcid":"0000-0001-7557-8876","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mariann","key":"chriélpau","last":"Chriél","locid":"1a5d6261-6bd2-4940-baab-5d5fcc3c0f7c","name":"Chriél, Mariann","orcid":"0000-0001-5306-4495","rank":4,"rol