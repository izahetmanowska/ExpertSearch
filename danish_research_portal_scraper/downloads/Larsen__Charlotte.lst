_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Tron Andre","key":"darvannpau","last":"Darvann","locid":"e6441aa5-e58c-42aa-a019-155b70e99415","name":"Darvann, Tron Andre","rank":1,"rolecode":"pau"},{"affno":"1","first":"Birgitta Louise Charlotte","key":"öwallpau","last":"Öwall","locid":"5d4b8594-db07-46ab-b50f-bff7a63dc797","name":"Öwall, Birgitta Louise Charlotte","rank":2,"rolecode":"pau"},{"affno":"1","first":"Nuno Vibe","key":"hermannpau","last":"Hermann","locid":"33295e42-e0f1-470f-a5b2-89588c7767cf","name":"Hermann, Nuno Vibe","orcid":"0000-0002-8079-8571","rank":3,"rolecode":"pau"},{"affno":"1","first":"Pia","key":"larsenpau","last":"Larsen","locid":"942eeda4-c3bd-4745-a9c1-71b63f35b6b1","name":"Larsen, Pia Veldt","name_org":"Larsen, Pia","rank":4,"rolecode":"pau"},{"affno":"1","first":"Sven","key":"kreiborgpau","last":"Kreiborg","locid":"d496d728-62c1-4162-854c-83f5f0fc5438","name":"Kreiborg, Sven","rank":5,"rolecode":"pau"},{"affno":"","first":"HD","key":"hovepau","last":"Hove","name":"Hove, HD","rank":6,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-92b0c094-e5fc-4631-80b1-7292efd8f5c6"],"src":["KU University of Copenhagen"],"title":"Using CT to validate measurement of facial asymmetry in surface scans of infants with unilateral coronal synostosis.","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-481085","year":"2015","yearsub":"2015"}
{"abstract":"CONCLUSION: Twenty-five rats were challenged by an immunologic attack of the endolymphatic sac. After 6 months, distortion product oto-acoustic emissions (DPOAE) revealed a dysfunction of the outer hair cells and immunological active cells were observed in the endolymphatic sac. This information could contribute to the understanding of Ménière's disease. OBJECTIVES: This study investigated if an autoimmune challenge of the endolymphatic sac could affect DPOAE output measurements in rats. Also, a potential autoimmune cell infiltration of the endolymphatic sac was investigated. METHODS: Eighteen Lewis rats were immunized with a crude endolymphatic sac extract in complete Freund's adjuvant. Seven control animals were injected with Freund's adjuvant in saline. Cochlear damage was estimated by DPOAE dynamics 3 weeks and 6 months after the immunization. Infiltrative cells in the endolymphatic sac were investigated with transmission electron microscopy. RESULTS: The hearing assessment 6 months after immunization revealed a reduction of the DPOAE, on the full range of frequencies (2-63 kHz) in an average of the mean, of 2 dB ± 1.1 in the immunized group compared to the controls (p < 0.05). The same test showed a 2.5 dB decrease from 2 to 5 kHz (p < 0.01). Immunological active cells were observed in the endolymphatic sac in most of the immunized rats.","author_count":6,"contributors":["Larsen, Michael","Friis, Morten","Rift, Charlotte Vestrup","Poulsen, Steen Seier","Lund, Søren Peter","Qvortrup, Klaus"],"cuid":["S02-091.85-768771"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med","soc"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-WORK"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-GV-WORK","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"auto inflammatory challenge of the endolymphatic sac cochlear damage measured by distortion product oto acoustic emissions","src":["ku","nfa"],"src-code":["DI-GV-WORK","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84931846553","version":"Other Version"},"id":"S02-091.85-768771","identifier":[{"id":"25858709","type":"pmid"},{"id":"84931846553","type":"scopus"}],"ids":["ku-3dcf2006-4b47-47a7-b30a-0ebc249b4853","nfa-8e58ecaa-6eac-41c8-b6a4-a2053a2ef4f1"],"lang":"English","level":"Scientific","mra":["Medical Science","Social Science"],"noi":["Global-Local-2-5-DC56CDA729B691F3B7D302EC359E3C80"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"nfa national research centre for the working environment","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-WORK","l3nn":"NFA National Research Centre for the Working Environment","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"NFA National Research Centre for the Working Environment","namevar":["The National Research Centre for the Working Environment, Directors, Chemical Working Environment, Toxicology, Nanosafety, and Microbiology"],"nora_code":"DI-GV-WORK","used":1}],"person":[{"affno":"","first":"Michael","key":"larsenpau","last":"Larsen","name":"Larsen, Michael","rank":1,"rolecode":"pau"},{"affno":"1","first":"Morten","key":"friispau","last":"Friis","locid":"f24a390b-60ee-408a-93fd-09b603e9c14d","name":"Friis, Morten","rank":2,"rolecode":"pau"},{"affno":"","first":"Charlotte Vestrup","key":"karlsenpau","last":"Karlsen","locid":"fe63ec28-1c31-4d52-b4ef-6cc4c1ecc8be","name":"Rift, Charlotte Vestrup","name_org":"Karlsen, Charlotte Vestrup","rank":3,"rolecode":"pau"},{"affno":"1","first":"Steen Seier","key":"poulsenpau","last":"Poulsen","locid":"8959d81d-fe64-4ef4-86b7-003b7b637e8e","name":"Poulsen, Steen Seier","orcid":"0000-0003-4419-4911","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Søren Peter","key":"lundpau","last":"Lund","name":"Lund, Søren Peter","rank":5,"rolecode":"pau"},{"affno":"1","first":"Klaus","key":"qvortruppau","last":"Qvortrup","locid":"e7d5e238-9367-4780-9b26-e468bcdff739","name":"Qvortrup, Klaus","rank":6,"rolecode":"pau"}],"pmid":["25858709"],"pub":{"doi":"10.3109/00016489.2015.1032433","issn":["00016489","16512251"],"issn_org":["00016489"],"issue":"8","journal":"Acta Oto-Laryngologica","pages":"758-764","publisher":"Taylor & Francis","status":"p","title":"Acta Oto-Laryngologica","title_org":"Acta Otolaryngologica","volume":"135"},"review":"Peer Reviewed","scoID":["2-s2.0-84931846553"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-3dcf2006-4b47-47a7-b30a-0ebc249b4853","nfa-8e58ecaa-6eac-41c8-b6a4-a2053a2ef4f1"],"src":["KU University of Copenhagen","NFA National Research Centre for the Working Environment"],"title":"Auto-inflammatory challenge of the endolymphatic sac - Cochlear damage measured by distortion product oto-acoustic emissions","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-091.85-768771","year":"2015","yearsub":"2015"}
