openhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Urology"],"nora_code":"DI-U-KU","used":1},{"affno":"5","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"6","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Public Health, Clinical Pharmacology and Pharmacy","SDU, The Faculty of Health Sciences, Department of Public Health, Clinical Trial Unit"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Signe Benzon","key":"larsenpau","last":"Larsen","name":"Larsen, Signe Benzon","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christian","key":"dehlendorffpau","last":"Dehlendorff","name":"Dehlendorff, Christian","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Charlotte","key":"skriverpau","last":"Skriver","name":"Skriver, Charlotte","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Susanne Oksbjerg","key":"daltonpau","last":"Dalton","name":"Dalton, Susanne Oksbjerg","rank":4,"rolecode":"pau"},{"affno":"2 1 3","corresponding":null,"country":"dk","first":"Christina Gade","key":"jespersenpau","last":"Jespersen","locid":"793c7be5-5799-4662-9eca-d643ebdfb83d","name":"Jespersen, Christina Gade","rank":5,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"country":"dk","first":"Michael","key":"borrepau","last":"Borre","locid":"f0a95cf0-1ff2-4308-991f-749123c14ba5","name":"Borre, Michael","rank":6,"rolecode":"pau"},{"affno":"4 5","first":"Klaus","key":"brassopau","last":"Brasso","locid":"59b1e9f4-7fb8-4172-a372-7c1388821f78","name":"Brasso, Klaus","rank":7,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"country":"dk","first":"Mette","key":"norgaardpau","last":"Norgaard","locid":"3cb2ae19-c1b9-4dad-9928-adbd1c51b4b7","name":"Nørgaard, Mette","name_org":"Norgaard, Mette","orcid":"0000-0001-6110-5891","rank":8,"rolecode":"pau"},{"affno":"","first":"Mette","key":"nørgaardpau","last":"Nørgaard","name":"Nørgaard, Mette","rank":8,"rolecode":"pau"},{"affno":"4 1","first":"Christoffer","key":"johansenpau","last":"Johansen","locid":"18d62c73-2f35-499d-ac94-134ecd806296","name":"Johansen, Christoffer","rank":9,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"country":"dk","first":"Henrik Toft","key":"sorensenpau","last":"Sorensen","locid":"4d49d93a-4913-4223-ba59-272e717a845d","name":"Sørensen, Henrik Toft","name_org":"Sorensen, Henrik Toft","orcid":"0000-0003-4299-7040","rank":10,"rolecode":"pau"},{"affno":"","first":"Henrik Toft","key":"sørensenpau","last":"Sørensen","name":"Sørensen, Henrik Toft","rank":10,"rolecode":"pau"},{"affno":"6","corresponding":null,"country":"dk","first":"Jesper","key":"hallaspau","last":"Hallas","locid":"1fc2d4e1-080d-4c53-bd96-63186af28ae9","name":"Hallas, Jesper","orcid":"0000-0002-8097-8708","rank":11,"rolecode":"pau"},{"affno":"1 4 2","corresponding":null,"first":"Soren","key":"friispau","last":"Friis","locid":"e0c48e7a-dd83-4611-a29d-82dbb474b355","name":"Friis, Søren","name_org":"Friis, Soren","rank":12,"rolecode":"pau"}],"pmid":["28806117"],"pub":{"doi":"10.1200/jco.2016.71.8981","issn":["0732183X","15277755"],"issn_org":["0732183X"],"issue":"29","journal":"Journal of Clinical Oncology","pages":"3290-3297","publisher":"American Society of Clinical Oncology","status":"p","title":"Journal of Clinical Oncology","volume":"35"},"review":"Peer Reviewed","scoID":["2-s2.0-85030534985"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Non-Profit Organisations","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Hospitals","Non-Profit Organisations","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-1ea1f869-6cf0-4827-ab8f-a2a99f65587b","ku-cc0651e5-09eb-454a-a688-e142ef319277","sdu-172cb17b-c3a3-4024-ac12-5b2c748bdbc6"],"src":["AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Postdiagnosis Statin Use and Mortality in Danish Patients With Prostate Cancer","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-098.46-014817","year":"2017","yearsub":"2017"}
{"abstract":"OBJECTIVE: Simulation-based training is well recognized in the transforming field of urological surgery; however, integration into the curriculum is often unstructured. Development of simulation-based curricula should follow a stepwise approach starting with a needs assessment. This study aimed to identify technical procedures in urology that should be included in a simulation-based curriculum for residency training. MATERIALS AND METHODS: A national needs assessment was performed using the Delphi method involving 56 experts with significant roles in the education of urologists. Round 1 identified technical procedures that newly qualified urologists should perform. Round 2 included a survey using an established needs assessment formula to explore: the frequency of procedures; the number of physicians who should be able to perform the procedure; the risk and/or discomfort to patients when a procedure is performed by an inexperienced physician; and the feasibility of simulation training. Round 3 involved elimination and reranking of procedures according to priority. RESULTS: The response rates for the three Delphi rounds were 70%, 55% and 67%, respectively. The 34 procedures identified in Round 1 were reduced to a final prioritized list of 18 technical procedures for simulation-based training. The five procedures that reached the highest prioritization were cystoscopy, transrectal ultrasound-guided biopsy of the prostate, placement of ureteral stent, insertion of urethral and suprapubic catheter, and transurethral resection of the bladder. CONCLUSION: The prioritized list of technical procedures in urology that were identified as highly suitable for simulation can be used as an aid in the planning and development of simulation-based training programs.","author_count":8,"contributors":["Nayahangan, Leizl Joy","Bølling Hansen, Rikke","Lindorff-Larsen, Karen","Paltved, Charlotte","Nielsen, Bjørn Ulrik","Konge, Lars"],"cuid":["S04-084.56-000410"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":4,"corresponding_author":["Nayahangan, Leizl Joy"],"keyword":["Acquisition","Curriculum","Curriculum development","Delphi Technique","Education","Flexible cystoscopy","Humans","Internship and Residency","Journal Article","Needs Assessment","Simulation","Simulation Training","Simulation based training","Skills","Surgery","Technical procedures","Ultrasonography","Urinary Catheterization","Urology education","Urology training","Validation","Virtual reality simulator"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-NDR"],"OT":["Unspecified organisation"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-NDR","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"identifying content for simulation based curricula in urology a national needs assessment","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85026270051","version":"Other Version"},"id":"S04-084.56-000410","identifier":[{"id":"85026270051","type":"scopus"},{"id":"000418038200010","type":"wos"},{"id":"28743217","type":"pmid"}],"ids":["aau-08002bee-0be3-4185-93ba-e80be0080daf","au-05b2aa74-5aeb-4f08-8fa5-ca6344e7208f","ku-7bca760c-240c-4128-ab2e-acce67ea3bf0","sdu-9a1a9ee0-969d-4270-837a-60d3ba23da45"],"keyword":["ACQUISITION","Curriculum","Curriculum development","Delphi Technique","EDUCATION","ENDOUROLOGICAL SIMULATOR","FLEXIBLE CYSTOSCOPY","Humans","Internship and Residency","Journal Article","SKILLS","SURGERY","Simulation Training","TECHNICAL PROCEDURES","Ultrasonography","Urinary Catheterization","Urologic Surgical Procedures/education","Urology/educat