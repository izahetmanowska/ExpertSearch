,"loc":["United States","America, North","OECD"],"name":"Yale University","used":1},{"affno":"11","country":"us","key":"cornell university","loc":["United States","America, North","OECD"],"name":"Cornell University","used":1},{"affno":"12","country":"gb","key":"imperial college london","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Imperial College London","used":1},{"affno":"13","country":"no","key":"university of oslo","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"University of Oslo","used":1},{"affno":"14","country":"nl","key":"university of twente","loc":["Netherlands","Europe, EU","OECD"],"name":"University of Twente","used":1},{"affno":"15","country":"nl","key":"albert schweitzer ziekenhuis","loc":["Netherlands","Europe, EU","OECD"],"name":"Albert Schweitzer Ziekenhuis","used":1},{"affno":"16","country":"nl","key":"radboud university nijmegen","loc":["Netherlands","Europe, EU","OECD"],"name":"Radboud University Nijmegen","used":1},{"affno":"17","country":"nl","key":"utrecht university","loc":["Netherlands","Europe, EU","OECD"],"name":"Utrecht University","used":1},{"affno":"18","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Neurology"],"nora_code":"DI-U-KU","used":1},{"affno":19,"key":"collaboration of controlled randomised trials of long term oral antithrombotic agents after spontaneous intracranial haemorrhage","name":"Collaboration of Controlled Randomised Trials of Long-Term Oral Antithrombotic Agents After Spontaneous Intracranial Haemorrhage (COCROACH)","role":"oau"}],"person":[{"affno":"1","first":"Rustam","key":"alshahisalmanpau","last":"Al-Shahi Salman","name":"Al-Shahi Salman, Rustam","rank":1,"rolecode":"pau"},{"affno":"1","first":"Jacqueline","key":"stephenpau","last":"Stephen","name":"Stephen, Jacqueline","rank":2,"rolecode":"pau"},{"affno":"2","first":"Jayne F.","key":"tierneypau","last":"Tierney","name":"Tierney, Jayne F.","rank":3,"rolecode":"pau"},{"affno":"1","first":"Steff C.","key":"lewispau","last":"Lewis","name":"Lewis, Steff C.","rank":4,"rolecode":"pau"},{"affno":"1","first":"David E.","key":"newbypau","last":"Newby","name":"Newby, David E.","rank":5,"rolecode":"pau"},{"affno":"3","first":"Adrian R.","key":"parryjonespau","last":"Parry-Jones","name":"Parry-Jones, Adrian R.","rank":6,"rolecode":"pau"},{"affno":"4 5","first":"Philip M.","key":"whitepau","last":"White","name":"White, Philip M.","rank":7,"rolecode":"pau"},{"affno":"6","first":"Stuart J.","key":"connollypau","last":"Connolly","name":"Connolly, Stuart J.","rank":8,"rolecode":"pau"},{"affno":"7","first":"Oscar R.","key":"benaventepau","last":"Benavente","name":"Benavente, Oscar R.","rank":9,"rolecode":"pau"},{"affno":"8","first":"Dar","key":"dowlatshahipau","last":"Dowlatshahi","name":"Dowlatshahi, Dar","rank":10,"rolecode":"pau"},{"affno":"9","first":"Charlotte","key":"cordonnierpau","last":"Cordonnier","name":"Cordonnier, Charlotte","rank":11,"rolecode":"pau"},{"affno":"10","first":"Catherine M.","key":"viscolipau","last":"Viscoli","name":"Viscoli, Catherine M.","rank":12,"rolecode":"pau"},{"affno":"10","first":"Kevin N.","key":"shethpau","last":"Sheth","name":"Sheth, Kevin N.","rank":13,"rolecode":"pau"},{"affno":"11","first":"Hooman","key":"kamelpau","last":"Kamel","name":"Kamel, Hooman","rank":14,"rolecode":"pau"},{"affno":"12","first":"Roland","key":"veltkamppau","last":"Veltkamp","name":"Veltkamp, Roland","rank":15,"rolecode":"pau"},{"affno":"13","first":"Kristin T.","key":"larsenpau","last":"Larsen","name":"Larsen, Kristin T.","rank":16,"rolecode":"pau"},{"affno":"14","first":"Jeannet