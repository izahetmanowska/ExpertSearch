ing","key":"bjerrumpau","last":"Bjerrum","name":"Bjerrum, Flemming","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mathilde","key":"maagaardpau","last":"Maagaard","name":"Maagaard, Mathilde","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Per","key":"winkelpau","last":"Winkel","name":"Winkel, Per","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christian Rifbjerg","key":"larsenpau","last":"Larsen","name":"Larsen, Christian Rifbjerg","rank":5,"rolecode":"pau"},{"affno":"3","country":"dk","first":"Charlotte","key":"ringstedpau","last":"Ringsted","locid":"aad0b8e6-2821-409d-9ed2-33b6ffded4d2","name":"Ringsted, Charlotte","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Christian","key":"gluudpau","last":"Gluud","name":"Gluud, Christian","rank":7,"rolecode":"pau"},{"affno":"2","first":"Teodor","key":"grantcharovpau","last":"Grantcharov","name":"Grantcharov, Teodor","rank":8,"rolecode":"pau"},{"affno":"3","first":"Bent","key":"ottesenpau","last":"Ottesen","locid":"5cc91f75-7bf4-4789-a5de-71cbf232e8d5","name":"Ottesen, Bent","rank":9,"rolecode":"pau"},{"affno":"3","country":"dk","first":"Jette Led","key":"sørensenpau","last":"Sørensen","locid":"84ce4092-8277-45c1-89d5-afedea9c65f0","name":"Sørensen, Jette Led","orcid":"0000-0002-7320-2784","rank":10,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jette Led","key":"soerensenpau","last":"Soerensen","name":"Soerensen, Jette Led","rank":10,"rolecode":"pau"}],"pmid":["22373062"],"pub":{"doi":"10.1186/1472-6920-12-7","issn":["14726920"],"issue":"1","journal":"BMC Medical Education","paperid":"7","publisher":"BioMed Central","status":"p","title":"BMC Medical Education","title_org":"B M C Medical Education","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-84857403056"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Region Zealand","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-a63b7c92-6d46-4991-b582-ee2d52520d9f","ku-0f07524b-d5e0-445e-98df-ec05de2d19bf"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Instructor feedback versus no instructor feedback on performance in a laparoscopic virtual reality simulator : A randomized educational trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-092.93-024826","year":"2012","yearsub":"2012"}
{"abstract":"Two prospective longitudinal studies in 13 postweaning multisystemic wasting syndrome (PMWS)-affected farms from Spain (n = 3) and Denmark (n = 10) were performed. Blood samples from pigs were longitudinally collected from 1st week until the occurrence of the PMWS outbreak. Wasted and healthy age-matched pigs were euthanized, necropsied and histopathologically characterised. PMWS diagnosis was confirmed by means of lymphoid lesions and detection of porcine circovirus type 2 (PCV2) in these tissues by in situ hybridization or immunohistochemistry. Serological analyses were performed in longitudinally collected serum samples to detect antibodies against, PCV2, porcine reproductive and respiratory syndrome virus (PRRSV), porcine parvovirus (PPV), swine influenza virus (SIV) and Lawsonia intracellularis (law), Mycoplasma hyopneumoniae, Aujeszky’s disease virus (ADV) and Salmonella spp. A Cox proportional hazards model was used to investigate the simultaneous effects of seroconversion and maternal immunity against the studied pathogens. Results showed that high levels of maternal immunity against PCV2 had a protecting effect in farms from both countries. Moreover, for the Danish dataset, seroconversion against law had an overall protecting effect, but for animals with very low levels of maternal antibody levels against this pathogen, the effect appeared neutral or aggravating. Otherwise, for the Spanish dataset, maternal immunity against PPV and PRRSV gave protective and aggravating effects, respectively. In conclusion, the present study reflects the complex interaction among different pathogens and their effects in order to trigger PMWS in PCV2 infected pigs.","author_count":15,"contributors":["Grau-Roma, Llorenç","Stockmarr, Anders","Kristensen, Charlotte S.","Enøe, Claes","López-Soria, Sergio","Nofrarías, Miquel","Bille-Hansen, Vivi","Hjulsager, Charlotte Kristiane","Sibila, Marina","Jorsal, Sven E.","Fraile, Lorenzo","Baekbo, Poul","Vigre, Håkan","Segalés, Joaquim","Larsen, Lars Erik"],"cuid":["S02-099.93-033902"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD"],"country":["Spain"],"glorg":["All Global Affiliations","Autonomous University of Barcelona","Centre for Animal Health Research","Institute of Agrifood Research and Technology"],"keyword":["Infectious risk factors","Porcine circovirus type 2 PCV2","Postweaning multisystemic wasting syndrome PMWS","Survival Analysis"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-PR","DI-U"],"level3":{"OT":["Danish Pig Production"],"PR":["DI-PR-AAF","DI-PR-ALL"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-PR-AAF","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"infectious risk factors for individual postweaning multisystemic wasting syndrome pmws development in pigs from affected farms in spain and denmark","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.rvsc.2012.07.001","version":"Other Version"},"id":"S02-099.93-033902","identifier":[{"id":"84866885581","type":"scopus"},{"id":"22884005","type":"pmid"}],"ids":["dtu-3aa91a69-a216-4285-8a5f-9f1645d0739c","ku-d43a8188-0b40-49cb-b5d1-11b2c960dcfe"],"keyword":["Infectious risk factors","Porcine circovirus type 2 (PCV2)","Postweaning multisystemic wasting syndrome (PMWS)","Survival analysis"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-51D79C3A06160C05428221CB566E6274"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.rvsc.2012.07.001","version":"Other Version"}],"org":[{"affno":"1","country":"es","key":"autonomous university of barcelona","loc":["Spain","Europe, EU","OECD"],"name":"Autonomous University of Barcelona","used":1},{"affno":"2","country":