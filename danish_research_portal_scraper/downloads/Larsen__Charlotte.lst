 Nørregaard","name_org":"Rasmussen, CDN","orcid":"0000-0002-1769-717X","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Helene","key":"højbergpau","last":"Højberg","name":"Højberg, Helene","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anne Konring","key":"larsenpau","last":"Larsen","name":"Larsen, Anne Konring","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Pernille Kold","key":"munchpau","last":"Munch","name":"Munch, Pernille Kold","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Richard","key":"osbornepau","last":"Osborne","name":"Osborne, Richard","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Lydia","key":"kwakpau","last":"Kwak","name":"Kwak, Lydia","rank":6,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Irene","key":"jensenpau","last":"Jensen","name":"Jensen, Irene","rank":7,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Laura","key":"linnanpau","last":"Linnan","name":"Linnan, Laura","rank":8,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Marie Birk","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, Marie Birk","rank":9,"rolecode":"pau"}],"pub":{"doi":"10.2196/16039","issn":["19290748"],"issue":"5","journal":"JMIR Research Protocols","paperid":"e16039","publisher":"JMIR Publications","status":"p","title":"JMIR Research Protocols","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-85096203000"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Miscellaneous","DI-ALL","DI-GV","DI-GV-ALL","DI-OT","DI-OT-ALL","Governmental Institutions","Miscellaneous","Other Research"],"PST":["Published"]},"sid":["nfa-42fca8cf-2e41-437c-98f9-ced18823c206"],"src":["NFA National Research Centre for the Working Environment"],"title":"Evaluation and dissemination of a checklist to improve implementation of work environment initiatives in the eldercare sector - Protocol for a prospective observational study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-780455","year":"2020","yearsub":"2020"}
{"abstract":"Introduction: Colonoscopy adverse events (AEs) are commonly underreported and standardised reporting is rarely used. We aimed to investigate AEs associated with colonoscopy in a real world setting, using the American Society of Gastrointestinal Endoscopy (ASGE) lexicon. Methods: This retrospective cohort study of AEs related to outpatient colonoscopies performed in the North Denmark Region from 2015 to 2018 identified AEs from readmission within eight days or death within 30 days of colonoscopy. AEs were investigated in electronic health records and categorised, attributed and graded according to the ASGE lexicon. Results: Of 49,445 colonoscopies performed, 1141 were potentially associated with AEs (23.07‰). Electronic health record review left 489 AEs attributed to colonoscopy (9.9‰); categorised as cardiovascular (0.65‰), pulmonary (0.36‰), thromboembolic (0.10‰), instrumental incl. perforations (0.99‰), bleeding (3.07‰), infection (0.87‰), drug reactions (0.04‰), pain (2.00‰), integument (damage to skin/bones) (0.34‰) and other (1.62‰) AEs. Ten (0.20‰) AEs were fatal, but only one was procedure related (perforation). All shearing force perforations occurred in the sigmoid colon. Most polypectomy perforations occurred in the caecum (60%). Conclusions: Colonoscopy carries important procedure and non-procedure related risks. Non-procedure related AEs are likely underreported. Better attention to patients with pre-existing diseases and further colonoscopist training may lower AE rates. A standardised colonoscopy AE reporting system is warranted.","author_count":7,"contributors":["Pedersen, Lasse","Sørensen, Nina","Lindorff-Larsen, Karen","Carlsen, Charlotte Green","Wensel, Nina","Torp-Pedersen, Christian","Bernstein, Inge"],"cuid":["S02-097.60-007145"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Pedersen, Lasse"],"keyword":["Endoscopy general","GI bleeding","endoscopy interventional"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-NDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-HO-NDR","DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"colonoscopy adverse events are we getting the full picture","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85088433352&partnerID=8YFLogxK","version":"Other Version"},"id":"S02-097.60-007145","identifier":[{"id":"32693644","type":"pmid"},{"id":"85088433352","type":"scopus"}],"ids":["aau-937327d4-aaee-4ade-87ad-ed89a83985ed","au-f89c2cae-cd2c-4aa0-9ee9-f925d2efee19"],"keyword":["Endoscopy-general","GI-bleeding","endoscopy-interventional"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-DA98FE1C91FC04DD8EE3EA26A2FB0873"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Gastrointestinal Surgery","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Kirurgi og Kræftbehandling"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Emergency department"],"nora_code":"DI-U-AU","used":1},{"affno":"3","country":"dk","key":"north denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-NDR","l3nl":"North Denmark Region","l3nn":"North Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"North Denmark Region","namevar":["The North Denmark Region"],"nora_code":"DI-HO-NDR","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lasse Jan","key":"pedersenpau","last":"Pedersen","locid":"2637b3fb-b84f-4ef6-8976-39b51dae9d40","name":"Pedersen, Lasse","name_org":"Pedersen, Lasse Jan","orcid":"0000-0002-3299-1561","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Nina","key":"sørensenpau","last":"Sørensen","locid":"69e0fe2f-f8cc-453e-a1ed-838e09bca672","name":"Sørensen, Nina","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Karen","key":"lindorfflarsenpau","last":"Lindorff-Larsen","locid":"44148857-c2e8-4814-86a8-28c2b1951a63","name":"Lindorff-Larsen, Karen","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Charlotte Green","key":"carlsenpau","last":"Carlsen","locid":"c15e93b9-7b51-4d3b-9a42-fbf3aa255ad1","name":"Carlsen, Charlotte Green","rank":4,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"first":"Nina","key":"wenselpau","last":"Wensel","locid":"39d9716d-14a2-461f-a21c-876723f1b31b","name":"Wensel, Nina","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Christian","key":"torppedersenpau","last":"Torp-Pedersen","locid":"5417d806-0578-4505-b3fe-68ae0359913e","name":"Torp-Pedersen, Christian","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Inge Thomsen","key":"bernsteinpau","last":"Bernstein","locid":"fc5f604f-944f-4a7b-a98b-f5db5141174b","name":"Bernstein, Inge","name_org":"Bernstein, Inge Thomsen","rank":7,"rolecode":"pau"}],"pmid":["32693644"],"pub":{"doi":"10.1080/00365521.2020.1792541","issn":["00365521","15027708"],"issn_org":["00365521"],"issue":"8","journal":"Scandinavian Journal of Gastroenterology","pages":"979-987","publisher":"Informa Healthcare","status":"p","title":"Scandinavian Journal of Gastroenterology","volume":"55"},"review":"Peer Reviewed","scoID":["2-s2.0-85088433352"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Universities"],"PST":["Published"]},"sid":["aau-937327d4-aaee-4ade-87ad-ed89a83985ed","au-f89c2cae-cd2c-4aa0-9ee9-f925d2efee19"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Colonoscopy adverse events : are we getting the full picture?","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-097.60-007145","year":"2020","yearsub":"2020"}
{"abstract":"PURPOSE: Epidemiologic studies suggest that use of aspirin or other nonsteroidal anti-inflammatory drugs (NSAIDs) may reduce prostate cancer risk. We examined these associations overall and according to clinical and lifestyle parameters. METHODS: We identified male participants in the Danish Diet, Cancer and Health Study (n = 26,339), holding information on anthropometric measures and lifestyle factors. From Danish nationwide registries and medical records, we retrieved complete prescription histories and prostate cancer occurrence and characteristics. Cox regression was used to estimate hazard ratios (HRs) for prostate cancer associated with low-dose aspirin or nonaspirin NSAID use, overall and by clinical characteristics, anthropometric measures, and lifestyle factors. RESULTS: We identified 1,927 prostate cancer cases during a median follow-up of 17.0 years. Low-dose aspirin use was not associated with overall prostate cancer risk, but a reduced HR for nonaggressive prostate cancer (high use [≥ 1,825 tablets]: 0.79; 95% confidence interval (CI) 0.60-1.04) and an increased HR for aggressive disease (high use: 1.27; 95% CI 1.00-1.61) was observed with low-dose aspirin use. Long-term, high-intensity use (≥ 10 years with ≥ 0.25 defined daily doses/day) of nonaspirin NSAIDs was associated with an increased HR for prostate cancer (1.35, 95% CI 0.99-1.84), confined to localized and nonaggressive disease. No consistent variation in HRs was seen in analyses stratified by height, body mass index, smoking, and alcohol use. CONCLUSION: Low-dose aspirin or other NSAID use was not associated with reduced prostate cancer risk, neither overall nor according to anthropometric measures, smoking, or alcohol use. The variation according to outcome characteristics warrants further investigation.","author_count":12,"contributors":["Skriver, Charlotte","Dehlendorff, Christian","Borre, Michael","Brasso, Klaus","Larsen, Signe Benzon","Tjønneland, Anne","Pottegård, Anton","Hallas, Jesper","Sørensen, Henrik Toft","Friis, Søren"],"cuid":["S03-093.01-028146"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"corresponding_author":["Skriver, Charlotte"],"keyword":["Aspirin","Cohort study","Epidemiology","Nonsteroidal anti inflammatory drugs","Prostate neoplasms","Risk"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-NP","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR"],"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-NP-CAN","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"associations of low dose aspirin or other nsaid use with prostate cancer risk in the danish diet cancer and health study","src":["au","ku","sdu"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85076589469","version":"Other Version"},"funding_acknowledgement":["The study was supported by a grant from the Danish Cancer Society (Grant No. R56-A3307-12-S2). Professor Sørensen does not report receiving fees, honoraria, grants, or consultancies. Department of Clinical Epidemiology is, however, involved in studies with funding from various companies as research grants to (and administered by) Aarhus University. Authors not named here have disclosed no conflicts of interest."],"id":"S03-093.01-028146","identifier":[{"id":"000511922100004","type":"wos"},{"id":"31823168","type":"pmid"},{"id":"85076589469","type":"scopus"}],"ids":["au-d5a8b62c-87fc-4a59-8b40-f1c1447ab979","ku-d7e37196-b68f-4bf2-8a16-aafda0bcd5e3","sdu-5ea27ece-ac9b-438d-90dc-a2e35c93207a"],"keyword":["Aspirin","Cohort study","Epidemiology","Nonsteroidal anti-inflammatory drugs","Prostate neoplasms","Risk"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-80297183F650B1C357A073FBC6672C2D"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"dk","key":"dcrc danish cancer society research center","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-CAN","l3nn":"DCRC Danish Cancer Society Research Center","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DCRC Danish Cancer Society Research Center","namevar":["Danish Cancer Society"],"nora_code":"DI-NP-CAN","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Urology"],"nora_code":"DI-U-AU","used":1},{"affno":"3","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1},{"affno":"4","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Urology"],"nora_code":"DI-U-KU","used":1},{"affno":"5","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OEC