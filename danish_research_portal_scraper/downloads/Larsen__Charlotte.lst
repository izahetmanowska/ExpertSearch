-7058-4641","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Martin","key":"lindberglarsenpau","last":"Lindberg-Larsen","locid":"299608f9-db43-4744-984b-a7c428aca95b","name":"Lindberg-Larsen, Martin","orcid":"0000-0002-4483-677X","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Claus","key":"varnumpau","last":"Varnum","locid":"0f639544-4ebc-467c-a15b-3c049a26f62f","name":"Varnum, Claus","orcid":"0000-0002-0625-5691","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Karina","key":"dahlsteffensenpau","last":"Dahl Steffensen","locid":"2ab8fd03-e60c-401e-aeff-4a5eb53fe025","name":"Dahl Steffensen, Karina","orcid":"0000-0002-9217-3907","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-d2e90d6e-9eb7-4605-a474-422ad512d8a6"],"src":["SDU University of Southern Denmark"],"title":"Development and Field-Testing of In-Consult Patient Decision Aids for Hip and Knee Osteoarthritis: A Collaborative Approach","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-802917","year":"2024","yearsub":"2024"}
{"abstract":"Super resolution ultrasound imaging using the erythrocytes (SURE) has recently been introduced. The method uses erythrocytes as targets instead of fragile microbubbles (MBs). The abundance of erythrocyte scatterers makes it possible to acquire SURE data in just a few seconds compared to several minutes in ultrasound localization microscopy (ULM) using MBs. A high number of scatterers can reduce the acquisition time, however, the tracking of uncorrelated and high-density scatterers is quite challenging. This paper hypothesizes that it is possible to detect and track erythrocytes as targets to obtain vascular flow images. A SURE tracking pipeline is used with modules for beamforming, recursive synthetic aperture imaging, motion estimation, echo canceling, peak detection, and recursive nearest neighbor tracker. The SURE tracking pipeline is capable of distinguishing the flow direction and separating tubes of a simulated Field II phantom with 125 to 25 μm wall-to-wall tube distances, as well as a 3D-printed hydrogel micro-flow phantom with 100 to 60 μm wall-to-wall channel distances. The comparison of an in-vivo SURE scan of a Sprague-Dawley rat kidney with ULM and micro-CT scans with voxel sizes of 26.5μm and 5μm demonstrated consistent findings. A microvascular structure composed of 16 vessels exhibited similarities across all imaging modalities. The flow direction and velocity profiles in the SURE scan were found to be concordant with those from ULM.","author_count":17,"contributors":["Amin Naji, Mostafa","Taghavi, Iman","Schou, Mikkel","Præsius, Sebastian Kazmarek","Hansen, Lauge Naur","Panduro, Nathalie Sarup","Andersen, Sofie Bech","Søgaard, Stinne Byrholdt","Gundlach, Carsten","Kjer, Hans Martin","Tomov, Borislav Gueorguiev","Thomsen, Erik Vilain","Nielsen, Michael Bachmann","Larsen, Niels Bent","Dahl, Anders Bjorholm","Sørensen, Charlotte Mehlin","Jensen, Jørgen Arendt"],"cuid":["S02-096.84-756164"],"filters":{"added":"2024-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"keyword":["Contrast free","Erythrocytes","Micro CT","Recursive Imaging","Super resolution ultrasound imaging","Ultrasound localization microscopy"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"super resolution ultrasound imaging using the erythrocytes ii velocity images","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1109/TUFFC.2024.3411795","version":"Published Version"},"id":"S02-096.84-756164","identifier":[{"id":"85196076724","type":"scopus"},{"id":"38857146","type":"pmid"}],"ids":["dtu-69049990-bc34-492f-84c4-1f3126623291","ku-b836738d-e575-402f-a685-c9523ec4b2d2"],"keyword":["Contrast free","Erythrocytes","Micro-CT","Microvascular flow imaging","Recursive Imaging","Super resolution ultrasound imaging","Ultrasound localization microscopy"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-E998F930D00F10B82FB2F645A61AB12A"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1109/TUFFC.2024.3411795","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/364020921/Super_Resolution_Ultrasound_Imaging_Using_the_Erythrocytes_II_Velocity_Images.pdf","version":"Authors Final Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/403499576/Super_Resolution_Ultrasound.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Health Technology","Technical University of Denmark, Department of Health Technology, UltraSound and Biomechanics","Technical University of Denmark, Department of Health Technology, UltraSound and Biomechanics, Center for Fast Ultrasound Imaging"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Biomedical Sciences, Renal and Vascular Research"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Mostafa Amin","key":"najipau","last":"Naji","locid":"b0ff2be6-b55b-41ca-b7c7-d207debe2654","name":"Amin Naji, Mostafa","name_org":"Naji, Mostafa Amin","orcid":"0000-0001-8515-5607","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Iman","key":"taghavipau","last":"Taghavi","locid":"70860894-0180-4faf-a270-c7e761b81abc","name":"Taghavi, Iman","orcid":"0000-0002-2551-074X","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mikkel","key":"schoupau","last":"Schou","locid":"02abcc96-628c-467d-9117-1d3a80866a55","name":"Schou, Mikkel","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sebastian Kazmarek","key":"præsiuspau","last":"Præsius","locid":"e6c93584-4594-48f0-acad-1cf4227b4740","name":"Præsius, Sebastian Kazmarek","orcid":"0000-0003-3996-5494","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lauge Naur","key":"hansenpau","last":"Hansen","locid":"bf6b3fc6-e53e-4354-902f-263ed16c0299","name":"Hansen, Lauge Naur","orcid":"0009-0009-5451-2478","rank":5,"roleco