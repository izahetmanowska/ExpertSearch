de":"pau"},{"affno":"1","first":"Christoffer","key":"clemmensenpau","last":"Clemmensen","locid":"cb6d6cab-88bf-4650-9bd9-7759c2dc0be6","name":"Clemmensen, Christoffer","orcid":"0000-0003-2456-9667","rank":22,"rolecode":"pau"}],"pmid":["38427737"],"pub":{"doi":"10.1126/sciadv.adg2636","issn":["23752548"],"issue":"9","journal":"Science Advances","paperid":"eadg2636","status":"p","title":"Science Advances","volume":"10"},"review":"Peer Reviewed","scoID":["2-s2.0-85186745286"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Gubra","Novo Nordisk","Private Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-dfce2447-cc09-4544-9a63-aa1a45df51a5"],"src":["KU University of Copenhagen"],"title":"Targeting postsynaptic glutamate receptor scaffolding proteins PSD-95 and PICK1 for obesity treatment","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-732628","year":"2024","yearsub":"2024"}
{"abstract":"Sensors for quantitative monitoring of greenhouse gases from high-emission facilities, such as wastewater treatment and industrial plants, are becoming essential to enforce regulatory compliance in climate action initiatives. A predominant sensing technique is the tracer-gas dispersion method (TDM) using closed-path gas analyzers typically installed in a vehicle to measure concentration as the gas plume is transected. Here, we validate for the first time the use of integrated-path gas sensors in TDM, measuring instantaneously the concentration along a predetermined laser beam path, thereby facilitating a stationary setup with orders of magnitude higher update rate and without the need for vehicles or road access. Our approach relies on a sensitive, integrated-path multi-gas sensor for real-time emission quantification using tunable diode laser absorption spectroscopy. An optical sensor head with spectral coverage from 1.52 μm to 1.65 μm is demonstrated, supporting multiplexed gas sensing in a modular fashion using low-power fiber-coupled diode lasers. The sensor measures real-time integrated-path concentrations of CO2 and CH4, and the tracer-gas C2H2 at 130 Hz with 0.5 ppm, 3 ppb, and 2 ppb sensitivity, respectively, at 1 s averaging. The integrated-path sensor is systematically benchmarked for absolute accuracy against a state-of-the-art point sensor, revealing an excellent match over 16 hours. Furthermore, the integrated-path sensor is deployed outdoors for emission quantification using TDM. A comparison to the gold-standard point sensor reveals identical results, demonstrating the integrated-path sensor as a potent substitute for vehicle-driven point sensors.","author_count":9,"contributors":["Ashik, A. S.","Rodrigo, Peter John","Larsen, Henning Engelbrecht","Vechi, Nathalia T.","Kissas, Konstantinos","Fredenslund, Anders Michael","Mønster, Jacob G.","Scheutz, Charlotte","Pedersen, Christian"],"cuid":["S01-000.00-738216"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Ashik, A. S."],"keyword":["Acetylene","Carbon dioxide","Gas sensor","Laser spectroscopy","Methane","Tracer gas dispersion method"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GTS","DI-U"],"level3":{"GTS":["DI-GTS-ALL","DI-GTS-FORC"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-GTS-FORC","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"integrated path multi gas sensor using near infrared diode lasers an alternative to vehicle driven point gas analyzer","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.snb.2024.135855","version":"Published Version"},"id":"S01-000.00-738216","identifier":[{"id":"85190976821","type":"scopus"}],"ids":["dtu-2d37cd23-8161-4acc-8b63-a88ee4e88609"],"keyword":["Acetylene","Carbon dioxide","Gas sensor","Laser spectroscopy","Methane","Tracer-gas dispersion method"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-06B91A233A4185ED79C4C1D983064D9A"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/359561756/1-s2.0-S0925400524005859-main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.snb.2024.135855","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Electrical and Photonics Engineering","Technical University of Denmark, Department of Electrical and Photonics Engineering, Optical Sens