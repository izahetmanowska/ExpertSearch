"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Charlotte Rørdam","key":"larsenpau","last":"Larsen","locid":"4e604018-2471-4a68-a18b-0ae187425b3d","name":"Larsen, Charlotte Rørdam","orcid":"0000-0002-5465-0338","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Eva","key":"fockpau","last":"Fock","name":"Fock, Eva","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Trine","key":"heidepau","last":"Heide","name":"Heide, Trine","rank":4,"rolecode":"pau"}],"pub":{"pages":"134","publisher":"Artana","status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-08edcdbf-ba75-4aa0-a1fa-7f941f4028f7"],"src":["AU Aarhus University"],"title":"Hvordan styrker vi landskabet for professionelle klassiske ensembler og orkestre i Danmark?","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-134393","year":"2017","yearsub":"2017"}
{"abstract":"Background and Aims Patients scheduled for total hip replacement often presents cardiovascular comorbidity, which increases perioperative risk of complications. This pilot study aimed to compare lumbosacral plexus blockade with continuous and single-dose spinal anesthesia for surgical anesthesia in total hip replacement. We hypothesized that lumbosacral plexus blockade induced the least hemodynamic impact. Methods Eight patients for elective hip replacement were included following informed consent. Hemodynamic impact was assessed using pulse contour analyses of the femoral artery pressure. Group 1 had lumbosacral plexus blockade (lumbar plexus block, sacral plexus block and fascia transversalis plane block) with ropivacaine. Group 2 had continuous spinal anesthesia with repeated bupivacaine-doses. Group 3 had single-dose spinal anesthesia with bupivacaine. Hemodynamic data were recorded during a 1-hour follow-up. Results All patients were ASA II and between 56-81 years of age. Two patients dropped out due to failure to insert a spinal catheter. We found no significant change in any hemodynamic parameters in group 1 and 2. The patient in group 3 showed significant decrease in systemic vascular resistance, and arterial and central venous pressures. (table 1) No patients in group 1 achieved complete surgical anesthesia due to lack of anesthesia of the cranial part of the surgical incision. Conclusions Neither lumbosacral plexus block nor continuous spinal anesthesia affected any hemodynamic parameters in this pilot study on patients without severe comorbidity. The utilized lumbosacral plexus blockade did not provide complete surgical anesthesia for total hip replacement. Further studies are required to assess the hemodynamic effects of lumbosacral plexus blockade in patients with cardiovascular comorbidity.","author_count":7,"contributors":["Nielsen, Niels Dalsgaard","Larsen, Jens Rolighed","Børglum, Jens","Petersen, Jens Aage Kølsen","Runge, Charlotte","Søballe, Kjeld","Bendtsen, Thomas Fichtner"],"cuid":["S01-000.00-197510"],"event":{"end":"2017-09-16","place":"Lugano, ch","start":"2017-09-13","title":"The 36th Annual ESRA Congress","year":"2017"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR","DI-HO-ZEA"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-HO-CDR","DI-HO-ZEA","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"is lumbosacral plexus blockade effective and safe for surgical anesthesia in total hip replacement a pilot study","src":["au"],"src-code":["DI-U-AU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-197510","ids":["au-773a931d-363f-46fe-b309-95c6dd2e85f0"],"lang":"Danish","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-E94075ABD527D5D66BDEFC891A8EED86"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - University Clinic for Interdisciplinary Orthopaedic Pathways (UCOP)"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Regional Hospital of Silkeborg"],"nora_code":"DI-HO-CDR","used":1},{"affno":"3","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Zealand University Hospital"],"nora_code":"DI-HO-ZEA","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"Niels Dalsgaard","key":"nielsenpau","last":"Nielsen","locid":"b84f99a8-73b7-49c6-b1da-3a1cd6288046","name":"Nielsen, Niels Dalsgaard","orcid":"0000-0002-5326-5729","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jens Rolighed","key":"larsenpau","last":"Larsen","name":"Larsen, Jens Rolighed","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jens","key":"børglumpau","last":"Børglum","name":"Børglum, Jens","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens Aage Kølsen","key":"petersenpau","last":"Petersen","locid":"8d594837-f6de-4e1d-90d8-eafdfbee35c3","name":"Petersen, Jens Aage Kølsen","rank":4,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Charlotte","key":"rungepau","last":"Runge","locid":"eca83862-b388-4479-bc0b-c8a670ae52e9","name":"Runge, Charlotte","orcid":"0000-0001-9480-2490","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kjeld","key":"søballepau","last":"Søballe","locid":"288247bb-1768-4f37-a538-18727fed269b","name":"Søballe, Kjeld","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Thomas Fichtner","key":"bendtsenpau","last":"Bendtsen","locid":"089f9adf-ca15-47c2-bb41-1747197306b7","name":"Bendtsen, Thomas Fichtner","rank":7,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region Zealand","Universities"],"PST":["Published"]},"sid":["au-773a931d-363f-46fe-b309-95c6dd2e85f0"],"src":["AU Aarhus University"],"title":"Is lumbosacral plexus blockade effective and safe for surgical anesthesia in total hip replacement? : A pilot study","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-197510","year":"2017","yearsub":"2017"}
{"abstract":"The effect of experimentally increasing the postpartum protein supply on plasma protein synthesis, rumen tissue proliferation, and immune homeostasis was studied using 8 periparturient Holstein cows in a complete randomized design. At calving, cows were assigned to abomasal infusion of water (CTRL) or casein (CAS) in addition to a lactation diet. Casein infusion was gradually decreased from 696 ± 1 g/d at +2 d relative to calving (DRTC) to 212 ± 10 g/d at +29 DRTC to avoid excessive supply. Synthesis rate of plasma proteins was measured at –14, +4, +15, and +29 DRTC by measuring [ 13C]Phe isotopic enrichment in arterial plasma free Phe, total plasma proteins, and albumin after 3, 5, and 7 h of jugular ring[ 13C]Phe infusion. Plasma volume was determined at +4 and +29 DRTC by dilution of a [ 125I]BSA dose. Synthesis rate of tissue protein in biopsied rumen papillae was determined by measuring [ 13C]Phe isotopic enrichment, and mRNA expression of selected genes was measured by real-time qPCR. Total and differential leukocyte counts were performed and immune responsiveness of monocytes was evaluated by tumor necrosis factor ɑ (TNFɑ) concentration on ex vivo whole blood stimulation with Escherichia coli lipopolysaccharide (LPS) and responsiveness of T-lymphocytes by interferon γ (IFNγ) concentration on stimulation with Staphylococcus aureus enterotoxin β (SEB). Further, ELISA plasma concentrations of IgM, IgA, and IgG were determined. The DRTC affected the majority of investigated parameters as expected. The CAS treatment increased milk protein yield (P = 0.04), and tended to lower TNFɑ (P = 0.06), and lowered IFNγ (P = 0.03) responsiveness per monocyte and lymphocyte, respectively, compared with CTRL. Further, fractional synthesis rate of albumin was greater at +4 DRTC for CAS compared with CTRL but did not differ by +29 DRTC (interaction: P = 0.01). In rumen papillae, synthesis rate of tissue protein was greater for CAS compared with CTRL (P < 0.01) and mRNA expression of genes for cell proliferation tended to be or were greater for CAS compared with CTRL (P ≤ 0.07). In conclusion, increased postpartum protein supply seem to enhance vital body functions as interpreted from increased liver synthesis of albumin, increased rumen papillae proliferation, and stabilized the ex vivo inflammatory responsiveness of leukocytes. Further studies are needed to enlighten the importance of increased postpartum protein supply in periparturient cows.","author_count":6,"contributors":["Larsen, Mogens","Røntved, Christine Maria","Theil, Peter Kappel","Khatun, Mona","Lauridsen, Charlotte","Kristensen, Niels Bastian"],"cuid":["S01-000.00-226111"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["OECD","Oceania"],"country":["Australia"],"glorg":["All Global Affiliations","University of Sydney"],"keyword":["Albumin","Dairy cow","Gene expression","Immune function","Protein"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"effects of experimentally increased protein supply to postpartum dairy cows on plasma protein synthesis rumen tissue proliferation and immune homeostasis","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85019443104","version":"Other Version"},"id":"S01-000.00-226111","identifier":[{"id":"28727010","type":"pmid"},{"id":"85019443104","type":"scopus"}],"ids":["au-a9a6e8cc-9f39-4e01-aa77-d9e74d19838b"],"keyword":["albumin","dairy cow","gene expression","globulins","immune function","protein"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-BC5E41586FFA407F321174200FE8C6C9"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Animal and Veterinary Sciences, Department of Animal and Veterinary Sciences - ANIS Nutrition"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1},{"affno":"3","country":"au","key":"university of sydney","loc":["Australia","Oceania","OECD"],"name":"University of Sydney","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Mogens","key":"larsenpau","last":"Larsen","locid":"2318457a-d7e7-46ff-bb03-6a1da827134f","name":"Larsen, Mogens","orcid":"0000-0003-3767-0908","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Christine Maria","key":"røntvedpau","last":"Røntved","name":"Røntved, Christine Maria","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peter Kappel","key":"theilpau","last":"Theil","locid":"1869a922-3d79-4a49-8eac-148b15f19bfb","name":"Theil, Peter Kappel","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Mona","key":"khatunpau","last":"Khatun","name":"Khatun, Mona","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Charlotte","key":"lauridsenpau","last":"Lauridsen","locid":"892b1da6-ebd2-456b-b88e-0d709e529b1c","name":"Lauridsen, Charlotte","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Niels Bastian","key":"kristensenpau","last":"Kristensen","name":"Kristensen, Niels Bastian","rank":6,"rolecode":"pau"}],"pmid":["28727010"],"pub":{"doi":"10.2527/jas.2016.1055","issn":["00218812","15253163"],"issn_org":["00218812"],"issue":"5","journal":"Journal of Animal Science","pages":"2097-2110","publisher":"Oxford University Press","status":"p","title":"Journal of Animal Science","volume":"95"},"review":"Peer Reviewed","scoID":["2-s2.0-85019443104"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-a9a6e8cc-9f39-4e01-aa77-d9e74d19838b"],"src":["AU Aarhus University"],"title":"Effects of experimentally increased protein supply to postpartum dairy cows on plasma protein synthesis, rumen tissue proliferation, and immune homeostasis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-226111","year":"2017","yearsub":"2017"}
