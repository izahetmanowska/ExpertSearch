-4fcf-b1bc-0077ecbe84ad","name":"Becher, Naja","rank":15,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Laura","key":"roospau","last":"Roos","name":"Roos, Laura","rank":16,"rolecode":"pau"},{"affno":"5 6","corresponding":null,"first":"Marcella","key":"zollinopau","last":"Zollino","name":"Zollino, Marcella","rank":17,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christina Ringmann","key":"fagerbergpau","last":"Fagerberg","locid":"93aebc29-7681-4e3d-b613-867bd3a7eb65","name":"Fagerberg, Christina","name_org":"Fagerberg, Christina Ringmann","orcid":"0000-0002-5206-4327","rank":18,"rolecode":"pau"}],"pmid":["29959045"],"pub":{"doi":"10.1016/j.ejmg.2018.06.014","issn":["17697212","18780849"],"issn_org":["17697212"],"issue":"2","journal":"European Journal of Medical Genetics","pages":"129-136","publisher":"Elsevier Masson","status":"p","title":"European Journal of Medical Genetics","volume":"62"},"review":"Peer Reviewed","scoID":["2-s2.0-85049303965"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-94661cd0-9ba6-4a87-9fb7-4a2314ab139c","sdu-256b0090-08ad-45f5-ac46-95dce8e86aa8"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Is MED13L-related intellectual disability a recognizable syndrome?","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-023485","year":"2019","yearsub":"2019"}
{"abstract":"The oxygen permeability and oxidative stability of fish oil-loaded electrosprayed capsules were studied by Electron Spin Resonance (ESR). Electrosprayed capsules with dextran as main biopolymer showed a significantly faster broadening (ΔHpp) of 16-doxyl-stearate ESR spectrum when compared to glucose syrup capsules. This finding indicates a higher oxygen permeability of dextran capsules than glucose syrup capsules, which is explained by a reduced average free volume in the glucose syrup matrix than in the dextran shell. Moreover, glucose syrup capsules showed a significantly lower increase in the peak-to-peak amplitude of N-tert-butyl-α-phenylnitrone (PBN) ESR spectrum during storage when compared to dextran capsules. This implies a higher oxidative stability of glucose syrup capsules than dextran capsules, which correlated well with the lower oxygen permeability of the former. These results indicated the importance of the oxygen barrier properties of the wall materials when encapsulating long chain omega-3 polyunsaturated fatty acids by electrospraying.","author_count":5,"contributors":["Boerekamp, Demi M. W.","Andersen, Mogens L.","Jacobsen, Charlotte","Chronakis, Ioannis S.","García Moreno, Pedro Jesús"],"cuid":["S02-100.00-034893"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"corresponding_author":["García Moreno, Pedro Jesús"],"keyword":["Electron spin resonance","Electrospraying","Encapsulation","Lipid oxidation","Omega 3"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"oxygen permeability and oxidative stability of fish oil loaded electrosprayed capsules measured by electron spin resonance effect of dextran and glucose syrup as main encapsulating materials","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/169757986/Oxygen_permeability_of_electrosprayed_capsules.pdf","version":"Authors Final Version"},"id":"S02-100.00-034893","identifier":[{"id":"000460630600035","type":"wos"},{"id":"85062261161","type":"scopus"},{"id":"30857702","type":"pmid"}],"ids":["dtu-64b4e724-6684-4e12-848c-f060dab973be","ku-29e08049-8186-4df8-b214-11a794decb12"],"keyword":["Electron Spin Resonance","Electrospraying","Encapsulation","Lipid oxidation","Omega-3"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-8805DFB6D55A0C7DF61FC01AAEEC7B4B"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/169757986/Oxygen_permeability_of_electrosprayed_capsules.pdf","version":"Authors Final Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/248552303/Oxygen_permeability_of_electrosprayed_capsules.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","country":"dk","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Food Science, Ingredient and Dairy Technology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Demi M. W.","key":"boerekamppau","last":"Boerekamp","name":"Boerekamp, Demi M. W.","rank":1,"rolecode":"pau"},{"affno":"2","first":"Mogens L.","key":"andersenpau","last":"Andersen","locid":"cb1b131f-69dc-46eb-bb7a-5d0161d84ab5","name":"Andersen, Mogens Larsen","name_org":"Andersen, Mogens L.","orcid":"0000-0003-4694-486X","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Charlotte","key":"jacobsenpau","last":"Jacobsen","locid":"36158d7c-a1ce-4b85-a240-93c6218ea6be","name":"Jacobsen, Charlotte","orcid":"0000-0003-3540-9669","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ioannis S.","key":"chronakispau","last":"Chronakis","locid":"51d301e1-70d6-4790-980e-a53d3b9832f6","name":"Chronakis, Ioannis S.","orcid":"0000-0001-8339-3564","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Pedro Jesús","key":"garcíamorenopau","last":"García Moreno","locid":"7a4e845b-a50d-4b19-979b-9d6bb7c79d2d","name":"García Moreno, Pedro Jesús","orcid":"0000-0002-9793-1826","rank":5,"rolecode":"pau"}],"pmid":["30857702"],"pub":{"doi":"10.1016/j.foodchem.2019.02.096","issn":["03088146","18737072"],"issn_org":["03088146"],"journal":"Food Chemistry","pages":"287-294","publisher":"Elsevier","status":"p","title":"Food Chemistry","volume":"287"},"review":"Peer Reviewed","scoID":["2-s2.0-85062261161"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-64b4e724-6684-4e12-848c-f060dab973be","ku-29e08049-8186-4df8-b214-11a794decb12"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Oxygen permeability and oxidative stability of fish oil-loaded electrosprayed capsules measured by Electron Spin Resonance: Effect of dextran and glucose syrup as main encapsulating materials","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-034893","year":"2019","yearsub":"2019"}
{"abstract":"A longitudinal study was performed in three Danish farrow to grower (30 kilos) herds over a 4-month period to investigate the dynamics and clinical impacts of influenza A virus (IAV) infections. In each herd, four batches consisting of four sows each with five ear-tagged piglets were included. Nasal swabs and/or blood were sampled from the sows and/or the piglets prior to farrowing and at weeks 1, 3, and 5 and at the end of the nursery period. Clinical examinations were performed at each sampling time. The sows and piglets were tested for IAV and IAV antibodies in nasal swabs and blood samples, respectively. The results revealed three enzootically infected herds, where the majority of the pigs were infected during the first 5 weeks after birth. Infected piglets of only 3 days of age were detected in the farrowing unit, where the sows were also shedding virus. In all herds, low to moderate numbers of infected pigs (ranging from 3.6 to 20.7%) were found to be virus positive in nasal swabs at two consecutive sampling times. Furthermore, clinical signs of respiratory disease were associated with IAV detection. The findings of this study documented that IAV can persist in herds and that piglets as young as 3 days can be infected despite the presence of maternally derived antibodies.","author_count":6,"contributors":["Ryt-Hansen, Pia","Larsen, Inge","Kristensen, Charlotte Sonne","Krog, Jesper Schak","Wacheck, Silke","Larsen, Lars Erik"],"cuid":["S02-100.00-038010"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD"],"corresponding_author":["Ryt-Hansen, Pia"],"country":["Germany"],"glorg":["All Global Affiliations","IDT Biologika GmbH"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-SEGES"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-PR-SEGES","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"longitudinal field studies reveal early infection and persistence of influenza a virus in piglets despite the presence of maternally derived antibodies","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s13567-019-0655-x","version":"Published Version"},"id":"S02-100.00-038010","identifier":[{"id":"31113477","type":"pmid"},{"id":"85066461593","type":"scopus"},{"id":"PMC6530179","type":"pmcid"}],"ids":["dtu-f3dff437-7a81-4ce0-b2c0-3526a2f9999f","ku-d0a72c54-231a-4702-aa4c-d0dc92b77c48"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-5607903A4F2FDEC10B5D9D80E2D80867"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s13567-019-0655-x","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/226532492/s13567_019_0655_x.pdf","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/180020068/Ryt_Hansen2019_Article_LongitudinalFieldStudiesReveal.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Veterinary Institute","Technical University of Denmark, National Veterinary Institute, Division for Diagnostics & Scientific Advice, Virology"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary and Animal Sciences, Production, Nutrition and Health"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"dk","key":"seges innovation","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-SEGES","l3nn":"SEGES Innovation","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SEGES Innovation","namevar":["SEGES"],"nora_code":"DI-PR-SEGES","used":1},{"affno":"4","country":"de","key":"idt biologika gmbh","loc":["Germany","Europe, EU","OECD"],"name":"IDT Biologika GmbH","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Pia","key":"rythansenpiapau","last":"Ryt-Hansen","locid":"14d7fe91-822b-4f95-a07c-9479df41d8c5","name":"Ryt-Hansen, Pia","rank":1,"rolecode":"pau"},{"affno":"2","first":"Inge","key":"larseningepau","last":"Larsen","locid":"82b09bf9-73d5-4c71-a3c1-01e66b0e9ebe","name":"Larsen, Inge","orcid":"0000-0003-4575-2241","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Charlotte Sonne","key":"kristensencharlottesonnepau","last":"Kristensen","name":"Kristensen, Charlotte Sonne","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Schak","key":"krogjesperschakpau","last":"Krog","locid":"1e238a71-3075-4303-91fe-3cedb620123d","name":"Krog, Jesper Schak","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Silke","key":"wachecksilkepau","last":"Wacheck","name":"Wacheck, Silke","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars Erik","key":"larsenlarserikpau","last":"Larsen","locid":"09c2a33d-b353-44de-a850-f3c7dec879cb","name":"Larsen, Lars Erik","orcid":"0000-0003-0730-5555","rank":6,"rolecode":"pau"}],"pmid":["31113477"],"pub":{"doi":"10.1186/s13567-019-0655-x","issn":["09284249","12979716"],"issn_org":["09284249"],"issue":"1","journal":"Veterinary Research","paperid":"36","publisher":"BioMed Central Ltd.","status":"p","title":"Veterinary Research","volume":"50"},"review":"Peer Reviewed","scoID":["2-s2.0-85066461593"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Private Research","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-f3dff437-7a81-4ce0-b2c0-3526a2f9999f","ku-d0a72c54-231a-4702-aa4c-d0dc92b77c48"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Longitudinal field studies reveal early infection and persistence of influenza A virus in piglets despite the presence of maternally derived antibodies","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-038010","year":"2019","yearsub":"2019"}
{"abstract":"Background: Recent studies suggest that aspirin use may improve survival in patients with prostate cancer. Objective: To assess the association between postdiagnosis use of low-dose aspirin and prostate cancer mortality. Design: Nationwide cohort study. Setting: Denmark. Patients: Men with incident prostate adenocarcinoma between 2000 and 2011. Measurements: Nationwide registry data on tumor characteristics, drug use, primary prostate cancer therapy, comorbidity, and socioeconomic parameters. Postdiagnosis use of low-dose aspirin (75 to 150 mg) was defined as 2 or more prescriptions filled within 1 year after prostate cancer diagnosis. Follow-up started 1 year after prostate cancer diagnosis. In secondary analyses, low-dose aspirin use was assessed within exposure periods of 5 or 7.5 years after prostate cancer diagnosis. Results: Of 29 136 patients (median age, 70 years), 7633 died of prostate cancer and 5575 died of other causes during a median follow-up of 4.9 years (interquartile range, 3.1 to 7.2 years), through 2015. Postdiagnosis low-dose aspirin use was associated with adjusted hazard ratios (HRs) of 0.95 (95% CI, 0.89 to 1.01) for prostate cancer-specific mortality and 1.12 (CI, 1.05 to 1.20) for other-cause mortality. The secondary analyses showed that prostate cancer mortality was slightly reduced with low-dose aspirin use after the 5-year (HR, 0.91 [CI, 0.83 to 1.01]) and 7.5-year (HR, 0.84 [CI, 0.72 to 0.97]) postdiagnosis exposure periods, notably among patients filling prescriptions for a large quantity of low-dose aspirin tablets during the 7.5-year period. Limitations: Data on over-the-counter aspirin use were unavailable. Some residual confounding was possible as a result of incomplete data on some prognostic factors. Conclusion: The study did not support an overall effect of postdiagnosis low-dose aspirin use on prostate cancer mortality. However, results for extended exposure periods suggest that low-dose aspirin use might be inversely associated with prostate cancer mortality after 5 years from cancer diagnosis. Primary Funding Source: Danish Cancer Society.","author_count":11,"contributors":["Skriver, Charlotte","Dehlendorff, Christian","Borre, Michael","Brasso, Klaus","Larsen, Signe Benzon","Dalton, Susanne Oksbjerg","Nørgaard, Mette","Pottegård, Anton","Hallas, Jesper","Sørensen, Henrik Toft","Friis, Søren"],"cuid":["S03-099.91-020915"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"corresponding_author":["Skriver, Charlotte"],"keyword":["Adenocarcinoma diagnosis","Adult","Age of Onset","Aged","Aged 80 and over","Anti Inflammatory Agents Non Steroidal administration dosage","Aspirin administration dosage","Cause of Death","Cohort Studies","Denmark epidemiology","Humans","Male","Middle Aged","Neoplasm Grading","Proportional Hazards Models","Prostatic Neoplasms diagnosis","Registries","Risk Factors"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-NP","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-ZEA"],"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-ZEA","DI-NP-CAN","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"use of low dose aspirin and mortality after prostate cancer diagnosis a nationwide cohort study","src":["au","ku","sdu"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85063916988","version":"Other Version"},"funding_acknowledgement":["We tested the proportional hazards assumption with scaled Schoenfeld residuals and found no violations. All statistical analyses were performed with statistics software R, version 3.5.0 (R Foundation for Statistical Computing) (40). The study was approved by the Danish Data Protection Agency. According to Danish law, ethics committee approval was not required (41). Grant Support: By grant R79-A5286 from the Danish Cancer Society."],"id":"S03-099.91-020915","identifier":[{"id":"85063916988","type":"scopus"},{"id":"30831581","type":"pmid"}],"ids":["au-709c1523-6e62-49fc-bde9-41149ef90330","ku-555fe786-f103-4e98-b978-4f038e7118db","sdu-48d7fefa-ee56-41a5-8cf6-e6b163a184f0"],"keyword":["Adenocarcinoma/diagnosis","Adult","Age of Onset","Aged","Aged, 80 and over","Anti-Inflammatory Agents, Non-Steroidal/administration & dosage","Aspirin/administration & dosage","Cause of Death","Cohort Studies","Denmark/epidemiology","Humans","Male","Middle Aged","Neoplasm Grading","Proportional Hazards Models","Prostatic Neoplasms/diagnosis","Registries","Risk Factors"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-6CE959A9F00A958228E90CED129CA962"],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","country":"dk","key":"dcrc danish cancer society research center","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-CAN","l3nn":"DCRC Danish Cancer Society Research Center","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DCRC Danish Cancer Society Research Center","namevar":["Danish Cancer Society"],"nora_code":"DI-NP-CAN","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Urology"],"nora_code":"DI-U-AU","used":1},{"affno":"3","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark 