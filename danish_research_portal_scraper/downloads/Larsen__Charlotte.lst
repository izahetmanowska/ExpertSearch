locid":"24d1ff54-7fff-47fc-9400-f9ca868cdc2a","name":"Valentiner, Laura Staun","name_org":"Valentiner, Laura S.","orcid":"0000-0001-7261-5950","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kristian","key":"karstoftkristianpau","last":"Karstoft","name":"Karstoft, Kristian","rank":8,"rolecode":"pau"},{"affno":"3","country":"dk","first":"Henning","key":"langberghenningpau","last":"Langberg","locid":"aa9694cb-06fd-4f81-a6f7-c5862f8d3499","name":"Langberg, Henning","orcid":"0000-0001-8454-6534","rank":9,"rolecode":"pau"},{"affno":"3","first":"Allan A.","key":"vaagallanpau","last":"Vaag","locid":"4b68020d-63cf-4701-ad10-cbc4845d0f1c","name":"Vaag, Allan","name_org":"Vaag, Allan A.","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Allan A","key":"vaagallanapau","last":"Vaag","name":"Vaag, Allan A","rank":10,"rolecode":"pau"},{"affno":"3","first":"Bente K.","key":"pedersenbenteklarlundpau","last":"Pedersen","locid":"5d38d54e-e0d1-4397-98ca-6d8c9b78606d","name":"Pedersen, Bente Klarlund","name_org":"Pedersen, Bente K.","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Bente K","key":"pedersenbentekpau","last":"Pedersen","name":"Pedersen, Bente K","rank":11,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Jens S","key":"nielsenjenssteenpau","last":"Nielsen","locid":"dbe41314-5802-4a25-853c-1dd6986e2d58","name":"Nielsen, Jens Steen","name_org":"Nielsen, Jens S","orcid":"0000-0003-3179-1186","rank":12,"rolecode":"pau"},{"affno":"","first":"Jens S.","key":"nielsenjensspau","last":"Nielsen","name":"Nielsen, Jens S.","rank":12,"rolecode":"pau"}],"pmid":["27360966"],"pub":{"doi":"10.1249/01.mss.0000486814.26742.57","issn":["01959131","15300315"],"issn_org":["01959131"],"issue":"Suppl. 1 5S","journal":"Medicine and Science in Sports and Exercise","pages":"604-605","paperid":"2141","publisher":"Lippincott Williams and Wilkins","status":"p","title":"Medicine and Science in Sports and Exercise","volume":"48"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-86a3a8c9-0aaf-487f-9333-2fef547c8f9d","sdu-ce0b0448-af66-436a-aa78-1692c45691ed"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Smartphone-app-delivered Interval Walking Training In Denmark : User Characteristics And Predictors Of Adherence","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-094.12-044094","year":"2016","yearsub":"2016"}
{"abstract":"In this paper we investigate photo sharing practices among young people on the ephemeral social media platform Snapchat. What kind of photos are exchanged amongst 12–17 year olds via this app where pictures are elicited after up to 10 seconds? How is the content of the photos perceived by the young people themselves? We employ an Internet-mediated mixed methods approach. The primary empirical material consists of an online survey focusing on photo-elicitation practices on the two platforms Snapchat and Instagram conducted in 2015 and 2016 amongst Danish young people. Our results suggest that Snapchat is a site for intimacy in that pictures of double chins, ugliness and self-exposure are shared. These activities of photo-sharing and photo-communication bind young people in closeness and friendships. In this respect Snapchat differs from, for instance, Instagram where the pictures shared tend to be more polished, neat and perfect. The intimacy shared and maintained on Snapchat does, however, also cover nudes, dickpics and tarnished pictures. In this respect, intimacy entails both the comfort of sharing and the dramas of disruptions.","author_count":2,"contributors":["Kofoed, Jette","Larsen, Malene Charlotte"],"cuid":["S02-096.00-004593"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Instagram","Intimacy","Snapchat","Social media","Ungdomskultur"],"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Department of Educational Psychology, The Danish University of Education"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"a snap of intimacy photo sharing practices among young people on social media","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.5210/fm.v21i11.6905","version":"Published Version"},"id":"S02-096.00-004593","identifier":[{"id":"84996636885","type":"scopus"}],"ids":["aau-5e9c33b6-8389-44ce-96d4-b8625cdb893c","au-7f42b8cc-4b94-4a59-832d-30047320d630"],"keyword":["Instagram","Intimacy","Photo sharing practices","Snapchat","Social media","Ungdomskultur"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-4-290698CE1AE14B87B7F0FB792CC24F4C"],"oa_link":[{"access":"oa","type":"rem","url":"http://firstmonday.org/ojs/index.php/fm/article/view/6905/5648","version":"Published Version"},{"access":"oa","type":"loc","url":"https://pure.au.dk/ws/files/118606667/Kofoed.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.5210/fm.v21i11.6905","version":"Published Version"}],"oai":{"class":"Realised","mra":["Humanities (HUM)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, Danish School of Education, Danish School of Education - Education Studies, Emdrup"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Department of Educational Psychology, The Danish University of Education"],"nora_code":"DI-OT","used":1},{"affno":"3","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Humanities","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Mattering: Centre for Discourse & Practice"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"Jette","key":"kofoedpau","last":"Kofoed","locid":"641b3779-e4ce-4fb4-86c9-a92ce25dab77","name":"Kofoed, Jette","orcid":"0000-0002-5736-1267","rank":1,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Malene Charlotte","key":"larsenpau","last":"Larsen","locid":"cc0033d3-6794-4e0c-b451-939e05f9a1ee","name":"Larsen, Malene Charlotte","orcid":"0000-0003-4821-5855","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.5210/fm.v21i11.6905","issn":["13960458","13960466"],"issn_org":["13960466"],"issue":"11","journal":"First Monday","publisher":"First Monday Editorial Group","status":"p","title":"First Monday","title_org":"First Monday (Chicago)","volume":"21"},"review":"Peer Reviewed","scoID":["2-s2.0-84996636885"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["aau-5e9c33b6-8389-44ce-96d4-b8625cdb893c","au-7f42b8cc-4b94-4a59-832d-30047320d630"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"A snap of intimacy : Photo-sharing practices among young people on social media","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-096.00-004593","year":"2016","yearsub":"2016"}
{"abstract":"Oral treatment with antimicrobials is widely used in pig production for the control of gastrointestinal infections. Lawsonia intracellularis (LI) causes enteritis in pigs older than six weeks of age and is commonly treated with antimicrobials. The objective of this study was to evaluate the efficacy of three oral dosage regimens (5, 10 and 20mg/kg body weight) of oxytetracycline (OTC) in drinking water over a five-day period on diarrhoea, faecal shedding of LI and average daily weight gain (ADG). A randomised clinical trial was carried out in four Danish pig herds. In total, 539 animals from 37 batches of nursery pigs were included in the study. The dosage regimens were randomly allocated to each batch and initiated at presence of assumed LI-related diarrhoea. In general, all OTC doses used for the treatment of LI infection resulted in reduced diarrhoea and LI shedding after treatment. Treatment with a low dose of 5mg/kg OTC per kg body weight, however, tended to cause more watery faeces and resulted in higher odds of pigs shedding LI above detection level when compared to medium and high doses (with odds ratios of 5.5 and 8.4, respectively). No association was found between the dose of OTC and the ADG. In conclusion, a dose of 5mg OTC per kg body weight was adequate for reducing the high-level LI shedding associated with enteropathy, but a dose of 10mg OTC per kg body weight was necessary to obtain a maximum reduction in LI shedding.","author_count":6,"contributors":["Larsen, Inge","Hjulsager, Charlotte Kristiane","Holm, Anders","Olsen, John Elmerdahl","Nielsen, Søren Saxmose","Nielsen, Jens Peter"],"cuid":["S02-096.74-036217"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Lawsonia intracellularis","Oxytetracycline","Pig"],"level":"sci","mra":["med","sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Svinepraksis.dk"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"a randomised clinical trial on the efficacy of oxytetracycline dose through water medication of nursery pigs on diarrhoea faecal shedding of i lawsonia intracellularis i and average daily weight gain","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84958774628","version":"Other Version"},"id":"S02-096.74-036217","identifier":[{"id":"84958774628","type":"scopus"},{"id":"26718056","type":"pmid"}],"ids":["dtu-9f9c21e6-2558-41e8-8569-7f14558de3f6","ku-2a3dd476-2853-4cfa-9b37-b91bec91f67e"],"keyword":["Lawsonia intracellularis","Oxytetracycline","Pig","Randomised clinical field trial","Treatment dose"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-B2468D268C7761F0ADDBC65303A190F8"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary and Animal Sciences, Section for Production and Health"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Veterinary Institute"],"nora_code":"DI-U-DTU","used":1},{"affno":"3","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Svinepraksis.dk"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","first":"Inge","key":"larseningepau","last":"Larsen","locid":"82b09bf9-73d5-4c71-a3c1-01e66b0e9ebe","name":"Larsen, Inge","orcid":"0000-0003-4575-2241","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Charlotte Kristiane","key":"hjulsagercharlottekristianepau","last":"Hjulsager","locid":"6c1511ef-8211-4653-8c81-cd55b7f63f64","name":"Hjulsager, Charlotte Kristiane","orcid":"0000-0001-7557-8876","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Anders","key":"holmanderspau","last":"Holm","name":"Holm, Anders","rank":3,"rolecode":"pau"},{"affno":"1","first":"John Elmerdahl","key":"olsenjohnelmerdahlpau","last":"Olsen","locid":"d7f792e1-ac2c-4d67-8887-3615a3a98edb","name":"Olsen, John Elmerdahl","orcid":"0000-0001-6225-6587","rank":4,"rolecode":"pau"},{"affno":"1","first":"Søren Saxmose","key":"nielsensørensaxmosepau","last":"Nielsen","locid":"8d00f12a-fe80-48ba-96c2-6769b91281e7","name":"Nielsen, Søren Saxmose","orcid":"0000-0003-2417-0787","rank":5,"rolecode":"pau"},{"affno":"1","first":"Jens Peter","key":"nielsenjenspeterpau","last":"Nielsen","locid":"e550301c-f89e-4a8b-bf34-e6fc3b76ff37","name":"Nielsen, Jens Peter","rank":6,"rolecode":"pau"}],"pmid":["26718056"],"pub":{"doi":"10.1016/j.prevetmed.2015.12.004","issn":["01675877","18731716"],"issn_org":["01675877"],"issue":"1","journal":"Preventive Veterinary Medicine","pages":"52-9","publisher":"Elsevier","status":"p","title":"Preventive Veterinary Medicine","volume":"123"},"review":"Peer Reviewed","scoID":["2-s2.0-84958774628"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-9f9c21e6-2558-41e8-8569-7f14558de3f6","ku-2a3dd476-2853-4cfa-9b37-b91bec91f67e"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"A randomised clinical trial on the efficacy of oxytetracycline dose through water medication of nursery pigs on diarrhoea, faecal shedding of Lawsonia intracellularis and average daily weight gain","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-096.74-036217","year":"2016","yearsub":"2016"}
{"abstract":"PURPOSE: Increasing evidence suggests that aspirin use may protect against prostate cancer. In a nationwide case-control study, using Danish high-quality registry data, we evaluated the association between the use of low-dose aspirin or other nonsteroidal anti-inflammatory drugs (NSAIDs) and the risk of prostate cancer. METHODS: We identified 35,600 patients (cases) with histologically verified prostate cancer during 2000-2012. Cases were matched to 177,992 population controls on age and residence by risk-set sampling. Aspirin and nonaspirin NSAID exposure was defined by type, estimated dose, duration, and consistency of use. We used conditional logistic regression to estimate odds ratios (ORs), with 95 % confidence intervals (CIs), for prostate cancer associated with low-dose aspirin (75-150 mg) or nonaspirin NSAID use, adjusted for potential confounders. RESULTS: Use of low-dose aspirin was associated with an OR for prostate cancer of 0.94 (95 % CI 0.91-0.97). Slightly lower ORs were seen with increasing cumulative amount, duration, and consistency of low-dose aspirin use (continuous use, ≥5 years: OR 0.89; 95 % CI 0.82-0.97; ≥10 years: OR 0.86; 95 % CI 0.70-1.06). Nonaspirin NSAID use was associated with a slightly increased OR for prostate cancer (1.13; 95 % CI 1.10-1.15); however, this association was confined to localized disease and did not vary materially with amount, duration, or consistency of nonaspirin NSAID use. CONCLUSIONS: Our study indicates that long-term, consistent low-dose aspirin use may provide modest protection against prostate cancer. The slightly increased risk of only localized prostate cancer with nonaspirin NSAID use suggests a noncausal explanation of the observed association.","author_count":9,"contributors":["Skriver, Charlotte","Dehlendorff, Christian","Borre, Michael","Brasso, Klaus","Sørensen, Henrik Toft","Hallas, Jesper","Larsen, Signe Benzon","Tjønneland, Anne","Friis, Søren"],"cuid":["S03-099.02-025676"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"keyword":["Aspirin","Epidemiology","Journal Article","Nonsteroidal anti inflammatory drugs","Prostate neoplasms","Risk"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-NP","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR"],"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-NP-CAN","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"low dose aspirin or other nonsteroidal anti inflammatory drug use and prostate cancer risk a nationwide study","src":["au","ku","sdu"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84981190747","version":"Other Version"},"id":"S03-099.02-025676","identifier":[{"id":"84981190747","type":"scopus"},{"id":"000388415700003","type":"wos"},{"id":"27503490","type":"pmid"}],"ids":["au-b266946b-e02f-4491-b3c4-2384a7825a18","ku-df01067e-9c90-456e-a9f3-6954fd994956","sdu-2b590591-8cfd-43fc-911a-9b9dadd52d93"],"keyword":["Aspirin","Casecontrol study","Epidemiology","Journal Article","Nonsteroidal anti-inflammatory drugs","Prostate neoplasms","Risk"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-8B237953885A1295BF7EFEEE7CF6860C"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","country":"dk","key":"dcrc danish cancer society research center","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-CAN","l3nn":"DCRC Danish Cancer Society Research Center","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DCRC Danish Cancer Society Research Center","namevar":["Danish Cancer Society"],"nora_code":"DI-NP-CAN","used":1},{"affno":"2","key":"au aarhus universit