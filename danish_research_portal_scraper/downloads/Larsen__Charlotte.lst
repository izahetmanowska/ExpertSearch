2,"rolecode":"pau"},{"affno":"","first":"Marc","key":"deweymarcpau","last":"Dewey","name":"Dewey, Marc","rank":83,"rolecode":"pau"}],"pmid":["37991508"],"pub":{"doi":"10.1007/s00330-023-10355-2","issn":["09387994","14321084"],"issn_org":["09387994"],"journal":"European Radiology","pages":"4127-4141","status":"p","title":"European Radiology"},"review":"Peer Reviewed","scoID":["2-s2.0-85177441384"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-b91f41d0-cf26-4f51-89fc-6082644aba92"],"src":["KU University of Copenhagen"],"title":"Impact of smoking in patients with suspected coronary artery disease in the randomised DISCHARGE trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-748986","year":"2024","yearsub":"2024"}
{"abstract":"Early debates within subcultural theory have criticized the field for its male bias and its tendency to ignore girls’ culture. This criticism may still be highly relevant in terms of digital girl culture and digital sites of resistance and dissent. Based on interviews with early adolescents (n=80; age 12-16), we discovered how posting low-quality, seemingly random, out-of-context content onto private Snapchat stories was an integral part of online girl culture referred to as ‘shitposting’. This digital practice of ‘shitposting’ shows how the technologies and functionalities of social media can be used to create insulated, well-hidden, and unspectacular sites of resistance towards dominant notions of femininity associated with success, perfectionism, and flawlessness, i.e., emphasized young femininity. We argue that this resistance arises in the face of a pervasive and dominant achievement culture that continuously pressures young people to strive towards success, perfection, and personal achievements in all areas of life. While previous research has found shitposting to be a masculine practice, particularly within more extreme groups, the feminine version of shitposting may have been overlooked due to its hidden, mundane, and unspectacular nature. It is, however, equally important as it informs us about contemporary young femininity as a site of resistance.","author_count":3,"contributors":["Krogh, Søren Christian","Jensen, Sune Qvotrup","Larsen, Malene Charlotte"],"cuid":["S01-000.00-752108"],"filters":{"added":"2024-09","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Femininity","Girls","Resistance","Social media","Subculture"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"girl culture unspectacular resistance and social media a study of how adolescent girls undo emphasized femininity through shitposting","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1080/13676261.2024.2392631","version":"Published Version"},"id":"S01-000.00-752108","identifier":[{"id":"85201595067","type":"scopus"}],"ids":["aau-4320b988-2b8b-47dd-8157-47eb8832fbaf"],"keyword":["achievement culture","femininity","girls","resistance","social media","subculture"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-4-6F689761C8D04F1C2CC5B948D561BA36"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.tandfonline.com/doi/full/10.1080/13676261.2024.2392631","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1080/13676261.2024.2392631","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Social Sciences and Humanities","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Culture and Learning","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Culture and Learning, Centre for Youth Research (CeFU)"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Søren Christian","key":"kroghpau","last":"Krogh","locid":"445a979c-2304-4238-8b69-ad56b51e23e5","name":"Krogh, Søren Christian","orcid":"0000-0001-7179-0570","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sune Qvotrup","key":"jensenpau","last":"Jensen","locid":"4303b43d-3d13-4d1b-9627-8ab36ab05046","name":"Jensen, Sune Qvotrup","orcid":"0000-0001-7619-6650","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Malene Charlotte","key":"larsenpau","last":"Larsen","locid":"cc0033d3-6794-4e0c-b451-939e05f9a1ee","name":"Larsen, Malene Charlotte","orcid":"0000-0003-4821-5855","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1080/13676261.2024.2392631","issn":["13676261","14699680"],"issn_org":["13676261"],"journal":"Journal of Youth Studies","publisher":"Routledge","status":"e","title":"Journal of Youth Studies"},"review":"Peer Reviewed","scoID":["2-s2.0-85201595067"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["E-Published (ahead of print)"]},"sid":["aau-4320b988-2b8b-47dd-8157-47eb8832fbaf"],"src":["AAU Aalborg University"],"title":"Girl Culture, Unspectacular Resistance and Social Media – A Study of How Adolescent Girls Undo Emphasized Femininity through Shitposting","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-752108","year":"2024","yearsub":"2025"}
{"abstract":"How can we understand the constitution of unequal possibilities of participation in societal institutions of education? In this paper, we want to shift the conceptual focus on inequality from issues outside societal institutions for children and young people (intergenerational transmission, family relationships, social background) to how the involved are dealing with social conflicts and historical contradictions within these institutions. This conceptual turn emphasises possibilities of participation in social situations and leads to a concept of ’situated inequality’ – but what is meant by ‘participation’ and ‘participation possibilities’? How to observe social possibilities for participation and not just individual children, and how to work professionally and differently with the way children and their adults make up conditions for the participation of one another? Different professionals across children's lives simultaneously have common tasks in relation to the children and different areas of responsibility and perspectives on the issues surrounding the children. The collaboration between professionals is thus both necessary and conflictual. To strengthen the conditions of the children’s conduct of everyday life across contexts we need to conceptualise ‘conflicts’ as related to collaboration on common but still contradictory matters - in the everyday life of educational institutions, different considerations must be reconciled every day through a flexible and exploring ‘conflictual collaboration’. From a social practice perspective and in collaboration with professionals we explore situated inequality, and in the paper we will discuss and exemplify theoretical development in relation to the concept of participation.","author_count":2,"contributors":["Højholt, Charlotte","Røn Larsen, Maja"],"cuid":["S01-000.00-755153"],"event":{"end":"2024-05-24","place":"Belgrade, rs","start":"2024-05-20","title":"20th Conference of the International Society for Theoretical Psychology","year":"2024"},"filters":{"added":"2024-09","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-RUC"]},"level3all":["DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"conceptual development of participation in and conflicts about educational institutions","src":["ruc"],"src-code":["DI-U-RUC"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/105237684/Paper_ISTP_The_Concept_of_Participation_-_H_jholt_R_n_Larsen.docx","version":"Published Version"},"id":"S01-000.00-755153","ids":["ruc-056c7efb-7105-483a-a2dd-48c3ebf83837"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-BC1548C532734323DAD379FFE9510B8C"],"oa_link":[{"access":"oa","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/105237684/Paper_ISTP_The_Concept_of_Participation_-_H_jholt_R_n_Larsen.docx","version":"Published Version"}],"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of People and Technology","Roskilde University, Department of People and Technology, Subject, Technology and Social Practice"],"nora_code":"DI-U-RUC","used":1}],"person":[{"affno":"1","country":"dk","first":"Charlotte","key":"højholtpau","last":"Højholt","locid":"e1ae7eb0-773c-4cc6-84ac-4868fa79025a","name":"Højholt, Charlotte","orcid":"0000-0003-0601-0456","rank":1,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Maja","key":"rønlarsenpau","last":"Røn Larsen","locid":"43249523-b160-4888-8421-4a606d27561a","name":"Røn Larsen, Maja","orcid":"0000-0003-1413-6059","rank":2,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Roskilde University","Universities"],"PST":["Published"]},"sid":["ruc-056c7efb-7105-483a-a2dd-48c3ebf83837"],"src":["RUC Roskilde University"],"title":"Conceptual development of ‘participation’ in and ‘conflicts’ about educational institutions","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-755153","year":"2024","yearsub":"2024"}
