, Britt","orcid":"0000-0003-2702-0231","rank":6,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Lars","key":"thrysøelarspau","last":"Thrysoee","locid":"4ea79133-0f0f-4bcc-a63d-b68be155dfc5","name":"Thrysøe, Lars","name_org":"Thrysoee, Lars","rank":7,"rolecode":"pau"},{"affno":"3 7","corresponding":null,"first":"Charlotte Brun","key":"thorupcharlottebrunpau","last":"Thorup","locid":"90bf6dfd-49cd-42dc-a945-c22f8561c981","name":"Thorup, Charlotte Brun","rank":8,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Rikke Elmose","key":"molsrikkeelmosepau","last":"Mols","locid":"3e2aef4e-9f9f-433c-91c5-e30cee4aa5dc","name":"Mols, Rikke Elmose","rank":9,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Henrik","key":"wiggershenrikpau","last":"Wiggers","locid":"aef6a13e-8c07-474c-a4f6-bc35236a6eda","name":"Wiggers, Henrik","rank":10,"rolecode":"pau"},{"affno":"3 7","corresponding":null,"country":"dk","first":"Søren Paaske","key":"johnsensørenpaaskepau","last":"Johnsen","locid":"c3e8b374-a343-484a-a10d-e6550efbb8dc","name":"Johnsen, Søren Paaske","orcid":"0000-0002-2787-0271","rank":11,"rolecode":"pau"}],"pmid":["32232437"],"pub":{"doi":"10.1093/ehjqcco/qcaa026","issn":["20581742"],"issue":"4","journal":"European heart journal. Quality of care & clinical outcomes","pages":"397-406","paperid":"qcaa026","publisher":"Oxford University Press","status":"p","title":"European heart journal. Quality of care & clinical outcomes","title_org":"European Heart Journal - Quality of Care & Clinical Outcomes","volume":"7"},"review":"Peer Reviewed","scoID":["2-s2.0-85109166907"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-8b3c41a7-df9e-45f3-9f48-d89a38c3883b","au-de55841d-90f8-46cd-b27a-20ca2df5278d","sdu-74ceab2d-e65a-45db-b1f8-8166d5e41676"],"src":["AAU Aalborg University","AU Aarhus University","SDU University of Southern Denmark"],"title":"Prognostic Impact of Self-Reported Health on Clinical Outcomes in Patients with Heart Failure","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-093.74-697759","year":"2021","yearsub":"2021"}
{"abstract":"Background The selection of patients with non-small cell lung cancer (NSCLC) for immune checkpoint inhibitor (ICI) treatment remains challenging. This real-world study aimed to compare the overall survival (OS) before and after the implementation of ICIs, to identify OS prognostic factors, and to assess treatment data in first-line (1L) ICI-treated patients without epidermal growth factor receptor mutation or anaplastic lymphoma kinase translocation. Methods Data from the Danish NSCLC population initiated with 1L palliative antineoplastic treatment from 1 January 2013 to 1 October 2018, were extracted from the Danish Lung Cancer Registry (DLCR). Long-term survival and median OS pre-and post-approval of 1L ICI were compared. From electronic health records, additional clinical and treatment data were obtained for ICI-treated patients from 1 March 2017 to 1 October 2018. Results The OS was significantly improved in the DLCR post-approval cohort (n = 2055) compared to the pre-approval cohort (n = 1658). The 3-year OS rates were 18% (95% CI 15.6–20.0) and 6% (95% CI 5.1–7.4), respectively. On multivariable Cox regression, bone (HR = 1.63) and liver metastases (HR = 1.47), performance status (PS) 1 (HR = 1.86), and PS ≥ 2 (HR = 2.19) were significantly associated with poor OS in ICI-treated patients. Conclusion OS significantly improved in patients with advanced NSCLC after ICI implementation in Denmark. In ICI-treated patients, PS ≥ 1, and bone and liver metastases were associated with a worse prognosis.","author_count":25,"contributors":["Mouritzen, Mette Thune","Carus, Andreas","Ladekarl, Morten","Meldgaard, Peter","Nielsen, Anders W. M.","Livbjerg, Anna","Larsen, Jacob W.","Skuladottir, Halla","Kristiansen, Charlotte","Wedervang, Kim","Schytte, Tine","Hansen, Karin H.","Østby, Anne-Cathrine","Frank, Malene S.","Lauritsen, Jakob","Sørensen, Jens B.","Langer, Seppo W.","Persson, Gitte F.","Andersen, Jon L","Frary, Johanna M. C.","Drivsholm, Lars B.","Vesteghem, Charles","Christensen, Heidi Søgaard","Bjørnhart, Birgitte","Pøhl, Mette"],"cuid":["S04-100.00-002271"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"continent":["OECD","Oceania"],"corresponding_author":["Mouritzen, Mette T."],"country":["New Zealand"],"glorg":["All Global Affiliations","Palmerston North Hospital"],"keyword":["Advanced lung cancer","Anti PD 1","Cancer immunotherapy","Clinical prognostic factors","Danish registry","First line treatment","Immune checkpoint inhibitors","Non small cell lung cancer","Overall survival","Real world evidence"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-SDR","DI-HO-ZEA"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"nationwide survival benefit after implementation of first line immunotherapy for patients with advanced nsclc real world efficacy","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/cancers13194846","version":"Published Version"},"funding_acknowledgement":["Conflicts of Interest: The funding sources were not involved in the study design, collection, analysis, and interpretation of data, in the writing of the report, or in the decision to submit the article for publication. GF Persson: Advisory board Roche, Astra Zeneca, BMS, MSD, Takeda, Pfizer. Congress travels with Roche, Astra Zeneca, BMS, MSD, Takeda, Pierre Fabre. Research grants from Varian Medical Systems. M Pøhl: Honoraria for lectures and consultancy from AstraZeneca, BMS, MSD, Pfizer, Roche. SW Langer: Advisory board MSD, Roche, Pfizer. The remaining authors declare no conflict of interest. Funding: This research was funded by the Danish Health Authority’s ‘Cancer Immunotherapy Research Grant’ (grant number 05-0400-44) and the Medical Fund of the Danish Regions (2 December 2019)."],"id":"S04-100.00-002271","identifier":[{"id":"85115874983","type":"scopus"},{"id":"PMC8507718","type":"pmcid"},{"id":"34638329","type":"pmid"}],"ids":["aau-2d207d6c-be8f-4d27-a33a-67b175874576","au-463a0d26-4996-4119-8c74-1e77d33c4377","ku-ec696c90-a155-461b-9f58-fddef752ea2b","sdu-9233f1aa-5ba7-49bf-899f-5d65515b67bc"],"keyword":["Advanced lung cancer","Anti-PD-1","Cancer immunotherapy","Clinical prognostic factors","Danish registry","First-line treatment","Immune checkpoint inhibitors","Non-small cell lung cancer","Overall survival","Real-world evidence"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-7-A7D868C4C58B2ECCC720AF3C8BAABFF0"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/cancers13194846","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/450105571/cancers_13_04846.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/192570547/cancers_13_04846_1_.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/281161586/cancers_13_04846.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg