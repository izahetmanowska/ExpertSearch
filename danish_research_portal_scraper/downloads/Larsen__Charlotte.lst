, Charlotte Krog","rank":1,"role":"Editor","rolecode":"ped"},{"affno":"2","corresponding":null,"first":"Morten","key":"blomhøjped","last":"Blomhøj","name":"Blomhøj, Morten","rank":2,"role":"Editor","rolecode":"ped"},{"affno":"3","corresponding":null,"first":"Andreas","key":"eckertped","last":"Eckert","name":"Eckert, Andreas","rank":3,"role":"Editor","rolecode":"ped"},{"affno":"4","corresponding":null,"country":"dk","first":"Raimundo","key":"elicerped","last":"Elicer","locid":"a987680f-bdb2-4806-8527-0b859dae1dcf","name":"Elicer, Raimundo","orcid":"0000-0002-9772-6646","rank":4,"role":"Editor","rolecode":"ped"},{"affno":"5","corresponding":null,"first":"Rune","key":"herheimped","last":"Herheim","name":"Herheim, Rune","rank":5,"role":"Editor","rolecode":"ped"},{"affno":"6","corresponding":null,"first":"Bjarnheiður","key":"kristinsdóttirped","last":"Kristinsdóttir","name":"Kristinsdóttir, Bjarnheiður","rank":6,"role":"Editor","rolecode":"ped"},{"affno":"7","corresponding":null,"first":"Dorte Moeskær","key":"larsenped","last":"Larsen","locid":"72517d1b-e7c2-438c-bde6-6ddeeffeda20","name":"Larsen, Dorte Moeskær","orcid":"0000-0003-0866-2239","rank":7,"role":"Editor","rolecode":"ped"},{"affno":"8","corresponding":null,"first":"Guri Anne","key":"nortvedtped","last":"Nortvedt","name":"Nortvedt, Guri Anne","rank":8,"role":"Editor","rolecode":"ped"},{"affno":"9","corresponding":null,"first":"Peter","key":"nyströmped","last":"Nyström","name":"Nyström, Peter","rank":9,"role":"Editor","rolecode":"ped"},{"affno":"10 11","corresponding":null,"first":"Jóhann Örn","key":"sigurjónssonped","last":"Sigurjónsson","name":"Sigurjónsson, Jóhann Örn","rank":10,"role":"Editor","rolecode":"ped"},{"affno":"12","corresponding":null,"first":"Andreas Lindenskov","key":"tamborgped","last":"Tamborg","name":"Tamborg, Andreas Lindenskov","rank":11,"role":"Editor","rolecode":"ped"}],"pub":{"eisbn":["9789198402483"],"issn":["16513274"],"issue":"19","pages":"483","place":"København","publisher":"Swedish