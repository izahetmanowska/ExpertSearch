{"author_count":3,"contributors":["Røn Larsen, Maja","Højholt, Charlotte","Stanek, Anja Hvidtfeldt"],"cuid":["S02-093.18-048330"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["hum","med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-RUC","DI-U-SDU"]},"level3all":["DI-U-RUC","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"børnefællesskaber om de andre børns betydning at arbejde med rummelighed og forældresamarbejde","src":["ruc","sdu"],"src-code":["DI-U-RUC","DI-U-SDU"],"type":"db","type-grp":["all","pub"]},"id":"S02-093.18-048330","ids":["ruc-8938f1a5-deab-407c-a373-f639b307035a","sdu-738aa754-7183-4601-a115-417a3aa606e9"],"lang":"Danish","level":"Scientific","mra":["Humanities","Medical Science"],"noi":["Local-1-2-61C9AA50AB2010DA39B4354FB00291E8"],"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of People and Technology, Childhood, Youth and Family Life Research","Roskilde University, Department of People and Technology, Subject, Technology and Social Practice","Roskilde University, The Department of Psychology and Educational Studies"],"nora_code":"DI-U-RUC","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Psychology","SDU, The Faculty of Health Sciences, Department of Psychology, CH:LD"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","country":