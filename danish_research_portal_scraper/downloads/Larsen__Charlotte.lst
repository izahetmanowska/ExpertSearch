ame":"Gaillard, Charlotte","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper Overgård","key":"lehmannpau","last":"Lehmann","locid":"aaa6ebc3-d7cd-4663-8119-7418c5f67672","name":"Lehmann, Jesper Overgård","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lisbeth","key":"mogensenpau","last":"Mogensen","locid":"b408a8b2-3faa-4a28-b707-37f5641e7386","name":"Mogensen, Lisbeth","orcid":"0000-0001-5924-9749","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jakob","key":"sehestedpau","last":"Sehested","locid":"877cccec-c84c-4d5c-94a0-26731a4a157a","name":"Sehested, Jakob","orcid":"0000-0001-6977-6972","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Nina Aagaard","key":"poulsenpau","last":"Poulsen","locid":"c6f00bcb-f900-41bb-98ee-c685ea6f8894","name":"Poulsen, Nina Aagaard","orcid":"0000-0001-9983-9663","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lotte Bach","key":"larsenpau","last":"Larsen","locid":"204d7240-6828-4ee0-8ef5-77a4a2ac92d4","name":"Larsen, Lotte Bach","orcid":"0000-0001-9674-0107","rank":8,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-6c9f2ff7-4b50-4b6d-8b1e-cd5b2114a896"],"src":["AU Aarhus University"],"title":"Milke from cows at extended lactation should not be a concern for cheese-making","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-191269","year":"2016","yearsub":"2016"}
{"abstract":"In early April 2016, an unusual high number of point-source outbreaks of gastrointestinal disease were reported to occur in Denmark. Outbreaks were individually investigated. Two analytical studies were performed. Patient stool samples collected and analysed; positive stool samples were sequenced over the polymerase and/or capsid gene areas. Implicated lettuce heads were collected and analysed for the presence of norovirus. Foods were traced-back and traced-forward and international alert systems applied. A total of 23 linked point-source outbreaks occurred over the course of one week. Fresh green coral lettuce (Lollo Bionda lettuce) had been consumed in all settings. In a cohort study including 234 participants a dish containing green lettuce was associated with illness. Norovirus of Genogroup I (GI) was detected in samples from 28 patients comprising eight of the outbreaks. Sequencing showed GI.P2-GI.2. GI norovirus was detected in one of 20 examined lettuce heads. All lettuce consumed was supplied by the same packer who in turn had bought the lettuce from a wholesaler in France. The two lots of lettuce came from two different growers in different parts of France. Green coral lettuce produced in France was found to have caused a large series of linked norovirus outbreaks in Denmark as established by a number of lines of evidence. A similar incidence occurred in 2010. Fresh lettuce increasingly appear to be a risk food for norovirus infections.","author_count":14,"contributors":["Müller, Luise","Rasmussen, Lasse Dam","Jensen, Tenna","Schultz, Anna Charlotte","Kjelsø, Charlotte","Barnadas, Celine","Sigsgaard, Kim","Larsen, Anne Ribert","Widstrup Jensen, Carl","Jeppesen, Simon","Uhrbrand, Katrine","Hove, Nikolas","Mølbak, Kåre","Ethelberg, Steen"],"cuid":["S01-000.00-330856"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"series of norovirus outbreaks caused by consumption of green coral lettuce denmark april 000000002016","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1371/currents.outbreaks.115761d5d6de6a8bc7dd4b41f0f5f142","version":"Published Version"},"id":"S01-000.00-330856","identifier":[{"id":"27803839","type":"pmid"},{"id":"PMC5074700","type":"pmcid"}],"ids":["dtu-587a5d5a-ecb4-4e9d-b265-32160031c5cc"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-20A36CC82FFA038579FA6147B874DA7F"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1371/currents.outbreaks.115761d5d6de6a8bc7dd4b41f0f5f142","version":"Published Version"},{"access":"oa","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC5074700/","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Veterinary Institute"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Luise","key":"müllerpau","last":"Müller","name":"Müller, Luise","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lasse Dam","key":"rasmussenpau","last":"Rasmussen","locid":"a07c7150-071f-4568-b948-d11fffdaee98","name":"Rasmussen, Lasse Dam","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Tenna","key":"jensenpau","last":"Jensen","name":"Jensen, Tenna","rank":3,"rolec