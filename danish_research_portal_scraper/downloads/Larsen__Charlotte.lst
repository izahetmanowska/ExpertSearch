":"pau"},{"affno":"5","first":"Birgitte Martine","key":"viuffpau","last":"Viuff","locid":"3cb5f5fe-0b45-4668-a579-a3980b03de1f","name":"Viuff, Birgitte Martine","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Charlotte Kristiane","key":"hjulsagerpau","last":"Hjulsager","locid":"6c1511ef-8211-4653-8c81-cd55b7f63f64","name":"Hjulsager, Charlotte Kristiane","orcid":"0000-0001-7557-8876","rank":9,"rolecode":"pau"}],"pmid":["24047399"],"pub":{"doi":"10.1186/1743-422x-10-290","issn":["1743422X"],"issue":"1","journal":"Virology Journal","paperid":"290","publisher":"BioMed Central","status":"p","title":"Virology Journal","volume":"10"},"review":"Peer Reviewed","scoID":["2-s2.0-84884178868"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Technical University of Denmark","Undetermined","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["dtu-3830ca4b-9425-48c5-bf50-3d92b7c9761e","ku-f6038123-bd66-4948-99fc-f73cb05c9471","sdu-e83fb086-07d4-4da0-a999-844d2bd3594b"],"src":["DTU Technical University of Denmark","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Genetic and biological characterisation of an avian-like H1N2 swine influenza virus generated by reassortment of circulating avian-like H1N1 and H3N2 subtypes in Denmark","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-092.55-033846","year":"2013","yearsub":"2013"}
{"abstract":"Within educational research it is becoming relatively well-established that the notions of digital natives or the net generation are problematic. We need to move beyond these broad generational terms to gain a deeper understanding of the students coming to Higher Education. This is important if we want to make considered and grounded choices in relation to developing networked learning. Rather than basing our expectations and designs in flawed assumptions about students' digital readiness or broad concepts about generational traits, we need to develop a more nuanced understanding of students' attitudes and ideas about technology. In this paper we provide a first reading and analysis of 130 blog posts produced by first semester students. We discuss central themes emerging from our reading, such as ambivalence and diversity in the students' feelings and attitudes towards networked technologies. We ask what characterises these young university students, and conclude by discussing the wider implications for networked learning.","author_count":2,"contributors":["Ryberg, Thomas","Larsen, Malene Charlotte"],"cuid":["S01-000.00-096923"],"event":{"end":"2012-04-04","place":"Maastricht, nl","start":"2012-04-02","title":"The Eight International Conference on Networked Learning","year":"2012"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Digital Natives Debate","Diversity"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"tales from the lands of digital natives a journey to neverland","src":["aau"],"src-code":["DI-U-AAU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-096923","ids":["aau-a1c9841f-4c0d-429a-8027-78690c8fb7cd"],"keyword":["Ambivalende","Attitudes and ideas of technology","Digital Natives Debate","Diversity"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-866AB78288535DB5A303F8465442C566"],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Humanities","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, E-learning lab"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Thomas","key":"rybergpau","last":"Ryberg","locid":"f05994d0-d004-4702-96d9-1974cfdc2a28","name":"Ryberg, Thomas","orcid":"0000-0003-1049-8239","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Malene Charlotte","key":"larsenpau","last":"Larsen","locid":"cc0033d3-6794-4e0c-b451-939e05f9a1ee","name":"Larsen, Malene Charlotte","orcid":"0000-0003-4821-5855","rank":2,"rolecode":"pau"}],"pub":{"isbn":["9781862202849"],"pages":"4","publisher":"Networked Learning","status":"p","title":"Handbook and Abstracts for the Eight International Conference on Networked Learning 2012"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-a1c9841f-4c0d-429a-8027-78690c8fb7cd"],"src":["AAU Aalborg University"],"title":"Tales From the Lands of Digital Natives - A Journey to Neverland","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-096923","year":"2012","yearsub":"2012"}
