f34-e6fc3b76ff37","name":"Nielsen, Jens Peter","rank":8,"rolecode":"pau"}],"pmid":["22786973"],"pub":{"doi":"10.1177/1040638712452111","issn":["10406387","19434936"],"issn_org":["10406387"],"issue":"5","journal":"Journal of Veterinary Diagnostic Investigation","pages":"968-970","publisher":"SAGE Publications","status":"p","title":"Journal of Veterinary Diagnostic Investigation","volume":"24"},"review":"Peer Reviewed","scoID":["2-s2.0-84865224586"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-f400cd3f-d2c1-4c5f-9185-06c876336391","ku-486c720f-8bfc-4882-91f9-9eff71f729a7"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Within-day repeatability for absolute quantification of Lawsonia intracellularis bacteria in feces from growing pigs","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.52-038012","year":"2012","yearsub":"2012"}
{"abstract":"Within educational research it is becoming relatively well-established that the notions of digital natives or the net generation are problematic. We need to move beyond these broad generational terms to gain a deeper understanding of the students coming to Higher Education. This is important if we want to make considered and grounded choices in relation to developing networked learning. Rather than basing our expectations and designs in flawed assumptions about students' digital readiness or broad concepts about generational traits, we need to develop a more nuanced understanding of students' attitudes and ideas about technology. In this paper we provide a first reading and analysis of 130 blog posts produced by first semester students. We discuss central themes emerging from our reading, such as ambivalence and diversity in the students' feelings and attitudes towards networked technologies. We ask what characterises these young university students, and conclude by discussing the wider implications for networked learning.","author_count":8,"contributors":["Ryberg, Thomas","Larsen, Malene Charlotte"],"cuid":["S01-000.00-095875"],"event":{"acronym":"NLC","end":"2012-04-04","place":"Maastricht, nl","start":"2012-04-02","title":"The Eight International Conference on Networked Learning","year":"2012"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Ambivalence","Digital Natives Debate","Diversity","Networked Learning"],"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"tales from the lands of digital natives a journey to neverland","src":["aau"],"src-code":["DI-U-AAU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/203903110/ryberg.pdf","version":"Authors Final Version"},"id":"S01-000.00-095875","ids":["aau-9e073246-58db-4163-ad9d-9ebb866010d3"],"keyword":["Ambivalence","Networked Learning","digital natives debate","diversity"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-43DAC47E8970D5A6A756E37179D69DAB"],"oa_link":[{"access":"oa","type":"rem","url":"http://networkedlearningconference.org.uk/abstracts/pdf/ryberg.pdf","version":"Other Version"},{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/203903110/ryberg.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Humanities","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, E-learning lab"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Thomas","key":"rybergpau","last":"Ryberg","locid":"f05994d0-d004-4702-96d9-1974cfdc2a28","name":"Ryberg, Thomas","orcid":"0000-0003-1049-8239","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Malene Charlotte","key":"larsenpau","last":"Larsen","locid":"cc0033d3-6794-4e0c-b451-939e05f9a1ee","name":"Larsen, Malene Charlotte","orcid":"0000-0003-4821-5855","rank":2,"rolecode":"pau"},{"affno":"","first":"Vivien","key":"hodgsonpedh","last":"Hodgson","name":"Hodgson, Vivien","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Chris","key":"jonespedh","last":"Jones","name":"Jones, Chris","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Maarten","key":"delaatpedh","last":"de Laat","name":"de Laat, Maarten","ra