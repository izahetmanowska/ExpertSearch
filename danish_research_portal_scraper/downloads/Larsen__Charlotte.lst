endorthepau","last":"Wille-Jørgensen","name":"Wille-Jørgensen, Dorthe","rank":28,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Kasper","key":"wurrstjernqvistkasperpau","last":"Wurr Stjernqvist","locid":"74ddb89a-d000-442a-b6d4-d97e604e98d5","name":"Wurr Stjernqvist, Kasper","orcid":"0000-0001-6231-2331","rank":29,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Anders","key":"rasmussenanderspau","last":"Rasmussen","name":"Rasmussen, Anders","rank":30,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kaare Lund","key":"rasmussenkaarelundpau","last":"Rasmussen","locid":"1d3bf45c-d029-45f5-a60e-06f0c3d04592","name":"Rasmussen, Kaare Lund","orcid":"0000-0001-9575-868X","rank":31,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.jaa.2024.101587","issn":["02784165","10902686"],"issn_org":["02784165"],"journal":"Journal of Anthropological Archaeology","paperid":"101587","publisher":"Academic Press Inc.","status":"p","title":"Journal of Anthropological Archaeology","volume":"74"},"review":"Peer Reviewed","scoID":["2-s2.0-85186598072"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Miscellaneous","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Governmental Institutions","Miscellaneous","Other Research","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["kum-4f82d25d-066c-4fde-8f89-352051280904","sdu-8c0a8a75-ac1d-435d-8abe-87424821d21d"],"src":["KUM Ministry of Culture - Archives, Museums, and Royal Library Denmark","SDU University of Southern Denmark"],"title":"Variation in bioavailable lead, copper, and strontium concentrations in human skeletons from medieval to early modern Denmark","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-096.40-735605","year":"2024","yearsub":"2024"}
{"abstract":"Purpose: To meet the needs of people with mild stroke, multidisciplinary, person-centred, cross-sectoral rehabilitation is internationally recommended. However, there seem to be gaps in the rehabilitation process. The aim of this study was to investigate how occupational therapists and physiotherapists experience working in cross-sectoral rehabilitation for people with mild stroke. Materials and methods: Data were generated through interviews with occupational therapists and physiotherapists working in four different Danish rehabilitation settings. Four group interviews and two individual interviews with a total of 19 participants were conducted. Ricoeur’s theory of interpretation was used to interpret and discuss the data. Results: Four themes were identified: the risk of overlooking symptoms: better safe than sorry; varying degrees of involvement of people with mild stroke; spontaneous involvement of relatives; and contextual challenges for coherence in the rehabilitation process. Conclusion: The therapists experienced challenges in coordinating rehabilitation across sectors due to the timing of the needs assessment and contextual challenges. They used a preventive strategy of sending a plan or referral for later re-assessment. The therapists involved people with mild stroke to varying degrees. They involved relatives spontaneously. For successful rehabilitation, ongoing assessment, recognition of collaboration factors and relative involvement are essential.","author_count":5,"contributors":["Larsen, Stina Meyer","Bille-Hangaard, Kirstine","Johansson, Sverker","Ytterberg, Charlotte","Rosenbek Minet, Lisbeth Kirstine"],"cuid":["S02-097.96-769688"],"filters":{"added":"2025-01","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","Nordic","OECD"],"corresponding_author":["Larsen, Stina Meyer"],"country":["Sweden"],"glorg":["All Global Affiliations","Karolinska Institute"],"keyword":["Adult","Attitude of Health Personnel","Coordination","Cross sectoral rehabilitation","Denmark","Female","Health care professionals","Humans","Interviews as Topic","Involvement","Male","Middle Aged","Mild stroke","Needs Assessment","Occupational Therapists","Occupational Therapy","Physical Therapists","Qualitative Research","Stroke","Stroke Rehabilitation"],"level":"sci","mra":["hum","med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U","DI-UC"],"level3":{"U":["DI-U-ALL","DI-U-SDU"],"UC":["DI-UC-ALL","DI-UC-UCL"]},"level3all":["DI-U-SDU","DI-UC-UCL"]},"review":"pr","rtype":["clu"],"sorti":"physiotherapists and occupational therapists experiences with cross sectoral coordination of rehabilitation for people with mild stroke a qualitative interview study","src":["sdu","ucl"],"src-code":["DI-U-SDU","DI-UC-UCL"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1080/09638288.2024.2302560","version":"Published Version"},"id":"S02-097.96-769688","identifier":[{"id":"38214668","type":"pmid"},{"id":"85182166448","type":"scopus"}],"ids":["sdu-cc3c6b4e-e6a6-4965-a81c-820936055f64","ucl-2340e93a-aefe-4058-a80b-aa4a0886cc59"],"keyword":["Adult","Attitude of Health Personnel","Cross-sectoral rehabilitation","Denmark","Female","Humans","Interviews as Topic","Male","Middle Aged","Needs Assessment","Occupational Therapists","Occupational Therapy","Physical Therapists","Qualitative Research","Stroke","Stroke Rehabilitation","coordination","health care professionals","involvement","mild stroke"],"lang":"English","level":"Scientific","mra":["Humanities","Medical Science"],"noi":["Global-Local-2-5-B4E1C24CCB7CCF11395C2BE8ADD4CF44"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1080/09638288.2024.2302560","version":"Published Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of CIMT - Centre for Innovative Medical Technology (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"ucl university college","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-UCL","l3nl":"UCL University College","l3nn":"UCL University College","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"UCL University College","namevar":["University College Lillebælt"],"nora_code":"DI-UC-UCL","used":1},{"affno":"3","country":"se","key":"karolinska institute","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Karolinska Institute","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Stina Meyer","key":"larsenpau","last":"Larsen","locid":"99a0eef3-61fa-4791-89f7-dcdc4077c904","name":"Larsen, Stina Meyer","orcid":"0000-0001-5836-370X","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kirstine","key":"billehangaardpau","last":"Bille-Hangaard","locid":"60ef3907-2592-4c40-bd45-001d5717c16b","name":"Bille-Hangaard, Kirstine","orcid":"0009-0009-1884-4846","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Sverker","key":"johanssonpau","last":"Johansson","name":"Johansson, Sverker","rank":3,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"first":"Charlotte","key":"ytterbergpau","last":"Ytterberg","locid":"4fb99d6a-9c7b-48c3-9b56-1dce87fbead6","name":"Ytterberg, Charlotte","orcid":"0000-0003-3704-8887","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lisbeth","key":"rosenbekminetpau","last":"Rosenbek Minet","locid":"a5aaf3a3-cbf8-4709-8cda-f2d14a3e1d2b","name":"Rosenbek Minet, Lisbeth Kirstine","name_org":"Rosenbek Minet, Lisbeth","orcid":"0000-0001-6179-5183","rank":5,"rolecode":"pau"}],"pmid":["38214668"],"pub":{"doi":"10.1080/09638288.2024.2302560","issn":["09638288","14645165"],"issn_org":["09638288"],"issue":"22","journal":"Disability and Rehabilitation","pages":"5227-5234","publisher":"Informa Healthcare","status":"p","title":"Disability and Rehabilitation","volume":"46"},"review":"Peer Reviewed","scoID":["2-s2.0-85182166448"],"search":{"DAF":["All Danish Affiliations","All Universities","All University Colleges","DI-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","UCL University College","Universities","University Colleges","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-cc3c6b4e-e6a6-4965-a81c-820936055f64","ucl-2340e93a-aefe-4058-a80b-aa4a0886cc59"],"src":["SDU University of Southern Denmark","UCL University College"],"title":"Physiotherapists’ and occupational therapists’ experiences with cross-sectoral coordination of rehabilitation for people with mild stroke–a qualitative interview study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-097.96-769688","year":"2024","yearsub":"2024"}
{"abstract":"Background: Mesenchymal stromal/stem cells (MSCs) have been suggested for salivary gland (SG) restoration following radio-induced salivary gland damage. This study aimed to determine the safety and effectiveness of MSC therapy on radio-induced SG damage and hypofunction in preclinical in vivo studies. Methods: PubMed and EMBASE were systematically searched for preclinical in vivo interventional studies evaluating efficacy and safety of MSC treatment following radio-induced salivary gland damage published before 10th of January 2022. The primary endpoint was salivary flow rate (SFR) evaluated in a meta-analysis. The study protocol was published and registered on PROSPERO (www.crd.ac.uk/prospero), registration number CRD42021227336. Results: A total of 16 preclinical in vivo studies were included for qualitative analysis (858 experimental animals) and 13 in the meta-analysis (404 experimental animals). MSCs originated from bone marrow (four studies), adipose tissue (10 studies) and salivary gland tissue (two studies) and were administered intravenously (three studies), intra-glandularly (11 studies) or subcutaneously (one study). No serious adverse events were reported. The overall effect on SFR was significantly increased with a standardized mean difference (SMD) of 6.99 (95% CI: 2.55–11.42). Studies reported improvements in acinar tissue, vascular areas and paracrine factors. Conclusion: In conclusion, this systematic review and meta-analysis showed a significant effect of MSC therapy for restoring SG functioning and regenerating SG tissue following radiotherapy in preclinical in vivo studies without serious adverse events. MSC therapy holds significant therapeutic potential in the treatment of radio-induced xerostomia, but comprehensive, randomized, clinical trials in humans are required to ascertain their efficacy in a clinical setting. Graphical Abstract: (Figure presented.)","author_count":13,"contributors":["Carlander, Amanda-Louise Fenger","Gundestrup, Anders Kierkegaard","Jansson, Per Marcus","Follin, Bjarke","Hoeeg, Cecilie","Kousholt, Birgitte Saima","Larsen, Rasmus Tolstrup","Jakobsen, Kathrine Kronberg","Rimborg, Susie","Fischer-Nielsen, Anne","Grønhøj, Christian","Buchwald, Christian von","Lynggaard, Charlotte Duch"],"cuid":["S02-099.83-742115"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Carlander, Amanda Louise Fenger"],"keyword":["Cell therapy","Mesenchymal stem cells","Radiotherapy","Systematic review","Xerostomia"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-KUM"],"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-GV-KUM","DI-HO-CAP","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"mesenchymal stromal stem cell therapy improves salivary flow rate in radiation induced salivary gland hypofunction in preclinical in vivo models a systematic review and meta analysis","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s12015-024-10700-y","version":"Published Version"},"id":"S02-099.83-742115","identifier":[{"id":"001171677900002","type":"wos"},{"id":"85186428490","type":"scopus"},{"id":"PMC11087340","type":"pmcid"},{"id":"38430363","type":"pmid"}],"ids":["au-f34990f0-ec6b-4f9b-9955-b200bd30aed2","ku-f7662982-6c6e-43ba-9b55-4296561093fb"],"keyword":["Cell Therapy","Mesenchymal stem Cells","Radiotherapy","Systematic Review","Xerostomia"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-BF83782C5FAB1D3DA29299864B09D24E"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/391493740/s12015_024_10700_y_1_.pdf","version":"Published Version"},{"