st":"Cañada-García","name":"Cañada-García, Javier E.","rank":25,"rolecode":"pau"},{"affno":"1 17 18","first":"Barbara Juliane","key":"holzknechtpau","last":"Holzknecht","locid":"f0d0327c-3826-44aa-9fbc-87c759aec899","name":"Holzknecht, Barbara Juliane","rank":26,"rolecode":"pau"},{"affno":"18","first":"Helle Brander","key":"eriksenpau","last":"Eriksen","name":"Eriksen, Helle Brander","rank":27,"rolecode":"pau"},{"affno":"18","first":"Morten","key":"hoppepau","last":"Hoppe","name":"Hoppe, Morten","rank":28,"rolecode":"pau"},{"affno":"17 18","first":"Mette Damkjær","key":"bartelspau","last":"Bartels","locid":"a8d4fdbb-ac5b-43e3-8a37-5bd24affbb6e","name":"Bartels, Mette Damkjær","orcid":"0000-0002-8187-3684","rank":29,"rolecode":"pau"},{"affno":"18","first":"Jose Alfredo Samaniego","key":"castruitapau","last":"Castruita","name":"Castruita, Jose Alfredo Samaniego","rank":30,"rolecode":"pau"},{"affno":"1","first":"Tinna Ravnholt","key":"urthpau","last":"Urth","name":"Urth, Tinna Ravnholt","rank":31,"rolecode":"pau"},{"affno":"1","first":"Anders Rhod","key":"larsenpau","last":"Larsen","name":"Larsen, Anders Rhod","rank":32,"rolecode":"pau"},{"affno":"1","first":"Andreas","key":"petersenpau","last":"Petersen","name":"Petersen, Andreas","rank":33,"rolecode":"pau"}],"pmid":["40682456"],"pub":{"doi":"10.2807/1560-7917.es.2025.30.28.2500452","issn":["1025496X"],"issue":"28","journal":"Eurosurveillance","paperid":"pii=2500452","status":"p","title":"Eurosurveillance","volume":"30"},"review":"Peer Reviewed","scoID":["2-s2.0-105012052146"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-2d8421bb-f0a2-4125-8dab-523f9e298f52"],"src":["KU University of Copenhagen"],"title":"Spread of the FAR-MRSA clone, a fusidic acid- and meticillin-resistant <i>Staphylococcus</i> aureus ST121, Europe, 2014 to 2024","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-828572","year":"2025","yearsub":"2025"}
{"abstract":"Placental biopsy in early pregnancy is widely used in prenatal genetic diagnostics as a surrogate for fetal tissue. Confined placental chromosomal mosaicism is a well-documented phenomenon causing genetic discrepancies between the fetus and placenta. Although comprehensive sequencing methods are becoming popular for prenatal screening of monogenic disorders, knowledge of concordance between the fetus and early placenta at the sequence level remains limited. By deep genome sequencing, we have mapped the mutational landscape across multiple sites and stages of placental development. We have revealed wide-spread mutations, with distinct clusters of postzygotic non-fetal small sequence variants, indicating extensive clonal evolution in all early placental biopsies, including first-trimester chorionic villus samples. Our study illuminates spatial and temporal genetic heterogeneity of the developing placenta. While most clonal sequence variants in placental biopsies exhibit low variant allele frequency, their presence underscores the need for caution when using placental tissue as a fetal proxy for diagnostics. These findings highlight the importance of confirmatory testing using AF in cases where placental mosaicism is suspected to avoid misinterpretation and unnecessary interventions.","author_count":8,"contributors":["Miceikaite, Ieva","Fagerberg, Christina","Brasch-Andersen, Charlotte","Tørring, Pernille M","Kristiansen, Britta Schlott","Hao, Qin","Sperling, Lene","Larsen, Martin Jakob"],"cuid":["S01-000.00-831639"],"filters":{"added":"2025-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Miceikaite, Ieva"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"deep genome sequencing reveals extensive genetic heterogeneity in early human placentas","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41467-025-63296-3","version":"Published Version"},"id":"S01-000.00-831639","identifier":[{"id":"105013898607","type":"scopus"},{"id":"40849439","type":"pmid"}],"ids":["sdu-f38d9c84-350b-4e6b-8cbc-244e8774fc03"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-2-B82C2B0F9B1F0B960002FF1D506FE36F"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41467-025-63296-3","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/294651959/s41467-025-63296-3.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Clinical Genetics (Odense)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Ieva","key":"miceikaitepau","last":"Miceikaite","locid":"eb4ddff7-556f-465a-87af-2d89e65de326","name":"Miceikaite, Ieva","orcid":"0000-0002-5188-7647","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christina","key":"fagerbergpau","last":"Fagerberg","locid":"93aebc29-7681-4e3d-b613-867bd3a7eb65","name":"Fagerberg, Christina","orcid":"0000-0002-5206-4327","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Charlotte","key":"braschandersenpau","last":"Brasch-Andersen","locid":"3fe4d15d-5f04-4ec0-87b8-000b5f993ed1","name":"Brasch-Andersen, Charlotte","orcid":