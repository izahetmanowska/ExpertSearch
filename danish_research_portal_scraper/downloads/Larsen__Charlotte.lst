U-AAU","used":1},{"affno":"2","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Lasse Jan","key":"pedersenpau","last":"Pedersen","locid":"2637b3fb-b84f-4ef6-8976-39b51dae9d40","name":"Pedersen, Lasse","name_org":"Pedersen, Lasse Jan","orcid":"0000-0002-3299-1561","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Inge Thomsen","key":"bernsteinpau","last":"Bernstein","locid":"fc5f604f-944f-4a7b-a98b-f5db5141174b","name":"Bernstein, Inge","name_org":"Bernstein, Inge Thomsen","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Karen","key":"lindorfflarsenpau","last":"Lindorff-Larsen","locid":"44148857-c2e8-4814-86a8-28c2b1951a63","name":"Lindorff-Larsen, Karen","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Charlotte Green","key":"carlsenpau","last":"Carlsen","name":"Carlsen, Charlotte Green","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Christian","key":"torppedersenpau","last":"Torp-Pedersen","locid":"5417d806-0578-4505-b3fe-68ae0359913e","name":"Torp-Pedersen, Christian","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-ce62819d-0844-4420-bdb4-73765c7ad433"],"src":["AAU Aalborg University"],"title":"Post colonoscopy colorectal cancer (PCCRC) rates in Denmark compared with the English National Health Service (NHS)","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-109983","year":"2017","yearsub":"2017"}
{"abstract":"BACKGROUND An increasing number of patients for total hip replacement presents with cardiovascular comorbidities, that render them fragile to traditional methods of anesthesia. The aim of this intended study is to compare lumbosacral plexus blockade with continuous spinal anesthesia for surgical anesthesia in total hip replacement. We hypothesize that lumbosacral plexus blockade induces less hemodynamic impact compared to continuous spinal anesthesia. METHODS Thirty patients (ASA I-III, age ≥ 50 years) will be included for elective hip replacement after informed consent. Hemodynamics will be monitored using calibrated pulse contour analyses of the femoral artery pressure. All patients will receive a lumbar spinal catheter as well as lumbosacral plexus blockade. Group 1: Ropivacaine for the plexus blockade and placebo for the spinal catheter. Group 2: Bupivacaine for the spinal catheter and placebo for the plexus blockade. Patients, anesthesiologist and observer will be blinded for the intervention. Hemodynamic parameters will be recorded during a 1-hour-period following the interventions. RESULTS The primary endpoint will be the change in cardiac output from baseline to 30 minutes after the interventions. Secondary endpoints will include change in systemic vascular resistance, mean arterial pressure, central venous pressure and central venous oxygen saturation. CONCLUSIONS We expect that our findings will support the hypothesis of a reduced hemodynamic impact from lumbosacral plexus blockade compared to continuous spinal anesthesia. This might favor the future use of lumbosacral plexus blockade for patients with severe cardiovascular comorbidities.","author_count":7,"contributors":["Nielsen, Niels Dalsgaard","Larsen, Jens Rolighed","Børglum, Jens","Petersen, Jens Aage Kølsen","Runge, Charlotte","Søballe, Kjeld","Bendtsen, Thomas Fichtner"],"cuid":["S01-000.00-186171"],"event":{"end":"2017-01-27","place":"Aarhus, dk","start":"2017-01-27","title":"PhD Day 2017","year":"2017"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR","DI-HO-ZEA"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-HO-CDR","DI-HO-ZEA","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"is lumbosacral plexus block an effective and safe alternative as surgical anesthesia for total hip replacement","src":["au"],"src-code":["DI-U-AU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-186171","ids":["au-638731c2-b3b6-4a03-a462-ca2b730bab9d"],"lang":"Danish","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-0B46E81831570B613756CABB33CE588A"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Anaesthesiology and Operation, Intensive care"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital (AUH)"],"nora_code":"DI-HO-CDR","used":1},{"affno":"3","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Zealand University Hospital"],"nora_code":"DI-HO-ZEA","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"Niels Dalsgaard","key":"nielsenpau","last":"Nielsen","locid":"b84f99a8-73b7-49c6-b1da-3a1cd6288046","name":"Nielsen, Niels Dalsgaard","orcid":"0000-0002-5326-5729","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jens Rolighed","key":"larsenpau","last":"Larsen","name":"Larsen, Jens Rolighed","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jens","key":"børglumpau","last":"Børglum","name":"Børglum, Jens","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens Aage Kølsen","key":"petersenpau","last":"Petersen","locid":"8d594837-f6de-4e1d-90d8-eafdfbee35c3","name":"Petersen, Jens Aage Kølsen","rank":4,"rolecode":"pau"},{"affno":"2 1","corresponding":null,"country":"dk","first":"Charlotte","key":"rungepau","last":"Runge","locid":"eca83862-b388-4479-bc0b-c8a670ae52e9","name":"Runge, Charlotte","orcid":"0000-0001-9480-2490","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kjeld","key":"søballepau","last":"Søballe","locid":"288247bb-1768-4f37-a538-18727fed269b","name":"Søballe, Kjeld","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Thomas Fichtner","key":"bendtsenpau","last":"Bendtsen","locid":"089f9adf-ca15-47c2-bb41-1747197306b7","name":"Bendtsen, Thomas Fichtner","rank":7,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region Zealand","Universities"],"PST":["Published"]},"sid":["au-638731c2-b3b6-4a03-a462-ca2b730bab9d"],"src":["AU Aarhus University"],"title":"Is lumbosacral plexus block an effective and safe alternative as surgical anesthesia for total hip replacement?","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-186171","year":"2017","yearsub":"2017"}
{"abstract":"Dried distillers grain with solubles (DDGS) is an alternative source of feed protein for dairy cows. Previous studies found that DDGS, based on grains other than corn, can substitute for soybean meal and canola cake as a dietary protein source without reducing milk production or quality. As societal concerns exist, and in many areas strict regulation, regarding nitrogen excretion from dairy cows, the dairy industry has focused on reducing dietary protein level and nitrogen excretion. In the present study, we investigated the use of DDGS as a protein source, at a marginally low dietary crude protein (CP) levels, in a grass-clover and corn silage-based ration. The experiment involved 24 Holstein cows and 2 protein sources (DDGS or soybean-canola mixture) fed at 2 levels of CP (14 or 16%) in a 4 × 4 Latin square design. The aim of this study was to evaluate the effect of both protein source and protein level on feed intake, milk yield, and milk quality. The results indicated that feed intake, milk yield, and protein in milk increased when the protein level in the ration was 16% CP compared with 14%. We found no effect of substituting the soybean-canola mixture with DDGS. Moreover, no sensory problems were observed when comparing fresh milk with stored milk, and milk taste was unaffected by DDGS. Milk from cows fed DDGS had a slightly higher content of linoleic acid and conjugated linoleic acid (CLA 9–11), and lower content of C11 to C17 fatty acids than cows fed diets with the soybean-canola mixture. Cows fed the diets with 16% CP produced milk with higher oleic acids and lower palmitic acid content than cows fed 14% CP diets. To conclude, DDGS can substitute for a soybean-canola mixture without affecting feed intake, milk yield and quality, or sensory quality. Under the conditions of this experiment, feeding 16% CP compared with 14% CP in the ration can increase feed intake and milk production.","author_count":9,"contributors":["Gaillard, Charlotte","Sørensen, Martin Tang","Vestergaard, Mogens","Weisbjerg, Martin Riis","Basar, Md Abul","Larsen, Mette Krogh","Martinussen, Henrik","Kidmose, Ulla","Sehested, Jakob"],"cuid":["S01-000.00-212589"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Dairy cow","Dried distillers grains with solubles","coproduct","protein level"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-SEGES"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-PR-SEGES","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"effect of substituting soybean meal and canola cake with dried distillers grains with solubles at 000000000002 dietary crude protein levels on feed intake milk production and milk quality in dairy cows","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3168/jds.2017-12718","version":"Published Version"},"id":"S01-000.00-212589","identifier":[{"id":"85028308320","type":"scopus"},{"id":"28843683","type":"pmid"}],"ids":["au-9203198f-e119-41f1-b89e-0d3ea31e48ce"],"keyword":["coproduct","dairy cow","dried distillers grains with solubles","protein level"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-A5CBA8EF63A225B06F116114BE056FD1"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.3168/jds.2017-12718","version":"Published Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Animal and Veterinary Sciences, Department of Animal and Veterinary Sciences - ANIS Nutrition"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"seges innovation","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-SEGES","l3nn":"SEGES Innovation","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SEGES Innovation","namevar":["SEGES"],"nora_code":"DI-PR-SEGES","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Charlotte","key":"gaillardpau","last":"Gaillard","locid":"c0138828-4b44-4349-a0a0-084926bae930","name":"Gaillard, Charlotte","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Martin Tang","key":"sørensenpau","last":"Sørensen","locid":"fefc1862-587c-4b1f-9e20-694246b18221","name":"Sørensen, Martin Tang","orcid":"0000-0002-0523-4282","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mogens","key":"vestergaardpau","last":"Vestergaard","locid":"f886731d-42d7-485e-b44c-f48981a245e7","name":"Vestergaard, Mogens","orcid":"0000-0002-3630-1396","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Martin Riis","key":"weisbjergpau","last":"Weisbjerg","locid":"501c877c-de2b-4cd2-9f3c-42e223238a40","name":"Weisbjerg, Martin Riis","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Md Abul","key":"basarpau","last":"Basar","locid":"8c11c9cf-4ab6-4dd5-b9f2-44c1218d7395","name":"Basar, Md Abul","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Mette Krogh","key":"larsenpau","last":"Larsen","locid":"5ce6d5da-bd09-4304-a9d9-495e00e51fdd","name":"Larsen, Mette Krogh","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Henrik","key":"martinussenpau","last":"Martinussen","name":"Martinussen, Henrik","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ulla","key":"kidmosepau","last":"Kidmose","locid":"7a1c5721-dba1-4cbe-9786-132f693dde79","name":"Kidmose, Ulla","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","firs