{"abstract":"En ph.d.-studerendes oplevelse med svindeltids-skrifter fik professor Charlotte Wien og chefkonsulent Asger Væring Larsen til at teste de såkaldte rov- eller svindeltidsskrifter og deres forretnings-metoder. Læs om deres erfaringer.","author_count":2,"contributors":["Wien, Charlotte","Larsen, Asger Væring"],"cuid":["S01-000.00-760157"],"filters":{"added":"2024-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"pop","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"und","rtype":["clu"],"sorti":"som sendt fra helvede","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-760157","ids":["ku-94c6a837-8c70-426d-90c7-b3531b225c50"],"lang":"Danish","level":"Popular","mra":["Medical Science"],"noi":["Local-1-1-54E40925E93EF678FAD5ADDCDF7B945A"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, External Centres, Det Kgl. Bibliotek - Universitetsbibliotekarens ledelsessekretariat"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Charlotte","key":"wienpau","last":"Wien","name":"Wien, Charlotte","rank":1,"rolecode":"pau"},{"affno":"1","first":"Asger Væring","key":"larsenpau","last":"Larsen","locid":"a3465b5e-1b9d-4c08-9fc3-9a9dfa287b40","name":"Larsen, Asger Væring","orcid":"0000-0002-9967-2637","rank":2,"rolecode":"pau"}],"pub":{"issn":["19017626","19047940"],"issn_org":["16547128"],"issue":"11","journal":"Perspektiv","status":"p","title":"Perspektiv","volume":"2019"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of