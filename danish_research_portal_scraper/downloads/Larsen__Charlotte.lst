{"author_count":3,"contributors":["Larsen, Charlotte Rørdam"],"cuid":["S01-000.00-274908"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"folk high school song book","src":["au"],"src-code":["DI-U-AU"],"type":"dbp","type-grp":["all","pub"]},"id":"S01-000.00-274908","ids":["au-ff191fe0-e5a7-11df-a891-000ea68e967b"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-2CC96F49DDE4D47B0B80CFDBE27B9960"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, School of Communication and Culture, School of Communication and Culture - Musicology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Charlotte Rørdam","key":"larsenpau","last":"Larsen","locid":"4e604018-2471-4a68-a18b-0ae187425b3d","name":"Larsen, Charlotte Rørdam","orcid":"0000-0002-5465-0338","rank":1,"rolecode":"pau"},{"affno":"","first":"David","key":"hornpedh","last":"Horn","name":"Horn, David","rank":2,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"John","key":"shepherdpedh","last":"Shepherd","name":"Shepherd, John","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"edition":"1","eisbn":["9781501326134"],"isbn":["9781501326103"],"pages":"307-309","place":"London","publisher":"Bloomsbury Academic","status":"p","subtitle":"Genres: Europe","title":"Bloomsbury Encyclopedia of Popular Music of the World","volume":"11"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-ff191fe0-e5a7-11df-a891-000ea68e967b"],"src":["AU Aarhus University"],"title":"Folk High School Song Book","type":"Book Preface, Encycl. Entry","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-274908","year":"2017","yearsub":"2017"}
{"abstract":"Porcine Reproductive and Respiratory Syndrome Virus (PRRSV) is the cause of severe reproductive and respiratory disease in swine worldwide. In Denmark, both PRRSV-1 and PRRSV-2 are circulating and approximately 35% of pig herds are seropositive for PRRSV. In November 2010, a pig herd in the Northern part of Denmark experienced an infection with PRRSV-2 with clinical signs that were much more severe than normally reported from current Danish PRRSV-2 affected herds. Due to the clinical observations of reproductive failure in sows and high mortality in piglets, it was speculated that a new, more pathogenic or vaccine evading PRRSV strain had emerged in Denmark. The overall aim of the present study was to perform a genetic and biological characterization of the virus isolated from the diseased herd. Complete genome sequencing of isolates from this herd revealed that although the case strain had some unique genetic features including a deduced 3 amino acid deletion, it was in overall very similar to the other PRRS-2 viruses circulating in Denmark. In an experimental trial in growing pigs, no overt clinical signs or pathology were observed following intranasal inoculation with the new virus isolate. Virus shedding, acute phase protein responses and serological responses were comparable to those seen after experimental challenge with a Danish PRRSV-2 reference strain isolated in 1997. Vaccination with a commercial modified live PRRSV-2 vaccine had a clear reducing effect on virus shedding, magnitude, and duration of viremia and viral load in the lungs. Overall, the results indicate that the severe disease observed in the field was contributed by additional factors in combination with the PRRS virus infection.","author_count":9,"contributors":["Kvisgaard, Lise Kirstine","Larsen, Lars Erik","Hjulsager, Charlotte Kristiane","Bøtner, Anette","Rathkjen, P. H.","Heegaard, Peter M. H.","Bisgaard, N. P.","Nielsen, Jens","Hansen, Mette Sif"],"cuid":["S01-000.00-375610"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Experimental infection","PRRSV","Pigs","Type 2","Virulence"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-PR","DI-U"],"level3":{"OT":["Danvet K/S"],"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-PR-OTH","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"genetic and biological characterization of a porcine reproductive and respiratory syndrome virus 000000000002 prrsv 000000000002 causing significant clinical disease in the field","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/138508264/1_s2.0_S0378113517305096_main.pdf","version":"Published Version"},"id":"S01-000.00-375610","identifier":[{"id":"29102125","type":"pmid"},{"id":"85030855567","type":"scopus"}],"ids":["dtu-ed7ba6ca-34c9-41c3-b35e-b0fae55e4068"],"keyword":["Experimental infection","PRRSV","PRRSV-2","Pigs","Type 2","Virulence"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-EFDF87798232B1D7D7A2B99445DAE30E"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/138508264/1_s2.0_S0378113517305096_main.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Veterinary Institute","Technical University of Denmark, National Veterinary Institute, Division for Diagnostics & Scientific Advice, Virology"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["Boehringer Ingelheim Danmark A/S"],"nora_code":"DI-PR-OTH","used":1},{"affno":"3","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Danvet K/S"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Lise Kirstine","key":"kvisgaardpau","last":"Kvisgaard","locid":"58ce239f-6c30-44e0-ab54-f017a1821425","name":"Kvisgaard, Lise Kirstine","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars Erik","key":"larsenpau","last":"Larsen","locid":"09c2a33d-b353-44de-a850-f3c7dec879cb","name":"Larsen, Lars Erik","orcid":"0000-0003-0730-5555","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Charlotte Kristiane","key":"hjulsagerpau","last":"Hjulsager","locid":"6c1511ef-8211-4653-8c81-cd55b7f63f64","name":"Hjulsager, Charlotte Kristiane","orcid":"0000-0001-7557-8876","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anette","key":"bøtnerpau","last":"Bøtner","locid":"70ad6406-3b8c-4e50-95f5-b0f448fc69ea","name":"Bøtner, Anette","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"P. H.","key":"rathkjenpau","last":"Rathkjen","name":"Rathkjen, P. H.","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter Mikael Helweg","key":"heegaardpau","last":"Heegaard","locid":"f15c1dfb-4275-4369-9b2b-2af936d2e0e6","name":"Heegaard, Peter M. H.","name_org":"Heegaard, Peter Mikael Helweg","orcid":"0000-0003-4506-4932","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"N. P.","key":"bisgaardpau","last":"Bisgaard","name":"Bisgaard, N. P.","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens","key":"nielsenpau","last":"Nielsen","locid":"34511f38-e2d9-41d2-a82f-1044f16d784c","name":"Nielsen, Jens","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mette Sif","key":"hansenpau","last":"Hansen","locid":"5d04b165-7fc1-46cf-88f7-35be695b954c","name":"Hansen, Mette Sif","orcid":"0000-0002-8132-8475","rank":9,"rolecode":"pau"}],"pmid":["29102125"],"pub":{"doi":"10.1016/j.vetmic.2017.10.001","issn":["03781135","18732542"],"issn_org":["03781135"],"journal":"Veterinary Microbiology","pages":"74-83","publisher":"Elsevier","status":"p","title":"Veterinary Microbiology","volume":"211"},"review":"Peer Reviewed","scoID":["2-s2.0-85030855567"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Private Research","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Companies","Other Research","Private Research","Technical University of Denmark","Universities","boehringer ingelheim danmark a/s"],"PST":["Published"]},"sid":["dtu-ed7ba6ca-34c9-41c3-b35e-b0fae55e4068"],"src":["DTU Technical University of Denmark"],"title":"Genetic and biological characterization of a Porcine Reproductive and Respiratory Syndrome Virus 2 (PRRSV-2)causing significant clinical disease in the field","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-375610","year":"2017","yearsub":"2017"}
{"abstract":"In Denmark, as in many other countries, children live their lives across different contexts, primarily in the home and in childcare institutions. The child’s contexts are simultaneously both separated and related. On the one hand, the family and childcare are not automatically involved in each other’s arrangements, but on the other hand, they are structurally connected and continuously interacting due to the crossover of the children’s activities. Therefore, collaboration and coordination between parents and professionals is an important part of childcare practice. Based on comprehensive empirical work in different Danish childcare centres, this chapter discusses how parental collaboration in the pedagogical practice is often a rather paradoxical effort, developed in relation to contradictory historical and institutional conditions and requirements to treat parents both as equal participants, consumers and clients. In this way, challenges and dilemmas in parental collaboration in childcare are analysed in relation to larger societal conflicts about the relation between society and citizen and the overall purpose of childcare as state institutions.","author_count":3,"contributors":["Røn Larsen, Maja"],"cuid":["S01-000.00-560010"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Bleach","OECD","Stake","User perspective","Welfare service"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-RUC"]},"level3all":["DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"collaboration between childcare and parents dilemmas and contradictory institutional conditions in the institutional arrangement of child care","src":["ruc"],"src-code":["DI-U-RUC"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-560010","identifier":[{"id":"85083994915","type":"scopus"}],"ids":["ruc-3bd6bdd7-8d06-4e9d-869f-9868971b0590"],"keyword":["Bleach","Childcare Centre","Institutional Arrangement","Institutional Demand","OECD","Stake","User Perspective","Welfare Service"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-4-DCEF71E9E5FB5C81B1AD0F5E97333F43"],"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of People and Technology","Roskilde University, Department of People and Technology, Childhood, Youth and Family Life Research","Roskilde University, Department of People and Technology, Subject, Technology and Social Practice"],"nora_code":"DI-U-RUC","used":1}],"person":[{"affno":"1","country":"dk","first":"Maja","key":"rønlarsenpau","last":"Røn Larsen","locid":"43249523-b160-4888-8421-4a606d27561a","name":"Røn Larsen, Maja","orcid":"0000-0003-1413-6059","rank":1,"rolecode":"pau"},{"affno":"","first":"Charlotte","key":"ringsmosepedh","last":"Ringsmose","name":"Ringsmose, Charlotte","rank":2,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Grethe","key":"kraghmüllerpedh","last":"Kragh-Müller","name":"Kragh-Müller, Grethe","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-319-42557-3_13","eisbn":["9783319425573"],"isbn":["9783319425573"],"pages":"219-236","publisher":"Springer","status":"p","title":"Nordic Social Pedagogical Approach to Early Years"},"review":"Peer Reviewed","scoID":["2-s2.0-85083994915"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Roskilde University","Universities"],"PST":["Published"]},"sid":["ruc-3bd6bdd7-8d06-4e9d-869f-9868971b0590"],"src":["RUC Roskilde University"],"title":"Collaboration Between Childcare and Parents : Dilemmas and Contradictory Institutional Conditions in the Institutional Arrangement of Child Care","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-560010","year":"2017","yearsub":"2017"}
{"abstract":"Introduction Physical activity is a cornerstone in type 2 diabetes (T2D) rehabilitation. Effective long-Term and low-cost strategies to keep these patients' physically active are needed. However, maintaining physical activity behaviour is difficult once formalised interventions end. Structured exercise training supported by mobile technology and remote feedback is potentially an effective strategy. The objective of the trial is to investigate whether mobile health support using the InterWalk application for smartphones is effective in increasing physical activity levels in persons with T2D over time compared with standard care. We investigate whether Interval Walking Training using the InterWalk application is superior to Danish municipality-based rehabilitation in increasing moderate-And-vigorous physical activity levels in patients with T2D across 52â €..weeks. Secondary, we hypothesise that a motivational programme added from end of intervention to 52â €..weeks further increases level of physical activity in everyday life in patients with T2D. Methods and analysis The trial is a parallel-group, open-labelled, randomised controlled trial with long-Term follow-up at 52â €..week including patients with T2D. The primary outcome is change in moderate-And-vigorous physical activity. The key secondary outcome includes motivation for physical activity behaviour change. Other secondary outcomes are VO 2-peak, strength in the lower extremities. Exclusion criterion is medical contraindication to exercise. We include up to 246 patients and randomly allocate them into a control (standard group) or an experimental group (8-12â €..weeks of IWT supported by the smartphone-based InterWalk application) in a 1:2 fashion. After intervention, the experimental group is randomly allocated into two follow-up conditions with unsupervised IWT with or without motivational support until 52-week follow-up. The intention-To-Treat principle is applied. Ethics and dissemination The local regional Research Ethics Committee in Denmark (H-1-2014-074) and the Danish Data Protection Agency (j.nr. 2014-54-0897) have approved the trial. Positive, negative or inconclusive results will be disseminated in scientific journals and conferences. Trial registration number NCT02341690.","author_count":11,"contributors":["Valentiner, Laura Staun","Ried-Larsen, Mathias","Karstoft, Kristian","Brinkløv, Cecilie Fau","Brøns, Charlotte","Nielsen, Rasmus Oestergaard","Christensen, Robin","Nielsen, Jens Steen","Vaag, Allan","Pedersen, Bente Klarlund","Langberg, Henning"],"cuid":["S02-090.65-041762"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Valentiner, Laura Staun"],"keyword":["Denmark","Diabetes Mellitus Type 2","Exercise","Exercise Therapy","Exercise Therapy methods","Health Behavior","Humans","Journal Article","Mobile Applications","Motivation","Motivational interviewing","Muscle Strength","Oxygen Consumption","Physical activity","Randomized Controlled Trial","Rehabilitation","Single Blind Method","Smartphone","Type 2 diabetes","Walking"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-OTH"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-OTH","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"long term effect of smartphone delivered interval walking training on physical activity in patients with type 000000000002 diabetes protocol for a parallel group single blinded randomised controlled trial","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/bmjopen-2016-014036","version":"Published Version"},"id":"S02-090.65-041762","identifier":[{"id":"85017294339","type":"scopus"},{"id"