{"abstract":"I dette kapitel ses på IPSE-modellens fire faser.","author_count":4,"contributors":["Secher, Lone","Larsen, Susanne Hjelmberg"],"cuid":["S01-000.00-813124"],"filters":{"added":"2025-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"pop","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-UC"],"level3":{"UC":["DI-UC-ALL","DI-UC-UCN"]},"level3all":["DI-UC-UCN"]},"review":"und","rtype":["clu"],"sorti":"kontaktlærersamtaler læringssamtaler spontane samtaler kræver de noget særligt","src":["ucn"],"src-code":["DI-UC-UCN"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-813124","ids":["ucn-e3a27ffd-b8c8-4444-8cad-55c1ce15a911"],"lang":"Danish","level":"Popular","mra":["Humanities"],"noi":["Local-1-1-8BA85DBBEE4152BB7312006D846A2BA8"],"org":[{"affno":"1","key":"ucn university college of northern denmark","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-UCN","l3nl":"University College of Northern Denmark","l3nn":"UCN University College of Northern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"UCN University College of Northern Denmark","namevar":["Professionshøjskolen UCN, UCN Direktion, UCN Velfærd, UCN act2learn Ledelse og Organisation"],"nora_code":"DI-UC-UCN","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lone","key":"secherpau","last":"Secher","locid":"f1a338f5-f71f-4772-b0f2-dc248d40f520","name":"Secher, Lone","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Susanne Hjelmberg","key":"larsenpau","last":"Larsen","locid":"742d4d20-9a84-41bb-a7ca-bcb6ce529536","name":"Larsen, Susanne Hjelmberg","rank":2,"rolecode":"pau"},{"affno":"","first":"Marlene Bisgaard","key":"thomsenpedh","last":"Thomsen","name":"Thomsen, Marlene Bisgaard","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Charlotte Øland","key":"madsenpedh","last":"Madsen","name":"Madsen, Charlotte Øland","rank":4,"