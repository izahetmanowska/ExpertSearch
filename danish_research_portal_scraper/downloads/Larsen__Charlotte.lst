me":"Ritsema, Coen J.","rank":48,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Violette","key":"geissenviolettepau","last":"Geissen","name":"Geissen, Violette","rank":49,"rolecode":"pau"},{"affno":"7 8 9","corresponding":null,"first":"Paul T.J.","key":"scheeperspaultjpau","last":"Scheepers","name":"Scheepers, Paul T.J.","rank":50,"rolecode":"pau"}],"pmid":["34780516"],"pub":{"doi":"10.1371/journal.pone.0259748","issn":["19326203"],"issue":"11","journal":"PLOS ONE","publisher":"Public Library of Science","status":"p","title":"PLOS ONE","title_org":"PLoS One","volume":"16"},"review":"Peer Reviewed","scoID":["2-s2.0-85119250505"],"sdg":["13. Climate Action","15. Life on Land","3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Governmental Institutions","All Miscellaneous","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Governmental Institutions","Miscellaneous","Other Research","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["au-bd76ade6-b3e8-4392-9a73-36f9d7d5740f","dtu-51febaa4-b840-402b-85d9-c764eb69a793","nfa-15f606f3-93ad-4847-aaa9-66ef60d83457"],"src":["AU Aarhus University","DTU Technical University of Denmark","NFA National Research Centre for the Working Environment"],"title":"Collection of human and environmental data on pesticide use in Europe and Argentina : Field study protocol for the SPRINT project","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-100.00-767827","year":"2021","yearsub":"2021"}
{"abstract":"I takt med at sundhedsvæsnet effektiviseres og der kommer flere ældre, ses en større udflytning af sygeplejefaglige opgaver som tidligere blev varetaget på hospitalet. Denne artikel vil præsentere fund relateret til de oplevelser, som hjemmesygeplejersker har med at yde sygepleje til patienter, som udskrives til pleje og behandling i eget hjem, hvor behandlingsansvaret fortsat påhviler hospitalets læger. Der blev foretaget et semistruktureret gruppeinterview med tre hjemmesygeplejersker fra en mindre dansk kommune, hvor alle havde udøvet sygepleje til den inkluderede gruppe af patienter. Analysen af gruppeinterviewet foregik med inspiration fra Jensen, indføring i tekstanalyse. Analysen resulterede i følgende temaer 1) Fordele ved at yde sygepleje til patienter, som er indlagt til pleje og behandling i eget hjem, 2) Samarbejdet med hospitalet beror på hjemmesygeplejerskens initiativ 3) Der skal være en balance mellem ansvar sygeplejekompetencer og det faglige skøn. Undersøgelsen viste, at hjemmesygeplejerskerne fandt pleje og behandling i patienternes egne hjem fordelagtige, når de var velkoordinerede. Faglige dilemmaer opstod når patientens behov for sygepleje oversteg ressourcerne i kommunen. Specialiseret sygepleje medførte behov for kompetenceløft i »teknologiske og instrumentelle færdigheder«. Dialog og forventningsafstemning mellem sektorerne blev beskrevet som væsentlig. Manglen på dette kunne få betydning for tilliden og relationen til patient og pårørende.","author_count":11,"contributors":["Rasmussen, Rikke Cathrine Bøgeskov","Lyng Larsen, Karen","Højgaard, Kristina","Dybbro, Karina Løvendahl","Jensen, Gitte Sylvester","Eckhardt, Michala","Skouenborg, Pernille Bak","Delmar, Charlotte","Hoeck, Bente"],"cuid":["S05-084.84-009723"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"11-50 contributors","class":"merged","cluster_size":"5+","keyword":["Hverdagsliv","Sygepleje"],"level":"sci","mra":["hum","med"],"oa":"Open Acc