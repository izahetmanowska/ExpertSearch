{"author_count":2,"contributors":["Larsen, Charlotte Rørdam","Lindelof, Anja Mølle"],"cuid":["S01-000.00-202051"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-RUC"]},"level3all":["DI-U-AU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"musikkens institutioner dmo særnummer 000000002018","src":["au"],"src-code":["DI-U-AU"],"type":"db","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.danishmusicologyonline.dk/arkiv/arkiv_dmo.html","version":"Other Version"},"id":"S01-000.00-202051","ids":["au-7f174b54-9304-406b-816d-d67f91127b55"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-7CED29FBB466D1DD6BE1C3DA47C59478"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, School of Communication and Culture, School of Communication and Culture - Musicology"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University"],"nora_code":"DI-U-RUC","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Charlotte Rørdam","key":"larsenped","last":"Larsen","locid":"4e604018-2471-4a68-a18b-0ae187425b3d","name":"Larsen, Charlotte Rørdam","orcid":"0000-0002-5465-0338","rank":1,"role":"Editor","rolecode":"ped"},{"affno":"2","corresponding":null,"first":"Anja Mølle","key":"lindelofped","last":"Lindelof","name":"Lindelof, Anja Mølle","rank":2,"role":"Editor","rolecode":"ped"}],"pub":{"issn":["1904237X"],"issue":"Særnummer 2018 Musikkens institutioner","pages":"180","series":"Dansk Musikforskning Online","status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Roskilde University","Universities"],"PST":["Published"]},"sid":["au-7f174b54-9304-406b-816d-d67f91127b55"],"src":["AU Aarhus University"],"title":"Musikkens institutioner : DMO særnummer 2018","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-202051","year":"2018","yearsub":"2018"}
{"abstract":"Porcine circovirus 3 (PCV3) is a new species of the Circovirus genus, which has recently been associated with different clinical syndromes. Its presence has been reported in different countries of North and South America, Asia and recently also Europe (Poland). However, different from the other continents, no European PCV3 sequence is currently available in public databases. There is a strong need of epidemiological data and full-genome sequences from Europe because of its relevance in the understanding of PCV3 molecular epidemiology and control. To fill this lack of information, samples collected in Denmark, Italy and Spain in 2016 and 2017 were screened for PCV3. Of the Danish samples, 36 of 38 the lymph nodes, six of 20 serum samples and two of 20 lung samples tested positive. Similarly, 10 of 29 lungs, 20 of 29 organ pools, six of 33 sera and one of eight nasal swabs tested PCV3 positive in Italy. Fourteen of 94 serum pools from seven of 14 Spanish farms were also positive. Despite the convenience nature of the sampling prevents any precise prevalence estimation, the preliminary screening of the data from three European countries confirmed a rather wide PCV3 distribution in Europe. Furthermore, the analysis of the six obtained complete European PCV3 genomes and their comparison with the public available sequences seems to support a remarkable worldwide PCV3 circulation. These results underline once more the urgency of more extensive epidemiological studies to refine the current knowledge on PCV3 evolution, transmission, spreading patterns and impact on pig health.","author_count":7,"contributors":["Franzo, G.","Legnardi, M.","Hjulsager, Charlotte Kristiane","Klaumann, F.","Larsen, Lars Erik","Segales, J.","Drigo, M."],"cuid":["S01-000.00-335128"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"corresponding_author":["Franzo, G."],"country":["Italy","Spain"],"glorg":["All Global Affiliations","Centre for Animal Health Research","University of Padua"],"keyword":["Europe","Molecular epidemiology"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"full genome sequencing of porcine circovirus 000000000003 field strains from denmark italy and spain demonstrates a high within europe genetic heterogeneity","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/190878557/Franzo_Full_genome_2018.pdf","version":"Authors Final Version"},"id":"S01-000.00-335128","identifier":[{"id":"85042066717","type":"scopus"},{"id":"29453822","type":"pmid"}],"ids":["dtu-66642e48-72d6-4692-8c41-aabbb03c3e78"],"keyword":["Europe","Full genome","Molecular epidemiology","Porcine circovirus 3"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-DAFA505FDF70BF6DD3AE8FACF3949BAC"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/190878557/Franzo_Full_genome_2018.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","country":"it","key":"university of padua","loc":["Italy","Europe, EU","OECD"],"name":"University of Padua","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Veterinary Institute","Technical University of Denmark, National Veterinary Institute, Division for Diagnostics & Scientific Advice, Virology"],"nora_co