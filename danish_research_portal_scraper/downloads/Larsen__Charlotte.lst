no":"1","first":"Lise-Lotte","key":"christiansenliselottepau","last":"Christiansen","locid":"fa2e10e6-c83c-458c-98b0-4d35c99a93f2","name":"Christiansen, Lise-Lotte","rank":15,"rolecode":"pau"},{"affno":"1","first":"Stig Milan","key":"thamsborgstigmilanpau","last":"Thamsborg","locid":"e1ff513c-cc7f-43e8-ac3d-742aee7fe1da","name":"Thamsborg, Stig Milan","rank":16,"rolecode":"pau"}],"pub":{"pages":"28","status":"p"},"review":"No Review","search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-4d569438-9602-401f-9bdc-587709ecad38","ku-ddffe9ee-b448-415d-84d8-2498e38be7a2"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Rapportering af diagnostiske undersøgelser af faldvildt 2022","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-096.36-822602","year":"2023","yearsub":"2023"}
{"abstract":"The use of naturally occurring quinones to produce more sustainable electrolytes to use for renewable energy storage in redox flow batteries (RFBs) is still a new and rarely investigated subject. In this study, we demonstrate how the putative phoenicin and its dimer (diphoenicin) influence the capacity performance of phoenicin as a negolyte in a redox flow battery. To do this, we biosynthesized phoenicin by cultivating the filamentous fungus Penicillium phoeniceum and the resulting fungal extract contained multiple metabolites, putatively related to phoenicin, including the proposed phoenicin dimer, which constituted 7% of the extract. When paired with potassium ferri/ferrocyanide as a posolyte in an RFB, the battery showed an initial capacity of 1.58 Ah L–1. In contrast to our previous study, this corresponded to a two-electron reaction per benzoquinone group. A detailed electrochemical and chemical analysis is conducted to shed light on this discrepancy and to provide further insight into the chemical stability of phoenicin in an alkaline environment (pH = 14). A sustainable biosynthesized fungal quinone mix of phoenicin stores four electrons per phoenicin molecule in a redox flow battery negolyte.","author_count":9,"contributors":["Wilhelmsen, Charlotte Overgaard","Pasadakis-Kavounis, Alexandros","Christiansen, Johan V.","Isbrandt, Thomas","Almind, Mads R.","Larsen, Thomas O.","Hjelm, Johan","Sørensen, Jens Laurids","Muff, Jens"],"cuid":["S02-098.85-672423"],"filters":{"added":"2023-07","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Muff, Jens","Wilhelmsen, Charlotte O.","Wilhelmsen, Charlotte Overgaard"],"keyword":["Bio quinone","Biosynthetic compound","Energy storage","Four electron reaction","Fungi","Mixed phoenicin","Renewable energy","Sustainable electrolyte production"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-AAU","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"on the capacity and stability of a biosynthesized bis quinone flow battery negolyte","src":["aau","dtu"],"src-code":["DI-U-AAU","DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85163516699&partnerID=8YFLogxK","version":"Other Version"},"id":"S02-098.85-672423","identifier":[{"id":"85163516699","type":"scopus"}],"ids":["aau-b1c4e163-4207-4ffb-b4bf-486f21ea8607","dtu-feebde43-7cb4-4523-907a-3f40d2f34d74"],"keyword":["bio-quinone","biosynthetic compound","energy storage","four-electron reaction","fungi","mixed phoenicin","renewable energy","sustainable electrolyte production"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-B95434E778C179C5853D0A127078BA2F"],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience, Chemical Engineering","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience, Section for Chemical Science and Engineering"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Energy Conve