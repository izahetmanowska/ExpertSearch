{"author_count":4,"contributors":["Buhl, Hanne","Bay, Gina","Albrechtsen, Charlotte","Larsen, Martin Damgaard"],"cuid":["S01-000.00-225595"],"event":{"end":"2012-11-22","place":"dk","start":"2012-11-22","title":"NIC 2012","year":"2012"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"repositioning international students a case of intercultural learning in which the host university is the learner","src":["au"],"src-code":["DI-U-AU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-225595","ids":["au-a8cb8664-3cb7-425c-90d8-aaa5ada7a7e6"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-836BCD9716E1DF59EEA69E2CED9318AB"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, Centre for Teaching Development and Digital Media"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Hanne","key":"buhlpau","last":"Buhl","locid":"db87144f-de95-46be-9531-7d064f878ad9","name":"Buhl, Hanne","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Gina","key":"baypau","last":"Bay","locid":"42b0a80a-254c-4baa-bc7e-3c1dff143134","name":"Bay, Gina","orcid":"0000-0003-2960-5743","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Charlotte","key":"albrechtsenpau","last":"Albrechtsen","locid":"86bacc15-8c4c-4751-bb33-15d182313e74","name":"Albrechtsen, Charlotte","orcid":"0009-0008-9466-986X","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Martin Damgaard","key":"larsenp