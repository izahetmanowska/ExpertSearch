29","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anne K","key":"christensenpau","last":"Christensen","locid":"e0b1d3b3-5913-46a1-a556-26d47e3b39ef","name":"Christensen, Anne Karina","name_org":"Christensen, Anne K","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Per B","key":"jeppesenpau","last":"Jeppesen","locid":"735adee7-f50f-4846-bfe3-7039c37c628e","name":"Jeppesen, Per Bendix","name_org":"Jeppesen, Per B","rank":6,"rolecode":"pau"},{"affno":"2 3","first":"Birgitte","key":"brockpau","last":"Brock","locid":"3ac016f5-a9a7-44b9-83b8-3fde84469186","name":"Brock, Birgitte","rank":7,"rolecode":"pau"},{"affno":"2 4","first":"Jørgen","key":"rungbypau","last":"Rungby","locid":"16f0bbd5-607e-422d-949d-13546554c84e","name":"Rungby, Jørgen","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Johan","key":"palmfeldtpau","last":"Palmfeldt","locid":"2a5fd2de-dd21-4a09-bdac-24adf04a89b1","name":"Palmfeldt, Johan","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Agnete","key":"larsenpau","last":"Larsen","locid":"31449996-34ed-426f-b5b6-78d753234c5b","name":"Larsen, Agnete","rank":10,"rolecode":"pau"}],"pmid":["31197210"],"pub":{"doi":"10.1038/s41598-019-44954-1","issn":["20452322"],"issue":"1","journal":"Scientific Reports","paperid":"8589","publisher":"Nature Publishing Group","status":"p","title":"Scientific Reports","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-85067351470"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-237636eb-cd87-48cc-898f-b7bdd914acff","ku-385b1651-a5d2-4655-b244-32e707294372"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"The zinc transporter Zip14 (SLC39a14) affects Beta-cell Function : Proteomics, Gene expression, and Insulin secretion studies in INS-1E cells","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-015178","year":"2019","yearsub":"2019"}
{"abstract":"Recent studies have questioned the effect of maternal derived antibodies (MDAs) to protect piglets against infection with influenza A virus (IAV). The lack of protection against IAV infections provided by MDAs has encouraged alternative vaccination strategies targeting young piglets in an attempt to stimulate an early antibody response. There is a lack of studies documenting the efficacy of piglet vaccination. In the present study, we monitored a group of vaccinated and non-vaccinated piglets in a Danish sow herd that initiated piglet vaccination with ¼ dose of an inactivated swine influenza vaccine at the time of castration (day 3–4). A total of 160 piglets from 11 sows were included and either vaccinated with 0.5 mL inactivated swine influenza vaccine or sham-vaccinated. From week 0 until week 6, all included piglets were clinically examined and nasal swapped once per week and weighed at weeks 0, 3 and 6. Blood samples were collected from sows at week 0 and from piglets at week 3. Vaccination of piglets had limited effect on clinical signs, body weight, antibody development and viral shedding, within the first 6 weeks of life. At least 50% of all pigs of each treatment group tested positive for IAV at week 2, and very early onset of IAV shedding was observed. In total, 18 pigs were IAV positive in nasal swabs for more than one consecutive sampling time indicating prolonged shedding and 14 pigs were IAV positive with negative samplings in between indicating re-infection with the same IAV strain.","author_count":5,"contributors":["Ryt-Hansen, Pia","Larsen, Inge","Kristensen, Charlotte Sonne","Krog, Jesper Schak","Larsen, Lars Erik"],"cuid":["S02-100.00-036525"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"corresponding_author":["Ryt-Hansen, Pia"],"keyword":["Influenza A virus","Influenza vaccination","Piglet vaccination","Recurrent shedding","Reinfection","Swine influenza"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-SEGES"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-PR-SEGES","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"limited impact of influenza a virus vaccination of piglets in an enzootic infected sow herd","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.rvsc.2019.10.015","version":"Published Version"},"id":"S02-100.00-036525","identifier":[{"id":"85074154488","type":"scopus"},{"id":"31677416","type":"pmid"}],"ids":["dtu-adba440f-64a6-4195-b24d-e975f9ecb659","ku-a5e4b42f-6b96-4c1c-8759-83a825a944d3"],"keyword":["Influenza a virus","Influenza vaccination","Piglet vaccination","Recurrent shedding","Reinfection","Swine influenza"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-01C6E726B4036690A918BB17043D19A0"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/230847737/1_s2.0_S0034528819308100_main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.rvsc.2019.10.015","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/196882092/1_s2.0_S0034528819308100_main.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National 