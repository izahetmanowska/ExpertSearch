sed":1}],"person":[{"affno":"","corresponding":null,"first":"Line Stenholt","key":"bruunpau","last":"Bruun","name":"Bruun, Line Stenholt","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Johan Kløvgaard","key":"sørensenpau","last":"Sørensen","locid":"d5475d4d-4c11-460a-9e28-686771070cc3","name":"Sørensen, Johan Kløvgaard","orcid":"0009-0006-0087-3719","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens Rolighed","key":"larsenpau","last":"Larsen","locid":"485143af-239d-407f-96e4-f045733fa8c8","name":"Larsen, Jens Rolighed","orcid":"0000-0003-0694-0135","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Charlotte","key":"rungepau","last":"Runge","locid":"eca83862-b388-4479-bc0b-c8a670ae52e9","name":"Runge, Charlotte","orcid":"0000-0001-9480-2490","rank":4,"rolecode":"pau"}],"pmid":["38109796"],"pub":{"doi":"10.1213/ane.0000000000006775","issn":["00032999","11381868"],"issn_org":["00032999"],"issue":"4","journal":"Anesthesia and Analgesia","pages":"904-905","publisher":"Lippincott Williams and Wilkins","status":"p","title":"Anesthesia and Analgesia","volume":"138"},"review":"Peer Reviewed","scoID":["2-s2.0-85188002101"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-9d5a3fa7-92e1-4fc8-95a3-2a8df2782ff9"],"src":["AU Aarhus University"],"title":"Spinal Anesthesia With Ropivacaine for Hip and Knee Arthroplasty : Observations of Duration of Action","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-708700","year":"2024","yearsub":"2024"}
{"abstract":"Background & Aims: Metabolic dysfunction-associated steatohepatitis (MASH) is linked to insulin resistance and type 2 diabetes and marked by hepatic inflammation, microvascular dysfunction, and fibrosis, impairing liver function and aggravating metabolic derangements. The liver homeostatic interactions disrupted in MASH are still poorly understood. We aimed to elucidate the plasticity and changing interactions of non-parenchymal cells associated with advanced MASH. Methods: We characterized a diet-induced mouse model of advanced MASH at single-cell resolution and validated findings by assaying chromatin accessibility, bioimaging murine and human livers, and via functional experiments in vivo and in vitro. Results: The fibrogenic activation of hepatic stellate cells (HSCs) led to deterioration of a signaling module consisting of the bile acid receptor NR1H4/FXR and HSC-specific GS-protein-coupled receptors (GSPCRs) capable of preserving stellate cell quiescence. Accompanying HSC activation, we further observed the attenuation of HSC Gdf2 expression, and a MASH-associated expansion of a CD207-positive macrophage population likely derived from both incoming monocytes and Kupffer cells. Conclusion: We conclude that HSC-expressed NR1H4 and GSPCRs of the healthy liver integrate postprandial cues, which sustain HSC quiescence and, through paracrine signals, overall sinusoidal health. Hence HSC activation in MASH not only drives fibrogenesis but may desensitize the hepatic sinusoid to liver homeostatic signals. Impact and implications: Homeostatic interactions between hepatic cell types and their deterioration in metabolic dysfunction-associated steatohepatitis are poorly characterized. In our current single cell-resolved study of advanced murine metabolic dysfunction-associated steatohepatitis, we identified a quiescence-associated hepatic stellate cell-signaling module with potential to preserve normal sinusoid function. As expression levels of its constituents are conserved in the human liver, stimulation of the identified signaling module is a promising therapeutic strategy to restore sinusoid function in chronic liver disease.","author_count":26,"contributors":["Bendixen, Sofie Marchsteiner","Jakobsgaard, Peter R.","Hansen, Daniel","Hejn, Kamilla Holtmann","Terkelsen, Mike Krogh","Bjerre, Frederik Adam","Thulesen, Annemette Præstegaard","Eriksen, Niels G.","Hallenborg, Philip","Geng, Yana","Dam, Trine V.","Larsen, Frederik Tibert","Wernberg, Charlotte","Vijayathurai, Janusa","Scott, Emma A.H.","Marcher, Ann-Britt","Detlefsen, Sönke","Grøntved, Lars","Dimke, Henrik","Berdeaux, Rebecca","de Aguiar Vallim, Thomas Q.","Olinga, Peter","Lauridsen, Mette Munk","Krag, Aleksander","Blagoev, Blagoy","Ravnskjaer, Kim"],"cuid":["S01-000.00-723275"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Europe, EU","OECD"],"corresponding_author":["Ravnskjaer, Kim"],"country":["Netherlands","United States"],"glorg":["All Global Affiliations","McGovern Medical School","University of Groningen","University of Southern California"],"keyword":["Bile acids","Cyclic AMP","G protein coupled receptors","Hepatic stellate cells","Inflammation","Metabolic dysfunction associated Steatohepatitis","Nuclear receptors","Pericytes","Transcriptome","scRNAseq"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"single cell resolved study of advanced murine mash reveals a homeostatic pericyte signaling module","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.jhep.2023.11.001","version":"Published Version"},"funding_acknowledgement":["S.M.B., M.K.T., P.H., F.T.L., C.W.W., M.M.L., A.K., L.G., B.B., and K.R. were supported by the Danish National Research Foundation (grant DNRF141 ) to Center for Functional Genomics and Tissue Plasticity. DH, KHH, and TVD recieved scholarships from the Danish Diabetes Academy, funded by the Novo Nordisk Foundation (grant NNF17SA0031406 ). KR was supported by a project grant (#1030-00390B) from the Independent Research Fund Denmark. Proteomics work was supported by the Novo Nordisk Foundation ( NNF18OC0052768 and the INTEGRA research infrastructure). T.Q.d.A.V. are sponsored by NIH grant DK118064 . Bioimaging was performed at DaMBIC, a bioimaging research core facility, at the SDU established by a grant from The Danish Agency for Science, Technology and Innovation and intramural funding."],"id":"S01-000.00-723275","identifier":[{"id":"85180557573","type":"scopus"},{"id":"37972658","type":"pmid"}],"ids":["sdu-72180e70-06e6-4fde-849d-a4fd0d5dbffe"],"keyword":["Bile Acids","Cyclic AMP","G-Protein-Coupled Receptors","Hepatic Stellate Cells","Inflammation","Metabolic dysfunction-associated Steatohepatitis","Nuclear Receptors","Pericytes","ScRNAseq","Sinusoids","Transcriptome"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-246D9EABF6DE1C0A7B0E8534DB075E4B"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/255096707/mmc4.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.jhep.2023.11.001","version":"Published Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Science, Department of Biochemistry and Molecular Biology","SDU, Faculty of Science, Department of Biochemistry and Molecular Biology, Bioimaging"],