-7fc1-46cf-88f7-35be695b954c","name":"Hansen, Mette Sif","orcid":"0000-0002-8132-8475","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Gitte","key":"larsenpau","last":"Larsen","locid":"ea426e5f-93bd-48f5-a3c8-e5f8004413a7","name":"Larsen, Gitte","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Elisabeth","key":"holmpau","last":"Holm","locid":"07c945b3-4fe0-496a-9734-095800683729","name":"Holm, Elisabeth","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Heidi Huus","key":"petersenpau","last":"Petersen","locid":"e7e15c36-c9df-4ee9-a928-2fd960e69cdc","name":"Petersen, Heidi Huus","orcid":"0000-0002-7208-7614","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Charlotte Kristiane","key":"hjulsagerpau","last":"Hjulsager","locid":"6c1511ef-8211-4653-8c81-cd55b7f63f64","name":"Hjulsager, Charlotte Kristiane","orcid":"0000-0001-7557-8876","rank":6,"rolecode":"pau"}],"pub":{"pages":"27","place":"Frederiksberg C","publisher":"Veterinærinstituttet, Danmarks Tekniske Universitet","status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-38773491-0917-492a-8409-11a475208231"],"src":["DTU Technical University of Denmark"],"title":"Rapportering af diagnostiske undersøgelser af faldvildt 2015","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-321358","year":"2015","yearsub":"2016"}
{"abstract":"Aspergillus aculeatus, a filamentous fungus belonging to the Aspergillus clade Nigri, is an industrial workhorse in enzyme production. Recently we reported a number of secondary metabolites from this fungus; however, its genetic potential for the production of secondary metabolites is vast. In this study we identified a 6-methylsalicylic acid (6-MSA) synthase from A. aculeatus, and verified its functionality by episomal expression in A. aculeatus and heterologous expression in A. nidulans. Feeding studies with fully 13C-labeled 6-MSA revealed that 6-MSA is incorporated into aculinic acid, which further incorporates into three compounds that we name aculins A and B, and epi-aculin A, described here for the first time. Based on NMR data and bioinformatic studies we propose the structures of the compounds as well as a biosynthetic pathway leading to formation of aculins from 6-MSA.","author_count":5,"contributors":["Petersen, Lene Maj","Holm, Dorte Koefoed","Gotfredsen, Charlotte Held","Mortensen, Uffe Hasbro","Larsen, Thomas Ostenfeld"],"cuid":["S01-000.00-328571"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Aspergillus","Biosynthesis","Natural products","Polyketide","Terpene"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"investigation of a 000000000006 msa synthase gene cluster in i aspergillus aculeatus i reveals 000000000006 msa derived aculinic acid aculins a b and epi aculin a","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84943361890","version":"Other Version"},"id":"S01-000.00-328571","identifier":[{"id":"84943361890","type":"scopus"},{"id":"26374386","type":"pmid"}],"ids":["dtu-50bfa9b0-c1f0-4263-a9ae-d5f7254934e7"],"keyword":["Aspergillus","Biosynthesis","Methylsalicylic acid","Natural products","Polyketide","Terpene"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-69C0FA502E6F6CA30FB9A0A320F9DB1C"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Systems Biology"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Lene Maj","key":"petersenpau","last":"Petersen","locid":"7a1c5a02-7eb8-40e3-a1ec-621fb3c37652","name":"Petersen, Lene Maj","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Dorte Koefoed","key":"holmpau","last":"Holm","locid":"aedc7b19-7dd8-4af4-a8cc-5a73f5783c91","name":"Holm, Dorte Koefoed","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Charlotte Held","key":"gotfredsenpau","last":"Gotfredsen","locid":"1cf4df84-2d0e-4693-bf47-e9932e3bf0e3","name":"Gotfredsen, Charlotte Held","orcid":"0000-0002-7386-119X","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Uffe Hasbro","key":"mortensenpau","last":"Mortensen","locid":"dec3038b-f004-4c96-84a1-52825e1c0ce8","name":"Mortensen, Uffe Hasbro","orcid":"0000-0002-7794-7273","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thomas Ostenfeld","key":"larsenpau","last":"Larsen","locid":"bd958d52-71b6-4720-b30a-cc9305633b43","name":"Larsen, Thomas Ostenfeld","orcid":"0000-0002-3362-5707","rank":5,"rolecode":"pau"}],"pmid":["26374386"],"pub":{"doi":"10.1002/cbic.201500210","issn":["14394227","14397633"],"issn_org":["14394227"],"issue":"15","journal":"ChemBioChem","pages":"2200-2204","publisher":"Wiley - VCH Verlag GmbH & Co. KGaA","publisher_org":"Wiley - V C H Verlag GmbH & Co. KGaA","status":"p","title":"ChemBioChem","volume":"16"},"review":"Peer Reviewed","scoID":["2-s2.0-84943361890"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-50bfa9b0-c1f0-4263-a9ae-d5f7254934e7"],"src":["DTU Technical University of Denmark"],"title":"Investigation of a 6-MSA Synthase Gene Cluster in <i>Aspergillus aculeatus</i> Reveals 6-MSA-derived Aculinic Acid, Aculins A-B and Epi-Aculin A","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-328571","year":"2015","yearsub":"2015"}
{"abstract":"Porcine reproductive and respiratory syndrome (PRRS) has been a cause for great concern to the Danish pig industry since it was first diagnosed in 1992. The causative agent of PRRS is an RNA virus which is divided into different genotypes. The clinical signs, as well as its morbidity and mortality, is highly variable between herds and regions. Two different genotypes of PRRS virus (PRRSV) are found in Denmark: type 1 and type 2. Approximately 40 % of Danish swine herds are seropositive for one or both PRRSV types. The objective of this study was to describe the temporal trend and spatial distribution of PRRSV in Danish swine herds from 2007 to 2010, based on type-specific serological tests from the PRRS surveillance and control program in Denmark using the results stored in the information management system at the National Veterinary Institute, Technical University of Denmark (DTU Vet). The average monthly seroprevalence of PRRSV type 1 was 9 % (minimum of 5 %; maximum of 13 %) in breeding herds, and 20 % (minimum of 14 %; maximum of 26 %) in production herds; PRRSV type 2 had an average seroprevalence of 3 % (minimum of 1 %; maximum of 9 %) in breeding herds and of 9 % (minimum of 5 %; maximum of 13 %) within production herds. The seroconversion rate followed a similar and consistent pattern, being higher for type 1 than for type 2 for both PRRSV types. Regarding the spatiotemporal results, the relative risk distribution maps changed over time as a consequence of the changes in PRRSV seroprevalence, suggesting a general decline in the extent of areas with higher relative risk for both type 1 and 2. Local spatial analysis results demonstrated the existence of statistically significant clusters in areas where the relative risk was higher for both herds. PRRSV type 1 seroprevalence was constantly higher than for PRRSV type 2 in both herd types. Significant spatial clusters were consistently found in Denmark, suggesting that PRRSV is endemic in these areas. Furthermore, relative risk distribution maps revealed different patterns over time as a consequence of the changes in seroprevalence.","author_count":6,"contributors":["Lopes Antunes, Ana Carolina","Hisham Beshara Halasa, Tariq","Lauritsen, Klara Tølbøl","Kristensen, Charlotte Sonne","Larsen, Lars Erik","Toft, Nils"],"cuid":["S01-000.00-329036"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Danish Pig Production"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"spatial analysis and temporal trends of porcine reproductive and respiratory syndrome in denmark from 000000002007 to 000000002010 based on laboratory submission data","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/119455806/art_3A10.1186_2Fs12917_015_0617_0.pdf","version":"Published Version"},"id":"S01-000.00-329036","identifier":[{"id":"26689831","type":"pmid"},{"id":"PMC4687366","type":"pmcid"},{"id":"84988733132","type":"scopus"}],"ids":["dtu-524f3f5b-8ae8-4f32-83bd-4ece04614c1c"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-0A4FBD1100E864D84E247D70185FCE89"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/119455806/art_3A10.1186_2Fs12917_015_0617_0.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Veterinary Institute","Technical University of Denmark, National Veterinary Institute, Section for Epidemiology"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Danish Pig Production"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Ana Carolina","key":"lopesantunespau","last":"Lopes Antunes","locid":"f7adff66-81f7-4a45-b6b7-d347930ada5b","name":"Lopes Antunes, Ana Carolina","orcid":"0000-0001-8142-8241","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Tariq","key":"hishambesharahalasapau","last":"Hisham Beshara Halasa","locid":"e8a00415-6047-48ae-abf2-4a80996113ee","name":"Hisham Beshara Halasa, Tariq","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Klara Tølbøl","key":"lauritsenpau","last":"Lauritsen","locid":"13169d33-175c-4684-abc2-3331fb5246c2","name":"Lauritsen, Klara Tølbøl","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Charlotte Sonne","key":"kristensenpau","last":"Kristensen","name":"Kristensen, Charlotte Sonne","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars Erik","key":"larsenpau","last":"Larsen","locid":"09c2a33d-b353-44de-a850-f3c7dec879cb","name":"Larsen, Lars Erik","orcid":"0000-0003-0730-5555","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Nils","key":"toftpau","last":"Toft","locid":"e4f84efb-d003-4bb4-b699-5d720484cf76","name":"Toft, Nils","orcid":"0000-0002-0265-3764","rank":6,"rolecode":"pau"}],"pmid":["26689831"],"pub":{"doi":"10.1186/s12917-015-0617-0","issn":["17466148"],"issue":"1","journal":"BMC Veterinary Research","paperid":"303","publisher":"BioMed Central Ltd.","status":"p","title":"BMC Veterinary Research","title_org":"B M C Veterinary Research","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-84988733132"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-524f3f5b-8ae8-4f32-83bd-4ece04614c1c"],"src":["DTU Technical University of Denmark"],"title":"Spatial analysis and temporal trends of porcine reproductive and respiratory syndrome in Denmark from 2007 to 2010 based on laboratory submission data","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-329036","year":"2015","yearsub":"2015"}
{"abstract":"Infection with avian influenza virus (AIV) in poultry may cause devastating disease although the same virus may not cause disease in wild birds. Since AI viruses can be exchanged between poultry and wild birds, surveillance in wild birds provides important knowledge for control of disease in poultry. AIV’s from the Danish wild bird active surveillance were characterized, focusing on viruses from 2012, and from outbreaks of AI in poultry in Denmark. The matrix (M) gene from more than 50 viruses of different subtypes and the hemagglutinin (HA) gene from more than 30 subtype H5 low pathogenic viruses were sequenced and compared by alignment and phylogenetic analyses. The aim was to evaluate: the origin of viruses from outbreaks of AI in Danish poultry, the design of active surveillance in Denmark, and the suitability of the molecular diagnostic RT-PCR tests employed. All M-genes from Danish viruses grouped phylogenetically with Eurasian lineage viruses. Grouping among Danish sequences was not correlated to place or to the time of sampling within the same year, although there was a tendency to grouping according to the year of sampling. Similar results were observed for H5 sequences. M and H5/H7 gene sequences from poultry showed a high degree of similarity to Danish wild bird sequences, suggesting exchange of viruses between geographically close wild birds and poultry. Significant drift was observed in both M and H5 gene sequences that are important for adequate molecular diagnostics, thus highlighting the importance of continuous surveillance and molecular characterization of AI viruses.","author_count":5,"contributors":["Larsen, Lars Erik","Krog, Jesper Schak","Madsen, Jesper J.","Thorup, Kasper","Hjulsager, Charlotte Kristiane"],"cuid":["S01-000.00-337513"],"event":{"end":"2015-04-15","place":"Athens, us","start":"2015-04-12","title":"9<sup>th</sup> International Symposium on Avian Influenza","year":"2015"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"molecular characterization of ai viruses from poultry and wild bird surveillance in denmark","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/112139178/Molecular_characterization_of_AI_viruses_from_poultry_and_wild_bird_surveillance_in_Denmark_til_ORBIT.pdf","version":"Published Version"},"id":"S01-000.00-337513","ids":["dtu-6e3d1711-c0ca-4732-abac-c9f1e7851d1e"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-43E28BC4CD2A75422075BF1B700A2676"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/112139178/Molecular_characterization_of_AI_viruses_from_poultry_and_wild_bird_surveillance_in_Denmark_til_ORBIT.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Veterinary Institute","Technical University of Denmark, National Veterinary Institute, Section for Virology"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Lars Erik","key":"larsenpau","last":"Larsen","locid":"09c2a33d-b353-44de-a850-f3c7dec879cb","name":"Larsen, Lars Erik","orcid":"0000-0003-0730-5555","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Schak","key":"krogpau","last":"Krog","locid":"1e238a71-3075-4303-91fe-3cedb620123d","name":"Krog, Jesper Schak","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jesper J.","key":"madsenpau","last":"Madsen","name":"Madsen, Jesper J.","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kasper","key":"thoruppau","last":"Thorup","name":"Thorup, Kasper","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Charlotte Kristiane","key":"hjulsagerpau","last":"Hjulsager","locid":"6c1511ef-8211-4653-8c81-cd55b7f63f64","name":"Hjulsager, Charlotte Kristiane","orcid":"0000-0001-7557-8876","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-6e3d1711-c0ca-4732-abac-c9f1e7851d1e"],"src":["DTU Technical University of Denmark"],"title":"Molecular characterization of AI viruses from poultry and wild bird surveillance in Denmark","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-337513","year":"2015","yearsub":"2015"}
{"author_count":6,"contributors":["Kristensen, Charlotte Sonne","Kvisgaard, Lise Kirstine","Pawlowski, M.","Holmgaard Carlsen, S.","Hjulsager, Charlotte Kristiane","Larsen, Lars Erik"],"cuid":["S01-000.00-343353"],"event":{"end":"2015-06-24","place":"Kyoto, jp","start":"2015-06-21","title":"7th International Symposium on Emerging and Re-emerging Pig Diseases","year":"2015"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Danish Pig Production"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"simultaneous vaccination with prrs mlv against both prrsv type 000000000001 and type 000000000002 duration of viraemia and level of clinical protection","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/119458765/ISERPD2015_abstract_Lindholm_final.pdf","version":"Authors Final Version"},"id":"S01-000.00-343353","ids":["dtu-81e018e5-39d4-41c4-9974-a9c50a285441"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-78EE5D7560AE2BA4B6C763F56A2E5298"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/119458765/ISERPD2015_abstract_Lindholm_final.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Danish Pig Production"],"nora_code":"DI-OT","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Veterinary Institute","Technical University of Denmark, National Veterinary Institute, Section for Virology"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Charlotte Sonne","key":"kristensenpau","last":"Kristensen","name":"Kristensen, Charlotte Sonne","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Lise Kirstine","key":"kvisgaardpau","last":"Kvisgaard","locid":"58ce239f-6c30-44e0-ab54-f017a1821425","name":"Kvisgaard, Lise Kirstine","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"M.","key":"pawlowskipau","last":"Pawlowski","name":"Pawlowski, M.","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"S.","key":"holmgaardcarlsenpau","last":"Holmgaard Carlsen","name":"Holmgaard Carlsen, S.","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Charlotte Kristiane","key":"hjulsagerpau","last":"Hjulsager","locid":"6c1511ef-8211-4653-8c81-cd55b7f63f64","name":"Hjulsager, Charlotte Kristiane","orcid":"0000-0001-7557-8876","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Lars Erik","key":"larsenpau","last":"Larsen","locid":"09c2a33d-b353-44de-a850-f3c7dec879cb","name":"Larsen, Lars Erik","orcid":"0000-0003-0730-5555","rank":6,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-81e018e5-39d4-41c4-9974-a9c50a285441"],"src":["DTU Technical University of Denmark"],"title":"Simultaneous vaccination with PRRS mlv against both PRRSV type 1 and type 2 : duration of viraemia and level of clinical protection","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-343353","year":"2015","yearsub":"2015"}
{"abstract":"Der er i 2014 gennemført en systematisk, prospektiv passiv overvågning af cirkulerende influenzavirus subtyper i danske svin. Det overordnede formål med overvågningen var, at identificere hvilke influenzavirus subtyper og stammer, der cirkulerer blandt danske svin, og at kortlægge sygdomsårsager i svinepopulationen med henblik på at sikre det strategiske mål: at mindske antibiotikaforbruget i danske svinebesætninger. Overvågningen har bestået i: 1) Undersøgelse for influenzavirus vha. pan-influenza A virus real time RT-PCR på brugerbetalte diagnostiske indsendelser til influenzavirusundersøgelse på DTU-VET 2) Test af influenzavirus positive prøver for pandemisk H1N1 (H1N1pdm09) ved real time RT-PCR der specifikt detekterer HA-genet i H1N1pdm09 virus 3) Isolering af virus i MDCK celler 4) Subtypning af positive virusisolater ved sekvensanalyse (HA og NA generne) 5) Komplet genom karakterisering af udvalgte virusisolater Der blev totalt i 2014 iværksat undersøgelse for influenza A virus på 1173 prøver fordelt på 538 indsendelser fra 422 besætninger. I alt var 435 (37 %) af prøverne positive og 239 (44 %) af indsendelserne havde minimum en positiv prøve fordelt på 199 forskellige besætninger. Indsendelserne fordelte sig over hele landet og over hele året. Der var flest indsendelser til undersøgelse i de kolde måneder, men influenza virus blev påvist med næsten samme hyppighed hele året. I alt blev 80 influenzavirus positive indsendelser opdyrket i MDCK celler. De dyrkede virusisolater blev undersøgt ved sekvensanalyse for at bestemme subtypen. Disse analyser viste, at de to mest almindelige subtyper i danske svin i 2014 var den danske variant af H1N2 og H1N1pdm09. Prævalensen af det almindelige svineinfluenza virus ”avian-like swine” H1N1 subtype er faldet drastisk og forekom i 2014 tilsyneladende mindre hyppigt end H1N1pdm09 subtypen. Influenzavirus af subtypen H3N2, der har cirkuleret i Danmark siden 1990, blev påvist i en enkelt indsendelse i 2014, hvilket også var tilfældet i 2013. Den centraleuropæiske variant af H1N2, der har et human-like HA gen, er i lighed med tidligere år ikke påvist i danske svin. Virus med subtypen H1pdm09 blev påvist i 60 indsendelser fra 55 besætninger og udgjorde således 24 % af de influenzavirus positive indsendelser. Dette er næsten en fordobling i forhold til 2013. Hos mennesker var 2014 domineret af H1N1pdm09 subtypen, men det er uklart om stigningen hos svin i 2014 skyldes øget smitteoverførsel fra mennesker til svin. Resultaterne af overvågningen i 2014 underbygger antagelsen om at de nye reassortments fra de foregående år: H1N2hu, H1pdmN2hu og H1pdmN2sw, nu er fast etableret i de danske svinebesætninger. Ud over disse subtyper blev der i 2014 fundet en helt ny reassortment: H3hu05N2sw. Dette virus bærer et human-like HA gen, der ligner dem, der cirkulerede i den danske befolkning i 2004-2005, samt et NA gen med stor lighed med NA genet i H1N2 virus fra danske svin. De interne gener stammer alle fra H1N1pdm09 subtypen. Der er i dette tilfælde tale om en triple-reassortment (blanding af tre forskellige influenza virus), men da HA genet har cirkuleret i den humane befolkning for nylig, må det formodes at der er stor grad af immunitet mod denne type. Resultaterne beskrevet i rapporten er vigtige i forhold til såvel zoonotiske som veterinære aspekter ved influenza A virus infektion i svin i Danmark. Undersøgelserne har med stor sandsynlighed vist, at H1N1pdm09, som stadig må betragtes som en zoonose, nu er etableret i den danske svinepopulation, hvor den cirkulerer uafhængigt af den humane influenzavirus sæson. Overvågningen har endvidere påvist adskillige nye virus reassortments, hvor gener fra H1N1pdm09 indgår, bl.a. tyder det på at H1N2 virus med interne gener fra H1N1pdm09 har etableret sig i den danske svine population Der er global bevågenhed omkring svineinfluenzavirus med interne gener fra H1N1pdm09, da der i flere tilfælde er vist smitte med sådanne virus til mennesker, fx H3N2v i USA. Overvågningen har også bidraget til, at vi tidligt har påvist et nyt virus med zoonotisk potentiale som H3hu05N2sw. Dette betyder, at der kan foretages en nærmere genetisk og biologisk karakterisering af dette virus, hvilket kan danne evidens-baseret baggrundsviden for risikohåndteringen, i det tilfælde at der konstateres human smitte med dette virus. Den fremtidige overvågning vil bl.a. have fokus på at undersøge om dette virus bliver etableret i danske svin. Fra et veterinært synspunkt er det vigtigt at få fastlagt hvilke(n) subtype(r), der cirkulerer i besætningen, da valg af vaccine er afhængig af denne information. Det er derfor positivt, at der over de senere år er sket en stigning i antal indsendelser til influenzapåvisning i Danmark, da det øger muligheden for at vaccinere korrekt og derved nedbringe risikoen for antibiotika krævende sekundære infektioner. Det er også positivt at den H1N2 subtype (med human-like HA-gen), der er dominerende i andre dele af Europa, stadig ikke findes i Danmark. Introduktion af dette virus kan frygtes at få epizootisk karakter, da immuniteten i populationen mod dette virus er meget lille. Det kan konkluderes, at den iværksatte overvågning har givet et godt indblik i hvilke influenza A virus, der cirkulerer i danske svin, og at denne information dagligt bruges proaktivt ved håndtering af sygdom i besætningerne. Overvågningen har endvidere vist, at virus med nye gen kombinationer er blevet etableret i danske svin, og der bør de kommende år holdes øje med, om disse virus smitter til mennesker.","author_count":3,"contributors":["Krog, Jesper Schak","Hjulsager, Charlotte Kristiane","Larsen, Lars Erik"],"cuid":["S01-000.00-347545"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"overvågning af influenza a virus i svin i 000000002014","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/112139417/Overv_gning_af_influenza_A_virus_i_svin_i_2014_ORBIT.pdf","version":"Published Version"},"id":"S01-000.00-347545","ids":["dtu-90147190-3c00-4e2f-a356-f5e88a4ac580"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-3080BE5255C7AF5A2659D16B42F912D9"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/112139417/Overv_gning_af_influenza_A_virus_i_svin_i_2014_ORBIT.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Veterinary Institute"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Schak","key":"krogpau","last":"Krog","locid":"1e238a71-3075-4303-91fe-3cedb620123d","name":"Krog, Jesper Schak","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Charlotte Kristiane","key":"hjulsagerpau","last":"Hjulsager","locid":"6c1511ef-8211-4653-8c81-cd55b7f63f64","name":"Hjulsager, Charlotte Kristiane","orcid":"0000-0001-7557-8876","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars Erik","key":"larsenpau","last":"Larsen","locid":"09c2a33d-b353-44de-a850-f3c7dec879cb","name":"Larsen, Lars Erik","orcid":"0000-0003-0730-5555","rank":3,"rolecode":"pau"}],"pub":{"publisher":"DTU Veterinærinstituttet","status":"p"},"review":"Peer Reviewed","sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-90147190-3c00-4e2f-a356-f5e88a4ac580"],"src":["DTU Technical University of Denmark"],"title":"Overvågning af influenza A virus i svin i 2014","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-347545","year":"2015","yearsub":"2015"}
{"abstract":"Influenza A virus (IAV) affects a wide range of species, though waterfowl is regarded the natural host for most IAV subtypes. Avian influenza (AI) viruses replicate in the intestinal tract of birds and are mainly transmitted by the fecal-oral route. Pinnipeds share the same shoreline habitats as many waterfowl species and are therefore potentially exposed to AIV. Outbreaks of AI in seals have been described in North America and Asia but prior to 2014 never in Europe. In 2014 massive deaths of harbor seals (Phoca vitulina) were reported in Northern Europe. In Denmark, harbor seals were initially found dead on the Danish island Anholt in Kattegat, which is the sea surrounded by Denmark, Norway and Sweden. Between June and August, 152 harbor seals were found dead. Four seals were submitted to the National Veterinary Institute in Dennmark and diagnosed with severe pneumonia. Influenza A virus of the subtype H10N7 was detected in two out of four seals. Subsequently IAV was detected in dead harbor seals at several locations in Denmark. The IAV outbreak appeared to move with time to the west through the Limfjord to the North Sea and further down south along the west coast of Jutland to the Wadden Sea. Outbreaks were subsequently reported from Germany and The Netherlands. The aim of this study was to characterize the viruses detected at the several locations by molecular and phylogenetic analysis. All viruses were subtyped as H10N7 with genes of avian origin. The HA and NA genes of the viruses were highly similar to H10N7 IAV detected in harbor seals in Sweden in the spring of 2014 and in Germany in the autumn of 2014, suggesting that the same strain of virus had spread from Sweden to Denmark and further on to Germany.","author_count":10,"contributors":["Hjulsager, Charlotte Kristiane","Krog, Jesper Schak","Hansen, Mette Sif","Holm, Elisabeth","Chriél, Mariann","Pedersen, Karl","Andresen, Lars Ole","Abildstrøm, Morten","Hammer Jensen, Trine","Larsen, Lars Erik"],"cuid":["S01-000.00-368386"],"event":{"end":"2015-04-17","place":"Athens, us","start":"2015-04-15","title":"3rd International Symposium on Neglected Influenza Viruses","year":"2015"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Anholt Gartneri & Naturpleje"],"U":["DI-U-AAU","DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-AAU","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"influenza a virus h000000000010n000000000007 detected in dead harbor seals phoca vitulina at several locations in denmark 000000002014","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/112139234/Abstract_H10N7_s_ler_submittet_3rd_Negl_Inf_Symposium.pdf","version":"Published Version"},"id":"S01-000.00-368386","ids":["dtu-d59bb1cc-4ec5-4a0f-987c-2279481808ee"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-40E5EBB96BAA88E06C3F118299ADDFCF"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/112139234/Abstract_H10N7_s_ler_submittet_3rd_Negl_Inf_Symposium.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Veterinary Institute"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Anholt Gartneri & N