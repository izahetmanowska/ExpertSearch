{"author_count":14,"contributors":["Feilberg, Karen Louise","Ditlevsen, Frederik P.","Eftekhari, Ali Akbar","Bovet, Nicolas","Yan, Wei","Mokhtari, Rasoul","Orlander, Tobias","Holmslykke, Hanne D.","Dideriksen, Knud","Yang, Yi","Larsen, Birgitte D.","Larsen, Charlotte Nørgaard","Nick, Hamid","Horikx, Hans"],"cuid":["S01-000.00-371557"],"event":{"end":"2022-11-30","place":"Kolding, dk","start":"2022-11-29","title":"Danish Offshore Technology Conference 2022","year":"2022"},"filters":{"added":"2023-02","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-GEUS"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-GV-GEUS","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"why store co000000000002 in chalk chalk suitability for co sub 000000000002 sub storage","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/303288894/2022_11_04_1667560287.pdf","version":"Published Version"},"id":"S01-000.00-371557","ids":["dtu-e008f9ae-066f-4f67-9cea-87618dafd1d7"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-A96A5D58AC673E3954ADEDA56DC5D03B"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/303288894/2022_11_04_1667560287.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Danish Offshore Technology Centre","Technical University of Denmark, Danish Offshore Technology Centre, Laboratory for Off-Shore Production Scien