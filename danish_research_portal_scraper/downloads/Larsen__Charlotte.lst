iations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["au-3376846e-3c11-4c78-bb3e-adba1fd5e620","dtu-41165042-4046-483e-95c7-6c37433f7e52"],"src":["AU Aarhus University","DTU Technical University of Denmark"],"title":"Sanitary survey rapport 3: Venø Bugt, Kås og Salling","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-092.55-016376","year":"2017","yearsub":"2017"}
{"author_count":6,"contributors":["Moeller, Christian","Rasmussen, Martin","Hjulsager, Charlotte Kristiane","Kongsted, Hanne","Hansen, Claus","Larsen, Lars Erik"],"cuid":["S02-093.55-024455"],"event":{"end":"2017-05-05","place":"Prague, cz","start":"2017-05-03","title":"9th European Symposium of Porcine Health Management (ESPHM 2017)","year":"2017"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Rotavirus A","Spædgrisediarré"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-SEGES"],"U":["DI-U-ALL","DI-U-AU","DI-U-DTU","DI-U-KU"]},"level3all":["DI-PR-SEGES","DI-U-AU","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"rotavirus type a associated diarrhoea in neonatal piglets importance and biodynamics","src":["au","dtu"],"src-code":["DI-U-AU","DI-U-DTU"],"type":"dco","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/132187640/VVD_046_Moeller.pdf","version":"Published Version"},"id":"S02-093.55-024455","ids":["au-a0f8b416-c483-4777-abc8-511e7c97ac49","dtu-3f4a7690-ecc2-4a23-8c3a-12b9efb5e971"],"keyword":["Rotavirus A","Spædgrisediarré"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-2-0454DDFB3147A4BDCA0CDFCC14171C2D"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/132187640/VVD_046_Moeller.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key