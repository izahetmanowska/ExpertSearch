, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics, FIIBL - Research and Implementation Centre for Human Movement and Learning","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics, Research Unit of Active Living"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"ucl university college","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-UCL","l3nl":"UCL University College","l3nn":"UCL University College","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"UCL University College","namevar":["University College Lillebælt"],"nora_code":"DI-UC-UCL","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Charlotte Boslev","key":"præstpau","last":"Præst","locid":"07645ca9-9eeb-43b2-81a2-1de971bcafb3","name":"Præst, Charlotte Boslev","orcid":"0000-0002-0278-3673","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Danielle Louise","key":"nøragerjohansenpau","last":"Nørager Johansen","locid":"a42269eb-2e09-475c-a91f-8c717282e436","name":"Johansen, Danielle Louise Nørager","name_org":"Nørager Johansen, Danielle Louise","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Danielle Louise Nørager","key":"johansenpau","last":"Johansen","name":"Johansen, Danielle Louise Nørager","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Thomas","key":"skovgaardpau","last":"Skovgaard","locid":"2c6eebd4-6fdf-4819-bf31-6ae3c7e0b582","name":"Skovgaard, Thomas","orcid":"0000-0001-6729-4988","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars Breum","key":"christiansenpau","last":"Christiansen","locid":"c168a51e-682a-42f8-8a57-fa705d9749e9","name":"Christiansen, Lars Breum","orcid":"0000-0002-5142-3623","rank":4,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Camilla Marie","key":"larsenpau","last":"Larsen","locid":"0fdd3035-e7da-4ae3-9e99-f247aecd54e3","name":"Larsen, Camilla Marie","orcid":"0000-0003-4691-3609","rank":5,"rolecode":"pau"}],"pmid":["37202175"],"pub":{"doi":"10.1111/dmcn.15594","issn":["00121622","04190238"],"issn_org":["00121622"],"issue":"Suppl.2","journal":"Developmental Medicine and Child Neurology","pages":"24-25","publisher":"Wiley-Blackwell","status":"p","title":"Developmental Medicine and Child Neurology","volume":"65"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","All University Colleges","DI-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","UCL University College","Universities","University Colleges","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-ec4ee664-baa6-4d9f-990d-a76cbbd7ff43","ucl-c5b6c61d-f8af-46ca-a994-af4336f94644"],"src":["SDU University of Southern Denmark","UCL University College"],"title":"‘Training as play’ – A change in the approach to training for parents of children with cerebral palsy after participating in a family-centered early intervention program ‘Good start’","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-096.59-725339","year":"2023","yearsub":"2023"}
{"abstract":"Influenza A viruses are RNA viruses that cause epidemics in humans and are enzootic in the pig population globally. In 2009, pig-to-human transmission of a reassortant H1N1 virus (H1N1pdm09) caused the first influenza pandemic of the 21st century. This study investigated the infection dynamics, pathogenesis, and lesions in pigs and ferrets inoculated with natural isolates of swine-adapted, human-adapted, and \"pre-pandemic\" H1N1pdm09 viruses. Additionally, the direct-contact and aerosol transmission properties of the three H1N1pdm09 isolates were assessed in ferrets. In pigs, inoculated ferrets, and ferrets infected by direct contact with inoculated ferrets, the pre-pandemic H1N1pdm09 virus induced an intermediary viral load, caused the most severe lesions, and had the highest clinical impact. The swine-adapted H1N1pdm09 virus induced the highest viral load, caused intermediary lesions, and had the least clinical impact in pigs. The human-adapted H1N1pdm09 virus induced the highest viral load, caused the mildest lesions, and had the least clinical impact in ferrets infected by direct contact. The discrepancy between viral load and clinical impact presumably reflects the importance of viral host adaptation. Interestingly, the swine-adapted H1N1pdm09 virus was transmitted by aerosols to two-thirds of the ferrets. Further work is needed to assess the risk of human-to-human aerosol transmission of swine-adapted H1N1pdm09 viruses.","author_count":12,"contributors":["Kristensen, Charlotte","Glud, Helena Aagaard","Crumpton, Jeri-Carol","Martiny, Karen","Webb, Ashley","Ryt-Hansen, Pia","Trebbien, Ramona","Jensen, Henrik E.","Nissen, Jakob N.","Skovgaard, Kerstin","Webby, Richard J.","Larsen, Lars E."],"cuid":["S02-097.15-716210"],"filters":{"added":"2024-02","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","OECD"],"corresponding_author":["Kristensen, Charlotte"],"country":["United States"],"glorg":["All Global Affiliations","St. Jude Children’s Research Hospital"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-GV-SSI","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"experimental infection of pigs and ferrets with pre pandemic human adapted and swine adapted variants of the h000000000001n000000000001pdm000000000009 influenza a virus reveals significant differences in viral dynamics and pathological manifestations","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.ppat.1011838","version":"Published Version"},"id":"S02-097.15-716210","identifier":[{"id":"001124345500004","type":"wos"},{"id":"38048355","type":"pmid"},{"id":"85180010480","type":"scopus"},{"id":"PMC10721187","type":"pmcid"}],"ids":["dtu-221ac87d-3ad7-4536-aec0-298c4f88ac6b","ku-4fa8f00a-b52b-490f-aa4f-a0de70383839"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-0E684A6B4320FA6865C6501FC0413500"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.ppat.1011838","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/379169119/journal.ppat.1011838.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/376347884/journal.ppat.1011838.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Køben