{"author_count":4,"contributors":["Buhl, Hanne","Bay, Gina","Albrechtsen, Charlotte","Larsen, Martin Damgaard"],"cuid":["S01-000.00-580845"],"event":{"end":"2012-11-24","place":"Aarhus, dk","start":"2012-11-22","title":"The 19th NIC conference on intercultural communication","year":"2012"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"repositioning international students a case of intercultural learning in which the host university is the learner","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-580845","ids":["sdu-1aa90efd-a778-4687-99c3-6feb4589a26f"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-F8877473441F5A04C6D6B3706374238D"],"org":[{"affno":"1","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Business and Social Sciences, Department of Business & Management (DBM)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Hanne","key":"buhlpau","last":"Buhl","name":"Buhl, Hanne","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Gina","key":"baypau","last":"Bay","name":"Bay, Gina","rank":2,"rol