enpau","last":"Schourup-Kristensen","locid":"ff67289c-b2cd-4517-991a-4e8e779421bf","name":"Schourup-Kristensen, Vibe","orcid":"0000-0003-0263-9046","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Christian","key":"mohnpau","last":"Mohn","locid":"3249f637-7852-40ab-b6ac-1b8670bcd9c9","name":"Mohn, Christian","orcid":"0000-0002-4331-1365","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ange Pacifique","key":"ishimwepau","last":"Ishimwe","locid":"c3830b6b-d0b3-449d-9d98-6fd307492afa","name":"Ishimwe, Ange Pacifique","orcid":"0000-0002-6668-0067","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Eva Friis","key":"møllerpau","last":"Møller","locid":"b6bcca6a-bc33-4771-b944-4a952088440e","name":"Møller, Eva Friis","orcid":"0000-0002-7640-3514","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Charley","key":"clubleypau","last":"Clubley","locid":"5a460258-4124-40ae-9baa-7b33daa93891","name":"Clubley, Charlotte Hannah","name_org":"Clubley, Charley","orcid":"0000-0002-9861-7687","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Janus","key":"larsenpau","last":"Larsen","locid":"9397f4f7-fa9f-450c-8225-9551ff919777","name":"Larsen, Janus","orcid":"0000-0002-1054-412X","rank":7,"rolecode":"pau"}],"pub":{"issn":["22449981"],"issue":"658","pages":"73","publisher":"Aarhus University, DCE - Danish Centre for Environment and Energy","repno":"Videnskabelig rapport fra DCE - Nationalt Center for Miljø og Energi, No. 658","series":"Videnskabelig rapport fra DCE - Nationalt Center for Miljø og Energi","status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-b5318169-655a-40b5-a8f1-d0f36b0536a8"],"src":["AU Aarhus University"],"title":"Spatial impacts of offshore wind farms on hydrodynamics and biogeochemical environment","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-826175","year":"2025","yearsub":"2025"}
{"abstract":"The aim of this study was to evaluate the impact of the four-day family-centered early intervention program Good Start on psychosocial constructs related to quality of life in parents of children with cerebral palsy. Parental well-being, life satisfaction, sense of coherence, parenting efficacy, and family empowerment were assessed using recognized scales in a pre-post-follow-up design involving 38 parents. Measurements at baseline, three weeks, and six months post-program showed statistically significant improvements over time in most outcomes, except for the Efficacy and Family Empowerment Subscales immediately after the program. At six months, all outcomes except the Family Subscale showed sustained improvement. The findings suggest that Good Start is associated with positive changes in parental well-being, life satisfaction, sense of coherence, and parenting efficacy. Overall, family empowerment ratings were relatively high, which indicates a solid foundation of perceived capacity and confidence among families. This study indicates that a brief, family-centered intervention may be associated with psychosocial changes similar to those observed in longer programs. Studies with larger samples and including control factors are needed to confirm the study’s findings.","author_count":5,"contributors":["Larsen, Camilla Marie","Præst, Charlotte Boslev","Johansen, Danielle Louise Nørager","Skovgaard, Thomas","Christiansen, Lars Breum"],"cuid":["S01-000.00-831115"],"filters":{"added":"2025-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Larsen, Camilla Marie"],"keyword":["Cerebral palsy","Quality of Life"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U","DI-UC"],"level3":{"U":["DI-U-ALL","DI-U-SDU"],"UC":["DI-UC-ALL","DI-UC-UCL"]},"level3all":["DI-U-SDU","DI-UC-UCL"]},"review":"pr","rtype":["clu"],"sorti":"impact of the family centered early intervention program good start on psychosocial constructs related to quality of life in parents of children with cerebral palsy a pre postfollow up study","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.16993/sjdr.1249","version":"Published Version"},"funding_acknowledgement":["The evaluation of the early intervention program Good Start is funded by the Elsass Foundation, Denmark."],"id":"S01-000.00-831115","identifier":[{"id":"105013372750","type":"scopus"}],"ids":["sdu-65a1fe17-ece5-49ca-8d66-276b69e481c8"],"keyword":["Cerebral palsy","Family-centered program","Psychosocial constructs","Quality of life","‘Good Start’"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-2-A0CBE3EF98ACBB40197062084E8E2616"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/295075252/689475bde10ea.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.16993/sjdr.1249","version":"Published Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics, FIIBL - Research and Implementation Centre for Human Movement and Learning","SDU, The Faculty of Health Sciences, Department of Sports Science and Clinical Biomechanics, Research Unit of Musculoskeletal Function and Physiotherapy"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"ucl university college","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-UCL","l3nl":"UCL University College","l3nn":"UCL University College","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"UCL University College","namevar":["University College Lillebælt"],"nora_code":"DI-UC-UCL","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Camilla Marie","key":"larsenpau","last":"Larsen","locid":"0fdd3035-e7da-4ae3-9e99-f247aecd54e3","name":"Larsen, Camilla Marie","orcid":"0000-0003-4691-3609","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Charlotte Boslev","key":"præstpau","last":"Præst","locid":"07645ca9-9eeb-43b2-81a2-1de971bcafb3","name":"Præst, Charlotte Boslev","orcid":"0000-0002-0278-3673","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Danielle Louise Nørager","key":"johansenpau","last":"Johansen","locid":"a42269eb-2e09-475c-a91f-8c717282e436","name":"Johansen, Danielle Louise Nørager","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Thomas","key":"skovgaardpau","last":"Skovgaard","locid":"2c6eebd4-6fdf-4819-bf31-6ae3c7e0b582","name":"Skovgaard, Thomas","orcid":"0000-0001-6729-4988","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars Breum","key":"christiansenpau","last":"Christiansen","locid":"c168a51e-682a-42f8-8a57-fa705d9749e9","name":"Christiansen, Lars Breum","orcid":"0000-0002-5142-3623","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.16993/sjdr.1249","issn":["15017419","17453011"],"issn_org":["15017419"],"issue":"1","journal":"Scandinavian Journal of Disability Research","pages":"402-417","publisher":"Stockholm University Press","status":"p","title":"Scandinavian Journal of Disability Research","volume":"27"},"review":"Peer Reviewed","scoID":["2-s2.0-105013372750"],"search":{"DAF":["All Danish Affiliations","All Universities","All University Colleges","DI-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","UCL University College","Universities","University Colleges","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-65a1fe17-ece5-49ca-8d66-276b69e481c8"],"src":["SDU University of Southern Denmark"],"title":"Impact of the Family-Centered Early Intervention Program Good Start on Psychosocial Constructs Related to Quality of Life in Parents of Children with Cerebral Palsy : A Pre-PostFollow-Up Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-831115","year":"2025","yearsub":"2025"}
{"abstract":"Today, emergent space technology engages in visions of future off-world colonizing, while conservation technology is employed in ensuring the continuation of life on earth. In this article, we combine social science of outer space literature with biodiversity conservation work to analyze how utopian visions of off-world futures and dystopian visions of earth entangle in technoscientific future-making practices. Our case is the Lunar Ark, which is a proposed technoscientific project for a conservation base to be assembled inside the moon’s lava tubes comprising samples of the earth’s ecosystems. We investigate two interwoven imaginaries involving an imaginary of the Lunar Ark as a “reseeding of earth” and secondly, an imaginary in which the Lunar Ark becomes a platform for “escaping earth.” Based on scientific papers, web material, news articles, an interview with the head of the research group, and ethnographic observations, we conclude that the Lunar Ark engages with a speculative bioeconomy, wherein earth is imagined as an unstable and unfit protector of life. In contrast, the Lunar Ark emerges as a pan-humanitarian and maternal-like technoscientific environment.","author_count":2,"contributors":["Kroløkke, Charlotte","Larsen, Jonas Holm"],"cuid":["S01-000.00-831173"],"filters":{"added":"2025-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Kroløkke, Charlotte"],"keyword":["Conservation","Imaginaries"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"saved by the moon imaginaries of earthly afterlife in space","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85194588848","version":"Other Version"},"id":"S01-000.00-831173","identifier":[{"id":"85194588848","type":"scopus"}],"ids":["sdu-78b6d4c1-9541-445c-bd1f-80429b543c91"],"keyword":["Lunar Ark","conservation","imaginaries","multiplanetary futures","social science of outer space"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Global-Local-2-4-86C5A80C4DAD0E77F2400005B576923F"],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Humanities, Department of Culture and Language"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Charlotte","key":"kroløkkepau","last":"Kroløkke","locid":"236107c9-6035-4e92-9d56-48001ff66971","name":"Kroløkke, Charlotte","orcid":"0000-0002-9264-5265","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jonas Holm","key":"larsenpau","last":"Larsen","locid":"f01089ee-91a7-42ae-a853-c9c6c5cd1a62","name":"Larsen, Jonas Holm","rank":2,"rolecode":"pau"}],"pub":{"doi":"10.1177/01622439241255733","issn":["01622439","15528251"],"issn_org":["01622439"],"issue":"4","journal":"Science, Technology & Human Values","pages":"830-856","publisher":"SAGE Publications","status":"p","title":"Science, Technology & Human Values","title_org":"Science Technology and Human Values","volume":"50"},"review":"Peer Reviewed","scoID":["2-s2.0-85194588848"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-78b6d4c1-9541-445c-bd1f-80429b543c91"],"src":["SDU University of Southern Denmark"],"title":"Saved by the Moon : Imaginaries of Earthly Afterlife in Space","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-831173","year":"2025","yearsub":"2025"}
{"abstract":"The Copenhagen Hospital Biobank-chronic inflammatory disease—inflammatory bowel disease (CHB-CID: IBD) cohort contributes to genetic research in inflammatory bowel disease, including Crohn’s disease and ulcerative colitis. Of the 327,084 enrolled and genotyped individuals in the cohort, 10,626 have been diagnosed with IBD as of May 2023. The CHB-CID: IBD cohort includes both patients without IBD and healthy blood donors as control groups. Clinical data is collected from Danish registries and patient records, including details on hospital contacts, co-morbidities, medication, surgical procedures, and laboratory investigations. The cohort features a wide age range (> 18 years), extensive population coverage representative of Danish adults, and validated IBD diagnoses. Finally, the cohort benefits from continuous recruitment and regular updates of clinical information. The aim is to enhance IBD management and ultimately improve patients’ quality of life.","author_count":99,"contributors":["Darbani, Behrooz","Brodersen, Thorsten","Liljensøe, Anette","Sørensen, Signe Bek","Olsson-Svendsen, Josephine Bjergbæk","Buil, Alfonso","Kamal, Ahmed","Schork, Andrew J","Poulsen, Anja","Kjerulff, Bertram","Aagaard, Bitten","Lund, Britta Ørnfelt","Rittig, Charlotte Siggaard","Mikkelsen, Christina","Larsen, Daniel Millencourt","Westergaard, David","Rudbeck-Resdal, Ditte","Mikkelsen, Dorte Helenius","Randers, Else","Schiødt, Frank Vinholt","Hoffmann, Hans Jürgen","Jørgensen, Isabella Friis","Brandslund, Ivan","Brodersen, Jacob Broder","von Stemann, Jakob Hjorth","Bay, Jakob Thaning","Nissen, Janna","Sørensen, Jeanette","Boldsen, Jens Kjærgaard","Dowsett, Joseph","Gladov, Josephine","Banasik, Karina","Kaspersen, Kathrine Agergård","Carlsen, Katrine","Dinh, Khoa Manh","Kellermann, Lauge","Christoffersen, Lea Arregui Nordahl","Quinn, Liam James Elgaard","Thørner, Lise Wegner","Larsen, Lone","Aamann, Luise","Andersen, Malene Rohr","Didriksen, Maria","Alexandraki, Maria Joanna","Thomsen, Marianne Kragh","Julsgaard, Mette","Nyegaard, Mette","Schwinn, Michael","Topholm-Bruun, Mie","Leite, Mikael Njai","Halling, Morten Lee","Pedersen, Natalia","Bonderup, Ole Kristian","Rohde, Palle Duun","Ovesen, Pernille Dige","Dessau, Ram Benny","Saboori, Sanaz","Holm-Christensen, Sofie","Bank, Steffen","Mikkelsen, Susan","Hansen, Thomas Folkmann","Werge, Thomas","Qvist, Niels","Sørensen, Erik","Burisch, Johan","Hetland, Merete Lund","Glintborg, Bente","Erikstrup, Christian","Brunak, Søren","Ullum, Henrik","Ostrowski, Sisse Rye","Pedersen, Ole Birger Vesterager","Andersen, Vibeke"],"cuid":["S03-094.41-813496"],"filters":{"added":"2025-08","altsrc":["Global Data"],"author_count":"51-200 contributors","class":"merged","cluster_size":3,"corresponding_author":["Darbani, Behrooz"],"keyword":["Crohn s disease","Faecal Calprotectin","Genetic cohort","Genetic relatedness","Inflammatory bowel disease","Ulcerative colitis"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-OT","DI-PR","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA"],"OT":["Esbjerg og Grindsted Sygehus"],"PR":["DI-PR-ALK","DI-PR-ALL"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA","DI-PR-ALK","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"cohort profile copenhagen hospital biobank chronic inflammatory disease inflammatory bowel disease chb cid ibd genetic cohort","src":["aau","au","ku"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s10654-025-01239-4","version":"Published Version"},"funding_acknowledgement":["Open access funding provided by University of Southern Denmark. TARCID was funded by the Novo Nordisk Fonden (NNF15OC0016932, Vibeke Andersen), Knud og Edith Eriksens Mindefond (Vibeke Andersen), and Gigtforeningen (A2037, A3570, Vibeke Andersen). DBDS is funded by an annual grant from Bio- and Genome Bank Denmark. The initiation of DBDS was supported by the Danish Administrative Regions (02/2611) and the Danish Council for Independent Research (09\\u2013069412). Additionally, the DBDS is funded by the Novo Nordisk Foundation (NNF23OC0082015, NNF17OC0027864, and NNF17OC0027594). CHB sample collection was facilitated by the infrastructure of Bio- and Genome Bank Denmark. Furthermore, CHB is supported by the Department of Clinical Immunology, Rigshospitalet, Copenhagen University Hospital, Copenhagen, Denmark and by grants from Novo Nordisk Foundation (NNF23OC0082015, NNF17OC0027594) and Rigshospitalet Research Council (Framework grant). DRB was funded by the Danish Rheumatism Association and Danish Regions. Danish Regions are funding the continued collection of biological samples and clinical data. All personal fees and grants were received outside this work. Anja Poulsen reports research grants and personal fees from Janssen, Takeda, and MSD, personal fees from Bristol Myers Squibb, national coordinator of studies from Agomab, Boehringer Ingelheim and Bristol Myers. Bente Glintborg has received research grants (paid to institution) from AbbVie, Pfizer, BMS, Sandoz. Bente Glintborg chairs the DANBIO steering committee. Jacob Broder Brodersen has received consultation fee from Jansen-Cilag. Johan Burisch reports grants and personal fees from AbbVie, Janssen-Cilag, Takeda, Tillots Pharma, Bristol Myers Squibb, and MSD, personal fees from Celgene, Pfizer, Samsung Bioepis, Pharmacosmos, Ferring, Galapagos, and Eli Lilly, and grants from Novo Nordisk Foundation. Mette Julsgaard has received research grants from Takeda and the Novo Nordisk Foundation (grant no. NNF23OC0081717), has been on the advisory board of PharmaCosmos, has received consultation fee from Ferring and Takeda, and has received speaker\\u2019s fees from Tillotts Pharma, MSD, Ferring, and Takeda. Vibeke A ndersen has served as advisory board member for MSD (Merck). S\\u00F8ren Brunak has ownerships in Intomics A/S, Hoba Therapeutics Aps, Novo Nordisk A/S, Lundbeck A/S, ALK abello A/S, Eli Lilly and Co and managing board memberships in Proscion A/S and Intomics A/S. Thorsten Brodersen\\u2019s spouse currently holds incentive stock options in LEO Pharma A/S. All other authors declare no conflict of interest. We thank all the participating patients and blood donors who participate in DBDS, collaborating partners, blood centers, and the Danish hospitals for their valuable contributions. We thank deCODE genetic-Iceland for genotyping and imputation. S\\u00F8ren Brunak acknowledges Novo Nordisk Foundation (grants NNF17OC0027594 and NNF14CC0001). The authors wish to thank Ditlev Nytoft Rasmussen, Miriam Viktov Thygesen, and Gitte B. Fuusager for his contribution to TARCID."],"id":"S03-094.41-813496","identifier":[{"id":"105007672762","type":"scopus"},{"id":"40488802","type":"pmid"},{"id":"PMC12263709","type":"pmcid"}],"ids":["aau-ed9ac142-b1da-4775-9fa9-c44d1679fa45","au-188bade2-a9a2-4d12-883d-5d064d52ff97","ku-8bde7dc9-711a-4d82-96b4-b5ea91d26a9a"],"keyword":["Crohn’s disease","Faecal Calprotectin","Genetic cohort","Genetic relatedness","Inflammatory bowel disease","Ulcerative colitis"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-A8E9DB723037324D70D51C24E4FE2B02"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s10654-025-01239-4","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/787941589/Open_Access_Article.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/457149839/s10654-025-01239-4.pdf","version":"Published Version"}],"org":[{"affno":"1","coun