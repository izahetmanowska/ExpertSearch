KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Life Sciences, Department of Large Animal Sciences, Production & Health"],"nora_code":"DI-U-KU","used":1},{"affno":"4","country":"dk","key":"danish agriculture food council","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-AAF","l3nl":"Danish Agriculture & Food Council","l3nn":"Danish Agriculture & Food Council","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Danish Agriculture & Food Council","namevar":["Pig Research Centre"],"nora_code":"DI-PR-AAF","used":1},{"affno":"5","country":"au","key":"deptartment of primary industies","loc":["Australia","Oceania","OECD"],"name":"Deptartment of Primary Industies","used":1}],"person":[{"affno":"1","first":"P.K.","key":"holyoakepau","last":"Holyoake","name":"Holyoake, P.K.","rank":1,"rolecode":"pau"},{"affno":"2","first":"Charlotte Kristiane","key":"hjulsagerpau","last":"Hjulsager","name":"Hjulsager, Charlotte Kristiane","rank":2,"rolecode":"pau"},{"affno":"2","first":"Lars Erik","key":"larsenpau","last":"Larsen","name":"Larsen, Lars Erik","rank":3,"rolecode":"pau"},{"affno":"3","first":"Ken Steen","key":"pedersenpau","last":"Pedersen","locid":"e7e2a10f-e368-4635-9481-f23e58c80aa8","name":"Pedersen, Ken Steen","rank":4,"rolecode":"pau"},{"affno":"4","first":"M.","key":"johansenpau","last":"Johansen","name":"Johansen, M.","rank":5,"rolecode":"pau"},{"affno":"3","first":"Helle","key":"stegepau","last":"Stege","locid":"fcd35d18-c0ae-4328-95f3-f912e648c498","name":"Stege, Helle","orcid":"0000-0003-3033-4207","rank":6,"rolecode":"pau"},{"affno":"5","first":"K.","key":"moorepau","last":"Moore","name":"Moore, K.","rank":7,"rolecode":"pau"},{"affno":"2","first":"Marie","key":"ståhlpau","last":"Ståhl","name":"Ståhl, Marie","rank":8,"rolecode":"pau"},{"affno":"2","first":"Øystein","key":"angenpau","last":"Angen","name":"Angen, Øystein","rank":9,"rolecode":"pau"},{"affno":"3","first":"Jens Peter","key":"nielsenpau","last":"Nielsen","locid":"e550301c-f89e-4a8b-bf34-e6fc3b76ff37","name":"Nielsen, Jens Peter","rank":10,"rolecode":"pau"}],"pub":{"pages":"141","publisher":"European College of Porcine Health Management","status":"p","subtitle":"Programme &amp; abstract book","title":"4th European Symposium of Porcine Health Management"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Danish Agriculture & Food Council","Private Research","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-b56a3aa5-b786-4019-9d4e-0bc14f3855c7"],"src":["KU University of Copenhagen"],"title":"Real-time PCR testing for Porcine Circovirus Type 2 and Lawsonia intracellularis to assess diarrhoea","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-501793","year":"2012","yearsub":"2012"}
{"abstract":"Background: There have been several attempts to systematically assess performance in bronchoscopy. Earlier validation studies have used bronchoscopy simulators, not real-life performance in patients. Objectives: The aim of this study was to explore the reliability and validity of an assessment tool aimed for the use in a clinical setting. Methods: Five junior residents, 5 senior residents and 9 consultants performed 3 bronchoscopies each. All 57 bronchoscopies were video-recorded and assessed blindly and independently by two bronchoscopy experts using the new assessment tool. Results: The interrater reliability was high, with Cronbach's a = 0.86. Assessment of 3 bronchoscopies by a single rater had a generalizability coefficient of 0.84. The correlation between experience and performance was good (Pearson correlation = 0.76). There were significant differences between the groups for all aspects of the assessment, but post hoc tests showed different discriminative abilities. Conclusions: This new tool for assessing clinical bronchoscopy performance has a high interrater reliability. One rater assessing performance of 3 bronchoscopies ensures sufficient reliability. The assessment tool demonstrated sufficient construct validity.","author_count":6,"contributors":["Konge, Lars","Larsen, Klaus Richter","Clementsen, Paul","Arendrup, Henrik","von Buchwald, Christian","Ringsted, Charlotte"],"cuid":["S01-000.00-525702"],"filters":{"added":"2022-04","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"reliable and valid assessment of clinical bronchoscopy performance","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1159/000330061","version":"Other Version"},"id":"S01-000.00-525702","identifier":[{"id":"21912087","type":"pmid"},{"id":"84855999976","type":"scopus"}],"ids":["ku-dd6faaee-5c32-4fb4-8a13-4a8ddf21305e"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-A84815B6DE6B396E68DBA198DABC5EDA"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1159/000330061","version":"Other Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Lars","key":"kongepau","last":"Konge","locid":"e1c287e3-4cd2-43d2-887d-f2f77fd5daf8","name":"Konge, Lars","orcid":"0000-0002-1258-5822","rank":1,"rolecode":"pau"},{"affno":"","first":"Klaus Richter","key":"larsenpau","last":"Larsen","name":"Larsen, Klaus Richter","rank":2,"rolecode":"pau"},{"affno":"","first":"Paul","key":"clementsenpau","last":"Clementsen","name":"Clementsen, Paul","rank":3,"rolecode":"pau"},{"affno":"","first":"Henrik","key":"arendruppau","last":"Arendrup","locid":"5924ca7b-3563-4529-b194-c4ba09a569a3","name":"Arendrup, Henrik","rank":4,"rolecode":"pau"},{"affno":"","first":"Christian","key":"vonbuchwaldpau","last":"von Buchwald","name":"von Buchwald, Christian","rank":5,"rolecode":"pau"},{"affno":"","first":"Charlotte","key":"ringstedpau","last":"Ringsted","locid":"aad0b8e6-2821-409d-9ed2-33b6ffded4d2","name":"Ringsted, Charlotte","rank":6,"rolecode":"pau"}],"pmid":["21912087"],"pub":{"doi":"10.1159/000330061","issn":["00257931","14230356"],"issn_org":["00257931"],"issue":"1","journal":"Respiration","pages":"53-60","status":"p","title":"Respiration","volume":"83"},"review":"Peer Reviewed","