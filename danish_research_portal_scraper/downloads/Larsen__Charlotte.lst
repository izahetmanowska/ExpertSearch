sen","locid":"3fe4d15d-5f04-4ec0-87b8-000b5f993ed1","name":"Brasch-Andersen, Charlotte","name_org":"Brasch-Andersen, C.","orcid":"0000-0003-4273-0047","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"C.","key":"fagerbergpau","last":"Fagerberg","locid":"93aebc29-7681-4e3d-b613-867bd3a7eb65","name":"Fagerberg, Christina","name_org":"Fagerberg, C.","orcid":"0000-0002-5206-4327","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"M. J.","key":"larsenpau","last":"Larsen","locid":"7cfc93bc-88f4-48fa-86de-6b0147dc2825","name":"Larsen, Martin Jakob","name_org":"Larsen, M. J.","orcid":"0000-0003-4107-8771","rank":4,"rolecode":"pau"}],"pub":{"issn":["10184813","14765438"],"issn_org":["10184813"],"issue":"Suppl. 1","journal":"European Journal of Human Genetics","pages":"631","paperid":"P16.54.C","publisher":"Springer","status":"p","title":"European Journal of Human Genetics","volume":"28"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-0a44c823-31a6-4a25-b16d-9c115b800c88"],"src":["SDU University of Southern Denmark"],"title":"Robustness and accuracy validation of fetal fraction estimates in NIPT","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-576115","year":"2020","yearsub":"2020"}
{"abstract":"Can we color in the Altmetric donut by using a social media echo chamber, and does that manipulation lead to actual engagement with the work? Recently, a university professor told us every time she published she would tweet and re-tweet the DOI of her publication. To inflate her own Altmetric score she had created a series of artificial social media profiles “engaging” with her work. This peaked our curiosity and so we made a small-scale experiment. We encouraged our colleagues and the conference participants at LIBER 2019 to tweet and re-tweet the DOI of a letter to the editor describing our experiment published in LIBER Quarterly. The interest in our experiment spiraled out beyond our usual network. For every tweet we increased our score. But no matter how much we tried we did not manage to make it spread to other SoMe platforms than twitter and our donut has remained blue (the color of tweets). We tried again and again to obtain scores from Youtube, Google+, various blogs, but had no success. Our overall theoretical framework for this work is Roger’s diffusion of innovations theory. We will use this theory to explain both the success (many tweets) and the failures (on other platforms) of our experiment. Our poster is richly illustrated with maps how the DOI was tweeted and retweeted and examples of SoMe platforms where we were less successful and all of it set within the framework of our theoretical approach.","author_count":6,"contributors":["Dorch, Bertil F.","Deutz, Daniella Bayle","Wien, Charlotte","Drongstrup, Dorte","Vlachos, Evgenios","Larsen, Asger Væring"],"cuid":["S01-000.00-600204"],"event":{"end":"2020-06-26","place":"Den Haag, nl","start":"2020-06-22","title":"LIBER2020: Online","year":"2020"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"nr","rtype":["clu"],"sorti":"singing the donut blues creating a some echo chamber to boost the scores on altmetric","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dco","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.5281/zenodo.3874652","version":"Published Version"},"id":"S01-000.00-600204","ids":["sdu-5e643788-0e55-4991-9b7d-1a0a1b8bbfbd"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-331036848FE2ED16E67E175A772870C7"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.5281/zenodo.3874652","version":"Published Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Central Administration, The University Library of Southern Denmark, University Library of Southern Denmark. General Office"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Bertil F.","key":"dorchpau","last":"Dorch","locid":"da82eabd-45cb-46bf-b322-b68bb5f0294d","name":"Dorch, Bertil F.","orcid":"0000-0003-2594-6778","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Daniella Bayle","key":"deutzpau","last":"Deutz","locid":"0cb11e5a-a77e-4373-9b4d-1c30e830aaad","name":"Deutz, Daniella Bayle","orcid":"0000-0001-7230-6031","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Charlotte","key":"wienpau","last":"Wien","locid":"277f8354-05c4-44a4-b3b9-df9d557c9028","name":"Wien, Charlotte","orcid":"0000-0002-3257-2084","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Dorte","key":"drongstruppau","last":"Drongstrup","locid":"107fd236-3b34-45ab-8fa8-c46521f9390a","name":"Drongstrup, Dorte","orcid":"0000-0002-2541-3819","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Evgenios","key":"vlachospau","last":"Vlachos","locid":"498d5f74-7d1b-4ec7-86fa-42df0ee32146","name":"Vlachos, Evgenios","orcid":"0000-0001-8235-0423","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Asger Væring","key":"larsenpau","last":"Larsen","locid":"fd7856d4-9391-4ae2-9349-f9181309b577","name":"Larsen, Asger Væring","orcid":"0000-0002-9967-2637","rank":6,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-5e643788-0e55-4991-9b7d-1a0a1b8bbfbd"],"src":["SDU University of Southern Denmark"],"title":"Singing the donut blues : Creating a SoMe echo chamber to boost the scores on Altmetric","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-600204","year":"2020","yearsub":"2020"}
{"abstract":"How can we, through the use of digital technologies, create qualitative and sustainable transformations of our architectural heritage? This project of ref- erence spans across the fields of architectural heritage, digital design and fabri- cation, and circular economy. As both an interdisciplinary, research-oriented demonstration project and a built project, it has a built-in outreach through a num- ber of external partners involved. The paper describes the architectural investigations and solutions developed in the intersection between architectural heritage, digital registration processes and parametric construction and fabrication systems. The method presented, es- tablishes a design workflow that relates detailed information of existing condi- tions with production constraints. A key aspect of this novel method is the em- phasis on modular principles, which, together with the integration of digital tech- nologies, allows the construction costs to be minimized. This makes restoration of historic buildings that holds high cultural and architectural value, but low eco- nomic value, a viable alternative to demolition. The paper describes how we, using digital technology, can tailor materials into bespoke building components with a clear notion of materiality in architec- tural transformation projects. The paper addresses the reuse of architectural her- itage through digital technologies and investigates a design pipeline for the man- ufacturing of bespoke building components with the capability to adapt to an ex- isting building fabric.","author_count":4,"contributors":["Buthke, Jan","Larsen, Niels Martin","Ostenfeld Pedersen, Simon","Bundgaard, Charlotte"],"cuid":["S01-000.00-674363"],"event":{"end":"2023-09-25","place":"Berlin, de","start":"2023-09-23","title":"Design modeling symposium Berlin 2019","year":"2023"},"filters":{"added":"2023-08","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["3D scanning","Transformation"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-ART"],"level3":{"ART":["DI-ART-AAA","DI-ART-ALL"]},"level3all":["DI-ART-AAA"]},"review":"pr","rtype":["clu"],"sorti":"adaptive reuse of architectural heritage","src":["arka"],"src-code":["DI-ART-AAA"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-674363","ids":["arka-d9c080a1-16c8-4065-a9f8-afd1002a3b2e"],"keyword":["3d scanning","No","transformation"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-3BC51E2E7839B5C5AB71F52ABA994C75"],"org":[{"affno":"1","key":"aarhus school of architecture","l2":"DI-ART","l2n":"Artistic Higher Education Institutions","l3":"DI-ART-AAA","l3nn":"Aarhus School of Architecture","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Aarhus School of Architecture","namevar":["Aarhus School of Architecture"],"nora_code":"DI-ART-AAA","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jan","key":"buthkepau","last":"Buthke","locid":"1adb9019-e266-4102-ba97-81805412321f","name":"Buthke, Jan","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Niels Martin","key":"larsenpau","last":"Larsen","locid":"ca21b870-556a-4ab4-903d-8e82d9005449","name":"Larsen, Niels Martin","orcid":"0000-0003-1479-4350","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Simon","key":"ostenfeldpedersenpau","last":"Ostenfeld Pedersen","locid":"a1565931-9ae1-4d91-9b93-434c7c435eb3","name":"Ostenfeld Pedersen, Simon","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Charlotte","key":"bundgaardpau","last":"Bundgaard","locid":"ed512640-7a78-4298-bcc6-6fc8782baf9c","name":"Bundgaard, Charlotte","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Artistic Higher Education Institutions","All Danish Affiliations","Artistic Higher Education Institutions","DI-ALL","DI-ART","DI-ART-ALL"],"PST":["Published"]},"sid":["arka-d9c080a1-16c8-4065-a9f8-afd1002a3b2e"],"src":["Aarhus School of Architecture"],"title":"Adaptive Reuse of Architectural Heritage","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-674363","year":"2020","yearsub":"2020"}
{"author_count":2,"contributors":["Johansen, Stine Liv","Larsen, Malene Charlotte"],"cuid":["S01-000.00-787322"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"edu","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"nr","rtype":["clu"],"sorti":"undersøgelser af børn unge og medier","src":["au"],"src-code":["DI-U-AU"],"type":"db","type-grp":["all","pub"]},"id":"S01-000.00-787322","ids":["au-64c68a56-d650-463d-b818-da87ac998497"],"lang":"Danish","level":"Educational","mra":["Humanities"],"noi":["Local-1-1-2B06B0A9412EFF47AD5C9F792A6221A4"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, School of Communication and Culture, School of Communication and Culture - The Centre for Children's Literature and Media"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Stine Liv","key":"johansenpau","last":"Johansen","locid":"c5809e2c-a291-482d-bae2-14307180f9b6","name":"Johansen, Stine Liv","orcid":"0000-0002-2832-4029","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Malene Charlotte","key":"larsenpau","last":"Larsen","name":"Larsen, Malene Charlotte","rank":2,"rolecode":"pau"}],"pub":{"isbn":["9788759333662"],"pages":"101","place":"Frederiksberg","publisher":"Samfundslitteratur","series":"Kort og præcist om medier og kommunikation","status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-64c68a56-d650-463d-b818-da87ac998497"],"src":["AU Aarhus University"],"title":"Und