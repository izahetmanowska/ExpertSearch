charlottesandagerpau","last":"Aggestrup","locid":"948bdebc-5167-418e-b1d7-fa9bb7f7eeee","name":"Aggestrup, Charlotte Sandager","orcid":"0000-0002-2609-5111","rank":4,"rolecode":"pau"},{"affno":"2 4 1","corresponding":null,"first":"Esben Elholm","key":"madsenesbenelholmpau","last":"Madsen","name":"Madsen, Esben Elholm","orcid":"0000-0001-7601-5645","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Mads","key":"madsenmadspau","last":"Madsen","locid":"9140d139-9b0f-4480-bc16-661eb890a8dc","name":"Madsen, Mads","orcid":"0000-0003-2188-0302","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Malte Nejst","key":"larsenmaltenejstpau","last":"Larsen","locid":"3ab5dd9c-52d8-4dfb-adb0-62db96cf76a2","name":"Larsen, Malte Nejst","orcid":"0000-0002-2600-7126","rank":7,"rolecode":"pau"},{"affno":"3 5 6","corresponding":null,"first":"Peter","key":"krustruppeterpau","last":"Krustrup","locid":"466150ff-704b-461f-8004-692635d9c82b","name":"Krustrup, Peter","orcid":"0000-0002-1461-9838","rank":8,"rolecode":"pau"}],"pmid":["34555200"],"pub":{"doi":"10.1111/sms.14057","issn":["09057188","16000838"],"issn_org":["09057188"],"issue":"1","journal":"Scandinavian Journal of Medicine & Science in Sports","pages":"138-151","publisher":"Blackwell Munksgaard","status":"p","title":"Scandinavian Journal of Medicine & Science in Sports","title_org":"Scandinavian Journal of Medicine and Science in Sports","volume":"32"},"review":"Peer Reviewed","scoID":["2-s2.0-85116483226"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","All University Colleges","DI-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","KP","Universities","University Colleges","University of Southern Denmark"],"PST":["Published"]},"sid":["au-e3e1856c-a015-4674-b9d5-878ed12a78eb","kp-49e45cb6-3317-4400-b1f2-df3c5815fc9f","sdu-ed60b07d-bc6d-4ce5-915f-c94aca928777"],"src":["AU Aarhus University","KP University College Copenhagen","SDU University of Southern Denmark"],"title":"The Danish \"11 for Health\" program raises health knowledge, well-being and fitness in ethnic minority 10-to 12-year-olds","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-099.34-029178","year":"2022","yearsub":"2022"}
{"abstract":"Background: Immune checkpoint inhibitors (ICIs) are implemented as standard treatment for patients with advanced non-small cell lung cancer (NSCLC) in first-line and subsequent-line treatment. However, certain subgroups such as patients with older age, poor performance status (PS), and severe comorbidity are underrepresented in the randomized controlled trials (RCTs). This study aimed to assess overall survival (OS), treatment data, and clinical features affecting second- or subsequent-line ICI efficacy in an unselected, Danish, nationwide NSCLC population. Methods: Patients with advanced NSCLC who started nivolumab or pembrolizumab as second-line or subsequent-line treatment between 1 September 2015, and 1 October 2018, were identified from institutional records of all Danish oncology departments. Clinical and treatment data were retrospectively collected. Descriptive statistics and survival analyses were performed. Results: Data were available for 840 patients; 49% females. The median age was 68 years (19% were ≥75 years), 19% had PS ≥2, and 36% had moderate to severe comorbidity. The median OS (mOS) was 12.2 months; 15.1 months and 10.0 months in females and males, respectively. The median time-to-treatment discontinuation (mTTD) and median progression-free survival (mPFS) was 3.2 and 5.2 months, respectively. Patients with PS ≥2 had a mOS of 4.5 months, mTTD of 1.1 month, and mPFS of 2.0 months. In multivariable Cox regression analysis, male sex (HR = 1.35, 95% CI 1.11–1.62), PS >0 (PS 1, HR = 1.88, 95% CI 1.52–2.33; PS ≥2, HR = 4.15, 95% CI 3.13–5.5), liver metastases (HR = 1.72, 95% CI 1.34–2.22), and bone metastases (HR = 1.27, 95% CI 1.03–1.58) were significant poor prognostic OS factors. Conclusions: Danish real-world patients with advanced NSCLC treated with second- or subsequent-line ICI had an OS comparable to results from RCTs. Women, frail and older patients constituted a higher proportion than in previous RCTs. Clinical features associated with poor OS were male sex, PS ≥1 (in particular PS ≥2), bone-, and liver metastases.","author_count":27,"contributors":["Mouritzen, Mette Thune","Junker, Karen F.","Carus, Andreas","Ladekarl, Morten","Meldgaard, Peter","Nielsen, Anders W. M.","Livbjerg, Anna","Larsen, Jacob W.","Skuladottir, Halla","Kristiansen, Charlotte","Wedervang, Kim","Schytte, Tine","Hansen, Karin H.","Østby, Anne-Cathrine","Frank, Malene S.","Lauritsen, Jakob","Sørensen, Jens B.","Langer, Seppo W.","Persson, Gitte F.","Andersen, Jon L.","Homann, Pernille H.","Kristensen, Emilie B.","Drivsholm, Lars B.","Bøgsted, Martin","Christensen, Heidi Søgaard","Pøhl, Mette","Bjørnhart, Birgitte"],"cuid":["S04-091.21-005059"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"corresponding_author":["Mouritzen, Mette T.","Mouritzen, Mette Thune"],"keyword":["Aged","Cancer immunotherapy","Carcinoma Non Small Cell Lung pathology","Clinical prognostic factors","Denmark epidemiology","Female","Humans","Immune Checkpoint Inhibitors therapeutic use","Immune checkpoint inhibitors","Lung Neoplasms pathology","Male","Nivolumab therapeutic use","Non small cell lung cancer","Real world evidence","Retrospective Studies"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA"],"OT":["Unspecified organisation"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"clinical features affecting efficacy of immune checkpoint inhibitors in pretreated patients with advanced nsclc a danish nationwide real world study","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all",