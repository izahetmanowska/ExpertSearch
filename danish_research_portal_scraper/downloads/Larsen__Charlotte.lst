olume":"56"},"review":"Peer Reviewed","scoID":["2-s2.0-84926511409"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-17e577cd-a57b-47cb-b4e4-f2772e682f7f","ku-c9ea88c4-7579-4166-a846-444626594cc7","sdu-6541fbad-3378-4a23-a726-8807939ecbe8"],"src":["AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Psychotic experiences co-occur with sleep problems, negative affect and mental disorders in preadolescence","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-094.74-014309","year":"2015","yearsub":"2015"}
{"abstract":"Sclerotia are known to be fungal survival structures, and induction of sclerotia may prompt production of otherwise undiscovered metabolites. Aspergillus sclerotiicarbonarius (IBT 28362) was investigated under sclerotium producing conditions, which revealed a highly altered metabolic profile. Four new compounds were isolated from cultivation under sclerotium formation conditions and their structures elucidated using different analytical techniques (HRMS, UV, 1D and 2D NMR). This included sclerolizine, an alkylated and oxidized pyrrolizine, the new emindole analog emindole SC and two new carbonarins; carbonarins I and J. We have identified the three latter as true sclerotial metabolites. All metabolites were tested for antifungal and antiinsectan activity, and sclerolizine and carbonarin I displayed antifungal activity against Candida albicans, while all four showed antiinsectan activity. These results demonstrate induction of sclerotia as an alternative way of triggering otherwise silent biosynthetic pathways in filamentous fungi for the discovery of novel bioactive secondary metabolites.","author_count":6,"contributors":["Petersen, Lene Maj","Frisvad, Jens Christian","Knudsen, Peter Boldsen","Rohlfs, Marko","Gotfredsen, Charlotte Held","Larsen, Thomas Ostenfeld"],"cuid":["S01-000.00-316358"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","University of Göttingen"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"induced sclerotium formation exposes new bioactive metabolites from i aspergillus sclerotiicarbonarius i","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84945117297","version":"Other Version"},"id":"S01-000.00-316358","identifier":[{"id":"25944531","type":"pmid"},{"id":"84945117297","type":"scopus"}],"ids":["dtu-27a2fa8b-3cd5-4e35-a680-32bc44787525"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-6D746B81C5AA4AA96E8ED6E9B54D641A"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Systems Biology"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"de","key":"university of göttingen","loc":["Germany","Europe, EU","OECD"],"name":"University of Göttingen","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Lene Maj","key":"petersenpau","last":"Petersen","locid":"7a1c5a02-7eb8-40e3-a1ec-621fb3c37652","name":"Petersen, Lene Maj","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens Christian","key":"frisvadpau","last":"Frisvad","locid":"b2d4f948-9e1c-4f8c-9c02-05588bfa21b9","name":"Frisvad, Jens Christian","orcid":"0000-0002-0573-4340","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter Boldsen","key":"knudsenpau","last":"Knudsen","locid":"991df7f2-a085-49ce-a926-da127ba3b28b","name":"Knudsen, Peter Boldsen","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Marko","key":"rohlfspau","last":"Rohlfs","name":"Rohlfs, Marko","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Charlotte Held","key":"gotfredsenpau","last":"Gotfredsen","locid":"1cf4df84-2d0e-4693-bf47-e9932e3bf0e3","name":"Gotfredsen, Charlotte Held","orcid":"0000-0002-7386-119X","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thomas Ostenfeld","key":"larsenpau","last":"Larsen","locid":"bd958d52-71b6-4720-b30a-cc9305633b43","name":"Larsen, Thomas Ostenfeld","orcid":"0000-0002-3362-5707","rank":6,"rolecode":"pau"}],"pmid":["25944531"],"pub":{"doi":"10.1038/ja.2015.40","issn":["00218820","03682781"],"issn_org":["00218820"],"issue":"10","journal":"The Journal of Antibiotics","pages":"603-608","publisher":"Springer Nature","status":"p","title":"The Journal of Antibiotics","volume":"68"},"review":"Peer Reviewed","scoID":["2-s2.0-84945117297"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-27a2fa8b-3cd5-4e35-a680-32bc44787525"],"src":["DTU Technical University of Denmark"],"title":"Induced sclerotium formation exposes new bioactive metabolites from <i>Aspergillus sclerotiicarbonarius</i>","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-316358","year":"2015","yearsub":"2015"}
{"abstract":"Et forskerteam fra DTU har færdiggjort rapport om overvågning af influenza A i 2014. Målet med overvågningen var at identificere hvilke influenzavirus subtyper og stammer, der cirkulerer blandt danske svin samt at kortlægge sygdomsårsager med henblik på at sikre det strategiske mål – at mindske antibiotikaforbruget i danske svinebesætninger.","author_count":3,"contributors":["Krog, Jesper Schak","Hjulsager, Charlotte Kristiane","Larsen, Lars Erik"],"cuid":["S01-000.00-328170"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"nr","rtype":["clu"],"sorti":"overvågning af influenza afslører flere subtyper","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-328170","ids":["dtu-4f51afd6-e402-4e66-8281-230b4e230f45"],"lang":"Danish","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-4D94DBFF2662ADFDCEDFC2A63A411247"],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Veterinary Institute"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Schak","key":"krogpau","last":"Krog","locid":"1e238a71-3075-4303-91fe-3cedb620123d","name":"Krog, Jesper Schak","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Charlotte Kristiane","key":"hjulsagerpau","last":"Hjulsager","locid":"6c1511ef-8211-4653-8c81-cd55b7f63f64","name":"Hjulsager, Charlotte Kristiane","orcid":"0000-0001-7557-8876","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars Erik","key":"larsenpau","last":"Larsen","locid":"09c2a33d-b353-44de-a850-f3c7dec879cb","name":"Larsen, Lars Erik","orcid":"0000-0003-0730-5555","rank":3,"rolecode":"pau"}],"pub":{"issn":["1903153X"],"issue":"6","journal":"Dyrlægen","pages":"34-38","publisher":"JJ Kommunikation ApS","status":"p","title":"Dyrlægen"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-4f51afd6-e402-4e66-8281-230b4e230f45"],"src":["DTU Technical University of Denmark"],"title":"Overvågning af influenza afslører flere subtyper","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-328170","year":"2015","yearsub":"2015"}
{"abstract":"In tramp shipping, ships operate much like taxies, following the available demand. This contrasts liner shipping where vessels operate more like busses on a fixed route network according to a published timetable. Tramp operators can enter into long term contracts and thereby determine some of their demand in advance. However, the detailed requirements of these contract cargoes can be subject to ongoing changes, e.g. the destination port can be altered. For tramp operators, a main concern is therefore the efficient and continuous planning of routes and schedules for the individual ships. Due to mergers, pooling, and collaboration efforts between shipping companies, the fleet sizes have grown to a point where manual planning is no longer adequate in a market with tough competition and low freight rates. The aim of this paper is to provide a comprehensive introduction to tramp ship routing and scheduling. This includes a review on existing literature, modelling approaches, solution methods as well as an analysis of the current status and future opportunities of research within tramp ship routing and scheduling. We argue that rather than developing new solution methods for the basic routing and scheduling problem, focus should now be on extending this basic problem to include additional real-world complexities and develop suitable solution methods for those extensions. Such extensions will enable more tramp operators to benefit from the solution methods while simultaneously creating new opportunities for operators already benefitting from existing methods.","author_count":3,"contributors":["Vilhelmsen, Charlotte","Larsen, Jesper","Lusby, Richard Martin"],"cuid":["S01-000.00-329316"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"nr","rtype":["clu"],"sorti":"tramp ship routing and scheduling models methods and opportunities","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/118304047/Tramp_Ship_Routing_and_Scheduling.pdf","version":"Authors Final Version"},"id":"S01-000.00-329316","ids":["dtu-53444242-b7d4-4c42-9f9d-be6a92881333"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-26D060C0630C55E057284A7EF6F241AE"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/118304047/Tramp_Ship_Routing_and_Scheduling.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Management Engineering","Technical University of Denmark, Department of Management Engineering, Management Science"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Charlotte","key":"vilhelmsenpau","last":"Vilhelmsen","locid":"6ceebc69-a38c-4b56-9070-23135aa491c6","name":"Vilhelmsen, Charlotte","orcid":"0000-0001-8260-6791","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper","key":"larsenpau","last":"Larsen","locid":"d1af4d26-e92b-414c-b534-25b2b607a0d9","name":"Larsen, Jesper","orcid":"0000-0002-9119-3586","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Richard Martin","key":"lusbypau","last":"Lusby","locid":"51599544-7991-404d-b9a7-ec2f5ad4824b","name":"Lusby, Richard Martin","orcid":"0000-0002-8652-6219","rank":3,"rolecode":"pau"}],"pub":{"pages":"33","publisher":"DTU Management Engineering","status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-53444242-b7d4-4c42-9f9d-be6a92881333"],"src":["DTU Technical University of Denmark"],"title":"Tramp Ship Routing and Scheduling - Models, Methods and Opportunities","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-329316","year":"2015","yearsub":"2015"}
{"author_count":6,"contributors":["Chriél, Mariann","Larsen, Gitte","Holm, Elisabeth","Hjulsager, Charlotte Kristiane","Strandbygaard, Bertel","Hansen, Mette Sif"],"cuid":["S01-000.00-351458"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"com","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"nr","rtype":["clu"],"sorti":"diagnostiske undersøgelser af pelsdyr ved dtu veterinærinstituttet november 000000002014 oktober 000000002015","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dr","type-grp":["all","pub"]},"id":"S01-000.00-351458","ids":["dtu-9d416e3c-e93d-4a47-8bbd-e51bbb798d2a"],"lang":"English","level":"Commissioned","mra":["Science/Technology"],"noi":["Local-1-1-1D67F2BA5606CDD59A063F7502AEE8ED"],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Veterinary Institute","Technical University of Denmark, National Veterinary Institute, Division for Diagnostics & Scientific Advice, Diagnostic & Development"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Mariann","key":"chriélpau","last":"Chriél","locid":"1a5d6261-6bd2-4940-baab-5d5fcc3c0f7c","name":"Chriél, Mariann","orcid":"0000-0001-5306-4495","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Gitte","key":"larsenpau","last":"Larsen","locid":"ea426e5f-93bd-48f5-a3c8-e5f8004413a7","name":"Larsen, Gitte","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Elisabeth","key":"holmpau","last":"Holm","locid":"07c945b3-4fe0-496a-9734-095800683729","name":"Holm, Elisabeth","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Charlotte Kristiane","key":"hjulsagerpau","last":"Hjulsager","locid":"6c1511ef-8211-4653-8c81-cd55b7f63f64","name":"Hjulsager, Charlotte Kristiane","orcid":"0000-0001-7557-8876","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Bertel","key":"strandbygaardpau","last":"Strandbygaard","locid":"138cf29f-26c3-421a-9638-770254d90f6c","name":"Strandbygaard, Bertel","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mette Sif","key":"hansenpau","last":"Hansen","locid":"5d04b165-7fc1-46cf-88f7-35be695b954c","name":"Hansen, Mette Sif","orcid":"0000-0002-8132-8475","rank":6,"rolecode":"pau"}],"pub":{"pages":"26","place":"Frederiksberg C","publisher":"DTU Veterinærinstituttet","status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-9d416e3c-e93d-4a47-8bbd-e51bbb798d2a"],"src":["DTU Technical University of Denmark"],"title":"Diagnostiske undersøgelser af pelsdyr ved DTU Veterinærinstituttet - november 2014 - oktober 2015","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-351458","year":"2015","yearsub":"2015"}
{"abstract":"The emergence in humans of the A(H1N1)pdm09 influenza virus, a complex reassortant virus of swine origin, highlighted the importance of worldwide influenza virus surveillance in swine. To date, large-scale surveillance studies have been reported for southern China and North America, but such data have not yet been described for Europe. We report the first large-scale genomic characterization of 290 swine influenza viruses collected from 14 European countries between 2009 and 2013. A total of 23 distinct genotypes were identified, with the 7 most common comprising 82% of the incidence. Contrasting epidemiological dynamics were observed for two of these genotypes, H1huN2 and H3N2, with the former showing multiple long-lived geographically isolated lineages, while the latter had short-lived geographically diffuse lineages. At least 32 human-swine transmission events have resulted in A(H1N1)pdm09 becoming established at a mean frequency of 8% across European countries. Notably, swine in the United Kingdom have largely had a replacement of the endemic Eurasian avian virus-like (“avian-like”) genotypes with A(H1N1)pdm09-derived genotypes. The high number of reassortant genotypes observed in European swine, combined with the identification of a genotype similar to the A(H3N2)v genotype in North America, underlines the importance of continued swine surveillance in Europe for the purposes of maintaining public health. This report further reveals that the emergences and drivers of virus evolution in swine differ at the global level. IMPORTANCE The influenza A(H1N1)pdm09 virus contains a reassortant genome with segments derived from separate virus lineages that evolved in different regions of the world. In particular, its neuraminidase and matrix segments were derived from the Eurasian avian virus-like (“avian-like”) lineage that emerged in European swine in the 1970s. However, while large-scale genomic characterization of swine has been reported for southern China and North America, no equivalent study has yet been reported for Europe. Surveillance of swine herds across Europe between 2009 and 2013 revealed that the A(H1N1)pdm09 virus is established in European swine, increasing the number of circulating lineages in the region and increasing the possibility of the emergence of a genotype with human pandemic potential. It also has implications for veterinary health, making prevention through vaccination more challenging. The identification of a genotype similar to the A(H3N2)v genotype, causing zoonoses at North American agricultural fairs, underlines the importance of continued genomic characterization in European swine.","author_count":30,"contributors":["J. Watson, Simon","Langat, Pinky","M. Reid, Scott","Tsan-Yuk Lam, Tommy","Cotten, Matthew","Kelly, Michael","Van Reeth, Kristien","Qiu, Yu","Simon, Gaëlle","Bonin, Emilie","Foni, Emanuela","Chiapponi, Chiara","Larsen, Lars Erik","Hjulsager, Charlotte Kristiane","Markowska-Daniel, Iwona","Urbaniak, Kinga","Dürrwald, Ralf","Schlegel, Michael","Huovilainen, Anita","Davidson, Irit","Dán, Ádám","Loeffen, Willie","Edwards, Stephanie","Bublot, Michel","Vila, Thais","Maldonado, Jaime","Valls, Laura","H. Brown, Ian","Pybus, Oliver G","Kellam, Paul"],"cuid":["S01-000.00-357162"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Asia, Middle East","Europe, EU","Europe, Non-EU","Nordic","OECD"],"country":["Belgium","Finland","France","Germany","Hungary","Israel","Italy","Netherlands","Poland","Spain","United Kingdom"],"glorg":["All Global Affiliations","Animal & Plant Health Agency","Central Veterinary Institute","Finnish Food Safety Authority","Ghent University","Hipra","IDT Biologika GmbH","Istituto Zooprofilattico Sperimentale della Lombardia e dell'Emilia","Kimron Veterinary Institute","Merial S.A.S.","National Food Chain Safety Office","Panstwowy Instytut Weterynaryjny","Ploufragan-Pluzané Laboratory","University of Oxford","Wellcome Sanger Institute"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"molecular epidemiology and evolution of influenza viruses circulating within european swine between 000000002009 and 000000002013","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/126598198/J._Virol._2015_Watson_9920_31.pdf","version":"Published Version"},"id":"S01-000.00-357162","identifier":[{"id":"PMC4577897","type":"pmcid"},{"id":"84940991966","type":"scopus"},{"id":"26202246","type":"pmid"}],"ids":["dtu-b00d52fa-0f2f-4092-9f9d-a03c2d3693da"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-CED3DEB777363A2D031BF4BF5E4743C1"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1128/JVI.00840-15","version":"Other Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/126598198/J._Virol._2015_Watson_9920_31.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","country":"gb","key":"wellcome sanger institute","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Wellcome Sanger Institute","used":1},{"affno":"2","country":"gb","key":"animal plant health agency","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Animal & Plant Health Agency","used":1},{"affno":"3","country":"gb","key":"university of oxford","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Oxford","used":1},{"affno":"4","country":"be","key":"ghent university","loc":["Belgium","Europe, EU","OECD"],"name":"Ghent University","used":1},{"affno":"5","country":"fr","key":"ploufragan pluzané laboratory","loc":["France","Europe, EU","OE