rope, EU","Nordic","OECD"],"name":"Linköping University","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Joachim","key":"audetpau","last":"Audet","locid":"51de9f19-0692-434b-b884-12147bf58637","name":"Audet, Joachim","orcid":"0000-0001-5839-8793","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Carl Christian","key":"hoffmannpau","last":"Hoffmann","locid":"353a0760-7b7a-4348-9f47-7df140234554","name":"Hoffmann, Carl Christian","orcid":"0000-0002-1268-9162","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Peter Mejlhede","key":"andersenpau","last":"Andersen","locid":"b701e373-3720-491d-8d91-4a3089836b0b","name":"Andersen, Peter Mejlhede","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Annette","key":"baattruppedersenpau","last":"Baattrup-Pedersen","locid":"e4f5886d-70a8-4174-a224-b21d0dfc8689","name":"Baattrup-Pedersen, Annette","orcid":"0000-0002-3118-344X","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jan R.","key":"johansenpau","last":"Johansen","name":"Johansen, Jan R.","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren Erik","key":"larsenpau","last":"Larsen","locid":"fc89ca38-79d9-4781-a6b1-8394e722b334","name":"Larsen, Søren Erik","orcid":"0000-0001-8428-2065","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Linus","key":"lindpau","last":"Lind","name":"Lind, Linus","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars","key":"elsgaardpau","last":"Elsgaard","locid":"61694e4f-57ee-44c7-8821-c3d2590ff4e0","name":"Elsgaard, Lars","orcid":"0000-0003-0058-7609","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Charlotte","key":"kjærgaardpau","last":"Kjærgaard","locid":"b3be00f6-c690-4933-946a-9ab606926cdd","name":"Kjærgaard, Charlotte","rank":9,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ka