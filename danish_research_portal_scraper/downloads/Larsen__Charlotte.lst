,"used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Pia","key":"rythansenpau","last":"Ryt-Hansen","locid":"14d7fe91-822b-4f95-a07c-9479df41d8c5","name":"Ryt-Hansen, Pia","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Emma","key":"hagbergpau","last":"Hagberg","name":"Hagberg, Emma","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mariann","key":"chriélpau","last":"Chriél","locid":"1a5d6261-6bd2-4940-baab-5d5fcc3c0f7c","name":"Chriél, Mariann","orcid":"0000-0001-5306-4495","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Tina","key":"struvepau","last":"Struve","name":"Struve, Tina","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anders Gorm","key":"pedersenpau","last":"Pedersen","locid":"bb3513aa-fb20-46ef-ba14-9c150c929cf1","name":"Pedersen, Anders Gorm","orcid":"0000-0001-9650-8965","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars Erik","key":"larsenpau","last":"Larsen","locid":"09c2a33d-b353-44de-a850-f3c7dec879cb","name":"Larsen, Lars Erik","orcid":"0000-0003-0730-5555","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Charlotte Kristiane","key":"hjulsagerpau","last":"Hjulsager","locid":"6c1511ef-8211-4653-8c81-cd55b7f63f64","name":"Hjulsager, Charlotte Kristiane","orcid":"0000-0001-7557-8876","rank":7,"rolecode":"pau"}],"pub":{"pages":"169-172","place":"Aarhus N","publisher":"Kopenhagen Fur","status":"p","title":"Faglig årsberetning 2016 : Kopenhagen Fur"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Other Companies","Private Research","Technical University of Denmark","Universities","kopenhagen fur"],"PST":["Published"]},"sid":["dtu-52753d87-6c2a-48c2-9f6c-ff17176341dd"],"src":["DTU Technical University of Denmark"],"title":"Global gruppering af plasmacytosevirus isoleret fra mink (Neovison vison)","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-329072","year":"2017","yearsub":"2017"}
{"abstract":"Treatment of sludge in sludge treatment reed bed systems includes dewatering and mineralization. The mineralization process, which is driven by microorganisms, produces different gas species as by-products. The pore space composition of the gas species provides useful information on the biological processes occurring in the sludge residue. In this study, we measured the change in composition of gas species in the pore space at different depth levels in vertical sludge residue profiles during a resting period of 32 days. The gas composition of the pore space in the sludge residue changed during the resting period. As the resting period proceeded, atmospheric air re-entered the pore space at all depth levels. The methane (CH4) concentration was at its highest during the first part of the resting period, and then declined as the sludge residue became more dewatered and thereby aerated. In the pore space, the concentration of CH4 often exceeded the concentration of carbon dioxide (CO2). However, the total emission of CO2 from the surface of the sludge residue exceeded the total emission of CH4, suggesting that CO2 was mainly produced in the layer of newly applied sludge and/or that CO2 was emitted from the sludge residue more readily compared to CH4.","author_count":3,"contributors":["Larsen, Julie Dam","Nielsen, Steen M","Scheutz, Charlotte"],"cuid":["S01-000.00-332062"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Carbon dioxide","Methane","Nitrous oxide","Oxygen","Sewage sludge"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-WSP"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-PR-WSP","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"gas composition of sludge residue profiles in a sludge treatment reed bed between loadings","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85034624612","version":"Other Version"},"id":"S01-000.00-332062","identifier":[{"id":"85034624612","type":"scopus"},{"id":"29144288","type":"pmid"},{"id":"wst_2017_271","type":"pmcid"}],"ids":["dtu-5c72c0c2-13e8-4afa-8a3a-015c17680871"],"keyword":["carbon dioxide","methane","nitrous oxide","oxygen","sewage sludge","static surface flux chambers"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-577FE76E47B3F5603C0C56D15D96F6D4"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Environmental Engineering","Technical University of Denmark, Department of Environmental Engineering, Residual Resource Engineering"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"wsp danmark","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-WSP","l3nl":"WSP Danmark A/S","l3nn":"WSP Danmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"WSP Danmark","namevar":["Orbicon"],"nora_code":"DI-PR-WSP","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Julie Dam","key":"larsenpau","last":"Larsen","locid":"96983a7c-0a55-45a8-a10e-759b599e33a3","name":"Larsen, Julie Dam","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Steen M","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Steen M","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Charlotte","key":"scheutzpau","last":"Scheutz","locid":"48fe2850-fdc6-4282-9b97-ac5773419e5c","name":"Scheutz, Charlotte","orcid":"0000-0003-2218-5934","rank":3,"rolecode":"pau"}],"pmid":["29144288"],"pub":{"doi":"10.2166/wst.2017.271","issn":["02731223","19969732"],"issn_org":["02731223"],"issue":"9","journal":"Water Science and Technology","pages":"2304-2312","publisher":"IWA Publishing","status":"p","title":"Water Science and Technology","volume":"76"},"review":"Peer Reviewed","scoID":["2-s2.0-85034624612"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Private Research","Technical University of Denmark","Universities","WSP Danmark A/S"],"PST":["Published"]},"sid":["dtu-5c72c0c2-13e8-4afa-8a3a-015c17680871"],"src":["DTU Technical University of Denmark"],"title":"Gas composition of sludge residue profiles in a sludge treatment reed bed between loadings","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-332062","year":"2017","yearsub":"2017"}
{"abstract":"Aleutian mink disease has major economic consequences on the mink farming industry worldwide, as it causes a disease that affects both the fur quality and the health and welfare of the mink. The virus causing this disease is a single-stranded DNA virus of the genus Amdoparvovirus belonging to the family of Parvoviridae. In Denmark, infection with AMDV has largely been restricted to a region in the northern part of the country since 2001, affecting only 5% of the total Danish mink farms. However, in 2015 outbreaks of AMDV were diagnosed in all parts of the country. Initial analyses revealed that the out breaks were caused by two different strains of AMDV that were significant different from the circulating Danish strains. To track the source of these outbreaks, a major investigation of global AMDV strains was initiated. Samples from 13 different countries were collected and partial NS1 gene was sequenced and subjected to phylogenetic analyses. The analyses revealed that AMDV exhibited substantial genetic diversity. No clear country wise clustering was evident, but exchange of viruses between countries was revealed. One of the Danish outbreaks was caused by a strain of AMDV that closely resembled a strain originating from Sweden. In contrast, we did not identify any potential source for the other and more widespread outbreak strain. To the authors knowledge this is the first major global phylogenetic study of contemporary AMDV partial NS1 sequences. The study proved that partial NS1 sequencing can be used to distinguish virus strains belonging to major clusters. The partial NS1 sequencing can therefore be a helpful tool in combination with epidemiological data, in relation to outbreak tracking. However detailed information on farm to farm transmission requires full genome sequencing.","author_count":7,"contributors":["Ryt-Hansen, Pia","Hagberg, E. E.","Chriél, Mariann","Struve, T.","Pedersen, A G","Larsen, Lars Erik","Hjulsager, Charlotte Kristiane"],"cuid":["S01-000.00-337140"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Aleutian mink disease virus","Molecular characterization","NS1","Parvovirus","Phylogenetics"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-PR-OTH","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"global phylogenetic analysis of contemporary aleutian mink disease viruses amdvs","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1186/s12985-017-0898-y","version":"Published Version"},"id":"S01-000.00-337140","identifier":[{"id":"29166950","type":"pmid"},{"id":"PMC5700682","type":"pmcid"},{"id":"85035059590","type":"scopus"}],"ids":["dtu-6d01d5b6-f965-486a-b029-e9fa5c6f6636"],"keyword":["Aleutian mink disease virus","Bayesian tree","Molecular characterization","NS1","Parvovirus","Phylogenetics"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-FC153BB4437C78F3BE22A423F7F35FE7"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1186/s12985-017-0898-y","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/139933285/s12985_017_0898_y.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Veterinary Institute","Technical University of Denmark, National Veterinary Institute, Division for Diagnostics & Scientific Advice, Virology"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["Kopenhagen Fur"],"nora_code":"DI-PR-OTH","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Pia","key":"rythansenpau","last":"Ryt-Hansen","locid":"14d7fe91-822b-4f95-a07c-9479df41d8c5","name":"Ryt-Hansen, Pia","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"E. E.","key":"hagbergpau","last":"Hagberg","name":"Hagberg, E. E.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mariann","key":"chriélpau","last":"Chriél","locid":"1a5d6261-6bd2-4940-baab-5d5fcc3c0f7c","name":"Chriél, Mariann","orcid":"0000-0001-5306-4495","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"T.","key":"struvepau","last":"Struve","name":"Struve, T.","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"A G","key":"pedersenpau","last":"Pedersen","locid":"0ddac248-98a1-4495-b358-dacdf3802d02","name":"Pedersen, A G","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"L E","key":"larsenpau","last":"Larsen","locid":"09c2a33d-b353-44de-a850-f3c7dec879cb","name":"Larsen, Lars Erik","name_org":"Larsen, L E","orcid":"0000-0003-0730-5555","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Charlotte Kristiane","key":"hjulsagerpau","last":"Hjulsager","locid":"6c1511ef-8211-4653-8c81-cd55b7f63f64","name":"Hjulsager, Charlotte Kristiane","orcid":"0000-0001-7557-8876","rank":7,"rolecode":"pau"}],"pmid":["29166950"],"pub":{"doi":"10.1186/s12985-017-0898-y","issn":["1743422X"],"issue":"1","journal":"Virology Journal","paperid":"231","publisher":"BioMed Central","status":"p","title":"Virology Journal","volume":"14"},"review":"Peer Reviewed","scoID":["2-s2.0-85035059590"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Other Companies","Private Research","Technical University of Denmark","Universities","kopenhagen fur"],"PST":["Published"]},"sid":["dtu-6d01d5b6-f965-486a-b029-e9fa5c6f6636"],"src":["DTU Technical University of Denmark"],"title":"Global phylogenetic analysis of contemporary aleutian mink disease viruses (AMDVs)","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-337140","year":"2017","yearsub":"2017"}
{"abstract":"Aleutian Mink Disease (AMD) is an infectious disease of mink (Neovison vison) and globally a major cause of economic losses in mink farming. The disease is caused by Aleutian Mink Disease Virus (AMDV) that belongs to the genus Amdoparvovirus within the Parvoviridae family. Several strains have been described with varying virulence and the severity of infection also depends on the host's genotype and immune status. Clinical signs include respiratory distress in kits and unthriftiness and low quality of the pelts. The infection can also be subclinical. Systematic control of AMDV in Danish mink farms was voluntarily initiated in 1976. Over recent decades the disease was mainly restricted to the very northern part of the country (Northern Jutland), with only sporadic outbreaks outside this region. Most of the viruses from this region have remained very closely related at the nucleotide level for decades. However, in 2015, several outbreaks of AMDV occurred at mink farms throughout Denmark, and the sources of these outbreaks were not known. Partial NS1 gene sequencing, phylogenetic analyses data were utilized along with epidemiological to determine the origin of the outbreaks. The phylogenetic analyses of partial NS1 gene sequences revealed that the outbreaks were caused by two different clusters of viruses that were clearly different from the strains found in Northern Jutland. These clusters had restricted geographical distribution, and the variation within the clusters was remarkably low. The outbreaks on Zealand were epidemiologically linked and a close sequence match was found to two virus sequences from Sweden. The other cluster of outbreaks restricted to Jutland and Funen were linked to three feed producers (FP) but secondary transmissions between farms in the same geographical area could not be excluded. This study confirmed that partial NS1 sequencing can be used in outbreak tracking to determine major viral clusters of AMDV. Using this method, two new distinct AMDV clusters with low intra-cluster sequence diversity were identified, and epidemiological data helped to reveal possible ways of viral introduction into the affected herds.","author_count":7,"contributors":["Ryt-Hansen, Pia","Hjulsager, Charlotte Kristiane","Hagberg, E. E.","Chriél, Mariann","Struve, T.","Pedersen, Anders Gorm","Larsen, Lars Erik"],"cuid":["S01-000.00-364427"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["AMDV","Aleutian mink disease","Denmark","NS1","Phylogenetic analysis","Plasmacytosis"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-PR-OTH","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"outbreak tracking of aleutian mink disease virus amdv using partial ns000000000001 gene sequencing","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/133319511/s12985_017_0786_5.pdf","version":"Published Version"},"id":"S01-000.00-364427","identifier":[{"id":"85021127219","type":"scopus"},{"id":"PMC5480136","type":"pmcid"},{"id":"28637462","type":"pmid"}],"ids":["dtu-c86fa088-3437-4803-a22f-5e60560cb4ab"],"keyword":["Aleutian mink disease","Amdv","Carnivore amdoparvovirus","Denmark","NS1","Phylogenetic analysis","Plasmacytosis"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-36D38E55958A639408CE7A2222FFE077"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/133319511/s12985_017_0786_5.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Veterinary Institute","Technical University of Denmark, National Veterinary Institute, Division for Diagnostics & Scientific Advice, Virology"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["Kopenhagen Fur"],"nora_code":"DI-PR-OTH","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Pia","key":"rythansenpau","last":"Ryt-Hansen","locid":"14d7fe91-822b-4f95-a07c-9479df41d8c5","name":"Ryt-Hansen, Pia","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Charlotte Kristiane","key":"hjulsagerpau","last":"Hjulsager","locid":"6c1511ef-8211-4653-8c81-cd55b7f63f64","name":"Hjulsager, Charlotte Kristiane","orcid":"0000-0001-7557-8876","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"E. E.","key":"hagbergpau","last":"Hagberg","name":"Hagberg, E. E.","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mariann","key":"chriélpau","last":"Chriél","locid":"1a5d6261-6bd2-4940-baab-5d5fcc3c0f7c","name":"Chriél, Mariann","orcid":"0000-0001-5306-4495","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"T.","key":"struvepau","last":"Struve","name":"Struve, T.","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"A G","key":"pedersenpau","last":"Pedersen","locid":"bb3513aa-fb20-46ef-ba14-9c150c929cf1","name":"Pedersen, Anders Gorm","name_org":"Pedersen, A G","orcid":"0000-0001-9650-8965","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"L E","key":"larsenpau","last":"Larsen","locid":"09c2a33d-b353-44de-a850-f3c7dec879cb","name":"Larsen, Lars Erik","name_org":"Larsen, L E","orcid":"0000-0003-0730-5555","rank":7,"rolecode":"pau"}],"pmid":["28637462"],"pub":{"doi":"10.1186/s12985-017-0786-5","issn":["1743422X"],"issue":"119","journal":"Virology Journal","publisher":"BioMed Central","status":"p","title":"Virology Journal","volume":"14"},"review":"Peer Reviewed","scoID":["2-s2.0-85021127219"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Other Companies","Private Research","Technical University of Denmark","Universities","kopenhagen fur"],"PST":["Published"]},"sid":["dtu-c86fa088-3437-4803-a22f-5e60560cb4ab"],"src":["DTU Technical University of Denmark"],"title":"Outbreak tracking of Aleutian mink disease virus (AMDV) using partial NS1 gene sequencing","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-364427","year":"2017","yearsub":"2017"}
{"abstract":"Ionotropic glutamate receptor antagonists are valuable tool compounds for studies of neurological pathways in the central nervous system. On the basis of rational ligand design, a new class of selective antagonists, represented by (2S,4R)-4-(2-carboxy-phenoxy)pyrrolidine-2-carboxylic acid (1b), for cloned homomeric kainic acid receptor subtype 1 (GluK1) was attained (Ki = 4 µM). In a functional assay, 1b displayed full antagonist activity with IC50 = 6 ± 2 µM. A crystal structure was obtained of 1b when bound in the ligand binding domain of GluK1. A domain opening of 13-14° was seen compared to the structure with glutamate, consistent with 1b being an antagonist. A structure-activity relationship study showed that the chemical nature of the tethering atom (C,O, or S) linking the pyrrolidine ring and the phenyl ring plays a key role in the receptor selectivity profile and that substituents on the phenyl ring are well accommodated by the GluK1 receptor.","author_count":14,"contributors":["Krogsgaard-Larsen, Niels","Delgar, Claudia","Koch, Karina","Brown, Patricia M G E","Møller, Charlotte","Han, Liwei","Huynh, Tri Hien Viet","Hansen, Stinne Wessel","Nielsen, Birgitte","Bowie, Derek","Pickering, Darryl S","Kastrup, Jette Sandholm","Frydenvang, Karla","Bunch, Lennart"],"cuid":["S01-000.00-498160"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["Canada"],"glorg":["All Global Affiliations","McGill University"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"design and synthesis of a series of l trans 000000000004 substituted prolines as selective antagonists for the ionotropic glutamate receptors including functional and x ray crystallographic studies of new subtype selective kainic acid receptor subtype 000000000001 gluk000000000001 antagonist 000000000002s 000000000004r 000000000004 000000000002 carboxyphenoxy pyrrolidine 000000000002 carboxylic acid","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-498160","identifier":[{"id":"28005385","type":"pmid"},{"id":"85018482947","type":"scopus"}],"ids":["ku-af5b62bd-b8d8-41fc-be43-9d927e6f2d9b"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-FC3ED88AD123AEBD57956FCDAA27A041"],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","country":"ca","key":"mcgill university","loc":["Canada","America, North","OECD"],"name":"McGill University","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Drug Design and Pharmacology, Medicinal Chemistry Research"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Niels","key":"krogsgaardlarsenpau","last":"Krogsgaard-Larsen","name":"Krogsgaard-Larsen, Niels","rank":1,"rolecode":"pau"},{"affno":"","first":"Claudia","key":"delgarpau","last":"Delgar","name":"Delgar, Claudia","rank":2,"rolecode":"pau"},{"affno":"","first":"Karina","key":"kochpau","last":"Koch","name":"Koch, Karina","rank":3,"rolecode":"pau"},{"affno":"1","first":"Patricia M G E","key":"brownpau","last":"Brown","name":"Brown, Patricia M G E","rank":4,"rolecode":"pau"},{"affno":"","first":"Charlotte","key":"møllerpau","last":"Møller","name":"Møller, Charlotte","rank":5,"rolecode":"pau"},{"affno":"","first":"Liwei","key":"hanpau","last":"Han","locid":"2d050657-1adc-483a-b311-a149f6307e64","name":"Han, Liwei","rank":6,"rolecode":"pau"},{"affno":"2","first":"Tri Hien Viet","key":"huynhpau","last":"Huynh","locid":"7cd278ac-8b12-404e-9181-06f936c48d84","name":"Huynh, Tri Hien Viet","orcid":"0000-0001-5264-4738","rank":7,"rolecode":"pau"},{"affno":"","first":"Stinne Wessel","key":"hansenpau","last":"Hansen","name":"Hansen, Stinne Wessel","rank":8,"rolecode":"pau"},{"affno":"2","first":"Birgitte","key":"nielsenpau","last":"Nielsen","locid":"2185c8a9-13b6-409f-9165-70992d487a6c","name":"Nielsen, Birgitte","rank":9,"rolecode":"pau"},{"affno":"1","first":"Derek","key":"bowiepau","last":"Bowie","name":"Bowie, Derek","rank":10,"rolecode":"pau"},{"affno":"2","first":"Darryl S","key":"pickeringpau","last":"Pickering","locid":"7f3e2ef6-0c80-45fd-932e-92ec257a25d4","name":"Pickering, Darryl S","orcid":"0000-0001-8687-6094","rank":11,"rolecode":"pau"},{"affno":"2","first":"Jette Sandholm Jensen","key":"kastruppau","last":"Kastrup","locid":"22f777f2-479a-407c-bef0-60d68d583a12","name":"Kastrup, Jette Sandholm","name_org":"Kastrup, Jette Sandholm Jensen","orcid":"0000-0003-2654-1510","rank":12,"rolecode":"pau"},{"affno":"2","first":"Karla Andrea","key":"frydenvangpau","last":"Frydenvang","locid":"dcc9f4f8-1800-40ac-a7e9-5d2eda9ce65b","name":"Frydenvang, Karla","name_org":"Frydenvang, Karla Andrea","orcid":"0000-0002-5823-3478","rank":13,"rolecode":"pau"},{"affno":"2","first":"Lennart","key":"bunchpau","last":"Bunch","locid":"1e196e05-1a4e-4da3-a308-786f9cb4e372","name":"Bunch, Lennart","orcid":"0000-0002-0180-4639","rank":14,"rolecode":"pau"}],"pmid":["28005385"],"pub":{"doi":"10.1021/acs.jmedchem.6b01516","issn":["00222623","15204804"],"issn_org":["00222623"],"issue":"1","journal":"Journal of Medicinal Chemistry","pages":"441-457","status":"p","title":"Journal of Medicinal Chemistry","volume":"60"},"review":"Peer Reviewed","scoID":["2-s2.0-85018482947"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-af5b62bd-b8d8-41fc-be43-9d927e6f2d9b"],"src":["KU University of Copenhagen"],"title":"Design and Synthesis of a Series of L-trans-4-Substituted Prolines as Selective Antagonists for the Ionotropic Glutamate Receptors Including Functional and X-ray Crystallographic Studies of New Subtype Selective Kainic Acid Receptor Subtype 1 (GluK1) Antagonist (2S,4R)-4-(2-Carboxyphenoxy)pyrrolidine-2-carboxylic Acid","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-498160","year":"2017","yearsub":"2017"}
{"abstract":"Denne sanitary survey vurderer de potentielle mikrobiologiske forureningskilder, der kan have betydning for muslingeproduktionen i Lillebælt og det Sydfynske Øhav. Lillebælt og det Sydfynske Øhav er underopdelt i 11 produktionsområder, der er vurderet hver for sig. Bakterien E. coli er anvendt som indikator for mikrobiologisk forurening. I en række appendikser er der beskrevet potentielle kilder til mikrobiologisk forurening og muligheden for spredning eller nedbrydning af eventuel forurening ud fra de fysiske forhold i området. Hvert appendiks afsluttes med en kort konklusion. Datagrundlaget for rapporten er offentligt tilgængelige data og omfatter statistiske kilder for husdyr, landbrug, datakilder fra tilgrænsende kommuner samt data fra muslingefiskeriets egenkontrol og myndighedernes verifikation af denne. Det konkluderes i rapporten, at Lillebælt og det Sydfynske Øhav generelt er karakteriseret ved lave forekomster af E. coli med relativt få observationer af E. coli i kritiske koncentrationer, men de fleste produktionsområder har dog for få prøvetagninger til at opnå en permanent klassificering. Rapporten indeholder forslag til en prøvetagningsplan, som tager udgangspunkt i EU’s retningslinjer for monitorering af mikrobiologisk forurening af muslinger m.m.","author_count":7,"contributors":["Larsen, Martin Mørk","Jakobsen, Hans","Göke, Cordula","Hendriksen, Niels Bohse","Koefoed Rømer, Jonas","Mohn, Christian","Schultz, Anna Charlotte"],"cuid":["S02-092.55-016780"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["E coli","Fiskeri","Lillebælt","Mikrobiologisk forurening","Muslinger","Sanitary survey","Toskallede bløddyr","det Sydfynske Øhav"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-DTU"]},"level3all":["DI-U-AU","DI-U-DTU"]},"review":"nr","rtype":["clu"],"sorti":"sanitary survey rapport 000000000004 lillebælt og det sydfynske øhav","src":["au","dtu"],"src-code":["DI-U-AU","DI-U-DTU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/139260199/TR107.pdf","version":"Published Version"},"id":"S02-092.55-016780","ids":["au-386085e4-a8dc-47f0-867a-f661b557a7f9","dtu-2a2cfb2a-42f2-4b14-b041-0076025e9c99"],"keyword":["E. coli","Lillebælt","det Sydfynske Øhav","fiskeri","mikrobiologisk forurening","muslinger","sanitary survey","toskallede bløddyr"],"lang":"Danish","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-2-7A2FDF15E8ACDCD56D451371797F69AE"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/139260199/TR107.pdf","version":"Published Version"},{"access":"oa","type":"rem","url":"http://dce2.au.dk/pub/TR107.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Ecoscience, Department of Ecoscience - Marine Diversity and Experimental Ecology"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Food Institute","Technical University of Denmark, National Food Institute, Research Group for Microbial Food Safety"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Martin Mørk","key":"larsenpau","last":"Larsen","locid":"d24cdbff-3543-4170-b95f-c315ce7477bb","name":"Larsen, Martin Mørk","orcid":"0000-0003-4331-8548","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Hans","key":"jakobsenpau","last":"Jakobsen","locid":"115e2890-be07-49a8-a340-d271dd22ac2b","name":"Jakobsen, Hans","orcid":"0000-0001-9590-2362","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Cordula","key":"gökepau","last":"Göke","locid":"203ca293-fd97-4b16-8eba-24b61d042e20","name":"Göke, Cordula","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Niels Bohse","key":"hendriksenpau","last":"Hendriksen","locid":"50fd9962-24ef-4560-9838-1bb6da39e607","name":"Hendriksen, Niels Bohse","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jonas","key":"koefoedrømerpau","last":"Koefoed Rømer","locid":"02a85068-d9f1-4a76-a2f6-b5751937ada4","name":"Koefoed Rømer, Jonas","orcid":"0000-0002-8895-2529","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Christian","key":"mohnpau","last":"Mohn","locid":"3249f637-7852-40ab-b6ac-1b8670bcd9c9","name":"Mohn, Christian","orcid":"0000-0002-4331-1365","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Anna Charlotte","key":"schultzpau","last":"Schultz","locid":"3a3d5130-acf6-4846-93e3-f3b891d83e60","name":"Schultz, Anna Charlotte","orcid":"0000-0003-1484-9120","rank":7,"rolecode":"pau"}],"pub":{"isbn":["9788771562910"],"issn":["2244999X"],"pages":"156","publisher":"Aarhus Universitet, DCE - Nationalt Center for Miljø og Energi ©","publisher_org":"Aarhus Universitet, DCE – Nationalt Center for Miljø og Energi ©","repno":"Teknisk rapport fra DCE - Nationalt Center for Miljø og Energi. DCE Technical report","series":"Teknisk rapport fra DCE - Nationalt Center for Miljø og Energi. DCE Technical report","status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["au-386085e4-a8dc-47f0-867a-f661b557a7f9","dtu-2a2cfb2a-42f2-4b14-b041-0076025e9c99"],"src":["AU Aarhus University","DTU Technical University of Denmark"],"title":"Sanitary survey rapport 4: Lillebælt og det Sydfynske Øhav","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-092.55-016780","year":"2017","yearsub":"2017"}
{"abstract":"Purpose: Copenhagen Airport Cohort 1990-2012 presents a unique data source for studies of health effects of occupational exposure to air pollution (ultrafine particles) and manual baggage handling among airport employees. We describe the extent of information in the cohort and in the follow-up based on data linkage to the comprehensive Danish nationwide health registers. In the cohort, all information is linked to the personal identification number that also is used in Denmark Statistics demographic and socioeconomic databases and in the nationwide health registers. Participants: The cohort covers 69 175 men in unskilled positions. The exposed cohort includes men in unskilled jobs employed at Copenhagen Airport in the period 1990-2012 either as baggage handlers or in other outdoor work. The reference cohort includes men in unskilled jobs working in the greater Copenhagen area. Findings to date: The cohort includes environmental Global Positioning System (GPS) measurements in Copenhagen Airport, information on job function/task for each calendar year of employment between 1990 and 2012, exposure to air pollution at residence, average weight of baggage lifted per day and lifestyle. By linkage to registers, we retrieved socioeconomic and demographic data and data on healthcare contacts, drug subscriptions, incident cancer and mortality. Future plans: The size of the cohort and the completeness of the register-based follow-up allow a more accurate assessment of the possible health risks of occupational exposure to ultrafine particles and manual baggage handling at airports than in previous studies. We plan to follow the cohort for the incidence of ischaemic heart diseases, cerebrovascular disease, lung and bladder cancer, asthma and chronic obstructive pulmonary disease, and further for associations between heavy manual baggage handling and musculoskeletal disorders. Trial registration: number 2012-41-0199.","author_count":13,"contributors":["Møller, Karina Lauenborg","Brauer, Charlotte","Mikkelsen, Sigurd","Loft, Steffen","Simonsen, Erik B.","Koblauch, Henrik","Bern, Stine Hvid","Alkjær, Tine","Hertel, Ole","Becker, Thomas","Larsen, Karin Helweg","Bonde, Jens Peter","Thygesen, Lau Caspar"],"cuid":["S03-094.64-012835"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"corresponding_author":["Møller, Karina Lauenborg"],"keyword":["Journal Article"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"copenhagen airport cohort air pollution manual baggage handling and health","src":["au","ku","sdu"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/bmjopen-2016-012651","version":"Published Version"},"id":"S03-094.64-012835","identifier":[{"id":"85019127738","type":"scopus"},{"id":"28478397","type":"pmid"},{"id":"PMC5777468","type":"pmcid"}],"ids":["au-0353b1a2-5273-4100-acb0-92d0950292d8","ku-0d10f0bc-992c-4c5d-9b89-ce00e51f488a","sdu-2978758f-5414-40e0-a357-9f9c6fdbdc16"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-6-4F4A249776D1103AA26023AC22A0845A"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/129583371/Copenhagen_Airport_Cohort.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/bmjopen-2016-012651","version":"Published Version"},{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/178479707/Copenhagen_Airport_Cohort.pdf","version":"Published V