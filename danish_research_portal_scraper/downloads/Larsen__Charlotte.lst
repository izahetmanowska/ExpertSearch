Diagnostics & Scientific Advice, Virology"],"nora_code":"DI-U-DTU","used":1},{"affno":"5","country":"dk","key":"seges innovation","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-SEGES","l3nn":"SEGES Innovation","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SEGES Innovation","namevar":["SEGES"],"nora_code":"DI-PR-SEGES","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Gitte Blach","key":"nielsengitteblachpau","last":"Nielsen","name":"Nielsen, Gitte Blach","rank":1,"rolecode":"pau"},{"affno":"2","first":"Jens Peter","key":"nielsenjenspeterpau","last":"Nielsen","locid":"e550301c-f89e-4a8b-bf34-e6fc3b76ff37","name":"Nielsen, Jens Peter","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"John","key":"haugegaardjohnpau","last":"Haugegaard","name":"Haugegaard, John","rank":3,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"first":"Sanne Christiansen","key":"lethsannechristiansenpau","last":"Leth","name":"Leth, Sanne Christiansen","rank":4,"rolecode":"pau"},{"affno":"4 2","corresponding":null,"country":"dk","first":"Lars E","key":"larsenlarserikpau","last":"Larsen","locid":"09c2a33d-b353-44de-a850-f3c7dec879cb","name":"Larsen, Lars Erik","name_org":"Larsen, Lars E","orcid":"0000-0003-0730-5555","rank":5,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Charlotte Sonne","key":"kristensencharlottesonnepau","last":"Kristensen","name":"Kristensen, Charlotte Sonne","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ken Steen","key":"pedersenkensteenpau","last":"Pedersen","name":"Pedersen, Ken Steen","rank":7,"rolecode":"pau"},{"affno":"2","first":"Helle","key":"stegehellepau","last":"Stege","locid":"fcd35d18-c0ae-4328-95f3-f912e648c498","name":"Stege, Helle","orcid":"0000-0003-3033-4207","rank":8,"rolecode":"pau"},{"affno":"5 3","corresponding":null,"first":"Charlotte K.","key":"hjulsagercharlottekpau","last":"Hjulsager","name":"Hjulsager, Charlotte K.","rank":9,"rolecode":"pau"},{"affno":"2","first