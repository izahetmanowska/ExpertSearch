{"abstract":"Satellitbaserede datalag kan gøre det lettere at bestemme den årlige energiproduktion for kommende vindmølleparker på land. Det kan føre til en lavere usikkerhed og besparelser i millionklassen.","author_count":14,"contributors":["Badger, Merete","Dellwik, Ebba","Floors, Rogier Ralph","Hasager, Charlotte Bay","Skriver, Henning","Balling, Jan E.","Thøgersen, Morten","Bondo, Torsten","Grogan, Kenneth"],"cuid":["S01-000.00-380447"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GTS","DI-PR","DI-U"],"level3":{"GTS":["DI-GTS-ALL","DI-GTS-DHYI"],"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-GTS-DHYI","DI-PR-OTH","DI-U-DTU"]},"review":"nr","rtype":["clu"],"sorti":"opførelse af vindmøller på land","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/240661966/Pages_from_Copernicus_DK_300ppi_dansk.pdf","version":"Published Version"},"id":"S01-000.00-380447","ids":["dtu-fd945de9-4773-405d-b6cc-6fe871a741f5"],"lang":"Danish","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-5791BE18DF4CEC097C5E1B61FDB6EC77"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/240661966/Pages_from_Copernicus_DK_300ppi_dansk.pdf","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/240661968/Pages_from_Copernicus_ENG_300ppi.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of D