n":["9780367257224"],"pages":"55-74","publisher":"Routledge","series":"Routledge Advances in Research Methods","status":"p","subtitle":"Dialogue, Reflexivity, Power and Ethics","title":"Action Research in a Relational Perspective"},"review":"Peer Reviewed","scoID":["2-s2.0-85074855950"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-683083a0-8dd2-4fc0-a6ce-d91698c0e94c"],"src":["AAU Aalborg University"],"title":"Social Poetics in Action Research","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-080339","year":"2019","yearsub":"2019"}
{"abstract":"This paper reviews the effects of extended lactation (EXT) as a strategy in dairy cattle on milk production and persistency, reproduction, milk quality, lifetime performance of the cow and finally the economic effects on herd and farm levels as well as the impact on emission of greenhouse gas at product level. Primiparous cows are able to produce equal or more milk per feeding day during EXT compared with a standard 305-d lactation, whereas results for multiparous cows are inconsistent. Cows managed for EXT can achieve a higher lifetime production while delivering milk with unchanged or improved quality properties. Delaying insemination enhances mounting behaviour and allows insemination after the cow's energy balance has become positive. However, in most cases EXT has no effect or a non-significant positive effect on reproduction. The EXT strategy sets off a cascade of effects at herd and farm level. Thus, the EXT strategy leads to fewer calvings and thereby expected fewer diseases, fewer replacement heifers and fewer dry days per cow per year. The optimal lifetime scenario for milk production was modelled to be an EXT of 16 months for first parity cows followed by an EXT of 10 months for later lactations. Modelling studies of herd dynamics indicate a positive effect of EXT on lifetime efficiency (milk per dry matter intake), mainly originating from benefits of EXT on daily milk yield in primiparous cows and the reduced number of replacement heifers. Consequently, EXT also leads to reduced total meat production at herd level. For the farmer, EXT can give the same economic return as a traditional lactation period. At farm level, EXT can contribute to a reduction in the environmental impact of dairy production, mainly as a consequence of the reduced production of beef. A wider dissemination of the EXT concept will be supported by methods to predict which cows may be most suitable for EXT, and clarification of how milking frequency and feeding strategy through the lactation can be organised to support milk yield and an appropriate body condition at the next calving.","author_count":10,"contributors":["Sehested, Jakob","Gaillard, Charlotte","Lehmann, Jesper Overgård","de Moura Maciel, Guilherme","Vestergaard, Mogens","Weisbjerg, Martin Riis","Mogensen, Lisbeth","Larsen, Lotte Bach","Poulsen, Nina Aagaard","Kristensen, Troels"],"cuid":["S01-000.00-212624"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["France"],"glorg":["All Global Affiliations","L'Institut Agro Rennes-Angers"],"keyword":["Milk production","Milk quality","Reproduction"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"review extended lactation in dairy cattle","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85068564264","version":"Other Version"},"id":"S01-000.00-212624","identifier":[{"id":"85068564264","type":"scopus"},{"id":"31280750","type":"pmid"}],"ids":["au-92144fdd-0015-4e9c-892e-113fc4f365fe"],"keyword":["herd scenarios","lifetime scenarios","milk production","milk quality","reproduction"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-99FDF3FE33E1FBB3FDD2C54F23F37150"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Animal and Veterinary Sciences, Department of Animal and Veterinary Sciences - ANIS Nutrition"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"fr","key":"l institut agro rennes angers","loc":["France","Europe, EU","OECD"],"name":"L'Institut Agro Rennes-Angers","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"J.","key":"sehestedpau","last":"Sehested","locid":"877cccec-c84c-4d5c-94a0-26731a4a157a","name":"Sehested, Jakob","name_org":"Sehested, J.","orcid":"0000-0001-6977-6972","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"C.","key":"gaillardpau","last":"Gaillard","locid":"c0138828-4b44-4349-a0a0-084926bae930","name":"Gaillard, Charlotte","name_org":"Gaillard, C.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"J. O.","key":"lehmannpau","last":"Lehmann","locid":"aaa6ebc3-d7cd-4663-8119-7418c5f67672","name":"Lehmann, Jesper Overgård","name_org":"Lehmann, J. O.","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"G. M.","key":"macielpau","last":"Maciel","locid":"6fd7393d-4b94-4735-89d3-9d4d1226c4bd","name":"de Moura Maciel, Guilherme","name_org":"Maciel, G. M.","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"M.","key":"vestergaardpau","last":"Vestergaard","locid":"f886731d-42d7-485e-b44c-f48981a245e7","name":"Vestergaard, Mogens","name_org":"Vestergaard, M.","orcid":"0000-0002-3630-1396","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"M. R.","key":"weisbjergpau","last":"Weisbjerg","locid":"501c877c-de2b-4cd2-9f3c-42e223238a40","name":"Weisbjerg, Martin Riis","name_org":"Weisbjerg, M. R.","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"L.","key":"mogensenpau","last":"Mogensen","locid":"b408a8b2-3faa-4a28-b707-37f5641e7386","name":"Mogensen, Lisbeth","name_org":"Mogensen, L.","orcid":"0000-0001-5924-9749","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"L. B.","key":"larsenpau","last":"Larsen","locid":"204d7240-6828-4ee0-8ef5-77a4a2ac92d4","name":"Larsen, Lotte Bach","name_org":"Larsen, L. B.","orcid":"0000-0001-9674-0107","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"N. A.","key":"poulsenpau","last":"Poulsen","locid":"c6f00bcb-f900-41bb-98ee-c685ea6f8894","name":"Poulsen, Nina Aagaard","name_org":"Poulsen, N. A.","orcid":"0000-0001-9983-9663","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"T.","key":"kristensenpau","last":"Kristensen","locid":"0bcc12e6-8323-497a-bf1d-7e9a8e9e9e84","name":"Kristensen, Troels","name_org":"Kristensen, T.","orcid":"0000-0003-2552-2211","rank":10,"rolecode":"pau"}],"pmid":["31280750"],"pub":{"doi":"10.1017/s1751731119000806","issn":["17517311","1751732X"],"issn_org":["17517311"],"issue":"S1","journal":"Animal","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"p","title":"Animal","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-85068564264"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-92144fdd-0015-4e9c-892e-113fc4f365fe"],"src":["AU Aarhus University"],"title":"Review: extended lactation in dairy cattle","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-212624","year":"2019","yearsub":"2019"}
{"abstract":"Næsesvaberprøver undersøgt ved kvantitativ PCR er værdifulde i forhold til diagnostik af Porcint Cytomegalovirus-infektion på levende smågrise og kan i vid udtrækning erstatte histologi af næseslimhinde fra obducerede dyr. Undersøgelse på levende grise kan erstatte omkostningstung histologi fra næseslimhinden når Cytomegalovirus skal påvises. Metoden er en Real-time kvantitativ PCR (qPCR) på næsesvaberprøver til rutinemæssige diagnostik af PCMV-infektion. Porcint Cytomegalovirus (PCMV) er et virus, der giver infektion i næseslimhinden og bliver ofte betegnet ’snotsyge’. Virusset har været kendt siden midten af forrige århundrede, og den er vidt udbredt, både mellem og inden for besætninger. Der findes ingen behandling eller vaccine mod PCMV, hvorfor den eneste måde at undgå virusset på er ved at undgå smitte, f.eks. ved at sikre overførsel af antistoffer til pattegrisene via råmælk. Den økonomiske betydning af PCMV er usikker, men det vides, at virusset kan forværre symptomerne fra andre sygdomme, f.eks. influenza. PCMV-infektioner er traditionelt set blevet diagnosticeret ved histologi af vævet i næseslimhinden, hvor det er muligt at observere virus inde i næseslimhindens celler hos et smittet dyr. Histologisk diagnostik kan kun udføres på døde dyr, og derfor har PCR på slim fra næsesvaber været brugt som en alternativ metode til at diagnosticere PCMV på levende dyr. Hvorvidt denne metode er sammenlignelig med histologi, har indtil nu været uvist. På baggrund af ovenstående har dette studie undersøgt sammenhængen mellem histologi og qPCR til diagnostik af PCMV på 46 grise mistænkt for PCMV. Det var muligt at konkludere, at der er god sammenhæng mellem de to metoder, hvis der benyttes et cut-off på mellem 105,83 og 107,16 viruskopier pr. ml på den kvantitative PCR.","author_count":7,"contributors":["Tolstrup, Lola","Haugegaard, Svend","Larsen, Lars Erik","Hjulsager, Charlotte Kristiane","Jensen, Tim Kåre","Hansen, Mette Sif","Sonne Kristensen, Charlotte"],"cuid":["S01-000.00-308821"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"com","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"nr","rtype":["clu"],"sorti":"kvantitativ pcr kan være et godt supplement til påvisning af cytomegalovirus infektion meddelelse nr 000000001162","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/167220955/Meddelelse_1162_PCMV_PCR.pdf","version":"Published Version"},"id":"S01-000.00-308821","ids":["dtu-0e0b4119-9fcb-4265-9aa2-1c083f0a98c3"],"lang":"Danish","level":"Commissioned","mra":["Science/Technology"],"noi":["Local-1-1-0EAB7727368F90861AB9C4F25D6EEC6D"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/167220955/Meddelelse_1162_PCMV_PCR.pdf","version":"Published Version"},{"access":"oa","type":"rem","url":"https://svineproduktion.dk/publikationer/kilder/lu_medd/2019/1162?utm_source=Nyhedsbrev&amp;utm_medium=E-mail_Globase&amp;utm_campaign=Nyhedsbrev_uge06_2019","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Veterinary Institute","Technical University of Denmark, National Veterinary Institute, Division for Diagnostics & Scientific Advice, Virology"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Lola","key":"tolstruppau","last":"Tolstrup","name":"Tolstrup, Lola","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Svend","key":"haugegaardpau","last":"Haugegaard","name":"Haugegaard, Svend","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lars Erik","key":"larsenpau","last":"Larsen","locid":"09c2a33d-b353-44de-a850-f3c7dec879cb","name":"Larsen, Lars Erik","orcid":"0000-0003-0730-5555","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Charlotte Kristiane","key":"hjulsagerpau","last":"Hjulsager","locid":"6c1511ef-8211-4653-8c81-cd55b7f63f64","name":"Hjulsager, Charlotte Kristiane","orcid":"0000-0001-7557-8876","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Tim Kåre","key":"jensenpau","last":"Jensen","locid":"2b93571f-6d81-4827-b040-467f1dee1c12","name":"Jensen, Tim Kåre","orcid":"0000-0002-8048-4695","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mette Sif","key":"hansenpau","last":"Hansen","locid":"5d04b165-7fc1-46cf-88f7-35be695b954c","name":"Hansen, Mette Sif","orcid":"0000-0002-8132-8475","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Charlotte","key":"sonnekristensenpau","last":"Sonne Kristensen","name":"Sonne Kristensen, Charlotte","rank":7,"rolecode":"pau"}],"pub":{"pages":"10","publisher":"SEGES Svineproduktion","status":"p"},"review":"No Review","sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-0e0b4119-9fcb-4265-9aa2-1c083f0a98c3"],"src":["DTU Technical University of Denmark"],"title":"Kvantitativ PCR kan være et godt supplement til påvisning af cytomegalovirus-infektion : Meddelelse nr. 1162","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-308821","year":"2019","yearsub":"2019"}
