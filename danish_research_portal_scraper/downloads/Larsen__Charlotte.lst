rff-Larsen","locid":"44148857-c2e8-4814-86a8-28c2b1951a63","name":"Lindorff-Larsen, Karen","name_org":"Lindorff-Larsen, Karen Gilboe","rank":4,"rolecode":"pau"},{"affno":"6 7","corresponding":null,"first":"Bjørn Ulrik","key":"nielsenpau","last":"Nielsen","locid":"02d55a8f-14d0-40e3-9804-a8d73c2c147c","name":"Nielsen, Bjørn Ulrik","rank":5,"rolecode":"pau"},{"affno":"3 2","first":"Lars","key":"kongepau","last":"Konge","locid":"e1c287e3-4cd2-43d2-887d-f2f77fd5daf8","name":"Konge, Lars","orcid":"0000-0002-1258-5822","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Leizl Joy","key":"nayahanganpau","last":"Nayahangan","name":"Nayahangan, Leizl Joy","rank":7,"rolecode":"pau"}],"pmid":["29575657"],"pub":{"doi":"10.1111/aos.13700","issn":["1755375X","17553768"],"issn_org":["1755375X"],"issue":"5","journal":"Acta Ophthalmologica","pages":"519-527","publisher":"John Wiley & Sons Inc.","status":"p","title":"Acta Ophthalmologica","volume":"96"},"review":"Peer Reviewed","scoID":["2-s2.0-85044459242"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-660be0e9-daa3-4133-be16-bd46ea59f097","au-937f7901-7024-49df-8d84-be185bcf4fdc","ku-0be183fa-c9fc-417b-b6ad-e7f45e85e7ff","sdu-c306f24f-f1ac-4532-81a7-69d634370798"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Consensus on procedures to include in a simulation-based curriculum in ophthalmology : a national Delphi study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-100.00-004940","year":"2018","yearsub":"2018"}
{"abstract":"This volume lays out a variety of ways of engaging in research projects focused on exploring the everyday relational practices of organizing and leading is presented. The main focus is through elaborate examples from the author’s own research to further the understanding of how it is possible to carry out relational constructionist research inquiries. The book presents a series of examples ranging from conversations with top-managers, relational action learning processes in management groups, polyphonic inquiries for project management teams, transformative roleplaying in organizations, analyzing organizational dialoguing, and polyphonic future-forming ways of writing up research.　 Relational Research and Organisation Studies does not only present and discuss guidelines for practice at a onto-epistemological level but also presents and discusses concrete cases of research projects building on relational constructionist ideas. Furthermore, excerpts of data are presented and analyzed in order to explain the co-constructed processes of the inquiries more in detail. Relational Research and Organisation Studies invites the reader into the process of planning and carrying out relational constructionist research inquiries. Based on the authors own experiences, it inspires readers to develop their own relational inquiries within the field of organizing.","author_count":4,"contributors":["Madsen, Charlotte Øland","Larsen, Mette Vinther","Hersted, Lone","Rasmussen, Jørgen Gulddahl"],"cuid":["S01-000.00-113329"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Critical management studies","Organizational studies"],"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"relational research and organisation studies","src":["aau"],"src-code":["DI-U-AAU"],"type":"db","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.routledge.com/Relational-Research-and-Organisation-Studies/Madsen-Madsen-Larsen-Larsen-Hersted-Hersted-Rasmussen-Rasmussen/p/book/9780815394150","version":"Other Version"},"id":"S01-000.00-113329","ids":["aau-d9c358c7-ecaa-48ba-8d95-4005f178007d"],"keyword":["Critical Management Studies","Organizational Studies","Research Methods in Management"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-A789003C86CC50DF65188EFA75D90CAA"],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Social Sciences","Aalborg University, The Faculty of Social Sciences, Department of Business and Management","Aalborg University, The Faculty of Social Sciences, Department of Business and Management, Firms, Innovation and Relations Management"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Charlotte Øland","key":"madsenped","last":"Madsen","locid":"22026f1a-b034-403c-90cb-f6bc643a2f49","name":"Madsen, Charlotte Øland","rank":1,"role":"Editor","rolecode":"ped"},{"affno":"1","corresponding":null,"country":"dk","first":"Mette Vinther","key":"larsenped","last":"Larsen","locid":"0de85dc7-1bbc-4121-81f7-05c927f84a51","name":"Larsen, Mette Vinther","orcid":"0000-0002-4966-8090","rank":2,"role":"Editor","rolecode":"ped"},{"affno":"1","corresponding":null,"country":"dk","first":"Lone","key":"herstedped","last":"Hersted","locid":"ec8fb75d-cbe5-44e9-b4a1-e5dcbe418de3","name":"Hersted, Lone","orcid":"0000-0003-0934-1170","rank":3,"role":"Editor","rolecode":"ped"},{"affno":"1","corresponding":null,"first":"Jørgen Gulddahl","key":"rasmussenped","last":"Rasmussen","locid":"1a9b8010-beeb-47cc-8dc4-