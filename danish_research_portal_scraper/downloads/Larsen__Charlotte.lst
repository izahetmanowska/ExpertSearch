{"author_count":1,"contributors":["Larsen, Malene Charlotte"],"cuid":["S01-000.00-122897"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"unges sociale mediekultur","src":["aau"],"src-code":["DI-U-AAU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://www.turbineforlaget.dk/shop/fagboeger/debatboeger/digital-trivsel/","version":"Other Version"},"id":"S01-000.00-122897","ids":["aau-fad1251c-e812-483b-96d6-3bfa1760fc9b"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-9413759C5F979FED464469C5FAD98867"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.turbineforlaget.dk/shop/fagboeger/debatboeger/digital-trivsel/","version":"Other Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Humanities","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Mattering: Centre for Discourse & Practice"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Malene Charlotte","key":"larsenpau","last":"Larsen","locid":"cc0033d3-6794-4e0c-b451-939e05f9a1ee","name":"Larsen, Malene Charlotte","orcid":"0000-0003-4821-5855","rank":1,"rolecode":"pau"}],"pub":{"isbn":["9788771412642"],"pages":"43-55","publisher":"Turbine Forlaget","publisher_org":"Turbine forlaget","status":"p","title":"Digital