arch?modus=sin&s=LOI:S03-092.26-735485","year":"2024","yearsub":"2024"}
{"abstract":"OBJECTIVE: This study examined the effectiveness of a workplace health literacy intervention on individual, interpersonal, and organizational health literacy. METHOD: Using a quasi-experimental stepped wedge cluster design, we evaluated an intervention for 509 nursing home employees with two elements: 1) courses for employees and management on pain prevention, management, and communication and 2) structured dialogues between employees and supervisors, emphasizing pain prevention. RESULTS: One organizational health literacy item improved, with supervisors helping with pain prevention increasing by 0.42 points (95% CI 0.11;0.73). Positive trends were observed in supervisor actions when informed about pain (0.39 points, 95% CI -0.09;0.86), ease of finding workplace pain solutions (0.12 points, 95% CI -0.03;0.79), and employees having pain management information (0.44 points, 95% CI -0.03;0.92). CONCLUSION: The intervention improved one organizational health literacy item, with positive trends in three other items.","author_count":6,"contributors":["Larsen, Anne Konring","Thygesen, Lau Caspar","Stilling, Mia Nyvang","Rasmussen, Charlotte Diana Nørregaard","Osborne, Richard H","Jørgensen, Marie Birk"],"cuid":["S03-097.71-768610"],"filters":{"added":"2025-01","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"continent":["OECD","Oceania"],"corresponding_author":["Nyvang Stilling, Mia"],"country":["Australia"],"glorg":["All Global Affiliations","Swinburne University of Technology"],"keyword":["Adult","Female","Health literacy","Humans","Male","Middle Aged","Nursing Homes","Occupational health","Organization","Pain","Pain Management methods","Worker","Workplace","Workplace intervention"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-BA","DI-GV","DI-OT","DI-U"],"level3":{"BA":["DI-BA-ALL","DI-BA-KEA"],"GV":["DI-GV-ALL","DI-GV-WORK"],"OT":["Hillerød municipality, Hillerød"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-BA-KEA","DI-GV-WORK","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"an occupational health literacy intervention in nursing homes improved organizational health literacy a quasi experimental stepped wedge cluster trial","src":["ku","nfa","sdu"],"src-code":["DI-GV-WORK","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1097/JOM.0000000000003211","version":"Published Version"},"id":"S03-097.71-768610","identifier":[{"id":"39190392","type":"pmid"},{"id":"85202700314","type":"scopus"}],"ids":["ku-05b77d61-14e6-4dfb-bb02-a1710e35be0d","nfa-50854eee-b613-46d7-9ce5-698bc4011c04","sdu-b587f308-0323-4abf-bc08-3d2b3fb6a4ae"],"keyword":["Adult","Female","Health Literacy","Humans","Male","Middle Aged","Nursing Homes","Occupational Health","Pain Management/methods","Workplace","organization","pain","worker","workplace intervention"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-2969D2F5BD8A0062DC432E0920F19970"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/412153861/an_occupational_health_literacy_intervention_in.14.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1097/JOM.0000000000003211","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/277493181/an_occupational_health_literacy_intervention_in.14.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Hillerød municipality, Hillerød"],"nora_code":"DI-OT","used":1},{"affno":"2","key":"sdu university of sout