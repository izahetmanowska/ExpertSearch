ritt","name_org":"Marcher, Ann Britt","orcid":"0000-0002-4799-8870","rank":16,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sönke","key":"detlefsenpau","last":"Detlefsen","locid":"6bbd570e-0f99-4ee0-a239-7433591decbd","name":"Detlefsen, Sönke","orcid":"0000-0002-9466-2333","rank":17,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars","key":"grøntvedpau","last":"Grøntved","locid":"7546e3da-0d6d-4210-a7b9-bb70cbf168e0","name":"Grøntved, Lars","orcid":"0000-0002-6735-8483","rank":18,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Henrik","key":"dimkepau","last":"Dimke","locid":"77b413c1-0598-49ab-b29d-68b9b723c33a","name":"Dimke, Henrik","orcid":"0000-0002-9170-2168","rank":19,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Rebecca","key":"berdeauxpau","last":"Berdeaux","name":"Berdeaux, Rebecca","rank":20,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Thomas Q.","key":"deaguiarvallimpau","last":"de Aguiar Vallim","name":"de Aguiar Vallim, Thomas Q.","rank":21,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Peter","key":"olingapau","last":"Olinga","name":"Olinga, Peter","rank":22,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mette M.","key":"lauridsenpau","last":"Lauridsen","locid":"47ea3fdf-66e2-4eb3-ade8-aaf22d015ee9","name":"Lauridsen, Mette Munk","name_org":"Lauridsen, Mette M.","orcid":"0000-0003-0586-8549","rank":23,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Aleksander","key":"kragpau","last":"Krag","locid":"0064696b-9c65-4990-ab96-3635d5a20e4b","name":"Krag, Aleksander","orcid":"0000-0002-9598-4932","rank":24,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Blagoy","key":"blagoevpau","last":"Blagoev","locid":"0c38f8ce-49bc-47b9-90b6-4eb233ccfc5f","name":"Blagoev, Blagoy","orcid":"0000-0002-3596-0066","rank":25,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kim","key":"ravnskjaerpau","last":"Ravnskjaer","locid":"1842e135-4b37-4106-a274-f936925e391e","name":"Ravnskjaer, Kim","orcid":"0000-0002-5322-3887","rank":26,"rolecode":"pau"}],"pmid":["37972658"],"pub":{"doi":"10.1016/j.jhep.2023.11.001","issn":["01688278","16000641"],"issn_org":["01688278"],"issue":"3","journal":"Journal of Hepatology","pages":"467-481","publisher":"Elsevier","status":"p","title":"Journal of Hepatology","volume":"80"},"review":"Peer Reviewed","scoID":["2-s2.0-85180557573"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-72180e70-06e6-4fde-849d-a4fd0d5dbffe"],"src":["SDU University of Southern Denmark"],"title":"Single cell-resolved study of advanced murine MASH reveals a homeostatic pericyte signaling module","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-723275","year":"2024","yearsub":"2024"}
{"abstract":"Background: Coronary artery calcium (CAC) has prognostic value for major adverse cardiovascular events (MACE) in asymptomatic individuals, whereas its role in symptomatic patients is less clear. Purpose: To assess the prognostic value of CAC scoring for MACE in participants with stable chest pain initially referred for invasive coronary angiography (ICA). Materials and Methods: This prespecified subgroup analysis from the Diagnostic Imaging Strategies for Patients With Stable Chest Pain and Intermediate Risk of Coronary Artery Disease (DISCHARGE) trial, conducted between October 2015 and April 2019 across 26 centers in 16 countries, focused on adult patients with stable chest pain referred for ICA. Participants were randomly assigned to undergo either ICA or coronary CT. CAC scores from noncontrast CT scans were categorized into low, intermediate, and high groups based on scores of 0, 1-399, and 400 or higher, respectively. The end point of the study was the occurrence of MACE (myocardial infarction, stroke, and cardiovascular death) over a median 3.5-year follow-up, analyzed using Cox proportional hazard regression tests. Results: The study involved 1749 participants (mean age, 60 years ± 10 [SD]; 992 female). The prevalence of obstructive coronary artery disease (CAD) at CT angiography rose from 4.1% (95% CI: 2.8, 5.8) in the CAC score 0 group to 76.1% (95% CI: 70.3, 81.2) in the CAC score 400 or higher group. Revascularization rates increased from 1.7% to 46.2% across the same groups (P < .001). The CAC score 0 group had a lower MACE risk (0.5%; HR, 0.08 [95% CI: 0.02, 0.30]; P < .001), as did the 1-399 CAC score group (1.9%; HR, 0.27 [95% CI: 0.13, 0.59]; P = .001), compared with the 400 or higher CAC score group (6.8%). No significant difference in MACE between sexes was observed (P = .68). Conclusion: In participants with stable chest pain initially referred for ICA, a CAC score of 0 showed very low risk of MACE, and higher CAC scores showed increasing risk of obstructive CAD, revascularization, and MACE at follow-up.","author_count":82,"contributors":["Biavati, Federico","Saba, Luca","Boussoussou, Melinda","Kofoed, Klaus Fuglsang","Benedek, Theodora","Donnelly, Patrick","Rodríguez-Palomares, José","Erglis, Andrejs","Štěchovský, Cyril","Šakalytė, Gintarė","Ađić, Nada Čemerlić","Gutberlet, Matthias","Dodd, Jonathan D.","Diez, Ignacio","Davis, Gershan","Zimmermann, Elke","Kępka, Cezary","Vidakovic, Radosav","Francone, Marco","Ilnicka-Suckiel, Małgorzata","Plank, Fabian","Knuuti, Juhani","Faria, Rita","Schröder, Stephen","Berry, Colin","Ruzsics, Balazs","Rieckmann, Nina","Kubiak, Christine","Hansen, Kristian Schultz","Müller-Nordhorn, Jacqueline","Maurovich-Horvat, Pál","Sigvardsen, Per E.","Benedek, Imre","Orr, Clare","Valente, Filipa Xavier","Zvaigzne, Ligita","Suchánek, Vojtěch","Jankauskas, Antanas","Ađić, Filip","Woinke, Michael","Cadogan, Diarmaid","Lecumberri, Iñigo","Thwaite, Erica","Kruk, Mariusz","Neskovic, Aleksandar N.","Mancone, Massimo","Kuśmierz, Donata","Feuchtner, Gudrun","Pietilä, Mikko","Ribeiro, Vasco Gama","Drosch, Tanja","Delles, Christian","Cau, Riccardo","Fisher, Michael","Merkely, Bela","Kragelund, Charlotte","Aurelian, Rosca","Kelly, Stephanie","del Blanco, Bruno García","Rubio, Ainhoa","Szilveszter, Bálint","Hove, Jens Dahlgaard","Rodean, Ioana","Regan, Susan","Calabria, Hug Cuéllar","Édes, István Ferenc","Larsen, Linnea","Hodas, Roxana","Napp, Adriane E.","Haase, Robert","Feger, Sarah","Mohamed, Mahmoud","Serna-Higuita, Lina M.","Neumann, Konrad","Dreger, Henryk","Rief, Matthias","Wieske, Viktoria","Budoff, Matthew J.","Estrella, Melanie","Martus, Peter","Bosserdt, Maria","Dewey, Marc"],"cuid":["S01-000.00-731980"],"filters":{"added":"2024-05","altsrc":["Global Data"],"author_count":"51-200 contributors","cluster_size":1,"continent":["America, North","Europe, EU","Europe, Non-EU","Nordic","OECD"],"country":["Austria","Czechia","Finland","Germany","Hungary","Ireland","Italy","Lithuani