R","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","used":1},{"affno":9,"key":"the national danish rat testing group","name":"The National Danish RAT testing group","role":"oau"}],"person":[{"affno":"1 2","corresponding":null,"first":"Uffe Vest","key":"schneideruffevestpau","last":"Schneider","name":"Schneider, Uffe Vest","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Maria Wendelboe","key":"forsbergmariawendelboepau","last":"Forsberg","name":"Forsberg, Maria Wendelboe","rank":2,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Thomas Daell","key":"leineweberthomasdaellpau","last":"Leineweber","name":"Leineweber, Thomas Daell","rank":3,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Christel Barker","key":"jensenchristelbarkerpau","last":"Jensen","name":"Jensen, Christel Barker","rank":4,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Khaled","key":"ghathiankhaledpau","last":"Ghathian","name":"Ghathian, Khaled","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Charlotte Nielsen","key":"agergaardcharlottenielsenpau","last":"Agergaard","locid":"a8504b07-7e19-4c23-8b5f-3ebe728ae63a","name":"Agergaard, Charlotte Nielsen","orcid":"0000-0002-0635-4083","rank":6,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"first":"Kasper Kjersgaard","key":"mortensenkasperkjersgaardpau","last":"Mortensen","locid":"f8d20b3b-9241-4724-81cc-75e0e98c238f","name":"Mortensen, Kasper Kjersgaard","orcid":"0000-0003-1965-0268","rank":7,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Arieh","key":"cohenariehpau","last":"Cohen","name":"Cohen, Arieh","rank":8,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Charlotte Sværke","key":"jørgensencharlottesværkepau","last":"Jørgensen","name":"Jørgensen, Charlotte Sværk