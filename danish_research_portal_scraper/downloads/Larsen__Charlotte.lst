:"","corresponding":null,"first":"M.","key":"faiellappu","last":"Faiella","name":"Faiella, M.","rank":10,"role":"Publisher","rolecode":"ppu"},{"affno":"","corresponding":null,"first":"Rebecca Jane","key":"barthelmieppu","last":"Barthelmie","locid":"e2568912-07da-471b-8619-6b9c92931c58","name":"Barthelmie, Rebecca Jane","rank":11,"role":"Publisher","rolecode":"ppu"},{"affno":"1","corresponding":null,"country":"dk","first":"Torben J.","key":"larsenppu","last":"Larsen","locid":"965dbaf9-67c6-4f4d-b512-2df4845d740d","name":"Larsen, Torben J.","orcid":"0000-0001-6741-5057","rank":12,"role":"Publisher","rolecode":"ppu"},{"affno":"","corresponding":null,"first":"J.","key":"prospathopoulosppu","last":"Prospathopoulos","name":"Prospathopoulos, J.","rank":13,"role":"Publisher","rolecode":"ppu"},{"affno":"","corresponding":null,"first":"J.L.","key":"palmappu","last":"Palma","name":"Palma, J.L.","rank":14,"role":"Publisher","rolecode":"ppu"},{"affno":"","corresponding":null,"first":"V.C.","key":"gomesppu","last":"Gomes","name":"Gomes, V.C.","rank":15,"role":"Publisher","rolecode":"ppu"},{"affno":"","corresponding":null,"first":"T.","key":"youngppu","last":"Young","name":"Young, T.","rank":16,"role":"Publisher","rolecode":"ppu"},{"affno":"","corresponding":null,"first":"P.","key":"stuartppu","last":"Stuart","name":"Stuart, P.","rank":17,"role":"Publisher","rolecode":"ppu"}],"pub":{"publisher":"European Wind Energy Association (EWEA)","status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-59f97ab5-e9e7-4100-91d8-e0a8f06c1c46"],"src":["DTU Technical University of Denmark"],"title":"EERA-DTOC: Design tools for off-shore wind farm clusters including new results on wake bench","type":"Non-Textual Item","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-331332","year":"2013","yearsub":"2013"}
{"abstract":"Type 2 Porcine Reproductive and Respiratory Syndrome Virus (PRRSV) was first detected in Europe in 1996 co-incident with the introduction of a live attenuated vaccine. Since then, only limited ORF5 and ORF7 sequences of Type 2 PRRS viruses have been reported throughout Europe. In the present study, the genetic and antigenic diversity of 11 complete genomes and 49 ORF5 and 55 ORF7 nucleotide sequences obtained from 57 viruses in Denmark from 2003 to 2012 were examined. The genetic identity of the 11 complete genomes to the vaccine strain (Ingelvac PRRS MLV) ranged between 93.6 and 99.6% while the 49 ORF5 sequences examined were 94.0–99.8% identical to the vaccine strain. Among the Danish sequences, the pairwise nucleotide identity was 90.9–100% and 93.0–100.0% for ORF5 and ORF7, respectively. Analysis of the genetic region encoding NSP2 revealed high diversity among the Danish viruses with an 86.6–98.9% range in similarity. Furthermore, several of the sequenced viruses harbored deletions in the NSP2 coding region. Phylogenetic analysis in a global Type 2 PRRSV framework classified all Danish isolates to a single cluster (sub-lineage 5.1) which comprised strains closely-related to the Type 2 prototype isolate VR2332.","author_count":5,"contributors":["Kvisgaard, Lise Kirstine","Hjulsager, Charlotte Kristiane","Brar, Manreetpal Singh","Leung, Frederick C. C.","Larsen, Lars Erik"],"cuid":["S01-000.00-331942"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Asia, East"],"country":["Hong Kong"],"glorg":["All Global Affiliations","The University of Hong Kong"],"keyword":["Porcine Reproductive and Respiratory Syndrome Virus PRRSV"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"genetic dissection of complete genomes of type 000000000002 prrs viruses isolated in denmark over a period of 000000000015 years","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/60491359/1_s2.0_S0378113513004628_main.pdf","version":"Published Version"},"id":"S01-000.00-331942","identifier":[{"id":"24125764","type":"pmid"},{"id":"84888040469","type":"scopus"}],"ids":["dtu-5c0fc301-ce2b-4179-af69-c58e4a2c11dc"],"keyword":["Amino acid variations ORF5","Full genome/complete genome","Genotype 2/Type 2","Non-structural protein 2 (nsp2)","Porcine Reproductive and Respiratory Syndrome Virus (PRRSV)"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-3F0BDAA3846A5D33E1CDBC72FE1AF434"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/60491359/1_s2.0_S0378113513004628_main.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.vetmic.2013.09.023","version":"Other Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Veterinary Institute","Technical University of Denmark, National Veterinary Institute, Section for Virology"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"hk","key":"the university of hong kong","loc":["Hong Kong","Asia, East"],"name":"The University of Hong Kong","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Lise Kirstine","key":"kvisgaardpau","last":"Kvisgaard","locid":"58ce239f-6c30-44e0-ab54-f017a1821425","name":"Kvisgaard, Lise Kirstine","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Charlotte Kristiane","key":"hjulsagerpau","last":"Hjulsager","locid":"6c1511ef-8211-4653-8c81-cd55b7f63f64","name":"Hjulsager, Charlotte Kristiane","orcid":"0000-0001-7557-8876","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Manreetpal Singh","key":"brarpau","last":"Brar","name":"Brar, Manreetpal Singh","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Frederick C. C.","key":"leungpau","last":"Leung","name":"Leung, Frederick C. C.","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars Erik","key":"larsenpau","last":"Larsen","locid":"09c2a33d-b353-44de-a850-f3c7dec879cb","name":"Larsen, Lars Erik","orcid":"0000-0003-0730-5555","rank":5,"rolecode":"pau"}],"pmid":["24125764"],"pub":{"doi":"10.1016/j.vetmic.2013.09.023","issn":["03781135","18732542"],"issn_org":["03781135"],"issue":"3-4","journal":"Veterinary Microbiology","pages":"334-344","publisher":"Elsevier","status":"p","title":"Veterinary Microbiology","volume":"167"},"review":"Peer Reviewed","scoID":["2-s2.0-84888040469"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-5c0fc301-ce2b-4179-af69-c58e4a2c11dc"],"src":["DTU Technical University of Denmark"],"title":"Genetic dissection of complete genomes of Type 2 PRRS viruses isolated in Denmark over a period of 15 years","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-331942","year":"2013","yearsub":"2013"}
{"abstract":"The Danish surveillance program for influenza A virus in pigs has revealed that two novel reassortant swine influenza viruses may now be circulating in the Danish swine population, since they each have been detected in at least two submissions from different herds in 2011 as well as in 2012. One of the reassortant viruses comprised a HA gene similar to H1 of H1N1 avian-like swine influenza virus (SIV) and a NA gene most closely related to N2 gene of human H3N2 influenza virus that circulated in humans in the mid 1990s. The internal genes of this reassortant virus with the subtype H1avN2hu all belonged to the H1N1 avian-like SIV lineages. Until now this novel virus H1avN2hu has only been detected in Danish swine. The other novel reassortant virus contained the HA gene from H1N1pdm09 virus and a NA gene similar to the N2 gene of H3N2 SIV that have been circulating in European swine since the mid 1980s. The N2 gene of this new reassortant virus could also has been donated by the reassortant H1N2 SIV with an avian-like HA gene which is very common in Danish pigs and has been circulating since 2003. The internal genes of this reassortant virus with the subtype H1pdm09N2sw all belonged to the pandemic H1N1pdm09 influenza virus lineage. Swine influenza virus with a similar subtype to H1pdm09N2sw has previously been found in pigs in Italy and Germany. Detailed analyses of viral genes will further elucidate the relationship between these new swine influenza viruses found in the different countries. In addition, several sporadic reassortant swine influenza viruses comprising different constellations of internal genes from known circulating swine influenza viruses were found. Future full genome studies will reveal if some of these reassortant viruses also will be established in the Danish pig population.","author_count":4,"contributors":["Breum, Solvej Østergaard","Hjulsager, Charlotte Kristiane","Trebbien, Ramona","Larsen, Lars Erik"],"cuid":["S01-000.00-358353"],"event":{"end":"2013-09-19","place":"Oxford, gb","start":"2013-09-17","title":"Influenza2013","year":"2013"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"novel reassortant swine influenza viruses are circulating in danish pigs","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/59904145/prod21383518569142.Abstract_Influenza2013_Breum_DTU_VET_1_.pdf","version":"Other Version"},"id":"S01-000.00-358353","ids":["dtu-b3fb638c-345c-428e-9399-63c85d5ba59a"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-438A0328DF62BBDF1C49A834094DABC7"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/59904145/prod21383518569142.Abstract_Influenza2013_Breum_DTU_VET_1_.pdf","version":"Other Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Veterinary Institute","Technical University of Denmark, National Veterinary Institute, Section for Virology"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Solvej Østergaard","key":"breumpau","last":"Breum","locid":"ef91abed-bcb7-4427-b534-982cec892366","name":"Breum, Solvej Østergaard","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Charlotte Kristiane","key":"hjulsagerpau","last":"Hjulsager","locid":"6c1511ef-8211-4653-8c81-cd55b7f63f64","name":"Hjulsager, Charlotte Kristiane","orcid":"0000-0001-7557-8876","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ramona","key":"trebbienpau","last":"Trebbien","locid":"f5a78ced-77e8-4da1-950c-9c1992eac344","name":"Trebbien, Ramona","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars Erik","key":"larsenpau","last":"Larsen","locid":"09c2a33d-b353-44de-a850-f3c7dec879cb","name":"Larsen, Lars Erik","orcid":"0000-0003-0730-5555","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-b3fb638c-345c-428e-9399-63c85d5ba59a"],"src":["DTU Technical University of Denmark"],"title":"Novel reassortant swine influenza viruses are circulating in Danish pigs","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-358353","year":"2013","yearsub":"2013"}
{"abstract":"Biosynthetic pathways of secondary metabolites from fungi are currently subject to an intense effort to elucidate the genetic basis for these compounds due to their large potential within pharmaceutics and synthetic biochemistry. The preferred method is methodical gene deletions to identify supporting enzymes for key synthases one cluster at a time. In this study, we design and apply a DNA expression array for Aspergillus nidulans in combination with legacy data to form a comprehensive gene expression compendium. We apply a guilt-by-association-based analysis to predict the extent of the biosynthetic clusters for the 58 synthases active in our set of experimental conditions. A comparison with legacy data shows the method to be accurate in 13 of 16 known clusters and nearly accurate for the remaining 3 clusters. Furthermore, we apply a data clustering approach, which identifies cross-chemistry between physically separate gene clusters (superclusters), and validate this both with legacy data and experimentally by prediction and verification of a supercluster consisting of the synthase AN1242 and the prenyltransferase AN11080, as well as identification of the product compound nidulanin A. We have used A. nidulans for our method development and validation due to the wealth of available biochemical data, but the method can be applied to any fungus with a sequenced and assembled genome, thus supporting further secondary metabolite pathway elucidation in the fungal kingdom.","author_count":11,"contributors":["Andersen, Mikael Rørdam","Hoof, Jakob Blæsbjerg","Klitgaard, Andreas","Petersen, Lene Maj","Zachariasen, Mia","Hansen, Tilde J","Holberg Blicher, Lene","Gotfredsen, Charlotte Held","Larsen, Thomas Ostenfeld","Nielsen, Kristian Fog","Mortensen, Uffe Hasbro"],"cuid":["S01-000.00-365213"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Aspergilli","Natural products","Polyketide synthases","Secondary metabolism"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"accurate prediction of secondary metabolite gene clusters in filamentous fungi","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1073/pnas.1205532110","version":"Other Version"},"id":"S01-000.00-365213","identifier":[{"id":"23248299","type":"pmid"},{"id":"84871997235","type":"scopus"},{"id":"PMC3538241","type":"pmcid"}],"ids":["dtu-cb159602-7b06-4f48-8736-949416e1ee71"],"keyword":["Aspergilli","Natural products","Polyketide synthases","Secondary metabolism"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-BF373BE4081B40A181415641CD5CDC33"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1073/pnas.1205532110","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Systems Biology","Technical University of Denmark, Department of Systems Biology, Center for Microbial Biotechnology"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Mikael Rørdam","key":"andersenmikaelrørdampau","last":"Andersen","locid":"2b65dbe3-5af3-4d59-84ef-d999b36e5376","name":"Andersen, Mikael Rørdam","orcid":"0000-0003-4794-6808","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jakob Blæsbjerg","key":"hoofjakobblæsbjergpau","last":"Nielsen","locid":"339ce5a8-3232-410d-9484-abbc0f5b81b3","name":"Hoof, Jakob Blæsbjerg","name_org":"Nielsen, Jakob Blæsbjerg","orcid":"0000-0002-7650-9300","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andreas","key":"klitgaardandreaspau","last":"Klitgaard","locid":"8b3059db-d003-40fc-a4d1-4997854cc657","name":"Klitgaard, Andreas","orcid":"0000-0002-2533-570X","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lene Maj","key":"petersenlenemajpau","last":"Petersen","locid":"7a1c5a02-7eb8-40e3-a1ec-621fb3c37652","name":"Petersen, Lene Maj","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mia","key":"zachariasenmiapau","last":"Zachariasen","name":"Zachariasen, Mia","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Tilde J","key":"hansentildejpau","last":"Hansen","name":"Hansen, Tilde J","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lene","key":"holbergblicherlenepau","last":"Holberg Blicher","locid":"04c13764-c35c-4afd-ae4f-607aa26cb9b1","name":"Holberg Blicher, Lene","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Charlotte Held","key":"gotfredsencharlotteheldpau","last":"Gotfredsen","locid":"1cf4df84-2d0e-4693-bf47-e9932e3bf0e3","name":"Gotfredsen, Charlotte Held","orcid":"0000-0002-7386-119X","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Thomas Ostenfeld","key":"larsenthomasostenfeldpau","last":"Larsen","locid":"bd958d52-71b6-4720-b30a-cc9305633b43","name":"Larsen, Thomas Ostenfeld","orcid":"0000-0002-3362-5707","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kristian Fog","key":"nielsenkristianfogpau","last":"Nielsen","locid":"d2067ee9-e48c-4cf4-ac8f-ee775d8aff5a","name":"Nielsen, Kristian Fog","orcid":"0000-0002-5848-0911","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Uffe Hasbro","key":"mortensenuffehasbropau","last":"Mortensen","locid":"dec3038b-f004-4c96-84a1-52825e1c0ce8","name":"Mortensen, Uffe Hasbro","orcid":"0000-0002-7794-7273","rank":11,"rolecode":"pau"}],"pmid":["23248299"],"pub":{"doi":"10.1073/pnas.1205532110","issn":["00278424","10916490"],"issn_org":["00278424"],"issue":"1","journal":"Proceedings of the National Academy of Sciences of the United States of America","publisher":"National Academy of Sciences","status":"p","title":"Proceedings of the National Academy of Sciences of the United States of America","volume":"110"},"review":"Peer Reviewed","scoID":["2-s2.0-84871997235"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-cb159602-7b06-4f48-8736-949416e1ee71"],"src":["DTU Technical University of Denmark"],"title":"Accurate prediction of secondary metabolite gene clusters in filamentous fungi.","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-365213","year":"2013","yearsub":"2013"}
{"abstract":"The objective of these studies was to investigate if porcine postweaning multisystemic wasting syndrome (PMWS) could be induced in healthy pigs following contact with air from pigs with clinical signs of PMWS. The pigs were housed in different units. Either 31 (study I) or 25 (study II) pigs with clinical symptoms of PMWS from a PMWS-affected herd and 25 healthy pigs from a PMWS-free, but PCV2-positive, herd were housed in unit A. Fifty pigs from a PMWS-free herd were housed in unit B, which were connected by pipes to unit A. In unit C, 30 pigs from a PMWS-free herd were housed as controls. In study II, the pigs in units A and B from the PMWS-free herd developed clinical signs of PMWS 2-3 weeks after arrival. PMWS was confirmed at necropsy and the diseased pigs had increased PCV2 load and increased antibody titers against PCV2 in serum that coincided with the development of clinical signs typical of PMWS. Sequence analysis revealed that the PCV2 isolate belonged to genotype 2b. In conclusion, the present study showed that PMWS can be induced in pigs from a PMWS-free herd by airborne contact with pigs from a PMWS-affected herd.","author_count":9,"contributors":["Kristensen, C. S.","Hjulsager, Charlotte Kristiane","Vestergaard, K.","Dupont, Kitt","Bille-Hansen, Vivi","Enøe, Claes","Jorsal, Sven Erik Lind","Bækbo, P.","Larsen, Lars Erik"],"cuid":["S01-000.00-372898"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-AAF","DI-PR-ALL"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-PR-AAF","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"experimental airborne transmission of porcine postweaning multisystemic wasting syndrome","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/52914808/534342.pdf","version":"Published Version"},"id":"S01-000.00-372898","identifier":[{"id":"23476787","type":"pmid"},{"id":"PMC3582107","type":"pmcid"}],"ids":["dtu-e4927dee-81c5-443d-b57f-1ff5f87b8598"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-588C740AA7DD2F454BBC849C2B05E959"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1155/2013/534342","version":"Other Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/52914808/534342.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","country":"dk","key":"danish agriculture food council","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-AAF","l3nl":"Danish Agriculture & Food Council","l3nn":"Danish Agriculture & Food Council","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Danish Agriculture & Food Council","namevar":["Danish Agriculture and Food Council"],"nora_code":"DI-PR-AAF","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Veterinary Institute","Technical University of Denmark, National Veterinary Institute, Section for Public sector service and commercial diagnostics"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"C. S.","key":"kristensenpau","last":"Kristensen","name":"Kristensen, C. S.","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Charlotte Kristiane","key":"hjulsagerpau","last":"Hjulsager","locid":"6c1511ef-8211-4653-8c81-cd55b7f63f64","name":"Hjulsager, Charlotte Kristiane","orcid":"0000-0001-7557-8876",