rsities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-491ee337-029a-4b87-b7b1-b977e68647bc","dtu-553729fd-2795-4eac-a192-5670a63d88d7","ku-617b0e3f-f75b-4adf-bfee-8d22e8d19648"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Overvågning af aviær influenza i vilde fugle 2012 i Danmark","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-090.03-034232","year":"2013","yearsub":"2013"}
{"abstract":"Nye mediers mobilitet og allestedsnærværende karakter understøtter en kreativ og eksperimenterende tilgang til kvalitative studier og etnografisk feltarbejde, hvor forskeren dels bevæger sig imellem forskellige steder, online såvel som offline, og dels benytter internettet og mobile medier til at generere data med. Denne artikel har til formål at belyse, hvorledes sådanne studier kan udføres samt diskutere en række etiske problematikker forbundet hermed. Disse problematikker har at gøre med etiske implikationer i forhold til skellet mellem privat og offentligt, informeret samtykke, beskyttelse af forskningsdeltagerens privatliv, relationen mellem deltager og forsker samt præsentation af data. Artiklen tager udgangspunkt i to cases, hvor nye medier og eksperimenterende kvalitative metoder har været brugt til datagenerering. I den første case er danske unges brug af sociale netværkssider undersøgt ved hjælp af virtuel etnografi og online dataindsamling. I den anden case er unges oplevelser og handlinger i det udsatte boligområde Gellerup blevet undersøgt ved hjælp af en eksperimentel etnografisk tilgang og generering af data med en lokationsbaseret mobilapplikation. I artiklen belyses erfaringerne med at anvende internettet og mobile teknologier i datagenereringen, og det diskuteres, hvorledes man kan udføre etisk forsvarlig forskning, når man benytter sig af nye medier og eksperimenterende kvalitative metoder.","author_count":2,"contributors":["Larsen, Malene Charlotte","Glud, Louise Nørgaard"],"cuid":["S03-100.00-724047"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Etik","Etnografi","Etnografisk metode","Feltarbejde","Informeret samtykke","Internetbaseret","Kvalitativ metode","Nye medier","Sociale medier","brugergenereret indhold","eksperimenterende metode"],"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"nye medier nye metoder nye etiske udfordringer","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://ojs.statsbiblioteket.dk/index.php/mf/article/view/8268/6839","version":"Other Version"},"id":"S03-100.00-724047","ids":["aau-1f892807-4967-4fb3-a697-92430debb12e","aau-ecc3329d-6b61-48e6-99c9-00af1185414f","au-db95de30-43ec-4328-a7e3-5db083eef38b"],"keyword":["brugergenereret indhold","eksperimenterende metode","eksperimenterende metoder, etik, nye medier, eksperimentel etnografi, virtuel etnografi","etik","etnografi","etnografisk metode","feltarbejde","informeret samtykke","internetbaseret","kvalitativ metode","nye medier","sociale medier"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-3-837E703DAF69753808A1D3BBDE94F5ED"],"oa_link":[{"access":"oa","type":"rem","url":"http://ojs.statsbiblioteket.dk/index.php/mf/article/view/8268","version":"Other Version"},{"access":"oa","type":"rem","url":"http://ojs.statsbiblioteket.dk/index.php/mf/article/view/8268/6839","version":"Other Version"}],"oai":{"class":"Blocked","mra":["Humanities (HUM)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Humanities","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Mattering: Centre for Discourse & Practice"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"mis