o":"1","first":"Karen","key":"martinypau","last":"Martiny","locid":"2f168c92-c78b-43da-944e-872121b1cc06","name":"Martiny, Karen","orcid":"0000-0002-7948-1067","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Ashley","key":"webbpau","last":"Webb","name":"Webb, Ashley","rank":5,"rolecode":"pau"},{"affno":"1","first":"Pia","key":"rythansenpau","last":"Ryt-Hansen","locid":"3bc2c20c-771a-4d73-9424-e1173143a632","name":"Ryt-Hansen, Pia","rank":6,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Ramona","key":"trebbienpau","last":"Trebbien","name":"Trebbien, Ramona","rank":7,"rolecode":"pau"},{"affno":"1","first":"Henrik E.","key":"jensenpau","last":"Jensen","locid":"20245e41-1eb4-4cfa-a2d6-e6851e101300","name":"Jensen, Henrik Elvang","name_org":"Jensen, Henrik E.","orcid":"0000-0001-7277-7829","rank":8,"rolecode":"pau"},{"affno":"4 1","first":"Jakob N.","key":"nissenpau","last":"Nissen","locid":"cc63e367-69c4-42e9-b7ab-2f85ed6a2c33","name":"Nissen, Jakob Nybo","name_org":"Nissen, Jakob N.","rank":9,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Kerstin","key":"skovgaardpau","last":"Skovgaard","locid":"2c3c3868-b5a3-457b-8b97-9645ad03e405","name":"Skovgaard, Kerstin","orcid":"0000-0001-5663-4879","rank":10,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Richard J.","key":"webbypau","last":"Webby","name":"Webby, Richard J.","rank":11,"rolecode":"pau"},{"affno":"1","first":"Lars E.","key":"larsenpau","last":"Larsen","locid":"135a9407-d29c-4508-8f79-978f5b295a15","name":"Larsen, Lars Erik","name_org":"Larsen, Lars E.","orcid":"0000-0003-0730-5555","rank":12,"rolecode":"pau"}],"pmid":["38048355"],"pub":{"doi":"10.1371/journal.ppat.1011838","issn":["15537366","15537374"],"issn_org":["15537366"],"issue":"12","journal":"PLoS Pathogens","paperid":"e1011838","publisher":"Public Library of Science","status":"p","title":"PLoS Pathogens","title_org":"PLOS Pathogens","volume":"19"},"review":"Peer Reviewed","scoID":["2-s2.0-85180010480"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-221ac87d-3ad7-4536-aec0-298c4f88ac6b","ku-4fa8f00a-b52b-490f-aa4f-a0de70383839"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Experimental infection of pigs and ferrets with \"pre-pandemic,\" human-adapted, and swine-adapted variants of the H1N1pdm09 Influenza A virus reveals significant differences in viral dynamics and pathological manifestations","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-097.15-716210","year":"2023","yearsub":"2023"}
{"abstract":"Background and Aims: Reliable noninvasive biomarkers are an unmet clinical need for the diagnosis of NASH. This study investigates the diagnostic accuracy of the circulating triggering receptor expressed on myeloid cells 2 (plasma TREM2) as a biomarker for NASH in patients with NAFLD and elevated liver stiffness. Approach and Results: We collected cross-sectional, clinical data including liver biopsies from a derivation (n = 48) and a validation cohort (n = 170) of patients with elevated liver stiffness measurement (LSM ≥ 8.0 kPa). Patients with NAFLD activity scores (NAS) ≥4 were defined as having NASH. Plasma TREM2 levels were significantly elevated in patients with NASH of the derivation cohort, with an area under the receiver operating characteristics curve (AUROC) of 0.92 (95% confidence interval [CI], 0.84–0.99). In the validation cohort, plasma TREM2 level increased approximately two-fold in patients with NASH, and a strong diagnostic accuracy was confirmed (AUROC, 0.83; 95% CI, 0.77–0.89; p < 0.0001). Plasma TREM2 levels were associated with the individual histologic features of NAS: steatosis, lobular inflammation, and ballooning (p < 0.0001), but only weakly with fibrosis stages. Dual cutoffs for rule-in and rule-out were explored: a plasma TREM2 level of ≤38 ng/ml was found to be an optimal NASH rule-out cutoff (sensitivity 90%; specificity 52%), whereas a plasma TREM2 level of ≥65 ng/ml was an optimal NASH rule-in cutoff (specificity 89%; sensitivity 54%). Conclusions: Plasma TREM2 is a plausible individual biomarker that can rule-in or rule-out the presence of NASH with high accuracy and thus has the potential to reduce the need for liver biopsies and to identify patients who are eligible for clinical trials in NASH.","author_count":18,"contributors":["Indira Chandran, Vineesh","Wernberg, Charlotte Wilhelmina","Lauridsen, Mette Munk","Skytthe, Maria Kløjgaard","Bendixen, Sofie Marchsteiner","Larsen, Frederik Tibert","Hansen, Camilla Dalby","Grønkjær, Lea Ladegaard","Siersbæk, Majken Storm","Caterino, Tina Di","Detlefsen, Sönke","Møller, Holger Jon","Grøntved, Lars","Ravnskjaer, Kim","Moestrup, Søren Kragh","Thiele, Maja Sofie","Krag, Aleksander","Graversen, Jonas Heilskov"],"cuid":["S02-098.70-015589"],"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Graversen, Jonas Heilskov"],"keyword":["Biomarkers","Biopsy","Cross Sectional Studies","Humans","Liver Cirrhosis pathology","Liver pathology","Membrane Glycoproteins","Non alcoholic Fatty Liver Disease complications","Receptors Immunologic"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"circulating trem000000000002 as a noninvasive diagnostic biomarker for nash in patients with elevated liver stiffness","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1002/hep.32620","version":"Published Version"},"id":"S02-098.70-015589","identifier":[{"id":"PMC9869959","type":"pmcid"},{"id":"35712786","type":"pmid"},{"id":"85134038246","type":"scopus"}],"ids":["au-290d6894-cce1-4388-8f09-749c084c1df7","sdu-cf67f337-1e71-43fd-9f6a-9a609b0f833c"],"keyword":["Biomarkers","Biopsy","Cross-Sectional Studies","Humans","Liver Cirrhosis/pathology","Liver/pathology","Membrane Glycoproteins","Non-alcoholic Fatty Liver Disease/complications","Receptors, Immunologic"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-B77E979AEE9342FCEAE7B009C1362CF6"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/220085668/Circulating_TREM2_as_a_noninvasive_diagnostic.22.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1002/hep.32620","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"rem","url":"https://pmc.ncbi.nlm.nih.gov/articles/PMC9869959/pdf/hep-77-558.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Molecular Medicine"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of clinical biochemistry"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Vineesh Indira","key":"chandranpau","last":"Chandran","locid":"6ad1f8c6-d1a0-4c52-83f4-3c810ebbd0e5","name":"Chandran, Vineesh Indira","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Charlotte Wilhelmina","key":"wernbergpau","last":"Wernberg","locid":"ef5ba586-43ec-4acd-a868-531a025b7ed6","name":"Wernberg, Charlotte","name_org":"Wernberg, Charlotte Wilhelmina","orcid":"0000-0001-8964-0650","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mette Munk","key":"lauridsenpau","last":"Lauridsen","locid":"47ea3fdf-66e2-4eb3-ade8-aaf22d015ee9","name":"Lauridsen, Mette Munk","orcid":"0000-0003-0586-8549","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Maria Kløjgaard","key":"skytthepau","last":"Skytthe","locid":"72933a3f-0dc9-4228-bb11-9f28aa894765","name":"Skytthe, Maria Kl