last":"Frimurer","locid":"4592246e-6be7-4da6-bbc4-fa9f5061d96b","name":"Frimurer, Thomas M.","name_org":"Frimurer, Thomas M","orcid":"0000-0002-9682-8245","rank":11,"rolecode":"pau"},{"affno":"1","first":"Mette M","key":"rosenkildepau","last":"Rosenkilde","locid":"d902feb8-1594-4fa8-bcb1-9f646dc30dd3","name":"Rosenkilde, Mette M.","name_org":"Rosenkilde, Mette M","orcid":"0000-0001-9600-3254","rank":12,"rolecode":"pau"}],"pmid":["33615180"],"pub":{"doi":"10.1021/acsptsci.0c00193","issn":["25759108"],"issue":"1","journal":"ACS Pharmacology & Translational Science","pages":"296-313","status":"p","title":"ACS Pharmacology & Translational Science","volume":"4"},"review":"Peer Reviewed","scoID":["2-s2.0-85100239627"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-bc95527a-2656-4194-bc79-f4e4a789cb1c"],"src":["KU University of Copenhagen"],"title":"GLP-1 Val8 : A Biased GLP-1R Agonist with Altered Binding Kinetics and Impaired Release of Pancreatic Hormones in Rats","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-506001","year":"2021","yearsub":"2021"}
{"abstract":"The use of medicinal zinc oxide (ZnO) to prevent diarrhoea post-weaning will be banned in the EU from 2022. Therefore, new alternatives are needed to avoid an increase in diarrhoea and higher antibiotic use. A low dietary CP level has shown to lower the frequency of diarrhoea in pigs, due to lower microbial protein fermentation in the colon as well as improved conditions in the small intestine after weaning. The objective of this study was to examine the effect of decreased CP levels post-weaning as an alternative to medicinal ZnO on gut morphology and histopathology. Five hundred and sixty pigs were randomly assigned into one of six groups receiving a two-phase diet from 5.5 to 15 kg: positive control group (PC) with medicinal ZnO and standard levels of protein (19.1–18.4% CP), negative control group (NC) without medicinal ZnO and standard levels of protein (19.1–18.4% CP). The remaining four low protein groups were a low-standard (LS) CP level (16.6–18.4% CP), a low-low (LL) CP level (16.6–16.2% CP), a very low-high (VLH) CP level (14–19.3% CP) and a very low-medium (VLM) CP level (14–17.4% CP). Individual BW was recorded at day 0, 10 and 24 post-weaning, and all antibiotic treatments were recorded. Tissue samples from the small intestine (mid-jejunum) for morphological and histopathologic analysis, organ weights, blood and urine samples were collected at day 10 and 24 post-weaning from a total of 90 sacrificed weaners. The results demonstrated no differences in intestinal morphology between groups, but the histopathology showed a damaged brush border score in VLM and VLH pigs . In addition, a lower blood urea nitrogen in VLM pigs at 24 days was found. The LL and VLM pigs had a significantly decreased average daily gain in the overall trial period compared to PC and NC pigs. Conclusively, intestinal brush border was damaged by the very low protein diet at 24 days post-weaning, but intestinal morphology was unaffected by dietary strategy.","author_count":7,"contributors":["Larsen, C.","Lynegaard, Julie C.","Pedersen, Anni Øyan","Kjeldsen, N. J.","Hansen, C. F.","Nielsen, Jens Peter","Williams, Charlotte Amdi"],"cuid":["S01-000.00-542477"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Blood urea nitrogen","Dietary protein","Swine"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"a reduced cp level without medicinal zinc oxide does not alter the intestinal morphology in weaned pigs 000000000024 days post weaning","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.animal.2021.100188","version":"Published Version"},"id":"S01-000.00-542477","identifier":[{"id":"85101405166","type":"scopus"},{"id":"33610517","type":"pmid"}],"ids":["ku-f9b72fb0-ad00-47b0-9342-5011430feb2f"],"keyword":["Blood urea nitrogen","Dietary protein","Intestinal brush border","Intestinal histopathology","Swine"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-61B026ABEC58DCC3292D2EAE74B9CF84"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.animal.2021.100188","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/273598527/1_s2.0_S1751731121000185_main_1_.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary and Animal Sciences, Comparative Pediatrics and Nutrition","Københavns Universitet, Faculty of Health and Medical Sciences, The Graduate Programme for In Vivo Pharmacology and Experimental Animals"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"C.","key":"larsenpau","last":"Larsen","locid":"694ee612-8562-4e50-9a0e-1918acd31784","name":"Larsen, C.","rank":1,"rolecode":"pau"},{"affno":"1","first":"J. C.","key":"lynegaardpau","last":"Lynegaard","locid":"bcf39ade-982e-4e66-a1c1-9a943aeb16b0","name":"Lynegaard, Julie C.","name_org":"Lynegaard, J. C.","rank":2,"rolecode":"pau"},{"affno":"1","first":"A.","key":"pedersenpau","last":"Pedersen","locid":"c77a1305-beb0-418f-b09f-d7acd964eb3c","name":"Pedersen, Anni Øyan","name_org":"Pedersen, A.","rank":3,"rolecode":"pau"},{"affno":"","first":"N. J.","key":"kjeldsenpau","last":"Kjeldsen","name":"Kjeldsen, N. J.","rank":4,"rolecode":"pau"},{"affno":"","first":"C. F.","key":"hansenpau","last":"Hansen","name":"Hansen, C. F.","rank":5,"rolecode":"pau"},{"affno":"1","first":"J. P.","key":"nielsenpau","last":"Nielsen","locid":"e550301c-f89e-4a8b-bf34-e6fc3b76ff37","name":"Nielsen, Jens Peter","name_org":"Nielsen, J. P.","rank":6,"rolecode":"pau"},{"affno":"1","first":"C.","key":"amdipau","last":"Amdi","locid":"8057561d-85f5-4717-ba1e-18a709a9f121","name":"Williams, Charlotte Amdi","name_org":"Amdi, C.","rank":7,"rolecode":"pau"}],"pmid":["33610517"],"pub":{"doi":"10.1016/j.animal.2021.100188","issn":["17517311","1751732X"],"issn_org":["17517311"],"issue":"4","journal":"Animal","paperid":"100188","status":"p","title":"Animal","volume":"15"},"review":"Peer Reviewed","scoID":["2-s2.0-85101405166"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-f9b72fb0-ad00-47b0-9342-5011430feb2f"],"src":["KU University of Copenhagen"],"title":"A reduced CP level without medicinal zinc oxide does not alter the intestinal morphology in weaned pigs 24 days post-weaning","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-542477","year":"2021","yearsub":"2021"}
{"abstract":"Computational protein design has taken big strides in recent years; however, the tools available are still not at a state where a sequence can be designed to fold into a given protein structure at will and with high probability. We have applied here a recent release of Rosetta Design to redesign a set of structurally very similar proteins belonging to the thioredoxin fold. We used a genetic screening tool to estimate solubility/folding of the designed proteins in E. coli and to select the best hits from this for further biochemical characterization. We have previously used this set of template proteins for redesign and found that success was highly dependent on template structure, a trait which was also found in this study. Nevertheless, state-of-the-art design software is now able to predict the best template, most likely due to the introduction of an energy term that reports on stress in covalent bond lengths and angles. The template that led to the greatest fraction of successful designs was the same (a thioredoxin from spinach) as that identified in our previous study. Our previously described redesign of thioredoxin, which also used the spinach protein as a template, however also performed well as a template. In the present study, both of these templates yielded proteins with compact folded structures and enforced the conclusion that any design project must carefully consider different design templates. Fortunately, selecting designs based on energies appears to correctly identify such templates.","author_count":5,"contributors":["Marin, Frederikke Isa","Johansson, Kristoffer Enøe","O'Shea, Charlotte","Lindorff-Larsen, Kresten","Winther, Jakob R."],"cuid":["S01-000.00-544451"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"computational and experimental assessment of backbone templates for computational redesign of the thioredoxin fold","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-544451","identifier":[{"id":"34592819","type":"pmid"},{"id":"85117143782","type":"scopus"}],"ids":["ku-fd0b9b4a-165c-438b-838d-378fe7725b2c"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-56D7A141DED058F3DE68B3B1ACFC0A2E"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Biology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Frederikke Isa","key":"marinpau","last":"Marin","locid":"bd816760-1e9c-4534-98f2-4214152fbc7c","name":"Marin, Frederikke Isa","rank":1,"rolecode":"pau"},{"affno":"1","first":"Kristoffer Enøe","key":"johanssonpau","last":"Johansson","locid":"34484100-1988-429c-8752-50e9ec016138","name":"Johansson, Kristoffer Enøe","rank":2,"rolecode":"pau"},{"affno":"1","first":"Charlotte","key":"osheapau","last":"O'Shea","locid":"66faa368-fff8-4a0a-8001-73ce7306646f","name":"O'Shea, Charlotte","rank":3,"rolecode":"pau"},{"affno":"1","first":"Kresten","key":"lindorfflarsenpau","last":"Lindorff-Larsen","locid":"be20a4d8-92c4-44b9-9dfb-b6ad6471a58c","name":"Lindorff-Larsen, Kresten","orcid":"0000-0002-4750-6039","rank":4,"rolecode":"pau"},{"affno":"1","first":"Jakob Rahr","key":"wintherpau","last":"Winther","locid":"1037684b-136c-4b11-b63a-20b7f13a853b","name":"Winther, Jakob R.","name_org":"Winther, Jakob Rahr","orcid":"0000-0001-6995-9154","rank":5,"rolecode":"pau"}],"pmid":["34592819"],"pub":{"doi":"10.1021/acs.jpcb.1c05528","issn":["15205207","15206106"],"issn_org":["15206106"],"issue":"40","journal":"Journal of Physical Chemistry Part B: Condensed Matter, Materials, Surfaces, Interfaces & Biophysical","pages":"11141-11149","status":"p","title":"Journal of Physical Chemistry Part B: Condensed Matter, Materials, Surfaces, Interfaces & Biophysical","title_org":"The Journal of Physical Chemistry B","volume":"125"},"review":"Peer Reviewed","scoID":["2-s2.0-85117143782"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-fd0b9b4a-165c-438b-838d-378fe7725b2c"],"src":["KU University of Copenhagen"],"title":"Computational and Experimental Assessment of Backbone Templates for Computational Redesign of the Thioredoxin Fold","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-544451","year":"2021","yearsub":"2021"}
