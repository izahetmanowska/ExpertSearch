-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Companies","Other Research","Private Research","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark","amgros"],"PST":["Published"]},"sid":["ku-747a2918-47b0-4283-8a79-77a1e9d6c439","sdu-71c454b2-becf-4f2e-9120-e314eb0ec67e"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Safe and effective use of medicines for patients with type 2 diabetes - A randomized controlled trial of two interventions delivered by local pharmacies : A randomized controlled trial of two interventions delivered by local pharmacies","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-093.57-751911","year":"2015","yearsub":"2015"}
{"abstract":"Abstract for keynote presentation","author_count":1,"contributors":["Larsen, Malene Charlotte"],"cuid":["S01-000.00-055122"],"event":{"end":"2015-11-11","place":"Aarhus, dk","start":"2015-11-10","title":"ECREA Interpersonal Communication and Social Interaction Conference","year":"2015"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"social intimacy in social media how youth practice friendships and construct identity online","src":["aau"],"src-code":["DI-U-AAU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-055122","ids":["aau-11676712-4149-4fc7-8816-266db7bdc8d5"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-FF16090AD407D169D4FA23174924B758"],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Humanities","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology","Aalborg University, The Faculty of Social Sciences and Humanities, Department of Communication and Psychology, Mattering: Centre for Discourse & Practice"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Malene Charlotte","key":"larsenpau","last":"Larsen","locid":"cc0033d3-6794-4e0c-b451-939e05f9a1ee","name":"Larsen, Malene Charlotte","orcid":"0000-0003-4821-5855","rank":1,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL"