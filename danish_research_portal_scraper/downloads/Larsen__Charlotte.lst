en","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, Kristoffer Arildsen","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kirstine Friis","key":"børstingpau","last":"Børsting","locid":"ece5580d-7ce9-49ef-8681-5a386b07e847","name":"Børsting, Kirstine Friis","orcid":"0009-0009-7741-1979","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Lea Lund","key":"larsenpau","last":"Larsen","name":"Larsen, Lea Lund","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Lea","key":"lundpau","last":"Lund","name":"Lund, Lea","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Nanna","key":"rolvingpau","last":"Rolving","locid":"0961714b-e933-4746-9e00-94c3f9b706b7","name":"Rolving, Nanna","orcid":"0000-0001-9195-7278","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Charlotte Ettrup","key":"christiansenpau","last":"Christiansen","locid":"2af46531-6b01-42ea-8f59-db89a141b992","name":"Christiansen, Charlotte Ettrup","rank":8,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Morten","key":"thomsenpau","last":"Thomsen","name":"Thomsen, Morten","rank":8,"rolecode":"pau"}],"pub":{"pages":"44","place":"Regionshospitalet Silkeborg, Center for Planlagt Kirurgi","publisher":"Region Midtjylland","status":"p"},"review":"Undetermined","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","All University Colleges","DI-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","Universities","University Colleges","VIA University College"],"PST":["Published"]},"sid":["au-97730848-aa2c-4fd2-89aa-9d0896cc502a","via-c5a70263-ef3b-4e7e-9bb5-1db2be0fdfd1"],"src":["AU Aarhus University","VIA University College"],"title":"BackTrace version 0.8 - erfaringer fra pilotdrift","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-089.09-756056","year":"2022","yearsub":"2022"}
{"abstract":"Background: Salivary gland (SG) hypofunction (objectively reduced saliva flow rate) and xerostomia (subjective sensation of dry mouth) are common and burdensome side effects of radiotherapy to the head and neck region. Currently, only sparse symptomatic treatment is available to ease the discomfort of xerostomia. The objective of this study is to assess the effect of mesenchymal stem cell (MSC) therapy on SG function after radiation-induced injury. Methods: This systematic review will include animal intervention studies assessing efficacy and safety of MSCs in treating radiation-induced SG hypofunction. The primary outcome is the effect of MSC administration on salivary flow rates (SFR), by comparing treated groups to control groups when available. Secondary outcomes are morphological and immunohistochemical effects as well as safety of MSC treatment. Electronic searches in MEDLINE (PubMed) and Embase databases will be constructed and validated according to the peer review of electronic search strategies (PRESS) and assessed by two independent researchers. Data from eligible studies will be extracted, pooled, and analyzed using random-effects models. Risk of bias will be evaluated with the Systematic Review Centre for Laboratory animal Experimentation (SYRCLE) risk of bias tool. Discussion: Thus far, critical appraisal of MSC therapy as an effective treatment for SG hypofunction caused solely by radiation injury has not been conducted. A summary of the existing literature on preclinical studies concerning this issue can provide valuable information about effectiveness, mode of action, and safety, allowing further optimization of preclinical and clinical trials. Systematic review registration: PROSPERO CRD42021227336","author_count":14,"contributors":["Jansson, Per Marcus","Lynggaard, Charlotte Duch","Carlander, Amanda Fenger","Jensen, Siri Beier","Follin, Bjarke","Hoeeg, Cecilie","Kousholt, Birgitte Saima","Larsen, Rasmus Tolstrup","Grønhøj, Christian","Jakobsen, Kathrine Kronberg","Rimborg, Susie","Fischer-Nielsen, Anne","Menon, Julia M.L.","von Buchwald, Christian"],"cuid":["S02-094.25-015824"],"filters":{"added":"2022-06","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD"],"corresponding_author":["Lynggaard, Charlotte Duch"],"country":["Netherlands"],"glorg":["All Global Affiliations","Radboud University Nijmegen"],"keyword":["Head","Quality of Life","Radiotherapy","Salivary gland hypofunction","Stem cells","Strategies","Systematic review","Xerostomia"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"mesenchymal stromal stem cell therapy for radiation induced salivary gland hypofunction in animal models a protocol for a systematic review and meta analysis","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s13643-022-01943-2","version":"Published Version"},"id":"S02-094.25-015824","identifier":[{"id":"PMC9016929","type":"pmcid"},{"id":"000783472900002","type":"wos"},{"id":"35436971","type":"pmid"},{"id":"85128518077","type":"scopus"}],"ids":["au-2c0f1a8e-dc3b-405e-a218-db7969cd9fff","ku-a0a4fb99-7885-423e-812f-45d501268c4c"],"keyword":["HEAD","QUALITY-OF-LIFE","Radiotherapy","STRATEGIES","Salivary gland hypofunction","Stem cells","Systematic review","Xerostomia"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-02D9686216633C6D040522B024C44C48"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/304133797/Mesenchymal.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s13643-022-01943-2","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Dentistry and Oral Health, Department of Dentistry and Oral Health - Institutledelsen, Odontologi og Oral Sundhed"],"nora_code":"DI-U-AU","used":1},{"affno":"4","country":"nl","key":"radboud university nijmegen","loc":["Netherlands","Europe, EU","OECD"],"name":"Radboud University Nijmegen","used":1}],"person":[{"affno":"1","first":"Per Marcus","key":"janssonpau","last":"Jansson","name":"Jansson, Per Marcus","rank":1,"rolecode":"pau"},{"affno":"1 2","first":"Charlotte Duch","key":"lynggaardpau","last":"Lynggaard","locid":"48939833-8bab-4e03-82f4-c96cc9441aff","name":"Lynggaard, Charlotte Duch","rank":2,"rolecode":"pau"},{"affno":"1","first":"Amanda Fenger","key":"carlanderpau","last":"Carlander","name":"Carlander, Amanda Fenger","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Siri Beier","key":"jensenpau","last":"Jensen","locid":"3a38bf2e-6373-4936-9128-a6cbe2ac6a08","name":"Jensen, Siri Beier","orcid":"0000-0003-3698-6337","rank":4,"rolecode":"pau"},{"affno":"1","first":"Bjarke","key":"follinpau","last":"Follin","name":"Follin, Bjarke","rank":5,"rolecode":"pau"},{"affno":"1","first":"Cecilie","key":"hoeegpau","last":"Hoeeg","name":"Hoeeg, Cecilie","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Birgitte Saima","key":"kousholtpau","last":"Kousholt","locid":"b48ea490-8f1c-4a6a-a621-95ea949b1c3c","name":"Kousholt, Birgitte Saima","orcid":"0000-0001-8286-3624","rank":7,"rolecode":"pau"},{"affno":"2","first":"Rasmus Tolstrup","key":"larsenpau","last":"Larsen","locid":"51e543c7-307c-4ac0-9d44-388cf7963f7b","name":"Larsen, Rasmus Tolstrup","orcid":"0000-0002-8860-4233","rank":8,"rolecode":"pau"},{"affno":"2","first":"Christian","key":"gronhojpau","last":"Gronhoj","locid":"28f17c21-9acb-47f4-852f-ac4073a2dc20","name":"Grønhøj, Christian","name_org":"Gronhoj, Christian","rank":9,"rolecode":"pau"},{"affno":"2","first":"Kathrine Kronberg","key":"jakobsenpau","last":"Jakobsen","locid":"32532bce-35af-40c8-b055-225bbf04aea8","name":"Jakobsen, Kathrine Kronberg","rank":10,"rolecode":"pau"},{"affno":"2","first":"Susie","key":"rimborgpau","last":"Rimborg","locid":"9a2cf361-dda3-44a7-97e7-c55f94776eb8","name":"Rimborg, Susie","rank":11,"rolecode":"pau"},{"affno":"2","first":"Anne","key":"fischernielsenpau","last":"Fischer-Nielsen","locid":"af37e8db-0c68-4da1-9b25-5625d241b9ca","name":"Fischer-Nielsen, Anne","rank":12,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Julia M.L.","key":"menonpau","last":"Menon","name":"Menon, Julia M.L.","rank":13,"rolecode":"pau"},{"affno":"2","first":"Christian","key":"vonbuchwaldpau","last":"von Buchwald","locid":"fc76b0d1-1263-48f7-a4d0-685e60bbc1b6","name":"von Buchwald, Christian","orcid":"0000-0001-6753-8129","rank":14,"rolecode":"pau"}],"pmid":["35436971"],"pub":{"doi":"10.1186/s13643-022-01943-2","issn":["20464053"],"journal":"Systematic Reviews","paperid":"72","publisher":"BioMed Central","status":"p","title":"Systematic Reviews","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-85128518077"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-2c0f1a8e-dc3b-405e-a218-db7969cd9fff","ku-a0a4fb99-7885-423e-812f-45d501268c4c"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Mesenchymal stromal/stem cell therapy for radiation-induced salivary gland hypofunction in animal models : a protocol for a systematic review and meta-analysis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-094.25-015824","year":"2022","yearsub":"2022"}
{"abstract":"Since 1993, regular population health surveys in Greenland have supported and monitored the public health strategy of Greenland and have monitored cardiometabolic and lung diseases. The most recent of these surveys included 2539 persons aged 15+ from 20 communities spread over the whole country. The survey instruments included personal interviews, self-administered questionnaires, blood sampling, anthropometric measurements, blood pressure, ECG, oral glucose test, pulmonary function, hand grip strength and chair stand test. Blood samples were analysed for glucose, glycated haemoglobin (HbA1c), insulin, incretin hormones, cholesterol, kidney function, fatty acids in erythrocyte membranes and mercury, urine for albumin-creatinine ratio, and aliquots were stored at -80°C for future use. Data were furthermore collected for studies of the gut microbiome and diabetes complications. Survey participants were followed up with register data. The potential of the study is to contribute to the continued monitoring of risk factors and health conditions as part of Greenland's public health strategy and to study the epidemiology of cardiometabolic diseases and other chronic diseases and behavioural risk factors. The next population health survey is planned for 2024. The emphasis of the article is on the methods of the study and results will be presented in other publications.","author_count":11,"contributors":["Bjerregaard, Peter","Larsen, Christina Viskum Lytken","Olesen, Ingelise","Ottendahl, Charlotte Brandstrup","Backer, Vibeke","Senftleber, Ninna","Christensen, Marie Mathilde Bjerg","Larsen, Trine Jul","Byberg, Stine","Hansen, Torben","Jørgensen, Marit Eika"],"cuid":["S02-100.00-044606"],"filters":{"added":"2022-08","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Nordic"],"corresponding_author":["Bjerregaard, Peter"],"country":["Greenland"],"glorg":["All Global Affiliations","Grønlands Universitet","Steno Diabetes Center Greenland","University of Greenland"],"keyword":["Cardiometabolic diseases","Cardiovascular Diseases epidemiology","Glucose","Greenland","Greenland epidemiology","Hand Strength","Humans","Inuit","Inuits","Life Style","Population health","Population health survey","Prospective Studies","Risk Factors","Social determinants","Social determinants of health","Surveys and Questionnaires","airway diseases"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-STENO"],"OT":["Steno Diabetes Centre, Gentofte, Denmark."],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-STENO","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"the greenland population health survey 000000002018 methods of a prospective study of risk factors for lifestyle related diseases and social determinants of health amongst inuit","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1080/22423982.2022.2090067","version":"Published Version"},"funding_acknowledgement":["The questionnaire study was funded by the Department of Health and the Department of Social and Legal Affairs of the Greenland government. The clinical data collection was funded by the Novo Nordisk Foundation [NNF 17SH0027192, and NNF 17OC0028136 and NNF15OC0016544] and by Steno Diabetes Center Copenhagen which is partially funded by an unrestricted donation from the Novo Nordisk Foundation; pulmonary testing was funded by V. Backer. Analyses of blood mercury was funded by the Environmental Protection Agency in Denmark (Miljøstyrelsen) (J.nr. 2019–8461). We thank the interviewers, examiners, local citizens who helped make the survey feasible, and the participants who willingly gave their time."],"id":"S02-100.00-044606","identifier":[{"id":"000812709600001","type":"wos"},{"id":"85132082443","type":"scopus"},{"id":"35711125","type":"pmid"},{"id":"PMC9225753","type":"pmcid"}],"ids":["ku-97ff395a-b8bb-42a6-a1b0-460e311842c2","sdu-17adbf72-19cb-4442-829e-ecb3cd271baf"],"keyword":["Cardiovascular Diseases/epidemiology","Glucose","Greenland","Greenland/epidemiology","Hand Strength","Humans","Inuit","Inuits","Life Style","Population Health","Prospective Studies","Risk Factors","Social Determinants of Health","Surveys and Questionnaires","airway diseases","cardiometabolic diseases","population health survey","social determinants"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-75797DF92FE6B3058A5E8FB36606CC41"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/206691378/The_Greenland_population_health_survey_2018_methods_of_a_prospective_study_of_risk_factors_for_lifestyle_related_diseases_and_social_determinants_of.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1080/22423982.2022.2090067","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://curis.ku.dk/ws/files/311611209/22423982.2022.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, National Institute of Public Health","SDU, The Faculty of Health Sciences, National Institute of Public Health, Center for Public health in Greenland","SDU, The Faculty of Health Sciences, National Institute of Public Health, Department of Population Health and Morbidity"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"gl","key":"university of greenland","loc":["Greenland","Nordic"],"name":"University of Greenland","used":1},{"affno":"3","country":"gl","key":"grønlands universitet","loc":["Greenland","Nordic"],"name":"Grønlands Universitet","used":1},{"affno":"4","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal Medicine: Respiratory Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Otorhinolaryngology"],"nora_code":"DI-U-KU","used":1},{"affno":"5","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"6","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Steno Diabetes Centre, Gentofte, Denmark."],"nora_code":"DI-OT","used":1},{"affno":"7","country":"gl","key":"steno diabetes center greenland","loc":["Greenland","Nordic"],"name":"Steno Diabetes Center Greenland","used":1},{"affno":"8","country":"dk","key":"steno diabetes centers","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-STENO","l3nn":"Steno Diabetes Centers","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Steno Diabetes Centers","namevar":["Steno Diabetes Center Copenhagen"],"nora_code":"DI-HO-STENO","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Peter","key":"bjerregaardpeterpau","last":"Bjerregaard","locid":"ef4a2fa7-9735-4b1e-a4fa-b1272def2cfc","name":"Bjerregaard, Peter","orcid":"0000-0001-7153-8447","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christina Viskum Lytken","key":"larsenchristinaviskumlytkenpau","last":"Larsen","locid":"3ee738b1-09d1-4886-9ddf-67ca132997fe","name":"Larsen, Christina Viskum Lytken","orcid":"0000-0002-6245-4222","rank":2,"rolecode":"pau"},{"affno":"2 3","first":"Ingelise","key":"oleseningelisepau","last":"Olesen","name":"Olesen, Ingelise","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Charlotte Brandstrup","key":"ottendahlcharlottebrandstruppau","last":"Ottendahl","locid":"9e2ae085-ebf8-4688-b8cf-c257c5458aca","name":"Ottendahl, Charlotte Brandstrup","orcid":"0000-0002-9285-3099","rank":4,"rolecode":"pau"},{"affno":"4 5","first":"Vibeke","key":"backervibekepau","last":"Backer","locid":"8ea3c13b-5a32-4002-b7bb-4621659a1827","name":"Backer, Vibeke","rank":5,"rolecode":"pau"},{"affno":"6 7 8","first":"Ninna","key":"senftleberninnapau","last":"Senftleber","name":"Senftleber, Ninna","rank":6,"rolecode":"pau"},{"affno":"6 8","first":"Marie Mathilde Bjerg","key":"christensenmariemathildebjergpau","last":"Christensen","name":"Christensen, Marie Mathilde Bjerg","rank":7,"rolecode":"pau"},{"affno":"2 3","first":"Trine Jul","key":"larsentrinejulpau","last":"Larsen","name":"Larsen, Trine Jul","rank":8,"rolecode":"pau"},{"affno":"6 8","first":"Stine","key":"bybergstinepau","last":"Byberg","name":"Byberg, Stine","rank":9,"rolecode":"pau"},{"affno":"4","first":"Torben","key":"hansentorbenpau","last":"Hansen","locid":"6b6bfff1-8b14-468b-af77-e71b375018e0","name":"Hansen, Torben","orcid":"0000-0001-8748-3831","rank":10,"rolecode":"pau"},{"affno":"1 3 7 8","corresponding":null,"first":"Marit Eika","key":"jørgensenmariteikapau","last":"Jørgensen","locid":"5a2309e5-48cd-4773-9887-7b0255811460","name":"Jørgensen, Marit Eika","orcid":"0000-0001-8356-5565","rank":11,"rolecode":"pau"}],"pmid":["35711125"],"pub":{"doi":"10.1080/22423982.2022.2090067","issn":["12399736","22423982"],"issn_org":["12399736"],"issue":"1","journal":"International Journal of Circumpolar Health","paperid":"2090067","publisher":"Taylor & Francis","status":"p","title":"International Journal of Circumpolar Health","volume":"81"},"review":"Peer Reviewed","scoID":["2-s2.0-85132082443"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-97ff395a-b8bb-42a6-a1b0-460e311842c2","sdu-17adbf72-19cb-4442-829e-ecb3cd271baf"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"The Greenland population health survey 2018 - methods of a prospective study of risk factors for lifestyle related diseases and social determinants of health amongst Inuit","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-044606","year":"2022","yearsub":"2022"}
{"abstract":"OBJECTIVES: This study investigated the effects of the health promotion intervention \"11 for Health in Denmark\" programme on 10-12-year-old ethnic minority schoolchildren's enjoyment, health knowledge, well-being and fitness. METHODS: 1122 Danish 5th grade schoolchildren with ethnic minority background from 154 schools were randomised (5:1) to an intervention group (IG, n=944) or a control group (CG, n=178). The IG and CG were also divided into subgroups of children active in a sports club (IGPA: n=644; CGPA: n=122) and not active in a sports club (IGPI: n=300, CGPI: n=56). IG participated in the \"11 for Health in Denmark\" 11-week program, consisting of 2×45 min per week of football drills, small-sided games, and health education, whereas CG continued their regular activities. Pre-post physical testing and questionnaires were applied (short version of the multidimensional well-being questionnaire KIDSCREEN-27, and a 34-item health knowledge questionnaire). RESULTS: The \"11 for Health in Denmark\" programme was rated moderate-to-high on a 1-5 scale for enjoyment by girls (3.57) as well as boys (3.65). The intervention had positive between-group effect on health knowledge in relation to hygiene (IG vs GC: 10.6%-points (CI95%: 6.9:14.3), P<0.05), nutrition (9.6%-point (CI95%: 7.4:11.8), P<0.01) and physical activity 4.4%-points (CI95%: 2.2:6.6) as well as overall health knowledge (5.7%-points, (CI95%: 4.3;7.1), P<0.05), with similar effects for girls and boys. The IGPI subgroup showed a positive effect on well-being (P=0.04, school and learning) and also fitness effects on performance and VO2 Max (P=0.02; P=0.01). The IGPA subgroup showed a positive effect on fitness scores (P=0.02, BMI). CONCLUSION: The intervention program was enjoyable and had a positive impact on health knowledge of ethnic minority background schoolchildren. In addition, the intervention programme had the strongest positive effects on well-being and fitness scores for the non-sports club-active children.","author_count":8,"contributors":["Ryom, Knud","Christiansen, Søren Riis","Elbe, Anne-Marie","Aggestrup, Charlotte Sandager","Madsen, Esben Elholm","Madsen, Mads","Larsen, Malte Nejst","Krustrup, Peter"],"cuid":["S03-099.34-029178"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"continent":["Asia, East","Europe, EU","Europe, Non-EU","OECD"],"corresponding_author":["Ryom, Knud"],"country":["China","Germany","United Kingdom"],"glorg":["All Global Affiliations","Leipzig University","Shanghai University of Sport","University of Exeter"],"keyword":["Association football","Child","Denmark","Ethnic and Racial Minorities","Ethnicity","Exercise","Female","Health promotion","Humans","Male","Minority Groups","Minority health","Non communicable diseases","Physical Education and Training","Physical education","Soccer","health nutrition and quality of life"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U","DI-UC"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"],"UC":["DI-UC-ALL","DI-UC-KP"]},"level3all":["DI-U-AU","DI-U-SDU","DI-UC-KP"]},"review":"pr","rtype":["clu"],"sorti":"the danish 000000000011 for health program raises health knowledge well being and fitness in ethnic minority 000000000010 to 000000000012 year olds","src":["au","kp","sdu"],"src-code":["DI-U-AU","DI-U-SDU","DI-UC-KP"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/193320096/sms.14057.pdf","version":"Authors Final Version"},"funding_acknowledgement":["We thank Professor Jiri Dvorak for the support and help in developing the intervention program. Furthermore, the authors acknowledge the collaboration with the Danish Football Association on the program manual, teaching courses, and nationwide program implementation in Denmark, especially Tina Enestrøm, Mikkel Alleslev Larsen, Kenneth Grønlund Rasmussen, and Kenneth Reeh. We would also thank all the pupils, and teachers involved in the study. The authors are grateful for important contributions and appreciated collaboration by Professor Astrid Junge and Dr. Colin W Fuller, and for the testing assistance given by Rasmus Cyril Ellegaard, Georgios Ermidis, Mariam El‐Halabi, Trine Møller, and Bjørn Fristrup from the University of Southern Denmark and for the analysis assistance given by from Aarhus University. The authors acknowledge the financial support of the Nordea‐foundation (Nordea‐fonden), Aase and Ejnar Danielsens Foundation and the Danish Football Association (Dansk Boldspil‐Union, DBU)."],"id":"S03-099.34-029178","identifier":[{"id":"34555200","type":"pmid"},{"id":"85116483226","type":"scopus"}],"ids":["au-e3e1856c-a015-4674-b9d5-878ed12a78eb","kp-49e45cb6-3317-4400-b1f2-df3c5815fc9f","sdu-ed60b07d-bc6d-4ce5-915f-c94aca928777"],"keyword":["Child","Denmark","Ethnic and Racial Minorities","Ethnicity","Exercise","Female","Humans","Male","Minority Groups","Physical Education and Training","association football","health promotion","health, nutrition and quality of life","minority health","non-communicable diseases","physical education","soccer"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-D32E85F6111DC5E9B2C87918216D7B56"],"oa_link":[{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/193320096/sms.14057.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Public Health, Department of Public Health - Department of Health Services Research"],"nora_code":"DI-U-AU","used":1}