rff-Larsen, Karen Gilboe","rank":6,"rolecode":"pau"},{"affno":"6 7","corresponding":null,"first":"Bjørn Ulrik","key":"nielsenbjørnulrikpau","last":"Nielsen","locid":"02d55a8f-14d0-40e3-9804-a8d73c2c147c","name":"Nielsen, Bjørn Ulrik","rank":7,"rolecode":"pau"},{"affno":"2","first":"Lars","key":"kongelarspau","last":"Konge","locid":"e1c287e3-4cd2-43d2-887d-f2f77fd5daf8","name":"Konge, Lars","orcid":"0000-0002-1258-5822","rank":8,"rolecode":"pau"}],"pmid":["29318426"],"pub":{"doi":"10.1007/s00330-017-5244-7","issn":["09387994","14321084"],"issn_org":["09387994"],"issue":"6","journal":"European Radiology","pages":"2319-2327","publisher":"Springer","status":"p","title":"European Radiology","volume":"28"},"review":"Peer Reviewed","scoID":["2-s2.0-85040245358"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","North Denmark Region","Other Research","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-b0030d04-c9e2-4223-8526-533d274dfe89","ku-ff613d82-fca2-4ee1-97e8-0a500a2083a5","sdu-e53f8b0d-9e9d-402b-afb0-413daf6b1ad5"],"src":["AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Determining procedures for simulation-based training in radiology : A nationwide needs assessment","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-097.19-025485","year":"2018","yearsub":"2018"}
{"abstract":"The growth of the bioethanol industry is leading to an increase in the production of coproducts such as dried distillers grains with solubles (DDGS). Both corn-based DDGS and grain-based DDGS (gDDGS; defined as originating from grain sources such as barley, wheat, triticale, or a mix, excluding corn) appear to be relevant sources of feed and protein for dairy cows. To date, most of the studies investigating DDGS have been performed with corn-based DDGS. The objectives of this study were to determine the effects of the proportion of gDDGS in the diet on feed intake, milk production, and milk quality. The present experiment involved 48 Holstein cows in a replicated 3 × 3 Latin square design with 3 grass-based dietary treatments consisting of 4, 13.5, and 23% gDDGS on a dry matter (DM) basis (L, M, and H, respectively) as a replacement for a concentrate mix. The concentrate mix consisted of soybean meal, canola cake, and beet pulp. Dry matter intake and energy-corrected milk yield were not affected by the proportion of gDDGS in the diet. Daily milk yield decreased with the H diet compared with the L and M diets. The percentage of fat in milk was higher when cows were fed the H diet compared with the L and M diets, whereas milk fat yield was not affected by dietary treatment. The M diet had a higher percentage of protein in milk compared with the L and H diets. Milk protein yield was similar for the L and M diets; however, it decreased for the H diet. Milk taste was not affected by the proportion of gDDGS in the diet or when milk was stored for 7 d. Linoleic acid and conjugated linoleic acid cis-9,trans-11 in milk increased with increasing proportion of gDDGS. To conclude, gDDGS can replace soybean meal and canola cake as a protein source in the diet of dairy cows. Up to 13.5% of the diet may consist of gDDGS without negatively affecting milk production, milk quality, or milk taste. When gDDGS represents 23% of dietary DM, milk production is reduced by 1.6 kg/d, whereas energy-corrected milk production is numerically reduced by 1 kg.","author_count":9,"contributors":["Gaillard, Charlotte","Sørensen, Martin Tang","Vestergaard, Mogens","Weisbjerg, Martin Riis","Basar, Md Abul","Larsen, Mette Krogh","Martinussen, Henrik","Kidmose, Ulla","Sehested, Jakob"],"cuid":["S01-000.00-142634"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Dairy cow","Dried distillers grains with solubles","Protein source","coproduct"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-SEGES"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-PR-SEGES","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"effect of substituting soybean meal and canola cake with grain based dried distillers grains with solubles as a protein source on feed intake milk production and milk quality in dairy cows","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"https://els-jbs-prod-cdn.literatumonline.com/pb/assets/raw/Health%20Advance/journals/jods/JDS_Instruct_for_Contributors_Policies-1528224208493.pdf","type":"loc","url":"https://pure.au.dk/ws/files/142783242/Effect_of_substituting_soybean_meal_and_canola_cake_with_grain_based_dried_distillers_grains_with_solubles_as_a_protein_source_on_feed_intake_milk_production_and_milk_quality_in_dairy_cows_AM.pdf","version":"Authors Final Version"},"id":"S01-000.00-142634","identifier":[{"id":"85027516612","type":"scopus"},{"id":"28822549","type":"pmid"}],"ids":["au-1707bed8-e18a-47c2-ae22-f18dc03121a5"],"keyword":["coproduct","dairy cow","dried distillers grains with solubles","protein source"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-1D70B99476816742398B65C2CCC7E3EF"],"oa_link":[{"access":"oa","license":"https://els-jbs-prod-cdn.literatumonline.com/pb/assets/raw/Health%20Advance/journals/jods/JDS_Instruct_for_Contributors_Policies-1528224208493.pdf","type":"loc","url":"https://pure.au.dk/ws/files/142783242/Effect_of_substituting_soybean_meal_and_canola_cake_with_grain_based_dried_distillers_grains_with_solubles_as_a_protein_source_on_feed_intake_milk_production_and_milk_quality_in_dairy_cows_AM.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Technical Sciences, Department of Animal and Veterinary Sciences, Department of Animal and Veterinary Sciences - ANIS Nutrition"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"seges innovation","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-SEGES","l3nn":"SEGES Innovation","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SEGES Innovation","namevar":["SEGES"],"nora_code":"DI-PR-SEGES","used":1}],"person":[{"affno":"","corresponding":null,"first":"Charlotte","key":"gaillardpau","last":"Gaillard","locid":"c0138828-4b44-4349-a0a0-084926bae930","name":"Gaillard, Charlotte","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Martin Tang","key":"sørensenpau","last":"Sørensen","locid":"fefc1862-587c-4b1f-9e20-694246b18221","name":"Sørensen, Martin Tang","orcid":"0000-0002-0523-4282","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mogens","key":"vestergaardpau","last":"Vestergaard","locid":"f886731d-42d7-485e-b44c-f48981a245e7","name":"Vestergaard, Mogens","orcid":"0000-0002-3630-1396","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Martin Riis","key":"weisbjergpau","last":"Weisbjerg","locid":"501c877c-de2b-4cd2-9f3c-42