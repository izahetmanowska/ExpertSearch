,"first":"M","key":"boyempau","last":"Boye","name":"Boye, M","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"S.","key":"rasmussensophiapau","last":"Rasmussen","locid":"ef51a5ef-7b63-460d-bc2b-2d98fd069f3f","name":"Rasmussen, Sophia","name_org":"Rasmussen, S.","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"S","key":"rasmussenspau","last":"Rasmussen","name":"Rasmussen, S","rank":5,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"F.","key":"granbergfpau","last":"Granberg","name":"Granberg, F.","rank":6,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"T K","key":"fischertkpau","last":"Fischer","name":"Fischer, T K","rank":7,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"S E","key":"midgleysepau","last":"Midgley","name":"Midgley, S E","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lasse Dam","key":"rasmussenlassedampau","last":"Rasmussen","locid":"a07c7150-071f-4568-b948-d11fffdaee98","name":"Rasmussen, Lasse Dam","rank":9,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"L D","key":"rasmussenldpau","last":"Rasmussen","name":"Rasmussen, L D","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ø.","key":"angenøysteinpau","last":"Angen","locid":"f852fd28-a6ec-441e-b6a8-65b5970c86d4","name":"Angen, Øystein","name_org":"Angen, Ø.","rank":10,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Ø","key":"angenøpau","last":"Angen","name":"Angen, Ø","rank":10,"rolecode":"pau"},{"affno":"4","first":"J. P.","key":"nielsenjenspeterpau","last":"Nielsen","locid":"e550301c-f89e-4a8b-bf34-e6fc3b76ff37","name":"Nielsen, Jens Peter","name_org":"Nielsen, J. P.","rank":11,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"J P","key":"nielsenjppau","last":"Nielsen","name":"Nielsen, J P","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sven Erik Lind","key":"jorsalsveneriklindpau","last":"Jorsal","locid":"4787cc8c-02f9-41fb-84de-11c1c8b680e3","name":"Jorsal, Sven Erik Lind","rank":12,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"S E","key":"jorsalsepau","last":"Jorsal","name":"Jorsal, S E","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"L. E.","key":"larsenlarserikpau","last":"Larsen","locid":"09c2a33d-b353-44de-a850-f3c7dec879cb","name":"Larsen, Lars Erik","name_org":"Larsen, L. E.","orcid":"0000-0003-0730-5555","rank":13,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"L E","key":"larsenlepau","last":"Larsen","name":"Larsen, L E","rank":13,"rolecode":"pau"}],"pmid":["29115952"],"pub":{"doi":"10.1186/s12917-017-1239-5","issn":["17466148"],"issue":"1","journal":"BMC Veterinary Research","pages":"315","paperid":"315","publisher":"BioMed Central","status":"p","title":"BMC Veterinary Research","title_org":"B M C Veterinary Research","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-85033401141"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Governmental Institutions","All Private Research","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Danish Agriculture & Food Council","Governmental Institutions","Private Research","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-8e34289c-9487-420f-8afe-782d47ecb4b8","dtu-56669d8e-1d27-4a65-a9c1-2ef9afe24bf0","ku-916f7e53-e75a-4d7e-817f-3c3078d39cc5"],"src":["AU Aarhus University","DTU Technical University of Denmark","KU University of Copenhagen"],"title":"No evidence of enteric viral involvement in the new neonatal porcine diarrhoea syndrome in Danish pigs","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-095.63-023025","year":"2017","yearsub":"2017"}
{"abstract":"Importance: In recent decades, the global rates of cesarean delivery have rapidly increased. Nonetheless, the influence of cesarean deliveries on surgical complications later in life has been understudied. Objective: To investigate whether previous cesarean delivery increases the risk of reoperation, perioperative and postoperative complications, and blood transfusion when undergoing a hysterectomy later in life. Design, Setting, and Participants: This registry-based cohort study used data from Danish nationwide registers on all women who gave birth for the first time between January 1, 1993, and December 31, 2012, and underwent a benign, nongravid hysterectomy between January 1, 1996, and December 31, 2012. The dates of this analysis were February 1 to June 30, 2016. Exposure: Cesarean delivery. Main Outcomes and Measures: Reoperation, perioperative and postoperative complications, and blood transfusion within 30 days of a hysterectomy. Results: Of the 7685 women (mean [SD] age, 40.0 [5.3] years) who met the inclusion criteria, 5267 (68.5%) had no previous cesarean delivery, 1694 (22.0%) had 1 cesarean delivery, and 724 (9.4%) had 2 or more cesarean deliveries. Among the 7685 included women, 3714 (48.3%) had an abdominal hysterectomy, 2513 (32.7%) had a vaginal hysterectomy, and 1458 (19.0%) had a laparoscopic hysterectomy. In total, 388 women (5.0%) had a reoperation within 30 days after a hysterectomy. Compared with women having vaginal deliveries, fully adjusted multivariable analysis showed that the adjusted odds ratio of reoperation for women having 1 previous cesarean delivery was 1.31 (95% CI, 1.03-1.68), and the adjusted odds ratio was 1.35 (95% CI, 0.96-1.91) for women having 2 or more cesarean deliveries. Perioperative and postoperative complications were reported in 934 women (12.2%) and were more frequent in women with previous cesarean deliveries, with adjusted odds ratios of 1.16 (95% CI, 0.98-1.37) for 1 cesarean delivery and 1.30 (95% CI, 1.02-1.65) for 2 or more cesarean deliveries. Blood transfusion was administered to 195 women (2.5%). Women having 2 or more cesarean deliveries had an adjusted odds ratio for receiving blood transfusion of 1.93 (95% CI, 1.21-3.07) compared with women having no previous cesarean delivery. Conclusions and Relevance: Women with at least 1 previous cesarean delivery face an increased risk of complications when undergoing a hysterectomy later in life. The results support policies and clinical efforts to prevent cesarean deliveries that are not medically indicated.","author_count":9,"contributors":["Lindquist, Anna Sofie Inger","Shah, Neel","Overgaard, Charlotte","Torp-Pedersen, Christian","Glavind, Karin","Larsen, Thomas","Plough, Avery","Galvin, Grace","Knudsen, Aage"],"cuid":["S01-000.00-084923"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Journal Article"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"association of previous cesarean delivery with surgical complications after a hysterectomy later in life","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=85027358688&partnerID=8YFLogxK","version":"Other Version"},"id":"S01-000.00-084923","identifier":[{"id":"85027358688","type":"scopus"},{"id":"000418463400014","type":"wos"},{"id":"28793157","type":"pmid"}],"ids":["aau-782aec09-4bf5-407f-851a-5d80cd9e84cc"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-C0F060C20978A5F7BD2F6D802538D358"],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Uni