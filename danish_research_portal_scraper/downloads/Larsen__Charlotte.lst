denheim","rank":12,"rolecode":"pau"},{"affno":"1","first":"Camilla","key":"uhrecamillapau","last":"Uhre","locid":"89091a25-b0d3-452d-b6a3-856f46110985","name":"Uhre, Camilla","rank":13,"rolecode":"pau"},{"affno":"1","first":"Nicoline Løcke Jepsen","key":"korsbjergnicolineløckejepsenpau","last":"Korsbjerg","name":"Korsbjerg, Nicoline Løcke Jepsen","rank":14,"rolecode":"pau"},{"affno":"1","first":"Christine Lykke","key":"thoustrupchristinelykkepau","last":"Thoustrup","locid":"43ea4e66-32f9-4492-8454-7e9879b0396b","name":"Thoustrup, Christine Lykke","rank":15,"rolecode":"pau"},{"affno":"2","first":"Julie","key":"hagstrømjuliepau","last":"Hagstrøm","name":"Hagstrøm, Julie","rank":16,"rolecode":"pau"},{"affno":"1","first":"Melanie","key":"rittermelaniepau","last":"Ritter","name":"Ritter, Melanie","rank":17,"rolecode":"pau"},{"affno":"6 2","corresponding":null,"first":"Kerstin Jessica","key":"plessenkerstinjessicapau","last":"Plessen","name":"Plessen, Kerstin Jessica","rank":18,"rolecode":"pau"},{"affno":"1","first":"Anne Katrine","key":"pagsbergannekatrinepau","last":"Pagsberg","locid":"1b86d747-470c-4a80-9670-762c84d64c09","name":"Pagsberg, Anne Katrine","rank":19,"rolecode":"pau"},{"affno":"2","first":"Nicole Nadine","key":"lønfeldtnicolenadinepau","last":"Lønfeldt","name":"Lønfeldt, Nicole Nadine","rank":20,"rolecode":"pau"}],"pmid":["39562644"],"pub":{"doi":"10.1038/s41598-024-80194-8","issn":["20452322"],"journal":"Scientific Reports","paperid":"28693","publisher":"Nature Publishing Group","status":"p","title":"Scientific Reports","volume":"14"},"review":"Peer Reviewed","scoID":["2-s2.0-85209777003"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-b4f4a75c-5fa6-450d-b708-37b1e5753007","ku-07194c14-2080-433e-abe6-2e1aaa34076d"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"The association between salivary oxytocin, age, and puberty in children with and without OCD","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-768413","year":"2024","yearsub":"2024"}
{"abstract":"Purpose: This study investigated patient perceptions of multidisciplinary chronic pain rehabilitation, including the occupational therapy lifestyle management program REVEAL(OT), on everyday life with chronic pain. Methods: Individual interviews were conducted using video conferencing after completing multidisciplinary chronic pain rehabilitation. The interviews followed a semi-structured interview guide and investigated patient experiences with occupational therapy-supported health behavior transformation. The interviews were transcribed verbatim and analyzed iteratively using an inductive semantic data-driven approach inspired by Braun & Clarke’s methodology. Results: Five females, 34 to 58 years old, revealed three common themes: To discover oneself anew; Increased energy and calmness; and Look into the future. The themes reflected transformations towards a healthier lifestyle through enhanced self-control, developing meaningful and secure everyday activities, and gaining reaffirmed dignity. The study also identified the participants’ need for professional assistance to cope with the pain after discharge. Conclusions: Chronic pain rehabilitation that included an occupational therapy intervention supported health behavior transformation and chronic pain self-management in females, where meaningful daily occupations and physical activity played an important role. Individually tailored support, also available after chronic pain rehabilitation, would benefit the transformation process towards improved pain coping in females.Implications for rehabilitation Personal gains for health and well-being may develop over a shorter or longer time after chronic pain rehabilitation. Targeting daily occupations and physical activity during chronic pain rehabilitation appears meaningful for females living with chronic pain. Progression from an individual to group approach can be relevant in planning chronic pain rehabilitation, but the individual capacities shall be considered. Male perspectives on chronic pain rehabilitation that includes focus on daily occupations and lifestyle need further investigation.","author_count":7,"contributors":["Nielsen, Svetlana Solgaard","Christensen, Jeanette Reffstrup","Søndergaard, Jens","Surrow, Signe","Larsen, Anette Enemark","Skou, Søren Thorgaard","Simonÿ, Charlotte"],"cuid":["S02-100.00-793630"],"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Nielsen, Svetlana Solgaard"],"keyword":["Chronic pain","Health Behavior","Pain Clinics","Pain Management","Pain rehabilitation","Program Evaluation","health nutrition and quality of life"],"level":"sci","mra":["hum","med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U","DI-UC"],"level3":{"OT":["Københavns Kommune"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"],"UC":["DI-UC-ALL","DI-UC-KP"]},"level3all":["DI-U-AU","DI-U-SDU","DI-UC-KP"]},"review":"pr","rtype":["clu"],"sorti":"it has changed my picture of myself how did females living with chronic pain perceive the impact of the standard pain rehabilitation including the occupational therapy lifestyle intervention reveal ot","src":["kp","sdu"],"src-code":["DI-U-SDU","DI-UC-KP"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/237171606/OA_SDU_Nielsen_2023.pdf","version":"Authors Final Version"},"funding_acknowledgement":["Dr Nielsen received funding for her PhD study from Region Zealand, Denmark; Naestved, Slagelse and Ringsted Hospitals\\u2019 Research Fund, Denmark (SJ-703); The University of Southern Denmark (Ph.D. scholarship for Svetlana S.Nielsen); and The Danish Occupational Therapy Association (reg. FF1-18-R76-A1690), and is currently funded by Region Zealand (Exercise First program). JRC is associate editor of the journal Frontiers in Occupational therapy and an academic editor of the Journal of Obesity and has received personal fees from Munksgaard and Gyldendal, both of which are outside the submitted work. She is the founder of the Danish Obesity Intervention Trial (DO:IT), a not-for profit initiative hosted at the University of Southern Denmark aiming at implementing clinical guidelines for persons with obesity in clinical practice. JS has participated in scientific advisory boards for Novo Nordic, Roche, Astra-Zeneca, GlaxoSmith Kline Pharma, he is editor for Promedicin.dk and holds grants from EU, the Danish Research council and numerous other funds. STS is associate editor of the Journal of Orthopaedic & Sports Physical Therapy and has received personal fees from Munksgaard and TrustMe-Ed, both of which are outside the submitted work. He is co-founder of Good Life with Osteoarthritis in Denmark (GLA:D\\u00AE), a not-for profit initiative hosted at the University of Southern Denmark aiming at implementing clinical guidelines for persons with osteoarthritis in clinical practice. Dr Skou is currently funded by Region Zealand (Exercise First program) and two grants within the European Union\\u2019s Horizon 2020 research and innovation program (MOBILIZE, grant agreement No 801790, of the European Research Council; and ESCAPE, grant agreement No 945377). This work was also supported by European Union\\u2019s Horizon 2020 research and innovation program, the European Research Council. We want to thank the participants of this study for their engagement and time spent in the interviews. We also appreciate the clinicians for supporting the intervention\\u2019s conduct."],"id":"S02-100.00-793630","identifier":[{"id":"85164590584","type":"scopus"},{"id":"37410586","type":"pmid"}],"ids":["kp-c85e9331-66b1-4c44-ab48-aeb82e380c7f","sdu-192d8bb4-cb22-4864-aa23-4704799292cb"],"keyword":["Chronic pain","health behavior","health, nutrition and quality of life","pain clinics","pain management","pain rehabilitation","program evaluation"],"lang":"English","level":"Scientific","mra":["Humanities","Medical Science"],"noi":["Global-Local-2-5-F16F43233C970ACD072EFA75FDC4EC70"],"oa_link":[{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/237171606/OA_SDU_Nielsen_2023.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Public Health, User Perspectives and Community-based Interventions","SDU, The Faculty of Health Sciences, Department of Regional Health Research","SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Næstved, Slagelse, Ringsted Hospitals (NSR)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University"],"nora_code":"DI-U-AU","used":1},{"affno":"3","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Københavns Kommune"],"nora_code":"DI-OT","used":1},{"affno":"4","key":"kp university college copenhagen","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-KP","l3nl":"KP","l3nn":"KP University College Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KP University College Copenhagen","namevar":["Københavns Professionshøjskole, Rektors område, Fakultet for sundhedsuddannelser - Dekan, Ergoterapeutuddannelsen","Sundhed for børn og voksne – Institut for Terapeut og Jordemoderuddannelser, Arbejdsliv - Bedre forebyggelse og behandling af skader og sygdomme der påvirker arbejdsevnen"],"nora_code":"DI-UC-KP","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Svetlana Solgaard","key":"nielsenpau","last":"Nielsen","locid":"8af11fa7-c3b5-4b92-b8c7-54cc4889b827","name":"Nielsen, Svetlana Solgaard","orcid":"0000-0002-3694-4236","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Jeanette Reffstrup","key":"christensenpau","last":"Christensen","locid":"7b0b955e-4090-479a-8bef-6fd6ad983680","name":"Christensen, Jeanette Reffstrup","orcid":"0000-0002-2412-5989","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens","key":"søndergaardpau","last":"Søndergaard","locid":"4829db0c-8486-4ad1-8e6b-d4f3dc56c386","name":"Søndergaard, Jens","orcid":"0000-0002-1629-1864","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Signe","key":"surrowpau","last":"Surrow","name":"Surrow, Signe","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Anette Enemark","key":"larsenpau","last":"Larsen","locid":"e38cf8d3-cebc-42ce-a154-3c1b5a175cf5","name":"Larsen, Anette Enemark","orcid":"0000-0003-1395-4156","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren T.","key":"skoupau","last":"Skou","locid":"656a59cf-32bc-4190-b072-4adf47d954c1","name":"Skou, Søren Thorgaard","name_org":"Skou, Søren T.","orcid":"0000-0003-4336-7059","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Charlotte","key":"simonÿpau","last":"Simonÿ","locid":"6c2dbf49-1a55-4aa3-a990-1549e39274dd","name":"Simonÿ, Charlotte","orcid":"0000-0003-1189-2967","rank":7,"rolecode":"pau"}],"pmid":["37410586"],"pub":{"doi":"10.1080/09638288.2023.2230127","issn":["09638288","14645165"],"issn_org":["09638288"],"issue":"13","journal":"Disability and Rehabilitation","pages":"2777-2788","publisher":"Informa Healthcare","status":"p","title":"Disability and Rehabilitation","volume":"46"},"review":"Peer Reviewed","scoID":["2-s2.0-85164590584"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","All University Colleges","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","KP","Miscellaneous","Other Research","Universities","University Colleges","University of Southern Denmark"],"PST":["Published"]},"sid":["kp-c85e9331-66b1-4c44-ab48-aeb82e380c7f","sdu-192d8bb4-cb22-4864-aa23-4704799292cb"],"src":["KP University College Copenhagen","SDU University of Southern Denmark"],"title":"\"It has changed my picture of myself\": how did females living with chronic pain perceive the impact of the standard pain rehabilitation, including the occupational therapy lifestyle intervention REVEAL(OT)?","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-793630","year":"2024","yearsub":"2024"}
{"abstract":"Age determination of marine mammals is important for understanding the impact of anthropogenic disturbances as well as for population management. Toothed whales are usually age-determined by counting annually formed layers in their teeth. This includes a time-consuming sequence of preparations, usually involving chemical treatment. This study tested a quicker and simpler method for age determination of harbour porpoises (Phocoena phocoena), originally developed for age determination of foxes and other terrestrial carnivores. The tooth was ground with fine-grained sandpaper, and the age lines were directly read using a binocular microscope. To evaluate the usability of the grinding method for harbour porpoises, three tests were used: (1) the number of growth layer groups (GLGs) in teeth from 66 harbour porpoises by the grinding method were compared by two readers; (2) GLGs in teeth from six harbour porpoises prepared by the grinding method and by the decalcification method were compared in a blinded set-up with two readers; and (3) the GLGs in teeth from two individuals with known ages prepared by both the grinding method and the decalcification method, respectively, were compared. A Bland–Altman plot showed high agreement between the determined age of individuals by the two different methods. The average age difference was -0.56 years, and the 95% confidence interval for the average difference was [-4.3, 3.2] years. The grinding method is therefore considered to be a valid alternative and quicker method for age determination of harbour porpoises.","author_count":8,"contributors":["Louise B., Henriksen","Bie Thøstesen, Charlotte","Alstrup, Aage Kristian Olsen","Larsen, Hanne Lyngholm","Wahlberg, Magnus","Siebert, Ursula","Pagh, Sussie"],"cuid":["S03-091.14-724319"],"filters":{"added":"2024-02","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"continent":["Europe, EU","OECD"],"corresponding_author":["Alstrup, Aage Kristian Olsen"],"country":["Germany"],"glorg":["All Global Affiliations","University of Veterinary Medicine Hannover","University of Veterinary Medicine Hannover, Foundation"],"keyword":["Demography","Mortality","Toothed whale","age methodology","counting growth layers","grinding teeth"],"level":"sci","mra":["med","sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"OT":["The Fisheries and Maritime Museum"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-CDR","DI-U-AAU","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"a new simple method for age determination of harbour porpoises phocoena phocoena","src":["aau","au","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85189432812","version":"Other Version"},"id":"S03-091.14-724319","identifier":[{"id":"85189432812","type":"scopus"}],"ids":["aau-b75d090d-d0da-4a2d-9ebe-594260347560","au-6a971eb8-ca45-4d36-a6c1-c0ccef07fb57","sdu-d265ff8a-f827-4a69-aea4-b7ec044cb08e"],"keyword":["age methodology","counting growth layers","demography","grinding teeth","mortality","toothed whale"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-C742A70FAD41403CABB0026993626C1E"],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Science, Department of Biology"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["The Fisheries and Maritime Museum"],"nora_code":"DI-OT","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Nuclear Medicine"],"nora_code":"DI-U-AU","used":1},{"affno":"4","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1},{"affno":"5","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience, Environmental Biology Monitoring","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience, Section for Bioscience and Engineering","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience, Section of Environmental Biomontoring"],"nora_code":"DI-U-AAU","used":1},{"affno":"6","country":"de","key":"university of veterinary medicine hannover foundation","loc":["Germany","Europe, EU","OECD"],"name":"University of Veterinary Medicine Hannover, Foundation","used":1},{"affno":"7","country":"de","key":"university of veterinary medicine hannover","loc":["Germany","Europe, EU","OECD"],"name":"University of Veterinary Medicine Hannover","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Louise B.","key":"henriksenpau","last":"Henriksen","locid":"79bb5e1e-280b-4642-93b2-b5fa5334c51d","name":"Henriksen, Louise Birgitte","name_org":"Henriksen, Louise B.","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Charlotte","key":"biethøstesenpau","last":"Bie Thøstesen","name":"Bie Thøstesen, Charlotte","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Charlotte Bie","key":"thøstesenpau","last":"Thøstesen","name":"Thøstesen, Charlotte Bie","rank":2,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"country":"dk","first":"Aage Kristian Olsen","key":"alstruppau","last":"Alstrup","locid":"fa66f5b8-0468-4e85-b570-969776c5ebde","name":"Alstrup, Aage Kristian Olsen","orcid":"0000-0002-0084-9122","rank":3,"rolecode":"pau"},{"affno":"5","corresponding":null,"country":"dk","first":"Hanne Lyngholm","key":"larsenpau","last":"Larsen","locid":"806cdba3-0da2-4ea7-a73c-e64bc45ce26b","name":"Larsen, Hanne Lyngholm","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Magnus","key":"wahlbergpau","last":"Wahlberg","locid":"753afa47-2a49-47fc-b23a-30f6b0a2bdb6","name":"Wahlberg, Magnus","orcid":"0000-0002-8239-5485","rank":5,"rolecode":"pau"},{"affno":"6 7","corresponding":null,"first":"Ursula","key":"siebertpau","last":"Siebert","name":"Siebert, Ursula","rank":6,"rolecode":"pau"},{"affno":"5","corresponding":null,"country":"dk","first":"Sussie","key":"paghpau","last":"Pagh","locid":"ebf3bb90-5d85-4380-8a86-1f5ff811c011","name":"Pagh, Sussie","orcid":"0000-0002-1574-3638","rank":7,"rolecode":"pau"}],"pub":{"doi":"10.1578/am.50.1.2024.30","issn":["01675427"],"issue":"1","journal":"Aquatic Mammals","pages":"30-38","publisher":"European Association for Aquatic Mammals","status":"p","title":"Aquatic Mammals","volume":"50"},"review":"Peer Reviewed","scoID":["2-s2.0-85189432812"],"