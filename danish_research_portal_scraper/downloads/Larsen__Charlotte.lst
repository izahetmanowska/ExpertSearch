{"abstract":"The experiment examined the effect of visual speaker gender on the vowel perception of 20 native Danish-speaking subjects. Auditory stimuli consisting of a continuum between /muːlə/ ‘muzzle’ and /moːlə/ ‘pier’ generated using TANDEM-STRAIGHT matched with video clips of a female and a male speaker were used to determine whether visual speaker gender affected Danish listeners similarly to American English-speaking listeners tested in a similar way.","author_count":3,"contributors":["Larsen, Charlotte","Tøndering, John"],"cuid":["S01-000.00-467368"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"visual speaker gender affects vowel identification in danish","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/55954597/Larsen_Tondering_Fonetik2013.pdf","version":"Pre-print"},"id":"S01-000.00-467368","ids":["ku-7b73f88b-65ac-461b-9eaa-458236af4038"],"lang":"English","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-84E5255AE4465D0A1A3C72803D50BAC9"],"oa_link":[{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/55954597/Larsen_Tondering_Fonetik2013.pdf","version":"Pre-print"}],"oai":{"class":"Realised","mra":["Humanities (HUM)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Charlotte","key":"larsenpau","last":"Lars