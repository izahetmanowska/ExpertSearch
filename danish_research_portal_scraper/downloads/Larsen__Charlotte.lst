{"abstract":"Udviklingen af BackTrace startede i 2019 og bygger på forskningsbaseret viden såvel som dialog med borgere og sundhedsprofessionelle. Visionen er at udvikle en digital løsning, som vil kunne understøtte bedre videndeling, bedre borgerinddragelse og skabe en sammenhængende brugeroplevelse for både borgere og sundhedsprofessionelle i tværsektorielle forløb for personer med lænderyglidelse.","author_count":11,"contributors":["Rossen, Camilla Blach","Jannsen, Bolette Emborg","Nørtoft, Mette","Jørgensen, Kristoffer Arildsen","Børsting, Kirstine Friis","Lund, Lea","Rolving, Nanna","Christiansen, Charlotte Ettrup","Thomsen, Morten"],"cuid":["S02-089.09-756056"],"filters":{"added":"2023-08","altsrc":["No Matches Found"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"level":"pop","mra":["hum","med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U","DI-UC"],"level3":{"U":["DI-U-ALL","DI-U-AU"],"UC":["DI-UC-ALL","DI-UC-VIA"]},"level3all":["DI-U-AU","DI-UC-VIA"]},"review":"und","rtype":["clu"],"sorti":"backtrace version 000000000000 000000000008 erfaringer fra pilotdrift","src":["au","via"],"src-code":["DI-U-AU","DI-UC-VIA"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://www.hospitalsenhedmidt.dk/contentassets/a70ec15c31534e4f87c0a1dc8c2a9428/backtrace-evalueringsrapport-2022-1.pdf","version":"Published Version"},"id":"S02-089.09-756056","ids":["au-97730848-aa2c-4fd2-89aa-9d0896cc502a","via-c5a70263-ef3b-4e7e-9bb5-1db2be0fdfd1"],"lang":"Danish","level":"Popular","mra":["Humanities","Medical Science"],"noi":["Local-1-2-FCC9FB7BEBC5F634FC84B7AF8533D3EE"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.fagperson.hospitalsenhedmidt.dk/siteassets/afdelinger/center-for-planlagt-kirurgi/gammel-side/forskningsenheden/backtrace/backtrace-evalueringsrapport-2022.pdf","version":"Other Version"},{"access":"oa","license":"Ikke-specificeret","