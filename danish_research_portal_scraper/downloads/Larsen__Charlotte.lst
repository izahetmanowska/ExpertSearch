name":"Callesen, H.","rank":12,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jacob Fog","key":"bentzonjacobfogpau","last":"Bentzon","locid":"b19cdb97-a953-43ff-ad51-19d0a680caed","name":"Bentzon, Jacob Fog","orcid":"0000-0002-3020-5002","rank":13,"rolecode":"pau"},{"affno":"","first":"J. F.","key":"bentzonjfpau","last":"Bentzon","name":"Bentzon, J. F.","rank":13,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Charlotte Brandt","key":"sørensencharlottebrandtpau","last":"Sørensen","locid":"14bfd3d1-a9b2-4bc5-823b-233432e43cf3","name":"Sørensen, Charlotte Brandt","orcid":"0000-0002-4469-8696","rank":14,"rolecode":"pau"},{"affno":"","first":"C. B.","key":"sorensencbpau","last":"Sorensen","name":"Sorensen, C. B.","rank":14,"rolecode":"pau"}],"pmid":["30128618"],"pub":{"doi":"10.1007/s11248-018-0086-x","issn":["09628819","15739368"],"issn_org":["09628819"],"issue":"5","journal":"Transgenic Research","pages":"484-484","publisher":"Springer Science and Business Media Deutschland GmbH","status":"p","title":"Transgenic Research","volume":"27"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-d511d42a-c927-4216-be81-db1bec21261c","dtu-5dd5f24e-9eaf-4270-be0a-5e58b2b64849","ku-277ab5d1-0d76-4dd0-8523-d1975da98d2d"],"src":["AU Aarhus University","DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Apolipoprotein E deficiency increases remnant lipoproteins and accelerates progressive atherosclerosis in Yucatan minipigs","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-096.12-028086","year":"2018","yearsub":"2018"}
{"abstract":"Objectives: New training modalities such as simulation are widely accepted in radiology; however, development of effective simulation-based training programs is challenging. They are often unstructured and based on convenience or coincidence. The study objective was to perform a nationwide needs assessment to identify and prioritize technical procedures that should be included in a simulation-based curriculum. Methods: A needs assessment using the Delphi method was completed among 91 key leaders in radiology. Round 1 identified technical procedures that radiologists should learn. Round 2 explored frequency of procedure, number of radiologists performing the procedure, risk and/or discomfort for patients, and feasibility for simulation. Round 3 was elimination and prioritization of procedures. Results: Response rates were 67 %, 70 % and 66 %, respectively. In Round 1, 22 technical procedures were included. Round 2 resulted in pre-prioritization of procedures. In round 3, 13 procedures were included in the final prioritized list. The three highly prioritized procedures were ultrasound-guided (US) histological biopsy and fine-needle aspiration, US-guided needle puncture and catheter drainage, and basic abdominal ultrasound. Conclusion: A needs assessment identified and prioritized 13 technical procedures to include in a simulation-based curriculum. The list may be used as guide for development of training programs. Key Points: • Simulation-based training can supplement training on patients in radiology.• Development of simulation-based training should follow a structured approach.• The CAMES Needs Assessment Formula explores needs for simulation training.• A national Delphi study identified and prioritized procedures suitable for simulation training.• The prioritized list serves as guide for development of courses in radiology.","author_count":8,"contributors":["Nayahangan, Leizl Joy","Nielsen, Kristina Rue","Albrecht-Beste, Elisabeth","Nielsen, Michael Bachmann","Paltved, Charlotte","Lindorff-Larsen, Karen Gilboe","Nielsen, Bjørn Ulrik","Konge, Lars"],"cuid":["S03-097.19-025485"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"corresponding_author":["Nayahangan, Leizl Joy"],"keyword":["Clinical Competence","Computer Simulation","Curriculum","Delphi Technique","Denmark","Education Medical Graduate methods","Humans","Journal Article","Needs Assessment","Needs Assessment organization administration","Patient Simulation","Radiology","Radiology education","Simulation Training","Ultrasonography Interventional standards","Ultrasonography standards"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-NDR","DI-HO-SDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-NDR","DI-HO-SDR","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"determining procedures for simulation based training in radiology a nationwide needs assessment","src":["au","ku","sdu"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85040245358","version":"Other Version"},"id":"S03-097.19-025485","identifier":[{"id":"85040245358","type":"scopus"},{"id":"29318426","type":"pmid"}],"ids":["au-b0030d04-c9e2-4223-8526-533d274dfe89","ku-ff613d82-fca2-4ee1-97e8-0a500a2083a5","sdu-e53f8b0d-9e9d-402b-afb0-413daf6b1ad5"],"keyword":["Clinical Competence","Computer Simulation","Curriculum","Delphi technique","Denmark","Education, Medical, Graduate/methods","Humans","Journal Article","Needs Assessment/organization & administration","Needs assessment","Patient Simulation","Radiology","Radiology/education","Simulation training","Ultrasonography, Interventional/standards","Ultrasonography/standards"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-3-7-89AFB4D5083A2FC78A11481F55876480"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen Academy for Medical Education and Simulation"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Radiology"],"nora_code":"DI-U-KU","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, HE Centre, HE Centre - Centre for Health Sciences Education"],"nora_code":"DI-U-AU","used":1},{"affno":"4","country":"dk","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University (AAU)"],"nora_code":"DI-U-AAU","used":1},{"affno":"5","country":"dk","key":"north denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-NDR","l3nl":"North Denmark Region","l3nn":"North Denmark Region","loc":["Denmark","Europe, EU","Nord