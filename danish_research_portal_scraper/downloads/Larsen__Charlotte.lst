":["Published"]},"sid":["ku-552cd45a-6956-48d2-a7d8-2f64e3644ba3"],"src":["KU University of Copenhagen"],"title":"Svindel og Humbug - Om at give rovtidsskrifterne igen med deres egen medicin","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-759884","year":"2019","yearsub":"2019"}
{"abstract":"Is it possible to manipulate the Altmetric score by using a social media echo chamber? Recently we came across something that triggered our curiosity. A university professor told us that she had created a series of social media profiles to inflate her Altmetric scores. Whenever publishing she herself would tweet and re-tweet the DOI of the publication and in this way enhance her own Altmetric performance. Following this, we made a small scale experiment. We encouraged our colleagues to tweet and re-tweet the DOI of a publication and found to our surprise that interest in this article spiraled out beyond our usual network, making a relatively inferior piece of work skyrocket towards the top 5% of all research outputs scored by Altmetric. To examine the pliability of altmetric scores in a structured way, we will write an editorial in a scientific journal encouraging readers to share the DOI of the editorial on various social media platforms. We will track the effect of this engineered social engagement on the Altmetric donut over time. We will then use this altmetric engagement pattern as a baseline for our next experiment, examining the effect of a social media echo chamber. We will create a new DOI with no text behind it on Zenodo and a series of artificial profiles mimicking the exact patterns identified in the first experiment. We will see to what extent we can attain equal or even higher altmetric scores. Finally, we will track whether the DOI has had actual social engagement or has only been mentioned within our echo chamber.","author_count":6,"contributors":["Deutz, Daniella Bayle","Vlachos, Evgenios","Drongstrup, Dorte","Larsen, Asger Væring","Dorch, Bertil","Wien, Charlotte"],"cuid":["S01-000.00-760572"],"filters":{"added":"2024-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"coloring in the altmetric donut","src":["ku"],"src-code":["DI-U-KU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/403567067/Coloring_in_the_Donut_9_October_2019_DB_Deutz.pdf","version":"Other Version"},"id":"S01-000.00-760572","ids":["ku-f890760f-4106-4122-b91a-b858b6abb433"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-8FF343F3542B997F4DF0A0ACD0CB5B06"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/403567067/Coloring_in_the_Donut_9_October_2019_DB_Deutz.pdf","version":"Other Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, External Centres, Det Kgl. Bibliotek - Universitetsbibliotekarens ledelsessekretariat"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Daniella Bayle","key":"deutzpau","last":"Deutz","name":"Deutz, Daniella Bayle","rank":1,"rolecode":"pau"},{"affno":"","first":"Evgenios","key":"vlachospau","last":"Vlachos","name":"Vlachos, Evgenios","rank":2,"rolecode":"pau"},{"affno":"","first":"Dorte","key":"drongstruppau","last":"Drongstrup","name":"Drongstrup, Dorte","rank":3,"rolecode":"pau"},{"affno":"1","first":"Asger Væring","key":"larsenpau","last":"Larsen","locid":"a3465b5e-1b9d-4c08-9fc3-9a9dfa287b40","name":"Larsen, Asger Væring","orcid":"0000-0002-9967-2637","rank":4,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Bertil F.","key":"dorchpau","last":"Dorch","locid":"c058289c-b917-464f-838c-4b8d9e1a69f7","name":"Dorch, Bertil","name_org":"Dorch, Bertil F.","rank":5,"rolecode":"pau"},{"affno":"","first":"Charlotte","key":"wienpau","last"