{"author_count":11,"contributors":["Hartby, Christina Marie","Andersen, Malene Rask","Kvisgaard, Lise Kirstine","Chriél, Mariann","Larsen, Lars Erik","Hjulsager, Charlotte Kristiane"],"cuid":["S01-000.00-360690"],"event":{"end":"2016-08-26","place":"Helsinki, fi","start":"2016-08-23","title":"11th International Fur Animal Scientific Association Congress","year":"2016"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"pooling of faecal samples for quantitative virus diagnostics by real time pcr","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/127426109/IFASA2016_Vol.40_1_.pdf","version":"Published Version"},"id":"S01-000.00-360690","ids":["dtu-bbc03b35-d7f5-42f5-8b5d-7ca5f009dc2d"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-9A4100B9B98A0D3EB526617B8BCC8E68"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/127426109/IFASA2016_Vol.40_1_.pdf","version":"Published Version"},{"access":"oa","type":"rem","url":"http://www.ifasanet.org/congress/2016/IFASA2016_Vol.40.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Veterinary Institute","Technical University of Denmark, National Veterinary Institute, Division for Diagnostics & Scientific Advice, Virology"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Christina Marie","key":"hartbypau","last":"Hartby","locid":"91d05451-70ef-459e-8781-4fa025583e88","name":"Hartby, Christina Marie","orcid":"0000-0003-2852-970X","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Malene Rask","key":"andersenpau","last":"Andersen","locid":"ce6a426a-d9ea-49f8-81c9-ecfaad79d315","name":"Andersen, Malene Rask","orcid":"0000-0001-7333-2653","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lise Kirstine","key":"kvisgaardpau","last":"Kvisgaard","locid":"58ce239f-6c30-44e0-ab54-f017a1821425","name":"Kvisgaard, Lise Kirstine","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mariann","key":"chriélpau","last":"Chriél","locid":"1a5d6261-6bd2-4940-baab-5d5fcc3c0f7c","name":"Chriél, Mariann","orcid":"0000-0001-5306-4495","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars Erik","key":"larsenpau","last":"Larsen","locid":"09c2a33d-b353-44de-a850-f3c7dec879cb","name":"Larsen, Lars Erik","orcid":"0000-0003-0730-5555","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Charlotte Kristiane","key":"hjulsagerpau","last":"Hjulsager","locid":"6c1511ef-8211-4653-8c81-cd55b7f63f64","name":"Hjulsager, Charlotte Kristiane","orcid":"0000-0001-7557-8876","rank":6,"rolecode":"pau"},{"affno":"","first":"Aske","key":"mäkitanilapedh","last":"Mäki-Tanila","name":"Mäki-Tanila, Aske","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Jarmo","key":"valajapedh","last":"Valaja","name":"Valaja, Jarmo","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Jaakko","key":"mononenpedh","last":"Mononen","name":"Mononen, Jaakko","rank":9,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Tarja","key":"sironenpedh","last":"Sironen","name":"Sironen, Tarja","rank":10,"role