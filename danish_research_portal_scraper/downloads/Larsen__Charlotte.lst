t":"Charlotte Held","key":"gotfredsenpau","last":"Gotfredsen","locid":"1cf4df84-2d0e-4693-bf47-e9932e3bf0e3","name":"Gotfredsen, Charlotte Held","orcid":"0000-0002-7386-119X","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rune Thorbjørn","key":"nordvangpau","last":"Nordvang","locid":"4a650e7d-8b75-469f-8e5e-cbc32ccf3e19","name":"Nordvang, Rune Thorbjørn","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anne S.","key":"meyerpau","last":"Meyer","locid":"1e9f4759-72d8-4d52-94ec-ce192ffca184","name":"Meyer, Anne S.","orcid":"0000-0001-8910-9931","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jørn Dalgaard","key":"mikkelsenpau","last":"Mikkelsen","locid":"2f591fc8-201a-4f5f-995d-fcdf0e095244","name":"Mikkelsen, Jørn Dalgaard","orcid":"0000-0003-0194-5789","rank":12,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.procbio.2013.10.023","issn":["13595113","18733298"],"issn_org":["13595113"],"issue":"2","journal":"Process Biochemistry","pages":"265-270","publisher":"Elsevier","status":"p","title":"Process Biochemistry","volume":"49"},"review":"Peer Reviewed","scoID":["2-s2.0-84895069393"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["dtu-b56e208e-a46c-4abe-b40d-675131d68dbe","sdu-af2a9830-37bd-4f6d-8960-303a7345e0ac"],"src":["DTU Technical University of Denmark","SDU University of Southern Denmark"],"title":"Biocatalytic production of 3′-sialyllactose by use of a modified sialidase with superior trans-sialidase activity","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.68-036707","year":"2014","yearsub":"2014"}
{"abstract":"BACKGROUND: It is important that patients are well-informed about risks and benefits of therapies to help them decide whether to accept medical therapy. Different numerical formats can be used in risk communication but It remains unclear how the different formats affect decisions made by real-life patients. AIM: To compare the impact of using Prolongation Of Life (POL) and Absolute Risk Reduction (ARR) information formats to express effectiveness of cholesterol-lowering therapy on patients' redemptions of statin prescriptions, and on patients' confidence in their decision and satisfaction with the risk communication. DESIGN AND SETTING: Cluster-randomised clinical trial in general practices. Thirty-four Danish GPs from 23 practices participated in a primary care-based clinical trial concerning use of quantitative effectiveness formats for risk communication in health prevention consultations. METHOD: GPs were cluster-randomised (treating practices as clusters) to inform patients about cardiovascular mortality risk and the effectiveness of statin treatment using either POL or ARR formats. Patients' redemptions of statin prescriptions were obtained from a regional prescription database. The COMRADE questionnaire was used to measure patients' confidence in their decision and satisfaction with the risk communication. RESULTS: Of the 240 patients included for analyses, 112 were allocated to POL information and 128 to ARR. Patients redeeming a statin prescription totalled six (5.4%) when informed using POL, and 32 (25.0%) when using ARR. The level of confidence in decision and satisfaction with risk communication did not differ between the risk formats. CONCLUSION: Patients redeemed statin prescriptions less often when their GP communicated treatment effectiveness using POL compared with ARR.","author_count":9,"contributors":["Harmsen, Charlotte Gry","Kristiansen, Ivar Sønbø","Larsen, Pia Veldt","Nexøe, Jørgen","Støvring, Henrik","Gyrd-Hansen, Dorte","Nielsen, Jesper Bo","Edwards, Adrian","Jarbøl, Dorte Ejg"],"cuid":["S02-100.00-016653"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Cardiovascular disease","Decision making","General practice","Patient Participation","Risk Assessment","Risk communication"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"communicating risk using absolute risk reduction or prolongation of life formats cluster randomised trial in general practice","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3399/bjgp14X677824","version":"Other Version"},"id":"S02-100.00-016653","identifier":[{"id":"PMC3964454","type":"pmcid"},{"id":"24686884","type":"pmid"},{"id":"84898728989","type":"scopus"}],"ids":["au-36fe1d0b-da6b-44ce-9533-fb2c023e06e0","sdu-f29921a7-1439-43dd-88c0-df8daeb3ddee"],"keyword":["Cardiovascular disease","Decision making","General practice","Patient participation","Risk assessment","Risk communication"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-E2627E48C0967C904CF980BABC7C9E23"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.3399/bjgp14X677824","version":"Other Version"}],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Public Health, Research Unit of General Pratice"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Public Health, Department of Public Health - Department of Biostatistics"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Charlotte Gry","key":"harmsenpau","last":"Harmsen","locid":"90a39c48-5b46-4168-bde9-f9b50f1aa516","name":"Harmsen, Charlotte Gry","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Ivar Sønbø","key":"kristiansenpau","last":"Kristiansen","name":"Kristiansen, Ivar Sønbø","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Pia Veldt","key":"larsenpau","last":"Larsen","locid":"d6c16700-b7c7-4172-a8df-3e726624dc36","name":"Larsen, Pia Veldt","orcid":"0000-0002-8730-3703","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jørgen","key":"nexøepau","last":"Nexøe","locid":"c0ef955d-56da-4dd2-b269-235028a380fa","name":"Nexøe, Jørgen","orcid":"0000-0002-3806-5139","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Henrik","key":"støvringpau","last":"Støvring","locid":"c19fb430-dcd1-4a13-995f-4247f8ebc11d","name":"Støvring, Henrik","orcid":"0000-0002-5821-2351","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Dorte","key":"gyrdhansenpau","last":"Gyrd-Hansen","name":"Gyrd-Hansen, Dorte","orcid":"0000-0003-1137-2304","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jesper Bo","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Jesper Bo","orcid":"0000-0002-5764-5462","rank":7,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Adrian","key":"edwardspau","last":"Edwards","name":"Edwards, Adrian","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Dort