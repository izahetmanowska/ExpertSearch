:"AU Aarhus University","namevar":["Aarhus University, Health, Department of Public Health"],"nora_code":"DI-U-AU","used":1},{"affno":"4","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["CFK - Folkesundhed og Kvalitetsudvikling, Region Midtjylland"],"nora_code":"DI-HO-CDR","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Charlotte Louise","key":"haaberpettersenpau","last":"Haaber Pettersen","locid":"6145b00b-6450-474a-b1e1-78224748b9cc","name":"Haaber Pettersen, Charlotte Louise","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Eva Ladekjær","key":"larsenpau","last":"Larsen","locid":"d8cdbc64-7939-4ef4-8f04-94bad4b52397","name":"Larsen, Eva Ladekjær","orcid":"0000-0002-8663-6047","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Janne","key":"skakonpau","last":"Skakon","name":"Skakon, Janne","rank":3,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Merete","key":"labriolapau","last":"Labriola","locid":"6fe9ccaf-d3e1-48eb-9b28-581200e407ea","name":"Labriola, Merete","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-56f22439-a3ee-4168-91f4-93d0b0a5fb32","sdu-9f0003d0-e918-4092-bb12-38670ffb4aa0"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Implementering af Region Syddanmarks ‘Kom-godt tilbage-modellen’. Dialog mellem leder og medarbejder efter langtidssygemelding","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-018989","yea