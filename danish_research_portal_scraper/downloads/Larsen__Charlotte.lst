945899/A_Latent_Class_Analysis_of_Multimorbidity.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pone.0169426","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, DEFACTUM"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["DEFACTUM"],"nora_code":"DI-HO-CDR","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["National Hospital of Denmark"],"nora_code":"DI-HO-CAP","used":1},{"affno":"4","country":"dk","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["University of Southern Denmark (SDU)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Finn Breinholt","key":"larsenpau","last":"Larsen","locid":"bee6772d-1940-4d39-b53b-dc3a5cf79d98","name":"Larsen, Finn Breinholt","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Marie Hauge","key":"pedersenpau","last":"Pedersen","locid":"f209c716-5d02-497d-bbc9-d9deb2c6a3a7","name":"Pedersen, Marie Hauge","orcid":"0000-0001-8472-0555","rank":2,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Karina","key":"friispau","last":"Friis","locid":"c15948f4-6fe7-4108-bdd4-78babe4b9da8","name":"Friis, Karina","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Charlotte","key":"glümerpau","last":"Glümer","name":"Glümer, Charlotte","rank":4,"rolecode":"pau"},{"affno":"1 4 2","corresponding":null,"first":"Mathias","key":"lasgaardpau","last":"Lasgaard","locid":"97fc1c16-822e-4559-9a80-39e2ca784964","name":"Lasgaard, Mathias","orcid":"0000-0001-5808-8883","rank":5,"rolecode":"pau"}],"pmid":["28056050"],"pub":{"doi":"10.1371/journal.pone.0169426","issn":["19326203"],"issue":"1","journal":"PLOS ONE","paperid":"0169426","publisher":"Public Library of Science","status":"p","title":"PLOS ONE","title_org":"P L o S One","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-85008601692"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-e52c98b7-7dbf-4b4f-a014-94e0c3a2ef4e","sdu-2ce7af40-de9b-4cfd-abfb-806e23f2339b"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"A Latent Class Analysis of Multimorbidity and the Relationship to Socio-Demographic Factors and Health-Related Quality of Life. A National Population-Based Study of 162,283 Danish Adults","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-089.26-029278","year":"2017","yearsub":"2017"}
{"abstract":"Maximal fat oxidation (MFO) and the exercise intensity that elicits MFO (FatMax) are commonly determined by indirect calorimetry during graded exercise tests in both obese and normal-weight individuals. However, no protocol has been validated in individuals with obesity. Thus, the aims were to develop a graded exercise protocol for determination of FatMax in individuals with obesity, and to test validity and inter-method reliability. Fat oxidation was assessed over a range of exercise intensities in 16 individuals (age: 28 (26-29) years; body mass index: 36 (35-38) kg·m-2; 95% confidence interval) on a cycle ergometer. The graded exercise protocol was validated against a short continuous exercise (SCE) protocol, in which FatMax was determined from fat oxidation at rest and during 10 min of continuous exercise at 35%, 50%, and 65% of maximal oxygen uptake. Intraclass and Pearson correlation coefficients between the protocols were 0.75 and 0.72 and within-subject coefficient of variation (CV) was 5 (3-7)%. A Bland-Altman plot revealed a bias of -3% points of maximal oxygen uptake (limits of agreement: -12 to 7). A tendency towards a systematic difference (p = 0.06) was observed, where FatMax occurred at 42 (40-44)% and 45 (43-47)% of maximal oxygen uptake with the graded and the SCE protocol, respectively. In conclusion, there was a high-excellent correlation and a low CV between the 2 protocols, suggesting that the graded exercise protocol has a high inter-method reliability. However, considerable intra-individual variation and a trend towards systematic difference between the protocols reveal that further optimization of the graded exercise protocol is needed to improve validity.","author_count":8,"contributors":["Dandanell, Sune","Præst, Charlotte Boslev","Søndergård, Stine D","Skovborg, Camilla","Dela, Flemming","Larsen, Steen","Helge, Jørn Wulff"],"cuid":["S02-096.00-038923"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Adult","Bicycling","Body Mass Index","Comparative Study","Energy Metabolism","Ergometry","Exercise","Fatty Acids Nonesterified","Female","Glycerol","Humans","Journal Article","Lipid Metabolism","Lipolysis","Male","Obesity","Oxidation Reduction","Oxygen Consumption","Physical Exertion","Reproducibility of Results","Retrospective Studies","Sex Characteristics","Validation Studies"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U","DI-UC"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"],"UC":["DI-UC-ALL","DI-UC-KP"]},"level3all":["DI-HO-CAP","DI-U-KU","DI-UC-KP"]},"review":"pr","rtype":["clu"],"sorti":"determination of the exercise intensity that elicits maximal fat oxidation in individuals with obesity","src":["kp","ku"],"src-code":["DI-U-KU","DI-UC-KP"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85016503166","version":"Other Version"},"id":"S02-096.00-038923","identifier":[{"id":"28177732","type":"pmid"},{"id":"85016503166","type":"scopus"}],"ids":["kp-62998054-8809-4250-ac39-40ad95c11fe7","ku-4bfafdd2-f107-42c5-980e-27e722821c53"],"keyword":["Adult","Bicycling","Body Mass Index","Comparative Study","Energy Metabolism","Ergometry","Exercise","Fatty Acids, Nonesterified","Female","Glycerol","Humans","Journal Article","Lipid Metabolism","Lipolysis","Male","Obesity","Oxidation-Reduction","Oxygen Consumption","Physical Exertion","Reproducibility of Results","Retrospective Studies","Sex Characteristics","Validation Studies"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-1F6E2765496034388F3E0AA49F872249"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"Univer