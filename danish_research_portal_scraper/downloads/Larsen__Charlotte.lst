ovborg","locid":"db1d1d96-f6de-4af4-834d-58a3c29d50b5","name":"Skovborg, Camilla","rank":4,"rolecode":"pau"},{"affno":"1 3","first":"Flemming","key":"delapau","last":"Dela","locid":"5d84458e-34c1-4874-a128-7fc3cb13f7f2","name":"Dela, Flemming","orcid":"0000-0001-9970-9535","rank":5,"rolecode":"pau"},{"affno":"1","first":"Steen","key":"larsenpau","last":"Larsen","locid":"d4c64c4e-1edf-41cf-890e-aba81d9e35f7","name":"Larsen, Steen","orcid":"0000-0002-5170-4337","rank":6,"rolecode":"pau"},{"affno":"1","first":"Jørn Wulff","key":"helgepau","last":"Helge","locid":"a5560afa-4f31-4278-8ae9-0c49fb0027c1","name":"Helge, Jørn Wulff","orcid":"0000-0001-9724-5423","rank":7,"rolecode":"pau"}],"pmid":["28177732"],"pub":{"doi":"10.1139/apnm-2016-0518","issn":["17155312","17155320"],"issn_org":["17155312"],"issue":"4","journal":"Applied Physiology, Nutrition and Metabolism","pages":"405-412","publisher":"National Research Council of Canada","status":"p","title":"Applied Physiology, Nutrition and Metabolism","volume":"42"},"review":"Peer Reviewed","scoID":["2-s2.0-85016503166"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","All University Colleges","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","Hospitals","KP","Universities","University Colleges","University of Copenhagen"],"PST":["Published"]},"sid":["kp-62998054-8809-4250-ac39-40ad95c11fe7","ku-4bfafdd2-f107-42c5-980e-27e722821c53"],"src":["KP University College Copenhagen","KU University of Copenhagen"],"title":"Determination of the exercise intensity that elicits maximal fat oxidation in individuals with obesity","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-096.00-038923","year":"2017","yearsub":"2017"}
{"abstract":"Background Psychological stress is associated with increased risk of acute cardiovascular diseases, as myocardial infarction. We recently found a higher risk of atrial fibrillation following an acute stressful life event, but it remains unknown whether this also applies to common and less acute stress exposures. Methods We investigated the risk of incident atrial fibrillation in people with high levels of perceived stress by following a population-based cohort of 114,337 participants from the Danish National Health Survey from 2010 to 2014. The survey holds information on lifestyle factors and perceived stress measured by Cohen's 10-item Perceived Stress Scale (PSS). We obtained information on atrial fibrillation, comorbidities and socioeconomic status from Danish nationwide registers. We identified 2172 persons with a first episode of atrial fibrillation during 424,839 person-years of follow-up. The hazard ratio (HR) of atrial fibrillation with 95% confidence interval (CI) was calculated with Cox proportional hazard model. Results The risk of atrial fibrillation increased with increasing PSS score; persons in the highest perceived stress quintile had 28% (95% CI, 12%-46%) higher risk of atrial fibrillation compared with persons in the lowest perceived stress quintile. However, the association disappeared when adjusting for comorbidities, socioeconomic status and lifestyle factors; HR was 1.01 (95% CI, 0.88-1.16) when comparing persons in the highest and the lowest perceived stress quintile. Conclusions This large population-based cohort study did not reveal a higher risk of atrial fibrillation among persons with a high degree of perceived stress after adjustment for participants' baseline characteristics.","author_count":7,"contributors":["Graff, Simon","Prior, Anders","Fenger-Grøn, Morten","Christensen, Bo","Glümer, Charlotte","Larsen, Finn Breinholt","Vestergaard, Mogens"],"cuid":["S02-100.00-000934"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Graff, Simon"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-HO-CDR","DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"does perceived stress increase the risk of atrial fibrillation a population based cohort study in denmark","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85015841694","version":"Other Version"},"id":"S02-100.00-000934","identifier":[{"id":"85015841694","type":"scopus"},{"id":"28577678","type":"pmid"},{"id":"000403197800004","type":"wos"}],"ids":["aau-11ec6376-204a-4c2b-b514-58677f864af1","au-9d72d955-f1ee-4b10-ac0c-73e84efc12d3"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-A98FDEE737C72040081E38F03610AE4E"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Public Health, Department of Public Health - Forskningsenheden for Almen Praksis"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology","Aalborg University, The Faculty of Medicine, De