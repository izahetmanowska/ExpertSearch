randstrup","orcid":"0000-0002-9285-3099","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Durita Lyngsø","key":"svartápau","last":"Svartá","locid":"7d14a946-3c39-479f-9e88-0b5c3061f8e5","name":"Svartá, Durita Lyngsø","orcid":"0000-0002-8931-8386","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peter","key":"bjerregaardpau","last":"Bjerregaard","locid":"ef4a2fa7-9735-4b1e-a4fa-b1272def2cfc","name":"Bjerregaard, Peter","orcid":"0000-0001-7153-8447","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ingelise","key":"olesenpau","last":"Olesen","locid":"9c041339-f1ff-4dc1-ac52-077f3f6349c4","name":"Olesen, Ingelise","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Christina Viskum Lytken","key":"larsenpau","last":"Larsen","locid":"3ee738b1-09d1-4886-9ddf-67ca132997fe","name":"Larsen, Christina Viskum Lytken","orcid":"0000-0002-6245-4222","rank":5,"rolecode":"pau"}],"pub":{"pages":"46","publisher":"Syddansk Universitet. Statens Institut for Folkesundhed","status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-290f8003-1c0b-414a-a831-4fc15aec20e0"],"src":["SDU University of Southern Denmark"],"title":"Kommunal sundhedsprofil - Kommune Kujalleq : Befolkningsundersøgelsen i Grønland 2018","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-584986","year":"2021","yearsub":"2021"}
{"abstract":"With this paper we present the first – to our knowledge – systematic review on how to use Educational Robotics to foster girls’ interest in STEM. This is a research area essential to broadening the participation across the genders in the much-needed STEM workforce, whose size is currently held back by a significant gender disparity. In the review, 13 (quasi-)experimental studies were selected for synthesis, from a total of 1093 results found across multiple search queries applied to six scientific databases. When synthesizing the results and findings from the included studies, four major categories of research interest were identified. On the basis hereof, a list of recommendations, which are readily implementable in most curriculums for both compulsory education and extracurricular activities, was established. The recommendations revolve around: The choice of technology, applied contextualization, approaches to teaching, and gender compositions. In addition, we discuss the current extent of research on the topic, which shows indications of becoming more active in recent years, while likewise discussing the reviews implications for future research directions.","author_count":4,"contributors":["Pedersen, B.","Weigelin, Bente Charlotte","Larsen, Jørgen Christian","Nielsen, Jacob"],"cuid":["S01-000.00-589779"],"event":{"end":"2021-08-12","place":"Virtual, Vancouver, ca","start":"2021-08-08","title":"30th IEEE International Conference on Robot and Human Interactive Communication, RO-MAN 2021","year":"2021"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Pedersen, B."],"keyword":["Educational robots","STEM"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"using educational robotics to foster girls interest in stem a systematic review","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85115064391","version":"Other Version"},"id":"S01-000.00-589779","identifier":[{"id":"85115064391","type":"scopus"}],"ids":["sdu-39e31c66-b763-42fa-bc5a-f4becddf2fba"],"keyword":["Educational Robots","STEM"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-D386B35A7C2CC8ED537DD1D794DE26A9"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Engineering, The Maersk Mc-Kinney Moller Institute"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"B.","key":"pedersenpau","last":"Pedersen","locid":"b4c386eb-7dcb-4b16-95a2-829a571e25a1","name":"Pedersen, B.","orcid":"0000-0002-6870-4085","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Bente","key":"weigelinpau","last":"Weigelin","locid":"e8e659cc-c764-47c4-bd0d-dc7ffe3e682f","name":"Weigelin, Bente Charlotte","name_org":"Weigelin, Bente","orcid":"0000-0003-3892-4834","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jørgen","key":"larsenpau","last":"Larsen","locid":"7360ab40-7502-495e-9745-33ad27e0e1cd","name":"Larsen, Jørgen Christian","name_org":"Larsen, Jørgen","orcid":"0000-0002-4741-8290","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jacob","key":"nielsenpau","last":"Nielsen","locid":"bfca7bf8-41f7-4f6d-af41-38b9d20dbb8a","name":"Nielsen, Jacob","orcid":"0000-0002-5134-8950","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1109/ro-man50785.2021.9515538","eisbn":["9781665404921"],"issn":["19449445"],"pages":"865-872","publisher":"IEEE","series":"Proceedings - IEEE International Workshop on Robot and Human Communication","status":"p","title":"2021 30th IEEE International Conference on Robot &amp; Human Interactive Communication (RO-MAN)"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-39e31c66-b763-42fa-bc5a-f4becddf2fba"],"src":["SDU University of Southern Denmark"],"title":"Using educational robotics to foster girls’ interest in STEM : A systematic review","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-589779","year":"2021","yearsub":"2021"}
{"abstract":"BACKGROUND: Sufficient fetal fraction (FF) is crucial for quality control of NIPT (Non-Invasive Prenatal Test) results. Different factors influencing bioinformatic estimation of FF should be considered when implementing NIPT. To what extent the total number of sequencing reads influences FF estimate has been unexplored. In this study, to test the robustness of SeqFF FF estimation and provide additional recommendations for NIPT analysis quality control, we compared the SeqFF FF estimates with two other methods and investigated how the number of sequencing reads and FF level affects the accuracy and precision of FF estimates. METHODS: WGS data of 516 NIPT samples from a prenatal screening program was obtained. Sample data were randomly downsampled by the read count, and FF was calculated by SeqFF software. Then, the outcome was compared with FF estimates from SNP- and chrY-based methods. FF estimated with different read counts and FF levels were compared with FF at 30 M reads as a reference. RESULTS: SeqFF FF highly correlates with SNP- and chrY-based FF estimates. Raising read count from 2 M to 10 M drastically increased the accuracy of FF estimates. After adding more reads, we saw a further improvement in FF accuracy, reaching a plateau at 20 M reads. Precision of SeqFF FF estimate is independent of FF level in the sample. CONCLUSION: SeqFF is a robust method for FF estimation for both genders and for any FF level in range 2-13%. Accuracy of FF estimates highly depends on the read count. We recommend using no less than 10 M reads to achieve accurate FF estimates for NIPT analysis in clinical settings.","author_count":4,"contributors":["Miceikaite, Ieva","Brasch-Andersen, Charlotte","Fagerberg, Christina","Larsen, Martin Jakob"],"cuid":["S01-000.00-626851"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Miceikaite, Ieva"],"keyword":["Cell free DNA","NGS","NIPT","Prenatal Diagnosis","fetal fraction"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"total number of reads affects the accuracy of fetal fraction estimates in nipt","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1002/mgg3.1653","version":"Published Version"},"id":"S01-000.00-626851","identifier":[{"id":"PMC8123752","type":"pmcid"},{"id":"85102186359","type":"scopus"},{"id":"33687149","type":"pmid"}],"ids":["sdu-bb205b87-c5ee-4aec-9510-6625d2513aa4"],"keyword":["Cell-free DNA","NGS","NIPT","circulating fetal DNA","fetal fraction","prenatal diagnosis"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-081CB932A7676815F8897AC09DB4F5D5"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1002/mgg3.1653","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/182803865/mgg3.1653.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Clinical Genetics (Odense)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Ieva","key":"miceikaitėpau","last":"Miceikaitė","locid":"eb4ddff7-556f-465a-87af-2d89e65de326","name":"Miceikaite, Ieva","name_org":"Miceikaitė, Ieva","orcid":"0000-0002-5188-7647","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Charlotte","key":"braschandersenpau","last":"Brasch-Andersen","locid":"3fe4d15d-5f04-4ec0-87b8-000b5f993ed1","name":"Brasch-Andersen, Charlotte","orcid":"0000-0003-4273-0047","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christina","key":"fagerbergpau","last":"Fagerberg","locid":"93aebc29-7681-4e3d-b613-867bd3a7eb65","name":"Fagerberg, Christina","orcid":"0000-0002-5206-4327","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Martin Jakob","key":"larsenpau","last":"Larsen","locid":"7cfc93bc-88f4-48fa-86de-6b0147dc2825","name":"Larsen, Martin Jakob","orcid":"0000-0003-4107-8771","rank":4,"rolecode":"pau"}],"pmid":["33687149"],"pub":{"doi":"10.1002/mgg3.1653","issn":["23249269"],"issue":"4","journal":"Molecular Genetics & Genomic Medicine","paperid":"e1653","publisher":"Wiley","status":"p","title":"Molecular Genetics & Genomic Medicine","volume":"9"},"review":"Peer Reviewed","scoID":["2-s2.0-85102186359"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-bb205b87-c5ee-4aec-9510-6625d2513aa4"],"src":["SDU University of Southern Denmark"],"title":"Total number of reads affects the accuracy of fetal fraction estimates in NIPT","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-626851","year":"2021","yearsub":"2021"}
{"abstract":"Aims: This study aims to investigate the association between household crowding and household composition and self-rated health and mental health (GHQ scale) among the Inuit in Greenland. Poor housing conditions are a concern in Greenland, especially in the villages, where socioeconomic standards in general are lower. Methods: A cohort of 1282 adults participated in two population-based surveys in Greenland, the Inuit Health in Transition survey 2005–2010 (baseline) and The Health Survey in Greenland 2014 (follow-up). Associations between household conditions at baseline and health outcomes at follow-up (poor self-rated health and mental health measured by the GHQ scale) were examined using logistic regression models, adjusting for covariates at baseline. Results: Participants living in an overcrowded dwelling (more than one person per room) at baseline were more likely to report poor self-rated health at follow-up (OR 1.47; 95% CI 1.09; 1.99) compared with those not living in an overcrowded dwelling. In addition, participants who lived alone at baseline were more likely (OR 1.98; 95% CI 1.09; 3.58) to experience poor mental health at follow-up compared with those who lived with children. Conclusions: Results indicate that household conditions are related to health in Greenland. Public health authorities should work to ensure affordable housing of good quality in all communities.","author_count":4,"contributors":["Ottendahl, Charlotte Brandstrup","Larsen, Christina Viskum Lytken","Bjerregaard, Peter","Riva, Mylene"],"cuid":["S01-000.00-643687"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","Nordic","OECD"],"corresponding_author":["Ottendahl, Charlotte Brandstrup"],"country":["Canada","Greenland"],"glorg":["All Global Affiliations","Grønlands Universitet","McGill University"],"keyword":["Adult","Child","Crowding","Family Characteristics","Greenland","Greenland epidemiology","Health Surveys","Household composition","Humans","Indigenous health","Inuits","Mental health","Self rated health"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"the effect of household crowding and composition on health in an inuit cohort in greenland","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/171027305/Manuskript_til_Pure.pdf","version":"Authors Final Version"},"id":"S01-000.00-643687","identifier":[{"id":"85086049399","type":"scopus"},{"id":"32508246","type":"pmid"}],"ids":["sdu-f65a1aad-7560-46da-bcd9-60fb4e559cdc"],"keyword":["Adult","Child","Family Characteristics","Greenland","Greenland/epidemiology","Health Surveys","Humans","Indigenous health","Inuits","crowding","household composition","mental health","self-rated health"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-C761BB0A5B4C80F40F883A0430D004B4"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/171027305/Manuskript_til_Pure.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, National Institute of Public Health","SDU, The Faculty of Health Sciences, National Institute of Public Health, Center for Public health in Greenland","SDU, The Faculty of Health Sciences, National Institute of Public Health, Department of Population Health and Morbidity"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"gl","key":"grønlands universitet","loc":["Greenland","Nordic"],"name":"Grønlands Universitet","used":1},{"affno":"3","country":"ca","key":"mcgill university","loc":["Canada","America, North","OECD"],"name":"McGill University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Charlotte B.","key":"hansenpau","last":"Hansen","locid":"9e2ae085-ebf8-4688-b8cf-c257c5458aca","name":"Ottendahl, Charlotte Brandstrup","name_org":"Hansen, Charlotte B.","orcid":"0000-0002-9285-3099","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"first":"Christina V.L.","key":"larsenpau","last":"Larsen","locid":"3ee738b1-09d1-4886-9ddf-67ca132997fe","name":"Larsen, Christina Viskum Lytken","name_org":"Larsen, Christina V.L.","orcid":"0000-0002-6245-4222","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter","key":"bjerregaardpau","last":"Bjerregaard","locid":"ef4a2fa7-9735-4b1e-a4fa-b1272def2cfc","name":"Bjerregaard, Peter","orcid":"0000-0001-7153-8447","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Mylene","key":"rivapau","last":"Riva","name":"Riva, Mylene","rank":4,"rolecode":"pau"}],"pmid":["32508246"],"pub":{"doi":"10.1177/1403494820929496","issn":["14034948","16511905"],"issn_org":["14034948"],"issue":"8","journal":"Scandinavian Journal of Public Health","pages":"921-930","publisher":"SAGE Publications","status":"p","title":"Scandinavian Journal of Public Health","volume":"49"},"review":"Peer Reviewed","scoID":["2-s2.0-85086049399"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-f65a1aad-7560-46da-bcd9-60fb4e559cdc"],"src":["SDU University of Southern Denmark"],"title":"The effect of household crowding and composition on health in an Inuit cohort in Greenland","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-643687","year":"2021","yearsub":"2021"}
{"abstract":"BACKGROUND: The Danish Neuro Oncology Group (DNOG) has established national consensus guidelines for the delineation of organs at risk (OAR) structures based on published literature. This study was conducted to finalise these guidelines and evaluate the inter-observer variability of the delineated OAR structures by expert observers. MATERIAL AND METHODS: The DNOG delineation guidelines were formed by participants from all Danish centres that treat brain tumours with radiotherapy. In a two-day workshop, guidelines were discussed and finalised based on a pilot study. Following this, the ten participants contoured the following OARs on T1-weighted gadolinium enhanced MRI from 13 patients with brain tumours: optic tracts, optic nerves, chiasm, spinal cord, brainstem, pituitary gland and hippocampus. The metrics used for comparison were the Dice similarity coefficient (Dice), mean surface distance (MSD) and others. RESULTS: A total of 968 contours were delineated across the 13 patients. On average eight (range six to nine) individual contour sets were made per patient. Good agreement was found across all structures with a median MSD below 1 mm for most structures, with the chiasm performing the best with a median MSD of 0.45 mm. The Dice was as expected highly volume dependent, the brainstem (the largest structure) had the highest Dice value with a median of 0.89 whereas smaller volumes such as the chiasm had a Dice of 0.71. CONCLUSION: Except for the caudal definition of the spinal cord, the variances observed in the contours of OARs in the brain were generally low and consistent. Surface mapping revealed sub-regions of higher variance for some organs. The data set is being prepared as a validation data set for auto-segmentation algorithms for use within the Danish Comprehensive Cancer Centre - Radiotherapy and potential collaborators.","author_count":15,"contributors":["Lorenzen, Ebbe Laugaard","Kallehauge, Jesper Folsted","Byskov, Camilla Skinnerup","Dahlrot, Rikke Hedegaard","Haslund, Charlotte Aaquist","Guldberg, Trine Lignell","Lassen-Ramshad, Yasmin","Lukacova, Slávka","Muhic, Aida","Witt Nyström, Petra","Haldbo-Classen, Lene","Bahij, Ihsan","Larsen, Lone","Weber, Britta","Hansen, Christian Rønn"],"cuid":["S03-093.85-010744"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"corresponding_author":["Lorenzen, Ebbe Laugaard"],"keyword":["Auto segmentation","Brain","Brain diagnostic imaging","Humans","Inter observer variation","Observer Variation","Organs at Risk","Pilot Projects","Radiotherapy","Radiotherapy Planning Computer Assisted"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"a national study on the inter observer variability in the delineation of organs at risk in the brain","src":["aau","au","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85116462911","version":"Other Version"},"id":"S03-093.85-010744","identifier":[{"id":"85116462911","type":"scopus"},{"id":"000705239400001","type":"wos"},{"id":"34629014","type":"pmid"}],"ids":["aau-e0f4bc89-bf31-4af2-bee7-c78851e584a0","au-8b599b40-512e-4e64-b099-25742c4659ad","sdu-838833ff-8e41-488b-b9f8-863f52785c7e"],"keyword":["Brain/diagnostic imaging","Humans","Observer Variation","Organs at Risk","Pilot Projects","Radiotherapy Planning, Computer-Assisted","auto-segmentation","brain","inter-observer variation","radiotherapy"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-75ED