-0320-4c3d-a360-6dc1f5b2ee67","name":"Boklund, Anette","name_org":"Boklund, Anette Ella","orcid":"0000-0001-6359-3403","rank":3,"rolecode":"pau"},{"affno":"1","first":"Lars Erik","key":"larsenpau","last":"Larsen","locid":"135a9407-d29c-4508-8f79-978f5b295a15","name":"Larsen, Lars Erik","orcid":"0000-0003-0730-5555","rank":4,"rolecode":"pau"},{"affno":"3","first":"Charlotte Kristiane","key":"hjulsagerpau","last":"Hjulsager","name":"Hjulsager, Charlotte Kristiane","rank":5,"rolecode":"pau"},{"affno":"1","first":"Carsten Thure","key":"kirkebypau","last":"Kirkeby","locid":"ea24c9a4-7aa6-40f3-9afb-0af19f1e962d","name":"Kirkeby, Carsten","name_org":"Kirkeby, Carsten Thure","orcid":"0000-0001-9292-5526","rank":6,"rolecode":"pau"}],"pmid":["37717056"],"pub":{"doi":"10.1038/s41598-023-42660-7","issn":["20452322"],"journal":"Scientific Reports","paperid":"15396","status":"p","title":"Scientific Reports","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-85171418487"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-0f764668-fc71-40ef-bd02-7239ddf0dd5e"],"src":["KU University of Copenhagen"],"title":"Using surveillance data for early warning modelling of highly pathogenic avian influenza in Europe reveals a seasonal shift in transmission, 2016-2022 : [Inkl. correction]","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-695445","year":"2023","yearsub":"2023"}
{"abstract":"Debat. Vi introducerer vores børn til at færdes i trafikken. Men når vi slipper dem løs på internettet, har det i alle årene været uden kørekort til det mest basale i den digitale verden. Derfor er det godt, at regeringen har digital teknologiforståelse med i sit nye folkeskoleudspil. Men vi skal skrue op for ambitionerne. Teknologiforståelse kan med fordel integreres i flere fag, som regeringen også foreslår. Men derudover bør det laves som et obligatorisk fag på et tidspunkt i folkeskolen fremfor at være et valgfag.","author_count":21,"contributors":["Gregersen, Camilla","Madsen, Gordon Ørskov","Nielsen, Jesper","Kepler, Tomas","Bornakke, Tobias","Marquard, Anni","Flyverbom, Mikkel","Johansen, Stine Liv","Larsen, Malene Charlotte","Lieberoth, Andreas","Lundtofted, Thomas Enemark","Tække, Jesper","Aagaard, Jesper","Fougt, Simon Skov","Thestrup, Klaus","Lauritsen, Peter","Thorhauge, Anne Mette","Helles, Rasmus","Vejlø, Christiane","Caspersen, Michael E.","Baltzarsen, Maj"],"cuid":["S01-000.00-700470"],"filters":{"added":"2023-12","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"level":"pop","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-PR","DI-U"],"level3":{"OT":["Dansk Magisterforening"],"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-CBS","DI-U-KU","DI-U-SDU"]},"level3all":["DI-PR-OTH","DI-U-AAU","DI-U-AU","DI-U-CBS","DI-U-KU","DI-U-SDU"]},"review":"und","rtype":["clu"],"sorti":"teknologiforståelse som valgfag i folkeskolen giver ulighed hos børn og voksne","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dna","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://avisendanmark.dk/debat/teknologiforstaaelse-som-valgfag-i-folkeskolen-giver-ulighed-hos-boern-og-unge","version":"Published Version"},"id":"S01-000.00-700470","ids":["cbs-7691499d-02d1-40b7-b06a-76bed0217aaa"],"lang":"Danish","lev