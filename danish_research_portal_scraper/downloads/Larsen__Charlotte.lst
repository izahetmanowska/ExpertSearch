orresponding":null,"country":"dk","first":"Jens Laurids","key":"sørensenpau","last":"Sørensen","locid":"365188dd-0cdc-4c71-a590-2ccd261ae3df","name":"Sørensen, Jens Laurids","orcid":"0000-0002-2392-5343","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens","key":"muffpau","last":"Muff","locid":"31d59491-a0f2-44b7-aba4-6d1def771538","name":"Muff, Jens","orcid":"0000-0003-1082-3409","rank":9,"rolecode":"pau"}],"pub":{"doi":"10.1021/acssuschemeng.3c02136","issn":["21680485"],"issue":"24","journal":"ACS Sustainable Chemistry & Engineering","pages":"9206-9215","publisher":"American Chemical Society","status":"p","title":"ACS Sustainable Chemistry & Engineering","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-85163516699"],"sdg":["12. Responsible Consumption and Production","7. Affordable and Clean Energy","All UN SDG Classification"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["aau-b1c4e163-4207-4ffb-b4bf-486f21ea8607","dtu-feebde43-7cb4-4523-907a-3f40d2f34d74"],"src":["AAU Aalborg University","DTU Technical University of Denmark"],"title":"On the Capacity and Stability of a Biosynthesized Bis-quinone Flow Battery Negolyte","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-098.85-672423","year":"2023","yearsub":"2023"}
{"abstract":"The rescue attempts of stranded whales and euthanasia considerations must include condition assessments of the individual involved, but this is challenged by our insufficient knowledge about the health statuses of these whales. Here, we describe three separate strandings of a young male killer whale (Orcinus orca) in shallow Danish waters during 2021–2022. During the first two stranding events, the whale exhibited remarkable behavior and, after refloating attempts and several kilometers of swimming, it returned to shallow water. This suggests that it actively chose to be in this shallow water, perhaps to ensure free airways and respiration. During the last stranding, it stayed in shallow water for 30 days, during which, euthanasia was considered due to its seemingly worsened condition, including a collapsed dorsal fin. However, suddenly, the whale swam away and, a year later, he was seen alive, confirming that euthanasia would have been the wrong decision. This case raises an important question as to when and under what circumstances active human interventions, such as refloating attempts, should be launched and when euthanasia should be carried out. Every stranding is unique and decisions should be based on thorough considerations of the animal’s health and the chance of a successful rescue.","author_count":12,"contributors":["Alstrup, Aage Kristian Olsen","Thøstesen, Charlotte Bie","Hansen, Kirstin Anderson","Sonne, Christian","Kinze, Carl Christian","Mikkelsen, Lars","Thomsen, Annika","Povlsen, Peter","Larsen, Hanne Lyngholm","Linder, Anne Cathrine","Pagh, Sussie"],"cuid":["S04-094.54-681311"],"filters":{"added":"2023-07","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"corresponding_author":["Alstrup, Aage Kristian Olsen"],"keyword":["Behavior","Euthanasia","Killer whale","Life stranding","Rescue operation","Strandings"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"OT":["Fiskeri- og Søfartsmuseet"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-DTU","DI-U-SDU"]},"level3all":["DI-HO-CDR","DI-U-AAU","DI-U-AU","DI-U-DTU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"the self stranding behavior of a killer whale i orcinus orca i in inner danish waters and considerations concerning human interference in live strandings","src":["aau","au","dtu","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-DTU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/ani13121948","version":"Published Version"},"id":"S04-094.54-681311","identifier":[{"id":"PMC10295617","type":"pmcid"},{"id":"37370458","type":"pmid"},{"id":"85163891036","type":"scopus"}],"ids":["aau-e1961916-c39a-40ac-8e0c-1119f01b25d7","au-aac1a794-32ef-452e-92f1-52b19122d949","dtu-6a4f6f82-80dc-4dab-b24c-91084e7f3e9a","sdu-a8bb73e3-ddab-4c1d-bf3e-a8aec5ee7790"],"keyword":["behavior","euthanasia","killer whale","life stranding","rescue operation","strandings"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-7-6095094C21E986BA79FB700637EDF285"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/ani13121948","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/236570276/animals_13_01948.pdf","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/538890826/animals-13-01948.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/327515011/animals_13_01948.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU A