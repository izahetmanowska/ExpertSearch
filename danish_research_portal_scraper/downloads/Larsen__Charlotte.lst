affno":"1","first":"Charlotte C.","key":"uthpau","last":"Uth","name":"Uth, Charlotte C.","rank":9,"rolecode":"pau"},{"affno":"1","first":"Rikke","key":"bredgaardpau","last":"Bredgaard","name":"Bredgaard, Rikke","rank":10,"rolecode":"pau"},{"affno":"1","first":"Lisbet R.","key":"hölmichpau","last":"Hölmich","name":"Hölmich, Lisbet R.","rank":11,"rolecode":"pau"},{"affno":"2","first":"Nicco","key":"krezdornpau","last":"Krezdorn","name":"Krezdorn, Nicco","rank":12,"rolecode":"pau"},{"affno":"1 3","first":"Peter","key":"vesterglowinskipau","last":"Vester-Glowinski","locid":"ff170014-afd2-40eb-892a-9bb0a75d1365","name":"Vester-Glowinski, Peter","rank":13,"rolecode":"pau"},{"affno":"1","first":"Mathias","key":"ørholtpau","last":"Ørholt","name":"Ørholt, Mathias","rank":14,"rolecode":"pau"},{"affno":"1 3","first":"Mikkel","key":"herlypau","last":"Herly","locid":"f26c7e74-766e-4e94-8e61-33bbed28575f","name":"Herly, Mikkel","orcid":"0000-0002-5866-1173","rank":15,"rolecode":"pau"}],"pmid":["40174261"],"pub":{"doi":"10.1016/j.bjps.2025.02.046","issn":["17486815","18780539"],"issn_org":["17486815"],"journal":"Journal of Plastic, Reconstructive & Aesthetic Surgery","pages":"426-433","status":"p","title":"Journal of Plastic, Reconstructive & Aesthetic Surgery","title_org":"Journal of Plastic, Reconstructive and Aesthetic Surgery","volume":"104"},"review":"Peer Reviewed","scoID":["2-s2.0-105001552148"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region Zealand","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-fcddfe67-e8e7-4356-89e1-ddced091e90d"],"src":["KU University of Copenhagen"],"title":"Limited impact of body mass index on the risk of postoperative complications after implant-based breast reconstruction : A retrospective cohort study of 1847 patients","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-811556","year":"2025","yearsub":"2025"}
{"abstract":"Background: Periprosthetic knee fractures (PPKF) following total knee arthroplasty (TKA) are rare, but represents a potentially devastating complication. A significant gap in understanding patient experiences related to the surgical treatment and recovery process remains. Objective: The aim of the study was to explore patients' experiences 3–4 months after surgical treatment of a PPKF in the distal femur. Method: This exploratory qualitative study employed semi-structured, open-ended interviews with patients who had undergone surgical treatment for PPKF in the distal femur. Patients were recruited during hospitalization or at follow-up visits, with all approached individuals consenting to participate. Interviews were conducted three to four months post-surgery and data were analyzed thematically. Results: Nine patients were interviewed between spring 2023 and spring 2024. The analysis yielded three themes: 1) Patient expectations of the recovery process, 2) Patient concerns – and consequently a desire for follow-up and information, and 3) The impact of recovery on independence and social life. Each theme was further illuminated with subthemes. Conclusion: This study highlights the major challenges of recovering from PPKFs in the distal femur, including physical pain, psychological stress, and social disruption. Unlike elective TKAs, the sudden nature of PPKFs leaves patients unprepared for the lengthy recovery process, which often leads to frustration and isolation. Dependence on family for daily tasks can intensify the feeling of being a burden. To enhance patients’ recovery experiences and outcomes, clear communication and realistic expectations are essential in addressing these issues.","author_count":6,"contributors":["Risager, Stefan Kastalag","Pedersen, T. A.","Viberg, Bjarke","Odgaard, A.","Lindberg-Larsen, Martin","Abrahamsen, Charlotte"],"cuid":["S01-000.00-821432"],"filters":{"added":"2025-08","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Risager, Stefan Kastalag"],"keyword":["Patient experience","Periprosthetic knee fracture","Qualitative Research","Recovery"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-SDR","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"patient experiences after surgically treated periprosthetic knee fracture in the distal femur an explorative qualitative study","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.ijotn.2025.101194","version":"Published Version"},"id":"S01-000.00-821432","identifier":[{"id":"105005578246","type":"scopus"},{"id":"40411930","type":"pmid"}],"ids":["sdu-877cbd81-9ee0-488b-9681-02c21300292e"],"keyword":["Patient experience","Periprosthetic knee fracture","Qualitative research","Recovery"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-11136E5D30BD065CDC8333E003208B79"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/291082279/1-s2.0-S1878124125000395-main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.ijotn.2025.101194","version":"Published Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of orthopaedic surgery (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","corresponding":null,"first":"S. K.","key":"risagerpau","last":"Risager","locid":"dc21700f-7caf-43ac-901c-5fb66ad42684","name":"Risager, Stefan Kastalag","name_org":"Risager, S. K.","orcid":"0000-0001-8157-7001","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"T. A.","key":"pedersenpau","last":"Pedersen","name":"Pedersen, T. A.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"B.","key":"vibergpau","last":"Viberg","locid":"8cb06beb-80dd-4b2f-bcd7-eb9cba7b9da6","name":"Viberg, Bjarke","name_org":"Viberg, B.","orcid":"0000-0001-5169-4282","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"A.","key":"odgaardpau","last":"Odgaard","name":"Odgaard, A.","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"M.","key":"lindberglarsenpau","last":"Lindberg-Larsen","locid":"299608f9-db43-4744-984b-a7c428aca95b","name":"Lindberg-Larsen, Martin","name_org":"Lindberg-Larsen, M.","orcid":"0000-0002-4483-677X","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"C.","key":"abrahamsenpau","last":"Abrahamsen","locid":"22215dd3-464e-4e62-b19f-71a71e0e1e65","name":"Abrahamsen, Charlotte","name_org":"Abrahamsen, C.","orcid":"0000-0002-3700-289X","rank":6,"rolecode":"pau"}],"pmid":["40411930"],"pub":{"doi":"10.1016/j.ijotn.2025.101194","issn":["18781241","18781292"],"issn_org":["18781241"],"journal":"International Journal of Orthopaedic and Trauma Nursing","paperid":"101194","publisher":"Elsevier","status":"p","title":"International Journal of Orthopaedic and Trauma Nursing","volume":"58"},"review":"Peer Reviewed","scoID":["2-s2.0-105005578246"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-877cbd81-9ee0-488b-9681-02c21300292e"],"src":["SDU University of Southern Denmark"],"title":"Patient experiences after surgically treated periprosthetic knee fracture in the distal femur – an explorative qualitative study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-821432","year":"2025","yearsub":"2025"}
{"abstract":"Objectives: To evaluate the effects of a 10-week thrice-weekly FIT FIRST Teen (FFT) intervention on cardiorespiratory fitness in Danish 12–15-years-olds. Design: A cluster-randomised controlled study. Participants: One thousand four hundred and seventeen Danish pupils (51.1% female) from 15 municipal schools, allocated to an intervention group (FFT: n = 994, 13.5 (0.6) years (mean (SD)), 165.8 (8.7) cm, 57.8 (13.4) kg) or a usual practice control group (CON: n = 423, 13.8 (0.8) years, 167.7 (11.5) cm, 58.6 (12.2) kg). Methods: The FFT group completed three weekly 40-min FFT sessions with modified, motivating, involving, high-intensity sports-based activities. Before and after the 10-wk intervention period resting heart rate and blood pressure, body composition, postural balance, standing long jump and performance on the Yo–Yo intermittent recovery level 1 children’s test (YYIR1C) were measured. Group effects for all outcome variables were tested using multi-level linear mixed models. Results: The group effect analyses showed no significant differences between FFT and CON in the YYIR1C test (p = 0.080). A significant small difference between groups was found in resting heart rate (d = 0.29, p = 0.039) in favour of FFT. No significant between-group differences were observed in body composition, or the remaining cardiovascular or physical fitness variables (p >0.05). Conclusion: The lack of significant effects for the majority of the outcome measures calls for further development and long-term testing of the programme.","author_count":9,"contributors":["Meiner, Christina Birch","Eckert, Caroline","Aggestrup, Charlotte Sandager","Pfeffer, Kristina","Koch, Sofie","Thøgersen-Ntoumani, Cecilie","Ntoumanis, Nikos","Krustrup, Peter","Larsen, Malte Nejst"],"cuid":["S01-000.00-821834"],"filters":{"added":"2025-08","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Lar