2-9f98-09b9c03b2c27","name":"Rasmussen, Charlotte Lund","rank":3,"rolecode":"pau"},{"affno":"4 5 6 7","first":"Duncan","key":"mcgregorduncanpau","last":"McGregor","name":"McGregor, Duncan","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Charlotte Diana Nørregaard","key":"rasmussencharlottediananørregaardpau","last":"Rasmussen","locid":"180d2a5d-fe8e-4956-b192-48aed7083301","name":"Rasmussen, Charlotte Diana Nørregaard","orcid":"0000-0002-1769-717X","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sannie Vester","key":"thorsensannievesterpau","last":"Thorsen","name":"Thorsen, Sannie Vester","rank":6,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Marie Birk","key":"jørgensenmariebirkpau","last":"Jørgensen","name":"Jørgensen, Marie Birk","rank":7,"rolecode":"pau"},{"affno":"8 5 7","first":"Sebastien","key":"chastinsebastienpau","last":"Chastin","name":"Chastin, Sebastien","rank":8,"rolecode":"pau"},{"affno":"1 9","corresponding":null,"first":"Andreas","key":"holtermannandreaspau","last":"Holtermann","locid":"f0d131d6-aefa-4dd3-a64e-2e237f273adf","name":"Holtermann, Andreas","orcid":"0000-0003-4825-5697","rank":9,"rolecode":"pau"}],"pmid":["32690043"],"pub":{"doi":"10.1186/s12966-020-00988-7","issn":["14795868"],"journal":"International Journal of Behavioral Nutrition and Physical Activity","paperid":"93","publisher":"BioMed Central","status":"p","title":"International Journal of Behavioral Nutrition and Physical Activity","volume":"17"},"review":"Peer Reviewed","scoID":["2-s2.0-85088352025"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Miscellaneous","All Universities","Copenhagen Business School","DI-ALL","DI-GV","DI-GV-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Governmental Institutions","Miscellaneous","Other Research","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-3ddfd6f6-8318-41b1-9ea0-51c5be57cffe","nfa-ebe4e1f1-93cf-482a-8a38-7827f708d871","sdu-c58ea28b-e527-4717-bda6-8df060539426"],"src":["KU University of Copenhagen","NFA National Research Centre for the Working Environment","SDU University of Southern Denmark"],"title":"The physical activity paradox revisited : A prospective study on compositional accelerometer data and long-term sickness absence","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-099.24-768773","year":"2020","yearsub":"2020"}
{"abstract":"Psychotic experiences (PE), below the threshold of psychotic disorder, are common in the general population. PE are associated with risk behaviors such as suicidality, non-suicidal self-injury (NSSI) and substance use. However, PE as specific or causal phenomena of these risk behaviors are still debated. We aimed to examine the longitudinal trajectories of PE from preadolescence to adolescence and their associated risk behaviors in adolescence. A total of 1138 adolescents from the Copenhagen Child Cohort 2000 were assessed for PE and risk behaviors (NSSI, suicide ideation and -attempts and substance use) at age 11 and 16 years, along with measures of general psychopathology and depressive symptoms specifically. Self-reported impact of general psychopathology tended to be associated with more PE persistence. PE were associated with all risk behaviors in cross section at both follow-ups. Persistent PE from ages 11 to 16 and incident PE at age 16 were associated with risk behaviors at age 16, whereas remitting PE from age 11 to 16 were not. After adjustment for co-occurring depressive symptoms and general psychopathology, all associations were markedly reduced. After exclusion of preadolescents who already had expressed risk behavior at age 11, PE in preadolescence did not stand out as an independent predictor of incident adolescent risk behaviors. The current study suggests that PE in preadolescence and adolescence may not play a direct causal role regarding NSSI, suicidality, and substance use. However, PE are still useful clinical markers of severity of psychopathology and associated risk behaviors.","author_count":9,"contributors":["Rimvall, Martin K","van Os, Jim","Rask, Charlotte Ulrikka","Olsen, Else Marie","Skovgaard, Anne Mette","Clemmensen, Lars","Larsen, Janne Tidselbak","Verhulst, Frank","Jeppesen, Pia"],"cuid":["S03-099.80-020381"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"continent":["Europe, EU","Europe, Non-EU","OECD"],"corresponding_author":["Rimvall, Martin K."],"country":["Netherlands","United Kingdom"],"glorg":["All Global Affiliations","Erasmus University Medical Center Rotterdam","Erasmus University Rotterdam","King's College London","King's Health Partners","Maastricht University","University Medical Center Utrecht","Utrecht University"],"keyword":["Epidemiology","Longitudinal","Non suicidal self harm","Psychotic experiences","Risk behaviors","Substance use","Suicidality"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-NP","DI-U"],"level3":{"NP":["DI-NP-ALL","DI-NP-LUND"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-NP-LUND","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"psychotic experiences from preadolescence to adolescence when should we be worried about adolescent risk behaviors","src":["au","ku","sdu"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85075185917","version":"Other Version"},"funding_acknowledgement":["We thank Anja Munkholm (MD, Ph.D.), Anne Dorothee Müller (MSc.), Maja Gregersen (MSc.), and Kia Elten (MSc.) for their substantial contributions to data collection. The current project was supported by Grants from the Danish Foundations TrygFonden (J. nr. 7-10-0189, 7-11-0341 and 109903); the Lundbeckfonden (J. nr. R54-A5843). Martin K. Rimvall was funded by a Ph.D. Grant from the Mental Health Services of the Capital Region of Denmark."],"id":"S03-099.80-020381","identifier":[{"id":"000541617500001","type":"wos"},{"id":"85075185917","type":"scopus"},{"id":"31732797","type":"pmid"}],"ids":["au-6a130d16-50c7-4e00-92eb-8cfa8a0ba3f0","ku-ab1f4bf6-dc92-4087-8e88-a58311fa7267","sdu-60b25ae2-d5d5-4531-a9f2-ecdcdc387d4b"],"keyword":["Epidemiology","Longitudinal","Non-suicidal self-harm","Psychotic experiences","Risk behaviors","Substance use","Suicidality"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-A635F9F32727A2C29E95E629D19A1FA9"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","country":"gb","key":"king s college london","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"King's College London","used":1},{"affno":"2","country":"nl","key":"utrecht university","loc":["Netherlands","Europe, EU","OECD"],"name":"Utrecht University","used":1},{"affno":"3","country":"nl","key":"maastricht university","loc":["Netherlands","Europe, EU","OECD"],"name":"Maastricht University","used":1},{"affno":"4","country":"nl","key":"university medical center utrecht","loc":["Netherlands","Europe, EU","OECD"],"name":"University Medical Center Utrecht","used":1},{"affno":"5","country":"gb","key":"king s health partners","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"King's Health Partners","used":1},{"affno":"6","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Psychiatric Hospital for Children and Adolescents"],"nora_code":"DI-U-AU","used":1},{"affno":"7","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Section of Epidemiology"],"nora_code":"DI-U-KU","used":1},{"affno":"8","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern De