"DAF":["All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-424cb901-8e37-4f8e-866e-42eb045427f6","ku-a4b14801-4fde-4501-ab0b-55e2fc925df3"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Experimental infection of high health pigs with porcine circovirus type 2 (PCV2) and <i>Lawsonia intracellularis</i>","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-034092","year":"2022","yearsub":"2022"}
{"abstract":"We apply a computational model, global multi-mutant analysis (GMMA), to inform on effects of most amino acid substitutions from a randomly mutated gene library. Using a high mutation frequency, the method can determine mutations that increase the stability of even very stable proteins for which conventional selection systems have reached their limit. As a demonstration of this, we screened a mutant library of a highly stable and computationally redesigned model protein using an in vivo genetic sensor for folding and assigned a stability effect to 374 of 912 possible single amino acid substitutions. Combining the top 9 substitutions increased the unfolding energy 47 to 69 kJ/mol in a single engineering step. Crystal structures of stabilized variants showed small perturbations in helices 1 and 2, which rendered them closer in structure to the redesign template. This case study illustrates the capability of the method, which is applicable to any screen for protein function.","author_count":6,"contributors":["Norrild, Rasmus Krogh","Johansson, Kristoffer Enøe","O’Shea, Charlotte","Morth, Jens Preben","Lindorff-Larsen, Kresten","Winther, Jakob Rahr"],"cuid":["S02-100.00-037334"],"filters":{"added":"2023-02","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Winther, Jakob Rahr"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"increasing protein stability by inferring substitution effects from high throughput experiments","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.crmeth.2022.100333","version":"Published Version"},"id":"S02-100.00-037334","identifier":[{"id":"36452862","type":"pmid"},{"id":"85142131456","type":"scopus"},{"id":"PMC9701609","type":"pmcid"}],"ids":["dtu-d1e81216-b3ab-494d-8514-93033d12a2b6","ku-d2179ea7-e989-4c25-9c40-68d4de3b1ca7"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-E30AA8B44F3B068E1CAC65CAB5308321"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/295920005/1_s2.0_S2667237522002302_main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/330778384/1_s2.0_S2667237522002302_main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.crmeth.2022.100333","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Biotechnology and Biomedicine","Technical University of Denmark, Department of Biotechnology and Biomedicine, Section for Protein Chemistry and Enzyme Technology","Technical University of Denmark, Department of Biotechnology and Biomedicine, Section for Protein Chemistry and Enzyme Technology, DTU Protein Biophysics Core","Technical University of Denmark, Department of Biotechnology and Biomedicine, Section for Protein Chemistry and Enzyme Technology, Protein Biophysics"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Biology, Biomolecular Sciences"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"Rasmus Krogh","key":"norrildpau","last":"Norrild","locid":"956c4c72-974e-495d-a672-c4fe99226816","name":"Norrild, Rasmus Krogh","orcid":"0000-0002-9120-2745","rank":1,"rolecode":"pau"},{"affno":"2","first":"Kristoffer Enøe","key":"johanssonpau","last":"Johansson","locid":"34484100-1988-429c-8752-50e9ec016138","name":"Johansson, Kristoffer Enøe","rank":2,"rolecode":"pau"},{"affno":"2","first":"Charlotte","key":"osheapau","last":"O'Shea","locid":"66faa368-fff8-4a0a-8001-73ce7306646f","name":"O'Shea, Charlotte","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens Preben","key":"morthpau","last":"Morth","locid":"5c6aef5e-424e-4d99-8a1f-ba28b86e759b","name":"Morth, Jens Preben","orcid":"0000-0003-4077-0192","rank":4,"rolecode":"pau"},{"affno":"2","first":"Kresten","key":"lindorfflarsenpau","last":"Lindorff-Larsen","locid":"be20a4d8-92c4-44b9-9dfb-b6ad6471a58c","name":"Lindorff-Larsen, Kresten","orcid":"0000-0002-4750-6039","rank":5,"rolecode":"pau"},{"affno":"2","first":"Jakob Rahr","key":"wintherpau","last":"Winther","locid":"1037684b-136c-4b11-b63a-20b7f13a853b","name":"Winther, Jakob R.","name_org":"Winther, Jakob Rahr","orcid":"0000-0001-6995-9154","rank":6,"rolecode":"pau"}],"pmid":["36452862"],"pub":{"doi":"10.1016/j.crmeth.2022.100333","issn":["26672375"],"issue":"11","journal":"Cell Reports Methods","paperid":"100333","publisher":"Cell Press","status":"p","title":"Cell Reports Methods","volume":"2"},"review":"Peer Reviewed","scoID":["2-s2.0-85142131456"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-d1e81216-b3ab-494d-8514-93033d12a2b6","ku-d2179ea7-e989-4c25-9c40-68d4de3b1ca7"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Increasing protein stability by inferring substitution effects from high-throughput experiments","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-037334","year":"2022","yearsub":"2022"}
{"abstract":"Purpose: To investigate differences in prescription rates of commonly used drugs among prostate cancer patients and cancer-free comparisons and between patients diagnosed with localized and non-localized disease. Methods: We conducted a register-based study including all men aged 50–85 years diagnosed with prostate cancer in Denmark from 1998 to 2015 and an age-matched cancer-free comparison cohort. We calculated the number of new and total prescriptions from three years before to three years after the date of diagnosis of the case for selected drug classes divided by the number of person-months and stratified by stage at diagnosis. Results: We included 54,286 prostate cancer patients and 249,645 matched comparisons. 30,712 patients were diagnosed with localized disease and 12,884 with non-localized disease. The rates of new prescriptions increased considerably among patients within the year before the diagnosis. Hereafter the rates varied between drug classes. For most drug classes, total prescription rates for patients and comparisons increased similarly in the study period. Total prescription rates varied between men with localized and non-localized disease for all drug classes apart from statins. Conclusion: Our findings indicate that a large proportion of prostate cancer cases are likely diagnosed during medical work-up for other reasons than prostate cancer. Increased rates occur within the last year before diagnosis and future studies on the interaction between drug use and prostate cancer should at least include a one year pre-diagnostic lag-time. Post-diagnostic prescription rates demonstrated an increased use of drugs most likely associated with the consequences of the disease.","author_count":8,"contributors":["Larsen, Signe Benzon","Dehlendorff, Christian","Skriver, Charlotte","Pottegård, Anton","Friis, Søren","Røder, Martin Andreas","Brasso, Klaus","Duun-Henriksen, Anne Katrine"],"cuid":["S02-100.00-046902"],"filters":{"added":"2022-04","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Larsen, Signe Benzon"],"keyword":["Aged","Aged 80 and over","Drug use","Humans","Hydroxymethylglutaryl CoA Reductase Inhibitors therapeutic use","Lag time","Male","Middle Aged","Pharmaceutical Preparations","Prescription rate","Prescriptions","Prostate cancer","Prostatic Neoplasms diagnosis","Surveillance bias"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-NP","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-NP-CAN","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"prescription rates for commonly used drugs before and after a prostate cancer diagnosis","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/378165627/Prescription_rates_for_commonly_used_drugs_preprint.pdf","version":"Authors Final Version"},"funding_acknowledgement":["The present study was funded by research grants from Kirsten and Freddy Johansens Fond and from the Peer Kølendorf Family Foundation. Anne Katrine Duun-Henriksen was funded by a research Grant from the Danish Cancer Society Scientific Committee (R204-A12.653)."],"id":"S02-100.00-046902","identifier":[{"id":"35006514","type":"pmid"},{"id":"85122863399","type":"scopus"}],"ids":["ku-e38bde3a-7af7-4289-9581-7276ee5b9a08","sdu-88a1a039-57ab-424c-acd3-31668eceb039"],"keyword":["Aged","Aged, 80 and over","Drug use","Humans","Hydroxymethylglutaryl-CoA Reductase Inhibitors/therapeutic use","Lag-time","Male","Middle Aged","Pharmaceutical Preparations","Prescription rate","Prescriptions","Prostate cancer","Prostatic Neoplasms/diagnosis","Surveillance bias"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-07B7