st":"Dorte","key":"petersendortepau","last":"Petersen","name":"Petersen, Dorte","rank":12,"rolecode":"pau"},{"affno":"1","first":"Lau","key":"petersenlaupau","last":"petersen","name":"petersen, Lau","rank":13,"rolecode":"pau"},{"affno":"5","first":"Laura Helene","key":"rasmussenlaurahelenepau","last":"Rasmussen","name":"Rasmussen, Laura Helene","rank":14,"rolecode":"pau"},{"affno":"5","first":"Kirstine","key":"skovkirstinepau","last":"Skov","name":"Skov, Kirstine","rank":15,"rolecode":"pau"},{"affno":"4","first":"Kisser","key":"thorsøekisserpau","last":"Thorsøe","name":"Thorsøe, Kisser","rank":16,"rolecode":"pau"},{"affno":"5","first":"Mikkel","key":"tamstorfmikkelpau","last":"Tamstorf","name":"Tamstorf, Mikkel","rank":17,"rolecode":"pau"}],"pub":{"place":"Aarhus University","status":"p","title":"Zackenberg Ecological Research Operations, 17th annual report"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-6f3f7183-4bf3-4aa2-865e-a1ed310a5f11"],"src":["KU University of Copenhagen"],"title":"The ClimateBasis and GeoBasis Programme","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-459902","year":"2012","yearsub":"2012"}
{"abstract":"Background: Several tools have been created to assess competence in bronchoscopy. However, educational guidelines still use an arbitrary number of performed procedures to decide when basic competency is acquired. Objectives: The purpose of this study was to define pass/fail scores for two bronchoscopy assessment tools, and investigate how these scores relate to physicians' experience regarding the number of bronchoscopy procedures performed. Methods: We studied two assessment tools and used two standard setting methods to create cut scores: the contrasting-groups method and the extended Angoff method. In the first we compared bronchoscopy performance scores of 14 novices with the scores of 14 experienced consultants to find the score that best discriminated between the two groups. In the second we asked an expert group of 7 experienced bronchoscopists to judge how a borderline trainee would perform on each item of the test. Results: Using the contrasting-groups method we found a standard that would fail all novices and pass all consultants. A clear pass related to prior experience of 75 procedures. The consequences of using the extended Angoff method were also acceptable: all trainees who had performed less than 50 bronchoscopies failed the test and all consultants passed. A clear pass related to 80 procedures. Conclusions: Our proposed pass/fail scores for these two methods seem appropriate in terms of consequences. Prior experience with the performance of 75 and 80 bronchoscopies, respectively, seemed to ensure basic competency. In the future objective assessment tools could become an important aid in the certification of physicians performing bronchoscopies.","author_count":6,"contributors":["Konge, Lars","Clementsen, Paul","Larsen, Klaus Richter","Arendrup, Henrik","Buchwald, Christian","Ringsted, Charlotte"],"cuid":["S01-000.00-493409"],"filters":{"added":"2022-04","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"establishing pass fail criteria for bronchoscopy performance","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1159/000332333","version":"Other Version"},"id":"S01-000.00-493409","identifier":[{"id":"21986097","type":"pmid"},{"id":"84856462671","type":"scopus"}],"ids":["ku-a769f788-d47e-4895-b247-cd6118924ea5"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-0A3616A048A666990D5496E939641CDB"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1159/000332333","version":"Other Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Lars","key":"kongepau","last":"Konge","locid":"e1c287e3-4cd2-43d2-887d-f2f77fd5daf8","name":"Konge, Lars","orcid":"0000-0002-1258-5822","rank":1,"rolecode":"pau"},{"affno":"","first":"Paul","key":"clementsenpau","last":"Clementsen","name":"Clementsen, Paul","rank":2,"rolecode":"pau"},{"affno":"","first":"Klaus Richter","key":"larsenpau","last":"Larsen","name":"Larsen, Klaus Richter","rank":3,"rolecode":"pau"},{"affno":"","first":"Henrik","key":"arendruppau","last":"Arendrup","locid":"5924ca7b-3563-4529-b194-c4ba09a569a3","name":"Arendrup, Henrik","rank":4,"rolecode":"pau"},{"affno":"","first":"Christian","key":"buchwaldpau","last":"Buchwald","name":"Buchwald, Christian","rank":5,"rolecode":"pau"},{"affno":"","first":"Charlotte","key":"ringstedpau","last":"Ringsted","locid":"aad0b8e6-2821-409d-9ed2-33b6ffded4d2","name":"Ringsted, Charlotte","rank":6,"rolecode":"pau"}],"pmid":["21986097"],"pub":{"doi":"10.1159/000332333","issn":["00257931","14230356"],"issn_org":["00257931"],"issue":"2","journal":"Respiration","pages":"140-6","status":"p","title":"Respiration","volume":"83"},"review":"Peer Reviewed","scoID":["2-s2.0-84856462671"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-a769f788-d47e-4895-b247-cd6118924ea5"],"src":["KU University of Copenhagen"],"title":"Establishing Pass/Fail Criteria for Bronchoscopy Performance","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-493409","year":"2012","yearsub":"2012"}
{"abstract":"Svinedyrlæger har muligheden for at udskifte blodprøveglas og kanyler med reb til indsamling af spyt. DTU Veterinærinstituttet har valideret metoderne til at teste spyt for PCV2, PRRS- og Influenza virus, og laboratoriet modtager nu spytprøver rutinemæssigt.","author_count":8,"contributors":["Heiselberg, Pia R.","Christensen, Sanne","Hjulsager, Charlotte Kristiane","Petersen, Ken Steen","Stege, Helle","Nielsen, Jens Peter","Larsen, Lars Erik","Kristensen, Charlotte S."],"cuid":["S02-091.67-035665"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-PR","DI-U"],"level3":{"OT":["Svinepraksis.dk"],"PR":["DI-PR-AAF","DI-PR-ALL"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-PR-AAF","DI-U-DTU","DI-U-KU"]},"review":"und","rtype":["clu"],"sorti":"virus kan påvises i spyt fra grise","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://www.hyologisk.dk/artikel?id=70374","version":"Other Version"},"id":"S02-091.67-035665","ids":["dtu-856a09ca-845c-4240-a656-8bec04393dcf","ku-e723ec62-206f-4ab7-9903-33bfc069b983"],"lang":"Danish","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-2-ADBBCFCF307C2F61349BE1624CE6988F"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.hyologisk.dk/artikel?id=70374","version":"Other Version"}],"org":[{"affno":"1","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Svinepraksis.dk"],"nora_code":"DI-OT","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Veterinary Institute","Technical University of Denmark, National Veterinary Institute, Division of Veterinary Diagnostics and Research","Technical University of Denmark, National Veterinary Institute, Division of Veterinary Diagnostics and Research, Section for Veterinary Diagnostics"],"nora_code":"DI-U-DTU","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Life Sciences, Department of Large Animal Sciences, Production & Health"],"nora_code":"DI-U-KU","used":1},{"affno":"4","country":"dk","key":"danish agriculture food council","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-AAF","l3nl":"Danish Agriculture & Food Council","l3nn":"Danish Agriculture & Food Council","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Danish Agriculture & Food Council","namevar":["Danish Agriculture & Food Council"],"nora_code":"DI-PR-AAF","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Pia R.","key":"heiselbergpau","last":"Heiselberg","name":"Heiselberg, Pia R.","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sanne","key":"christensenpau","last":"Christensen","name":"Christensen, Sanne","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Charlotte Kristiane","key":"hjulsagerpau","last":"Hjulsager","locid":"6c1511ef-8211-4653-8c81-cd55b7f63f64","name":"Hjulsager, Charlotte Kristiane","orcid":"0000-0001-7557-8876","rank":3,"rolecode":"pau"},{"affno":"3","first":"Ken Steen","key":"pedersenpau","last":"Pedersen","locid":"e7e2a10f-e368-4635-9481-f23e58c80aa8","name":"Pedersen, Ken Steen","rank":4,"rolecode":"pau"},{"affno":"3","first":"Helle","key":"stegepau","last":"Stege","locid":"fcd35d18-c0ae-4328-95f3-f912e648c498","name":"Stege, Helle","orcid":"0000-0003-3033-4207","rank":5,"rolecode":"pau"},{"affno":"3","first":"Jens Peter","key":"nielsenpau","last":"Nielsen","locid":"e550301c-f89e-4a8b-bf34-e6fc3b76ff37","name":"Nielsen, Jens Peter","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Lars Erik","key":"larsenpau","last":"Larsen","locid":"09c2a33d-b353-44de-a850-f3c7dec879cb","name":"Larsen, Lars Erik","orcid":"0000-0003-0730-5555","rank":7,"rolecode":"pau"},{"affno":"1 4","corresponding":null,"first":"Charlotte S.","key":"kristensenpau","last":"Kristensen","name":"Kristensen, Charlotte S.","rank":8,"rolecode":"pau"}],"pub":{"issn":["09060995"],"journal":"Hyologisk","publisher":"Dansk Agrar Forlag AS","publisher_org":"Dansk Agrar Forlag A-S","status":"p","title":"Hyologisk"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Private Research","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Danish Agriculture & Food Council","Miscellaneous","Other Research","Private Research","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-856a09ca-845c-4240-a656-8bec04393dcf","ku-e723ec62-206f-4ab7-9903-33bfc069b983"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Virus kan påvises i spyt fra grise","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-091.67-035665","year":"2012","yearsub":"2012"}
{"abstract":"Background: Several studies have found a positive effect on the learning curve as well as the improvement of basic psychomotor skills in the operating room after virtual reality training. Despite this, the majority of surgical and gynecological departments encounter hurdles when implementing this form of training. This is mainly due to lack of knowledge concerning the time and human resources needed to train novice surgeons to an adequate level. The purpose of this trial is to investigate the impact of instructor feedback regarding time, repetitions and self-perception when training complex operational tasks on a virtual reality simulator. Methods/Design. The study population consists of medical students on their 4 th to 6 th year without prior laparoscopic experience. The study is conducted in a skills laboratory at a centralized university hospital. Based on a sample size estimation 98 participants will be randomized to an intervention group or a control group. Both groups have to achieve a predefined proficiency level when conducting a laparoscopic salpingectomy using a surgical virtual reality simulator. The intervention group receives standardized instructor feedback of 10 to 12 min a maximum of three times. The control group receives no instructor feedback. Both groups receive the automated feedback generated by the virtual reality simulator. The study follows the CONSORT Statement for randomized trials. Main outcome measures are time and repetitions to reach the predefined proficiency level on the simulator. We include focus on potential sex differences, computer gaming experience and self-perception. Discussion. The findings will contribute to a better understanding of optimal training methods in surgical education. Trial Registration. NCT01497782.","author_count":11,"contributors":["Oestergaard, Jeanett","Bjerrum, Flemming","Maagaard, Mathilde","Winkel, Per","Larsen, Christian Rifbjerg","Ringsted, Charlotte","Gluud, Christian","Grantcharov, Teodor","Ottesen, Bent","Soerensen, Jette Led"],"cuid":["S02-092.93-024826"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Oestergaard, Jeanett"],"keyword":["Adult","Analysis of Variance","Clinical Competence","Computer Simulation","Denmark","Education Medical Undergraduate","Educational Measurement","Faculty Medical","Feedback","Female","Humans","Laparoscopy","Linear Models","Male","Reference Values","Salpingectomy","Students Medical","Task Performance and Analysis","Training","User Computer Interface","Virtual reality simulation","Young Adult"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-ZEA"],"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-HO-ZEA","DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"instructor feedback versus no instructor feedback on performance in a laparoscopic virtual reality simulator a randomized educational trial","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1186/1472-6920-12-7","version":"Other Version"},"id":"S02-092.93-024826","identifier":[{"id":"PMC3311079","type":"pmcid"},{"id":"84857403056","type":"scopus"},{"id":"22373062","type":"pmid"}],"ids":["au-a63b7c92-6d46-4991-b582-ee2d52520d9f","ku-0f07524b-d5e0-445e-98df-ec05de2d19bf"],"keyword":["Adult","Analysis of Variance","Clinical Competence","Computer Simulation","Denmark","Education, Medical, Undergraduate","Educational Measurement","Faculty, Medical","Feedback","Female","Humans","Laparoscopy","Linear Models","Male","Reference Values","Salpingectomy","Students, Medical","Task Performance and Analysis","Training","User-Computer Interface","Virtual reality simulation","Young Adult"],"lang":"English","level":"Scientif