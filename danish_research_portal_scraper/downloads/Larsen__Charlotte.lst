nørskovpedh","last":"Nørskov","name":"Nørskov, Vinnie","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["978 87 7184 744 4"],"pages":"291-316","place":"Aarhus","publisher":"Aarhus Universitetsforlag","status":"p","title":"Museologi mellem fagene"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-20168bc0-2c50-4c06-b3f4-b91e88819131"],"src":["AU Aarhus University"],"title":"Animerende lyd : at færdes på museer gennem musik, lyd, tid og rum","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-147711","year":"2021","yearsub":"2021"}
{"abstract":"In recent years, there has been an increasing demand for the replacement of synthetic food colorants with naturally derived alternatives. Filamentous fungi are prolific producers of secondary metabolites including polyketide-derived pigments, many of which have not been fully characterized yet. During our ongoing investigations of black aspergilli, we noticed that Aspergillus homomorphus turned yellow when cultivated on malt extract agar plates. Chemical discovery guided by UV and MS led to the isolation of two novel yellow natural products, and their structures were elucidated as aromatic α-pyrones homopyrones A ( 1 ) and B ( 2 ) by HRMS and NMR. Combined investigations including retro-biosynthesis, genome mining, and gene deletions successfully linked both compounds to their related biosynthetic gene clusters. This demonstrated that homopyrones are biosynthesized by using cinnamoyl-CoA as the starter unit, followed by extension with three malonyl-CoA units, and lactonization to give the core hybrid backbone structure. The polyketide synthase AhpA includes a C-methylation domain, which however seems to be promiscuous since only 2 is C-methylated. Altogether, the homopyrones represent a rare case of hybrid phenylpropanoid- and polyketide-derived natural products in filamentous fungi.","author_count":7,"contributors":["Futyma, Malgorzata Ewa","Guo, Yaojie","Hoeck, Casper","Hoof, Jakob Blæsbjerg","Gotfredsen, Charlotte Held","Mortensen, Uffe Hasbro","Larsen, Thomas Ostenfeld"],"cuid":["S01-000.00-325664"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Larsen, Thomas Ostenfeld","Mortensen, Uffe Hasbro"],"keyword":["Biosynthesis","CRISPR Cas9","Pigment"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"genetic origin of homopyrones a rare type of hybrid phenylpropanoid and polyketide derived yellow pigments from aspergillus homomorphus","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85107480632","version":"Other Version"},"id":"S01-000.00-325664","identifier":[{"id":"34106309","type":"pmid"},{"id":"85107480632","type":"scopus"}],"ids":["dtu-46ef2302-c495-43bf-b714-c27c276a32c0"],"keyword":["Aspergillus homomorphus","Biosynthesis","CRISPR-Cas9","Homopyrone","Pigment"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-48CC2A087506897C332B2676FB4F89DA"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Biotechnology and Biomedicine"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Malgorzata E.","key":"futymapau","last":"Futyma","locid":"63533820-9873-4d2b-bd94-47b692a264d0","name":"Futyma, Malgorzata Ewa","name_org":"Futyma, Malgorzata E.","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Yaojie","key":"guopau","last":"Guo","locid":"13ace786-34d1-40c7-9d41-cf926918773b","name":"Guo, Yaojie","orcid":"0000-0003-1927-4872","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Casper","key":"hoeckpau","last":"Hoeck","locid":"b0666407-58d2-4154-bec3-3c1d14be9f4a","name":"Hoeck, Casper","orcid":"0000-0001-5372-9821","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jakob B.","key":"hoo