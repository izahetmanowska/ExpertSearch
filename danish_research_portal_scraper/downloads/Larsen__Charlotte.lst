},{"affno":"1","corresponding":null,"country":"dk","first":"Peter Lund","key":"kristensenpau","last":"Kristensen","locid":"751d26de-66d4-4ef9-8183-880c48c96dc7","name":"Kristensen, Peter Lund","orcid":"0000-0002-5666-9614","rank":6,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Finn Breinholt","key":"larsenpau","last":"Larsen","name":"Larsen, Finn Breinholt","rank":7,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Britta","key":"ortizpau","last":"Ortiz","name":"Ortiz, Britta","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Knud","key":"juelpau","last":"Juel","locid":"95a22bf7-54de-48e0-ab33-855002b210be","name":"Juel, Knud","orcid":"0000-0002-4134-1173","rank":9,"rolecode":"pau"}],"pmid":["22786925"],"pub":{"doi":"10.1177/1403494812451412","issn":["14034948","16511905"],"issn_org":["14034948"],"issue":"4","journal":"Scandinavian Journal of Public Health","pages":"391-397","publisher":"SAGE Publications","status":"p","title":"Scandinavian Journal of Public Health","volume":"40"},"review":"Peer Reviewed","scoID":["2-s2.0-84863836646"],"search":{"DAF":["All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-6c442cff-92d9-4453-a41d-7084df386720"],"src":["SDU University of Southern Denmark"],"title":"The Danish National Health Survey 2010. Study design and respondent characteristics","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-604155","year":"2012","yearsub":"2012"}
{"abstract":"This article is a review on post‐weaning multisystemic wasting syndrome (PMWS), the first described disease among the porcine circovirus diseases (PCVD). Post‐weaning multisystemic wasting syndrome has, since its appearance in Canada in 1991, been seen in all major pig producing countries. To diagnose PMWS at herd level typical clinical appearance consisting of wasting and increased mortality must be combined with finding at autopsy of diseased pigs, where typical microscopic findings in the lymphatic tissue must be present. Post‐weaning multisystemic wasting syndrome significantly increases the mortality and reduces the daily weight gain in weaner pig and/or in finishing pigs. Post‐weaning multisystemic wasting syndrome can be transmitted by pig‐to‐pig contact and some studies point at airborne transmission as a possibility. Studies in Europe have shown several risk factors that either increase or decrease the risk for a pig herd to be affected by PMWS. At the pig level, studies have shown the importance of maternal immunity as protection for subsequent development of PMWS. To control PMWS, good production management and control of other diseases are crucial. Since 2004, commercial vaccines against Porcine Circo Virus type 2 have been coming on the market and many studies have shown great benefits of these to control PMWS. Today, sow vaccines as well as piglet vaccines are available in most countries. An extensive meta‐analysis of many of the vaccines has shown a comparable good efficacy of the vaccines in significantly reducing mortality and increasing weight gain of the pigs.","author_count":3,"contributors":["Baekbo, P.","Kristensen, C. S.","Larsen, Lars Erik"],"cuid":["S02-095.12-034563"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Genotypes","PCV2","PMWS","Pigs","Review"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-AAF","DI-PR-ALL"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-PR-AAF","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"porcine circovirus diseases a review of pmws","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1111/j.1865-1682.2011.01288.x","version":"Other Version"},"id":"S02-095.12-034563","identifier":[{"id":"84858280118","type":"scopus"},{"id":"22252114","type":"pmid"}],"ids":["dtu-57a860d3-8e16-4119-a9fb-63adb5dfe632","ku-0d5f8d5a-1c8a-44c9-82ba-2e57ade48bc3"],"keyword":["Genotypes","PCV2","PMWS","Pigs","Review"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-B92D171F4235F95DF8680C2536D807D6"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1111/j.1865-1682.2011.01288.x","version":"Other Version"}],"org":[{"affno":"1","country":"dk","key":"danish agriculture food council","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-AAF","l3nl":"Danish Agriculture & Food Council","l3nn":"Danish Agriculture & Food Council","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Danish Agriculture & Food Council","namevar":["Danish Agriculture and Food Council"],"nora_code":"DI-PR-AAF","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Centre m.v., Joint expenses"],"nora_code":"DI-U-KU","used":1},{"affno":"3","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Den