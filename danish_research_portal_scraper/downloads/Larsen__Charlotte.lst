{"author_count":5,"contributors":["Hjulsager, Charlotte Kristiane","Krog, Jesper Schak","Chriél, Mariann","Larsen, Gitte","Larsen, Lars Erik"],"cuid":["S01-000.00-361843"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"nr","rtype":["clu"],"sorti":"subtypning af influenza på danske minkfarme i 000000002014","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dra","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/123356035/Faglig_rsberetning_2015.pdf","version":"Published Version"},"id":"S01-000.00-361843","ids":["dtu-bfa5d215-2433-4d81-932f-5f886407b763"],"lang":"Danish","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-ED9888272396B100BF00EFB38DBC9324"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/123356035/Faglig_rsberetning_2015.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Veterinary Institute"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Charlotte Kristiane","key":"hjulsagercharlottekristianepau","last":"Hjulsager","locid":"6c1511ef-8211-4653-8c81-cd55b7f63f64","name":"Hjulsager, Charlotte Kristiane","orcid":"0000-0001-7557-8876","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Schak","key":"krogjesperschakpau","last":"Krog","locid":"1e238a71-3075-4303-91fe-3cedb620123d","name":"Krog, Jesper Schak","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mariann","key":"chriélmariannpau","last":"Chriél","locid":"1a5d6261-6bd2-4940-baab-5d5fcc3c0f7c","name":"Chriél, Mariann","orcid":"0000-0001-5306-4495","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Gitte","key":"larsengittepau","last":"Larsen","locid":"ea426e5f-93bd-48f5-a3c8-e5f8004413a7","name":"Larsen, Gitte","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars Erik","key":"larsenlarserikpau","last":"Larsen","locid":"09c2a33d-b353-44de-a850-f3c7dec879cb","name":"Larsen, Lars Erik","orcid":"0000-0003-0730-5555","rank":5,"rolecode":"pau"}],"pub":{"pages":"109-113","place":"Aarhus N","publisher":"Kopenhagen Fur","status":"p","subtitle":"Kopenhagen Fur","title":"Faglig årsberetning 2015"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-bfa5d215-2433-4d81-932f-5f886407b763"],"src":["DTU Technical University of Denmark"],"title":"Subtypning af influenza på danske minkfarme i 2014","type":"Report Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-361843","year":"2016","yearsub":"2016"}
{"abstract":"At a hospital in Denmark around 40 midwives support the pregnancy of approx. 6000 pregnant women every year. Their role is to monitor the pregnancies and prepare the women for labour. Based on the due date of a woman, authority guidelines prescribe specific and mostly rather narrow time windows within which the pregnant woman should have consultations with a midwife. Therefore, once a pregnant woman enters the system, here sequence of consultations for the time period until labour is fairly fixed. There is a clear goal that, as far as possible, each pregnant woman should see the same midwife at every consultation. Every week the newly arrived pregnant women are assigned an arbitrary free time slot belonging to a specific midwife. In turn this midwife is expected to have consultations with this woman in specific weeks according to the authority guidelines. This random assignment of pregnant woman to specific midwives, without any concern to the midwives? future schedules, means that each midwife has a very unbalanced workload over the year. Furthermore, it means that there is an imbalance between the workloads of the different midwifes. The aim of this project is therefore to devise a method that can make a fair distribution of pregnant women among the midwives. The distribution should result in a balanced work load for each midwife and a balanced work load among the midwives while at the same time making sure that the time windows for consultations are not violated.","author_count":3,"contributors":["Græse, Line","Vilhelmsen, Charlotte","Larsen, Jesper"],"cuid":["S01-000.00-374818"],"event":{"end":"2016-07-07","place":"Poznan, pl","start":"2016-07-03","title":"28th European Conference on Operational Research","year":"2016"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"planning of midwives","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-374818","ids":["dtu-eac12fc6-69b7-44f8-9b8d-277e185ee6e4"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-590EF1F2ADDBFAD5018A032658A87DB7"],"org":[{"affno":"1","country":"dk","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Line","key":"græsepau","last":"Græse","name":"Græse, Line","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Charlotte","key":"vilhelmsenpau","last":"Vilhelmsen","locid":"6ceebc69-a38c-4b56-9070-23135aa491c6","name":"Vilhelmsen, Charlotte","orcid":"0000-0001-8260-6791","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper","key":"larsenpau","last":"Larsen","locid":"d1af4d26-e92b-414c-b534-25b2b607a0d9","name":"Larsen, Jesper","orcid":"0000-0002-9119-3586","rank":3,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-eac12fc6-69b7-44f8-9b8d-277e185ee6e4"],"src":["DTU Technical University of Denmark"],"title":"Planning of Midwives","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-374818","year":"2016","yearsub":"2017"}
{"abstract":"Purpose. To describe associations between retinal vessel diameters and cardiovascular risk markers and mortality. Methods. The present study included 908 persons aged 30 to 60 years. Vessel diameters were expressed as central retinal venular equivalent (CRVE) and central retinal arteriolar equivalent (CRAE). Multiple linear regression analyses and Cox regression models were used. Results. Multiple linear regression analyses showed that narrower CRAE was associated with higher systolic blood pressure, age, and higher HDL cholesterol, whereas wider CRAE and CRVE were associated with smoking. Narrower CRVE was associated with higher HDL cholesterol. In an age-adjusted model, associations between wider CRVE and risk of ischemic heart disease were found (P < 0.001). Wider CRVE was associated with all-cause mortality (HR = 2.02, P = 0.033) in a model adjusted for age, gender, and blood pressure. However, the association was not statistically significant after additional adjustment for smoking. Conclusions. The associations between retinal vessel diameters and known cardiovascular risk factors were confirmed. All-cause mortality was not associated with retinal vessel diameters when adjusting for relevant confounders.","author_count":7,"contributors":["Drobnjak, Dragana","Munch, Inger Christine","Glümer, Charlotte","Faerch, Kristine","Kessel, Line","Larsen, Michael","Veiby, Nina C B B"],"cuid":["S01-000.00-502575"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"retinal vessel diameters and their relationship with cardiovascular risk and all cause mortality in the inter000000000099 eye study a 000000000015 year follow up","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1155/2016/6138659","version":"Published Version"},"id":"S01-000.00-502575","identifier":[{"id":"28053777","type":"pmid"},{"id":"85008931766","type":"scopus"},{"id":"PMC5174182","type":"pmcid"}],"ids":["ku-b6c36dce-7cdc-4c62-8c5b-931c616fba5c"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-30F07AE3267C08EDEDDF387CCD712A60"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1155/2016/6138659","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Dragana","key":"drobnjakpau","last":"Drobnjak","name":"Drobnjak, Dragana","rank":1,"rolecode":"pau"},{"affno":"1","first":"Inger Christine","key":"munchpau","last":"Munch","locid":"a1af1ee5-c4b4-44d8-a7af-b7c1ce0882ac","name":"Munch, Inger Christine","rank":2,"rolecode":"pau"},{"affno":"","first":"Charlotte","key":"glümerpau","last":"Glümer","name":"Glümer, Charlotte","rank":3,"rolecode":"pau"},{"affno":"","first":"Kristine","key":"faerchpau","last":"Faerch","name":"Faerch, Kristine","rank":4,"rolecode":"pau"},{"affno":"1","first":"Line","key":"kesselpau","last":"Kessel","locid":"3201472a-2f23-417e-bd01-a7950e2ff370","name":"Kessel, Line","orcid":"0000-0002-9375-1510","rank":5,"rolecode":"pau"},{"affno":"1","first":"Michael","key":"larsenpau","last":"Larsen","locid":"1d460214-c0db-4a15-a3a5-360c73746ed4","name":"Larsen, Michael","rank":6,"rolecode":"pau"},{"affno":"","first":"Nina C B B","key":"veibypau","last":"Veiby","name":"Veiby, Nina C B B","rank":7,"rolecode":"pau"}],"pmid":["28053777"],"pub":{"doi":"10.1155/2016/6138659","issn":["00071161","14682079"],"issn_org":["2090004X"],"journal":"British Journal of Ophthalmology","pages":"1-8","paperid":"6138659","status":"p","title":"British Journal of Ophthalmology","volume":"2016"},"review":"Peer Reviewed","scoID":["2-s2.0-85008931766"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-b6c36dce-7cdc-4c62-8c5b-931c616fba5c"],"src":["KU University of Copenhagen"],"title":"Retinal Vessel Diameters and Their Relationship with Cardiovascular Risk and All-Cause Mortality in the Inter99 Eye Study : A 15-Year Follow-Up","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-502575","year":"2016","yearsub":"2016"}
{"abstract":"Uligheden i sundhed er stigende i Danmark trods et mangeårigt politisk fokus på at bekæmpe den. Bogen bidrager med viden om de komplekse processer, hvori ulighed i sundhed opstår og reproduceres. Bogens kapitler handler bl.a. om: Mænd og sundhed Klasse, sundhed og subjekt Overvægt Mental sundhed, klasse og livshistorie Aktiv aldring Kræft Pårørende Fælles for bidragene er, at de anskuer ulighed i sundhed som et spørgsmål om social retfærdighed, menneskeværd og demokrati. Bogens fokus er på folkesundheden samt sundhed og sundhedsfremme som en sociokulturel praksis. Forfatterne bygger på den epidemiologiske forskning, men går skridtet videre og ser på baggrunden for uligheden på både et samfundsmæssigt, institutionelt og mikroniveau. Dermed sættes ulighedsproblematikken ind i et bredere samfundsmæssigt perspektiv, og forfatterne giver deres bud på, hvordan vi kan forstå ulighed i sundhed som del af et socialt liv, der finder sted både i hverdagslivet og i de institutionelle rammer. Bidragyderne er Sine Lehn-Christiansen, Anne Liveng, Be­ti­na Dybbroe, Mari Holen, Nicole Thualagant, Iben Charlotte Aamann, Birgitta Nordenhof, Camilla Bernild, Kevin Mogensen og Lisa Harryson.","author_count":7,"contributors":["Lehn-Christiansen, Sine","Liveng, Anne","Dybbroe, Betina","Holen, Mari","Thualagant, Nicole","Aamann, Iben Charlotte","Larsen, Birgitta Nordenhof"],"cuid":["S01-000.00-560519"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-RUC"]},"level3all":["DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"ulighed i sundhed nye humanistiske og samfundsvidenskabelige perspektiver","src":["ruc"],"src-code":["DI-U-RUC"],"type":"db","type-grp":["all","pub"]},"id":"S01-000.00-560519","identifier":[{"id":"85017109006","type":"scopus"}],"ids":["ruc-43b03889-8c84-4747-843d-9115dd0a2bf3"],"lang":"Danish","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-892839DB07E78F59FD6327074E1D713A"],"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of People and Technology"],"nora_code":"DI-U-RUC","used":1}],"person":[{"affno":"1","country":"dk","first":"Sine","key":"lehnchristiansenped","last":"Lehn-Christiansen","locid":"39821f0f-f69d-4aa1-8752-4ce3c39abed3","name":"Lehn-Christiansen, Sine","orcid":"0000-0002-2566-8766","rank":1,"role":"Editor","rolecode":"ped"},{"affno":"1","country":"dk","first":"Anne","key":"livengped","last":"Liveng","locid":"e4478baa-0741-4db7-904c-9994ba4a7fd9","name":"Liveng, Anne","orcid":"0000-0001-5920-3492","rank":2,"role":"Editor","rolecode":"ped"},{"affno":"1","country":"dk","first":"Betina","key":"dybbroeped","last":"Dybbroe","locid":"4c2ac8a1-6760-4309-b823-59bff493de56","name":"Dybbroe, Betina","rank":3,"role":"Editor","rolecode":"ped"},{"affno":"1","country":"dk","first":"Mari","key":"holenped","last":"Holen","locid":"f49069ca-ae6b-4b69-a8e9-a2179432aeae","name":"Holen, Mari","orcid":"0000-0002-9720-6608","rank":4,"role":"Editor","rolecode":"ped"},{"affno":"1","country":"dk","first":"Nicole","key":"thualagantped","last":"Thualagant","locid":"fba2a225-fd0b-4d03-8c02-4dfc847d9ae7","name":"Thualagant, Nicole","orcid":"0000-0002-5197-8979","rank":5,"role":"Editor","rolecode":"ped"},{"affno":"1","country":"dk","first":"Iben Charlotte","key":"aamannped","last":"Aamann","locid":"e9929153-ac32-4969-ba78-9a893db7adf4","name":"Aamann, Iben Charlotte","orcid":"0000-0001-7578-5568","rank":6,"role":"Editor","rolecode":"ped"},{"affno":"1","country":"dk","first":"Birgitta Nordenhof","key":"larsenped","last":"Larsen","locid":"b5198dda-f67b-4ddd-9c33-33054c2c6b4f","name":"Larsen, Birgitta Nordenhof","rank":7,"role":"Editor","rolecode":"ped"}],"pub":{"edition":"25","isbn":["9788771187113"],"issue":"1","pages":"279","place":"Frederiksberg","publisher":"Frydenlund Academic","series":"Sundhed, Samfund og Kultur","status":"p","volume":"177"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Roskilde University","Universities"],"PST":["Published"]},"sid":["ruc-43b03889-8c84-4747-843d-9115dd0a2bf3"],"src":["RUC Roskilde University"],"title":"Ulighed i sundhed : Nye humanistiske og samfundsvidenskabelige perspektiver","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-560519","year":"2016","yearsub":"2016"}
{"abstract":"Aims: To estimate alcohol consumption among Danish adults with diabetes and to investigate whether certain comorbidities are related to a high alcohol intake. Methods: A total of 162,283 participants responded to the Danish National Health Survey 2013 (questionnaire study, response rate 54.0%). Variables on the participants were extracted from the survey and 6.5% of respondents reported having diabetes. High alcohol consumption was defined as >21 (men) or >14 (women) standard drinks per week.  Results: High alcohol consumption was reported by 11.2 % of men and 4.3% of women with diabetes. In the women, this was fewer than among women without diabetes (odds ratio (OR) 0.65, 95% confidence interval (CI) 0.56–0.77, p<0.0001). Patients with diabetes had lower ORs for binge drinking (men OR 0.90, 95% CI 0.84–0.97, p=0.0039; women OR 0.79, 95% CI 0.70–0.89, p<0.0001) and lower ORs for having a problematic alcohol intake (men OR 0.80, 95% CI 0.75–0.86, p<0.0001; women OR 0.56, 95% CI 0.49–0.64, p<0.0001) compared with participants without diabetes. A larger proportion of participants with diabetes had not consumed alcohol within the last year (men 13.5%; women 28.2%) compared with participants without diabetes (men 6.0%; women 11.2%). Men with diabetes and a high consumption of alcohol had significantly lower ORs for myocardial infarction (OR 0.55, 95% CI 0.40–0.76, p =0.0003) and stroke (OR 0.70, 95% CI 0.49–1.00, p=0.0498).  Conclusions: This study suggests that Danish patients with diabetes are less prone to exhibit addictive behaviour and many abstain from alcohol. Fewer women with diabetes than without diabetes have an excessive drinking pattern. High alcohol consumption in men with diabetes correlates to a lower occurrence of cardiovascular events.","author_count":10,"contributors":["Jakobsen, Mathilde L.","Larsen, Julie Rask","Glumer, Charlote","Juel, Knud","Ekholm, Ola","Vilsbøll, Tina","Becker, Ulrik","Fink-Jensen, Anders"],"cuid":["S02-085.51-040398"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Alcohol","Binge drinking","Cardiovascular disease","Cross sectional study","Diabetes"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"alcohol consumption among patients with diabetes a survey based cross sectional study of danish adults with diabetes","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/84971455416","version":"Other Version"},"id":"S02-085.51-040398","identifier":[{"id":"84971455416","type":"scopus"},{"id":"27113964","type":"pmid"},{"id":"000377349500009","type":"wos"}],"ids":["ku-15058c64-c569-406a-93c2-3fb2987c5027","sdu-ad3b79b8-6f4c-4bc1-8a8a-0d5da60dfc0b"],"keyword":["Diabetes","alcohol","binge drinking","cardiovascular disease","cross-sectional study","high alcohol intake","problematic alcohol intake"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-91A3788C9CA0E2DEF599DF7229C312B3"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Research Center for Prevention and Health"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, National Institute of Public Health, Department of Health and Social Context"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Mathilde L.","key":"jakobsenpau","last":"Jakobsen","name":"Jakobsen, Mathilde L.","rank":1,"rolecode":"pau"},{"affno":"","first":"Julie Rask","key":"larsenpau","last":"Larsen","name":"Larsen, Julie Rask","rank":2,"rolecode":"pau"},{"affno":"","first":"Charlote","key":"glumerpau","last":"Glumer","name":"Glumer, Charlote","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Charlotte","key":"glümerpau","last":"Glümer","name":"Glümer, Charlotte","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Knud","key":"juelpau","last":"Juel","locid":"95a22bf7-54de-48e0-ab33-855002b210be","name":"Juel, Knud","orcid":"0000-0002-4134-1173","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Ola","key":"ekholmpau","last":"Ekholm","locid":"b59d640e-8087-46d7-8284-5a45e6ebd03f","name":"Ekholm, Ola","orcid":"0000-0002-5563-7098","rank":5,"rolecode":"pau"},{"affno":"3","first":"Tina Vilsbøll","key":"lauritsenpau","last":"Lauritsen","locid":"76773372-af8c-45a0-9447-a509cbf6d466","name":"Vilsbøll, Tina","name_org":"Lauritsen, Tina Vilsbøll","orcid":"0000-0002-0456-6787","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Tina","key":"vilsbøllpau","last":"Vilsbøll","name":"Vilsbøll, Tina","rank":6,"rolecode":"pau"},{"affno":"2 1","corresponding":null,"country":"dk","first":"Ulrik","key":"beckerpau","last":"Becker","locid":"c3675bf1-17cd-4bd5-adc0-3471e9a122d7","name":"Becker, Ulrik","orcid":"0000-0002-1678-7771","rank":7,"rolecode":"pau"},{"affno":"3","first":"Anders","key":"finkjensenpau","last":"Fink-Jensen","locid":"8ba4e682-1c5c-4989-b27c-a279403cbbeb","name":"Fink-Jensen, Anders","rank":8,"rolecode":"pau"}],"pmid":["27113964"],"pub":{"doi":"10.1177/1403494816645223","issn":["14034948","16511905"],"issn_org":["14034948"],"issue":"5","journal":"Scandinavian Journal of Public Health","pages":"517-524","publisher":"SAGE Publications","status":"p","title":"Scandinavian Journal of Public Health","volume":"44"},"review":"Peer Reviewed","scoID":["2-s2.0-84971455416"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-15058c64-c569-406a-93c2-3fb2987c5027","sdu-ad3b79b8-6f4c-4bc1-8a8a-0d5da60dfc0b"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Alcohol consumption among patients with diabetes : a survey-based cross-sectional study of Danish adults with diabetes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-085.51-040398","year":"2016","yearsub":"2016"}
{"abstract":"Background: Prevention of multi-morbidities following non-communicable diseases requires a systematic registration of adverse modifiable risk factors, including low physical fitness. The aim of the study was to establish criterion validity and reliability of a smartphone app (InterWalk) delivered fitness test in patients with type 2 diabetes. Methods: Patients with type 2 diabetes (N = 27, mean (SD) age 64.2 (5.9) years, BMI 30.0 (5.1) kg/m2, (30 % male)) completed a 7-min progressive walking protocol twice (with and without encouragement). VO2 during the test was assessed using indirect calorimetry and the acceleration (vector magnitude) from the smartphone was obtained. The vector magnitude was used to predict VO2peak along with the co-variates weight, height and sex. The validity of the algorithm was tested when the smartphone was placed in the right pocket of the pants or jacket. The algorithm was validated using leave-one-out cross validation. Test-retest reliability was tested in a subset of participants (N = 10). Results: The overall VO2peak prediction of the algorithm (R2) was 0.60 and 0.45 when the smartphone was placed in the pockets of the pants and jacket, respectively (p < 0.001). The mean bias (limits of agreement) in the cross validation was−0.4 (38) % (pants) and−0.1 (46) % (jacket). When the smartphone was placed in the jacket a significant intensity dependent bias (r = 0.5, p = 0.02) was observed. The test-retest intraclass correlations were 0.85 and 0.86 (p < 0.001), for the pants and jacket, respectively. No effects of encouragement were observed on test performance. Conclusion: In conclusion, the InterWalk Fitness Test is accurate and reliable for persons with type 2 diabetes when the smartphone is placed in the side pocket of the pants for. The test could give a fair estimate of the CRF in absence of a progressive maximal test during standardized conditions with the appropriate equipment.Trial registration: www.clinicaltrials.org (NCT02089477), first registered (prospectively) on March 14th 2014","author_count":11,"contributors":["Brinklov, Cecilie Fau","Thorsen, Ida Kær","Karstoft, Kristian","Brøns, Charlotte","Valentiner, Laura Staun","Langberg, Henning","Vaag, Allan","Nielsen, Jens Steen","Pedersen, Bente Klarlund","Ried-Larsen, Mathias"],"cuid":["S02-097.39-043380"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"keyword":["Exercise","Fitness","Reliability","Smartphone","Type 2 diabetes mellitus","Validity"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-OTH"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-OTH","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"criterion validity and reliability of a smartphone delivered sub maximal fitness test for people with type 000000000002 diabetes","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s13102-016-0056-7","version":"Published Version"},"id":"S02-097.39-043380","identifier":[{"id":"28174664","type":"pmid"},{"id":"85010218122","type":"scopus"},{"id":"000386708000001","type":"wos"},{"id":"PMC5290632","type":"pmcid"}],"ids":["ku-7083ae8c-ff11-4cb2-8afd-bd50dc1060ea","sdu-43bc4d90-ecea-4f39-b01a-e0b676931a98"],"keyword":["Exercise","Fitness","Reliability","Smartphone","Type 2 diabetes mellitus","Validity"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-39C378904B9124D131BA7D4B97B56266"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/123493777/Criterion_validity_and_reliability_of_a_smartphone.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s13102-016-0056-7","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/188957937/s13102_016_0056_7.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Section of Social Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"3","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Endocrinology (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"4","country":"dk","key":"other hospitals","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-OTH","l3nl":"Other Hospitals","l3nn":"Other Hospitals","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Hospitals","namevar":["Danish Diabetes Academy"],"nora_code":"DI-HO-OTH","used":1}],"person":[{"affno":"1","first":"Cecilie Fau","key":"brinklovpau","last":"Brinklov","name":"Brinklov, Cecilie Fau","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Cecilie Fau","key":"brinkløvpau","last":"Brinkløv","name":"Brinkløv, Cecilie Fau","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ida Kær","key":"thorsenpau","last":"Thorsen","name":"Thorsen, Ida Kær","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kristian","key":"karstoftpau","last":"Karstoft","name":"Karstoft, Kristian","rank":3,"rolecode":"pau"},{"affno":"1","first":"Charlotte","key":"brønspau","last":"Brøns","name":"Brøns, Charlotte","rank":4,"rolecode":"pau"},{"affno":"2","first":"Laura","key":"valentinerpau","last":"Valentiner","locid":"24d1ff54-7fff-47fc-9400-f9ca868cdc2a","name":"Valentiner, Laura Staun","name_org":"Valentiner, Laura","orcid":"0000-0001-7261-5950","rank":5,"rolecode":"pau"},{"affno":"2","country":"dk","first":"Henning","key":"langbergpau","last":"Langberg","locid":"aa9694cb-06fd-4f81-a6f7-c5862f8d3499","name":"Langberg, Henning","orcid":"0000-0001-8454-6534","rank":6,"rolecode":"pau"},{"affno":"2 1","first":"Allan Arthur","key":"vaagpau","last":"Vaag","locid":"4b68020d-63cf-4701-ad10-cbc4845d0f1c","name":"Vaag, Allan","name_org":"Vaag, Allan Arthur","rank":7,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Jens Steen","key":"nielsenpau","last":"Nielsen","locid":"dbe41314-5802-4a25-853c-1dd6986e2d58","name":"Nielsen, Jens Steen","orcid":"0000-0003-3179-1186","rank":8,"rolecode":"pau"},{"affno":"2 1","first":"Bente Klarlund","key":"pedersenpau","last":"Pedersen","locid":"5d38d54e-e0d1-4397-98ca-6d8c9b78606d","name":"Pedersen, Bente Klarlund","rank":9,"rolecode":"pau"},{"affno":"1 4","corresponding":null,"first":"Mathias","key":"riedlarsenpau","last":"Ried-Larsen","name":"Ried-Larsen, Mathias","rank":10,"rolecode":"pau"}],"pmid":["28174664"],"pub":{"doi":"10.1186/s13102-016-0056-7","issn":["20521847"],"journal":"BMC Sports Science, Medicine and Rehabilitation","paperid":"31","publisher":"BioMed Central","status":"p","title":"BMC Sports Science, Medicine and Rehabilitation","volume":"8"},"review":"Peer Reviewed","scoID":["2-s2.0-85010218122"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Other Hospitals","Universities","University of Copenhagen","University of Southern Denmark","danish diabetes academy"],"PST":["Published"]},"sid":["ku-7083ae8c-ff11-4cb2-8afd-bd50dc1060ea","sdu-43bc4d90-ecea-4f39-b01a-e0b676931a98"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Criterion validity and reliability of a smartphone delivered sub-maximal fitness test for people with type 2 diabetes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-097.39-043380","year":"2016","yearsub":"2016"}
{"abstract":"Promoting physical activity is a first-line choice of treatment for patients with type 2 diabetes (T2D). However, there is a need for more effective tools and technologies to facilitate structured lifestyle interventions and to ensure a better compliance, sustainability, and health benefits of exercise training in patients with T2D. The InterWalk initiative and its innovative application (app) for smartphones described in this study were developed by the Danish Centre for Strategic Research in T2D aiming at implementing, testing, and validating interval walking in patients with T2D in Denmark. The interval walking training approach consists of repetitive 3-minute cycles of slow and fast walking with simultaneous intensity guiding, based on the exercise capacity of the user. The individual intensity during slow and fast walking is determined by a short initial self-conducted and audio-guided fitness test, which combined with automated audio instructions strives to motivate the individual to adjust the intensity to the predetermined individualized walking intensities. The InterWalk app data are collected prospectively from all users and will be linked to the unique Danish nationwide databases and administrative registries, allowing extensive epidemiological studies of exercise in patients with T2D, such as the level of adherence to InterWalk training and long-term effectiveness surveys of important health outcomes, including cardiovascular morbidity and mortality. Currently, the InterWalk app has been downloaded by >30,000 persons, and the achieved epidemiological data quality is encouraging. Of the 9,466 persons providing personal information, 80% of the men and 62% women were overweight or obese (body mass index ≥25). The InterWalk project represents a contemporary technology-driven public health approach to monitor real-life exercise adherence and to propagate improved health through exercise intervention in T2D and in the general population.","author_count":11,"contributors":["Ried-Larsen, Mathias","Thomsen, Reimar Wernich","Berencsi, Klara","Brinkløv, Cecilie F","Brøns, Charlotte","Valentiner, Laura S","Karstoft, Kristian","Langberg, Henning","Vaag, Allan A","Pedersen, Bente Klarlund","Nielsen, Jens S"],"cuid":["S03-099.05-026367"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"keyword":["Journal Article"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"implementation of interval walking training in patients with type 000000000002 diabetes in denmark rationale design and baseline characteristics","src":["au","ku","sdu"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.2147/CLEP.S97303","version":"Published Version"},"id":"S03-099.05-026367","identifier":[{"id":"27354828","type":"pmid"},{"id":"84975296086","type":"scopus"},{"id":"PMC4908935","type":"pmcid"}],"ids":["au-bc766a1e-17ef-45ae-983c-9519a6fb738e","ku-6091bac1-2064-4bc0-aa94-97a4b1b1dd9b","sdu-3fc0ae20-2781-416c-a2d3-0b82b00d5be9"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-6-E95EF33F1D710AD619B936888D95733B"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/129609518/Implementation_of_interval_walking_training_in_patients_with_type_2_diabetes_in_Denmark.pdf","version":"Published Version"},{"access":"oa","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC4908935/pdf/clep-8-201.pdf","version":"Authors Final Version"},