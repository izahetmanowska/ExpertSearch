npau","last":"Lehmann Nielsen","locid":"c4494bba-787a-4306-be1f-eac1cdf252e9","name":"Nielsen, Kåre Lehmann","name_org":"Lehmann Nielsen, Kåre","orcid":"0000-0002-5598-4401","rank":10,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Thomas Ostenfeld","key":"larsenthomasostenfeldpau","last":"Larsen","locid":"bd958d52-71b6-4720-b30a-cc9305633b43","name":"Larsen, Thomas Ostenfeld","orcid":"0000-0002-3362-5707","rank":11,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Jens Christian","key":"frisvadjenschristianpau","last":"Frisvad","locid":"b2d4f948-9e1c-4f8c-9c02-05588bfa21b9","name":"Frisvad, Jens Christian","orcid":"0000-0002-0573-4340","rank":12,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Martin D.","key":"hagermartindpau","last":"Hager","name":"Hager, Martin D.","rank":13,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Ulrich S.","key":"schubertulrichspau","last":"Schubert","name":"Schubert, Ulrich S.","rank":14,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens","key":"muffjenspau","last":"Muff","locid":"31d59491-a0f2-44b7-aba4-6d1def771538","name":"Muff, Jens","orcid":"0000-0003-1082-3409","rank":15,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens Laurids","key":"sørensenjenslauridspau","last":"Sørensen","locid":"365188dd-0cdc-4c71-a590-2ccd261ae3df","name":"Sørensen, Jens Laurids","orcid":"0000-0002-2392-5343","rank":16,"rolecode":"pau"}],"pub":{"doi":"10.1002/batt.202200365","issn":["25666223"],"issue":"1","journal":"Batteries and Supercaps","paperid":"e202200365","publisher":"Wiley-VCH","status":"p","title":"Batteries and Supercaps","volume":"6"},"review":"Peer Reviewed","scoID":["2-s2.0-85141201732"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["aau-7e176fac-9952-4649-8dfd-c011d890c750","dtu-a29207dc-21c5-40e4-b458-fb707520b68a"],"src":["AAU Aalborg University","DTU Technical University of Denmark"],"title":"Demonstrating the Use of a Fungal Synthesized Quinone in a Redox Flow Battery","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-006104","year":"2023","yearsub":"2023"}
{"abstract":"It has recently been established that myosin, the molecular motor protein, is able to exist in two conformations in relaxed skeletal muscle. These conformations are known as the super-relaxed (SRX) and disordered-relaxed (DRX) states and are finely balanced to optimize ATP consumption and skeletal muscle metabolism. Indeed, SRX myosins are thought to have a 5- to 10-fold reduction in ATP turnover compared with DRX myosins. Here, we investigated whether chronic physical activity in humans would be associated with changes in the proportions of SRX and DRX skeletal myosins. For that, we isolated muscle fibers from young men of various physical activity levels (sedentary, moderately physically active, endurance-trained, and strength-trained athletes) and ran a loaded Mant-ATP chase protocol. We observed that in moderately physically active individuals, the amount of myosin molecules in the SRX state in type II muscle fibers was significantly greater than in age-matched sedentary individuals. In parallel, we did not find any difference in the proportions of SRX and DRX myosins in myofibers between highly endurance- and strength-trained athletes. We did however observe changes in their ATP turnover time. Altogether, these results indicate that physical activity level and training type can influence the resting skeletal muscle myosin dynamics. Our findings also emphasize that environmental stimuli such as exercise have the potential to rewire the molecular metabolism of human skeletal muscle through myosin.","author_count":22,"contributors":["Lewis, Christopher T.A.","Tabrizian, Lee","Nielsen, Joachim","Laitila, Jenni","Beck, Thomas","Olsen, Mathilde S.","Ognjanovic, Marija M.","Aagaard, Per","Hokken, Rune","Laugesen, Simon","Ingersen, Arthur","Andersen, Jesper L.","Soendenbroe, Casper","Helge, Jørn Wulff","Dela, Flemming","Larsen, Steen","Sahl, Ronni Eg","Rømer, Tue","Hansen, Mikkel Thunestvedt","Frandsen, Jacob","Suetta, Charlotte","Ochala, Julien"],"cuid":[