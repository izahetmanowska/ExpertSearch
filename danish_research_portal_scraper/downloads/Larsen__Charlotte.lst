otte Brandstrup","orcid":"0000-0002-9285-3099","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Durita Lyngsø","key":"svartápau","last":"Svartá","locid":"7d14a946-3c39-479f-9e88-0b5c3061f8e5","name":"Svartá, Durita Lyngsø","orcid":"0000-0002-8931-8386","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peter","key":"bjerregaardpau","last":"Bjerregaard","locid":"ef4a2fa7-9735-4b1e-a4fa-b1272def2cfc","name":"Bjerregaard, Peter","orcid":"0000-0001-7153-8447","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ingelise","key":"olesenpau","last":"Olesen","locid":"9c041339-f1ff-4dc1-ac52-077f3f6349c4","name":"Olesen, Ingelise","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Christina Viskum Lytken","key":"larsenpau","last":"Larsen","locid":"3ee738b1-09d1-4886-9ddf-67ca132997fe","name":"Larsen, Christina Viskum Lytken","orcid":"0000-0002-6245-4222","rank":5,"rolecode":"pau"}],"pub":{"pages":"45","publisher":"Syddansk Universitet. Statens Institut for Folkesundhed","status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-b4fbfa8a-2607-4e67-b6d9-bd44b32bcb6b"],"src":["SDU University of Southern Denmark"],"title":"Kommunal sundhedsprofil - Kommune Qeqertalik : Befolkningsundersøgelsen i Grønland 2018","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-625049","year":"2021","yearsub":"2021"}
{"abstract":"Malignant lymphoproliferative disorders collectively constitute a large fraction of the hematological cancers, ranging from indolent to highly aggressive neoplasms. Being a diagnostically important hallmark, clonal gene rearrangements of the immunoglobulins enable the detection of residual disease in the clinical course of patients down to a minute fraction of malignant cells. The introduction of next-generation sequencing (NGS) has provided unprecedented assay specificity, with a sensitivity matching that of polymerase chain reaction-based measurable residual disease (MRD) detection down to the 10 –6 level. Although reaching 10 –6 to 10 –7 is theoretically feasible, employing a sufficient amount of DNA and sequencing coverage is placed in the perspective of the practical challenges when relying on clinical samples in contrast to controlled serial dilutions. As we discuss, the randomness of subsampling must be taken into account to accommodate the sensitivity threshold—in terms of both the required number of cells and sequencing coverage. As a substantial part of the reviewed studies do not state the depth of coverage or even amount of DNA in some cases, we call for increased transparency to enable critical assessment of the MRD assays for clinical implementation and feasibility.","author_count":5,"contributors":["Hansen, Marcus Høy","Cédile, Oriane","Larsen, Thomas Stauffer","Abildgaard, Niels","Nyvold, Charlotte Guldborg"],"cuid":["S01-000.00-635190"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Hansen, Marcus Høy"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"perspective sensitive detection of residual lymphoproliferative disease by ngs and clonal rearrangements how low can you go","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.exphem.2021.03.005","version":"Published Version"},"id":"S01-000.00-635190","identifier":[{"id":"33823225","type":"pmid"},{"id":"85106588697","type":"scopus"}],"ids":["sdu-d850571a-b868-41de-8b9a-03855ecf47b8"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-8D2043E6B6A8E5B712A6F14FC731749C"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.exphem.2021.03.005","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/183614864/PIIS0301472X21001302.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Haematology (Odense)","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Pathology (Odense)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Marcus H","key":"hansenpau","last":"Hansen","locid":"066dac5b-cbf5-4b70-b136-3e5dd42e4bee","name":"Hansen, Marcus Høy","name_org":"Hansen, Marcus H","orcid":"0000-0003-3083-4850","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Oriane","key":"cédilepau","last":"Cédile","locid":"b2e3be48-c899-40b9-b01d-2bd23278dcf1","name":"Cédile, Oriane","orcid":"0000-0002-6632-8039","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Thomas S","key":"larsenpau","last":"Larsen","locid":"dd2de49b-c3d9-49cb-bb8d-e92119e0b2d1","name":"Larsen, Thomas Stauffer","name_org":"Larsen, Thomas S","orcid":"0000-0002-8418-6708","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Niels","key":"abildgaardpau","last":"Abildgaard","locid":"595418b9-29f8-4fd3-8663-1b32eab3451a","name":"Abildgaard, Niels","orcid":"0000-0001-6852-2014","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Charlotte G","key":"nyvoldpau","last":"Nyvold","locid":"ba584c2b-215e-421c-a6e6-c799c1b16b7c","name":"Nyvold, Charlotte Guldborg","name_org":"Nyvold, Charlotte G","orcid":"0000-0002-0411-7594","rank":5,"rolecode":"pau"}],"pmid":["33823225"],"pub":{"doi":"10.1016/j.exphem.2021.03.005","issn":["02569280","0301472X"],"issn_org":["0301472X"],"journal":"Experimental Hematology","pages":"14-24","publisher":"Elsevier","status":"p","title":"Experimental Hematology","volume":"98"},"review":"Peer Reviewed","scoID":["2-s2.0-85106588697"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-d850571a-b868-41de-8b9a-03855ecf47b8"],"src":["SDU University of Southern Denmark"],"title":"Perspective : sensitive detection of residual lymphoproliferative disease by NGS and clonal rearrangements-how low can you go?","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-635190","year":"2021","yearsub":"2021"}
{"abstract":"Aims: An in-depth understanding of the prognostic value of patient-reported outcomes (PRO) is essential to facilitate person-centred care in heart failure (HF). This study aimed to clarify the prognostic role of subjective mental and physical health status in patients with HF. Methods and results: Patients with HF were identified from the DenHeart Survey (n = 1499) and PRO data were obtained at hospital discharge, including the EuroQol five-dimensional questionnaire (EQ-5D), the HeartQoL, and the Hospital Anxiety and Depression Scale (HADS). Clinical baseline data were obtained from medical records and linked to nationwide registries with patient-level data on sociodemographics and healthcare contacts. Outcomes were all-cause and cardiovascular (CV) mortality, CV events, and HF hospitalization with 1- and 3-year follow-up. Analysing the PRO data on a continuous scale, a worse score in the following were associated with risk of all-cause and CV mortality after 1 year: the HeartQoL (adjusted hazard ratios (HRs) 1.91, 95% confidence interval (CI) 1.42-2.57 and 2.17, 95% CI 1.50-3.15, respectively), the EQ-5D (adjusted HRs 1.26, 95% CI 1.15-1.38 and 1.27, 95% CI 1.13-1.42, respectively), the HADS depression subscale (adjusted HRs 1.12, 95% CI 1.07-1.17 and 1.11, 95% CI 1.05-1.17, respectively), and the HADS anxiety subscale (adjusted HRs 1.08, 95% CI 1.03-1.13 and 1.09, 95% CI 1.04-1.15, respectively). Three-year results were overall in concordance with the 1-year results. A similar pattern was also observed for non-fatal outcomes. Conclusion: Health-related quality of life and symptoms of anxiety and depression at discharge were associated with all-cause and CV mortality at 1- and 3-year follow-up.","author_count":11,"contributors":["Rasmussen, Anne Ankerstjerne","Larsen, Signe Holm","Jensen, Martin","Berg, Selina Kikkenborg","Rasmussen, Trine Bernholdt","Borregaard, Britt","Thrysoee, Lars","Thorup, Charlotte Brun","Mols, Rikke Elmose","Wiggers, Henrik","Johnsen, Søren Paaske"],"cuid":["S01-000.00-701335"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Cardiovascular events","Cardiovascular mortality","Heart failure","Heart failure hospitalization","Patient reported outcomes"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CDR","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"prognostic impact of self reported health on clinical outcomes in patients with heart failure","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-701335","identifier":[{"id":"32232437","type":"pmid"},{"id":"85109166907","type":"scopus"}],"ids":["ku-0ce67476-3a76-47d9-9aa7-8959386e43ec"],"keyword":["Cardiovascular events","Cardiovascular mortality","Heart failure","Heart failure hospitalization","Patient-reported outcomes"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-3-7-118B10D4A544256E388D0EC02E96E902"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1},{"affno":"2","country":"dk","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University"],"nora_code":"DI-U-AAU","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal medicine: Cardiology"],"nora_code":"DI-U-KU","used":1},{"affno":"4","country":"dk","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["University of Southern Denmark"],"nora_code":"DI-U-SDU","used":1},{"affno":"5","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","first":"Anne Ankerstjerne","key":"rasmussenanneankerstjernepau","last":"Rasmussen","name":"Rasmussen, Anne Ankerstjerne","rank":1,"rolecode":"pau"},{"affno":"1","first":"Signe Holm","key":"larsensigneholmpau","last":"Larsen","name":"Larsen, Signe Holm","rank":2,"rolecode":"pau"},{"affno":"2","first":"Martin","key":"jensenmartinpau","last":"Jensen","name":"Jensen, Martin","rank":3,"rolecode":"pau"},{"affno":"3","first":"Selina Kikkenborg","key":"bergselinakikkenborgpau","last":"Berg","locid":"92d15fb6-c29f-4d38-88a4-53d28ecc9a13","name":"Berg, Selina Kikkenborg","rank":4,"rolecode":"pau"},{"affno":"3","first":"Trine Bernholdt","key":"rasmussentrinebernholdtpau","last":"Rasmussen","locid":"471f6481-10b9-44b8-9afb-1133795c2258","name":"Rasmussen, Trine Bernholdt","rank":5,"rolecode":"