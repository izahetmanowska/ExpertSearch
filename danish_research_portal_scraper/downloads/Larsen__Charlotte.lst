au-0adff025-3a0b-48c2-a1da-dbc5ea5c04bf","dtu-b771ace5-8d23-46c1-a472-bf128bb9e4da","ku-e243acf3-4582-4a55-aea1-082898bcdb16"],"src":["AAU Aalborg University","DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Identification of emulsifier potato peptides by bioinformatics : application to omega-3 delivery emulsions and release from potato industry side streams","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-098.64-000572","year":"2020","yearsub":"2020"}
{"abstract":"OBJECTIVE: Psychotic experiences affect more than 10% of children and often co-occur with nonpsychotic mental disorders. However, longitudinal studies of the outcome of psychotic experiences based on unbiased information on mental health service use and psychotropic medications are scarce. The authors investigated whether psychotic experiences at ages 11-12 predicted a psychiatric diagnosis or treatment with psychotropic medications by ages 16-17. METHODS: In a longitudinal register-based follow-up study of the Copenhagen Child Cohort 2000, a total of 1,632 children ages 11-12 were assessed for psychotic experiences in face-to-face interviews. The children were also assessed for mental disorders and IQ. National registries provided information on perinatal and sociodemographic characteristics, on psychiatric disorders diagnosed at child and adolescent mental health services, and on prescribed psychotropic medications through ages 16-17. RESULTS: Among children who had not been previously diagnosed, and after adjustment for sociodemographic and perinatal adversities and IQ, psychotic experiences at ages 11-12 predicted receiving a psychiatric diagnosis in child and adolescent mental health services before ages 16-17 (adjusted hazard ratio=3.13, 95% CI=1.93, 5.07). The risk was increased if the child met criteria for a co-occurring mental disorder (not diagnosed in mental health settings) at baseline compared with no psychotic experiences or diagnosis at baseline (adjusted hazard ratio=7.85, 95% CI=3.94, 15.63), but having psychotic experiences alone still marked a significantly increased risk of later psychiatric diagnoses (adjusted hazard ratio=2.76, 95% CI=1.48, 5.13). Similar patterns were found for treatment with psychotropic medications. CONCLUSIONS: Psychotic experiences in childhood predict mental health service use and use of psychotropic medications during adolescence. The study findings provide strong evidence that psychotic experiences in preadolescence index a transdiagnostic vulnerability for diagnosed psychopathology in adolescence.","author_count":9,"contributors":["Rimvall, Martin Køster","van Os, Jim","Verhulst, Frank","Wolf, Rasmus Trap","Larsen, Janne Tidselbak","Clemmensen, Lars","Skovgaard, Anne Mette","Rask, Charlotte Ulrikka","Jeppesen, Pia"],"cuid":["S03-099.73-017225"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"continent":["Europe, EU","Europe, Non-EU","OECD"],"country":["Netherlands","United Kingdom"],"glorg":["All Global Affiliations","Erasmus University Medical Center Rotterdam","King's College London","Maastricht University Medical Center+","University Medical Center Utrecht"],"keyword":["Adolescence","Childhood","Psychiatric Diagnoses","Psychotic experiences"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"mental health service use and psychopharmacological treatment following psychotic experiences in preadolescence","src":["au","ku","sdu"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1176/appi.ajp.2019.19070724","version":"Published Version"},"id":"S03-099.73-017225","identifier":[{"id":"85085264899","type":"scopus"},{"id":"32098486","type":"pmid"}],"ids":["au-3e373c56-15f3-4e38-84bb-5281ad0473d7","ku-9765102a-9faa-445c-8594-f431ec23f43a","sdu-e85d34c2-9ae9-4ba0-9fa8-efec48f907a7"],"keyword":["Adolescence","Childhood","Psychiatric Diagnoses","Psychotic Experiences"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-78B41FD6983EE11F7984DD07A71049D2"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1176/appi.ajp.2019.19070724","version":"Published Version"},{"access":"oa","type":"rem","url":"https://ajp.psychiatryonline.org/doi/pdf/10.1176/appi.ajp.2019.19070724","version":"Published Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"nl","key":"university medical center utrecht","loc":["Netherlands","Europe, EU","OECD"],"name":"University Medical Center Utrecht","used":1},{"affno":"3","country":"nl","key":"maastricht university medical center","loc":["Netherlands","Europe, EU","OECD"],"name":"Maastricht University Medical Center+","used":1},{"affno":"4","country":"gb","key":"king s college london","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"King's College London","used":1},{"affno":"5","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Region Hovedstadens Psykiatri"],"nora_code":"DI-HO-CAP","used":1},{"affno":"6","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Public Health, DaCHE - Danish Centre for Health Economics"],"nora_code":"DI-U-SDU","used":1},{"affno":"7","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Public Health, Department of Public Health - CIRRAU - Centre for Integrated Register-based Research","Aarhus University, Health, Department of Public Health, Department of Public Health - National Centre for Register-based Research"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","first":"Martin Køster","key":"rimvallpau","last":"Rimvall","locid":"6e26f3a9-f374-479b-8582-2f0395cb7a35","name":"Rimvall, Martin K.","name_org":"Rimvall, Martin Køster","rank":1,"rolecode":"pau"},{"affno":"2 3 4","corresponding":null,"first":"Jim","key":"vanospau","last":"van Os","name":"van Os, Jim","rank":2,"rolecode":"pau"},{"affno":"1","first":"Frank","key":"verhulstpau","last":"Verhulst","locid":"a5c82367-ad86-4992-a559-424fa3c26b8b","name":"Verhulst, Frank C.","name_org":"Verhulst, Frank","rank":3,"rolecode":"pau"},{"affno":"5 6","corresponding":null,"first":"Rasmus Trap","key":"wolfpau","last":"Wolf","locid":"370faf9a-a7f6-4211-99f6-c4de9d7d8a62","name":"Wolf, Rasmus Trap","orcid":"0000-0002-0466-300X","rank":4,"rolecode":"pau"},{"affno":"7","corresponding":null,"country":"dk","first":"Janne Tidselbak","key":"larsenpau","last":"Larsen","locid":"5e35426b-5cd7-438a-a11a-bfd44f63fbdf","name":"Larsen, Janne Tidselbak","orcid":"0000-0002-0385-1017","rank":5,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Lars","key":"clemmensenpau","last":"Clemmensen","locid":"ed40cc57-1c30-4ea5-ae35-d0aedb546a06","name":"Clemmensen, Lars","orcid":"0000-0002-1750-4649","rank":6,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Anne Mette","key":"skovgaardpau","last":"Skovgaard","locid":"16faee51-f101-47f9-8757-c611e52d7381","name":"Skovgaard, Anne Mette","orcid":"0000-0002-8793-8303","rank":7,"rolecode":"pau"},{"affno":"7","corresponding":null,"country":"dk","first":"Charlotte Ulrikka","key":"raskpau","last":"Rask","locid":"1e308742-df61-47da-83ce-53d8a7c774c3","name":"Rask, Charlotte Ulrikka","orcid":"0000-0002-7426-0353","rank":8,"rolecode":"pau"},{"affno":"1","first":"Pia","key":"jeppesenpau","last":"Jeppesen","locid":"2a1a09ff-cac8-4162-ab6f-ff07e9d1656f","name":"Jeppesen, Pia","rank":9,"rolecode":"pau"}],"pmid":["32098486"],"pub":{"doi":"10.1176/appi.ajp.2019.19070724","issn":["0002953X","11393475"],"issn_org":["0002953X"],"issue":"4","journal":"American Journal of Psychiatry","pages":"318-326","publisher":"American Psychiatric Association","status":"p","title":"American Journal of Psychiatry","title_org":"The American Journal of Psychiatry","volume":"177"},"review":"Peer Reviewed","scoID":["2-s2.0-85085264899"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Non-Profit Organisations","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Hospitals","Non-Profit Organisations","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-3e373c56-15f3-4e38-84bb-5281ad0473d7","ku-9765102a-9faa-445c-8594-f431ec23f43a","sdu-e85d34c2-9ae9-4ba0-9fa8-efec48f907a7"],"src":["AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Mental Health Service Use and Psychopharmacological Treatment Following Psychotic Experiences in Preadolescence","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-099.73-017225","year":"2020","yearsub":"2020"}
{"abstract":"Background: It is well-established that heart failure has a negative impact on quality of life. However, little is known about patient-related predictors of health-related quality of life, anxiety and depression, symptoms and illness perception among patients with heart failure. Aim: To study the association between patient-related predictors and patient-reported outcome measures at discharge from hospital in a cohort of patients with heart failure. Methods: We used data from 1506 patients with heart failure, participating in the national DenHeart Survey of patient-reported outcome measures in patients with heart disease. The potential patient-related predictors included demographic, administrative, clinical and socioeconomic factors. The patient-reported outcome measures included six questionnaires: the Short Form-12, the Hospital Anxiety and Depression Scale, the EuroQol five-dimensional, five-level questionnaire, the HeartQoL, the Brief Illness Perception Questionnaire and the Edmonton Symptom Assessment Scale. Data were linked to national patient registry data and medical records. We performed multivariable linear and logistic regression analyses. Results: In adjusted linear regression analyses we found that a length of hospital stay of >2 days was associated with worse scores across questionnaires, except for the Brief Illness Perception Questionnaire. Higher comorbidity level was associated with worse scores across all questionnaires, whereas low social support was associated with worse scores across questionnaires, except for the physical domain of the Short Form-12 and the HeartQoL global score. Conclusions: This study identified length of hospital stay > 2 days, a higher comorbidity level and low social support to be associated with worse scores across questionnaires at discharge from a cardiac-related hospitalisation in patients with heart failure.","author_count":18,"contributors":["Rasmussen, Anne A.","Johnsen, Søren Paaske","Berg, Selina K.","Rasmussen, Trine B.","Borregaard, Britt","Thrysoee, Lars","Thorup, Charlotte Brun","Mols, Rikke E.","Wiggers, Henrik","Larsen, Signe H."],"cuid":["S04-100.00-003048"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"corresponding_author":["Rasmussen, Anne A.","Rasmussen, Anne Ankerstjerne"],"keyword":["Anxiety","Association","Cross sectional","Depression","Health Status","Heart failure","Mortality","Patient reported outcomes","Quality of Life","Questionnaire","Support","Validation","patient related predictors"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"predictors of patient reported outcomes at discharge in patients with heart failure","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85085950375","version":"Other Version"},"funding_acknowledgement":["The authors disclosed receipt of the following financial support for the research, authorship, and/or publication of this article: This project was funded by The Danish Nurses’ Organization and the Danish Heart Foundation (grant number: 18-R124-A8454-22099)."],"id":"S04-100.00-003048","identifier":[{"id":"000538089000001","type":"wos"},{"id":"32493054","type":"pmid"},{"id":"85085950375","type":"scopus"}],"ids":["aau-3e1d1292-06ef-4391-9a70-b7adf2c9d364","au-4d9cc360-5ef6-42e7-830b-8a40f8aa68d2","ku-f79884a3-0c82-481a-b9e9-2ba7301805d6","sdu-c9d59b6c-b45b-4c93-ae50-8c8703587a23"],"keyword":["ANXIETY","ASSOCIATION","Cross-sectional","DEPRESSION","HEALTH-STATU