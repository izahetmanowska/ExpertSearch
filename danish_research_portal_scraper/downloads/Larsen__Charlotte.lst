100d6","name":"Jensen, Helene Ane","orcid":"0000-0002-4508-5023","rank":1,"rolecode":"pau"},{"affno":"1","first":"Anette","key":"boklundpau","last":"Boklund","locid":"b56cee2e-0320-4c3d-a360-6dc1f5b2ee67","name":"Boklund, Anette","orcid":"0000-0001-6359-3403","rank":2,"rolecode":"pau"},{"affno":"1","first":"Carsten","key":"kirkebypau","last":"Kirkeby","locid":"ea24c9a4-7aa6-40f3-9afb-0af19f1e962d","name":"Kirkeby, Carsten","orcid":"0000-0001-9292-5526","rank":3,"rolecode":"pau"},{"affno":"1","first":"Lene Jung","key":"kjærpau","last":"Kjær","locid":"b93ddd14-b340-4550-b3cf-eb9473b0d716","name":"Kjær, Lene Jung","orcid":"0000-0001-9659-4672","rank":4,"rolecode":"pau"},{"affno":"2","first":"Charlotte Kristiane","key":"hjulsagerpau","last":"Hjulsager","name":"Hjulsager, Charlotte Kristiane","rank":5,"rolecode":"pau"},{"affno":"1","first":"Lars","key":"larsenpau","last":"Larsen","locid":"135a9407-d29c-4508-8f79-978f5b295a15","name":"Larsen, Lars Erik","name_org":"Larsen, Lars","orcid":"0000-0003-0730-5555","rank":6,"rolecode":"pau"},{"affno":"1","first":"Søren Saxmose","key":"nielsenpau","last":"Nielsen","locid":"8d00f12a-fe80-48ba-96c2-6769b91281e7","name":"Nielsen, Søren Saxmose","orcid":"0000-0003-2417-0787","rank":7,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-e6add524-5a46-4c39-ada6-4ca3b6c8ef0e"],"src":["KU University of Copenhagen"],"title":"Risk factors for introduction of highly pathogenic avian influenza into holdings with poultry and other captive birds in Denmark","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-830117","year":"2024","yearsub":"2024"}
{"abstract":"Gold contact allergy is diagnosed by patch testing using gold chloride or gold sodium thiosulfate. These tests often show high positivity rates, but a direct correlation with dermatitis from everyday gold exposure is rare. The aim of this study was to investigate and estimate the current prevalence of gold contact allergy in dermatitis patients. We performed a systematic literature search in PubMed, Embase and Web of Science for studies reporting the prevalence of gold contact allergy in dermatitis patients and published between January 2010 and May 2024. Data extraction and quality assessment were performed, and pooled proportions were calculated using random effects models. Sixteen studies with 14 887 dermatitis patients were included. The pooled prevalence of gold contact allergy was 14.1% (95% confidence intervals: 9.5%–19.4%) with significant heterogeneity (I2 = 98.3%). High positivity rates with limited clinical relevance highlight the need for cautious interpretation. Even within the same country, studies find different prevalence rates. Standardized testing protocols and further research are needed to better understand and manage this allergy.","author_count":7,"contributors":["Jensen, Mikkel Bak","Larsen, Christoffer Kursawe","Isufi, Daniel","Seyed-Alinaghi, Farzad","Ahlström, Malin G.","Mortz, Charlotte G.","Johansen, Jeanne D"],"cuid":["S02-084.24-769220"],"filters":{"added":"2025-01","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Jensen, Mikkel Bak"],"keyword":["Allergic contact dermatitis","Contact allergy","Gold","Gold Sodium Thiosulfate","Patch test","gold chloride"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"prevalence of contact allergy to gold in dermatitis patients from 000000002010 to 000000002024 a systematic review and meta analysis","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1111/cod.14707","version":"Published Version"},"id":"S02-084.24-769220","identifier":[{"id":"85205044293","type":"scopus"},{"id":"39340195","type":"pmid"}],"ids":["ku-c77fdbc0-f02d-4831-a107-55feaaf3b00a","sdu-d86cccad-14df-443e-baec-dd5ff4adb4ae"],"keyword":["allergic contact dermatitis","contact allergy","gold","gold chloride","gold sodium thiosulfate","patch test"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-AA5428DCCADB2AA840C2ABEAB4AEAF60"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/276481946/Contact_Dermatitis_-_2024_-_Jensen_-_Prevalence_of_contact_allergy_to_gold_in_dermatitis_patients_from_2010_to_2024_A.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/411762907/Contact_Dermatitis_2024_Jensen_Prevalence_of_contact_allergy_to_gold_in_dermatitis_patients_from_2010_to_2024_A.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1111/cod.14707","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Herlev and Gentofte"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Dermatovenerology and allergy (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Dermatovenerology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Mikkel Bak","key":"jensenpau","last":"Jensen","name":"Jensen, Mikkel Bak","rank":1,"rolecode":"pau"},{"affno":"1","first":"Christoffer Kursawe","key":"larsenpau","last":"Larsen","name":"Larsen, Christoffer Kursawe","rank":2,"rolecode":"pau"},{"affno":"1","first":"Daniel","key":"isufipau","last":"Isufi","name":"Isufi, Daniel","rank":3,"rolecode":"pau"},{"affno":"1","first":"Farzad","key":"seyedalinaghipau","last":"Seyed-Alinaghi","name":"Seyed-Alinaghi, Farzad","rank":4,"rolecode":"pau"},{"affno":"1","first":"Malin G.","key":"ahlströmpau","last":"Ahlström","name":"Ahlström, Malin G.","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Charlotte G.","key":"mortzpau","last":"Mortz","locid":"57a8054d-bc43-426e-86f0-61403faaa1ff","name":"Mortz, Charlotte G.","orcid":"0000-0001-8710-0829","rank":6,"rolecode":"pau"},{"affno":"1 3","first":"Jeanne D.","key":"johansenpau","last":"Johansen","locid":"2caf86f2-1ce0-4314-835d-46bcfcf4e337","name":"Johansen, Jeanne D","name_org":"Johansen, Jeanne D.","rank":7,"rolecode":"pau"}],"pmid":["39340195"],"pub":{"doi":"10.1111/cod.14707","issn":["01051873","13966669"],"issn_org":["01051873"],"issue":"6","journal":"Contact Dermatitis","pages":"451-458","publisher":"Wiley","status":"p","title":"Contact Dermatitis","volume":"91"},"review":"Peer Reviewed","scoID":["2-s2.0-85205044293"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-c77fdbc0-f02d-4831-a107-55feaaf3b00a","sdu-d86cccad-14df-443e-baec-dd5ff4adb4ae"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Prevalence of contact allergy to gold in dermatitis patients from 2010 to 2024 : A systematic review and meta-analysis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-084.24-769220","year":"2024","yearsub":"2024"}
{"abstract":"In recent years, it has become apparent that imbalances in the gastrointestinal system can impact organs beyond the intestine such as the lungs. Given the established ability of probiotics to modulate the immune system by interacting with gastrointestinal cells, our research aimed to investigate whether administering the probiotic strain Bacillus subtilis-597 could mitigate the outcome of influenza virus infection in pigs. Pigs were fed a diet either with or without the probiotic strain B. subtilis-597 for 14 days before being intranasally inoculated with a swine influenza A H1N2 strain (1 C.2 lineage). Throughout the study, we collected fecal samples, blood samples, and nasal swabs to examine viral shedding and immune gene expression. After seven days of infection, the pigs were euthanized, and lung and ileum tissues were collected for gene expression analysis and pathological examination. Our findings indicate that the administration of B. subtilis-597 exhibit potential in reducing lung lesions, possibly attributable to a general suppression of the immune system as indicated by reduced C-reactive protein (CRP) levels in serum, decreased expression of interferon-stimulated genes (ISGs), and localized reduction of the inflammatory marker serum amyloid A (SAA) in ileum tissue. Notably, the immune-modulatory effects of B. subtilis-597 appeared to be unrelated to the gastrointestinal microbiota, as the composition remained unaltered by both the influenza infection and the administration of B. subtilis-597.","author_count":11,"contributors":["Winther, Katrine","Kristensen, Charlotte","Henriksen, Betina Lyngfeldt","Hansen, Lea Hübertz Birch","Ryt-Hansen, Pia","Vestergaard, Gisle","Skovgaard, Kerstin","Sandvang, Dorthe","Boll, Erik Juncker","Williams, Andrew R.","Larsen, Lars E."],"cuid":["S02-100.00-725055"],"filters":{"added":"2024-05","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Williams, Andrew R."],"keyword":["Bacillus subtilis","Innate immunity","Mucosal immunology","Pigs","Probiotics","Virus","influenza A"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-NOSI"],"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-PR-NOSI","DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"i bacillus subtilis i 000000000597 induces changes in lung pathology and inflammation during influenza a virus infection in pigs","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.vetmic.2024.110032","version":"Published Version"},"id":"S02-100.00-725055","identifier":[{"id":"38430715","type":"pmid"},{"id":"85186546769","type":"scopus"}],"ids":["dtu-8628bb17-4419-4e9c-bf4d-3d4658a4f86d","ku-059894af-8a9f-4656-ac6d-2bd1c816cedf"],"keyword":["Bacillus subtilis","Influenza A","Innate immunity","Mucosal immunology","Pigs","Probiotics","Virus"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-039DD8AFF1A3153BBF464EDC392FBE82"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/385519517/1_s2.0_S0378113524000543_main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/354650389/1-s2.0-S0378113524000543-main.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.vetmic.2024.110032","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"novonesis","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-NOSI","l3nn":"Novonesis","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Novonesis","namevar":["Chr. Hansen"],"nora_code":"DI-PR-NOSI","used":1},{"affno":"2","country":"dk","key"