rolecode":"pau"},{"affno":"","corresponding":null,"first":"Phil","key":"ayersphilpau","last":"Ayers","name":"Ayers, Phil","rank":13,"rolecode":"pau"}],"pub":{"doi":"10.1109/ssci.2015.158","isbn":["9781479975600"],"pages":"1102-1109","publisher":"IEEE","status":"p","title":"Computational Intelligence, 2015 IEEE Symposium Series on"},"review":"Peer Reviewed","scoID":["2-s2.0-84964937762"],"search":{"DAF":["All Artistic Higher Education Institutions","All Danish Affiliations","All Universities","Artistic Higher Education Institutions","DI-ALL","DI-ART","DI-ART-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["arkc-8a5ce1d1-e2e0-4c7d-9e51-2001d8744f9a","itu-4181dddd-1be3-4361-8109-ca1419e73d88"],"src":["ITU IT University of Copenhagen","Royal Danish Academy - Architecture, Design, Conservation"],"title":"Flora Robotica – Mixed Societies of Symbiotic Robot-Plant Bio-Hybrids","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-089.67-012432","year":"2015","yearsub":"2015"}
{"abstract":"In this paper we aim to develop a controller that allows a robot to traverse an structured environment. The approach we use is to decompose the environment into simple sub-environments that we use as basis for evolving the controller. Specifically, we decompose a narrow corridor environment into four different sub-environments and evolve controllers that generalize to traverse two larger environments composed of the sub-environments. We also study two strategies for presenting the sub-environments to the evolutionary algorithm: all sub-environments at the same time and in sequence. Results show that by using a sequence the evolutionary algorithm can find a controller that performs well in all sub-environments more consistently than when presenting all sub-environments together. We conclude that environment decomposition is an useful approach for evolving controllers for structured environments and that the order in which the decomposed sub-environments are presented in sequence impacts the performance of the evolutionary algorithm.","author_count":3,"contributors":["Moreno, Rodrigo","Faina, Andres","Støy, Kasper"],"cuid":["S01-000.00-382200"],"event":{"acronym":"EvoApplications","end":"2015-04-10","place":"Copenhagen, dk","start":"2015-04-08","title":"Evolutionary Computation in Robotics","year":"2015"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, South","OECD"],"country":["Colombia"],"glorg":["All Global Affiliations","National University of Colombia"],"keyword":["Environment decomposition","Evolutionary Robotics","Sequential evolution"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"evolving robot controllers for structured environments through environment decomposition","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/81825184/Evostar2015MFS.pdf","version":"Authors Final Version"},"id":"S01-000.00-382200","identifier":[{"id":"84925862610","type":"scopus"}],"ids":["itu-3ef876ab-33f2-4831-9df7-36273ad39522"],"keyword":["Environment decomposition","Evolutionary robotics","Sequential evolution"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-D9CBA7B3137818572AF65AFCBA3EBE37"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/81825184/Evostar2015MFS.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","country":"co","key":"national university of colombia","loc":["Colombia","America, South","OECD"],"name":"National University of Colombia","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data, Systems, and Robotics, Robotics, Evolution, and Art Lab","The Department, Software & Systems"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Rodrigo","key":"morenopau","last":"Moreno","name":"Moreno, Rodrigo","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Andres","key":"faiñapau","last":"Faiña","locid":"7dd48cfe-3069-4563-bef4-ef661c18387a","name":"Faina, Andres","name_org":"Faiña, Andres","orcid":"0000-0001-7288-6988","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kasper","key":"støypau","last":"Støy","locid":"2a9c0934-98ca-4101-b829-b88d77f6487e","name":"Støy, Kasper","orcid":"0000-0003-0179-2487","rank":3,"rolecode":"pau"}],"pub":{"eisbn":["9783319165493"],"isbn":["9783319165486"],"issn":["03029743"],"pages":"795-806","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","subtitle":"18th European Conference, EvoApplications 2015, Copenhagen, Denmark, April 8-10, 2015, Proceedings","title":"Applications of Evolutionary Computation","volume":"9028"},"review":"Peer Reviewed","scoID":["2-s2.0-84925862610"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-3ef876ab-33f2-4831-9df7-36273ad39522"],"src":["ITU IT University of Copenhagen"],"title":"Evolving Robot Controllers for Structured Environments Through Environment Decomposition","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382200","year":"2015","yearsub":"2015"}
{"abstract":"We present a robotic platform based on the open source RepRap 3D printer that can print and maintain chemical artificial life in the form of a dynamic, chemical droplet. The robot uses computer vision, a self-organizing map, and a learning program to automatically categorize the behavior of the droplet that it creates. The robot can then use this categorization to autonomously detect the current state of the droplet and respond. The robot is programmed to visually track the droplet and either inject more chemical fuel to sustain a motile state or introduce a new chemical component that results in a state change (e.g., division). Coupling inexpensive open source hardware with sensing and feedback allows for replicable real-time manipulation and monitoring of nonequilibrium systems that would be otherwise tedious, expensive, and error-prone. This system is a first step towards the practical confluence of chemical, artificial intelligence, and robotic approaches to artificial life.","author_count":5,"contributors":["Hanczyc, Martin","Parrilla, Juan M.","Nicholson, Arwen","Yanev, Kliment","Stoy, Kasper"],"cuid":["S02-095.74-038414"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD"],"corresponding_author":["Hanczyc, Martin"],"country":["Germany","Italy"],"glorg":["All Global Affiliations","Future Bits OpenTech UG","University of Trento"],"keyword":["3D printer","Artificial intelligence","Droplet","Protocell","Robot","Symbiosis"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-SDU"]},"level3all":["DI-U-ITU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"creating and maintaining chemical artificial life by robotic symbiosis","src":["itu","sdu"],"src-code":["DI-U-ITU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1162/ARTL_a_00151","version":"Published Version"},"id":"S02-095.74-038414","identifier":[{"id":"84922691692","type":"scopus"}],"ids":["itu-f864a56b-b0aa-4695-ae59-a36753cf1b5c","sdu-3b9790a6-8bcc-4d55-acce-df3d321dc9f4"],"keyword":["3D printer","Artificial intelligence","Droplet","Protocell","Robot","Symbiosis"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-800E430ABD3D57D0AE9D33F9CB5C150C"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82531464/artl_a_00151.pdf","version":"Published Version"},{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/129036786/Creating_and_maintaining_chemical_artificial_life_by_robotic_symbiosis.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1162/ARTL_a_00151","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Science, Department of Physics, Chemistry and Pharmacy"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"it","key":"university of trento","loc":["Italy","Europe, EU","OECD"],"name":"University of Trento","used":1},{"affno":"3","country":"de","key":"future bits opentech ug","loc":["Germany","Europe, EU","OECD"],"name":"Future Bits OpenTech UG","used":1},{"affno":"4","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data Science, Machine Learning","IT University of Copenhagen, Data, Systems, and Robotics, Robotics, Evolution, and Art Lab"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Martin M.","key":"hanczycpau","last":"Hanczyc","locid":"86a9009a-b777-4cfd-a72c-aa8f4e6d82c4","name":"Hanczyc, Martin","name_org":"Hanczyc, Martin M.","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Juan M.","key":"parrillapau","last":"Parrilla","locid":"da98857a-41ce-4f17-87e1-67396f305060","name":"Parrilla, Juan M.","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Arwen","key":"nicholsonpau","last":"Nicholson","locid":"4327f958-7fd6-49e7-975b-db8694f88c61","name":"Nicholson, Arwen","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Kliment","key":"yanevpau","last":"Yanev","name":"Yanev, Kliment","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Kasper","key":"støypau","last":"Støy","locid":"2a9c0934-98ca-4101-b829-b88d77f6487e","name":"Støy, Kasper","orcid":"0000-0003-0179-2487","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1162/artl_a_00151","issn":["10645462","15309185"],"issn_org":["10645462"],"issue":"1","journal":"Artificial Life","pages":"47-54","publisher":"MIT Press Journals","status":"p","title":"Artificial Life","volume":"21"},"review":"Peer Reviewed","scoID":["2-s2.0-84922691692"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["itu-f864a56b-b0aa-4695-ae59-a36753cf1b5c","sdu-3b9790a6-8bcc-4d55-acce-df3d321dc9f4"],"src":["ITU IT University of Copenhagen","SDU University of Southern Denmark"],"title":"Creating and Maintaining Chemical Artificial Life by Robotic Symbiosis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-095.74-038414","year":"2015","yearsub":"2015"}
{"abstract":"This paper presents experiments with a morphology-independent, life-long strategy for online learning of locomotion gaits. The experimental platform is a quadruped robot assembled from the LocoKit modular robotic construction kit. The learning strategy applies a stochastic optimization algorithm to optimize eight open parameters of a central pattern generator based gait implementation. We observe that the strategy converges in roughly ten minutes to gaits of similar or higher velocity than a manually designed gait and that the strategy readapts in the event of failed actuators. We also optimize offline the reachable space of a foot based on a reference design but finds that the reality gap hardens the successfully transference to the physical robot. To address this limitation, in future work we plan to study co-learning of morphological and control parameters directly on physical robots.","author_count":4,"contributors":["Christensen, David Johan","Larsen, Jørgen Christian","Stoy, Kasper"],"cuid":["S03-088.36-038180"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":3,"keyword":["Central Pattern Generators","Fault tolerance","Locomotion","Modular Robots","Morphology Optimization","Online learning","Reconfigurable Robots"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-ITU","DI-U-SDU"]},"level3all":["DI-U-DTU","DI-U-ITU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"fault tolerant gait learning and morphology optimization of a polymorphic walking robot","src":["dtu","itu","sdu"],"src-code":["DI-U-DTU","DI-U-ITU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s12530-013-9088-3","version":"Other Version"},"id":"S03-088.36-038180","identifier":[{"id":"84894542347","type":"scopus"}],"ids":["dtu-fc5fe660-7e2e