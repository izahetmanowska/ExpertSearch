t":"Heinrich","locid":"08c85002-6341-40a3-9046-b6222a08f965","name":"Heinrich, Mary Katherine","rank":1,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Sebastian","key":"vonmammenpau","last":"von Mammen","name":"von Mammen, Sebastian","rank":2,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Sebastian von","key":"mammenpau","last":"Mammen","name":"Mammen, Sebastian von","rank":2,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Daniel Nicolas","key":"hofstadlerpau","last":"Hofstadler","name":"Hofstadler, Daniel Nicolas","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mostafa","key":"wahbypau","last":"Wahby","name":"Wahby, Mostafa","rank":4,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Payam","key":"zahadatpau","last":"Zahadat","name":"Zahadat, Payam","rank":5,"rolecode":"pau"},{"affno":"6 7","corresponding":null,"first":"Tomasz","key":"skrzypczakpau","last":"Skrzypczak","name":"Skrzypczak, Tomasz","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mohammad","key":"divbandsooratipau","last":"Divband Soorati","name":"Divband Soorati, Mohammad","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mohammad Divband","key":"sooratipau","last":"Soorati","name":"Soorati, Mohammad Divband","rank":7,"rolecode":"pau"},{"affno":"6 7","corresponding":null,"first":"Rafal","key":"krelapau","last":"Krela","name":"Krela, Rafal","rank":8,"rolecode":"pau"},{"affno":"6 7","corresponding":null,"first":"Wojciech","key":"kwiatkowskipau","last":"Kwiatkowski","name":"Kwiatkowski, Wojciech","rank":9,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Thomas","key":"schmicklpau","last":"Schmickl","name":"Schmickl, Thomas","rank":10,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Phil","key":"ayrespau","last":"Ayres","locid":"809e3672-ddc8-44e7-8a1b-1c1309974305","name":"Ayres, Phil","orcid":"0000-0002-9266-065X","rank":11,"rolecode":"pau"},{"affno":"8","corresponding":null,"first":"Kasper","key":"støypau","last":"Støy","locid":"2a9c0934-98ca-4101-b829-b88d77f6487e","name":"Støy, Kasper","orcid":"0000-0003-0179-2487","rank":12,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Heiko","key":"hamannpau","last":"Hamann","name":"Hamann, Heiko","rank":13,"rolecode":"pau"}],"pub":{"doi":"10.1098/rsif.2019.0238","issn":["17425662","17425689"],"issn_org":["17425662"],"issue":"156","journal":"Journal of the Royal Society. Interface","status":"p","title":"Journal of the Royal Society. Interface","title_org":"Journal of The Royal Society Interface","volume":"16"},"review":"Peer Reviewed","scoID":["2-s2.0-85070269359"],"search":{"DAF":["All Artistic Higher Education Institutions","All Danish Affiliations","All Universities","Artistic Higher Education Institutions","DI-ALL","DI-ART","DI-ART-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["arkc-2f61f70f-9974-4ddd-86c2-49506a657f3f","itu-acd3a16c-1836-4ff8-8447-34f1f3375642"],"src":["ITU IT University of Copenhagen","Royal Danish Academy - Architecture, Design, Conservation"],"title":"Constructing Living Buildings : A Review of Relevant Technologies for a Novel Application of Biohybrid Robotics","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-091.84-666042","year":"2019","yearsub":"2019"}
{"abstract":"We have developed a robotic-system capable of performing routine liquid-handling experiments, as well as artificial chemical life experiments. Our platform consists of an actuation-layer on top, an experimental-layer in the middle, and a sensing-layer at the bottom. The actuation-layer comprises the robot-head and modules mounted on it. The modules, e.g. pipet-modules, OCT-scanner, extruder, PH-probe, are designed to perform actions on experiments. The head holds modules and moves in the horizontal plane. The experimental-layer holds the reaction vessels. The sensing-layer consists of a camera below the experimental-layer to monitor the experiment. It collects data from experiment, and provides feedback for robot to interact with experiment.","author_count":3,"contributors":["Nejatimoharrami, Farzad","Faina, Andres","Støy, Kasper"],"cuid":["S01-000.00-384016"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Artificial chemical life","Automated experimentation","Multi layer platform","Robotic liquid handling","Sensor feedback systems"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"a low cost open source cloud based liquid handling robotic platform for performing remote real time collaborative experiments","src":["itu"],"src-code":["DI-U-ITU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84069536/slas_2018.pdf","version":"Authors Final Version"},"id":"S01-000.00-384016","ids":["itu-bc363a50-a4b8-41de-af02-cf584ff04c6b"],"keyword":["Artificial chemical life","Automated experimentation","Multi-layer platform","Robotic liquid-handling","Sensor feedback systems"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-6552015A3E0124BC59C993F3DC62C9D1"],"oa_link":[{"access":"oa","type":"rem","url":"https://webinars.slas.org/products/a-low-cost-open-source-cloud-based-liquid-handling-robotic-platform-for-performing-remote-real-time-collaborative-experiments#tab-product_tab_overview","version":"Other Version"},{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84069536/slas_2018.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Data, Systems, and Robotics, Robotics, Evolution, and Art Lab"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Farzad","key":"nejatimoharramipau","last":"Nejatimoharrami","name":"Nejatimoharrami, Farzad","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andres","key":"fainapau","last":"Faina","locid":"7dd48cfe-3069-4563-bef4-ef661c18387a","name":"Faina, Andres","orcid":"0000-0001-7288-6988","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kasper","key":"støypau","last":"Støy","locid":"2a9c0934-98ca-4101-b829-b88d77f6487e","name":"Støy, Kasper","orcid":"0000-0003-0179-2487","rank":3,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-bc363a50-a4b8-41de-af02-cf584ff04c6b"],"src":["ITU IT University of Copenhagen"],"title":"A Low-Cost Open-Source Cloud-based Liquid Handling Robotic Platform for Performing Remote Real-Time Collaborative Experiments","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384016","year":"2018","yearsub":"2018"}
{"abstract":"An ongoing discussion in biology concerns whether intrinsic mortality, or senescence, is programmed or not. The death (i.e. removal) of an individual solution is an inherent feature in evolutionary algorithms that can potentially explain how intrinsic mortality can be beneficial in natural systems. This paper investigates the relationship between mutation rate and mortality rate with a steady state genetic algorithm that has a specific intrinsic mortality rate. Experiments were performed on a predefined deceptive fitness landscape, the hierarchical if-and-only-if function (H-IFF). To test whether the relationship between mutation and mortality rate holds for more complex systems, an agent-based spatial grid model based on the H-IFF function was also investigated. This paper shows that there is a direct correlation between the evolvability of a population and an indiscriminate intrinsic mortality rate to mutation rate ratio. Increased intrinsic mortality or increased mutation rate can cause a random drift that can allow a population to find a global optimum. Thus, mortality in evolutionary algorithms does not only explain evolvability, but might also improve existing algorithms for deceptive/rugged landscapes. Since an intrinsic mortality rate increases the evolvability of our spatial model, we bolster the claim that intrinsic mortality can be beneficial for the evolvability of a population.","author_count":5,"contributors":["Veenstra, Frank","de Prado Salas, Pablo González","Bongard, Josh","Støy, Kasper","Risi, Sebastian"],"cuid":["S01-000.00-384284"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Agent Based Spatial Grid Model","Deceptive Fitness Landscape","Evolutionary algorithms","Evolvability","Hierarchical If And Only If Function H IFF","Intrinsic Mortality","Intrinsic Mortality Rate","Mutation Rate","Senescence","Steady State Genetic Algorithm"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"intrinsic mortality governs evolvability","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1162/isal_a_00050","version":"Published Version"},"id":"S01-000.00-384284","ids":["itu-cdfc6ef3-ca56-4dd9-b3b6-f2b94054eaf8"],"keyword":["Agent-Based Spatial Grid Model","Deceptive Fitness Landscape","Evolutionary Algorithms","Evolvability","Hierarchical If-And-Only-If Function (H-IFF)","Intrinsic Mortality","Intrinsic Mortality Rate","Mutation Rate","Senescence","Steady State Genetic Algorithm"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-C35562CD3E62A8215513F064FCD69870"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1162/isal_a_00050","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/83658399/veenstra_alife18.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Frank","key":"veenstrapau","last":"Veenstra","name":"Veenstra, Frank","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Pablo González","key":"depradosalaspau","last":"de Prado Salas","name":"de Prado Salas, Pablo González","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Josh","key":"bongardpau","last":"Bongard","name":"Bongard, Josh","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kasper","key":"stoypau","last":"Stoy","locid":"2a9c0934-98ca-4101-b829-b88d77f6487e","name":"Støy, Kasper","name_org":"Stoy, Kasper","orcid":"0000-0003-0179-2487","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sebastian","key":"risipau","last":"Risi","locid":"a420ffb3-2ca6-4925-a25f-baaa5228fc15","name":"Risi, Sebastian","orcid":"0000-0003-3607-8400","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1162/isal_a_00050","pages":"242-249","publisher":"MIT Press","status":"p","subtitle":"ALIFE 2018","title":"Artificial Life Conference Proceedings"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-cdfc6ef3-ca56-4dd9-b3b6-f2b94054eaf8"],"src":["ITU IT University of Copenhagen"],"title":"Intrinsic Mortality Governs Evolvability","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384284","year":"2018","yearsub":"2018"}
{"abstract":"Key to our project flora robotica is the idea of creating a bio-hybrid system of tightly coupled natural plants and distributed robots to grow architectural artifacts and spaces. Our motivation with this ground research project is to lay a principled foundation towards the design and implementation of living architectural systems that provide functionalities beyond those of orthodox building practice, such as self-repair, material accumulation and self-organization. Plants and robots work together to create a living organism that is inhabited by human beings. User-defined design objectives help to steer the directional growth of the plants, but also the system's interactions with its inhabitants determine locations where growth is prohibited or desired (e.g., partitions, windows, occupiable space). We report our plant species selection process and aspects of living architecture. A leitmotif of our project is the rich concept of braiding: braids are produced by robots from continuous material and serve as both scaffolds and initial architectural artifacts before plants take over and grow the desired architecture. We use light and hormones as attraction stimuli and far-red light as repelling stimulus to influence the plants. Applied sensors range from simple proximity sensing to detect the presence of plants to sophisticated sensing technology, such as electrophysiology and measurements of sap flow. We conclude by discussing our anticipated final demonstrator that integrates key features of flora robotica, such as the continuous growth process of architectural artifacts and self-repair of living architecture.","author_count":16,"contributors":["Hamann, Heiko","Divband Soorati, Mohammad","Heinrich, Mary Katherine","Hofstadler, Daniel Nicolas","Kuksin, Igor","Veenstra, Frank","Wahby, Mostafa","Nielsen, Stig Anton","Risi, Sebastian","Skrzypczak, Tomasz","Zahadat, Payam","Wojtaszek, Przemyslaw","Støy, Kasper","Schmickl, Thomas","Kernbach, Serge","Ayres, Phil"],"cuid":["S01-000.00-126277"],"event":{"end":"2017-09-04","place":"Lyon, fr","start":"2017-09-04","title":"Living Architectures Workshop 2017","year":"2017"},"filters":{"added":"2023-01","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Austria","Germany","Poland"],"glorg":["Adam Mickiewicz University","All Global Affiliations","Cybertronica UG (Haftungsbeschrankt)","University of Graz","University of Paderborn"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-ART","DI-U"],"level3":{"ART":["DI-ART-ALL","DI-ART-RDKA"],"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-ART-RDKA","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"flora robotica an architectural system combining living natural plants and distributed robots","src":["arkc"],"src-code":["DI-ART-RDKA"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://arxiv.org/abs/1709.04291","version":"Authors Final Version"},"id":"S01-000.00-126277","ids":["arkc-23766292-0a13-4a7c-85f6-d872d12b7052"],"keyword":["No"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-DCD81E7B6B7AE9AFEF6564EB83A02550"],"oa_link":[{"access":"oa","type":"rem","url":"https://arxiv.org/abs/1709.04291","version":"Authors Final Version"}],"org":[{"affno":"1","country":"de","key":"university of paderborn","loc":["Germany","Europe, EU","OECD"],"name":"University of Paderborn","used":1},{"affno":"2","key":"royal danish academy architecture design conservation","l2":"DI-ART","l2n":"Artistic Higher Education Institutions","l3":"DI-ART-RDKA","l3nn":"Royal Danish Academy - Architecture, Design, Conservation","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Royal Danish Academy - Architecture, Design, Conservation","namevar":["Royal Danish Academy - Architecture, Design, Conservation, Royal Danish Academy - Architecture, Institute of Architecture and Technology","Royal Danish Academy - Architecture, Design, Conservation, Royal Danish Academy - Architecture, Institute of Architecture and Technology, CITA - Centre for Information Technology and Architecture","The Royal Danish Academy of Fine Arts, Schools of Architecture, Design and Conservation","The Royal Danish Academy of Fine Arts, Schools of Architecture, Design and Conservation, School of Architecture"],"nora_code":"DI-ART-RDKA","used":1},{"affno":"3","country":"at","key":"university of graz","loc":["Austria","Europe, EU","OECD"],"name":"University of Graz","used":1},{"affno":"4","country":"de","key":"cybertronica ug","loc":["Germany","Europe, EU","OECD"],"name":"Cybertronica UG (Haftungsbeschrankt)","used":1},{"affno":"5","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University, Robotics, Evolution, and Art Lab"],"nora_code":"DI-U-ITU","used":1},{"affno":"6","country":"pl","key":"adam mickiewicz university","loc":["Poland","Europe, EU","OECD"],"name":"Adam Mickiewicz University","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Heiko","key":"hamannpau","last":"Hamann","name":"Hamann, Heiko","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Mohammad","key":"divbandsooratipau","last":"Divband Soorati","name":"Divband Soorati, Mohammad","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Mary Katherine","key":"heinrichpau","last":"Heinrich","locid":"08c85002-6341-40a3-9046-b6222a08f965","name":"Heinrich, Mary Katherine","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Daniel Nicolas","key":"hofstadlerpau","last":"Hofstadler","name":"Hofstadler, Daniel Nicolas","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Igor","key":"kuksinpau","last":"Kuksin","name":"Kuksin, Igor","rank":5,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Frank","key":"veenstrapau","last":"Veenstra","name":"Veenstra, Frank","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mostafa","key":"wahbypau","last":"Wahby","name":"Wahby, Mostafa","rank":7,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Stig Anton","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Stig Anton","rank":8,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Sebastian","key":"risipau","last":"Risi","name":"Risi, Sebastian","rank":9,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Tomasz","key":"skrzypczakpau","last":"Skrzypczak","name":"Skrzypczak, Tomasz","rank":10,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Payam","key":"zahadatpau","last":"Zahadat","name":"Zahadat, Payam","rank":11,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Przemyslaw","key":"wojtaszekpau","last":"Wojtaszek","name":"Wojtaszek, Przemyslaw","rank":12,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Kasper","key":"støypau","last":"Støy","name":"Støy, Kasper","rank":13,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Thomas","key":"schmicklpau","last":"Schmickl","name":"Schmickl, Thomas","rank":14,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Serge","key":"kernbachpau","last":"Kernbach","name":"Kernbach, Serge","rank":15,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Phil","key":"ayrespau","last":"Ayres","locid":"809e3672-ddc8-44e7-8a1b-1c1309974305","name":"Ayres, Phil","orcid":"0000-0002-9266-065X","rank":16,"rolecode":"pau"}],"pub":{"publisher":"MIT Press","status":"p","subtitle":"the 14th European Conference on Artificial Life","title":"Proceedings of ECAL 2017"},"review":"Peer Reviewed","search":{"DAF":["All Artistic Higher Education Institutions","All Danish Affiliations","All Universities","Artistic Higher Education Institutions","DI-ALL","DI-ART","DI-ART-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["arkc-23766292-0a13-4a7c-85f6-d872d12b7052"],"src":["Royal Danish Academy - Architecture, Design, Conservation"],"title":"Flora robotica -- An Architectural System Combining Living Natural Plants and Distributed Robots","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-126277","year":"2017","yearsub":"2017"}
{"abstract":"Contemporary robots perform energy intensive tasks—e.g., manipulation and locomotion—making the development of energy autonomous robots challenging. Since plants are primary energy producers in natural ecosystems, we took plants as a source of inspiration for designing our robotics platform. This led us to investigate energy autonomy in robots through employing solar panels. As plants move slowly compared to other large terrestrial organisms, it is expected that plant-inspired robots can enable robotic applications, such as long-term monitoring and exploration, where energy consumption could be minimized. Since it is difficult to manually design robotic systems that adhere to full energy autonomy, we utilize evolutionary algorithms to automate the design and evaluation of energy harvesting robots. We demonstrate how artificial evolution can lead to the design and control of a modular plant-like robot. Robotic phenotypes were acquired through implementing an evolutionary algorithm, a generative encoding and modular building blocks in a simulation environment. The generative encoding is based on a context sensitive Lindenmayer-System (L-System) and the evolutionary algorithm is used to optimize compositions of heterogeneous modular building blocks in the simulation environment. Phenotypes that evolved from the simulation environment are in turn transferred to a physical robot platform. The robotics platform consists of five different types of modules: (1) a base module, (2) a cube module, (3) servo modules, and (4,5) two types of solar panel modules that are used to harvest energy. The control system for the platform is initially evolved in the simulation environment and afterward transferred to an actual physical robot. A few experiments were done showing the relationship between energy cost and the amount of light tracking that evolved in the simulation. The reconfigurable modular robots are eventually used to harvest light with the possibility to be reconfigured based on the needs of the designer, the type of usable modules, and/or the optimal configuration derived from the simulation environment. Long-term energy autonomy has not been tested in this robotics platform. However, we think our robotics platform can serve as a stepping stone toward full energy autonomy in modular robots.","author_count":4,"contributors":["Veenstra, Frank","Metayer, Chloe","Risi, Sebastian","Støy, Kasper"],"cuid":["S01-000.00-381465"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["France"],"glorg":["All Global Affiliations","IMT Mines Albi"],"keyword":["Artificial intelligence","Energy autonomy","Evolutionary algorithms","Modular Robots","plant inspired robots"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"toward energy autonomy in heterogeneous modular plant inspired robots through artificial evolution","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3389/frobt.2017.00043","version":"Published Version"},"id":"S01-000.00-381465","identifier":[{"id":"85061993683","type":"scopus"}],"ids":["itu-0d455fa4-2b14-4126-8121-b78dba84a1cd"],"keyword":["artificial intelligence","energy autonomy","evolutionary algorithms","modular robots","plant-inspired robots"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-B2CF021C00A49DDB6FE21EBA801C4747"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.3389/frobt.2017.00043","version":"Published Version"},{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82458405/veenstra_frontiers17_1_.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data, Systems, and Robotics, Robotics, Evolution, and Art Lab"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"fr","key":"imt mines albi","loc":["France","Europe, EU","OECD"],"name":"IMT Mines Albi","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Frank","key":"veenstrapau","last":"Veenstra","name":"Veenstra, Frank","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Chloe","key":"metayerpau","last":"Metayer","name":"Metayer, Chloe","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sebastian","key":"risipau","last":"Risi","locid":"a420ffb3-2ca6-4925-a25f-baaa5228fc15","name":"Risi, Sebastian","orcid":"0000-0003-3607-8400","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kasper","key":"stoypau","last":"Stoy","locid":"2a9c0934-98ca-4101-b829-b88d77f6487e","name":"Støy, Kasper","name_org":"Stoy, Kasper","orcid":"0000-0003-0179-2487","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.3389/frobt.2017.00043","issn":["22969144"],"journal":"Frontiers in Robotics and AI","paperid":"43","publisher":"Frontiers","status":"p","title":"Frontiers in Robotics and AI","volume":"4"},"review":"Peer Reviewed","scoID":["2-s2.0-85061993683"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-0d455fa4-2b14-4126-8121-b78dba84a1cd"],"src":["ITU IT University of Copenhagen"],"title":"Toward energy Autonomy in heterogeneous Modular Plant-Inspired Robots through Artificial evolution","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381465","year":"2017","yearsub":"2017"}
{"abstract":"In this paper we present EvoBot, a RepRap open-source 3D-printer modified to operate like a robot for culturing and maintaining Microbial Fuel Cells (MFCs). EvoBot is a modular liquid handling robot that has been adapted to host MFCs in its experimental layer, gather data from the MFCs and react on the set thresholds based on a feedback loop. This type of robot-MFC interaction, based on the feedback loop mechanism, will enable us to study further the adaptability and stability of these systems. To date, EvoBot has automated the nurturing process of MFCs with the aim of controlling liquid delivery, which is akin to a chemostat. The chemostat is a well-known microbiology method for culturing bacterial cells under controlled conditions with continuous nutrient supply. EvoBot is perhaps the first pioneering attempt at functionalizing the 3D printing technology by combining it with the chemostat methods. In this paper, we will explore the experiments that EvoBot has carried out so far and how the platform has been optimised over the past two years.","author_count":7,"contributors":["Theodosiou, Pavlina","Faina, Andres","Nejatimoharrami, Farzad","Støy, Kasper","Greenman, John","Melhuish, Chris","Ieropoulos, Ioannis"],"cuid":["S01-000.00-383221"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University of the West of England"],"keyword":["3D printer","Cathode","EvoBot","Microbial fuel cells","Rep Rap"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"evobot towards a robot chemostat for culturing and maintaining microbial fuel cells mfcs","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82085446/Evobot_Theodosiou_camera_ready.pdf","version":"Authors Final Version"},"id":"S01-000.00-383221","identifier":[{"id":"85145778573","type":"scopus"}],"ids":["itu-850b850c-378c-4992-ae13-22ca9c749ba1"],"keyword":["3D-printer","Cathode","EvoBot","Microbial Fuel Cells","Rep-Rap"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-9DBB518EB46B3C9E7A68CC605BDBFB22"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82085446/Evobot_Theodosiou_camera_ready.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","country":"gb","key":"university of the west of england","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of the West of England","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data, Systems, and Robotics, Robotics, Evolution, and Art Lab"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Pavlina","key":"theodosioupau","last":"Theodosiou","name":"Theodosiou, Pavlina","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Andres","key":"fainapau","last":"Faina","locid":"7dd48cfe-3069-4563-bef4-ef661c18387a","name":"Faina, Andres","orcid":"0000-0001-7288-6988","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Farzad","key":"nejatimoharramipau","last":"Nejatimoharrami","name":"Nejatimoharrami, Farzad","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kasper","key":"støypau","last":"Støy","locid":"2a9c0934-98ca-4101-b829-b88d77f6487e","name":"Støy, Kasper","orcid":"0000-0003-0179-2487","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"John","key":"greenmanpau","last":"Greenman","name":"Greenman, John","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Chris","key":"melhuishpau","last":"Melhuish","name":"Melhuish, Chris","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ioannis","key":"ieropoulospau","last":"Ieropoulos","name":"Ieropoulos, Ioannis","rank":7,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-319-63537-8_38","eisbn":["9783319635378"],"isbn":["9783319635361"],"issn":["03029743"],"pages":"453-464","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","subtitle":"Lecture Notes in Computer Science","title":"Proceedings of the 6th International Conference Living Machines 2017","volume":"10384"},"review":"Peer Reviewed","scoID":["2-s2.0-85145778573"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-850b850c-378c-4992-ae13-22ca9c749ba1"],"src":["ITU IT University of Copenhagen"],"title":"EvoBot: Towards a Robot-Chemostat for Culturing and Maintaining Microbial Fuel Cells (MFCs)","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383221","year":"2017","yearsub":"2017"}
{"abstract":"Robotic systems blend hardware and software in a holistic way that intrinsically raises many crosscutting concerns such as concurrency, uncertainty, and time constraints. These concerns make programming robotic systems challenging as expertise from multiple domains needs to be integrated conceptually and technically. Programming languages play a central role in providing a higher level of abstraction. This briefing presents a case study on the evolution of domain-specific languages based on modular robotics. The case study on the evolution of domain-specific languages is based on a series of DSL prototypes developed over five years for the domain of modular, self-reconfigurable robots.","author_count":11,"contributors":["Schultz, Ulrik Pagh","Bordignon, Mirko","Stoy, Kasper","Nordmann, Arne","Hochgeschwender, Nico","Wrede, Sebastian"],"cuid":["S01-000.00-575600"],"event":{"end":"2015-08-29","place":"Braga, pt","start":"2015-08-23","title":"5th Summer School on Grand Timely Topics in Software Engineering, GTTSE 2015","year":"2015"},"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"corresponding_author":["Schultz, Ulrik Pagh"],"country":["Germany"],"glorg":["All Global Affiliations","Bielefeld University","Bonn-Rhein-Sieg University","Frauenhofer IPA","Robert Bosch GmbH"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-SDU"]},"level3all":["DI-U-ITU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"dsls in robotics a case study in programming self reconfigurable robots","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85025154313","version":"Other Version"},"id":"S01-000.00-575600","identifier":[{"id":"85025154313","type":"scopus"}],"ids":["sdu-086fb701-f824-499d-bbf8-317454b5320b"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-825C79A01F54D1A7E7B28C1B11F64898"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Engineering, The Maersk Mc-Kinney Moller Institute","SDU, The Faculty of Engineering, The Maersk Mc-Kinney Moller Institute, SDU Software Engineering"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"de","key":"frauenhofer ipa","loc":["Germany","Europe, EU","OECD"],"name":"Frauenhofer IPA","used":1},{"affno":"3","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1},{"affno":"4","country":"de","key":"robert bosch gmbh","loc":["Germany","Europe, EU","OECD"],"name":"Robert Bosch GmbH","used":1},{"affno":"5","country":"de","key":"bonn rhein sieg university","loc":["Germany","Europe, EU","OECD"],"name":"Bonn-Rhein-Sieg University","used":1},{"affno":"6","country":"de","key":"bielefeld university","loc":["Germany","Europe, EU","OECD"],"name":"Bielefeld University","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Ulrik Pagh","key":"schultzpau","last":"Schultz","locid":"79a07bec-ac88-404c-8d6b-c9180214bcc6","name":"Schultz, Ulrik Pagh","orcid":"0000-0003-4119-2689","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mirko","key":"bordignonpau","last":"Bordignon","name":"Bordignon, Mirko","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Kasper","key":"stoypau","last":"Stoy","name":"Stoy, Kasper","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Arne","key":"nordmannpau","last":"Nordmann","name":"Nordmann, Arne","rank":4,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Nico","key":"hochgeschwenderpau","last":"Hochgeschwender","name":"Hochgeschwender, Nico","rank":5,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Sebastian","key":"wredepau","last":"Wrede","name":"Wrede, Sebastian","rank":6,"rolecode":"pau"},{"affno":"","first":"Jácome","key":"cunhapedh","last":"Cunha","name":"Cunha, Jácome","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"João P.","key":"fernandespedh","last":"Fernandes","name":"Fernandes, João P.","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Ralf","key":"lämmelpedh","last":"Lämmel","name":"Lämmel, Ralf","rank":9,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"João","key":"saraivapedh","last":"Saraiva","name":"Saraiva, João","rank":10,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Vadim","key":"zaytsevpedh","last":"Zaytsev","name":"Zaytsev, Vadim","rank":11,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-319-60074-1_5","eisbn":["9783319600741"],"isbn":["9783319600734"],"issn":["03029743"],"pages":"98-123","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","subtitle":"International Summer School GTTSE 2015, Tutorial Lectures","title":"Grand Timely Topics in Software Engineering"},"review":"Peer Reviewed","scoID":["2-s2.0-85025154313"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-086fb701-f824-499d-bbf8-317454b5320b"],"src":["SDU University of Southern Denmark"],"title":"DSLs in robotics : A case study in programming self-reconfigurable robots","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-575600","year":"2017","yearsub":"2017"}
{"abstract":"We introduce a robot developed to perform feedback-based experiments, such as droplet experiments, a common type of experiments in artificial chemical life research. These experiments are particularly well suited for automation because they often stretch over long periods of time, possibly hours, and often require that the human takes action in response to observed events such as changes in droplet size, count, shape, or clustering or declustering of multiple droplets. Our robot is designed to monitor long-term experiments and, based on the feedback from the experiment, interact with it. The combination of precise automation, accurately collected experiment data, and integrated analysis and modeling software makes real-time interaction with the experiment feasible, as opposed to traditional offline processing of experiments. Last but not least, we believe the low cost of our platform can promote artificial life research. Furthermore, prevalently, findings from an experiment will inspire redesign for novel experiments. In addition, the robot’s open-source software enables easy modification of experiments. We will cover two case studies for application of our robot in feedback-based experiments and demonstrate how our robot can not only automate these experiments, collect data, and interact with the experiments intelligently but also enable chemists to perform formerly infeasible experiments.","author_count":3,"contributors":["Nejatimoharrami, Farzad","Faina, Andres","Støy, Kasper"],"cuid":["S01-000.00-384372"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Programming","Robotics and instrumentation","Systems engineering","automated biology","informatics and software"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"new capabilities of evobot a modular open source liquid handling robot","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82993190/8_Nejatimoharrami_2017_New_Capabilities_of_EvoBot.pdf","version":"Authors Final Version"},"id":"S01-000.00-384372","identifier":[{"id":"85029919460","type":"scopus"}],"ids":["itu-d35ec374-f477-4f94-a6be-11fa893a86d3"],"keyword":["Robotics and instrumentation","automated biology","informatics and software","programming","systems engineering"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-7C5FCFD52732800048827129168FE3D0"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82993190/8_Nejatimoharrami_2017_New_Capabilities_of_EvoBot.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data, Systems, and Robotics, Robotics, Evolution, and Art Lab"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Farzad","key":"nejatimoharramipau","last":"Nejatimoharrami","name":"Nejatimoharrami, Farzad","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andres","key":"fainapau","last":"Faina","locid":"7dd48cfe-3069-4563-bef4-ef661c18387a","name":"Faina, Andres","orcid":"0000-0001-7288-6988","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kasper","key":"støypau","last":"Støy","locid":"2a9c0934-98ca-4101-b829-b88d77f6487e","name":"Støy, Kasper","orcid":"0000-0003-0179-2487","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1177/2472630316689285","issn":["24726311"],"journal":"SLAS TECHNOLOGY","pages":"1-7","publisher":"Sage Publishing","status":"p","title":"SLAS TECHNOLOGY"},"review":"Peer Reviewed","scoID":["2-s2.0-85029919460"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-d35ec374-f477-4f94-a6be-11fa893a86d3"],"src":["ITU IT University of Copenhagen"],"title":"New Capabilities of EvoBot, A Modular, Open-Source Liquid-Handling Robot","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384372","year":"2017","yearsub":"2017"}
{"author_count":4,"contributors":["Veenstra, Frank","Faina, Andres","Støy, Kasper","Risi, Sebastian"],"cuid":["S01-000.00-384612"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"nr","rtype":["clu"],"sorti":"evolving simulated modular robots","src":["itu"],"src-code":["DI-U-ITU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82063888/evolving_simulated_modular_2_.pdf","version":"Published Version"},"id":"S01-000.00-384612","ids":["itu-e2ffe95a-13e7-4f08-953f-1ab046df2343"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-208C249102894E0C102E06D0723BE104"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82063888/evolving_simulated_modular_2_.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data, Systems, and Robotics, Robotics, Evolution, and Art Lab"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Frank","key":"veenstrapau","last":"Veenstra","name":"Veenstra, Frank","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andres","key":"fainapau","last":"Faina","locid":"7dd48cfe-3069-4563-bef4-ef661c18387a","name":"Faina, Andres","orcid":"0000-0001-7288-6988","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kasper","key":"støypau","last":"Støy","locid":"2a9c0934-98ca-4101-b829-b88d77f6487e","name":"Støy, Kasper","orcid":"0000-0003-0179-2487","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sebastian","key":"risipau","last":"Risi","locid":"a420ffb3-2ca6-4925-a25f-baaa5228fc15","name":"Risi, Sebastian","orcid":"0000-0003-3607-8400","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-e2ffe95a-13e7-4f08-953f-1ab046df2343"],"src":["ITU IT University of Copenhagen"],"title":"Evolving Simulated Modular Robots","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384612","year":"2017","yearsub":"2017"}
{"abstract":"Modular robots oer an important benet in evolutionary robotics, which is to quickly evaluate evolved morphologies and control systems in reality. However, articial evolution of simulated modular robotics is a dicult and time consuming task requiring signicant computational power. While articial evolution in virtual creatures has made use of powerful generative encodings, here we investigate how a generative encoding and direct encoding compare for the evolution of locomotion in modular robots when the number of robotic modules changes. Simulating less modules would decrease the size of the genome of a direct encoding while the size of the genome of the implemented generative encoding stays the same. We found that the generative encoding is signi cantly more ecient in creating robot phenotypes in the initial stages of evolution when simulating a maximum of 5, 10, and 20 modules. This not only conrms that generative encodings lead to decent performance more quickly, but also that when simulating just a few modules a generative encoding is more powerful than a direct encoding for creating robotic structures. Over longer evolutionary time, the dierence between the encodings no longer becomes statistically signicant. This leads us to speculate that a combined approach { starting with a generative encoding and later implementing a direct encoding { can lead to more ecient evolved designs.","author_count":4,"contributors":["Veenstra, Frank","Faina, Andres","Risi, Sebastian","Støy, Kasper"],"cuid":["S01-000.00-382184"],"event":{"acronym":"EvoApplications","end":"2017-04-21","place":"Amsterdam, nl","start":"2017-04-19","title":"Evostar 2017","year":"2017"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Direct Generative Encodings","Evolutionary algorithms","Modular Robots"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"evolution and morphogenesis of simulated modular robots a comparison between a direct and generative encoding","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/81921390/Veenstra2017_EvolutionAndMorphogenesisofSimulatedModularRobots.pdf","version":"Authors Final Version"},"id":"S01-000.00-382184","identifier":[{"id":"85017551035","type":"scopus"}],"ids":["itu-3e05d80f-13ca-438f-8722-697a1beda810"],"keyword":["Direct & Generative Encodings","Evolutionary Algorithms","Modular Robots"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-F7119E100722104C4A9A7E083622E1A9"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/81921390/Veenstra2017_EvolutionAndMorphogenesisofSimulatedModularRobots.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data, Systems, and Robotics, Robotics, Evolution, and Art Lab"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Frank","key":"veenstrapau","last":"Veenstra","name":"Veenstra, Frank","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andres","key":"fainapau","last":"Faina","locid":"7dd48cfe-3069-4563-bef4-ef661c18387a","name":"Faina, Andres","orcid":"0000-0001-7288-6988","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Sebastian","key":"risipau","last":"Risi","locid":"a420ffb3-2ca6-4925-a25f-baaa5228fc15","name":"Risi, Sebastian","orcid":"0000-0003-3607-8400","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kasper","key":"støypau","last":"Støy","locid":"2a9c0934-98ca-4101-b829-b88d77f6487e","name":"Støy, Kasper","orcid":"0000-0003-0179-2487","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1007/978-3-319-55849-3_56","eisbn":["9783319558493"],"isbn":["9783319558486"],"issn":["03029743"],"publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","subtitle":"20th European Conference, EvoApplications 2017, Amsterdam, The Netherlands, April 19-21, 2017, Proceedings, Part I","title":"Applications of Evolutionary Computation"},"review":"Peer Reviewed","scoID":["2-s2.0-85017551035"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-3e05d80f-13ca-438f-8722-697a1beda810"],"src":["ITU IT University of Copenhagen"],"title":"Evolution and Morphogenesis of Simulated Modular Robots: A Comparison Between a Direct and Generative Encoding","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382184","year":"2017","yearsub":"2017"}
{"abstract":"We have developed a low-cost, open source robot to automate reactive liquid handling tasks. Specifically, the robot, called EvoBot, targets reactive manipulation of motile droplets, a task prevalent in artificial chemical life research. We address hardware design and software implementation of our robot and demonstrate EvoBot's reactive capability, extensibility, and ability to perform experiments in interaction with the user. EvoBot has a three layer design, 1) a moving head with plug'n'play modules such as syringes on top, 2) a transparent experimental layer, accommodating different chemical vessels in the middle, and 3) a camera as the sensing system at the bottom, providing a view of the experiment. From the raw camera image experiment specific data such as droplet size, position, speed, number, color, and shape are calculated. The computer vision system has an accuracy of 4% for droplet area calculation, and EvoBot an accuracy of 0.1 millimeters in positioning droplets on the experimental layer. EvoBot is able to detect a relevant change of behavior, and accordingly interact with the experiment, e.g. remove a specific droplet by absorbing it. Therefore EvoBot is capable of fully automating experiments, e.g. tracking a moving droplet and injecting a chemical at droplet center when the speed goes below a threshold. Eliminating the need for the presence of a human to perform the interaction is crucial as artificial chemical life experiments are commonly long lasting. EvoBot's application domain is extendable owing to a modular design of hardware, and open source software. Evobot's modular design enables support for different modules, e.g. syringe modules for liquid handling, grippers to reposition reaction vessels or dispose of them, sensor modules including temperature, pH, etc, as well as other potential modules based on experiment needs. EvoBot's application programming interface (API), a programming interface allowing researchers to build on top of the functionality of the robot, along with the computer vision API allow modification of experiments with a limited programming effort. This is significant as in the case of artificial chemical life experiments often findings from experiments inspire experimenters to modify the design of forthcoming experiments. In addition to fully automated experiments, there are experiments that require human robot cooperation. EvoBot supports an interactive mode, where the creativity of a human for novel experiments is coupled with the power of real time accurate computer processed data and precise liquid handling. For instance, EvoBot displays the distance from a clicked point to the center of a droplet on the experiment video, and can inject precisely at the desired point. In summary, due to its precision, EvoBot improves the quality of experimental laboratory data, and empowers chemists to push boundaries of artificial life research by performing formerly infeasible experiments because of their interactive and long lasting nature. Finally, as EvoBot is based on open-source hardware, the cheap price of the robot makes it affordable even for personal labs.","author_count":3,"contributors":["Nejatimoharrami, Farzad","Faina, Andres","Støy, Kasper"],"cuid":["S01-000.00-382920"],"event":{"end":"2016-01-27","place":"San Diego, us","start":"2016-01-23","title":"2016 Society for Lab Automation and Screening International Conference &amp; Exhibition","year":"2016"},"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Artificial chemical life","Computer vision in experiments","Liquid handling automation","Open source hardware","Robotics"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"an open source low cost robot for performing reactive liquid handling experiments","src":["itu"],"src-code":["DI-U-ITU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-382920","ids":["itu-6ee74762-9c83-4c66-8df1-15f1756498d3"],"keyword":["Artificial chemical life","Computer vision in experiments","Liquid handling automation","Open source hardware","Robotics"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-A3ABE0410F8808FECE55F27C98F1A89B"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Computer Science","IT University of Copenhagen, Data, Systems, and Robotics, Robotics, Evolution, and Art Lab","The Department, Software & Systems"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Farzad","key":"nejatimoharramipau","last":"Nejatimoharrami","name":"Nejatimoharrami, Farzad","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andres","key":"fainapau","last":"Faina","locid":"7dd48cfe-3069-4563-bef4-ef661c18387a","name":"Faina, Andres","orcid":"0000-0001-7288-6988","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kasper","key":"støypau","last":"Støy","locid":"2a9c0934-98ca-4101-b829-b88d77f6487e","name":"Støy, Kasper","orcid":"0000-0003-0179-2487","rank":3,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-6ee74762-9c83-4c66-8df1-15f1756498d3"],"src":["ITU IT University of Copenhagen"],"title":"An Open-Source, Low-Cost Robot for Performing Reactive Liquid Handling Experiments","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-382920","year":"2016","yearsub":"2016"}
{"abstract":"Self-organized construction with continuous, structured building material, as opposed to modular units, offers new challenges to the robot-based construction process and lends the opportunity for increased flexibility in constructed artifact properties, such as shape and deformation. As an example investigation, we look at continuous filaments organized into braided structures, within the context of bio-hybrids constructing architectural artifacts. We report the result of an early swarm robot experiment. The robots successfully constructed a braid in a self-organized process. The construction process can be extended by using different materials and by embedding sensors during the self-organized construction directly into the braided structure. In future work, we plan to apply dedicated braiding robot hardware and to construct sophisticated 3-d structures with local variability in patterns of filament interlacing.","author_count":8,"contributors":["Heinrich, Mary Katherine","Wahby, Mostafa","Divband Soorati, Mohammad","Nicolas Hofstadler, Daniel","Zahadat, Payam","Ayres, Phil","Støy, Kasper","Hamann, Heiko"],"cuid":["S01-000.00-126248"],"event":{"end":"2016-09-16","start":"2016-09-12","title":"2016 IEEE","year":"2016"},"filters":{"added":"2023-01","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Austria","Germany"],"glorg":["All Global Affiliations","University of Graz","University of Paderborn"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-ART","DI-U"],"level3":{"ART":["DI-ART-ALL","DI-ART-RDKA"],"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-ART-RDKA","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"self organized construction with continuous building material higher flexibility based on braided structures","src":["arkc"],"src-code":["DI-ART-RDKA"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://adk.elsevierpure.com/ws/files/62353185/Self_Organized_Construction_with_Continuous_Building_Material_Higher_Flexibility_based_on_Braided_Structures.pdf","version":"Published Version"},"id":"S01-000.00-126248","identifier":[{"id":"85011076110","type":"scopus"}],"ids":["arkc-21338902-87f5-4db4-83c1-11c12355bd9e"],"keyword":["No"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-6F4C3D464DA0EC949D1AB6FC4176571C"],"oa_link":[{"access":"oa","type":"loc","url":"https://adk.elsevierpure.com/ws/files/62353185/Self_Organized_Construction_with_Continuous_Building_Material_Higher_Flexibility_based_on_Braided_Structures.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"royal danish academy architecture design conservation","l2":"DI-ART","l2n":"Artistic Higher Education Institutions","l3":"DI-ART-RDKA","l3nn":"Royal Danish Academy - Architecture, Design, Conservation","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Royal Danish Academy - Architecture, Design, Conservation","namevar":["Royal Danish Academy - Architecture, Design, Conservation, Royal Danish Academy - Architecture, Institute of Architecture and Technology","Royal Danish Academy - Architecture, Design, Conservation, Royal Danish Academy - Architecture, Institute of Architecture and Technology, CITA - Centre for Information Technology and Architecture","The Royal Danish Academy of Fine Arts, Schools of Architecture, Design and Conservation","The Royal Danish Academy of Fine Arts, Schools of Architecture, Design and Conservation, School of Architecture"],"nora_code":"DI-ART-RDKA","used":1},{"affno":"2","country":"de","key":"university of paderborn","loc":["Germany","Europe, EU","OECD"],"name":"University of Paderborn","used":1},{"affno":"3","country":"at","key":"university of graz","loc":["Austria","Europe, EU","OECD"],"name":"University of Graz","used":1},{"affno":"4","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Mary Katherine","key":"heinrichpau","last":"Heinrich","locid":"08c85002-6341-40a3-9046-b6222a08f965","name":"Heinrich, Mary Katherine","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mostafa","key":"wahbypau","last":"Wahby","name":"Wahby, Mostafa","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Mohammad","key":"divbandsooratipau","last":"Divband Soorati","name":"Divband Soorati, Mohammad","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Daniel","key":"nicolashofstadlerpau","last":"Nicolas Hofstadler","name":"Nicolas Hofstadler, Daniel","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Payam","key":"zahadatpau","last":"Zahadat","name":"Zahadat, Payam","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Phil","key":"ayrespau","last":"Ayres","locid":"809e3672-ddc8-44e7-8a1b-1c1309974305","name":"Ayres, Phil","orcid":"0000-0002-9266-065X","rank":6,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Kasper","key":"støypau","last":"Støy","name":"Støy, Kasper","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Heiko","key":"hamannpau","last":"Hamann","name":"Hamann, Heiko","rank":8,"rolecode":"pau"}],"pub":{"pages":"154-159","status":"p","title":"Proceedings of 1st International Workshop on Self-Organising Construction (SOCO)"},"review":"Peer Reviewed","search":{"DAF":["All Artistic Higher Education Institutions","All Danish Affiliations","All Universities","Artistic Higher Education Institutions","DI-ALL","DI-ART","DI-ART-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},