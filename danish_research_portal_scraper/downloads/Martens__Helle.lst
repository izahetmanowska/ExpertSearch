h","name":"Smith, Joanne","rank":23,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Solène","key":"telliezpau","last":"Telliez","name":"Telliez, Solène","rank":24,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Karolina","key":"wikströmpau","last":"Wikström","name":"Wikström, Karolina","rank":25,"rolecode":"pau"}],"pub":{"doi":"10.17895/ices.pub.20473083","issn":["26181371"],"issue":"64","pages":"189","place":"Copenhagen, Denmark","publisher":"International Council for the Exploration of the Sea (ICES)","repno":"ICES Scientific Report, No. 64","series":"ICES Scientific Report","status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-94d1c0cf-b119-4aff-bc32-fb114a2972c7"],"src":["DTU Technical University of Denmark"],"title":"Workshop 2 on Age Reading of North Sea plaice (<i>Pleuronectes platessa</i>) (WKARP2; outputs from 2021 meeting)","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-348940","year":"2022","yearsub":"2022"}
{"abstract":"Hypothesis: Surface modification of lactic acid bacteria enhances their adsorption and aggregation at air–water interface and enables stabilization of microbubbles that spontaneously transform into water-filled colloidosomes, which can be further modified using LBL formulations. Experiments: The bacterial physicochemical properties were characterized using water contact angle (WCA) measurement, bacterial aggregation assay and zeta potential measurement. Cell viability was enumerated using plate-counting method. The LBL reinforcement of colloidosomes was examined by zeta potential measurement and the formed microstructure was investigated using bright-field microscopy, confocal laser scanning microscopy (CLSM) and scanning electron microscopy (SEM). Shell permeability of colloidosomes was evaluated using a dye release study. Findings: Bacteria surface-modified using octenyl succinic anhydride (OSA) expressed strong adsorption and aggregation at air–water interface when producing microbubbles. Bacteria with enhanced aggregation ability formed stable shells, enabling complete removal of air and air–water interface without shell disintegration. The formed colloidosomes were studied as they were, or were further reinforced by LBL deposition using polymer or hybrid formulations. Hybrid coating involved assembly of two bacterial species producing colloidosomes with low shell porosity. The findings can be exploited to organize different living bacteria into structured materials and to encapsulate and release substances of diverse sizes and surface properties.","author_count":7,"contributors":["Jiang, Xiaoyi","Martens, Helle Juel","Shekarforoush, Elhamalsadat","Muhammed, Musemma Kedir","Whitehead, Kathryn A.","Arneborg, Nils","Risbo, Jens"],"cuid":["S01-000.00-519847"],"filters":{"added":"2022-07","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"country":["United Kingdom"],"glorg":["All Global Affiliations","Manchester Metropolitan University"],"keyword":["Adsorption","Aggregation","Lactic acid bacteria","Layer by layer","Microbubbles","Octenyl succinic anhydride"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"multi species colloidosomes by surface modified lactic acid bacteria with enhanced aggregation properties","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.jcis.2022.04.136","version":"Published Version"},"id":"S01-000.00-519847","identifier":[{"id":"85129538963","type":"scopus"},{"id":"35526410","type":"pmid"}],"ids":["ku-d39e12d5-72a1-415e-ab2a-b7089406c293"],"keyword":["Adsorption","Aggregation","Colloidosome","Lactic acid bacteria","Layer-by-layer","Microbubbles","Octenyl succinic anhydride"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-B88BB93D31E26F0514876B560548594A"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.jcis.2022.04.136","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/362102512/1_s2.0_S0021979722007056_main.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Food Science, Ingredient and Dairy Technology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"gb","key":"manchester metropolitan university","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Manchester Metropolitan University","used":1}],"person":[{"affno":"1","first":"Xiaoyi","key":"jiangpau","last":"Jiang","locid":"257042e9-621a-4e75-b36b-8d4fc2767c0b","name":"Jiang, Xiaoyi","orcid":"0000-0003-2860-8010","rank":1,"rolecode":"pau"},{"affno":"","first":"Helle Jakobe","key":"martenspau","last":"Martens","locid":"cd7f808e-0b4a-4423-9846-d3a81d0fad26","name":"Martens, Helle Juel","name_org":"Martens, Helle Jakobe","orcid":"0000-0002-3011-4557","rank":2,"rolecode":"pau"},{"affno":"1","first":"Elhamalsadat","key":"shekarforoushpau","last":"Shekarforoush","locid":"a2675b0c-a9a4-4d7b-9753-bf32119c5720","name":"Shekarforoush, Elhamalsadat","rank":3,"rolecode":"pau"},{"affno":"1","first":"Musemma Kedir","key":"muhammedpau","last":"Muhammed","locid":"0fb66213-b8a1-4055-98c6-48b61a26fae1","name":"Muhammed, Musemma Kedir","rank":4,"rolecode":"pau"},{"affno":"2","first":"Kathryn A.","key":"whiteheadpau","last":"Whitehead","name":"Whitehead, Kathryn A.","rank":5,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Nils","key":"arneborgpau","last":"Arneborg","locid":"362a10c9-2cc4-4666-9788-883e0fd6ac3e","name":"Arneborg, Nils","orcid":"0000-0002-4323-5446","rank":6,"rolecode":"pau"},{"affno":"1","first":"Jens","key":"risbopau","last":"Risbo","locid":"52bf2e22-c91a-424d-a60a-7427c32fba34","name":"Risbo, Jens","rank":7,"rolecode":"pau"}],"pmid":["35526410"],"pub":{"doi":"10.1016/j.jcis.2022.04.136","issn":["00219797","10957103"],"issn_org":["00219797"],"journal":"Journal of Colloid and Interface Science","pages":"503-514","status":"p","title":"Journal of Colloid and Interface Science","volume":"622"},"review":"Peer Reviewed","scoID":["2-s2.0-85129538963"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-d39e12d5-72a1-415e-ab2a-b7089406c293"],"src":["KU University of Copenhagen"],"title":"Multi-species colloidosomes by surface-modified lactic acid bacteria with enhanced aggregation properties","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-519847","year":"2022","yearsub":"2022"}
{"abstract":"Palm kernel cake (PKC) is an abundant side stream that can only be added to non-ruminant feed in small concentrations due to its content of antinutritional factors, mainly galactomannan, which cannot be digested by non-ruminants. β-mannanases can be added to partially hydrolyze galactomannan to form mannose oligosaccharides, which are known to be prebiotic. We here investigate the action of a β-mannanase from B. subtilis on PKC by colorimetry, NMR and fluorescence microscopy. The amount of mannan oligosaccharides in solution was significantly increased by the β-mannanase and their degree of polymerization (DP) was significantly reduced. There was a dose-response behavior in that larger β-mannanase concentrations increased the amount of soluble mannose oligosaccharides while reducing their average DP. Using confocal immunofluorescence microscopy, solubilization of galactomannan in PKC was clearly visualized. Images show a clear disruption of the cellulose and galactomannan structures of the PKC cell walls. We thus show in this study that using commercial dosages of β-mannanase on PKC can lead to formation of prebiotic compounds. Thus, this study suggests that utilization of PKC in poultry feed formulation might be increased by addition of a β-mannanase and would improve the return on investment.","author_count":4,"contributors":["Gomez-Osorio, Luis-Miguel","Nielsen, Janni Ulnits","Martens, Helle Jakobe","Wimmer, Reinhard"],"cuid":["S02-100.00-001916"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"continent":["America, North","America, South","OECD"],"corresponding_author":["Wimmer, Reinhard"],"country":["Colombia","United States"],"glorg":["All Global Affiliations","Alura Animal Health and Nutrition","Alura Innovation Labs","Universidad de Antioquia"],"keyword":["Cage effect","Mannan","Mannan oligosaccharides","Mannanase","Non starch polysaccharides","Palm kernel","Prebiotic"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-AAU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"upgrading the nutritional value of pkc using a bacillus subtilis derived monocomponent β mannanase","src":["aau","ku"],"src-code":["DI-U-AAU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/molecules27020563","version":"Published Version"},"id":"S02-100.00-001916","identifier":[{"id":"PMC8781566","type":"pmcid"},{"id":"85122975109","type":"scopus"},{"id":"35056877","type":"pmid"}],"ids":["aau-25e9cd3f-49c6-4e64-8ce4-ae7bfd54bec3","ku-954deeae-685e-45fb-be6e-3e3a097577f0"],"keyword":["Cage effect","Mannan","Mannan oligosaccharides","Non-starch polysaccharides","Palm kernel","Prebiotic","β-mannanase"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-FDC5417D7DD28039201D04328D070874"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/molecules27020563","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/297386781/molecules_27_00563.pdf","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/482619000/molecules_27_00563.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"us","key":"alura innovation labs","loc":["United States","America, North","OECD"],"name":"Alura Innovation Labs","used":1},{"affno":"2","country":"co","key":"universidad de antioquia","loc":["Colombia","America, South","OECD"],"name":"Universidad de Antioquia","used":1},{"affno":"3","country":"co","key":"alura animal health and nutrition","loc":["Colombia","America, South","OECD"],"name":"Alura Animal Health and Nutrition","used":1},{"affno":"4","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience, Section for Bioscience and Engineering"],"nora_code":"DI-U-AAU","used":1},{"affno":"5","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1 2 3","corresponding":null,"first":"Luis-Miguel","key":"gomezosoriopau","last":"Gomez-Osorio","name":"Gomez-Osorio, Luis-Miguel","rank":1,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Janni Ulnits","key":"nielsenpau","last":"Nielsen","locid":"75e17c86-46d2-43dc-8979-40e47d9da51a","name":"Nielsen, Janni Ulnits","rank":2,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Helle Jakobe","key":"martenspau","last":"Martens","name":"Martens, Helle Jakobe","orcid":"0000-0002-3011-4557","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Reinhard","key":"wimmerpau","last":"Wimmer","locid":"1d80e9f3-a391-40e6-a73a-84194aecbb6a","name":"Wimmer, Reinhard","orcid":"0000-0001-6942-5056","rank":4,"rolecode":"pau"}],"pmid":["35056877"],"pub":{"doi":"10.3390/molecules27020563","issn":["14203049","14315157"],"issn_org":["14203049"],"issue":"2","journal":"Molecules","paperid":"563","publisher":"MDPI AG","publisher_org":"M D P I AG","status":"p","title":"Molecules","volume":"27"},"review":"Peer Reviewed","scoID":["2-s2.0-85122975109"],"sdg":["12. Responsible Consumption and Production","13. Climate Action","All UN SDG Classification"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["aau-25e9cd3f-49c6-4e64-8ce4-ae7bfd54bec3","ku-954deeae-685e-45fb-be6e-3e3a097577f0"],"src":["AAU Aalborg University","KU University of Copenhagen"],"title":"Upgrading the Nutritional Value of PKC Using a Bacillus subtilis Derived Monocomponent β-Mannanase","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-001916","year":"2022","yearsub":"2022"}
{"abstract":"Fungi often adapt to environmental stress by altering their size, shape, or rate of cell division. These morphological changes require reorganization of the cell wall, a structural feature external to the cell membrane composed of highly interconnected polysaccharides and glycoproteins. Lytic polysaccharide monooxygenases (LPMOs) are copper-dependent enzymes that are typically secreted into the extracellular space to catalyze initial oxidative steps in the degradation of complex biopolymers such as chitin and cellulose. However, their roles in modifying endogenous microbial carbohydrates are poorly characterized. The CEL1 gene in the human fungal pathogen Cryptococcus neoformans (Cn) is predicted by sequence homology to encode an LPMO of the AA9 enzyme family. The CEL1 gene is induced by host physiological pH and temperature, and it is primarily localized to the fungal cell wall. Targeted mutation of the CEL1 gene revealed that it is required for the expression of stress response phenotypes, including thermotolerance, cell wall integrity, and efficient cell cycle progression. Accordingly, a cel1Δ deletion mutant was avirulent in two models of C. neoformans infection. Therefore, in contrast to LPMO activity in other microorganisms that primarily targets exogenous polysaccharides, these data suggest that CnCel1 promotes intrinsic fungal cell wall remodeling events required for efficient adaptation to the host environment.","author_count":11,"contributors":["Probst, Corinna","Hallas-Møller, Magnus","Ipsen, Johan Ø.","Brooks, Jacob T.","Andersen, Karsten","Haon, Mireille","Berrin, Jean-Guy","Martens, Helle Juel","Nichols, Connie B.","Johansen, Katja S.","Alspaugh, J. Andrew"],"cuid":["S01-000.00-457994"],"filters":{"added":"2022-12","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Europe, EU","OECD"],"country":["France","United States"],"glorg":["Aix-Marseille University","All Global Affiliations","Duke University","University of North Carolina at Chapel Hill"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"und","rtype":["clu"],"sorti":"a fungal lytic polysaccharide monooxygenase is required for cell wall integrity thermotolerance and virulence of the fungal human pathogen i cryptococcus neoformans i","src":["ku"],"src-code":["DI-U-KU"],"type":"dw","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1101/2022.10.25.513642","version":"Published Version"},"id":"S01-000.00-457994","ids":["ku-6c128c17-553e-4e00-9984-683b2458590c"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-87AF86F7A3C1A0ECF237E2784FE6E91F"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/327330759/A_fungal_lytic_polysaccharide.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1101/2022.10.25.513642","version":"Published Version"}],"org":[{"affno":"1","country":"us","key":"duke university","loc":["United States","America, North","OECD"],"name":"Duke University","used":1},{"affno":"2","country":"us","key":"university of north carolina at chapel hill","loc":["United States","America, North","OECD"],"name":"University of North Carolina at Chapel Hill","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Plant and Environmental Sciences, Section for Molecular Plant Biology"],"nora_code":"DI-U-KU","used":1},{"affno":"4","country":"fr","key":"aix marseille university","loc":["France","Europe, EU","OECD"],"name":"Aix-Marseille University","used":1}],"person":[{"affno":"1","first":"Corinna","key":"probstpau","last":"Probst","name":"Probst, Corinna","rank":1,"rolecode":"pau"},{"affno":"","first":"Magnus","key":"hallasmøllerpau","last":"Hallas-Møller","locid":"e787ea5d-609f-4779-8cb9-0100bac39c15","name":"Hallas-Møller, Magnus","orcid":"0000-0002-0900-2315","rank":2,"rolecode":"pau"},{"affno":"","first":"Johan Ø.","key":"ipsenpau","last":"Ipsen","locid":"e0de582a-8537-48a7-a725-d55f112d959e","name":"Ipsen, Johan Ø.","rank":3,"rolecode":"pau"},{"affno":"2","first":"Jacob T.","key":"brookspau","last":"Brooks","name":"Brooks, Jacob T.","rank":4,"rolecode":"pau"},{"affno":"3","first":"Karsten","key":"andersenpau","last":"Andersen","locid":"f36e3311-a0a1-41d2-b360-1dd360e4d529","name":"Andersen, Karsten","rank":5,"rolecode":"pau"},{"affno":"4","first":"Mireille","key":"haonpau","last":"Haon","name":"Haon, Mireille","rank":6,"rolecode":"pau"},{"affno":"4","first":"Jean-Guy","key":"berrinpau","last":"Berrin","name":"Berrin, Jean-Guy","rank":7,"rolecode":"pau"},{"affno":"","first":"Helle J.","key":"martenspau","last":"Martens","locid":"cd7f808e-0b4a-4423-9846-d3a81d0fad26","name":"Martens, Helle Juel","name_org":"Martens, Helle J.","orcid":"0000-0002-3011-4557","rank":8,"rolecode":"pau"},{"affno":"1","first":"Connie B.","key":"nicholspau","last":"Nichols","name":"Nichols, Connie B.","rank":9,"rolecode":"pau"},{"affno":"","first":"Katja S.","key":"johansenpau","last":"Johansen","locid":"52088224-13f5-4704-be1e-d37b6bd2f01c","name":"Johansen, Katja S.","orcid":"0000-0002-7587-5990","rank":10,"rolecode":"pau"},{"affno":"1","first":"J. Andrew","key":"alspaughpau","last":"Alspaugh","name":"Alspaugh, J. Andrew","rank":11,"rolecode":"pau"}],"pub":{"doi":"10.1101/2022.10.25.513642","pages":"70","publisher":"bioRxiv","status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-6c128c17-553e-4e00-9984-683b2458590c"],"src":["KU University of Copenhagen"],"title":"A fungal lytic polysaccharide monooxygenase is required for cell wall integrity, thermotolerance, and virulence of the fungal human pathogen <i>Cryptococcus neoformans</i>","type":"Working Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-457994","year":"2022","yearsub":"2022"}
{"abstract":"Fresh roselle are high in moisture and deteriorate easily, which makes drying important for extending shelf-life and increasing availability. This study investigated the influence of different drying methods (oven-drying, freeze-drying, vacuum-drying, and sun-drying) on the quality of ro-selle calyx expressed as physicochemical properties (moisture content, water activity, soluble solids, color), volatile compounds, and microstructure. Oven-drying and freeze-drying reduced moisture content most while vacuum-drying and sun-drying were not as efficient. All drying methods except sun-drying resulted in water activities low enough to ensure safety and quality. Vacuum-drying had no impact on color of the dry calyx and only small impact on color of water extract of calyx. Drying reduced terpenes, aldehydes, and esters but increased furans. This is expected to reduce fruity, floral, spicy, and green odors and increase caramel-like aroma. Sun-drying produced more ketones, alcohols, and esters. Scanning electron microscopy revealed that freeze-drying preserved the cell structure better, and freeze-dried samples resembled fresh samples most compared to other drying techniques. The study concludes that freeze-drying should be considered as a suitable drying method, especially with respect to preservation of structure.","author_count":3,"contributors":["Juhari, Nurul Hanisah","Martens, Helle Juel","Petersen, Mikael Agerlin"],"cuid":["S01-000.00-400583"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Asia, South"],"country":["Malaysia"],"glorg":["All Global Affiliations","University Putra Malaysia"],"keyword":["Drying","Dynamic headspace sampling","Microstructure","Physicochemical properties","Volatile compounds"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"changes in physicochemical properties and volatile compounds of roselle hibiscus sabdariffa l calyx during different drying methods","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3390/molecules26206260","version":"Published Version"},"id":"S01-000.00-400583","identifier":[{"id":"PMC8539385","type":"pmcid"},{"id":"85117512393","type":"scopus"},{"id":"34684840","type":"pmid"}],"ids":["ku-0bebe31d-1260-4738-92b2-ee8c0055b6c1"],"keyword":["Drying","Dynamic headspace sampling","Microstructure","Physicochemical properties","Roselle (Hibiscus sabdariffa L.)","Volatile compounds"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-F241FF92FDF940D2F2001CD3A779FEB1"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/283017654/molecules_26_06260_v2.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.3390/molecules26206260","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"my","key":"university putra malaysia","loc":["Malaysia","Asia, South"],"name":"University Putra Malaysia","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Food Science, Design and Consumer Behavior"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Nurul Hanisah","key":"juharipau","last":"Juhari","name":"Juhari, Nurul Hanisah","rank":1,"rolecode":"pau"},{"affno":"","first":"Helle Jakobe","key":"martenspau","last":"Martens","locid":"cd7f808e-0b4a-4423-9846-d3a81d0fad26","name":"Martens, Helle Juel","name_org":"Martens, Helle Jakobe","orcid":"0000-0002-3011-4557","rank":2,"rolecode":"pau"},{"affno":"2","first":"Mikael Agerlin","key":"petersenpau","last":"Petersen","locid":"9f4065a7-ea41-4357-b2ca-73903fd418c0","name":"Petersen, Mikael Agerlin","orcid":"0000-0002-4106-7696","rank":3,"rolecode":"pau"}],"pmid":["34684840"],"pub":{"doi":"10.3390/molecules26206260","issn":["14203049","14315157"],"issn_org":["14315157"],"issue":"20","journal":"Molecules","paperid":"6260","status":"p","title":"Molecules","volume":"26"},"review":"Peer Reviewed","scoID":["2-s2.0-85117512393"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-0bebe31d-1260-4738-92b2-ee8c0055b6c1"],"src":["KU University of Copenhagen"],"title":"Changes in physicochemical properties and volatile compounds of roselle (Hibiscus sabdariffa l.) calyx during different drying methods","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-400583","year":"2021","yearsub":"2021"}
{"abstract":"The percentage of respiratory and photorespiratory CO2 refixed in leaves (Pr) represents part of the CO2 used in photosynthesis. The importance of Pr as well as differences between species and functional types are still not well investigated. In this study, we examine how Pr differs between six temperate and boreal woody species: Betula pendula, Quercus robur, Larix decidua, Pinus sylvestris, Picea abies and Vaccinium vitis-idaea. The study covers early and late successional species, deciduous broadleaves, deciduous conifers, evergreen conifers and evergreen broadleaves. We investigated whether some species or functional types had higher refixation percentages than others, whether leaf traits could predict higher Pr and whether these traits and their impact on Pr changed during growing seasons. Photosynthesis CO2 response (A/Ci)-curves, measured early, mid and late season, were used to estimate and compare Pr, mesophyll resistance (rm) and stomatal resistance (rs) to CO2 diffusion. Additionally, light images and transmission electron microscope images were used to approximate the fraction of intercellular airspace and cell wall thickness. We found that evergreens, especially late successional species, refixed a significantly higher amount of CO2 than the other species throughout the entire growing season. In addition, rm, rs and leaf mass per area, traits that typically are higher in evergreen species, were also significantly, positively correlated with Pr. We suggest that this is due to higher rm decreasing diffusion of (photo) respiratory CO2 out of the leaf. Cell wall thickness had a positive effect on Pr and rm, while the fraction of intercellular airspace had no effect. Both were significantly different between evergreen conifers and other types. Our findings suggest that species with a higher rm use a greater fraction of mitochondria-derived CO2, especially when stomatal conductance is low. This should be taken into account when modeling the overall CO2 fertilization effect for terrestrial ecosystems dominated by high rm species.","author_count":4,"contributors":["Eckert, Diana","Martens, Helle Juel","Gu, Lianhong","Jensen, Anna Monrad"],"cuid":["S01-000.00-534080"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","Europe, EU","Nordic","OECD"],"country":["Sweden","United States"],"glorg":["All Global Affiliations","Linnaeus University","Oak Ridge National Laboratory"],"keyword":["Ecophysiology","Leaf mass per area","Photosynthesis"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"co sub 000000000002 sub refixation is higher in leaves of woody species with high mesophyll and stomatal resistances to co sub 000000000002 sub diffusion","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1093/treephys/tpab016","version":"Published Version"},"id":"S01-000.00-534080","identifier":[{"id":"85116489225","type":"scopus"},{"id":"33595079","type":"pmid"},{"id":"PMC8359682","type":"pmcid"}],"ids":["ku-eb907f4e-d5bc-4488-8866-ab0d508841fd"],"keyword":["Boreal trees","CO refixation","Ecophysiology","Leaf mass per area","Mesophyll resistance/conductance","Photosynthesis","Stomatal resistance/conductance"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-F7B95CA37B6D031E594483E650ED29B0"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/281983259/tpab016.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1093/treephys/tpab016","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"se","key":"linnaeus university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Linnaeus University","used":1},{"affno":"2","country":"us","key":"oak ridge national laboratory","loc":["United States","America, North","OECD"],"name":"Oak Ridge National Laboratory","used":1},{"affno":3,"key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"KU University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["KU University of Copenhagen"],"nora_code":"DI-U-KU"}],"person":[{"affno":"1","first":"Diana","key":"eckertpau","last":"Eckert","name":"Eckert, Diana","rank":1,"rolecode":"pau"},{"affno":"","first":"Helle Juel","key":"martenspau","last":"Martens","locid":"cd7f808e-0b4a-4423-9846-d3a81d0fad26","name":"Martens, Helle Juel","orcid":"0000-0002-3011-4557","rank":2,"rolecode":"pau"},{"affno":"2","first":"Lianhong","key":"gupau","last":"Gu","name":"Gu, Lianhong","rank":3,"rolecode":"pau"},{"affno":"1","first":"Anna Monrad","key":"jensenpau","last":"Jensen","name":"Jensen, Anna Monrad","rank":4,"rolecode":"pau"}],"pmid":["33595079"],"pub":{"doi":"10.1093/treephys/tpab016","issn":["0829318X","17584469"],"issn_org":["0829318X"],"issue":"8","journal":"Tree Physiology","pages":"1450-1461","status":"p","title":"Tree Physiology","volume":"41"},"review":"Peer Reviewed","scoID":["2-s2.0-85116489225"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","KU University of Copenhagen"],"PST":["Published"]},"sid":["ku-eb907f4e-d5bc-4488-8866-ab0d508841fd"],"src":["KU University of Copenhagen"],"title":"CO<sub>2</sub> refixation is higher in leaves of woody species with high mesophyll and stomatal resistances to CO<sub>2</sub> diffusion","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-534080","year":"2021","yearsub":"2021"}
{"abstract":"A Danish strain of the green microalgae Scenedesmus sp. was isolated, identified and characterized with respect to productivity under outdoor cultivation conditions at northern latitudes. The algae were cultivated outdoors in Denmark in closed tubular photobioreactors using only sunlight, simple inorganic nutrients and under ambient temperatures. The biomass composition was evaluated in terms of protein content and quality. The average volumetric and areal biomass productivity obtained for the Scenedesmus sp. isolate during outdoor cultivation was 0.083 g dry matter L−1 and 6.40 g dm m−2 day−1, respectively. Thus, productivities are comparable to data reported in the literature under similar conditions. A strain-specific nitrogen to protein conversion factor of 5.5 was determined for the Scenedesmus sp. strain enabling more accurate protein estimations from simple nitrogen determination methods like Kjeldahl analysis in the future. The protein content was determined to be 52.4% of dried biomass for this Scenedesmus strain. The sum of essential amino acids was 42% which is high compared to other microalgae. The results are compared and discussed in comparison to other microalgae and soybean as a common plant protein source.","author_count":6,"contributors":["Olsen, Malene Fog Lihme","Pedersen, Jakob Skov","Thomsen, Sune Tjalfe","Martens, Helle Juel","Petersen, Annette","Jensen, Poul Erik"],"cuid":["S01-000.00-492991"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Faculty of Science"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GTS","DI-U"],"level3":{"GTS":["DI-GTS-ALL","DI-GTS-DTCI"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-GTS-DTCI","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"outdoor cultivation of a novel isolate of the microalgae i scenedesmus sp i and the evaluation of its potential as a novel protein crop","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/279649844/Outdoor_cultivation_of_a_novel_isolate_of_the_microalgae_Scenedesmus_sp._and_the_evaluation_of_its_potential_as_a_novel_protein_crop_accepted_version_.pdf","version":"Authors Final Version"},"id":"S01-000.00-492991","identifier":[{"id":"85114869509","type":"scopus"},{"id":"34427928","type":"pmid"}],"ids":["ku-a6b597ea-b6d9-4091-ab58-f7fd6abacd98"],"keyword":["Faculty of Science"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-D1B2AE4A85FA17F4680C9711BF52D357"],"oa_link":[{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/279649844/Outdoor_cultivation_of_a_novel_isolate_of_the_microalgae_Scenedesmus_sp._and_the_evaluation_of_its_potential_as_a_novel_protein_crop_accepted_version_.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"dk","key":"danish technological institute","l2":"DI-GTS","l2n":"GTS Institutes","l3":"DI-GTS-DTCI","l3nn":"Danish Technological Institute","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Danish Technological Institute","namevar":["Technological Institute"],"nora_code":"DI-GTS-DTCI","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Food Science, Ingredient and Dairy Technology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Malene Fog Lihme","key":"olsenpau","last":"Olsen","name":"Olsen, Malene Fog Lihme","rank":1,"rolecode":"pau"},{"affno":"1","first":"Jakob Skov","key":"pedersenpau","last":"Pedersen","name":"Pedersen, Jakob Skov","rank":2,"rolecode":"pau"},{"affno":"","first":"Sune Tjalfe","key":"thomsenpau","last":"Thomsen","locid":"409a6b0a-26cb-47b9-a1b4-f9b5900f8813","name":"Thomsen, Sune Tjalfe","orcid":"0000-0001-8908-9977","rank":3,"rolecode":"pau"},{"affno":"","first":"Helle J.","key":"martenspau","last":"Martens","locid":"cd7f808e-0b4a-4423-9846-d3a81d0fad26","name":"Martens, Helle Juel","name_org":"Martens, Helle J.","orcid":"0000-0002-3011-4557","rank":4,"rolecode":"pau"},{"affno":"1","first":"Annette","key":"petersenpau","last":"Petersen","name":"Petersen, Annette","rank":5,"rolecode":"pau"},{"affno":"2","first":"Poul Erik","key":"jensenpau","last":"Jensen","locid":"cb8fdf4a-6052-43b4-b731-384346885e4d","name":"Jensen, Poul Erik","orcid":"0000-0001-6524-7723","rank":6,"rolecode":"pau"}],"pmid":["34427928"],"pub":{"doi":"10.1111/ppl.13532","issn":["00319317","13993054"],"issn_org":["13993054"],"issue":"2","journal":"Physiologia Plantarum","pages":"483-494","status":"p","title":"Physiologia Plantarum","volume":"173"},"review":"Peer Reviewed","scoID":["2-s2.0-85114869509"],"search":{"DAF":["All Danish Affiliations","All GTS Institutes","All Universities","DI-ALL","DI-GTS","DI-GTS-ALL","DI-U","DI-U-ALL","GTS Institutes","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-a6b597ea-b6d9-4091-ab58-f7fd6abacd98"],"src":["KU University of Copenhagen"],"title":"Outdoor cultivation of a novel isolate of the microalgae <i>Scenedesmus sp.</i> and the evaluation of its potential as a novel protein crop","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-492991","year":"2021","yearsub":"2021"}
{"abstract":"Pectin is a major cell wall component that plays important roles in plant development and response to environmental stresses. Arabidopsis thaliana plants expressing a fungal polygalacturonase (PG plants) that degrades homogalacturonan (HG), a major pectin component, as well as loss-of-function mutants for QUASIMODO2 (QUA2), encoding a putative pectin methyltransferase important for HG biosynthesis, show accumulation of reactive oxygen species (ROS), reduced growth and almost complete resistance to the fungal pathogen Botrytis cinerea. Both PG and qua2 plants show increased expression of the class III peroxidase AtPRX71 that contributes to their elevated ROS levels and reduced growth. In this work, we show that leaves of PG and qua2 plants display greatly increased cuticle permeability. Both increased cuticle permeability and resistance to B. cinerea in qua2 are suppressed by loss of AtPRX71. Increased cuticle permeability in qua2, rather than on defects in cuticle ultrastructure or cutin composition, appears to be dependent on reduced epidermal cell adhesion, which is exacerbated by AtPRX71, and is suppressed by the esmeralda1 mutation, which also reverts the adhesion defect and the resistant phenotype. Increased cuticle permeability, accumulation of ROS, and resistance to B. cinerea are also observed in mutants lacking a functional FERONIA, a receptor-like kinase thought to monitor pectin integrity. In contrast, mutants with defects in other structural components of primary cell wall do not have a defective cuticle and are normally susceptible to the fungus. Our results suggest that disrupted cuticle integrity, mediated by peroxidase-dependent ROS accumulation, plays a major role in the robust resistance to B. cinerea of plants with altered HG integrity.","author_count":7,"contributors":["Lorrai, Riccardo","Francocci, Fedra","Gully, Kay","Martens, Helle Juel","De Lorenzo, Giulia","Nawrath, Christiane","Ferrari, Simone"],"cuid":["S01-000.00-518667"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","OECD"],"country":["Italy","Switzerland"],"glorg":["All Global Affiliations","University of Lausanne","University of Rome La Sapienza"],"keyword":["Botrytis cinerea","Cell wall","Cuticle","Pectin","Peroxidase","Plant immunity","Plant microbe interactions"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"impaired cuticle functionality and robust resistance to i botrytis cinerea i in i arabidopsis thaliana i plants with altered homogalacturonan integrity are dependent on the class iii peroxidase atprx000000000071","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fpls.2021.696955","version":"Published Version"},"id":"S01-000.00-518667","identifier":[{"id":"85114249085","type":"scopus"},{"id":"34484262","type":"pmid"},{"id":"PMC8415794","type":"pmcid"}],"ids":["ku-d18b6c14-0864-49e3-af30-66a9c074f022"],"keyword":["Botrytis cinerea","cell wall","cuticle","pectin","peroxidase","plant immunity","plant-microbe interactions"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-C398550AF8592EB9C0CD6B1630A5815B"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fpls.2021.696955","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/285375545/fpls_12_696955.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"it","key":"university of rome la sapienza","loc":["Italy","Europe, EU","OECD"],"name":"University of Rome La S