tment of Plant and Environmental Sciences, Section for Plant and Soil Sciences"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"au","key":"university of south australia","loc":["Australia","Oceania","OECD"],"name":"University of South Australia","used":1}],"person":[{"affno":"1","first":"Maja","key":"arsicpau","last":"Arsic","locid":"9a211cd8-1dd8-44cf-bed3-b61f70f6df08","name":"Arsic, Maja","orcid":"0000-0001-9236-5565","rank":1,"rolecode":"pau"},{"affno":"1","first":"Stine","key":"letougaardpau","last":"Le Tougaard","locid":"28ef3c51-c650-4b6c-9f3e-7c27bd031f60","name":"Tougaard, Stine Le","name_org":"Le Tougaard, Stine","orcid":"0000-0002-9707-8204","rank":2,"rolecode":"pau"},{"affno":"1","first":"Daniel Pergament","key":"perssonpau","last":"Persson","name":"Persson, Daniel Pergament","rank":3,"rolecode":"pau"},{"affno":"","first":"Helle Juel","key":"martenspau","last":"Martens","locid":"cd7f808e-0b4a-4423-9846-d3a81d0fad26","name":"Martens, Helle Juel","orcid":"0000-0002-3011-4557","rank":4,"rolecode":"pau"},{"affno":"2","first":"Casey L.","key":"doolettepau","last":"Doolette","name":"Doolette, Casey L.","rank":5,"rolecode":"pau"},{"affno":"","first":"Enzo","key":"lombipau","last":"Lombi","name":"Lombi, Enzo","rank":6,"rolecode":"pau"},{"affno":"1","first":"Jan Kofod","key":"schjoerringpau","last":"Schjoerring","locid":"27ae87a2-1631-4248-93bc-ed9a98e8785d","name":"Schjørring, Jan Kofod","name_org":"Schjoerring, Jan Kofod","orcid":"0000-0002-2852-3298","rank":7,"rolecode":"pau"},{"affno":"1","first":"Søren","key":"hustedpau","last":"Husted","locid":"8d9d5df0-e48a-4f38-a4a8-46baf7fd6621","name":"Husted, Søren","orcid":"0000-0003-2020-1902","rank":8,"rolecode":"pau"}],"pmid":["32540871"],"pub":{"doi":"10.1104/pp.20.00484","issn":["00320889","15322548"],"issn_org":["00320889"],"issue":"4","journal":"Plant Physiology","pages":"1472-1483","status":"p","title":"Plant Physiology","volume":"183"},"review":"Peer Reviewed","scoID":["2-s2.0-85089126192"],"search":