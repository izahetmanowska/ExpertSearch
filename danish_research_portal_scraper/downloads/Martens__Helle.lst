g":null,"first":"Lionel","key":"tarragolionelpau","last":"Tarrago","name":"Tarrago, Lionel","rank":16,"rolecode":"pau"},{"affno":"7","corresponding":null,"country":"dk","first":"Bernard","key":"henrissatbernardpau","last":"Henrissat","locid":"c8dd628d-4ab4-4a34-8a0f-ca3afab692bf","name":"Henrissat, Bernard","orcid":"0000-0002-3434-8588","rank":17,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Katja","key":"johansenkatjapau","last":"Johansen","name":"Johansen, Katja","rank":18,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Ray","key":"dupreeraypau","last":"Dupree","name":"Dupree, Ray","rank":19,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Jean","key":"armengaudjeanpau","last":"Armengaud","name":"Armengaud, Jean","rank":20,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Paul","key":"dupreepaulpau","last":"Dupree","name":"Dupree, Paul","rank":21,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jean-Guy","key":"berrinjeanguypau","last":"Berrin","name":"Berrin, Jean-Guy","rank":22,"rolecode":"pau"}],"pmid":["40783394"],"pub":{"doi":"10.1038/s41467-025-62567-3","issn":["20411723"],"journal":"Nature Communications","paperid":"7352","publisher":"Nature Research","status":"p","title":"Nature Communications","volume":"16"},"review":"Peer Reviewed","scoID":["2-s2.0-105012941884"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-acf4d7a0-3a79-4000-9cee-4348017d3273","ku-243af2e4-79d9-4f74-8539-4fd5fba6dda7"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Wood decay under anoxia by the brown-rot fungus <i>Fomitopsis pinicola</i>","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-098.76-822851","year":"2025","yearsub":"2025"}
{"abstract":"Polyploidy, or genome doubling, has occurred repeatedly through plant evolution. While polyploid plants are used extensively in agriculture and horticulture, they have so far found limited use in forestry. Here we review the potentials of polyploid trees under climate change, and investigate if there is support for increased use. We find that polyploid trees like other plants have consistent increases in cell sizes compared to diploids, and that leaf-area based rates of photosynthesis tend to increase with increasing levels of ploidy. While no particular trend could be discerned in terms of biomass between trees of different ploidy levels, physiology is affected by polyploidization and several studies point towards a high potential for polyploid trees to adapt to drought stress. The ploidy level of most tree species is unknown, and analysis of geographical patterns in frequencies of polyploid trees are inconclusive. Artificial polyploid trees are often created by colchicine and in a few cases these have been successfully applied in forestry, but the effects of induced polyploidization in many economically important tree species remains untested. Polyploids would also be increasingly useful in tree breeding programs, to create synthetic hybrids or sterile triploids that could control unwanted spreading of germplasm in nature. In conclusion, this review suggests that polyploid trees may be superior under climate change in some cases, but that the potential of polyploids is not yet fully known and should be evaluated on a case-to-case basis for different tree species.","author_count":14,"contributors":["Ræbild, Anders","Anamthawat-Jónsson, Kesara","Egertsdotter, Ulrika","Immanen, Juha","Jensen, Anna Monrad","Koutouleas, Athina","Martens, Helle Juel","Nieminen, Kaisa","Olofsson, Jill Katharina","Röper, Anna Catharina","Salojärvi, Jarkko","Strömvik, Martina","Vatanparast, Mohammad","Vivian-Smith, Adam"],"cuid":["S01-000.00-739458"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Europe, EU","Europe, Non-EU","Nordic","OECD"],"country":["Canada","Finland","Iceland","Norway","Sweden","United Kingdom"],"glorg":["All Global Affiliations","Linnaeus University","McGill University","Natural Resources Institute Finland (Luke)","Norwegian Institute of Bioeconomy Research","Royal Botanic Gardens, Kew","Swedish University of Agricultural Sciences","University of Helsinki","University of Iceland"],"keyword":["Adaptation","Ecophysiology","Fitness","Forestry","Tree breeding"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GTS","DI-U"],"level3":{"GTS":["DI-GTS-ALL","DI-GTS-DTCI"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-GTS-DTCI","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"polyploidy a tool in adapting trees to future climate changes a review of polyploidy in trees","src":["ku"],"src-code":["DI-U-KU"],"type":"djr","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.foreco.2024.121767","version":"Published Version"},"id":"S01-000.00-739458","identifier":[{"id":"85187789132","type":"scopus"}],"ids":["ku-8ddd9857-9b3d-4199-80c5-7f0e3f8316a3"],"keyword":["Adaptation","Ecophysiology","Fitness","Forestry","Tree breeding","Whole genome duplication (WGD)"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-6BE82B3BEECB4F6D53854BBE697D9B6E"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.foreco.2024.121767","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/389409156/1_s2.0_S0378112724000793_main.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Geosciences and Natural Resource Management, Forest and Landscape Ecology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"is","key":"university of iceland","loc":["Iceland","Europe, Non-EU","Nordic","OECD"],"name":"University of Iceland","used":1},{"affno":"3","country":"se","key":"swedish university of agricultural sciences","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Swedish University of Agricultural Sciences","used":1},{"affno":"4","country":"fi","key":"natural resources institute finland","loc":["Finland","Europe, EU","Nordic","OECD"],"name":"Natural Resources Institute Finland (Luke)","used":1},{"affno":"5","country":"fi","key":"university of helsinki","loc":["Finland","Europe, EU","Nordic","OECD"],"name":"University of Helsinki","used":1},{"affno":"6","country":"se","key":"linnaeus university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Linnaeus University","used":1},{"affno":"7","country":"dk","key":"danish technological institute","l2":"DI-GTS","l2n":"GTS Institutes","l3":"DI-GTS-DTCI","l3nn":"Danish Technological Institute","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Danish Technological Institute","namevar":["Teknologisk Institut"],"nora_code":"DI-GTS-DTCI","used":1},{"affno":"8","country":"ca","key":"mcgill university","loc":["Canada","America, North","OECD"],"name":"McGill University","used":1},{"affno":"9","country":"gb","key":"royal botanic gardens kew","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Royal Botanic Gardens, Kew","used":1},{"affno":"10","country":"no","key":"norwegian institute of bioeconomy research","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"Norwegian Institute of Bioeconomy Research","used":1}],"person":[{"affno":"1","first":"Anders","key":"ræbildpau","last":"Ræbild","locid":"599ea842-1926-48bd-b8