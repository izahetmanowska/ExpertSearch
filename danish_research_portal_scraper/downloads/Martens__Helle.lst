{"author_count":5,"contributors":["Irisarri, Patricia","Binczycki, Piotr","Errea, Pilar","Martens, Helle Juel","Pina, Ana"],"cuid":["S01-000.00-456669"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Antioxidant enzymes","Callus culture","Pear","Quince"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"oxidative stress associated with rootstock scion interactions in pear quince combinations during early stages of graft development","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-456669","identifier":[{"id":"000352151100003","type":"wos"},{"id":"84919935905","type":"scopus"},{"id":"25543953","type":"pmid"}],"ids":["ku-69df9d13-0235-4ef2-a22c-3ee52d5567a5"],"keyword":["Antioxidant enzymes","Callus culture","Graft compatibility","Pear","Quince"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-09CF65BD140221B8E5AF29796E34C9AC"],"oai":{"class":"Blocked","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Patricia","key":"irisarripau","last":"Irisarri","name":"Irisarri, Patricia","rank":1,"rolecode":"pau"},{"affno":"1","first":"Piotr","key":"binczyckipau","last":"Binczycki","name":"Binczycki, Piotr","rank":2,"rolecode":"pau"},{"affno":"","first":"Pilar","key":"erreapau","last":"Errea","name":"Errea, Pilar","rank":3,"rolecode":"pau"},{"affno":"1","first":"Helle Ju