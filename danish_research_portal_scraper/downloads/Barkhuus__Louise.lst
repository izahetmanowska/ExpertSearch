{"author_count":8,"contributors":["Rossitto, Chiara","Rostami, Asreen","McMillan, Donald","Spence, Jocelyn","Taylor, Robyn","Hook, Jonathan","Williamson, Julie","Barkhuus, Louise"],"cuid":["S01-000.00-384455"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD"],"country":["Sweden","United Kingdom"],"glorg":["All Global Affiliations","Newcastle University","Stockholm University","University of Glasgow","University of Nottingham","University of York"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"glimpses of the future designing fictions for mixed reality performances","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1145/3155048","version":"Published Version"},"id":"S01-000.00-384455","identifier":[{"id":"85040121949","type":"scopus"}],"ids":["itu-d87a66cf-d0c6-4663-ac26-c7b24acd2b23"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-D7062ADD84117AD88BA6DF64761ABBD9"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1145/3155048","version":"Published Version"},{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84066122/design_fiction_workshop.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","country":"se","key":"stockholm university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Stockholm University","used":1},{"affno":"2","country":"gb","key":"university of nottingham","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Nottingham","used":1},{"affno":"3","country":"gb","key":"newcastle university","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Newcastle University","used":1},{"affno":"4","country":"gb","key":"university of york","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of York","used":1},{"affno":"5","country":"gb","key":"university of glasgow","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University of Glasgow","used":1},{"affno":"6","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digital Design","IT University of Copenhagen, Play, Culture, and AI, Media, Art & Design"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Chiara","key":"rossittopau","last":"Rossitto","name":"Rossitto, Chiara","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Asreen","key":"rostamipau","last":"Rostami","name":"Rostami, Asreen","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Donald","key":"mcmillanpau","last":"McMillan","name":"McMillan, Donald","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jocelyn","key":"spencepau","last":"Spence","name":"Spence, Jocelyn","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Robyn","key":"taylorpau","last":"Taylor","name":"Taylor, Robyn","rank":5,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Jonathan","key":"hookpau","last":"Hook","name":"Hook, Jonathan","rank":6,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Julie","key":"williamsonpau","last":"Williamson","name":"Williamson, Julie","rank":7,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Louise","key":"barkhuuspau","last":"Barkhuus","locid":"831421c0-027f-4a25-b795-ee2fce0c8d2a","name":"Barkhuus, Louise","orcid":"0000-0003-1306-249X","rank":