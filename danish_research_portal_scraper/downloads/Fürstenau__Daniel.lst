{"author_count":3,"contributors":["Fürstenau, Daniel","Gersch, Martin","Schreiter, Stefanie"],"cuid":["S01-000.00-669556"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["DTx","Digital health applications","Digital health care","Digital therapeutics","Healthcare IT"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"digital therapeutics dtx","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s12599-023-00804-z","version":"Published Version"},"id":"S01-000.00-669556","identifier":[{"id":"85151975734","type":"scopus"}],"ids":["itu-d8bc3bb5-3c7b-4b8f-be76-ea3069a6ab35"],"keyword":["DTx","Digital health applications","Digital health care","Digital therapeutics","Healthcare IT"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-A27392E3B8ECC4C0D5B42C826AAE1A31"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/96895454/F_rstenau_et_al._2023_Digital_Therapeutics_BISE.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s12599-023-00804-z","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Digital Business Innovation, Information Systems and Digital Innovation"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Daniel","key":"fürstenaupau","last":"Fürstenau"