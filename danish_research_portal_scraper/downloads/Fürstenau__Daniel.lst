D"],"name":"ICN Business School","used":1},{"affno":"10","country":"de","key":"institut commercial de nancy business school","loc":["Germany","Europe, EU","OECD"],"name":"Institut commercial de Nancy Business School","used":1},{"affno":"11","country":"de","key":"university of duisburg essen","loc":["Germany","Europe, EU","OECD"],"name":"University of Duisburg-Essen","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Daniel","key":"fürstenaupau","last":"Fürstenau","locid":"ceef6d97-26fe-4163-9538-6685e98bce2e","name":"Fürstenau, Daniel","orcid":"0000-0001-8490-7707","rank":1,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"country":"dk","first":"Abayomi","key":"baiyerepau","last":"Baiyere","locid":"5df73b16-ee57-4a45-a43f-9e6eb629180b","name":"Baiyere, Abayomi","orcid":"0000-0002-2211-4960","rank":2,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"first":"Kai","key":"schewinapau","last":"Schewina","name":"Schewina, Kai","rank":3,"rolecode":"pau"},{"affno":"4 6 5 7","corresponding":null,"first":"Matthias","key":"schultealthoffpau","last":"Schulte-Althoff","name":"Schulte-Althoff, Matthias","rank":4,"rolecode":"pau"},{"affno":"8 9 10 11","corresponding":null,"first":"Hannes","key":"rothepau","last":"Rothe","name":"Rothe, Hannes","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1287/isre.2023.1209","issn":["10477047","15265536"],"issn_org":["10477047"],"issue":"4","journal":"Information Systems Research","pages":"1686-1710","publisher":"Institute for Operations Research and the Management Sciences","status":"p","title":"Information Systems Research","volume":"34"},"review":"Peer Reviewed","scoID":["2-s2.0-85160426984"],"search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["cbs-aa6753c1-49c1-4331-bd01-fef0e9480029","itu-a1ca51aa-da82-45b5-95da-1ab3c6c8537e"],"src":["CBS Copenhagen Business School","ITU IT University of Copenhagen"],"title":"Extended Generativity Theory on Digital Platforms","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-089.29-031915","year":"2023","yearsub":"2023"}
{"abstract":"Few studies and almost exclusively from the USA have recently investigated mobile phone and computer use among users of psychiatric services, which is of high relevance regarding the increasing development of digital health applications and services. Objective, design and setting: In a cross-sectional patient survey, we examined (a) rates and purposes of mobile phone, computer, internet and social media use, and (b) the role of social and clinical predictors on rates of utilisation among psychiatric inpatients in Berlin, Germany. Participants and results: Descriptive analyses showed that among 496 participants, 84.9% owned a mobile phone and 59.3% a smartphone. Among 493 participants, 68.4% used a computer regularly. Multivariate logistic regression models revealed being homeless, diagnosis of a psychotic illness, being of older age and a lower level of education to be significant predictors for not owning a mobile phone, not using a computer regularly or having a social media account, respectively. Conclusions: Users of psychiatric services may have access to mobile phones and computers, although rates are lower than in the general population. However, key barriers that need to be addressed regarding the development of and engagement with digital health interventions are factors of social exclusion like marginalised housing as well as clinical aspects like psychotic illness.","author_count":8,"contributors":["Marbin, Derien","Gutwinski, Stefan","Lech, Sonja","Fürstenau, Daniel","Kokwaro, Linda","Krüger, Helena","Schindel, Daniel","Schreiter, Stefanie"],"cuid":["S02-095.59-666608"],"filters":{"added":"2023-05","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD"],"corresponding_author":["Marbin, Derin"],"country":["Germany"],"glorg":["All Global Affiliations","Berlin Institute of Health","Charite - Universitatsmedizin Berlin","Charité – Universitätsmedizin Berlin","Free University of Berlin","Freie Universität Berlin","Humboldt University of Berlin","Psychiatrische Universitätsklinik der Charité im St Hedwig-Krankenhaus"],"keyword":["Digital health applications","Digital health care","Digital psychiatry","Social determinants of health"],"level":"sci","mra":["sci","soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS","DI-U-ITU"]},"level3all":["DI-U-CBS","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"use of digital technologies by users of psychiatric inpatient services in berlin germany a cross sectional patient survey","src":["cbs","itu"],"src-code":["DI-U-CBS","DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/bmjopen-2022-067311","version":"Published Version"},"id":"S02-095.59-666608","identifier":[{"id":"85150667103","type":"scopus"}],"ids":["cbs-a63838e0-c3b3-4cbd-8c24-1d239c561f29","itu-9ea3a081-b390-4816-8040-447b18dd1ae2"],"keyword":["Digital health applications","Digital health care","Digital psychiatry","Social determinants of health"],"lang":"English","level":"Scientific","mra":["Science/Technology","Social Science"],"noi":["Global-Local-2-5-D827B1C29B323C42B28B1638489A6D19"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/96895593/Marbin_et_al._2023_Use_of_digital_technologies_by_users_of_psychiatric_inpatient_services_in_Berlin_BMJ_Open.pdf","version":"Other Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://research-api.cbs.dk/ws/files/91219309/derin_marbin_et_al_use_of_digital_technologies_by_users_of_psychiatric_publishersversion.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/bmjopen-2022-067311","version":"Published Version"}],"org":[{"affno":"1","country":"de","key":"charite universitatsmedizin berlin","loc":["Germany","Europe, EU","OECD"],"name":"Charite - Universitatsmedizin Berlin","used":1},{"affno":"2","country":"de","key":"freie universität berlin","loc":["Germany","Europe, EU","OECD"],"name":"Freie Universität Berlin","used":1},{"affno":"3","country":"de","key":"berlin institute of health","loc":["Germany","Europe, EU","OECD"],"name":"Berlin Institute of Health","used":1},{"affno":"4","country":"de","key":"humboldt university of berlin","loc":["Germany","Europe, EU","OECD"],"name":"Humboldt University of Berlin","used":1},{"affno":"5","country":"de","key":"psychiatrische universitätsklinik der charité im st hedwig krankenhaus","loc":["Germany","Europe, EU","OECD"],"name":"Psychiatrische Universitätsklinik der Charité im St Hedwig-Krankenhaus","used":1},{"affno":"6","country":"de","key":"charité universitätsmedizin berlin","loc":["Germany","Europe, EU","OECD"],"name":"Charité – Universitätsmedizin Berlin","used":1},{"affno":"7","country":"de","key":"free university of berlin","loc":["Germany","Europe, EU","OECD"],"name":"Free University of Berlin","used":1},{"affno":"8","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Digitalization"],"nora_code":"DI-U-CBS","used":1},{"affno":"9","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Digital Business Innovation, Information Systems and Digital Innovation"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1 2 3 4 5 6 7","corresponding":null,"first":"Derin","key":"marbinpau","last":"Marbin","name":"Marbin, Derin","rank":1,"rolecode":"pau"},{"affno":"1 2 3 4 5 6 7","corresponding":null,"first":"Stefan","key":"gutwinskipau","last":"Gutwinski","name":"Gutwinski, Stefan","rank":2,"rolecode":"pau"},{"affno":"1 2 3 4 6 7","corresponding":null,"first":"Sonia","key":"lechpau","last":"Lech","name":"Lech, Sonia","rank":3,"rolecode":"pau"},{"affno":"1 2 3 4 8 9","corresponding":null,"country":"dk","first":"Daniel","key":"fürstenaupau","last":"Fürstenau","locid":"e1b78deb-bdff-40e4-935b-f1a97937809c","name":"Fürstenau, Daniel","orcid":"0000-0001-8490-7707","rank":4,"rolecode":"pau"},{"affno":"1 2 3 4 6 7","corresponding":null,"first":"Daniel","key":"schindelpau","last":"Schindel","name":"Schindel, Daniel","rank":5,"rolecode":"pau"},{"affno":"6 7 4","corresponding":null,"first":"Linda","key":"kokwaropau","last":"Kokwaro","name":"Kokwaro, Linda","rank":5,"rolecode":"pau"},{"affno":"1 2 3 4 6 7","corresponding":null,"first":"Stefanie","key":"schreiterpau","last":"Schreiter","name":"Schreiter, Stefanie","rank":6,"rolecode":"pau"},{"affno":"6 7 4","corresponding":null,"first":"Helena","key":"krügerpau","last":"Krüger","name":"Krüger, Helena","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1136/bmjopen-2022-067311","issn":["20446055"],"issue":"3","journal":"BMJ Open","paperid":"e067311","publisher":"BMJ Publishing Group","status":"p","title":"BMJ Open","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-85150667103"],"search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["cbs-a63838e0-c3b3-4cbd-8c24-1d239c561f29","itu-9ea3a081-b390-4816-8040-447b18dd1ae2"],"src":["CBS Copenhagen Business School","ITU IT University of Copenhagen"],"title":"Use of Digital Technologies by Users of Psychiatric Inpatient Services in Berlin, Germany : A Cross-sectional Patient Survey","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-095.59-666608","year":"2023","yearsub":"2023"}
{"abstract":"Social innovation research has largely focused on individuals' values, beliefs, and perceptions of usefulness as they relate to the acceptance of social innovations. However, this research often lacks a sociological perspective, especially when it comes to social innovations that involve new behaviors and collective interactions. Additionally, the methods employed in social innovation research are often fragmented and deductive, leading to a lack of a common understanding of the methodological framework and a tendency to reproduce established characteristics. To address these issues, we propose the use of frame theory as a sociological approach to conceptualizing individuals’ characteristics as socially conditioned and employing an inductive methodological approach. This approach is demonstrated through the case study of shared decision-making (SDM) in perioperative care, a social innovation aimed at promoting patient-centric treatment through the sharing of information and decision-making in surgical contexts. In our study, we employed frame theory to identify six frames that influence the acceptance of SDM in perioperative care. These frames pertain to issues such as role models, power asymmetry, and the scope of action that is structurally constrained. Through the use of an inductive approach, we were able to determine individuals' characteristics and examine issues that are particularly relevant for social innovations, such as role perceptions, conceptions of the innovation, trust and power relations, and organizational structures and routines. Our findings suggest that assumed role ascriptions, trust, and dependency within social relations play a significant role in shaping the acceptance of social innovations.","author_count":7,"contributors":["Vogel, Amyn","Borchers, Friedrich","Balzer, Felix","Spies, Claudia","Gersch, Martin","Fürstenau, Daniel"],"cuid":["S01-000.00-695232"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","Charité – Universitätsmedizin Berlin","Free University of Berlin","Ludwig Maximilian University of Munich"],"keyword":["Health","Healthcare","Individual Beliefs","Shared decision making","Social factors","Social innovation"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"exploring the role of individual beliefs and social factors in adopting social innovations","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-695232","ids":["itu-35c1a4ad-f396-47b4-9c3f-be34a274d64a"],"keyword":["Health","Healthcare","Individual Beliefs","Shared Decision Making","Social Factors","social innovation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-93B56AD9E3798EF9A86A1CECC51EA435"],"org":[{"affno":"1","country":"de","key":"ludwig maximilian university of munich","loc":["Germany","Europe, EU","OECD"],"name":"Ludwig Maximilian University of Munich","used":1},{"affno":"2","country":"de","key":"charité universitätsmedizin berlin","loc":["Germany","Europe, EU","OECD"],"name":"Charité – Universitätsmedizin Berlin","used":1},{"affno":"3","country":"de","key":"free university of berlin","loc":["Germany","Europe, EU","OECD"],"name":"Free University of Berlin","used":1},{"affno":"4","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Digital Business Innovation, Information Systems and Digital Innovation"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Amyn","key":"vogelpau","last":"Vogel","name":"Vogel, Amyn","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Friedrich","key":"borcherspau","last":"Borchers","name":"Borchers, Friedrich","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Felix","key":"balzerpau","last":"Balzer","name":"Balzer, Felix","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Claudia","key":"spiespau","last":"Spies","name":"Spies, Claudia","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Martin","key":"gerschpau","last":"Gersch","name":"Gersch, Martin","rank":5,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Daniel","key":"fürstenaupau","last":"Fürstenau","locid":"ceef6d97-26fe-4163-9538-6685e98bce2e","name":"Fürstenau, Daniel","orcid":"0000-0001-8490-7707","rank":6,"rolecode":"pau"},{"affno":"","first":"Sonia","key":"tanejapedh","last":"Taneja","name":"Taneja, Sonia","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.5465/amproc.2023.10028abstract","edition":"1","eisbn":["21516561"],"isbn":["00650668"],"publisher":"Academy of Management","status":"p","title":"Academy of Management Annual Meeting Proceedings","volume":"2023"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-35c1a4ad-f396-47b4-9c3f-be34a274d64a"],"src":["ITU IT University of Copenhagen"],"title":"Exploring the Role of Individual Beliefs and Social Factors in Adopting Social Innovations","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-695232","year":"2023","yearsub":"2023"}
{"abstract":"This paper focuses on the integration of digital therapeutics (DTx) into future-oriented and patient-centric care pathways. Based on a workshop series and problem-centered interviews in Germany, the current state-of-the-art of regulatory and technical integration of DTx was mapped as a landscape of DTx interoperability. The results focus on key interfaces of DTx, namely with Electronic Health Records (EHRs), devices, and other digital health innovations such as telemedicine, and highlight current challenges and potentials for future development. On a broader level, the results point to unresolved issues of care coordination, the optional role of the EHRs as regulated platforms for care, and the importance of integrating DTx data into public data spaces for research.","author_count":7,"contributors":["Stegemann, Lars","Gubser, Rahel","Gersch, Martin","Bartschke, Alexander","Hoffmann, Andreas","Wagner, Michael","Fürstenau, Daniel"],"cuid":["S01-000.00-695283"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","Charité – Universitätsmedizin Berlin","Fraunhofer-Gesellschaft","Free University of Berlin"],"keyword":["Digital health applications","Digital health care","Digital therapeutics","Health app","Interoperability","Mobile health"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"future oriented and patient centric a qualitative analysis of digital therapeutics and their interoperability","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-695283","ids":["itu-b81a4a0d-f76d-4eeb-9ff5-adabc72c74fd"],"keyword":["Digital health applications","Digital health care","Digital therapeutics","Interoperability","Mobile health","health app"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-8F8058DCC4289F0DC58ECCEFA08BCA15"],"org":[{"affno":"1","country":"de","key":"free university of berlin","loc":["Germany","Europe, EU","OECD"],"name":"Free University of Berlin","used":1},{"affno":"2","country":"de","key":"charité universitätsmedizin berlin","loc":["Germany","Europe, EU","OECD"],"name":"Charité – Universitätsmedizin Berlin","used":1},{"affno":"3","country":"de","key":"fraunhofer gesellschaft","loc":["Germany","Europe, EU","OECD"],"name":"Fraunhofer-Gesellschaft","used":1},{"affno":"4","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Digital Business Innovation, Information Systems and Digital Innovation"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lars","key":"stegemannpau","last":"Stegemann","name":"Stegemann, Lars","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Rahel","key":"gubserpau","last":"Gubser","name":"Gubser, Rahel","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Martin","key":"gerschpau","last":"Gersch","name":"Gersch, Martin","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Alexander","key":"bartschkepau","last":"Bartschke","name":"Bartschke, Alexander","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Andreas","key":"hoffmannpau","last":"Hoffmann","name":"Hoffmann, Andreas","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Michael","key":"wagnerpau","last":"Wagner","name":"Wagner, Michael","rank":6,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Daniel","key":"fürstenaupau","last":"Fürstenau","locid":"ceef6d97-26fe-4163-9538-6685e98bce2e","name":"Fürstenau, Daniel","orcid":"0000-0001-8490-7707","rank":7,"rolecode":"pau"}],"pub":{"publisher":"Association for Information Systems","status":"p","title":"The 31st European Conference on Information Systems (ECIS 2023)"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-b81a4a0d-f76d-4eeb-9ff5-adabc72c74fd"],"src":["ITU IT University of Copenhagen"],"title":"Future-Oriented and Patient-Centric? : A Qualitative Analysis of Digital Therapeutics and Their Interoperability","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-695283","year":"2023","yearsub":"2023"}
{"abstract":"It is long established that data from platforms can be useful for deriving patterned insights into people’s behavior and conduct. Data platforms are important in fields with limited data availability and strict regulatory and hierarchical structures, such as healthcare and nursing analytics. Hence, we carefully examine three forerunner initiatives in establishing data platforms in the context of nursing care along normative, organizational, and technical dimensions of governance. The cases were selected due to their high level of comparability and to demonstrate three different types of data governance strategies understood as actions to reconcile conflicting interests regarding data and dealing with prevalent data protection law – ranging from strictly processual approaches to the creation of synthetic data. These findings highlight the importance of considering data governance strategies concisely when building data platforms and suggest considerable variety in the configuration of data governance arrangements.","author_count":5,"contributors":["Gubser, Rahel","Schulte-Althoff, Matthias","Heinemann, Nils","Pohle, Jörg","Fürstenau, Daniel"],"cuid":["S01-000.00-695304"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["Alexander von Humboldt Institut für Internet und Gesellschaft","All Global Affiliations","Charité – Universitätsmedizin Berlin","Free University of Berlin"],"keyword":["Data governance","Data platforms","Digital health care","Nursing Care"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"data governance strategies for data platforms a multiple case study in nursing care","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/101715869/ECIS-data-governance-viewcontent.pdf","version":"Published Version"},"id":"S01-000.00-695304","ids":["itu-e0d6bc46-8edf-4d25-81de-92292f721643"],"keyword":["Data governance","Data platforms","Digital health care","Nursing care"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-62E8FFC05FDD99013E9026E2BEDBA340"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/101715869/ECIS-data-governance-viewcontent.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"de","key":"charité universitätsmedizin berlin","loc":["Germany","Europe, EU","OECD"],"name":"Charité – Universitätsmedizin Berlin","used":1},{"affno":"2","country":"de","key":"free university of berlin","loc":["Germany","Europe, EU","OECD"],"name":"Free University of Berlin","used":1},{"affno":"3","country":"de","key":"alexander von humboldt institut für internet und gesellschaft","loc":["Germany","Europe, EU","OECD"],"name":"Alexander von Humboldt Institut für Internet und Gesellschaft","used":1},{"affno":"4","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Digital Business Innovation, Information Systems and Digital Innovation"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Rahel","key":"gubserpau","last":"Gubser","name":"Gubser, Rahel","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Matthias","key":"schultealthoffpau","last":"Schulte-Althoff","name":"Schulte-Althoff, Matthias","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Nils","key":"heinemannpau","last":"Heinemann","name":"Heinemann, Nils","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jörg","key":"pohlepau","last":"Pohle","name":"Pohle, Jörg","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Daniel","key":"fürstenaupau","last":"Fürstenau","locid":"ceef6d97-26fe-4163-9538-6685e98bce2e","name":"Fürstenau, Daniel","orcid":"0000-0001-8490-7707","rank":5,"rolecode":"pau"}],"pub":{"publisher":"Association for Information Systems","status":"p","title":"The 31st European Conference on Information Systems (ECIS 2023)"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-e0d6bc46-8edf-4d25-81de-92292f721643"],"src":["ITU IT University of Copenhagen"],"title":"Data Governance Strategies for Data Platforms - A Multiple Case Study in Nursing Care","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-695304","year":"2023","yearsub":"2023"}
{"abstract":"Since December 2019, digital health applications (DiGA) have been included in standard care in Germany and are therefore reimbursed by the statutory health insurance funds to support patients in the treatment of diseases or impairments. There are 48 registered DiGA listed in the directory of the Federal Institute of Drugs and Medical Devices (BfArM), mainly in the areas of mental health; hormones and metabolism; and muscles, bones, and joints. In this article, the “Digital Health” specialist group of the German Informatics Society describes the current developments around DiGA as well as the current sentiment on topics such as user-centricity, patient and practitioner acceptance, and innovation potential. In summary, over the past three years, DiGA have experienced a positive development, characterized by a gradually increasing availability of various DiGA and coverage areas as well as prescription numbers. Nevertheless, significant regulatory adjustments are still required in some areas to establish DiGA as a well-established instrument in long-term routine healthcare. Key challenges include user-centeredness and the sustainable use of the applications.","author_count":12,"contributors":["Schlieter, Hannes","Kähling, Maren","Hickmann, Emily","Fürstenau, Daniel","Sunyaev, Ali","Richter, Peggy","Breitschwerdt, Rüdiger","Tielscher, Christian","Gersch, Martin","Maaß, Wolfgang","Reuter-Oppermann, Melanie","Wiese, Lena"],"cuid":["S01-000.00-712504"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany","Netherlands"],"glorg":["All Global Affiliations","FOM Hochschule für Oekonomie & Management","Flensburg University of Applied Sciences","Fraunhofer Institute for Toxicology and Experimental Medicine ITEM","Free University of Berlin","Karlsruhe Institute of Technology","Saarland University","TU Dresden","Technical University of Dresden","University of Twente"],"keyword":["Commentary","Digital health","Digital therapeutics","Digitalization"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"digitale gesundheitsanwendungen diga im spannungsfeld von fortschritt und kritik","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s00103-023-03804-2","version":"Published Version"},"id":"S01-000.00-712504","identifier":[{"id":"85179314907","type":"scopus"}],"ids":["itu-27192cda-676e-4489-9db5-7d5e48f28fd3"],"keyword":["Digital therapeutics","Digitalization","commentary","digital health"],"lang":"German","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-797D4C277122A9F3224DEC52ADFC6F74"],"oa_link":[{"access":"oa","type":"rem","url":"https://link.springer.com/content/pdf/10.1007/s00103-023-03804-2.pdf","version":"Published Version"},{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/107005369/s00103-023-03804-2.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s00103-023-03804-2","version":"Published Version"}],"org":[{"affno":"1","country":"de","key":"technical university of dresden","loc":["Germany","Europe, EU","OECD"],"name":"Technical University of Dresden","used":1},{"affno":"2","country":"de","key":"tu dresden","loc":["Germany","Europe, EU","OECD"],"name":"TU Dresden","used":1},{"affno":"3","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Digital Business Innovation, Information Systems and Digital Innovation"],"nora_code":"DI-U-ITU","used":1},{"affno":"4","country":"de","key":"karlsruhe institute of technology","loc":["Germany","Europe, EU","OECD"],"name":"Karlsruhe Institute of Technology","used":1},{"affno":"5","country":"de","key":"flensburg university of applied sciences","loc":["Germany","Europe, EU","OECD"],"name":"Flensburg University of Applied Sciences","used":1},{"affno":"6","country":"de","key":"fom hochschule für oekonomie management","loc":["Germany","Europe, EU","OECD"],"name":"FOM Hochschule für Oekonomie & Management","used":1},{"affno":"7","country":"de","key":"free university of berlin","loc":["Germany","Europe, EU","OECD"],"name":"Free University of Berlin","used":1},{"affno":"8","country":"de","key":"saarland university","loc":["Germany","Europe, EU","OECD"],"name":"Saarland University","used":1},{"affno":"9","country":"nl","key":"university of twente","loc":["Netherlands","Europe, EU","OECD"],"name":"University of Twente","used":1},{"affno":"10","country":"de","key":"fraunhofer institute for toxicology and experimental medicine item","loc":["Germany","Europe, EU","OECD"],"name":"Fraunhofer Institute for Toxicology and Experimental Medicine ITEM","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Hannes","key":"schlieterpau","last":"Schlieter","name":"Schlieter, Hannes","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Maren","key":"kählingpau","last":"Kähling","name":"Kähling, Maren","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Emily","key":"hickmannpau","last":"Hickmann","name":"Hickmann, Emily","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Daniel","key":"fürstenaupau","last":"Fürstenau","locid":"ceef6d97-26fe-4163-9538-6685e98bce2e","name":"Fürstenau, Daniel","orcid":"0000-0001-8490-7707","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Ali","key":"sunyaevpau","last":"Sunyaev","name":"Sunyaev, Ali","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peggy","key":"richterpau","last":"Richter","name":"Richter, Peggy","rank":6,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Rüdiger","key":"breitschwerdtpau","last":"Breitschwerdt","name":"Breitschwerdt, Rüdiger","rank":7,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Christian","key":"tielscherpau","last":"Tielscher","name":"Tielscher, Christian","rank":8,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Martin","key":"gerschpau","last":"Gersch","name":"Gersch, Martin","rank":9,"rolecode":"pau"},{"affno":"8","corresponding":null,"first":"Wolfgang","key":"maaßpau","last":"Maaß","name":"Maaß, Wolfgang","rank":10,"rolecode":"pau"},{"affno":"9","corresponding":null,"first":"Melanie","key":"reuteroppermannpau","last":"Reuter-Oppermann","name":"Reuter-Oppermann, Melanie","rank":11,"rolecode":"pau"},{"affno":"10","corresponding":null,"first":"Lena","key":"wiesepau","last":"Wiese","name":"Wiese, Lena","rank":12,"rolecode":"pau"}],"pub":{"doi":"10.1007/s00103-023-03804-2","issn":["14369990"],"journal":"Bundesgesundheitsblatt","publisher":"Springer","status":"p","title":"Bundesgesundheitsblatt"},"review":"Peer Reviewed","scoID":["2-s2.0-85179314907"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-27192cda-676e-4489-9db5-7d5e48f28fd3"],"src":["ITU IT University of Copenhagen"],"title":"Digitale Gesundheitsanwendungen (DiGA) im Spannungsfeld von Fortschritt und Kritik","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-712504","year":"2023","yearsub":"2023"}
{"abstract":"The circular economy reshapes the linear “take, make, and dispose” approach and evolves around minimizing waste and recapturing resources in a closed-loop system. The health sector accounts for 4.6% of global greenhouse gas emissions and has, over the decades, been built to rely on single-use devices and deal with high volumes of medical waste. With the increase in the adoption of digital health solutions in the health care industry, leading the industry into a new paradigm of how we provide health care, a focus must be put on the amount of waste that will follow. Digital health solutions will shape health care through the use of technology and lead to improved patient care, but they will also make medical waste more complex to deal with due to the e-waste component. Therefore, a transformation of the health care industry to a circular economy is a crucial cornerstone in decreasing the impact on the environment.","author_count":8,"contributors":["Rønn, Camille","Wieland, Andreas","Lehrer, Christiane","Marton, Attila","LaRoche, Jason","Specker, Adrien","Leroy, Pascal","Fürstenau, Daniel"],"cuid":["S01-000.00-712512"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","OECD"],"country":["Belgium","Switzerland"],"glorg":["All Global Affiliations","Association of Electronic Waste Producer Responsibility Organisations","Johnson & Johnson Innovative Medicine","World Resources Forum"],"keyword":["Business models","Circular economy","Circularity","Digital","Digital Health Solution","Digital health","Digital tool","Healthcare","Technology"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS","DI-U-ITU"]},"level3all":["DI-U-CBS","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"circular business model for digital health solutions protocol for a scoping review","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.2196/47874","version":"Published Version"},"funding_acknowledgement":["CR holds funding for a PhD through the IT University of Copenhagen. We acknowledge the financial support of the European Research Executive Agency under the powers delegated by the European Commission for the Digital Health in Circular Economy (DiCE) project (101060184)"],"id":"S01-000.00-712512","identifier":[{"id":"85180073535","type":"scopus"}],"ids":["itu-3ad19b8b-1e21-410e-a5a4-7a55c612df78"],"keyword":["Business Models","Circular Economy","Circularity","Digital","Digital Health","Digital Health Solution","Digital tool","Healthcare","Technology"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-84A004F4AF0CD3C6B1D0185B2E9D1A5B"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.2196/47874","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.itu.dk/ws/files/102396541/PDF.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Digital Business Innovation, Information Systems and Digital Innovation"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"dk","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School"],"nora_code":"DI-U-CBS","used":1},{"affno":"3","country"