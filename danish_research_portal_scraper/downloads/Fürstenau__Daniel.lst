of Copenhagen, Digital Business Innovation, Information Systems and Digital Innovation"],"nora_code":"DI-U-ITU","used":1},{"affno":"6","country":"ca","key":"sauder school of business","loc":["Canada","America, North","OECD"],"name":"Sauder School of Business","used":1},{"affno":"7","country":"ca","key":"university of british columbia","loc":["Canada","America, North","OECD"],"name":"University of British Columbia","used":1},{"affno":"8","country":"de","key":"institut commercial de nancy business school","loc":["Germany","Europe, EU","OECD"],"name":"Institut commercial de Nancy Business School","used":1}],"person":[{"affno":"1 2 3","corresponding":null,"first":"Mattias","key":"schultealthoffpau","last":"Schulte-Althoff","name":"Schulte-Althoff, Mattias","rank":1,"rolecode":"pau"},{"affno":"1 4 5","corresponding":null,"country":"dk","first":"Daniel","key":"fürstenaupau","last":"Fürstenau","locid":"e1b78deb-bdff-40e4-935b-f1a97937809c","name":"Fürstenau, Daniel","orcid":"0000-0001-8490-7707","rank":2,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Gene","key":"mooleepau","last":"Moo Lee","name":"Moo Lee, Gene","rank":3,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Gene Moo","key":"leepau","last":"Lee","name":"Lee, Gene Moo","rank":3,"rolecode":"pau"},{"affno":"1 8","corresponding":null,"first":"Hannes","key":"rothepau","last":"Rothe","name":"Rothe, Hannes","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Robert J.","key":"kauffmanpau","last":"Kauffman","locid":"9dbfd0ae-722c-4870-9ec9-2a63b0cc7c36","name":"Kauffman, Robert J.","orcid":"0000-0002-3757-0010","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["cbs-0f658ea2-ef5c-4824-9fcc-d401211ecf70","itu-20bd151b-1acb-4925-8333-941c5838e839"],"src":["CBS Copenhagen Business School","ITU IT University of Copenhagen"],"title":"What Fuels Growth? A Comparative Analysis of the Scaling Intensity of AI Start-ups","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-086.22-031150","year":"2022","yearsub":"2022"}
{"abstract":"Background: The role of telemedicine in intensive care has been increasing steadily. Tele–intensive care unit (ICU) interventions are varied and can be used in different levels of treatment, often with direct implications for the intensive care processes. Although a substantial body of primary and secondary literature has been published on the topic, there is a need for broadening the understanding of the organizational factors influencing the effectiveness of telemedical interventions in the ICU. Objective: This scoping review aims to provide a map of existing evidence on tele-ICU interventions, focusing on the analysis of the implementation context and identifying areas for further technological research. Methods: A research protocol outlining the method has been published in JMIR Research Protocols. This review follows the PRISMA-ScR (Preferred Reporting Items for Systematic Reviews and Meta-Analyses Extension for Scoping Reviews). A core research team was assembled to provide feedback and discuss findings. Results: A total of 3019 results were retrieved. After screening, 25 studies were included in the final analysis. We were able to characterize the context of tele-ICU studies and identify three use cases for tele-ICU interventions. The first use case is extending coverage, which describes interventions aimed at extending the availability of intensive care capabilities. The second use case is improving compliance, which includes interventions targeted at improving patient safety, intensive care best practices, and quality of care. The third use case, facilitating transfer, describes telemedicine interventions targeted toward the management of patient transfers to or from the ICU. Conclusions: The benefits of tele-ICU interventions have been well documented for centralized systems aimed at extending critical care capabilities in a community setting and improving care compliance in tertiary hospitals. No strong evidence has been found on the reduction of patient transfers following tele-ICU intervention.","author_count":7,"contributors":["Guinemer, Camille","Boeker, Martin","Fürstenau, Daniel","Poncette, Akira-Sebastian","Weiss, Björn","Mörgeli, Rudolf","Balzer, Felix"],"cuid":["S01-000.00-283240"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"corresponding_author":["Guinemer, Camille"],"country":["Germany"],"glorg":["All Global Affiliations","Charite - Universitatsmedizin Berlin","Technische Universität München"],"keyword":["Care compliance","Critical care","Digital health","Health care system","Health technology","Hospital","Implementation","Intensive care unit","Review","Tele ICU","Telehealth","Telemedicine","Tertiary hospitals"],"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"pr","rtype":["clu"],"sorti":"telemedicine in intensive care units scoping review","src":["cbs"],"src-code":["DI-U-CBS"],"type":"djr","type-grp":["all","pub"]},"id":"S01-000.00-283240","identifier":[{"id":"85119021789","type":"scopus"}],"ids":["cbs-5296f6a2-5100-40cd-800e-1f168dd21e9f"],"keyword":["Care compliance","Critical care","Digital health","Health care system","Health technology","Hospital","Implementation","Intensive care unit","Review","Tele-ICU","Telehealth","Telemedicine","Tertiary hospitals"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-4-B8A79093D8D1FC94F4AAA17266CBCC51"],"oai":{"class":"Realised","mra":["Social Science (SOC)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"de","key":"charite universitatsmedizin berlin","loc":["Germany","Europe, EU","OECD"],"name":"Charite - Universitatsmedizin Berlin","used":1},{"affno":"2","country":"de","key":"technische universität münchen","loc":["Germany","Europe, EU","OECD"],"name":"Technische Universität München","used":1},{"affno":"3","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Digitalization"],"nora_code":"DI-U-CBS","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Camille","key":"guinemerpau","last":"Guinemer","name":"Guinemer, Camille","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Martin","key":"boekerpau","last":"Boeker","name":"Boeker, Martin","rank":2,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"country":"dk","first":"Daniel","key":"fürstenaupau","last":"Fürstenau","locid":"e1b78deb-bdff-40e4-935b-f1a97937809c","name":"Fürstenau, Daniel","orcid":"0000-0001-8490-7707","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Akira-Sebastian","key":"poncettepau","last":"Poncette","name":"Poncette, Akira-Sebastian","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Björn","key":"weisspau","last":"Weiss","name":"Weiss, Björn","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rudolf","key":"mörgelipau","last":"Mörgeli","name":"Mörgeli, Rudolf","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Felix","key":"balzerpau","last":"Balzer","name":"Balzer, Felix","rank":7,"rolecode":"pau"}],"pub":{"doi":"10.2196/32264","issn":["14388871","14394456"],"issn_org":["14394456"],"issue":"11","journal":"Journal of Medical Internet Research","paperid":"e32264","publisher":"JMIR Publications Inc.","status":"p","title":"Journal of Medical Internet Research","volume":"23"},"review":"Peer Reviewed","scoID":["2-s2.0-85119021789"],"search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["cbs-5296f6a2-5100-40cd-800e-1f168dd21e9f"],"src":["CBS Copenhagen Business School"],"title":"Telemedicine in Intensive Care Units : Scoping Review","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-283240","year":"2021","yearsub":"2021"}
{"abstract":"Participatory urban planning enables citizens to make their voices heard in the urban planning process. The resulting measures are more likely to be accepted by the community. However, the participation process becomes more effortful and timeconsuming. New approaches have been developed using digital technologies to facilitate citizen participation, such as topic modeling based on social media. Using Twitter data for the city of Berlin, we explore how social media and topic modeling can be used to classify and analyze citizen opinions. We develop a Social Citizen Dashboard allowing for a better understanding of changes in citizens’ priorities and incorporating constant cycles of feedback throughout planning phases. Evaluation interviews indicate the dashboard’s potential usefulness and implications as well as point to limitation in data quality and spur further research potentials.","author_count":6,"contributors":["Fürstenau, Daniel","Morelli, Flavio","Meindl, Kristina","Schulte-Althoff, Mattias","Rabe, Jochen"],"cuid":["S01-000.00-285332"],"event":{"acronym":"HICSS","end":"2021-01-08","place":"Virtual, Online, us","start":"2021-01-05","title":"54th Annual Hawaii International Conference on System Sciences, HICSS 2021","year":"2021"},"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","Freie Universität Berlin","Technische Universität Berlin"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"pr","rtype":["clu"],"sorti":"a social citizen dashboard for participatory urban planning in berlin prototype and evaluation","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.24251/HICSS.2021.288","version":"Published Version"},"id":"S01-000.00-285332","identifier":[{"id":"85108367907","type":"scopus"}],"ids":["cbs-678d751f-9341-4dd8-97cc-86880f22a084"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-3-1484A91826580FC9C715DEB2753EBB65"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://research-api.cbs.dk/ws/files/70078718/daniel_furstenau_et_al_a_social_citizen_dashboard_for_participatory_urban_planning_in_berlin_publishersversion.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.24251/HICSS.2021.288","version":"Published Version"}],"oai":{"class":"Realised","mra":["Social Science (SOC)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Digitalization"],"nora_code":"DI-U-CBS","used":1},{"affno":"2","country":"de","key":"freie universität berlin","loc":["Germany","Europe, EU","OECD"],"name":"Freie Universität Berlin","used":1},{"affno":"3","country":"de","key":"technische universität berlin","loc":["Germany","Europe, EU","OECD"],"name":"Technische Universität Berlin","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"Daniel","key":"fürstenaupau","last":"Fürstenau","locid":"e1b78deb-bdff-40e4-935b-f1a97937809c","name":"Fürstenau, Daniel","orcid":"0000-0001-8490-7707","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Flavio","key":"morellipau","last":"Morelli","name":"Morelli, Flavio","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kristina","key":"meindlpau","last":"Meindl","name":"Meindl, Kristina","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mattias","key":"schultealthoffpau","last":"Schulte-Althoff","name":"Schulte-Althoff, Mattias","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jochen","key":"rabepau","last":"Rabe","name":"Rabe, Jochen","rank":5,"rolecode":"pau"},{"affno":"","first":"Tung X.","key":"buipedh","last":"Bui","name":"Bui, Tung X.","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.24251/hicss.2021.288","eisbn":["9780998133140"],"issn":["10603425"],"pages":"2358-2367","place":"Honolulu","publisher":"Hawaii International Conference on System Sciences (HICSS)","series":"Proceedings of the Annual Hawaii International Conference on System Sciences","status":"p","title":"Proceedings of the 54th Hawaii International Conference on System Sciences"},"review":"Peer Reviewed","scoID":["2-s2.0-85108367907"],"search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["cbs-678d751f-9341-4dd8-97cc-86880f22a084"],"src":["CBS Copenhagen Business School"],"title":"A Social Citizen Dashboard for Participatory Urban Planning in Berlin : Prototype and Evaluation","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-285332","year":"2021","yearsub":"2021"}
{"abstract":"Digital startups’ use of AI technologies has significantly increased in recent years, bringing to the fore specific barriers to deployment, use, and extraction of business value from AI. Utilizing a quantitative framework regarding the themes of startup growth and scaling, we examine the scaling behavior of AI, platform, and service startups. We find evidence of a sublinear scaling ratio of revenue to age-discounted employment count. The results suggest that revenue-employee growth pattern of AI startups is close to that of service startups, and less so to that of platform startups. Furthermore, we find a superlinear growth pattern of acquired funding in relation to the employment size that is largest for AI startups, possibly suggesting hype tendencies around AI startups. We discuss implications in the light of new economies of scale and scope of AI startups related to decision-making and prediction.","author_count":3,"contributors":["Schulte-Althoff, Mattias","Fürstenau, Daniel","Moo Lee, Gene"],"cuid":["S01-000.00-299314"],"event":{"acronym":"HICSS","end":"2021-01-08","place":"Virtual, Online, us","start":"2021-01-05","title":"54th Annual Hawaii International Conference on System Sciences, HICSS 2021","year":"2021"},"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","Europe, EU","OECD"],"country":["Canada","Germany"],"glorg":["All Global Affiliations","Freie Universität Berlin","Sauder School of Business"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"pr","rtype":["clu"],"sorti":"a scaling perspective on ai startups","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.24251/HICSS.2021.784","version":"Published Version"},"id":"S01-000.00-299314","identifier":[{"id":"85108324992","type":"scopus"}],"ids":["cbs-fa9c180a-5cd3-43c2-b5a0-f1c72cd9f2bb"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-3-164D0A07FA831A78FDEBF4BF9542E863"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.24251/HICSS.2021.784","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://research-api.cbs.dk/ws/files/70078696/matthias_schulte_althoff_et_al_a_scaling_perspective_on_ai_startups_publishersversion.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Social Science (SOC)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"de","key":"freie universität berlin","loc":["Germany","Europe, EU","OECD"],"name":"Freie Universität Berlin","used":1},{"affno":"2","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Digitalization"],"nora_code":"DI-U-CBS","used":1},{"affno":"3","country":"ca","key":"sauder school of business","loc":["Canada","America, North","OECD"],"name":"Sauder School of Business","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Mattias","key":"schultealthoffpau","last":"Schulte-Althoff","name":"Schulte-Althoff, Mattias","rank":1,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Daniel","key":"fürstenaupau","last":"Fürstenau","locid":"e1b78deb-bdff-40e4-935b-f1a97937809c","name":"Fürstenau, Daniel","orcid":"0000-0001-8490-7707","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Gene","key":"mooleepau","last":"Moo Lee","name":"Moo Lee, Gene","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.24251/hicss.2021.784","eisbn":["9780998133140"],"issn":["10603425"],"pages":"6515-6524","place":"Honolulu","publisher":"Hawaii International Conference on System Sciences (HICSS)","series":"Proceedings of the Annual Hawaii International Conference on System Sciences","status":"p","title":"Proceedings of the 54th Hawaii International Conference on System Sciences"},"review":"Peer Reviewed","scoID":["2-s2.0-85108324992"],"search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["cbs-fa9c180a-5cd3-43c2-b5a0-f1c72cd9f2bb"],"src":["CBS Copenhagen Business School"],"title":"A Scaling Perspective on AI Startups","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-299314","year":"2021","yearsub":"2021"}
{"abstract":"Background: Artificial intelligence (AI) holds the promise of supporting nurses’ clinical decision-making in complex care situations or conducting tasks that are remote from direct patient interaction, such as documentation processes. There has been an increase in the research and development of AI applications for nursing care, but there is a persistent lack of an extensive overview covering the evidence base for promising application scenarios. Objective: This study synthesizes literature on application scenarios for AI in nursing care settings as well as highlights adjacent aspects in the ethical, legal, and social discourse surrounding the application of AI in nursing care. Methods: Following a rapid review design, PubMed, CINAHL, Association for Computing Machinery Digital Library, Institute of Electrical and Electronics Engineers Xplore, Digital Bibliography & Library Project, and Association for Information Systems Library, as well as the libraries of leading AI conferences, were searched in June 2020. Publications of original quantitative and qualitative research, systematic reviews, discussion papers, and essays on the ethical, legal, and social implications published in English were included. Eligible studies were analyzed on the basis of predetermined selection criteria. Results: The titles and abstracts of 7016 publications and 704 full texts were screened, and 292 publications were included. Hospitals were the most prominent study setting, followed by independent living at home; fewer application scenarios were identified for nursing homes or home care. Most studies used machine learning algorithms, whereas expert or hybrid systems were entailed in less than every 10th publication. The application context of focusing on image and signal processing with tracking, monitoring, or the classification of activity and health followed by care coordination and communication, as well as fall detection, was the main purpose of AI applications. Few studies have reported the effects of AI applications on clinical or organizational outcomes, lacking particularly in data gathered outside laboratory conditions. In addition to technological requirements, the reporting and inclusion of certain requirements capture more overarching topics, such as data privacy, safety, and technology acceptance. Ethical, legal, and social implications reflect the discourse on technology use in health care but have mostly not been discussed in meaningful and potentially encompassing detail. Conclusions: The results highlight the potential for the application of AI systems in different nursing care settings. Considering the lack of findings on the effectiveness and application of AI systems in real-world scenarios, future research should reflect on a more nursing care–specific perspective toward objectives, outcomes, and benefits. We identify that, crucially, an advancement in technological-societal discourse that surrounds the ethical and legal implications of AI applications in nursing care is a necessary next step. Further, we outline the need for greater participation among all of the stakeholders involved.","author_count":7,"contributors":["Seibert, Kathrin","Domhoff, Dominik","Bruch, Dominik","Schulte-Althoff, Matthias","Fürstenau, Daniel","Biessmann, Felix","Wolf-Ostermann, Karin"],"cuid":["S01-000.00-277922"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"corresponding_author":["Seibert, Kathrin"],"country":["Germany"],"glorg":["All Global Affiliations","Auf- und Umbruch im Gesundheitswesen UG","Berliner Hochschule für Technik","Freie Universität Berlin","Universität Bremen"],"keyword":["Artificial intelligence","Expert system","Hybrid system","Machine learning","Nursing Care"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"pr","rtype":["clu"],"sorti":"application scenarios for artificial intelligence in nursing care rapid review","src":["cbs"],"src-code":["DI-U-CBS"],"type":"djr","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.2196/26522","version":"Published Version"},"funding_acknowledgement":["KWO, DF, and FB conceived the superordinate research project and applied for funding. KS and DD conceptualized this rapid review and performed searches, screening, data extraction, coding, and analyses. KS acted as a second coder for the type of artificial intelligence (AI) system and the application context, as well as wrote the initial manuscript. DB performed data extraction, was the first coder for the type of AI approach and application context, and contributed greatly to the results section of the initial manuscript. DD was the second coder for the type of AI approach and application context. DF, FB, and MSA supervised the development of the search strategy and coding criteria. MSA and FB were the third coders for the type of AI approach and application context in case of disagreement between the first and second coders. All authors commented on and approved the final manuscript. This rapid review is part of the research project “Exploratory project on AI in Nursing” and is funded by the German Ministry for Education and Research (grant #16SV8508)."],"id":"S01-000.00-277922","identifier":[{"id":"85120869677","type":"scopus"}],"ids":["cbs-1af40193-a296-4a2a-aebf-f967040540e0"],"keyword":["Artificial intelligence","Expert system","Hybrid system","Machine learning","Nursing care"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-4-570E897270A6E86E6CDDE583FDB5BDCC"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://research-api.cbs.dk/ws/files/70078659/kathrin_seibert_et_al_application_scenarios_for_artificial_intelligence_in_nursing_care_publishersversion.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.2196/26522","version":"Published Version"}],"oai":{"class":"Realised","mra":["Social Science (SOC)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"de","key":"universität bremen","loc":["Germany","Europe, EU","OECD"],"name":"Universität Bremen","used":1},{"affno":"2","country":"de","key":"auf und umbruch im gesundheitswesen ug","loc":["Germany","Europe, EU","OECD"],"name":"Auf- und Umbruch im Gesundheitswesen UG","used":1},{"affno":"3","country":"de","key":"freie universität berlin","loc":["Germany","Europe, EU","OECD"],"name":"Freie Universität Berlin","used":1},{"affno":"4","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Digitalization"],"nora_code":"DI-U-CBS","used":1},{"affno":"5","country":"de","key":"berliner hochschule für technik","loc":["Germany","Europe, EU","OECD"],"name":"Berliner Hochschule für Technik","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Kathrin","key":"seibertpau","last":"Seibert","name":"Seibert, Kathrin","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Dominik","key":"domhoffpau","last":"Domhoff","name":"Domhoff, Dominik","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Dominik","key":"bruchpau","last":"Bruch","name":"Bruch, Dominik","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Matthias","key":"schultealthoffpau","last":"Schulte-Althoff","name":"Schulte-Althoff, Matthias","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Daniel","key":"fürstenaupau","last":"Fürstenau","locid":"e1b78deb-bdff-40e4-935b-f1a97937809c","name":"Fürstenau, Daniel","orcid":"0000-0001-8490-7707","rank":5,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Felix","key":"biessmannpau","last":"Biessmann","name":"Biessmann, Felix","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Karin","key":"wolfostermannpau","last":"Wolf-Ostermann","name":"Wolf-Ostermann, Karin","rank":7,"rolecode":"pau"}],"pub":{"doi":"10.2196/26522","issn":["14388871","14394456"],"issn_org":["14394456"],"issue":"11","journal":"Journal of Medical Internet Research","paperid":"e26522","publisher":"JMIR Publications Inc.","status":"p","title":"Journal of Medical Internet Research","volume":"23"},"review":"Peer Reviewed","scoID":["2-s2.0-85120869677"],"search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["cbs-1af40193-a296-4a2a-aebf-f967040540e0"],"src":["CBS Copenhagen Business School"],"title":"Application Scenarios for Artificial Intelligence in Nursing Care: Rapid Review","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-277922","year":"2021","yearsub":"2021"}
{"abstract":"Multi-sided platforms in healthcare often focus their business model on standardizing care for wide-spread, chronic diseases. However, there is a lack of knowledge surrounding platform business models enabling individualized care coordination for patients with rare diseases. This paper analyses the development of a complex platform business model addressing Amyotrophic Lateral Sclerosis, a severe neurological disease that requires the coordination of a diverse network of medical specialists, care, and equipment providers. A longitudinal case study examines the platform’s development, focusing subsequently on qualitative and efficient care coordination, care research, and active and direct involvement of patients, as well as establishing two business models, namely, care coordination and care research. We reconstruct how these complex platform business models were configured to improve patient care and care research, thereby creating immediate value for patients and insights for long-term care improvements. The ongoing platform development carefully balances value generation for diverse stakeholders and economic sustainability.","author_count":4,"contributors":["Fürstenau, Daniel","Klein, Stefan","Vogel, Amyn","Auschra, Carolin"],"cuid":["S01-000.00-291672"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"corresponding_author":["Fürstenau, Daniel"],"country":["Germany"],"glorg":["All Global Affiliations","Freie Universität Berlin","University of Munster"],"keyword":["Business model","Care research","Datafication","Digital health platform","Process perspective","Rare disease","Value based health"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"pr","rtype":["clu"],"sorti":"multi sided platform and data driven care research a longitudinal case study on business model innovation for improving care in complex neurological diseases","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s12525-021-00461-8","version":"Published Version"},"id":"S01-000.00-291672","identifier":[{"id":"000631473700002","type":"wos"},{"id":"85103218189","type":"scopus"}],"ids":["cbs-ab506935-49fc-4dd0-a7d4-9271e5691c96"],"keyword":["Business model","Care research","Datafication","Digital health platform","Process persepctive","Process perspective","Rare disease","Value-based health"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-4-DC38E1DCC3351335CE49D121B2BA2002"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s12525-021-00461-8","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://research-api.cbs.dk/ws/files/93811277/daniel_furstenau_et_al_multi_sided_platform_and_data_driven_care_research_publishersversion.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Social Science (SOC)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Digitalization"],"nora_code":"DI-U-CBS","used":1},{"affno":"2","country":"de","key":"freie universität berlin","loc":["Germany","Europe, EU","OECD"],"name":"Freie Universität Berlin","used":1},{"affno":"3","country":"de","key":"university of munster","loc":["Germany","Europe, EU","OECD"],"name":"University of Munster","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"Daniel","key":"fürstenaupau","last":"Fürstenau","locid":"e1b78deb-bdff-40e4-935b-f1a97937809c","name":"Fürstenau, Daniel","orcid":"0000-0001-8490-7707","rank":1,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Stefan","key":"kleinpau","last":"Klein","name":"Klein, Stefan","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Amyn","key":"vogelpau","last":"Vogel","name":"Vogel, Amyn","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Carolin","key":"auschrapau","last":"Auschra","name":"Auschra, Carolin","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1007/s12525-021-00461-8","issn":["10196781","14228890"],"issn_org":["10196781"],"issue":"4","journal":"Electronic Markets","pages":"811-828","publisher":"Springer","status":"p","title":"Electronic Markets","volume":"31"},"review":"Peer Reviewed","scoID":["2-s2.0-85103218189"],"search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["cbs-ab506935-49fc-4dd0-a7d4-9271e5691c96"],"src":["CBS Copenhagen Business School"],"title":"Multi-sided Platform and Data-driven Care Research : A Longitudinal Case Study on Business Model Innovation for Improving Care in Complex Neurological Diseases","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-291672","year":"2021","yearsub":"2021"}
{"abstract":"The literature on healthcare management has noted that shared decision-making (SDM) - a practice of organizing joint decisions between healthcare professionals and patients - should improve healthcare outcomes through patient engagement and autonomy, fostering patient-centeredness. While SDM projects are implemented across Europe and the US, the diffusion of the practice remains partial, and its' conceptualization scattered. Healthcare management literature explores SDM on the underlying assumption that its limited diffusion results from an information problem, implying objective criteria and rational behavior. The purpose of this research is to study the social construction of SDM within the clinical setting and the underlying rationales using the case of one of the largest healthcare markets worldwide – Germany. To capture the complexity of SDM, a frame analysis is conducted on its medial representations. News media is both influential in shaping public opinion, as well as in generating public discourse. This analysis enables one to elaborate different facets of the construct of SDM, to capture inherent patterns of facilitating and obstructing aspects and to explore consequences for the diffusion of SDM. Three facilitating and three obstructive frames on the implementation of SDM were identified. The polarities of these frames range from the questioning of one's decision-making authority to the perception of individual competence and decision-making agency. Moreover, this study reflects on how physicians' and patients' role for SDM is conceived.","author_count":3,"contributors":["Vogel, Amyn","Balzer, Felix","Fürstenau, Daniel"],"cuid":["S01-000.00-292293"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"corresponding_author":["Vogel, Amyn"],"country":["Germany"],"glorg":["All Global Affiliations","Charite - Universitatsmedizin Berlin","Freie Universität Berlin"],"keyword":["Frame Analysis","Healthcare innovation","Innovation acceptance","News media analysis","Shared decision making"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"pr","rtype":["clu"],"sorti":"the social construction of the patient physician relationship in the clinical encounter media frames on shared decision making in germany","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://research-api.cbs.dk/ws/files/69698977/amyn_vogel_et_al_the_social_construction_of_the_patient_physician_relationship_acceptedversion.pdf","version":"Authors Final Version"},"id":"S01-000.00-292293","identifier":[{"id":"85116021047","type":"scopus"}],"ids":["cbs-b21056ff-bd18-4681-9a89-4c2cb2b7d534"],"keyword":["Frame analysis","Healthcare innovation","Innovation acceptance","News media analysis","Shared decision-making"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-4-3EA6A96B0B918E2E8750D50EEDE4F7E9"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://research-api.cbs.dk/ws/files/69698977/amyn_vogel_et_al_the_social_construction_of_the_patient_physician_relationship_acceptedversion.pdf","version":"Authors Final Version"}],"oai":{"class":"Blocked","mra":["Social Science (SOC)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"de","key":"freie universität berlin","loc":["Germany","Europe, EU","OECD"],"name":"Freie Universität Berlin","used":1},{"affno":"2","country":"de","key":"charite universitatsmedizin berlin","loc":["Germany","Europe, EU","OECD"],"name":"Charite - Universitatsmedizin Berlin","used":1},{"affno":"3","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Digitalization"],"nora_code":"DI-U-CBS","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Amyn","key":"vogelpau","last":"Vogel","name":"Vogel, Amyn","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Felix","key":"balzerpau","last":"Balzer","name":"Balzer, Felix","rank":2,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"country":"dk","first":"Daniel","key":"fürstenaupau","last":"Fürstenau","locid":"e1b78deb-bdff-40e4-935b-f1a97937809c","name":"Fürstenau, Daniel","orcid":"0000-0001-8490-7707","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.socscimed.2021.114420","issn":["02779536","18735347"],"issn_org":["02779536"],"journal":"Social Science & Medicine","paperid":"114420","publisher":"Elsevier","status":"p","title":"Social Science & Medicine","volume":"289"},"review":"Peer Reviewed","scoID":["2-s2.0-85116021047"],"search":{"DAF":["All Danish Affiliations","All Universities","Copenhagen Business School","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["cbs-b21056ff-bd18-4681-9a89-4c2cb2b7d534"],"src":["CBS Copenhagen Business School"],"title":"The Social Construction of the Patient-physician Relationship in the Clinical Encounter : Media Frames on Shared Decision Making in Germany","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-292293","year":"2021","yearsub":"2021"}
{"abstract":"This report documents the outcomes of a professional development workshop (PDW) held at the 40th International Conference on Information Systems in Munich, Germany. The workshop’s goal was to identify how information systems (IS) researchers can contribute to enriching the understanding of digital entrepreneurship—that is, the intersection of digital technologies and entrepreneurship. The PDW assembled numerous IS researchers working on different aspects of digital entrepreneurship. Jointly, we delineated digital entrepreneurship from related phenomena and conceptualized different roles of digital technologies for entrepreneurial endeavors. We also identified relevant strategies, opportunities, and challenges in conducting digital entrepreneurship research. This report summarizes the shared views that emerged from the interactions at the PDW and during the collaborative writing of this report. The report provides IS researchers interested in digital entrepreneurship with food for thought and a foundation for future research.","author_count":11,"contributors":["von Briel, Frederik","Selander, Lisen","Hukal, Philipp","Lehmann, Julian","Rothe, Hannes","Fürstenau, Daniel","Recker, Jan","Jarvenpaa, Sirkka","Yoo, Youngjin","Alpar, Paul","Wurm, Bastian"],"cuid":["S01-000.00-276460"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Europe, EU","Nordic","OECD","Oceania"],"corresponding_author":["von Briel, Frederik"],"country":["Australia","Austria","Germany","Netherlands","Sweden","United States"],"glorg":["All Global Affiliations","Case Western Reserve University","Freie Universität Berlin","Philipps-Universität Marburg","University of Cologne","University of Gothenburg","University of Queensland","University of Texas at Austin","Vienna University of Economics and Business","Vrije Universiteit Amsterdam"],"keyword":["Digital entrepreneurship","Research agenda"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"pr","rtype":["clu"],"sorti":"researching digital entrepreneurship current issues and suggestions for future directions","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://espace.library.uq.edu.au/view/UQ:4c7efe1/UQ4c7efe1_OA.pdf?dsi_version=2f1529141c303d7f7bce15f7322ae3ba","version":"Published Version"},"id":"S01-000.00-276460","identifier":[{"id":"85108636787","type":"scopus"}],"ids":["cbs-0bca17fa-80f9-43ef-82ee-72d4eadf5d20"],"keyword":["Digital entrepreneurship","Digital ventures","Entrepreneurial endeavors","Entrepreneurship processes","Research agenda"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-3-33C9AFA2E19908590EA812228BE9C4CB"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://espace.library.uq.edu.au/view/UQ:4c7efe1/UQ4c7efe1_OA.pdf?dsi_version=2f1529141c303d7f7bce15f7322ae3ba","version":"Published Version"},{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://research-api.cbs.dk/ws/files/66613187/phillip_hukal_et_al_researching_digital_entrepreneurship_acceptedmanuscript.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Social Science (SOC)"],"yearPub":"2021","yearSub":"2020"},"org":[{"affno":"1","country":"au","key":"university of queensland","loc":["Australia","Oceania","OECD"],"name":"University of Queensland","used":1},{"affno":"2","country":"se","key":"university of gothenburg","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"University of Gothenburg","used":1},{"affno":"3","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Digitalization"],"nora_code":"DI-U-CBS","used":1},{"affno":"4","country":"nl","key":"vrije universiteit amsterdam","loc":["Netherlands","Europe, EU","OECD"],"name":"Vrije Universiteit Amsterdam","used":1},{"affno":"5","country":"de","key":"freie universität berlin","loc":["Germany","Europe, EU","OECD"],"name":"Freie Universität Berlin","used":1},{"affno":"6","country":"de","key":"university of cologne","loc":["Germany","Europe, EU","OECD"],"name":"University of Cologne","used":1},{"affno":"7","country":"us","key":"university of texas at austin","loc":["United States","America, North","OECD"],"name":"University of Texas at Austin","used":1},{"affno":"8","country":"us","key":"case western reserve university","loc":["United States","America, North","OECD"],"name":"Case Western Reserve University","used":1},{"affno":"9","country":"de","key":"philipps universität marburg","loc":["Germany","Europe, EU","OECD"],"name":"Philipps-Universität Marburg","used":1},{"affno":"10","country":"at","key":"vienna university of economics and business","loc":["Austria","Europe, EU","OECD"],"name":"Vienna University of Economics and Business","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Frederik","key":"vonbrielpau","last":"von Briel","name":"von Briel, Frederik","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lisen","key":"selanderpau","last":"Selander","name":"Selander, Lisen","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Philipp","key":"hukalpau","last":"Hukal","locid":"339ca035-98ca-4ac7-a420-ccab91b36ed3","name":"Hukal, Philipp","orcid":"0000-0002-5928-0153","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Julian","key":"lehmannpau","last":"Lehmann","name":"Lehmann, Julian","rank":4,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Hannes","key":"