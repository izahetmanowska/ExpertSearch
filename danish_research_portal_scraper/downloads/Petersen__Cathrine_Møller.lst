,{"affno":"2","corresponding":null,"first":"Martin","key":"overgaardpau","last":"Overgaard","locid":"0aefaa4b-0a41-4d31-8988-a4c60c5be7f6","name":"Overgaard, Martin","orcid":"0000-0003-2277-590X","rank":9,"rolecode":"pau"},{"affno":"1 4","first":"Tine Dalsgaard","key":"clausenpau","last":"Clausen","locid":"047e6356-0a01-48a6-9a2e-fa550c06183e","name":"Clausen, Tine Dalsgaard","rank":10,"rolecode":"pau"}],"pmid":["38319177"],"pub":{"doi":"10.1080/00365513.2024.2312152","issn":["00365513","0085591X"],"issn_org":["00365513"],"issue":"1","journal":"Scandinavian Journal of Clinical & Laboratory Investigation","pages":"30-37","publisher":"Informa Healthcare","status":"p","title":"Scandinavian Journal of Clinical & Laboratory Investigation","title_org":"Scandinavian Journal of Clinical and Laboratory Investigation","volume":"84"},"review":"Peer Reviewed","scoID":["2-s2.0-85184456745"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-988947da-2b7d-4ad7-a2c5-dedec0c01e89","sdu-91c96641-0b25-4a3f-8295-bbbf1eb08bd3"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Pre-analytical diagnostic differences despite high adherence to guidelines for gestational diabetes mellitus","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-097.67-725225","year":"2024","yearsub":"2024"}
{"abstract":"In connection with the publication of a clinical practice guideline on the management of low back pain (LBP) in general practice in Denmark, a cluster randomised controlled trial was conducted. In this trial, a multifaceted guideline implementation strategy to improve general practitioners' treatment of patients with LBP was compared with a usual implementation strategy. The aim was to determine whether the multifaceted strategy was cost effective, as compared with the usual implementation strategy. The economic evaluation was conducted as a cost-utility analysis where cost collected from a societal perspective and quality-adjusted life years were used as outcome measures. The analysis was conducted as a within-trial analysis with a 12-month time horizon consistent with the follow-up period of the clinical trial. To adjust for a priori selected covariates, generalised linear models with a gamma family were used to estimate incremental costs and quality-adjusted life years. Furthermore, both deterministic and probabilistic sensitivity analyses were conducted. Results showed that costs associated with primary health care were higher, whereas secondary health care costs were lower for the intervention group when compared with the control group. When adjusting for covariates, the intervention was less costly, and there was no significant difference in effect between the 2 groups. Sensitivity analyses showed that results were sensitive to uncertainty. In conclusion, the multifaceted implementation strategy was cost saving when compared with the usual strategy for implementing LBP clinical practice guidelines in general practice. Furthermore, there was no significant difference in effect, and the estimate was sensitive to uncertainty.","author_count":5,"contributors":["Jensen, Cathrine Elgaard","Riis, Allan","Petersen, Karin Dam","Jensen, Martin Bach","Pedersen, Kjeld Møller"],"cuid":["S02-099.48-010470"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"corresponding_author":["Jensen, Cathrine Elgaard"],"keyword":["Clinical practice guideline","Cost utility analysis","Economic evaluation","Implementation","Low back pain"],"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-AAU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"economic evaluation of an implementation strategy for the management of low back pain in general practice","src":["aau","sdu"],"src-code":["DI-U-AAU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85021309181","version":"Other Version"},"id":"S02-099.48-010470","identifier":[{"id":"000402430600016","type":"wos"},{"id":"28114182","type":"pmid"},{"id":"85021309181","type":"scopus"}],"ids":["aau-db914971-7beb-410a-a2c1-a6c406d3b6c3","sdu-6d8bdc53-0c35-4992-ab02-8f480f6d1378"],"keyword":["Clinical practice guideline","Cost-utility analysis","Economic evaluation","Implementation","Low back pain"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-2-5-E3A9300300C3BF3D5CE9D2205440290A"],"oai":{"class":"Unused","mra":["Social Science (SOC)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Social Sciences","Aalborg University, The Faculty of Social Sciences, Department of Business and Management","Aalborg University, The Faculty of Social Sciences, Department of Business and Management, Danish Center for Healthcare Improvements (Business)"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"sdu university of souther