orresponding":null,"first":"Finn Ole","key":"larsenpau","last":"Larsen","name":"Larsen, Finn Ole","rank":1,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"country":"dk","first":"Per","key":"pfeifferpau","last":"Pfeiffer","locid":"37da1b83-d32a-4f6c-bde6-ca05372851a5","name":"Pfeiffer, Per","orcid":"0000-0002-2925-0586","rank":2,"rolecode":"pau"},{"affno":"","first":"Dorte","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Dorte","rank":3,"rolecode":"pau"},{"affno":"","first":"Kristin","key":"skougaardpau","last":"Skougaard","name":"Skougaard, Kristin","rank":4,"rolecode":"pau"},{"affno":"3","first":"Camilla","key":"qvortruppau","last":"Qvortrup","name":"Qvortrup, Camilla","orcid":"0000-0001-9338-9841","rank":5,"rolecode":"pau"},{"affno":"","first":"Kirsten","key":"vistisenpau","last":"Vistisen","name":"Vistisen, Kirsten","rank":6,"rolecode":"pau"},{"affno":"","first":"Anna-Lene Gunge","key":"frommpau","last":"Fromm","name":"Fromm, Anna-Lene Gunge","rank":7,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Trine L","key":"jørgensenpau","last":"Jørgensen","locid":"f9eac821-ade9-44b6-8f42-747089a921cf","name":"Jørgensen, Trine Lembrecht","name_org":"Jørgensen, Trine L","orcid":"0000-0002-7968-2694","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jon K","key":"bjerregaardpau","last":"Bjerregaard","locid":"397727c7-b7b5-4419-a6b6-665b638da626","name":"Kroll Bjerregaard, Jon","name_org":"Bjerregaard, Jon K","orcid":"0000-0003-1088-7242","rank":9,"rolecode":"pau"},{"affno":"","first":"Estrid","key":"hoegdallpau","last":"Hoegdall","name":"Hoegdall, Estrid","rank":10,"rolecode":"pau"},{"affno":"","first":"Benny V","key":"jensenpau","last":"Jensen","name":"Jensen, Benny V","rank":11,"rolecode":"pau"}],"pmid":["21529301"],"pub":{"doi":"10.3109/0284186x.2010.546369","issn":["0284186X","11001704"],"issn_org":["0284186X"],"issue":"4","journal":"Acta Oncologica","pages":"574-7","publisher":"Medical Journals Sweden AB","status":"p","title":"Acta Oncologica","volume":"50"},"review":"Peer Reviewed","scoID":["2-s2.0-79955632360"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Other Hospitals","Universities","University of Copenhagen","University of Southern Denmark","onkologi"],"PST":["Published"]},"sid":["ku-9cd18403-c672-40f5-89aa-17cb76cb5db3","sdu-d21fdd07-29b0-426b-95f5-ff24d506249a"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Bevacizumab in combination with cetuximab and irinotecan after failure of cetuximab and irinotecan in patients with metastatic colorectal cancer","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-088.24-044752","year":"2011","yearsub":"2011"}
{"abstract":"A 6-year nationwide study of fungemia in Denmark was performed using data from an active fungemia surveillance programme and from laboratory information systems in non-participating regions. A total of 2,820 episodes of fungemia were recorded. The incidence increased 2004-2007 (7.7-9.6/100,000) and decreased slightly 2008-2009 (8.7-8.6/100,000). The highest incidences were seen at the extremes of age (i.e. 11.3 and 37.1/100,000 in the <1 and 70-79 years, respectively. The rate was higher in males than in females (10.1 vs. 7.6/100,000, P=0.003) with the largest difference observed for patients 50+ years of age. The species distribution varied significantly by both age and gender. Candida species accounted for 98% of the pathogens and C. albicans was predominant although the proportion decreased (64.4% to 53.2%, P<0.0001). C. glabrata ranked second and the proportion increased (16.5% to 25.9%, P=0.003). C. glabrata was more common in adults and females compared to children and males, whereas C. tropicalis was more common in males (P=0.020). C. krusei was a rare isolate (4.1%) except at one university hospitals. Acquired resistance to amphotericin and echinocandins was rare. However, resistance to fluconazole (MIC>4 μg/ml) occurred in: C. albicans 7/1183 (0.6%), C. dubliniensis 2/65 (3.1%), C. parapsilosis 5/83 (6.0%) and C. tropicalis 7/104 (6.7%). Overall, 70.8% of fungemia isolates were fully fluconazole susceptible but the proportion decreased (79.7% to 68.9%, P=0.02). The study confirmed a three times higher incidence rate of fungemia in Denmark compared to other Nordic countries and identified marked differences related to age and gender. Decreased susceptibility to fluconazole was frequent and increasing.","author_count":22,"contributors":["Arendrup, Maiken Cavling","Bruun, Brita","Christensen, Jens Jørgen","Fuursted, Kurt","Johansen, Helle Krogh","Kjældgaard, Poul","Knudsen, Jenny Dahl","Kristensen, Lise","Møller, Jens","Nielsen, Lene","Rosenvinge, Flemming Schønning","Røder, Bent","Carl Schønheyder, Henrik","Thomsen, Marianne K","Truberg, Kjeld","Thomsen, Marianne Kragh","Fuursted, Kurt"],"cuid":["S04-096.12-013761"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-GV-SSI","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"national surveillance of fungemia in denmark 000000002004 to 000000002009","src":["au","ku","sdu"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1128/JCM.01811-10","version":"Other Version"},"id":"S04-096.12-013761","identifier":[{"id":"20980569","type":"pmid"},{"id":"PMC3020479","type":"pmcid"},{"id":"78650859229","type":"scopus"}],"ids":["au-102ea407-a523-4781-ad5d-d164bb60361a","au-85167b00-ed6f-11df-a891-000ea68e967b","ku-5fe266bd-f92a-45d8-bae4-a0eb0ba4c8a6","sdu-e0b2f559-323b-410e-871f-36cfa3e9a619"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-B33035228807CC3CA7B143667DD73231"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1128/JCM.01811-10","version":"Other Version"}],"org":[{"affno":"1","country":"dk","key":"ssi statens serum institut","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-SSI","l3nn":"SSI Statens Serum Institut","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SSI Statens Serum Institut","namevar":["Statens Serum Institut"],"nora_code":"DI-GV-SSI","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences","SDU, The Faculty of Health Sciences, Department of Regional Health Research, IRS - Hospital Sønderjylland, Research Unit of Clinical Microbiology (Sønderborg)"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Clinical Microbiology"],"nora_code":"DI-U-AU","used":1},{"affno":4,"key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Immunology and Microbiology, Department of Immunology and Microbiology"],"nora_code":"DI-U-KU"}],"person":[{"affno":"","corresponding":null,"first":"Maiken Cavling","key":"arendrupmaikencavlingpau","last":"Arendrup","name":"Arendrup, Maiken Cavling","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Brita","key":"bruunbritapau","last":"Bruun","name":"Bruun, Brita","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Brita Grønbech","key":"bruunbritagrønbechpau","last":"Bruun","name":"Bruun, Brita Grønbech","rank":2,"rolecode":"pau"},{"affno":"1","first":"Jens Jørgen","key":"christensenjensjørgenpau","last":"Christensen","name":"Christensen, Jens Jørgen","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Kurt","key":"fuurstedkurtpau","last":"Fuursted","locid":"4480caa1-e763-4685-b132-f26a60bedce8","name":"Fuursted, Kurt","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Helle Kro