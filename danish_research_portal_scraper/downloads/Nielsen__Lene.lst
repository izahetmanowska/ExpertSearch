{"abstract":"The aim of this study was to determine whether the Chronic Kidney Disease Epidemiology Collaboration (CKD-EPI)- or Cockcroft-Gault (CG)-based estimated glomerular filtration rates (eGFRs) performs better in the cohort setting for predicting moderate/advanced chronic kidney disease (CKD) or end-stage renal disease (ESRD).","author_count":10,"contributors":["Mocroft, A","Nielsen, Lene Ryom","Reiss, P","Furrer, H","D'Arminio Monforte, A","Gatell, J","de Wit, S","Beniowski, M","Lundgren, Jens","Kirk, Ole"],"cuid":["S01-000.00-468442"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","OECD"],"corpau":["EuroSIDA in EuroCoord"],"country":["United Kingdom"],"glorg":["All Global Affiliations","University College London"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"a comparison of estimated glomerular filtration rates using cockcroft gault and the chronic kidney disease epidemiology collaboration estimating equations in hiv infection","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1111/hiv.12095","version":"Published Version"},"id":"S01-000.00-468442","identifier":[{"id":"24118916","type":"pmid"},{"id":"84893728015","type":"scopus"},{"id":"PMC4228765","type":"pmcid"}],"ids":["ku-7d40cd8e-5089-46fe-b410-462e81c6a980"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-321767D3DCAE657171C336763FF99C5D"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/189347764/Mocroft_et_al_2014_HIV_Medicine.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1111/hiv.12095","version":"Pu