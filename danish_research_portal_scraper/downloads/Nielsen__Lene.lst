a Nainan","rank":38,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christian","key":"gluudchristianpau","last":"Gluud","name":"Gluud, Christian","rank":39,"rolecode":"pau"},{"affno":"3","first":"Theis","key":"langetheispau","last":"Lange","locid":"e4664578-01fc-4a93-8efd-1dbffb72cdd6","name":"Lange, Theis","orcid":"0000-0001-6807-8347","rank":40,"rolecode":"pau"},{"affno":"3 1 2","first":"Anders","key":"perneranderspau","last":"Perner","locid":"8a389541-d529-4ee3-8364-66bfc85f77c9","name":"Perner, Anders","rank":41,"rolecode":"pau"}],"pmid":["32779728"],"pub":{"doi":"10.1111/aas.13673","issn":["00015172"],"issue":"9","journal":"Acta Anaesthesiologica Scandinavica","pages":"1365-1375","publisher":"Blackwell Munksgaard","status":"p","title":"Acta Anaesthesiologica Scandinavica","volume":"64"},"review":"Peer Reviewed","scoID":["2-s2.0-85088805682"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Region Zealand","Undetermined","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-506735a6-0d41-4e1c-9839-b2aa4c38085c","au-dff80599-eb40-4a79-a376-7558114ac69d","ku-f90ea239-809a-41e7-bbcb-b7cb217224f1","sdu-b9a84bc8-4dc8-4629-b0e0-e82e3acd1571"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Low-dose hydrocortisone in patients with COVID-19 and severe hypoxia (COVID STEROID) trial—Protocol and statistical analysis plan","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-094.45-003929","year":"2020","yearsub":"2020"}
{"abstract":"Background: The long-term prognosis following herpes simplex virus (HSV) central nervous system (CNS) infection is still debated. Patients and Methods: We examined outcomes in all Danish residents who, during 2000-2016, tested PCR positive for HSV-1 (n=208) or HSV-2 (n=283) in the cerebrospinal fluid, compared to comparison cohorts from the general population (n=2080 and n=2830). Results: One-year mortality was increased among HSV-1 patients (difference 19.3%; 95% CI: 13.6% to 25.0%) and HSV-2 patients (difference 5.3%; 95% CI: 2.5% to 8.1%), but thereafter mortality was not increased. After exclusion of persons diagnosed with cancer prior to study inclusion, one-year mortality difference for HSV-2 patients was 1.7% (-0.1% to 3.5%). After five years, HSV-1 patients had lower employment (difference -19.8%; 95% CI: -34.7% to -4.8%) and higher disability pension rates (difference 22.2%; 95% CI: 8.4% to 36.0%) than the comparison cohort, but similar number of inpatient days, outpatient visits, and sick leave. HSV-2 patients had employment and disability pension rates comparable to the comparison cohort, but more inpatient days (difference 1.5/year; 95% CI: -0.2 to 3.2), outpatient visits (difference 1.3/year; 95% CI: 0.3 to 3.2), and sick leave days (difference 9.1/year; 95% CI: 7.9 to 10.4). Conclusion: HSV-1 and HSV-2 CNS infections differ substantially with respect to prognosis. HSV-1 CNS infection is followed by increased short-term mortality and long-term risk of disability. HSV-2 CNS infection has no substantial impact on mortality or working capability but is associated with increased morbidity.","author_count":18,"contributors":["Hansen, Ann-Brit E","Vestergaard, Hanne T","Dessau, Ram B","Bodilsen, Jacob","Andersen, Nanna S","Omland, Lars H","Christiansen, Claus B","Ellermann-Eriksen, Svend","Nielsen, Lene","Benfield, Thomas","Sørensen, Henrik T","Andersen, Christian Ø","Lebech, Anne-Mette","Obel, Niels"],"cuid":["S04-098.76-011764"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"continent":["America, North","OECD"],"corresponding_author":["Hansen, Ann Brit E."],"country":["United States"],"glorg":["All Global Affiliations","Pfizer"],"keyword":["Cohort study","Herpes simplex virus encephalitis","Herpes simplex virus meningitis","Outcome","Prognosis"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"long term survival morbidity social functioning and risk of disability in patients with a herpes simplex virus type 000000000001 or type 000000000002 central nervous system infection denmark 000000002000 000000002016","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.2147/CLEP.S256838","version":"Published Version"},"funding_acknowledgement":["The study was supported by the Danish Council for Independent Research, grant number: [6110-00173B]. The sponsor had no influence on the preparation, design, analysis, or reporting of this study. RBD reports personal fees from Roche Diagnostics, outside the submitted work. A-ML reports personal fees from GSK, non-financial support from Gilead, outside the submitted work. HTS was supported by the PROCRIN program and also reports that The Department of Clinical Epidemiology, Aarhus University Hospital, receives funding for other studies from companies in the form of research grants to (and administered by) Aarhus University. None of these studies have any relation to the present study. The authors report no other conflicts of interest in this work."],"id":"S04-098.76-011764","identifier":[{"id":"32765109","type":"pmid"},{"id":"PMC7371560","type":"pmcid"},{"id":"85088413484","type":"scopus"}],"ids":["aau-f6260121-405e-491d-b231-4f7ddb95fc36","au-b25f61bb-7340-45c2-963e-a38065da3755","ku-51c545df-c56d-47a3-8be8-1e54b315963b","sdu-83cb499a-a824-44e9-a9e2-8ae3f96c93a0"],"keyword":["Cohort study","Herpes simplex virus encephalitis","Herpes simplex virus meningitis","Outcome","Prognosis"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-7-ED95D202A800E1A2208EADC30704D06F"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://curis.ku.dk/ws/files/251996008/clep_256838_long_term_survival_morbidity_social_functioning_and_risk_o.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/172210566/clep_256838_long_term_survival_morbidity_social_functioning_and_risk_o.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC 3.0","type":"loc","url":"https://vbn.aau.dk/ws/files/338354008/Hansen_et_al._2020_Long_Term_Survival_Morbidity_Social_Functioning.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.2147/CLEP.S256838","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Departme