0aa-a07c-92d484794383","sdu-778d8da1-a450-4358-94d7-9c44f5389d0a"],"src":["AAU Aalborg University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Functional examination of MLH1, MSH2, and MSH6 intronic mutations identified in Danish colorectal cancer patients","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-091.37-011778","year":"2013","yearsub":"2013"}
{"abstract":"Background: Although management of twin deliveries has been a topic of discussion for decades, a consensus on how to deliver twins is lacking. The objective of this study was to examine short-term neonatal outcome of the second twin delivered by cesarean section after vaginal delivery of the first-born twin (combined delivery) and to identify predictors of combined delivery. Methods: This study was a 3-year, population-based, retrospective cohort investigation of 1,254 twin births in Denmark. The twin births were divided into three groups: vaginal deliveries, planned cesarean deliveries, and combined deliveries. Data were extracted from medical records, a fetal medicine software program (Astraia), and the National Birth Registry. Short-term poor neonatal outcome was measured as a 5-minute Apgar score ≤ 7, umbilical cord pH ≤ 7.10, and admission to neonatal intensive care unit for more than 3 days. Results: Vertex-nonvertex fetal presentations were more prevalent in combined deliveries than vaginal deliveries (OR 4.4, 2.5-7.8). Nonvertex second twins born by combined delivery had a higher risk of Apgar score ≤ 7 and umbilical cord pH ≤ 7.10 compared with vaginal delivery, unadjusted OR 6.2 (2.1-18), and unadjusted OR 3.9 (1.6-9.5). Prenatal ultrasound scans were evaluated in combined deliveries, of which 48 percent were vertex-vertex at the last ultrasound scan in pregnancy (mean gestational age 34 + 0) and 37 percent were vertex-vertex at birth. Conclusions: Vertex-nonvertex presenting twins have an increased risk of combined delivery. Combined deliveries are associated with increased neonatal morbidity for the second twin.","author_count":18,"contributors":["Engelbrechtsen, Line","Nielsen, Elise Hoffmann","Perin, Trine","Oldenburg, Anna","Tabor, Ann","Skibsted, Lillian","Bødker, Birgit","Ersbak, Vibeke","Holmskov, Anni","JØorgensen, Finn Stener","Larsen, Helle","Larsen, Torben","Laursen, Lone","Mogensen, Helle","Petersen, Olav Bjørn","Sperling, Lene","Stornes, Inger","Zingenberg, Helle"],"cuid":["S04-094.18-007726"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"corpau":["Danish Fetal Medicine Study Group"],"corresponding_author":["Engelbrechtsen, Line"],"keyword":["Adult","Apgar Score","Cesarean Section","Cohort Studies","Combined delivery","Denmark","Female","Fetal presentation","Humans","Hydrogen Ion Concentration","Infant Newborn","Labor Presentation","Neonatal outcome","Pregnancy","Pregnancy Twin","Registries","Retrospective Studies","Twin delivery","Umbilical Cord"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR","DI-HO-ZEA"],"OT":["2nd Department of Obstetrics and Gynecology"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU","DI-U-UND"]},"level3all":["DI-HO-CDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU","DI-U-UND"]},"review":"pr","rtype":["clu"],"sorti":"cesarean section for the second twin a population based study of occurrence and outcome","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1111/birt.12023","version":"Other Version"},"id":"S04-094.18-007726","identifier":[{"id":"24635419","type":"pmid"},{"id":"84874982539","type":"scopus"}],"ids":["aau-9f718ac6-867b-4dc5-8ad5-d90e2d4d5a40","au-4117ff1f-7c5a-4799-aa41-3917441f34e5","ku-df2bc283-c21c-4322-b6d4-a56cb3bce88b","sdu-7a68ba11-1803-4fcd-afd0-c9eea19b97c5"],"keyword":["Adult","Apgar Score","Cesarean Section","Cohort Studies","Combined delivery","Denmark","Female","Fetal presentation","Humans","Hydrogen-Ion Concentration","Infant, Newborn","Labor Presentation","Neonatal outcome","Pregnancy","Pregnancy, Twin","Registries","Retrospective Studies","Twin delivery","Umbilical Cord"],"lang":"English","level"