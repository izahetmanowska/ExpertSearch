{"author_count":6,"contributors":["Nielsen, Helena Breth","Sejbæk, Camilla Sandal","Dreyer, Lene","Madsen, Ida E. H.","Meulengracht Flachs, Esben","Hougaard, Karin Sørig"],"cuid":["S01-000.00-705032"],"filters":{"added":"2024-02","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-WORK"],"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-GV-WORK","DI-HO-CAP","DI-U-AAU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"study protocol for analyses of the association between psychosocial work environment exposures and risk of autoimmune rheumatic diseases a study protocol from the eu funded eximious project","src":["aau"],"src-code":["DI-U-AAU"],"type":"doi","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.6084/m9.figshare.24745563.v1.","version":"Published Version"},"id":"S01-000.00-705032","ids":["aau-384a7318-df15-49d2-9cd0-105ac2d16fc7"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-A45D9BD5BCB8704F5F2FC0A1EFA4BC9C"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.6084/m9.figshare.24745563.v1.","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/619763691/Nielsen_et_al._2023_._Study_protocol_for_analyses_of_the_association_between_psychosocial_work_environment_exposures_and_risk_of_autoimmune_rheumatic_diseases._A_study_protocol_from_the_EU-funded_EXIMIOUS_project.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"nfa national research centre for the working environment","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-WORK","l3nn":"NFA National Research Centre for the Working Environme