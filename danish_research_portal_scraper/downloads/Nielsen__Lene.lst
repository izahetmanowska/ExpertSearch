{"author_count":2,"contributors":["Nielsen, Keld Bach","Sørensen, Lene Lerbech"],"cuid":["S01-000.00-660140"],"filters":{"added":"2023-08","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Sygeplejerskeuddannelsen"],"level":"sci","oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-UC"],"level3":{"UC":["DI-UC-ALL","DI-UC-VIA"]},"level3all":["DI-UC-VIA"]},"review":"nr","rtype":["clu"],"sorti":"vekselvirkninger og samspil mellem teoretiske og kliniske studier i sygeplejerskeuddannelsen de studerendes læringsudbytte og kontekstens betydning for læreprocessen","src":["via"],"src-code":["DI-UC-VIA"],"type":"db","type-grp":["all","pub"]},"id":"S01-000.00-660140","ids":["via-b932772b-8b29-43d1-8900-847a15a8de86"],"keyword":["sygeplejerskeuddannelsen"],"lang":"Danish","level":"Scientific","noi":["Local-1-1-511DF114A00AA6E31B9729801FA0111A"],"org":[{"affno":"1","key":"via university college","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-VIA","l3nl":"VIA University College","l3nn":"VIA University College","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"VIA University College","namevar":["VIA, Uddannelser, Sygeplejerskeuddannelsen, Sygeplejerskeuddannelsen Aarhus N"],"nora_code":"DI-UC-VIA","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Keld Bach","key":"nielsenpau","last":"Nielsen","locid":"6f0cfa87-1ff8-4040-9dff-e3bbd2a9794c","name":"Nielsen, Keld Bach","orcid":"0000-0001-9508-9076","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lene Lerbech","key":"sørensenpau","last":"Sørensen","locid":"f2d896fa-93a2-4959-96a8-e2341e5d177f","name":"Sørensen, Lene Lerbech","rank":2,"rolecode":"pau"}],"pub":{"isbn":["9788793114333"],"pages":"16","place":"Aarhus","publisher":"Systime","status":"p","volume":"1"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All University Colleges","DI-ALL","DI-UC","DI-UC-ALL","University Colleges","VIA University College"],"PST":["Published"]},"sid":["via-b932772b-8b29-43d1-8900-847a15a8de86"],"src":["VIA University College"],"title":"Vekselvirkninger og samspil -mellem teoretiske og kliniske studier i sygeplejerskeuddannelsen : De studerendes læringsudbytte og kontekstens betydning for læreprocessen","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-660140","year":"2014","yearsub":"2014"}
{"abstract":"The aims were to investigate (1) if temporomandibular disorders (TMD) patients with temporomandibular joint (TMJ) pain had different conditioned pain modulation (CPM) compared with healthy subjects and, (2) if clinical pain characteristics influenced CPM. Sixteen TMD pain patients and 16 age-matched healthy subjects were participated. A mechanical conditioning stimulus (CS) was applied to pericranial muscles provoking a pain intensity of 5/10 on a visual analogue scale. Pressure pain thresholds (PPT) and pressure pain tolerance thresholds (PPTol) were assessed at masseter, forearm and painful TMJ (only PPT) before, during, and 20 min after CS. Data were analyzed with ANOVAs. The correlations between CPM effect and ratings of TMD pain intensity on a numerical rating scale (NRS) or the pain duration were calculated (correlation coefficient; R). The relative PPT and PPTol increases (mean for the three assessment sites) during CS were significantly higher than baseline in healthy subjects (43.0 ± 3.6, 33.0 ± 4.0 %; P < 0.001, P < 0.001) but not in the TMD pain patients (4.9 ± 2.7, -1.4 ± 4.1 %; P = 0.492, P = 1.000) with significant differences between groups (P < 0.001). In the patients, the relative PPT changes during CS were not significantly higher than baseline at TMJ (5.3 ± 3.8 %, P = 0.981) and masseter (-2.8 ± 4.8 %, P = 1.000) but significantly higher at forearm (12.3 ± 4.7 %, P = 0.039). No correlation was detected between TMD pain intensity and CPM effect (R = -0.261; P = 0.337) or between pain duration and CPM effect (R = -0.423; P = 0.103) at painful TMJ. These findings indicate that CPM is impaired in TMD pain patients especially at sites with chronic pain but not at pain-free sites and that the clinical pain characteristics do not influence CPM.","author_count":8,"contributors":["Oono, Yuka","Wang, Kelun","Baad-Hansen, Lene","Futarmal, Simple","Kohase, Hikaru","Svensson, Peter","Arendt-Nielsen, Lars"],"cuid":["S02-097.00-007594"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Asia, East","OECD"],"country":["Japan"],"glorg":["All Global Affiliations","Tokyo Medical University"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"conditioned pain modulation in temporomandibular disorders tmd pain patients","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s00221-014-3997-7","version":"Other Version"},"id":"S02-097.00-007594","identifier":[{"id":"84912015399","type":"scopus"},{"id":"WOS:000342426200009","type":"wos"},{"id":"24897946","type":"pmid"}],"ids":["aau-9c73f4ab-72e5-4de1-942c-9c36522e0e12","au-57bc9747-b72e-48df-86ce-9a2394a2cc61"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-0FC5720D498D22B4D31495ECD351D11F"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s00221-014-3997-7","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Center for Sensory-Motor Interaction"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Dentistry and Oral Health, Department of Dentistry and Oral Health - Section for Orofacial Pain and Jaw Function"],"nora_code":"DI-U-AU","used":1},{"affno":"3","country":"jp","key":"tokyo medical university","loc":["Japan","Asia, East","OECD"],"name":"Tokyo Medical University","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Yuka","key":"oonopau","last":"Oono","locid":"f02e0279-7c23-4e3f-801a-6a0afeb4ef40","name":"Oono, Yuka","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kelun","key":"wangpau","last":"Wang","locid":"e6b1668a-d3ea-45f4-be10-2584e9962254","name":"Wang, Kelun","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Lene","key":"baadhansenpau","last":"Baad-Hansen","locid":"6938b236-4958-4da7-bbeb-dccb0abc973c","name":"Baad-Hansen, Lene","orcid":"0000-0002-2399-7910","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Simple F.","key":"kotharipau","last":"Kothari","locid":"1df588d0-1708-42c9-96e6-5dda22803afc","name":"Kothari, Simple F.","orcid":"0000-0001-8043-2927","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Simple","key":"futarmalpau","last":"Futarmal","name":"Futarmal, Simple","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Hikaru","key":"kohasepau","last":"Kohase","name":"Kohase, Hikaru","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Peter","key":"svenssonpau","last":"Svensson","locid":"163ec423-3f89-45a0-8cd8-81455aa6a507","name":"Svensson, Peter","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lars","key":"arendtnielsenpau","last":"Arendt-Nielsen","locid":"1794f9ec-22f1-47af-96c1-88c23c3b06a2","name":"Arendt-Nielsen, Lars","orcid":"0000-0003-0892-1579","rank":7,"rolecode":"pau"}],"pmid":["24897946"],"pub":{"doi":"10.1007/s00221-014-3997-7","issn":["00144819","14321106"],"issn_org":["00144819"],"issue":"10","journal":"Experimental Brain Research","pages":"3111-3119","publisher":"Springer Science and Business Media Deutschland GmbH","status":"p","title":"Experimental Brain Research","volume":"232"},"review":"Peer Reviewed","scoID":["2-s2.0-84912015399"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-9c73f4ab-72e5-4de1-942c-9c36522e0e12","au-57bc9747-b72e-48df-86ce-9a2394a2cc61"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Conditioned pain modulation in temporomandibular disorders (TMD) pain patients","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-097.00-007594","year":"2014","yearsub":"2014"}
{"abstract":"BACKGROUND: With the advent of effective antiretroviral treatment, the life expectancy for people with HIV is now approaching that seen in the general population. Consequently, the relative importance of other traditionally non-AIDS-related morbidities has increased. We investigated trends over time in all-cause mortality and for specific causes of death in people with HIV from 1999 to 2011. METHODS: Individuals from the Data collection on Adverse events of anti-HIV Drugs (D:A:D) study were followed up from March, 1999, until death, loss to follow-up, or Feb 1, 2011, whichever occurred first. The D:A:D study is a collaboration of 11 cohort studies following HIV-1-positive individuals receiving care at 212 clinics in Europe, USA, and Australia. All fatal events were centrally validated at the D:A:D coordinating centre using coding causes of death in HIV (CoDe) methodology. We calculated relative rates using Poisson regression. FINDINGS: 3909 of the 49,731 D:A:D study participants died during the 308,719 person-years of follow-up (crude incidence mortality rate, 12.7 per 1000 person-years [95% CI 12.3-13.1]). Leading underlying causes were: AIDS-related (1123 [29%] deaths), non-AIDS-defining cancers (590 [15%] deaths), liver disease (515 [13%] deaths), and cardiovascular disease (436 [11%] deaths). Rates of all-cause death per 1000 person-years decreased from 17.5 in 1999-2000 to 9.1 in 2009-11; we saw similar decreases in death rates per 1000 person-years over the same period for AIDS-related deaths (5.9 to 2.0), deaths from liver disease (2.7 to 0.9), and cardiovascular disease deaths (1.8 to 0.9). However, non-AIDS cancers increased slightly from 1.6 per 1000 person-years in 1999-2000 to 2.1 in 2009-11 (p=0.58). After adjustment for factors that changed over time, including CD4 cell count, we detected no decreases in AIDS-related death rates (relative rate for 2009-11 vs 1999-2000: 0.92 [0.70-1.22]). However, all-cause (0.72 [0.61-0.83]), liver disease (0.48 [0.32-0.74]), and cardiovascular disease (0.33 [0.20-0.53) death rates still decreased over time. The percentage of all deaths that were AIDS-related (87/256 [34%] in 1999-2000 and 141/627 [22%] in 2009-11) and liver-related (40/256 [16%] in 1999-2000 and 64/627 [10%] in 2009-11) decreased over time, whereas non-AIDS cancers increased (24/256 [9%] in 1999-2000 to 142/627 [23%] in 2009-11). INTERPRETATION: Recent reductions in rates of AIDS-related deaths are linked with continued improvement in CD4 cell count. We hypothesise that the substantially reduced rates of liver disease and cardiovascular disease deaths over time could be explained by improved use of non-HIV-specific preventive interventions. Non-AIDS cancer is now the leading non-AIDS cause and without any evidence of improvement. FUNDING: Oversight Committee for the Evaluation of Metabolic Complications of HAART, with representatives from academia, patient community, US Food and Drug Administration, European Medicines Agency and consortium of AbbVie, Boehringer Ingelheim, Bristol-Myers Squibb, Gilead Sciences, ViiV Healthcare, Merck, Pfizer, F Hoffmann-La Roche, and Janssen Pharmaceuticals.","author_count":17,"contributors":["Smith, Colette J","Nielsen, Lene Ryom","Weber, Rainer","Morlat, Philippe","Pradier, Christian","Reiss, Peter","Kowalska, Justyna D","de Wit, Stephane","Law, Matthew","el Sadr, Wafaa","Kirk, Ole","Friis-Møller, Nina","Monforte, Antonella d'Arminio","Phillips, Andrew N","Sabin, Caroline A","Lundgren, Jens"],"cuid":["S02-098.87-047367"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","Europe, EU","Europe, Non-EU","OECD","Oceania"],"corpau":["D:A:D Study Group"],"country":["Australia","Belgium","France","Italy","Netherlands","Poland","Switzerland","United Kingdom","United States"],"glorg":["All Global Affiliations","CHU Nice","Columbia University","Medical University of Warsaw","San Paolo Hospital","St Pierre University Hospital","University College London","University of Amsterdam","University of Bordeaux","University of New South Wales","University of Zürich"],"keyword":["Acquired Immunodeficiency Syndrome","Adult","Australia","Cause of Death","Europe","Female","HIV Infections","Humans","Male","Middle Aged","Poisson Distribution","Risk Factors","United States"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"trends in underlying causes of death in people with hiv from 000000001999 to 000000002011 d a d a multicohort collaboration","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/S0140-6736(14)60604-8","version":"Other Version"},"id":"S02-098.87-047367","identifier":[{"id":"84904417292","type":"scopus"},{"id":"25042234","type":"pmid"}],"ids":["ku-f35b08d6-b048-4e5d-be98-8644284a6cf1","sdu-4f5c4e48-9ecf-4555-8c1d-73aab3c0477c"],"keyword":["Acquired Immunodeficiency Syndrome","Adult","Australia","Cause of Death","Europe","Female","HIV Infections","Humans","Male","Middle Aged","Poisson Distribution","Risk Factors","United States"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-4F110042DBFB26226C64C79E54FBC256"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/S0140-6736(14)60604-8","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","country":"gb","key":"university college london","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"University College London","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":