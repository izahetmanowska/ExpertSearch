l health and addiction","loc":["Netherlands","Europe, EU","OECD"],"name":"Netherlands Institute of Mental Health and Addiction (Trimbos Institute)","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Iben Gammelgaard","key":"wallstroempau","last":"Wallstroem","locid":"9ae2751d-62bd-4ac8-b6a0-88bcea6bd9ce","name":"Nielsen, Iben Gammelgaard","name_org":"Wallstroem, Iben Gammelgaard","rank":1,"rolecode":"pau"},{"affno":"2 1","corresponding":null,"country":"dk","first":"Pernille","key":"pedersenpau","last":"Pedersen","locid":"d5cd4ae5-e38c-4e08-bf83-28785ce97060","name":"Pedersen, Pernille","orcid":"0009-0002-3481-2616","rank":2,"rolecode":"pau"},{"affno":"3 4 5","corresponding":null,"first":"Thomas Nordahl","key":"christensenpau","last":"Christensen","name":"Christensen, Thomas Nordahl","rank":3,"rolecode":"pau"},{"affno":"3 5","corresponding":null,"first":"Lone","key":"hellströmpau","last":"Hellström","name":"Hellström, Lone","rank":4,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"first":"Anders Bo","key":"bojesenpau","last":"Bojesen","locid":"c4eb0319-8212-4e4b-a396-e5cb4f018bae","name":"Bojesen, Anders Bo","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Elsebeth","key":"stenagerpau","last":"Stenager","locid":"eb4df80b-bc61-471f-9e05-0da8981b8f9c","name":"Stenager, Elsebeth","orcid":"0000-0002-4752-3648","rank":6,"rolecode":"pau"},{"affno":"6 5","corresponding":null,"first":"Sarah","key":"whitepau","last":"White","name":"White, Sarah","rank":7,"rolecode":"pau"},{"affno":"7 5","corresponding":null,"first":"Kim T.","key":"mueserpau","last":"Mueser","name":"Mueser, Kim T.","rank":8,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Ulrika","key":"bejerholmpau","last":"Bejerholm","name":"Bejerholm, Ulrika","rank":9,"rolecode":"pau"},{"affno":"8 5","corresponding":null,"first":"Jooske Tanna","key":"vanbusschbachpau","last":"van Busschbach","name":"van Busschbach, Jooske Tanna","rank":10,"rolecode":"pau"},{"affno":"9 5","corresponding":null,"first":"Harry","key":"michonpau","last":"Michon","name":"Michon, Harry","rank":11,"rolecode":"pau"},{"affno":"3 5","corresponding":null,"first":"Lene Falgaard","key":"eplovpau","last":"Eplov","name":"Eplov, Lene Falgaard","rank":12,"rolecode":"pau"}],"pmid":["33940948"],"pub":{"doi":"10.1176/appi.ps.202000070","issn":["10752730","15579700"],"issn_org":["10752730"],"issue":"9","journal":"Psychiatric Services","pages":"1040-1047","publisher":"American Psychiatric Association","status":"p","title":"Psychiatric Services","title_org":"Psychiatric services (Washington, D.C.)","volume":"72"},"review":"Peer Reviewed","scoID":["2-s2.0-85110377812"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-422a8975-2513-422e-879f-3b74bc2626f5","sdu-f8952f0f-2626-40ba-b2d5-6ae8c4c8f03f"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"A Systematic Review of Individual Placement and Support, Employment, and Personal and Clinical Recovery","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-093.88-017499","year":"2021","yearsub":"2021"}
{"abstract":"Patients with multiple myeloma (MM) report high symptom burden and functional disabilities resulting in impaired health-related quality of life (HRQoL). Effective evidence-based rehabilitation guidelines are needed for patients with MM to improve HRQoL. The primary aim of this study was to investigate HRQoL in patients with rehabilitation needs living their everyday life. Patients with MM in remission attended a 12-week multidisciplinary rehabilitation program including a 5-day residential course, home-based exercise and a 2-day follow-up course. The patients were referred by the treating haematologist and completed a booklet of validated HRQoL questionnaires at baseline and before arriving for the 2-day follow-up course. The proportion of participants with moderate to severe symptoms and functional problems were assessed at the two time points and multivariate logistic regression was used to investigate explaining factors of impaired HRQoL at baseline. Ninety-two patients participated with a follow-up compliance rate of 90%. Median age was 67 years and median time since diagnosis was 26 months (ranged 5 months to 15.6 years). The most frequently reported symptoms were global quality of life, role functioning, fatigue, pain, peripheral neuropathy and physical functioning. Pain and fatigue were both highly coherent with impairment in physical functioning and those two symptoms explained most HRQoL impairments. Overall, the participants reported no change in HRQoL after the 12-week rehabilitation program. The study supports the need for an evidence-based guideline for rehabilitation and palliative care to patients with MM in remission living their everyday life.","author_count":6,"contributors":["Kongsgaard Nielsen, Lene","Larsen, Rikke Faebo","Jarlbaek, Lene","Möller, Sören","Jespersen, Eva"],"cuid":["S02-094.16-029205"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Kongsgaard Nielsen, Lene"],"keyword":["Cancer","Clinical trials","Diagnosis","Disease","Exercise","Health related quality of life","INDUCED PERIPHERAL NEUROPATHY","Multiple myeloma","Population","Rehabilitation and patient reported outcomes","Response shift","Survivors","Symptoms"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR","DI-HO-ZEA"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-CDR","DI-HO-ZEA","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"health related quality of life in patients with multiple myeloma participating in a multidisciplinary rehabilitation program","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/196822734/Revised_REHPA_HRQoL_manuskript_v7_wE_for_REHPA.pdf","version":"Authors Final Version"},"id":"S02-094.16-029205","identifier":[{"id":"000605515400003","type":"wos"},{"id":"85099046793","type":"scopus"},{"id":"33409622","type":"pmid"}],"ids":["au-e4477552-0b62-44f5-b754-0c5dbd47dc53","sdu-c2dff7a2-835c-4116-9cb8-56aef374dd19"],"keyword":["CANCER","CLINICAL-TRIALS","DIAGNOSIS","DISEASE","EXERCISE","Health-related quality of life","INDUCED PERIPHERAL NEUROPATHY","Multiple myeloma","POPULATION","RESPONSE SHIFT","Rehabilitation and patient-reported outcomes","SURVIVORS","SYMPTOMS"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-85FDE5158A13DFB59C634A73C2248D7E"],"oa_link":[{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/196822734/Revised_REHPA_HRQoL_manuskript_v7_wE_for_REHPA.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Cardiology, HEM","Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Medicinsk afdeling, Viborg"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["University of Southern Denmark (SDU)"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Regionshospitalet Viborg"],"nora_code":"DI-HO-CDR","used":1},{"affno":"4","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-ZEA","l3nl":"Region Zealand","l3nn":"Region Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Zealand University Hospital"],"nora_code":"DI-HO-ZEA","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"Lene Kongsgaard","key":"nielsenpau","last":"Nielsen","locid":"897c29d3-45a2-4178-81b1-b0ba61db5a25","name":"Kongsgaard Nielsen, Lene","name_org":"Nielsen, Lene Kongsgaard","orcid":"0000-0003-2083-3870","rank":1,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Lene","key":"kongsgaardnielsenpau","last":"Kongsgaard Nielsen","locid":"621d166f-6298-48ed-9f2d-d8d52bb40446","name":"Kongsgaard Nielsen, Lene","orcid":"0000-0003-2083-3870","rank":1,"rolecode":"pau"},{"affno":"2 4","corresponding":null,"first":"Rikke Faebo","key":"larsenpau","last":"Larsen","locid":"bf1f2354-216f-47ed-ac3a-92021a7f2e24","name":"Larsen, Rikke Faebo","orcid":"0000-0003-3444-2774","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Lene","key":"jarlbækpau","last":"Jarlbæk","locid":"4a7b25fd-395e-46ed-a8e5-71ffa03e9966","name":"Jarlbæk, Lene","orcid":"0000-0001-8702-6788","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Sören","key":"möllerpau","last":"Möller","locid":"905018dc-c6c4-4a79-b50d-d0c08618e77a","name":"Möller, Sören","orcid":"0000-0003-0858-4269","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Eva","key":"jespersenpau","last":"Jespersen","locid":"04ee9afd-4860-4af1-81ec-31bbbc4c1274","name":"Jespersen, Eva","orcid":"0000-0002-8942-4816","rank":5,"rolecode":"pau"}],"pmid":["33409622"],"pub":{"doi":"10.1007/s00277-020-04356-0","issn":["09395555","09458077"],"issn_org":["09395555"],"issue":"9","journal":"Annals of Hematology","pages":"2311-2323","publisher":"Springer Science and Business Media Deutschland GmbH","status":"p","title":"Annals of Hematology","volume":"100"},"review":"Peer Reviewed","scoID":["2-s2.0-85099046793"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region Zealand","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-e4477552-0b62-44f5-b754-0c5dbd47dc53","sdu-c2dff7a2-835c-4116-9cb8-56aef374dd19"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Health-related quality of life in patients with multiple myeloma participating in a multidisciplinary rehabilitation program","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-094.16-029205","year":"2021","yearsub":"2021"}
{"abstract":"Purpose: To investigate the effect of Individual Placement and Support (IPS) according to diagnoses of schizophrenia, bipolar disorder, major depression, substance use disorders, or forensic psychiatric conditions. Methods: A systematic search of the literature was conducted in June 2017 and repeated in December 2020. The systematic review included 13 studies. Analyses of pooled original data were based on the six studies providing data (n = 1594). No studies on forensic psychiatric conditions were eligible. Hours and weeks worked were analyzed using linear regression. Employment, and time to employment was analyzed using logistic regression, and cox-regression, respectively. Results: The effects on hours and weeks in employment after 18 months were comparable for participants with schizophrenia, and bipolar disorder but only statistically significant for participants with schizophrenia compared to services as usual (SAU) (EMD 109.1 h (95% CI 60.5–157.7), 6.1 weeks (95% CI 3.9–8.4)). The effect was also significant for participants with any drug use disorder (121.2 h (95% CI 23.6–218.7), 6.8 weeks (95% CI 1.8–11.8)). Participants with schizophrenia, bipolar disorder, and any drug use disorder had higher odds of being competitively employed (OR 2.1 (95% CI 1.6–2.7); 2.4 (95% CI 1.3–4.4); 3.0 (95% CI 1.5–5.8)) and returned to work faster than SAU (HR 2.1 (95% CI 1.6–2.6); 1.8 (95% CI 1.1–3.1); 3.0 (95% CI 1.6–5.7)). No statistically significant effects were found regarding depression. Conclusions: IPS was effective regarding schizophrenia, bipolar disorder, and substance use disorder; however, the effect on hours, and weeks worked was not statistically significant regarding bipolar disorder. For people with depression the impact of IPS remains inconclusive. Non-significant results may be due to lack of power. Trial Registration: PROSPERO protocol nr. CRD42017060524","author_count":13,"contributors":["Hellström, Lone","Pedersen, Pernille","Christensen, Thomas Nordahl","Wallstroem, Iben Gammelgaard","Bojesen, Anders Bo","Stenager, Elsebeth","Bejerholm, Ulrika","van Busschbach, Jooske","Michon, Harry","Mueser, Kim T.","Reme, Silje Endresen","White, Sarah","Eplov, Lene Falgaard"],"cuid":["S02-096.25-014558"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","Europe, EU","Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Hellström, Lone"],"country":["Netherlands","Norway","Sweden","United Kingdom","United States"],"glorg":["All Global Affiliations","Boston University","Lund University","Netherlands Institute of Mental Health and Addiction (Trimbos Institute)","St. George's University of London","Trimbos Institute","University Medical Center Groningen","University of Groningen","University of Oslo","Windesheim University of Applied Sciences"],"keyword":["Depressive Disorder","Employment Supported","Humans","Mental Disorders","Rehabilitation Vocational","Schizophrenia","Substance Related Disorders","Supported employment","Vocational rehabilitation"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"vocational outcomes of the individual placement and support model in subgroups of diagnoses substance abuse and forensic conditions a systematic review and analysis of pooled original data","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85102180381","version":"Other Version"},"id":"S02-096.25-014558","identifier":[{"id":"33661452","type":"pmid"},{"id":"85102180381","type":"scopus"}],"ids":["au-1b0dbedd-b2bc-4a1d-8b7a-b34b147a5738","sdu-854