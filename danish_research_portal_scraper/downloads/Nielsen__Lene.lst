{"author_count":9,"contributors":["Pedersen, Sedsel Kristine Stage","Thastum, Mille","Næss-Schmidt, Erhard Trillingsgaard","Odgaard, Lene","Pedersen, Asger Roer","Pallesen, Hanne","Nielsen, Jørgen Feldbæk","Silverberg, Noah D.","Brunner, Iris"],"cuid":["S01-000.00-693417"],"event":{"end":"2022-12-17","place":"Vienna, at","start":"2022-12-13","title":"12th World Conference for Neurorehabilitation","year":"2022"},"filters":{"added":"2023-11","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","University of California at Berkeley"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"nr","rtype":["clu"],"sorti":"get going after concussion lite gain lite a study protocol for a randomized controlled trial of an early intervention to reduce impairing post concussion mild to moderate symptoms in adults","src":["au"],"src-code":["DI-U-AU"],"type":"dco","type-grp":["all","pub"]},"id":"S01-000.00-693417","ids":["au-273fc693-70f2-418e-8c64-391891bc2d0d"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-872EABF594840E4612860557466E08BE"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Hammel Neurocenter, Universitetsklinik for Neurorehabilitering"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"us","key":"university of california at berkeley","loc":["United States","America, North","OECD"],"name":"University of California at Berkeley","used":1}],"person":[{"affno":"1","corresponding":null,"co