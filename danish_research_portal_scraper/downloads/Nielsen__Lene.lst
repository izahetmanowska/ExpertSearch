},{"affno":"1","corresponding":null,"first":"Lene","key":"seibækpau","last":"Seibæk","locid":"2bf95667-24b9-444b-b3e1-a62965aac67a","name":"Seibæk, Lene","orcid":"0000-0002-2396-8669","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-51fb9e8b-c4cd-4fda-aada-ea724198d5ca"],"src":["AU Aarhus University"],"title":"Patientuddannelse i livsstilsrelaterede sygdomme i Grønland – et ph.d.-projekt","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-176111","year":"2022","yearsub":"2022"}
{"abstract":"Introduction: Peritoneal metastases (PM) originating from colorectal cancer (CRC) and pseudomyxoma peritonei (PMP) can be treated with cytoreductive surgery (CRS) and hyperthermic intraperitoneal chemotherapy (HIPEC). Certain sites in the peritoneal cavity are prone to contain PM and are, therefore, routinely resected. The aim of this study is to investigate the frequency of disease in CRS specimens routinely resected. Secondly, to investigate if the risk of finding PM in routinely resected specimen is associated with involvement of anatomic related peritoneal areas. Materials and methods: This study investigated 433 patients diagnosed with PMP (n = 119) or PM from CRC (n = 314) and operated with CRS + HIPEC between June 2006 and November 2020 at a national center. Baseline data were prospectively registered. Pathology reports were reviewed for the presence of metastases in the routinely resected umbilicus, ligamentum teres hepatis, ovaries and greater omentum. Tumor extent was estimated using the Dutch region count. Results: PM was found in 14.7% of umbilical resections, in 17.4% of the resected ligamentum teres hepatis, in 48.2% of the resected ovaries and in 49.5% of the greater omentum specimens. We found an association between macroscopic disease involvement of the nearest region and risk of PM found in the related resections. Seven of 31 women with no macroscopically visible disease in the pelvis had PM diagnosed in the resected ovaries. Conclusions: A substantial proportion of routine resections held histologic verified PM. Our results may advocate for a routinely performed resection of the umbilicus, ligamentum teres hepatis, ovaries and greater omentum.","author_count":6,"contributors":["Nors, Jesper","Iversen, Lene Hjerrild","Nielsen, Karsten","Sørensen, Mette Møller","Verwaal, Vic","Funder, Jonas Amstrup"],"cuid":["S01-000.00-210956"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Nors, Jesper"],"keyword":["Colorectal Neoplasms pathology","Colorectal cancer","Combined Modality Therapy","Cytoreduction Surgical Procedures methods","Cytoreductive surgery","Female","HIPEC","Humans","Hyperthermia Induced methods","Hyperthermic Intraperitoneal Chemotherapy","Peritoneal Neoplasms secondary","Peritoneal metastases","Pseudomyxoma peritonei","Treatment Outcome"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"peritoneal metastases found in routinely resected specimens after cytoreductive surgery and heated intraperitoneal chemotherapy","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.ejso.2021.12.026","version":"Published Version"},"id":"S01-000.00-210956","identifier":[{"id":"35012833","type":"pmid"},{"id":"85122540852","type":"scopus"}],"ids":["au-8f13215c-6245-4d77-a734-fb4156d7cfad"],"keyword":["Colorectal Neoplasms/pathology","Colorectal cancer","Combined Modality Therapy","Cytoreduction Surgical Procedures/methods","Cytoreductive surgery","Female","HIPEC","Humans","Hyperthermia, Induced/methods","Hyperthermic Intraperitoneal Chemotherapy","Peritoneal Neoplasms/secondary","Peritoneal metastases","Peritoneum/pathology","Pseudomyxoma Peritonei/complications","Pseudomyxoma peritonei","Routine resections","Treatment outcome"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-994842481C7511FADE4575E62AF94A4B"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1016/j.ejso.2021.12.026","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://pure.au.dk/ws/files/331188144/1_s2.0_S0748798321009963_main.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Surgical Gastroenterology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Jesper Berg","key":"norspau","last":"Nors","locid":"041200bc-5fd9-427e-988b-6e4424a4fa6d","name":"Nors, Jesper","name_org":"Nors, Jesper Berg","orcid":"0000-0002-9104-7263","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lene Hjerrild","key":"iversenpau","last":"Iversen","locid":"4d8ada79-98c2-49eb-ac2f-472b41434eff","name":"Iversen, Lene Hjerrild","orcid":"0000-0002-2336-2923","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Karsten","key":"nielsenpau","last":"Nielsen","locid":"03349e44-ef16-4073-a028-38fd8273767d","name":"Nielsen, Karsten","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mette Møller","key":"sørensenpau","last":"Sørensen","locid":"447f876a-1fe6-4695-ac7b-36da85ce31ea","name":"Sørensen, Mette Møller","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Vic","key":"verwaalpau","last":"Verwaal","locid":"a1a79a7a-573a-4cc9-9a27-3b935561b73c","name":"Verwaal, Vic","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jonas Amstrup","key":"funderpau","last":"Funder","locid":"f7ae2db6-a9b1-43c4-94a2-39f78f9202d1","name":"Funder, Jonas Amstrup","rank":6,"rolecode":"pau"}],"pmid":["35012833"],"pub":{"doi":"10.1016/j.ejso.2021.12.026","issn":["07487983","15322157"],"issn_org":["07487983"],"issue":"4","journal":"European Journal of Surgical Oncology","pages":"795-802","publisher":"Elsevier","status":"p","title":"European Journal of Surgical Oncology","volume":"48"},"review":"Peer Reviewed","scoID":["2-s2.0-85122540852"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-8f13215c-6245-4d77-a734-fb4156d7cfad"],"src":["AU Aarhus University"],"title":"Peritoneal metastases found in routinely resected specimens after cytoreductive surgery and heated intraperitoneal chemotherapy","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-210956","year":"2022","yearsub":"2022"}
{"abstract":"Objectives: To evaluate the feasibility, safety, and healing response of a magnesium-based bioresorbable scaffold (BRS) in the treatment of simple bifurcation lesions using the single stent provisional technique. Background: BRS may hold potential advantages in the treatment of coronary bifurcation lesions, however low radial strength and expansion capacity has been an issue with polymer-based scaffolds. The magnesium BRS may prove suitable for bifurcation treatment as its mechanical properties are closer to those of permanent metallic drug-eluting stents. Methods: The study was a proof-of-concept study with planned inclusion of 20 patients with stable angina pectoris and a bifurcation lesion involving a large side branch (SB) > 2.5 mm with less than 50% diameter stenosis. Procedure and healing response were evaluated by optical coherence tomography (OCT). The main endpoints were a composite clinical safety endpoint and an OCT healing index at 1 month (range: 0–98). Results: Eleven patients were included in the study. The study was prematurely terminated due to scaffold fractures and embolization of scaffold fragments in three cases requiring bailout stenting with drug-eluting stents. One patient underwent bypass surgery at 3 months due to stenosis proximal to the study segment. All SB were patent for 1 month. One-month OCT evaluation showed strut coverage of 96.9% and no malapposition. Scaffold fractures and uncovered jailing struts resulted in a less favorable mean OCT healing index score of 10.4 ± 9.0. Conclusions: Implanting a magnesium scaffold by the provisional technique in nontrue bifurcation lesions was associated with scaffold fracture, embolization of scaffold fragments, and a high need for bailout stenting.","author_count":6,"contributors":["Barkholt, Trine Ørhøj","Neghabat, Omeed","Holck, Emil Nielsen","Andreasen, Lene Nyhus","Christiansen, Evald Høj","Holm, Niels Ramsing"],"cuid":["S01-000.00-259153"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Barkholt, Trine Ørhøj"],"keyword":["Bioresorbable scaffolds","Optical coherence tomography","bifurcation lesions","strut fracture"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"bioresorbable magnesium scaffold in the treatment of simple coronary bifurcation lesions the bifsorb pilot ii study","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1002/ccd.30051","version":"Published Version"},"id":"S01-000.00-259153","identifier":[{"id":"PMC9540410","type":"pmcid"},{"id":"34967094","type":"pmid"},{"id":"000735912000001","type":"wos"},{"id":"85122145461","type":"scopus"}],"ids":["au-e3685a93-1822-402a-8d18-46bfd8dcea94"],"keyword":["bifurcation lesions","bioresorbable scaffolds","optical coherence tomography","strut fracture"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-D5E600A5BEAD48A9210D993CDECB074D"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC9540410/pdf/CCD-99-1075.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1002/ccd.30051","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - The Department of Cardiological Medicine B"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Trine","key":"ørhøjbarkholtpau","last":"Ørhøj Barkholt","locid":"b087a3fd-c19e-4270-9395-ec8d8e7d1720","name":"Barkholt, Trine Ørhøj","name_org":"Ørhøj Barkholt, Trine","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Omeed","key":"neghabatpau","last":"Neghabat","locid":"410bf782-fd48-46c1-8b07-5dc8210db0d0","name":"Neghabat, Omeed","orcid":"0000-0002-5889-0953","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Emil N","key":"holckpau","last":"Holck","locid":"8e9383af-7f88-4fa3-bbbc-35641f5cbf8e","name":"Holck, Emil Nielsen","name_org":"Holck, Emil N","orcid":"0009-0009-6697-1073","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lene N","key":"andreasenpau","last":"Andreasen","locid":"4dcde74a-8de8-4b84-b795-c9d84cfc7af7","name":"Andreasen, Lene Nyhus","name_org":"Andreasen, Lene N","orcid":"0000-0002-9891-7890","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Evald H","key":"christiansenpau","last":"Christiansen","locid":"06b04feb-3d2f-402d-b211-7ad5fd0387f1","name":"Christiansen, Evald Høj","name_org":"Christiansen, Evald H","orcid":"0000-0002-8740-4862","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Niels R","key":"holmpau","last":"Holm","locid":"5cb3cc8e-dfa4-4822-b5ec-f57049bf2b82","name":"Holm, Niels Ramsing","name_org":"Holm, Niels R","rank":6,"rolecode":"pau"}],"pmid":["34967094"],"pub":{"doi":"10.1002/ccd.30051","issn":["15221946","1522726X"],"issn_org":["15221946"],"issue":"4","journal":"Catheterization and Cardiovascular Interventions","pages":"1075-1083","publisher":"John Wiley & Sons Inc.","status":"p","title":"Catheterization and Cardiovascular Interventions","volume":"99"},"review":"Peer Reviewed","scoID":["2-s2.0-85122145461"],"search":{"DAF":["Aarhus University","All Danish Affiliations","Al