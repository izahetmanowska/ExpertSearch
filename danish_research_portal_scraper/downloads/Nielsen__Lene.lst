onnetpau","last":"Bonnet","name":"Bonnet, Fabrice","rank":23,"rolecode":"pau"},{"affno":"31 32","corresponding":null,"first":"Stephane","key":"dewitpau","last":"De Wit","name":"De Wit, Stephane","rank":24,"rolecode":"pau"},{"affno":"33","corresponding":null,"first":"Wafaa","key":"elsadrpau","last":"El-Sadr","name":"El-Sadr, Wafaa","rank":25,"rolecode":"pau"},{"affno":"1","first":"Bastian","key":"neesgaardpau","last":"Neesgaard","name":"Neesgaard, Bastian","rank":26,"rolecode":"pau"},{"affno":"1","first":"Nadine","key":"jaschinskipau","last":"Jaschinski","name":"Jaschinski, Nadine","rank":27,"rolecode":"pau"},{"affno":"1","first":"Lauren","key":"greenbergpau","last":"Greenberg","name":"Greenberg, Lauren","rank":28,"rolecode":"pau"},{"affno":"34","corresponding":null,"first":"Sean R","key":"hoseinpau","last":"Hosein","name":"Hosein, Sean R","rank":29,"rolecode":"pau"},{"affno":"35 36","corresponding":null,"first":"Joel","key":"gallantpau","last":"Gallant","name":"Gallant, Joel","rank":30,"rolecode":"pau"},{"affno":"37 38","corresponding":null,"first":"Vani","key":"vannappagaripau","last":"Vannappagari","name":"Vannappagari, Vani","rank":31,"rolecode":"pau"},{"affno":"39 40","corresponding":null,"first":"Lital","key":"youngpau","last":"Young","name":"Young, Lital","rank":32,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Caroline","key":"sabinpau","last":"Sabin","name":"Sabin, Caroline","rank":33,"rolecode":"pau"},{"affno":"1","first":"Jens","key":"lundgrenpau","last":"Lundgren","name":"Lundgren, Jens","rank":34,"rolecode":"pau"},{"affno":"1","first":"Lars","key":"peterspau","last":"Peters","name":"Peters, Lars","rank":35,"rolecode":"pau"},{"affno":"1","first":"Joanne","key":"reekiepau","last":"Reekie","name":"Reekie, Joanne","rank":36,"rolecode":"pau"}],"pmid":["38663013"],"pub":{"doi":"10.1093/cid/ciae228","issn":["10584838","15376591"],"issn_org":["10584838"],"issue":"5","journal":"Clinical Infectious Diseases","pages":"1242-1257","publisher":"Oxford University Press","status":"p","title":"Clinical Infectious Diseases","title_org":"Clinical infectious diseases : an official publication of the Infectious Diseases Society of America","volume":"79"},"review":"Peer Reviewed","scoID":["2-s2.0-85210462574"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-68a6fb71-a72f-4437-990f-a079c4162ac4","ku-359ac93e-8da2-4d66-8469-16c0fba8840d"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Trends in Mortality in People With HIV From 1999 through 2020 : A Multicohort Collaboration","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-088.57-785101","year":"2024","yearsub":"2024"}
{"abstract":"Objectives:People with HIV and extensive antiretroviral exposure may have limited/exhausted treatment options (LExTO) due to resistance, comorbidities, or antiretroviral-related toxicity. Predictors of LExTO were investigated in the RESPOND cohort.Methods:Participants on ART for at least 5 years were defined as having LExTO when switched to at least two anchor agents and one third antiretroviral (any class), a two-drug regimen of two anchor agents (excluding rilpivirine with dolutegravir/cabotegravir), or at least three nucleoside reverse transcriptase inhibitors. Baseline was the latest of January 1, 2012, cohort enrolment or 5 years after starting antiretrovirals. Poisson regression modeled LExTO rates and clinical events (all-cause mortality, non-AIDS malignancy, cardiovascular disease [CVD], and chronic kidney disease [CKD]).Results:Of 23 827 participants, 2164 progressed to LExTO (9.1%) during 130 061 person-years follow-up (PYFU); incidence 1.66/100 PYFU (95% CI 1.59-1.73). Predictors of LExTO were HIV duration more than 15 years (vs. 7.5-15; adjusted incidence rate ratio [aIRR] 1.32; 95% CI 1.19-1.46), development of CKD (1.84; 1.59-2.13), CVD (1.64; 1.38-1.94), AIDS (1.18; 1.07-1.30), and current CD4+cell count of 350 cells/μl or less (vs. 351-500 cells/μl, 1.51; 1.32-1.74). Those followed between 2018 and 2021 had lower rates of LExTO (vs. 2015-2017; 0.52; 0.47-0.59), as did those with baseline viral load of 200 cp/ml or less (0.46; 0.40-0.53) and individuals under 40. Development of LExTO was not significantly associated with clinical events after adjustment for age and current CD4, except CKD (1.74; 1.48-2.05).Conclusion:Despite an aging and increasingly comorbid population, we found declining LExTO rates by 2018-2021, reflecting recent developments in contemporary ART options and clinical management. Reassuringly, LExTO was not associated with a significantly increased incidence of serious clinical events apart from CKD.","author_count":26,"contributors":["Mocroft, Amanda","Pelchen-Matthews, Annegret","Hoy, Jennifer","Llibre, Josep M.","Neesgaard, Bastian","Jaschinski, Nadine","Domingo, Pere","Rasmussen, Line Dahlerup","Günthard, Huldrych F.","Surial, Bernard","Öllinger, Angela","Knappik, Michael","De Wit, Stephane","Wit, Ferdinand","Mussini, Cristina","Vehreschild, Joerg","Monforte, Antonella D.Arminio","Sonnerborg, Anders","Castagna, Antonella","Anne, Alain Volny","Vannappagari, Vani","Cohen, Cal","Greaves, Wayne","Wasmuth, Jan C.","Spagnuolo, Vincenzo","Nielsen, Lene Ryom"],"cuid":["S02-089.43-725187"],"filters":{"added":"2024-05","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","Europe, EU","Europe, Non-EU","Nordic","OECD","Oceania"],"corpau":["RESPOND Cohort Collaboration"],"corresponding_author":["Mocroft, Amanda"],"country":["Australia","Austria","Belgium","Germany","Italy","Netherlands","Spain","Sweden","Switzerland","United Kingdom","United States"],"glorg":["ASST Santi Paolo e Carlo","All Global Affiliations","European AIDS Treatment Group","Germans Trias","Gilead Sciences","Gilead Sciences Incorporated","HIV Monitoring Foundation","Hospital Germans Trias i Pujol","Hospital de la Santa Creu i Sant Pau","Hospital of the Holy Cross and Saint Paul","Inc.","Johannes Kepler University Linz","Karolinska Institute","Karolinska University Hospital","Kepler Universitätsklinikum","Klinik Penzing","Merck & Co., Inc.","Monash University","Royal Prince Alfred Hospital","Saint-Pierre University Hospital","St Pierre University Hospital","University College London","University Hospital Bern","University Hospital Bonn","University Hospital Cologne","University Hospital Zurich","University Hospital Zürich","University Hospital of Bern","University of Cologne","University of Modena and Reggio Emilia","University of Zurich","University of Zürich","ViiV Healthcare","ViiV Healthcare, USA","Vita-Salute San Raffaele University"],"keyword":["