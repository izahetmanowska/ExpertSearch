"first":"Nicholas","key":"parchimpau","last":"Parchim","name":"Parchim, Nicholas","rank":12,"rolecode":"pau"},{"affno":"24","first":"Nathan D.","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Nathan D.","rank":13,"rolecode":"pau"}],"pmid":["39222142"],"pub":{"doi":"10.1007/s00134-024-07586-2","issn":["03424642","09351701"],"issn_org":["03424642"],"issue":"10","journal":"Intensive Care Medicine","pages":"1580-1592","publisher":"Springer Science+Business Media","status":"p","title":"Intensive Care Medicine","volume":"50"},"review":"Peer Reviewed","scoID":["2-s2.0-85202949817"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-cc0c5391-96bb-4af4-b168-1b2fe3d2c5fd","sdu-4dbd51bd-1eaf-42d9-bb63-54f2e8fde8b7"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Understanding, assessing and treating immune, endothelial and haemostasis dysfunctions in bacterial sepsis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-083.65-769238","year":"2024","yearsub":"2024"}
{"abstract":"Aim: Postmortem Computed Tomography (PMCT) is gradually introduced at forensic institutes. Image reconstruction software can increase diagnostic potential in CT by increasing distinction between structures and reduction of artifacts. The aim of this study was to develop and evaluate novel image reconstruction parameters for postmortem conditions, to increase image quality and diagnostic potential of CT scans. Method: Twenty PMCT scans of deceased hereof two in severe decay were subjected to four reconstruction techniques: a standard reconstruction algorithm, the detail reconstruction algorithm and two novel algorithms based on the standard algorithm, but with different Hounsfield settings. Image quality was evaluated by visual grading analysis (VGA) by four forensic radiologist observers. Results: The VGA did not prove that any of the reconstruction techniques were superior to the others. For standard and detail, the two pre-defined reconstruction algorithms, VGA scores were indiscernible and were superior to the equally indiscernible Hounsfield reconstructions on parameters translated into Sharpness and Low Contrast Resolution. The two alternative Hounsfield settings were superior with respect to Noise and Artifacts/Beam Hardening. Conclusion: The study elucidates the possiblity for multiple reconstructions specialized for PMCT conditions, to accommodate the special conditions when working with the deceased. Despite the lack of clear improvements in the tested reconstructions, this study provides an insight into some of the possibilities of improving PMCT quality using reconstruction techniques.","author_count":15,"contributors":["Hansen, Pernille Lund","Leth, Peter Mygind","Nielsen, Pernille Aagaard","Bech, Dina Maria","Nielsen, Julie Brandhøj","Mørup, Svea Deppe","Holst, Anette Koch","Bak, Lene","Poulsen, Mette Ramsdal","Greisen, Pernille Wied","Hansen, Dennis Lund","Precht, Helle"],"cuid":["S02-097.75-742454"],"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Hansen, Pernille Lund"],"keyword":["Forensic pathology","Image quality","Postmortem computed tomography","Virtopsy","Virtual autopsy"],"level":"sci","mra":["hum","med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U","DI-UC"],"level3":{"HO":["DI-HO-ALL","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-SDU"],"UC":["DI-UC-ALL","DI-UC-UCL"]},"level3all":["DI-HO-SDR","DI-U-SDU","DI-UC-UCL"]},"review":"pr","rtype":["clu"],"sorti":"optimization of postprocessing parameters for abdominal forensic ct scans","src":["sdu","ucl"],"src-code":["DI-U-SDU","DI-UC-UCL"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.fsisyn.2024.100478","version":"Published Version"},"id":"S02-097.75-742454","identifier":[{"id":"38779309","type":"pmid"},{"id":"85192864804","type":"scopus"},{"id":"PMC11109732","type":"pmcid"}],"ids":["sdu-2ee7b015-313d-4af1-a0aa-9be843438a9a","ucl-19de5a38-a535-4688-825a-46da90ff391c"],"keyword":["Diagnostic quality","Forensic pathology","Image quality","Postmortem computed tomography","Virtopsy","Virtual autopsy"],"lang":"English","level":"Scientific","mra":["Humanities","Medical Science"],"noi":["Global-Local-2-5-E779FDD13BFC14F87A75A8646DE17202"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.fsisyn.2024.100478","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/263039997/1-s2.0-S2589871X24000251-main.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ucl university college","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-UCL","l3nl":"UCL University College","l3nn":"UCL University College","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"UCL University College","namevar":["UCL Erhvervsakademi og Professionshøjskole, Direktion, Sundhed, Radiografuddannelsen"],"nora_code":"DI-UC-UCL","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Forensic Medicine"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Pernille Lund","key":"hansenpernillelundpau","last":"Hansen","locid":"84e194f7-4701-475e-9cae-eac06e672ab2","name":"Hansen, Pernille Lund","orcid":"0000-0001-8284-4917","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Peter Mygind","key":"lethpetermygindpau","last":"Leth","locid":"ea208206-a7cc-4f6d-8628-1ef58e31aa04","name":"Leth, Peter Mygind","orcid":"0000-0002-8685-0246","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Pernille Aagaard","key":"nielsenpernilleaagaardpau","last":"Nielsen","name":"Nielsen, Pernille Aagaard","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Dina Maria","key":"bechdinamariapau","last":"Bech","name":"Bech, Dina Maria","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Julie Brandhøj","key":"nielsenjuliebrandhøjpau","last":"Nielsen","name":"Nielsen, Julie Brandhøj","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Svea Deppe","key":"mørupsveadeppepau","last":"Mørup","locid":"5b6d053b-2f49-46b3-ae3d-2f964022919d","name":"Mørup, Svea Deppe","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first"