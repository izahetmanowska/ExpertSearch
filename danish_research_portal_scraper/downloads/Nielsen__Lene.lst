c3f539f5","sdu-19a82939-6b9e-484c-8838-810477de59d3"],"src":["AAU Aalborg University","KU University of Copenhagen","NFA National Research Centre for the Working Environment","SDU University of Southern Denmark"],"title":"Occupational history of psychosocial work environment exposures and risk of autoimmune rheumatic diseases - a Danish register-based cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-095.56-813287","year":"2025","yearsub":"2025"}
{"abstract":"Polyploidy is often associated with the ability to grow under harsh conditions. The objective of this study was to test whether genome doubling in Acacia senegal confers superiority for growth under saline conditions. For this purpose, we assessed the cytotype distribution across ten natural stands in Senegal, representing different soil salinities. We further compared the growth of diploid and tetraploid A. senegal seedlings in a shared-pot greenhouse experiment, in which seedling pairs (diploids and polyploids) were irrigated with and without added NaCl. We found polyploids in six stands, and the proportion of polyploids in these stands was significantly and positively correlated with their level of soil salinity. Under experimental conditions, we found that the growth rate of diploid and tetraploid seedlings was equally depressed by salt stress, but the mortality rate for tetraploids was lower than that for diploids (34% versus 54%). In addition, the root-top ratio was higher in tetraploids compared to diploids, which may influence fitness under harsh conditions. Overall, this study provides support for polyploid superiority in A. senegal growing in saline soils. The findings of this study may have practical implications for the reforestation of saline soils with polyploid A. senegal, and we recommend further studies to elucidate their potential.","author_count":4,"contributors":["Diallo, Adja Madjiguene","Kjær, Erik Dahl","Nielsen, Lene Rostgaard","Ræbild, Anders"],"cuid":["S01-000.00-809439"],"filters":{"added":"2025-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Africa"],"country":["Senegal"],"glorg":["All Global Affiliations","Institut sénégalais de recherche agricole"],"keyword":["GROWTH","Polyploidy","Salt stress","Senegalia senegal","Survival"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"polyploid advantage comparing salt stress responses of di and tetraploid i acacia senegal i l willd seedlings","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/f16030412","version":"Published Version"},"id":"S01-000.00-809439","identifier":[{"id":"105001104295","type":"scopus"}],"ids":["ku-322da34b-06f9-41c6-966c-9d42a7931912"],"keyword":["Senegalia senegal","growth","polyploidy","salt stress","survival"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-ABD004E4BC68AF62B29CC1E9F69E6D27"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/447730304/Polyploid_Advantage.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/f16030412","version":"Published Version"}],"org":[{"affno":"1","country":"sn","key":"institut sénégalais de recherche agricole","loc":["Senegal","Africa"],"name":"Institut sénégalais de recherche agricole","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Geosciences and Natural Resource Management, Forest and Landscape Ecology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Adja Madjiguene","key":"diallopau","last":"Diallo","name":"Diallo, Adja Madjiguene","rank":1,"rolecode":"pau"},{"affno":"2","first":"Erik Dahl","key":"kjærpau","last":"Kjær","locid":"e1bdaffb-0384-4159-aa20-a913a2cee948","name":"Kjær, Erik Dahl","orcid":"0000-0001-8624-1611","rank":2,"rolecode":"pau"},{"affno":"2","first":"Lene Rostgaard","key":"nielsenpau","last":"Nielsen","locid":"8e8b51ee-3f45-4ebe-b2fb-fa79f1256d08","name":"Nielsen, Lene Rostgaard","orcid":"0000-0002-7214-8691","rank":3,"rolecode":"pau"},{"affno":"2","first":"Anders","key":"ræbildpau","last":"Ræbild","locid":"599ea842-1926-48bd-b897-1bc32e9b4912","name":"Ræbild, Anders","orcid":"0000-0002-8793-5663","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.3390/f16030412","issn":["19994907"],"issue":"3","journal":"Forests","paperid":"412","status":"p","title":"Forests","volume":"16"},"review":"Peer Reviewed","scoID":["2-s2.0-105001104295"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-322da34b-06f9-41c6-966c-9d42a7931912"],"src":["KU University of Copenhagen"],"title":"Polyploid Advantage? Comparing Salt Stress Responses of Di- and Tetraploid <i>Acacia senegal</i> (L.) Willd. Seedlings","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-809439","year":"2025","yearsub":"2025"}
{"abstract":"Objective To test the reliability of the Outcome Measures in Rheumatology Giant cell arteritis (GCA) Ultrasonography Score (OGUS) and other composite scores in a patient-based exercise involving experts and non-experts in vascular ultrasonography. Methods Six GCA patients were scanned twice (two rounds separated ≥3 hours) by 12 experts and 12 non-experts. Non-experts received 90 min of theoretical and 240 min of practical training between rounds 1 and 2. Ultrasonography was conducted on temporal arteries (common superficial, frontal and parietal branches) and axillary arteries bilaterally to calculate the OGUS, the Southend score and the Halo count. Inter-reader and intra-reader reliability were assessed by intraclass correlation coefficient (ICC). Results Mean age of GCA patients was 78±5.1 years, 2 (33.3%) were women, and all were in clinical remission. Expert inter-reader ICC of the OGUS was 0.60 in both rounds, 0.40 in round 1 and 0.51 in round 2 for the Southend score and 0.45 and 0.52, respectively, for the Halo count. Median ICCs for intra-reader reliability were 0.86, 0.73 and 0.65 for the OGUS, Southend score and Halo count, respectively. For non-experts, inter-reader ICCs in round 1 were 0.20 for the OGUS, 0.20 for a normalised Southend score (=score divided by available segments) and 0.35 for a normalised Halo count. After training, inter-reader reliability ICCs improved to 0.52, 0.29 and 0.54, respectively. Conclusion Inter-reader reliability was fair to moderate, and intra-reader reliability was good for OGUS, Southend score and Halo count among experts. Inter-reader reliability of non-experts in vascular ultrasonography improved after the training.","author_count":32,"contributors":["Duftner, Christina","Redlinger, Norbert","Bruyn, George A.","Chadachan, Veerendra","Chrysidis, Stavros","Correyero, Maria","D'Agostino, Maria Antonietta","Nielsen, Berit Dalsgaard","Dasgupta, Bhaskar","De Miguel, Eugenio","Diamantopoulos, Andreas P.","Fulvio, 