{"author_count":9,"contributors":["Jacobsen, Lene","Berg, Søren","Skov, Christian","Nielsen, Jan","Aarestrup, Kim","Jepsen, Niels","Christensen, Emil Aputsiaq Flindt","Skovrind, Mikkel","Højrup, Lasse Birch"],"cuid":["S01-000.00-348812"],"event":{"end":"2016-02-02","place":"Copenhagen, dk","start":"2016-02-01","title":"Dansk Ferskvandssymposium 2016","year":"2016"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"nr","rtype":["clu"],"sorti":"aborrer og gedder i brakvand betydningen af ferskvandsområder for gydning","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dco","type-grp":["all","pub"]},"id":"S01-000.00-348812","ids":["dtu-94533e98-69bb-438f-bfbe-00f987bffcce"],"lang":"Danish","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-4818A2280666910C5CDA54EEC8A65362"],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Institute of Aquatic Resources","Technical University of Denmark, National Institute of Aquatic Resources, Section for Freshwater Fisheries Ecology"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Lene","key":"jacobsenpau","last":"Jacobsen","locid":"c9b73878-bc67-4632-9a34-0c1244b7983d","name":"Jacobsen, Lene","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren","key":"bergpau","last":"Berg","locid":"a89cb62d-3997-46ee-ab67-1d575fc67ec2","name":"Berg, Søren","orcid":"0000-0001-8772-0921","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Christian","key":"skovpau","last":"Skov","locid":"f825c923-9ddc-4c63-885b-be6e6bddfb12","name":"Skov, Christian","orcid":"0000-0002-8547-6520","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jan","key":"nielsenpau","last":"Nielsen","locid":"d59d1209-447c-4660-bc17-af58d6b9461b","name":"Nielsen, Jan","orcid":"0000-0002-9961-2933","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kim","key":"aarestruppau","last":"Aarestrup","locid":"60987b6f-7027-4bd5-91bc-d2f10390aa63","name":"Aarestrup, Kim","orcid":"0000-0001-8521-6270","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Niels","key":"jepsenpau","last":"Jepsen","locid":"2e45a944-e9ed-4f25-8078-fc493c74951d","name":"Jepsen, Niels","orcid":"0000-0003-0927-6823","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Emil Aputsiaq Flindt","key":"christensenpau","last":"Christensen","locid":"4717e93f-e3a5-45d2-9556-73afbccc0d51","name":"Christensen, Emil Aputsiaq Flindt","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mikkel","key":"skovrindpau","last":"Skovrind","name":"Skovrind, Mikkel","rank":8,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lasse Birch","key":"højruppau","last":"Højrup","name":"Højrup, Lasse Birch","rank":9,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Cope