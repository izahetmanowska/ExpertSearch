bb31","ku-93076334-6c14-4b78-a0b9-ddec91d5faf8","sdu-428df3aa-ac8e-4527-af54-63023f457a06"],"src":["AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"A systematic review of health-related quality of life in longitudinal studies of myeloma patients","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-090.69-704271","year":"2017","yearsub":"2017"}
{"abstract":"Objective: To describe the prevalence of oral candidiasis (OC) in individuals with acquired brain injury (ABI) and to evaluate the association of OC with improvement in dysphagia. Design: Longitudinal observational study. Methods: Individuals with ABI admitted to a rehabilitation centre were recruited over a one-year period. OC-data were collected by clinical examinations and verified by cultivation/microscopy in every 3 weeks during first 10 weeks of admission. Data on dysphagia were collected through medical record reviews. Dysphagia improvement was defined by: 1) First positive change in food consistency, 2) Initiation of at least soft food consistency. Individuals with and without OC were compared using multivariable Cox proportional hazards regression. Results: The overall OC prevalence in all individuals and in individuals not treated with antifungal agents were 32.5% and 29.7%, respectively. The OC prevalence was 24.8% after one week of admission and reduced to 10.1% after ten weeks of admission. Adjusted hazard ratios for improvement in dysphagia were 0.64-0.77 in OC compared to without OC, though not statistically significant. Conclusion: Prevalence of OC was high at admission but reduced during rehabilitation. Though non-significant, the negative trend between OC and improvement in dysphagia suggest that OC may delay the rehabilitation of dysphagia.","author_count":3,"contributors":["Odgaard, Lene","Nielsen, Jørgen Feldbæk","Kothari, Mohit"],"cuid":["S01-000.00-221336"],"event":{"end":"2017-09-23","place":"Barcelona, es","start":"2017-09-20","title":"European Society for swallowing disorders","year":"2017"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"prevalence and association of oral candidiasis with dysphagia in individuals with acquired brain injury abi","src":["au"],"src-code":["DI-U-AU"],"type":"dco","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.au.dk/ws/files/117552012/Prevalence_and_association_sept._2017_final.pdf","version":"Published Version"},"id":"S01-000.00-221336","ids":["au-a17125d7-5434-49cc-8f07-c16948ba2aac"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-E41F1EC53FC7539490B18E3618BEC840"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.au.dk/ws/files/117552012/Prevalence_and_association_sept._2017_final.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Regionshospital Hammel Neurocenter"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Lene","key":"odgaardpau","last":"Odgaard","locid":"1b80fe7b-ba0a-45b3-aca1-48bc19a97a44","name":"Odgaard, Lene","orcid":"0000-0002-9830-3282","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jørgen Feldbæk","key":"nielsenpau","last":"Nielsen","locid":"3fb25b9f-381b-44a6-a8dd-26eacf839d37","name":"Nielsen, Jørgen Feldbæk","orcid":"0000-0001-5339-171X","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mohit","key":"kotharipau","last":"Kothari","locid":"04b2613a-b642-417f-9f1d-08167c4832ec","name":"Kothari, Mohit","orcid":"0000-0002-8191-9769","rank":3,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-a17125d7-5434-49cc-8f07-c16948ba2aac"],"src":["AU Aarhus University"],"title":"Prevalence and association of oral candidiasis with dysphagia in individuals with acquired brain injury (ABI)","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-221336","year":"2017","yearsub":"2017"}
