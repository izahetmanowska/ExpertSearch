{"author_count":6,"contributors":["McKinney, Lea Vig","Nielsen, Lene Rostgaard","Collinge, David B.","Thomsen, Iben Margrete","Hansen, Jon Kehlet","Kjær, Erik Dahl"],"cuid":["S01-000.00-545265"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"the ash dieback crisis genetic variation in resistance can prove a long term solution","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1111/ppa.12196","version":"Other Version"},"id":"S01-000.00-545265","identifier":[{"id":"84898050938","type":"scopus"}],"ids":["ku-fe6f1b59-81e1-4142-8c50-94f065811fce"],"keyword":["Chalara fraxinea, Fraxinus excelsior, genetic resistance, Hymenoscyphus pseudoalbidus, pathogen, tree breeding"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-079ACC43AF6BF2012930A4CFB55E91D5"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1111/ppa.12196","version":"Other Version"},{"access":"oa","type":"rem","url":"http://dx.doi.org/10.1111/ppa.12196","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Plant and Environmental Sciences, Microbial Ecology and Biotechnology","Københavns Universitet, Faculty of Science, Department of Plant and Environmental Sciences, Section for Plant Glycobiology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"Lea Vig","key":"mckinneypau","last":"McKinney","locid":"060df27a-59d3-4457-81a2-185cca16ae68","name":"McKinney, Lea Vig","orcid":"0000-0001-6601-4614","rank":1,"rolecode":"pau"},{"affno":"","first":"Lene Rostgaard","key":"nielsenpau","last":"Nielsen","locid":"8e8b51ee-3f45-4ebe-b2fb-fa79f1256d08","name":"Nielsen, Lene Rostgaard","orcid":"0000-0002-7214-8691","rank":2,"rolecode":"pau"},{"affno":"1","first":"David B.","key":"collingepau","last":"Collinge","locid":"dd98d423-bae9-4d35-bce3-053f4552c5f0","name":"Collinge, David B.","orcid":"0000-0003-2690-5820","rank":3,"rolecode":"pau"},{"affno":"","first":"Iben Margrete","key":"thomsenpau","last":"Thomsen","locid":"7af020b5-3cb6-48cf-9002-177bc56b36f3","name":"Thomsen, Iben Margrete","orcid":"0000-0001-7139-018X","rank":4,"rolecode":"pau"},{"affno":"","first":"Jon Kehlet","key":"hansenpau","last":"Hansen","locid":"b8c2f3eb-b79f-46cc-b346-8300943e2129","name":"Hansen, Jon Kehlet","orcid":"0000-0002-1260-3509","rank":5,"rolecode":"pau"},{"affno":"","first":"Erik Dahl","key":"kjærpau","last":"Kjær","locid":"e1bdaffb-0384-4159-aa20-a913a2cee948","name":"Kjær, Erik Dahl","orcid":"0000-0001-8624-1611","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1111/ppa.12196","issn":["00320862","13653059"],"issn_org":["13653059"],"issue":"3","journal":"Plant Pathology","pages":"485-499","status":"p","title":"Plant Pathology","volume":"63"},"review":"Peer Reviewed","scoID":["2-s2.0-84898050938"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-fe6f1b59-81e1-4142-8c50-94f065811fce"],"src":["KU University of Copenhagen"],"title":"The ash dieback crisis : genetic variation in resistance can prove a long-term solution","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-545265","year":"2014","yearsub":"2014"}
{"abstract":"Background: Risk medications are frequently associated with adverse events and hospitalisations. Objective: To evaluate a risk medication screening service for in-patients at Danish hospitals. Setting: Danish hospitals. Methods: The study was designed as a controlled, prospective intervention study. Inpatients were screened for the use of five risk medications; anticoagulants, digoxin, methotrexate, NSAIDs and opioids, and during the intervention period recommendations were made by clinical pharmacists according to a standardized intervention scheme. The recommendations were discussed with the physician face-to-face. Main outcome measure: Readmissions within 6 months after discharge. Results: In total, 1,007 control and 775 intervention patients were included in the study. The study found that half of the patients (50 % during the control and 48 % during the intervention period) admitted to Danish hospitals were treated with at least one of the five selected risk medications, significantly more drug related problems (DRPs) were identified during the control period (1.7/patient during the control and 1.4/patient during the intervention period (p < 0.001)), and the acceptance rate of recommendations (62 %) was similar to medication management service studies in the literature (39-100 %). However, no impact on outcome measures was found. The majority (69 %) of the clinical pharmacists reported that they had increased their professional competences by participating in the study, and that a national clinical pharmacy study may be used in promoting and implementing a unique clinical pharmacy service throughout the country (67 %). Conclusion: The study showed that a national screening service for risk medications could help identify and address DRPs. Despite no impact on the selected outcome measures, it is likely that the screening service could be included in a medication management review with further focus on the individual patient to ensure positive outcomes, or that the screening service should be delivered to selected patients groups, who might have maximum benefit of the service.","author_count":8,"contributors":["Kjeldsen, Lene Juel","Clemmensen, Marianne Hald","Kronborg, Christian","Hedegaard, Ulla","Larsen, Line Hedegaard","Yderstræde, Inger Olsen","Nielsen, Jette Lyngholm","Nielsen, Trine Rune Høgh"],"cuid":["S01-000.00-579236"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Adult","Aged","Clinical pharmacy","Cooperative Behavior","Denmark","Drug Related Side Effects and Adverse Reactions","Female","Hospital","Humans","Intervention","Male","Middle Aged","Personal Satisfaction","Pharmacists","Pharmacy Service Hospital","Screening"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-PR-OTH","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"evaluation of a controlled national collaboration study on a clinical pharmacy service of screening for risk medications","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s11096-013-9905-6","version":"Other Version"},"id":"S01-000.00-579236","identifier":[{"id":"84899918193","type":"scopus"},{"id":"24346818","type":"pmid"}],"ids":["sdu-151539d9-f62f-4cd8-9dc0-2c3ec37b9609"],"keyword":["Adult","Aged","Clinical pharmacy","Cooperative Behavior","Denmark","Drug-Related Side Effects and Adverse Reactions","Female","Hospital","Humans","Intervention","Male","Middle Aged","Personal Satisfaction","Pharmacists","Pharmacy Service, Hospital","Risk medication","Screening"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-A0A986FE7184B3B51B1F0A8E6ED0A950"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s11096-013-9905-6","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["Amgros"],"nora_code":"DI-PR-OTH","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Business and Social Sciences, Department of Economics","SDU, The Faculty of Business and Social Sciences, Department of Economics, COHERE","SDU, The Faculty of Business and Social Sciences, Department of Economics, Econometrics and Management Science","SDU, The Faculty of Business and Social Sciences, Department of Economics, FAIRCARE"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lene Juel","key":"kjeldsenlenejuelpau","last":"Kjeldsen","name":"Kjeldsen, Lene Juel","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Marianne Hald","key":"clemmensenmariannehaldpau","last":"Clemmensen","name":"Clemmensen, Marianne Hald","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Christian","key":"kronborgchristianpau","last":"Kronborg","locid":"e1c847eb-046f-4ba6-9f7b-a0d15cd29c40","name":"Kronborg, Christian","orcid":"0000-0001-9627-1419","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Ulla","key":"hedegaardullapau","last":"Hedegaard","locid":"82b24eb2-1cc9-49b6-bd97-07f2cb6a6d2b","name":"Hedegaard, Ulla","orcid":"0000-0002-8958-2187","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Line Hedegaard","key":"larsenlineh