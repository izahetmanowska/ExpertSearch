lbækbentpau","last":"Aalbæk","locid":"dc92f1f0-60dd-4ce6-978c-1e9465720689","name":"Aalbæk, Bent","rank":4,"rolecode":"pau"},{"affno":"1","first":"Ole Lerberg","key":"nielsenolelerbergpau","last":"Nielsen","locid":"619b7b3d-9ffd-44f2-bc6d-cfbeeae1db57","name":"Nielsen, Ole Lerberg","rank":5,"rolecode":"pau"},{"affno":"1","first":"Páll S.","key":"leifssonpállspau","last":"Leifsson","locid":"691042d9-84a7-4df4-8005-8e60cfb7dc4e","name":"Leifsson, Páll S.","orcid":"0000-0003-1539-9491","rank":6,"rolecode":"pau"},{"affno":"1","first":"Lene Elisabeth","key":"buelundleneelisabethpau","last":"Buelund","locid":"08519bcf-e2b1-4ae0-8da9-bd7653cd8a9d","name":"Buelund, Lene Elisabeth","orcid":"0000-0002-4730-4111","rank":7,"rolecode":"pau"},{"affno":"1","first":"Eiliv Lars","key":"svalastogaeilivlarspau","last":"Svalastoga","locid":"246e22f3-4624-4ec6-945c-372a2b6af487","name":"Svalastoga, Eiliv Lars","rank":8,"rolecode":"pau"},{"affno":"1","first":"Henrik Elvang","key":"jensenhenrikelvangpau","last":"Jensen","locid":"20245e41-1eb4-4cfa-a2d6-e6851e101300","name":"Jensen, Henrik Elvang","orcid":"0000-0001-7277-7829","rank":9,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-ceea9af6-3202-480a-863e-059f203917f0"],"src":["KU University of Copenhagen"],"title":"A porcine model of heamatogenous osteomyelitis : pathogenesis and pathology","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-517054","year":"2012","yearsub":"2012"}
{"abstract":"Abstract Objectives: Fever of unknown origin (FUO) is dynamic in its origin and will be an ongoing challenge to the clinician because of shifting disease epidemiology. Here we present a series of patients with classical FUO admitted to an infectious diseases department during a 5-y period, with an emphasis on the diagnostic utility of (18)F-fluorodeoxyglucose positron emission tomography (PET)/computed tomography (CT) in present-day cases of FUO. Methods: Patient records were reviewed retrospectively. Results: A final diagnosis was achieved for 31 of the 52 cases (60%). The final diagnoses of these 31 cases and their distribution in the respective diagnostic categories were: infections 32% (10/31), non-infectious inflammatory disease 55% (17/31), and malignancy 13% (4/31). In our study PET/CT successfully identified an infectious, inflammatory, or neoplastic cause of fever in 10 of the 22 patients (45%) who underwent this scan. Conclusions: During the past decade the proportion of non-infectious inflammatory diseases in FUO series has increased. Based on our findings we recommend: (1) a PET/CT scan be performed early in the diagnostic work-up of patients with FUO, and (2) restraint in performing invasive procedures in patients with FUO in whom no cause of fever has been determined during diagnostic work-up.","author_count":7,"contributors":["Pedersen, Thomas Ingemann","Roed, Casper","Knudsen, Lene Surland","Loft, Annika","Skinhøj, Peter","Nielsen, Susanne Dam","Nielsen, Susanne Dam"],"cuid":["S01-000.00-541830"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"fever of unknown origin a retrospective study of 000000000052 cases with evaluation of the diagnostic utility of fdg pet ct","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3109/00365548.2011.603741","version":"Other Version"},"id":"S01-000.00-541830","identifier":[{"id":"21888563","type":"pmid"},{"id":"84555169342","type":"scopus"}],"ids":["ku-f88bc1d7-8c0f-4e01-bebc-4eb044693c76"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-9488A0F6D0460F7D353D3692CCDA0C8A"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.3109/00365548.2011.603741","version":"Other Version"}],"org":[{"affno":1,"key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Section of Orthopaedics and Internal Medicine"],"nora_code":"DI-U-KU"}],"person":[{"affno":"","first":"Thomas Ingemann","key":"pedersenpau","last":"Pedersen","name":"Pedersen, Thomas Ingemann","rank":1,"rolecode":"pau"},{"affno":"","first":"Casper","key":"roedpau","last":"Roed","locid":"3432c3fc-2d9a-4f77-b3cd-fa54a8352fb0","name":"Roed, Casper","rank":2,"rolecode":"pau"},{"affno":"","first":"Lene Surland","key":"knudsenpau","last":"Knudsen","name":"Knudsen, Lene Surland","rank":3,"rolecode":"pau"},{"affno":"","first":"Annika","key":"loftpau","last":"Loft","name":"Loft, Annika","rank":4,"rolecode":"pau"},{"affno":"","first":"Peter","key":"skinhøjpau","last":"Skinhøj","locid":"8186e5a0-1689-45e5-9adc-f3d9136d41bb","name":"Skinhøj, Peter","rank":5,"rolecode":"pau"},{"affno":"","first":"Susanne Dam","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Susanne Dam","rank":6,"rolecode":"pau"},{"affno":"","first":"Susanne Dam","key":"poulsenpau","last":"Poulsen","locid":"2baa36fa-2709-482a-9595-52c5b9537801","name":"Nielsen, Susanne Dam","name_org":"Poulsen, Susanne Dam","rank":7,"rolecode":"pau"}],"pmid":["21888563"],"pub":{"doi":"10.3109/00365548.2011.603741","issn":["00365548","23744243"],"issn_org":["00365548"],"issue":"1","journal":"Scandinavian Journal of Infectious Diseases","pages":"18-23","status":"p","title":"Scandinavian Journal of Infectious Diseases","volume":"44"},"review":"Peer Reviewed","scoID":["2-s2.0-84555169342"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-f88bc1d7-8c0f-4e01-bebc-4eb044693c76"],"src":["KU University of Copenhagen"],"title":"Fever of unknown origin: A retrospective study of 52 cases with evaluation of the diagnostic utility of FDG-PET/CT","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-541830","year":"2012","yearsub":"2011"}
{"author_count":2,"contributors":["Mikkelsen, Lene Beck","Nielsen, Keld"],"cuid":["S01-000.00-554012"],"filters":{"added":"2023-07","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Børn","Dannelse","Innovation og entreprenørskab","Læring","Naturfag","Skole","læring gennem deltagelse"],"level":"pop","oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U","DI-UC"],"level3":{"U":["DI-U-ALL","DI-U-AU"],"UC":["DI-UC-AB","DI-UC-ALL"]},"level3all":["DI-U-AU","DI-UC-AB"]},"review":"und","rtype":["clu"],"sorti":"naturfag fundament for entreprenørskab og innovation","src":["pha"],"src-code":["DI-UC-AB"],"type":"dna","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://jyllands-posten.dk/debat/breve/ECE5241744/Naturfag+%E2%80%93+fundament+for+entrepren%C3%B8rskab++og+innovation+/","version":"Other Version"},"id":"S01-000.00-554012","ids":["pha-58f9f389-43fd-452d-98cf-5a2026288a00"],"keyword":["Skole","børn","dannelse","innovation og entreprenørskab","læring","læring gennem deltagelse","naturfag"],"lang":"Danish","level":"Popular","noi":["Local-1-1-EB4802E26CC50B36E6B986EB6BE6C7DF"],"org":[{"affno":"1","key":"university college absalon","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-AB","l3nl":"University College Absalon","l3nn":"University College Absalon","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"University College Absalon","namevar":["Professionshøjskolen Absalon, Ledelses og Fællesfunktioner (LOF), Forskning og Innovation, Ledelse og fællesfunktioner Sorø"],"nora_code":"DI-UC-AB","used":1},{"affno":"2","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lene","key":"mikkelsenpa