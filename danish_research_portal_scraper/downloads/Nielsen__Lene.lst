"person":[{"affno":"1","corresponding":null,"first":"Isabella L.","key":"platzisabellalpau","last":"Platz","name":"Platz, Isabella L.","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Malte M.","key":"tetensmaltempau","last":"Tetens","name":"Tetens, Malte M.","rank":2,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Nanna S.","key":"andersennannaspau","last":"Andersen","name":"Andersen, Nanna S.","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Jacob","key":"bodilsenjacobpau","last":"Bodilsen","locid":"260dd517-12cb-4490-b8c0-c69efb455878","name":"Bodilsen, Jacob","orcid":"0000-0002-7398-814X","rank":4,"rolecode":"pau"},{"affno":"3 5","corresponding":null,"first":"Ram B.","key":"dessaurambpau","last":"Dessau","name":"Dessau, Ram B.","rank":5,"rolecode":"pau"},{"affno":"6 7","corresponding":null,"country":"dk","first":"Svend","key":"ellermanneriksensvendpau","last":"Ellermann-Eriksen","locid":"245f9273-0449-479f-9590-53733c1b0642","name":"Ellermann-Eriksen, Svend","rank":6,"rolecode":"pau"},{"affno":"3 2","corresponding":null,"first":"Jens K.","key":"møllerjenskpau","last":"Møller","name":"Møller, Jens K.","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lene","key":"nielsenlenepau","last":"Nielsen","name":"Nielsen, Lene","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Alex Christian","key":"ydenielsenalexchristianpau","last":"Yde Nielsen","name":"Yde Nielsen, Alex Christian","rank":9,"rolecode":"pau"},{"affno":"1","first":"Alex Christian Yde","key":"nielsenalexchristianydepau","last":"Nielsen","name":"Nielsen, Alex Christian Yde","rank":9,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Kirstine K.","key":"søgaardkirstinekpau","last":"Søgaard","locid":"aae05795-5430-4224-8ddc-fdd9e3d19439","name":"Søgaard, Kirstine K.","orcid":"0000-0003-3624-7999","rank":10,"rolecode":"pau"},{"affno":"1 8","corresponding":null,"first":"Christian","key":"østergaardchristianpau","last":"Østergaard","name":"Østergaard, Christian","rank":11,"rolecode":"pau"},{"affno":"1 9","first":"Anne-Mette","key":"lebechannemettepau","last":"Lebech","locid":"f9b459b7-e203-4824-9d80-e7c0e5b56232","name":"Lebech, Anne Mette","name_org":"Lebech, Anne-Mette","orcid":"0000-0002-0943-3289","rank":12,"rolecode":"pau"},{"affno":"1 9","first":"Lars Haukali","key":"omlandlarshaukalihøjpau","last":"Omland","locid":"41e20549-3d47-44ba-8710-0f11c81d4900","name":"Omland, Lars Haukali Høj","name_org":"Omland, Lars Haukali","rank":13,"rolecode":"pau"},{"affno":"1 9","first":"Niels","key":"obelnielspau","last":"Obel","locid":"47b44abc-6c99-4a76-b8b0-ca53b033951b","name":"Obel, Niels","rank":14,"rolecode":"pau"}],"pmid":["39954952"],"pub":{"doi":"10.1016/j.cmi.2025.02.015","issn":["1198743X","14690691"],"issn_org":["1198743X"],"issue":"6","journal":"Clinical Microbiology and Infection","pages":"979-986","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"p","title":"Clinical Microbiology and Infection","volume":"31"},"review":"Peer Reviewed","scoID":["2-s2.0-86000761463"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","North Denmark Region","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-53fd7a60-b13f-4110-96a4-66e3842a7670","au-e5197c85-63c0-491c-85fe-7fbfaafcc3c5","ku-a477d754-fa7e-4d5d-bb1d-53cac2d9db9f"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen"],"title":"Mortality and sequelae associated with regional use of intracranial devices among patients with pneumococcal meningitis: a nationwide, population-based cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-099.49-813353","year":"2025","yearsub":"2025"}
{"abstract":"Despite advances in treatment, approximately 15% of patients with diffuse large B-cell lymphoma (DLBCL) who achieve complete remission (CR) after first-line therapy will experience a relapse. However, there is no consensus on the optimal follow-up strategies for detecting relapse after achieving CR. This population-based study, based on the Danish Lymphoma Registry (LYFO), identified a total of 1634 patients diagnosed with DLBCL between 2010 and 2017, including 105 patients who achieved CR following first-line R-CHOP-like therapy and subsequently relapsed. The median follow-up time was 6 years (range 3-8 years). Most cases of relapse were symptomatic (83%), with B symptoms and peripheral lymphadenopathy being the most common. Asymptomatic relapses were identified through physical examination (1%), blood tests (3%), or imaging findings (13%). The proportion of relapses identified outside routine visits was 70%. Only 5% of scheduled routine visits led to a relapse diagnosis, whereas 74% of unscheduled visits initiated by the patient outside routine follow-up resulted in relapse detection. Our findings highlight that systematic, scheduled monitoring of patients in remission after first-line treatment contributes only modestly to the early detection of disease recurrence. Future studies should explore alternative methods of relapse surveillance rather than relying solely on pre-scheduled clinical follow-up.","author_count":9,"contributors":["Lassen, Therese","Nielsen, Torsten H","von Heymann, Annika","Kongsgaard Nielsen, Lene","Larsen, Morten K","Gang, Anne O","Johansen, Christoffer","Pedersen, Lars M"],"cuid":["S03-100.00-793196"],"filters":{"added":"2025-02","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"corresponding_author":["Pedersen, Lars M."],"keyword":["Adult","Aged","Aged 80 and over","Antineoplastic Combined Chemotherapy Protocols therapeutic use","Cyclophosphamide therapeutic use","Denmark","Diffuse large B cell lymphoma","Doxorubicin therapeutic use","Female","Follow Up Studies","Follow up","Humans","Lymphoma Large B Cell Diffuse drug therapy","Male","Middle Aged","Pathologic Complete Response","Prednisone administration dosage","Recurrence","Registries","Relapse","Remission Induction","Rituximab therapeutic use","Vincristine administration dosage"],"level":"sci","mra":["med","sci"],"oa":"Embargoed Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-SDR","DI-HO-ZEA"],"OT":["Danish Medicines Agency"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-SDR","DI-HO-ZEA","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"limited benefit of routine clinical follow up for relapse detection in diffuse large b cell lymphoma patients in complete remission following first line treatment","src":["au","ku","sdu"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85214435280","version":"Other Version"},"id":"S03-100.00-793196","identifier":[{"id":"85214435280","type":"scopus"},{"id":"39757700","type":"pmid"}],"ids":["au-33d22d1a-6f55-4b33-a37e-d5a0af71de0c","ku-c2c241c6-b853-4620-b959-fd876e9c40c6","sdu-47944046-9973-4fbb-a026-2bc719a13c12"],"keyword":["Adult","Aged","Aged, 80 and over","Antineoplastic Combined Chemotherapy Protocols/therapeutic use","Cyclophosphamide/therapeutic use","Denmark","Doxorubicin/therapeutic use","Female","Follow-Up Studies","Humans","Lymphoma, Large B-Cell, Diffuse/drug therapy","Male","Middle Aged","Pathologic Complete Response","Prednisone/administration & dosage","Recurrence","Registries","Remission Induction","Rituximab/therapeutic use","Vincristine/administration & dosage","diffuse large B-cell lymphoma","follow-up","relapse"],"lang":"English","level":"Scientific","mra"