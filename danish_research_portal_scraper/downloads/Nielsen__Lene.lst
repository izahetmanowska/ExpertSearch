null,"first":"Anna Sigrid Pii","key":"svaneannasigridppau","last":"Svane","locid":"a32bd6a4-4664-4dd6-aaac-2ba4163f04f5","name":"Svane, Anna Sigrid P.","name_org":"Svane, Anna Sigrid Pii","rank":7,"rolecode":"pau"},{"affno":"2","first":"Mauro","key":"mannomauropau","last":"Manno","name":"Manno, Mauro","rank":8,"rolecode":"pau"},{"affno":"4 1","corresponding":null,"first":"Gunna","key":"christiansengunnapau","last":"Christiansen","locid":"64bd6216-e754-4f79-b494-6da91e9e0207","name":"Christiansen, Gunna","rank":9,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Niels Christian","key":"nielsennielschristianpau","last":"Nielsen","locid":"32a7422d-cc2f-4301-87c9-951639ed3662","name":"Nielsen, Niels Christian","orcid":"0000-0003-2978-4366","rank":10,"rolecode":"pau"},{"affno":"3","first":"Lene Broeng","key":"oddershedelenebroengpau","last":"Oddershede","locid":"7474640c-fb11-45b8-abd4-8de4232d5060","name":"Oddershede, Lene Broeng","orcid":"0000-0003-2923-2844","rank":11,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Lene","key":"oddershedelenepau","last":"Oddershede","name":"Oddershede, Lene","rank":11,"rolecode":"pau"},{"affno":"3","country":"dk","first":"Bente","key":"vestergaardbentepau","last":"Vestergaard","locid":"05366427-ef50-4565-95a4-2526dfcb4e44","name":"Vestergaard, Bente","orcid":"0000-0001-8011-6414","rank":12,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Daniel","key":"otzendanielepau","last":"Otzen","locid":"0ec06c22-1f74-4dd2-a894-af30b6565766","name":"Otzen, Daniel E","name_org":"Otzen, Daniel","rank":13,"rolecode":"pau"}],"pmid":["23861789"],"pub":{"doi":"10.1371/journal.pone.0067713","issn":["19326203"],"issue":"7","journal":"PLOS ONE","paperid":"e67713","publisher":"Public Library of Science","status":"p","title":"PLOS ONE","title_org":"P L o S One","volume":"8"},"review":"Peer Reviewed","scoID":["2-s2.0-84879804769"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Undetermined","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-c5fb0185-92eb-4313-9b12-a73155210cb5","ku-2b6d9c5e-608d-410d-a39b-95fd86d20b79"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Wildtype and A30P Mutant Alpha-Synuclein Form Different Fibril Structures","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-086.05-666482","year":"2013","yearsub":"2013"}
{"abstract":"OBJECTIVES: The aim of this prospective multicenter study was to evaluate and compare the diagnostic performance of PET/CT, MRI and transvaginal two-dimensional ultrasound (2DUS) in the preoperative assessment of endometrial cancer (EC). METHODS: 318 consecutive women with EC were included when referred to three Danish tertiary gynecological centers for surgical treatment. Preoperatively they were PET/CT-, MRI-, and 2DUS scanned. The imaging results were compared to the final pathological findings. This study was approved by the National Committee on Health Research Ethics. RESULTS: For predicting myometrial invasion, we found sensitivity, specificity, PPV, NPV, and accuracy for PET/CT to be 93%, 49%, 41%, 95% and 61%, for MRI to be 87%, 57%, 44%, 92%, and 66% and for 2DUS to be 71%, 72%, 51%, 86% and 72%. For predicting cervical invasion, the values were 43%, 94%, 69%, 85% and 83%, respectively, for PET/CT, 33%, 95%, 60%, 85%, and 82%, respectively, for MRI, and 29%, 92%, 48%, 82% and 78% for 2DUS. Finally, for lymph node metastases, the values were 74%, 93%, 59%, 96%, and 91% for PET/CT and 59%, 93%, 40%, 97% and 90% for MRI. When comparing the diagnostic performance we found PET/CT, MRI and 2DUS to be comparable in predicting myometrial invasion. For cervical invasion and lymph node metastases, however, PET/CT was the best. CONCLUSIONS: None of the modalities can yet replace surgical staging. However, they all contributed to important knowledge and were, furthermore, able to upstage low-risk patients who would not have been recommended lymph node resection based on histology and grade alone.","author_count":24,"contributors":["Antonsen, Sofie Leisby","Jensen, Lisa Neerup","Loft, Annika","Berthelsen, Anne Kiil","Costa, Junia","Tabor, Ann","Qvist, Ingelise","Hansen, Mette Rodi","Fisker, Rune Vincents","Søgaard-Andersen, Erik","Sperling, Lene","Nielsen, Anne Lerberg","Asmussen, Jon","Høgdall, Estrid","Fagö-Olsen, Carsten L","Christensen, Ib Jarle","Nede