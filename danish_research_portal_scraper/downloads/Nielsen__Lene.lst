me":". Bruun, Henrik G","rank":11,"rolecode":"pau"},{"affno":"","first":"Vivian Kvist","key":"johannsenviviankvistpau","last":"Johannsen","locid":"50454320-c098-4230-8b34-90829dbe308c","name":"Johannsen, Vivian Kvist","orcid":"0000-0002-1268-9787","rank":12,"rolecode":"pau"},{"affno":"","first":"Thomas","key":"nordlarsenthomaspau","last":"Nord-Larsen","locid":"d5b3bda9-5a06-45e4-8c9a-07e768bef87a","name":"Nord-Larsen, Thomas","orcid":"0000-0002-5341-6435","rank":13,"rolecode":"pau"},{"affno":"","first":"Lars","key":"vesterdallarspau","last":"Vesterdal","locid":"55c9aca9-8d2d-46ca-85b2-a61e5a2c6154","name":"Vesterdal, Lars","orcid":"0000-0003-0309-3735","rank":14,"rolecode":"pau"},{"affno":"","first":"Inge","key":"stupakingepau","last":"Stupak","locid":"ce36edec-65a5-4232-bb80-3d6e31386f3f","name":"Stupak, Inge","orcid":"0000-0002-9984-5024","rank":15,"rolecode":"pau"},{"affno":"","first":"Niclas Scott","key":"bentsenniclasscottpau","last":"Bentsen","locid":"6761011f-ab0b-43f0-bf26-26588f84da9c","name":"Bentsen, Niclas Scott","orcid":"0000-0002-5130-0818","rank":16,"rolecode":"pau"},{"affno":"2","first":"Erik","key":"rasmussenerikpau","last":"Rasmussen","name":"Rasmussen, Erik","rank":17,"rolecode":"pau"},{"affno":"2","first":"Susanne Bødtker","key":"petersensusannebødtkerpau","last":"Petersen","name":"Petersen, Susanne Bødtker","rank":18,"rolecode":"pau"},{"affno":"3","first":"Lene","key":"baunbæklenepau","last":"Baunbæk","name":"Baunbæk, Lene","rank":19,"rolecode":"pau"},{"affno":"4","first":"Maria Gunnleivsdottir","key":"hansenmariagunnleivsdottirpau","last":"Hansen","name":"Hansen, Maria Gunnleivsdottir","rank":20,"rolecode":"pau"}],"pub":{"isbn":["9788771565867"],"pages":"944","place":"Aarhus","publisher":"Aarhus University","repno":"Scientific Report from DCE – Danish Centre for Environment and Energy","series":"Scientific Report from DCE - Danish Centre for Environment and Energy","status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["ku-4f36f82f-4d41-4fb8-976e-8dd885d889ab"],"src":["KU University of Copenhagen"],"title":"Denmark's National Inventory Report 2021 : Emission Inventories 1990-2019 – Submitted under the United Nations Framework Convention on Climate Change and the Kyoto Protocol","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-777670","year":"2021","yearsub":"2021"}
{"abstract":"Purpose: Results of patient-reported outcome measures (PROMs) are increasingly used to inform healthcare decision-making. Research has shown that response shift can impact PROM results. As part of an international collaboration, our goal is to provide a framework regarding the implications of response shift at the level of patient care (micro), healthcare institute (meso), and healthcare policy (macro). Methods: Empirical evidence of response shift that can influence patients’ self-reported health and preferences provided the foundation for development of the framework. Measurement validity theory, hermeneutic philosophy, and micro-, meso-, and macro-level healthcare decision-making informed our theoretical analysis. Results: At the micro-level, patients’ self-reported health needs to be interpreted via dialogue with the clinician to avoid misinterpretation of PROM data due to response shift. It is also important to consider the potential impact of response shift on study results, when these are used to support decisions. At the meso-level, individual-level data should be examined for response shift before aggregating PROM data for decision-making related to quality improvement, performance monitoring, and accreditation. At the macro-level, critical reflection on the conceptualization of health is required to know whether response shift needs to be controlled for when PROM data are used to inform healthcare coverage. Conclusion: Given empirical evidence of response shift, there is a critical need for guidelines and knowledge translation to avoid potential misinterpretations of PROM results and consequential biases in decision-making. Our framework with guiding questions provides a structure for developing strategies to address potential impacts of response shift at micro-, meso-, and macro-levels.","author_count":9,"contributors":["Sawatzky, Richard","Kwon, Jae-Yung","Barclay, Ruth","Chauhan, Cynthia","Frank, Lori","van den Hout, Wilbert","Kongsgaard Nielsen, Lene","Nolte, Sandra","Sprangers, Mirjam A. G."],"cuid":["S02-097.52-030018"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["America, North","Europe, EU","Nordic","OECD"],"corpau":["The Response Shift—in Sync Working Group"],"corresponding_author":["Sawatzky, Richard"],"country":["Canada","Germany","Netherlands","Sweden","United States"],"glorg":["All Global Affiliations","Amsterdam UMC","Free University of Berlin","ICON GmbH","Leiden University","Patient representative","Providence Health Care Research Institute","RAND Corporation","Trinity Western University","University of Amsterdam","University of British Columbia (UBC)","University of California at Berkeley","University of Gothenburg","University of Manitoba","University of Victoria"],"keyword":["Delivery of Health Care","Health Policy","Healthcare decision making","Humans","Organization","Patient","Patient Reported Outcome Measures","Patient reported outcomes","Quality Improvement","Quality of Life psychology","Response shift"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-CDR","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"implications of response shift for micro meso and macro level healthcare decision making using results of patient reported outcome measures","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s11136-021-02766-9","version":"Published Version"},"id":"S02-097.52-030018","identifier":[{"id":"000624390300002","type":"wos"},{"id":"85101076673","type":"scopus"},{"id":"PMC8602130","type":"pmcid"},{"id":"33651278","type":"pmid"}],"ids":["au-ef8303db-5357-