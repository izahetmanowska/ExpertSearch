e":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-85057596561"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","North Denmark Region","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-64ed6ac9-80e4-445c-96ab-605c120d2c82","au-fc08809e-53da-4a6c-aefd-5d5eb70c8a95","ku-d0ecbf7f-4678-4eec-b980-588f9f67077b","sdu-83f8ae55-e27d-4963-8cbc-68a72140e471"],"src":["AAU Aalborg University","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Treatment of candidemia in a nationwide setting : Increased survival with primary echinocandin treatment","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S04-099.97-004885","year":"2018","yearsub":"2018"}
{"abstract":"Congenital cytomegalovirus (cCMV) is the most common infectious cause of congenital malformations in Denmark. The disease is not notifiable, and there are no national data. A regional Danish prospective study from the 1970s found a cCMV incidence of 0.4%. We propose three algorithms for microbiological diagnosing: 1) Testing of pregnant women should only be -applied, when symptoms compatible with CMV infection are present, and no other diagnoses are found. 2) In children less than three weeks of age urine is the -preferred sample. 3) Retrospectively, cCMV may be diagnosed on dried blood spots, if the mother is CMV IgG-positive.","author_count":4,"contributors":["Vestergaard, Hanne Thang","Thomsen, Marianne Kragh","Nielsen, Lene Ryom","Panum, Inge"],"cuid":["S01-000.00-157673"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"diagnostik af kongenit cytomegalovirusinfektion i danmark","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85058765471","version":"Other Version"},"id":"S01-000.00-157673","identifier":[{"id":"85058765471","type":"scopus"},{"id":"30547875","type":"pmid"}],"ids":["au-318d752f-6f46-45ad-9f23-0b060e808541"],"lang":"Danish","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-F90E50C4490866F6611A4B4C47AA8284"],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Clinical Microbiology"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Hanne Thang","key":"vestergaardpau","last":"Vestergaard","name":"Vestergaard, Hanne Thang","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Marianne Kragh","key":"thomsenpau","last":"Thomsen","locid":"252811a0-96a6-47d3-9ff1-84e7b4c181e1","name":"Thomsen, Marianne Kragh","orcid":"0000-0002-3645-6689","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lene","key":"nielsenpau","last":"Nielsen","locid":"6f8f62c5-f3fc-4d3f-9e9e-ecc3f90901e3","name":"Nielsen, Lene Ryom","name_org":"Nielsen, Lene","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Inge","key":"panumpau","last":"Panum","locid":"21877e9f-121e-444f-9105-86c6b14219a4","name":"Panum, Inge","rank":4,"rolecode":"pau"}],"pmid":["30547875"],"pub":{"issn":["00415782","13994174"],"issn_org":["00415782"],"issue":"50","journal":"Ugeskrift for Læger","publisher":"Almindelige Danske Lægeforening","status":"p","title":"Ugeskrift for Læger","volume":"180"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-318d752f-6f46-45ad-9f23-0b060e808541"],"src":["AU Aarhus University"],"title":"Diagnostik af kongenit cytomegalovirusinfektion i Danmark","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-157673","year":"2018","yearsub":"2018"}
{"abstract":"OBJECTIVE: To identify predictors of return to work (RTW) and stable labour market attachment (LMA) after severe traumatic brain injury (TBI) in Denmark. MATERIALS & METHODS: Patients aged 18-64 years, admitted to highly specialized neurorehabilitation after severe TBI 2004-2012 were included and followed up for ≤6 years. Weekly LMA data were retrieved from a national register of public assistance benefits. Weeks without or with supplemental public assistance benefits were defined as LMA weeks. Time of RTW was defined as first week with LMA. Stable LMA was defined as weeks with LMA ≥75% first year after RTW. Multivariable regressions were used to identify predictors of RTW and stable LMA among preinjury characteristics, injury severity, functional ability and rehabilitation trajectories. RESULTS: For the analyses of RTW and stable LMA, 651 and 336 patients were included, respectively. RTW was significantly associated with age (adjusted subhazard ratio 0.98, 95% CI 0.97-0.99), education (1.83, 95% CI 1.16-2.89), supplemental benefits (3.97, 95% CI 2.04-7.71), no benefits (4.86, 95% CI 2.90-8.17), length of stay in acute care (0.77, 95% CI 0.60-0.99) and time period of injury (1.56, 95% CI 1.15-2.10). The only significant predictor of stable LMA was age (adjusted odds ratio 0.97, 95% CI 0.95-0.99). CONCLUSION: RTW after severe TBI was associated with several socio-economic factors, whereas maintaining LMA depended on age only. We suggest that RTW rates could be improved by extensive rehabilitation targeting people that are older and low-educated, as these were less likely to RTW.","author_count":5,"contributors":["Odgaard, Lene","Pedersen, Asger Roer","Poulsen, I","Johnsen, Søren Paaske","Nielsen, Jørgen Feldbæk"],"cuid":["S01-000.00-248323"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Journal Article"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-HO-CAP","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"return to work predictors after traumatic brain injury in a welfare state","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85026485080","version":"Other Version"},"id":"S01-000.00-248323","identifier":[{"id":"85026485080","type":"scopus"},{"id":"28758673","type":"pmid"}],"ids":["au-d046e3ba-cce2-454b-8bf8-5160dcf3b34f"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-143173B19564ADD6928063A1E0E029AA"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Regionshospital Hammel Neurocenter"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["National Hospital of Denmark"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"L","key":"odgaardpau","last":"Odgaard","locid":"1b80fe7b-ba0a-45b3-aca1-48bc19a97a44","name":"Odgaard, Lene","name_org":"Odgaard, L","orcid":"0000-0002-9830-3282","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"A R","key":"pedersenpau","last":"Pedersen","locid":"a9b1b4b8-df5b-437d-a84f-fcc1778ce6eb","name":"Pedersen, Asger Roer","name_org":"Pedersen, A R","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"I","key":"poulsenpau","last":"Poulsen","name":"Poulsen, I","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"S P","key":"johnsenpau","last":"Johnsen","locid":"4664f7a0-39e7-4f46-9121-1c3999eb3d09","name":"Johnsen, Søren Paaske","name_org":"Johnsen, S P","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"J F","key":"nielsenpau","last":"Nielsen","locid":"3fb25b9f-381b-44a6-a8dd-26eacf839d37","name":"Nielsen, Jørgen Feldbæk","name_org":"Nielsen, J F","orcid":"0000-0001-5339-171X","rank":5,"rolecode":"pau"}],"pmid":["28758673"],"pub":{"doi":"10.1111/ane.12806","issn":["00016314","16000404"],"issn_org":["00016314"],"issue":"1","journal":"Acta Neurologica Scandinavica","pages":"44-50","publisher":"John Wiley and Sons Inc.","publisher_org":"John Wiley and Sons Inc","status":"p","title":"Acta Neurologica Scandinavica","volume":"137"},"review":"Peer Reviewed","scoID":["2-s2.0-85026485080"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities"],"PST":["Published"]},"sid":["au-d046e3ba-cce2-454b-8bf8-5160dcf3b34f"],"src":["AU Aarhus University"],"title":"Return to work predictors after traumatic brain injury in a welfare state","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-248323","year":"2018","yearsub":"2018"}
{"abstract":"Consumption of meat prepared by barbecuing is associated with risk of cancer due to formation of carcinogenic compounds including benzo[a]pyrene (BaP). Assessment of a population's risk of disease and people's individual probability of disease given specific consumer attributes may direct food safety strategies to where impact on public health is largest. The aim of this study was to propose a model that estimates the risk of cancer caused by exposure to BaP from barbecued meat in Denmark, and to estimate the probability of developing cancer in subgroups of the population given different barbecuing frequencies. We developed probabilistic models applying two dimensional Monte Carlo simulation to take into account the variation in exposure given age and sex and in the individuals' sensitivity to develop cancer after exposure to BaP, and the uncertainty in the dose response model. We used the Danish dietary consumption survey, monitoring data of chemical concentrations, data on consumer behavior of frequency of barbecuing, and animal dose response data. We estimated an average extra lifetime risk of cancer due to BaP from barbecued meat of 6.8 × 10-5 (95% uncertainty interval 2.6 × 10-7 - 7.0 × 10-4) in the Danish population. This corresponds to approximately one to 4,074 extra cancer cases over a lifetime, reflecting wide uncertainty. The impact per barbecuing event on the risk of cancer for men and women of low body weight was higher compared to higher bodyweight. However, the difference due to sex and bodyweight between subgroups are dwarfed by the uncertainty. This study proposes a model that can be applied to other substances and routes of exposure, and allows for deriving the change in risk following a specific change in behaviour. The presented methodology can serve as a valuable tool for risk management, allowing for the formulation of behaviour advice targeted to specific sub-groups in the population.","author_count":10,"contributors":["Jakobsen, Lea Sletting","Georgiadis, Stylianos","Nielsen, Bo Friis","Bokkers, Bas G H","Boriani, Elena","Duedahl-Olesen, Lene","Hald, Tine","Nauta, Maarten","Stockmarr, Anders","Pires, Sara Monteiro"],"cuid":["S01-000.00-309435"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","OECD"],"corresponding_author":["Jakobsen, Lea Sletting"],"country":["Netherlands"],"glorg":["All Global Affiliations","National Institute of Public Health and the Environment"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"probabilistic approach for assessing cancer risk due to benzo a pyrene in barbecued meat informing advice for population groups","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1371/journal.pone.0207032","version":"Published Version"},"id":"S01-000.00-309435","identifier":[{"id":"PMC6224084","type":"pmcid"},{"id":"30408084","type":"pmid"},{"id":"85056323522","type":"scopus"}],"ids":["dtu-100cb40a-61a9-460d-a94d-b6ad811c75e8"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-C9FF7C222B794055E52DD1ADD1858818"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1371/journal.pone.0207032","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/159854300/journal.pone.0207032_1_.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Food Institute","Technical University of Denmark, National Food Institute, Research Group for Risk Benefit"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"nl","key":"national institute of public health and the environment","loc":["Netherlands","Europe, EU","OECD"],"name":"National Institute of Public Health and the Environment","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Lea Sletting","key":"jakobsenpau","last":"Jakobsen","locid":"9e99d9fd-535f-4c11-b8a7-5c5f34045060","name":"Jakobsen, Lea Sletting","orcid":"0000-0001-9666-348X","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Stylianos","key":"georgiadispau","last":"Georgiadis","locid":"5b6b5ddf-4307-472f-afe5-8963892d6526","name":"Georgiadis, Stylianos","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Bo Friis","key":"nielsenpau","last":"Nielsen","locid":"364b98b5-e608-4186-a566-62fa91a37d59","name":"Nielsen, Bo Friis","orcid":"0000-0001-9146-9733","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Bas G H","key":"bokkerspau","last":"Bokkers","name":"Bokkers, Bas G H","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Elena","key":"borianipau","last":"Boriani","locid":"7eaa86eb-9bb1-4544-a89c-441797e44067","name":"Boriani, Elena","orcid":"0000-0001-9676-7297","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lene","key":"duedahlolesenpau","last":"Duedahl-Olesen","locid":"886d06e9-73a3-4df8-a0af-dc0dd8f96baa","name":"Duedahl-Olesen, Lene","orcid":"0000-0002-3162-0101","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Tine","key":"haldpau","last":"Hald","locid":"617fc5ed-9354-48d5-b831-0c8386b730d5","name":"Hald, Tine","orcid":"0000-0002-1115-9792","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Maarten J","key":"nautapau","last":"Nauta","locid":"6bbc1b20-a517-4ce1-abb9-a88b9481e380","name":"Nauta, Maarten","name_org":"Nauta, Maarten J","orcid":"0000-0001-8738-4251","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anders","key":"stockmarrpau","last":"Stockmarr","locid":"f8ce8f15-f38a-4f99-a8c6-08b0cd7b0f6a","name":"Stockmarr, Anders","orcid":"0000-0002-8681-2370","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sara Monteiro","key":"pirespau","last":"Pires","locid":"eaae5296-a349-424e-aeaa-851a9e4a2510","name":"Pires, Sara Monteiro","orcid":"0000-0002-7751-1509","rank":10,"rolecode":"pau"}],"pmid":["30408084"],"pub":{"doi":"10.1371/journal.pone.0207032","issn":["19326203"],"issue":"11","journal":"PLOS ONE","paperid":"e0207032","publisher":"Public Library of Science","status":"p","title":"PLOS ONE","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-85056323522"],"sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-100cb40a-61a9-460d-a94d-b6ad811c75e8"],"src":["DTU Technical University of Denmark"],"title":"Probabilistic approach for assessing cancer risk due to benzo[a]pyrene in barbecued meat: Informing advice for population groups","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-309435","year":"2018","yearsub":"2018"}
{"abstract":"Glyphosate has been suggested to be an endocrine disrupting chemical capable of disrupting male reproduction. There are conflicting data, however, with studies reporting on effects from exposure to either glyphosate alone or to herbicide formulations, making comparisons difficult. We assessed rat testis histopathology and androgen function following two weeks exposure to either glyphosate at 2.5 and 25 mg/kg bw/day (5x and 50x Acceptable Daily Intake, ADI, respectively), or equivalent high dose of glyphosate in a herbicide formulation; Glyfonova. We observed no significant effects on testes or testosterone synthesis in rats exposed to glyphosate. Limited effects were observed in rats exposed to Glyfonova, with a small upregulation of the steroidogenic genes Cyp11a1 and Cyp17a1. We conclude that glyphosate alone has no effects on adult rat testis at exposure levels up to 25 mg/kg bw/day. Glyfonova induced only minor effects on steroidogenic gene expression, likely caused by additives other than glyphosate.","author_count":7,"contributors":["Johansson, Hanna Katarina Lilith","Schwartz, Camilla Victoria Lindgren","Nielsen, Lene Nørby","Boberg, Julie","Vinggaard, Anne Marie","Bahl, Martin Iain","Svingen, Terje"],"cuid":["S01-000.00-348447"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Svingen, Terje"],"keyword":["Androgens","Glyphosate","Pesticides","Steroidogenesis","Testis","Testosterone","Toxicology"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"exposure to a glyphosate based herbicide formulation but not glyphosate alone has only minor effects on adult rat testis","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/154667384/Johansson_et_al_2018_Reprod_Toxicol_In_Press.pdf","version":"Authors Final Version"},"id":"S01-000.00-348447","identifier":[{"id":"85054391177","type":"scopus"},{"id":"30268827","type":"pmid"}],"ids":["dtu-92f114a2-dc84-4f82-9fbc-5e08e831f26a"],"keyword":["Androgens","Glyphosate","Pesticides","Steroidogenesis","Testis","Testosterone","Toxicology"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-C2F705D13DEAE9F5CAB21D6E4EA904F4"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/154667384/Johansson_et_al_2018_Reprod_Toxicol_In_Press.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Food Institute","Technical University of Denmark, National Food Institute, Research Group for Molecular and Reproductive Toxicology"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Hanna Katarina Lilith","key":"johanssonpau","last":"Johansson","locid":"d6232c0e-ef60-4ffa-a0f5-e7cb937029de","name":"Johansson, Hanna Katarina Lilith","orcid":"0000-0001-9526-6837","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Camilla Lindgren","key":"schwartzpau","last":"Schwartz","locid":"4431b0cd-bcd0-425c-85ad-a434d72ac04f","name":"Schwartz, Camilla Victoria Lindgren","name_org":"Schwartz, Camilla Lindgren","orcid":"0000-0002-2352-7396","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lene Nørby","key":"nielsenpau","last":"Nielsen","locid":"d4e59d1c-9588-4f40-b090-7419ff27d463","name":"Nielsen, Lene Nørby","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Julie","key":"bobergpau","last":"Boberg","locid":"0a6dd5db-7b41-4b80-87f8-589a2e3e5fd8","name":"Boberg, Julie","orcid":"0000-0003-2255-1201","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anne Marie","key":"vinggaardpau","last":"Vinggaard","locid":"c6459d83-f7f1-417a-ac8f-2ab00cb0f432","name":"Vinggaard, Anne Marie","orcid":"0000-0002-6822-3572","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Martin Iain","key":"bahlpau","last":"Bahl","locid":"6e2651b2-1c65-49a5-81c3-9065190c95e2","name":"Bahl, Martin Iain","orcid":"0000-0003-1579-8038","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Terje","key":"svingenpau","last":"Svingen","locid":"1fe94525-c85d-4716-a796-ffb472a569e7","name":"Svingen, Terje","orcid":"0000-0003-4650-7651","rank":7,"rolecode":"pau"}],"pmid":["30268827"],"pub":{"doi":"10.1016/j.reprotox.2018.09.008","issn":["08906238","18731708"],"issn_org":["08906238"],"journal":"Reproductive Toxicology","pages":"25-31","publisher":"Elsevier","status":"p","title":"Reproductive Toxicology","volume":"82"},"review":"Peer Reviewed","scoID":["2-s2.0-85054391177"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-92f114a2-dc84-4f82-9fbc-5e08e831f26a"],"src":["DTU Technical University of Denmark"],"title":"Exposure to a glyphosate-based herbicide formulation, but not glyphosate alone, has only minor effects on adult rat testis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-348447","year":"2018","yearsub":"2018"}
{"abstract":"Design personas have, since their origins in the late 1990s, been recognised as a design tool to foster ideation and empathy with different user groups. The method originates from software development and has since its instigation become a widespread method adopted in many design disciplines and processes, such as innovation and ideation of IT products, User Experience design, agile systems developing, communication, and marketing (Nielsen 2012; Pruitt & Grudin 2003). To get product design closer to the everyday lives of the users, design personas are a means to capture the everyday experiences and needs of users and customers. Focusing on the user or customer in the design process is in opposition to an artistic understanding of the designer as someone who, by experimentation with materials and form, gets inspiration to create unique products.","author_count":1,"contributors":["Nielsen, Lene"],"cuid":["S01-000.00-381401"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"keyword":["Agile development","Design Personas","Ideation","User Centered Design","User Experience UX"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"design personas new ways new contexts","src":["itu"],"src-code":["DI-U-ITU"],"type":"dje","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.21153/psj2018vol4no2art799","version":"Published Version"},"id":"S01-000.00-381401","ids":["itu-09cdccb3-8f59-4d32-8662-2133855457ad"],"keyword":["Agile Development","Design Personas","Ideation","User Experience (UX)","User-Centered Design"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-2-B02360903DD856CE2E71DBD87DA9F282"],"oa_link":[{"access":"oa","type":"rem","url":"https://ojs.deakin.edu.au/index.php/ps/article/download/799/731","version":"Other Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.21153/psj2018vol4no2art799","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lene","key":"nielsenpau","last":"Nielsen","locid":"1052b289-f510-4c5a-9662-2db48c12ebc2","name":"Nielsen, Lene","orcid":"0000-0003-1768-7147","rank":1,"rolecode":"pau"}],"pub":{"doi":"10.21153/psj2018vol4no2art799","issn":["22055258"],"issue":"2","journal":"Persona Studies","pages":"1-4","status":"p","title":"Persona Studies","title_org":"Personas Studies","volume":"4"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-09cdccb3-8f59-4d32-8662-2133855457ad"],"src":["ITU IT University of Copenhagen"],"title":"DESIGN PERSONAS–NEW WAYS, NEW CONTEXTS","type":"Editorial","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-381401","year":"2018","yearsub":"2018"}
{"abstract":"The demand for highly efficient macromolecular drugs, used in the treatment of many severe diseases, is continuously increasing. However, the hydrophilic character and large molecular size of these drugs significantly limit their ability to permeate across cellular membranes and thus impede the drugs in reaching their target sites in the body. Cell-penetrating peptides (CPP) have gained attention as promising drug excipients, since they can facilitate drug permeation across cell membranes constituting a major biological barrier. Fluorophores are frequently covalently conjugated to CPPs to improve detection, however, the ensuing change in physico-chemical properties of the CPPs may alter their biological properties. With complementary biophysical techniques, we show that the mode of biomembrane interaction may change considerably upon labeling of the CPP penetratin (PEN) with a fluorophore. Fluorophore-PEN conjugates display altered modes of membrane interaction with increased insertion into the core of model cell membranes thereby exerting membrane-thinning effects. This is in contrast to PEN, which localizes along the head groups of the lipid bilayer, without affecting the thickness of the lipid tails. Particularly high membrane disturbance is observed for the two most hydrophobic PEN conjugates; rhodamine B or 1-pyrene butyric acid, as compared to the four other tested fluorophore-PEN conjugates.","author_count":11,"contributors":["Hedegaard, Sofie Fogh","Derbas, Mohammed Sobhi","Lind, Tania Kjellerup","Kasimova, Marina Robertovna","Christensen, Malene Vinther","Michaelsen, Maria Høtoft","Campbell, Richard A","Jørgensen, Lene","Franzyk, Henrik","Cárdenas, Marité","Nielsen, Hanne Mørck"],"cuid":["S01-000.00-511071"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["Europe, EU","Nordic","OECD"],"country":["France","Sweden"],"glorg":["All Global Affiliations","Institut Laue-Langevin","Malmö University"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-SYM"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-PR-SYM","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"fluorophore labeling of a cell penetrating peptide significantly alters the mode and degree of biomembrane interaction","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41598-018-24154-z","version":"Published Version"},"id":"S01-000.00-511071","identifier":[{"id":"85045914037","type":"scopus"},{"id":"PMC5910404","type":"pmcid"},{"id":"29679078","type":"pmid"}],"ids":["ku-c51e3bc5-2609-4e95-ac13-d9b87e28595e"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-92B5CFB3A35195688CDB7D3ECFEF3EC6"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41598-018-24154-z","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/198656762/Fluorophore_labeling_of_a_cell_penetrating_peptide_significantly_alters_the_mode_and_degree_of_biomembrane_interaction.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Pharmacy, Drug Delivery and Biophysics of Biopharmaceuticals"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"se","key":"malmö university","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Malmö University","used":1},{"affno":"3","country":"dk","key":"symphogen","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-SYM","l3nl":"Symphogen A/S","l3nn":"Symphogen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Symphogen","namevar":["Symphogen A/S"],"nora_code":"DI-PR-SYM","used":1},{"affno":"4","country":"fr","key":"institut laue langevin","loc":["France","Europe, EU","OECD"],"name":"Institut Laue-Langevin","used":1}],"person":[{"affno":"1","first":"Sofie Fogh","key":"hedegaardpau","last":"Hedegaard","locid":"7a4b52b2-b509-4769-be9d-2ff8abda74d4","name":"Hedegaard, Sofie Fogh","orcid":"0000-0003-1666-4621","rank":1,"rolecode":"pau"},{"affno":"1","first":"Mohammed Sobhi","key":"derbaspau","last":"Derbas","locid":"69f7b56c-13b8-4dcb-8cc0-304665eef369","name":"Derbas, Mohammed Sobhi","rank":2,"rolecode":"pau"},{"affno":"2","first":"Tania Kjellerup","key":"lindpau","last":"Lind","name":"Lind, Tania Kjellerup","rank":3,"rolecode":"pau"},{"affno":"1 3","first":"Marina Robertnova","key":"kasimovapau","last":"Kasimova","locid":"4ca53008-d035-460e-868f-c9a086f0e3a7","name":"Kasimova, Marina Robertovna","name_org":"Kasimova, Marina Robertnova","rank":4,"rolecode":"pau"},{"affno":"1","first":"Malene Vinther","key":"christensenpau","last":"Christensen","locid":"bd6e114b-d83c-44d7-bc7c-86abee0965a1","name":"Christensen, Malene Vinther","rank":5,"rolecode":"pau"},{"affno":"1","first":"Maria Høtoft","key":"michaelsenpau","last":"Michaelsen","locid":"3d3d793e-ad95-4b58-a988-700c8f1d0fe5","name":"Michaelsen, Maria Høtoft","rank":6,"rolecode":"pau"},{"affno":"4","first":"Richard A","key":"campbellpau","last":"Campbell","name":"Campbell, Richard A","rank":7,"rolecode":"pau"},{"affno":"1","first":"Lene","key":"jorgensenpau","last":"Jorgensen","locid":"d44a0998-9a19-40de-8d46-eb4234a9d3c4","name":"Jørgensen, Lene","name_org":"Jorgensen, Lene","rank":8,"rolecode":"pau"},{"affno":"1","first":"Henrik","key":"franzykpau","last":"Franzyk","locid":"5120ce68-6886-4ac8-8178-310a47d19261","name":"Franzyk, Henrik","orcid":