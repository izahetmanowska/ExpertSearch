es":"26","publisher":"Danish Environmental Protection Agency","repno":"Pesticides Research - Report for the Danish EPA, No. 194","series":"Pesticides Research - Report for the Danish EPA","status":"p"},"review":"No Review","sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-c6f16259-9496-4048-9db1-c3e52499b396"],"src":["DTU Technical University of Denmark"],"title":"Effects of glyphosate of the intestinal microbiota","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-729976","year":"2021","yearsub":"2022"}
{"abstract":"Up to 10% of hospitalised patients are registered as penicillin allergic. However, 80-90% will tolerate penicillin after evaluation. New Danish guidelines suggest criteria for evaluation of patients based on risk stratification according to the severity of the index reaction. The allergy label can be removed immediately, if allergy can be ruled out using the criteria presented in this review, but all other patients should be referred for evaluation in a specialist allergy department. Specific IgE measurement should only be done in adult patients with an immediate reaction (onset less-than 2 h after intake of a tablet) or urticaria.","author_count":6,"contributors":["Tannert, Line Kring","Mosbech, Holger","Hjortlund, Janni","Hjerrild, Britta","Nielsen, Lars Peter","Garvey, Lene Heise"],"cuid":["S02-084.61-044898"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Tannert, Line Kring"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR"],"OT":["Lægerne Vesterbrogade, København"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"udredning af penicillinallergi","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://ugeskriftet.dk/files/scientific_article_files/2020-06/v02200116_web.pdf","version":"Published Version"},"id":"S02-084.61-044898","identifier":[{"id":"85124766566","type":"scopus"},{"id":"32734861","type":"pmid"},{"id":"85088883722","type":"scopus"}],"ids":["ku-a1542079-b17a-4c1e-b52c-2718fa03df74","sdu-0e18baf4-5fc4-44fc-a6d6-dcd900c27cf1"],"lang":"Danish","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-3-F0A2BD