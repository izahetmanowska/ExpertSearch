d":"ff1299e4-49ee-4f85-9b71-23594688783f","name":"Pedersen, Sedsel Kristine Stage","orcid":"0000-0003-4616-2382","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mille","key":"thastumpau","last":"Thastum","locid":"c3813500-c313-4961-a854-ad2dba72d7d9","name":"Thastum, Mille","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Erhard Trillingsgaard","key":"næssschmidtpau","last":"Næss-Schmidt","locid":"c1a1a6b6-deb0-4e07-8cc0-f7d3beeaca85","name":"Næss-Schmidt, Erhard Trillingsgaard","orcid":"0000-0002-2539-0362","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lene","key":"odgaardpau","last":"Odgaard","locid":"1b80fe7b-ba0a-45b3-aca1-48bc19a97a44","name":"Odgaard, Lene","orcid":"0000-0002-9830-3282","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hanne","key":"pallesenpau","last":"Pallesen","locid":"4a0d3edf-5b53-46f4-8396-5301309b5131","name":"Pallesen, Hanne","orcid":"0000-0001-6010-2306","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jørgen Feldbæk","key":"nielsenpau","last":"Nielsen","locid":"3fb25b9f-381b-44a6-a8dd-26eacf839d37","name":"Nielsen, Jørgen Feldbæk","orcid":"0000-0001-5339-171X","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Iris","key":"brunnerpau","last":"Brunner","locid":"d1e88a58-cd2f-4fd0-a2f3-2cee204ba1ab","name":"Brunner, Iris","orcid":"0000-0002-7194-3087","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Noah D.","key":"silverbergpau","last":"Silverberg","name":"Silverberg, Noah D.","rank":8,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-a7f91b5c-9b1f-46a2-af21-9b3ba9f168b3"],"src":["AU Aarhus University"],"title":"Development of the intervention \"Get going After concussIoN Lite\" (GAIN Lite) to reduce impairing post-concessional mild-to-moderate symptoms in adults - A Feasibility Study","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-694082","year":"2023","yearsub":"2023"}
{"abstract":"Skin electrical properties play a significant role in recording biopotentials by using electrophysiological sensors. To test and evaluate sensor systems, it is commonly accepted to employ artificial skin models due to complications associated with testing on living tissues. The first goal of this Review is to provide a systematic understanding of the relation between skin structure and skin electrochemical behavior at an appropriate depth for electrophysiological sensing applications through a focus on skin structure, electrochemical properties of skin, and theoretical models (equivalent circuits) representing skin electrochemical behavior. The second goal is to review artificial skin models mimicking the electrochemical properties of skin and to give suggestions for future studies on relevant skin models based on a comparison between the behavior of skin and that of artificial skin models. The Review aims to help the reader to analyze the relation between the structure, elements of the equivalent circuits, and the resulting impedance data for both skin and artificial skin models.","author_count":7,"contributors":["Ehtiati, Koosha","Eiler, Johannes","Bochynska, Agnieszka","Nissen, Louis Lech","Strøbech, Esben","Nielsen, Lene Feldskov","Thormann, Esben"],"cuid":["S01-000.00-695194"],"filters":{"added":"2023-11","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Thormann, Esben"],"keyword":["Electrode−skin interface"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-COLO"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-PR-COLO","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"skin and artificial skin models in electrical sensing applications","src":["dtu"],"src-code":["DI-U-DTU"],"type":"djr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/337903250/ACS_ABM_2023_6_3033-3051.pdf","version":"Authors Final Version"},"funding_acknowledgement":["The authors gratefully acknowledge financial support from Innovation Fund Denmark (Grand Solutions Project #0175-00008B)."],"id":"S01-000.00-695194","identifier":[{"id":"85168428515","type":"scopus"},{"id":"37552576","type":"pmid"}],"ids":["dtu-f72d49ed-e22c-4036-bba0-23dac16fb521"],"keyword":["Artificial skin models","Electrode−skin interface","Electrophysiological sensors","Skin equivalent circuits","Skin impedance"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-A7FBE162C50F1651EEA09AA84E3BE7DE"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/337903250/ACS_ABM_2023_6_3033-3051.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Chemistry"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"coloplast","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-COLO","l3nl":"Coloplast Group","l3nn":"Coloplast","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Coloplast","namevar":["Coloplast Danmark AS"],"nora_code":"DI-PR-COLO","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Koosha","key":"ehtiatipau","last":"Ehtiati","locid":"f91ee37f-d0bf-4bf4-a4c4-17946961553b","name":"Ehtiati, Koosha","orcid":"0000-0002-0486-9497","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Johannes","key":"eilerpau","last":"Eiler","locid":"599a6211-ff15-4771-8d28-5c5b4cce809e","name":"Eiler, Johannes","orcid":"0000-0002-4388-9108","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Agnieszka","ke