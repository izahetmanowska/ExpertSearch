","Nordic","OECD"],"name":"Other Hospitals","namevar":["Center for Klinisk Forskning"],"nora_code":"DI-HO-OTH","used":1},{"affno":"3","country":"dk","key":"north denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-NDR","l3nl":"North Denmark Region","l3nn":"North Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"North Denmark Region","namevar":["Regionshospital Nordjylland"],"nora_code":"DI-HO-NDR","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Daniel Krag","key":"nielsendanielkragpau","last":"Nielsen","locid":"4cb43f22-6611-4ae7-af03-b9c601b92e43","name":"Nielsen, Daniel Krag","orcid":"0000-0002-6180-6716","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Sofie Ladekarl","key":"christiansensofieladekarlpau","last":"Christiansen","name":"Christiansen, Sofie Ladekarl","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Karin Dam","key":"eikhofkarindampau","last":"Eikhof","locid":"9f7d4681-4cfa-4465-86cb-31cecbc41e08","name":"Eikhof, Karin Dam","orcid":"0000-0001-5736-353X","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Lene Torp","key":"hansenlenetorppau","last":"Hansen","name":"Hansen, Lene Torp","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Marianne","key":"hollandmariannepau","last":"Holland","name":"Holland, Marianne","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Charlotte","key":"holmcharlottepau","last":"Holm","name":"Holm, Charlotte","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Tina","key":"ibsentinapau","last":"Ibsen","name":"Ibsen, Tina","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ann Karenina Kløve","key":"møllerannkareninakløvepau","last":"Møller","locid":"ad0049a5-63d3-4fcd-a2e7-85d8bbb0820a","name":"Møller, Ann Karenina Kløve","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kirstine Cecilia Ladefoged","key":"nielsenkirstinececilialadefogedpau","last":"Nielsen","locid":"11855d50-6bf0-4ad0-b582-eeb1b7f6d6b7","name":"Nielsen, Kirstine Cecilia Ladefoged","orcid":"0009-0000-8631-4024","rank":9,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Anette","key":"ørtoftanettepau","last":"Ørtoft","name":"Ørtoft, Anette","rank":10,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Anne","key":"aarøannepau","last":"Aarø","name":"Aarø, Anne","rank":11,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mona Kyndi","key":"pedersenmonakyndipau","last":"Pedersen","name":"Pedersen, Mona Kyndi","rank":12,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Hospitals","All University Colleges","DI-ALL","DI-HO","DI-HO-ALL","DI-UC","DI-UC-ALL","Hospitals","North Denmark Region","Other Hospitals","University College of Northern Denmark","University Colleges","center for klinisk forskning"],"PST":["Published"]},"sid":["ucn-0c5146de-e4dd-4aea-b243-c59bdd30b333"],"src":["UCN University College of Northern Denmark"],"title":"Improving the involvement of relatives in a Danish hospital context : experiences from utilizing user involving workshops","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-715097","year":"2023","yearsub":"2023"}
{"abstract":"Background and aims: Tumour necrosis factor-α (TNF) antagonists have improved the management of inflammatory bowel disease (IBD), however, their usage and administration persist to be suboptimal. Here, we examined the relationship between tissue-specific TNF mRNA expression in mucosal biopsies from IBD patients and anti-TNF treatment response. Methods: Archived tissue samples from patients with luminal IBD that had all been or were in treatment with anti-TNF were included (18 adults and 24 paediatric patients). Patients were stratified into three groups according to anti-TNF response: responders, primary non-responders (PNR) and secondary loss of response (SLOR). TNF mRNA was detected using RNAscope in situ hybridisation (ISH) and the expression was quantified using image analysis. Results: The ISH analysis showed varying occurrence of TNF mRNA positive cells located in lamina propria and often with increased density in lymphoid follicles (LF). Consequently, expression estimates were obtained in whole tissue areas with and without LF. Significantly higher TNF mRNA expression levels were measured in adults compared to paediatric patients in both the analyses with and without LF (p =.015 and p =.016, respectively). Considering the relation to response, the adult and paediatric patients were evaluated separately. In adults, the TNF expression estimates were higher in PNRs compared to responders with and without LF (p =.017 and p =.024, respectively). Conclusion: Our data indicate that adult PNR have significantly higher TNF mRNA levels than responders. This suggests that higher anti-TNF dose may be considered for IBD patients with high TNF mRNA expression estimates from the start of treatment.","author_count":6,"contributors":["James, Jaslin P.","Nielsen, Boye Schnack","Langholz, Ebbe","Malham, Mikkel","Høgdall, Estrid","Riis, Lene Buhl"],"cuid":["S01-000.00-721035"],"filters":{"added":"2024-02","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Image analysis","Inflammation","Tumour necrosis factor"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GTS","DI-HO","DI-U"],"level3":{"GTS":["DI-GTS-ALL","DI-GTS-BION"],"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-GTS-BION","DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"estimating tissue specific tnf mrna levels prior to anti tnfα treatment may support therapeutic optimisation in ibd patients","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1080/00365521.2023.2217313","version":"Published Version"},"id":"S01-000.00-721035","identifier":[{"id":"37246424","type":"pmid"},{"id":"85161063064","type":"scopus"}],"ids":["ku-8ad2d4d0-a73b-4310-b90c-76932ac662c2"],"keyword":["Image analysis","Paediatric IBD","Tumour necrosis factor","inflammation","lymphoid follicle","mucosal TNF mRNA","quantitative in situ hybridisation","treatment non-response"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-C1CBFD8467A4373C605EB45A06216BEA"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/375297888/Estimating_tissue_specific_TNF_mRNA_levels_prior_to_anti_TNF_treatment_may_support_therapeutic_optimisation_in_IBD_patients.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1080/00365521.2023.2217313","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Herlev and Gentofte"],"nora_code":"DI-HO-CAP","used":1},{