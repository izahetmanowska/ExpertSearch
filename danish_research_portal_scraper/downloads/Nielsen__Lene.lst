affno":"2","corresponding":null,"first":"TW","key":"klausentwpau","last":"Klausen","name":"Klausen, TW","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ida Bruun","key":"kristensenidabruunpau","last":"Kristensen","locid":"f1240a4e-c041-4d50-8ec5-5aa78f91c176","name":"Kristensen, Ida Bruun","orcid":"0000-0001-8605-9422","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Ulf Christian","key":"frølundulfchristianpau","last":"Frølund","name":"Frølund, Ulf Christian","rank":4,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"N. F.","key":"andersennfpau","last":"Andersen","name":"Andersen, N. F.","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"C L","key":"andersenclpau","last":"Andersen","name":"Andersen, C L","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Annette Juul","key":"vangstedannettejuulpau","last":"Vangsted","name":"Vangsted, Annette Juul","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Niels","key":"abildgaardnielspau","last":"Abildgaard","locid":"595418b9-29f8-4fd3-8663-1b32eab3451a","name":"Abildgaard, Niels","orcid":"0000-0001-6852-2014","rank":8,"rolecode":"pau"},{"affno":"4 5 6","corresponding":null,"first":"Henrik","key":"gregersenhenrikpau","last":"Gregersen","name":"Gregersen, Henrik","rank":9,"rolecode":"pau"}],"pub":{"issn":["25729241"],"issue":"Suppl. 1","journal":"HemaSphere","pages":"659-660","paperid":"PS1440","publisher":"Wiley","status":"p","title":"HemaSphere","volume":"2"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Region Zealand","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-e479e9d4-008c-4544-a861-72f9abd5e04d"],"src":["SDU University of Southern Denmark"],"title":"Clarithromycin added to the VCD regimen causes reduced health-related quality of life in multiple myeloma patients","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-638631","year":"2018","yearsub":"2018"}
{"abstract":"Importance: Hospital readmissions are common among patients receiving multiple medications, with considerable costs to the patients and society. Objective: To determine whether a multifaceted pharmacist intervention based on medication review, patient interview, and follow-up can reduce the number of readmissions and emergency department (ED) visits. Design, Setting, and Participants: This randomized clinical multicenter study (Odense Pharmacist Trial Investigating Medication Interventions at Sector Transfer [OPTIMIST]) enrolled patients from September 1, 2013, through April 23, 2015, with a follow-up of 6 months completed on October 31, 2015. Consecutive medical patients in an acute admission ward who were 18 years or older and who used 5 or more medications were invited to participate. Of 1873 patients invited to participate, 1499 (80.0%) accepted. The medication review and patient interview were conducted in the hospital and followed up in collaboration with primary care. Analysis was based on intention to treat. Interventions: The patients were randomized into 3 groups receiving usual care (no intervention), a basic intervention (medication review), and an extended intervention (medication review, 3 motivational interviews, and follow-up with the primary care physician, pharmacy, and nursing home). Main Outcomes and Measures: The prespecified primary outcomes were readmission within 30 or 180 days and ED visits within 180 days. The primary composite end point was readmission or an ED visit within 180 days. Secondary outcomes were drug-related readmissions within 30 and 180 days after inclusion, and all-cause mortality and drug-related mortality. Results: A total of 1467 patients (679 men [46.3%] and 788 women [53.7%]; median age, 72 years; interquartile range, 63-80 years) were part of the primary analysis, including 498 randomized to usual care, 493 randomized to the basic intervention, and 476 randomized to the extended intervention. The extended intervention had a significant effect on the numbers of patients who were readmitted within 30 days (hazard ratio [HR], 0.62; 95% CI, 0.46-0.84) or within 180 days (HR, 0.75; 95% CI, 0.62-0.90) after inclusion and on the number of patients who experienced the primary composite end point (HR, 0.77; 95% CI, 0.64-0.93). The study showed a nonsignificant reduction in drug-related readmissions within 30 days (HR, 0.65; 95% CI, 0.39-1.09) and within 180 days (HR, 0.80; 95% CI, 0.59-1.08) after inclusion and in deaths (HR, 0.83; 95% CI, 0.22-3.11). The number needed to treat to achieve the primary composite outcome for the extended intervention (vs usual care) was 12. Conclusions and Relevance: A multifaceted clinical pharmacist intervention may reduce the number of ED visits and hospital readmissions. Trial Registration: clinicaltrials.gov Identifier: NCT03079375.","author_count":10,"contributors":["Ravn-Nielsen, Lene Vestergaard","Duckert, Marie Louise","Lund, Mia Lolk","Henriksen, Jolene Pilegaard","Nielsen, Michelle Lyndgaard","Eriksen, Christina Skovsende","Buck, Thomas Croft","Pottegård, Anton","Hansen, Morten Rix","Hallas, Jesper"],"cuid":["S01-000.00-640442"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Ravn-Nielsen, Lene Vestergaard"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-SDR"],"OT":["St Thomas Pharmacy, Vejle, Denmark"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-SDR","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"effect of an in hospital multifaceted clinical pharmacist intervention on the risk of readmission a randomized clinical trial","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/151774380/jamainternal_ravnnielsen_2018_oi_170128_2_.pdf","version":"Published Version"},"funding_acknowledgement":["reported receiving grants from the Hospitals Pharmacies’ and Amgros’ Research Development Foundation, 2 public regional foundations, and the Actavis Foundation during the conduct of the study. Dr Hansen reported receiving grants from Menarini and Pfizer unrelated to this project and personally receiving fees from the Danish Association of Pharmaceutical Manufacturers. Dr Hallas reported participating in research projects funded by Novartis, Pfizer, Menarini, MSD, Nycomed, Leo Pharmaceuticals, Astellas, and Alk-Abelló with grants paid to the institution where he was employed and personally receiving fees from the Danish Association of Pharmaceutical Manufacturers, Pfizer, and Menarini unrelated to this project. No other disclosures were reported. Funding/Support: This study was supported by unrestricted grants from The Hospitals Pharmacies’ and Amgros’ Research Development Foundation, public regional research foundations for Southern Denmark and Zealand, and the Actavis Foundation."],"id":"S01-000.00-640442","identifier":[{"id":"85042937446","type":"scopus"},{"id":"29379953","type":"pmid"},{"id":"PMC5885912","type":"pmcid"}],"ids":["sdu-eac12809-6bad-4807-9614-2fadefc5cc66"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-C6E9F07B111A3C2BE549EE6E016B8E06"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/151774380/jamainternal_ravnnielsen_2018_oi_170128_2_.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2018","yearSub":"2018"},"org":[{"affno":"1","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Psykiatrisk Center Glostrup"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["St Thomas Pharmacy, Vejle, Denmark"],"nora_code":"DI-OT","used":1},{"affno":"4","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Public Health, Clinical Pharmacology and Pharmacy"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lene Vestergaard","key":"ravnnielsenpau","last":"Ravn-Nielsen","name":"Ravn-Nielsen, Lene Vestergaard","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marie Louise","key":"duckertpau","last":"Duckert","name":"Duckert, Marie Louise","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mia Lolk","key":"lundpau","last":"Lund","name":"Lund, Mia Lolk","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jolene Pilegaard","key":"henriksenpau","last":"Henriksen","name":"Henriksen, Jolene Pilegaard","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Michelle Lyndgaard","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Michelle Lyndgaard","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Christina Skovsende","key":"eriksenpau","last":"Eriks