{"author_count":7,"contributors":["Nilsson, Ingrid M S","Aaskov, Mette","Schack-Nielsen, Lene","Jerris, Tine"],"cuid":["S01-000.00-207042"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Amning","Anbefalinger"],"level":"pop","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"und","rtype":["clu"],"sorti":"amning en håndbog for sundhedspersonale","src":["au"],"src-code":["DI-U-AU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://sundhedsstyrelsen.dk/~/media/179EA85F7F1B4A48A97E908AC2FA9012.ashx","version":"Published Version"},"id":"S01-000.00-207042","ids":["au-88294982-f1f2-4873-b0cf-7204d860d72c"],"keyword":["Amning","anbefalinger"],"lang":"Danish","level":"Popular","mra":["Medical Science"],"noi":["Local-1-1-2BA608C8EBD2F2482BF3FA136557CEBF"],"oa_link":[{"access":"oa","type":"rem","url":"https://sundhedsstyrelsen.dk/~/media/179EA85F7F1B4A48A97E908AC2FA9012.ashx","version":"Published Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Public Health, Department of Public Health - Department of Science in Nursing"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Ingrid","key":"nilssonpau","last":"Nilsson","locid":"f5d33686-f1e8-4012-bb9d-3e4497c4d0bd","name":"Nilsson, Ingrid M S","name_org":"Nilsson, Ingrid","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Mette","key":"aaskovpau","last":"Aaskov","name":"Aaskov, Mette","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Lene","key":"schacknielsenpau","last":"Schack-Nielsen","name":"Schack-Nielsen, Lene","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Tine","key":"jerrispau","last":"Jerris","name":"Jerris, Tine","rank":4,"rolecode":"pau"},{"affno":"","first":"Annette","key":"poulsenpedh","last":"Poulsen","name":"Poulsen, Annette","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Christine","key":"brotpedh","last":"Brot","name":"Brot, Christine","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Birgitte","key":"dansgaardpedh","last":"Dansgaard","name":"Dansgaard, Birgitte","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"edition":"3","eisbn":["9788771045253"],"isbn":["9788771045291"],"place":"København","publisher":"Sundhedsstyrelsen","status":"p","title":"Amning - en håndbog for sundhedspersonale"},"review":"Undetermined","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-88294982-f1f2-4873-b0cf-7204d860d72c"],"src":["AU Aarhus University"],"title":"Amning - en håndbog for sundhedspersonale","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-207042","year":"2013","yearsub":"2013"}
{"abstract":"Nogle af de grundlæggende spørgsmål for de fleste virksomheder er, hvem de er og hvad de står for sammenlignet med andre. Hvor kommer virksomheden fra og hvordan påvirker det, hvem den bliver fremover? Det studeres ofte som spørgsmål om virksomhedens identitet. Identiteten er uløseligt forbundet med virksomhedens oprindelse. Men den udvikler sig over tid, og store skift i virksomhedens strategi, markeder eller teknologi stiller krav til ændringer i dens selvforståelse.","author_count":4,"contributors":["Schultz, Majken"],"cuid":["S01-000.00-295262"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"pop","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-CBS"]},"level3all":["DI-U-CBS"]},"review":"und","rtype":["clu"],"sorti":"aktiv brug af virksomhedens historie","src":["cbs"],"src-code":["DI-U-CBS"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://issuu.com/carlsbergfondet/docs/aarsskrift_2013_web?e=30996217/52862599","version":"Published Version"},"id":"S01-000.00-295262","ids":["cbs-d0db8277-0016-4678-acde-16e7cea4b393"],"lang":"Danish","level":"Popular","mra":["Social Science"],"noi":["Local-1-1-B2A09F0A68678DCD091E621F5145E5C8"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://issuu.com/carlsbergfondet/docs/aarsskrift_2013_web?e=30996217/52862599","version":"Published Version"}],"org":[{"affno":"1","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, Department of Organization"],"nora_code":"DI-U-CBS","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk