 Læger","volume":"176"},"review":"Peer Reviewed","scoID":["2-s2.0-84900329953","2-s2.0-85040608188"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-b1890891-5db6-4708-a62d-9a138f409a49","ku-28acd6cf-40e2-4cdf-9bc6-9fdf8c5401bc"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Arbejdsrettet Rehabilitering","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-096.43-025616","year":"2014","yearsub":"2014"}
{"abstract":"OBJECTIVE: The aim of the present article is to describe the face and content validity as well as reliability of the Copenhagen Social Relations Questionnaire (CSRQ). METHOD: The face and content validity test was based on focus group discussions and individual interviews with 31 informants. Another 94 men and women participated in an 8-day test-retest analysis. RESULTS: Informants generally expressed that the questions and response categories were relevant and easy to understand. Themes on structure of social relations, social support, and negative aspects of social relations emerged clearly from the interviews. Two additional themes not covered by CSRQ on dynamics and reciprocity of social relations were identified. DISCUSSION: CSRQ holds satisfactory face and content validity as well as reliability, and is suitable for measuring structure and function of social relations including the negative aspects among middle-aged individuals.","author_count":6,"contributors":["Lund, Rikke","Nielsen, Lene Snabe","Henriksen, Pia Wichmann","Schmidt, Lone","Avlund, Kirsten","Christensen, Ulla"],"cuid":["S02-098.91-046107"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Denmark","Female","Focus Groups","Humans","Interpersonal Relations","Male","Middle Aged","Qualitative Research","Questionnaires","Reproducibility of Results","Social Support"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"content validity and reliability of the copenhagen social relations questionnaire","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1177/0898264313510033","version":"Other Version"},"id":"S02-098.91-046107","identifier":[{"id":"24584264","type":"pmid"},{"id":"84897672628","type":"scopus"}],"ids":["ku-c7299eab-bfdd-4f3a-80b6-f9d1dbf4fcec","sdu-b1ee39bc-882b-4016-a97a-2699f33596d0"],"keyword":["Denmark","Female","Focus Groups","Humans","Interpersonal Relations","Male","Middle Aged","Qualitative Research","Questionnaires","Reproducibility of Results","Social Support"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-E634388E947D0F96AFD129DF811FAFAE"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1177/0898264313510033","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Center for Healthy Ageing, Web Track 2: Retirement and transitions","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Section of Social Medicine","University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, National Institute of Public Health, Children health"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","first":"Rikke","key":"lundpau","last":"Lund","locid":"ffd99d7e-c38d-413f-9761-cb8b1c770e7d","name":"Lund, Rikke","orcid":"0000-0002-0381-4291","rank":1,"rolecode":"pau"},{"affno":"","first":"Lene Snabe","key":"nielsenpau","last":"Nielsen","locid":"ae798efe-b073-4193-b107-b3e5edd9d6b6","name":"Nielsen, Lene Snabe","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Pia Elena Wichmann","key":"henriksenpau","last":"Henriksen","locid":"3998b14a-c018-4a69-8348-03499fa0dc79","name":"Henriksen, Pia Elena Wichmann","rank":3,"rolecode":"pau"},{"affno":"1","first":"Lone","key":"schmidtpau","last":"Schmidt","locid":"5f2dcc97-1887-47eb-8a0a-662e840273df","name":"Schmidt, Lone","orcid":"0000-0002-9518-1734","rank":4,"rolecode":"pau"},{"affno":"1","first":"Kirsten","key":"avlundpau","last":"Avlund","locid":"1f44c09a-eda8-4efb-a148-33cdc9fcd13a","name":"Avlund, Kirsten","rank":5,"rolecode":"pau"},{"affno":"1","first":"Ulla","key":"christensenpau","last":"Christensen","locid":"19ca6c9f-ed56-42e1-877c-083d35bb644d","name":"Christensen, Ulla","orcid":"0000-0001-7797-6640","rank":6,"rolecode":"pau"}],"pmid":["24584264"],"pub":{"doi":"10.1177/0898264313510033","issn":["08982643","15526887"],"issn_org":["08982643"],"issue":"1","journal":"Journal of Aging and Health","pages":"128-150","publisher":"SAGE Publications","status":"p","title":"Journal of Aging and Health","volume":"26"},"review":"Peer Reviewed","scoID":["2-s2.0-84897672628"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-c7299eab-bfdd-4f3a-80b6-f9d1dbf4fcec","sdu-b1ee39bc-882b-4016-a97a-2699f33596d0"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Content validity and reliability of the Copenhagen social relations questionnaire","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-098.91-046107","year":"2014","yearsub":"2014"}
{"abstract":"OBJECTIVES:: To investigate single-nucleotide polymorphisms (SNPs) in the gene encoding interleukin-7 receptor α (IL7RA) as predictors for CD4 T-cell change after initiation of combination antiretroviral therapy (cART) in HIV-infected whites. DESIGN:: SNPs in IL7RA were determined in the Danish HIV Cohort Study. METHODS:: CD4 T-cell changes were estimated 6 months, 1, 2, and 5 years after initiation of cART in 1683 HIV-infected virally suppressed individuals. Five SNPs in IL7RA were examined as predictors for CD4 T-cell change in the first (0-6 months after initiation of cART) and second phase (>6 months after initiation of cART) of immune recovery. Univariable and multivariable analyses including age, sex, calendar period, CD4 nadir, and baseline CD4 T-cell count and viral load as covariates were performed. RESULTS:: Individuals carrying two T-alleles in rs6897932 had faster CD4 T-cell recovery compared with individuals carrying a C-allele in the first phase of immune recovery [mean CD4 T-cell change, cells/μL (95% confidence interval), in TT: 177 (151-203), CT: 131 (119-143), CC: 141 (132-151), P = 0.018]. No isolated effect of rs6897932 on CD4 T-cell change was found in the second phase of immune recovery; however, the initial difference in CD4 T-cell recovery remained during 5 years. The effect was most pronounced in individuals above 40 years of age. CONCLUSION:: T-allele homozygosity in rs6897932 is a predictor for faster CD4 T-cell recovery after initiation of cART in HIV-infected whites, however, only in the first phase of immune recovery.","author_count":12,"contributors":["Hartling, Hans J","Thørner, Lise W","Erikstrup, Christian","Harritshøj, Lene H","Kronborg, Gitte","Pedersen, Court","Larsen, Carsten Schade","Helleberg, Marie","Gerstoft, Jan","Obel, Niels","Ullum, Henrik","Nielsen, Susanne D"],"cuid":["S03-093.36-012869"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"keyword":["Combination antiretroviral therapy","Interleukin 7 receptor","Single nucleotide polymorphisms"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"polymorphism in interleukin 000000000007 receptor α gene is associated with faster cd000000000004 t cell recovery after initiation of combination antiretroviral therapy","src":["au","ku","sdu"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1097/QAD.0000000000000354","version":"Other Version"},"id":"S03-093.36-012869","identifier":[{"id":"84904160711","type":"scopus"},{"id":"24911352","type":"pmid"}],"ids":["au-03b2f01d-6c59-485c-a01c-31d8203864c4","ku-0b647c45-157d-493b-b4c3-aec7eb679833","sdu-1c723a51-b5d9-4aac-a76c-73f5573ef0b6"],"keyword":["HIV,immune recovery","combination antiretroviral therapy","interleukin-7 receptor","rs6897932","single-nucleotide polymorphisms"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-439C174A34A66C6FA6CE75448DF65F44"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1097/QAD.0000000000000354","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Clinical Immunology"],"nora_code":"DI-U-AU","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"4","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Infectious Diseases (Odense)"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Hans J","key":"hartlingpau","last":"Hartling","name":"Hartling, Hans J","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Lise W","key":"thørnerpau","last":"Thørner","name":"Thørner, Lise W","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Christian","key":"erikstruppau","last":"Erikstrup","locid":"523ae417-65a9-46aa-b665-0d88271dc0b9","name":"Erikstrup, Christian","orcid":"0000-0001-6551-6647","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Lene H","key":"harritshøjpau","last":"Harritshøj","name":"Harritshøj, Lene H","rank":4,"rolecode":"pau"},{"affno":"3","first":"Gitte","key":"kronborgpau","last":"Kronborg","locid":"6dfd64b6-b92a-46ff-9008-4c065e9cbddb","name":"Kronborg, Gitte","rank":5,"rolecode":"pau"},{"a