dk/search?modus=sin&s=LOI:S01-000.00-436437","year":"2012","yearsub":"2012"}
{"abstract":"The aim of this study was to examine regulatory T cells (Tregs) in peripheral blood and liver tissue in patients with chronic hepatitis C virus (HCV) mono-infection and in patients with HIV/HCV co-infection. In a cross-sectional study were included 51 patients with chronic HCV infection, 24 patients with HIV/HCV co-infection and 24 healthy individuals. CD4⁺ and CD8⁺ Tregs were determined using flow cytometry. Fibrosis was examined by transient elastography. Inflammation, fibrosis and Tregs were determined in liver biopsies from 12 patients. Increased frequency of CD4⁺ and CD8⁺ Tregs was found in HIV/HCV co-infected patients [median: 6.4% (IQR: 5.7-6.9) and 1.0% (0.7-1.2), respectively] compared to HCV mono-infected patients [5.6% (4.2-6.3), P = 0.01 and 0.5% (0.3-0.7), P < 0.001, respectively]. Furthermore, HCV mono-infected patients had increased frequencies of Tregs compared with healthy controls (P < 0.05). However, no associations between the frequency of Tregs and fibrosis were found. Furthermore, characterization of CD4⁺ Tregs using CD45RA demonstrated a higher frequency of activated Tregs in both HCV mono-infected and HIV/HCV co-infected patients compared with healthy controls. Finally, number of intrahepatic Tregs was associated with both peripheral CD8⁺ Tregs and intrahepatic inflammation. In conclusion, HCV mono-infected patients and particularly HIV/HCV co-infected patients have increased the frequency of CD4⁺ and CD8⁺ Tregs compared with healthy controls. Furthermore, CD4⁺ Tregs in infected patients displayed an active phenotype. Tregs were not associated with fibrosis, but a positive correlation between intrahepatic Tregs and inflammation was found. Taken together, these results suggest a role for Tregs in the pathogenesis of chronic HCV infection.","author_count":10,"contributors":["Hartling, Hans J","Gaardbo, Julie Christine","Ronit, A","Knudsen, Lene Surland","Ullum, Henrik","Vainer, Ben","Clausen, M R","Skogstrand, K","Gerstoft, Jan","Nielsen, Sabine Dahl"],"cuid":["S01-000.00-443376"],"filters":{"added":"2022-04","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["CD4 Positive T Lymphocytes","CD8 Positive T Lymphocytes","Coinfection","Cross Sectional Studies","Elasticity Imaging Techniques","Female","Fibrosis","Flow Cytometry","HIV Infections","Hepatitis C Chronic","Humans","Liver","Male","Middle Aged","Phenotype","T Lymphocytes Regulatory"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"cd000000000004 and cd000000000008 regulatory t cells tregs are elevated and display an active phenotype in patients with chronic hcv mono infection and hiv hcv co infection","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1111/j.1365-3083.2012.02725.x","version":"Other Version"},"id":"S01-000.00-443376","identifier":[{"id":"84865348532","type":"scopus"},{"id":"22671952","type":"pmid"}],"ids":["ku-53a85ce0-1ab5-4009-9433-4e20e084527c"],"keyword":["CD4-Positive T-Lymphocytes","CD8-Positive T-Lymphocytes","Coinfection","Cross-Sectional Studies","Elasticity Imaging Techniques","Female","Fibrosis","Flow Cytometry","HIV Infections","Hepatitis C, Chronic","Humans","Liver","Male","Middle Aged","Phenotype","T-Lymphocytes, Regulatory"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-15E692F6A62920CE762F4ABC4597F4A4"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1111/j.1365-3083.2012.02725.x","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2012","yearSub":"2013"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1 2","first":"H J","key":"hartlingpau","last":"Hartling","locid":"e6ddd04b-6d00-4afe-9cda-cbd2a1f1e036","name":"Hartling, Hans J","name_org":"Hartling, H J","rank":1,"rolecode":"pau"},{"affno":"","first":"J C","key":"gaardbopau","last":"Gaardbo","locid":"771f3697-6993-4a7d-a698-fe9f1c59a812","name":"Gaardbo, Julie Christine","name_org":"Gaardbo, J C","rank":2,"rolecode":"pau"},{"affno":"","first":"A","key":"ronitpau","last":"Ronit","name":"Ronit, A","rank":3,"rolecode":"pau"},{"affno":"","first":"L S","key":"knudsenpau","last":"Knudsen","locid":"97a8e657-3fc3-4240-b2da-26a1a26439b9","name":"Knudsen, Lene Surland","name_org":"Knudsen, L S","rank":4,"rolecode":"pau"},{"affno":"1","first":"H","key":"ullumpau","last":"Ullum","locid":"ef594d49-5aeb-4d32-80b4-4bfc281b5cbb","name":"Ullum, Henrik","name_org":"Ullum, H","orcid":"0000-0001-7306-9058","rank":5,"rolecode":"pau"},{"affno":"1","first":"Ben","key":"vainerpau","last":"Vainer","locid":"87ab1fdc-ec92-4c01-87a4-3e4dcc3b8684","name":"Vainer, Ben","rank":6,"rolecode":"pau"},{"affno":"","first":"M R","key":"clausenpau","last":"Clausen","name":"Clausen, M R","rank":7,"rolecode":"pau"},{"affno":"","first":"K","key":"skogstrandpau","last":"Skogstrand","name":"Skogstrand, K","rank":8,"rolecode":"pau"},{"affno":"1","first":"J","key":"gerstoftpau","last"