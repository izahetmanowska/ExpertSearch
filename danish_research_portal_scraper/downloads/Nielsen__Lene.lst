havns Universitet, Faculty of Science, Department of Food Science, Food Microbiology, Gut Health, and Fermentation"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"James","key":"owusukwartengpau","last":"Owusu-Kwarteng","name":"Owusu-Kwarteng, James","rank":1,"rolecode":"pau"},{"affno":"2","first":"Kwaku","key":"tanodebrahpau","last":"Tano-Debrah","name":"Tano-Debrah, Kwaku","rank":2,"rolecode":"pau"},{"affno":"1","first":"Fortune","key":"akabandapau","last":"Akabanda","name":"Akabanda, Fortune","rank":3,"rolecode":"pau"},{"affno":"3","first":"Dennis Sandris","key":"nielsenpau","last":"Nielsen","locid":"08539a0e-05f4-454e-ad2a-de195363dbd1","name":"Nielsen, Dennis Sandris","orcid":"0000-0001-8121-1114","rank":4,"rolecode":"pau"},{"affno":"3","first":"Lene","key":"jespersenpau","last":"Jespersen","locid":"a156c6e3-9562-4d35-9305-53a39c62e076","name":"Jespersen, Lene","orcid":"0000-0002-2555-5948","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.5539/jfr.v2n1p50","issn":["19270887","19270895"],"issn_org":["19270887"],"issue":"1","journal":"Journal of Food Research","pages":"50-58","status":"p","title":"Journal of Food Research","volume":"2"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-6c21e14a-6e04-4dff-8ae6-c7b6eaf6e208"],"src":["KU University of Copenhagen"],"title":"Partial characterization of bacteriocins produced by<em> Lactobacillus reuteri</em> 2-20B and <em>Pediococcus acidilactici</em> 0-11A isolated from fura a millet-based fermented food in Ghana","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-458023","year":"2013","yearsub":"2013"}
{"abstract":"Membrane technology is a promising candidate for producing mineral fertilizers from animal slurry. This paper presents a combination of membrane technologies for processing digested slurry, lists retentions of nitrogen (N), phosphorus (P) and potassium (K) and evaluates the economic and technological potential of the processes presented. To increase the content of plant nutrients in mineral concentrates substantially, improved RO (reverse osmosis) or additional technology is required.","author_count":5,"contributors":["Camilleri Rumbau, Maria Salud","Norddahl, Birgir","Kjærhus Nielsen, Anne","Christensen, Knud Villy","Fjerbæk Søtoft, Lene"],"cuid":["S01-000.00-573323"],"event":{"end":"2013-06-05","place":"Paris, fr","start":"2013-06-03","title":"Ramiran 2013","year":"2013"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Fertiliser","Fertilizer","Manure treatment","Membrane technology","Nutrient recovery","Slurry separation","Techno economics"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-PR-OTH","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"comparative techno economical study between membrane technology systems for obtaining concentrated fertilizers from biogas plant effluents","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://ramiran.uvlf.sk/doc13/Proceeding_2013/documents/S8.19..pdf","version":"Published Version"},"id":"S01-000.00-573323","ids":["sdu-003f3601-065a-4a83-87f2-8ea4076217b0"],"keyword":["Manure treatment","Membrane technology","Slurry separation","fertiliser","fertilizer","nutrient recovery","techno-economics"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-63A2FF807CD269C429328A0584E11277"],"oa_link":[{"access":"oa","type":"rem","url":"http://ramiran.uvlf.sk/doc13/Proceeding_2013/documents/S8.19..pdf","version":"Published Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Engineering, Department of Green Technology (IGT)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["Renew Energy A/S"],"nora_code":"DI-PR-OTH","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Maria Salud","key":"camillerirumbaupau","last":"Camilleri Rumbau","locid":"f1be36ab-1c04-4c79-b44e-af1777d00fd4","name":"Camilleri Rumbau, Maria Salud","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Birgir","key":"norddahlpau","last":"Norddahl","locid":"536a0b41-cddd-414d-950d-c064201806a0","name":"Norddahl, Birgir","orcid":"0000-0002-9423-5411","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Anne","key":"kjærhusnielsenpau","last":"Kjærhus Nielsen","name":"Kjærhus Nielsen, Anne","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Knud Villy","key":"christensenpau","last":"Christensen","locid":"fb5c5bb9-b730-4f2c-ad6f-addb7e22d34f","name":"Christensen, Knud Villy","orcid":"0000-0002-1168-3308","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lene","key":"fjerbæksøtoftpau","last":"Fjerbæk Søtoft","locid":"00447b51-640b-4b39-a5d3-baca314204fd","name":"Fjerbæk Søtoft, Lene","rank":5,"rolecode":"pau"}],"pub":{"edition":"1","status":"p","title":"RAIMIRAN 2013 -15th International Conference Proceedings","volume":"1"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Other Companies","Private Research","Universities","University of Southern Denmark","renew energy a/s"],"PST":["Published"]},"sid":["sdu-003f3601-065a-4a83-87f2-8ea4076217b0"],"src":["SDU University of Southern Denmark"],"title":"Comparative techno-economical study between membrane technology systems for obtaining concentrated fertilizers from biogas plant effluents","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-573323","year":"2013","yearsub":"2013"}
{"abstract":"A techno-economic comparison of membrane technologies (microfiltration (MF), nanofiltration (NF) and reverse osmosis (RO)) and physico-chemical operations (struvite precipitation and ammonia stripping) for obtaining nutrient-rich fractions from biogas digestates, has been carried out. Four different treatments for the digestate including solid-liquid separation using a decanter centrifuge or a screw press are compared. A screw press followed by membrane technologies (treatment B) shows the best economical potential with a total potential of 4.9€/t feed. Keywords: Digested manure, nutrient recovery, membrane technology, techno-economics","author_count":5,"contributors":["Camilleri Rumbau, Maria Salud","Nielsen, Anna Kjærhus","Norddahl, Birgir","Christensen, Knud Villy","Fjerbæk Søtoft, Lene"],"cuid":["S01-000.00-602498"],"event":{"end":"2013-06-05","place":"Paris, fr","start":"2013-06-03","title":"Ramiran 2013","year":"2013"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-PR-OTH","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"comparative techno economical study between membrane technology systems for obtaining concentrated fertilizers from manure","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://ramiran.uvlf.sk/doc13/Proceeding_2013/documents/S8.19..pdf","version":"Published Version"},"id":"S01-000.00-602498","ids":["sdu-664b980f-2d1c-4ce2-82de-5fd7cfbb83a9"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-B0D8E33AF9452F2050C374D83CB6540F"],"oa_link":[{"access":"oa","type":"rem","url":"http://ramiran.uvlf.sk/doc13/Proceeding_2013/documents/S8.19..pdf","version":"Published Version"}],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Engineering, Department of Green Technology (IGT)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["Renew Energy A/S"],"nora_code":"DI-PR-OTH","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Maria Salud","key":"camillerirumbaupau","last":"Camilleri Rumbau","locid":"f1be36ab-1c04-4c79-b44e-af1777d00fd4","name":"Camilleri Rumbau, Maria Salud","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Anna Kjærhus","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Anna Kjærhus","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Birgir","key":"norddahlpau","last":"Norddahl","locid":"536a0b41-cddd-414d-950d-c064201806a0","name":"Norddahl, Birgir","orcid":"0000-0002-9423-5411","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Knud Villy","key":"christensenpau","last":"Christensen","locid":"fb5c5bb9-b730-4f2c-ad6f-addb7e22d34f","name":"Christensen, Knud Villy","orcid":"0000-0002-1168-3308","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lene","key":"fjerbæksøtoftpau","last":"Fjerbæk Søtoft","locid":"00447b51-640b-4b39-a5d3-baca314204fd","name":"Fjerbæk Søtoft, Lene","rank":5,"rolecode":"pau"}],"pub":{"edition":"1.","pages":"234","status":"p","title":"RAMIRAN 2013 Book of Abstracts","volume":"1"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Other Companies","Private Research","Universities","University of Southern Denmark","renew energy a/s"],"PST":["Published"]},"sid":["sdu-664b980f-2d1c-4ce2-82de-5fd7cfbb83a9"],"src":["SDU University of Southern Denmark"],"title":"Comparative techno-economical study between membrane technology systems for obtaining concentrated fertilizers from manure","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-602498","year":"2013","yearsub":"2013"}
{"abstract":"To implement rational pharmacotherapy in hospitals, it is important to develop, implement and evaluate hospital drug formularies (HDFs). A report from Denmark recommended standardizing activities of the drug and therapeutics committees (DTCs) in Denmark, but little is known about their current organization. The aim of the study was to describe the organization of DTCs in Denmark, how HDFs are developed and implemented, and to what extent policies that support the use of HDFs exist. A questionnaire was developed based on previous research and guidelines and contained 20 questions, which were divided into the following subjects: structure, activities, drug selection and implementation. The questionnaire was sent to the chairmen of the nine DTCs in Denmark. The response rate was 100% (9/9). The DTCs varied in structure and activities; meetings were held between 2 and 6 times annually, and the duration of the meetings lasted between 1 and 2.5 hr. Eight (89%) DTCs developed HDFs, policies and guidelines (P&Gs) that supported the use of HDFs. Eight (89%) had established criteria for inclusion of drugs on the HDFs, and seven had developed criteria for generic substitution and therapeutic interchange. The number of trade names on the HDFs varied between 116 and 1195. The nine DTCs in Denmark varied considerably regarding structure and activity. The main activity was to develop formularies, and most of the committees developed policies that supported medication use.","author_count":4,"contributors":["Plet, Hanne T.","Hallas, Jesper","Nielsen, Gitte S","Kjeldsen, Lene Juel"],"cuid":["S02-096.84-666015"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Cross Sectional Studies","Denmark","Drug Substitution","Drug therapy","Guidelines as Topic","Humans","Organizational Policy","Pharmacy and Therapeutics Committee","Questionnaires","Time Factors"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-OTH"],"U":["DI-U-AAU","DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-OTH","DI-U-AAU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"drug and therapeutics committees in danish hospitals a survey of organization activities and drug selection procedures","src":["aau","sdu"],"src-code":["DI-U-AAU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1111/bcpt.12028","version":"Other Version"},"id":"S02-096.84-666015","identifier":[{"id":"23107106","type":"pmid"},{"id":"84875058741","type":"scopus"},{"id":"WOS:000316217100008","type":"wos"}],"ids":["aau-efdfbd04-e2f4-432d-8e29-981d690a6a56","sdu-c298253e-4a30-4aa9-b09d-047c36402a21"],"keyword":["Cross-Sectional Studies","Cross-Sectional Studies Denmark Drug Substitution Drug Therapy/*standards *Formularies, Hospital *Guidelines as Topic Humans Organizational Policy Pharmacy and Therapeutics Committee/*organization & administration Questionnaires Time Factors","Denmark","Drug Substitution","Drug Therapy","Formularies, Hospital","Guidelines as Topic","Humans","Organizational Policy","Pharmacy and Therapeutics Committee","Questionnaires","Time Factors"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-2F8896E57D5CC68C9C0D62A89984DD0F"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1111/bcpt.12028","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinik Akut","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Klinisk Farmakologi [Klinik Akut]"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Public Health, Clinical Pharmacology and Pharmacy"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","country":"dk","key":"other hospitals","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-OTH","l3nl":"Other Hospitals","l3nn":"Other Hospitals","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Hospitals","namevar":["Klinisk Farmakologi"],"nora_code":"DI-HO-OTH","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Hanne T","key":"pletpau","last":"Plet","locid":"0df2aaa5-9380-43ba-b749-febb40cb7e1c","name":"Plet, Hanne T.","name_org":"Plet, Hanne T","rank":1,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"country":"dk","first":"J.","key":"hallaspau","last":"Hallas","locid":"1fc2d4e1-080d-4c53-bd96-63186af28ae9","name":"Hallas, Jesper","name_org":"Hallas, J.","orcid":"0000-0002-8097-8708","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Gitte S","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Gitte S","rank":3,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"L. J.","key":"kjeldsenpau","last":"Kjeldsen","locid":"b3d44e3d-440c-41f1-b52d-838b0338bf55","name":"Kjeldsen, Lene Juel","name_org":"Kjeldsen, L. J.","orcid":"0009-0008-2559-9319","rank":4,"rolecode":"pau"}],"pmid":["23107106"],"pub":{"doi":"10.1111/bcpt.12028","issn":["17427835"],"issn_org":["17427843"],"issue":"4","journal":"Basic & Clinical Pharmacology & Toxicology","pages":"264-9","publisher":"Wiley-Blackwell","status":"p","title":"Basic & Clinical Pharmacology & Toxicology","title_org":"Basic & Clinical Pharmacology & Toxicology Online","volume":"112"},"review":"Peer Reviewed","scoID":["2-s2.0-84875058741"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Other Hospitals","Universities","University of Southern Denmark","klinisk farmakologi"],"PST":["Published"]},"sid":["aau-efdfbd04-e2f4-432d-8e29-981d690a6a56","sdu-c298253e-4a30-4aa9-b09d-047c36402a21"],"src":["AAU Aalborg University","SDU University of Southern Denmark"],"title":"Drug and therapeutics committees in Danish hospitals : a survey of organization, activities and drug selection procedures","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-096.84-666015","year":"2013","yearsub":"2013"}
{"abstract":"Abstract Objective. To determine the effect of contingent electrical stimulation (CES) on jaw muscle activity during sleep in a double-blinded randomized controlled trial (RCT). Materials and methods. Eleven patients with myofascial TMD (mean age 37 years) and with a clinical diagnosis of bruxism were included. EMG activity (Grindcare®) was recorded from the anterior temporalis muscle during sleep and analyzed online. Jaw muscle activity related to clenching or grinding triggered an electrical square-wave pulse train (450 ms) adjusted to a clear, but non-painful intensity. TMD patients were randomized into two groups: active treatment with CES or no CES (placebo). Number of EMG episodes/hour sleep was the primary outcome parameter. The following variables were assessed as secondary outcome parameters; number of painful muscles, maximum pain-free jaw opening, characteristic pain intensity, depression scores and Oral Health Impact Profile scores. Numerical Rating Scale scores for self-reported pain and muscle tension were registered for at least 4 nights per week during the experiment. Results. The number of EMG episodes/hour sleep was significantly reduced (52 ± 12%) in the CES group during the sessions with CES (ANOVA: p = 0.021) compared to baseline. There were no significant differences in the secondary outcome parameters (ANOVA: p > 0.513) or pain or muscle tension scores between groups (p = 0.645). The average duration of sleep hours during the nights with and without CES was not significantly different (p = 0.646). Conclusions. These results demonstrate a significant inhibitory effect of CES on jaw muscle EMG activity during sleep in a RCT, but with no effects on self-reported pain.","author_count":5,"contributors":["Jadidi, Faramarz","Castrillon, Eduardo","Nielsen, Patricia Dreyer","Baad-Hansen, Lene","Svensson, Peter"],"cuid":["S01-000.00-168382"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Bruxism","Contingent electrical stimulation","EMG"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"effect of contingent electrical stimulation on jaw muscle activity during sleep a pilot study with a randomized controlled trial design","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3109/00016357.2012.741702","version":"Other Version"},"id":"S01-000.00-168382","identifier":[{"id":"23148551","type":"pmid"},{"id":"84883571610","type":"scopus"}],"ids":["au-448ce0a7-1f0c-4a37-ba83-93f850e103d6"],"keyword":["EMG","bruxism","contingent electrical stimulation","myofascial TMD"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-F99485335B7A5945E492E8E2B29C4391"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.3109/00016357.2012.741702","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Dentistry and Oral Health, Department of Dentistry and Oral Health - Section for Orofacial Pain and Jaw Function"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Faramarz","key":"jadidipau","last":"Jadidi","locid":"e1e9da15-d28e-4b6d-93e7-4032ca776c75","name":"Jadidi, Faramarz","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Eduardo E","key":"castrillonpau","last":"Castrillon","locid":"675ad127-3449-4289-9533-ba9a45cae3e5","name":"Castrillon, Eduardo","name_o