{"author_count":3,"contributors":["Andersen, Lotte Bøgh","Pedersen, Lene Holm","Westergaard-Nielsen, Niels"],"cuid":["S01-000.00-209442"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["soc"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-CBS"]},"level3all":["DI-U-AU","DI-U-CBS"]},"review":"pr","rtype":["clu"],"sorti":"ledelse belønning og præstationer version 000000000002 000000000000","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-209442","ids":["au-8c714a1e-ec88-4ed0-a9c0-b921bd0c007d"],"lang":"Danish","level":"Scientific","mra":["Social Science"],"noi":["Global-Local-3-4-A1F6E7B490537B21F17AC627028675B3"],"oai":{"class":"Blocked","mra":["Social Science (SOC)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus BSS, Department of Political Science"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"cbs copenhagen business school","l2":"DI-U","l2n":"Universities","l3":"DI-U-CBS","l3nl":"Copenhagen Business School","l3nn":"CBS Copenhagen Business School","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"CBS Copenhagen Business School","namevar":["Copenhagen Business School, CBS"],"nora_code":"DI-U-CBS","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Lotte Bøgh","key":"andersenpau","last":"Andersen","locid":"8123bba5-1c63-4ecc-ad9f-e9f8e08fdae8","name":"Andersen, Lotte Bøgh","orcid":"0000-0002-1127-7561","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lene Holm","key":"pedersenpau","last":"Pedersen","name":"Pedersen, Lene Holm","rank":2,