en","locid":"7af020b5-3cb6-48cf-9002-177bc56b36f3","name":"Thomsen, Iben Margrete","orcid":"0000-0001-7139-018X","rank":2,"rolecode":"pau"},{"affno":"1","first":"Erik Dahl","key":"kjærpau","last":"Kjær","locid":"e1bdaffb-0384-4159-aa20-a913a2cee948","name":"Kjær, Erik Dahl","orcid":"0000-0001-8624-1611","rank":3,"rolecode":"pau"},{"affno":"1","first":"Lene Rostgaard","key":"nielsenpau","last":"Nielsen","locid":"8e8b51ee-3f45-4ebe-b2fb-fa79f1256d08","name":"Nielsen, Lene Rostgaard","orcid":"0000-0002-7214-8691","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1111/j.1439-0329.2011.00725.x","issn":["14374781","14390329"],"issn_org":["14374781"],"issue":"1","journal":"Forest Pathology","pages":"69-74","status":"p","title":"Forest Pathology","volume":"42"},"review":"Peer Reviewed","scoID":["2-s2.0-84856262084"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-933541fb-f083-423a-ac4b-6b02ca301993"],"src":["KU University of Copenhagen"],"title":"Genetic resistance to <em>Hymenoscyphus pseudoalbidus</em> limits fungal growth and symptom occurrence in <em>Fraxinus excelsior</em>","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-481388","year":"2012","yearsub":"2012"}
