{"author_count":12,"contributors":["Nielsen, Klaus","Jørgensen, Christian Helms","Koudahl, Peter","Munk, Martin David","Jensen, Torben Pilegaard","Pedersen, Lene Tanggaard","Grønborg, Lisbeth","Hvitved, Louise","Ingemann, Lene","Jonasson, Charlotte","Lippke, Lena"],"cuid":["S03-088.46-025562"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"keyword":["Erhvervsuddannelser"],"level":"sci","mra":["hum","soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-OT","DI-U","DI-UC"],"level3":{"GV":["DI-GV-ALL","DI-GV-VIVE"],"HO":["DI-HO-ALL","DI-HO-CDR"],"OT":["Unspecified organisation"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-RUC"],"UC":["DI-UC-ALL","DI-UC-KP"]},"level3all":["DI-GV-VIVE","DI-HO-CDR","DI-U-AAU","DI-U-AU","DI-U-RUC","DI-UC-KP"]},"review":"pr","rtype":["clu"],"sorti":"slutrapport erhvervsskoleelever i det danske erhvervsuddannelsessystem","src":["au","kp","ruc"],"src-code":["DI-U-AU","DI-U-RUC","DI-UC-KP"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://psy.au.dk/fileadmin/Psykologi/Forskning/Forskningsprojekter/Fastholdelse_af_erhvervsskoleelever/Slutrapport28082013final.pdf","version":"Other Version"},"id":"S03-088.46-025562","ids":["au-b0d6851e-d5ba-4df4-b855-cf640a15f66c","kp-622f063d-5a1b-44dc-96bb-2663921061be","ruc-faa16e03-e153-4994-a750-0b36a343c87d"],"keyword":["erhvervsuddannelser"],"lang":"Danish","level":"Scientific","mra":["Humanities","Social Science"],"noi":["Local-1-3-2BB789CF05E7736768F60B0DC7595445"],"oa_link":[{"access":"oa","type":"rem","url":"http://psy.au.dk/frafald","version":"Other Version"},{"access":"oa","type":"rem","url":"http://psy.au.dk/fileadmin/Psykologi/Forskning/Forskningsprojekter/Fastholdelse_af_erhvervsskoleelever/Slutrapport28082013final.pdf","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3"