{"abstract":"The aim was to evaluate activity and toxicity of hepatic arterial infusion of oxaliplatin in combination with capecitabine in patients with metastatic breast cancer with liver metastases and limited extrahepatic disease.","author_count":9,"contributors":["Nielsen, D L","Nørgaard, H","Weber Vestermark, Lene","Pfeiffer, Per","Jensen, B K","Nelausen, K M","Bergenfeldt, M","Hermann, K L","Jensen, B V"],"cuid":["S01-000.00-645660"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Adult","Aged","Antineoplastic Agents","Antineoplastic Combined Chemotherapy Protocols","Breast Neoplasms","Deoxycytidine","Drug Administration Schedule","Female","Fluorouracil","Humans","Infusions Intra Arterial","Liver Neoplasms","Middle Aged","Organoplatinum Compounds","Retrospective Studies","Survival Analysis","Treatment Outcome"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"intrahepatic and systemic therapy with oxaliplatin combined with capecitabine in patients with hepatic metastases from breast cancer","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.breast.2012.05.003","version":"Other Version"},"id":"S01-000.00-645660","identifier":[{"id":"84863859084","type":"scopus"},{"id":"22672848","type":"pmid"}],"ids":["sdu-fd2e292e-0497-452a-97b8-10fbde1336f5"],"keyword":["Adult","Aged","Antineoplastic Agents","Antineoplastic Combined Chemotherapy Protocols","Breast Neoplasms","Deoxycytidine","Drug Administration Schedule","Female","Fluorouracil","Humans","Infusions, Intra-Arterial","Liver Neoplasms","Middle Aged","Organoplatinum Compounds","Retrospective Studies","Survival Analysis","Treatment Outcome"],"lang":"English","level":"Scientific","mra":["Medi