tir","rank":20,"rolecode":"pau"}],"pub":{"isbn":["9788771566802"],"issn":["22450203"],"issue":"494","pages":"969","place":"Aarhus","publisher":"Aarhus University","repno":"Scientiﬁc Report from DCE – Danish Centre for Environment and Energy, No. 494","series":"Scientiﬁc Report from DCE - Danish Centre for Environment and Energy","status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-9d1c2132-a624-4be7-9b9c-89cd7bb3e8ba","ku-7208329c-3a0e-4708-90bf-e529038eb320"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Denmark's National Inventory Report 2022 : Emission Inventories 1990-2020 - Submitted under the United Nations Framework Convention on Climate Change and the Kyoto Protocol","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-092.50-024131","year":"2022","yearsub":"2022"}
{"abstract":"AIMS: The study aimed to investigate time trends in incidence rates in schizophrenic spectrum disorders (ICD-10: F20-F29), bipolar affective disorder (ICD-10: F30, F31), and recurrent depression (ICD-10: F33) and to investigate the rates of employment for all incident cases. METHOD: We used nationwide longitudinal data from 2000 to 2013 on all psychiatric inpatients and outpatients contacts in Denmark. Age-adjusted incidence rate ratios were calculated for the three diagnostic groups, and rates of employment, education, and disability pension were measured 1 year before and 2 years after the diagnosis for all the incident cases. RESULTS: The incidence rates increased significantly in all diagnostic groups and both sexes. Comparing the incidence rates in 2013 with 2000 yielded an incidence rate ratio of 1.67 (95% CI 1.51-1.84) for schizophrenic spectrum disorders, 3.82 (95% CI 3.23-4.52) for bipolar affective disorder, and 2.80 (95% CI 2.58-3.04) for recurrent depression. During the same observation period, the employment rates decreased, both 1 year before and 2 years after diagnosis in all three subgroups. In the year 2002, employment rates, 2 years after diagnosis, were 24.6% for schizophrenia spectrum disorder, 35.0% for bipolar affective disorder and 47.1% for recurrent depression. These rates had declined to 15.8%, 26.8%, and 34.7%, respectively, in 2013. CONCLUSION: This study of three severe mental illness subgroups shows significant increasing incidence rates and decreasing employment rates both before and after the diagnosis between 2000 and 2013, highlighting the importance of timely and correct volume of the psychiatric treatment and vocational rehabilitation programs.","author_count":5,"contributors":["Christensen, Thomas Nordahl","Wallstrøm, Iben Gammelgård","Eplov, Lene Falgaard","Laursen, Thomas Munk","Nordentoft, Merete"],"cuid":["S03-086.25-672176"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":3,"corresponding_author":["Christensen, Thomas Nordahl"],"keyword":["Bipolar Disorder psychology","Denmark epidemiology","Depression","Depressive Disorder Major","Employment","Female","Humans","Incidence","Incidence rates","Male","Recurrent depression","Schizophrenia diagnosis","Schizophrenia spectrum disorders","bipolar affective disorders","employment trends"],"level":"sci","mra":["med","soc"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"OT":["Danish Gymnasium/HF/VUC/Vocational School"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"incidence rates and employment trends in schizophrenia spectrum disorders bipolar affective disorders and recurrent depression in the years 000000002000 000000002013 a danish nationwide register based study","src":["au","ku","sdu"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85111923711","version":"Other Version"},"id":"S03-086.25-672176","identifier":[{"id":"85111923711","type":"scopus"},{"id":"34339349","type":"pmid"}],"ids":["au-faf47235-9fdc-44f8-8657-dd9292a15238","ku-9a36e0b7-0366-48c6-a02b-9904819c6a7d","sdu-071a981e-4e66-44a1-a228-92d90efd666c"],"keyword":["Bipolar Disorder/psychology","Denmark/epidemiology","Depression","Depressive Disorder, Major","Employment","Female","Humans","Incidence","Incidence rates","Male","Schizophrenia/diagnosis","bipolar affective disorders","employment trends","recurrent depression","schizophrenia spectrum disorders"],"lang":"English","level":"Scientific","mra":["Medical Science","Social Science"],"noi":["Global-Local-2-6-AC00F1D1D214D8FBA6957A5B31D400C0"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affn