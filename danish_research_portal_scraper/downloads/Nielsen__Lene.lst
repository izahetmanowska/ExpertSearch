responding":null,"country":"dk","first":"Lene Hjerrild","key":"iversenlenehjerrildpau","last":"Iversen","locid":"4d8ada79-98c2-49eb-ac2f-472b41434eff","name":"Iversen, Lene Hjerrild","orcid":"0000-0002-2336-2923","rank":11,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Søren","key":"laurbergsørenpau","last":"Laurberg","locid":"fde493d2-685c-4530-8791-614babb5ff72","name":"Laurberg, Søren","rank":12,"rolecode":"pau"},{"affno":"","first":"Ib Jarle","key":"christensenibjarlepau","last":"Christensen","name":"Christensen, Ib Jarle","rank":13,"rolecode":"pau"},{"affno":"4","first":"Hans Jørgen","key":"nielsenhansjørgenpau","last":"Nielsen","locid":"87f9baf4-e29c-4104-be23-daf6d94d7124","name":"Nielsen, Hans Jørgen","rank":14,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Claus Lindbjerg","key":"andersenclauslindbjergpau","last":"Andersen","locid":"f97421ce-9c23-4c51-9fcd-be0843ed0c0f","name":"Andersen, Claus Lindbjerg","orcid":"0000-0002-7406-2103","rank":15,"rolecode":"pau"}],"pmid":["31727158"],"pub":{"doi":"10.1186/s13148-019-0757-3","issn":["18687075","18687083"],"issn_org":["18687075"],"issue":"1","journal":"Clinical Epigenetics","paperid":"158","publisher":"BioMed Central","status":"p","title":"Clinical Epigenetics","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-85075113935"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Private Research","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Hospitals","Other Companies","Private Research","Universities","University of Copenhagen","exiqon a/s"],"PST":["Published"]},"sid":["au-63a47a30-d814-4bc9-8061-b532c2b844b8","ku-706a6d5e-f1d8-4346-a357-868154759428"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Novel DNA methylation biomarkers show high sensitivity and specificity for blood-based detection of colorectal cancer- A clinical biomarker discovery and validation study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.81-019907","year":"2019","yearsub":"2019"}
{"abstract":"Acute promyelocytic leukemia (APL) is highly curable. To achieve high cure rates, targeted therapy with retinoic acid (ATRA) must be started promptly at time of suspected diagnosis. Early death rates (EDRs, ≤30 days from diagnosis) differ markedly in patients treated on clinical trials compared to the general population. OBJECTIVES AND METHODS: We used the comprehensive Danish National Acute Leukemia Registry (DNLR) to investigate the incidence, treatment, EDR, and long-term clinical outcome in APL between 2000 and 2014. RESULTS: Twenty-two of 41 deaths occurring in 122 APL patients were EDs which were primarily caused by intracranial hemorrhage, disseminated intravascular coagulation (DIC), sepsis, and multiorgan failure. The overall EDR was 18.0%, whereas clinical trial participants had an EDR of 6.7%. Fifteen patients recruited to the NCRI AML17 APL trial from 2010 to 2013 were younger and had decreased mortality (HR 0.18, CI 0.04-0.86, P = 0.02) compared to contemporarily treated patients (n = 15) not recruited to a clinical trial. Performance status, leukemia origin, and Sanz-score were independent prognostic variables. CONCLUSIONS: The very low EDR for on-trial patients is not observed in the general cohort of APL patients. Diagnostic awareness emerges as the greatest clinical challenge in management of APL.","author_count":14,"contributors":["Nørgaard, Jan M.","Friis, Lone S.","Kristensen, Jørgen S.","Severinsen, Marianne Tang","Mølle, Ingolf","Marcher, Claus W.","Møller, Peter","Schoellkopf, Claudia","Nielsen, Ove J.","Preiss, Birgitte S.","Andersen, Mette K.","Kjeldsen, Eigil","Medeiros, Bruno C.","Østgård, Lene S.G."],"cuid":["S03-093.27-004147"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"continent":["America, North","OECD"],"corpau":["for the Danish Acute Leukemia Group","the Danish Acute Leukemia Group"],"corresponding_author":["Nørgaard, Jan M.","Nørgaard, Jan Maxwell"],"country":["United States"],"glorg":["All Global Affiliations","Stanford University"],"keyword":["Adolescent","Adult","Aged","Aged 80 and over","Biomarkers Tumor","Combined Modality Therapy","Denmark epidemiology","Disease Management","Female","Humans","In Situ Hybridization Fluorescence","Kaplan Meier Estimate","Male","Middle Aged","Oncogene Proteins Fusion genetics","Prognosis","Proportional Hazards Models","Quality Improvement","Registries","Translocation Genetic","Young Adult","acute promyelocytic leukemia","diagnostic awareness","early death"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-SDR","DI-HO-ZEA"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"addressing the room for improvement in management of acute promyelocytic leukemia","src":["aau","au","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/153663502/Addressing_the_Room_for_Improvement_in_Management_of_Acute_Promyelocytic_Leukemia.pdf","version":"Authors Final Version"},"id":"S03-093.27-004147","identifier":[{"id":"85064009922","type":"scopus"},{"id":"30887583","type":"pmid"}],"ids":["aau-54bc892a-08bf-47cf-abf4-0f7a01bd14ba","au-41dd6c1c-5fc9-4994-8d44-d9750010f0af","sdu-afeb6d3b-5868-4251-bd04-d85b1721a66f"],"keyword":["Adolescent","Adult","Aged","Aged, 80 and over","Biomarkers, Tumor","Combined Modality Therapy","Denmark/epidemiology","Disease Management","Female","Humans","In Situ Hybridization, Fluorescence","Kaplan-Meier Estimate","Leukemia, Promyelocytic, Acute/diagnosis","Male","Middle Aged","Oncogene Proteins, Fusion/genetics","Proportional Hazards Models","Quality Improvement","Registries","Translocation, Genetic","Young Adult","acute promyelocytic leukemia","diagnostic awareness","early death","prognosis"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-62724395E9515439A3EFDF3B0774A9E7"],"oa_link":[{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/334582251/Addressing_the_Room_for_Improvement_in_Management_of_Acute_Promyelocytic_Leukemia.pdf","version":"Authors Final Version"},{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/153663502/Addressing_the_Room_for_Improvement_in_Management_of_Acute_Promyelocytic_Leukemia.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Department of Haematology"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1},{"affno":"3","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Rigshospitalet, Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"4","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU Univers