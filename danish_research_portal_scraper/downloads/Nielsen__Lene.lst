","name":"Balaña-Fouce, Rafael","rank":12,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Yi-Ping","key":"hopau","last":"Ho","name":"Ho, Yi-Ping","rank":13,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Rosa María","key":"reguerapau","last":"Reguera","name":"Reguera, Rosa María","rank":14,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Birgitta Ruth","key":"knudsenpau","last":"Knudsen","locid":"50fca07c-ced4-453a-a26a-0d664c9a1491","name":"Knudsen, Birgitta R.","name_org":"Knudsen, Birgitta Ruth","orcid":"0000-0002-3484-3802","rank":15,"rolecode":"pau"}],"pmid":["32402089"],"pub":{"doi":"10.1093/nar/gkaa341","issn":["03051048","13624962"],"issn_org":["03051048"],"issue":"11","journal":"Nucleic Acids Research","pages":"6081-6091","publisher":"Oxford University Press","status":"p","title":"Nucleic Acids Research","volume":"48"},"review":"Peer Reviewed","scoID":["2-s2.0-85086523557"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities"],"PST":["Published"]},"sid":["au-d2bd790f-e247-4056-9f4c-9c1cd4b9eef4"],"src":["AU Aarhus University"],"title":"DNA flowerstructure co-localizes with human pathogens in infected macrophages","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-249703","year":"2020","yearsub":"2020"}
{"abstract":"Following the proliferation ofpersonified big data and data science algorithms, data-driven user personas (DDPs) are becoming more common in persona design.However, the DDP templates are seemingly diverse and frag-mented, prompting a need for a synthesis of the information included in these personas. Analyzing 31 templates for DDPs, we find that DDPs vary greatly by their information richness, asthe most informative layout hasmore than 300% more information categories than the least informative layout. We also find that graphical complexity and information richness do not necessarily correlate. Fur-thermore, the chosen persona development methodmay carry over to the infor-mation presentation, with quantitative data typically presented as scores, metrics, or tables and qualitative data as text-rich narratives. We did not find one “general template” for DDPs and defining thisis difficultdue to the variety of the outputs of different methods as well as differentinformation needs of the persona users.","author_count":7,"contributors":["Salminen, Joni","Guan, Kathleen","Nielsen, Lene","Jung, Soon-Gyo","Jansen, Bernard J."],"cuid":["S01-000.00-383279"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Asia, Middle East","OECD"],"country":["Qatar","United States"],"glorg":["All Global Affiliations","Georgetown University","Qatar Computing Research institute"],"keyword":["DDP Templates","Data Driven User Personas","Graphical Complexity","Information Richness","Persona Development Method"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"a template for data driven personas analyzing 000000000031 quantitatively oriented persona profiles","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-3-030-50020-7_8","version":"Published Version"},"id":"S01-000.00-383279","identifier":[{"id":"85088741119","type":"scopus"}],"ids":["itu-895e42d2-b26e-4ace-a8e0-41f621429d8d"],"keyword":["DDP Templates","Data-Driven User Personas","Graphical Complexity","Information Richness","Persona Development Method"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-929260BC093CBBD23007F0D518F360A9"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-3-030-50020-7_8","version":"Published Version"},{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85697388/HCIII20_persona_templates_camera.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","country":"qa","key":"qatar computing research institute","loc":["Qatar","Asia, Middle East"],"name":"Qatar Computing Research institute","used":1},{"affno":"2","country":"us","key":"georgetown university","loc":["United States","America, North","OECD"],"name":"Georgetown University","used":1},{"affno":"3","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Joni","key":"salminenpau","last":"Salminen","name":"Salminen, Joni","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kathleen","key":"guanpau","last":"Guan","name":"Guan, Kathleen","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Lene","key":"nielsenpau","last":"Nielsen","locid":"1052b289-f510-4c5a-9662-2db48c12ebc2","name":"Nielsen, Lene","orcid":"0000-0003-1768-7147","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Soon-Gyo","key":"jungpau","last":"Jung","name":"Jung, Soon-Gyo","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Bernard J.","key":"jansenpau","last":"Jansen","name":"Jansen, Bernard J.","rank":5,"rolecode":"pau"},{"affno":"","first":"S.","key":"yamamotopedh","last":"Yamamoto","name":"Yamamoto, S.","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"H.","key":"moripedh","last":"Mori","name":"Mori, H.","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-030-50020-7_8","eisbn":["9783030500207"],"issn":["03029743"],"pages":"125-144","publisher":"Springer","series":"Lecture Notes in Computer Science","status":"p","title":"Human Interface and the Management of Information. Designing Information","volume":"12184"},"review":"Peer Reviewed","scoID":["2-s2.0-85088741119"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-895e42d2-b26e-4ace-a8e0-41f621429d8d"],"src":["ITU IT University of Copenhagen"],"title":"A Template for Data-Driven Personas : Analyzing 31 Quantitatively Oriented Persona Profiles","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383279","year":"2020","yearsub":"2020"}
{"abstract":"Pregnancy is known to be associated with an increased demand for insulin that is normally compensated by an increased beta cell mass and insulin secretion. Recent studies have suggested enhanced beta cell function during pregnancy in women with type 1 diabetes (T1D). To explore the possible mechanisms behind enhanced beta cell function during pregnancy in women with T1D we investigated the impact of circulating factors in serum from nine women from each group of pregnant women with and without T1D, after pregnancy and non-diabetic nonpregnant women on rat islet cell proliferation and apoptosis, and on T-lymphocyte activation. In addition, circulating levels of pancreatic hormones and selected cytokines and adipokines were measured. Rat islet cell proliferation was higher in serum from pregnant women with T1D (p <0.05) compared to T1D women after pregnancy. Apoptosis in INS-1E cell was lower (p <0.05) in serum from pregnant women with T1D compared to T1D women after pregnancy. T-lymphocyte cell (Jurkat) proliferation was reduced by serum from pregnant women without T1D only (p <0.05). Higher C-peptide levels and lower levels of ghrelin, IL-6, MCP-1, IL-8 and adipsin were observed in pregnant women with T1D compared to T1D women after pregnancy. In conclusion, the improved beta cell function in women with T1D during pregnancy may be due to lower levels of proinflammatory cytokines and/or higher levels of pregnancy-associated growth factors.","author_count":6,"contributors":["Nalla, Amarnadh","Ringholm, Lene","Sorensen, Susanne Norskov","Damm, Peter","Mathiesen, Elisabeth R.","Nielsen, Jens Høiriis"],"cuid":["S01-000.00-421625"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Activation","Adiponectin","Beta cells","C Peptide","Cytokines","Endocrinology","Expression","Growth hormone","Immunology","Pancreatic islets","Physiology","Placental Lactogen","Pregnancy","Prolactin","Release","Reproductive System","Secretion","Type 1 diabetes","Women s health"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"possible mechanisms involved in improved beta cell function in pregnant women with type 000000000001 diabetes","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.heliyon.2020.e04569","version":"Published Version"},"id":"S01-000.00-421625","identifier":[{"id":"PMC7452446","type":"pmcid"},{"id":"85089499713","type":"scopus"},{"id":"000568755600005","type":"wos"},{"id":"32904239","type":"pmid"}],"ids":["ku-2f4a3bf4-5413-45c9-b6e8-a89dd63b6ea1"],"keyword":["ACTIVATION","ADIPOCYTOKINES","ADIPONECTIN","Beta cells","C-peptide","Cytokines","EXPRESSION","Endocrinology","GROWTH-HORMONE","Immunology","PANCREATIC-ISLETS","PLACENTAL-LACTOGEN","PROLACTIN","Physiology","Pregnancy","RELEASE","Reproductive system","SECRETION","T-lymphocyte cell","Type 1 diabetes","Women's health"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-2EAF466A1429143AB79D2AFC6DE75E62"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://curis.ku.dk/ws/files/251948907/OA_Possible_mechanisms_involved_in_improved_beta_cell_function_in_pregnant.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.heliyon.2020.e04569","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Biomedical Sciences, Inflammation, Metabolism and Oxidation"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","country":"dk","first":"Amarnadh","key":"nallapau","last":"Nalla","locid":"5d946eef-54a5-495c-a24e-7c7182ca6308","name":"Nalla, Amarnadh","rank":1,"rolecode":"pau"},{"affno":"1","first":"Lene","key":"ringholmpau","last":"Ringholm","name":"Ringholm, Lene","rank":2,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Susanne Norskov","key":"sorensenpau","last":"Sorensen","locid":"35eb69fd-246e-485f-a6c2-03aed25eeed7","name":"Sorensen, Susanne Norskov","rank":3,"rolecode":"pau"},{"affno":"1","first":"Peter","key":"dammpau","last":"Damm","locid":"884d03d5-5981-4d33-80c6-adb21f836deb","name":"Damm, Peter","rank":4,"rolecode":"pau"},{"affno":"1","first":"Elisabeth Reinhardt","key":"mathiesenpau","last":"Mathiesen","locid":"3acd58f4-6d64-4a89-a406-d2f43b310500","name":"Mathiesen, Elisabeth R.","name_org":"Mathiesen, Elisabeth Reinhardt","rank":5,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Jens Hoiriis","key":"nielsenpau","last":"Nielsen","locid":"181203c6-f69f-4d68-a0e4-e4f609517862","name":"Nielsen, Jens Høiriis","name_org":"Nielsen, Jens Hoiriis","orcid":"0000-0001-8252-3048","rank":6,"rolecode":"pau"}],"pmid":["32904239"],"pub":{"doi":"10.1016/j.heliyon.2020.e04569","issn":["24058440"],"issue":"8","journal":"Heliyon","paperid":"04569","status":"p","title":"Heliyon","volume":"6"},"review":"Peer Reviewed","scoID":["2-s2.0-85089499713"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-2f4a3bf4-5413-45c9-b6e8-a89dd63b6ea1"],"src":["KU University of Copenhagen"],"title":"Possible mechanisms involved in improved beta cell function in pregnant women with type 1 diabetes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-421625","year":"2020","yearsub":"2020"}
{"abstract":"BACKGROUND: In patients with non-ST-segment elevation acute coronary syndrome (NSTEACS), coronary pathology may range from structurally normal vessels to severe coronary artery disease. OBJECTIVES: The purpose of this study was to test if coronary computed tomography angiography (CTA) may be used to exclude coronary artery stenosis ≥50% in patients with NSTEACS. METHODS: The VERDICT (Very Early Versus Deferred Invasive Evaluation Using Computerized Tomography in Patients With Acute Coronary Syndromes) trial (NCT02061891) evaluated the outcome of patients with confirmed NSTEACS randomized 1:1 to very early (within 12 h) or standard (48 to 72 h) invasive coronary angiography (ICA). As an observational component of the trial, a clinically blinded coronary CTA was conducted prior to ICA in both groups. The primary endpoint was the ability of coronary CTA to rule out coronary artery stenosis (≥50% stenosis) in the entire population, expressed as the negative predictive value (NPV), using ICA as the reference standard. RESULTS: Coronary CTA was conducted in 1,023 patients-very early, 2.5 h (interquartile range [IQR]: 1.8 to 4.2 h), n = 583; and standard, 59.9 h (IQR: 38.9 to 86.7 h); n = 440 after the diagnosis of NSTEACS was made. A coronary stenosis ≥50% was found by coronary CTA in 68.9% and by ICA in 67.4% of the patients. Per-patient NPV of coronary CTA was 90.9% (95% confidence interval [CI]: 86.8% to 94.1%) and the positive predictive value, sensitivity, and specificity were 87.9% (95% CI: 85.3% to 90.1%), 96.5% (95% CI: 94.9% to 97.8%) and 72.4% (95% CI: 67.2% to 77.1%), respectively. NPV was not influenced by patient characteristics or clinical risk profile and was similar in the very early and the standard strategy group. CONCLUSIONS: Coronary CTA has a high diagnostic accuracy to rule out clinically significant coronary artery disease in patients with NSTEACS.","author_count":40,"contributors":["Linde, Jesper J","Kelbæk, Henning","Hansen, Thomas Fritz","Sigvardsen, Per E","Torp-Pedersen, Christian Tobias","Bech, Jan","Heitmann, Merete","Nielsen, Olav Wendelboe","Høfsten, Dan E.","Kühl, Jørgen T","Raymond, Ilan E","Kristiansen, Ole P","Svendsen, Ida H","Vall-Lamora, Maria H D","Kragelund, Charlotte","de Knegt, Martina","Hove, Jens Dahlgaard","Jørgensen, Tem","Fornitz, Gitte Gleerup","Steffensen, Rolf","Jurlander, Birgit","Abdulla, Jawdat","Lyngbæk, Stig","Elming, Hanne","Therkelsen, Susette Krohn","Jørgensen, Erik","Kløvgaard, Lene","Bang, Lia Evi","Hansen, Peter Riis","Helqvist, Steffen","Galatius, Søren","Pedersen, Frants","Abildgaard, Ulrik","Clemmensen, Peter","Saunamäki, Kari","Holmvang, Lene","Engstrøm, Thomas","Gislason, Gunnar","Køber, Lars","Kofoed, Klaus Fuglsang"],"cuid":["S01-000.00-441180"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["Acute Coronary Syndrome diagnostic imaging","Aged","Computed Tomography Angiography","Coronary Angiography","Coronary Stenosis diagnostic imaging","Female","Humans","Male","Middle Aged","Predictive Value of Tests","Prospective Studies"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"coronary ct angiography in patients with non st segment elevation acute coronary syndrome","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Andet","type":"doi","url":"https://doi.org/10.1016/j.jacc.2019.12.012","version":"Published Version"},"id":"S01-000.00-441180","identifier":[{"id":"85078263838","type":"scopus"},{"id":"32029126","type":"pmid"}],"ids":["ku-4ff1457b-9469-47a8-860d-9e9e407bb061"],"keyword":["Acute Coronary Syndrome/diagnostic imaging","Aged","Computed Tomography Angiography","Coronary Angiography","Coronary Stenosis/diagnostic