I-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Roskilde University","Universities"],"PST":["Published"]},"sid":["aau-04887337-8c31-4751-943d-c0c71a98d26b","itu-de0c3330-6650-48cc-8b49-7f37e331e916","ruc-e2575a0f-4f4d-4214-9b72-5cd1478b9caf"],"src":["AAU Aalborg University","ITU IT University of Copenhagen","RUC Roskilde University"],"title":"Developing International Personas : A new intercultural communication practice in globalized societies","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-099.95-000232","year":"2017","yearsub":"2017"}
