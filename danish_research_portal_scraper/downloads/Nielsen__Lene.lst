f Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"6","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"7","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Haematology (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"8","country":"dk","key":"unclear universities","l2":"DI-U","l2n":"Universities","l3":"DI-U-UND","l3nl":"Undetermined","l3nn":"Unclear Universities","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Unclear Universities","namevar":["Institut for Klinisk Medicin - Klinisk Epidemiologi, SKS"],"nora_code":"DI-U-UND","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Lene Sofie Granfeldt","key":"østgårdlenesofiegranfeldtpau","last":"Ostgård","locid":"f2d62f66-75bd-4bfb-92e7-87a17aff848f","name":"Østgård, Lene Sofie Granfeldt","name_org":"Ostgård, Lene Sofie Granfeldt","orcid":"0000-0002-3886-1311","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Lene Sofie Granfeldt","key":"ostgårdlenesofiegranfeldtpau","last":"Ostgård","name":"Ostgård, Lene Sofie Granfeldt","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"L.S.G.","key":"østgaardlsgpau","last":"Østgaard","name":"Østgaard, L.S.G.","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jan Maxwell","key":"nørgaardjanmaxwellpau","last":"Nørgaard","locid":"9b29c146-4e40-44f4-903b-079afa4bf3ae","name":"Nørgaard, Jan Maxwell","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"J.M.","key":"nørgaardjmpau","last":"Nørgaard","name":"Nørgaard, J.M.","rank":2,"rolecode":"pau"},{"affno":"3 1 4","corresponding":null,"country":"dk","first":"Marianne Tang","key":"severinsenmariannetangpau","last":"Severinsen","locid":"fcac056d-4da6-4995-8375-2d5d5e30a2f8","name":"Severinsen, Marianne Tang","orcid":"0000-0003-0996-1812","rank":3,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Henrik","key":"sengeløvhenrikpau","last":"Sengeløv","name":"Sengeløv, Henrik","rank":4,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"H.","key":"sengeløvhpau","last":"Sengeløv","name":"Sengeløv, H.","rank":4,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Lone Smidstrup","key":"friislonesmidstruppau","last":"Friis","locid":"add67a9f-a425-4861-a99a-f47ea30c70cc","name":"Friis, Lone Smidstrup","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Lone","key":"friislonepau","last":"Friis","name":"Friis, Lone","rank":5,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Morten Krogh","key":"jensenmortenkroghpau","last":"Jensen","name":"Jensen, Morten Krogh","rank":6,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"O.J.","key":"nielsenojpau","last":"Nielsen","name":"Nielsen, O.J.","rank":6,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Ove Juul","key":"nielsenovejuulpau","last":"Nielsen","name":"Nielsen, Ove Juul","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"M.K.","key":"jensenmkpau","last":"Jensen","name":"Jensen, M.K.","rank":7,"rolecode":"pau"},{"affno":"1 8","corresponding":null,"country":"dk","first":"Mette","key":"nørgaardmettepau","last":"Nørgaard","locid":"3cb2ae19-c1b9-4dad-9928-adbd1c51b4b7","name":"Nørgaard, Mette","orcid":"0000-0001-6110-5891","rank":8,"rolecode":"pau"}],"pmid":["24039451"],"pub":{"doi":"10.2147/clep.s48411","issn":["11791349"],"journal":"Clinical Epidemiology","pages":"335-44","publisher":"Dove Medical Press Ltd","publisher_org":"Dove Medical Press Ltd.","status":"p","title":"Clinical Epidemiology","volume":"5"},"review":"Peer Reviewed","scoID":["2-s2.0-84884132931"],"search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Undetermined","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-fddb620b-9cee-4771-9046-aab4b1000b39","au-d016e207-762c-4996-a5ac-e283140bbe8d","sdu-5cd8a828-69f1-44a1-8135-7bd265239cb7"],"src":["AAU Aalborg University","AU Aarhus University","SDU University of Southern Denmark"],"title":"Data quality in the Danish National Acute Leukemia Registry: A Hematological Data Resource","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-092.59-012070","year":"2013","yearsub":"2013"}
{"abstract":"In many individuals suspected of the common cancer predisposition Lynch syndrome, variants of unclear significance (VUS), rather than an obviously pathogenic mutations, are identified in one of the DNA mismatch repair (MMR) genes. The uncertainty of whether such VUS inactivate MMR, and therefore are pathogenic, precludes targeted healthcare for both carriers and their relatives. To facilitate the identification of pathogenic VUS, we have developed an in cellulo genetic screen-based procedure for the large-scale mutagenization, identification, and cataloging of residues of MMR genes critical for MMR gene function. When a residue identified as mutated in an individual suspected of Lynch syndrome is listed as critical in such a reverse diagnosis catalog, there is a high probability that the corresponding human VUS is pathogenic. To investigate the applicability of this approach, we have generated and validated a prototypic reverse diagnosis catalog for the MMR gene MutS Homolog 2 (Msh2) by mutagenizing, identifying, and cataloging 26 deleterious mutations in 23 amino acids. Extensive in vivo and in vitro analysis of mutants listed in the catalog revealed both recessive and dominant-negative phenotypes. Nearly half of these critical residues match with VUS previously identified in individuals suspected of Lynch syndrome. This aids in the assignment of pathogenicity to these human VUS and validates the approach described here as a diagnostic tool. In a wider perspective, this work provides a model for the translation of personalized genomics into targeted healthcare.","author_count":10,"contributors":["Drost, Mark","Lützen, Anne","van Hees, Sandrine","Ferreira, Daniel","Calléja, Fabienne","Zonneveld, José B M","Nielsen, Finn Cilius","Rasmussen, Lene Juel","de Wind, Niels"],"cuid":["S03-097.95-039882"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD"],"country":["Netherlands"],"glorg":["All Global Affiliations","Leiden University Medical Center"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU","DI-U-RUC"]},"level3all":["DI-HO-CAP","DI-U-KU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"genetic screens to identify pathogenic gene variants in the common cancer predisposition lynch syndrome","src":["ku","ruc"],"src-code":["DI-U-KU","DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1073/pnas.1220537110","version":"Other Version"},"id":"S03-097.95-039882","identifier":[{"id":"23690608","type":"pmid"},{"id":"84878715707","type":"scopus"},{"id":"PMC3677471","type":"pmcid"}],"ids":["ku-06959d8c-d4dc-4284-bd03-52773130265e","ku-dc3b20f5-5134-4fab-b3bc-27810ede7c57","ruc-188dd9ad-fb6f-4974-9268-c895dd86f80f"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-6-7C4DE26BFA3F9DC01CB144DAB809C7B8"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1073/pnas.1220537110","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, The Department of Science, Systems and Models"],"nora_code":"DI-U-RUC","used":1},{"affno":"2","country":"nl","key":"leiden university medical center","loc":["Netherlands","Europe, EU","OECD"],"name":"Leiden University Medical Center","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Section of Diagnostic Sciences"],"nora_code":"DI-U-KU","used":1},{"affno":"4","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","country":"dk","first":"Anne","key":"lützenpau","last":"Lützen","locid":"54fa7b0c-8922-489a-9622-437896fe9f71","name":"Lützen, Anne","rank":1,"rolecode":"pau"},{"affno":"2","first":"Mark","key":"drostpau","last":"Drost","name":"Drost, Mark","rank":2,"rolecode":"pau"},{"affno":"2","first":"Sandrine","key":"vanheespau","last":"Van Hees","name":"Van Hees, Sandrine","rank":3,"rolecode":"pau"},{"affno":"2","first":"Daniel","key":"ferreirapau","last":"Ferreira","name":"Ferreira, Daniel","rank":4,"rolecode":"pau"},{"affno":"","first":"Fabienne","key":"calléjapau","last":"Calléja","name":"Calléja, Fabienne","rank":5,"rolecode":"pau"},{"affno":"2","first":"Fabienne","key":"callejapau","last":"Calleja","name":"Calleja, Fabienne","rank":5,"rolecode":"pau"},{"affno":"2","first":"Jose","key":"zonneveldpau","last":"Zonneveld","name":"Zonneveld, Jose","rank":6,"rolecode":"pau"},{"affno":"3 4","first":"Finn Cilius","key":"nielsenpau","last":"Nielsen","locid":"03d6b282-132a-47ce-98bc-5c28d6126cf3","name":"Nielsen, Finn Cilius","rank":7,"rolecode":"pau"},{"affno":"3","first":"Lene Juel","key":"rasmussenpau","last":"Rasmussen","locid":"54d5267c-3c91-45bc-ace5-1d0edb1b250d","name":"Rasmussen, Lene Juel","rank":8,"rolecode":"pau"},{"affno":"2","first":"Niels","key":"dewindpau","last":"de Wind","name":"de Wind, Niels","rank":9,"rolecode":"pau"}],"pmid":["23690608"],"pub":{"doi":"10.1073/pnas.1220537110","issn":["00278424","10916490"],"issn_org":["00278424"],"issue":"23","journal":"Proceedings of the National Academy of Sciences of the United States of America","pages":"9403-8","status":"p","title":"Proceedings of the National Academy of Sciences of the United States of America","title_org":"Proceedings of the National Academy of Science of the United States of America","volume":"110"},"review":"Peer Reviewed","scoID":["2-s2.0-84878715707"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Roskilde University","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-06959d8c-d4dc-4284-bd03-52773130265e","ku-dc3b20f5-5134-4fab-b3bc-27810ede7c57","ruc-188dd9ad-fb6f-4974-9268-c895dd86f80f"],"src":["KU University of Copenhagen","RUC Roskilde University"],"title":"Genetic screens to identify pathogenic gene variants in the common cancer predisposition Lynch syndrome","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-097.95-039882","year":"2013","yearsub":"2013"}
{"abstract":"We present a fatal drug poisoning case involving venlafaxine (VEN). The deceased took his medication regularly (including 150mg VEN twice daily), and nothing in the case or autopsy findings pointed towards suicide. The toxicological assessment concluded that the cause of death was most likely due to a poisoning with a combination of VEN, oxycodone and ethanol, and the manner of death was considered to be an accident. The blood concentration of VEN was high (4.5mg/kg), and the ratio of the VEN metabolite O-desmethylvenlafaxine (ODV) to VEN was exceptionally low (0.006). Mechanistic pharmacokinetic simulations suggested that the low metabolite ratio was the result of combined poor metabolizer (PM) status of cytochrome P450 (CYP) 2C19 and CYP2D6. This hypothesis was confirmed by genetic analysis. Simulations revealed that it was likely that the combined missing CYP2D6 and CYP2C19 activity would cause higher concentrations of VEN, but the simulations also suggested that there could be additional reasons to explain the high VEN concentration found in this case. Thus, it seems likely that the potentially toxic VEN concentration was caused by reduced metabolic capacity. The simulations combined with genotyping were considered very useful in this fatal drug poisoning case.","author_count":7,"contributors":["Jornil, Jakob Ross","Nielsen, Thomas Svava","Rosendal, Ingrid","Ahlner, J","Zackrisson, A L","Boel, Lene Warner Thorup","Brock, Birgitte"],"cuid":["S01-000.00-196380"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"a poor metabolizer of both cyp000000000002c000000000019 and cyp000000000002d000000000006 identified by mechanistic pharmacokinetic simulation in a fatal drug poisoning case involving venlafaxine","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.forsciint.2012.12.020","version":"Other Version"},"id":"S01-000.00-196380","identifier":[{"id":"84875632256","type":"scopus"},{"id":"23332809","type":"pmid"}],"ids":["au-7563a727-9d3f-492a-9eca-72100cfe79a8"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-B2621C6C874C2EDC5B04B28EA66984EF"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.forsciint.2012.12.020","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Forensic Medicine, Department of Forensic Medicine - Retskemisk"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"J","key":"jornilpau","last":"Jornil","locid":"f0370e3b-ec8f-458d-9686-27f1656d6f6c","name":"Jornil, Jakob Ross","name_org":"Jornil, J","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"T S","key":"nielsenpau","last":"Nielsen","locid":"46be3fac-68ff-48c3-b1ef-b5cd112071b7","name":"Nielsen, Thomas Svava","name_org":"Nielsen, T S","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"I","key":"rosendalpau","last":"Rosendal","locid":"09019473-158a-4d99-82fa-0fe5f13fd19b","name":"Rosendal, Ingrid","name_org":"Rosendal, I","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"J","key":"ahlnerpau","last":"Ahlner","name":"Ahlner, J","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"A L","key":"zackrissonpau","last":"Zackrisson","name":"Zackrisson, A L","rank":5,