Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience, Section of Biology and Environmental Science"],"nora_code":"DI-U-AAU","used":1},{"affno":"7","country":"dk","key":"geus geological survey of denmark and greenland","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-GEUS","l3nn":"GEUS Geological Survey of Denmark and Greenland","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"GEUS Geological Survey of Denmark and Greenland","namevar":["Geological Survey of Denmark and Greenland"],"nora_code":"DI-GV-GEUS","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Torben Bramming","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, Torben Bramming","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Anne Lise","key":"middelboepau","last":"Middelboe","name":"Middelboe, Anne Lise","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Flemming","key":"møhlenbergpau","last":"Møhlenberg","name":"Møhlenberg, Flemming","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Mette Møller","key":"nielsenpau","last":"Nielsen","locid":"d058d67b-7f23-4437-9f10-11078a0c3ef2","name":"Nielsen, Mette Møller","orcid":"0000-0002-7198-062X","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Lene Friis","key":"møllerpau","last":"Møller","locid":"ab01928b-01dc-425d-82ca-8094ce170708","name":"Møller, Lene Friis","orcid":"0000-0003-4207-4991","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Jens Kjerulf","key":"petersenpau","last":"Petersen","locid":"bb405fca-78e7-4f2c-b4ad-30806ef2fad7","name":"Petersen, Jens Kjerulf","orcid":"0000-0002-6412-7022","rank":6,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Mogens","ke