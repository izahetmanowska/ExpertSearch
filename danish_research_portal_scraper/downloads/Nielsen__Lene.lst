name":"Kjeldsen, Lene Juel","orcid":"0009-0008-2559-9319","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Christian Backer","key":"mogensenpau","last":"Mogensen","locid":"641e6e06-7971-4ad8-92dd-ac05ea5c12f1","name":"Backer Mogensen, Christian","name_org":"Mogensen, Christian Backer","orcid":"0000-0002-8254-089X","rank":7,"rolecode":"pau"}],"pmid":["38658997"],"pub":{"doi":"10.1186/s12913-024-10992-3","issn":["14726963"],"journal":"BMC Health Services Research","paperid":"511","publisher":"BioMed Central","status":"p","title":"BMC Health Services Research","volume":"24"},"review":"Peer Reviewed","scoID":["2-s2.0-85191174442"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-83a27563-fe56-4437-9928-38924cd109e8"],"src":["SDU University of Southern Denmark"],"title":"Designing a tool ensuring older patients the right medication at the right time after discharge from hospital– the first step in a participatory design process","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-783363","year":"2024","yearsub":"2024"}
