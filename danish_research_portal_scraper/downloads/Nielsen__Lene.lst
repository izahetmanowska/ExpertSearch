eskeropau","last":"Ilveskero","name":"Ilveskero, Sorella","rank":15,"rolecode":"pau"},{"affno":"10","corresponding":null,"first":"Henrik Rode","key":"eshojpau","last":"Eshoj","name":"Eshoj, Henrik Rode","rank":16,"rolecode":"pau"},{"affno":"10 11","corresponding":null,"country":"dk","first":"Lene Kongsgaard","key":"nielsenpau","last":"Nielsen","locid":"897c29d3-45a2-4178-81b1-b0ba61db5a25","name":"Kongsgaard Nielsen, Lene","name_org":"Nielsen, Lene Kongsgaard","orcid":"0000-0003-2083-3870","rank":17,"rolecode":"pau"},{"affno":"2 4","corresponding":null,"first":"Esa","key":"jantunenpau","last":"Jantunen","name":"Jantunen, Esa","rank":18,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Caroline","key":"heckmanpau","last":"Heckman","name":"Heckman, Caroline","rank":19,"rolecode":"pau"}],"pub":{"doi":"10.1182/blood-2020-138447","issn":["00064971","15280020"],"issn_org":["00064971"],"issue":"Supplement 1","journal":"Blood","paperid":"20","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"p","title":"Blood","volume":"136"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-3240504a-3c7b-419a-93ca-f86c08a7f71b"],"src":["AU Aarhus University"],"title":"Carfilzomib, Elotuzumab and Dexamethasone for Relapsed or Refractory Myeloma Patients","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-158079","year":"2020","yearsub":"2020"}
{"abstract":"Background: Denmark is a welfare state with a publically funded healthcare system that includes the right to free of charge physiotherapy (FCP) for patients with chronic or progressive disease who fulfill strict criteria. The aim of this study was to investigate the incidence of referral to FCP in patients with a hospital diagnosis of stroke, multiple sclerosis (MS), Parkinson's disease (PD) and rheumatoid arthritis (RA) between 2007 and 2016. Methods: The study was register-based and included data from The Danish National Patient Registry and The National Health Service Registry. The study population included the four largest disease groups receiving FCP in Denmark. The incidence of receiving FCP was reported as the cumulated incidence proportion (CIP). Results: The study showed that FCP was mainly initiated within the first 2 years after diagnosis. The 2-year CIP was 8% for stroke patients, 53% for PD patients, 49% for MS patients, and 16% for RA patients. The proportion of patients referred to FCP generally increased over the period of the study due to more patients being referred from medical specialists in primary care. Conclusion: This study found substantial differences in the incidence of referral to FCP in a Danish population of stroke, PD, MS and RA patients.","author_count":6,"contributors":["Næss-Schmidt, Erhard Trillingsgaard","Christiansen, David Høyrup","Østgård, René Drage","Andersen, Nils-Bo de Vos","Nielsen, Jørgen Feldbæk","Odgaard, Lene"],"cuid":["S01-000.00-158496"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Chronic Disease","Non pharmacologic treatment","Progressive disease","Rehabilitation"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"incidence of free of charge physiotherapy in a danish national cohort of stroke parkinson s disease multiple sclerosis and rheumatoid arthritis patients","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.2147/CLEP.S223000","version":"Published Version"},"id":"S01-000.00-158496","identifier":[{"id":"85078654202","type":"scopus"},{"id":"PMC6969682","type":"pmcid"},{"id":"32021468","type":"pmid"}],"ids":["au-3304ed30-c0d4-430f-8085-39b53d9e5d4c"],"keyword":["Chronic disease","Non-pharmacologic treatment","Progressive disease","Rehabilitation"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-61884E0D4D22D3976AADD3BAF38B313E"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.2147/CLEP.S223000","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2020","yearSub":"2020"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Hammel Neurocenter, Universitetsklinik for Neurorehabilitering"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Erhard Trillingsgaard","key":"næssschmidtpau","last":"Næss-Schmidt","locid":"c1a1a6b6-deb0-4e07-8cc0-f7d3beeaca85","name":"Næss-Schmidt, Erhard Trillingsgaard","orcid":"0000-0002-2539-0362","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"David Høyrup","key":"christiansenpau","last":"Christiansen","locid":"46467780-cdb3-43ae-a75b-b54b0d9743d4","name":"Christiansen, David Høyrup","orcid":"0000-0001-7458-3921","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rene Drage","key":"