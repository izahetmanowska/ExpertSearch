e195363dbd1","name":"Nielsen, Dennis Sandris","orcid":"0000-0001-8121-1114","rank":2,"rolecode":"pau"},{"affno":"1","first":"Lene","key":"jespersenpau","last":"Jespersen","locid":"a156c6e3-9562-4d35-9305-53a39c62e076","name":"Jespersen, Lene","orcid":"0000-0002-2555-5948","rank":3,"rolecode":"pau"},{"affno":"","first":"J.J.","key":"malagopedh","last":"Malago","name":"Malago, J.J.","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"J.F.J.G.","key":"koninkxpedh","last":"Koninkx","name":"Koninkx, J.F.J.G.","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"R.","key":"marinseklogarpedh","last":"Marinsek-Logar","name":"Marinsek-Logar, R.","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-94-007-0386-5","eisbn":["9789400703865"],"isbn":["9789400703858"],"pages":"133-154","publisher":"Springer","status":"p","subtitle":"cytoprotection by probiotic bacteria","title":"Probiotic bacteria and enteric infections"},"review":"Peer Reviewed","scoID":["2-s2.0-84900665217"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-a6934a1b-6c33-431c-9700-1bbfc9f96bc3"],"src":["KU University of Copenhagen"],"title":"Application of molecular biology and genomics of probiotics for enteric cytoprotection","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-492919","year":"2011","yearsub":"2011"}
{"abstract":"Introduction: Pregnancy increases the risks of adverse outcomes for mother and infant in women with type 1 diabetes. Obtaining and maintaining adequate glycemic control during pregnancy is crucial for optimizing outcomes. Areas covered: The importance of prepregnancy planning and treatment during pregnancy is reviewed. The use of insulin analogues and antihypertensive drugs in diabetic pregnancy are in focus. The reader is presented with evidence discussing the importance of prepregnancy counseling and treatment during pregnancy in women with type 1 diabetes. Expert opinion: Tight glycemic control before and during pregnancy is crucial and the prevalence of severe hypoglycemia during pregnancy needs to be reduced. Rapid-acting insulin analogues are regarded as safe to use in pregnancy and studies on long-acting insulin analogues are in the pipeline. Supplementation with folic acid may reduce the risk of malformations. Screening for diabetic retinopathy, diabetic nephropathy and thyroid dysfunction is important, and indications for antihypertensive treatment and treatment of thyroid dysfunction need to be in focus before and during pregnancy.","author_count":3,"contributors":["Mathiesen, Elisabeth R.","Damm, Peter","Nielsen, Lene Ringholm"],"cuid":["S01-000.00-499451"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"therapeutic management of type 000000000001 diabetes before and during pregnancy","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1517/14656566.2011.540388","version":"Other Version"},"id":"S01-000.00-499451","identifier":[{"id":"79952610265","type":"scopus"},{"id":"21329488","type":"pmid"}],"ids":["ku-b180a98b-12fb-4ded-87f4-dc2c7ebf3d52"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-7FBC8B490515F148996C1A594ADD7C65"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1517/14656566.2011.540388","version":"Other Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Section of Orthopaedics and Internal Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Elisabeth R","key":"mathiesenpau","last":"Mathiesen","locid":"3acd58f4-6d64-4a89-a406-d2f43b310500","name":"Mathiesen, Elisabeth R.","name_org":"Mathiesen, Elisabeth R","rank":1,"rolecode":"pau"},{"affno":"1","first":"Peter","key":"dammpau","last":"Damm","locid":"884d03d5-5981-4d33-80c6-adb21f836deb","name":"Damm, Peter","rank":2,"rolecode":"pau"},{"affno":"","first":"Lene Ringholm","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Lene Ringholm","rank":3,"rolecode":"pau"}],"pmid":["21329488"],"pub":{"doi":"10.1517/14656566.2011.540388","issn":["14656566","17447666"],"issn_org":["14656566"],"issue":"5","journal":"Expert Opinion on Pharmacotherapy","pages":"779-86","status":"p","title":"Expert Opinion on Pharmacotherapy","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-79952610265"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-b180a98b-12fb-4ded-87f4-dc2c7ebf3d52"],"src":["KU University of Copenhagen"],"title":"Therapeutic management of type 1 diabetes before and during pregnancy","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-499451","year":"2011","yearsub":"2011"}
{"abstract":"Resistance to ciprofloxacin in Escherichia coli from urinary tract infections (UTI) in Denmark is increasing parallel to increased use of fluoroquinolones both in Denmark and in other European countries. The objective was to investigate the occurrence of ciprofloxacin resistance mechanisms, phenotypic coresistance, and if ciprofloxacin resistance was caused by clonal spread or to individual mutational events in a collection of consecutively obtained E. coli submitted to a clinical microbiology department at a Danish hospital. One hundred four UTI-related E. coli resistant toward nalidixic acid by disc diffusion were typed by Pulsed Field Gel Electrophoresis (PFGE) with XbaI. One isolate representing each PFGE type and only one patient (n = 77) were investigated for point mutations in sequenced PCR amplicons of the four topoisomerase genes; qnr genes by use of PCR; aac(6')-Ib-cr by BtsCI restriction of PCR products; and efflux using efflux pump inhibitors in a broth dilution assay. Minimal inhibitory concentration (MIC) was determined for 21 antibacterial agents, including ciprofloxacin. Of the 77 isolates, the majority were resistant to ciprofloxacin (91%) and multiresistant (resistant to >= 3 antimicrobial classes, 83%). Ciprofloxacin-resistant isolates showed at least one target mutation. A significant, positive correlation was found regarding MIC of ciprofloxacin and the number of target mutations. Efflux was found as a resistance mechanism in 77% of isolates tested (n = 60). The aac(6')-Ib-cr gene was detected on plasmids from five isolates showing ciprofloxacin MICs >512 mg/L. No overall clonal relationship among isolates was found according to PFGE. Target modification is the dominating fluoroquinolone resistance mechanism often found in combination with efflux and sometimes aac(6')-Ib-cr. In Denmark, increasing ciprofloxacin resistance in E. coli is mainly due to mutational events and not to spread of clones.","author_count":6,"contributors":["Christiansen, Nina","Nielsen, Lene","Jakobsen, Lotte","Stegger, Marc","Hansen, Lars H.","Frimodt-Moller, Niels"],"cuid":["S01-000.00-501993"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"fluoroquinolone resistance mechanisms in urinary tract pathogenic em escherichia coli em isolated during rapidly increasing fluoroquinolone consumption in a low use country","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1089/mdr.2011.0015","version":"Other Version"},"id":"S01-000.00-501993","identifier":[{"id":"21668371","type":"pmid"},{"id":"80052222316","type":"scopus"}],"ids":["ku-b5c344b3-2a56-40f6-8b1e-089f758f0f29"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-D698FF87308D2D188D8BB5B6820C031E"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1089/mdr.2011.0015","version":"Other Version"}],"org":[{"affno":"1","country":"dk","key":"ssi statens serum institut","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-SSI","l3nn":"SSI Statens Serum Institut","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SSI Statens Serum Institut","namevar":["Statens Serum Institut"],"nora_code":"DI-GV-SSI","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Biology, Microbiology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Nina","key":"christiansenpau","last":"Christiansen","name":"Christiansen, Nina","rank":1,"rolecode":"pau"},{"affno":"2","first":"Lene","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Lene","rank":2,"rolecode":"pau"},{"affno":"1","first":"Lotte","key":"jakobsenpau","last":"Jakobsen","name":"Jakobsen, Lotte","rank":3,"rolecode":"pau"},{"affno":"1","first":"Marc","key":"steggerpau","last":"Stegger","name":"Stegger, Marc","rank":4,"rolecode":"pau"},{"affno":"3","first":"Lars H.","key":"hansenpau","last":"Hansen","locid":"2e041f09-bf9d-434a-b82a-d6e2763bb262","name":"Hansen, Lars H.","orcid":"0000-0003-0027-1524","rank":5,"rolecode":"pau"},{"affno":"1","first":"Niels","key":"frimodtmollerpau","last":"Frimodt-Moller","name":"Frimodt-Moller, Niels","rank":6,"rolecode":"pau"}],"pmid":["21668371"],"pub":{"doi":"10.1089/mdr.2011.0015","issn":["10766294","19318448"],"issn_org":["10766294"],"issue":"3","journal":"Microbial Drug Resistance","pages":"395-406","status":"p","title":"Microbial Drug Resistance","volume":"17"},"review":"Peer Reviewed","scoID":["2-s2.0-80052222316"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-b5c344b3-2a56-40f6-8b1e-089f758f0f29"],"src":["KU University of Copenhagen"],"title":"Fluoroquinolone resistance mechanisms in urinary tract pathogenic <em>Escherichia coli</em> isolate