":"43"},"review":"Peer Reviewed","scoID":["2-s2.0-85029817897"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-65f7deaf-4c5b-40a3-94db-4bf42c2b4aa4","sdu-9e9715a3-18f1-4b5f-8397-2294813ea410"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Acute hypoxemic respiratory failure in immunocompromised patients : the Efraim multinational prospective cohort study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-043044","year":"2017","yearsub":"2017"}
{"abstract":"The topic of this paper is user ideation within front-end innovation. We present and discuss an approach which we refer to as “Imagine that… ”. With “Imagine that… ” users tell stories of how they imagine they will use a future IT system. The oral stories are captured online using a remote, unmoderated software tool. The distinguishing characteristics of the “Imagine that… ” approach are: (1) that the users ideate while on their own and therefore without being influenced by an interviewer/moderator and (2) that they come up with the design ideas and scenarios themselves rather than provide feedback on already developed design sketches, mock-ups, etc. The study contributes to the innovation literature by describing how and why narrative theory can be used to support the user’s ability to think creatively about future use. Our research also contributes to method development by showing that it is possible to obtain user input of relevance for the early stages of innovation in a fast, frugal way and unmoderated way.","author_count":6,"contributors":["Nielsen, Lene","Madsen, Sabine","Hansen, Anne Vorre"],"cuid":["S03-085.81-697798"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","class":"merged","cluster_size":3,"keyword":["Creativity","Front end innovation","Narrative theory","Product design","User ideation"],"level":"sci","mra":["sci","soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-ITU","DI-U-RUC"]},"level3all":["DI-U-AAU","DI-U-ITU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"imagine that how to activate and capture users ability to think creatively about future use","src":["aau","itu","ruc"],"src-code":["DI-U-AAU","DI-U-ITU","DI-U-RUC"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1142/9781786342010_0013","version":"Published Version"},"id":"S03-085.81-697798","ids":["aau-bb6d6dd6-8da4-4913-b2a9-6c138ee8192c","itu-4be9f6ff-e8d2-4c39-ac95-dcead42f2ef3","ruc-67c43e02-d901-499d-9594-5c3f8e9a55af"],"keyword":["Creativity","Front-end innovation","Narrative theory","Product design","User ideation"],"lang":"English","level":"Scientific","mra":["Science/Technology","Social Science"],"noi":["Global-Local-2-5-B66994BC7F8C326376B430F2480312E4"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.worldscientific.com/doi/reader/10.1142/9781786342010_0013","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1142/9781786342010_0013","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Social Sciences","Aalborg University, The Faculty of Social Sciences, Department of Political Science"],"nora_code":"DI-U-AAU","used":1},{"affno":"3","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of People and Technology, Center for Socialt Entreprenørskab","Roskilde University, Department of Social Sciences and Business","Roskilde University, Department of Social Sciences and Business, Innovation in services and experiences"],"nora_code":"DI-U-RUC","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lene","key":"nielsenpau","last":"Nielsen","locid":"1052b289-f510-4c5a-9662-2db48c12ebc2","name":"Nielsen, Lene","orcid":"0000-0003-1768-7147","rank":1,"rolecode":"pau"},{"affno":"2 1","corresponding":null,"country":"dk","first":"Sabine","key":"madsenpau","last":"Madsen","locid":"3692adff-8d34-45d0-bed7-7d3fe3cdea43","name":"Madsen, Sabine","rank":2,"rolecode":"pau"},{"affno":"3","country":"dk","first":"Anne Vorre","key":"hansenpau","last":"Hansen","locid":"78806e9e-6174-4a3a-a7da-5394113d8366","name":"Hansen, Anne Vorre","rank":3,"rolecode":"pau"},{"affno":"","first":"Alexander","key":"brempedh","last":"Brem","name":"Brem, Alexander","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Rogelio","key":"puentediazpedh","last":"Puente-Diaz","name":"Puente-Diaz, Rogelio","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Marine","key":"agoguépedh","last":"Agogué","name":"Agogué, Marine","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1142/9781786342010_0013","isbn":["9781786342003"],"issn":["02199823"],"publisher":"World Scientific","series":"Series on Technology Management","status":"p","subtitle":"State of the Art and Future Research Outlook","title":"The Role of Creativity in the Management of Innovation","volume":"27"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Roskilde University","Universities"],"PST":["Published"]},"sid":["aau-bb6d6dd6-8da4-4913-b2a9-6c138ee8192c","itu-4be9f6ff-e8d2-4c39-ac95-dcead42f2ef3","ruc-67c43e02-d901-499d-9594-5c3f8e9a55af"],"src":["AAU Aalborg University","ITU IT University of Copenhagen","RUC Roskilde University"],"title":"\"Imagine that ...\" : How to Activate and Capture Users' Ability to Think Creatively about Future Use","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-085.81-697798","year":"2017","yearsub":"2017"}
{"abstract":"OBJECTIVES: Multiple myeloma (MM) patients report high symptom burden and reduced health-related quality of life (HRQoL) compared to patients with other haematological malignancies. The aim of this review was to analyse published longitudinal studies including MM patients according to a change in HRQoL scores, which is perceived as beneficial to the patient according to two published guidelines. METHODS: A literature search was performed May 2016. Publications with longitudinal follow-up using the EORTC QLQ-C30 instrument for HRQoL measurement of physical functioning, global quality of life, fatigue and/or pain were included. An analysis of mean change from baseline was carried out according to minimal important difference (MID). RESULTS: Large and medium HRQoL improvements were reported during first-line treatments. No clinically beneficial change or deteriorations in scores of global QoL or fatigue were reported during relapse treatment. HRQoL data during maintenance therapy are sparse and inconclusive. CONCLUSIONS: Guidelines for interpreting changes in HRQoL including definitions of MID have been developed; however, consensus is missing. Improvements in HRQoL are far more likely to occur during first-line compared to relapsed treatment regimens. The background of these findings should be in focus in future studies, and HRQoL measurements should be integrated in maintenance studies.","author_count":5,"contributors":["Kongsgaard Nielsen, Lene","Jarden, Mary Ellen","Andersen, Christen Lykkegaard","Frederiksen, Henrik","Abildgaard, Niels"],"cuid":["S03-090.69-704271"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":3,"corresponding_author":["Kongsgaard Nielsen, Lene"],"keyword":["Bortezomib","Clinical trials","EUROPEAN ORGANIZATION","Health related quality of life","Journal Article","Lenalidomide","Longitudinal Studies","Melphalan","Multiple myeloma","Phase II","Response shift","Review","Stem Cell Transplantation"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-SDR","DI-HO-ZEA"],"U":["DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-SDR","DI-HO-ZEA","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"a systematic review of health related quality of life in longitudinal studies of myeloma patients","src":["au","ku","sdu"],"src-code":["DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"djr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1111/ejh.12882","version":"Published Version"},"id":"S03-090.69-704271","identifier":[{"id":"28322018","type":"pmid"},{"id":"85020886520","type":"scopus"},{"id":"000403724300001","type":"wos"}],"ids":["au-af0701c3-8bb1-47e5-9e93-28235a59bb31","ku-93076334-6c14-4b78-a0b9-ddec91d5faf8","sdu-428df3aa-ac8e-4527-af54-63023f457a06"],"keyword":["BORTEZOMIB","CLINICAL-TRIALS","DIAGNOSED MULTIPLE-MYELOMA","EUROPEAN-ORGANIZATION","Health-related quality of life","Journal Article","LENALIDOMIDE","LOW-DOSE DEXAMETHASONE","MELPHALAN","PHASE-II","RESPONSE SHIFT","Review","STEM-CELL TRANSPLANTATION","longitudinal studies","multiple myeloma"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-33D490FE738296CCCA6FC941FBDD2B21"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1111/ejh.12882","version":"Published Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Haematology (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Medicinsk afdeling, RHG"],"nora_code":"DI-U-AU","used":1},{"affno":"3","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","used":1},{"affno":"4","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal Medicine: Haematology","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Section of Social Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"5","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"6","country":"dk","key":"region zealand","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-