:"Bjerrum, MB","orcid":"0000-0001-8249-4021","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Claus Vinther","key":"nielsenclausvintherpau","last":"Nielsen","locid":"033d1aa9-948f-4ed4-be3e-200d0100b399","name":"Nielsen, Claus Vinther","orcid":"0000-0002-2467-1103","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Cecilie Nørby","key":"lyhnececilienørbypau","last":"Thisted","locid":"4a3fc683-c3e6-4b29-bb9e-8cd6770645da","name":"Lyhne, Cecilie Nørby","name_org":"Thisted, Cecilie Nørby","orcid":"0000-0001-8380-7704","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"T L","key":"nielsentlpau","last":"Nielsen","name":"Nielsen, T L","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Malene","key":"laursenmalenepau","last":"Laursen","locid":"abfa584f-e66b-4fba-9c23-4e8a0a1058cf","name":"Laursen, Malene","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lene Bastrup","key":"bastruplenepau","last":"Jørgensen","locid":"532c69b5-512e-421d-8981-88829f8a74ab","name":"Bastrup, Lene","name_org":"Jørgensen, Lene Bastrup","orcid":"0000-0001-7873-6139","rank":7,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-e08fc2e4-7b24-4cac-a2fb-9c6e71b8da78"],"src":["AU Aarhus University"],"title":"Exploring factors associated with symptoms of anxiety and depression in adults undergoing Spine surgery - insights from a systematic integrative review","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-257533","year":"2017","yearsub":"2017"}
{"abstract":"Several chemical compounds that potentially increase the risk of developing cancer in humans are formed during heat processing of meat. Estimating the overall health impact of these compounds in the population requires accurate estimation of the exposure to the chemicals, as well as the probability that different levels of exposure result in disease. The overall goal of this study was to evaluate the impact of variability of exposure patterns and uncertainty of exposure data in burden of disease estimates. We focus on the first phase of burden of disease modelling, i.e. the estimation of exposure to selected compounds in the Danish population, based on concentration and consumption data. One of the challenges that arises in the probabilistic modelling of exposure is the presence of “artificial” zero counts in concentration data due to the detection level of the applied tests. Zeroinflated models, e.g. the Poisson-Lognormal approach, are promising tools to address this obstacle. The exposure estimates can then be applied to dose-response models to quantify the cancer risk.","author_count":8,"contributors":["Georgiadis, Stylianos","Jakobsen, Lea Sletting","Nielsen, Bo Friis","Stockmarr, Anders","Boriani, Elena","Duedahl-Olesen, Lene","Hald, Tine","Pires, Sara Monteiro"],"cuid":["S01-000.00-318993"],"event":{"end":"2017-06-09","place":"London, gb","start":"2017-06-06","title":"17th Applied Stochastic Models and Data Analysis International Conference","year":"2017"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Burden of disease","Exposure modelling","Model fitting"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"modelling dietary exposure to chemical components in heat processed meats","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/133173534/BOOK_OF_ABSTRACTS_ASMDA2017_Final.pdf","version":"Published Version"},"id":"S01-000.00-318993","ids":["dtu-3075f295-14c5-41cb-a859-869e97f4abac"],"keyword":["Burden of disease","Exposure modelling","Model fitting"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-6EE53E861D52C9DD020C85433216593A"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/133173534/BOOK_OF_ABSTRACTS_ASMDA2017_Final.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Applied Mathematics and Computer Science","Technical University of Denmark, Department of Applied Mathematics and Computer Science, Statistics and Data Analysis"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Stylianos","key":"georgiadispau","last":"Georgiadis","locid":"5b6b5ddf-4307-472f-afe5-8963892d6526","name":"Georgiadis, Stylianos","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lea Sletting","key":"jakobsenpau","last":"Jakobsen","locid":"9e99d9fd-535f-4c11-b8a7-5c5f34045060","name":"Jakobsen, Lea Sletting","orcid":"0000-0001-9666-348X","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Bo Friis","key":"nielsenpau","last":"Nielsen","locid":"364b98b5-e608-4186-a566-62fa91a37d59","name":"Nielsen, Bo Friis","orcid":"0000-0001-9146-9733","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anders","key":"stockmarrpau","last":"Stockmarr","locid":"f8ce8f15-f38a-4f99-a8c6-08b0cd7b0f6a","name":"Stockmarr, Anders","orcid":"0000-0002-8681-2370","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Elena","key":"borianipau","last":"Boriani","locid":"7eaa86eb-9bb1-4544-a89c-441797e44067","name":"Boriani, Elena","orcid":"0000-0001-9676-7297","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lene","key":"duedahlolesenpau","last":"Duedahl-Olesen","locid":"886d06e9-73a3-4df8-a0af-dc0dd8f96baa","name":"Duedahl-Olesen, Lene","orcid":"0000-0002-3162-0101","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Tine","key":"haldpau","last":"Hald","locid":"617fc5ed-9354-48d5-b831-0c8386b730d5","name":"Hald, Tine","orcid":"0000-0002-1115-9792","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Sara Monteiro","key":"pirespau","last":"Pires","locid":"eaae5296-a349-424e-aeaa-851a9e4a2510","name":"Pires, Sara Monteiro","orcid":"0000-0002-7751-1509","rank":8,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","sdg":["3. Good Health and Well-being","All UN SDG Classification"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-3075f295-14c5-41cb-a859-869e97f4abac"],"src":["DTU Technical University of Denmark"],"title":"Modelling Dietary Exposure to Chemical Components in Heat-Processed Meats","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-318993","year":"2017","yearsub":"2017"}
{"abstract":"One of the reasons for using personas is to align user understandings across project teams and sites. As part of a larger persona study, at Al Jazeera English (AJE), we conducted 16 qualitative interviews with media producers, the end users of persona descriptions. We asked the participants about their understanding of a typical AJE media consumer, and the variety of answers shows that the understandings are not aligned and are built on a mix of own experiences, own self, assumptions, and data given by the company. The answers are sometimes aligned with the data-driven personas and sometimes not. The end users are divided in two groups: news producers who have little interest in having data-based insights of news consumers and producers for social media platforms who have more interest in this information.","author_count":6,"contributors":["Nielsen, Lene","Salminen, joni","Jung, Soon-Gyo","Kwak, Haewoon","An, Jisun","Jansen, Bernard J."],"cuid":["S01-000.00-383421"],"event":{"acronym":"OzCHI","title":"Conference of the Australian Computer-Human Interaction"},"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, Middle East"],"country":["Qatar"],"glorg":["All Global Affiliations","Qatar Computing Research institute"],"keyword":["Automation","Journalism","Personas","User experience"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"who are your users comparing media professionals preconception of users to data driven personas","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82435133/Who_are_your_users_final_finalv2.pdf","version":"Published Version"},"id":"S01-000.00-383421","identifier":[{"id":"85044182588","type":"scopus"}],"ids":["itu-92ae477c-388d-4036-a4ed-1cf3c21cee5d"],"keyword":["Personas","automation","journalism","user experience"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-90A72673ADBF8D61ADF24CA10FA73BC7"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/82435133/Who_are_your_users_final_finalv2.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"qa","key":"qatar computing research institute","loc":["Qatar","Asia, Middle East"],"name":"Qatar Computing Research institute","used":1},{"affno":2,"key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"ITU IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["ITU IT University of Copenhagen"],"nora_code":"DI-U-ITU"}],"person":[{"affno":"","corresponding":null,"first":"Lene","key":"nielsenpau","last":"Nielsen","locid":"1052b289-f510-4c5a-9662-2db48c12ebc2","name":"Nielsen, Lene","orcid":"0000-0003-1768-7147","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"joni","key":"salminenpau","last":"Salminen","name":"Salminen, joni","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Soon-Gyo","key":"jungpau","last":"Jung","name":"Jung, Soon-Gyo","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Haewoon","key":"kwakpau","last":"Kwak","name":"Kwak, Haewoon","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jisun","key":"anpau","last":"An","name":"An, Jisun","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Bernard J.","key":"jansenpau","last":"Jansen","name":"Jansen, Bernard J.","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1145/3152771.3156178","eisbn":["9781450353793"],"pages":"602-606","publisher":"Association for Computing Machinery","series":"ACM International Conference Proceeding Series","status":"p","title":"OZCHI '17 Proceedings of the 29th Australian Conference on Computer-Human Interaction"},"review":"Peer Reviewed","scoID":["2-s2.0-85044182588"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","ITU IT University of Copenhagen"],"PST":["Published"]},"sid":["itu-92ae477c-388d-4036-a4ed-1cf3c21cee5d"],"src":["ITU IT University of Copenhagen"],"title":"Who are your users? : Comparing media professionals’ preconception of users to data-driven personas","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383421","year":"2017","yearsub":"2017"}
{"abstract":"BACKGROUND: Chronic non-healing or recurrent inflammatory lesions, reminiscent of infection but recalcitrant to antibiotic therapy generally characterize biofilm driven-diseases. Chronic lesions of Hidradenitis Suppurativa (HS) exhibit several aspects, which are compatible with well-known biofilm infections. OBJECTIVE: To determine and quantify the potential presence of bacterial aggregates in chronic HS lesions. METHODS: In 42 consecutive HS patients suffering from chronic lesions, biopsies were obtained from lesional as well as from perilesional skin. Samples were investigated using Peptide Nucleic Acid (PNA) - Fluorescence in situ Hybridization (FISH) in combination with Confocal Laser Scanning Microscopy (CLSM). In addition, corresponding histopathological analysis in hematoxylin and eosin slides were performed. RESULTS: Biofilms were seen in 67% of the samples of chronic lesions and in 75% of the perilesional samples. The mean diameter of aggregates in lesional skin was significantly greater than in perilesional skin (p=0.01). Biofilms exceeding 50 μm in diameter were found in 42% of lesional samples and only in only 5% of the perilesional samples (p=0.009). The majority of the large biofilms (aggregates > 50 μm in diameter) were situated in sinus tracts (63%) or in the infundibulum (37%). The majority of the sinus tract samples (73%) contained active bacterial cells, which were associated with inflammation. CONCLUSION: This study suggests that biofilm is associated with inflammation of chronic HS lesions. The aggregates most likely occur as a secondary event, possibly due to predisposing local anatomical changes such as sinus tracts (tunnels), keratinous detritus and dilated hair follicles. This article is protected by copyright. All rights reserved.","author_count":9,"contributors":["Ring, H C","Bay, Lene","Nilsson, Martin","Kallenbach, Klaus","Miller, I M","Saunte, Ditte Marie Lindhardt","Bjarnsholt, Thomas","Tolker-Nielsen, Tim","Jemec, Gregor B E"],"cuid":["S01-000.00-447302"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"bacterial biofilm in chronic lesions of hidradenitis suppurativa","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-447302","identifier":[{"id":"27564400","type":"pmid"},{"id":"85013436849","type":"scopus"}],"ids":["ku-5a15616a-f994-43f8-8766-95b67e8dbeec"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-20B7B16456DC1894F28FA38E3BEC2957"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Immunology and Microbiology, Department of Immunology and Microbiology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"","first":"H C","key":"ringpau","last":"Ring","name":"Ring, H C","rank":1,"rolecode":"pau"},{"affno":"1","first":"L","key":"baypau","last":"Bay","locid":"22f49c41-e569-43c4-8978-94bc9e411869","name":"Bay, Lene","name_org":"Bay, L","orcid":"0000-0002-4164-5900","rank":2,"rolecode":"pau"},{"affno":"1","first":"M","key":"nilssonpau","last":"Nilsson","locid":"42451f7e-e9b1-49b8-ad46-3c450430a8d2","name":"Nilsson, Martin","name_org":"Nilsson, M","orcid":"0000-0001-6251-9842","rank":3,"rolecode":"pau"},{"affno":"1","first":"K","key":"kallenbachpau","last":"Kallenbach","locid":"ced8a712-37e4-4ddf-b408-c663f56ed68c","name":"Kallenbach, Klaus","name_org":"Kallenbach, K","rank":4,"rolecode":"pau"},{"affno":"","first":"I M","key":"millerpau","last":"Miller","name":"Miller, I M","rank":5,"rolecode":"pau"},{"affno":"1","first":"D M","key":"sauntepau","last":"Saunte","locid":"7131c49a-fd53-415c-9262-44d2c738c731","name":"Saunte, Ditte Marie Lindhardt","name_org":"Saunte, D M","rank":6,"rolecode":"pau"},{"affno":"1","first":"T","key":"bjarnsholtpau","last":"Bjarnsholt","locid":"cb3ccb7d-0415-40e5-9bba-c9bc26b6316d","name":"Bjarnsholt, Thomas","name_org":"Bjarnsholt, T","orcid":"0000-0002-8003-7414","rank":7,"rolecode":"pau"},{"affno":"1","first":"T","key":"tolkernielsenpau","last":"Tolker-Nielsen","locid":"3cdd7c13-7576-4d34-8c3c-6b1bae91acc0","name":"Tolker-Nielsen, Tim","name_org":"Tolker-Nielsen, T","orcid":"0000-0002-9751-474X","rank":8,"rolecode":"pau"},{"affno":"1","first":"G B","key":"jemecpau","last":"Jemec","locid":"b963b007-18b6-4432-897f-28b6a08275be","name":"Jemec, Gregor B E","name_org":"Jemec, G B","orcid":"0000-0002-0712-2540","rank":9,"rolecode":"pau"}],"pmid":["27564400"],"pub":{"doi":"10.1111/bjd.15007","issn":["00070963","13652133"],"issn_org":["00070963"],"issue":"4","journal":"British Journal of Dermatology","pages":"993-1000","status":"p","title":"British Journal of Dermatology","volume":"176"},"review":"Peer Reviewed","scoID":["2-s2.0-85013436849"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-5a15616a-f994-43f8-8766-95b67e8dbeec"],"src":["KU University of Copenhagen"],"title":"Bacterial biofilm in chronic lesions of Hidradenitis Suppurativa","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-447302","year":"2017","yearsub":"2017"}
{"abstract":"Communicating radiological reports to peers has pedagogical value. Students may be uneasy with the process due to a lack of communication and peer review skills or to their failure to see value in the process. We describe a communication exercise with peer review in an undergraduate veterinary radiology course. The computer code used to manage the course and deliver images online is reported, and we provide links to the executable files. We tested to see if undergraduate peer review of radiological reports has validity and describe student impressions of the learning process. Peer review scores for student-generated radiological reports were compared to scores obtained in the summative multiple choice (MCQ) examination for the course. Student satisfaction was measured using a bespoke questionnaire. There was a weak positive correlation (Pearson correlation coefficient = 0.32, p < 0.01) between peer review scores students received and the student scores obtained in the MCQ examination. The difference in peer review scores received by students grouped according to their level of course performance (high vs. low) was statistically significant (p < 0.05). No correlation was found between peer review scores awarded by the students and the scores they obtained in the MCQ examination (Pearson correlation coefficient = 0.17, p = 0.14). In conclusion, we have created a realistic radiology imaging exercise with readily available software. The peer review scores are valid in that to a limited degree they reflect student future performance in an examination. Students valued the process of learning to communicate radiological findings but do not fully appreciated the value of peer review.","author_count":5,"contributors":["McEvoy, Fintan","Shen, Nicholas W","Nielsen, Dorte Hald","Buelund, Lene Elisabeth","Holm, Peter"],"cuid":["S01-000.00-514790"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"online radiology reporting with peer review as a learning and feedback tool in radiology implementation validity and student impressions","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"http://europepmc.org/articles/pmc5267598?pdf=render","version":"Authors Final Version"},"id":"S01-000.00-514790","identifier":[{"id":"84989832157","type":"scopus"},{"id":"27699520","type":"pmid"},{"id":"PMC5267598","type":"pmcid"}],"ids":["ku-cb34dcf0-9b71-4728-87da-77d69cd9867f"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-6834B560EBA2325B21A6B330A4D46937"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"http://europepmc.org/articles/pmc5267598?pdf=render","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary Clinical Sciences, Veterinary Imaging"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Fintan","key":"mcevoypau","last":"McEvoy","locid":"38cc3ea7-06d4-43f9-b239-092f41bcd16b","name":"McEvoy, Fintan","orcid":"0000-0003-4195-8816","rank":1,"rolecode":"pau"},{"affno":"","first":"Nicholas W","key":"shenpau","last":"Shen","name":"Shen, Nicholas W","rank":2,"rolecode":"pau"},{"affno":"1","first":"Dorte Hald","key":"nielsenpau","last":"Nielsen","locid":"cc3c2ecf-7eeb-4376-baa7-616bf7a33353","name":"Nielsen, Dorte Hald","rank":3,"rolecode":"pau"},{"affno":"1","first":"Lene Elisabeth","key":"buelundpau","last":"Buelund","locid":"08519bcf-e2b1-4ae0-8da9-bd7653cd8a9d","name":"Buelund, Lene Elisabeth","orcid":"0000-0002-4730-4111","rank":4,"rolecode":"pau"},{"affno":"1","first":"Peter","key":"holmpau","last":"Holm","locid":"5f502907-f04d-408f-a9c7-7a9d1f5ac7e1","name":"Holm, Peter","orcid":"0000-0003-0709-8939","rank":5,"rolecode":"pau"}],"pmid":["27699520"],"pub":{"doi":"10.1007/s10278-016-9905-x","issn":["08971889","1618727X"],"issn_org":["08971889"],"issue":"1","journal":"Journal of Digital Imaging","pages":"78-85","status":"p","title":"Journal of Digital Imaging","volume":"30"},"review":"Peer Reviewed","scoID":["2-s2.0-84989832157"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-cb34dcf0-9b71-4728-87da-77d69cd9867f"],"src":["KU University of Copenhagen"],"title":"Online Radiology Reporting with Peer Review as a Learning and Feedback Tool in Radiology; Implementation, Validity, and Student Impressions","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-514790","year":"2017","yearsub":"2017"}
{"abstract":"Accurate methods to assess the pathogenicity of mutations are needed to fully leverage the possibilities of genome sequencing in diagnosis. Current data-driven and bioinformatics approaches are, however, limited by the large number of new variations found in each newly sequenced genome, and often do not provide direct mechanistic insight. Here we demonstrate, for the first time, that saturation mutagenesis, biophysical modeling and co-variation analysis, performed in silico, can predict the abundance, metabolic stability, and function of proteins inside living cells. As a model system, we selected the human mismatch repair protein, MSH2, where missense variants are known to cause the hereditary cancer predisposition disease, known as Lynch syndrome. We show that the majority of disease-causing MSH2 mutations give rise to folding defects and proteasome-dependent degradation rather than inherent loss of function, and accordingly our in silico modeling data accurately identifies disease-causing mutations and outperforms the traditionally used genetic disease predictors. Thus, in conclusion, in silico biophysical modeling should be considered for making genotype-phenotype predictions and for diagnosis of Lynch syndrome, and perhaps other hereditary diseases.","author_count":10,"contributors":["Nielsen, Sofie V,","Stein, Amelie","Dinitzen, Alexander B.","Papaleo, Elena","Tatham, Michael H.","Poulsen, Esben Guldahl","Kassem, Maher M.","Rasmussen, Lene Juel","Lindorff-Larsen, Kresten","Hartmann-Petersen, Rasmus"],"cuid":["S01-000.00-535060"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Journal Article"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-NP","DI-U"],"level3":{"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-NP-CAN","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"predicting the impact of lynch syndrome causing missense mutations from structural calculations","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pgen.1006739","version":"Published Version"},"id":"S01-000.00-535060","identifier":[{"id":"28422960","type":"pmid"},{"id":"PMC5415204","type":"pmcid"},{"id":"85018453754","type":"scopus"}],"ids":["ku-ed42aa85-6015-4eaa-84d4-3665c71a4a1a"],"keyword":["Journal Article"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-40BFC3EC0C9CFF43C262A9D6E7FE265B"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1371/journal.pgen.1006739","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/179882467/Nielsen_2017_Predicting_the_impact.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2017","yearSub":"2017"},"org":[{"affno":"1","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"dcrc danish cancer society research center","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-CAN","l3nn":"DCRC Danish Cancer Society Research Center","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DCRC Danish Cancer Society Research Center","namevar":["Danish Cancer Society"],"nora_code":"DI-NP-CAN","used":1}],"person":[{"affno":"1","first":"Sofie V,","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Sofie V,","rank":1,"rolecode":"pau"},{"affno":"1","first":"Amelie","key":"steinpau","last":"Stein","locid":"883406ce-8afb-4747-a574-9c46516128db","name":"Stein, Amelie","orcid":"0000-0002-5862-1681","rank":2,"rolecode":"pau"},{"affno":"1","first":"Alexander B.","key":"dinitzenpau","last":"Dinitzen","name":"Dinitzen, Alexander B.","rank":3,"rolecode":"pau"},{"affno":"2","first":"Elena","key":"papaleopau","last":"Papaleo","name":"Papaleo, Elena","rank":4,"rolecode":"pau"},{"affno":"","first":"Michael H.","key":"tathampau","last":"Tatham","name":"Tatham, Michael H.","rank":5,"rolecode":"pau"},{"affno":"1","first":"Esben Guldahl","key":"poulsenpau","last":"Poulsen","locid":"8df6e586-caaa-4cc6-9dc3-e12933693fa2","name":"Poulsen, Esben Guldahl","rank":6,"rolecode":"pau"},{"affno":"1","first":"Maher Mahmoud","key":"kassempau","last":"Kassem","locid":"1f5eec94-7307-4a11-ac12-00973bba7c01","name":"Kassem, Maher M.","name_org":"Kassem, Maher Mahmoud","rank":7,"rolecode":"pau"},{"affno":"1","first":"Lene Juel","key":"rasmussenpau","last":"Rasmussen","locid":"54d5267c-3c91-45bc-ace5-1d0edb1b250d","name":"Rasmussen, Lene Juel","rank":8,"rolecode":"pau"},{"affno":"1","first":"Kresten","key":"lindorfflarsenpau","last":"Lindorff-Larsen","locid":"be20a4d8-92c4-44b9-9dfb-b6ad6471a58c","name":"Lindorff-Larsen, Kresten","orcid":"0000-0002-4750-6039","rank":9,"rolecode":"pau"},{"affno":"1","first":"Rasmus","key":"hartmannpetersenpau","last":"Hartmann-Petersen","locid":"fea900ee-b167-45e9-af2c-00038ff06862","name":"Hartmann-Petersen, Rasmus","orcid":"0000-0002-4155-7791","rank":10,"rolecode":"pau"}],"pmid":["28422960"],"pub":{"doi":"10.1371/journal.pgen.1006739","issn":["15537390","15537404"],"issn_org":["15537390"],"issue":"4","journal":"PLoS Genetics","paperid":"e1006739","status":"p","title":"PLoS Genetics","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-85018453754"],"search":{"DAF":["All Danish Affiliations","All Non-Profit Organisations","All Universities","DI-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Non-Profit Organisations","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-ed42aa85-6015-4eaa-84d4-3665c71a4a1a"],"src":["KU University of Copenhagen"],"title":"Predicting the impact of Lynch syndrome-causing missense mutations from structural calculations","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-535060","year":"2017","yearsub":"2017"}
{"abstract":"Introduction: Individual Placement and Support (IPS) is an evidence-based recovery-oriented intervention where employment specialists (ES) support persons with severe mental illness in achieving competitive employment. IPS is labelled a recovery-oriented intervention; although, the influence of IPS on outcomes often referred to as recovery measures i.e. symptoms and self-esteem is ambiguous. One branch of the recovery literature distinguishes between two kinds of recovery. The one, personal recovery is defined by: what helps the individual move beyond the role of being a patient with a mental illness. The other, clinical recovery is defined as symptom reduction and increased level of functioning. Aim: To investigate how an IPS-intervention influences the personal and clinical recovery in persons with severe mental illness. Method: A qualitative phenomenological study including interview of 12 participants in an IPS intervention. Results: IPS contributed to personal recovery in a number of ways: The ES created an equal, acknowledging and safe relationship where participants’ needs were taking into consideration in the search and support for employment. Both employment and the ES contributed to normalization and stabilisation of participants’ daily lives and changed their behaviours and beliefs about personal goals and dreams. The study found nuances in how IPS and employment were perceived to have influenced clinical recovery. Participants suffering from psychotic symptoms were clearly of the opinion that neither IPS nor employment influenced symptom severity. In contrast to this, participants suffering from negative or depressive symptoms described how employment helped them get up in the morning and structure the day. Also, fellowship with colleagues was found important. Conclusion: The present study indicates that IPS and employment have an impact on personal recovery and may decrease depressive symptoms, but does not seem to have an impact on psychotic symptoms.","author_count":6,"contributors":["Nielsen, Iben Gammelgaard","Stenager, Elsebeth","Eplov, Lene","Petersen, Kirsten Schultz","Christensen, Thomas Nordahl","Jensen, Sofie Bratberg"],"cuid":["S01-000.00-595191"],"event":{"end":"2017-09-22","place":"København, dk","start":"2017-09-20","title":"8th Together Against Stigma Conference","year":"2017"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-AAU","DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-AAU","DI-U-KU","DI-U-SDU"]},"review":"nr","rtype":["clu"],"sorti":"personal and clinical recovery with the individual placement and support intervention in denmark","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-595191","ids":["sdu-4caad48e-03cb-4312-b9c8-c8bf35e1564e"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-CE7FA8B31D6E27115AFEDE52902F0F55"],"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Psychiatry (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Psykiatrisk Center København"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","country":"dk","key":"aau aalborg university","l