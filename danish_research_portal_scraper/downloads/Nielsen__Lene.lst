psykiske lidelser, afd. M","Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Enheden for Psykiatrisk Forskning, Aalborg Psykiatriske Sygehus"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"Jørgen","key":"aagaardpau","last":"Aagaard","locid":"f14091e9-bd87-49df-ad87-44f237ac433d","name":"Aagaard, Jørgen","orcid":"0000-0001-9476-0585","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Christian","key":"skadhedepau","last":"Skadhede","locid":"895c35c1-c278-4803-b9f2-b7ce31c8b148","name":"Skadhede, Søren Christian","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mette Brændstrup","key":"andersenpau","last":"Andersen","locid":"85df13ae-0880-463c-8eb0-0cd736d0f117","name":"Andersen, Mette Braendstrup","name_org":"Andersen, Mette Brændstrup","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Pernille","key":"kølbækpau","last":"Kølbæk","locid":"78291a6c-7e25-4b98-a1ed-464513da22f5","name":"Kølbæk, Pernille","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lene Halling","key":"hastruppau","last":"Hastrup","locid":"abc29c19-8188-45d5-b55d-d90d837b29c6","name":"Hastrup, Lene Halling","rank":5,"rolecode":"pau"},{"affno":"1 2","corresponding":null,"country":"dk","first":"Leslie","key":"foldagerpau","last":"Foldager","locid":"ccf3b6e1-f7d9-4f84-8d29-8bb539e601b2","name":"Foldager, Leslie","orcid":"0000-0002-2639-826X","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jørgen Achton","key":"nielsenpau","last":"Nielsen","locid":"0863a107-6b16-492c-ad93-c869b789d2eb","name":"Nielsen, Jørgen Achton","rank":7,"rolecode":"pau"}],"pub":{"isbn":["9788771121711"],"pages":"266","publisher":"Aalborg Universitetsforlag","status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-a6e80464-89cf-4e65-9d73-fde99e8b24c8","au-fb2e773a-3a46-498b-9808-ca01f16fcd38"],"src":["AAU Aalborg University","AU Aarhus University"],"title":"Opsøgende Psykoseteams i Region Nordjylland : En monitoreringsundersøgelse med to års opfølgning af de Opsøgende Psykoseteams i Region Nordjylland og en registerbaseret undersøgelse af udviklingen i voksenpsykiatrien i Region Nordjylland","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-094.12-008074","year":"2014","yearsub":"2014"}
{"abstract":"OBJECTIVE: Several studies have shown an increase in beta cell mass during pregnancy. Somatolactogenic hormones are known to stimulate the proliferation of existing beta cells in rodents whereas the mechanism in humans is still unclear. We hypothesize that in addition to somatolactogenic hormones there are other circulating factors involved in beta cell adaptation to pregnancy. This study aimed at screening for potential pregnancy-associated circulating beta cell growth factors. SAMPLES: Serum samples from nonpregnant and pregnant women. METHODS: The effect of serum from pregnant women on the proliferation of rat beta cells was studied using [3H]thymidine incorporation and 5-ethynyl-2'-deoxyuridine proliferation assays. In addition, serum from pregnant and nonpregnant women was fractionated by gel filtration and high performance liquid chromatography. The fractionated serum was screened for mitogenic activity in INS-1E cells. Proteins and peptides in mitogenic active serum fractions were identified by amino acid sequencing and mass spectrometry. MAIN OUTCOME MEASURES: Presence of circulating beta cell proliferating factors. RESULTS: Late gestational pregnancy serum significantly increased proliferation of rat beta cells compared with early pregnancy and nonpregnancy. The mitogenic active serum fractions contained proteins and peptides derived from kininogen-1, fibrinogen-α, α1-antitrypsin, apolipoprotein-A1, placental lactogen, angiotensinogen and serum albumin. CONCLUSION: Pregnancy serum is able to stimulate proliferation of rat beta cells. We have identified several circulating factors that may contribute to beta cell adaptation to pregnancy. Further studies are needed to elucidate their possible role in glucose homeostasis in the mother and her offspring.","author_count":11,"contributors":["Nalla, Amarnadh","Ringholm, Lene","Søstrup, Birgitte","Højrup, Peter","Thim, Lars","Levery, Steven B","Vakhrushev, Sergey Y.","Billestrup, Nils","Mathiesen, Elisabeth R.","Damm, Peter","Nielsen, Jens Høiriis"],"cuid":["S02-100.00-040910"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"keyword":["Adaptation Physiological","Adult","Amino Acid Sequence","Angiotensinogen","Animals","Animals Newborn","Apolipoprotein A I","Beta cells","Biological Markers","Cell Proliferation","Cells Cultured","Chromatography Gel","Chromatography High Pressure Liquid","Female","Fibrinogen","Growth factors","Humans","Insulin Secreting Cells","Islets","Kininogens","Mass spectrometry","Placental Lactogen","Pregnancy","Pregnancy Trimesters","Proliferation","Rats","Rats Wistar","Serum Albumin","Survival","alpha 1 Antitrypsin"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"implications for the offspring of circulating factors involved in beta cell adaptation in pregnancy","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1111/aogs.12505","version":"Other Version"},"id":"S02-100.00-040910","identifier":[{"id":"84911998201","type":"scopus"},{"id":"25223212","type":"pmid"}],"ids":["ku-251c23c5-3ccb-4dea-92b1-2b2c336c6815","sdu-8bb9bc42-3bf1-4f29-b793-20bed55d1514"],"keyword":["Adaptation, Physiological","Adult","Amino Acid Sequence","Angiotensinogen","Animals","Animals, Newborn","Apolipoprotein A-I","Biological Markers","Cell Proliferation","Cells, Cultured","Chromatography, Gel","Chromatography, High Pressure Liquid","Female","Fibrinogen","Humans","INS-1E cell line","Insulin-Secreting Cells","Kininogens","Mass Spectrometry","Placental Lactogen","Pregnancy","Pregnancy Trimesters","Rats","Rats, Wistar","Serum Albumin","alpha 1-Antitrypsin","beta cells","growth factors","islets","proliferation","survival"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-B22264ADB1BFC6BCA3CC0B747DE64ED3"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1111/aogs.12505","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Biomedical Sciences, Inflammation, Metabolism and Oxidation"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Science, Department of Biochemistry and Molecular Biology"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","country":"dk","first":"Amarnadh","key":"nallapau","last":"Nalla","locid":"5d946eef-54a5-495c-a24e-7c7182ca6308","name":"Nalla, Amarnadh","rank":1,"rolecode":"pau"},{"affno":"","first":"Lene","key":"ringholmpau","last":"Ringholm","name":"Ringholm, Lene","rank":2,"rolecode":"pau"},{"affno":"1","first":"Birgitte","key":"søstruppau","last":"Søstrup","locid":"e0e37369-8ef9-40b3-a112-7fe932fcdfca","name":"Søstrup, Birgitte","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Peter","key":"højruppau","last":"Højrup","locid":"1dc527ba-e681-4af1-88fb-6383c95d07b7","name":"Højrup, Peter","orcid":"0000-0002-7838-6180","rank":4,"rolecode":"pau"},{"affno":"","first":"Lars","key":"thimpau","last":"Thim","name":"Thim, Lars","rank":5,"rolecode":"pau"},{"affno":"1","first":"Steven B","key":"leverypau","last":"Levery","locid":"d4195b2b-1f0d-4a00-83fd-e0c67c5c94c4","name":"Levery, Steven B","rank":6,"rolecode":"pau"},{"affno":"1","first":"Sergey Y","key":"vakhrushevpau","last":"Vakhrushev","locid":"9d7a6af7-6053-4ce2-93ea-a93a65c04343","name":"Vakhrushev, Sergey Y.","name_org":"Vakhrushev, Sergey Y","rank":7,"rolecode":"pau"},{"affno":"1","first":"Nils","key":"billestruppau","last":"Billestrup","locid":"1bf87015-1964-43ef-aeb8-e881122790eb","name":"Billestrup, Nils","orcid":"0000-0002-4968-8067","rank":8,"rolecode":"pau"},{"affno":"1","first":"Elisabeth R","key":"mathiesenpau","last":"Mathiesen","locid":"3acd58f4-6d64-4a89-a406-d2f43b310500","name":"Mathiesen, Elisabeth R.","name_org":"Mathiesen, Elisabeth R","rank":9,"rolecode":"pau"},{"affno":"1","first":"Peter","key":"dammpau","last":"Damm","locid":"884d03d5-5981-4d33-80c6-adb21f836deb","name":"Damm, Peter","rank":10,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Jens H","key":"nielsenpau","last":"Nielsen","locid":"181203c6-f69f-4d68-a0e4-e4f609517862","name":"Nielsen, Jens Høiriis","name_org":"Nielsen, Jens H","orcid":"0000-0001-8252-3048","rank":11,"rolecode":"pau"}],"pmid":["25223212"],"pub":{"doi":"10.1111/aogs.12505","issn":["00016349"],"issue":"11","journal":"Acta Obstetricia et Gynecologica Scandinavica","pages":"1181-1189","publisher":"Wiley","status":"p","title":"Acta Obstetricia et Gynecologica Scandinavica","volume":"93"},"review":"Peer Reviewed","scoID":["2-s2.0-84911998201"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-251c23c5-3ccb-4dea-92b1-2b2c336c6815","sdu-8bb9bc42-3bf1-4f29-b793-20bed55d1514"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Implications for the offspring of circulating factors involved in beta cell adaptation in pregnancy","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-040910","year":"2014","yearsub":"2014"}
{"abstract":"Paired-pulse transcranial magnetic stimulation (ppTMS) can be used to assess short-interval intracortical inhibitory (SICI) and facilitatory (ICF) networks. Many methodological parameters may however influence the outcome. The aim of the study was to examine the influence of body positions (recline and supine), inter-stimulus intervals (ISI) between the test stimulus (TS) and conditioning stimulus (CS) and intensities of the TS and CS on the degree of SICI and ICF. In study 1 and 2, fourteen and seventeen healthy volunteers participated respectively. ppTMS was applied over the \"hot-spot\" of the tongue motor cortex and motor evoked potentials (MEPs) were recorded from contralateral tongue muscles. In study 1, single pulse and three ppTMS ISIs: 2, 10, 15 ms were applied 8 times each in three blocks (TS: 120%, 140% and 160% of resting motor threshold (rMT); CS: 80% of rMT) in two different body positions (recline and supine) randomly. In study 2, single pulse and four ppTMS ISIs: 2, 2.5, 3, 3.5 ms were applied 8 times each in randomized order in two blocks (CS: 70% and 80% of rMT; TS: 120% of rMT). There was a significant effect of body position (P=0.049), TS intensities (P<0.001) and ISIs (P<0.001) and interaction between intensity and ISIs (P=0.042) in study 1. In study 2, there was a significant effect of ISI (P<0.001) but not CS intensity (P = 0.984) on MEP amplitude. These results may be applied in future studies on the mechanisms of cortical plasticity in the tongue motor pathways using ppTMS and SICI and ICF.","author_count":4,"contributors":["Kothari, Mohit","Svensson, Peter","Nielsen, Jørgen Feldbæk","Baad-Hansen, Lene"],"cuid":["S01-000.00-147589"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"influence of position and stimulation parameters on intracortical inhibition and facilitation in human tongue motor cortex","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.brainres.2014.02.017","version":"Other Version"},"id":"S01-000.00-147589","identifier":[{"id":"24534367","type":"pmid"},{"id":"84896548645","type":"scopus"}],"ids":["au-1fdcf3b7-43c4-41e6-8c4d-4a3d18bb27c1"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-F7D5757AECA9AB4BB2C64C49F649C1F4"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.ncbi.nlm.nih.gov/pubmed/24534367","version":"Other Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.brainres.2014.02.017","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University (AU)","Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Regionshospital Hammel Neurocenter","Aarhus University, Health, Department of Dentistry and Oral Health, Department of Dentistry and Oral Health - Section for Orofacial Pain and Jaw Function"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Mohit","key":"kotharipau","last":"Kothari","locid":"04b2613a-b642-417f-9f1d-08167c4832ec","name":"Kothari, Mohit","orcid":"0000-0002-8191-9769","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peter","key":"svenssonpau","last":"Svensson","locid":"163ec423-3f89-45a0-8cd8-81455aa6a507","name":"Svensson, Peter","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jørgen Feldbæk","key":"nielsenpau","last":"Nielsen","locid":"3fb25b9f-381b-44a6-a8dd-26eacf839d37","name":"Nielsen, Jørgen Feldbæk","orcid":"0000-0001-5339-171X","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lene","key":"baadhansenpau","last":"Baad-Hansen","locid":"6938b236-4958-4da7-bbeb-dccb0abc973c","name":"Baad-Hansen, Lene","orcid":"0000-0002-2399-7910","rank":4,"rolecode":"pau"}],"pmid":["24534367"],"pub":{"doi":"10.1016/j.brainres.2014.02.017","issn":["00068993","18726240"],"issn_org":["00068993"],"journal":"Brain Research","pages":"83-89","publisher":"Elsevier BV","publisher_org":"Elsevier B.V.","status":"p","title":"Brain Research","volume":"1557"},"review":"Peer Reviewed","scoID":["2-s2.0-84896548645"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-1fdcf3b7-43c4-41e6-8c4d-4a3d18bb27c1"],"src":["AU Aarhus University"],"title":"Influence of position and stimulation parameters on intracortical inhibition and facilitation in human tongue motor cortex","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-147589","year":"2014","yearsub":"2014"}
{"author_count":6,"contributors":["Kothari, Mohit","Svensson, Peter","Jensen, Jim","Kjærsgaard, Annette","Baad-Hansen, Lene","Nielsen, Jørgen Feldbæk"],"cuid":["S01-000.00-175877"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"tongue motor training behavioral and neurophysiological aspects","src":["au"],"src-code":["DI-U-AU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85037703010","version":"Other Version"},"id":"S01-000.00-175877","identifier":[{"id":"85037703010","type":"scopus"}],"ids":["au-519e0915-1912-4dee-b364-6f9299e67e9f"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-A6C1ABC839F95C54ED5A483DA7E43A95"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Regionshospital Hammel Neurocenter"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Mohit","key":"kotharipau","last":"Kothari","locid":"04b2613a-b642-417f-9f1d-08167c4832ec","name":"Kothari, Mohit","orcid":"0000-0002-8191-9769","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peter","key":"svenssonpau","last":"Svensson","locid":"163ec423-3f89-45a0-8cd8-81455aa6a507","name":"Svensson, Peter","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jim","key":"jensenpau","last":"Jensen","locid":"cc3d0e7d-b138-48ac-808f-01b64060da14","name":"Jensen, Jim","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Annette","key":"kjærsgaardpau","last":"Kjærsgaard","locid":"1658b2ce-3e2b-4db3-b619-db3b89d8d337","name":"Kjærsgaard, Annette","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lene","key":"baadhansenpau","last":"Baad-Hansen","locid":"6938b236-4958-4da7-bbeb-dccb0abc973c","name":"Baad-Hansen, Lene","orcid":"0000-0002-2399-7910","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jørgen Feldbæk","key":"nielsenpau","last":"Nielsen","locid":"3fb25b9f-381b-44a6-a8dd-26eacf839d37","name":"Nielsen, Jørgen Feldbæk","orcid":"0000-0001-5339-171X","rank":6,"rolecode":"pau"}],"pub":{"eisbn":["9783319080727"],"pages":"47-48","publisher":"SpringerLink","status":"p","title":"Replace, Repair, Restore, Relieve – Bridging Clinical and Engineering Solutions in Neurorehabilitation","volume":"7"},"review":"Peer Reviewed","scoID":["2-s2.0-85037703010"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-519e0915-1912-4dee-b364-6f9299e67e9f"],"src":["AU Aarhus University"],"title":"Tongue Motor Training – Behavioral and Neurophysiological Aspects","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-175877","year":"2014","yearsub":"2014"}
{"abstract":"Work is known to be one of the main sources of human identity. It might be threatened when ill-health impairs individual labour market participation. Vocational rehabilitation, which is based on the bio-psycho-social model of health and function, is the systematic approach to improve employability for those who suffer from health-related disabilities. This article gives a short historical overview about vocational rehabilitation in Denmark, describes the current structural and political framework and gives practice examples of local multidisciplinary and intersectoral rehabilitation efforts.","author_count":4,"contributors":["Labriola, Merete","Thielen, Karsten","Eplov, Lene Falgaard","Nielsen, Claus Vinther"],"cuid":["S01-000.00-202412"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"vocational rehabilitation","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://www.ncbi.nlm.nih.gov/pubmed/25096745","version":"Other Version"},"id":"S01-000.00-202412","identifier":[{"id":"85040608188","type":"scopus"},{"id":"25096745","type":"pmid"}],"ids":["au-7fb8d85a-268b-4038-abea-158a57bd700b"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-4-7-8EFCFC2668E5C2914602B1E3CFF851F1"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.ncbi.nlm.nih.gov/pubmed/25096745","version":"Other Version"}],"oai":{"class":"Blocked","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Public Health"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Merete","key":"labriolapau","last":"Labriola","locid":"6fe9ccaf-d3e1-48eb-9b28-581200e407ea","name":"Labriola, Merete","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Karsten","key":"thielenpau","last":"Thielen","name":"Thielen, Karsten","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Lene Falgaard","key":"eplovpau","last":"Eplov","name":"Eplov, Lene Falgaard","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Claus Vinther","key":"nielsenpau","last":"Nielsen","locid":"033d1aa9-948f-4ed4-be3e-200d0100b399","name":"Nielsen, Claus Vinther","orcid":"0000-0002-2467-1103","rank":4,"rolecode":"pau"}],"pmid":["25096745"],"pub":{"issn":["00415782","13994174"],"issn_org":["00415782"],"issue":"10","journal":"Ugeskrift for Læger","publisher":"Almindelige Danske Lægeforening","status":"p","title":"Ugeskrift for Læger","volume":"176"},"review":"Peer Reviewed","scoID":["2-s2.0-84900329953","2-s2.0-85040608188"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-7fb8d85a-268b-4038-abea-158a57bd700b"],"src":["AU Aarhus University"],"title":"Vocational rehabilitation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-202412","year":"2014","yearsub":"2014"}
{"abstract":"Paired-pulse transcranial magnetic stimulation (ppTMS) can be used to assess short-interval intracortical inhibitory (SICI) and facilitatory (ICF) networks. The aim of the study was to examine the influence of body positions (recline and supine), inter-stimulus intervals (ISI) between the test stimulus (TS) and conditioning stimulus (CS) and intensities of the TS and CS on the degree of SICI and ICF. In study 1 and 2, fourteen and seventeen healthy volunteers participated respectively. ppTMS was applied over the “hot-spot” of the tongue motor cortex and motor evoked potentials (MEPs) were recorded from contralateral tongue muscles. In study 1, single pulse and three ppTMS ISIs: 2, 10, 15 ms were applied 8 times each in three blocks (TS: 120%, 140% and 160% of resting motor threshold (rMT); CS: 80% of rMT) in two different body positions (recline and supine) randomly. In study 2, single pulse and four ppTMS ISIs: 2, 2.5, 3, 3.5 ms were applied 8 times each in randomized order in two blocks (CS: 70% and 80% of rMT; TS: 120% of rMT). There was a significant effect of body position (P=0.049), TS intensities (P<0.001) and ISIs (P<0.001) and interaction between intensity and ISIs (P=0.042) in study 1. In study 2, there was a significant effect of ISI (P<0.001) but not CS intensity (P = 0.984) on MEP amplitude. These results may be applied in future studies on the effect of tongue training on SICI and ICF in the tongue motor cortex.","author_count":4,"contributors":["Kothari, Mohit","Svensson, Peter","Nielsen, Jørgen Feldbæk","Baad-Hansen, Lene"],"cuid":["S01-000.00-202963"],"event":{"end":"2014-04-12","place":"Istanbul, tr","start":"2014-04-08","title":"8th World Congress for NeuroRehabilitation","year":"2014"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"influence of position and stimulation parameters on intracortical inhibition and facilitation in human tongue motor cortex","src":["au"],"src-code":["DI-U-AU"],"type":"dco","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"http://wcnr2014.org/home-24.html","version":"Other Version"},"id":"S01-000.00-202963","identifier":[{"id":"84896548645","type":"scopus"}],"ids":["au-80cf94bc-ef51-4347-97b9-d651d45c0de4"],"keyword":["Paired pulse transcranial magnetic stimulation (ppTMS)","body positions","conditioning stimulus (CS)","short-interval intra cortical inhibitory (SICI) and facilitatory (ICF)","test stimulus (TS)"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-511310AB9E32A0EF10DF69F37E5E9C3C"],"oa_link":[{"access":"oa","type":"rem","url":"http://wcnr2014.org/home-24.html","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Regionshospital Hammel Neurocenter","Aarhus University, Health, Department of Dentistry and Oral Health, Department of Dentistry and Oral Health - Section for Orofacial Pain and Jaw Function"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Mohit","key":"kotharipau","last":"Kothari","locid":"04b2613a-b642-417f-9f1d-08167c4832ec","name":"Kothari, Mohit","orcid":"0000-0002-8191-9769","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peter","key":"svenssonpau","last":"Svensson","locid":"163ec423-3f89-45a0-8cd8-81455aa6a507","name":"Svensson, Peter","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jørgen Feldbæk","key":"nielsenpau","last":"Nielsen","locid":"3fb25b9f-381b-44a6-a8dd-26eacf839d37","name":"Nielsen, Jørgen Feldbæk","orcid":"0000-0001-5339-171X","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lene","key":"baadhansenpau","last":"Baad-Hansen","locid":"6938b236-4958-4da7-bbeb-dccb0abc973c","name":"Baad-Hansen, Lene","orcid":"0000-0002-2399-7910","rank":4,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-80cf94bc-ef51-4347-97b9-d651d45c0de4"],"src":["AU Aarhus University"],"title":"Influence of position and stimulation parameters on intracortical inhibition and facilitation in human tongue motor cortex.","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-202963","year":"2014","yearsub":"2014"}
{"abstract":"Secondary metabolites in filamentous fungi constitute a rich source of bioactive molecules. We have deduced the genetic and biosynthetic pathway of the antibiotic yanuthone D from Aspergillus niger. Our analyses show that yanuthone D is a meroterpenoid derived from the polyketide 6-methylsalicylic acid (6-MSA). Yanuthone D formation depends on a cluster composed of ten genes including yanA and yanI, which encode a 6-MSA polyketide synthase and a previously undescribed O-mevalon transferase, respectively. In addition, several branching points in the pathway were discovered, revealing five yanuthones (F, G, H, I, and J). Furthermore, we have identified another compound (yanuthone X1) that defines a class of yanuthones that depend on several enzymatic activities encoded by genes in the yan cluster but that are not derived from 6-MSA.","author_count":9,"contributors":["Holm, Dorte Koefoed","Petersen, Lene Maj","Klitgaard, Andreas","Knudsen, Peter Boldsen","Jarczynska, Zofia Dorota","Nielsen, Kristian Fog","Gotfredsen, Charlotte Held","Larsen, Thomas Ostenfeld","Mortensen, Uffe Hasbro"],"cuid":["S01-000.00-307532"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"molecular and chemical characterization of the biosynthesis of the 000000000006 msa derived meroterpenoid yanuthone d in aspergillus niger","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/92014389/14000702.pdf","version":"Published Version"},"id":"S01-000.00-307532","identifier":[{"id":"24684908","type":"pmid"},{"id":"84899660194","type":"scopus"}],"ids":["dtu-09c4c6e6-aad1-4098-a088-abcfc1f08365"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-2A31541B6A3F47E7FB0CE779CB188263"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/92014389/14000702.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.chembiol.2014.01.013","version":"Other Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Systems Biology"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Dorte Koefoed","key":"holmpau","last":"Holm","locid":"aedc7b19-7dd8-4af4-a8cc-5a73f5783c91","name":"Holm, Dorte Koefoed","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lene Maj","key":"petersenpau","last":"Petersen","locid":"7a1c5a02-7eb8-40e3-a1ec-621fb3c37652","name":"Petersen, Lene Maj","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andreas","key":"klitgaardpau","last":"Klitgaard","locid":"8b3059db-d003-40fc-a4d1-4997854cc657","name":"Klitgaard, Andreas","orcid":"0000-0002-2533-570X","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter Boldsen","key":"knudsenpau","last":"Knudsen","locid":"991df7f2-a085-49ce-a926-da127ba3b28b","name":"Knudsen, Peter Boldsen","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Zofia Dorota","key":"jarczynskapau","last":"Jarczynska","locid":"813bfd50-3a65-4867-a113-149ff7951868","name":"Jarczynska, Zofia Dorota","orcid":"0000-0001-6959-3260","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kristia