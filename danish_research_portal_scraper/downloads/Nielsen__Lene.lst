olajsen","locid":"6ea92833-c543-4b4c-988b-cf19e64d2104","name":"Nikolajsen, Lone","orcid":"0000-0002-2705-7088","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Karsten","key":"krønerpau","last":"Krøner","locid":"7d83d81f-fcb6-4c5b-89a2-66b3372934af","name":"Krøner, Karsten","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Henning","key":"mølgaardpau","last":"Mølgaard","locid":"601d1640-0a48-4ffb-99fa-e4686f780aa2","name":"Mølgaard, Henning","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lene Vase","key":"toftpau","last":"Toft","locid":"efb21f77-3dc3-425c-b185-d30c3518d8ba","name":"Vase, Lene","name_org":"Toft, Lene Vase","orcid":"0000-0002-0379-2256","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Troels Staehelin","key":"jensenpau","last":"Jensen","locid":"e1a6c2c8-3a85-464d-a1b3-53c8bab37d6d","name":"Jensen, Troels Staehelin","orcid":"0000-0002-3487-6380","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Astrid J.","key":"terkelsenpau","last":"Terkelsen","locid":"ece82e2e-ff5a-4e1b-ad66-e9cdd022347d","name":"Terkelsen, Astrid Juhl","name_org":"Terkelsen, Astrid J.","orcid":"0000-0001-6708-1958","rank":7,"rolecode":"pau"}],"pmid":["25532557"],"pub":{"doi":"10.1111/aas.12457","issn":["00015172"],"issue":"4","journal":"Acta Anaesthesiologica Scandinavica","pages":"475-485","publisher":"Blackwell Munksgaard","status":"p","title":"Acta Anaesthesiologica Scandinavica","volume":"59"},"review":"Peer Reviewed","scoID":["2-s2.0-84925329267"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-f07f7f84-c521-4540-8b23-00faf6c1111f"],"src":["AU Aarhus University"],"title":"Pre-operative baroreflex sensitivity and efferent cardiac parasympathetic activity are correlated with post-operative pain","type":"Journa