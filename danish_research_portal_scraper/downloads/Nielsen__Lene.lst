nding":null,"country":"dk","first":"Jan","key":"nielsenpau","last":"Nielsen","locid":"d59d1209-447c-4660-bc17-af58d6b9461b","name":"Nielsen, Jan","orcid":"0000-0002-9961-2933","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Finn","key":"sivebækpau","last":"Sivebæk","locid":"3920d0d1-fd80-49b6-82ee-fc1a5139b312","name":"Sivebæk, Finn","orcid":"0000-0002-6892-2947","rank":5,"rolecode":"pau"}],"pub":{"issn":["19040385"],"issue":"39","journal":"Miljø- & vandpleje","pages":"10-15","status":"p","title":"Miljø- & vandpleje","title_org":"Miljoe- & Vandpleje (Online)"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-631326f5-559a-4ae6-9450-3aec5929e598"],"src":["DTU Technical University of Denmark"],"title":"DTU Aqua viser vejen til bedre fiskeri i søerne","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-334078","year":"2014","yearsub":"2014"}
{"abstract":"Within recent years, researchers have looked into using polycaprolactone (PCL) as a synthetic biodegradable scaffold for tissue engineering purposes. This study investigated the mechanical properties of an electrospun PCL, while being exposed to physiological fluids at 37C (in vitro conditions) with and without the influence of cell in-growth. The molecular weight and mechanical properties were monitored during the degradation. Incubation in physiological fluids for 3–16 weeks showed an improvement in mechanical properties and no reduction in molecular weight. It was also shown that cells did not deteriorate the mechanical properties of PCL after 16 weeks. The viability of the cells decreased over time, however, without influencing the mechanical properties of the scaffold. A relation between reduction in molecular weight and the mechanical properties of electrospun PCL was seen between 2–29 days in buffer (pH 12). The accelerated study showed a linear decrease in both elastic modulus and yield stress as a function of degradation time.","author_count":4,"contributors":["Løvdal, Alexandra Liv Vest","Vange, Jakob","Nielsen, Lene Feldskov","Almdal, Kristoffer"],"cuid":["S01-000.00-374688"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Electrospinning","Fibroblasts","In vitro","In vitro degradation","Mechanical properties"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-COLO"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-PR-COLO","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"mechanical properties of electrospun pcl scaffold under in vitro and accelerated degradation conditions","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.4015/S1016237214500434","version":"Other Version"},"id":"S01-000.00-374688","identifier":[{"id":"84896485087","type":"scopus"}],"ids":["dtu-ea586e83-678b-46a1-97ee-19bb96ea8bf1"],"keyword":["Electrospinning","Fibroblasts","In vitro","In vitro degradation","Mechanical properties","Polycaprolactone (PCL)"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-1396DD092EE96914FCE94F1D5147EB8B"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.4015/S1016237214500434","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Micro- and Nanotechnology","Technical University of Denmark, Department of Micro- and Nanotechnology, Amphiphilic Polymers in Biological Sensing"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"coloplast","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-COLO","l3nl":"Coloplast Group","l3nn":"Coloplast","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Coloplast","namevar":["Coloplast Danmark AS"],"nora_code":"DI-PR-COLO","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Alexandra Liv Vest","key":"løvdalpau","last":"Løvdal","locid":"db8a6462-5cec-46aa-9eec-150ae2276d49","name":"Løvdal, Alexandra Liv Vest","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Jakob","key":"vangepau","last":"Vange","name":"Vange, Jakob","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lene Feldskov","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Lene Feldskov","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kristoffer","key":"almdalpau","last":"Almdal","locid":"f7ff938f-94fe-4584-b751-cd218de29a0c","name":"Almdal, Kristoffer","orcid":"0000-0002-5490-9303","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.4015/s1016237214500434","issn":["10162372","17937132"],"issn_org":["10162372"],"issue":"3","journal":"Biomedical Engineering: Applications, Basis and Communications","pages":"1450043","publisher":"World Scientific","status":"p","title":"Biomedical Engineering: Applications, Basis and Communications","volume":"26"},"review":"Peer Reviewed","scoID":["2-s2.0-84896485087"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","Coloplast Group","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Private Research","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-ea586e83-678b-46a1-97ee-19bb96ea8bf1"],"src":["DTU Technical University of Denmark"],"title":"Mechanical properties of electrospun PCL scaffold under in vitro and accelerated degradation conditions","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-374688","year":"2014","yearsub":"2014"}
