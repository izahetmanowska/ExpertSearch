LL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Hospitals","Novo Nordisk","Private Research","Roskilde University","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ruc-8e505631-eb0e-4931-acad-eeb50bc57eec"],"src":["RUC Roskilde University"],"title":"TNF-α-induced down-regulation of CDX2 suppresses MEP1A expression in colitis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-565574","year":"2012","yearsub":"2012"}
{"abstract":"Denne publikation udgør afsættet for et forsknings- og udviklingsprojekt om unge, (erhvervs) uddannelser og ungdomsliv. Projektet ”Unges Læreprocesser i og omkring Erhvervsuddannelser i sjællandske udkantsområder” – forkortet til ULE – undersøger forholdet mellem uddannelseskultur og ungdomskultur og arbejder på den baggrund med at skabe nye tilbud til sårbare unge. Her præsenterer vi projektets baggrund og formål samt nogle centrale forskningsmæssige perspektiver, som projektets arbejde vil tage udgangspunkt i.","author_count":6,"contributors":["Wulf-Andersen, Trine Østergaard","Larsen, Lene","Mogensen, Kevin Holger","Thingstrup, Signe Hvid","Hjort-Madsen, Peder","Nielsen, Steen Baagøe"],"cuid":["S01-000.00-566526"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"pop","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-RUC"]},"level3all":["DI-U-RUC"]},"review":"und","rtype":["clu"],"sorti":"unge uddannelse og ungdomsliv i sjællandske udkantsområder","src":["ruc"],"src-code":["DI-U-RUC"],"type":"dr","type-grp":["all","pub"]},"id":"S01-000.00-566526","ids":["ruc-9c7d05ab-2359-4744-bd78-e73bfb5a6e95"],"lang":"Danish","level":"Popular","mra":["Humanities"],"noi":["Local-1-1-9AC21169DF992A480DC1A0D3D87F0932"],"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, The Department of Psychology and Educational Studies"],"nora_code":"DI-U-RUC","used":1}],"person":[{"affno":"1","country":"dk","first":"Trine Østergaard","key":"wulfandersenpau","last":"Wulf-Andersen","locid":"f8e8c106-b567-4abc-bc1d-3d17fe881a61","name":"Wulf-Andersen, Trine Østergaard","orcid":"0000-0002-9726-9158","rank":1,"rolec