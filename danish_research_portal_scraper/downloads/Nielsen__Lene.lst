tæhrpau","last":"Jensen","locid":"d9593acd-d6ae-4a83-a7c8-64bc2ea541ac","name":"Jensen, Jens Ulrik Stæhr","name_org":"Jensen, Jens Ulrik Stæhr","orcid":"0000-0003-4036-0521","rank":19,"rolecode":"pau"},{"affno":"2 1 3","first":"Tor","key":"bieringsørensentorpau","last":"Biering-Sørensen","locid":"2a25298f-30d3-4b37-b20b-646684a29fd8","name":"Biering-Sørensen, Tor","rank":20,"rolecode":"pau"}],"pmid":["39965617"],"pub":{"doi":"10.1111/irv.70067","issn":["17502640","17502659"],"issn_org":["17502640"],"issue":"2","journal":"Influenza and Other Respiratory Viruses","paperid":"e70067","status":"p","title":"Influenza and Other Respiratory Viruses","volume":"19"},"review":"Peer Reviewed","scoID":["2-s2.0-85218267219"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-932f99dd-f65a-4333-9e07-3e1e0ce7bf45"],"src":["KU University of Copenhagen"],"title":"Cardiac Characteristics of Hospitalized Influenza Patients : An Interim Analysis From the FluHeart Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-800045","year":"2025","yearsub":"2025"}
{"abstract":"Several Danish social housing estates are currently being transformed according to the Parallel Society Act. Thislegislation has introduced what is, in a Danish context, a new approach to regeneration, involving tenure mix,evictions, and targeted demolition to transform and open up disadvantaged housing estates. Based on recurrentfield studies in the estates that are being regenerated, this article investigates how current transformations changethe flow through the estates, and how the ongoing place-making is perceived by residents. Existing researchmainly applies either a social science approach to social-mix policies or an urban design approach to study place-making and transformations of large housing estates. This article bridges the gap between these two approachesby exploring the relationship between current physical transformations and local social life. The empirical focus ison Bispehaven and Gellerupparken near Aarhus, where regeneration projects have changed the infrastructure andflow. This study shows that more – and new groups of – external users are now passing through the estates. Thoughresidents and external users blend more in the estate’s public spaces, this is not a guarantee of positive socialexchange between the groups. The increasing flow is intended to provide a sense of security and ‘eyes on the street’,but the traffic passing through the estate is perceived – especially among residents with children – as a considerablethreat, making it difficult to let children run freely. Even though many residents may be in favour of a more mixedneighbourhood, they also feel that their place has been taken away from them; place-making is experienced asplace-taking. In combination with the involuntary relocation of some residents, the place-making processes thusalso become a matter of who has the right to the place","author_count":5,"contributors":["Stender, Marie","Nordberg, Lene Wiell","Nielsen, Rikke Skovgaard","Mechlenborg, Mette","Bech-Danielsen, Claus"],"cuid":["S01-000.00-814652"],"filters":{"added":"2025-08","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Architectural anthropology","Place making","Regeneration","Social mix"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"place making or place taking transformation of danish disadvantaged housing estates","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://www.scup.com/doi/epdf/10.18261/njus.5.2.1","version":"Published Version"},"id":"S01-000.00-814652","ids":["aau-8edb7720-bde3-4ba9-9b70-e90aee39171e"],"keyword":["Architectural Anthropology","Parallel Society Act","Place-making","Regeneration","Social mix"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-4FF38DEB5B7EA6B5E5791562E6A6D4AA"],"oa_link":[{"access":"oa","type":"rem","url":"https://www.scup.com/doi/epdf/10.18261/njus.5.2.1","version":"Published Version"}],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment, Division of Town, Housing and Property","Aalborg University, The Faculty of Engineering and Science, Department of the Built Environment, Transformation of Housing and Places Research Group"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Marie","key":"stenderpau","last":"Stender","locid":"a548a5d3-73b7-4461-9ed9-ba9c0432e2ac","name":"Stender, Marie","orcid":"0000-0002-1009-3138","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lene Wiell","key":"nordbergpau","last":"Nordberg","locid":"4620ca55-6074-4b3d-98ed-0321710187b8","name":"Nordberg, Lene Wiell","orcid":"0000-0003-3344-0574","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rikke Skovgaard","key":"nielsenpau","last":"Nielsen","locid":"125da2cb-a5a5-47e8-84ab-be518f10a19f","name":"Nielsen, Rikke Skovgaard","orcid":"0000-0003-0308-1275","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Mette","key":"mechlenborgpau","last":"Mechlenborg","locid":"429feb0f-1899-4126-bba7-9ae96ec42ce2","name":"Mechlenborg, Mette","orcid":"0000-0002-9446-9795","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Claus","key":"bechdanielsenpau","last":"Bech-Danielsen","locid":"f41ac22b-bb0d-4c3f-8d06-96efd65c0665","name":"Bech-Danielsen, Claus","orcid":"0000-0002-4822-6039","rank":5,"rolecode":"pau"}],"pub":{"issn":["27038866"],"issue":"2","journal":"Nordic Journal of Urban Studies","pages":"1-18","publisher":"Scandinavian University Press","status":"i","title":"Nordic Journal of Urban Studies","volume":"5"},"review":"Peer Reviewed","sdg":["10. Reduced Inequalities","11. Sustainable Cities and Production","All UN SDG Classification"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["In Press"]},"sid":["aau-8edb7720-bde3-4ba9-9b70-e90aee39171e"],"src":["AAU Aalborg University"],"title":"Place-Making or Place-Taking? : Transformation of Danish Disadvantaged Housing Estates","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-814652","year":"2025","yearsub":"2025"}
{"abstract":"Purpose Temporary stays for patients requiring short-term care outside the home, often following hospital discharge, has gained increasing importance. This study aimed to describe the characteristics and care trajectories of older patients in Danish temporary stays to improve care delivery and patient safety. Methods We conducted a descriptive study on a cohort of patients in temporary stays across 14 Danish municipalities from 2016 to 2023, using data from national health registries. Results We identified 11,424 patients with a median age of 81 years (interquartile range [IQR] 73-87 years); 54% were women. Patients exhibited a high level of comorbidity, with a median Charlson Comorbidity Index of 1 (IQR 0-2), and a median of 3 hospital admissions (IQR 2-6) in the year preceding their move into temporary care. The majority (70%) transitioned to temporary stays following hospital discharge, while 30% were admitted directly from their homes. The median duration of temporary stays was 24 days (IQR 11-49 days), with 9.1% staying ≥ 90 days. Additionally, 7.0% of patients were hospitalised directly from the temporary stay facility, with a median time to hospital admission of 13 days (IQR 5-28 days). Median survival after admission to a temporary stay was 23 months (IQR 3.6-57 months). Predictors of mortality included male sex, older age, higher comorbidity burden, and increased number of hospital admissions prior to temporary stay. Conclusions Patients in temporary stays are generally older individuals with multimorbidity and limited life expectancy. Most patients are admitted following hospital discharge, and their stays are often prolonged.","author_count":10,"contributors":["Harbi, Hanin","Lundby, Carina","Jensen, Peter Bjødstrup","Larsen, Søren Post","Rørbæk, Linda Grouleff","Ravn-Nielsen, Lene Vestergaard","Ryg, Jesper","Reilev, Mette","Edwards, Kasper","Pottegård, Anton"],"cuid":["S01-000.00-827538"],"filters":{"added":"2025-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Pottegård, Anton"],"keyword":["Aged","Epidemology","Intermediate care facilities","Morbidity","Mortality","Skilled nursing facilities"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-SDR"],"OT":["REAGENS"],"U":["DI-U-ALL","DI-U-DTU","DI-U-SDU"]},"level3all":["DI-HO-SDR","DI-U-DTU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"characteristics and care trajectories of older patients in temporary stays in denmark","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s41999-025-01209-9","version":"Published Version"},"id":"S01-000.00-827538","identifier":[{"id":"40348842","type":"pmid"},{"id":"105004678291","type":"scopus"}],"ids":["dtu-451c3e5e-9460-4f92-8265-1d1908dfdc4b"],"keyword":["Aged","Epidemology","Intermediate care facilities","Morbidity","Mortality","Skilled nursing facilities"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-44D6CBF14775928324AB13B722DEE059"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s41999-025-01209-9","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/411359309/s41999-025-01209-9.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["University of Southern Denmark"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["REAGENS"],"nora_code":"DI-OT","used":1},{"affno":"3","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","used":1},{"affno":"4","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Engineering Technology and Didactics","Technical University of Denmark, Department of Engineering Technology and Didactics, Strategy and Leadership Development"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Hanin","key":"harbipau","last":"Harbi","name":"Harbi, Hanin","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Carina","key":"lundbypau","last":"Lundby","name":"Lundby, Carina","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peter Bjødstrup","key":"jensenpau","last":"Jensen","name":"Jensen, Peter Bjødstrup","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Søren Post","key":"larsenpau","last":"Larsen","name":"Larsen, Søren Post","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Linda Grouleff","key":"rørbækpau","last":"Rørbæk","name":"Rørbæk, Linda Grouleff","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Lene Vestergaard","key":"ravnnielsenpau","last":"Ravn-Nielsen","name":"Ravn-Nielsen, Lene Vestergaard","rank":6,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Jes