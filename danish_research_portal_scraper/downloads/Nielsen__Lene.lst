":1}],"person":[{"affno":"1","first":"James","key":"owusukwartengpau","last":"Owusu-Kwarteng","name":"Owusu-Kwarteng, James","rank":1,"rolecode":"pau"},{"affno":"1","first":"Fortune","key":"akabandapau","last":"Akabanda","name":"Akabanda, Fortune","rank":2,"rolecode":"pau"},{"affno":"2","first":"Dennis Sandris","key":"nielsenpau","last":"Nielsen","locid":"08539a0e-05f4-454e-ad2a-de195363dbd1","name":"Nielsen, Dennis Sandris","orcid":"0000-0001-8121-1114","rank":3,"rolecode":"pau"},{"affno":"3","first":"Kwaku","key":"tanodebrahpau","last":"Tano-Debrah","name":"Tano-Debrah, Kwaku","rank":4,"rolecode":"pau"},{"affno":"1","first":"Richard L.K.","key":"gloverpau","last":"Glover","name":"Glover, Richard L.K.","rank":5,"rolecode":"pau"},{"affno":"2","first":"Lene","key":"jespersenpau","last":"Jespersen","locid":"a156c6e3-9562-4d35-9305-53a39c62e076","name":"Jespersen, Lene","orcid":"0000-0002-2555-5948","rank":6,"rolecode":"pau"}],"pmid":["22850376"],"pub":{"doi":"10.1016/j.fm.2012.04.010","issn":["07400020","10959998"],"issn_org":["07400020"],"issue":"1","journal":"Food Microbiology","pages":"72-78","status":"p","title":"Food Microbiology","volume":"32"},"review":"Peer Reviewed","scoID":["2-s2.0-84864344204"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-e7fc9c34-5290-4945-99fe-8eeaafe450e1"],"src":["KU University of Copenhagen"],"title":"Identification of lactic acid bacteria isolated during traditional fura processing in Ghana","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-531981","year":"2012","yearsub":"2012"}
{"abstract":"This paper contributes to the HCI literature on usability practice with insights about the empirical challenges and global emerging practices caused by the advent of agile software development (ASD). In the paper we report from a worldwide study involving 12 usability professionals from 12 different countries. The findings show that the usability professionals share a forced development and innovation in their practice that stem from their clients’ adoption and use of ASD methods. The ASD methods challenge the way usability testing is performed, the abilities of the usability expert, the usability deliverables, and the experts’ assumptions about the importance of validity.","author_count":2,"contributors":["Nielsen, Lene","Madsen, Sabine"],"cuid":["S02-087.13-038303"],"event":{"end":"2012-10-17","place":"Copenhagen, dk","start":"2012-10-14","title":"7th Nordic Conference on Human-Computer Interaction - NordiCHI 2012","year":"2012"},"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Agile methods","Global trends","Usability Professionals","Usability testing","practice study"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU","DI-U-RUC"]},"level3all":["DI-U-ITU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"the usability expert s fear of agility an empirical study of global trends and emerging practices","src":["itu","ruc"],"src-code":["DI-U-ITU","DI-U-RUC"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1145/2399016.2399057","version":"Published Version"},"id":"S02-087.13-038303","identifier":[{"id":"84871558032","type":"scopus"}],"ids":["itu-553addee-f516-4566-bd7e-90df32485208","ruc-a643066b-1003-4b79-b93c-1bae459cb3ec"],"keyword":["Usability testing","agile methods","global trends","practice study","usability profes