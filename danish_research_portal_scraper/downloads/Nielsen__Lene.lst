{"author_count":5,"contributors":["Kjeldsen, Lene Juel","Clemmensen, Line Hedegaard","Hedegaard, Ulla","Inger, Olsen","Nielsen, Jette Lyngholm"],"cuid":["S01-000.00-630377"],"event":{"end":"2012-10-01","place":"Barcelone, es","start":"2012-10-01","title":"41nd ESCP symposium","year":"2012"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-PR-OTH","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"a clinical pharmacy screening service of risk medications showed room for improvement","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dco","type-grp":["all","pub"]},"id":"S01-000.00-630377","ids":["sdu-c788785a-678b-4f22-9ec3-923357bf385e"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-542EC1DFA697CECE26AF4123475E46A7"],"org":[{"affno":"1","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["Amgros"],"nora_code":"DI-PR-OTH","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Public Health, Clinical Pharmacology and Pharmacy","SDU, The Faculty of Health Sciences, Department of Public Health, Dept. Clinical Biochemistry and Pharmacology"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lene Juel","key":"kjeldsenpau","last":"Kjeldsen","name":"Kjeldsen, Lene Juel","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Line Hedegaard","key":"clemmensenpau","last":"Clemmensen","name":"Clemmensen, Line Hedegaard","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Ulla","key":"hedegaardpau","last":"Hedegaard","locid":"82b24eb2-1cc9-49b6-bd97-07f2cb6a6d2b","name":"Hedegaard, Ulla","orcid":"0000-0002-8958-2187","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Olsen","key":"ingerpau","last":"Inger","name":"Inger, Olsen","rank":4,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jette Lyngholm","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Jette Lyngholm","rank":5,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Other Companies","Private Research","Universities","University of Southern Denmark","amgros"],"PST":["Published"]},"sid":["sdu-c788785a-678b-4f22-9ec3-923357bf385e"],"src":["SDU University of Southern Denmark"],"title":"A clinical pharmacy screening service of risk medications showed room for improvement","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-630377","year":"2013","yearsub":"2013"}
{"abstract":"Computed Tomography (CT) Perfusion is an evolving method to visualize perfusion in organs and tissue. With the introduction of multidetector CT scanners, it is now possible to cover up to 16 cm in one rotation, and thereby making it possible to scan entire organs such as the liver with a fixed table position. Advances in reconstruction algorithms make it possible to reduce the radiation dose for each examination to acceptable levels. Regarding abdominal imaging, CT perfusion is still considered a research tool, but several studies have proven it as a reliable non-invasive technique for assessment of vascularity. CT perfusion has also been used for tumor characterization, staging of disease, response evaluation of newer drugs targeted towards angiogenesis and as a method for early detection of recurrence after radiation and embolization. There are several software solutions available on the market today based on different perfusion algorithms. However, there is no consensus on which protocol and algorithm to use for specific organs. In this OPEN article, the authors give an introduction to CT perfusion in abdominal imaging introducing technical aspects for calculation of perfusion parameters, and considerations on patient preparation. This article also contains clinical cases to illustrate the use of C perfusion in abdominal imaging.","author_count":9,"contributors":["Hansen, Martin","Norling, Rikke","Lauridsen, Carsten","Fallentin, Eva","Baeksgaard, Lene","Kofoed, Klaus Fuglsang","Svendsen, Lars Bo","Nielsen, Michael Bachmann"],"cuid":["S02-080.00-038542"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Cancer","image diagnostics"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U","DI-UC"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"],"UC":["DI-UC-ALL","DI-UC-KP"]},"level3all":["DI-HO-CAP","DI-U-KU","DI-UC-KP"]},"review":"pr","rtype":["clu"],"sorti":"computed tomography ct perfusion in abdominal cancer technical aspects","src":["kp","ku"],"src-code":["DI-U-KU","DI-UC-KP"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3390/diagnostics3020261","version":"Published Version"},"id":"S02-080.00-038542","identifier":[{"id":"84901298175","type":"scopus"}],"ids":["kp-173ec8db-b436-43d9-ac4b-11ef27a7e16e","ku-54102340-5159-46f8-b0ad-e4143b1e9278"],"keyword":["cancer","image diagnostics"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-094ADDA26373693A4CA8E622639F15F3"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.3390/diagnostics3020261","version":"Published Version"},{"access":"oa","type":"loc","url":"https://ucviden.kp.dk/ws/files/23053659/diagnostics_03_00261_v2.pdf","version":"Pre-print"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Pharmacy, Analytical Biosciences"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","key":"kp university college copenhagen","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-KP","l3nl":"KP","l3nn":"KP University College Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KP