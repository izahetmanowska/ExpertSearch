{"abstract":"The Action Research Booklet is a book that introduces Action Research as a diverse range of interventionist research methods on digital technologies. The booklet shares our research experiences, through which we showcase how interventionist research on digital technologies takes place in various organizational and societal contexts.","author_count":14,"contributors":["Wang, Cancan","Juncker-Jensen, Laura","Wang, Cancan","Østerlund, Carsten Svarrer","Nicolajsen, Hanne Westh","Christensen, Lars Rune","Juncker-Jensen, Laura","Nielsen, Lene","Marttila, Sanna-Maria","Finken, Sisse","Jiang, Qiuyu","Baka, Vasiliki","Guo, Vivian","Dittrich, Yvonne"],"cuid":["S01-000.00-747253"],"filters":{"added":"2025-01","altsrc":["No Matches Found"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Syracuse University"],"keyword":["Action research","Case studies","Digital technologies","Methodology"],"level":"sci","mra":["soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"action research booklet","src":["itu"],"src-code":["DI-U-ITU"],"type":"db","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://pure.itu.dk/ws/files/105344102/The_Action_Research_Booklet_by_REFLACT.pdf","version":"Published Version"},"id":"S01-000.00-747253","ids":["itu-9ead329e-331d-4056-9a41-7238df054a8a"],"keyword":["Action Research","Case Studies","Digital Technologies","Methodology"],"lang":"English","level":"Scientific","mra":["Social Science"],"noi":["Local-1-1-1EE08A8A072CFC8A315BF83D71774C89"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://pure.itu.dk/ws/files/105352227/The_Action_Research_Booklet_by_REFLACT.pdf","version":"Other Version"},{"access":"oa","license":"CC BY-NC","type":"lo