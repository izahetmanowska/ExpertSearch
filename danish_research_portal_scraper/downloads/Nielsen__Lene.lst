ey":"fallovpau","last":"Fallov","locid":"52c23fcf-7641-4f31-9d82-d70de307cf99","name":"Fallov, Mia Arp","orcid":"0000-0002-2630-1982","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anja","key":"jørgensenpau","last":"Jørgensen","locid":"1075f62b-258c-43d9-90c0-5c57bdd67f42","name":"Jørgensen, Anja","orcid":"0000-0003-3864-2458","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lene","key":"tølbøllpau","last":"Tølbøll","locid":"5c676ce8-37f8-48df-862d-8da4690a606d","name":"Tølbøll, Lene","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Rikke Skovgaard","key":"nielsenpau","last":"Nielsen","locid":"125da2cb-a5a5-47e8-84ab-be518f10a19f","name":"Nielsen, Rikke Skovgaard","orcid":"0000-0003-0308-1275","rank":4,"rolecode":"pau"}],"pub":{"issn":["09055908"],"issue":"4","journal":"Dansk Sociologi","pages":"15-35","publisher":"Dansk Sociologforening","status":"p","title":"Dansk Sociologi","title_org":"Tidsskriftet Dansk Sociologi","volume":"30"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["aau-f9b5d5c5-2bdc-4442-a4a2-555971c493e0"],"src":["AAU Aalborg University"],"title":"Mikropol - eller historien om det store i det små","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-122584","year":"2019","yearsub":"2019"}
{"abstract":"Introduction Brain injury increases metabolic and catabolic responses initiated by injured tissue, perfusion deficits, infection and release of hormones. Body Mass Index (BMI) and biochemistry insufficiently describes nutritional status after brain injury. Bioelectrical impedance analysis (BIA) is an additional tool to estimate body composition but so far unused in patients with brain injury. Aim: To describe the nutritional status in patients admitted for subacute neurorehabilitation after acquired moderate to severe brain injury. Method: This prospective, descriptive cohort study included patients consecutively admitted to a neurorehabilitation hospital (n=92). Measures of malnutrition were fat-free mass index (FFMI), weight loss, BMI, fat mass index (FMI), muscle strength and Biochemical markers according to recommended standards. Malnutrition was compared between admission and after 4 weeks using McNemars test. Findings From admission to after 4 weeks of rehabilitation, low FFMI FFMI (< 14.6 kg/m2 in women and < 16.7 kg/m2 in men) decreased from 17 to 11%, weight loss >5% compared to habitual weight decreased significantly from 56 to 40%, whereas low BMI (<18.5 kg/m2) did not change after 4 weeks of rehabilitation. The biochemical nutritional markers and proportion of patients with low muscle strength (54%), low FMI (3%), high BMI (44%), and high FMI (19%) did not change significantly after 4 weeks of rehabilitation. Conclusion FFMI and weight loss improved whereas BMI and biochemistry were unchanged after 4 weeks of rehabilitation. FFMI may be a sensitive indicator of nutritional changes during subacute neurorehabilitation.","author_count":6,"contributors":["Aadal, Lena","Odgaard, Lene","Nielsen, Jørgen Feldbæk","Rasmussen, Henrik Højgaard","Holst, Mette","Køhler, Marianne"],"cuid":["S01-000.00-232211"],"event":{"end":"2019-03-22","place":"Manchester, gb","start":"2019-03-19","title":"European Association of Neuroscience Nurses EANN","year":"2019"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"pop","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-NDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-HO-NDR","DI-U-AAU","DI-U-AU"]},"review":"und","rtype":["clu"],"sorti":"nutritional status in patients with moderate to severe brain injury admitted to sub acute rehabilitation","src":["au"],"src-code":["DI-U-AU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-232211","ids":["au-b4537f96-5efb-4034-b454-67d40a3eaeaa"],"lang":"Danish","level":"Popular","mra":["Medical Science"],"noi":["Local-1-1-CE00294F10F1C6FCA3007DDFF84A0921"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Hammel Neurocenter, Universitetsklinik for Neurorehabilitering"],"nora_code":"DI-U-AU","used":1},{"affno":"2","country":"dk","key":"north denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-NDR","l3nl":"North Denmark Region","l3nn":"North Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"North Denmark Region","namevar":["Aalborg University Hospital"],"nora_code":"DI-HO-NDR","used":1},{"affno":"3","country":"dk","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University (AAU)"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Lena","key":"aadalpau","last":"Aadal","locid":"a3a1966b-710e-489c-a729-810645c717b5","name":"Aadal, Lena","orcid":"0000-0001-7365-3916","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lene","key":"odgaardpau","last":"Odgaard","locid":"1b80fe7b-ba0a-45b3-aca1-48bc19a97a44","name":"Odgaard, Lene","orcid":"0000-0002-9830-3282","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jørgen Feldbæk","key":"nielsenpau","last":"Nielsen","locid":"3fb25b9f-381b-44a6-a8dd-26eacf839d37","name":"Nielsen, Jørgen Feldbæk","orcid":"0000-0001-5339-171X","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Henrik Højgaard","key":"rasmussenpau","last":"Rasmussen","name":"Rasmussen, Henrik Højgaard","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Mette","key":"holstpau","last":"Holst","locid":"e13af1a8-06f4-4cd3-9275-633497558d26","name":"Holst, Mette","rank":5,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Marianne","key":"køhlerpau","last":"Køhler","name":"Køhler, Marianne","rank":6,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Undetermined","search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Universities"],"PST":["Published"]},"sid":["au-b4537f96-5efb-4034-b454-67d40a3eaeaa"],"src":["AU Aarhus University"],"title":"Nutritional status in patients with moderate to severe brain injury admitted to sub- acute rehabilitation","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-232211","year":"2019","yearsub":"2019"}
{"abstract":"The reversible interconversion of formate (HCOO−) and carbon dioxide (CO2) is catalyzed by formate dehydrogenase (FDH, EC 1.17.1.9). This enzyme can be used as a first step in the utilization of CO2 as carbon substrate for production of high-in-demand chemicals. However, comparison and categorization of the very diverse group of FDH enzymes has received only limited attention. With specific emphasis on FDH catalyzed CO2 reduction to HCOO−, we present a novel classification scheme for FDHs based on protein sequence alignment and gene organization analysis. We show that prokaryotic FDHs can be neatly divided into six meaningful sub-types. These sub-types are discussed in the context of overall structural composition, phylogeny of the gene segment organization, metabolic role, and catalytic properties of the enzymes. Based on the available literature, the influence of electron donor choice on the efficacy of FDH catalyzed CO2 reduction is quantified and compared. This analysis shows that methyl viologen and hydrogen are several times more potent than NADH as electron donors. Hence, the new FDH classification scheme and the electron donor analysis provide an improved base for developing FDH-facilitated CO2 reduction as a viable step in the utilization of CO2 as carbon source for green production of chemicals.","author_count":3,"contributors":["Nielsen, Christian Førgaard","Lange, Lene","Meyer, Anne S."],"cuid":["S01-000.00-339374"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Meyer, Anne S."],"keyword":["Biocatalysis","CO reduction","Carbon capture and utilization","Electrocatalysis","Formate"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-PR-OTH","DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"classification and enzyme kinetics of formate dehydrogenases for biomanufacturing via co sub 000000000002 sub utilization","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85068522362","version":"Other Version"},"funding_acknowledgement":["This study was funded by the Technical University of Denmark and partially funded by the BioValue SPIR, Strategic Platform for Innovation and Research on value added products from biomass, which is co-funded by The Innovation Fund Denmark , Case No: 0603-00522B ."],"id":"S01-000.00-339374","identifier":[{"id":"85068522362","type":"scopus"},{"id":"31200015","type":"pmid"}],"ids":["dtu-7499e3b7-0bc6-4257-b1a6-1448dc1a8b07"],"keyword":["Biocatalysis","CO reduction","Carbon capture and utilization","Electrocatalysis","FDH classification","FDH gene segment organization","Formate"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-D024A83E3E6DA1D025A4716CED90345A"],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Biotechnology and Biomedicine","Technical University of Denmark, Department of Biotechnology and Biomedicine, Section for Protein Chemistry and Enzyme Technology","Technical University of Denmark, Department of Biotechnology and Biomedicine, Section for Protein Chemistry and Enzyme Technology, Enzyme Technology","Technical University of Denmark, Novo Nordisk Foundation Center for Biosustainability","Technical University of Denmark, Novo Nordisk Foundation Center for Biosustainability, Bacterial Synthetic Biology"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["LLa-Bioeconomy Research & Advisory"],"nora_code":"DI-PR-OTH","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Christian Førgaard","key":"nielsenpau","last":"Nielsen","locid":"8c6f9580-16cf-4873-a61c-f9a6c3d1e689","name":"Nielsen, Christian Førgaard","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lene","key":"langepau","last":"Lange","name":"Lange, Lene","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anne S.","key":"meyerpau","last":"Meyer","locid":"1e9f4759-72d8-4d52-94ec-ce192ffca184","name":"Meyer, Anne S.","orcid":"0000-0001-8910-9931","rank":3,"rolecode":"pau"}],"pmid":["31200015"],"pub":{"doi":"10.1016/j.biotechadv.2019.06.007","issn":["07349750","18731899"],"issn_org":["07349750"],"issue":"7","journal":"Biotechnology Advances","paperid":"107408","publisher":"Elsevier","status":"p","title":"Biotechnology Advances","volume":"37"},"review":"Peer Reviewed","scoID":["2-s2.0-85068522362"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Other Companies","Private Research","Technical University of Denmark","Universities","lla-bioeconomy research & advisory"],"PST":["Published"]},"sid":["dtu-7499e3b7-0bc6-4257-b1a6-1448dc1a8b07"],"src":["DTU Technical University of Denmark"],"title":"Classification and enzyme kinetics of formate dehydrogenases for biomanufacturing via CO<sub>2</sub> utilization","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-339374","year":"2019","yearsub":"2019"}
{"abstract":"We investigate whether additional photos beyond a single headshot makes a persona profile more informative without confusing the end user. We conduct an eye-tracking experiment and qualitative interviews with digital content creators after varying the persona in photos via a single headshot, a headshot and photo of the persona in different contexts, and a headshot with photos of different people with key persona attributes the gender and age. Findings show that contextual photos provide significantly more persona information to end users; however, showing photos of multiple people engenders confusion and lowers informativeness. Also, as anticipated, viewing additional photos requires more cognitive focus, which is measured by eye-tracking metrics; these metrics are correlated with levels of informativeness and confusion. Furthermore, various interpretations of the persona based on the choice of photos are biased by the end users’ experiences and preconceptions. Concerning persona design, findings indicate that persona creators need to consider the intended persona use objectives when selecting photos and when producing persona profiles. Using contextual photos can improve informativeness, but this demands more cognitive focus from end users. Thus, adding contextual photos increases the perceived informativeness of the persona profile without being obfuscating, but multiple photos of different people do evoke confusion about the targeted persona.","author_count":6,"contributors":["Salminen, joni","Jung, Soon-Gyo","An, Jisun","Kwak, Haewoon","Nielsen, Lene","Jansen, Bernard J."],"cuid":["S01-000.00-383758"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Asia, Middle East"],"country":["Qatar"],"glorg":["All Global Affiliations","Qatar Computing Research institute"],"keyword":["Online data representations","Personas","User perceptions"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"confusion and information triggered by photos in persona profiles","src":["itu"],"src-code":["DI-U-ITU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84710185/jjansen_ijhcs2019_for_download.pdf","version":"Pre-print"},"id":"S01-000.00-383758","identifier":[{"id":"85063298012","type":"scopus"}],"ids":["itu-ab5cbd42-a563-43d4-920f-13a604893783"],"keyword":["Online data representations","Personas","User perceptions"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-ACCFDE7DEAAF3DAB612B078909FDB57E"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/84710185/jjansen_ijhcs2019_for_download.pdf","version":"Pre-print"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","country":"qa","key":"qatar computing research institute","loc":["Qatar","Asia, Middle East"],"name":"Qatar Computing Research institute","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"joni","key":"salminenpau","last":"Salminen","name":"Salminen, joni","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Soon-Gyo","key":"jungpau","last":"Jung","name":"Jung, Soon-Gyo","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jisun","key":"anpau","last":"An","name":"An, Jisun","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Haewoon","key":"kwakpau","last":"Kwak","name":"Kwak, Haewoon","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lene","key":"nielsenpau","last":"Nielsen","locid":"1052b289-f510-4c5a-9662-2db48c12ebc2","name":"Nielsen, Lene","orcid":"0000-0003-1768-7147","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Bernard J.","key":"jansenpau","last":"Jansen","name":"Jansen, Bernard J.","rank":6,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.ijhcs.2019.03.005","issn":["10715819","10959300"],"issn_org":["10715819"],"journal":"International Journal of Human-Computer Studies","pages":"1-14","publisher":"Academic Press","status":"p","title":"International Journal of Human-Computer Studies","volume":"129"},"review":"Peer Reviewed","scoID":["2-s2.0-85063298012"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-ab5cbd42-a563-43d4-920f-13a604893783"],"src":["ITU IT University of Copenhagen"],"title":"Confusion and information triggered by photos in persona profiles","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383758","year":"2019","yearsub":"2019"}
{"abstract":"IT has become a vital part of our daily lives, requiring new skills among today’s leaders, who need to keep up with competitors and meet the needs of employees and customers. This applies to nearly every industry - from clothing manufacturers to logistics companies. However, many leaders find it difficult to keep up with the impacts of digitalization, but the ability to think and act in a digitally innovative way, is absolutely essential for business leaders. For example, most leaders need to be capable of exploiting the potential of collaborating virtually with employees, customers and business partners. If companies are not aware of “new digital opportunities” they will fail to provide their employees with the appropriate digital tools that support their daily tasks. For instance, we see the increase of ‘Shadow IT’: Employees use IT that is not officially approved by the company and that they own privately. This does not happen because the employees want to do something “illegal”, but simply because they feel it is necessary to use a more efficient tool (such as Whatsapp or Dropbox) to execute their tasks. This may have negative consequences for the companies. However, leaders who know how to leverage the use of shadow IT and think innovatively can gain a lot for their company. From September 2017 until January 2019, we tried to inspire the leaders and provide them with an overview of specific methods and tools to exploit digitalization, whilst reducing the risks associated with it.","author_count":6,"contributors":["Richter, Alexander","Nicolajsen, Hanne Westh","Nielsen, Lene","Müller, Oliver","Krancher, Oliver","Stana, Raluca"],"cuid":["S01-000.00-383928"],"filters":{"added":"2024-06","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Leadership"],"level":"com","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"nr","rtype":["clu"],"sorti":"innovation for leadership","src":["itu"],"src-code":["DI-U-ITU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85351311/I4L_Report.pdf","version":"Other Version"},"id":"S01-000.00-383928","ids":["itu-b6646876-8803-4d5d-a538-294407a94d90"],"keyword":["Leadership"],"lang":"English","level":"Commissioned","mra":["Science/Technology"],"noi":["Local-1-1-6108B67CDCD71D9F7DD9974CC92B81BA"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85351311/I4L_Report.pdf","version":"Other Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Alexander","key":"richterpau","last":"Richter","name":"Richter, Alexander","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Hanne Westh","key":"nicolajsenpau","last":"Nicolajsen","locid":"54728da8-274d-40e6-b119-23318d995721","name":"Nicolajsen, Hanne Westh","orcid":"0000-0002-0158-5034","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lene","key":"nielsenpau","last":"Nielsen","locid":"1052b289-f510-4c5a-9662-2db48c12ebc2","name":"Nielsen, Lene","orcid":"0000-0003-1768-7147","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Oliver","key":"müllerpau","last":"Müller","name":"Müller, Oliver","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Oliver","key":"krancherpau","last":"Krancher","locid":"f14f4742-c9d8-4a34-b8e2-d713c3a1f437","name":"Krancher, Oliver","orcid":"0000-0003-3876-3604","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Raluca","key":"stanapau","last":"Stana","name":"Stana, Raluca","rank":6,"rolecode":"pau"}],"pub":{"pages":"26","publisher":"IT-Universitetet","status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-b6646876-8803-4d5d-a538-294407a94d90"],"src":["ITU IT University of Copenhagen"],"title":"Innovation for Leadership","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383928","year":"2019","yearsub":"2019"}
{"abstract":"CONTEXT: The endocrine function of human fetal adrenals (HFAs) is activated already during first trimester, but adrenal steroidogenesis during fetal life is not well characterized. OBJECTIVE: This study aimed to investigate HFA steroidogenesis by analyzing adrenal glands from first and second trimesters. DESIGN AND SETTING: Male and female HFA from gestational weeks (GWs) 8 to 19 were examined, including a total of 101 samples from 83 fetuses. MAIN OUTCOME MEASURE(S): Expression level of steroidogenic genes and protein expression/localization were determined by quantitative PCR and immunohistochemistry, respectively, and intra-adrenal steroid levels were quantified by LC-MS/MS. RESULTS: Transcriptional levels of StAR, CYP11A1, CYP17A1, CYP21A2, CYP11B1/2, and SULT2A1 were significantly higher in second trimester compared to first trimester (P < 0.05), whereas expression levels of 3β-HSD2 and ARK1C3 were unaltered between GWs 8 and 19. All investigated steroidogenic proteins were expressed in a distinct pattern throughout the investigated period, with most enzymes expressed primarily in the fetal zone, except 3β-HSD1/2, which was expressed mainly in the definitive zone. Abundant steroidogenic enzyme expression was reflected in overall high intra-adrenal tissue concentrations of mineralocorticoids, glucocorticoids, and androgens; cortisol was the most abundant (1071 to 2723 ng/g tissue), and testosterone levels were the lowest (2 to 14 ng/g tissue). CONCLUSIONS: The expression profiles of HFA steroidogenic enzymes are distinct from first to second trimester, with no major differences between male and female samples. Intra-adrenal steroid hormone concentrations confirm that cortisol is produced throughout first and second trimesters, suggesting continued regulation of the hypothalamus-pituitary-adrenal axis during this entire period.","author_count":12,"contributors":["Melau, Cecilie","Nielsen, John Erik","Frederiksen, Hanne","Kilcoyne, Karen","Perlman, Signe","Lundvall, Lene","Langhoff Thuesen, Lea","Juul Hare, Kristine","Andersson, Anna-Maria","Mitchell, Rod T","Juul, Anders","Jørgensen, Anne"],"cuid":["S01-000.00-445752"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"characterization of human adrenal steroidogenesis during fetal development","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1210/jc.2018-01759","version":"Published Version"},"id":"S01-000.00-445752","identifier":[{"id":"85068537775","type":"scopus"},{"id":"30590593","type":"pmid"},{"id":"PMC6456011","type":"pmcid"}],"ids":["ku-577aebeb-63ac-413f-9b5e-abb911cc42c3"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-23C4C7DCC7FF017E0449525F12D59FA2"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/228975997/jc.2018_01759.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1210/jc.2018-01759","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Obstetrics and Gynaecology"],"nora_code":"DI-