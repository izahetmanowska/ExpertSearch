rch":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-a5af0c14-2341-41b6-9c42-c4198996764d","ku-b7c931bb-49f4-4e77-bd04-d4fd7dcfe673"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Denmark’s National Inventory Report 2011 : Emission Inventories 1990-2009 - Submitted under the United Nations Framework Convention on Climate Change and the Kyoto Protocol","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-095.59-024787","year":"2011","yearsub":"2011"}
{"abstract":"Peripheral mechanisms are known to play a role in phantom pain following limb amputation, and more recently it has been suggested that central mechanisms may also be of importance. Some patients seem to have a psychological sensitivity that predisposes them to react with pain catastrophizing after amputation of a limb, and this coping style may contribute to increased facilitation, impaired modulation of nociceptive signals, or both. To investigate how pain catastrophizing, independently of anxiety and depression, may contribute to phantom limb pain and to alterations in pain processing twenty-four upper-limb amputees with various levels of phantom limb pain were included in the study. Patients' level of pain catastrophizing, anxiety and depression was assessed and they went through quantitative sensory testing (QST) of thresholds (mechanical and thermal) and wind-up-like pain (brush and pinprick). Catastrophizing accounted for 35% of the variance in phantom limb pain (p=0.001) independently of anxiety and depression. Catastrophizing was also positively associated with wind-up-like pain in non-medicated patients (p=0.015), but not to pain thresholds. These findings suggest that cognitive-emotional sensitization contributes to the altered nociceptive processing seen in phantom limb pain patients. The possible interactions between pain catastrophizing, wind-up-like pain, and peripheral input in generating and maintaining phantom limb pain are discussed.","author_count":8,"contributors":["Vase, Lene","Nikolajsen, Lone","Christensen, Bente","Egsgaard, Line Lindhardt","Arendt-Nielsen, Lars","Svensson, P.","Jensen, Troels Staehelin"],"cuid":["S02-096.11-011280"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med","soc"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"cognitive emotional sensitization contributes to wind up like pain in phantom limb pain patients","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.pain.2010.10.013","version":"Other Version"},"id":"S02-096.11-011280","identifier":[{"id":"78650416655","type":"scopus"},{"id":"21067864","type":"pmid"},{"id":"WOS:000285410800026","type":"wos"}],"ids":["aau-ec1eda04-22b1-497d-92c2-34ffdbd39276","au-c4bad440-0827-11e0-83f5-000ea68e967b"],"lang":"English","level":"Scientific","mra":["Medical Science","Social Science"],"noi":["Global-Local-2-3-15B3B00AD20BA4ECE2277CCDEBC064E5"],"oa_link":[{"access":"oa","type":"rem","url":"http://www.sciencedirect.com/science/article/pii/S0304395910006263","version":"Other Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.pain.2010.10.013","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus University, Faculty of Social Sciences, Department of Psychology"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Center for Sensory-Motor Interaction"],"nora_code":"DI-U-AAU","used":1},{"affno":"3","key":"miscellaneous","l2":"DI-OT","