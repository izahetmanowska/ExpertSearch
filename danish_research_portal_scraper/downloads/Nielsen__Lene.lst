ffno":"1","corresponding":null,"country":"dk","first":"Asger","key":"granfeldtasgerpau","last":"Granfeldt","locid":"e7d1ea85-4e47-46da-acaa-a557deb14511","name":"Granfeldt, Asger","rank":12,"rolecode":"pau"}],"pmid":["40848870"],"pub":{"doi":"10.1016/j.resuscitation.2025.110782","issn":["03009572","18731570"],"issn_org":["03009572"],"journal":"Resuscitation","pages":"110782","publisher":"Elsevier Ireland Ltd","status":"e","title":"Resuscitation"},"review":"Peer Reviewed","scoID":["2-s2.0-105015050941"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["E-Published (ahead of print)"]},"sid":["au-2ce43d77-669d-46c8-95e1-8eb28740c14c"],"src":["AU Aarhus University"],"title":"Why do patients develop in-hospital cardiac arrest? : A prospective clinical observational study (WHY-IHCA)","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-824736","year":"2025","yearsub":"2025"}
{"abstract":"Seriality in the Streaming Era explores the dynamic transformation of serialized storytelling in the digital era, where platforms like Netflix, Disney+, and Apple Podcasts have redefined how narratives are created, consumed, and experienced. This book examines the profound impact of streaming technologies on both fictional and nonfictional series, offering an in-depth analysis of how these formats have evolved. Drawing from case studies across a wide range of media—from television to podcasts, and social media platforms like Facebook and Snapchat—this book highlights how serialized storytelling has adapted to diverse formats and consumption habits. The authors explore key trends such as platform-specific narrative structures, audience engagement, and the blending of genres in both entertainment and journalism. With a focus on both the aesthetic and functional shifts in seriality, the book offers theoretical insights into the future of storytelling in a media landscape increasingly shaped by data-driven strategies and audience participation. Furthermore, the book tackles how seriality navigates the delicate balance between creativity and commercial demands. As a significant contribution, the book features interviews with key industry professionals in the field of serial media production. Seriality in the Streaming Era is an essential resource for scholars, students, and industry professionals, as well as anyone curious about the evolving role of serialized narratives in shaping modern media culture.","author_count":4,"contributors":["Heiselberg, Lene","Walther, Bo Kampmann","Nielsen, Jakob Isak","Rønlev, Rasmus"],"cuid":["S01-000.00-825366"],"filters":{"added":"2025-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"seriality in the streaming era","src":["au"],"src-code":["DI-U-AU"],"type":"db","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.routledge.com/Seriality-in-the-Streaming-Era/Heiselberg-KampmannWalther-Nielsen-Ronlev/p/book/9781032887869?srsltid=AfmBOopvfKRXERCfFlnBVTDRUJ22fdg6n6gaShpjaqx2X3HXbdNRwAN1","version":"Other Version"},"id":"S01-000.00-825366","ids":["au-691a8aa0-023e-4834-ae4e-9cd610957e1b"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-AB57F25C0B8A6A1332E87DE642082FD9"],"org":[{"affno":"1","country":"dk","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["University of Southern Denmark (SDU)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Arts, School of Communication and Culture, School of Communication and Culture - Media Studies"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lene","key":"heiselbergpau","last":"Heiselberg","name":"Heiselberg, Lene","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Bo Kampmann","key":"waltherpau","last":"Walther","name":"Walther, Bo Kampmann","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jakob Isak","key":"nielsenpau","last":"Nielsen","locid":"f018a863-b025-4b4c-9503-1cfae0397235","name":"Nielsen, Jakob Isak","orcid":"0000-0002-1304-688X","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Rasmus","key":"rønlevpau","last":"Rønlev","name":"Rønlev, Rasmus","rank":4,"rolecode":"pau"}],"pub":{"isbn":["9781032887869"],"pages":"182","status":"p"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-691a8aa0-023e-4834-ae4e-9cd610957e1b"],"src":["AU Aarhus University"],"title":"Seriality in the Streaming Era","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-825366","year":"2025","yearsub":"2025"}
{"abstract":"Objective: This study aims to gain insight into women’s experiences with gestational diabetes and their strategies to cope with advice for changing lifestyle. Further, health care professionals’ approach to women with gestational diabetes is discussed. Methods: Semi-structured interviews with nine women with gestational diabetes were conducted at a university hospital, adopting a phenomenological approach. Results: Three themes were created: 1) Experience of control, 2) personal strategies, and 3) unintended consequences. Women experienced that the monitoring at the outpatient clinic was associated with surveillance and safety and adopted different strategies to cope with gestational diabetes. Some women experienced feeling different and labelled due to the monitoring and their eating habits. Some women expressed concern for the baby and the risk of getting diabetes after birth. Women’s experiences and how they transfer and cope with information about gestational diabetes at an outpatient obstetric clinic are brought forward, and it became evident that individual needs in gestational diabetes care are not being met in all situations. Conclusion: Women experienced surveillance and safety while being monitored at the outpatient clinic. At the same time, self-monitoring seemed to stimulate feelings of concern about other’s reactions to the condition. In addition, we found that women’s strategies for behaviour change included limited food intake, controlling food purchases, and being physically active. Concerning the management of gestational diabetes, some women felt that the information was not sufficiently adapted to their individual needs, thus health professionals’ approach to gestational diabetes should be based on the women’s perspective.","author_count":3,"contributors":["Toxvig, Lene","Nielsen, Jane Hyldgaard","Jepsen, Ingrid"],"cuid":["S01-000.00-831771"],"event":{"end":"2025-05-28","place":"Copenhagen, dk","start":"2025-05-26","title":"Nordic Midwifery Congress 2025","year":"2025"},"filters":{"added":"2025-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"pop","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-UC"],"level3":{"UC":["DI-UC-ALL","DI-UC-UCN"]},"level3all":["DI-UC-UCN"]},"review":"und","rtype":["clu"],"sorti":"women s experiences with managing advice om gestational diabetes a qualitative interview","src":["ucn"],"src-code":["DI-UC-UCN"],"type":"dco","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://ucviden.ucn.dk/ws/files/114788359/Poster_Njf_2025.pdf","version":"Other Version"},"id":"S01-000.00-831771","ids":["ucn-eec2d7bb-df37-454c-b03a-fe83735da03f"],"lang":"English","level":"Popular","mra":["Medical Science"],"noi":["Local-1-1-EFDB8DE136130B5389E83FDBFDF14915"],"oa_link":[{"access":"oa","type":"loc","url":"https://ucviden.ucn.dk/ws/files/114788359/Poster_Njf_2025.pdf","version":"Other Version"}],"org":[{"affno":"1","key":"ucn university college of northern denmark","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-UCN","l3nl":"University College of Northern Denmark","l3nn":"UCN University College of Northern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"UCN University College of Northern Denmark","namevar":["Professionshøjskolen UCN, UCN Direktion, UCN Velfærd, Jordemoderuddannelsen"],"nora_code":"DI-UC-UCN","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lene","key":"toxvigpau","last":"Toxvig","locid":"59772880-3647-455e-8903-2ef41d6f7d10","name":"Toxvig, Lene","orcid":"0000-0002-8579-3681","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jane Hyldgaard","key":"nielsenpau","last":"Nielsen","locid":"eae86023-3897-4f92-b4ce-6378fc86abd6","name":"Nielsen, Jane Hyldgaard","orcid":"0000-0003-2815-3984","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ingrid","key":"jepsenpau","last":"Jepsen","locid":"e33e2f76-5b3e-4c7a-b9a1-0947cdac786a","name":"Jepsen, Ingrid","orcid":"0000-0002-7897-7036","rank":3,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All University Colleges","DI-ALL","DI-UC","DI-UC-ALL","University College of Northern Denmark","University Colleges"],"PST":["Published"]},"sid":["ucn-eec2d7bb-df37-454c-b03a-fe83735da03f"],"src":["UCN University College of Northern Denmark"],"title":"Women's experiences with managing advice om gestational diabetes - a qualitative interview","type":"Conference Poster","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-831771","year":"2025","yearsub":"2025"}
{"abstract":"Background: Social prescribing (SP) has received increasing interest in recent years due to its potential to encourage health-promoting behaviours, such as physical activity (PA). However, to develop effective SP interventions, it is critical to enhance our understanding of the mechanisms of change associated with SP and their potential to promote PA. This review aimed to synthesise the mechanisms of change in SP interventions and to develop a logic model illustrating a theoretical framework for SPs potential to promote PA. Methods: A narrative review was performed, including a systematic literature search in Medline, Embase and PsycINFO. The systematic literature search was finalised on 21 February 2023, and studies investigating mechanisms of change in SP interventions were included. Findings were synthesised and illustrated in a logic model illustrating how SP interventions may promote PA as an outcome. Results: The systematic literature search identified 340 studies, of which 11 met the inclusion criteria. The SP interventions comprised three processes: referral, linking and engagement. These processes influenced various mechanisms of change, which were classified into two perspectives. From a person-centred perspective, the mechanisms with the potential to promote PA comprised self-efficacy, motivation, empowerment and ‘having a voice’. These mechanisms were associated with crucial elements of SP, such as tailoring to needs, trusted relationships, nonstigmatising activities and peer-to-peer support. From a system-based perspective, the mechanisms with the potential to promote PA included system capacity and resources together with shared understanding and knowledge. These mechanisms were related to crucial elements of SP, including reliance on established communication and network, local agency and accessibility. Conclusion: A person-centred perspective describes SPs potential to promote PA through various mechanisms of change. However, these mechanisms appear to be intricately connected with the local context. Consequently, SP intervention research could benefit from incorporating contextual factors and, ideally, also integrating system thinking.","author_count":11,"contributors":["Jacobsen, Julie Sandell","Nielsen, Rasmus Oestergaard","Holt, Nanna","Skjerning, Halfdan Thorsø","Skejø, Sebastian","Rasmussen, Lene Gissel","Andelius, Dea Kejlberg","Bueno, Solvej Videbæk","Kallestrup, Per","Christensen, Jeanette Reffstrup","Ryom, Knud"],"cuid":["S02-093.12-803901"],"filters":{"added":"2025-06","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corresponding_author":["Jacobsen, Julie Sandell"],"keyword":["Communities","Logic models","Physical inactivity","Primary care","System thinking","health nutrition and quality of life"],"level":"sci","mra":["hum","med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U","DI-UC"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-SDU","DI-U-UND"],"UC":["DI-UC-ALL","DI-UC-VIA"]},"level3all":["DI-U-AU","DI-U-SDU","DI-U-UND","DI-UC-VIA"]},"review":"pr","rtype":["clu"],"sorti":"promoting physical activity through social prescribing a narrative review of literature on the mechanisms of change","src":["au","via"],"src-code":["DI-U-AU","DI-UC-VIA"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1155/hsc/3898705","version":"Published Version"},"id":"S02-093.12-803901","identifier":[{"id":"105001956199","type":"scopus"}],"ids":["au-07a93980-8c02-4232-9927-faa65b770f04","via-1c79d624-f5f1-49c1-9883-93e3f63da26d"],"keyword":["Communities","Logic models","Physical inactivity","Primary care","System thinking","health, nutrition and quality of life"],"lang":"English","level":"Scientific","mra":["Humanities","Medical Science"],"noi":["Global-Local-2-4-9857119B6A8F6C6A3789EF0D319066DD"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https