 copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Food Science, Food Microbiology, Gut Health, and Fermentation"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Fortune","key":"akabandapau","last":"Akabanda","name":"Akabanda, Fortune","rank":1,"rolecode":"pau"},{"affno":"1","first":"James","key":"owusukwartengpau","last":"Owusu-Kwarteng","name":"Owusu-Kwarteng, James","rank":2,"rolecode":"pau"},{"affno":"1","first":"Kwaku","key":"tanodebrahpau","last":"Tano-Debrah","name":"Tano-Debrah, Kwaku","rank":3,"rolecode":"pau"},{"affno":"2","first":"Richard L.K.","key":"gloverpau","last":"Glover","name":"Glover, Richard L.K.","rank":4,"rolecode":"pau"},{"affno":"3","first":"Dennis Sandris","key":"nielsenpau","last":"Nielsen","locid":"08539a0e-05f4-454e-ad2a-de195363dbd1","name":"Nielsen, Dennis Sandris","orcid":"0000-0001-8121-1114","rank":5,"rolecode":"pau"},{"affno":"3","first":"Lene","key":"jespersenpau","last":"Jespersen","locid":"a156c6e3-9562-4d35-9305-53a39c62e076","name":"Jespersen, Lene","orcid":"0000-0002-2555-5948","rank":6,"rolecode":"pau"}],"pmid":["23541194"],"pub":{"doi":"10.1016/j.fm.2012.09.025","issn":["07400020","10959998"],"issn_org":["07400020"],"issue":"2","journal":"Food Microbiology","pages":"277-283","status":"p","title":"Food Microbiology","volume":"34"},"review":"Peer Reviewed","scoID":["2-s2.0-84875636221"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-0449dd82-323f-4b3b-a672-5ed40e5e32bc"],"src":["KU University of Copenhagen"],"title":"Taxonomic and molecular characterization of lactic acid bacteria and yeasts in nunu, a Ghanaian fermented milk product","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-396022","year":"2013","yearsub":"2013"}
{"abstract":"Sikkerhedspolitik er en form for politik, der kan og gør helt specielle ting. Med begrebet ”sikkerhedsliggørelse” (securitization) har den såkaldte ”Københavnerskole” opbygget en indflydelsesrig teori centreret om, hvordan forsvar mod en eksistentiel trussel retfærdiggør brug af ekstraordinære midler. Nye sikkerhedsemner som religion og klima kræver videreudvikling af teorien for at kortlægge aktørernes ukontrollerbare kamp om dette magtfulde virkemiddel med modsætningsfyldte effekter. Nye analyseredskaber kan hjælpe samfundet med at omgås en farlig måde at imødegå fare.","author_count":4,"contributors":["Wæver, Ole"],"cuid":["S01-000.00-397577"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"pop","mra":["soc"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"und","rtype":["clu"],"sorti":"københavnerskolen opruster mod nye sikkerhedstrusler","src":["ku"],"src-code":["DI-U-KU"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-397577","ids":["ku-06db8b53-6949-4117-84ed-025414126148"],"lang":"Danish","level":"Popular","mra":["Social Science"],"noi":["Local-1-1-EEE8FD8C7E327E5F8555F22AB362876A"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Social Sciences, Department of Political Science, Centre for Resolution of International Conflicts","Københavns Universitet, Faculty of Social Sciences, Department of Political Science, Department of Political Science"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Ole","key":"wæverpau","last":"Wæver","locid":"616ba573-b094-46ed-a29b-56d8f2a5049e","name":"Wæver, Ole","orcid":"0000-0002-9053-5855","rank":1,"rolecode":"pau"},{"affno":"","first":"Lene Kyhse","key":"bisgaardpedh","last":"Bisgaard","name":"Bisgaard, Lene Kyhse","rank":2,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Anne Marie","key":"nielsenpedh","last":"Nielsen","name":"Nielsen, Anne Marie","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Esther Kvetny","key":"jarløvpedh","last":"Jarløv","name":"Jarløv, Esther Kvetny","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9878798877462"],"issn":["13957961"],"pages":"12-17","place":"Kbh.","publisher":"Carlsbergfondet","series":"Carlsbergfondet. Aarsskrift","status":"p","title":"Carlsbergfondet Årsskrift 2013"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-06db8b53-6949-4117-84ed-025414126148"],"src":["KU University of Copenhagen"],"title":"Københavnerskolen opruster mod nye sikkerhedstrusler","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-397577","year":"2013","yearsub":"2013"}
{"abstract":"Abstract Aims. To explore hormonal counterregulation to biochemical hypoglycaemia during pregnancy. Methods. Observational study of 107 consecutive pregnant women with type 1 diabetes (median duration 16 years (range 1-36), HbA1c 6.6% (4.9-10.5) in early pregnancy) and 22 healthy pregnant women. At 8, 14, 21, 27 and 33 weeks (women with diabetes) and 15, 28 and 34 weeks (healthy women) blood was sampled for measurements of glucose, adrenaline, noradrenaline, cortisol and glucagon. Each woman's measurement of serum glucose was matched with her corresponding hormone concentrations. Severe hypoglycaemia (requiring help from another person) was recorded prospectively. Results. During normoglycaemia (serum glucose > 3.9 mmol/L), adrenaline concentrations were higher in early pregnancy compared with late pregnancy in women with diabetes (21 (7-111) pg/ml vs. 17 (2-131), p = 0.02) and healthy women (21 (10-37) pg/ml vs. 13 (5-49), p = 0.046). Biochemical hypoglycaemia (serum glucose ≤ 3.9 mmol/L) occurred in 70 women with diabetes (65%) in at least one of the five samplings. At 8 and 33 weeks, adrenaline concentrations at biochemical hypoglycaemia were similar (30 (5-164) pg/ml and 29 (9-152), p = 0.79). Adrenaline concentrations at biochemical hypoglycaemia increased from normoglycaemia at diabetes duration <16 years (p = 0.03). In first trimester, adrenaline concentrations were comparable in women with or without severe hypoglycaemia (24 (14-164) pg/ml vs. 33 (5-86), p = 0.35). Noradrenaline, glucagon and cortisol concentrations did not increase during biochemical hypoglycaemia. Conclusion. Adrenaline response to biochemical hypoglycaemia was present at similar levels in early and late pregnancy, particularly in shorter diabetes duration, and was not associated with severe hypoglycaemia in early pregnancy.","author_count":7,"contributors":["Pedersen-Bjergaard, Ulrik","Thorsteinsson, Birger","Boomsma, Frans","Rehfeld, Jens F","Damm, Peter","Mathiesen, Elisabeth R.","Nielsen, Lene Ringholm"],"cuid":["S01-000.00-399557"],"filters":{"added":"2022-04","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"impaired hormonal counterregulation to biochemical hypoglycaemia does not explain the high incidence of severe hypoglycaemia during pregnancy in women with type 000000000001 diabetes","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.3109/00365513.2012.742926","version":"Other Version"},"id":"S01-000.00-399557","identifier":[{"id":"23194474","type":"pmid"},{"id":"84872191864","type":"scopus"}],"ids":["ku-0a29c212-c638-4911-b823-b74ef7ceb2d7"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-62BDE5874C3883C54DC1261C0D3314B3"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.3109/00365513.2012.742926","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":1,"key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Section of Orthopaedics and Internal Medicine"],"nora_code":"DI-U-KU"}],"person":[{"affno":"","first":"Ulrik","key":"pedersenbjergaardpau","last":"Pedersen-Bjergaard","name":"Pedersen-Bjergaard, Ulrik","rank":1,"rolecode":"pau"},{"affno":"","first":"Birger","key":"thorsteinssonpau","last":"Thorsteinsson","locid":"6ad96c95-f3af-4f85-b392-b02c0eb34d0a","name":"Thorsteinsson, Birger","rank":2,"rolecode":"pau"},{"affno":"","first":"Frans","key":"boomsmapau","last":"Boomsma","name":"Boomsma, Frans","rank":3,"rolecode":"pau"},{"affno":"","first":"Jens F","key":"rehfeldpau","last":"Rehfeld","name":"Rehfeld, Jens F","rank":4,"rolecode":"pau"},{"affno":"","first":"Peter","key":"dammpau","last":"Damm","locid":"884d03d5-5981-4d33-80c6-adb21f836deb","name":"Damm, Peter","rank":5,"rolecode":"pau"},{"affno":"","first":"Elisabeth R","key":"mathiesenpau","last":"Mathiesen","locid":"3acd58f4-6d64-4a89-a406-d2f43b310500","name":"Mathiesen, Elisabeth R.","name_org":"Mathiesen, Elisabeth R","rank":6,"rolecode":"pau"},{"affno":"","first":"Lene Ringholm","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Lene Ringholm","rank":7,"rolecode":"pau"}],"pmid":["23194474"],"pub":{"doi":"10.3109/00365513.2012.742926","issn":["00365513","0085591X"],"issn_org":["00365513"],"issue":"1","journal":"Scandinavian Journal of Clinical & Laboratory Investigation","pages":"67-74","status":"p","title":"Scandinavian Journal of Clinical & Laboratory Investigation","volume":"73"},"review":"Peer Reviewed","scoID":["2-s2.0-84872191864"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-0a29c212-c638-4911-b823-b74ef7ceb2d7"],"src":["KU University of Copenhagen"],"title":"Impaired hormonal counterregulation to biochemical hypoglycaemia does not explain the high incidence of severe hypoglycaemia during pregnancy in women with type 1 diabetes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-399557","year":"2013","yearsub":"2013"}
{"abstract":"Since its introduction to the market in the 1970s, the synthetic biocide triclosan has had widespread use in household and medical products. Although decreased triclosan susceptibility has been observed for several bacterial species, when exposed under laboratory settings, no in vivo studies have associated triclosan use with decreased triclosan susceptibility or cross-resistance to antibiotics. One major challenge of such studies is the lack of strains that with certainty have not been exposed to triclosan. Here we have overcome this challenge by comparing current isolates of the human opportunistic pathogen Staphylococcus epidermidis with isolates collected in the 1960s prior to introduction of triclosan to the market. Of 64 current S. epidermidis isolates 12.5% were found to have tolerance towards triclosan defined as MIC≥0.25 mg/l compared to none of 34 isolates obtained in the 1960s. When passaged in the laboratory in the presence of triclosan, old and current susceptible isolates could be adapted to the same triclosan MIC level as found in current tolerant isolates. DNA sequence analysis revealed that laboratory-adapted strains carried mutations in fabI encoding the enoyl-acyl carrier protein reductase isoform, FabI, that is the target of triclosan, and the expression of fabI was also increased. However, the majority of the tolerant current isolates carried no mutations in fabI or the putative promoter region. Thus, this study indicates that the widespread use of triclosan has resulted in the occurrence of S. epidermidis with tolerance towards triclosan and that the adaptation involves FabI as well as other factors. We suggest increased caution in the general application of triclosan as triclosan has not shown efficacy in reducing infections and is toxic to aquatic organisms.","author_count":6,"contributors":["Skovgaard, Sissel","Nielsen, Lene Nørby","Larsen, Marianne Halberg","Skov, Robert Leo","Ingmer, Hanne","Westh, Henrik"],"cuid":["S01-000.00-416204"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Anti Infective Agents Local","Drug Resistance Bacterial","Microbial Sensitivity Tests","Staphylococcus epidermidis","Time Factors","Triclosan"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"em staphylococcus epidermidis em isolated in 000000001965 are more susceptible to triclosan than current isolates","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1371/journal.pone.0062197","version":"Other Version"},"id":"S01-000.00-416204","identifier":[{"id":"84876182475","type":"scopus"},{"id":"23614034","type":"pmid"},{"id":"PMC3628582","type":"pmcid"}],"ids":["ku-261cc82e-bc64-45db-8418-a270ed5d22a5"],"keyword":["Anti-Infective Agents, Local","Drug Resistance, Bacterial","Microbial Sensitivity Tests","Staphylococcus epidermidis","Time Factors","Triclosan"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-D9D41DD243BB076A85807D59260B90B7"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1371/journal.pone.0062197","version":"Other Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Amager and Hvidovre"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary and Animal Sciences, Food Safety and Zoonoses"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"dk","key":"ssi statens serum institut","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-SSI","l3nn":"SSI Statens Serum Institut","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SSI Statens Serum Institut","namevar":["Statens Serum Institut"],"nora_code":"DI-GV-SSI","used":1}],"person":[{"affno":"1","first":"Sissel","key":"skovgaardpau","last":"Skovgaard","name":"Skovgaard, Sissel","rank":1,"rolecode":"pau"},{"affno":"2","first":"Lene Nørby","key":"nielsenpau","last":"Nielsen","locid":"1a4f890a-d171-4c2f-ae00-dd1e024c25ab","name":"Nielsen, Lene Nørby","rank":2,"rolecode":"pau"},{"affno":"2","first":"Marianne Halberg","key":"larsenpau","last":"Larsen","locid":"da445e7f-59a6-4e1c-ad17-57e0e317ce6a","name":"Larsen, Marianne Halberg","orcid":"0000-0001-6242-6937","rank":3,"rolecode":"pau"},{"affno":"3","first":"Robert Leo","key":"skovpau","last":"Skov","name":"Skov, Robert Leo","rank":4,"rolecode":"pau"},{"affno":"2","first":"Hanne","key":"ingmerpau","last":"Ingmer","locid":"abe2cd31-84e7-4f06-81a3-33e08bf93b8f","name":"Ingmer, Hanne","orcid":"0000-0002-8350-5631","rank":5,"rolecode":"pau"},{"affno":"2","first":"Henrik T.","key":"westhpau","last":"Westh","locid":"5ed71556-672c-4f57-95de-3abba6b821ea","name":"Westh, Henrik","name_org":"Westh, Henrik T.","rank":6,"rolecode":"pau"}],"pmid":["23614034"],"pub":{"doi":"10.1371/journal.pone.0062197","issn":["19326203"],"issue":"4","journal":"PLOS ONE","paperid":"e62197","status":"p","title":"PLOS ONE","volume":"8"},"review":"Peer Reviewed","scoID":["2-s2.0-84876182475"],"search":{"DAF":["All Danish Affiliations","All