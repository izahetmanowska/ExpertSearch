locid":"77dd556a-eb2b-4dfa-9100-d11f84083fad","name":"Berring, Lene Lauge","name_org":"Berring, Lene L","orcid":"0000-0002-0529-8980","rank":3,"rolecode":"pau"}],"pmid":["37372681"],"pub":{"doi":"10.3390/ijerph20126094","issn":["16604601","16617827"],"issn_org":["16617827"],"issue":"12","journal":"International Journal of Environmental Research and Public Health","paperid":"6094","publisher":"Multidisciplinary Digital Publishing Institute (MDPI)","status":"p","title":"International Journal of Environmental Research and Public Health","volume":"20"},"review":"Peer Reviewed","scoID":["2-s2.0-85163729644"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region Zealand","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-feb7ae0c-5dfd-4a92-846f-52fd3a49b506"],"src":["SDU University of Southern Denmark"],"title":"Mental Health Recovery in Social Psychiatric Policies : A Reflexive Thematic Analysis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-685502","year":"2023","yearsub":"2023"}
