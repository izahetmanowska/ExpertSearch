affno":"1","corresponding":null,"first":"Rike","key":"neuhoffpau","last":"Neuhoff","name":"Neuhoff, Rike","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Olivia","key":"harrepau","last":"Harre","locid":"8949ca8c-746d-4a53-b816-ec9ebf06764c","name":"Harre, Olivia Thomassen","name_org":"Harre, Olivia","orcid":"0009-0001-3681-3770","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Luca","key":"simeonepau","last":"Simeone","name":"Simeone, Luca","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lene","key":"nielsenpau","last":"Nielsen","locid":"1052b289-f510-4c5a-9662-2db48c12ebc2","name":"Nielsen, Lene","orcid":"0000-0003-1768-7147","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lea","key":"holstlaursenpau","last":"Holst Laursen","name":"Holst Laursen, Lea","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.21606/drs.2022.223","place":"Bilbao","publisher":"Design Research Society","status":"p","title":"DRS2022"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-a32b715b-a31f-4941-ab80-a0e4ae102f60"],"src":["ITU IT University of Copenhagen"],"title":"Engaging with competing demands in systems through design: Fostering a paradox lens","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383647","year":"2022","yearsub":"2022"}
{"abstract":"Personas represent distinct user types. However, while online user data can be demographically and behaviorally heterogeneous, most studies generate less than ten personas, regardless of how heterogeneous the data is. Because all persona creation efforts need to assign a number of personas to create, assigning this number evokes a fundamental question, How many personas to create?. To address this question, we apply data-driven persona creation in a dataset with 250 million YouTube views from a global news and media organization. We focus on a statistically optimal number of personas, namely, how the distribution of demographic persona attributes deviates from the baseline user data. Altering the number of generated personas, ranging from 5 to 160 personas per set, we find that more personas cover more age groups and countries, thus improving the statistical correspondence with the raw user data, and increasing the representation of demographic diversity by including more fringe user segments. While the user representation continuously improved with more personas, the relative diversity gain was maximal with 40 personas, implying that, using our data, one ought to create more than 4 times more personas than generally advocated. The results imply that organizations with heterogeneous online audiences benefit from many personas in terms of more inclusive user representation. We further demonstrate how an interactive persona system can help stakeholders navigate many personas with possibly smaller cognitive effort.","author_count":4,"contributors":["Salminen, Joni","Jung, Soon-Gyo","Nielsen, Lene","Jansen, Bernard"],"cuid":["S01-000.00-384463"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Data driven personas","User segmentation","number of personas"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"creating more personas improves representation of demographically diverse populations implications towards interactive persona systems","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85140885783","version":"Other Version"},"id":"S01-000.00-384463","identifier":[{"id":"85140885783","type":"scopus"}],"ids":["itu-d90e5323-b007-4fc4-b826-8cb89f2e7c92"],"keyword":["Data-driven personas","number of personas","user segmentation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-38E17DD361AC46A29EE2B658A9CE7CB2"],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Joni","key":"salminenpau","last":"Salminen","name":"Salminen, Joni","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Soon-Gyo","key":"jungpau","last":"Jung","name":"Jung, Soon-Gyo","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lene","key":"nielsenpau","last":"Nielsen","locid":"1052b289-f510-4c5a-9662-2db48c12ebc2","name":"Nielsen, Lene","orcid":"0000-0003-1768-7147","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Bernard","key":"jansenpau","last":"Jansen","name":"Jansen, Bernard","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1145/3546155.3546654","pages":"1-11","publisher":"Association for Computing Machinery","status":"p","title":"Nordic Human-Computer Interaction Conference (NordiCHI '22)"},"review":"Peer Reviewed","scoID":["2-s2.0-85140885783"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-d90e5323-b007-4fc4-b826-8cb89f2e7c92"],"src":["ITU IT University of Copenhagen"],"title":"Creating More Personas Improves Representation of Demographically Diverse Populations : Implications Towards Interactive Persona Systems","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-384463","year":"2022","yearsub":"2022"}
{"abstract":"BACKGROUND: Immune-related adverse events due to immune checkpoint inhibitors (ICIs) are not always effectively treated using glucocorticoids and it may negatively affect the antitumor efficacy of ICIs. Interventional studies of alternatives to glucocorticoids are lacking. We examined whether interleukin-6 blockade by tocilizumab reduced ICI-induced colitis and arthritis. PATIENTS AND METHODS: Patients with solid cancer experiencing Common Terminology Criteria for Adverse Events (CTCAE v5.0) grade >1 ICI-induced colitis/diarrhea (n=9), arthritis (n=9), or both (n=2) were recruited and treated with tocilizumab (8 mg/kg) every 4 weeks until worsening or unacceptable toxicity. Patients were not allowed to receive systemic glucocorticoids and other immunosuppressive drugs within the 14-day screening period. The primary endpoint was clinical improvement of colitis and arthritis, defined as ≥1 grade CTCAE reduction within 8 weeks. Secondary endpoints were improvements and glucocorticoid-free remission at week 24; safety; radiologic, endoscopic, and histological changes; and changes in plasma concentrations of C reactive protein, cytokines (IL-6, IL-8, and IL-17), and YKL-40. RESULTS: Nineteen patients were available for efficacy analysis; one patient was excluded due to pancreatic insufficiency-induced diarrhea. Patients received treatment with pembrolizumab (n=10) or nivolumab (n=4) as monotherapy or ipilimumab and nivolumab (n=5) combined. Seven patients had been initially treated with glucocorticoids, and two of them also received infliximab. Ten patients continued ICI therapy during tocilizumab treatment. The primary endpoint was achieved in 15 of 19 (79%) patients. Additional one patient had ≥1 grade reduction at week 10, and another patient had stabilized symptoms. At week 24, ongoing improvement without glucocorticoids (n=12), including complete remission (n=10), was noted. Five patients had grades 3-4 treatment-related adverse events, which were manageable and reversible. CONCLUSIONS: Tocilizumab showed promising clinical efficacy and a manageable safety profile in the treatment of ICI-induced colitis and arthritis. Our findings support the feasibility of randomized trials of immune-related adverse events. TRIAL REGISTRATION NUMBER: NCT03601611.","author_count":13,"contributors":["Holmstroem, Rikke Boedker","Nielsen, Ole Haagen","Jacobsen, Søren","Riis, Lene Buhl","Theile, Susann","Bjerrum, Jacob Tveiten","Vilmann, Peter","Johansen, Julia S.","Boisen, Mogens Karsbøl","Eefsen, Rikke Helene Løvendahl","Svane, Inge Marie","Nielsen, Dorte Lisbet","Chen, Inna Markovna"],"cuid":["S01-000.00-425144"],"filters":{"added":"2022-11","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"keyword":["CTLA 4 Antigen","Cytokines","Cytotoxicity Immunologic","Immunotherapy","Programmed Cell Death 1 Receptor"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"colar open label clinical study of il 000000000006 blockade with tocilizumab for the treatment of immune checkpoint inhibitor induced colitis and arthritis","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/jitc-2022-005111","version":"Published Version"},"id":"S01-000.00-425144","identifier":[{"id":"PMC9472120","type":"pmcid"},{"id":"85137673805","type":"scopus"},{"id":"36096534","type":"pmid"}],"ids":["ku-35618398-c6ec-47f4-9009-c43349bc4410"],"keyword":["CTLA-4 Antigen","Cytokines","Cytotoxicity, Immunologic","Immunotherapy","Programmed Cell Death 1 Receptor"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-86360F5D2F9CE60C66B777A0C97B6479"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.1136/jitc-2022-005111","version":"Published Version"},{"access":"oa","license":"CC BY-NC","type":"loc","url":"https://curis.ku.dk/ws/files/320653840/e005111.full.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-HO-CAP","used":1}],"person":[{"affno":"1","first":"Rikke Boedker","key":"holmstroemrikkeboedkerpau","last":"Holmstroem","locid":"53817ff7-b24a-4e25-9673-d2dd3d72c280","name":"Holmstroem, Rikke Boedker","rank":1,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Ole Haagen","key":"nielsenolehaagenpau","last":"Nielsen","locid":"d59658c4-dde8-4749-9b5c-f4ec5910dd02","name":"Nielsen, Ole Haagen","orcid":"0000-0003-4612-8635","rank":2,"rolecode":"pau"},{"affno":"1","first":"Søren","key":"jacobsensørenpau","last":"Jacobsen","locid":"2e4e0e73-2c03-4ba5-9956-e84d75506240","name":"Jacobsen, Søren","rank":3,"rolecode":"pau"},{"affno":"1","first":"Lene Buhl","key":"riislenebuhlpau","last":"Riis","locid":"8ec061c0-f464-42fd-ac8d-f972f86292cd","name":"Riis, Lene Buhl","rank":4,"rolecode":"pau"},{"affno":"2","first":"Susann","key":"theilesusannpau","last":"Theile","name":"Theile, Susann","rank":5,"r