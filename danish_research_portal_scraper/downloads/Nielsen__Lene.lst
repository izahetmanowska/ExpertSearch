ion Zealand","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region Zealand","namevar":["Roskilde Sygehus"],"nora_code":"DI-HO-ZEA","used":1},{"affno":7,"key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Immunology and Microbiology, Department of Immunology and Microbiology"],"nora_code":"DI-U-KU"}],"person":[{"affno":"1","corresponding":null,"first":"Maiken Cavling","key":"arendrupmaikencavlingpau","last":"Arendrup","name":"Arendrup, Maiken Cavling","rank":1,"rolecode":"pau"},{"affno":"2 3","corresponding":null,"first":"Sofia","key":"sulimsofiapau","last":"Sulim","name":"Sulim, Sofia","rank":2,"rolecode":"pau"},{"affno":"4","corresponding":null,"country":"dk","first":"Anette","key":"holmanettepau","last":"Holm","locid":"bf236581-7ff9-4735-9100-9e863e41e609","name":"Holm, Anette","orcid":"0000-0001-7794-2846","rank":3,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Lene","key":"nielsenlenepau","last":"Nielsen","name":"Nielsen, Lene","rank":4,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Susanne Dam","key":"nielsensusannedampau","last":"Nielsen","name":"Nielsen, Susanne Dam","rank":5,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Jenny Dahl","key":"knudsenjennydahlpau","last":"Knudsen","name":"Knudsen, Jenny Dahl","rank":6,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Niels Erik","key":"drencknielserikpau","last":"Drenck","name":"Drenck, Niels Erik","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens Jørgen","key":"christensenjensjørgenpau","last":"Christensen","name":"Christensen, Jens Jørgen","rank":8,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Helle Krogh","key":"johansenhellekroghpau","last":"Johansen","name":"Johansen, Helle Krogh","rank":9,"rolecode":"pau"}],"pmid":["21715585"],"pub":{"doi":"10.1128/jcm.00179-11","issn":["00951137","1070633X"],"issn_org":["00951137"],"issue":"9","journal":"Journal of Clinical Microbiology","pages":"3300-8","publisher":"American Society for Microbiology","status":"p","title":"Journal of Clinical Microbiology","volume":"49"},"review":"Peer Reviewed","scoID":["2-s2.0-80052219362"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Region Zealand","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["au-19a1faec-5d94-4822-aaa4-286ca3966823","ku-81af09ea-f040-484e-ab67-a35cf4eeb767","sdu-36a94e62-c918-4176-b253-c48bb62da13b"],"src":["AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Diagnostic Issues, Clinical Characteristics, and Outcomes for Patients with Fungemia","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-100.00-014451","year":"2011","yearsub":"2011"}
{"abstract":"Aim The aim of this paper is to deepen our understanding of how patients cope with side effects from cancer treatment in daily life. Background Patients receiving cancer treatment experience acute side effects and need individualized information and guidance in order to manage treatment-related adverse events in everyday life. However development in cancer treatment and the societal demands for efficiency may limit the possibility for individualized support. Methods Nine patients were interviewed from March to July 2009 to explore the patients’ experience of coping with side effects in daily life based on information and guidance from nurses. The analysis was inspired by Kvale’s three contexts of interpretation, supplemented by Lindseth and Norberg’s method for the interpretation of interview texts. Findings The patients strive to maintain a normal life and struggle to preserve their identity but the side effects can control the daily life. Patients do not always possess the knowledge of how to handle the side effects and adaptation to the institutional efficiency can lead to lack of confidence and feelings of responsibility and guilt concerning coping with these side effects. The nurses need to be better at looking “behind the screen” and using different methods to avoid pitfalls in the information and guidance. Conclusion Lack of information and guidance based on the perspective of the patients can lead to unnecessary suffering. In spite of the societal demands for efficiency the nurses must strive to find a way to support the patients individually in controlling the impact from side effects on daily life and to create a feeling of normality.","author_count":3,"contributors":["Pedersen, Birgith","Koktved, Dorte Pallesen","Nielsen, Lene Lyngø"],"cuid":["S01-000.00-250227"],"event":{"end":"2011-05-07","place":"Valetta, mt","start":"2011-05-02","title":"ICN Kongres 2011","year":"2011"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"nr","rtype":["clu"],"sorti":"coping with side effects from cancer treatment in daily life from the perspective of cancer patients a qualitative empirical study","src":["au"],"src-code":["DI-U-AU"],"type":"dca","type-grp":["all","pub"]},"id":"S01-000.00-250227","ids":["au-d3b51f84-eed5-4a95-a0dd-a9df1cabb264"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-1284155AE75B01F6265BF475D249F462"],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Aarhus University, Faculty of Health Sciences, Onkologisk Afdeling, Aalborg Sygehus"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Birgith","key":"pedersenpau","last":"Pedersen","locid":"dd089ae4-04af-4afd-ab25-22c3236e68c7","name":"Pedersen, Birgith","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Dorte Pallesen","key":"koktvedpau","last":"Koktved","locid":"88908f13-bc6d-40e3-b64a-159d5fb57657","name":"Koktved, Dorte Pallesen","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lene Lyngø","key":"nielsenpau","last":"Nielsen","locid":"59e3ed7a-eb24-4d0c-9ecf-d17134266c19","name":"Nielsen, Lene Lyngø","rank":3,"rolecode":"pau"}],"pub":{"status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-d3b51f84-eed5-4a95-a0dd-a9df1cabb264"],"src":["AU Aarhus University"],"title":"Coping with side effects from cancer treatment in daily life from the perspective of cancer patients: A qualitative empirical study.","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-250227","year":"2011","yearsub":"2011"}
{"abstract":"Fokus på madordninger i daginstitutioner og kvaliteten heraf har været stigende de seneste år. Mange nye madordninger er etableret i løbet af 2009 og 2010 især i børnehaver og i børnehavegrupper i de integrerede daginstitutioner. I 2009 opstillede Fødevarestyrelsen anbefalinger for den ernæringsmæssige kvalitet af de fælles frokostmåltider, der serveres i daginstitutionerne. Formålet med denne undersøgelse har været at evaluere, hvor stor en del af daginstitutionerne med madordninger, der opfylder disse anbefalinger. Et spørgeskema blev udarbejdet på baggrund af anbefalingerne og pilottestet blandt 13 daginstitutioner. Spørgeskemaet tog hovedsagelig udgangspunkt i den foregående uges frokostudbud. Et pointsystem blev udviklet ud fra både hvor hyppigt de enkelte fødevarer blev serveret og i forhold til fødevarernes kvalitet, fx fedtindhold og fedttype (mættet kontra umættet fedt). Jo flere anbefalinger der efterleves, jo flere point opnås (max 32 point). Spørgeskemaet blev udsendt til et repræsentativt udsnit af alle landet institutioner med madordninger. I alt 376 institutioner besvarede skemaet fyldestgørende (svarprocent 64). Flertallet af daginstitutionerne med madordninger tilberedte frokostmåltiderne intern i institutionen frem for at få maden fra en ekstern leverandør (hhv. 94 % af vuggestuerne, 91 % af de integrerede institutioner og 71 % af børnehaverne). Der blev generelt udtrykt stor tilfredshed med madordningerne blandt institutionerne med intern madordning. Langt hovedparten af respondenterne opfattede både ledelse, pædagoger, køkkenpersonale, forældre og børn som værende tilfredse eller meget tilfredse med madordningen (92 % - 97 %). Billedet var mere blandet i relation til de eksterne madordninger (34 % - 64 % tilfredse eller meget tilfredse;. køkkenpersonale ikke medtaget). Med hensyn til i hvor høj grad måltiderne opfylder de ernæringsmæssige anbefalinger viste resultaterne, at de fleste af daginstitutionerne opfyldte mindst to tredjedele af anbefalingerne (81 % med 22 point eller flere). Langt de fleste institutioner angav da også, at de anvendte adskillige ernæringsmæssige anbefalinger i relation til planlægningen af deres menuplan. Dog blev kun lidt over en tredjedel af institutionerne (36 %) vurderet til at opfylde alle eller stort set alle anbefalinger (26 point eller flere). Lidt bedre til at opfylde anbefalingerne var de daginstitutioner, der planlagde frokostmenuerne for en uge af gangen (39 %) i forhold til de institutioner, der planlagde fra dag til dag (17 %). Opsummerende viste resultaterne, at mange daginstitutioner har svært ved at opfylde alle Fødevarestyrelsens anbefalinger for det fælles frokostmåltid. Dette gælder især anbefalingerne i relation til fødevaregrupperne ”kød, kødpålæg og æg” (især kvaliteten), ”fedtstoffer” (både hyppighed og kvalitet) og ”ost” (både hyppighed og kvalitet). Dette betyder, at børnene i mange tilfælde får tilbudt mere mættet fedt end anbefalet. Fokus bør være på, at anvende produkter med en høj andel af umættet fedt frem for mættet fedt samt at servere fisk, grøntsager, kartofler, samt fuldkornsvarianter af ris, pasta og brød mere hyppigt.","author_count":4,"contributors":["Nielsen, Marie Heyn","Lassen, Anne Dahl","Christensen, Lene Møller","Sabinsky, Marianne"],"cuid":["S01-000.00-313474"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"com","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"nr","rtype":["clu"],"sorti":"evaluering af den ernæringsmæssige kvalitet af madordninger i daginstitutioner","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/5642627/Rapport-Ern_ringsm_ssig.pdf","version":"Published Version"},"id":"S01-000.00-313474","ids":["dtu-1dceedba-adc4-4450-b23c-01e417a29621"],"lang":"English","level":"Commissioned","mra":["Science/Technology"],"noi":["Local-1-1-34664BA613C092221EFC86166E0D86B3"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/5642627/Rapport-Ern_ringsm_ssig.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Food Institute","Technical University of Denmark, National Food Institute, Division of Nutrition"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Marie Heyn","key":"nielsenpau","last":"Nielsen","locid":"dafee635-c3da-4078-a79e-5eb7f4fe96a8","name":"Nielsen, Marie Heyn","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anne Dahl","key":"lassenpau","last":"Lassen","locid":"93070bb0-5767-4f77-9c43-3b3f9deb0c82","name":"Lassen, Anne Dahl","orcid":"0000-0002-3262-3611","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lene Møller","key":"christensenpau","last":"Christensen","locid":"f1c81468-e814-4649-87b2-7c0e59ceaaab","name":"Christensen, Lene Møller","orcid":"0000-0001-7424-5818","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Marianne","key":"sabinskypau","last":"Sabinsky","locid":"875949a7-f98e-4b1a-bad8-7dfc6f866068","name":"Sabinsky, Marianne","orcid":"0000-0001-5738-2714","rank":4,"rolecode":"pau"}],"pub":{"isbn":["9788792158994"],"pages":"63","place":"Søborg","publisher":"DTU Fødevareinstituttet","status":"p"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":[