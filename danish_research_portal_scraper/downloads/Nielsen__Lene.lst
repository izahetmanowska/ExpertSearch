 Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region Zealand","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-3c8c6f1c-7f04-4fc8-ae04-36b5d842154e"],"src":["KU University of Copenhagen"],"title":"A prospective cohort study of confirmed severe acute respiratory syndrome coronavirus 2 (SARS-CoV-2) infection during pregnancy evaluating SARS-CoV-2 antibodies in maternal and umbilical cord blood and SARS-CoV-2 in vaginal swabs","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-429625","year":"2021","yearsub":"2021"}
{"abstract":"Thrips are a major pest in protected strawberry production. Knowledge of thrips species composition could be instrumental for improved thrips management, but very little is known about which species are present in strawberries grown in high-tunnels in Denmark. Thrips (adults and larvae) were sampled in two strawberry tunnels of the cultivars Murano and Furore from May to August 2018, in the middle and in the edges of the tunnels. The most abundant thrips species found in the tunnels were Frankliniella intonsa and Thrips tabaci adults. Frankliniella intonsa were also the most frequently found species of the immatures sampled, followed by T. tabaci larvae, and other species. The number of thrips differed between the two cultivars, sampling times and location in the tunnel. Frankliniella intonsa was more abundant in the middle of the tunnels, while T. tabaci was more abundant in the edge of the tunnels adjacent to the field margins. The number of thrips peaked by the end of July. Both chemical and biological control should consider species composition and occurrence; hence, a fundamental first step for thrips management is to identify the species present on the target crop.","author_count":5,"contributors":["Nielsen, Helene","Sigsgaard, Lene","Kobro, Sverre","Jensen, Nauja L.","Jacobsen, Stine Kramer"],"cuid":["S01-000.00-480542"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Europe, Non-EU","Nordic","OECD"],"country":["Norway"],"glorg":["All Global Affiliations","Norwegian Institute of Bioeconomy"],"keyword":["Molecular identification","Species identification","Strawberries","Thrips"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-PR-OTH","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"species composition of thrips thysanoptera thripidae in strawberry high tunnels in denmark","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/insects12030208","version":"Published Version"},"id":"S01-000.00-480542","identifier":[{"id":"85102678722","type":"scopus"},{"id":"000633769300001","type":"wos"},{"id":"PMC8001524","type":"pmcid"},{"id":"33801241","type":"pmid"}],"ids":["ku-91c92da0-2f73-4e5c-b68e-29cdca3bbd11"],"keyword":["Distribu-tion","Fast-slide-preparation","Frankliniella intonsa","Molecular identification","Species identification","Strawberries","Thrips","Thrips tabaci"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-A2061320073B53978097A4E7152AC47E"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/insects12030208","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/259987627/insects_12_00208.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Plant and Environmental Sciences"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"no","key":"norwegian institute of bioeconomy","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"Norwegian Institute of Bioeconomy","used":1},{"affno":"3","country":"dk","key":"other companies","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-OTH","l3nl":"Other Companies","l3nn":"Other Companies","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Other Companies","namevar":["HortiAdvice Scandinavia (Biz)"],"nora_code":"DI-PR-OTH","used":1}],"person":[{"affno":"1","first":"Helene","key":"nielsenpau","last":"Nielsen","locid":"db1777ac-f1a4-4226-9031-3a88f4e9a634","name":"Nielsen, Helene","rank":1,"rolecode":"pau"},{"affno":"1","first":"Lene","key":"sigsgaardpau","last":"Sigsgaard","locid":"f42b8a8c-a544-430a-bab3-47820fbdb7ce","name":"Sigsgaard, Lene","orcid":"0000-0001-6478-5079","rank":2,"rolecode":"pau"},{"affno":"2","first":"Sverre","key":"kobropau","last":"Kobro","name":"Kobro, Sverre","rank":3,"rolecode":"pau"},{"affno":"3","first":"Nauja L.","key":"jensenpau","last":"Jensen","name":"Jensen, Nauja L.","rank":4,"rolecode":"pau"},{"affno":"1","first":"Stine K.","key":"jacobsenpau","last":"Jacobsen","locid":"37049fe0-348a-44dd-978f-eb3fed2b1ecd","name":"Jacobsen, Stine Kramer","name_org":"Jacobsen, Stine K.","orcid":"0000-0002-0986-5639","rank":5,"rolecode":"pau"}],"pmid":["33801241"],"pub":{"doi":"10.3390/insects12030208","issn":["20754450"],"issue":"3","journal":"Insects","paperid":"208","status":"p","title":"Insects","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-85102678722"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Other Companies","Private Research","Universities","University of Copenhagen","hortiadvice scandinavia (biz)"],"PST":["Published"]},"sid":["ku-91c92da0-2f73-4e5c-b68e-29cdca3bbd11"],"src":["KU University of Copenhagen"],"title":"Species composition of thrips (Thysanoptera: Thripidae) in strawberry high tunnels in Denmark","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-480542","year":"2021","yearsub":"2021"}
{"abstract":"Transitioning a company from product-centricity to a new service-centred offering requires substantial changes, which can have deep implications for the company’s processes, structure, and technology. Strategic thinking can help managers and employees to plan and cope with change. Our paper offers empirical insight into how a Danish IT company that is transitioning to being service-centric hosted and facilitated a set of design workshops to foster strategic thinking across the organization. Such design workshops were structured to invite participants to adopt multiple perspectives and think through different temporalities, while mediating the interaction to allow diverse perspectives to emerge.","author_count":3,"contributors":["Harre, Olivia","Simeone, Luca","Nielsen, Lene"],"cuid":["S02-086.84-001675"],"event":{"end":"2021-10-16","place":"Online","start":"2021-10-11","title":"14th European Academy of Design Conference 2021","year":"2021"},"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Design workshop","Design workshops","IT company","Organizational change","Service Design","service centric transformation","strategic thinking"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-AAU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"moving from products to services supporting strategic thinking through design workshops","src":["aau","itu"],"src-code":["DI-U-AAU","DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/450316593/EAD2021_Design_workshops_and_strategic_thinking_CAMERA_READY.pdf","version":"Published Version"},"id":"S02-086.84-001675","ids":["aau-2120086f-6523-474f-906a-559ed16c646e","itu-7508cc96-3863-4458-a3de-e15bbecef651"],"keyword":["Design workshop","IT company","Service Design","design workshops","organizational change","service centricity","service-centric transformation","strategic thinking"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-2-87F0F4F8E04A871069882942FA2B40B8"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86334070/EAD2021_Design_workshops_and_strategic_thinking_CAMERA_READY.pdf","version":"Other Version"},{"access":"oa","type":"loc","url":"https://vbn.aau.dk/ws/files/450316593/EAD2021_Design_workshops_and_strategic_thinking_CAMERA_READY.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Digital Business Innovation, Information Systems and Digital Innovation"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Technical Faculty of IT and Design","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology, Section for Media Technology - Campus Copenhagen","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology, Service Systems Design"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Olivia Thomassen","key":"harrepau","last":"Harre","locid":"8949ca8c-746d-4a53-b816-ec9ebf06764c","name":"Harre, Olivia Thomassen","orcid":"0009-0001-3681-3770","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Luca","key":"simeonepau","last":"Simeone","locid":"a4374675-6d6b-4886-b088-e943964db21a","name":"Simeone, Luca","orcid":"0000-0003-0527-3270","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lene","key":"nielsenpau","last":"Nielsen","locid":"1052b289-f510-4c5a-9662-2db48c12ebc2","name":"Nielsen, Lene","orcid":"0000-0003-1768-7147","rank":3,"rolecode":"pau"}],"pub":{"place":"Lancaster","publisher":"The European Academy of Design","status":"p","subtitle":"Safe harbours for design research","title":"14th European Academy of Design Conference"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["aau-2120086f-6523-474f-906a-559ed16c646e","itu-7508cc96-3863-4458-a3de-e15bbecef651"],"src":["AAU Aalborg University","ITU IT University of Copenhagen"],"title":"Moving from products to services: Supporting strategic thinking through design workshops","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-086.84-001675","year":"2021","yearsub":"2021"}
{"abstract":"Personas is a suggested method to extend IT professionals' understanding of users and users’ needs. A common advantage expressed is that personas extend the IT professionals’ empathy for the users, but a disadvantage is that personas are typically defined at the start of a software project and gradually are forgotten, since there is little reference to the personas through the software development project. In this paper we report experiences of coaching IT professionals in defining agile user stories based on personas, called: Persona User Stories (PUS). The aim of these workshops, was to extend the usage of personas and thereby extend the IT professionals’ understanding of their users. In a research project with three companies, we coached teams of IT professionals in three-hour workshops with 76 participants in total. The workshops were conducted at each company using personas already defined by the IT professionals. The persona descriptions were based on three types of information: (a) assumptions, (b) secondary research, and (c) data specific to a project. Our findings show that personas based on assumptions result in the participants questioning the description of the personas and having difficulties in understanding the personas. For making the persona user stories (PUS), the participants used themselves more often as a reference when working with the assumption based personas, than the participants using the other two types of personas.","author_count":11,"contributors":["Nielsen, Lene","Larusdottir, Marta","Larsen, Lars Bo"],"cuid":["S02-093.27-005779"],"event":{"acronym":"INTERACT","end":"2021-09-03","place":"Bari, it","start":"2021-08-30","title":"INTERACT 2021: The 18th IFIP TV.13 International Conference on Human-Computer Interaction","year":"2021"},"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Europe, Non-EU","Nordic","OECD"],"country":["Iceland"],"glorg":["All Global Affiliations","Reykjavík University"],"keyword":["Case study","IT professionals","Persona user stories","Personas","User stories","Workshops"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-AAU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"understanding users through three types of personas","src":["aau","itu"],"src-code":["DI-U-AAU","DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-3-030-85616-8_20","version":"Published Version"},"id":"S02-093.27-005779","identifier":[{"id":"85115267005","type":"scopus"}],"ids":["aau-770a3906-a376-46fd-87ad-e593b609fc2a","itu-ee67537e-0a41-4cef-8e5b-92c45806d2f2"],"keyword":["Case study","IT professionals","Persona user stories","Personas","User stories","Workshops"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-ADD89DDBBF23752D24D89991FF9B7B23"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/978-3-030-85616-8_20","version":"Published Version"},{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/86422122/Personas_INTERACT_2021_camera_ready.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","country":"is","key":"reykjavík university","loc":["Iceland","Europe, Non-EU","Nordic","OECD"],"name":"Reykjavík University","used":1},{"affno":"3","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Technical Faculty of IT and Design","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems","Aalborg University, The Technical Faculty of IT and Design, Department of Electronic Systems, Artificial Intelligence and Sound"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lene","key":"nielsenlenepau","last":"Nielsen","locid":"1052b289-f510-4c5a-9662-2db48c12ebc2","name":"Nielsen, Lene","orcid":"0000-0003-1768-7147","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Marta","key":"larusdottirmartapau","last":"Larusdottir","name":"Larusdottir, Marta","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Lars Bo","key":"larsenlarsbopau","last":"Larsen","locid":"0f770a4f-bd24-4330-be1e-877e6b58f6c3","name":"Larsen, Lars Bo","orcid":"0000-0002-0509-2165","rank":3,"rolecode":"pau"},{"affno":"","first":"Carmelo","key":"arditocarmelopedh","last":"Ardito","name":"Ardito, Carmelo","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"C","key":"arditocpedh","last":"Ardito","name":"Ardito, C","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Rosa","key":"lanzilottirosapedh","last":"Lanzilotti","name":"Lanzilotti, Rosa","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Alessio","key":"maliziaalessiopedh","last":"Malizia","name":"Malizia, Alessio","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Helen","key":"petriehelenpedh","last":"Petrie","name":"Petrie, Helen","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Antonio","key":"piccinnoantoniopedh","last":"Piccinno","name"