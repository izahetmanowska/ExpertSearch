rk","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"3","country":"dk","key":"kennedy center","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-KEN","l3nn":"Kennedy Center","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Kennedy Center","namevar":["Kennedy Center"],"nora_code":"DI-HO-KEN","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Carsten Ammitzbøl","key":"lauridsenpau","last":"Lauridsen","locid":"13007f72-d0e8-4137-823c-fcc65aaf98fe","name":"Lauridsen, Carsten Ammitzbøl","orcid":"0000-0003-3383-4688","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Eva","key":"falletinpau","last":"Falletin","name":"Falletin, Eva","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Martin Lundsgaard","key":"hansenpau","last":"Hansen","name":"Hansen, Martin Lundsgaard","rank":3,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Ian","key":"lawpau","last":"Law","name":"Law, Ian","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Birgitte","key":"federspielpau","last":"Federspiel","name":"Federspiel, Birgitte","rank":5,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lene","key":"bæksgaardpau","last":"Bæksgaard","name":"Bæksgaard, Lene","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lars Bo","key":"svendsenpau","last":"Svendsen","name":"Svendsen, Lars Bo","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Michael Bachmann","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Michael Bachmann","rank":8,"rolecode":"pau"}],"pub":{"issn":["19326203"],"issue":"Volume 9","journal":"PLOS ONE","pages":"1-10","publisher":"Public Library of Science","status":"p","title":"PLOS ONE","title_org":"P L o S One"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Hospitals","All University Colleges","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-UC","DI-UC-ALL","Hospitals","KP","University Colleges"],"PST":["Published"]},"sid":["kp-b87bc95b-e886-4efd-893a-1ee0c491ea97"],"src":["KP University College Copenhagen"],"title":"Computed Tomography (CT) Perfusion as an early prognostic marker for treatment response to neoadjuvant chemotherapy in gastroesophageal junction cancer and gastric cancer - a prospective study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-391085","year":"2014","yearsub":"2014"}
{"abstract":"In the present work, an in vitro model of the gastrointestinal tract (GIT) was developed to obtain real-time observations of the pH homeostasis of single cells of probiotic Lactobacillus spp. strains as a measure of their physiological state. Changes in the intracellular pH (pHi) were determined using fluorescence ratio imaging microscopy (FRIM) for potential probiotic strains of Lactobacillus plantarum UFLA CH3 and Lactobacillus brevis UFLA FFC199. Heterogeneous populations were observed, with pHi values ranging from 6.5 to 7.5, 3.5 to 5.6 and 6.5 to 8.0 or higher during passage of saliva (pH 6.4), gastric (pH 3.5) and intestinal juices (pH 6.4), respectively. When nutrients were added to gastric juice, the isolate L. brevis significantly decreased its pHi closer to the extracellular pH (pHex) than in gastric juice without nutrients. This was not the case for L. plantarum. This study is the first to produce an in vitro GIT model enabling real-time monitoring of pH homeostasis of single cells in response to the wide range of pHex of the GIT. Furthermore, it was possible to observe the heterogeneous response of single cells. The technique can be used to determine the survival and physiological conditions of potential probiotics and other microorganisms during passage through the GIT.","author_count":7,"contributors":["Ramos, Cíntia Lacerda","Thorsen, Line","Ryssel, Mia","Nielsen, Dennis Sandris","Siegumfeldt, Henrik","Schwan, Rosane Freitas","Jespersen, Lene"],"cuid":["S01-000.00-470060"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, South"],"country":["Brazil"],"glorg":["All Global Affiliations","Federal University of Lavras"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"effect of the gastrointestinal environment on ph homeostasis of em lactobacillus em em plantarum em and em lactobacillus brevis em cells as measured by real time fluorescence ratio imaging microscopy","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.resmic.2014.02.005","version":"Other Version"},"id":"S01-000.00-470060","identifier":[{"id":"84899109530","type":"scopus"},{"id":"24607712","type":"pmid"}],"ids":["ku-7ffcd80a-21d7-408a-a6e5-7ff0d6d006f5"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-47138005FC1C6EA234F84DBB28F98EA7"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.resmic.2014.02.005","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","country":"br","key":"federal university of lavras","loc":["Brazil","America, South"],"name":"Federal University of Lavras","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Food Science, Food Microbiology, Gut Health, and Fermentation"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Cíntia Lacerda","key":"ramospau","last":"Ramos","name":"Ramos, Cíntia Lacerda","rank":1,"rolecode":"pau"},{"affno":"2","first":"Line","key":"thorsenpau","last":"Thorsen","locid":"c882a60f-763a-4496-93be-335fe3451a41","name":"Thorsen, Line","rank":2,"rolecode":"pau"},{"affno":"2","first":"Mia","key":"rysselpau","last":"Ryssel","locid":"bb2e324a-c61a-43c3-812c-d6d35ba59f7f","name":"Ryssel, Mia","orcid":"0000-0003-0876-4470","rank":3,"rolecode":"pau"},{"affno":"2","first":"Dennis Sandris","key":"nielsenpau","last":"Nielsen","locid":"0