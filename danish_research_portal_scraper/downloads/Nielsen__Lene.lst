{"author_count":7,"contributors":["Alstrup, Lene","Lund, Peter","Sehested, Jakob","Hymøller, Lone","Nielsen, Mette Olaf","Weisbjerg, Martin"],"cuid":["S01-000.00-479218"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"pop","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"und","rtype":["clu"],"sorti":"miljøvenlige fodringsstrategier malkekøer","src":["ku"],"src-code":["DI-U-KU"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-479218","ids":["ku-8f822c66-40c5-44c2-9f19-d7dc9e0da778"],"lang":"Danish","level":"Popular","mra":["Medical Science"],"noi":["Local-1-1-EDFAB0D7A4A9015D7FA44296E14CF9BB"],"org":[{"affno":"1","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary Clinical Sciences, IKVH Fysiologi og ernæring samt pelsdyrfarmen","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary Clinical Sciences, Physiology and Nutrition","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary and Animal Sciences, Section for Production and Health"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Lene","key":"alstruppau","last":"Alstrup","name":"Alstrup, Lene","rank":1,"rolecode":"pau"},{"affno":"1","first":"Peter","key":"lundpau","last":"Lund","name":"Lund, Peter","rank":2,"rolecode":"pau"},{"affno":"1","first":"Jakob","key":"sehestedpau","last":"Sehested","name":"Sehested, Jakob","rank":3,"rolecode":"pau"},{"affno":"1","first":"Lone","key":"hymøllerpau","last":"Hymøller","name":"Hymøller, Lone","rank":4,"rolecode":"pau"},{"affno":"2","first":"Mette Olaf","key":"nielsenpau","last":"Nielsen","locid":"3ddfc1f7-7a66-4a68-bb50-5524f3dc6009","name":"Nielsen, Mette Olaf","rank":5,"rolecode":"pau"},{"affno":"1","first":"Martin","key":"weisbjergpau","last":"Weisbjerg","name":"Weisbjerg, Martin","rank":6,"rolecode":"pau"},{"affno":"","first":"Peter","key":"lundpedh","last":"Lund","name":"Lund, Peter","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["9788793176737"],"issn":["22451684"],"issue":"60","pages":"26-33","publisher":"Aarhus Universitet - DCA Nationalt Center for Fødevarer og Jordbrug","series":"DCA Rapport","status":"p","subtitle":"fodringsstrategier målrettet produktivitet og miljøhensyn","title":"Malkekoens ernæring"},"review":"Undetermined","search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-8f822c66-40c5-44c2-9f19-d7dc9e0da778"],"src":["KU University of Copenhagen"],"title":"Miljøvenlige fodringsstrategier - malkekøer","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-479218","year":"2015","yearsub":"2015"}
{"abstract":"Gum arabic is an important international commodity produced by trees of Acacia senegal across Sahelian Africa, but documented results of breeding activities are limited. The objective of this study was to provide reliable estimates of quantitative genetic parameters in order to shed light on the breeding potential for improvement of gum yield and quality. For this purpose, we measured growth on 617 offspring from 60 open-pollinated trees after 18 years, and gum yield and quality based on two seasons, 18 and 19 years after establishment. Genotyping with eight microsatellite markers revealed that progenies consisted of both diploid and polyploid trees, and growth, gum yield, and gum quality varied substantially among ploidy level, populations, and progenies. Analysis of molecular variance and estimates of outcrossing rate supported that trees within open-pollinated families of diploids were half sibs, while the open-pollinated families of polyploids showed low variation within families. The difference in sibling relationship observed between ploidy levels complicated estimation of genetic parameters. However, based on the diploid trees, we conclude that heritability in gum arabic production is low to high with presence of high levels of additive genetic variation, although the genetic parameters could only be estimated with fairly high standard error. The findings suggest that improvement through breeding can increase the productivity of A. senegal substantially. However, the results also stress the importance of testing ploidy levels of selected material and use of genetic markers to qualify the assumptions in the quantitative genetic analysis.","author_count":5,"contributors":["Diallo, Adja Madjiguene","Nielsen, Lene Rostgaard","Hansen, Jon Kehlet","Ræbild, Anders","Kjær, Erik Dahl"],"cuid":["S01-000.00-490820"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Breeding","GROWTH","Genetic parameters","Gum Arabic","Mating system","Microsatellite markers","Senegalia senegal"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"study of quantitative genetics of gum arabic production complicated by variability in ploidy level of i acacia senegal i l willd","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s11295-015-0902-x","version":"Published Version"},"id":"S01-000.00-490820","identifier":[{"id":"84937805200","type":"scopus"},{"id":"000359417100017","type":"wos"}],"ids":["ku-a2f2905e-4c8f-4408-bd74-c31ac8872a98"],"keyword":["Breeding","Genetic parameters","Growth","Gum arabic","Mating system","Microsatellite markers","Senegalia senegal"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-19101403198B2D1FB7A1FAD363CBF92A"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1007/s11295-015-0902-x","version":"Published Version"},{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/157505596/Study_of_quantitative_genetics_of_gum_arabic.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":1,"key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"KU University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["KU University of Copenhagen"],"nora_code":"DI-U-KU"}],"person":[{"affno":"","first":"Adja Madjiguene","key":"diallopau","last":"Diallo","name":"Diallo, Adja Madjiguene","rank":1,"rolecode":"pau"},{"affno":"","first":"Lene Rostgaard","key":"nielsenpau","last":"Nielsen","locid":"8e8b51ee-3f45-4ebe-b2fb-fa79f1256d08","name":"Nielsen, Lene Rostgaard","orcid":"0000-0002-7214-8691","rank":2,"rolecode":"pau"},{"affno":"","first":"Jon Kehlet","key":"hansenpau","last":"Hansen","locid":"b8c2f3eb-b79f-46cc-b346-8300943e2129","name":"Hansen, Jon Kehlet","orcid":"0000-0002-1260-3509","rank":3,"rolecode":"pau"},{"affno":"","first":"Anders","key":"raebildpau","last":"Raebild","locid":"599ea842-1926-48bd-b897-1bc32e9b4912","name":"Ræbild, Anders","name_org":"Raebild, Anders","orcid":"0000-0002-8793-5663","rank":4,"rolecode":"pau"},{"affno":"","first":"Erik Dahl","key":"kjaerpau","last":"Kjaer","locid":"e1bdaffb-0384-4159-aa20-a913a2cee948","name":"Kjær, Erik Dahl","name_org":"Kjaer, Erik Dahl","orcid":"0000-0001-8624-1611","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1007/s11295-015-0902-x","issn":["16142942","16142950"],"issn_org":["16142942"],"issue":"4","journal":"Tree Genetics & Genomes","paperid":"80","status":"p","title":"Tree Genetics & Genomes","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-84937805200"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","KU University of Copenhagen"],"PST":["Published"]},"sid":["ku-a2f2905e-4c8f-4408-bd74-c31ac8872a98"],"src":["KU University of Copenhagen"],"title":"Study of quantitative genetics of gum arabic production complicated by variability in ploidy level of <i>Acacia senegal</i> (L.) Willd","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-490820","year":"2015","yearsub":"2015"}
{"abstract":"PURPOSE: To identify all hospitalized patients surviving severe traumatic brain injury (TBI) in Denmark and to compare these patients to TBI patients admitted to highly specialized rehabilitation (HS-rehabilitation). PATIENTS AND METHODS: Patients surviving severe TBI were identified from The Danish National Patient Registry and The Danish Head Trauma Database. Overall incidence rates of surviving severe TBI and incidence rates of admission to HS-rehabilitation after severe TBI were estimated and compared. Patient-related predictors of no admission to HS-rehabilitation among patients surviving severe TBI were identified using multivariable logistic regression. RESULTS: The average incidence rate of surviving severe TBI was 2.3 per 100,000 person years. Incidence rates of HS-rehabilitation were generally stable around 2.0 per 100,000 person years. Overall, 84% of all patients surviving severe TBI were admitted to HS-rehabilitation. Female sex, older age, and non-working status pre-injury were independent predictors of no HS-rehabilitation among patients surviving severe TBI. CONCLUSION: The incidence rate of hospitalized patients surviving severe TBI was stable in Denmark and the majority of the patients were admitted to HS-rehabilitation. However, potential inequity in access to HS-rehabilitation may still be present despite a health care system based on equal access for all citizens.","author_count":5,"contributors":["Odgaard, Lene","Poulsen, Ingrid","Kammersgaard, Lars Peter","Johnsen, Søren Paaske","Nielsen, Jørgen Feldbæk"],"cuid":["S02-098.08-025619"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"surviving severe traumatic brain injury in denmark incidence and predictors of highly specialized rehabilitation","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.2147/CLEP.S78141","version":"Published Version"},"id":"S02-098.08-025619","identifier":[{"id":"84936992256","type":"scopus"},{"id":"25848317","type":"pmid"},{"id":"PMC4374648","type":"pmcid"}],"ids":["au-b18ca1b4-24d2-4c94-a6bb-70fd576d77fd","ku-c219df32-8906-40d3-873c-0333256a7435"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-45FA374037BB40D4880DA79DEB447436"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.2147/CLEP.S78141","version":"Published Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Regionshospital Hammel Neurocenter"],"nora_code":"DI-U-AU","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Lene","key":"odgaardpau","last":"Odgaard","locid":"1b80fe7b-ba0a-45b3-aca1-48bc19a97a44","name":"Odgaard, Lene","orcid":"0000-0002-9830-3282","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ingrid","key":"poulsenpau","last":"Poulsen","locid":"d81bb680-b226-4d1d-8ffc-5fdf938ba26c","name":"Poulsen, Ingrid","rank":2,"rolecode":"pau"},{"affno":"2","first":"Lars Peter","key":"kammersgaardpau","last":"Kammersgaard","locid":"0c01e338-74bb-4585-b053-c49669f449da","name":"Kammersgaard, Lars Peter","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Søren Paaske","key":"johnsenpau","last":"Johnsen","locid":"4664f7a0-39e7-4f46-9121-1c3999eb3d09","name":"Johnsen, Søren Paaske","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jørgen Feldbæk","key":"nielsenpau","last":"Nielsen","locid":"3fb25b9f-381b-44a6-a8dd-26eacf839d37","name":"Nielsen, Jørgen Feldbæk","orcid":"0000-0001-5339-171X","rank":5,"rolecode":"pau"}],"pmid":["25848317"],"pub":{"doi":"10.2147/clep.s78141","issn":["11791349"],"journal":"Clinical Epidemiology","pages":"225-34","publisher":"Dove Medical Press Ltd","status":"p","title":"Clinical Epidemiology","title_org":"Clinical epidemiology","volume":"7"},"review":"Peer Reviewed","scoID":["2-s2.0-84936992256"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-b18ca1b4-24d2-4c94-a6bb-70fd576d77fd","ku-c219df32-8906-40d3-873c-0333256a7435"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Surviving severe traumatic brain injury in Denmark : incidence and predictors of highly specialized rehabilitation","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-098.08-025619","year":"2015","yearsub":"2015"}
{"abstract":"The qac genes of Staphylococcus species encode multidrug efflux pumps: membrane proteins that export toxic molecules and thus increase tolerance to a variety of compounds such as disinfecting agents, including quaternary ammonium compounds (for which they are named), intercalating dyes and some antibiotics. In Stapylococcus species, six different plasmid-encoded Qac efflux pumps have been described, and they belong to two major protein families. QacA and QacB are members of the Major Facilitator Superfamily, while QacC, QacG, QacH, and QacJ all belong to the Small Multidrug Resistance (SMR) family. Not all SMR proteins are called Qac and the reverse is also true, which has caused confusion in the literature and in gene annotations. The discovery of qac genes and their presence in various staphylococcal populations is briefly reviewed. A sequence comparison revealed that some of the PCR primers described in the literature for qac detection may miss particular qac genes due to lack of DNA conservation. Despite their resemblance in substrate specificity, the Qac proteins belonging to the two protein families have little in common. QacA and QacB are highly conserved in Staphylococcus species, while qacA was also detected in Enterococcus faecalis, suggesting that these plasmid-born genes have spread across bacterial genera. Nevertheless, these qacA and qacB genes are quite dissimilar to their closest homologues in other organisms. In contrast, SMR-type Qac proteins display considerable sequence variation, despite their short length, even within the Staphylococcus genus. Phylogenetic analysis of these genes identified similarity to a large number of other SMR members, found in staphylococci as well as in other genera. A number of phylogenetic trees of SMR Qac proteins are presented here, starting with genes present in S. aureus and S. epidermidis, and extending this to related genes found in other species of this genus, and finally to genes found in other genera.","author_count":4,"contributors":["Wassenaar, Trudy M","Ussery, David","Nielsen, Lene Nørby","Ingmer, Hanne"],"cuid":["S02-100.00-034912"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","OECD"],"country":["Germany"],"glorg":["All Global Affiliations","Molecular Microbiology and Genomics Consultants"],"keyword":["Biocide resistance","Faculty of Health and Medical Sciences","MRSA","MfS","Phylogeny","QAC","S aureus","SMR"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"review and phylogenetic analysis of i qac i genes that reduce susceptibility to quaternary ammonium compounds in i staphylococcus i species","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"djr","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1556/eujmi-d-14-00038","version":"Published Version"},"id":"S02-100.00-034912","identifier":[{"id":"PMC4397847","type":"pmcid"},{"id":"25883793","type":"pmid"}],"ids":["dtu-65682bae-3051-4ea6-a62b-4d18e90e8ce3","ku-87695be1-5184-4047-99e0-17b5132cb0d6"],"keyword":["Biocide resistance","Faculty of Health and Medical Sciences","MFS","MRSA","Phylogeny","Qac","S. aureus","Smr","The Faculty of Health Science"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-3-FBAECE51EF836100B54CBC47FB07D166"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1556/eujmi-d-14-00038","version":"Published Version"},{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/120957050/Review_and_phylogenetic_analysis_of_qac_genes_that_reduce_susceptibility_to_quaternary_ammonium_compounds_in_Staphylococcus_species.pdf","version":"Published Version"},{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/147198916/Review_and_phylogenetic_analysis_of_qac_genes_that_reduce_susceptibility_to_quaternary_ammonium_compounds_in_Staphylococcus_species.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)","Science / Technology (SCI)"],"yearPub":"2015","yearSub":"2015"},"org":[{"affno":"1","country":"de","key":"molecular microbiology and genomics consultants","loc":["Germany","Europe, EU","OECD"],"name":"Molecular Microbiology and Genomics Consultants","used":1},{"affno":"2","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Systems Biology","Technical University of Denmark, Department of Systems Biology, Center for Biological Sequence Analysis"],"nora_code":"DI-U-DTU","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Veterinary and Animal Sciences, Food Safety and Zoonoses"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Trudy M","key":"wassenaarpau","last":"Wassenaar","name":"Wassenaar, Trudy M","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"David","key":"usserypau","last":"Ussery","locid":"de2c5cb4-22c8-4ef4-a1e6-752a08f73bbd","name":"Ussery, David","rank":2,"rolecode":"pau"},{"affno":"3","first":"Lene Nørby","key":"nielsenpau","last":"Nielsen","locid":"1a4f890a-d171-4c2f-ae00-dd1e024c25ab","name":"Nielsen, Lene Nørby","rank":3,"rolecode":"pau"},{"affno":"3","first":"Hanne","key":"ingmerpau","last":"Ingmer","locid":"abe2cd31-84e7-4f06-81a3-33e08bf93b8f","name":"Ingmer, Hanne","orcid":"0000-0002-8350-5631","rank":4,"rolecode":"pau"}],"pmid":["25883793"],"pub":{"doi":"10.1556/eujmi-d-14-00038","issn":["2062509X","20628633"],"issn_org":["2062509X"],"issue":"1","journal":"European Journal of Microbiology and Immunology","pages":"44-61","publisher":"Akademiai Kiado Rt.","status":"p","title":"European Journal of Microbiology and Immunology","title_org":"European Journal of Microbiology and Immunology (Print)","volume":"5"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-65682bae-3051-4ea6-a62b-4d18e90e8ce3","ku-87695be1-5184-4047-99e0-17b5132cb0d6"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"Review and phylogenetic analysis of <i>qac </i>genes that reduce susceptibility to quaternary ammonium compounds in <i>Staphylococcus </i>species","type":"Journal Review","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-034912","year":"2015","yearsub":2016}
{"abstract":"Anaerobic digesters (ADs) are one of several ways to produce renewable energy, which in the case of ADs is in the form of methane. Several microbial groups are involved in anaerobic degradation of organic wastes such as animal manures and wastewater, and solid organic wastes such as sludge, crop, and food wastes (Alvarado et al., 2014). The processes and the roles of the microorganisms that are involved in biomass conversion and methane production in ADs are still not fully understood. We are investigating thermophilic and mesophilic ADs that use wastewater surplus sludge for methane production. To gain insight into both the degradation of the carbohydrates and the various roles of the microbes in the ADs we have mined metagenomes from both types of ADs for glycoside hydrolases, carbohydrate esterases, polysaccharide lyases, auxiliary activities, and carbohydrate binding modules. The mining was done with the Peptide Pattern Recognition (PPR) program (Busk and Lange, 2013), which is a novel non-alignment based approach that can predict function of e.g. CAZymes. PPR identifies a set of short conserved sequences, which can be used as a finger print when mining genomes for novel enzymes. In both thermophilic and mesophilic ADs a wide variety of carbohydrate active enzyme functions were discovered in the metagenomic sequencing of the microbial consortia. The most dominating type of glycoside hydrolases were β-glucosidases (up to 27%), α-amylases (up to 10%), α-glucosidases (up to 8%), α-galactosidases (up to 9%) and β-galactosidases (up to 7%). For carbohydrate esterases the by far most dominating type was acetylxylan esterases (up to 59%) followed by feruloyl esterases (up to 16%). Less than 15 polysaccharide lyases were identified in the different metagenomes and not surprisingly no polysaccharide monooxygenases were identifed. For the carbohydrate binding modules one of the most dominating families were CBM48 (up to 16%).","author_count":7,"contributors":["Wilkens, Casper","Busk, Peter Kamp","Pilgaard, Bo","Kirkegaard, Rasmus Hansen","Albertsen, Mads","Nielsen, Per Halkjær","Lange, Lene"],"cuid":["S01-000.00-069967"],"event":{"end":"2015-05-13","place":"Espoo, fi","start":"2015-05-10","title":"Carbohydrate Bioengineering Meeting 11","year":"2015"},"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-U-AAU"]},"review":"nr","rtype":["clu"],"sorti":"mining anaerobic digester consortia metagenomes for secreted carbohydrate active enzymes","src":["aau"],"src-code":["DI-U-AAU"],"type":"dco","type-grp":["all","pub"]},"id":"S01-000.00-069967","ids":["aau-44d062e9-f1c2-42b6-bcb9-69a4463dab13"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-BD188AC54DC4981F12F37BC05A2C58A0"],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science (ENG)","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience","Aalborg University, The Faculty of Engineering and Science, Department of Chemistry and Bioscience, Section for Sustainable Biotechnology, Copenhagen"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Casper","key":"wilkenspau","last":"Wilkens","locid":"a23b64bd-efe8-41b1-b6c3-76905527e82a","name":"Wilkens, Casper","orcid":"0000-0002-1857-063X","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Peter Kamp","key":"buskpau","last":"Busk","name":"Busk, Peter Kamp","rank":2,"rolecode":"pau"},{"affno":"1","correspondi