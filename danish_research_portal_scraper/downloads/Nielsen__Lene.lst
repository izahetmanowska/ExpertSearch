,"corresponding":null,"first":"Marianne","key":"høghmariannepau","last":"Høgh","name":"Høgh, Marianne","rank":15,"rolecode":"pau"},{"affno":"8","corresponding":null,"first":"Marianne Thora","key":"høghmariannethorapau","last":"Høgh","name":"Høgh, Marianne Thora","rank":15,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Mette Nygaard","key":"rahrmettenygaardpau","last":"Rahr","name":"Rahr, Mette Nygaard","rank":16,"rolecode":"pau"},{"affno":"12","corresponding":null,"first":"Helle","key":"svenningsenhellepau","last":"Svenningsen","locid":"d53b06c4-e4d3-4897-b571-20d46128f272","name":"Svenningsen, Helle","orcid":"0000-0002-2180-2163","rank":17,"rolecode":"pau"}],"pmid":["36774292"],"pub":{"doi":"10.1016/j.aucc.2022.12.008","issn":["10367314"],"issue":"6","journal":"Australian Critical Care","pages":"1035-1042","publisher":"Elsevier Ireland Ltd","status":"p","title":"Australian Critical Care","title_org":"Australian critical care : official journal of the Confederation of Australian Critical Care Nurses","volume":"36"},"review":"Peer Reviewed","scoID":["2-s2.0-85148739835"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","All University Colleges","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","Hospitals","Miscellaneous","Other Hospitals","Other Research","Region Zealand","Region of Southern Denmark","Universities","University College Absalon","University Colleges","University of Copenhagen","University of Southern Denmark","VIA University College","copenhagen university hospital - holbæk"],"PST":["Published"]},"sid":["au-c400d6d8-e483-4794-ad37-072bdbf49a6d","ku-29e45b69-8358-444d-b6cc-e13f51d7cff5","pha-a91545d0-91eb-438f-9efc-c904bb1c908d","sdu-27c7b755-b007-4704-9cf7-efa9e0930a61","via-48cd4fd6-a77b-4359-993f-9d182962ce1a"],"src":["AB University College Absalon","AU Aarhus University","KU University of Copenhagen","SDU University of Southern Denmark","VIA University College"],"title":"Intensive care unit nurses' perception of three different methods for delirium screening : A survey (DELIS-3)","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S05-095.62-742038","year":"2023","yearsub":"2023"}
{"abstract":"(1) Background: Recognizing mental health problems in newly arrived refugees poses a challenge. Little is known of the mental health profile of refugees currently arriving in Northern Europe. (2) Method: In total, we included 900 adult (≥18 years old) refugees arriving in Aarhus, Den-mark, between 1 January 2014 and 1 January 2020. All participants accepted an offer of a voluntary systematic health assessment from the municipality in Aarhus, including a mental health screening. (3) Results: Within this cohort, 26% (237/900) of the participants were referred to the Department of Psychiatry, Aarhus University Hospital, 24% (212/900) were in contact with the department and 21% (185/900) received ≥1 psychiatric diagnosis. Within the subpopulation referred (n = 237), 64% (152/237) were diagnosed with post-traumatic stress disorder (PTSD) (DF431), 14% (34/237) with neurotic, stress-related and somatoform disorders (F40–F48) and 13% (30/237) with major mood disorders (F30–F39). Among the participants referred to the Department of Psychiatry and participants receiving a diagnosis, we found an overrepresentation of participants originating from the Southern Asian region (Pakistan, Afghanistan and Iran) and with an age above 44 years. (4) Conclusion: We found a high prevalence of both referrals and psychiatric diagnoses in newly arrived refugees. Atten-tion to psychiatric conditions in refugees and systematic health assessments during resettlement are needed.","author_count":5,"contributors":["Hvass, Anne Mette Fløe","Nyboe, Lene","Lanng, Kamilla","Nielsen, Claus Vinther","Wejse, Christian"],"cuid":["S01-000.00-137141"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Hvass, Anne Mette Fløe"],"keyword":["Migrant health","PTSD","Refugee health"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"a mental health profile of 000000000900 newly arrived refugees in denmark using icd 000000000010 diagnoses","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/su14010418","version":"Published Version"},"id":"S01-000.00-137141","identifier":[{"id":"85122096838","type":"scopus"}],"ids":["au-0da1589a-470f-41c8-8178-d7d6cc955f65"],"keyword":["Displacement and migration","Migrant health","Migrant quality of life","PTSD","Refugee health"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-245B6472F418013C8272091D5E6BD7E7"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3390/su14010418","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2022","yearSub":"2022"},"org":[{"affno":"1","country":"dk","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University (AU)","Aarhus University, Health, Department of Public Health, Department of Public Health - Klinisk Socialmedicin og Rehabilitering"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Anne Mette Fløe","key":"hvasspau","last":"Hvass","locid":"1ef2848d-85ee-4249-95e5-2630a1c5ef55","name":"Hvass, Anne Mette Fløe","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lene","key":"nyboepau","last":"Nyboe","locid":"488ab720-8904-4547-9296-f359ee22c36d","name":"Nyboe, Lene","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Kamilla","key":"lanngpau","last":"Lanng","locid":"9a3364f0-0262-4f41-8680-910a4cc9d39a","name":"Lanng, Kamilla","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Claus Vinther","key":"nielsenpau","last":"Nielsen","locid":"033d1aa9-948f-4ed4-be3e-200d0100b399","name":"Nielsen, Claus Vinther","orcid":"0000-0002-2467-1103","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Christian","key":"wejsepau","last":"Wejse","locid":"382d58c8-3a9b-48f2-a419-ad70bdeaa4e3","name":"Wejse, Christian","orcid":"0000-0002-2534-2942","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.3390/su14010418","issn":["20711050"],"issue":"1","journal":"Sustainability","paperid":"418","publisher":"Multidisciplinary Digital Publishing Institute (MDPI)","status":"p","title":"Sustainability","volume":"14"},"review":"Peer Reviewed","scoID":["2-s2.0-85122096838"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-0da1589a-470f-41c8-8178-d7d6cc955f65"],"src":["AU Aarhus University"],"title":"A Mental Health Profile of 900 Newly Arrived Refugees in Denmark Using ICD-10 Diagnoses","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-137141","year":"2022","yearsub":"2022"}
