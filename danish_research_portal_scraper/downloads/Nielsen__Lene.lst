rson":[{"affno":"1 2","corresponding":null,"country":"dk","first":"Sidsel Vive","key":"jensenpau","last":"Jensen","locid":"9f5383ef-3e04-4820-888a-75c0991b098c","name":"Jensen, Sidsel Vive","orcid":"0000-0002-6329-9981","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Lene","key":"kühlepau","last":"Kühle","locid":"a68c3965-d3a3-4e62-84dd-afd8096ce647","name":"Kühle, Lene","orcid":"0000-0001-5097-0521","rank":2,"rolecode":"pau"},{"affno":"","first":"Nathal M.","key":"dessingpedh","last":"Dessing","name":"Dessing, Nathal M.","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Nadia","key":"jeldtoftpedh","last":"Jeldtoft","name":"Jeldtoft, Nadia","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Jørgen S.","key":"nielsenpedh","last":"Nielsen","name":"Nielsen, Jørgen S.","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Linda","key":"woodheadpedh","last":"Woodhead","name":"Woodhead, Linda","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"pages":"101-113","place":"Dorchester","publisher":"Ashgate","status":"p","title":"Everyday Lived Islam in Europe"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Universities"],"PST":["Published"]},"sid":["au-e26f9590-bbd1-4c59-a847-e96111d5624c","vive-d982e7e8-030e-44c6-a624-543ffb5558c7"],"src":["AU Aarhus University","VIVE The Danish Center for Social Science Research"],"title":"'School Islam' : Lived Religion in the Context of a Secular Public Institution","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-029087","year":"2013","yearsub":"2013"}
{"abstract":"In many higher education curricula, pre-structured step-by-step laboratory exercises in introductory courses in geographical information systems (GIS) are an important part of the training of future geographers. The reasons for this approach to teaching GIS are manifold, such as large numbers of students, off-the-shelf desktop software that is often complex, technical challenges, and scarce faculty resources. Often the reasons are well agreed upon by members of a university faculty and among the students. Research in other fields has shown that the use of a controlled manual for laboratory work often provides low learning potentials. However, not much empirical research has dealt with this issue within a GIS learning environment. Inspired by research on the value of student-generated questions within science education, the authors take a closer look at the type of student-generated questions and their relation to students' self-image of their learning approach in two pre-structured GIS laboratory settings at two Danish universities. They conclude that the vast majority of student-generated questions are of a basic information type and independent of the students' self-image of their learning approach. Further, it is found that wonderment questions, i.e. questions that are reflective in nature and show students the process towards acquiring extended geographical knowledge and software proficiency, are rarely asked.","author_count":2,"contributors":["Madsen, Lene Møller","Nielsen, Thomas Theis"],"cuid":["S02-100.00-042196"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU","DI-U-RUC"]},"level3all":["DI-U-KU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"learning to do geography university students posing questions in gis laboratory exercises","src":["ku","ruc"],"src-code":["DI-U-KU","DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1080/00291951.2013.803259","version":"Other Version"},"id":"S02-100.00-042196","identifier":[{"id":"84879933669","type":"scopus"}],"ids":["ku-4bbe0c50-d9db-482c-8ddd-005d3ed719e2","ruc-2fe397c5-ae8c-4cca-b417-39c2db050134"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-5-93236AE867A76EA1217C6D42386B5D2C"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1080/00291951.2013.803259","version":"Other Version"}],"oai":{"class":"Unused","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Science Education","Københavns Universitet, Faculty of Science, Department of Science Education, Equity in Science Education","Københavns Universitet, Faculty of Science, Department of Science Education, University Science Education"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of People and Technology, Space, Place, Mobility and Urban Studies","Roskilde University, Department of Science and Environment, Environmental Dynamics","Roskilde University, The Department of Environmental, Social and Spatial Change"],"nora_code":"DI-U-RUC","used":1}],"person":[{"affno":"1","country":"dk","first":"Lene Møller","key":"madsenpau","last":"Madsen","locid":"dda148da-5b6d-4f4e-ab