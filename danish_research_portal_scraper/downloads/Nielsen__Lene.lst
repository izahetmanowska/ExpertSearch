olsencarstenlindbergpau","last":"Fagö-Olsen","name":"Fagö-Olsen, Carsten Lindberg","rank":15,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Ib Jarle","key":"christensenibjarlepau","last":"Christensen","name":"Christensen, Ib Jarle","rank":16,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Lotte","key":"nedergaardlottepau","last":"Nedergaard","name":"Nedergaard, Lotte","rank":17,"rolecode":"pau"},{"affno":"4 5","corresponding":null,"first":"Kirsten","key":"jochumsenkirstenpau","last":"Jochumsen","locid":"369f5c2d-f06c-44da-89f3-f035e5eb7154","name":"Jochumsen, Kirsten","orcid":"0000-0002-2758-9332","rank":18,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Claus","key":"høgdallclauspau","last":"Høgdall","name":"Høgdall, Claus","rank":19,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Claus Kim","key":"høgdallclauskimpau","last":"Høgdall","name":"Høgdall, Claus Kim","rank":19,"rolecode":"pau"}],"pmid":["23200916"],"pub":{"doi":"10.1016/j.ygyno.2012.11.025","issn":["00908258","10956859"],"issn_org":["00908258"],"issue":"2","journal":"Gynecologic Oncology","pages":"300-308","publisher":"Academic Press","status":"p","title":"Gynecologic Oncology","volume":"128"},"review":"Peer Reviewed","scoID":["2-s2.0-84872864383"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-5f1dc8a6-ab88-4733-babd-ee66d1df23da","ku-0ff9d5d4-d598-4f93-b560-7c048be65806","sdu-61a3b74e-c279-431f-b303-04ed54fec991"],"src":["AAU Aalborg University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"MRI, PET/CT and ultrasound in the preoperative staging of endometrial cancer - A multicenter prospective comparative study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-089.76-792874","year":"2013","yearsub":"2013"}
{"abstract":"Background: The Danish National Acute Leukemia Registry (DNLR) has documented coverage of above 98.5%. Less is known about the quality of the recorded data. Objective: To describe the present coverage of the DNLR, its completeness, and accuracy of individual variables for acute myeloid leukemia (AML). Furthermore, as a second measure of true coverage of the DNLR, to estimate AML incidence in Denmark from DNLR data and compare it to incidence reported from other AML registries. Patients and methods: By the end of December 2011, the DNLR (established January 2000) included detailed data on a large, well-defined, and nonselected Danish population of 2,665 AML patients. We estimated positive predictive values (PPVs) and completeness for 30 variables, which included patient and disease characteristics, treatment, and treatment outcomes. We identified 260 AML patients (10% of all AML patients recorded in the DNLR). We used information from medical records as the gold standard. Results: Using the Danish National Registry of Patients as a reference, the coverage of the DNLR was 99.6%. The PPVs of the individual variables ranged from 89.4% to 100%. The completeness of individual variables varied between 60.7% and 100%. Stratification by time of registration in the DNLR (before 2006 versus 2006 and later) revealed higher PPVs and lower frequencies of missing data from 2006. Sex-adjusted incidence rates were 6.2/100,000 person-years (95% confidence interval 5.8-6.6) in males and 4.9/100,000 person-years (95% confidence interval 4.5-5.4) in females. Yearly incidence rates of AML were higher than the incidence rates reported from Sweden (4.5 and 4.2/100,000) and the US (4.5 and 3.1/100,000 in Caucasians). Conclusion: With few exceptions, there were high values for PPVs and completeness of recorded data. Data accuracy and completeness have improved since the registry was established. The estimated incidence may indicate that the DNLR truly is more complete than other registries. In conclusion, the DNLR is a valuable resource for clinical research of AML.","author_count":15,"contributors":["Ostgård, Lene Sofie Granfeldt","Nørgaard, Jan Maxwell","Severinsen, Marianne Tang","Sengeløv, Henrik","Friis, Lone","Jensen, Morten Krogh","Nielsen, Ove Juul","Nørgaard, Mette"],"cuid":["S03-092.59-012070"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"keyword":["Acute myeloid leukemia","Incidence","Validation Studies"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU","DI-U-UND"]},"level3all":["DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU","DI-U-UND"]},"review":"pr","rtype":["clu"],"sorti":"data quality in the danish national acute leukemia registry a hematological data resource","src":["aau","au","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.2147/CLEP.S48411","version":"Published Version"},"id":"S03-092.59-012070","identifier":[{"id":"24039451","type":"pmid"},{"id":"84884132931","type":"scopus"},{"id":"PMC3770716","type":"pmcid"}],"ids":["aau-fddb620b-9cee-4771-9046-aab4b1000b39","au-d016e207-762c-4996-a5ac-e283140bbe8d","sdu-5cd8a828-69f1-44a1-8135-7bd265239cb7"],"keyword":["Acute myeloid leukemia","Incidence","Registration completeness","Validation studies"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-FC0A2479A02B195DA0FCC462B80D2AA6"],"oa_link":[{"access":"oa","license":"CC BY-NC","type":"doi","url":"https://doi.org/10.2147/CLEP.S48411","version":"Published Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","