issn_org":["15607917"],"issue":"36","journal":"Eurosurveillance","paperid":"pii=2300460","publisher":"European Centre for Disease Prevention and Control","status":"p","title":"Eurosurveillance","volume":"28"},"review":"Peer Reviewed","scoID":["2-s2.0-85169999010"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-7e785b10-8823-4682-ad6e-51f565a5aab6"],"src":["SDU University of Southern Denmark"],"title":"First cases of SARS-CoV-2 BA.2.86 in Denmark, 2023","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-691160","year":"2023","yearsub":"2023"}
{"abstract":"Although personas have been applied for two decades, not much is known about why a designer chooses a specific persona for a given design task. This question matters because if designers prefer one persona over another, then the needs and attributes of that persona would be favored in the design process, resulting in possible “blind spots” and bias in regards to other personas. To explore reasons and behaviors associated with the choice of a persona, we conduct an on-site user study with 37 participants in a workplace setting focused on a social media content creation task. Our findings show that factors affecting the choice of persona include age similarity between the persona and the designer, persona’s looks, how many users the persona represents, time spent browsing the persona information, and whether the persona is (a)typical relative to other personas. Under different persona sets, these factors were correlated with the probability of a persona being chosen for a design task, and also supported by a qualitative analysis of the think-aloud records where the participants explained their persona choice. The findings provide implications for developing interaction techniques that support users’ varying information needs and persona selection strategies, including recommenders that would increase the match between the designers’ information needs and the available personas.","author_count":7,"contributors":["Salminen, Joni","Şengün, Sercan","Santos, João M.","Jung, Soon-Gyo","Nielsen, Lene","Jansen, Bernard J."],"cuid":["S01-000.00-730157"],"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","Asia, Middle East","Europe, EU","Nordic","OECD"],"country":["Finland","Portugal","Qatar","United States"],"glorg":["All Global Affiliations","Instituto Universitário de Lisboa (ISCTE-IUL)","Qatar Computing Research institute","University of Vaasa","lllinois State University"],"keyword":["Human factors","Personas","User study","user choice"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"the choice of a persona an analysis of why stakeholders choose a given persona for a design task","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/103296494/hcii2023-salminenetal.pdf","version":"Authors Final Version"},"id":"S01-000.00-730157","identifier":[{"id":"85178575700","type":"scopus"}],"ids":["itu-02353bb3-afd7-4a2e-8538-6bfef04cc67b"],"keyword":["Human Factors","personas","user choice","user study"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-CCB69CD789C00D688A3173BF9AABB7B5"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/103296494/hcii2023-salminenetal.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","country":"fi","key":"university of vaasa","loc":["Finland","Europe, EU","Nordic","OECD"],"name":"University of Vaasa","used":1},{"affno":"2","country":"us","key":"lllinois state university","loc":["United States","America, North","OECD"],"name":"lllinois State University","used":1},{"affno":"3","country":"pt","key":"instituto universitário de lisboa","loc":["Portugal","Europe, EU","OECD"],"name":"Instituto Universitário de Lisboa (ISCTE-IUL)","used":1},{"affno":"4","country":"qa","key":"qatar computing research institute","loc":["Qatar","Asia, Middle East"],"name":"Qatar Computing Research institute","used":1},{"affno":"5","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Digitalization, Democracy, and Governance, REFLACT"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Joni","key":"salminenpau","last":"Salminen","name":"Salminen, Joni","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Sercan","key":"şengünpau","last":"Şengün","name":"Şengün, Sercan","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"João M.","key":"santospau","last":"Santos","name":"Santos, João M.","rank":3,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Soon-Gyo","key":"jungpau","last":"Jung","name":"Jung, Soon-Gyo","rank":4,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Lene","key":"nielsenpau","last":"Nielsen","locid":"1052b289-f510-4c5a-9662-2db48c12ebc2","name":"Nielsen, Lene","orcid":"0000-0003-1768-7147","rank":5,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Bernard J.","key":"jansenpau","last":"Jansen","name":"Jansen, Bernard J.","rank":6,"rolecode":"pau"},{"affno":"","first":"M.","key":"kurosapedh","last":"Kurosa","name":"Kurosa, M.","rank":7,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.1007/978-3-031-48038-6_18","eisbn":["9783031480386"],"isbn":["9783031480379"],"pages":"288-310","publisher":"Springer","status":"p","title":"Lecture Notes in Computer Science","volume":"14054"},"review":"Peer Reviewed","scoID":["2-s2.0-85178575700"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-02353bb3-afd7-4a2e-8538-6bfef04cc67b"],"src":["ITU IT University of Copenhagen"],"title":"The Choice of a Persona : An Analysis of Why Stakeholders Choose a Given Persona for a Design Task","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-730157","year":"2023","yearsub":"2023"}
{"abstract":"”Mit ærinde er egentlig, at vi bliver nødt til at være modige til at se, at kroppen og toppen hænger sammen” Hvorfor må vi ikke glemme kroppen, når vi går på arbejde? Hvad er verdens mindste træningscenter? Hvordan kan vi helt enkelt bruge fire små redskaber og lave øvelser dagligt, som træner vores trivsel? I dette afsnit har vi stærkt besøg af Anne-Lene Nielsen, som helhedsorienteret gør os klogere på at ensrette vores signaler, hvor kroppen taler til toppen og toppen taler til kroppen. Såsom ’smil og ret dig op’, der fra kroppen sender signal til toppen om, at vi nu skal præstere og være skarpe. Omvendt kan vi, når vi vil restituere og slappe af, sende signaler fra kroppen til hjerne ved at lukke øjnene ned, lukke af for sanseindtryk, gå ind i et roligt rum eller i naturen. Hun pointerer tillige tre hygiejnefaktorer: Søvn, vand og vejrtrækning, som er små motorer, der driver os frem og hjælper vores krop og hjerne til at fungere bedst muligt, og som vi skal huske at lade op. Med sig har Anne-Lene også fire hverdagsredskaber, som til sammen danner, det hun kalder, verdens mindste træningscenter og hjælper med at ensrette signalerne og agerer som små pauser, der kan hjælpe med at friske os op i løbet af arbejdsdagen: En elastik (til udstrækning af fingre og forstærke aktivering af muskulatur i nakke, skulder, mund og tunge), et sugerør (til opmærksomhed omkring vejrtrækning og påmindelse om at stoppe op og trække vejret. Bemærk sugerøret skal i munden og ikke i næsen … ;), en lille bold (hjælper os med at flytte fokus ud til kroppen og derved frigiver refleksionsplads i hovedet), og en ispind (bevidsthed om hvordan vi påvirker vores omgivelser og os selv via spejlneuroner. Vi spejler hinandens smil). Træn med, når vi her har fokus på samspillet mellem kroppen og toppen. Gæst: Anne-Lene Nielsen står bag virksomheden Intelligent Posture. Hun har en baggrund som specialist i bevægeapparatet med autorisation som kiropraktor og en mastergrad i positiv psykologi. Værtinde: Sanne Østergaard Nissen Produktion, redaktion og musik: Julie Kowal Kristiansen","author_count":3,"contributors":["Nissen, Sanne Østergaard","Nielsen, Anne-Lene","Kristiansen, Julie Kowal"],"cuid":["S01-000.00-751197"],"filters":{"added":"2024-08","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Ledelse organisationsudvikling og innovation","Sundhed ernæring og livskvalitet"],"level":"pop","mra":["hum"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-UC"],"level3":{"OT":["Teknologi og Business"],"UC":["DI-UC-ALL","DI-UC-UCL"]},"level3all":["DI-UC-UCL"]},"review":"und","rtype":["clu"],"sorti":"træn trivslen 000000000017 kroppen og toppen i verdens mindste træningscenter anne lene nielsen","src":["ucl"],"src-code":["DI-UC-UCL"],"type":"dnt","type-grp":["all","pub"]},"ft":{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://traentrivslen.buzzsprout.com/2191576/13826893-17-kroppen-og-toppen-i-verdens-mindste-traeningscenter-anne-lene-nielsen","version":"Published Version"},"id":"S01-000.00-751197","ids":["ucl-692bed91-de29-481e-926c-508d810e2195"],"keyword":["Ledelse, organisationsudvikling og innovation","Sundhed, ernæring og livskvalitet"],"lang":"Danish","level":"Popular","mra":["Humanities"],"noi":["Local-1-1-5D77CD0863B0CB9C26CE7B016902FF67"],"oa_link":[{"access":"oa","license":"Ikke-specificeret","type":"rem","url":"https://traentrivslen.buzzsprout.com/2191576/13826893-17-kroppen-og-toppen-i-verdens-mindste-traeningscenter-anne-lene-nielsen","version":"Published Version"}],"org":[{"affno":"1","key":"ucl university college","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-UCL","l3nl":"UCL University College","l3nn":"UCL University College","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"UCL University College","namevar":["UCL Erhvervsakademi og Professionshøjskole, Direktion, Kompetence- og Organisationsudvikling, Ledelse og Organisation"],"nora_code":"DI-UC-UCL","used":1},{"affno":"2","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Teknologi og Business"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Sanne Østergaard","key":"nissenpau","last":"Nissen","locid":"769c6c3c-9449-4e49-b16e-8cfa5cc8d4be","name":"Nissen, Sanne Østergaard","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Anne-Lene","key":"nielsenoth","last":"Nielsen","name":"Nielsen, Anne-Lene","rank":2,"role":"Other","rolecode":"oth"},{"affno":"2","corresponding":null,"first":"Julie Kowal","key":"kristiansenppu","last":"Kristiansen","locid":"45a8d3ba-e704-4ec4-a2ae-9cf2a307f5f4","name":"Kristiansen, Julie Kowal","rank":3,"role":"Publisher","rolecode":"ppu"}],"pub":{"publisher":"UCL Erhvervsakademi og Professionshøjskole","status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Miscellaneous","All University Colleges","DI-ALL","DI-OT","DI-OT-ALL","DI-UC","DI-UC-ALL","Miscellaneous","Other Research","UCL University College","University Colleges"],"PST":["Published"]},"sid":["ucl-692bed91-de29-481e-926c-508d810e2195"],"src":["UCL University College"],"title":"Træn Trivslen : #17 Kroppen og toppen i verdens mindste træningscenter – Anne-Lene Nielsen","type":"Non-Textual Item","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-751197","year":"2023","yearsub":"2023"}
{"abstract":"PURPOSE: To explore whether patients with multiple myeloma changed their construct of health-related quality of life during treatment. PARTICIPANTS & SETTING: 14 participants were selected from 10 hematology-oncology departments in Denmark. METHODOLOGIC APPROACH: This interview study used a prospective, longitudinal, exploratory design. Semistructured interviews were conducted while participants were undergoing active treatment for multiple myeloma and six months after the baseline interview. Interviews were analyzed using systematic text condensation. FINDINGS: The overall theme at baseline was insecurity, and the overall theme at six months was coping. The following subthemes were also identified based on participants’ description of their health-related quality of life: concerns about having a meaningful life, dealing with everyday limitations, and maintaining social networks; adjusting expectations to abilities; expanding social networks; and exploring a meaningful life. IMPLICATIONS FOR NURSING: Patients’ ability to use coping strategies should be considered when screening for rehabilitation needs. During systematic in-depth symptom screening, unmet rehabilitation needs (e.g., physical functioning, fatigue, pain) may become apparent.","author_count":6,"contributors":["Sonsby, Lise","Dueholm, Josephine Rahbæk","Danbjørg, Dorthe Boe","Abildgaard, Niels","Kongsgaard Nielsen, Lene"],"cuid":["S02-092.71-685855"],"filters":{"added":"2023-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Sonsby, Lise"],"keyword":["Adaptation Psychological","Health related quality of life","Humans","Multiple Myeloma therapy","Multiple myeloma","Patient reported outcomes","Prospective Studies","Qualitative Research","Quality of Life","Response shift"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR","DI-HO-SDR"],"U":["DI-U-ALL","DI-U-AU","DI-U-SDU"]},"level3all":["DI-HO-CDR","DI-HO-SDR","DI-U-AU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"changes in health related quality of life during multiple myeloma treatment a qualitative interview study","src":["au","sdu"],"src-code":["DI-U-AU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85168499498","version":"Other Version"},"id":"S02-092.71-685855","identifier":[{"id":"37677765","type":"pmid"},{"id":"85168499498","type":"scopus"}],"ids":["au-1ce07f5b-5c71-467c-aa32-96851363171c","sdu-f70da4b3-f675-40dd-a145-426d5363e9fe"],"keyword":["Adaptation, Psychological","Humans","Multiple Myeloma/therapy","Prospective Studies","Qualitative Research","Quality of Life","health-related quality of life","multiple myeloma","patient-reported outcomes","response shift"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-6F1FAD952F2A08B0A3727A38ACE92CEE"],"org":[{"affno":"1","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Haematology (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Medicinsk afdeling, RHG"],"nora_code":"DI-U-AU","used":1},{"affno":"4","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Gødstrup Hospital"],"nora_code":"DI-HO-CDR","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lise","key":"sonsbypau","last":"Sonsby","name":"Sonsby, Lise","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Josephine Rahbaek","key":"dueholmpau","last":"Dueholm","name":"Dueholm, Josephine Rahbaek","rank":2,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Dorthe Boe","key":"danbjørgpau","last":"Danbjørg","locid":"c22e16e2-3d6d-4f17-b07a-485d0dddf61a","name":"Danbjørg, Dorthe Boe","orcid":"0000-0003-3323-5829","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Niels","key":"abildgaardpau","last":"Abildgaard","locid":"595418b9-29f8-4fd3-8663-1b32eab3451a","name":"Abildgaard, Niels","orcid":"0000-0001-6852-2014","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"country":"dk","first":"Lene Kongsgaard","key":"nielsenpau","last":"Nielsen","locid":"897c29d3-45a2-4178-81b1-b0ba61db5a25","name":"Kongsgaard Nielsen, Lene","name_org":"Nielsen, Lene Kongsgaard","orcid":"0000-0003-2083-3870","rank":5,"rolecode":"pau"},{"affno":"2 4","corresponding":null,"first":"Lene","key":"kongsgaardnielsenpau","last":"Kongsgaard Nielsen","locid":"621d166f-6298-48ed-9f2d-d8d52bb40446","name":"Kongsgaard Nielsen, Lene","orcid":"0000-0003-2083-3870","rank":5,"rolecode":"pau"}],"pmid":["37677765"],"pub":{"doi":"10.1188/23.onf.635-645","issn":["0190535X","15380688"],"issn_org":["0190535X"],"issue":"5","journal":"Oncology Nursing Forum","pages":"635-645","publisher":"Oncology Nursing Society","status":"p","title":"Oncology Nursing Forum","volume":"50"},"review":"Peer Reviewed","scoID":["2-s2.0-85168499498"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-1ce07f5b-5c71-467c-aa32-96851363171c","sdu-f70da4b3-f675-40dd-a145-426d5363e9fe"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Changes in Health-Related Quality of Life During Multiple Myeloma Treatment : A Qualitative Interview Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-092.71-685855","year":"2023","yearsub":"2023"}
{"abstract":"OBJECTIVE: Peer support has been shown to support personal recovery from mental illness. It is unclear whether the effects of peer support across different mental illnesses depend on the organizational setting. The authors reviewed the effectiveness of peer support for both personal recovery and clinical recovery of adults with any mental illness and evaluated the effectiveness of peer support in different settings. METHODS: A systematic review of randomized controlled trials (RCTs) was conducted in PubMed, PsycInfo, CINAHL, Cochrane Library, and Web of Science. A meta-analysis of outcomes of personal and clinical recoveries at the end of interventions was conducted. RESULTS: In total, 49 RCTs with 12,477 participants with any mental illness were included. Most of the trials had a high risk for bias. Results of the meta-analysis indicated that peer support in general had a small positive effect on personal recovery (standard mean difference [SMD]=0.20; 95% CI=0.11-0.29) and decreased anxiety symptoms (SMD=-0.21; 95% CI=-0.40 to -0.02), with most trials evaluating peers added to mental health-related hospital services. No data for peers in established service roles were available for the meta-analysis. Peer-designed interventions developed to be provided independently of hospital services and delivered in community settings had a modest effect on self-advocacy. A small nonsignificant effect on personal recovery for peer support delivered online was also observed. CONCLUSIONS: The effect on personal recovery from mental illness was most evident in peer support added to hospital services. High-quality RCTs with comparable cocreated interventions and clear descriptions of mechanisms of change are needed to further investigate peer support efficacy.","author_count":9,"contributors":["Høgh Egmose, Cecilie","Heinsvig Poulsen, Chalotte","Hjorthøj, Carsten","Skriver Mundy, Sara","Hellström, Lone","Nørgaard Nielsen, Mette","Korsbek, Lisa","Serup Rasmussen, Klavs","Falgaard Eplov, Lene"],"cuid":["S02-095.24-698289"],"filters":{"added":"2023-09","altsrc":["No Matches Found"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Heinsvig Poulsen, Chalotte"],"keyword":["Adult","Anxiety","Clinical recovery","Counseling","Humans","Mental Disorders therapy","Mental Health Services","Meta analysis","Organizational setting","Peer support","Personal recovery","Systematic review"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-ITU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-ITU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"the effectiveness of peer support in personal and clinical recovery systematic review and meta analysis","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85166385681","version":"Other Version"},"id":"S02-095.24-698289","identifier":[{"id":"85166385681","type":"scopus"},{"id":"36751908","type":"pmid"}],"ids":["ku-b358859b-4dc1-4b64-9074-1f4126ce97fc","sdu-efa04307-90eb-4f23-9d9d-3e665a4f2136"],"keyword":["Adult","Anxiety","Clinical recovery","Counseling","Humans","Mental Disorders/therapy","Mental Health Services","Meta-analysis","Organizational setting","Peer support","Personal recovery","Systematic review"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-3324244B43B85E9304F568C764FA9B71"],"org":[{"affno":"1","country":"dk","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen"],"nora_code":"DI-U-ITU","used":1},{"a