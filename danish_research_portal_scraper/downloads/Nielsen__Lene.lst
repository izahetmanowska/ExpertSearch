ark","Europe, EU","Nordic","OECD"],"name":"North Denmark Region","namevar":["Aalborg University Hospital"],"nora_code":"DI-HO-NDR","used":1}],"person":[{"affno":"1","first":"Z. R.","key":"stisenpau","last":"Stisen","name":"Stisen, Z. R.","rank":1,"rolecode":"pau"},{"affno":"2 1 3","corresponding":null,"first":"S M","key":"nielsenpau","last":"Nielsen","locid":"03d20c40-68db-4ce0-93e7-6c73fe727f6e","name":"Nielsen, Sabrina Mai","name_org":"Nielsen, S M","orcid":"0000-0003-2857-2484","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"S. B.","key":"ditlevpau","last":"Ditlev","name":"Ditlev, S. B.","rank":3,"rolecode":"pau"},{"affno":"1 4 5","corresponding":null,"country":"dk","first":"M.","key":"skougaardpau","last":"Skougaard","locid":"e0190167-b3c2-47f3-89b2-d99dd3ffc259","name":"Skougaard, Marie","name_org":"Skougaard, M.","orcid":"0000-0003-2676-4749","rank":4,"rolecode":"pau"},{"affno":"1 6","first":"A.","key":"egebergpau","last":"Egeberg","locid":"e4445a48-c228-4507-b47c-a83175478f82","name":"Egeberg, Alexander","name_org":"Egeberg, A.","rank":5,"rolecode":"pau"},{"affno":"1 6","first":"M.","key":"mogensenpau","last":"Mogensen","locid":"4a53b078-2e8d-47c4-a208-d8c0a2aa52c8","name":"Mogensen, Mette","name_org":"Mogensen, M.","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"T S","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, T S","rank":7,"rolecode":"pau"},{"affno":"7 8","corresponding":null,"country":"dk","first":"L.","key":"dreyerpau","last":"Dreyer","locid":"b12f9d3c-1fa5-4513-8002-c9fd87d60d53","name":"Dreyer, Lene","name_org":"Dreyer, L.","orcid":"0000-0002-5156-2922","rank":8,"rolecode":"pau"},{"affno":"2 1 3","corresponding":null,"first":"R","key":"christensenpau","last":"Christensen","locid":"04bf2bf9-a6d8-4be8-93fd-82f3f2ddc9ba","name":"Christensen, Robin","name_org":"Christensen, R","orcid":"0000-0002-6600-0631","rank":9,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"L E","key":"kristensenpa