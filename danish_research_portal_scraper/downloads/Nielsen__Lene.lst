ank":4,"rolecode":"pau"}],"pub":{"issn":["01084755"],"issue":"2","journal":"Grønt Miljø","pages":"14","status":"p","title":"Grønt Miljø","title_org":"Groent Miljoe","volume":"29"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-6b0f159c-a278-4eba-b4f0-1dac78031179"],"src":["KU University of Copenhagen"],"title":"Forskerkapløb om at redde asken fra toptørre","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-457371","year":"2011","yearsub":"2011"}
{"abstract":"Low-risk and high-risk breast cancer patients are stratified primarily according to their lymph node (LN) status and grading. However, some low-risk patients relapse, and some high-risk patients have a favorable clinical outcome, implying a need for better prognostic and predictive tests. Micro RNAs are often aberrantly expressed in cancer and microRNA-21 is upregulated in a variety of cancers, including breast cancer. High miR-21 levels have been associated with poor prognosis. To determine the cellular localization of miR-21 and to compare its expression levels with histopathological features, we performed in situ hybridization and semi-quantitative assessment of the miR-21 signal on 12 LN negative grade I (assumed low risk), and 12 LN positive grade II (high risk) breast cancers. miR-21 was predominantly seen in cancer associated fibroblast-like cells, with no difference in expression levels between grade I and grade II carcinomas. Immunohistochemical scoring of the prognostic proliferation marker Ki-67 and tumor suppressor p53 showed that the miR-21 expression levels significantly correlated with the Ki-67 score (p = 0.043), whereas no correlation between p53 and miR-21 was found. Our results indicate that miR-21 may contribute to improve clinical stratification according to growth rate and facilitate tailored treatment of breast cancer patients.","author_count":9,"contributors":["Rask, Lene","Balslev, Eva","Jørgensen, Stine","Eriksen, Jens","Flyger, Henrik","Møller, Søren","Høgdall, Estrid","Litman, Thomas","Nielsen, Boye Schnack"],"cuid":["S01-000.00-463081"],"filters":{"added":"2022-04","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Adult","Aged","Aged 80 and over","Breast Neoplasms","Carcinoma Ductal Breast","Cell Growth Processes","Female","Gene Expression Regulation Neoplastic","Humans","Immunohistochemistry","In situ hybridization","Ki 67 Antigen","MicroRNAs","Middle Aged","Statistics Nonparametric","Tumor Markers Biological","Tumor Suppressor Protein p53"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-PR","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-ZEA"],"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-HO-CAP","DI-HO-ZEA","DI-PR-OTH","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"high expression of mir 000000000021 in tumor stroma correlates with increased cancer cell proliferation in human breast cancer","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-463081","identifier":[{"id":"80052857162","type":"scopus"},{"id":"21917003","type":"pmid"}],"ids":["ku-74776440-4c02-453e-89b3-e5e465b829e8"],"keyword":["Adult","Aged","Aged, 80 and over","Breast Neoplasms","Carcinoma, Ductal, Breast","Cell Growth Processes","Female","Gene Expression Regulation, Neoplastic","Humans","Immunohistochemistry","In Situ Hybridization","Ki-67 Antigen","MicroRNAs","Middle Aged","Statistics, Nonparametric","Tumor Markers, Biological","Tumor Suppressor Protein p53"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-9FE8CF9DA994CBBA3F1469A672609E5E"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Neuroscience, Neuronal Signalling"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Rigshospitalet"],"nora_code":"DI-H