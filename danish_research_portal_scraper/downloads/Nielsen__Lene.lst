au"},{"affno":"1","corresponding":null,"first":"Tanja","key":"chræmmertanjamortensenpau","last":"Chræmmer","locid":"870ac26a-695b-4c8f-ac1c-7bb48d678789","name":"Chræmmer, Tanja Mortensen","name_org":"Chræmmer, Tanja","orcid":"0000-0002-3797-1834","rank":35,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Teresa Schou","key":"nielsenteresaschoupau","last":"Nielsen","locid":"e3a4174f-7bdc-477c-89e1-3946bd0aebfe","name":"Nielsen, Teresa Schou","rank":36,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ulla Hauge","key":"thostrupullahaugepau","last":"Thostrup","locid":"7283b5c7-6c85-419c-a7ad-c33192368f78","name":"Thostrup, Ulla Hauge","rank":37,"rolecode":"pau"}],"pub":{"pages":"88","place":"UCN","status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All University Colleges","DI-ALL","DI-UC","DI-UC-ALL","University College of Northern Denmark","University Colleges"],"PST":["Published"]},"sid":["ucn-6917b95a-0304-4bdd-ae52-aabc35dccfd9"],"src":["UCN University College of Northern Denmark"],"title":"Co-bog : Uddannelsernes egne eksempler på hvordan co-creation-aktiviteter indgår i praksis","type":"Book","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-651156","year":"2019","yearsub":"2019"}
{"abstract":"In recent years, the availability of reduced representation library (RRL) methods has catalysed an expansion of genome-scale studies to characterize both model and non-model organisms. Most of these methods rely on the use of restriction enzymes to obtain DNA sequences at a genome-wide level. These approaches have been widely used to sequence thousands of markers across individuals for many organisms at a reasonable cost, revolutionizing the field of population genomics. However, there are still some limitations associated with these methods, in particular, the high molecular weight DNA required as starting material, the reduced number of common loci among investigated samples, and the short length of the sequenced site-associated DNA. Here, we present MobiSeq, a RRL protocol exploiting simple laboratory techniques, that generates genomic data based on PCR targeted-enrichment of transposable elements and the sequencing of the associated flanking region. We validate its performance across 103 DNA extracts derived from three mammalian species: grey wolf (Canis lupus), red deer complex (Cervus sp.), and brown rat (Rattus norvegicus). MobiSeq enables the sequencing of hundreds of thousands loci across the genome, and performs SNP discovery with relatively low rates of clonality. Given the ease and flexibility of MobiSeq protocol, the method has the potential to be implemented for marker discovery and population genomics across a wide range of organisms - enabling the exploration of diverse evolutionary and conservation questions. This article is protected by copyright. All rights reserved.","author_count":16,"contributors":["Rey-Iglesia, Alba","Gopalakrishan, Shyam","Carøe, Christian","Alquezar-Planas, David E.","Nielsen, Anne Ahlmann","Röder, Timo","Bruhn Pedersen, Lene","Naesborg-Nielsen, Christina","Sinding, Mikkel-Holger S.","Fredensborg Rath, Martin","Li, Zhipeng","Petersen, Bent","Gilbert, M. Thomas P.","Bunce, Michael","Mourier, Tobias","Hansen, Anders Johannes"],"cuid":["S02-083.88-035963"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Asia, East","OECD","Oceania"],"corresponding_author":["Hansen, Anders Johannes"],"country":["Australia","China"],"glorg":["All Global Affiliations","Chinese Academy of Agricultural Sciences","Curtin University"],"keyword":["Genotyping","Population genomics","Reduced representation library","SNP discovery","Te","Transposable elements"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU","DI-U-KU"]},"level3all":["DI-U-DTU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"mobiseq de novo snp discovery in model and non model species through sequencing the flanking region of transposable elements","src":["dtu","ku"],"src-code":["DI-U-DTU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/250426691/Rey_Iglesia_et_al_2019_Molecular_Ecology_Resources_MobiSeq_De_novo_SNP_discovery_in_model_and_non_model_species_through_sequencing_the_flanking_region_of_transposable_elements_accepted_version_.pdf","version":"Authors Final Version"},"funding_acknowledgement":["We are grateful to all the people and institutions that have provided samples for this study, specifically Department of Environment Nunavut, Environment and Natural Resources Northwest Territories, and Lindsey Carmichael and David Coltman at University of Alberta (wolf samples); Frank Zachos (Natural History Museum in Vienna); Meirav Meiri (Tel Aviv University); Adrian Lister, Ian Barnes and Richard Sabin (Natural History Museum of London); Kristian Murphy Gregersen (Natural History Museum of Denmark); Rolf Langvatn (University Centre in Svalbard); and Gennady Baryshnikov (Russian Academy of Sciences, Moscow) (deer material). We also thank Lasse Vinner for experimental methodology discussions; Maria Asplund for discussion on data analysis in the early stages of the project; and The Danish National Advanced Technology Foundation. S.G. was funded by EU Marie Skłodowska‐Curie Grant 655732 (Wherewolf)."],"id":"S02-083.88-035963","identifier":[{"id":"000459815200017","type":"wos"},{"id":"85061303011","type":"scopus"},{"id":"30575257","type":"pmid"}],"ids":["dtu-939ba213-105c-4c6e-b3f1-e6ca764b5818","ku-1e01080c-1f16-42ae-b2bc-500dec0dd781"],"keyword":["Genotyping","Population genomics","Reduced representation library","SNP discovery","TE","Transposable elements"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-6B5919A16E20B76FBE5B29E478928C87"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/164225625/Rey_Iglesia_et_al_2018_Molecular_Ecology_Resources.pdf","version":"Authors Final Version"},{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/250426691/Rey_Iglesia_et_al_2019_Molecular_Ecology_Resources_MobiSeq_De_novo_SNP_discovery_in_model_and_non_model_species_through_sequencing_the_flanking_region_of_transposable_elements_accepted_version_.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Globe Institute, Section for Geogenetics"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"cn","key":"chinese academy of agricultural sciences","loc":["China","Asia, East"],"name":"Chinese Academy of Agricultural Sciences","used":1},{"affno":"3","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Health Technology"],"nora_code":"DI-U-DTU","used":1},{"affno":"4","country":"au","key":"curtin university","loc":["Australia","Oceania","OECD"],"name":"Curtin University","used":1}],"person":[{"affno":"1","first":"Alba","key":"reyiglesiapau","last":"Rey-Iglesia","locid":"3762f335-5f40-4693-9e84-353e78a02999","name":"Rey-Iglesia, Alba","orcid":"0000-0002-3768-9185","rank":1,"rolecode":"pau"},{"affno":"1","first":"Shyam","key":"gopalakrishanpau","last":"Gopalakrishan","locid":"916fe6ce-9552-4c02-821d-a3daf516e32b","name":"Gopalakrishan, Shyam","rank":2,"rolecode":"pau"},{"affno":"1","first":"Christian","key":"carøepau","last":"Carøe","locid":"ac9e0369-c0ab-4484-a7d3-08d2600928e0","name":"Carøe, Christian","rank":3,"rolecode":"pau"},{"affno":"","first":"David E.","key":"alquezarplanaspau","last":"Alquezar-Planas","locid":"6d751051-1a76-4887-b5b6-1b65ee529788","name":"Alquezar Planas, David Eugenio","name_org":"Alquezar-Planas, David E.","rank":4,"rolecode":"pau"},{"affno":"","first":"Anne Ahlmann","key":"nielsenpau","last":"Nielsen","locid":"6a334744-bbe2-4f8f-9f5a-de93253b0d71","name":"Nielsen, Anne Ahlmann","rank":5,"rolecode":"pau"},{"affno":"","first":"Timo","key":"röderpau","last":"Röder","name":"Röder, Timo","rank":6,"rolecode":"pau"},{"affno":"1","first":"Lene Bruhn","key":"pedersenpau","last":"Pedersen","locid":"2aaa32e9-09e5-49b8-9c59-67cdaef43a21","name":"Pedersen, Lene Bruhn","rank":7,"rolecode":"pau"},{"affno":"","first":"Christina","key":"næsborgnielsenpau","last":"Næsborg-Nielsen","name":"Næsborg-Nielsen, Christina","rank":8,"rolecode":"pau"},{"affno":"1","first":"Mikkel-Holger S.","key":"sindingpau","last":"Sinding","locid":"d441872e-7274-486b-b9b2-0c0ee8bb3545","name":"Sinding, Mikkel Holger S.","name_org":"Sinding, Mikkel-Holger S.","orcid":"0000-0003-1371-219X","rank":9,"rolecode":"pau"},{"affno":"1","first":"Martin Fredensborg","key":"rathpau","last":"Rath","locid":"17e1980e-e336-4c55-ad3e-9e680dcd8364","name":"Rath, Martin Fredensborg","orcid":"0000-0002-4047-6324","rank":10,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Zhipeng","key":"lipau","last":"Li","name":"Li, Zhipeng","rank":11,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Bent","key":"petersenpau","last":"Petersen","locid":"483a94e4-a22f-4192-aa04-100588c07904","name":"Petersen, Bent","orcid":"0000-0002-2472-8317","rank":12,"rolecode":"pau"},{"affno":"1","first":"M Thomas P","key":"gilbertpau","last":"Gilbert","locid":"58c97189-c7e9-4486-afb1-e7669608599e","name":"Gilbert, M. Thomas P.","name_org":"Gilbert, M Thomas P","orcid":"0000-0002-5805-7195","rank":13,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Michael","key":"buncepau","last":"Bunce","name":"Bunce, Michael","rank":14,"rolecode":"pau"},{"affno":"","first":"Tobias","key":"mourierpau","last":"Mourier","locid":"a25925b1-60da-485a-8ad5-9b6025d3cba8","name":"Mourier, Tobias","orcid":"0000-0003-2727-1903","rank":15,"rolecode":"pau"},{"affno":"1","first":"Anders Johannes","key":"hansenpau","last":"Hansen","locid":"846e4329-bfc5-4ddb-968c-445cdb16825a","name":"Hansen, Anders Johannes","orcid":"0000-0002-1890-2702","rank":16,"rolecode":"pau"}],"pmid":["30575257"],"pub":{"doi":"10.1111/1755-0998.12984","issn":["1365294X","1755098X"],"issn_org":["1755098X"],"issue":"2","journal":"Molecular Ecology Resources","pages":"512-525","publisher":"Wiley","status":"p","title":"Molecular Ecology Resources","volume":"19"},"review":"Peer Reviewed","scoID":["2-s2.0-85061303011"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["dtu-939ba213-105c-4c6e-b3f1-e6ca764b5818","ku-1e01080c-1f16-42ae-b2bc-500dec0dd781"],"src":["DTU Technical University of Denmark","KU University of Copenhagen"],"title":"MobiSeq: De Novo SNP discovery in model and non-model species through sequencing the flanking region of transposable elements","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-083.88-035963","year":"2019","yearsub":"2019"}
{"abstract":"Rainfall simulators can enhance our understanding of the hydrologic processes affecting the total runoff to urban drainage systems. This knowledge can be used to improve urban drainage designs. In this study, a rainfall simulator is developed to simulate rainfall on urban green surfaces. The rainfall simulator is controlled by a microcomputer programmed to replicate the temporal variations in rainfall intensity of both historical and synthetic rainfall events with constant rainfall intensity on an area of 1 m2. The performance of the rainfall simulator is tested under laboratory conditions with regard to spatial uniformity of the rainfall, the kinetic energy of the raindrops, and the ability to replicate historical and synthetic rainfall events with temporally varying intensity. The rainfall simulator is applied in the field to evaluate its functionality under field conditions and the influence of wind on simulated rainfall. Finally, a field study is carried out on the relationship between runoff, soil volumetric water content, and surface slope. Performance and field tests show that the simulated rainfall has a uniform spatial distribution, whereas the kinetic energy of the raindrops is slightly higher than that of other comparable rainfall simulators. The rainfall simulator performs best in low wind speed conditions. The simulator performs well in replicating historical and synthetic rainfall events by matching both intensity variations and accumulated rainfall depth. The field study shows good correlation between rainfall, runoff, infiltration, soil water content, and surface slope.","author_count":7,"contributors":["Nielsen, Kristoffer","Møldrup, Per","Thorndahl, Søren Liedtke","Nielsen, Jesper Ellerbæk","Duus, Lene Bassø","Rasmussen, Søren Højmark","Uggerby, Mads"],"cuid":["S01-000.00-079299"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Infiltration","Pervious surfaces","Rainfall runoff","Rainfall simulator","Surface runoff","Urban drainage","Valve control","Variable rainfall"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-OTH"],"U":["DI-U-AAU","DI-U-ALL"]},"level3all":["DI-PR-OTH","DI-U-AAU"]},"review":"pr","rtype":["clu"],"sorti":"automated rainfall simulator for variable rainfall on urban green areas","src":["aau"],"src-code":["DI-U-AAU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1002/hyp.13563","version":"Published Version"},"id":"S01-000.00-079299","identifier":[{"id":"85071627407","type":"scopus"}],"ids":["aau-64b9e554-0f1e-49b5-92fc-ce4ea76d0a07"],"keyword":["Infiltration","Pervious surfaces","Rainfall simulator","Rainfall–runoff","Surface runoff","Urban drainage","Valve control","Variable rainfall"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-457D1B31367B30F0E3F9E3CFCC1FE57E"],"oa_link":[{"access":"oa","license":"CC BY 4.0","type":"loc","url":"https://vbn.aau.dk/ws/files/319703319/Automated_rainfall_simulator_for_variable_rainfall_on_urban_green_areas.pdf","version":"Published Version"},{"access":"oa","license":"CC BY 4.0","type":"doi","url":"https://doi.org/10.1002/hyp.13563","version":"Published Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2019","yearSub":"2019"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Engineering and Science","Aalborg University, The Faculty of Engineering and Science, Department of Civil Engineering","Aalborg University, The Faculty of Engineering and Science, Department of Civil Engineering, Di