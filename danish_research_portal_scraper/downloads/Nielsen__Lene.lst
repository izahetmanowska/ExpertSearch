ansen, Sylvia","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Per","key":"jørgensenpedh","last":"Jørgensen","name":"Jørgensen, Per","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"edition":"2","isbn":["9788762814769"],"pages":"233-238","place":"København","publisher":"Munksgaard","status":"p","title":"Psykiatri","volume":"1"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All University Colleges","DI-ALL","DI-UC","DI-UC-ALL","University Colleges","VIA University College"],"PST":["Published"]},"sid":["via-ba414473-07fc-449b-9db8-778bc3a751a5"],"src":["VIA University College"],"title":"Psykiske sygdomme, adfærds-og udviklingsforstyrrelser hos børn og unge. Ergoterapi til børn og unge med psykisk sygdom.","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-660170","year":"2016","yearsub":"2016"}
{"abstract":"AIM - Many Danes drink so much that it is detrimental to their health. As they are at risk of suffering diseases which can lead to hospitalisation on somatic wards, hospitals are ideal arenas for identifying individuals whose alcohol consumption is excessive. However, literature points out that this identification rarely takes place in hospitals, and literature further suggests that the staff experience barriers to talking about alcohol use with their patients. The primary aim of this study is to identify potential factors that influence whether or not nurses talk to patients about their alcohol consumption on somatic wards. Secondarily, we wish to examine whether a screening project may affect the nurses' readiness to talk about alcohol use with their patients. METHODS - A Glaserian Grounded Theory Method was used to collect and analyse data in this qualitative study. Semi-structured one-to-one interviews were conducted with seven nurses from somatic departments at two Danish hospitals. All seven nurses were already taking part in an alcohol screening project. RESULTS - In the analysis of the interview material, four categories emerged: The Nurse, The Patient, The Ward and The Relay Study. CONCLUSION - We identified a series of barriers and promoting factors for nurses to talk about alcohol use with patients in a hospital setting. The barriers and promoting factors emerged within four categories: The Nurse, The Patient, The Ward, and The Relay Study. The most important barrier to talking to patients about alcohol seemed to be factors within the nurses themselves, in particular personal experiences, lack of knowledge and lack of confidence. We found, however, that by participating in a screening project the nurses seemed to overcome some of these barriers.","author_count":3,"contributors":["Hellum, Rikke","Bjerregaard, Lene","Nielsen, Anette Søgaard"],"cuid":["S02-090.28-048013"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Alcohol","Barriers","Brief intervention","Grounded theory","Hospital","Nurses","Qualitative study","Screening"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U","DI-UC"],"level3":{"U":["DI-U-ALL","DI-U-SDU"],"UC":["DI-UC-AB","DI-UC-ALL"]},"level3all":["DI-U-SDU","DI-UC-AB"]},"review":"pr","rtype":["clu"],"sorti":"factors influencing whether nurses talk to somatic patients about their alcohol consumption","src":["pha","sdu"],"src-code":["DI-U-SDU","DI-UC-AB"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1515/nsad-2016-0034","version":"Published Version"},"id":"S02-090.28-048013","identifier":[{"id":"84991627887","type":"scopus"}],"ids":["pha-934e2c0e-e758-4f94-9d65-325308dceeef","sdu-d6cd61aa-b49b-48ee-9bd0-7f72a68639e0"],"keyword":["Grounded Theory","alcohol","barriers","brief intervention","hospital","nurses","promoting factors","qualitative study","screening"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-D60A8C60C37C751B6C94B493EABC7791"],"oa_link":[{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1515/nsad-2016-0034","version":"Published Version"},{"access":"oa","type":"loc","url":"https://ucviden.pha.dk/ws/files/39380989/Hellum_et_al_2016.pdf","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/129058345/nsad_2016_0034.pdf","version":"Published Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2016","yearSub":"2016"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, Faculty of Humanities, Department for the Study of Culture","SDU, Faculty of Humanities, Department of Culture and Language, Literature","SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, UCAR - Unit for Clinical Alcohol Research (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","key":"university college absalon","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-AB","l3nl":"University College Absalon","l3nn":"University College Absalon","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"University College Absalon","namevar":["Professionshøjskolen Absalon, Direktionen - Slagelse, Sundhed, Social og Engineeringområdet, Center for Sygepleje"],"nora_code":"DI-UC-AB","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Rikke","key":"hellumpau","last":"Hellum","locid":"6a885502-a150-45b6-aa52-a13ca5ce6d40","name":"Hellum, Rikke","orcid":"0000-0003-1587-7991","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lene Berit Skov","key":"bjerregaardpau","last":"Bjerregaard","locid":"84697a10-c2e3-4120-bba3-edbc5c689b83","name":"Bjerregaard, Lene Berit Skov","orcid":"0000-0002-3952-5301","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anette Søgaard","key":"nielsenpau","last":"Nielsen","locid":"63429b82-37e7-4fc5-84dd-f73ef3f5658a","name":"Nielsen, Anette Søgaard","orcid":"0000-0002-8569-4165","rank":3,"rolecode":"pau"}],"pub":{"doi":"10.1515/nsad-2016-0034","issn":["14550725","14586126"],"issn_org":["14550725"],"issue":"4","journal":"Nordisk Alkohol- & Narkotikatidskrift / Nordic Studies on Alcohol and Drugs","pages":"415-437","paperid":"No. NAD-D-16-00009R1","publisher":"SAGE Publications","status":"p","title":"Nordisk Alkohol- & Narkotikatidskrift / Nordic Studies on Alcohol and Drugs","title_org":"Nordic Studies on Alcohol and Drugs","volume":"33"},"review":"Peer Reviewed","scoID":["2-s2.0-84991627887"],"search":{"DAF":["All Danish Affiliations",