:"Sandra M","key":"coloradoyoharpau","last":"Colorado-Yohar","name":"Colorado-Yohar, Sandra M","rank":28,"rolecode":"pau"},{"affno":"17 22 23","corresponding":null,"first":"Marcela","key":"guevarapau","last":"Guevara","name":"Guevara, Marcela","rank":29,"rolecode":"pau"},{"affno":"24","corresponding":null,"first":"Alicia","key":"heathpau","last":"Heath","name":"Heath, Alicia","rank":30,"rolecode":"pau"},{"affno":"24 25 26","corresponding":null,"first":"Dagfinn","key":"aunepau","last":"Aune","name":"Aune, Dagfinn","rank":31,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Heinz","key":"freislingpau","last":"Freisling","name":"Freisling, Heinz","rank":32,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Inge","key":"huybrechtspau","last":"Huybrechts","name":"Huybrechts, Inge","rank":33,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Laure","key":"dossuspau","last":"Dossus","name":"Dossus, Laure","rank":34,"rolecode":"pau"}],"pmid":["40658296"],"pub":{"doi":"10.1007/s10654-025-01277-y","issn":["03932990","15737284"],"issn_org":["03932990"],"issue":"8","journal":"European Journal of Epidemiology","pages":"947-958","publisher":"Springer","status":"p","title":"European Journal of Epidemiology","volume":"40"},"review":"Peer Reviewed","scoID":["2-s2.0-105010684302"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Non-Profit Organisations","All Universities","DI-ALL","DI-NP","DI-NP-ALL","DI-U","DI-U-ALL","Non-Profit Organisations","Universities"],"PST":["Published"]},"sid":["au-abe73d29-b95e-4c02-9a56-2fa29f1168bb"],"src":["AU Aarhus University"],"title":"Plant-based dietary patterns and breast cancer risk in the European prospective investigation into cancer and nutrition (EPIC) study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-826088","year":"2025","yearsub":"2025"}
{"abstract":"Objectives: Intracranial devices may be used to treat or guide the treatment of increased intracranial pressure in patients with pneumococcal meningitis. European guidelines do not recommend the routine use of intracranial devices in the management of pneumococcal meningitis. However, in some countries, intracranial devices are used routinely, but the effect remains unknown. We aimed to examine whether mortality and sequelae were lower in patients with pneumococcal meningitis admitted to hospitals in regions where intracranial devices were routinely used compared with regions not utilizing intracranial devices routinely in pneumococcal meningitis management. Methods: In a registry-based, nationwide, population-based cohort study, we examined patients with pneumococcal meningitis (Denmark, 2004–2021). Patients were categorized according to whether the individual was admitted to hospitals in regions where intracranial devices were routinely (exposed patients, n = 305 of whom 66 (22%) had an intracranial device) or not routinely used (non-exposed patients, n = 333 of whom 4 (1%) had intracranial devices). We used Cox regression to calculate adjusted mortality rate ratios (aMRR) and hazard ratios of sequelae for the short-term and long-term periods (<6 or ≥6 months after study inclusion). Results: The short-term cumulative incidence of death was 22% among exposed patients and 22% among non-exposed patients. We found no association between mortality and routine use of intracranial devices in the region in which patients with pneumococcal meningitis were admitted (short-term aMRR [95% CI], 0.9 [0.6–1.3]; long-term aMRR [95% CI], 1.0 [0.7–1.6]). Furthermore, our study did not demonstrate lower risks of diagnosis of epilepsy, hearing loss, diagnoses suggestive of brain damage, disability pension, or shorter length of stay in exposed compared with non-exposed patients with pneumococcal meningitis. Discussion: The routine use of intracranial devices is not associated with lower mortality or morbidity among patients with pneumococcal meningitis.","author_count":15,"contributors":["Platz, Isabella L.","Tetens, Malte M.","Andersen, Nanna S.","Bodilsen, Jacob","Dessau, Ram B.","Ellermann-Eriksen, Svend","Møller, Jens K.","Nielsen, Lene","Yde Nielsen, Alex Christian","Søgaard, Kirstine K.","Østergaard, Christian","Lebech, Anne-Mette","Omland, Lars Haukali","Obel, Niels"],"cuid":["S03-099.49-813353"],"filters":{"added":"2025-06","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":3,"corresponding_author":["Platz, Isabella L."],"keyword":["Bacterial meningitis","Cohort Studies","External ventricular drainage device","Intracranial devices","Intracranial pressure"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-SDR","DI-HO-ZEA"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-HO-CDR","DI-HO-SDR","DI-HO-ZEA","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"mortality and sequelae associated with regional use of intracranial devices among patients with pneumococcal meningitis a nationwide population based cohort study","src":["aau","au","ku"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"http://www.scopus.com/inward/record.url?scp=86000761463&partnerID=8YFLogxK","version":"Other Version"},"funding_acknowledgement":["The work was supported by The Novo Nordisk Foundation and Danish Council for Independent Research under grant number 2034-00100B . The Novo Nordisk Foundation and Danish Council for Independent Research had no role in the preparation, design, analysis, or reporting of this study."],"id":"S03-099.49-813353","identifier":[{"id":"39954952","type":"pmid"},{"id":"86000761463","type":"scopus"}],"ids":["aau-53fd7a60-b13f-4110-96a4-66e3842a7670","au-e5197c85-63c0-491c-85fe-7fbfaafcc3c5","ku-a477d754-fa7e-4d5d-bb1d-53cac2d9db9f"],"keyword":["Bacterial meningitis","Cohort studies","External ventricular drainage device","Intracranial devices","Intracranial pressure"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-B445597049051A50FC2F3D8065C29555"],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Rigshospitalet, Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","used":1},{"affno":"3","country":"dk","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["University of Southern Denmark"],"nora_code":"DI-U-SDU","used":1},{"affno":"4","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Infectious Diseases","Aalborg Unive