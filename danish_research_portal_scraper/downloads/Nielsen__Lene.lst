ountry":"dk","first":"Henrik","key":"baktoftpau","last":"Baktoft","locid":"642a7cea-4ecc-4866-97f3-0d86f3e47ec0","name":"Baktoft, Henrik","orcid":"0000-0002-3644-4960","rank":14,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Kim","key":"aarestruppau","last":"Aarestrup","locid":"60987b6f-7027-4bd5-91bc-d2f10390aa63","name":"Aarestrup, Kim","orcid":"0000-0001-8521-6270","rank":15,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Tomas","key":"brodinpau","last":"Brodin","name":"Brodin, Tomas","rank":16,"rolecode":"pau"}],"pub":{"doi":"10.1016/j.fishres.2025.107501","issn":["01657836","18726763"],"issn_org":["01657836"],"journal":"Fisheries Research","paperid":"107501","publisher":"Elsevier","status":"p","title":"Fisheries Research","volume":"291"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-948460eb-23b2-4818-8a52-cde1a1ee6b44"],"src":["DTU Technical University of Denmark"],"title":"New trophic insights associated with the return of a top predator, bluefin tuna, to Skagerrak and the Sound","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-827790","year":"2025","yearsub":"2025"}
{"abstract":"This paper examines how descriptions of non-human personas are developed using established templates for human personas as a foundation. The research reveals significant differences in approach: some non-human personas aim to humanize other species, encouraging emotional connections while other descriptions prioritize providing information that is directly relevant to human interests and needs. The study highlights a gap in our understanding of how different elements impact the effectiveness of non-human personas, such as the narrative techniques, the tones of voice, and the levels of anthropomorphism. Additional research in these areas could lead to more engaging and empathy-inducing non-human personas, the development of more effective tools for communication and education, and technological advancements that are more inclusive and ecologically responsible. By exploring these factors, we can potentially create better ways to represent and interact with the non-human world in digital contexts.","author_count":6,"contributors":["Nielsen, Lene","Neuhoff, Rike"],"cuid":["S02-081.35-822511"],"filters":{"added":"2025-01","altsrc":["No Matches Found"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"corresponding_author":["Nielsen, Lene"],"keyword":["Interaction design","Personas"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-AAU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"the design of non human personas","src":["aau","itu"],"src-code":["DI-U-AAU","DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://www.researchgate.net/profile/Lene-Nielsen-5/publication/389427700_THE_DESIGN_OF_NON-HUMAN_PERSONAS/links/67c1cd15207c0c20fa9bc70f/THE-DESIGN-OF-NON-HUMAN-PERSONAS.pdf","version":"Published Version"},"id":"S02-081.35-822511","identifier":[{"id":"105003128874","type":"scopus"}],"ids":["aau-fa13ee32-4d2f-4428-8dd6-8c33a7cd2677","itu-71f7acb6-1adb-4297-998f-252c2cfd8d5f"],"keyword":["Climate centered design","Interaction design","Non-human personas","Personas"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-2-55B780C34A47EA8E5F62298A3868C5B9"],"oa_link":[{"access":"oa","license":"Andet","type":"loc","url":"https://pure.itu.dk/ws/files/109565079/non-human_personas_final.pdf","version":"Authors Final Version"},{"access":"oa","type":"rem","url":"https://www.researchgate.net/profile/Lene-Nielsen-5/publication/389427700_THE_DESIGN_OF_NON-HUMAN_PERSONAS/links/67c1cd15207c0c20fa9bc70f/THE-DESIGN-OF-NON-HUMAN-PERSONAS.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Digitalization, Democracy, and Governance","IT University of Copenhagen, Digitalization, Democracy, and Governance, REFLACT"],"nora_code":"DI-U-ITU","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Technical Faculty of IT and Design","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology, Section for Media Technology - Campus Copenhagen","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology, Service Systems Design"],"nora_code":"DI-U-AAU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lene","key":"nielsenpau","last":"Nielsen","locid":"1052b289-f510-4c5a-9662-2db48c12ebc2","name":"Nielsen, Lene","orcid":"0000-0003-1768-7147","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Rike","key":"neuhoffpau","last":"Neuhoff","locid":"2c453c44-1cb3-4875-92d7-5005eb289729","name":"Neuhoff, Rike","orcid":"0000-0002-2448-1844","rank":2,"rolecode":"pau"},{"affno":"","first":"M.B.","key":"nunespedh","last":"Nunes","name":"Nunes, M.B.","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"P.","key":"isaíaspedh","last":"Isaías","name":"Isaías, P.","rank":4,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"P.","key":"powellpedh","last":"Powell","name":"Powell, P.","rank":5,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"P.","key":"kommerspedh","last":"Kommers","name":"Kommers, P.","rank":6,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"isbn":["99789898704658"],"pages":"434-438","status":"p","title":"International Conference IADIS Information Systems 2025"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","IT University of Copenhagen","Universities"],"PST":["In Press","Published"]},"sid":["aau-fa13ee32-4d2f-4428-8dd6-8c33a7cd2677","itu-71f7acb6-1adb-4297-998f-252c2cfd8d5f"],"src":["AAU Aalborg University","ITU IT University of Copenhagen"],"title":"The design of non-human personas","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-081.35-822511","year":2025,"yearsub":"2025"}
{"abstract":"Purpose: There may be sex-based disparities in intensive care unit (ICU) management and outcomes. We compared baseline variables, interventions, and outcomes of immunocompromised critically ill men and women. Methods: We performed a post hoc analysis of the Efraim study, a prospective multinational cohort study of immunocompromised adults with acute hypoxemic respiratory failure admitted to one of 68 ICU in 16 countries between November 2015 and July 2016. We compared in unadjusted and adjusted analyses baseline variables, ICU interventions, and outcomes between men and women. Results: We included 1536 immunocompromised adults (922 men, 614 women) in this study. Women and men had similar age, BMI, and diagnoses leading to immunosuppression; hematopoietic cell transplant was more common in men. On the first ICU day, SOFA score was higher in men vs. women (7 [IQR 4–10] vs 6 [4–10]), p = 0.0005). The use of ICU supportive interventions, including mechanical ventilation, vasopressors, renal replacement, bronchoalveolar lavage, and ARDS adjuncts, were similar between men and women; as were mortality in ICU, in hospital, and at 90 days. After adjustment, female sex (sub-hazard ratio 1.19, 95 % CI 1.05–1.36, p = 0.007), SOFA score on ICU day 1 (sHR 1.16, 95 % CI 1.12–1.19, p < 0.001) and chronic kidney disease (sHR 0.74, 95 % CI 0.59–0.93, p = 0.009) were associated with mechanical ventilation. Age, performance status and SOFA score on ICU day 1 were associated with hospital mortality. Conclusions: In this post hoc analysis of immunocompromised adult ICU patients with hypoxemic respiratory failure, women and men received similar ICU interventions, and had similar outcomes.","author_count":39,"contributors":["Mehta, Sangeeta","Azoulay, Elie","Munshi, Laveena","Demoule, Alexandre","Perner, Anders","Meyhoff, Tine Sylvest","Bauer, Philippe R.","Metaxa, Victoria","Pène, Frédéric","Girault, Christophe","Soares, Márcio","Taccone, Fabio Silvio","Antonelli, Massimo","Barbier, Francois","Barratt-Due, Andreas","Bruneel, Fabrice","Bukan, Ramin Brandt","Burghi, Gastón","Chevret, Sylvie","Gaborit, Benjamin","Hemelaar, Pleun","Kouatchet, Achille","Landburg, Precious Pearl","Lemiale, Virginie","Martin-Loeches, Ignacio","Mokart, Djamel","Moreau, Anne Sophie","Montini, Luca","Nielsen, Lene Bjerregaard","Pickkers, Peter","Rello, Jordi","Rusinova, Katerina","Salluh, Jorge","Schellongowski, Peter","Souppart, Virginie","Terzi, Nicolas","Valkonen, Miia","van de Louw, Andry","Darmon, Michael"],"cuid":["S02-100.00-822934"],"filters":{"added":"2025-08","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","America, South","Europe, EU","Europe, Non-EU","Nordic","OECD"],"corpau":["for the Efraim investigators and the Nine-I study group"],"corresponding_author":["Mehta, Sangeeta"],"country":["Austria","Belgium","Brazil","Canada","Czechia","Finland","France","Ireland","Italy","Netherlands","Norway","Spain","United Kingdom","United States","Uruguay"],"glorg":["All Global Affiliations","Angers University Hospital","Assistance publique – Hôpitaux de Paris","CH Versailles","CHR Orléans","CHR d'Orléans","CHU Hôpitaux de Rouen","CHU Rennes","CHU de Angers","CHU de Nîmes","Centre Hospitalier de Versailles","Charles University","D’Or Institute for Research and Education","Fondazione Policlinico Universitario Gemelli","Free University of Brussels","Fundacion Jimenez Dıaz and CIBER de Enfermedades Respiratorias (CIBERES)","General Teaching Hospital","General University Hospital in Prague","Groupe Hospitalier du Havre","Helsinki University Hospital","Hershey Medical Center","Hospital Cochin","Hospital Maciel","Hospital Maciel Montevideo","Hôpital Universitaire de Bruxelles","Hôpital Universitaire de Bruxelles (HUB)","Institut Paoli Calmettes","Institut de Recherche Saint-Louis","Instituto D'or de Pesquisa e Ensino","Instituto de Salud Carlos III","International University of Catalonia","King