c92-acc1-bae0768882f8","name":"Hansen, Lene Kullen","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Morten Kromann","key":"nielsenpau","last":"Nielsen","locid":"910ddfe6-2209-476a-ad4d-3c990d70f244","name":"Nielsen, Morten Kromann","orcid":"0000-0003-4125-558X","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Tilde Lykke","key":"mardahlhansenpau","last":"Mardahl-Hansen","locid":"84bc6092-d98a-4959-aa07-4647c7c6a998","name":"Mardahl-Hansen, Tilde","name_org":"Mardahl-Hansen, Tilde Lykke","orcid":"0009-0008-0165-1151","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.7146/fppu.v6i2.134274","issn":["24462810"],"issue":"2","journal":"Forskning i Pædagogers Profession og Uddannelse","pages":"44-58","publisher":"Pædagoguddannelsens ledernetværk","status":"p","title":"Forskning i Pædagogers Profession og Uddannelse","volume":"6"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All University Colleges","DI-ALL","DI-UC","DI-UC-ALL","UCL University College","University Colleges"],"PST":["Published"]},"sid":["ucl-f9bcdd21-318b-49bc-af81-e64742173e85"],"src":["UCL University College"],"title":"Ungeperspektiver på læringsfællesskaber i FGU","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-649945","year":"2022","yearsub":"2022"}
{"abstract":"Background: Preventive measures targeting gestational diabetes may have unintended consequences for counselled women. Studies indicate that women with gestational diabetes experience a loss of personal control and feel controlled by internal and external forces. Aim: The aim of this study is twofold. The first is to gain insight into women´s experiences with gestational diabetes and their strategies to cope with advice for changing lifestyle. The second, to use these insights to discuss the approach to the women in preventive strategies targeting gestational diabetes. Methods: Semi-structured interviews with nine women with gestational diabetes were conducted at a university hospital, adopting a phenomenological approach. A thematic content analysis of the transcribed interviews was performed. Results: Three themes were created: Experience of control, personal strategies, and unintended consequences. Women experienced that the monitoring at the outpatient clinic was associated with feelings of surveillance and safety. Women´s strategies to integrate recommendations encompassed not consuming unhealthy food items or eating small amounts and then returning to being physically active. Some women experienced feeling different and labelled as a result of the monitoring and their eating habits. Some expressed concern for the baby and the time after birth, thinking about getting diabetes in the future. Conclusions: Even though gestational diabetes is a common diagnosis, it is still essential that every woman is individually treated and supported when integrating advice on gestational diabetes into her life. Standardised advice on managing gestational diabetes should be replaced by approaching women’s strategies as a starting point.","author_count":3,"contributors":["Toxvig, Lene","Nielsen, Jane Hyldgaard","Jepsen, Ingrid"],"cuid":["S01-000.00-650777"],"event":{"end":"2022-05-06","place":"Helsinki , fi","start":"2022-05-04","title":"NJF Congress 2022","year":"2022"},"filters":{"added":"2023-01","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"keyword":["Coping","Gestational diabetes mellitus","Psychological adaptation","disease health science and nursing"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-UC"],"level3":{"UC":["DI-UC-ALL","DI-UC-UCN"]},"level3all":["DI-UC-UCN"]},"review":"pr","rtype":["clu"],"sorti":"women s experiences with managing advice on gestational diabetes a qualitative interview study","src":["ucn"],"src-code":["DI-UC-UCN"],"type":"dcp","type-grp":["all","pub"]},"id":"S01-000.00-650777","ids":["ucn-4592c924-b53f-4f29-90e9-1a7994500a8f"],"keyword":["Coping","Gestational diabetes Mellitus","Psychological adaptation","disease, health science and nursing"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-B481DAFBD2A055E00B601BAEDCED9288"],"org":[{"affno":"1","key":"ucn university college of northern denmark","l2":"DI-UC","l2n":"University Colleges","l3":"DI-UC-UCN","l3nl":"University College of Northern Denmark","l3nn":"UCN University College of Northern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"UCN University College of Northern Denmark","namevar":["Professionshøjskolen UCN, UCN Direktion, UCN Velfærd, Jordemoderuddannelsen"],"nora_code":"DI-UC-UCN","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lene","key":"toxvigpau","last":"Toxvig","locid":"59772880-3647-455e-8903-2ef41d6f7d10","name":"Toxvig, Lene","orcid":"0000-0002-8579-3681","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jane Hyldgaard","key":"nielsenpau","last":"Nielsen","locid":"eae86023-3897-4f92-b4ce-6378fc86abd6","name":"Nielsen, Jane Hyldgaard","orcid":"0000-0003-2815-3984","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Ingrid","key":"jepsenpau","last":"Jepsen","locid":"e33e2f76-5b3e-4c7a-b9a1-0947cdac786a","name":"Jepsen, Ingrid","orcid":"0000-0002-7897-7036","rank":3,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All University Colleges","DI-ALL","DI-UC","DI-UC-ALL","University College of Northern Denmark","University Colleges"],"PST":["Published"]},"sid":["ucn-4592c924-b53f-4f29-90e9-1a7994500a8f"],"src":["UCN University College of Northern Denmark"],"title":"Women´s experiences with managing advice on gestational diabetes : A qualitative interview study","type":"Conference Paper","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-650777","year":"2022","yearsub":"2022"}
