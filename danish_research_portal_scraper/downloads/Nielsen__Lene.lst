":"wrightpau","last":"Wright","name":"Wright, Christopher John","rank":24,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lene","key":"russellpau","last":"Russell","name":"Russell, Lene","rank":25,"rolecode":"pau"}],"pmid":["37812225"],"pub":{"doi":"10.1007/s00134-023-07225-2","issn":["03424642","09351701"],"issn_org":["03424642"],"issue":"11","journal":"Intensive Care Medicine","pages":"1327-1338","publisher":"Springer Science+Business Media","status":"p","title":"Intensive Care Medicine","volume":"49"},"review":"Peer Reviewed","scoID":["2-s2.0-85173919249"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-3fad97e7-4f48-4344-ae4b-da65d16ce35e"],"src":["SDU University of Southern Denmark"],"title":"Thrombocytopenia and platelet transfusions in ICU patients : an international inception cohort study (PLOT-ICU)","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-713884","year":"2023","yearsub":"2023"}
{"abstract":"Differential diagnosis of inflammatory bowel disease (IBD) to Crohn’s disease (CD) or ulcerative colitis (UC) is crucial for treatment decision making. With the aim of generating a clinically applicable molecular-based tool to classify IBD patients, we assessed whole transcriptome analysis on endoscopy samples. A total of 408 patient samples were included covering both internal and external samples cohorts. Whole transcriptome analysis was performed on an internal cohort of FFPE IBD samples (CD, n = 16 and UC, n = 17). The 100 most significantly differentially expressed genes (DEG) were tested in two external cohorts. Ten of the DEG were further processed by functional enrichment analysis from which seven were found to show consistent significant performance in discriminating CD from UC: PI3, ANXA1, VDR, MTCL1, SH3PXD2A-AS1, CLCF1, and CD180. Differential expression of PI3, ANXA1, and VDR was reproduced by RT-qPCR, which was performed on an independent sample cohort of 97 patient samples (CD, n = 44 and UC, n = 53). Gene expression levels of the three-gene profile, resulted in an area under the curve of 0.84 (P = 0.02) in discriminating CD from UC, and therefore appear as an attractive molecular-based diagnostic tool for clinicians to distinguish CD from UC.","author_count":9,"contributors":["James, Jaslin Pallikkunnath","Nielsen, Boye Schnack","Christensen, Ib Jarle","Langholz, Ebbe","Malham, Mikkel","Poulsen, Tim Svenstrup","Holmstrøm, Kim","Riis, Lene Buhl","Høgdall, Estrid"],"cuid":["S01-000.00-719269"],"filters":{"added":"2024-02","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GTS","DI-HO","DI-U"],"level3":{"GTS":["DI-GTS-ALL","DI-GTS-BION"],"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-GTS-BION","DI-HO-CAP","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"mucosal expression of i pi000000000003 i i anxa000000000001 i and i vdr i discriminates crohn s disease from ulcerative colitis","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41598-023-45569-3","version":"Published Version"},"id":"S01-000.00-719269","identifier":[{"id":"37891214","type":"pmid"},{"id":"PMC10611705","type":"pmcid"},{"id":"85175080784","type":"scopus"}],"ids":["ku-0d8dd8c5-8fd7-4e3b-87c0-1b61b59f08f2"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-84D6642EC4FCB6CB58436B37D5DE6254"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1038/s41598-023-45569-3","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/373873547/s41598_023_45569_3.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital - Herlev and Gentofte"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","country":"dk","key":"bioneer","l2":"DI-GTS","l2n":"GTS Institutes","l3":"DI-GTS-BION","l3nn":"Bioneer","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Bioneer","namevar":["Bioneer"],"nora_code":"DI-GTS-BION","used":1},{"affno":"3","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine","Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Internal Medicine: Gastroenterology and Hepatology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Jaslin Pallikkunnath","key":"jamespau","last":"James","name":"James, Jaslin Pallikkunnath","rank":1,"rolecode":"pau"},{"affno":"2","first":"Boye Schnack","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Boye Schnack","rank":2,"rolecode":"pau"},{"affno":"1","first":"Ib Jarle","key":"christensenpau","last":"Christensen","name":"Christensen, Ib Jarle","rank":3,"rolecode":"pau"},{"affno":"1 3","first":"Ebbe","key":"langholzpau","last":"Langholz","locid":"c3ab9fb7-1eed-4843-bc2b-9a97abe090c4","name":"Langholz, Ebbe","orcid":"0000-0002-8558-8442","rank":4,"rolecode":"pau"},{"affno":"1","first":"Mikkel","key":"malhampau","last":"Malham","name":"Malham, Mikkel","rank":5,"rolecode":"pau"},{"affno":"1","first":"Tim Svenstrup","key":"poulsenpau","last":"Poulsen","name":"Poulsen, Tim Svenstrup","rank":6,"rolecode":"pau"},{"affno":"2","first":"Kim","key":"holmstrømpau","last":"Holmstrøm","name":"Holmstrøm, Kim","rank":7,"rolecode":"pau"},{"affno":"1 3","first":"Lene Buhl","key":"riispau","last":"Riis","locid":"8ec061c0-f464-42fd-ac8d-f972f86292cd","name":"Riis, Lene Buhl","rank":8,"rolecode":"pau"},{"affno":"1 3","first":"Estrid","key":"høgdallpau","last":"Høgdall","locid":"a48f77b8-ee6d-4a52-a3f3-deb515bdd48f","name":"Høgdall, Estrid","rank":9,"rolecode":"pau"}],"pmid":["37891214"],"pub":{"doi":"10.1038/s41598-023-45569-3","issn":["20452322"],"issue":"1","journal":"Scientific Reports","paperid":"18421","status":"p","title":"Scientific Reports","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-85175080784"],"search":{"DAF":["All Danish Affiliations","All GTS Institutes","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-GTS","DI-GTS-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","GTS Institutes","Hospitals","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-0d8dd8c5-8fd7-4e3b-87c0-1b61b59f08f2"],"src":["KU University of Copenhagen"],"title":"Mucosal expression of <i>PI3</i>, <i>ANXA1</i>, and<i> VDR</i> discriminates Crohn’s disease from ulcerative colitis","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-719269","year":"2023","yearsub":"2023"}
{"abstract":"Ash dieback (ADB) has become a major problem across European ash forests. The disease is caused by the invasive pathogenic fungus Hymenoscyphus fraxineus that results in sever crown damage, and especially in young ash trees often rapid mortality. Fortunately, several studies have found that a fraction of F. excelsior trees remain healthy with only few symptoms. Heritability and additive genetic variance in tolerance have been estimated from progeny trials to be moderate to high, with limited genotype x environment (GxE) interaction. High levels of infection pressure are often present in forest areas with newly planted trees revealing their level of tolerance within few years. These features make ADB tolerance suitable for phenotypic selection and led to the hypothesis that strong forward phenotypic selection can create a new generation of ash trees with substantial reduced susceptibility to the disease. As a coordinated effort, this approach is tested by establishing selection trials in Norway, Sweden, Denmark and Lithuania. The joint efforts include sharing of genetic material to estimate GxE, but the program is based on development of tolerant ash trees from local genetic resources. Here we present the concept, challenges, activities and some preliminary results from the field trials.","author_count":9,"contributors":["Kjær, Erik Dahl","Marciulyniene, Diana","Hansen, Jon Kehlet","Nielsen, Lene Rostgaard","Tollefsrud, Mari Mette","Cleary, Michelle","Liziniewicz, Mateusz"],"cuid":["S01-000.00-720316"],"event":{"end":"2023-09-15","place":"Brasov, ro","start":"2023-09-12","title":"EvolTree Conference 2023","year":"2023"},"filters":{"added":"2024-02","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD"],"country":["Lithuania","Norway","Sweden"],"glorg":["All Global Affiliations","Lithuanian Research Centre for Agriculture and Forestry","Norwegian Institute of Bioeconomy Research","SkogForsk","Swedish University of Agricultural Sciences"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"nr","rtype":["clu"],"sorti":"a regional effort to develop ash trees with high tolerance towards ash dieback based on phenotypic selection","src":["ku"],"src-code":["DI-U-KU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.31926/evoltree.2023","version":"Published Version"},"id":"S01-000.00-720316","ids":["ku-57c0c1b7-8f55-4d32-980e-a8a373cf4671"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-E1C851384A4CB7A0640CB78ED09A809B"],"oa_link":[{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/376979204/Resilient_Forests_for_the_Future_A_regional_effort_to_develop_ash_trees_with_high_tolerance_towards_ash_dieback.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.31926/evoltree.2023","version":"Published Version"},{"access":"oa","type":"rem","url":"https://www.evoltree.eu/fileadmin/Websites/Evoltree/Uploads/Documents/Events/EvolTree_BoA_07.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Geosciences and Natural Resource Management, Forest and Landscape Ecology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"lt","key":"lithuanian research centre for agriculture and forestry","loc":["Lithuania","Europe, EU","OECD"],"name":"Lithuanian Research Centre for Agriculture and Forestry","used":1},{"affno":"3","country":"no","key":"norwegian institute of bioeconomy research","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"Norwegian Institute of Bioeconomy Research","used":1},{"affno":"4","country":"se","key":"swedish university of agricultural sciences","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"Swedish University of Agricultural Sciences","used":1},{"affno":"5","country":"se","key":"skogforsk","loc":["Sweden","Europe, EU","Nordic","OECD"],"name":"SkogForsk","used":1}],"person":[{"affno":"1","first":"Erik Dahl","key":"kjærpau","last":"Kjær","locid":"e1bdaffb-0384-4159-aa20-a913a2cee948","name":"Kjær, Erik Dahl","orcid":"0000-0001-8624-1611","rank":1,"rolecode":"pau"},{"affno":"2","first":"Diana","key":"marciulynienepau","last":"Marciulyniene","name":"Marciulyniene, Diana","rank":2,"rolecode":"pau"},{"affno":"1","first":"Jon","key":"hansenpau","last":"Hansen","locid":"b8c2f3eb-b79f-46cc-b346-8300943e2129","name":"Hansen, Jon Kehlet","name_org":"Hansen, Jon","orcid":"0000-0002-1260-3509","rank":3,"rolecode":"pau"},{"affno":"1","first":"Lene","key":"nielsenpau","last":"Nielsen","locid":"8e8b51ee-3f45-4ebe-b2fb-fa79f1256d08","name":"Nielsen, Lene Rostgaard","name_org":"Nielsen, Lene","orcid":"0000-0002-7214-8691","rank":4,"rolecode":"pau"},{"affno":"3","first":"Mari Mette","key":"tollefsrudpau","last":"Tollefsrud","name":"Tollefsrud, Mari Mette","rank":5,"rolecode":"pau"},{"affno":"4","first":"Michelle","key":"clearypau","last":"Cleary","name":"Cleary, Michelle","rank":6,"rolecode":"pau"},{"affno":"5","first":"Mateusz","key":"liziniewiczpau","last":"Liziniewicz","name":"Liziniewicz, Mateusz","rank":7,"rolecode":"pau"},{"affno":"","first":"Alexandru Lucian","key":"curtupedh","last":"Curtu","name":"Curtu, Alexandru Lucian","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Elena","key":"ciocîrlanpedh","last":"Ciocîrlan","name":"Ciocîrlan, Elena","rank":9,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.31926/evoltree.2023","pages":"118","publisher":"Transilvania University of Brașov","status":"p","subtitle":"Book of Abstracts","title":"Resilient Forests for the Future"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-57c0c1b7-8f55-4d32-980e-a8a373cf4671"],"src":["KU University of Copenhagen"],"title":"A regional effort to develop ash trees with high tolerance towards ash dieback based on phenotypic selection","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-720316","year":"2023","yearsub":"2023"}
{"abstract":"In addition to valuable renewable wood resources, oak forests are essential ecosystems hosting a large amount of biodiversity. Although oaks are predicted to be less affected by a shift in climatic conditions, including more frequent and severe drought spells, compared to other forest tree species, they will have to adapt fast to future climatic changes. Here we use classical landscape genomics to locate genes with a potential adaptive role in drought-resistance among pan-European provenances of sessile oak (Quercus petraea). We ask if an enrichment with alleles beneficial for dry conditions from southern provenances often subjected to drought – be it by natural dispersal, gene flow or human plantings – can enhance the adaptive potential of the native Danish Q. petraea populations to a future drier climate. We find numerous genetic loci (single nucleotide polymorphisms; SNPs) associated with bioclimatic variables describing local precipitation. While many of the associated SNPs are found in inter-genic regions, some are indeed located in, or close to genes, known to be involved in drought stress responses. Thus, beneficial alleles have the potential to spread across the landscape. We will present detailed analyses of these beneficial alleles in order to determine whether they are absent in the local Danish gene pool, or if they are already present at low frequency, and thus enabling adaptation to a drier climate based on standing genetic variation. In conclusion, beneficial alleles found among southern populations of sessile oak is a valuable source for future enrichment of northern oak seed sources and natural populations to ensure their robustness under future climate.","author_count":9,"contributors":["Olofsson, Jill Katharina","Lobo, Albin","Hansen, Jon Kehlet","Nielsen, Lene Rostgaard","Budde, Katharina Birgit","Rellstab, Christian","Kjær, Erik Dahl"],"cuid":["S01-000.00-720569"],"event":{"end":"2023-09-15","place":"Brasov, ro","start":"2023-09-12","title":"EvolTree Conference 2023","year":"2023"},"filters":{"added":"2024-02","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","OECD"],"country":["Germany","Switzerland"],"glorg":["All Global Affiliations","Swiss Federal Institute for Forest, Snow and Landscape Research","University of Göttingen"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"nr","rtype":["clu"],"sorti":"can northern sessile oaks profit from southern genetic variants to face future climate change","src":["ku"],"src-code":["DI-U-KU"],"type":"dca","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.31926/evoltree.2023","version":"Published Version"},"id":"S01-000.00-720569","ids":["ku-69de5321-1e00-4d54-98a1-8fa25c6816db"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-1-E0733E3DAF57BB741C2FF0D84950DC42"],"oa_link":[{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/376967266/Resilient_Forests_for_the_Future_Can_northern_sessile_oaks.pdf","version":"Published Version"},{"access":"oa","type":"rem","url":"https://www.evoltree.eu/fileadmin/Websites/Evoltree/Uploads/Documents/Events/EvolTree_BoA_07.pdf","version":"Published Version"},{"access":"oa","type":"doi","url":"https://doi.org/10.31926/evoltree.2023","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Geosciences and Natural Resource Management, Forest and Landscape Ecology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"de","key":"university of göttingen","loc":["Germany","Europe, EU","OECD"],"name":"University of Göttingen","used":1},{"affno":"3","country":"ch","key":"swiss federal institute for forest snow and landscape research","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"Swiss Federal Institute for Forest, Snow and Landscape Research","used":1}],"person":[{"affno":"1","first":"Jill Katharina","key":"olofssonpau","last":"Olofsson","locid":"63672d16-07b3-40a4-9be6-82c150b80023","name":"Olofsson, Jill Katharina","orcid":"0000-0002-9527-6573","rank":1,"rolecode":"pau"},{"affno":"1","first":"Albin","key":"lobopau","last":"Lobo","locid":"50b0d4fe-6e8d-4245-aded-c406110ff0b0","name":"Lobo, Albin","orcid":"0000-0002-9580-2860","rank":2,"rolecode":"pau"},{"affno":"1","first":"Jon Kehlet","key":"hansenpau","last":"Hansen","locid":"b8c2f3eb-b79f-46cc-b346-8300943e2129","name":"Hansen, Jon Kehlet","orcid":"0000-0002-1260-3509","rank":3,"rolecode":"pau"},{"affno":"1","first":"Lene","key":"nielsenpau","last":"Nielsen","locid":"8e8b51ee-3f45-4ebe-b2fb-fa79f1256d08","name":"Nielsen, Lene Rostgaard","name_org":"Nielsen, Lene","orcid":"0000-0002-7214-8691","rank":4,"rolecode":"pau"},{"affno":"2","first":"Katharina Birgit","key":"buddepau","last":"Budde","name":"Budde, Katharina Birgit","rank":5,"rolecode":"pau"},{"affno":"3","first":"Christian","key":"rellstabpau","last":"Rellstab","name":"Rellstab, Christian","rank":6,"rolecode":"pau"},{"affno":"1","first":"Erik Dahl","key":"kjærpau","last":"Kjær","locid":"e1bdaffb-0384-4159-aa20-a913a2cee948","name":"Kjær, Erik Dahl","orcid":"0000-0001-8624-1611","rank":7,"rolecode":"pau"},{"affno":"","first":"Alexandru Lucian","key":"curtupedh","last":"Curtu","name":"Curtu, Alexandru Lucian","rank":8,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Elena","key":"ciocîrlanpedh","last":"Ciocîrlan","name":"Ciocîrlan, Elena","rank":9,"role":"Editor of Host Publication","rolecode":"pedh"}],"pub":{"doi":"10.31926/evoltree.2023","pages":"37","publisher":"Transilvania University of Brașov","status":"p","subtitle":"Book of Abstracts","title":"Resilient Forests for the Future"},"review":"No Review","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-69de5321-1e00-4d54-98a1-8fa25c6816db"],"src":["KU University of Copenhagen"],"title":"Can northern sessile oaks profit from southern genetic variants to face future climate change?","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-720569","year":"2023","yearsub":"2023"}
{"abstract":"Background Colchicine has been suggested for osteoarthritis treatment, but evidence is contradictory. We aimed to investigate colchicine's efficacy and safety compared with placebo in people with hand osteoarthritis.Methods In this single-centre, double-blind, randomised, placebo-controlled trial we recruited adults with symptomatic hand osteoarthritis and finger pain of at least 40 mm on a 100 mm visual analogue scale from an outpatient clinic in Denmark. The hand with the most severe finger pain at inclusion was the target hand. Participants were randomly assigned (1:1) to 0 center dot 5 mg colchicine or placebo taken orally twice a day for 12 weeks, stratified by BMI (>= 30 kg/m2), sex, and age (>= 75 years). Participants, outcome assessors, and data analysts were masked to treatment allocation. The primary endpoint was change from baseline to week 12 in target hand finger pain, assessed on a 100 mm visual analogue scale with a pre-specified minimal clinically important difference of 15 mm, in the intention-to-treat population. Safety was assessed at week 12 in the intention-to-treat population. The study was registered with ClinicalTrials.gov, NCT04601883, and with EudraCT, 2020-002803-20.Findings Between Jan 15, 2021, and March 3, 2022, 186 people were screened for eligibility, and 100 were randomly assigned to receive colchicine (n=50) or placebo (n=50). Participants had a mean age of 70 center dot 9 (SD 7 center dot 5) years, 69 (69%) of 100 were women and 31 (31%) were men. All participants completed the study. The mean change from baseline to week 12 in finger pain were -13 center dot 9 mm (SE 2 center dot 8) in the colchicine group and -13 center dot 5 mm (2 center dot 8) in the placebo group, with a between-group difference (colchicine vs placebo) of -0 center dot 4 mm (95% CI -7 center dot 6 to 6 center dot 7; p=0 center dot 90). In the colchicine group, there were 76 adverse events in 36 (72%) of 50 participants and one serious adverse advent (migraine attack leading to hospital admission). In the placebo group, there were 42 adverse events in 22 (44%) of 50 participants and two serious adverse events (cholecystitis and elevated alanine aminotransferase concentrations, in the same patient).Interpretation In people with painful hand osteoarthritis, treatment with 0 center dot 5 mg of colchicine twice day for 12 weeks did not effectively relieve pain, and treatment with colchicine was associated with more adverse events.Funding The Oak Foundation, IMK Almene Fond, Minister Erna Hamilton's Scholarship for Science and Art, AP Moller and Wife Chastine McKinney Moller's Foundation for Medical Science Advancement, The Danish Medical Association, the Velux Foundation, Aase and Einar Danielsen's Foundation, and Director Emil C Hertz and Wife Inger Hertz's foundation.Copyright (c) 2023 Published by Elsevier Ltd. All rights reserved.","author_count":23,"contributors":["Døssing, Anna","Henriksen, Marius","Ellegaard, Karen","Nielsen, Sabrina Mai","Stamp, Lisa K.","Müller, Felix C.","Kloppenburg, Margreet","Haugen, Ida K.","McCarthy, Geraldine M.","Conaghan, Philip G.","Ulff-Møller Dahl, Louise","Terslev, Lene","Altman, Roy D.","Becce, Fabio","Ginnerup-Nielsen, Elisabeth","Jensen, Lene","Boesen, Mikael","Christensen, Robin","Dal, Ulla","Bliddal, Henning"],"cuid":["S02-096.87-673072"],"filters":{"added":"2023-06","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","Asia, East","Europe, EU","Europe, Non-EU","Nordic","OECD","Oceania"],"corresponding_author":["Døssing, Anna"],"country":["Hong Kong","Ireland","Netherlands","New Zealand","Norway","Switzerland","United Kingdom","United States"],"glorg":["All Global Affiliations","Diakonhjemmet Hospital","Lausanne University Hospital","Leiden University","NIHR Leeds Biomedical Research Centre","Patient Research Partner","University College Dublin","University of California at Los Angeles","University of Lausanne","University of Leeds","University of Otago","University of Southern California"],"keyword":["American college","Criteria","Evaluate","SET"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-SDR"],"OT":["Patient research partner"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-HO-SDR","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"colchicine twice a day for hand osteoarthritis color a double blind randomised placebo controlled trial","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85152928802","version":"Other Version"},"funding_acknowledgement":["The Parker Institute is supported by a core grant from the Oak Foundation (OCAY-18–774-OFIL). This project was supported by IMK Almene Fond, Erna Hamilton's Foundation (Minister Erna Hamilton's Scholarship for Science and Art), the A P Møller Foundation (A P Møller and Chastine McKinney Møller's Foundation for Medical Science Advancement), The Danish Medical Association, the Velux Foundation, Aase and Ejnar Danielsen's Foundation, and Emil C Hertz and Inger Hertz's foundation. Funders had no role in study design, data collection, data synthesis, data interpretation, writing of the report or decision to submit the manuscript. PGC is funded in part through the UK National Institute for Health and Care Research (NIHR) Leeds Biomedical Research Centre. The views expressed are those of the authors and not necessarily those of the National Health Service, the NIHR, or the Department of Health."],"id":"S02-096.87-673072","identifier":[{"id":"85152928802","type":"scopus"},{"id":"38251589","type":"pmid"},{"id":"000981430000001","type":"wos"}],"ids":["ku-2a6144b9-4cb9-4a0b-8d46-43cc1cf42f8d","sdu-84b22f1b-4444-42ff-8120-3563ee63b9c7"],"k