z","issn":["18787649"],"issue":"4","journal":"European Geriatric Medicine","pages":"991-999","publisher":"Springer Science+Business Media","status":"p","title":"European Geriatric Medicine","volume":"15"},"review":"Peer Reviewed","scoID":["2-s2.0-85196022561"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-3532ae07-b2d5-4b77-a472-f748b19b50a3"],"src":["SDU University of Southern Denmark"],"title":"Challenges related to transitioning from hospital to temporary care at a skilled nursing facility : a descriptive study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-782952","year":"2024","yearsub":"2024"}
