dk","first":"Lene Kongsgaard","key":"kongsgaardnielsenlenepau","last":"Nielsen","locid":"897c29d3-45a2-4178-81b1-b0ba61db5a25","name":"Kongsgaard Nielsen, Lene","name_org":"Nielsen, Lene Kongsgaard","orcid":"0000-0003-2083-3870","rank":17,"rolecode":"pau"}],"pub":{"issn":["0008543X","10457410"],"issn_org":["0008543X"],"journal":"Cancer","pages":"303-314","publisher":"John Wiley & Sons Inc.","status":"p","title":"Cancer"},"review":"Peer Reviewed","search":{"DAF":["Aalborg University","Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region Zealand","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-48257f32-c498-4f57-8cd7-24e93ebd0b3c"],"src":["AU Aarhus University"],"title":"Quality of Life in Danish Patients with Multiple Myeloma during the COVID-19 pandemic","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-170461","year":"2021","yearsub":"2021"}
{"abstract":"For food research, control, and production,valid and trustworthy analytical data are important. Our practical chemical food safety course for engineers therefore uses real-life studies for the ease of understanding the concept and the needed requirements for high analytical quality in relation to enabling correct evaluation of chemical food safety. Concepts of chromatography and mass spectrometry were applied and left open for inquiry-based learning and students’ search for information for their actual case study during this 3 week practical course. Three case studies, with three different analytical chemistry challenges, were addressed, namely, iodine, ethyl carbamate, and N-nitrosamine determination by ICP-MS, GC–MS,and LC–MS/MS, respectively. Each group of students successfully concluded one case study by integration of method validation and other appropriate analytical quality concepts with practical conduction of the analysis. The assignment included obtaining their own results,and evaluation of the results in the context of a food safety assessment.Successful vocabulary attainment and learning of quality assurance,analytical concepts, and data evaluation were communicated in report writing as well as oral presentations in front of the other students(in groups) and at the final examination (individually).","author_count":5,"contributors":["Duedahl-Olesen, Lene","Holmfred, Else","Niklas, Agnieszka Anna","Kallehauge Nielsen, Ida","Sloth, Jens Jørgen"],"cuid":["S01-000.00-363439"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"corresponding_author":["Duedahl-Olesen, Lene"],"keyword":["Analytical chemistry","Food Science","Mass spectrometry","Problem Solving Decision Making","Quantitative analysis","Upper Division Undergraduate"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"case study teaching for active learning on analytical quality assurance concepts in relation to food safety exposure assessment","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/262639653/ed_2021_00200g.R2_Proof_hi.pdf","version":"Authors Final Version"},"id":"S01-000.00-363439","identifier":[{"id":"85119077719","type":"scopus"}],"ids":["dtu-c50a1a7d-14fc-474a-9310-a13cfee1d4f0"],"keyword":["Analytical Chemistry","Food Science","Mass Spectrometry","Problem Solving/Decision Making","Quantitative Analysis","Upper-Division Undergraduate"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-68A3A924DD758C3FD105F050AFE702CD"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/262639653/ed_2021_00200g.R2_Proof_hi.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, National Food Institute","Technical University of Denmark, National Food Institute, Research Group for Analytical Food Chemistry"],"nora_code":"DI-U-DTU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Lene","key":"duedahlolesenpau","last":"Duedahl-Olesen","locid":"886d06e9-73a3-4df8-a0af-dc0dd8f96baa","name":"Duedahl-Olesen, Lene","orcid":"0000-0002-3162-0101","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Else","key":"holmfredpau","last":"Holmfred","locid":"bb29c50e-5f54-4bf4-b0e8-b95823a5ab21","name":"Holmfred, Else","orcid":"0000-0002-2451-0481","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Agnieszka Anna","key":"niklaspau","last":"Niklas","locid":"2ce01307-4d44-4504-99c2-e9b9bfe12094","name":"Niklas, Agnieszka Anna","orcid":"0000-0002-3395-3006","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Ida Kallehauge","key":"nielsenpau","last":"Nielsen","locid":"05e236cc-c821-4f86-905d-2a3fba4ea786","name":"Kallehauge Nielsen, Ida","name_org":"Nielsen, Ida Kallehauge","orcid":"0000-0003-0791-8925","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Jens Jørgen","key":"slothpau","last":"Sloth","locid":"d7fb8bd1-2626-48fa-b49e-35d57b2fae5d","name":"Sloth, Jens Jørgen","orcid":"0000-0002-3636-8769","rank":5,"rolecode":"pau"}],"pub":{"doi":"10.1021/acs.jchemed.1c00200","issn":["00219584","19381328"],"issn_org":["00219584"],"issue":"12","journal":"Journal of Chemical Education","pages":"3776-3783","publisher":"American Chemical Society","status":"p","title":"Journal of Chemical Education","volume":"98"},"review":"Peer Reviewed","scoID":["2-s2.0-85119077719"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-c50a1a7d-14fc-474a-9310-a13cfee1d4f0"],"src":["DTU Technical University of Denmark"],"title":"Case Study Teaching for Active Learning on Analytical Quality Assurance Concepts in Relation to Food Safety Exposure Assessment","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-363439","year":"2021","yearsub":"2021"}
{"abstract":"Nanostructuring allows altering of the electronic and photonic properties of two-dimensional (2D) materials. The efficiency, flexibility, and convenience of top-down lithography processes are, however, compromised by nanometer-scale edge roughness and resolution variability issues, which especially affect the performance of 2D materials. Here, we study how dry anisotropic etching of multilayer 2D materials with sulfur hexafluoride (SF6) may overcome some of these issues, showing results for hexagonal boron nitride (hBN), tungsten disulfide (WS2), tungsten diselenide (WSe2), molybdenum disulfide (MoS2), and molybdenum ditelluride (MoTe2). Scanning electron microscopy and transmission electron microscopy reveal that etching leads to anisotropic hexagonal features in the studied transition metal dichalcogenides, with the relative degree of anisotropy ranked as: WS2 > WSe2 > MoTe2 ∼MoS2. Etched holes are terminated by zigzag edges while etched dots (protrusions) are terminated by armchair edges. This can be explained by Wulff constructions, taking the relative stabilities of the edges and the AA′ stacking order into account. Patterns in WS2 are transferred to an underlying graphite layer, demonstrating a possible use for creating sub-10 nm features. In contrast, multilayer hBN exhibits no lateral anisotropy but shows consistent vertical etch angles, independent of crystal orientation. Using an hBN crystal as the base, ultrasharp corners can be created in lithographic patterns, which are then transferred to a graphite crystal underneath. We find that the anisotropic SF6 reactive ion etching process makes it possible to downsize nanostructures and obtain smooth edges, sharp corners, and feature sizes significantly below the resolution limit of electron beam lithography. The nanostructured 2D materials can be used themselves or as etch masks to pattern other nanomaterials.","author_count":9,"contributors":["Danielsen, Dorte Rubæk","Andersen, Anton Bay","Nielsen, Kirstine E.S.","Jessen, Bjarke S.","Booth, Tim","Doan, Manh Ha","Zhou, Yingqiu","Bøggild, Peter","Gammelgaard, Lene"],"cuid":["S01-000.00-370856"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["America, North","OECD"],"corresponding_author":["Bøggild, Peter"],"country":["United States"],"glorg":["All Global Affiliations","Columbia University"],"keyword":["2D materials","Anisotropic etching","Downsizing","Electron beam lithography","Nanostructuring","Reactive ion etching","TMDs","hBN"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-DTU"]},"level3all":["DI-U-DTU"]},"review":"pr","rtype":["clu"],"sorti":"super resolution nanolithography of two dimensional materials by anisotropic etching","src":["dtu"],"src-code":["DI-U-DTU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/264713441/Danielsen_2021_Nanoscale_Superresolution_nanolithography_.pdf","version":"Authors Final Version"},"funding_acknowledgement":["The authors thank Nicolas Stenger, Søren Raza, Antti-Pekka Jauho, and Mads Brandbyge for helpful discussions and Niels Pichon, Emil Duegaard, and Joachim Søderquist for assistance with preliminary experiments. This work was supported by the Danish National Research Foundation (DNRF) Center for Nanostructured Graphene (DNRF103) and EU Graphene Flagship Core 2 (785219) and Core 3 (881603)."],"id":"S01-000.00-370856","identifier":[{"id":"34431654","type":"pmid"},{"id":"85114641085","type":"scopus"}],"ids":["dtu-ddad4870-d023-46bb-a07a-6b685a4b54b0"],"keyword":["2D materials","Anisotropic etching","Downsizing","Electron beam lithography","Nanostructuring","Reactive ion etching","TMDs","Wulff constructions","hBN"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-6117E14D2F4DC2D6989ACB05873F037E"],"oa_link":[{"access":"oa","type":"loc","url":"https://backend.orbit.dtu.dk/ws/files/264713441/Danielsen_2021_Nanoscale_Superresolution_nanolithography_.pdf","version":"Authors Final Version"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","key":"dtu technical university of denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-DTU","l3nl":"Technical University of Denmark","l3nn":"DTU Technical University of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DTU Technical University of Denmark","namevar":["Technical University of Denmark, Department of Health Technology","Technical University of Denmark, Department of Physics"],"nora_code":"DI-U-DTU","used":1},{"affno":"2","country":"us","key":"columbia university","loc":["United States","America, North","OECD"],"name":"Columbia University","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Dorte R.","key":"danielsenpau","last":"Danielsen","locid":"52688cd7-b7e7-4d7b-a691-fed28a8d9bdf","name":"Danielsen, Dorte Rubæk","name_org":"Danielsen, Dorte R.","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Anton","key":"lyksborgandersenpau","last":"Lyksborg-Andersen","locid":"d0d4d5e6-aa12-4506-8786-9e032cedd106","name":"Andersen, Anton Bay","name_org":"Lyksborg-Andersen, Anton","orcid":"0000-0003-4908-8173","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Kirstine E.S.","key":"nielsenpau","last":"Nielsen","locid":"1ba647fb-b1cb-4284-b4d5-39ced4e10e59","name":"Nielsen, Kirstine E.S.","orcid":"0000-0002-8804-2488","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Bjarke S.","key":"jessenpau","last":"Jessen","name":"Jessen, Bjarke S.","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Timothy J.","key":"boothpau","last":"Booth","locid":"75457923-e280-4d32-867f-c474e503825b","name":"Booth, Tim","name_org":"Booth, Timothy J.","orcid":"0000-0002-9784-989X","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Manh Ha","key":"doanpau","last":"Doan","locid":"548b1498-d9a5-4f2e-8188-bbd54982c80e","name":"Doan, Manh Ha","orcid":"0000-0003-4371-4911","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Yingqiu","key":"zhoupau","last":"Zhou","locid":"9b8a5318-cc95-44ee-9cee-c009d2b245d2","name":"Zhou, Yingqiu","orcid":"0000-0003-1196-0819","rank":7,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Peter","key":"bøggildpau","last":"Bøggild","locid":"4e30e445-88ed-4600-9222-13845c0f32a7","name":"Bøggild, Peter","orcid":"0000-0002-4342-0449","rank":8,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Lene","key":"gammelgaardpau","last":"Gammelgaard","locid":"24e9835b-1288-420a-986a-abd435c026ed","name":"Gammelgaard, Lene","rank":9,"rolecode":"pau"}],"pmid":["34431654"],"pub":{"doi":"10.1021/acsami.1c09923","issn":["19448244","19448252"],"issn_org":["19448244"],"issue":"35","journal":"ACS Applied Materials and Interfaces","pages":"41886-41894","publisher":"American Chemical Society","status":"p","title":"ACS Applied Materials and Interfaces","volume":"13"},"review":"Peer Reviewed","scoID":["2-s2.0-85114641085"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Technical University of Denmark","Universities"],"PST":["Published"]},"sid":["dtu-ddad4870-d023-46bb-a07a-6b685a4b54b0"],"src":["DTU Technical University of Denmark"],"title":"Super-Resolution Nanolithography of Two-Dimensional Materials by Anisotropic Etching","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-370856","year":"2021","yearsub":"2021"}
{"abstract":"Persona is a technique for enhancing user understanding and improving the user-centered design of digital products. Persona creation has traditionally been divided into Qualitative, Quantitative, and Mixed Methods approaches. However, no literature systematically contrasts the strengths and weaknesses of these approaches. We review the literature to map the strengths and weaknesses of these approaches and evaluate the potential of personas for the domain of digital innovation. We provide insights for better creation and use of personas by both researchers and practitioners, especially those that are new to personas, deploying personas in a new domain, or familiar with only one of the persona creation approaches.","author_count":5,"contributors":["Jansen, Bernard J.","Jung, Soon-Gyo","Salminen, joni","Guan, Kathleen","Nielsen, Lene"],"cuid":["S01-000.00-384564"],"event":{"acronym":"HICSS","title":"Hawaii International Conference on System Sciences"},"filters":{"added":"2024-06","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["America, North","Asia, Middle East","OECD"],"country":["Qatar","United States"],"glorg":["All Global Affiliations","Georgetown University","Qatar Computing Research institute"],"keyword":["personas digital innovation"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"strengths and weaknesses of persona creation methods guidelines and opportunities for digital innovations","src":["itu"],"src-code":["DI-U-ITU"],"type":"dcp","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"rem","url":"https://scholarspace.manoa.hawaii.edu/bitstream/10125/71222/1/0488.pdf","version":"Published Version"},"id":"S01-000.00-384564","identifier":[{"id":"85105787973","type":"scopus"}],"ids":["itu-e035d0a4-a008-4f2a-b884-2eddf7d8be35"],"keyword":["personas, digital innovation"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-3-52394AA2428CAB113D6BCAAEF44CF36B"],"oa_link":[{"access":"oa","type":"loc","url":"https://pure.itu.dk/ws/files/85929562/Strengths_and_Weaknesses_HICSS_camera.pdf","version":"Authors Final Version"},{"access":"oa","license":"CC BY-NC-ND","type":"rem","url":"https://scholarspace.manoa.hawaii.edu/bitstream/10125/71222/1/0488.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"qa","key":"qatar computing research institute","loc":["Qatar","Asia, Middle East"],"name":"Qatar Computing Research institute","used":1},{"affno":"2","country":"us","key":"georgetown university","loc":["United States","America, North","OECD"],"name":"Georgetown University","used":1},{"affno":"3","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Digital Business Innovation, Information Systems and Digital Innovation"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Bernard J.","key":"jansenpau","last":"Jansen","name":"Jansen, Bernard J.","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Soon-Gyo","key":"jungpau","last":"Jung","name":"Jung, Soon-Gyo","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"joni","key":"salminenpau","last":"Salminen","name":"Salminen, joni","rank":3,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Kathleen","key":"guanpau","last":"Guan","name":"Guan, Kathleen","rank":4,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Lene","key":"nielsenpau","last":"Nielsen","locid":"1052b289-f510-4c5a-9662-2db48c12ebc2","name":"Nielsen, Lene","orci