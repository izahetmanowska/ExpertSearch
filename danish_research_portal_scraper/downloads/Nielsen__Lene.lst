y of Copenhagen","Universities"],"PST":["Published"]},"sid":["itu-b3b79cbe-54ca-4f7f-9ec9-a12f43117b75"],"src":["ITU IT University of Copenhagen"],"title":"Going Global with Personas","type":"Book Chapter","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-383883","year":"2013","yearsub":"2013"}
{"author_count":1,"contributors":["Nielsen, Lene Ryom"],"cuid":["S01-000.00-470316"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"1 contributor","cluster_size":1,"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"und","rtype":["clu"],"sorti":"chronic kidney disease in hiv positive persons contribution of traditional risk factors hiv and antiretrovial agents","src":["ku"],"src-code":["DI-U-KU"],"type":"do","type-grp":["all","pub"]},"id":"S01-000.00-470316","ids":["ku-80606b3b-50e4-44f0-a5c7-d9a41c4c98be"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Local-1-1-EE5AC5C1625541E49FD38892FC2DD7C4"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Immunology and Microbiology, CHIP"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Lene Ryom","key":"nielsenpau","last":"Nielsen","locid":"0087fd9d-3a4d-4da5-9f4d-2ba51ec7d7a8","name":"Nielsen, Lene Ryom","rank":1,"rolecode":"pau"}],"pub":{"pages":"60","publisher":"Eget forlag","status":"p"},"review":"Undetermined","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-80606b3b-50e4-44f0-a5c7-d9a41c4c98be"],"src":["KU University of Copenhagen"],"title":"Chronic Kidney Disease in HIV-Positive Persons; Contribution of Traditional Risk Factors, HIV and Antiretrovial Agents.","type":"Other","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-470316","year":"2013","yearsub":"2013"}
{"abstract":"Appropriate scaffolds capable of providing suitable biological and structural guidance are of great importance to generate cell-scaffold constructs for cell-based tissue engineering. The aim of the present study was to develop composite microparticles with a structure to provide functionality as a combined drug delivery/scaffold system. Composite microparticles were produced by incorporating either alginate/dermatan sulfate (Alg/DS) or alginate/chitosan/dermatan sulfate (Alg/CS/DS) particles in mPEG-PLGA microparticles using coaxial ultrasonic atomization. The encapsulation and distribution of Alg/DS or Alg/CS/DS particles in the mPEG-PLGA microparticles were significantly dependent on the operating conditions, including the flow rate ratio (Qout/Qin) and the viscosity of the polymer solutions (Vout, Vin) between the outer and the inner feeding channels. The core-shell composite microparticles containing the Alg/DS particles or the Alg/CS/DS particles displayed 40% and 65% DS release in 10 days, respectively, as compared to the DS directly loaded microparticles showing 90% DS release during the same time interval. The release profiles of DS correlate with the cell proliferation of fibroblasts, i.e. more sustainable cell growth was induced by the DS released from the core-shell composite microparticles comprising Alg/CS/DS particles. After seeding fibroblasts onto the composite microparticles, excellent cell adhesion was observed, and a successful assembly of the cell-scaffold constructs was induced within 7 days. Therefore, the present study demonstrates a novel strategy for fabrication of core-shell composite microparticles comprising additional particulate drug carriers in the core, which provides controlled delivery of DS and favorable cell biocompatibility; an approach to potentially achieve cell-based tissue regeneration.","author_count":6,"contributors":["Wen, Yanhong","Gallego, Monica Ramos","Nielsen, Lene Feldskov","Jørgensen, Lene","Møller, Eva Horn","Nielsen, Hanne Mørck"],"cuid":["S01-000.00-472241"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Alginates","Anticoagulants","Biocompatible Materials","Cell Adhesion","Cell Proliferation","Cells Cultured","Chitosan","Dermatan Sulfate","Drug Compounding","Drug Delivery Systems","Fibroblasts","Glucuronic Acid","Guided tissue regeneration","Hexuronic Acids","Humans","Materials Testing","Microspheres","Particle Size","Polyesters","Polyethylene Glycols","Solubility","Surface Properties","Tissue Scaffolds","Tissue engineering","Viscosity"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-PR","DI-U"],"level3":{"PR":["DI-PR-ALL","DI-PR-COLO"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-PR-COLO","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"design and characterization of core shell mpeg plga composite microparticles for development of cell scaffold constructs","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.ejpb.2013.03.027","version":"Other Version"},"id":"S01-000.00-472241","identifier":[{"id":"84882946258","type":"scopus"},{"id":"23958320","type":"pmid"}],"ids":["ku-83af023f-3d76-46de-aa9f-4afbb72a481b"],"keyword":["Alginates","Anticoagulants","Biocompatible Materials","Cell Adhesion","Cell Proliferation","Cells, Cultured","Chitosan","Dermatan Sulfate","Drug Compounding","Drug Delivery Systems","Fibroblasts","Glucuronic Acid","Guided Tissue Regeneration","Hexuronic Acids","Humans","Materials Testing","Microspheres","Particle Size","Polyesters","Polyethylene Glycols","Solubility","Surface Properties","Tissue Engineering","Tissue Scaffolds","Viscosity"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-4EBD061AB65EDE19B3988F6F1982C56E"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.ejpb.2013.03.027","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","country":"dk","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["University of Copenhagen"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"coloplast","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-COLO","l3nl":"Coloplast Group","l3nn":"Coloplast","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Coloplast","namevar":["Coloplast"],"nora_code":"DI-PR-COLO","used":1}],"person":[{"affno":"1","first":"Yanhong","key":"wenyanhongpau","last":"Wen","name":"Wen, Yanhong","rank":1,"rolecode":"pau"},{"affno":"2","first":"Monica Ramos","key":"gallegomonicaramospau","last":"Gallego","name":"Gallego, Monica Ramos","rank":2,"rolecode":"pau"},{"affno":"2","first":"Lene Feldskov","key":"nielsenlenefeldskovpau","last":"Nielsen","name":"Nielsen, Lene Feldskov","rank":3,"rolecode":"pau"},{"affno":"1","first":"Lene","key":"jørgensenlenepau","last":"Jorgensen","locid":"d44a0998-9a19-40de-8d46-eb4234a9d3c4","name":"Jørgensen, Lene","name_org":"Jorgensen, Lene","rank":4,"rolecode":"pau"},{"affno":"1","first":"Eva Horn","key":"møllerevahornpau","last":"Møller","locid":"c03cc7bd-ce8d-4cd8-9983-01e65a60aa4c","name":"Møller, Eva Horn","rank":5,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Hanne Mørck","key":"nielsenhannemørckpau","last":"Nielsen","locid":"7b0450b3-f634-47ec-912c-b07ecd943be8","name":"Nielsen, Hanne Mørck","orcid":"0000-0002-7285-9100","rank":6,"rolecode":"pau"}],"pmid":["23958320"],"pub":{"doi":"10.1016/j.ejpb.2013.03.027","issn":["09396411","18733441"],"issn_org":["09396411"],"issue":"1","journal":"European Journal of Pharmaceutics and Biopharmaceutics","pages":"87-98","status":"p","title":"European Journal of Pharmaceutics and Biopharmaceutics","volume":"85"},"review":"Peer Reviewed","scoID":["2-s2.0-84882946258"],"search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","Coloplast Group","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Private Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-83af023f-3d76-46de-aa9f-4afbb72a481b"],"src":["KU University of Copenhagen"],"title":"Design and characterization of core-shell mPEG-PLGA composite microparticles for development of cell-scaffold constructs","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-472241","year":"2013","yearsub":"2013"}
{"abstract":"OBJECTIVES: Knowledge about advanced chronic kidney disease (CKD) and end-stage renal disease (ESRD) in HIV-positive persons is limited. The aim of this study was to investigate incidence, predictors and outcomes for advanced CKD/ESRD and renal death. METHODS: Advanced CKD was defined as confirmed (two consecutive measurements ≥ 3 months apart) estimated glomerular filtration rate (eGFR) ≤ 30 mL/min/1.73 m(2) using Cockcroft-Gault, and ESRD as haemodialysis or peritoneal dialysis for ≥ 1 month or renal transplant. Renal death was death with renal disease as the underlying cause, using Coding Causes of Death in HIV (CoDe) methodology. Follow-up was from 1 January 2004 until last eGFR measurement, advanced CKD, ESRD or renal death, whichever occurred first. Poisson regression was used to identify predictors. RESULTS: Of 9044 individuals included in the study, 58 (0.64%) experienced advanced CKD/ESRD/renal death [incidence rate 1.32/1000 person-years of follow-up (PYFU); 95% confidence interval (CI) 0.98-1.66]; 52% of those who experienced the endpoint had a baseline eGFR ≤ 60 mL/min/1.73 m(2) compared with 3% of those who did not. Using Kaplan-Meier methods, at 6 years from baseline, 0.83% (95% CI 0.59-1.07%) were estimated to have experienced the endpoint overall and 11.26% (95% CI 6.75-15.78%) among those with baseline eGFR ≤ 60 mL/min/1.73 m(2) . Independent predictors of the endpoint included any cardiovascular event [incidence rate ratio (IRR) 2.16; 95% CI 1.24-3.77], lower eGFR (IRR 0.64 per 5 mL/min/1.73 m(2) ; 95% CI 0.59-0.70) and lower CD4 count (IRR 0.77 per doubling; 95% CI 0.62-0.95). One year after experiencing advanced CKD or ESRD, an estimated 19.21% (95% CI 7.84-30.58%) of patients had died, mostly from extra-renal causes. CONCLUSIONS: The incidence of advanced CKD/ESRD/renal death was low and predictors included traditional renal risk factors, HIV-related factors and pre-existing renal impairment. The prognosis following advanced CKD/ESRD was poor. Larger studies should address possible contributions of specific antiretrovirals.","author_count":11,"contributors":["Nielsen, Lene Ryom","Kirk, Ole","Lundgren, Jens","Reiss, P","Pedersen, Court","De Wit, S","Buzunova, S","Gasiorowski, J","Gatell, J M","Mocroft, A"],"cuid":["S02-090.09-768992"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corpau":["EuroSIDA in EuroCoord"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"advanced chronic kidney disease end stage renal disease and renal death among hiv positive individuals in europe","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1111/hiv.12038","version":"Other Version"},"id":"S02-090.09-768992","identifier":[{"id":"23590641","type":"pmid"},{"id":"84881314022","type":"scopus"}],"ids":["ku-8050fe9f-e568-4b7a-9950-ac433c32f256","sdu-72303557-d336-430c-9cba-16c777edbe22"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-3ACB2BFAFFB7C216FCF0D7FD0BD9CAC8"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1111/hiv.12038","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Immunology and Microbiology, CHIP"],"nora_code":"DI-U-KU","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Infectious Diseases (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":3,"key":"eurosida in eurocoord","name":"EuroSIDA in EuroCoord","role":"oau"}],"person":[{"affno":"1","first":"Lene Ryom","key":"nielsenpau","last":"Nielsen","locid":"0087fd9d-3a4d-4da5-9f4d-2ba51ec7d7a8","name":"Nielsen, Lene Ryom","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"L","key":"ryompau","last":"Ryom","name":"Ryom, L","rank":1,"rolecode":"pau"},{"affno":"1","first":"O","key":"kirkpau","last":"Kirk","locid":"67bce469-8913-44ac-8d6d-7dff1171c771","name":"Kirk, Ole","name_org":"Kirk, O","rank":2,"rolecode":"pau"},{"affno":"1","first":"J D","key":"lundgrenpau","last":"Lundgren","locid":"af310f7a-c49b-4381-bcb4-cf56e3fd80d8","name":"Lundgren, Jens","name_org":"Lundgren, J D","orcid":"0000-0001-8901-7850","rank":3,"rolecode":"pau"},{"affno":"","first":"P","key":"reisspau","last":"Reiss","name":"Reiss, P","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Court","key":"pedersenpau","last":"Pedersen","locid":"7f2e0dec-1687-4283-ac30-53e73c124437","name":"Pedersen, Court","rank":5,"rolecode":"pau"},{"affno":"","first":"S","key":"dewitpau","last":"De Wit","name":"De Wit, S","rank":6,"rolecode":"pau"},{"affno":"","first":"S","key":"buzunovapau","last":"Buzunova","name":"Buzunova, S","rank":7,"rolecode":"pau"},{"affno":"","first":"J","key":"gasiorowskipau","last":"Gasiorowski","name":"Gasiorowski, J","rank":8,"rolecode":"pau"},{"affno":"","first":"J M","key":"gatellpau","last":"Gatell","name":"Gatell, J M","rank":9,"rolecode":"pau"},{"affno":"","first":"A","key":"mocroftpau","last":"Mocroft","name":"Mocroft, A","rank":10,"rolecode":"pau"}],"pmid":["23590641"],"pub":{"doi":"10.1111/hiv.12038","issn":["14642662","14681293"],"issn_org":["14642662"],"issue":"8","journal":"HIV Medicine","pages":"503-508","publisher":"Wiley","status":"p","title":"HIV Medicine","volume":"14"},"review":"Peer Reviewed","scoID":["2-s2.0-84881314022"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-8050fe9f-e568-4b7a-9950-ac433c32f256","sdu-72303557-d336-430c-9cba-16c777edbe22"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Advanced chronic kidney disease, end-stage renal disease and renal death among HIV-positive individuals in Europe","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-090.09-768992","year":"2013","yearsub":"2013"}
{"abstract":"The process of becoming a geographer is by no means simple and incorporates huge amounts of disciplinary embodiment. This paper provides an example of how this is enacted by exploring the perceptions of fieldwork within the education of Danish geographers. Firstly, the history of education of Danish geographers is unfolded. Secondly, it is shown that despite quite different organisational structures, in terms of the way that fieldwork is introduced and the educational structure in general; only little variations in learning objectives can be identified between the three Danish universities that educate geographers. Thirdly, based on an empirical study of Danish university geographers, we find three different perceptions of fieldwork as a learning methodology: fieldwork as an outdoor laboratory, fieldwork as sensuous realisation and fieldwork as a meta-theoretical practice. The results show that these three perceptions are not allocated to different academics or traditions, meaning that the individual researcher often encompasses more than one view of fieldwork either in relation to his or her own research or in relation to the education of future geographers. The categories of fieldwork presented, therefore, do not support the often claimed dichotomy between physical and human geography. Instead, the openness of geography as a synthesis discipline is found.","author_count":3,"contributors":["Grindsted, Thomas","Madsen, Lene Møller","Nielsen, Thomas Theis"],"cuid":["S02-095.71-042140"],"filters":{"added":"2021-10","altsrc":["No Matches Found"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"keyword":["Denmark"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU","DI-U-RUC"]},"level3all":["DI-U-KU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"one just better understands when standing out there fieldwork as a learning methodology in university education of danish geographers","src":["ku","ruc"],"src-code":["DI-U-KU","DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/40395777/Gindsted_M_ller_og_Nielsen_2013_One_better_understand_when_standing_out_there.pdf","version":"Pre-print"},"id":"S02-095.71-042140","ids":["ku-4a2b8832-a8f5-4959-b3f4-77f317ebb0c1","ruc-a8ded50a-dfdf-42c3-b19a-24f54cdcdab6"],"keyword":["Denmark","Perceptions of fieldwork,","learning methodology,","university level,"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Local-1-2-CBD3418C5A3BE92E24531841C04F2AE6"],"oa_link":[{"access":"oa","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/40395777/Gindsted_M_ller_og_Nielsen_2013_One_better_understand_when_standing_out_there.pdf","version":"Pre-print"}],"oai":{"class":"Realised","mra":["Science / Technology (SCI)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University, Department of People and Technology, Space, Place, Mobility and Urban Studies","Roskilde University, The Department of Environmental, Social and Spatial Change"],"nora_code":"DI-U-RUC","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Science Education","Københavns Universitet, Faculty of Science, Department of Science Education, Equity in Science Education","Københavns Universitet, Faculty of Science, Department of Science Education, University Science Education"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","country":"dk","first":"Thomas Skou","key":"grindstedpau","last":"Grindsted","locid":"35eefe63-fc31-4be3-a97d-548000807dc5","name":"Grindsted, Thomas Skou","orcid":"0000-0002-6528-3166","rank":1,"rolecode":"pau"},{"affno":"2","country":"dk","first":"Lene Møller","key":"madsenpau","last":"Madsen","locid":"dda148da-5b6d-4f4e-ab60-b7cf85637829","name":"Madsen, Lene Møller","orcid":"0000-0001-7149-9142","rank":2,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Thomas Theis","key":"nielsenpau","last":"Nielsen","locid":"7720df43-0a90-48d4-9d38-0667f3a11654","name":"Nielsen, Thomas Theis","orcid":"0000-0002-8134-3456","rank":3,"rolecode":"pau"}],"pub":{"issn":["21460353"],"issue":"1","journal":"Review of International Geographical Education Online","pages":"8-25","status":"p","title":"Review of International Geographical Education Online","volume":"3"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Roskilde University","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-4a2b8832-a8f5-4959-b3f4-77f317ebb0c1","ruc-a8ded50a-dfdf-42c3-b19a-24f54cdcdab6"],"src":["KU University of Copenhagen","RUC Roskilde University"],"title":"‘One just better understands.....when standing out there’: Fieldwork as a Learning Methodology in University Education of Danish Geographers","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-095.71-042140","year":"2013","yearsub":"2013"}
{"abstract":"The aim of the study was to systematically investigate the effect of craniofacially evoked conditioned pain modulation on somatosensory function using a quantitative sensory testing (QST) protocol applied to the trigeminal area in healthy humans. Pressure pain evoked by a mechanical compressive device was applied as conditioning stimulus (CS) in the craniofacial region, with a pain intensity of 5 on a visual analogue scale (VAS: 0-10cm) (painful session) or with VAS score of 0 (control session). A full QST battery of 13 parameters was performed as test stimuli on the dominant-side cheek. The individual QST data from 11 men and 12 women were transformed into z scores, and the QST data and z scores were tested using analyses of variance. Analyses of variance of pressure pain threshold (PPT) data (log-transformed values and z scores) indicated significant session (P⩽.003) and time (P","author_count":5,"contributors":["Oono, Yuka","Baad-Hansen, Lene","Wang, Kelun","Arendt-Nielsen, Lars","Svensson, Peter"],"cuid":["S02-098.84-004403"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["Unspecified organisation"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AAU","DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"effect of conditioned pain modulation on trigeminal somatosensory function evaluated by quantitative sensory testing","src":["aau","au"],"src-code":["DI-U-AAU","DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.pain.2013.07.049","version":"Other Version"},"id":"S02-098.84-004403","identifier":[{"id":"000327596200017","type":"wos"},{"id":"23911699","type":"pmid"},{"id":"84889097587","type":"scopus"}],"ids":["aau-5a3bd231-62cb-47f9-8931-ad8799a298ba","au-dee6e4e4-be05-4144-a50a-2b46f131b20b"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-3007AFA3D3A9542D700CE3AC7F2A6AEB"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1016/j.pain.2013.07.049","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology","Aalborg University, The Faculty of Medicine, Department of Health Science and Technology, Center for Sensory-Motor Interaction"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["Unspecified organisation"],"nora_code":"DI-OT","used":1},{"affno":"3","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Dentistry and Oral Health, Department of Dentistry and Oral Health - Section for Orofacial Pain and Jaw Function"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"Yuka","key":"oonopau","last":"Oono","locid":"f02e0279-7c23-4e3f-801a-6a0afeb4ef40","name":"Oono, Yuka","rank":1,"rolecode":"pau"},{"affno":"3 2","corresponding":null,"country":"dk","first":"Lene","key":"baadhansenpau","last":"Baad-Hansen","locid":"6938b236-4958-4da7-bbeb-dccb0abc973c","name":"Baad-Hansen, Lene","orcid":"0000-0002-2399-7