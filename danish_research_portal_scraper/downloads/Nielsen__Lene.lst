-49fe-8cf4-3a00220d8dcc","name":"Frederiksen, Mikael","rank":11,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Bo Amdi","key":"jensenboamdipau","last":"Jensen","name":"Jensen, Bo Amdi","rank":12,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Carsten","key":"hellebergcarstenpau","last":"Helleberg","name":"Helleberg, Carsten","rank":13,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Anne Kjærsgaard","key":"mylinannekjærsgaardpau","last":"Mylin","name":"Mylin, Anne Kjærsgaard","rank":14,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Niels","key":"abildgaardnielspau","last":"Abildgaard","locid":"595418b9-29f8-4fd3-8663-1b32eab3451a","name":"Abildgaard, Niels","orcid":"0000-0001-6852-2014","rank":15,"rolecode":"pau"},{"affno":"1 7","corresponding":null,"first":"Lene","key":"kongsgaardnielsenlenepau","last":"Kongsgaard Nielsen","locid":"621d166f-6298-48ed-9f2d-d8d52bb40446","name":"Kongsgaard Nielsen, Lene","orcid":"0000-0003-2083-3870","rank":16,"rolecode":"pau"}],"pub":{"publisher":"Danish Comprehensive Cancer Center","status":"p","title":"Danske Kræftforskningsdage 2021 Abstract Book"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Region Zealand","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-8ec08a67-a8fd-45e0-8781-3a2dc84f1d58"],"src":["SDU University of Southern Denmark"],"title":"How does the COVID-19 pandemic affect the quality of life reportings of Danish patients with multiple myeloma?","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-614117","year":"2021","yearsub":"2021"}
{"abstract":"Background: Studies have shown poor post-discharge implementation by the general practitioner of changes made to patients’ medication during admission. Objective: To assess the feasibility of conducting telephone conferences delivering information about changes in older patients’ medications from hospital to general practitioners. Setting: Two departments of geriatric medicine in a Danish routine healthcare setting. Method: Older polypharmacy patients (≥ 65 years and ≥ 5 prescriptions) consecutively admitted were eligible for inclusion. Telephone conferences based on a review of these patient’s medication therapy during hospital stay were arranged between a pharmacist and a geriatrician from the hospital, and a general practitioner. Interviews were conducted with pharmacists, geriatricians, and general practitioners about their perspectives on the feasibility of telephone conferences. Interviews were analyzed using systematic text condensation. Main outcome measure: The proportion of telephone conferences conducted and perspectives on the feasibility of the study. Results: A total of 113 patients were included and 82 patients (75%) were eligible for telephone conferences. A total of 40 (49%) telephone conferences were conducted. The main reasons for conferences not being conducted were general practitioners not wanting to participate or not returning the calls from the pharmacists. Three themes emerged from the qualitative analysis: considerations on planning and running the project, Barriers, facilitators, and implications of the telephone conference, and Actual and desirable cross-sectorial communication. Conclusion: Telephone conferences were only possible for half of the patients. The participating general practitioners, pharmacists and geriatricians expressed varied benefit and agreed that telephone conferences were mainly relevant for complex patients.","author_count":9,"contributors":["Ravn-Nielsen, Lene Vestergaard","Burghle, Alaa","Christensen, Palle Mark","Coric, Faruk","Graabæk, Trine","Henriksen, Jolene Pilegaard","Karlsdottir, Fjola","Rosholm, Jens-Ulrik","Pottegård, Anton"],"cuid":["S01-000.00-639707"],"filters":{"added":"2022-03","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"corresponding_author":["Ravn-Nielsen, Lene Vestergaard"],"keyword":["Continuity of care","Medication review","Multimorbidity"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-OT","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-SDR"],"OT":["General Practitioner"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-SDR","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"multidisciplinary telephone conferences about medication therapy after discharge of older inpatients a feasibility study","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85104563377","version":"Other Version"},"id":"S01-000.00-639707","identifier":[{"id":"33847841","type":"pmid"},{"id":"85104563377","type":"scopus"}],"ids":["sdu-e844b8d4-b6d9-4f4c-a6ec-6adb21ae6fea"],"keyword":["Continuity of care","Medication review","Multidisciplinary communication","Multimorbidity","Telephone conferences"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-5C0DC42DC96F1F506FE0BF997E8F0BCF"],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"dk","key":"region of southern denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","used":1},{"affno":"2","country":"dk","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["University of Southern Denmark"],"nora_code":"DI-U-SDU","used":1},{"affno":"3","country":"dk","key":"miscellaneous","l2":"DI-OT","l2n":"Miscellaneous","l3":"DI-OT","l3nl":"Other Research","l3nn":"Miscellaneous","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Miscellaneous","namevar":["General Practitioner"],"nora_code":"DI-OT","used":1}],"person":[{"affno":"1 2","corresponding":null,"first":"Lene Vestergaard","key":"ravnnielsenpau","last":"Ravn-Nielsen","name":"Ravn-Nielsen, Lene Vestergaard","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Alaa Hassan","key":"burghlepau","last":"Burghle","locid":"ed1202aa-ff4c-410a-9475-f6fd10528b20","name":"Burghle, Alaa","name_org":"Burghle, Alaa Hassan","orcid":"0000-0002-3759-7993","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Palle Mark","key":"christensenpau","last":"Christensen","name":"Christensen, Palle Mark","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Faruk","key":"coricpau","last":"Coric","name":"Coric, Faruk","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Trine","key":"graabækpau","last":"Graabæk","locid":"67e97b89-6918-4950-9557-f5e3939a3c57","name":"Graabæk, Trine","orcid":"0000-0001-6848-3107","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jolene Pilegaard","key":"henriksenpau","last":"Henriksen","name":"Henriksen, Jolene Pilegaard","rank":6,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Fjola","key":"karlsdottirpau","last":"Karlsdottir","name":"Karlsdottir, Fjola","rank":7,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Jens-Ulrik","key":"rosholmpau","last":"Rosholm","locid":"42011e4d-4ddc-4850-bf2b-1fba8b412125","name":"Rosholm, Jens-Ulrik","orcid":"0000-0003-4730-467X","ran