au","last":"Vangsted","name":"Vangsted, Annette","rank":8,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Fredrik","key":"schjesvoldpau","last":"Schjesvold","name":"Schjesvold, Fredrik","rank":9,"rolecode":"pau"},{"affno":"2 8 1 9","corresponding":null,"country":"dk","first":"Lene Kongsgaard","key":"nielsenpau","last":"Nielsen","locid":"897c29d3-45a2-4178-81b1-b0ba61db5a25","name":"Kongsgaard Nielsen, Lene","name_org":"Nielsen, Lene Kongsgaard","orcid":"0000-0003-2083-3870","rank":10,"rolecode":"pau"}],"pmid":["39638553"],"pub":{"doi":"10.1111/ejh.14358","issn":["09024441","09024506"],"issn_org":["09024506"],"issue":"3","journal":"European Journal of Haematology","pages":"517-527","publisher":"Wiley-Blackwell Publishing Ltd","status":"p","title":"European Journal of Haematology","volume":"114"},"review":"Peer Reviewed","scoID":["2-s2.0-85210995772"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-063b7cfa-94c8-4baa-9057-800342db8809","sdu-9173256f-6496-479b-b8dd-2857e0c55df7"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Health-Related Quality of Life During Carfilzomib-Lenalidomide-Dexamethasone Consolidation : Findings From the Multiple Myeloma CONPET Study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-087.27-793127","year":"2025","yearsub":"2025"}
{"abstract":"PURPOSE: In 2019, an initiative to reduce sickness absence in public sector workplaces in Denmark was introduced. The initiative involved appointing a sickness absence coordinator (SA coordinator) to oversee the implementation of workplace-based sickness absence interventions. Since the role of the SA coordinator is a novel concept introduced as part of the initiative, this study investigates the responsibilities of SA coordinators and the challenges they experienced in fulfilling this role during the implementation process. METHODS: Semi-structured interviews with and observations of SA coordinators from four public sector workplaces were carried out. We collected the first four interviews and observations during the implementation process with follow-up interviews collected at the end of the process. The data were analyzed using thematic analysis. RESULTS: The SA coordinators all experienced challenges in terms of lack of commitment among the line managers to participate in the intervention. They experienced being seen as a burden rather than a helping hand, and felt that the line managers might have difficulty recognizing the value of the SA coordinators. Potential ways to improve the collaboration between the SA coordinators and the line managers include considering hiring the SA coordinator in-house and incorporation of intervention components into existing activities to accommodate the busyness of the line managers. CONCLUSIONS: To support the SA coordinators in carrying out their role and responsibilities, this study suggests that it is important to ensure commitment to the role, especially among the line managers in order to enhance good working relationships.","author_count":4,"contributors":["Rasmussen, Lene","Nielsen, Maj Britt Dahl","Garde, Anne Helene","Kristiansen, Jesper"],"cuid":["S02-093.26-793962"],"filters":{"added":"2025-01","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"corresponding_author":["Rasmussen, Lene"],"keyword":["Absenteeism","Denmark","Female","Humans","Implementation","Implementering","Intervention","Interviews as Topic","Male","Professional Role","Public Sector organization administration","Qualitative Research","Rehabilitation","Return to work","Sick Leave","Sygefravær","Workplace","Workplace organization administration"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-WORK"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-GV-WORK","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"exploring the role of sickness absence coordinators in implementing interventions to reduce sickness absence in public sector workplaces in denmark","src":["nfa","sdu"],"src-code":["DI-GV-WORK","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s10926-024-10183-1","version":"Published Version"},"id":"S02-093.26-793962","identifier":[{"id":"85188341688","type":"scopus"},{"id":"38519778","type":"pmid"},{"id":"PMC11839793","type":"pmcid"}],"ids":["nfa-5e8c1b3b-316f-4910-8cb7-4a6b0b50d017","sdu-efd5e25b-2974-42e2-b9f9-42f329eaaa21"],"keyword":["Absenteeism","Denmark","Female","Humans","Implementation","Intervention","Interviews as Topic","Male","Professional Role","Public Sector/organization & administration","Qualitative Research","Rehabilitation","Return to work","Sick Leave","Sygefravær","Workplace","Workplace/organization & administration","implementering"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-58C221D14EEA68E2E2D26FBC0C4B78F6"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1007/s10926-024-10183-1","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/285722763/s10926-024-10183-1.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"nfa national research centre for the working environment","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-WORK","l3nn":"NFA National Research Centre for the Working Environment","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"NFA National Research Centre for the Working Environment","namevar":["The National Research Centre for the Working Environment","The National Research Centre for the Working Environment, Directors, Psychosocial Working Environment and Working Accidents and Safety Culture"],"nora_code":"DI-GV-WORK","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, National Institute of Public Health","SDU, The Faculty of Health Sciences, National Institute of Public Health, Mental health"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lene","key":"rasmussenpau","last":"Rasmussen","locid":"0d8ad03f-8294-49a2-8bb7-fea40eccf25a","name":"Rasmussen, Lene","orcid":"0000-0002-7864-4178","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Maj Britt Dahl","key":"nielsenpau","last":"Nielsen","locid":"9dfb8e84-90f3-4531-b486-2df21e9ecd3a","name":"Nielsen, Maj Britt Dahl","orcid":"0000-0002-5758-8031","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anne Helene","key":"gardepau","last":"Garde","locid":"8e894baf-467c-45d3-8abe-41a805b30b22","name":"Garde, Anne Helene","orcid":"0000-0002-1553-2291","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper","key":"kristiansenpau","last":"Kristiansen","locid":"2b90a97c-15d6-468c-a8d6-1362e731d2bc","name":"Kristiansen, Jesper","orcid":"0000-0002-1637-8900","rank":4,"rolecode":"pau"}],"pmid":["38519778"],"pub":{"doi":"10.1007/s10926-024-10183-1","issn":["10530487","15733688"],"issn_org":["10530487"],"issue":"1","journal":"Journal of Occupational Rehabilitation","pages":"78-87","publisher":"Springer New York","status":"p","title":"Journal of Occupational Rehabilitation","volume":"35"},"review":"Peer Reviewed","scoID":["2-s2.0-85188341688"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["nfa-5e8c1b3b-316f-4910-8cb7-4a6b0b50d017","sdu-efd5e25b-2974-42e2-b9f9-42f329eaaa21"],"src":["NFA National Research Centre for the Working Environment","SDU University of Southern Denmark"],"title":"Exploring the Role of Sickness Absence Coordinators in Implementing Interventions to Reduce Sickness Absence in Public Sector Workplaces in Denmark","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-093.26-793962","year":2025,"yearsub":2025}
{"abstract":"The projected growth of Aquaculture requires continuous optimisation of feeding regimes, especially in enhancing disease resilience through immunostimulating feed supplements. Seaweed has been introduced as a promising supplement due to its proposed immunostimulant effects, while mitigating carbon emissions and marine eutrophication. Two separate growth trials were performed to evaluate the effects of a seaweed supplement, focusing on a closed land-based RAS system with fish growing from ∼300–600 g and an open water net-based trial with fish growing from ∼500–2500 g. A multi-omics approach was taken to investigate the effect of using up to 2 % fermented sugar kelp (Saccharina latissima) as a supplement on the growth performance and gut health of Atlantic salmon (Salmo salar L.). Standard growth metrics and quality indicators were coupled with multi-omics data for the host intestinal transcriptome, intestinal metabolome, and intestinal microbiome. Levels of iodine and heavy metals in the fish fillets resulting from seaweed inclusion were evaluated. Seaweed additives up to 2 % had no negative impact on the salmon growth performance or other health parameters. While concentration of iodine increased with seaweed addition, all levels remain below recommended thresholds. Furthermore, gut transcriptome analyses of 179 individuals revealed multiple indications for an immunostimulant effect of seaweed, including overexpression of the mucin biosynthesis and pyrimidine metabolism pathways related to mucus production and intestinal homeostasis. Genome-resolved metagenomics revealed a core microbiome dominated by Mycoplasma, Photobacterium, and Brevinema species. Interestingly, the assembled genomes of these three core species had consistently higher levels of genome erosion and gene loss compared to other present species suggesting host adaptation. Further, reduced prevalence of known pathogens such as Aliivibrio highlights a potential protective effect of seaweed by impeding growth of opportunistic pathogens. Results suggest that supplementation of up to 2 % fermented seaweed can increase feed efficiency, stabilise the intestinal microbiome and potentially increase resistance against known pathogenic bacteria including Aliivibrio species.","author_count":18,"contributors":["Rasmussen, Jacob Agerbo","Bernhard, Annette","Lecaudey, Laurène A.","Kale, Varsha","Baldi, Germana","Myrmel, Lene S.","Hansen, Martin","Brealey, Jaelle C.","Mak, Sarah S. T.","Nielsen, Ida Broman","Richardson, Lorna","Madsen, Lise","Kristiansen, Karsten","Gilbert, M. Thomas P.","Martin, Michael D.","Finn, Robert D.","Sveier, Harald","Limborg, Morten T."],"cuid":["S02-100.00-793119"],"filters":{"added":"2025-02","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["Europe, EU","Europe, Non-EU","Nordic","OECD"],"corresponding_author":["Limborg, Morten T."],"country":["Germany","Norway"],"glorg":["All Global Affiliations","European Molecular Biology Laboratory","European Molecular Biology Laboratory (EMBL)","Institute of Marine Research","Lerøy Seafood Group","Lerøy Seafood Group ASA","Norwegian Institute for Nature Research","Norwegian University of Science and Technology","SINTEF","University of Bergen"],"keyword":["Aquaculture","Atlantic salmon","Host microbe interactions","Immunostimulants","Multi omics","Seaweed"],"level":"sci","mra":["med","sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU","DI-U-KU"]},"level3all":["DI-U-AU","DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"a holo omics analysis shows how sugar kelp can boost gut health in atlantic salmon","src":["au","ku"],"src-code":["DI-U-AU","DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85210131921","version":"Other Version"},"id":"S02-100.00-793119","identifier":[{"id":"85210131921