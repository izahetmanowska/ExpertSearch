ut","rank":10,"rolecode":"pau"},{"affno":"8","first":"Peter","key":"høghpau","last":"Høgh","locid":"3b631d68-068c-4a5f-8b9b-3b00b90a4ebc","name":"Høgh, Peter","rank":11,"rolecode":"pau"},{"affno":"8 4","first":"Finn","key":"sellebjergpau","last":"Sellebjerg","locid":"4cbcdba1-9f69-4103-b595-68788ee7aacc","name":"Sellebjerg, Finn","rank":12,"rolecode":"pau"},{"affno":"9","first":"Richard","key":"reynoldspau","last":"Reynolds","name":"Reynolds, Richard","rank":13,"rolecode":"pau"},{"affno":"2 1","corresponding":null,"country":"dk","first":"Jan","key":"baumbachpau","last":"Baumbach","locid":"fad9963e-68b0-4cea-a07a-003140f03d38","name":"Baumbach, Jan","orcid":"0000-0002-0282-0462","rank":14,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"Martin R.","key":"larsenpau","last":"Larsen","locid":"4ecd87f8-6fb1-4d10-b8a3-6d0657129eef","name":"Larsen, Martin Røssel","name_org":"Larsen, Martin R.","orcid":"0000-0001-6203-0123","rank":15,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Zsolt","key":"illespau","last":"Illes","locid":"3e0aeebb-ee40-4c3d-9cee-47e786e6f12e","name":"Illes, Zsolt","orcid":"0000-0001-9655-0450","rank":16,"rolecode":"pau"}],"pmid":["33603109"],"pub":{"doi":"10.1038/s41598-021-83591-5","issn":["20452322"],"journal":"Scientific Reports","paperid":"4132","publisher":"Nature Publishing Group","status":"p","title":"Scientific Reports","volume":"11"},"review":"Peer Reviewed","scoID":["2-s2.0-85101239393"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-563df02b-e51b-47cc-ae83-d090013adbc0","sdu-ab31e8bc-ee78-4dba-857b-e6bfa4aae695"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"CSF proteome in multiple sclerosis subtypes related to brain lesion transcriptomes","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-042542","year":"2021","yearsub":"2021"}
{"abstract":"Serological assays for severe acute respiratory syndrome coronavirus 2 (SARS-CoV-2) are needed to support clinical diagnosis and epidemiological investigations. Recently, assays for large-scale detection of total antibodies (Ab), immunoglobulin G (IgG), and IgM against SARS-CoV-2 antigens have been developed, but there are limited data on the diagnostic accuracy of these assays. This study was a Danish national collaboration and evaluated 15 commercial and one in-house anti-SARSCoV-2 assays in 16 laboratories. Sensitivity was evaluated using 150 samples from individuals with asymptomatic, mild, or moderate COVID-19, nonhospitalized or hospitalized, confirmed by nucleic acid amplification tests (NAAT); samples were collected 13 to 73days either from symptom onset or from positive NAAT (patients without symptoms). Specificity and cross-reactivity were evaluated in samples collected prior to the SARS-CoV-2 epidemic from .586 blood donors and patients with autoimmune diseases, cytomegalovirus or Epstein-Barr virus infections, and acute viral infections. A specificity of $99% was achieved by all total-Ab and IgG assays except one, DiaSorin Liaison XL IgG (97.2%). Sensitivities in descending order were Wantai ELISA total Ab (96.7%), CUH-NOVO in-house ELISA total Ab (96.0%), Ortho Vitros total Ab (95.3%), YHLO iFlash IgG (94.0%), Ortho Vitros IgG (93.3%), Siemens Atellica total Ab (93.2%), Roche Elecsys total Ab (92.7%), Abbott Architect IgG (90.0%), Abbott Alinity IgG (median 88.0%), DiaSorin Liaison XL IgG (median 84.6%), Siemens Vista total Ab (81.0%), Euroimmun/ELISA IgG (78.0%), and Snibe Maglumi IgG (median 78.0%). However, confidence intervals overlapped for several assays. The IgM results were variable, with the Wantai IgM ELISA showing the highest sensitivity (82.7%) and specificity (99%). The rate of seropositivity increased with time from symptom onset and symptom severity.","author_count":50,"contributors":["Harritshøj, Lene H.","Gybel-Brask, Mikkel","Afzal, Shoaib","Kamstrup, Pia R.","Jørgensen, Charlotte S.","Thomsen, Marianne Kragh","Hilsted, Linda","Friis-Hansen, Lennart","Szecsi, Pal B.","Pedersen, Lise","Nielsen, Lene","Hansen, Cecilie B.","Garred, Peter","Korsholm, Trine Line","Mikkelsen, Susan","Nielsen, Kirstine O.","Møller, Bjarne K.","Hansen, Anne T.","Iversen, Kasper K.","Nielsen, Pernille B.","Hasselbalch, Rasmus B.","Fogh, Kamille","Norsk, Jakob B.","Kristensen, Jonas Henrik","Schønning, Kristian","Kirkby, Nikolai S.","Nielsen, Alex C.Y.","Landsy, Lone H.","Loftager, Mette","Holm, Dorte K.","Nilsson, Anna C.","Sækmose, Susanne G.","Grum-Schwensen, Birgitte","Aagaard, Bitten","Jensen, Thøger G.","Nielsen, Dorte M.","Ullum, Henrik","Dessau, Ram B."],"cuid":["S04-098.03-011927"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"corresponding_author":["Harritshøj, Lene H."],"keyword":["Anti SARS CoV 2 serology assay","Covid 19","Evaluation","SARS CoV 2 antibody test"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-NP","DI-PR","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA"],"NP":["DI-NP-ALL","DI-NP-NOVO"],"PR":["DI-PR-ALL","DI-PR-NOVO"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-HO-SDR","DI-HO-ZEA","DI-NP-NOVO","DI-PR-NOVO","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"comparison of 000000000016 serological sars cov 000000000002 immunoassays in 000000000016 clinical laboratories","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC8091860/pdf/JCM.02596-20.pdf","version":"Published Version"},"funding_acknowledgement":["The development of the CUH-NOVO SARS-CoV-2 total-Ab ELISA was financially supported by grants from the Carlsberg Foundation (CF20-0045) and the Novo Nordisk Foundation (205A0063505)."],"id":"S04-098.03-011927","identifier":[{"id":"33574119","type":"pmid"},{"id":"000642114500010","type":"wos"},{"id":"PMC8091860","type":"pmcid"},{"id":"85105112647","type":"scopus"}],"ids":["aau-fa4ce4fa-1311-4d1f-a757-71041f9d21d8","au-c651d194-916b-41ef-9baf-7f3fd255e366","ku-78eef334-15b5-49f6-8867-12c110ade2d4","sdu-d87aa66b-92a5-4c9c-9284-80850bf2785d"],"keyword":["Anti-SARS-CoV-2 serology assay","COVID-19","Evaluation","SARS-CoV-2 antibody test"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-7-13C196F475D7C90EFABBED7FF2F933EA"],"oa_link":[{"access":"oa","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/182822398/Journal_of_Clinical_Microbiology_2021_Harritsh_j_JCM.02596_20.full.pdf","version":"Authors Final Version"},{"access":"oa","license":"Ikke-specificeret","type":"loc","url":"https://curis.ku.dk/ws/files/262802127/Journal_of_Clinical_Microbiology_2021_Harritsh_j_JCM.02596_20.full.pdf","version":"Authors Final Version"},{"access":"oa","type":"rem","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC8091860/pdf/JCM.02596-20.pdf","version":"Published Version"},{"access":"oa","type":"rem","url":"https://www.medrxiv.org/content/10.1101/2020.07.30.20165373v1","version":"Pre-print"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2021","yearSub":"2021"},"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Rigshospitalet, Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI