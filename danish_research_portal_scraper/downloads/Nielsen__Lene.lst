rolecode":"pau"},{"affno":"2 3","corresponding":null,"country":"dk","first":"Julie","key":"jacobsenpau","last":"Jacobsen","locid":"20286b2f-33c3-46ab-afb9-053a29b1905f","name":"Jacobsen, Julie Sandell","name_org":"Jacobsen, Julie","orcid":"0000-0002-3323-3631","rank":4,"rolecode":"pau"},{"affno":"2 1","corresponding":null,"country":"dk","first":"Lene Gissel","key":"rasmussenpau","last":"Rasmussen","locid":"09dbbcf4-a99a-4d25-a01c-800a7b767113","name":"Rasmussen, Lene Gissel","orcid":"0000-0002-7828-5697","rank":5,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Lasse Greve","key":"hansenpau","last":"Hansen","name":"Hansen, Lasse Greve","rank":5,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Lasse","key":"grevehansenpau","last":"Greve Hansen","name":"Greve Hansen, Lasse","rank":6,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"R.O.","key":"nielsenpau","last":"Nielsen","locid":"2d1ea8cb-28f5-48df-baa8-9724c2e17005","name":"Nielsen, Rasmus Oestergaard","name_org":"Nielsen, R.O.","orcid":"0000-0001-5757-1806","rank":7,"rolecode":"pau"}],"pub":{"doi":"10.1093/eurpub/ckad133.113","issn":["11011262","1464360X"],"issn_org":["11011262"],"issue":"Suppl. 1","journal":"European Journal of Public Health","pages":"45","publisher":"Oxford University Press","status":"p","title":"European Journal of Public Health","volume":"33"},"review":"Peer Reviewed","search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","All University Colleges","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","Miscellaneous","Other Research","Universities","University Colleges","VIA University College"],"PST":["Published"]},"sid":["au-124602e4-b631-424d-bd26-a5f54f5e60ab","via-a1b04c7c-3f00-4e4c-b48e-a99d9e6ed136"],"src":["AU Aarhus University","VIA University College"],"title":"Who are suitable targets for a social prescribing intervention addressing physical activity? A survey-based study including viewpoints from general practitioners","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-084.88-703979","year":"2023","yearsub":"2023"}
{"abstract":"In this chapter, the authors argue that when service design is introduced into an organization, it is not only the product that is transformed, but also the organization itself. The authors use the term \"material\" to refer to \"that which is being changed\" and in this case, it is the organization. The authors draw on their own experiences as design researchers in an organization and combine them with insights from interviews with professional designers and managers to understand the involvement of professional designers and the applied design methods in IT development projects. They argue that the introduction and use of service design artefacts initiates a change in the material, the organization, and explore how these artefacts not only orchestrate a service experience but also support a change in mindset and focus that influences the organization. They show how artefacts simultaneously represent the present 'what is' and propose a future 'what could become' through three distinct but interrelated stages: collecting, abstracting, selecting, and reframing, and anchoring, presenting, and awakening.","author_count":6,"contributors":["Harre, Olivia Thomassen","Nielsen, Lene"],"cuid":["S02-090.08-724181"],"filters":{"added":"2024-02","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"keyword":["Organisational aspects","Service Design"],"level":"sci","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-AAU","DI-U-ALL","DI-U-ITU"]},"level3all":["DI-U-AAU","DI-U-ITU"]},"review":"pr","rtype":["clu"],"sorti":"organisations as material","src":["aau","itu"],"src-code":["DI-U-AAU","DI-U-ITU"],"type":"dba","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://vbn.aau.dk/en/publications/6a02de30-9b4e-437b-9593-6dc2c3fd66c5","version":"Other Version"},"id":"S02-090.08-724181","identifier":[{"id":"85192736730","type":"scopus"},{"id":"85192725082","type":"scopus"}],"ids":["aau-6a02de30-9b4e-437b-9593-6dc2c3fd66c5","itu-fed21b0d-8231-40e9-8329-ea7b5f034ed8"],"keyword":["organisational aspects","service design"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-3-4-38C133DEAB192D432B9C38859E6C715F"],"org":[{"affno":"1","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Technical Faculty of IT and Design","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology","Aalborg University, The Technical Faculty of IT and Design, Department of Architecture, Design and Media Technology, Section for Architecture and Urban Design"],"nora_code":"DI-U-AAU","used":1},{"affno":"2","key":"itu it university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-ITU","l3nl":"IT University of Copenhagen","l3nn":"ITU IT University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"ITU IT University of Copenhagen","namevar":["IT University of Copenhagen, Business IT","IT University of Copenhagen, Digitalization, Democracy, and Governance, REFLACT"],"nora_code":"DI-U-ITU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Olivia Thomassen","key":"harrepau","last":"Harre","locid":"4b238a51-1331-435b-8d5a-778a43447357","name":"Harre, Olivia Thomassen","orcid":"0009-0001-3681-3770","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Lene","key":"nielsenpau","last":"Nielsen","locid":"1052b289-f510-4c5a-9662-2db48c12ebc2","name":"Nielsen, Lene","orcid":"0000-0003-1768-7147","rank":2,"rolecode":"pau"},{"affno":"","first":"Johan","key":"blomkvistpedh","last":"Blomkvist","name":"Blomkvist, Johan","rank":3,"role":"Editor of Host Publication","rolecode":"pedh"},{"affn