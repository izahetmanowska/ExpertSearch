},{"affno":"3","first":"Susanne Bødtker","key":"petersensusannebødtkerpau","last":"Petersen","name":"Petersen, Susanne Bødtker","rank":19,"rolecode":"pau"},{"affno":"3 4","corresponding":null,"first":"Lene","key":"baunbæklenepau","last":"Baunbæk","name":"Baunbæk, Lene","rank":20,"rolecode":"pau"},{"affno":"3 5","corresponding":null,"first":"Maria Gunnleivsdóttir","key":"hansenmariagunnleivsdóttirpau","last":"Hansen","name":"Hansen, Maria Gunnleivsdóttir","rank":21,"rolecode":"pau"},{"affno":"6","first":"Maria Gunnleivsdottir","key":"hansenmariagunnleivsdottirpau","last":"Hansen","name":"Hansen, Maria Gunnleivsdottir","rank":21,"rolecode":"pau"}],"pub":{"isbn":["978879282536"],"issn":["22450203"],"issue":"56","pages":"1202","publisher":"Aarhus University, DCE - Danish Centre for Environment and Energy","publisher_org":"Aarhus University, DCE – Danish Centre for Environment and Energy","repno":"Scientiﬁc Report from DCE – Danish Centre for Environment and Energy, No. 56","series":"Scientiﬁc Report from DCE - Danish Centre for Environment and Energy","status":"p"},"review":"No Review","search":{"DAF":["Aarhus University","All Danish Affiliations","All Miscellaneous","All Universities","DI-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Miscellaneous","Other Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["au-8b440646-6584-4892-bb09-ebcef027022f","ku-0e7fad36-64ae-4481-8412-1167e9c78987","ku-1eab3343-5ee5-4ccd-ad8b-0548442a040d"],"src":["AU Aarhus University","KU University of Copenhagen"],"title":"Denmark’s National Inventory Report 2012 : Emission Inventories 1990-2010 - Submitted under the United Nations Framework Convention on Climate Change and the Kyoto Protocol","type":"Report","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-089.83-672719","year":"2012","yearsub":"2012"}
{"abstract":"AIMS: The aim of this study was to investigate in patients with stable angina the effects on costs of frontline diagnostics by exercise-stress testing (ex-test) vs. coronary computed tomography angiography (CTA). METHODS AND RESULTS: In two coronary units at Lillebaelt Hospital, Denmark, 498 patients were identified in whom either ex-test (n = 247) or CTA (n = 251) were applied as the frontline diagnostic strategy in symptomatic patients with a low-intermediate pre-test probability of coronary artery disease (CAD). During 12 months of follow-up, death, myocardial infarction and costs associated with downstream diagnostic utilization (DTU), treatment, ambulatory visits, and hospitalizations were registered. There was no difference between cohorts in demographic characteristics or the pre-test probability of significant CAD. The mean (SD) age was 56 (11) years; 52% were men; and 96% were at low-intermediate pre-test probability of CAD. All serious cardiac events (n = 3) during follow-up occurred in patients with a negative ex-test result. Mean costs per patient associated with DTU, ambulatory visits, and cardiovascular medication were significantly higher in the ex-test than in the CTA group. The mean (SD) total costs per patient at the end of thefollow-up were 14% lower in the CTA group than in the ex-test group, € 1510 (3474) vs. €1777 (3746) (P = 0.03). CONCLUSION: Diagnostic assessment of symptomatic patients with a low-intermediate probability of CAD by CTA incurred lower costs when compared with the ex-test. These findings need confirmation in future prospective trials.","author_count":5,"contributors":["Nielsen, Lene H","Olsen, Jens","Markenvard, John","Jensen, Jesper Møller","Nørgaard, Bjarne Linde"],"cuid":["S01-000.00-236176"],"filters":{"added":"2021-12","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-AU"]},"level3all":["DI-U-AU"]},"review":"pr","rtype":["clu"],"sorti":"effects on costs of frontline diagnostic evaluation in patients suspected of angina coronary computed tomography angiography vs conventional ischaemia testing","src":["au"],"src-code":["DI-U-AU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1093/ehjci/jes166","version":"Other Version"},"id":"S01-000.00-236176","identifier":[{"id":"22922828","type":"pmid"},{"id":"84876572732","type":"scopus"}],"ids":["au-bb1c2ff4-873e-42ff-8f64-e7c7d62f18f1"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-3-5-9B6BF01F6AD992A9DEF4E25F48A7FFF1"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1093/ehjci/jes166","version":"Other Version"}],"org":[{"affno":"1","key":"au aarhus university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AU","l3nl":"Aarhus University","l3nn":"AU Aarhus University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AU Aarhus University","namevar":["Aarhus University, Health, Department of Clinical Medicine, Department of Clinical Medicine - Medicinsk afd., Fredericia"],"nora_code":"DI-U-AU","used":1}],"person":[{"affno":"","corresponding":null,"first":"Lene H","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Lene H","rank":1,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jens","key":"olsenpau","last":"Olsen","locid":"b141cf98-8c32-4956-bb6e-5ab1424d59be","name":"Olsen, Jens","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"John","key":"markenvardpau","last":"Markenvard","locid":"1464f2af-2504-4a8d-8b53-438b4f36f5d4","name":"Markenvard, John","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper Møller","key":"jensenpau","last":"Jensen","locid":"a5cb9465-6652-4dda-806d-a8f33c29ff82","name":"Jensen, Jesper Møller","rank":4,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Bjarne Linde","key":"nørgaardpau","last":"Nørgaard","locid":"6bcdb292-78dc-4e8b-9fea-814d6a6852c9","name":"Nørgaard, Bjarne Linde","orcid":"0000-0002-4758-7203","rank":5,"rolecode":"pau"}],"pmid":["22922828"],"pub":{"doi":"10.1093/ehjci/jes166","issn":["15695794","18758312"],"issn_org":["15695794"],"journal":"The International Journal of Cardiovascular Imaging","pages":"813-823","publisher":"Springer Science and Business Media BV","publisher_org":"Springer Science and Business Media B.V.","status":"p","title":"The International Journal of Cardiovascular Imaging","title_org":"International Journal of Cardiovascular Imaging","volume":"27"},"review":"Peer Reviewed","scoID":["2-s2.0-84876572732"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-bb1c2ff4-873e-42ff-8f64-e7c7d62f18f1"],"src":["AU Aarhus University"],"title":"Effects on costs of frontline diagnostic evaluation in patients suspected of angina : coronary computed tomography angiography vs. conventional ischaemia testing","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-236176","year":"2012","yearsub":"2012"}
{"author_count":5,"contributors":["Kjær, Erik Dahl","Jensen, Viggo","McKinney, Lea Vig","Hansen, Lars Nørgaard","Nielsen, Lene Rostgaard"],"cuid":["S01-000.00-408170"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"2-5 contributors","cluster_size":1,"level":"pop","mra":["sci"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"und","rtype":["clu"],"sorti":"krydsning af sunde asketræer","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"id":"S01-000.00-408170","ids":["ku-18a4c60b-a9f9-4d32-80b5-4b8346b0238a"],"lang":"Danish","level":"Popular","mra":["Science/Technology"],"noi":["Local-1-1-EC836BDAE9440F80136D14FA7587F2EB"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Life Sciences, Forest & Landscape Denmark, Forest genetic resources"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Erik Dahl","key":"kjærpau","last":"Kjær","locid":"e1bdaffb-0384-4159-aa20-a913a2cee948","name":"Kjær, Erik Dahl","orcid":"0000-0001-8624-1611","rank":1,"rolecode":"pau"},{"affno":"1","first":"Viggo","key":"jensenpau","last":"Jensen","locid":"05d85e08-7ff1-479e-b476-247d13763003","name":"Jensen, Viggo","rank":2,"rolecode":"pau"},{"affno":"1","first":"Lea Vig","key":"mckinneypau","last":"McKinney","locid":"060df27a-59d3-4457-81a2-185cca16ae68","name":"McKinney, Lea Vig","orcid":"0000-0001-6601-4614","rank":3,"rolecode":"pau"},{"affno":"1","first":"Lars Nørgaard","key":"hansenpau","last":"Hansen","locid":"d80deb4b-74d4-457a-87c3-2af0abd2c8e6","name":"Hansen, Lars Nørgaard","rank":4,"rolecode":"pau"},{"affno":"1","first":"Lene Rostgaard","key":"nielsenpau","last