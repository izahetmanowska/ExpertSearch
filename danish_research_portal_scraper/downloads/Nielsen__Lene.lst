{"abstract":"Erik Scavenius' virke som formand for bestyrelsen for Politikens Hus samt hans omdømme 1940-1945 blandt medarbejdere og ledelse for dagbladene udgivet af Politikens Hus","author_count":8,"contributors":["Roslyng-Jensen, Palle"],"cuid":["S01-000.00-407933"],"filters":{"added":"2021-12","altsrc":["No Matches Found"],"author_count":"6-10 contributors","cluster_size":1,"keyword":["Det Humanistiske Fakultet","medier og krig"],"level":"sci","mra":["hum"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"scavenius og politikens hus 000000001937 000000001940 og scavenius eftermælet 000000001940 000000001945","src":["ku"],"src-code":["DI-U-KU"],"type":"dba","type-grp":["all","pub"]},"id":"S01-000.00-407933","ids":["ku-1849b914-6b42-4a08-bd34-45b6ec6e3e75"],"keyword":["Det Humanistiske Fakultet","Medier, politik og demokrati","medier og identitet","medier og krig"],"lang":"Danish","level":"Scientific","mra":["Humanities"],"noi":["Local-1-1-6B228542FDF3FD1EBD856B3EF964CECA"],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Humanities, SAXO-Institute - Archaeology, Ethnology, Greek & Latin, History"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Palle","key":"roslyngjensenpau","last":"Roslyng-Jensen","locid":"41f11896-272c-499e-9f70-719d4a82a271","name":"Roslyng-Jensen, Palle","rank":1,"rolecode":"pau"},{"affno":"","first":"Sofie Lene","key":"bakpedh","last":"Bak","name":"Bak, Sofie Lene","rank":2,"role":"Editor of Host Publication","rolecode":"pedh"},{"affno":"","first":"Thorsten","key":"borringolesenpedh","last":"Borring Olesen","name":"Borring Olesen, Thor