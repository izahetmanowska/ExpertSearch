me":"Stensvold, Christen Rune","rank":9,"rolecode":"pau"}],"pmid":["40609035"],"pub":{"doi":"10.1080/22221751.2025.2529893","issn":["22221751"],"issue":"1","journal":"Emerging Microbes and Infections","paperid":"2529893","publisher":"Taylor & Francis","status":"p","title":"Emerging Microbes and Infections","title_org":"Emerging microbes & infections","volume":"14"},"review":"Peer Reviewed","scoID":["2-s2.0-105011534620"],"search":{"DAF":["Aalborg University","All Danish Affiliations","All Governmental Institutions","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","North Denmark Region","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["aau-56468130-8eaf-439d-800f-1b9ee2b6458d","ku-c8b7490f-bc26-4ee4-943b-1d29a191e85b","sdu-79d74840-9572-4d12-a1f3-28a0f9fb64f5"],"src":["AAU Aalborg University","KU University of Copenhagen","SDU University of Southern Denmark"],"title":"From rare to recognized : enhanced detection uncovers Cryptosporidium endemicity and species diversity in Denmark","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S03-097.12-822316","year":"2025","yearsub":"2025"}
{"abstract":"Background: Nervous system infections are associated with long-term risks of neurological disorders and healthcare service utilization, but little data exist on the long-term risks of enteroviral meningitis in childhood. Methods: We performed a population-based, nationwide registry-based matched cohort study (1997-2021). We included 925 children with enteroviral meningitis aged <17 years, a comparison cohort, and a cohort of siblings of all individuals. To illustrate short- and long-term risks of neurological disorders, we calculated 1-year cumulative incidences and age- and sex-adjusted hazard ratios (aHRs) with 95% confidence intervals (95% CIs) during years 1-20 of follow-up. We further calculated the annual proportion of individuals using antiepileptic medication and healthcare services. Results: Young infants (0 to <90 days) and older children (≥90 days to <17 years) had slightly increased short- and long-term risks of neurological disorders after enteroviral meningitis compared to comparison cohort members (1-year cumulative incidence: 1.4% vs 0.6%, and 1.5% vs 0.4%, 1-20-year adjusted hazard ratio: 2.0 [95% CI: 1.2-3.2] and 1.7 [95% CI: 1.0-2.8]). Older children had increased use of antiepileptic medication, as well as the use of health care services both before and after enteroviral meningitis, with a similar trend among their siblings. Conclusions: Enteroviral meningitis in childhood appears to be associated with increased risk of short- and long-term neurological morbidity, though our estimates in older children may be confounded by prior neurological morbidity or increased healthcare-seeking behavior. Our findings suggest a generally good prognosis after enteroviral meningitis, though clinicians should be aware of the risk of neurological disorders in selected patients.","author_count":18,"contributors":["Graham, Emma E.","Tetens, Malte M.","Bodilsen, Jacob","Andersen, Nanna S.","Dessau, Ram","Ellermann-Eriksen, Svend","Franck, Kristina","Midgley, Sofie","Møller, Jens Kjølseth","Nielsen, Alex Christian","Nielsen, Lene","Søgaard, Kirstine K.","Østergaard, Christian","Lebech, Anne-Mette","Nygaard, Ulrikka","Omland, Lars H.","Obel, Niels"],"cuid":["S04-095.00-792838"],"filters":{"added":"2025-04","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":4,"corresponding_author":["Graham, Emma E."],"keyword":["Adolescent","Anticonvulsants therapeutic use","Child","Child Preschool","Childhood","Cohort Studies","Cohort study","Enterovirus Infections epidemiology","Female","Humans","Incidence","Infant","Infant Newborn","Male","Meningitis Viral epidemiology","Nervous System Diseases epidemiology","Neurological disorders","Patient Acceptance of Health Care statistics numerical data","Pediatric","Proportional Hazards Models","Registries","Risk Factors","enteroviral meningitis"],"level":"sci","mra":["med"],"oa":"Undetermined","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR"],"U":["DI-U-AAU","DI-U-ALL","DI-U-AU","DI-U-KU","DI-U-SDU"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-HO-CDR","DI-HO-NDR","DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"neurological disorders and use of healthcare services after enteroviral meningitis in childhood a nationwide population based cohort study","src":["aau","au","ku","sdu"],"src-code":["DI-U-AAU","DI-U-AU","DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"un","type":"url","url":"https://www.scopus.com/pages/publications/85217757614","version":"Other Version"},"funding_acknowledgement":["Financial support. This work was supported by The Independent Research Fund Denmark [grant number 2034-00100B]. The funder had no role in the design and execution of the study; collection, management, analyses, and interpretation of the data; preparation, review, or approval of the manuscript; and decision to submit the manuscript for publication. Acknowledgments. This study was financed by The Independent Research Fund Denmark, grant number 2034-00100B."],"id":"S04-095.00-792838","identifier":[{"id":"85217757614","type":"scopus"},{"id":"39931998","type":"pmid"}],"ids":["aau-3be1241d-f1fe-405b-9b5b-b203b122bc3f","au-f16349fc-b2b2-49bd-9220-c38d856cb426","ku-e8a3d2f8-b2a2-4a9a-a72f-ccf593cd6b85","sdu-574d5585-5db3-46ab-9d0b-df2548ab07f5"],"keyword":["Adolescent","Anticonvulsants/therapeutic use","Child","Child, Preschool","Cohort Studies","Enterovirus Infections/epidemiology","Female","Humans","Incidence","Infant","Infant, Newborn","Male","Meningitis, Viral/epidemiology","Nervous System Diseases/epidemiology","Patient Acceptance of Health Care/statistics & numerical data","Proportional Hazards Models","Registries","Risk Factors","childhood","cohort study","enteroviral meningitis","neurological disorders","pediatric"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-6-88E10AAEA0AB52F2C82047161F7AC704"],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Rigshospitalet, Copenhagen University Hospital"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"aau aalborg university","l2":"DI-U","l2n":"Universities","l3":"DI-U-AAU","l3nl":"Aalborg University","l3nn":"AAU Aalborg University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"AAU Aalborg University","namevar":["Aalborg University, The Faculty of Medicine","Aalborg University, The Faculty of Medicine, Aalborg University Hospital","Aalborg University, The Faculty of Medicine, Aalborg University Hospital, Department of Infectious Diseases","Aalborg University, The Faculty of Medicine, Department of Clinical Medicine"],