n":"Hospitals","l3":"DI-HO-SDR","l3nl":"Region of Southern Denmark","l3nn":"Region of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Region of Southern Denmark","namevar":["Odense University Hospital"],"nora_code":"DI-HO-SDR","used":1},{"affno":"5","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1 2","corresponding":null,"country":"dk","first":"Merete","key":"ajstruppau","last":"Ajstrup","locid":"2e566bbe-b3ca-4f6b-ab78-d3869e9638a7","name":"Ajstrup, Merete","orcid":"0000-0003-2231-7853","rank":1,"rolecode":"pau"},{"affno":"1 3","corresponding":null,"first":"Caroline Trillingsgaard","key":"mejdahlpau","last":"Mejdahl","locid":"cf3ce800-a252-443c-b66b-f11fb4410257","name":"Mejdahl, Caroline Trillingsgaard","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"country":"dk","first":"David Høyrup","key":"christiansenpau","last":"Christiansen","locid":"46467780-cdb3-43ae-a75b-b54b0d9743d4","name":"Christiansen, David Høyrup","orcid":"0000-0001-7458-3921","rank":3,"rolecode":"pau"},{"affno":"1 4 5 2","corresponding":null,"country":"dk","first":"Lene Kongsgaard","key":"nielsenpau","last":"Nielsen","locid":"897c29d3-45a2-4178-81b1-b0ba61db5a25","name":"Kongsgaard Nielsen, Lene","name_org":"Nielsen, Lene Kongsgaard","orcid":"0000-0003-2083-3870","rank":4,"rolecode":"pau"}],"pmid":["38856787"],"pub":{"doi":"10.1186/s41687-024-00739-3","issn":["25098020"],"issue":"1","journal":"Journal of Patient-Reported Outcomes","paperid":"58","publisher":"Springer","status":"p","title":"Journal of Patient-Reported Outcomes","volume":"8"},"review":"Peer Reviewed","scoID":["2-s2.0-85195622255"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Hospitals","All Miscellaneous","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-OT","DI-OT-ALL","DI-U","DI-U-ALL","Hospitals","Miscellaneous","Other Research","Region of Southern Denmark","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["au-dea7a9d4-25bd-4dd7-8d91-720ff9ae0a93","sdu-37a9db2b-ec43-426e-8245-74ad5b12a9f2"],"src":["AU Aarhus University","SDU University of Southern Denmark"],"title":"Transition of care in a Danish context : translation, cross-cultural adaptation and content validation of CTM-15 and PACT-M","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-100.00-742087","year":"2024","yearsub":"2024"}
{"abstract":"Objectives: Tuberculosis (TB) risk after initiation of antiretroviral treatment (ART) is not well described in a European setting, with an average TB incidence of 25/105 in the background population. Methods: We included all adult persons with HIV starting ART in the RESPOND cohort between 2012 and 2020. TB incidence rates (IR) were assessed for consecutive time intervals post-ART initiation. Risk factors for TB within 6 months from ART initiation were evaluated using Poisson regression models. Results: Among 8441 persons with HIV, who started ART, 66 developed TB during 34,239 person-years of follow-up (PYFU), corresponding to 1.87/1000 PYFU (95% confidence interval [CI]: 1.47-2.37). TB IR was highest in the first 3 months after ART initiation (14.41/1000 PY (95%CI 10.08-20.61]) and declined at 3-6, 6-12, and >12 months post-ART initiation (5.89 [95%CI 3.35-10.37], 2.54 [95%CI 1.36-4.73] and 0.51 [95%CI 0.30-0.86]), respectively. Independent risk factors for TB within the first 6 months after ART initiation included follow-up in Northern or Eastern Europe region, African origin, baseline CD4 count <200 cells/mm3, HIV RNA >100,000 copies/mL, injecting drug use and heterosexual transmission. Conclusions: TB IR was highest in the first 3 months post-ART initiation and was associated with baseline risk factors, highlighting the importance of thorough TB risk assessment at ART initiation.","author_count":25,"contributors":["Johansen, Isik S.","Roen, Ashley","Kraef, Christian","Martín-Iguacel, Raquel","Nemeth, Johannes","Fenner, Lukas","Zangerle, Robert","Llibre, Josep M.","Miller, Robert F.","Suarez, Isabelle","de Wit, Stephane","Wit, Ferdinand","Mussini, Christina","Saracino, Annalisa","Canetti, Diana","Volny-Anne, Alain","Jaschinski, Nadine","Neesgaard, Bastian","Nielsen, Lene Ryom","Peters, Lars","Garges, Harmony P.","Rooney, James F.","Podlekareva, Daria","Mocroft, Amanda","Kirk, Ole"],"cuid":["S02-100.00-761974"],"filters":{"added":"2024-11","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"continent":["America, North","Europe, EU","Europe, Non-EU","OECD"],"corresponding_author":["Johansen, Isik Somuncu"],"country":["Austria","Belgium","Germany","Italy","Netherlands","Spain","Switzerland","United Kingdom","United States"],"glorg":["ASST Santi Paolo e Carlo","All Global Affiliations","European AIDS Treatment Group","Fight Infections Foundation","Germans Trias","Gilead Sciences","Gilead Sciences Incorporated","GlaxoSmithKline","HIV Monitoring Foundation","Hospital Universitari Germans Trias i Pujol","Innsbruck Medical University","Medical University of Innsbruck","Saint-Pierre University Hospital","St Pierre University Hospital","University College London","University Hospital Cologne","University of Bern","University of Cologne","University of Modena and Reggio Emilia","University of Zurich","University of Zürich","ViiV Healthcare","Vita-Salute San Raffaele University"],"keyword":["AIDS","Adult","Anti HIV Agents therapeutic use","Art","CD4 Lymphocyte Count","Cohort Studies","Europe epidemiology","Female","HIV Infections drug therapy","Humans","Incidence","Male","Middle Aged","Risk Factors","TB HIV","Tuberculosis epidemiology"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-HO-CAP","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"risk of tuberculosis after initiation of antiretroviral therapy among persons with hiv in europe","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY-NC-ND","type":"doi","url":"https://doi.org/10.1016/j.ijid.2024.107199","version":"Published Version"},"id":"S02-100.00-761974","identifier":[{"id":"39142437","type":"pmid"},{"id":"85203802135","type":"scopus"}],"ids":["ku-5418630e-23a3-456a-