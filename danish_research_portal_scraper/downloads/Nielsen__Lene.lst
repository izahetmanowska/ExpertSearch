EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Infectious Diseases (Odense)"],"nora_code":"DI-U-SDU","used":1},{"affno":"13","country":"it","key":"san paolo hospital","loc":["Italy","Europe, EU","OECD"],"name":"San Paolo Hospital","used":1},{"affno":14,"key":"d a d study group","name":"D:A:D Study Group","role":"oau"}],"person":[{"affno":"1","corresponding":null,"first":"Colette J","key":"smithpau","last":"Smith","name":"Smith, Colette J","rank":1,"rolecode":"pau"},{"affno":"2","first":"Lene Ryom","key":"nielsenpau","last":"Nielsen","locid":"0087fd9d-3a4d-4da5-9f4d-2ba51ec7d7a8","name":"Nielsen, Lene Ryom","rank":2,"rolecode":"pau"},{"affno":"3","corresponding":null,"first":"Lene","key":"ryompau","last":"Ryom","name":"Ryom, Lene","rank":2,"rolecode":"pau"},{"affno":"4","corresponding":null,"first":"Rainer","key":"weberpau","last":"Weber","name":"Weber, Rainer","rank":3,"rolecode":"pau"},{"affno":"5","corresponding":null,"first":"Philippe","key":"morlatpau","last":"Morlat","name":"Morlat, Philippe","rank":4,"rolecode":"pau"},{"affno":"6","corresponding":null,"first":"Christian","key":"pradierpau","last":"Pradier","name":"Pradier, Christian","rank":5,"rolecode":"pau"},{"affno":"7","corresponding":null,"first":"Peter","key":"reisspau","last":"Reiss","name":"Reiss, Peter","rank":6,"rolecode":"pau"},{"affno":"8","corresponding":null,"first":"Justyna D","key":"kowalskapau","last":"Kowalska","name":"Kowalska, Justyna D","rank":7,"rolecode":"pau"},{"affno":"9","corresponding":null,"first":"Stephane","key":"dewitpau","last":"de Wit","name":"de Wit, Stephane","rank":8,"rolecode":"pau"},{"affno":"10","corresponding":null,"first":"Matthew","key":"lawpau","last":"Law","name":"Law, Matthew","rank":9,"rolecode":"pau"},{"affno":"11","corresponding":null,"first":"Wafaa","key":"elsadrpau","last":"el Sadr","name":"el Sadr, Wafaa","rank":10,"rolecode":"pau"},{"affno":"2 3","first":"Ole","key":"kirkpau","last":"Kirk","locid":"67bce469-8913-44ac-8d6d-7dff1171c771","name":"Kirk, Ole","rank":11,"rolecode":"pau"},{"affno":"2 12","first":"Nina","key":"friismollerpau","last":"Friis-Moller","locid":"761b77e5-d4d2-4af4-952e-79f55ca873d6","name":"Friis-Møller, Nina","name_org":"Friis-Moller, Nina","rank":12,"rolecode":"pau"},{"affno":"13","corresponding":null,"first":"Antonella d'Arminio","key":"monfortepau","last":"Monforte","name":"Monforte, Antonella d'Arminio","rank":13,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Andrew N","key":"phillipspau","last":"Phillips","name":"Phillips, Andrew N","rank":14,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Caroline A","key":"sabinpau","last":"Sabin","name":"Sabin, Caroline A","rank":15,"rolecode":"pau"},{"affno":"2 3","first":"Jens D","key":"lundgrenpau","last":"Lundgren","locid":"af310f7a-c49b-4381-bcb4-cf56e3fd80d8","name":"Lundgren, Jens","name_org":"Lundgren, Jens D","orcid":"0000-0001-8901-7850","rank":16,"rolecode":"pau"}],"pmid":["25042234"],"pub":{"doi":"10.1016/s0140-6736(14)60604-8","issn":["00995355","01406736"],"issn_org":["01406736"],"issue":"9939","journal":"The Lancet","pages":"241-248","publisher":"Elsevier","status":"p","title":"The Lancet","title_org":"Lancet","volume":"384"},"review":"Peer Reviewed","scoID":["2-s2.0-84904417292"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Copenhagen","University of Southern Denmark"],"PST":["Published"]},"sid":["ku-f35b08d6-b048-4e5d-be98-8644284a6cf1","sdu-4f5c4e48-9ecf-4555-8c1d-73aab3c0477c"],"src":["KU University of Copenhagen","SDU University of Southern Denmark"],"title":"Trends in underlying causes of death in people with HIV from 1999 to 2011 (D:A:D) : a multicohort collaboration","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-098.87-047367","year":"2014","yearsub":"2014"}
{"abstract":"BACKGROUND: Caring for a chronically ill spouse is stressful, but the health effects of caregiving are not fully understood. We studied the effect on mortality of being married to a person with Parkinson disease. METHODS: All patients in Denmark with a first-time hospitalization for Parkinson disease between 1986 and 2009 were identified, and each case was matched to five population controls. We further identified all spouses of those with Parkinson disease (n = 8,515) and also the spouses of controls (n = 43,432). All spouses were followed in nationwide registries until 2011. RESULTS: Among men, being married to a Parkinson disease patient was associated with a slightly higher risk of all-cause mortality (hazard ratio = 1.06 [95% confidence interval = 1.00-1.11]). Mortality was particularly high for death due to external causes (1.42 [1.09-1.84]) including suicide (1.89 [1.05-3.42]) and death from undefined symptoms/abnormal findings (1.25 [1.07-1.47]). Censoring at the time of death of the patient attenuated the findings for all-cause mortality in husbands (1.02 [0.95-1.09]), indicating that part of the association is with bereavement. Still, living with a person with Parkinson disease 5 years after first Parkinson hospitalization was associated with higher risk of all-cause mortality for both husbands (1.15 [1.07-1.23]) and wives (1.11 [1.04-1.17]). CONCLUSIONS: Caring for a spouse with a serious chronic illness is associated with a slight but consistent elevation in mortality risk.","author_count":7,"contributors":["Nielsen, Malene","Hansen, Johnni","Ritz, Beate","Nordahl, Helene","Schernhammer, Eva","Wermuth, Lene","Rod, Naja Hulvej"],"cuid":["S02-100.00-045193"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","class":"merged","cluster_size":2,"continent":["America, North","OECD"],"country":["United States"],"glorg":["All Global Affiliations","Harvard T.H. Chan School of Public Health","Harvard University","University of Southern California"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-NP","DI-U"],"level3":{"NP":["DI-NP-ALL","DI-NP-CAN"],"U":["DI-U-ALL","DI-U-KU","DI-U-SDU"]},"level3all":["DI-NP-CAN","DI-U-KU","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"cause specific mortality among spouses of parkinson disease patients","src":["ku","sdu"],"src-code":["DI-U-KU","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1097/EDE.0000000000000042","version":"Other Version"},"id":"S02-100.00-045193","identifier":[{"id":"24378369","type":"pmid"},{"id":"84894105484","type":"scopus"}],"ids":["ku-aa2d4e90-8f94-406d-a3d6-1d82a016cc01","sdu-896c41e2-273e-4f3a-9045-a7ba9f6d98da"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-A193D30F1077EA88FBA988292A660222"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1097/EDE.0000000000000042","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2014","yearSub":"2014"},"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Public Health, Section of Social Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"dcrc danish cancer society research center","l2":"DI-NP","l2n":"Non-Profit Organisations","l3":"DI-NP-CAN","l3nn":"DCRC Danish Cancer Society Research Center","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"DCRC Danish Cancer Society Research Center","namevar":["Danish Cancer Society"],"nora_code":"DI-NP-CAN","used":1},{"affno":"3","country":"us","key":"harvard university","loc":["United States","Ame