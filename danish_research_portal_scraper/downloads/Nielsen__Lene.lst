":"pau"},{"affno":"5 6","first":"Catrine","key":"halåspau","last":"Halås","name":"Halås, Catrine","rank":5,"rolecode":"pau"},{"affno":"1","country":"dk","first":"Kevin Holger","key":"mogensenpau","last":"Mogensen","locid":"d77cd69d-b76b-4276-8aca-a7ac41f1785e","name":"Mogensen, Kevin Holger","orcid":"0000-0002-5455-2340","rank":6,"rolecode":"pau"},{"affno":"7","first":"David Thore","key":"gravesenpau","last":"Gravesen","name":"Gravesen, David Thore","rank":7,"rolecode":"pau"},{"affno":"8 9","first":"Terje","key":"olsenpau","last":"Olsen","name":"Olsen, Terje","rank":8,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Universities","All University Colleges","DI-ALL","DI-U","DI-U-ALL","DI-UC","DI-UC-ALL","KP","Roskilde University","Universities","University Colleges","VIA University College"],"PST":["Published"]},"sid":["kp-dec1b996-b025-427d-b471-aa376558f8f6","ruc-129d5f82-9619-4650-a0e8-dd4218c29d8a"],"src":["KP University College Copenhagen","RUC Roskilde University"],"title":"A Day in Life – a collective research experiment","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-083.32-785409","year":"2024","yearsub":"2024"}
{"abstract":"Purpose: The purpose of this study is to explore line managers’ perspectives on data as tool in the management of sickness absence in public sector workplaces in Denmark.  Methods: The study is a qualitative study based on 19 semi-structured interviews with line managers from four public sector workplaces characterized by high levels of sickness absence or poor work environment. The interviews were analysed inductively using thematic analysis.  Results: The findings show that line managers primarily use data to identify employees at risk of sickness absence. The experiences highlighted related to how and when data are perceived as a valuable tool by the line managers, and that nuances in the data, accessibility of the data and how data are presented are important factors to ensure appropriate follow-up on sickness absence.  Conclusions: The findings suggest that for line managers to use data to manage sickness absence appropriately, the data must be easily accessible, simple for line managers to understand and provide line managers with a sufficient overview of sickness absence in their work units. It is also important to consider other factors affecting sickness absence, such as the work environment, when aiming to reduce sickness absence.","author_count":4,"contributors":["Rasmussen, Lene","Nielsen, Maj Britt Dahl","Garde, Anne Helene","Kristiansen, Jesper"],"cuid":["S02-099.91-769608"],"filters":{"added":"2024-11","altsrc":["Global Data"],"author_count":"2-5 contributors","class":"merged","cluster_size":2,"corresponding_author":["Rasmussen, Lene"],"keyword":["Absenteeism","Adult","Data","Denmark","Female","Humans","Intervention","Interviews as Topic","Ledelse","Line manager","Male","Middle Aged","Occupational health","Public sector","Qualitative Research","Sick Leave","Sickness absence","Sygefravær","Workplace"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-WORK"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-GV-WORK","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"exploring line managers perspectives on using data in managing sickness absence a qualitative study","src":["nfa","sdu"],"src-code":["DI-GV-WORK","DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1186/s12961-024-01224-5","version":"Published Version"},"id":"S02-099.91-769608","identifier":[{"id":"85204309138","type":"scopus"},{"id":"39289710","type":"pmid"},{"id":"PMC11407000","type":"pmcid"}],"ids":["nfa-e5ad2344-43d1-44ce-b941-662f849e123d","sdu-a7b3735a-b3b1-4ad2-8860-891376ded312"],"keyword":["Absenteeism","Adult","Data","Denmark","Female","Humans","Intervention","Interviews as Topic","Ledelse","Line manager","Male","Middle Aged","Occupational Health","Public Sector","Qualitative Research","Sick Leave","Sickness absence","Sygefravær","Workplace"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-5-F9994482C0AE135A3B552772F92855EA"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1186/s12961-024-01224-5","version":"Published Version"},{"access":"oa","license":"CC BY-NC-ND","type":"loc","url":"https://findresearcher.sdu.dk/ws/files/272664999/s12961-024-01224-5.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"nfa national research centre for the working environment","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-WORK","l3nn":"NFA National Research Centre for the Working Environment","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"NFA National Research Centre for the Working Environment","namevar":["The National Research Centre for the Working Environment","The National Research Centre for the Working Environment, Directors, Psychosocial Working Environment and Working Accidents and Safety Culture"],"nora_code":"DI-GV-WORK","used":1},{"affno":"2","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, National Institute of Public Health","SDU, The Faculty of Health Sciences, National Institute of Public Health, Mental health"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"first":"Lene","key":"rasmussenpau","last":"Rasmussen","locid":"0d8ad03f-8294-49a2-8bb7-fea40eccf25a","name":"Rasmussen, Lene","orcid":"0000-0002-7864-4178","rank":1,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Maj Britt Dahl","key":"nielsenpau","last":"Nielsen","locid":"9dfb8e84-90f3-4531-b486-2df21e9ecd3a","name":"Nielsen, Maj Britt Dahl","orcid":"0000-0002-5758-8031","rank":2,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Anne Helene","key":"gardepau","last":"Garde","locid":"8e894baf-467c-45d3-8abe-41a805b30b22","name":"Garde, Anne Helene","orcid":"0000-0002-1553-2291","rank":3,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jesper","key":"kristiansenpau","last":"Kristiansen","locid":"2b90a97c-15d6-468c-a8d6-1362e731d2bc","name":"Kristiansen, Jesper","orcid":"0000-0002-1637-8900","rank":4,"rolecode":"pau"}],"pmid":["39289710"],"pub":{"doi":"10.1186/s12961-024-01224-5","issn":["14784505"],"issue":"1","journal":"Health Research Policy and Systems","pages":"126","publisher":"BioMed Central Ltd.","status":"p","title":"Health Research Policy and Systems","volume":"22"},"review":"Peer Reviewed","scoID":["2-s2.0-85204309138"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Universities","DI-ALL","DI-GV","DI-GV-ALL","DI-U","DI-U-ALL","Governmental Institutions","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["nfa-e5ad2344-43d1-44ce-b941-662f849e123d","sdu-a7b3735a-b3b1-4ad2-8860-891376ded312"],"src":["NFA National Research Centre for the Working Environment","SDU University of Southern Denmark"],"title":"Exploring line managers’ perspectives on using data in managing sickness absence : a qualitative study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.91-769608","year":"2024","yearsub":"2024"}
{"abstract":"Background: Respiratory viral infections have significant global health impacts. We compared 30-day intensive care unit (ICU) admission and all-cause mortality risks in patients with severe acute respiratory syndrome coronavirus 2 (SARS-CoV-2) Delta and Omicron variants versus influenza A and B (A/B). Methods: Data from two retrospective inpatient cohorts in Copenhagen were analyzed. Cohorts included hospitalized influenza A/B patients (2017–2018) and SARS-CoV-2 Delta/Omicron patients (2021–2022), aged ≥18 years, admitted within 14 days of a positive real-time polymerase chain reaction test result. Cumulative ICU admission and mortality rates were estimated using the Aalen–Johansen estimator. Cox regression models calculated hazard ratios (HRs) for ICU admission and mortality. Results: The study encompassed 1459 inpatients (Delta: 49%; Omicron: 26%; influenza A: 6.4%; and influenza B: 18%). Cumulative incidence of ICU admission was 11%, 4.0%, 7.5%, and 4.1%, for Delta, Omicron, influenza A, and B, respectively. For ICU admission, adjusted HRs (aHRs) were 3.1 (p <.001) and 1.5 (p =.34) for Delta and Omicron versus influenza B, and 1.5 (p =.36) and 0.71 (p =.48) versus influenza A. For mortality, aHRs were 3.8 (p <.001) and 3.4 (p <.001) for Delta and Omicron versus influenza B, and 2.1 (p =.04) and 1.9 (p =.11) versus influenza A. Conclusion: Delta but not Omicron inpatients had an increased risk for ICU admission compared to influenza B; however, both variants were associated with higher risks of mortality than influenza B. Only Delta inpatients had a higher risk of mortality than influenza A inpatients.","author_count":15,"contributors":["Rezahosseini, Omid","Roed, Casper","Sejdic, Adin","Eiberg, Mads Frederik","Nielsen, Lene","Boel, Jonas","Johannesen, Caroline Klint","van Wijhe, Maarten","Franck, Kristina Træholt","Ostrowski, Sisse Rye","Lindegaard, Birgitte","Fischer, Thea K.","Knudsen, Troels Bygum","Holler, Jon Gitz","Harboe, Zitta Barrella"],"cuid":["S02-099.92-751894"],"filters":{"added":"2024-08","altsrc":["Global Data"],"author_count":"11-50 contributors","class":"merged","cluster_size":2,"corpau":["the COVID-19 Omicron Delta study group collaborators"],"keyword":["Intensive Care Units","Mortality","SARS CoV 2 Delta variants","SARS CoV 2 Omicron variant","influenza A","influenza B"],"level":"sci","mra":["med","sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-GV","DI-HO","DI-U"],"level3":{"GV":["DI-GV-ALL","DI-GV-SSI"],"HO":["DI-HO-ALL","DI-HO-CAP"],"U":["DI-U-ALL","DI-U-KU","DI-U-RUC"]},"level3all":["DI-GV-SSI","DI-HO-CAP","DI-U-KU","DI-U-RUC"]},"review":"pr","rtype":["clu"],"sorti":"risk of intensive care unit admission and mortality in patients hospitalized due to influenza a or b and sars cov 000000000002 variants omicron or delta","src":["ku","ruc"],"src-code":["DI-U-KU","DI-U-RUC"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1002/iid3.1269","version":"Published Version"},"id":"S02-099.92-751894","identifier":[{"id":"PMC11225085","type":"pmcid"},{"id":"85197802004","type":"scopus"},{"id":"40499155","type":"pmid"}],"ids":["ku-40fc6ab4-e97a-4de0-991c-af2eef7e25bf","ruc-75a4219c-32b6-4116-a0d4-7a79e1fcae3b"],"keyword":["SARS-CoV-2 Delta variants","SARS-CoV-2 Omicron variant","influenza A","influenza B","intensive care units","mortality"],"lang":"English","level":"Scientific","mra":["Medical Science","Science/Technology"],"noi":["Global-Local-2-5-22ABF18CCB24471C7E12D8E10E3FCDED"],"oa_link":[{"access":"oa","license":"CC BY","type":"loc","url":"https://rucforsk.ruc.dk/ws/files/105123780/Immunity_Inflam_Disease_-_2024_-_Rezahosseini_-_Risk_of_intensive_care_unit_admission_and_mortality_in_patients.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/398466306/Immunity_Inflam_Disease_2024_Rezahosseini_Risk_of_intensive_care_unit_admission_and_mortality_in_patients.pdf","version":"Published Version"},{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1002/iid3.1269","version":"Published Version"}],"org":[{"affno":"1","country":"dk","key":"capital region of denmark","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CAP","l3nl":"Capital Region of Denmark","l3nn":"Capital Region of Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Capital Region of Denmark","namevar":["Copenhagen University Hospital – North Zealand"],"nora_code":"DI-HO-CAP","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Health and Medical Sciences, Department of Clinical Medicine, Department of Clinical Medicine"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"dk","key":"ruc roskilde university","l2":"DI-U","l2n":"Universities","l3":"DI-U-RUC","l3nl":"Roskilde University","l3nn":"RUC Roskilde University","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"RUC Roskilde University","namevar":["Roskilde University"],"nora_code":"DI-U-RUC","used":1},{"affno":"4","country":"dk","key":"ssi statens serum institut","l2":"DI-GV","l2n":"Governmental Institutions","l3":"DI-GV-SSI","l3nn":"SSI Statens Serum Institut","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SSI Statens Serum Institut","namevar":["Statens Serum Institut"],"nora_code":"DI-GV-SSI","used":1},{"affno":5,"key":"the covid 19 omicron delta study group collaborators","name":"The COVID-19 Omicron Delta study group collaborators","role":"oau"}],"person":[{"affno":"1","first":"Omid","key":"rezahosseinipau","last":"Rezahosseini","name":"Rezahosseini, Omid","rank":1,"rolecode":"pau"},{"affno":"1 2 3","first":"Casper","key":"roedpau","last":"Roed","locid":"3432c3fc-2d9a-4f77-b3cd-fa54a8352fb0","name":"Roed, Casper","rank":2,"rolecode":"pau"},{"affno":"1 2","first":"Adin","key":"sejdicpau","last":"Sejdic","locid":"743c05e9-0a74-49b7-aca7-f3ddbb4d8742","name":"Sejdic, Adin","rank":3,"rolecode":"pau"},{"affno":"1","first":"Mads Frederik","key":"eibergpau","last":"Eiberg","name":"Eiberg, Mads Frederik","rank":4,"rolecode":"pau"},{"affno":"1","first":"Lene","key":"nielsenpau","last":"Nielsen","name":"Nielsen, Lene","rank":5,"rolecode":"pau"},{"affno":"1","first":"Jonas","key":"boelpau","last":"Boel","name":"Boel, Jonas","rank":6,"rolecode":"pau"},{"affno":"1","first":"Caroline Klint","key":"johannesenpau","last":"Johannesen","name":"Johannesen, Caroline Klint","rank":7,"rolecode":"pau"},{"affno":"3","country":"dk","first":"Maarten","key":"vanwijhepau","last":"van Wijhe","locid":"b9f417a5-1a60-4c0d-9051-b9b3f73b6a76","name":"van Wijhe, Maarten","orcid":"0000-0001-9216-8393","rank":8,"rolecode":"pau"},{"affno":"4","first":"Kristina Træholt","key":"franckpau","last":"Franck","name":"Franck, Kristina Træholt","rank":9,"rolecode":"pau"},{"affno":"2 1","first":"Sisse Rye","key":"ostrowskipau","last":"Ostrowski","locid":"ba497828-2322-4b15-bfae-1e8a8c3895e7","name":"Ostrowski, Sisse Rye","orcid":"0000-0001-5288-3851","rank":10,"rolecode":"pau"},{"affno":"1 2","first":"Birgitte","key":"lindegaardpau","last":"Lindegaard","locid":"f8c3a235-1f94-4c1d-afe3-c6c7f9b31002","name":"Lindegaard, Birgitte","rank":11,"rolecode":"pau"},{"affno":"1 3 4 2","first":"Thea K.","key":"fischerpau","last":"Fischer","locid":"97c4bf8d-8bd1-470b-8e0b-91eb4faf7703","name":"Fischer, Thea K.","rank":12,"rolecode":"pau"},{"affno":"1","first":"Troels Bygum","key":"knudsenpau","last":"Knudsen","name":"Knudsen, Troels Bygum","rank":13,"rolecode":"pau"},{"affno":"1","first":"Jon Gitz","key":"hollerpau","last":"Holler","name":"Holler, Jon Gitz","rank":14,"rolecode":"pau"},{"affno":"1 4 2","first":"Zitta Barrella","key":"harboepau","last":"Harboe","locid":"2b596a33-5659-4236-b5ea-c0991866af44","name":"Harboe, Zitta Barrella","orcid":"0000-0001-5552-0095","rank":15,"rolecode":"pau"}],"pmid":["40499155"],"pub":{"doi":"10.1002/iid3.1269","issn":["20504527"],"issue":"7","journal":"Immunity, Inflammation and Disease","paperid":"e1269","status":"p","title":"Immunity, Inflammation and Disease","volume":"12"},"review":"Peer Reviewed","scoID":["2-s2.0-85197802004"],"search":{"DAF":["All Danish Affiliations","All Governmental Institutions","All Hospitals","All Universities","Capital Region of Denmark","DI-ALL","DI-GV","DI-GV-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Governmental Institutions","Hospitals","Roskilde University","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-40fc6ab4-e97a-4de0-991c-af2eef7e25bf","ruc-75a4219c-32b6-4116-a0d4-7a79e1fcae3b"],"src":["KU University of Copenhagen","RUC Roskilde University"],"title":"Risk of intensive care unit admission and mortality in patients hospitalized due to influenza A or B and SARS‑CoV‑2 variants Omicron or Delta","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S02-099.92-751894","year":"2024","yearsub":"2024"}
{"abstract":"Purpose: Non-response (NR) to patient-reported outcome (PRO) questionnaires may cause bias if not handled appropriately. Collecting reasons for NR is recommended, but how reasons for NR are related to missing data mechanisms remains unexplored. We aimed to explore this relationship for intermittent NRs. Methods: Patients with multiple myeloma completed validated PRO questionnaires at enrolment and 12 follow-up time-points. NR was defined as non-completion of a follow-up assessment within seven days, which triggered contact with the patient, recording the reason for missingness and an invitation to complete the questionnaire (denoted “salvage response”). Mean differences between salvage and previous on-time scores were estimated for groups defined by reasons for NR using linear regression with clustered standard errors. Statistically significant mean differences larger than minimal important difference thresholds were interpreted as “missing not at random” (MNAR) mechanism (i.e. assumed to be related to declining health), and the remainder interpreted as aligned with “missing completely at random” (MCAR) mechanism (i.e. assumed unrelated to changes in health). Results: Most (7228/7534 (96%)) follow-up questionnaires were completed; 11% (802/7534) were salvage responses. Mean salvage scores were compared to previous on-time scores by reason: those due to hospital admission, mental or physical reasons were worse in 10/22 PRO domains; those due to technical difficulties/procedural errors were no different in 21/22 PRO domains; and those due to overlooked/forgotten or other/unspecified reasons were no different in any domains. Conclusion: Intermittent NRs due to hospital admission, mental or physical reasons were aligned with MNAR mechanism for nearly half of PRO domains, while intermittent NRs due to technical difficulties/procedural errors or other/unspecified reasons generally were aligned with MCAR mechanism.","author_count":21,"contributors":["Kongsgaar