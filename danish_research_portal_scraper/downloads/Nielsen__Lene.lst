pau","last":"Espelund","name":"Espelund, Ulrick Skipper","rank":26,"rolecode":"pau"},{"affno":"1","first":"Vibeke","key":"jørgensenpau","last":"Jørgensen","locid":"9ef41012-736f-44df-90ab-54346f56c3c2","name":"Jørgensen, Vibeke L.","name_org":"Jørgensen, Vibeke","rank":27,"rolecode":"pau"},{"affno":"4","first":"Nicolai","key":"haasepau","last":"Haase","name":"Haase, Nicolai","rank":28,"rolecode":"pau"},{"affno":"1","first":"Anders","key":"pernerpau","last":"Perner","locid":"8a389541-d529-4ee3-8364-66bfc85f77c9","name":"Perner, Anders","rank":29,"rolecode":"pau"}],"pmid":["36263897"],"pub":{"doi":"10.1111/aas.14157","issn":["00015172"],"issue":"1","journal":"Acta Anaesthesiologica Scandinavica","pages":"76-85","status":"p","title":"Acta Anaesthesiologica Scandinavica","volume":"67"},"review":"Peer Reviewed","scoID":["2-s2.0-85141525308"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Capital Region of Denmark","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","North Denmark Region","Region Zealand","Region of Southern Denmark","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-3d18c52a-b741-4e39-983e-7ec7883b3b97"],"src":["KU University of Copenhagen"],"title":"Thromboembolic and bleeding events in ICU patients with COVID-19 : A nationwide, observational study","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-429942","year":"2023","yearsub":"2023"}
{"abstract":"Introduction: The ascomycete Hymenoscyphus fraxineus, originating from Asia, is currently threatening common ash (Fraxinus excelsior) in Europe, massive ascospore production from the saprotrophic phase being a key determinant of its invasiveness. Methods: To consider whether fungal diversity and succession in decomposing leaf litter are affected by this invader, we used ITS-1 metabarcoding to profile changes in fungal community composition during overwintering. The subjected ash leaf petioles, collected from a diseased forest and a healthy ash stand hosting the harmless ash endophyte Hymenoscyphus albidus, were incubated in the forest floor of the diseased stand between October 2017 and June 2018 and harvested at 2–3-month intervals. Results: Total fungal DNA level showed a 3-fold increase during overwintering as estimated by FungiQuant qPCR. Petioles from the healthy site showed pronounced changes during overwintering; ascomycetes of the class Dothideomycetes were predominant after leaf shed, but the basidiomycete genus Mycena (class Agaricomycetes) became predominant by April, whereas H. albidus showed low prevalence. Petioles from the diseased site showed little change during overwintering; H. fraxineus was predominant, while Mycena spp. showed increased read proportion by June. Discussion: The low species richness and evenness in petioles from the diseased site in comparison to petioles from the healthy site were obviously related to tremendous infection pressure of H. fraxineus in diseased forests. Changes in leaf litter quality, owing to accumulation of host defense phenolics in the pathogen challenged leaves, and strong saprophytic competence of H. fraxineus are other factors that probably influence fungal succession. For additional comparison, we examined fungal community structure in petioles collected in the healthy stand in August 2013 and showing H. albidus ascomata. This species was similarly predominant in these petioles as H. fraxineus was in petioles from the diseased site, suggesting that both fungi have similar suppressive effects on fungal richness in petiole/rachis segments they have secured for completion of their life cycle. However, the ability of H. fraxineus to secure the entire leaf nerve system in diseased forests, in opposite to H. albidus, impacts the general diversity and successional trajectory of fungi in decomposing ash petioles.","author_count":8,"contributors":["Kosawang, Chatchai","Børja, Isabella","Herrero, Maria-Luz","Nagy, Nina E.","Nielsen, Lene Rostgaard","Solheim, Halvor","Timmermann, Volkmar","Hietala, Ari M."],"cuid":["S01-000.00-496747"],"filters":{"added":"2023-05","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, Non-EU","Nordic","OECD"],"country":["Norway"],"glorg":["All Global Affiliations","Norwegian Institute of Bioeconomy Research","Norwegian University of Life Sciences"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"fungal succession in decomposing ash leaves colonized by the ash dieback pathogen i hymenoscyphus fraxineus i or its harmless relative i hymenoscyphus albidus i","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fmicb.2023.1154344","version":"Published Version"},"id":"S01-000.00-496747","identifier":[{"id":"85159810000","type":"scopus"},{"id":"PMC10140306","type":"pmcid"},{"id":"37125194","type":"pmid"}],"ids":["ku-acf0f060-c707-4d5a-81bf-9d4b33b35a00"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-EC4DB389B24EF109E811A96F52EFB216"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.3389/fmicb.2023.1154344","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/347691525/Fungal_succession_in_decomposing_ash_leaves_colonized_by_the_ash_dieback_pathogen_Hymenoscyphus_fraxineus_or_its_harmless_relative_Hymenoscyphus_albidus.pdf","version":"Published Version"}],"org":[{"affno":"1","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Geosciences and Natural Resource Management, Forest and Landscape Ecology"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"no","key":"norwegian institute of bioeconomy research","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"Norwegian Institute of Bioeconomy Research","used":1},{"affno":"3","country":"no","key":"norwegian university of life sciences","loc":["Norway","Europe, Non-EU","Nordic","OECD"],"name":"Norwegian University of Life Sciences","used":1}],"person":[{"affno":"1","first":"Chatchai","key":"kosawangpau","last":"Kosawang","locid":"1b69b056-6473-427b-81f9-20fbd6797849","name":"Kosawang, Chatchai","rank":1,"rolecode":"pau"},{"affno":"2 3","first":"Isabella","key":"børjapau","last":"Børja","name":"Børja, Isabella","rank":2,"rolecode":"pau"},{"affno":"2","first":"Maria-Luz","key":"herreropau","last":"Herrero","name":"Herrero, Maria-Luz","rank":3,"rolecode":"pau"},{"affno":"2","first":"Nina E.","key":"nagypau","last":"Nagy","name":"Nagy, Nina E.","rank":4,"rolecode":"pau"},{"affno":"1","first":"Lene R.","key":"nielsenpau","last":"Nielsen","locid":"8e8b51ee-3f45-4ebe-b2fb-fa79f1256d08","name":"Nielsen, Lene Rostgaard","name_org":"Nielsen, Lene R.","orcid":"0000-0002-7214-8691","rank":5,"rolecode":"pau"},{"affno":"2","first":"Halvor","key":"solheimpau","last":"Solheim","name":"Solheim, Halvor","rank":6,"rolecode":"pau"},{"affno":"2","first":"Volkmar","key":"timmermannpau","last":"Timmermann","name":"Timmermann, Volkmar","rank":7,"rolecode":"pau"},{"affno":"2","first":"Ari M.","key":"hietalapau","last":"Hietala","name":"Hietala, Ari M.","rank":8,"rolecode":"pau"}],"pmid":["37125194"],"pub":{"doi":"10.3389/fmicb.2023.1154344","issn":["1664302X"],"journal":"Frontiers in Microbiology","paperid":"1154344","status":"p","title":"Frontiers in Microbiology","volume":"14"},"review":"Peer Reviewed","scoID":["2-s2.0-85159810000"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-acf0f060-c707-4d5a-81bf-9d4b33b35a00"],"src":["KU University of Copenhagen"],"title":"Fungal succession in decomposing ash leaves colonized by the ash dieback pathogen <i>Hymenoscyphus fraxineus</i> or its harmless relative <i>Hymenoscyphus albidus</i>","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-496747","year":"2023","yearsub":"2023"}
{"abstract":"Polyploidy is an important mechanism in angiosperm diversification and evolution. Polyploidization can lead to speciation when the chromosome doubling prevents interbreeding between coexisting cytotypes. In the case of Acacia senegal, different ploidy levels have been reported but the degree and impact of interploidy gene flow in natural populations is not yet resolved. This paper addresses the aspect by characterizing the genetic differentiation among ploidy levels and identifying prezygotic reproductive barriers against interploidy cross-pollination. We genotyped 293 individuals from 10 populations across Senegal using eight microsatellite markers. To study potential pre-zygotic reproductive barriers between diploids and polyploids, we compared the flower morphology and phenology between even-aged diploid and tetraploid trees from a common garden trial that consisted of four different populations originally selected in the natural distribution area of the species in Senegal. The analysis revealed variation among populations in the frequency of polyploids with common co-occurrence of the ploidy levels. The microsatellite markers revealed genetic differentiation between polyploid and diploid trees, and the floral studies identified differences that can act as prezygotic reproductive barriers: tetraploid trees had bigger polyads and stigma cup size compared to diploid trees. Also, polyploid trees on average flowered 9 days earlier than diploids although with overlaps in flowering time. Our results suggest that gene flow among cytotypes of A. senegal is limited and that interploidy pollination is likely to be restricted by differences in flower phenology and morphology.","author_count":4,"contributors":["Diallo, Adja Madjiguène","Kjær, Erik Dahl","Ræbild, Anders","Nielsen, Lene Rostgaard"],"cuid":["S01-000.00-540096"],"filters":{"added":"2023-03","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"continent":["Africa"],"country":["Senegal"],"glorg":["All Global Affiliations","Institut sénégalais de recherche agricole"],"keyword":["Floral morphology","Genetic differentiation","Senegalia senegal"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"coexistence of diploid and polyploid acacia senegal l willd and its implications for interploidy pollination","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/422283428/NEFO_D_21_00028_R2_1_281121.pdf","version":"Authors Final Version"},"id":"S01-000.00-540096","identifier":[{"id":"85124107995","type":"scopus"}],"ids":["ku-f5afe8e9-14bd-480d-9b13-2d186987e6a5"],"keyword":["Floral morphology","Floral phenology","Genetic differentiation","Interploidy pollination","Senegalia senegal"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-F975963CA4732596ADE3A5D6276AE7AA"],"oa_link":[{"access":"oa","type":"loc","url":"https://curis.ku.dk/ws/files/422283428/NEFO_D_21_00028_R2_1_281121.pdf","version":"Authors Final Version"}],"org":[{"affno":"1","country":"sn","key":"institut sénégalais de recherche agricole","loc":["Senegal","Africa"],"name":"Institut sénégalais de recherche agricole","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Geosciences and Natural Resource Management, Forest and Landscape Ecology"],"nora_code":"DI-U-KU","used":1}],"person":[{"affno":"1","first":"Adja Madjiguène","key":"diallopau","last":"Diallo","name":"Diallo, Adja Madjiguène","rank":1,"rolecode":"pau"},{"affno":"2","first":"Erik Dahl","key":"kjærpau","last":"Kjær","locid":"e1bdaffb-0384-4159-aa20-a913a2cee948","name":"Kjær, Erik Dahl","orcid":"0000-0001-8624-1611","rank":2,"rolecode":"pau"},{"affno":"2","first":"Anders","key":"ræbildpau","last":"Ræbild","locid":"599ea842-1926-48bd-b897-1bc32e9b4912","name":"Ræbild, Anders","orcid":"0000-0002-8793-5663","rank":3,"rolecode":"pau"},{"affno":"2","first":"Lene Rostgaard","key":"nielsenpau","last":"Nielsen","locid":"8e8b51ee-3f45-4ebe-b2fb-fa79f1256d08","name":"Nielsen, Lene Rostgaard","orcid":"0000-0002-7214-8691","rank":4,"rolecode":"pau"}],"pub":{"doi":"10.1007/s11056-021-09901-x","issn":["01694286","15735095"],"issn_org":["01694286"],"issue":"1","journal":"New Forests","pages":"67-82","status":"p","title":"New Forests","volume":"54"},"review":"Peer Reviewed","scoID":["2-s2.0-85124107995"],"search":{"DAF":["All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-f5afe8e9-14bd-480d-9b13-2d186987e6a5"],"src":["KU University of Copenhagen"],"title":"Coexistence of diploid and polyploid Acacia senegal (L. Willd.) and its implications for interploidy pollination","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-540096","year":"2023","yearsub":"2023"}
{"abstract":"Tree diseases constitute a significant threat to biodiversity worldwide. Pathogen discovery in natural habitats is of vital importance to understanding current and future threats and prioritising efforts towards developing disease management strategies. Ash dieback is a fungal disease of major conservational concern that is infecting common ash trees, Fraxinus excelsior, in Europe. The disease is caused by a non-native fungal pathogen, Hymenoscyphus fraxineus. Other dieback causing-species have not previously been identified in the genus Hymenoscyphus. Here, we discover the pathogenicity potential of two newly identified related species of Asian origin, H. koreanus and H. occultus, and one Europe-native related species, H. albidus. We sequence the genomes of all three Hymenoscyphus species and compare them to that of H. fraxineus. Phylogenetic analysis of core eukaryotic genes identified H. albidus and H. koreanus as sister species, whilst H. occultus diverged prior to these and H. fraxineus. All four Hymenoscyphus genomes are of comparable size (55–62 Mbp) and GC contents (42–44%) and encode for polymorphic secretomes. Surprisingly, 1133 predicted secreted proteins are shared between the ash dieback pathogen H. fraxineus and the three related Hymenoscyphus endophytes. Amongst shared secreted proteins are cell death-inducing effector candidates, such as necrosis, and ethylene-inducing peptide 1-like proteins, Nep1-like proteins, that are upregulated during in planta growth of all Hymenoscyphus species. Indeed, pathogenicity tests showed that all four related Hymenoscyphus species develop pathogenic growth on European ash stems, with native H. albidus being the least virulent. Our results identify the threat Hymenoscypohus species pose to the survival of European ash trees, and highlight the importance of promoting pathogen surveillance in environmental landscapes. Identifying new pathogens and including them in the screening for durable immunity of common ash trees is key to the long-term survival of ash in Europe.","author_count":7,"contributors":["Rafiqi, Maryam","Kosawang, Chatchai","Peers, Jessica A.","Jelonek, Lukas","Yvanne, Hélène","McMullan, Mark","Nielsen, Lene Rostgaard"],"cuid":["S01-000.00-679039"],"filters":{"added":"2023-07","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"continent":["Europe, EU","Europe, Non-EU","OECD"],"country":["Germany","United Kingdom"],"glorg":["All Global Affiliations","Justus Liebig University Giessen","Norwich Research Park","Royal Botanic Gardens, Kew"],"keyword":["Ash dieback","Forest pathology","Hymenoscyphus fraxineus","Pathogenicity"],"level":"sci","mra":["sci"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"endophytic fungi related to the ash dieback causal agent encode signatures of pathogenicity on european ash","src":["ku"],"src-code":["DI-U-KU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s43008-023-00115-8","version":"Published Version"},"id":"S01-000.00-679039","identifier":[{"id":"37170345","type":"pmid"},{"id":"85159185706","type":"scopus"},{"id":"PMC10176688","type":"pmcid"}],"ids":["ku-c00724f1-58d6-4a18-9c22-d569ea115f06"],"keyword":["Ash dieback","Emerging fungal pathogens","Forest pathology","Hymenoscyphus fraxineus","Non-crop fungal pathogens","Pathogenicity"],"lang":"English","level":"Scientific","mra":["Science/Technology"],"noi":["Global-Local-2-4-2AE1CCD031ECF1B2BBED00427BC8A027"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s43008-023-00115-8","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/347414536/Endophytic_fungi_related_to_the_ash_dieback_causal_agent_encode_signatures_of_pathogenicity_on_European_ash.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"gb","key":"royal botanic gardens kew","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Royal Botanic Gardens, Kew","used":1},{"affno":"2","key":"ku university of copenhagen","l2":"DI-U","l2n":"Universities","l3":"DI-U-KU","l3nl":"University of Copenhagen","l3nn":"KU University of Copenhagen","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"KU University of Copenhagen","namevar":["Københavns Universitet, Faculty of Science, Department of Geosciences and Natural Resource Management, Forest and Landscape Ecology"],"nora_code":"DI-U-KU","used":1},{"affno":"3","country":"gb","key":"norwich research park","loc":["United Kingdom","Europe, Non-EU","OECD"],"name":"Norwich Research Park","used":1},{"affno":"4","country":"de","key":"justus liebig university giessen","loc":["Germany","Europe, EU","OECD"],"name":"Justus Liebig University Giessen","used":1}],"person":[{"affno":"1","first":"Maryam","key":"rafiqipau","last":"Rafiqi","name":"Rafiqi, Maryam","rank":1,"rolecode":"pau"},{"affno":"2","first":"Chatchai","key":"kosawangpau","last":"Kosawang","locid":"1b69b056-6473-427b-81f9-20fbd6797849","name":"Kosawang, Chatchai","rank":2,"rolecode":"pau"},{"affno":"3","first":"Jessica A.","key":"peerspau","last":"Peers","name":"Peers, Jessica A.","rank":3,"rolecode":"pau"},{"affno":"4","first":"Lukas","key":"jelonekpau","last":"Jelonek","name":"Jelonek, Lukas","rank":4,"rolecode":"pau"},{"affno":"3","first":"Hélène","key":"yvannepau","last":"Yvanne","name":"Yvanne, Hélène","rank":5,"rolecode":"pau"},{"affno":"3","first":"Mark","key":"mcmullanpau","last":"McMullan","name":"McMullan, Mark","rank":6,"rolecode":"pau"},{"affno":"2","first":"Lene R.","key":"nielsenpau","last":"Nielsen","locid":"8e8b51ee-3f45-4ebe-b2fb-fa79f1256d08","name":"Nielsen, Lene Rostgaard","name_org":"Nielsen, Lene R.","orcid":"0000-0002-7214-8691","rank":7,"rolecode":"pau"}],"pmid":["37170345"],"pub":{"doi":"10.1186/s43008-023-00