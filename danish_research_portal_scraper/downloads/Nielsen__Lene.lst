ment of Computer Science, The Image Section"],"nora_code":"DI-U-KU","used":1},{"affno":"2","country":"dk","key":"biomediq","l2":"DI-PR","l2n":"Private Research","l3":"DI-PR-BIMQ","l3nl":"Biomediq","l3nn":"Biomediq","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Biomediq","namevar":["Biomediq A/S (Biz)"],"nora_code":"DI-PR-BIMQ","used":1},{"affno":"3","country":"us","key":"synarc inc","loc":["United States","America, North","OECD"],"name":"Synarc Inc","used":1}],"person":[{"affno":"1","first":"Akshay Sadananda Uppinakudru","key":"paipau","last":"Pai","locid":"2a07c27f-433e-456a-8b47-984c22cf325f","name":"Pai, Akshay Sadananda Uppinakudru","rank":1,"rolecode":"pau"},{"affno":"1","first":"Lauge Emil Borch Laurs","key":"sørensenpau","last":"Sørensen","locid":"330d1478-c602-4767-8d45-30063bff33ea","name":"Sørensen, Lauge","name_org":"Sørensen, Lauge Emil Borch Laurs","orcid":"0000-0002-1181-7150","rank":2,"rolecode":"pau"},{"affno":"1","first":"Peter","key":"myslingpau","last":"Mysling","locid":"f07749fa-c5e6-45f7-9d3c-485d27b2788c","name":"Mysling, Peter","rank":3,"rolecode":"pau"},{"affno":"1","first":"Lene Lillemark","key":"erlebenpau","last":"Erleben","locid":"0e3ad371-b61c-4c7c-b26c-605c583bbb40","name":"Erleben, Lene Lillemark","rank":4,"rolecode":"pau"},{"affno":"1","first":"Jon","key":"sporringpau","last":"Sporring","locid":"9ee4d267-e636-40f4-a8de-e712c0e41d99","name":"Sporring, Jon","orcid":"0000-0003-1261-6702","rank":5,"rolecode":"pau"},{"affno":"2","first":"E.","key":"dampau","last":"Dam","name":"Dam, E.","rank":6,"rolecode":"pau"},{"affno":"2","first":"M.","key":"lillholmpau","last":"Lillholm","name":"Lillholm, M.","rank":7,"rolecode":"pau"},{"affno":"2","first":"D.R.","key":"jørgensenpau","last":"Jørgensen","name":"Jørgensen, D.R.","rank":8,"rolecode":"pau"},{"affno":"3","first":"G.","key":"chenpau","last":"Chen","name":"Chen, G.","rank":9,"rolecode":"pau"},{"affno":"3","first":"J.","key":"ohpau","last":"Oh","name":"Oh, J.","rank":10,"rolecode":"pau"},{"affno":"3","first":"J.","key":"suhypau","last":"Suhy","name":"Suhy, J.","rank":11,"rolecode":"pau"},{"affno":"1","first":"Mads","key":"nielsenpau","last":"Nielsen","locid":"52f8d6fb-fd83-4d11-ad65-3e183ca401f2","name":"Nielsen, Mads","orcid":"0000-0003-1535-068X","rank":12,"rolecode":"pau"}],"pub":{"status":"p"},"review":"Peer Reviewed","search":{"DAF":["All Danish Affiliations","All Private Research","All Universities","Biomediq","DI-ALL","DI-PR","DI-PR-ALL","DI-U","DI-U-ALL","Private Research","Universities","University of Copenhagen"],"PST":["Published"]},"sid":["ku-fefdb11c-abde-4bea-be3b-0ba446463183"],"src":["KU University of Copenhagen"],"title":"Hippocampus atrophy in early Alzheimer's disease quantified using non-rigid registration with cube propagation","type":"Conference Abstract","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-545582","year":"2013","yearsub":"2013"}
{"abstract":"AIMS: The aim of this study was to investigate in patients with stable angina the effects on costs of frontline diagnostics by exercise-stress testing (ex-test) vs. coronary computed tomography angiography (CTA). METHODS AND RESULTS: In two coronary units at Lillebaelt Hospital, Denmark, 498 patients were identified in whom either ex-test (n = 247) or CTA (n = 251) were applied as the frontline diagnostic strategy in symptomatic patients with a low-intermediate pre-test probability of coronary artery disease (CAD). During 12 months of follow-up, death, myocardial infarction and costs associated with downstream diagnostic utilization (DTU), treatment, ambulatory visits, and hospitalizations were registered. There was no difference between cohorts in demographic characteristics or the pre-test probability of significant CAD. The mean (SD) age was 56 (11) years; 52% were men; and 96% were at low-intermediate pre-test probability of CAD. All serious cardiac events (n = 3) during follow-up occurred in patients with a negative ex-test result. Mean costs per patient associated with DTU, ambulatory visits, and cardiovascular medication were significantly higher in the ex-test than in the CTA group. The mean (SD) total costs per patient at the end of thefollow-up were 14% lower in the CTA group than in the ex-test group, € 1510 (3474) vs. €1777 (3746) (P = 0.03). CONCLUSION: Diagnostic assessment of symptomatic patients with a low-intermediate probability of CAD by CTA incurred lower costs when compared with the ex-test. These findings need confirmation in future prospective trials.","author_count":5,"contributors":["Nielsen, Lene H","Olsen, Jens","Markenvard, John","Jensen, Jesper M","Nørgaard, Bjarne Linde"],"cuid":["S01-000.00-575791"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"2-5 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-HO","DI-U"],"level3":{"HO":["DI-HO-ALL","DI-HO-CDR"],"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-HO-CDR","DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"effects on costs of frontline diagnostic evaluation in patients suspected of angina coronary computed tomography angiography vs conventional ischaemia testing","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1093/ehjci/jes166","version":"Other Version"},"id":"S01-000.00-575791","identifier":[{"id":"22922828","type":"pmid"},{"id":"84876572732","type":"scopus"}],"ids":["sdu-0919cc19-8395-42b2-a559-8a46734c0e44"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-3-5-9B6BF01F6AD992A9DEF4E25F48A7FFF1"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1093/ehjci/jes166","version":"Other Version"}],"oai":{"class":"Unused","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Public Health, Centre for Applied Health Services Research"],"nora_code":"DI-U-SDU","used":1},{"affno":"2","country":"dk","key":"central denmark region","l2":"DI-HO","l2n":"Hospitals","l3":"DI-HO-CDR","l3nl":"Central Denmark Region","l3nn":"Central Denmark Region","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"Central Denmark Region","namevar":["Aarhus University Hospital"],"nora_code":"DI-HO-CDR","used":1}],"person":[{"affno":"","corresponding":null,"first":"Lene H","key":"nielsenpau","last":"Nielsen","locid":"a1b338a0-55eb-4c20-aaa7-fd4cc748bf81","name":"Nielsen, Lene H","rank":1,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Jens","key":"olsenpau","last":"Olsen","locid":"fb528e0e-5b1f-4a96-b808-bcb6139b99fc","name":"Olsen, Jens","rank":2,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"John","key":"markenvardpau","last":"Markenvard","locid":"5187bc40-9d77-4c13-9f5a-52c3c6a23591","name":"Markenvard, John","rank":3,"rolecode":"pau"},{"affno":"","corresponding":null,"first":"Jesper M","key":"jensenpau","last":"Jensen","name":"Jensen, Jesper M","rank":4,"rolecode":"pau"},{"affno":"2","corresponding":null,"first":"Bjarne Linde","key":"nørgaardpau","last":"Nørgaard","name":"Nørgaard, Bjarne Linde","rank":5,"rolecode":"pau"}],"pmid":["22922828"],"pub":{"doi":"10.1093/ehjci/jes166","issn":["15252167","15322114"],"issn_org":["20472404"],"issue":"5","journal":"European Heart Journal Cardiovascular Imaging","pages":"449-455","publisher":"Oxford University Press","status":"p","title":"European Heart Journal Cardiovascular Imaging","title_org":"European Heart Journal - Cardiovascular Imaging","volume":"14"},"review":"Peer Reviewed","scoID":["2-s2.0-84876572732"],"search":{"DAF":["All Danish Affiliations","All Hospitals","All Universities","Central Denmark Region","DI-ALL","DI-HO","DI-HO-ALL","DI-U","DI-U-ALL","Hospitals","Universities","University of Southern Denmark"],"PST":["Published"]},"sid":["sdu-0919cc19-8395-42b2-a559-8a46734c0e44"],"src":["SDU University of Southern Denmark"],"title":"Effects on costs of frontline diagnostic evaluation in patients suspected of angina: coronary computed tomography angiography vs. conventional ischaemia testing","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-575791","year":"2013","yearsub":"2013"}
{"abstract":"Background: Rheumatoid arthritis (RA) is an autoimmune disease with a complex origin. Previous studies have reported heritability estimates on RA at about 60%. Only 16% of the genetic background of the disease has been disclosed so far. The purpose of the present investigation was to provide an optimized estimate on the heritability of RA and to study the recurrence risk in a nationwide Caucasian twin population. Methods and Findings: In a mail survey addressed to 56.707 twin individuals, RA was reported by 479 individuals, mean age 52 (range 16-73). Respondents underwent an interview and clinical examination. Ascertainment probability was 80%. RA was confirmed in 162 twin individuals yielding a prevalence at 0.37% (95% CI 0.31-0.43). The mean discordance time was 19 years (range 0-57). The concordance was 9.1% (95% CI 1.9 to 24.3) in MZ, 6.4% (95% CI 2.1 to 14.3) in DZss. The increased relative risk of attracting RA conditioned on having an affected cotwin compared to the background population risk was 24.6 to 35.4 in MZ twins and 17.3 to 31.6 in DZss twins. The correlation coefficients were 0.60 (0.33 to 0.78) in monozygotic (MZ) and 0.55 (0.33 to 0.72) in dizygotic same sexed (DZss) pairs. Twelve percent (95% CI 0-76%) of the phenotypic variance in the liability to RA was due to additive genetic effects, 50% (95% CI 0-72%) to shared environmental effects and 38% (95% CI 17-61%) to non-shared environmental effects. Conclusions: This study emphasizes that family factors are important for the development of RA. Although genetic effectors are important, shared and non-shared environmental triggers and/or epigenetic stochastic events seem to be even more significant. However, it should be borne in mind that the genetic and non-genetic components may not be the same across disease subsets.","author_count":9,"contributors":["Svendsen, Anders Jørgen","Kyvik, Kirsten Ohm","Houen, Gunnar","Junker, Peter","Christensen, Kaare","Christiansen, Lene","Nielsen, Christian","Skytthe, Axel","Hjelmborg, Jacob"],"cuid":["S01-000.00-602567"],"filters":{"added":"2021-10","altsrc":["Global Data"],"author_count":"6-10 contributors","cluster_size":1,"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"Yes","org":{"level1":["di"],"level2":["DI-ALL","DI-U"],"level3":{"U":["DI-U-ALL","DI-U-SDU"]},"level3all":["DI-U-SDU"]},"review":"pr","rtype":["clu"],"sorti":"on the origin of rheumatoid arthritis the impact of environment and genes a population based twin study","src":["sdu"],"src-code":["DI-U-SDU"],"type":"dja","type-grp":["all","pub"]},"ft":{"access":"oa","type":"doi","url":"https://doi.org/10.1371/journal.pone.0057304","version":"Other Version"},"id":"S01-000.00-602567","identifier":[{"id":"84874521997","type":"scopus"},{"id":"PMC3585362","type":"pmcid"},{"id":"23468964","type":"pmid"}],"ids":["sdu-668f786d-d94d-4ba5-af8b-1847d71ec23d"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-A5917B0933BFD910D6C4F991E4B2EE8D"],"oa_link":[{"access":"oa","type":"doi","url":"https://doi.org/10.1371/journal.pone.0057304","version":"Other Version"}],"oai":{"class":"Realised","mra":["Medicine (MED)"],"yearPub":"2013","yearSub":"2013"},"org":[{"affno":"1","key":"sdu university of southern denmark","l2":"DI-U","l2n":"Universities","l3":"DI-U-SDU","l3nl":"University of Southern Denmark","l3nn":"SDU University of Southern Denmark","loc":["Denmark","Europe, EU","Nordic","OECD"],"name":"SDU University of Southern Denmark","namevar":["SDU, The Faculty of Health Sciences, Department of Clinical Research, KI, OUH, Research unit of Rheumatology (Odense)","SDU, The Faculty of Health Sciences, Department of Public Health, Epidemiology, Biostatistics and Biodemography"],"nora_code":"DI-U-SDU","used":1}],"person":[{"affno":"1","corresponding":null,"country":"dk","first":"Anders J","key":"svendsenpau","last":"Svendsen","locid":"1e40af47-6a8d-4852-a1b7-1097a584d756","name":"Svendsen, Anders Jørgen","name_org":"Svendsen,