no":"2","corresponding":null,"country":"dk","first":"Lene Nyhus","key":"andreasenpau","last":"Andreasen","locid":"4dcde74a-8de8-4b84-b795-c9d84cfc7af7","name":"Andreasen, Lene Nyhus","orcid":"0000-0002-9891-7890","rank":12,"rolecode":"pau"},{"affno":"2","corresponding":null,"country":"dk","first":"Evald Høj","key":"christiansenpau","last":"Christiansen","locid":"06b04feb-3d2f-402d-b211-7ad5fd0387f1","name":"Christiansen, Evald Høj","orcid":"0000-0002-8740-4862","rank":13,"rolecode":"pau"},{"affno":"1","corresponding":null,"first":"Øyvind","key":"bleiepau","last":"Bleie","name":"Bleie, Øyvind","rank":14,"rolecode":"pau"}],"pmid":["36484214"],"pub":{"doi":"10.1097/mca.0000000000001202","issn":["09546928","14735830"],"issn_org":["09546928"],"issue":"1","journal":"Coronary Artery Disease","pages":"1-10","publisher":"Lippincott Williams and Wilkins","status":"p","title":"Coronary Artery Disease","volume":"34"},"review":"Peer Reviewed","scoID":["2-s2.0-85143557636"],"search":{"DAF":["Aarhus University","All Danish Affiliations","All Universities","DI-ALL","DI-U","DI-U-ALL","Universities"],"PST":["Published"]},"sid":["au-25b93d64-9cbb-499a-bc36-d3d149bc8cac"],"src":["AU Aarhus University"],"title":"Everolimus-eluting bioresorbable scaffold versus everolimus-eluting metallic stent in primary percutaneous coronary intervention of ST-segment elevation myocardial infarction : a randomized controlled trial","type":"Journal Article","url":"https://local.forskningsportal.dk/search?modus=sin&s=LOI:S01-000.00-151012","year":"2023","yearsub":"2023"}
{"abstract":"Therapeutic plasma exchange (TPE) is a therapeutic intervention that separates plasma from blood cells to remove pathological factors or to replenish deficient factors. The use of TPE is increasing over the last decades. However, despite a good theoretical rationale and biological plausibility for TPE as a therapy for numerous diseases or syndromes associated with critical illness, TPE in the intensive care unit (ICU) setting has not been studied extensively. A group of eighteen experts around the globe from different clinical backgrounds used a modified Delphi method to phrase key research questions related to “TPE in the critically ill patient”. These questions focused on: (1) the pathophysiological role of the removal and replacement process, (2) optimal timing of treatment, (3) dosing and treatment regimes, (4) risk–benefit assumptions and (5) novel indications in need of exploration. For all five topics, the current understanding as well as gaps in knowledge and future directions were assessed. The content should stimulate future research in the field and novel clinical applications.","author_count":18,"contributors":["David, Sascha","Russell, Lene","Castro, Pedro","van de Louw, Andry","Zafrani, Lara","Pirani, Tasneem","Nielsen, Nathan D.","Mariotte, Eric","Ferreyro, Bruno L.","Kielstein, Jan T.","Montini, Luca","Brignier, Anne C.","Kochanek, Matthias","Cid, Joan","Robba, Chiara","Martin-Loeches, Ignacio","Ostermann, Marlies","Juffermans, Nicole P"],"cuid":["S01-000.00-678456"],"filters":{"added":"2023-07","altsrc":["Global Data"],"author_count":"11-50 contributors","cluster_size":1,"continent":["America, North","Europe, EU","Europe, Non-EU","OECD"],"country":["Canada","France","Germany","Ireland","Italy","Netherlands","Spain","Switzerland","United Kingdom","United States"],"glorg":["All Global Affiliations","Erasmus University Rotterdam","Hannover Medical School","King's College Hospital NHS Foundation Trust","King's College London","Leeds Teaching Hospitals NHS Trust","Paris-Cité University","Pennsylvania State University","Policlinico Universitario Agostino Gemelli","Technical University of Braunschweig","Trinity College Dublin","University Health Network","University Hospital Zürich","University of Barcelona","University of Cologne","University of Genoa","University of New Mexico"],"keyword":["Apheresis","Expert panel","Gaps","Knowledge","Plasma Exchange","Plasmapheresis","Research"],"level":"sci","mra":["med"],"oa":"Open Access","oaiscope":"No","org":{"level1":["di"],"level2":["DI-ALL","DI-OT","DI-U"],"level3":{"OT":["OLVG Hospital"],"U":["DI-U-ALL","DI-U-KU"]},"level3all":["DI-U-KU"]},"review":"pr","rtype":["clu"],"sorti":"research priorities for therapeutic plasma exchange in critically ill patients","src":["ku"],"src-code":["DI-U-KU"],"type":"djr","type-grp":["all","pub"]},"ft":{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s40635-023-00510-w","version":"Published Version"},"id":"S01-000.00-678456","identifier":[{"id":"PMC10164453","type":"pmcid"},{"id":"37150798","type":"pmid"},{"id":"85158937880","type":"scopus"}],"ids":["ku-77df6813-9166-45d2-b1cf-08fd6694b5ea"],"keyword":["Apheresis","Expert panel","Gaps","Knowledge","Plasma exchange","Plasmapheresis","Research"],"lang":"English","level":"Scientific","mra":["Medical Science"],"noi":["Global-Local-2-4-26AE67BD1C05A87ACCF64B0AA031E00E"],"oa_link":[{"access":"oa","license":"CC BY","type":"doi","url":"https://doi.org/10.1186/s40635-023-00510-w","version":"Published Version"},{"access":"oa","license":"CC BY","type":"loc","url":"https://curis.ku.dk/ws/files/347305115/s40635_023_00510_w.pdf","version":"Published Version"}],"org":[{"affno":"1","country":"ch","key":"university hospital zürich","loc":["Switzerland","Europe, Non-EU","OECD"],"name":"University Hospital Zürich","used":1},{"affno":"2","country":"de","key":"hannover medical school","loc":["Germany","Europe, EU","OECD"],"name":"Hannover Medical School","used":1},{"af